<!-- [Documentation](docs/build/development.md#build-the-compiler-and-tests) -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <FpasTestSdkVersion>17.14.1</FpasTestSdkVersion>
    <FpasXunitVersion>2.9.3</FpasXunitVersion>
    <FpasXunitAdapterVersion>3.1.4</FpasXunitAdapterVersion>
    <FpasMSTestVersion>4.5.2</FpasMSTestVersion>
    <FpasNUnitVersion>5.0.0</FpasNUnitVersion>
    <FpasNUnitAdapterVersion>6.3.1</FpasNUnitAdapterVersion>
    <FpasTestingPlatformVersion>2.5.2</FpasTestingPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="SoundFlow" Version="1.4.2" />
    <PackageVersion Include="SoundFlow.Codecs.FFMpeg" Version="1.4.0" />
    <PackageVersion Include="Ude.NetStandard" Version="1.2.0" />
    <PackageVersion Include="PhotoSauce.MagicScaler" Version="0.15.0" />
    <PackageVersion Include="PhotoSauce.NativeCodecs.Libjpeg" Version="3.2.0-preview1" />
    <PackageVersion Include="PhotoSauce.NativeCodecs.Libpng" Version="1.6.59-preview1" />
    <PackageVersion Include="Zomp.SyncMethodGenerator" Version="1.6.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="MetaBrainz.MusicBrainz" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.23" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="$(FpasTestingPlatformVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Microsoft.Diagnostics.DbgShim.win-x64" Version="10.0.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.DbgShim.linux-x64" Version="10.0.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.DbgShim.win-arm64" Version="10.0.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.DbgShim.linux-arm64" Version="10.0.750501" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(FpasTestSdkVersion)" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="OmniSharp.Extensions.LanguageProtocol" Version="1.0.0" />
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="xunit" Version="$(FpasXunitVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(FpasXunitAdapterVersion)" />
    <PackageVersion Include="MSTest.TestFramework" Version="$(FpasMSTestVersion)" />
    <PackageVersion Include="MSTest.TestAdapter" Version="$(FpasMSTestVersion)" />
    <PackageVersion Include="NUnit" Version="$(FpasNUnitVersion)" />
    <PackageVersion Include="NUnit3TestAdapter" Version="$(FpasNUnitAdapterVersion)" />
  </ItemGroup>
</Project>
