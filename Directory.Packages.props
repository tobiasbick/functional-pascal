<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <FpasTestSdkVersion>17.14.1</FpasTestSdkVersion>
    <FpasXunitVersion>2.9.3</FpasXunitVersion>
    <FpasXunitAdapterVersion>3.1.4</FpasXunitAdapterVersion>
    <FpasMSTestVersion>4.5.2</FpasMSTestVersion>
    <FpasNUnitVersion>5.0.0</FpasNUnitVersion>
    <FpasNUnitAdapterVersion>6.3.1</FpasNUnitAdapterVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Microsoft.Diagnostics.DbgShim.win-x64" Version="10.0.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.DbgShim.linux-x64" Version="10.0.750501" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(FpasTestSdkVersion)" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="xunit" Version="$(FpasXunitVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(FpasXunitAdapterVersion)" />
    <PackageVersion Include="MSTest.TestFramework" Version="$(FpasMSTestVersion)" />
    <PackageVersion Include="MSTest.TestAdapter" Version="$(FpasMSTestVersion)" />
    <PackageVersion Include="NUnit" Version="$(FpasNUnitVersion)" />
    <PackageVersion Include="NUnit3TestAdapter" Version="$(FpasNUnitAdapterVersion)" />
  </ItemGroup>
</Project>
