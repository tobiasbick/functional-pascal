unit Diagnostics.MeasureProcesses;

uses
  System as Sys, System.IO as IO, System.Text as Text,
  System.Threading as Threading, System.Threading.Tasks as Tasks,
  System.Collections.Generic as Collections, Fpas.Processes as Owned,
  Diagnostics.MeasureOptions as Model;

// A completed measurement target and its captured streams.
public type Result = record
  // The target process exit code.
  public ExitCode: int;
  // The decoded standard output.
  public Output: string;
  // The decoded standard error.
  public Error: string;
end record;

async function Drain(Stream: IO.Stream; Token: Threading.CancellationToken): Tasks.Task<string>;
begin
  const Buffer: array of byte := new byte[4096];
  using const Bytes: IO.MemoryStream := new IO.MemoryStream();
  while true do
    const Count: int := await Stream.ReadAsync(Buffer, 0, Buffer.Length, Token);
    if Count = 0 then
      break;
    end if;

    if Bytes.Length + Count > 65536 then
      raise new IO.InvalidDataException('Child output exceeded 64 KiB');
    end if;

    Bytes.Write(Buffer, 0, Count);
  end while;

  Bytes.Position := 0;
  using const Reader: IO.StreamReader := new IO.StreamReader(Bytes, Text.Encoding.UTF8);
  return Reader.ReadToEnd();
end function;

// Runs and joins one measurement target with bounded output on each stream.
//
// ## Parameters
// - `Options`: Target, arguments, working directory, and positive timeout.
// - `Cancellation`: Cancellation requested by the caller.
//
// ## Returns
// The target exit code and the two decoded streams.
public async function Run(Options: Model.Options; Cancellation: Threading.CancellationToken): Tasks.Task<Result>;
requires Options.Timeout > 0;
begin
  using const Deadline: Threading.CancellationTokenSource := new Threading.CancellationTokenSource(
    Sys.TimeSpan.FromSeconds(Options.Timeout)
  );
  using const Token: Threading.CancellationTokenSource := Threading.CancellationTokenSource.CreateLinkedTokenSource(
    Cancellation,
    Deadline.Token
  );
  const Environment: Collections.Dictionary<string, string> := new Collections.Dictionary<string, string>();
  Environment['MSBUILDDISABLENODEREUSE'] := '1';
  Environment['DOTNET_CLI_USE_MSBUILD_SERVER'] := '0';
  await using const Child: Owned.OwnedProcess := Owned.OwnedProcess.Start(
    Options.Executable,
    Options.Arguments,
    Options.Directory,
    Environment
  );
  Child.Input.Dispose();
  const OutTask: Tasks.Task<string> := Drain(Child.Output, Token.Token);
  const ErrTask: Tasks.Task<string> := Drain(Child.Error, Token.Token);
  const Exited: Tasks.Task := Child.WaitForExit(Token.Token);
  const Pending: Collections.List<Tasks.Task> := new Collections.List<Tasks.Task>();
  Pending.Add(Exited);
  Pending.Add(OutTask);
  Pending.Add(ErrTask);

  try
    while Pending.Count > 0 do
      const Finished: Tasks.Task := await Tasks.Task.WhenAny(Pending);
      await Finished;
      discard Pending.Remove(Finished);
      if Sys.Object.ReferenceEquals(Finished, Exited) then
        await Child.TerminateAsync();
      end if;
    end while;

    return new Result(Child.ExitCode, await OutTask, await ErrTask);
  finally
    await Child.TerminateAsync();
    try
      await Tasks.Task.WhenAll(Pending);
    catch do
    end try;
  end try;
end function;
end unit;
