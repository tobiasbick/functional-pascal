unit DocExamples.Model;

public type Example = record
  public Document: string;
  public Line: int;
  public Language: string;
  public Source: string;
  public Id: string;
  public Fragment: bool := false;
  public Context: string := '';
  public Execute: bool := false;
  public ExpectedError: string := '';
  public Project: string := '';
  public FileName: string := '';
  public Manifest: string := '';
  public ExpectedOutput: string := '';
  public ExpectedException: string := '';
end record;

public type Options = record
  public Root: string;
  public Output: string;
  public Compiler: string;
  public References: string;
  public Dotnet: string;
  public Contexts: string;

  public Documents: array of string;
  public ExtraReferences: array of string;

  public Timeout: int := 10;
  public Jobs: int := 4;
  public Json: bool := false;
end record;

public type Origin = record
  public Document: string;
  public Line: int;
  public Primary: bool;
end record;

public type Source = record
  public Path: string;
  public Text: string;
  public Lines: array of Origin;
end record;

public type Prepared = record
  public Primary: string;
  public Assembly: string;
  public Library: bool;
  public Sources: array of Source;
  public Manifest: string;
end record;

public type Outcome = record
  public Document: string;
  public Line: int;
  public Id: string;
  public Passed: bool;
  public Stage: string;
  public Message: string;
  public Compile: string := 'not_run';
  public Run: string := 'not_selected';
  public Assembly: string := '';
  public Library: bool := false;
  public Manifest: string := '';
end record;

public type Report = record
  public Schema: int;
  public Root: string;
  public Compiler: string;
  public CompilerHash: string;
  public References: string;
  public ExtraReferences: array of string;
  public SdkCompiler: string;
  public SdkCompilerHash: string;
  public Output: string;

  public Total: int;
  public Failed: int;
  public Results: array of Outcome;
end record;

public type FailureReport = record
  public Schema: int;
  public Total: int;
  public Failed: int;
  public Results: array of Outcome;
  public Error: string;
end record;

end unit;
