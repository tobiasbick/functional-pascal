unit DocExamples.Processes;

uses
  DocExamples.Model as M, Fpas.Processes as P, System as S, System.IO as IO,
  System.Text as Text, System.Threading as T, System.Threading.Tasks as Tasks,
  System.Collections.Generic as C;

async function Drain(Reader: IO.StreamReader; Cancellation: T.CancellationToken): Tasks.Task<string>;
begin
  const Buffer: array of char := new char[4096];
  const Result: Text.StringBuilder := new Text.StringBuilder();
  var Bytes: int := 0;

  while true do
    const Count: int := await Reader.ReadAsync(Buffer, 0, Buffer.Length).WaitAsync(Cancellation);
    if Count = 0 then
      break;
    end if;

    Bytes := Bytes + Text.Encoding.UTF8.GetByteCount(Buffer, 0, Count);
    if Bytes > 524288 then
      raise new IO.InvalidDataException('Process output exceeded 512 KiB on one stream');
    end if;

    discard Result.Append(Buffer, 0, Count);
  end while;

  return Result.ToString();
end function;

public async function Run(Options: M.Options; Arguments: array of string; Directory: string; Cancellation: T.CancellationToken): Tasks.Task<M.Captured>;
begin
  using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(
    S.TimeSpan.FromSeconds(Options.Timeout)
  );
  using const Combined: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
    Cancellation,
    Deadline.Token
  );

  const Environment: C.Dictionary<string, string> := new C.Dictionary<string, string>();
  Environment['MSBUILDDISABLENODEREUSE'] := '1';
  Environment['DOTNET_CLI_USE_MSBUILD_SERVER'] := '0';

  await using const Process: P.OwnedProcess := P.OwnedProcess.Start(
    Options.Dotnet,
    Arguments,
    Directory,
    Environment
  );
  Process.Input.Dispose();
  using const Output: IO.StreamReader := new IO.StreamReader(Process.Output, Text.Encoding.UTF8);
  using const Error: IO.StreamReader := new IO.StreamReader(Process.Error, Text.Encoding.UTF8);
  const OutTask: Tasks.Task<string> := Drain(Output, Combined.Token);
  const ErrTask: Tasks.Task<string> := Drain(Error, Combined.Token);

  try
    const Exited: Tasks.Task := Process.WaitForExit(Combined.Token);
    const Pending: C.List<Tasks.Task> := new C.List<Tasks.Task>();
    Pending.Add(Exited);
    Pending.Add(OutTask);
    Pending.Add(ErrTask);

    while Pending.Count > 0 do
      const Finished: Tasks.Task := await Tasks.Task.WhenAny(Pending);
      await Finished;
      discard Pending.Remove(Finished);
      if S.Object.ReferenceEquals(Finished, Exited) then
        await Process.TerminateAsync();
      end if;
    end while;

    const ExitCode: int := Process.ExitCode;
    await Process.TerminateAsync();
    return new M.Captured(ExitCode, await OutTask, await ErrTask);
  finally
    await Process.TerminateAsync();
    try
      discard await Tasks.Task.WhenAll<string>([OutTask, ErrTask]);
    catch do
    end try;
  end try;
end function;
end unit;
