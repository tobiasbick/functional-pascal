// [Documentation](../../../../doc/library.md#albums-and-artwork)

// Album observation owns its read connection and never runs on the UI thread.
unit FpasAmp.Library.Albums.Internal.Observing;

uses FpasAmp.Library.Albums.Model as M;
uses FpasAmp.Library.Albums.Persistence.Queries as Queries;
uses FpasAmp.Library.Persistence.Sql as Sql;
uses Microsoft.Data.Sqlite as Db;
uses System as Sys;
uses System.Collections.Immutable as I;
uses System.Linq as L;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

function Same(A: I.ImmutableArray<M.Album>; B: I.ImmutableArray<M.Album>): bool;
begin
  if A.Length <> B.Length then
    return false;
  end if;

  for Index: int := 0 to A.Length - 1 do
    // record equality compares the genre arrays by reference, so compare their contents
    const Left: M.Album := A[Index];
    const Right: M.Album := B[Index];
    if Left with
      Genres := Right.Genres;
      Credits := Right.Credits;
      GenreMemberships := Right.GenreMemberships;
    end with <> Right or not L.Enumerable.SequenceEqual<string>(
      Left.Genres,
      Right.Genres
    ) or not L.Enumerable.SequenceEqual<M.Membership>(
      Left.Credits,
      Right.Credits
    ) or not L.Enumerable.SequenceEqual<M.Membership>(Left.GenreMemberships, Right.GenreMemberships)
    then
      return false;
    end if;
  end for;

  return true;
end function;

function Version(Connection: Db.SqliteConnection): long;
begin
  using const Query: Db.SqliteCommand := Sql.Command(
    Connection,
    'PRAGMA data_version;',
    null,
    [],
    []
  );
  return Sys.Convert.ToInt64(Query.ExecuteScalar());
end function;

// Calls Read after committed changes to either database, including the initial read.
public async function Changes(Database: string; Users: string; Read: function(): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task;
begin
  using const Connection: Db.SqliteConnection := Sql.Open(Database);
  using const UserData: Db.SqliteConnection := Sql.Open(Users);
  var CatalogueVersion: long := -1L;
  var UserVersion: long := -1L;
  while true do
    Cancellation.ThrowIfCancellationRequested();
    const Current: long := Version(Connection);
    const CurrentUsers: long := Version(UserData);
    if Current <> CatalogueVersion or CurrentUsers <> UserVersion then
      await Read().ConfigureAwait(false);
      CatalogueVersion := Current;
      UserVersion := CurrentUsers;
    end if;

    await Tasks.Task.Delay(500, Cancellation).ConfigureAwait(false);
  end while;
end function;

// Observes committed album changes in `Database`/`Users`; `Publish` is awaited and only
// receives changed complete snapshots. `Cancellation` closes the borrowed lifetime.
public async function Run(Database: string; Users: string; Publish: function(M.Snapshot): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task;
begin
  var Published: bool := false;
  var Previous: M.Snapshot := new M.Snapshot();
  await Changes(
    Database, Users, async function(): Tasks.Task begin
      var Snapshot: M.Snapshot := Queries.Read(Database, Users, Cancellation);
      if Published and Same(Previous.Releases, Snapshot.Releases) then
        if Previous.TrackCount = Snapshot.TrackCount then
          return;
        end if;

        Snapshot := Previous with
          TrackCount := Snapshot.TrackCount;
        end with;
      end if;

      await Publish(Snapshot).ConfigureAwait(false);
      Previous := Snapshot;
      Published := true;
    end function, Cancellation
  ).ConfigureAwait(false);
end function;

end unit;
