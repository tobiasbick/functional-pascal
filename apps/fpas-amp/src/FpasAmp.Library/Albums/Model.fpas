// [Documentation](../../../doc/library.md#albums-and-artwork)

// Detached album headers; image bytes are requested independently for visible tiles.
unit FpasAmp.Library.Albums.Model;

uses System as Sys;
uses System.Collections.Immutable as I;
uses System.Security.Cryptography as Crypto;
uses System.Text as Text;

// A named catalogue group that contains tracks from a release.
public type Membership = record
  // Stable key across rescans and case changes.
  public Id: string;
  // Name as displayed in tags.
  public Name: string;
  // User rating of this group, independent of release and song ratings.
  public Rating: int? := null;
  // Number of distinct tracks in this release belonging to the group.
  public Tracks: long := 0L;
end record;

// Canonical spelling used to group tags and match tracks during browsing and playback.
public function TagKey(Name: string): string;
begin
  return Name.Trim().Normalize().ToUpperInvariant();
end function;

function Digest(Name: string): string;
begin
  return Sys.Convert.ToHexString(Crypto.SHA256.HashData(Text.Encoding.UTF8.GetBytes(TagKey(Name))));
end function;

// Returns the stable artist identity for the credit or performer `Name`.
public function ArtistId(Name: string): string;
begin
  return 'artist-' + Digest(Name);
end function;

// Returns the stable genre identity for the tag `Name`.
public function GenreId(Name: string): string;
begin
  return 'genre-' + Digest(Name);
end function;

// A logical release with stable identity and observed artwork freshness.
public type Album = record
  // Content-derived identity, independent of list position.
  public Id: string;
  // Album tag or containing folder name when absent.
  public Title: string;
  // Album artist credits, falling back to performer/compilation credits.
  public Artist: string;
  // Number of indexed audio entries in this group.
  public Tracks: long;
  // Revision of audio tags and candidate sidecar image files.
  public Revision: string;
  // Independent user-assigned album rating, null or one through ten.
  public Rating: int? := null;
  // Distinct genre tags of the album's tracks, in no particular order.
  public Genres: array of string := [];
  // Individual album credits and track performers, retaining collaboration membership.
  public Credits: array of Membership := [];
  // Per-genre song counts and independent genre ratings.
  public GenreMemberships: array of Membership := [];
end record;

// Release headers and the library-wide audio count from the same catalogue revision.
public type Snapshot = record
  // One header per release in catalogue order.
  public Releases: I.ImmutableArray<Album> := I.ImmutableArray<Album>.Empty;
  // All indexed audio files, including those awaiting tags or album assignment.
  public TrackCount: long := 0L;
end record;

end unit;
