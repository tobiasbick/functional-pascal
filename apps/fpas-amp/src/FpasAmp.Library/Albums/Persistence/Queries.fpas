// Compact indexed album headers, without materializing audio tags or image data.
unit FpasAmp.Library.Albums.Persistence.Queries;

uses
  FpasAmp.Library.Albums.Model as M, FpasAmp.Library.Persistence.Sql as Sql,
  Microsoft.Data.Sqlite as Db, System as Sys, System.Collections.Generic as C,
  System.Collections.Immutable as I, System.Security.Cryptography as Crypto, System.Text as Text,
  System.Threading as T, SQLitePCL as Native;

function Headers(Connection: Db.SqliteConnection; Cancellation: T.CancellationToken): I.ImmutableArray<M.Album>;
begin
  using const Transaction: Db.SqliteTransaction := Connection.BeginTransaction(deferred := true);
  using const Query: Db.SqliteCommand := Sql.Command(
    Connection,
    'WITH directory_art(dir,facts) AS MATERIALIZED (' +
    'SELECT directory_key,GROUP_CONCAT(path_key||'':''||size||'':''||modified_utc,''|'' ORDER BY path_key)' +
    ' FROM files WHERE kind=2 GROUP BY directory_key)' +
    ' SELECT a.album_id,MIN(a.title),MIN(a.artist),COUNT(*),' +
    'GROUP_CONCAT(m.sha256||'':''||m.read_utc||'':''||f.path_key,''|'')||' +
    'COALESCE((SELECT GROUP_CONCAT(d.facts,''|'' ORDER BY d.dir) FROM (' +
    'SELECT directory_key AS dir FROM album_tracks WHERE album_id=a.album_id' +
    ' UNION SELECT root_key FROM album_tracks WHERE album_id=a.album_id' +
    ') ad JOIN directory_art d ON d.dir=ad.dir),''''),' +
    '(SELECT r.rating FROM users.album_ratings r WHERE r.album_id=a.album_id),' +
    '(SELECT GROUP_CONCAT(v,char(31)) FROM (SELECT DISTINCT TRIM(g.value) AS v FROM album_tracks t' +
    ' JOIN metadata gm ON gm.file_id=t.file_id, json_each(gm.tags_json,''$.Genres'') g' +
    ' WHERE t.album_id=a.album_id AND gm.tags_json IS NOT NULL AND TRIM(g.value)<>''''))' +
    ' FROM album_tracks a JOIN metadata m ON m.file_id=a.file_id JOIN files f ON f.id=a.file_id' +
    ' GROUP BY a.album_id ORDER BY MIN(a.sort_title),MIN(a.sort_artist),a.album_id;',
    Transaction,
    [],
    []
  );
  using const Rows: Db.SqliteDataReader := Query.ExecuteReader();
  const Albums: C.List<M.Album> := new C.List<M.Album>();
  while Rows.Read() do
    Cancellation.ThrowIfCancellationRequested();
    const Revision: string := Sys.Convert.ToHexString(
      Crypto.SHA256.HashData(Text.Encoding.UTF8.GetBytes(Rows.GetString(4)))
    );
    Albums.Add(
      new M.Album(
        Rows.GetString(0),
        Rows.GetString(1),
        Rows.GetString(2),
        Rows.GetInt64(3),
        Revision,
        if Rows.IsDBNull(5) then
          null
        else
          Rows.GetInt32(5)
        end if,
        if Rows.IsDBNull(6) then
          []
        else
          Rows.GetString(6).Split(#31)
        end if
      )
    );
  end while;

  return I.ImmutableArray.CreateRange<M.Album>(Albums);
end function;

// Reads headers on a caller-owned catalogue connection with the ratings store attached as users.
// ## Parameters
// - `Connection`: Open SQLite connection dedicated to this read.
// - `Cancellation`: Interrupts SQLite even before it can produce the first sorted row.
// ## Returns
// One detached header per release, including its artwork revision.
public function ReadAttached(Connection: Db.SqliteConnection; Cancellation: T.CancellationToken): I.ImmutableArray<M.Album>;
requires Connection <> null;
begin
  Cancellation.ThrowIfCancellationRequested();
  if Cancellation.CanBeCanceled then
    Native.raw.sqlite3_progress_handler(
      Connection.Handle, 4096,
      function(_State: object?): int => if Cancellation.IsCancellationRequested then
        1
      else
        0
      end if, null
    );
  end if;

  try
    return Headers(Connection, Cancellation);
  catch Interrupted: Db.SqliteException when Interrupted.SqliteErrorCode =
    Native.raw.SQLITE_INTERRUPT and Cancellation.IsCancellationRequested do
    raise new Sys.OperationCanceledException(Cancellation);
  finally
    if Cancellation.CanBeCanceled then
      Native.raw.sqlite3_progress_handler(Connection.Handle, 0, null, null);
    end if;
  end try;
end function;

// Reads the sorted album headers from `Database` with ratings from `Users`.
// `Cancellation` also interrupts SQLite while it prepares the first sorted row.
// ## Returns
// One detached header per release, including its artwork revision.
public function Read(Database: string; Users: string; Cancellation: T.CancellationToken): I.ImmutableArray<M.Album>;
requires Database.Length > 0;
requires Users.Length > 0;
begin
  Cancellation.ThrowIfCancellationRequested();
  using const Connection: Db.SqliteConnection := Sql.Open(Database);
  Sql.Execute(Connection, 'ATTACH DATABASE $path AS users;', null, ['$path'], [Users]);
  return ReadAttached(Connection, Cancellation);
end function;

end unit;
