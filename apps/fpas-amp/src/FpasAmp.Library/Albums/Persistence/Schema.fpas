// Reconstructible, indexed album membership is derived from successful tag reads.
unit FpasAmp.Library.Albums.Persistence.Schema;

uses
  Fpas.Media.Tags.AudioFiles as MediaTags,
  FpasAmp.Library.Albums.Persistence.Store as Store, FpasAmp.Library.Persistence.Sql as Sql, Microsoft.Data.Sqlite as Db, System.Text.Json as Json;

// Creates membership/indexes in `Transaction`; `Populate` derives existing cached
// tags without rehashing or reopening media. All state belongs to `Connection`.
public procedure Create(Connection: Db.SqliteConnection; Transaction: Db.SqliteTransaction; Populate: bool);
begin
  Sql.Execute(
    Connection,
    'CREATE TABLE IF NOT EXISTS album_tracks(file_id INTEGER PRIMARY KEY REFERENCES metadata(file_id) ON DELETE CASCADE,' +
    'album_id TEXT NOT NULL,title TEXT NOT NULL,artist TEXT NOT NULL,sort_title TEXT NOT NULL,sort_artist TEXT NOT NULL,' +
    'directory TEXT NOT NULL,directory_key TEXT NOT NULL,root TEXT NOT NULL,root_key TEXT NOT NULL);' +
    'CREATE INDEX IF NOT EXISTS album_members ON album_tracks(album_id,file_id);' +
    'CREATE INDEX IF NOT EXISTS album_directories ON album_tracks(directory_key,album_id);' +
    'CREATE INDEX IF NOT EXISTS album_roots ON album_tracks(root_key,album_id);',
    Transaction,
    [],
    []
  );
  if Populate then
    using const Query: Db.SqliteCommand := Sql.Command(
      Connection,
      'SELECT file_id,tags_json FROM metadata WHERE tags_json IS NOT NULL;',
      Transaction,
      [],
      []
    );
    using const Rows: Db.SqliteDataReader := Query.ExecuteReader();
    while Rows.Read() do
      const Tags: MediaTags.Info? := Json.JsonSerializer.Deserialize<MediaTags.Info>(
        Rows.GetString(1)
      );
      if Tags <> null then
        Store.Save(Connection, Transaction, Rows.GetInt64(0), Tags);
      end if;
    end while;
  end if;
end procedure;

end unit;
