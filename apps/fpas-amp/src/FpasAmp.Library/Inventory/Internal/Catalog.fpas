// Source-scoped membership and errors over a shared physical directory traversal.
unit FpasAmp.Library.Inventory.Internal.Catalog;

uses
  FpasAmp.Library.Sources as S, FpasAmp.Library.Inventory.Model as M,
  FpasAmp.Library.Inventory.Progress as P,
  FpasAmp.Library.Inventory.Internal.Observations as O, System as Sys, System.IO as IO,
  System.Collections.Generic as C, System.Collections.Immutable as I;

// Worker-owned source memberships. Paused sources never inherit another source's updates.
public type Catalog = record
  Members: C.Dictionary<string, C.HashSet<string>>;
  Errors: C.Dictionary<string, C.Dictionary<string, string>>;
  Roots: C.Dictionary<string, string>;
  ByDirectory: C.Dictionary<string, C.Dictionary<string, C.HashSet<string>>>;

  // Creates empty source-scoped collections.
  public static function Create(): Catalog;
  begin
    return new Catalog(
      new C.Dictionary<string, C.HashSet<string>>(Sys.StringComparer.Ordinal),
      new C.Dictionary<string, C.Dictionary<string, string>>(Sys.StringComparer.Ordinal),
      new C.Dictionary<string, string>(Sys.StringComparer.Ordinal),
      new C.Dictionary<string, C.Dictionary<string, C.HashSet<string>>>(Sys.StringComparer.Ordinal)
    );
  end function;

  procedure Ensure(Id: string);
  begin
    if not self.Members.ContainsKey(Id) then
      self.Members[Id] := new C.HashSet<string>(S.PathComparer());
    end if;

    if not self.Errors.ContainsKey(Id) then
      self.Errors[Id] := new C.Dictionary<string, string>(S.PathComparer());
    end if;

    if not self.ByDirectory.ContainsKey(Id) then
      self.ByDirectory[Id] := new C.Dictionary<string, C.HashSet<string>>(S.PathComparer());
    end if;
  end procedure;

  procedure Bind(Source: S.MusicSource);
  begin
    if self.Roots.ContainsKey(Source.Id) and not S.PathComparer().Equals(
      self.Roots[Source.Id],
      Source.Path
    )
    then
      self.Clear(Source.Id);
    end if;

    self.Ensure(Source.Id);
    self.Roots[Source.Id] := Source.Path;
  end procedure;

  // Restores one source-owned directory error. `Id` is a configured source and `Path` is normalized.
  public procedure RestoreDirectory(Id: string; Path: string; Error: string?);
  begin
    self.Ensure(Id);
    if Error <> null then
      self.Errors[Id][Path] := Error;
    end if;
  end procedure;

  // Restores one source-owned normalized path from SQLite.
  public procedure RestoreFile(Id: string; Path: string);
  begin
    self.Ensure(Id);
    discard self.Members[Id].Add(Path);
    const Directory: string := IO.Path.GetDirectoryName(Path) ?? '';
    if not self.ByDirectory[Id].ContainsKey(Directory) then
      self.ByDirectory[Id][Directory] := new C.HashSet<string>(S.PathComparer());
    end if;

    discard self.ByDirectory[Id][Directory].Add(Path);
  end procedure;

  // Applies a committed observation to active normalized `Sources` only.
  public procedure Apply(Value: O.DirectoryObservation; Sources: array of S.MusicSource);
  begin
    for Source: S.MusicSource in Sources do
      if Source.Offline or Source.Paused or not S.HasWork(Source) or not S.Within(
        Value.Path,
        Source.Path
      )
      then
        continue;
      end if;

      self.Bind(Source);
      const Extensions: C.HashSet<string> := new C.HashSet<string>(
        Source.Extensions,
        Sys.StringComparer.OrdinalIgnoreCase
      );
      const Found: C.HashSet<string> := new C.HashSet<string>(S.PathComparer());
      for Path: string in Value.Files do
        if Extensions.Contains(IO.Path.GetExtension(Path) ?? '') then
          discard Found.Add(Path);
        end if;
      end for;

      if Value.Complete then
        const Remove: C.List<string> := new C.List<string>();
        if self.ByDirectory[Source.Id].ContainsKey(Value.Path) then
          for Path: string in self.ByDirectory[Source.Id][Value.Path] do
            if not Found.Contains(Path) then
              Remove.Add(Path);
            end if;
          end for;
        end if;

        for Path: string in Remove do
          discard self.Members[Source.Id].Remove(Path);
        end for;

        discard self.Errors[Source.Id].Remove(Value.Path);
        self.ByDirectory[Source.Id][Value.Path] := Found;
      else
        self.Errors[
          Source.Id
        ][Value.Path] := Value.Failure ?? 'Directory enumeration did not complete.';
      end if;

      if not Value.Complete then
        if not self.ByDirectory[Source.Id].ContainsKey(Value.Path) then
          self.ByDirectory[Source.Id][Value.Path] := new C.HashSet<string>(S.PathComparer());
        end if;

        self.ByDirectory[Source.Id][Value.Path].UnionWith(Found);
      end if;

      self.Members[Source.Id].UnionWith(Found);
    end for;
  end procedure;

  // Removes a confirmed missing subtree from covering sources, retaining a source
  // whose root itself disappeared. `Path` and `Sources` are normalized.
  public procedure RemoveDirectories(Directories: C.HashSet<string>; Sources: array of S.MusicSource);
  begin
    for Source: S.MusicSource in Sources do
      if Source.Offline or Source.Paused or Directories.Contains(Source.Path) then
        continue;
      end if;

      self.Ensure(Source.Id);
      for Directory: string in Directories do
        if self.ByDirectory[Source.Id].ContainsKey(Directory) then
          for File: string in self.ByDirectory[Source.Id][Directory] do
            discard self.Members[Source.Id].Remove(File);
          end for;

          discard self.ByDirectory[Source.Id].Remove(Directory);
        end if;

        discard self.Errors[Source.Id].Remove(Directory);
      end for;
    end for;
  end procedure;

  // Forgets the indexed view for `Id`, or every source when Id is empty.
  public procedure Clear(Id: string);
  begin
    if Id = '' then
      self.Members.Clear();
      self.Errors.Clear();
      self.Roots.Clear();
      self.ByDirectory.Clear();
    else
      discard self.Members.Remove(Id);
      discard self.Errors.Remove(Id);
      discard self.Roots.Remove(Id);
      discard self.ByDirectory.Remove(Id);
    end if;
  end procedure;

  // Returns all retained physical paths for pruning shared traversal caches.
  public function KnownFiles(): C.HashSet<string>;
  begin
    const Result: C.HashSet<string> := new C.HashSet<string>(S.PathComparer());
    for Files: C.HashSet<string> in self.Members.Values do
      Result.UnionWith(Files);
    end for;

    return Result;
  end function;

  // Releases removed/out-of-root/excluded memberships after a configuration change.
  public procedure Prune(Sources: array of S.MusicSource);
  begin
    const Keep: C.HashSet<string> := new C.HashSet<string>(Sys.StringComparer.Ordinal);
    for Source: S.MusicSource in Sources do
      discard Keep.Add(Source.Id);
      self.Bind(Source);
      const Extensions: C.HashSet<string> := new C.HashSet<string>(
        Source.Extensions,
        Sys.StringComparer.OrdinalIgnoreCase
      );
      const Remove: C.List<string> := new C.List<string>();
      for Path: string in self.Members[Source.Id] do
        if not S.Within(
          Path,
          Source.Path
        ) or (not Source.Offline and not Source.Paused and not Extensions.Contains(
          IO.Path.GetExtension(Path) ?? ''
        ))
        then
          Remove.Add(Path);
        end if;
      end for;

      for Path: string in Remove do
        discard self.Members[Source.Id].Remove(Path);
        const Directory: string := IO.Path.GetDirectoryName(Path) ?? '';
        if self.ByDirectory[Source.Id].ContainsKey(Directory) then
          discard self.ByDirectory[Source.Id][Directory].Remove(Path);
        end if;
      end for;

      Remove.Clear();
      for Path: string in self.Errors[Source.Id].Keys do
        if not S.Within(Path, Source.Path) then
          Remove.Add(Path);
        end if;
      end for;

      for Path: string in Remove do
        discard self.Errors[Source.Id].Remove(Path);
      end for;
    end for;
    const Removed: C.List<string> := new C.List<string>();
    for Id: string in self.Members.Keys do
      if not Keep.Contains(Id) then
        Removed.Add(Id);
      end if;
    end for;

    for Id: string in Removed do
      self.Clear(Id);
    end for;
  end procedure;

  // Returns availability and count in constant membership space, without a path-array copy.
  public function Summary(Source: S.MusicSource): P.Result;
  begin
    self.Bind(Source);
    var Status: M.Availability := M.Availability.Ready;
    if Source.Offline then
      Status := M.Availability.Offline;
    else
      if Source.Paused then
        Status := M.Availability.Paused;
      else
        for Directory: string in self.Errors[Source.Id].Keys do
          if S.PathComparer().Equals(Directory, Source.Path) then
            Status := M.Availability.Unavailable;
          else
            if Status <> M.Availability.Unavailable then
              Status := M.Availability.Incomplete;
            end if;
          end if;
        end for;
      end if;
    end if;

    return new P.Result(Status, cast<long>(self.Members[Source.Id].Count));
  end function;

  // Creates detached per-source views. `Watched` contains installed active roots.
  public function Describe(Sources: array of S.MusicSource; Watched: array of string): I.ImmutableArray<M.SourceSnapshot>;
  begin
    const Views: C.List<M.SourceSnapshot> := new C.List<M.SourceSnapshot>();
    for Source: S.MusicSource in Sources do
      self.Bind(Source);
      var Status: M.Availability := M.Availability.Ready;
      if Source.Offline then
        Status := M.Availability.Offline;
      else
        if Source.Paused then
          Status := M.Availability.Paused;
        end if;
      end if;
      const Issues: C.List<M.ScanIssue> := new C.List<M.ScanIssue>();
      for Directory: string in self.Errors[Source.Id].Keys do
        Issues.Add(new M.ScanIssue(Directory, self.Errors[Source.Id][Directory]));
        if not Source.Offline and not Source.Paused then
          if S.PathComparer().Equals(Directory, Source.Path) then
            Status := M.Availability.Unavailable;
          else
            if Status <> M.Availability.Unavailable then
              Status := M.Availability.Incomplete;
            end if;
          end if;
        end if;
      end for;
      var Watching: bool := false;
      if not Source.Offline and not Source.Paused and S.HasWork(Source) then
        for Root: string in Watched do
          if S.Within(Source.Path, Root) then
            Watching := true;
            break;
          end if;
        end for;
      end if;

      Views.Add(
        new M.SourceSnapshot(
          Source.Id,
          Source.Path,
          Status,
          I.ImmutableArray.CreateRange<string>(self.Members[Source.Id]).Sort(S.PathComparer()),
          I.ImmutableArray.CreateRange<M.ScanIssue>(Issues),
          Watching
        )
      );
    end for;

    return I.ImmutableArray.CreateRange<M.SourceSnapshot>(Views);
  end function;
end record;

end unit;
