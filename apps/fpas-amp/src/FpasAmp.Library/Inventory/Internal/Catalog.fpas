// [Documentation](../../../../doc/library.md#reconciliation-and-persistence)

// Source-scoped membership and errors over a shared physical directory traversal.
unit FpasAmp.Library.Inventory.Internal.Catalog;

uses FpasAmp.Library.Inventory.Internal.Observations as O;
uses FpasAmp.Library.Inventory.Model as M;
uses FpasAmp.Library.Inventory.Progress as P;
uses FpasAmp.Library.Sources as S;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;
uses System.IO as IO;

// Worker-owned source memberships. Paused sources never inherit another source's updates.
public type Catalog = record
  Members: C.Dictionary of (string, C.HashSet of string);
  Errors: C.Dictionary of (string, C.Dictionary of (string, string));
  Roots: C.Dictionary of (string, string);
  // An overlapping active scan cannot discard the directory links of a paused source.
  Children: C.Dictionary of (string, C.Dictionary of (string, C.HashSet of string));
  ByDirectory: C.Dictionary of (string, C.Dictionary of (string, C.HashSet of string));

  // Creates empty source-scoped collections.
  public static function Create(): Catalog;
  begin
    return new Catalog(
      new C.Dictionary of (string, C.HashSet of string)(Sys.StringComparer.Ordinal),
      new C.Dictionary of (string, C.Dictionary of (string, string))(Sys.StringComparer.Ordinal),
      new C.Dictionary of (string, string)(Sys.StringComparer.Ordinal),
      new C.Dictionary of (string, C.Dictionary of (string, C.HashSet of string))(
        Sys.StringComparer.Ordinal
      ),
      new C.Dictionary of (string, C.Dictionary of (string, C.HashSet of string))(
        Sys.StringComparer.Ordinal
      )
    );
  end function;

  procedure Ensure(Id: string);
  begin
    if not self.Members.ContainsKey(Id) then
      self.Members[Id] := new C.HashSet of string(S.PathComparer());
      self.Children[Id] := new C.Dictionary of (string, C.HashSet of string)(S.PathComparer());
    end if;

    if not self.Errors.ContainsKey(Id) then
      self.Errors[Id] := new C.Dictionary of (string, string)(S.PathComparer());
    end if;

    if not self.ByDirectory.ContainsKey(Id) then
      self.ByDirectory[Id] := new C.Dictionary of (string, C.HashSet of string)(S.PathComparer());
    end if;
  end procedure;

  procedure Bind(Source: S.MusicSource);
  begin
    if self.Roots.ContainsKey(Source.Id) and not S.PathComparer().Equals(
      self.Roots[Source.Id],
      Source.Path
    )
    then
      self.Clear(Source.Id);
    end if;

    self.Ensure(Source.Id);
    self.Roots[Source.Id] := Source.Path;
  end procedure;

  function ChildrenOf(Id: string; Path: string): C.HashSet of string;
  begin
    const Directories: C.Dictionary of (string, C.HashSet of string) := self.Children[Id];
    if not Directories.ContainsKey(Path) then
      Directories[Path] := new C.HashSet of string(S.PathComparer());
    end if;

    return Directories[Path];
  end function;

  // Restores one source-owned directory entry and optional error. `Id` is a configured source and `Path` is normalized.
  public procedure RestoreDirectory(Id: string; Path: string; Error: string?);
  begin
    self.Ensure(Id);
    const Parent: string := IO.Path.GetDirectoryName(Path) ?? '';
    discard self.ChildrenOf(Id, Parent).Add(Path);
    if Error <> null then
      self.Errors[Id][Path] := Error;
    end if;
  end procedure;

  // Restores one source-owned normalized path from SQLite.
  public procedure RestoreFile(Id: string; Path: string);
  begin
    self.Ensure(Id);
    discard self.Members[Id].Add(Path);
    const Directory: string := IO.Path.GetDirectoryName(Path) ?? '';
    if not self.ByDirectory[Id].ContainsKey(Directory) then
      self.ByDirectory[Id][Directory] := new C.HashSet of string(S.PathComparer());
    end if;

    discard self.ByDirectory[Id][Directory].Add(Path);
  end procedure;

  procedure ReconcileChildren(
    Id: string;
    Value: O.DirectoryObservation;
    Removed: C.HashSet of string
  );
  begin
    const Children: C.HashSet of string := self.ChildrenOf(Id, Value.Path);
    if not Value.Complete then
      Children.UnionWith(Value.Children);
      return;
    end if;

    const Pending: C.Stack of string := new C.Stack of string();
    for Child: string in Children do
      if not Value.Children.Contains(Child) then
        Pending.Push(Child);
      end if;
    end for;
    const Directories: C.Dictionary of (string, C.HashSet of string) := self.Children[Id];
    while Pending.Count > 0 do
      const Path: string := Pending.Pop();
      if Directories.ContainsKey(Path) then
        for Child: string in Directories[Path] do
          Pending.Push(Child);
        end for;

        discard Directories.Remove(Path);
      end if;

      if self.ByDirectory[Id].ContainsKey(Path) then
        self.Members[Id].ExceptWith(self.ByDirectory[Id][Path]);
        discard self.ByDirectory[Id].Remove(Path);
      end if;

      discard self.Errors[Id].Remove(Path);
      discard Removed.Add(Path);
    end while;

    Directories[Value.Path] := new C.HashSet of string(Value.Children, S.PathComparer());
  end procedure;

  procedure ReplaceDirectoryFiles(Id: string; Directory: string; Found: C.HashSet of string);
  begin
    const Files: C.Dictionary of (string, C.HashSet of string) := self.ByDirectory[Id];
    if Files.ContainsKey(Directory) then
      for Path: string in Files[Directory] do
        if not Found.Contains(Path) then
          discard self.Members[Id].Remove(Path);
        end if;
      end for;
    end if;

    discard self.Errors[Id].Remove(Directory);
    Files[Directory] := Found;
  end procedure;

  // Applies a committed observation to active normalized `Sources` only.
  // Returns the disappeared directory paths to evict from the physical scan cache.
  public function Apply(
    Value: O.DirectoryObservation;
    Sources: array of S.MusicSource
  ): C.HashSet of string;
  begin
    const Removed: C.HashSet of string := new C.HashSet of string(S.PathComparer());
    for Source: S.MusicSource in Sources do
      if Source.Offline or Source.Paused or not S.HasWork(Source) or not S.Within(
        Value.Path,
        Source.Path
      )
      then
        continue;
      end if;

      self.Bind(Source);
      self.RestoreDirectory(Source.Id, Value.Path, null);
      self.ReconcileChildren(Source.Id, Value, Removed);
      const Extensions: C.HashSet of string := new C.HashSet of string(
        Source.Extensions,
        Sys.StringComparer.OrdinalIgnoreCase
      );
      const Found: C.HashSet of string := new C.HashSet of string(S.PathComparer());
      for Path: string in Value.Files do
        if Extensions.Contains(IO.Path.GetExtension(Path) ?? '') then
          discard Found.Add(Path);
        end if;
      end for;

      if Value.Complete then
        self.ReplaceDirectoryFiles(Source.Id, Value.Path, Found);
      else
        self.Errors[
          Source.Id
        ][Value.Path] := Value.Failure ?? 'Directory enumeration did not complete.';
        if not self.ByDirectory[Source.Id].ContainsKey(Value.Path) then
          self.ByDirectory[Source.Id][Value.Path] := new C.HashSet of string(S.PathComparer());
        end if;

        self.ByDirectory[Source.Id][Value.Path].UnionWith(Found);
      end if;

      self.Members[Source.Id].UnionWith(Found);
    end for;

    return Removed;
  end function;

  // Forgets the indexed view for `Id`, or every source when Id is empty.
  public procedure Clear(Id: string);
  begin
    if Id = '' then
      self.Members.Clear();
      self.Errors.Clear();
      self.Roots.Clear();
      self.Children.Clear();
      self.ByDirectory.Clear();
    else
      discard self.Members.Remove(Id);
      discard self.Errors.Remove(Id);
      discard self.Roots.Remove(Id);
      discard self.Children.Remove(Id);
      discard self.ByDirectory.Remove(Id);
    end if;
  end procedure;

  // Returns all retained physical paths for pruning shared traversal caches.
  public function KnownFiles(): C.HashSet of string;
  begin
    const Result: C.HashSet of string := new C.HashSet of string(S.PathComparer());
    for Files: C.HashSet of string in self.Members.Values do
      Result.UnionWith(Files);
    end for;

    return Result;
  end function;

  // Releases removed/out-of-root/excluded memberships after a configuration change.
  public procedure Prune(Sources: array of S.MusicSource);
  begin
    const Keep: C.HashSet of string := new C.HashSet of string(Sys.StringComparer.Ordinal);
    for Source: S.MusicSource in Sources do
      discard Keep.Add(Source.Id);
      self.Bind(Source);
      const Extensions: C.HashSet of string := new C.HashSet of string(
        Source.Extensions,
        Sys.StringComparer.OrdinalIgnoreCase
      );
      const Remove: C.List of string := new C.List of string();
      for Path: string in self.Members[Source.Id] do
        if not S.Within(
          Path,
          Source.Path
        ) or (not Source.Offline and not Source.Paused and not Extensions.Contains(
          IO.Path.GetExtension(Path) ?? ''
        ))
        then
          Remove.Add(Path);
        end if;
      end for;

      for Path: string in Remove do
        discard self.Members[Source.Id].Remove(Path);
        const Directory: string := IO.Path.GetDirectoryName(Path) ?? '';
        if self.ByDirectory[Source.Id].ContainsKey(Directory) then
          discard self.ByDirectory[Source.Id][Directory].Remove(Path);
        end if;
      end for;

      Remove.Clear();
      for Path: string in self.Errors[Source.Id].Keys do
        if not S.Within(Path, Source.Path) then
          Remove.Add(Path);
        end if;
      end for;

      for Path: string in Remove do
        discard self.Errors[Source.Id].Remove(Path);
      end for;
    end for;
    const Removed: C.List of string := new C.List of string();
    for Id: string in self.Members.Keys do
      if not Keep.Contains(Id) then
        Removed.Add(Id);
      end if;
    end for;

    for Id: string in Removed do
      self.Clear(Id);
    end for;
  end procedure;

  function StatusOf(Source: S.MusicSource): M.Availability;
  begin
    if Source.Offline then
      return M.Availability.Offline;
    elsif Source.Paused then
      return M.Availability.Paused;
    end if;
    const Issues: C.Dictionary of (string, string) := self.Errors[Source.Id];
    if Issues.ContainsKey(Source.Path) then
      return M.Availability.Unavailable;
    elsif Issues.Count > 0 then
      return M.Availability.Incomplete;
    end if;

    return M.Availability.Ready;
  end function;

  // Returns availability and count in constant membership space, without a path-array copy.
  public function Summary(Source: S.MusicSource): P.Result;
  begin
    self.Bind(Source);
    return new P.Result(self.StatusOf(Source), cast self.Members[Source.Id].Count as long);
  end function;

  // Creates detached per-source views. `Watched` contains installed active roots.
  public function Describe(
    Sources: array of S.MusicSource;
    Watched: array of string
  ): I.ImmutableArray of M.SourceSnapshot;
  begin
    const Views: C.List of M.SourceSnapshot := new C.List of M.SourceSnapshot();
    for Source: S.MusicSource in Sources do
      self.Bind(Source);
      const Issues: C.List of M.ScanIssue := new C.List of M.ScanIssue();
      for Issue: C.KeyValuePair of (string, string) in self.Errors[Source.Id] do
        Issues.Add(new M.ScanIssue(Issue.Key, Issue.Value));
      end for;
      var Watching: bool := false;
      if not Source.Offline and not Source.Paused and S.HasWork(Source) then
        for Root: string in Watched do
          if S.Within(Source.Path, Root) then
            Watching := true;
            break;
          end if;
        end for;
      end if;

      Views.Add(
        new M.SourceSnapshot(
          Source.Id,
          Source.Path,
          self.StatusOf(Source),
          I.ImmutableArray.CreateRange of string(self.Members[Source.Id]).Sort(S.PathComparer()),
          I.ImmutableArray.CreateRange of M.ScanIssue(Issues),
          Watching
        )
      );
    end for;

    return I.ImmutableArray.CreateRange of M.SourceSnapshot(Views);
  end function;
end record;

end unit;
