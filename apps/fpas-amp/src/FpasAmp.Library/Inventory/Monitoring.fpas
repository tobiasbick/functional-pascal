// [Documentation](../../../doc/library.md#lifetime-and-control)

// UI-independent control and lifetime for presence discovery and storage.
unit FpasAmp.Library.Inventory.Monitoring;

uses FpasAmp.Library.Inventory.Internal.Inbox as Q;
uses FpasAmp.Library.Inventory.Internal.Runtime as Worker;
uses FpasAmp.Library.Inventory.Model as M;
uses FpasAmp.Library.Inventory.Progress as P;
uses FpasAmp.Library.Metadata.Monitoring as Tags;
uses FpasAmp.Library.Sources as S;
uses System as Sys;
uses System.IO as IO;
uses System.Threading as T;
uses System.Threading.Channels as Channels;
uses System.Threading.Tasks as Tasks;

// Owned discovery lifetime. Control methods never access the filesystem or database.
public type Session = record implements Sys.IAsyncDisposable
  // Latest completed inventory, capacity one.
  public Changes: Channels.ChannelReader of M.Snapshot;
  // Lightweight progress, capacity one and normally throttled to 100 ms.
  public Progress: Channels.ChannelReader of P.Snapshot;
  // Worker completion, including native resource and connection cleanup.
  public Completion: Tasks.Task;
  // Borrowed metadata/rating access when enabled; disposed with this inventory session.
  public Metadata: Tags.Session?;
  SetSources: procedure(array of S.MusicSource);
  RequestScan: procedure(string);
  RequestClear: function(string): Tasks.Task of M.Snapshot;
  Stop: function(): Tasks.Task;

  // Replaces validated settings. Pause/offline flags retain source-owned indexed data.
  public procedure Configure(Sources: array of S.MusicSource);
  requires Sources <> null;
  begin
    self.SetSources(S.Normalize(Sources));
  end procedure;

  // Requests a rescan of `Id`, or every active source when empty. Resume paused sources first.
  public procedure Refresh(Id: string := '');
  begin
    self.RequestScan(Id);
  end procedure;

  // Pauses and clears `Id`, or every source when empty, then acknowledges its snapshot.
  // `Cancellation` cancels waiting; an accepted clear remains owned by the worker.
  public function ClearAsync(Id: string; Cancellation: T.CancellationToken): Tasks.Task of M.Snapshot;
  begin
    return self.RequestClear(Id).WaitAsync(Cancellation);
  end function;

  // Requests cancellation, joins the worker and releases all resources; repeatable.
  public function DisposeAsync(): Tasks.ValueTask;
  begin
    return new Tasks.ValueTask(self.Stop());
  end function;

  // Starts background work after validation. `DatabasePath` is absolute or :memory:
  // for isolated tests; `Cancellation` owns the lifetime; `Settings` supplies scan bounds.
  // A distinct absolute `UserDataPath` enables the independently owned metadata stage.
  public static function Start(Sources: array of S.MusicSource; DatabasePath: string; Cancellation: T.CancellationToken; Settings: M.Options? := null; UserDataPath: string? := null): Session;
  requires Sources <> null;
  requires DatabasePath.Length > 0;
  begin
    if DatabasePath <> ':memory:' and not IO.Path.IsPathFullyQualified(DatabasePath) then
      raise new Sys.ArgumentException('Expected an absolute database path.');
    end if;

    if UserDataPath <> null then
      if DatabasePath = ':memory:' or not IO.Path.IsPathFullyQualified(UserDataPath)
        or S.PathComparer().Equals(
        IO.Path.GetFullPath(DatabasePath),
        IO.Path.GetFullPath(UserDataPath)
      )
      then
        raise new Sys.ArgumentException(
          'Metadata requires distinct absolute catalogue and user database paths.'
        );
      end if;
    end if;
    const Options: M.Options := Settings ?? new M.Options();
    if Options.DebounceMilliseconds < 0 or Options.ControlScanMilliseconds <= 0
      or Options.PendingDirectoryLimit <= 0
    then
      raise new Sys.ArgumentOutOfRangeException('Settings');
    end if;
    const Policy: M.Options := new M.Options(
      Options.DebounceMilliseconds,
      Options.ControlScanMilliseconds,
      Options.PendingDirectoryLimit
    );
    const Inbox: Q.Inbox := Q.Inbox.Create(S.Normalize(Sources), Policy.PendingDirectoryLimit);
    const Stop: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
      Cancellation
    );
    const Metadata: Tags.Session? := if UserDataPath <> null then
      Tags.Session.Start(Sources, DatabasePath, UserDataPath, Stop.Token)
    else
      null
    end if;
    const Bounds: Channels.BoundedChannelOptions := new Channels.BoundedChannelOptions(1);
    Bounds.FullMode := Channels.BoundedChannelFullMode.DropOldest;
    Bounds.AllowSynchronousContinuations := false;
    const Output: Channels.Channel of M.Snapshot := Channels.Channel.CreateBounded of M.Snapshot(
      Bounds
    );
    const Progress: Channels.Channel of P.Snapshot := Channels.Channel.CreateBounded of P.Snapshot(
      Bounds
    );
    const Running: Tasks.Task := Tasks.TaskExtensions.Unwrap(
      Tasks.Task.Run of Tasks.Task(
        function(): Tasks.Task => Worker.Run(
          Inbox,
          Output.Writer,
          Progress.Writer,
          DatabasePath,
          Policy,
          Stop.Token,
          procedure() begin
            if Metadata <> null then
              Metadata.Wake();
            end if;
          end procedure,
          UserDataPath,
          if Metadata <> null then
            Metadata.Ready
          else
            null
          end if
        )
      )
    );
    const Cleanup: Sys.Lazy of Tasks.Task := new Sys.Lazy of Tasks.Task(
      async function(): Tasks.Task begin
        Inbox.Close();
        try
          await Stop.CancelAsync().ConfigureAwait(false);
          await Running.ConfigureAwait(false);
        finally
          try
            if Metadata <> null then
              await Metadata.DisposeAsync().ConfigureAwait(false);
            end if;
          finally
            Inbox.Release();
            Stop.Dispose();
          end try;
        end try;
      end function
    );
    return new Session(
      Output.Reader,
      Progress.Reader,
      Running,
      Metadata,
      procedure(Value: array of S.MusicSource) begin
        Inbox.Configure(Value);
        if Metadata <> null then
          Metadata.Configure(Value);
        end if;
      end procedure,
      Inbox.Refresh,
      function(Id: string): Tasks.Task of M.Snapshot begin
        const Pending: Tasks.Task of M.Snapshot := Inbox.Clear(Id);
        if Metadata <> null then
          Metadata.Pause(Id);
        end if;

        return Pending;
      end function,
      function(): Tasks.Task => Cleanup.Value
    );
  end function;
end record;

end unit;
