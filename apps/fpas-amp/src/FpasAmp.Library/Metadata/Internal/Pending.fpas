// Durable pending selection keeps memory bounded even for very large libraries.
unit FpasAmp.Library.Metadata.Internal.Pending;

uses
  FpasAmp.Library.Persistence.Sql as Sql, FpasAmp.Library.Sources as S,
  Microsoft.Data.Sqlite as Db, System as Sys;

// One queued file observation, revalidated at read and commit boundaries.
public type File = record
  // Current presence ID.
  public Id: long;
  // Normalized absolute path.
  public Path: string;
  // Observed byte length.
  public Size: long;
  // Observed UTC last-write ticks.
  public Modified: long;
end record;

// Replaces worker-local active source IDs from isolated normalized `Sources`.
public procedure Configure(Connection: Db.SqliteConnection; Sources: array of S.MusicSource);
begin
  Sql.Execute(
    Connection,
    'CREATE TEMP TABLE IF NOT EXISTS metadata_active(id TEXT PRIMARY KEY); DELETE FROM metadata_active;',
    null,
    [],
    []
  );
  using const Transaction: Db.SqliteTransaction := Connection.BeginTransaction();
  for Source: S.MusicSource in Sources do
    if not Source.Offline and not Source.Paused and Source.Extensions.Length > 0 then
      Sql.Execute(
        Connection,
        'INSERT INTO metadata_active VALUES($id);',
        Transaction,
        ['$id'],
        [Source.Id]
      );
    end if;
  end for;

  Transaction.Commit();
end procedure;

// Returns the next eligible stale file after numeric ID `After`, or null.
// Failures retry after one minute; the cursor prevents repeated scans of earlier rows.
public function Next(Connection: Db.SqliteConnection; After: long): File?;
begin
  using const Query: Db.SqliteCommand := Sql.Command(
    Connection,
    'SELECT f.id,f.path,f.size,f.modified_utc FROM files f LEFT JOIN metadata m ON m.file_id=f.id' +
    ' WHERE f.id>$after AND f.size IS NOT NULL AND f.modified_utc IS NOT NULL AND EXISTS(' +
    'SELECT 1 FROM source_files s JOIN metadata_active a ON a.id=s.source_id JOIN sources r ON r.id=s.source_id' +
    ' LEFT JOIN directories d ON d.source_id=r.id AND d.path_key=r.path_key WHERE s.file_id=f.id AND d.error IS NULL)' +
    ' AND (m.file_id IS NULL OR m.size<>f.size OR m.modified_utc<>f.modified_utc OR (m.error IS NOT NULL AND m.read_utc<$retry))' +
    ' ORDER BY f.id LIMIT 1;',
    null,
    ['$retry', '$after'],
    [Sys.DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - 60000L, After]
  );
  using const Reader: Db.SqliteDataReader := Query.ExecuteReader();
  return if Reader.Read() then
    new File(Reader.GetInt64(0), Reader.GetString(1), Reader.GetInt64(2), Reader.GetInt64(3))
  else
    null
  end if;
end function;

end unit;
