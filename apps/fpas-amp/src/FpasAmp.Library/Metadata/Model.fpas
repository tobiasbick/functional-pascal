// [Documentation](../../../doc/library.md#metadata-and-queries)

// Detached metadata and bounded catalogue queries, independent of the GUI.
unit FpasAmp.Library.Metadata.Model;

uses FpasAmp.Media.Tags.AudioFiles as MediaTags;

// One indexed file and its independent durable user identity.
public type Entry = record
  // Presence-index identity, valid only until that index entry is removed.
  public FileId: long;
  // Durable UUID, retained across index clearing and unambiguous moves.
  public TrackId: string;
  // Current absolute file path.
  public Path: string;
  // Full-file SHA-256 in uppercase hexadecimal.
  public Sha256: string;
  // User rating, null when unassigned and otherwise one through ten.
  public Rating: int?;
  // Selected tags from the last successful read, or null if none succeeded.
  public Metadata: MediaTags.Info?;
  // Last read failure, or null after a successful read.
  public Error: string?;
  // Indexed source memberships at query time, including offline and paused sources.
  public SourceIds: array of string := [];
  // Stable indexed release identity, or empty until membership is known.
  public AlbumId: string := '';
  // Catalogue album title, including the folder-derived fallback.
  public AlbumTitle: string := '';
end record;

// Supported stable database ordering, with file ID as a final tie breaker.
public type Sort = enum
  // Explicit/display title sort key.
  Title;
  // Explicit/display album sort key.
  Album;
  // Explicit/first credited performer sort key.
  Artist;
  // Explicit/first album artist sort key.
  AlbumArtist;
  // First genre in invariant name order.
  Genre;
  // Normalized release date.
  ReleaseDate;
  // Duration in milliseconds.
  Duration;
  // User-assigned one-to-ten rating.
  Rating;
  // Normalized filesystem path key.
  Path;
end enum;

// A bounded file query; optional exact filters combine with AND.
public type Query = record
  // Ordering key.
  public Order: Sort := Sort.Title;
  // Whether to reverse the selected key's order.
  public Descending: bool := false;
  // Optional exact source membership filter.
  public SourceId: string? := null;
  // Optional exact album name, compared without invariant case.
  public Album: string? := null;
  // Optional exact performer credit, compared without invariant case.
  public Artist: string? := null;
  // Optional exact genre, compared without invariant case.
  public Genre: string? := null;
  // Inclusive rating floor; unrated entries do not match it.
  public MinimumRating: int? := null;
  // Maximum results, from one through five hundred.
  public Limit: int := 100;
  // Nonnegative result offset in the selected stable order.
  public Offset: int := 0;
end record;

end unit;
