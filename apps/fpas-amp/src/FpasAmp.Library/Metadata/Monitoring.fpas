// [Documentation](../../../doc/library.md#metadata-and-queries)

// Owned metadata lifetime and asynchronous catalogue/rating access.
unit FpasAmp.Library.Metadata.Monitoring;

uses Fpas.Media.Tags.Pictures as Pictures;
uses FpasAmp.Library.Albums.Access as Albums;
uses FpasAmp.Library.Metadata.Covers as Covers;
uses FpasAmp.Library.Metadata.Fingerprints.Calculator as FingerprintData;
uses FpasAmp.Library.Metadata.Fingerprints.Store as Fingerprints;
uses FpasAmp.Library.Metadata.Internal.Policy as P;
uses FpasAmp.Library.Metadata.Internal.Worker as Worker;
uses FpasAmp.Library.Metadata.Model as M;
uses FpasAmp.Library.Metadata.Persistence.Queries as Queries;
uses FpasAmp.Library.Metadata.Waveforms as Waveforms;
uses FpasAmp.Library.Playlists.Access as Lists;
uses FpasAmp.Library.Sources as S;
uses FpasAmp.Library.TagEditing.Access as TagAccess;
uses FpasAmp.Library.TagEditing.Files as TagFiles;
uses FpasAmp.Library.UserData.Ratings as Ratings;
uses FpasAmp.Library.UserData.Schema as Users;
uses Microsoft.Data.Sqlite as Db;
uses System as Sys;
uses System.Collections.Immutable as I;
uses System.IO as IO;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

// The metadata stage owns its worker; every public operation keeps I/O off its caller.
public type Session = record implements Sys.IAsyncDisposable
  // Completes when catalogue and user-data schemas are ready, or faults on opening errors.
  public Ready: Tasks.Task;
  // Background lifetime, including database errors and cleanup.
  public Completion: Tasks.Task;
  // Borrowed file/local playlist access, sharing this stage's lifetime.
  public Playlists: Lists.Session;
  // Borrowed album headers and lazy thumbnails, sharing this stage's lifetime.
  public Albums: Albums.Session;
  Database: string;
  UserDatabase: string;
  Policy: P.Policy;
  Lifetime: T.CancellationToken;
  Stop: function(): Tasks.Task;
  FingerprintGate: T.SemaphoreSlim;

  // Loads the editor's snapshot after the owned database schemas are ready.
  public async function ReadTags(Track: M.Entry; Cancellation: T.CancellationToken): Tasks.Task<TagFiles.Snapshot>;
  begin
    await self.Ready.WaitAsync(Cancellation).ConfigureAwait(false);
    return TagAccess.Load(self.Database, self.UserDatabase, Track);
  end function;

  // Records the editor's explicit changes in the selected destinations.
  public async function WriteTags(
    Track: M.Entry; Original: TagFiles.Snapshot;
    Changes: I.ImmutableDictionary<string, string?>; ToDatabase: bool; ToFile: bool;
    Cancellation: T.CancellationToken
  ): Tasks.Task;
  requires ToDatabase or ToFile;
  begin
    await self.Ready.WaitAsync(Cancellation).ConfigureAwait(false);
    TagAccess.Save(
      self.Database,
      self.UserDatabase,
      Track,
      Original,
      Changes,
      ToDatabase,
      ToFile,
      Cancellation
    );
  end function;

  // Replaces isolated normalized source policy and wakes the bounded worker.
  public procedure Configure(Sources: array of S.MusicSource);
  begin
    self.Lifetime.ThrowIfCancellationRequested();
    self.Policy.Configure(S.Normalize(Sources));
  end procedure;

  // Marks a source/all sources paused before an index-clear acknowledgement.
  public procedure Pause(Id: string);
  begin
    self.Policy.Pause(Id);
  end procedure;

  // Wakes processing after a committed directory checkpoint, without queuing file paths.
  public procedure Wake();
  begin
    self.Policy.Wake();
  end procedure;

  // Reads a bounded page sorted/filtered by `Request`. Cancellation owns this query.
  public async function QueryAsync(Request: M.Query; Cancellation: T.CancellationToken): Tasks.Task<I.ImmutableArray<M.Entry>>;
  requires Request.Limit >= 1 and Request.Limit <= 500;
  requires Request.Offset >= 0;
  requires Request.MinimumRating = null or (Request.MinimumRating >= 1 and Request.MinimumRating <=
    10);
  begin
    using const Linked: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
      self.Lifetime,
      Cancellation
    );
    await self.Ready.WaitAsync(Linked.Token).ConfigureAwait(false);
    return await Tasks.Task.Run<I.ImmutableArray<M.Entry>>(
      function(): I.ImmutableArray<M.Entry> => Queries.Read(
        self.Database,
        self.UserDatabase,
        Request,
        Linked.Token
      ),
      Linked.Token
    ).ConfigureAwait(false);
  end function;

  // Resolves the saved playback queue against current library paths and metadata.
  // ## Parameters
  // - `AlbumId`: Release identity, or empty for the whole library.
  // - `Cancellation`: Cancels waiting and reading.
  // ## Returns
  // Current source entries in their default playback order.
  public async function QueueAsync(AlbumId: string; Cancellation: T.CancellationToken): Tasks.Task<I.ImmutableArray<M.Entry>>;
  requires AlbumId <> null;
  begin
    using const Linked: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
      self.Lifetime,
      Cancellation
    );
    await self.Ready.WaitAsync(Linked.Token).ConfigureAwait(false);
    return await Tasks.Task.Run<I.ImmutableArray<M.Entry>>(
      function(): I.ImmutableArray<M.Entry> => Queries.ReadRelease(
        self.Database,
        self.UserDatabase,
        AlbumId,
        Linked.Token
      ),
      Linked.Token
    ).ConfigureAwait(false);
  end function;

  // Loads embedded artwork only on request and caches it by content hash.
  // `FileId` is an indexed file; cancellation bounds waiting and cache I/O.
  public async function CoverAsync(FileId: long; Cancellation: T.CancellationToken): Tasks.Task<Pictures.Cover?>;
  requires FileId > 0L;
  begin
    using const Linked: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
      self.Lifetime,
      Cancellation
    );
    await self.Ready.WaitAsync(Linked.Token).ConfigureAwait(false);
    return await Tasks.TaskExtensions.Unwrap<Pictures.Cover?>(
      Tasks.Task.Run<Tasks.Task<Pictures.Cover?>>(
        function(): Tasks.Task<Pictures.Cover?> => Covers.Read(
          self.Database,
          self.UserDatabase,
          FileId,
          Linked.Token
        ),
        Linked.Token
      )
    ).ConfigureAwait(false);
  end function;

  // Gets the cached or newly measured waveform without blocking the caller.
  // ## Parameters
  // - `Track`: Indexed track selected for playback.
  // - `Cancellation`: Cancels this request independently of the session lifetime.
  // ## Returns
  // Normalized RMS levels in playback order.
  public async function WaveformAsync(Track: M.Entry; Cancellation: T.CancellationToken): Tasks.Task<array of float>;
  requires Track.Path <> '';
  begin
    using const Linked: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
      self.Lifetime, Cancellation
    );
    await self.Ready.WaitAsync(Linked.Token).ConfigureAwait(false);
    return await Tasks.TaskExtensions.Unwrap<array of float>(
      Tasks.Task.Run<Tasks.Task<array of float>>(
        function(): Tasks.Task<array of float> => Waveforms.Read(
          self.Database,
          Track,
          Linked.Token
        ),
        Linked.Token
      )
    ).ConfigureAwait(false);
  end function;

  // Looks up the fingerprint for Track and optionally generates a missing value.
  // Cancellation interrupts the request and its child process. Returns the full encoded value or null.
  public async function FingerprintAsync(Track: M.Entry; Generate: bool; Cancellation: T.CancellationToken): Tasks.Task<string?>;
  requires Track.Path <> '';
  begin
    const Result: FingerprintData.Measurement? := await self.MeasureFingerprintAsync(
      Track,
      Generate,
      Cancellation
    ).ConfigureAwait(false);
    return if Result = null then
      null
    else
      Result.Value
    end if;
  end function;

  // Reads the fingerprint and whole-file duration for Track and generates them on a miss if Generate is true.
  // Cancellation interrupts the request and any child process. Returns null when no cached value exists and Generate is false.
  public async function MeasureFingerprintAsync(Track: M.Entry; Generate: bool; Cancellation: T.CancellationToken): Tasks.Task<FingerprintData.Measurement?>;
  requires Track.Path <> '';
  begin
    using const Linked: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
      self.Lifetime,
      Cancellation
    );
    await self.Ready.WaitAsync(Linked.Token).ConfigureAwait(false);
    if not Generate then
      return await Tasks.Task.Run<FingerprintData.Measurement?>(
        function(): FingerprintData.Measurement? => Fingerprints.Cached(self.Database, Track),
        Linked.Token
      ).ConfigureAwait(false);
    end if;

    return await Tasks.TaskExtensions.Unwrap<FingerprintData.Measurement?>(
      Tasks.Task.Run<Tasks.Task<FingerprintData.Measurement?>>(
        function(): Tasks.Task<FingerprintData.Measurement?> => Fingerprints.Generate(
          self.Database,
          Track,
          self.Policy,
          self.FingerprintGate,
          Linked.Token
        ),
        Linked.Token
      )
    ).ConfigureAwait(false);
  end function;

  // Saves a user rating (one through ten, or null) for durable `TrackId`.
  // Imported tags and subsequent rescans never overwrite this value.
  public async function SetRatingAsync(TrackId: string; Value: int?; Cancellation: T.CancellationToken): Tasks.Task;
  requires TrackId <> '';
  requires Value = null or (Value >= 1 and Value <= 10);
  begin
    using const Linked: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
      self.Lifetime,
      Cancellation
    );
    await self.Ready.WaitAsync(Linked.Token).ConfigureAwait(false);
    await Tasks.Task.Run(
      procedure() begin
        using const Connection: Db.SqliteConnection := Users.Open(self.UserDatabase);
        Ratings.SetValue(Connection, TrackId, Value, Linked.Token);
      end procedure, Linked.Token
    ).ConfigureAwait(false);
  end function;

  // Cancels and joins metadata work. Repeated disposal awaits the same cleanup.
  public function DisposeAsync(): Tasks.ValueTask;
  begin
    return new Tasks.ValueTask(self.Stop());
  end function;

  // Starts a bounded stage for file-backed `Database` and a distinct `UserDatabase`.
  // Both paths are absolute; `Sources` are copied and `Cancellation` owns the lifetime.
  public static function Start(Sources: array of S.MusicSource; Database: string; UserDatabase: string; Cancellation: T.CancellationToken): Session;
  requires Sources <> null;
  begin
    if not IO.Path.IsPathFullyQualified(Database) or not IO.Path.IsPathFullyQualified(UserDatabase)
      or S.PathComparer().Equals(IO.Path.GetFullPath(Database), IO.Path.GetFullPath(UserDatabase))
    then
      raise new Sys.ArgumentException(
        'Expected distinct absolute catalogue and user database paths.'
      );
    end if;
    const Policy: P.Policy := P.Policy.Create(S.Normalize(Sources));
    const Stop: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
      Cancellation
    );
    const Ready: Tasks.TaskCompletionSource<bool> := new Tasks.TaskCompletionSource<bool>(
      Tasks.TaskCreationOptions.RunContinuationsAsynchronously
    );
    const Running: Tasks.Task := Tasks.TaskExtensions.Unwrap(
      Tasks.Task.Run<Tasks.Task>(
        function(): Tasks.Task => Worker.Run(Policy, Database, UserDatabase, Ready, Stop.Token)
      )
    );
    const Cleanup: Sys.Lazy<Tasks.Task> := new Sys.Lazy<Tasks.Task>(
      async function(): Tasks.Task begin
        try
          await Stop.CancelAsync().ConfigureAwait(false);
          await Running.ConfigureAwait(false);
        finally
          Policy.Release();
          Stop.Dispose();
        end try;
      end function
    );
    return new Session(
      Ready.Task,
      Running,
      Lists.Session.Create(Database, UserDatabase, Ready.Task, Stop.Token),
      Albums.Session.Create(Database, UserDatabase, Ready.Task, Stop.Token, Policy),
      Database,
      UserDatabase,
      Policy,
      Stop.Token,
      function(): Tasks.Task => Cleanup.Value, new T.SemaphoreSlim(1, 1)
    );
  end function;
end record;

end unit;
