// [Documentation](../../../../doc/library.md#metadata-and-queries)

// Bound queries use explicit sort keys and parameterized exact filters.
unit FpasAmp.Library.Metadata.Persistence.Queries;

uses
  FpasAmp.Library.Serialization.CatalogueJson as Codec,
  FpasAmp.Library.Metadata.Model as M, FpasAmp.Library.Persistence.Sql as Sql,
  Microsoft.Data.Sqlite as Db, System as Sys, System.Collections.Generic as C,
  System.Collections.Immutable as I, System.Threading as T;

const Columns: string := 'SELECT f.id,COALESCE(m.track_id,''''),f.path,COALESCE(m.sha256,''''),u.rating,m.tags_json,m.error,' +
  '(SELECT json_group_array(s.source_id) FROM source_files s WHERE s.file_id=f.id),COALESCE(a.album_id,''''),COALESCE(a.title,'''')';

function Order(Value: M.Sort): string;
begin
  case Value of
    when M.Sort.Title:
      return 'm.sort_title';
    when M.Sort.Album:
      return 'm.sort_album';
    when M.Sort.Artist:
      return 'm.sort_artist';
    when M.Sort.AlbumArtist:
      return 'm.sort_album_artist';
    when M.Sort.Genre:
      return '(SELECT MIN(g.name_key) FROM metadata_genres g WHERE g.file_id=f.id)';
    when M.Sort.ReleaseDate:
      return 'm.release_date';
    when M.Sort.Duration:
      return 'm.duration_ms';
    when M.Sort.Rating:
      return 'u.rating';
    when M.Sort.Path:
      return 'f.path_key';
    else
      raise new Sys.ArgumentOutOfRangeException('Order');
  end case;
end function;

function Key(Value: string?): string?;
begin
  return if Value <> null then
    Value.ToUpperInvariant()
  else
    null
  end if;
end function;

// Reads a bounded detached page from both stores. `Request` is validated by the
// public session, `UserDatabase` is its durable store, and cancellation bounds row iteration.
public function Read(Database: string; UserDatabase: string; Request: M.Query; Cancellation: T.CancellationToken): I.ImmutableArray<M.Entry>;
begin
  Cancellation.ThrowIfCancellationRequested();
  using const Connection: Db.SqliteConnection := Sql.Open(Database);
  Sql.Execute(Connection, 'ATTACH DATABASE $path AS users;', null, ['$path'], [UserDatabase]);
  const Direction: string := if Request.Descending then
    ' DESC'
  else
    ' ASC'
  end if;
  using const Query: Db.SqliteCommand := Sql.Command(
    Connection,
    Columns +
    ' FROM files f JOIN metadata m ON m.file_id=f.id LEFT JOIN users.tracks u ON u.id=m.track_id' +
    ' LEFT JOIN album_tracks a ON a.file_id=f.id WHERE ($source IS NULL OR EXISTS(SELECT 1 FROM source_files s WHERE s.file_id=f.id AND s.source_id=$source))' +
    ' AND ($album IS NULL OR m.album_key=$album)' +
    ' AND ($artist IS NULL OR EXISTS(SELECT 1 FROM metadata_people p WHERE p.file_id=f.id AND p.role=''artist'' AND p.name_key=$artist))' +
    ' AND ($genre IS NULL OR EXISTS(SELECT 1 FROM metadata_genres g WHERE g.file_id=f.id AND g.name_key=$genre))' +
    ' AND ($rating IS NULL OR u.rating>=$rating)' +
    ' ORDER BY ' + Order(Request.Order) + Direction + ',f.id ASC LIMIT $limit OFFSET $offset;',
    null,
    ['$source', '$album', '$artist', '$genre', '$rating', '$limit', '$offset'],
    [
      Request.SourceId, Key(Request.Album), Key(Request.Artist), Key(Request.Genre),
      cast<object?>(Request.MinimumRating), Request.Limit, Request.Offset
    ]
  );
  return Entries(Query, Cancellation);
end function;

// Reads the tracks of an exact indexed release, ordered by disc and track number.
//
// ## Parameters
// - `Database`: Validated catalogue path.
// - `UserDatabase`: Validated durable ratings store path.
// - `Id`: Stable release identity, or empty for all indexed audio, including pending tags.
// - `Cancellation`: Cancels row iteration.
// ## Returns
// Detached tracks for the release, including their independent user ratings.
public function ReadRelease(Database: string; UserDatabase: string; Id: string; Cancellation: T.CancellationToken): I.ImmutableArray<M.Entry>;
requires Id <> null;
begin
  Cancellation.ThrowIfCancellationRequested();
  using const Connection: Db.SqliteConnection := Sql.Open(Database);
  Sql.Execute(Connection, 'ATTACH DATABASE $path AS users;', null, ['$path'], [UserDatabase]);
  const Scope: string := if Id = '' then
    ' WHERE f.kind=0 ORDER BY m.sort_album_artist,m.sort_album,a.album_id,'
  else
    ' WHERE a.album_id=$album ORDER BY '
  end if;
  using const Query: Db.SqliteCommand := Sql.Command(
    Connection,
    Columns +
    ' FROM files f LEFT JOIN album_tracks a ON a.file_id=f.id LEFT JOIN metadata m ON m.file_id=f.id' +
    ' LEFT JOIN users.tracks u ON u.id=m.track_id' + Scope +
    'COALESCE(json_extract(m.tags_json,''$.DiscNumber''),1),' +
    ' COALESCE(json_extract(m.tags_json,''$.TrackNumber''),2147483647),m.sort_title,f.id;',
    null, [], []
  );
  if Id <> '' then
    discard Query.Parameters.AddWithValue('$album', Id);
  end if;

  return Sql.Interruptible<I.ImmutableArray<M.Entry>>(
    Connection, Cancellation,
    function(): I.ImmutableArray<M.Entry> => Entries(Query, Cancellation)
  );
end function;

function Entries(Query: Db.SqliteCommand; Cancellation: T.CancellationToken): I.ImmutableArray<M.Entry>;
begin
  const Results: C.List<M.Entry> := new C.List<M.Entry>();
  using const Reader: Db.SqliteDataReader := Query.ExecuteReader();
  while Reader.Read() do
    Cancellation.ThrowIfCancellationRequested();
    Results.Add(
      new M.Entry(
        Reader.GetInt64(0), Reader.GetString(1), Reader.GetString(2), Reader.GetString(3),
        if Reader.IsDBNull(4) then
          null
        else
          Reader.GetInt32(4)
        end if,
        if Reader.IsDBNull(5) then
          null
        else
          Codec.ReadTrack(Reader.GetString(5))
        end if,
        if Reader.IsDBNull(6) then
          null
        else
          Reader.GetString(6)
        end if,
        Codec.ReadNames(Reader.GetString(7)) ?? Sys.Array.Empty<string>(),
        Reader.GetString(8), Reader.GetString(9)
      )
    );
  end while;

  return I.ImmutableArray.CreateRange<M.Entry>(Results);
end function;

end unit;
