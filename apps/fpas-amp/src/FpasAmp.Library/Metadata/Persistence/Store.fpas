// [Documentation](../../../../doc/library.md#metadata-and-queries)

// Atomic metadata replacement retains the last successful tags after read errors.
unit FpasAmp.Library.Metadata.Persistence.Store;

uses Fpas.Media.Tags.AudioFiles as MediaTags;
uses FpasAmp.Library.Albums.Persistence.Store as Albums;
uses FpasAmp.Library.Persistence.Sql as Sql;
uses FpasAmp.Library.Serialization.CatalogueJson as Codec;
uses FpasAmp.Library.TagEditing.Fields as Fields;
uses FpasAmp.Library.TagEditing.Overrides as Overrides;
uses Microsoft.Data.Sqlite as Db;
uses System as Sys;
uses System.Threading as T;

function First(Values: array of string): string;
begin
  return if Values.Length > 0 then
    Values[0]
  else
    ''
  end if;
end function;

function SortKey(Explicit: string; Display: string): string;
begin
  return (if Explicit <> '' then
    Explicit
  else
    Display
  end if).ToUpperInvariant();
end function;

procedure People(Connection: Db.SqliteConnection; Transaction: Db.SqliteTransaction; Id: long; Role: string; Values: array of string);
begin
  for Position: int := 0 to Values.Length - 1 do
    Sql.Execute(
      Connection,
      'INSERT INTO metadata_people(file_id,role,position,name,name_key) VALUES($file,$role,$position,$name,$key);',
      Transaction, ['$file', '$role', '$position', '$name', '$key'],
      [Id, Role, Position, Values[Position], Values[Position].ToUpperInvariant()]
    );
  end for;
end procedure;

// Replaces the displayed metadata and its derived indexes for the file in the current transaction.
public procedure Project(Connection: Db.SqliteConnection; Transaction: Db.SqliteTransaction; Id: long; Tags: MediaTags.Info);
begin
  Albums.Save(Connection, Transaction, Id, Tags);
  Sql.Execute(
    Connection,
    'UPDATE metadata SET tags_json=$json,title=$title,album=$album,album_key=$albumname,sort_title=$titlekey,sort_album=$albumkey,' +
    'sort_artist=$artistkey,sort_album_artist=$albumartistkey,release_date=$date,duration_ms=$duration WHERE file_id=$id;' +
    'DELETE FROM metadata_people WHERE file_id=$id; DELETE FROM metadata_genres WHERE file_id=$id;',
    Transaction,
    [
      '$id',
      '$json',
      '$title',
      '$album',
      '$albumname',
      '$titlekey',
      '$albumkey',
      '$artistkey',
      '$albumartistkey',
      '$date',
      '$duration'
    ],
    [
      Id,
      Codec.WriteTrack(Tags),
      Tags.Title,
      Tags.Album,
      Tags.Album.ToUpperInvariant(),
      SortKey(Tags.SortTitle, Tags.Title),
      SortKey(Tags.SortAlbum, Tags.Album),
      SortKey(
        Tags.SortArtist,
        First(Tags.Artists)
      ),
      SortKey(Tags.SortAlbumArtist, First(Tags.AlbumArtists)),
      Tags.ReleaseDate,
      cast<object?>(Tags.DurationMilliseconds)
    ]
  );
  People(Connection, Transaction, Id, 'artist', Tags.Artists);
  People(Connection, Transaction, Id, 'album_artist', Tags.AlbumArtists);
  People(Connection, Transaction, Id, 'composer', Tags.Composers);
  for Position: int := 0 to Tags.Genres.Length - 1 do
    Sql.Execute(
      Connection,
      'INSERT INTO metadata_genres(file_id,position,name,name_key) VALUES($file,$position,$name,$key);',
      Transaction, ['$file', '$position', '$name', '$key'],
      [Id, Position, Tags.Genres[Position], Tags.Genres[Position].ToUpperInvariant()]
    );
  end for;
end procedure;

// Saves a read only while the same file ID/stamp and an active membership remain.
// `Tags=null` records `Error` but preserves earlier tags/relationships. Empty `TrackId`
// or `Hash` retain earlier values. Cancellation or `Current=false` rolls back the write.
// Returns whether this attempt was committed.
public function Save(Connection: Db.SqliteConnection; Id: long; Size: long; Modified: long; TrackId: string; Hash: string; Tags: MediaTags.Info?; Error: string?; Current: function(): bool; Cancellation: T.CancellationToken): bool;
begin
  Cancellation.ThrowIfCancellationRequested();
  using const Transaction: Db.SqliteTransaction := Connection.BeginTransaction();
  using const Check: Db.SqliteCommand := Sql.Command(
    Connection,
    'SELECT count(*) FROM files f WHERE f.kind=0 AND f.id=$id AND f.size=$size AND f.modified_utc=$modified' +
    ' AND EXISTS(SELECT 1 FROM source_files s JOIN metadata_active a ON a.id=s.source_id WHERE s.file_id=f.id);',
    Transaction, ['$id', '$size', '$modified'], [Id, Size, Modified]
  );
  if Sys.Convert.ToInt64(Check.ExecuteScalar()) = 0L or not Current() then
    return false;
  end if;

  Sql.Execute(
    Connection,
    'INSERT INTO metadata(file_id,track_id,sha256,size,modified_utc,read_utc,error) VALUES($id,$track,$hash,$size,$modified,$read,$error)' +
    ' ON CONFLICT(file_id) DO UPDATE SET track_id=CASE WHEN excluded.track_id='''' THEN metadata.track_id ELSE excluded.track_id END,' +
    'sha256=CASE WHEN excluded.sha256='''' THEN metadata.sha256 ELSE excluded.sha256 END,' +
    'size=excluded.size,modified_utc=excluded.modified_utc,read_utc=excluded.read_utc,error=excluded.error;',
    Transaction, ['$id', '$track', '$hash', '$size', '$modified', '$read', '$error'],
    [Id, TrackId, Hash, Size, Modified, Sys.DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), Error]
  );
  if Tags <> null then
    Project(
      Connection,
      Transaction,
      Id,
      Fields.Project(Tags, Overrides.Read(Connection, Transaction, TrackId))
    );
  end if;

  Cancellation.ThrowIfCancellationRequested();
  if not Current() then
    return false;
  end if;

  Sql.Execute(
    Connection,
    'UPDATE playlist_items SET track_id=$track WHERE track_id IS NULL AND reference_key=(SELECT path_key FROM files WHERE id=$id) AND $track<>'''';' +
    'DELETE FROM content_jobs WHERE file_id=$id;', Transaction, ['$id', '$track'], [Id, TrackId]
  );
  Transaction.Commit();
  return true;
end function;

end unit;
