// ATL's playlist extensions remain independent of audio-format selection.
unit FpasAmp.Library.Playlists.Formats;

uses System as Sys, System.IO as IO;

// Tests `Extension`, including its leading dot, against ATL's playlist readers.
public function IsExtension(Extension: string): bool;
begin
  for Known: string in [
    '.m3u',
    '.m3u8',
    '.pls',
    '.xspf',
    '.fpl',
    '.asx',
    '.wax',
    '.wvx',
    '.b4s',
    '.dpl',
    '.smil',
    '.smi',
    '.wpl',
    '.zpl'
  ] do
    if Sys.String.Equals(Extension, Known, Sys.StringComparison.OrdinalIgnoreCase) then
      return true;
    end if;
  end for;

  return false;
end function;

// Tests a path without opening or parsing the file.
public function IsPlaylist(Path: string): bool;
begin
  return IsExtension(IO.Path.GetExtension(Path) ?? '');
end function;

end unit;
