// ATL reads a bounded snapshot with target metadata/network access disabled.
unit FpasAmp.Library.Playlists.Internal.Reading;

uses
  FpasAmp.Library.Playlists.Internal.References as R,
  FpasAmp.Library.Playlists.Formats as Formats,
  FpasAmp.Library.Metadata.Internal.Reading as Facts,
  FpasAmp.Library.Inventory.Internal.Directories as Directories,
  ATL.Playlist as A, ATL as Audio, System as Sys, System.IO as IO,
  System.Collections.Generic as C, System.Threading as T;

// One retained location and its playlist-specific title.
public type Item = record
  // Location with an optional host-local comparison key.
  public Reference: R.Reference;
  // Display text supplied by the playlist, independent of audio tags.
  public Title: string;
end record;

// One bounded parse attempt; failure retains previous cached entries.
public type Result = record
  // Ordered references, empty when parsing failed.
  public Items: array of Item;
  // Parse/read error, or null on success.
  public Error: string?;
end record;

// Reads supported absolute `Path` on a worker, retaining missing/remote entries.
// Expected `Size` and `Modified` reject stale files; cancellation bounds copying
// and entry iteration. Files are limited to sixteen MiB and 100000 entries.
// Optional `Current` rejects obsolete source policies between bounded copy blocks.
public function Read(Path: string; Size: long; Modified: long; Cancellation: T.CancellationToken; Current: Sys.Func<bool>? := null): Result;
  procedure Check();
  begin
    Cancellation.ThrowIfCancellationRequested();
    case Current of
      when is Sys.Func<bool> as Predicate:
        if not Predicate.Invoke() then
          raise new Sys.OperationCanceledException('The source policy changed.');
        end if;
      else
    end case;
  end procedure;
begin
  var Temporary: string := '';
  try
    Check();
    if not Formats.IsPlaylist(Path) then
      raise new IO.InvalidDataException('Unsupported playlist format.');
    end if;

    if Size > 16777216L then
      raise new IO.InvalidDataException('Playlist exceeds sixteen MiB.');
    end if;

    Directories.Check(IO.Path.GetDirectoryName(Path) ?? '');
    if not Facts.Matches(
      Path,
      Size,
      Modified
    ) or (IO.File.GetAttributes(
      Path
    ) and IO.FileAttributes.ReparsePoint) <> cast<IO.FileAttributes>(0)
    then
      raise new IO.IOException('The playlist changed before reading.');
    end if;

    Temporary := IO.Path.Combine(
      IO.Path.GetTempPath(),
      Sys.Guid.NewGuid().ToString('N') + IO.Path.GetExtension(Path)
    );
    begin
      using const Source: IO.FileStream := new IO.FileStream(
        Path,
        IO.FileMode.Open,
        IO.FileAccess.Read,
        IO.FileShare.Read or IO.FileShare.Delete
      );
      using const Copy: IO.FileStream := new IO.FileStream(
        Temporary,
        IO.FileMode.CreateNew,
        IO.FileAccess.Write,
        IO.FileShare.None
      );
      const Buffer: array of byte := new byte[65536];
      var Total: long := 0L;
      while true do
        Check();
        const Count: int := Source.Read(Buffer, 0, Buffer.Length);
        if Count = 0 then
          break;
        end if;

        Total := Total + Count;
        if Total > 16777216L then
          raise new IO.InvalidDataException('Playlist exceeds sixteen MiB.');
        end if;

        Copy.Write(Buffer, 0, Count);
      end while;
    end;

    Check();
    const Factory: A.PlaylistIOFactory? := A.PlaylistIOFactory.GetInstance();
    if Factory = null then
      raise new Sys.InvalidOperationException('ATL playlist factory is unavailable.');
    end if;
    const Parsed: A.IPlaylistIO? := Factory.GetPlaylistIO(Temporary, readTrackMetadata := false);
    if Parsed = null then
      raise new IO.InvalidDataException('Unsupported playlist format.');
    end if;
    const Failure: Sys.Exception? := Parsed.LoadError;
    if Failure <> null then
      raise new IO.InvalidDataException(
        'ATL could not parse the playlist: ' + Failure.Message,
        Failure
      );
    end if;
    const Locations: C.IReadOnlyList<string?>? := Parsed.OriginalLocations;
    const Tracks: C.IList<Audio.Track?>? := Parsed.Tracks;
    if Locations = null or Tracks = null or Locations.Count <> Tracks.Count then
      raise new IO.InvalidDataException('ATL returned inconsistent playlist entries.');
    end if;
    const Entries: C.List<Item> := new C.List<Item>();
    const Extension: string := (IO.Path.GetExtension(Path) ?? '').ToLowerInvariant();
    const Escaped: bool := Extension = '.xspf' or Extension = '.b4s' or Extension = '.asx'
      or Extension = '.wax' or Extension = '.wvx' or Extension = '.smil' or Extension = '.smi'
      or Extension = '.wpl' or Extension = '.zpl';
    for Position: int := 0 to Locations.Count - 1 do
      Check();
      const Track: Audio.Track? := Tracks[Position];
      const Artist: string := if Track <> null then
        Track.Artist ?? ''
      else
        ''
      end if;
      const Title: string := (if Artist <> '' then
        Artist + ' - '
      else
        ''
      end if) + (if Track <> null then
        Track.Title ?? ''
      else
        ''
      end if);
      Entries.Add(
        new Item(
          R.Resolve(Locations[Position] ?? '', IO.Path.GetDirectoryName(Path) ?? '', Escaped),
          Title
        )
      );
    end for;

    Check();
    if not Facts.Matches(Path, Size, Modified) then
      raise new IO.IOException('The playlist changed during reading.');
    end if;

    return new Result(Entries.ToArray(), null);
  catch Cancelled: Sys.OperationCanceledException when Cancellation.IsCancellationRequested do
    raise;
  catch Failure: Sys.Exception do
    return new Result([], Failure.Message);
  finally
    if Temporary <> '' then
      IO.File.Delete(Temporary);
    end if;
  end try;
end function;

end unit;
