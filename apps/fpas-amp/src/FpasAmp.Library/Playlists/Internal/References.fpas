// Location normalization never opens media or contacts URI targets.
unit FpasAmp.Library.Playlists.Internal.References;

uses FpasAmp.Library.Persistence.Sql as Sql, System as Sys, System.IO as IO;

// A normalized playlist reference, with a catalogue key only for host-local paths.
public type Reference = record
  // Absolute local path, foreign path or non-file URI.
  public Location: string;
  // Host path comparison key, or null for remote/foreign locations.
  public Key: string?;
end record;

// Rejects empty or multiline `Value`; `Name` identifies the invalid argument.
public procedure Validate(Value: string; Name: string);
begin
  if Sys.String.IsNullOrWhiteSpace(
    Value
  ) or Value.Contains(#0) or Value.Contains(#10) or Value.Contains(#13)
  then
    raise new Sys.ArgumentException('Expected a nonempty single-line value.', Name);
  end if;
end procedure;

// Tests whether `Value` is an absolute host/foreign path or a nonrelative URI.
public function IsAbsolute(Value: string): bool;
begin
  return IO.Path.IsPathFullyQualified(Value) or Value.StartsWith('\\')
    or (Value.Length >= 3 and Sys.Char.IsAsciiLetter(
    Value[0]
  ) and Value[1] = #58 and (Value[2] = #92 or Value[2] = #47))
    or Sys.Uri.IsWellFormedUriString(Value, Sys.UriKind.Absolute);
end function;

// Resolves `Value` relative to absolute `Directory`. `Escaped` describes XML URI
// references; ordinary playlist paths retain literal percent characters.
public function Resolve(Value: string; Directory: string; Escaped: bool := false): Reference;
begin
  Validate(Value, 'Reference');
  var Path: string := Value;
  if not Sys.OperatingSystem.IsWindows() and (Path.StartsWith(
    '\\'
  ) or (Path.Length >= 3 and Path[1] = #58 and (Path[2] = #92 or Path[2] = #47)))
  then
    return new Reference(Path, null);
  end if;

  if IO.Path.IsPathFullyQualified(Path) then
    Path := IO.Path.GetFullPath(
      if Escaped then
        Sys.Uri.UnescapeDataString(Path)
      else
        Path
      end if
    );
    return new Reference(Path, Sql.Key(Path));
  end if;
  var Parsed: Sys.Uri? := null;
  discard Sys.Uri.TryCreate(Path, Sys.UriKind.Absolute, out Parsed);
  case Parsed of
    when is Sys.Uri as Uri:
      if not Uri.IsFile then
        return new Reference(Path, null);
      end if;

      Path := Uri.LocalPath;
      if not IO.Path.IsPathFullyQualified(Path) then
        return new Reference(Value, null);
      end if;
    else
      if Escaped then
        Path := Sys.Uri.UnescapeDataString(Path);
      end if;

      Path := Path.Replace(#92, IO.Path.DirectorySeparatorChar);
      Path := IO.Path.GetFullPath(Path, Directory);
  end case;

  Path := IO.Path.GetFullPath(Path);
  return new Reference(Path, Sql.Key(Path));
end function;

end unit;
