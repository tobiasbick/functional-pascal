// [Documentation](../../../../doc/library.md#playlists)

// Explicit imports create durable copies; export has one canonical UTF-8 format.
unit FpasAmp.Library.Playlists.Internal.Transfer;

uses FpasAmp.Library.Playlists.Formats.Reading as Reading;
uses FpasAmp.Library.Playlists.Model as M;
uses FpasAmp.Library.Playlists.Persistence.Queries as Queries;
uses FpasAmp.Library.Playlists.Persistence.UserLists as Lists;
uses FpasAmp.Media.Tags.Playlists as Files;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.IO as IO;
uses System.Threading as T;

// Imports supported absolute `Path` into durable `Database`, preserving ordered
// targets without enrolling their folders as sources. `Name` defaults to the stem.
// Returns the new independent local key; cancellation never leaves a partial list.
public function Import(
  Database: string;
  Path: string;
  Name: string?;
  Cancellation: T.CancellationToken
): M.Key;
begin
  if not IO.Path.IsPathFullyQualified(Path) then
    raise new Sys.ArgumentException('Expected an absolute playlist path.', 'Path');
  end if;
  const Info: IO.FileInfo := new IO.FileInfo(Path);
  const Value: Reading.Result := Reading.Read(
    Path,
    Info.Length,
    Info.LastWriteTimeUtc.Ticks,
    Cancellation
  );
  if Value.Error <> null then
    raise new IO.InvalidDataException(Value.Error);
  end if;
  const Items: C.List of M.Input := new C.List of M.Input();
  for Item: Reading.Item in Value.Items do
    Items.Add(new M.Input(M.Target.Location(Item.Reference.Location), Item.Title));
  end for;

  return Lists.Save(
    Database,
    null,
    Name ?? IO.Path.GetFileNameWithoutExtension(Path) ?? '',
    Items.ToArray(),
    Cancellation
  );
end function;

// Exports `Identity` from both stores to absolute `.m3u8` `Destination`.
// `Overwrite` explicitly authorizes replacing an existing file. A same-directory
// temporary write is renamed atomically only after success and cancellation checks.
public procedure Export(
  Database: string;
  Users: string;
  Identity: M.Key;
  Destination: string;
  Overwrite: bool;
  Cancellation: T.CancellationToken
);
begin
  const Value: M.Playlist? := Queries.Read(Database, Users, Identity, Cancellation);
  if Value = null then
    raise new Sys.ArgumentException('Unknown playlist.', 'Identity');
  end if;
  const Items: C.List of Files.Item := new C.List of Files.Item();
  for Entry: M.Entry in Value.Entries do
    Items.Add(new Files.Item(Entry.CurrentReference, Entry.Title));
  end for;

  Files.WriteM3u8(Destination, Items.ToArray(), Overwrite, Cancellation);
end procedure;

end unit;
