// [Documentation](../../../doc/library.md#search)

// Ranked search over prepared documents: words in any order, any of them, typos and
// sound-alike spellings, weighted by how rare a word is across the documents.
unit FpasAmp.Library.Search.Matching;

uses FpasAmp.Library.Search.Text as Tokens;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;

// Results below this share of the best score are noise from loose matches.
const Cutoff: double := 0.2;

// One searchable text of an item and its importance.
public type Field = record
  // The text, such as an album title.
  public Text: string;
  // Relative importance; a title usually outweighs a genre.
  public Weight: double := 1.0;
end record;

// One folded word of a document with its phonetic code and field weight.
public type Term = record
  // The folded word.
  public Word: string;
  // Its Kölner Phonetik code, empty for numbers.
  public Key: string;
  // The weight of the field the word comes from.
  public Weight: double;
end record;

// The prepared search data of one item, built once whenever the item changes.
public type Document = record
  // The words of all fields, including adjacent pairs written together.
  public Terms: array of Term;
  // Original field texts for literal phrase matching.
  public Texts: array of string;

  // Prepares `Fields` for searching.
  //
  // ## Parameters
  // - `Fields`: The item's texts with their weights.
  // ## Returns
  // The document. Adjacent words are also indexed together, so "pinkfloyd"
  // finds "Pink Floyd".
  public static function Create(Fields: array of Field): Document;
  begin
    const Terms: C.List of Term := new C.List of Term();
    for Item: Field in Fields do
      const Parts: array of string := Tokens.Words(Item.Text);
      for Index: int := 0 to Parts.Length - 1 do
        Terms.Add(new Term(Parts[Index], Tokens.Phonetic(Parts[Index]), Item.Weight));
        if Index > 0 then
          const Joined: string := Parts[Index - 1] + Parts[Index];
          Terms.Add(new Term(Joined, Tokens.Phonetic(Joined), Item.Weight * 0.95));
        end if;
      end for;
    end for;

    const Texts: array of string := Sys.Array.ConvertAll of (Field, string)(
      Fields, function(Item: Field): string => Item.Text
    );
    return new Document(Terms.ToArray(), Texts);
  end function;
end record;

// A prepared query with folded words and required literal phrases.
public type Query = record
  // Distinct folded words in input order.
  public Words: array of string;
  // The phonetic code of each word.
  public Keys: array of string;
  // Required phrases as typed between double quotes.
  public Phrases: array of string;

  // Prepares free text and quoted phrases typed by a user. Free words are folded
  // and ranked in any order. Quoted phrases retain spelling, spaces and punctuation.
  //
  // ## Parameters
  // - `Text`: The search text.
  // ## Returns
  // The query; empty when `Text` contains no words or phrases.
  public static function Parse(Text: string): Query;
  begin
    const Distinct: C.List of string := new C.List of string();
    const Parts: Tokens.QueryParts := Tokens.ParseQuery(Text);
    for Word: string in Parts.Words do
      if not Distinct.Contains(Word) then
        Distinct.Add(Word);
      end if;
    end for;

    const Codes: C.List of string := new C.List of string();
    for Word: string in Distinct do
      Codes.Add(Tokens.Phonetic(Word));
    end for;

    return new Query(Distinct.ToArray(), Codes.ToArray(), Parts.Phrases);
  end function;

  // Reports whether the query has no words or phrases.
  //
  // ## Returns
  // True for a query with no searchable input.
  public function IsEmpty(): bool;
  begin
    return self.Words.Length = 0 and self.Phrases.Length = 0;
  end function;
end record;

// How well a typed word matches one document word, between zero and one.
function Similarity(Word: string; Key: string; Candidate: Term): double;
begin
  const Other: string := Candidate.Word;
  if Other = Word then
    return 1.0;
  end if;

  var Best: double := 0.0;
  if Other.StartsWith(Word, Sys.StringComparison.Ordinal) then
    // a word being typed: the more of it is there, the better
    Best := 0.75 + 0.2 * cast<double>(Word.Length) / cast<double>(Other.Length);
  end if;

  if Tokens.Numeric(Word) then
    return Best;
  end if;

  if Word.Length >= 3 and Other.Contains(Word, Sys.StringComparison.Ordinal) then
    Best := Sys.Math.Max(Best, 0.55);
  end if;

  if Word.Length >= 3 and Key <> '' and Key = Candidate.Key then
    Best := Sys.Math.Max(Best, 0.7);
  end if;

  if Word.Length >= 4 then
    const Limit: int := if Word.Length >= 8 then
      2
    else
      1
    end if;
    const Edits: int := Tokens.Distance(Word, Other, Limit);
    if Edits <= Limit then
      Best := Sys.Math.Max(Best, 0.8 - 0.15 * cast<double>(Edits));
    elsif Other.Length > Word.Length then
      // a typo in a word that is still being typed
      if Tokens.Distance(Word, Other.Substring(0, Word.Length), 1) <= 1 then
        Best := Sys.Math.Max(Best, 0.6);
      end if;
    end if;
  end if;

  return Best;
end function;

function Matches(Word: string; Key: string; Item: Document): double;
begin
  var Best: double := 0.0;
  for Candidate: Term in Item.Terms do
    Best := Sys.Math.Max(Best, Similarity(Word, Key, Candidate) * Candidate.Weight);
  end for;

  return Best;
end function;

// Scores each document that contains all quoted phrases. Free words contribute
// independently, so more matches, rarer words and closer spellings rank higher.
//
// ## Parameters
// - `Search`: The prepared query.
// - `Documents`: The prepared documents.
// ## Returns
// One score per document, in the same order; zero means no match. Matches far
// below the best one are dropped as noise in searches without quotes. An empty
// query scores everything zero.
public function Rank(Search: Query; Documents: I.ImmutableArray of Document): array of double;
begin
  const Scores: array of double := new double[Documents.Length];
  if Search.IsEmpty() or Documents.Length = 0 then
    return Scores;
  end if;

  const HasPhrases: bool := Search.Phrases.Length > 0;
  if HasPhrases then
    for Index: int := 0 to Documents.Length - 1 do
      if Tokens.PhrasesMatch(Search.Phrases, Documents[Index].Texts) then
        Scores[Index] := 1.0;
      end if;
    end for;
  end if;

  const Count: double := cast<double>(Documents.Length);
  const Found: array of double := new double[Documents.Length];
  for Position: int := 0 to Search.Words.Length - 1 do
    var Hits: int := 0;
    for Index: int := 0 to Documents.Length - 1 do
      if HasPhrases and Scores[Index] = 0.0 then
        continue;
      end if;

      Found[Index] := Matches(Search.Words[Position], Search.Keys[Position], Documents[Index]);
      if Found[Index] > 0.0 then
        Hits := Hits + 1;
      end if;
    end for;

    // a word that many documents share, such as "the", says little
    const Rarity: double := Sys.Math.Log(1.0 + Count / cast<double>(Sys.Math.Max(1, Hits)));
    for Index: int := 0 to Documents.Length - 1 do
      Scores[Index] := Scores[Index] + Found[Index] * Rarity;
    end for;
  end for;

  if HasPhrases then
    return Scores;
  end if;

  var Top: double := 0.0;
  for Score: double in Scores do
    Top := Sys.Math.Max(Top, Score);
  end for;

  for Index: int := 0 to Scores.Length - 1 do
    if Scores[Index] < Top * Cutoff then
      Scores[Index] := 0.0;
    end if;
  end for;

  return Scores;
end function;

end unit;
