// [Documentation](../../../doc/library.md#search)

// Language-independent search keys: folded words, phonetic codes and typo distance.
unit FpasAmp.Library.Search.Text;

uses System as Sys;
uses System.Collections.Generic as C;
uses System.Globalization as G;
uses System.Text as Text;

// Appends lower-case `Letter` to `Word`, spelling out letters that have no
// accent-free decomposition.
procedure Fold(Word: Text.StringBuilder; Letter: Text.Rune);
begin
  const Code: int := Letter.Value;
  if Code = 223 then
    discard Word.Append('ss');
  elsif Code = 230 then
    discard Word.Append('ae');
  elsif Code = 339 then
    discard Word.Append('oe');
  elsif Code = 248 then
    discard Word.Append('o');
  elsif Code = 273 or Code = 240 then
    discard Word.Append('d');
  elsif Code = 322 then
    discard Word.Append('l');
  elsif Code = 254 then
    discard Word.Append('th');
  elsif Code = 305 then
    discard Word.Append('i');
  elsif Letter.IsBmp then
    discard Word.Append(cast<char>(Code));
  else
    discard Word.Append(Letter.ToString());
  end if;
end procedure;

// Splits `Value` into lower-case words without accents, so "Björk" and "bjork"
// or "Straße" and "strasse" are the same word. Letters and digits form words;
// apostrophes join their neighbors ("Don't" becomes "dont"), everything else separates.
//
// ## Parameters
// - `Value`: Any text.
// ## Returns
// The words in their original order; empty when `Value` has none.
public function Words(Value: string): array of string;
begin
  const Result: C.List<string> := new C.List<string>();
  const Word: Text.StringBuilder := new Text.StringBuilder();
  for Letter: Text.Rune in Value.Normalize(Text.NormalizationForm.FormKD).EnumerateRunes() do
    const Category: G.UnicodeCategory := Text.Rune.GetUnicodeCategory(Letter);
    if Category = G.UnicodeCategory.NonSpacingMark or Category =
      G.UnicodeCategory.SpacingCombiningMark
    then
      continue;
    end if;

    if Text.Rune.IsLetterOrDigit(Letter) then
      Fold(Word, Text.Rune.ToLowerInvariant(Letter));
    elsif Letter.Value = 39 or Letter.Value = 8217 then
      continue;
    elsif Word.Length > 0 then
      Result.Add(Word.ToString());
      discard Word.Clear();
    end if;
  end for;

  if Word.Length > 0 then
    Result.Add(Word.ToString());
  end if;

  return Result.ToArray();
end function;

// The folded words and literal phrases of a library search.
public type QueryParts = record
  // Folded words outside quotation marks.
  public Words: array of string;
  // Required substrings in their original spelling, spacing and punctuation.
  public Phrases: array of string;
end record;

// Separates paired double quotes in `Value` from free text. An unmatched opening
// quote stays part of free text until the user closes it. Empty quotes add no term.
//
// ## Parameters
// - `Value`: The complete search text.
// ## Returns
// Folded free words and the original text of each nonempty phrase.
public function ParseQuery(Value: string): QueryParts;
begin
  if not Value.Contains(#34) then
    return new QueryParts(Words(Value), []);
  end if;

  const Parts: array of string := Value.Split(#34);
  const FreeText: Text.StringBuilder := new Text.StringBuilder();
  const Phrases: C.List<string> := new C.List<string>();
  for Index: int := 0 to Parts.Length - 1 do
    const Part: string := Parts[Index];
    if Index mod 2 = 1 and Index < Parts.Length - 1 then
      if not Sys.String.IsNullOrWhiteSpace(Part) then
        Phrases.Add(Part);
      end if;
    else
      discard FreeText.Append(Part).Append(' ');
    end if;
  end for;

  return new QueryParts(Words(FreeText.ToString()), Phrases.ToArray());
end function;

// Checks that each phrase is a literal substring of a single field, ignoring case.
//
// ## Parameters
// - `Phrases`: Required substrings, in their original spelling.
// - `Fields`: Searchable field texts in their original spelling.
// ## Returns
// True when every phrase is present.
public function PhrasesMatch(Phrases: array of string; Fields: array of string): bool;
begin
  for Phrase: string in Phrases do
    var Found: bool := false;
    for Field: string in Fields do
      if Field.Contains(Phrase, Sys.StringComparison.OrdinalIgnoreCase) then
        Found := true;
        break;
      end if;
    end for;

    if not Found then
      return false;
    end if;
  end for;

  return true;
end function;

// True when every character of `Word` is a decimal digit.
//
// ## Parameters
// - `Word`: A folded word.
// ## Returns
// Whether `Word` is a number such as a year, which matches only exactly or as a prefix.
public function Numeric(Word: string): bool;
begin
  for Letter: Text.Rune in Word.EnumerateRunes() do
    if not Text.Rune.IsDigit(Letter) then
      return false;
    end if;
  end for;

  return Word.Length > 0;
end function;

function Code(Word: string; Index: int): string;
begin
  const Letter: string := Word[Index].ToString();
  const Previous: string := if Index > 0 then
    Word[Index - 1].ToString()
  else
    ''
  end if;
  const Next: string := if Index + 1 < Word.Length then
    Word[Index + 1].ToString()
  else
    ''
  end if;
  if 'aeijouy'.Contains(Letter) then
    return '0';
  elsif Letter = 'b' then
    return '1';
  elsif Letter = 'p' then
    return if Next = 'h' then
      '3'
    else
      '1'
    end if;
  elsif Letter = 'd' or Letter = 't' then
    return if Next <> '' and 'csz'.Contains(Next) then
      '8'
    else
      '2'
    end if;
  elsif 'fvw'.Contains(Letter) then
    return '3';
  elsif 'gkq'.Contains(Letter) then
    return '4';
  elsif Letter = 'c' then
    if Index = 0 then
      return if Next <> '' and 'ahkloqrux'.Contains(Next) then
        '4'
      else
        '8'
      end if;
    end if;

    return if Next <> '' and 'ahkoqux'.Contains(
      Next
    ) and not (Previous <> '' and 'sz'.Contains(Previous))
    then
      '4'
    else
      '8'
    end if;
  elsif Letter = 'x' then
    return if Previous <> '' and 'ckq'.Contains(Previous) then
      '8'
    else
      '48'
    end if;
  elsif Letter = 'l' then
    return '5';
  elsif Letter = 'm' or Letter = 'n' then
    return '6';
  elsif Letter = 'r' then
    return '7';
  elsif Letter = 's' or Letter = 'z' then
    return '8';
  end if;

  return '';
end function;

// Returns the Kölner Phonetik code of a folded word, so words that sound alike
// share a code: "Meier", "Mayer" and "Maier" all become "67".
//
// ## Parameters
// - `Word`: A folded lower-case word, as returned by `Words`.
// ## Returns
// The code, or an empty string for numbers and words without Latin letters.
public function Phonetic(Word: string): string;
begin
  if Numeric(Word) then
    return '';
  end if;

  const Raw: Text.StringBuilder := new Text.StringBuilder();
  for Index: int := 0 to Word.Length - 1 do
    discard Raw.Append(Code(Word, Index));
  end for;

  const Result: Text.StringBuilder := new Text.StringBuilder();
  for Index: int := 0 to Raw.Length - 1 do
    const Digit: char := Raw[Index];
    if Index > 0 and Digit = Raw[Index - 1] then
      continue;
    end if;

    if Index > 0 and cast<int>(Digit) = 48 then
      continue;
    end if;

    discard Result.Append(Digit);
  end for;

  return Result.ToString();
end function;

// Counts the edits between two words: inserting, deleting or replacing a letter,
// or swapping two neighbors. Stops early once `Limit` is exceeded.
//
// ## Parameters
// - `Left`: The first word.
// - `Right`: The second word.
// - `Limit`: The largest distance of interest, zero or more.
// ## Returns
// The distance, or `Limit + 1` when it is larger than `Limit`.
public function Distance(Left: string; Right: string; Limit: int): int;
requires Limit >= 0;
begin
  if Sys.Math.Abs(Left.Length - Right.Length) > Limit then
    return Limit + 1;
  end if;

  var Before: array of int := new int[Right.Length + 1];
  var Previous: array of int := new int[Right.Length + 1];
  var Current: array of int := new int[Right.Length + 1];
  for Column: int := 0 to Right.Length do
    Previous[Column] := Column;
  end for;

  for Row: int := 1 to Left.Length do
    Current[0] := Row;
    var Smallest: int := Row;
    for Column: int := 1 to Right.Length do
      const Cost: int := if Left[Row - 1] = Right[Column - 1] then
        0
      else
        1
      end if;
      var Value: int := Sys.Math.Min(
        Sys.Math.Min(Previous[Column] + 1, Current[Column - 1] + 1),
        Previous[Column - 1] + Cost
      );
      if Row > 1 and Column > 1 and Left[
        Row - 1
      ] = Right[Column - 2] and Left[Row - 2] = Right[Column - 1]
      then
        Value := Sys.Math.Min(Value, Before[Column - 2] + 1);
      end if;

      Current[Column] := Value;
      Smallest := Sys.Math.Min(Smallest, Value);
    end for;

    if Smallest > Limit then
      return Limit + 1;
    end if;

    const Spare: array of int := Before;
    Before := Previous;
    Previous := Current;
    Current := Spare;
  end for;

  const Result: int := Previous[Right.Length];
  return if Result > Limit then
    Limit + 1
  else
    Result
  end if;
end function;

end unit;
