// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

// Derives the shown albums from the catalogue, the search text, the filters and the order.
unit FpasAmp.Ui.Albums.Browse;

uses FpasAmp.Library.Albums.Model as Library;
uses FpasAmp.Library.Search.Matching as Matching;
uses FpasAmp.Ui.Albums.Toolbar.Model as Toolbar;
uses FpasAmp.Ui.Collections.FilterOptions as Options;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;
uses System.Globalization as G;

// Search documents and filter choices, prepared once per catalogue snapshot.
public type Catalog = record
  // One search document per album, in catalogue order.
  public Documents: I.ImmutableArray of Matching.Document := (I.ImmutableArray of Matching.Document).Empty;
  // Distinct album artists in display order.
  public Artists: array of string := [];
  // Distinct genres in display order.
  public Genres: array of string := [];
end record;

const Weights: array of double := [1.0, 0.9, 0.6];

function Names(): Sys.StringComparer;
begin
  return Sys.StringComparer.Create(
    G.CultureInfo.CurrentCulture,
    G.CompareOptions.IgnoreCase or G.CompareOptions.IgnoreNonSpace
  );
end function;

function Sorted(Values: C.HashSet of string): array of string;
begin
  const Result: C.List of string := new C.List of string(Values);
  Result.Sort(Names());
  return Result.ToArray();
end function;

// Prepares the search documents and the filter choices of `Items`.
//
// ## Parameters
// - `Items`: The headers of one catalogue snapshot.
// - `Scope`: Determines whether individual artist credits are searchable and filterable.
// ## Returns
// The catalog; titles weigh most in searches, then artists, then genres.
public function Prepare(Items: I.ImmutableArray of Library.Album; Scope: Toolbar.Scope := Toolbar.Scope.Albums): Catalog;
begin
  const Documents: (I.ImmutableArray of Matching.Document).Builder := I.ImmutableArray.CreateBuilder of Matching.Document(
    Items.Length
  );
  const Artists: C.HashSet of string := new C.HashSet of string(Names());
  const Genres: C.HashSet of string := new C.HashSet of string(Names());
  const CommonGenres: C.HashSet of string := new C.HashSet of string(Names());
  const CommonArtists: C.HashSet of string := new C.HashSet of string(Names());
  var First: bool := true;
  for Album: Library.Album in Items do
    const Fields: C.List of Matching.Field := new C.List of Matching.Field(
      [new Matching.Field(Album.Title, Weights[0])]
    );
    if (Scope = Toolbar.Scope.Albums or Scope = Toolbar.Scope.GenreAlbums) then
      Fields.Add(new Matching.Field(Album.Artist, Weights[1]));
    end if;

    for Genre: string in Album.Genres do
      if Scope <> Toolbar.Scope.GenreAlbums then
        Fields.Add(new Matching.Field(Genre, Weights[2]));
      end if;

      discard Genres.Add(Genre);
    end for;

    Documents.Add(Matching.Document.Create(Fields.ToArray()));
    if First then
      CommonGenres.UnionWith(Album.Genres);
    else
      CommonGenres.IntersectWith(Album.Genres);
    end if;

    if (Scope = Toolbar.Scope.Albums or Scope = Toolbar.Scope.GenreAlbums) then
      const Members: C.List of string := new C.List of string();
      if Album.Credits.Length > 0 then
        for Credit: Library.Membership in Album.Credits do
          Members.Add(Credit.Name);
        end for;
      elsif not Sys.String.IsNullOrWhiteSpace(Album.Artist) then
        Members.Add(Album.Artist);
      end if;

      Artists.UnionWith(Members);
      if First then
        CommonArtists.UnionWith(Members);
      else
        CommonArtists.IntersectWith(Members);
      end if;
    end if;

    First := false;
  end for;

  Genres.ExceptWith(CommonGenres);
  Artists.ExceptWith(CommonArtists);

  return new Catalog(
    Documents.MoveToImmutable(), Sorted(Artists),
    if Toolbar.Root(Scope) = Toolbar.Scope.Genres then
      []
    else
      Sorted(Genres)
    end if
  );
end function;

// Clears unavailable selections in Current's applied filters and draft using Prepared's choices.
public function ReconcileFilters(Current: Toolbar.State; Prepared: Catalog): Toolbar.State;
  function Retain(Value: Toolbar.Filters): Toolbar.Filters;
  begin
    const Comparer: Sys.StringComparer := Names();
    return Value with
      Artist := Options.Retain(Value.Artist, Prepared.Artists, Comparer.Equals);
      Genre := Options.Retain(Value.Genre, Prepared.Genres, Comparer.Equals);
    end with;
  end function;
begin
  return Current with
    Applied := Retain(Current.Applied);
    Draft := Retain(Current.Draft);
  end with;
end function;

function Allowed(Album: Library.Album; Filters: Toolbar.Filters): bool;
begin
  if Filters.Artist <> '' then
    var Found: bool := Album.Credits.Length = 0 and Names().Compare(
      Album.Artist,
      Filters.Artist
    ) = 0;
    for Credit: Library.Membership in Album.Credits do
      if Names().Compare(Credit.Name, Filters.Artist) = 0 then
        Found := true;
        break;
      end if;
    end for;

    if not Found then
      return false;
    end if;
  end if;

  if not Toolbar.MatchesRating(Album.Rating, Filters.MinimumRating) then
    return false;
  end if;

  if Filters.Genre = '' then
    return true;
  end if;

  for Genre: string in Album.Genres do
    if Names().Compare(Genre, Filters.Genre) = 0 then
      return true;
    end if;
  end for;

  return false;
end function;

// One candidate album and its sort keys.
type Entry = record
  // Album presented by the browser.
  public Album: Library.Album;
  // Search relevance score used by the best-match order.
  public Score: double;
  // Original catalogue position used as the final tie-breaker.
  public Position: int;
end record;

// Selects and orders the albums to show.
//
// ## Parameters
// - `Items`: The album headers, in catalogue order.
// - `Prepared`: The catalog prepared from `Items`; another catalog is rejected.
// - `Settings`: The search text, applied filters and order.
// ## Returns
// The albums that pass the filters and, with search words, match at least one
// of them. Best match lists the closest albums first. Equal sort keys use the
// album title and then retain catalogue order.
public function Select(Items: I.ImmutableArray of Library.Album; Prepared: Catalog; Settings: Toolbar.State): I.ImmutableArray of Library.Album;
  function Compare(Left: Entry; Right: Entry): int;
  begin
    var Result: int := 0;
    case Settings.Sort of
      when Toolbar.Order.Relevance:
        Result := Right.Score.CompareTo(Left.Score);
      when Toolbar.Order.Title:
        Result := Names().Compare(Left.Album.Title, Right.Album.Title);
      when Toolbar.Order.Artist:
        Result := Names().Compare(Left.Album.Artist, Right.Album.Artist);
      when Toolbar.Order.Rating:
        Result := (Left.Album.Rating ?? 0).CompareTo(Right.Album.Rating ?? 0);
      when Toolbar.Order.Songs:
        Result := Left.Album.Tracks.CompareTo(Right.Album.Tracks);
      else
        raise new Sys.ArgumentOutOfRangeException('Settings');
    end case;

    if Settings.Descending and Settings.Sort <> Toolbar.Order.Relevance then
      Result := -Result;
    end if;

    if Result = 0 and Settings.Sort <> Toolbar.Order.Title then
      Result := Names().Compare(Left.Album.Title, Right.Album.Title);
    end if;

    return if Result <> 0 then
      Result
    else
      Left.Position.CompareTo(Right.Position)
    end if;
  end function;
begin
  if Prepared.Documents.Length <> Items.Length then
    raise new Sys.ArgumentException('The catalog was prepared from other albums.', 'Prepared');
  end if;

  const Search: Matching.Query := Matching.Query.Parse(Settings.Search);
  const Scores: array of double := Matching.Rank(Search, Prepared.Documents);
  const Shown: C.List of Entry := new C.List of Entry();
  for Index: int := 0 to Items.Length - 1 do
    if (Search.IsEmpty() or Scores[Index] > 0.0) and Allowed(Items[Index], Settings.Applied) then
      Shown.Add(new Entry(Items[Index], Scores[Index], Index));
    end if;
  end for;

  Shown.Sort(Compare);
  const Result: (I.ImmutableArray of Library.Album).Builder := I.ImmutableArray.CreateBuilder of Library.Album(
    Shown.Count
  );
  for Item: Entry in Shown do
    Result.Add(Item.Album);
  end for;

  return Result.MoveToImmutable();
end function;

end unit;
