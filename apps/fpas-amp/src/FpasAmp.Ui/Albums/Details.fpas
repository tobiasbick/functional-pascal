// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

// Read-only album details reuse CUI layout, images, text and the native star display.
unit FpasAmp.Ui.Albums.Details;

uses Fpas.Media.Images as Imaging;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Inputs.Ratings as Ratings;

uses FpasAmp.Library.Albums.Model as Library;
uses FpasAmp.Ui.Albums.Artwork as Artwork;
uses FpasAmp.Ui.Albums.Model as M;

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

// Formats the indexed `Count` for tile and hover descriptions.
public function Songs(Count: long): string;
requires Count >= 0L;
begin
  return Count.ToString() + if Count = 1L then
    ' song'
  else
    ' songs'
  end if;
end function;

// Builds the compact cover/details design from existing `Album` and cached `Image`.
// `Kind` labels the rating for this album, artist or genre.
// Content is informational; rating changes remain on the album tile itself.
public function Build(
  Album: Library.Album;
  Image: Imaging.Bitmap?;
  Kind: string := 'Album'
): E.Element of M.Msg;
requires Album.Id <> '';
begin
  return E.Column of M.Msg(
    new L.Flow(Gap := Points(12), Align := L.Alignment.Stretch, Clip := false),
    E.Row of M.Msg(
      new L.Flow(Gap := Points(16), Align := L.Alignment.Start, Clip := false),
      Artwork.Build of M.Msg('album-detail-cover-' + Album.Id, Image, 80),
      E.Size of M.Msg(
        E.Column of M.Msg(
          new L.Flow(Gap := Points(4), Clip := false),
          E.Styled of M.Msg(E.Text of M.Msg(Album.Title), S.Role.Strong),
          Texts.Text of M.Msg(Album.Artist, Texts.Appearance.Secondary),
          Texts.Text of M.Msg(Songs(Album.Tracks), Texts.Appearance.Muted)
        ), new L.Flex(Basis := L.Extent.Fill)
      )
    ),
    E.Size of M.Msg(
      E.Styled of M.Msg(E.Column of M.Msg(), S.Role.Divider),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(1)))
    ),
    E.Row of M.Msg(
      new L.Flow(Gap := Points(12), Align := L.Alignment.Center),
      Ratings.Rating of M.Msg(
        'album-detail-rating-' + Album.Id, Kind + ' rating', Album.Rating ?? 0,
        function(Value: int): M.Msg => M.Msg.Rate(Album.Id, Value), Maximum := 10, Enabled := false
      ),
      E.Size of M.Msg(E.Column of M.Msg(), new L.Flex(Basis := L.Extent.Fill)),
      Texts.Text of M.Msg(
        if Album.Rating = null then
          'Not rated'
        else
          Album.Rating.ToString() + ' / 10'
        end if,
        Texts.Appearance.Body
      )
    )
  );
end function;

end unit;
