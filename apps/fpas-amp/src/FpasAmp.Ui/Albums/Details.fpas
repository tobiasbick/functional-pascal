// Read-only album details reuse CUI layout, images, text and the native star display.
unit FpasAmp.Ui.Albums.Details;

uses
  FpasAmp.Ui.Albums.Model as M, FpasAmp.Ui.Albums.Artwork as Artwork,
  FpasAmp.Library.Albums.Model as Library, FpasAmp.Imaging as Imaging,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S,
  Fpas.Ui.Widgets.Display.Texts as Texts, Fpas.Ui.Widgets.Inputs.Ratings as Ratings;

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

// Formats the indexed `Count` for tile and hover descriptions.
public function Songs(Count: long): string;
requires Count >= 0L;
begin
  return Count.ToString() + if Count = 1L then
    ' song'
  else
    ' songs'
  end if;
end function;

// Builds the compact cover/details design from existing `Album` and cached `Image`.
// Content is informational; rating changes remain on the album tile itself.
public function Build(Album: Library.Album; Image: Imaging.Bitmap?): E.Element<M.Msg>;
requires Album.Id <> '';
begin
  return E.Column<M.Msg>(
    new L.Flow(Gap := Points(12), Align := L.Alignment.Stretch, Clip := false),
    E.Row<M.Msg>(
      new L.Flow(Gap := Points(16), Align := L.Alignment.Start, Clip := false),
      Artwork.Build<M.Msg>('album-detail-cover-' + Album.Id, Image, 80),
      E.Size<M.Msg>(
        E.Column<M.Msg>(
          new L.Flow(Gap := Points(4), Clip := false),
          E.Styled<M.Msg>(E.Text<M.Msg>(Album.Title), S.Role.Strong),
          Texts.Text<M.Msg>(Album.Artist, Texts.Appearance.Secondary),
          Texts.Text<M.Msg>(Songs(Album.Tracks), Texts.Appearance.Muted)
        ), new L.Flex(Basis := L.Extent.Fill)
      )
    ),
    E.Size<M.Msg>(
      E.Styled<M.Msg>(E.Column<M.Msg>(), S.Role.Divider),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(1)))
    ),
    E.Row<M.Msg>(
      new L.Flow(Gap := Points(12), Align := L.Alignment.Center),
      Ratings.Rating<M.Msg>(
        'album-detail-rating-' + Album.Id, 'Album rating', Album.Rating ?? 0,
        function(Value: int): M.Msg => M.Msg.Rate(Album.Id, Value), Maximum := 10, Enabled := false
      ),
      E.Size<M.Msg>(E.Column<M.Msg>(), new L.Flex(Basis := L.Extent.Fill)),
      Texts.Text<M.Msg>(
        if Album.Rating = null then
          'Not rated'
        else
          Album.Rating.ToString() + ' / 10'
        end if,
        Texts.Appearance.Body
      )
    )
  );
end function;

end unit;
