// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

// Groups artists or genres while preserving the catalogue order of their releases.
unit FpasAmp.Ui.Albums.Groups;

uses FpasAmp.Library.Albums.Model as Library;
uses FpasAmp.Ui.Albums.Toolbar.Model as Toolbar;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;
uses System.Linq as Linq;
uses System.Text as Text;

// Collection headers and the releases backing their artwork and drill-down.
public type Catalog = record
  // One grid header per group, with its own rating.
  public Headers: I.ImmutableArray of Library.Album := (I.ImmutableArray of Library.Album).Empty;
  // Members keyed by stable group identity, in album catalogue order.
  public Releases: I.ImmutableDictionary of (string, I.ImmutableArray of Library.Album) := I.ImmutableDictionary of (string, I.ImmutableArray of Library.Album).Empty;
end record;

// Groups the artists or genres in the detached catalogue snapshot `Albums` according to `Scope`.
// Returns lightweight headers and ordered cover candidates without opening any images.
public function Build(Albums: I.ImmutableArray of Library.Album; Scope: Toolbar.Scope): Catalog;
begin
  const Kind: Toolbar.Scope := Toolbar.Root(Scope);
  if not Toolbar.IsGroup(Kind) then
    return new Catalog();
  end if;
  const Buckets: C.Dictionary of (string, C.List of Library.Album) := new C.Dictionary of (string, C.List of Library.Album)();
  const Tags: C.Dictionary of (string, Library.Membership) := new C.Dictionary of (string, Library.Membership)();
  for Album: Library.Album in Albums do
    const Memberships: array of Library.Membership := if Kind = Toolbar.Scope.Artists then
      Album.Credits
    else
      Album.GenreMemberships
    end if;
    for Credit: Library.Membership in Memberships do
      if not Buckets.ContainsKey(Credit.Id) then
        Buckets[Credit.Id] := new C.List of Library.Album();
        Tags[Credit.Id] := Credit;
      end if;

      Buckets[Credit.Id].Add(
        if Kind = Toolbar.Scope.Genres then
          Album with
            Tracks := Credit.Tracks;
          end with
        else
          Album
        end if
      );
    end for;
  end for;
  const Headers: (I.ImmutableArray of Library.Album).Builder := I.ImmutableArray.CreateBuilder of Library.Album(
    Buckets.Count
  );
  const Releases: I.ImmutableDictionary of (string, I.ImmutableArray of Library.Album).Builder := I.ImmutableDictionary.CreateBuilder of (string, I.ImmutableArray of Library.Album)();
  for Id: string in Buckets.Keys do
    const Members: C.List of Library.Album := Buckets[Id];
    const Genres: C.SortedSet of string := new C.SortedSet of string(
      Sys.StringComparer.OrdinalIgnoreCase
    );
    const Revision: Text.StringBuilder := new Text.StringBuilder();
    var Tracks: long := 0L;
    for Album: Library.Album in Members do
      Tracks := Tracks + Album.Tracks;
      if Kind = Toolbar.Scope.Artists then
        Genres.UnionWith(Album.Genres);
      end if;

      discard Revision.Append(Album.Id).Append(Album.Revision);
    end for;
    const Labels: array of string := Linq.Enumerable.ToArray of string(Genres);
    const Credit: Library.Membership := Tags[Id];
    Headers.Add(
      new Library.Album(
        Id, Credit.Name, Members.Count.ToString() + if Members.Count = 1 then
          ' album'
        else
          ' albums'
        end if,
        Tracks, Revision.ToString(), Credit.Rating, Labels
      )
    );
    Releases[Id] := I.ImmutableArray.CreateRange of Library.Album(Members);
  end for;

  return new Catalog(Headers.MoveToImmutable(), Releases.ToImmutable());
end function;

end unit;
