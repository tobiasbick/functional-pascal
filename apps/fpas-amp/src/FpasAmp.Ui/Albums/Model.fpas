// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

// Slice-owned album headers and only the thumbnails needed by the current viewport.
unit FpasAmp.Ui.Albums.Model;

uses FpasAmp.Library.Albums.Model as Library;
uses FpasAmp.Media.Images as Images;
uses FpasAmp.Ui.Albums.Browse as Browse;
uses FpasAmp.Ui.Albums.Groups as Groups;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Albums.Toolbar.Model as Toolbar;
uses System.Collections.Immutable as I;

// Owner-thread album view state; pixels are never mutated after publication.
public type State = record
  // Complete library snapshot, independent of the active grid and its filters.
  public Library: Library.Snapshot := new Library.Snapshot();
  // Groups and their member releases for the current snapshot.
  public Collections: Groups.Catalog := new Groups.Catalog();
  // Current grid and the selected group for a discography.
  public Scope: Toolbar.Scope := Toolbar.Scope.Albums;
  // Identity and display name of the selected group.
  public GroupId: string := '';
  // Name shown above the grouped albums.
  public GroupName: string := '';
  // Applied filters and sort order to restore when returning to each grid route.
  public Toolbars: I.ImmutableDictionary of (string, Toolbar.State) := I.ImmutableDictionary of (string, Toolbar.State).Empty;
  // Vertical positions in logical points, keyed by grid route.
  public Offsets: I.ImmutableDictionary of (string, float) := I.ImmutableDictionary of (string, float).Empty;
  // Lightweight headers for the active grid.
  public Items: I.ImmutableArray of Library.Album := (I.ImmutableArray of Library.Album).Empty;
  // Search documents and filter choices prepared from Items.
  public Catalog: Browse.Catalog := new Browse.Catalog();
  // The albums the grid shows: Items after search, filters and sorting.
  public Shown: I.ImmutableArray of Library.Album := (I.ImmutableArray of Library.Album).Empty;
  // Whether the initial background query completed.
  public Loaded: bool := false;
  // Thumbnail values for realized albums; null means a confirmed missing image.
  public Images: I.ImmutableDictionary of (string, Images.Bitmap?) := I.ImmutableDictionary of (string, Images.Bitmap?).Empty;
  // First requested index into Shown, or -1 before layout observation.
  public First: int := -1;
  // Exclusive requested end index.
  public Last: int := -1;
  // Incremented for each data/range change to reject obsolete image completions.
  public Generation: long := 0L;
  // Recoverable background read error.
  public Error: string? := null;
  // Albums whose independent user rating is being saved in background work.
  public Saving: I.ImmutableHashSet of string := (I.ImmutableHashSet of string).Empty;
  // Search text, filters and order that select Shown from Items.
  public Toolbar: Toolbar.State := new Toolbar.State();
  // Visit counter keeps detached results scoped to the album that requested them.
  public MusicVisit: long := 0L;
  // In-session table controls for albums opened under each catalogue route.
  public MusicViews: I.ImmutableDictionary of (string, Music.Presentation) := I.ImmutableDictionary of (string, Music.Presentation).Empty;
  // Album tracks currently shown inside the Albums destination.
  public Music: Music.State? := null;
end record;

// Album lifecycle and immutable background publications.
public type Msg = variant
  // Enter the view and observe headers.
  Open;
  // Stop observations/image work and release decoded images.
  Close;
  // Replace album headers after a catalogue change.
  Received(Value: Library.Snapshot);
  // Realized album indices reported after native layout, never from the pure row factory.
  Visible(First: int; Last: int);
  // One completed thumbnail request, scoped to a generation.
  Image(Generation: long; Id: string; Value: Images.Bitmap?);
  // Report a background query failure.
  Failed(Message: string);
  // Propose a whole-star rating; zero clears the album rating.
  Rate(Id: string; Value: int);
  // Confirm durable persistence, without modifying track ratings.
  Rated(Id: string; Value: int?);
  // Restore the control after a failed write and show the error.
  RatingFailed(Id: string; Message: string);
  // Edit the search text, filters or order.
  Toolbar(Value: Toolbar.Msg);
  // Open the releases behind an artist or genre card.
  OpenGroup(Id: string);
  // Return to the retained artist or genre grid.
  BackToGroups;
  // Open the exact release represented by the activated card.
  OpenMusic(Id: string);
  // Return to the retained album grid.
  BackToAlbums;
  // Remember the latest target offset for the grid identified by RouteKey.
  Scrolled(RouteKey: string; Offset: float);
  // Route an input or background result to the selected release.
  Music(Value: Music.Msg);
end variant;

end unit;
