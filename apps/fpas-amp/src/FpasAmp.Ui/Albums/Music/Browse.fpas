// [Documentation](../../../../doc/desktop.md#browsing-music-and-collections)

// Track presentation and selection for a single release.
unit FpasAmp.Ui.Albums.Music.Browse;

uses
  Fpas.Media.Tags.AudioFiles as MediaTags, FpasAmp.Library.Albums.Model as Albums,
  FpasAmp.Ui.Albums.Music.Model as M, FpasAmp.Library.Metadata.Model as Tracks,
  FpasAmp.Ui.Albums.Toolbar.Model as Toolbar,
  FpasAmp.Ui.Collections.FilterOptions as Options,
  FpasAmp.Library.Search.Text as Text, System as Sys, System.IO as IO,
  System.Collections.Generic as C, System.Collections.Immutable as I, System.Threading as T;

// Returns the title of `Track`, using its file name when no title is tagged.
public function Title(Track: Tracks.Entry): string;
begin
  const Caption: string := (Track.Metadata ?? new MediaTags.Info()).Title;
  return if Caption = '' then
    IO.Path.GetFileNameWithoutExtension(Track.Path) ?? ''
  else
    Caption
  end if;
end function;

// Returns the genres tagged on `Track`.
public function Genres(Track: Tracks.Entry): array of string;
begin
  return (Track.Metadata ?? new MediaTags.Info()).Genres;
end function;

// Joins the performer credits of `Track` for display.
public function Artist(Track: Tracks.Entry): string;
begin
  return Sys.String.Join(', ', (Track.Metadata ?? new MediaTags.Info()).Artists);
end function;

// Returns the tagged album title or the catalogue's folder-derived title.
public function AlbumTitle(Item: Tracks.Entry): string;
begin
  return if Item.AlbumTitle <> '' then
    Item.AlbumTitle
  else
    (Item.Metadata ?? new MediaTags.Info()).Album
  end if;
end function;

// Returns the reported duration of `Track` in milliseconds, or zero if unknown.
public function Duration(Track: Tracks.Entry): double;
begin
  return (Track.Metadata ?? new MediaTags.Info()).DurationMilliseconds ?? 0.0;
end function;

// Formats a nonnegative duration `Milliseconds` as a compact time value.
public function Time(Milliseconds: double): string;
begin
  const Seconds: long := cast<long>(Sys.Math.Max(0.0, Milliseconds) / 1000.0);
  const Minutes: long := Seconds div 60L;
  if Minutes >= 60L then
    return (Minutes div 60L).ToString() + ':' + (Minutes mod 60L).ToString(
      '00'
    ) + ':' + (Seconds mod 60L).ToString('00');
  end if;

  return Minutes.ToString() + ':' + (Seconds mod 60L).ToString('00');
end function;

function TagChoices(Items: I.ImmutableArray<Tracks.Entry>; Values: function(Tracks.Entry): array of string; Stop: T.CancellationToken): array of string;
begin
  if Items.Length < 2 then
    return [];
  end if;
  const Names: C.Dictionary<string, string> := new C.Dictionary<string, string>(
    Sys.StringComparer.Ordinal
  );
  const Common: C.HashSet<string> := new C.HashSet<string>(Sys.StringComparer.Ordinal);
  const Keys: C.HashSet<string> := new C.HashSet<string>(Sys.StringComparer.Ordinal);
  var First: bool := true;
  for Track: Tracks.Entry in Items do
    Stop.ThrowIfCancellationRequested();
    Keys.Clear();
    for Name: string in Values(Track) do
      const Key: string := Albums.TagKey(Name);
      if Key <> '' then
        discard Names.TryAdd(Key, Name.Trim());
        discard Keys.Add(Key);
      end if;
    end for;

    if First then
      Common.UnionWith(Keys);
      First := false;
    elsif Common.Count > 0 then
      Common.IntersectWith(Keys);
    end if;
  end for;

  for Key: string in Common do
    discard Names.Remove(Key);
  end for;
  const Result: C.List<string> := new C.List<string>(Names.Values);
  Result.Sort(Sys.StringComparer.CurrentCultureIgnoreCase);
  return Result.ToArray();
end function;

// Returns the genres that match some but not all Items. Stop cancels catalogue preparation.
public function GenreChoices(Items: I.ImmutableArray<Tracks.Entry>; Stop: T.CancellationToken): array of string;
begin
  return TagChoices(Items, Genres, Stop);
end function;

// Returns the performers that match some but not all Items. Stop cancels catalogue preparation.
public function PerformerChoices(Items: I.ImmutableArray<Tracks.Entry>; Stop: T.CancellationToken): array of string;
  function Credits(Item: Tracks.Entry): array of string;
  begin
    const Info: MediaTags.Info? := Item.Metadata;
    return if Info <> null then
      Info.Artists
    else
      []
    end if;
  end function;
begin
  return TagChoices(Items, Credits, Stop);
end function;

function SameTag(Left: string; Right: string): bool;
begin
  return Albums.TagKey(Left) = Albums.TagKey(Right);
end function;

// Clears unavailable choices in Current's applied track filters and draft.
// The current catalogue supplies genre names, performer names and release IDs.
public function ReconcileFilters(Current: M.State): M.State;
  function Retain(Value: M.Filters): M.Filters;
  begin
    var Genres: I.ImmutableHashSet<string> := Value.Genres.Clear();
    for Selected: string in Value.Genres do
      const Name: string := Options.Retain(Selected, Current.GenreChoices, SameTag);
      if Name <> '' then
        Genres := Genres.Add(Name);
      end if;
    end for;

    return Value with
      Genres := Genres;
      Performer := Options.Retain(Value.Performer, Current.Performers, SameTag);
      ReleaseFilter := Options.Retain(
        Value.ReleaseFilter,
        Current.ReleaseIds,
        Sys.StringComparer.Ordinal.Equals
      );
    end with;
  end function;
begin
  return Current with
    Applied := Retain(Current.Applied);
    Draft := Retain(Current.Draft);
  end with;
end function;

function Has(Values: array of string; Selected: I.ImmutableHashSet<string>): bool;
begin
  if Selected.IsEmpty then
    return true;
  end if;

  for Value: string in Values do
    if Selected.Contains(Albums.TagKey(Value)) then
      return true;
    end if;
  end for;

  return false;
end function;

function Matches(Entry: Tracks.Entry; Query: Text.QueryParts; Library: bool): bool;
begin
  if Query.Words.Length = 0 and Query.Phrases.Length = 0 then
    return true;
  end if;

  const Caption: string := Title(Entry);
  var Plain: string := Caption;
  if Library then
    const Performer: string := Artist(Entry);
    const Release: string := AlbumTitle(Entry);
    if Query.Phrases.Length > 0 and not Text.PhrasesMatch(
      Query.Phrases,
      [Caption, Performer, Release]
    )
    then
      return false;
    end if;

    Plain := Caption + ' ' + Performer + ' ' + Release;
  else
    const Tags: array of string := Genres(Entry);
    if Query.Phrases.Length > 0 then
      const Values: C.List<string> := new C.List<string>([Caption]);
      Values.AddRange(Tags);
      if not Text.PhrasesMatch(Query.Phrases, Values.ToArray()) then
        return false;
      end if;
    end if;

    Plain := Caption + ' ' + Sys.String.Join(' ', Tags);
  end if;

  if Query.Words.Length = 0 then
    return true;
  end if;

  const Fields: array of string := Text.Words(Plain);
  for Term: string in Query.Words do
    var Found: bool := false;
    for Word: string in Fields do
      if Word.Contains(Term, Sys.StringComparison.Ordinal) then
        Found := true;
        break;
      end if;
    end for;

    if not Found then
      return false;
    end if;
  end for;

  return true;
end function;

// Captures the applied playback selection of the album page `Current`.
public function Selection(Current: M.State): M.Selection;
begin
  return new M.Selection(
    Current.Album.Id,
    Current.Search,
    if Current.RequiredGenre <> '' then
      [Current.RequiredGenre]
    else
      new C.List<string>(Current.Applied.Genres).ToArray()
    end if,
    Current.Applied.MinimumRating,
    Current.Order.Column,
    Current.Order.Descending,
    Current.Applied.Performer,
    Current.Applied.ReleaseFilter
  );
end function;

// Filters and orders source `TracksInOrder` according to `Source` for display or playback.
// Pending supplies the local edits to use for filtering, sorting and displayed values.
// ## Returns
// The same track order for a freshly opened page and a restored session.
public function Songs(TracksInOrder: I.ImmutableArray<Tracks.Entry>; Source: M.Selection; Pending: I.ImmutableDictionary<string, int?>? := null): I.ImmutableArray<Tracks.Entry>;
  function Compare(Left: Tracks.Entry; Right: Tracks.Entry): int;
  begin
    const Names: Sys.StringComparer := Sys.StringComparer.CurrentCultureIgnoreCase;
    const Value: int := case Source.Column of
      when 0: Names.Compare(Title(Left), Title(Right));
      when 1: Names.Compare(Artist(Left), Artist(Right));
      when 2: Names.Compare(AlbumTitle(Left), AlbumTitle(Right));
      when 5: Names.Compare(
        Sys.String.Join(', ', Genres(Left)),
        Sys.String.Join(', ', Genres(Right))
      );
      when 3: Duration(Left).CompareTo(Duration(Right));
      when 4: (Left.Rating ?? 0).CompareTo(Right.Rating ?? 0);
      else 0;
    end case;
    if Value = 0 then
      return Left.FileId.CompareTo(Right.FileId);
    end if;

    return if Source.Descending then
      -Value
    else
      Value
    end if;
  end function;
begin
  const Query: Text.QueryParts := Text.ParseQuery(Source.Search);
  const Keys: I.ImmutableHashSet<string>.Builder := I.ImmutableHashSet.CreateBuilder<string>();
  for Genre: string in Source.Genres do
    discard Keys.Add(Albums.TagKey(Genre));
  end for;
  const GenresFilter: I.ImmutableHashSet<string> := Keys.ToImmutable();
  const Performer: I.ImmutableHashSet<string> := if Source.Performer = '' then
    I.ImmutableHashSet<string>.Empty
  else
    I.ImmutableHashSet.Create<string>(Albums.TagKey(Source.Performer))
  end if;
  const Items: C.List<Tracks.Entry> := new C.List<Tracks.Entry>();
  for Item: Tracks.Entry in TracksInOrder do
    var Entry: Tracks.Entry := Item;
    var Value: int? := null;
    if Pending <> null and not Pending.IsEmpty and Pending.TryGetValue(Item.TrackId, out Value) then
      Entry := Item with
        Rating := Value;
      end with;
    end if;

    if Toolbar.MatchesRating(Entry.Rating, Source.MinimumRating)
      and (GenresFilter.IsEmpty or Has(Genres(Entry), GenresFilter)) and Matches(
      Entry,
      Query,
      Source.AlbumId = ''
    )
      and (Source.Performer = '' or Has(
      (Entry.Metadata ?? new MediaTags.Info()).Artists,
      Performer
    ))
      and (Source.ReleaseFilter = '' or Entry.AlbumId = Source.ReleaseFilter)
    then
      Items.Add(Entry);
    end if;
  end for;

  if Source.Column >= 0 then
    Items.Sort(Compare);
  end if;

  return I.ImmutableArray.CreateRange<Tracks.Entry>(Items);
end function;

// Returns the position of FileId in Shown, or -1 if that file is absent.
public function FindFile(Shown: I.ImmutableArray<Tracks.Entry>; FileId: long): int;
ensures (Position: int): Position >= -1;
begin
  for Position: int := 0 to Shown.Length - 1 do
    if Shown[Position].FileId = FileId then
      return Position;
    end if;
  end for;

  return -1;
end function;

// Returns the new position of the file at Index in Previous, or -1 when absent from Shown.
public function RowIndex(Previous: I.ImmutableArray<Tracks.Entry>; Index: int; Shown: I.ImmutableArray<Tracks.Entry>): int;
ensures (Position: int): Position >= -1;
begin
  if Index < 0 or Index >= Previous.Length then
    return -1;
  end if;
  const FileId: long := Previous[Index].FileId;
  if Index < Shown.Length and Shown[Index].FileId = FileId then
    return Index;
  end if;

  return FindFile(Shown, FileId);
end function;

// Returns `Current` with its visible tracks rebuilt from search, filters and sort.
public function Select(Current: M.State): M.State;
begin
  const Shown: I.ImmutableArray<Tracks.Entry> := Songs(
    Current.Tracks,
    Selection(Current),
    Current.Saving
  );
  var Total: double := 0.0;
  for Track: Tracks.Entry in Shown do
    Total := Total + Duration(Track);
  end for;

  return Current with
    Shown := Shown;
    Cursor := RowIndex(Current.Shown, Current.Cursor, Shown);
    Anchor := RowIndex(Current.Shown, Current.Anchor, Shown);
    TotalMilliseconds := Total;
  end with;
end function;

end unit;
