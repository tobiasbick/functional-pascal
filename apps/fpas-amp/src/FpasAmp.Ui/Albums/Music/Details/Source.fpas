// [Documentation](../../../../../doc/desktop.md#browsing-music-and-collections)

// File and acoustic fingerprint actions shared by all track detail tabs.
unit FpasAmp.Ui.Albums.Music.Details.Source;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as Buttons;
uses Fpas.Ui.Widgets.Actions.CopyButtons as Copy;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icons;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Display.Texts as Texts;

uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Ui.Albums.Music.Model as M;
uses FpasAmp.Ui.Fingerprints as Fp;
uses FpasAmp.Ui.Player.Model as Player;
uses System as Sys;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function Fingerprint(Current: M.State; Playback: Player.State; Item: Tracks.Entry): E.Element of M.Msg;
begin
  const Local: Fp.State? := Current.Fingerprint;
  const Playing: Fp.State? := Playback.Fingerprint;
  var Result: Fp.State? := Local;
  if (Local = null or Local.Value = null) and Fp.Matches(
    Playing,
    Item
  ) and Playing <> null and (Playing.Value <> null or Local = null or not Local.Busy)
  then
    Result := Playing;
  end if;

  if Result <> null then
    const Value: string? := Result.Value;
    if Value <> null then
      const Preview: string := if Value.Length > 40 then
        Value.Substring(0, 40) + '…'
      else
        Value
      end if;
      return E.Row of M.Msg(
        new L.Flow(Gap := Points(8), Align := L.Alignment.Center),
        E.Size of M.Msg(E.Styled of M.Msg(E.Text of M.Msg(Preview), S.Role.SingleLine), Fill),
        Copy.CopyButton of M.Msg('track-copy-fingerprint', Value)
      );
    end if;

    if Result.Busy then
      return E.Text of M.Msg('Checking fingerprint…');
    end if;
  end if;
  const Generate: E.Element of M.Msg := Buttons.Button of M.Msg(
    'track-generate-fingerprint',
    'Generate fingerprint',
    M.Msg.GenerateFingerprint,
    new Buttons.Options(Variant := S.ButtonVariant.Outline, ControlSize := Buttons.Size.Small)
  );
  const Status: string := if Result <> null then
    Result.Error ?? 'Not generated'
  else
    'Not generated'
  end if;
  return E.Row of M.Msg(
    new L.Flow(Gap := Points(8), Align := L.Alignment.Center),
    E.Size of M.Msg(Texts.Text of M.Msg(Status, Texts.Appearance.Secondary), Fill), Generate
  );
end function;

// Builds the source card for Item. Current and Playback supply pending or completed fingerprint work.
public function Build(Current: M.State; Playback: Player.State; Item: Tracks.Entry): E.Element of M.Msg;
requires Item.Path <> '';
begin
  const Row: L.Flow := new L.Flow(Gap := Points(6), Align := L.Alignment.Center);
  const Rule: E.Element of M.Msg := E.Size of M.Msg(
    E.Styled of M.Msg(E.Column of M.Msg(), S.Role.Divider),
    new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(1)))
  );
  return Cards.Card of M.Msg(
    'track-detail-source',
    [
      Texts.Text of M.Msg('File path', Texts.Appearance.Label),
      E.Row of M.Msg(
        Row,
        E.Size of M.Msg(E.Text of M.Msg(Item.Path), Fill),
        Icons.IconButton of M.Msg(
          'track-open-folder',
          Sys.Char.ConvertFromUtf32($E247),
          'Show in folder',
          M.Msg.ShowFolder(Item.Path)
        ),
        Copy.CopyButton of M.Msg('track-copy-path', Item.Path)
      ),
      Rule,
      Texts.Text of M.Msg('Acoustic fingerprint', Texts.Appearance.Label),
      Fingerprint(Current, Playback, Item)
    ],
    new Cards.Options(
      Width := L.Extent.Fill,
      Padding := 14.0F,
      Gap := 5.0F,
      Align := L.Alignment.Stretch
    )
  );
end function;

end unit;
