// [Documentation](../../../../../doc/desktop.md#browsing-music-and-collections)

// Shared track detail dialog for both the album and library song tables.
unit FpasAmp.Ui.Albums.Music.Details.View;

uses Fpas.Media.Images as Images;
uses Fpas.Media.Tags.AudioFiles as Tags;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Navigation.Tabs as Tabs;
uses Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs;

uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Ui.Albums.Artwork as Artwork;
uses FpasAmp.Ui.Albums.Music.Browse as Browse;
uses FpasAmp.Ui.Albums.Music.Details.Metadata as Metadata;
uses FpasAmp.Ui.Albums.Music.Details.Source as Source;
uses FpasAmp.Ui.Albums.Music.Model as M;
uses FpasAmp.Ui.Player.Model as Player;
uses System as Sys;
uses System.Collections.Generic as C;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
const Sections: array of Tabs.Item := [
  new Tabs.Item('Overview'),
  new Tabs.Item('Credits'),
  new Tabs.Item('Audio')
];

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

procedure Position(Parts: C.List of string; Label: string; Index: int?; Total: int?);
begin
  if Index > 0 then
    Parts.Add(
      Label + ' ' + (Index ?? 0).ToString() + if Total >= Index then
        ' of ' + (Total ?? 0).ToString()
      else
        ''
      end if
    );
  end if;
end procedure;

function Summary(
  Current: M.State;
  Item: Tracks.Entry;
  Info: Tags.Info;
  Cover: Images.Bitmap?;
  Compact: bool
): E.Element of M.Msg;
begin
  const Lines: C.List of E.Element of M.Msg := new C.List of E.Element of M.Msg();
  Lines.Add(Texts.Text of M.Msg(Browse.Title(Item), Texts.Appearance.HeadingThree));
  const Artist: string := Browse.Artist(Item);
  if Artist <> '' then
    Lines.Add(E.Styled of M.Msg(E.Text of M.Msg(Artist), S.Role.Introduction));
  end if;

  const Album: string := Browse.AlbumTitle(Item);
  const Identity: C.List of string := new C.List of string();
  if Album <> '' then
    Identity.Add(Album);
  elsif Current.Album.Id <> '' and Current.Album.Title <> '' then
    Identity.Add(Current.Album.Title);
  end if;

  if Info.ReleaseDate <> '' then
    Identity.Add(Metadata.Year(Info.ReleaseDate));
  end if;

  if Identity.Count > 0 then
    Lines.Add(Texts.Text of M.Msg(Sys.String.Join(' · ', Identity), Texts.Appearance.Secondary));
  end if;

  const Parts: C.List of string := new C.List of string();
  Position(Parts, 'Disc', Info.DiscNumber, Info.DiscTotal);
  Position(Parts, 'Track', Info.TrackNumber, Info.TrackTotal);
  const Duration: double := Browse.Duration(Item);
  if Duration > 0.0 then
    Parts.Add(Browse.Time(Duration));
  end if;

  if Parts.Count > 0 then
    Lines.Add(Texts.Text of M.Msg(Sys.String.Join(' · ', Parts), Texts.Appearance.Secondary));
  end if;

  return E.Row of M.Msg(
    new L.Flow(
      Gap := Points(
        if Compact then
          12
        else
          24
        end if
      ), Align := L.Alignment.Start
    ),
    Artwork.Build of M.Msg(
      'track-detail-cover', Cover, if Compact then
        72
      else
        144
      end if
    ),
    E.Size of M.Msg(
      E.Column of M.Msg(
        new L.Flow(Gap := Points(6), Align := L.Alignment.Stretch),
        Lines.ToArray()
      ),
      Fill
    )
  );
end function;

// Overlays the selected track's details on Base. Current owns the selected tab and file.
// Playback supplies ongoing analysis, Width is the available width, and Cover is the album image.
public function Build(
  Current: M.State;
  Playback: Player.State;
  Width: int;
  Cover: Images.Bitmap?;
  Base: E.Element of M.Msg
): E.Element of M.Msg;
begin
  const Item: Tracks.Entry? := Current.Details;
  const Compact: bool := Width < 585;
  var Body: E.Element of M.Msg := E.Column of M.Msg();
  if Item <> null then
    const Info: Tags.Info := Item.Metadata ?? new Tags.Info();
    Body := E.Column of M.Msg(
      new L.Flow(
        Gap := Points(
          if Compact then
            8
          else
            14
          end if
        ), Align := L.Alignment.Stretch
      ),
      Summary(Current, Item, Info, Cover, Compact),
      Tabs.Tabs of M.Msg(
        'track-detail-tabs', Sections, cast Current.ActiveDetailTab as int,
        function(Index: int): M.Msg => M.Msg.SelectDetailTab(cast Index as M.DetailTab)
      ),
      E.Size of M.Msg(
        Metadata.Panel(Current.ActiveDetailTab, Info, Compact), new L.Flex(
          Minimum := L.Measure.Logical(
            if Compact then
              64
            else
              98
            end if
          )
        )
      ),
      Source.Build(Current, Playback, Item)
    );
  end if;

  return Dialogs.Dialog of M.Msg(
    'track-details',
    Base,
    Body,
    Item <> null,
    new Dialogs.Options('Track details', Width := Sys.Math.Clamp(Width, 280, 820)),
    M.Msg.DismissDetails
  );
end function;

end unit;
