// Shared song browsing and playback selection for releases and the Music destination.
unit FpasAmp.Ui.Albums.Music.Model;

uses
  FpasAmp.Library.Albums.Model as Albums, FpasAmp.Library.Metadata.Model as Tracks,
  Fpas.Media.Images as Imaging, Fpas.Ui.Widgets.Collections.Tables as Tables, System as Sys, System.Collections.Immutable as I;

// Confirmed or draft track filters.
public type Filters = record
  // Selected genres. An empty set includes all genres.
  public Genres: I.ImmutableHashSet<string> := I.ImmutableHashSet<string>.Empty.WithComparer(
    Sys.StringComparer.OrdinalIgnoreCase
  );
  // Inclusive rating floor. Zero includes every rating.
  public MinimumRating: int := 0;
  // Individual performer credit, or empty for all.
  public Performer: string := '';
  // Stable release identity selected by the album filter, or empty for all.
  public ReleaseFilter: string := '';

  // Returns the number of selected genres plus the other active track filters.
  public function Count(): int;
  begin
    var Active: int := self.Genres.Count;
    if self.Performer <> '' then
      Active := Active + 1;
    end if;

    if self.ReleaseFilter <> '' then
      Active := Active + 1;
    end if;

    if self.MinimumRating > 0 then
      Active := Active + 1;
    end if;

    return Active;
  end function;
end record;

// Reproducible selection captured when playback starts, independent of later navigation.
public type Selection = record
  // Stable release ID, empty for the whole music library.
  public AlbumId: string := '';
  // Search terms for this source.
  public Search: string := '';
  // Applied genre names.
  public Genres: array of string := [];
  // Inclusive minimum user rating.
  public MinimumRating: int := 0;
  // Sort column, or -1 for source order.
  public Column: int := -1;
  // Reverse the selected column order.
  public Descending: bool := false;
  // Performer filter captured when the queue was built.
  public Performer: string := '';
  // Stable release identity selected by the album filter, or empty for all.
  public ReleaseFilter: string := '';
end record;

// A saved track rating protected from library reads that began before the write completed.
public type RatingReceipt = record
  // User rating, or null after clearing the stars.
  public Value: int?;
  // Monotonic Stopwatch timestamp taken after the durable write.
  public Written: long;
end record;

// The source tracks, confirmed selection and visible state of a song browser.
public type State = record
  // The selected album header. An empty ID selects the whole library.
  public Album: Albums.Album;
  // Identity of this visit, used to reject late background results.
  public Visit: long;
  // Tracks belonging to this page, in disc and track order.
  public Tracks: I.ImmutableArray<Tracks.Entry> := I.ImmutableArray<Tracks.Entry>.Empty;
  // Genre choices that distinguish tracks within the full release.
  public GenreChoices: array of string := [];
  // Filtered and sorted release tracks.
  public Shown: I.ImmutableArray<Tracks.Entry> := I.ImmutableArray<Tracks.Entry>.Empty;
  // Keyboard cursor in Shown, or -1 when unset.
  public Cursor: int := -1;
  // Range anchor in Shown, or -1 when unset.
  public Anchor: int := -1;
  // Whether the first query returned.
  public Loaded: bool := false;
  // Search text for this release.
  public Search: string := '';
  // Filters selecting the shown tracks.
  public Applied: Filters := new Filters();
  // Unconfirmed filters in the popup.
  public Draft: Filters := new Filters();
  // Whether the filter popup is open.
  public FiltersOpen: bool := false;
  // Grid sort; column -1 uses disc and track order.
  public Order: Tables.Sort := new Tables.Sort(-1);
  // Proposed ratings shown while the corresponding writes are in flight.
  public Saving: I.ImmutableDictionary<string, int?> := I.ImmutableDictionary<string, int?>.Empty;
  // Confirmed edits newer than the last track query, keyed by track identity.
  public Receipts: I.ImmutableDictionary<string, RatingReceipt> := I.ImmutableDictionary<string, RatingReceipt>.Empty;
  // Monotonic start of the last track query delivered to this visit.
  public ReadStarted: long := 0L;
  // Details dialog's track, when open.
  public Details: Tracks.Entry? := null;
  // Last read or action error.
  public Error: string? := null;
  // Genre fixed by navigation, or empty when browsing the whole release.
  public RequiredGenre: string := '';
  // Thumbnail for this visit, shared with the album grid when available.
  public Cover: Imaging.Bitmap? := null;
  // Sum of the shown durations, computed when the selection changes.
  public TotalMilliseconds: double := 0.0;
  // Individual performers offered in the whole-library filter.
  public Performers: array of string := [];
  // Display labels in catalogue order; duplicate titles include their artist.
  public ReleaseTitles: array of string := [];
  // Stable release keys corresponding to the display labels.
  public ReleaseIds: array of string := [];
end record;

// Proposals and scoped background completions for the album's songs.
public type Msg = variant
  // Return to the parent album grid.
  Back;
  // Tracks loaded for Visit, with the monotonic timestamp Started from before the query.
  Loaded(Visit: long; Started: long; Items: I.ImmutableArray<Tracks.Entry>);
  // Publishes the selected release's thumbnail for this visit.
  CoverLoaded(Visit: long; Image: Imaging.Bitmap?);
  // Reports a failure for a visit.
  Failed(Visit: long; Text: string);
  // Change search text.
  Search(Text: string);
  // Change the visibility of the filter controls.
  ShowFilters(Open: bool);
  // Replace the draft genre selection.
  Genres(Values: I.ImmutableHashSet<string>);
  // Set the draft rating floor.
  Minimum(Value: int);
  // Select a performer in the draft filters.
  Performer(Name: string);
  // Select a stable release identity in the draft filters.
  ReleaseFilter(Id: string);
  // Confirm the draft and close the popup.
  ApplyFilters;
  // Clear the draft filters.
  Reset;
  // Set the song sort order.
  Sort(Order: Tables.Sort);
  // Cursor and anchor proposed against the rows presented in the input frame.
  Navigate(Rows: I.ImmutableArray<Tracks.Entry>; Cursor: int; Anchor: int);
  // Propose a rating, with zero clearing it.
  Rate(Id: string; Value: int);
  // Confirm the rating for Id in Visit. Written timestamps completion of the durable write.
  Rated(Visit: long; Id: string; Value: int?; Written: long);
  // Release the saving indicator and show the failure.
  RatingFailed(Visit: long; Id: string; Text: string);
  // Toggle the current file or start FileId in the displayed queue.
  Play(FileId: long);
  // Show metadata for one track.
  Details(Item: Tracks.Entry);
  // Close track details.
  DismissDetails;
  // Open the containing folder of an indexed path.
  ShowFolder(Path: string);
end variant;

end unit;
