// [Documentation](../../../../doc/desktop.md#browsing-music-and-collections)

// Virtual release tracks with title and performer in the same cell.
unit FpasAmp.Ui.Albums.Music.TrackTable;

uses Fpas.Media.Images as Imaging;
uses Fpas.Media.Tags.AudioFiles as Tags;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as Buttons;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icons;
uses Fpas.Ui.Widgets.Collections.DataGrids as Grid;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Containers.EmptyStates as Empty;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Inputs.Ratings as Ratings;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;

uses FpasAmp.Library.Albums.Model as Albums;
uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Ui.Albums.Artwork as Artwork;
uses FpasAmp.Ui.Albums.Music.Browse as Browse;
uses FpasAmp.Ui.Albums.Music.Model as M;
uses FpasAmp.Ui.Albums.RatingStyle as RatingStyle;
uses FpasAmp.Ui.Navigation.Model as Nav;
uses FpasAmp.Ui.Player.Model as Player;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
// Persisted selection keys for the three sortable headers: title, time and rating.
const SortKeys: array of int := [0, 3, 4];
const LibraryKeys: array of int := [0, 1, 2, 5, 3, 4];

function Play(
  Item: Tracks.Entry;
  Id: string;
  Name: string;
  Playback: Player.State;
  Action: M.Msg
): E.Element of M.Msg;
begin
  const Track: Tracks.Entry? := Player.Track(Playback);
  const Active: bool := Track <> null and Track.FileId = Item.FileId;
  const Playing: bool := Active and Playback.Playing;
  return Icons.IconButton of M.Msg(
    'track-play-' + Id,
    Sys.Char.ConvertFromUtf32(
      if Playing then
        $E12E
      else
        $E13C
      end if
    ),
    (if Playing then
      'Pause '
    elsif Active then
      'Resume '
    else
      'Play '
    end if) + Name,
    Action, new Icons.Options(
      Variant := if Active then
        S.ButtonVariant.Primary
      else
        S.ButtonVariant.Ghost
      end if,
      ControlSize := Icons.Size.Small
    )
  );
end function;

function TimeCell(Item: Tracks.Entry): Grid.Cell of M.Msg;
begin
  return (Grid.Cell of M.Msg).Text(
    if Browse.Duration(Item) > 0.0 then
      Browse.Time(Browse.Duration(Item))
    else
      '—'
    end if
  );
end function;

function RatingCell(
  Current: M.State;
  Item: Tracks.Entry;
  Id: string;
  Name: string
): Grid.Cell of M.Msg;
begin
  return (Grid.Cell of M.Msg).Content(
    [
      Ratings.Rating of M.Msg(
        'track-rating-' + Id,
        'Rate ' + Name + ' (1–10)',
        Item.Rating ?? 0,
        function(Value: int): M.Msg => M.Msg.Rate(Item.TrackId, Value),
        Maximum := 10,
        Enabled := Item.TrackId <> '' and not Current.Saving.ContainsKey(Item.TrackId),
        StarSize := RatingStyle.StarSize
      )
    ]
  );
end function;

function MenuCell(Item: Tracks.Entry; Id: string; Name: string): Grid.Cell of M.Msg;
begin
  return (Grid.Cell of M.Msg).Content(
    [
      Menus.Menu of M.Msg(
        'track-menu-' + Id, 'More actions for ' + Name, [
          (Menus.Entry of M.Msg).Action(
            new Menus.Item of M.Msg('details', 'Track details', M.Msg.Details(Item))
          ),
          (Menus.Entry of M.Msg).Action(
            new Menus.Item of M.Msg(
              'edit-tags',
              'Edit tags',
              M.Msg.EditTags(Item),
              Enabled := Item.TrackId <> ''
            )
          ),
          (Menus.Entry of M.Msg).Action(
            new Menus.Item of M.Msg('folder', 'Show in folder', M.Msg.ShowFolder(Item.Path))
          )
        ], new Menus.Options(IconOnly := true, Position := Menus.Placement.BottomEnd)
      )
    ]
  );
end function;

function Song(Current: M.State; Index: int; Playback: Player.State): Grid.Row of M.Msg;
begin
  const Item: Tracks.Entry := Current.Shown[Index];
  const Id: string := Item.FileId.ToString();
  const Name: string := Browse.Title(Item);
  return new Grid.Row of M.Msg(
    Id, [
      (Grid.Cell of M.Msg).Content(
        [
          E.Row of M.Msg(
            new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(8)), Align := L.Alignment.Center),
            Play(Item, Id, Name, Playback, M.Msg.Play(Item.FileId)),
            E.Size of M.Msg(
              E.Column of M.Msg(
                new L.Flow(
                  Gap := L.Spacing.Fixed(L.Measure.Logical(2)),
                  Align := L.Alignment.Stretch
                ),
                E.Styled of M.Msg(
                  Texts.Text of M.Msg(Name, Texts.Appearance.Label),
                  S.Role.SingleLine
                ),
                E.Styled of M.Msg(
                  Texts.Text of M.Msg(Browse.Artist(Item), Texts.Appearance.Muted),
                  S.Role.SingleLine
                )
              ), Fill
            )
          )
        ]
      ),
      TimeCell(Item), RatingCell(Current, Item, Id, Name), MenuCell(Item, Id, Name)
    ]
  );
end function;

function Link(Id: string; Label: string; Route: Nav.Route): E.Element of M.Msg;
begin
  return Buttons.Button of M.Msg(
    Id, Label, M.Msg.Follow(Route),
    new Buttons.Options(
      Variant := S.ButtonVariant.Link,
      ControlSize := Buttons.Size.Small,
      Tooltip := Label
    )
  );
end function;

function TagsCell(Id: string; Names: array of string; Artist: bool): Grid.Cell of M.Msg;
begin
  const Items: C.List of E.Element of M.Msg := new C.List of E.Element of M.Msg();
  const Seen: C.HashSet of string := new C.HashSet of string();
  for Name: string in Names do
    const Key: string := Albums.TagKey(Name);
    if Key <> '' and Seen.Add(Key) then
      const Target: Nav.Route := if Artist then
        Nav.Route.Artist(Albums.ArtistId(Name))
      else
        Nav.Route.Genre(Albums.GenreId(Name))
      end if;
      Items.Add(Link(Id + '-' + Items.Count.ToString(), Name, Target));
    end if;
  end for;

  return (Grid.Cell of M.Msg).Content(
    [E.Row of M.Msg(new L.Flow(Align := L.Alignment.Center, Clip := true), Items.ToArray())]
  );
end function;

function LibrarySong(
  Current: M.State;
  Index: int;
  Covers: I.ImmutableDictionary of (string, Imaging.Bitmap?);
  Playback: Player.State;
  Playlist: bool
): Grid.Row of M.Msg;
begin
  const Item: Tracks.Entry := Current.Shown[Index];
  const Id: string := Item.FileId.ToString() + if Playlist then
    '-' + Index.ToString()
  else
    ''
  end if;
  const Action: M.Msg := if Playlist then
    M.Msg.PlaySlot(Current.Shown, Index)
  else
    M.Msg.Play(Item.FileId)
  end if;
  const Name: string := Browse.Title(Item);
  const Album: string := Browse.AlbumTitle(Item);
  const Credit: array of string := (Item.Metadata ?? new Tags.Info()).Artists;
  var Cover: Imaging.Bitmap? := null;
  discard Covers.TryGetValue(Item.AlbumId, out Cover);
  return new Grid.Row of M.Msg(
    Id, [
      (Grid.Cell of M.Msg).Content(
        [
          E.Row of M.Msg(
            new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(8)), Align := L.Alignment.Center),
            Play(Item, Id, Name, Playback, Action),
            Artwork.Build of M.Msg('track-cover-' + Id, Cover, 30),
            E.Size of M.Msg(
              E.Styled of M.Msg(
                Texts.Text of M.Msg(Name, Texts.Appearance.Label),
                S.Role.SingleLine
              ),
              Fill
            )
          )
        ]
      ),
      TagsCell('track-artist-' + Id, Credit, true),
      if Item.AlbumId <> '' and Album <> '' then
        (Grid.Cell of M.Msg).Content(
          [Link('track-album-' + Id, Album, Nav.Route.Album(Item.AlbumId))]
        )
      else
        (Grid.Cell of M.Msg).Text(Album)
      end if,
      TagsCell('track-genre-' + Id, Browse.Genres(Item), false),
      TimeCell(Item), RatingCell(Current, Item, Id, Name), MenuCell(Item, Id, Name)
    ]
  );
end function;

// Builds the virtual track table for `Current` using the available `Width` in logical points.
// Covers selects the whole-library layout and supplies realized album thumbnails.
// Playback identifies the current file and its transport state in either layout.
// Playlist gives repeated file rows distinct keys and activation slots.
// Returns the virtual table or the appropriate empty state.
public function Build(
  Current: M.State;
  Width: int;
  Playback: Player.State;
  Covers: I.ImmutableDictionary of (string, Imaging.Bitmap?)? := null;
  Playlist: bool := false
): E.Element of M.Msg;
requires Width > 0;
  function Activate(Index: int): M.Msg;
  begin
    return if Playlist then
      M.Msg.PlaySlot(Current.Shown, Index)
    else
      M.Msg.Play(Current.Shown[Index].FileId)
    end if;
  end function;
  function Change(Value: Grid.Value): M.Msg;
  begin
    const Order: Tables.Sort? := Value.Order;
    if Order = null or Order = Display then
      return M.Msg.Navigate(Current.Shown, Value.Cursor, Value.Anchor, Value.Scroll ?? 0.0F);
    end if;
    const Key: int := if Order.Column >= 0 and Order.Column < Keys.Length then
      Keys[Order.Column]
    else
      if Covers = null or Playlist then
        -1
      else
        0
      end if
    end if;
    return M.Msg.Sort(new Tables.Sort(Key, Order.Descending));
  end function;
begin
  if Current.Shown.Length = 0 then
    return Empty.EmptyState of M.Msg(
      'tracks-empty', if not Current.Loaded then
        'Loading tracks…'
      elsif Current.Error <> null and Current.Tracks.Length = 0 then
        'Tracks unavailable'
      elsif Current.Tracks.Length = 0 then
        if Covers = null then
          'No tracks in this album'
        else
          if Playlist then
            'No indexed tracks in this playlist'
          else
            'No music in your library'
          end if
        end if
      else
        'No matching tracks'
      end if
    );
  end if;

  const Keys: array of int := if Covers = null then
    SortKeys
  else
    LibraryKeys
  end if;
  const Display: Tables.Sort := new Tables.Sort(
    Sys.Array.IndexOf of int(Keys, Current.Order.Column),
    Current.Order.Descending
  );
  const Value: Grid.Value := new Grid.Value(
    Order := Display,
    Cursor := Current.Cursor,
    Anchor := Current.Anchor,
    Scroll := Current.Scroll
  );
  if Covers <> null then
    return Grid.DataGrid of M.Msg(
      'music-tracks',
      [
        new Grid.Column('Title', cast Sys.Math.Max(190, Width - 832) as float, Sortable := true),
        new Grid.Column('Artist', 178.0F, Sortable := true, Priority := 1),
        new Grid.Column('Album', 205.0F, Sortable := true, Priority := 2),
        new Grid.Column('Genre', 135.0F, Sortable := true, Priority := 5),
        new Grid.Column('Time', 80.0F, Sortable := true, Priority := 3),
        new Grid.Column('Rating', 190.0F, Sortable := true, Priority := 4),
        new Grid.Column('', 44.0F, Fixed := true)
      ],
      Current.Shown.Length,
      function(Index: int): Grid.Row of M.Msg => LibrarySong(
        Current,
        Index,
        Covers,
        Playback,
        Playlist
      ),
      Value,
      Change,
      new Grid.Options(
        RowHeight := 37.0F,
        HideCheckboxes := true
      ), Activate
    );
  end if;

  return Grid.DataGrid of M.Msg(
    'album-tracks',
    [
      new Grid.Column('Title', cast Sys.Math.Max(110, Width - 302) as float, Sortable := true),
      new Grid.Column(
        'Time',
        62.0F,
        Tables.Alignment.Right,
        Sortable := true,
        Fixed := true,
        Priority := 2
      ),
      new Grid.Column('Rating', 190.0F, Sortable := true, Fixed := true, Priority := 1),
      new Grid.Column('', 42.0F, Fixed := true)
    ],
    Current.Shown.Length,
    function(Index: int): Grid.Row of M.Msg => Song(Current, Index, Playback),
    Value, Change,
    new Grid.Options(RowHeight := 54.0F, HideCheckboxes := true), Activate
  );
end function;

end unit;
