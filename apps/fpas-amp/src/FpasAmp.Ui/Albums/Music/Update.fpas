// Load one release and apply song edits on the UI owner.
unit FpasAmp.Ui.Albums.Music.Update;

uses
  FpasAmp.Ui.Fingerprints as Fp, FpasAmp.Ui.Albums.Music.Model as M, FpasAmp.Ui.Albums.Music.Browse as Browse, FpasAmp.Ui.Albums.Music.Ratings as Ratings, FpasAmp.Ui.Albums.Artwork as Artwork,
  Fpas.Media.Images as Imaging, FpasAmp.Library.Metadata.Model as Tracks, FpasAmp.Library.Metadata.Monitoring as Metadata,
  Fpas.Ui.Widgets.Collections.Tables as Tables, Fpas.Ui.Mvu.Application as A, System as Sys, System.Collections.Immutable as I,
  Fpas.Ui.Gui.Desktop as Desktop, System.Diagnostics as D, System.IO as IO, System.Threading as T, System.Threading.Tasks as Tasks;

const Empty: array of A.Command<M.Msg> := [];

function Fingerprint(Current: M.State; Track: Tracks.Entry; Generate: bool; Library: Metadata.Session?): A.Transition<M.State, M.Msg>;
begin
  const Next: M.State := Current with
    Details := Track;
    Fingerprint := new Fp.State(
      Track, Library <> null, Error := if Library = null then
        'Library unavailable.'
      else
        null
      end if
    );
  end with;
  if Library = null then
    return new A.Transition<M.State, M.Msg>(Next, Empty);
  end if;

  return new A.Transition<M.State, M.Msg>(
    Next,
    [
      Fp.Read<M.Msg>(
        'detail-fingerprint',
        Library,
        Track,
        Generate,
        function(Value: Fp.State): M.Msg => M.Msg.FingerprintRead(Current.Visit, Value)
      )
    ]
  );
end function;

// Starts the selected release's query for `Current` through the borrowed `Library`.
// `LoadCover` requests the thumbnail when the grid has not already resolved it.
// Returns a transition whose visit key accompanies both results and errors.
public function Open(Current: M.State; Library: Metadata.Session?; LoadCover: bool := true): A.Transition<M.State, M.Msg>;
begin
  if Library = null then
    return new A.Transition<M.State, M.Msg>(
      Current with
        Loaded := true;
      end with, Empty
    );
  end if;

  return new A.Transition<M.State, M.Msg>(
    Current, [
      A.StartBackground<M.Msg>(
        'load',
        async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
          const Started: long := D.Stopwatch.GetTimestamp();
          const Items: I.ImmutableArray<Tracks.Entry> := await Library.Albums.TracksAsync(
            Current.Album.Id, Cancellation
          ).ConfigureAwait(false);
          await Post(M.Msg.Loaded(Current.Visit, Started, Items)).ConfigureAwait(false);
          if LoadCover then
            const Image: Imaging.Bitmap? := await Artwork.Load(
              Library.Albums,
              Current.Album,
              Cancellation
            ).ConfigureAwait(false);
            await Post(M.Msg.CoverLoaded(Current.Visit, Image)).ConfigureAwait(false);
          end if;
        end function,
        function(Error: Sys.Exception): M.Msg => M.Msg.Failed(Current.Visit, Error.Message)
      )
    ]
  );
end function;

function Rating(Current: M.State; Library: Metadata.Session?; Id: string; Value: int): A.Transition<M.State, M.Msg>;
begin
  if Library = null or Id = '' or Current.Saving.ContainsKey(Id) or Value < 0 or Value > 10 then
    return new A.Transition<M.State, M.Msg>(Current, Empty);
  end if;
  const Selected: int? := if Value = 0 then
    null
  else
    Value
  end if;
  return new A.Transition<M.State, M.Msg>(
    Browse.Select(
      Current with
        Saving := Current.Saving.Add(Id, Selected);
        Error := null;
      end with
    ), [
      A.StartBackground<M.Msg>(
        'rate/' + Id,
        async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
          await Library.SetRatingAsync(Id, Selected, Cancellation).ConfigureAwait(false);
          await Post(
            M.Msg.Rated(Current.Visit, Id, Selected, D.Stopwatch.GetTimestamp())
          ).ConfigureAwait(false);
        end function,
        function(Error: Sys.Exception): M.Msg => M.Msg.RatingFailed(
          Current.Visit,
          Id,
          Error.Message
        )
      )
    ]
  );
end function;

function OpenFolder(Current: M.State; Path: string): A.Transition<M.State, M.Msg>;
begin
  return new A.Transition<M.State, M.Msg>(
    Current, [
      A.StartBackground<M.Msg>(
        'folder',
        function(_Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
          Cancellation.ThrowIfCancellationRequested();
          const Folder: string? := IO.Path.GetDirectoryName(Path);
          if Folder = null or not IO.Directory.Exists(Folder) then
            raise new IO.DirectoryNotFoundException('The track folder is unavailable.');
          end if;

          if not Desktop.TryOpen(Folder) then
            raise new IO.IOException('The desktop could not open the track folder.');
          end if;

          return Tasks.Task.CompletedTask;
        end function,
        function(Error: Sys.Exception): M.Msg => M.Msg.Failed(Current.Visit, Error.Message)
      )
    ]
  );
end function;

// Applies `Message` to `Current`. `Library` saves ratings off the owner thread.
// Returns the next view and any commands to run.
public function Apply(Current: M.State; Message: M.Msg; Library: Metadata.Session?): A.Transition<M.State, M.Msg>;
begin
  var Next: M.State := Current;
  case Message of
    when M.Msg.Back, M.Msg.Play(_):
      return new A.Transition<M.State, M.Msg>(Current, Empty);
    when M.Msg.Loaded(
      const Visit: long,
      const Started: long,
      const Items: I.ImmutableArray<Tracks.Entry>
    ):
      if Visit = Current.Visit and Started >= Current.ReadStarted then
        const Scoped: I.ImmutableArray<Tracks.Entry> := if Current.RequiredGenre = '' then
          Items
        else
          Browse.Songs(Items, new M.Selection(Genres := [Current.RequiredGenre]))
        end if;
        Next := Browse.Select(
          Ratings.Receive(Current, Scoped, Started) with
            GenreChoices := if Current.RequiredGenre = '' then
              Browse.GenreChoices(Scoped)
            else
              Sys.Array.Empty<string>()
            end if;
            Loaded := true;
          end with
        );
      end if;
    when M.Msg.CoverLoaded(const Visit: long, const Image: Imaging.Bitmap?):
      if Visit = Current.Visit then
        Next := Current with
          Cover := Image;
        end with;
      end if;
    when M.Msg.Failed(const Visit: long, const Text: string):
      if Visit = Current.Visit then
        Next := Current with
          Loaded := true;
          Error := Text;
        end with;
      end if;
    when M.Msg.Search(const Text: string):
      Next := Browse.Select(
        Current with
          Search := Text;
        end with
      );
    when M.Msg.ShowFilters(const Value: bool):
      Next := Current with
        FiltersOpen := Value;
        Draft := Current.Applied;
      end with;
    when M.Msg.Genres(const Values: I.ImmutableHashSet<string>):
      Next := Current with
        Draft := Current.Draft with
          Genres := Values;
        end with;
      end with;
    when M.Msg.Performer(const Name: string):
      Next := Current with
        Draft := Current.Draft with
          Performer := Name;
        end with;
      end with;
    when M.Msg.ReleaseFilter(const Id: string):
      Next := Current with
        Draft := Current.Draft with
          ReleaseFilter := Id;
        end with;
      end with;
    when M.Msg.Minimum(const Value: int):
      Next := Current with
        Draft := Current.Draft with
          MinimumRating := Sys.Math.Clamp(Value, 0, 10);
        end with;
      end with;
    when M.Msg.ApplyFilters:
      Next := Browse.Select(
        Current with
          Applied := Current.Draft;
          FiltersOpen := false;
        end with
      );
    when M.Msg.Reset:
      Next := Current with
        Draft := new M.Filters();
      end with;
    when M.Msg.Navigate(
      const Rows: I.ImmutableArray<Tracks.Entry>,
      const Cursor: int,
      const Anchor: int
    ):
      Next := Current with
        Cursor := Browse.RowIndex(Rows, Cursor, Current.Shown);
        Anchor := Browse.RowIndex(Rows, Anchor, Current.Shown);
      end with;
    when M.Msg.Sort(const Order: Tables.Sort):
      if Order = Current.Order then
        return new A.Transition<M.State, M.Msg>(Current, Empty);
      end if;

      Next := Browse.Select(
        Current with
          Order := Order;
        end with
      );
    when M.Msg.Rate(const Id: string, const Value: int):
      return Rating(Current, Library, Id, Value);
    when M.Msg.Rated(const Visit: long, const Id: string, const Value: int?, const Written: long):
      if Visit = Current.Visit and Current.Saving.ContainsKey(Id) then
        Next := Ratings.Confirm(Current, Id, new M.RatingReceipt(Value, Written));
        if Current.ReadStarted > Written then
          Next := Browse.Select(Next);
        end if;
      end if;
    when M.Msg.RatingFailed(const Visit: long, const Id: string, const Text: string):
      if Visit = Current.Visit and Current.Saving.ContainsKey(Id) then
        Next := Browse.Select(
          Current with
            Saving := Current.Saving.Remove(Id);
            Error := Text;
          end with
        );
      end if;
    when M.Msg.Details(const Item: Tracks.Entry):
      return Fingerprint(
        Current with
          ActiveDetailTab := M.DetailTab.Overview;
        end with, Item, false, Library
      );
    when M.Msg.SelectDetailTab(const Tab: M.DetailTab):
      if Current.Details <> null then
        Next := Current with
          ActiveDetailTab := Tab;
        end with;
      end if;
    when M.Msg.GenerateFingerprint:
      const Track: Tracks.Entry? := Current.Details;
      if Track <> null then
        return Fingerprint(Current, Track, true, Library);
      end if;
    when M.Msg.FingerprintRead(const Visit: long, const Result: Fp.State):
      const Previous: Fp.State? := Current.Fingerprint;
      if Visit = Current.Visit and Fp.Matches(
        Result,
        Current.Details
      ) and (Previous = null or Previous.Value = null or Result.Value <> null)
      then
        Next := Current with
          Fingerprint := Result;
        end with;
      end if;
    when M.Msg.DismissDetails:
      return new A.Transition<M.State, M.Msg>(
        Current with
          Details := null;
          Fingerprint := null;
        end with, [A.CancelBackground<M.Msg>('detail-fingerprint')]
      );
    when M.Msg.ShowFolder(const Path: string):
      return OpenFolder(Current, Path);
  end case;

  return new A.Transition<M.State, M.Msg>(Next, Empty);
end function;

end unit;
