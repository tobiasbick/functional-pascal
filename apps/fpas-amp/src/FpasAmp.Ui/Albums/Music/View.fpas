// Native music table, toolbars and details for a selected album.
unit FpasAmp.Ui.Albums.Music.View;

uses
  FpasAmp.Ui.Albums.Music.Model as M, FpasAmp.Ui.Albums.Music.Browse as Browse,
  FpasAmp.Ui.Albums.Music.Details.View as Dialog, FpasAmp.Ui.Player.Model as Player,
  FpasAmp.Ui.Albums.Music.Filters as Filters, FpasAmp.Ui.Albums.Toolbar.View as LibraryToolbar,
  FpasAmp.Ui.Albums.Toolbar.Sorting as LibrarySorting,
  FpasAmp.Ui.Albums.Status as Status, FpasAmp.Ui.Albums.Artwork as Artwork, FpasAmp.Ui.Albums.Music.TrackTable as TrackTable,
  FpasAmp.Library.Metadata.Model as Tracks, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S,
  Fpas.Ui.Widgets.Collections.Tables as Tables,
  Fpas.Ui.Widgets.Inputs.SearchFields as Search,
  Fpas.Ui.Widgets.Overlays.Menus as Menus,
  Fpas.Ui.Widgets.Actions.IconButtons as Icons, Fpas.Ui.Widgets.Display.Texts as Texts,
  Fpas.Ui.Widgets.Feedback.Alerts as Alerts,
  Fpas.Media.Images as Imaging, System.Collections.Immutable as I, System as Sys, System.Collections.Generic as C;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function Sort(Current: M.State): E.Element<M.Msg>;
begin
  const Whole: bool := Current.Album.Id = '';
  const Names: array of string := if Whole then
    ['Title', 'Artist', 'Album', 'Time', 'Rating', 'Genre']
  else
    ['Title', 'Artist', 'Album', 'Time', 'Rating']
  end if;
  const Entries: C.List<Menus.Entry<M.Msg>> := new C.List<Menus.Entry<M.Msg>>(
    [
      Menus.Entry<M.Msg>.Label('Sort by')
    ]
  );
  if not Whole then
    Entries.Add(
      Menus.Entry<M.Msg>.Action(
        new Menus.Item<M.Msg>(
          'release',
          'Disc and track',
          M.Msg.Sort(new Tables.Sort(-1)),
          Checked := Current.Order.Column = -1
        )
      )
    );
  end if;

  for Index: int := 0 to Names.Length - 1 do
    Entries.Add(
      Menus.Entry<M.Msg>.Action(
        new Menus.Item<M.Msg>(
          Index.ToString(),
          Names[Index],
          M.Msg.Sort(new Tables.Sort(Index, Current.Order.Descending)),
          Checked := Current.Order.Column = Index
        )
      )
    );
  end for;

  const Column: int := Current.Order.Column;
  var Label: string := 'Disc and track';
  if Column >= 0 then
    const Direction: string := if Column <= 2 or Column = 5 then
      if Current.Order.Descending then
        'Z–A'
      else
        'A–Z'
      end if
    else
      if Current.Order.Descending then
        'High–low'
      else
        'Low–high'
      end if
    end if;
    Label := Names[Column] + ' · ' + Direction;
    Entries.Add(Menus.Entry<M.Msg>.Separator);
    Entries.Add(
      Menus.Entry<M.Msg>.Action(
        new Menus.Item<M.Msg>(
          'ascending', 'Ascending', M.Msg.Sort(new Tables.Sort(Column)),
          Checked := not Current.Order.Descending
        )
      )
    );
    Entries.Add(
      Menus.Entry<M.Msg>.Action(
        new Menus.Item<M.Msg>(
          'descending', 'Descending', M.Msg.Sort(new Tables.Sort(Column, true)),
          Checked := Current.Order.Descending
        )
      )
    );
  end if;

  return LibrarySorting.Trigger<M.Msg>(
    'track-sort', Label, Entries.ToArray(), Current.Order.Descending
  );
end function;

function Fixed(Value: int): L.Flex;
begin
  return new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(Value)));
end function;

// Builds the whole-library Music page for Current and its viewport-owned Covers.
// Width and Padding are the available content width and inset in logical points.
// Playback supplies the current song and transport state.
// Returns the toolbar, virtual table, status bar and track-details overlay.
public function LibraryPage(Current: M.State; Width: int; Padding: int; Covers: I.ImmutableDictionary<string, Imaging.Bitmap?>; Playback: Player.State): E.Element<M.Msg>;
begin
  const Inner: int := Sys.Math.Max(1, Width - 2 * Padding);
  const Parts: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>(
    [
      Texts.Text<M.Msg>('Music', Texts.Appearance.HeadingOne),
      LibraryToolbar.Arrange<M.Msg>(
        Search.SearchField<M.Msg>(
          'track-search', Current.Search, M.Msg.Search,
          new Search.Options(Placeholder := 'Search titles, artists and albums…')
        ), Filters.Build(Current, Inner), Sort(Current), Inner
      )
    ]
  );
  const Error: string? := Current.Error;
  if Error <> null then
    Parts.Add(
      Alerts.Alert<M.Msg>(
        'track-error',
        'Track operation failed',
        new Alerts.Options(Tone := S.Tone.Warning, Description := Error)
      )
    );
  end if;

  Parts.Add(E.Size<M.Msg>(TrackTable.Build(Current, Inner, Playback, Covers), Fill));
  var Cover: Imaging.Bitmap? := null;
  const Item: Tracks.Entry? := Current.Details;
  if Item <> null then
    discard Covers.TryGetValue(Item.AlbumId, out Cover);
  end if;

  return Dialog.Build(
    Current, Playback, Width, Cover, E.Column<M.Msg>(
      new L.Flow(Align := L.Alignment.Stretch),
      E.Size<M.Msg>(
        E.Column<M.Msg>(
          new L.Flow(Padding := Points(Padding), Gap := Points(16), Align := L.Alignment.Stretch),
          Parts.ToArray()
        ),
        Fill
      ),
      Status.Tracks(Current, Current.Tracks.Length)
    )
  );
end function;

// Builds the selected album page with a return to its retained grid.
// ## Parameters
// - `Current`: Release metadata, tracks and browse state.
// - `LibraryTrackCount`: Total indexed tracks across all releases and sources.
// - `GroupName`: Parent heading when reached through Artists or Genres.
// - `Width`: Full width of the Albums content area in logical points.
// - `Playback`: Player state for the current track's button.
// ## Returns
// The album sleeve beside the searchable track list and its status bar.
public function Build(Current: M.State; Width: int; GroupName: string; Playback: Player.State; LibraryTrackCount: long): E.Element<M.Msg>;
requires Width > 0;
begin
  const Narrow: bool := Width < 700;
  const Inset: int := if Narrow then
    16
  else
    28
  end if;
  const Gutter: int := if Narrow then
    12
  else
    20
  end if;
  const Edge: int := Sys.Math.Clamp((Width - 480) div 2, 72, 174);
  const TrackWidth: int := Sys.Math.Max(1, Width - 2 * (Inset + Gutter) - Edge - 1);
  const Heading: E.Element<M.Msg> := E.Row<M.Msg>(
    new L.Flow(
      PaddingStart := Points(Inset), PaddingTop := Points(Inset), PaddingBottom := Points(Inset),
      Gap := Points(6), Align := L.Alignment.Center
    ),
    Icons.IconButton<M.Msg>(
      'tracks-back',
      Sys.Char.ConvertFromUtf32($E048),
      'Back to albums',
      M.Msg.Back
    ),
    Texts.Text<M.Msg>(
      if GroupName = '' then
        'Albums'
      else
        GroupName
      end if, Texts.Appearance.HeadingThree
    )
  );
  const Sleeve: E.Element<M.Msg> := E.Column<M.Msg>(
    new L.Flow(
      PaddingStart := Points(Inset), PaddingTop := Points(Inset), PaddingEnd := Points(Gutter),
      Gap := Points(12), Align := L.Alignment.Stretch
    ),
    Artwork.Build<M.Msg>('track-album-cover', Current.Cover, Edge),
    E.Column<M.Msg>(
      new L.Flow(Gap := Points(4), Align := L.Alignment.Stretch),
      Texts.Text<M.Msg>(
        Current.Album.Title, if Narrow then
          Texts.Appearance.HeadingFour
        else
          Texts.Appearance.HeadingTwo
        end if
      ),
      Texts.Text<M.Msg>(Current.Album.Artist, Texts.Appearance.Secondary)
    )
  );
  const Field: E.Element<M.Msg> := Search.SearchField<M.Msg>(
    'track-search',
    Current.Search,
    M.Msg.Search,
    new Search.Options(Placeholder := 'Search titles and genres…')
  );
  const Parts: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>(
    [
      LibraryToolbar.Arrange<M.Msg>(
        Field,
        Filters.Build(Current, TrackWidth),
        Sort(Current),
        TrackWidth
      )
    ]
  );
  const Error: string? := Current.Error;
  if Error <> null then
    Parts.Add(
      Alerts.Alert<M.Msg>(
        'track-error', 'Track operation failed',
        new Alerts.Options(Tone := S.Tone.Warning, Description := Error)
      )
    );
  end if;

  Parts.Add(E.Size<M.Msg>(TrackTable.Build(Current, TrackWidth, Playback), Fill));
  const Songs: E.Element<M.Msg> := E.Column<M.Msg>(
    new L.Flow(
      PaddingStart := Points(Gutter),
      PaddingEnd := Points(Inset), PaddingTop := Points(Inset), PaddingBottom := Points(Inset),
      Gap := Points(16), Align := L.Alignment.Stretch
    ), Parts.ToArray()
  );
  const Stretch: L.Flow := new L.Flow(Align := L.Alignment.Stretch);
  const Rule: E.Element<M.Msg> := E.Size<M.Msg>(
    E.Styled<M.Msg>(E.Column<M.Msg>(), S.Role.Divider),
    Fixed(1)
  );
  const Columns: E.Element<M.Msg> := E.Row<M.Msg>(
    Stretch,
    E.Size<M.Msg>(Sleeve, Fixed(Inset + Edge + Gutter)), Rule,
    E.Size<M.Msg>(
      E.Column<M.Msg>(
        Stretch,
        E.Size<M.Msg>(Songs, Fill),
        Status.Tracks(Current, LibraryTrackCount)
      ),
      Fill
    )
  );
  return Dialog.Build(
    Current, Playback, Width, Current.Cover,
    E.Column<M.Msg>(Stretch, Heading, Rule, E.Size<M.Msg>(Columns, Fill))
  );
end function;

end unit;
