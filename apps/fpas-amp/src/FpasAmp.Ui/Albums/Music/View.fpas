// [Documentation](../../../../doc/desktop.md#browsing-music-and-collections)

// Native music table, toolbars and details for a selected album.
unit FpasAmp.Ui.Albums.Music.View;

uses Fpas.Media.Images as Imaging;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icons;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Feedback.Alerts as Alerts;
uses Fpas.Ui.Widgets.Inputs.SearchFields as Search;

uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Ui.Albums.Artwork as Artwork;
uses FpasAmp.Ui.Albums.Music.Browse as Browse;
uses FpasAmp.Ui.Albums.Music.Details.View as Dialog;
uses FpasAmp.Ui.Albums.Music.Filters as Filters;
uses FpasAmp.Ui.Albums.Music.Model as M;
uses FpasAmp.Ui.Albums.Music.TrackTable as TrackTable;
uses FpasAmp.Ui.Albums.Status as Status;
uses FpasAmp.Ui.Albums.Toolbar.View as LibraryToolbar;
uses FpasAmp.Ui.Collections.TableSort as TableSort;
uses FpasAmp.Ui.Player.Model as Player;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function Sort(Current: M.State; Playlist: bool := false): E.Element of M.Msg;
begin
  const Whole: bool := Current.Album.Id = '';
  const Names: array of string := if Whole then
    ['Title', 'Artist', 'Album', 'Time', 'Rating', 'Genre']
  else
    ['Title', 'Artist', 'Album', 'Time', 'Rating']
  end if;
  const Alphabetical: array of bool := if Whole then
    [true, true, true, false, false, true]
  else
    [true, true, true, false, false]
  end if;
  const Default: string := if Playlist then
    'Playlist order'
  elsif not Whole then
    'Disc and track'
  else
    ''
  end if;
  return TableSort.Build of M.Msg(
    'track-sort',
    Names,
    Alphabetical,
    Current.Order,
    M.Msg.Sort,
    Default,
    'release'
  );
end function;

function Fixed(Value: int): L.Flex;
begin
  return new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(Value)));
end function;

// Builds the whole-library Music page for Current and its viewport-owned Covers.
// Width and Padding are the available content width and inset in logical points.
// Playback supplies the current song and transport state.
// PlaylistName and PlaylistCount specify the displayed playlist when present.
// PlaylistError is the last parse failure from the playlist source.
// Returns the toolbar, virtual table, status bar and track-details overlay.
public function LibraryPage(
  Current: M.State;
  Width: int;
  Padding: int;
  Covers: I.ImmutableDictionary of (string, Imaging.Bitmap?);
  Playback: Player.State;
  PlaylistName: string? := null;
  PlaylistCount: long? := null;
  PlaylistError: string? := null
): E.Element of M.Msg;
begin
  const Inner: int := Sys.Math.Max(1, Width - 2 * Padding);
  const Parts: C.List of E.Element of M.Msg := new C.List of E.Element of M.Msg(
    [
      Texts.Text of M.Msg(PlaylistName ?? 'Music', Texts.Appearance.HeadingOne),
      LibraryToolbar.Arrange of M.Msg(
        Search.SearchField of M.Msg(
          'track-search', Current.Search, M.Msg.Search,
          new Search.Options(Placeholder := 'Search titles, artists and albums…')
        ), Filters.Build(Current, Inner), Sort(Current, PlaylistName <> null), Inner
      )
    ]
  );
  if PlaylistError <> null then
    Parts.Add(
      Alerts.Alert of M.Msg(
        'navigation-error', 'Playlist unavailable',
        new Alerts.Options(Tone := S.Tone.Warning, Description := PlaylistError)
      )
    );
  end if;
  const Error: string? := Current.Error;
  if Error <> null then
    Parts.Add(
      Alerts.Alert of M.Msg(
        'track-error',
        'Track operation failed',
        new Alerts.Options(Tone := S.Tone.Warning, Description := Error)
      )
    );
  end if;

  Parts.Add(
    E.Size of M.Msg(TrackTable.Build(Current, Inner, Playback, Covers, PlaylistName <> null), Fill)
  );
  var Cover: Imaging.Bitmap? := null;
  const Item: Tracks.Entry? := Current.Details;
  if Item <> null then
    discard Covers.TryGetValue(Item.AlbumId, out Cover);
  end if;

  return Dialog.Build(
    Current, Playback, Width, Cover, E.Column of M.Msg(
      new L.Flow(Align := L.Alignment.Stretch),
      E.Size of M.Msg(
        E.Column of M.Msg(
          new L.Flow(Padding := Points(Padding), Gap := Points(16), Align := L.Alignment.Stretch),
          Parts.ToArray()
        ),
        Fill
      ),
      Status.Tracks(Current, PlaylistCount ?? cast Current.Tracks.Length as long)
    )
  );
end function;

// Builds the selected album page with a return to its retained grid.
// ## Parameters
// - `Current`: Release metadata, tracks and browse state.
// - `LibraryTrackCount`: Total indexed tracks across all releases and sources.
// - `GroupName`: Parent heading when reached through Artists or Genres.
// - `Width`: Full width of the Albums content area in logical points.
// - `Playback`: Player state for the current track's button.
// ## Returns
// The album sleeve beside the searchable track list and its status bar.
public function Build(
  Current: M.State;
  Width: int;
  GroupName: string;
  Playback: Player.State;
  LibraryTrackCount: long;
  BackLabel: string := ''
): E.Element of M.Msg;
requires Width > 0;
begin
  const Narrow: bool := Width < 700;
  const Inset: int := if Narrow then
    16
  else
    28
  end if;
  const Gutter: int := if Narrow then
    12
  else
    20
  end if;
  const Edge: int := Sys.Math.Clamp((Width - 480) div 2, 72, 174);
  const TrackWidth: int := Sys.Math.Max(1, Width - 2 * (Inset + Gutter) - Edge - 1);
  const Heading: E.Element of M.Msg := E.Row of M.Msg(
    new L.Flow(
      PaddingStart := Points(Inset), PaddingTop := Points(Inset), PaddingBottom := Points(Inset),
      Gap := Points(6), Align := L.Alignment.Center
    ),
    Icons.IconButton of M.Msg(
      'tracks-back',
      Sys.Char.ConvertFromUtf32($E048),
      if BackLabel <> '' then
        BackLabel
      else
        'Back to albums'
      end if,
      M.Msg.Back
    ),
    Texts.Text of M.Msg(
      if GroupName = '' then
        'Albums'
      else
        GroupName
      end if, Texts.Appearance.HeadingThree
    )
  );
  const Sleeve: E.Element of M.Msg := E.Column of M.Msg(
    new L.Flow(
      PaddingStart := Points(Inset), PaddingTop := Points(Inset), PaddingEnd := Points(Gutter),
      Gap := Points(12), Align := L.Alignment.Stretch
    ),
    Artwork.Build of M.Msg('track-album-cover', Current.Cover, Edge),
    E.Column of M.Msg(
      new L.Flow(Gap := Points(4), Align := L.Alignment.Stretch),
      Texts.Text of M.Msg(
        Current.Album.Title, if Narrow then
          Texts.Appearance.HeadingFour
        else
          Texts.Appearance.HeadingTwo
        end if
      ),
      Texts.Text of M.Msg(Current.Album.Artist, Texts.Appearance.Secondary)
    )
  );
  const Field: E.Element of M.Msg := Search.SearchField of M.Msg(
    'track-search',
    Current.Search,
    M.Msg.Search,
    new Search.Options(Placeholder := 'Search titles and genres…')
  );
  const Parts: C.List of E.Element of M.Msg := new C.List of E.Element of M.Msg(
    [
      LibraryToolbar.Arrange of M.Msg(
        Field,
        Filters.Build(Current, TrackWidth),
        Sort(Current),
        TrackWidth
      )
    ]
  );
  const Error: string? := Current.Error;
  if Error <> null then
    Parts.Add(
      Alerts.Alert of M.Msg(
        'track-error', 'Track operation failed',
        new Alerts.Options(Tone := S.Tone.Warning, Description := Error)
      )
    );
  end if;

  Parts.Add(E.Size of M.Msg(TrackTable.Build(Current, TrackWidth, Playback), Fill));
  const Songs: E.Element of M.Msg := E.Column of M.Msg(
    new L.Flow(
      PaddingStart := Points(Gutter),
      PaddingEnd := Points(Inset), PaddingTop := Points(Inset), PaddingBottom := Points(Inset),
      Gap := Points(16), Align := L.Alignment.Stretch
    ), Parts.ToArray()
  );
  const Stretch: L.Flow := new L.Flow(Align := L.Alignment.Stretch);
  const Rule: E.Element of M.Msg := E.Size of M.Msg(
    E.Styled of M.Msg(E.Column of M.Msg(), S.Role.Divider),
    Fixed(1)
  );
  const Columns: E.Element of M.Msg := E.Row of M.Msg(
    Stretch,
    E.Size of M.Msg(Sleeve, Fixed(Inset + Edge + Gutter)), Rule,
    E.Size of M.Msg(
      E.Column of M.Msg(
        Stretch,
        E.Size of M.Msg(Songs, Fill),
        Status.Tracks(Current, LibraryTrackCount)
      ),
      Fill
    )
  );
  return Dialog.Build(
    Current, Playback, Width, Current.Cover,
    E.Column of M.Msg(Stretch, Heading, Rule, E.Size of M.Msg(Columns, Fill))
  );
end function;

end unit;
