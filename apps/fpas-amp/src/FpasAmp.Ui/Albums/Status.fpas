// A native CUI status bar sits outside the scrolling album viewport.
unit FpasAmp.Ui.Albums.Status;

uses
  FpasAmp.Ui.Albums.Model as M, FpasAmp.Ui.Albums.Toolbar.Model as Toolbar, Fpas.Ui.Elements as E,
  Fpas.Ui.Widgets.Desktop.StatusBars as Status;

// Formats `Shown` album matches and optional unfiltered `Total` for the status bar.
// `Noun` is the singular name of the collection item. Without filtering, only the overall album count is shown.
public function Caption(Shown: int; Total: int? := null; Noun: string := 'album'): string;
requires Shown >= 0;
requires Total = null or Total >= Shown;
begin
  if Total <> null and Total <> Shown then
    return Shown.ToString() + ' of ' + Total.ToString() + ' ' + Noun + 's';
  end if;

  return Shown.ToString() + if Shown = 1 then
    ' ' + Noun
  else
    ' ' + Noun + 's'
  end if;
end function;

// Presents the shown album count in `Current`, and the total while search or
// filters hide albums. Loading and initial failures remain distinguishable from
// an empty catalogue.
public function Build(Current: M.State): E.Element<M.Msg>;
begin
  const Noun: string := Toolbar.ItemName(Current.Scope).ToLowerInvariant();
  const Text: string := if not Current.Loaded then
    'Loading ' + Noun + 's…'
  elsif Current.Error <> null and Current.Items.Length = 0 then
    'Library unavailable'
  else
    Caption(Current.Shown.Length, Current.Items.Length, Noun)
  end if;
  return Status.StatusBar<M.Msg>('album-status', [Status.Item<M.Msg>.Text(new Status.Label(Text))]);
end function;

end unit;
