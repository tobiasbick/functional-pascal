// [Documentation](../../../../doc/desktop.md#browsing-music-and-collections)

// Artist, genre and rating filters, composed entirely from native CUI widgets.
unit FpasAmp.Ui.Albums.Toolbar.Filters;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Inputs.Checkboxes as Checks;
uses Fpas.Ui.Widgets.Inputs.Selects as Selects;
uses Fpas.Ui.Widgets.Inputs.Sliders as Sliders;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;
uses Fpas.Ui.Widgets.Overlays.Popovers as Popovers;

uses FpasAmp.Ui.Albums.Toolbar.Model as M;
uses System as Sys;
uses System.Collections.Generic as C;

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

// Builds a select with an "All" entry first, followed by `Values`; `Chosen` is
// the selected value, or empty for all. Optional Captions label stable keys in Values.
// Id identifies the native control, Label titles the field and All names the empty choice.
// Change maps a selection to its TMsg message.
public function Choice of TMsg(
  Id: string;
  Label: string;
  All: string;
  Values: array of string;
  Chosen: string;
  Change: function(string): TMsg;
  Captions: (array of string)? := null
): E.Element of TMsg;
requires Captions = null or Captions.Length = Values.Length;
begin
  const Items: C.List of Selects.Item := new C.List of Selects.Item([new Selects.Item(All)]);
  var Selected: int := 0;
  for Index: int := 0 to Values.Length - 1 do
    Items.Add(
      new Selects.Item(
        if Captions = null then
          Values[Index]
        else
          Captions[Index]
        end if
      )
    );
    if Sys.String.Equals(Values[Index], Chosen, Sys.StringComparison.OrdinalIgnoreCase) then
      Selected := Index + 1;
    end if;
  end for;

  return Selects.Select of TMsg(
    Id, Items.ToArray(), Selected,
    function(Index: int): TMsg => Change(
      if Index <= 0 or Index > Values.Length then
        ''
      else
        Values[Index - 1]
      end if
    ),
    new Selects.Options(Label := Label, Searchable := Values.Length > 8)
  );
end function;

// Builds a filter form from the supplied fields and confirmation messages.
// ## Type parameters
// - `TMsg`: The page's message type.
// ## Parameters
// - `Id`: Prefix for the form controls.
// - `Title`: The heading.
// - `Fields`: The draft controls.
// - `Reset`: Clears the draft.
// - `Apply`: Confirms the draft.
// ## Returns
// The native form for the filter popup.
public function Panel of TMsg(
  Id: string;
  Title: string;
  Fields: array of E.Element of TMsg;
  Reset: TMsg;
  Apply: TMsg
): E.Element of TMsg;
begin
  const Parts: C.List of E.Element of TMsg := new C.List of E.Element of TMsg();
  Parts.Add(Texts.Text of TMsg(Title, Texts.Appearance.HeadingThree));
  Parts.AddRange(Fields);
  Parts.Add(
    E.Size of TMsg(
      E.Styled of TMsg(E.Column of TMsg(), S.Role.Divider),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(1)))
    )
  );
  Parts.Add(
    E.Row of TMsg(
      new L.Flow(Gap := Points(8), Justify := L.Justification.End),
      B.Button of TMsg(
        Id + '-filter-reset',
        'Reset',
        Reset,
        new B.Options(Variant := S.ButtonVariant.Outline)
      ),
      B.Button of TMsg(
        Id + '-filter-apply',
        'Apply',
        Apply,
        new B.Options(Variant := S.ButtonVariant.Primary)
      )
    )
  );
  return E.Column of TMsg(
    new L.Flow(Gap := Points(14), Align := L.Alignment.Stretch, Clip := false), Parts.ToArray()
  );
end function;

// Builds the shared library filter form.
// ## Type parameters
// - `TMsg`: The page's message type.
// ## Parameters
// - `Id`: Prefix for the form's controls.
// - `Title`: The form heading.
// - `Fields`: Choice controls above the rating slider.
// - `Rating`: Draft minimum rating from zero to ten, or -1 for unrated items.
// - `Change`: Maps a rating proposal to a message.
// - `Reset`: Message to clear the draft.
// - `RatingLabel`: Identifies the entity being rated.
// - `Apply`: Message to confirm the draft.
// ## Returns
// The title, choice controls, rating slider and form buttons.
public function Form of TMsg(
  Id: string;
  Title: string;
  Fields: array of E.Element of TMsg;
  Rating: int;
  Change: function(int): TMsg;
  Reset: TMsg;
  Apply: TMsg;
  RatingLabel: string := 'Minimum rating'
): E.Element of TMsg;
begin
  const Parts: C.List of E.Element of TMsg := new C.List of E.Element of TMsg(Fields);
  const Unrated: bool := Rating = -1;
  Parts.Add(
    E.Row of TMsg(
      new L.Flow(Gap := Points(12), Align := L.Alignment.Start),
      E.Size of TMsg(
        Sliders.Slider of TMsg(
          Id + '-filter-rating',
          RatingLabel,
          cast Sys.Math.Max(0, Rating) as float,
          0.0F,
          10.0F,
          function(Value: float): TMsg => Change(cast Sys.Math.Round(Value) as int),
          new Sliders.Options(Step := 1.0F, Enabled := not Unrated)
        ), new L.Flex(Basis := L.Extent.Fill)
      ),
      Texts.Text of TMsg(
        if Unrated then
          '—'
        elsif Rating = 0 then
          'Any'
        else
          Rating.ToString() + ' / 10'
        end if, Texts.Appearance.Secondary
      )
    )
  );
  Parts.Add(
    Checks.Checkbox of TMsg(
      Id + '-filter-unrated', 'Unrated only', Unrated,
      function(Value: bool): TMsg => Change(
        if Value then
          -1
        else
          0
        end if
      )
    )
  );
  return Panel of TMsg(Id, Title, Parts.ToArray(), Reset, Apply);
end function;

// Builds the shared filter button and its anchored form.
// ## Type parameters
// - `TMsg`: The page's message type.
// ## Parameters
// - `Id`: Prefix for the button and popup identities.
// - `Panel`: The form inside the popup.
// - `Count`: Number of applied filters.
// - `Open`: Whether the form is visible.
// - `Toggle`: Maps the requested visibility to a message.
// - `Width`: Maximum width in logical points.
// ## Returns
// The filter trigger and popup.
public function Popup of TMsg(
  Id: string;
  Panel: E.Element of TMsg;
  Count: int;
  Open: bool;
  Toggle: function(bool): TMsg;
  Width: int
): E.Element of TMsg;
requires Width > 0;
begin
  const Trigger: E.Element of TMsg := B.Button of TMsg(
    Id + '-filters', if Count > 0 then
      'Filters · ' + Count.ToString()
    else
      'Filters'
    end if, Toggle(not Open),
    new B.Options(
      Variant := S.ButtonVariant.Outline, Selected := Open,
      Icon := Sys.Char.ConvertFromUtf32($E0DC)
    )
  );
  return Popovers.Popover of TMsg(
    Id + '-filter-panel', Trigger, [Panel], Open, Toggle(false),
    new Popovers.Options(
      Position := Menus.Placement.BottomEnd,
      Width := cast Sys.Math.Min(360, Width) as float,
      Padding := 16.0F
    )
  );
end function;

// Builds a filter button and native popup for `Current`. `Width` bounds its
// popup on a narrow content area.
//
// ## Parameters
// - `Current`: The toolbar state.
// - `Scope`: Selects controls relevant to this collection.
// - `Artists`: Distinct album artists of the catalogue, in display order.
// - `Genres`: Distinct genres of the catalogue, in display order.
// - `Width`: Positive content width in logical points.
// ## Returns
// The button, labelled with the number of applied filters, and its popover.
public function Build(
  Current: M.State;
  Artists: array of string;
  Genres: array of string;
  Width: int;
  Scope: M.Scope := M.Scope.Albums
): E.Element of M.Msg;
requires Width > 0;
begin
  const Fields: C.List of E.Element of M.Msg := new C.List of E.Element of M.Msg();
  if (Scope = M.Scope.Albums or Scope = M.Scope.GenreAlbums) and Artists.Length > 0 then
    Fields.Add(
      Choice of M.Msg(
        'album-filter-artist',
        'Artist',
        'All artists',
        Artists,
        Current.Draft.Artist,
        M.Msg.Artist
      )
    );
  end if;

  if M.Root(Scope) <> M.Scope.Genres and Genres.Length > 0 then
    Fields.Add(
      Choice of M.Msg(
        'album-filter-genre',
        'Genre',
        'All genres',
        Genres,
        Current.Draft.Genre,
        M.Msg.Genre
      )
    );
  end if;
  const Panel: E.Element of M.Msg := Form of M.Msg(
    'album',
    'Filter ' + M.ItemName(Scope).ToLowerInvariant() + 's',
    Fields.ToArray(), Current.Draft.MinimumRating, M.Msg.MinimumRating, M.Msg.Reset, M.Msg.Apply,
    'Minimum ' + M.ItemName(Scope).ToLowerInvariant() + ' rating'
  );
  return Popup of M.Msg(
    'album',
    Panel,
    M.Count(Current.Applied),
    Current.Open,
    M.Msg.SetOpen,
    Width
  );
end function;

end unit;
