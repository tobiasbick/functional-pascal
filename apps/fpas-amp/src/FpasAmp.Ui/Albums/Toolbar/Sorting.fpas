// [Documentation](../../../../doc/desktop.md#browsing-music-and-collections)

// Criterion and direction share one native CUI menu trigger.
unit FpasAmp.Ui.Albums.Toolbar.Sorting;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;

uses FpasAmp.Ui.Albums.Toolbar.Model as M;
uses System as Sys;
uses System.Collections.Generic as C;

function Name(Value: M.Order; Scope: M.Scope): string;
begin
  case Value of
    when M.Order.Relevance:
      return 'Best match';
    when M.Order.Title:
      return if Scope = M.Scope.Artists then
        'Artist name'
      elsif Scope = M.Scope.Genres then
        'Genre name'
      else
        'Album title'
      end if;
    when M.Order.Artist:
      return 'Artist';
    when M.Order.Rating:
      return 'Rating';
    when M.Order.Songs:
      return 'Song count';
    else
      raise new Sys.ArgumentOutOfRangeException('Value');
  end case;
end function;

function Choice(Current: M.State; Key: string; Value: M.Order; Scope: M.Scope): Menus.Entry of M.Msg;
begin
  return (Menus.Entry of M.Msg).Action(
    new Menus.Item of M.Msg(
      Key,
      Name(Value, Scope),
      M.Msg.Sort(Value),
      Checked := Current.Sort = Value
    )
  );
end function;

// Presents `Current` as a single sort block, with direction choices inside its menu.
// Best match is offered while `Searching`; it always lists the closest albums first.
//
// ## Parameters
// - `Current`: The toolbar state.
// - `Scope`: Omits redundant artist sorting in a discography.
// - `Searching`: Whether the search text contains words.
// ## Returns
// The sort menu.
public function Build(Current: M.State; Searching: bool; Scope: M.Scope := M.Scope.Albums): E.Element of M.Msg;
begin
  const Relevance: bool := Current.Sort = M.Order.Relevance;
  const Alphabetic: bool := Current.Sort = M.Order.Title or Current.Sort = M.Order.Artist;
  const Direction: string := if Alphabetic then
    if Current.Descending then
      'Z–A'
    else
      'A–Z'
    end if
  else
    if Current.Descending then
      'High–low'
    else
      'Low–high'
    end if
  end if;
  const Entries: C.List of Menus.Entry of M.Msg := new C.List of Menus.Entry of M.Msg(
    [(Menus.Entry of M.Msg).Label('Sort by')]
  );
  if Searching then
    Entries.Add(Choice(Current, 'relevance', M.Order.Relevance, Scope));
  end if;

  Entries.Add(Choice(Current, 'title', M.Order.Title, Scope));
  if Scope = M.Scope.Albums or Scope = M.Scope.GenreAlbums then
    Entries.Add(Choice(Current, 'artist', M.Order.Artist, Scope));
  end if;

  Entries.AddRange(
    [
      Choice(Current, 'rating', M.Order.Rating, Scope),
      Choice(Current, 'songs', M.Order.Songs, Scope),
      (Menus.Entry of M.Msg).Separator,
      (Menus.Entry of M.Msg).Action(
        new Menus.Item of M.Msg(
          'ascending',
          'Ascending',
          M.Msg.Descending(false),
          Checked := not Current.Descending and not Relevance,
          Enabled := not Relevance
        )
      ),
      (Menus.Entry of M.Msg).Action(
        new Menus.Item of M.Msg(
          'descending',
          'Descending',
          M.Msg.Descending(true),
          Checked := Current.Descending and not Relevance,
          Enabled := not Relevance
        )
      )
    ]
  );
  return Trigger of M.Msg(
    'album-sort',
    if Relevance then
      Name(Current.Sort, Scope)
    else
      Name(Current.Sort, Scope) + ' · ' + Direction
    end if,
    Entries.ToArray(), Current.Descending and not Relevance
  );
end function;

// Presents the shared library sort control.
// ## Type parameters
// - `TMsg`: The page's message type.
// ## Parameters
// - `Id`: Stable menu identity.
// - `Label`: Current sort order and direction.
// - `Entries`: Available sort entries.
// - `Descending`: Whether to show the descending icon.
// ## Returns
// The sort button and its menu.
public function Trigger of TMsg(Id: string; Label: string; Entries: array of Menus.Entry of TMsg; Descending: bool): E.Element of TMsg;
begin
  return Menus.Menu of TMsg(
    Id, Label, Entries,
    new Menus.Options(
      Icon := Sys.Char.ConvertFromUtf32(
        if Descending then
          $E042
        else
          $E04A
        end if
      ),
      Variant := S.ButtonVariant.Outline,
      Position := Menus.Placement.BottomEnd
    )
  );
end function;

end unit;
