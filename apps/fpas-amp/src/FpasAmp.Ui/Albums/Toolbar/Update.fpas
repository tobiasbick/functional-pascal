// Toolbar edits stay local; the album slice derives the shown albums from them.
unit FpasAmp.Ui.Albums.Toolbar.Update;

uses
  FpasAmp.Ui.Albums.Toolbar.Model as M, FpasAmp.Library.Search.Matching as Matching,
  System as Sys;

function Searching(Text: string): bool;
begin
  return not Matching.Query.Parse(Text).IsEmpty();
end function;

// Applies `Message` to `Current`. Apply confirms the draft; closing cancels it.
// Starting a search switches to best matches, and clearing it returns to the
// order chosen before.
//
// ## Parameters
// - `Current`: The toolbar state.
// - `Message`: The proposal.
// ## Returns
// The next toolbar state.
public function Apply(Current: M.State; Message: M.Msg): M.State;
begin
  case Message of
    when M.Msg.Search(const Value: string):
      const Was: bool := Searching(Current.Search);
      const Now: bool := Searching(Value);
      if Now and not Was and Current.Sort <> M.Order.Relevance then
        return Current with
          Search := Value;
          Resume := Current.Sort;
          Sort := M.Order.Relevance;
        end with;
      end if;

      if Was and not Now and Current.Sort = M.Order.Relevance then
        return Current with
          Search := Value;
          Sort := Current.Resume;
        end with;
      end if;

      return Current with
        Search := Value;
      end with;
    when M.Msg.SetOpen(const Value: bool):
      return Current with
        Open := Value;
        Draft := Current.Applied;
      end with;
    when M.Msg.Artist(const Value: string):
      return Current with
        Draft := Current.Draft with
          Artist := Value;
        end with;
      end with;
    when M.Msg.Genre(const Value: string):
      return Current with
        Draft := Current.Draft with
          Genre := Value;
        end with;
      end with;
    when M.Msg.MinimumRating(const Value: int):
      return Current with
        Draft := Current.Draft with
          MinimumRating := Sys.Math.Clamp(Value, 0, 10);
        end with;
      end with;
    when M.Msg.Apply:
      return Current with
        Applied := Current.Draft;
        Open := false;
      end with;
    when M.Msg.Reset:
      return Current with
        Draft := new M.Filters();
      end with;
    when M.Msg.Sort(const Value: M.Order):
      if Value = M.Order.Relevance and not Searching(Current.Search) then
        return Current;
      end if;

      return Current with
        Sort := Value;
      end with;
    when M.Msg.Descending(const Value: bool):
      return Current with
        Descending := Value;
      end with;
  end case;
end function;

end unit;
