// [Documentation](../../../../doc/desktop.md#browsing-music-and-collections)

// Groups search, filters and one sort menu.
unit FpasAmp.Ui.Albums.Toolbar.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Inputs.SearchFields as Search;
uses FpasAmp.Library.Search.Matching as Matching;
uses FpasAmp.Ui.Albums.Toolbar.Filters as Filters;
uses FpasAmp.Ui.Albums.Toolbar.Model as M;
uses FpasAmp.Ui.Albums.Toolbar.Sorting as Sorting;

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

// Builds `Current` within the measured content width.
// Narrow views put the two actions below search; no catalogue work is started.
//
// ## Parameters
// - `Current`: The toolbar state.
// - `Scope`: Selects controls relevant to this collection.
// - `Artists`: Distinct album artists offered by the artist filter.
// - `Genres`: Distinct genres offered by the genre filter.
// - `Width`: Positive content width in logical points.
// ## Returns
// The search field, the filter button and the sort menu.
public function Build(
  Current: M.State; Artists: array of string; Genres: array of string; Width: int; Scope: M.Scope := M.Scope.Albums
): E.Element<M.Msg>;
requires Width > 0;
begin
  const Field: E.Element<M.Msg> := Search.SearchField<M.Msg>(
    'album-search', Current.Search, M.Msg.Search,
    new Search.Options(
      Placeholder := case Scope of
        when M.Scope.Genres: 'Search genres…';
        when M.Scope.GenreAlbums: 'Search albums and artists…';
        when M.Scope.Artists: 'Search artists and genres…';
        when M.Scope.ArtistAlbums: 'Search albums and genres…';
        else 'Search titles, artists and genres…';
      end case
    )
  );
  return Arrange<M.Msg>(
    Field, Filters.Build(Current, Artists, Genres, Width, Scope),
    Sorting.Build(Current, not Matching.Query.Parse(Current.Search).IsEmpty(), Scope), Width
  );
end function;

// Arranges the search and actions in the shared library toolbar.
// ## Type parameters
// - `TMsg`: The view's message type.
// ## Parameters
// - `Field`: Search control.
// - `Filter`: Filter control.
// - `Sort`: Sort control.
// - `Width`: Available width in logical points.
// ## Returns
// The toolbar with wrapped controls at narrow widths.
public function Arrange<TMsg>(Field: E.Element<TMsg>; Filter: E.Element<TMsg>; Sort: E.Element<TMsg>; Width: int): E.Element<TMsg>;
requires Width > 0;
begin
  const Actions: E.Element<TMsg> := E.Row<TMsg>(
    new L.Flow(
      Gap := Points(12), Align := L.Alignment.Center,
      Justify := L.Justification.End, Wrap := true, Clip := false
    ), Filter, Sort
  );
  const Flow: L.Flow := new L.Flow(
    Gap := Points(12), Align := L.Alignment.Center, Clip := false
  );
  if Width < 640 then
    return E.Column<TMsg>(
      Flow with
        Align := L.Alignment.Stretch;
      end with,
      Field, Actions
    );
  end if;

  return E.Row<TMsg>(Flow, E.Size<TMsg>(Field, new L.Flex(Basis := L.Extent.Fill)), Actions);
end function;

end unit;
