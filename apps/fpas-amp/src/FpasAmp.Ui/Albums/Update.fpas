// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

// Two owned loaders service visible albums, replacing and cancelling stale ranges.
unit FpasAmp.Ui.Albums.Update;

uses Fpas.Media.Images as Images;
uses Fpas.Ui.Mvu.Application as A;
uses Fpas.Ui.Mvu.Composition as Composition;

uses FpasAmp.Library.Albums.Access as Access;
uses FpasAmp.Library.Albums.Model as Albums;
uses FpasAmp.Library.Metadata.Monitoring as Metadata;
uses FpasAmp.Ui.Albums.Artwork as Artwork;
uses FpasAmp.Ui.Albums.Browse as Browse;
uses FpasAmp.Ui.Albums.Grid as Grid;
uses FpasAmp.Ui.Albums.Groups as Groups;
uses FpasAmp.Ui.Albums.Model as M;
uses FpasAmp.Ui.Albums.Music.Browse as TrackBrowse;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Albums.Music.Update as Songs;
uses FpasAmp.Ui.Albums.Toolbar.Model as Toolbar;
uses FpasAmp.Ui.Albums.Toolbar.Update as ToolbarUpdate;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

function Failure(Error: Sys.Exception): M.Msg;
begin
  return M.Msg.Failed(Error.Message);
end function;

// Updates album browsing or delegates a message to the selected release.
// ## Parameters
// - `Current`: The current album browser state.
// - `Message`: The interaction or background completion to apply.
// - `Service`: The borrowed album index and artwork session.
// - `Library`: The borrowed metadata session for loading and rating tracks.
// ## Returns
// The next state and any commands to run off the UI thread.
public function Apply(
  Current: M.State;
  Message: M.Msg;
  Service: Access.Session?;
  Library: Metadata.Session? := null
): A.Transition of (M.State, M.Msg);
begin
  case Message of
    when M.Msg.OpenGroup(const Id: string):
      if Toolbar.IsGroup(Current.Scope) and Current.Collections.Releases.ContainsKey(Id) then
        return new A.Transition of (M.State, M.Msg)(
          Grid.Enter(
            Current, if Current.Scope = Toolbar.Scope.Artists then
              Toolbar.Scope.ArtistAlbums
            else
              Toolbar.Scope.GenreAlbums
            end if, Id
          ),
          [A.CancelBackground of M.Msg('images')]
        );
      end if;

      return new A.Transition of (M.State, M.Msg)(Current, []);
    when M.Msg.BackToGroups:
      return new A.Transition of (M.State, M.Msg)(
        Grid.Enter(Current, Toolbar.Root(Current.Scope), ''),
        [A.CancelBackground of M.Msg('images'), A.Focus of M.Msg('album-' + Current.GroupId)]
      );
    when M.Msg.OpenMusic(const Id: string):
      if Toolbar.IsGroup(Current.Scope) then
        return new A.Transition of (M.State, M.Msg)(Current, []);
      end if;

      for Album: Albums.Album in Current.Items do
        if Album.Id = Id then
          const Previous: M.State := Grid.LeaveMusic(Current);
          const Visit: long := Current.MusicVisit + 1L;
          var Cover: Images.Bitmap? := null;
          const Resolved: bool := Current.Images.TryGetValue(Id, out Cover);
          return MusicTransition(
            Previous with
              MusicVisit := Visit;
            end with,
            Songs.Open(
              TrackBrowse.Restore(
                new Music.State(
                  Album,
                  Visit,
                  Cover := Cover,
                  RequiredGenre := if Current.Scope = Toolbar.Scope.GenreAlbums then
                    Current.GroupName
                  else
                    ''
                  end if
                ), Grid.SavedMusic(Previous, Id)
              ),
              Library,
              LoadCover := not Resolved
            )
          );
        end if;
      end for;

      return new A.Transition of (M.State, M.Msg)(Current, []);
    when M.Msg.BackToAlbums:
      const Selected: Music.State? := Current.Music;
      if Selected = null then
        return new A.Transition of (M.State, M.Msg)(Current, []);
      end if;

      return new A.Transition of (M.State, M.Msg)(
        Grid.LeaveMusic(Current),
        [A.CancelBackground of M.Msg('music/load'), A.Focus of M.Msg('album-' + Selected.Album.Id)]
      );
    when M.Msg.Scrolled(const RouteKey: string, const Offset: float):
      return new A.Transition of (M.State, M.Msg)(
        Current with
          Offsets := if Offset > 0.0F then
            Current.Offsets.SetItem(RouteKey, Offset)
          else
            Current.Offsets.Remove(RouteKey)
          end if;
        end with, []
      );
    when M.Msg.Music(const Value: Music.Msg):
      const Selected: Music.State? := Current.Music;
      if Selected = null then
        return new A.Transition of (M.State, M.Msg)(Current, []);
      end if;

      return MusicTransition(Current, Songs.Apply(Selected, Value, Library));
    when M.Msg.Open:
      if Service = null then
        return new A.Transition of (M.State, M.Msg)(
          Current with
            Loaded := true;
          end with,
          []
        );
      end if;

      return new A.Transition of (M.State, M.Msg)(
        Current with
          First := -1;
          Last := -1;
        end with,
        [
          A.StartBackground of M.Msg(
            'observe',
            A.FromWorker of M.Msg(
              async function(
                Post: function(M.Msg): Tasks.Task;
                Cancellation: T.CancellationToken
              ): Tasks.Task begin
                await Service.ObserveAsync(
                  function(Value: Albums.Snapshot): Tasks.Task => Post(M.Msg.Received(Value)),
                  Cancellation
                ).ConfigureAwait(false);
              end function, Failure
            )
          )
        ]
      );
    when M.Msg.Close:
      return new A.Transition of (M.State, M.Msg)(
        Grid.LeaveMusic(Current) with
          Images := I.ImmutableDictionary of (string, Images.Bitmap?).Empty;
          First := -1;
          Last := -1;
          Generation := Current.Generation + 1L;
          Toolbar := ToolbarUpdate.Apply(Current.Toolbar, Toolbar.Msg.SetOpen(false));
          Music := null;
        end with,
        [
          A.CancelBackground of M.Msg('observe'),
          A.CancelBackground of M.Msg('images'),
          A.CancelBackground of M.Msg('music/load')
        ]
      );
    when M.Msg.Received(const Snapshot: Albums.Snapshot):
      if Current.Loaded and Current.Error = null and Current.Library.Releases.Equals(
        Snapshot.Releases
      )
      then
        // Newly indexed audio can change only the footer while its tags are pending.
        return new A.Transition of (M.State, M.Msg)(
          Current with
            Library := Snapshot;
          end with, []
        );
      end if;
      const Collections: Groups.Catalog := Groups.Build(Snapshot.Releases, Current.Scope);
      const Projection: A.Transition of (M.State, M.Msg) := Grid.Project(
        Current with
          Library := Snapshot;
          Collections := Collections;
          Loaded := true;
          Error := null;
        end with
      );
      return RefreshMusic(Projection, Library);
    when M.Msg.Visible(const First: int, const Last: int):
      const Start: int := Sys.Math.Clamp(First, 0, Current.Shown.Length);
      const Finish: int := Sys.Math.Clamp(Last, Start, Current.Shown.Length);
      if Service = null or (Start = Current.First and Finish = Current.Last) then
        return new A.Transition of (M.State, M.Msg)(Current, []);
      end if;
      // keep the covers that stay visible and load only the missing ones
      var Retained: I.ImmutableDictionary of (string, Images.Bitmap?) := I.ImmutableDictionary of (string, Images.Bitmap?).Empty;
      const Missing: C.List of int := new C.List of int();
      for Index: int := Start to Finish - 1 do
        const Id: string := Current.Shown[Index].Id;
        if Current.Images.ContainsKey(Id) then
          Retained := Retained.SetItem(Id, Current.Images[Id]);
        else
          Missing.Add(Index);
        end if;
      end for;
      const Next: M.State := Current with
        First := Start;
        Last := Finish;
        Generation := Current.Generation + 1L;
        Images := Retained;
      end with;
      if Missing.Count = 0 then
        return new A.Transition of (M.State, M.Msg)(Next, [A.CancelBackground of M.Msg('images')]);
      end if;

      const Pending: array of int := Missing.ToArray();
      return new A.Transition of (M.State, M.Msg)(
        Next, [
          A.StartBackground of M.Msg(
            'images',
            A.FromWorker of M.Msg(
              async function(
                Post: function(M.Msg): Tasks.Task;
                Cancellation: T.CancellationToken
              ): Tasks.Task
                async function Load(Offset: int): Tasks.Task;
                begin
                  var Index: int := Offset;
                  while Index < Pending.Length do
                    Cancellation.ThrowIfCancellationRequested();
                    const Album: Albums.Album := Next.Shown[Pending[Index]];
                    var Image: Images.Bitmap? := null;
                    if Toolbar.IsGroup(Next.Scope) then
                      for Release: Albums.Album in Next.Collections.Releases[Album.Id] do
                        Cancellation.ThrowIfCancellationRequested();
                        Image := await Artwork.Load(
                          Service,
                          Release,
                          Cancellation
                        ).ConfigureAwait(false);
                        if Image <> null then
                          break;
                        end if;
                      end for;
                    else
                      Image := await Artwork.Load(
                        Service,
                        Album,
                        Cancellation
                      ).ConfigureAwait(false);
                    end if;

                    await Post(M.Msg.Image(Next.Generation, Album.Id, Image)).ConfigureAwait(false);
                    Index := Index + 2;
                  end while;
                end function;
              begin
                await Tasks.Task.WhenAll(Load(0), Load(1)).ConfigureAwait(false);
              end function, Failure
            )
          )
        ]
      );
    when M.Msg.Image(const Generation: long, const Id: string, const Value: Images.Bitmap?):
      if Generation <> Current.Generation then
        return new A.Transition of (M.State, M.Msg)(Current, []);
      end if;

      return new A.Transition of (M.State, M.Msg)(
        Current with
          Images := Current.Images.SetItem(Id, Value);
        end with, []
      );
    when M.Msg.Failed(const Text: string):
      return new A.Transition of (M.State, M.Msg)(
        Current with
          Error := Text;
          Loaded := true;
        end with, []
      );
    when M.Msg.Rate(const Id: string, const Value: int):
      if Service = null or Value < 0 or Value > 10 or Current.Saving.Contains(Id) then
        return new A.Transition of (M.State, M.Msg)(Current, []);
      end if;
      var Exists: bool := false;
      for Item: Albums.Album in Current.Items do
        if Item.Id = Id then
          Exists := true;
          break;
        end if;
      end for;

      if not Exists then
        return new A.Transition of (M.State, M.Msg)(Current, []);
      end if;
      const Rating: int? := if Value = 0 then
        null
      else
        Value
      end if;
      return new A.Transition of (M.State, M.Msg)(
        Current with
          Saving := Current.Saving.Add(Id);
          Error := null;
        end with, [
          A.StartBackground of M.Msg(
            'rating-' + Id,
            A.FromWorker of M.Msg(
              async function(
                Post: function(M.Msg): Tasks.Task;
                Cancellation: T.CancellationToken
              ): Tasks.Task begin
                await Service.SetRatingAsync(Id, Rating, Cancellation).ConfigureAwait(false);
                await Post(M.Msg.Rated(Id, Rating)).ConfigureAwait(false);
              end function,
              function(Error: Sys.Exception): M.Msg => M.Msg.RatingFailed(Id, Error.Message)
            )
          )
        ]
      );
    when M.Msg.Rated(const Id: string, const Value: int?):
      const Releases: (I.ImmutableArray of Albums.Album).Builder := Current.Library.Releases.ToBuilder();
      const Genre: bool := Id.StartsWith('genre-');
      const Grouped: bool := Genre or Id.StartsWith('artist-');
      for Index: int := 0 to Releases.Count - 1 do
        const Release: Albums.Album := Releases[Index];
        if not Grouped and Release.Id = Id then
          Releases[Index] := Release with
            Rating := Value;
          end with;
          break;
        elsif Grouped then
          const Members: array of Albums.Membership := if Genre then
            Release.GenreMemberships
          else
            Release.Credits
          end if;
          for Member: int := 0 to Members.Length - 1 do
            if Members[Member].Id = Id then
              const Credits: array of Albums.Membership := new C.List of Albums.Membership(
                Members
              ).ToArray();
              Credits[Member] := Credits[Member] with
                Rating := Value;
              end with;
              Releases[Index] := if Genre then
                Release with
                  GenreMemberships := Credits;
                end with
              else
                Release with
                  Credits := Credits;
                end with
              end if;
              break;
            end if;
          end for;
        end if;
      end for;

      return Apply(
        Current with
          Saving := Current.Saving.Remove(Id);
        end with, M.Msg.Received(
          Current.Library with
            Releases := Releases.ToImmutable();
          end with
        ), Service, Library
      );
    when M.Msg.RatingFailed(const Id: string, const Text: string):
      return new A.Transition of (M.State, M.Msg)(
        Current with
          Saving := Current.Saving.Remove(Id);
          Error := Text;
        end with, []
      );
    when M.Msg.Toolbar(const Value: Toolbar.Msg):
      const Proposed: Toolbar.State := ToolbarUpdate.Apply(Current.Toolbar, Value);
      const Edited: Toolbar.State := if Value = Toolbar.Msg.Apply and Current.Loaded then
        Browse.ReconcileFilters(Proposed, Current.Catalog)
      else
        Proposed
      end if;
      const Next: M.State := Current with
        Toolbar := Edited;
      end with;
      // draft edits and the popover do not change what is shown
      if Edited.Search = Current.Toolbar.Search and Edited.Applied = Current.Toolbar.Applied
        and Edited.Sort = Current.Toolbar.Sort and Edited.Descending = Current.Toolbar.Descending
      then
        return new A.Transition of (M.State, M.Msg)(Next, []);
      end if;

      return new A.Transition of (M.State, M.Msg)(Grid.Show(Next), []);
  end case;
end function;

function RefreshMusic(
  Projection: A.Transition of (M.State, M.Msg);
  Library: Metadata.Session?
): A.Transition of (M.State, M.Msg);
begin
  const Current: M.State := Projection.Model;
  const Page: Music.State? := Current.Music;
  if Page = null then
    return Projection;
  end if;

  for Album: Albums.Album in Current.Items do
    if Album.Id = Page.Album.Id then
      const Updated: Music.State := Page with
        Album := Album;
      end with;
      if Album.Revision = Page.Album.Revision then
        return new A.Transition of (M.State, M.Msg)(
          Current with
            Music := Updated;
          end with, Projection.Commands
        );
      end if;

      const Reloaded: A.Transition of (M.State, M.Msg) := MusicTransition(
        Current,
        Songs.Open(
          Updated with
            Cover := null;
            Error := null;
          end with, Library
        )
      );
      const Work: C.List of A.Command of M.Msg := new C.List of A.Command of M.Msg(
        Projection.Commands
      );
      Work.AddRange(Reloaded.Commands);
      return new A.Transition of (M.State, M.Msg)(Reloaded.Model, Work.ToArray());
    end if;
  end for;

  const Work: C.List of A.Command of M.Msg := new C.List of A.Command of M.Msg(Projection.Commands);
  Work.Add(A.CancelBackground of M.Msg('music/load'));
  return new A.Transition of (M.State, M.Msg)(
    Current with
      Music := null;
    end with, Work.ToArray()
  );
end function;

function MusicTransition(
  Current: M.State;
  Child: A.Transition of (Music.State, Music.Msg)
): A.Transition of (M.State, M.Msg);
begin
  const Mapped: A.Transition of (Music.State, M.Msg) := Composition.MapTransition of (Music.State, Music.Msg, M.Msg)(
    Child,
    M.Msg.Music,
    'music'
  );
  return new A.Transition of (M.State, M.Msg)(
    Current with
      Music := Mapped.Model;
    end with, Mapped.Commands
  );
end function;

end unit;
