// Two owned loaders service visible albums, replacing and cancelling stale ranges.
unit FpasAmp.Ui.Albums.Update;

uses
  FpasAmp.Ui.Albums.Model as M, FpasAmp.Library.Albums.Model as Albums,
  FpasAmp.Library.Albums.Access as Access, FpasAmp.Imaging as Images,
  FpasAmp.Ui.Albums.Toolbar.Model as Toolbar, FpasAmp.Ui.Albums.Toolbar.Update as ToolbarUpdate,
  FpasAmp.Ui.Albums.Browse as Browse,
  FpasAmp.Ui.Albums.Music.Model as Music, FpasAmp.Ui.Albums.Music.Update as Songs,
  FpasAmp.Library.Metadata.Monitoring as Metadata, Fpas.Ui.Mvu.Composition as Composition,
  Fpas.Ui.Mvu.Application as A, System as Sys, System.IO as IO, System.Collections.Generic as C, System.Collections.Immutable as I,
  System.Threading as T, System.Threading.Tasks as Tasks;

function Failure(Error: Sys.Exception): M.Msg;
begin
  return M.Msg.Failed(Error.Message);
end function;

function SameArtwork(Left: I.ImmutableArray<Albums.Album>; Right: I.ImmutableArray<Albums.Album>): bool;
begin
  if Left.Length <> Right.Length then
    return false;
  end if;

  for Index: int := 0 to Left.Length - 1 do
    if Left[Index].Id <> Right[Index].Id or Left[Index].Revision <> Right[Index].Revision then
      return false;
    end if;
  end for;

  return true;
end function;

// Keeps the covers of albums whose artwork revision did not change, so a catalogue
// update does not blank covers that are still current.
function Fresh(
  Previous: I.ImmutableArray<Albums.Album>; Items: I.ImmutableArray<Albums.Album>;
  Loaded: I.ImmutableDictionary<string, Images.Bitmap?>
): I.ImmutableDictionary<string, Images.Bitmap?>;
begin
  const Revisions: C.Dictionary<string, string> := new C.Dictionary<string, string>();
  for Album: Albums.Album in Previous do
    Revisions[Album.Id] := Album.Revision;
  end for;

  var Kept: I.ImmutableDictionary<string, Images.Bitmap?> := Loaded;
  const Current: C.HashSet<string> := new C.HashSet<string>();
  for Album: Albums.Album in Items do
    var Revision: string := '';
    if Revisions.TryGetValue(Album.Id, out Revision) and Revision = Album.Revision then
      discard Current.Add(Album.Id);
    end if;
  end for;

  for Id: string in Loaded.Keys do
    if not Current.Contains(Id) then
      Kept := Kept.Remove(Id);
    end if;
  end for;

  return Kept;
end function;

function SameOrder(Left: I.ImmutableArray<Albums.Album>; Right: I.ImmutableArray<Albums.Album>): bool;
begin
  if Left.Length <> Right.Length then
    return false;
  end if;

  for Index: int := 0 to Left.Length - 1 do
    if Left[Index].Id <> Right[Index].Id then
      return false;
    end if;
  end for;

  return true;
end function;

// Selects the shown albums again. A changed order asks for a new visible range,
// so thumbnails follow the albums that are actually shown.
function Show(Current: M.State): M.State;
begin
  const Shown: I.ImmutableArray<Albums.Album> := Browse.Select(
    Current.Items,
    Current.Catalog,
    Current.Toolbar
  );
  if SameOrder(Current.Shown, Shown) then
    return Current with
      Shown := Shown;
    end with;
  end if;

  return Current with
    Shown := Shown;
    First := -1;
    Last := -1;
  end with;
end function;

// Updates album browsing or delegates a message to the selected release.
// ## Parameters
// - `Current`: The current album browser state.
// - `Message`: The interaction or background completion to apply.
// - `Service`: The borrowed album index and artwork session.
// - `Library`: The borrowed metadata session for loading and rating tracks.
// ## Returns
// The next state and any commands to run off the UI thread.
public function Apply(Current: M.State; Message: M.Msg; Service: Access.Session?; Library: Metadata.Session? := null): A.Transition<M.State, M.Msg>;
begin
  case Message of
    when M.Msg.OpenMusic(const Id: string):
      for Album: Albums.Album in Current.Shown do
        if Album.Id = Id then
          const Visit: long := Current.MusicVisit + 1L;
          return MusicTransition(
            Current with
              MusicVisit := Visit;
            end with,
            Songs.Open(new Music.State(Album, Visit), Library)
          );
        end if;
      end for;

      return new A.Transition<M.State, M.Msg>(Current, []);
    when M.Msg.BackToAlbums:
      const Selected: Music.State? := Current.Music;
      if Selected = null then
        return new A.Transition<M.State, M.Msg>(Current, []);
      end if;

      return new A.Transition<M.State, M.Msg>(
        Current with
          Music := null;
        end with,
        [A.CancelBackground<M.Msg>('music/load'), A.Focus<M.Msg>('album-' + Selected.Album.Id)]
      );
    when M.Msg.Scrolled(const Offset: float):
      return new A.Transition<M.State, M.Msg>(
        Current with
          Offset := Offset;
        end with, []
      );
    when M.Msg.Music(const Value: Music.Msg):
      const Selected: Music.State? := Current.Music;
      if Selected = null then
        return new A.Transition<M.State, M.Msg>(Current, []);
      end if;

      return MusicTransition(Current, Songs.Apply(Selected, Value, Library));
    when M.Msg.Open:
      if Service = null then
        return new A.Transition<M.State, M.Msg>(
          new M.State(Loaded := true, Toolbar := Current.Toolbar),
          []
        );
      end if;

      return new A.Transition<M.State, M.Msg>(
        Current with
          First := -1;
          Last := -1;
        end with,
        [
          A.StartBackground<M.Msg>(
            'observe',
            async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
              await Service.ObserveAsync(
                function(Items: I.ImmutableArray<Albums.Album>): Tasks.Task => Post(
                  M.Msg.Received(Items)
                ),
                Cancellation
              ).ConfigureAwait(false);
            end function, Failure
          )
        ]
      );
    when M.Msg.Close:
      return new A.Transition<M.State, M.Msg>(
        Current with
          Images := I.ImmutableDictionary<string, Images.Bitmap?>.Empty;
          First := -1;
          Last := -1;
          Generation := Current.Generation + 1L;
          Toolbar := ToolbarUpdate.Apply(Current.Toolbar, Toolbar.Msg.SetOpen(false));
          Music := null;
        end with,
        [
          A.CancelBackground<M.Msg>('observe'),
          A.CancelBackground<M.Msg>('images'),
          A.CancelBackground<M.Msg>('music/load')
        ]
      );
    when M.Msg.Received(const Items: I.ImmutableArray<Albums.Album>):
      const Prepared: Browse.Catalog := Browse.Prepare(Items);
      if SameArtwork(Current.Items, Items) then
        return new A.Transition<M.State, M.Msg>(
          Show(
            Current with
              Items := Items;
              Catalog := Prepared;
              Loaded := true;
              Error := null;
            end with
          ), []
        );
      end if;

      return new A.Transition<M.State, M.Msg>(
        Show(
          Current with
            Items := Items;
            Catalog := Prepared;
            Loaded := true;
            Images := Fresh(Current.Items, Items, Current.Images);
            First := -1;
            Last := -1;
            Generation := Current.Generation + 1L;
            Error := null;
          end with
        ),
        [A.CancelBackground<M.Msg>('images')]
      );
    when M.Msg.Visible(const First: int, const Last: int):
      const Start: int := Sys.Math.Clamp(First, 0, Current.Shown.Length);
      const Finish: int := Sys.Math.Clamp(Last, Start, Current.Shown.Length);
      if Service = null or (Start = Current.First and Finish = Current.Last) then
        return new A.Transition<M.State, M.Msg>(Current, []);
      end if;
      // keep the covers that stay visible and load only the missing ones
      var Retained: I.ImmutableDictionary<string, Images.Bitmap?> := I.ImmutableDictionary<string, Images.Bitmap?>.Empty;
      const Missing: C.List<int> := new C.List<int>();
      for Index: int := Start to Finish - 1 do
        const Id: string := Current.Shown[Index].Id;
        if Current.Images.ContainsKey(Id) then
          Retained := Retained.SetItem(Id, Current.Images[Id]);
        else
          Missing.Add(Index);
        end if;
      end for;
      const Next: M.State := Current with
        First := Start;
        Last := Finish;
        Generation := Current.Generation + 1L;
        Images := Retained;
      end with;
      if Missing.Count = 0 then
        return new A.Transition<M.State, M.Msg>(Next, [A.CancelBackground<M.Msg>('images')]);
      end if;

      const Pending: array of int := Missing.ToArray();
      return new A.Transition<M.State, M.Msg>(
        Next, [
          A.StartBackground<M.Msg>(
            'images',
            async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task
              async function Load(Offset: int): Tasks.Task;
              begin
                var Index: int := Offset;
                while Index < Pending.Length do
                  Cancellation.ThrowIfCancellationRequested();
                  const Album: Albums.Album := Next.Shown[Pending[Index]];
                  var Image: Images.Bitmap? := null;
                  try
                    Image := await Service.ThumbnailAsync(
                      Album,
                      Cancellation
                    ).ConfigureAwait(false);
                  catch Invalid: Sys.OperationCanceledException do
                    raise;
                  catch Invalid: IO.IOException do
                  catch Invalid: Sys.UnauthorizedAccessException do
                  catch Invalid: Sys.ArgumentException do
                  end try;

                  await Post(M.Msg.Image(Next.Generation, Album.Id, Image)).ConfigureAwait(false);
                  Index := Index + 2;
                end while;
              end function;
            begin
              await Tasks.Task.WhenAll(Load(0), Load(1)).ConfigureAwait(false);
            end function, Failure
          )
        ]
      );
    when M.Msg.Image(const Generation: long, const Id: string, const Value: Images.Bitmap?):
      if Generation <> Current.Generation then
        return new A.Transition<M.State, M.Msg>(Current, []);
      end if;

      return new A.Transition<M.State, M.Msg>(
        Current with
          Images := Current.Images.SetItem(Id, Value);
        end with, []
      );
    when M.Msg.Failed(const Text: string):
      return new A.Transition<M.State, M.Msg>(
        Current with
          Error := Text;
          Loaded := true;
        end with, []
      );
    when M.Msg.Rate(const Id: string, const Value: int):
      if Service = null or Value < 0 or Value > 10 or Current.Saving.Contains(Id) then
        return new A.Transition<M.State, M.Msg>(Current, []);
      end if;
      var Exists: bool := false;
      for Item: Albums.Album in Current.Items do
        if Item.Id = Id then
          Exists := true;
          break;
        end if;
      end for;

      if not Exists then
        return new A.Transition<M.State, M.Msg>(Current, []);
      end if;
      const Rating: int? := if Value = 0 then
        null
      else
        Value
      end if;
      return new A.Transition<M.State, M.Msg>(
        Current with
          Saving := Current.Saving.Add(Id);
          Error := null;
        end with, [
          A.StartBackground<M.Msg>(
            'rating-' + Id,
            async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
              await Service.SetRatingAsync(Id, Rating, Cancellation).ConfigureAwait(false);
              await Post(M.Msg.Rated(Id, Rating)).ConfigureAwait(false);
            end function,
            function(Error: Sys.Exception): M.Msg => M.Msg.RatingFailed(Id, Error.Message)
          )
        ]
      );
    when M.Msg.Rated(const Id: string, const Value: int?):
      var Items: I.ImmutableArray<Albums.Album> := Current.Items;
      for Index: int := 0 to Items.Length - 1 do
        if Items[Index].Id = Id then
          Items := Items.SetItem(
            Index, Items[Index] with
              Rating := Value;
            end with
          );
          break;
        end if;
      end for;

      return new A.Transition<M.State, M.Msg>(
        Show(
          Current with
            Items := Items;
            Saving := Current.Saving.Remove(Id);
          end with
        ), []
      );
    when M.Msg.RatingFailed(const Id: string, const Text: string):
      return new A.Transition<M.State, M.Msg>(
        Current with
          Saving := Current.Saving.Remove(Id);
          Error := Text;
        end with, []
      );
    when M.Msg.Toolbar(const Value: Toolbar.Msg):
      const Edited: Toolbar.State := ToolbarUpdate.Apply(Current.Toolbar, Value);
      const Next: M.State := Current with
        Toolbar := Edited;
      end with;
      // draft edits and the popover do not change what is shown
      if Edited.Search = Current.Toolbar.Search and Edited.Applied = Current.Toolbar.Applied
        and Edited.Sort = Current.Toolbar.Sort and Edited.Descending = Current.Toolbar.Descending
      then
        return new A.Transition<M.State, M.Msg>(Next, []);
      end if;

      return new A.Transition<M.State, M.Msg>(Show(Next), []);
  end case;
end function;

function MusicTransition(Current: M.State; Child: A.Transition<Music.State, Music.Msg>): A.Transition<M.State, M.Msg>;
begin
  const Mapped: A.Transition<Music.State, M.Msg> := Composition.MapTransition<Music.State, Music.Msg, M.Msg>(
    Child,
    M.Msg.Music,
    'music'
  );
  return new A.Transition<M.State, M.Msg>(
    Current with
      Music := Mapped.Model;
    end with, Mapped.Commands
  );
end function;

end unit;
