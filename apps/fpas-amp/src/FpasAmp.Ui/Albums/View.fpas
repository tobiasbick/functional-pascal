// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

// CUI's virtual rows contain ordinary native grids of cover/title cards.
unit FpasAmp.Ui.Albums.View;

uses Fpas.Media.Images as Imaging;
uses Fpas.Ui.Composition as Composition;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icons;
uses Fpas.Ui.Widgets.Collections.VirtualLists as Virtual;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Containers.EmptyStates as Empty;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Feedback.Alerts as Alerts;
uses Fpas.Ui.Widgets.Inputs.Ratings as Ratings;
uses Fpas.Ui.Widgets.Overlays.HoverCards as Hover;

uses FpasAmp.Library.Albums.Model as Library;
uses FpasAmp.Ui.Albums.Artwork as Artwork;
uses FpasAmp.Ui.Albums.Details as Details;
uses FpasAmp.Ui.Albums.Grid as Grid;
uses FpasAmp.Ui.Albums.Model as M;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Albums.Music.View as Songs;
uses FpasAmp.Ui.Albums.RatingStyle as RatingStyle;
uses FpasAmp.Ui.Albums.Status as Status;
uses FpasAmp.Ui.Albums.Toolbar.Model as Toolbar;
uses FpasAmp.Ui.Albums.Toolbar.View as ToolbarView;
uses FpasAmp.Ui.Player.Model as Player;
uses System as Sys;
uses System.Collections.Generic as C;

// Returns the native viewport identity for the cover grid in Current.
public function GridId(Current: M.State): string;
begin
  return 'album-grid/' + Grid.Key(Current);
end function;

const TileGap: int := 20;
const TilePadding: int := 2;
const PreferredCover: int := 216;

// Returns the number of album columns that fit in the available content.
// ## Parameters
// - `Width`: Available width in logical points.
// ## Returns
// The column count used for rendering and thumbnail visibility.
public function Columns(Width: int): int;
begin
  const Step: int := PreferredCover + TilePadding * 2 + TileGap;
  return Sys.Math.Max(1, (Width + TileGap + Step div 2) div Step);
end function;

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function Tile(Current: M.State; Album: Library.Album; Edge: int; RowHeight: int): E.Element of M.Msg;
begin
  const Image: Imaging.Bitmap? := if Current.Images.ContainsKey(Album.Id) then
    Current.Images[Album.Id]
  else
    null
  end if;
  const SongCount: string := Details.Songs(Album.Tracks);
  const Caption: string := if Album.Artist = '' then
    SongCount
  else
    Album.Artist + ' · ' + SongCount
  end if;
  const Card: E.Element of M.Msg := Cards.Card of M.Msg(
    'album-' + Album.Id, [
      Artwork.Build of M.Msg('cover-' + Album.Id, Image, Edge),
      E.Column of M.Msg(
        new L.Flow(Gap := Points(2), Align := L.Alignment.Center),
        E.Styled of M.Msg(
          E.Styled of M.Msg(E.Text of M.Msg(Album.Title), S.Role.Strong),
          S.Role.SingleLine
        ),
        E.Styled of M.Msg(
          Texts.Text of M.Msg(Caption, Texts.Appearance.Secondary),
          S.Role.SingleLine
        )
      ),
      Ratings.Rating of M.Msg(
        'album-rating-' + Album.Id, 'Rate ' + Album.Title + ' (1–10)', Album.Rating ?? 0,
        function(Value: int): M.Msg => M.Msg.Rate(Album.Id, Value),
        Maximum := 10, Enabled := not Current.Saving.Contains(Album.Id),
        StarSize := Sys.Math.Clamp(cast (Edge - 18) as float / 10.0F, 1.0F, RatingStyle.StarSize)
      )
    ],
    new Cards.Options(
      Width := L.Extent.Fixed(L.Measure.Logical(Edge + TilePadding * 2)),
      Height := L.Extent.Fixed(L.Measure.Logical(RowHeight - TileGap)),
      Padding := cast TilePadding as float,
      Gap := 6.0F,
      Align := L.Alignment.Center,
      Muted := true
    ), function(): M.Msg => if Toolbar.IsGroup(Current.Scope) then
      M.Msg.OpenGroup(Album.Id)
    else
      M.Msg.OpenMusic(Album.Id)
    end if
  );
  return Hover.HoverCard of M.Msg(
    'album-details-' + Album.Id,
    E.Styled of M.Msg(Card, S.Role.Panel),
    Details.Build(Album, Image, Toolbar.ItemName(Current.Scope)),
    new Hover.Options(Width := 380.0F, Delay := 0.7F)
  );
end function;

// Builds the responsive album grid or the selected album's tracks.
// ## Parameters
// - `Current`: Album browser state.
// - `Width`: Available width of the main area.
// - `Padding`: Shell viewport inset.
// - `Playback`: Player state for the selected album's track buttons.
// - `BackLabel`: Accessible label when the view was opened from a different section.
// ## Returns
// The current Albums view.
public function Build(Current: M.State; Width: int; Padding: int; Playback: Player.State; BackLabel: string := ''): E.Element of M.Msg;
  function Row(Index: int): E.Element of M.Msg;
  begin
    const Cells: C.List of E.Element of M.Msg := new C.List of E.Element of M.Msg();
    for Position: int := Index * Count to Sys.Math.Min(
      Current.Shown.Length,
      (Index + 1) * Count
    ) - 1 do
      Cells.Add(Tile(Current, Current.Shown[Position], Edge, RowHeight));
    end for;

    // Leave room for the native card's lift on hover.
    return E.Row of M.Msg(
      new L.Flow(
        PaddingTop := Points(4), PaddingStart := Points(Padding), PaddingEnd := Points(Padding),
        Gap := Points(TileGap)
      ), Cells.ToArray()
    );
  end function;
begin
  const Available: int := Sys.Math.Max(1, Width - Padding * 2);
  const Selected: Music.State? := Current.Music;
  if Selected <> null then
    return Composition.Map of (Music.Msg, M.Msg)(
      Songs.Build(
        Selected,
        Sys.Math.Max(1, Width),
        Current.GroupName,
        Playback,
        Current.Library.TrackCount, BackLabel
      ),
      function(Value: Music.Msg): M.Msg => case Value of
        when Music.Msg.Back: M.Msg.BackToAlbums;
        else M.Msg.Music(Value);
      end case
    );
  end if;
  const Count: int := Columns(Available);
  const Edge: int := Sys.Math.Max(
    1, (Available - (Count - 1) * TileGap) div Count - TilePadding * 2
  );
  const RowHeight: int := Edge + 76 + TileGap;
  const Plural: string := Toolbar.ItemName(Current.Scope) + 's';
  const Noun: string := Plural.ToLowerInvariant();
  const Parent: string := Toolbar.ItemName(Toolbar.Root(Current.Scope)).ToLowerInvariant() + 's';
  const Heading: E.Element of M.Msg := if Toolbar.Root(Current.Scope) <> Current.Scope then
    E.Row of M.Msg(
      new L.Flow(Gap := Points(8), Align := L.Alignment.Center),
      Icons.IconButton of M.Msg(
        Parent + '-back',
        Sys.Char.ConvertFromUtf32($E048),
        if BackLabel <> '' then
          BackLabel
        else
          'Back to ' + Parent
        end if,
        M.Msg.BackToGroups
      ),
      Texts.Text of M.Msg(Current.GroupName, Texts.Appearance.HeadingOne)
    )
  else
    Texts.Text of M.Msg(
      Plural, Texts.Appearance.HeadingOne
    )
  end if;
  const Parts: C.List of E.Element of M.Msg := new C.List of E.Element of M.Msg(
    [
      Heading,
      Composition.Map of (Toolbar.Msg, M.Msg)(
        ToolbarView.Build(
          Current.Toolbar, Current.Catalog.Artists, Current.Catalog.Genres, Available, Current.Scope
        ),
        M.Msg.Toolbar
      )
    ]
  );
  const Error: string? := Current.Error;
  if Error <> null then
    Parts.Add(
      Alerts.Alert of M.Msg(
        'album-error',
        'Library unavailable',
        new Alerts.Options(Tone := S.Tone.Warning, Description := Error)
      )
    );
  end if;

  if Current.Items.Length = 0 then
    Parts.Add(
      Empty.EmptyState of M.Msg(
        'albums-empty', if Current.Loaded then
          'No ' + Noun + ' yet'
        else
          'Loading ' + Noun + '…'
        end if,
        new Empty.Options(
          Icon := Sys.Char.ConvertFromUtf32($E1C1),
          Description := 'Your scanned music appears here.'
        )
      )
    );
  elsif Current.Shown.Length = 0 then
    Parts.Add(
      Empty.EmptyState of M.Msg(
        'albums-no-match', 'No matching ' + Noun,
        new Empty.Options(
          Icon := Sys.Char.ConvertFromUtf32($E151),
          Description := 'Try other words or fewer filters.'
        )
      )
    );
  end if;

  const Header: E.Element of M.Msg := E.Column of M.Msg(
    new L.Flow(
      PaddingStart := Points(Padding), PaddingEnd := Points(Padding), Gap := Points(20),
      Align := L.Alignment.Stretch
    ), Parts.ToArray()
  );
  const Key: string := Grid.Key(Current);
  var Offset: float := 0.0F;
  discard Current.Offsets.TryGetValue(Key, out Offset);
  const Content: array of E.Element of M.Msg := if Current.Shown.Length > 0 then
    [
      Header,
      E.Size of M.Msg(
        Virtual.VirtualList of M.Msg(
          GridId(Current), (Current.Shown.Length + Count - 1) div Count,
          cast RowHeight as float, L.Extent.Fill, Row, Offset,
          function(Value: float): M.Msg => M.Msg.Scrolled(Key, Value)
        ), new L.Flex(Basis := L.Extent.Fill)
      )
    ]
  else
    [Header]
  end if;

  return E.Column of M.Msg(
    new L.Flow(Align := L.Alignment.Stretch),
    E.Size of M.Msg(
      E.Column of M.Msg(
        new L.Flow(
          PaddingTop := Points(Padding), PaddingBottom := Points(Padding), Gap := Points(20),
          Align := L.Alignment.Stretch
        ), Content
      ), new L.Flex(Basis := L.Extent.Fill)
    ),
    Status.Build(Current)
  );
end function;

end unit;
