// CUI's virtual rows contain ordinary native grids of cover/title cards.
unit FpasAmp.Ui.Albums.View;

uses
  FpasAmp.Ui.Albums.Model as M, FpasAmp.Library.Albums.Model as Library,
  FpasAmp.Ui.Albums.Artwork as Artwork, FpasAmp.Ui.Albums.Details as Details,
  FpasAmp.Ui.Albums.Status as Status, FpasAmp.Ui.Albums.RatingStyle as RatingStyle,
  FpasAmp.Ui.Albums.Music.Model as Music, FpasAmp.Ui.Albums.Music.View as Songs,
  FpasAmp.Ui.Player.Model as Player,
  FpasAmp.Ui.Albums.Toolbar.View as ToolbarView, FpasAmp.Ui.Albums.Toolbar.Model as Toolbar,
  Fpas.Ui.Composition as Composition, Fpas.Ui.Widgets.Actions.IconButtons as Icons,
  Fpas.Media.Images as Imaging, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S,
  Fpas.Ui.Widgets.Collections.VirtualLists as Virtual,
  Fpas.Ui.Widgets.Containers.Cards as Cards, Fpas.Ui.Widgets.Display.Texts as Texts,
  Fpas.Ui.Widgets.Overlays.HoverCards as Hover,
  Fpas.Ui.Widgets.Inputs.Ratings as Ratings,
  Fpas.Ui.Widgets.Containers.EmptyStates as Empty, Fpas.Ui.Widgets.Feedback.Alerts as Alerts,
  System as Sys, System.Collections.Generic as C;

// Native virtual viewport identity, also used by post-layout range observation.
public const GridId: string := 'album-grid';

const TileGap: int := 20;
const TilePadding: int := 2;
const PreferredCover: int := 216;

// Returns the number of album columns that fit in the available content.
// ## Parameters
// - `Width`: Available width in logical points.
// ## Returns
// The column count used for rendering and thumbnail visibility.
public function Columns(Width: int): int;
begin
  const Step: int := PreferredCover + TilePadding * 2 + TileGap;
  return Sys.Math.Max(1, (Width + TileGap + Step div 2) div Step);
end function;

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function Tile(Current: M.State; Album: Library.Album; Edge: int; RowHeight: int): E.Element<M.Msg>;
begin
  const Image: Imaging.Bitmap? := if Current.Images.ContainsKey(Album.Id) then
    Current.Images[Album.Id]
  else
    null
  end if;
  const SongCount: string := Details.Songs(Album.Tracks);
  const Caption: string := if Album.Artist = '' then
    SongCount
  else
    Album.Artist + ' · ' + SongCount
  end if;
  const Card: E.Element<M.Msg> := Cards.Card<M.Msg>(
    'album-' + Album.Id, [
      Artwork.Build<M.Msg>('cover-' + Album.Id, Image, Edge),
      E.Column<M.Msg>(
        new L.Flow(Gap := Points(2), Align := L.Alignment.Center),
        E.Styled<M.Msg>(
          E.Styled<M.Msg>(E.Text<M.Msg>(Album.Title), S.Role.Strong),
          S.Role.SingleLine
        ),
        E.Styled<M.Msg>(
          Texts.Text<M.Msg>(Caption, Texts.Appearance.Secondary),
          S.Role.SingleLine
        )
      ),
      Ratings.Rating<M.Msg>(
        'album-rating-' + Album.Id, 'Rate ' + Album.Title + ' (1–10)', Album.Rating ?? 0,
        function(Value: int): M.Msg => M.Msg.Rate(Album.Id, Value),
        Maximum := 10, Enabled := not Current.Saving.Contains(Album.Id),
        StarSize := Sys.Math.Clamp(cast<float>(Edge - 18) / 10.0F, 1.0F, RatingStyle.StarSize)
      )
    ],
    new Cards.Options(
      Width := L.Extent.Fixed(L.Measure.Logical(Edge + TilePadding * 2)),
      Height := L.Extent.Fixed(L.Measure.Logical(RowHeight - TileGap)),
      Padding := cast<float>(TilePadding),
      Gap := 6.0F,
      Align := L.Alignment.Center,
      Muted := true
    ), function(): M.Msg => if Toolbar.IsGroup(Current.Scope) then
      M.Msg.OpenGroup(Album.Id)
    else
      M.Msg.OpenMusic(Album.Id)
    end if
  );
  return Hover.HoverCard<M.Msg>(
    'album-details-' + Album.Id,
    E.Styled<M.Msg>(Card, S.Role.Panel),
    Details.Build(Album, Image, Toolbar.ItemName(Current.Scope)),
    new Hover.Options(Width := 380.0F, Delay := 0.7F)
  );
end function;

// Builds the responsive album grid or the selected album's tracks.
// ## Parameters
// - `Current`: Album browser state.
// - `Width`: Available width of the main area.
// - `Padding`: Shell viewport inset.
// - `Playback`: Player state for the selected album's track buttons.
// ## Returns
// The current Albums view.
public function Build(Current: M.State; Width: int; Padding: int; Playback: Player.State): E.Element<M.Msg>;
  function Row(Index: int): E.Element<M.Msg>;
  begin
    const Cells: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>();
    for Position: int := Index * Count to Sys.Math.Min(
      Current.Shown.Length,
      (Index + 1) * Count
    ) - 1 do
      Cells.Add(Tile(Current, Current.Shown[Position], Edge, RowHeight));
    end for;

    // Leave room for the native card's lift on hover.
    return E.Row<M.Msg>(
      new L.Flow(PaddingTop := Points(4), Gap := Points(TileGap)), Cells.ToArray()
    );
  end function;
begin
  const Available: int := Sys.Math.Max(1, Width - Padding * 2);
  const Selected: Music.State? := Current.Music;
  if Selected <> null then
    return Composition.Map<Music.Msg, M.Msg>(
      Songs.Build(
        Selected,
        Sys.Math.Max(1, Width),
        Current.GroupName,
        Playback,
        Current.Library.TrackCount
      ),
      function(Value: Music.Msg): M.Msg => case Value of
        when Music.Msg.Back: M.Msg.BackToAlbums;
        else M.Msg.Music(Value);
      end case
    );
  end if;
  const Count: int := Columns(Available);
  const Edge: int := Sys.Math.Max(
    1, (Available - (Count - 1) * TileGap) div Count - TilePadding * 2
  );
  const RowHeight: int := Edge + 76 + TileGap;
  const Plural: string := Toolbar.ItemName(Current.Scope) + 's';
  const Noun: string := Plural.ToLowerInvariant();
  const Parent: string := Toolbar.ItemName(Toolbar.Root(Current.Scope)).ToLowerInvariant() + 's';
  const Heading: E.Element<M.Msg> := if Toolbar.Root(Current.Scope) <> Current.Scope then
    E.Row<M.Msg>(
      new L.Flow(Gap := Points(8), Align := L.Alignment.Center),
      Icons.IconButton<M.Msg>(
        Parent + '-back',
        Sys.Char.ConvertFromUtf32($E048),
        'Back to ' + Parent,
        M.Msg.BackToGroups
      ),
      Texts.Text<M.Msg>(Current.GroupName, Texts.Appearance.HeadingOne)
    )
  else
    Texts.Text<M.Msg>(
      Plural, Texts.Appearance.HeadingOne
    )
  end if;
  const Parts: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>(
    [
      Heading,
      Composition.Map<Toolbar.Msg, M.Msg>(
        ToolbarView.Build(
          Current.Toolbar, Current.Catalog.Artists, Current.Catalog.Genres, Available, Current.Scope
        ),
        M.Msg.Toolbar
      )
    ]
  );
  const Error: string? := Current.Error;
  if Error <> null then
    Parts.Add(
      Alerts.Alert<M.Msg>(
        'album-error',
        'Library unavailable',
        new Alerts.Options(Tone := S.Tone.Warning, Description := Error)
      )
    );
  end if;

  if Current.Items.Length = 0 then
    Parts.Add(
      Empty.EmptyState<M.Msg>(
        'albums-empty', if Current.Loaded then
          'No ' + Noun + ' yet'
        else
          'Loading ' + Noun + '…'
        end if,
        new Empty.Options(
          Icon := Sys.Char.ConvertFromUtf32($E1C1),
          Description := 'Your scanned music appears here.'
        )
      )
    );
  elsif Current.Shown.Length = 0 then
    Parts.Add(
      Empty.EmptyState<M.Msg>(
        'albums-no-match', 'No matching ' + Noun,
        new Empty.Options(
          Icon := Sys.Char.ConvertFromUtf32($E151),
          Description := 'Try other words or fewer filters.'
        )
      )
    );
  else
    Parts.Add(
      E.Size<M.Msg>(
        Virtual.VirtualList<M.Msg>(
          GridId, (Current.Shown.Length + Count - 1) div Count,
          cast<float>(RowHeight), L.Extent.Fill, Row, Current.Offset, M.Msg.Scrolled
        ), new L.Flex(Basis := L.Extent.Fill)
      )
    );
  end if;

  return E.Column<M.Msg>(
    new L.Flow(Align := L.Alignment.Stretch),
    E.Size<M.Msg>(
      E.Column<M.Msg>(
        new L.Flow(Padding := Points(Padding), Gap := Points(20), Align := L.Alignment.Stretch),
        Parts.ToArray()
      ), new L.Flex(Basis := L.Extent.Fill)
    ),
    Status.Build(Current)
  );
end function;

end unit;
