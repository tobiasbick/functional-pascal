// MVU boundary: routes slice messages and owns the library subscriptions.
unit FpasAmp.Ui.App.Controller;

uses
  FpasAmp.Ui.App.Model as M,
  FpasAmp.Ui.Settings.Model as SettingsModel, FpasAmp.Ui.Settings.Update as SettingsUpdate,
  FpasAmp.Ui.Navigation.Model as Nav, FpasAmp.Ui.Navigation.Update as Navigation,
  FpasAmp.Library.Playlists.Model as Playlists, System.Collections.Immutable as I,
  FpasAmp.Library.Inventory.Model as Inventory, FpasAmp.Library.Inventory.Progress as Progress,
  FpasAmp.Library.Inventory.Monitoring as Monitoring, Fpas.Ui.Mvu.Application as Mvu,
  FpasAmp.Library.Metadata.Monitoring as Metadata, System.Collections.Generic as C,
  FpasAmp.Ui.Albums.Model as AlbumModel, FpasAmp.Ui.Albums.Update as AlbumUpdate,
  FpasAmp.Library.Albums.Access as AlbumAccess, Fpas.Ui.Mvu.Composition as Composition,
  FpasAmp.Ui.Albums.Music.Model as Music, FpasAmp.Library.Metadata.Model as Tracks,
  FpasAmp.Ui.Player.Model as PlayerModel, FpasAmp.Ui.Player.Update as Player,
  System as Sys, System.Threading as T, System.Threading.Tasks as Tasks;

function Failure(Error: Sys.Exception): M.Msg;
begin
  return M.Msg.Settings(SettingsModel.Msg.LibraryFailed(Error.Message));
end function;

function Stopped(Error: Sys.Exception): M.Msg;
begin
  return M.Msg.Settings(SettingsModel.Msg.LibraryStopped(Error.Message));
end function;

function Settings(Current: M.State; Message: SettingsModel.Msg; Save: procedure(SettingsModel.Preferences); Library: Monitoring.Session): Mvu.Transition<M.State, M.Msg>;
begin
  const Child: Mvu.Transition<SettingsModel.State, M.Msg> := Composition.MapTransition<SettingsModel.State, SettingsModel.Msg, M.Msg>(
    SettingsUpdate.Apply(Current.Settings, Message, Save, Library), M.Msg.Settings, 'settings'
  );
  return new Mvu.Transition<M.State, M.Msg>(
    Current with
      Settings := Child.Model;
    end with, Child.Commands
  );
end function;

function Album(Current: M.State; Message: AlbumModel.Msg; Library: Monitoring.Session): Mvu.Transition<M.State, M.Msg>;
begin
  const Tags: Metadata.Session? := Library.Metadata;
  const Service: AlbumAccess.Session? := if Tags <> null then
    Tags.Albums
  else
    null
  end if;
  const Child: Mvu.Transition<AlbumModel.State, M.Msg> := Composition.MapTransition<AlbumModel.State, AlbumModel.Msg, M.Msg>(
    AlbumUpdate.Apply(Current.Albums, Message, Service, Tags), M.Msg.Albums, 'albums'
  );
  return new Mvu.Transition<M.State, M.Msg>(
    Current with
      Albums := Child.Model;
    end with, Child.Commands
  );
end function;

function Watch(Library: Monitoring.Session): array of Mvu.Command<M.Msg>;
begin
  const Commands: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>(
    [
      Mvu.StartBackground<M.Msg>(
        'library-inventory',
        async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
          while await Library.Changes.WaitToReadAsync(Cancellation).ConfigureAwait(false) do
            const Value: Inventory.Snapshot := await Library.Changes.ReadAsync(
              Cancellation
            ).ConfigureAwait(false);
            await Post(
              M.Msg.Settings(SettingsModel.Msg.InventoryReceived(Value))
            ).ConfigureAwait(false);
          end while;
        end function,
        Stopped
      ),
      Mvu.StartBackground<M.Msg>(
        'library-progress',
        async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
          while await Library.Progress.WaitToReadAsync(Cancellation).ConfigureAwait(false) do
            const Value: Progress.Snapshot := await Library.Progress.ReadAsync(
              Cancellation
            ).ConfigureAwait(false);
            await Post(
              M.Msg.Settings(SettingsModel.Msg.ProgressReceived(Value))
            ).ConfigureAwait(false);
          end while;
        end function,
        Stopped
      )
    ]
  );
  const Tags: Metadata.Session? := Library.Metadata;
  if Tags <> null then
    Commands.Add(
      Mvu.StartBackground<M.Msg>(
        'navigation-playlists',
        async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
          await Tags.Playlists.ObserveAsync(
            function(Items: I.ImmutableArray<Playlists.Summary>): Tasks.Task => Post(
              M.Msg.Navigation(Nav.Msg.Received(Items))
            ),
            Cancellation
          ).ConfigureAwait(false);
        end function,
        function(Error: Sys.Exception): M.Msg => M.Msg.Navigation(Nav.Msg.Failed(Error.Message))
      )
    );
    Commands.Add(
      Mvu.StartBackground<M.Msg>(
        'library-metadata',
        async function(_Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
          await Tags.Completion.WaitAsync(Cancellation).ConfigureAwait(false);
        end function, Stopped
      )
    );
  end if;

  if Tags = null then
    Commands.Add(
      Mvu.StartBackground<M.Msg>(
        'navigation-playlists',
        async function(Post: function(M.Msg): Tasks.Task; _Cancellation: T.CancellationToken): Tasks.Task begin
          await Post(
            M.Msg.Navigation(Nav.Msg.Received(I.ImmutableArray<Playlists.Summary>.Empty))
          ).ConfigureAwait(false);
        end function, Failure
      )
    );
  end if;

  return Commands.ToArray();
end function;

// Applies a typed UI proposal. Returned commands run outside the UI update
// through the MVU runtime.
//
// ## Parameters
// - `Current`: The app state.
// - `Message`: The proposal or background publication.
// - `Save`: Persists accepted preferences.
// - `Library`: Owns scanning, storage and metadata; stays caller-owned.
// ## Returns
// The next app state and the slices' mapped commands.
public function Apply(Current: M.State; Message: M.Msg; Save: procedure(SettingsModel.Preferences); Library: Monitoring.Session): Mvu.Transition<M.State, M.Msg>;
begin
  var Next: M.State := Current;
  var Commands: array of Mvu.Command<M.Msg> := [];
  case Message of
    when M.Msg.Navigation(const NavigationMessage: Nav.Msg):
      Next := Current with
        Navigation := Navigation.Apply(Current.Navigation, NavigationMessage);
      end with;
      const Before: bool := Nav.Key(Current.Navigation.Active) = 'albums';
      const After: bool := Nav.Key(Next.Navigation.Active) = 'albums';
      if Before <> After then
        const Transition: Mvu.Transition<M.State, M.Msg> := Album(
          Next, if After then
            AlbumModel.Msg.Open
          else
            AlbumModel.Msg.Close
          end if, Library
        );
        Next := Transition.Model;
        Commands := Transition.Commands;
      end if;
    when M.Msg.Albums(AlbumModel.Msg.Music(Music.Msg.Play(const Index: int))):
      const Page: Music.State? := Current.Albums.Music;
      if Page <> null then
        Next := Current with
          Player := Player.Apply(Current.Player, PlayerModel.Msg.Play(Page.Shown, Index));
        end with;
      end if;
    when M.Msg.Player(const PlayerMessage: PlayerModel.Msg):
      Next := Current with
        Player := Player.Apply(Current.Player, PlayerMessage);
      end with;
    when M.Msg.Albums(const AlbumMessage: AlbumModel.Msg):
      if Nav.Key(Current.Navigation.Active) = 'albums' then
        return Album(Current, AlbumMessage, Library);
      end if;

      // Durable writes outlive the visible slice; their receipts release its controls.
      case AlbumMessage of
        when AlbumModel.Msg.Rated(_, _), AlbumModel.Msg.RatingFailed(_, _):
          return Album(Current, AlbumMessage, Library);
        else
      end case;
    when M.Msg.WatchLibrary:
      Commands := Watch(Library);
      if Nav.Key(Current.Navigation.Active) = 'albums' then
        const Transition: Mvu.Transition<M.State, M.Msg> := Album(
          Current,
          AlbumModel.Msg.Open,
          Library
        );
        Next := Transition.Model;
        const All: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>(Commands);
        All.AddRange(Transition.Commands);
        Commands := All.ToArray();
      end if;
    when M.Msg.Settings(const SettingsMessage: SettingsModel.Msg):
      return Settings(Current, SettingsMessage, Save, Library);
  end case;

  return new Mvu.Transition<M.State, M.Msg>(Next, Commands);
end function;

end unit;
