// [Documentation](../../../doc/desktop.md#shell-and-navigation)

// MVU boundary: routes slice messages and owns the library subscriptions.
unit FpasAmp.Ui.App.Controller;

uses Fpas.Media.Audio as Audio;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Mvu.Composition as Composition;
uses FpasAmp.Library.Albums.Access as AlbumAccess;
uses FpasAmp.Library.Albums.Model as Releases;
uses FpasAmp.Library.Inventory.Monitoring as Monitoring;
uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Library.Metadata.Monitoring as Metadata;
uses FpasAmp.Library.Playlists.Model as Playlists;
uses FpasAmp.Ui.Albums.Grid as Grid;
uses FpasAmp.Ui.Albums.Model as AlbumModel;
uses FpasAmp.Ui.Albums.Music.Browse as Browse;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Albums.Toolbar.Model as Toolbar;
uses FpasAmp.Ui.Albums.Update as AlbumUpdate;
uses FpasAmp.Ui.App.Analysis as Analysis;
uses FpasAmp.Ui.App.Browsing as Browsing;
uses FpasAmp.Ui.App.Model as M;
uses FpasAmp.Ui.App.Podcasts as Podcasts;
uses FpasAmp.Ui.App.Radio as Radio;
uses FpasAmp.Ui.App.Subscriptions as Subscriptions;
uses FpasAmp.Ui.Music.LibraryPage as LibrarySongs;
uses FpasAmp.Ui.Navigation.Model as Nav;
uses FpasAmp.Ui.Navigation.Update as Navigation;
uses FpasAmp.Ui.Player.Availability as Availability;
uses FpasAmp.Ui.Player.Model as PlayerModel;
uses FpasAmp.Ui.Player.Playback as Playback;
uses FpasAmp.Ui.Player.Update as Player;
uses FpasAmp.Ui.Podcasts.Model as PodcastModel;
uses FpasAmp.Ui.Radio.Model as RadioModel;
uses FpasAmp.Ui.Settings.Editing as Editing;
uses FpasAmp.Ui.Settings.Model as SettingsModel;
uses FpasAmp.Ui.Settings.Update as SettingsUpdate;
uses FpasAmp.Ui.TagEditor.Model as TagModel;
uses FpasAmp.Ui.TagEditor.Update as TagUpdate;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;
uses System.Linq as Linq;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

function Failure(Error: Sys.Exception): M.Msg;
begin
  return M.Msg.Settings(SettingsModel.Msg.LibraryFailed(Error.Message));
end function;

function Settings(Current: M.State; Message: SettingsModel.Msg; Save: procedure(SettingsModel.Preferences); Library: Monitoring.Session): Mvu.Transition<M.State, M.Msg>;
begin
  const Child: Mvu.Transition<SettingsModel.State, M.Msg> := Composition.MapTransition<SettingsModel.State, SettingsModel.Msg, M.Msg>(
    SettingsUpdate.Apply(Current.Settings, Message, Save, Library), M.Msg.Settings, 'settings'
  );
  return new Mvu.Transition<M.State, M.Msg>(
    Current with
      Settings := Child.Model;
    end with, Child.Commands
  );
end function;

function Album(Current: M.State; Message: AlbumModel.Msg; Library: Monitoring.Session): Mvu.Transition<M.State, M.Msg>;
begin
  const Tags: Metadata.Session? := Library.Metadata;
  const Service: AlbumAccess.Session? := if Tags <> null then
    Tags.Albums
  else
    null
  end if;
  const Child: Mvu.Transition<AlbumModel.State, M.Msg> := Composition.MapTransition<AlbumModel.State, AlbumModel.Msg, M.Msg>(
    AlbumUpdate.Apply(Current.Albums, Message, Service, Tags), M.Msg.Albums, 'albums'
  );
  var Next: M.State := Current with
    Albums := Child.Model;
  end with;
  const Page: Music.State? := Next.Albums.Music;
  case Message of
    when AlbumModel.Msg.Received(_):
      if Toolbar.Root(Next.Albums.Scope) <> Next.Albums.Scope
        and not Next.Albums.Collections.Releases.ContainsKey(
        Next.Albums.GroupId
      )
      then
        Next := Next with
          Albums := Grid.Enter(Next.Albums, Toolbar.Root(Next.Albums.Scope), '');
        end with;
      else
        const Id: string := case Next.Navigation.Active of
          when Nav.Route.Album(const ReleaseId: string): ReleaseId;
          when Nav.Route.ArtistAlbum(
            _,
            const ReleaseId: string
          ), Nav.Route.GenreAlbum(_, const ReleaseId: string): ReleaseId;
          else '';
        end case;
        if Id <> '' and Page = null then
          for Item: Releases.Album in Next.Albums.Items do
            if Item.Id = Id then
              const Opened: Mvu.Transition<M.State, M.Msg> := Album(
                Next,
                AlbumModel.Msg.OpenMusic(Id),
                Library
              );
              const Commands: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>(
                Child.Commands
              );
              Commands.AddRange(Opened.Commands);
              return new Mvu.Transition<M.State, M.Msg>(Opened.Model, Commands.ToArray());
            end if;
          end for;
        end if;
      end if;

      Next := Next with
        Navigation := Next.Navigation with
          Active := Browsing.Destination(Next.Albums);
        end with;
      end with;
    when AlbumModel.Msg.OpenMusic(
      _
    ), AlbumModel.Msg.BackToAlbums, AlbumModel.Msg.OpenGroup(_), AlbumModel.Msg.BackToGroups:
      Next := Next with
        Navigation := Next.Navigation with
          Active := Browsing.Destination(Next.Albums);
        end with;
      end with;
    else
  end case;

  return new Mvu.Transition<M.State, M.Msg>(Next, Child.Commands);
end function;

function Songs(Current: M.State; Message: LibrarySongs.Msg; Library: Monitoring.Session; Commands: array of Mvu.Command<M.Msg>): Mvu.Transition<M.State, M.Msg>;
begin
  const Child: Mvu.Transition<LibrarySongs.State, M.Msg> := Composition.MapTransition<LibrarySongs.State, LibrarySongs.Msg, M.Msg>(
    LibrarySongs.Apply(Current.Songs, Message, Library.Metadata), M.Msg.Songs, 'songs'
  );
  const All: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>(Commands);
  All.AddRange(Child.Commands);
  return new Mvu.Transition<M.State, M.Msg>(
    Current with
      Songs := Child.Model;
    end with, All.ToArray()
  );
end function;

// Saves the current mixer alongside the latest source and appearance preferences.
// ## Parameters
// - `Current`: Shell state carrying the mixer and last saved preferences.
// - `Save`: Atomic settings writer.
// ## Returns
// The updated settings state, including a save failure if one occurred.
public function SaveMixer(Current: M.State; Save: procedure(SettingsModel.Preferences)): SettingsModel.State;
begin
  const Saved: SettingsModel.Preferences := Current.Settings.Saved;
  if Saved.Mixer.Volume = Current.Player.Volume and Linq.Enumerable.SequenceEqual<float>(
    Saved.Mixer.Gains,
    Current.Player.Gains
  )
  then
    return Current.Settings;
  end if;
  const Bands: array of float := new float[Current.Player.Gains.Length];
  Current.Player.Gains.CopyTo(Bands);
  return Editing.Persist(
    Current.Settings, Saved with
      Mixer := new Audio.Settings(Current.Player.Volume, Bands);
    end with, Save
  );
end function;

function Transport(Current: M.State; Message: PlayerModel.Msg; Port: Playback.Connection; Library: Monitoring.Session): Mvu.Transition<M.State, M.Msg>;
begin
  const Child: PlayerModel.Transition := Player.Apply(
    Current.Player, Message,
    function(Entry: Tracks.Entry): bool => Availability.Allows(Current.Settings, Entry)
  );
  const Work: PlayerModel.Request? := Child.Command;
  const Next: M.State := Current with
    Player := Child.Model;
  end with;
  if Work <> null then
    case Work of
      when PlayerModel.Request.Download(_, _, _):
        return Podcasts.Prepare(
          Current.Player,
          Analysis.After(Current, Next, Library.Metadata),
          Work,
          Port
        );
      when PlayerModel.Request.Mixer(_):
        Port.Send(Work);
        return new Mvu.Transition<M.State, M.Msg>(
          Next, [
            Mvu.StartBackground<M.Msg>(
              'save-mixer',
              Mvu.FromWorker<M.Msg>(
                async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
                  await Tasks.Task.Delay(350, Cancellation).ConfigureAwait(false);
                  await Post(M.Msg.SaveMixer).ConfigureAwait(false);
                end function, Failure
              )
            )
          ]
        );
      else
        Port.Send(Work);
    end case;
  end if;

  return Podcasts.Prepare(
    Current.Player,
    Analysis.After(Current, Next, Library.Metadata),
    Work,
    Port
  );
end function;

function EditTags(Current: M.State; Message: TagModel.Msg; Library: Monitoring.Session): Mvu.Transition<M.State, M.Msg>;
begin
  const Child: Mvu.Transition<TagModel.State?, M.Msg> := Composition.MapTransition<TagModel.State?, TagModel.Msg, M.Msg>(
    TagUpdate.Apply(
      Current.TagEditor,
      Message,
      Library.Metadata,
      Current.Settings.Saved.AcoustId.ApplicationKey
    ),
    M.Msg.TagEditor, 'tag-editor'
  );
  return new Mvu.Transition<M.State, M.Msg>(
    Current with
      TagEditor := Child.Model;
    end with, Child.Commands
  );
end function;

// Applies a typed UI proposal. Returned commands run outside the UI update
// through the MVU runtime.
//
// ## Parameters
// - `Current`: The app state.
// - `Message`: The proposal or background publication.
// - `Save`: Persists accepted preferences.
// - `Library`: Owns scanning, storage and metadata; stays caller-owned.
// - `Port`: Ordered output mailbox and device event stream.
// ## Returns
// The next app state and the slices' mapped commands.
public function Apply(Current: M.State; Message: M.Msg; Save: procedure(SettingsModel.Preferences); Library: Monitoring.Session; Port: Playback.Connection): Mvu.Transition<M.State, M.Msg>;
  function Activate(Page: Music.State; Index: int; Playlist: string := ''): Mvu.Transition<M.State, M.Msg>;
  begin
    if Index < 0 or Index >= Page.Shown.Length then
      return new Mvu.Transition<M.State, M.Msg>(Current, []);
    end if;
    const Source: Music.Selection := Browse.Selection(Page) with
      Playlist := Playlist;
    end with;
    const Track: Tracks.Entry? := PlayerModel.Track(Current.Player);
    const Action: PlayerModel.Msg := if Track <> null and Track.FileId = Page.Shown[Index].FileId
      and (Playlist = '' or (Playlist = Current.Player.Source.Playlist and Index =
      Current.Player.Index))
    then
      PlayerModel.Msg.Toggle
    else
      PlayerModel.Msg.Play(Page.Shown, Index, Source)
    end if;
    return Transport(Current, Action, Port, Library);
  end function;
  function OpenSongs(Destination: Nav.Route): LibrarySongs.Msg;
  begin
    return case Destination of
      when Nav.Route.Page(Nav.Page.Music): LibrarySongs.Msg.Open;
      when Nav.Route.Playlist(
        const Identity: Playlists.Key
      ): LibrarySongs.Msg.OpenPlaylist(Identity);
      else LibrarySongs.Msg.Close;
    end case;
  end function;
  procedure BrowsePodcasts();
  begin
    const Result: Mvu.Transition<M.State, M.Msg> := Podcasts.Navigate(
      Next,
      Current.Navigation.Active
    );
    if Result.Commands.Length > 0 then
      const Work: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>(Commands);
      Work.AddRange(Result.Commands);
      Commands := Work.ToArray();
    end if;

    Next := Result.Model;
  end procedure;
begin
  var Next: M.State := Current;
  var Commands: array of Mvu.Command<M.Msg> := [];
  case Message of
    when M.Msg.Closing(const FinalPlayer: PlayerModel.State):
      return new Mvu.Transition<M.State, M.Msg>(
        Current with
          Player := FinalPlayer;
        end with, [Mvu.Exit<M.Msg>()]
      );
    when M.Msg.Navigation(const NavigationMessage: Nav.Msg):
      Next := Current with
        Navigation := Navigation.Apply(Current.Navigation, NavigationMessage);
      end with;
      const Before: bool := Nav.Browsing(Current.Navigation.Active);
      const After: bool := Nav.Browsing(Next.Navigation.Active);
      if After and Current.Navigation.Active <> Next.Navigation.Active then
        Next := Browsing.Enter(Next);
      end if;

      if Before <> After then
        const Transition: Mvu.Transition<M.State, M.Msg> := Album(
          Next, if After then
            AlbumModel.Msg.Open
          else
            AlbumModel.Msg.Close
          end if, Library
        );
        Next := Transition.Model;
        Commands := Transition.Commands;
      elsif After and Current.Navigation.Active <> Next.Navigation.Active then
        const Work: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>();
        if Next.Albums.Scope <> Current.Albums.Scope or Next.Albums.GroupId <>
          Current.Albums.GroupId
        then
          Work.Add(Mvu.CancelBackground<M.Msg>('albums/images'));
          Work.Add(Mvu.CancelBackground<M.Msg>('albums/music/load'));
        end if;

        var Transition: Mvu.Transition<M.State, M.Msg> := new Mvu.Transition<M.State, M.Msg>(
          Next,
          []
        );
        case Next.Navigation.Active of
          when Nav.Route.Album(const Id: string), Nav.Route.ArtistAlbum(
            _,
            const Id: string
          ), Nav.Route.GenreAlbum(_, const Id: string):
            if Next.Albums.Loaded then
              Transition := Album(Next, AlbumModel.Msg.OpenMusic(Id), Library);
            end if;
          else
            Transition := Album(Next, AlbumModel.Msg.BackToAlbums, Library);
        end case;

        Next := Transition.Model;
        Work.AddRange(Transition.Commands);
        Commands := Work.ToArray();
      end if;

      if Next.Navigation.Active = Nav.Route.Page(Nav.Page.Stations)
        and not Next.Radio.Loaded and not Next.Radio.Searching
      then
        const Result: Mvu.Transition<M.State, M.Msg> := Radio.Apply(
          Next,
          RadioModel.Msg.Refresh,
          Save
        );
        const Work: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>(Commands);
        Work.AddRange(Result.Commands);
        Commands := Work.ToArray();
        Next := Result.Model;
      end if;

      if Next.Navigation.Active <> Current.Navigation.Active then
        BrowsePodcasts();
      end if;

      if Next.Navigation.Active <> Current.Navigation.Active
        and (Nav.SongTable(Next.Navigation.Active) or Nav.SongTable(Current.Navigation.Active))
      then
        return Songs(Next, OpenSongs(Next.Navigation.Active), Library, Commands);
      end if;
    when M.Msg.Songs(const Action: LibrarySongs.Msg):
      if Nav.SongTable(Current.Navigation.Active) then
        case Action of
          when LibrarySongs.Msg.Song(Music.Msg.Play(const FileId: long)):
            return Activate(Current.Songs.Page, Browse.FindFile(Current.Songs.Page.Shown, FileId));
          when LibrarySongs.Msg.Song(
            Music.Msg.PlaySlot(const Rows: I.ImmutableArray<Tracks.Entry>, const Index: int)
          ):
            if Rows.Equals(Current.Songs.Page.Shown) then
              return Activate(Current.Songs.Page, Index, Nav.Key(Current.Navigation.Active));
            end if;
          when LibrarySongs.Msg.Song(Music.Msg.EditTags(const Track: Tracks.Entry)):
            return EditTags(Current, TagModel.Msg.Open(Track), Library);
          when LibrarySongs.Msg.Song(Music.Msg.Follow(const Destination: Nav.Route)):
            return Apply(
              Current,
              M.Msg.Navigation(Nav.Msg.Follow(Destination)),
              Save,
              Library,
              Port
            );
          else
            return Songs(Current, Action, Library, []);
        end case;
      end if;
    when M.Msg.Albums(AlbumModel.Msg.Music(Music.Msg.Play(const FileId: long))):
      const Page: Music.State? := Current.Albums.Music;
      if Page <> null and Nav.Browsing(Current.Navigation.Active) then
        return Activate(Page, Browse.FindFile(Page.Shown, FileId));
      end if;
    when M.Msg.Albums(AlbumModel.Msg.Music(Music.Msg.EditTags(const Track: Tracks.Entry))):
      if Nav.Browsing(Current.Navigation.Active) then
        return EditTags(Current, TagModel.Msg.Open(Track), Library);
      end if;
    when M.Msg.TagEditor(const Action: TagModel.Msg):
      return EditTags(Current, Action, Library);
    when M.Msg.Player(const PlayerMessage: PlayerModel.Msg):
      return Transport(Current, PlayerMessage, Port, Library);
    when M.Msg.Radio(const Action: RadioModel.Msg):
      return Radio.Apply(Current, Action, Save);
    when M.Msg.Podcasts(PodcastModel.Msg.Play(const Episode: PodcastModel.Episode)):
      const Action: PlayerModel.Msg? := Podcasts.Play(Current, Episode);
      if Action <> null then
        return Transport(Current, Action, Port, Library);
      end if;
    when M.Msg.Podcasts(const Action: PodcastModel.Msg):
      return Podcasts.Apply(Current, Action, Save);
    when M.Msg.Albums(const AlbumMessage: AlbumModel.Msg):
      if Nav.Browsing(Current.Navigation.Active) then
        return Album(Current, AlbumMessage, Library);
      end if;

      // Durable writes outlive the visible slice; their receipts release its controls.
      case AlbumMessage of
        when AlbumModel.Msg.Rated(_, _), AlbumModel.Msg.RatingFailed(_, _):
          return Album(Current, AlbumMessage, Library);
        else
      end case;
    when M.Msg.WatchLibrary:
      const Restored: Tracks.Entry? := PlayerModel.Track(Current.Player);
      if Restored <> null and not Availability.Allows(Current.Settings, Restored) then
        Next := Transport(Current, PlayerModel.Msg.SourceLost(true), Port, Library).Model;
      end if;

      Commands := Subscriptions.Watch(Library, Port, Next.Player);
      case Next.Navigation.Active of
        when Nav.Route.Podcast(_), Nav.Route.Page(Nav.Page.Podcasts):
          BrowsePodcasts();
        else
      end case;

      if Next.Navigation.Active = Nav.Route.Page(Nav.Page.Stations) then
        const Result: Mvu.Transition<M.State, M.Msg> := Radio.Apply(
          Next,
          RadioModel.Msg.Refresh,
          Save
        );
        const Work: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>(Commands);
        Work.AddRange(Result.Commands);
        Commands := Work.ToArray();
        Next := Result.Model;
      end if;

      if Nav.SongTable(Current.Navigation.Active) then
        return Songs(Next, OpenSongs(Current.Navigation.Active), Library, Commands);
      end if;

      if Nav.Browsing(Current.Navigation.Active) then
        Next := Browsing.Enter(Next);
        const Transition: Mvu.Transition<M.State, M.Msg> := Album(
          Next,
          AlbumModel.Msg.Open,
          Library
        );
        Next := Transition.Model;
        const All: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>(Commands);
        All.AddRange(Transition.Commands);
        Commands := All.ToArray();
      end if;
    when M.Msg.Settings(const SettingsMessage: SettingsModel.Msg):
      const Changed: Mvu.Transition<M.State, M.Msg> := Settings(
        Current,
        SettingsMessage,
        Save,
        Library
      );
      const Track: Tracks.Entry? := PlayerModel.Track(Changed.Model.Player);
      if Track <> null and not Changed.Model.Player.Podcast then
        var Advance: bool := false;
        case SettingsMessage of
          when SettingsModel.Msg.SetOffline(_, const Offline: bool):
            Advance := Offline;
          when SettingsModel.Msg.Cleared(
            _,
            _
          ), SettingsModel.Msg.ConfirmRemove, SettingsModel.Msg.InventoryReceived(
            _
          ), SettingsModel.Msg.SaveSource:
          else
            return Changed;
        end case;

        if not Availability.Allows(Changed.Model.Settings, Track) then
          const StoppedPlayer: Mvu.Transition<M.State, M.Msg> := Transport(
            Changed.Model, PlayerModel.Msg.SourceLost(Advance), Port, Library
          );
          const Work: C.List<Mvu.Command<M.Msg>> := new C.List<Mvu.Command<M.Msg>>(
            Changed.Commands
          );
          Work.AddRange(StoppedPlayer.Commands);
          return new Mvu.Transition<M.State, M.Msg>(StoppedPlayer.Model, Work.ToArray());
        end if;
      end if;

      return Changed;
    when M.Msg.SaveMixer:
      Next := Current with
        Settings := SaveMixer(Current, Save);
      end with;
  end case;

  return new Mvu.Transition<M.State, M.Msg>(Next, Commands);
end function;

end unit;
