// App state composed of the navigation, album and settings slices.
unit FpasAmp.Ui.App.Model;

uses
  FpasAmp.Ui.Music.LibraryPage as LibrarySongs, FpasAmp.Ui.Navigation.Model as Nav,
  FpasAmp.Ui.Albums.Model as AlbumView,
  FpasAmp.Ui.Settings.Model as SettingsView,
  FpasAmp.Ui.Player.Model as Player,
  Fpas.Ui.Widgets.Theming.Themes as Themes,
  Fpas.Ui.Widgets.Theming.ThemeSwitchers as Switchers;

// Owner-thread app state; each slice owns its part.
public type State = record
  // Saved preferences, settings dialogs and library status; other slices read
  // the preferences only.
  public Settings: SettingsView.State;
  // Selected destination, settings tab, drawer and detached playlist summaries.
  public Navigation: Nav.State := new Nav.State();
  // Lazy album slice; decoded images are retained only for the realized range.
  public Albums: AlbumView.State := new AlbumView.State();
  // Queue, transport, volume and equalizer shared by every destination.
  public Player: Player.State := new Player.State();
  // Whole-library tracks and their visible cover cache.
  public Songs: LibrarySongs.State := new LibrarySongs.State();
end record;

// Typed proposals routed by the app controller.
public type Msg = variant
  // Navigate or receive a background playlist update.
  Navigation(Message: Nav.Msg);
  // Album slice lifecycle, headers and visible thumbnail completions.
  Albums(Message: AlbumView.Msg);
  // Whole-library song browser and its catalogue subscription.
  Songs(Message: LibrarySongs.Msg);
  // Settings edits and library status publications.
  Settings(Message: SettingsView.Msg);
  // Transport, volume and equalizer edits.
  Player(Message: Player.Msg);
  // Save the latest mixer after a burst of fader movement.
  SaveMixer;
  // Final paused transport captured by the native close gesture.
  Closing(FinalPlayer: Player.State);
  // Begin owned mailbox subscriptions when the shell starts.
  WatchLibrary;
end variant;

// Resolves colors for the saved preferences.
//
// ## Parameters
// - `Current`: The app state.
// - `SystemAppearance`: The desktop appearance, when reported by the GUI host.
// ## Returns
// The selected theme and accent. System falls back to light when unavailable.
public function Theme(Current: State; SystemAppearance: Themes.Mode?): Themes.Theme;
begin
  const Saved: SettingsView.Preferences := Current.Settings.Saved;
  const Mode: Themes.Mode := Switchers.Resolve(
    SettingsView.Appearance(Saved), SystemAppearance ?? Themes.Mode.Light
  );
  const Color: Themes.Accent := SettingsView.Accent(Saved);
  return if Mode = Themes.Mode.Dark then
    Themes.Dark(Color)
  else
    Themes.Light(Color)
  end if;
end function;

end unit;
