// [Documentation](../../../doc/podcasts.md#implementation)

unit FpasAmp.Ui.App.Podcasts;

uses
  FpasAmp.Ui.App.Model as App, FpasAmp.Ui.Podcasts.Model as M,
  FpasAmp.Ui.Podcasts.Update as Update, FpasAmp.Ui.Podcasts.Network as Network,
  FpasAmp.Ui.Podcasts.Browse as Browse,
  FpasAmp.Ui.Navigation.Model as Nav, FpasAmp.Ui.Settings.Model as Settings,
  FpasAmp.Ui.Settings.Editing as Editing, FpasAmp.Ui.Player.Model as Player,
  FpasAmp.Library.Metadata.Model as Tracks, Fpas.Media.Tags.AudioFiles as Tags,
  Fpas.Media.Images as Images, Fpas.Execution.Effects as Fx,
  Fpas.Ui.Mvu.Application as A, Fpas.Ui.Mvu.Composition as Composition,
  FpasAmp.Ui.Podcasts.Downloads as Downloads, FpasAmp.Ui.Player.Playback as Playback,
  System as Sys, System.Collections.Generic as C, System.Collections.Immutable as I,
  System.IO as IO, System.Net.Http as H, System.Threading as T, System.Threading.Tasks as Tasks;

function Change(Current: App.State; Action: M.Msg): A.Transition<App.State, App.Msg>;
begin
  const Result: A.Transition<M.State, App.Msg> := Composition.MapTransition<M.State, M.Msg, App.Msg>(
    Update.Apply(Current.Podcasts, Action, Current.Settings.Saved.PodcastSubscriptions),
    App.Msg.Podcasts,
    'podcasts'
  );
  return new A.Transition<App.State, App.Msg>(
    Current with
      Podcasts := Result.Model;
    end with, Result.Commands
  );
end function;

function Route(Current: App.State; Destination: Nav.Route): App.State;
begin
  return Current with
    Navigation := Current.Navigation with
      Active := Destination;
      Drawer := false;
    end with;
  end with;
end function;

function Open(Current: App.State; Show: M.Show; Subscribe: bool): A.Transition<App.State, App.Msg>;
begin
  return Change(Route(Current, Nav.Route.Podcast(Show.Id())), M.Msg.Open(Show, Subscribe));
end function;

function SearchPage(Current: App.State): A.Transition<App.State, App.Msg>;
begin
  const Closed: A.Transition<App.State, App.Msg> := Change(Current, M.Msg.Back);
  if Closed.Model.Podcasts.SearchRevision <> 0L then
    return Closed;
  end if;
  const Started: A.Transition<App.State, App.Msg> := Change(Closed.Model, M.Msg.Search(''));
  const Commands: C.List<A.Command<App.Msg>> := new C.List<A.Command<App.Msg>>(Closed.Commands);
  Commands.AddRange(Started.Commands);
  return new A.Transition<App.State, App.Msg>(Started.Model, Commands.ToArray());
end function;

// Loads podcast charts or opens a subscribed feed on navigation or startup.
// ## Parameters
// - `Current`: Application state with the newly selected route.
// - `Before`: The previous route.
// ## Returns
// The selected page and any commands that load or cancel its data.
public function Navigate(Current: App.State; Before: Nav.Route): A.Transition<App.State, App.Msg>;
begin
  case Current.Navigation.Active of
    when Nav.Route.Page(Nav.Page.Podcasts):
      return SearchPage(Current);
    when Nav.Route.Podcast(const Id: string):
      const Show: M.Show? := M.Find(
        Current.Settings.Saved.PodcastSubscriptions,
        Id
      ) ?? M.Find(Current.Podcasts.Results, Id);
      if Show <> null then
        return Open(Current, Show, false);
      end if;

      return SearchPage(Route(Current, Nav.Route.Page(Nav.Page.Podcasts)));
    else
      case Before of
        when Nav.Route.Podcast(_), Nav.Route.Page(Nav.Page.Podcasts):
          return Change(Current, M.Msg.Back);
        else
      end case;
  end case;

  return new A.Transition<App.State, App.Msg>(Current, []);
end function;

function Persist(Current: App.State; Show: M.Show; Enabled: bool; Save: procedure(Settings.Preferences)): App.State;
begin
  const Saved: Settings.Preferences := Current.Settings.Saved;
  const Old: array of M.Show := Saved.PodcastSubscriptions;
  if (M.Find(Old, Show.Id()) <> null) = Enabled then
    return Current;
  end if;
  const Items: C.List<M.Show> := new C.List<M.Show>();
  for Item: M.Show in Old do
    if Item.Url <> Show.Url then
      Items.Add(Item);
    end if;
  end for;

  if Enabled then
    Items.Add(Show);
  end if;
  const Stored: Settings.State := Editing.Persist(
    Current.Settings, Saved with
      PodcastSubscriptions := Items.ToArray();
    end with, Save
  );
  const Error: string? := if Stored.SaveFailed then
    'Could not save podcast subscriptions.'
  else
    null
  end if;
  const Page: M.State := if Current.Navigation.Active = Nav.Route.Page(Nav.Page.Podcasts) then
    Current.Podcasts with
      SearchError := Error;
    end with
  else
    Current.Podcasts with
      FeedError := Error;
    end with
  end if;
  return Current with
    Settings := Stored;
    Podcasts := if not Stored.SaveFailed and Page.Subscription <> M.SubscriptionFilter.All then
      Browse.SelectResults(Page, Stored.Saved.PodcastSubscriptions)
    else
      Page
    end if;
  end with;
end function;

// Routes a podcast message and persists subscription changes.
// ## Parameters
// - `Current`: Application state before handling the message.
// - `Action`: Podcast user action or detached effect reply.
// - `Save`: Writes the updated preferences when subscriptions change.
// ## Returns
// The updated application state and its podcast commands.
public function Apply(Current: App.State; Action: M.Msg; Save: procedure(Settings.Preferences)): A.Transition<App.State, App.Msg>;
begin
  case Action of
    when M.Msg.Open(const Show: M.Show, const Subscribe: bool):
      return Open(Current, Show, Subscribe);
    when M.Msg.Back:
      return SearchPage(Route(Current, Nav.Route.Page(Nav.Page.Podcasts)));
    when M.Msg.Subscribe(const Show: M.Show, const Enabled: bool):
      return new A.Transition<App.State, App.Msg>(Persist(Current, Show, Enabled, Save), []);
    when M.Msg.AddFeed:
      const Url: string := M.Address(Current.Podcasts.Draft ?? '');
      if Url <> '' then
        return Open(Current, new M.Show(Url, (new Sys.Uri(Url)).Host), true);
      end if;
    when M.Msg.Loaded(const Revision: long, const Feed: M.Feed):
      const Result: A.Transition<App.State, App.Msg> := Change(Current, Action);
      if Revision = Current.Podcasts.FeedRevision and Current.Podcasts.AddOnLoad then
        return new A.Transition<App.State, App.Msg>(
          Persist(Result.Model, Feed.Show, true, Save),
          Result.Commands
        );
      end if;

      return Result;
    when M.Msg.Cover(_, _, const Url: string, const Image: Images.Bitmap):
      const Result: A.Transition<App.State, App.Msg> := Change(Current, Action);
      const Show: M.Show? := Result.Model.Podcasts.Show;
      const Track: Tracks.Entry? := Player.Track(Current.Player);
      if Current.Player.Podcast and Track <> null and Show <> null and Show.Artwork = Url
        and Track.TrackId.StartsWith(Show.Id() + ':', Sys.StringComparison.Ordinal)
        and Result.Model.Podcasts.Covers <> Current.Podcasts.Covers
      then
        return new A.Transition<App.State, App.Msg>(
          Result.Model with
            Player := Current.Player with
              Cover := Image;
            end with;
          end with, Result.Commands
        );
      end if;

      return Result;
    else
  end case;

  return Change(Current, Action);
end function;

// Selects an episode in the visible queue or toggles it in the common player.
// ## Parameters
// - `Current`: Application state with the displayed episodes and current playback.
// - `Episode`: Episode whose playback was requested.
// ## Returns
// The player message, or null when the episode no longer belongs to the visible page.
public function Play(Current: App.State; Episode: M.Episode): Player.Msg?;
begin
  const Show: M.Show? := Current.Podcasts.Show;
  if Show = null or Current.Navigation.Active <> Nav.Route.Podcast(Show.Id()) then
    return null;
  end if;
  const Prefix: string := Show.Id() + ':';
  const Key: string := Prefix + Episode.Id;
  const Playing: Tracks.Entry? := Player.Track(Current.Player);
  if Current.Player.Podcast and Playing <> null and Playing.TrackId = Key then
    return Player.Msg.Toggle;
  end if;
  const Rows: array of M.Episode := Current.Podcasts.ShownEpisodes;
  const Queue: I.ImmutableArray<Tracks.Entry>.Builder := I.ImmutableArray.CreateBuilder<Tracks.Entry>(
    Rows.Length
  );
  var Slot: int := -1;
  for Index: int := 0 to Rows.Length - 1 do
    const Item: M.Episode := Rows[Index];
    if Item.Id = Episode.Id then
      Slot := Index;
    end if;

    Queue.Add(
      new Tracks.Entry(
        0L, Prefix + Item.Id, Item.Url, '', null,
        new Tags.Info(
          Title := Item.Title, Artists := [Show.Title], DurationMilliseconds := Item.Duration,
          Codec := Network.Extension(Item.Url, Item.MediaType).TrimStart(#46)
        ), null
      )
    );
  end for;

  if Slot < 0 then
    return null;
  end if;
  var Cover: Images.Bitmap? := null;
  discard Current.Podcasts.Covers.TryGetValue(Show.Artwork, out Cover);
  return Player.Msg.PlayEpisodes(Queue.MoveToImmutable(), Slot, Cover);
end function;

function DownloadEpisode(Port: Playback.Connection; Url: string; Codec: string; Revision: long): A.Command<App.Msg>;
  async function Fetch(Cache: Sys.Lazy<IO.DirectoryInfo>; Stop: T.CancellationToken): Tasks.Task<Fx.Outcome<string, string>>;
  begin
    try
      return Fx.Outcome.Success(
        await Downloads.Prepare(Cache.Value, Url, Codec, Stop).ConfigureAwait(false)
      );
    catch Error: Sys.Exception when Error is H.HttpRequestException or Error is IO.IOException
      or Error is IO.InvalidDataException or Error is Sys.UnauthorizedAccessException
      or (Error is Sys.OperationCanceledException and not Stop.IsCancellationRequested) do
      return Fx.Outcome.Failure(Error.Message);
    end try;
  end function;
begin
  return A.StartBackground<App.Msg>(
    'podcast-episode-media', A.FromEffect<string, string, Sys.Lazy<IO.DirectoryInfo>, App.Msg>(
      Fx.Effect<string, string, Sys.Lazy<IO.DirectoryInfo>>.Defer(Fetch),
      function(_Context: A.BackgroundContext<App.Msg>): Sys.Lazy<IO.DirectoryInfo> => Port.Cache,
      function(Path: string): App.Msg => App.Msg.Player(Player.Msg.EpisodeReady(Revision, Path)),
      function(Reason: string): App.Msg => App.Msg.Player(
        Player.Msg.EpisodeFailed(Revision, Reason)
      )
    )
  );
end function;

// Adds background download or cancellation for the latest transport request.
// ## Parameters
// - `Before`: The player state before the transport request.
// - `Result`: Application transition containing the new player state.
// - `Request`: The player's pending transport request, when present.
// - `Port`: Playback connection supplying the file workspace.
// ## Returns
// The application transition, augmented with the required background command.
public function Prepare(Before: Player.State; Result: A.Transition<App.State, App.Msg>; Request: Player.Request?; Port: Playback.Connection): A.Transition<App.State, App.Msg>;
begin
  const Command: A.Command<App.Msg>? := case Request of
    when Player.Request.Download(
      const Url: string,
      const Codec: string,
      const Revision: long
    ): DownloadEpisode(Port, Url, Codec, Revision);
    else if Before.Podcast and Before.Buffering and Before.Revision <>
      Result.Model.Player.Revision
    then
      A.CancelBackground<App.Msg>('podcast-episode-media')
    else
      null
    end if;
  end case;
  if Command = null then
    return Result;
  end if;

  case Request of
    when Player.Request.Download(_, _, _):
      Port.Send(Player.Request.Unload);
    else
  end case;
  const Commands: C.List<A.Command<App.Msg>> := new C.List<A.Command<App.Msg>>(Result.Commands);
  Commands.Add(Command);
  return new A.Transition<App.State, App.Msg>(Result.Model, Commands.ToArray());
end function;

end unit;
