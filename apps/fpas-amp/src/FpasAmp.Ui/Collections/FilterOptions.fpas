// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

unit FpasAmp.Ui.Collections.FilterOptions;

// Retains an available filter choice with its current spelling.
// ## Parameters
// - `Value`: Current filter selection, or empty when unset.
// - `Choices`: Available choices.
// - `Same`: Defines equality for the filter values.
// ## Returns
// The matching choice, or an empty string when the selection is unavailable.
public function Retain(Value: string; Choices: array of string; Same: function(string, string): bool): string;
begin
  if Value = '' then
    return '';
  end if;

  for Choice: string in Choices do
    if Same(Value, Choice) then
      return Choice;
    end if;
  end for;

  return '';
end function;

end unit;
