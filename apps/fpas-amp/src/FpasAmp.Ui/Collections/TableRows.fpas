// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

unit FpasAmp.Ui.Collections.TableRows;

uses System as Sys;
uses System.Collections.Generic as C;
uses System.Linq as Linq;

// Sorts rows while retaining input order for equal keys.
// ## Type parameters
// - `T`: The row type.
// ## Parameters
// - `Items`: Rows in their original order.
// - `Compare`: Compares two rows in the requested order.
// ## Returns
// A new array containing the sorted rows.
public function Sorted of T(Items: array of T; Compare: Sys.Comparison of T): array of T;
begin
  return Linq.Enumerable.ToArray of T(
    Linq.Enumerable.OrderBy of (T, T)(
      Items,
      function(Item: T): T => Item,
      (C.Comparer of T).Create(Compare)
    )
  );
end function;

// Relocates a highlighted row after filtering or sorting.
// ## Type parameters
// - `T`: The row type.
// ## Parameters
// - `Before`: Rows before the change.
// - `Index`: The previously highlighted index, or -1 when unset.
// - `After`: Rows after the change.
// - `Key`: Returns the row's stable identity.
// ## Returns
// The matching row index in After, or -1 if the original selection is unavailable.
public function Position of T(
  Before: array of T;
  Index: int;
  After: array of T;
  Key: function(T): string
): int;
begin
  if Index < 0 or Index >= Before.Length then
    return -1;
  end if;

  const Selected: string := Key(Before[Index]);
  for Row: int := 0 to After.Length - 1 do
    if Key(After[Row]) = Selected then
      return Row;
    end if;
  end for;

  return -1;
end function;

end unit;
