// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

// The whole-library song browser owns its catalogue subscription and only visible covers.
unit FpasAmp.Ui.Music.LibraryPage;

uses Fpas.Media.Images as Imaging;
uses Fpas.Ui.Mvu.Application as A;
uses Fpas.Ui.Mvu.Composition as Composition;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;

uses FpasAmp.Library.Albums.Model as Albums;
uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Library.Metadata.Monitoring as Metadata;
uses FpasAmp.Library.Playlists.Model as Lists;
uses FpasAmp.Ui.Albums.Artwork as Artwork;
uses FpasAmp.Ui.Albums.Music.Browse as Browse;
uses FpasAmp.Ui.Albums.Music.Model as Songs;
uses FpasAmp.Ui.Albums.Music.Ratings as Ratings;
uses FpasAmp.Ui.Albums.Music.Update as Edit;
uses FpasAmp.Ui.Music.Playlist as Playlist;
uses FpasAmp.Ui.Navigation.Model as Nav;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

// Detached catalogue and filter choices, prepared by the observer.
public type Catalogue = record
  // All indexed audio files in catalogue order.
  public Tracks: I.ImmutableArray of Tracks.Entry;
  // Release identities and revisions used to find artwork.
  public Releases: I.ImmutableDictionary of (string, Albums.Album);
  // Distinct performer credits for the filter.
  public Performers: array of string;
  // Album filter labels, qualified by artist for duplicate titles.
  public Titles: array of string;
  // Stable album IDs in the same order as Titles.
  public ReleaseIds: array of string;
  // Distinct song genres for the filter.
  public Genres: array of string;
end record;

// Shared song selection plus the thumbnails for the current native viewport.
public type State = record
  // Current track list key, or empty while its observer is closed.
  public ActiveKey: string := '';
  // In-session controls keyed by Music or a particular playlist.
  public Views: I.ImmutableDictionary of (string, Songs.Presentation) := I.ImmutableDictionary of (string, Songs.Presentation).Empty;
  // Song selection for the whole library, whose persisted release ID is empty.
  public Page: Songs.State := new Songs.State(
    new Albums.Album('', '', '', 0L, ''),
    0L,
    Order := new Tables.Sort(0)
  );
  // Release headers from the last catalogue snapshot.
  public Headers: I.ImmutableDictionary of (string, Albums.Album) := I.ImmutableDictionary of (string, Albums.Album).Empty;
  // Realized release thumbnails. A null entry means artwork was unavailable.
  public Covers: I.ImmutableDictionary of (string, Imaging.Bitmap?) := I.ImmutableDictionary of (string, Imaging.Bitmap?).Empty;
  // First realized row, or -1 after a change of selection.
  public First: int := -1;
  // Exclusive end of the realized row range.
  public Last: int := -1;
  // Identifies the current thumbnail load.
  public Generation: long := 0L;
end record;

// Owner-thread proposals. Visit and generation reject stale background publications.
public type Msg = variant
  // Begin observing the catalogue for this visit.
  Open;
  // Observe the tracks belonging to the ordered playlist Identity.
  OpenPlaylist(Identity: Lists.Key);
  // Release the catalogue observer and viewport images.
  Close;
  // Publish the catalogue read for Visit, with its monotonic start timestamp.
  Received(Visit: long; Started: long; Value: Catalogue);
  // Realize the half-open row range reported by CUI.
  Visible(First: int; Last: int);
  // Publish one album thumbnail for the current viewport generation.
  Image(Generation: long; AlbumId: string; Value: Imaging.Bitmap?);
  // Route a proposal to the shared song browser.
  Song(Value: Songs.Msg);
end variant;

function Prepare(
  Items: I.ImmutableArray of Tracks.Entry;
  Headers: I.ImmutableArray of Albums.Album;
  Cancellation: T.CancellationToken
): Catalogue;
begin
  const Used: C.HashSet of string := new C.HashSet of string(Sys.StringComparer.Ordinal);
  for Item: Tracks.Entry in Items do
    Cancellation.ThrowIfCancellationRequested();
    discard Used.Add(Item.AlbumId);
  end for;
  const Titles: C.List of string := new C.List of string(Headers.Length);
  const Ids: C.List of string := new C.List of string(Headers.Length);
  const Seen: C.HashSet of string := new C.HashSet of string(Sys.StringComparer.OrdinalIgnoreCase);
  const Duplicate: C.HashSet of string := new C.HashSet of string(
    Sys.StringComparer.OrdinalIgnoreCase
  );
  const Releases: I.ImmutableDictionary of (string, Albums.Album).Builder := I.ImmutableDictionary.CreateBuilder of (string, Albums.Album)();
  for Item: Albums.Album in Headers do
    Releases[Item.Id] := Item;
    if Used.Contains(Item.Id) and not Seen.Add(Item.Title) then
      discard Duplicate.Add(Item.Title);
    end if;
  end for;

  if Used.Count > 1 then
    for Release: Albums.Album in Headers do
      if Used.Contains(Release.Id) then
        Ids.Add(Release.Id);
        Titles.Add(
          if Duplicate.Contains(Release.Title) and Release.Artist <> '' then
            Release.Title + ' · ' + Release.Artist
          else
            Release.Title
          end if
        );
      end if;
    end for;
  end if;

  return new Catalogue(
    Items,
    Releases.ToImmutable(),
    Browse.PerformerChoices(Items, Cancellation),
    Titles.ToArray(), Ids.ToArray(),
    Browse.GenreChoices(Items, Cancellation)
  );
end function;

function Visible(
  Current: State;
  First: int;
  Last: int;
  Library: Metadata.Session?
): A.Transition of (State, Msg);
begin
  const Start: int := Sys.Math.Clamp(First, 0, Current.Page.Shown.Length);
  const Finish: int := Sys.Math.Clamp(Last, Start, Current.Page.Shown.Length);
  if Current.First = Start and Current.Last = Finish then
    return new A.Transition of (State, Msg)(Current, []);
  end if;
  const Retained: I.ImmutableDictionary of (string, Imaging.Bitmap?).Builder := I.ImmutableDictionary.CreateBuilder of (string, Imaging.Bitmap?)();
  const Missing: C.Dictionary of (string, Albums.Album) := new C.Dictionary of (string, Albums.Album)();
  for Index: int := Start to Finish - 1 do
    const Id: string := Current.Page.Shown[Index].AlbumId;
    if Current.Covers.ContainsKey(Id) then
      Retained[Id] := Current.Covers[Id];
    elsif Current.Headers.ContainsKey(Id) then
      Missing[Id] := Current.Headers[Id];
    end if;
  end for;
  const Next: State := Current with
    First := Start;
    Last := Finish;
    Covers := Retained.ToImmutable();
    Generation := Current.Generation + 1L;
  end with;
  if Missing.Count = 0 or Library = null then
    return new A.Transition of (State, Msg)(Next, [A.CancelBackground of Msg('covers')]);
  end if;

  return new A.Transition of (State, Msg)(
    Next, [
      A.StartBackground of Msg(
        'covers',
        A.FromWorker of Msg(
          async function(
            Post: function(Msg): Tasks.Task;
            Cancellation: T.CancellationToken
          ): Tasks.Task begin
            for Release: Albums.Album in Missing.Values do
              Cancellation.ThrowIfCancellationRequested();
              const Picture: Imaging.Bitmap? := await Artwork.Load(
                Library.Albums,
                Release,
                Cancellation
              ).ConfigureAwait(false);
              await Post(Msg.Image(Next.Generation, Release.Id, Picture)).ConfigureAwait(false);
            end for;
          end function,
          function(Error: Sys.Exception): Msg => Msg.Song(
            Songs.Msg.Failed(Current.Page.Visit, Error.Message)
          )
        )
      )
    ]
  );
end function;

// Applies Message to Current, borrowing Library for reads and durable rating writes.
// Returns the updated Music state and its cancellable commands.
public function Apply(
  Current: State;
  Message: Msg;
  Library: Metadata.Session?
): A.Transition of (State, Msg);
begin
  var Next: State := Current;
  case Message of
    when Msg.Open, Msg.OpenPlaylist(_), Msg.Close:
      const Identity: Lists.Key? := case Message of
        when Msg.OpenPlaylist(const Key: Lists.Key): Key;
        else null;
      end case;
      const Blank: State := new State();
      const Visit: long := Current.Page.Visit + 1L;
      const Views: I.ImmutableDictionary of (string, Songs.Presentation) := if Current.ActiveKey <>
        ''
      then
        Current.Views.SetItem(Current.ActiveKey, Browse.Remember(Current.Page))
      else
        Current.Views
      end if;
      const Key: string := if Message = Msg.Close then
        ''
      elsif Identity <> null then
        Nav.Key(Nav.Route.Playlist(Identity))
      else
        Nav.Key(Nav.Route.Page(Nav.Page.Music))
      end if;
      var Saved: Songs.Presentation? := null;
      if Views.ContainsKey(Key) then
        Saved := Views[Key];
      end if;

      Next := Blank with
        ActiveKey := Key;
        Views := Views;
        Page := Browse.Restore(
          Blank.Page with
            Visit := Visit;
            Loaded := Library = null;
            Order := if Identity <> null then
              new Tables.Sort(-1)
            else
              Blank.Page.Order
            end if;
          end with, Saved
        );
        Generation := Current.Generation + 1L;
      end with;
      if Message = Msg.Close or Library = null then
        return new A.Transition of (State, Msg)(
          Next,
          [A.CancelBackground of Msg('observe'), A.CancelBackground of Msg('covers')]
        );
      end if;

      return new A.Transition of (State, Msg)(
        Next, [
          A.StartBackground of Msg(
            'observe',
            A.FromWorker of Msg(
              async function(
                Post: function(Msg): Tasks.Task;
                Cancellation: T.CancellationToken
              ): Tasks.Task begin
                await Library.Albums.ObserveSongsAsync(
                  async function(
                    Started: long;
                    Entries: I.ImmutableArray of Tracks.Entry;
                    Releases: I.ImmutableArray of Albums.Album
                  ): Tasks.Task begin
                    var Items: I.ImmutableArray of Tracks.Entry := Entries;
                    if Identity <> null then
                      const List: Lists.Playlist? := await Library.Playlists.ReadAsync(
                        Identity, Cancellation
                      ).ConfigureAwait(false);
                      Items := Playlist.Resolve(List, Entries);
                    end if;

                    await Post(
                      Msg.Received(Visit, Started, Prepare(Items, Releases, Cancellation))
                    ).ConfigureAwait(false);
                  end function,
                  Cancellation
                ).ConfigureAwait(false);
              end function,
              function(Error: Sys.Exception): Msg => Msg.Song(
                Songs.Msg.Failed(Visit, Error.Message)
              )
            )
          )
        ]
      );
    when Msg.Received(const Visit: long, const Started: long, const Value: Catalogue):
      if Visit = Current.Page.Visit and Started >= Current.Page.ReadStarted then
        var Kept: I.ImmutableDictionary of (string, Imaging.Bitmap?) := Current.Covers;
        for Id: string in Current.Covers.Keys do
          if Current.Covers[Id] = null or not Value.Releases.ContainsKey(
            Id
          ) or not Current.Headers.ContainsKey(
            Id
          ) or Value.Releases[Id].Revision <> Current.Headers[Id].Revision
          then
            Kept := Kept.Remove(Id);
          end if;
        end for;

        Next := Current with
          Headers := Value.Releases;
          Covers := Kept;
          First := -1;
          Last := -1;
          Generation := Current.Generation + 1L;
          Page := Browse.Select(
            Browse.ReconcileFilters(
              Ratings.Receive(Current.Page, Value.Tracks, Started) with
                Loaded := true;
                Performers := Value.Performers;
                ReleaseTitles := Value.Titles;
                ReleaseIds := Value.ReleaseIds;
                GenreChoices := Value.Genres;
              end with
            )
          );
        end with;
      end if;
    when Msg.Visible(const First: int, const Last: int):
      return Visible(Current, First, Last, Library);
    when Msg.Image(const Generation: long, const Id: string, const Image: Imaging.Bitmap?):
      if Generation = Current.Generation then
        Next := Current with
          Covers := Current.Covers.SetItem(Id, Image);
        end with;
      end if;
    when Msg.Song(const Proposal: Songs.Msg):
      const Child: A.Transition of (Songs.State, Msg) := Composition.MapTransition of (Songs.State, Songs.Msg, Msg)(
        Edit.Apply(Current.Page, Proposal, Library),
        Msg.Song,
        'song'
      );
      Next := Current with
        Page := Child.Model;
      end with;
      if not Child.Model.Shown.Equals(Current.Page.Shown) then
        Next := Next with
          First := -1;
          Last := -1;
          Generation := Current.Generation + 1L;
        end with;
      end if;

      return new A.Transition of (State, Msg)(Next, Child.Commands);
  end case;

  return new A.Transition of (State, Msg)(Next, []);
end function;

end unit;
