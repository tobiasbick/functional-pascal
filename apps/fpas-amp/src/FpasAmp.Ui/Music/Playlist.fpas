// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

unit FpasAmp.Ui.Music.Playlist;

uses
  FpasAmp.Library.Playlists.Model as Lists, FpasAmp.Library.Metadata.Model as Tracks,
  System as Sys, System.Collections.Generic as C, System.Collections.Immutable as I;

// Resolves List against the current catalogue, keeping its order and repeated tracks.
// Entries without a catalogue match remain in storage and are omitted from this queue.
public function Resolve(List: Lists.Playlist?; Catalogue: I.ImmutableArray<Tracks.Entry>): I.ImmutableArray<Tracks.Entry>;
begin
  if List = null or List.Entries.IsEmpty then
    return I.ImmutableArray<Tracks.Entry>.Empty;
  end if;

  const Paths: C.Dictionary<string, Tracks.Entry> := new C.Dictionary<string, Tracks.Entry>(
    if Sys.OperatingSystem.IsWindows() then
      Sys.StringComparer.OrdinalIgnoreCase
    else
      Sys.StringComparer.Ordinal
    end if
  );
  const Ids: C.Dictionary<string, Tracks.Entry> := new C.Dictionary<string, Tracks.Entry>();
  for Item: Tracks.Entry in Catalogue do
    Paths[Item.Path] := Item;
    if Item.TrackId <> '' then
      discard Ids.TryAdd(Item.TrackId, Item);
    end if;
  end for;

  const Result: I.ImmutableArray<Tracks.Entry>.Builder := I.ImmutableArray.CreateBuilder<Tracks.Entry>();
  for Item: Lists.Entry in List.Entries do
    if Paths.ContainsKey(Item.CurrentReference) then
      Result.Add(Paths[Item.CurrentReference]);
    else
      case Item.Destination of
        when Lists.Target.Track(const Id: string):
          if Ids.ContainsKey(Id) then
            Result.Add(Ids[Id]);
          end if;
        else
      end case;
    end if;
  end for;

  return Result.ToImmutable();
end function;

end unit;
