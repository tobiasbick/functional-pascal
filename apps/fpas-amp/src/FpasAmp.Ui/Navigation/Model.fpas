// [Documentation](../../../doc/desktop.md#shell-and-navigation)

// Typed destinations and detached navigation data, independent of rendering.
unit FpasAmp.Ui.Navigation.Model;

uses FpasAmp.Library.Playlists.Model as Lists, System as Sys, System.Collections.Immutable as I;

// Fixed app destinations; the first four form the Library section.
public type Page = enum
  // Every indexed song.
  Music;
  // Music grouped by album.
  Albums;
  // Music grouped by performer.
  Artists;
  // Music grouped by genre.
  Genres;
  // App preferences and music sources.
  Settings;
  // Searchable online radio directory.
  Stations;
end enum;

// Exactly one selected destination, including source and durable local playlists.
public type Route = variant
  // A fixed destination.
  Page(Value: Page);
  // The track list of the release identified by its catalogue ID.
  Album(Id: string);
  // Releases credited to one artist.
  Artist(Id: string);
  // Tracks of a release reached through an artist.
  ArtistAlbum(ArtistId: string; AlbumId: string);
  // Albums containing songs in the selected genre.
  Genre(Id: string);
  // Songs of one release within the selected genre.
  GenreAlbum(GenreId: string; AlbumId: string);
  // A playlist identified independently of its display name.
  Playlist(Identity: Lists.Key);
  // Details for one saved radio station.
  Station(Id: string);
end variant;

// Owner-thread navigation state; background work publishes immutable summaries.
public type State = record
  // Active destination, initially all music.
  public Active: Route := Route.Page(Page.Music);
  // Last settings tab, independent of the active destination.
  public SettingsTab: int := 0;
  // Whether the compact navigation drawer is open; never persisted.
  public Drawer: bool := false;
  // All available playlist summaries in invariant name order.
  public Playlists: I.ImmutableArray<Lists.Summary> := I.ImmutableArray<Lists.Summary>.Empty;
  // Whether the first successful playlist snapshot has arrived.
  public Loaded: bool := false;
  // Last background navigation failure, if any.
  public Error: string? := null;
end record;

// Navigation proposals and detached background publications.
public type Msg = variant
  // Select a destination and dismiss the compact drawer.
  Select(Destination: Route);
  // Open Settings and choose General (0), Library (1) or Metadata (2).
  SelectSettingsTab(Index: int);
  // Open or dismiss the compact drawer.
  SetDrawer(Open: bool);
  // Replace all playlist summaries after a consistent background read.
  Received(Items: I.ImmutableArray<Lists.Summary>);
  // Keep cached data and report a background failure.
  Failed(Message: string);
end variant;

// Checks the numeric `Index` used to select and persist a settings tab.
public function ValidSettingsTab(Index: int): bool;
begin
  return Index >= 0 and Index <= 2;
end function;

// Returns the stable persisted/navigation key for `Destination`.
public function Key(Destination: Route): string;
begin
  case Destination of
    when Route.Page(const Value: Page):
      return Value.ToString().ToLowerInvariant();
    when Route.Album(const Id: string):
      return 'album:' + Id;
    when Route.Artist(const Id: string):
      return 'artist:' + Id;
    when Route.ArtistAlbum(const ArtistId: string, const AlbumId: string):
      return 'artist:' + ArtistId + ':' + AlbumId;
    when Route.Genre(const Id: string):
      return 'genre:' + Id;
    when Route.GenreAlbum(const Id: string, const AlbumId: string):
      return 'genre:' + Id + ':' + AlbumId;
    when Route.Playlist(const Identity: Lists.Key):
      return 'playlist:' + Identity.Storage.ToString().ToLowerInvariant() + ':' + Identity.Id;
    when Route.Station(const Id: string):
      return 'station:' + Id;
  end case;
end function;

// Returns the sidebar item's key for `Destination`, including its nested pages.
public function SectionKey(Destination: Route): string;
begin
  case Destination of
    when Route.Genre(_), Route.GenreAlbum(_, _):
      return 'genres';
    when Route.Artist(_), Route.ArtistAlbum(_, _):
      return 'artists';
    when Route.Album(_):
      return 'albums';
    else
      return Key(Destination);
  end case;
end function;

// Whether the destination uses the shared release/artist browser.
public function Browsing(Destination: Route): bool;
begin
  const Section: string := SectionKey(Destination);
  return Section = 'albums' or Section = 'artists' or Section = 'genres';
end function;

// Whether Destination uses the full track-table layout.
public function SongTable(Destination: Route): bool;
begin
  return case Destination of
    when Route.Page(Page.Music), Route.Playlist(_): true;
    else false;
  end case;
end function;

function HexId(Value: string): bool;
begin
  if Value.Length <> 64 then
    return false;
  end if;

  for Digit: char in Value do
    if not Sys.Uri.IsHexDigit(Digit) then
      return false;
    end if;
  end for;

  return true;
end function;

// Parses a stored `Value`; malformed/unknown destinations return null.
public function Parse(Value: string): Route?;
begin
  for Item: Page in [
    Page.Music,
    Page.Albums,
    Page.Artists,
    Page.Genres,
    Page.Settings,
    Page.Stations
  ] do
    if Value = Item.ToString().ToLowerInvariant() then
      return Route.Page(Item);
    end if;
  end for;
  const Parts: array of string := Value.Split(#58);
  var StationId: Sys.Guid := Sys.Guid.Empty;
  if Parts.Length = 2 and Parts[0] = 'station'
    and (HexId(Parts[1]) or Sys.Guid.TryParseExact(Parts[1], 'N', out StationId))
  then
    return Route.Station(Parts[1]);
  end if;

  if Parts.Length = 2 and Parts[0] = 'album' and HexId(Parts[1]) then
    return Route.Album(Parts[1].ToUpperInvariant());
  end if;

  if (Parts.Length = 2 or Parts.Length = 3) and (Parts[0] = 'artist' or Parts[0] = 'genre') then
    const Prefix: string := Parts[0] + '-';
    if not Parts[1].StartsWith(Prefix, Sys.StringComparison.Ordinal) then
      return null;
    end if;
    const Hash: string := Parts[1].Substring(Prefix.Length);
    if not HexId(Hash) then
      return null;
    end if;
    const GroupId: string := Prefix + Hash.ToUpperInvariant();
    if Parts.Length = 2 then
      return if Parts[0] = 'genre' then
        Route.Genre(GroupId)
      else
        Route.Artist(GroupId)
      end if;
    end if;

    if HexId(Parts[2]) then
      const Release: string := Parts[2].ToUpperInvariant();
      return if Parts[0] = 'genre' then
        Route.GenreAlbum(GroupId, Release)
      else
        Route.ArtistAlbum(GroupId, Release)
      end if;
    end if;
  end if;
  var Id: Sys.Guid := Sys.Guid.Empty;
  if Parts.Length = 3 and Parts[
    0
  ] = 'playlist' and (Parts[1] = 'file' or Parts[1] = 'local') and Sys.Guid.TryParseExact(
    Parts[2],
    'N',
    out Id
  )
  then
    return Route.Playlist(
      new Lists.Key(
        if Parts[1] = 'file' then
          Lists.Origin.File
        else
          Lists.Origin.Local
        end if, Id.ToString('N')
      )
    );
  end if;

  return null;
end function;

// Finds `Identity` by storage and UUID, retaining same-name lists independently.
public function Find(Items: I.ImmutableArray<Lists.Summary>; Identity: Lists.Key): Lists.Summary?;
begin
  for Item: Lists.Summary in Items do
    if Item.Identity = Identity then
      return Item;
    end if;
  end for;

  return null;
end function;

end unit;
