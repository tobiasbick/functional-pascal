// [Documentation](../../../doc/desktop.md#shell-and-navigation)

// Existing CUI navigation, scrolling and empty-state widgets compose the app shell.
unit FpasAmp.Ui.Navigation.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as Styles;
uses Fpas.Ui.Widgets.Containers.EmptyStates as Empty;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Feedback.Alerts as Alerts;
uses Fpas.Ui.Widgets.Navigation.Navigation as Nav;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses FpasAmp.Library.Playlists.Model as Lists;
uses FpasAmp.Library.Sources as Sources;
uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Navigation.Model as M;
uses FpasAmp.Ui.Podcasts.Model as Podcasts;
uses FpasAmp.Ui.Radio.Model as Radio;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.IO as IO;

// Desktop sidebar width, in logical units.
public const Width: int := 224;
// Below this width the same navigation is presented in a native CUI sheet.
public const DrawerBreakpoint: int := 760;

// Returns the visible label of static `Page`.
public function Title(Page: M.Page): string;
begin
  return if Page = M.Page.Podcasts then
    'Search'
  else
    Page.ToString()
  end if;
end function;

function Icon(Page: M.Page): string;
begin
  return Sys.Char.ConvertFromUtf32(
    case Page of
      when M.Page.Music: $E122;
      when M.Page.Albums: $E1C1;
      when M.Page.Artists: $E1A4;
      when M.Page.Genres: $E17F;
      when M.Page.Settings: $E154;
      when M.Page.Podcasts: $E151;
      else $E142;
    end case
  );
end function;

function Destination(Page: M.Page): Nav.Item of App.Msg;
begin
  const Route: M.Route := M.Route.Page(Page);
  return new Nav.Item of App.Msg(
    M.Key(Route),
    Title(Page),
    App.Msg.Navigation(M.Msg.Select(Route)),
    Icon := Icon(Page)
  );
end function;

function SourceLabel(Item: Lists.Summary; Current: App.State): string;
begin
  const Path: string? := Item.Path;
  if Path = null then
    return 'Local';
  end if;

  for Source: Sources.MusicSource in Current.Settings.Saved.MusicSources do
    if Sources.Within(Path, Source.Path) then
      const Relative: string := IO.Path.GetRelativePath(
        Source.Path,
        IO.Path.GetDirectoryName(Path) ?? Source.Path
      );
      return Source.Name + if Relative = '.' then
        ''
      else
        '/' + Relative
      end if;
    end if;
  end for;

  return IO.Path.GetDirectoryName(Path) ?? '';
end function;

function Items(Current: App.State): E.Element of App.Msg;
begin
  var Active: string := M.SectionKey(Current.Navigation.Active);
  case Current.Navigation.Active of
    when M.Route.Podcast(const Id: string):
      if Podcasts.Find(Current.Settings.Saved.PodcastSubscriptions, Id) = null then
        Active := M.Key(M.Route.Page(M.Page.Podcasts));
      end if;
    else
  end case;
  const Playlists: C.List of Nav.Item of App.Msg := new C.List of Nav.Item of App.Msg();
  const Names: C.Dictionary of (string, int) := new C.Dictionary of (string, int)(
    Sys.StringComparer.OrdinalIgnoreCase
  );
  for Item: Lists.Summary in Current.Navigation.Playlists do
    Names[Item.Name] := if Names.ContainsKey(Item.Name) then
      Names[Item.Name] + 1
    else
      1
    end if;
  end for;

  for Item: Lists.Summary in Current.Navigation.Playlists do
    const Route: M.Route := M.Route.Playlist(Item.Identity);
    Playlists.Add(
      new Nav.Item of App.Msg(
        M.Key(Route), Item.Name, App.Msg.Navigation(M.Msg.Select(Route)),
        Icon := Sys.Char.ConvertFromUtf32($E106), Badge := if Names[Item.Name] > 1 then
          SourceLabel(Item, Current)
        else
          ''
        end if
      )
    );
  end for;

  if Playlists.Count = 0 then
    Playlists.Add(
      new Nav.Item of App.Msg(
        'playlists-empty',
        if Current.Navigation.Loaded then
          'No playlists found'
        else
          'Loading playlists…'
        end if,
        App.Msg.Navigation(M.Msg.SetDrawer(false)), Enabled := false
      )
    );
  end if;
  const Stations: C.List of Nav.Item of App.Msg := new C.List of Nav.Item of App.Msg(
    [Destination(M.Page.Stations)]
  );
  for Item: Radio.Station in Current.Settings.Saved.RadioFavorites do
    const Route: M.Route := M.Route.Station(Item.Id);
    Stations.Add(
      new Nav.Item of App.Msg(
        M.Key(Route), Item.Name, App.Msg.Navigation(M.Msg.Select(Route)),
        Icon := Sys.Char.ConvertFromUtf32($E142)
      )
    );
  end for;

  const Shows: C.List of Nav.Item of App.Msg := new C.List of Nav.Item of App.Msg(
    [Destination(M.Page.Podcasts)]
  );
  for Item: Podcasts.Show in Current.Settings.Saved.PodcastSubscriptions do
    const Route: M.Route := M.Route.Podcast(Item.Id());
    Shows.Add(
      new Nav.Item of App.Msg(
        M.Key(Route),
        Item.Title,
        App.Msg.Navigation(M.Msg.Select(Route)),
        Icon := Sys.Char.ConvertFromUtf32($E142)
      )
    );
  end for;

  return Nav.Sidebar of App.Msg(
    'navigation',
    [
      new Nav.Section of App.Msg(
        'Library',
        [
          Destination(M.Page.Music),
          Destination(M.Page.Albums),
          Destination(M.Page.Artists),
          Destination(M.Page.Genres)
        ]
      ),
      new Nav.Section of App.Msg('Radio', Stations.ToArray(), GapBefore := 14),
      new Nav.Section of App.Msg('Podcasts', Shows.ToArray(), GapBefore := 14),
      new Nav.Section of App.Msg('Playlists', Playlists.ToArray(), GapBefore := 14)
    ],
    if Active = 'settings' or (not Current.Navigation.Loaded and Active.StartsWith(
      'playlist:'
    ))
    then
      null
    else
      Active
    end if
  );
end function;

// Builds scrollable Library/Playlists and pinned Settings for `Current`/`Theme`.
// Optional `DrawerHeight` bounds the native sheet body at compact window sizes.
public function Sidebar(
  Current: App.State;
  Theme: Themes.Theme;
  DrawerHeight: int? := null
): E.Element of App.Msg;
begin
  const Navigation: E.Element of App.Msg := E.Size of App.Msg(
    E.ScrollView of App.Msg('navigation-scroll', Items(Current)), new L.Flex(Basis := L.Extent.Fill)
  );
  const Footer: E.Element of App.Msg := Nav.Sidebar of App.Msg(
    'settings-navigation',
    [new Nav.Section of App.Msg('', [Destination(M.Page.Settings)])],
    if M.Key(Current.Navigation.Active) = 'settings' then
      'settings'
    else
      null
    end if
  );
  if DrawerHeight <> null then
    return E.Size of App.Msg(
      E.Column of App.Msg(
        new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(8))),
        Navigation,
        Footer
      ),
      new L.Flex(
        Basis := L.Extent.Fixed(L.Measure.Logical(Sys.Math.Max(0, DrawerHeight.Value - 110)))
      )
    );
  end if;

  return E.Column of App.Msg(
    new L.Flow(
      Padding := L.Spacing.Fixed(L.Measure.Logical(12)),
      Gap := L.Spacing.Fixed(L.Measure.Logical(16)),
      Align := L.Alignment.Stretch,
      Background := Theme.Colors.SurfaceMuted
    ),
    E.Row of App.Msg(
      new L.Flow(Padding := L.Spacing.Fixed(L.Measure.Logical(4))),
      Texts.Text of App.Msg('FPas-Amp', Texts.Appearance.HeadingThree)
    ),
    Navigation, Footer
  );
end function;

// Builds an actual native placeholder for the selected Library or Playlist route.
// `Padding` follows the measured viewport; playlist failures remain informative.
public function Placeholder(Current: App.State; Padding: int): E.Element of App.Msg;
begin
  var Heading: string := 'Music';
  var Description: string := 'Your music will appear here.';
  var Glyph: string := Icon(M.Page.Music);
  var Error: string? := Current.Navigation.Error;
  case Current.Navigation.Active of
    when M.Route.Page(const Page: M.Page):
      Heading := Title(Page);
      Glyph := Icon(Page);
    when M.Route.Genre(_), M.Route.GenreAlbum(_, _):
      Heading := Title(M.Page.Genres);
      Glyph := Icon(M.Page.Genres);
    when M.Route.Artist(_), M.Route.ArtistAlbum(_, _):
      Heading := Title(M.Page.Artists);
      Glyph := Icon(M.Page.Artists);
    when M.Route.Album(_):
      Heading := Title(M.Page.Albums);
      Glyph := Icon(M.Page.Albums);
    when M.Route.Playlist(const Identity: Lists.Key):
      const Found: Lists.Summary? := M.Find(Current.Navigation.Playlists, Identity);
      Heading := if Found <> null then
        Found.Name
      else
        'Playlist'
      end if;
      Description := if Found <> null then
        'Playlist view is coming soon.'
      else
        'Loading the selected playlist…'
      end if;
      Error := if Found <> null then
        Found.Error ?? Error
      else
        Error
      end if;
      Glyph := Sys.Char.ConvertFromUtf32($E106);
    when M.Route.Station(_):
      Heading := 'Stations';
    when M.Route.Podcast(_):
      Heading := 'Podcasts';
  end case;
  const Parts: C.List of E.Element of App.Msg := new C.List of E.Element of App.Msg(
    [Texts.Text of App.Msg(Heading, Texts.Appearance.HeadingOne)]
  );
  if Error <> null then
    Parts.Add(
      Alerts.Alert of App.Msg(
        'navigation-error',
        'Playlist unavailable',
        new Alerts.Options(Tone := Styles.Tone.Warning, Description := Error)
      )
    );
  end if;

  Parts.Add(
    Empty.EmptyState of App.Msg(
      'page-placeholder',
      'Coming soon',
      new Empty.Options(Icon := Glyph, Description := Description)
    )
  );
  return E.ScrollView of App.Msg(
    'page-scroll', E.Column of App.Msg(
      new L.Flow(
        Padding := L.Spacing.Fixed(L.Measure.Logical(Padding)),
        Gap := L.Spacing.Fixed(L.Measure.Logical(20)),
        Align := L.Alignment.Stretch
      ),
      Parts.ToArray()
    )
  );
end function;

end unit;
