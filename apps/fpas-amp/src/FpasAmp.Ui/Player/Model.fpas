// [Documentation](../../../doc/desktop.md#playback-and-analysis)

// Playback queue, transport, volume and equalizer state for the player strip.
unit FpasAmp.Ui.Player.Model;

uses Fpas.Media.Audio as Audio;
uses Fpas.Media.Images as Images;

uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Fingerprints as Fp;
uses FpasAmp.Ui.Player.Presets as Presets;
uses FpasAmp.Ui.Radio.Model as Radio;
uses System.Collections.Immutable as I;

// Equalizer band captions in ascending frequency, in hertz.
public const Bands: array of string := [
  '31',
  '62',
  '125',
  '250',
  '500',
  '1k',
  '2k',
  '4k',
  '8k',
  '16k'
];
// Largest equalizer boost or cut in dB.
public const Boost: float := 12.0F;
// Quietest selectable volume in dB.
public const Quietest: float := -60.0F;

// Returns a gain of zero dB for every band.
// ## Returns
// One neutral gain per entry of `Bands`.
public function Flat(): I.ImmutableArray of float;
begin
  return Presets.Choices[0].Gains;
end function;

// Owner-thread player state and the most recent matching audio observation.
public type State = record
  // Tracks in play order, captured from the table that started playback.
  public Queue: I.ImmutableArray of Tracks.Entry := (I.ImmutableArray of Tracks.Entry).Empty;
  // Origin, filters and sort order of the playing queue.
  public Source: Music.Selection := new Music.Selection();
  // Position of the current track in `Queue`, or -1 before the first track.
  public Index: int := -1;
  // Whether the transport is running rather than paused.
  public Playing: bool := false;
  // The restored track is paused and will open on its first explicit play.
  public NeedsOpen: bool := false;
  // Whether the equalizer preset dropdown is visible.
  public PresetsOpen: bool := false;
  // Elapsed time in the current track, in milliseconds.
  public Position: double := 0.0;
  // Metadata estimate until the decoder reports its presentation length, in milliseconds.
  public Duration: double := 0.0;
  // Linear output levels supplied to the native meter.
  public Levels: array of float := [0.0F, 0.0F];
  // Content hash (or unindexed path) of the requested or displayed waveform.
  public WaveformKey: string := '';
  // Defer the offline decoder until the new track has delivered audio.
  public WaitingForAudio: bool := false;
  // Relative RMS envelope across the whole track, empty until analysis completes.
  public Waveform: array of float := [];
  // Identity of the most recently requested transport action.
  public Revision: long := 0L;
  // Open the selected track afresh after a failure or the end of the queue.
  public Finished: bool := false;
  // Diagnostic displayed in the strip when playback fails.
  public Error: string? := null;
  // Output volume in dB, from `Quietest` through zero.
  public Volume: float := 0.0F;
  // Equalizer gains in dB, one per entry of `Bands`.
  public Gains: I.ImmutableArray of float := Flat();
  // Local fingerprint request for the current track, after audio starts.
  public Fingerprint: Fp.State? := null;
  // Selected live station, or null when the player is in local track mode.
  public Station: Radio.Station? := null;
  // The selected station is waiting for audio.
  public Buffering: bool := false;
  // Optional title reported by the live stream.
  public NowPlaying: string := '';
  // Whether the finite queue contains RSS enclosures instead of indexed files.
  public Podcast: bool := false;
  // Local file prepared for the current episode, empty before the download finishes.
  public EpisodePath: string := '';
  // Artwork for the current podcast queue, if loaded.
  public Cover: Images.Bitmap? := null;
end record;

// Transport, volume and equalizer proposals.
public type Msg = variant
  // Start `Queue[Index]` and retain `Source` to reconstruct the selection.
  Play(Queue: I.ImmutableArray of Tracks.Entry; Index: int; Source: Music.Selection);
  // Play the given radio station, toggling playback if it is already selected.
  PlayStation(Station: Radio.Station);
  // Select a finite queue of episodes and its shared show artwork.
  PlayEpisodes(Queue: I.ImmutableArray of Tracks.Entry; Index: int; Cover: Images.Bitmap?);
  // Accept the complete downloaded file for the matching request.
  EpisodeReady(Revision: long; Path: string);
  // Report the failure of the matching episode download.
  EpisodeFailed(Revision: long; Reason: string);
  // Drop an unavailable current track. Offline sources can advance to the next eligible entry.
  SourceLost(Advance: bool);
  // Pause or resume the current track.
  Toggle;
  // Restart the current track, or go to the previous one near its beginning.
  Previous;
  // Go to the next queued track.
  Next;
  // Move to a fraction of the current track's duration.
  Seek(Fraction: float);
  // Set the output volume in dB.
  Volume(Value: float);
  // Set one equalizer band's gain in dB.
  Gain(Band: int; Value: float);
  // Open or dismiss the compact preset selector.
  ShowPresets(Open: bool);
  // Apply all ten gains of the chosen preset in one mixer update.
  Preset(Index: int);
  // Reset every equalizer band to zero dB.
  Flatten;
  // A device status, file failure or natural end for a specific transport request.
  Observed(Value: Audio.PlaybackEvent);
  // Background envelope for `Key`; empty when measurement was unavailable.
  Measured(Key: string; Levels: array of float);
  // Local fingerprint or the diagnostic from its calculation.
  Fingerprinted(Result: Fp.State);
  // The session worker or its subscription stopped unexpectedly.
  Unavailable(Reason: string);
end variant;

// Ordered work for the audio worker.
public type Request = variant
  // Release the current file while keeping the session available for another track.
  Unload;
  // Replace the active file and optionally start it.
  Load(Path: string; Playing: bool; Revision: long);
  // Connect to a live radio stream and start rendering it.
  Stream(Url: string; Revision: long);
  // Prepare a finite episode in the background before queuing the file load.
  Download(Url: string; Codec: string; Revision: long);
  // Open a restored track, seek, then start playback.
  Resume(Path: string; Milliseconds: double; Revision: long);
  // Pause or resume the active file.
  Transport(Playing: bool; Revision: long);
  // Seek within the active file in milliseconds.
  Position(Milliseconds: double; Revision: long);
  // Apply a complete mixer snapshot.
  Mixer(Value: Audio.Settings);
end variant;

// One player update and its optional audio command.
public type Transition = record
  // Next state for the strip.
  public Model: State;
  // Work for the single ordered audio command queue.
  public Command: Request? := null;
end record;

// Returns the current track of `Current`.
// ## Parameters
// - `Current`: Player state.
// ## Returns
// The queued track at `Index`, or null before the first track.
public function Track(Current: State): Tracks.Entry?;
begin
  return if Current.Index >= 0 and Current.Index < Current.Queue.Length then
    Current.Queue[Current.Index]
  else
    null
  end if;
end function;

// Returns the path used by the decoder for Track in Current.
public function AudioPath(Current: State; Track: Tracks.Entry): string;
begin
  return if Current.Podcast then
    Current.EpisodePath
  else
    Track.Path
  end if;
end function;

end unit;
