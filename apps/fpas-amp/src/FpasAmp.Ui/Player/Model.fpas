// Playback queue, transport, volume and equalizer state for the player strip.
unit FpasAmp.Ui.Player.Model;

uses FpasAmp.Library.Metadata.Model as Tracks, System.Collections.Immutable as I;

// Equalizer band captions in ascending frequency, in hertz.
public const Bands: array of string := [
  '31',
  '62',
  '125',
  '250',
  '500',
  '1k',
  '2k',
  '4k',
  '8k',
  '16k'
];
// Largest equalizer boost or cut in dB.
public const Boost: float := 12.0F;
// Quietest selectable volume in dB.
public const Quietest: float := -60.0F;

// Returns a gain of zero dB for every band.
// ## Returns
// One neutral gain per entry of `Bands`.
public function Flat(): I.ImmutableArray<float>;
begin
  return I.ImmutableArray.CreateRange<float>(new float[Bands.Length]);
end function;

// Owner-thread player state. Playback output is not implemented yet, so
// `Position` changes only through seeking and track changes.
public type State = record
  // Tracks in play order, captured from the table that started playback.
  public Queue: I.ImmutableArray<Tracks.Entry> := I.ImmutableArray<Tracks.Entry>.Empty;
  // Position of the current track in `Queue`, or -1 before the first track.
  public Index: int := -1;
  // Whether the transport is running rather than paused.
  public Playing: bool := false;
  // Elapsed time in the current track, in milliseconds.
  public Position: double := 0.0;
  // Output volume in dB, from `Quietest` through zero.
  public Volume: float := 0.0F;
  // Equalizer gains in dB, one per entry of `Bands`.
  public Gains: I.ImmutableArray<float> := Flat();
end record;

// Transport, volume and equalizer proposals.
public type Msg = variant
  // Start `Queue[Index]` from its beginning.
  Play(Queue: I.ImmutableArray<Tracks.Entry>; Index: int);
  // Pause or resume the current track.
  Toggle;
  // Restart the current track, or go to the previous one near its beginning.
  Previous;
  // Go to the next queued track.
  Next;
  // Move to a fraction of the current track's duration.
  Seek(Fraction: float);
  // Set the output volume in dB.
  Volume(Value: float);
  // Set one equalizer band's gain in dB.
  Gain(Band: int; Value: float);
  // Reset every equalizer band to zero dB.
  Flatten;
end variant;

// Returns the current track of `Current`.
// ## Parameters
// - `Current`: Player state.
// ## Returns
// The queued track at `Index`, or null before the first track.
public function Track(Current: State): Tracks.Entry?;
begin
  return if Current.Index >= 0 and Current.Index < Current.Queue.Length then
    Current.Queue[Current.Index]
  else
    null
  end if;
end function;

end unit;
