// [Documentation](../../../doc/desktop.md#playback-and-analysis)

// Pure player transitions on the UI owner.
unit FpasAmp.Ui.Player.Update;

uses Fpas.Media.Audio as Audio;
uses Fpas.Media.Images as Images;
uses Fpas.Media.Tags.AudioFiles as Tags;

uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Ui.Albums.Music.Browse as Browse;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Fingerprints as Fp;
uses FpasAmp.Ui.Player.Live as Live;
uses FpasAmp.Ui.Player.Model as M;
uses FpasAmp.Ui.Player.Presets as Presets;
uses FpasAmp.Ui.Radio.Model as Radio;
uses System as Sys;
uses System.Collections.Immutable as I;

const RestartAfter: double := 3000.0;

function Clamp(Value: float; Low: float; High: float): float;
begin
  return if Sys.Single.IsNaN(Value) then
    Low
  else
    Sys.Math.Clamp(Value, Low, High)
  end if;
end function;

function WaveformKey(Track: Tracks.Entry): string;
begin
  return if Track.Sha256 <> '' then
    Track.Sha256
  else
    Track.Path
  end if;
end function;

function SelectWaveform(Current: M.State; Track: Tracks.Entry): M.State;
begin
  const Key: string := WaveformKey(Track);
  if Current.WaveformKey = Key then
    return Current;
  end if;

  return Current with
    WaitingForAudio := Current.Playing;
    WaveformKey := if Current.Playing then
      Key
    else
      ''
    end if;
    Waveform := [];
  end with;
end function;

function Start(Current: M.State; Index: int): M.Transition;
begin
  const Track: Tracks.Entry := Current.Queue[Index];
  const Next: M.State := Current with
    Index := Index;
    Station := null;
    Buffering := Current.Podcast;
    EpisodePath := '';
    NowPlaying := '';
    Fingerprint := if Fp.Matches(Current.Fingerprint, Track) then
      Current.Fingerprint
    else
      null
    end if;
    Revision := Current.Revision + 1L;
    Position := 0.0;
    Duration := Browse.Duration(Track);
    Finished := false;
    NeedsOpen := false;
    Levels := [0.0F, 0.0F];
  end with;
  if Current.Podcast then
    const Metadata: Tags.Info? := Track.Metadata;
    return new M.Transition(
      Next with
        WaveformKey := '';
        Waveform := [];
        WaitingForAudio := false;
      end with,
      M.Request.Download(
        Track.Path, if Metadata <> null then
          Metadata.Codec
        else
          ''
        end if, Next.Revision
      )
    );
  end if;

  return new M.Transition(
    SelectWaveform(Next, Track),
    M.Request.Load(Track.Path, Next.Playing, Next.Revision)
  );
end function;

function Mix(Current: M.State): M.Transition;
begin
  const Gains: array of float := new float[Current.Gains.Length];
  Current.Gains.CopyTo(Gains);
  return new M.Transition(Current, M.Request.Mixer(new Audio.Settings(Current.Volume, Gains)));
end function;

function AvailableIndex(Current: M.State; Index: int; Direction: int; Allowed: function(Tracks.Entry): bool): int;
begin
  var Slot: int := Index;
  while Slot >= 0 and Slot < Current.Queue.Length do
    if Current.Podcast or Allowed(Current.Queue[Slot]) then
      return Slot;
    end if;

    Slot := Slot + Direction;
  end while;

  return -1;
end function;

function Idle(Current: M.State): M.Transition;
begin
  return new M.Transition(
    new M.State(
      Revision := Current.Revision + 1L, Volume := Current.Volume,
      Gains := Current.Gains, PresetsOpen := Current.PresetsOpen
    ), M.Request.Unload
  );
end function;

function Observe(Current: M.State; Value: Audio.PlaybackEvent; Allowed: function(Tracks.Entry): bool): M.Transition;
begin
  const Track: Tracks.Entry? := M.Track(Current);
  if Track = null or Value.RequestId <> Current.Revision or Value.Path <> M.AudioPath(
    Current,
    Track
  )
  then
    return new M.Transition(Current);
  end if;
  const Count: int := Sys.Math.Min(8, Value.Peaks.Length);
  const Levels: array of float := if Count = 0 then
    [0.0F, 0.0F]
  else
    new float[Count]
  end if;
  if Count > 0 then
    Value.Peaks.CopyTo(0, Levels, 0, Count);
  end if;
  const Next: M.State := Current with
    Position := Value.Position.TotalMilliseconds;
    Fingerprint := if not Current.Podcast and Current.Playing and Value.State =
      Audio.PlaybackState.Playing
      and Value.Position.TotalMilliseconds > 0.0 and not Fp.Matches(
      Current.Fingerprint,
      Track
    )
    then
      new Fp.State(Track)
    else
      Current.Fingerprint
    end if;
    WaitingForAudio := Current.WaitingForAudio and not ((Value.State = Audio.PlaybackState.Playing
      and Value.Position.TotalMilliseconds > 0.0)
      or (not Current.Playing and Value.State = Audio.PlaybackState.Paused));
    Duration := Value.Duration.TotalMilliseconds;
    Levels := Levels;
  end with;
  if Value.State = Audio.PlaybackState.Failed or Value.State = Audio.PlaybackState.Ended then
    const Terminal: M.State := Next with
      Finished := true;
      Error := if Value.State = Audio.PlaybackState.Failed then
        Track.Path + ' — ' + Value.Error
      else
        Current.Error
      end if;
    end with;
    const Following: int := AvailableIndex(Current, Current.Index + 1, 1, Allowed);
    if Current.Playing and Following >= 0 then
      return Start(Terminal, Following);
    end if;

    return new M.Transition(
      Terminal with
        Playing := false;
      end with
    );
  end if;

  return new M.Transition(Next);
end function;

// Applies a control proposal or session observation without performing I/O.
// ## Parameters
// - `Current`: Owner-thread playback state.
// - `Message`: Control input or audio status.
// - `Allowed`: Current source membership predicate for queue navigation.
// ## Returns
// The updated strip state and optional ordered session request.
public function Apply(Current: M.State; Message: M.Msg; Allowed: function(Tracks.Entry): bool): M.Transition;
requires Current.Index >= -1;
begin
  const Track: Tracks.Entry? := M.Track(Current);
  const Station: Radio.Station? := Current.Station;
  const Revision: long := Current.Revision + 1L;
  case Message of
    when M.Msg.Play(
      const Queue: I.ImmutableArray of Tracks.Entry,
      const Index: int,
      const Source: Music.Selection
    ):
      if Index >= 0 and Index < Queue.Length then
        const Selected: M.State := Current with
          Queue := Queue;
          Source := Source;
          Playing := true;
          Error := null;
          Podcast := false;
          Cover := null;
        end with;
        const Slot: int := AvailableIndex(Selected, Index, 1, Allowed);
        if Slot >= 0 then
          return Start(Selected, Slot);
        end if;

        return Idle(Current);
      end if;
    when M.Msg.PlayEpisodes(
      const Queue: I.ImmutableArray of Tracks.Entry,
      const Index: int,
      const Cover: Images.Bitmap?
    ):
      if Index >= 0 and Index < Queue.Length then
        return Start(
          Current with
            Queue := Queue;
            Source := new Music.Selection();
            Playing := true;
            Error := null;
            Podcast := true;
            Cover := Cover;
            Fingerprint := null;
          end with, Index
        );
      end if;
    when M.Msg.EpisodeReady(const Token: long, const Path: string):
      if Current.Podcast and Current.Buffering and Token = Current.Revision then
        return new M.Transition(
          Current with
            EpisodePath := Path;
            Buffering := false;
            WaveformKey := Path;
            WaitingForAudio := Current.Playing;
          end with, M.Request.Load(Path, Current.Playing, Token)
        );
      end if;
    when M.Msg.EpisodeFailed(const Token: long, const Reason: string):
      if Current.Podcast and Current.Buffering and Token = Current.Revision then
        return new M.Transition(
          Current with
            Error := Reason;
            Buffering := false;
            Playing := false;
            Finished := true;
          end with
        );
      end if;
    when M.Msg.PlayStation(const Selected: Radio.Station):
      if Station <> null and Station.Id = Selected.Id and Current.Playing then
        return Live.Stop(Current);
      end if;

      return Live.Start(Current, Selected);
    when M.Msg.SourceLost(const Advance: bool):
      if Advance and Track <> null then
        const Slot: int := AvailableIndex(Current, Current.Index + 1, 1, Allowed);
        if Slot >= 0 then
          const Selected: M.Transition := Start(Current, Slot);
          if Current.NeedsOpen and not Current.Playing then
            return new M.Transition(
              Selected.Model with
                NeedsOpen := true;
                WaveformKey := WaveformKey(Current.Queue[Slot]);
              end with, M.Request.Unload
            );
          end if;

          return Selected;
        end if;
      end if;

      return Idle(Current);
    when M.Msg.Toggle:
      if Station <> null then
        if Current.Playing then
          return Live.Stop(Current);
        end if;

        return Live.Start(Current, Station);
      end if;

      if Track <> null then
        if Current.Podcast and Current.EpisodePath = '' then
          if Current.Buffering and Current.Playing then
            return new M.Transition(
              Current with
                Playing := false;
                Buffering := false;
                Revision := Revision;
              end with, M.Request.Unload
            );
          end if;

          return Start(
            Current with
              Playing := true;
              Error := null;
            end with, Current.Index
          );
        end if;
        const Next: M.State := Current with
          Playing := not Current.Playing;
          Error := null;
        end with;
        if Current.Finished then
          return Start(Next, Current.Index);
        end if;

        if Current.NeedsOpen then
          return new M.Transition(
            SelectWaveform(Next, Track) with
              NeedsOpen := false;
              Revision := Revision;
            end with, M.Request.Resume(Track.Path, Current.Position, Revision)
          );
        end if;

        return new M.Transition(
          (if Current.Podcast then
            Next
          else
            SelectWaveform(Next, Track)
          end if) with
            Revision := Revision;
          end with, M.Request.Transport(Next.Playing, Revision)
        );
      end if;
    when M.Msg.Previous:
      if Track <> null then
        var Slot: int := Current.Index;
        if Current.Position <= RestartAfter then
          const Earlier: int := AvailableIndex(Current, Current.Index - 1, -1, Allowed);
          if Earlier >= 0 then
            Slot := Earlier;
          end if;
        end if;

        return Start(
          Current with
            Error := null;
          end with, Slot
        );
      end if;
    when M.Msg.Next:
      const Slot: int := AvailableIndex(Current, Current.Index + 1, 1, Allowed);
      if Track <> null and Slot >= 0 then
        return Start(
          Current with
            Error := null;
          end with, Slot
        );
      end if;
    when M.Msg.Seek(const Fraction: float):
      if Track <> null and (not Current.Podcast or Current.EpisodePath <> '') then
        const Milliseconds: double := cast Clamp(Fraction, 0.0F, 1.0F) as double * Current.Duration;
        return new M.Transition(
          Current with
            Position := Milliseconds;
            Revision := Revision;
            Finished := false;
          end with,
          if Current.NeedsOpen then
            null
          else
            M.Request.Position(Milliseconds, Revision)
          end if
        );
      end if;
    when M.Msg.Volume(const Value: float):
      return Mix(
        Current with
          Volume := Clamp(Value, M.Quietest, 0.0F);
        end with
      );
    when M.Msg.Gain(const Band: int, const Value: float):
      if Band >= 0 and Band < Current.Gains.Length then
        return Mix(
          Current with
            Gains := Current.Gains.SetItem(Band, Clamp(Value, -M.Boost, M.Boost));
          end with
        );
      end if;
    when M.Msg.Flatten:
      return Apply(Current, M.Msg.Preset(0), Allowed);
    when M.Msg.ShowPresets(const Open: bool):
      return new M.Transition(
        Current with
          PresetsOpen := Open;
        end with
      );
    when M.Msg.Preset(const Index: int):
      if Index >= 0 and Index < Presets.Choices.Length then
        return Mix(
          Current with
            Gains := Presets.Choices[Index].Gains;
            PresetsOpen := false;
          end with
        );
      end if;
    when M.Msg.Fingerprinted(const Result: Fp.State):
      if Fp.Matches(Result, Track) and Fp.Matches(Current.Fingerprint, Track) then
        return new M.Transition(
          Current with
            Fingerprint := Result;
          end with
        );
      end if;
    when M.Msg.Observed(const Value: Audio.PlaybackEvent):
      if Station <> null then
        return Live.Observe(Current, Station, Value);
      end if;

      return Observe(Current, Value, Allowed);
    when M.Msg.Measured(const Key: string, const Levels: array of float):
      if Key = Current.WaveformKey and Key <> '' then
        return new M.Transition(
          Current with
            Waveform := Levels;
            WaveformKey := if Levels.Length = 0 then
              ''
            else
              Key
            end if;
          end with
        );
      end if;
    when M.Msg.Unavailable(const Reason: string):
      return new M.Transition(
        Current with
          Playing := false;
          Finished := true;
          Error := Reason;
          Levels := [0.0F, 0.0F];
        end with
      );
  end case;

  return new M.Transition(Current);
end function;

end unit;
