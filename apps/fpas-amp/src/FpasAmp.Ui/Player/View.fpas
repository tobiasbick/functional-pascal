// [Documentation](../../../doc/desktop.md#playback-and-analysis)

// Mixing-desk player strip: track, transport, ten-band equalizer, volume,
// level meters and a seekable position bar.
unit FpasAmp.Ui.Player.View;

uses
  FpasAmp.Ui.Player.Model as M, FpasAmp.Library.Metadata.Model as Tracks,
  FpasAmp.Ui.Albums.Music.Browse as Browse, FpasAmp.Ui.Player.Presets as Presets,
  Fpas.Ui.Widgets.Overlays.Popovers as Popovers, Fpas.Ui.Widgets.Overlays.Menus as Menus,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S,
  Fpas.Ui.Widgets.Actions.Buttons as Buttons, Fpas.Ui.Widgets.Actions.IconButtons as Icons,
  Fpas.Ui.Widgets.Audio.Faders as Faders,
  Fpas.Ui.Widgets.Audio.LevelMeters as Meters, Fpas.Ui.Widgets.Audio.Waveforms as Waves,
  Fpas.Ui.Widgets.Display.Texts as Texts, System as Sys, System.Collections.Generic as C,
  FpasAmp.Ui.Radio.Model as Radio;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
const FaderLength: int := 64;
const Baseline: array of float := [0.0F];

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function Fixed(Width: int): L.Flex;
begin
  return new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(Width)));
end function;

function Glyph(Code: int): string;
begin
  return Sys.Char.ConvertFromUtf32(Code);
end function;

function Divider(): E.Element<M.Msg>;
begin
  return E.Size<M.Msg>(E.Styled<M.Msg>(E.Column<M.Msg>(), S.Role.Divider), Fixed(1));
end function;

function Artwork(Live: bool): E.Element<M.Msg>;
begin
  const Edge: L.AxisSize := new L.AxisSize(Basis := L.Extent.Fixed(L.Measure.Logical(40)));
  return E.Size<M.Msg>(
    E.Styled<M.Msg>(
      E.Column<M.Msg>(
        new L.Flow(Align := L.Alignment.Center, Justify := L.Justification.Center),
        E.Styled<M.Msg>(
          E.Text<M.Msg>(
            Glyph(
              if Live then
                $E142
              else
                $E122
              end if
            )
          ), S.Role.MutedIcon
        )
      ), S.Role.MutedPanel
    ), new L.Flex(Width := Edge, Height := Edge)
  );
end function;

function Transport(Current: M.State; Loaded: bool; Live: bool): E.Element<M.Msg>;
begin
  return E.Row<M.Msg>(
    new L.Flow(Gap := Points(4), Align := L.Alignment.Center),
    Icons.IconButton<M.Msg>(
      'player-previous', Glyph($E15F), 'Previous', M.Msg.Previous,
      new Icons.Options(ControlSize := Icons.Size.Small, Enabled := Loaded and not Live)
    ),
    Icons.IconButton<M.Msg>(
      'player-toggle', if Current.Playing then
        Glyph(
          if Live then
            $E167
          else
            $E12E
          end if
        )
      else
        Glyph($E13C)
      end if, if Current.Playing then
        if Live then
          'Stop'
        else
          'Pause'
        end if
      else
        'Play'
      end if, M.Msg.Toggle,
      new Icons.Options(Variant := S.ButtonVariant.Primary, Enabled := Loaded)
    ),
    Icons.IconButton<M.Msg>(
      'player-next', Glyph($E160), 'Next', M.Msg.Next,
      new Icons.Options(
        ControlSize := Icons.Size.Small,
        Enabled := Loaded and not Live and Current.Index + 1 < Current.Queue.Length
      )
    )
  );
end function;

function Caption(Text: string): E.Element<M.Msg>;
begin
  return E.Styled<M.Msg>(E.Styled<M.Msg>(E.Text<M.Msg>(Text), S.Role.Tabular), S.Role.Caption);
end function;

function Info(Current: M.State; Track: Tracks.Entry?): E.Element<M.Msg>;
begin
  const Station: Radio.Station? := Current.Station;
  const Title: string := if Station <> null then
    Station.Name
  elsif Track = null then
    'Nothing playing'
  else
    Browse.Title(Track)
  end if;
  const Artist: string := if Station <> null then
    if Current.NowPlaying <> '' then
      Current.NowPlaying
    else
      Station.Genre
    end if
  elsif Track = null then
    'Choose a track to play'
  else
    Browse.Artist(Track)
  end if;
  return E.Column<M.Msg>(
    new L.Flow(Gap := Points(8), Justify := L.Justification.Center),
    E.Row<M.Msg>(
      new L.Flow(Gap := Points(10), Align := L.Alignment.Center),
      Artwork(Station <> null),
      E.Size<M.Msg>(
        E.Column<M.Msg>(
          new L.Flow(Gap := Points(2)),
          E.Styled<M.Msg>(
            Texts.Text<M.Msg>(Title, Texts.Appearance.Label),
            S.Role.SingleLine
          ),
          E.Styled<M.Msg>(
            Texts.Text<M.Msg>(Current.Error ?? Artist, Texts.Appearance.Secondary),
            S.Role.SingleLine
          )
        ), Fill
      )
    ),
    E.Row<M.Msg>(
      new L.Flow(Gap := Points(10), Align := L.Alignment.Center),
      Transport(Current, Track <> null or Station <> null, Station <> null),
      Caption(
        if Station = null then
          Browse.Time(Current.Position) + ' / ' + Browse.Time(Current.Duration)
        elsif Current.Buffering then
          'Buffering…'
        elsif Current.Playing then
          '● LIVE'
        else
          'Stopped'
        end if
      )
    )
  );
end function;

function Band(Current: M.State; Index: int): E.Element<M.Msg>;
begin
  return Faders.Fader<M.Msg>(
    'player-eq-' + M.Bands[Index], M.Bands[Index], Current.Gains[Index], -M.Boost, M.Boost,
    function(Value: float): M.Msg => M.Msg.Gain(Index, Value),
    new Faders.Options(
      Step := 0.5F, UnitLabel := 'dB', HideValue := true, Length := cast<float>(FaderLength)
    )
  );
end function;

function PresetMenu(Current: M.State): E.Element<M.Msg>;
begin
  const Selected: int := Presets.Match(Current.Gains);
  const Label: string := if Selected >= 0 then
    Presets.Choices[Selected].Name
  else
    'Custom'
  end if;
  const Rows: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>();
  for Index: int := 0 to Presets.Choices.Length - 1 do
    Rows.Add(
      Buttons.Button<M.Msg>(
        'player-preset-' + Index.ToString(), Presets.Choices[Index].Name,
        M.Msg.Preset(Index), new Buttons.Options(
          Variant := S.ButtonVariant.Ghost, Selected := Selected = Index,
          ControlSize := Buttons.Size.Small, Width := L.Extent.Fill
        )
      )
    );
  end for;

  return Popovers.Popover<M.Msg>(
    'player-presets',
    Buttons.Button<M.Msg>(
      'player-eq-preset', Label, M.Msg.ShowPresets(not Current.PresetsOpen),
      new Buttons.Options(
        Variant := S.ButtonVariant.Outline, ControlSize := Buttons.Size.Small,
        IconRight := Glyph($E06D), Tooltip := 'Equalizer preset', Selected := Current.PresetsOpen
      )
    ),
    E.Column<M.Msg>(new L.Flow(Align := L.Alignment.Stretch), Rows.ToArray()),
    Current.PresetsOpen, M.Msg.ShowPresets(false),
    new Popovers.Options(Position := Menus.Placement.TopEnd, Width := 150, Padding := 4)
  );
end function;

function Equalizer(Current: M.State): E.Element<M.Msg>;
begin
  const Track: L.AxisSize := new L.AxisSize(
    Basis := L.Extent.Fixed(L.Measure.Logical(FaderLength))
  );
  const Bands: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>(
    [
      E.Size<M.Msg>(
        E.Column<M.Msg>(
          new L.Flow(Align := L.Alignment.End, Justify := L.Justification.Between),
          Caption('+12'), Caption('0'), Caption('−12')
        ), new L.Flex(Height := Track)
      )
    ]
  );
  for Index: int := 0 to M.Bands.Length - 1 do
    Bands.Add(Band(Current, Index));
  end for;

  return E.Column<M.Msg>(
    new L.Flow(Gap := Points(4)),
    E.Row<M.Msg>(
      new L.Flow(Gap := Points(8), Align := L.Alignment.Center),
      E.Size<M.Msg>(Texts.Text<M.Msg>('Equalizer', Texts.Appearance.Muted), Fill),
      PresetMenu(Current),
      Buttons.Button<M.Msg>(
        'player-eq-reset', 'Reset', M.Msg.Flatten,
        new Buttons.Options(Variant := S.ButtonVariant.Ghost, ControlSize := Buttons.Size.Small)
      )
    ),
    E.Row<M.Msg>(new L.Flow(Gap := Points(2), Align := L.Alignment.Start), Bands.ToArray())
  );
end function;

function Volume(Current: M.State): E.Element<M.Msg>;
begin
  return Faders.Fader<M.Msg>(
    'player-volume', 'Volume', Current.Volume, M.Quietest, 0.0F, M.Msg.Volume,
    new Faders.Options(Step := 0.5F, UnitLabel := 'dB', Length := cast<float>(FaderLength))
  );
end function;

function Position(Current: M.State): E.Element<M.Msg>;
begin
  const Length: double := Current.Duration;
  const Peaks: array of float := if Current.Waveform.Length > 0 then
    Current.Waveform
  else
    Baseline
  end if;
  return Waves.Waveform<M.Msg>(
    'player-position',
    Peaks,
    if Length > 0.0 then
      cast<float>(Sys.Math.Min(1.0, Current.Position / Length))
    else
      0.0F
    end if,
    M.Msg.Seek,
    new Waves.Options(Height := 44.0F, Enabled := Length > 0.0, SeekOnRelease := true)
  );
end function;

// Builds the player strip. Without a current track, it says so and disables
// the transport and position bar; the equalizer and volume stay editable.
// ## Parameters
// - `Current`: Player state.
// - `Compact`: Whether to omit the equalizer and level meters for narrow windows.
// ## Returns
// The strip, starting with a top divider.
public function Build(Current: M.State; Compact: bool): E.Element<M.Msg>;
begin
  const Track: Tracks.Entry? := M.Track(Current);
  const Controls: E.Element<M.Msg> := if Compact then
    E.Row<M.Msg>(
      new L.Flow(Gap := Points(16), Align := L.Alignment.Center),
      E.Size<M.Msg>(Info(Current, Track), Fill),
      Volume(Current)
    )
  else
    E.Row<M.Msg>(
      new L.Flow(Gap := Points(16), Align := L.Alignment.Stretch),
      E.Size<M.Msg>(Info(Current, Track), Fill),
      Divider(),
      Equalizer(Current),
      Divider(),
      E.Row<M.Msg>(
        new L.Flow(Gap := Points(12), Align := L.Alignment.Center),
        Volume(Current),
        Meters.LevelMeter<M.Msg>(
          'player-levels', Current.Levels,
          new Meters.Options(Length := cast<float>(FaderLength), Thickness := 5.0F)
        )
      )
    )
  end if;
  return E.Column<M.Msg>(
    new L.Flow(Align := L.Alignment.Stretch),
    Divider(),
    E.Column<M.Msg>(
      new L.Flow(Padding := Points(12), Gap := Points(10), Align := L.Alignment.Stretch),
      Controls,
      if Current.Station = null then
        Position(Current)
      else
        E.Row<M.Msg>()
      end if
    )
  );
end function;

end unit;
