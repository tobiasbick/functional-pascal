// [Documentation](../../../doc/podcasts.md#implementation)

unit FpasAmp.Ui.Podcasts.Directory;

uses FpasAmp.Ui.Podcasts.DirectoryData as Payload;
uses FpasAmp.Ui.Podcasts.Model as M;
uses FpasAmp.Ui.Podcasts.Network as Network;
uses System as Sys;
uses System.Globalization as G;
uses System.IO as IO;
uses System.Net.Http as H;
uses System.Text.Json as J;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

const Gate: T.SemaphoreSlim := new T.SemaphoreSlim(1);
const ChartSize: int := 100;

var NextSearch: long := 0L;

async function Read(Address: string; Stop: T.CancellationToken): Tasks.Task of J.JsonDocument;
begin
  using const Deadline: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
    Stop
  );
  Deadline.CancelAfter(15000);
  using const Reply: H.HttpResponseMessage := await Network.Client.GetAsync(
    Address, H.HttpCompletionOption.ResponseHeadersRead, Deadline.Token
  ).ConfigureAwait(false);
  discard Reply.EnsureSuccessStatusCode();
  using const Input: IO.Stream := await Reply.Content.ReadAsStreamAsync(
    Deadline.Token
  ).ConfigureAwait(false);
  using const Data: IO.MemoryStream := new IO.MemoryStream();
  await Network.Copy(Input, Data, 4000000L, Deadline.Token).ConfigureAwait(false);
  Data.Position := 0L;
  return await J.JsonDocument.ParseAsync(
    Data,
    new J.JsonDocumentOptions(),
    Deadline.Token
  ).ConfigureAwait(false);
end function;

async function Store(Address: string; Stop: T.CancellationToken): Tasks.Task of J.JsonDocument;
begin
  await Gate.WaitAsync(Stop).ConfigureAwait(false);
  try
    const Wait: long := NextSearch - Sys.Environment.TickCount64;
    if Wait > 0L then
      await Tasks.Task.Delay(cast Wait as int, Stop).ConfigureAwait(false);
    end if;

    NextSearch := Sys.Environment.TickCount64 + 3200L;
    return await Read(Address, Stop).ConfigureAwait(false);
  finally
    discard Gate.Release();
  end try;
end function;

// Searches the Apple storefront for public RSS-backed shows.
// ## Parameters
// - `Market`: Nonempty Apple storefront country code.
// - `Term`: Nonempty search text.
// - `Stop`: Cancels both the rate-limit wait and the request.
// ## Returns
// Up to 30 unique show results in Apple order.
public async function Search(Market: string; Term: string; Stop: T.CancellationToken): Tasks.Task of array of M.Show;
requires Market <> '' and Term <> '';
begin
  const Address: string := 'https://itunes.apple.com/search?media=podcast&entity=podcast&limit=30&country=' +
    Sys.Uri.EscapeDataString(Market) + '&term=' + Sys.Uri.EscapeDataString(Term.Trim());
  using const Result: J.JsonDocument := await Store(Address, Stop).ConfigureAwait(false);
  return Payload.Search(Result.RootElement);
end function;

async function Chart(Market: string; Genre: string; Stop: T.CancellationToken): Tasks.Task of array of long;
begin
  const Country: string := Sys.Uri.EscapeDataString(Market.ToLowerInvariant());
  const Limit: string := ChartSize.ToString(G.CultureInfo.InvariantCulture);
  const ByGenre: bool := Genre <> '';
  using const Response: J.JsonDocument := if ByGenre then
    await Store(
      'https://itunes.apple.com/' + Country + '/rss/toppodcasts/limit=' + Limit +
      '/genre=' + Sys.Uri.EscapeDataString(Genre) + '/json', Stop
    ).ConfigureAwait(false)
  else
    await Read(
      'https://rss.marketingtools.apple.com/api/v2/' + Country + '/podcasts/top/' +
      Limit + '/podcasts.json', Stop
    ).ConfigureAwait(false)
  end if;
  return Payload.Chart(Response.RootElement, ByGenre, ChartSize);
end function;

// Loads Apple podcast chart entries and resolves their feed addresses.
// ## Parameters
// - `Market`: Nonempty Apple storefront country code.
// - `Genre`: Apple genre identifier, or empty for all genres.
// - `Stop`: Cancels the chart and lookup requests and rate-limit waits.
// ## Returns
// Up to 100 unique RSS shows in chart order.
public async function Discover(Market: string; Genre: string; Stop: T.CancellationToken): Tasks.Task of array of M.Show;
requires Market <> '';
begin
  const Ranked: array of long := await Chart(Market, Genre, Stop).ConfigureAwait(false);
  if Ranked.Length = 0 then
    return [];
  end if;

  const Ids: string := Sys.String.Join of long(',', Ranked);
  using const Result: J.JsonDocument := await Store(
    'https://itunes.apple.com/lookup?country=' +
    Sys.Uri.EscapeDataString(Market) + '&entity=podcast&id=' + Ids, Stop
  ).ConfigureAwait(false);
  return Payload.Lookup(Result.RootElement, Ranked);
end function;

end unit;
