// [Documentation](../../../doc/podcasts.md#implementation)

unit FpasAmp.Ui.Podcasts.Downloads;

uses FpasAmp.Ui.Podcasts.Network as Network;
uses System as Sys;
uses System.IO as IO;
uses System.Net.Http as H;
uses System.Net.Http.Headers as Headers;
uses System.Security.Cryptography as Crypto;
uses System.Text as Text;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

const MaxAudio: long := 536870912L;

// Creates a private temporary directory when the first episode needs a local file.
// ## Returns
// The directory that owns the session's downloaded episode files.
public function Workspace(): IO.DirectoryInfo;
begin
  return IO.Directory.CreateTempSubdirectory('fpas-amp-podcasts-');
end function;

// Downloads one audio enclosure for the finite file decoder.
// ## Parameters
// - `Cache`: Session directory owning downloaded episodes.
// - `Url`: Nonempty absolute media address.
// - `Codec`: Optional hint for choosing the file suffix.
// - `Stop`: Cancels the media transfer.
// ## Returns
// The path of a complete downloaded or cached file.
public async function Prepare(
  Cache: IO.DirectoryInfo;
  Url: string;
  Codec: string;
  Stop: T.CancellationToken
): Tasks.Task of string;
requires Url <> '';
begin
  const Key: string := Sys.Convert.ToHexString(
    Crypto.SHA256.HashData(Text.Encoding.UTF8.GetBytes(Url))
  );
  const Hint: string := Network.Extension(Url, 'audio/' + Codec);
  if Hint <> '' then
    const Cached: string := IO.Path.Combine(Cache.FullName, Key + Hint);
    if IO.File.Exists(Cached) then
      return Cached;
    end if;
  end if;

  using const Deadline: T.CancellationTokenSource := T.CancellationTokenSource.CreateLinkedTokenSource(
    Stop
  );
  Deadline.CancelAfter(Sys.TimeSpan.FromMinutes(5.0));
  using const Reply: H.HttpResponseMessage := await Network.Client.GetAsync(
    Url,
    H.HttpCompletionOption.ResponseHeadersRead,
    Deadline.Token
  ).ConfigureAwait(false);
  discard Reply.EnsureSuccessStatusCode();
  if (Reply.Content.Headers.ContentLength ?? 0L) > MaxAudio then
    raise new IO.InvalidDataException('The episode exceeds the 512 MiB download limit.');
  end if;
  const Header: Headers.MediaTypeHeaderValue? := Reply.Content.Headers.ContentType;
  const ContentType: string := if Header <> null then
    Header.MediaType ?? ''
  else
    ''
  end if;
  const Extension: string := Network.Extension(
    Network.ResponseAddress(Reply, Url).AbsoluteUri,
    ContentType
  );
  const Suffix: string := if Extension <> '' then
    Extension
  else
    Hint
  end if;
  if Suffix = '' then
    raise new IO.InvalidDataException('The episode uses an unsupported audio format.');
  end if;
  const Path: string := IO.Path.Combine(Cache.FullName, Key + Suffix);
  const Partial: string := Path + '.' + Sys.Guid.NewGuid().ToString('N') + '.part';
  try
    begin
      using const Input: IO.Stream := await Reply.Content.ReadAsStreamAsync(
        Deadline.Token
      ).ConfigureAwait(false);
      using const Output: IO.FileStream := new IO.FileStream(
        Partial,
        IO.FileMode.CreateNew,
        IO.FileAccess.Write,
        IO.FileShare.Delete,
        65536,
        true
      );
      await Network.Copy(Input, Output, MaxAudio, Deadline.Token).ConfigureAwait(false);
      if Output.Length = 0L then
        raise new IO.InvalidDataException('The episode has no audio data.');
      end if;
    end;

    Deadline.Token.ThrowIfCancellationRequested();
    try
      IO.File.Move(Partial, Path);
    catch Exists: IO.IOException when IO.File.Exists(Path) do
    end try;

    return Path;
  finally
    IO.File.Delete(Partial);
  end try;
end function;

end unit;
