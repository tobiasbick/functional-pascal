// [Documentation](../../../doc/podcasts.md#implementation)

unit FpasAmp.Ui.Podcasts.Model;

uses
  Fpas.Media.Images as Images, FpasAmp.Ui.Radio.Model as Radio,
  FpasAmp.Ui.Podcasts.Catalog as Catalog, Fpas.Ui.Widgets.Collections.Tables as Tables,
  System as Sys, System.Collections.Immutable as I,
  System.Security.Cryptography as Crypto, System.Text as Text;

// A podcast identified by its canonical RSS address.
public type Show = record
  // Validated HTTP or HTTPS feed address.
  public Url: string;
  // Show name from the feed or the search directory.
  public Title: string;
  // Show publisher when supplied by the source.
  public Publisher: string := '';
  // Optional remote artwork address.
  public Artwork: string := '';
  // Apple genre identifiers from the directory, including parent genres.
  public Genres: array of string := [];

  // Returns a stable navigation key without exposing the feed address in a route.
  public function Id(): string;
  begin
    return Sys.Convert.ToHexString(Crypto.SHA256.HashData(Text.Encoding.UTF8.GetBytes(self.Url)));
  end function;
end record;

// One playable audio item from an RSS feed.
public type Episode = record
  // Feed-local identifier, falling back to the media address.
  public Id: string;
  // Episode title shown in the table and player.
  public Title: string;
  // Validated HTTP or HTTPS enclosure URL.
  public Url: string;
  // Audio MIME type when provided by the feed.
  public MediaType: string := '';
  // Publication time, or null when unavailable.
  public Published: Sys.DateTimeOffset? := null;
  // Duration in milliseconds, or zero until the decoder knows it.
  public Duration: double := 0.0;
  // Plain-text description when supplied by the publisher.
  public Description: string := '';
end record;

// A feed's show metadata and playable episodes.
public type Feed = record
  // Show identity retained from the URL used to open it.
  public Show: Show;
  // Episodes in publisher order before applying the table sort.
  public Episodes: array of Episode;
end record;

// Which shows to include according to the user's saved subscriptions.
public type SubscriptionFilter = enum
  // Include every show.
  All;
  // Include saved shows only.
  Subscribed;
  // Include shows absent from saved subscriptions only.
  Unsubscribed;
end enum;

// Directory filters for Apple charts and searches.
public type DiscoveryFilters = record
  // Apple storefront country code.
  public Market: string := Catalog.DefaultMarket();
  // Apple genre identifier, or empty for all genres.
  public Genre: string := '';
  // Local filter for saved subscriptions.
  public Subscription: SubscriptionFilter := SubscriptionFilter.All;
end record;

// Filter choice for episodes with no publication date.
public const UnknownYear: string := 'Unknown year';

// Publication and duration filters for one feed.
public type EpisodeFilters = record
  // Publication year, UnknownYear for undated episodes or empty for all.
  public Year: string := '';
  // Duration bucket, or empty for any duration.
  public Duration: string := '';
end record;

// Retained episode controls for one feed.
public type EpisodeView = record
  // Search text.
  public Query: string := '';
  // Applied publication and duration filters.
  public Filters: EpisodeFilters := new EpisodeFilters();
  // Selected sort order.
  public Order: Tables.Sort := new Tables.Sort(1, true);
  // Vertical target in logical points.
  public Scroll: float := 0.0F;
  // Feed-local identifier of the selected episode, or empty.
  public Selection: string := '';
end record;

// Visible state for the search page, the selected show and the add-feed dialog.
public type State = record
  // Search text being edited by the user.
  public Query: string := '';
  // Apple storefront used for charts and text search.
  public Market: string := Catalog.DefaultMarket();
  // Selected Apple genre identifier, or an empty string for all genres.
  public Genre: string := '';
  // Subscription filter applied to the Apple result set.
  public Subscription: SubscriptionFilter := SubscriptionFilter.All;
  // Unapplied directory filters while the popup is open.
  public DiscoveryDraft: DiscoveryFilters? := null;
  // Last accepted unfiltered Apple response, in provider order.
  public Results: array of Show := [];
  // Search results after applying the genre filter and display order.
  public ShownResults: array of Show := [];
  // Token of the most recently submitted search.
  public SearchRevision: long := 0L;
  // Whether the search is in progress.
  public Searching: bool := false;
  // Active search term, or empty when showing charts.
  public SearchTerm: string := '';
  // Error for the search view, if any.
  public SearchError: string? := null;
  // Sort for the result grid. Column -1 preserves Apple ranking.
  public SearchOrder: Tables.Sort := new Tables.Sort(-1);
  // Keyboard selection on the search table.
  public SearchCursor: int := -1;
  // Vertical target of the directory grid.
  public SearchScroll: float := 0.0F;
  // Selected show, available from search or a persistent subscription.
  public Show: Show? := null;
  // Last accepted episodes for the selected show.
  public Episodes: array of Episode := [];
  // Episodes after applying the filters and display order.
  public ShownEpisodes: array of Episode := [];
  // Distinct publication years in the selected feed, plus UnknownYear when present.
  public Years: array of string := [];
  // Show load token, also scopes artwork replies.
  public FeedRevision: long := 0L;
  // Whether the selected feed is loading.
  public Loading: bool := false;
  // Whether a loaded manual feed should be subscribed.
  public AddOnLoad: bool := false;
  // Error for the show view or subscription save.
  public FeedError: string? := null;
  // Filter text for the selected show's episode table.
  public EpisodeFilter: string := '';
  // Active publication and duration filters.
  public AppliedEpisodes: EpisodeFilters := new EpisodeFilters();
  // Unapplied episode filters while the popup is open.
  public EpisodeDraft: EpisodeFilters? := null;
  // Sort for the episode grid, initially newest first.
  public EpisodeOrder: Tables.Sort := new Tables.Sort(1, true);
  // Keyboard selection in the current episode table.
  public EpisodeCursor: int := -1;
  // Vertical target of the episode grid.
  public EpisodeScroll: float := 0.0F;
  // Selection identity waiting for the current feed to load.
  public ResumeEpisode: string := '';
  // In-session episode controls for each visited feed, keyed by its navigation ID.
  public EpisodeViews: I.ImmutableDictionary<string, EpisodeView> := I.ImmutableDictionary<string, EpisodeView>.Empty;
  // URL being edited in the RSS dialog, or null when closed.
  public Draft: string? := null;
  // Episode whose description is open, or null.
  public Details: Episode? := null;
  // Decoded images keyed by their validated remote address.
  public Covers: I.ImmutableDictionary<string, Images.Bitmap?> := I.ImmutableDictionary<string, Images.Bitmap?>.Empty;

  // Returns whether the result table is for a submitted search term.
  public function Searched(): bool;
  begin
    return self.SearchTerm <> '';
  end function;
end record;

// Actions and detached podcast effect replies.
public type Msg = variant
  // Edit the query draft. Clearing a submitted term returns to the charts.
  Query(Value: string);
  // Submit the current filter text to Apple.
  Search(Value: string);
  // Open or dismiss the directory filter form.
  SetDiscoveryFilters(Open: bool);
  // Edit the draft Apple storefront by country code.
  Market(Value: string);
  // Edit the draft Apple genre identifier.
  Genre(Value: string);
  // Edit the draft subscription filter.
  Subscription(Value: SubscriptionFilter);
  // Reset the draft directory filters.
  ResetDiscoveryFilters;
  // Apply the draft directory filters.
  ApplyDiscoveryFilters;
  // Accept Apple matches for a specific request.
  Found(Revision: long; Shows: array of Show);
  // Report an Apple request failure.
  SearchFailed(Revision: long; Reason: string);
  // Track the selected row in the result table.
  SelectResult(Index: int; Scroll: float);
  // Set the order of podcast search results.
  SortResults(Order: Tables.Sort);
  // Open the show and request its RSS feed.
  Open(Show: Show; Subscribe: bool);
  // Return to the search results.
  Back;
  // Accept the selected show's feed.
  Loaded(Revision: long; Feed: Feed);
  // Report a feed failure for the selected request.
  FeedFailed(Revision: long; Reason: string);
  // Cache one image unless the search or feed visit that requested it is obsolete.
  Cover(Search: bool; Revision: long; Url: string; Image: Images.Bitmap);
  // Subscribe the show or remove its subscription.
  Subscribe(Show: Show; Enabled: bool);
  // Open the manual RSS dialog.
  Add;
  // Edit the manual RSS address.
  EditUrl(Url: string);
  // Close the RSS dialog.
  Cancel;
  // Validate and open the manually entered feed.
  AddFeed;
  // Filter the episode list by its displayed titles.
  Filter(Value: string);
  // Open or dismiss the episode filter form.
  SetEpisodeFilters(Open: bool);
  // Edit the draft publication year.
  EpisodeYear(Value: string);
  // Edit the draft duration bucket.
  EpisodeDuration(Value: string);
  // Reset the draft publication and duration filters.
  ResetEpisodeFilters;
  // Apply the draft publication and duration filters.
  ApplyEpisodeFilters;
  // Set the order of episodes.
  SortEpisodes(Order: Tables.Sort);
  // Change the focused episode row.
  SelectEpisode(Index: int; Scroll: float);
  // Start or toggle the selected episode in the current queue.
  Play(Episode: Episode);
  // Open or dismiss the episode details dialog.
  Details(Episode: Episode?);
end variant;

// Finds a subscription or search result by its stable identifier.
// ## Parameters
// - `Items`: Available podcast subscriptions or search results.
// - `Id`: Stable key returned by Show.Id.
// ## Returns
// The matching show, or null if unavailable.
public function Find(Items: array of Show; Id: string): Show?;
begin
  for Item: Show in Items do
    if Item.Id() = Id then
      return Item;
    end if;
  end for;

  return null;
end function;

// Normalizes a podcast HTTP address and strips its fragment.
// ## Parameters
// - `Value`: The candidate feed or artwork address.
// ## Returns
// An absolute HTTP or HTTPS URL, or an empty string for unsupported or malformed input.
public function Address(Value: string): string;
begin
  const Url: string := Radio.Address(Value);
  if Url = '' then
    return '';
  end if;

  const Builder: Sys.UriBuilder := new Sys.UriBuilder(Url);
  Builder.Fragment := '';
  return Builder.Uri.AbsoluteUri;
end function;

end unit;
