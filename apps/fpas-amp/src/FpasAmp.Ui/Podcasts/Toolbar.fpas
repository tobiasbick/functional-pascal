// [Documentation](../../../doc/podcasts.md#implementation)

unit FpasAmp.Ui.Podcasts.Toolbar;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Inputs.SearchFields as Fields;
uses Fpas.Ui.Widgets.Inputs.Selects as Select;

uses FpasAmp.Ui.Albums.Toolbar.Filters as Filters;
uses FpasAmp.Ui.Albums.Toolbar.View as Layout;
uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Collections.TableSort as Sort;
uses FpasAmp.Ui.Podcasts.Catalog as Catalog;
uses FpasAmp.Ui.Podcasts.Model as M;
uses System.Collections.Generic as C;

const Gap: L.Spacing := L.Spacing.Fixed(L.Measure.Logical(8));
const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);

function Action(Message: M.Msg): App.Msg;
begin
  return App.Msg.Podcasts(Message);
end function;

function Submit(Term: string): App.Msg;
begin
  return App.Msg.Podcasts(M.Msg.Search(Term));
end function;

function Picker(
  Id: string; Items: array of Select.Item; Choices: array of Catalog.Choice;
  Value: string; Change: function(string): M.Msg; Label: string
): E.Element of App.Msg;
begin
  return Select.Select of App.Msg(
    Id, Items, Catalog.IndexOf(Choices, Value),
    function(Index: int): App.Msg => Action(Change(Choices[Index].Code)),
    new Select.Options(Label := Label, Searchable := true)
  );
end function;

function Labels(Choices: array of Catalog.Choice): array of Select.Item;
begin
  const Items: C.List of Select.Item := new C.List of Select.Item();
  for Choice: Catalog.Choice in Choices do
    Items.Add(new Select.Item(Choice.Label));
  end for;

  return Items.ToArray();
end function;

const Markets: array of Select.Item := Labels(Catalog.Markets);
const Genres: array of Select.Item := Labels(Catalog.Genres);

function Subscription(Value: string): App.Msg;
begin
  return Action(
    M.Msg.Subscription(
      case Value of
        when 'subscribed': M.SubscriptionFilter.Subscribed;
        when 'unsubscribed': M.SubscriptionFilter.Unsubscribed;
        else M.SubscriptionFilter.All;
      end case
    )
  );
end function;

function SubscriptionChoice(Value: M.SubscriptionFilter): E.Element of App.Msg;
begin
  const Key: string := case Value of
    when M.SubscriptionFilter.Subscribed: 'subscribed';
    when M.SubscriptionFilter.Unsubscribed: 'unsubscribed';
    else '';
  end case;
  return Filters.Choice of App.Msg(
    'podcast-subscription-filter', 'Subscription', 'All podcasts', ['subscribed', 'unsubscribed'],
    Key, Subscription, ['Subscribed', 'Unsubscribed']
  );
end function;

// Renders the podcast directory toolbar.
// ## Parameters
// - `Page`: Podcast search, filter and sort state.
// - `Width`: Available width in logical points.
// ## Returns
// Search controls, a directory filter form and a sort menu.
public function Search(Page: M.State; Width: int): E.Element of App.Msg;
requires Width > 0;
begin
  const Input: E.Element of App.Msg := Fields.SearchField of App.Msg(
    'podcast-search-input', Page.Query,
    function(Value: string): App.Msg => App.Msg.Podcasts(M.Msg.Query(Value)),
    new Fields.Options(Placeholder := 'Search Apple Podcasts…'), Submit
  );
  const SubmitButton: E.Element of App.Msg := B.Button of App.Msg(
    'podcast-search-submit', if Page.Query.Trim() = '' then
      'Refresh'
    else
      'Search'
    end if,
    Submit(Page.Query), new B.Options(
      Variant := S.ButtonVariant.Primary, Enabled := not Page.Searching, Loading := Page.Searching
    )
  );
  const Draft: M.DiscoveryFilters? := Page.DiscoveryDraft;
  const Count: int := (if Page.Market <> Catalog.DefaultMarket() then
    1
  else
    0
  end if) +
    (if Page.Genre <> '' then
      1
    else
      0
    end if) + (if Page.Subscription <> M.SubscriptionFilter.All then
      1
    else
      0
    end if);
  const Panel: E.Element of App.Msg := if Draft <> null then
    Filters.Panel of App.Msg(
      'podcast', 'Filter podcasts', [
        Picker('podcast-market', Markets, Catalog.Markets, Draft.Market, M.Msg.Market, 'Market'),
        Picker('podcast-genre', Genres, Catalog.Genres, Draft.Genre, M.Msg.Genre, 'Genre'),
        SubscriptionChoice(Draft.Subscription)
      ], Action(M.Msg.ResetDiscoveryFilters), Action(M.Msg.ApplyDiscoveryFilters)
    )
  else
    E.Column of App.Msg()
  end if;
  return Layout.Arrange of App.Msg(
    E.Row of App.Msg(
      new L.Flow(Gap := Gap, Align := L.Alignment.Center, Clip := false),
      E.Size of App.Msg(Input, Fill),
      SubmitButton
    ),
    Filters.Popup of App.Msg(
      'podcast',
      Panel,
      Count,
      Draft <> null,
      function(Open: bool): App.Msg => Action(M.Msg.SetDiscoveryFilters(Open)),
      Width
    ),
    Sort.Build of App.Msg(
      'podcast-sort', ['Podcast', 'Publisher'], [true, true], Page.SearchOrder,
      function(Order: Tables.Sort): App.Msg => Action(M.Msg.SortResults(Order)), 'Apple order'
    ), Width
  );
end function;

function EpisodePanel(Page: M.State; Draft: M.EpisodeFilters): E.Element of App.Msg;
begin
  const Choices: C.List of E.Element of App.Msg := new C.List of E.Element of App.Msg();
  if Page.Years.Length > 1 then
    Choices.Add(
      Filters.Choice of App.Msg(
        'episode-filter-year', 'Publication year', 'All years', Page.Years, Draft.Year,
        function(Value: string): App.Msg => Action(M.Msg.EpisodeYear(Value))
      )
    );
  end if;

  Choices.Add(
    Filters.Choice of App.Msg(
      'episode-filter-duration', 'Duration', 'Any duration', ['short', 'medium', 'long', 'unknown'],
      Draft.Duration, function(Value: string): App.Msg => Action(M.Msg.EpisodeDuration(Value)),
      ['Under 15 minutes', '15 to under 45 minutes', '45 minutes or longer', 'Unknown duration']
    )
  );
  return Filters.Panel of App.Msg(
    'episode', 'Filter episodes', Choices.ToArray(),
    Action(M.Msg.ResetEpisodeFilters), Action(M.Msg.ApplyEpisodeFilters)
  );
end function;

// Renders the episode toolbar.
// ## Parameters
// - `Page`: Episode search, filter and sort state.
// - `Width`: Available width in logical points.
// ## Returns
// Search controls, a publication and duration filter form, and a sort menu.
public function Episodes(Page: M.State; Width: int): E.Element of App.Msg;
requires Width > 0;
begin
  const Applied: M.EpisodeFilters := Page.AppliedEpisodes;
  const Count: int := (if Applied.Year <> '' then
    1
  else
    0
  end if) + (if Applied.Duration <> '' then
    1
  else
    0
  end if);
  const Draft: M.EpisodeFilters? := Page.EpisodeDraft;
  const Panel: E.Element of App.Msg := if Draft <> null then
    EpisodePanel(Page, Draft)
  else
    E.Column of App.Msg()
  end if;
  return Layout.Arrange of App.Msg(
    Fields.SearchField of App.Msg(
      'podcast-episode-search',
      Page.EpisodeFilter,
      function(Value: string): App.Msg => Action(M.Msg.Filter(Value)),
      new Fields.Options(Placeholder := 'Search episodes…')
    ),
    Filters.Popup of App.Msg(
      'episode',
      Panel,
      Count,
      Draft <> null,
      function(Open: bool): App.Msg => Action(M.Msg.SetEpisodeFilters(Open)),
      Width
    ),
    Sort.Build of App.Msg(
      'episode-sort', ['Title', 'Published', 'Time'], [true, false, false], Page.EpisodeOrder,
      function(Order: Tables.Sort): App.Msg => Action(M.Msg.SortEpisodes(Order)), DateColumn := 1
    ), Width
  );
end function;

end unit;
