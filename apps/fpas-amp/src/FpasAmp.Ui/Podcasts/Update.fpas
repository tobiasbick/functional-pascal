// [Documentation](../../../doc/podcasts.md#implementation)

unit FpasAmp.Ui.Podcasts.Update;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Media.Images as Images;
uses Fpas.Ui.Mvu.Application as A;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses FpasAmp.Ui.Podcasts.Browse as Browse;
uses FpasAmp.Ui.Podcasts.Directory as Directory;
uses FpasAmp.Ui.Podcasts.Feeds as Feeds;
uses FpasAmp.Ui.Podcasts.Model as M;
uses FpasAmp.Ui.Podcasts.Network as Network;
uses System as Sys;
uses System.IO as IO;
uses System.Net.Http as H;
uses System.Text.Json as Json;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;
uses System.Xml as Xml;

function NetworkFailure(Error: Sys.Exception; Stop: T.CancellationToken): bool;
begin
  return Error is H.HttpRequestException or Error is IO.IOException or Error is
    IO.InvalidDataException
    or (Error is Sys.OperationCanceledException and not Stop.IsCancellationRequested);
end function;

function Search(Current: M.State; Term: string): A.Transition<M.State, M.Msg>;
  async function Run(Context: A.BackgroundContext<M.Msg>; Stop: T.CancellationToken): Tasks.Task<Fx.Outcome<Fx.Completion, M.Msg>>;
  begin
    try
      const Found: array of M.Show := if Term = '' then
        await Directory.Discover(Market, Genre, Stop).ConfigureAwait(false)
      else
        await Directory.Search(Market, Term, Stop).ConfigureAwait(false)
      end if;
      await Context.Post(M.Msg.Found(Revision, Found)).ConfigureAwait(false);
      for Show: M.Show in Found do
        const Image: Images.Bitmap? := await Network.Cover(
          Show.Artwork,
          96,
          Stop
        ).ConfigureAwait(false);
        case Image of
          when is Images.Bitmap as Bitmap:
            await Context.Post(
              M.Msg.Cover(true, Revision, Show.Artwork, Bitmap)
            ).ConfigureAwait(false);
          else
        end case;
      end for;

      return Fx.Outcome.Success(Fx.Completion.Done);
    catch Error: Sys.Exception when NetworkFailure(Error, Stop) or Error is Json.JsonException do
      return Fx.Outcome.Failure(M.Msg.SearchFailed(Revision, Error.Message));
    end try;
  end function;
begin
  const Revision: long := Current.SearchRevision + 1L;
  const Market: string := Current.Market;
  const Genre: string := Current.Genre;
  return new A.Transition<M.State, M.Msg>(
    Current with
      Searching := true;
      SearchTerm := Term;
      SearchError := null;
      SearchRevision := Revision;
      SearchCursor := -1;
      Results := [];
      ShownResults := [];
      Covers := Current.Covers.Clear();
    end with, [
      A.StartBackground<M.Msg>(
        'search',
        Fx.Effect<Fx.Completion, M.Msg, A.BackgroundContext<M.Msg>>.Defer(Run)
      )
    ]
  );
end function;

function RememberEpisodes(Current: M.State): M.State;
begin
  const Show: M.Show? := Current.Show;
  if Show = null then
    return Current;
  end if;
  const Selection: string := if Current.EpisodeCursor >= 0 and Current.EpisodeCursor <
    Current.ShownEpisodes.Length
  then
    Current.ShownEpisodes[Current.EpisodeCursor].Id
  else
    Current.ResumeEpisode
  end if;
  return Current with
    EpisodeViews := Current.EpisodeViews.SetItem(
      Show.Id(), new M.EpisodeView(
        Current.EpisodeFilter,
        Current.AppliedEpisodes,
        Current.EpisodeOrder,
        Current.EpisodeScroll,
        Selection
      )
    );
  end with;
end function;

function Open(Current: M.State; Show: M.Show; Subscribe: bool): A.Transition<M.State, M.Msg>;
  async function Run(Context: A.BackgroundContext<M.Msg>; Stop: T.CancellationToken): Tasks.Task<Fx.Outcome<Fx.Completion, M.Msg>>;
  begin
    try
      const Feed: M.Feed := await Feeds.Load(Show, Stop).ConfigureAwait(false);
      await Context.Post(M.Msg.Loaded(Revision, Feed)).ConfigureAwait(false);
      const Image: Images.Bitmap? := await Network.Cover(
        Feed.Show.Artwork,
        320,
        Stop
      ).ConfigureAwait(false);
      case Image of
        when is Images.Bitmap as Bitmap:
          await Context.Post(
            M.Msg.Cover(false, Revision, Feed.Show.Artwork, Bitmap)
          ).ConfigureAwait(false);
        else
      end case;

      return Fx.Outcome.Success(Fx.Completion.Done);
    catch Error: Sys.Exception when NetworkFailure(Error, Stop) or Error is Xml.XmlException do
      return Fx.Outcome.Failure(M.Msg.FeedFailed(Revision, Error.Message));
    end try;
  end function;
begin
  const Revision: long := Current.FeedRevision + 1L;
  const Previous: M.State := RememberEpisodes(Current);
  const Id: string := Show.Id();
  const Saved: M.EpisodeView := if Previous.EpisodeViews.ContainsKey(Id) then
    Previous.EpisodeViews[Id]
  else
    new M.EpisodeView()
  end if;
  return new A.Transition<M.State, M.Msg>(
    Previous with
      Show := Show;
      Episodes := [];
      ShownEpisodes := [];
      Years := [];
      FeedRevision := Revision;
      Loading := true;
      AddOnLoad := Subscribe;
      FeedError := null;
      EpisodeFilter := Saved.Query;
      AppliedEpisodes := Saved.Filters;
      EpisodeDraft := null;
      EpisodeOrder := Saved.Order;
      EpisodeCursor := -1;
      EpisodeScroll := Saved.Scroll;
      ResumeEpisode := Saved.Selection;
      Draft := null;
      Details := null;
    end with, [
      A.StartBackground<M.Msg>(
        'feed',
        Fx.Effect<Fx.Completion, M.Msg, A.BackgroundContext<M.Msg>>.Defer(Run)
      )
    ]
  );
end function;

// Advances the podcast directory or feed page.
// ## Parameters
// - `Current`: The current page model.
// - `Action`: A user action or a detached reply from the directory or feed worker.
// - `Subscriptions`: Saved feeds for the local subscription filter.
// ## Returns
// The new page model and any cancellable directory or feed commands.
public function Apply(Current: M.State; Action: M.Msg; Subscriptions: array of M.Show): A.Transition<M.State, M.Msg>;
begin
  var Next: M.State := Current;
  const Discovery: M.DiscoveryFilters? := Current.DiscoveryDraft;
  const Episodes: M.EpisodeFilters? := Current.EpisodeDraft;
  case Action of
    when M.Msg.Query(const Value: string):
      Next := Current with
        Query := Value;
      end with;
      if Value.Trim() = '' and Current.Searched() then
        return Search(Next, '');
      end if;
    when M.Msg.Search(const Value: string):
      return Search(
        Current with
          Query := Value;
        end with, Value.Trim()
      );
    when M.Msg.SetDiscoveryFilters(const Open: bool):
      Next := Current with
        DiscoveryDraft := if Open then
          new M.DiscoveryFilters(Current.Market, Current.Genre, Current.Subscription)
        else
          null
        end if;
      end with;
    when M.Msg.Market(const Value: string):
      if Discovery <> null then
        Next := Current with
          DiscoveryDraft := Discovery with
            Market := Value;
          end with;
        end with;
      end if;
    when M.Msg.Genre(const Value: string):
      if Discovery <> null then
        Next := Current with
          DiscoveryDraft := Discovery with
            Genre := Value;
          end with;
        end with;
      end if;
    when M.Msg.Subscription(const Value: M.SubscriptionFilter):
      if Discovery <> null then
        Next := Current with
          DiscoveryDraft := Discovery with
            Subscription := Value;
          end with;
        end with;
      end if;
    when M.Msg.ResetDiscoveryFilters:
      if Discovery <> null then
        Next := Current with
          DiscoveryDraft := new M.DiscoveryFilters();
        end with;
      end if;
    when M.Msg.ApplyDiscoveryFilters:
      if Discovery <> null then
        Next := Current with
          DiscoveryDraft := null;
          Market := Discovery.Market;
          Genre := Discovery.Genre;
          Subscription := Discovery.Subscription;
        end with;
        if Discovery.Market <> Current.Market then
          return Search(Next, Current.SearchTerm);
        end if;

        if Discovery.Genre <> Current.Genre and not Current.Searched() then
          return Search(Next, '');
        end if;

        if Discovery.Genre <> Current.Genre or Discovery.Subscription <> Current.Subscription then
          Next := Browse.SelectResults(Next, Subscriptions);
        end if;
      end if;
    when M.Msg.Found(const Revision: long, const Shows: array of M.Show):
      if Revision = Current.SearchRevision then
        Next := Browse.SelectResults(
          Current with
            Results := Shows;
            Searching := false;
          end with, Subscriptions
        );
      end if;
    when M.Msg.SearchFailed(const Revision: long, const Reason: string):
      if Revision = Current.SearchRevision then
        Next := Current with
          SearchError := Reason;
          Searching := false;
        end with;
      end if;
    when M.Msg.SelectResult(const Index: int, const Scroll: float):
      Next := Current with
        SearchCursor := Index;
        SearchScroll := Scroll;
      end with;
    when M.Msg.SortResults(const Order: Tables.Sort):
      if Order <> Current.SearchOrder and Order.Column >= -1 and Order.Column < 2 then
        Next := Browse.SelectResults(
          Current with
            SearchOrder := Order;
          end with, Subscriptions
        );
      end if;
    when M.Msg.Open(const Show: M.Show, const Subscribe: bool):
      return Open(Current, Show, Subscribe);
    when M.Msg.Back:
      return new A.Transition<M.State, M.Msg>(
        RememberEpisodes(Current) with
          Show := null;
          Episodes := [];
          ShownEpisodes := [];
          Years := [];
          EpisodeDraft := null;
          FeedRevision := Current.FeedRevision + 1L;
          Loading := false;
          AddOnLoad := false;
          Details := null;
          Draft := null;
        end with, [A.CancelBackground<M.Msg>('feed')]
      );
    when M.Msg.Loaded(const Revision: long, const Value: M.Feed):
      if Revision = Current.FeedRevision then
        Next := Browse.SelectEpisodes(
          Browse.ReconcileEpisodeFilters(
            Current with
              Show := Value.Show;
              Episodes := Value.Episodes;
              Years := Browse.Years(Value.Episodes);
              Loading := false;
              AddOnLoad := false;
              FeedError := null;
            end with
          )
        );
      end if;
    when M.Msg.FeedFailed(const Revision: long, const Reason: string):
      if Revision = Current.FeedRevision then
        Next := Current with
          FeedError := Reason;
          Loading := false;
        end with;
      end if;
    when M.Msg.Cover(
      const SearchImage: bool,
      const Revision: long,
      const Url: string,
      const Image: Images.Bitmap
    ):
      if (SearchImage and Revision = Current.SearchRevision) or (not SearchImage and Revision =
        Current.FeedRevision)
      then
        var Previous: Images.Bitmap? := null;
        discard Current.Covers.TryGetValue(Url, out Previous);
        const Width: int := case Previous of
          when is Images.Bitmap as Bitmap: Bitmap.Width;
          else 0;
        end case;
        if Width < Image.Width then
          Next := Current with
            Covers := Current.Covers.SetItem(Url, Image);
          end with;
        end if;
      end if;
    when M.Msg.Add:
      Next := Current with
        Draft := '';
      end with;
    when M.Msg.EditUrl(const Url: string):
      Next := Current with
        Draft := Url;
      end with;
    when M.Msg.Cancel:
      Next := Current with
        Draft := null;
      end with;
    when M.Msg.Filter(const Value: string):
      Next := Browse.SelectEpisodes(
        Current with
          EpisodeFilter := Value;
        end with
      );
    when M.Msg.SetEpisodeFilters(const Open: bool):
      Next := Current with
        EpisodeDraft := if Open then
          Current.AppliedEpisodes
        else
          null
        end if;
      end with;
    when M.Msg.EpisodeYear(const Value: string):
      if Episodes <> null then
        Next := Current with
          EpisodeDraft := Episodes with
            Year := Value;
          end with;
        end with;
      end if;
    when M.Msg.EpisodeDuration(const Value: string):
      if Episodes <> null then
        Next := Current with
          EpisodeDraft := Episodes with
            Duration := Value;
          end with;
        end with;
      end if;
    when M.Msg.ResetEpisodeFilters:
      if Episodes <> null then
        Next := Current with
          EpisodeDraft := new M.EpisodeFilters();
        end with;
      end if;
    when M.Msg.ApplyEpisodeFilters:
      if Episodes <> null then
        Next := Browse.SelectEpisodes(
          Browse.ReconcileEpisodeFilters(
            Current with
              AppliedEpisodes := Episodes;
              EpisodeDraft := null;
            end with
          )
        );
      end if;
    when M.Msg.SortEpisodes(const Order: Tables.Sort):
      if Order <> Current.EpisodeOrder and Order.Column >= 0 and Order.Column < 3 then
        Next := Browse.SelectEpisodes(
          Current with
            EpisodeOrder := Order;
          end with
        );
      end if;
    when M.Msg.SelectEpisode(const Index: int, const Scroll: float):
      Next := Current with
        EpisodeCursor := Index;
        EpisodeScroll := Scroll;
      end with;
    when M.Msg.Details(const Item: M.Episode?):
      Next := Current with
        Details := Item;
      end with;
    else
  end case;

  return new A.Transition<M.State, M.Msg>(Next, []);
end function;

end unit;
