// [Documentation](../../../doc/podcasts.md#implementation)

unit FpasAmp.Ui.Podcasts.View;

uses Fpas.Media.Images as Images;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icons;
uses Fpas.Ui.Widgets.Collections.DataGrids as Grid;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Containers.EmptyStates as Empty;
uses Fpas.Ui.Widgets.Desktop.StatusBars as Status;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Feedback.Alerts as Alerts;
uses Fpas.Ui.Widgets.Inputs.TextFields as Fields;
uses Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;

uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Ui.Albums.Artwork as Artwork;
uses FpasAmp.Ui.Albums.Music.Browse as Time;
uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Player.Model as Player;
uses FpasAmp.Ui.Podcasts.Model as M;
uses FpasAmp.Ui.Podcasts.Toolbar as Toolbar;
uses System as Sys;
uses System.Collections.Generic as C;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
const Stretch: L.Flow := new L.Flow(Align := L.Alignment.Stretch);

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function Fixed(Value: int): L.Flex;
begin
  return new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(Value)));
end function;

function Action(Message: M.Msg): App.Msg;
begin
  return App.Msg.Podcasts(Message);
end function;

function Image(Page: M.State; Show: M.Show; Id: string; Edge: int): E.Element of App.Msg;
begin
  var Cover: Images.Bitmap? := null;
  discard Page.Covers.TryGetValue(Show.Artwork, out Cover);
  return Artwork.Build of App.Msg(Id, Cover, Edge);
end function;

function Error(Id: string; Message: string?): E.Element of App.Msg;
begin
  return if Message <> null then
    Alerts.Alert of App.Msg(
      Id,
      'Podcast operation failed',
      new Alerts.Options(Tone := S.Tone.Warning, Description := Message)
    )
  else
    E.Row of App.Msg()
  end if;
end function;

function Result(Current: App.State; Show: M.Show): Grid.Row of App.Msg;
begin
  const Key: string := Show.Id();
  const Subscribed: bool := M.Find(Current.Settings.Saved.PodcastSubscriptions, Key) <> null;
  return new Grid.Row of App.Msg(
    Key, [
      (Grid.Cell of App.Msg).Content(
        [
          E.Row of App.Msg(
            new L.Flow(Gap := Points(6), Align := L.Alignment.Center),
            Image(Current.Podcasts, Show, 'podcast-result-cover-' + Key, 38),
            B.Button of App.Msg(
              'podcast-open-' + Key, Show.Title, Action(M.Msg.Open(Show, false)),
              new B.Options(Variant := S.ButtonVariant.Ghost, Tooltip := Show.Title)
            )
          )
        ]
      ),
      (Grid.Cell of App.Msg).Text(Show.Publisher),
      if Subscribed then
        (Grid.Cell of App.Msg).Text('Subscribed')
      else
        (Grid.Cell of App.Msg).Content(
          [
            B.Button of App.Msg(
              'podcast-subscribe-' + Key, 'Subscribe', Action(M.Msg.Subscribe(Show, true)),
              new B.Options(Variant := S.ButtonVariant.Outline, ControlSize := B.Size.Small)
            )
          ]
        )
      end if
    ]
  );
end function;

function Results(Current: App.State; Shows: array of M.Show; Width: int): E.Element of App.Msg;
  function Change(Value: Grid.Value): App.Msg;
  begin
    const Order: Tables.Sort? := Value.Order;
    return if Order <> null and Order <> Current.Podcasts.SearchOrder then
      Action(M.Msg.SortResults(Order))
    else
      Action(M.Msg.SelectResult(Value.Cursor, Value.Scroll ?? 0.0F))
    end if;
  end function;
begin
  const Page: M.State := Current.Podcasts;
  if Shows.Length = 0 then
    const Text: string := if Page.Searching and not Page.Searched() then
      'Loading top podcasts…'
    elsif Page.Searching then
      'Searching Apple Podcasts…'
    elsif Page.SearchError <> null then
      'Podcast directory unavailable'
    elsif Page.Searched() then
      'No matching podcasts'
    else
      'No top podcasts available'
    end if;
    return Empty.EmptyState of App.Msg('podcasts-empty', Text);
  end if;
  const Publisher: int := Sys.Math.Clamp(Width div 3, 120, 300);
  return Grid.DataGrid of App.Msg(
    'podcast-results',
    [
      new Grid.Column(
        'Podcast',
        cast Sys.Math.Max(112, Width - Publisher - 124) as float,
        Sortable := true
      ),
      new Grid.Column('Publisher', cast Publisher as float, Sortable := true, Priority := 1),
      new Grid.Column('', 124.0F, Fixed := true)
    ],
    Shows.Length,
    function(Index: int): Grid.Row of App.Msg => Result(Current, Shows[Index]),
    new Grid.Value(
      Order := Page.SearchOrder,
      Cursor := Page.SearchCursor,
      Anchor := Page.SearchCursor,
      Scroll := Page.SearchScroll
    ),
    Change,
    new Grid.Options(RowHeight := 52.0F, HideCheckboxes := true),
    function(Index: int): App.Msg => Action(M.Msg.Open(Shows[Index], false))
  );
end function;

function AddFeed(Base: E.Element of App.Msg; Draft: string): E.Element of App.Msg;
begin
  return Dialogs.Dialog of App.Msg(
    'podcast-add-dialog',
    Base,
    E.Column of App.Msg(
      new L.Flow(Align := L.Alignment.Stretch, Gap := Points(12)),
      Fields.TextField of App.Msg(
        'podcast-feed-url', Draft, function(Value: string): App.Msg => Action(M.Msg.EditUrl(Value)),
        new Fields.Options(Label := 'RSS feed URL', MaxUtf8Bytes := 2047)
      ),
      E.Row of App.Msg(
        new L.Flow(Gap := Points(8), Justify := L.Justification.End),
        B.Button of App.Msg('podcast-feed-cancel', 'Cancel', Action(M.Msg.Cancel)),
        B.Button of App.Msg(
          'podcast-feed-add', 'Subscribe', Action(M.Msg.AddFeed),
          new B.Options(Variant := S.ButtonVariant.Primary, Enabled := M.Address(Draft) <> '')
        )
      )
    ),
    true,
    new Dialogs.Options('Add RSS feed', InitialFocus := 'podcast-feed-url'),
    Action(M.Msg.Cancel)
  );
end function;

// Shows Apple charts, text search and subscription actions.
// ## Parameters
// - `Current`: Application state containing directory results and preferences.
// - `Width`: Available width in logical points.
// - `Padding`: Inner content padding in logical points.
// ## Returns
// The podcast directory page.
public function Search(Current: App.State; Width: int; Padding: int): E.Element of App.Msg;
begin
  const Page: M.State := Current.Podcasts;
  const Shows: array of M.Show := Page.ShownResults;
  const Count: string := if Shows.Length <> Page.Results.Length then
    Shows.Length.ToString() + ' of ' + Page.Results.Length.ToString() + ' podcasts'
  elsif Shows.Length = 1 then
    '1 podcast'
  else
    Shows.Length.ToString() + ' podcasts'
  end if;
  const ContentWidth: int := Sys.Math.Max(1, Width - Padding * 2);
  const Parts: C.List of E.Element of App.Msg := new C.List of E.Element of App.Msg(
    [
      E.Row of App.Msg(
        new L.Flow(Gap := Points(8), Align := L.Alignment.Center, Wrap := true),
        E.Size of App.Msg(
          Texts.Text of App.Msg('Search podcasts', Texts.Appearance.HeadingOne),
          Fill
        ),
        B.Button of App.Msg(
          'podcast-add', 'Add RSS feed', Action(M.Msg.Add),
          new B.Options(Variant := S.ButtonVariant.Outline)
        )
      ), Toolbar.Search(Page, ContentWidth)
    ]
  );
  if Page.SearchError <> null then
    Parts.Add(Error('podcast-search-error', Page.SearchError));
  end if;

  if not Page.Searched() then
    Parts.Add(Texts.Text of App.Msg('Top podcasts', Texts.Appearance.HeadingThree));
  end if;

  Parts.Add(E.Size of App.Msg(Results(Current, Shows, ContentWidth), Fill));
  const Body: E.Element of App.Msg := E.Column of App.Msg(
    Stretch,
    E.Size of App.Msg(
      E.Column of App.Msg(
        new L.Flow(Padding := Points(Padding), Gap := Points(16), Align := L.Alignment.Stretch),
        Parts.ToArray()
      ), Fill
    ),
    Status.StatusBar of App.Msg(
      'podcast-search-status',
      [(Status.Item of App.Msg).Text(new Status.Label(Count))]
    )
  );
  const Draft: string? := Page.Draft;
  return if Draft <> null then
    AddFeed(Body, Draft)
  else
    Body
  end if;
end function;

function EpisodeRow(Current: App.State; ShowId: string; Item: M.Episode): Grid.Row of App.Msg;
begin
  const Active: Tracks.Entry? := Player.Track(Current.Player);
  const Selected: bool := Current.Player.Podcast and Active <> null and Active.TrackId = ShowId +
    ':' + Item.Id;
  const Playing: bool := Selected and Current.Player.Playing;
  const Play: E.Element of App.Msg := Icons.IconButton of App.Msg(
    'episode-play-' + Item.Id,
    Sys.Char.ConvertFromUtf32(
      if Playing then
        $E12E
      else
        $E13C
      end if
    ),
    if Playing then
      'Pause ' + Item.Title
    else
      'Play ' + Item.Title
    end if, Action(M.Msg.Play(Item)),
    new Icons.Options(
      Variant := if Selected then
        S.ButtonVariant.Primary
      else
        S.ButtonVariant.Ghost
      end if, ControlSize := Icons.Size.Small
    )
  );
  const Date: Sys.DateTimeOffset? := Item.Published;
  return new Grid.Row of App.Msg(
    Item.Id, [
      (Grid.Cell of App.Msg).Content(
        [
          E.Row of App.Msg(
            new L.Flow(Gap := Points(8), Align := L.Alignment.Center), Play,
            E.Styled of App.Msg(
              Texts.Text of App.Msg(Item.Title, Texts.Appearance.Label),
              S.Role.SingleLine
            )
          )
        ]
      ),
      (Grid.Cell of App.Msg).Text(
        if Date <> null then
          Date.Value.ToString('d')
        else
          '—'
        end if
      ),
      (Grid.Cell of App.Msg).Text(
        if Item.Duration > 0.0 then
          Time.Time(Item.Duration)
        else
          '—'
        end if
      ),
      (Grid.Cell of App.Msg).Content(
        [
          Menus.Menu of App.Msg(
            'episode-menu-' + Item.Id, 'More actions for ' + Item.Title,
            [
              (Menus.Entry of App.Msg).Action(
                new Menus.Item of App.Msg('details', 'Episode details', Action(M.Msg.Details(Item)))
              )
            ],
            new Menus.Options(IconOnly := true, Position := Menus.Placement.BottomEnd)
          )
        ]
      )
    ]
  );
end function;

function EpisodeGrid(
  Current: App.State;
  Show: M.Show;
  Items: array of M.Episode;
  Width: int
): E.Element of App.Msg;
  function Change(Value: Grid.Value): App.Msg;
  begin
    const Order: Tables.Sort? := Value.Order;
    return if Order <> null and Order <> Current.Podcasts.EpisodeOrder then
      Action(M.Msg.SortEpisodes(Order))
    else
      Action(M.Msg.SelectEpisode(Value.Cursor, Value.Scroll ?? 0.0F))
    end if;
  end function;
begin
  const Page: M.State := Current.Podcasts;
  if Items.Length = 0 then
    return Empty.EmptyState of App.Msg(
      'podcast-episodes-empty', if Page.Loading then
        'Loading episodes…'
      elsif Page.Episodes.Length > 0 then
        'No matching episodes'
      else
        'No playable episodes'
      end if
    );
  end if;
  const Key: string := Show.Id();
  return Grid.DataGrid of App.Msg(
    'podcast-episodes/' + Key,
    [
      new Grid.Column('Title', cast Sys.Math.Max(96, Width - 236) as float, Sortable := true),
      new Grid.Column('Published', 116.0F, Sortable := true, Priority := 1),
      new Grid.Column('Time', 76.0F, Sortable := true, Priority := 2),
      new Grid.Column('', 44.0F, Fixed := true)
    ],
    Items.Length,
    function(Index: int): Grid.Row of App.Msg => EpisodeRow(Current, Key, Items[Index]),
    new Grid.Value(
      Order := Page.EpisodeOrder,
      Cursor := Page.EpisodeCursor,
      Anchor := Page.EpisodeCursor,
      Scroll := Page.EpisodeScroll
    ),
    Change,
    new Grid.Options(RowHeight := 40.0F, HideCheckboxes := true),
    function(Index: int): App.Msg => Action(M.Msg.Play(Items[Index]))
  );
end function;

function Details(Body: E.Element of App.Msg; Item: M.Episode): E.Element of App.Msg;
begin
  return Dialogs.Dialog of App.Msg(
    'podcast-episode-info', Body,
    E.Size of App.Msg(
      E.ScrollView of App.Msg(
        'podcast-episode-description', Texts.Text of App.Msg(
          if Item.Description = '' then
            'No description provided.'
          else
            Item.Description
          end if, Texts.Appearance.Body
        )
      ),
      Fixed(210)
    ),
    true, new Dialogs.Options(Item.Title), Action(M.Msg.Details(null))
  );
end function;

// Shows the selected podcast with its artwork and episode table.
// ## Parameters
// - `Current`: Application state containing the selected feed and playback.
// - `Width`: Available width in logical points.
// - `Padding`: Inner content padding in logical points.
// ## Returns
// The selected podcast page.
public function Podcast(Current: App.State; Width: int; Padding: int): E.Element of App.Msg;
begin
  const Page: M.State := Current.Podcasts;
  const Show: M.Show? := Page.Show;
  if Show = null then
    return Search(Current, Width, Padding);
  end if;
  const Compact: bool := Width < 650;
  const Edge: int := if Compact then
    58
  else
    Sys.Math.Clamp((Width - 540) div 2, 112, 190)
  end if;
  const Subscribed: bool := M.Find(Current.Settings.Saved.PodcastSubscriptions, Show.Id()) <> null;
  const Info: E.Element of App.Msg := E.Column of App.Msg(
    new L.Flow(Gap := Points(6), Align := L.Alignment.Start),
    E.Styled of App.Msg(
      Texts.Text of App.Msg(Show.Title, Texts.Appearance.HeadingTwo),
      S.Role.SingleLine
    ),
    E.Styled of App.Msg(
      Texts.Text of App.Msg(Show.Publisher, Texts.Appearance.Secondary),
      S.Role.SingleLine
    ),
    B.Button of App.Msg(
      'podcast-subscription',
      if Subscribed then
        'Unsubscribe'
      else
        'Subscribe'
      end if,
      Action(M.Msg.Subscribe(Show, not Subscribed)),
      new B.Options(Variant := S.ButtonVariant.Outline, ControlSize := B.Size.Small)
    )
  );
  const Cover: E.Element of App.Msg := Image(Page, Show, 'podcast-cover', Edge);
  const Items: array of M.Episode := Page.ShownEpisodes;
  const Inset: int := Edge + Padding * 2;
  const TableWidth: int := Width - Padding * 2 - if Compact then
    0
  else
    Inset + 1
  end if;
  const Parts: C.List of E.Element of App.Msg := new C.List of E.Element of App.Msg(
    [
      Toolbar.Episodes(Page, Sys.Math.Max(1, TableWidth))
    ]
  );
  if Page.FeedError <> null then
    Parts.Add(Error('podcast-feed-error', Page.FeedError));
    if Page.Episodes.Length = 0 then
      Parts.Add(
        B.Button of App.Msg('podcast-feed-retry', 'Retry', Action(M.Msg.Open(Show, Page.AddOnLoad)))
      );
    end if;
  end if;

  Parts.Add(E.Size of App.Msg(EpisodeGrid(Current, Show, Items, TableWidth), Fill));
  const EpisodePane: E.Element of App.Msg := E.Column of App.Msg(
    new L.Flow(Align := L.Alignment.Stretch, Padding := Points(Padding), Gap := Points(12)),
    Parts.ToArray()
  );
  const Content: E.Element of App.Msg := if Compact then
    E.Column of App.Msg(
      Stretch,
      E.Row of App.Msg(
        new L.Flow(Padding := Points(Padding), Gap := Points(12)),
        Cover,
        E.Size of App.Msg(Info, Fill)
      ),
      E.Size of App.Msg(EpisodePane, Fill)
    )
  else
    E.Row of App.Msg(
      Stretch,
      E.Size of App.Msg(
        E.Column of App.Msg(new L.Flow(Padding := Points(Padding), Gap := Points(12)), Cover, Info),
        Fixed(Inset)
      ),
      E.Size of App.Msg(E.Styled of App.Msg(E.Column of App.Msg(), S.Role.Divider), Fixed(1)),
      E.Size of App.Msg(EpisodePane, Fill)
    )
  end if;
  const Count: string := Items.Length.ToString() + (if Items.Length <> Page.Episodes.Length then
    ' of ' + Page.Episodes.Length.ToString()
  else
    ''
  end if) +
    if Items.Length = 1 and Page.Episodes.Length = 1 then
      ' episode'
    else
      ' episodes'
    end if;
  const Body: E.Element of App.Msg := E.Column of App.Msg(
    Stretch,
    E.Row of App.Msg(
      new L.Flow(Padding := Points(Padding), Gap := Points(6), Align := L.Alignment.Center),
      Icons.IconButton of App.Msg(
        'podcast-back',
        Sys.Char.ConvertFromUtf32($E048),
        'Back to podcast search',
        Action(M.Msg.Back)
      ),
      Texts.Text of App.Msg('Podcasts', Texts.Appearance.HeadingThree)
    ),
    E.Size of App.Msg(E.Styled of App.Msg(E.Row of App.Msg(), S.Role.Divider), Fixed(1)),
    E.Size of App.Msg(Content, Fill),
    Status.StatusBar of App.Msg(
      'podcast-status',
      [(Status.Item of App.Msg).Text(new Status.Label(Count))]
    )
  );
  const Item: M.Episode? := Page.Details;
  return if Item <> null then
    Details(Body, Item)
  else
    Body
  end if;
end function;

end unit;
