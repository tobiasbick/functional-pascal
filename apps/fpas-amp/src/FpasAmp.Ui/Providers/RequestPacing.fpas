// [Documentation](../../../doc/desktop.md#editing-track-tags)

// A provider owns one gate for the lifetime of the application.
unit FpasAmp.Ui.Providers.RequestPacing;

uses System as Sys;
uses System.Net.Http as H;
uses System.Net.Http.Headers as Headers;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

// Returns the delay in milliseconds requested by Reply, or zero when no delay remains.
public function RetryAfter(Reply: H.HttpResponseMessage): long;
begin
  const Hint: Headers.RetryConditionHeaderValue? := Reply.Headers.RetryAfter;
  if Hint = null then
    return 0L;
  end if;
  const Date: Sys.DateTimeOffset? := Hint.Date;
  const Delay: Sys.TimeSpan := Hint.Delta ?? if Date <> null then
    Date.Value - Sys.DateTimeOffset.UtcNow
  else
    Sys.TimeSpan.Zero
  end if;
  return cast Sys.Math.Ceiling(Sys.Math.Max(0.0, Delay.TotalMilliseconds)) as long;
end function;

// Observable permission to start another request to the provider.
public type Status = record
  // A request or retry owns the provider slot.
  public Busy: bool := false;
  // Whole seconds until the next allowed start, rounded up.
  public Seconds: long := 0L;
end record;

// Serializes calls and publishes the provider's monotonic next-start deadline.
public type Gate = record
  Permit: T.SemaphoreSlim;
  Deadline: array of long;
  Minimum: long;

  // Creates a provider gate with the minimum interval between starts in milliseconds.
  public static function Create(Milliseconds: long): Gate;
  requires Milliseconds > 0L;
  begin
    return new Gate(new T.SemaphoreSlim(1, 1), [0L], Milliseconds);
  end function;

  // Returns the current slot and countdown without acquiring the slot.
  public function Read(): Status;
  begin
    const Pending: long := self.Remaining();
    return new Status(self.Permit.CurrentCount = 0, (Pending + 999L) div 1000L);
  end function;

  function Remaining(): long;
  begin
    return Sys.Math.Max(
      0L,
      T.Interlocked.CompareExchange(ref self.Deadline[0], 0L, 0L) - Sys.Environment.TickCount64
    );
  end function;

  // Waits for exclusive access. The caller must release a successfully acquired slot.
  public function Enter(Stop: T.CancellationToken): Tasks.Task;
  begin
    return self.Permit.WaitAsync(Stop);
  end function;

  // Extends the next-start deadline. Only the current slot owner may call this.
  public procedure Cooldown(Milliseconds: long);
  begin
    const Next: long := Sys.Environment.TickCount64 + Milliseconds;
    discard T.Interlocked.Exchange(
      ref self.Deadline[0],
      Sys.Math.Max(Next, T.Interlocked.CompareExchange(ref self.Deadline[0], 0L, 0L))
    );
  end procedure;

  // Waits for the provider interval, then reserves the next interval before sending.
  public async function Start(Stop: T.CancellationToken): Tasks.Task;
  begin
    var Remaining: long := self.Remaining();
    while Remaining > 0L do
      await Tasks.Task.Delay(
        cast Sys.Math.Min(Remaining, 60000L) as int,
        Stop
      ).ConfigureAwait(false);
      Remaining := self.Remaining();
    end while;

    Stop.ThrowIfCancellationRequested();
    self.Cooldown(self.Minimum);
  end function;

  // Releases the slot while retaining the latest deadline.
  public procedure Leave();
  begin
    discard self.Permit.Release();
  end procedure;
end record;

end unit;
