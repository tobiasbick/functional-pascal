// [Documentation](../../../doc/desktop.md#online-radio)

unit FpasAmp.Ui.Radio.Toolbar;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Inputs.SearchFields as Search;
uses Fpas.Ui.Widgets.Inputs.TextFields as Fields;

uses FpasAmp.Ui.Albums.Toolbar.Filters as Filters;
uses FpasAmp.Ui.Albums.Toolbar.View as Toolbar;
uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Collections.TableSort as Sort;
uses FpasAmp.Ui.Radio.Model as M;

function Action(Message: M.Msg): App.Msg;
begin
  return App.Msg.Radio(Message);
end function;

function Field(Key: string; Value: string): E.Element of App.Msg;
begin
  return Fields.TextField of App.Msg(
    'radio-filter-' + Key,
    Value,
    function(Text: string): App.Msg => Action(M.Msg.Filter(Key, Text)),
    new Fields.Options(Label := Key)
  );
end function;

// Renders the radio directory toolbar.
// ## Parameters
// - `Page`: Radio search, filter and sort state.
// - `Width`: Available width in logical points.
// ## Returns
// The station search field, filter form and active sort menu.
public function Build(Page: M.State; Width: int): E.Element of App.Msg;
requires Width > 0;
begin
  const Count: int := (if Page.Filter.Country <> '' then
    1
  else
    0
  end if) +
    (if Page.Filter.Language <> '' then
      1
    else
      0
    end if) + (if Page.Filter.Genre <> '' then
      1
    else
      0
    end if) + (if Page.Filter.Codec <> '' then
      1
    else
      0
    end if);
  const Draft: M.Query? := Page.FilterDraft;
  const Panel: E.Element of App.Msg := if Draft <> null then
    Filters.Panel of App.Msg(
      'radio', 'Filter stations',
      [
        Field('Country', Draft.Country),
        Field('Language', Draft.Language),
        Field('Genre', Draft.Genre),
        Field('Codec', Draft.Codec)
      ],
      Action(M.Msg.ResetFilters), Action(M.Msg.ApplyFilters)
    )
  else
    E.Column of App.Msg()
  end if;
  return Toolbar.Arrange of App.Msg(
    Search.SearchField of App.Msg(
      'radio-search',
      Page.Filter.Name,
      function(Value: string): App.Msg => Action(M.Msg.Name(Value)),
      new Search.Options(Placeholder := 'Search stations…')
    ),
    Filters.Popup of App.Msg(
      'radio',
      Panel,
      Count,
      Draft <> null,
      function(Open: bool): App.Msg => Action(M.Msg.SetFilters(Open)),
      Width
    ),
    Sort.Build of App.Msg(
      'radio-sort',
      ['Station', 'Country', 'Language', 'Genre', 'Bitrate'],
      [true, true, true, true, false],
      Page.Order,
      function(Order: Tables.Sort): App.Msg => Action(
        M.Msg.Sort(Order)
      ),
      'Popular first'
    ), Width
  );
end function;

end unit;
