// [Documentation](../../../doc/desktop.md#online-radio)

unit FpasAmp.Ui.Radio.Update;

uses Fpas.Ui.Mvu.Application as A;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;

uses FpasAmp.Ui.Collections.TableRows as Rows;
uses FpasAmp.Ui.Radio.Directory as Directory;
uses FpasAmp.Ui.Radio.Model as M;
uses System as Sys;
uses System.Diagnostics as D;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

function Ordered(Items: array of M.Station; Order: Tables.Sort): array of M.Station;
  function Compare(Left: M.Station; Right: M.Station): int;
  begin
    const Names: Sys.StringComparer := Sys.StringComparer.CurrentCultureIgnoreCase;
    if Order.Column = 4 and (Left.Bitrate = 0) <> (Right.Bitrate = 0) then
      return (Left.Bitrate = 0).CompareTo(Right.Bitrate = 0);
    end if;

    const Value: int := case Order.Column of
      when 0: Names.Compare(Left.Name, Right.Name);
      when 1: Names.Compare(Left.Country, Right.Country);
      when 2: Names.Compare(Left.Language, Right.Language);
      when 3: Names.Compare(Left.Genre, Right.Genre);
      else Left.Bitrate.CompareTo(Right.Bitrate);
    end case;
    return if Order.Descending then
      -Value
    else
      Value
    end if;
  end function;
begin
  return if Order.Column < 0 then
    Items
  else
    Rows.Sorted<M.Station>(Items, Compare)
  end if;
end function;

function Search(Current: M.State; Filter: M.Query): A.Transition<M.State, M.Msg>;
begin
  const Revision: long := Current.Revision + 1L;
  return new A.Transition<M.State, M.Msg>(
    Current with
      Filter := Filter;
      Searching := true;
      Error := null;
      Revision := Revision;
    end with,
    [
      A.StartBackground<M.Msg>(
        'search',
        A.FromWorker<M.Msg>(
          async function(Post: function(M.Msg): Tasks.Task; Stop: T.CancellationToken): Tasks.Task begin
            await Tasks.Task.Delay(275, Stop).ConfigureAwait(false);
            const Items: array of M.Station := await Directory.Search(
              Filter,
              Stop
            ).ConfigureAwait(false);
            await Post(M.Msg.Found(Revision, Items)).ConfigureAwait(false);
          end function,
          function(Error: Sys.Exception): M.Msg => M.Msg.Failed(Revision, Error.Message)
        )
      )
    ]
  );
end function;

// Advances the radio directory or manual station editor.
// ## Parameters
// - `Current`: The current radio page state.
// - `Action`: A user action or a detached reply from a worker.
// ## Returns
// The updated radio page and any requested background commands.
public function Apply(Current: M.State; Action: M.Msg): A.Transition<M.State, M.Msg>;
begin
  var Next: M.State := Current;
  const Draft: M.Draft? := Current.Editing;
  case Action of
    when M.Msg.Refresh:
      return Search(Current, Current.Filter);
    when M.Msg.Name(const Value: string):
      return Search(
        Current, Current.Filter with
          Name := Value;
        end with
      );
    when M.Msg.SetFilters(const Open: bool):
      Next := Current with
        FilterDraft := if Open then
          Current.Filter
        else
          null
        end if;
      end with;
    when M.Msg.Filter(const Key: string, const Value: string):
      const Filter: M.Query? := Current.FilterDraft;
      if Filter <> null then
        Next := Current with
          FilterDraft := case Key of
            when 'Country': Filter with
              Country := Value;
            end with;
            when 'Language': Filter with
              Language := Value;
            end with;
            when 'Genre': Filter with
              Genre := Value;
            end with;
            when 'Codec': Filter with
              Codec := Value;
            end with;
            else Filter;
          end case;
        end with;
      end if;
    when M.Msg.ResetFilters:
      if Current.FilterDraft <> null then
        Next := Current with
          FilterDraft := new M.Query();
        end with;
      end if;
    when M.Msg.ApplyFilters:
      const Filter: M.Query? := Current.FilterDraft;
      if Filter <> null then
        Next := Current with
          FilterDraft := null;
        end with;
        const Applied: M.Query := new M.Query(
          Current.Filter.Name,
          Filter.Country.Trim(),
          Filter.Language.Trim(),
          Filter.Genre.Trim(),
          Filter.Codec.Trim().ToUpperInvariant()
        );
        if Applied <> Current.Filter then
          return Search(Next, Applied);
        end if;
      end if;
    when M.Msg.Found(const Revision: long, const Items: array of M.Station):
      if Revision = Current.Revision then
        const Shown: array of M.Station := Ordered(Items, Current.Order);
        const Key: function(M.Station): string := function(Item: M.Station): string => Item.Id;
        Next := Current with
          Items := Shown;
          Results := Items;
          Loaded := true;
          Searching := false;
          Cursor := Rows.Position<M.Station>(Current.Items, Current.Cursor, Shown, Key);
          Anchor := Rows.Position<M.Station>(Current.Items, Current.Anchor, Shown, Key);
        end with;
      end if;
    when M.Msg.Failed(const Revision: long, const Message: string):
      if Revision = Current.Revision then
        Next := Current with
          Error := Message;
          Searching := false;
        end with;
      end if;
    when M.Msg.Navigate(const Cursor: int, const Anchor: int, const Scroll: float):
      Next := Current with
        Cursor := Cursor;
        Anchor := Anchor;
        Scroll := Scroll;
      end with;
    when M.Msg.Sort(const Order: Tables.Sort):
      if Order <> Current.Order and Order.Column >= -1 and Order.Column < 5 then
        const Items: array of M.Station := Ordered(Current.Results, Order);
        const Key: function(M.Station): string := function(Item: M.Station): string => Item.Id;
        Next := Current with
          Items := Items;
          Order := Order;
          Cursor := Rows.Position<M.Station>(Current.Items, Current.Cursor, Items, Key);
          Anchor := Rows.Position<M.Station>(Current.Items, Current.Anchor, Items, Key);
        end with;
      end if;
    when M.Msg.Add:
      Next := Current with
        Editing := new M.Draft();
      end with;
    when M.Msg.EditName(const Value: string):
      if Draft <> null then
        Next := Current with
          Editing := Draft with
            Name := Value;
            Error := null;
          end with;
        end with;
      end if;
    when M.Msg.EditUrl(const Value: string):
      if Draft <> null then
        Next := Current with
          Editing := Draft with
            Url := Value;
            Error := null;
          end with;
        end with;
      end if;
    when M.Msg.Cancel:
      Next := Current with
        Editing := null;
      end with;
    when M.Msg.Website(const Value: string):
      const Url: string := M.Address(Value);
      if Url <> '' then
        return new A.Transition<M.State, M.Msg>(
          Current,
          [
            A.StartBackground<M.Msg>(
              'website',
              A.FromWorker<M.Msg>(
                async function(_Post: function(M.Msg): Tasks.Task; Stop: T.CancellationToken): Tasks.Task begin
                  Stop.ThrowIfCancellationRequested();
                  const Start: D.ProcessStartInfo := new D.ProcessStartInfo(Url);
                  Start.UseShellExecute := true;
                  using const Launched: D.Process? := D.Process.Start(Start);
                  await Tasks.Task.CompletedTask;
                end function,
                function(_Error: Sys.Exception): M.Msg => M.Msg.WebsiteFailed
              )
            )
          ]
        );
      end if;
    when M.Msg.WebsiteFailed:
      Next := Current with
        Error := 'Could not open the station website.';
      end with;
    when M.Msg.Favorite(_), M.Msg.Save:
  end case;

  return new A.Transition<M.State, M.Msg>(Next, []);
end function;

end unit;
