// [Documentation](../../../doc/desktop.md#online-radio)

unit FpasAmp.Ui.Radio.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.ActionFooters as Footers;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icons;
uses Fpas.Ui.Widgets.Collections.DataGrids as Grid;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Containers.EmptyStates as Empty;
uses Fpas.Ui.Widgets.Desktop.StatusBars as Status;
uses Fpas.Ui.Widgets.Display.Icons as Artwork;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Feedback.Alerts as Alerts;
uses Fpas.Ui.Widgets.Inputs.TextFields as Fields;
uses Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs;

uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Navigation.Model as Nav;
uses FpasAmp.Ui.Player.Model as Player;
uses FpasAmp.Ui.Radio.Model as M;
uses FpasAmp.Ui.Radio.Toolbar as Controls;
uses System as Sys;
uses System.Collections.Generic as C;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function Action(Value: M.Msg): App.Msg;
begin
  return App.Msg.Radio(Value);
end function;

function Play(Current: App.State; Item: M.Station; Labeled: bool := false): E.Element of App.Msg;
begin
  const Source: M.Station? := Current.Player.Station;
  const Active: bool := Source <> null and Source.Id = Item.Id;
  const Playing: bool := Active and Current.Player.Playing;
  const Glyph: string := Sys.Char.ConvertFromUtf32(
    if Playing then
      $E167
    else
      $E13C
    end if
  );
  const Key: string := 'radio-play-' + Item.Id;
  const Message: App.Msg := App.Msg.Player(Player.Msg.PlayStation(Item));
  if Labeled then
    return B.Button of App.Msg(
      Key, if Playing then
        'Stop'
      else
        'Play live'
      end if, Message,
      new B.Options(Icon := Glyph, Variant := S.ButtonVariant.Primary)
    );
  end if;

  return Icons.IconButton of App.Msg(
    Key, Glyph,
    (if Playing then
      'Stop '
    else
      'Play '
    end if) + Item.Name,
    Message,
    new Icons.Options(
      ControlSize := Icons.Size.Small,
      Variant := if Active then
        S.ButtonVariant.Primary
      else
        S.ButtonVariant.Ghost
      end if
    )
  );
end function;

function Favorite(Current: App.State; Item: M.Station; Labeled: bool): E.Element of App.Msg;
begin
  const Saved: bool := M.Find(Current.Settings.Saved.RadioFavorites, Item.Id) <> null;
  const Star: string := Sys.Char.ConvertFromUtf32($E176);
  if Labeled then
    return B.Button of App.Msg(
      'radio-favorite-' + Item.Id, if Saved then
        'Favorited'
      else
        'Favorite'
      end if,
      Action(M.Msg.Favorite(Item)),
      new B.Options(Icon := Star, Variant := S.ButtonVariant.Outline, Selected := Saved)
    );
  end if;

  return Icons.IconButton of App.Msg(
    'radio-favorite-' + Item.Id, Star,
    (if Saved then
      'Remove favorite '
    else
      'Favorite '
    end if) + Item.Name,
    Action(M.Msg.Favorite(Item)),
    new Icons.Options(
      ControlSize := Icons.Size.Small,
      Variant := if Saved then
        S.ButtonVariant.Primary
      else
        S.ButtonVariant.Ghost
      end if
    )
  );
end function;

function Format(Item: M.Station): string;
begin
  const Codec: string := Item.Codec.ToUpperInvariant();
  const Mode: string := if Item.Hls then
    'HLS'
  else
    ''
  end if;
  const Details: C.List of string := new C.List of string();
  if Codec <> '' then
    Details.Add(Codec);
  end if;

  if Mode <> '' then
    Details.Add(Mode);
  end if;

  if Item.Bitrate > 0 then
    Details.Add(Item.Bitrate.ToString() + ' kbps');
  end if;

  return Sys.String.Join(' · ', Details);
end function;

function Row(Current: App.State; Item: M.Station): Grid.Row of App.Msg;
begin
  return new Grid.Row of App.Msg(
    Item.Id, [
      (Grid.Cell of App.Msg).Content(
        [
          E.Row of App.Msg(
            new L.Flow(Gap := Points(10), Align := L.Alignment.Center),
            Play(Current, Item),
            E.Styled of App.Msg(
              Texts.Text of App.Msg(Item.Name, Texts.Appearance.Label),
              S.Role.SingleLine
            )
          )
        ]
      ),
      (Grid.Cell of App.Msg).Text(Item.Country), (Grid.Cell of App.Msg).Text(Item.Language),
      (Grid.Cell of App.Msg).Text(Item.Genre), (Grid.Cell of App.Msg).Text(Format(Item)),
      (Grid.Cell of App.Msg).Content([Favorite(Current, Item, false)])
    ]
  );
end function;

function GridView(Current: App.State; Width: int): E.Element of App.Msg;
  function Change(Value: Grid.Value): App.Msg;
  begin
    const Order: Tables.Sort? := Value.Order;
    return if Order <> null and Order <> Current.Radio.Order then
      Action(M.Msg.Sort(Order))
    else
      Action(M.Msg.Navigate(Value.Cursor, Value.Anchor, Value.Scroll ?? 0.0F))
    end if;
  end function;
begin
  const Page: M.State := Current.Radio;
  if Page.Items.Length = 0 then
    return Empty.EmptyState of App.Msg(
      'radio-empty', if Page.Searching then
        'Finding stations…'
      elsif Page.Loaded then
        'No matching stations'
      else
        'Station directory unavailable'
      end if
    );
  end if;

  return Grid.DataGrid of App.Msg(
    'radio-stations',
    [
      new Grid.Column('Station', cast Sys.Math.Max(200, Width - 582) as float, Sortable := true),
      new Grid.Column('Country', 126.0F, Sortable := true, Priority := 3),
      new Grid.Column('Language', 112.0F, Sortable := true, Priority := 4),
      new Grid.Column('Genre', 162.0F, Sortable := true, Priority := 5),
      new Grid.Column('Stream', 136.0F, Sortable := true, Priority := 1),
      new Grid.Column('', 46.0F, Fixed := true)
    ],
    Page.Items.Length,
    function(Index: int): Grid.Row of App.Msg => Row(Current, Page.Items[Index]),
    new Grid.Value(
      Order := Page.Order,
      Cursor := Page.Cursor,
      Anchor := Page.Anchor,
      Scroll := Page.Scroll
    ),
    Change,
    new Grid.Options(RowHeight := 38.0F, HideCheckboxes := true),
    function(Index: int): App.Msg => App.Msg.Player(Player.Msg.PlayStation(Page.Items[Index]))
  );
end function;

function Error(Message: string?; Id: string := 'radio-error'): E.Element of App.Msg;
begin
  if Message = null then
    return E.Row of App.Msg();
  end if;

  return Alerts.Alert of App.Msg(
    Id, Message, new Alerts.Options(Tone := S.Tone.Warning)
  );
end function;

function Edit(Base: E.Element of App.Msg; Draft: M.Draft): E.Element of App.Msg;
begin
  return Dialogs.Dialog of App.Msg(
    'radio-add-dialog',
    Base,
    E.Column of App.Msg(
      new L.Flow(Gap := Points(12), Align := L.Alignment.Stretch),
      Fields.TextField of App.Msg(
        'radio-url', Draft.Url, function(Value: string): App.Msg => Action(M.Msg.EditUrl(Value)),
        new Fields.Options(Label := 'Stream URL')
      ),
      Fields.TextField of App.Msg(
        'radio-name', Draft.Name, function(Value: string): App.Msg => Action(M.Msg.EditName(Value)),
        new Fields.Options(Label := 'Name (optional)')
      ),
      Error(Draft.Error, 'radio-save-error'),
      Footers.ActionFooter of App.Msg(
        B.Button of App.Msg('radio-cancel', 'Cancel', Action(M.Msg.Cancel)),
        B.Button of App.Msg(
          'radio-save', 'Add station', Action(M.Msg.Save),
          new B.Options(Variant := S.ButtonVariant.Primary, Enabled := M.Address(Draft.Url) <> '')
        )
      )
    ),
    true,
    new Dialogs.Options('Add stream URL', InitialFocus := 'radio-url'),
    Action(M.Msg.Cancel)
  );
end function;

// Renders the station directory with search, filters and the manual URL dialog.
public function Stations(Current: App.State; Width: int; Padding: int): E.Element of App.Msg;
begin
  const Page: M.State := Current.Radio;
  const Inner: int := Sys.Math.Max(1, Width - 2 * Padding);
  const Info: string := if Page.Searching then
    'Finding stations…'
  else
    Page.Items.Length.ToString() + if Page.Items.Length = 1 then
      ' station'
    else
      ' stations'
    end if
  end if;
  const Body: E.Element of App.Msg := E.Column of App.Msg(
    new L.Flow(Align := L.Alignment.Stretch),
    E.Size of App.Msg(
      E.Column of App.Msg(
        new L.Flow(Padding := Points(Padding), Gap := Points(16), Align := L.Alignment.Stretch),
        E.Row of App.Msg(
          new L.Flow(Gap := Points(8), Align := L.Alignment.Center),
          E.Size of App.Msg(Texts.Text of App.Msg('Stations', Texts.Appearance.HeadingOne), Fill),
          B.Button of App.Msg(
            'radio-add', 'Add stream URL', Action(M.Msg.Add),
            new B.Options(Variant := S.ButtonVariant.Outline)
          )
        ), Controls.Build(Page, Inner), Error(Page.Error),
        if Page.Error <> null and Page.Editing = null then
          B.Button of App.Msg(
            'radio-retry', 'Retry', Action(M.Msg.Refresh),
            new B.Options(Variant := S.ButtonVariant.Outline)
          )
        else
          E.Row of App.Msg()
        end if,
        E.Size of App.Msg(GridView(Current, Inner), Fill)
      ), Fill
    ),
    Status.StatusBar of App.Msg(
      'radio-status',
      [(Status.Item of App.Msg).Text(new Status.Label(Info))]
    )
  );
  const Draft: M.Draft? := Page.Editing;
  return if Draft <> null then
    Edit(Body, Draft)
  else
    Body
  end if;
end function;

// Renders a saved station's information and its current live track, if available.
// Current supplies player and favorite state. Item is the saved station.
// Padding is the outer inset in logical points.
public function Station(Current: App.State; Item: M.Station; Padding: int): E.Element of App.Msg;
begin
  const Source: M.Station? := Current.Player.Station;
  const Active: bool := Source <> null and Source.Id = Item.Id;
  const Name: string := if Active and Current.Player.NowPlaying <> '' then
    Current.Player.NowPlaying
  elsif Active and Current.Player.Buffering then
    'Connecting…'
  elsif Active and Current.Player.Playing then
    'LIVE'
  else
    'Stopped'
  end if;
  const Descriptors: C.List of string := new C.List of string();
  for Value: string in [Item.Country, Item.Language, Item.Genre] do
    if Value <> '' then
      Descriptors.Add(Value);
    end if;
  end for;
  const Back: App.Msg := App.Msg.Navigation(Nav.Msg.Select(Nav.Route.Page(Nav.Page.Stations)));
  return E.ScrollView of App.Msg(
    'station-details-scroll', E.Column of App.Msg(
      new L.Flow(Padding := Points(Padding), Gap := Points(16), Align := L.Alignment.Stretch),
      E.Row of App.Msg(
        new L.Flow(Gap := Points(8), Align := L.Alignment.Center),
        Icons.IconButton of App.Msg(
          'radio-back',
          Sys.Char.ConvertFromUtf32($E048),
          'Back to stations',
          Back
        ),
        Texts.Text of App.Msg('Stations', Texts.Appearance.HeadingThree)
      ),
      E.Divider of App.Msg(),
      E.Row of App.Msg(
        new L.Flow(Gap := Points(18), Align := L.Alignment.Center),
        Cards.Card of App.Msg(
          'station-artwork', [
            Artwork.Icon of App.Msg(Sys.Char.ConvertFromUtf32($E142), 36.0F)
          ], new Cards.Options(
            Width := L.Extent.Fixed(L.Measure.Logical(88)),
            Height := L.Extent.Fixed(L.Measure.Logical(88)),
            Align := L.Alignment.Center,
            Muted := true
          )
        ),
        E.Size of App.Msg(
          E.Column of App.Msg(
            new L.Flow(Gap := Points(6)),
            Texts.Text of App.Msg(Item.Name, Texts.Appearance.HeadingOne),
            Texts.Text of App.Msg(Sys.String.Join(' · ', Descriptors), Texts.Appearance.Secondary),
            E.Row of App.Msg(
              new L.Flow(Gap := Points(8), Align := L.Alignment.Center),
              Play(Current, Item, true), Favorite(Current, Item, true)
            )
          ), Fill
        )
      ),
      Error(Current.Radio.Error),
      Cards.Card of App.Msg(
        'station-now-playing', [
          Texts.Text of App.Msg('Now playing', Texts.Appearance.HeadingThree),
          Texts.Text of App.Msg(Name, Texts.Appearance.Label)
        ], new Cards.Options(Width := L.Extent.Fill)
      ),
      if Format(Item) <> '' or Item.Website <> '' then
        Cards.Card of App.Msg(
          'station-stream-details', [
            Texts.Text of App.Msg('Station information', Texts.Appearance.HeadingThree),
            Texts.Text of App.Msg(Format(Item), Texts.Appearance.Secondary),
            if Item.Website <> '' then
              B.Button of App.Msg(
                'radio-website', 'Station website', Action(M.Msg.Website(Item.Website)),
                new B.Options(
                  Variant := S.ButtonVariant.Outline,
                  Icon := Sys.Char.ConvertFromUtf32($E0B9)
                )
              )
            else
              E.Row of App.Msg()
            end if
          ], new Cards.Options(Width := L.Extent.Fill)
        )
      else
        E.Row of App.Msg()
      end if
    )
  );
end function;

end unit;
