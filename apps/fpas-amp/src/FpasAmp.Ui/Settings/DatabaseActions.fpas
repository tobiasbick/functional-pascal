// [Documentation](../../../doc/desktop.md#settings-and-scan-control)

// Native confirmation triggers shared by global and per-source index clearing.
unit FpasAmp.Ui.Settings.DatabaseActions;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Overlays.ConfirmPopovers as Confirm;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses FpasAmp.Ui.Settings.Model as M;
uses System as Sys;

// Builds a native clear button and confirmation. `Target` is a source ID or empty
// for the full database; `Id` is its stable widget identity. `Current` owns state.
public function Clear(Id: string; Target: string; Label: string; Current: M.State; Theme: Themes.Theme): E.Element of M.Msg;
begin
  const Confirmation: string? := Current.ConfirmClear;
  const Busy: string? := Current.Clearing;
  const Button: E.Element of M.Msg := B.Button of M.Msg(
    Id, Label, M.Msg.AskClear(Target),
    new B.Options(
      Variant := S.ButtonVariant.Outline, ControlSize := B.Size.Small,
      Enabled := Busy = null, Loading := Busy <> null and Busy = Target,
      Color := Theme.Colors.Danger, Icon := Sys.Char.ConvertFromUtf32($E18E)
    )
  );
  return Confirm.ConfirmPopover of M.Msg(
    Id + '-confirm', Button,
    Confirmation <> null and Confirmation = Target,
    new Confirm.Options(
      Title := if Target = '' then
        'Clear the library database?'
      else
        'Reset this source''s index?'
      end if,
      Description := 'Only indexed entries are removed. Music files, ratings and source settings are kept. Scanning will be paused.',
      ConfirmLabel := if Target = '' then
        'Clear database'
      else
        'Reset'
      end if,
      Danger := true
    ), M.Msg.ConfirmClear, M.Msg.CancelClear
  );
end function;

end unit;
