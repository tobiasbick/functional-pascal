// [Documentation](../../../doc/desktop.md#settings-and-scan-control)

// Editor for the name and formats of a music source.
unit FpasAmp.Ui.Settings.Editor;

uses Fpas.Ui.Composition as Composition;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.ActionFooters as Footers;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Feedback.Alerts as Alerts;
uses Fpas.Ui.Widgets.Inputs.MultiSelects as Multi;
uses Fpas.Ui.Widgets.Inputs.Selects as Selects;
uses Fpas.Ui.Widgets.Inputs.TextFields as Fields;
uses Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs;

uses FpasAmp.Library.Sources as Locations;
uses FpasAmp.Ui.Settings.Model as M;
uses System as Sys;
uses System.Collections.Generic as C;

const CommonFormats: array of string := [
  '.flac',
  '.mp3',
  '.m4a',
  '.wav',
  '.ogg',
  '.opus',
  '.aac',
  '.aiff',
  '.wma'
];

function FormatSelector(Selected: array of string): E.Element of M.Msg;
begin
  const Names: C.List of string := new C.List of string(CommonFormats);
  const Listed: C.HashSet of string := new C.HashSet of string(
    CommonFormats,
    Sys.StringComparer.OrdinalIgnoreCase
  );
  const Enabled: C.HashSet of string := new C.HashSet of string(
    Selected,
    Sys.StringComparer.OrdinalIgnoreCase
  );
  for Extension: string in Selected do
    if Listed.Add(Extension) then
      Names.Add(Extension);
    end if;
  end for;
  const Items: C.List of Selects.Item := new C.List of Selects.Item(Names.Count);
  const Active: array of bool := new bool[Names.Count];
  for Index: int := 0 to Names.Count - 1 do
    Items.Add(new Selects.Item(Names[Index].Substring(1).ToUpperInvariant()));
    Active[Index] := Enabled.Contains(Names[Index]);
  end for;

  return Multi.MultiSelect of M.Msg(
    'source-formats', Items.ToArray(), Active,
    function(Flags: array of bool): M.Msg begin
      const Formats: C.List of string := new C.List of string();
      for Index: int := 0 to Flags.Length - 1 do
        if Flags[Index] then
          Formats.Add(Names[Index]);
        end if;
      end for;

      return M.Msg.SetFormats(Formats.ToArray());
    end function,
    new Multi.Options(Label := 'Formats', Placeholder := 'Select formats')
  );
end function;

// Presents the editor for the current source draft over the parent's view.
//
// ## Type parameters
// - `TParent`: The parent's message type.
// ## Parameters
// - `Base`: The view behind the editor.
// - `Draft`: The current name, folder and selected formats.
// - `SaveFailed`: Whether the last save should be reported in the editor.
// - `Messages`: Wraps settings messages in parent messages.
// ## Returns
// `Base` with the editor open.
public function View of TParent(
  Base: E.Element of TParent;
  Draft: Locations.MusicSource;
  SaveFailed: bool;
  Messages: function(M.Msg): TParent
): E.Element of TParent;
begin
  const Content: C.List of E.Element of M.Msg := new C.List of E.Element of M.Msg(
    [
      Texts.Text of M.Msg(Draft.Path, Texts.Appearance.Secondary),
      Fields.TextField of M.Msg(
        'source-name',
        Draft.Name,
        M.Msg.SetName,
        new Fields.Options(Label := 'Name')
      ),
      FormatSelector(Draft.Extensions)
    ]
  );
  if SaveFailed then
    Content.Add(
      Alerts.Alert of M.Msg(
        'source-save-error',
        'Could not save settings. Try again.',
        new Alerts.Options(Tone := S.Tone.Danger)
      )
    );
  end if;

  Content.Add(
    Footers.ActionFooter of M.Msg(
      B.Button of M.Msg(
        'source-cancel',
        'Cancel',
        M.Msg.CancelEdit,
        new B.Options(Variant := S.ButtonVariant.Outline)
      ),
      B.Button of M.Msg(
        'source-save', 'Save', M.Msg.SaveSource,
        new B.Options(
          Variant := S.ButtonVariant.Primary,
          Enabled := not Sys.String.IsNullOrWhiteSpace(Draft.Name)
        )
      )
    )
  );
  return Dialogs.Dialog of TParent(
    'edit-source', Base,
    Composition.Map of (M.Msg, TParent)(
      E.Column of M.Msg(
        new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(14)), Align := L.Alignment.Stretch),
        Content.ToArray()
      ), Messages
    ),
    true, new Dialogs.Options('Music source', InitialFocus := 'source-name'),
    Messages(M.Msg.CancelEdit)
  );
end function;

end unit;
