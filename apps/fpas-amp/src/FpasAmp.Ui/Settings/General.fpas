// [Documentation](../../../doc/desktop.md#settings-and-scan-control)

// General appearance and accent controls.
unit FpasAmp.Ui.Settings.General;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.SegmentedControls as Segments;
uses Fpas.Ui.Widgets.Canvas.Canvases as Canvas;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Overlays.Tooltips as Tips;
uses Fpas.Ui.Widgets.Theming.ThemeSwitchers as Switchers;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses FpasAmp.Ui.Settings.Model as M;
uses System as Sys;
uses System.Collections.Generic as C;

function Swatch(Theme: Themes.Theme; Accent: Themes.Accent): E.Element of M.Msg;
begin
  const Name: string := Accent.ToString();
  const Color: G.Color := Themes.Light(Accent).Colors.Accent;
  const Dot: Canvas.Shape := Canvas.Shape.Circle(14.0F, 14.0F, 10.0F, Color);
  const Shapes: array of Canvas.Shape := if Theme.AccentFamily = Accent then
    [
      Canvas.Shape.Circle(14.0F, 14.0F, 14.0F, Theme.Colors.Foreground),
      Canvas.Shape.Circle(14.0F, 14.0F, 12.0F, Theme.Colors.Surface),
      Dot
    ]
  else
    [Dot]
  end if;
  const Side: L.Extent := L.Extent.Fixed(L.Measure.Logical(28));
  return Tips.Tooltip of M.Msg(
    Canvas.Canvas of M.Msg(
      'accent-' + Name.ToLowerInvariant(),
      Shapes,
      function(_Event: Canvas.Event): M.Msg => M.Msg.SetAccent(Accent),
      new Canvas.Options(Width := Side, Height := Side)
    ),
    Name
  );
end function;

// Builds appearance and accent cards from the current state.
//
// ## Parameters
// - `Current`: The current appearance preferences.
// - `Theme`: The current palette.
// ## Returns
// The general settings tab.
public function View(Current: M.State; Theme: Themes.Theme): E.Element of M.Msg;
begin
  const Colors: C.List of E.Element of M.Msg := new C.List of E.Element of M.Msg();
  for Accent: Themes.Accent in Sys.Enum.GetValues of Themes.Accent() do
    Colors.Add(Swatch(Theme, Accent));
  end for;
  const Options: Cards.Options := new Cards.Options(
    Width := L.Extent.Fill,
    Padding := 20.0F,
    Gap := 14.0F
  );
  return E.Column of M.Msg(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(16)), Align := L.Alignment.Stretch),
    Cards.Card of M.Msg(
      'appearance-card',
      [
        Texts.Text of M.Msg('Appearance', Texts.Appearance.HeadingThree),
        Segments.SegmentedControl of M.Msg(
          'appearance',
          [
            new Segments.Item('Light', Sys.Char.ConvertFromUtf32($E178)),
            new Segments.Item('Dark', Sys.Char.ConvertFromUtf32($E11E)),
            new Segments.Item('System', Sys.Char.ConvertFromUtf32($E11D))
          ],
          cast<int>(M.Appearance(Current.Saved)),
          function(Index: int): M.Msg => M.Msg.SetAppearance(cast<Switchers.Selection>(Index))
        )
      ],
      Options
    ),
    Cards.Card of M.Msg(
      'accent-card',
      [
        Texts.Text of M.Msg('Accent color', Texts.Appearance.HeadingThree),
        E.Row of M.Msg(
          new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(8)), Wrap := true),
          Colors.ToArray()
        ),
        Texts.Text of M.Msg(Theme.AccentFamily.ToString(), Texts.Appearance.Secondary)
      ],
      Options
    )
  );
end function;

end unit;
