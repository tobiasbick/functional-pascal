// [Documentation](../../../doc/desktop.md#settings-and-scan-control)

// Native source cards with independent offline/pause controls and index actions.
unit FpasAmp.Ui.Settings.Library;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Containers.EmptyStates as Empty;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Feedback.Badges as Badges;
uses Fpas.Ui.Widgets.Inputs.Switches as Switches;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses FpasAmp.Library.Sources as Locations;
uses FpasAmp.Ui.Settings.DatabaseActions as Database;
uses FpasAmp.Ui.Settings.Model as M;
uses FpasAmp.Ui.Settings.ScanStatus as Scan;
uses FpasAmp.Ui.Settings.SourceActions as Actions;
uses System as Sys;
uses System.Collections.Generic as C;

function Gap(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function SourceCard(Current: M.State; Source: Locations.MusicSource; Theme: Themes.Theme): E.Element<M.Msg>;
begin
  const Id: string := 'source-' + Source.Id;
  const Formats: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>();
  if Source.Extensions.Length = 0 then
    Formats.Add(Texts.Text<M.Msg>('No formats selected', Texts.Appearance.Secondary));
  else
    Formats.Add(Texts.Text<M.Msg>('Formats', Texts.Appearance.Secondary));
    for Extension: string in Source.Extensions do
      Formats.Add(Badges.Badge<M.Msg>(Id + Extension, Extension.Substring(1).ToUpperInvariant()));
    end for;
  end if;

  return Cards.Card<M.Msg>(
    Id,
    [
      E.Row<M.Msg>(
        new L.Flow(
          Gap := Gap(16),
          Align := L.Alignment.Center,
          Justify := L.Justification.Between,
          Wrap := true
        ),
        E.Size<M.Msg>(
          E.Column<M.Msg>(
            new L.Flow(Gap := Gap(4)),
            Texts.Text<M.Msg>(Source.Name, Texts.Appearance.HeadingFour),
            Texts.Text<M.Msg>(Source.Path, Texts.Appearance.Secondary)
          ),
          new L.Flex(Basis := L.Extent.Fill)
        ),
        E.Column<M.Msg>(
          new L.Flow(Gap := Gap(8), Align := L.Alignment.Start),
          Switches.Switch<M.Msg>(
            Id + '-offline',
            'Offline',
            Source.Offline,
            function(Value: bool): M.Msg => M.Msg.SetOffline(Source.Id, Value),
            Enabled := Current.Clearing = null
          ),
          Switches.Switch<M.Msg>(
            Id + '-pause',
            'Pause',
            Source.Paused,
            function(Value: bool): M.Msg => M.Msg.SetPaused(Source.Id, Value),
            Enabled := Current.Clearing = null
          )
        )
      ),
      Scan.View(Current, Source, Id),
      E.Divider<M.Msg>(),
      E.Row<M.Msg>(
        new L.Flow(
          Gap := Gap(12),
          Align := L.Alignment.Center,
          Justify := L.Justification.Between,
          Wrap := true
        ),
        E.Row<M.Msg>(
          new L.Flow(Gap := Gap(8), Align := L.Alignment.Center, Wrap := true),
          Formats.ToArray()
        ),
        E.Row<M.Msg>(
          new L.Flow(Gap := Gap(8), Wrap := true),
          Actions.Remove(Id + '-remove', Source.Id, Current, Theme),
          Database.Clear(Id + '-clear', Source.Id, 'Reset', Current, Theme),
          B.Button<M.Msg>(
            Id + '-rescan', 'Refresh', M.Msg.Rescan(Source.Id),
            new B.Options(
              Variant := S.ButtonVariant.Outline, ControlSize := B.Size.Small,
              Enabled := Current.Clearing = null and not Source.Offline and not Source.Paused
                and Locations.HasWork(Source) and not Scan.Running(
                Current,
                Source
              ),
              Loading := Scan.Running(Current, Source), Icon := Sys.Char.ConvertFromUtf32($E145)
            )
          ),
          B.Button<M.Msg>(
            Id + '-edit', 'Edit', M.Msg.EditSource(Source),
            new B.Options(
              Variant := S.ButtonVariant.Outline,
              ControlSize := B.Size.Small,
              Enabled := Current.Clearing = null
            )
          )
        )
      )
    ],
    new Cards.Options(
      Width := L.Extent.Fill,
      Align := L.Alignment.Stretch,
      Padding := 18.0F,
      Gap := 12.0F
    )
  );
end function;

// Builds the library tab.
//
// ## Parameters
// - `Current`: Source preferences, inventory and lightweight scan progress.
// - `Theme`: Palette used by the native destructive action labels.
// ## Returns
// The source list and its actions.
public function View(Current: M.State; Theme: Themes.Theme): E.Element<M.Msg>;
begin
  const Rows: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>();
  Rows.Add(
    E.Row<M.Msg>(
      new L.Flow(
        Gap := Gap(12),
        Align := L.Alignment.Center,
        Justify := L.Justification.Between,
        Wrap := true
      ),
      E.Column<M.Msg>(
        new L.Flow(Gap := Gap(4)),
        Texts.Text<M.Msg>('Music sources', Texts.Appearance.HeadingTwo),
        Texts.Text<M.Msg>('Subfolders are included.', Texts.Appearance.Secondary)
      ),
      B.Button<M.Msg>(
        'add-folder', 'Add folder', M.Msg.ChooseFolder,
        new B.Options(Variant := S.ButtonVariant.Primary, Icon := Sys.Char.ConvertFromUtf32($E13D))
      )
    )
  );
  if Current.Saved.MusicSources.Length = 0 then
    Rows.Add(
      Cards.Card<M.Msg>(
        'empty-sources',
        [
          Empty.EmptyState<M.Msg>(
            'no-sources',
            'No music sources yet',
            new Empty.Options(Icon := Sys.Char.ConvertFromUtf32($E0D7))
          )
        ],
        new Cards.Options(Width := L.Extent.Fill)
      )
    );
  end if;

  for Source: Locations.MusicSource in Current.Saved.MusicSources do
    Rows.Add(SourceCard(Current, Source, Theme));
  end for;

  Rows.Add(
    Cards.Card<M.Msg>(
      'database-card',
      [
        Texts.Text<M.Msg>('Library database', Texts.Appearance.HeadingThree),
        E.Row<M.Msg>(
          new L.Flow(
            Gap := Gap(16), Wrap := true, Align := L.Alignment.Center,
            Justify := L.Justification.Between
          ),
          E.Column<M.Msg>(
            new L.Flow(Gap := Gap(4)),
            Texts.Text<M.Msg>('Clear indexed files for all sources.', Texts.Appearance.Secondary),
            Texts.Text<M.Msg>(
              'Music files, ratings and source settings are kept.',
              Texts.Appearance.Secondary
            )
          ),
          Database.Clear('clear-database', '', 'Clear database', Current, Theme)
        )
      ],
      new Cards.Options(Width := L.Extent.Fill, Padding := 20.0F, Gap := 14.0F)
    )
  );

  return E.Column<M.Msg>(new L.Flow(Gap := Gap(16), Align := L.Alignment.Stretch), Rows.ToArray());
end function;

end unit;
