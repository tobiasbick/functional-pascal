// Music sources listed with their formats and offline setting.
unit FpasAmp.Ui.Settings.Library;

uses
  FpasAmp.Ui.Settings.Model as M, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S,
  Fpas.Ui.Widgets.Actions.Buttons as B, Fpas.Ui.Widgets.Containers.Cards as Cards,
  Fpas.Ui.Widgets.Containers.EmptyStates as Empty, Fpas.Ui.Widgets.Display.Texts as Texts,
  Fpas.Ui.Widgets.Feedback.Badges as Badges, Fpas.Ui.Widgets.Inputs.Switches as Switches,
  System as Sys, System.Collections.Generic as C;

function Gap(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function SourceCard(Source: M.MusicSource; Index: int): E.Element<M.Msg>;
begin
  const Id: string := 'source-' + Index.ToString();
  const Formats: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>();
  if Source.Extensions.Length = 0 then
    Formats.Add(Texts.Text<M.Msg>('No formats selected', Texts.Appearance.Secondary));
  else
    Formats.Add(Texts.Text<M.Msg>('Formats', Texts.Appearance.Secondary));
    for Extension: string in Source.Extensions do
      Formats.Add(Badges.Badge<M.Msg>(Id + Extension, Extension.Substring(1).ToUpperInvariant()));
    end for;
  end if;

  return Cards.Card<M.Msg>(
    Id,
    [
      E.Row<M.Msg>(
        new L.Flow(
          Gap := Gap(16),
          Align := L.Alignment.Center,
          Justify := L.Justification.Between,
          Wrap := true
        ),
        E.Size<M.Msg>(
          E.Column<M.Msg>(
            new L.Flow(Gap := Gap(4)),
            Texts.Text<M.Msg>(Source.Name, Texts.Appearance.HeadingFour),
            Texts.Text<M.Msg>(Source.Path, Texts.Appearance.Secondary)
          ),
          new L.Flex(Basis := L.Extent.Fill)
        ),
        Switches.Switch<M.Msg>(
          Id + '-offline', 'Offline', Source.Offline,
          function(Value: bool): M.Msg => M.Msg.SetOffline(Source.Id, Value)
        )
      ),
      E.Divider<M.Msg>(),
      E.Row<M.Msg>(
        new L.Flow(
          Gap := Gap(12),
          Align := L.Alignment.Center,
          Justify := L.Justification.Between,
          Wrap := true
        ),
        E.Row<M.Msg>(
          new L.Flow(Gap := Gap(8), Align := L.Alignment.Center, Wrap := true),
          Formats.ToArray()
        ),
        B.Button<M.Msg>(
          Id + '-edit', 'Edit', M.Msg.EditSource(Source),
          new B.Options(Variant := S.ButtonVariant.Outline, ControlSize := B.Size.Small)
        )
      )
    ],
    new Cards.Options(
      Width := L.Extent.Fill,
      Align := L.Alignment.Stretch,
      Padding := 18.0F,
      Gap := 12.0F
    )
  );
end function;

// Builds the library tab.
//
// ## Parameters
// - `Sources`: Current music sources in display order.
// ## Returns
// The source list and its actions.
public function View(Sources: array of M.MusicSource): E.Element<M.Msg>;
begin
  const Rows: C.List<E.Element<M.Msg>> := new C.List<E.Element<M.Msg>>();
  Rows.Add(
    E.Row<M.Msg>(
      new L.Flow(
        Gap := Gap(12),
        Align := L.Alignment.Center,
        Justify := L.Justification.Between,
        Wrap := true
      ),
      E.Column<M.Msg>(
        new L.Flow(Gap := Gap(4)),
        Texts.Text<M.Msg>('Music sources', Texts.Appearance.HeadingTwo),
        Texts.Text<M.Msg>('Subfolders are included.', Texts.Appearance.Secondary)
      ),
      B.Button<M.Msg>(
        'add-folder', 'Add folder', M.Msg.ChooseFolder,
        new B.Options(Variant := S.ButtonVariant.Primary, Icon := Sys.Char.ConvertFromUtf32($E13D))
      )
    )
  );
  if Sources.Length = 0 then
    Rows.Add(
      Cards.Card<M.Msg>(
        'empty-sources',
        [
          Empty.EmptyState<M.Msg>(
            'no-sources',
            'No music sources yet',
            new Empty.Options(Icon := Sys.Char.ConvertFromUtf32($E0D7))
          )
        ],
        new Cards.Options(Width := L.Extent.Fill)
      )
    );
  end if;

  for Index: int := 0 to Sources.Length - 1 do
    Rows.Add(SourceCard(Sources[Index], Index));
  end for;

  return E.Column<M.Msg>(new L.Flow(Gap := Gap(16), Align := L.Alignment.Stretch), Rows.ToArray());
end function;

end unit;
