// [Documentation](../../../../../docs/apps/fpas-amp/desktop.md#settings-and-scan-control)

// The settings slice: saved preferences, open dialogs and library status.
unit FpasAmp.Ui.Settings.Model;

uses
  FpasAmp.Library.Sources as Locations, Fpas.Media.Audio as Audio,
  FpasAmp.Library.Inventory.Model as Inv, FpasAmp.Library.Inventory.Progress as Work,
  Fpas.Ui.Widgets.Files.FilePickers as Picker,
  Fpas.Ui.Widgets.Theming.Themes as Themes,
  Fpas.Ui.Widgets.Theming.ThemeSwitchers as Switchers,
  System as Sys;

// The persisted FPas-Amp preferences.
public type Preferences = record
  // Music sources in the user's configured order.
  public MusicSources: array of Locations.MusicSource;
  // Appearance choice in JSON, either light, dark or system.
  public Appearance: string := 'system';
  // Lowercase name of the selected CUI accent.
  public Accent: string := 'neutral';
  // Master volume and ten band gains in dB.
  public Mixer: Audio.Settings := Audio.Settings.Flat;
end record;

// Owner-thread settings state. The rest of the app reads `Saved`; only this
// slice changes it.
public type State = record
  // The last successfully saved preferences.
  public Saved: Preferences;
  // Whether the folder picker is open.
  public PickingFolder: bool := false;
  // Source being added or edited, or null when the editor is closed.
  public Draft: Locations.MusicSource? := null;
  // Whether the last attempted save failed.
  public SaveFailed: bool := false;
  // Last completed or cached inventory, detached from its background owner.
  public Inventory: Inv.Snapshot? := null;
  // Latest lightweight counters, without a full file-list copy.
  public Progress: Work.Snapshot? := null;
  // Clear confirmation target; empty means all sources and null means closed.
  public ConfirmClear: string? := null;
  // Source removal confirmation; removing a source never deletes music or ratings.
  public ConfirmRemove: string? := null;
  // Clear operation currently awaiting acknowledgement.
  public Clearing: string? := null;
  // Background storage/monitoring failure, if any.
  public LibraryError: string? := null;
  // Fatal worker failure, retained across successful operations until a new session.
  public TerminalError: string? := null;
end record;

// Settings proposals and library publications.
public type Msg = variant
  // Change the appearance choice.
  SetAppearance(Choice: Switchers.Selection);
  // Change the accent choice.
  SetAccent(Choice: Themes.Accent);
  // Change whether an existing source is offline.
  SetOffline(Id: string; Offline: bool);
  // Change whether a source's scan/reconciliation is paused.
  SetPaused(Id: string; Paused: bool);
  // Receive a completed inventory publication.
  InventoryReceived(Value: Inv.Snapshot);
  // Receive lightweight scan counters.
  ProgressReceived(Value: Work.Snapshot);
  // Ask for a selected source to be rescanned.
  Rescan(Id: string);
  // Open a native confirmation; empty target means the entire index.
  AskClear(Id: string);
  // Dismiss the current clear confirmation.
  CancelClear;
  // Confirm clearing and automatically persist the affected pause flags.
  ConfirmClear;
  // Receive the post-clear snapshot after the transaction commits.
  Cleared(Id: string; Value: Inv.Snapshot);
  // Open the removal confirmation for a configured music source.
  AskRemove(Id: string);
  // Dismiss the removal confirmation.
  CancelRemove;
  // Remove the source awaiting confirmation.
  ConfirmRemove;
  // Report a background library/storage failure.
  LibraryFailed(Message: string);
  // Report a stopped discovery or metadata worker without dismissing it after a clear.
  LibraryStopped(Message: string);
  // Open the folder picker for a new source.
  ChooseFolder;
  // Receive the chosen path or dismissal from the folder picker.
  FolderResult(Result: Picker.Event);
  // Open an existing source in the editor.
  EditSource(Source: Locations.MusicSource);
  // Change the draft's display name.
  SetName(Name: string);
  // Change the draft's allowed extensions.
  SetFormats(Extensions: array of string);
  // Save the draft and close the editor on success.
  SaveSource;
  // Discard the draft and close the editor.
  CancelEdit;
  // Clear the settings write error.
  DismissError;
end variant;

// Resolves the stored appearance choice.
//
// ## Parameters
// - `Settings`: Preferences with a validated appearance.
// ## Returns
// The selected light, dark or system mode.
public function Appearance(Settings: Preferences): Switchers.Selection;
begin
  return Sys.Enum.Parse<Switchers.Selection>(Settings.Appearance, true);
end function;

// Resolves the stored accent choice.
//
// ## Parameters
// - `Settings`: Preferences with a validated accent.
// ## Returns
// The selected CUI accent.
public function Accent(Settings: Preferences): Themes.Accent;
begin
  return Sys.Enum.Parse<Themes.Accent>(Settings.Accent, true);
end function;

end unit;
