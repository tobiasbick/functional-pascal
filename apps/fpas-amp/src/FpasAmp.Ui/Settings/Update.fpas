// [Documentation](../../../doc/desktop.md#settings-and-scan-control)

// Settings slice update: edits stay synchronous; index clearing runs in the background.
unit FpasAmp.Ui.Settings.Update;

uses
  FpasAmp.Ui.Settings.Model as M, FpasAmp.Ui.Settings.Editing as Editing,
  FpasAmp.Ui.Settings.InventoryState as State, FpasAmp.Library.Sources as Sources,
  FpasAmp.Library.Inventory.Model as Inventory, FpasAmp.Library.Inventory.Progress as Progress,
  FpasAmp.Library.Inventory.Monitoring as Monitoring, Fpas.Ui.Mvu.Application as Mvu,
  System as Sys, System.Threading as T, System.Threading.Tasks as Tasks;

function Clear(Library: Monitoring.Session; Target: string): Mvu.Command<M.Msg>;
begin
  return Mvu.StartBackground<M.Msg>(
    'library-clear',
    async function(Post: function(M.Msg): Tasks.Task; Cancellation: T.CancellationToken): Tasks.Task begin
      const Value: Inventory.Snapshot := await Library.ClearAsync(
        Target,
        Cancellation
      ).ConfigureAwait(false);
      await Post(M.Msg.Cleared(Target, Value)).ConfigureAwait(false);
    end function,
    function(Error: Sys.Exception): M.Msg => M.Msg.LibraryFailed(Error.Message)
  );
end function;

function Step(Current: M.State; Message: M.Msg; Save: procedure(M.Preferences); Library: Monitoring.Session): Mvu.Transition<M.State, M.Msg>;
begin
  case Message of
    when M.Msg.InventoryReceived(const Value: Inventory.Snapshot):
      return new Mvu.Transition<M.State, M.Msg>(State.Receive(Current, Value), []);
    when M.Msg.ProgressReceived(const Value: Progress.Snapshot):
      const Before: Progress.Snapshot? := Current.Progress;
      if Before <> null and Value.Sequence < Before.Sequence then
        return new Mvu.Transition<M.State, M.Msg>(Current, []);
      end if;

      return new Mvu.Transition<M.State, M.Msg>(
        Current with
          Progress := Value;
        end with, []
      );
    when M.Msg.LibraryFailed(const Text: string):
      return new Mvu.Transition<M.State, M.Msg>(
        Current with
          LibraryError := Text;
          Clearing := null;
        end with, []
      );
    when M.Msg.LibraryStopped(const Text: string):
      return new Mvu.Transition<M.State, M.Msg>(
        Current with
          TerminalError := Text;
        end with, []
      );
    when M.Msg.AskClear(const Id: string):
      if Current.Clearing <> null or (Id <> '' and State.Source(Current, Id) = null) then
        return new Mvu.Transition<M.State, M.Msg>(Current, []);
      end if;

      return new Mvu.Transition<M.State, M.Msg>(
        Current with
          ConfirmClear := Id;
          ConfirmRemove := null;
        end with, []
      );
    when M.Msg.CancelClear:
      return new Mvu.Transition<M.State, M.Msg>(
        Current with
          ConfirmClear := null;
        end with, []
      );
    when M.Msg.ConfirmClear:
      const Target: string? := Current.ConfirmClear;
      if Target = null or Current.Clearing <> null then
        return new Mvu.Transition<M.State, M.Msg>(Current, []);
      end if;
      const Paused: M.State := Editing.Persist(Current, State.Pause(Current.Saved, Target), Save);
      if Paused.SaveFailed then
        return new Mvu.Transition<M.State, M.Msg>(Paused, []);
      end if;

      return new Mvu.Transition<M.State, M.Msg>(
        Paused with
          ConfirmClear := null;
          Clearing := Target;
          LibraryError := null;
        end with, [Clear(Library, Target)]
      );
    when M.Msg.Cleared(const Id: string, const Value: Inventory.Snapshot):
      return new Mvu.Transition<M.State, M.Msg>(State.Cleared(Current, Id, Value), []);
    when M.Msg.Rescan(const Id: string):
      const Source: Sources.MusicSource? := State.Source(Current, Id);
      if Source <> null and not Source.Offline and not Source.Paused and Current.Clearing =
        null
      then
        Library.Refresh(Id);
      end if;

      return new Mvu.Transition<M.State, M.Msg>(Current, []);
    else
      return new Mvu.Transition<M.State, M.Msg>(Editing.Apply(Current, Message, Save), []);
  end case;
end function;

// Applies a settings proposal or library publication. Saved source changes that
// affect discovery reconfigure `Library` before any returned command runs.
//
// ## Parameters
// - `Current`: State before the proposal.
// - `Message`: The proposal or publication.
// - `Save`: Persists a validated set of preferences.
// - `Library`: Owns scanning, storage and index clearing.
// ## Returns
// The next settings state and the background clear, when one was confirmed.
public function Apply(Current: M.State; Message: M.Msg; Save: procedure(M.Preferences); Library: Monitoring.Session): Mvu.Transition<M.State, M.Msg>;
begin
  const Next: Mvu.Transition<M.State, M.Msg> := Step(Current, Message, Save, Library);
  if not Sources.SameDiscovery(Current.Saved.MusicSources, Next.Model.Saved.MusicSources) then
    Library.Configure(Next.Model.Saved.MusicSources);
  end if;

  return Next;
end function;

end unit;
