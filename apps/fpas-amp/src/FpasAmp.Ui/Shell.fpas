// [Documentation](../../doc/desktop.md#shell-and-navigation)

// Responsive native shell; all destinations share the same MVU navigation state.
unit FpasAmp.Ui.Shell;

uses
  FpasAmp.Library.Inventory.Monitoring as Monitoring,
  FpasAmp.Ui.Music.LibraryPage as Songs, FpasAmp.Ui.Albums.Music.Model as TrackModel, FpasAmp.Ui.Albums.Music.View as TrackView, FpasAmp.Ui.App.Model as M, FpasAmp.Ui.App.Controller as Updates,
  FpasAmp.Ui.Navigation.Model as Nav, FpasAmp.Ui.Navigation.View as NavView,
  FpasAmp.Ui.Albums.Model as AlbumModel, FpasAmp.Ui.Albums.View as AlbumView,
  Fpas.Ui.Composition as Composition,
  FpasAmp.Ui.Settings.Model as SettingsModel, FpasAmp.Ui.Settings.View as SettingsView,
  FpasAmp.Ui.TagEditor.Model as TagModel, FpasAmp.Ui.TagEditor.View as TagView,
  FpasAmp.Ui.Player.Model as PlayerModel, FpasAmp.Ui.Player.View as PlayerView,
  FpasAmp.Ui.Player.Playback as Playback, Fpas.Media.Audio as Audio,
  Fpas.Ui.Elements as E, Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Gui.Desktop as GuiHost, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Layout as L, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Styles as S,
  Fpas.Ui.Widgets.Actions.IconButtons as Icons, Fpas.Ui.Widgets.Display.Texts as Texts,
  Fpas.Ui.Widgets.Overlays.Sheets as Sheets,
  Fpas.Ui.Widgets.Theming.Themes as Themes, System as Sys,
  FpasAmp.Library.Playlists.Model as Lists,
  FpasAmp.Ui.Radio.View as RadioView, FpasAmp.Ui.Radio.Model as RadioModel,
  FpasAmp.Ui.Podcasts.View as PodcastView;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
// Content width below which the player strip omits its equalizer and meters.
const FullPlayerWidth: int := 760;

function Fixed(Width: int): L.Flex;
begin
  return new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(Width)));
end function;

function SelectedPlaylist(Navigation: Nav.State): Lists.Summary?;
begin
  return case Navigation.Active of
    when Nav.Route.Playlist(const Identity: Lists.Key): Nav.Find(Navigation.Playlists, Identity);
    else null;
  end case;
end function;

// Builds the pure app view from `Current`, measured `Viewport` and resolved `Theme`.
// The native session owns all input, layout and background effects separately.
public function View(Current: M.State; Viewport: L.Viewport; Theme: Themes.Theme): E.Element<M.Msg>;
begin
  const Width: int := Viewport.LogicalWidth ?? if Viewport.Width = L.SizeClass.Compact then
    600
  else
    1000
  end if;
  const Compact: bool := Width < NavView.DrawerBreakpoint;
  var Settings: bool := false;
  case Current.Navigation.Active of
    when Nav.Route.Page(Nav.Page.Settings):
      Settings := true;
    else
  end case;
  const Padding: int := if Compact then
    16
  else
    32
  end if;
  const Content: int := Width - (if Compact then
    0
  else
    NavView.Width + 1
  end if);
  const Selected: Lists.Summary? := SelectedPlaylist(Current.Navigation);
  const Page: E.Element<M.Msg> := if Settings then
    SettingsView.Build<M.Msg>(
      Current.Settings, Current.Navigation.SettingsTab, Theme, Content, Padding, M.Msg.Settings,
      function(Index: int): M.Msg => M.Msg.Navigation(Nav.Msg.SelectSettingsTab(Index))
    )
  elsif Nav.SongTable(Current.Navigation.Active) then
    Composition.Map<TrackModel.Msg, M.Msg>(
      TrackView.LibraryPage(
        Current.Songs.Page,
        Content,
        Padding,
        Current.Songs.Covers,
        Current.Player,
        if Selected <> null then
          Selected.Name
        elsif Current.Navigation.Active <> Nav.Route.Page(Nav.Page.Music) then
          'Playlist'
        else
          null
        end if,
        if Selected = null then
          null
        else
          Selected.Count
        end if,
        if Selected = null then
          null
        else
          Selected.Error
        end if
      ),
      function(Value: TrackModel.Msg): M.Msg => M.Msg.Songs(Songs.Msg.Song(Value))
    )
  elsif Nav.Browsing(Current.Navigation.Active) then
    Composition.Map<AlbumModel.Msg, M.Msg>(
      AlbumView.Build(Current.Albums, Content, Padding, Current.Player), M.Msg.Albums
    )
  elsif Current.Navigation.Active = Nav.Route.Page(Nav.Page.Stations) then
    RadioView.Stations(Current, Content, Padding)
  elsif Current.Navigation.Active = Nav.Route.Page(Nav.Page.Podcasts) then
    PodcastView.Search(Current, Content, Padding)
  else
    case Current.Navigation.Active of
      when Nav.Route.Station(const Id: string): Station(Current, Id, Content, Padding);
      when Nav.Route.Podcast(_): PodcastView.Podcast(Current, Content, Padding);
      else NavView.Placeholder(Current, Padding);
    end case
  end if;
  // Every music destination keeps the player in view; settings do not.
  const Framed: E.Element<M.Msg> := if Settings then
    Page
  else
    E.Column<M.Msg>(
      new L.Flow(Align := L.Alignment.Stretch),
      E.Size<M.Msg>(Page, Fill),
      Composition.Map<PlayerModel.Msg, M.Msg>(
        PlayerView.Build(Current.Player, Content < FullPlayerWidth), M.Msg.Player
      )
    )
  end if;
  const Main: E.Element<M.Msg> := if Compact then
    E.Column<M.Msg>(
      new L.Flow(Align := L.Alignment.Stretch),
      E.Row<M.Msg>(
        new L.Flow(
          Padding := L.Spacing.Fixed(L.Measure.Logical(12)),
          Gap := L.Spacing.Fixed(L.Measure.Logical(8)),
          Align := L.Alignment.Center
        ),
        Icons.IconButton<M.Msg>(
          'drawer-open',
          Sys.Char.ConvertFromUtf32($E115),
          'Navigation',
          M.Msg.Navigation(Nav.Msg.SetDrawer(true))
        ),
        Texts.Text<M.Msg>('FPas-Amp', Texts.Appearance.HeadingThree)
      ), E.Size<M.Msg>(Framed, Fill)
    )
  else
    Framed
  end if;
  const Base: E.Element<M.Msg> := if Compact then
    Sheets.Sheet<M.Msg>(
      'navigation-drawer',
      E.Size<M.Msg>(Main, Fill),
      NavView.Sidebar(Current, Theme, Viewport.LogicalHeight ?? 680),
      Current.Navigation.Drawer,
      new Sheets.Options(
        'FPas-Amp',
        Edge := Sheets.Side.Left,
        Size := Sys.Math.Min(280, Sys.Math.Max(1, Width - 32))
      ),
      M.Msg.Navigation(Nav.Msg.SetDrawer(false))
    )
  else
    E.Size<M.Msg>(
      E.Row<M.Msg>(
        new L.Flow(Align := L.Alignment.Stretch),
        E.Size<M.Msg>(NavView.Sidebar(Current, Theme), Fixed(NavView.Width)),
        E.Size<M.Msg>(E.Styled<M.Msg>(E.Column<M.Msg>(), S.Role.Divider), Fixed(1)),
        E.Size<M.Msg>(Main, Fill)
      ), Fill
    )
  end if;
  const SettingsOverlay: E.Element<M.Msg> := SettingsView.Overlay<M.Msg>(
    Current.Settings,
    Base,
    M.Msg.Settings
  );
  const Editor: TagModel.State? := Current.TagEditor;
  if Editor = null then
    return SettingsOverlay;
  end if;

  return TagView.Build<M.Msg>(
    Editor,
    Width,
    Viewport.LogicalHeight ?? 680,
    SettingsOverlay,
    M.Msg.TagEditor
  );
end function;

function Station(Current: M.State; Id: string; Width: int; Padding: int): E.Element<M.Msg>;
begin
  const Item: RadioModel.Station? := RadioModel.Find(Current.Settings.Saved.RadioFavorites, Id);
  return if Item <> null then
    RadioView.Station(Current, Item, Padding)
  else
    RadioView.Stations(Current, Width, Padding)
  end if;
end function;

// Manually driven native shell, useful for application hosting and focused UI checks.
public type Session = record implements Sys.IDisposable
  // Native session, driven and disposed on its creating thread.
  public Window: Gui.Session<M.Msg>;
  Read: function(): M.State;

  // Reads the latest owner-thread model, including accepted background publications.
  public function State(): M.State;
  begin
    return self.Read();
  end function;

  // Releases the GUI and its owned subscriptions, leaving the caller-owned library.
  public procedure Dispose();
  begin
    self.Window.Dispose();
  end procedure;

  // Creates a shell for Window and Settings; Save persists preferences and
  // Library remains caller-owned. Optional Navigation restores the destination
  // and settings tab; a playlist is validated against its first background snapshot.
  // Output transfers ownership of an optional playback session to the shell.
  // By default the shell opens the desktop's audio output on first playback.
  // Restored supplies the paused queue and playhead from the previous window.
  public static function Start(Window: Cui.CuiWindowPlacement; Settings: SettingsModel.Preferences; Save: procedure(SettingsModel.Preferences); Library: Monitoring.Session; Navigation: Nav.State? := null; Output: Audio.ISession? := null; Restored: PlayerModel.State? := null): Session;
  requires Settings.MusicSources <> null;
  begin
    const Device: Audio.ISession := Output ?? new Audio.Session();
    try
      return Session.Connect(Window, Settings, Save, Library, Navigation, Device, Restored);
    catch do
      Device.Dispose();
      raise;
    end try;
  end function;

  static function Connect(Window: Cui.CuiWindowPlacement; Settings: SettingsModel.Preferences; Save: procedure(SettingsModel.Preferences); Library: Monitoring.Session; Navigation: Nav.State?; Device: Audio.ISession; Restored: PlayerModel.State?): Session;
  begin
    const Port: Playback.Connection := new Playback.Connection(Device);
    discard Port.Requests.Writer.TryWrite(PlayerModel.Request.Mixer(Settings.Mixer));
    const Player: PlayerModel.State := Restored ?? new PlayerModel.State();
    const InitialNavigation: Nav.State := Navigation ?? new Nav.State();
    const Initial: M.State := new M.State(
      new SettingsModel.State(Settings), Navigation := InitialNavigation,
      Albums := new AlbumModel.State(Offsets := InitialNavigation.CoverScroll),
      Player := Player with
        Playing := false;
        NeedsOpen := PlayerModel.Track(Player) <> null;
        Volume := Settings.Mixer.Volume;
        Gains := Settings.Mixer.Gains;
      end with
    );
    if not Nav.ValidSettingsTab(Initial.Navigation.SettingsTab) then
      raise new Sys.ArgumentOutOfRangeException('Navigation');
    end if;
    var Last: M.State := Initial;
    const Native: Gui.Session<M.Msg> := GuiHost.StartThemed<M.State, M.Msg>(
      Initial,
      function(Current: M.State; Message: M.Msg): Mvu.Transition<M.State, M.Msg> begin
        const Next: Mvu.Transition<M.State, M.Msg> := Updates.Apply(
          Current,
          Message,
          Save,
          Library, Port
        );
        Last := Next.Model;
        return Next;
      end function,
      View,
      new GuiHost.Options(
        Title := 'FPas-Amp', AppId := 'io.github.tobiasbick.FpasAmp',
        Theme := M.Theme(Initial, null), Placement := Window
      ),
      M.Theme,
      OnCloseRequested := function(): M.Msg => M.Msg.Closing(Playback.Stop(Last.Player, Port))
    );
    discard Native.Post(M.Msg.WatchLibrary);
    const Observed: Gui.Session<M.Msg> := Gui.Session<M.Msg>.Create(
      function(): bool begin
        if not Native.Step() then
          return false;
        end if;

        const Music: bool := Nav.SongTable(Last.Navigation.Active);
        if Music or (Nav.Browsing(Last.Navigation.Active) and Last.Albums.Music = null) then
          const Frame: Gui.Frame := Native.Snapshot();
          const WindowWidth: int := Sys.Convert.ToInt32(Frame.Size.Width);
          const Compact: bool := WindowWidth < NavView.DrawerBreakpoint;
          const Available: int := WindowWidth - (if Compact then
            32
          else
            NavView.Width + 65
          end if);
          const Columns: int := if Music then
            1
          else
            AlbumView.Columns(Sys.Math.Max(1, Available))
          end if;
          const Count: int := if Music then
            Last.Songs.Page.Shown.Length
          else
            Last.Albums.Shown.Length
          end if;
          const Id: string := if Music then
            'music-tracks'
          else
            AlbumView.GridId(Last.Albums)
          end if;
          var Seen: bool := false;
          for Control: Gui.Control in Frame.Controls do
            if Control.Id = Id then
              Seen := true;
              const Parts: array of string := Control.Value.Split(#58);
              var First: int := 0;
              var End: int := 0;
              if Parts.Length = 2 and int.TryParse(
                Parts[0],
                out First
              ) and int.TryParse(Parts[1], out End)
              then
                const Start: int := Sys.Math.Min(Count, First * Columns);
                const Finish: int := Sys.Math.Min(Count, End * Columns);
                if Music then
                  if Start <> Last.Songs.First or Finish <> Last.Songs.Last then
                    discard Native.Post(M.Msg.Songs(Songs.Msg.Visible(Start, Finish)));
                  end if;
                elsif Start <> Last.Albums.First or Finish <> Last.Albums.Last then
                  discard Native.Post(M.Msg.Albums(AlbumModel.Msg.Visible(Start, Finish)));
                end if;
              end if;
            end if;
          end for;

          if Music and not Seen and (Last.Songs.First <> 0 or Last.Songs.Last <> 0) then
            discard Native.Post(M.Msg.Songs(Songs.Msg.Visible(0, 0)));
          end if;
        end if;

        return true;
      end function,
      Native.Post,
      Native.Snapshot,
      Native.IsOpen,
      Native.IsSoftware,
      procedure() begin
        try
          discard Device.StopPlayback();
          Native.Dispose();
        finally
          try
            Device.Dispose();
          finally
            Playback.Clean(Port);
          end try;
        end try;
      end procedure,
      Native.CapturePng,
      Native.Placement,
      Native.InspectWindow
    );
    return new Session(Observed, function(): M.State => Last);
  end function;
end record;

// Runs the shell for Window/Settings until close. Navigation is restored and
// returned by reference, Save persists preferences, and Library stays caller-owned.
// Returns the final host placement for storage alongside the selected destination.
// Player supplies the paused transport and receives the last observed state at close.
public function Run(Window: Cui.CuiWindowPlacement; Settings: SettingsModel.Preferences; ref Navigation: Nav.State; ref Player: PlayerModel.State; Save: procedure(SettingsModel.Preferences); Library: Monitoring.Session): Cui.CuiWindowPlacement;
requires Navigation.SettingsTab >= 0 and Navigation.SettingsTab <= 2;
begin
  using const Running: Session := Session.Start(
    Window,
    Settings,
    Save,
    Library,
    Navigation,
    Restored := Player
  );
  while Running.Window.Step() do
  end while;

  const Last: M.State := Running.State();
  Navigation := Last.Navigation with
    CoverScroll := Last.Albums.Offsets;
  end with;
  Player := Last.Player;
  if Updates.SaveMixer(Last, Save).SaveFailed then
    Sys.Console.Error.WriteLine('Could not save the final mixer settings.');
  end if;

  return Running.Window.Placement();
end function;

end unit;
