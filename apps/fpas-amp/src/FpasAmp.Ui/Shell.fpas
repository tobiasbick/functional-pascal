// The FPas-Amp desktop window.
unit FpasAmp.Ui.Shell;

uses
  FpasAmp.Library.Sources as Locations,
  FpasAmp.Ui.Settings.Editor as Editor, FpasAmp.Ui.Settings.General as General,
  FpasAmp.Ui.Settings.Library as LibraryView, FpasAmp.Ui.Settings.Model as M,
  FpasAmp.Ui.Settings.Controller as Updates, FpasAmp.Library.Inventory.Monitoring as Monitoring,
  Fpas.Ui.Elements as E, Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Layout as L,
  Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Display.Texts as Texts,
  Fpas.Ui.Widgets.Feedback.Alerts as Alerts, Fpas.Ui.Widgets.Files.FilePickers as Picker,
  Fpas.Ui.Widgets.Navigation.Navigation as Nav, Fpas.Ui.Widgets.Navigation.Tabs as Tabs,
  Fpas.Ui.Widgets.Theming.Themes as Themes, System as Sys;

const DisplayName: string := 'FPas-Amp';
const SettingsLabel: string := 'Settings';
const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);

function Points(Value: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Value));
end function;

function Fixed(Width: int): L.Flex;
begin
  return new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(Width)));
end function;

function SettingsPage(Current: M.State; Tab: int; Theme: Themes.Theme; Padding: int): E.Element<M.Msg>;
begin
  const Header: E.Element<M.Msg> := Tabs.Tabs<M.Msg>(
    'settings-tabs', [new Tabs.Item('General'), new Tabs.Item('Library')], Tab, M.Msg.SelectTab
  );
  const Body: E.Element<M.Msg> := if Tab = 0 then
    General.View(Current, Theme)
  else
    LibraryView.View(Current, Theme)
  end if;
  const Error: string? := Current.TerminalError ?? Current.LibraryError;
  const MainBody: E.Element<M.Msg> := if Error = null then
    Body
  else
    E.Column<M.Msg>(
      new L.Flow(Gap := Points(16), Align := L.Alignment.Stretch),
      Alerts.Alert<M.Msg>(
        'library-error',
        'Library operation failed',
        new Alerts.Options(Tone := S.Tone.Danger, Description := Error)
      ),
      Body
    )
  end if;
  const Content: array of E.Element<M.Msg> := if Current.SaveFailed and Current.Draft = null then
    [
      Texts.Text<M.Msg>(SettingsLabel, Texts.Appearance.HeadingOne),
      Header,
      Alerts.Alert<M.Msg>(
        'settings-save-error', 'Could not save settings. Try again.',
        new Alerts.Options(Tone := S.Tone.Danger, Dismissible := true),
        function(): M.Msg => M.Msg.DismissError
      ),
      MainBody
    ]
  else
    [Texts.Text<M.Msg>(SettingsLabel, Texts.Appearance.HeadingOne), Header, MainBody]
  end if;
  return E.ScrollView<M.Msg>(
    'settings-scroll',
    E.Column<M.Msg>(
      new L.Flow(Padding := Points(Padding), Gap := Points(20), Align := L.Alignment.Stretch),
      Content
    )
  );
end function;

function View(Current: M.State; Viewport: L.Viewport; Theme: Themes.Theme): E.Element<M.Msg>;
begin
  const Compact: bool := Viewport.Width = L.SizeClass.Compact;
  const Tab: int? := Current.Tab;
  const Sidebar: E.Element<M.Msg> := E.Column<M.Msg>(
    new L.Flow(
      Padding := Points(12),
      Gap := Points(16),
      Align := L.Alignment.Stretch,
      Background := Theme.Colors.SurfaceMuted
    ),
    E.Row<M.Msg>(
      new L.Flow(Padding := Points(4)),
      Texts.Text<M.Msg>(DisplayName, Texts.Appearance.HeadingThree)
    ),
    E.Spacer<M.Msg>(),
    Nav.Sidebar<M.Msg>(
      'navigation', [
        new Nav.Section<M.Msg>(
          '', [
            new Nav.Item<M.Msg>(
              'settings',
              SettingsLabel,
              M.Msg.OpenSettings,
              Icon := Sys.Char.ConvertFromUtf32($E154)
            )
          ]
        )
      ],
      if Tab <> null then
        'settings'
      else
        null
      end if
    )
  );
  const Main: E.Element<M.Msg> := if Tab = null then
    E.Column<M.Msg>()
  else
    SettingsPage(
      Current, Tab.Value, Theme, if Compact then
        16
      else
        32
      end if
    )
  end if;
  const Base: E.Element<M.Msg> := E.Size<M.Msg>(
    E.Row<M.Msg>(
      new L.Flow(Align := L.Alignment.Stretch),
      E.Size<M.Msg>(
        Sidebar, Fixed(
          if Compact then
            138
          else
            206
          end if
        )
      ),
      E.Size<M.Msg>(E.Styled<M.Msg>(E.Column<M.Msg>(), S.Role.Divider), Fixed(1)),
      E.Size<M.Msg>(Main, Fill)
    ),
    Fill
  );
  if Current.PickingFolder then
    return Picker.FilePicker<M.Msg>(
      'music-folder-picker', true, M.Msg.FolderResult,
      new Picker.Options(
        Kind := Picker.Mode.Folder, Title := 'Choose a music folder',
        Start := Sys.Environment.GetFolderPath(Sys.Environment.SpecialFolder.MyMusic)
      ),
      Base
    );
  end if;
  const Draft: Locations.MusicSource? := Current.Draft;
  return if Draft = null then
    Base
  else
    Editor.View(Base, Draft, Current.SaveFailed)
  end if;
end function;

// Manually driven native shell, useful for application hosting and focused UI checks.
public type Session = record implements Sys.IDisposable
  // Native session, driven and disposed on its creating thread.
  public Window: Gui.Session<M.Msg>;
  Read: function(): M.State;

  // Reads the latest owner-thread model, including accepted background publications.
  public function State(): M.State;
  begin
    return self.Read();
  end function;

  // Releases the GUI session and its owned MVU subscriptions, not the external library.
  public procedure Dispose();
  begin
    self.Window.Dispose();
  end procedure;

  // Creates the shell. `Library` is caller-owned; `Save` persists accepted preferences.
  // `Tab` is General (0), Library (1), or null for the initially empty shell.
  public static function Start(Window: Cui.CuiWindowPlacement; Settings: M.Preferences; Save: procedure(M.Preferences); Library: Monitoring.Session; Tab: int? := null): Session;
  requires Tab = null or Tab = 0 or Tab = 1;
  begin
    const Initial: M.State := new M.State(Settings, Tab := Tab);
    var Last: M.State := Initial;
    const Native: Gui.Session<M.Msg> := Gui.StartThemed<M.State, M.Msg>(
      Initial,
      function(Current: M.State; Message: M.Msg): Mvu.Transition<M.State, M.Msg> begin
        const Next: Mvu.Transition<M.State, M.Msg> := Updates.Apply(
          Current,
          Message,
          Save,
          Library
        );
        Last := Next.Model;
        return Next;
      end function,
      View,
      new Gui.Options(Title := DisplayName, Theme := M.Theme(Initial, null), Placement := Window),
      M.Theme
    );
    discard Native.Post(M.Msg.WatchLibrary);
    return new Session(Native, function(): M.State => Last);
  end function;
end record;

// Opens the desktop shell and runs it until the window closes.
//
// ## Parameters
// - `Window`: Saved normal size and place, and whether the window was maximized.
//   The native window rejects a size below one logical unit.
// - `Settings`: Validated preferences loaded at startup.
// - `Tab`: Initial settings tab, updated to the last selection on close.
//   0 opens General, 1 opens Library, and null opens the empty shell.
// - `Save`: Persists a new set of validated preferences.
// - `Library`: Caller-owned scan/storage lifetime; the GUI only posts control requests.
// ## Returns
// The window's placement when it closed, to restore at the next start.
public function Run(
  Window: Cui.CuiWindowPlacement; Settings: M.Preferences; ref Tab: int?;
  Save: procedure(M.Preferences); Library: Monitoring.Session
): Cui.CuiWindowPlacement;
requires Tab = null or Tab = 0 or Tab = 1;
begin
  using const Running: Session := Session.Start(Window, Settings, Save, Library, Tab);
  while Running.Window.Step() do
  end while;

  Tab := Running.State().Tab;
  return Running.Window.Placement();
end function;

end unit;
