// [Documentation](../../../doc/desktop.md#editing-track-tags)

unit FpasAmp.Ui.TagEditor.MusicBrainz;

uses FpasAmp.Ui.Providers.RequestPacing as Pacing;
uses FpasAmp.Ui.TagEditor.MusicBrainzTags as Tags;
uses MetaBrainz.MusicBrainz as B;
uses MetaBrainz.MusicBrainz.Interfaces.Entities as E;
uses MetaBrainz.MusicBrainz.Interfaces.Searches as S;
uses Microsoft.Extensions.Http.Resilience as R;
uses Polly as P;
uses Polly.Retry as Retry;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Net.Http as H;
uses System.Net.Http.Headers as Headers;
uses System.Reflection as Reflection;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

// One selectable pairing of a recording with a release.
public type Match = record
  // Recording UUID.
  public Recording: string;
  // Release UUID, empty for a recording without a release.
  public Release: string;
  // Text shown in the match dropdown.
  public Label: string;
end record;

const RetryCount: int := 5;
const TimeoutSeconds: int := 30;

function Diagnostics(Reply: H.HttpResponseMessage; Attempt: int): string;
begin
  const Hint: Headers.RetryConditionHeaderValue? := Reply.Headers.RetryAfter;
  const Request: H.HttpRequestMessage? := Reply.RequestMessage;
  const Address: Sys.Uri? := if Request <> null then
    Request.RequestUri
  else
    null
  end if;
  const Route: string := case Address of
    when is Sys.Uri as Value: Value.AbsolutePath;
    else '/ws/2/';
  end case;
  return 'HTTP/' + Reply.Version.ToString() + ' ' +
    (cast Reply.StatusCode as int).ToString() +
    ' ' + (Reply.ReasonPhrase ?? '') + ' · GET ' + Route + ' · attempt ' +
    (Attempt + 1).ToString() + '/' + (RetryCount + 1).ToString() +
    (if Hint <> null then
      ' · Retry-After: ' + Hint.ToString()
    else
      ''
    end if);
end function;

function RetryDelay(Reply: H.HttpResponseMessage; Attempt: int): long;
begin
  return Sys.Math.Max(
    Pacing.RetryAfter(Reply), 2000L shl Sys.Math.Min(Attempt, RetryCount - 1)
  );
end function;

function CreateQuery(Endpoint: Sys.Uri; Gate: Pacing.Gate; Failure: array of string): B.Query;
begin
  const Options: R.HttpRetryStrategyOptions := new R.HttpRetryStrategyOptions();
  Options.MaxRetryAttempts := RetryCount;
  Options.ShouldHandle := function(Args: Retry.RetryPredicateArguments of H.HttpResponseMessage): Tasks.ValueTask of bool begin
    const Reply: H.HttpResponseMessage? := Args.Outcome.Result;
    if Reply = null or Reply.IsSuccessStatusCode then
      Failure[0] := '';
      return new Tasks.ValueTask of bool(false);
    end if;

    Failure[0] := Diagnostics(Reply, Args.AttemptNumber);
    const Status: int := cast Reply.StatusCode as int;
    const Transient: bool := Status = 429 or Status = 503;
    Gate.Cooldown(
      if Transient then
        RetryDelay(Reply, Args.AttemptNumber)
      else
        Pacing.RetryAfter(Reply)
      end if
    );
    return new Tasks.ValueTask of bool(Transient);
  end function;
  Options.DelayGenerator := function(Args: Retry.RetryDelayGeneratorArguments of H.HttpResponseMessage): Tasks.ValueTask of Sys.TimeSpan? begin
    const Reply: H.HttpResponseMessage? := Args.Outcome.Result;
    const Delay: Sys.TimeSpan? := if Reply <> null then
      Sys.TimeSpan.FromMilliseconds(cast RetryDelay(Reply, Args.AttemptNumber) as double)
    else
      null
    end if;
    return new Tasks.ValueTask of Sys.TimeSpan? (Delay);
  end function;

  const Builder: P.ResiliencePipelineBuilder of H.HttpResponseMessage := new P.ResiliencePipelineBuilder of H.HttpResponseMessage();
  discard P.RetryResiliencePipelineBuilderExtensions.AddRetry of H.HttpResponseMessage(
    Builder,
    Options
  );
  discard P.TimeoutResiliencePipelineBuilderExtensions.AddTimeout of P.ResiliencePipelineBuilder of H.HttpResponseMessage(
    Builder, Sys.TimeSpan.FromSeconds(TimeoutSeconds)
  );
  const Handler: R.ResilienceHandler := new R.ResilienceHandler(Builder.Build());
  Handler.InnerHandler := new H.HttpClientHandler();
  const Client: H.HttpClient := new H.HttpClient(Handler);
  Client.Timeout := T.Timeout.InfiniteTimeSpan;
  const Version: Sys.Version := Reflection.Assembly.GetExecutingAssembly().GetName().Version ??
    new Sys.Version(1, 0);
  Client.DefaultRequestHeaders.UserAgent.ParseAdd(
    'FPas-Amp/' + Version.ToString() + ' (https://github.com/tobiasbick/functional-pascal)'
  );

  const Provider: B.Query := new B.Query(Client, true);
  Provider.UrlScheme := Endpoint.Scheme;
  Provider.Server := Endpoint.Host;
  Provider.Port := Endpoint.Port;
  return Provider;
end function;

function Choices(Results: S.ISearchResults of S.ISearchResult of E.IRecording): array of Match;
begin
  const Result: C.List of Match := new C.List of Match();
  for Hit: S.ISearchResult of E.IRecording in Results.Results do
    const Recording: E.IRecording := Hit.Item;
    const Id: string := Recording.Id.ToString('D');
    const Title: string := Recording.Title + ' · ' + Tags.Artists(Recording.ArtistCredit);
    if Recording.Releases.Count = 0 then
      Result.Add(new Match(Id, '', Title));
    end if;

    for Release: E.IRelease? in Recording.Releases do
      if Release = null then
        continue;
      end if;
      const Date: B.PartialDate? := Release.Date;
      const Country: string := Release.Country ?? '';
      const Dated: string := case Date of
        when is B.PartialDate as Value: Release.Title + ' · ' + Value.ToString();
        else Release.Title;
      end case;
      Result.Add(
        new Match(
          Id, Release.Id.ToString('D'), Dated +
            (if Country <> '' then
              ' · ' + Country
            else
              ''
            end if) + ' — ' + Title
        )
      );
      if Result.Count >= 100 then
        return Result.ToArray();
      end if;
    end for;

    if Result.Count >= 100 then
      return Result.ToArray();
    end if;
  end for;

  return Result.ToArray();
end function;

function Terms(Input: string): string;
  function Phrase(Value: string): string;
  begin
    return '"' + Value.Trim().Replace('\', '\\').Replace('"', '\"') + '"';
  end function;
begin
  const Parts: array of string := Input.Split(' · ', 2, Sys.StringSplitOptions.TrimEntries);
  return 'recording:' + Phrase(Parts[0]) + (if Parts.Length = 2 and Parts[1] <> '' then
    ' AND artist:' + Phrase(Parts[1])
  else
    ''
  end if);
end function;

// A MusicBrainz service with a shared request slot, retry policy and typed queries.
public type Service = record implements Sys.IDisposable
  Query: B.Query;
  Gate: Pacing.Gate;
  Failure: array of string;

  // Opens a MusicBrainz-compatible HTTP Endpoint for the lifetime of this service.
  public static function Connect(Endpoint: Sys.Uri): Service;
  begin
    if not Endpoint.IsAbsoluteUri then
      raise new Sys.ArgumentException('MusicBrainz requires an absolute service URL.');
    end if;
    const Slot: Pacing.Gate := Pacing.Gate.Create(1000L);
    const LastFailure: array of string := [''];
    return new Service(CreateQuery(Endpoint, Slot, LastFailure), Slot, LastFailure);
  end function;

  // Closes the HTTP client owned by this service.
  public procedure Dispose();
  begin
    self.Query.Dispose();
  end procedure;

  // Returns the request slot state and the current cooldown.
  public function Availability(): Pacing.Status;
  begin
    return self.Gate.Read();
  end function;

  async function Run of TResult(Request: function(): Tasks.Task of TResult; Stop: T.CancellationToken): Tasks.Task of TResult;
  begin
    await self.Gate.Enter(Stop).ConfigureAwait(false);
    try
      await self.Gate.Start(Stop).ConfigureAwait(false);
      self.Failure[0] := '';
      return await Request().ConfigureAwait(false);
    catch Error: Sys.Exception when not Stop.IsCancellationRequested and self.Failure[0] <> '' do
      raise new H.HttpRequestException(self.Failure[0], Error);
    finally
      self.Gate.Cooldown(1000L);
      self.Gate.Leave();
    end try;
  end function;

  // Searches MusicBrainz for Input and returns selectable matches, honoring Stop.
  public async function Search(Input: string; Stop: T.CancellationToken): Tasks.Task of array of Match;
  begin
    return Choices(
      await self.Run of S.ISearchResults of S.ISearchResult of E.IRecording(
        function(): Tasks.Task of S.ISearchResults of S.ISearchResult of E.IRecording => self.Query.FindRecordingsAsync(
          Terms(Input),
          12,
          null,
          false,
          Stop
        ),
        Stop
      ).ConfigureAwait(false)
    );
  end function;

  // Looks up recording Id with credits and genres, honoring Stop.
  public function Recording(Id: string; Stop: T.CancellationToken): Tasks.Task of E.IRecording;
  begin
    const Key: Sys.Guid := Sys.Guid.ParseExact(Id, 'D');
    return self.Run of E.IRecording(
      function(): Tasks.Task of E.IRecording => self.Query.LookupRecordingAsync(
        Key, B.Include.ArtistCredits or B.Include.Genres or B.Include.ArtistRelationships
          or B.Include.WorkRelationships or B.Include.WorkLevelRelationships, null, null, Stop
      ), Stop
    );
  end function;

  // Looks up release Id with its track list and labels, honoring Stop.
  public function Release(Id: string; Stop: T.CancellationToken): Tasks.Task of E.IRelease;
  begin
    const Key: Sys.Guid := Sys.Guid.ParseExact(Id, 'D');
    return self.Run of E.IRelease(
      function(): Tasks.Task of E.IRelease => self.Query.LookupReleaseAsync(
        Key, B.Include.ArtistCredits or B.Include.Recordings or B.Include.Labels
          or B.Include.ReleaseGroups, Stop
      ), Stop
    );
  end function;
end record;

// The service shared by all tag editor sessions.
public const Live: Service := Service.Connect(new Sys.Uri('https://musicbrainz.org'));

end unit;
