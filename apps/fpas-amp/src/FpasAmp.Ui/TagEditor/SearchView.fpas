// [Documentation](../../../doc/desktop.md#editing-track-tags)

unit FpasAmp.Ui.TagEditor.SearchView;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Inputs.Selects as Select;
uses Fpas.Ui.Widgets.Inputs.TextFields as Fields;

uses FpasAmp.Ui.TagEditor.Model as M;
uses FpasAmp.Ui.TagEditor.MusicBrainz as MB;
uses System.Collections.Generic as C;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
const Flow: L.Flow := new L.Flow(
  Gap := L.Spacing.Fixed(L.Measure.Logical(8)),
  Align := L.Alignment.Center
);

// Builds the provider controls and result picker for Current at the dialog Width.
// Returns a row on wide layouts and two stacked rows on narrower layouts.
public function Build(Current: M.State; Width: int): E.Element of M.Msg;
begin
  const Ready: bool := not Current.Saving and not Current.Searching and not Current.Scanning;
  const MusicReady: bool := Ready and not Current.Provider.Busy and Current.Provider.Seconds = 0L;
  const ScanReady: bool := Ready and Current.CanScan and not Current.AcoustId.Busy
    and Current.AcoustId.Seconds = 0L;
  const Matches: C.List of Select.Item := new C.List of Select.Item();
  for Item: MB.Match in Current.Matches do
    Matches.Add(new Select.Item(Item.Label));
  end for;

  if Matches.Count = 0 then
    Matches.Add(new Select.Item('Search or scan for a recording'));
  end if;
  const Picker: E.Element of M.Msg := Select.Select of M.Msg(
    'tag-match', Matches.ToArray(), Current.Match, M.Msg.Lookup,
    new Select.Options(
      Placeholder := 'Choose recording / release', Searchable := true,
      Enabled := Current.Matches.Length > 0 and MusicReady
    )
  );
  const Query: E.Element of M.Msg := Fields.TextField of M.Msg(
    'tag-query', Current.Query, M.Msg.Query,
    new Fields.Options(Enabled := not Current.Saving, MaxUtf8Bytes := 4095),
    OnSubmit := function(_Value: string): M.Msg => M.Msg.Search
  );
  const Search: E.Element of M.Msg := B.Button of M.Msg(
    'tag-search', 'Search MusicBrainz', M.Msg.Search,
    new B.Options(
      Variant := S.ButtonVariant.Outline,
      ControlSize := B.Size.Medium,
      Enabled := MusicReady and Current.Query.Trim() <> ''
    )
  );
  const Scan: E.Element of M.Msg := B.Button of M.Msg(
    'tag-scan', 'Scan AcoustID', M.Msg.Scan,
    new B.Options(
      Variant := S.ButtonVariant.Outline, ControlSize := B.Size.Medium, Enabled := ScanReady,
      Tooltip := if Current.CanScan then
        'Find matching recordings by audio fingerprint'
      else
        'Set an AcoustID application key in Settings → Metadata'
      end if
    )
  );
  if Width < 680 then
    return E.Column of M.Msg(
      new L.Flow(Gap := Flow.Gap, Align := L.Alignment.Stretch),
      Query, E.Row of M.Msg(Flow, Search, Scan), Picker
    );
  end if;

  return E.Row of M.Msg(
    Flow, E.Size of M.Msg(Query, Fill), Search, Scan,
    E.Size of M.Msg(Picker, new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(255))))
  );
end function;

// Returns Current's active provider status, cooldown, or selection count.
public function Status(Current: M.State): string;
begin
  if Current.Scanning then
    return 'Waiting for AcoustID…';
  end if;

  if Current.Provider.Seconds > 0L then
    return 'MusicBrainz · next request in ' + Current.Provider.Seconds.ToString() + ' s';
  end if;

  if Current.Searching or Current.Provider.Busy then
    return 'Waiting for MusicBrainz…';
  end if;

  if Current.AcoustId.Seconds > 0L then
    return 'AcoustID · next request in ' + Current.AcoustId.Seconds.ToString() + ' s';
  end if;

  return Current.Selected.Count.ToString() + ' MusicBrainz values selected across all tabs';
end function;

end unit;
