// Stores window placement and a validated navigation selection.
unit FpasAmp.AppState;

uses
  Fpas.Ui.Gui.Cui as Cui,
  FpasAmp.Persistence.JsonFields as Fields,
  FpasAmp.Persistence.UserFiles as Files,
  FpasAmp.Ui.Navigation.Model as Nav,
  FpasAmp.Persistence.PlayerState as Transport,
  System.IO as IO,
  System as Sys,
  System.Text.Json as J;

// The window's normal bounds, last maximized state and selected page.
public type Snapshot = record
  // Normal window width in logical units.
  public Width: int := 1000;
  // Normal window height in logical units.
  public Height: int := 680;
  // Left edge of the normal window's content in desktop coordinates, when known.
  public X: int? := null;
  // Top edge of the normal window's content in desktop coordinates, when known.
  public Y: int? := null;
  // Whether the window was maximized.
  public Maximized: bool := false;
  // Last settings tab: 0 for General or 1 for Library.
  public SettingsTab: int := 0;
  // Static destination or playlist store/UUID key; never a display name or index.
  public ActivePage: string := 'music';
  // Playback queue and the position to restore in pause.
  public Player: Transport.Saved := new Transport.Saved();
end record;

const FileName: string := 'state.json';

function Coordinate(Root: J.JsonElement; Key: string; ref Valid: bool): int?;
begin
  const Field: J.JsonElement := Fields.Field(Root, Key);
  const Value: int? := Fields.IntegerValue(Field);
  if Value = null and Field.ValueKind <> J.JsonValueKind.Null then
    Valid := false;
  end if;

  return Value;
end function;

function Dimension(Root: J.JsonElement; Key: string; Fallback: int; ref Valid: bool): int;
begin
  const Value: int := Fields.IntegerValue(Fields.Field(Root, Key)) ?? 0;
  if Value <= 0 then
    Valid := false;
    return Fallback;
  end if;

  return Value;
end function;

function SelectedTab(Root: J.JsonElement; ref Valid: bool): int;
begin
  // An absent/null optional selection uses the initial settings tab.
  var Field: J.JsonElement := new J.JsonElement();
  if Root.ValueKind = J.JsonValueKind.Object and not Root.TryGetProperty(
    'settingsTab',
    out Field
  )
  then
    return 0;
  end if;

  Field := Fields.Field(Root, 'settingsTab');
  if Field.ValueKind = J.JsonValueKind.Null then
    return 0;
  end if;
  const Value: int? := Fields.IntegerValue(Field);
  if Value = 0 or Value = 1 then
    return Value.Value;
  end if;

  Valid := false;
  return 0;
end function;

function Decode(Root: J.JsonElement): Files.Decoded<Snapshot>;
begin
  const Defaults: Snapshot := new Snapshot();
  var Valid: bool := true;
  const Width: int := Dimension(Root, 'width', Defaults.Width, ref Valid);
  const Height: int := Dimension(Root, 'height', Defaults.Height, ref Valid);
  const X: int? := Coordinate(Root, 'x', ref Valid);
  const Y: int? := Coordinate(Root, 'y', ref Valid);
  const Maximized: bool? := Fields.BooleanValue(Fields.Field(Root, 'maximized'));
  const Tab: int := SelectedTab(Root, ref Valid);
  const PageField: J.JsonElement := Fields.Field(Root, 'activePage');
  const Page: string := Fields.StringValue(PageField) ?? 'music';
  const Route: Nav.Route? := Nav.Parse(Page);
  if Route = null or (PageField.ValueKind <> J.JsonValueKind.Undefined and PageField.ValueKind <>
    J.JsonValueKind.String)
  then
    Valid := false;
  end if;

  return new Files.Decoded<Snapshot>(
    new Snapshot(
      Width, Height, X, Y, Maximized ?? Defaults.Maximized, Tab, if Route <> null then
        Nav.Key(Route)
      else
        'music'
      end if, Transport.Decode(Fields.Field(Root, 'player'), ref Valid)
    ),
    Valid and Maximized <> null
  );
end function;

// Loads the window and selected page, repairing a damaged state file when possible.
//
// ## Parameters
// - `Directory`: Absolute directory for the user's files.
// ## Returns
// The saved state with positive dimensions and a valid static/playlist route.
public function Load(Directory: string): Snapshot;
requires Directory.Length > 0;
ensures (Value: Snapshot): Value.Width > 0 and Value.Height > 0;
begin
  return Files.Load<Snapshot>(IO.Path.Combine(Directory, FileName), new Snapshot(), Decode);
end function;

// Validates and saves the window and selected page.
//
// ## Parameters
// - `Directory`: Absolute directory for the user's files.
// - `Value`: Positive normal dimensions, tab 0 or 1, and a valid route key.
public procedure Save(Directory: string; Value: Snapshot);
requires Directory.Length > 0;
requires Value.Width > 0;
requires Value.Height > 0;
requires Value.SettingsTab = 0 or Value.SettingsTab = 1;
begin
  if Nav.Parse(Value.ActivePage) = null then
    raise new Sys.ArgumentException('Invalid navigation route.', 'Value');
  end if;

  Files.Save<Snapshot>(IO.Path.Combine(Directory, FileName), Value, Decode);
end procedure;

// Converts a stored placement for the GUI host.
//
// ## Parameters
// - `Value`: Placement with positive normal dimensions.
// ## Returns
// The host placement; without both coordinates the system chooses the place.
public function ToWindow(Value: Snapshot): Cui.CuiWindowPlacement;
requires Value.Width > 0;
requires Value.Height > 0;
begin
  const X: int? := Value.X;
  const Y: int? := Value.Y;
  const Known: bool := X <> null and Y <> null;
  var Window: Cui.CuiWindowPlacement := new Cui.CuiWindowPlacement();
  if Known then
    Window.X := X.Value;
    Window.Y := Y.Value;
  end if;

  Window.Width := Value.Width;
  Window.Height := Value.Height;
  Window.State := if Value.Maximized then
    Cui.CuiWindowState.Maximized
  else
    Cui.CuiWindowState.Normal
  end if;
  Window.HasPosition := Known;
  return Window;
end function;

// Converts the host placement of a closed window for storage.
//
// ## Parameters
// - `Value`: The placement the GUI host reported when the window closed.
// - `Navigation`: Final selected route and independently retained settings tab.
// - `Player`: Optional saved queue and position from this window.
// ## Returns
// The stored placement; coordinates are null where the system reports none.
public function FromWindow(Value: Cui.CuiWindowPlacement; Navigation: Nav.State; Player: Transport.Saved? := null): Snapshot;
requires Navigation.SettingsTab = 0 or Navigation.SettingsTab = 1;
begin
  const Defaults: Snapshot := new Snapshot();
  return new Snapshot(
    if Value.Width > 0 then
      Value.Width
    else
      Defaults.Width
    end if,
    if Value.Height > 0 then
      Value.Height
    else
      Defaults.Height
    end if,
    if Value.HasPosition then
      Value.X
    else
      null
    end if,
    if Value.HasPosition then
      Value.Y
    else
      null
    end if,
    Value.State = Cui.CuiWindowState.Maximized,
    Navigation.SettingsTab,
    Nav.Key(Navigation.Active), Player ?? new Transport.Saved()
  );
end function;

end unit;
