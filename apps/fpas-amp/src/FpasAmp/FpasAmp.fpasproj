<!-- [Documentation](../../doc/desktop.md) -->
<Project Sdk="Fpas.NET.Sdk/0.1.0-dev">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <!-- MetaBrainz uses System.Text.Json options with registered converters. -->
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishAot)' == 'true'">true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FpasAmp.Library/FpasAmp.Library.fpasproj" />
    <ProjectReference Include="../FpasAmp.Ui/FpasAmp.Ui.fpasproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' and ('$(UseAppHost)' != 'false' or '$(PublishAot)' == 'true')">
    <Content Include="../../packaging/linux/io.github.tobiasbick.FpasAmp.desktop"
             Link="share/applications/%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../packaging/linux/io.github.tobiasbick.FpasAmp.svg"
             Link="share/icons/hicolor/scalable/apps/%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
