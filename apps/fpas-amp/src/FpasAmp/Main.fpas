// [Documentation](../../doc/desktop.md#startup-and-user-files)

// FPas-Amp desktop entry point.
async program FpasAmp;

uses Fpas.Ui.Gui.Cui as Cui;
uses FpasAmp.AppState as State;
uses FpasAmp.Library.Inventory.Monitoring as Monitoring;
uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Library.Metadata.Monitoring as Metadata;
uses FpasAmp.Library.Persistence.Paths as LibraryPaths;
uses FpasAmp.Library.Playlists.Model as Lists;
uses FpasAmp.Persistence.PlayerState as Transport;
uses FpasAmp.Persistence.UserFiles as Files;
uses FpasAmp.Settings as Settings;
uses FpasAmp.Ui.Music.Playlist as Playlist;
uses FpasAmp.Ui.Navigation.Model as Nav;
uses FpasAmp.Ui.Player.Model as Player;
uses FpasAmp.Ui.Podcasts.Model as Podcasts;
uses FpasAmp.Ui.Radio.Model as Radio;
uses FpasAmp.Ui.Settings.Model as Model;
uses FpasAmp.Ui.Shell as Shell;
uses System as Sys;
uses System.Collections.Immutable as I;
uses System.Console as Console;
uses System.IO as IO;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

async function Main(): Tasks.Task;
begin
  const Directory: string := Files.DirectoryPath();
  const Preferences: Model.Preferences := Settings.Load(Directory);
  const Inventory: Monitoring.Session := Monitoring.Session.Start(
    Preferences.MusicSources,
    LibraryPaths.DatabasePath(),
    Threads.CancellationToken.None,
    UserDataPath := LibraryPaths.UserDataPath()
  );
  try
    const Opened: State.Snapshot := State.Load(Directory);
    var Restored: Player.State := new Player.State();
    var PreserveQueue: bool := false;
    const Tags: Metadata.Session? := Inventory.Metadata;
    if Tags <> null and Opened.Player.Index >= 0 then
      try
        var Items: I.ImmutableArray<Tracks.Entry> := Tags.QueueAsync(
          Opened.Player.Source.AlbumId, Threads.CancellationToken.None
        ).GetAwaiter().GetResult();
        if Opened.Player.Source.Playlist <> '' then
          case Nav.Parse(Opened.Player.Source.Playlist) of
            when Nav.Route.Playlist(const Identity: Lists.Key):
              Items := Playlist.Resolve(
                Tags.Playlists.ReadAsync(
                  Identity,
                  Threads.CancellationToken.None
                ).GetAwaiter().GetResult(),
                Items
              );
            else
              Items := I.ImmutableArray<Tracks.Entry>.Empty;
          end case;
        end if;

        Restored := Transport.Restore(Opened.Player, Items);
      catch Failure: Sys.Exception do
        PreserveQueue := true;
        Console.Error.WriteLine('Could not restore the playback queue: ' + Failure.Message);
      end try;
    end if;
    var Destination: Nav.Route := Nav.Parse(Opened.ActivePage) ?? Nav.Route.Page(Nav.Page.Music);
    case Destination of
      when Nav.Route.Station(const Id: string):
        if Radio.Find(Preferences.RadioFavorites, Id) = null then
          Destination := Nav.Route.Page(Nav.Page.Stations);
        end if;
      when Nav.Route.Podcast(const Id: string):
        if Podcasts.Find(Preferences.PodcastSubscriptions, Id) = null then
          Destination := Nav.Route.Page(Nav.Page.Podcasts);
        end if;
      else
    end case;
    var Navigation: Nav.State := new Nav.State(
      Active := Destination,
      SettingsTab := Opened.SettingsTab,
      CoverScroll := Opened.CoverScroll
    );
    const Closed: Cui.CuiWindowPlacement := Shell.Run(
      State.ToWindow(Opened), Preferences, ref Navigation, ref Restored,
      procedure(Value: Model.Preferences) begin
        Settings.Save(Directory, Value);
      end procedure, Inventory
    );
    try
      State.Save(
        Directory, State.FromWindow(
          Closed, Navigation,
          if PreserveQueue and Restored.Index < 0 then
            Opened.Player
          else
            Transport.Capture(Restored)
          end if
        )
      );
    catch Failure: IO.IOException do
      Console.Error.WriteLine('Could not save the application state: ' + Failure.Message);
    catch Failure: Sys.UnauthorizedAccessException do
      Console.Error.WriteLine('Could not save the application state: ' + Failure.Message);
    end try;
  finally
    try
      await Inventory.DisposeAsync().ConfigureAwait(false);
    catch Failure: Sys.Exception do
      Console.Error.WriteLine('The library worker stopped with an error: ' + Failure.Message);
    end try;
  end try;
end function;

begin
  await Main();
end;

end program;
