// FPas-Amp desktop entry point.
async program FpasAmp;

uses
  Fpas.Ui.Gui.Cui as Cui,
  FpasAmp.Persistence.UserFiles as Files,
  FpasAmp.Settings as Settings,
  FpasAmp.Ui.App.Model as Model,
  FpasAmp.Ui.Navigation.Model as Nav,
  FpasAmp.Ui.Shell as Shell,
  FpasAmp.AppState as State,
  FpasAmp.Library.Inventory.Monitoring as Monitoring,
  FpasAmp.Library.Persistence.Paths as LibraryPaths,
  System as Sys,
  System.Console as Console,
  System.IO as IO,
  System.Threading as Threads,
  System.Threading.Tasks as Tasks;

async function Main(): Tasks.Task;
begin
  const Directory: string := Files.DirectoryPath();
  const Preferences: Model.Preferences := Settings.Load(Directory);
  await using const Inventory: Monitoring.Session := Monitoring.Session.Start(
    Preferences.MusicSources,
    LibraryPaths.DatabasePath(),
    Threads.CancellationToken.None,
    UserDataPath := LibraryPaths.UserDataPath()
  );
  const Opened: State.Snapshot := State.Load(Directory);
  var Navigation: Nav.State := new Nav.State(
    Active := Nav.Parse(Opened.ActivePage) ?? Nav.Route.Page(Nav.Page.Music),
    SettingsTab := Opened.SettingsTab
  );
  const Closed: Cui.CuiWindowPlacement := Shell.Run(
    State.ToWindow(Opened), Preferences, ref Navigation,
    procedure(Value: Model.Preferences) begin
      Settings.Save(Directory, Value);
    end procedure, Inventory
  );
  try
    State.Save(Directory, State.FromWindow(Closed, Navigation));
  catch Failure: IO.IOException do
    Console.Error.WriteLine('Could not save the application state: ' + Failure.Message);
  catch Failure: Sys.UnauthorizedAccessException do
    Console.Error.WriteLine('Could not save the application state: ' + Failure.Message);
  end try;
end function;

begin
  await Main();
end;

end program;
