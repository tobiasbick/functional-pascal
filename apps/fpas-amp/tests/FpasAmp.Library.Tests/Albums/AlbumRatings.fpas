// [Documentation](../../../doc/library.md#albums-and-artwork)

// Album ratings are durable user choices, never inferred from track ratings.
unit FpasAmp.Library.Tests.AlbumRatings;

uses FpasAmp.Library.Albums.Access as Access;
uses FpasAmp.Library.Albums.Model as M;
uses FpasAmp.Library.Albums.Persistence.Queries as Query;
uses FpasAmp.Library.Inventory.Monitoring as Monitor;
uses FpasAmp.Library.Metadata.Model as Tags;
uses FpasAmp.Library.Persistence.Sql as Sql;
uses FpasAmp.Library.Tests.AlbumSupport as Art;
uses FpasAmp.Library.Tests.MetadataSupport as F;
uses FpasAmp.Library.Tests.Support as H;
uses FpasAmp.Library.UserData.Schema as Users;
uses Microsoft.Data.Sqlite as Db;
uses System as Sys;
uses System.Collections.Immutable as I;
uses System.IO as IO;
uses System.Threading as T;
uses System.Threading.Channels as Channels;
uses System.Threading.Tasks as Tasks;
uses Xunit as X;

function Read(Data: string): I.ImmutableArray<M.Album>;
begin
  return Query.Read(
    IO.Path.Combine(Data, 'library.db'),
    IO.Path.Combine(Data, 'userdata.db'),
    T.CancellationToken.None
  ).Releases;
end function;

// Database, observation and rebuild contracts for independent album ratings.
public type RatingTests = record
  // Clearing/rebuilding the catalogue and restarting cannot erase album or track ratings.
  [X.FactAttribute]
  public async function IndependentRatingsSurviveCatalogueRebuildAndRestart(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    discard Art.Track(Root.Path, 'a.mp3', 'Album');
    discard Art.Track(Root.Path, 'b.mp3', 'Album');
    var Id: string := '';
    begin
      await using const Session: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
      const Tracks: I.ImmutableArray<Tags.Entry> := await F.Until(
        F.Tags(Session),
        function(Items: I.ImmutableArray<Tags.Entry>): bool => Items.Length = 2
      );
      const Before: M.Album := Read(Data.Path)[0];
      Id := Before.Id;
      X.Assert.Equal<string>('Example artist', Before.Credits[0].Name);
      await F.Tags(Session).Albums.SetRatingAsync(
        Before.Credits[0].Id,
        5,
        T.CancellationToken.None
      );
      await F.Tags(Session).SetRatingAsync(Tracks[0].TrackId, 9, T.CancellationToken.None);
      await F.Tags(Session).Albums.SetRatingAsync(Id, 7, T.CancellationToken.None);
      X.Assert.Equal<int?>(7, Read(Data.Path)[0].Rating);
      X.Assert.Equal<string>(Before.Revision, Read(Data.Path)[0].Revision);
      const Unchanged: I.ImmutableArray<Tags.Entry> := await F.Tags(Session).QueryAsync(
        new Tags.Query(),
        T.CancellationToken.None
      );
      X.Assert.Equal<int?>(9, Unchanged[0].Rating);
      X.Assert.Null(Unchanged[1].Rating);
      discard await Session.ClearAsync('', T.CancellationToken.None);
      X.Assert.Empty(Read(Data.Path));
      Session.Configure([F.Source(Root.Path)]);
      discard await F.Until(
        F.Tags(Session),
        function(Items: I.ImmutableArray<Tags.Entry>): bool => Items.Length = 2
      );
      X.Assert.Equal<string>(Id, Read(Data.Path)[0].Id);
      X.Assert.Equal<int?>(7, Read(Data.Path)[0].Rating);
    end;

    await using const Restart: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
    discard await F.Until(
      F.Tags(Restart),
      function(Items: I.ImmutableArray<Tags.Entry>): bool => Items.Length = 2
    );
    X.Assert.Equal<int?>(7, Read(Data.Path)[0].Rating);
    const Person: M.Membership := Read(Data.Path)[0].Credits[0];
    X.Assert.Equal<int?>(5, Person.Rating);
    await F.Tags(Restart).Albums.SetRatingAsync(Person.Id, null, T.CancellationToken.None);
    X.Assert.Null(Read(Data.Path)[0].Credits[0].Rating);
    X.Assert.Equal<int?>(7, Read(Data.Path)[0].Rating);
    await F.Tags(Restart).Albums.SetRatingAsync(Id, null, T.CancellationToken.None);
    X.Assert.Null(Read(Data.Path)[0].Rating);
    X.Assert.Equal<int?>(
      9,
      (await F.Tags(Restart).QueryAsync(new Tags.Query(), T.CancellationToken.None))[0].Rating
    );
  end function;

  // Observers react to user-data commits without a catalogue/artwork change.
  [X.FactAttribute]
  public async function RatingObservationAndCancelledWrite(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    discard Art.Track(Root.Path, 'a.mp3', 'Album');
    await using const Session: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
    discard await F.Until(
      F.Tags(Session),
      function(Items: I.ImmutableArray<Tags.Entry>): bool => Items.Length = 1
    );
    const Albums: Access.Session := F.Tags(Session).Albums;
    using const Stop: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
    const Updates: Channels.Channel<I.ImmutableArray<M.Album>> := Channels.Channel.CreateUnbounded<I.ImmutableArray<M.Album>>();
    const Running: Tasks.Task := Albums.ObserveAsync(
      function(Value: M.Snapshot): Tasks.Task => Updates.Writer.WriteAsync(
        Value.Releases,
        Stop.Token
      ).AsTask(),
      Stop.Token
    );
    try
      const Initial: I.ImmutableArray<M.Album> := await Updates.Reader.ReadAsync(Stop.Token);
      X.Assert.Null(Initial[0].Rating);
      await Albums.SetRatingAsync(Initial[0].Id, 10, Stop.Token);
      const Changed: I.ImmutableArray<M.Album> := await Updates.Reader.ReadAsync(Stop.Token);
      X.Assert.Equal<int?>(10, Changed[0].Rating);
      X.Assert.Equal<string>(Initial[0].Revision, Changed[0].Revision);
      for Value: int in [-1, 0, 11] do
        var Rejected: bool := false;
        try
          await Albums.SetRatingAsync(Initial[0].Id, Value, Stop.Token);
        catch Expected: Sys.InvalidOperationException do
          Rejected := true;
        end try;

        X.Assert.True(Rejected);
      end for;
      var Unknown: bool := false;
      try
        await Albums.SetRatingAsync('unknown-album', 1, Stop.Token);
      catch Expected: Sys.ArgumentException do
        Unknown := true;
      end try;

      X.Assert.True(Unknown);
      using const Cancel: T.CancellationTokenSource := new T.CancellationTokenSource();
      Cancel.Cancel();
      var Cancelled: bool := false;
      try
        await Albums.SetRatingAsync(Initial[0].Id, 1, Cancel.Token);
      catch Expected: Sys.OperationCanceledException do
        Cancelled := true;
      end try;

      X.Assert.True(Cancelled);
      X.Assert.Equal<int?>(10, Read(Data.Path)[0].Rating);
      await Albums.SetRatingAsync(Initial[0].Id, null, Stop.Token);
      X.Assert.Null((await Updates.Reader.ReadAsync(Stop.Token))[0].Rating);
    finally
      Stop.Cancel();
      try
        await Running;
      catch Expected: Sys.OperationCanceledException do
      end try;
    end try;
  end function;

  // A schema-four library keeps its artist stars when genre ratings become available.
  [X.FactAttribute]
  public procedure UpgradeGroupRatings();
  begin
    using const Data: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Data.Path, 'userdata.db');
    begin
      using const Connection: Db.SqliteConnection := Sql.Open(Path);
      Sql.Execute(
        Connection,
        'CREATE TABLE artist_ratings(artist_id TEXT PRIMARY KEY,rating INTEGER NOT NULL);' +
        'INSERT INTO artist_ratings VALUES(''artist-fixture'',8); PRAGMA user_version=4;',
        null,
        [],
        []
      );
    end;

    using const Upgraded: Db.SqliteConnection := Users.Open(Path);
    using const ReadRating: Db.SqliteCommand := Sql.Command(
      Upgraded,
      'SELECT rating FROM group_ratings WHERE group_id=''artist-fixture'';', null, [], []
    );
    X.Assert.Equal<long>(8L, Sys.Convert.ToInt64(ReadRating.ExecuteScalar()));
  end procedure;

  // Existing user data upgrades in place and preserves track identities/ratings.
  [X.FactAttribute]
  public procedure UpgradePreservesUserData();
  begin
    using const Data: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Data.Path, 'userdata.db');
    begin
      using const Connection: Db.SqliteConnection := Users.Open(Path);
      Sql.Execute(
        Connection,
        'INSERT INTO tracks VALUES(''track'',''key'',''path'',''hash'',1,1,8); DROP TABLE album_ratings; PRAGMA user_version=2;',
        null,
        [],
        []
      );
    end;

    using const Upgraded: Db.SqliteConnection := Users.Open(Path);
    using const ReadRating: Db.SqliteCommand := Sql.Command(
      Upgraded,
      'SELECT rating FROM tracks WHERE id=''track'';',
      null,
      [],
      []
    );
    X.Assert.Equal<long>(8L, Sys.Convert.ToInt64(ReadRating.ExecuteScalar()));
    Sql.Execute(Upgraded, 'INSERT INTO album_ratings VALUES(''album'',10);', null, [], []);
  end procedure;
end record;

end unit;
