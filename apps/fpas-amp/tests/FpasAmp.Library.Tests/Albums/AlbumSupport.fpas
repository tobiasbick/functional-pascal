// [Documentation](../../../doc/library.md#albums-and-artwork)

// Synthetic audio/artwork shared by focused library and native album-view tests.
unit FpasAmp.Library.Tests.AlbumSupport;

uses ATL as A;
uses FpasAmp.Library.Tests.MetadataSupport as F;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.IO as IO;
uses System.IO.Compression as Zip;
uses System.Text as Text;

procedure Number(Stream: IO.Stream; Value: uint);
begin
  for Shift: int := 3 downto 0 do
    Stream.WriteByte(cast ((Value shr (Shift * 8)) and 255U) as byte);
  end for;
end procedure;

procedure Chunk(Stream: IO.Stream; Kind: string; Bytes: array of byte);
begin
  Number(Stream, cast Bytes.Length as uint);
  const Name: array of byte := Text.Encoding.ASCII.GetBytes(Kind);
  Stream.Write(Name, 0, Name.Length);
  Stream.Write(Bytes, 0, Bytes.Length);
  var Crc: uint := $FFFFFFFFU;
  for Block: array of byte in [Name, Bytes] do
    for Value: byte in Block do
      Crc := Crc xor cast Value as uint;
      for Bit: int := 0 to 7 do
        Crc := if (Crc and 1U) <> 0U then
          (Crc shr 1) xor $EDB88320U
        else
          Crc shr 1
        end if;
      end for;
    end for;
  end for;

  Number(Stream, not Crc);
end procedure;

// Creates a synthetic RGB PNG using only CLR compression; no user media is read.
// `Red`, `Green` and `Blue` select its background, with a contrasting disc motif.
// `Width` and `Height` allow non-square thumbnail tests.
public function Picture(
  Red: byte;
  Green: byte;
  Blue: byte;
  Width: int := 128;
  Height: int := 128
): array of byte;
requires Width > 0 and Height > 0;
begin
  using const Png: IO.MemoryStream := new IO.MemoryStream();
  Png.Write([137, 80, 78, 71, 13, 10, 26, 10], 0, 8);
  using const Header: IO.MemoryStream := new IO.MemoryStream();
  Number(Header, cast Width as uint);
  Number(Header, cast Height as uint);
  Header.Write([8, 2, 0, 0, 0], 0, 5);
  Chunk(Png, 'IHDR', Header.ToArray());
  using const Compressed: IO.MemoryStream := new IO.MemoryStream();
  begin
    using const Zlib: Zip.ZLibStream := new Zip.ZLibStream(
      Compressed,
      Zip.CompressionLevel.SmallestSize,
      true
    );
    for Y: int := 0 to Height - 1 do
      Zlib.WriteByte(0);
      for X: int := 0 to Width - 1 do
        const Distance: int := (X - Width div 2) * (X - Width div 2) + (Y - Height div 2) * (Y -
          Height div 2);
        const Ring: bool := Distance >= 100 and Distance <= 1764;
        Zlib.WriteByte(
          if Ring then
            cast ((cast Red as int + 255) div 2) as byte
          else
            Red
          end if
        );
        Zlib.WriteByte(
          if Ring then
            cast ((cast Green as int + 255) div 2) as byte
          else
            Green
          end if
        );
        Zlib.WriteByte(
          if Ring then
            cast ((cast Blue as int + 255) div 2) as byte
          else
            Blue
          end if
        );
      end for;
    end for;
  end;

  Chunk(Png, 'IDAT', Compressed.ToArray());
  Chunk(Png, 'IEND', Sys.Array.Empty of byte());
  return Png.ToArray();
end function;

// Writes tagged synthetic MP3 `Name` under `Directory`; release identity is empty
// by default so unrelated tests cannot accidentally share the fixture's MusicBrainz ID.
public function Track(
  Directory: string;
  Name: string;
  Album: string;
  Artist: string := 'Example artist';
  Release: string := ''
): string;
begin
  discard IO.Directory.CreateDirectory(Directory);
  const Path: string := F.Write(Directory, Name, Name);
  const Audio: A.Track := new A.Track(Path);
  Audio.Album := Album;
  Audio.AlbumArtist := Artist;
  Audio.SortAlbum := Album;
  Audio.SortAlbumArtist := Artist;
  Audio.Artist := Artist;
  const Fields: C.IDictionary of (string?, string?)? := Audio.AdditionalFields;
  if Fields = null then
    raise new Sys.InvalidOperationException('Missing ATL tag map.');
  end if;

  Fields['MUSICBRAINZ_ALBUMID'] := Release;
  if not Audio.Save() then
    raise new IO.IOException('Synthetic audio tagging failed.');
  end if;

  return Path;
end function;

// Embeds synthetic `Bytes` in `Path` with explicit `Kind`, retaining earlier pictures.
public procedure Embed(
  Path: string;
  Bytes: array of byte;
  Kind: A.PictureInfo.PIC_TYPE := A.PictureInfo.PIC_TYPE.Front
);
begin
  const Audio: A.Track := new A.Track(Path);
  const Pictures: (C.IList of A.PictureInfo?)? := Audio.EmbeddedPictures;
  if Pictures = null then
    raise new Sys.InvalidOperationException('Missing ATL picture list.');
  end if;

  Pictures.Add(A.PictureInfo.fromBinaryData(Bytes, Kind));
  if not Audio.Save() then
    raise new IO.IOException('Synthetic artwork tagging failed.');
  end if;
end procedure;

end unit;
