// [Documentation](../../../doc/library.md#metadata-and-queries)

// Schema upgrade, skip decisions, error retention and bounded catalogue ordering.
unit FpasAmp.Library.Tests.MetadataStorage;

uses
  Fpas.Media.Tags.AudioFiles as MediaTags,
  FpasAmp.Library.Tests.Support as H, FpasAmp.Library.Tests.MetadataSupport as F,
  FpasAmp.Library.Tests.StorageSupport as D, FpasAmp.Library.Persistence.Sql as Sql,
  FpasAmp.Library.Persistence.Schema as Schema, FpasAmp.Library.Metadata.Model as M,
  FpasAmp.Library.Metadata.Monitoring as Metadata, FpasAmp.Library.Metadata.Internal.Pending as Pending,
  FpasAmp.Library.Inventory.Monitoring as Monitor, Microsoft.Data.Sqlite as Db,
  FpasAmp.Library.Sources as S,
  System as Sys, System.IO as IO, System.Collections.Immutable as I,
  System.Threading as T, System.Threading.Tasks as Tasks, Xunit as X;

// Verifies preservation of index/user data and query behavior rather than parser internals.
public type MetadataStorageTests = record
  // Repeated scan upserts coalesce into one pending read while file stamps keep changing.
  [X.FactAttribute]
  public procedure ChangedFileCoalescesPendingReads();
  begin
    using const Connection: Db.SqliteConnection := Sql.Open(':memory:');
    Schema.Ensure(Connection);
    for Stamp: int := 1 to 3 do
      Sql.Execute(
        Connection,
        'INSERT INTO files(path_key,path,directory_key,size,modified_utc) VALUES(''file'',''file'',''directory'',1,$stamp)' +
        ' ON CONFLICT(path_key) DO UPDATE SET modified_utc=excluded.modified_utc;',
        null, ['$stamp'], [Stamp]
      );
      X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM content_jobs;'));
    end for;

    X.Assert.Equal<long>(3L, D.Number(Connection, 'SELECT modified_utc FROM files;'));
  end procedure;

  // An existing presence-only index is upgraded without replacing paths or row identities.
  [X.FactAttribute]
  public procedure PresenceSchemaUpgradeKeepsItsRows();
  begin
    using const Connection: Db.SqliteConnection := Sql.Open(':memory:');
    Sql.Execute(
      Connection,
      'CREATE TABLE sources(id TEXT PRIMARY KEY,path_key TEXT NOT NULL,path TEXT NOT NULL);' +
      'CREATE TABLE files(id INTEGER PRIMARY KEY AUTOINCREMENT,path_key TEXT NOT NULL UNIQUE,path TEXT NOT NULL,directory_key TEXT NOT NULL);' +
      'INSERT INTO files(id,path_key,path,directory_key) VALUES(42,''test-key'',''test-path'',''test-directory''); PRAGMA user_version=1;',
      null,
      [],
      []
    );
    Schema.Ensure(Connection);
    X.Assert.Equal<long>(42L, D.Number(Connection, 'SELECT id FROM files;'));
    X.Assert.Equal<long>(4L, D.Number(Connection, 'PRAGMA user_version;'));
    X.Assert.Equal<long>(0L, D.Number(Connection, 'SELECT count(*) FROM metadata;'));
    X.Assert.Equal<long>(
      1L,
      D.Number(
        Connection,
        'SELECT count(*) FROM files WHERE size IS NULL AND modified_utc IS NULL;'
      )
    );
  end procedure;

  // Successful unchanged files have no pending read; failed reads retain their last tags/rating.
  [X.FactAttribute]
  public async function UnchangedFilesAreSkippedAndReadFailuresRetainTags(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Path: string := F.Write(Root.Path, 'track.mp3');
    const Sources: array of S.MusicSource := [F.Source(Root.Path)];
    await using const Session: Monitor.Session := F.Start(Sources, Data.Path);
    const Tags: Metadata.Session := F.Tags(Session);
    const Before: I.ImmutableArray<M.Entry> := await F.Until(
      Tags,
      function(Items: I.ImmutableArray<M.Entry>): bool => Items.Length = 1
    );
    await Tags.SetRatingAsync(Before[0].TrackId, 5, T.CancellationToken.None);
    begin
      using const Connection: Db.SqliteConnection := D.Open(
        IO.Path.Combine(Data.Path, 'library.db')
      );
      Pending.Configure(Connection, Sources);
      X.Assert.Null(Pending.Next(Connection));
    end;

    IO.File.WriteAllText(Path, 'broken');
    Session.Refresh();
    const After: I.ImmutableArray<M.Entry> := await F.Until(
      Tags,
      function(Items: I.ImmutableArray<M.Entry>): bool => Items.Length = 1 and Items[
        0
      ].Error <> null
    );
    X.Assert.Equal<string>(Before[0].TrackId, After[0].TrackId);
    X.Assert.Equal<int?>(5, After[0].Rating);
    X.Assert.Equal<string>('Stück', (After[0].Metadata ?? new MediaTags.Info()).Title);
  end function;

  // Ordering/paging use database keys, filters are bound, and rating bounds are enforced.
  [X.FactAttribute]
  public async function OrderingPagingAndRatingBounds(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    discard F.Write(Root.Path, 'z.mp3', 'Zulu');
    discard F.Write(Root.Path, 'a.ogg', 'Alpha');
    await using const Session: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
    const Tags: Metadata.Session := F.Tags(Session);
    const Entries: I.ImmutableArray<M.Entry> := await F.Until(
      Tags,
      function(Items: I.ImmutableArray<M.Entry>): bool => Items.Length = 2
    );
    X.Assert.Equal<string>('Alpha', (Entries[0].Metadata ?? new MediaTags.Info()).Title);
    const Page: I.ImmutableArray<M.Entry> := await Tags.QueryAsync(
      new M.Query(Limit := 1, Offset := 1),
      T.CancellationToken.None
    );
    X.Assert.Equal<int>(1, Page.Length);
    X.Assert.Equal<string>('Zulu', (Page[0].Metadata ?? new MediaTags.Info()).Title);
    await Tags.SetRatingAsync(Entries[0].TrackId, 1, T.CancellationToken.None);
    await Tags.SetRatingAsync(Entries[1].TrackId, 10, T.CancellationToken.None);
    const Rated: I.ImmutableArray<M.Entry> := await Tags.QueryAsync(
      new M.Query(Order := M.Sort.Rating, Descending := true),
      T.CancellationToken.None
    );
    X.Assert.Equal<int?>(10, Rated[0].Rating);
    X.Assert.Equal<int?>(1, Rated[1].Rating);
    X.Assert.Equal<int>(
      0,
      (await Tags.QueryAsync(new M.Query(Album := ''' OR 1=1 --'), T.CancellationToken.None)).Length
    );
    for Value: int in [0, 11, -1] do
      var Rejected: bool := false;
      try
        await Tags.SetRatingAsync(Entries[0].TrackId, Value, T.CancellationToken.None);
      catch Invalid: Sys.InvalidOperationException do
        Rejected := true;
      end try;

      X.Assert.True(Rejected);
    end for;
  end function;
end record;

end unit;
