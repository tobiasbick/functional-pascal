// [Documentation](../../../doc/library.md#metadata-and-queries)

// Real MP3/Vorbis fixtures and bounded asynchronous catalogue checks.
unit FpasAmp.Library.Tests.MetadataSupport;

uses ATL as A;
uses FpasAmp.Library.Inventory.Model as Inventory;
uses FpasAmp.Library.Inventory.Monitoring as Monitor;
uses FpasAmp.Library.Metadata.Model as M;
uses FpasAmp.Library.Metadata.Monitoring as Metadata;
uses FpasAmp.Library.Sources as S;
uses FpasAmp.Library.Tests.Support as H;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;
uses System.IO as IO;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;
uses Xunit as X;

// Copies a synthetic fixture and writes selected tags with ATL itself.
// `Directory` is test-owned; `Name` ends in .mp3 or .ogg and `Title` distinguishes entries.
// `Fixture` selects synthetic Vorbis/MP3 silence or the additional Opus fixture.
public function Write(Directory: string; Name: string; Title: string := 'Stück'; Fixture: string := 'silence'): string;
begin
  const Path: string := IO.Path.Combine(Directory, Name);
  IO.File.Copy(
    IO.Path.Combine(Sys.AppContext.BaseDirectory, 'Fixtures', Fixture + IO.Path.GetExtension(Name)),
    Path
  );
  const Track: A.Track := new A.Track(Path);
  Track.Title := Title;
  Track.Artist := 'AC/DC;Björk';
  Track.AlbumArtist := 'Various Artists';
  Track.Album := 'Älbum';
  Track.Genre := 'Rock;Pop';
  Track.Composer := 'Composer A;Composer B';
  Track.TrackNumber := 2;
  Track.TrackTotal := 12;
  Track.DiscNumber := 1;
  Track.DiscTotal := 2;
  Track.Year := 2024;
  Track.OriginalReleaseYear := 2020;
  Track.Comment := 'Generated silence';
  Track.Publisher := 'Test label';
  Track.SortArtist := 'Artists';
  Track.SortAlbum := 'Album';
  Track.BPM := 120.0F;
  Track.Popularity := 1.0F;
  const Extra: C.IDictionary<string?, string?>? := Track.AdditionalFields;
  if Extra = null then
    raise new Sys.InvalidOperationException('Missing ATL fields.');
  end if;

  Extra['REPLAYGAIN_TRACK_GAIN'] := '-3.25 dB';
  Extra['REPLAYGAIN_ALBUM_GAIN'] := '-2.5 dB';
  Extra['MUSICBRAINZ_ALBUMID'] := '11111111-1111-1111-1111-111111111111';
  Extra['MUSICBRAINZ_TRACKID'] := '22222222-2222-2222-2222-222222222222';
  X.Assert.True(Track.Save());
  return Path;
end function;

// Creates a source including both fixture formats.
public function Source(Path: string; Id: string := 'music'): S.MusicSource;
begin
  return H.Source(Id, Path) with
    Extensions := ['.mp3', '.ogg'];
  end with;
end function;

// Starts both owned stages with separate file-backed temporary stores in `Data`.
public function Start(Sources: array of S.MusicSource; Data: string): Monitor.Session;
begin
  return Monitor.Session.Start(
    Sources, IO.Path.Combine(Data, 'library.db'), T.CancellationToken.None,
    new Inventory.Options(0, 60000, 16), IO.Path.Combine(Data, 'userdata.db')
  );
end function;

// Returns the enabled metadata stage, retaining its caller-owned inventory lifetime.
public function Tags(Session: Monitor.Session): Metadata.Session;
begin
  const Value: Metadata.Session? := Session.Metadata;
  if Value = null then
    raise new Sys.InvalidOperationException('Metadata stage is disabled.');
  end if;

  return Value;
end function;

// Waits at most fifteen seconds for a bounded page satisfying `Accept`.
public async function Until(Session: Metadata.Session; Accept: function(I.ImmutableArray<M.Entry>): bool): Tasks.Task<I.ImmutableArray<M.Entry>>;
begin
  using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
  while true do
    const Values: I.ImmutableArray<M.Entry> := await Session.QueryAsync(
      new M.Query(Limit := 500),
      Deadline.Token
    ).ConfigureAwait(false);
    if Accept(Values) then
      return Values;
    end if;

    await Tasks.Task.Delay(10, Deadline.Token).ConfigureAwait(false);
  end while;
end function;

end unit;
