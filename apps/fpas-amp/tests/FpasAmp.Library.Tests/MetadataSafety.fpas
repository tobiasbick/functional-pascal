// [Documentation](../../doc/library.md#metadata-and-queries)

// Read cancellation, ambiguous fingerprints, unavailable sources and user-store errors.
unit FpasAmp.Library.Tests.MetadataSafety;

uses
  FpasAmp.Library.Tests.Support as H, FpasAmp.Library.Tests.MetadataSupport as F,
  FpasAmp.Library.Metadata.Model as M, FpasAmp.Library.Metadata.Monitoring as Metadata,
  FpasAmp.Library.Metadata.Internal.Reading as Reading, FpasAmp.Library.Inventory.Monitoring as Monitor,
  FpasAmp.Library.Sources as S, Microsoft.Data.Sqlite as Db, System as Sys, System.IO as IO,
  System.Collections.Immutable as I, System.Threading as T, System.Threading.Tasks as Tasks, Xunit as X;

// Verifies that uncertainty never silently transfers ratings or destroys user data.
public type MetadataSafetyTests = record
  // Two identical missing candidates are ambiguous; the new file receives a fresh UUID.
  [X.FactAttribute]
  public async function AmbiguousHashesDoNotTransferRatings(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const A: string := F.Write(Root.Path, 'a.mp3');
    const B: string := IO.Path.Combine(Root.Path, 'b.mp3');
    IO.File.Copy(A, B);
    const Bytes: array of byte := IO.File.ReadAllBytes(A);
    await using const Session: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
    const Tags: Metadata.Session := F.Tags(Session);
    const Before: I.ImmutableArray<M.Entry> := await F.Until(
      Tags,
      function(Items: I.ImmutableArray<M.Entry>): bool => Items.Length = 2
    );
    await Tags.SetRatingAsync(Before[0].TrackId, 8, T.CancellationToken.None);
    await Tags.SetRatingAsync(Before[1].TrackId, 3, T.CancellationToken.None);
    IO.File.Delete(A);
    IO.File.Delete(B);
    const C: string := IO.Path.Combine(Root.Path, 'new.mp3');
    IO.File.WriteAllBytes(C, Bytes);
    Session.Refresh();
    const After: I.ImmutableArray<M.Entry> := await F.Until(
      Tags,
      function(Items: I.ImmutableArray<M.Entry>): bool => Items.Length = 1 and Items[0].Path = C
    );
    X.Assert.NotEqual<string>(Before[0].TrackId, After[0].TrackId);
    X.Assert.NotEqual<string>(Before[1].TrackId, After[0].TrackId);
    X.Assert.Null(After[0].Rating);
  end function;

  // A deliberately offline source cannot establish that its old file was deleted.
  [X.FactAttribute]
  public async function OfflineCopiesDoNotTakeAnUnavailableRating(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const A: string := IO.Directory.CreateDirectory(IO.Path.Combine(Root.Path, 'a')).FullName;
    const B: string := IO.Directory.CreateDirectory(IO.Path.Combine(Root.Path, 'b')).FullName;
    const Original: string := F.Write(A, 'track.ogg');
    const Bytes: array of byte := IO.File.ReadAllBytes(Original);
    const SourceA: S.MusicSource := F.Source(A, 'a');
    const SourceB: S.MusicSource := F.Source(B, 'b');
    await using const Session: Monitor.Session := F.Start([SourceA, SourceB], Data.Path);
    const Tags: Metadata.Session := F.Tags(Session);
    const Before: I.ImmutableArray<M.Entry> := await F.Until(
      Tags,
      function(Items: I.ImmutableArray<M.Entry>): bool => Items.Length = 1
    );
    await Tags.SetRatingAsync(Before[0].TrackId, 9, T.CancellationToken.None);
    Session.Configure(
      [
        SourceA with
          Offline := true;
        end with, SourceB
      ]
    );
    IO.Directory.Delete(A, true);
    const Copy: string := IO.Path.Combine(B, 'copy.ogg');
    IO.File.WriteAllBytes(Copy, Bytes);
    Session.Refresh('b');
    const After: I.ImmutableArray<M.Entry> := await F.Until(
      Tags,
      function(Items: I.ImmutableArray<M.Entry>): bool => Items.Length = 2
    );
    for Entry: M.Entry in After do
      if Entry.Path = Copy then
        X.Assert.NotEqual<string>(Before[0].TrackId, Entry.TrackId);
        X.Assert.Null(Entry.Rating);
      end if;
    end for;
  end function;

  // Hashing stops between fixed-size blocks after a source configuration changes.
  [X.FactAttribute]
  public async function ObsoleteHashIsDiscardedAndCancellationPropagates(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'large.mp3');
    begin
      using const File: IO.FileStream := IO.File.Create(Path);
      File.SetLength(16777216L);
    end;
    const Info: IO.FileInfo := new IO.FileInfo(Path);
    var Checks: int := 0;
    const Value: Reading.Result := await Reading.Read(
      Path, Info.Length, Info.LastWriteTimeUtc.Ticks,
      T.CancellationToken.None, function(): bool begin
        Checks := Checks + 1;
        return Checks < 4;
      end function
    );
    X.Assert.Equal<string>('', Value.Hash);
    X.Assert.NotNull(Value.Error);
    X.Assert.Equal<int>(4, Checks);
    using const Stop: T.CancellationTokenSource := new T.CancellationTokenSource();
    Stop.Cancel();
    var Cancelled: bool := false;
    try
      discard await Reading.Read(Path, Info.Length, Info.LastWriteTimeUtc.Ticks, Stop.Token);
    catch Failure: Sys.OperationCanceledException do
      Cancelled := true;
    end try;

    X.Assert.True(Cancelled);
  end function;

  // Corrupt user data faults the metadata lifetime and is never replaced with an empty store.
  [X.FactAttribute]
  public async function CorruptUserDataIsReportedAndPreserved(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Data.Path, 'userdata.db');
    IO.File.WriteAllText(Path, 'deliberately corrupt user data');
    const Session: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
    var Failed: bool := false;
    try
      await F.Tags(Session).Completion.WaitAsync(Sys.TimeSpan.FromSeconds(15));
    catch Failure: Db.SqliteException do
      Failed := true;
    finally
      try
        await Session.DisposeAsync();
      catch Failure: Db.SqliteException do
      end try;
    end try;

    X.Assert.True(Failed);
    X.Assert.Equal<string>('deliberately corrupt user data', IO.File.ReadAllText(Path));
  end function;
end record;

end unit;
