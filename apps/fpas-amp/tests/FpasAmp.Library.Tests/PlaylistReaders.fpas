// [Documentation](../../doc/library.md#playlists)

// Real ATL parsers must retain references without opening their targets.
unit FpasAmp.Library.Tests.PlaylistReaders;

uses
  FpasAmp.Library.Playlists.Internal.Reading as R,
  FpasAmp.Library.Playlists.Internal.References as References,
  FpasAmp.Library.Tests.Support as H, System as Sys, System.IO as IO,
  System.Text as Text, System.Threading as T, System.Threading.Tasks as Tasks, Xunit as X;

// Parser contracts for every supported extension, including experimental FPL.
public type ReaderTests = record
  // Namespaced XML and CDATA retain text; URI escaping applies only to XML paths.
  [X.FactAttribute]
  public procedure XmlReferencesAndCdata();
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'list.xspf');
    IO.File.WriteAllText(
      Path,
      '<x:playlist xmlns:x="http://xspf.org/ns/0/"><x:trackList><x:track><x:location><![CDATA[sub/a%20b.ogg]]></x:location><x:title><![CDATA[Title & more]]></x:title></x:track><x:track><x:location>https://example.invalid/a%20b</x:location></x:track></x:trackList></x:playlist>'
    );
    const Info: IO.FileInfo := new IO.FileInfo(Path);
    const Result: R.Result := R.Read(
      Path,
      Info.Length,
      Info.LastWriteTimeUtc.Ticks,
      T.CancellationToken.None
    );
    X.Assert.True(Result.Error = null, Result.Error);
    X.Assert.Equal<int>(2, Result.Items.Length);
    X.Assert.Equal<string>(
      IO.Path.Combine(Root.Path, 'sub', 'a b.ogg'),
      Result.Items[0].Reference.Location
    );
    X.Assert.Equal<string>('Title & more', Result.Items[0].Title);
    X.Assert.Equal<string>('https://example.invalid/a%20b', Result.Items[1].Reference.Location);
  end procedure;

  // Rooted XML paths decode once, while absolute plain-text paths remain literal.
  [X.FactAttribute]
  public procedure AbsolutePathEscaping();
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Escaped: string := IO.Path.Combine(Root.Path, 'a%20b%2520.ogg');
    const Expected: string := IO.Path.Combine(Root.Path, 'a b%20.ogg');
    X.Assert.Equal<string>(Expected, References.Resolve(Escaped, Root.Path, true).Location);
    X.Assert.Equal<string>(Escaped, References.Resolve(Escaped, Root.Path).Location);
  end procedure;

  // The reference-only parser rejects excessive entries even in a small text file.
  [X.FactAttribute]
  public procedure EntryCountIsBounded();
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'large.m3u8');
    const Lines: Text.StringBuilder := new Text.StringBuilder();
    for Index: int := 1 to 100001 do
      discard Lines.AppendLine('x');
    end for;

    IO.File.WriteAllText(Path, Lines.ToString());
    const Info: IO.FileInfo := new IO.FileInfo(Path);
    const Result: R.Result := R.Read(
      Path,
      Info.Length,
      Info.LastWriteTimeUtc.Ticks,
      T.CancellationToken.None
    );
    X.Assert.NotNull(Result.Error);
    X.Assert.Equal<int>(0, Result.Items.Length);
  end procedure;

  // Playlist formats preserve relative targets, Unicode, duplicates and order.
  [X.TheoryAttribute]
  [X.InlineDataAttribute('.m3u', '#EXTM3U\n\na.ogg\na.ogg\nmissing.mp3\n')]
  [X.InlineDataAttribute('.m3u8', '#EXTM3U\n\na.ogg\na.ogg\nmissing.mp3\n')]
  [X.InlineDataAttribute(
    '.pls',
    '[playlist]\nTitle2=Second\nFile3=missing.mp3\nFile1=a.ogg\nFile2=a.ogg\nNumberOfEntries=3\n'
  )]
  [X.InlineDataAttribute(
    '.dpl',
    'DAUMPLAYLIST\n\n1*file*a.ogg\n2*file*a.ogg\n3*file*missing.mp3\n'
  )]
  [X.InlineDataAttribute(
    '.xspf',
    '<playlist><trackList><track><location>a.ogg</location></track><track><location>a.ogg</location></track><track><location>missing.mp3</location></track></trackList></playlist>'
  )]
  [X.InlineDataAttribute(
    '.asx',
    '<asx><entry><ref href="a.ogg"/></entry><entry><ref href="a.ogg"/></entry><entry><ref href="missing.mp3"/></entry></asx>'
  )]
  [X.InlineDataAttribute(
    '.wax',
    '<ASX><ENTRY><REF HREF="a.ogg"/></ENTRY><ENTRY><REF HREF="a.ogg"/></ENTRY><ENTRY><REF HREF="missing.mp3"/></ENTRY></ASX>'
  )]
  [X.InlineDataAttribute(
    '.wvx',
    '<ASX><ENTRY><REF HREF="a.ogg"/></ENTRY><ENTRY><REF HREF="a.ogg"/></ENTRY><ENTRY><REF HREF="missing.mp3"/></ENTRY></ASX>'
  )]
  [X.InlineDataAttribute(
    '.b4s',
    '<WinampXML><playlist><entry Playstring="a.ogg"/><entry Playstring="a.ogg"/><entry Playstring="missing.mp3"/></playlist></WinampXML>'
  )]
  [X.InlineDataAttribute(
    '.smil',
    '<smil><body><seq><audio src="a.ogg"/><audio src="a.ogg"/><audio src="missing.mp3"/></seq></body></smil>'
  )]
  [X.InlineDataAttribute(
    '.smi',
    '<smil><body><seq><audio src="a.ogg"/><audio src="a.ogg"/><audio src="missing.mp3"/></seq></body></smil>'
  )]
  [X.InlineDataAttribute(
    '.wpl',
    '<smil><body><seq><media src="a.ogg"/><media src="a.ogg"/><media src="missing.mp3"/></seq></body></smil>'
  )]
  [X.InlineDataAttribute(
    '.zpl',
    '<smil><body><seq><media src="a.ogg"/><media src="a.ogg"/><media src="missing.mp3"/></seq></body></smil>'
  )]
  public procedure SupportedFormats(Extension: string; Contents: string);
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'list' + Extension);
    IO.File.WriteAllText(Path, Contents.Replace('\n', Sys.Environment.NewLine));
    const Info: IO.FileInfo := new IO.FileInfo(Path);
    const Result: R.Result := R.Read(
      Path,
      Info.Length,
      Info.LastWriteTimeUtc.Ticks,
      T.CancellationToken.None
    );
    X.Assert.True(Result.Error = null, Result.Error);
    X.Assert.Equal<int>(3, Result.Items.Length);
    X.Assert.Equal<string>(IO.Path.Combine(Root.Path, 'a.ogg'), Result.Items[0].Reference.Location);
    X.Assert.Equal<string>(Result.Items[0].Reference.Location, Result.Items[1].Reference.Location);
    X.Assert.Equal<string>(
      IO.Path.Combine(Root.Path, 'missing.mp3'),
      Result.Items[2].Reference.Location
    );
  end procedure;

  // Blank/malformed metadata lines terminate and do not leak the previous label.
  [X.FactAttribute]
  public async function M3uBlankLinesAndLabels(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'list.m3u8');
    IO.File.WriteAllText(
      Path,
      '#EXTM3U' + #10 + #10 + '#EXTINF' + #10 + '#EXTINF:bad' + #10 +
      '#EXTINF:-1,Artist - Song: One, Two' + #10 + 'https://example.invalid/a?x=1' + #10 +
      'missing.mp3' + #10
    );
    const Info: IO.FileInfo := new IO.FileInfo(Path);
    const Result: R.Result := await Tasks.Task.Run<R.Result>(
      function(): R.Result => R.Read(
        Path,
        Info.Length,
        Info.LastWriteTimeUtc.Ticks,
        T.CancellationToken.None
      )
    ).WaitAsync(Sys.TimeSpan.FromSeconds(5.0));
    X.Assert.True(Result.Error = null, Result.Error);
    X.Assert.Equal<int>(2, Result.Items.Length);
    X.Assert.Equal<string>('https://example.invalid/a?x=1', Result.Items[0].Reference.Location);
    X.Assert.Equal<string>('Artist - Song: One, Two', Result.Items[0].Title);
    X.Assert.Equal<string>('', Result.Items[1].Title);
  end function;

  // FPL's experimental URI extraction retains cross-scheme order and file URI data.
  [X.FactAttribute]
  public procedure FplAndForeignReferences();
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'list.fpl');
    const Local: string := new Sys.Uri(IO.Path.Combine(Root.Path, 'ü.ogg')).AbsoluteUri;
    IO.File.WriteAllBytes(
      Path,
      Text.Encoding.UTF8.GetBytes(
        'https://example.invalid/first' + #0 + Local + #0 + 'http://example.invalid/last' + #0
      )
    );
    const Info: IO.FileInfo := new IO.FileInfo(Path);
    const Result: R.Result := R.Read(
      Path,
      Info.Length,
      Info.LastWriteTimeUtc.Ticks,
      T.CancellationToken.None
    );
    X.Assert.True(Result.Error = null, Result.Error);
    X.Assert.Equal<int>(3, Result.Items.Length);
    X.Assert.Equal<string>('https://example.invalid/first', Result.Items[0].Reference.Location);
    X.Assert.Equal<string>(IO.Path.Combine(Root.Path, 'ü.ogg'), Result.Items[1].Reference.Location);
    X.Assert.Equal<string>('http://example.invalid/last', Result.Items[2].Reference.Location);
    if not Sys.OperatingSystem.IsWindows() then
      X.Assert.Null(References.Resolve('C:\Music\a.mp3', Root.Path).Key);
    end if;
  end procedure;

  // Bad XML and stale stamps report failures instead of successful empty replacements.
  [X.FactAttribute]
  public procedure RejectedReads();
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'list.xspf');
    IO.File.WriteAllText(Path, '<playlist><track>');
    const Info: IO.FileInfo := new IO.FileInfo(Path);
    X.Assert.NotNull(
      R.Read(Path, Info.Length, Info.LastWriteTimeUtc.Ticks, T.CancellationToken.None).Error
    );
    X.Assert.NotNull(
      R.Read(Path, Info.Length + 1L, Info.LastWriteTimeUtc.Ticks, T.CancellationToken.None).Error
    );
    X.Assert.NotNull(
      R.Read(Path, 16777217L, Info.LastWriteTimeUtc.Ticks, T.CancellationToken.None).Error
    );
  end procedure;
end record;

end unit;
