// [Documentation](../../doc/library.md#playlists)

// Bounded background checks for cached and user-owned playlist tests.
unit FpasAmp.Library.Tests.PlaylistSupport;

uses
  FpasAmp.Library.Playlists.Access as Access, FpasAmp.Library.Playlists.Model as M,
  System as Sys, System.Collections.Immutable as I, System.Threading as T, System.Threading.Tasks as Tasks;

// Waits at most fifteen seconds for a summary page satisfying `Accept`.
// `Session` remains borrowed from its caller-owned inventory lifetime.
public async function Until(Session: Access.Session; Accept: function(I.ImmutableArray<M.Summary>): bool): Tasks.Task<I.ImmutableArray<M.Summary>>;
begin
  using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
  while true do
    const Values: I.ImmutableArray<M.Summary> := await Session.ListAsync(
      new M.Query(),
      Deadline.Token
    );
    if Accept(Values) then
      return Values;
    end if;

    await Tasks.Task.Delay(10, Deadline.Token);
  end while;
end function;

// Loads `Key`, rejecting an unexpected absent list for test setup.
public async function Read(Session: Access.Session; Key: M.Key): Tasks.Task<M.Playlist>;
begin
  const Value: M.Playlist? := await Session.ReadAsync(Key, T.CancellationToken.None);
  if Value = null then
    raise new Sys.InvalidOperationException('Expected the playlist to exist.');
  end if;

  return Value;
end function;

end unit;
