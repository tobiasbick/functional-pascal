// [Documentation](../../../doc/library.md#playlists)

// The navigation observer publishes complete snapshots and committed changes.
unit FpasAmp.Library.Tests.PlaylistObservation;

uses
  FpasAmp.Library.Tests.Support as H, FpasAmp.Library.Tests.MetadataSupport as F,
  FpasAmp.Library.Inventory.Monitoring as Monitor, FpasAmp.Library.Playlists.Model as M,
  FpasAmp.Library.Sources as Sources,
  FpasAmp.Library.Playlists.Access as Access, FpasAmp.Library.UserData.Schema as Users,
  FpasAmp.Library.Persistence.Sql as Sql, Microsoft.Data.Sqlite as Db,
  System as Sys, System.IO as IO, System.Collections.Immutable as I, System.Threading as T,
  System.Threading.Channels as Channels, System.Threading.Tasks as Tasks, Xunit as X;

// Background summary snapshots stay current during database and filesystem changes.
public type ObservationTests = record
  // More than one query page remains complete; edits/deletions propagate and stop joins.
  [X.FactAttribute]
  public async function AllPagesChangesAndCancellation(): Tasks.Task;
  begin
    using const Data: H.Folder := H.Folder.Create();
    await using const Session: Monitor.Session := F.Start([], Data.Path);
    const Lists: Access.Session := F.Tags(Session).Playlists;
    await F.Tags(Session).Ready;
    begin
      using const Connection: Db.SqliteConnection := Users.Open(
        IO.Path.Combine(Data.Path, 'userdata.db')
      );
      using const Transaction: Db.SqliteTransaction := Connection.BeginTransaction();
      for Index: int := 0 to 250 do
        Sql.Execute(
          Connection,
          'INSERT INTO playlists VALUES($id,$name,$key,0);',
          Transaction,
          ['$id', '$name', '$key'],
          [
            Sys.Guid.NewGuid().ToString('N'),
            'List ' + Index.ToString('D3'),
            'LIST ' + Index.ToString('D3')
          ]
        );
      end for;

      Transaction.Commit();
    end;

    using const Stop: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
    const Updates: Channels.Channel<I.ImmutableArray<M.Summary>> := Channels.Channel.CreateUnbounded<I.ImmutableArray<M.Summary>>();
    const Running: Tasks.Task := Lists.ObserveAsync(
      function(Items: I.ImmutableArray<M.Summary>): Tasks.Task => Updates.Writer.WriteAsync(
        Items,
        Stop.Token
      ).AsTask(),
      Stop.Token
    );
    try
      const Initial: I.ImmutableArray<M.Summary> := await Updates.Reader.ReadAsync(Stop.Token);
      X.Assert.Equal<int>(251, Initial.Length);
      X.Assert.Equal<string>('List 000', Initial[0].Name);
      X.Assert.Equal<string>('List 250', Initial[250].Name);
      discard await Lists.SaveAsync(Initial[0].Identity.Id, 'Changed', [], Stop.Token);
      const Changed: I.ImmutableArray<M.Summary> := await Updates.Reader.ReadAsync(Stop.Token);
      X.Assert.Equal<int>(251, Changed.Length);
      X.Assert.Equal<string>('Changed', Changed[0].Name);
      await Lists.DeleteAsync(Changed[0].Identity.Id, Stop.Token);
      const Deleted: I.ImmutableArray<M.Summary> := await Updates.Reader.ReadAsync(Stop.Token);
      X.Assert.Equal<int>(250, Deleted.Length);
    finally
      Stop.Cancel();
      try
        await Running;
      catch Cancelled: Sys.OperationCanceledException do
      end try;
    end try;
  end function;

  // Reopening the catalogue publishes a cached list before another scan discovers a new list.
  [X.FactAttribute]
  public async function ReopeningShowsCachedAndNewlyDiscoveredLists(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Source: Sources.MusicSource := F.Source(Root.Path) with
      ScanPlaylists := true;
    end with;
    IO.File.WriteAllText(IO.Path.Combine(Root.Path, 'Cached list.m3u'), 'cached.mp3' + #10);
    begin
      await using const Library: Monitor.Session := F.Start([Source], Data.Path);
      using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
      const Lists: Access.Session := F.Tags(Library).Playlists;
      while (await Lists.ListAsync(new M.Query(), Deadline.Token)).Length = 0 do
        await Tasks.Task.Delay(20, Deadline.Token);
      end while;
    end;

    IO.File.WriteAllText(IO.Path.Combine(Root.Path, 'New list.m3u'), 'new.mp3' + #10);
    using const Stop: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
    await using const Library: Monitor.Session := F.Start(
      [
        Source with
          Paused := true;
        end with
      ], Data.Path
    );
    const Updates: Channels.Channel<I.ImmutableArray<M.Summary>> := Channels.Channel.CreateUnbounded<I.ImmutableArray<M.Summary>>();
    const Running: Tasks.Task := F.Tags(Library).Playlists.ObserveAsync(
      function(Items: I.ImmutableArray<M.Summary>): Tasks.Task => Updates.Writer.WriteAsync(
        Items, Stop.Token
      ).AsTask(),
      Stop.Token
    );
    try
      var Snapshot: I.ImmutableArray<M.Summary> := await Updates.Reader.ReadAsync(Stop.Token);
      X.Assert.Equal<int>(1, Snapshot.Length);
      X.Assert.Equal<string>('Cached list', Snapshot[0].Name);
      Library.Configure([Source]);
      while Snapshot.Length = 1 do
        Snapshot := await Updates.Reader.ReadAsync(Stop.Token);
      end while;

      X.Assert.Equal<int>(2, Snapshot.Length);
      X.Assert.Equal<string>('New list', Snapshot[1].Name);
      X.Assert.Equal<long>(1L, Snapshot[1].Count);
    finally
      Stop.Cancel();
      try
        await Running;
      catch Cancelled: Sys.OperationCanceledException do
      end try;
    end try;
  end function;
end record;

end unit;
