// [Documentation](../../../doc/library.md#playlists)

// Durable jobs and serialized schema migration support independent background stages.
unit FpasAmp.Library.Tests.PlaylistStorage;

uses
  FpasAmp.Library.Tests.Support as H, FpasAmp.Library.Tests.StorageSupport as D,
  FpasAmp.Library.Tests.MetadataSupport as F, FpasAmp.Library.Tests.PlaylistSupport as P,
  FpasAmp.Library.Persistence.Sql as Sql, FpasAmp.Library.Sources as S,
  FpasAmp.Library.Playlists.Model as M, FpasAmp.Library.Metadata.Internal.Pending as Pending,
  FpasAmp.Library.Inventory.Monitoring as Monitor, Microsoft.Data.Sqlite as Db, System.IO as IO, System.Collections.Immutable as I, System.Threading.Tasks as Tasks, Xunit as X;

// Queue and upgrade correctness without a UI or deployment pipeline.
public type StorageTests = record
  // A changed low-ID file is requeued even after later rows have been processed.
  [X.FactAttribute]
  public procedure DurableJobsAreIndexedAndRequeued();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Connection: Db.SqliteConnection := D.Open(':memory:');
    const Source: S.MusicSource := H.Source('music', Root.Path);
    D.Configure(Connection, [Source]);
    Pending.Configure(Connection, [Source]);
    const Path: string := IO.Path.Combine(Root.Path, 'track.mp3');
    D.Save(Connection, [Source], D.Observation(Root.Path, [Path], []));
    Sql.Execute(Connection, 'UPDATE files SET size=10,modified_utc=20;', null, [], []);
    const First: Pending.File? := Pending.Next(Connection);
    X.Assert.NotNull(First);
    Sql.Execute(Connection, 'DELETE FROM content_jobs;', null, [], []);
    Sql.Execute(Connection, 'UPDATE files SET size=10,modified_utc=20;', null, [], []);
    X.Assert.Null(Pending.Next(Connection));
    Sql.Execute(Connection, 'UPDATE files SET size=11;', null, [], []);
    X.Assert.NotNull(Pending.Next(Connection));
    Pending.Configure(
      Connection, [
        Source with
          Extensions := ['.ogg'];
          ScanPlaylists := true;
        end with
      ]
    );
    X.Assert.Null(Pending.Next(Connection));
    Pending.Configure(
      Connection, [
        Source with
          Path := IO.Path.Combine(Root.Path, 'other');
        end with
      ]
    );
    X.Assert.Null(Pending.Next(Connection));
  end procedure;

  // Both owned stages start safely against a v2 catalogue without duplicate ALTERs.
  [X.FactAttribute]
  public async function UpgradeWithBothStages(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'list.m3u8');
    IO.File.WriteAllText(Path, 'missing.mp3' + #10);
    begin
      using const Connection: Db.SqliteConnection := Sql.Open(
        IO.Path.Combine(Data.Path, 'library.db')
      );
      Sql.Execute(
        Connection,
        'CREATE TABLE files(id INTEGER PRIMARY KEY AUTOINCREMENT,path_key TEXT NOT NULL UNIQUE,path TEXT NOT NULL,directory_key TEXT NOT NULL,size INTEGER,modified_utc INTEGER); PRAGMA user_version=2;',
        null,
        [],
        []
      );
    end;
    const Source: S.MusicSource := new S.MusicSource(
      'music',
      'Music',
      Root.Path,
      false,
      [],
      ScanPlaylists := true
    );
    await using const Session: Monitor.Session := F.Start([Source], Data.Path);
    const Lists: I.ImmutableArray<M.Summary> := await P.Until(
      F.Tags(Session).Playlists,
      function(Items: I.ImmutableArray<M.Summary>): bool => Items.Length = 1 and Items[0].Count = 1L
    );
    X.Assert.Null(Lists[0].Error);
    using const Connection: Db.SqliteConnection := Sql.Open(
      IO.Path.Combine(Data.Path, 'library.db')
    );
    X.Assert.Equal<long>(4L, D.Number(Connection, 'PRAGMA user_version;'));
  end function;
end record;

end unit;
