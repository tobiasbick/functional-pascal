// [Documentation](../../doc/library.md#search)

// Search keys and ranking: folded words, sound-alike codes, typos and word order.
unit FpasAmp.Library.Tests.Search;

uses
  FpasAmp.Library.Search.Text as Words, FpasAmp.Library.Search.Matching as Matching,
  System.Collections.Immutable as I, Xunit as X;

function Album(Title: string; Artist: string; Genre: string := ''): Matching.Document;
begin
  return Matching.Document.Create(
    [
      new Matching.Field(Title, 1.0),
      new Matching.Field(Artist, 0.9),
      new Matching.Field(Genre, 0.6)
    ]
  );
end function;

// A small catalogue with similar names, so ranking and noise are visible.
function Catalogue(): I.ImmutableArray<Matching.Document>;
begin
  return I.ImmutableArray.CreateRange<Matching.Document>(
    [
      Album('The Wall', 'Pink Floyd', 'Progressive rock'),
      Album('Funhouse', 'Pink', 'Pop'),
      Album('Last Date', 'Floyd Cramer', 'Country'),
      Album('Abbey Road', 'The Beatles', 'Rock'),
      Album('Homogenic', 'Björk', 'Electronic'),
      Album('Master of Puppets', 'Metallica', 'Metal'),
      Album('1999', 'Prince', 'Funk'),
      Album('Straßenmusik', 'Herbert Meier', 'Volksmusik')
    ]
  );
end function;

function Best(Text: string): int;
begin
  const Scores: array of double := Matching.Rank(Matching.Query.Parse(Text), Catalogue());
  var Index: int := -1;
  var Top: double := 0.0;
  for Position: int := 0 to Scores.Length - 1 do
    if Scores[Position] > Top then
      Top := Scores[Position];
      Index := Position;
    end if;
  end for;

  return Index;
end function;

function Found(Text: string; Position: int): bool;
begin
  return Matching.Rank(Matching.Query.Parse(Text), Catalogue())[Position] > 0.0;
end function;

// Checks that search behaves like a modern search box rather than a string comparison.
public type SearchTests = record
  // Case, accents, special letters and apostrophes do not split or distinguish words.
  [X.FactAttribute]
  public procedure WordsAreFolded();
  begin
    X.Assert.Equal<string>(['bjork', 'homogenic'], Words.Words('Björk – Homogénic!'));
    X.Assert.Equal<string>(['strasse', 'aeon', 'dont'], Words.Words('STRASSE Æon Don''t'));
    X.Assert.Equal<string>(['strasse'], Words.Words('Straße'));
    X.Assert.Empty(Words.Words('*?  ---'));
  end procedure;

  // Supplementary Unicode letters and decimal digits also form searchable words.
  [X.FactAttribute]
  public procedure SupplementaryLettersAndDigitsAreSearchable();
  begin
    X.Assert.Equal<string>(['𐐨𐐩', '𐒡𐒢'], Words.Words('𐐀𐐁 – 𐒡𐒢'));
    X.Assert.True(Words.Numeric('𐒡𐒢'));
    X.Assert.False(Words.Numeric('𐐨𐐩'));
    const Items: I.ImmutableArray<Matching.Document> := I.ImmutableArray.CreateRange<Matching.Document>(
      [Album('𐐨𐐩', ''), Album('𐒡𐒢', ''), Album('𐒡𐒣', '')]
    );
    X.Assert.True(Matching.Rank(Matching.Query.Parse('𐐀𐐁'), Items)[0] > 0.0);
    const Scores: array of double := Matching.Rank(Matching.Query.Parse('𐒡𐒢'), Items);
    X.Assert.True(Scores[1] > 0.0);
    X.Assert.Equal<double>(0.0, Scores[2]);
  end procedure;

  // Names that sound alike share a phonetic code; numbers have none.
  [X.FactAttribute]
  public procedure SoundAlikeNamesShareCodes();
  begin
    X.Assert.Equal<string>(Words.Phonetic('meier'), Words.Phonetic('mayer'));
    X.Assert.Equal<string>(Words.Phonetic('meier'), Words.Phonetic('maier'));
    X.Assert.Equal<string>(Words.Phonetic('schmidt'), Words.Phonetic('schmitt'));
    X.Assert.NotEqual<string>(Words.Phonetic('meier'), Words.Phonetic('miller'));
    X.Assert.Equal<string>('', Words.Phonetic('1999'));
  end procedure;

  // A swap of neighbors counts as one edit, and the limit stops early.
  [X.FactAttribute]
  public procedure DistanceCountsEdits();
  begin
    X.Assert.Equal<int>(1, Words.Distance('beatles', 'beatels', 2));
    X.Assert.Equal<int>(1, Words.Distance('metalica', 'metallica', 2));
    X.Assert.Equal<int>(0, Words.Distance('rock', 'rock', 1));
    X.Assert.Equal<int>(2, Words.Distance('floyd', 'pink', 1));
    X.Assert.Equal<int>(1, Words.Distance('beatles', 'beatels', int.MaxValue));
  end procedure;

  // Words match in any order, and the album with more of them ranks first.
  [X.FactAttribute]
  public procedure WordsMatchInAnyOrder();
  begin
    X.Assert.Equal<int>(0, Best('wall pink'));
    X.Assert.Equal<int>(0, Best('pink floyd wall'));
    X.Assert.True(Found('floyd', 0) and Found('floyd', 2));
    X.Assert.False(Found('floyd', 3));
  end procedure;

  // One matching word is enough; an unknown second word does not hide the album.
  [X.FactAttribute]
  public procedure AnyWordIsEnough();
  begin
    X.Assert.Equal<int>(0, Best('wall xylophone'));
    X.Assert.True(Found('puppets zzzz', 5));
  end procedure;

  // Typing the start of a word already finds it.
  [X.FactAttribute]
  public procedure PrefixesMatchWhileTyping();
  begin
    X.Assert.Equal<int>(4, Best('homo'));
    X.Assert.Equal<int>(5, Best('mast pupp'));
  end procedure;

  // Typos, accents and sound-alike spellings still find the album.
  [X.FactAttribute]
  public procedure ForgivesSpelling();
  begin
    X.Assert.Equal<int>(3, Best('beatels'));
    X.Assert.Equal<int>(5, Best('metalica'));
    X.Assert.Equal<int>(4, Best('bjork'));
    X.Assert.Equal<int>(7, Best('mayer'));
    X.Assert.Equal<int>(7, Best('strassenmusik'));
  end procedure;

  // Words written together find names written apart.
  [X.FactAttribute]
  public procedure JoinedWordsMatch();
  begin
    X.Assert.Equal<int>(0, Best('pinkfloyd'));
  end procedure;

  // Numbers match exactly or as a prefix, never as a near miss.
  [X.FactAttribute]
  public procedure NumbersAreExact();
  begin
    X.Assert.Equal<int>(6, Best('1999'));
    X.Assert.False(Found('1998', 6));
  end procedure;

  // Quoted phrases require the original punctuation and order within one field.
  [X.FactAttribute]
  public procedure QuotedPhrasesRestrictRankedResults();
  begin
    const Items: I.ImmutableArray<Matching.Document> := I.ImmutableArray.CreateRange<Matching.Document>(
      [
        Album('Happy X-Mas (Live)', 'The Band'),
        Album('Happy X Mas', 'The Band'),
        Album('X-Mas Happy', 'The Band'),
        Album('Happy', 'X-Mas'),
        Album('Happy X-Mas', 'Another Band'),
        Album('Hapy X-Mas', 'The Band')
      ]
    );
    const Phrase: string := '"happy x-mas"';
    const Exact: array of double := Matching.Rank(Matching.Query.Parse(Phrase), Items);
    X.Assert.True(Exact[0] > 0.0 and Exact[4] > 0.0);
    X.Assert.Equal<double>(0.0, Exact[1]);
    X.Assert.Equal<double>(0.0, Exact[2]);
    X.Assert.Equal<double>(0.0, Exact[3]);
    X.Assert.Equal<double>(0.0, Exact[5]);
    const Live: array of double := Matching.Rank(Matching.Query.Parse(Phrase + ' live'), Items);
    X.Assert.True(Live[0] > Live[4] and Live[4] > 0.0);
    const Both: array of double := Matching.Rank(
      Matching.Query.Parse(Phrase + ' "the band"'),
      Items
    );
    X.Assert.True(Both[0] > 0.0);
    X.Assert.Equal<double>(0.0, Both[4]);
  end procedure;

  // Wildcards and empty text produce no search terms.
  [X.FactAttribute]
  public procedure WildcardsAreNotSearchTerms();
  begin
    X.Assert.True(Matching.Query.Parse('* ?').IsEmpty());
    X.Assert.Equal<int>(-1, Best('*'));
    X.Assert.Equal<int>(-1, Best(''));
  end procedure;
end record;

end unit;
