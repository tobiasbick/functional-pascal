// [Documentation](../../../doc/library.md#reconciliation-and-persistence)

// Source-scoped persistence, deletion authority and transaction rollback.
unit FpasAmp.Library.Tests.StorageCheckpoints;

uses FpasAmp.Library.Inventory.Internal.Observations as O;
uses FpasAmp.Library.Persistence.Checkpoints as Checkpoints;
uses FpasAmp.Library.Persistence.Sql as Sql;
uses FpasAmp.Library.Sources as S;
uses FpasAmp.Library.Tests.StorageSupport as D;
uses FpasAmp.Library.Tests.Support as H;
uses Microsoft.Data.Sqlite as Db;
uses System.Collections.Generic as C;
uses System.IO as IO;
uses System.Threading as T;
uses Xunit as X;

// Exercises SQLite transactions without decoding or opening media files.
public type StorageCheckpointTests = record
  // One physical path has one stable ID and several independent source memberships.
  [X.FactAttribute]
  public procedure SharedUnicodePathsHaveStableIds();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Connection: Db.SqliteConnection := D.Open(':memory:');
    const Album: string := IO.Path.Combine(Root.Path, 'album');
    const Track: string := IO.Path.Combine(Album, 'L''été 夜.FLAC');
    const Sources: array of S.MusicSource := [
      H.Source('parent''id', Root.Path),
      H.Source('child', Album)
    ];
    D.Configure(Connection, Sources);
    D.Save(Connection, Sources, D.Observation(Root.Path, [], [Album]));
    D.Save(Connection, Sources, D.Observation(Album, [Track], []));
    const Id: long := D.FileId(Connection, Track);
    X.Assert.True(Id > 0L);
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM files;'));
    X.Assert.Equal<long>(2L, D.Number(Connection, 'SELECT count(*) FROM source_files;'));
    D.Save(Connection, Sources, D.Observation(Album, [Track], []));
    X.Assert.Equal<long>(Id, D.FileId(Connection, Track));
    D.Configure(Connection, [Sources[1]]);
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM source_files;'));
    X.Assert.Equal<long>(Id, D.FileId(Connection, Track));
    D.Configure(Connection, []);
    X.Assert.Equal<long>(0L, D.Number(Connection, 'SELECT count(*) FROM files;'));
  end procedure;

  // An incomplete directory cannot delete unseen children/files or advance its last success.
  [X.FactAttribute]
  public procedure FailedEnumerationRetainsMembershipAndLastSuccess();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Connection: Db.SqliteConnection := D.Open(':memory:');
    const Sources: array of S.MusicSource := [H.Source('root', Root.Path)];
    const Child: string := IO.Path.Combine(Root.Path, 'album');
    const Track: string := IO.Path.Combine(Child, 'track.flac');
    D.Configure(Connection, Sources);
    D.Save(Connection, Sources, D.Observation(Root.Path, [], [Child]));
    D.Save(Connection, Sources, D.Observation(Child, [Track], []));
    const Checked: long := D.Number(
      Connection,
      'SELECT checked_utc FROM directories WHERE parent_key NOT IN(SELECT path_key FROM directories);'
    );
    D.Save(Connection, Sources, D.Observation(Root.Path, [], [], false, 'temporarily unavailable'));
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM files;'));
    X.Assert.Equal<long>(2L, D.Number(Connection, 'SELECT count(*) FROM directories;'));
    X.Assert.Equal<long>(
      Checked,
      D.Number(Connection, 'SELECT checked_utc FROM directories WHERE error IS NOT NULL;')
    );
    D.Save(Connection, Sources, D.Observation(Root.Path, [], []));
    X.Assert.Equal<long>(0L, D.Number(Connection, 'SELECT count(*) FROM files;'));
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM directories;'));
  end procedure;

  // Removing a child from an active parent preserves an offline nested source's view.
  [X.FactAttribute]
  public procedure OfflineMembershipSurvivesActiveParentDeletion();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Connection: Db.SqliteConnection := D.Open(':memory:');
    const Child: string := IO.Path.Combine(Root.Path, 'album');
    const Track: string := IO.Path.Combine(Child, 'track.flac');
    const Active: array of S.MusicSource := [
      H.Source('parent', Root.Path),
      H.Source('child', Child)
    ];
    D.Configure(Connection, Active);
    D.Save(Connection, Active, D.Observation(Root.Path, [], [Child]));
    D.Save(Connection, Active, D.Observation(Child, [Track], []));
    const Id: long := D.FileId(Connection, Track);
    const Sources: array of S.MusicSource := [
      Active[0], Active[1] with
        Offline := true;
      end with
    ];
    D.Configure(Connection, Sources);
    D.Save(Connection, Sources, D.Observation(Root.Path, [], []));
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM source_files;'));
    X.Assert.Equal<long>(Id, D.FileId(Connection, Track));
    X.Assert.Equal<long>(
      1L,
      D.Number(Connection, 'SELECT count(*) FROM directories WHERE source_id=''child'';')
    );
  end procedure;

  // A superseded checkpoint rolls back directory writes and all partially inserted files.
  [X.FactAttribute]
  public procedure SupersededCheckpointRollsBackPartialWrites();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Connection: Db.SqliteConnection := D.Open(':memory:');
    const Sources: array of S.MusicSource := S.Normalize([H.Source('root', Root.Path)]);
    const Track: string := IO.Path.Combine(Root.Path, 'original.flac');
    D.Configure(Connection, Sources);
    D.Save(Connection, Sources, D.Observation(Root.Path, [Track], []));
    const Checked: long := D.Number(Connection, 'SELECT checked_utc FROM directories;');
    const Files: C.HashSet<string> := new C.HashSet<string>();
    for Index: int := 0 to 999 do
      discard Files.Add(IO.Path.Combine(Root.Path, Index.ToString() + '.flac'));
    end for;
    const Observation: O.DirectoryObservation := new O.DirectoryObservation(
      Root.Path,
      Files,
      new C.HashSet<string>(),
      true,
      null
    );
    var Calls: int := 0;
    X.Assert.False(
      Checkpoints.Save(
        Connection, Observation, Sources, function(): bool begin
          Calls := Calls + 1;
          return Calls < 100;
        end function, T.CancellationToken.None
      )
    );
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM files;'));
    X.Assert.True(D.FileId(Connection, Track) > 0L);
    X.Assert.Equal<long>(Checked, D.Number(Connection, 'SELECT checked_utc FROM directories;'));
  end procedure;

  // A SQLite failure propagates and rolls back the preceding directory update.
  [X.FactAttribute]
  public procedure DatabaseFailureRollsBackTheWholeDirectory();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Connection: Db.SqliteConnection := D.Open(':memory:');
    const Sources: array of S.MusicSource := [H.Source('root', Root.Path)];
    D.Configure(Connection, Sources);
    Sql.Execute(
      Connection,
      'CREATE TEMP TRIGGER reject_files BEFORE INSERT ON files BEGIN SELECT RAISE(ABORT,''test write failure''); END;',
      null,
      [],
      []
    );
    var Failed: bool := false;
    try
      D.Save(
        Connection,
        Sources,
        D.Observation(Root.Path, [IO.Path.Combine(Root.Path, 'track.flac')], [])
      );
    catch Failure: Db.SqliteException do
      Failed := true;
    end try;

    X.Assert.True(Failed);
    X.Assert.Equal<long>(0L, D.Number(Connection, 'SELECT count(*) FROM directories;'));
    X.Assert.Equal<long>(0L, D.Number(Connection, 'SELECT count(*) FROM files;'));
    Sql.Execute(Connection, 'DROP TRIGGER reject_files;', null, [], []);
    D.Save(Connection, Sources, D.Observation(Root.Path, [], []));
    X.Assert.Equal<long>(
      1L,
      D.Number(Connection, 'SELECT count(*) FROM directories WHERE checked_utc IS NOT NULL;')
    );
  end procedure;
end record;

end unit;
