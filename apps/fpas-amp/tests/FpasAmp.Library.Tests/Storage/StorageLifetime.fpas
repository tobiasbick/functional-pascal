// [Documentation](../../../doc/library.md#reconciliation-and-persistence)

// Real disk database restart, unavailable storage and observable database failures.
unit FpasAmp.Library.Tests.StorageLifetime;

uses
  FpasAmp.Library.Tests.Support as H, FpasAmp.Library.Tests.StorageSupport as D,
  FpasAmp.Library.Inventory.Monitoring as Monitor, FpasAmp.Library.Inventory.Model as M,
  FpasAmp.Library.Sources as S, Microsoft.Data.Sqlite as Db, System as Sys,
  System.IO as IO, System.Threading as T, System.Threading.Tasks as Tasks, Xunit as X;

// Exercises the same worker-owned persistence lifetime used by the desktop app.
public type StorageLifetimeTests = record
  // A stopped/restarted session retains IDs, offline files and unavailable-root data.
  [X.FactAttribute]
  public async function RestartRetainsOfflineAndUnavailableFilesUntilAConfirmedEmptyScan(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Path: string := IO.Directory.CreateDirectory(
      IO.Path.Combine(Root.Path, 'music')
    ).FullName;
    const Track: string := IO.Path.Combine(Path, 'track.flac');
    const Database: string := IO.Path.Combine(Data.Path, 'library.db');
    const Source: S.MusicSource := H.Source('root', Path);
    IO.File.WriteAllText(Track, 'presence only');
    begin
      await using const First: Monitor.Session := Monitor.Session.Start(
        [Source],
        Database,
        T.CancellationToken.None,
        new M.Options(0, 60000, 4)
      );
      discard await H.Until(
        First,
        function(Value: M.Snapshot): bool => H.Has(Value.Sources[0], Track)
      );
    end;
    var Id: long := 0L;
    begin
      using const Connection: Db.SqliteConnection := D.Open(Database);
      Id := D.FileId(Connection, Track);
      X.Assert.True(Id > 0L);
      X.Assert.Equal<long>(
        1L,
        D.Number(Connection, 'SELECT count(*) FROM directories WHERE checked_utc IS NOT NULL;')
      );
    end;

    IO.Directory.Delete(Path, true);
    begin
      await using const Offline: Monitor.Session := Monitor.Session.Start(
        [
          Source with
            Offline := true;
          end with
        ], Database, T.CancellationToken.None, new M.Options(0, 60000, 4)
      );
      discard await H.Until(
        Offline,
        function(Value: M.Snapshot): bool => Value.Sources[
          0
        ].Status = M.Availability.Offline and H.Has(
          Value.Sources[0],
          Track
        )
      );
    end;

    begin
      await using const Missing: Monitor.Session := Monitor.Session.Start(
        [Source],
        Database,
        T.CancellationToken.None,
        new M.Options(0, 60000, 4)
      );
      discard await H.Until(
        Missing,
        function(Value: M.Snapshot): bool => Value.Sources[
          0
        ].Status = M.Availability.Unavailable and H.Has(
          Value.Sources[0],
          Track
        )
      );
    end;

    begin
      using const Connection: Db.SqliteConnection := D.Open(Database);
      X.Assert.Equal<long>(Id, D.FileId(Connection, Track));
      X.Assert.Equal<long>(
        1L,
        D.Number(
          Connection,
          'SELECT count(*) FROM directories WHERE error IS NOT NULL AND checked_utc IS NOT NULL;'
        )
      );
    end;

    discard IO.Directory.CreateDirectory(Path);
    begin
      await using const Empty: Monitor.Session := Monitor.Session.Start(
        [Source],
        Database,
        T.CancellationToken.None,
        new M.Options(0, 60000, 4)
      );
      discard await H.Until(
        Empty,
        function(Value: M.Snapshot): bool => Value.Sources[
          0
        ].Status = M.Availability.Ready and Value.Sources[0].Files.Length = 0
      );
    end;

    using const Connection: Db.SqliteConnection := D.Open(Database);
    X.Assert.Equal<long>(0L, D.Number(Connection, 'SELECT count(*) FROM files;'));
    X.Assert.Equal<long>(0L, D.Number(Connection, 'SELECT count(*) FROM source_files;'));
  end function;

  // A vanished nested root remains unavailable while its active parent reconciles deletion.
  [X.FactAttribute]
  public async function NestedMissingSourceRetainsItsOwnMembershipAcrossRestart(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Child: string := IO.Directory.CreateDirectory(
      IO.Path.Combine(Root.Path, 'album')
    ).FullName;
    const Track: string := IO.Path.Combine(Child, 'track.flac');
    IO.File.WriteAllText(Track, '');
    const Sources: array of S.MusicSource := [
      H.Source('parent', Root.Path),
      H.Source('child', Child)
    ];
    const Database: string := IO.Path.Combine(Data.Path, 'library.db');
    begin
      await using const First: Monitor.Session := Monitor.Session.Start(
        Sources,
        Database,
        T.CancellationToken.None,
        new M.Options(0, 60000, 4)
      );
      discard await H.Until(
        First,
        function(Value: M.Snapshot): bool => H.Has(Value.Sources[1], Track)
      );
    end;

    IO.Directory.Delete(Child, true);
    begin
      await using const Missing: Monitor.Session := Monitor.Session.Start(
        Sources,
        Database,
        T.CancellationToken.None,
        new M.Options(0, 60000, 4)
      );
      const View: M.Snapshot := await H.Until(
        Missing,
        function(Value: M.Snapshot): bool => Value.Sources[1].Status = M.Availability.Unavailable
      );
      X.Assert.True(H.Has(View.Sources[1], Track));
      X.Assert.Equal<int>(0, View.Sources[0].Files.Length);
    end;

    using const Connection: Db.SqliteConnection := D.Open(Database);
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM files;'));
    X.Assert.Equal<long>(
      1L,
      D.Number(Connection, 'SELECT count(*) FROM source_files WHERE source_id=''child'';')
    );
    X.Assert.Equal<long>(
      0L,
      D.Number(Connection, 'SELECT count(*) FROM source_files WHERE source_id=''parent'';')
    );
  end function;

  // A damaged local index faults both completion channels and is never silently overwritten.
  [X.FactAttribute]
  public async function CorruptDatabaseIsReportedAndPreserved(): Tasks.Task;
  begin
    using const Data: H.Folder := H.Folder.Create();
    const Database: string := IO.Path.Combine(Data.Path, 'library.db');
    IO.File.WriteAllText(Database, 'this is deliberately not a SQLite database');
    const Before: string := Sys.Convert.ToHexString(IO.File.ReadAllBytes(Database));
    const Session: Monitor.Session := Monitor.Session.Start([], Database, T.CancellationToken.None);
    var Failed: bool := false;
    try
      await Session.Completion.WaitAsync(Sys.TimeSpan.FromSeconds(10));
    catch Failure: Db.SqliteException do
      Failed := true;
    end try;

    try
      await Session.DisposeAsync();
    catch Failure: Db.SqliteException do
    end try;

    X.Assert.True(Failed);
    X.Assert.True(Session.Changes.Completion.IsFaulted);
    X.Assert.Equal<string>(Before, Sys.Convert.ToHexString(IO.File.ReadAllBytes(Database)));
  end function;
end record;

end unit;
