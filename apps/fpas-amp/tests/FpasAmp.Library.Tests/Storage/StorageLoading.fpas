// [Documentation](../../../doc/library.md#reconciliation-and-persistence)

// Cached startup data, configuration context and safe database failures.
unit FpasAmp.Library.Tests.StorageLoading;

uses FpasAmp.Library.Inventory.Internal.Tree as Trees;
uses FpasAmp.Library.Inventory.Model as M;
uses FpasAmp.Library.Persistence.Loading as Loading;
uses FpasAmp.Library.Persistence.Locations as Locations;
uses FpasAmp.Library.Persistence.Schema as Schema;
uses FpasAmp.Library.Persistence.Sql as Sql;
uses FpasAmp.Library.Sources as S;
uses FpasAmp.Library.Tests.StorageSupport as D;
uses FpasAmp.Library.Tests.Support as H;
uses Microsoft.Data.Sqlite as Db;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;
uses System.IO as IO;
uses System.Threading as T;
uses Xunit as X;

// Verifies loading and policy changes without traversing the music roots.
public type StorageLoadingTests = record
  // Cached views are explicitly unverified and preserve paths independently of filesystem access.
  [X.FactAttribute]
  public procedure CachedViewsAndSourceContextAreExplicit();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Connection: Db.SqliteConnection := D.Open(':memory:');
    const Sources: array of S.MusicSource := S.Normalize(
      [H.Source('root', IO.Path.Combine(Root.Path, 'not-mounted'))]
    );
    const Track: string := IO.Path.Combine(Sources[0].Path, 'track.flac');
    D.Configure(Connection, Sources);
    D.Save(Connection, Sources, D.Observation(Sources[0].Path, [Track], []));
    const Previous: C.Dictionary<string, M.SourceSnapshot> := new C.Dictionary<string, M.SourceSnapshot>();
    const Views: I.ImmutableArray<M.SourceSnapshot> := Loading.Restore(
      Connection,
      Sources,
      Trees.Tree.Create(),
      Previous,
      T.CancellationToken.None
    );
    X.Assert.Equal<M.Availability>(M.Availability.Cached, Views[0].Status);
    X.Assert.True(H.Has(Views[0], Track));
    const Changed: array of S.MusicSource := S.Normalize(
      [
        Sources[0] with
          Path := Root.Path;
        end with
      ]
    );
    const Other: I.ImmutableArray<M.SourceSnapshot> := Loading.Restore(
      Connection,
      Changed,
      Trees.Tree.Create(),
      new C.Dictionary<string, M.SourceSnapshot>(),
      T.CancellationToken.None
    );
    X.Assert.Equal<int>(0, Other[0].Files.Length);
    D.Configure(Connection, Changed);
    X.Assert.Equal<long>(0L, D.Number(Connection, 'SELECT count(*) FROM files;'));
  end procedure;

  // Excluding formats updates only that source and preserves another source's shared file.
  [X.FactAttribute]
  public procedure FormatPoliciesAndOrphanCollectionAreSourceScoped();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Connection: Db.SqliteConnection := D.Open(':memory:');
    const Sources: array of S.MusicSource := [
      H.Source('first', Root.Path),
      H.Source('second', Root.Path)
    ];
    const Track: string := IO.Path.Combine(Root.Path, 'track.flac');
    D.Configure(Connection, Sources);
    D.Save(Connection, Sources, D.Observation(Root.Path, [Track], []));
    const Id: long := D.FileId(Connection, Track);
    D.Configure(
      Connection, [
        Sources[0] with
          Extensions := [];
        end with, Sources[1]
      ]
    );
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM source_files;'));
    X.Assert.Equal<long>(Id, D.FileId(Connection, Track));
    X.Assert.Equal<long>(
      0L,
      D.Number(Connection, 'SELECT count(*) FROM directories WHERE source_id=''first'';')
    );
    D.Configure(
      Connection, [
        Sources[0] with
          Extensions := [];
        end with
      ]
    );
    X.Assert.Equal<long>(0L, D.Number(Connection, 'SELECT count(*) FROM files;'));
  end procedure;

  // A configuration superseded during synchronization cannot remove the stored index.
  [X.FactAttribute]
  public procedure ObsoleteSourceConfigurationRollsBack();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Connection: Db.SqliteConnection := D.Open(':memory:');
    const Sources: array of S.MusicSource := [H.Source('root', Root.Path)];
    D.Configure(Connection, Sources);
    D.Save(
      Connection,
      Sources,
      D.Observation(Root.Path, [IO.Path.Combine(Root.Path, 'track.flac')], [])
    );
    var Calls: int := 0;
    X.Assert.False(
      Locations.Configure(
        Connection, [], function(): bool begin
          Calls := Calls + 1;
          return Calls < 2;
        end function, T.CancellationToken.None
      )
    );
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM files;'));
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM sources;'));
  end procedure;

  // Unknown schema versions are rejected without removing existing tables or rows.
  [X.FactAttribute]
  public procedure UnknownSchemaDoesNotResetData();
  begin
    using const Connection: Db.SqliteConnection := Sql.Open(':memory:');
    Sql.Execute(
      Connection,
      'CREATE TABLE sentinel(value TEXT); INSERT INTO sentinel VALUES(''keep''); PRAGMA user_version=99;',
      null,
      [],
      []
    );
    var Failed: bool := false;
    try
      Schema.Ensure(Connection);
    catch Failure: Sys.InvalidOperationException do
      Failed := true;
    end try;

    X.Assert.True(Failed);
    X.Assert.Equal<long>(99L, D.Number(Connection, 'PRAGMA user_version;'));
    X.Assert.Equal<long>(1L, D.Number(Connection, 'SELECT count(*) FROM sentinel;'));
  end procedure;
end record;

end unit;
