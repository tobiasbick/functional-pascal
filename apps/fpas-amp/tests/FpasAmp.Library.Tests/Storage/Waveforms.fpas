// [Documentation](../../../doc/library.md#focused-verification)

// Exercises the waveform cache through file-backed metadata sessions.
unit FpasAmp.Library.Tests.Waveforms;

uses FpasAmp.Library.Inventory.Monitoring as Monitor;
uses FpasAmp.Library.Metadata.Model as M;
uses FpasAmp.Library.Metadata.Monitoring as Metadata;
uses FpasAmp.Library.Metadata.Waveforms as Waves;
uses FpasAmp.Library.Persistence.Sql as Sql;
uses FpasAmp.Library.Tests.MetadataSupport as F;
uses FpasAmp.Library.Tests.StorageSupport as D;
uses FpasAmp.Library.Tests.Support as H;
uses Microsoft.Data.Sqlite as Db;
uses System.Collections.Immutable as I;
uses System.IO as IO;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;
uses Xunit as X;

// On-demand analysis, persistence and duplicate-content reuse.
public type WaveformTests = record
  // An indexed duplicate uses the stored envelope after opening a new session.
  [X.FactAttribute]
  public async function PlayedContentSharesOnePersistentWaveform(): Tasks.Task;
  begin
    using const Music: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Path: string := F.Write(Music.Path, 'first.mp3');
    IO.File.Copy(Path, IO.Path.Combine(Music.Path, 'duplicate.mp3'));
    const Database: string := IO.Path.Combine(Data.Path, 'library.db');
    begin
      await using const Session: Monitor.Session := F.Start([F.Source(Music.Path)], Data.Path);
      const Tags: Metadata.Session := F.Tags(Session);
      const Tracks: I.ImmutableArray of M.Entry := await F.Until(
        Tags,
        function(Items: I.ImmutableArray of M.Entry): bool => Items.Length = 2
      );
      using const Connection: Db.SqliteConnection := Sql.Open(Database);
      X.Assert.Equal of long(0L, D.Number(Connection, 'SELECT count(*) FROM waveforms;'));
      const Measured: array of float := await Tags.WaveformAsync(
        Tracks[0],
        T.CancellationToken.None
      );
      X.Assert.Equal of int(Waves.Buckets, Measured.Length);
      X.Assert.Equal of long(
        cast<long>(Waves.Buckets),
        D.Number(Connection, 'SELECT length(levels) FROM waveforms;')
      );
      // Mark one interval in the test cache; decoding the silent fixture cannot produce it.
      const Marker: array of byte := new byte[Waves.Buckets];
      Marker[0] := 255;
      Sql.Execute(Connection, 'UPDATE waveforms SET levels=$marker;', null, ['$marker'], [Marker]);
    end;

    await using const Reopened: Monitor.Session := F.Start([F.Source(Music.Path)], Data.Path);
    const Tags: Metadata.Session := F.Tags(Reopened);
    const Tracks: I.ImmutableArray of M.Entry := await F.Until(
      Tags,
      function(Items: I.ImmutableArray of M.Entry): bool => Items.Length = 2
    );
    X.Assert.Equal of string(Tracks[0].Sha256, Tracks[1].Sha256);
    const Cached: array of float := await Tags.WaveformAsync(Tracks[1], T.CancellationToken.None);
    X.Assert.Equal of float(1.0F, Cached[0]);
    X.Assert.Equal of float(0.0F, Cached[1]);
    using const Connection: Db.SqliteConnection := Sql.Open(Database);
    X.Assert.Equal of long(1L, D.Number(Connection, 'SELECT count(*) FROM waveforms;'));
    Sql.Execute(Connection, 'UPDATE waveforms SET levels=zeroblob(1);', null, [], []);
    const Rebuilt: array of float := await Tags.WaveformAsync(Tracks[1], T.CancellationToken.None);
    X.Assert.Equal of int(Waves.Buckets, Rebuilt.Length);
    X.Assert.Equal of long(
      cast<long>(Waves.Buckets),
      D.Number(Connection, 'SELECT length(levels) FROM waveforms;')
    );
  end function;
end record;

end unit;
