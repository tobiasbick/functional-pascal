// [Documentation](../../doc/media/README.md)

// Uses the public media projects from FPAS without an application or UI reference.
unit FpasAmp.Media.Tests.Consumer;

uses FpasAmp.Media.Audio as Audio;
uses FpasAmp.Media.Images as Images;
uses FpasAmp.Media.Tags.AudioFiles as Tags;
uses FpasAmp.Media.Tags.Pictures as Pictures;
uses FpasAmp.Media.Tags.Playlists as Lists;
uses System as Sys;
uses System.IO as IO;
uses System.Threading as T;
uses Xunit as X;

// Checks the FPAS-facing boundary with actual files, codecs and immutable record fields.
public type ConsumerTests = record
  // The same local file supplies technical metadata and a waveform without a device.
  [X.FactAttribute]
  public procedure InspectAudio();
  begin
    const File: string := IO.Path.Combine(Sys.AppContext.BaseDirectory, 'Fixtures', 'step.mp3');
    using const Stream: IO.FileStream := IO.File.OpenRead(File);
    const Info: Tags.Info := Tags.Read(Stream, '.mp3');
    X.Assert.True(Info.DurationMilliseconds > 0.0);
    X.Assert.True(Info.SampleRate > 0.0);
    X.Assert.True(Stream.CanRead);
    X.Assert.Null(Pictures.Read(File));
    const Levels: array of float := Audio.Analysis.LoudnessAsync(
      File,
      8,
      T.CancellationToken.None
    ).GetAwaiter().GetResult();
    X.Assert.Equal of int(8, Levels.Length);
  end procedure;

  // The decoder fits rather than crops, returning independent straight-alpha RGBA bytes.
  [X.FactAttribute]
  public procedure FitPng();
  begin
    const Encoded: array of byte := Sys.Convert.FromBase64String(
      'iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAIAAAB7QOjdAAAAD0lEQVR4nGP4z8DA8J8BAAf/Af8Bf4mnAAAAAElFTkSuQmCC'
    );
    const Tile: Images.Bitmap := Images.CoverDecoder.Decode(Encoded, 2, T.CancellationToken.None);
    X.Assert.Equal of int(2, Tile.Width);
    X.Assert.Equal of int(2, Tile.Height);
    X.Assert.Equal of int(16, Tile.Pixels.Length);
    const Row: int := if Tile.Pixels[3] = 0 then
      8
    else
      0
    end if;
    X.Assert.Equal of byte(255, Tile.Pixels[Row]);
    X.Assert.Equal of byte(0, Tile.Pixels[Row + 2]);
    X.Assert.Equal of byte(255, Tile.Pixels[Row + 3]);
    X.Assert.Equal of byte(255, Tile.Pixels[Row + 5]);
    X.Assert.Equal of byte(0, Tile.Pixels[8 - Row + 3]);
    using const Abort: T.CancellationTokenSource := new T.CancellationTokenSource();
    Abort.Cancel();
    discard X.Assert.Throws of Sys.OperationCanceledException(
      procedure() begin
        discard Images.CoverDecoder.Decode(Encoded, 2, Abort.Token);
      end procedure
    );
  end procedure;

  // Failed and cancelled replacement must preserve an existing playlist and leave no temporary file.
  [X.FactAttribute]
  public procedure FailedPlaylistReplacementIsAtomic();
  begin
    const Folder: IO.DirectoryInfo := IO.Directory.CreateTempSubdirectory();
    try
      const Path: string := IO.Path.Combine(Folder.FullName, 'safe.m3u8');
      IO.File.WriteAllText(Path, '#EXTM3U' + #10);
      using const Abort: T.CancellationTokenSource := new T.CancellationTokenSource();
      Abort.Cancel();
      discard X.Assert.Throws of Sys.OperationCanceledException(
        procedure() begin
          Lists.WriteM3u8(Path, [], true, Abort.Token);
        end procedure
      );
      discard X.Assert.Throws of Sys.ArgumentException(
        procedure() begin
          Lists.WriteM3u8(
            Path,
            [new Lists.Item('music.mp3', 'bad' + #10 + 'title')],
            true,
            T.CancellationToken.None
          );
        end procedure
      );
      discard X.Assert.Throws of Sys.ArgumentException(
        procedure() begin
          Lists.WriteM3u8(
            Path,
            [new Lists.Item('file:///media/first%0Asecond.mp3', 'Song')],
            true,
            T.CancellationToken.None
          );
        end procedure
      );
      X.Assert.Equal of string('#EXTM3U' + #10, IO.File.ReadAllText(Path));
      X.Assert.Equal of int(1, Folder.GetFiles().Length);
    finally
      Folder.Delete(true);
    end try;
  end procedure;

  // Relative, duplicate and remote entries survive reading without resolving media targets.
  [X.FactAttribute]
  public procedure PlaylistRoundTrip();
  begin
    const Folder: IO.DirectoryInfo := IO.Directory.CreateTempSubdirectory();
    try
      const Path: string := IO.Path.Combine(Folder.FullName, 'mix.m3u8');
      IO.File.WriteAllText(
        Path,
        '#EXTM3U' + #10 + '#EXTINF:-1,First' + #10 + 'missing.mp3' + #10 + 'missing.mp3' + #10 +
        'https://example.invalid/song.ogg' + #10
      );
      const Relative: string := IO.Path.GetRelativePath(Sys.Environment.CurrentDirectory, Path);
      const Items: array of Lists.Item := Lists.Read(Relative, T.CancellationToken.None);
      X.Assert.Equal of int(3, Items.Length);
      X.Assert.Equal of string('missing.mp3', Items[0].Location);
      X.Assert.Equal of string('First', Items[0].Title);
      X.Assert.Equal of string(Items[0].Location, Items[1].Location);
      X.Assert.Equal of string('https://example.invalid/song.ogg', Items[2].Location);
      const Output: string := IO.Path.Combine(Folder.FullName, 'other.m3u8');
      Lists.WriteM3u8(Output, [Items[2], Items[2]], false, T.CancellationToken.None);
      const Copy: array of Lists.Item := Lists.Read(Output, T.CancellationToken.None);
      X.Assert.Equal of int(2, Copy.Length);
      X.Assert.Equal of string(Items[2].Location, Copy[1].Location);
      discard X.Assert.Throws of IO.IOException(
        procedure() begin
          Lists.WriteM3u8(Output, [], false, T.CancellationToken.None);
        end procedure
      );
      X.Assert.Equal of int(2, Lists.Read(Output, T.CancellationToken.None).Length);
    finally
      Folder.Delete(true);
    end try;
  end procedure;

  // XML readers retain the supplied locations so that callers can resolve them.
  [X.FactAttribute]
  public procedure ReadXspfLocationsWithoutResolvingThem();
  begin
    const Temp: IO.DirectoryInfo := IO.Directory.CreateTempSubdirectory();
    try
      const Path: string := IO.Path.Combine(Temp.FullName, 'list.XSPF');
      X.Assert.True(Lists.IsPlaylist(Path));
      IO.File.WriteAllText(
        Path,
        '<playlist xmlns="http://xspf.org/ns/0/"><trackList>' +
        '<track><location>music/a%20b.ogg</location><title>Live &amp; loud</title></track>' +
        '<track><location>https://example.invalid/a%20b</location></track>' +
        '</trackList></playlist>'
      );
      const Items: array of Lists.Item := Lists.Read(Path, T.CancellationToken.None);
      X.Assert.Equal of int(2, Items.Length);
      X.Assert.Equal of string('music/a%20b.ogg', Items[0].Location);
      X.Assert.Equal of string('Live & loud', Items[0].Title);
      X.Assert.Equal of string('https://example.invalid/a%20b', Items[1].Location);
    finally
      Temp.Delete(true);
    end try;
  end procedure;

  // A leading hash in a relative filename must not turn the reference into a directive.
  [X.FactAttribute]
  public procedure ExportHashPrefixedReference();
  begin
    const Folder: IO.DirectoryInfo := IO.Directory.CreateTempSubdirectory();
    try
      const Path: string := IO.Path.Combine(Folder.FullName, 'mix.m3u8');
      const Song: string := IO.Path.Combine(Folder.FullName, '#song.mp3');
      Lists.WriteM3u8(
        Path,
        [new Lists.Item('#song.mp3', 'Song'), new Lists.Item(Song, 'Second title')],
        false,
        T.CancellationToken.None
      );
      const Items: array of Lists.Item := Lists.Read(Path, T.CancellationToken.None);
      X.Assert.Equal of int(2, Items.Length);
      X.Assert.Equal of string('./#song.mp3', Items[0].Location);
      X.Assert.Equal of string(Items[0].Location, Items[1].Location);
      X.Assert.Equal of string('Song', Items[0].Title);
      X.Assert.Equal of string('Second title', Items[1].Title);
    finally
      Folder.Delete(true);
    end try;
  end procedure;
end record;

end unit;
