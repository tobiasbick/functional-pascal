// [Documentation](../../doc/media/images.md)

unit FpasAmp.Media.Tests.Images;

uses FpasAmp.Media.Images as Images;
uses System as Sys;
uses System.IO as IO;
uses System.Threading as T;
uses Xunit as X;

// Exercises the JPEG codec through the public FPAS image library.
public type ImageTests = record
  // An eight-by-two source fits inside an eight-pixel square with transparent rows.
  [X.FactAttribute]
  public procedure FitWideJpeg();
  begin
    const Path: string := IO.Path.Combine(Sys.AppContext.BaseDirectory, 'Fixtures', 'wide.jpg');
    const Bitmap: Images.Bitmap := Images.CoverDecoder.Decode(
      IO.File.ReadAllBytes(Path), 8, T.CancellationToken.None
    );
    X.Assert.Equal of int(8, Bitmap.Width);
    X.Assert.Equal of int(8, Bitmap.Height);
    X.Assert.Equal of int(8 * 8 * 4, Bitmap.Pixels.Length);
    for Row: int := 0 to 7 do
      const Pixel: int := Row * 8 * 4;
      if Row = 3 or Row = 4 then
        X.Assert.Equal of byte(255, Bitmap.Pixels[Pixel + 3]);
        X.Assert.True(Bitmap.Pixels[Pixel] > Bitmap.Pixels[Pixel + 2]);
      else
        X.Assert.Equal of byte(0, Bitmap.Pixels[Pixel + 3]);
      end if;
    end for;
  end procedure;
end record;

end unit;
