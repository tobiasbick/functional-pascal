// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

// Opens an exact release through native input and returns to the scrolled album grid.
unit FpasAmp.UiTests.NativeAlbumMusic;

uses Fpas.Media.Audio as Media;
uses Fpas.Media.Tags.AudioFiles as MediaTags;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Mvu.Application as A;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Inputs.Selects as Selects;

uses ATL as Audio;
uses FpasAmp.Library.Inventory.Monitoring as Library;
uses FpasAmp.Library.Metadata.Model as Metadata;
uses FpasAmp.Library.Tests.AlbumSupport as Fixtures;
uses FpasAmp.Library.Tests.MetadataSupport as Sources;
uses FpasAmp.Library.Tests.Support as H;
uses FpasAmp.Persistence.PlayerState as Bookmark;
uses FpasAmp.Ui.Albums.Model as Albums;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Albums.Toolbar.Model as Toolbar;
uses FpasAmp.Ui.App.Controller as Controller;
uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Fingerprints as Fp;
uses FpasAmp.Ui.Navigation.Model as Nav;
uses FpasAmp.Ui.Player.Model as Player;
uses FpasAmp.Ui.Player.Playback as Playback;
uses FpasAmp.Ui.Settings.Model as Settings;
uses FpasAmp.Ui.Shell as Shell;
uses System as Sys;
uses System.IO as IO;
uses System.Threading as T;
uses Xunit as X;

function Control(Session: Gui.Session<App.Msg>; Id: string; Key: string := ''): Gui.Control;
begin
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Id = Id and Item.Key = Key then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing native control: ' + Id);
end function;

function Has(Session: Gui.Session<App.Msg>; Id: string): bool;
begin
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Id = Id then
      return true;
    end if;
  end for;

  return false;
end function;

procedure Step(Session: Gui.Session<App.Msg>);
begin
  discard Session.Post(App.Msg.Settings(Settings.Msg.DismissError));
  X.Assert.True(Session.Step());
end procedure;

procedure Until(Session: Gui.Session<App.Msg>; Ready: function(): bool; Failure: string);
begin
  const Deadline: long := Sys.Environment.TickCount64 + 15000L;
  while Sys.Environment.TickCount64 < Deadline do
    Step(Session);
    if Ready() then
      return;
    end if;

    T.Thread.Sleep(5);
  end while;

  X.Assert.True(false, Failure);
end procedure;

// Exercises real release identity, row rating and state restoration in the GUI.
public type AlbumMusicTests = record
  // Same-name releases stay separate; native scrolling, search, filters and sort survive Back.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure AlbumCardOpensItsTracksAndBackRestoresGrid();
    function TrackSortColumn(Current: App.State): int;
    begin
      const Selected: Music.State? := Current.Albums.Music;
      return if Selected <> null then
        Selected.Order.Column
      else
        -1
      end if;
    end function;
    procedure Inject();
    begin
      Window.MovePointer(XPos, YPos);
      if Left >= 0 then
        Window.SetLeftButton(Left = 1);
        Left := -1;
      end if;

      if Wheel <> 0.0F then
        Window.Wheel(Wheel);
        Wheel := 0.0F;
      end if;
    end procedure;
    function Apply(Current: App.State; Message: App.Msg): A.Transition<App.State, App.Msg>;
    begin
      const Next: A.Transition<App.State, App.Msg> := Controller.Apply(
        Current, Message, procedure(_Value: Settings.Preferences) begin end procedure, Store, Port
      );
      case Message of
        when App.Msg.Albums(Albums.Msg.Music(Music.Msg.ShowFolder(const Path: string))):
          // Observe the desktop request without opening a file manager on the user's desktop.
          FolderRequest := Path;
          return new A.Transition<App.State, App.Msg>(Next.Model, []);
        else
      end case;

      Last := Next.Model;
      return Next;
    end function;
    procedure Click(Session: Gui.Session<App.Msg>; Bounds: Cui.CuiRectangle; XFraction: float := 0.6F);
    begin
      XPos := Bounds.X + Bounds.Width * XFraction;
      YPos := Bounds.Y + Bounds.Height / 2.0F;
      Step(Session);
      Left := 1;
      Step(Session);
      Left := 0;
      Step(Session);
      Step(Session);
    end procedure;
    procedure Send(Session: Gui.Session<App.Msg>; Message: Albums.Msg);
    begin
      discard Session.Post(App.Msg.Albums(Message));
      Step(Session);
    end procedure;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    for Index: int := 1 to 20 do
      const Folder: string := IO.Path.Combine(Root.Path, Index.ToString('D2'));
      const Artist: string := 'Artist ' + Index.ToString('D2');
      const Intro: string := Fixtures.Track(Folder, 'Intro.mp3', 'Demo Release', Artist);
      if Index = 20 then
        // Keep Rock a meaningful filter once the entire scan has completed.
        const Other: Audio.Track := new Audio.Track(Intro);
        Other.Genre := 'Folk';
        X.Assert.True(Other.Save());
      end if;
      const Finale: Audio.Track := new Audio.Track(
        Fixtures.Track(Folder, 'Finale.mp3', 'Demo Release', Artist)
      );
      IO.File.WriteAllBytes(IO.Path.Combine(Folder, 'cover.png'), Fixtures.Picture(32, 96, 120));
      Finale.Genre := 'Pop';
      X.Assert.True(Finale.Save());
    end for;

    using const Device: Media.Session := new Media.Session(true);
    const Port: Playback.Connection := Playback.Connection.Create(Device);
    var Last: App.State := new App.State(
      new Settings.State(new Settings.Preferences([Sources.Source(Root.Path)], 'light')),
      Navigation := new Nav.State(Active := Nav.Route.Page(Nav.Page.Albums))
    );
    var FolderRequest: string := '';
    var XPos: float := -1.0F;
    var YPos: float := -1.0F;
    var Left: int := -1;
    var Wheel: float := 0.0F;
    using const Window: Cui.CuiWindow := new Cui.CuiWindow(
      'FPas-Amp album music', 1320, 820, Cui.CuiRenderer.Software, true
    );
    const Store: Library.Session := Sources.Start([Sources.Source(Root.Path)], Data.Path);
    try
      Window.SetReducedMotion(true);
      using const Session: Gui.Session<App.Msg> := Host.StartThemed<App.State, App.Msg>(
        Last, Apply, Shell.View, Window, 128, Inject, App.Theme(Last, null), App.Theme, false,
        OnCloseRequested := function(): App.Msg => App.Msg.Closing(Port.Stop(Last.Player))
      );
      discard Session.Post(App.Msg.WatchLibrary);
      Until(
        Session,
        function(): bool => Last.Albums.Items.Length = 20 and Last.Albums.Items[19].Tracks = 2L,
        'Album headers did not arrive.'
      );
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.Search('Demo Release')));
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.SetOpen(true)));
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.Genre('Rock')));
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.Apply));
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.Sort(Toolbar.Order.Artist)));
      const AlbumSearch: Cui.CuiRectangle := Control(Session, 'album-search').Bounds;
      const AlbumFilter: Cui.CuiRectangle := Control(Session, 'album-filters').Bounds;
      const AlbumSort: Cui.CuiRectangle := Control(Session, 'album-sort').Bounds;
      const Grid: Cui.CuiRectangle := Control(Session, 'album-grid/albums').Bounds;
      XPos := Grid.X + Grid.Width / 2.0F;
      YPos := Grid.Y + Grid.Height / 2.0F;
      Step(Session);
      Wheel := -14.0F;
      Until(
        Session,
        function(): bool => Last.Albums.Offsets.ContainsKey('albums'),
        'The album grid did not scroll.'
      );
      Step(Session);
      const Before: Albums.State := Last.Albums;
      var Candidate: Gui.Control? := null;
      for Item: Gui.Control in Session.Snapshot().Controls do
        if Item.Role = 'card' and Item.Id.StartsWith('album-') and Item.Bounds.Y >= Grid.Y
          and Item.Bounds.Y + Item.Bounds.Height / 2.0F < Grid.Y + Grid.Height
        then
          Candidate := Item;
          break;
        end if;
      end for;

      const Selected: Gui.Control? := Candidate;
      if Selected = null then
        raise new Sys.InvalidOperationException('No visible album card.');
      end if;

      const AlbumRating: Cui.CuiRectangle := Control(
        Session, 'album-rating-' + Selected.Id.Substring('album-'.Length)
      ).Bounds;
      Click(Session, Selected.Bounds);
      Until(
        Session, function(): bool begin
          const Page: Music.State? := Last.Albums.Music;
          if Page = null then
            return false;
          end if;

          return Page.Loaded and Page.Cover <> null;
        end function, 'Clicking the album did not open its music page.'
      );

      const Page: Music.State? := Last.Albums.Music;
      if Page = null then
        raise new Sys.InvalidOperationException('Missing music page.');
      end if;

      X.Assert.Equal<string>(Selected.Id, 'album-' + Page.Album.Id);
      X.Assert.Equal<int>(2, Page.Tracks.Length);
      const Track: Metadata.Entry := Page.Tracks[0];
      X.Assert.Equal<string>(
        Page.Album.Artist,
        (Track.Metadata ?? new MediaTags.Info()).Artists[0]
      );
      X.Assert.Contains<string>('Albums', Session.Snapshot().Text);
      X.Assert.Equal<string>('albums', Nav.SectionKey(Last.Navigation.Active));
      const TrackSearch: Cui.CuiRectangle := Control(Session, 'track-search').Bounds;
      const TrackFilter: Cui.CuiRectangle := Control(Session, 'track-filters').Bounds;
      const TrackSort: Cui.CuiRectangle := Control(Session, 'track-sort').Bounds;
      const Cover: Cui.CuiRectangle := Control(Session, 'track-album-cover').Bounds;
      X.Assert.Equal<float>(174.0F, Cover.Width);
      X.Assert.Equal<float>(Cover.Y, TrackSearch.Y);
      X.Assert.True(TrackSearch.X > Cover.X + Cover.Width);
      X.Assert.Equal<string>('Time', Control(Session, 'album-tracks/header/1').Text);
      X.Assert.Equal<string>('Rating', Control(Session, 'album-tracks/header/2').Text);
      X.Assert.Equal<float>(AlbumSearch.Height, TrackSearch.Height);
      X.Assert.Equal<float>(AlbumFilter.Height, TrackFilter.Height);
      X.Assert.Equal<float>(AlbumSort.Height, TrackSort.Height);
      X.Assert.Equal<float>(AlbumFilter.Y - AlbumSearch.Y, TrackFilter.Y - TrackSearch.Y);
      const Footer: Cui.CuiRectangle := Control(Session, 'track-status').Bounds;
      const Toggle: Gui.Control := Control(Session, 'player-toggle');
      X.Assert.False(Toggle.Enabled);
      X.Assert.True(Footer.Y + Footer.Height <= Toggle.Bounds.Y);
      X.Assert.True(Footer.X > Cover.X + Cover.Width and Footer.X < TrackSearch.X);
      const Id: string := Track.FileId.ToString();
      const TrackRating: Cui.CuiRectangle := Control(Session, 'track-rating-' + Id).Bounds;
      X.Assert.True(AlbumRating.Height > 0.0F);
      X.Assert.Equal<float>(AlbumRating.Height, TrackRating.Height);
      Click(Session, TrackRating, 0.95F);
      Until(
        Session, function(): bool begin
          const Details: Music.State? := Last.Albums.Music;
          return Details <> null and (Details.Tracks[0].Rating ?? 0) = 10;
        end function, 'The clicked track rating was not saved.'
      );
      Click(Session, Control(Session, 'album-tracks/header/2').Bounds);
      X.Assert.Equal<int>(4, TrackSortColumn(Last));
      Click(Session, Control(Session, 'album-tracks/header/1').Bounds);
      X.Assert.Equal<int>(3, TrackSortColumn(Last));
      Send(Session, Albums.Msg.Music(Music.Msg.Sort(new Tables.Sort(-1))));
      Click(Session, Control(Session, 'track-menu-' + Id).Bounds);
      Step(Session);
      Click(Session, Control(Session, 'track-menu-' + Id + '/details').Bounds);
      X.Assert.Contains<string>('Track details', Session.Snapshot().Text);
      X.Assert.Contains<string>('120 BPM', Session.Snapshot().Text);
      X.Assert.Contains<string>('Demo Release · 2024', Session.Snapshot().Text);
      X.Assert.True(
        Sys.Array.Exists<string>(
          Session.Snapshot().Text,
          function(Line: string): bool => Line.StartsWith('Disc 1 of 2 · Track 2 of 12')
        )
      );
      const CopyPath: Cui.CuiRectangle := Control(Session, 'track-copy-path').Bounds;
      const OpenPath: Cui.CuiRectangle := Control(Session, 'track-open-folder').Bounds;
      X.Assert.True(OpenPath.Width > 0.0F and CopyPath.X >= OpenPath.X + OpenPath.Width);
      Click(Session, OpenPath);
      X.Assert.Equal<string>(Track.Path, FolderRequest);
      const SaveAt: string? := Sys.Environment.GetEnvironmentVariable('FPAS_AMP_UI_ARTIFACTS');
      if SaveAt <> null then
        discard IO.Directory.CreateDirectory(SaveAt);
        Session.CapturePng(IO.Path.Combine(SaveAt, 'track-details-overview.png'));
      end if;

      Click(Session, Control(Session, 'track-detail-tabs', '1').Bounds);
      X.Assert.Contains<string>('Test label', Session.Snapshot().Text);
      X.Assert.DoesNotContain<string>('120 BPM', Session.Snapshot().Text);
      if SaveAt <> null then
        Session.CapturePng(IO.Path.Combine(SaveAt, 'track-details-credits.png'));
      end if;

      Click(Session, Control(Session, 'track-detail-tabs', '2').Bounds);
      X.Assert.Contains<string>('Stereo', Session.Snapshot().Text);
      X.Assert.Contains<string>('Sample rate', Session.Snapshot().Text);
      X.Assert.DoesNotContain<string>('Test label', Session.Snapshot().Text);
      if SaveAt <> null then
        Session.CapturePng(IO.Path.Combine(SaveAt, 'track-details-audio.png'));
      end if;

      Until(
        Session,
        function(): bool => Has(Session, 'track-generate-fingerprint'),
        'Missing fingerprint action.'
      );
      Click(Session, Control(Session, 'track-generate-fingerprint').Bounds);
      // The short MP3 fixture has too little audio for Chromaprint. The dialog offers a retry.
      Until(
        Session, function(): bool begin
          const Open: Music.State? := Last.Albums.Music;
          if Open = null then
            return false;
          end if;
          const Result: Fp.State? := Open.Fingerprint;
          return Result <> null and Result.Error <> null and Has(
            Session,
            'track-generate-fingerprint'
          );
        end function, 'The failed calculation did not release the generate action.'
      );
      Send(Session, Albums.Msg.Music(Music.Msg.DismissDetails));
      Send(Session, Albums.Msg.Music(Music.Msg.Search('Intro')));
      X.Assert.Equal<string>('0:1', Control(Session, 'album-tracks').Value);
      Send(Session, Albums.Msg.Music(Music.Msg.Search('Rock')));
      X.Assert.Equal<string>('0:1', Control(Session, 'album-tracks').Value);
      Send(Session, Albums.Msg.Music(Music.Msg.Search(Page.Album.Title)));
      X.Assert.Equal<string>('No matching tracks', Control(Session, 'tracks-empty').Text);
      Send(Session, Albums.Msg.Music(Music.Msg.Search(Page.Album.Artist)));
      X.Assert.Equal<string>('No matching tracks', Control(Session, 'tracks-empty').Text);
      Send(Session, Albums.Msg.Music(Music.Msg.Search('')));
      Click(Session, Control(Session, 'track-filters').Bounds);
      Click(Session, Control(Session, 'track-filter-genre').Bounds);
      const Genre: string := Selects.OptionId('track-filter-genre', 0);
      X.Assert.Equal<string>('Rock', Control(Session, Genre).Text);
      X.Assert.False(Has(Session, Selects.OptionId('track-filter-genre', 1)));
      Click(Session, Control(Session, Genre).Bounds);
      X.Assert.Equal<string>('Rock', Control(Session, 'track-filter-genre').Value);
      X.Assert.Equal<string>('0:2', Control(Session, 'album-tracks').Value);
      Click(Session, Control(Session, 'track-filter-genre').Bounds);
      Click(Session, Control(Session, 'track-filter-apply').Bounds);
      X.Assert.Equal<string>('0:1', Control(Session, 'album-tracks').Value);
      Click(Session, Control(Session, 'track-filters').Bounds);
      Click(Session, Control(Session, 'track-filter-reset').Bounds);
      Send(Session, Albums.Msg.Music(Music.Msg.Minimum(1)));
      Click(Session, Control(Session, 'track-filter-apply').Bounds);
      X.Assert.Equal<string>('0:1', Control(Session, 'album-tracks').Value);
      Click(Session, Control(Session, 'track-filters').Bounds);
      Click(Session, Control(Session, 'track-filter-reset').Bounds);
      Click(Session, Control(Session, 'track-filter-apply').Bounds);
      X.Assert.Equal<string>('0:2', Control(Session, 'album-tracks').Value);
      if SaveAt <> null then
        Session.CapturePng(IO.Path.Combine(SaveAt, 'album-music.png'));
        Click(Session, Control(Session, 'track-filters').Bounds);
        Session.CapturePng(IO.Path.Combine(SaveAt, 'album-music-filters.png'));
        Send(Session, Albums.Msg.Music(Music.Msg.ShowFilters(false)));
      end if;

      Click(Session, Control(Session, 'track-play-' + Id).Bounds, 0.5F);
      X.Assert.True(Last.Player.Playing);
      X.Assert.Equal<long>(Track.FileId, Last.Player.Queue[Last.Player.Index].FileId);
      X.Assert.Equal<string>(Page.Album.Id, Bookmark.Capture(Last.Player).Source.AlbumId);
      Click(Session, Control(Session, 'player-toggle').Bounds, 0.5F);
      X.Assert.False(Last.Player.Playing);
      const Wave: Cui.CuiRectangle := Control(Session, 'player-position').Bounds;
      Click(Session, Wave, 0.72F);
      X.Assert.InRange<double>(Last.Player.Position / Last.Player.Duration, 0.70, 0.74);
      const BeforeDrag: long := Last.Player.Revision;
      XPos := Wave.X + Wave.Width * 0.9F;
      Step(Session);
      Left := 1;
      Step(Session);
      XPos := Wave.X + Wave.Width * 0.5F;
      Step(Session);
      XPos := Wave.X + Wave.Width * 0.2F;
      Step(Session);
      X.Assert.Equal<long>(BeforeDrag, Last.Player.Revision);
      Left := 0;
      Step(Session);
      Step(Session);
      X.Assert.Equal<long>(BeforeDrag + 1L, Last.Player.Revision);
      X.Assert.InRange<double>(Last.Player.Position / Last.Player.Duration, 0.18, 0.22);
      const Volume: Cui.CuiRectangle := Control(Session, 'player-volume').Bounds;
      X.Assert.True(Volume.X + Volume.Width <= Control(Session, 'player-levels').Bounds.X);
      X.Assert.True(Volume.Y + Volume.Height <= Wave.Y);
      Click(Session, Volume, 0.5F);
      X.Assert.InRange<float>(Last.Player.Volume, -55.0F, -5.0F);
      const Selector: Gui.Control := Control(Session, 'player-eq-preset');
      const Reset: Cui.CuiRectangle := Control(Session, 'player-eq-reset').Bounds;
      X.Assert.Equal<float>(Reset.Height, Selector.Bounds.Height);
      X.Assert.True(Selector.Bounds.X + Selector.Bounds.Width <= Reset.X);
      Click(Session, Selector.Bounds);
      Click(Session, Control(Session, 'player-preset-1').Bounds);
      X.Assert.Equal<string>('Rock', Control(Session, 'player-eq-preset').Text);
      X.Assert.Equal<float>(4.0F, Last.Player.Gains[0]);
      Click(Session, Control(Session, 'player-eq-preset').Bounds);
      Click(Session, Control(Session, 'player-preset-0').Bounds);
      X.Assert.Equal<float>(0.0F, Last.Player.Gains[0]);
      if Last.Player.Index + 1 < Last.Player.Queue.Length then
        Click(Session, Control(Session, 'player-next').Bounds, 0.5F);
        X.Assert.Equal<int>(1, Last.Player.Index);
      end if;
      const Bass: Cui.CuiRectangle := Control(Session, 'player-eq-31').Bounds;
      XPos := Bass.X + Bass.Width / 2.0F;
      YPos := Bass.Y + 2.0F;
      Step(Session);
      Left := 1;
      Step(Session);
      Left := 0;
      Step(Session);
      X.Assert.True(Last.Player.Gains[0] > 6.0F, 'Dragging the 31 Hz fader did not boost it.');
      X.Assert.Equal<string>('Custom', Control(Session, 'player-eq-preset').Text);
      Click(Session, Control(Session, 'player-eq-reset').Bounds);
      X.Assert.Equal<string>('None', Control(Session, 'player-eq-preset').Text);
      if SaveAt <> null then
        Session.CapturePng(IO.Path.Combine(SaveAt, 'album-music-player.png'));
      end if;

      Window.Resize(620, 820);
      Until(
        Session, function(): bool => Session.Snapshot().Size.Width < 640.0F,
        'The window did not resize to the compact layout.'
      );
      const CompactSearch: Cui.CuiRectangle := Control(Session, 'track-search').Bounds;
      X.Assert.True(
        Control(Session, 'track-filters').Bounds.Y >= CompactSearch.Y + CompactSearch.Height
      );
      Click(Session, Control(Session, 'track-filters').Bounds);
      X.Assert.True(Control(Session, 'track-filter-apply').Bounds.Width > 0.0F);
      Send(Session, Albums.Msg.Music(Music.Msg.ShowFilters(false)));
      X.Assert.True(Has(Session, 'player-toggle'));
      X.Assert.False(Has(Session, 'player-eq-31'));
      Window.Resize(1320, 820);
      Until(
        Session, function(): bool => Session.Snapshot().Size.Width > 1000.0F,
        'The window did not return to the wide layout.'
      );

      // Let CUI expire the absent native viewport before using the back button.
      T.Thread.Sleep(5300);
      Step(Session);
      Click(Session, Control(Session, 'tracks-back').Bounds);
      X.Assert.Null(Last.Albums.Music);
      X.Assert.Equal<string>(Before.Toolbar.Search, Last.Albums.Toolbar.Search);
      X.Assert.Equal<string>(Before.Toolbar.Applied.Genre, Last.Albums.Toolbar.Applied.Genre);
      X.Assert.Equal<Toolbar.Order>(Before.Toolbar.Sort, Last.Albums.Toolbar.Sort);
      X.Assert.Equal<float>(Before.Offsets['albums'], Last.Albums.Offsets['albums']);
      const Returned: Cui.CuiRectangle := Control(Session, Selected.Id).Bounds;
      X.Assert.True(
        Sys.Math.Abs(Returned.Y - Selected.Bounds.Y) < 1.0F,
        'The native grid returned to a different offset.'
      );
      discard Session.Post(App.Msg.Player(Player.Msg.Seek(0.05F)));
      discard Session.Post(App.Msg.Player(Player.Msg.Toggle));
      Until(
        Session,
        function(): bool => Last.Player.Playing and Last.Player.Position > Last.Player.Duration *
          0.05 + 1.0,
        'Playback did not resume before closing.'
      );
      Window.RequestClose();
      while Session.Step() do
      end while;

      X.Assert.False(Last.Player.Playing);
      const Stopped: Media.PlaybackEvent? := Device.StopPlayback();
      X.Assert.True(Stopped is Media.PlaybackEvent);
      if Stopped is Media.PlaybackEvent then
        X.Assert.Equal<long>(Last.Player.Revision, Stopped.RequestId);
        X.Assert.Equal<double>(Stopped.Position.TotalMilliseconds, Last.Player.Position);
      end if;
      const Saved: Bookmark.Saved := Bookmark.Capture(Last.Player);
      const Restored: Player.State := Bookmark.Restore(
        Saved, Sources.Tags(Store).QueueAsync(
          Saved.Source.AlbumId, T.CancellationToken.None
        ).GetAwaiter().GetResult()
      );
      X.Assert.Equal<int>(2, Restored.Queue.Length);
      X.Assert.Equal<string>(Page.Album.Id, Saved.Source.AlbumId);
      X.Assert.Equal<long>(
        Last.Player.Queue[Last.Player.Index].FileId,
        Restored.Queue[Restored.Index].FileId
      );
      X.Assert.Equal<double>(Last.Player.Position, Restored.Position);
      X.Assert.False(Restored.Playing);
    finally
      Store.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;
end record;

end unit;
