// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

unit FpasAmp.UiTests.NativeTrackRating;

uses Fpas.Media.Audio as Audio;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Mvu.Testing.EffectReplies as Effects;

uses FpasAmp.Library.Inventory.Monitoring as Inventory;
uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Library.Metadata.Monitoring as Metadata;
uses FpasAmp.Library.Tests.MetadataSupport as Sources;
uses FpasAmp.Library.Tests.Support as H;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.App.Controller as Controller;
uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Music.LibraryPage as Page;
uses FpasAmp.Ui.Player.Playback as Playback;
uses FpasAmp.Ui.Settings.Model as Settings;
uses FpasAmp.Ui.Shell as Shell;
uses System as Sys;
uses System.Collections.Immutable as I;
uses System.Threading as T;
uses System.Threading.Channels as Channels;
uses Xunit as X;

function Stars(Session: Gui.Session of App.Msg; Song: Tracks.Entry): Gui.Control;
begin
  const Id: string := 'track-rating-' + Song.FileId.ToString();
  for Control: Gui.Control in Session.Snapshot().Controls do
    if Control.Id = Id then
      return Control;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing visible stars for ' + Id);
end function;

function CatalogueRating(Message: App.Msg; Id: string): int?;
begin
  case Message of
    when App.Msg.Songs(Page.Msg.Received(_, _, const Catalogue: Page.Catalogue)):
      for Item: Tracks.Entry in Catalogue.Tracks do
        if Item.TrackId = Id then
          return Item.Rating;
        end if;
      end for;
    else
      raise new Sys.InvalidOperationException('Expected a catalogue from the observer.');
  end case;

  return null;
end function;

procedure Exercise(Store: Inventory.Session; Root: string);
  procedure Frame(Session: Gui.Session of App.Msg);
  begin
    discard Window.TryWake();
    X.Assert.True(Session.Step());
  end procedure;
  procedure Send(Session: Gui.Session of App.Msg; Message: App.Msg);
  begin
    discard Session.Post(Message);
    Frame(Session);
  end procedure;
  procedure Deliver(Session: Gui.Session of App.Msg; Reply: Effects.Reply of App.Msg);
  begin
    Reply.Release().WaitAsync(Deadline.Token).GetAwaiter().GetResult();
    Frame(Session);
  end procedure;
  function NextRead(): Effects.Reply of App.Msg;
  begin
    return Reads.ReadAsync(Deadline.Token).AsTask().GetAwaiter().GetResult();
  end function;
  procedure Inject();
  begin
    Window.MovePointer(XPos, YPos);
    if Button >= 0 then
      Window.SetLeftButton(Button = 1);
      Button := -1;
    end if;
  end procedure;
begin
  const Library: Metadata.Session := Sources.Tags(Store);
  const Items: I.ImmutableArray of Tracks.Entry := Sources.Until(
    Library,
    function(Rows: I.ImmutableArray of Tracks.Entry): bool => Rows.Length = 2 and Rows[
      0
    ].TrackId <> '' and Rows[1].TrackId <> ''
  ).GetAwaiter().GetResult();
  const Song: Tracks.Entry := Items[0];
  const Other: Tracks.Entry := Items[1];
  using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(20000);
  Library.SetRatingAsync(Song.TrackId, 3, Deadline.Token).GetAwaiter().GetResult();
  Library.SetRatingAsync(Other.TrackId, 4, Deadline.Token).GetAwaiter().GetResult();

  const Gate: Effects.Effects of App.Msg := (Effects.Effects of App.Msg).Create();
  const Reads: Channels.ChannelReader of Effects.Reply of App.Msg := Gate.Watch('songs/observe');
  const Saves: Channels.ChannelReader of Effects.Reply of App.Msg := Gate.Watch(
    'songs/song/rate/' + Song.TrackId
  );
  using const Device: Audio.Session := new Audio.Session(true);
  const Port: Playback.Connection := Playback.Connection.Create(Device);
  var Current: App.State := new App.State(
    new Settings.State(new Settings.Preferences([Sources.Source(Root)], 'light'))
  );
  var XPos: float := -1.0F;
  var YPos: float := -1.0F;
  var Button: int := -1;
  using const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Track rating',
    1440,
    900,
    Cui.CuiRenderer.Software,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of App.Msg := Host.StartThemed of (App.State, App.Msg)(
    Current,
    function(State: App.State; Message: App.Msg): Mvu.Transition of (App.State, App.Msg) begin
      const Next: Mvu.Transition of (App.State, App.Msg) := Controller.Apply(
        State, Message,
        procedure(_Value: Settings.Preferences) begin end procedure, Store, Port
      );
      Current := Next.Model;
      return Gate.Wrap of App.State(Next);
    end function, Shell.View, Window, 128, Inject, App.Theme(Current, null), App.Theme, false
  );

  Send(Session, App.Msg.WatchLibrary);
  Deliver(Session, NextRead());
  Send(Session, App.Msg.Songs(Page.Msg.Song(Music.Msg.Minimum(2))));
  Send(Session, App.Msg.Songs(Page.Msg.Song(Music.Msg.ApplyFilters)));
  X.Assert.Equal of string('3', Stars(Session, Song).Value);
  X.Assert.Equal of string('4', Stars(Session, Other).Value);

  // A second track changes so the drawn frame proves which read actually arrived.
  Library.SetRatingAsync(Other.TrackId, 6, Deadline.Token).GetAwaiter().GetResult();
  var Older: Effects.Reply of App.Msg := NextRead();
  while CatalogueRating(Older.Message, Other.TrackId) <> 6 do
    Deliver(Session, Older);
    X.Assert.Equal of string('3', Stars(Session, Song).Value);
    Older := NextRead();
  end while;

  X.Assert.Equal of int? (3, CatalogueRating(Older.Message, Song.TrackId));
  Send(Session, App.Msg.Songs(Page.Msg.Song(Music.Msg.Play(Current.Songs.Page.Shown[0].FileId))));
  X.Assert.True(Current.Player.Playing);
  const Bounds: Cui.CuiRectangle := Stars(Session, Song).Bounds;
  XPos := Bounds.X + Bounds.Width * 0.75F;
  YPos := Bounds.Y + Bounds.Height * 0.5F;
  Frame(Session);
  Button := 1;
  Frame(Session);
  Button := 0;
  Frame(Session);
  Frame(Session);
  X.Assert.Equal of string('8', Stars(Session, Song).Value);
  X.Assert.False(Stars(Session, Song).Enabled);

  const Saved: Effects.Reply of App.Msg := Saves.ReadAsync(
    Deadline.Token
  ).AsTask().GetAwaiter().GetResult();
  Deliver(Session, Saved);
  X.Assert.Equal of string('8', Stars(Session, Song).Value);
  X.Assert.True(Stars(Session, Song).Enabled);
  X.Assert.Equal of string('4', Stars(Session, Other).Value);

  Deliver(Session, Older);
  X.Assert.Equal of string('8', Stars(Session, Song).Value);
  X.Assert.Equal of string('6', Stars(Session, Other).Value);

  const Fresh: Effects.Reply of App.Msg := NextRead();
  X.Assert.Equal of int? (8, CatalogueRating(Fresh.Message, Song.TrackId));
  Deliver(Session, Fresh);
  X.Assert.Equal of string('8', Stars(Session, Song).Value);
end procedure;

// Native frame regression for a filtered library being refreshed during playback.
public type NativeTrackRatingTests = record
  // A rating click, its save receipt and a delayed catalogue each get their own frame.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure StarsStayAtEight();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    discard Sources.Write(Root.Path, 'first.mp3', 'First');
    discard Sources.Write(Root.Path, 'second.ogg', 'Second');
    const Store: Inventory.Session := Sources.Start([Sources.Source(Root.Path)], Data.Path);
    try
      Exercise(Store, Root.Path);
    finally
      Store.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;
end record;

end unit;
