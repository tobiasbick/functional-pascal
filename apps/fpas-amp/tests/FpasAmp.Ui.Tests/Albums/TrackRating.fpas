// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

unit FpasAmp.UiTests.TrackRating;

uses FpasAmp.Library.Albums.Model as Albums;
uses FpasAmp.Library.Inventory.Monitoring as Monitor;
uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Library.Metadata.Monitoring as Metadata;
uses FpasAmp.Library.Tests.MetadataSupport as Sources;
uses FpasAmp.Library.Tests.Support as H;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Albums.Music.Update as Edit;
uses FpasAmp.Ui.Music.LibraryPage as Page;
uses System.Collections.Immutable as I;
uses Xunit as X;

function Catalogue(Rating: int): Page.Catalogue;
begin
  const Song: Tracks.Entry := new Tracks.Entry(1L, 'song', 'song.mp3', '', Rating, null, null);
  return new Page.Catalogue(
    I.ImmutableArray.Create of Tracks.Entry(Song),
    I.ImmutableDictionary of (string, Albums.Album).Empty, [], [], [], []
  );
end function;

function VisibleRating(Current: Music.State): int;
begin
  for Item: Tracks.Entry in Current.Shown do
    if Item.TrackId = 'song' then
      return Item.Rating ?? 0;
    end if;
  end for;

  return -1;
end function;

// Exercises the visible table at each owner-thread update while a library read overlaps a rating write.
public type TrackRatingTests = record
  // Clearing a rating removes the stars and hides the row under a positive Minimum.
  // Expected is the displayed value, or -1 for a filtered-out track.
  [X.TheoryAttribute]
  [X.InlineDataAttribute(2, -1)]
  [X.InlineDataAttribute(0, 0)]
  public procedure ClearingAcrossRefresh(Minimum: int; Expected: int);
  begin
    using const Data: H.Folder := H.Folder.Create();
    const Inventory: Monitor.Session := Sources.Start([], Data.Path);
    try
      const Library: Metadata.Session := Sources.Tags(Inventory);
      const Initial: Page.Catalogue := Catalogue(3);
      var Current: Page.State := Page.Apply(
        new Page.State(),
        Page.Msg.Received(0L, 1L, Initial),
        Library
      ).Model;
      Current := Page.Apply(Current, Page.Msg.Song(Music.Msg.Minimum(Minimum)), Library).Model;
      Current := Page.Apply(Current, Page.Msg.Song(Music.Msg.ApplyFilters), Library).Model;
      X.Assert.Equal of int(3, VisibleRating(Current.Page));
      Current := Page.Apply(
        Current,
        Page.Msg.Song(Music.Msg.Rate('song', 0)),
        Library
      ).Model;
      const Clicked: int := VisibleRating(Current.Page);
      Current := Page.Apply(Current, Page.Msg.Received(0L, 2L, Initial), Library).Model;
      const Pending: int := VisibleRating(Current.Page);
      Current := Page.Apply(
        Current,
        Page.Msg.Song(Music.Msg.Rated(0L, 'song', null, 4L)),
        Library
      ).Model;
      const Saved: int := VisibleRating(Current.Page);
      // A scan can publish new files even if it read the old stars before the commit.
      const Scanned: Page.Catalogue := Initial with
        Tracks := Initial.Tracks.Add(
          new Tracks.Entry(2L, 'other', 'other.mp3', '', null, null, null)
        );
      end with;
      Current := Page.Apply(Current, Page.Msg.Received(0L, 3L, Scanned), Library).Model;
      X.Assert.Equal of int(2, Current.Page.Tracks.Length);
      const Actual: array of int := [Clicked, Pending, Saved, VisibleRating(Current.Page)];
      const Wanted: array of int := [Expected, Expected, Expected, Expected];
      X.Assert.Equal of int(Wanted, Actual);
      Current := Page.Apply(Current, Page.Msg.Received(0L, 5L, Catalogue(7)), Library).Model;
      X.Assert.Equal of int(7, VisibleRating(Current.Page));
    finally
      Inventory.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;

  // A failed second edit restores the last saved rating even when the album reloads.
  [X.FactAttribute]
  public procedure FailedSecondEdit();
  begin
    using const Data: H.Folder := H.Folder.Create();
    const Inventory: Monitor.Session := Sources.Start([], Data.Path);
    try
      const Library: Metadata.Session := Sources.Tags(Inventory);
      var Current: Music.State := new Music.State(
        new Albums.Album('album', 'Album', '', 1L, ''),
        0L
      );
      const Items: I.ImmutableArray of Tracks.Entry := Catalogue(3).Tracks;
      Current := Edit.Apply(Current, Music.Msg.Loaded(0L, 1L, Items), Library).Model;
      Current := Edit.Apply(Current, Music.Msg.Rate('song', 8), Library).Model;
      Current := Edit.Apply(Current, Music.Msg.Rated(0L, 'song', 8, 3L), Library).Model;
      Current := Edit.Apply(Current, Music.Msg.Rate('song', 5), Library).Model;
      Current := Edit.Apply(Current, Music.Msg.Loaded(0L, 2L, Items), Library).Model;
      X.Assert.Equal of int(5, VisibleRating(Current));
      Current := Edit.Apply(
        Current,
        Music.Msg.RatingFailed(0L, 'song', 'Write failed'),
        Library
      ).Model;
      X.Assert.Equal of int(8, VisibleRating(Current));
      X.Assert.Equal of string? ('Write failed', Current.Error);
      Current := Edit.Apply(Current, Music.Msg.Rate('song', 6), Library).Model;
      X.Assert.Equal of int(6, VisibleRating(Current));
      Current := Edit.Apply(Current, Music.Msg.Loaded(0L, 6L, Catalogue(9).Tracks), Library).Model;
      Current := Edit.Apply(Current, Music.Msg.Rated(0L, 'song', 6, 5L), Library).Model;
      X.Assert.Equal of int(9, VisibleRating(Current));
    finally
      Inventory.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;
end record;

end unit;
