// [Documentation](../../doc/podcasts.md#verification)

unit FpasAmp.Ui.Tests.NativePodcasts;

uses
  FpasAmp.Ui.Tests.ProviderHttp as Http, FpasAmp.Ui.Tests.PlaybackFixture as Tone,
  FpasAmp.Library.Tests.AlbumSupport as Art, FpasAmp.Library.Tests.Support as H,
  FpasAmp.Library.Tests.MetadataSupport as LibraryFixture, FpasAmp.Library.Inventory.Monitoring as Library,
  FpasAmp.Library.Metadata.Model as Tracks, System.Collections.Immutable as I,
  FpasAmp.Ui.App.Model as App, FpasAmp.Ui.App.Controller as Controller, FpasAmp.Ui.Shell as Shell,
  FpasAmp.Ui.App.Podcasts as Podcasts,
  FpasAmp.Ui.Navigation.Model as Nav, FpasAmp.Ui.Podcasts.Model as P,
  FpasAmp.Ui.Podcasts.Browse as Browse,
  FpasAmp.Ui.Podcasts.Update as Update,
  FpasAmp.Ui.Settings.Model as Settings, FpasAmp.Settings as Saved, FpasAmp.AppState as WindowState,
  Fpas.Ui.Widgets.Inputs.Selects as Select, Fpas.Ui.Widgets.Collections.Tables as Tables,
  FpasAmp.Ui.Player.Model as Player, FpasAmp.Ui.Player.Playback as Playback,
  Fpas.Media.Audio as Audio, Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.Hosting.Session as Host, Fpas.Ui.Mvu.Application as A,
  Fpas.Ui.Mvu.Testing.EffectReplies as Effects, System as Sys, System.IO as IO,
  System.Net as N, System.Net.Sockets as Sockets, System.Threading as T,
  System.Threading.Channels as Channels, System.Threading.Tasks as Tasks, Xunit as X;

const Feed: string := '<rss version="2.0" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"><channel>
  <title>Coastlines</title><itunes:author>North Pier Studio</itunes:author><itunes:image href="cover.png" />
  <item><title>Low Tide</title><guid>old</guid><pubDate>Wed, 14 Feb 2024 12:00:00 GMT</pubDate>
  <enclosure url="old.wav" type="audio/wav" /></item>
  <item><title>The Night Ferry</title><guid>night</guid><pubDate>Fri, 14 Mar 2025 12:00:00 GMT</pubDate>
  <itunes:duration>0:05</itunes:duration><description><![CDATA[<p>A night crossing.</p>]]></description>
  <enclosure url="night.wav" type="audio/wav" /></item>
  <item><title>Trailer video</title><enclosure url="trailer.mp4" type="video/mp4" /></item>
  <item><title>Duplicate</title><guid>night</guid><enclosure url="duplicate.wav" type="audio/wav" /></item>
  </channel></rss>';

function Control(Window: Gui.Session<App.Msg>; Id: string; Key: string := ''): Gui.Control;
begin
  for Entry: Gui.Control in Window.Snapshot().Controls do
    if Entry.Id = Id and Entry.Key = Key then
      return Entry;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing podcast control: ' + Id + ' ' + Key);
end function;

procedure Step(Window: Gui.Session<App.Msg>);
begin
  discard Window.Post(App.Msg.Settings(Settings.Msg.DismissError));
  X.Assert.True(Window.Step());
end procedure;

procedure Send(Window: Gui.Session<App.Msg>; Message: App.Msg);
begin
  discard Window.Post(Message);
  Step(Window);
end procedure;

procedure Deliver(Window: Gui.Session<App.Msg>; Held: Channels.ChannelReader<Effects.Reply<App.Msg>>);
begin
  using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(10000);
  const Reply: Effects.Reply<App.Msg> := Held.ReadAsync(
    Deadline.Token
  ).AsTask().GetAwaiter().GetResult();
  Reply.Release().WaitAsync(Deadline.Token).GetAwaiter().GetResult();
  Step(Window);
end procedure;

procedure Wait(Window: Gui.Session<App.Msg>; Ready: function(): bool; Message: string);
begin
  const Limit: long := Sys.Environment.TickCount64 + 8000L;
  while not Ready() and Sys.Environment.TickCount64 < Limit do
    Step(Window);
    T.Thread.Sleep(5);
  end while;

  X.Assert.True(Ready(), Message);
end procedure;

procedure SaveImage(Window: Gui.Session<App.Msg>; File: string);
begin
  const Directory: string? := Sys.Environment.GetEnvironmentVariable('FPAS_AMP_UI_ARTIFACTS');
  if Directory <> null then
    discard IO.Directory.CreateDirectory(Directory);
    Window.CapturePng(IO.Path.Combine(Directory, File));
  end if;
end procedure;

procedure Exercise(Store: Library.Session; Data: string; Show: P.Show);
  procedure Click(Window: Gui.Session<App.Msg>; Bounds: Cui.CuiRectangle);
  begin
    PointerX := Bounds.X + Bounds.Width * 0.5F;
    PointerY := Bounds.Y + Bounds.Height * 0.5F;
    Step(Window);
    Button := 1;
    Step(Window);
    Button := 0;
    Step(Window);
    Step(Window);
  end procedure;
begin
  const Device: Audio.Session := new Audio.Session(true);
  const Port: Playback.Connection := new Playback.Connection(Device);
  const Gate: Effects.Effects<App.Msg> := Effects.Effects<App.Msg>.Create();
  const Route: Nav.Route := Nav.Route.Podcast(Show.Id());
  const Other: P.Show := new P.Show(
    'https://example.invalid/other.rss',
    'Other podcast',
    Genres := ['1310']
  );
  var Current: App.State := new App.State(
    new Settings.State(new Settings.Preferences([], 'light', 'blue')),
    Navigation := new Nav.State(Active := Nav.Route.Page(Nav.Page.Podcasts)),
    Podcasts := new P.State(Market := 'DE')
  );
  var PointerX: float := -1.0F;
  var PointerY: float := -1.0F;
  var Button: int := -1;
  try
    const Native: Cui.CuiWindow := new Cui.CuiWindow(
      'FPas-Amp Podcasts',
      1440,
      900,
      Cui.CuiRenderer.Software,
      true
    );
    Native.SetReducedMotion(true);
    using const Window: Gui.Session<App.Msg> := Host.StartThemed<App.State, App.Msg>(
      Current,
      function(Model: App.State; Message: App.Msg): A.Transition<App.State, App.Msg> begin
        const Next: A.Transition<App.State, App.Msg> := Controller.Apply(
          Model, Message,
          procedure(Value: Settings.Preferences) begin
            Saved.Save(Data, Value);
          end procedure, Store, Port
        );
        Current := Next.Model;
        for Index: int := 0 to Next.Commands.Length - 1 do
          case Next.Commands[Index] of
            when A.Command.Start(const Id: string, _):
              if Id = 'podcasts/search' then
                const Revision: long := Current.Podcasts.SearchRevision;
                const Matches: array of P.Show := if Current.Podcasts.Searched() then
                  [Show, Other]
                else
                  [
                    Show with
                      Title := 'Chart ' + Current.Podcasts.Market + ' ' +
                        (if Current.Podcasts.Genre = '' then
                          'all'
                        else
                          Current.Podcasts.Genre
                        end if);
                    end with
                  ]
                end if;
                // Only the external Apple response is simulated. RSS and audio use HTTP below.
                Next.Commands[Index] := A.StartBackground<App.Msg>(
                  Id,
                  A.FromWorker<App.Msg>(
                    function(Post: function(App.Msg): Tasks.Task; _Stop: T.CancellationToken): Tasks.Task => Post(
                      App.Msg.Podcasts(P.Msg.Found(Revision, Matches))
                    ),
                    function(Error: Sys.Exception): App.Msg => App.Msg.Podcasts(
                      P.Msg.SearchFailed(Revision, Error.Message)
                    )
                  )
                );
              end if;
            else
          end case;
        end for;

        return Gate.Wrap<App.State>(Next);
      end function,
      Shell.View, Native, 128, procedure() begin
        Native.MovePointer(PointerX, PointerY);
        if Button >= 0 then
          Native.SetLeftButton(Button = 1);
          Button := -1;
        end if;
      end procedure, App.Theme(Current, null), App.Theme, false
    );
    const Charts: Channels.ChannelReader<Effects.Reply<App.Msg>> := Gate.Watch('podcasts/search');
    Send(Window, App.Msg.WatchLibrary);
    X.Assert.Equal<string>('Loading top podcasts…', Control(Window, 'podcasts-empty').Text);
    Deliver(Window, Charts);
    const ShowButton: string := 'podcast-open-' + Show.Id();
    X.Assert.Equal<string>('Chart DE all', Control(Window, ShowButton).Text);
    X.Assert.Equal<string>('', Control(Window, 'podcast-search-input').Value);
    const Market: Channels.ChannelReader<Effects.Reply<App.Msg>> := Gate.Watch('podcasts/search');
    Click(Window, Control(Window, 'podcast-filters').Bounds);
    Send(Window, App.Msg.Podcasts(P.Msg.Market('US')));
    X.Assert.Equal<string>('Chart DE all', Control(Window, ShowButton).Text);
    Click(Window, Control(Window, 'podcast-filter-apply').Bounds);
    X.Assert.Equal<string>('Loading top podcasts…', Control(Window, 'podcasts-empty').Text);
    Deliver(Window, Market);
    X.Assert.Equal<string>('Chart US all', Control(Window, ShowButton).Text);
    const Genre: Channels.ChannelReader<Effects.Reply<App.Msg>> := Gate.Watch('podcasts/search');
    Click(Window, Control(Window, 'podcast-filters').Bounds);
    Click(Window, Control(Window, 'podcast-genre').Bounds);
    Click(Window, Control(Window, Select.OptionId('podcast-genre', 1)).Bounds);
    X.Assert.Equal<string>('', Current.Podcasts.Genre);
    Click(Window, Control(Window, 'podcast-filter-apply').Bounds);
    X.Assert.Equal<string>('Loading top podcasts…', Control(Window, 'podcasts-empty').Text);
    Deliver(Window, Genre);
    X.Assert.Equal<string>('Chart US 1301', Control(Window, ShowButton).Text);
    const Search: Channels.ChannelReader<Effects.Reply<App.Msg>> := Gate.Watch('podcasts/search');
    Send(Window, App.Msg.Podcasts(P.Msg.Query('coast')));
    Click(Window, Control(Window, 'podcast-search-submit').Bounds);
    X.Assert.False(Control(Window, 'podcast-search-submit').Enabled);
    X.Assert.Equal<string>('Searching Apple Podcasts…', Control(Window, 'podcasts-empty').Text);
    Deliver(Window, Search);
    X.Assert.Equal<string>('Coastlines', Control(Window, ShowButton).Text);
    X.Assert.DoesNotContain<string>('Other podcast', Window.Snapshot().Text);
    Click(Window, Control(Window, 'podcast-filters').Bounds);
    Send(Window, App.Msg.Podcasts(P.Msg.Genre('')));
    Click(Window, Control(Window, 'podcast-filter-apply').Bounds);
    const OtherButton: string := 'podcast-open-' + Other.Id();
    X.Assert.Equal<string>('Other podcast', Control(Window, OtherButton).Text);
    Send(Window, App.Msg.Podcasts(P.Msg.Subscribe(Other, true)));
    Click(Window, Control(Window, 'podcast-filters').Bounds);
    Click(Window, Control(Window, 'podcast-subscription-filter').Bounds);
    Click(Window, Control(Window, Select.OptionId('podcast-subscription-filter', 2)).Bounds);
    Click(Window, Control(Window, 'podcast-filter-apply').Bounds);
    X.Assert.Equal<int>(1, Current.Podcasts.ShownResults.Length);
    X.Assert.Equal<string>(Show.Url, Current.Podcasts.ShownResults[0].Url);
    Send(Window, App.Msg.Podcasts(P.Msg.Subscribe(Other, false)));
    X.Assert.Equal<string>('Other podcast', Control(Window, OtherButton).Text);
    Click(Window, Control(Window, 'podcast-filters').Bounds);
    Click(Window, Control(Window, 'podcast-subscription-filter').Bounds);
    Click(Window, Control(Window, Select.OptionId('podcast-subscription-filter', 0)).Bounds);
    Click(Window, Control(Window, 'podcast-filter-apply').Bounds);
    const Publisher: Cui.CuiRectangle := Control(
      Window,
      Tables.HeaderId('podcast-results', 1)
    ).Bounds;
    Click(Window, Publisher);
    X.Assert.Equal<Tables.Sort>(new Tables.Sort(1), Current.Podcasts.SearchOrder);
    X.Assert.True(Control(Window, OtherButton).Bounds.Y < Control(Window, ShowButton).Bounds.Y);
    Click(Window, Publisher);
    X.Assert.Equal<Tables.Sort>(new Tables.Sort(1, true), Current.Podcasts.SearchOrder);
    X.Assert.True(Control(Window, ShowButton).Bounds.Y < Control(Window, OtherButton).Bounds.Y);
    X.Assert.Equal<string>('Publisher · Z–A', Control(Window, 'podcast-sort').Text);
    Click(Window, Control(Window, 'podcast-sort').Bounds);
    Click(Window, Control(Window, 'podcast-sort/default').Bounds);
    X.Assert.Equal<Tables.Sort>(new Tables.Sort(-1), Current.Podcasts.SearchOrder);
    Click(Window, Control(Window, 'podcast-filters').Bounds);
    Send(Window, App.Msg.Podcasts(P.Msg.Genre('1301')));
    Click(Window, Control(Window, 'podcast-filter-apply').Bounds);
    X.Assert.DoesNotContain<string>('Other podcast', Window.Snapshot().Text);
    SaveImage(Window, 'podcast-search.png');

    const Open: Channels.ChannelReader<Effects.Reply<App.Msg>> := Gate.Watch('podcasts/feed');
    Click(Window, Control(Window, ShowButton).Bounds);
    X.Assert.Equal<Nav.Route>(Route, Current.Navigation.Active);
    X.Assert.Equal<string>('Loading episodes…', Control(Window, 'podcast-episodes-empty').Text);
    Deliver(Window, Open);
    X.Assert.Equal<int>(2, Current.Podcasts.Episodes.Length);
    X.Assert.Equal<string>('North Pier Studio', (Current.Podcasts.Show ?? Show).Publisher);
    X.Assert.Contains<string>('The Night Ferry', Window.Snapshot().Text);
    const Night: P.Episode := Current.Podcasts.Episodes[1];
    X.Assert.Equal<double>(5000.0, Night.Duration);
    X.Assert.Equal<string>('A night crossing.', Night.Description);
    Deliver(Window, Open);
    discard Control(Window, 'podcast-cover');
    Click(Window, Control(Window, 'episode-filters').Bounds);
    Click(Window, Control(Window, 'episode-filter-year').Bounds);
    Click(Window, Control(Window, Select.OptionId('episode-filter-year', 1)).Bounds);
    X.Assert.Equal<int>(2, Current.Podcasts.ShownEpisodes.Length);
    Click(Window, Control(Window, 'episode-filter-apply').Bounds);
    X.Assert.Equal<int>(1, Current.Podcasts.ShownEpisodes.Length);
    X.Assert.Equal<string>('night', Current.Podcasts.ShownEpisodes[0].Id);
    Click(Window, Control(Window, 'episode-filters').Bounds);
    Click(Window, Control(Window, 'episode-filter-reset').Bounds);
    Click(Window, Control(Window, 'episode-filter-duration').Bounds);
    Click(Window, Control(Window, Select.OptionId('episode-filter-duration', 4)).Bounds);
    Click(Window, Control(Window, 'episode-filter-apply').Bounds);
    X.Assert.Equal<int>(1, Current.Podcasts.ShownEpisodes.Length);
    X.Assert.Equal<string>('old', Current.Podcasts.ShownEpisodes[0].Id);
    Click(Window, Control(Window, 'episode-filters').Bounds);
    Click(Window, Control(Window, 'episode-filter-reset').Bounds);
    Click(Window, Control(Window, 'episode-filter-apply').Bounds);
    X.Assert.Equal<int>(2, Current.Podcasts.ShownEpisodes.Length);
    const Episodes: string := 'podcast-episodes/' + Show.Id();
    const Published: Cui.CuiRectangle := Control(Window, Tables.HeaderId(Episodes, 1)).Bounds;
    Send(Window, App.Msg.Podcasts(P.Msg.SelectEpisode(0)));
    Click(Window, Published);
    X.Assert.Equal<string>('old', Current.Podcasts.ShownEpisodes[0].Id);
    X.Assert.Equal<string>('Published · Oldest first', Control(Window, 'episode-sort').Text);
    X.Assert.Equal<string>(
      'night',
      Current.Podcasts.ShownEpisodes[Current.Podcasts.EpisodeCursor].Id
    );
    X.Assert.True(
      Control(Window, 'episode-play-old').Bounds.Y < Control(Window, 'episode-play-night').Bounds.Y
    );
    case Podcasts.Play(Current, Night) of
      when Player.Msg.PlayEpisodes(
        const Queue: I.ImmutableArray<Tracks.Entry>,
        const Index: int,
        _
      ):
        X.Assert.True(Queue[0].TrackId.EndsWith(':old'));
        X.Assert.Equal<int>(1, Index);
      else
        X.Assert.True(false, 'Playback must use the sorted episode row order.');
    end case;

    Click(Window, Control(Window, Tables.HeaderId(Episodes, 2)).Bounds);
    X.Assert.Equal<string>('night', Current.Podcasts.ShownEpisodes[0].Id);
    Click(Window, Control(Window, Tables.HeaderId(Episodes, 0)).Bounds);
    X.Assert.Equal<string>('old', Current.Podcasts.ShownEpisodes[0].Id);
    Click(Window, Control(Window, 'episode-sort').Bounds);
    Click(Window, Control(Window, 'episode-sort/1').Bounds);
    Click(Window, Control(Window, 'episode-sort').Bounds);
    Click(Window, Control(Window, 'episode-sort/descending').Bounds);
    X.Assert.Equal<Tables.Sort>(new Tables.Sort(1, true), Current.Podcasts.EpisodeOrder);
    X.Assert.Equal<string>('night', Current.Podcasts.ShownEpisodes[0].Id);
    Click(Window, Control(Window, 'episode-menu-night').Bounds);
    Click(Window, Control(Window, 'episode-menu-night/details').Bounds);
    X.Assert.Contains<string>('A night crossing.', Window.Snapshot().Text);
    Send(Window, App.Msg.Podcasts(P.Msg.Details(null)));
    Click(Window, Control(Window, 'podcast-subscription').Bounds);
    X.Assert.Equal<string>('Coastlines', Control(Window, 'navigation', Nav.Key(Route)).Text);
    X.Assert.Equal<string>('Unsubscribe', Control(Window, 'podcast-subscription').Text);
    X.Assert.Equal<string>(Show.Url, Saved.Load(Data).PodcastSubscriptions[0].Url);
    var Placement: Cui.CuiWindowPlacement := new Cui.CuiWindowPlacement();
    WindowState.Save(Data, WindowState.FromWindow(Placement, Current.Navigation));
    X.Assert.Equal<Nav.Route?>(Route, Nav.Parse(WindowState.Load(Data).ActivePage));

    const Media: Channels.ChannelReader<Effects.Reply<App.Msg>> := Gate.Watch(
      'podcast-episode-media'
    );
    Click(Window, Control(Window, 'episode-play-night').Bounds);
    X.Assert.Contains<string>('Preparing episode…', Window.Snapshot().Text);
    X.Assert.False(Control(Window, 'player-position').Enabled);
    Deliver(Window, Media);
    Wait(
      Window,
      function(): bool => Current.Player.Position > 100.0 and Current.Player.Waveform.Length > 0,
      'The episode must play through the common decoder and build a waveform.'
    );
    X.Assert.True(Control(Window, 'player-position').Enabled);
    X.Assert.Contains<string>('The Night Ferry', Window.Snapshot().Text);
    SaveImage(Window, 'podcast-episodes.png');
    Send(Window, App.Msg.Player(Player.Msg.Toggle));
    Send(Window, App.Msg.Player(Player.Msg.Seek(0.5F)));
    Wait(
      Window, function(): bool => not Current.Player.Playing and Current.Player.Position >= 2490.0,
      'The paused episode must accept a seek.'
    );
    const NextMedia: Channels.ChannelReader<Effects.Reply<App.Msg>> := Gate.Watch(
      'podcast-episode-media'
    );
    Send(Window, App.Msg.Player(Player.Msg.Next));
    X.Assert.Equal<int>(1, Current.Player.Index);
    X.Assert.True(Current.Player.Buffering);
    X.Assert.Equal<string>('', Current.Player.EpisodePath);
    Deliver(Window, NextMedia);
    X.Assert.False(Current.Player.Buffering);
    X.Assert.NotEmpty(Current.Player.EpisodePath);
    Click(Window, Control(Window, 'podcast-subscription').Bounds);
    X.Assert.Equal<string>('Subscribe', Control(Window, 'podcast-subscription').Text);
    X.Assert.Empty(Saved.Load(Data).PodcastSubscriptions);
    X.Assert.Equal<Nav.Route>(Route, Current.Navigation.Active);
    Click(Window, Control(Window, 'podcast-back').Bounds);
    discard Control(Window, ShowButton);
    const Cleared: Channels.ChannelReader<Effects.Reply<App.Msg>> := Gate.Watch('podcasts/search');
    Send(Window, App.Msg.Podcasts(P.Msg.Query('')));
    X.Assert.Equal<string>('Loading top podcasts…', Control(Window, 'podcasts-empty').Text);
    Deliver(Window, Cleared);
    X.Assert.Equal<string>('Chart US 1301', Control(Window, ShowButton).Text);
    Click(Window, Control(Window, 'podcast-add').Bounds);
    Send(Window, App.Msg.Podcasts(P.Msg.EditUrl(Show.Url)));
    const Manual: Channels.ChannelReader<Effects.Reply<App.Msg>> := Gate.Watch('podcasts/feed');
    Click(Window, Control(Window, 'podcast-feed-add').Bounds);
    X.Assert.Empty(Saved.Load(Data).PodcastSubscriptions);
    Deliver(Window, Manual);
    X.Assert.Equal<string>('Coastlines', Control(Window, 'navigation', Nav.Key(Route)).Text);
    X.Assert.Equal<string>(Show.Url, Saved.Load(Data).PodcastSubscriptions[0].Url);
    Deliver(Window, Manual);
  finally
    Device.Dispose();
    Playback.Clean(Port);
  end try;
end procedure;

// Tests native podcast discovery, subscriptions and real finite RSS audio playback.
public type NativePodcastTests = record
  // A new feed drops missing years from the applied filters and retains a valid draft year.
  [X.FactAttribute]
  public procedure RefreshedFeedClearsUnavailableYear();
  begin
    const Show: P.Show := new P.Show('https://example.org/feed.xml', 'Example podcast');
    const Current: P.State := new P.State(
      Show := Show, FeedRevision := 2L, Years := ['2025', '2024'],
      AppliedEpisodes := new P.EpisodeFilters('2024', 'short'),
      EpisodeDraft := new P.EpisodeFilters('2025', 'long')
    );
    const Dated: P.Episode := new P.Episode(
      'dated',
      'Dated',
      'https://example.org/dated.mp3',
      Published := new Sys.DateTimeOffset(2025, 3, 1, 0, 0, 0, Sys.TimeSpan.Zero),
      Duration := 60000.0
    );
    const Undated: P.Episode := new P.Episode(
      'undated',
      'Undated',
      'https://example.org/undated.mp3'
    );
    const Updated: P.State := Update.Apply(
      Current,
      P.Msg.Loaded(2L, new P.Feed(Show, [Dated, Undated])),
      []
    ).Model;
    X.Assert.Equal<string>('', Updated.AppliedEpisodes.Year);
    X.Assert.Equal<string>('short', Updated.AppliedEpisodes.Duration);
    X.Assert.Equal<string>('2025', (Updated.EpisodeDraft ?? new P.EpisodeFilters()).Year);
    X.Assert.Equal<string>('long', (Updated.EpisodeDraft ?? new P.EpisodeFilters()).Duration);
    X.Assert.Equal<int>(1, Updated.ShownEpisodes.Length);
    X.Assert.Equal<string>('dated', Updated.ShownEpisodes[0].Id);
    const SingleYear: P.State := Update.Apply(
      Updated,
      P.Msg.Loaded(2L, new P.Feed(Show, [Dated])),
      []
    ).Model;
    X.Assert.Equal<string>('', (SingleYear.EpisodeDraft ?? new P.EpisodeFilters()).Year);
  end procedure;

  // Undated episodes appear as a filter choice and can be selected on their own.
  [X.FactAttribute]
  public procedure MissingPublicationYearCanBeSelected();
  begin
    const Items: array of P.Episode := [
      new P.Episode('undated', 'Undated', 'https://example.org/undated.mp3'),
      new P.Episode(
        'dated', 'Dated', 'https://example.org/dated.mp3',
        Published := new Sys.DateTimeOffset(2025, 3, 1, 0, 0, 0, Sys.TimeSpan.Zero)
      )
    ];
    X.Assert.Equal<string>(['2025', P.UnknownYear], Browse.Years(Items));
    const Filtered: P.State := Browse.SelectEpisodes(
      new P.State(
        Episodes := Items, AppliedEpisodes := new P.EpisodeFilters(Year := P.UnknownYear)
      )
    );
    X.Assert.Equal<int>(1, Filtered.ShownEpisodes.Length);
    X.Assert.Equal<string>('undated', Filtered.ShownEpisodes[0].Id);
  end procedure;

  // Opens a simulated Apple match and drives two real enclosures from a loopback RSS feed.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure SearchFeedSubscriptionAndPlayback();
  begin
    using const Data: H.Folder := H.Folder.Create();
    using const Listener: Sockets.TcpListener := new Sockets.TcpListener(N.IPAddress.Loopback, 0);
    using const Stop: T.CancellationTokenSource := new T.CancellationTokenSource(40000);
    Listener.Start();
    const Address: N.IPEndPoint := cast<N.IPEndPoint>(Listener.LocalEndpoint);
    const Url: string := 'http://127.0.0.1:' + Address.Port.ToString() + '/feed.rss';
    const AudioPath: string := IO.Path.Combine(Data.Path, 'fixture.wav');
    Tone.Tone(AudioPath, QuietPassage := true);
    const Bytes: array of byte := IO.File.ReadAllBytes(AudioPath);
    const Replies: array of Http.Reply := [
      new Http.Reply('200 OK', Feed, ContentType := 'application/rss+xml'),
      new Http.Reply('200 OK', '', ContentType := 'image/png', Body := Art.Picture(34, 80, 130)),
      new Http.Reply('200 OK', '', ContentType := 'audio/wav', Body := Bytes),
      new Http.Reply('200 OK', '', ContentType := 'audio/wav', Body := Bytes),
      new Http.Reply('200 OK', Feed, ContentType := 'application/rss+xml'),
      new Http.Reply('200 OK', '', ContentType := 'image/png', Body := Art.Picture(34, 80, 130))
    ];
    const Server: Tasks.Task := Http.Serve(Listener, Replies, Stop.Token);
    const Store: Library.Session := LibraryFixture.Start([], Data.Path);
    try
      Exercise(
        Store,
        Data.Path,
        new P.Show(Url, 'Coastlines', 'Directory publisher', Genres := ['1301'])
      );
      Server.GetAwaiter().GetResult();
      X.Assert.StartsWith('GET /feed.rss ', Replies[0].Request);
      X.Assert.StartsWith('GET /cover.png ', Replies[1].Request);
      X.Assert.StartsWith('GET /night.wav ', Replies[2].Request);
      X.Assert.StartsWith('GET /old.wav ', Replies[3].Request);
      X.Assert.StartsWith('GET /feed.rss ', Replies[4].Request);
    finally
      Stop.Cancel();
      Store.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;
end record;

end unit;
