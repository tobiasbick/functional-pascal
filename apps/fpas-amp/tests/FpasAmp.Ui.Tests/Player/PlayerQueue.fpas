// [Documentation](../../../doc/desktop.md#playback-and-analysis)

// Queue availability, offline skipping and bookmark persistence.
unit FpasAmp.UiTests.PlayerQueue;

uses Fpas.Ui.Mvu.Application as A;
uses Fpas.Ui.Mvu.Session as Runtime;
uses Fpas.Ui.Mvu.Testing.EffectReplies as Effects;

uses FpasAmp.AppState as Storage;
uses FpasAmp.Library.Inventory.Model as Inventory;
uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Library.Sources as Sources;
uses FpasAmp.Library.Tests.Support as H;
uses FpasAmp.Media.Audio as Audio;
uses FpasAmp.Media.Tags.AudioFiles as MediaTags;
uses FpasAmp.Persistence.PlayerState as Bookmark;
uses FpasAmp.Ui.Albums.Music.Browse as Browse;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Player.Availability as Availability;
uses FpasAmp.Ui.Player.Model as M;
uses FpasAmp.Ui.Player.Playback as Playback;
uses FpasAmp.Ui.Player.Update as Update;
uses FpasAmp.Ui.Settings.Model as Settings;
uses System as Sys;
uses System.Collections.Immutable as I;
uses System.IO as IO;
uses System.Threading as T;
uses System.Threading.Channels as Channels;
uses Xunit as X;

function Song(Id: long; Seconds: double): Tracks.Entry;
begin
  return new Tracks.Entry(
    Id,
    'track-' + Id.ToString(),
    'song.mp3',
    '',
    null,
    new MediaTags.Info(Title := 'Song ' + Id.ToString(), DurationMilliseconds := Seconds * 1000.0),
    null
  );
end function;

// Queue ownership, offline slot skipping and bookmark restore.
public type PlayerQueueTests = record
  // An early waveform seek uses the decoder duration even before the UI receives it.
  [X.FactAttribute]
  public procedure WaveformSeekBeforeDecoderDuration();
    function Apply(State: M.State; Message: M.Msg): A.Transition of (M.State, M.Msg);
    begin
      const Next: M.Transition := Update.Apply(
        State,
        Message,
        function(_Track: Tracks.Entry): bool => true
      );
      const Command: M.Request? := Next.Command;
      if Command <> null then
        Port.Send(Command);
      end if;

      case Message of
        when M.Msg.Play(_, _, _):
          return Gate.Wrap of M.State(
            new A.Transition of (M.State, M.Msg)(Next.Model, Port.Watch())
          );
        else
          return new A.Transition of (M.State, M.Msg)(Next.Model, []);
      end case;
    end function;
  begin
    using const Device: Audio.Session := new Audio.Session(true);
    const Port: Playback.Connection := Playback.Connection.Create(Device);
    const Gate: Effects.Effects of M.Msg := (Effects.Effects of M.Msg).Create();
    const Replies: Channels.ChannelReader of Effects.Reply of M.Msg := Gate.Watch('audio-events');
    using const Stop: T.CancellationTokenSource := new T.CancellationTokenSource(8000);
    const Track: Tracks.Entry := Song(1L, 1.0) with
      Path := IO.Path.Combine(Sys.AppContext.BaseDirectory, 'Fixtures', 'silence.mp3');
    end with;
    const Session: Runtime.Runtime of (M.State, M.Msg, int) := Runtime.Start of (M.State, M.Msg, int)(
      new M.State(), Apply, procedure(_Request: A.HostRequest) begin end procedure, 8
    );
    try
      Session.Dispatch(
        M.Msg.Play(I.ImmutableArray.Create of Tracks.Entry(Track), 0, new Music.Selection())
      );
      Session.Dispatch(M.Msg.Toggle);
      Session.Dispatch(M.Msg.Seek(0.72F));
      const Requested: long := Session.Model().Revision;
      const Predicted: double := Session.Model().Position;
      X.Assert.InRange of double(Predicted, 719.0, 721.0);
      var Confirmed: bool := false;
      while not Confirmed do
        const Held: Effects.Reply of M.Msg := Replies.ReadAsync(
          Stop.Token
        ).AsTask().GetAwaiter().GetResult();
        Held.Release().WaitAsync(Stop.Token).GetAwaiter().GetResult();
        discard Session.Advance();
        case Held.Message of
          when M.Msg.Observed(const Value: Audio.PlaybackEvent):
            Confirmed := Value.RequestId = Requested;
          else
            X.Assert.True(false, 'The playback worker did not return an audio event.');
        end case;

        const Current: M.State := Session.Model();
        if Confirmed then
          X.Assert.False(Current.Playing);
          X.Assert.InRange of double(Current.Position / Current.Duration, 0.70, 0.74);
        else
          X.Assert.Equal of double(Predicted, Current.Position);
        end if;
      end while;
    finally
      Session.Close().WaitAsync(Sys.TimeSpan.FromSeconds(5)).GetAwaiter().GetResult();
    end try;
  end procedure;

  // An overlapping online source must have actually indexed the queued file.
  [X.FactAttribute]
  public procedure OverlappingSourcesUseActualOwnership();
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Child: string := IO.Path.Combine(Root.Path, 'albums');
    const Path: string := IO.Path.Combine(Child, 'song.mp3');
    const Outer: Sources.MusicSource := H.Source('outer', Root.Path) with
      Offline := true;
    end with;
    const Inner: Sources.MusicSource := H.Source('inner', Child) with
      Paused := true;
    end with;
    const Owned: Inventory.SourceSnapshot := new Inventory.SourceSnapshot(
      Outer.Id,
      Outer.Path,
      Inventory.Availability.Offline,
      I.ImmutableArray.Create of string(Path),
      (I.ImmutableArray of Inventory.ScanIssue).Empty,
      false
    );
    const Shared: Inventory.SourceSnapshot := Owned with
      Id := Inner.Id;
      Path := Inner.Path;
      Status := Inventory.Availability.Paused;
    end with;
    const State: Settings.State := new Settings.State(new Settings.Preferences([Outer, Inner]));
    const Track: Tracks.Entry := Song(1L, 3.0) with
      Path := Path;
      SourceIds := [Outer.Id];
    end with;
    X.Assert.False(Availability.Allows(State, Track));
    X.Assert.True(
      Availability.Allows(
        State, Track with
          SourceIds := [Outer.Id, Inner.Id];
        end with
      )
    );
    const Views: I.ImmutableArray of Inventory.SourceSnapshot := I.ImmutableArray.CreateRange of Inventory.SourceSnapshot(
      [Owned, Shared]
    );
    const Snapshot: Inventory.Snapshot := new Inventory.Snapshot(1L, 0L, Views);
    X.Assert.True(
      Availability.Allows(
        State with
          Inventory := Snapshot;
        end with, Track
      )
    );
    const Cleared: Inventory.SourceSnapshot := Shared with
      Files := (I.ImmutableArray of string).Empty;
    end with;
    X.Assert.False(
      Availability.Allows(
        State with
          Inventory := Snapshot with
            Sources := Views.SetItem(1, Cleared);
          end with;
        end with, Track
      )
    );
  end procedure;

  // Every route through the queue skips offline paths, including failed and naturally ended tracks.
  [X.TheoryAttribute]
  [X.InlineDataAttribute(false)]
  [X.InlineDataAttribute(true)]
  public procedure NavigationSkipsOfflineSlots(Failed: bool);
  begin
    const Base: Tracks.Entry := Song(1L, 3.0);
    const Queue: I.ImmutableArray of Tracks.Entry := I.ImmutableArray.CreateRange of Tracks.Entry(
      [
        Base with
          Path := 'offline';
        end with, Base with
          Path := 'one';
        end with,
        Base with
          Path := 'offline';
        end with, Base with
          Path := 'two';
        end with
      ]
    );
    const Allowed: function(Tracks.Entry): bool := function(Track: Tracks.Entry): bool => Track.Path <>
      'offline';
    const First: M.State := Update.Apply(
      new M.State(),
      M.Msg.Play(Queue, 0, new Music.Selection()),
      Allowed
    ).Model;
    X.Assert.Equal of int(1, First.Index);
    const Next: M.State := Update.Apply(First, M.Msg.Next, Allowed).Model;
    X.Assert.Equal of int(3, Next.Index);
    X.Assert.Equal of int(1, Update.Apply(Next, M.Msg.Previous, Allowed).Model.Index);
    const Event: Audio.PlaybackEvent := new Audio.PlaybackEvent(
      'one',
      if Failed then
        Audio.PlaybackState.Failed
      else
        Audio.PlaybackState.Ended
      end if,
      Sys.TimeSpan.Zero, Sys.TimeSpan.Zero, (I.ImmutableArray of float).Empty, null, First.Revision
    );
    X.Assert.Equal of int(3, Update.Apply(First, M.Msg.Observed(Event), Allowed).Model.Index);
    const Restored: M.State := Update.Apply(
      First with
        Playing := false;
        NeedsOpen := true;
      end with,
      M.Msg.SourceLost(true), Allowed
    ).Model;
    X.Assert.True(Restored.NeedsOpen);
    X.Assert.False(Restored.Playing);
    X.Assert.Equal of string('two', Restored.WaveformKey);
  end procedure;

  // Bookmark size is independent of the number of tracks, and catalogue edits apply on reopen.
  [X.FactAttribute]
  public procedure LargeSelectionsRestoreByTrackIdentityAndQuery();
  begin
    using const Folder: H.Folder := H.Folder.Create();
    const All: (I.ImmutableArray of Tracks.Entry).Builder := I.ImmutableArray.CreateBuilder of Tracks.Entry();
    for N: int := 0 to 10009 do
      All.Add(
        Song(cast N as long, cast (N + 1) as double) with
          Rating := 8;
        end with
      );
    end for;
    const Origin: Music.Selection := new Music.Selection(
      Search := 'song',
      MinimumRating := 7,
      Column := 3,
      Descending := true
    );
    const Queue: I.ImmutableArray of Tracks.Entry := Browse.Songs(All.ToImmutable(), Origin);
    const Current: M.State := new M.State(
      Queue := Queue,
      Source := Origin,
      Index := 10,
      Position := 3400.0,
      Duration := 90000.0
    );
    Storage.Save(Folder.Path, new Storage.Snapshot(Player := Bookmark.Capture(Current)));
    X.Assert.True(new IO.FileInfo(IO.Path.Combine(Folder.Path, 'state.json')).Length < 2048L);
    All.Add(
      Song(20000L, 20000.0) with
        Rating := 9;
      end with
    );
    All.Add(
      Song(20001L, 20001.0) with
        Rating := 1;
      end with
    );
    const Saved: Bookmark.Saved := Storage.Load(Folder.Path).Player;
    const Restored: M.State := Bookmark.Restore(Saved, All.ToImmutable());
    X.Assert.Equal of int(10011, Restored.Queue.Length);
    X.Assert.Equal of int(11, Restored.Index);
    X.Assert.Equal of string(Current.Queue[10].TrackId, Restored.Queue[11].TrackId);
    X.Assert.Equal of double(3400.0, Restored.Position);
    X.Assert.False(Restored.Playing);
    discard All.Remove(Current.Queue[Current.Index]);
    const Replaced: M.State := Bookmark.Restore(Saved, All.ToImmutable());
    X.Assert.Equal of int(Saved.Index, Replaced.Index);
    X.Assert.NotEqual of string(Saved.TrackId, Replaced.Queue[Replaced.Index].TrackId);
    X.Assert.Equal of double(0.0, Replaced.Position);
  end procedure;

  // An unrated queue uses the same filter after saving and restoring its bookmark.
  [X.FactAttribute]
  public procedure UnratedQueueRestoresItsFilter();
  begin
    using const Folder: H.Folder := H.Folder.Create();
    const Unrated: Tracks.Entry := Song(1L, 200.0);
    const Rated: Tracks.Entry := Song(2L, 200.0) with
      Rating := 7;
    end with;
    const Library: I.ImmutableArray of Tracks.Entry := I.ImmutableArray.CreateRange of Tracks.Entry(
      [Unrated, Rated]
    );
    const Source: Music.Selection := new Music.Selection(MinimumRating := -1);
    const Queue: I.ImmutableArray of Tracks.Entry := Browse.Songs(Library, Source);
    X.Assert.Equal of int(1, Queue.Length);
    X.Assert.Equal of string(Unrated.TrackId, Queue[0].TrackId);
    const Playing: M.State := new M.State(Queue := Queue, Source := Source, Index := 0);
    Storage.Save(Folder.Path, new Storage.Snapshot(Player := Bookmark.Capture(Playing)));
    const Restored: M.State := Bookmark.Restore(Storage.Load(Folder.Path).Player, Library);
    X.Assert.Equal of int(-1, Restored.Source.MinimumRating);
    X.Assert.Equal of int(1, Restored.Queue.Length);
    X.Assert.Equal of string(Unrated.TrackId, Restored.Queue[0].TrackId);
  end procedure;
end record;

end unit;
