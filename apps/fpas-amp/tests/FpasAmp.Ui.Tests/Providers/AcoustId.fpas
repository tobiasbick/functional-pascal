// [Documentation](../../../doc/desktop.md#editing-track-tags)

unit FpasAmp.UiTests.AcoustId;

uses FpasAmp.Ui.TagEditor.AcoustId as Acoust;
uses FpasAmp.Ui.TagEditor.MusicBrainz as MB;
uses System as Sys;
uses Xunit as X;

// Checks the AcoustID response contract at the boundary of the shared picker.
public type AcoustIdTests = record
  // Fingerprint hit IDs are distinct from MusicBrainz recording IDs. Editions remain selectable.
  [X.FactAttribute]
  public procedure NestedEditionsBecomeDistinctChoices();
  begin
    const Recording: string := '11111111-1111-1111-1111-111111111111';
    const Release: string := '22222222-2222-2222-2222-222222222222';
    const Other: string := '33333333-3333-3333-3333-333333333333';
    const Editions: string := '{"id":"' + Recording + '","title":"North Pier",' +
      '"artists":[{"name":"Mara Vale"}],"releasegroups":[{"title":"North Pier Sessions",' +
      '"releases":[{"id":"' + Release + '","country":"US","date":"2024-07-03"}]}]}';
    const Matches: array of MB.Match := Acoust.Decode(
      '{"status":"ok","results":[{"score":0.60,"recordings":[{"id":"' + Other + '"}]},' +
      '{"id":"44444444-4444-4444-4444-444444444444","score":0.98,"recordings":[' + Editions +
      ']},' +
      '{"score":0.75,"recordings":[' + Editions + ']},{"score":1.0}]}'
    );
    X.Assert.Equal of int(2, Matches.Length);
    X.Assert.Equal of string(Recording, Matches[0].Recording);
    X.Assert.Equal of string(Release, Matches[0].Release);
    X.Assert.Contains('North Pier Sessions · 2024-07-03 · US', Matches[0].Label);
    X.Assert.Contains('Mara Vale', Matches[0].Label);
    X.Assert.Equal of string(Other, Matches[1].Recording);
    X.Assert.Equal of string('', Matches[1].Release);
    X.Assert.Equal of int(0, Acoust.Decode('{"status":"ok","results":[]}').Length);
  end procedure;

  // API errors are surfaced by code, without echoing the response text.
  [X.FactAttribute]
  public procedure ErrorPayloadDoesNotPassThroughProviderText();
  begin
    const Failure: Sys.InvalidOperationException := X.Assert.Throws of Sys.InvalidOperationException(
      procedure() begin
        discard Acoust.Decode(
          '{"status":"error","error":{"code":4,"message":"fixture application key"}}'
        );
      end procedure
    );
    X.Assert.Equal of string('AcoustID API error 4', Failure.Message);
  end procedure;
end record;

end unit;
