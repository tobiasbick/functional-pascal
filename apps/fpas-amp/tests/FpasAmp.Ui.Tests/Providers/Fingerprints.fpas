// [Documentation](../../../doc/library.md#acoustic-fingerprints)

// Exercises both routes to a fingerprint with the real native tool and a private library.
unit FpasAmp.UiTests.Fingerprints;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Mvu.Session as Runtime;
uses Fpas.Ui.Mvu.Testing.EffectReplies as Replies;

uses FpasAmp.Library.Inventory.Monitoring as Monitor;
uses FpasAmp.Library.Metadata.Fingerprints.Calculator as Measurement;
uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Library.Sources as Sources;
uses FpasAmp.Library.Tests.MetadataSupport as Fixtures;
uses FpasAmp.Library.Tests.Support as H;
uses FpasAmp.Media.Audio as Audio;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Albums.Music.View as View;
uses FpasAmp.Ui.App.Controller as Controller;
uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Fingerprints as Fp;
uses FpasAmp.Ui.Music.LibraryPage as Songs;
uses FpasAmp.Ui.Navigation.Model as Nav;
uses FpasAmp.Ui.Player.Model as Player;
uses FpasAmp.Ui.Player.Playback as Playback;
uses FpasAmp.Ui.Settings.Model as Settings;
uses FpasAmp.Ui.Shell as Shell;
uses FpasAmp.UiTests.PlaybackFixture as Wave;
uses System as Sys;
uses System.Collections.Immutable as I;
uses System.IO as IO;
uses System.Threading as T;
uses System.Threading.Channels as Channels;
uses Xunit as X;

function ClipboardText(
  Node: E.Element of Music.Msg;
  Id: string := 'track-copy-fingerprint'
): string?;
begin
  case Node of
    when E.Element.Dialog(_, _, const Body: E.Element of Music.Msg, true, _, _):
      return ClipboardText(Body, Id);
    when E.Element.Stack(const Children: array of E.Element of Music.Msg, _, _), E.Element.Card(
      _,
      const Children: array of E.Element of Music.Msg,
      _,
      _
    ):
      for Child: E.Element of Music.Msg in Children do
        const Value: string? := ClipboardText(Child, Id);
        if Value <> null then
          return Value;
        end if;
      end for;
    when E.Element.CopyAction(const Key: string, const Value: string, _, true):
      if Key = Id then
        return Value;
      end if;
    else
  end case;

  return null;
end function;

function Wait(Session: Shell.Session; Check: function(App.State): bool): App.State;
begin
  const Deadline: long := Sys.Environment.TickCount64 + 15000L;
  while Sys.Environment.TickCount64 < Deadline do
    discard Session.Window.Post(App.Msg.Settings(Settings.Msg.DismissError));
    X.Assert.True(Session.Window.Step());
    const Current: App.State := Session.State();
    if Check(Current) then
      return Current;
    end if;

    T.Thread.Sleep(5);
  end while;

  raise new Sys.TimeoutException('Fingerprint state did not reach the expected result.');
end function;

function Complete(Result: Fp.State?): bool;
begin
  if Result = null or Result.Busy then
    return false;
  end if;

  X.Assert.Null(Result.Error);
  return true;
end function;

function HasValue(Result: Fp.State?): bool;
begin
  return Complete(Result) and Result <> null and Result.Value <> null;
end function;

// Runs the shared details UI against the installed native fpcalc and a real audio session.
public type FingerprintTests = record
  // A cache miss stays passive in details, playback and manual generation persist distinct
  // results, and both dialogs copy full values while the original files stay byte-identical.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure PlaybackAndManualDetailsUseTheDurableLocalCache();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const First: string := IO.Path.Combine(Root.Path, 'A - local track.wav');
    const Second: string := IO.Path.Combine(Root.Path, 'B & different.wav');
    Wave.Tone(First, Seconds := 20, Sweep := true);
    Wave.Tone(Second, true, 17, true);
    const BeforeA: array of byte := IO.File.ReadAllBytes(First);
    const BeforeB: array of byte := IO.File.ReadAllBytes(Second);
    const Source: Sources.MusicSource := Fixtures.Source(Root.Path) with
      Extensions := ['.wav'];
    end with;
    const Store: Monitor.Session := Fixtures.Start([Source], Data.Path);
    var Auto: string := '';
    var Manual: string := '';
    try
      const Items: I.ImmutableArray of Tracks.Entry := Fixtures.Until(
        Fixtures.Tags(Store),
        function(Rows: I.ImmutableArray of Tracks.Entry): bool => Rows.Length = 2
      ).GetAwaiter().GetResult();
      const A: Tracks.Entry := if Items[0].Path = First then
        Items[0]
      else
        Items[1]
      end if;
      const B: Tracks.Entry := if Items[0].Path = First then
        Items[1]
      else
        Items[0]
      end if;
      var Placement: Cui.CuiWindowPlacement := new Cui.CuiWindowPlacement();
      Placement.Width := 1320;
      Placement.Height := 820;
      using const Session: Shell.Session := Shell.Session.Start(
        Placement,
        new Settings.Preferences([Source]),
        procedure(_Value: Settings.Preferences) begin end procedure,
        Store,
        Navigation := new Nav.State(Active := Nav.Route.Page(Nav.Page.Music)),
        Output := new Audio.Session(true)
      );
      discard Wait(Session, function(S: App.State): bool => S.Songs.Page.Shown.Length = 2);
      discard Session.Window.Post(App.Msg.Songs(Songs.Msg.Song(Music.Msg.Details(A))));
      discard Wait(Session, function(S: App.State): bool => Complete(S.Songs.Page.Fingerprint));
      X.Assert.Contains of string('Acoustic fingerprint', Session.Window.Snapshot().Text);
      X.Assert.Contains of string(
        'No additional track information.',
        Session.Window.Snapshot().Text
      );
      discard Session.Window.Post(
        App.Msg.Songs(Songs.Msg.Song(Music.Msg.SelectDetailTab(Music.DetailTab.Credits)))
      );
      discard Wait(
        Session,
        function(S: App.State): bool => S.Songs.Page.ActiveDetailTab = Music.DetailTab.Credits
      );
      X.Assert.Contains of string('No credits available.', Session.Window.Snapshot().Text);
      X.Assert.Null(
        Fixtures.Tags(Store).FingerprintAsync(
          A,
          false,
          T.CancellationToken.None
        ).GetAwaiter().GetResult()
      );
      discard Session.Window.Post(
        App.Msg.Player(
          Player.Msg.Play(I.ImmutableArray.Create of Tracks.Entry(A), 0, new Music.Selection())
        )
      );
      const Played: App.State := Wait(
        Session,
        function(S: App.State): bool => Complete(S.Player.Fingerprint)
      );
      Auto := Fixtures.Tags(Store).FingerprintAsync(
        A,
        false,
        T.CancellationToken.None
      ).GetAwaiter().GetResult() ?? '';
      X.Assert.True(Auto.Length > 40);
      X.Assert.Equal of string(
        First, ClipboardText(
          View.LibraryPage(Played.Songs.Page, 1000, 20, Played.Songs.Covers, Played.Player),
          'track-copy-path'
        )
      );
      X.Assert.Equal of string(
        Auto,
        ClipboardText(
          View.LibraryPage(Played.Songs.Page, 1000, 20, Played.Songs.Covers, Played.Player)
        )
      );
      X.Assert.Contains of string(Auto.Substring(0, 40) + '…', Session.Window.Snapshot().Text);
      const SaveAt: string? := Sys.Environment.GetEnvironmentVariable('FPAS_AMP_UI_ARTIFACTS');
      if SaveAt <> null then
        discard IO.Directory.CreateDirectory(SaveAt);
        Session.Window.CapturePng(IO.Path.Combine(SaveAt, 'track-details-copy-icons.png'));
      end if;

      const Controls: array of Gui.Control := Session.Window.Snapshot().Controls;
      const PathCopy: Gui.Control? := Sys.Array.Find of Gui.Control(
        Controls, function(Item: Gui.Control): bool => Item.Id = 'track-copy-path'
      );
      const FingerprintCopy: Gui.Control? := Sys.Array.Find of Gui.Control(
        Controls, function(Item: Gui.Control): bool => Item.Id = 'track-copy-fingerprint'
      );
      if PathCopy = null or FingerprintCopy = null then
        raise new Sys.InvalidOperationException('The dialog must show both copy buttons.');
      end if;

      X.Assert.Equal of float(PathCopy.Bounds.X, FingerprintCopy.Bounds.X);
      X.Assert.Equal of float(PathCopy.Bounds.Width, FingerprintCopy.Bounds.Width);
      discard Session.Window.Post(App.Msg.Songs(Songs.Msg.Song(Music.Msg.Details(B))));
      discard Wait(
        Session,
        function(S: App.State): bool => Fp.Matches(
          S.Songs.Page.Fingerprint,
          B
        ) and Complete(S.Songs.Page.Fingerprint)
      );
      X.Assert.Null(
        Fixtures.Tags(Store).FingerprintAsync(
          B,
          false,
          T.CancellationToken.None
        ).GetAwaiter().GetResult()
      );
      X.Assert.Contains of string(
        'No additional track information.',
        Session.Window.Snapshot().Text
      );
      discard Session.Window.Post(
        App.Msg.Songs(Songs.Msg.Song(Music.Msg.SelectDetailTab(Music.DetailTab.Audio)))
      );
      discard Wait(
        Session,
        function(S: App.State): bool => S.Songs.Page.ActiveDetailTab = Music.DetailTab.Audio
      );
      X.Assert.Contains of string('44.1 kHz', Session.Window.Snapshot().Text);
      X.Assert.Contains of string('16-bit', Session.Window.Snapshot().Text);
      discard Session.Window.Post(App.Msg.Songs(Songs.Msg.Song(Music.Msg.GenerateFingerprint)));
      const Generated: App.State := Wait(
        Session,
        function(S: App.State): bool => HasValue(S.Songs.Page.Fingerprint)
      );
      Manual := Fixtures.Tags(Store).FingerprintAsync(
        B,
        false,
        T.CancellationToken.None
      ).GetAwaiter().GetResult() ?? '';
      X.Assert.True(Manual.Length > 40);
      X.Assert.Contains of string('44.1 kHz', Session.Window.Snapshot().Text);
      X.Assert.NotEqual of string(Auto, Manual);
      X.Assert.Equal of string(
        Manual,
        ClipboardText(View.Build(Generated.Songs.Page, 1000, 'Albums', Generated.Player, 2L))
      );
      X.Assert.True(Generated.Player.Playing);
      X.Assert.Equal of string(First, Generated.Player.Queue[Generated.Player.Index].Path);
    finally
      Store.DisposeAsync().GetAwaiter().GetResult();
    end try;
    const Restart: Monitor.Session := Fixtures.Start([Source], Data.Path);
    try
      const Items: I.ImmutableArray of Tracks.Entry := Fixtures.Until(
        Fixtures.Tags(Restart),
        function(Rows: I.ImmutableArray of Tracks.Entry): bool => Rows.Length = 2
      ).GetAwaiter().GetResult();
      for Item: Tracks.Entry in Items do
        const Cached: Measurement.Measurement? := Fixtures.Tags(Restart).MeasureFingerprintAsync(
          Item, false, T.CancellationToken.None
        ).GetAwaiter().GetResult();
        if Cached = null then
          raise new Sys.InvalidOperationException(
            'The cached fingerprint and duration are missing.'
          );
        end if;

        X.Assert.Equal of string(
          if Item.Path = First then
            Auto
          else
            Manual
          end if,
          Cached.Value
        );
        const Seconds: double := if Item.Path = First then
          20.0
        else
          17.0
        end if;
        X.Assert.InRange of double(Cached.Duration, Seconds - 0.1, Seconds + 0.1);
      end for;

      X.Assert.Equal of byte(BeforeA, IO.File.ReadAllBytes(First));
      X.Assert.Equal of byte(BeforeB, IO.File.ReadAllBytes(Second));
    finally
      Restart.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;

  // A cache lookup that finishes last cannot hide the fingerprint delivered by playback.
  [X.FactAttribute]
  public procedure LateCacheMissKeepsTheFullClipboardValue();
    function CopyValue(State: App.State): string?;
    begin
      return ClipboardText(
        View.LibraryPage(State.Songs.Page, 1000, 20, State.Songs.Covers, State.Player)
      );
    end function;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
    const Path: string := IO.Path.Combine(Root.Path, 'late lookup.wav');
    Wave.Tone(Path, Seconds := 12, Sweep := true);
    const Source: Sources.MusicSource := Fixtures.Source(Root.Path) with
      Extensions := ['.wav'];
    end with;
    const Store: Monitor.Session := Fixtures.Start([Source], Data.Path);
    try
      const Items: I.ImmutableArray of Tracks.Entry := Fixtures.Until(
        Fixtures.Tags(Store),
        function(Rows: I.ImmutableArray of Tracks.Entry): bool => Rows.Length = 1
      ).GetAwaiter().GetResult();
      const Initial: App.State := new App.State(
        new Settings.State(new Settings.Preferences([Source])),
        Navigation := new Nav.State(Active := Nav.Route.Page(Nav.Page.Music)),
        Player := new Player.State(Queue := Items, Index := 0, Playing := true)
      );
      using const Device: Audio.Session := new Audio.Session(true);
      const Port: Playback.Connection := Playback.Connection.Create(Device);
      const Gate: Replies.Effects of App.Msg := (Replies.Effects of App.Msg).Create();
      const Host: Runtime.Runtime of (App.State, App.Msg, int) := Runtime.Start of (App.State, App.Msg, int)(
        Initial,
        function(S: App.State; Msg: App.Msg): Mvu.Transition of (App.State, App.Msg) => Gate.Wrap of App.State(
          Controller.Apply(
            S,
            Msg,
            procedure(_Value: Settings.Preferences) begin end procedure,
            Store,
            Port
          )
        ),
        procedure(_Request: Mvu.HostRequest) begin end procedure,
        8
      );
      try
        const Lookup: Channels.ChannelReader of Replies.Reply of App.Msg := Gate.Watch(
          'songs/song/detail-fingerprint'
        );
        Host.Dispatch(App.Msg.Songs(Songs.Msg.Song(Music.Msg.Details(Items[0]))));
        const Miss: Replies.Reply of App.Msg := Lookup.ReadAsync(
          Deadline.Token
        ).AsTask().GetAwaiter().GetResult();
        X.Assert.Null(CopyValue(Host.Model()));
        const Calculation: Channels.ChannelReader of Replies.Reply of App.Msg := Gate.Watch(
          'player-fingerprint'
        );
        Host.Dispatch(
          App.Msg.Player(
            Player.Msg.Observed(
              new Audio.PlaybackEvent(
                Path,
                Audio.PlaybackState.Playing,
                Sys.TimeSpan.FromSeconds(1),
                Sys.TimeSpan.FromSeconds(12),
                (I.ImmutableArray of float).Empty,
                null,
                Initial.Player.Revision
              )
            )
          )
        );
        const Ready: Replies.Reply of App.Msg := Calculation.ReadAsync(
          Deadline.Token
        ).AsTask().GetAwaiter().GetResult();
        X.Assert.Null(CopyValue(Host.Model()));
        Ready.Release().WaitAsync(Deadline.Token).GetAwaiter().GetResult();
        discard Host.Advance();
        const Value: string := CopyValue(Host.Model()) ?? '';
        X.Assert.True(Value.Length > 40);
        Miss.Release().WaitAsync(Deadline.Token).GetAwaiter().GetResult();
        discard Host.Advance();
        Host.Dispatch(App.Msg.Player(Player.Msg.SourceLost(false)));
        X.Assert.Equal of string(Value, CopyValue(Host.Model()));
      finally
        Host.Close().WaitAsync(Deadline.Token).GetAwaiter().GetResult();
      end try;
    finally
      Store.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;
end record;

end unit;
