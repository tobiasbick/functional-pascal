// [Documentation](../../../doc/desktop.md#editing-track-tags)

unit FpasAmp.UiTests.MusicBrainz;

uses
  FpasAmp.Ui.TagEditor.MusicBrainz as MB, FpasAmp.Library.TagEditing.Fields as Fields,
  FpasAmp.Ui.TagEditor.MusicBrainzTags as Tags, MetaBrainz.MusicBrainz.Interfaces.Entities as E,
  FpasAmp.Ui.TagEditor.CustomTags as Custom, FpasAmp.Ui.TagEditor.Model as Editor,
  FpasAmp.Ui.TagEditor.Changes as Changes, FpasAmp.Ui.Providers.RequestPacing as Pacing,
  FpasAmp.Library.TagEditing.Files as Files, FpasAmp.Library.Metadata.Model as Tracks,
  FpasAmp.UiTests.ProviderHttp as Server,
  System as Sys, System.Net as Net, System.Net.Http as Http, System.Net.Sockets as Sockets,
  System.Collections.Immutable as I, System.Threading as T, System.Threading.Tasks as Tasks, Xunit as X;

// Checks the provider and tag editor contract against scripted MusicBrainz HTTP responses.
public type MusicBrainzTests = record
  // A recording can be paired with each release. Lookups prefer the selected release track.
  [X.FactAttribute]
  public async function SearchAndLookupKeepReleaseAndWorkCredits(): Tasks.Task;
  begin
    const RecordingId: string := '11111111-1111-1111-1111-111111111111';
    const ReleaseId: string := '22222222-2222-2222-2222-222222222222';
    const ArtistId: string := '44444444-4444-4444-4444-444444444444';
    const OtherId: string := '33333333-3333-3333-3333-333333333333';
    const Replies: array of Server.Reply := [
      new Server.Reply(
        '503 Service Temporarily Unavailable', '{"error":"Try again"}',
        'Retry-After: 3' + Sys.Char.ConvertFromUtf32(13) + Sys.Char.ConvertFromUtf32(10)
      ),
      new Server.Reply(
        '200 OK',
        '{"count":1,"offset":0,"created":"2026-01-01T12:00:00Z","recordings":[{"score":100,"id":"' +
        RecordingId +
        '","title":"Search title","artist-credit":[{"name":"Mara Vale","artist":{"id":"' +
        ArtistId + '","name":"Mara Vale"}}],' +
        '"releases":[{"id":"' + ReleaseId + '","title":"Chosen edition","date":"2024-07-03"},' +
        '{"id":"' + OtherId + '","title":"First edition"}]}]}'
      ),
      new Server.Reply(
        '200 OK',
        '{"id":"' + RecordingId + '","title":"Recording title","genres":[{"id":"' + OtherId +
        '","name":"indie folk"}],"relations":[{"type":"producer","target-type":"artist","artist":{"id":"' +
        OtherId +
        '","name":"Elias Hart"}},{"type":"performance","target-type":"work","work":{"id":"' +
        OtherId + '","relations":[{"type":"composer","target-type":"artist","artist":{"id":"' +
        ArtistId + '","name":"Mara Vale"}}]}}]}'
      ),
      new Server.Reply(
        '200 OK',
        '{"id":"' + ReleaseId + '","title":"Chosen edition","date":"2024-07-03",' +
        '"asin":"B0000TEST0","barcode":"1234567890123","country":"US","status":"Official",' +
        '"text-representation":{"script":"Latn"},"label-info":[{"label":{"id":"' + OtherId +
        '","name":"Tidehouse"}}],"media":[{"position":1,"track-count":2,"tracks":[{"id":"' +
        OtherId +
        '","title":"Other","position":1,"recording":{"id":"' + OtherId + '"}},{"id":"' + ArtistId +
        '","title":"Printed track title","position":2,"recording":{"id":"' + RecordingId + '"}}]}]}'
      ),
      new Server.Reply('404 Not Found', '{"error":"No matching recording"}')
    ];
    using const Listener: Sockets.TcpListener := new Sockets.TcpListener(Net.IPAddress.Loopback, 0);
    Listener.Start();
    const Address: Net.IPEndPoint := cast<Net.IPEndPoint>(Listener.LocalEndpoint);
    using const Provider: MB.Service := MB.Service.Connect(
      new Sys.Uri('http://127.0.0.1:' + Address.Port.ToString())
    );
    using const Stop: T.CancellationTokenSource := new T.CancellationTokenSource(20000);
    const Serving: Tasks.Task := Server.Serve(Listener, Replies, Stop.Token);
    const Matches: array of MB.Match := await Provider.Search(
      'Search title · Mara Vale',
      Stop.Token
    );
    X.Assert.Equal<int>(2, Matches.Length);
    X.Assert.Contains('Chosen edition · 2024-07-03 — Search title · Mara Vale', Matches[0].Label);
    X.Assert.Equal<string>(ReleaseId, Matches[0].Release);
    X.Assert.Equal<string>(Replies[0].Request, Replies[1].Request);
    X.Assert.Contains('GET /ws/2/recording/?', Replies[1].Request);
    X.Assert.True(Replies[1].Arrived - Replies[0].Arrived >= 3000L);

    const Recording: E.IRecording := await Provider.Recording(Matches[0].Recording, Stop.Token);
    const Release: E.IRelease := await Provider.Release(Matches[0].Release, Stop.Token);
    const Values: I.ImmutableDictionary<string, string> := Tags.Proposals(Recording, Release);
    try
      discard await Provider.Search('fixture-private-search', Stop.Token);
      raise new Sys.InvalidOperationException('Expected the provider to report the failed search.');
    catch Error: Http.HttpRequestException do
      X.Assert.Contains('HTTP/1.1 404 Not Found', Error.Message);
      X.Assert.Contains('GET /ws/2/recording', Error.Message);
      X.Assert.Contains('attempt 1/6', Error.Message);
      X.Assert.DoesNotContain('fixture-private-search', Error.Message);
    end try;

    await Serving;
    X.Assert.Contains('work-level-rels', Replies[2].Request);
    X.Assert.Contains(ReleaseId, Replies[3].Request);
    X.Assert.True(Replies[3].Arrived - Replies[2].Arrived >= 1000L);
    X.Assert.Equal<string>('Printed track title', Fields.Value(Values, 'title'));
    X.Assert.Equal<string>('Chosen edition', Fields.Value(Values, 'album'));
    X.Assert.Equal<string>('2 / 2', Fields.Value(Values, 'track'));
    X.Assert.Equal<string>('1 / 1', Fields.Value(Values, 'disc'));
    X.Assert.Equal<string>('Tidehouse', Fields.Value(Values, 'label'));
    X.Assert.Equal<string>('2024', Fields.Value(Values, 'year'));
    X.Assert.Equal<string>('Elias Hart', Fields.Value(Values, 'producer'));
    X.Assert.Equal<string>('Mara Vale', Fields.Value(Values, 'composer'));
    X.Assert.False(Values.ContainsKey('lyricist'));
    X.Assert.Equal<string>('Latn', Fields.Value(Values, Fields.Custom + 'SCRIPT'));
    X.Assert.Equal<string>(
      'official',
      Fields.Value(Values, Fields.Custom + 'MusicBrainz Album Status')
    );
    const Existing: string := Fields.Custom + 'MUSICBRAINZ_ALBUMID';
    const Original: Files.Snapshot := new Files.Snapshot(
      I.ImmutableDictionary<string, string>.Empty.Add(Existing, 'Original release')
    );
    const Draft: Editor.State := new Editor.State(
      new Tracks.Entry(1L, 'track', 'fixture.flac', '', null, null, null),
      Original := Original, Values := Original.Values,
      Extra := I.ImmutableArray.Create<Editor.Custom>(
        new Editor.Custom(0, 'MUSICBRAINZ_ALBUMID', 'Original release')
      )
    );
    const Resolved: I.ImmutableDictionary<string, string> := Custom.MatchNames(Draft, Values);
    const Selected: I.ImmutableDictionary<string, string?> := Changes.Build(
      Draft with
        Proposals := Resolved;
        Selected := I.ImmutableHashSet<string>.Empty.Add(Existing).Add(Fields.Custom + 'ASIN');
      end with, Original
    );
    X.Assert.Equal<int>(2, Selected.Count);
    X.Assert.Equal<string?>(ReleaseId, Selected[Existing]);
    X.Assert.Equal<string?>('B0000TEST0', Selected[Fields.Custom + 'ASIN']);
  end function;

  // The shared deadline remains in force after a slot owner exits.
  [X.FactAttribute]
  public async function CooldownSurvivesReleaseAndDelaysTheNextOwner(): Tasks.Task;
  begin
    const Gate: Pacing.Gate := Pacing.Gate.Create(1000L);
    using const Stop: T.CancellationTokenSource := new T.CancellationTokenSource(8000);
    await Gate.Enter(Stop.Token);
    const Began: long := Sys.Environment.TickCount64;
    try
      await Gate.Start(Stop.Token);
      Gate.Cooldown(1250L);
      X.Assert.True(Gate.Read().Busy);
    finally
      Gate.Leave();
    end try;

    X.Assert.False(Gate.Read().Busy);
    X.Assert.True(Gate.Read().Seconds > 0L);
    await Gate.Enter(Stop.Token);
    try
      await Gate.Start(Stop.Token);
      X.Assert.True(Sys.Environment.TickCount64 - Began >= 1250L);
    finally
      Gate.Leave();
    end try;
  end function;
end record;

end unit;
