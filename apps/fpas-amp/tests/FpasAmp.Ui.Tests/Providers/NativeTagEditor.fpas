// [Documentation](../../../doc/desktop.md#editing-track-tags)

unit FpasAmp.UiTests.NativeTagEditor;

uses Fpas.Media.Audio as Audio;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Mvu.Testing.EffectReplies as Effects;

uses ATL as Atl;
uses FpasAmp.Library.Inventory.Monitoring as Library;
uses FpasAmp.Library.Metadata.Model as Tracks;
uses FpasAmp.Library.Metadata.Monitoring as Metadata;
uses FpasAmp.Library.TagEditing.Fields as Fields;
uses FpasAmp.Library.TagEditing.Files as Files;
uses FpasAmp.Library.Tests.MetadataSupport as Fixture;
uses FpasAmp.Library.Tests.Support as H;
uses FpasAmp.Ui.App.Controller as Controller;
uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Player.Playback as Playback;
uses FpasAmp.Ui.Providers.RequestPacing as Pacing;
uses FpasAmp.Ui.Settings.Model as Settings;
uses FpasAmp.Ui.Shell as Shell;
uses FpasAmp.Ui.TagEditor.Model as Editor;
uses FpasAmp.Ui.TagEditor.MusicBrainz as MB;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Collections.Immutable as I;
uses System.IO as IO;
uses System.Threading as T;
uses System.Threading.Channels as Channels;
uses System.Threading.Tasks as Tasks;
uses Xunit as X;

function Control(Session: Gui.Session of App.Msg; Id: string; Key: string := ''): Gui.Control;
begin
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Id = Id and Item.Key = Key then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing tag editor control: ' + Id);
end function;

procedure Capture(Session: Gui.Session of App.Msg; FileName: string);
begin
  const Directory: string? := Sys.Environment.GetEnvironmentVariable('FPAS_AMP_UI_ARTIFACTS');
  if Directory <> null then
    discard IO.Directory.CreateDirectory(Directory);
    Session.CapturePng(IO.Path.Combine(Directory, FileName));
  end if;
end procedure;

function ProviderFixture(Message: Editor.Msg; Id: string): Mvu.Command of App.Msg;
begin
  return Mvu.StartBackground of App.Msg(
    Id,
    Mvu.FromWorker of App.Msg(
      async function(Post: function(App.Msg): Tasks.Task; _Stop: T.CancellationToken): Tasks.Task begin
        case Message of
          when Editor.Msg.Scan:
            await Post(
              App.Msg.TagEditor(
                Editor.Msg.Found(
                  [
                    new MB.Match(
                      '11111111-1111-1111-1111-111111111111',
                      '22222222-2222-2222-2222-222222222222',
                      'Sample release · 98%'
                    )
                  ]
                )
              )
            );
          when Editor.Msg.Lookup(_):
            await Post(
              App.Msg.TagEditor(
                Editor.Msg.RecordingReady(
                  I.ImmutableDictionary of (string, string).Empty.Add(
                    'recording',
                    '11111111-1111-1111-1111-111111111111'
                  ).Add('title', 'A corrected recording').Add('artist', 'Mara Vale').Add(
                    Fields.Custom + 'MusicBrainz Artist Id',
                    '33333333-3333-3333-3333-333333333333'
                  )
                )
              )
            );
            await Post(
              App.Msg.TagEditor(Editor.Msg.Timer(new Pacing.Status(true, 4L), new Pacing.Status()))
            );
            await Post(
              App.Msg.TagEditor(
                Editor.Msg.ReleaseFailed(
                  'HTTP/1.1 503 Service Unavailable · GET /ws/2/release/fixture · attempt 6/6'
                )
              )
            );
          else
        end case;
      end function,
      function(Error: Sys.Exception): App.Msg => App.Msg.TagEditor(
        Editor.Msg.RequestFailed(Error.Message)
      )
    )
  );
end function;

procedure Exercise(Store: Library.Session; Path: string);
  procedure Step(Session: Gui.Session of App.Msg);
  begin
    discard Window.TryWake();
    X.Assert.True(Session.Step());
  end procedure;
  procedure Inject();
  begin
    Window.MovePointer(XPos, YPos);
    if Left >= 0 then
      Window.SetLeftButton(Left = 1);
      Left := -1;
    end if;

    if Wheel <> 0.0F then
      Window.Wheel(Wheel);
      Wheel := 0.0F;
    end if;

    if Typed <> '' then
      Window.InputText(Typed);
      Typed := '';
    end if;
  end procedure;
  procedure Click(Session: Gui.Session of App.Msg; Bounds: Cui.CuiRectangle);
  begin
    XPos := Bounds.X + Bounds.Width / 2.0F;
    YPos := Bounds.Y + Bounds.Height / 2.0F;
    Step(Session);
    Left := 1;
    Step(Session);
    Left := 0;
    Step(Session);
    Step(Session);
  end procedure;
  function State(): Editor.State;
  begin
    const Draft: Editor.State? := Current.TagEditor;
    if Draft = null then
      raise new Sys.InvalidOperationException('Tag editor is closed.');
    end if;

    return Draft;
  end function;
  procedure Deliver(Session: Gui.Session of App.Msg; Replies: Channels.ChannelReader of Effects.Reply of App.Msg);
  begin
    const Reply: Effects.Reply of App.Msg := Replies.ReadAsync(
      Stop.Token
    ).AsTask().GetAwaiter().GetResult();
    Reply.Release().WaitAsync(Stop.Token).GetAwaiter().GetResult();
    Step(Session);
  end procedure;
begin
  using const Stop: T.CancellationTokenSource := new T.CancellationTokenSource(20000);
  const Stage: Metadata.Session := Fixture.Tags(Store);
  const Songs: I.ImmutableArray of Tracks.Entry := Fixture.Until(
    Stage,
    function(Rows: I.ImmutableArray of Tracks.Entry): bool => Rows.Length = 1 and Rows[
      0
    ].TrackId <> ''
  ).GetAwaiter().GetResult();
  const Track: Tracks.Entry := Songs[0];
  const Gate: Effects.Effects of App.Msg := (Effects.Effects of App.Msg).Create();
  const Reads: Channels.ChannelReader of Effects.Reply of App.Msg := Gate.Watch('songs/observe');
  const Loaded: Channels.ChannelReader of Effects.Reply of App.Msg := Gate.Watch('tag-editor/load');
  const Saved: Channels.ChannelReader of Effects.Reply of App.Msg := Gate.Watch('tag-editor/save');
  using const Device: Audio.Session := new Audio.Session(true);
  const Port: Playback.Connection := Playback.Connection.Create(Device);
  var Current: App.State := new App.State(
    new Settings.State(
      new Settings.Preferences(
        [], 'light', 'blue',
        AcoustId := new Settings.AcoustIdKeys(ApplicationKey := 'fixture-app-key')
      )
    )
  );
  var XPos: float := -1.0F;
  var YPos: float := -1.0F;
  var Left: int := -1;
  var Wheel: float := 0.0F;
  var Typed: string := '';
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Edit tags',
    1540,
    860,
    Cui.CuiRenderer.Software,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of App.Msg := Host.StartThemed of (App.State, App.Msg)(
    Current,
    function(Model: App.State; Message: App.Msg): Mvu.Transition of (App.State, App.Msg) begin
      const Next: Mvu.Transition of (App.State, App.Msg) := Controller.Apply(
        Model, Message, procedure(_Value: Settings.Preferences) begin end procedure, Store, Port
      );
      Current := Next.Model;
      case Message of
        when App.Msg.TagEditor(const Action: Editor.Msg):
          for Index: int := 0 to Next.Commands.Length - 1 do
            case Next.Commands[Index] of
              when Mvu.Command.Start(const Id: string, _):
                if Id = 'tag-editor/provider' then
                  Next.Commands[Index] := ProviderFixture(Action, Id);
                end if;
              else
            end case;
          end for;
        else
      end case;

      return Gate.Wrap of App.State(Next);
    end function, Shell.View, Window, 128, Inject, App.Theme(Current, null), App.Theme, false
  );
  discard Session.Post(App.Msg.WatchLibrary);
  Step(Session);
  Deliver(Session, Reads);
  const Menu: string := 'track-menu-' + Track.FileId.ToString();
  Click(Session, Control(Session, Menu).Bounds);
  Step(Session);
  X.Assert.Equal of string('Edit tags', Control(Session, Menu + '/edit-tags').Text);
  Click(Session, Control(Session, Menu + '/edit-tags').Bounds);
  X.Assert.Contains of string('Reading tags…', Session.Snapshot().Text);
  Deliver(Session, Loaded);
  const Scan: Channels.ChannelReader of Effects.Reply of App.Msg := Gate.Watch(
    'tag-editor/provider'
  );
  X.Assert.True(Control(Session, 'tag-scan').Enabled);
  Click(Session, Control(Session, 'tag-scan').Bounds);
  X.Assert.False(Control(Session, 'tag-scan').Enabled);
  X.Assert.False(Control(Session, 'tag-search').Enabled);
  X.Assert.False(Control(Session, 'tag-match').Enabled);
  X.Assert.Contains of string('Waiting for AcoustID…', Session.Snapshot().Text);
  Deliver(Session, Scan);
  X.Assert.True(Control(Session, 'tag-search').Enabled);
  X.Assert.True(Control(Session, 'tag-match').Enabled);
  const Lookup: Channels.ChannelReader of Effects.Reply of App.Msg := Gate.Watch(
    'tag-editor/provider'
  );
  discard Session.Post(App.Msg.TagEditor(Editor.Msg.Lookup(0)));
  Step(Session);
  X.Assert.False(Control(Session, 'tag-match').Enabled);
  X.Assert.DoesNotContain of string('A corrected recording', Session.Snapshot().Text);
  Deliver(Session, Lookup);
  X.Assert.Equal of string('A corrected recording', Control(Session, 'tag-take-title').Text);
  X.Assert.False(Control(Session, 'tag-match').Enabled);
  Click(Session, Control(Session, 'tag-take-title').Bounds);
  Capture(Session, 'tag-editor-track.png');
  if Sys.Environment.GetEnvironmentVariable('FPAS_AMP_UI_ARTIFACTS') <> null then
    Click(Session, Control(Session, 'tag-tabs', '3').Bounds);
    Capture(Session, 'tag-editor-custom.png');
    Click(Session, Control(Session, 'tag-tabs', '0').Bounds);
  end if;

  Deliver(Session, Lookup);
  X.Assert.Contains of string('MusicBrainz · next request in 4 s', Session.Snapshot().Text);
  X.Assert.False(Control(Session, 'tag-search').Enabled);
  X.Assert.Equal of string('A corrected recording', Control(Session, 'tag-take-title').Text);
  Deliver(Session, Lookup);
  X.Assert.Contains of string(
    'Could not load the release. Recording details are available.',
    Session.Snapshot().Text
  );
  X.Assert.Contains of string(
    'HTTP/1.1 503 Service Unavailable · GET /ws/2/release/fixture · attempt 6/6',
    Session.Snapshot().Text
  );
  X.Assert.Equal of string('A corrected recording', Control(Session, 'tag-take-title').Text);
  X.Assert.True(State().Selected.Contains('title'));
  Click(Session, Control(Session, 'tag-tabs', '3').Bounds);
  X.Assert.Equal of int(50, State().Extra.Length);
  const Add: Cui.CuiRectangle := Control(Session, 'custom-add').Bounds;
  const Save: Cui.CuiRectangle := Control(Session, 'tag-save').Bounds;
  const First: Cui.CuiRectangle := Control(Session, 'custom-name-0').Bounds;
  XPos := First.X + First.Width / 2.0F;
  YPos := First.Y + First.Height / 2.0F;
  Step(Session);
  Wheel := -12.0F;
  Step(Session);
  Step(Session);
  X.Assert.True(Control(Session, 'custom-name-0').Bounds.Y < First.Y);
  X.Assert.Equal of float(Add.Y, Control(Session, 'custom-add').Bounds.Y);
  X.Assert.Equal of float(Save.Y, Control(Session, 'tag-save').Bounds.Y);
  Click(Session, Add);
  X.Assert.Equal of int(51, State().Extra.Length);
  Step(Session);
  Typed := 'ADDED_TAG';
  Step(Session);
  Step(Session);
  X.Assert.Equal of string('ADDED_TAG', State().Extra[50].Name);
  const Last: Cui.CuiRectangle := Control(Session, 'custom-value-50').Bounds;
  X.Assert.True(Last.Y > Add.Y and Last.Y < Save.Y);
  Click(Session, Last);
  Typed := 'Last value';
  Step(Session);
  Step(Session);
  const ArtistId: string := Fields.Custom + 'MusicBrainz Artist Id';
  Click(Session, Control(Session, 'custom-new-' + ArtistId).Bounds);
  X.Assert.True(State().Selected.Contains(ArtistId));
  Click(Session, Save);
  X.Assert.False(Control(Session, 'tag-save').Enabled);
  Deliver(Session, Saved);
  X.Assert.Null(Current.TagEditor);
  const Updated: Files.Snapshot := Stage.ReadTags(Track, Stop.Token).GetAwaiter().GetResult();
  X.Assert.Equal of string('Last value', Fields.Value(Updated.Values, Fields.Custom + 'ADDED_TAG'));
  X.Assert.Equal of string('A corrected recording', Fields.Value(Updated.Values, 'title'));
  X.Assert.Equal of string(
    '33333333-3333-3333-3333-333333333333',
    Fields.Value(Updated.Values, ArtistId)
  );
  X.Assert.False(Files.Read(Path).Values.ContainsKey(Fields.Custom + 'ADDED_TAG'));

  discard Session.Post(
    App.Msg.Settings(Settings.Msg.EditAcoustIdKey(Settings.AcoustIdKey.Application, ''))
  );
  discard Session.Post(App.Msg.Settings(Settings.Msg.SaveAcoustIdKeys));
  Step(Session);
  const Reopened: Channels.ChannelReader of Effects.Reply of App.Msg := Gate.Watch(
    'tag-editor/load'
  );
  discard Session.Post(App.Msg.TagEditor(Editor.Msg.Open(Track)));
  Step(Session);
  Deliver(Session, Reopened);
  X.Assert.False(Control(Session, 'tag-scan').Enabled);
  X.Assert.True(Control(Session, 'tag-search').Enabled);
end procedure;

// Verifies native scrolling and focus inside the tag editor.
public type NativeTagEditorTests = record
  // The row menu opens the editor. Fifty rows scroll inside the pinned header and footer.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure FiftyRowsScrollAndAddFocusesTheNewName();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'editor.mp3');
    IO.File.Copy(IO.Path.Combine(Sys.AppContext.BaseDirectory, 'Fixtures', 'silence.mp3'), Path);
    const File: Atl.Track := new Atl.Track(Path);
    File.Title := 'Blue Hour';
    File.Artist := 'Mara Vale';
    File.Album := 'North Pier Sessions';
    const Extra: C.IDictionary of (string?, string?)? := File.AdditionalFields;
    if Extra = null then
      raise new Sys.InvalidOperationException('Missing fixture tags.');
    end if;

    Extra.Clear();
    for Index: int := 1 to 50 do
      Extra['FIELD_' + Index.ToString('D3')] := 'Value ' + Index.ToString();
    end for;

    X.Assert.True(File.Save());
    const Store: Library.Session := Fixture.Start([Fixture.Source(Root.Path)], Data.Path);
    try
      Exercise(Store, Path);
    finally
      Store.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;
end record;

end unit;
