// [Documentation](../../../doc/desktop.md#browsing-music-and-collections)

// Exercises all three levels against scanned media, persistent ratings and native controls.
unit FpasAmp.UiTests.NativeCollections;

uses Fpas.Ui.Gui.Cui as Cui;

uses FpasAmp.Library.Albums.Model as Catalog;
uses FpasAmp.Library.Inventory.Monitoring as Monitor;
uses FpasAmp.Library.Tests.MetadataSupport as Sources;
uses FpasAmp.Library.Tests.Support as H;
uses FpasAmp.Media.Audio as Audio;
uses FpasAmp.Ui.Albums.Model as Albums;
uses FpasAmp.Ui.Albums.Music.Model as Music;
uses FpasAmp.Ui.Albums.Toolbar.Model as Toolbar;
uses FpasAmp.Ui.App.Model as App;
uses FpasAmp.Ui.Navigation.Model as Nav;
uses FpasAmp.Ui.Settings.Model as Settings;
uses FpasAmp.Ui.Shell as Shell;
uses FpasAmp.UiTests.CollectionFixture as Fixture;
uses System as Sys;
uses Xunit as X;

procedure Send(Session: Shell.Session; Message: Albums.Msg);
begin
  discard Session.Window.Post(App.Msg.Albums(Message));
  Fixture.Pump(Session);
end procedure;

// Artist grid, release grid and track table share the same native shell.
public type CollectionNavigationTests = record
  // Checks cover fallback, scoped filtering, independent stars, routes and both Back actions.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure ArtistAlbumsAndTracks();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    Fixture.Seed(Root.Path);
    const Library: Monitor.Session := Sources.Start([Sources.Source(Root.Path)], Data.Path);
    try
      var Placement: Cui.CuiWindowPlacement := new Cui.CuiWindowPlacement();
      Placement.Width := 1320;
      Placement.Height := 900;
      const Person: string := Catalog.ArtistId('Aster Vale');
      using const Session: Shell.Session := Shell.Session.Start(
        Placement,
        new Settings.Preferences([Sources.Source(Root.Path)], 'light'),
        procedure(_Value: Settings.Preferences) begin end procedure, Library,
        new Nav.State(Active := Nav.Route.Page(Nav.Page.Artists)), Output := new Audio.Session(true)
      );
      Fixture.Until(
        Session,
        function(): bool => Session.State().Albums.Items.Length = 6
          and Session.State().Albums.Images.Count = 6 and Fixture.Has(Session, 'cover-' + Person),
        'Artist covers did not load.'
      );
      Send(Session, Albums.Msg.Rate(Person, 8));
      Fixture.Until(
        Session,
        function(): bool => Session.State().Albums.Shown[0].Rating = 8,
        'Artist rating was not saved.'
      );
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.SetOpen(true)));
      Fixture.Until(
        Session,
        function(): bool => Fixture.Has(Session, 'album-filter-genre'),
        'Artist filters did not open.'
      );
      X.Assert.False(Fixture.Has(Session, 'album-filter-artist'));
      Fixture.Capture(Session, 'artists-filter');
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.MinimumRating(7)));
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.Apply));
      X.Assert.Equal of int(1, Session.State().Albums.Shown.Length);
      Send(Session, Albums.Msg.OpenGroup(Person));
      Fixture.Until(
        Session,
        function(): bool => Session.State().Albums.Images.Count = 4,
        'Discography covers did not load.'
      );
      X.Assert.Equal of int(4, Session.State().Albums.Shown.Length);
      X.Assert.Equal of string('Blue Hour', Session.State().Albums.Shown[1].Title);
      const Release: string := Session.State().Albums.Shown[1].Id;
      X.Assert.Null(Session.State().Albums.Images[Session.State().Albums.Shown[0].Id]);
      X.Assert.NotNull(Session.State().Albums.Images[Release]);
      X.Assert.Null(Session.State().Albums.Shown[1].Rating);
      Send(Session, Albums.Msg.Rate(Release, 9));
      Fixture.Until(
        Session,
        function(): bool => Session.State().Albums.Shown[1].Rating = 9,
        'Album rating was not saved.'
      );
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.SetOpen(true)));
      Fixture.Until(
        Session,
        function(): bool => Fixture.Has(Session, 'album-filter-genre'),
        'Album filters did not open.'
      );
      X.Assert.False(Fixture.Has(Session, 'album-filter-artist'));
      X.Assert.True(Fixture.Has(Session, 'artists-back'));
      Fixture.Capture(Session, 'artist-albums-filter');
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.MinimumRating(9)));
      Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.Apply));
      X.Assert.Equal of int(1, Session.State().Albums.Shown.Length);
      Send(Session, Albums.Msg.OpenMusic(Release));
      Fixture.Until(
        Session, function(): bool begin
          const Page: Music.State? := Session.State().Albums.Music;
          return Page <> null and Page.Loaded and Page.Shown.Length = 6;
        end function, 'Tracks did not load.'
      );
      const Route: Nav.Route := Session.State().Navigation.Active;
      X.Assert.Equal of Nav.Route(Nav.Route.ArtistAlbum(Person, Release), Route);
      X.Assert.Equal of Nav.Route? (Route, Nav.Parse(Nav.Key(Route)));
      Send(Session, Albums.Msg.Music(Music.Msg.ShowFilters(true)));
      Fixture.Until(
        Session,
        function(): bool => Fixture.Has(Session, 'track-filter-genre'),
        'Track filters did not open.'
      );
      Fixture.Capture(Session, 'artist-tracks-filter');
      Send(Session, Albums.Msg.BackToAlbums);
      X.Assert.Equal of Nav.Route(Nav.Route.Artist(Person), Session.State().Navigation.Active);
      X.Assert.Equal of int(9, Session.State().Albums.Toolbar.Applied.MinimumRating);
      Send(Session, Albums.Msg.BackToGroups);
      X.Assert.Equal of Nav.Route(
        Nav.Route.Page(Nav.Page.Artists),
        Session.State().Navigation.Active
      );
      X.Assert.Equal of int(7, Session.State().Albums.Toolbar.Applied.MinimumRating);
      X.Assert.Equal of int? (8, Session.State().Albums.Shown[0].Rating);
    finally
      Library.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;

  // Validates mixed tags, independent ratings, filtered queues and restoration of the genre route.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure GenreAlbumsAndTracks();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    Fixture.Seed(Root.Path);
    const Library: Monitor.Session := Sources.Start([Sources.Source(Root.Path)], Data.Path);
    try
      var Placement: Cui.CuiWindowPlacement := new Cui.CuiWindowPlacement();
      Placement.Width := 1320;
      Placement.Height := 900;
      const Preferences: Settings.Preferences := new Settings.Preferences(
        [Sources.Source(Root.Path)],
        'light'
      );
      const Save: procedure(Settings.Preferences) := procedure(_Value: Settings.Preferences) begin end procedure;
      const Jazz: string := Catalog.GenreId('Jazz');
      var RouteKey: string := '';
      begin
        using const Session: Shell.Session := Shell.Session.Start(
          Placement,
          Preferences,
          Save,
          Library,
          new Nav.State(Active := Nav.Route.Page(Nav.Page.Genres)),
          Output := new Audio.Session(true)
        );
        Fixture.Until(
          Session,
          function(): bool => Session.State().Albums.Items.Length = 5
            and Session.State().Albums.Images.Count = 5 and Fixture.Has(Session, 'cover-' + Jazz),
          'Genre covers did not load.'
        );
        X.Assert.True(Fixture.Has(Session, 'cover-' + Catalog.GenreId('Folk')));
        Send(Session, Albums.Msg.Rate(Jazz, 8));
        Fixture.Until(
          Session,
          function(): bool => Session.State().Albums.Shown[2].Rating = 8,
          'Genre rating was not saved.'
        );
        X.Assert.Equal of string('Jazz', Session.State().Albums.Shown[2].Title);
        X.Assert.Equal of long(8L, Session.State().Albums.Shown[2].Tracks);
        Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.SetOpen(true)));
        Fixture.Until(
          Session,
          function(): bool => Fixture.Has(Session, 'album-filter-rating'),
          'Genre filter did not open.'
        );
        X.Assert.False(Fixture.Has(Session, 'album-filter-genre'));
        X.Assert.False(Fixture.Has(Session, 'album-filter-artist'));
        Fixture.Capture(Session, 'genres-filter', 'genres');
        Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.MinimumRating(8)));
        Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.Apply));
        X.Assert.Equal of int(1, Session.State().Albums.Shown.Length);
        Send(Session, Albums.Msg.OpenGroup(Jazz));
        Fixture.Until(
          Session,
          function(): bool => Session.State().Albums.Images.Count = 3,
          'Genre albums did not load.'
        );
        X.Assert.Equal of int(3, Session.State().Albums.Items.Length);
        const Album: Catalog.Album := Session.State().Albums.Shown[0];
        X.Assert.Equal of string('Blue Hour', Album.Title);
        X.Assert.Equal of long(4L, Album.Tracks);
        X.Assert.Null(Album.Rating);
        Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.SetOpen(true)));
        Fixture.Until(
          Session,
          function(): bool => Fixture.Has(Session, 'album-filter-artist'),
          'Album artist filter did not open.'
        );
        X.Assert.False(Fixture.Has(Session, 'album-filter-genre'));
        X.Assert.True(Fixture.Has(Session, 'genres-back'));
        Fixture.Capture(Session, 'genre-albums-filter', 'genres');
        Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.Artist('Aster Vale')));
        Send(Session, Albums.Msg.Toolbar(Toolbar.Msg.Apply));
        X.Assert.Equal of int(2, Session.State().Albums.Shown.Length);
        Send(Session, Albums.Msg.OpenMusic(Album.Id));
        Fixture.Until(
          Session, function(): bool begin
            const Page: Music.State? := Session.State().Albums.Music;
            return Page <> null and Page.Loaded and Page.Shown.Length = 4;
          end function, 'Mixed album must show exactly its four jazz tracks.'
        );
        RouteKey := Nav.Key(Session.State().Navigation.Active);
        X.Assert.Equal of Nav.Route? (Nav.Route.GenreAlbum(Jazz, Album.Id), Nav.Parse(RouteKey));
        Send(Session, Albums.Msg.Music(Music.Msg.ShowFilters(true)));
        Fixture.Until(
          Session,
          function(): bool => Fixture.Has(Session, 'track-filter-rating'),
          'Track filter did not open.'
        );
        X.Assert.False(Fixture.Has(Session, 'track-filter-genre'));
        Fixture.Capture(Session, 'genre-tracks-filter', 'genres');
        Send(Session, Albums.Msg.Music(Music.Msg.Reset));
        Send(Session, Albums.Msg.Music(Music.Msg.ApplyFilters));
        const Page: Music.State? := Session.State().Albums.Music;
        if Page = null then
          raise new Sys.InvalidOperationException('Expected the filtered album.');
        end if;

        Send(Session, Albums.Msg.Music(Music.Msg.Play(Page.Shown[0].FileId)));
        X.Assert.Equal of int(4, Session.State().Player.Queue.Length);
        X.Assert.Equal of string(['Jazz'], Session.State().Player.Source.Genres);
        Send(Session, Albums.Msg.BackToAlbums);
        X.Assert.Equal of string('Aster Vale', Session.State().Albums.Toolbar.Applied.Artist);
        Send(Session, Albums.Msg.BackToGroups);
        X.Assert.Equal of int(8, Session.State().Albums.Toolbar.Applied.MinimumRating);
        discard Session.Window.Post(
          App.Msg.Navigation(Nav.Msg.Select(Nav.Route.Page(Nav.Page.Albums)))
        );
        Fixture.Pump(Session);
        Send(Session, Albums.Msg.OpenMusic(Album.Id));
        Fixture.Until(
          Session, function(): bool begin
            const Page: Music.State? := Session.State().Albums.Music;
            return Page <> null and Page.Loaded and Page.Shown.Length = 6;
          end function, 'Global Albums must still show all six tracks.'
        );
      end;

      using const Reopened: Shell.Session := Shell.Session.Start(
        Placement,
        Preferences,
        Save,
        Library,
        new Nav.State(Active := Nav.Parse(RouteKey) ?? Nav.Route.Page(Nav.Page.Music)),
        Output := new Audio.Session(true)
      );
      Fixture.Until(
        Reopened, function(): bool begin
          const Page: Music.State? := Reopened.State().Albums.Music;
          return Page <> null and Page.Loaded and Page.Shown.Length = 4;
        end function, 'The restored genre album lost its scope.'
      );
      Send(Reopened, Albums.Msg.BackToAlbums);
      Send(Reopened, Albums.Msg.BackToGroups);
      X.Assert.Equal of int? (8, Reopened.State().Albums.Shown[2].Rating);
    finally
      Library.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;
end record;

end unit;
