<Project>
  <PropertyGroup>
    <_FpcalcRid>$(RuntimeIdentifier)</_FpcalcRid>
    <_FpcalcRid Condition="'$(_FpcalcRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_FpcalcRid>
    <_FpcalcDir>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'fpcalc', '1.6.2'))</_FpcalcDir>
    <_FpcalcRelease>https://github.com/acoustid/chromaprint/releases/download/v1.6.2</_FpcalcRelease>
    <_FpcalcPlatform Condition="'$(_FpcalcRid)' == 'win-x64'">windows-x86_64</_FpcalcPlatform>
    <_FpcalcPlatform Condition="'$(_FpcalcRid)' == 'linux-x64'">linux-x86_64</_FpcalcPlatform>
    <_FpcalcName Condition="'$(_FpcalcRid)' == 'win-x64'">fpcalc.exe</_FpcalcName>
    <_FpcalcName Condition="'$(_FpcalcRid)' == 'linux-x64'">fpcalc</_FpcalcName>
    <_FpcalcStem>chromaprint-fpcalc-1.6.2-$(_FpcalcPlatform)</_FpcalcStem>
    <_FpcalcBinary>$(_FpcalcDir)/$(_FpcalcStem)/$(_FpcalcName)</_FpcalcBinary>
  </PropertyGroup>
  <ItemGroup Condition="'$(_FpcalcPlatform)' != ''">
    <_FpcalcArchive Include="chromaprint-1.6.2.tar.gz" Url="$(_FpcalcRelease)/chromaprint-1.6.2.tar.gz" Hash="D54ADA62C16B2DB396D3251EC54FC7A58909C163131A1CFCF7FA6407DBC14360" />
    <_FpcalcArchive Include="ffmpeg-8.0.tar.xz" Url="https://ffmpeg.org/releases/ffmpeg-8.0.tar.xz" Hash="B2751FCCB6CC4C77708113CD78B561059B6FA904B24162FA0BE2D60273D27B8E" />
    <_FpcalcArchive Include="ffmpeg-build-8.0-1.tar.gz" Url="https://codeload.github.com/acoustid/ffmpeg-build/tar.gz/refs/tags/v8.0-1" Hash="2533F000CC9D4EA72E5108C95BF2CC59770FA076AD8D4147E66FF5C16E42DE14" />
    <Content Include="@(_FpcalcArchive->'$(_FpcalcDir)/%(Identity)')" Link="licenses/chromaprint/sources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
    <_FpcalcArchive Include="$(_FpcalcStem).zip" Condition="'$(_FpcalcRid)' == 'win-x64'" Url="$(_FpcalcRelease)/$(_FpcalcStem).zip" Hash="B74369726676670AF3AB0EADFF45F960CF969FDF4A87A971BA37EAF8D530E874" />
    <_FpcalcArchive Include="$(_FpcalcStem).tar.gz" Condition="'$(_FpcalcRid)' == 'linux-x64'" Url="$(_FpcalcRelease)/$(_FpcalcStem).tar.gz" Hash="C968AD4A0821592A79B158FB2E1F46CBE0A22A0A1DBC0743C67D68E75D15D2BB" />
    <Content Include="$(_FpcalcBinary)" Link="tools/chromaprint/$(_FpcalcName)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)*.md;$(MSBuildThisFileDirectory)*.txt" Link="licenses/chromaprint/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PrepareFpcalc" BeforeTargets="PrepareForBuild" Condition="'$(_FpcalcPlatform)' != ''" Inputs="$(MSBuildThisFileFullPath);@(_FpcalcArchive->'$(_FpcalcDir)/%(Identity)');$(_FpcalcBinary)" Outputs="$(_FpcalcBinary).verified">
    <MakeDir Directories="$(_FpcalcDir)" />
    <DownloadFile SourceUrl="%(_FpcalcArchive.Url)" DestinationFolder="$(_FpcalcDir)" DestinationFileName="%(_FpcalcArchive.Identity)" Condition="!Exists('$(_FpcalcDir)/%(_FpcalcArchive.Identity)')" />
    <VerifyFileHash File="$(_FpcalcDir)/%(_FpcalcArchive.Identity)" Hash="%(_FpcalcArchive.Hash)" Algorithm="SHA256" />
    <Unzip SourceFiles="$(_FpcalcDir)/$(_FpcalcStem).zip" DestinationFolder="$(_FpcalcDir)" Condition="'$(_FpcalcRid)' == 'win-x64'" />
    <Exec Command="tar -xzf &quot;$(_FpcalcDir)/$(_FpcalcStem).tar.gz&quot; -C &quot;$(_FpcalcDir)&quot;" Condition="'$(_FpcalcRid)' == 'linux-x64'" />
    <Touch Files="$(_FpcalcBinary).verified" AlwaysCreate="true" />
  </Target>
</Project>
