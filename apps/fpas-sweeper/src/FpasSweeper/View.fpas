// [Documentation](../../doc/README.md#desktop-ui)

unit FpasSweeper.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as Styles;
uses Fpas.Ui.Widgets.Actions.Buttons as Buttons;
uses Fpas.Ui.Widgets.Actions.SegmentedControls as Segments;
uses Fpas.Ui.Widgets.Charts.Metrics as Metrics;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Inputs.NumberFields as Numbers;
uses Fpas.Ui.Widgets.Theming.ThemeSwitchers as Appearance;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses FpasSweeper.BoardView as Board;
uses FpasSweeper.Game as Game;
uses FpasSweeper.State as S;
uses System.Globalization as Culture;

const Margin: int := 24;
const PaneGap: int := 24;
const SettingsWidth: int := 392;

function Space(Units: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Units));
end function;

function Fixed(Units: int): L.Extent;
begin
  return L.Extent.Fixed(L.Measure.Logical(Units));
end function;

function ClockText(Model: S.Model): string;
begin
  if Model.ClockFailed then
    return 'Unavailable';
  end if;
  const Minutes: long := Model.Elapsed div 60L;
  const Seconds: long := Model.Elapsed mod 60L;
  const Format: Culture.CultureInfo := Culture.CultureInfo.InvariantCulture;
  return Minutes.ToString('00', Format) + ':' + Seconds.ToString('00', Format);
end function;

function Dimension(
  Id: string;
  Name: string;
  Value: int;
  Change: function(double): S.Msg
): E.Element of S.Msg;
begin
  const Field: E.Element of S.Msg := Numbers.NumberField of S.Msg(
    Id, cast Value as double,
    cast Game.MinimumSide as double, cast Game.MaximumSide as double, Change,
    new Numbers.Options(Width := L.Extent.Fill)
  );
  return E.Size of S.Msg(
    E.Column of S.Msg(
      new L.Flow(Gap := Space(5)),
      Texts.Text of S.Msg(Name, Texts.Appearance.Secondary),
      Field
    ),
    new L.Flex(Width := new L.AxisSize(Basis := L.Extent.Fill))
  );
end function;

function SizeControls(Model: S.Model): E.Element of S.Msg;
begin
  return E.Row of S.Msg(
    new L.Flow(Gap := Space(10), Align := L.Alignment.Stretch),
    Dimension(
      'board-width',
      'Width',
      Model.CustomWidth,
      function(Value: double): S.Msg => S.Msg.Width(cast Value as int)
    ),
    Dimension(
      'board-height',
      'Height',
      Model.CustomHeight,
      function(Value: double): S.Msg => S.Msg.Height(cast Value as int)
    )
  );
end function;

function Difficulty(Model: S.Model): E.Element of S.Msg;
begin
  const Select: E.Element of S.Msg := Segments.SegmentedControl of S.Msg(
    'difficulty',
    [
      new Segments.Item('Easy'),
      new Segments.Item('Medium'),
      new Segments.Item('Hard'),
      new Segments.Item('Custom')
    ],
    Model.Difficulty, S.Msg.Difficulty, new Segments.Options(FullWidth := true)
  );
  const Title: E.Element of S.Msg := Texts.Text of S.Msg('Difficulty', Texts.Appearance.Label);
  const Flow: L.Flow := new L.Flow(Gap := Space(9));
  if Model.Difficulty = 3 then
    return E.Column of S.Msg(Flow, Title, Select, SizeControls(Model));
  end if;

  return E.Column of S.Msg(Flow, Title, Select);
end function;

function Status(Model: S.Model): string;
begin
  return case Model.Board.State of
    when Game.Phase.Won: 'You cleared the board!';
    when Game.Phase.Lost: 'Mine hit. Start a new game to try again.';
    else 'Left-click to reveal. Right-click to flag.';
  end case;
end function;

function Settings(Model: S.Model): E.Element of S.Msg;
begin
  const MinesLeft: int := if Model.Board.State = Game.Phase.Won then
    0
  else
    Model.Board.MineCount - Model.Board.FlagCount
  end if;
  return Cards.Card of S.Msg(
    'settings',
    [
      E.Row of S.Msg(
        new L.Flow(Gap := Space(10), Align := L.Alignment.Stretch),
        Metrics.Metric of S.Msg('time', 'Time', ClockText(Model)),
        Metrics.Metric of S.Msg('mines', 'Mines left', MinesLeft.ToString())
      ),
      E.Divider of S.Msg(),
      Difficulty(Model),
      Buttons.Button of S.Msg(
        'new-game', 'New game', S.Msg.NewGame,
        new Buttons.Options(
          Variant := Styles.ButtonVariant.Primary,
          ControlSize := Buttons.Size.Large,
          Width := L.Extent.Fill
        )
      ),
      Texts.Text of S.Msg(Status(Model), Texts.Appearance.Muted),
      E.Divider of S.Msg(),
      E.Row of S.Msg(
        new L.Flow(Gap := Space(10), Justify := L.Justification.Between),
        Texts.Text of S.Msg('Appearance', Texts.Appearance.Label),
        Appearance.ThemeSwitcher of S.Msg('appearance', Model.Theme, S.Msg.Theme)
      )
    ],
    new Cards.Options(
      Width := Fixed(SettingsWidth),
      Padding := 18.0F,
      Gap := 17.0F,
      Align := L.Alignment.Stretch
    )
  );
end function;

// Resolves the selected light or dark CUI palette.
// ## Parameters
// - `Model`: The current appearance selection.
// - `SystemAppearance`: The optional native appearance.
// ## Returns
// A palette shared by the controls and board.
public function ThemeFor(Model: S.Model; SystemAppearance: Themes.Mode?): Themes.Theme;
begin
  const Mode: Themes.Mode := Appearance.Resolve(Model.Theme, SystemAppearance ?? Themes.Mode.Light);
  return if Mode = Themes.Mode.Dark then
    Themes.Dark(Themes.Accent.Amber)
  else
    Themes.Light(Themes.Accent.Amber)
  end if;
end function;

// Builds the two-pane game screen.
// ## Parameters
// - `Model`: The current round and settings.
// - `_Viewport`: The host's responsive dimensions. CUI sizes the panes.
// - `_Theme`: The active theme, applied by the host.
// ## Returns
// Board, statistics and settings controls.
public function Build(
  Model: S.Model;
  _Viewport: L.Viewport;
  _Theme: Themes.Theme
): E.Element of S.Msg;
begin
  const FillHeight: L.Flex := new L.Flex(Height := new L.AxisSize(Basis := L.Extent.Fill));
  return E.Size of S.Msg(
    E.Column of S.Msg(
      new L.Flow(Gap := Space(18), Padding := Space(Margin)),
      Texts.Text of S.Msg('FPas-Sweeper', Texts.Appearance.HeadingOne),
      E.Size of S.Msg(
        E.Row of S.Msg(
          new L.Flow(Gap := Space(PaneGap), Align := L.Alignment.Start),
          Board.Build(Model), Settings(Model)
        ),
        FillHeight
      )
    ),
    FillHeight
  );
end function;

end unit;
