// [Documentation](README.md)

unit GuiDocCaptures.Charts;

uses
  GuiDocCaptures.Regions as Regions, GuiGallery.App.State as Gallery,
  Fpas.Ui.Gui.Application as Gui;

procedure Shot(Session: Gui.Session<Gallery.Msg>; Output: string; Name: string; params Ids: array of string);
begin
  Regions.Capture(Session, Output, Name, new Regions.Insets(), Ids);
end procedure;

// Captures the chart widgets and their variants on the Charts page.
// ## Parameters
// - `Session`: Gallery session on Charts.
// - `Output`: Directory for full-frame images and crop bounds.
public procedure CaptureCharts(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Shot(Session, Output, 'line-chart', 'revenue');
  Shot(Session, Output, 'line-chart-dither', 'requests');
  Shot(Session, Output, 'bar-chart', 'visits');
  Shot(Session, Output, 'bar-chart-stacked', 'runs');
  Shot(Session, Output, 'donut-chart', 'platforms');
  Shot(Session, Output, 'pattern-meter', 'storage');
  Shot(Session, Output, 'gauge', 'cpu', 'memory');
  Shot(Session, Output, 'sparkline', 'chart-sparkline');
end procedure;

// Captures the pattern meter after selecting the grayscale option.
// ## Parameters
// - `Session`: Gallery session on Charts with Grayscale selected.
// - `Output`: Directory for the full-frame image and crop bounds.
public procedure CaptureGrayscale(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Shot(Session, Output, 'pattern-meter-grayscale', 'storage', 'grayscale');
end procedure;

// Captures the visualizations at the top of More charts.
// ## Parameters
// - `Session`: Gallery session on More charts.
// - `Output`: Directory for full-frame images and crop bounds.
public procedure CaptureMoreChartsTop(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Shot(Session, Output, 'heatmap', 'traffic');
  Shot(Session, Output, 'calendar-heatmap', 'activity');
  Shot(Session, Output, 'treemap', 'bundle');
  Shot(Session, Output, 'radar-chart', 'radar');
  Shot(Session, Output, 'funnel', 'funnel');
  Shot(Session, Output, 'split-bar', 'split');
  Shot(Session, Output, 'waffle', 'waffle');
  Shot(Session, Output, 'sankey', 'flow');
end procedure;

// Captures the ranked charts and instruments at the bottom of More charts.
// ## Parameters
// - `Session`: Gallery session scrolled to the bottom of More charts.
// - `Output`: Directory for full-frame images and crop bounds.
public procedure CaptureMoreChartsBottom(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Shot(Session, Output, 'bar-list', 'pages', 'shuffle-pages');
  Shot(Session, Output, 'activity-rings', 'rings');
  Shot(Session, Output, 'scatter-chart', 'scatter');
  Shot(Session, Output, 'radial-gauge', 'cpu-radial', 'temp', 'mem');
  Shot(Session, Output, 'candlestick', 'price');
end procedure;

end unit;
