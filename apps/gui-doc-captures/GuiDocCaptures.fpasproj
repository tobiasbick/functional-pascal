<Project Sdk="Fpas.NET.Sdk/0.1.0-dev">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Gallery>../../examples/ui/gui/gallery</Gallery>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fpas.Ui.Gui/Fpas.Ui.Gui.fpasproj" />
    <Compile Include="$(Gallery)/**/*.fpas"
             Exclude="$(Gallery)/main.fpas;$(Gallery)/bin/**;$(Gallery)/obj/**" />
  </ItemGroup>
</Project>
