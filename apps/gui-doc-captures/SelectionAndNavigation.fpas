unit GuiDocCaptures.SelectionAndNavigation;

uses
  GuiDocCaptures.Regions as Regions, GuiGallery.App.State as Gallery,
  Fpas.Ui.Gui.Application as Gui;

procedure Shot(Session: Gui.Session<Gallery.Msg>; Output: string; Name: string; params Ids: array of string);
begin
  Regions.Capture(Session, Output, Name, new Regions.Insets(), Ids);
end procedure;

// Captures the Selection chapter's widgets from the presented gallery.
// ## Parameters
// - `Session`: Gallery session on the matching page.
// - `Output`: Directory for full-frame images and crop bounds.
public procedure CaptureSelection(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Shot(Session, Output, 'checkbox', 'newsletter', 'marketing', 'disabled-option');
  Shot(Session, Output, 'switch', 'wifi', 'bluetooth', 'airplane');
  Shot(Session, Output, 'radio-button', 'save-frequency/1');
  Shot(Session, Output, 'radio-group', 'save-frequency/0', 'save-frequency/1', 'save-frequency/2');
  Shot(Session, Output, 'radio-cards', 'places');
  Regions.Capture(
    Session,
    Output,
    'slider',
    new Regions.Insets(Top := 24),
    'volume',
    'brightness'
  );
  Regions.Capture(Session, Output, 'range-slider', new Regions.Insets(Top := 24), 'price-range');
  Shot(
    Session, Output, 'chip', 'category-design', 'category-engineering', 'category-marketing',
    'category-sales', 'category-support', 'category-finance'
  );
  Shot(Session, Output, 'rating', 'rating');
end procedure;

// Captures the Navigation chapter's widgets from the presented gallery.
// ## Parameters
// - `Session`: Gallery session on the matching page.
// - `Output`: Directory for full-frame images and crop bounds.
public procedure CaptureNavigation(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Regions.Capture(
    Session,
    Output,
    'sidebar',
    new Regions.Insets(Top := 24),
    'navigation/overview',
    'navigation/charts'
  );
  Regions.Capture(Session, Output, 'tabs', new Regions.Insets(Right := 240), 'tabs', 'pill-tabs');
  Shot(Session, Output, 'breadcrumb', 'breadcrumbs');
  Shot(Session, Output, 'pagination', 'pages');
  Shot(Session, Output, 'stepper', 'workflow-steps', 'step-back', 'step-next');
end procedure;

end unit;
