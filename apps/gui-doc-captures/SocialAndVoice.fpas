// [Documentation](README.md)

unit GuiDocCaptures.SocialAndVoice;

uses
  GuiDocCaptures.Regions as Regions, GuiDocCaptures.Presented as Presented,
  GuiGallery.App.State as Gallery, GuiGallery.Pages.Voice.State as Voice,
  Fpas.Ui.Widgets.Ai.Composers as Composer, Fpas.Ui.Gui.Application as Gui;

procedure Shot(Session: Gui.Session<Gallery.Msg>; Output: string; Name: string; params Ids: array of string);
begin
  Regions.Capture(Session, Output, Name, new Regions.Insets(), Ids);
end procedure;

procedure CaptureSocial(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Shot(
    Session,
    Output,
    'chat-message',
    'social-message-1',
    'social-message-2',
    'social-message-3',
    'social-message-4'
  );
  Shot(Session, Output, 'chat-divider', 'social-today');
  Shot(Session, Output, 'typing-indicator', 'social-typing');
  Shot(Session, Output, 'comment', 'social-comments');
  Shot(Session, Output, 'presence', 'social-presence');
  Shot(Session, Output, 'counter', 'social-revenue', 'social-sale');
  Shot(Session, Output, 'ticker', 'social-ticker');
  Shot(Session, Output, 'carousel', 'social-tour');
  Shot(Session, Output, 'image-viewer', 'social-viewer');
  Shot(Session, Output, 'image-cropper', 'social-crop');
  Shot(Session, Output, 'image-compare', 'social-compare');
  Shot(Session, Output, 'card-stack', 'social-deck');
end procedure;

procedure CaptureVoice(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Tick(6.5F)));
  Shot(Session, Output, 'composer', 'voice-composer');
  Shot(Session, Output, 'voice-session', 'voice-session-card');
  Shot(Session, Output, 'voice-waveform', 'voice-live', 'voice-clip');
  Shot(Session, Output, 'voice-orb', 'voice-orb');
  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Orb));
  Shot(Session, Output, 'voice-orb-listening', 'voice-orb');

  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Editor(Composer.Event.Record)));
  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Tick(1.0F)));
  Shot(Session, Output, 'composer-recording', 'voice-composer');
  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Editor(Composer.Event.SendVoice)));
  Shot(Session, Output, 'voice-note', 'voice-note-0', 'voice-note-1');
end procedure;

// Captures the current conversation, media or voice examples.
// ## Parameters
// - `Session`: Presented Social and media or Voice page.
// - `Output`: Directory for full-frame images and crop bounds.
// - `Page`: Social or Voice.
public procedure Capture(Session: Gui.Session<Gallery.Msg>; Output: string; Page: Gallery.Page);
requires Page = Gallery.Page.Social or Page = Gallery.Page.Voice;
begin
  if Page = Gallery.Page.Social then
    CaptureSocial(Session, Output);
  else
    CaptureVoice(Session, Output);
  end if;
end procedure;

end unit;
