program GuiDocCaptures;

uses
  GuiDocCaptures.Regions as Regions, GuiDocCaptures.SelectionAndNavigation as Guides,
  GuiDocCaptures.Presented as Presented, GuiDocCaptures.FeedbackAndDataDisplay as Collections,
  GuiDocCaptures.Chapters as Chapters, GuiDocCaptures.Charts as Charts,
  GuiGallery.App.State as Gallery,
  GuiGallery.App.Update as Update, GuiGallery.App.View as View,
  GuiGallery.Pages.Actions.State as Actions, GuiGallery.Pages.Inputs.State as Inputs,
  GuiGallery.Pages.Overlays.State as Overlays, GuiGallery.Pages.Disclosure.State as Disclosure,
  GuiGallery.Pages.Feedback.State as Feedback,
  GuiGallery.Pages.Charts.State as ChartState,
  GuiGallery.Shared.State as Demo,
  Fpas.Ui.Gui.Application as Gui,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Hosting.Session as Host,
  Fpas.Ui.Mvu.Session as Mvu, Fpas.Ui.Mvu.Application as App,
  Fpas.Ui.Widgets.Actions.StatusButtons as Status, Fpas.Ui.Gui.Toasts as Toasts,
  System as Sys, System.IO as IO;

// CUI key ordinals used by the native input binding.
const Enter: int := 2;
const Escape: int := 3;
const Down: int := 10;

function WithFocus(Model: Gallery.Model; Message: Gallery.Msg; Id: string): App.Transition<Gallery.Model, Gallery.Msg>;
begin
  if Id = '' then
    return Update.Update(Model, Message);
  end if;

  return new App.Transition<Gallery.Model, Gallery.Msg>(Model, [App.Focus<Gallery.Msg>(Id)]);
end function;

procedure Run(Output: string; Chapter: string);
requires Output <> '';
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Wheel <> 0.0F then
      Window.Wheel(Wheel);
      Wheel := 0.0F;
    end if;

    if Button >= 0 then
      Window.SetLeftButton(Button = 1);
      Button := -1;
    end if;

    if RightButton >= 0 then
      Window.SetRightButton(RightButton = 1);
      RightButton := -1;
    end if;

    if KeyCode <> 0 then
      Window.SetKey(KeyCode, true);
      Window.SetKey(KeyCode, false);
      KeyCode := 0;
    end if;
  end procedure;

  procedure Step(Session: Gui.Session<Gallery.Msg>);
  begin
    if not Session.Step() then
      raise new Sys.InvalidOperationException('The gallery closed during capture.');
    end if;
  end procedure;

  procedure Send(Session: Gui.Session<Gallery.Msg>; Message: Gallery.Msg);
  begin
    case Session.Post(Message) of
      when Mvu.Admission.Queued:
      else
        raise new Sys.InvalidOperationException('The gallery did not accept a message.');
    end case;

    Step(Session);
    Step(Session);
  end procedure;

  procedure Key(Session: Gui.Session<Gallery.Msg>; Value: int);
  begin
    KeyCode := Value;
    Step(Session);
    Step(Session);
  end procedure;

  procedure OpenMenu(Session: Gui.Session<Gallery.Msg>; Id: string; Activation: int);
  begin
    FocusId := Id;
    Send(Session, Gallery.Msg.Preview);
    FocusId := '';
    Key(Session, Activation);
  end procedure;

  procedure Shot(Session: Gui.Session<Gallery.Msg>; Name: string; params Ids: array of string);
  begin
    Regions.Capture(Session, Output, Name, new Regions.Insets(), Ids);
  end procedure;

  procedure Aim(Session: Gui.Session<Gallery.Msg>; Id: string; Horizontal: float := 0.5F);
  begin
    for Control: Gui.Control in Session.Snapshot().Controls do
      if Control.Id = Id and Control.Bounds.Width > 0.0F and Control.Bounds.Height > 0.0F then
        X := Control.Bounds.X + Control.Bounds.Width * Horizontal;
        Y := Control.Bounds.Y + Control.Bounds.Height / 2.0F;
        return;
      end if;
    end for;

    raise new Sys.InvalidOperationException('No usable pointer target for ' + Id);
  end procedure;

  procedure Leave(Session: Gui.Session<Gallery.Msg>);
  begin
    X := -1.0F;
    Y := -1.0F;
    Step(Session);
  end procedure;

  procedure RevealSwipe(Session: Gui.Session<Gallery.Msg>);
  begin
    for Control: Gui.Control in Session.Snapshot().Controls do
      if Control.Id = 'swipe-design' then
        X := Control.Bounds.X + Control.Bounds.Width / 2.0F;
        Y := Control.Bounds.Y + Control.Bounds.Height / 2.0F;
        Button := 1;
        Step(Session);
        X := X - 110.0F;
        Step(Session);
        Button := 0;
        Step(Session);
        X := -1.0F;
        Y := -1.0F;
        Step(Session);
        return;
      end if;
    end for;

    raise new Sys.InvalidOperationException('Missing gallery swipe row.');
  end procedure;

  procedure CaptureActions(Session: Gui.Session<Gallery.Msg>);
  begin
    Shot(Session, 'button', 'primary', 'secondary', 'outline', 'ghost', 'danger', 'link');
    Shot(Session, 'icon-button', 'icon-copy', 'icon-share', 'icon-like', 'icon-delete');
    Shot(Session, 'button-group', 'format-bold', 'format-italic', 'format-underline');
    Regions.Capture(Session, Output, 'copy-button', new Regions.Insets(Left := 68), 'copy-install');
    Shot(Session, 'hold-button', 'hold-delete');
    Shot(Session, 'segmented-control', 'view', 'range');
    OpenMenu(Session, 'options', Down);
    Shot(
      Session,
      'dropdown-menu',
      'options',
      'options/rename',
      'options/duplicate',
      'options/share',
      'options/delete'
    );
    Key(Session, Escape);

    Send(Session, Gallery.Msg.Show(Gallery.Page.Actions));
    Shot(Session, 'toggle-group', 'action-format', 'action-align');
    Shot(Session, 'reactions', 'action-reactions');
    Shot(Session, 'theme-switcher', 'theme-preview');
    Shot(Session, 'theme-toggle', 'theme-toggle');
    OpenMenu(Session, 'split-save/menu', Down);
    Shot(
      Session,
      'split-button',
      'split-save',
      'split-save/menu',
      'split-save/menu/draft',
      'split-save/menu/schedule'
    );
    Key(Session, Escape);
    FocusId := 'confirm-delete';
    Send(Session, Gallery.Msg.Preview);
    FocusId := '';
    Key(Session, Enter);
    Shot(Session, 'confirm-button', 'confirm-delete');
    Key(Session, Escape);
    Send(Session, Gallery.Msg.Actions(Actions.Msg.SetSaveStatus(Status.Status.Success)));
    Shot(Session, 'status-button', 'status-save');
    OpenMenu(Session, 'action-user', Enter);
    Shot(Session, 'user-menu', 'action-user', 'action-user/profile', 'action-user/log-out');
    Key(Session, Escape);
    OpenMenu(Session, 'action-speed-dial', Enter);
    Shot(
      Session,
      'speed-dial',
      'action-speed-dial',
      'action-speed-dial/0',
      'action-speed-dial/1',
      'action-speed-dial/2'
    );
    Key(Session, Escape);
    Shot(Session, 'swipe-actions-closed', 'swipe-design');
    RevealSwipe(Session);
    Shot(Session, 'swipe-actions', 'swipe-design');
  end procedure;

  procedure OpenAndCapture(Session: Gui.Session<Gallery.Msg>; Name: string; Id: string; Padding: Regions.Insets);
  begin
    OpenMenu(Session, Id, Enter);
    Regions.CaptureParts(Session, Output, Name, Id, Padding);
    Key(Session, Escape);
  end procedure;

  procedure CaptureInputs(Session: Gui.Session<Gallery.Msg>);
  begin
    const Caption: Regions.Insets := new Regions.Insets(Top := 22);
    const Hint: Regions.Insets := new Regions.Insets(Top := 22, Bottom := 16);
    Regions.Capture(Session, Output, 'text-field', Hint, 'input-name', 'input-email');
    Regions.Capture(Session, Output, 'search-field', Caption, 'input-search');
    Regions.Capture(Session, Output, 'text-area', Hint, 'input-about');
    Regions.Capture(
      Session, Output, 'tag-input', new Regions.Insets(Left := 56, Top := 22, Right := 12),
      'input-topics', 'input-topics/remove/0', 'input-topics/remove/1', 'input-topics/remove/2'
    );
    Regions.Capture(Session, Output, 'one-time-code', Caption, 'input-code');
    Send(Session, Gallery.Msg.Inputs(Inputs.Msg.SetPassword('copper lantern demo 42!')));
    Regions.Capture(
      Session, Output, 'password-strength', Caption,
      'input-new-password', 'input-password-strength'
    );
    Regions.Capture(
      Session, Output, 'number-field', Caption, 'input-seats',
      'input-seats/decrease', 'input-seats/increase'
    );
    Regions.CaptureParts(Session, Output, 'calendar', 'input-calendar', new Regions.Insets());
    OpenAndCapture(Session, 'select', 'input-language', Caption);
    OpenAndCapture(
      Session,
      'date-picker',
      'input-due-date',
      new Regions.Insets(Top := 22, Bottom := 12)
    );
    OpenAndCapture(
      Session,
      'color-picker',
      'input-brand-color',
      new Regions.Insets(Top := 22, Right := 10, Bottom := 10)
    );
  end procedure;

  procedure CapturePickers(Session: Gui.Session<Gallery.Msg>);
  begin
    Regions.CaptureParts(
      Session,
      Output,
      'date-range-calendar',
      'picker-inline-range',
      new Regions.Insets()
    );
    Shot(Session, 'wheel-picker', 'picker-wheel-day', 'picker-wheel-month', 'picker-wheel-year');
    Shot(
      Session,
      'time-dial',
      'picker-time-dial/hours',
      'picker-time-dial/minutes',
      'picker-time-dial/face'
    );
    Regions.Capture(
      Session,
      Output,
      'ruler-slider',
      new Regions.Insets(Top := 58),
      'picker-height',
      'picker-temperature'
    );
    Regions.Capture(
      Session,
      Output,
      'histogram-slider',
      new Regions.Insets(Top := 84, Bottom := 15),
      'picker-price'
    );
    OpenAndCapture(Session, 'multi-select', 'picker-languages', new Regions.Insets(Top := 22));
    OpenAndCapture(
      Session,
      'date-range-picker',
      'picker-date-range',
      new Regions.Insets(Right := 10, Bottom := 10)
    );
    Shot(Session, 'time-picker-fields', 'picker-start-time', 'picker-end-time');
    OpenAndCapture(
      Session,
      'time-picker',
      'picker-end-time',
      new Regions.Insets(Top := -53, Right := 10, Bottom := -64)
    );
  end procedure;

  procedure CaptureOverlays(Session: Gui.Session<Gallery.Msg>);
  begin
    Send(Session, Gallery.Msg.Overlays(Overlays.Msg.SetProfileDialog(true)));
    Shot(Session, 'dialog', 'edit-profile', 'edit-profile/close', 'edit-profile-save');
    Regions.Capture(
      Session, Output, 'action-footer', new Regions.Insets(Left := 188, Right := 16),
      'edit-profile-cancel', 'edit-profile-save'
    );
    Key(Session, Escape);
    Send(Session, Gallery.Msg.Overlays(Overlays.Msg.SetSheet(true)));
    Shot(
      Session,
      'sheet',
      'sheet/close',
      'notifications-comments',
      'recent-comment',
      'recent-invitation'
    );
    Key(Session, Escape);
    Send(Session, Gallery.Msg.Overlays(Overlays.Msg.SetPalette(true)));
    Regions.CaptureParts(
      Session,
      Output,
      'command-palette',
      'gallery-palette',
      new Regions.Insets(Bottom := -70)
    );
    Key(Session, Escape);
    Send(Session, Gallery.Msg.Overlays(Overlays.Msg.SetFilters(true)));
    Shot(Session, 'popover', 'filters-trigger', 'filters', 'filters-apply');
    Key(Session, Escape);
    Aim(Session, 'context', 0.08F);
    RightButton := 1;
    Step(Session);
    RightButton := 0;
    Step(Session);
    Shot(Session, 'context-menu', 'context/cut', 'context/delete');
    Key(Session, Escape);
    Aim(Session, 'tooltip-bold');
    Presented.AwaitVisible(Session, 'native-tooltip');
    Shot(Session, 'tooltip', 'tooltip-bold', 'native-tooltip');
    Leave(Session);
    Window.Resize(620, 840);
    Step(Session);
    Send(Session, Gallery.Msg.SetDrawer(true));
    Regions.Capture(
      Session, Output, 'drawer', new Regions.Insets(Top := 22),
      'drawer/close', 'navigation/overview', 'navigation/charts'
    );
    Send(Session, Gallery.Msg.SetDrawer(false));
    Window.Resize(1240, 1540);
    Step(Session);
    Send(
      Session, Gallery.Msg.Shared(
        Demo.Msg.Notify(
          'Changes saved',
          new Toasts.Options(
            Description := 'Your profile is up to date.',
            Appearance := Toasts.Tone.Success
          )
        )
      )
    );
    Presented.CaptureToast(Session, Output, 'toast', 'Changes saved');
  end procedure;

  procedure CaptureDisclosure(Session: Gui.Session<Gallery.Msg>);
  begin
    Shot(Session, 'banner', 'release-banner', 'release-banner/action', 'release-banner/dismiss');
    Regions.Capture(
      Session,
      Output,
      'link',
      new Regions.Insets(Left := 79, Right := 99),
      'jonas-link'
    );
    Shot(Session, 'expandable-text', 'about-cui', 'about-cui/toggle');
    Shot(Session, 'expandable-card', 'billing', 'security', 'change-plan');
    Shot(Session, 'countdown', 'disclosure-launch', 'disclosure-sale');
    Shot(Session, 'onboarding-checklist', 'workspace-onboarding');
    Shot(Session, 'veil', 'photo', 'sample-key', 'reveal-sample-key', 'spoiler');
    Send(Session, Gallery.Msg.Disclosure(Disclosure.Msg.SetPhoto(true)));
    Send(Session, Gallery.Msg.Disclosure(Disclosure.Msg.SetKey(true)));
    Send(Session, Gallery.Msg.Disclosure(Disclosure.Msg.SetSpoiler(true)));
    Shot(Session, 'veil-revealed', 'photo', 'sample-key', 'reveal-sample-key', 'spoiler');
    Aim(Session, 'jonas-link');
    Presented.AwaitVisible(Session, 'jonas-avatar');
    Shot(Session, 'hover-card', 'jonas-link', 'jonas-card', 'jonas-avatar');
    Shot(Session, 'avatar', 'jonas-avatar');
    Key(Session, Escape);
    Leave(Session);
    Send(Session, Gallery.Msg.Disclosure(Disclosure.Msg.SetBranchQuestion(true)));
    Shot(
      Session,
      'confirm-popover',
      'branch-trigger',
      'branch-question',
      'branch-question/confirm'
    );
    Key(Session, Escape);
    OpenMenu(Session, 'about-cui/toggle', Enter);
    Shot(Session, 'expandable-text-expanded', 'about-cui', 'about-cui/toggle');
    Send(Session, Gallery.Msg.Disclosure(Disclosure.Msg.ArchiveConversations));
    Presented.CaptureToast(Session, Output, 'undo-toast', '3 conversations archived');
  end procedure;
begin
  const Page: Gallery.Page := Chapters.PageForChapter(Chapter);

  discard IO.Directory.CreateDirectory(Output);
  Sys.Environment.SetEnvironmentVariable('CUI_SCALE', '1');
  Sys.Environment.SetEnvironmentVariable('CUI_SCREENSHOT', null);
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Button: int := -1;
  var RightButton: int := -1;
  var Wheel: float := 0.0F;
  var KeyCode: int := 0;
  var FocusId: string := '';
  const Height: int := Chapters.ViewportHeight(Page);
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas widget documentation', 1240, Height, Cui.CuiRenderer.Software, true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session<Gallery.Msg> := Host.Start<Gallery.Model, Gallery.Msg>(
    new Gallery.Model(Active := Page),
    function(Model: Gallery.Model; Message: Gallery.Msg): App.Transition<Gallery.Model, Gallery.Msg> => WithFocus(
      Model,
      Message,
      FocusId
    ),
    View.Build, Window, 128,
    Inject, ThemeFor := Update.ThemeFor
  );
  Step(Session);
  Step(Session);

  case Page of
    when Gallery.Page.Buttons:
      CaptureActions(Session);
    when Gallery.Page.Selection:
      Guides.CaptureSelection(Session, Output);
    when Gallery.Page.Navigation:
      Guides.CaptureNavigation(Session, Output);
    when Gallery.Page.Inputs:
      CaptureInputs(Session);
    when Gallery.Page.Pickers:
      CapturePickers(Session);
    when Gallery.Page.Overlays:
      CaptureOverlays(Session);
    when Gallery.Page.Disclosure:
      CaptureDisclosure(Session);
    when Gallery.Page.Feedback:
      Send(Session, Gallery.Msg.Feedback(Feedback.Msg.Finish(Status.Status.Success)));
      Collections.CaptureFeedback(Session, Output);
    when Gallery.Page.Lists:
      Collections.CaptureDataDisplay(Session, Output);
    when Gallery.Page.Charts:
      Charts.CaptureCharts(Session, Output);
      Send(Session, Gallery.Msg.Charts(ChartState.Msg.SetGrayscale(true)));
      Charts.CaptureGrayscale(Session, Output);
    when Gallery.Page.MoreCharts:
      Charts.CaptureMoreChartsTop(Session, Output);
      X := 1200.0F;
      Y := 600.0F;
      Wheel := -60.0F;
      Step(Session);
      Step(Session);
      Leave(Session);
      Charts.CaptureMoreChartsBottom(Session, Output);
    else
      raise new Sys.InvalidOperationException('No capture steps for ' + Page.ToString());
  end case;
end procedure;

begin
  const Arguments: array of string := Sys.Environment.GetCommandLineArgs();
  if Arguments.Length < 2 or Arguments.Length > 3 or Arguments[1] = '' then
    raise new Sys.ArgumentException(
      'Pass an output directory and optionally a handbook chapter name.'
    );
  end if;

  Run(
    Arguments[1], if Arguments.Length = 3 then
      Arguments[2]
    else
      'actions'
    end if
  );
end;

end program;
