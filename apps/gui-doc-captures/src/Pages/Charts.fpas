// [Documentation](../../doc/captures.md#chapter-recipes)

unit GuiDocCaptures.Pages.Charts;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.Sparklines as Sparklines;

uses GuiDocCaptures.Rendering.Presented as Presented;
uses GuiDocCaptures.Rendering.Regions as Regions;
uses GuiGallery.App.State as Gallery;
uses GuiGallery.App.Update as Update;
uses GuiGallery.Shared.Sections as G;

// Captures the chart widgets and their variants on the Charts page.
// ## Parameters
// - `Session`: Gallery session on Charts.
// - `Output`: Directory for full-frame images and crop bounds.
public procedure CaptureCharts(Session: Gui.Session of Gallery.Msg; Output: string);
begin
  Regions.Shot(Session, Output, 'line-chart', 'revenue');
  Regions.Shot(Session, Output, 'line-chart-dither', 'requests');
  Regions.Shot(Session, Output, 'bar-chart', 'visits');
  Regions.Shot(Session, Output, 'bar-chart-stacked', 'runs');
  Regions.Shot(Session, Output, 'donut-chart', 'platforms');
  Regions.Shot(Session, Output, 'pattern-meter', 'storage');
  Regions.Shot(Session, Output, 'gauge', 'cpu', 'memory');
end procedure;

// Captures the standalone sparkline sample for the Charts handbook.
// ## Parameters
// - `Output`: Directory for the full-frame image and crop bounds.
public procedure CaptureSparkline(Output: string);
begin
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas sparkline',
    160,
    80,
    Cui.CuiRenderer.Software,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of Gallery.Msg := Host.Start of (Gallery.Model, Gallery.Msg)(
    new Gallery.Model(), Update.Update,
    function(_Model: Gallery.Model; _Size: L.Viewport): E.Element of Gallery.Msg => E.Column of Gallery.Msg(
      new L.Flow(PaddingStart := G.Points(8), PaddingTop := G.Points(8)),
      Sparklines.Sparkline of Gallery.Msg('sparkline', [3.0F, 5.0F, 4.0F, 8.0F, 6.0F, 9.0F, 8.0F])
    ),
    Window, 16
  );
  Presented.Step(Session);
  Presented.Step(Session);
  Regions.Shot(Session, Output, 'sparkline', 'sparkline');
end procedure;

// Captures the pattern meter after selecting the grayscale option.
// ## Parameters
// - `Session`: Gallery session on Charts with Grayscale selected.
// - `Output`: Directory for the full-frame image and crop bounds.
public procedure CaptureGrayscale(Session: Gui.Session of Gallery.Msg; Output: string);
begin
  Regions.Shot(Session, Output, 'pattern-meter-grayscale', 'storage', 'grayscale');
end procedure;

// Captures the visualizations at the top of More charts.
// ## Parameters
// - `Session`: Gallery session on More charts.
// - `Output`: Directory for full-frame images and crop bounds.
public procedure CaptureMoreChartsTop(Session: Gui.Session of Gallery.Msg; Output: string);
begin
  Regions.Shot(Session, Output, 'heatmap', 'traffic');
  Regions.Shot(Session, Output, 'calendar-heatmap', 'activity');
  Regions.Shot(Session, Output, 'treemap', 'bundle');
  Regions.Shot(Session, Output, 'radar-chart', 'radar');
  Regions.Shot(Session, Output, 'funnel', 'funnel');
  Regions.Shot(Session, Output, 'split-bar', 'split');
  Regions.Shot(Session, Output, 'waffle', 'waffle');
  Regions.Shot(Session, Output, 'sankey', 'flow');
end procedure;

// Captures the ranked charts and instruments at the bottom of More charts.
// ## Parameters
// - `Session`: Gallery session scrolled to the bottom of More charts.
// - `Output`: Directory for full-frame images and crop bounds.
public procedure CaptureMoreChartsBottom(Session: Gui.Session of Gallery.Msg; Output: string);
begin
  Regions.Shot(Session, Output, 'bar-list', 'pages', 'shuffle-pages');
  Regions.Shot(Session, Output, 'activity-rings', 'rings');
  Regions.Shot(Session, Output, 'scatter-chart', 'scatter');
  Regions.Shot(Session, Output, 'radial-gauge', 'cpu-radial', 'temp', 'mem');
  Regions.Shot(Session, Output, 'candlestick', 'price');
end procedure;

end unit;
