// [Documentation](../../doc/captures.md#chapter-recipes)

unit GuiDocCaptures.Pages.DeveloperTools;

uses Fpas.Ui.Gui.Application as Gui;

uses GuiDocCaptures.Rendering.Presented as Presented;
uses GuiGallery.App.State as Gallery;

// Captures the original Developer tools page.
// ## Parameters
// - `Session`: Presented Developer tools page.
// - `Output`: Directory for full-frame images and crop bounds.
// - `Scroll`: Injects a vertical wheel delta over the page margin.
public procedure Capture(Session: Gui.Session<Gallery.Msg>; Output: string; Scroll: procedure(float));
begin
  Presented.CaptureInView(Session, Output, 'trace-viewer', Scroll, 'dev-trace');
  Presented.CaptureInView(Session, Output, 'network-waterfall', Scroll, 'dev-net');
  Presented.CaptureInView(Session, Output, 'dependency-graph', Scroll, 'dev-deps');
  Presented.CaptureInView(Session, Output, 'commit-graph', Scroll, 'dev-history');
  Presented.CaptureInView(Session, Output, 'pipeline', Scroll, 'dev-pipeline');
  Presented.CaptureInView(Session, Output, 'problems-panel', Scroll, 'dev-problems');
  Presented.CaptureInView(Session, Output, 'key-value-editor', Scroll, 'dev-headers');
  Presented.CaptureInView(Session, Output, 'query-builder', Scroll, 'dev-filter');
  Presented.CaptureInView(Session, Output, 'schedule-picker', Scroll, 'dev-backup');
  Presented.CaptureInView(Session, Output, 'keymap', Scroll, 'dev-keys');
end procedure;

// Captures the original More developer tools page.
// ## Parameters
// - `Session`: Presented More developer tools page.
// - `Output`: Directory for full-frame images and crop bounds.
// - `Scroll`: Injects a vertical wheel delta over the page margin.
public procedure CaptureMore(Session: Gui.Session<Gallery.Msg>; Output: string; Scroll: procedure(float));
begin
  Presented.CaptureInView(Session, Output, 'test-explorer', Scroll, 'dev-tests');
  Presented.CaptureInView(Session, Output, 'stack-trace', Scroll, 'dev-stack');
  Presented.CaptureInView(Session, Output, 'blame', Scroll, 'dev-blame');
  Presented.CaptureInView(Session, Output, 'coverage', Scroll, 'dev-coverage');
  Presented.CaptureInView(Session, Output, 'regex-tester', Scroll, 'dev-regex');
  Presented.CaptureInView(Session, Output, 'http-request-bar', Scroll, 'dev-request', 'dev-params');
  Presented.CaptureInView(Session, Output, 'key-value-parameters', Scroll, 'dev-params');
  Presented.CaptureInView(Session, Output, 'http-response-status', Scroll, 'dev-response');
  Presented.CaptureInView(Session, Output, 'api-explorer', Scroll, 'dev-api');
  Presented.CaptureInView(Session, Output, 'feature-flags', Scroll, 'dev-flags');
  Presented.CaptureInView(Session, Output, 'uptime', Scroll, 'dev-uptime');
  Presented.CaptureInView(Session, Output, 'time-histogram', Scroll, 'dev-histogram');
end procedure;

end unit;
