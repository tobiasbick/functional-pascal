// [Documentation](../../doc/captures.md#chapter-recipes)

unit GuiDocCaptures.Pages.Overview;

uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Widgets.Theming.ThemeSwitchers as Switchers;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;
uses GuiDocCaptures.Rendering.Presented as Presented;
uses GuiDocCaptures.Rendering.Regions as Regions;
uses GuiGallery.App.State as Gallery;
uses GuiGallery.Shared.State as Shared;

procedure CaptureAppearance(Session: Gui.Session<Gallery.Msg>; Output: string; Name: string);
begin
  Regions.Capture(
    Session, Output, Name, new Regions.Insets(Left := 12, Right := 12, Bottom := 12),
    'theme', 'accent-neutral', 'accent-rose'
  );
end procedure;

// Captures the Overview layout, metrics, workspace form and sidebar appearance.
// ## Parameters
// - `Session`: Presented Overview page.
// - `Output`: Directory for full-frame PNGs and crop coordinates.
public procedure Capture(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Regions.Capture(
    Session, Output, 'overview', new Regions.Insets(Top := 118),
    'browse', 'overview-palette', 'workspace-card', 'team-card'
  );
  Regions.Capture(
    Session, Output, 'metric', new Regions.Insets(),
    'overview-components', 'overview-frame-time', 'overview-dependencies'
  );
  Regions.Capture(
    Session, Output, 'workspace-form', new Regions.Insets(),
    'workspace-card'
  );
  CaptureAppearance(Session, Output, 'sidebar-appearance');
  Presented.Send(Session, Gallery.Msg.Shared(Shared.Msg.SetAppearance(Switchers.Selection.Dark)));
  Presented.Send(Session, Gallery.Msg.Shared(Shared.Msg.SetAccent(Themes.Accent.Blue)));
  CaptureAppearance(Session, Output, 'sidebar-appearance-dark');
end procedure;

end unit;
