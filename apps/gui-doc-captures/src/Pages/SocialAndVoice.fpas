// [Documentation](../../doc/captures.md#chapter-recipes)

unit GuiDocCaptures.Pages.SocialAndVoice;

uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Widgets.Ai.Composers as Composer;
uses GuiDocCaptures.Rendering.Presented as Presented;
uses GuiDocCaptures.Rendering.Regions as Regions;
uses GuiGallery.App.State as Gallery;
uses GuiGallery.Pages.Voice.State as Voice;

procedure CaptureSocial(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Regions.Shot(
    Session,
    Output,
    'chat-message',
    'social-message-1',
    'social-message-2',
    'social-message-3',
    'social-message-4'
  );
  Regions.Shot(Session, Output, 'chat-divider', 'social-today');
  Regions.Shot(Session, Output, 'typing-indicator', 'social-typing');
  Regions.Shot(Session, Output, 'comment', 'social-comments');
  Regions.Shot(Session, Output, 'presence', 'social-presence');
  Regions.Shot(Session, Output, 'counter', 'social-revenue', 'social-sale');
  Regions.Shot(Session, Output, 'ticker', 'social-ticker');
  Regions.Shot(Session, Output, 'carousel', 'social-tour');
  Regions.Shot(Session, Output, 'image-viewer', 'social-viewer');
  Regions.Shot(Session, Output, 'image-cropper', 'social-crop');
  Regions.Shot(Session, Output, 'image-compare', 'social-compare');
  Regions.Shot(Session, Output, 'card-stack', 'social-deck');
end procedure;

procedure CaptureVoice(Session: Gui.Session<Gallery.Msg>; Output: string);
begin
  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Tick(6.5F)));
  Regions.Shot(Session, Output, 'composer', 'voice-composer');
  Regions.Shot(Session, Output, 'voice-session', 'voice-session-card');
  Regions.Shot(Session, Output, 'voice-waveform', 'voice-live', 'voice-clip');
  Regions.Shot(Session, Output, 'voice-orb', 'voice-orb');
  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Orb));
  Regions.Shot(Session, Output, 'voice-orb-listening', 'voice-orb');

  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Editor(Composer.Event.Record)));
  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Tick(1.0F)));
  Regions.Shot(Session, Output, 'composer-recording', 'voice-composer');
  Presented.Send(Session, Gallery.Msg.Voice(Voice.Msg.Editor(Composer.Event.SendVoice)));
  Regions.Shot(Session, Output, 'voice-note', 'voice-note-0', 'voice-note-1');
end procedure;

// Captures the current conversation, media or voice examples.
// ## Parameters
// - `Session`: Presented Social and media or Voice page.
// - `Output`: Directory for full-frame images and crop bounds.
// - `Page`: Social or Voice.
public procedure Capture(Session: Gui.Session<Gallery.Msg>; Output: string; Page: Gallery.Page);
requires Page = Gallery.Page.Social or Page = Gallery.Page.Voice;
begin
  if Page = Gallery.Page.Social then
    CaptureSocial(Session, Output);
  else
    CaptureVoice(Session, Output);
  end if;
end procedure;

end unit;
