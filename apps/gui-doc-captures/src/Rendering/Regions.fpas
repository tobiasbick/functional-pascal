// [Documentation](../../doc/captures.md#capture-session)

unit GuiDocCaptures.Rendering.Regions;

uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;

uses GuiGallery.App.State as Gallery;
uses System as Sys;
uses System.Collections.Generic as Generic;
uses System.IO as IO;

// Adjustments to the default crop margins for native captions and panel edges.
public type Insets = record
  // Pixels added on the left. Negative values trim the crop.
  public Left: int := 0;
  // Pixels added at the top. Negative values trim the crop.
  public Top: int := 0;
  // Pixels added on the right. Negative values trim the crop.
  public Right: int := 0;
  // Pixels added at the bottom. Negative values trim the crop.
  public Bottom: int := 0;
end record;

// Saves a frame and its explicit crop rectangle.
// ## Parameters
// - `Session`: Presented gallery session.
// - `Output`: Directory for the full-frame PNG and crop coordinates.
// - `Name`: Basename of the documented widget.
// - `Rectangle`: Left, top, right and bottom pixel coordinates, in that order.
public procedure CaptureRectangle(
  Session: Gui.Session of Gallery.Msg;
  Output: string;
  Name: string;
  Rectangle: array of int
);
requires Rectangle.Length = 4;
begin
  const Size: Cui.CuiSize := Session.Snapshot().Size;
  if Rectangle[0] < 0 or Rectangle[1] < 0 or Rectangle[2] <= Rectangle[0]
    or Rectangle[3] <= Rectangle[1] or Rectangle[2] > Size.Width or Rectangle[3] > Size.Height
  then
    raise new Sys.InvalidOperationException('Invalid crop rectangle for ' + Name);
  end if;

  const Target: string := IO.Path.Combine(Output, Name);
  Session.CapturePng(Target + '.png');
  IO.File.WriteAllText(Target + '.crop', Sys.String.Join of int(',', Rectangle));
end procedure;

// Captures the union of named gallery controls in one presented frame.
// ## Parameters
// - `Session`: Presented gallery session.
// - `Output`: Directory for full-frame PNGs and crop coordinates.
// - `Name`: Basename of the documented widget.
// - `Padding`: Adjustments to the crop margins for native captions or panel edges.
// - `Ids`: Controls to include. Use `Id/Key` for a keyed part with a shared ID.
public procedure Capture(
  Session: Gui.Session of Gallery.Msg;
  Output: string;
  Name: string;
  Padding: Insets;
  params Ids: array of string
);
begin
  const Frame: Gui.Frame := Session.Snapshot();
  var Left: float := cast Frame.Size.Width as float;
  var Top: float := cast Frame.Size.Height as float;
  var Right: float := 0.0F;
  var Bottom: float := 0.0F;
  for Id: string in Ids do
    var Found: bool := false;
    for Control: Gui.Control in Frame.Controls do
      const Bounds: Cui.CuiRectangle := Control.Bounds;
      if (Control.Id = Id or (Control.Key <> '' and Control.Id + '/' + Control.Key = Id))
        and Bounds.Width > 0.0F and Bounds.Height > 0.0F
      then
        Left := Sys.Math.Min(Left, Bounds.X);
        Top := Sys.Math.Min(Top, Bounds.Y);
        Right := Sys.Math.Max(Right, Bounds.X + Bounds.Width);
        Bottom := Sys.Math.Max(Bottom, Bounds.Y + Bounds.Height);
        Found := true;
      end if;
    end for;

    if not Found then
      raise new Sys.InvalidOperationException('No rendered bounds for ' + Id);
    end if;
  end for;

  if Left < 0.0F or Top < 0.0F or Right > Frame.Size.Width or Bottom > Frame.Size.Height then
    raise new Sys.InvalidOperationException('Region is outside the viewport: ' + Name);
  end if;

  const Rectangle: array of int := [
    Sys.Math.Max(0, cast Sys.Math.Floor(Left) as int - 8 - Padding.Left),
    Sys.Math.Max(0, cast Sys.Math.Floor(Top) as int - 8 - Padding.Top),
    Sys.Math.Min(
      cast Frame.Size.Width as int,
      cast Sys.Math.Ceiling(Right) as int + 8 + Padding.Right
    ),
    Sys.Math.Min(
      cast Frame.Size.Height as int,
      cast Sys.Math.Ceiling(Bottom) as int + 8 + Padding.Bottom
    )
  ];
  CaptureRectangle(Session, Output, Name, Rectangle);
end procedure;

// Captures the named controls with the standard margins.
// ## Parameters
// - `Session`: Presented gallery session.
// - `Output`: Directory for the full frame and crop bounds.
// - `Name`: Basename for both files.
// - `Ids`: Controls to include in the crop.
public procedure Shot(
  Session: Gui.Session of Gallery.Msg;
  Output: string;
  Name: string;
  params Ids: array of string
);
begin
  Capture(Session, Output, Name, new Insets(), Ids);
end procedure;

// Captures a compound control and its visible native parts.
// ## Parameters
// - `Session`: Presented gallery session.
// - `Output`: Directory for full-frame PNGs and crop coordinates.
// - `Name`: Basename of the documented widget.
// - `Id`: Identity shared by the root and descendant control IDs.
// - `Padding`: Adjustments to the crop margins for native captions or panel edges.
public procedure CaptureParts(
  Session: Gui.Session of Gallery.Msg;
  Output: string;
  Name: string;
  Id: string;
  Padding: Insets
);
requires Id <> '';
begin
  const Parts: Generic.List of string := new Generic.List of string();
  var HasDescendant: bool := false;
  for Control: Gui.Control in Session.Snapshot().Controls do
    const Child: bool := Control.Id.StartsWith(Id + '/', Sys.StringComparison.Ordinal);
    if (Child or Control.Id = Id) and Control.Bounds.Width > 0.0F and Control.Bounds.Height >
      0.0F
    then
      Parts.Add(Control.Id);
      HasDescendant := HasDescendant or Child;
    end if;
  end for;

  if not HasDescendant then
    raise new Sys.InvalidOperationException('No visible native parts for ' + Id);
  end if;

  Capture(Session, Output, Name, Padding, Parts.ToArray());
end procedure;

end unit;
