[project]
name = "ide-core"
kind = "library"

[exports]
units = [
  "Ide.App.Model",
  "Ide.App.Actions",
  "Ide.App.Update",
  "Ide.App.View",
  "Ide.Document.Model",
  "Ide.Document.Io",
  "Ide.Diagnostic.Model",
  "Ide.Diagnostic.Parser",
  "Ide.Project.Model",
  "Ide.Project.Loader",
  "Ide.Process.Runner",
]

[sources]
include = ["src/**/*.fpas"]
exclude = ["src/main.fpas"]
