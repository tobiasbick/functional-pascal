[project]
name = "ide-core"
kind = "library"

[exports]
units = [
  "Ide.Shell",
  "Ide.Ui.Menu",
  "Ide.Ui.Status",
  "Ide.Ui.Theme",
  "Ide.Dialog",
  "Ide.Dialog.Open",
  "Ide.Dialog.About",
  "Ide.Workspace.Classify",
  "Ide.Workspace.Session",
]

[sources]
include = ["src/**/*.fpas"]
exclude = ["src/main.fpas"]
