/// Startup, file operations, and modal document-flow transitions for the IDE.

unit Ide.App.DocumentFlow;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.OpenFlow, Ide.Diagnostic.Model, Ide.Diagnostic.Parser,
  Ide.Document.Io, Ide.Document.Model, Ide.Process.Runner, Ide.Project.Model, Std.Array, Std.Path,
  Std.Str, Std.Tui;

private function IdeState(
  State: IdeModel;
  Document: IdeDocument;
  Dialog: IdeDialog;
  MessageText: string;
  MessageOffset: TuiPoint;
  Diagnostics: array of IdeDiagnostic;
  SelectedDiagnostic: option of integer;
  Focused: option of TuiControlId
): IdeModel;
begin
  return record
    Workspace := State.Workspace;
    Project := State.Project;
    Document := Document;
    Dialog := Dialog;
    DialogPosition := State.DialogPosition;
    DialogDragOffset := State.DialogDragOffset;
    MessageText := MessageText;
    MessageOffset := MessageOffset;
    Diagnostics := Diagnostics;
    SelectedDiagnostic := SelectedDiagnostic;
    LastExitCode := State.LastExitCode;
    Focused := Focused;
    Menu := State.Menu;
    Theme := State.Theme;
  end
end;

private function IdeStateWithMessage(State: IdeModel; MessageText: string): IdeModel;
begin
  return IdeState(State, State.Document, State.Dialog, MessageText, TuiPoint.Create(0, 0), [], None, State.Focused)
end;

private function CloseDialog(State: IdeModel; MessageText: string): IdeModel;
begin
  mutable var Next: IdeModel := IdeState(State, State.Document, IdeDialog.NoDialog, MessageText, TuiPoint.Create(0, 0), [], None, Some(EditorControlId()));
  Next.DialogPosition := None;
  Next.DialogDragOffset := None;
  return Next
end;

private function ShowOpenDialog(State: IdeModel): IdeModel;
begin
  mutable var Next: IdeModel := IdeState(State, State.Document, IdeDialog.OpenPath('', 0), State.MessageText, State.MessageOffset, State.Diagnostics, State.SelectedDiagnostic, Some(DialogPathControlId()));
  Next.DialogPosition := None;
  Next.DialogDragOffset := None;
  return Next
end;

private function ShowSaveDialog(State: IdeModel; Pending: IdePendingCommand): IdeModel;
begin
  mutable var Next: IdeModel := IdeState(State, State.Document, IdeDialog.SavePath('', 0, Pending), State.MessageText, State.MessageOffset, State.Diagnostics, State.SelectedDiagnostic, Some(DialogPathControlId()));
  Next.DialogPosition := None;
  Next.DialogDragOffset := None;
  return Next
end;

private function ShowDirtyDialog(State: IdeModel; Pending: IdePendingCommand): IdeModel;
begin
  mutable var Next: IdeModel := IdeState(State, State.Document, IdeDialog.ConfirmDirty(Pending), State.MessageText, State.MessageOffset, State.Diagnostics, State.SelectedDiagnostic, Some(DirtySaveControlId()));
  Next.DialogPosition := None;
  Next.DialogDragOffset := None;
  return Next
end;

private function ResumePending(
  State: IdeModel;
  Pending: IdePendingCommand;
  MessageText: string;
  Cmd: TuiCmdOutput
): IdeModel;
function RunSavedDocument(Kind: IdeProcessKind): IdeModel;
function CommandPath(): option of string;
begin
  case State.Project of
    Some(Project):
    begin
      return Some(Project.Path)
    end;
    None:
    begin
      return State.Document.Path
    end
  end
end;
begin
  case CommandPath() of
    Some(Path):
    begin
      case RunIdeProcess(Kind, Path) of
        Ok(Report):
        begin
          mutable var Diagnostics: array of IdeDiagnostic := [];
          if Kind = IdeProcessKind.CheckProcess then
          begin
            Diagnostics := ParseIdeDiagnostics(Report.MessageText, Path)
          end;
          mutable var SelectedDiagnostic: option of integer := None;
          mutable var MessageOffset: TuiPoint := TuiPoint.Create(0, 0);
          if Std.Array.Length(Diagnostics) > 0 then
          begin
            SelectedDiagnostic := Some(0);
            MessageOffset.Y := Diagnostics[0].MessageLine
          end;
          return record
            Workspace := State.Workspace;
            Project := State.Project;
            Document := State.Document;
            Dialog := IdeDialog.NoDialog;
            DialogPosition := None;
            DialogDragOffset := None;
            MessageText := Report.MessageText;
            MessageOffset := MessageOffset;
            Diagnostics := Diagnostics;
            SelectedDiagnostic := SelectedDiagnostic;
            LastExitCode := Some(Report.ExitCode);
            Focused := Some(EditorControlId());
            Menu := State.Menu;
            Theme := State.Theme;
          end
        end;
        Error(Message):
        begin
          return record
            Workspace := State.Workspace;
            Project := State.Project;
            Document := State.Document;
            Dialog := IdeDialog.NoDialog;
            DialogPosition := None;
            DialogDragOffset := None;
            MessageText := Message;
            MessageOffset := TuiPoint.Create(0, 0);
            Diagnostics := [];
            SelectedDiagnostic := None;
            LastExitCode := None;
            Focused := Some(EditorControlId());
            Menu := State.Menu;
            Theme := State.Theme;
          end
        end
      end
    end;
    None:
    begin
      return IdeStateWithMessage(State, 'Cannot execute an untitled document.')
    end
  end
end;
begin
  case Pending of
    IdePendingCommand.NoPendingCommand:
    begin
      return CloseDialog(State, MessageText)
    end;
    IdePendingCommand.OpenDocument:
    begin
      return ShowOpenDialog(IdeStateWithMessage(State, MessageText))
    end;
    IdePendingCommand.CheckDocument:
    begin
      return RunSavedDocument(IdeProcessKind.CheckProcess)
    end;
    IdePendingCommand.RunDocument:
    begin
      return RunSavedDocument(IdeProcessKind.RunProcess)
    end;
    IdePendingCommand.ExitApplication:
    begin
      Cmd.Set(TuiCmd.Quit);
      return CloseDialog(State, MessageText)
    end
  end
end;

private function OpenPath(State: IdeModel; Path: string): IdeModel;
begin
  case LoadIdeOpenPath(Path) of
    Ok(Session):
    begin
      mutable var Opened: IdeModel := IdeState(State, Session.Document, IdeDialog.NoDialog, Session.MessageText, TuiPoint.Create(0, 0), [], None, Some(EditorControlId()));
      Opened.Workspace := Session.Workspace;
      Opened.Project := Session.Project;
      return Opened
    end;
    Error(Message):
    begin
      return IdeStateWithMessage(State, Message)
    end
  end
end;

private function SavePath(State: IdeModel; Path: string; Pending: IdePendingCommand; Cmd: TuiCmdOutput): IdeModel;
begin
  case WriteIdeDocument(State.Document, Path) of
    Ok(Document):
    begin
      return ResumePending(IdeState(State, Document, State.Dialog, State.MessageText, State.MessageOffset, State.Diagnostics, State.SelectedDiagnostic, State.Focused), Pending, 'Saved ' +
                                                                                                                                                                                 Path, Cmd)
    end;
    Error(Message):
    begin
      return IdeStateWithMessage(State, Message)
    end
  end
end;

/// Opens a path dialog or protects a dirty document first.

function RequestIdeOpen(State: IdeModel): IdeModel;
begin
  if IsIdeDocumentDirty(State.Document) then
  begin
    return ShowDirtyDialog(State, IdePendingCommand.OpenDocument)
  end;
  return ShowOpenDialog(State)
end;

/// Saves to the known path or opens a Save As path dialog.

function RequestIdeSave(State: IdeModel; Pending: IdePendingCommand; Cmd: TuiCmdOutput): IdeModel;
begin
  case State.Document.Path of
    Some(Path):
    begin
      return SavePath(State, Path, Pending, Cmd)
    end;
    None:
    begin
      return ShowSaveDialog(State, Pending)
    end
  end
end;

/// Quits a clean document or opens dirty protection.

function RequestIdeExit(State: IdeModel; Cmd: TuiCmdOutput): IdeModel;
begin
  if IsIdeDocumentDirty(State.Document) then
  begin
    return ShowDirtyDialog(State, IdePendingCommand.ExitApplication)
  end;
  Cmd.Set(TuiCmd.Quit);
  return State
end;

/// Applies controlled path input to the active path dialog.

function UpdateIdePathInput(State: IdeModel; Text: string; Caret: integer): IdeModel;
begin
  case State.Dialog of
    IdeDialog.OpenPath(PathText, PreviousCaret):
    begin
      return IdeState(State, State.Document, IdeDialog.OpenPath(Text, Caret), State.MessageText, State.MessageOffset, State.Diagnostics, State.SelectedDiagnostic, State.Focused)
    end;
    IdeDialog.SavePath(PathText, PreviousCaret, Pending):
    begin
      return IdeState(State, State.Document, IdeDialog.SavePath(Text, Caret, Pending), State.MessageText, State.MessageOffset, State.Diagnostics, State.SelectedDiagnostic, State.Focused)
    end;
    IdeDialog.NoDialog, IdeDialog.ConfirmDirty(Pending):
    begin
      return State
    end
  end
end;

/// Cancels the active dialog and restores editor focus.

function CancelIdeDialog(State: IdeModel): IdeModel;
begin
  return CloseDialog(State, 'Canceled.')
end;

private function AcceptPathDialog(State: IdeModel; Cmd: TuiCmdOutput): IdeModel;
begin
  case State.Dialog of
    IdeDialog.OpenPath(PathText, Caret):
    begin
      return OpenPath(State, PathText)
    end;
    IdeDialog.SavePath(PathText, Caret, Pending):
    begin
      return SavePath(State, PathText, Pending, Cmd)
    end;
    IdeDialog.NoDialog, IdeDialog.ConfirmDirty(Pending):
    begin
      return State
    end
  end
end;

private function UpdateDirtyAction(
  State: IdeModel;
  Source: TuiControlId;
  Action: TuiAction;
  Pending: IdePendingCommand;
  Cmd: TuiCmdOutput
): IdeModel;
begin
  if IsIdeCommand(Source, Action, DirtySaveControlId(), DirtySaveAction()) then
  begin
    return RequestIdeSave(State, Pending, Cmd)
  end;
  if IsIdeCommand(Source, Action, DirtyDiscardControlId(), DirtyDiscardAction()) then
  begin
    return ResumePending(State, Pending, 'Changes discarded.', Cmd)
  end;
  if IsIdeCommand(Source, Action, DirtyCancelControlId(), DirtyCancelAction()) then
  begin
    return CloseDialog(State, 'Canceled.')
  end;
  return State
end;

/// Handles actions while a document dialog owns routing.

function UpdateIdeDialogAction(
  State: IdeModel;
  Source: TuiControlId;
  Action: TuiAction;
  Cmd: TuiCmdOutput
): IdeModel;
begin
  case State.Dialog of
    IdeDialog.ConfirmDirty(Pending):
    begin
      return UpdateDirtyAction(State, Source, Action, Pending, Cmd)
    end;
    IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending):
    begin
      if IsIdeCommand(Source, Action, DialogAcceptControlId(), DialogAcceptAction()) then
      begin
        return AcceptPathDialog(State, Cmd)
      end;
      if IsIdeCommand(Source, Action, DialogCancelControlId(), DialogCancelAction()) then
      begin
        return CancelIdeDialog(State)
      end;
      return State
    end;
    IdeDialog.NoDialog:
    begin
      return State
    end
  end
end;

/// Builds the initial model and loads a valid optional startup path.

function InitializeIdeDocumentFlow(Arguments: array of string): IdeModel;
begin
  if Std.Array.Length(Arguments) = 0 then
  begin
    return InitialIdeModel(None)
  end;
  if Std.Array.Length(Arguments) > 1 then
  begin
    return IdeStateWithMessage(InitialIdeModel(None), 'Expected at most one .fpas, .fpasprj, or .fpasworkspace path argument.')
  end;
  var Extension: string := Std.Str.ToLower(Std.Path.Extension(Arguments[0]));
  if ((Extension <> 'fpas') and (Extension <> 'fpasprj')) and (Extension <> 'fpasworkspace') then
  begin
    return IdeStateWithMessage(InitialIdeModel(None), 'Startup path must end with .fpas, .fpasprj, or .fpasworkspace.')
  end;
  return OpenPath(InitialIdeModel(None), Arguments[0])
end;
