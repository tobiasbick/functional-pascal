/// Root model and startup-state construction for the IDE.

unit Ide.App.Model;

uses
  Ide.Diagnostic.Model, Ide.Document.Model, Ide.Project.Model, Ide.Theme.Model, Ide.Workspace.Model,
  Std.Tui;

type
  /// Command resumed after a dirty-document decision.
  IdePendingCommand = enum
    NoPendingCommand;
    OpenDocument;
    CheckDocument;
    RunDocument;
    ExitApplication;
  end;
  /// Modal state owned by the root model.
  IdeDialog = enum
    NoDialog;
    OpenPath(PathText: string; Caret: integer);
    SavePath(PathText: string; Caret: integer; Pending: IdePendingCommand);
    ConfirmDirty(Pending: IdePendingCommand);
  end;
  /// Complete immutable application state.
  IdeModel = record
    Workspace: option of IdeWorkspace;
    Project: option of IdeProject;
    Document: IdeDocument;
    Dialog: IdeDialog;
    DialogPosition: option of TuiPoint;
    DialogDragOffset: option of TuiPoint;
    MessageText: string;
    MessageOffset: TuiPoint;
    Diagnostics: array of IdeDiagnostic;
    SelectedDiagnostic: option of integer;
    LastExitCode: option of integer;
    Focused: option of TuiControlId;
    Menu: TuiMenuState;
    Theme: IdeTheme;
  end;

/// Creates the clean initial model for an optional source path.

function InitialIdeModel(Path: option of string): IdeModel;
begin
  return record
    Workspace := None;
    Project := None;
    Document := NewIdeDocument(Path);
    Dialog := IdeDialog.NoDialog;
    DialogPosition := None;
    DialogDragOffset := None;
    MessageText := 'Ready';
    MessageOffset := TuiPoint.Create(0, 0);
    Diagnostics := [];
    SelectedDiagnostic := None;
    LastExitCode := None;
    Focused := None;
    Menu := TuiMenuState.Closed();
    Theme := IdeTheme.ClassicBlue;
  end
end;
