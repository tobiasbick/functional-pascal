/// Tui message dispatch for the IDE application model.

unit Ide.App.Update;

uses
  Ide.App.Actions, Ide.App.DocumentFlow, Ide.App.Model, Ide.Diagnostic.Model, Ide.Document.Model,
  Ide.Theme.Model, Ide.Theme.Palette, Std.Array, Std.Console, Std.Str, Std.Tui;

private function IdeState(
  State: IdeModel;
  Document: IdeDocument;
  MessageText: string;
  MessageOffset: TuiPoint;
  Diagnostics: array of IdeDiagnostic;
  SelectedDiagnostic: option of integer;
  Focused: option of TuiControlId
): IdeModel;
begin
  return record
    Workspace := State.Workspace;
    Project := State.Project;
    Document := Document;
    Dialog := State.Dialog;
    DialogPosition := State.DialogPosition;
    DialogDragOffset := State.DialogDragOffset;
    MessageText := MessageText;
    MessageOffset := MessageOffset;
    Diagnostics := Diagnostics;
    SelectedDiagnostic := SelectedDiagnostic;
    LastExitCode := State.LastExitCode;
    Focused := Focused;
    Menu := State.Menu;
    Theme := State.Theme;
  end
end;

private function IdeStateWithMenu(State: IdeModel; Menu: TuiMenuState): IdeModel;
begin
  mutable var Next: IdeModel := State;
  Next.Menu := Menu;
  return Next
end;

private function IdeStateWithTheme(State: IdeModel; Theme: IdeTheme; Cmd: TuiCmdOutput): IdeModel;
begin
  mutable var Next: IdeModel := State;
  Next.Theme := Theme;
  Cmd.SetPalette(IdeThemePalette(Theme));
  return Next
end;

private function MessageIsFocused(State: IdeModel): boolean;
begin
  case State.Focused of
    Some(Id):
    begin
      return Id.Value = MessageScrollControlId().Value
    end;
    None:
    begin
      return false
    end
  end
end;

private function SelectedDiagnosticForOffset(Diagnostics: array of IdeDiagnostic; Offset: TuiPoint): option of integer;
begin
  if Std.Array.Length(Diagnostics) = 0 then
  begin
    return None
  end;
  mutable var Selected: integer := 0;
  for Index: integer := 0 to Std.Array.Length(Diagnostics) - 1 do
  begin
    if Diagnostics[Index].MessageLine <= Offset.Y then
    begin
      Selected := Index
    end
  end;
  return Some(Selected)
end;

private function NavigateToSelectedDiagnostic(State: IdeModel): IdeModel;
begin
  case State.SelectedDiagnostic of
    Some(Index):
    begin
      if (Index < 0) or (Index >= Std.Array.Length(State.Diagnostics)) then
      begin
        return State
      end;
      var Diagnostic: IdeDiagnostic := State.Diagnostics[Index];
      var Document: IdeDocument := IdeDocumentAtSourcePosition(State.Document, Diagnostic.Line, Diagnostic.Column);
      return IdeState(State, Document, State.MessageText, State.MessageOffset, State.Diagnostics, State.SelectedDiagnostic, Some(EditorControlId()))
    end;
    None:
    begin
      return State
    end
  end
end;

private function UpdateAction(State: IdeModel; Source: TuiControlId; Action: TuiAction; Cmd: TuiCmdOutput): IdeModel;
begin
  if (Source.Value = DialogControlId().Value) and (Action.Value = DialogChangedAction().Value) then
  begin
    return CancelIdeDialog(State)
  end;
  case State.Dialog of
    IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending), IdeDialog.ConfirmDirty(Pending):
    begin
      return UpdateIdeDialogAction(State, Source, Action, Cmd)
    end;
    IdeDialog.NoDialog:
    begin
    end
  end;
  if IsIdeCommand(Source, Action, OpenControlId(), OpenAction()) then
  begin
    return RequestIdeOpen(State)
  end;
  if IsIdeCommand(Source, Action, SaveControlId(), SaveAction()) then
  begin
    return RequestIdeSave(State, IdePendingCommand.NoPendingCommand, Cmd)
  end;
  if IsIdeCommand(Source, Action, CheckControlId(), CheckAction()) then
  begin
    return RequestIdeSave(State, IdePendingCommand.CheckDocument, Cmd)
  end;
  if IsIdeCommand(Source, Action, RunControlId(), RunAction()) then
  begin
    return RequestIdeSave(State, IdePendingCommand.RunDocument, Cmd)
  end;
  if IsIdeCommand(Source, Action, ExitControlId(), ExitAction()) then
  begin
    return RequestIdeExit(State, Cmd)
  end;
  if Action.Value = LightThemeAction().Value then
  begin
    return IdeStateWithTheme(State, IdeTheme.Light, Cmd)
  end;
  if Action.Value = DarkThemeAction().Value then
  begin
    return IdeStateWithTheme(State, IdeTheme.Dark, Cmd)
  end;
  if Action.Value = MonochromeThemeAction().Value then
  begin
    return IdeStateWithTheme(State, IdeTheme.Monochrome, Cmd)
  end;
  return State
end;

private function UpdateShortcut(State: IdeModel; Key: TuiKeyEvent; Cmd: TuiCmdOutput): IdeModel;
begin
  if ((((Key.kind = Std.Console.KeyKind.Enter) and not Key.ctrl) and not Key.alt) and not Key.meta) and
     MessageIsFocused(State) then
  begin
    case State.Dialog of
      IdeDialog.NoDialog:
      begin
        return NavigateToSelectedDiagnostic(State)
      end;
      IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending), IdeDialog.ConfirmDirty(Pending):
      begin
        return State
      end
    end
  end;
  if (((Key.kind = Std.Console.KeyKind.F2) and not Key.ctrl) and not Key.alt) and not Key.meta then
  begin
    return UpdateAction(State, SaveControlId(), SaveAction(), Cmd)
  end;
  if (((Key.kind = Std.Console.KeyKind.F9) and not Key.ctrl) and not Key.alt) and not Key.meta then
  begin
    return UpdateAction(State, CheckControlId(), CheckAction(), Cmd)
  end;
  if ((Key.kind = Std.Console.KeyKind.F9) and Key.ctrl) and (not Key.alt and not Key.meta) then
  begin
    return UpdateAction(State, RunControlId(), RunAction(), Cmd)
  end;
  if (((Key.kind = Std.Console.KeyKind.Character) and Key.alt) and not Key.ctrl) and
     (not Key.meta and (Std.Str.ToLower(Key.ch) = 'x')) then
  begin
    return UpdateAction(State, ExitControlId(), ExitAction(), Cmd)
  end;
  return State
end;

/// Builds the initial model and loads a valid optional startup path.

function InitializeIdeFromArguments(Arguments: array of string): IdeModel;
begin
  return InitializeIdeDocumentFlow(Arguments)
end;

/// Applies one framework message and performs requested document I/O synchronously.

function UpdateIde(State: IdeModel; Msg: TuiMsg; Cmd: TuiCmdOutput): IdeModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.FocusChanged(Previous, Current):
    begin
      return IdeState(State, State.Document, State.MessageText, State.MessageOffset, State.Diagnostics, State.SelectedDiagnostic, Current)
    end;
    TuiMsg.Action(Source, Action):
    begin
      return UpdateAction(State, Source, Action, Cmd)
    end;
    TuiMsg.MenuChanged(Source, Action, Menu):
    begin
      if IsIdeCommand(Source, Action, MenuControlId(), MenuChangedAction()) then
      begin
        return IdeStateWithMenu(State, Menu)
      end;
      return State
    end;
    TuiMsg.DialogChanged(Source, Action, Position, DragOffset):
    begin
      if IsIdeCommand(Source, Action, DialogControlId(), DialogChangedAction()) then
      begin
        case State.Dialog of
          IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending), IdeDialog.ConfirmDirty(Pending):
          begin
            mutable var Next: IdeModel := State;
            Next.DialogPosition := Some(Position);
            Next.DialogDragOffset := DragOffset;
            return Next
          end;
          IdeDialog.NoDialog:
          begin
          end
        end
      end;
      return State
    end;
    TuiMsg.TextChanged(Source, Action, Text, Caret):
    begin
      if IsIdeCommand(Source, Action, DialogPathControlId(), DialogPathChangedAction()) then
      begin
        return UpdateIdePathInput(State, Text, Caret)
      end;
      return State
    end;
    TuiMsg.TextAreaChanged(Source, Action, Text, Caret, Offset):
    begin
      if IsIdeCommand(Source, Action, EditorControlId(), EditorChangedAction()) then
      begin
        return IdeState(State, IdeDocumentWithTextArea(State.Document, Text, Caret, Offset), State.MessageText, State.MessageOffset, State.Diagnostics, State.SelectedDiagnostic, State.Focused)
      end;
      return State
    end;
    TuiMsg.QuitRequested:
    begin
      case State.Dialog of
        IdeDialog.NoDialog:
        begin
          return RequestIdeExit(State, Cmd)
        end;
        IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending), IdeDialog.ConfirmDirty(Pending):
        begin
          return CancelIdeDialog(State)
        end
      end
    end;
    TuiMsg.Key(Key):
    begin
      return UpdateShortcut(State, Key, Cmd)
    end;
    TuiMsg.ScrollChanged(Source, Action, ScrollOffset):
    begin
      case State.Dialog of
        IdeDialog.NoDialog:
        begin
          if IsIdeCommand(Source, Action, MessageScrollControlId(), MessageScrollChangedAction()) then
          begin
            return IdeState(State, State.Document, State.MessageText, ScrollOffset, State.Diagnostics, SelectedDiagnosticForOffset(State.Diagnostics, ScrollOffset), State.Focused)
          end
        end;
        IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending), IdeDialog.ConfirmDirty(Pending):
        begin
        end
      end;
      return State
    end;
    TuiMsg.Pointer(Pointer), TuiMsg.Tick(Delta), TuiMsg.Resize(Size), TuiMsg.CheckChanged(Source, Action, Checked), TuiMsg.SelectionChanged(Source, Action, Selected):
    begin
      return State
    end
  end
end;
