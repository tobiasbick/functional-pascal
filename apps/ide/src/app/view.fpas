/// Fixed single-document IDE surface and modal document dialogs.

unit Ide.App.View;

uses Ide.App.Actions, Ide.App.Model, Ide.Document.Model, Std.Array, Std.Conv, Std.Str, Std.Tui;

private function FixedRowSettings(): TuiLayoutSettings;
begin
  return TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Create(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Fixed), TuiAlignment.Fill(), 0)
end;

private function EditorSettings(): TuiLayoutSettings;
begin
  return TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Expanding(), TuiAlignment.Fill(), 1)
end;

private function MessageSettings(): TuiLayoutSettings;
begin
  return FixedRowSettings().WithFixedHeight(5)
end;

private function IsSelectedDiagnosticLine(State: IdeModel; MessageLine: integer): boolean;
begin
  case State.SelectedDiagnostic of
    Some(Index):
    begin
      if (Index < 0) or (Index >= Std.Array.Length(State.Diagnostics)) then
      begin
        return false
      end;
      return State.Diagnostics[Index].MessageLine = MessageLine
    end;
    None:
    begin
      return false
    end
  end
end;

private function ViewCommandBar(State: IdeModel): TuiElement;
begin
  var FileId: TuiMenuNodeId := TuiMenuNodeId.Create(1);
  var EditId: TuiMenuNodeId := TuiMenuNodeId.Create(2);
  var RunId: TuiMenuNodeId := TuiMenuNodeId.Create(3);
  var OptionsId: TuiMenuNodeId := TuiMenuNodeId.Create(4);
  var ThemeId: TuiMenuNodeId := TuiMenuNodeId.Create(5);
  return TuiElementBuilders.MakeMenu(MenuControlId(), [
                                                        TuiMenuNodeBuilders.Submenu(FileId, None, 'File', 'F'),
                                                        TuiMenuNodeBuilders.Submenu(EditId, None, 'Edit', 'E'),
                                                        TuiMenuNodeBuilders.Submenu(RunId, None, 'Run', 'R'),
                                                        TuiMenuNodeBuilders.Submenu(OptionsId, None, 'Options', 'O'),
                                                        TuiMenuNodeBuilders.CommandWithShortcut(TuiMenuNodeId.Create(10), Some(FileId), 'Open...', 'O', OpenAction(), TuiKeyGesture.Create(TuiKeyKind.Character, 'o', false, true, false, false, 'Ctrl+O')),
                                                        TuiMenuNodeBuilders.CommandWithShortcut(TuiMenuNodeId.Create(11), Some(FileId), 'Save', 'S', SaveAction(), TuiKeyGesture.Create(TuiKeyKind.F2, '', false, false, false, false, 'F2')),
                                                        TuiMenuNodeBuilders.Separator(TuiMenuNodeId.Create(12), FileId),
                                                        TuiMenuNodeBuilders.CommandWithShortcut(TuiMenuNodeId.Create(13), Some(FileId), 'Exit', 'X', ExitAction(), TuiKeyGesture.Create(TuiKeyKind.Character, 'x', false, false, true, false, 'Alt+X')),
                                                        TuiMenuNodeBuilders.DisabledCommand(TuiMenuNodeId.Create(20), Some(EditId), 'Undo', 'U', TuiAction.Create(20)),
                                                        TuiMenuNodeBuilders.CommandWithShortcut(TuiMenuNodeId.Create(30), Some(RunId), 'Check', 'C', CheckAction(), TuiKeyGesture.Create(TuiKeyKind.F9, '', false, false, false, false, 'F9')),
                                                        TuiMenuNodeBuilders.CommandWithShortcut(TuiMenuNodeId.Create(31), Some(RunId), 'Run', 'R', RunAction(), TuiKeyGesture.Create(TuiKeyKind.F9, '', false, true, false, false, 'Ctrl+F9')),
                                                        TuiMenuNodeBuilders.Submenu(ThemeId, Some(OptionsId), 'Theme', 'T'),
                                                        TuiMenuNodeBuilders.Command(TuiMenuNodeId.Create(50), Some(ThemeId), 'Classic Blue', 'C', ClassicBlueThemeAction()),
                                                        TuiMenuNodeBuilders.Command(TuiMenuNodeId.Create(51), Some(ThemeId), 'Dark', 'D', DarkThemeAction()),
                                                        TuiMenuNodeBuilders.Command(TuiMenuNodeId.Create(52), Some(ThemeId), 'Monochrome', 'M', MonochromeThemeAction())

                                                      ], State.Menu, MenuChangedAction())
end;

private function ViewEditor(State: IdeModel): TuiElement;
begin
  return TuiElementBuilders.MakeLayout(EditorSettings(), TuiElementBuilders.MakeWindow('Editor', [
                                                                                                   TuiElementBuilders.MakeTextArea(EditorControlId(), State.Document.Text, State.Document.Caret, State.Document.Offset, EditorChangedAction())

                                                                                                 ]))
end;

private function ViewMessages(State: IdeModel): TuiElement;
begin
  var Lines: array of string := Std.Str.Split(State.MessageText, Std.Str.Chr(10));
  mutable var Items: array of TuiElement := [];
  for Index: integer := 0 to Std.Array.Length(Lines) - 1 do
  begin
    mutable var LineText: string := Lines[Index];
    if IsSelectedDiagnosticLine(State, Index) then
    begin
      LineText := '> ' + LineText
    end;
    Std.Array.Push(Items, TuiElementBuilders.MakeLabel(LineText))
  end;
  var Content: TuiElement := TuiElementBuilders.MakeColumn(Items);
  var Scroll: TuiElement := TuiElementBuilders.MakeScroll(MessageScrollControlId(), State.MessageOffset, MessageScrollChangedAction(), Content);
  return TuiElementBuilders.MakeLayout(MessageSettings(), TuiElementBuilders.MakeWindow('Messages', [
                                                                                                      Scroll

                                                                                                    ]))
end;

private function CaretLine(Document: IdeDocument): integer;
begin
  mutable var Line: integer := 1;
  for Index: integer := 0 to Document.Caret - 1 do
  begin
    if Std.Str.CharAt(Document.Text, Index) = Std.Str.Chr(10) then
    begin
      Line := Line + 1
    end
  end;
  return Line
end;

private function CaretColumn(Document: IdeDocument): integer;
begin
  mutable var Column: integer := 1;
  for Index: integer := 0 to Document.Caret - 1 do
  begin
    if Std.Str.CharAt(Document.Text, Index) = Std.Str.Chr(10) then
    begin
      Column := 1
    end
    else
    begin
      Column := Column + 1
    end
  end;
  return Column
end;

private function StatusText(State: IdeModel): string;
begin
  mutable var StateText: string := 'clean';
  if IsIdeDocumentDirty(State.Document) then
  begin
    StateText := 'modified'
  end;
  return (((((StateText + ' | Ln ') + IntToStr(CaretLine(State.Document))) + ', Col ') + IntToStr(CaretColumn(State.Document))) + ' | F2 Save | F9 Check | Ctrl+F9 Run')
end;

private function ViewStatus(State: IdeModel): TuiElement;
begin
  return TuiElementBuilders.MakeStatusLine([TuiStatusItemBuilders.MakeHint(StatusText(State))])
end;

private function OpenPathText(State: IdeModel): string;
begin
  case State.Project of
    Some(Project):
    begin
      return (Project.Name + ' | ') + IdeDocumentPathText(State.Document)
    end;
    None:
    begin
      return IdeDocumentPathText(State.Document)
    end
  end
end;

private function ViewPathDialog(
  State: IdeModel;
  Title: string;
  AcceptText: string;
  PathText: string;
  Caret: integer
): TuiElement;
begin
  return TuiElementBuilders.MakeMovableDialog(DialogControlId(), Title, State.DialogPosition, State.DialogDragOffset, DialogChangedAction(), [
                                                                                                                                               TuiElementBuilders.MakeColumn([

                                                                                                                                                                               TuiElementBuilders.MakeLabel('Path'),

                                                                                                                                                                               TuiElementBuilders.MakeInput(DialogPathControlId(), PathText, Caret, DialogPathChangedAction()),

                                                                                                                                                                               TuiElementBuilders.MakeRow([



                                                                                                                                                                                                            TuiElementBuilders.MakeButton(DialogAcceptControlId(), AcceptText, DialogAcceptAction()),



                                                                                                                                                                                                            TuiElementBuilders.MakeButton(DialogCancelControlId(), 'Cancel', DialogCancelAction())







                                                                                                                                                                                                          ])



                                                                                                                                                                             ])

                                                                                                                                             ])
end;

private function ViewDirtyDialog(State: IdeModel): TuiElement;
begin
  return TuiElementBuilders.MakeMovableDialog(DialogControlId(), 'Unsaved changes', State.DialogPosition, State.DialogDragOffset, DialogChangedAction(), [
                                                                                                                                                           TuiElementBuilders.MakeColumn([

                                                                                                                                                                                           TuiElementBuilders.MakeLabel('Save changes?'),

                                                                                                                                                                                           TuiElementBuilders.MakeRow([



                                                                                                                                                                                                                        TuiElementBuilders.MakeButton(DirtySaveControlId(), 'Save', DirtySaveAction()),



                                                                                                                                                                                                                        TuiElementBuilders.MakeButton(DirtyDiscardControlId(), 'Discard', DirtyDiscardAction()),



                                                                                                                                                                                                                        TuiElementBuilders.MakeButton(DirtyCancelControlId(), 'Cancel', DirtyCancelAction())







                                                                                                                                                                                                                      ])



                                                                                                                                                                                         ])

                                                                                                                                                         ])
end;

private function ViewDialog(State: IdeModel): TuiElement;
begin
  case State.Dialog of
    IdeDialog.NoDialog:
    begin
      return TuiElementBuilders.MakeEmpty()
    end;
    IdeDialog.OpenPath(PathText, Caret):
    begin
      return ViewPathDialog(State, 'Open', 'Open', PathText, Caret)
    end;
    IdeDialog.SavePath(PathText, Caret, Pending):
    begin
      return ViewPathDialog(State, 'Save As', 'Save', PathText, Caret)
    end;
    IdeDialog.ConfirmDirty(Pending):
    begin
      return ViewDirtyDialog(State)
    end
  end
end;

private function ViewFocus(State: IdeModel): option of TuiControlId;
begin
  case State.Focused of
    Some(Id):
    begin
      return Some(Id)
    end;
    None:
    begin
      return Some(EditorControlId())
    end
  end
end;

/// Builds the complete fixed surface and its optional active dialog.

function ViewIde(State: IdeModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(ViewFocus(State), [
                                                            TuiElementBuilders.MakeColumn([

                                                                                            ViewCommandBar(State),

                                                                                            TuiElementBuilders.MakeLayout(FixedRowSettings(), TuiElementBuilders.MakeLabel(OpenPathText(State))),

                                                                                            ViewEditor(State),

                                                                                            ViewMessages(State),

                                                                                            ViewStatus(State)



                                                                                          ]),
                                                            ViewDialog(State)

                                                          ])
end;
