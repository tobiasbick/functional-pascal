/// Defensive parsing of compiler diagnostic headers captured by the IDE.

unit Ide.Diagnostic.Parser;

uses Ide.Diagnostic.Model, Std.Array, Std.Str;

private function DiagnosticMarker(LineText: string): integer;
begin
  var ErrorAt: integer := Std.Str.IndexOf(LineText, ': error[');
  var WarningAt: integer := Std.Str.IndexOf(LineText, ': warning[');
  if ErrorAt < 0 then
  begin
    return WarningAt
  end;
  if WarningAt < 0 then
  begin
    return ErrorAt
  end;
  if ErrorAt < WarningAt then
  begin
    return ErrorAt
  end;
  return WarningAt
end;

private function ParsePositiveDecimal(Text: string): option of integer;
begin
  var Count: integer := Std.Str.Length(Text);
  if (Count < 1) or (Count > 9) then
  begin
    return None
  end;
  mutable var Value: integer := 0;
  for Index: integer := 0 to Count - 1 do
  begin
    var Digit: integer := Std.Str.Ord(Std.Str.CharAt(Text, Index)) - Std.Str.Ord('0');
    if (Digit < 0) or (Digit > 9) then
    begin
      return None
    end;
    Value := (Value * 10) + Digit
  end;
  if Value < 1 then
  begin
    return None
  end;
  return Some(Value)
end;

private function NormalizePath(Path: string): string;
begin
  mutable var Normalized: string := Std.Str.Replace(Path, Std.Str.Chr(92), '/');
  while Std.Str.StartsWith(Normalized, './') do
  begin
    Normalized := Std.Str.Delete(Normalized, 0, 2)
  end;
  if Std.Str.Length(Normalized) >= 2 then
  begin
    if Std.Str.CharAt(Normalized, 1) = ':' then
    begin
      return Std.Str.ToLower(Normalized)
    end
  end;
  return Normalized
end;

private function PathsMatch(Left: string; Right: string): boolean;
begin
  var NormalizedLeft: string := NormalizePath(Left);
  var NormalizedRight: string := NormalizePath(Right);
  if NormalizedLeft = NormalizedRight then
  begin
    return true
  end;
  if (NormalizedLeft = '') or (NormalizedRight = '') then
  begin
    return false
  end;
  return Std.Str.EndsWith(NormalizedLeft, '/' + NormalizedRight) or
         Std.Str.EndsWith(NormalizedRight, '/' + NormalizedLeft)
end;

private function UnwrapDiagnosticPath(PathText: string): string;
begin
  var Prefix: string := 'Cannot build test program `';
  if Std.Str.StartsWith(PathText, Prefix) and Std.Str.EndsWith(PathText, '`') then
  begin
    return Std.Str.Substring(PathText, Std.Str.Length(Prefix), (Std.Str.Length(PathText) - Std.Str.Length(Prefix)) -
                                                               1)
  end;
  return PathText
end;

private function ParseDiagnosticLine(LineText: string; MessageLine: integer; DocumentPath: string): option of IdeDiagnostic;
begin
  var Marker: integer := DiagnosticMarker(LineText);
  if Marker < 0 then
  begin
    return None
  end;
  var MarkerTail: string := Std.Str.Substring(LineText, Marker, Std.Str.Length(LineText) - Marker);
  if Std.Str.IndexOf(MarkerTail, ']: ') < 0 then
  begin
    return None
  end;
  var Location: string := Std.Str.Substring(LineText, 0, Marker);
  var ColumnSeparator: integer := Std.Str.LastIndexOf(Location, ':');
  if ColumnSeparator < 0 then
  begin
    return None
  end;
  var BeforeColumn: string := Std.Str.Substring(Location, 0, ColumnSeparator);
  var LineSeparator: integer := Std.Str.LastIndexOf(BeforeColumn, ':');
  if LineSeparator < 0 then
  begin
    return None
  end;
  var Path: string := UnwrapDiagnosticPath(Std.Str.Substring(BeforeColumn, 0, LineSeparator));
  if not PathsMatch(Path, DocumentPath) then
  begin
    return None
  end;
  var LineTextValue: string := Std.Str.Trim(Std.Str.Substring(BeforeColumn, LineSeparator + 1, (Std.Str.Length(BeforeColumn) - LineSeparator) -
                                                                                               1));
  var ColumnTextValue: string := Std.Str.Trim(Std.Str.Substring(Location, ColumnSeparator + 1, (Std.Str.Length(Location) - ColumnSeparator) -
                                                                                               1));
  case ParsePositiveDecimal(LineTextValue) of
    Some(Line):
    begin
      case ParsePositiveDecimal(ColumnTextValue) of
        Some(Column):
        begin
          return Some(record
            Path := Path;
            Line := Line;
            Column := Column;
            MessageLine := MessageLine;
          end)
        end;
        None:
        begin
          return None
        end
      end
    end;
    None:
    begin
      return None
    end
  end
end;

/// Returns valid diagnostic locations belonging to the current document.

function ParseIdeDiagnostics(MessageText: string; DocumentPath: string): array of IdeDiagnostic;
begin
  var Lines: array of string := Std.Str.Split(MessageText, Std.Str.Chr(10));
  mutable var Diagnostics: array of IdeDiagnostic := [];
  for MessageLine: integer := 0 to Std.Array.Length(Lines) - 1 do
  begin
    case ParseDiagnosticLine(Lines[MessageLine], MessageLine, DocumentPath) of
      Some(Diagnostic):
      begin
        Std.Array.Push(Diagnostics, Diagnostic)
      end;
      None:
      begin
      end
    end
  end;
  return Diagnostics
end;
