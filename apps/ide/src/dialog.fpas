/// Command dispatch for FPAS IDE dialogs.

unit Ide.Dialog;

uses Ide.Dialog.About, Ide.Menu, Std.Tui;

/// Handle IDE dialog commands. Returns `true` when `CommandId` was consumed.

function HandleCommand(App: Application; CommandId: integer): boolean;
begin
  if CommandId = CmdHelpAbout then
  begin
    ShowAbout(App);
    return true
  end;
  return false
end;
