/// Turbo Vision-style About dialog for the FPAS IDE.

unit Ide.Dialog.About;

uses Std.Tui;

function AboutMessage(): string;
begin
  return 'FPAS IDE

Functional Pascal IDE

Built with Turbo Vision'
end;

/// Show the modal About dialog and block until the user dismisses it.

procedure ShowAbout(App: Application);
begin
  var CloseCommand: integer := Application.MessageBox(App, AboutMessage(), 1028);
  if CloseCommand <> Command.Accept then
  begin
    return
  end
end;
