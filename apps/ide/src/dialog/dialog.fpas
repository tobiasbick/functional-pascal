/// Command dispatch for FPAS IDE dialogs.

unit Ide.Dialog;

uses Ide.Dialog.About, Ide.Dialog.Open, Ide.Ui.Menu, Std.Tui;

/// Handle IDE dialog commands. Returns `true` when `CommandId` was consumed.

function HandleCommand(App: Application; CommandId: integer; Status: StatusLine): boolean;
begin
  if CommandId = CmdFileOpen then
  begin
    ShowOpen(App, Status);
    return true
  end;
  if CommandId = CmdHelpAbout then
  begin
    ShowAbout(App);
    return true
  end;
  return false
end;
