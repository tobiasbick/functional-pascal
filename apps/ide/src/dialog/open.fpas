/// File open flow for the FPAS IDE.

unit Ide.Dialog.Open;

uses
  Ide.Ui.Status, Ide.Workspace.Session, Ide.Workspace.TreeWindow, Std.Option, Std.Result, Std.Tui;

private function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

private procedure RefreshStatus(Status: StatusLine);
begin
  StatusLine.SetItems(Status, StatusItems())
end;

/// Show the file picker and register the chosen path in the workspace session.

procedure ShowOpen(App: Application; Status: StatusLine);
begin
  var Selected: option of string := Application.RunFileDialog(App, Bounds(10, 5, 50, 14), 'Open', '*', None);
  if IsNone(Selected) then
  begin
    var _: integer := Application.MessageBox(App, 'Open canceled.', MessageBoxOption.Information +
                                                                    MessageBoxOption.OkButton);
    return
  end;
  var Path: string := Std.Option.Unwrap(Selected);
  case OpenPath(Path) of
    Ok(_):
    begin
      RefreshStatus(Status);
      if LoadedName() <> '' then
      begin
        Show(App)
      end
    end;
    Error(E):
    begin
      var BoxOptions: integer := 1 + 1024;
      var _: integer := Application.MessageBox(App, E, BoxOptions)
    end
  end
end;
