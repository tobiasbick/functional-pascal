program Ide;

uses Ide.App.Model, Ide.App.Update, Ide.App.View, Ide.Theme.Palette, Std.Args, Std.Array, Std.Tui;

function ProgramArguments(): array of string;
begin
  mutable var Arguments: array of string := [];
  for Index: integer := 0 to ParamCount() - 1 do
  begin
    Std.Array.Push(Arguments, ParamStr(Index))
  end;
  return Arguments
end;

begin
  var Initial: IdeModel := InitializeIdeFromArguments(ProgramArguments());
  var _: IdeModel := TuiApplication.RunWithPalette(Initial, UpdateIde, ViewIde, IdeThemePalette(Initial.Theme))
end.
