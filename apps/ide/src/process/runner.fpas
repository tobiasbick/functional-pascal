/// Process-execution ownership boundary for IDE Check and Run operations.

unit Ide.Process.Runner;

uses Std.Conv, Std.Proc, Std.Str;

type
  /// Compiler operation requested by the IDE.
  IdeProcessKind = enum
    CheckProcess;
    RunProcess;
  end;
  /// Completed compiler operation displayed by the IDE.
  IdeProcessReport = record
    ExitCode: integer;
    MessageText: string;
  end;

/// Builds the exact compiler arguments for one document operation.

function IdeProcessArguments(Kind: IdeProcessKind; Path: string): array of string;
begin
  case Kind of
    IdeProcessKind.CheckProcess:
    begin
      return ['check', Path]
    end;
    IdeProcessKind.RunProcess:
    begin
      return ['run', Path]
    end
  end
end;

private function ProcessLabel(Kind: IdeProcessKind): string;
begin
  case Kind of
    IdeProcessKind.CheckProcess:
    begin
      return 'Check'
    end;
    IdeProcessKind.RunProcess:
    begin
      return 'Run'
    end
  end
end;

private function NormalizeOutput(Text: string): string;
begin
  mutable var Normalized: string := Std.Str.Replace(Text, Std.Str.Chr(13) + Std.Str.Chr(10), Std.Str.Chr(10));
  Normalized := Std.Str.Replace(Normalized, Std.Str.Chr(13), Std.Str.Chr(10));
  while (Std.Str.Length(Normalized) > 0) and Std.Str.EndsWith(Normalized, Std.Str.Chr(10)) do
  begin
    Normalized := Std.Str.Delete(Normalized, Std.Str.Length(Normalized) - 1, 1)
  end;
  if Normalized = '' then
  begin
    return '(empty)'
  end;
  return Normalized
end;

/// Formats a completed compiler operation for the IDE message area.

function FormatIdeProcessOutput(Kind: IdeProcessKind; Output: ProcessOutput): string;
begin
  var NewLine: string := Std.Str.Chr(10);
  return (((((((((ProcessLabel(Kind) + ' exit code: ') + Std.Conv.IntToStr(Output.ExitCode)) + NewLine) + 'stdout:') + NewLine) + NormalizeOutput(Output.Stdout)) + NewLine) + 'stderr:') + NewLine) +
         NormalizeOutput(Output.Stderr)
end;

/// Runs one document operation with an explicit executable.

function RunIdeProcessWithExecutable(Kind: IdeProcessKind; Path: string; Executable: string): result of IdeProcessReport, string;
begin
  case Std.Proc.RunCapture(Executable, IdeProcessArguments(Kind, Path)) of
    Ok(Output):
    begin
      return Ok(record
        ExitCode := Output.ExitCode;
        MessageText := FormatIdeProcessOutput(Kind, Output);
      end)
    end;
    Error(Message):
    begin
      return Error('Process start failed: ' + Message)
    end
  end
end;

/// Resolves the current compiler and runs one document operation.

function RunIdeProcess(Kind: IdeProcessKind; Path: string): result of IdeProcessReport, string;
begin
  case Std.Proc.CurrentExecutable() of
    Ok(Executable):
    begin
      return RunIdeProcessWithExecutable(Kind, Path, Executable)
    end;
    Error(Message):
    begin
      return Error('Compiler executable lookup failed: ' + Message)
    end
  end
end;
