/// File loading entry point for one FPAS project manifest.

unit Ide.Project.Loader;

uses Ide.Project.Manifest, Ide.Project.Model, Ide.Project.Sources, Std.Fs, Std.Path, Std.Str;

/// Reads, validates, and resolves one `.fpasprj` manifest.

function LoadIdeProject(Path: string): result of IdeProject, string;
begin
  if Std.Str.ToLower(Std.Path.Extension(Path)) <> 'fpasprj' then
  begin
    return Error('Project path must end with .fpasprj.')
  end;
  case Std.Fs.ReadText(Path) of
    Ok(ManifestText):
    begin
      case ParseIdeProjectManifest(ManifestText) of
        Ok(Manifest):
        begin
          return ResolveIdeProject(Path, Manifest)
        end;
        Error(Message):
        begin
          return Error(Message)
        end
      end
    end;
    Error(Message):
    begin
      return Error('Could not read project manifest: ' + Message)
    end
  end
end;
