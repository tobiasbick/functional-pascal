/// In-memory representation of one directly opened FPAS project.

unit Ide.Project.Model;

uses Std.Array;

type
  /// Supported project kinds from an `.fpasprj` manifest.
  IdeProjectKind = enum
    ProgramProject;
    LibraryProject;
    TestProject;
  end;
  /// Validated project data retained by the IDE session.
  IdeProject = record
    Path: string;
    Root: string;
    ManifestText: string;
    Name: string;
    Kind: IdeProjectKind;
    MainFile: option of string;
    SourceFiles: array of string;
  end;

/// Returns the source document shown immediately after opening a project.

function IdeProjectInitialFile(Project: IdeProject): option of string;
begin
  case Project.MainFile of
    Some(Path):
    begin
      return Some(Path)
    end;
    None:
    begin
    end
  end;
  if Std.Array.Length(Project.SourceFiles) = 0 then
  begin
    return None
  end;
  return Some(Project.SourceFiles[0])
end;
