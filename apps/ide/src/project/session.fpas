/// Atomic loading of a project and its initial source document.

unit Ide.Project.Session;

uses Ide.Document.Io, Ide.Document.Model, Ide.Project.Loader, Ide.Project.Model;

type
  /// Fully loaded data required to replace the current IDE session.
  IdeOpenedProject = record
    Project: IdeProject;
    Document: IdeDocument;
  end;

/// Loads a validated project and its initial source as one operation.

function LoadIdeProjectSession(Path: string): result of IdeOpenedProject, string;
begin
  case LoadIdeProject(Path) of
    Ok(Project):
    begin
      case IdeProjectInitialFile(Project) of
        Some(SourcePath):
        begin
          case ReadIdeDocument(SourcePath) of
            Ok(Document):
            begin
              return Ok(record Project := Project; Document := Document; end)
            end;
            Error(Message):
            begin
              return Error('Could not open project source: ' + Message)
            end
          end
        end;
        None:
        begin
          return Error('Project contains no source document.')
        end
      end
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end
end;
