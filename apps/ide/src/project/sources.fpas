/// Direct source resolution for one validated FPAS project manifest.

unit Ide.Project.Sources;

uses Ide.Project.Manifest, Ide.Project.Model, Std.Array, Std.Fs, Std.Path, Std.Str;

private function ContainsPath(Paths: array of string; Path: string): boolean;
begin
  for Index: integer := 0 to Std.Array.Length(Paths) - 1 do
  begin
    if Paths[Index] = Path then
    begin
      return true
    end
  end;
  return false
end;

private function ResolvePatterns(Root: string; Patterns: array of string; RequireMatches: boolean): result of array of string, string;
begin
  mutable var Paths: array of string := [];
  for PatternIndex: integer := 0 to Std.Array.Length(Patterns) - 1 do
  begin
    var Pattern: string := Std.Path.Join([Root, Patterns[PatternIndex]]);
    case Std.Fs.Glob(Pattern) of
      Ok(Matches):
      begin
        if RequireMatches and (Std.Array.Length(Matches) = 0) then
        begin
          return Error('Source pattern matched no files: ' + Patterns[PatternIndex])
        end;
        for MatchIndex: integer := 0 to Std.Array.Length(Matches) - 1 do
        begin
          var Path: string := Std.Path.Normalize(Matches[MatchIndex]);
          if Std.Str.ToLower(Std.Path.Extension(Path)) <> 'fpas' then
          begin
            return Error('Project source is not an .fpas file: ' + Path)
          end;
          if not ContainsPath(Paths, Path) then
          begin
            Std.Array.Push(Paths, Path)
          end
        end
      end;
      Error(Message):
      begin
        return Error((('Invalid source pattern ' + Patterns[PatternIndex]) + ': ') + Message)
      end
    end
  end;
  return Ok(Paths)
end;

private function RemoveExcludedPaths(Included: array of string; Excluded: array of string): array of string;
begin
  mutable var Paths: array of string := [];
  for Index: integer := 0 to Std.Array.Length(Included) - 1 do
  begin
    if not ContainsPath(Excluded, Included[Index]) then
    begin
      Std.Array.Push(Paths, Included[Index])
    end
  end;
  return Paths
end;

private function ResolveMainFile(Root: string; Kind: IdeProjectKind; MainText: option of string): result of option of string, string;
begin
  if Kind = IdeProjectKind.ProgramProject then
  begin
    case MainText of
      Some(Text):
      begin
        var Path: string := Std.Path.Normalize(Std.Path.Join([Root, Text]));
        if Std.Str.ToLower(Std.Path.Extension(Path)) <> 'fpas' then
        begin
          return Error('project.main must reference an .fpas file.')
        end;
        if not Std.Fs.IsFile(Path) then
        begin
          return Error('Project main file does not exist: ' + Path)
        end;
        return Ok(Some(Path))
      end;
      None:
      begin
        return Error('Program project requires project.main.')
      end
    end
  end;
  case MainText of
    Some(Text):
    begin
      return Error('Only program projects may define project.main.')
    end;
    None:
    begin
      return Ok(None)
    end
  end
end;

private function WithMainFile(Paths: array of string; MainFile: option of string): array of string;
begin
  case MainFile of
    Some(Path):
    begin
      if ContainsPath(Paths, Path) then
      begin
        return Paths
      end;
      mutable var ResultPaths: array of string := [Path];
      for Index: integer := 0 to Std.Array.Length(Paths) - 1 do
      begin
        Std.Array.Push(ResultPaths, Paths[Index])
      end;
      return ResultPaths
    end;
    None:
    begin
      return Paths
    end
  end
end;

/// Resolves the main file and direct source list relative to a manifest path.

function ResolveIdeProject(Path: string; Manifest: IdeProjectManifest): result of IdeProject, string;
begin
  var Root: string := Std.Path.Normalize(Std.Path.DirName(Path));
  mutable var MainFile: option of string := None;
  case ResolveMainFile(Root, Manifest.Kind, Manifest.MainText) of
    Ok(Value):
    begin
      MainFile := Value
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;
  mutable var Included: array of string := [];
  mutable var Excluded: array of string := [];
  case ResolvePatterns(Root, Manifest.IncludePatterns, true) of
    Ok(Value):
    begin
      Included := Value
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;
  case ResolvePatterns(Root, Manifest.ExcludePatterns, false) of
    Ok(Value):
    begin
      Excluded := Value
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;
  var SourceFiles: array of string := WithMainFile(RemoveExcludedPaths(Included, Excluded), MainFile);
  if Std.Array.Length(SourceFiles) = 0 then
  begin
    return Error('Project contains no source files after exclusions.')
  end;
  return Ok(record
    Path := Std.Path.Normalize(Path);
    Root := Root;
    ManifestText := Manifest.ManifestText;
    Name := Manifest.Name;
    Kind := Manifest.Kind;
    MainFile := MainFile;
    SourceFiles := SourceFiles;
  end)
end;
