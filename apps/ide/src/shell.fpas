/// TUI shell for the FPAS IDE. See docs/pascal/std/tui/app/README.md.

unit Ide.Shell;

uses Ide.Dialog, Ide.Menu, Ide.Status, Std.Tui;

private mutable var LastCommand: integer := -1;

private function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

function LastCommandId(): integer;
begin
  return LastCommand
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdFileExit then
  begin
    if LastCommand = -1 then
    begin
      LastCommand := CommandId
    end;
    Application.Quit(App);
    return
  end;
  LastCommand := CommandId;
  if Ide.Dialog.HandleCommand(App, CommandId) then
  begin
    return
  end
end;

/// Build the minimal Turbo Vision IDE chrome on an existing session.

function AttachChrome(App: Application): MenuBar;
begin
  var MenuBarHandle: MenuBar := MenuBar.New(Bounds(0, 0, 80, 1), [FileMenu(), HelpMenu()]);
  var Status: StatusLine := StatusLine.New(Bounds(0, 24, 80, 1), []);
  Application.SetMenuBar(App, MenuBarHandle);
  Application.SetStatusLine(App, Status);
  return MenuBarHandle
end;

/// Open the terminal session, run the Turbo Vision loop, and restore the terminal on exit.

procedure Run();
begin
  var App: Application := Application.New();
  AttachChrome(App);
  var Editor: Window := EditorWindow.New(Bounds(2, 2, 76, 20), 'untitled.fpas');
  Desktop.Add(App, Editor);
  Application.Run(App, OnCommand);
  Application.Close(App)
end;
