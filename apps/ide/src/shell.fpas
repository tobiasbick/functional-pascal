/// TUI shell for the FPAS IDE. See docs/pascal/std/tui/app/README.md.

unit Ide.Shell;

uses Ide.Dialog, Ide.Menu, Std.Tui;

private mutable var LastCommand: integer := -1;

private function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

function LastCommandId(): integer;
begin
  return LastCommand
end;

private procedure OnCommand(App: Application; CommandId: integer);
begin
  LastCommand := CommandId;
  if Ide.Dialog.HandleCommand(App, CommandId) then
  begin
    return
  end;
  if CommandId = CmdFileExit then
  begin
    Application.Quit(App)
  end
end;

/// Build the minimal Turbo Vision IDE chrome on an existing session.

function AttachChrome(App: Application): MenuBar;
begin
  var MenuBarHandle: MenuBar := Application.CreateMenuBar(App, Bounds(0, 0, 80, 1), [
                                                                                      FileMenu(),
                                                                                      HelpMenu()

                                                                                    ]);
  var Status: StatusLine := Application.CreateStatusLine(App, Bounds(0, 24, 80, 1), []);
  Application.SetMenuBar(App, MenuBarHandle);
  Application.SetStatusLine(App, Status);
  Application.OnCommand(App, OnCommand);
  return MenuBarHandle
end;

/// Open the terminal session, run the Turbo Vision TUI loop, and restore the terminal on exit.

procedure Run();
begin
  var App: Application := Application.Open();
  AttachChrome(App);
  Application.Run(App)
end;
