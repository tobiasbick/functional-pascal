/// TUI shell for the FPAS IDE. See docs/pascal/std/tui/app/README.md.

unit Ide.Shell;

uses Ide.Dialog, Ide.Menu, Ide.Status, Ide.Theme, Std.Console, Std.Tui;

{
  Host widget view ids; `None` means not created yet.
  Unit-private state shared by handlers below.
}

private mutable var DesktopView: option of ViewId := None;
private mutable var MenuBarView: option of ViewId := None;
private mutable var StatusBarView: option of ViewId := None;

private const MenuBarHeight: integer := 1;
private const StatusBarHeight: integer := 1;

private function MenuBarLayout(): ViewLayout;
begin
  return record
    anchorLeft := true;
    anchorTop := true;
    anchorRight := true;
    anchorBottom := false;
    marginLeft := 0;
    marginTop := 0;
    marginRight := 0;
    marginBottom := 0;
  end
end;

private function DesktopLayout(): ViewLayout;
begin
  return record
    anchorLeft := true;
    anchorTop := true;
    anchorRight := true;
    anchorBottom := true;
    marginLeft := 0;
    marginTop := MenuBarHeight;
    marginRight := 0;
    marginBottom := StatusBarHeight;
  end
end;

private function StatusBarLayout(): ViewLayout;
begin
  return record
    anchorLeft := true;
    anchorTop := false;
    anchorRight := true;
    anchorBottom := true;
    marginLeft := 0;
    marginTop := 0;
    marginRight := 0;
    marginBottom := 0;
  end
end;

/// Bind global keyboard shortcuts for the IDE shell.

private procedure BindShortcuts(App: Application);
begin
  var ExitKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Character;
    ch := 'x';
    shift := false;
    ctrl := false;
    alt := true;
    meta := false;
  end;
  Application.HostBindCommand(App, ExitKey, CmdFileExit)
end;

/// Create or resize menu bar, desktop, and status bar.

private procedure EnsureChrome(App: Application);
begin
  var S: Size := Application.Size(App);
  var DesktopHeight: integer := (S.height - MenuBarHeight) - StatusBarHeight;
  var StatusY: integer := S.height - StatusBarHeight;
  case MenuBarView of
    None:
    begin
      var Bar: ViewId := Application.HostCreateMenuBarView(App, 0, 0, S.width, MenuBarHeight, DefaultItems(), DefaultStyle());
      MenuBarView := Some(Bar);
      Application.HostSetViewLayout(App, Bar, MenuBarLayout())
    end;
    Some(Bar):
    begin
      Application.HostSetViewRect(App, Bar, 0, 0, S.width, MenuBarHeight);
      Application.HostSetViewLayout(App, Bar, MenuBarLayout())
    end
  end;
  case DesktopView of
    None:
    begin
      var Desktop: ViewId := Application.HostCreateSolidFillView(App, 0, MenuBarHeight, S.width, DesktopHeight, DesktopBg, None, None);
      DesktopView := Some(Desktop);
      Application.HostSetViewLayout(App, Desktop, DesktopLayout())
    end;
    Some(Desktop):
    begin
      Application.HostSetViewRect(App, Desktop, 0, MenuBarHeight, S.width, DesktopHeight);
      Application.HostSetViewLayout(App, Desktop, DesktopLayout())
    end
  end;
  case StatusBarView of
    None:
    begin
      var Status: ViewId := Application.HostCreateStatusBarView(App, 0, StatusY, S.width, StatusBarHeight, DefaultStatusSegments(), DefaultStatusStyle());
      StatusBarView := Some(Status);
      Application.HostSetViewLayout(App, Status, StatusBarLayout())
    end;
    Some(Status):
    begin
      Application.HostSetViewRect(App, Status, 0, StatusY, S.width, StatusBarHeight);
      Application.HostSetViewLayout(App, Status, StatusBarLayout())
    end
  end
end;

private procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdHelpAbout then
  begin
    OpenAbout(App)
  end
  else if HandleCommand(App, CommandId) then
  begin
  end
  else if CommandId = CmdFileExit then
  begin
    Application.HostRequestQuit(App)
  end
end;

private procedure OnMouse(App: Application; Event: Std.Console.Event);
begin
  HandleMouse(App, Event)
end;

/// Keep host widgets aligned with the terminal size via anchor/grow layout flags.

private procedure OnResize(App: Application; NewSize: Size);
begin
  Application.RequestRedraw(App)
end;

/// Wire IDE chrome and handlers onto an existing session (headless tests via `OpenForTest`).

procedure AttachChrome(App: Application);
begin
  BindShortcuts(App);
  EnsureChrome(App);
  var Handlers: ApplicationHandlers := record
    OnMouse := Some(OnMouse);
    OnResize := Some(OnResize);
    OnCommand := Some(OnCommand);
  end;
  Application.Configure(App, Handlers)
end;

/// Open the terminal session, run the hosted TUI loop, and restore the terminal on exit.

procedure Run();
begin
  var App: Application := Application.Open();
  AttachChrome(App);
  Application.Run(App)
end;
