/// TUI shell for the FPAS IDE.

unit Ide.Shell;

uses Ide.Dialog, Ide.Ui.Menu, Ide.Ui.Status, Std.Tui;

private mutable var LastCommand: integer := -1;
private mutable var StatusHandle: StatusLine := record  end;

private function Bounds(X: integer; Y: integer; Width: integer; Height: integer): TuiRect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

function LastCommandId(): integer;
begin
  return LastCommand
end;

/// Replace status line items from the current workspace session.

procedure RefreshStatus();
begin
  StatusLine.SetItems(StatusHandle, StatusItems())
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdFileExit then
  begin
    if LastCommand = -1 then
    begin
      LastCommand := CommandId
    end;
    Application.Quit(App);
    return
  end;
  LastCommand := CommandId;
  if Ide.Dialog.HandleCommand(App, CommandId, StatusHandle) then
  begin
    return
  end
end;

/// Build the minimal IDE chrome on an existing session.

function AttachChrome(App: Application): MenuBar;
begin
  var MenuBarHandle: MenuBar := MenuBar.New(Bounds(0, 0, 80, 1), [FileMenu(), HelpMenu()]);
  StatusHandle := StatusLine.New(Bounds(0, 24, 80, 1), StatusItems());
  Application.SetMenuBar(App, MenuBarHandle);
  Application.SetStatusLine(App, StatusHandle);
  return MenuBarHandle
end;

/// Open the terminal session, run the application loop, and restore the terminal on exit.

procedure Run();
begin
  var App: Application := Application.New();
  AttachChrome(App);
  Application.Run(App, OnCommand);
  Application.Close(App)
end;
