/// Turbo Pascal-style desktop colors for the FPAS IDE.

unit Ide.Theme;

uses Std.Console;

const
  /// Desktop background color (classic TP blue).

  DesktopBg: integer := Blue;
  /// Menu bar normal foreground (black text on gray bar, Turbo Vision style).

  MenuBarFg: integer := Black;
  /// Menu bar normal background (classic TP IDE gray strip).

  MenuBarBg: integer := LightGray;
  /// Menu bar hover/inverted foreground.

  MenuBarHighlightFg: integer := LightGray;
  /// Menu bar hover/inverted background.

  MenuBarHighlightBg: integer := Black;
  /// Disabled menu item foreground.

  MenuBarDisabledFg: integer := DarkGray;
  /// Alt+letter shortcut foreground on the menu bar (Turbo Pascal red).

  MenuBarAccelFg: integer := Red;
  /// Status bar foreground (black text on gray bar).

  StatusBarFg: integer := Black;
  /// Status bar background (matches menu bar gray strip).

  StatusBarBg: integer := LightGray;
