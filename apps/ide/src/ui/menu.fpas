/// Command constants and menu definitions for the FPAS IDE shell.

unit Ide.Ui.Menu;

uses Std.Tui;

const
  /// Command id dispatched when the user chooses File / Exit.
  CmdFileExit: integer := CM_QUIT;
  /// Command id dispatched when the user chooses File / Open.
  CmdFileOpen: integer := CM_OPEN;
  /// Command id dispatched when the user chooses Help / About.
  CmdHelpAbout: integer := CM_ABOUT;

function OpenMenuItem(): MenuItem;
begin
  return record text := '~O~pen'; commandId := CmdFileOpen; end
end;

function ExitMenuItem(): MenuItem;
begin
  return record text := '~E~xit'; commandId := CmdFileExit; end
end;

function AboutMenuItem(): MenuItem;
begin
  return record text := '~A~bout'; commandId := CmdHelpAbout; end
end;

function FileMenu(): Menu;
begin
  return record title := '~F~ile'; items := [OpenMenuItem(), ExitMenuItem()]; end
end;

function HelpMenu(): Menu;
begin
  return record title := '~H~elp'; items := [AboutMenuItem()]; end
end;

function CommandLabel(CommandId: integer): string;
begin
  if CommandId = CmdFileExit then
  begin
    return 'Exit'
  end;
  if CommandId = CmdFileOpen then
  begin
    return 'Open'
  end;
  if CommandId = CmdHelpAbout then
  begin
    return 'About'
  end;
  return 'Unknown'
end;
