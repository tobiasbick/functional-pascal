/// Status line items for the FPAS IDE shell.

unit Ide.Ui.Status;

uses Ide.Workspace.Session, Std.Array, Std.Conv, Std.Option, Std.Tui;

private function SessionStatusItem(): StatusItem;
begin
  mutable var Text: string := '';
  var Root: option of string := RootPath();
  if IsSome(Root) then
  begin
    var Prefix: string := (RootKindLabel() + ': ') + Std.Option.Unwrap(Root);
    var FileCount: integer := OpenFileCount();
    if FileCount = 0 then
    begin
      Text := Prefix
    end
    else
    begin
      Text := ((Prefix + ' | ') + IntToStr(FileCount)) + ' files'
    end
  end
  else if OpenFileCount() > 0 then
  begin
    var Count: integer := OpenFileCount();
    if Count = 1 then
    begin
      Text := '1 file'
    end
    else
    begin
      Text := IntToStr(Count) + ' files'
    end
  end;
  return record text := Text; keyCode := 0; commandId := 0; end
end;

/// Build status line items from the current workspace session.

function StatusItems(): array of StatusItem;
begin
  var Root: option of string := RootPath();
  if IsNone(Root) then
  begin
    if OpenFileCount() = 0 then
    begin
      return []
    end
  end;
  return [SessionStatusItem()]
end;
