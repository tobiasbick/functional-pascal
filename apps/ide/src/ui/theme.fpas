/// Current colors for the minimal FPAS IDE shell.

unit Ide.Ui.Theme;

uses Std.Console;

const
  /// Desktop background color for future IDE surfaces.
  DesktopBg: integer := Blue;
  /// Default foreground for simple chrome text.
  ChromeFg: integer := Black;
  /// Default background for simple chrome text.
  ChromeBg: integer := LightGray;
  /// Accent foreground for command hints.
  AccentFg: integer := Red;
