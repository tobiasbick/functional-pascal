/// Path classification for IDE open targets.

unit Ide.Workspace.Classify;

uses Std.Str;

type
  /// Kind of path selected through File / Open.
  OpenKind = enum
    Workspace;
    Project;
    TestFile;
    SourceFile;
    Unknown;
  end;

/// Classify `Path` by file extension, mirroring CLI input discovery rules.

function ClassifyPath(Path: string): OpenKind;
begin
  var Normalized: string := ToLower(Trim(Path));
  if EndsWith(Normalized, '.fpasworkspace') then
  begin
    return OpenKind.Workspace
  end;
  if EndsWith(Normalized, '.fpasprj') then
  begin
    return OpenKind.Project
  end;
  if EndsWith(Normalized, '_test.fpas') then
  begin
    return OpenKind.TestFile
  end;
  if EndsWith(Normalized, '.fpas') then
  begin
    return OpenKind.SourceFile
  end;
  return OpenKind.Unknown
end;
