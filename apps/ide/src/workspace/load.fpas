/// Load `.fpasprj` and `.fpasworkspace` manifests from disk into workspace model values.

unit Ide.Workspace.Load;

uses
  Ide.Workspace.Model, Std.Array, Std.Dict, Std.Fs, Std.Option, Std.Path, Std.Result, Std.Str,
  Std.Toml;

private function ResolveRelativeToManifest(ManifestPath: string; Relative: string): string;
begin
  return Std.Path.Join([Std.Path.DirName(ManifestPath), Relative])
end;

private function ExpectTable(Value: TomlValue; Context: string): result of dict of string to TomlValue, string;
begin
  case Value of
    TomlValue.Table(Fields):
    begin
      return Ok(Fields)
    end;
    TomlValue.String(Ignored):
    begin
      return Error('Expected table for ' + Context)
    end;
    TomlValue.Integer(Ignored):
    begin
      return Error('Expected table for ' + Context)
    end;
    TomlValue.Float(Ignored):
    begin
      return Error('Expected table for ' + Context)
    end;
    TomlValue.Boolean(Ignored):
    begin
      return Error('Expected table for ' + Context)
    end;
    TomlValue.Datetime(Ignored):
    begin
      return Error('Expected table for ' + Context)
    end;
    TomlValue.Array(Ignored):
    begin
      return Error('Expected table for ' + Context)
    end
  end
end;

private function ExpectString(Value: TomlValue; Context: string): result of string, string;
begin
  case Value of
    TomlValue.String(Text):
    begin
      return Ok(Text)
    end;
    TomlValue.Integer(Ignored):
    begin
      return Error('Expected string for ' + Context)
    end;
    TomlValue.Float(Ignored):
    begin
      return Error('Expected string for ' + Context)
    end;
    TomlValue.Boolean(Ignored):
    begin
      return Error('Expected string for ' + Context)
    end;
    TomlValue.Datetime(Ignored):
    begin
      return Error('Expected string for ' + Context)
    end;
    TomlValue.Array(Ignored):
    begin
      return Error('Expected string for ' + Context)
    end;
    TomlValue.Table(Ignored):
    begin
      return Error('Expected string for ' + Context)
    end
  end
end;

private function TableField(Table: dict of string to TomlValue; Key: string; Context: string): result of TomlValue, string;
begin
  var Found: option of TomlValue := Std.Dict.Get(Table, Key);
  if IsNone(Found) then
  begin
    return Error(((('Missing ' + Context) + ' field ''') + Key) + '''')
  end;
  return Ok(Std.Option.Unwrap(Found))
end;

private function StringArrayField(Value: TomlValue; Context: string): result of array of string, string;
begin
  case Value of
    TomlValue.Array(Items):
    begin
      mutable var Strings: array of string := [];
      for Item: TomlValue in Items do
      begin
        case Item of
          TomlValue.String(Text):
          begin
            Push(Strings, Text)
          end;
          TomlValue.Integer(Ignored):
          begin
            return Error('Expected string entries in ' + Context)
          end;
          TomlValue.Float(Ignored):
          begin
            return Error('Expected string entries in ' + Context)
          end;
          TomlValue.Boolean(Ignored):
          begin
            return Error('Expected string entries in ' + Context)
          end;
          TomlValue.Datetime(Ignored):
          begin
            return Error('Expected string entries in ' + Context)
          end;
          TomlValue.Array(Ignored):
          begin
            return Error('Expected string entries in ' + Context)
          end;
          TomlValue.Table(Ignored):
          begin
            return Error('Expected string entries in ' + Context)
          end
        end
      end;
      return Ok(Strings)
    end;
    TomlValue.String(Ignored):
    begin
      return Error('Expected array for ' + Context)
    end;
    TomlValue.Integer(Ignored):
    begin
      return Error('Expected array for ' + Context)
    end;
    TomlValue.Float(Ignored):
    begin
      return Error('Expected array for ' + Context)
    end;
    TomlValue.Boolean(Ignored):
    begin
      return Error('Expected array for ' + Context)
    end;
    TomlValue.Datetime(Ignored):
    begin
      return Error('Expected array for ' + Context)
    end;
    TomlValue.Table(Ignored):
    begin
      return Error('Expected array for ' + Context)
    end
  end
end;

private function OptionalStringArrayField(Table: dict of string to TomlValue; Key: string; Context: string): result of array of string, string;
begin
  var Found: option of TomlValue := Std.Dict.Get(Table, Key);
  if IsNone(Found) then
  begin
    return Ok([])
  end;
  return StringArrayField(Std.Option.Unwrap(Found), (Context + '.') + Key)
end;

private function ParseProjectKindText(KindText: string; Context: string): result of ProjectKind, string;
begin
  var Normalized: string := ToLower(Trim(KindText));
  if Normalized = 'program' then
  begin
    return Ok(ProjectKind.Executable)
  end;
  if Normalized = 'library' then
  begin
    return Ok(ProjectKind.Library)
  end;
  if Normalized = 'test' then
  begin
    return Ok(ProjectKind.Test)
  end;
  return Error(((((('Invalid ' + Context) + ' kind ''') + KindText) + '''. Expected program, library, or test.')))
end;

private function ReadManifestTable(ManifestPath: string): result of dict of string to TomlValue, string;
begin
  case ReadText(ManifestPath) of
    Ok(Text):
    begin
      case Std.Toml.Parse(Text) of
        Ok(Value):
        begin
          case Value of
            TomlValue.Table(Fields):
            begin
              return Ok(Fields)
            end;
            TomlValue.String(Ignored):
            begin
              return Error('Manifest root must be a TOML table: ' + ManifestPath)
            end;
            TomlValue.Integer(Ignored):
            begin
              return Error('Manifest root must be a TOML table: ' + ManifestPath)
            end;
            TomlValue.Float(Ignored):
            begin
              return Error('Manifest root must be a TOML table: ' + ManifestPath)
            end;
            TomlValue.Boolean(Ignored):
            begin
              return Error('Manifest root must be a TOML table: ' + ManifestPath)
            end;
            TomlValue.Datetime(Ignored):
            begin
              return Error('Manifest root must be a TOML table: ' + ManifestPath)
            end;
            TomlValue.Array(Ignored):
            begin
              return Error('Manifest root must be a TOML table: ' + ManifestPath)
            end
          end
        end;
        Error(Message):
        begin
          return Error((('TOML error in ' + ManifestPath) + ': ') + Message)
        end
      end
    end;
    Error(Message):
    begin
      return Error((('Failed to read ' + ManifestPath) + ': ') + Message)
    end
  end
end;

/// Parse and load a `.fpasprj` manifest from `ManifestPath`.

function LoadProject(ManifestPath: string): result of LoadedProject, string;
begin
  case ReadManifestTable(ManifestPath) of
    Error(Message):
    begin
      return Error(Message)
    end;
    Ok(Root):
    begin
      case TableField(Root, 'project', '[project]') of
        Error(Message):
        begin
          return Error(Message)
        end;
        Ok(ProjectValue):
        begin
          case ExpectTable(ProjectValue, '[project]') of
            Error(Message):
            begin
              return Error(Message)
            end;
            Ok(ProjectTable):
            begin
              case TableField(ProjectTable, 'name', '[project]') of
                Error(Message):
                begin
                  return Error(Message)
                end;
                Ok(NameValue):
                begin
                  case ExpectString(NameValue, '[project].name') of
                    Error(Message):
                    begin
                      return Error(Message)
                    end;
                    Ok(NameText):
                    begin
                      case TableField(ProjectTable, 'kind', '[project]') of
                        Error(Message):
                        begin
                          return Error(Message)
                        end;
                        Ok(KindValue):
                        begin
                          case ExpectString(KindValue, '[project].kind') of
                            Error(Message):
                            begin
                              return Error(Message)
                            end;
                            Ok(KindText):
                            begin
                              case ParseProjectKindText(KindText, '[project]') of
                                Error(Message):
                                begin
                                  return Error(Message)
                                end;
                                Ok(Kind):
                                begin
                                  mutable var MainPath: string := '';
                                  var MainField: option of TomlValue := Std.Dict.Get(ProjectTable, 'main');
                                  if IsSome(MainField) then
                                  begin
                                    case ExpectString(Std.Option.Unwrap(MainField), '[project].main') of
                                      Error(Message):
                                      begin
                                        return Error(Message)
                                      end;
                                      Ok(MainText):
                                      begin
                                        MainPath := ResolveRelativeToManifest(ManifestPath, MainText)
                                      end
                                    end
                                  end
                                  else if Kind = ProjectKind.Executable then
                                  begin
                                    return Error(('Missing [project] field ''main'' in ') +
                                                 ManifestPath)
                                  end;
                                  case TableField(Root, 'sources', '[sources]') of
                                    Error(Message):
                                    begin
                                      return Error(Message)
                                    end;
                                    Ok(SourcesValue):
                                    begin
                                      case ExpectTable(SourcesValue, '[sources]') of
                                        Error(Message):
                                        begin
                                          return Error(Message)
                                        end;
                                        Ok(SourcesTable):
                                        begin
                                          case TableField(SourcesTable, 'include', '[sources]') of
                                            Error(Message):
                                            begin
                                              return Error(Message)
                                            end;
                                            Ok(IncludeValue):
                                            begin
                                              case StringArrayField(IncludeValue, '[sources].include') of
                                                Error(Message):
                                                begin
                                                  return Error(Message)
                                                end;
                                                Ok(IncludePatterns):
                                                begin
                                                  if Std.Array.Length(IncludePatterns) = 0 then
                                                  begin
                                                    return Error(('Missing or empty [sources].include in ') +
                                                                 ManifestPath)
                                                  end;
                                                  case OptionalStringArrayField(SourcesTable, 'exclude', '[sources]') of
                                                    Error(Message):
                                                    begin
                                                      return Error(Message)
                                                    end;
                                                    Ok(ExcludePatterns):
                                                    begin
                                                      return Ok(record
                                                        Path := Trim(ManifestPath);
                                                        Name := Trim(NameText);
                                                        ManifestKind := Kind;
                                                        MainPath := MainPath;
                                                        IncludePatterns := IncludePatterns;
                                                        ExcludePatterns := ExcludePatterns;
                                                      end)
                                                    end
                                                  end
                                                end
                                              end
                                            end
                                          end
                                        end
                                      end
                                    end
                                  end
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end;

/// Parse and load a `.fpasworkspace` manifest from `ManifestPath`.

function LoadWorkspace(ManifestPath: string): result of LoadedWorkspace, string;
begin
  case ReadManifestTable(ManifestPath) of
    Error(Message):
    begin
      return Error(Message)
    end;
    Ok(Root):
    begin
      case TableField(Root, 'workspace', '[workspace]') of
        Error(Message):
        begin
          return Error(Message)
        end;
        Ok(WorkspaceValue):
        begin
          case ExpectTable(WorkspaceValue, '[workspace]') of
            Error(Message):
            begin
              return Error(Message)
            end;
            Ok(WorkspaceTable):
            begin
              case TableField(WorkspaceTable, 'name', '[workspace]') of
                Error(Message):
                begin
                  return Error(Message)
                end;
                Ok(NameValue):
                begin
                  case ExpectString(NameValue, '[workspace].name') of
                    Error(Message):
                    begin
                      return Error(Message)
                    end;
                    Ok(NameText):
                    begin
                      case TableField(WorkspaceTable, 'members', '[workspace]') of
                        Error(Message):
                        begin
                          return Error(Message)
                        end;
                        Ok(MembersValue):
                        begin
                          case StringArrayField(MembersValue, '[workspace].members') of
                            Error(Message):
                            begin
                              return Error(Message)
                            end;
                            Ok(MemberRelPaths):
                            begin
                              if Std.Array.Length(MemberRelPaths) = 0 then
                              begin
                                return Error(('Missing or empty [workspace].members in ') +
                                             ManifestPath)
                              end;
                              mutable var MemberPaths: array of string := [];
                              for Relative: string in MemberRelPaths do
                              begin
                                Push(MemberPaths, ResolveRelativeToManifest(ManifestPath, Relative))
                              end;
                              return Ok(record
                                Path := Trim(ManifestPath);
                                Name := Trim(NameText);
                                MemberPaths := MemberPaths;
                              end)
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end;
