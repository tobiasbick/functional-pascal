/// Typed validation of FPAS workspace manifest text.

unit Ide.Workspace.Manifest;

uses Std.Array, Std.Dict, Std.Str, Std.Toml;

type
  /// Manifest fields required to resolve one workspace.
  IdeWorkspaceManifest = record
    ManifestText: string;
    Name: string;
    Members: array of string;
  end;

private function RequiredWorkspaceTable(Fields: dict of string to TomlValue): result of dict of string to TomlValue, string;
begin
  case Std.Dict.Get(Fields, 'workspace') of
    Some(Value):
    begin
      case Value of
        TomlValue.Table(Table):
        begin
          return Ok(Table)
        end
        else
        begin
          return Error('Workspace manifest field [workspace] must be a table.')
        end
      end
    end;
    None:
    begin
      return Error('Workspace manifest requires [workspace].')
    end
  end
end;

private function RequiredName(Fields: dict of string to TomlValue): result of string, string;
begin
  case Std.Dict.Get(Fields, 'name') of
    Some(Value):
    begin
      case Value of
        TomlValue.String(Text):
        begin
          if Std.Str.Length(Text) = 0 then
          begin
            return Error('workspace.name must not be empty.')
          end;
          return Ok(Text)
        end
        else
        begin
          return Error('workspace.name must be a string.')
        end
      end
    end;
    None:
    begin
      return Error('workspace requires name.')
    end
  end
end;

private function RequiredMembers(Fields: dict of string to TomlValue): result of array of string, string;
begin
  case Std.Dict.Get(Fields, 'members') of
    Some(Value):
    begin
      case Value of
        TomlValue.Array(Values):
        begin
          mutable var Members: array of string := [];
          for Index: integer := 0 to Std.Array.Length(Values) - 1 do
          begin
            case Values[Index] of
              TomlValue.String(Text):
              begin
                if Std.Str.Length(Std.Str.Trim(Text)) = 0 then
                begin
                  return Error('workspace.members entries must not be empty.')
                end;
                Std.Array.Push(Members, Text)
              end
              else
              begin
                return Error('workspace.members must contain only strings.')
              end
            end
          end;
          if Std.Array.Length(Members) = 0 then
          begin
            return Error('workspace.members must contain at least one project path.')
          end;
          return Ok(Members)
        end
        else
        begin
          return Error('workspace.members must be an array of strings.')
        end
      end
    end;
    None:
    begin
      return Error('workspace requires members.')
    end
  end
end;

private function BuildManifest(ManifestText: string; RootFields: dict of string to TomlValue): result of IdeWorkspaceManifest, string;
begin
  mutable var WorkspaceFields: dict of string to TomlValue := [:];
  case RequiredWorkspaceTable(RootFields) of
    Ok(Fields):
    begin
      WorkspaceFields := Fields
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;
  mutable var Name: string := '';
  mutable var Members: array of string := [];
  case RequiredName(WorkspaceFields) of
    Ok(Value):
    begin
      Name := Value
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;
  case RequiredMembers(WorkspaceFields) of
    Ok(Value):
    begin
      Members := Value
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;
  return Ok(record ManifestText := ManifestText; Name := Name; Members := Members; end)
end;

/// Parses workspace TOML and validates the fields owned by the IDE.

function ParseIdeWorkspaceManifest(ManifestText: string): result of IdeWorkspaceManifest, string;
begin
  case Std.Toml.Parse(ManifestText) of
    Ok(Value):
    begin
      case Value of
        TomlValue.Table(Fields):
        begin
          return BuildManifest(ManifestText, Fields)
        end
        else
        begin
          return Error('Workspace manifest root must be a TOML table.')
        end
      end
    end;
    Error(Message):
    begin
      return Error('Invalid workspace manifest: ' + Message)
    end
  end
end;
