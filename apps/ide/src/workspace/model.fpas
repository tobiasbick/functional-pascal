/// Parsed workspace and project manifest payloads held by the IDE session.

unit Ide.Workspace.Model;

type
  /// `project.kind` from a `.fpasprj` manifest.
  ProjectKind = enum
    Executable;
    Library;
    Test;
  end;
  /// Loaded `.fpasprj` manifest fields needed by the IDE.
  LoadedProject = record
    Path: string;
    Name: string;
    ManifestKind: ProjectKind;
    MainPath: string;
    IncludePatterns: array of string;
    ExcludePatterns: array of string;
  end;
  /// Loaded `.fpasworkspace` manifest fields needed by the IDE.
  LoadedWorkspace = record
    Path: string;
    Name: string;
    MemberPaths: array of string;
  end;
  /// Which payload in `SessionRoot` is active.
  RootSlotKind = enum
    Empty;
    Workspace;
    Project;
  end;
  /// Active workspace session root plus inactive placeholder payloads.
  SessionRoot = record
    RootSlot: RootSlotKind;
    WorkspaceData: LoadedWorkspace;
    ProjectData: LoadedProject;
  end;

private function EmptyLoadedProject(): LoadedProject;
begin
  return record
    Path := '';
    Name := '';
    ManifestKind := ProjectKind.Executable;
    MainPath := '';
    IncludePatterns := [];
    ExcludePatterns := [];
  end
end;

private function EmptyLoadedWorkspace(): LoadedWorkspace;
begin
  return record Path := ''; Name := ''; MemberPaths := []; end
end;

/// Empty root with cleared workspace and project payloads.

function EmptySessionRoot(): SessionRoot;
begin
  return record
    RootSlot := RootSlotKind.Empty;
    WorkspaceData := EmptyLoadedWorkspace();
    ProjectData := EmptyLoadedProject();
  end
end;

/// Lowercase label for `ProjectKind`.

function ProjectKindLabel(Kind: ProjectKind): string;
begin
  case Kind of
    ProjectKind.Executable:
    begin
      return 'program'
    end;
    ProjectKind.Library:
    begin
      return 'library'
    end;
    ProjectKind.Test:
    begin
      return 'test'
    end
  end
end;

/// Build a workspace root state value.

function WorkspaceSessionRoot(Ws: LoadedWorkspace): SessionRoot;
begin
  return record
    RootSlot := RootSlotKind.Workspace;
    WorkspaceData := Ws;
    ProjectData := EmptyLoadedProject();
  end
end;

/// Build a project root state value.

function ProjectSessionRoot(Proj: LoadedProject): SessionRoot;
begin
  return record
    RootSlot := RootSlotKind.Project;
    WorkspaceData := EmptyLoadedWorkspace();
    ProjectData := Proj;
  end
end;
