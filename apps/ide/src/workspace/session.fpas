/// Atomic loading of a workspace, its first member, and its initial document.

unit Ide.Workspace.Session;

uses
  Ide.Document.Io, Ide.Document.Model, Ide.Project.Model, Ide.Workspace.Loader, Ide.Workspace.Model;

type
  /// Fully loaded data required to replace the current IDE session.
  IdeOpenedWorkspace = record
    Workspace: IdeWorkspace;
    Project: IdeProject;
    Document: IdeDocument;
  end;

/// Loads a validated workspace and its initial member source as one operation.

function LoadIdeWorkspaceSession(Path: string): result of IdeOpenedWorkspace, string;
begin
  case LoadIdeWorkspace(Path) of
    Ok(Workspace):
    begin
      case IdeWorkspaceInitialProject(Workspace) of
        Some(Project):
        begin
          case IdeProjectInitialFile(Project) of
            Some(SourcePath):
            begin
              case ReadIdeDocument(SourcePath) of
                Ok(Document):
                begin
                  return Ok(record
                    Workspace := Workspace;
                    Project := Project;
                    Document := Document;
                  end)
                end;
                Error(Message):
                begin
                  return Error('Could not open workspace source: ' + Message)
                end
              end
            end;
            None:
            begin
              return Error('Initial workspace project contains no source document.')
            end
          end
        end;
        None:
        begin
          return Error('Workspace contains no member project.')
        end
      end
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end
end;
