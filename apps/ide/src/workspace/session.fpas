/// In-memory workspace session: loaded root state plus open source files.

unit Ide.Workspace.Session;

uses
  Ide.Workspace.Classify, Ide.Workspace.Load, Ide.Workspace.Model, Std.Array, Std.Conv, Std.Option,
  Std.Result, Std.Str;

private mutable var RootSlot: RootSlotKind := RootSlotKind.Empty;
private mutable var WorkspaceState: LoadedWorkspace := record
  Path := '';
  Name := '';
  MemberPaths := [];
end;
private mutable var ProjectState: LoadedProject := record
  Path := '';
  Name := '';
  ManifestKind := ProjectKind.Executable;
  MainPath := '';
  IncludePatterns := [];
  ExcludePatterns := [];
end;
private mutable var OpenFilesStorage: array of string := [];

private function PathsEqual(A: string; B: string): boolean;
begin
  return ToLower(Trim(A)) = ToLower(Trim(B))
end;

private function HasOpenFileInternal(Path: string): boolean;
begin
  for Existing: string in OpenFilesStorage do
  begin
    if PathsEqual(Existing, Path) then
    begin
      return true
    end
  end;
  return false
end;

private procedure SetWorkspaceRoot(Ws: LoadedWorkspace);
begin
  RootSlot := RootSlotKind.Workspace;
  WorkspaceState := Ws;
  ProjectState := record
    Path := '';
    Name := '';
    ManifestKind := ProjectKind.Executable;
    MainPath := '';
    IncludePatterns := [];
    ExcludePatterns := [];
  end;
  OpenFilesStorage := []
end;

private procedure SetProjectRoot(Proj: LoadedProject);
begin
  RootSlot := RootSlotKind.Project;
  WorkspaceState := record Path := ''; Name := ''; MemberPaths := []; end;
  ProjectState := Proj;
  OpenFilesStorage := []
end;

private procedure AddOpenFile(Path: string);
begin
  mutable var Files: array of string := OpenFilesStorage;
  Push(Files, Trim(Path));
  OpenFilesStorage := Files
end;

private function CurrentWorkspace(): LoadedWorkspace;
begin
  return WorkspaceState
end;

private function CurrentProject(): LoadedProject;
begin
  return ProjectState
end;

/// Human-readable root kind label (`Workspace`, `Project`, or empty).

function RootKindLabel(): string;
begin
  case RootSlot of
    RootSlotKind.Empty:
    begin
      return ''
    end;
    RootSlotKind.Workspace:
    begin
      return 'Workspace'
    end;
    RootSlotKind.Project:
    begin
      return 'Project'
    end
  end
end;

/// Display name of the loaded workspace or project root, or empty when none is open.

function LoadedName(): string;
begin
  var Ws: LoadedWorkspace := CurrentWorkspace();
  var Proj: LoadedProject := CurrentProject();
  case RootSlot of
    RootSlotKind.Empty:
    begin
      return ''
    end;
    RootSlotKind.Workspace:
    begin
      return Ws.Name
    end;
    RootSlotKind.Project:
    begin
      return Proj.Name
    end
  end
end;

private function OpenSummary(): string;
begin
  var FileCount: integer := Std.Array.Length(OpenFilesStorage);
  var Name: string := LoadedName();
  if Name <> '' then
  begin
    var Prefix: string := (RootKindLabel() + ': ') + Name;
    if FileCount = 0 then
    begin
      return Prefix
    end;
    return ((Prefix + ' | ') + IntToStr(FileCount)) + ' files'
  end;
  if FileCount = 1 then
  begin
    return IntToStr(FileCount) + ' file'
  end;
  return IntToStr(FileCount) + ' files'
end;

/// Lowercase `project.kind` label for the active project root, or empty for workspace/no root.

function ActiveProjectKindLabel(): string;
begin
  if RootSlot = RootSlotKind.Project then
  begin
    var Proj: LoadedProject := CurrentProject();
    return ProjectKindLabel(Proj.ManifestKind)
  end;
  return ''
end;

/// Number of workspace member project paths when the active root is a workspace.

function WorkspaceMemberCount(): integer;
begin
  if RootSlot = RootSlotKind.Workspace then
  begin
    var Ws: LoadedWorkspace := CurrentWorkspace();
    return Std.Array.Length(Ws.MemberPaths)
  end;
  return 0
end;

/// Resolved member project path at zero-based `MemberIndex` for a workspace root.

function WorkspaceMemberAt(MemberIndex: integer): string;
begin
  if RootSlot = RootSlotKind.Workspace then
  begin
    var Ws: LoadedWorkspace := CurrentWorkspace();
    return Ws.MemberPaths[MemberIndex]
  end;
  return ''
end;

/// Number of `[sources].include` patterns for the active project root.

function ProjectIncludePatternCount(): integer;
begin
  if RootSlot = RootSlotKind.Project then
  begin
    var Proj: LoadedProject := CurrentProject();
    return Std.Array.Length(Proj.IncludePatterns)
  end;
  return 0
end;

/// Include pattern at zero-based `PatternIndex` for the active project root.

function ProjectIncludePatternAt(PatternIndex: integer): string;
begin
  if RootSlot = RootSlotKind.Project then
  begin
    var Proj: LoadedProject := CurrentProject();
    return Proj.IncludePatterns[PatternIndex]
  end;
  return ''
end;

/// Resolved program `main` path for the active project root, when present.

function ProjectMainPath(): option of string;
begin
  if RootSlot = RootSlotKind.Project then
  begin
    var Proj: LoadedProject := CurrentProject();
    if Trim(Proj.MainPath) = '' then
    begin
      return None
    end;
    return Some(Proj.MainPath)
  end;
  return None
end;

/// Clear session state. Used by tests.

procedure Reset();
begin
  RootSlot := RootSlotKind.Empty;
  WorkspaceState := record Path := ''; Name := ''; MemberPaths := []; end;
  ProjectState := record
    Path := '';
    Name := '';
    ManifestKind := ProjectKind.Executable;
    MainPath := '';
    IncludePatterns := [];
    ExcludePatterns := [];
  end;
  OpenFilesStorage := []
end;

/// Open or register `Path` in the session.

function OpenPath(Path: string): result of string, string;
begin
  var Kind: OpenKind := ClassifyPath(Path);
  if Kind = OpenKind.Unknown then
  begin
    return Error('Unsupported file type. Expected .fpas, .fpasprj, or .fpasworkspace.')
  end;
  if Kind = OpenKind.Workspace then
  begin
    case LoadWorkspace(Path) of
      Error(Message):
      begin
        return Error(Message)
      end;
      Ok(Ws):
      begin
        SetWorkspaceRoot(Ws);
        return Ok(OpenSummary())
      end
    end
  end;
  if Kind = OpenKind.Project then
  begin
    case LoadProject(Path) of
      Error(Message):
      begin
        return Error(Message)
      end;
      Ok(Proj):
      begin
        SetProjectRoot(Proj);
        return Ok(OpenSummary())
      end
    end
  end;
  if HasOpenFileInternal(Path) then
  begin
    return Ok(OpenSummary())
  end;
  AddOpenFile(Path);
  return Ok(OpenSummary())
end;

/// Active root manifest path, if any.

function RootPath(): option of string;
begin
  var Ws: LoadedWorkspace := CurrentWorkspace();
  var Proj: LoadedProject := CurrentProject();
  case RootSlot of
    RootSlotKind.Empty:
    begin
      return None
    end;
    RootSlotKind.Workspace:
    begin
      return Some(Ws.Path)
    end;
    RootSlotKind.Project:
    begin
      return Some(Proj.Path)
    end
  end
end;

/// Number of open `.fpas` / test files in the session.

function OpenFileCount(): integer;
begin
  return Std.Array.Length(OpenFilesStorage)
end;

/// Open file path at zero-based `FileIndex`.

function OpenFileAt(FileIndex: integer): string;
begin
  var Files: array of string := OpenFilesStorage;
  return Files[FileIndex]
end;

/// Returns true when `Path` is already listed in open files.

function HasOpenFile(Path: string): boolean;
begin
  return HasOpenFileInternal(Path)
end;
