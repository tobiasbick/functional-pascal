/// Resolve project source file paths from manifest include and exclude patterns.

unit Ide.Workspace.Sources;

uses Ide.Workspace.Model, Std.Array, Std.Fs, Std.Path, Std.Result, Std.Str;

private function NormalizeSlashes(Path: string): string;
begin
  return Replace(Path, '\', '/')
end;

private function IsAbsolutePath(Path: string): boolean;
begin
  if Path = '' then
  begin
    return false
  end;
  if StartsWith(Path, '/') then
  begin
    return true
  end;
  if Std.Str.Length(Path) >= 2 then
  begin
    return Substring(Path, 1, 1) = ':'
  end;
  return false
end;

private function ProjectRootDir(Proj: LoadedProject): string;
begin
  return Std.Path.DirName(Proj.Path)
end;

private function ResolvePattern(RootDir: string; Pattern: string): string;
begin
  if IsAbsolutePath(Pattern) then
  begin
    return Pattern
  end;
  return Std.Path.Join([RootDir, Pattern])
end;

private function HasNormalizedPath(Paths: array of string; Normalized: string): boolean;
begin
  for Existing: string in Paths do
  begin
    if Existing = Normalized then
    begin
      return true
    end
  end;
  return false
end;

private function AddUniquePath(Paths: array of string; Path: string): array of string;
begin
  var Normalized: string := NormalizeSlashes(Path);
  if HasNormalizedPath(Paths, Normalized) then
  begin
    return Paths
  end;
  mutable var Out: array of string := Paths;
  Push(Out, Normalized);
  return Out
end;

private function RelativeToRoot(RootDir: string; FilePath: string): string;
begin
  var Root: string := NormalizeSlashes(RootDir);
  var File: string := NormalizeSlashes(FilePath);
  if Root = File then
  begin
    return Std.Path.BaseName(File)
  end;
  mutable var Prefix: string := Root;
  if not EndsWith(Prefix, '/') then
  begin
    Prefix := Prefix + '/'
  end;
  if not StartsWith(File, Prefix) then
  begin
    return Std.Path.BaseName(File)
  end;
  return Substring(File, Std.Str.Length(Prefix), Std.Str.Length(File) - Std.Str.Length(Prefix))
end;

private function IsGlobPattern(Pattern: string): boolean;
begin
  return (Std.Str.Contains(Pattern, '*') or Std.Str.Contains(Pattern, '?')) or
         Std.Str.Contains(Pattern, '[')
end;

private function ExpandPattern(RootDir: string; Pattern: string; RequireMatch: boolean): result of array of string, string;
begin
  var Resolved: string := ResolvePattern(RootDir, Pattern);
  if (not IsAbsolutePath(Pattern)) and (not IsGlobPattern(Pattern)) then
  begin
    if IsFile(Resolved) then
    begin
      return Ok([Resolved])
    end;
    if RequireMatch then
    begin
      return Error(('Source path does not exist: ') + Pattern)
    end;
    return Ok([])
  end;
  case Glob(Resolved) of
    Ok(Paths):
    begin
      if RequireMatch then
      begin
        if Std.Array.Length(Paths) = 0 then
        begin
          return Error(('Source pattern matched no files: ') + Pattern)
        end
      end;
      return Ok(Paths)
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end
end;

private function CollectIncludedPaths(Proj: LoadedProject): result of array of string, string;
begin
  var RootDir: string := ProjectRootDir(Proj);
  mutable var Collected: array of string := [];
  for Pattern: string in Proj.IncludePatterns do
  begin
    case ExpandPattern(RootDir, Pattern, true) of
      Error(Message):
      begin
        return Error(Message)
      end;
      Ok(Paths):
      begin
        for Path: string in Paths do
        begin
          Collected := AddUniquePath(Collected, Path)
        end
      end
    end
  end;
  return Ok(Collected)
end;

private function RemoveExcludedPaths(
  RootDir: string;
  Paths: array of string;
  ExcludePatterns: array of string
): result of array of string, string;
begin
  mutable var Excluded: array of string := [];
  for Pattern: string in ExcludePatterns do
  begin
    case ExpandPattern(RootDir, Pattern, false) of
      Error(Message):
      begin
        return Error(Message)
      end;
      Ok(Matches):
      begin
        for Path: string in Matches do
        begin
          Excluded := AddUniquePath(Excluded, Path)
        end
      end
    end
  end;
  mutable var Kept: array of string := [];
  for Path: string in Paths do
  begin
    var Normalized: string := NormalizeSlashes(Path);
    if not HasNormalizedPath(Excluded, Normalized) then
    begin
      Push(Kept, Path)
    end
  end;
  return Ok(Kept)
end;

private function ToRelativeSortedPaths(RootDir: string; Paths: array of string): array of string;
begin
  mutable var Relative: array of string := [];
  for Path: string in Paths do
  begin
    Push(Relative, RelativeToRoot(RootDir, Path))
  end;
  return Sort(Relative)
end;

/// Expand `[sources]` patterns for `Proj` into sorted project-relative `.fpas` paths.

function ResolveProjectRelativeSources(Proj: LoadedProject): result of array of string, string;
begin
  case CollectIncludedPaths(Proj) of
    Error(Message):
    begin
      return Error(Message)
    end;
    Ok(Included):
    begin
      var RootDir: string := ProjectRootDir(Proj);
      case RemoveExcludedPaths(RootDir, Included, Proj.ExcludePatterns) of
        Error(Message):
        begin
          return Error(Message)
        end;
        Ok(Filtered):
        begin
          mutable var Paths: array of string := Filtered;
          if Trim(Proj.MainPath) <> '' then
          begin
            Paths := AddUniquePath(Paths, Proj.MainPath)
          end;
          return Ok(ToRelativeSortedPaths(RootDir, Paths))
        end
      end
    end
  end
end;
