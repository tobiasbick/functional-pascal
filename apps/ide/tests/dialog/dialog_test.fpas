program IdeDialogTest;

uses Ide.Dialog, Ide.Menu, Std.Option, Std.Tui, Std.Test;

begin
  var App: Application := Application.OpenForTest(80, 25);
  AssertEquals(100, CmdHelpAbout);
  AssertEquals(2, CmdFileOpen);
  Application.TestSetDialogResult(App, Command.Accept);
  AssertTrue(HandleCommand(App, CmdHelpAbout));
  Application.TestSetFileDialogResult(App, Some('demo.fpas'));
  Application.TestSetDialogResult(App, Command.Accept);
  AssertTrue(HandleCommand(App, CmdFileOpen));
  Application.TestSetFileDialogResult(App, None);
  Application.TestSetDialogResult(App, Command.Accept);
  AssertTrue(HandleCommand(App, CmdFileOpen));
  AssertFalse(HandleCommand(App, Command.Quit));
  Application.CloseForTest(App)
end.
