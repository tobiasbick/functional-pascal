program IdeShellAboutCommandTest;

uses Ide.Dialog, Ide.Shell, Std.Tui, Std.Test;

begin
  var App: Application := Application.OpenForTest(80, 25);
  var ExitButton: Button := AttachChrome(App);
  AssertFalse(IsOpen(App));
  AssertTrue(HandleCommand(App, CmdHelpAbout));
  AssertTrue(IsOpen(App));
  AssertTrue(HandleCommand(App, CmdAboutOk));
  AssertFalse(IsOpen(App));
  Application.CloseForTest(App)
end.
