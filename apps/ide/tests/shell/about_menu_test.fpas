program IdeShellAboutMenuTest;

uses Ide.Dialog, Ide.Menu, Ide.Shell, Std.Tui, Std.Test;

begin
  var App: Application := Application.OpenForTest(80, 25);
  var _: MenuBar := AttachChrome(App);
  Application.Try2InjectCommand(App, CmdHelpAbout);
  Application.Try2InjectKeyboard(App, 7181);
  Application.Try2InjectCommand(App, CM_QUIT);
  Application.Run(App, OnCommand);
  AssertEquals(CmdHelpAbout, LastCommandId())
end.
