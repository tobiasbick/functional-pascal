program IdeShellChromeTest;

uses Ide.Shell, Ide.Ui.Menu, Std.Tui, Std.Test;

begin
  var App: Application := Application.OpenForTest(80, 25);
  var _: MenuBar := AttachChrome(App);
  Test.InjectCommand(App, CmdFileExit);
  Application.Run(App, OnCommand);
  AssertEquals(CmdFileExit, LastCommandId())
end.
