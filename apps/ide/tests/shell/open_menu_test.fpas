program IdeShellOpenMenuTest;

uses Ide.Dialog, Ide.Shell, Ide.Ui.Menu, Ide.Workspace.Session, Std.Option, Std.Tui, Std.Test;

begin
  Reset();
  var App: Application := Application.OpenForTest(80, 25);
  var MenuBarHandle: MenuBar := AttachChrome(App);
  Application.TestSetFileDialogResult(App, Some('src/main.fpas'));
  Test.DispatchMenu(App, MenuBarHandle, 0, 0);
  Test.InjectKeyboard(App, 7181);
  Test.InjectCommand(App, CM_QUIT);
  Application.Run(App, OnCommand);
  AssertEquals(CmdFileOpen, LastCommandId());
  AssertEquals(1, OpenFileCount());
  AssertEquals('src/main.fpas', OpenFileAt(0));
  Reset()
end.
