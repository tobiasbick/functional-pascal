program IdeShellOpenTreeTest;

uses
  Ide.Dialog, Ide.Shell, Ide.Ui.Menu, Ide.Workspace.Session, Ide.Workspace.TreeWindow, Std.Option,
  Std.Tui, Std.Test;

begin
  Ide.Workspace.Session.Reset();
  Ide.Workspace.TreeWindow.Reset();
  var App: Application := Application.OpenForTest(80, 25);
  var MenuBarHandle: MenuBar := AttachChrome(App);
  Application.TestSetFileDialogResult(App, Some('apps/ide/ide.fpasprj'));
  Test.DispatchMenu(App, MenuBarHandle, 0, 0);
  Test.InjectKeyboard(App, 7181);
  Test.InjectCommand(App, CM_QUIT);
  Application.Run(App, OnCommand);
  AssertTrue(WasShown());
  AssertEquals('ide', LoadedName());
  Ide.Workspace.Session.Reset();
  Ide.Workspace.TreeWindow.Reset()
end.
