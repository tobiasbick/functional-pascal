program IdeUiMenuTest;

uses Ide.Ui.Menu, Std.Test;

begin
  AssertEquals(CM_QUIT, CmdFileExit);
  AssertEquals(CM_OPEN, CmdFileOpen);
  AssertEquals(CM_ABOUT, CmdHelpAbout);
  var OpenItem: MenuItem := OpenMenuItem();
  var ExitItem: MenuItem := ExitMenuItem();
  var AboutItem: MenuItem := AboutMenuItem();
  var FileTopMenu: Menu := FileMenu();
  var HelpTopMenu: Menu := HelpMenu();
  AssertEquals(CmdFileOpen, OpenItem.commandId);
  AssertEquals(CmdFileExit, ExitItem.commandId);
  AssertEquals(CmdHelpAbout, AboutItem.commandId);
  AssertEquals('~F~ile', FileTopMenu.title);
  AssertEquals('~H~elp', HelpTopMenu.title);
  AssertEquals('Exit', CommandLabel(CmdFileExit));
  AssertEquals('Open', CommandLabel(CmdFileOpen));
  AssertEquals('About', CommandLabel(CmdHelpAbout));
  AssertEquals('Unknown', CommandLabel(999))
end.
