program IdeWorkspaceSessionTest;

uses Ide.Workspace.Classify, Ide.Workspace.Session, Std.Option, Std.Result, Std.Test;

begin
  Reset();
  AssertFalse(IsSome(RootPath()));
  AssertEquals('', RootKindLabel());
  AssertEquals(0, OpenFileCount());
  var ProjectOutcome: result of string, string := OpenPath('apps/ide/ide.fpasprj');
  AssertTrue(IsOk(ProjectOutcome));
  AssertTrue(IsSome(RootPath()));
  AssertEquals('Project', RootKindLabel());
  AssertEquals('apps/ide/ide.fpasprj', Std.Option.Unwrap(RootPath()));
  AssertEquals(0, OpenFileCount());
  var FileOutcome: result of string, string := OpenPath('src/main.fpas');
  AssertTrue(IsOk(FileOutcome));
  AssertEquals(1, OpenFileCount());
  AssertEquals('src/main.fpas', OpenFileAt(0));
  AssertTrue(HasOpenFile('src/main.fpas'));
  var DuplicateOutcome: result of string, string := OpenPath('SRC/MAIN.FPAS');
  AssertTrue(IsOk(DuplicateOutcome));
  AssertEquals(1, OpenFileCount());
  var WorkspaceOutcome: result of string, string := OpenPath('apps/ide/ide.fpasworkspace');
  AssertTrue(IsOk(WorkspaceOutcome));
  AssertEquals('Workspace', RootKindLabel());
  AssertEquals('apps/ide/ide.fpasworkspace', Std.Option.Unwrap(RootPath()));
  AssertEquals(0, OpenFileCount());
  Reset();
  var UnknownOutcome: result of string, string := OpenPath('notes.txt');
  AssertTrue(IsError(UnknownOutcome));
  AssertFalse(IsSome(RootPath()));
  AssertEquals(0, OpenFileCount());
  Reset()
end.
