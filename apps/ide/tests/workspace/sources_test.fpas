program IdeWorkspaceSourcesTest;

uses
  Ide.Workspace.Load, Ide.Workspace.Model, Ide.Workspace.Sources, Std.Array, Std.Result, Std.Str,
  Std.Test;

begin
  case LoadProject('apps/ide/ide.fpasprj') of
    Ok(Proj):
    begin
      case ResolveProjectRelativeSources(Proj) of
        Ok(Paths):
        begin
          AssertEquals(1, Std.Array.Length(Paths));
          AssertEquals('src/main.fpas', Paths[0])
        end;
        Error(Message):
        begin
          AssertTrue(false)
        end
      end
    end;
    Error(Message):
    begin
      AssertTrue(false)
    end
  end;
  case LoadProject('apps/ide/ide-core.fpasprj') of
    Ok(Proj):
    begin
      case ResolveProjectRelativeSources(Proj) of
        Ok(Paths):
        begin
          AssertTrue(Std.Array.Length(Paths) > 1);
          mutable var HasDialog: boolean := false;
          mutable var HasMain: boolean := false;
          for Path: string in Paths do
          begin
            if Path = 'src/dialog/open.fpas' then
            begin
              HasDialog := true
            end;
            if Path = 'src/main.fpas' then
            begin
              HasMain := true
            end
          end;
          AssertTrue(HasDialog);
          AssertFalse(HasMain)
        end;
        Error(Message):
        begin
          AssertTrue(false)
        end
      end
    end;
    Error(Message):
    begin
      AssertTrue(false)
    end
  end
end.
