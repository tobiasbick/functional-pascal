program IdeWorkspaceTreeBuildTest;

uses
  Ide.Workspace.Load, Ide.Workspace.Model, Ide.Workspace.Sources, Ide.Workspace.Session,
  Ide.Workspace.TreeBuild, Std.Array, Std.Result, Std.Str, Std.Tui, Std.Test;

begin
  case LoadProject('apps/ide/ide-core.fpasprj') of
    Ok(Proj):
    begin
      case ResolveProjectRelativeSources(Proj) of
        Ok(Paths):
        begin
          var Nodes: array of OutlineNode := BuildProjectDirectoryNodes(Paths);
          AssertEquals(1, Std.Array.Length(Nodes));
          AssertEquals('src', Nodes[0].text);
          AssertTrue(Nodes[0].expanded);
          AssertTrue(Std.Array.Length(Nodes[0].children) > 0);
          var FirstChild: OutlineNode := Nodes[0].children[0];
          if Std.Array.Length(Nodes[0].children) > 1 then
          begin
            var SecondChild: OutlineNode := Nodes[0].children[1];
            AssertTrue((FirstChild.text = 'dialog') or (SecondChild.text = 'dialog'))
          end
        end;
        Error(Message):
        begin
          AssertTrue(false)
        end
      end;
      case BuildProjectRootNode(Proj) of
        Ok(Root):
        begin
          AssertEquals('ide-core.fpasprj', Root.text);
          AssertTrue(Root.expanded)
        end;
        Error(Message):
        begin
          AssertTrue(false)
        end
      end
    end;
    Error(Message):
    begin
      AssertTrue(false)
    end
  end;
  case LoadWorkspace('apps/ide/ide.fpasworkspace') of
    Ok(Ws):
    begin
      Ide.Workspace.Session.Reset();
      OpenPath('apps/ide/ide.fpasworkspace');
      case BuildSessionRootNodes() of
        Ok(Roots):
        begin
          AssertEquals(1, Std.Array.Length(Roots));
          AssertEquals('ide', Roots[0].text);
          AssertTrue(Roots[0].expanded);
          AssertEquals(3, Std.Array.Length(Roots[0].children))
        end;
        Error(Message):
        begin
          AssertTrue(false)
        end
      end;
      Ide.Workspace.Session.Reset()
    end;
    Error(Message):
    begin
      AssertTrue(false)
    end
  end
end.
