// Immutable state and transcript formatting for the Local Chat application.
unit LocalChat.Model;

uses Std.Array, Std.Console, Std.Str, Std.Tui;

public type
  // Origin of one visible local chat entry.
  ChatRole = enum
    // Prompt submitted by the user.
    User;
    // Text returned by the local model.
    Assistant;
    // Error returned while processing a request.
    Failure;
  end;
  // One entry retained for display during the current process.
  ChatEntry = record
    // Origin used to label the entry.
    public Role: ChatRole;
    // Entry text displayed in the transcript.
    public Text: string;

    // Creates a user entry.
    //
    // Parameters:
    // - `Text`: Prompt text submitted by the user.
    public static function User(Text: string): ChatEntry;
    begin
      return record
        Role := ChatRole.User;
        Text := Text;
      end
    end;

    // Creates an assistant entry.
    //
    // Parameters:
    // - `Text`: Completion text returned by the model.
    public static function Assistant(Text: string): ChatEntry;
    begin
      return record
        Role := ChatRole.Assistant;
        Text := Text;
      end
    end;

    // Creates a failed-request entry.
    //
    // Parameters:
    // - `Text`: Error text returned by the request service.
    public static function Failure(Text: string): ChatEntry;
    begin
      return record
        Role := ChatRole.Failure;
        Text := Text;
      end
    end;
  end;
  // Complete immutable state supplied to the Local Chat MVU view.
  LocalChatModel = record
    // Conversation entries in display order.
    public Entries: array of ChatEntry;
    // Current prompt editor contents.
    public Draft: string;
    // Caret position inside `Draft`.
    public DraftCaret: integer;
    // Caret position inside the read-only transcript.
    public TranscriptCaret: integer;
    // Current transcript viewport offset.
    public TranscriptOffset: TuiPoint;
    // Identifier of the focused control.
    public Focus: integer;
    // Short status text shown in the footer.
    public Status: string;
    // Current terminal width in cells.
    public Width: integer;
    // Current terminal height in cells.
    public Height: integer;
  end;

// Creates an empty Local Chat model for the supplied terminal size.
//
// Parameters:
// - `Width`: Initial terminal width in cells.
// - `Height`: Initial terminal height in cells.
public function LocalChatModelCreate(Width: integer; Height: integer): LocalChatModel;
begin
  return record
    Entries := [];
    Draft := '';
    DraftCaret := 0;
    TranscriptCaret := 0;
    TranscriptOffset := TuiPoint.Create(0, 0);
    Focus := 1;
    Status := 'Ready';
    Width := Width;
    Height := Height;
  end
end;

// Wraps text at grapheme boundaries for a cell-width limit.
//
// Parameters:
// - `Text`: Text to wrap without splitting grapheme clusters.
// - `MaximumWidth`: Maximum display width of each output line.
function WrapText(Text: string; MaximumWidth: integer): string;
begin
  if MaximumWidth <= 0 then
  begin
    return ''
  end;
  mutable var Wrapped: string := '';
  mutable var LineWidth: integer := 0;
  var NewLine: string := Std.Str.Chr(10);
  for Grapheme: string in Std.Console.SplitGraphemes(Text) do
  begin
    if Grapheme = NewLine then
    begin
      Wrapped := Wrapped + NewLine;
      LineWidth := 0
    end
    else
    begin
      var GraphemeWidth: integer := Std.Console.DisplayWidth(Grapheme);
      if (LineWidth > 0) and (LineWidth + GraphemeWidth > MaximumWidth) then
      begin
        Wrapped := Wrapped + NewLine;
        LineWidth := 0
      end;

      Wrapped := Wrapped + Grapheme;
      LineWidth := LineWidth + GraphemeWidth
    end
  end;

  return Wrapped
end;

// Returns the transcript label for one chat role.
//
// Parameters:
// - `Role`: Entry origin to label.
function RoleLabel(Role: ChatRole): string;
begin
  case Role of
    ChatRole.User:
    begin
      return 'YOU'
    end;
    ChatRole.Assistant:
    begin
      return 'ASSISTANT'
    end;
    ChatRole.Failure:
    begin
      return 'ERROR'
    end
  end
end;

// Builds the width-bounded transcript displayed by the read-only transcript area.
//
// Parameters:
// - `State`: Current application state containing entries and terminal dimensions.
public function LocalChatTranscript(State: LocalChatModel): string;
begin
  if Std.Array.Length(State.Entries) = 0 then
  begin
    return ('No messages yet.' + Std.Str.Chr(10)) + 'Type below and press Enter.'
  end;
  mutable var MaximumWidth: integer := State.Width - 6;
  if MaximumWidth < 1 then
  begin
    MaximumWidth := 1
  end;
  mutable var Transcript: string := '';
  var NewLine: string := Std.Str.Chr(10);
  for Index: integer := 0 to Std.Array.Length(State.Entries) - 1 do
  begin
    if Transcript <> '' then
    begin
      Transcript := (Transcript + NewLine) + NewLine
    end;

    Transcript := ((Transcript + RoleLabel(State.Entries[Index].Role)) + NewLine) +
                  WrapText(State.Entries[Index].Text, MaximumWidth)
  end;

  return Transcript
end;

// Moves the transcript caret and viewport to the latest visible entry.
//
// Parameters:
// - `State`: Current application state to scroll.
public function LocalChatScrollToEnd(State: LocalChatModel): LocalChatModel;
begin
  mutable var Next: LocalChatModel := State;
  var Transcript: string := LocalChatTranscript(Next);
  Next.TranscriptCaret := Std.Str.Length(Transcript);
  mutable var VisibleLines: integer := Next.Height - 7;
  if VisibleLines < 1 then
  begin
    VisibleLines := 1
  end;
  var LineCount: integer := Std.Array.Length(Std.Str.Split(Transcript, Std.Str.Chr(10)));
  mutable var OffsetY: integer := LineCount - VisibleLines;
  if OffsetY < 0 then
  begin
    OffsetY := 0
  end;

  Next.TranscriptOffset := TuiPoint.Create(0, OffsetY);
  return Next
end;
