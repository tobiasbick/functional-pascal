// OpenAI-compatible request boundary for the Local Chat application.
unit LocalChat.Service;

uses LocalChat.Config as Config;
uses Std.Ai.OpenAi as OpenAi;

// Sends one independent prompt to the fixed local llama.cpp model.
//
// Parameters:
// - `Prompt`: User prompt sent as the sole chat message.
public function LocalChatRequest(Prompt: string): Result of (string, string);
begin
  var ClientValue: OpenAi.Client := OpenAi.Client.Create(Config.LocalChatBaseUrl, Config.LocalChatModelName);
  return OpenAi.Complete(ClientValue, [OpenAi.ChatMessage.User(Prompt)], OpenAi.ChatOptions.Default());
end function;

end unit;
