// Color palette used by the Local Chat TUI.
unit LocalChat.Theme;

uses Std.Tui as Tui;

// Returns the dark cyan-and-amber truecolor palette shared with the Notes design language.
public function LocalChatPalette(): Tui.TuiPalette;
begin
  var Background: Tui.TuiColor := Tui.TuiColor.FromRgb(10, 15, 23);
  var Surface: Tui.TuiColor := Tui.TuiColor.FromRgb(17, 24, 35);
  var SurfaceFocused: Tui.TuiColor := Tui.TuiColor.FromRgb(24, 39, 53);
  var Text: Tui.TuiColor := Tui.TuiColor.FromRgb(216, 226, 236);
  var Muted: Tui.TuiColor := Tui.TuiColor.FromRgb(126, 145, 160);
  var Border: Tui.TuiColor := Tui.TuiColor.FromRgb(42, 61, 75);
  var Accent: Tui.TuiColor := Tui.TuiColor.FromRgb(70, 211, 196);
  var Amber: Tui.TuiColor := Tui.TuiColor.FromRgb(245, 184, 76);
  var Coral: Tui.TuiColor := Tui.TuiColor.FromRgb(244, 112, 106);
  mutable var Palette: Tui.TuiPalette := Tui.TuiPalette.Default();
  Palette.Normal := Tui.TuiStyle.FromColors(Text, Background);
  Palette.Disabled := Tui.TuiStyle.FromColors(Muted, Background);
  Palette.Focused := Tui.TuiStyle.FromColors(Text, SurfaceFocused);
  Palette.Selected := Tui.TuiStyle.FromColors(Text, SurfaceFocused);
  Palette.Shortcut := Tui.TuiStyle.Create(Accent, Background, true, false, false, false);
  Palette.Frame := Tui.TuiStyle.FromColors(Border, Background);
  Palette.Title := Tui.TuiStyle.Create(Text, Background, true, false, false, false);
  Palette.StatusNormal := Tui.TuiStyle.FromColors(Text, Surface);
  Palette.StatusShortcut := Tui.TuiStyle.Create(Accent, Surface, true, false, false, false);
  Palette.StatusSelected := Tui.TuiStyle.FromColors(Background, Accent);
  Palette.Rule := Tui.TuiStyle.FromColors(Border, Background);
  Palette.Failure := Tui.TuiStyle.FromColors(Coral, Background);
  Palette.Warning := Tui.TuiStyle.FromColors(Amber, Background);
  Palette.Accent := Tui.TuiStyle.Create(Accent, Background, true, false, false, false);
  Palette.Inputs := Palette.Inputs.WithRole(Tui.TuiStyleRole.InputNormal, Tui.TuiStyle.FromColors(Text, Surface));
  Palette.Inputs := Palette.Inputs.WithRole(Tui.TuiStyleRole.InputFocused, Tui.TuiStyle.FromColors(Text, SurfaceFocused));
  Palette.Inputs := Palette.Inputs.WithRole(Tui.TuiStyleRole.InputHint, Tui.TuiStyle.FromColors(Muted, Surface));
  Palette.Inputs := Palette.Inputs.WithRole(Tui.TuiStyleRole.InputCursor, Tui.TuiStyle.FromColors(Background, Accent));
  return Palette;
end function;

end unit;
