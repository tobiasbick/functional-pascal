// Color palette used by the Local Chat TUI.
unit LocalChat.Theme;

uses Std.Tui as Tui;
uses Std.Tui.Cells as Cells;

// Returns the dark cyan-and-amber truecolor palette shared with the Notes design language.
public function LocalChatPalette(): Tui.TuiPalette;
begin
  const Background: Tui.TuiColor := Cells.TuiColorFromRgb(10, 15, 23);
  const Surface: Tui.TuiColor := Cells.TuiColorFromRgb(17, 24, 35);
  const SurfaceFocused: Tui.TuiColor := Cells.TuiColorFromRgb(24, 39, 53);
  const Text: Tui.TuiColor := Cells.TuiColorFromRgb(216, 226, 236);
  const Muted: Tui.TuiColor := Cells.TuiColorFromRgb(126, 145, 160);
  const Border: Tui.TuiColor := Cells.TuiColorFromRgb(42, 61, 75);
  const Accent: Tui.TuiColor := Cells.TuiColorFromRgb(70, 211, 196);
  const Amber: Tui.TuiColor := Cells.TuiColorFromRgb(245, 184, 76);
  const Coral: Tui.TuiColor := Cells.TuiColorFromRgb(244, 112, 106);
  var Palette: Tui.TuiPalette := Cells.TuiPaletteDefault();
  Palette.Normal := Cells.TuiStyleFromColors(Text, Background);
  Palette.Disabled := Cells.TuiStyleFromColors(Muted, Background);
  Palette.Focused := Cells.TuiStyleFromColors(Text, SurfaceFocused);
  Palette.Selected := Cells.TuiStyleFromColors(Text, SurfaceFocused);
  Palette.Shortcut := Cells.TuiStyleCreate(Accent, Background, true, false, false, false);
  Palette.Frame := Cells.TuiStyleFromColors(Border, Background);
  Palette.Title := Cells.TuiStyleCreate(Text, Background, true, false, false, false);
  Palette.StatusNormal := Cells.TuiStyleFromColors(Text, Surface);
  Palette.StatusShortcut := Cells.TuiStyleCreate(Accent, Surface, true, false, false, false);
  Palette.StatusSelected := Cells.TuiStyleFromColors(Background, Accent);
  Palette.Rule := Cells.TuiStyleFromColors(Border, Background);
  Palette.Failure := Cells.TuiStyleFromColors(Coral, Background);
  Palette.Warning := Cells.TuiStyleFromColors(Amber, Background);
  Palette.Accent := Cells.TuiStyleCreate(Accent, Background, true, false, false, false);
  Palette.Inputs := Cells.TuiInputPaletteWithRole(Palette.Inputs, Tui.TuiStyleRole.InputNormal, Cells.TuiStyleFromColors(Text, Surface));
  Palette.Inputs := Cells.TuiInputPaletteWithRole(Palette.Inputs, Tui.TuiStyleRole.InputFocused, Cells.TuiStyleFromColors(Text, SurfaceFocused));
  Palette.Inputs := Cells.TuiInputPaletteWithRole(Palette.Inputs, Tui.TuiStyleRole.InputHint, Cells.TuiStyleFromColors(Muted, Surface));
  Palette.Inputs := Cells.TuiInputPaletteWithRole(Palette.Inputs, Tui.TuiStyleRole.InputCursor, Cells.TuiStyleFromColors(Background, Accent));
  return Palette;
end function;

end unit;
