unit LocalChat.Update;

uses LocalChat.Model, LocalChat.Service, Std.Array, Std.Console, Std.Option, Std.Str, Std.Tui;

const
  PromptControl: integer := 1;
  PromptChangedAction: integer := 1;
  TranscriptChangedAction: integer := 2;
  SendAction: integer := 10;

function AppendEntry(State: LocalChatModel; Entry: ChatEntry): LocalChatModel;
begin
  mutable var Next: LocalChatModel := State;
  mutable var Entries: array of ChatEntry := Next.Entries;
  Std.Array.Push(Entries, Entry);
  Next.Entries := Entries;
  return Next
end;

function SendPrompt(State: LocalChatModel): LocalChatModel;
begin
  var Prompt: string := Std.Str.Trim(State.Draft);
  if Prompt = '' then
  begin
    mutable var Empty: LocalChatModel := State;
    Empty.Status := 'Enter a message first';
    return Empty
  end;
  mutable var Next: LocalChatModel := AppendEntry(State, ChatEntry.User(Prompt));
  Next.Draft := '';
  Next.DraftCaret := 0;
  Next.Status := 'Contacting local model…';
  case LocalChatRequest(Prompt) of
    Ok(Content):
    begin
      Next := AppendEntry(Next, ChatEntry.Assistant(Content));
      Next.Status := 'Ready'
    end;
    Error(Message):
    begin
      Next := AppendEntry(Next, ChatEntry.Failure(Message));
      Next.Status := 'Request failed'
    end
  end;

  Next.Focus := PromptControl;
  return LocalChatScrollToEnd(Next)
end;

function IsQuitShortcut(Key: TuiKeyEvent): boolean;
begin
  return ((((Key.kind = Std.Console.KeyKind.Character) and Key.alt) and (not Key.ctrl)) and (not Key.meta)) and
         ((Key.ch = 'x') or (Key.ch = 'X'))
end;

// Applies one routed TUI message to the Local Chat application model.
public function LocalChatUpdate(State: LocalChatModel; Msg: TuiMsg; Cmd: TuiCmdOutput): LocalChatModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.TextChanged(Source, Action, Text, Caret):
    begin
      if Action.Value = PromptChangedAction then
      begin
        mutable var Next: LocalChatModel := State;
        Next.Draft := Text;
        Next.DraftCaret := Caret;
        Next.Status := 'Ready';
        return Next
      end;

      return State
    end;
    TuiMsg.TextAreaChanged(Source, Action, Text, Caret, Offset):
    begin
      if Action.Value = TranscriptChangedAction then
      begin
        mutable var Next: LocalChatModel := State;
        Next.TranscriptCaret := Caret;
        Next.TranscriptOffset := Offset;
        return Next
      end;

      return State
    end;
    TuiMsg.Action(Source, Action):
    begin
      if Action.Value = SendAction then
      begin
        return SendPrompt(State)
      end;

      return State
    end;
    TuiMsg.Key(Key):
    begin
      if IsQuitShortcut(Key) then
      begin
        Cmd.Set(TuiCmd.Quit)
      end;

      return State
    end;
    TuiMsg.Resize(Size):
    begin
      mutable var Next: LocalChatModel := State;
      Next.Width := Size.Width;
      Next.Height := Size.Height;
      return LocalChatScrollToEnd(Next)
    end;
    TuiMsg.FocusChanged(Previous, Current):
    begin
      case Current of
        Some(CurrentId):
        begin
          mutable var Next: LocalChatModel := State;
          Next.Focus := CurrentId.Value;
          return Next
        end;
        None:
        begin
          return State
        end
      end
    end;
    TuiMsg.QuitRequested:
    begin
      return State
    end;
    TuiMsg.Pointer(Pointer):
    begin
      return State
    end;
    TuiMsg.Tick(Delta):
    begin
      return State
    end;
    TuiMsg.SelectionChanged(Source, Action, Selected):
    begin
      return State
    end;
    TuiMsg.CheckChanged(CheckSource, CheckAction, Checked):
    begin
      return State
    end;
    TuiMsg.ScrollChanged(ScrollSource, ScrollAction, ScrollOffset):
    begin
      return State
    end;
    TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
    begin
      return State
    end
  end
end;
