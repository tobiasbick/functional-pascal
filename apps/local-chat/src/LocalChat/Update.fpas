// MVU update logic for the Local Chat application.
unit LocalChat.Update;

uses LocalChat.Model as Model;
uses LocalChat.Service as Service;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Tui as Tui;

// Identifier of the prompt input control.
const PromptControl: integer := 1;
// Action emitted when the prompt text changes.
const PromptChangedAction: integer := 1;
// Action emitted when the transcript viewport changes.
const TranscriptChangedAction: integer := 2;
// Action emitted by the send button.
const SendAction: integer := 10;

// Appends one entry without mutating the supplied model value.
//
// Parameters:
// - `State`: Current application state.
// - `Entry`: Entry to append to the conversation.
function AppendEntry(State: Model.LocalChatModel; Entry: Model.ChatEntry): Model.LocalChatModel;
begin
  mutable var Next: Model.LocalChatModel := State;
  mutable var Entries: array of Model.ChatEntry := Next.Entries;
  Arrays.Push(Entries, Entry);
  Next.Entries := Entries;
  return Next;
end function;

// Sends the current non-empty draft and records its result.
//
// Parameters:
// - `State`: Current application state containing the draft.
function SendPrompt(State: Model.LocalChatModel): Model.LocalChatModel;
begin
  var Prompt: string := Str.Trim(State.Draft);
  if Prompt = '' then
    begin
      mutable var Empty: Model.LocalChatModel := State;
      Empty.Status := 'Enter a message first';
      return Empty;
    end;
  end if;
  mutable var Next: Model.LocalChatModel := AppendEntry(State, Model.ChatEntry.User(Prompt));
  Next.Draft := '';
  Next.DraftCaret := 0;
  Next.Status := 'Contacting local model…';
  case Service.LocalChatRequest(Prompt) of
    when Ok(Content):
      begin
        Next := AppendEntry(Next, Model.ChatEntry.Assistant(Content));
        Next.Status := 'Ready';
      end;
    when Error(Message):
      begin
        Next := AppendEntry(Next, Model.ChatEntry.Failure(Message));
        Next.Status := 'Request failed';
      end;
  end case;

  Next.Focus := PromptControl;
  return Model.LocalChatScrollToEnd(Next);
end function;

// Reports whether a key event is the Alt+X quit shortcut.
//
// Parameters:
// - `Key`: Key event to inspect.
function IsQuitShortcut(Key: Tui.TuiKeyEvent): boolean;
begin
  return ((((Key.kind = Console.KeyKind.Character) and Key.alt) and (not Key.ctrl)) and (not Key.meta)) and
         ((Key.ch = 'x') or (Key.ch = 'X'));
end function;

// Applies one routed TUI message to the Local Chat application model.
//
// Parameters:
// - `State`: Current immutable application state.
// - `Msg`: Routed TUI message to process.
// - `Cmd`: Command output updated when the message requests a host action.
public function LocalChatUpdate(State: Model.LocalChatModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Model.LocalChatModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.TextChanged(Source, Action, Text, Caret):
      begin
        if Action.Value = PromptChangedAction then
          begin
            mutable var Next: Model.LocalChatModel := State;
            Next.Draft := Text;
            Next.DraftCaret := Caret;
            Next.Status := 'Ready';
            return Next;
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.TextAreaChanged(Source, Action, Text, Caret, Offset):
      begin
        if Action.Value = TranscriptChangedAction then
          begin
            mutable var Next: Model.LocalChatModel := State;
            Next.TranscriptCaret := Caret;
            Next.TranscriptOffset := Offset;
            return Next;
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.Action(Source, Action):
      begin
        if Action.Value = SendAction then
          begin
            return SendPrompt(State);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.Key(Key):
      begin
        if IsQuitShortcut(Key) then
          begin
            Cmd.Set(Tui.TuiCmd.Quit);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.Resize(Size):
      begin
        mutable var Next: Model.LocalChatModel := State;
        Next.Width := Size.Width;
        Next.Height := Size.Height;
        return Model.LocalChatScrollToEnd(Next);
      end;
    when Tui.TuiMsg.FocusChanged(Previous, Current):
      begin
        case Current of
          when Some(CurrentId):
            begin
              mutable var Next: Model.LocalChatModel := State;
              Next.Focus := CurrentId.Value;
              return Next;
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        return State;
      end;
    when Tui.TuiMsg.Pointer(Pointer):
      begin
        return State;
      end;
    when Tui.TuiMsg.Tick(Delta):
      begin
        return State;
      end;
    when Tui.TuiMsg.SelectionChanged(Source, Action, Selected):
      begin
        return State;
      end;
    when Tui.TuiMsg.CheckChanged(CheckSource, CheckAction, Checked):
      begin
        return State;
      end;
    when Tui.TuiMsg.ScrollChanged(ScrollSource, ScrollAction, ScrollOffset):
      begin
        return State;
      end;
    when Tui.TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
      begin
        return State;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

end unit;
