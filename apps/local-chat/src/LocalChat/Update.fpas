// MVU update logic for the Local Chat application.
unit LocalChat.Update;

uses LocalChat.Model, LocalChat.Service, Std.Console, Std.Tui;

// Identifier of the prompt input control.
const PromptControl: integer := 1;
// Action emitted when the prompt text changes.
const PromptChangedAction: integer := 1;
// Action emitted when the transcript viewport changes.
const TranscriptChangedAction: integer := 2;
// Action emitted by the send button.
const SendAction: integer := 10;

// Appends one entry without mutating the supplied model value.
//
// Parameters:
// - `State`: Current application state.
// - `Entry`: Entry to append to the conversation.
function AppendEntry(State: LocalChatModel; Entry: ChatEntry): LocalChatModel;
begin
  var Next: LocalChatModel := State;
  var Entries: array of ChatEntry := Next.Entries;
  Entries.Push(Entry);
  Next.Entries := Entries;
  return Next;
end function;

// Sends the current non-empty draft and records its result.
//
// Parameters:
// - `State`: Current application state containing the draft.
function SendPrompt(State: LocalChatModel): LocalChatModel;
begin
  const Prompt: string := State.Draft.Trim();
  if Prompt = '' then
    begin
      var Empty: LocalChatModel := State;
      Empty.Status := 'Enter a message first';
      return Empty;
    end;
  end if;
  var Next: LocalChatModel := AppendEntry(State, ChatEntry.User(Prompt));
  Next.Draft := '';
  Next.DraftCaret := 0;
  Next.Status := 'Contacting local model…';
  case LocalChatRequest(Prompt) of
    when Ok(const Content):
      begin
        Next := AppendEntry(Next, ChatEntry.Assistant(Content));
        Next.Status := 'Ready';
      end;
    when Error(const Message):
      begin
        Next := AppendEntry(Next, ChatEntry.Failure(Message));
        Next.Status := 'Request failed';
      end;
  end case;

  Next.Focus := PromptControl;
  return LocalChatScrollToEnd(Next);
end function;

// Reports whether a key event is the Alt+X quit shortcut.
//
// Parameters:
// - `Key`: Key event to inspect.
function IsQuitShortcut(Key: TuiKeyEvent): boolean;
begin
  return ((((Key.kind = Std.Console.KeyKind.Character) and Key.alt) and (not Key.ctrl)) and (not Key.meta)) and
         ((Key.ch = 'x') or (Key.ch = 'X'));
end function;

// Applies one routed TUI message to the Local Chat application model.
//
// Parameters:
// - `State`: Current immutable application state.
// - `Msg`: Routed TUI message to process.
// - `Cmd`: Command output updated when the message requests a host action.
public function LocalChatUpdate(State: LocalChatModel; Msg: TuiMsg; Cmd: TuiCmdOutput): LocalChatModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        if Action.Value = PromptChangedAction then
          begin
            var Next: LocalChatModel := State;
            Next.Draft := Text;
            Next.DraftCaret := Caret;
            Next.Status := 'Ready';
            return Next;
          end;
        end if;

        return State;
      end;
    when TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset):
      begin
        if Action.Value = TranscriptChangedAction then
          begin
            var Next: LocalChatModel := State;
            Next.TranscriptCaret := Caret;
            Next.TranscriptOffset := Offset;
            return Next;
          end;
        end if;

        return State;
      end;
    when TuiMsg.Action(const Source, const Action):
      begin
        if Action.Value = SendAction then
          begin
            return SendPrompt(State);
          end;
        end if;

        return State;
      end;
    when TuiMsg.Key(const Key):
      begin
        if IsQuitShortcut(Key) then
          begin
            Cmd.Set(TuiCmd.Quit);
          end;
        end if;

        return State;
      end;
    when TuiMsg.Resize(const Size):
      begin
        var Next: LocalChatModel := State;
        Next.Width := Size.Width;
        Next.Height := Size.Height;
        return LocalChatScrollToEnd(Next);
      end;
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const CurrentId):
            begin
              var Next: LocalChatModel := State;
              Next.Focus := CurrentId.Value;
              return Next;
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.QuitRequested:
      begin
        return State;
      end;
    when TuiMsg.Pointer(const Pointer):
      begin
        return State;
      end;
    when TuiMsg.Tick(const Delta):
      begin
        return State;
      end;
    when TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return State;
      end;
    when TuiMsg.CheckChanged(const CheckSource, const CheckAction, const Checked):
      begin
        return State;
      end;
    when TuiMsg.ScrollChanged(const ScrollSource, const ScrollAction, const ScrollOffset):
      begin
        return State;
      end;
    when TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        return State;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;
end unit;
