// Responsive TUI element construction for the Local Chat application.
unit LocalChat.View;

uses LocalChat.Model as Model;
uses Std.Options as Options;
uses Std.Tui as Tui;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Layout as Layout2;

// Identifier of the prompt input control.
const PromptControl: integer := 1;
// Identifier of the transcript text area.
const TranscriptControl: integer := 2;
// Action emitted when the prompt text changes.
const PromptChangedAction: integer := 1;
// Action emitted when the transcript viewport changes.
const TranscriptChangedAction: integer := 2;
// Action emitted by the send button.
const SendAction: integer := 10;

// Wraps one child in an expanding layout element.
//
// Parameters:
// - `Child`: Element placed inside the layout wrapper.
// - `Stretch`: Relative space assigned by the parent layout.
function Expanding(Child: Tui.TuiElement; Stretch: integer): Tui.TuiElement;
begin
  return Elements.TuiElementMakeLayout(Layout2.TuiLayoutSettingsCreate(Layout2.TuiMarginsUniform(0), Layout2.TuiSizePolicyExpanding(), Layout2.TuiAlignmentFill(), Stretch), Child);
end function;

// Builds the application header rule.
function Header(): Tui.TuiElement;
begin
  return Elements.TuiElementMakeRule(' LOCAL CHAT  ·  llama.cpp  ·  one prompt per request ');
end function;

// Builds the read-only transcript panel.
//
// Parameters:
// - `State`: Current application state rendered by the panel.
function Transcript(State: Model.LocalChatModel): Tui.TuiElement;
begin
  const Content: Tui.TuiElement := Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(TranscriptControl), Model.LocalChatTranscript(State), State.TranscriptCaret, State.TranscriptOffset, Ids.TuiActionCreate(TranscriptChangedAction));
  return Elements.TuiElementMakePanel('Conversation', [Expanding(Content, 1)]);
end function;

// Builds the prompt input and send-button panel.
//
// Parameters:
// - `State`: Current application state rendered by the composer.
function Composer(State: Model.LocalChatModel): Tui.TuiElement;
begin
  const Prompt: Tui.TuiElement := Elements.TuiElementMakeInputWithHint(Ids.TuiControlIdCreate(PromptControl), State.Draft, State.DraftCaret, 'Message the local model…', Ids.TuiActionCreate(PromptChangedAction));
  const Send: Tui.TuiElement := Elements.TuiElementMakeDefaultButton(Ids.TuiControlIdCreate(3), 'Send', 'S', Ids.TuiActionCreate(SendAction));
  return Elements.TuiElementMakePanel('Message', [
                                                   Elements.TuiElementMakeRow([Expanding(Prompt, 1), Send])
                                                 ]);
end function;

// Builds the footer status line and keyboard hints.
//
// Parameters:
// - `State`: Current application state providing status text.
function Status(State: Model.LocalChatModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeStatusLine([
                                             Chrome.TuiStatusItemMakeHint(State.Status),
                                             Chrome.TuiStatusItemMakeKeyHint('Enter', 'send'),
                                             Chrome.TuiStatusItemMakeKeyHint('Tab', 'focus'),
                                             Chrome.TuiStatusItemMakeKeyHint('Alt+X', 'quit')
                                           ]);
end function;

// Builds the responsive Local Chat element tree for one model state.
//
// Parameters:
// - `State`: Current application state to render.
public function LocalChatView(State: Model.LocalChatModel): Tui.TuiElement;
begin
  if (State.Width < 50) or (State.Height < 14) then
    begin
      return Elements.TuiElementMakeDesktop(Option.None, [
                                                           Elements.TuiElementMakePanel('Local Chat', [
                                                                                                        Elements.TuiElementMakeLabel('Terminal too small'),
                                                                                                        Elements.TuiElementMakeLabel('Use at least 50 × 14 cells.')
                                                                                                      ])
                                                         ]);
    end;
  end if;

  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakeColumn([
                                                                                                                            Header(),
                                                                                                                            Expanding(Transcript(State), 1),
                                                                                                                            Composer(State),
                                                                                                                            Status(State)
                                                                                                                          ])
                                                                                          ]);
end function;

end unit;
