// Responsive TUI element construction for the Local Chat application.
unit LocalChat.View;

uses LocalChat.Model as Model, Std.Ui.Terminal as Tui;

type TranscriptData = record
  Entries: array of Model.ChatEntry;
  Width: integer;
  Caret: integer;
  Offset: Tui.TuiPoint;
end record;

function SameTranscript(Previous: TranscriptData; Current: TranscriptData): boolean;
begin
  if (Previous.Width <> Current.Width) or (Previous.Caret <> Current.Caret)
    or
    (Previous.Offset <> Current.Offset) or (Previous.Entries.Length() <> Current.Entries.Length())
  then
    return false;
  end if;

  for Index: integer := 0 to Current.Entries.Length() - 1 do
    if Previous.Entries[Index] <> Current.Entries[Index] then
      return false;
    end if;
  end for;

  return true;
end function;

// Identifier of the prompt input control.
const PromptControl: integer := 1;
// Identifier of the transcript text area.
const TranscriptControl: integer := 2;
// Action emitted when the prompt text changes.
const PromptChangedAction: integer := 1;
// Action emitted when the transcript viewport changes.
const TranscriptChangedAction: integer := 2;
// Action emitted by the send button.
const SendAction: integer := 10;

// Wraps one child in an expanding layout element.
//
// Parameters:
// - `Child`: Element placed inside the layout wrapper.
// - `Stretch`: Relative space assigned by the parent layout.
function Expanding(Child: Tui.TuiElement; Stretch: integer): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLayout(
    Tui.TuiLayoutSettings.Create(
      Tui.TuiMargins.Uniform(0),
      Tui.TuiSizePolicy.Expanding(),
      Tui.TuiAlignment.Fill(),
      Stretch
    ),
    Child
  );
end function;

// Builds the application header rule.
function Header(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeRule(' LOCAL CHAT  ·  llama.cpp  ·  one prompt per request ');
end function;

// Builds the read-only transcript panel.
//
// Parameters:
// - `State`: Current application state rendered by the panel.
function Transcript(Data: TranscriptData): Tui.TuiElement;
begin
  const Content: Tui.TuiElement := Tui.TuiElementBuilders.MakeTextArea(
    Tui.TuiControlId.Create(TranscriptControl),
    Model.LocalChatTranscript(Data.Entries, Data.Width),
    Data.Caret,
    Data.Offset,
    Tui.TuiAction.Create(TranscriptChangedAction)
  );
  return Tui.TuiElementBuilders.MakePanel('Conversation', [Expanding(Content, 1)]);
end function;

const TranscriptView: Tui.TuiSubview of TranscriptData := Tui.TuiSubview.Create(
  Transcript,
  SameTranscript
);
const HeaderView: Tui.TuiElement := Header();

// Builds the prompt input and send-button panel.
//
// Parameters:
// - `State`: Current application state rendered by the composer.
function Composer(State: Model.LocalChatModel): Tui.TuiElement;
begin
  const Prompt: Tui.TuiElement := Tui.TuiElementBuilders.MakeInputWithHint(
    Tui.TuiControlId.Create(PromptControl),
    State.Draft,
    State.DraftCaret,
    'Message the local model…',
    Tui.TuiAction.Create(PromptChangedAction)
  );
  const Send: Tui.TuiElement := Tui.TuiElementBuilders.MakeDefaultButton(
    Tui.TuiControlId.Create(3),
    'Send',
    'S',
    Tui.TuiAction.Create(SendAction)
  );
  return Tui.TuiElementBuilders.MakePanel(
    'Message', [
      Tui.TuiElementBuilders.MakeRow([Expanding(Prompt, 1), Send])
    ]
  );
end function;

// Immutable hints shared by all footer values.
const StatusHints: array of Tui.TuiStatusItem := [
  Tui.TuiStatusItemBuilders.MakeKeyHint('Enter', 'send'),
  Tui.TuiStatusItemBuilders.MakeKeyHint('Tab', 'focus'),
  Tui.TuiStatusItemBuilders.MakeKeyHint('Alt+X', 'quit')
];

function Status(State: Model.LocalChatModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeStatusLine(
    [Tui.TuiStatusItemBuilders.MakeHint(State.Status)].Concat(StatusHints)
  );
end function;

// Builds the responsive Local Chat element tree for one model state.
//
// Parameters:
// - `State`: Current application state to render.
public function LocalChatView(State: Model.LocalChatModel): Tui.TuiElement;
begin
  if (State.Width < 50) or (State.Height < 14) then
    begin
      return Tui.TuiElementBuilders.MakeDesktop(
        None, [
          Tui.TuiElementBuilders.MakePanel(
            'Local Chat', [
              Tui.TuiElementBuilders.MakeLabel('Terminal too small'),
              Tui.TuiElementBuilders.MakeLabel('Use at least 50 × 14 cells.')
            ]
          )
        ]
      );
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(
    Some(Tui.TuiControlId.Create(State.Focus)), [
      Tui.TuiElementBuilders.MakeColumn([
        HeaderView,
        Expanding(
          TranscriptView.Render(
            TranscriptData(
              Entries := State.Entries, Width := State.Width,
              Caret := State.TranscriptCaret, Offset := State.TranscriptOffset
            )
          ), 1
        ),
        Composer(State),
        Status(State)
      ])
    ]
  );
end function;
end unit;
