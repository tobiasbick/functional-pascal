// Starts the fixed-endpoint Local Chat terminal application.
program LocalChat;

uses LocalChat.Model as Model;
uses LocalChat.Theme as Theme;
uses LocalChat.Update as Update;
uses LocalChat.View as View;
uses Std.Console as Console;
uses Std.Tui as Tui;

begin
  var Initial: Model.LocalChatModel := Model.LocalChatModelCreate(Console.ScreenWidth(), Console.ScreenHeight());
  discard Tui.TuiApplication.RunWithPalette(Initial, Update.LocalChatUpdate, View.LocalChatView, Theme.LocalChatPalette());
end program;
