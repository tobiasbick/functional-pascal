// Starts the fixed-endpoint Local Chat terminal application.
program LocalChat;

uses LocalChat.Model, LocalChat.Theme, LocalChat.Update, LocalChat.View, Std.Console, Std.Tui;

begin
  const Initial: LocalChatModel := LocalChatModelCreate(Std.Console.ScreenWidth(), Std.Console.ScreenHeight());
  discard TuiApplication.RunWithPalette(Initial, LocalChatUpdate, LocalChatView, LocalChatPalette());
end.
