// Starts the fixed-endpoint Local Chat terminal application.
program LocalChat;

uses LocalChat.Model as Model;
uses LocalChat.Theme as Theme;
uses LocalChat.Update as Update;
uses LocalChat.View as View;
uses Std.Console as Console;
uses Std.Tui as Tui;
uses Std.Tui.Runtime as Runtime;

begin
  const Initial: Model.LocalChatModel := Model.LocalChatModelCreate(Console.ScreenWidth(), Console.ScreenHeight());
  discard Runtime.TuiApplicationRunWithPalette(Initial, Update.LocalChatUpdate, View.LocalChatView, Theme.LocalChatPalette());
end program;
