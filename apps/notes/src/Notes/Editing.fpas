// Controlled text proposals and selection updates for Notes.
unit Notes.Editing;

uses Notes.Actions as Actions;
uses Notes.Model as Model;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Tui as Tui;

// Reports whether the selection refers to an existing note.
public function NotesHasSelection(State: Model.NotesModel): boolean;
begin
  return (State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes));
end function;

// Replaces one note while preserving the remaining model state.
public function NotesWithNote(State: Model.NotesModel; Index: integer; NoteValue: Model.Note): Model.NotesModel;
begin
  mutable var Notes: array of Model.Note := State.Notes;
  Notes[Index] := NoteValue;
  mutable var Next: Model.NotesModel := State;
  Next.Notes := Notes;
  return Next;
end function;

function SameTags(Left: array of string; Right: array of string): boolean;
begin
  if Arrays.Length(Left) <> Arrays.Length(Right) then
    begin
      return false;
    end;
  end if;

  for Index: integer := 0 to Arrays.Length(Left) - 1 do
    begin
      if Left[Index] <> Right[Index] then
        begin
          return false;
        end;
      end if;
    end;
  end for;

  return true;
end function;

// Applies a single-line proposal, preserving clean state for caret-only changes.
public function NotesEditText(State: Model.NotesModel; Action: integer; Text: string; Caret: integer): Model.NotesModel;
begin
  mutable var Next: Model.NotesModel := State;
  if Action = Actions.SearchChangedAction then
    begin
      Next.Search := Text;
      Next.SearchCaret := Caret;
      Next.Status := Conv.IntToStr(Arrays.Length(Model.NotesFilteredIndices(Next.Notes, Text))) +
                     ' matching note(s)';
      return Next;
    end;
  end if;

  if (Action = Actions.TitleChangedAction) and NotesHasSelection(Next) then
    begin
      mutable var NoteValue: Model.Note := Next.Notes[Next.Selected];
      Next.TitleCaret := Caret;
      if NoteValue.Title = Text then
        begin
          return Next;
        end;
      end if;

      NoteValue.Title := Text;
      Next := NotesWithNote(Next, Next.Selected, NoteValue);
      Next.Dirty := true;
      Next.Status := 'Unsaved changes';
      return Next;
    end;
  end if;

  if (Action = Actions.TagsChangedAction) and NotesHasSelection(Next) then
    begin
      Next.TagsText := Text;
      Next.TagsCaret := Caret;
      mutable var NoteValue: Model.Note := Next.Notes[Next.Selected];
      var Tags: array of string := Model.NoteTagsFromText(Text);
      if SameTags(NoteValue.Tags, Tags) then
        begin
          return Next;
        end;
      end if;

      NoteValue.Tags := Tags;
      Next := NotesWithNote(Next, Next.Selected, NoteValue);
      Next.Dirty := true;
      Next.Status := 'Unsaved changes';
      return Next;
    end;
  end if;

  return Next;
end function;

// Applies body text, caret and viewport changes independently.
public function NotesEditBody(
  State: Model.NotesModel;
  Action: integer;
  Text: string;
  Caret: integer;
  Offset: Tui.TuiPoint
): Model.NotesModel;
begin
  mutable var Next: Model.NotesModel := State;
  if (Action = Actions.BodyChangedAction) and NotesHasSelection(Next) then
    begin
      mutable var NoteValue: Model.Note := Next.Notes[Next.Selected];
      Next.BodyCaret := Caret;
      Next.BodyOffset := Offset;
      if NoteValue.Body = Text then
        begin
          return Next;
        end;
      end if;

      NoteValue.Body := Text;
      Next := NotesWithNote(Next, Next.Selected, NoteValue);
      Next.Dirty := true;
      Next.Status := 'Unsaved changes';
    end;
  end if;

  return Next;
end function;

end unit;
