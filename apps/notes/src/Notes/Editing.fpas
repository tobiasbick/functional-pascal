// Controlled text proposals and selection updates for Notes.
unit Notes.Editing;

uses Notes.Actions, Notes.Model, Std.Conv, Std.Tui;

// Reports whether the selection refers to an existing note.
public function NotesHasSelection(State: NotesModel): boolean;
begin
  return (State.Selected >= 0) and (State.Selected < State.Notes.Length());
end function;

// Replaces one note while preserving the remaining model state.
public function NotesWithNote(State: NotesModel; Index: integer; NoteValue: Note): NotesModel;
begin
  var Notes: array of Note := State.Notes;
  Notes[Index] := NoteValue;
  var Next: NotesModel := State;
  Next.Notes := Notes;
  return Next;
end function;

function SameTags(Left: array of string; Right: array of string): boolean;
begin
  if Left.Length() <> Right.Length() then
    begin
      return false;
    end;
  end if;

  for Index: integer := 0 to Left.Length() - 1 do
    begin
      if Left[Index] <> Right[Index] then
        begin
          return false;
        end;
      end if;
    end;
  end for;

  return true;
end function;

// Applies a single-line proposal, preserving clean state for caret-only changes.
public function NotesEditText(State: NotesModel; Action: integer; Text: string; Caret: integer): NotesModel;
begin
  var Next: NotesModel := State;
  if Action = SearchChangedAction then
    begin
      Next.Search := Text;
      Next.SearchCaret := Caret;
      Next.Status := IntToStr(NotesFilteredIndices(Next.Notes, Text).Length()) + ' matching note(s)';
      return Next;
    end;
  end if;

  if (Action = TitleChangedAction) and NotesHasSelection(Next) then
    begin
      var NoteValue: Note := Next.Notes[Next.Selected];
      Next.TitleCaret := Caret;
      if NoteValue.Title = Text then
        begin
          return Next;
        end;
      end if;

      NoteValue.Title := Text;
      Next := NotesWithNote(Next, Next.Selected, NoteValue);
      Next.Dirty := true;
      Next.Status := 'Unsaved changes';
      return Next;
    end;
  end if;

  if (Action = TagsChangedAction) and NotesHasSelection(Next) then
    begin
      Next.TagsText := Text;
      Next.TagsCaret := Caret;
      var NoteValue: Note := Next.Notes[Next.Selected];
      const Tags: array of string := NoteTagsFromText(Text);
      if SameTags(NoteValue.Tags, Tags) then
        begin
          return Next;
        end;
      end if;

      NoteValue.Tags := Tags;
      Next := NotesWithNote(Next, Next.Selected, NoteValue);
      Next.Dirty := true;
      Next.Status := 'Unsaved changes';
      return Next;
    end;
  end if;

  return Next;
end function;

// Applies body text, caret and viewport changes independently.
public function NotesEditBody(
  State: NotesModel;
  Action: integer;
  Text: string;
  Caret: integer;
  Offset: TuiPoint
): NotesModel;
begin
  var Next: NotesModel := State;
  if (Action = BodyChangedAction) and NotesHasSelection(Next) then
    begin
      var NoteValue: Note := Next.Notes[Next.Selected];
      Next.BodyCaret := Caret;
      Next.BodyOffset := Offset;
      if NoteValue.Body = Text then
        begin
          return Next;
        end;
      end if;

      NoteValue.Body := Text;
      Next := NotesWithNote(Next, Next.Selected, NoteValue);
      Next.Dirty := true;
      Next.Status := 'Unsaved changes';
    end;
  end if;

  return Next;
end function;
end unit;
