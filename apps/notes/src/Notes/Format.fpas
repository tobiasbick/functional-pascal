unit Notes.Format;

uses Notes.Model as Model;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Dictionaries as Dictionaries;
uses Std.Options as Options;
uses Std.Results as Results;
uses Std.Str as Str;
uses Std.Toml as Toml;

const NoteFormatVersion: integer := 1;

function MissingField(Name: string): string;
begin
  return ('Missing required note field `' + Name) + '`';
end function;

function FieldString(Fields: dict of string to Toml.TomlValue; Name: string): result of string, string;
begin
  case Dictionaries.Get(Fields, Name) of
    when Some(Value):
      begin
        case Value of
          when Toml.TomlValue.String(Text):
            begin
              return Ok(Text);
            end;
          else
            begin
              return Error(('Note field `' + Name) + '` must be a string');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField(Name));
      end;
  end case;
end function;

function FieldInteger(Fields: dict of string to Toml.TomlValue; Name: string): result of integer, string;
begin
  case Dictionaries.Get(Fields, Name) of
    when Some(Value):
      begin
        case Value of
          when Toml.TomlValue.Integer(Number):
            begin
              return Ok(Number);
            end;
          else
            begin
              return Error(('Note field `' + Name) + '` must be an integer');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField(Name));
      end;
  end case;
end function;

function FieldBoolean(Fields: dict of string to Toml.TomlValue; Name: string): result of boolean, string;
begin
  case Dictionaries.Get(Fields, Name) of
    when Some(Value):
      begin
        case Value of
          when Toml.TomlValue.Boolean(Flag):
            begin
              return Ok(Flag);
            end;
          else
            begin
              return Error(('Note field `' + Name) + '` must be a boolean');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField(Name));
      end;
  end case;
end function;

function FieldTags(Fields: dict of string to Toml.TomlValue): result of array of string, string;
begin
  case Dictionaries.Get(Fields, 'tags') of
    when Some(Value):
      begin
        case Value of
          when Toml.TomlValue.ArrayValue(Items):
            begin
              mutable var Tags: array of string := [];
              for Index: integer := 0 to Arrays.Length(Items) - 1 do
                begin
                  case Items[Index] of
                    when Toml.TomlValue.String(Tag):
                      begin
                        Arrays.Push(Tags, Tag);
                      end;
                    else
                      begin
                        return Error('Every note tag must be a string');
                      end;
                  end case;
                end;
              end for;

              return Ok(Tags);
            end;
          else
            begin
              return Error('Note field `tags` must be an array');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField('tags'));
      end;
  end case;
end function;

function ParseFields(Fields: dict of string to Toml.TomlValue; Body: string): result of Model.Note, string;
begin
  var Version: integer := try FieldInteger(Fields, 'format');
  if Version <> NoteFormatVersion then
    begin
      return Error(('Unsupported note format version ' + Conv.IntToStr(Version)) + '; expected 1');
    end;
  end if;
  var Id: string := try FieldString(Fields, 'id');
  if Str.Trim(Id) = '' then
    begin
      return Error('Note field `id` must not be empty');
    end;
  end if;
  var Title: string := try FieldString(Fields, 'title');
  var Created: integer := try FieldInteger(Fields, 'created_ms');
  var Updated: integer := try FieldInteger(Fields, 'updated_ms');
  if (Created < 0) or (Updated < 0) then
    begin
      return Error('Note timestamps must not be negative');
    end;
  end if;

  return Ok(record
    Id := Id;
    Title := Title;
    CreatedMillis := Created;
    UpdatedMillis := Updated;
    Tags := try FieldTags(Fields);
    Pinned := try FieldBoolean(Fields, 'pinned');
    Archived := try FieldBoolean(Fields, 'archived');
    Body := Body;
    Path := '';
  end record);
end function;

// Parses one UTF-8 `.note` document with TOML frontmatter.
public function NoteParse(Text: string): result of Model.Note, string;
begin
  var NewLine: string := Str.Chr(10);
  var Source: string := Str.Replace(Str.Replace(Text, Str.Chr(13) + NewLine, NewLine), Str.Chr(13), NewLine);
  var Prefix: string := '+++' + NewLine;
  if not Str.StartsWith(Source, Prefix) then
    begin
      return Error('A .note file must start with a `+++` TOML header');
    end;
  end if;
  var Remaining: string := Str.Substring(Source, Str.Length(Prefix), Str.Length(Source) -
                                                                     Str.Length(Prefix));
  var Boundary: string := (NewLine + '+++') + NewLine;
  var BoundaryIndex: integer := Str.IndexOf(Remaining, Boundary);
  if BoundaryIndex < 0 then
    begin
      return Error('A .note file must close its TOML header with `+++`');
    end;
  end if;
  var Header: string := Str.Substring(Remaining, 0, BoundaryIndex);
  var BodyStart: integer := BoundaryIndex + Str.Length(Boundary);
  var Body: string := Str.Substring(Remaining, BodyStart, Str.Length(Remaining) - BodyStart);
  case Toml.Parse(Header) of
    when Ok(Value):
      begin
        case Value of
          when Toml.TomlValue.Table(Fields):
            begin
              return ParseFields(Fields, Body);
            end;
          else
            begin
              return Error('The .note metadata root must be a TOML table');
            end;
        end case;
      end;
    when Error(Message):
      begin
        return Error('Invalid .note TOML header: ' + Message);
      end;
  end case;
end function;

// Encodes one note as deterministic TOML frontmatter and Markdown body text.
public function NoteStringify(NoteValue: Model.Note): string;
begin
  mutable var TagValues: array of Toml.TomlValue := [];
  for Index: integer := 0 to Arrays.Length(NoteValue.Tags) - 1 do
    begin
      Arrays.Push(TagValues, Toml.TomlValue.String(NoteValue.Tags[Index]));
    end;
  end for;
  var Header: Toml.TomlValue := Toml.TomlValue.Table(['format': Toml.TomlValue.Integer(NoteFormatVersion), 'id': Toml.TomlValue.String(NoteValue.Id), 'title': Toml.TomlValue.String(NoteValue.Title), 'created_ms': Toml.TomlValue.Integer(NoteValue.CreatedMillis), 'updated_ms': Toml.TomlValue.Integer(NoteValue.UpdatedMillis), 'tags': Toml.TomlValue.ArrayValue(TagValues), 'pinned': Toml.TomlValue.Boolean(NoteValue.Pinned), 'archived': Toml.TomlValue.Boolean(NoteValue.Archived)]);
  var NewLine: string := Str.Chr(10);
  return ((((('+++' + NewLine) + Str.TrimRight(Toml.Stringify(Header))) + NewLine) + '+++') + NewLine) +
         NoteValue.Body;
end function;

end unit;
