unit Notes.Format;

uses Notes.Model as Model, Std.Text.Format as Conv, Std.Encoding.Toml as Toml;

const NoteFormatVersion: integer := 1;

function MissingField(Name: string): string;
begin
  return 'Missing required note field `' + Name + '`';
end function;

function FieldString(Fields: dict of string to Toml.TomlValue; Name: string): result of (string, string);
begin
  case Fields.Get(Name) of
    when Some(const Value):
      begin
        case Value of
          when Toml.TomlValue.String(const Text):
            begin
              return Ok(Text);
            end;
          when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
            begin
              return Error('Note field `' + Name + '` must be a string');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField(Name));
      end;
  end case;
end function;

function FieldInteger(Fields: dict of string to Toml.TomlValue; Name: string): result of (integer, string);
begin
  case Fields.Get(Name) of
    when Some(const Value):
      begin
        case Value of
          when Toml.TomlValue.Integer(const Number):
            begin
              return Ok(Number);
            end;
          when Toml.TomlValue.String(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
            begin
              return Error('Note field `' + Name + '` must be an integer');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField(Name));
      end;
  end case;
end function;

function FieldBoolean(Fields: dict of string to Toml.TomlValue; Name: string): result of (boolean, string);
begin
  case Fields.Get(Name) of
    when Some(const Value):
      begin
        case Value of
          when Toml.TomlValue.Boolean(const Flag):
            begin
              return Ok(Flag);
            end;
          when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
            begin
              return Error('Note field `' + Name + '` must be a boolean');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField(Name));
      end;
  end case;
end function;

function FieldTags(Fields: dict of string to Toml.TomlValue): result of (array of string, string);
begin
  case Fields.Get('tags') of
    when Some(const Value):
      begin
        case Value of
          when Toml.TomlValue.ArrayValue(const Items):
            begin
              var Tags: array of string := [];
              for Index: integer := 0 to Items.Length() - 1 do
                begin
                  case Items[Index] of
                    when Toml.TomlValue.String(const Tag):
                      begin
                        Tags.PushInPlace(Tag);
                      end;
                    when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                      begin
                        return Error('Every note tag must be a string');
                      end;
                  end case;
                end;
              end for;

              return Ok(Tags);
            end;
          when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.Table(_):
            begin
              return Error('Note field `tags` must be an array');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField('tags'));
      end;
  end case;
end function;

function ParseFields(Fields: dict of string to Toml.TomlValue; Body: string): result of (Model.Note, string);
begin
  const Version: integer := try FieldInteger(Fields, 'format');
  if Version <> NoteFormatVersion then
    begin
      return Error('Unsupported note format version ' + Conv.IntToStr(Version) + '; expected 1');
    end;
  end if;
  const Id: string := try FieldString(Fields, 'id');
  if Id.Trim() = '' then
    begin
      return Error('Note field `id` must not be empty');
    end;
  end if;
  const Title: string := try FieldString(Fields, 'title');
  const Created: integer := try FieldInteger(Fields, 'created_ms');
  const Updated: integer := try FieldInteger(Fields, 'updated_ms');
  if (Created < 0) or (Updated < 0) then
    begin
      return Error('Note timestamps must not be negative');
    end;
  end if;

  return Ok(
    Model.Note(
      Id := Id,
      Title := Title,
      CreatedMillis := Created,
      UpdatedMillis := Updated,
      Tags := try FieldTags(Fields),
      Pinned := try FieldBoolean(Fields, 'pinned'),
      Archived := try FieldBoolean(Fields, 'archived'),
      Body := Body,
      Path := ''
    )
  );
end function;

// Parses one UTF-8 `.note` document with TOML frontmatter.
public function NoteParse(Text: string): result of (Model.Note, string);
begin
  const NewLine: string := string.Chr(10);
  const Source: string := Text.Replace(
    string.Chr(13) + NewLine,
    NewLine
  ).Replace(string.Chr(13), NewLine);
  const Prefix: string := '+++' + NewLine;
  if not Source.StartsWith(Prefix) then
    begin
      return Error('A .note file must start with a `+++` TOML header');
    end;
  end if;
  const Remaining: string := Source.Slice(Prefix.Length(), Source.Length() - Prefix.Length());
  const Boundary: string := NewLine + '+++' + NewLine;
  const HeaderBoundary := Remaining.IndexOf(Boundary);
  case HeaderBoundary of
    when None:
      return Error('A .note file must close its TOML header with `+++`');
    when Some(const BoundaryIndex):
      const Header: string := Remaining.Slice(0, BoundaryIndex);
      const BodyStart: integer := BoundaryIndex + Boundary.Length();
      const Body: string := Remaining.Slice(BodyStart, Remaining.Length() - BodyStart);
      case Toml.Parse(Header) of
        when Ok(const Value):
          begin
            case Value of
              when Toml.TomlValue.Table(const Fields):
                begin
                  return ParseFields(Fields, Body);
                end;
              when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
                begin
                  return Error('The .note metadata root must be a TOML table');
                end;
            end case;
          end;
        when Error(const Message):
          begin
            return Error('Invalid .note TOML header: ' + Message.Message());
          end;
      end case;
  end case;
end function;

// Encodes one note as deterministic TOML frontmatter and Markdown body text.
public function NoteStringify(NoteValue: Model.Note): string;
begin
  var TagValues: array of Toml.TomlValue := [];
  for Index: integer := 0 to NoteValue.Tags.Length() - 1 do
    begin
      TagValues.PushInPlace(Toml.TomlValue.String(NoteValue.Tags[Index]));
    end;
  end for;
  const Header: Toml.TomlValue := Toml.TomlValue.Table([
    'format': Toml.TomlValue.Integer(NoteFormatVersion),
    'id': Toml.TomlValue.String(NoteValue.Id),
    'title': Toml.TomlValue.String(NoteValue.Title),
    'created_ms': Toml.TomlValue.Integer(NoteValue.CreatedMillis),
    'updated_ms': Toml.TomlValue.Integer(NoteValue.UpdatedMillis),
    'tags': Toml.TomlValue.ArrayValue(TagValues),
    'pinned': Toml.TomlValue.Boolean(NoteValue.Pinned),
    'archived': Toml.TomlValue.Boolean(NoteValue.Archived)
  ]);
  const NewLine: string := string.Chr(10);
  return '+++' + NewLine + Toml.Stringify(Header).TrimRight() + NewLine + '+++' + NewLine +
    NoteValue.Body;
end function;
end unit;
