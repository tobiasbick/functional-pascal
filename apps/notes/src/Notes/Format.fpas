unit Notes.Format;

uses Notes.Model, Std.Conv, Std.Toml;

const NoteFormatVersion: integer := 1;

function MissingField(Name: string): string;
begin
  return ('Missing required note field `' + Name) + '`';
end function;

function FieldString(Fields: dict of string to TomlValue; Name: string): result of string, string;
begin
  case Fields.Get(Name) of
    when Some(Value):
      begin
        case Value of
          when TomlValue.String(Text):
            begin
              return Ok(Text);
            end;
          else
            begin
              return Error(('Note field `' + Name) + '` must be a string');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField(Name));
      end;
  end case;
end function;

function FieldInteger(Fields: dict of string to TomlValue; Name: string): result of integer, string;
begin
  case Fields.Get(Name) of
    when Some(Value):
      begin
        case Value of
          when TomlValue.Integer(Number):
            begin
              return Ok(Number);
            end;
          else
            begin
              return Error(('Note field `' + Name) + '` must be an integer');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField(Name));
      end;
  end case;
end function;

function FieldBoolean(Fields: dict of string to TomlValue; Name: string): result of boolean, string;
begin
  case Fields.Get(Name) of
    when Some(Value):
      begin
        case Value of
          when TomlValue.Boolean(Flag):
            begin
              return Ok(Flag);
            end;
          else
            begin
              return Error(('Note field `' + Name) + '` must be a boolean');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField(Name));
      end;
  end case;
end function;

function FieldTags(Fields: dict of string to TomlValue): result of array of string, string;
begin
  case Fields.Get('tags') of
    when Some(Value):
      begin
        case Value of
          when TomlValue.ArrayValue(Items):
            begin
              var Tags: array of string := [];
              for Index: integer := 0 to Items.Length() - 1 do
                begin
                  case Items[Index] of
                    when TomlValue.String(Tag):
                      begin
                        Tags.Push(Tag);
                      end;
                    else
                      begin
                        return Error('Every note tag must be a string');
                      end;
                  end case;
                end;
              end for;

              return Ok(Tags);
            end;
          else
            begin
              return Error('Note field `tags` must be an array');
            end;
        end case;
      end;
    when None:
      begin
        return Error(MissingField('tags'));
      end;
  end case;
end function;

function ParseFields(Fields: dict of string to TomlValue; Body: string): result of Note, string;
begin
  const Version: integer := try FieldInteger(Fields, 'format');
  if Version <> NoteFormatVersion then
    begin
      return Error(('Unsupported note format version ' + IntToStr(Version)) + '; expected 1');
    end;
  end if;
  const Id: string := try FieldString(Fields, 'id');
  if Id.Trim() = '' then
    begin
      return Error('Note field `id` must not be empty');
    end;
  end if;
  const Title: string := try FieldString(Fields, 'title');
  const Created: integer := try FieldInteger(Fields, 'created_ms');
  const Updated: integer := try FieldInteger(Fields, 'updated_ms');
  if (Created < 0) or (Updated < 0) then
    begin
      return Error('Note timestamps must not be negative');
    end;
  end if;

  return Ok(record
    Id := Id;
    Title := Title;
    CreatedMillis := Created;
    UpdatedMillis := Updated;
    Tags := try FieldTags(Fields);
    Pinned := try FieldBoolean(Fields, 'pinned');
    Archived := try FieldBoolean(Fields, 'archived');
    Body := Body;
    Path := '';
  end);
end function;

// Parses one UTF-8 `.note` document with TOML frontmatter.
public function NoteParse(Text: string): result of Note, string;
begin
  const NewLine: string := string.Chr(10);
  const Source: string := Text.Replace(string.Chr(13) + NewLine, NewLine)
                            .Replace(string.Chr(13), NewLine);
  const Prefix: string := '+++' + NewLine;
  if not Source.StartsWith(Prefix) then
    begin
      return Error('A .note file must start with a `+++` TOML header');
    end;
  end if;
  const Remaining: string := Source.Slice(Prefix.Length(), Source.Length() - Prefix.Length());
  const Boundary: string := (NewLine + '+++') + NewLine;
  const BoundaryIndex: integer := Remaining.IndexOf(Boundary);
  if BoundaryIndex < 0 then
    begin
      return Error('A .note file must close its TOML header with `+++`');
    end;
  end if;
  const Header: string := Remaining.Slice(0, BoundaryIndex);
  const BodyStart: integer := BoundaryIndex + Boundary.Length();
  const Body: string := Remaining.Slice(BodyStart, Remaining.Length() - BodyStart);
  case Std.Toml.Parse(Header) of
    when Ok(Value):
      begin
        case Value of
          when TomlValue.Table(Fields):
            begin
              return ParseFields(Fields, Body);
            end;
          else
            begin
              return Error('The .note metadata root must be a TOML table');
            end;
        end case;
      end;
    when Error(Message):
      begin
        return Error('Invalid .note TOML header: ' + Message);
      end;
  end case;
end function;

// Encodes one note as deterministic TOML frontmatter and Markdown body text.
public function NoteStringify(NoteValue: Note): string;
begin
  var TagValues: array of TomlValue := [];
  for Index: integer := 0 to NoteValue.Tags.Length() - 1 do
    begin
      TagValues.Push(TomlValue.String(NoteValue.Tags[Index]));
    end;
  end for;
  const Header: TomlValue := TomlValue.Table(['format': TomlValue.Integer(NoteFormatVersion), 'id': TomlValue.String(NoteValue.Id), 'title': TomlValue.String(NoteValue.Title), 'created_ms': TomlValue.Integer(NoteValue.CreatedMillis), 'updated_ms': TomlValue.Integer(NoteValue.UpdatedMillis), 'tags': TomlValue.ArrayValue(TagValues), 'pinned': TomlValue.Boolean(NoteValue.Pinned), 'archived': TomlValue.Boolean(NoteValue.Archived)]);
  const NewLine: string := string.Chr(10);
  return ((((('+++' + NewLine) + Std.Toml.Stringify(Header).TrimRight()) + NewLine) + '+++') + NewLine) +
         NoteValue.Body;
end function;
end unit;
