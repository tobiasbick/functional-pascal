unit Notes.Model;

uses Notes.Actions as Actions;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;
uses Std.Tui as Tui;
uses Std.Tui.Geometry as Geometry;

// One persisted `.note` document and its source path.
public type Note = record
  public Id: string;
  public Title: string;
  public CreatedMillis: integer;
  public UpdatedMillis: integer;
  public Tags: array of (string);
  public Pinned: boolean;
  public Archived: boolean;
  public Body: string;
  public Path: string;
end record;

// One note file that could not be read or parsed.
public type NoteIssue = record
  public Path: string;
  public Message: string;
end record;

// Complete result of loading one notes directory.
public type NotesLoad = record
  public Notes: array of (Note);
  public Issues: array of (NoteIssue);
end record;

// Visible pane in a narrow terminal.
public type NotesPane = enum
  List;
  Editor;
end enum;

// Active modal layer, if any.
public type NotesOverlay = enum
  Closed;
  Commands;
  Help;
  QuitConfirmation;
  SaveFailure;
end enum;

// Complete immutable application state supplied to the MVU view.
public type NotesModel = record
  public Directory: string;
  public Notes: array of (Note);
  public Issues: array of (NoteIssue);
  public Selected: integer;
  public Search: string;
  public SearchCaret: integer;
  public TitleCaret: integer;
  public TagsText: string;
  public TagsCaret: integer;
  public BodyCaret: integer;
  public BodyOffset: Tui.TuiPoint;
  public Focus: integer;
  public Pane: NotesPane;
  public Overlay: NotesOverlay;
  public Dirty: boolean;
  public Status: string;
  public ErrorMessage: string;
  public Width: integer;
  public Height: integer;
end record;

// Creates a new unsaved note with stable identity and timestamps.
public function NoteCreate(Id: string; TimestampMillis: integer): Note;
begin
  return Note(Id := Id, Title := 'Untitled note', CreatedMillis := TimestampMillis, UpdatedMillis := TimestampMillis, Tags := [], Pinned := false, Archived := false, Body := '', Path := '');
end function;

// Creates initial application state from a directory load result.
public function NotesModelCreate(Directory: string; Loaded: NotesLoad): NotesModel;
begin
  var Selected: integer := -1;
  var Focus: integer := 1;
  var Pane: NotesPane := NotesPane.List;
  var Status: string := 'Ready';
  var TitleCaret: integer := 0;
  var TagsText: string := '';
  var TagsCaret: integer := 0;
  if Arrays.Length(Loaded.Notes) > 0 then
    begin
      Selected := 0;
      Focus := Actions.TitleControl;
      Pane := NotesPane.Editor;
      TitleCaret := Str.Length(Loaded.Notes[0].Title);
      TagsText := Str.Join(Loaded.Notes[0].Tags, ', ');
      TagsCaret := Str.Length(TagsText);
    end;
  end if;

  if Arrays.Length(Loaded.Issues) > 0 then
    begin
      Status := Conv.IntToStr(Arrays.Length(Loaded.Issues)) + ' invalid note file(s)';
    end;
  end if;

  return NotesModel(Directory := Directory, Notes := Loaded.Notes, Issues := Loaded.Issues, Selected := Selected, Search := '', SearchCaret := 0, TitleCaret := TitleCaret, TagsText := TagsText, TagsCaret := TagsCaret, BodyCaret := 0, BodyOffset := Geometry.TuiPointCreate(0, 0), Focus := Focus, Pane := Pane, Overlay := NotesOverlay.Closed, Dirty := false, Status := Status, ErrorMessage := '', Width := 100, Height := 30);
end function;

// Formats a note's tags for the controlled metadata input.
public function NoteTagsText(NoteValue: Note): string;
begin
  return Str.Join(NoteValue.Tags, ', ');
end function;

// Parses, trims, and deduplicates comma-separated tags.
public function NoteTagsFromText(Text: string): array of (string);
begin
  var Tags: array of (string) := [];
  const Parts: array of (string) := Str.Split(Text, ',');
  for Index: integer := 0 to Arrays.Length(Parts) - 1 do
    begin
      const Tag: string := Str.Trim(Parts[Index]);
      if (Tag <> '') and (not Arrays.Contains(Tags, Tag)) then
        begin
          Arrays.Push(var Tags, Tag);
        end;
      end if;
    end;
  end for;

  return Tags;
end function;

// Reports whether an active note matches a case-insensitive query.
public function NoteMatches(NoteValue: Note; Search: string): boolean;
begin
  const Query: string := Str.ToLower(Str.Trim(Search));
  if Query = '' then
    begin
      return not NoteValue.Archived;
    end;
  end if;

  if NoteValue.Archived then
    begin
      return false;
    end;
  end if;

  return (Str.Contains(Str.ToLower(NoteValue.Title), Query) or Str.Contains(Str.ToLower(NoteValue.Body), Query)) or
         Str.Contains(Str.ToLower(NoteTagsText(NoteValue)), Query);
end function;

// Returns source-array indices for all visible filtered notes.
public function NotesFilteredIndices(Notes: array of (Note); Search: string): array of (integer);
begin
  var Indices: array of (integer) := [];
  for Index: integer := 0 to Arrays.Length(Notes) - 1 do
    begin
      if NoteMatches(Notes[Index], Search) then
        begin
          Arrays.Push(var Indices, Index);
        end;
      end if;
    end;
  end for;

  return Indices;
end function;

function ClipListText(Text: string; MaximumWidth: integer): string;
begin
  if MaximumWidth <= 0 then
    begin
      return '';
    end;
  end if;

  if Console.DisplayWidth(Text) <= MaximumWidth then
    begin
      return Text;
    end;
  end if;

  if MaximumWidth = 1 then
    begin
      return '…';
    end;
  end if;
  var Clipped: string := '';
  var Width: integer := 0;
  const ContentWidth: integer := MaximumWidth - 1;
  for Grapheme: string in Console.SplitGraphemes(Text) do
    begin
      const GraphemeWidth: integer := Console.DisplayWidth(Grapheme);
      if Width + GraphemeWidth > ContentWidth then
        begin
          return Clipped + '…';
        end;
      end if;

      Clipped := Clipped + Grapheme;
      Width := Width + GraphemeWidth;
    end;
  end for;

  return Clipped;
end function;

// Builds width-bounded list labels for all visible filtered notes.
public function NotesListItems(Notes: array of (Note); Search: string; MaximumWidth: integer): array of (string);
begin
  var Items: array of (string) := [];
  const Indices: array of (integer) := NotesFilteredIndices(Notes, Search);
  for Index: integer := 0 to Arrays.Length(Indices) - 1 do
    begin
      const NoteValue: Note := Notes[Indices[Index]];
      var Prefix: string := '  ';
      if NoteValue.Pinned then
        begin
          Prefix := '★ ';
        end;
      end if;
      var Tags: string := NoteTagsText(NoteValue);
      if Tags <> '' then
        begin
          Tags := '  ·  ' + Tags;
        end;
      end if;

      Arrays.Push(var Items, ClipListText((Prefix + NoteValue.Title) + Tags, MaximumWidth));
    end;
  end for;

  return Items;
end function;

end unit;
