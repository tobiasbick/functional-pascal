// Stable ordering of persisted notes.
unit Notes.Ordering;

uses Notes.Model as Model;

function Before(Left: Model.Note; Right: Model.Note): boolean;
begin
  if Left.Pinned <> Right.Pinned then
    begin
      return Left.Pinned;
    end;
  end if;

  return Left.UpdatedMillis > Right.UpdatedMillis;
end function;

// Merge-sorts notes without rebuilding the output for every inserted item.
public function NotesOrdered(Notes: array of Model.Note): array of Model.Note;
begin
  const Count: integer := Notes.Length();
  if Count < 2 then
    begin
      return Notes;
    end;
  end if;
  const Middle: integer := Count div 2;
  const Left: array of Model.Note := NotesOrdered(Notes.Slice(0, Middle));
  const Right: array of Model.Note := NotesOrdered(Notes.Slice(Middle, Count - Middle));
  var Output: array of Model.Note := [];
  var L: integer := 0;
  var R: integer := 0;
  while (L < Left.Length()) and (R < Right.Length()) do
    begin
      if Before(Right[R], Left[L]) then
        begin
          Output.PushInPlace(Right[R]);
          R := R + 1;
        end;
      else
        begin
          Output.PushInPlace(Left[L]);
          L := L + 1;
        end;
      end if;
    end;
  end while;

  while L < Left.Length() do
    begin
      Output.PushInPlace(Left[L]);
      L := L + 1;
    end;
  end while;

  while R < Right.Length() do
    begin
      Output.PushInPlace(Right[R]);
      R := R + 1;
    end;
  end while;

  return Output;
end function;
end unit;
