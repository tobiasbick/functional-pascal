unit Notes.Repository;

uses Notes.Ordering, Notes.Format, Notes.Model, Std.Conv, Std.Fs, Std.Path, Std.Random, Std.Time;

// Creates the notes directory or validates that it already exists.
public function NotesEnsureDirectory(Directory: string): result of (boolean, string);
begin
  if Std.Fs.Exists(Directory) then
    begin
      if Std.Fs.IsDir(Directory) then
        begin
          return Ok(true);
        end;
      end if;

      return Error('Notes path exists but is not a directory: ' + Directory);
    end;
  end if;

  return Std.Fs.CreateDir(Directory);
end function;

// Resolves a note's existing or identity-derived `.note` path.
public function NoteFilePath(Directory: string; NoteValue: Note): string;
begin
  if NoteValue.Path <> '' then
    begin
      return NoteValue.Path;
    end;
  end if;

  return Std.Path.Join([Directory, NoteValue.Id + '.note']);
end function;

// Sorts pinned notes first, then by descending timestamp; ties keep input order.
public function NotesSort(Notes: array of Note): array of Note;
begin
  return Notes.Ordering.NotesOrdered(Notes);
end function;

function AppendEscapedPattern(Acc: string; Character: string): string;
begin
  if (((Character = '[') or (Character = ']')) or (Character = '*')) or (Character = '?') then
    begin
      return Acc + '[' + Character + ']';
    end;
  end if;

  return Acc + Character;
end function;

// Escapes only the literal directory; the final note-file pattern stays active.
function NoteDirectoryPattern(Directory: string): string;
begin
  return Std.Path.Join([Directory.Reduce('', AppendEscapedPattern), '*.note']);
end function;

// Loads valid notes and preserves invalid files as visible issues.
public function NotesLoadDirectory(Directory: string): result of (NotesLoad, string);
begin
  const DirectoryReady: boolean := try NotesEnsureDirectory(Directory);
  const Paths: array of string := try Std.Fs.Glob(NoteDirectoryPattern(Directory));
  var Notes: array of Note := [];
  var IdCounts: dict of string to integer := [:];
  var Issues: array of NoteIssue := [];
  for Index: integer := 0 to Paths.Length() - 1 do
    begin
      const Path: string := Paths[Index];
      case Std.Fs.ReadText(Path) of
        when Ok(const Text):
          begin
            case NoteParse(Text) of
              when Ok(const NoteValue):
                begin
                  var Loaded: Note := NoteValue;
                  Loaded.Path := Path;
                  Notes.Push(Loaded);
                  if IdCounts.ContainsKey(Loaded.Id) then
                    begin
                      IdCounts[Loaded.Id] := IdCounts[Loaded.Id] + 1;
                    end;
                  else
                    begin
                      IdCounts[Loaded.Id] := 1;
                    end;
                  end if;
                end;
              when Error(const Message):
                begin
                  Issues.Push(notes.model.noteissue(Path := Path, Message := Message));
                end;
            end case;
          end;
        when Error(const Message):
          begin
            Issues.Push(notes.model.noteissue(Path := Path, Message := Message));
          end;
      end case;
    end;
  end for;
  var Unique: array of Note := [];
  for Loaded: Note in Notes do
    begin
      if IdCounts[Loaded.Id] > 1 then
        begin
          Issues.Push(notes.model.noteissue(Path := Loaded.Path, Message := 'Duplicate note ID: ' + Loaded.Id +
                                                                            '. Give each file a unique ID before editing.'));
        end;
      else
        begin
          Unique.Push(Loaded);
        end;
      end if;
    end;
  end for;

  return Ok(NotesLoad(Notes := NotesSort(Unique), Issues := Issues));
end function;

// Atomically writes one note to its stable file path.
public function NotesSave(Directory: string; NoteValue: Note): result of (boolean, string);
begin
  const DirectoryReady: boolean := try NotesEnsureDirectory(Directory);
  return Std.Fs.WriteTextAtomic(NoteFilePath(Directory, NoteValue), NoteStringify(NoteValue));
end function;

// Generates an unused timestamp-and-random identity in one directory.
public function NotesCreateId(Directory: string; TimestampMillis: integer): string;
begin
  var Candidate: string := '';
  repeat
    Candidate := IntToStr(TimestampMillis) + '-' + IntToStr(Std.Random.RandomInt(100000, 999999));
  until not Std.Fs.Exists(Std.Path.Join([Directory, Candidate + '.note']));
  return Candidate;
end function;

// Creates an in-memory draft with a new identity and current timestamp.
public function NotesCreateDraft(Directory: string): Note;
begin
  const Now: integer := Std.Time.TimestampMillis();
  return NoteCreate(NotesCreateId(Directory, Now), Now);
end function;
end unit;
