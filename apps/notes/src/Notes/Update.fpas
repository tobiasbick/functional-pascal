unit Notes.Update;

uses Notes.Actions as Actions;
uses Notes.Model as Model;
uses Notes.Editing as Editing;
uses Notes.Repository as Repository;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Time as Time;
uses Std.Tui as Tui;

function NoteIndexById(Notes: array of (Model.Note); Id: string): integer;
begin
  for Index: integer := 0 to Arrays.Length(Notes) - 1 do
    begin
      if Notes[Index].Id = Id then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function ResortSelected(State: Model.NotesModel; SelectedId: string): Model.NotesModel;
begin
  mutable var Next: Model.NotesModel := State;
  Next.Notes := Repository.NotesSort(State.Notes);
  Next.Selected := NoteIndexById(Next.Notes, SelectedId);
  return Next;
end function;

function WithEditorFields(State: Model.NotesModel; Selected: integer): Model.NotesModel;
begin
  mutable var Next: Model.NotesModel := State;
  Next.Selected := Selected;
  Next.Pane := Model.NotesPane.Editor;
  Next.Focus := Actions.BodyControl;
  Next.Dirty := false;
  Next.BodyCaret := 0;
  Next.BodyOffset := Tui.TuiPoint.Create(0, 0);
  if (Selected >= 0) and (Selected < Arrays.Length(State.Notes)) then
    begin
      var NoteValue: Model.Note := State.Notes[Selected];
      Next.TitleCaret := Str.Length(NoteValue.Title);
      Next.TagsText := Model.NoteTagsText(NoteValue);
      Next.TagsCaret := Str.Length(Next.TagsText);
    end;
  else
    begin
      Next.TitleCaret := 0;
      Next.TagsText := '';
      Next.TagsCaret := 0;
    end;
  end if;

  return Next;
end function;

// Persists the selected dirty note and returns the resulting UI state.
public function NotesPersistCurrent(State: Model.NotesModel): Model.NotesModel;
begin
  if (not State.Dirty) or (not Editing.NotesHasSelection(State)) then
    begin
      return State;
    end;
  end if;
  mutable var Next: Model.NotesModel := State;
  mutable var NoteValue: Model.Note := Next.Notes[Next.Selected];
  NoteValue.UpdatedMillis := Time.TimestampMillis();
  NoteValue.Path := Repository.NoteFilePath(Next.Directory, NoteValue);
  case Repository.NotesSave(Next.Directory, NoteValue) of
    when Result.Ok(const Written):
      begin
        Next := Editing.NotesWithNote(Next, Next.Selected, NoteValue);
        Next := ResortSelected(Next, NoteValue.Id);
        Next.Dirty := false;
        Next.Status := 'Saved ' + NoteValue.Title;
        if Next.Overlay = Model.NotesOverlay.SaveFailure then
          begin
            Next.Overlay := Model.NotesOverlay.Closed;
            Next.ErrorMessage := '';
          end;
        end if;

        return Next;
      end;
    when Result.Error(const Message):
      begin
        Next.Overlay := Model.NotesOverlay.SaveFailure;
        Next.ErrorMessage := Message;
        Next.Status := 'Save failed';
        return Next;
      end;
  end case;
end function;

function SelectedFilteredPosition(State: Model.NotesModel): integer;
begin
  var Indices: array of (integer) := Model.NotesFilteredIndices(State.Notes, State.Search);
  for Index: integer := 0 to Arrays.Length(Indices) - 1 do
    begin
      if Indices[Index] = State.Selected then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function SelectFiltered(State: Model.NotesModel; Position: integer): Model.NotesModel;
begin
  var Indices: array of (integer) := Model.NotesFilteredIndices(State.Notes, State.Search);
  if (Position < 0) or (Position >= Arrays.Length(Indices)) then
    begin
      return State;
    end;
  end if;
  var TargetId: string := State.Notes[Indices[Position]].Id;
  var Saved: Model.NotesModel := NotesPersistCurrent(State);
  if Saved.Dirty or (Saved.Overlay = Model.NotesOverlay.SaveFailure) then
    begin
      return Saved;
    end;
  end if;
  mutable var Next: Model.NotesModel := WithEditorFields(Saved, NoteIndexById(Saved.Notes, TargetId));
  Next.Pane := Model.NotesPane.List;
  Next.Focus := Actions.ListControl;
  return Next;
end function;

function CreateNote(State: Model.NotesModel): Model.NotesModel;
begin
  var Saved: Model.NotesModel := NotesPersistCurrent(State);
  if Saved.Dirty or (Saved.Overlay = Model.NotesOverlay.SaveFailure) then
    begin
      return Saved;
    end;
  end if;
  mutable var Next: Model.NotesModel := Saved;
  mutable var Draft: Model.Note := Repository.NotesCreateDraft(Next.Directory);
  Draft.Path := Repository.NoteFilePath(Next.Directory, Draft);
  case Repository.NotesSave(Next.Directory, Draft) of
    when Result.Ok(const Written):
      begin
        mutable var Notes: array of (Model.Note) := Next.Notes;
        Arrays.Push(Notes, Draft);
        Next.Notes := Notes;
        Next := ResortSelected(Next, Draft.Id);
        Next := WithEditorFields(Next, Next.Selected);
        Next.TitleCaret := Str.Length(Draft.Title);
        Next.Focus := Actions.TitleControl;
        Next.Status := 'Created a new note';
        return Next;
      end;
    when Result.Error(const Message):
      begin
        Next.Overlay := Model.NotesOverlay.SaveFailure;
        Next.ErrorMessage := Message;
        Next.Status := 'Could not create note';
        return Next;
      end;
  end case;
end function;

function TogglePin(State: Model.NotesModel): Model.NotesModel;
begin
  if not Editing.NotesHasSelection(State) then
    begin
      return State;
    end;
  end if;
  mutable var Next: Model.NotesModel := State;
  mutable var NoteValue: Model.Note := Next.Notes[Next.Selected];
  NoteValue.Pinned := not NoteValue.Pinned;
  Next := Editing.NotesWithNote(Next, Next.Selected, NoteValue);
  Next.Dirty := true;
  Next.Status := 'Pin changed';
  return NotesPersistCurrent(Next);
end function;

function SelectFirstVisible(State: Model.NotesModel): Model.NotesModel;
begin
  var Indices: array of (integer) := Model.NotesFilteredIndices(State.Notes, State.Search);
  if Arrays.Length(Indices) = 0 then
    begin
      mutable var Empty: Model.NotesModel := State;
      Empty.Selected := -1;
      Empty.Pane := Model.NotesPane.List;
      Empty.Focus := Actions.ListControl;
      return Empty;
    end;
  end if;

  return WithEditorFields(State, Indices[0]);
end function;

function ArchiveNote(State: Model.NotesModel): Model.NotesModel;
begin
  if not Editing.NotesHasSelection(State) then
    begin
      return State;
    end;
  end if;
  mutable var Next: Model.NotesModel := State;
  mutable var NoteValue: Model.Note := Next.Notes[Next.Selected];
  NoteValue.Archived := true;
  Next := Editing.NotesWithNote(Next, Next.Selected, NoteValue);
  Next.Dirty := true;
  Next := NotesPersistCurrent(Next);
  if Next.Dirty or (Next.Overlay = Model.NotesOverlay.SaveFailure) then
    begin
      return Next;
    end;
  end if;

  Next.Status := 'Note archived';
  return SelectFirstVisible(Next);
end function;

function HandleAction(State: Model.NotesModel; Action: integer; Cmd: Tui.TuiCmdOutput): Model.NotesModel;
begin
  if Action = Actions.NewNoteAction then
    begin
      return CreateNote(State);
    end;
  end if;

  if Action = Actions.SaveNoteAction then
    begin
      return NotesPersistCurrent(State);
    end;
  end if;

  if Action = Actions.TogglePinAction then
    begin
      return TogglePin(State);
    end;
  end if;

  if Action = Actions.ArchiveNoteAction then
    begin
      return ArchiveNote(State);
    end;
  end if;

  if Action = Actions.CommandsAction then
    begin
      mutable var Next: Model.NotesModel := State;
      Next.Overlay := Model.NotesOverlay.Commands;
      return Next;
    end;
  end if;

  if Action = Actions.HelpAction then
    begin
      mutable var Next: Model.NotesModel := State;
      Next.Overlay := Model.NotesOverlay.Help;
      return Next;
    end;
  end if;

  if Action = Actions.CloseOverlayAction then
    begin
      mutable var Next: Model.NotesModel := State;
      Next.Overlay := Model.NotesOverlay.Closed;
      Next.ErrorMessage := '';
      return Next;
    end;
  end if;

  if Action = Actions.SaveAndQuitAction then
    begin
      var Saved: Model.NotesModel := NotesPersistCurrent(State);
      if not Saved.Dirty and (Saved.Overlay <> Model.NotesOverlay.SaveFailure) then
        begin
          Cmd.Set(Tui.TuiCmd.Quit);
        end;
      end if;

      return Saved;
    end;
  end if;

  if Action = Actions.DiscardAndQuitAction then
    begin
      Cmd.Set(Tui.TuiCmd.Quit);
      return State;
    end;
  end if;

  return State;
end function;

function RequestQuit(State: Model.NotesModel; Cmd: Tui.TuiCmdOutput): Model.NotesModel;
begin
  if State.Dirty then
    begin
      mutable var Next: Model.NotesModel := State;
      Next.Overlay := Model.NotesOverlay.QuitConfirmation;
      return Next;
    end;
  end if;

  Cmd.Set(Tui.TuiCmd.Quit);
  return State;
end function;

function HandleShortcut(State: Model.NotesModel; Key: Tui.TuiKeyEvent; Cmd: Tui.TuiCmdOutput): Model.NotesModel;
begin
  if Key.kind = Console.KeyKind.F1 then
    begin
      return HandleAction(State, Actions.HelpAction, Cmd);
    end;
  end if;

  if ((Key.kind = Console.KeyKind.Enter) and (State.Focus = Actions.ListControl)) and
     Editing.NotesHasSelection(State) then
    begin
      mutable var Next: Model.NotesModel := State;
      Next.Focus := Actions.BodyControl;
      Next.Pane := Model.NotesPane.Editor;
      return Next;
    end;
  end if;

  if (((Key.kind = Console.KeyKind.Character) and Key.alt) and (not Key.ctrl)) and (not Key.meta) then
    begin
      case Key.ch of
        when 'x', 'X':
          begin
            return RequestQuit(State, Cmd);
          end;
      end case;
    end;
  end if;

  if (Key.kind <> Console.KeyKind.Character) or (not Key.ctrl) then
    begin
      return State;
    end;
  end if;

  case Key.ch of
    when 'n', 'N':
      begin
        return HandleAction(State, Actions.NewNoteAction, Cmd);
      end;
    when 's', 'S':
      begin
        return HandleAction(State, Actions.SaveNoteAction, Cmd);
      end;
    when 'f', 'F':
      begin
        mutable var Next: Model.NotesModel := State;
        Next.Focus := Actions.SearchControl;
        Next.Pane := Model.NotesPane.List;
        return Next;
      end;
    when 'k', 'K':
      begin
        return HandleAction(State, Actions.CommandsAction, Cmd);
      end;
    when 'p', 'P':
      begin
        return HandleAction(State, Actions.TogglePinAction, Cmd);
      end;
    when '1':
      begin
        mutable var Next: Model.NotesModel := State;
        Next.Focus := Actions.SearchControl;
        Next.Pane := Model.NotesPane.List;
        return Next;
      end;
    when '2':
      begin
        mutable var Next: Model.NotesModel := State;
        Next.Focus := Actions.BodyControl;
        Next.Pane := Model.NotesPane.Editor;
        return Next;
      end;
  end case;

  return State;
end function;

// Applies one routed TUI message to the Notes application model.
public function NotesUpdate(State: Model.NotesModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Model.NotesModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Key(const Key):
      begin
        return HandleShortcut(State, Key, Cmd);
      end;
    when Tui.TuiMsg.Resize(const Size):
      begin
        mutable var Next: Model.NotesModel := State;
        Next.Width := Size.Width;
        Next.Height := Size.Height;
        return Next;
      end;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const CurrentId):
            begin
              mutable var Next: Model.NotesModel := State;
              Next.Focus := CurrentId.Value;
              return Next;
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        return Editing.NotesEditText(State, Action.Value, Text, Caret);
      end;
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset):
      begin
        return Editing.NotesEditBody(State, Action.Value, Text, Caret, Offset);
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        if Action.Value = Actions.SelectionChangedAction then
          begin
            return SelectFiltered(State, Selected);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return HandleAction(State, Action.Value, Cmd);
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        if State.Overlay <> Model.NotesOverlay.Closed then
          begin
            return HandleAction(State, Actions.CloseOverlayAction, Cmd);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return State;
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return State;
      end;
    when Tui.TuiMsg.CheckChanged(const CheckSource, const CheckAction, const Checked):
      begin
        return State;
      end;
    when Tui.TuiMsg.ScrollChanged(const ScrollSource, const ScrollAction, const ScrollOffset):
      begin
        return State;
      end;
    when Tui.TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        return State;
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _):
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

// Maps the source note selection to its position in the filtered list.
public function NotesSelectedFilteredPosition(State: Model.NotesModel): integer;
begin
  return SelectedFilteredPosition(State);
end function;

end unit;
