unit Notes.Update;

uses
  Notes.Actions, Notes.Model, Notes.Editing, Notes.Repository, Std.Arrays, Std.Console, Std.Conv,
  Std.Options, Std.Str, Std.Time, Std.Tui;

function NoteIndexById(Notes: array of Note; Id: string): integer;
begin
  for Index: integer := 0 to Std.Arrays.Length(Notes) - 1 do
    begin
      if Notes[Index].Id = Id then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function ResortSelected(State: NotesModel; SelectedId: string): NotesModel;
begin
  mutable var Next: NotesModel := State;
  Next.Notes := NotesSort(State.Notes);
  Next.Selected := NoteIndexById(Next.Notes, SelectedId);
  return Next;
end function;

function WithEditorFields(State: NotesModel; Selected: integer): NotesModel;
begin
  mutable var Next: NotesModel := State;
  Next.Selected := Selected;
  Next.Pane := NotesPane.Editor;
  Next.Focus := BodyControl;
  Next.Dirty := false;
  Next.BodyCaret := 0;
  Next.BodyOffset := TuiPoint.Create(0, 0);
  if (Selected >= 0) and (Selected < Std.Arrays.Length(State.Notes)) then
    begin
      var NoteValue: Note := State.Notes[Selected];
      Next.TitleCaret := Std.Str.Length(NoteValue.Title);
      Next.TagsText := NoteTagsText(NoteValue);
      Next.TagsCaret := Std.Str.Length(Next.TagsText);
    end;
  else
    begin
      Next.TitleCaret := 0;
      Next.TagsText := '';
      Next.TagsCaret := 0;
    end;
  end if;

  return Next;
end function;

// Persists the selected dirty note and returns the resulting UI state.
public function NotesPersistCurrent(State: NotesModel): NotesModel;
begin
  if (not State.Dirty) or (not NotesHasSelection(State)) then
    begin
      return State;
    end;
  end if;
  mutable var Next: NotesModel := State;
  mutable var NoteValue: Note := Next.Notes[Next.Selected];
  NoteValue.UpdatedMillis := Std.Time.TimestampMillis();
  NoteValue.Path := NoteFilePath(Next.Directory, NoteValue);
  case NotesSave(Next.Directory, NoteValue) of
    Ok(Written):
    begin
      Next := NotesWithNote(Next, Next.Selected, NoteValue);
      Next := ResortSelected(Next, NoteValue.Id);
      Next.Dirty := false;
      Next.Status := 'Saved ' + NoteValue.Title;
      if Next.Overlay = NotesOverlay.SaveFailure then
        begin
          Next.Overlay := NotesOverlay.Closed;
          Next.ErrorMessage := '';
        end;
      end if;

      return Next;
    end;
    Error(Message):
    begin
      Next.Overlay := NotesOverlay.SaveFailure;
      Next.ErrorMessage := Message;
      Next.Status := 'Save failed';
      return Next;
    end;
  end;
end function;

function SelectedFilteredPosition(State: NotesModel): integer;
begin
  var Indices: array of integer := NotesFilteredIndices(State.Notes, State.Search);
  for Index: integer := 0 to Std.Arrays.Length(Indices) - 1 do
    begin
      if Indices[Index] = State.Selected then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function SelectFiltered(State: NotesModel; Position: integer): NotesModel;
begin
  var Indices: array of integer := NotesFilteredIndices(State.Notes, State.Search);
  if (Position < 0) or (Position >= Std.Arrays.Length(Indices)) then
    begin
      return State;
    end;
  end if;
  var TargetId: string := State.Notes[Indices[Position]].Id;
  var Saved: NotesModel := NotesPersistCurrent(State);
  if Saved.Dirty or (Saved.Overlay = NotesOverlay.SaveFailure) then
    begin
      return Saved;
    end;
  end if;
  mutable var Next: NotesModel := WithEditorFields(Saved, NoteIndexById(Saved.Notes, TargetId));
  Next.Pane := NotesPane.List;
  Next.Focus := ListControl;
  return Next;
end function;

function CreateNote(State: NotesModel): NotesModel;
begin
  var Saved: NotesModel := NotesPersistCurrent(State);
  if Saved.Dirty or (Saved.Overlay = NotesOverlay.SaveFailure) then
    begin
      return Saved;
    end;
  end if;
  mutable var Next: NotesModel := Saved;
  mutable var Draft: Note := NotesCreateDraft(Next.Directory);
  Draft.Path := NoteFilePath(Next.Directory, Draft);
  case NotesSave(Next.Directory, Draft) of
    Ok(Written):
    begin
      mutable var Notes: array of Note := Next.Notes;
      Std.Arrays.Push(Notes, Draft);
      Next.Notes := Notes;
      Next := ResortSelected(Next, Draft.Id);
      Next := WithEditorFields(Next, Next.Selected);
      Next.TitleCaret := Std.Str.Length(Draft.Title);
      Next.Focus := TitleControl;
      Next.Status := 'Created a new note';
      return Next;
    end;
    Error(Message):
    begin
      Next.Overlay := NotesOverlay.SaveFailure;
      Next.ErrorMessage := Message;
      Next.Status := 'Could not create note';
      return Next;
    end;
  end;
end function;

function TogglePin(State: NotesModel): NotesModel;
begin
  if not NotesHasSelection(State) then
    begin
      return State;
    end;
  end if;
  mutable var Next: NotesModel := State;
  mutable var NoteValue: Note := Next.Notes[Next.Selected];
  NoteValue.Pinned := not NoteValue.Pinned;
  Next := NotesWithNote(Next, Next.Selected, NoteValue);
  Next.Dirty := true;
  Next.Status := 'Pin changed';
  return NotesPersistCurrent(Next);
end function;

function SelectFirstVisible(State: NotesModel): NotesModel;
begin
  var Indices: array of integer := NotesFilteredIndices(State.Notes, State.Search);
  if Std.Arrays.Length(Indices) = 0 then
    begin
      mutable var Empty: NotesModel := State;
      Empty.Selected := -1;
      Empty.Pane := NotesPane.List;
      Empty.Focus := ListControl;
      return Empty;
    end;
  end if;

  return WithEditorFields(State, Indices[0]);
end function;

function ArchiveNote(State: NotesModel): NotesModel;
begin
  if not NotesHasSelection(State) then
    begin
      return State;
    end;
  end if;
  mutable var Next: NotesModel := State;
  mutable var NoteValue: Note := Next.Notes[Next.Selected];
  NoteValue.Archived := true;
  Next := NotesWithNote(Next, Next.Selected, NoteValue);
  Next.Dirty := true;
  Next := NotesPersistCurrent(Next);
  if Next.Dirty or (Next.Overlay = NotesOverlay.SaveFailure) then
    begin
      return Next;
    end;
  end if;

  Next.Status := 'Note archived';
  return SelectFirstVisible(Next);
end function;

function HandleAction(State: NotesModel; Action: integer; Cmd: TuiCmdOutput): NotesModel;
begin
  if Action = NewNoteAction then
    begin
      return CreateNote(State);
    end;
  end if;

  if Action = SaveNoteAction then
    begin
      return NotesPersistCurrent(State);
    end;
  end if;

  if Action = TogglePinAction then
    begin
      return TogglePin(State);
    end;
  end if;

  if Action = ArchiveNoteAction then
    begin
      return ArchiveNote(State);
    end;
  end if;

  if Action = CommandsAction then
    begin
      mutable var Next: NotesModel := State;
      Next.Overlay := NotesOverlay.Commands;
      return Next;
    end;
  end if;

  if Action = HelpAction then
    begin
      mutable var Next: NotesModel := State;
      Next.Overlay := NotesOverlay.Help;
      return Next;
    end;
  end if;

  if Action = CloseOverlayAction then
    begin
      mutable var Next: NotesModel := State;
      Next.Overlay := NotesOverlay.Closed;
      Next.ErrorMessage := '';
      return Next;
    end;
  end if;

  if Action = SaveAndQuitAction then
    begin
      var Saved: NotesModel := NotesPersistCurrent(State);
      if not Saved.Dirty and (Saved.Overlay <> NotesOverlay.SaveFailure) then
        begin
          Cmd.Set(TuiCmd.Quit);
        end;
      end if;

      return Saved;
    end;
  end if;

  if Action = DiscardAndQuitAction then
    begin
      Cmd.Set(TuiCmd.Quit);
      return State;
    end;
  end if;

  return State;
end function;

function RequestQuit(State: NotesModel; Cmd: TuiCmdOutput): NotesModel;
begin
  if State.Dirty then
    begin
      mutable var Next: NotesModel := State;
      Next.Overlay := NotesOverlay.QuitConfirmation;
      return Next;
    end;
  end if;

  Cmd.Set(TuiCmd.Quit);
  return State;
end function;

function HandleShortcut(State: NotesModel; Key: TuiKeyEvent; Cmd: TuiCmdOutput): NotesModel;
begin
  if Key.kind = Std.Console.KeyKind.F1 then
    begin
      return HandleAction(State, HelpAction, Cmd);
    end;
  end if;

  if ((Key.kind = Std.Console.KeyKind.Enter) and (State.Focus = ListControl)) and
     NotesHasSelection(State) then
    begin
      mutable var Next: NotesModel := State;
      Next.Focus := BodyControl;
      Next.Pane := NotesPane.Editor;
      return Next;
    end;
  end if;

  if (((Key.kind = Std.Console.KeyKind.Character) and Key.alt) and (not Key.ctrl)) and
     (not Key.meta) then
    begin
      case Key.ch of
        'x', 'X':
        begin
          return RequestQuit(State, Cmd);
        end;
      end;
    end;
  end if;

  if (Key.kind <> Std.Console.KeyKind.Character) or (not Key.ctrl) then
    begin
      return State;
    end;
  end if;

  case Key.ch of
    'n', 'N':
    begin
      return HandleAction(State, NewNoteAction, Cmd);
    end;
    's', 'S':
    begin
      return HandleAction(State, SaveNoteAction, Cmd);
    end;
    'f', 'F':
    begin
      mutable var Next: NotesModel := State;
      Next.Focus := SearchControl;
      Next.Pane := NotesPane.List;
      return Next;
    end;
    'k', 'K':
    begin
      return HandleAction(State, CommandsAction, Cmd);
    end;
    'p', 'P':
    begin
      return HandleAction(State, TogglePinAction, Cmd);
    end;
    '1':
    begin
      mutable var Next: NotesModel := State;
      Next.Focus := SearchControl;
      Next.Pane := NotesPane.List;
      return Next;
    end;
    '2':
    begin
      mutable var Next: NotesModel := State;
      Next.Focus := BodyControl;
      Next.Pane := NotesPane.Editor;
      return Next;
    end;
  end;

  return State;
end function;

// Applies one routed TUI message to the Notes application model.
public function NotesUpdate(State: NotesModel; Msg: TuiMsg; Cmd: TuiCmdOutput): NotesModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.Key(Key):
    begin
      return HandleShortcut(State, Key, Cmd);
    end;
    TuiMsg.Resize(Size):
    begin
      mutable var Next: NotesModel := State;
      Next.Width := Size.Width;
      Next.Height := Size.Height;
      return Next;
    end;
    TuiMsg.FocusChanged(Previous, Current):
    begin
      case Current of
        Some(CurrentId):
        begin
          mutable var Next: NotesModel := State;
          Next.Focus := CurrentId.Value;
          return Next;
        end;
        None:
        begin
          return State;
        end;
      end;
    end;
    TuiMsg.TextChanged(Source, Action, Text, Caret):
    begin
      return NotesEditText(State, Action.Value, Text, Caret);
    end;
    TuiMsg.TextAreaChanged(Source, Action, Text, Caret, Offset):
    begin
      return NotesEditBody(State, Action.Value, Text, Caret, Offset);
    end;
    TuiMsg.SelectionChanged(Source, Action, Selected):
    begin
      if Action.Value = SelectionChangedAction then
        begin
          return SelectFiltered(State, Selected);
        end;
      end if;

      return State;
    end;
    TuiMsg.Action(Source, Action):
    begin
      return HandleAction(State, Action.Value, Cmd);
    end;
    TuiMsg.QuitRequested:
    begin
      if State.Overlay <> NotesOverlay.Closed then
        begin
          return HandleAction(State, CloseOverlayAction, Cmd);
        end;
      end if;

      return State;
    end;
    TuiMsg.Pointer(Pointer):
    begin
      return State;
    end;
    TuiMsg.Tick(Delta):
    begin
      return State;
    end;
    TuiMsg.CheckChanged(CheckSource, CheckAction, Checked):
    begin
      return State;
    end;
    TuiMsg.ScrollChanged(ScrollSource, ScrollAction, ScrollOffset):
    begin
      return State;
    end;
    TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
    begin
      return State;
    end;
    else
    begin
      return State;
    end;
  end;
end function;

// Maps the source note selection to its position in the filtered list.
public function NotesSelectedFilteredPosition(State: NotesModel): integer;
begin
  return SelectedFilteredPosition(State);
end function;
end unit;
