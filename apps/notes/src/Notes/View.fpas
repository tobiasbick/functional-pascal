unit Notes.View;

uses Notes.Actions, Notes.Model, Notes.Update, Std.Arrays, Std.Conv, Std.Options, Std.Str, Std.Tui;

function Expanding(Child: TuiElement; Stretch: integer): TuiElement;
begin
  return TuiElementBuilders.MakeLayout(TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Expanding(), TuiAlignment.Fill(), Stretch), Child)
end;

function SidebarWidth(State: NotesModel): integer;
begin
  var Width: integer := State.Width div 3;
  if Width < 32 then
  begin
    return 32
  end;

  if Width > 52 then
  begin
    return 52
  end;

  return Width
end;

function ListPaneWidth(State: NotesModel): integer;
begin
  if State.Width < 65 then
  begin
    return State.Width
  end;

  return SidebarWidth(State)
end;

function FixedWidthExpanding(Child: TuiElement; Width: integer): TuiElement;
begin
  return TuiElementBuilders.MakeLayout(TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Create(TuiSizePolicyKind.Preferred, TuiSizePolicyKind.Expanding), TuiAlignment.Fill(), 0)
                                         .WithFixedWidth(Width), Child)
end;

function Header(State: NotesModel): TuiElement;
begin
  mutable var Dirty: string := '';
  mutable var Issues: string := '';
  if State.Dirty then
  begin
    Dirty := '  ● unsaved'
  end;

  if Std.Arrays.Length(State.Issues) > 0 then
  begin
    Issues := ('  ·  ' + IntToStr(Std.Arrays.Length(State.Issues))) + ' invalid'
  end;

  return TuiElementBuilders.MakeRule(((((' NOTES  ·  ' + IntToStr(Std.Arrays.Length(NotesFilteredIndices(State.Notes, '')))) + ' active') + Issues) + Dirty) +
                                     '  ·  Ctrl+K commands ')
end;

function ListPane(State: NotesModel): TuiElement;
begin
  var Search: TuiElement := TuiElementBuilders.MakeInputWithHint(TuiControlId.Create(SearchControl), State.Search, State.SearchCaret, 'Search notes…', TuiAction.Create(SearchChangedAction));
  var Items: array of string := NotesListItems(State.Notes, State.Search, ListPaneWidth(State) - 4);
  var NotesList: TuiElement := TuiElementBuilders.MakeList(TuiControlId.Create(ListControl), Items, NotesSelectedFilteredPosition(State), TuiAction.Create(SelectionChangedAction));
  return TuiElementBuilders.MakePanel('Notes', [
                                                 Search,
                                                 TuiElementBuilders.MakeRule(''),
                                                 Expanding(NotesList, 1)
                                               ])
end;

function EmptyEditor(): TuiElement;
begin
  return TuiElementBuilders.MakePanel('Editor', [
                                                  TuiElementBuilders.MakeLabel('No note selected'),
                                                  TuiElementBuilders.MakeLabel('Press Ctrl+N to create one.')
                                                ])
end;

function EditorPane(State: NotesModel): TuiElement;
begin
  if (State.Selected < 0) or (State.Selected >= Std.Arrays.Length(State.Notes)) then
  begin
    return EmptyEditor()
  end;
  var NoteValue: Note := State.Notes[State.Selected];
  var Title: TuiElement := TuiElementBuilders.MakeInputWithHint(TuiControlId.Create(TitleControl), NoteValue.Title, State.TitleCaret, 'Note title', TuiAction.Create(TitleChangedAction));
  var Tags: TuiElement := TuiElementBuilders.MakeInputWithHint(TuiControlId.Create(TagsControl), State.TagsText, State.TagsCaret, 'tags, separated, by commas', TuiAction.Create(TagsChangedAction));
  var Body: TuiElement := TuiElementBuilders.MakeTextArea(TuiControlId.Create(BodyControl), NoteValue.Body, State.BodyCaret, State.BodyOffset, TuiAction.Create(BodyChangedAction));
  mutable var Pin: string := '';
  if NoteValue.Pinned then
  begin
    Pin := ' ★'
  end;

  return TuiElementBuilders.MakePanel('Editor' + Pin, [
                                                        Title,
                                                        Tags,
                                                        TuiElementBuilders.MakeRule('Markdown'),
                                                        Expanding(Body, 1)
                                                      ])
end;

function MainContent(State: NotesModel): TuiElement;
begin
  if State.Width < 65 then
  begin
    if State.Pane = NotesPane.List then
    begin
      return ListPane(State)
    end;

    return EditorPane(State)
  end;

  return TuiElementBuilders.MakeRow([
                                      FixedWidthExpanding(ListPane(State), SidebarWidth(State)),
                                      Expanding(EditorPane(State), 1)
                                    ])
end;

function Status(State: NotesModel): TuiElement;
begin
  return TuiElementBuilders.MakeStatusLine([
                                             TuiStatusItemBuilders.MakeHint(State.Status),
                                             TuiStatusItemBuilders.MakeKeyHint('Ctrl+N', 'new'),
                                             TuiStatusItemBuilders.MakeKeyHint('Ctrl+S', 'save'),
                                             TuiStatusItemBuilders.MakeKeyHint('Ctrl+F', 'search'),
                                             TuiStatusItemBuilders.MakeKeyHint('Ctrl+1/2', 'panes'),
                                             TuiStatusItemBuilders.MakeKeyHint('F1', 'help')
                                           ])
end;

function CommandOverlay(State: NotesModel): TuiElement;
begin
  var HasNote: boolean := (State.Selected >= 0) and
                          (State.Selected < Std.Arrays.Length(State.Notes));
  mutable var Save: TuiElement := TuiElementBuilders.MakeDisabledButton(TuiControlId.Create(SaveNoteControl), 'Save note', '', TuiAction.Create(SaveNoteAction));
  mutable var Pin: TuiElement := TuiElementBuilders.MakeDisabledButton(TuiControlId.Create(TogglePinControl), 'Toggle pin', '', TuiAction.Create(TogglePinAction));
  mutable var Archive: TuiElement := TuiElementBuilders.MakeDisabledButton(TuiControlId.Create(ArchiveNoteControl), 'Archive note', '', TuiAction.Create(ArchiveNoteAction));
  if HasNote then
  begin
    Save := TuiElementBuilders.MakeButton(TuiControlId.Create(SaveNoteControl), 'Save note', TuiAction.Create(SaveNoteAction));
    Pin := TuiElementBuilders.MakeButton(TuiControlId.Create(TogglePinControl), 'Toggle pin', TuiAction.Create(TogglePinAction));
    Archive := TuiElementBuilders.MakeButton(TuiControlId.Create(ArchiveNoteControl), 'Archive note', TuiAction.Create(ArchiveNoteAction))
  end;

  return TuiElementBuilders.MakeOverlay('Commands', [
                                                      TuiElementBuilders.MakeLabel('Quick actions'),
                                                      TuiElementBuilders.MakeButton(TuiControlId.Create(NewNoteControl), 'New note', TuiAction.Create(NewNoteAction)),
                                                      Save,
                                                      Pin,
                                                      Archive,
                                                      TuiElementBuilders.MakeButton(TuiControlId.Create(HelpControl), 'Help', TuiAction.Create(HelpAction)),
                                                      TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(CommandsCloseControl), 'Close', 'C', TuiAction.Create(CloseOverlayAction))
                                                    ])
end;

function HelpOverlay(): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay('Keyboard help', [
                                                           TuiElementBuilders.MakeLabel('Ctrl+N  Create a note'),
                                                           TuiElementBuilders.MakeLabel('Ctrl+S  Save changes'),
                                                           TuiElementBuilders.MakeLabel('Ctrl+F  Search notes'),
                                                           TuiElementBuilders.MakeLabel('Ctrl+P  Toggle pin'),
                                                           TuiElementBuilders.MakeLabel('Ctrl+K  Open commands'),
                                                           TuiElementBuilders.MakeLabel('Ctrl+1  Focus note list'),
                                                           TuiElementBuilders.MakeLabel('Ctrl+2  Focus editor'),
                                                           TuiElementBuilders.MakeLabel('Enter   Open selected note'),
                                                           TuiElementBuilders.MakeLabel('Alt+X   Quit Notes'),
                                                           TuiElementBuilders.MakeLabel('Arrows  Move between dialog buttons'),
                                                           TuiElementBuilders.MakeLabel('Esc     Close an overlay'),
                                                           TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(HelpCloseControl), 'Close', 'C', TuiAction.Create(CloseOverlayAction))
                                                         ])
end;

function QuitOverlay(): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay('Unsaved changes', [
                                                             TuiElementBuilders.MakeLabel('Save the current note before quitting?'),
                                                             TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(SaveAndQuitControl), 'Save and quit', 'S', TuiAction.Create(SaveAndQuitAction)),
                                                             TuiElementBuilders.MakeButtonWithMnemonic(TuiControlId.Create(DiscardAndQuitControl), 'Discard', 'D', TuiAction.Create(DiscardAndQuitAction)),
                                                             TuiElementBuilders.MakeButtonWithMnemonic(TuiControlId.Create(CancelQuitControl), 'Cancel', 'C', TuiAction.Create(CloseOverlayAction))
                                                           ])
end;

function ErrorOverlay(State: NotesModel): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay('Could not save note', [
                                                                 TuiElementBuilders.MakeLabel(State.ErrorMessage),
                                                                 TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(ErrorCloseControl), 'Close', 'C', TuiAction.Create(CloseOverlayAction))
                                                               ])
end;

function Overlay(State: NotesModel): TuiElement;
begin
  case State.Overlay of
    NotesOverlay.Commands:
    begin
      return CommandOverlay(State)
    end;
    NotesOverlay.Help:
    begin
      return HelpOverlay()
    end;
    NotesOverlay.QuitConfirmation:
    begin
      return QuitOverlay()
    end;
    NotesOverlay.SaveFailure:
    begin
      return ErrorOverlay(State)
    end;
    NotesOverlay.Closed:
    begin
      return TuiElementBuilders.MakeEmpty()
    end
  end
end;

function MainFocus(State: NotesModel): integer;
begin
  if State.Width < 65 then
  begin
    if State.Pane = NotesPane.List then
    begin
      if (State.Focus = SearchControl) or (State.Focus = ListControl) then
      begin
        return State.Focus
      end;

      return SearchControl
    end;

    if (State.Selected >= 0) and (State.Selected < Std.Arrays.Length(State.Notes)) then
    begin
      if (State.Focus >= TitleControl) and (State.Focus <= BodyControl) then
      begin
        return State.Focus
      end;

      return BodyControl
    end
  end
  else
  begin
    if (State.Focus = SearchControl) or (State.Focus = ListControl) then
    begin
      return State.Focus
    end;

    if ((State.Selected >= 0) and (State.Selected < Std.Arrays.Length(State.Notes))) and
       ((State.Focus >= TitleControl) and (State.Focus <= BodyControl)) then
    begin
      return State.Focus
    end;

    if (State.Selected >= 0) and (State.Selected < Std.Arrays.Length(State.Notes)) then
    begin
      return BodyControl
    end
  end;

  return SearchControl
end;

function OverlayFocus(State: NotesModel): integer;
begin
  case State.Overlay of
    NotesOverlay.Commands:
    begin
      if ((State.Focus = NewNoteControl) or (State.Focus = HelpControl)) or
         (State.Focus = CommandsCloseControl) then
      begin
        return State.Focus
      end;

      if ((State.Selected >= 0) and (State.Selected < Std.Arrays.Length(State.Notes))) and
         ((State.Focus >= SaveNoteControl) and (State.Focus <= ArchiveNoteControl)) then
      begin
        return State.Focus
      end;

      return NewNoteControl
    end;
    NotesOverlay.Help:
    begin
      return HelpCloseControl
    end;
    NotesOverlay.QuitConfirmation:
    begin
      if (State.Focus >= SaveAndQuitControl) and (State.Focus <= CancelQuitControl) then
      begin
        return State.Focus
      end;

      return SaveAndQuitControl
    end;
    NotesOverlay.SaveFailure:
    begin
      return ErrorCloseControl
    end;
    NotesOverlay.Closed:
    begin
      return MainFocus(State)
    end
  end
end;

// Builds the responsive Notes element tree for one model state.
public function NotesView(State: NotesModel): TuiElement;
begin
  if (State.Width < 50) or (State.Height < 14) then
  begin
    return TuiElementBuilders.MakeDesktop(None, [
                                                  TuiElementBuilders.MakePanel('Notes', [
                                                                                          TuiElementBuilders.MakeLabel('Terminal too small'),
                                                                                          TuiElementBuilders.MakeLabel('Use at least 50 × 14 cells.')
                                                                                        ])
                                                ])
  end;
  mutable var Children: array of TuiElement := [
                                                 TuiElementBuilders.MakeColumn([Header(State), Expanding(MainContent(State), 1), Status(State)])
                                               ];
  if State.Overlay <> NotesOverlay.Closed then
  begin
    Std.Arrays.Push(Children, Overlay(State))
  end;

  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(OverlayFocus(State))), Children)
end;
