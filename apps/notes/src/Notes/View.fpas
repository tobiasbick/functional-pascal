unit Notes.View;

uses Notes.Actions as Actions;
uses Notes.Model as Model;
uses Notes.Update as Update;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Tui as Tui;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Layout as Layout;

function Expanding(Child: Tui.TuiElement; Stretch: integer): Tui.TuiElement;
begin
  return Elements.TuiElementMakeLayout(Layout.TuiLayoutSettingsCreate(Layout.TuiMarginsUniform(0), Layout.TuiSizePolicyExpanding(), Layout.TuiAlignmentFill(), Stretch), Child);
end function;

function SidebarWidth(State: Model.NotesModel): integer;
begin
  const Width: integer := State.Width div 3;
  if Width < 32 then
    begin
      return 32;
    end;
  end if;

  if Width > 52 then
    begin
      return 52;
    end;
  end if;

  return Width;
end function;

function ListPaneWidth(State: Model.NotesModel): integer;
begin
  if State.Width < 65 then
    begin
      return State.Width;
    end;
  end if;

  return SidebarWidth(State);
end function;

function FixedWidthExpanding(Child: Tui.TuiElement; Width: integer): Tui.TuiElement;
begin
  return Elements.TuiElementMakeLayout(Layout.TuiLayoutSettingsWithFixedWidth(Layout.TuiLayoutSettingsCreate(Layout.TuiMarginsUniform(0), Layout.TuiSizePolicyCreate(Tui.TuiSizePolicyKind.Preferred, Tui.TuiSizePolicyKind.Expanding), Layout.TuiAlignmentFill(), 0), Width), Child);
end function;

function Header(State: Model.NotesModel): Tui.TuiElement;
begin
  var Dirty: string := '';
  var Issues: string := '';
  if State.Dirty then
    begin
      Dirty := '  ● unsaved';
    end;
  end if;

  if Arrays.Length(State.Issues) > 0 then
    begin
      Issues := ('  ·  ' + Conv.IntToStr(Arrays.Length(State.Issues))) + ' invalid';
    end;
  end if;

  return Elements.TuiElementMakeRule(((((' NOTES  ·  ' + Conv.IntToStr(Arrays.Length(Model.NotesFilteredIndices(State.Notes, '')))) + ' active') + Issues) + Dirty) +
                                     '  ·  Ctrl+K commands ');
end function;

function ListPane(State: Model.NotesModel): Tui.TuiElement;
begin
  const Search: Tui.TuiElement := Elements.TuiElementMakeInputWithHint(Ids.TuiControlIdCreate(Actions.SearchControl), State.Search, State.SearchCaret, 'Search notes…', Ids.TuiActionCreate(Actions.SearchChangedAction));
  const Items: array of (string) := Model.NotesListItems(State.Notes, State.Search, ListPaneWidth(State) -
                                                                                    4);
  const NotesList: Tui.TuiElement := Elements.TuiElementMakeList(Ids.TuiControlIdCreate(Actions.ListControl), Items, Update.NotesSelectedFilteredPosition(State), Ids.TuiActionCreate(Actions.SelectionChangedAction));
  return Elements.TuiElementMakePanel('Notes', [
                                                 Search,
                                                 Elements.TuiElementMakeRule(''),
                                                 Expanding(NotesList, 1)
                                               ]);
end function;

function EmptyEditor(): Tui.TuiElement;
begin
  return Elements.TuiElementMakePanel('Editor', [
                                                  Elements.TuiElementMakeLabel('No note selected'),
                                                  Elements.TuiElementMakeLabel('Press Ctrl+N to create one.')
                                                ]);
end function;

function EditorPane(State: Model.NotesModel): Tui.TuiElement;
begin
  if (State.Selected < 0) or (State.Selected >= Arrays.Length(State.Notes)) then
    begin
      return EmptyEditor();
    end;
  end if;
  const NoteValue: Model.Note := State.Notes[State.Selected];
  const Title: Tui.TuiElement := Elements.TuiElementMakeInputWithHint(Ids.TuiControlIdCreate(Actions.TitleControl), NoteValue.Title, State.TitleCaret, 'Note title', Ids.TuiActionCreate(Actions.TitleChangedAction));
  const Tags: Tui.TuiElement := Elements.TuiElementMakeInputWithHint(Ids.TuiControlIdCreate(Actions.TagsControl), State.TagsText, State.TagsCaret, 'tags, separated, by commas', Ids.TuiActionCreate(Actions.TagsChangedAction));
  const Body: Tui.TuiElement := Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(Actions.BodyControl), NoteValue.Body, State.BodyCaret, State.BodyOffset, Ids.TuiActionCreate(Actions.BodyChangedAction));
  var Pin: string := '';
  if NoteValue.Pinned then
    begin
      Pin := ' ★';
    end;
  end if;

  return Elements.TuiElementMakePanel('Editor' + Pin, [
                                                        Title,
                                                        Tags,
                                                        Elements.TuiElementMakeRule('Markdown'),
                                                        Expanding(Body, 1)
                                                      ]);
end function;

function MainContent(State: Model.NotesModel): Tui.TuiElement;
begin
  if State.Width < 65 then
    begin
      if State.Pane = Model.NotesPane.List then
        begin
          return ListPane(State);
        end;
      end if;

      return EditorPane(State);
    end;
  end if;

  return Elements.TuiElementMakeRow([
                                      FixedWidthExpanding(ListPane(State), SidebarWidth(State)),
                                      Expanding(EditorPane(State), 1)
                                    ]);
end function;

function Status(State: Model.NotesModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeStatusLine([
                                             Chrome.TuiStatusItemMakeHint(State.Status),
                                             Chrome.TuiStatusItemMakeKeyHint('Ctrl+N', 'new'),
                                             Chrome.TuiStatusItemMakeKeyHint('Ctrl+S', 'save'),
                                             Chrome.TuiStatusItemMakeKeyHint('Ctrl+F', 'search'),
                                             Chrome.TuiStatusItemMakeKeyHint('Ctrl+1/2', 'panes'),
                                             Chrome.TuiStatusItemMakeKeyHint('F1', 'help')
                                           ]);
end function;

function CommandOverlay(State: Model.NotesModel): Tui.TuiElement;
begin
  const HasNote: boolean := (State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes));
  var Save: Tui.TuiElement := Elements.TuiElementMakeDisabledButton(Ids.TuiControlIdCreate(Actions.SaveNoteControl), 'Save note', '', Ids.TuiActionCreate(Actions.SaveNoteAction));
  var Pin: Tui.TuiElement := Elements.TuiElementMakeDisabledButton(Ids.TuiControlIdCreate(Actions.TogglePinControl), 'Toggle pin', '', Ids.TuiActionCreate(Actions.TogglePinAction));
  var Archive: Tui.TuiElement := Elements.TuiElementMakeDisabledButton(Ids.TuiControlIdCreate(Actions.ArchiveNoteControl), 'Archive note', '', Ids.TuiActionCreate(Actions.ArchiveNoteAction));
  if HasNote then
    begin
      Save := Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(Actions.SaveNoteControl), 'Save note', Ids.TuiActionCreate(Actions.SaveNoteAction));
      Pin := Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(Actions.TogglePinControl), 'Toggle pin', Ids.TuiActionCreate(Actions.TogglePinAction));
      Archive := Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(Actions.ArchiveNoteControl), 'Archive note', Ids.TuiActionCreate(Actions.ArchiveNoteAction));
    end;
  end if;

  return Elements.TuiElementMakeOverlay('Commands', [
                                                      Elements.TuiElementMakeLabel('Quick actions'),
                                                      Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(Actions.NewNoteControl), 'New note', Ids.TuiActionCreate(Actions.NewNoteAction)),
                                                      Save,
                                                      Pin,
                                                      Archive,
                                                      Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(Actions.HelpControl), 'Help', Ids.TuiActionCreate(Actions.HelpAction)),
                                                      Elements.TuiElementMakeDefaultButton(Ids.TuiControlIdCreate(Actions.CommandsCloseControl), 'Close', 'C', Ids.TuiActionCreate(Actions.CloseOverlayAction))
                                                    ]);
end function;

function HelpOverlay(): Tui.TuiElement;
begin
  return Elements.TuiElementMakeOverlay('Keyboard help', [
                                                           Elements.TuiElementMakeLabel('Ctrl+N  Create a note'),
                                                           Elements.TuiElementMakeLabel('Ctrl+S  Save changes'),
                                                           Elements.TuiElementMakeLabel('Ctrl+F  Search notes'),
                                                           Elements.TuiElementMakeLabel('Ctrl+P  Toggle pin'),
                                                           Elements.TuiElementMakeLabel('Ctrl+K  Open commands'),
                                                           Elements.TuiElementMakeLabel('Ctrl+1  Focus note list'),
                                                           Elements.TuiElementMakeLabel('Ctrl+2  Focus editor'),
                                                           Elements.TuiElementMakeLabel('Enter   Open selected note'),
                                                           Elements.TuiElementMakeLabel('Alt+X   Quit Notes'),
                                                           Elements.TuiElementMakeLabel('Arrows  Move between dialog buttons'),
                                                           Elements.TuiElementMakeLabel('Esc     Close an overlay'),
                                                           Elements.TuiElementMakeDefaultButton(Ids.TuiControlIdCreate(Actions.HelpCloseControl), 'Close', 'C', Ids.TuiActionCreate(Actions.CloseOverlayAction))
                                                         ]);
end function;

function QuitOverlay(): Tui.TuiElement;
begin
  return Elements.TuiElementMakeOverlay('Unsaved changes', [
                                                             Elements.TuiElementMakeLabel('Save the current note before quitting?'),
                                                             Elements.TuiElementMakeDefaultButton(Ids.TuiControlIdCreate(Actions.SaveAndQuitControl), 'Save and quit', 'S', Ids.TuiActionCreate(Actions.SaveAndQuitAction)),
                                                             Elements.TuiElementMakeButtonWithMnemonic(Ids.TuiControlIdCreate(Actions.DiscardAndQuitControl), 'Discard', 'D', Ids.TuiActionCreate(Actions.DiscardAndQuitAction)),
                                                             Elements.TuiElementMakeButtonWithMnemonic(Ids.TuiControlIdCreate(Actions.CancelQuitControl), 'Cancel', 'C', Ids.TuiActionCreate(Actions.CloseOverlayAction))
                                                           ]);
end function;

function ErrorOverlay(State: Model.NotesModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeOverlay('Could not save note', [
                                                                 Elements.TuiElementMakeLabel(State.ErrorMessage),
                                                                 Elements.TuiElementMakeDefaultButton(Ids.TuiControlIdCreate(Actions.ErrorCloseControl), 'Close', 'C', Ids.TuiActionCreate(Actions.CloseOverlayAction))
                                                               ]);
end function;

function Overlay(State: Model.NotesModel): Tui.TuiElement;
begin
  case State.Overlay of
    when Model.NotesOverlay.Commands:
      begin
        return CommandOverlay(State);
      end;
    when Model.NotesOverlay.Help:
      begin
        return HelpOverlay();
      end;
    when Model.NotesOverlay.QuitConfirmation:
      begin
        return QuitOverlay();
      end;
    when Model.NotesOverlay.SaveFailure:
      begin
        return ErrorOverlay(State);
      end;
    when Model.NotesOverlay.Closed:
      begin
        return Elements.TuiElementMakeEmpty();
      end;
  end case;
end function;

function MainFocus(State: Model.NotesModel): integer;
begin
  if State.Width < 65 then
    begin
      if State.Pane = Model.NotesPane.List then
        begin
          if (State.Focus = Actions.SearchControl) or (State.Focus = Actions.ListControl) then
            begin
              return State.Focus;
            end;
          end if;

          return Actions.SearchControl;
        end;
      end if;

      if (State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes)) then
        begin
          if (State.Focus >= Actions.TitleControl) and (State.Focus <= Actions.BodyControl) then
            begin
              return State.Focus;
            end;
          end if;

          return Actions.BodyControl;
        end;
      end if;
    end;
  else
    begin
      if (State.Focus = Actions.SearchControl) or (State.Focus = Actions.ListControl) then
        begin
          return State.Focus;
        end;
      end if;

      if ((State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes))) and
         ((State.Focus >= Actions.TitleControl) and (State.Focus <= Actions.BodyControl)) then
        begin
          return State.Focus;
        end;
      end if;

      if (State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes)) then
        begin
          return Actions.BodyControl;
        end;
      end if;
    end;
  end if;

  return Actions.SearchControl;
end function;

function OverlayFocus(State: Model.NotesModel): integer;
begin
  case State.Overlay of
    when Model.NotesOverlay.Commands:
      begin
        if ((State.Focus = Actions.NewNoteControl) or (State.Focus = Actions.HelpControl)) or
           (State.Focus = Actions.CommandsCloseControl) then
          begin
            return State.Focus;
          end;
        end if;

        if ((State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes))) and
           ((State.Focus >= Actions.SaveNoteControl) and (State.Focus <= Actions.ArchiveNoteControl)) then
          begin
            return State.Focus;
          end;
        end if;

        return Actions.NewNoteControl;
      end;
    when Model.NotesOverlay.Help:
      begin
        return Actions.HelpCloseControl;
      end;
    when Model.NotesOverlay.QuitConfirmation:
      begin
        if (State.Focus >= Actions.SaveAndQuitControl) and
           (State.Focus <= Actions.CancelQuitControl) then
          begin
            return State.Focus;
          end;
        end if;

        return Actions.SaveAndQuitControl;
      end;
    when Model.NotesOverlay.SaveFailure:
      begin
        return Actions.ErrorCloseControl;
      end;
    when Model.NotesOverlay.Closed:
      begin
        return MainFocus(State);
      end;
  end case;
end function;

// Builds the responsive Notes element tree for one model state.
public function NotesView(State: Model.NotesModel): Tui.TuiElement;
begin
  if (State.Width < 50) or (State.Height < 14) then
    begin
      return Elements.TuiElementMakeDesktop(Option.None, [
                                                           Elements.TuiElementMakePanel('Notes', [
                                                                                                   Elements.TuiElementMakeLabel('Terminal too small'),
                                                                                                   Elements.TuiElementMakeLabel('Use at least 50 × 14 cells.')
                                                                                                 ])
                                                         ]);
    end;
  end if;
  var Children: array of (Tui.TuiElement) := [
                                               Elements.TuiElementMakeColumn([Header(State), Expanding(MainContent(State), 1), Status(State)])
                                             ];
  if State.Overlay <> Model.NotesOverlay.Closed then
    begin
      Arrays.Push(var Children, Overlay(State));
    end;
  end if;

  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(OverlayFocus(State))), Children);
end function;

end unit;
