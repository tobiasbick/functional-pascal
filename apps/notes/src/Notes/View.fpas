unit Notes.View;

uses Notes.Actions as Actions;
uses Notes.Model as Model;
uses Notes.Update as Update;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Tui as Tui;

function Expanding(Child: Tui.TuiElement; Stretch: integer): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLayout(Tui.TuiLayoutSettings.Create(Tui.TuiMargins.Uniform(0), Tui.TuiSizePolicy.Expanding(), Tui.TuiAlignment.Fill(), Stretch), Child);
end function;

function SidebarWidth(State: Model.NotesModel): integer;
begin
  var Width: integer := State.Width div 3;
  if Width < 32 then
    begin
      return 32;
    end;
  end if;

  if Width > 52 then
    begin
      return 52;
    end;
  end if;

  return Width;
end function;

function ListPaneWidth(State: Model.NotesModel): integer;
begin
  if State.Width < 65 then
    begin
      return State.Width;
    end;
  end if;

  return SidebarWidth(State);
end function;

function FixedWidthExpanding(Child: Tui.TuiElement; Width: integer): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLayout(Tui.TuiLayoutSettings.Create(Tui.TuiMargins.Uniform(0), Tui.TuiSizePolicy.Create(Tui.TuiSizePolicyKind.Preferred, Tui.TuiSizePolicyKind.Expanding), Tui.TuiAlignment.Fill(), 0)
                                             .WithFixedWidth(Width), Child);
end function;

function Header(State: Model.NotesModel): Tui.TuiElement;
begin
  mutable var Dirty: string := '';
  mutable var Issues: string := '';
  if State.Dirty then
    begin
      Dirty := '  ● unsaved';
    end;
  end if;

  if Arrays.Length(State.Issues) > 0 then
    begin
      Issues := ('  ·  ' + Conv.IntToStr(Arrays.Length(State.Issues))) + ' invalid';
    end;
  end if;

  return Tui.TuiElementBuilders.MakeRule(((((' NOTES  ·  ' + Conv.IntToStr(Arrays.Length(Model.NotesFilteredIndices(State.Notes, '')))) + ' active') + Issues) + Dirty) +
                                         '  ·  Ctrl+K commands ');
end function;

function ListPane(State: Model.NotesModel): Tui.TuiElement;
begin
  var Search: Tui.TuiElement := Tui.TuiElementBuilders.MakeInputWithHint(Tui.TuiControlId.Create(Actions.SearchControl), State.Search, State.SearchCaret, 'Search notes…', Tui.TuiAction.Create(Actions.SearchChangedAction));
  var Items: array of string := Model.NotesListItems(State.Notes, State.Search, ListPaneWidth(State) -
                                                                                4);
  var NotesList: Tui.TuiElement := Tui.TuiElementBuilders.MakeList(Tui.TuiControlId.Create(Actions.ListControl), Items, Update.NotesSelectedFilteredPosition(State), Tui.TuiAction.Create(Actions.SelectionChangedAction));
  return Tui.TuiElementBuilders.MakePanel('Notes', [
                                                     Search,
                                                     Tui.TuiElementBuilders.MakeRule(''),
                                                     Expanding(NotesList, 1)
                                                   ]);
end function;

function EmptyEditor(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakePanel('Editor', [
                                                      Tui.TuiElementBuilders.MakeLabel('No note selected'),
                                                      Tui.TuiElementBuilders.MakeLabel('Press Ctrl+N to create one.')
                                                    ]);
end function;

function EditorPane(State: Model.NotesModel): Tui.TuiElement;
begin
  if (State.Selected < 0) or (State.Selected >= Arrays.Length(State.Notes)) then
    begin
      return EmptyEditor();
    end;
  end if;
  var NoteValue: Model.Note := State.Notes[State.Selected];
  var Title: Tui.TuiElement := Tui.TuiElementBuilders.MakeInputWithHint(Tui.TuiControlId.Create(Actions.TitleControl), NoteValue.Title, State.TitleCaret, 'Note title', Tui.TuiAction.Create(Actions.TitleChangedAction));
  var Tags: Tui.TuiElement := Tui.TuiElementBuilders.MakeInputWithHint(Tui.TuiControlId.Create(Actions.TagsControl), State.TagsText, State.TagsCaret, 'tags, separated, by commas', Tui.TuiAction.Create(Actions.TagsChangedAction));
  var Body: Tui.TuiElement := Tui.TuiElementBuilders.MakeTextArea(Tui.TuiControlId.Create(Actions.BodyControl), NoteValue.Body, State.BodyCaret, State.BodyOffset, Tui.TuiAction.Create(Actions.BodyChangedAction));
  mutable var Pin: string := '';
  if NoteValue.Pinned then
    begin
      Pin := ' ★';
    end;
  end if;

  return Tui.TuiElementBuilders.MakePanel('Editor' + Pin, [
                                                            Title,
                                                            Tags,
                                                            Tui.TuiElementBuilders.MakeRule('Markdown'),
                                                            Expanding(Body, 1)
                                                          ]);
end function;

function MainContent(State: Model.NotesModel): Tui.TuiElement;
begin
  if State.Width < 65 then
    begin
      if State.Pane = Model.NotesPane.List then
        begin
          return ListPane(State);
        end;
      end if;

      return EditorPane(State);
    end;
  end if;

  return Tui.TuiElementBuilders.MakeRow([
                                          FixedWidthExpanding(ListPane(State), SidebarWidth(State)),
                                          Expanding(EditorPane(State), 1)
                                        ]);
end function;

function Status(State: Model.NotesModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeStatusLine([
                                                 Tui.TuiStatusItemBuilders.MakeHint(State.Status),
                                                 Tui.TuiStatusItemBuilders.MakeKeyHint('Ctrl+N', 'new'),
                                                 Tui.TuiStatusItemBuilders.MakeKeyHint('Ctrl+S', 'save'),
                                                 Tui.TuiStatusItemBuilders.MakeKeyHint('Ctrl+F', 'search'),
                                                 Tui.TuiStatusItemBuilders.MakeKeyHint('Ctrl+1/2', 'panes'),
                                                 Tui.TuiStatusItemBuilders.MakeKeyHint('F1', 'help')
                                               ]);
end function;

function CommandOverlay(State: Model.NotesModel): Tui.TuiElement;
begin
  var HasNote: boolean := (State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes));
  mutable var Save: Tui.TuiElement := Tui.TuiElementBuilders.MakeDisabledButton(Tui.TuiControlId.Create(Actions.SaveNoteControl), 'Save note', '', Tui.TuiAction.Create(Actions.SaveNoteAction));
  mutable var Pin: Tui.TuiElement := Tui.TuiElementBuilders.MakeDisabledButton(Tui.TuiControlId.Create(Actions.TogglePinControl), 'Toggle pin', '', Tui.TuiAction.Create(Actions.TogglePinAction));
  mutable var Archive: Tui.TuiElement := Tui.TuiElementBuilders.MakeDisabledButton(Tui.TuiControlId.Create(Actions.ArchiveNoteControl), 'Archive note', '', Tui.TuiAction.Create(Actions.ArchiveNoteAction));
  if HasNote then
    begin
      Save := Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(Actions.SaveNoteControl), 'Save note', Tui.TuiAction.Create(Actions.SaveNoteAction));
      Pin := Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(Actions.TogglePinControl), 'Toggle pin', Tui.TuiAction.Create(Actions.TogglePinAction));
      Archive := Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(Actions.ArchiveNoteControl), 'Archive note', Tui.TuiAction.Create(Actions.ArchiveNoteAction));
    end;
  end if;

  return Tui.TuiElementBuilders.MakeOverlay('Commands', [
                                                          Tui.TuiElementBuilders.MakeLabel('Quick actions'),
                                                          Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(Actions.NewNoteControl), 'New note', Tui.TuiAction.Create(Actions.NewNoteAction)),
                                                          Save,
                                                          Pin,
                                                          Archive,
                                                          Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(Actions.HelpControl), 'Help', Tui.TuiAction.Create(Actions.HelpAction)),
                                                          Tui.TuiElementBuilders.MakeDefaultButton(Tui.TuiControlId.Create(Actions.CommandsCloseControl), 'Close', 'C', Tui.TuiAction.Create(Actions.CloseOverlayAction))
                                                        ]);
end function;

function HelpOverlay(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay('Keyboard help', [
                                                               Tui.TuiElementBuilders.MakeLabel('Ctrl+N  Create a note'),
                                                               Tui.TuiElementBuilders.MakeLabel('Ctrl+S  Save changes'),
                                                               Tui.TuiElementBuilders.MakeLabel('Ctrl+F  Search notes'),
                                                               Tui.TuiElementBuilders.MakeLabel('Ctrl+P  Toggle pin'),
                                                               Tui.TuiElementBuilders.MakeLabel('Ctrl+K  Open commands'),
                                                               Tui.TuiElementBuilders.MakeLabel('Ctrl+1  Focus note list'),
                                                               Tui.TuiElementBuilders.MakeLabel('Ctrl+2  Focus editor'),
                                                               Tui.TuiElementBuilders.MakeLabel('Enter   Open selected note'),
                                                               Tui.TuiElementBuilders.MakeLabel('Alt+X   Quit Notes'),
                                                               Tui.TuiElementBuilders.MakeLabel('Arrows  Move between dialog buttons'),
                                                               Tui.TuiElementBuilders.MakeLabel('Esc     Close an overlay'),
                                                               Tui.TuiElementBuilders.MakeDefaultButton(Tui.TuiControlId.Create(Actions.HelpCloseControl), 'Close', 'C', Tui.TuiAction.Create(Actions.CloseOverlayAction))
                                                             ]);
end function;

function QuitOverlay(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay('Unsaved changes', [
                                                                 Tui.TuiElementBuilders.MakeLabel('Save the current note before quitting?'),
                                                                 Tui.TuiElementBuilders.MakeDefaultButton(Tui.TuiControlId.Create(Actions.SaveAndQuitControl), 'Save and quit', 'S', Tui.TuiAction.Create(Actions.SaveAndQuitAction)),
                                                                 Tui.TuiElementBuilders.MakeButtonWithMnemonic(Tui.TuiControlId.Create(Actions.DiscardAndQuitControl), 'Discard', 'D', Tui.TuiAction.Create(Actions.DiscardAndQuitAction)),
                                                                 Tui.TuiElementBuilders.MakeButtonWithMnemonic(Tui.TuiControlId.Create(Actions.CancelQuitControl), 'Cancel', 'C', Tui.TuiAction.Create(Actions.CloseOverlayAction))
                                                               ]);
end function;

function ErrorOverlay(State: Model.NotesModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay('Could not save note', [
                                                                     Tui.TuiElementBuilders.MakeLabel(State.ErrorMessage),
                                                                     Tui.TuiElementBuilders.MakeDefaultButton(Tui.TuiControlId.Create(Actions.ErrorCloseControl), 'Close', 'C', Tui.TuiAction.Create(Actions.CloseOverlayAction))
                                                                   ]);
end function;

function Overlay(State: Model.NotesModel): Tui.TuiElement;
begin
  case State.Overlay of
    when Model.NotesOverlay.Commands:
      begin
        return CommandOverlay(State);
      end;
    when Model.NotesOverlay.Help:
      begin
        return HelpOverlay();
      end;
    when Model.NotesOverlay.QuitConfirmation:
      begin
        return QuitOverlay();
      end;
    when Model.NotesOverlay.SaveFailure:
      begin
        return ErrorOverlay(State);
      end;
    when Model.NotesOverlay.Closed:
      begin
        return Tui.TuiElementBuilders.MakeEmpty();
      end;
  end case;
end function;

function MainFocus(State: Model.NotesModel): integer;
begin
  if State.Width < 65 then
    begin
      if State.Pane = Model.NotesPane.List then
        begin
          if (State.Focus = Actions.SearchControl) or (State.Focus = Actions.ListControl) then
            begin
              return State.Focus;
            end;
          end if;

          return Actions.SearchControl;
        end;
      end if;

      if (State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes)) then
        begin
          if (State.Focus >= Actions.TitleControl) and (State.Focus <= Actions.BodyControl) then
            begin
              return State.Focus;
            end;
          end if;

          return Actions.BodyControl;
        end;
      end if;
    end;
  else
    begin
      if (State.Focus = Actions.SearchControl) or (State.Focus = Actions.ListControl) then
        begin
          return State.Focus;
        end;
      end if;

      if ((State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes))) and
         ((State.Focus >= Actions.TitleControl) and (State.Focus <= Actions.BodyControl)) then
        begin
          return State.Focus;
        end;
      end if;

      if (State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes)) then
        begin
          return Actions.BodyControl;
        end;
      end if;
    end;
  end if;

  return Actions.SearchControl;
end function;

function OverlayFocus(State: Model.NotesModel): integer;
begin
  case State.Overlay of
    when Model.NotesOverlay.Commands:
      begin
        if ((State.Focus = Actions.NewNoteControl) or (State.Focus = Actions.HelpControl)) or
           (State.Focus = Actions.CommandsCloseControl) then
          begin
            return State.Focus;
          end;
        end if;

        if ((State.Selected >= 0) and (State.Selected < Arrays.Length(State.Notes))) and
           ((State.Focus >= Actions.SaveNoteControl) and (State.Focus <= Actions.ArchiveNoteControl)) then
          begin
            return State.Focus;
          end;
        end if;

        return Actions.NewNoteControl;
      end;
    when Model.NotesOverlay.Help:
      begin
        return Actions.HelpCloseControl;
      end;
    when Model.NotesOverlay.QuitConfirmation:
      begin
        if (State.Focus >= Actions.SaveAndQuitControl) and
           (State.Focus <= Actions.CancelQuitControl) then
          begin
            return State.Focus;
          end;
        end if;

        return Actions.SaveAndQuitControl;
      end;
    when Model.NotesOverlay.SaveFailure:
      begin
        return Actions.ErrorCloseControl;
      end;
    when Model.NotesOverlay.Closed:
      begin
        return MainFocus(State);
      end;
  end case;
end function;

// Builds the responsive Notes element tree for one model state.
public function NotesView(State: Model.NotesModel): Tui.TuiElement;
begin
  if (State.Width < 50) or (State.Height < 14) then
    begin
      return Tui.TuiElementBuilders.MakeDesktop(None, [
                                                        Tui.TuiElementBuilders.MakePanel('Notes', [
                                                                                                    Tui.TuiElementBuilders.MakeLabel('Terminal too small'),
                                                                                                    Tui.TuiElementBuilders.MakeLabel('Use at least 50 × 14 cells.')
                                                                                                  ])
                                                      ]);
    end;
  end if;
  mutable var Children: array of Tui.TuiElement := [
                                                     Tui.TuiElementBuilders.MakeColumn([Header(State), Expanding(MainContent(State), 1), Status(State)])
                                                   ];
  if State.Overlay <> Model.NotesOverlay.Closed then
    begin
      Arrays.Push(Children, Overlay(State));
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(OverlayFocus(State))), Children);
end function;

end unit;
