unit Notes.View;

uses Notes.Actions as Actions, Notes.Model as Model, Notes.View.Panes as Panes, Std.Ui.Terminal as Tui;

function CommandOverlay(State: Model.NotesModel): Tui.TuiElement;
begin
  const HasNote: boolean := (State.Selected >= 0) and (State.Selected < State.Notes.Length());
  var Save: Tui.TuiElement := Tui.TuiElementBuilders.MakeDisabledButton(
    Tui.TuiControlId.Create(Actions.SaveNoteControl),
    'Save note',
    '',
    Tui.TuiAction.Create(Actions.SaveNoteAction)
  );
  var Pin: Tui.TuiElement := Tui.TuiElementBuilders.MakeDisabledButton(
    Tui.TuiControlId.Create(Actions.TogglePinControl),
    'Toggle pin',
    '',
    Tui.TuiAction.Create(Actions.TogglePinAction)
  );
  var Archive: Tui.TuiElement := Tui.TuiElementBuilders.MakeDisabledButton(
    Tui.TuiControlId.Create(Actions.ArchiveNoteControl),
    'Archive note',
    '',
    Tui.TuiAction.Create(Actions.ArchiveNoteAction)
  );
  if HasNote then
    begin
      Save := Tui.TuiElementBuilders.MakeButton(
        Tui.TuiControlId.Create(Actions.SaveNoteControl),
        'Save note',
        Tui.TuiAction.Create(Actions.SaveNoteAction)
      );
      Pin := Tui.TuiElementBuilders.MakeButton(
        Tui.TuiControlId.Create(Actions.TogglePinControl),
        'Toggle pin',
        Tui.TuiAction.Create(Actions.TogglePinAction)
      );
      Archive := Tui.TuiElementBuilders.MakeButton(
        Tui.TuiControlId.Create(Actions.ArchiveNoteControl),
        'Archive note',
        Tui.TuiAction.Create(Actions.ArchiveNoteAction)
      );
    end;
  end if;

  return Tui.TuiElementBuilders.MakeOverlay(
    'Commands', [
      Tui.TuiElementBuilders.MakeLabel('Quick actions'),
      Tui.TuiElementBuilders.MakeButton(
        Tui.TuiControlId.Create(Actions.NewNoteControl),
        'New note',
        Tui.TuiAction.Create(Actions.NewNoteAction)
      ),
      Save,
      Pin,
      Archive,
      Tui.TuiElementBuilders.MakeButton(
        Tui.TuiControlId.Create(Actions.HelpControl),
        'Help',
        Tui.TuiAction.Create(Actions.HelpAction)
      ),
      Tui.TuiElementBuilders.MakeDefaultButton(
        Tui.TuiControlId.Create(Actions.CommandsCloseControl),
        'Close',
        'C',
        Tui.TuiAction.Create(Actions.CloseOverlayAction)
      )
    ]
  );
end function;

function HelpOverlay(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    'Keyboard help', [
      Tui.TuiElementBuilders.MakeLabel('Ctrl+N  Create a note'),
      Tui.TuiElementBuilders.MakeLabel('Ctrl+S  Save changes'),
      Tui.TuiElementBuilders.MakeLabel('Ctrl+F  Search notes'),
      Tui.TuiElementBuilders.MakeLabel('Ctrl+P  Toggle pin'),
      Tui.TuiElementBuilders.MakeLabel('Ctrl+K  Open commands'),
      Tui.TuiElementBuilders.MakeLabel('Ctrl+1  Focus note list'),
      Tui.TuiElementBuilders.MakeLabel('Ctrl+2  Focus editor'),
      Tui.TuiElementBuilders.MakeLabel('Enter   Open selected note'),
      Tui.TuiElementBuilders.MakeLabel('Alt+X   Quit Notes'),
      Tui.TuiElementBuilders.MakeLabel('Arrows  Move between dialog buttons'),
      Tui.TuiElementBuilders.MakeLabel('Esc     Close an overlay'),
      Tui.TuiElementBuilders.MakeDefaultButton(
        Tui.TuiControlId.Create(Actions.HelpCloseControl),
        'Close',
        'C',
        Tui.TuiAction.Create(Actions.CloseOverlayAction)
      )
    ]
  );
end function;

function QuitOverlay(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    'Unsaved changes', [
      Tui.TuiElementBuilders.MakeLabel('Save the current note before quitting?'),
      Tui.TuiElementBuilders.MakeDefaultButton(
        Tui.TuiControlId.Create(Actions.SaveAndQuitControl),
        'Save and quit',
        'S',
        Tui.TuiAction.Create(Actions.SaveAndQuitAction)
      ),
      Tui.TuiElementBuilders.MakeButtonWithMnemonic(
        Tui.TuiControlId.Create(Actions.DiscardAndQuitControl),
        'Discard',
        'D',
        Tui.TuiAction.Create(Actions.DiscardAndQuitAction)
      ),
      Tui.TuiElementBuilders.MakeButtonWithMnemonic(
        Tui.TuiControlId.Create(Actions.CancelQuitControl),
        'Cancel',
        'C',
        Tui.TuiAction.Create(Actions.CloseOverlayAction)
      )
    ]
  );
end function;

function ErrorOverlay(State: Model.NotesModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    'Could not save note', [
      Tui.TuiElementBuilders.MakeLabel(State.ErrorMessage),
      Tui.TuiElementBuilders.MakeDefaultButton(
        Tui.TuiControlId.Create(Actions.ErrorCloseControl),
        'Close',
        'C',
        Tui.TuiAction.Create(Actions.CloseOverlayAction)
      )
    ]
  );
end function;

const HelpView: Tui.TuiElement := HelpOverlay();
const QuitView: Tui.TuiElement := QuitOverlay();

function Overlay(State: Model.NotesModel): Tui.TuiElement;
begin
  case State.Overlay of
    when Model.NotesOverlay.Commands:
      begin
        return CommandOverlay(State);
      end;
    when Model.NotesOverlay.Help:
      begin
        return HelpView;
      end;
    when Model.NotesOverlay.QuitConfirmation:
      begin
        return QuitView;
      end;
    when Model.NotesOverlay.SaveFailure:
      begin
        return ErrorOverlay(State);
      end;
    when Model.NotesOverlay.Closed:
      begin
        return Tui.TuiElementBuilders.MakeEmpty();
      end;
  end case;
end function;

function MainFocus(State: Model.NotesModel): integer;
begin
  if State.Width < 65 then
    begin
      if State.Pane = Model.NotesPane.List then
        begin
          if (State.Focus = Actions.SearchControl) or (State.Focus = Actions.ListControl) then
            begin
              return State.Focus;
            end;
          end if;

          return Actions.SearchControl;
        end;
      end if;

      if (State.Selected >= 0) and (State.Selected < State.Notes.Length()) then
        begin
          if (State.Focus >= Actions.TitleControl) and (State.Focus <= Actions.BodyControl) then
            begin
              return State.Focus;
            end;
          end if;

          return Actions.BodyControl;
        end;
      end if;
    end;
  else
    begin
      if (State.Focus = Actions.SearchControl) or (State.Focus = Actions.ListControl) then
        begin
          return State.Focus;
        end;
      end if;

      if ((State.Selected >= 0) and (State.Selected < State.Notes.Length()))
        and
        ((State.Focus >= Actions.TitleControl) and (State.Focus <= Actions.BodyControl))
      then
        begin
          return State.Focus;
        end;
      end if;

      if (State.Selected >= 0) and (State.Selected < State.Notes.Length()) then
        begin
          return Actions.BodyControl;
        end;
      end if;
    end;
  end if;

  return Actions.SearchControl;
end function;

function OverlayFocus(State: Model.NotesModel): integer;
begin
  case State.Overlay of
    when Model.NotesOverlay.Commands:
      begin
        if ((State.Focus = Actions.NewNoteControl) or (State.Focus = Actions.HelpControl))
          or
          (State.Focus = Actions.CommandsCloseControl)
        then
          begin
            return State.Focus;
          end;
        end if;

        if ((State.Selected >= 0) and (State.Selected < State.Notes.Length()))
          and
          (
            (State.Focus >= Actions.SaveNoteControl)
            and
            (State.Focus <= Actions.ArchiveNoteControl)
          )
        then
          begin
            return State.Focus;
          end;
        end if;

        return Actions.NewNoteControl;
      end;
    when Model.NotesOverlay.Help:
      begin
        return Actions.HelpCloseControl;
      end;
    when Model.NotesOverlay.QuitConfirmation:
      begin
        if (State.Focus >= Actions.SaveAndQuitControl)
          and
          (State.Focus <= Actions.CancelQuitControl)
        then
          begin
            return State.Focus;
          end;
        end if;

        return Actions.SaveAndQuitControl;
      end;
    when Model.NotesOverlay.SaveFailure:
      begin
        return Actions.ErrorCloseControl;
      end;
    when Model.NotesOverlay.Closed:
      begin
        return MainFocus(State);
      end;
  end case;
end function;

// Builds the responsive Notes element tree for one model state.
public function NotesView(State: Model.NotesModel): Tui.TuiElement;
begin
  if (State.Width < 50) or (State.Height < 14) then
    begin
      return Tui.TuiElementBuilders.MakeDesktop(
        None, [
          Tui.TuiElementBuilders.MakePanel(
            'Notes', [
              Tui.TuiElementBuilders.MakeLabel('Terminal too small'),
              Tui.TuiElementBuilders.MakeLabel('Use at least 50 × 14 cells.')
            ]
          )
        ]
      );
    end;
  end if;
  var Children: array of Tui.TuiElement := [
    Tui.TuiElementBuilders.MakeColumn([
      Panes.Header(State),
      Panes.Expanding(Panes.MainContent(State), 1),
      Panes.Status(State)
    ])
  ];
  if State.Overlay <> Model.NotesOverlay.Closed then
    begin
      Children.PushInPlace(Overlay(State));
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(
    Some(Tui.TuiControlId.Create(OverlayFocus(State))),
    Children
  );
end function;
end unit;
