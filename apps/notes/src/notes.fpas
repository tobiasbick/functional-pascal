program Notes;

uses Notes.Model as Model;
uses Notes.Repository as Repository;
uses Notes.Theme as Theme;
uses Notes.Update as Update;
uses Notes.View as View;
uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Random as Random;
uses Std.Tui as Tui;

function NotesDirectory(): string;
begin
  if Args.ParamCount() > 0 then
    begin
      return Args.ParamStr(0);
    end;
  end if;

  return 'notes';
end function;

begin
  Random.Randomize();
  var Directory: string := NotesDirectory();
  case Repository.NotesLoadDirectory(Directory) of
    when Result.Ok(const Loaded):
      begin
        mutable var Initial: Model.NotesModel := Model.NotesModelCreate(Directory, Loaded);
        Initial.Width := Console.ScreenWidth();
        Initial.Height := Console.ScreenHeight();
        discard Tui.TuiApplication.RunWithPalette(Initial, Update.NotesUpdate, View.NotesView, Theme.NotesPalette());
      end;
    when Result.Error(const Message):
      begin
        Console.WriteLn('Could not open notes: ' + Message);
      end;
  end case;
end program;
