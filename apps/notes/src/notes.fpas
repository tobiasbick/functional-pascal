program Notes;

uses
  Notes.Model as Model, Notes.Repository as Repository, Notes.Theme as Theme, Notes.Update as Update,
  Notes.View as View, Std.Os.Args as Args, Std.Console as Console, Std.Math.Random as Random,
  Std.Ui.Terminal as Tui;

function NotesDirectory(): string;
begin
  if Args.ParamCount() > 0 then
    begin
      return Args.ParamStr(0);
    end;
  end if;

  return 'notes';
end function;

begin
  Random.Randomize();
  const Directory: string := NotesDirectory();
  case Repository.NotesLoadDirectory(Directory) of
    when Ok(const Loaded):
      begin
        var Initial: Model.NotesModel := Model.NotesModelCreate(Directory, Loaded);
        Initial.Width := Console.ScreenWidth();
        Initial.Height := Console.ScreenHeight();
        discard Tui.TuiApplication.RunWithPalette(
          Initial,
          Update.NotesUpdate,
          View.NotesView,
          Theme.NotesPalette()
        );
      end;
    when Error(const Message):
      begin
        Console.WriteLn('Could not open notes: ' + Message);
      end;
  end case;
end.
