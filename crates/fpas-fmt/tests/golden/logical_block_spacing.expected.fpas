program T;

type
  Point = record
    X: integer;
    Y: integer;
  end record;

begin
  var A: Point := record
    X := 3;
    Y := 4;
  end;
  var B: Point := record
    X := 10;
    Y := 20;
  end;
  var UpdatedB: Point := B with X := 11; end;

  A.Print();
  if Ready then
    Save();
  end if;

  // present result
  Present();
  if NeedsCount then
    Prepare();
  end if;
  var Count: integer := 1;
  WriteLn(Count);
  if Done then
    Finish();
  end if;
end.
