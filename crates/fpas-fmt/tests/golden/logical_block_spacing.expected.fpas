program T;

type Point = record
  X: integer;
  Y: integer;
end record;

begin
  const A: Point := Point(X := 3, Y := 4);
  const B: Point := Point(X := 10, Y := 20);
  const UpdatedB: Point := B with X := 11; end with;

  A.Print();
  if Ready then
    Save();
  end if;

  // present result
  Present();
  if NeedsCount then
    Prepare();
  end if;
  const Count: integer := 1;
  WriteLn(Count);
  if Done then
    Finish();
  end if;
end.
