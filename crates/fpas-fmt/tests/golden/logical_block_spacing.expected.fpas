program T;

type Point = record
  X: integer;
  Y: integer;
end record;

begin
  const A: Point := record
    X := 3;
    Y := 4;
  end;
  const B: Point := record
    X := 10;
    Y := 20;
  end;
  const UpdatedB: Point := B with X := 11; end with;

  A.Print();
  if Ready then
    Save();
  end if;

  // present result
  Present();
  if NeedsCount then
    Prepare();
  end if;
  const Count: integer := 1;
  WriteLn(Count);
  if Done then
    Finish();
  end if;
end.
