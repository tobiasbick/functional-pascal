unit Demo.Counter;

public type Counter = record
  Value: integer;
  public Step: integer;
  public Changed: option of procedure() := None;

  public function Hidden(Self: Counter): integer;
  begin
    return Self.Value;
  end function;

  public static function Create(): Counter;
  begin
    return Counter(Value := 0, Step := 1);
  end function;
end record;
end unit;
