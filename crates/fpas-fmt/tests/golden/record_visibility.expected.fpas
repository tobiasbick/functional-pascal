unit Demo.Counter;

public type
  Counter = record
    Value: integer;
    public Step: integer;

    function Hidden(Self: Counter): integer;
    begin
      return Self.Value
    end;

    public static function Create(): Counter;
    begin
      return record
        Value := 0;
        Step := 1;
      end
    end;

    public property Current: integer read Hidden;

    public event Changed: procedure() read ReadChanged write WriteChanged;
  end;
