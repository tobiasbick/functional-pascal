unit MyApp.Utils;

uses Std.Math as Math;

public function Clamp(Value: integer; Min: integer; Max: integer): integer;
begin
  if Value < Min then
    return Min;
  else
    if Value > Max then
      return Max;
    else
      return Value;
    end if;
  end if;
end function;

function IsBlank(S: string): boolean;
begin
  return Length(Trim(S)) = 0;
end function;

end unit;
