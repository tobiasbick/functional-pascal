program PublicationMemory;

uses Std.Ai.Mcp as Mcp, Std.Tasks as Tasks, Std.Os.Args as Args;

function Publish(Server: Mcp.Server; Started: channel of boolean): integer;
begin
  var Text := 'abcdefgh'.RepeatStr(8192);
  var Current: function(): integer := function(): integer begin
    return 0;
  end function;

  Current := function(): integer begin
    if Text.Length() < 0 then
      return Current();
    end if;

    return Text.Length();
  end function;
  const Keep := Current;
  const Unused := Tasks.TimerCase(
    3600000, procedure() begin
      discard Keep();
    end procedure
  );
  discard Tasks.Send(Started, true).Unwrap();
  const Endpoints := [0].Map(
    function(Index: integer): integer begin
      const Endpoint := Mcp.Publish(Server, Mcp.DefaultHttpOptions()).Unwrap();
      if Mcp.Access(Endpoint).Unwrap().Url.Length() = 0 then
        panic('missing publication');
      end if;

      discard Mcp.CloseEndpoint(Endpoint).Unwrap();
      return Keep() + Index;
    end function
  );
  return Endpoints[0];
end function;

begin
  const Server := Mcp.Create(Mcp.DefaultLimits()).Unwrap();
  const Started: channel of boolean := Tasks.CreateChannel(1);
  for Attempt: integer := 1 to 1 do
    scope
      const Pending := go Publish(Server, Started);
      if not Tasks.Receive(Started).Unwrap() then
        panic('publication not started');
      end if;

      if Args.ParamStr(0) = 'scope_exit' then
        break;
      end if;

      if Tasks.Wait(Pending) <> 65536 then
        panic('publication callback');
      end if;
    end scope;
  end for;

  discard Tasks.CloseChannel(Started);
  discard Mcp.Release(Server).Unwrap();
end.
