program NetworkPoolConfiguration;

uses
  Std.Net.Sockets as Net, Std.Tasks as Tasks, Std.Console as Console,
  Std.Os.Args as Args;

function Cycle(): function(): integer;
begin
  var Text := 'abcdefgh'.RepeatStr(8192);
  var Current: function(): integer := function(): integer begin
    return 0;
  end function;

  Current := function(): integer begin
    if Text.Length() < 0 then
      return Current();
    end if;

    return Text.Length();
  end function;

  return Current;
end function;

function Receive(Connection: Net.Connection; Ready: channel of boolean): integer;
begin
  discard Tasks.Send(Ready, true);
  const Bytes := Net.ReceiveBytes(Connection, 1).Unwrap();
  if (Bytes.Length() <> 1) or (Bytes[0] <> 9) then
    panic('configuration peer bytes');
  end if;

  return 1;
end function;

function Configure(Connection: Net.Connection; Ready: channel of boolean): integer;
begin
  const Keep := Cycle();
  const Unused := Tasks.TimerCase(
    3600000, procedure() begin
      discard Keep();
      panic('unused configuration callback');
    end procedure
  );
  var Count := 0;
  const Results := [0].Map(
    function(Index: integer): integer begin
      Console.WriteText('locked');
      discard Tasks.Send(Ready, true);
      discard Net.SetTimeout(Connection, 5000).Unwrap();
      const Listener := Net.Listen('localhost', 0).Unwrap();
      if Net.ListenerLocalAddress(Listener).Unwrap().Port <= 0 then
        panic('configured listener address');
      end if;

      discard Net.CloseListener(Listener).Unwrap();
      Count := Count + Keep() + Index;
      return Count;
    end function
  );
  return Results[0];
end function;

function Trigger(Peer: Net.Connection; Mode: string): integer;
begin
  Console.WriteText('pending');
  if Mode = 'normal' then
    if Net.SendBytes(Peer, [9]).Unwrap() <> 1 then
      panic('configuration peer send');
    end if;
  end if;

  return 2;
end function;

begin
  const Mode := Args.ParamStr(0);
  const Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address := Net.ListenerLocalAddress(Listener).Unwrap();
  const Peer := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  const Connection := Net.Accept(Listener).Unwrap();
  const Ready: channel of boolean := Tasks.CreateChannel(1);
  const Configuring: channel of boolean := Tasks.CreateChannel(1);
  for Attempt: integer := 1 to 1 do
    scope
      const Reading := go Receive(Connection, Ready);
      discard Tasks.Receive(Ready).Unwrap();
      const Changed := go Configure(Connection, Configuring);
      discard Tasks.Receive(Configuring).Unwrap();
      const Triggered := go Trigger(Peer, Mode);
      if Tasks.Wait(Triggered) <> 2 then
        panic('configuration trigger');
      end if;

      if Mode <> 'normal' then
        break;
      end if;

      if Tasks.Wait(Reading) <> 1 then
        panic('configuration reader');
      end if;

      if Tasks.Wait(Changed) <> 65536 then
        panic('configuration callback');
      end if;
    end scope;
  end for;

  discard Net.SetTimeout(Connection, 5000).Unwrap();
  discard Net.Close(Connection).Unwrap();
  discard Net.Close(Peer).Unwrap();
  discard Net.CloseListener(Listener).Unwrap();
end.
