program NetworkPoolControl;

uses Std.Net.Sockets as Net, Std.Tasks as Tasks, Std.Console as Console, Std.Os.Args as Args;

function Cycle(): function(): integer;
begin
  var Text := 'abcdefgh'.RepeatStr(8192);
  var Current: function(): integer := function(): integer begin
    return 0;
  end function;

  Current := function(): integer begin
    if Text.Length() < 0 then
      return Current();
    end if;

    return Text.Length();
  end function;

  return Current;
end function;

function WaitForInput(Listener: Net.Listener; Connection: option of Net.Connection; Token: Tasks.CancellationToken; Mode: string): integer;
begin
  const Keep := Cycle();
  const Unused := Tasks.TimerCase(
    3600000, procedure() begin
      discard Keep();
      panic('unused network callback ran');
    end procedure
  );
  if Keep() <> 65536 then
    panic('capture before wait');
  end if;

  if Mode = 'accept_cancel' then
    const Outcome := Net.AcceptWithCancellation(Listener, Token);
    if not (Outcome is Error(Net.NetError.Cancelled(_))) then
      panic('accept cancellation');
    end if;
  elsif Mode = 'accept_close' then
    const Outcome := Net.Accept(Listener);
    if not (Outcome is Error(Net.NetError.Closed(_))) then
      panic('listener close');
    end if;
  elsif Mode = 'timeout' then
    const Outcome := Net.ReceiveBytes(Connection.Unwrap(), 1);
    if not (Outcome is Error(Net.NetError.Timeout(_))) then
      panic('read timeout');
    end if;
  else
    const Outcome := Net.ReceiveBytesWithCancellation(Connection.Unwrap(), 1, Token);
    if not (Outcome is Error(Net.NetError.Cancelled(_))) then
      panic('read cancellation');
    end if;
  end if;

  if Keep() <> 65536 then
    panic('capture after wait');
  end if;

  return 1;
end function;

function Trigger(Source: Tasks.CancellationSource; Listener: Net.Listener; Mode: string): integer;
begin
  // The host verifies that the other task has a native operation pending here.
  Console.WriteText('pending');
  if Mode = 'scope_exit' then
    return 2;
  end if;

  if Mode = 'accept_close' then
    discard Net.CloseListener(Listener).Unwrap();
  else
    discard Tasks.Cancel(Source);
  end if;

  return 2;
end function;

begin
  const Mode := Args.ParamStr(0);
  const Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address := Net.ListenerLocalAddress(Listener).Unwrap();
  const Source := Tasks.CreateCancellationSource();
  const Token := Tasks.GetCancellationToken(Source);
  var Connection: option of Net.Connection := None;
  var Peer: option of Net.Connection := None;
  if (Mode = 'read_cancel') or (Mode = 'timeout') or (Mode = 'scope_exit')
    or
    (Mode = 'vm_shutdown')
  then
    Peer := Some(Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap());
    Connection := Some(Net.Accept(Listener).Unwrap());
    if Mode = 'timeout' then
      discard Net.SetTimeout(Connection.Unwrap(), 50).Unwrap();
    end if;
  end if;

  for Attempt: integer := 1 to 1 do
    scope
      const Waiting := go WaitForInput(Listener, Connection, Token, Mode);
      if Mode <> 'timeout' then
        const Changed := go Trigger(Source, Listener, Mode);
        if Tasks.Wait(Changed) <> 2 then
          panic('trigger result');
        end if;
      end if;

      if Mode = 'scope_exit' then
        break;
      end if;

      if Tasks.Wait(Waiting) <> 1 then
        panic('waiting result');
      end if;
    end scope;
  end for;

  if (Mode = 'read_cancel') or (Mode = 'timeout') or (Mode = 'scope_exit') then
    discard Net.SetTimeout(Connection.Unwrap(), 5000).Unwrap();
    if Net.SendBytes(Peer.Unwrap(), [9]).Unwrap() <> 1 then
      panic('fresh send');
    end if;
    const Bytes := Net.ReceiveBytes(Connection.Unwrap(), 1).Unwrap();
    if (Bytes.Length() <> 1) or (Bytes[0] <> 9) then
      panic('connection not reusable');
    end if;

    discard Net.Close(Connection.Unwrap()).Unwrap();
    discard Net.Close(Peer.Unwrap()).Unwrap();
  elsif Mode = 'accept_cancel' then
    const Client := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
    const Accepted := Net.Accept(Listener).Unwrap();
    discard Net.Close(Accepted).Unwrap();
    discard Net.Close(Client).Unwrap();
  end if;

  if Mode <> 'accept_close' then
    discard Net.CloseListener(Listener).Unwrap();
  end if;
end.
