(* ================================================================ *)
(* Functional Pascal v1 — Formal Grammar                            *)
(* Notation: ISO 14977 EBNF                                        *)
(*                                                                  *)
(*   =    definition       ;    end of rule                         *)
(*   |    alternation      [ ]  optional (0 or 1)                   *)
(*   { }  repetition       ( )  grouping                            *)
(*   '…'  terminal string  (* … *)  comment                        *)
(*                                                                  *)
(* Keywords are case-insensitive: 'begin' matches BEGIN, Begin, etc. *)
(*                                                                  *)
(* Normative language behavior: docs/pascal/                        *)
(* This file is the formal syntax annex (lexer + parser shape).       *)
(* ================================================================ *)

(* ================================================================ *)
(* PART 1 — LEXICAL GRAMMAR                                        *)
(* ================================================================ *)

(* ---- Characters ------------------------------------------------ *)

letter          = 'A' .. 'Z' | 'a' .. 'z' | '_' ;
digit           = '0' .. '9' ;
hex_digit       = digit | 'A' .. 'F' | 'a' .. 'f' ;

(* ---- Identifiers ----------------------------------------------- *)

identifier      = letter { letter | digit } ;

(* Case-insensitive: Foo, foo, FOO all refer to the same name.     *)
(* No maximum length.                                               *)

(* ---- Number Literals ------------------------------------------- *)

decimal_digits  = digit { [ '_' ] digit } ;
hex_digits      = hex_digit { [ '_' ] hex_digit } ;

integer_literal = decimal_digits
                | '$' hex_digits ;

real_literal    = decimal_digits '.' decimal_digits [ exponent ] ;
exponent        = ( 'e' | 'E' ) [ '+' | '-' ] decimal_digits ;

(* Digits required on BOTH sides of '.': 0.5 is valid, .5 is not.  *)
(* Negative numbers are unary minus applied to a literal: -42.      *)
(* Exactly one '_' between digits: 1_000 is valid, 1__2 is not.    *)
(* Non-zero reals that underflow to 0.0 are rejected as out of range. *)
(* A leading UTF-8 BOM (U+FEFF) is skipped as trivia, like whitespace. *)
(* Identifiers are ASCII only (see `letter` / `identifier` above).  *)

(* ---- String Literals ------------------------------------------- *)

string_literal  = string_element { string_element } ;
string_element  = quoted_string | char_code ;

quoted_string   = "'" { string_char | "''" } "'" ;
string_char     = (* any character except unescaped single quote *) ;

char_code       = '#' decimal_digits ;

(* Strings may span multiple lines.                                 *)
(* Doubled apostrophe is the escape for a literal quote: 'It''s'.   *)
(* Char codes use decimal byte values: #65 = 'A', #13#10 = CR+LF.  *)
(* Adjacent elements auto-concatenate: 'Hello'#13#10'World'.        *)
(* No maximum length.                                               *)

(* ---- Comments (discarded by lexer) ----------------------------- *)

line_comment    = '//' { (* any character except CR or LF *) } ;

(* A line comment ends at LF, CRLF, bare CR, or end of input.        *)
(* Brace and parenthesis-star forms are not comment syntax.          *)
(* A `{` immediately followed by `$` (`{$...}`) is invalid too:     *)
(* the lexer reports a compiler-directive error for that sequence.   *)
(* There are no                                                       *)
(* compiler directives or source-level include forms in the language. *)
(* A contiguous standalone comment block immediately before a       *)
(* declaration is Markdown documentation; this is a tooling rule.    *)

(* ---- Keywords (case-insensitive) ------------------------------- *)

keyword         = 'program'   | 'unit'      | 'uses'      | 'const'
                | 'var'   | 'function'  | 'procedure'
                | 'begin'     | 'end'       | 'return'    | 'if'
                | 'then'      | 'else'      | 'case'      | 'of'
                | 'for'       | 'to'        | 'downto'    | 'in'
                | 'do'        | 'while'     | 'repeat'    | 'until'
                | 'and'       | 'or'        | 'not'       | 'xor'
                | 'div'       | 'mod'
                | 'true'      | 'false'     | 'type'      | 'record'
                | 'enum'      | 'array'     | 'panic'
                | 'break'     | 'continue'  | 'result'    | 'option'
                | 'ok'        | 'error'     | 'some'      | 'none'
                | 'try'       | 'public'
                | 'go'        | 'dict'      | 'with'      | 'static'
                | 'event'     | 'read'      | 'write'     | 'comparable'
                | 'numeric'   | 'printable' | 'self'      | 'nil'
                | 'channel'   | 'task'
                | 'elsif'     | 'when'      | 'null' ;

(* ---- Symbols --------------------------------------------------- *)

symbol          = ':=' | '..' | '<>' | '<=' | '>='
                | ':'  | ';'  | ','  | '.'  | '('  | ')'  | '['  | ']'
                | '+'  | '-'  | '*'  | '/'  | '='  | '<'  | '>' ;

(* ---- Token ----------------------------------------------------- *)

token           = keyword | identifier | integer_literal
                | real_literal | string_literal | symbol ;

(* Keywords take priority over identifiers.                         *)
(* ':=' takes priority over ':' followed by '='.                    *)
(* '..' takes priority over '.' followed by '.'.                    *)
(* '<=' and '>=' take priority over '<'/'>' followed by '='.        *)
(* '<>' takes priority over '<' followed by '>'.                    *)

(* ================================================================ *)
(* PART 2 — SYNTACTIC GRAMMAR                                      *)
(* ================================================================ *)

(* Every statement ends with ';', including named control endings. *)
(* A final ';' is required before 'end', 'elsif', 'when', 'else', or 'until'. *)

(* ---- 2.1 Program / Unit Structure ------------------------------ *)

compilation_unit    = program | unit ;

program             = program_heading
                      [ uses_clause ]
                      { program_declaration }
                      main_block '.' ;

program_heading     = 'program' identifier ';' ;

unit                = unit_heading
                      [ uses_clause ]
                      { unit_declaration } 'end' 'unit' ';' ;

unit_heading        = 'unit' qualified_id ';' ;

(* Units have no main block. They contain declarations only.        *)

(* uses_clause: each import_entry names a unit to import. Plain imports bring public symbols into
   scope under their short (unqualified) name. If two units export the same short name, the name is
   ambiguous and the compiler reports an error at the point of use (not at the uses site). The fully
   qualified name works for a plain import. An aliased import exposes public symbols only through
   Alias.Name, without short names or access through the original path. Each unit occurs at most
   once per file's direct imports, comparing names case-insensitively. `as` is contextual immediately
   after the imported unit name, not a reserved keyword. User-defined project and library units may use qualified
   names but must not use `Std` as their leading segment. Intrinsic standard-library units use
   two-part names such as `Std.Console`. The trusted source-standard-library manifest may additionally
   export multi-segment `Std.*` units such as `Std.Tools.Format`; applications may import only the
   units exported by that manifest. Unknown or non-exported `Std.*` units are rejected. *)

uses_clause         = 'uses' import_entry { ',' import_entry } ';' ;
import_entry        = qualified_id [ 'as' identifier ] ;

main_block          = 'begin' statement_list 'end' ;

(* ---- 2.2 Declarations ----------------------------------------- *)

program_declaration = const_declaration
                    | var_declaration
                    | type_declaration
                    | function_decl
                    | procedure_decl ;

unit_declaration    = [ public_modifier ] program_declaration ;

public_modifier     = 'public' ;

(* Unit declarations are private unless marked `public`. The same rule *)
(* applies to every member of a record declared in a unit. `public` is *)
(* not valid in `program` files. `private` is an ordinary identifier. *)

(* Each declaration repeats its keyword; `public` applies to one     *)
(* declaration only. Local statement bindings repeat `var`   *)
(* in full. Local const bindings are allowed; local types are not.  *)

(* -- Constants -- *)
const_declaration       = 'const' const_def ;
const_def           = identifier ':' type_expr ':=' expression ';' ;

(* A const binding is immutable and permits a runtime initializer.   *)
(* Local initialization occurs whenever its declaration is reached. *)
(* Calls and computed dependencies remain computed independently of *)
(* optimization; static forms require compile-time-known operands.   *)

(* -- Imvariables -- *)
var_declaration         = 'var' var_def ;
var_def             = identifier ':' type_expr ':=' expression ';' ;

(* -- Mutable variables -- *)

(* -- Type definitions -- *)
type_declaration        = 'type' type_def ;
type_def            = identifier '=' type_body ';' ;
type_body           = record_type
                    | enum_type
                    | type_expr ;

type_params         = '<' type_param { ',' type_param } '>' ;
type_param          = identifier [ ':' constraint_name ] ;
constraint_name     = 'Comparable' | 'Numeric' | 'Printable' ;

(* ---- 2.3 Type Expressions ------------------------------------- *)

(* Built-in named types (via qualified_id): integer, real, boolean, *)
(* string. A bare `task` infers its result type from the spawned call; *)
(* `task of T` declares it. See docs/pascal/language/basics/ and       *)
(* docs/pascal/language/concurrency/task-handles.md.                   *)

type_expr           = 'array' 'of' type_expr            (* array type     *)
                    | 'channel' 'of' type_expr          (* channel type   *)
                    | 'task' [ 'of' type_expr ]         (* task handle    *)
                    | 'dict' 'of' type_expr 'to' type_expr (* dict type    *)
                    | 'result' 'of' type_expr ',' type_expr  (* result type *)
                    | 'option' 'of' type_expr            (* option type    *)
                    | function_type                      (* function type  *)
                    | procedure_type                     (* procedure type *)
                    | qualified_id ;   (* named / built-in / user type     *)

function_type       = 'function' '(' [ formal_type_list ] ')' ':' type_expr ;
procedure_type      = 'procedure' '(' [ formal_type_list ] ')' ;

formal_type_list    = formal_type_param { ';' formal_type_param } ;
formal_type_param   = [ 'var' ] identifier ':' type_expr ;

(* ---- 2.4 Record & Enum Types ---------------------------------- *)

record_type         = 'record'
                      { record_member }
                      'end' 'record' ;
record_member       = [ public_modifier ]
                      ( field_def | record_method | record_event ) ;
field_def           = identifier ':' type_expr [ ':=' expression ] ';' ;

(* ':= expression' is an optional default value for the field.      *)
(* When a record construction omits a field that has a default,    *)
(* the compiler substitutes the default automatically.  Fields      *)
(* without a default must be supplied in every construction.        *)

record_method       = static_record_method | instance_record_method ;
static_record_method = 'static' ( function_decl | procedure_decl ) ;
instance_record_method = instance_function_decl | instance_procedure_decl ;
instance_function_decl = instance_function_heading ';'
                         { nested_decl } 'begin' statement_list 'end' 'function' ';' ;
instance_function_heading = 'function' identifier [ type_params ]
                            '(' [ instance_param_list ] ')' ':' type_expr ;
instance_procedure_decl = instance_procedure_heading ';'
                          { nested_decl } 'begin' statement_list 'end' 'procedure' ';' ;
instance_procedure_heading = 'procedure' identifier [ type_params ]
                             '(' [ instance_param_list ] ')' ;
instance_param_list = instance_first_param { ';' param_group } ;
instance_first_param = ( 'self' | identifier ) ':' type_expr ;

(* Record member visibility is available only in unit files. The    *)
(* modifier is written before each field, event, or routine;          *)
(* there are no visibility sections.                                 *)

(* Instance record methods must declare Self as the first parameter, *)
(* typed as the enclosing record. Callers use value dot notation;    *)
(* Self is passed implicitly: A.DistanceTo(B) → Point.DistanceTo(A, B). *)
(*                                                                   *)
(* `static function` has no Self parameter and is called through the *)
(* type: Point.Create(X, Y). Static procedures likewise have no Self *)
(* parameter and are called as statements through the type.          *)
(* Static and instance names share one case-insensitive name set.    *)
(* Record methods may declare their own type_params via the shared   *)
(* function_decl / procedure_decl grammar.                           *)

(* Event accessors are instance methods; `read` and `write` are       *)
(* reserved keywords. Both accessors deal in Option of HandlerType.   *)
(* See docs/pascal/language/types/record-events.md.                    *)
(* Events require both accessors in fixed read-then-write order.     *)
record_event        = 'event' identifier ':' type_expr
                      'read' identifier 'write' identifier ';' ;

enum_type           = 'enum' enum_member { enum_member } 'end' 'enum' ;
enum_member         = identifier [ enum_fields | '=' integer_literal ] ';' ;
enum_fields         = '(' enum_field { ';' enum_field } ')' ;
enum_field          = identifier ':' type_expr ;

(* Parentheses require at least one field, and ';' separates fields. *)
(* Empty field lists and trailing field separators are invalid.     *)
(* Variants may carry associated data (enum_fields) OR an explicit  *)
(* backing value, but not both. Fieldless variants in a data enum   *)
(* are constructed without parentheses: Shape.Point.                *)

(* ---- 2.5 Functions & Procedures -------------------------------- *)

function_decl       = function_heading ';'
                      { nested_decl } 'begin' statement_list 'end' 'function' ';' ;

function_heading    = 'function' identifier [ type_params ]
                      '(' [ param_list ] ')' ':' type_expr ;

procedure_decl      = procedure_heading ';'
                      { nested_decl } 'begin' statement_list 'end' 'procedure' ';' ;

procedure_heading   = 'procedure' identifier [ type_params ]
                      '(' [ param_list ] ')' ;

param_list          = param_group { ';' param_group } ;
(* `var` declares a parameter that changes the caller's variable.     *)
(* Documentation: docs/pascal/language/functions/var-parameters.md    *)
param_group         = [ 'var' ] identifier ':' type_expr ;

nested_decl         = function_decl
                    | procedure_decl ;

(* ---- 2.6 Statements ------------------------------------------- *)

statement_list      = { statement } ;

statement           = ( simple_statement | if_stmt | for_stmt
                      | for_in_stmt | while_stmt ) ';' ;

(* Branch and loop bodies are nonempty scoped statement lists. *)
control_body        = statement { statement } ;

simple_statement    = block
                    | null_stmt
                    | const_stmt
                    | var_stmt
                    | assignment_stmt
                    | return_stmt
                    | discard_stmt
                    | panic_stmt
                    | case_stmt
                    | repeat_stmt
                    | break_stmt
                    | continue_stmt
                    | go_stmt
                    | call_stmt
                    | postfix_expr_stmt ;

block               = 'begin' statement_list 'end' ;
null_stmt           = 'null' ;

(* Plain blocks retain a nested scope and may be empty. A branch or *)
(* loop body that does nothing is written as 'null;'. Conditions and *)
(* loop bounds use the enclosing scope; body locals do not escape.  *)

(* -- Inline binding declarations -- *)
const_stmt          = 'const' identifier ':' type_expr ':=' expression ;
var_stmt            = 'var' identifier ':' type_expr ':=' expression ;

(* -- Assignment -- *)
assignment_stmt     = designator ':=' expression ;

(* -- Return -- *)
return_stmt         = 'return' [ expression ] ;

(* In functions, 'return expr' sets the return value and exits.     *)
(* In procedures, bare 'return' exits without a value.              *)

(* -- Discard -- *)
(* Documentation: docs/pascal/language/functions/discard.md *)
discard_stmt        = 'discard' expression ;

(* -- Panic -- *)
panic_stmt          = 'panic' '(' expression ')' ;

(* -- If / Then / Else -- *)
if_stmt             = 'if' expression 'then' control_body
                      { 'elsif' expression 'then' control_body }
                      [ 'else' control_body ] 'end' 'if' ;

(* 'elsif' continues this conditional. 'else if' starts a nested    *)
(* conditional with a separate 'end if;'. Named endings determine  *)
(* branch ownership without nearest-unmatched-if inference.        *)

(* -- Case / Of -- *)
case_stmt           = 'case' expression 'of'
                      case_arm { case_arm }
                      [ 'else' control_body ]
                      'end' 'case' ;

case_arm            = 'when' case_label_list [ 'if' expression ] ':' control_body ;
case_label_list     = case_label { ',' case_label } ;
case_label          = destructure_label                  (* Result/Option  *)
                    | enum_pattern                       (* enum with data *)
                    | expression [ '..' expression ] ;  (* value/range    *)

destructure_label   = ( 'ok' | 'error' | 'some' ) '(' identifier ')'
                    | 'none' ;

enum_pattern        = qualified_id '(' pattern_arg { ',' pattern_arg } ')'
                    | qualified_id ;                     (* fieldless variant *)

pattern_arg         = identifier ;                       (* binding only   *)

(* Each field position in an enum pattern is a plain identifier binding. *)
(* Use a guard clause for additional constraints:                       *)
(*   Shape.Circle(R) if R > 10.0: ...                                *)
(*                                                                  *)
(* Value labels must be compile-time constants: integer,      *)
(* string, boolean, or enum literals. Ranges use '..'.              *)
(* Both range endpoints must be compile-time constants as well.    *)
(* Calls, variables, and computed const dependencies are rejected. *)
(* Put dynamic conditions in guards; enum/Option/Result patterns   *)
(* retain their binding rules.                                    *)
(*                                                                  *)
(* Semantic disambiguation for guarded scalar bindings: in a scalar  *)
(* case arm, `when Name if <boolean>:` binds the scrutinee to `Name` *)
(* when the arm has exactly one bare identifier label and `Name`    *)
(* does not resolve to any const binding or enum member.      *)
(* This shorthand is not valid for ranges or comma-separated label  *)
(* lists.                                                           *)
(* Destructure labels bind the inner value of Result/Option.        *)
(* Enum patterns match a variant and bind its fields positionally:  *)
(* Shape.Circle(R) binds Radius to R.                               *)
(*                                                                  *)
(* Guard clause ('if' expression) on an arm: the arm matches only   *)
(* when the label matches AND the guard evaluates to true. The      *)
(* guard expression may reference bindings introduced by the label. *)
(* Guards do NOT count toward exhaustiveness: a guarded arm for a   *)
(* variant does not satisfy coverage of that variant.               *)
(* Each arm, including 'else', has a local scope. Body statements    *)
(* require ';' and cannot be empty; write 'null;' for no action.     *)
(* Bindings are visible in the guard and the selected body. Body    *)
(* locals are not visible in a guard, another arm, or after 'case'.  *)
(*                                                                  *)
(* Exhaustiveness: for enum, Result, and Option types, every        *)
(* variant must be covered or an 'else' branch must be present.     *)
(* The compiler reports an error for non-exhaustive matches.        *)

(* -- For Loop -- *)
for_stmt            = 'for' identifier ':' type_expr ':=' expression
                      ( 'to' | 'downto' ) expression
                      'do' control_body 'end' 'for' ;

(* -- For-In Loop -- *)
(* Works for both array-of-T (yields elements) and dict-of-K-to-V  *)
(* (yields keys in insertion order). Loop variable is immutable.   *)
for_in_stmt         = 'for' identifier ':' type_expr 'in' expression
                      'do' control_body 'end' 'for' ;

(* 'in' is a keyword used by for-in loops and as the membership    *)
(* comparison operator described in section 4.                     *)

(* The loop variable is declared inline and is immutable within     *)
(* the loop body.                                                   *)

(* -- While Loop -- *)
while_stmt          = 'while' expression 'do' control_body 'end' 'while' ;

(* -- Repeat / Until -- *)
repeat_stmt         = 'repeat' control_body 'until' expression ;

(* -- Break / Continue -- *)
break_stmt          = 'break' ;
continue_stmt       = 'continue' ;

(* -- Go (spawn task) -- *)
(* Syntax: same call shape as call_stmt — designator '(' args ')'. *)
(* The parser requires the expression after `go` to be a call (not   *)
(* a bare designator or other expression). Semantics: statement     *)
(* `go` … is fire-and-forget (no handle); expression `go` … has type *)
(* `task` and retains the result for `Std.Tasks.Wait`. See           *)
(* docs/pascal/language/concurrency/README.md.                                   *)
go_call             = designator '(' [ arg_list ] ')' ;
go_stmt             = 'go' go_call ;

(* -- Procedure Call (statement position) -- *)
(* Function results must be consumed or explicitly discarded. *)
call_stmt           = designator '(' [ arg_list ] ')' ;

(* A postfix expression may be used as a statement when semantic analysis *)
(* confirms that its final suffix is a procedure call. Function results    *)
(* require consumption or explicit discard.                               *)
postfix_expr_stmt   = primary_atom postfix_suffix { postfix_suffix } ;

(* ---- 2.7 Expressions ------------------------------------------ *)

(* Operator precedence (highest → lowest):                          *)
(*                                                                  *)
(*   1. call, index, field, with ... end with   postfix              *)
(*   2. unary -, try                           prefix               *)
(*   3. *  /  div  mod                          multiplicative       *)
(*   4. +  -                                   additive             *)
(*   5. =  <>  <  >  <=  >=  in                 non-associative      *)
(*   6. not                                    prefix               *)
(*   7. and, or, xor                           same-operator chains *)

expression          = logical_expr ;

(* Logical operators require boolean operands.                         *)
(* A logical chain contains one operator kind. Parentheses allow mixing. *)
logical_expr        = not_expr [ and_tail | or_tail | xor_tail ] ;
and_tail            = 'and' not_expr { 'and' not_expr } ;
or_tail             = 'or' not_expr { 'or' not_expr } ;
xor_tail            = 'xor' not_expr { 'xor' not_expr } ;
not_expr            = 'not' not_expr | comparison_expr ;

comparison_expr     = additive_expr [ comparison_op additive_expr ] ;
comparison_op       = '=' | '<>' | '<' | '>' | '<=' | '>=' | 'in' ;

(* `in` tests membership: value in array, key in dict, or substring in string. *)

additive_expr       = mult_expr { additive_op mult_expr } ;
additive_op         = '+' | '-' ;

mult_expr           = unary_expr { mult_op unary_expr } ;
mult_op             = '*' | '/' | 'div' | 'mod' ;

unary_expr          = '-' unary_expr
                    | 'try' unary_expr                   (* error propagation *)
                    | primary_expr [ record_update ] ;

record_update       = 'with' field_init { field_init } 'end' 'with' ;

(* record_update is a postfix operator that produces a new record   *)
(* value identical to the base except for the overridden fields.    *)
(* At least one field_init is required. `Value with end with` is invalid. *)
(* The base expression must have a record type. Unknown or wrong-   *)
(* typed field overrides are compile-time errors.                   *)
(* Example: P with X := 10; end with — produces a copy of P with X = 10 *)

(* primary_atom is a complete call/designator/literal. After it, optional       *)
(* postfix suffixes allow chaining on the result: `.Field`, `[Index]`,         *)
(* and `.Method(args)`. Ordinary designators keep field/index inside the path. *)
(* Documentation: docs/pascal/language/functions/README.md                     *)
primary_expr        = primary_atom { postfix_suffix } ;

primary_atom        = native_array_factory
                    | integer_literal
                    | real_literal
                    | string_literal
                    | 'true'
                    | 'false'
                    | 'ok' '(' expression ')'            (* Result Ok      *)
                    | 'error' '(' expression ')'        (* Result Error   *)
                    | 'some' '(' expression ')'          (* Option Some    *)
                    | 'none'                             (* Option None    *)
                    | 'nil'                              (* event clear only; see record-events.md *)
                    | '(' expression ')'
                    | array_literal
                    | dict_literal
                    | 'go' go_call                       (* task handle    *)
                    | closure_expr
                    | designator [ call_args ] ;

(* Anonymous function/procedure expression. Parameter and result types are required. *)
(* Documentation: docs/pascal/language/functions/closures.md *)
closure_expr        = 'function' '(' [ param_list ] ')' ':' type_expr
                        [ nested_decl { nested_decl } ] 'begin' statement_list 'end' 'function'
                    | 'procedure' '(' [ param_list ] ')'
                        [ nested_decl { nested_decl } ] 'begin' statement_list 'end' 'procedure' ;

(* Expression closers have no terminating ';' of their own. An enclosing *)
(* statement, declaration, or field_init supplies its terminator.        *)
(* Arguments end directly before ',' or ')' after their named closer.    *)

(* string.Chr parses as a keyword-owned designator call. array is reserved,
   so its factory has a dedicated primary production. Sema admits only the
   fixed factory names, without explicit generic arguments. *)
native_array_factory = 'array' '.' identifier call_args ;

postfix_suffix      = '.' identifier [ call_args ]
                    | '[' expression ']' ;

(* -- Function call -- *)
call_args           = '(' [ arg_list ] ')' ;

(* -- Record construction -- *)
(* A call whose normally resolved target is a record type or transparent alias. *)
(* This is the named-only semantic subset of designator + call_args above. *)
typed_record_construction = qualified_id '(' [ named_field_argument { ',' named_field_argument } ] ')' ;
named_field_argument = identifier ':=' expression ;
(* Zero named_field_arguments is valid when every field of the      *)
(* target type has a default value: var P: Point := Point();        *)

(* Field override of a record update.                               *)
field_init          = identifier ':=' expression ';' ;

(* A call is fully positional or fully named (FP2016).                *)
(* Documentation: docs/pascal/language/functions/parameters.md        *)
arg_list            = positional_arg { ',' positional_arg }
                    | named_arg { ',' named_arg } ;
positional_arg      = expression | var_arg ;
named_arg           = identifier ':=' ( expression | var_arg ) ;
(* Argument for a `var` parameter: a variable, field, or element.     *)
(* Documentation: docs/pascal/language/functions/var-parameters.md    *)
var_arg             = 'var' designator ;

(* -- Array literal -- *)
array_literal       = '[' [ expression { ',' expression } ] ']' ;

(* -- Dict literal -- *)
dict_literal        = '[' ( ':' ']'                                      (* empty dict [:] *)
                        | expression ':' expression
                          { ',' expression ':' expression } ']' ) ;

(* -- Designator (variable, field, or indexed access) -- *)
(* Index expression '[' expression ']' applies to: array (integer index),
   dict (key of matching type), and string (integer index → string).        *)
designator_root     = identifier | 'self' ;
designator          = designator_root { '.' identifier | '[' expression ']' } ;

(* -- Qualified identifier (for uses, types — no indexing) -- *)
qualified_id        = identifier { '.' identifier } ;

(* ================================================================ *)
(* END OF GRAMMAR                                                   *)
(* ================================================================ *)
