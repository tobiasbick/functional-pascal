{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^(?!\\s*[Ee][Nn][Dd]\\b).*\\b([Bb][Ee][Gg][Ii][Nn]|[Rr][Ee][Cc][Oo][Rr][Dd]|[Ee][Nn][Uu][Mm]|[Rr][Ee][Pp][Ee][Aa][Tt]|[Tt][Hh][Ee][Nn]|[Dd][Oo]|[Ee][Ll][Ss][Ee]|[Ww][Ii][Tt][Hh])\\b\\s*(?://.*)?$|^\\s*[Cc][Aa][Ss][Ee]\\b.*\\b[Oo][Ff]\\s*(?://.*)?$|^\\s*[Ww][Hh][Ee][Nn]\\b.*:\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*([Ee][Nn][Dd]\\b|[Uu][Nn][Tt][Ii][Ll]\\b|[Ee][Ll][Ss][Ee]\\b|[Ee][Ll][Ss][Ii][Ff]\\b|[Ww][Hh][Ee][Nn]\\b)"
  },
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?[Rr][Ee][Gg][Ii][Oo][Nn]\\b",
      "end": "^\\s*//\\s*#?[Ee][Nn][Dd][Rr][Ee][Gg][Ii][Oo][Nn]\\b"
    }
  }
}
