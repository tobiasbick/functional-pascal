{
  "name": "functional-pascal",
  "displayName": "Functional Pascal",
  "description": "Local Functional Pascal editor integration",
  "version": "0.0.7",
  "publisher": "functional-pascal",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobiasbick/functional-pascal.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fpas",
        "aliases": [
          "Functional Pascal",
          "fpas"
        ],
        "extensions": [
          ".fpas"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fpas",
        "scopeName": "source.fpas",
        "path": "./syntaxes/fpas.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fpas",
        "path": "./snippets/fpas.json"
      }
    ],
    "commands": [
      {
        "command": "functionalPascal.showOutput",
        "title": "Show Output",
        "category": "Functional Pascal"
      },
      {
        "command": "functionalPascal.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Functional Pascal"
      }
    ]
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:grammar": "node scripts/verify-grammar.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/node": "24.13.3",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "adm-zip": "0.6.0",
    "esbuild": "0.25.12",
    "typescript": "7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
