{
  "Aliased import": {
    "prefix": "uses",
    "body": "uses ${1:Std.Console} as ${2:Console};",
    "description": "Import one unit through its required source-local alias"
  },
  "Program": {
    "prefix": "program",
    "body": [
      "program ${1:ProgramName};",
      "",
      "begin",
      "  $0",
      "end."
    ],
    "description": "Create a Functional Pascal program"
  },
  "Unit": {
    "prefix": "unit",
    "body": [
      "unit ${1:UnitName};",
      "",
      "$0",
      "",
      "end unit;"
    ],
    "description": "Create a Functional Pascal unit"
  },
  "Function declaration": {
    "prefix": "function",
    "body": [
      "function ${1:FunctionName}(${2:Value}: ${3:integer}): ${4:integer};",
      "begin",
      "  return ${2:Value};",
      "end function;"
    ],
    "description": "Declare a function"
  },
  "Procedure declaration": {
    "prefix": "procedure",
    "body": [
      "procedure ${1:ProcedureName}(${2:Value}: ${3:integer});",
      "begin",
      "  $0",
      "end procedure;"
    ],
    "description": "Declare a procedure"
  },
  "Record type": {
    "prefix": "record",
    "body": [
      "type ${1:RecordName} = record",
      "  ${2:Value}: ${3:integer};",
      "end record;"
    ],
    "description": "Declare a record type"
  },
  "Immutable binding": {
    "prefix": "const",
    "body": "const ${1:Value}: ${2:integer} := ${3:0};",
    "description": "Declare an immutable binding"
  },
  "Mutable variable": {
    "prefix": "var",
    "body": "var ${1:Value}: ${2:integer} := ${3:0};",
    "description": "Declare a reassignable variable"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:true} then",
      "  ${0:null;}",
      "end if;"
    ],
    "description": "Insert an if statement"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:I}: ${2:integer} := ${3:0} to ${4:10} do",
      "  ${0:null;}",
      "end for;"
    ],
    "description": "Insert a for loop"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:true} do",
      "  ${0:null;}",
      "end while;"
    ],
    "description": "Insert a while loop"
  },
  "Repeat loop": {
    "prefix": "repeat",
    "body": [
      "repeat",
      "  ${0:null;}",
      "until ${1:true};"
    ],
    "description": "Insert a repeat loop"
  },
  "Case statement": {
    "prefix": "case",
    "body": [
      "case ${1:Value} of",
      "  when ${2:0}:",
      "    ${0:null;}",
      "  else",
      "    null;",
      "end case;"
    ],
    "description": "Insert an integer or string case with its required fallback"
  },
  "Boolean case statement": {
    "prefix": "casebool",
    "body": [
      "case ${1:true} of",
      "  when true:",
      "    ${0:null;}",
      "  when false:",
      "    null;",
      "end case;"
    ],
    "description": "Insert a complete Boolean case without else"
  },
  "Anonymous function": {
    "prefix": "function expression",
    "body": [
      "function(${1:Value}: ${2:integer}): ${3:integer}",
      "begin",
      "  return ${1:Value};",
      "end function"
    ],
    "description": "Insert an anonymous function expression"
  },
  "Anonymous procedure": {
    "prefix": "procedure expression",
    "body": [
      "procedure(${1:Value}: ${2:integer})",
      "begin",
      "  ${0:null;}",
      "end procedure"
    ],
    "description": "Insert an anonymous procedure expression"
  },
  "Task scope": {
    "prefix": "scope",
    "body": ["scope", "  ${0:null;}", "end scope;"],
    "description": "Own and join child tasks in the current routine"
  },
  "Task start": {
    "prefix": "go task",
    "body": ["scope", "  const ${1:Job} := go ${2:Work}(${3:Arguments});", "  $0", "end scope;"],
    "description": "Start an owned task and bind its exact handle type"
  },
  "Discard task start": {
    "prefix": "discard go",
    "body": ["scope", "  discard go ${1:Work}(${2:Arguments});", "end scope;"],
    "description": "Start owned work and discard its handle without detaching"
  },
  "Record update": {
    "prefix": "with",
    "body": [
      "${1:Value} with",
      "  ${2:Field} := ${3:NewValue};",
      "end with"
    ],
    "description": "Insert a record-update expression"
  }
}
