{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Functional Pascal",
  "scopeName": "source.fpas",
  "patterns": [
    {
      "include": "#typeSection"
    },
    {
      "include": "#constSection"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtInTypes"
    },
    {
      "include": "#qualifiedNames"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "typeSection": {
      "name": "meta.declaration.type-section.fpas",
      "begin": "^(?i:(?:(public)\\s+)?(type))\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.visibility.fpas"
        },
        "2": {
          "name": "keyword.declaration.type.fpas"
        }
      },
      "end": "^(?=(?i:(?:(?:public|static)\\s+)?(?:const|var|mutable|function|procedure|begin|type)\\b))",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "match": "^\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.name.type.fpas"
            },
            "2": {
              "name": "keyword.operator.assignment.type.fpas"
            }
          }
        },
        {
          "include": "#constants"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtInTypes"
        },
        {
          "include": "#qualifiedNames"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "constSection": {
      "name": "meta.declaration.const-section.fpas",
      "begin": "^(?i:(?:(public)\\s+)?(const))\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.visibility.fpas"
        },
        "2": {
          "name": "storage.type.constant.fpas"
        }
      },
      "end": "^(?=(?i:(?:(?:public|static)\\s+)?(?:const|var|mutable|function|procedure|begin|type)\\b))",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "match": "^\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "entity.name.constant.fpas"
            },
            "2": {
              "name": "punctuation.separator.type.fpas"
            }
          }
        },
        {
          "include": "#constants"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtInTypes"
        },
        {
          "include": "#qualifiedNames"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fpas",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.fpas",
          "begin": "'",
          "end": "'(?!')",
          "patterns": [
            {
              "name": "constant.character.escape.apostrophe.fpas",
              "match": "''"
            }
          ]
        },
        {
          "name": "constant.character.numeric.fpas",
          "match": "#[0-9](?:_?[0-9])*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i:\\b(program|unit)\\b)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.module.fpas"
            },
            "2": {
              "name": "entity.name.namespace.fpas"
            }
          }
        },
        {
          "match": "(?i:\\b(function|procedure)\\b)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.fpas"
            },
            "2": {
              "name": "entity.name.function.fpas"
            }
          }
        },
        {
          "match": "(?i:\\b(const|var)\\b)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.fpas"
            },
            "2": {
              "name": "variable.other.definition.fpas"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fpas",
          "match": "\\$[0-9A-Fa-f](?:_?[0-9A-Fa-f])*"
        },
        {
          "name": "constant.numeric.real.fpas",
          "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?\\b"
        },
        {
          "name": "constant.numeric.integer.fpas",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        },
        {
          "name": "constant.language.fpas",
          "match": "(?i:\\b(true|false|ok|error|some|none|nil)\\b)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.fpas",
          "match": "(?i:\\b(program|unit|uses|const|var|mutable|function|procedure|type|public|static|property|event)\\b)"
        },
        {
          "name": "keyword.control.fpas",
          "match": "(?i:\\b(begin|end|return|if|then|else|case|of|for|to|downto|in|do|while|repeat|until|panic|break|continue|try|go|with)\\b)"
        },
        {
          "name": "keyword.operator.word.fpas",
          "match": "(?i:\\b(and|or|not|xor|div|mod|shl|shr)\\b)"
        },
        {
          "name": "storage.type.composite.fpas",
          "match": "(?i:\\b(record|enum|array|dict|result|option)\\b)"
        }
      ]
    },
    "builtInTypes": {
      "patterns": [
        {
          "name": "support.type.builtin.fpas",
          "match": "(?i:\\b(integer|real|boolean|string|task)\\b)"
        },
        {
          "name": "support.type.constraint.fpas",
          "match": "(?i:\\b(Comparable|Numeric|Printable)\\b)"
        }
      ]
    },
    "qualifiedNames": {
      "patterns": [
        {
          "name": "variable.other.qualified.fpas",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fpas",
          "match": ":=|\\.\\.|<>|<=|>=|[+\\-*/=<>]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.fpas",
          "match": ";"
        },
        {
          "name": "punctuation.separator.fpas",
          "match": "[,.:]"
        },
        {
          "name": "punctuation.section.group.fpas",
          "match": "[()\\[\\]]"
        }
      ]
    }
  }
}
