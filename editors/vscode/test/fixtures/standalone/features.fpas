// Representative valid editor fixture.
program EditorFeatures;

uses Std.Console;

type
  Greeting = record
    Text: string;
    Count: integer;
  end record;

function RenderGreeting(Value: Greeting): string;
begin
  return Value.Text + ' — it''s Functional Pascal';
end function;

begin
  // Unicode text is valid inside a UTF-8 string.
  var Message: Greeting := record Text := 'Grüße aus 東京 🙂'; Count := 1; end;
  // The record and function are intentionally used by the fixture.
  // Keep a line-comment token in the positive fixture.
  WriteLn(RenderGreeting(Message));
end.
