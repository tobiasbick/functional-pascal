unit ClosingShowcase;

type Color = enum
  Red;
end enum;

type FileError = error
  Missing(Path: string) = 'File not found';
end error;

type Point = record
  Value: integer;

  function ReadValue(Self: Point): integer;
  begin
    return Self.Value;
  end function;

  static procedure WriteValue();
  begin
    return;
  end procedure;
end record;
end unit;
