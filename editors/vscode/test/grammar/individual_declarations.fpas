unit Highlighting.Declarations;

public type First = integer;

public type Second = record
  public Value: First;
end record;

public const A: integer := 1;
public const B: integer := 2;

public const C: integer := A;
public const D: integer := B;

public var E: integer := 0;
public var F: integer := 0;
public var mutable: integer := 0;
end unit;
