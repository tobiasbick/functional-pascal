program KeywordBoundaries;

uses Std.Console as Console;

const RecordCount: integer := 1;

begin
  const beginValue: string := 'if then begin end';
  // function return record
  const gifted: boolean := true;
  // while repeat until
  const endif: integer := 0;
  if gifted and (endif = 0) then
    begin
      Console.WriteLn(beginValue);
    end;
  end if;
  const shl: integer := 1;
  const shr: integer := shl;
  const ShiftText: string := 'shl shr'; // shl shr
  var Mutable := 1;
end program;
