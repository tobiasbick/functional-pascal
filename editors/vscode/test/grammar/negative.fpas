program KeywordBoundaries;

uses Std.Console;

const RecordCount: integer := 1;

begin
  const beginValue: string := 'if then begin end';
  // function return record
  const gifted: boolean := true;
  // while repeat until
  const endif: integer := 0;
  const shl: integer := 1;
  const SHR: integer := 2;
  if gifted and (endif = 0) then
    begin
      WriteLn(beginValue);
    end;
  end if;
end.
