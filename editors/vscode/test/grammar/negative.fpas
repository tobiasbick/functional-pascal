program KeywordBoundaries;

 uses Std.Console as Console;


  const RecordCount: integer := 1;

begin
  var beginValue: string := 'if then begin end';
  // function return record
  var gifted: boolean := true;
  // while repeat until
  var endif: integer := 0;
  if gifted and (endif = 0) then
  begin
    Console.WriteLn(beginValue);
  end; end if;
  var shl: integer := 1;
  var shr: integer := shl;
  var ShiftText: string := 'shl shr'; // shl shr
end program;
