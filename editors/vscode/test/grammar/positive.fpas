// Positive syntax-highlighting fixture.
program HighlightingShowcase;

uses Std.Console;

type Point = record
  X: integer;
  Y: real;
end record;

function Distance(Value: Point): real;
begin
  return Value.X + Value.Y;
end function;

begin
  // Origin value.
  const Origin: Point := record
    X := 42;
    Y := 3.5;
  end;
  // Mask value.
  const Mask: integer := 42;
  if Mask >= 1 then
    begin
      Std.Console.WriteLn('It''s the origin');
    end;
  end if;
end.
