program JsonAttributes;

uses System.Console as Console, System.Text.Json as Json,
  System.Text.Json.Serialization as Serialization;

// A player with an explicit JSON property name.
type Player = record
  [Serialization.JsonPropertyNameAttribute('player_name')]
  Name: string;
  Score: int;
end record;

begin
  const Value: Player := new Player('Mara', 42);
  Console.WriteLine(Json.JsonSerializer.Serialize<Player>(Value));
end;
end program;
