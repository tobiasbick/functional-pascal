program Fibonacci;

uses Std.Console as Console;

function Fib(N: integer): integer;
begin
  if N <= 1 then
    begin
      return N;
    end;
  else
    begin
      return Fib(N - 1) + Fib(N - 2);
    end;
  end if;
end function;

begin
  Console.WriteLn('Fibonacci sequence:');
  for I: integer := 0 to 9 do
    begin
      Console.WriteLn(Fib(I));
    end;
  end for;
end program;
