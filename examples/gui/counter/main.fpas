program GuiCounter;

uses
  Fpas.Gui.Application as Gui, Fpas.Mvu.Application as Mvu, Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L, Fpas.Ui.Editors as Ed, System as Sys,
  System.Threading as Threads, System.Threading.Tasks as Tasks;

type Model = record
  /// Number displayed by the counter.
  public Count: int := 0;
  /// Controlled checkbox state.
  public Checked: bool := false;
  /// Controlled Unicode document.
  public Text: string := 'Hello λ';
  /// Directional document selection.
  public Position: Ed.EditorPosition := new Ed.EditorPosition();
  /// Background work status.
  public Status: string := 'Ready';
  /// Model-owned overlay visibility.
  public Modal: bool := false;
end record;

type Msg = union
  Increment;
  Check(Value: bool);
  Edit(Value: Ed.TextEdit);
  Move(Value: Ed.EditorPosition);
  Start;
  Cancel;
  Done;
  Error(Text: string);
  Open;
  Close;
  Quit;
end union;

async function Work(Post: function(Msg): Tasks.Task; Cancellation: Threads.CancellationToken): Tasks.Task;
begin
  await Tasks.Task.Delay(1000, Cancellation).ConfigureAwait(false);
  await Post(Msg.Done).ConfigureAwait(false);
end function;

function Update(Current: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  var Next: Model := Current;
  var Commands: array of Mvu.Command<Msg> := [];
  case Message of
    when Msg.Increment:
      Next := Current with
        Count := Current.Count + 1;
      end with;
    when Msg.Check(const Value: bool):
      Next := Current with
        Checked := Value;
      end with;
    when Msg.Edit(const Value: Ed.TextEdit):
      Next := Current with
        Text := Value.Text;
        Position := Value.Position;
      end with;
    when Msg.Move(const Value: Ed.EditorPosition):
      Next := Current with
        Position := Value;
      end with;
    when Msg.Start:
      Next := Current with
        Status := 'Working';
      end with;
      Commands := [
        Mvu.StartBackground<Msg>(
          'work',
          Work,
          function(Error: Sys.Exception): Msg => Msg.Error(Error.Message)
        )
      ];
    when Msg.Cancel:
      Next := Current with
        Status := 'Cancelled';
      end with;
      Commands := [Mvu.CancelBackground<Msg>('work')];
    when Msg.Done:
      Next := Current with
        Count := Current.Count + 1;
        Status := 'Completed';
      end with;
    when Msg.Error(const Text: string):
      Next := Current with
        Status := Text;
      end with;
    when Msg.Open:
      Next := Current with
        Modal := true;
      end with;
    when Msg.Close:
      Next := Current with
        Modal := false;
      end with;
    when Msg.Quit:
      Commands := [Mvu.Exit<Msg>()];
  end case;

  return new Mvu.Transition<Model, Msg>(Next, Commands);
end function;

function View(Model: Model; Viewport: L.Viewport): E.Element<Msg>;
begin
  const Base: E.Element<Msg> := E.Column<Msg>(
    new L.Flow(Padding := L.Spacing.Loose, Gap := L.Spacing.Normal),
    E.Text<Msg>('Count: ' + Model.Count.ToString()),
    E.Button<Msg>('increment', 'Increment', Msg.Increment),
    E.Checkbox<Msg>(
      'checked',
      'Checked',
      Model.Checked,
      function(Value: bool): Msg => Msg.Check(Value)
    ),
    E.TextInput<Msg>(
      'text',
      Model.Text,
      Model.Position,
      function(Value: Ed.TextEdit): Msg => Msg.Edit(Value),
      function(Value: Ed.EditorPosition): Msg => Msg.Move(Value)
    ),
    E.Text<Msg>(Model.Status),
    E.Button<Msg>('start', 'Start asynchronous increment', Msg.Start),
    E.Button<Msg>(
      'cancel',
      'Cancel',
      Msg.Cancel
    ),
    E.Button<Msg>('modal-open', 'Show modal', Msg.Open),
    E.Button<Msg>('quit', 'Close', Msg.Quit)
  );
  if not Model.Modal then
    return Base;
  end if;

  return E.Overlay<Msg>(
    'modal', Base, E.Column<Msg>(
      E.Text<Msg>('Background work remains owned by the session.'),
      E.Button<Msg>('modal-close', 'Close modal', Msg.Close)
    ), 'modal-close', function(): Msg => Msg.Close
  );
end function;

begin
  Gui.Run<Model, Msg>(
    new Model(),
    Update,
    View,
    new Gui.Options(Title := 'FPAS counter', Height := 640)
  );
end;
end program;
