program JsonAttributes;

uses
  System.Console as Console, System.Text.Json as Json,
  System.Text.Json.Serialization as Serialization;

// A measurement with an explicit JSON property name.
type Measurement = record
  [Serialization.JsonPropertyNameAttribute('sample_name')]
  public Name: string;
  public Value: int;
end record;

begin
  const Sample: Measurement := new Measurement('Alpha', 42);
  Console.WriteLine(Json.JsonSerializer.Serialize<Measurement>(Sample));
end;

end program;
