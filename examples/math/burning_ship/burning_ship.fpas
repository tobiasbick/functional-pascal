// Interactive renderer using the shared fractal explorer lifecycle.
program BurningShipShowcase;

uses Fractal.Camera, Fractal.Explorer, BurningShip.Color, BurningShip.Render;

function Palette(Value: integer): PaletteKind;
begin
  case Value of
    when 1:
      begin
        return PaletteKind.DeepOcean;
      end;
    when 2:
      begin
        return PaletteKind.Ember;
      end;
    else
      begin
        return PaletteKind.Aurora;
      end;
  end case;
end function;

function Label(Value: integer): string;
begin
  return PaletteName(Palette(Value));
end function;

procedure Draw(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Value: integer
);
begin
  Render(XMin, XMax, YMin, YMax, Width, Height, MaxIter, Palette(Value));
end procedure;

begin
  var Initial: ExplorerCamera := record
    CenterX := -0.45;
    CenterY := -0.55;
    SpanY := 2.8;
    MaxIter := 160;
    Palette := 2;
  end;

  RunExplorer('Functional Pascal Burning Ship', Initial, Draw, Label);
end.
