// Interactive renderer using the shared fractal explorer lifecycle.
program BurningShipShowcase;

uses Fractal.Camera as Camera;
uses Fractal.Explorer as Explorer;
uses BurningShip.Color as Color;
uses BurningShip.Render as Render2;

function Palette(Value: integer): Color.PaletteKind;
begin
  case Value of
    when 1:
      begin
        return Color.PaletteKind.DeepOcean;
      end;
    when 2:
      begin
        return Color.PaletteKind.Ember;
      end;
    else
      begin
        return Color.PaletteKind.Aurora;
      end;
  end case;
end function;

function Label(Value: integer): string;
begin
  return Color.PaletteName(Palette(Value));
end function;

procedure Draw(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Value: integer
);
begin
  Render2.Render(XMin, XMax, YMin, YMax, Width, Height, MaxIter, Palette(Value));
end procedure;

begin
  var Initial: Camera.ExplorerCamera := record
    CenterX := -0.45;
    CenterY := -0.55;
    SpanY := 2.8;
    MaxIter := 160;
    Palette := 2;
  end record;

  Explorer.RunExplorer('Functional Pascal Burning Ship', Initial, Draw, Label);
end program;
