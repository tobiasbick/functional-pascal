{ Built only via burning_ship.fpasprj — not a standalone program. }

unit BurningShip.Render;

uses Std.Console, Std.Task, Std.Array, Std.Conv, Std.Math, Std.Str, BurningShip.Color;

type
  Complex = record
    public Re: real;
    public Im: real;

    public static function Zero(): Complex;
    begin
      return record
        Re := 0.0;
        Im := 0.0;
      end
    end;

    public static function Create(Re: real; Im: real): Complex;
    begin
      return record
        Re := Re;
        Im := Im;
      end
    end;

    public function AbsComponents(Self: Complex): Complex;
    begin
      return record
        Re := Abs(Self.Re);
        Im := Abs(Self.Im);
      end
    end;

    public function Sq(Self: Complex): Complex;
    begin
      return record
        Re := Self.Re * Self.Re - Self.Im * Self.Im;
        Im := (2.0 * Self.Re) * Self.Im;
      end
    end;

    public function Add(Self: Complex; Other: Complex): Complex;
    begin
      return record
        Re := Self.Re + Other.Re;
        Im := Self.Im + Other.Im;
      end
    end;

    public function MagSq(Self: Complex): real;
    begin
      return Self.Re * Self.Re + Self.Im * Self.Im
    end;
  end;
  PixelSample = record
    public IsInside: boolean;
    public EscapeValue: real;
  end;

function Iterate(C: Complex; MaxIter: integer): PixelSample;
begin
  var EscapeRadiusSq: real := 256.0;
  mutable var Z: Complex := Complex.Zero();
  mutable var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= EscapeRadiusSq) do
  begin
    Z := Z.AbsComponents().Sq().Add(C);
    N := N + 1
  end;

  if N >= MaxIter then
  begin
    return record
      IsInside := true;
      EscapeValue := 0.0;
    end
  end;
  var MagnitudeSq: real := Max(Z.MagSq(), 4.0);
  var Smooth: real := (IntToReal(N) + 1.0) - (Log(Log(MagnitudeSq) * 0.5) / Log(2.0));
  return record
    IsInside := false;
    EscapeValue := Smooth;
  end
end;

function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of PixelSample;
begin
  mutable var WidthRange: integer := Width - 1;
  mutable var HeightRange: integer := Height - 1;
  if WidthRange < 1 then
  begin
    WidthRange := 1
  end;

  if HeightRange < 1 then
  begin
    HeightRange := 1
  end;
  var Wr: real := IntToReal(WidthRange);
  var Hr: real := IntToReal(HeightRange);
  var cy: real := YMax - (Py / Hr) * (YMax - YMin);
  mutable var Row: array of PixelSample := [];
  for Px: integer := 0 to Width - 1 do
  begin
    var cx: real := XMin + (Px / Wr) * (XMax - XMin);
    Push(Row, Iterate(Complex.Create(cx, cy), MaxIter))
  end;

  return Row
end;

function EscapeGlyph(EscapeValue: real): string;
begin
  var Ramp: string := ' ░▒▓█';
  var Count: integer := Std.Str.Length(Ramp);
  var Phase: real := Frac(EscapeValue * 0.08);
  var Index: integer := Clamp(Trunc(Phase * IntToReal(Count)), 0, Count - 1);
  return CharAt(Ramp, Index)
end;

function RenderCell(Sample: PixelSample; Palette: PaletteKind): Cell;
begin
  if Sample.IsInside then
  begin
    var CellShade: Color := InsideColor();
    return record
      glyph := ' ';
      foreground := CellShade;
      background := CellShade;
    end
  end;

  return record
    glyph := EscapeGlyph(Sample.EscapeValue);
    foreground := EscapeColor(Palette, Sample.EscapeValue);
    background := RgbColor(0, 0, 0);
  end
end;

procedure DrawRow(Row: array of PixelSample; Width: integer; Y: integer; Palette: PaletteKind);
begin
  var CurrentWidth: integer := ScreenWidth();
  mutable var DrawWidth: integer := Width;
  if DrawWidth > CurrentWidth then
  begin
    DrawWidth := CurrentWidth
  end;

  if DrawWidth < 1 then
  begin
    return
  end;
  mutable var Cells: array of Cell := [];
  for Px: integer := 0 to DrawWidth - 1 do
  begin
    Push(Cells, RenderCell(Row[Px], Palette))
  end;

  WriteCells(1, Y, Cells)
end;

public procedure Render(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: PaletteKind
);
begin
  mutable var Tasks: array of task := [];
  for Py: integer := 0 to Height - 1 do
  begin
    Push(Tasks, go ComputeRow(Py, Width, Height, XMin, XMax, YMin, YMax, MaxIter))
  end;

  for Py: integer := 0 to Height - 1 do
  begin
    var Row: array of PixelSample := Wait(Tasks[Py]);
    if (Py + 1) <= Max(ScreenHeight() - 2, 1) then
    begin
      DrawRow(Row, Width, Py + 1, Palette)
    end
  end
end;
