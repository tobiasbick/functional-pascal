// Built only via burning_ship.fpasprj — not a standalone program.

unit BurningShip.Render;

uses
  Std.Console as Console, Std.Tasks as StdTasks, Std.Conv as Conv, Std.Math as Math,
  BurningShip.Color as Color;

type Complex = record
  public Re: real;
  public Im: real;

  public static function Zero(): Complex;
  begin
    return Complex(Re := 0.0, Im := 0.0);
  end function;

  public static function Create(Re: real; Im: real): Complex;
  begin
    return Complex(Re := Re, Im := Im);
  end function;

  public function AbsComponents(Self: Complex): Complex;
  begin
    return Complex(Re := Math.Abs(Self.Re), Im := Math.Abs(Self.Im));
  end function;

  public function Sq(Self: Complex): Complex;
  begin
    return Complex(Re := Self.Re * Self.Re - Self.Im * Self.Im, Im := 2.0 * Self.Re * Self.Im);
  end function;

  public function Add(Self: Complex; Other: Complex): Complex;
  begin
    return Complex(Re := Self.Re + Other.Re, Im := Self.Im + Other.Im);
  end function;

  public function MagSq(Self: Complex): real;
  begin
    return Self.Re * Self.Re + Self.Im * Self.Im;
  end function;
end record;

type PixelSample = record
  public IsInside: boolean;
  public EscapeValue: real;
end record;

function Iterate(C: Complex; MaxIter: integer): PixelSample;
begin
  const EscapeRadiusSq: real := 256.0;
  var Z: Complex := Complex.Zero();
  var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= EscapeRadiusSq) do
    begin
      Z := Z.AbsComponents().Sq().Add(C);
      N := N + 1;
    end;
  end while;

  if N >= MaxIter then
    begin
      return PixelSample(IsInside := true, EscapeValue := 0.0);
    end;
  end if;
  const MagnitudeSq: real := Math.Max(Z.MagSq(), 4.0);
  const Smooth: real := Conv.IntToReal(N) + 1.0 -
                        (Math.Log(Math.Log(MagnitudeSq) * 0.5) / Math.Log(2.0));
  return PixelSample(IsInside := false, EscapeValue := Smooth);
end function;

function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of PixelSample;
begin
  var WidthRange: integer := Width - 1;
  var HeightRange: integer := Height - 1;
  if WidthRange < 1 then
    begin
      WidthRange := 1;
    end;
  end if;

  if HeightRange < 1 then
    begin
      HeightRange := 1;
    end;
  end if;
  const Wr: real := Conv.IntToReal(WidthRange);
  const Hr: real := Conv.IntToReal(HeightRange);
  const cy: real := YMax - Conv.IntToReal(Py) / Hr * (YMax - YMin);
  var Row: array of PixelSample := [];
  for Px: integer := 0 to Width - 1 do
    begin
      const cx: real := XMin + Conv.IntToReal(Px) / Wr * (XMax - XMin);
      Row.PushInPlace(Iterate(Complex.Create(cx, cy), MaxIter));
    end;
  end for;

  return Row;
end function;

function EscapeGlyph(EscapeValue: real): string;
begin
  const Ramp: string := ' ░▒▓█';
  const Count: integer := Ramp.Length();
  const Phase: real := Math.Frac(EscapeValue * 0.08);
  const Index: integer := Math.Clamp(Math.Trunc(Phase * Conv.IntToReal(Count)), 0, Count - 1);
  return Ramp.CharAt(Index);
end function;

function RenderCell(Sample: PixelSample; Palette: Color.PaletteKind): Console.Cell;
begin
  if Sample.IsInside then
    begin
      const CellShade: Console.Color := Color.InsideColor();
      return Console.Cell(glyph := ' ', foreground := CellShade, background := CellShade);
    end;
  end if;

  return Console.Cell(glyph := EscapeGlyph(Sample.EscapeValue), foreground := Color.EscapeColor(Palette, Sample.EscapeValue), background := Console.RgbColor(0, 0, 0));
end function;

procedure DrawRow(Row: array of PixelSample; Width: integer; Y: integer; Palette: Color.PaletteKind);
begin
  const CurrentWidth: integer := Console.ScreenWidth();
  var DrawWidth: integer := Width;
  if DrawWidth > CurrentWidth then
    begin
      DrawWidth := CurrentWidth;
    end;
  end if;

  if DrawWidth < 1 then
    begin
      return;
    end;
  end if;
  var Cells: array of Console.Cell := [];
  for Px: integer := 0 to DrawWidth - 1 do
    begin
      Cells.PushInPlace(RenderCell(Row[Px], Palette));
    end;
  end for;

  Console.WriteCells(1, Y, Cells);
end procedure;

public procedure Render(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: Color.PaletteKind
);
begin
  scope
    var Tasks: array of task of array of PixelSample := [];
    for Py: integer := 0 to Height - 1 do
      begin
        Tasks.PushInPlace(go ComputeRow(Py, Width, Height, XMin, XMax, YMin, YMax, MaxIter));
      end;
    end for;

    for Py: integer := 0 to Height - 1 do
      begin
        const Row: array of PixelSample := StdTasks.Wait(Tasks[Py]);
        if (Py + 1) <= Math.Max(Console.ScreenHeight() - 2, 1) then
          begin
            DrawRow(Row, Width, Py + 1, Palette);
          end;
        end if;
      end;
    end for;
  end scope;
end procedure;
end unit;
