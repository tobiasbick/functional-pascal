// Viewport geometry shared by the interactive fractal examples.
unit Fractal.Camera;

uses Std.Conv as Conv;
uses Std.Math as Math;

// Complex-plane viewport and renderer settings.
public type ExplorerCamera = record
  // Horizontal center in the complex plane.
  public CenterX: real;
  // Vertical center in the complex plane.
  public CenterY: real;
  // Visible vertical span.
  public SpanY: real;
  // Maximum iterations per pixel.
  public MaxIter: integer;
  // Example palette number (1 through 3).
  public Palette: integer;
end record;

// Horizontal span adjusted for terminal cell proportions.
public function ExplorerCameraSpanX(Receiver: ExplorerCamera; Width: integer; Height: integer): real;
begin
  const SafeWidth: integer := Math.Max(Width, 1);
  const SafeHeight: integer := Math.Max(Height, 1);
  return (Receiver.SpanY * (Conv.IntToReal(SafeWidth) / Conv.IntToReal(SafeHeight))) * 0.5;
end function;

// Left viewport boundary.
public function ExplorerCameraXMin(Receiver: ExplorerCamera; Width: integer; Height: integer): real;
begin
  return Receiver.CenterX - (ExplorerCameraSpanX(Receiver, Width, Height) * 0.5);
end function;

// Right viewport boundary.
public function ExplorerCameraXMax(Receiver: ExplorerCamera; Width: integer; Height: integer): real;
begin
  return Receiver.CenterX + (ExplorerCameraSpanX(Receiver, Width, Height) * 0.5);
end function;

// Bottom viewport boundary.
public function ExplorerCameraYMin(Receiver: ExplorerCamera): real;
begin
  return Receiver.CenterY - (Receiver.SpanY * 0.5);
end function;

// Top viewport boundary.
public function ExplorerCameraYMax(Receiver: ExplorerCamera): real;
begin
  return Receiver.CenterY + (Receiver.SpanY * 0.5);
end function;

// Zoom relative to the initial vertical span.
public function ExplorerCameraGetZoom(Receiver: ExplorerCamera): real;
begin
  return 2.8 / Receiver.SpanY;
end function;

end unit;
