// Shared terminal lifecycle and input handling for the fractal examples.
unit Fractal.Explorer;

uses Fractal.Camera, Std.Console, Std.Conv, Std.Math;

function RenderWidth(): integer;
begin
  return Max(ScreenWidth(), 1);
end function;

function RenderHeight(): integer;
begin
  return Max(ScreenHeight() - 3, 1);
end function;

// 1-based cell in the render viewport → complex plane (same mapping as row iteration)

function ViewportCX(State: ExplorerCamera; W: integer; H: integer; CellX: integer): real;
begin
  const Wr: integer := Max(W - 1, 1);
  return State.XMin(W, H) +
         (IntToReal(CellX - 1) / IntToReal(Wr)) * (State.XMax(W, H) - State.XMin(W, H));
end function;

function ViewportCY(State: ExplorerCamera; W: integer; H: integer; CellY: integer): real;
begin
  const Hr: integer := Max(H - 1, 1);
  return State.YMax() - (IntToReal(CellY - 1) / IntToReal(Hr)) * (State.YMax() - State.YMin());
end function;

procedure WriteHudText(Text: string; Width: integer);
begin
  if Width > 0 then
    begin
      const TextLength: integer := Min(Text.Length(), Width);
      if TextLength > 0 then
        begin
          WriteText(Text.Slice(0, TextLength));
        end;
      end if;
    end;
  end if;
end procedure;

procedure DrawHud(
  S: ExplorerCamera;
  Width: integer;
  Height: integer;
  Title: string;
  PaletteLabel: function(Value: integer): string
);
begin
  Window(1, 1, ScreenWidth(), ScreenHeight());
  const HudTop: integer := Max(ScreenHeight() - 2, 1);
  Window(1, HudTop, ScreenWidth(), ScreenHeight());
  NormVideo();
  ClrScr();
  GotoXY(1, 1);
  TextColorRGB(255, 220, 120);
  WriteHudText(Title, Width);
  TextColorRGB(156, 204, 255);
  WriteHudText('  tasks | units | records | truecolor | mouse | focus | paste', Max(Width -
                                                                                    Title.Length(), 0));
  if ScreenHeight() >= 2 then
    begin
      GotoXY(1, 2);
      NormVideo();
      WriteHudText('size=%dx%d  center=(%f, %f)  zoom=%f  iter=%d  palette=%s'
                     .Format(Width, Height, S.CenterX, S.CenterY, S.GetZoom(), S.MaxIter, PaletteLabel(S.Palette)), Width);
    end;
  end if;

  if ScreenHeight() >= 3 then
    begin
      GotoXY(1, 3);
      NormVideo();
      WriteHudText('click center  wheel zoom  M middle=reset  arrows  +/-  PgUp/Dn  1/2/3  R  Esc', Width);
    end;
  end if;

  NormVideo();
  Window(1, 1, Width, Height);
end procedure;

var ResetCamera: ExplorerCamera := fractal.camera.explorercamera(CenterX := 0.0, CenterY := 0.0, SpanY := 2.8, MaxIter := 160, Palette := 1);
var State: ExplorerCamera := ResetCamera;
var RenderW: integer := 1;
var RenderH: integer := 1;
var NeedsRedraw: boolean := true;
var Quit: boolean := false;

procedure RequestRedraw();
begin
  NeedsRedraw := true;
end procedure;

procedure PaintFrame(
  Title: string;
  RenderFrame: procedure(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: integer
);
  PaletteLabel: function(Value: integer): string
);
begin
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  BeginFrame();
  FillRect(Std.Console.Rect(x := 1, y := 1, width := ScreenWidth(), height := ScreenHeight()), Std.Console.Cell(glyph := ' ', foreground := RgbColor(0, 0, 0), background := RgbColor(0, 0, 0)));
  RenderFrame(State.XMin(RenderW, RenderH), State.XMax(RenderW, RenderH), State.YMin(), State.YMax(), RenderW, RenderH, State.MaxIter, State.Palette);
  DrawHud(State, RenderW, RenderH, Title, PaletteLabel);
  Present();
end procedure;

function HandleKey(Key: KeyEvent): boolean;
begin
  const StepX: real := State.SpanX(RenderW, RenderH) * 0.14;
  const StepY: real := State.SpanY * 0.14;
  if Key.kind = KeyKind.Escape then
    begin
      Quit := true;
      return true;
    end;
  elsif Key.kind = KeyKind.Left then
    begin
      State.CenterX := State.CenterX - StepX;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.Right then
    begin
      State.CenterX := State.CenterX + StepX;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.Up then
    begin
      State.CenterY := State.CenterY + StepY;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.Down then
    begin
      State.CenterY := State.CenterY - StepY;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.PageUp then
    begin
      State.MaxIter := Min(State.MaxIter + 32, 2048);
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.PageDown then
    begin
      State.MaxIter := Max(State.MaxIter - 32, 32);
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.Character then
    begin
      case Key.ch of
        when '+', '=':
          begin
            State.SpanY := Max(State.SpanY * 0.82, 0.000001);
            RequestRedraw();
            return true;
          end;
        when '-':
          begin
            State.SpanY := Min(State.SpanY / 0.82, 4.0);
            RequestRedraw();
            return true;
          end;
        when '1':
          begin
            State.Palette := 1;
            RequestRedraw();
            return true;
          end;
        when '2':
          begin
            State.Palette := 2;
            RequestRedraw();
            return true;
          end;
        when '3':
          begin
            State.Palette := 3;
            RequestRedraw();
            return true;
          end;
        when 'r', 'R':
          begin
            State := ResetCamera;
            RequestRedraw();
            return true;
          end;
      end case;
    end;
  end if;

  return false;
end function;

procedure HandleMouse(InputEvent: ConsoleEvent);
begin
  const InView: boolean := (((InputEvent.mouse_x >= 1) and (InputEvent.mouse_x <= RenderW)) and (InputEvent.mouse_y >= 1)) and
                           (InputEvent.mouse_y <= RenderH);
  if InputEvent.mouse_action = MouseAction.ScrollUp then
    begin
      State.SpanY := Max(State.SpanY * 0.88, 0.000001);
      RequestRedraw();
    end;
  elsif InputEvent.mouse_action = MouseAction.ScrollDown then
    begin
      State.SpanY := Min(State.SpanY / 0.88, 4.0);
      RequestRedraw();
    end;
  elsif InView and (InputEvent.mouse_action = MouseAction.Down) then
    begin
      if InputEvent.mouse_button = MouseButton.Left then
        begin
          State.CenterX := ViewportCX(State, RenderW, RenderH, InputEvent.mouse_x);
          State.CenterY := ViewportCY(State, RenderW, RenderH, InputEvent.mouse_y);
          RequestRedraw();
        end;
      elsif InputEvent.mouse_button = MouseButton.Middle then
        begin
          State := ResetCamera;
          RequestRedraw();
        end;
      end if;
    end;
  end if;
end procedure;

procedure HandleResize(Width: integer; Height: integer);
begin
  const NewW: integer := Max(Width, 1);
  const NewH: integer := Max(Height - 2, 1);
  if (NewW <> RenderW) or (NewH <> RenderH) then
    begin
      RenderW := NewW;
      RenderH := NewH;
      RequestRedraw();
    end;
  end if;
end procedure;

procedure HandleEvent(E: ConsoleEvent);
begin
  if E.kind = EventKind.Key then
    begin
      discard HandleKey(E.key);
    end;
  elsif E.kind = EventKind.Mouse then
    begin
      HandleMouse(E);
    end;
  elsif E.kind = EventKind.Resize then
    begin
      HandleResize(E.width, E.height);
    end;
  end if;
end procedure;

procedure ShutdownTerminal();
begin
  CursorOn();
  DisablePaste();
  DisableFocus();
  DisableMouse();
  DisableRawMode();
  LeaveAltScreen();
end procedure;

// Runs one interactive explorer; renderer and palettes remain example-owned.
public procedure RunExplorer(
  Title: string;
  Initial: ExplorerCamera;
  RenderFrame: procedure(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: integer
);
  PaletteLabel: function(Value: integer): string
);
begin
  ResetCamera := Initial;
  State := Initial;
  Quit := false;
  EnableRawMode();
  EnterAltScreen();
  EnableMouse();
  EnableFocus();
  EnablePaste();
  CursorOff();
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  NeedsRedraw := true;
  while not Quit do
    begin
      if NeedsRedraw then
        begin
          PaintFrame(Title, RenderFrame, PaletteLabel);
          NeedsRedraw := false;
        end;
      end if;

      case ReadEventTimeout(16) of
        when Some(E):
          begin
            HandleEvent(E);
          end;
        when None:
          begin
          end;
      end case;
    end;
  end while;

  ShutdownTerminal();
end procedure;
end unit;
