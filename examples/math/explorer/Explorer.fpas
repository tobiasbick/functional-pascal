// Shared terminal lifecycle and input handling for the fractal examples.
unit Fractal.Explorer;

uses Fractal.Camera as Camera;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Math as Math;
uses Std.Options as Options;
uses Std.Str as Str;

function RenderWidth(): integer;
begin
  return Math.Max(Console.ScreenWidth(), 1);
end function;

function RenderHeight(): integer;
begin
  return Math.Max(Console.ScreenHeight() - 3, 1);
end function;

// 1-based cell in the render viewport → complex plane (same mapping as row iteration)

function ViewportCX(State: Camera.ExplorerCamera; W: integer; H: integer; CellX: integer): real;
begin
  var Wr: integer := Math.Max(W - 1, 1);
  return State.XMin(W, H) +
         (Conv.IntToReal(CellX - 1) / Conv.IntToReal(Wr)) * (State.XMax(W, H) - State.XMin(W, H));
end function;

function ViewportCY(State: Camera.ExplorerCamera; W: integer; H: integer; CellY: integer): real;
begin
  var Hr: integer := Math.Max(H - 1, 1);
  return State.YMax() -
         (Conv.IntToReal(CellY - 1) / Conv.IntToReal(Hr)) * (State.YMax() - State.YMin());
end function;

procedure WriteHudText(Text: string; Width: integer);
begin
  if Width > 0 then
    begin
      var TextLength: integer := Math.Min(Str.Length(Text), Width);
      if TextLength > 0 then
        begin
          Console.WriteText(Str.Substring(Text, 0, TextLength));
        end;
      end if;
    end;
  end if;
end procedure;

procedure DrawHud(
  S: Camera.ExplorerCamera;
  Width: integer;
  Height: integer;
  Title: string;
  PaletteLabel: function(Value: integer): string
);
begin
  Console.Window(1, 1, Console.ScreenWidth(), Console.ScreenHeight());
  var HudTop: integer := Math.Max(Console.ScreenHeight() - 2, 1);
  Console.Window(1, HudTop, Console.ScreenWidth(), Console.ScreenHeight());
  Console.NormVideo();
  Console.ClrScr();
  Console.GotoXY(1, 1);
  Console.TextColorRGB(255, 220, 120);
  WriteHudText(Title, Width);
  Console.TextColorRGB(156, 204, 255);
  WriteHudText('  tasks | units | records | truecolor | mouse | focus | paste', Math.Max(Width -
                                                                                         Str.Length(Title), 0));
  if Console.ScreenHeight() >= 2 then
    begin
      Console.GotoXY(1, 2);
      Console.NormVideo();
      WriteHudText(Str.Format('size=%dx%d  center=(%f, %f)  zoom=%f  iter=%d  palette=%s', Width, Height, S.CenterX, S.CenterY, S.Zoom, S.MaxIter, PaletteLabel(S.Palette)), Width);
    end;
  end if;

  if Console.ScreenHeight() >= 3 then
    begin
      Console.GotoXY(1, 3);
      Console.NormVideo();
      WriteHudText('click center  wheel zoom  M middle=reset  arrows  +/-  PgUp/Dn  1/2/3  R  Esc', Width);
    end;
  end if;

  Console.NormVideo();
  Console.Window(1, 1, Width, Height);
end procedure;

mutable var ResetCamera: Camera.ExplorerCamera := record
  CenterX := 0.0;
  CenterY := 0.0;
  SpanY := 2.8;
  MaxIter := 160;
  Palette := 1;
end record;
mutable var State: Camera.ExplorerCamera := ResetCamera;
mutable var RenderW: integer := 1;
mutable var RenderH: integer := 1;
mutable var NeedsRedraw: boolean := true;
mutable var Quit: boolean := false;

procedure RequestRedraw();
begin
  NeedsRedraw := true;
end procedure;

procedure PaintFrame(
  Title: string;
  RenderFrame: procedure(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: integer
);
  PaletteLabel: function(Value: integer): string
);
begin
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  Console.BeginFrame();
  Console.FillRect(record
    x := 1;
    y := 1;
    width := Console.ScreenWidth();
    height := Console.ScreenHeight();
  end record, record
    glyph := ' ';
    foreground := Console.RgbColor(0, 0, 0);
    background := Console.RgbColor(0, 0, 0);
  end record);
  RenderFrame(State.XMin(RenderW, RenderH), State.XMax(RenderW, RenderH), State.YMin(), State.YMax(), RenderW, RenderH, State.MaxIter, State.Palette);
  DrawHud(State, RenderW, RenderH, Title, PaletteLabel);
  Console.Present();
end procedure;

function HandleKey(Key: Console.KeyEvent): boolean;
begin
  var StepX: real := State.SpanX(RenderW, RenderH) * 0.14;
  var StepY: real := State.SpanY * 0.14;
  if Key.kind = Console.KeyKind.Escape then
    begin
      Quit := true;
      return true;
    end;
  else
    if Key.kind = Console.KeyKind.Left then
      begin
        State.CenterX := State.CenterX - StepX;
        RequestRedraw();
        return true;
      end;
    else
      if Key.kind = Console.KeyKind.Right then
        begin
          State.CenterX := State.CenterX + StepX;
          RequestRedraw();
          return true;
        end;
      else
        if Key.kind = Console.KeyKind.Up then
          begin
            State.CenterY := State.CenterY + StepY;
            RequestRedraw();
            return true;
          end;
        else
          if Key.kind = Console.KeyKind.Down then
            begin
              State.CenterY := State.CenterY - StepY;
              RequestRedraw();
              return true;
            end;
          else
            if Key.kind = Console.KeyKind.PageUp then
              begin
                State.MaxIter := Math.Min(State.MaxIter + 32, 2048);
                RequestRedraw();
                return true;
              end;
            else
              if Key.kind = Console.KeyKind.PageDown then
                begin
                  State.MaxIter := Math.Max(State.MaxIter - 32, 32);
                  RequestRedraw();
                  return true;
                end;
              else
                if Key.kind = Console.KeyKind.Character then
                  begin
                    case Key.ch of
                      when '+', '=':
                        begin
                          State.SpanY := Math.Max(State.SpanY * 0.82, 0.000001);
                          RequestRedraw();
                          return true;
                        end;
                      when '-':
                        begin
                          State.SpanY := Math.Min(State.SpanY / 0.82, 4.0);
                          RequestRedraw();
                          return true;
                        end;
                      when '1':
                        begin
                          State.Palette := 1;
                          RequestRedraw();
                          return true;
                        end;
                      when '2':
                        begin
                          State.Palette := 2;
                          RequestRedraw();
                          return true;
                        end;
                      when '3':
                        begin
                          State.Palette := 3;
                          RequestRedraw();
                          return true;
                        end;
                      when 'r', 'R':
                        begin
                          State := ResetCamera;
                          RequestRedraw();
                          return true;
                        end;
                    end case;
                  end;
                end if;
              end if;
            end if;
          end if;
        end if;
      end if;
    end if;
  end if;

  return false;
end function;

procedure HandleMouse(InputEvent: Console.ConsoleEvent);
begin
  var InView: boolean := (((InputEvent.mouse_x >= 1) and (InputEvent.mouse_x <= RenderW)) and (InputEvent.mouse_y >= 1)) and
                         (InputEvent.mouse_y <= RenderH);
  if InputEvent.mouse_action = Console.MouseAction.ScrollUp then
    begin
      State.SpanY := Math.Max(State.SpanY * 0.88, 0.000001);
      RequestRedraw();
    end;
  else
    if InputEvent.mouse_action = Console.MouseAction.ScrollDown then
      begin
        State.SpanY := Math.Min(State.SpanY / 0.88, 4.0);
        RequestRedraw();
      end;
    else
      if InView and (InputEvent.mouse_action = Console.MouseAction.Down) then
        begin
          if InputEvent.mouse_button = Console.MouseButton.Left then
            begin
              State.CenterX := ViewportCX(State, RenderW, RenderH, InputEvent.mouse_x);
              State.CenterY := ViewportCY(State, RenderW, RenderH, InputEvent.mouse_y);
              RequestRedraw();
            end;
          else
            if InputEvent.mouse_button = Console.MouseButton.Middle then
              begin
                State := ResetCamera;
                RequestRedraw();
              end;
            end if;
          end if;
        end;
      end if;
    end if;
  end if;
end procedure;

procedure HandleResize(Width: integer; Height: integer);
begin
  var NewW: integer := Math.Max(Width, 1);
  var NewH: integer := Math.Max(Height - 2, 1);
  if (NewW <> RenderW) or (NewH <> RenderH) then
    begin
      RenderW := NewW;
      RenderH := NewH;
      RequestRedraw();
    end;
  end if;
end procedure;

procedure HandleEvent(E: Console.ConsoleEvent);
begin
  if E.kind = Console.EventKind.Key then
    begin
      discard HandleKey(E.key);
    end;
  else
    if E.kind = Console.EventKind.Mouse then
      begin
        HandleMouse(E);
      end;
    else
      if E.kind = Console.EventKind.Resize then
        begin
          HandleResize(E.width, E.height);
        end;
      end if;
    end if;
  end if;
end procedure;

procedure ShutdownTerminal();
begin
  Console.CursorOn();
  Console.DisablePaste();
  Console.DisableFocus();
  Console.DisableMouse();
  Console.DisableRawMode();
  Console.LeaveAltScreen();
end procedure;

// Runs one interactive explorer; renderer and palettes remain example-owned.
public procedure RunExplorer(
  Title: string;
  Initial: Camera.ExplorerCamera;
  RenderFrame: procedure(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: integer
);
  PaletteLabel: function(Value: integer): string
);
begin
  ResetCamera := Initial;
  State := Initial;
  Quit := false;
  Console.EnableRawMode();
  Console.EnterAltScreen();
  Console.EnableMouse();
  Console.EnableFocus();
  Console.EnablePaste();
  Console.CursorOff();
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  NeedsRedraw := true;
  while not Quit do
    begin
      if NeedsRedraw then
        begin
          PaintFrame(Title, RenderFrame, PaletteLabel);
          NeedsRedraw := false;
        end;
      end if;

      case Console.ReadEventTimeout(16) of
        when Some(E):
          begin
            HandleEvent(E);
          end;
        when None:
          begin
            null;
          end;
      end case;
    end;
  end while;

  ShutdownTerminal();
end procedure;

end unit;
