// Run as `fpas run julia.fpasprj` (multi-unit project). Interactive; see examples/README.md.

program JuliaShowcase;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Math as Math;
uses Std.Options as Options;
uses Std.Str as Str;
uses Julia.Color as Color;
uses Julia.Render as Render;

type ExplorerState = record
  CenterX: real;
  CenterY: real;
  SpanY: real;
  Jr: real;
  Ji: real;
  MaxIter: integer;
  Palette: Color.PaletteKind;
end record;

function ExplorerStateDefault(): ExplorerState;
begin
  return ExplorerState(CenterX := 0.0, CenterY := 0.0, SpanY := 2.4, Jr := -0.8, Ji := 0.156, MaxIter := 96, Palette := Color.PaletteKind.DeepOcean);
end function;

function ExplorerStateSpanX(Receiver: ExplorerState; Width: integer; Height: integer): real;
begin
  const SafeWidth: integer := Math.Max(Width, 1);
  const SafeHeight: integer := Math.Max(Height, 1);
  return (Receiver.SpanY * (Conv.IntToReal(SafeWidth) / Conv.IntToReal(SafeHeight))) * 0.5;
end function;

function ExplorerStateXMin(Receiver: ExplorerState; Width: integer; Height: integer): real;
begin
  return Receiver.CenterX - (ExplorerStateSpanX(Receiver, Width, Height) * 0.5);
end function;

function ExplorerStateXMax(Receiver: ExplorerState; Width: integer; Height: integer): real;
begin
  return Receiver.CenterX + (ExplorerStateSpanX(Receiver, Width, Height) * 0.5);
end function;

function ExplorerStateYMin(Receiver: ExplorerState): real;
begin
  return Receiver.CenterY - (Receiver.SpanY * 0.5);
end function;

function ExplorerStateYMax(Receiver: ExplorerState): real;
begin
  return Receiver.CenterY + (Receiver.SpanY * 0.5);
end function;

function ExplorerStateGetZoom(Receiver: ExplorerState): real;
begin
  return 2.4 / Receiver.SpanY;
end function;

function RenderWidth(): integer;
begin
  return Math.Max(Console.ScreenWidth(), 1);
end function;

function RenderHeight(): integer;
begin
  return Math.Max(Console.ScreenHeight() - 3, 1);
end function;

function ViewportCX(State: ExplorerState; W: integer; H: integer; CellX: integer): real;
begin
  const Wr: integer := Math.Max(W - 1, 1);
  return ExplorerStateXMin(State, W, H) +
         (Conv.IntToReal(CellX - 1) / Conv.IntToReal(Wr)) * (ExplorerStateXMax(State, W, H) - ExplorerStateXMin(State, W, H));
end function;

function ViewportCY(State: ExplorerState; W: integer; H: integer; CellY: integer): real;
begin
  const Hr: integer := Math.Max(H - 1, 1);
  return ExplorerStateYMax(State) -
         (Conv.IntToReal(CellY - 1) / Conv.IntToReal(Hr)) * (ExplorerStateYMax(State) - ExplorerStateYMin(State));
end function;

procedure WriteHudText(Text: string; Width: integer);
begin
  if Width > 0 then
    begin
      const TextLength: integer := Math.Min(Str.Length(Text), Width);
      if TextLength > 0 then
        begin
          Console.WriteText(Str.Substring(Text, 0, TextLength));
        end;
      end if;
    end;
  end if;
end procedure;

procedure DrawHud(S: ExplorerState; Width: integer; Height: integer);
begin
  Console.Window(1, 1, Console.ScreenWidth(), Console.ScreenHeight());
  const HudTop: integer := Math.Max(Console.ScreenHeight() - 2, 1);
  Console.Window(1, HudTop, Console.ScreenWidth(), Console.ScreenHeight());
  Console.NormVideo();
  Console.ClrScr();
  Console.GotoXY(1, 1);
  Console.TextColorRGB(255, 220, 120);
  const Title: string := 'Functional Pascal Julia';
  WriteHudText(Title, Width);
  Console.TextColorRGB(156, 204, 255);
  WriteHudText('  tasks | units | records | postfix | truecolor', Math.Max(Width - Str.Length(Title), 0));
  if Console.ScreenHeight() >= 2 then
    begin
      Console.GotoXY(1, 2);
      Console.NormVideo();
      WriteHudText(Str.Format('size=%dx%d  c=(%f,%f)  jr=%f  ji=%f  zoom=%f  iter=%d  pal=%s', Width, Height, S.CenterX, S.CenterY, S.Jr, S.Ji, ExplorerStateGetZoom(S), S.MaxIter, Color.PaletteName(S.Palette)), Width);
    end;
  end if;

  if Console.ScreenHeight() >= 3 then
    begin
      Console.GotoXY(1, 3);
      Console.NormVideo();
      WriteHudText('WASD=const  click  wheel  arrows  +/-  PgUp/Dn  1/2/3  R  Esc', Width);
    end;
  end if;

  Console.NormVideo();
  Console.Window(1, 1, Width, Height);
end procedure;

var State: ExplorerState := ExplorerStateDefault();
var RenderW: integer := 1;
var RenderH: integer := 1;
var NeedsRedraw: boolean := true;
var Quit: boolean := false;
var ActiveRender: Option of (Render.RenderJob) := Option.None;

procedure RequestRedraw();
begin
  NeedsRedraw := true;
end procedure;

procedure PaintFrame();
begin
  case ActiveRender of
    when Option.Some(const Job):
      begin
        Render.StopRender(Job);
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  RenderW := RenderWidth();
  RenderH := RenderHeight();
  Console.BeginFrame();
  Console.FillRect(Console.rect(x := 1, y := 1, width := Console.ScreenWidth(), height := Console.ScreenHeight()), Console.cell(glyph := ' ', foreground := Console.RgbColor(0, 0, 0), background := Console.RgbColor(0, 0, 0)));
  ActiveRender := Option.Some(Render.StartRender(ExplorerStateXMin(State, RenderW, RenderH), ExplorerStateXMax(State, RenderW, RenderH), ExplorerStateYMin(State), ExplorerStateYMax(State), RenderW, RenderH, State.MaxIter, State.Palette, State.Jr, State.Ji));
  DrawHud(State, RenderW, RenderH);
  Console.Present();
end procedure;

function HandleKey(Key: Console.KeyEvent): boolean;
begin
  const StepX: real := ExplorerStateSpanX(State, RenderW, RenderH) * 0.14;
  const StepY: real := State.SpanY * 0.14;
  if Key.kind = Console.KeyKind.Escape then
    begin
      Quit := true;
      return true;
    end;
  else
    if Key.kind = Console.KeyKind.Left then
      begin
        State.CenterX := State.CenterX - StepX;
        RequestRedraw();
        return true;
      end;
    else
      if Key.kind = Console.KeyKind.Right then
        begin
          State.CenterX := State.CenterX + StepX;
          RequestRedraw();
          return true;
        end;
      else
        if Key.kind = Console.KeyKind.Up then
          begin
            State.CenterY := State.CenterY + StepY;
            RequestRedraw();
            return true;
          end;
        else
          if Key.kind = Console.KeyKind.Down then
            begin
              State.CenterY := State.CenterY - StepY;
              RequestRedraw();
              return true;
            end;
          else
            if Key.kind = Console.KeyKind.PageUp then
              begin
                State.MaxIter := Math.Min(State.MaxIter + 32, 2048);
                RequestRedraw();
                return true;
              end;
            else
              if Key.kind = Console.KeyKind.PageDown then
                begin
                  State.MaxIter := Math.Max(State.MaxIter - 32, 32);
                  RequestRedraw();
                  return true;
                end;
              else
                if Key.kind = Console.KeyKind.Character then
                  begin
                    case Key.ch of
                      when '+', '=':
                        begin
                          State.SpanY := Math.Max(State.SpanY * 0.82, 0.000001);
                          RequestRedraw();
                          return true;
                        end;
                      when '-':
                        begin
                          State.SpanY := Math.Min(State.SpanY / 0.82, 3.5);
                          RequestRedraw();
                          return true;
                        end;
                      when '1':
                        begin
                          State.Palette := Color.PaletteKind.DeepOcean;
                          RequestRedraw();
                          return true;
                        end;
                      when '2':
                        begin
                          State.Palette := Color.PaletteKind.Ember;
                          RequestRedraw();
                          return true;
                        end;
                      when '3':
                        begin
                          State.Palette := Color.PaletteKind.Aurora;
                          RequestRedraw();
                          return true;
                        end;
                      when 'a', 'A':
                        begin
                          State.Jr := State.Jr - 0.02;
                          RequestRedraw();
                          return true;
                        end;
                      when 'd', 'D':
                        begin
                          State.Jr := State.Jr + 0.02;
                          RequestRedraw();
                          return true;
                        end;
                      when 'w', 'W':
                        begin
                          State.Ji := State.Ji + 0.02;
                          RequestRedraw();
                          return true;
                        end;
                      when 's', 'S':
                        begin
                          State.Ji := State.Ji - 0.02;
                          RequestRedraw();
                          return true;
                        end;
                      when 'r', 'R':
                        begin
                          State := ExplorerStateDefault();
                          RequestRedraw();
                          return true;
                        end;
                    end case;
                  end;
                end if;
              end if;
            end if;
          end if;
        end if;
      end if;
    end if;
  end if;

  return false;
end function;

procedure HandleMouse(InputEvent: Console.ConsoleEvent);
begin
  const InView: boolean := (((InputEvent.mouse_x >= 1) and (InputEvent.mouse_x <= RenderW)) and (InputEvent.mouse_y >= 1)) and
                           (InputEvent.mouse_y <= RenderH);
  if InputEvent.mouse_action = Console.MouseAction.ScrollUp then
    begin
      State.SpanY := Math.Max(State.SpanY * 0.88, 0.000001);
      RequestRedraw();
    end;
  else
    if InputEvent.mouse_action = Console.MouseAction.ScrollDown then
      begin
        State.SpanY := Math.Min(State.SpanY / 0.88, 3.5);
        RequestRedraw();
      end;
    else
      if InView and (InputEvent.mouse_action = Console.MouseAction.Down) then
        begin
          if InputEvent.mouse_button = Console.MouseButton.Left then
            begin
              State.CenterX := ViewportCX(State, RenderW, RenderH, InputEvent.mouse_x);
              State.CenterY := ViewportCY(State, RenderW, RenderH, InputEvent.mouse_y);
              RequestRedraw();
            end;
          else
            if InputEvent.mouse_button = Console.MouseButton.Middle then
              begin
                State := ExplorerStateDefault();
                RequestRedraw();
              end;
            end if;
          end if;
        end;
      end if;
    end if;
  end if;
end procedure;

procedure HandleResize(Width: integer; Height: integer);
begin
  const NewW: integer := Math.Max(Width, 1);
  const NewH: integer := Math.Max(Height - 3, 1);
  if (NewW <> RenderW) or (NewH <> RenderH) then
    begin
      RenderW := NewW;
      RenderH := NewH;
      RequestRedraw();
    end;
  end if;
end procedure;

procedure HandleEvent(E: Console.ConsoleEvent);
begin
  if E.kind = Console.EventKind.Key then
    begin
      discard HandleKey(E.key);
    end;
  else
    if E.kind = Console.EventKind.Mouse then
      begin
        HandleMouse(E);
      end;
    else
      if E.kind = Console.EventKind.Resize then
        begin
          HandleResize(E.width, E.height);
        end;
      end if;
    end if;
  end if;
end procedure;

procedure ShutdownTerminal();
begin
  Console.CursorOn();
  Console.DisablePaste();
  Console.DisableFocus();
  Console.DisableMouse();
  Console.DisableRawMode();
  Console.LeaveAltScreen();
end procedure;

begin
  Console.EnableRawMode();
  Console.EnterAltScreen();
  Console.EnableMouse();
  Console.EnableFocus();
  Console.EnablePaste();
  Console.CursorOff();
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  NeedsRedraw := true;
  while not Quit do
    begin
      if NeedsRedraw then
        begin
          PaintFrame();
          NeedsRedraw := false;
        end;
      end if;

      case ActiveRender of
        when Option.Some(const Job):
          begin
            Console.BeginFrame();
            Render.PollRender(Job);
            Console.Present();
          end;
        when Option.None:
          begin
            null;
          end;
      end case;

      case Console.ReadEventTimeout(16) of
        when Option.Some(const E):
          begin
            HandleEvent(E);
          end;
        when Option.None:
          begin
            null;
          end;
      end case;
    end;
  end while;

  case ActiveRender of
    when Option.Some(const Job):
      begin
        Render.StopRender(Job);
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  ShutdownTerminal();
end program;
