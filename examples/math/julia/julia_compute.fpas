unit Julia.Compute;

uses Std.Tasks, Std.Math, Std.Conv;

type Complex = record
  public Re: real;
  public Im: real;

  public static function Create(Re: real; Im: real): Complex;
  begin
    return Complex(Re := Re, Im := Im);
  end function;

  public function Sq(Self: Complex): Complex;
  begin
    return Complex(Re := Self.Re * Self.Re - Self.Im * Self.Im, Im := (2.0 * Self.Re) * Self.Im);
  end function;

  public function Add(Self: Complex; Other: Complex): Complex;
  begin
    return Complex(Re := Self.Re + Other.Re, Im := Self.Im + Other.Im);
  end function;

  public function MagSq(Self: Complex): real;
  begin
    return Self.Re * Self.Re + Self.Im * Self.Im;
  end function;
end record;

public type PixelSample = record
  public IsInside: boolean;
  public EscapeValue: real;
end record;

function Iterate(Z0: Complex; C: Complex; MaxIter: integer; Token: CancellationToken): PixelSample;
begin
  const EscapeRadiusSq: real := 256.0;
  var Z: Complex := Z0;
  var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= EscapeRadiusSq) do
    begin
      if (N mod 32 = 0) and IsCancellationRequested(Token) then
        begin
          break;
        end;
      end if;

      Z := Z.Sq().Add(C);
      N := N + 1;
    end;
  end while;

  if N >= MaxIter then
    begin
      return PixelSample(IsInside := true, EscapeValue := 0.0);
    end;
  end if;
  const MagnitudeSq: real := Max(Z.MagSq(), 4.0);
  const Smooth: real := (IntToReal(N) + 1.0) - (Log(Log(MagnitudeSq) * 0.5) / Log(2.0));
  return PixelSample(IsInside := false, EscapeValue := Smooth);
end function;

// Compute one row, returning an empty array when cancellation is observed.
public function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer;
  Jr: real;
  Ji: real;
  Token: CancellationToken
): array of PixelSample;
begin
  var WidthRange: integer := Width - 1;
  var HeightRange: integer := Height - 1;
  if WidthRange < 1 then
    begin
      WidthRange := 1;
    end;
  end if;

  if HeightRange < 1 then
    begin
      HeightRange := 1;
    end;
  end if;
  const Wr: real := IntToReal(WidthRange);
  const Hr: real := IntToReal(HeightRange);
  const cy: real := YMax - (Py / Hr) * (YMax - YMin);
  const C: Complex := Complex.Create(Jr, Ji);
  var Row: array of PixelSample := [];
  for Px: integer := 0 to Width - 1 do
    begin
      if IsCancellationRequested(Token) then
        begin
          return [];
        end;
      end if;
      const cx: real := XMin + (Px / Wr) * (XMax - XMin);
      Row.Push(Iterate(Complex.Create(cx, cy), C, MaxIter, Token));
    end;
  end for;

  if IsCancellationRequested(Token) then
    begin
      return [];
    end;
  end if;

  return Row;
end function;
end unit;
