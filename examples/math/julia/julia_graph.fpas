{ Spec: docs/pascal/std/graph/app.md (from repository root). }

program JuliaGraph;

uses Std.Array, Std.Console, Std.Conv, Std.Graph, Std.Math;

type
  JuliaState = record
    CenterX: real;
    CenterY: real;
    SpanY: real;
    Jr: real;
    Ji: real;
    MaxIter: integer;
  end;

function DefaultState(): JuliaState;
begin
  return record
    CenterX := 0.0;
    CenterY := 0.0;
    SpanY := 2.4;
    Jr := -0.8;
    Ji := 0.156;
    MaxIter := 96;
  end
end;

function SpanX(State: JuliaState; Width: integer; Height: integer): real;
begin
  var SafeWidth: integer := Max(Width, 1);
  var SafeHeight: integer := Max(Height, 1);
  return State.SpanY * (IntToReal(SafeWidth) / IntToReal(SafeHeight))
end;

function ViewportCX(State: JuliaState; Width: integer; Height: integer; PixelX: integer): real;
begin
  var Wr: integer := Max(Width - 1, 1);
  var XMin: real := State.CenterX - (SpanX(State, Width, Height) * 0.5);
  return XMin + (IntToReal(PixelX) / IntToReal(Wr)) * SpanX(State, Width, Height)
end;

function ViewportCY(State: JuliaState; Height: integer; PixelY: integer): real;
begin
  var Hr: integer := Max(Height - 1, 1);
  var YMax: real := State.CenterY + (State.SpanY * 0.5);
  return YMax - (IntToReal(PixelY) / IntToReal(Hr)) * State.SpanY
end;

function SampleColor(Iter: integer; MaxIter: integer): integer;
begin
  if Iter >= MaxIter then
  begin
    return 132104
  end;
  case Iter mod 8 of
    0:
    begin
      return 1188971
    end;
    1:
    begin
      return 1723535
    end;
    2:
    begin
      return 2783935
    end;
    3:
    begin
      return 3974872
    end;
    4:
    begin
      return 5687403
    end;
    5:
    begin
      return 13745714
    end;
    6:
    begin
      return 15632954
    end
    else
    begin
      return 14240870
    end
  end
end;

function BuildFrame(State: JuliaState; Width: integer; Height: integer): array of integer;
begin
  var WidthRange: integer := Max(Width - 1, 1);
  var HeightRange: integer := Max(Height - 1, 1);
  var XSpan: real := SpanX(State, Width, Height);
  var XMin: real := State.CenterX - (XSpan * 0.5);
  var XMax: real := State.CenterX + (XSpan * 0.5);
  var YMin: real := State.CenterY - (State.SpanY * 0.5);
  var YMax: real := State.CenterY + (State.SpanY * 0.5);
  mutable var Pixels: array of integer := [];
  for Py: integer := 0 to Height - 1 do
  begin
    var Zy0: real := YMax - (IntToReal(Py) / IntToReal(HeightRange)) * (YMax - YMin);
    for Px: integer := 0 to Width - 1 do
    begin
      var Zx0: real := XMin + (IntToReal(Px) / IntToReal(WidthRange)) * (XMax - XMin);
      mutable var Zr: real := Zx0;
      mutable var Zi: real := Zy0;
      mutable var N: integer := 0;
      while (N < State.MaxIter) and ((Zr * Zr + Zi * Zi) <= 4.0) do
      begin
        var Tr: real := (Zr * Zr - Zi * Zi) + State.Jr;
        var Ti: real := (2.0 * Zr) * Zi + State.Ji;
        Zr := Tr;
        Zi := Ti;
        N := N + 1
      end;
      Push(Pixels, SampleColor(N, State.MaxIter))
    end
  end;
  return Pixels
end;

procedure DrawHud(App: Application; State: JuliaState);
begin
  Application.FillRect(App, 0, 0, 92, 52, 16);
  Application.DrawRect(App, 0, 0, 92, 52, 16777215);
  Application.DrawText(App, 4, 4, 'JULIA', 16777215);
  Application.DrawText(App, 4, 13, 'JR ' + RealToStr(State.Jr), 16777215);
  Application.DrawText(App, 4, 22, 'JI ' + RealToStr(State.Ji), 16777215);
  Application.DrawText(App, 4, 31, 'ZOOM ' + RealToStr(2.4 / State.SpanY), 16777215);
  Application.DrawText(App, 4, 40, 'ESC R ARROWS', 16777215);
  Application.DrawText(App, 4, 49, 'WASD WHEEL', 16777215)
end;

mutable var
  mutable var State: JuliaState := DefaultState();
  mutable var RenderWidth: integer := 96;
  mutable var RenderHeight: integer := 72;

procedure RequestRender(App: Application);
begin
  Application.RequestRedraw(App)
end;

procedure OnPaint(App: Application);
begin
  var Screen: Size := Application.Size(App);
  RenderWidth := Max(Screen.width, 1);
  RenderHeight := Max(Screen.height, 1);
  var Frame: array of integer := BuildFrame(State, RenderWidth, RenderHeight);
  Application.UploadFrame(App, RenderWidth, RenderHeight, Frame);
  DrawHud(App, State)
end;

procedure ResetExplorer(App: Application);
begin
  State := DefaultState();
  RequestRender(App)
end;

function OnKeyPressed(App: Application; Key: Std.Console.KeyEvent): boolean;
begin
  var StepX: real := SpanX(State, RenderWidth, RenderHeight) * 0.12;
  var StepY: real := State.SpanY * 0.12;
  if Key.kind = KeyKind.Escape then
  begin
    Application.HostRequestQuit(App);
    return true
  end
  else if Key.kind = KeyKind.Left then
  begin
    State.CenterX := State.CenterX - StepX;
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.Right then
  begin
    State.CenterX := State.CenterX + StepX;
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.Up then
  begin
    State.CenterY := State.CenterY + StepY;
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.Down then
  begin
    State.CenterY := State.CenterY - StepY;
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.Character then
  begin
    case Key.ch of
      '+', '=':
      begin
        State.SpanY := Max(State.SpanY * 0.85, 0.000001);
        RequestRender(App)
      end;
      '-':
      begin
        State.SpanY := Min(State.SpanY / 0.85, 3.5);
        RequestRender(App)
      end;
      'r', 'R':
      begin
        ResetExplorer(App)
      end;
      'a', 'A':
      begin
        State.Jr := State.Jr - 0.02;
        RequestRender(App)
      end;
      'd', 'D':
      begin
        State.Jr := State.Jr + 0.02;
        RequestRender(App)
      end;
      'w', 'W':
      begin
        State.Ji := State.Ji + 0.02;
        RequestRender(App)
      end;
      's', 'S':
      begin
        State.Ji := State.Ji - 0.02;
        RequestRender(App)
      end
    end
  end;
  return false
end;

procedure OnMouse(App: Application; E: Std.Graph.Event);
begin
  if E.mouse_action = MouseAction.Down then
  begin
    if E.mouse_button = MouseButton.Left then
    begin
      State.CenterX := ViewportCX(State, RenderWidth, RenderHeight, E.mouse_x);
      State.CenterY := ViewportCY(State, RenderHeight, E.mouse_y);
      RequestRender(App)
    end
    else if E.mouse_button = MouseButton.Middle then
    begin
      ResetExplorer(App)
    end
  end
end;

procedure OnWheel(App: Application; E: Std.Graph.Event);
begin
  if E.wheel_y > 0 then
  begin
    State.SpanY := Max(State.SpanY * 0.85, 0.000001)
  end
  else if E.wheel_y < 0 then
  begin
    State.SpanY := Min(State.SpanY / 0.85, 3.5)
  end;
  RequestRender(App)
end;

procedure OnResize(App: Application; NewSize: Size);
begin
  RequestRender(App)
end;

begin
  var App: Application := Application.Open(96, 72, 'Julia graph');
  var Handlers: ApplicationHandlers := record
    OnPaint := OnPaint;
    OnKeyPressed := Some(OnKeyPressed);
    OnMouse := Some(OnMouse);
    OnWheel := Some(OnWheel);
    OnResize := Some(OnResize);
  end;
  Application.Configure(App, Handlers);
  Application.Run(App)
end.
