unit Julia.Render;

uses Std.Console as Console;
uses Std.Tasks as Tasks;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Math as Math;
uses Std.Str as Str;
uses Std.Results as Results;
uses Julia.Color as Color2;
uses Julia.Compute as Compute;

public type RenderRow = record
  public Y: integer;
  public Samples: array of (Compute.PixelSample);
end record;

function EscapeGlyph(EscapeValue: real): string;
begin
  const Ramp: string := ' ░▒▓█';
  const Count: integer := Str.Length(Ramp);
  const Phase: real := Math.Frac(EscapeValue * 0.08);
  const Index: integer := Math.Clamp(Math.Trunc(Phase * Conv.IntToReal(Count)), 0, Count - 1);
  return Str.CharAt(Ramp, Index);
end function;

function RenderCell(Sample: Compute.PixelSample; Palette: Color2.PaletteKind): Console.Cell;
begin
  if Sample.IsInside then
    begin
      const CellShade: Console.Color := Color2.InsideColor();
      return Console.Cell(glyph := ' ', foreground := CellShade, background := CellShade);
    end;
  end if;

  return Console.Cell(glyph := EscapeGlyph(Sample.EscapeValue), foreground := Color2.EscapeColor(Palette, Sample.EscapeValue), background := Console.RgbColor(0, 0, 0));
end function;

procedure DrawRow(
  Row: array of (Compute.PixelSample);
  Width: integer;
  Y: integer;
  Palette: Color2.PaletteKind
);
begin
  const CurrentWidth: integer := Console.ScreenWidth();
  var DrawWidth: integer := Width;
  if DrawWidth > CurrentWidth then
    begin
      DrawWidth := CurrentWidth;
    end;
  end if;

  if DrawWidth < 1 then
    begin
      return;
    end;
  end if;
  var Cells: array of (Console.Cell) := [];
  for Px: integer := 0 to DrawWidth - 1 do
    begin
      Arrays.Push(var Cells, RenderCell(Row[Px], Palette));
    end;
  end for;

  Console.WriteCells(1, Y, Cells);
end procedure;

// A render owns four workers and at most four queued rows.
public type RenderJob = record
  public Group: Tasks.TaskGroup;
  public Rows: channel of (RenderRow);
  public Width: integer;
  public Palette: Color2.PaletteKind;
end record;

// Start a bounded render. Each worker owns every fourth row.
public function StartRender(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: Color2.PaletteKind;
  Jr: real;
  Ji: real
): RenderJob;
begin
  const Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const Rows: channel of (RenderRow) := Tasks.CreateChannel(4);
  for Worker: integer := 0 to 3 do
    begin
      const WorkerHandle: task := Tasks.StartTaskInGroup(Group, procedure(Token: Tasks.CancellationToken) begin
        var Py: integer := Worker;
        while (Py < Height) and not Tasks.IsCancellationRequested(Token) do
          begin
            const Samples: array of (Compute.PixelSample) := Compute.ComputeRow(Py, Width, Height, XMin, XMax, YMin, YMax, MaxIter, Jr, Ji, Token);
            if Tasks.IsCancellationRequested(Token) then
              begin
                return;
              end;
            end if;
            const Row: RenderRow := RenderRow(Y := Py, Samples := Samples);
            if Results.IsError(Tasks.SendWithCancellation(Rows, Row, Token)) then
              begin
                return;
              end;
            end if;

            Py := Py + 4;
          end;
        end while;
      end procedure);
    end;
  end for;

  return RenderJob(Group := Group, Rows := Rows, Width := Width, Palette := Palette);
end function;

// Draw a bounded batch on the terminal-owning task without waiting for workers.
public procedure PollRender(Job: RenderJob);
begin
  for Index: integer := 1 to 4 do
    begin
      case Results.Unwrap(Tasks.TryReceive(Job.Rows)) of
        when Option.Some(const Row):
          begin
            if (Row.Y + 1) <= Math.Max(Console.ScreenHeight() - 3, 1) then
              begin
                DrawRow(Row.Samples, Job.Width, Row.Y + 1, Job.Palette);
              end;
            end if;
          end;
        when Option.None:
          begin
            return;
          end;
      end case;
    end;
  end for;
end procedure;

// Cancel CPU work and blocked sends before releasing the old queue.
// Joining first prevents old rows from appearing in a replacement render.
public procedure StopRender(Job: RenderJob);
begin
  const Failures: array of (Tasks.TaskFailure) := Tasks.CloseTaskGroup(Job.Group);
  discard Tasks.CloseChannel(Job.Rows);
  if Arrays.Length(Failures) <> 0 then
    begin
      panic(Failures[0].Message);
    end;
  end if;
end procedure;

end unit;
