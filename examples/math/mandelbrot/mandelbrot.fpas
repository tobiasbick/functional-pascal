// Run as `fpas run mandelbrot.fpasprj` (multi-unit project). Interactive; see README.md.

program MandelbrotShowcase;

uses
  Std.Console, Std.Tasks, Std.Tui, Mandelbrot.App, Mandelbrot.Model, Mandelbrot.Render,
  Mandelbrot.View;

begin
  const Inbox: channel of MandelbrotRenderFrame := CreateChannel(8);
  const Initial: MandelbrotModel := NewMandelbrotModel(Inbox, ScreenWidth(), ScreenHeight());
  discard TuiApplication.RunWithBackground(Initial, Inbox, UpdateMandelbrot, UpdateMandelbrotFrame, ViewMandelbrot);
end.
