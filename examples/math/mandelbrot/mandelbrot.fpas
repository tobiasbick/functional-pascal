{ Run as `fpas mandelbrot.fpasprj` (multi-unit project). Interactive; see examples/README.md. }

program MandelbrotShowcase;

uses Std.Console, Std.Conv, Std.Math, Std.Str, Std.Tui, Mandelbrot.Color, Mandelbrot.Render;

type
  ExplorerState = record
    CenterX: real;
    CenterY: real;
    SpanY: real;
    MaxIter: integer;
    Palette: PaletteKind;

    function SpanX(Self: ExplorerState; Width: integer; Height: integer): real;
    begin
      var SafeWidth: integer := Max(Width, 1);
      var SafeHeight: integer := Max(Height, 1);
      return (Self.SpanY * (IntToReal(SafeWidth) / IntToReal(SafeHeight))) * 0.5
    end;

    function XMin(Self: ExplorerState; Width: integer; Height: integer): real;
    begin
      return Self.CenterX - (Self.SpanX(Width, Height) * 0.5)
    end;

    function XMax(Self: ExplorerState; Width: integer; Height: integer): real;
    begin
      return Self.CenterX + (Self.SpanX(Width, Height) * 0.5)
    end;

    function YMin(Self: ExplorerState): real;
    begin
      return Self.CenterY - (Self.SpanY * 0.5)
    end;

    function YMax(Self: ExplorerState): real;
    begin
      return Self.CenterY + (Self.SpanY * 0.5)
    end;
  end;

function DefaultState(): ExplorerState;
begin
  return record
    CenterX := -0.75;
    CenterY := 0.0;
    SpanY := 2.4;
    MaxIter := 160;
    Palette := PaletteKind.DeepOcean;
  end
end;

function RenderWidth(): integer;
begin
  return Max(ScreenWidth(), 1)
end;

function RenderHeight(): integer;
begin
  return Max(ScreenHeight() - 2, 1)
end;

function ZoomLevel(State: ExplorerState): real;
begin
  return 2.4 / State.SpanY
end;

{ 1-based cell in the render viewport → complex plane (same mapping as row iteration) }

function ViewportCX(State: ExplorerState; W: integer; H: integer; CellX: integer): real;
begin
  var Wr: integer := Max(W - 1, 1);
  return State.XMin(W, H) +
         (IntToReal(CellX - 1) / IntToReal(Wr)) * (State.XMax(W, H) - State.XMin(W, H))
end;

function ViewportCY(State: ExplorerState; W: integer; H: integer; CellY: integer): real;
begin
  var Hr: integer := Max(H - 1, 1);
  return State.YMax() - (IntToReal(CellY - 1) / IntToReal(Hr)) * (State.YMax() - State.YMin())
end;

procedure DrawHud(S: ExplorerState; Width: integer; Height: integer);
begin
  Window(1, 1, ScreenWidth(), ScreenHeight());
  var HudTop: integer := Max(ScreenHeight() - 1, 1);
  Window(1, HudTop, ScreenWidth(), ScreenHeight());
  NormVideo();
  ClrScr();
  GotoXY(1, 1);
  TextColorRGB(255, 220, 120);
  Write('Functional Pascal Mandelbrot');
  TextColorRGB(156, 204, 255);
  Write('  tasks | units | records | truecolor | mouse | focus | paste');
  if ScreenHeight() >= 2 then
  begin
    GotoXY(1, 2);
    NormVideo();
    Write(Format('size=%dx%d  center=(%f, %f)  zoom=%f  iter=%d  palette=%s', Width, Height, S.CenterX, S.CenterY, ZoomLevel(S), S.MaxIter, PaletteName(S.Palette)));
    Write('  click center  wheel zoom  M middle=reset  arrows  +/-  PgUp/Dn  1/2/3  R  Esc')
  end;
  NormVideo();
  Window(1, 1, Width, Height)
end;

mutable var
  mutable var State: ExplorerState := DefaultState();
  mutable var RenderW: integer := 1;
  mutable var RenderH: integer := 1;

procedure OnPaint(App: Application);
begin
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  Window(1, 1, RenderW, RenderH);
  ClrScr();
  Render(State.XMin(RenderW, RenderH), State.XMax(RenderW, RenderH), State.YMin(), State.YMax(), RenderW, RenderH, State.MaxIter, State.Palette);
  DrawHud(State, RenderW, RenderH)
end;

function OnKeyPressed(App: Application; Key: Std.Console.KeyEvent): boolean;
begin
  var StepX: real := State.SpanX(RenderW, RenderH) * 0.14;
  var StepY: real := State.SpanY * 0.14;
  if Key.kind = KeyKind.Escape then
  begin
    Application.HostRequestQuit(App);
    return true
  end
  else if Key.kind = KeyKind.Left then
  begin
    State.CenterX := State.CenterX - StepX;
    Application.RequestRedraw(App);
    return true
  end
  else if Key.kind = KeyKind.Right then
  begin
    State.CenterX := State.CenterX + StepX;
    Application.RequestRedraw(App);
    return true
  end
  else if Key.kind = KeyKind.Up then
  begin
    State.CenterY := State.CenterY + StepY;
    Application.RequestRedraw(App);
    return true
  end
  else if Key.kind = KeyKind.Down then
  begin
    State.CenterY := State.CenterY - StepY;
    Application.RequestRedraw(App);
    return true
  end
  else if Key.kind = KeyKind.PageUp then
  begin
    State.MaxIter := Min(State.MaxIter + 32, 2048);
    Application.RequestRedraw(App);
    return true
  end
  else if Key.kind = KeyKind.PageDown then
  begin
    State.MaxIter := Max(State.MaxIter - 32, 32);
    Application.RequestRedraw(App);
    return true
  end
  else if Key.kind = KeyKind.Character then
  begin
    case Key.ch of
      '+', '=':
      begin
        State.SpanY := Max(State.SpanY * 0.82, 0.000001);
        Application.RequestRedraw(App);
        return true
      end;
      '-':
      begin
        State.SpanY := Min(State.SpanY / 0.82, 3.5);
        Application.RequestRedraw(App);
        return true
      end;
      '1':
      begin
        State.Palette := PaletteKind.DeepOcean;
        Application.RequestRedraw(App);
        return true
      end;
      '2':
      begin
        State.Palette := PaletteKind.Ember;
        Application.RequestRedraw(App);
        return true
      end;
      '3':
      begin
        State.Palette := PaletteKind.Aurora;
        Application.RequestRedraw(App);
        return true
      end;
      'r', 'R':
      begin
        State := DefaultState();
        Application.RequestRedraw(App);
        return true
      end
    end
  end;
  return false
end;

procedure OnMouse(App: Application; Event: Std.Console.Event);
begin
  var InView: boolean := Event.mouse_x >= 1;
  if Event.mouse_action = MouseAction.ScrollUp then
  begin
    State.SpanY := Max(State.SpanY * 0.88, 0.000001);
    Application.RequestRedraw(App)
  end
  else if Event.mouse_action = MouseAction.ScrollDown then
  begin
    State.SpanY := Min(State.SpanY / 0.88, 3.5);
    Application.RequestRedraw(App)
  end
  else if InView and (Event.mouse_action = MouseAction.Down) then
  begin
    if Event.mouse_button = MouseButton.Left then
    begin
      State.CenterX := ViewportCX(State, RenderW, RenderH, Event.mouse_x);
      State.CenterY := ViewportCY(State, RenderW, RenderH, Event.mouse_y);
      Application.RequestRedraw(App)
    end
    else if Event.mouse_button = MouseButton.Middle then
    begin
      State := DefaultState();
      Application.RequestRedraw(App)
    end
  end
end;

procedure OnResize(App: Application; NewSize: Size);
begin
  var NewW: integer := Max(NewSize.width, 1);
  var NewH: integer := Max(NewSize.height - 2, 1);
  if (NewW <> RenderW) or (NewH <> RenderH) then
  begin
    RenderW := NewW;
    RenderH := NewH;
    Application.RequestRedraw(App)
  end
end;

procedure OnExit(App: Application; Reason: ExitReason);
begin
  CursorOn();
  DisablePaste();
  DisableFocus();
  DisableMouse()
end;

begin
  var App: Application := Application.Open();
  RenderW := Max(ScreenWidth(), 1);
  RenderH := Max(ScreenHeight() - 2, 1);
  EnableMouse();
  EnableFocus();
  EnablePaste();
  CursorOff();
  var Handlers: ApplicationHandlers := record
    OnPaint := Some(OnPaint);
    OnKeyPressed := Some(OnKeyPressed);
    OnResize := Some(OnResize);
    OnMouse := Some(OnMouse);
    OnExit := Some(OnExit);
  end;
  Application.Configure(App, Handlers);
  Application.Run(App)
end.
