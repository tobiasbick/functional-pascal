{ Run as `fpas run mandelbrot.fpasprj` (multi-unit project). Interactive; see README.md. }

program MandelbrotShowcase;

uses
  Std.Array, Std.Console, Std.Conv, Std.Math, Std.Str, Std.Tui, Mandelbrot.Color, Mandelbrot.Render;

type
  ExplorerState = record
    CenterX: real;
    CenterY: real;
    SpanY: real;
    MaxIter: integer;
    Palette: PaletteKind;

    static function Default(): ExplorerState;
    begin
      return record
        CenterX := -0.75;
        CenterY := 0.0;
        SpanY := 2.4;
        MaxIter := 160;
        Palette := PaletteKind.DeepOcean;
      end
    end;

    function SpanX(Self: ExplorerState; Width: integer; Height: integer): real;
    begin
      return (Self.SpanY * (IntToReal(Max(Width, 1)) / IntToReal(Max(Height, 1)))) * 0.5
    end;

    function XMin(Self: ExplorerState; Width: integer; Height: integer): real;
    begin
      return Self.CenterX - (Self.SpanX(Width, Height) * 0.5)
    end;

    function XMax(Self: ExplorerState; Width: integer; Height: integer): real;
    begin
      return Self.CenterX + (Self.SpanX(Width, Height) * 0.5)
    end;

    function YMin(Self: ExplorerState): real;
    begin
      return Self.CenterY - (Self.SpanY * 0.5)
    end;

    function YMax(Self: ExplorerState): real;
    begin
      return Self.CenterY + (Self.SpanY * 0.5)
    end;

    function GetZoom(Self: ExplorerState): real;
    begin
      return 2.4 / Self.SpanY
    end;

    property Zoom: real read GetZoom;
  end;
  MandelbrotModel = record
    Explorer: ExplorerState;
    TerminalWidth: integer;
    TerminalHeight: integer;
    Grid: TuiCellGrid;
    HelpOpen: boolean;
  end;

function GridWidth(TerminalWidth: integer): integer;
begin
  return Max(TerminalWidth - 2, 1)
end;

function GridHeight(TerminalHeight: integer): integer;
begin
  return Max(TerminalHeight - 6, 1)
end;

function BuildModel(
  Explorer: ExplorerState;
  TerminalWidth: integer;
  TerminalHeight: integer;
  HelpOpen: boolean
): MandelbrotModel;
begin
  var Width: integer := Max(TerminalWidth, 1);
  var Height: integer := Max(TerminalHeight, 1);
  var RenderWidth: integer := GridWidth(Width);
  var RenderHeight: integer := GridHeight(Height);
  return record
    Explorer := Explorer;
    TerminalWidth := Width;
    TerminalHeight := Height;
    Grid := RenderGrid(Explorer.XMin(RenderWidth, RenderHeight), Explorer.XMax(RenderWidth, RenderHeight), Explorer.YMin(), Explorer.YMax(), RenderWidth, RenderHeight, Explorer.MaxIter, Explorer.Palette);
    HelpOpen := HelpOpen;
  end
end;

function ViewportX(State: ExplorerState; Width: integer; Height: integer; CellX: integer): real;
begin
  return State.XMin(Width, Height) +
         (IntToReal(CellX) / IntToReal(Max(Width - 1, 1))) * (State.XMax(Width, Height) - State.XMin(Width, Height))
end;

function ViewportY(State: ExplorerState; Height: integer; CellY: integer): real;
begin
  return State.YMax() -
         (IntToReal(CellY) / IntToReal(Max(Height - 1, 1))) * (State.YMax() - State.YMin())
end;

function UpdateKey(State: MandelbrotModel; Key: TuiKeyEvent): MandelbrotModel;
begin
  mutable var Explorer: ExplorerState := State.Explorer;
  var StepX: real := Explorer.SpanX(State.Grid.Width, State.Grid.Height) * 0.14;
  var StepY: real := Explorer.SpanY * 0.14;
  if Key.kind = TuiKeyKind.Left then
  begin
    Explorer.CenterX := Explorer.CenterX - StepX
  end
  else if Key.kind = TuiKeyKind.Right then
  begin
    Explorer.CenterX := Explorer.CenterX + StepX
  end
  else if Key.kind = TuiKeyKind.Up then
  begin
    Explorer.CenterY := Explorer.CenterY + StepY
  end
  else if Key.kind = TuiKeyKind.Down then
  begin
    Explorer.CenterY := Explorer.CenterY - StepY
  end
  else if Key.kind = TuiKeyKind.PageUp then
  begin
    Explorer.MaxIter := Min(Explorer.MaxIter + 32, 2048)
  end
  else if Key.kind = TuiKeyKind.PageDown then
  begin
    Explorer.MaxIter := Max(Explorer.MaxIter - 32, 32)
  end
  else if Key.kind = TuiKeyKind.Character then
  begin
    case Key.ch of
      '+', '=':
      begin
        Explorer.SpanY := Max(Explorer.SpanY * 0.82, 0.000001)
      end;
      '-':
      begin
        Explorer.SpanY := Min(Explorer.SpanY / 0.82, 3.5)
      end;
      '1':
      begin
        Explorer.Palette := PaletteKind.DeepOcean
      end;
      '2':
      begin
        Explorer.Palette := PaletteKind.Ember
      end;
      '3':
      begin
        Explorer.Palette := PaletteKind.Aurora
      end;
      'r', 'R':
      begin
        Explorer := ExplorerState.Default()
      end;
      'h', 'H':
      begin
        return BuildModel(Explorer, State.TerminalWidth, State.TerminalHeight, not State.HelpOpen)
      end
    end
  end;

  return BuildModel(Explorer, State.TerminalWidth, State.TerminalHeight, State.HelpOpen)
end;

function UpdatePointer(State: MandelbrotModel; Pointer: TuiPointerEvent): MandelbrotModel;
begin
  mutable var Explorer: ExplorerState := State.Explorer;
  if Pointer.Action = TuiPointerAction.ScrollUp then
  begin
    Explorer.SpanY := Max(Explorer.SpanY * 0.88, 0.000001)
  end
  else if Pointer.Action = TuiPointerAction.ScrollDown then
  begin
    Explorer.SpanY := Min(Explorer.SpanY / 0.88, 3.5)
  end
  else if ((((Pointer.Action = TuiPointerAction.Down) and (Pointer.Position.X >= 1)) and (Pointer.Position.X <= State.Grid.Width)) and (Pointer.Position.Y >= 1)) and
          (Pointer.Position.Y <= State.Grid.Height) then
  begin
    if Pointer.Button = TuiPointerButton.Left then
    begin
      Explorer.CenterX := ViewportX(Explorer, State.Grid.Width, State.Grid.Height, Pointer.Position.X -
                                                                                   1);
      Explorer.CenterY := ViewportY(Explorer, State.Grid.Height, Pointer.Position.Y - 1)
    end
    else if Pointer.Button = TuiPointerButton.Middle then
    begin
      Explorer := ExplorerState.Default()
    end
  end;

  return BuildModel(Explorer, State.TerminalWidth, State.TerminalHeight, State.HelpOpen)
end;

function UpdateMandelbrot(State: MandelbrotModel; Msg: TuiMsg; Cmd: TuiCmdOutput): MandelbrotModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.Key(Key):
    begin
      return UpdateKey(State, Key)
    end;
    TuiMsg.Pointer(Pointer):
    begin
      return UpdatePointer(State, Pointer)
    end;
    TuiMsg.Resize(Size):
    begin
      return BuildModel(State.Explorer, Size.Width, Size.Height, State.HelpOpen)
    end;
    TuiMsg.QuitRequested:
    begin
      if State.HelpOpen then
      begin
        return BuildModel(State.Explorer, State.TerminalWidth, State.TerminalHeight, false)
      end;

      Cmd.Set(TuiCmd.Quit);
      return State
    end
    else
    begin
      return State
    end
  end
end;

function ViewMandelbrot(State: MandelbrotModel): TuiElement;
begin
  var Detail: string := Format('center=(%f, %f)  zoom=%f  palette=%s', State.Explorer.CenterX, State.Explorer.CenterY, State.Explorer.Zoom, PaletteName(State.Explorer.Palette));
  var Main: TuiElement := TuiElementBuilders.MakeColumn([
                                                          TuiElementBuilders.MakePanel('Mandelbrot Explorer', [TuiElementBuilders.MakeCellGrid(State.Grid)]),
                                                          TuiElementBuilders.MakeRule(Detail),
                                                          TuiElementBuilders.MakeGauge('Iterations', State.Explorer.MaxIter, 2048),
                                                          TuiElementBuilders.MakeGauge('Zoom', Min(Trunc(State.Explorer.Zoom * 10.0), 1000), 1000),
                                                          TuiElementBuilders.MakeStatusLine([

                                                                                              TuiStatusItemBuilders.MakeKeyHint('Arrows', 'pan'),

                                                                                              TuiStatusItemBuilders.MakeKeyHint('+/-', 'zoom'),

                                                                                              TuiStatusItemBuilders.MakeKeyHint('1/2/3', 'palette'),

                                                                                              TuiStatusItemBuilders.MakeKeyHint('H', 'help'),

                                                                                              TuiStatusItemBuilders.MakeKeyHint('Esc', 'quit')



                                                                                            ])

                                                        ]);
  mutable var Children: array of TuiElement := [Main];
  if State.HelpOpen then
  begin
    Std.Array.Push(Children, TuiElementBuilders.MakeOverlay('Controls', [
                                                                          TuiElementBuilders.MakeColumnSpaced([

                                                                                                                TuiElementBuilders.MakeLabel('Arrow keys or click: pan and center'),

                                                                                                                TuiElementBuilders.MakeLabel('+ / - or wheel: zoom'),

                                                                                                                TuiElementBuilders.MakeLabel('PageUp / PageDown: iterations'),

                                                                                                                TuiElementBuilders.MakeLabel('1 / 2 / 3: color palette'),

                                                                                                                TuiElementBuilders.MakeLabel('R or middle click: reset'),

                                                                                                                TuiElementBuilders.MakeLabel('Esc: close this overlay')



                                                                                                              ], 1)

                                                                        ]))
  end;

  return TuiElementBuilders.MakeDesktop(None, Children)
end;

begin
  var Initial: MandelbrotModel := BuildModel(ExplorerState.Default(), ScreenWidth(), ScreenHeight(), false);
  TuiApplication.Run(Initial, UpdateMandelbrot, ViewMandelbrot)
end.
