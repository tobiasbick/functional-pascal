// Run as `fpas run mandelbrot.fpasprj` (multi-unit project). Interactive; see README.md.

program MandelbrotShowcase;

uses
  Std.Console, Std.Task, Std.Tui, Mandelbrot.App, Mandelbrot.Model, Mandelbrot.Render,
  Mandelbrot.View;

begin
  var Inbox: channel of MandelbrotRenderFrame := CreateChannel(8);
  var Initial: MandelbrotModel := NewMandelbrotModel(Inbox, ScreenWidth(), ScreenHeight());
  TuiApplication.RunWithBackground(Initial, Inbox, UpdateMandelbrot, UpdateMandelbrotFrame, ViewMandelbrot)
end.
