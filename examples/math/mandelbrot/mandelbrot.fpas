// Run as `fpas run mandelbrot.fpasprj` (multi-unit project). Interactive; see README.md.

program MandelbrotShowcase;

uses
  Std.Console as Console, Std.Tasks as Tasks, Std.Ui.Terminal as Tui, Mandelbrot.App as App,
  Mandelbrot.Model as Model, Mandelbrot.Render as Render, Mandelbrot.View as View;

begin
  const Inbox: channel of Render.MandelbrotRenderFrame := Tasks.CreateChannel(8);
  const Initial: Model.MandelbrotModel := Model.NewMandelbrotModel(
    Inbox,
    Console.ScreenWidth(),
    Console.ScreenHeight()
  );
  discard Tui.TuiApplication.RunWithBackground(
    Initial,
    Inbox,
    App.UpdateMandelbrot,
    App.UpdateMandelbrotFrame,
    View.ViewMandelbrot
  );
end.
