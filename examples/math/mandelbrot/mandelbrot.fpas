// Run as `fpas run mandelbrot.fpasprj` (multi-unit project). Interactive; see README.md.

program MandelbrotShowcase;

uses Std.Console as Console;
uses Std.Tasks as Tasks;
uses Std.Tui as Tui;
uses Mandelbrot.App as App;
uses Mandelbrot.Model as Model;
uses Mandelbrot.Render as Render;
uses Mandelbrot.View as View;
uses Std.Tui.Runtime as Runtime;

begin
  const Inbox: channel of (Render.MandelbrotRenderFrame) := Tasks.CreateChannel(8);
  const Initial: Model.MandelbrotModel := Model.NewMandelbrotModel(Inbox, Console.ScreenWidth(), Console.ScreenHeight());
  discard Runtime.TuiApplicationRunWithBackground(Initial, Inbox, App.UpdateMandelbrot, App.UpdateMandelbrotFrame, View.ViewMandelbrot);
end program;
