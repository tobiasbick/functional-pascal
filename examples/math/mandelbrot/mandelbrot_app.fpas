// Built only via mandelbrot-core.fpasprj — not a standalone program.

unit Mandelbrot.App;

uses
  Std.Console, Std.Conv, Std.Math, Std.Tasks, Std.Tui, Mandelbrot.Color, Mandelbrot.Model,
  Mandelbrot.Render;

const RenderSubscriptionId: integer := 1;

procedure QueueRender(State: MandelbrotModel; Cmd: TuiCmdOutput);
begin
  const Request: MandelbrotRenderRequest := MandelbrotRequest(State);
  const Inbox: channel of MandelbrotRenderFrame := State.Inbox;
  Cmd.ReplaceSubscription(RenderSubscriptionId, function(Token: CancellationToken): result of boolean, string begin
    return RunBackgroundRender(Request, Inbox, Token);
  end function);
end procedure;

function RestartRender(
  State: MandelbrotModel;
  Explorer: ExplorerState;
  TerminalWidth: integer;
  TerminalHeight: integer;
  Cmd: TuiCmdOutput
): MandelbrotModel;
begin
  var Next: MandelbrotModel := CreateMandelbrotModel(Explorer, TerminalWidth, TerminalHeight, State.HelpOpen, State.Generation +
                                                                                                              1, State.Inbox);
  if (Next.Grid.Width = State.Grid.Width) and (Next.Grid.Height = State.Grid.Height) then
    begin
      Next.Grid := State.Grid;
    end;
  end if;

  QueueRender(Next, Cmd);
  return Next;
end function;

function ToggleHelp(State: MandelbrotModel): MandelbrotModel;
begin
  return record
    Explorer := State.Explorer;
    TerminalWidth := State.TerminalWidth;
    TerminalHeight := State.TerminalHeight;
    Grid := State.Grid;
    HelpOpen := not State.HelpOpen;
    Generation := State.Generation;
    RowsRendered := State.RowsRendered;
    FailureMessage := State.FailureMessage;
    Inbox := State.Inbox;
  end;
end function;

function WithFailure(State: MandelbrotModel; Message: string): MandelbrotModel;
begin
  return record
    Explorer := State.Explorer;
    TerminalWidth := State.TerminalWidth;
    TerminalHeight := State.TerminalHeight;
    Grid := State.Grid;
    HelpOpen := State.HelpOpen;
    Generation := State.Generation;
    RowsRendered := State.RowsRendered;
    FailureMessage := Message;
    Inbox := State.Inbox;
  end;
end function;

function ViewportX(State: ExplorerState; Width: integer; Height: integer; CellX: integer): real;
begin
  return State.XMin(Width, Height) +
         (IntToReal(CellX) / IntToReal(Max(Width - 1, 1))) * (State.XMax(Width, Height) - State.XMin(Width, Height));
end function;

function ViewportY(State: ExplorerState; Height: integer; CellY: integer): real;
begin
  return State.YMax() -
         (IntToReal(CellY) / IntToReal(Max(Height - 1, 1))) * (State.YMax() - State.YMin());
end function;

function UpdateKey(State: MandelbrotModel; Key: TuiKeyEvent; Cmd: TuiCmdOutput): MandelbrotModel;
begin
  var Explorer: ExplorerState := State.Explorer;
  var Changed: boolean := false;
  const StepX: real := Explorer.SpanX(State.Grid.Width, State.Grid.Height) * 0.14;
  const StepY: real := Explorer.SpanY * 0.14;
  if Key.kind = Std.Console.KeyKind.Left then
    begin
      Explorer.CenterX := Explorer.CenterX - StepX;
      Changed := true;
    end;
  elsif Key.kind = Std.Console.KeyKind.Right then
    begin
      Explorer.CenterX := Explorer.CenterX + StepX;
      Changed := true;
    end;
  elsif Key.kind = Std.Console.KeyKind.Up then
    begin
      Explorer.CenterY := Explorer.CenterY + StepY;
      Changed := true;
    end;
  elsif Key.kind = Std.Console.KeyKind.Down then
    begin
      Explorer.CenterY := Explorer.CenterY - StepY;
      Changed := true;
    end;
  elsif Key.kind = Std.Console.KeyKind.PageUp then
    begin
      Explorer.MaxIter := Min(Explorer.MaxIter + 32, 2048);
      Changed := true;
    end;
  elsif Key.kind = Std.Console.KeyKind.PageDown then
    begin
      Explorer.MaxIter := Max(Explorer.MaxIter - 32, 32);
      Changed := true;
    end;
  elsif Key.kind = Std.Console.KeyKind.Character then
    begin
      case Key.ch of
        when '+', '=':
          begin
            Explorer.SpanY := Max(Explorer.SpanY * 0.82, 0.000001);
            Changed := true;
          end;
        when '-':
          begin
            Explorer.SpanY := Min(Explorer.SpanY / 0.82, 3.5);
            Changed := true;
          end;
        when '1':
          begin
            Explorer.Palette := PaletteKind.DeepOcean;
            Changed := true;
          end;
        when '2':
          begin
            Explorer.Palette := PaletteKind.Ember;
            Changed := true;
          end;
        when '3':
          begin
            Explorer.Palette := PaletteKind.Aurora;
            Changed := true;
          end;
        when 'r', 'R':
          begin
            Explorer := ExplorerState.Default();
            Changed := true;
          end;
        when 'h', 'H':
          begin
            return ToggleHelp(State);
          end;
      end case;
    end;
  end if;

  if Changed then
    begin
      return RestartRender(State, Explorer, State.TerminalWidth, State.TerminalHeight, Cmd);
    end;
  end if;

  return State;
end function;

function UpdatePointer(State: MandelbrotModel; Pointer: TuiPointerEvent; Cmd: TuiCmdOutput): MandelbrotModel;
begin
  var Explorer: ExplorerState := State.Explorer;
  var Changed: boolean := false;
  if Pointer.Action = Std.Console.MouseAction.ScrollUp then
    begin
      Explorer.SpanY := Max(Explorer.SpanY * 0.88, 0.000001);
      Changed := true;
    end;
  elsif Pointer.Action = Std.Console.MouseAction.ScrollDown then
    begin
      Explorer.SpanY := Min(Explorer.SpanY / 0.88, 3.5);
      Changed := true;
    end;
  elsif ((((Pointer.Action = Std.Console.MouseAction.Down) and (Pointer.Position.X >= 1)) and (Pointer.Position.X <= State.Grid.Width)) and (Pointer.Position.Y >= 1)) and
        (Pointer.Position.Y <= State.Grid.Height) then
    begin
      if Pointer.Button = TuiPointerButton.Left then
        begin
          Explorer.CenterX := ViewportX(Explorer, State.Grid.Width, State.Grid.Height, Pointer.Position.X -
                                                                                       1);
          Explorer.CenterY := ViewportY(Explorer, State.Grid.Height, Pointer.Position.Y - 1);
          Changed := true;
        end;
      elsif Pointer.Button = TuiPointerButton.Middle then
        begin
          Explorer := ExplorerState.Default();
          Changed := true;
        end;
      end if;
    end;
  end if;

  if Changed then
    begin
      return RestartRender(State, Explorer, State.TerminalWidth, State.TerminalHeight, Cmd);
    end;
  end if;

  return State;
end function;

// Handles framework input and owns the render subscription lifecycle.
public function UpdateMandelbrot(State: MandelbrotModel; Msg: TuiMsg; Cmd: TuiCmdOutput): MandelbrotModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.Started:
      begin
        QueueRender(State, Cmd);
        return State;
      end;
    when TuiMsg.Key(Key):
      begin
        return UpdateKey(State, Key, Cmd);
      end;
    when TuiMsg.Pointer(Pointer):
      begin
        return UpdatePointer(State, Pointer, Cmd);
      end;
    when TuiMsg.Resize(Size):
      begin
        if (Size.Width = State.TerminalWidth) and (Size.Height = State.TerminalHeight) then
          begin
            return State;
          end;
        end if;

        return RestartRender(State, State.Explorer, Size.Width, Size.Height, Cmd);
      end;
    when TuiMsg.BackgroundFailed(Id, Kind, Message, Code, Line, Column):
      begin
        if Id = RenderSubscriptionId then
          begin
            return WithFailure(State, Message);
          end;
        end if;

        return State;
      end;
    when TuiMsg.QuitRequested:
      begin
        if State.HelpOpen then
          begin
            return ToggleHelp(State);
          end;
        end if;

        Cmd.Set(TuiCmd.Quit);
        return State;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

// Replaces the displayed image only after a complete current-generation render.
public function UpdateMandelbrotFrame(
  State: MandelbrotModel;
  Message: MandelbrotRenderFrame;
  Cmd: TuiCmdOutput
): MandelbrotModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  if (Message.Generation <> State.Generation) or
     (Message.Cells.Length() <> State.Grid.Width * State.Grid.Height) then
    begin
      return State;
    end;
  end if;
  var Next: MandelbrotModel := State;
  Next.Grid := TuiCellGrid.Create(State.Grid.Width, State.Grid.Height, Message.Cells);
  Next.RowsRendered := State.Grid.Height;
  return Next;
end function;
end unit;
