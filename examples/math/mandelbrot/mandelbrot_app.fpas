// Built only via mandelbrot-core.fpasprj — not a standalone program.

unit Mandelbrot.App;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Math as Math;
uses Std.Tasks as Tasks;
uses Std.Tui as Tui;
uses Mandelbrot.Color as Color;
uses Mandelbrot.Model as Model;
uses Mandelbrot.Render as Render;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Runtime as Runtime;

const RenderSubscriptionId: integer := 1;

procedure QueueRender(State: Model.MandelbrotModel; Cmd: Tui.TuiCmdOutput);
begin
  const Request: Render.MandelbrotRenderRequest := Model.MandelbrotRequest(State);
  const Inbox: channel of (Render.MandelbrotRenderFrame) := State.Inbox;
  Runtime.TuiCmdOutputReplaceSubscription(Cmd, RenderSubscriptionId, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
    return Render.RunBackgroundRender(Request, Inbox, Token);
  end function);
end procedure;

function RestartRender(
  State: Model.MandelbrotModel;
  Explorer: Model.ExplorerState;
  TerminalWidth: integer;
  TerminalHeight: integer;
  Cmd: Tui.TuiCmdOutput
): Model.MandelbrotModel;
begin
  var Next: Model.MandelbrotModel := Model.CreateMandelbrotModel(Explorer, TerminalWidth, TerminalHeight, State.HelpOpen, State.Generation +
                                                                                                                          1, State.Inbox);
  if (Next.Grid.Width = State.Grid.Width) and (Next.Grid.Height = State.Grid.Height) then
    begin
      Next.Grid := State.Grid;
    end;
  end if;

  QueueRender(Next, Cmd);
  return Next;
end function;

function ToggleHelp(State: Model.MandelbrotModel): Model.MandelbrotModel;
begin
  return Model.MandelbrotModel(Explorer := State.Explorer, TerminalWidth := State.TerminalWidth, TerminalHeight := State.TerminalHeight, Grid := State.Grid, HelpOpen := not State.HelpOpen, Generation := State.Generation, RowsRendered := State.RowsRendered, FailureMessage := State.FailureMessage, Inbox := State.Inbox);
end function;

function WithFailure(State: Model.MandelbrotModel; Message: string): Model.MandelbrotModel;
begin
  return Model.MandelbrotModel(Explorer := State.Explorer, TerminalWidth := State.TerminalWidth, TerminalHeight := State.TerminalHeight, Grid := State.Grid, HelpOpen := State.HelpOpen, Generation := State.Generation, RowsRendered := State.RowsRendered, FailureMessage := Message, Inbox := State.Inbox);
end function;

function ViewportX(State: Model.ExplorerState; Width: integer; Height: integer; CellX: integer): real;
begin
  return Model.ExplorerStateXMin(State, Width, Height) +
         (Conv.IntToReal(CellX) / Conv.IntToReal(Math.Max(Width - 1, 1))) * (Model.ExplorerStateXMax(State, Width, Height) - Model.ExplorerStateXMin(State, Width, Height));
end function;

function ViewportY(State: Model.ExplorerState; Height: integer; CellY: integer): real;
begin
  return Model.ExplorerStateYMax(State) -
         (Conv.IntToReal(CellY) / Conv.IntToReal(Math.Max(Height - 1, 1))) * (Model.ExplorerStateYMax(State) - Model.ExplorerStateYMin(State));
end function;

function UpdateKey(State: Model.MandelbrotModel; Key: Tui.TuiKeyEvent; Cmd: Tui.TuiCmdOutput): Model.MandelbrotModel;
begin
  var Explorer: Model.ExplorerState := State.Explorer;
  var Changed: boolean := false;
  const StepX: real := Model.ExplorerStateSpanX(Explorer, State.Grid.Width, State.Grid.Height) *
                       0.14;
  const StepY: real := Explorer.SpanY * 0.14;
  if Key.kind = Console.KeyKind.Left then
    begin
      Explorer.CenterX := Explorer.CenterX - StepX;
      Changed := true;
    end;
  else
    if Key.kind = Console.KeyKind.Right then
      begin
        Explorer.CenterX := Explorer.CenterX + StepX;
        Changed := true;
      end;
    else
      if Key.kind = Console.KeyKind.Up then
        begin
          Explorer.CenterY := Explorer.CenterY + StepY;
          Changed := true;
        end;
      else
        if Key.kind = Console.KeyKind.Down then
          begin
            Explorer.CenterY := Explorer.CenterY - StepY;
            Changed := true;
          end;
        else
          if Key.kind = Console.KeyKind.PageUp then
            begin
              Explorer.MaxIter := Math.Min(Explorer.MaxIter + 32, 2048);
              Changed := true;
            end;
          else
            if Key.kind = Console.KeyKind.PageDown then
              begin
                Explorer.MaxIter := Math.Max(Explorer.MaxIter - 32, 32);
                Changed := true;
              end;
            else
              if Key.kind = Console.KeyKind.Character then
                begin
                  case Key.ch of
                    when '+', '=':
                      begin
                        Explorer.SpanY := Math.Max(Explorer.SpanY * 0.82, 0.000001);
                        Changed := true;
                      end;
                    when '-':
                      begin
                        Explorer.SpanY := Math.Min(Explorer.SpanY / 0.82, 3.5);
                        Changed := true;
                      end;
                    when '1':
                      begin
                        Explorer.Palette := Color.PaletteKind.DeepOcean;
                        Changed := true;
                      end;
                    when '2':
                      begin
                        Explorer.Palette := Color.PaletteKind.Ember;
                        Changed := true;
                      end;
                    when '3':
                      begin
                        Explorer.Palette := Color.PaletteKind.Aurora;
                        Changed := true;
                      end;
                    when 'r', 'R':
                      begin
                        Explorer := Model.ExplorerStateDefault();
                        Changed := true;
                      end;
                    when 'h', 'H':
                      begin
                        return ToggleHelp(State);
                      end;
                  end case;
                end;
              end if;
            end if;
          end if;
        end if;
      end if;
    end if;
  end if;

  if Changed then
    begin
      return RestartRender(State, Explorer, State.TerminalWidth, State.TerminalHeight, Cmd);
    end;
  end if;

  return State;
end function;

function UpdatePointer(
  State: Model.MandelbrotModel;
  Pointer: Tui.TuiPointerEvent;
  Cmd: Tui.TuiCmdOutput
): Model.MandelbrotModel;
begin
  var Explorer: Model.ExplorerState := State.Explorer;
  var Changed: boolean := false;
  if Pointer.Action = Console.MouseAction.ScrollUp then
    begin
      Explorer.SpanY := Math.Max(Explorer.SpanY * 0.88, 0.000001);
      Changed := true;
    end;
  else
    if Pointer.Action = Console.MouseAction.ScrollDown then
      begin
        Explorer.SpanY := Math.Min(Explorer.SpanY / 0.88, 3.5);
        Changed := true;
      end;
    else
      if ((((Pointer.Action = Console.MouseAction.Down) and (Pointer.Position.X >= 1)) and (Pointer.Position.X <= State.Grid.Width)) and (Pointer.Position.Y >= 1)) and
         (Pointer.Position.Y <= State.Grid.Height) then
        begin
          if Pointer.Button = Tui.TuiPointerButton.Left then
            begin
              Explorer.CenterX := ViewportX(Explorer, State.Grid.Width, State.Grid.Height, Pointer.Position.X -
                                                                                           1);
              Explorer.CenterY := ViewportY(Explorer, State.Grid.Height, Pointer.Position.Y - 1);
              Changed := true;
            end;
          else
            if Pointer.Button = Tui.TuiPointerButton.Middle then
              begin
                Explorer := Model.ExplorerStateDefault();
                Changed := true;
              end;
            end if;
          end if;
        end;
      end if;
    end if;
  end if;

  if Changed then
    begin
      return RestartRender(State, Explorer, State.TerminalWidth, State.TerminalHeight, Cmd);
    end;
  end if;

  return State;
end function;

// Handles framework input and owns the render subscription lifecycle.
public function UpdateMandelbrot(State: Model.MandelbrotModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Model.MandelbrotModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        QueueRender(State, Cmd);
        return State;
      end;
    when Tui.TuiMsg.Key(const Key):
      begin
        return UpdateKey(State, Key, Cmd);
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return UpdatePointer(State, Pointer, Cmd);
      end;
    when Tui.TuiMsg.Resize(const Size):
      begin
        if (Size.Width = State.TerminalWidth) and (Size.Height = State.TerminalHeight) then
          begin
            return State;
          end;
        end if;

        return RestartRender(State, State.Explorer, Size.Width, Size.Height, Cmd);
      end;
    when Tui.TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      begin
        if Id = RenderSubscriptionId then
          begin
            return WithFailure(State, Message);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        if State.HelpOpen then
          begin
            return ToggleHelp(State);
          end;
        end if;

        Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
        return State;
      end;
    when Tui.TuiMsg.Tick(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _):
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

// Replaces the displayed image only after a complete current-generation render.
public function UpdateMandelbrotFrame(
  State: Model.MandelbrotModel;
  Message: Render.MandelbrotRenderFrame;
  Cmd: Tui.TuiCmdOutput
): Model.MandelbrotModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  if (Message.Generation <> State.Generation) or
     (Arrays.Length(Message.Cells) <> State.Grid.Width * State.Grid.Height) then
    begin
      return State;
    end;
  end if;
  var Next: Model.MandelbrotModel := State;
  Next.Grid := Chrome.TuiCellGridCreate(State.Grid.Width, State.Grid.Height, Message.Cells);
  Next.RowsRendered := State.Grid.Height;
  return Next;
end function;

end unit;
