{ Built only via mandelbrot.fpasprj — not a standalone program. }

unit Mandelbrot.Color;

uses Std.Math, Std.Tui;

type
  PaletteKind = enum
    DeepOcean;
    Ember;
    Aurora;
  end;

function PaletteName(Kind: PaletteKind): string;
begin
  case Kind of
    PaletteKind.DeepOcean:
    begin
      return 'Deep Ocean'
    end;
    PaletteKind.Ember:
    begin
      return 'Ember'
    end;
    PaletteKind.Aurora:
    begin
      return 'Aurora'
    end
  end
end;

private function BandIndex(EscapeValue: real): integer;
begin
  return Clamp(Trunc(Frac(EscapeValue * 0.08) * 12.0), 0, 11)
end;

function EscapeColor(Kind: PaletteKind; EscapeValue: real): TuiColor;
begin
  var Band: integer := BandIndex(EscapeValue);
  case Kind of
    PaletteKind.DeepOcean:
    begin
      case Band of
        0:
        begin
          return TuiColor.FromRgb(5, 16, 37)
        end;
        1:
        begin
          return TuiColor.FromRgb(11, 31, 70)
        end;
        2:
        begin
          return TuiColor.FromRgb(16, 51, 106)
        end;
        3:
        begin
          return TuiColor.FromRgb(20, 74, 138)
        end;
        4:
        begin
          return TuiColor.FromRgb(26, 99, 167)
        end;
        5:
        begin
          return TuiColor.FromRgb(34, 127, 193)
        end;
        6:
        begin
          return TuiColor.FromRgb(46, 156, 207)
        end;
        7:
        begin
          return TuiColor.FromRgb(76, 183, 216)
        end;
        8:
        begin
          return TuiColor.FromRgb(112, 208, 219)
        end;
        9:
        begin
          return TuiColor.FromRgb(161, 224, 216)
        end;
        10:
        begin
          return TuiColor.FromRgb(212, 237, 232)
        end
        else
        begin
          return TuiColor.FromRgb(242, 248, 255)
        end
      end
    end;
    PaletteKind.Ember:
    begin
      case Band of
        0:
        begin
          return TuiColor.FromRgb(64, 0, 0)
        end;
        1:
        begin
          return TuiColor.FromRgb(106, 10, 0)
        end;
        2:
        begin
          return TuiColor.FromRgb(138, 30, 0)
        end;
        3:
        begin
          return TuiColor.FromRgb(176, 58, 0)
        end;
        4:
        begin
          return TuiColor.FromRgb(212, 90, 0)
        end;
        5:
        begin
          return TuiColor.FromRgb(240, 122, 0)
        end;
        6:
        begin
          return TuiColor.FromRgb(255, 159, 26)
        end;
        7:
        begin
          return TuiColor.FromRgb(255, 190, 74)
        end;
        8:
        begin
          return TuiColor.FromRgb(255, 217, 120)
        end;
        9:
        begin
          return TuiColor.FromRgb(255, 231, 166)
        end;
        10:
        begin
          return TuiColor.FromRgb(255, 241, 204)
        end
        else
        begin
          return TuiColor.FromRgb(255, 248, 232)
        end
      end
    end;
    PaletteKind.Aurora:
    begin
      case Band of
        0:
        begin
          return TuiColor.FromRgb(4, 16, 32)
        end;
        1:
        begin
          return TuiColor.FromRgb(10, 46, 72)
        end;
        2:
        begin
          return TuiColor.FromRgb(16, 77, 106)
        end;
        3:
        begin
          return TuiColor.FromRgb(20, 104, 134)
        end;
        4:
        begin
          return TuiColor.FromRgb(25, 124, 143)
        end;
        5:
        begin
          return TuiColor.FromRgb(35, 142, 124)
        end;
        6:
        begin
          return TuiColor.FromRgb(52, 169, 104)
        end;
        7:
        begin
          return TuiColor.FromRgb(100, 191, 100)
        end;
        8:
        begin
          return TuiColor.FromRgb(148, 217, 118)
        end;
        9:
        begin
          return TuiColor.FromRgb(200, 230, 138)
        end;
        10:
        begin
          return TuiColor.FromRgb(234, 240, 180)
        end
        else
        begin
          return TuiColor.FromRgb(248, 248, 224)
        end
      end
    end
  end
end;

function InsideColor(): TuiColor;
begin
  return TuiColor.FromRgb(0, 0, 0)
end;
