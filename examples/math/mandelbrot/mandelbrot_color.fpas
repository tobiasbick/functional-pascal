{ Built only via mandelbrot.fpasprj — not a standalone program. }

unit Mandelbrot.Color;

uses Std.Console, Std.Math;

type
  PaletteKind = enum
    DeepOcean;
    Ember;
    Aurora;
  end;

function PaletteName(Kind: PaletteKind): string;
begin
  case Kind of
    PaletteKind.DeepOcean:
    begin
      return 'Deep Ocean'
    end;
    PaletteKind.Ember:
    begin
      return 'Ember'
    end;
    PaletteKind.Aurora:
    begin
      return 'Aurora'
    end
  end
end;

private function BandIndex(EscapeValue: real): integer;
begin
  return Clamp(Trunc(Frac(EscapeValue * 0.08) * 12.0), 0, 11)
end;

private function Sample(Kind: PaletteKind; EscapeValue: real): integer;
begin
  var Band: integer := BandIndex(EscapeValue);
  case Kind of
    PaletteKind.DeepOcean:
    begin
      case Band of
        0:
        begin
          return Blue
        end;
        1:
        begin
          return Blue
        end;
        2:
        begin
          return LightBlue
        end;
        3:
        begin
          return Cyan
        end;
        4:
        begin
          return LightCyan
        end;
        5:
        begin
          return LightCyan
        end;
        6:
        begin
          return Green
        end;
        7:
        begin
          return LightGreen
        end;
        8:
        begin
          return Yellow
        end;
        9:
        begin
          return LightGray
        end;
        10:
        begin
          return White
        end
        else
        begin
          return White
        end
      end
    end;
    PaletteKind.Ember:
    begin
      case Band of
        0:
        begin
          return Red
        end;
        1:
        begin
          return Red
        end;
        2:
        begin
          return LightRed
        end;
        3:
        begin
          return Brown
        end;
        4:
        begin
          return Yellow
        end;
        5:
        begin
          return Yellow
        end;
        6:
        begin
          return LightGray
        end;
        7:
        begin
          return White
        end;
        8:
        begin
          return LightMagenta
        end;
        9:
        begin
          return Magenta
        end;
        10:
        begin
          return LightRed
        end
        else
        begin
          return White
        end
      end
    end;
    PaletteKind.Aurora:
    begin
      case Band of
        0:
        begin
          return DarkGray
        end;
        1:
        begin
          return Blue
        end;
        2:
        begin
          return LightBlue
        end;
        3:
        begin
          return Cyan
        end;
        4:
        begin
          return LightCyan
        end;
        5:
        begin
          return Green
        end;
        6:
        begin
          return LightGreen
        end;
        7:
        begin
          return LightGreen
        end;
        8:
        begin
          return Yellow
        end;
        9:
        begin
          return LightGray
        end;
        10:
        begin
          return White
        end
        else
        begin
          return White
        end
      end
    end
  end
end;

procedure ApplyInsideColor();
begin
  TextBackground(Black);
  TextColor(Black)
end;

procedure ApplyEscapeColor(Kind: PaletteKind; EscapeValue: real);
begin
  TextBackground(Black);
  TextColor(Sample(Kind, EscapeValue))
end;
