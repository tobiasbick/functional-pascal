{ Spec: docs/pascal/std/graph/app.md (from repository root). }

program MandelbrotGraph;

uses Std.Array, Std.Console, Std.Conv, Std.Graph, Std.Math, Std.Task;

type
  MandelbrotState = record
    CenterX: real;
    CenterY: real;
    SpanY: real;
    MaxIter: integer;
    Palette: integer;
  end;

function DefaultState(): MandelbrotState;
begin
  return record CenterX := -0.75; CenterY := 0.0; SpanY := 2.4; MaxIter := 160; Palette := 1; end
end;

function SpanX(State: MandelbrotState; Width: integer; Height: integer): real;
begin
  var SafeWidth: integer := Max(Width, 1);
  var SafeHeight: integer := Max(Height, 1);
  return State.SpanY * (IntToReal(SafeWidth) / IntToReal(SafeHeight))
end;

function ViewportCX(State: MandelbrotState; Width: integer; Height: integer; PixelX: integer): real;
begin
  var Wr: integer := Max(Width - 1, 1);
  var XMin: real := State.CenterX - (SpanX(State, Width, Height) * 0.5);
  return XMin + (IntToReal(PixelX) / IntToReal(Wr)) * SpanX(State, Width, Height)
end;

function ViewportCY(State: MandelbrotState; Height: integer; PixelY: integer): real;
begin
  var Hr: integer := Max(Height - 1, 1);
  var YMax: real := State.CenterY + (State.SpanY * 0.5);
  return YMax - (IntToReal(PixelY) / IntToReal(Hr)) * State.SpanY
end;

function PaletteName(Palette: integer): string;
begin
  case Palette of
    1:
    begin
      return 'OCEAN'
    end;
    2:
    begin
      return 'EMBER'
    end;
    3:
    begin
      return 'AURORA'
    end
    else
    begin
      return 'OCEAN'
    end
  end
end;

function SampleColor(Palette: integer; EscapeValue: real): integer;
begin
  var Band: integer := Clamp(Trunc(Frac(EscapeValue * 0.08) * 12.0), 0, 11);
  if Palette = 2 then
  begin
    case Band of
      0:
      begin
        return 4194304
      end;
      1:
      begin
        return 6949376
      end;
      2:
      begin
        return 9051648
      end;
      3:
      begin
        return 11549184
      end;
      4:
      begin
        return 13916672
      end;
      5:
      begin
        return 15759872
      end;
      6:
      begin
        return 16752410
      end;
      7:
      begin
        return 16760394
      end;
      8:
      begin
        return 16767352
      end;
      9:
      begin
        return 16770982
      end;
      10:
      begin
        return 16773580
      end
      else
      begin
        return 16775400
      end
    end
  end
  else if Palette = 3 then
  begin
    case Band of
      0:
      begin
        return 266272
      end;
      1:
      begin
        return 667208
      end;
      2:
      begin
        return 1068394
      end;
      3:
      begin
        return 1337478
      end;
      4:
      begin
        return 1670287
      end;
      5:
      begin
        return 2330236
      end;
      6:
      begin
        return 3451240
      end;
      7:
      begin
        return 6602596
      end;
      8:
      begin
        return 9754998
      end;
      9:
      begin
        return 13166218
      end;
      10:
      begin
        return 15397044
      end
      else
      begin
        return 16316640
      end
    end
  end
  else
  begin
    case Band of
      0:
      begin
        return 331813
      end;
      1:
      begin
        return 728902
      end;
      2:
      begin
        return 1061738
      end;
      3:
      begin
        return 1329802
      end;
      4:
      begin
        return 1729447
      end;
      5:
      begin
        return 2260929
      end;
      6:
      begin
        return 3054799
      end;
      7:
      begin
        return 5027800
      end;
      8:
      begin
        return 7393499
      end;
      9:
      begin
        return 10608856
      end;
      10:
      begin
        return 13954536
      end
      else
      begin
        return 15923455
      end
    end
  end
end;

function BuildFrameRow(State: MandelbrotState; Width: integer; Height: integer; Py: integer): array of integer;
begin
  var WidthRange: integer := Max(Width - 1, 1);
  var HeightRange: integer := Max(Height - 1, 1);
  var XSpan: real := SpanX(State, Width, Height);
  var XMin: real := State.CenterX - (XSpan * 0.5);
  var XMax: real := State.CenterX + (XSpan * 0.5);
  var YMin: real := State.CenterY - (State.SpanY * 0.5);
  var YMax: real := State.CenterY + (State.SpanY * 0.5);
  var Cy: real := YMax - (IntToReal(Py) / IntToReal(HeightRange)) * (YMax - YMin);
  mutable var Row: array of integer := [];
  for Px: integer := 0 to Width - 1 do
  begin
    var Cx: real := XMin + (IntToReal(Px) / IntToReal(WidthRange)) * (XMax - XMin);
    mutable var Zr: real := 0.0;
    mutable var Zi: real := 0.0;
    mutable var N: integer := 0;
    while (N < State.MaxIter) and ((Zr * Zr + Zi * Zi) <= 256.0) do
    begin
      var Tr: real := (Zr * Zr - Zi * Zi) + Cx;
      var Ti: real := (2.0 * Zr) * Zi + Cy;
      Zr := Tr;
      Zi := Ti;
      N := N + 1
    end;
    if N >= State.MaxIter then
    begin
      Push(Row, 132104)
    end
    else
    begin
      var MagnitudeSq: real := Max(Zr * Zr + Zi * Zi, 4.0);
      var Smooth: real := (IntToReal(N) + 1.0) - (Log(Log(MagnitudeSq) * 0.5) / Log(2.0));
      Push(Row, SampleColor(State.Palette, Smooth))
    end
  end;
  return Row
end;

function BuildFrame(State: MandelbrotState; Width: integer; Height: integer): array of integer;
begin
  mutable var Tasks: array of task := [];
  mutable var Pixels: array of integer := [];
  for Py: integer := 0 to Height - 1 do
  begin
    Push(Tasks, go BuildFrameRow(State, Width, Height, Py))
  end;
  for Py: integer := 0 to Height - 1 do
  begin
    var Row: array of integer := Wait(Tasks[Py]);
    for Px: integer := 0 to Width - 1 do
    begin
      Push(Pixels, Row[Px])
    end
  end;
  return Pixels
end;

procedure DrawHud(App: Application; State: MandelbrotState);
begin
  Application.FillRect(App, 0, 0, 92, 61, 16);
  Application.DrawRect(App, 0, 0, 92, 61, 16777215);
  Application.DrawText(App, 4, 4, 'MANDELBROT', 16777215);
  Application.DrawText(App, 4, 13, 'ZOOM ' + RealToStr(2.4 / State.SpanY), 16777215);
  Application.DrawText(App, 4, 22, 'ITER ' + IntToStr(State.MaxIter), 16777215);
  Application.DrawText(App, 4, 31, 'PAL ' + PaletteName(State.Palette), 16777215);
  Application.DrawText(App, 4, 40, 'ESC R ARROWS', 16777215);
  Application.DrawText(App, 4, 49, '+ - PGUP PGDN', 16777215);
  Application.DrawText(App, 4, 58, '1 2 3 WHEEL', 16777215)
end;

mutable var
  mutable var State: MandelbrotState := DefaultState();

var
  var LogicalWidth: integer := 160;
  var LogicalHeight: integer := 100;

mutable var
  mutable var RenderWidth: integer := 160;
  mutable var RenderHeight: integer := 100;
  mutable var DisplayScaleFactor: integer := 1;
  mutable var DisplayOffsetX: integer := 0;
  mutable var DisplayOffsetY: integer := 0;
  mutable var DisplayWidth: integer := 160;
  mutable var DisplayHeight: integer := 100;

function ComputeDisplayScale(
  TargetWidth: integer;
  TargetHeight: integer;
  SourceWidth: integer;
  SourceHeight: integer
): integer;
begin
  return Max(1, Min(Max(TargetWidth, 1) div Max(SourceWidth, 1), Max(TargetHeight, 1) div

                                                                 Max(SourceHeight, 1)))
end;

procedure DrawScaledFrame(
  App: Application;
  Source: array of integer;
  SourceWidth: integer;
  SourceHeight: integer;
  Scale: integer;
  OffsetX: integer;
  OffsetY: integer
);
begin
  Application.Clear(App, 0);
  for Y: integer := 0 to SourceHeight - 1 do
  begin
    for X: integer := 0 to SourceWidth - 1 do
    begin
      Application.FillRect(App, OffsetX + X * Scale, OffsetY + Y * Scale, Scale, Scale, Source[Y * SourceWidth +

                                                                                               X])
    end
  end
end;

procedure RequestRender(App: Application);
begin
  Application.RequestRedraw(App)
end;

procedure UpdateDisplayLayout(App: Application);
begin
  var Screen: Size := Application.Size(App);
  var TargetWidth: integer := Max(Screen.width, 1);
  var TargetHeight: integer := Max(Screen.height, 1);
  RenderWidth := LogicalWidth;
  RenderHeight := LogicalHeight;
  DisplayScaleFactor := ComputeDisplayScale(TargetWidth, TargetHeight, RenderWidth, RenderHeight);
  DisplayWidth := RenderWidth * DisplayScaleFactor;
  DisplayHeight := RenderHeight * DisplayScaleFactor;
  DisplayOffsetX := (TargetWidth - DisplayWidth) div 2;
  DisplayOffsetY := (TargetHeight - DisplayHeight) div 2
end;

procedure OnPaint(App: Application);
begin
  UpdateDisplayLayout(App);
  var Frame: array of integer := BuildFrame(State, RenderWidth, RenderHeight);
  DrawScaledFrame(App, Frame, RenderWidth, RenderHeight, DisplayScaleFactor, DisplayOffsetX, DisplayOffsetY);
  DrawHud(App, State)
end;

procedure ResetExplorer(App: Application);
begin
  State := DefaultState();
  RequestRender(App)
end;

function OnKeyPressed(App: Application; Key: Std.Console.KeyEvent): boolean;
begin
  var StepX: real := SpanX(State, RenderWidth, RenderHeight) * 0.14;
  var StepY: real := State.SpanY * 0.14;
  if Key.kind = KeyKind.Escape then
  begin
    Application.HostRequestQuit(App);
    return true
  end
  else if Key.kind = KeyKind.Left then
  begin
    State.CenterX := State.CenterX - StepX;
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.Right then
  begin
    State.CenterX := State.CenterX + StepX;
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.Up then
  begin
    State.CenterY := State.CenterY + StepY;
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.Down then
  begin
    State.CenterY := State.CenterY - StepY;
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.PageUp then
  begin
    State.MaxIter := Min(State.MaxIter + 32, 2048);
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.PageDown then
  begin
    State.MaxIter := Max(State.MaxIter - 32, 32);
    RequestRender(App);
    return true
  end
  else if Key.kind = KeyKind.Character then
  begin
    case Key.ch of
      '+', '=':
      begin
        State.SpanY := Max(State.SpanY * 0.82, 0.000001);
        RequestRender(App)
      end;
      '-':
      begin
        State.SpanY := Min(State.SpanY / 0.82, 3.5);
        RequestRender(App)
      end;
      '1':
      begin
        State.Palette := 1;
        RequestRender(App)
      end;
      '2':
      begin
        State.Palette := 2;
        RequestRender(App)
      end;
      '3':
      begin
        State.Palette := 3;
        RequestRender(App)
      end;
      'r', 'R':
      begin
        ResetExplorer(App)
      end
    end
  end;
  return false
end;

procedure OnMouse(App: Application; E: Std.Graph.Event);
begin
  UpdateDisplayLayout(App);
  if E.mouse_action = MouseAction.Down then
  begin
    if E.mouse_button = MouseButton.Left then
    begin
      if E.mouse_x >= DisplayOffsetX then
      begin
        var LogicalMouseX: integer := Clamp((E.mouse_x - DisplayOffsetX) div DisplayScaleFactor, 0, RenderWidth -

                                                                                                    1);
        var LogicalMouseY: integer := Clamp((E.mouse_y - DisplayOffsetY) div DisplayScaleFactor, 0, RenderHeight -

                                                                                                    1);
        State.CenterX := ViewportCX(State, RenderWidth, RenderHeight, LogicalMouseX);
        State.CenterY := ViewportCY(State, RenderHeight, LogicalMouseY);
        RequestRender(App)
      end
    end
    else if E.mouse_button = MouseButton.Middle then
    begin
      ResetExplorer(App)
    end
  end
end;

procedure OnWheel(App: Application; E: Std.Graph.Event);
begin
  if E.wheel_y > 0 then
  begin
    State.SpanY := Max(State.SpanY * 0.88, 0.000001)
  end
  else if E.wheel_y < 0 then
  begin
    State.SpanY := Min(State.SpanY / 0.88, 3.5)
  end;
  RequestRender(App)
end;

procedure OnResize(App: Application; NewSize: Size);
begin
  RequestRender(App)
end;

begin
  var App: Application := Application.Open(1280, 800, 'Mandelbrot graph');
  UpdateDisplayLayout(App);
  var Handlers: ApplicationHandlers := record
    OnPaint := OnPaint;
    OnKeyPressed := Some(OnKeyPressed);
    OnMouse := Some(OnMouse);
    OnWheel := Some(OnWheel);
    OnResize := Some(OnResize);
  end;
  Application.Configure(App, Handlers);
  Application.Run(App)
end.
