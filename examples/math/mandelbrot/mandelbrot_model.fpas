// Built only via mandelbrot-core.fpasprj — not a standalone program.

unit Mandelbrot.Model;

uses
  Std.Math as Math, Std.Tasks as Tasks, Std.Ui.Terminal as Tui, Mandelbrot.Color as Color,
  Mandelbrot.Render as Render;

public type ExplorerState = record
  public CenterX: real;
  public CenterY: real;
  public SpanY: real;
  public MaxIter: integer;
  public Palette: Color.PaletteKind;

  public static function Default(): ExplorerState;
  begin
    return ExplorerState(
      CenterX := -0.75,
      CenterY := 0.0,
      SpanY := 2.4,
      MaxIter := 160,
      Palette := Color.PaletteKind.DeepOcean
    );
  end function;

  public function SpanX(Self: ExplorerState; Width: integer; Height: integer): real;
  begin
    return Self.SpanY * (Math.IntToReal(Math.Max(Width, 1)) / Math.IntToReal(Math.Max(Height, 1))) *
      0.5;
  end function;

  public function XMin(Self: ExplorerState; Width: integer; Height: integer): real;
  begin
    return Self.CenterX - (Self.SpanX(Width, Height) * 0.5);
  end function;

  public function XMax(Self: ExplorerState; Width: integer; Height: integer): real;
  begin
    return Self.CenterX + (Self.SpanX(Width, Height) * 0.5);
  end function;

  public function YMin(Self: ExplorerState): real;
  begin
    return Self.CenterY - (Self.SpanY * 0.5);
  end function;

  public function YMax(Self: ExplorerState): real;
  begin
    return Self.CenterY + (Self.SpanY * 0.5);
  end function;

  public function GetZoom(Self: ExplorerState): real;
  begin
    return 2.4 / Self.SpanY;
  end function;
end record;

public type MandelbrotModel = record
  public Explorer: ExplorerState;
  public TerminalWidth: integer;
  public TerminalHeight: integer;
  public Grid: Tui.TuiCellGrid;
  public HelpOpen: boolean;
  public Generation: integer;
  public RowsRendered: integer;
  public FailureMessage: string;
  public Inbox: channel of Render.MandelbrotRenderFrame;
end record;

public function GridWidth(TerminalWidth: integer): integer;
begin
  return Math.Max(TerminalWidth - 2, 1);
end function;

public function GridHeight(TerminalHeight: integer): integer;
begin
  return Math.Max(TerminalHeight - 6, 1);
end function;

function BlankGrid(Width: integer; Height: integer): Tui.TuiCellGrid;
begin
  const Black: Tui.TuiColor := Tui.TuiColor.FromRgb(0, 0, 0);
  const Blank: Tui.TuiCell := Tui.TuiCell.Styled(' ', Tui.TuiStyle.FromColors(Black, Black));
  return Tui.TuiCellGrid.Create(Width, Height, array.Fill(Blank, Width * Height));
end function;

public function CreateMandelbrotModel(
  Explorer: ExplorerState;
  TerminalWidth: integer;
  TerminalHeight: integer;
  HelpOpen: boolean;
  Generation: integer;
  Inbox: channel of Render.MandelbrotRenderFrame
): MandelbrotModel;
begin
  const Width: integer := Math.Max(TerminalWidth, 1);
  const Height: integer := Math.Max(TerminalHeight, 1);
  const RenderWidth: integer := GridWidth(Width);
  const RenderHeight: integer := GridHeight(Height);
  return MandelbrotModel(
    Explorer := Explorer,
    TerminalWidth := Width,
    TerminalHeight := Height,
    Grid := BlankGrid(RenderWidth, RenderHeight),
    HelpOpen := HelpOpen,
    Generation := Generation,
    RowsRendered := 0,
    FailureMessage := '',
    Inbox := Inbox
  );
end function;

// Creates the initial blank model; TuiMsg.Started schedules its first render.
public function NewMandelbrotModel(
  Inbox: channel of Render.MandelbrotRenderFrame;
  TerminalWidth: integer;
  TerminalHeight: integer
): MandelbrotModel;
begin
  return CreateMandelbrotModel(
    ExplorerState.Default(),
    TerminalWidth,
    TerminalHeight,
    false,
    1,
    Inbox
  );
end function;

public function MandelbrotRequest(State: MandelbrotModel): Render.MandelbrotRenderRequest;
begin
  return Render.MandelbrotRenderRequest(
    Generation := State.Generation,
    XMin := State.Explorer.XMin(State.Grid.Width, State.Grid.Height),
    XMax := State.Explorer.XMax(State.Grid.Width, State.Grid.Height),
    YMin := State.Explorer.YMin(),
    YMax := State.Explorer.YMax(),
    Width := State.Grid.Width,
    Height := State.Grid.Height,
    MaxIter := State.Explorer.MaxIter,
    Palette := State.Explorer.Palette
  );
end function;
end unit;
