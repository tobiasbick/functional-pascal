// Built only via mandelbrot-core.fpasprj — not a standalone program.

unit Mandelbrot.Model;

uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Math as Math;
uses Std.Tasks as Tasks;
uses Std.Tui as Tui;
uses Mandelbrot.Color as Color;
uses Mandelbrot.Render as Render;
uses Std.Tui.Cells as Cells;
uses Std.Tui.Chrome as Chrome;

public type ExplorerState = record
  public CenterX: real;
  public CenterY: real;
  public SpanY: real;
  public MaxIter: integer;
  public Palette: Color.PaletteKind;
end record;

public function ExplorerStateDefault(): ExplorerState;
begin
  return ExplorerState(CenterX := -0.75, CenterY := 0.0, SpanY := 2.4, MaxIter := 160, Palette := Color.PaletteKind.DeepOcean);
end function;

public function ExplorerStateSpanX(Receiver: ExplorerState; Width: integer; Height: integer): real;
begin
  return (Receiver.SpanY * (Conv.IntToReal(Math.Max(Width, 1)) / Conv.IntToReal(Math.Max(Height, 1)))) *
         0.5;
end function;

public function ExplorerStateXMin(Receiver: ExplorerState; Width: integer; Height: integer): real;
begin
  return Receiver.CenterX - (ExplorerStateSpanX(Receiver, Width, Height) * 0.5);
end function;

public function ExplorerStateXMax(Receiver: ExplorerState; Width: integer; Height: integer): real;
begin
  return Receiver.CenterX + (ExplorerStateSpanX(Receiver, Width, Height) * 0.5);
end function;

public function ExplorerStateYMin(Receiver: ExplorerState): real;
begin
  return Receiver.CenterY - (Receiver.SpanY * 0.5);
end function;

public function ExplorerStateYMax(Receiver: ExplorerState): real;
begin
  return Receiver.CenterY + (Receiver.SpanY * 0.5);
end function;

public function ExplorerStateGetZoom(Receiver: ExplorerState): real;
begin
  return 2.4 / Receiver.SpanY;
end function;

public type MandelbrotModel = record
  public Explorer: ExplorerState;
  public TerminalWidth: integer;
  public TerminalHeight: integer;
  public Grid: Tui.TuiCellGrid;
  public HelpOpen: boolean;
  public Generation: integer;
  public RowsRendered: integer;
  public FailureMessage: string;
  public Inbox: channel of (Render.MandelbrotRenderFrame);
end record;

public function GridWidth(TerminalWidth: integer): integer;
begin
  return Math.Max(TerminalWidth - 2, 1);
end function;

public function GridHeight(TerminalHeight: integer): integer;
begin
  return Math.Max(TerminalHeight - 6, 1);
end function;

function BlankGrid(Width: integer; Height: integer): Tui.TuiCellGrid;
begin
  const Black: Tui.TuiColor := Cells.TuiColorFromRgb(0, 0, 0);
  const Blank: Tui.TuiCell := Cells.TuiCellStyled(' ', Cells.TuiStyleFromColors(Black, Black));
  return Chrome.TuiCellGridCreate(Width, Height, Arrays.Fill(Blank, Width * Height));
end function;

public function CreateMandelbrotModel(
  Explorer: ExplorerState;
  TerminalWidth: integer;
  TerminalHeight: integer;
  HelpOpen: boolean;
  Generation: integer;
  Inbox: channel of (Render.MandelbrotRenderFrame)
): MandelbrotModel;
begin
  const Width: integer := Math.Max(TerminalWidth, 1);
  const Height: integer := Math.Max(TerminalHeight, 1);
  const RenderWidth: integer := GridWidth(Width);
  const RenderHeight: integer := GridHeight(Height);
  return MandelbrotModel(Explorer := Explorer, TerminalWidth := Width, TerminalHeight := Height, Grid := BlankGrid(RenderWidth, RenderHeight), HelpOpen := HelpOpen, Generation := Generation, RowsRendered := 0, FailureMessage := '', Inbox := Inbox);
end function;

// Creates the initial blank model; TuiMsg.Started schedules its first render.
public function NewMandelbrotModel(
  Inbox: channel of (Render.MandelbrotRenderFrame);
  TerminalWidth: integer;
  TerminalHeight: integer
): MandelbrotModel;
begin
  return CreateMandelbrotModel(ExplorerStateDefault(), TerminalWidth, TerminalHeight, false, 1, Inbox);
end function;

public function MandelbrotRequest(State: MandelbrotModel): Render.MandelbrotRenderRequest;
begin
  return Render.MandelbrotRenderRequest(Generation := State.Generation, XMin := ExplorerStateXMin(State.Explorer, State.Grid.Width, State.Grid.Height), XMax := ExplorerStateXMax(State.Explorer, State.Grid.Width, State.Grid.Height), YMin := ExplorerStateYMin(State.Explorer), YMax := ExplorerStateYMax(State.Explorer), Width := State.Grid.Width, Height := State.Grid.Height, MaxIter := State.Explorer.MaxIter, Palette := State.Explorer.Palette);
end function;

end unit;
