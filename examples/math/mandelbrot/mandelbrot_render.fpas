// Built only via mandelbrot-core.fpasprj — not a standalone program.

unit Mandelbrot.Render;

uses
  Std.Conv as Conv, Std.Math as Math, Std.Tasks as StdTasks, Std.Time as Time, Std.Tui as Tui,
  Mandelbrot.Color as Color;

public type Complex = record
  public Re: real;
  public Im: real;

  public static function Zero(): Complex;
  begin
    return Complex(Re := 0.0, Im := 0.0);
  end function;

  public static function Create(Re: real; Im: real): Complex;
  begin
    return Complex(Re := Re, Im := Im);
  end function;

  public function Sq(Self: Complex): Complex;
  begin
    return Complex(Re := Self.Re * Self.Re - Self.Im * Self.Im, Im := 2.0 * Self.Re * Self.Im);
  end function;

  public function Add(Self: Complex; Other: Complex): Complex;
  begin
    return Complex(Re := Self.Re + Other.Re, Im := Self.Im + Other.Im);
  end function;

  public function MagSq(Self: Complex): real;
  begin
    return Self.Re * Self.Re + Self.Im * Self.Im;
  end function;
end record;

public type PixelSample = record
  public IsInside: boolean;
  public EscapeValue: real;
end record;

public type MandelbrotRenderRequest = record
  public Generation: integer;
  public XMin: real;
  public XMax: real;
  public YMin: real;
  public YMax: real;
  public Width: integer;
  public Height: integer;
  public MaxIter: integer;
  public Palette: Color.PaletteKind;
end record;

public type MandelbrotRenderFrame = record
  // One complete row-major image belonging to a render generation.
  public Generation: integer;
  public Cells: array of Tui.TuiCell;
end record;

function FinishSample(Z: Complex; Iterations: integer; MaxIter: integer): PixelSample;
begin
  if Iterations >= MaxIter then
    begin
      return PixelSample(IsInside := true, EscapeValue := 0.0);
    end;
  end if;
  const MagnitudeSq: real := Math.Max(Z.MagSq(), 4.0);
  return PixelSample(IsInside := false, EscapeValue := Conv.IntToReal(Iterations) + 1.0 -
                                                       (Math.Log(Math.Log(MagnitudeSq) * 0.5) / Math.Log(2.0)));
end function;

function Iterate(C: Complex; MaxIter: integer): PixelSample;
begin
  var Z: Complex := Complex.Zero();
  var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= 256.0) do
    begin
      Z := Z.Sq().Add(C);
      N := N + 1;
    end;
  end while;

  return FinishSample(Z, N, MaxIter);
end function;

function IterateCancellable(
  C: Complex;
  MaxIter: integer;
  HostToken: StdTasks.CancellationToken;
  WorkerToken: StdTasks.CancellationToken
): PixelSample;
begin
  var Z: Complex := Complex.Zero();
  var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= 256.0) do
    begin
      if StdTasks.IsCancellationRequested(HostToken) or
         StdTasks.IsCancellationRequested(WorkerToken) then
        begin
          break;
        end;
      end if;
      const ChunkEnd: integer := Math.Min(N + 128, MaxIter);
      while (N < ChunkEnd) and (Z.MagSq() <= 256.0) do
        begin
          Z := Z.Sq().Add(C);
          N := N + 1;
        end;
      end while;
    end;
  end while;

  return FinishSample(Z, N, MaxIter);
end function;

// Computes one row without cancellation for reference rendering and tests.
public function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of PixelSample;
begin
  const WidthRange: integer := Math.Max(Width - 1, 1);
  const HeightRange: integer := Math.Max(Height - 1, 1);
  const Cy: real := YMax - Conv.IntToReal(Py) / Conv.IntToReal(HeightRange) * (YMax - YMin);
  var Row: array of PixelSample := [];
  for Px: integer := 0 to Width - 1 do
    begin
      const Cx: real := XMin + Conv.IntToReal(Px) / Conv.IntToReal(WidthRange) * (XMax - XMin);
      Row.PushInPlace(Iterate(Complex.Create(Cx, Cy), MaxIter));
    end;
  end for;

  return Row;
end function;

function ComputeRowCancellable(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer;
  HostToken: StdTasks.CancellationToken;
  WorkerToken: StdTasks.CancellationToken
): array of PixelSample;
begin
  const WidthRange: integer := Math.Max(Width - 1, 1);
  const HeightRange: integer := Math.Max(Height - 1, 1);
  const Cy: real := YMax - Conv.IntToReal(Py) / Conv.IntToReal(HeightRange) * (YMax - YMin);
  var Row: array of PixelSample := [];
  var NextYield: integer := Time.MonotonicMillis() + 8;
  for Px: integer := 0 to Width - 1 do
    begin
      if ((Px > 0) and (Px mod 16 = 0)) and (Time.MonotonicMillis() >= NextYield) then
        begin
          // Let the Console reader run even when every pool worker is rendering.
          Time.Sleep(0);
          NextYield := Time.MonotonicMillis() + 8;
        end;
      end if;

      if StdTasks.IsCancellationRequested(HostToken) or
         StdTasks.IsCancellationRequested(WorkerToken) then
        begin
          return [];
        end;
      end if;
      const Cx: real := XMin + Conv.IntToReal(Px) / Conv.IntToReal(WidthRange) * (XMax - XMin);
      Row.PushInPlace(IterateCancellable(Complex.Create(Cx, Cy), MaxIter, HostToken, WorkerToken));
    end;
  end for;

  if StdTasks.IsCancellationRequested(HostToken) or StdTasks.IsCancellationRequested(WorkerToken) then
    begin
      return [];
    end;
  end if;

  return Row;
end function;

function EscapeGlyph(EscapeValue: real): string;
begin
  const Ramp: string := ' ░▒▓█';
  const Count: integer := Ramp.Length();
  const Index: integer := Math.Clamp(Math.Trunc(Math.Frac(EscapeValue * 0.08) *
                                                Conv.IntToReal(Count)), 0, Count - 1);
  return Ramp[Index];
end function;

function RenderCell(Sample: PixelSample; Palette: Color.PaletteKind): Tui.TuiCell;
begin
  const Background: Tui.TuiColor := Tui.TuiColor.FromRgb(0, 0, 0);
  if Sample.IsInside then
    begin
      const Shade: Tui.TuiColor := Color.InsideColor();
      return Tui.TuiCell.Styled(' ', Tui.TuiStyle.FromColors(Shade, Shade));
    end;
  end if;

  return Tui.TuiCell.Styled(EscapeGlyph(Sample.EscapeValue), Tui.TuiStyle.FromColors(Color.EscapeColor(Palette, Sample.EscapeValue), Background));
end function;

function RenderSamples(Samples: array of PixelSample; Palette: Color.PaletteKind): array of Tui.TuiCell;
begin
  var Cells: array of Tui.TuiCell := [];
  for Sample: PixelSample in Samples do
    begin
      Cells.PushInPlace(RenderCell(Sample, Palette));
    end;
  end for;

  return Cells;
end function;

function RenderRowCells(Request: MandelbrotRenderRequest; Py: integer): array of Tui.TuiCell;
begin
  return RenderSamples(ComputeRow(Py, Request.Width, Request.Height, Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.MaxIter), Request.Palette);
end function;

function RenderRowCellsCancellable(
  Request: MandelbrotRenderRequest;
  Py: integer;
  HostToken: StdTasks.CancellationToken;
  WorkerToken: StdTasks.CancellationToken
): array of Tui.TuiCell;
begin
  return RenderSamples(ComputeRowCancellable(Py, Request.Width, Request.Height, Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.MaxIter, HostToken, WorkerToken), Request.Palette);
end function;

// Computes a flat row-major grid synchronously as a reference implementation.
public function RenderGrid(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: Color.PaletteKind
): Tui.TuiCellGrid;
begin
  const Request: MandelbrotRenderRequest := MandelbrotRenderRequest(Generation := 0, XMin := XMin, XMax := XMax, YMin := YMin, YMax := YMax, Width := Width, Height := Height, MaxIter := MaxIter, Palette := Palette);
  var Cells: array of Tui.TuiCell := [];
  for Py: integer := 0 to Height - 1 do
    begin
      const Row: array of Tui.TuiCell := RenderRowCells(Request, Py);
      Cells := Cells.Concat(Row);
    end;
  end for;

  return Tui.TuiCellGrid.Create(Width, Height, Cells);
end function;

// Runs one task per row on the VM pool and publishes one complete image.
public function RunBackgroundRender(
  Request: MandelbrotRenderRequest;
  Inbox: channel of MandelbrotRenderFrame;
  HostToken: StdTasks.CancellationToken
): result of (boolean, string);
begin
  const Group: StdTasks.TaskGroup := StdTasks.CreateTaskGroup();
  var Tasks: array of task of array of Tui.TuiCell := [];
  for Py: integer := 0 to Request.Height - 1 do
    begin
      if StdTasks.IsCancellationRequested(HostToken) then
        begin
          break;
        end;
      end if;

      Tasks.PushInPlace(StdTasks.StartTaskInGroup(Group, function(WorkerToken: StdTasks.CancellationToken): array of Tui.TuiCell begin
        return RenderRowCellsCancellable(Request, Py, HostToken, WorkerToken);
      end function));
    end;
  end for;
  var Cells: array of Tui.TuiCell := [];
  for Py: integer := 0 to Tasks.Length() - 1 do
    begin
      if (StdTasks.WaitAnyWithCancellation([Tasks[Py]], HostToken) is Error(_)) then
        begin
          break;
        end;
      end if;
      const Row: array of Tui.TuiCell := StdTasks.Wait(Tasks[Py]);
      if StdTasks.IsCancellationRequested(HostToken) then
        begin
          break;
        end;
      end if;

      Cells := Cells.Concat(Row);
      if Py = Request.Height - 1 then
        begin
          if (StdTasks.SendWithCancellation(Inbox, MandelbrotRenderFrame(Generation := Request.Generation, Cells := Cells), HostToken) is Error(_)) then
            begin
              break;
            end;
          end if;
        end;
      end if;
    end;
  end for;
  const Failures: array of StdTasks.TaskFailure := StdTasks.CloseTaskGroup(Group);
  for Failure: StdTasks.TaskFailure in Failures do
    begin
      if Failure.Kind <> StdTasks.TaskFailureKind.Cancelled then
        begin
          return Error(Failure.Message);
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;
end unit;
