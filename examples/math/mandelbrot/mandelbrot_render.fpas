// Built only via mandelbrot-core.fpasprj — not a standalone program.

unit Mandelbrot.Render;

uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Math as Math;
uses Std.Results as Results;
uses Std.Str as Str;
uses Std.Tasks as Tasks2;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Mandelbrot.Color as Color;

public type Complex = record
  public Re: real;
  public Im: real;

  public static function Zero(): Complex;
  begin
    return Complex(Re := 0.0, Im := 0.0);
  end function;

  public static function Create(Re: real; Im: real): Complex;
  begin
    return Complex(Re := Re, Im := Im);
  end function;

  public function Sq(Self: Complex): Complex;
  begin
    return Complex(Re := Self.Re * Self.Re - Self.Im * Self.Im, Im := (2.0 * Self.Re) * Self.Im);
  end function;

  public function Add(Self: Complex; Other: Complex): Complex;
  begin
    return Complex(Re := Self.Re + Other.Re, Im := Self.Im + Other.Im);
  end function;

  public function MagSq(Self: Complex): real;
  begin
    return Self.Re * Self.Re + Self.Im * Self.Im;
  end function;
end record;

public type PixelSample = record
  public IsInside: boolean;
  public EscapeValue: real;
end record;

public type MandelbrotRenderRequest = record
  public Generation: integer;
  public XMin: real;
  public XMax: real;
  public YMin: real;
  public YMax: real;
  public Width: integer;
  public Height: integer;
  public MaxIter: integer;
  public Palette: Color.PaletteKind;
end record;

public type MandelbrotRenderFrame = record
  // One complete row-major image belonging to a render generation.
  public Generation: integer;
  public Cells: array of (Tui.TuiCell);
end record;

function FinishSample(Z: Complex; Iterations: integer; MaxIter: integer): PixelSample;
begin
  if Iterations >= MaxIter then
    begin
      return PixelSample(IsInside := true, EscapeValue := 0.0);
    end;
  end if;
  var MagnitudeSq: real := Math.Max(Z.MagSq(), 4.0);
  return PixelSample(IsInside := false, EscapeValue := (Conv.IntToReal(Iterations) + 1.0) -
                                                       (Math.Log(Math.Log(MagnitudeSq) * 0.5) / Math.Log(2.0)));
end function;

function Iterate(C: Complex; MaxIter: integer): PixelSample;
begin
  mutable var Z: Complex := Complex.Zero();
  mutable var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= 256.0) do
    begin
      Z := Z.Sq().Add(C);
      N := N + 1;
    end;
  end while;

  return FinishSample(Z, N, MaxIter);
end function;

function IterateCancellable(
  C: Complex;
  MaxIter: integer;
  HostToken: Tasks2.CancellationToken;
  WorkerToken: Tasks2.CancellationToken
): PixelSample;
begin
  mutable var Z: Complex := Complex.Zero();
  mutable var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= 256.0) do
    begin
      if Tasks2.IsCancellationRequested(HostToken) or Tasks2.IsCancellationRequested(WorkerToken) then
        begin
          break;
        end;
      end if;
      var ChunkEnd: integer := Math.Min(N + 128, MaxIter);
      while (N < ChunkEnd) and (Z.MagSq() <= 256.0) do
        begin
          Z := Z.Sq().Add(C);
          N := N + 1;
        end;
      end while;
    end;
  end while;

  return FinishSample(Z, N, MaxIter);
end function;

// Computes one row without cancellation for reference rendering and tests.
public function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of (PixelSample);
begin
  var WidthRange: integer := Math.Max(Width - 1, 1);
  var HeightRange: integer := Math.Max(Height - 1, 1);
  var Cy: real := YMax - (Py / Conv.IntToReal(HeightRange)) * (YMax - YMin);
  mutable var Row: array of (PixelSample) := [];
  for Px: integer := 0 to Width - 1 do
    begin
      var Cx: real := XMin + (Px / Conv.IntToReal(WidthRange)) * (XMax - XMin);
      Arrays.Push(Row, Iterate(Complex.Create(Cx, Cy), MaxIter));
    end;
  end for;

  return Row;
end function;

function ComputeRowCancellable(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer;
  HostToken: Tasks2.CancellationToken;
  WorkerToken: Tasks2.CancellationToken
): array of (PixelSample);
begin
  var WidthRange: integer := Math.Max(Width - 1, 1);
  var HeightRange: integer := Math.Max(Height - 1, 1);
  var Cy: real := YMax - (Py / Conv.IntToReal(HeightRange)) * (YMax - YMin);
  mutable var Row: array of (PixelSample) := [];
  mutable var NextYield: integer := Time.MonotonicMillis() + 8;
  for Px: integer := 0 to Width - 1 do
    begin
      if ((Px > 0) and (Px mod 16 = 0)) and (Time.MonotonicMillis() >= NextYield) then
        begin
          // Let the Console reader run even when every pool worker is rendering.
          Time.Sleep(0);
          NextYield := Time.MonotonicMillis() + 8;
        end;
      end if;

      if Tasks2.IsCancellationRequested(HostToken) or Tasks2.IsCancellationRequested(WorkerToken) then
        begin
          return [];
        end;
      end if;
      var Cx: real := XMin + (Px / Conv.IntToReal(WidthRange)) * (XMax - XMin);
      Arrays.Push(Row, IterateCancellable(Complex.Create(Cx, Cy), MaxIter, HostToken, WorkerToken));
    end;
  end for;

  if Tasks2.IsCancellationRequested(HostToken) or Tasks2.IsCancellationRequested(WorkerToken) then
    begin
      return [];
    end;
  end if;

  return Row;
end function;

function EscapeGlyph(EscapeValue: real): string;
begin
  var Ramp: string := ' ░▒▓█';
  var Count: integer := Str.Length(Ramp);
  var Index: integer := Math.Clamp(Math.Trunc(Math.Frac(EscapeValue * 0.08) * Conv.IntToReal(Count)), 0, Count -
                                                                                                         1);
  return Str.CharAt(Ramp, Index);
end function;

function RenderCell(Sample: PixelSample; Palette: Color.PaletteKind): Tui.TuiCell;
begin
  var Background: Tui.TuiColor := Tui.TuiColor.FromRgb(0, 0, 0);
  if Sample.IsInside then
    begin
      var Shade: Tui.TuiColor := Color.InsideColor();
      return Tui.TuiCell.Styled(' ', Tui.TuiStyle.FromColors(Shade, Shade));
    end;
  end if;

  return Tui.TuiCell.Styled(EscapeGlyph(Sample.EscapeValue), Tui.TuiStyle.FromColors(Color.EscapeColor(Palette, Sample.EscapeValue), Background));
end function;

function RenderSamples(Samples: array of (PixelSample); Palette: Color.PaletteKind): array of (Tui.TuiCell);
begin
  mutable var Cells: array of (Tui.TuiCell) := [];
  for Sample: PixelSample in Samples do
    begin
      Arrays.Push(Cells, RenderCell(Sample, Palette));
    end;
  end for;

  return Cells;
end function;

function RenderRowCells(Request: MandelbrotRenderRequest; Py: integer): array of (Tui.TuiCell);
begin
  return RenderSamples(ComputeRow(Py, Request.Width, Request.Height, Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.MaxIter), Request.Palette);
end function;

function RenderRowCellsCancellable(
  Request: MandelbrotRenderRequest;
  Py: integer;
  HostToken: Tasks2.CancellationToken;
  WorkerToken: Tasks2.CancellationToken
): array of (Tui.TuiCell);
begin
  return RenderSamples(ComputeRowCancellable(Py, Request.Width, Request.Height, Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.MaxIter, HostToken, WorkerToken), Request.Palette);
end function;

// Computes a flat row-major grid synchronously as a reference implementation.
public function RenderGrid(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: Color.PaletteKind
): Tui.TuiCellGrid;
begin
  var Request: MandelbrotRenderRequest := MandelbrotRenderRequest(Generation := 0, XMin := XMin, XMax := XMax, YMin := YMin, YMax := YMax, Width := Width, Height := Height, MaxIter := MaxIter, Palette := Palette);
  mutable var Cells: array of (Tui.TuiCell) := [];
  for Py: integer := 0 to Height - 1 do
    begin
      var Row: array of (Tui.TuiCell) := RenderRowCells(Request, Py);
      Cells := Arrays.Concat(Cells, Row);
    end;
  end for;

  return Tui.TuiCellGrid.Create(Width, Height, Cells);
end function;

// Runs one task per row on the VM pool and publishes one complete image.
public function RunBackgroundRender(
  Request: MandelbrotRenderRequest;
  Inbox: channel of (MandelbrotRenderFrame);
  HostToken: Tasks2.CancellationToken
): Result of (boolean, string);
begin
  var Group: Tasks2.TaskGroup := Tasks2.CreateTaskGroup();
  mutable var Tasks: array of (task) := [];
  for Py: integer := 0 to Request.Height - 1 do
    begin
      if Tasks2.IsCancellationRequested(HostToken) then
        begin
          break;
        end;
      end if;

      Arrays.Push(Tasks, Tasks2.StartTaskInGroup(Group, function(WorkerToken: Tasks2.CancellationToken): array of (Tui.TuiCell) begin
        return RenderRowCellsCancellable(Request, Py, HostToken, WorkerToken);
      end function));
    end;
  end for;
  mutable var Cells: array of (Tui.TuiCell) := [];
  for Py: integer := 0 to Arrays.Length(Tasks) - 1 do
    begin
      if Results.IsError(Tasks2.WaitAnyWithCancellation([Tasks[Py]], HostToken)) then
        begin
          break;
        end;
      end if;
      var Row: array of (Tui.TuiCell) := Tasks2.Wait(Tasks[Py]);
      if Tasks2.IsCancellationRequested(HostToken) then
        begin
          break;
        end;
      end if;

      Cells := Arrays.Concat(Cells, Row);
      if Py = Request.Height - 1 then
        begin
          if Results.IsError(Tasks2.SendWithCancellation(Inbox, MandelbrotRenderFrame(Generation := Request.Generation, Cells := Cells), HostToken)) then
            begin
              break;
            end;
          end if;
        end;
      end if;
    end;
  end for;
  var Failures: array of (Tasks2.TaskFailure) := Tasks2.CloseTaskGroup(Group);
  for Failure: Tasks2.TaskFailure in Failures do
    begin
      if Failure.Kind <> Tasks2.TaskFailureKind.Cancelled then
        begin
          return Result.Error(Failure.Message);
        end;
      end if;
    end;
  end for;

  return Result.Ok(true);
end function;

end unit;
