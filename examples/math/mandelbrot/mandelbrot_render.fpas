{ Built only via mandelbrot.fpasprj — not a standalone program. }

unit Mandelbrot.Render;

uses Std.Array, Std.Conv, Std.Math, Std.Str, Std.Task, Std.Tui, Mandelbrot.Color;

type
  Complex = record
    public Re: real;
    public Im: real;

    public static function Zero(): Complex;
    begin
      return record
        Re := 0.0;
        Im := 0.0;
      end
    end;

    public static function Create(Re: real; Im: real): Complex;
    begin
      return record
        Re := Re;
        Im := Im;
      end
    end;

    public function Sq(Self: Complex): Complex;
    begin
      return record
        Re := Self.Re * Self.Re - Self.Im * Self.Im;
        Im := (2.0 * Self.Re) * Self.Im;
      end
    end;

    public function Add(Self: Complex; Other: Complex): Complex;
    begin
      return record
        Re := Self.Re + Other.Re;
        Im := Self.Im + Other.Im;
      end
    end;

    public function MagSq(Self: Complex): real;
    begin
      return Self.Re * Self.Re + Self.Im * Self.Im
    end;
  end;
  PixelSample = record
    public IsInside: boolean;
    public EscapeValue: real;
  end;

function Iterate(C: Complex; MaxIter: integer): PixelSample;
begin
  mutable var Z: Complex := Complex.Zero();
  mutable var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= 256.0) do
  begin
    Z := Z.Sq().Add(C);
    N := N + 1
  end;
  if N >= MaxIter then
  begin
    return record
      IsInside := true;
      EscapeValue := 0.0;
    end
  end;
  var MagnitudeSq: real := Max(Z.MagSq(), 4.0);
  return record
    IsInside := false;
    EscapeValue := (IntToReal(N) + 1.0) - (Log(Log(MagnitudeSq) * 0.5) / Log(2.0));
  end
end;

function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of PixelSample;
begin
  var WidthRange: integer := Max(Width - 1, 1);
  var HeightRange: integer := Max(Height - 1, 1);
  var Cy: real := YMax - (Py / IntToReal(HeightRange)) * (YMax - YMin);
  mutable var Row: array of PixelSample := [];
  for Px: integer := 0 to Width - 1 do
  begin
    var Cx: real := XMin + (Px / IntToReal(WidthRange)) * (XMax - XMin);
    Std.Array.Push(Row, Iterate(Complex.Create(Cx, Cy), MaxIter))
  end;
  return Row
end;

function EscapeGlyph(EscapeValue: real): string;
begin
  var Ramp: string := ' ░▒▓█';
  var Count: integer := Std.Str.Length(Ramp);
  var Index: integer := Clamp(Trunc(Frac(EscapeValue * 0.08) * IntToReal(Count)), 0, Count - 1);
  return Std.Str.CharAt(Ramp, Index)
end;

function RenderCell(Sample: PixelSample; Palette: PaletteKind): TuiCell;
begin
  var Background: TuiColor := TuiColor.FromRgb(0, 0, 0);
  if Sample.IsInside then
  begin
    var Shade: TuiColor := InsideColor();
    return TuiCell.Styled(' ', TuiStyle.FromColors(Shade, Shade))
  end;
  return TuiCell.Styled(EscapeGlyph(Sample.EscapeValue), TuiStyle.FromColors(EscapeColor(Palette, Sample.EscapeValue), Background))
end;

/// Computes a flat row-major truecolor Mandelbrot cell grid.

public function RenderGrid(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: PaletteKind
): TuiCellGrid;
begin
  mutable var Tasks: array of task := [];
  for Py: integer := 0 to Height - 1 do
  begin
    Std.Array.Push(Tasks, go ComputeRow(Py, Width, Height, XMin, XMax, YMin, YMax, MaxIter))
  end;
  mutable var Cells: array of TuiCell := [];
  for Py: integer := 0 to Height - 1 do
  begin
    var Row: array of PixelSample := Wait(Tasks[Py]);
    for Px: integer := 0 to Width - 1 do
    begin
      Std.Array.Push(Cells, RenderCell(Row[Px], Palette))
    end
  end;
  return TuiCellGrid.Create(Width, Height, Cells)
end;
