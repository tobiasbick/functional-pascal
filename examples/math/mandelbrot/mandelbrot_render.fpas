// Built only via mandelbrot-core.fpasprj — not a standalone program.

unit Mandelbrot.Render;

uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Math as Math;
uses Std.Results as Results;
uses Std.Str as Str;
uses Std.Tasks as Tasks2;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Mandelbrot.Color as Color;
uses Std.Tui.Cells as Cells2;
uses Std.Tui.Chrome as Chrome;

public type Complex = record
  public Re: real;
  public Im: real;
end record;

public function ComplexZero(): Complex;
begin
  return Complex(Re := 0.0, Im := 0.0);
end function;

public function ComplexCreate(Re: real; Im: real): Complex;
begin
  return Complex(Re := Re, Im := Im);
end function;

public function ComplexSq(Receiver: Complex): Complex;
begin
  return Complex(Re := Receiver.Re * Receiver.Re - Receiver.Im * Receiver.Im, Im := (2.0 * Receiver.Re) *
                                                                                    Receiver.Im);
end function;

public function ComplexAdd(Receiver: Complex; Other: Complex): Complex;
begin
  return Complex(Re := Receiver.Re + Other.Re, Im := Receiver.Im + Other.Im);
end function;

public function ComplexMagSq(Receiver: Complex): real;
begin
  return Receiver.Re * Receiver.Re + Receiver.Im * Receiver.Im;
end function;

public type PixelSample = record
  public IsInside: boolean;
  public EscapeValue: real;
end record;

public type MandelbrotRenderRequest = record
  public Generation: integer;
  public XMin: real;
  public XMax: real;
  public YMin: real;
  public YMax: real;
  public Width: integer;
  public Height: integer;
  public MaxIter: integer;
  public Palette: Color.PaletteKind;
end record;

public type MandelbrotRenderFrame = record
  // One complete row-major image belonging to a render generation.
  public Generation: integer;
  public Cells: array of (Tui.TuiCell);
end record;

function FinishSample(Z: Complex; Iterations: integer; MaxIter: integer): PixelSample;
begin
  if Iterations >= MaxIter then
    begin
      return PixelSample(IsInside := true, EscapeValue := 0.0);
    end;
  end if;
  const MagnitudeSq: real := Math.Max(ComplexMagSq(Z), 4.0);
  return PixelSample(IsInside := false, EscapeValue := (Conv.IntToReal(Iterations) + 1.0) -
                                                       (Math.Log(Math.Log(MagnitudeSq) * 0.5) / Math.Log(2.0)));
end function;

function Iterate(C: Complex; MaxIter: integer): PixelSample;
begin
  var Z: Complex := ComplexZero();
  var N: integer := 0;
  while (N < MaxIter) and (ComplexMagSq(Z) <= 256.0) do
    begin
      Z := ComplexAdd(ComplexSq(Z), C);
      N := N + 1;
    end;
  end while;

  return FinishSample(Z, N, MaxIter);
end function;

function IterateCancellable(
  C: Complex;
  MaxIter: integer;
  HostToken: Tasks2.CancellationToken;
  WorkerToken: Tasks2.CancellationToken
): PixelSample;
begin
  var Z: Complex := ComplexZero();
  var N: integer := 0;
  while (N < MaxIter) and (ComplexMagSq(Z) <= 256.0) do
    begin
      if Tasks2.IsCancellationRequested(HostToken) or Tasks2.IsCancellationRequested(WorkerToken) then
        begin
          break;
        end;
      end if;
      const ChunkEnd: integer := Math.Min(N + 128, MaxIter);
      while (N < ChunkEnd) and (ComplexMagSq(Z) <= 256.0) do
        begin
          Z := ComplexAdd(ComplexSq(Z), C);
          N := N + 1;
        end;
      end while;
    end;
  end while;

  return FinishSample(Z, N, MaxIter);
end function;

// Computes one row without cancellation for reference rendering and tests.
public function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of (PixelSample);
begin
  const WidthRange: integer := Math.Max(Width - 1, 1);
  const HeightRange: integer := Math.Max(Height - 1, 1);
  const Cy: real := YMax - (Py / Conv.IntToReal(HeightRange)) * (YMax - YMin);
  var Row: array of (PixelSample) := [];
  for Px: integer := 0 to Width - 1 do
    begin
      const Cx: real := XMin + (Px / Conv.IntToReal(WidthRange)) * (XMax - XMin);
      Arrays.Push(var Row, Iterate(ComplexCreate(Cx, Cy), MaxIter));
    end;
  end for;

  return Row;
end function;

function ComputeRowCancellable(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer;
  HostToken: Tasks2.CancellationToken;
  WorkerToken: Tasks2.CancellationToken
): array of (PixelSample);
begin
  const WidthRange: integer := Math.Max(Width - 1, 1);
  const HeightRange: integer := Math.Max(Height - 1, 1);
  const Cy: real := YMax - (Py / Conv.IntToReal(HeightRange)) * (YMax - YMin);
  var Row: array of (PixelSample) := [];
  var NextYield: integer := Time.MonotonicMillis() + 8;
  for Px: integer := 0 to Width - 1 do
    begin
      if ((Px > 0) and (Px mod 16 = 0)) and (Time.MonotonicMillis() >= NextYield) then
        begin
          // Let the Console reader run even when every pool worker is rendering.
          Time.Sleep(0);
          NextYield := Time.MonotonicMillis() + 8;
        end;
      end if;

      if Tasks2.IsCancellationRequested(HostToken) or Tasks2.IsCancellationRequested(WorkerToken) then
        begin
          return [];
        end;
      end if;
      const Cx: real := XMin + (Px / Conv.IntToReal(WidthRange)) * (XMax - XMin);
      Arrays.Push(var Row, IterateCancellable(ComplexCreate(Cx, Cy), MaxIter, HostToken, WorkerToken));
    end;
  end for;

  if Tasks2.IsCancellationRequested(HostToken) or Tasks2.IsCancellationRequested(WorkerToken) then
    begin
      return [];
    end;
  end if;

  return Row;
end function;

function EscapeGlyph(EscapeValue: real): string;
begin
  const Ramp: string := ' ░▒▓█';
  const Count: integer := Str.Length(Ramp);
  const Index: integer := Math.Clamp(Math.Trunc(Math.Frac(EscapeValue * 0.08) *
                                                Conv.IntToReal(Count)), 0, Count - 1);
  return Str.CharAt(Ramp, Index);
end function;

function RenderCell(Sample: PixelSample; Palette: Color.PaletteKind): Tui.TuiCell;
begin
  const Background: Tui.TuiColor := Cells2.TuiColorFromRgb(0, 0, 0);
  if Sample.IsInside then
    begin
      const Shade: Tui.TuiColor := Color.InsideColor();
      return Cells2.TuiCellStyled(' ', Cells2.TuiStyleFromColors(Shade, Shade));
    end;
  end if;

  return Cells2.TuiCellStyled(EscapeGlyph(Sample.EscapeValue), Cells2.TuiStyleFromColors(Color.EscapeColor(Palette, Sample.EscapeValue), Background));
end function;

function RenderSamples(Samples: array of (PixelSample); Palette: Color.PaletteKind): array of (Tui.TuiCell);
begin
  var Cells: array of (Tui.TuiCell) := [];
  for Sample: PixelSample in Samples do
    begin
      Arrays.Push(var Cells, RenderCell(Sample, Palette));
    end;
  end for;

  return Cells;
end function;

function RenderRowCells(Request: MandelbrotRenderRequest; Py: integer): array of (Tui.TuiCell);
begin
  return RenderSamples(ComputeRow(Py, Request.Width, Request.Height, Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.MaxIter), Request.Palette);
end function;

function RenderRowCellsCancellable(
  Request: MandelbrotRenderRequest;
  Py: integer;
  HostToken: Tasks2.CancellationToken;
  WorkerToken: Tasks2.CancellationToken
): array of (Tui.TuiCell);
begin
  return RenderSamples(ComputeRowCancellable(Py, Request.Width, Request.Height, Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.MaxIter, HostToken, WorkerToken), Request.Palette);
end function;

// Computes a flat row-major grid synchronously as a reference implementation.
public function RenderGrid(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: Color.PaletteKind
): Tui.TuiCellGrid;
begin
  const Request: MandelbrotRenderRequest := MandelbrotRenderRequest(Generation := 0, XMin := XMin, XMax := XMax, YMin := YMin, YMax := YMax, Width := Width, Height := Height, MaxIter := MaxIter, Palette := Palette);
  var Cells: array of (Tui.TuiCell) := [];
  for Py: integer := 0 to Height - 1 do
    begin
      const Row: array of (Tui.TuiCell) := RenderRowCells(Request, Py);
      Cells := Arrays.Concat(Cells, Row);
    end;
  end for;

  return Chrome.TuiCellGridCreate(Width, Height, Cells);
end function;

// Runs one task per row on the VM pool and publishes one complete image.
public function RunBackgroundRender(
  Request: MandelbrotRenderRequest;
  Inbox: channel of (MandelbrotRenderFrame);
  HostToken: Tasks2.CancellationToken
): Result of (boolean, string);
begin
  const Group: Tasks2.TaskGroup := Tasks2.CreateTaskGroup();
  var Tasks: array of (task) := [];
  for Py: integer := 0 to Request.Height - 1 do
    begin
      if Tasks2.IsCancellationRequested(HostToken) then
        begin
          break;
        end;
      end if;

      Arrays.Push(var Tasks, Tasks2.StartTaskInGroup(Group, function(WorkerToken: Tasks2.CancellationToken): array of (Tui.TuiCell) begin
        return RenderRowCellsCancellable(Request, Py, HostToken, WorkerToken);
      end function));
    end;
  end for;
  var Cells: array of (Tui.TuiCell) := [];
  var CompletedRows: integer := 0;
  for Handle: task in Tasks do
    begin
      if Results.IsError(Tasks2.WaitAnyWithCancellation([Handle], HostToken)) then
        begin
          break;
        end;
      end if;
      const Row: array of (Tui.TuiCell) := Tasks2.Wait(Handle);
      if Tasks2.IsCancellationRequested(HostToken) then
        begin
          break;
        end;
      end if;

      Cells := Arrays.Concat(Cells, Row);
      CompletedRows := CompletedRows + 1;
      if CompletedRows = Request.Height then
        begin
          if Results.IsError(Tasks2.SendWithCancellation(Inbox, MandelbrotRenderFrame(Generation := Request.Generation, Cells := Cells), HostToken)) then
            begin
              break;
            end;
          end if;
        end;
      end if;
    end;
  end for;
  const Failures: array of (Tasks2.TaskFailure) := Tasks2.CloseTaskGroup(Group);
  for Failure: Tasks2.TaskFailure in Failures do
    begin
      if Failure.Kind <> Tasks2.TaskFailureKind.Cancelled then
        begin
          return Result.Error(Failure.Message);
        end;
      end if;
    end;
  end for;

  return Result.Ok(true);
end function;

end unit;
