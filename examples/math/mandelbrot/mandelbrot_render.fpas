// Built only via mandelbrot-core.fpasprj — not a standalone program.

unit Mandelbrot.Render;

uses Std.Conv, Std.Math, Std.Tasks, Std.Time, Std.Tui, Mandelbrot.Color;

public type Complex = record
  public Re: real;
  public Im: real;

  public static function Zero(): Complex;
  begin
    return Complex(Re := 0.0, Im := 0.0);
  end function;

  public static function Create(Re: real; Im: real): Complex;
  begin
    return Complex(Re := Re, Im := Im);
  end function;

  public function Sq(Self: Complex): Complex;
  begin
    return Complex(Re := Self.Re * Self.Re - Self.Im * Self.Im, Im := 2.0 * Self.Re * Self.Im);
  end function;

  public function Add(Self: Complex; Other: Complex): Complex;
  begin
    return Complex(Re := Self.Re + Other.Re, Im := Self.Im + Other.Im);
  end function;

  public function MagSq(Self: Complex): real;
  begin
    return Self.Re * Self.Re + Self.Im * Self.Im;
  end function;
end record;

public type PixelSample = record
  public IsInside: boolean;
  public EscapeValue: real;
end record;

public type MandelbrotRenderRequest = record
  public Generation: integer;
  public XMin: real;
  public XMax: real;
  public YMin: real;
  public YMax: real;
  public Width: integer;
  public Height: integer;
  public MaxIter: integer;
  public Palette: PaletteKind;
end record;

public type MandelbrotRenderFrame = record
  // One complete row-major image belonging to a render generation.
  public Generation: integer;
  public Cells: array of TuiCell;
end record;

function FinishSample(Z: Complex; Iterations: integer; MaxIter: integer): PixelSample;
begin
  if Iterations >= MaxIter then
    begin
      return PixelSample(IsInside := true, EscapeValue := 0.0);
    end;
  end if;
  const MagnitudeSq: real := Max(Z.MagSq(), 4.0);
  return PixelSample(IsInside := false, EscapeValue := IntToReal(Iterations) + 1.0 -
                                                       (Log(Log(MagnitudeSq) * 0.5) / Log(2.0)));
end function;

function Iterate(C: Complex; MaxIter: integer): PixelSample;
begin
  var Z: Complex := Complex.Zero();
  var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= 256.0) do
    begin
      Z := Z.Sq().Add(C);
      N := N + 1;
    end;
  end while;

  return FinishSample(Z, N, MaxIter);
end function;

function IterateCancellable(
  C: Complex;
  MaxIter: integer;
  HostToken: CancellationToken;
  WorkerToken: CancellationToken
): PixelSample;
begin
  var Z: Complex := Complex.Zero();
  var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= 256.0) do
    begin
      if IsCancellationRequested(HostToken) or IsCancellationRequested(WorkerToken) then
        begin
          break;
        end;
      end if;
      const ChunkEnd: integer := Min(N + 128, MaxIter);
      while (N < ChunkEnd) and (Z.MagSq() <= 256.0) do
        begin
          Z := Z.Sq().Add(C);
          N := N + 1;
        end;
      end while;
    end;
  end while;

  return FinishSample(Z, N, MaxIter);
end function;

// Computes one row without cancellation for reference rendering and tests.
public function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of PixelSample;
begin
  const WidthRange: integer := Max(Width - 1, 1);
  const HeightRange: integer := Max(Height - 1, 1);
  const Cy: real := YMax - Py / IntToReal(HeightRange) * (YMax - YMin);
  var Row: array of PixelSample := [];
  for Px: integer := 0 to Width - 1 do
    begin
      const Cx: real := XMin + Px / IntToReal(WidthRange) * (XMax - XMin);
      Row.Push(Iterate(Complex.Create(Cx, Cy), MaxIter));
    end;
  end for;

  return Row;
end function;

function ComputeRowCancellable(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer;
  HostToken: CancellationToken;
  WorkerToken: CancellationToken
): array of PixelSample;
begin
  const WidthRange: integer := Max(Width - 1, 1);
  const HeightRange: integer := Max(Height - 1, 1);
  const Cy: real := YMax - Py / IntToReal(HeightRange) * (YMax - YMin);
  var Row: array of PixelSample := [];
  var NextYield: integer := MonotonicMillis() + 8;
  for Px: integer := 0 to Width - 1 do
    begin
      if ((Px > 0) and (Px mod 16 = 0)) and (MonotonicMillis() >= NextYield) then
        begin
          // Let the Console reader run even when every pool worker is rendering.
          Sleep(0);
          NextYield := MonotonicMillis() + 8;
        end;
      end if;

      if IsCancellationRequested(HostToken) or IsCancellationRequested(WorkerToken) then
        begin
          return [];
        end;
      end if;
      const Cx: real := XMin + Px / IntToReal(WidthRange) * (XMax - XMin);
      Row.Push(IterateCancellable(Complex.Create(Cx, Cy), MaxIter, HostToken, WorkerToken));
    end;
  end for;

  if IsCancellationRequested(HostToken) or IsCancellationRequested(WorkerToken) then
    begin
      return [];
    end;
  end if;

  return Row;
end function;

function EscapeGlyph(EscapeValue: real): string;
begin
  const Ramp: string := ' ░▒▓█';
  const Count: integer := Ramp.Length();
  const Index: integer := Clamp(Trunc(Frac(EscapeValue * 0.08) * IntToReal(Count)), 0, Count - 1);
  return Ramp.CharAt(Index);
end function;

function RenderCell(Sample: PixelSample; Palette: PaletteKind): TuiCell;
begin
  const Background: TuiColor := TuiColor.FromRgb(0, 0, 0);
  if Sample.IsInside then
    begin
      const Shade: TuiColor := InsideColor();
      return TuiCell.Styled(' ', TuiStyle.FromColors(Shade, Shade));
    end;
  end if;

  return TuiCell.Styled(EscapeGlyph(Sample.EscapeValue), TuiStyle.FromColors(EscapeColor(Palette, Sample.EscapeValue), Background));
end function;

function RenderSamples(Samples: array of PixelSample; Palette: PaletteKind): array of TuiCell;
begin
  var Cells: array of TuiCell := [];
  for Sample: PixelSample in Samples do
    begin
      Cells.Push(RenderCell(Sample, Palette));
    end;
  end for;

  return Cells;
end function;

function RenderRowCells(Request: MandelbrotRenderRequest; Py: integer): array of TuiCell;
begin
  return RenderSamples(ComputeRow(Py, Request.Width, Request.Height, Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.MaxIter), Request.Palette);
end function;

function RenderRowCellsCancellable(
  Request: MandelbrotRenderRequest;
  Py: integer;
  HostToken: CancellationToken;
  WorkerToken: CancellationToken
): array of TuiCell;
begin
  return RenderSamples(ComputeRowCancellable(Py, Request.Width, Request.Height, Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.MaxIter, HostToken, WorkerToken), Request.Palette);
end function;

// Computes a flat row-major grid synchronously as a reference implementation.
public function RenderGrid(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: PaletteKind
): TuiCellGrid;
begin
  const Request: MandelbrotRenderRequest := MandelbrotRenderRequest(Generation := 0, XMin := XMin, XMax := XMax, YMin := YMin, YMax := YMax, Width := Width, Height := Height, MaxIter := MaxIter, Palette := Palette);
  var Cells: array of TuiCell := [];
  for Py: integer := 0 to Height - 1 do
    begin
      const Row: array of TuiCell := RenderRowCells(Request, Py);
      Cells := Cells.Concat(Row);
    end;
  end for;

  return TuiCellGrid.Create(Width, Height, Cells);
end function;

// Runs one task per row on the VM pool and publishes one complete image.
public function RunBackgroundRender(
  Request: MandelbrotRenderRequest;
  Inbox: channel of MandelbrotRenderFrame;
  HostToken: CancellationToken
): result of (boolean, string);
begin
  const Group: TaskGroup := CreateTaskGroup();
  var Tasks: array of task := [];
  for Py: integer := 0 to Request.Height - 1 do
    begin
      if IsCancellationRequested(HostToken) then
        begin
          break;
        end;
      end if;

      Tasks.Push(StartTaskInGroup(Group, function(WorkerToken: CancellationToken): array of TuiCell begin
        return RenderRowCellsCancellable(Request, Py, HostToken, WorkerToken);
      end function));
    end;
  end for;
  var Cells: array of TuiCell := [];
  for Py: integer := 0 to Tasks.Length() - 1 do
    begin
      if WaitAnyWithCancellation([Tasks[Py]], HostToken).IsError() then
        begin
          break;
        end;
      end if;
      const Row: array of TuiCell := Wait(Tasks[Py]);
      if IsCancellationRequested(HostToken) then
        begin
          break;
        end;
      end if;

      Cells := Cells.Concat(Row);
      if Py = Request.Height - 1 then
        begin
          if SendWithCancellation(Inbox, MandelbrotRenderFrame(Generation := Request.Generation, Cells := Cells), HostToken)
               .IsError() then
            begin
              break;
            end;
          end if;
        end;
      end if;
    end;
  end for;
  const Failures: array of TaskFailure := CloseTaskGroup(Group);
  for Failure: TaskFailure in Failures do
    begin
      if Failure.Kind <> TaskFailureKind.Cancelled then
        begin
          return Error(Failure.Message);
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;
end unit;
