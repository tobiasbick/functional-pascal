// Run as `fpas run newton.fpasprj` (multi-unit project). Interactive; see examples/README.md.

program NewtonShowcase;

uses Std.Console as Console, Std.Conv as Conv, Std.Math as Math, Newton.Render as Render;

type ExplorerState = record
  CenterX: real;
  CenterY: real;
  SpanY: real;
  MaxIter: integer;

  static function Default(): ExplorerState;
  begin
    return ExplorerState(CenterX := 0.0, CenterY := 0.0, SpanY := 3.0, MaxIter := 48);
  end function;

  function SpanX(Self: ExplorerState; Width: integer; Height: integer): real;
  begin
    const SafeWidth: integer := Math.Max(Width, 1);
    const SafeHeight: integer := Math.Max(Height, 1);
    return Self.SpanY * (Conv.IntToReal(SafeWidth) / Conv.IntToReal(SafeHeight)) * 0.5;
  end function;

  function XMin(Self: ExplorerState; Width: integer; Height: integer): real;
  begin
    return Self.CenterX - (Self.SpanX(Width, Height) * 0.5);
  end function;

  function XMax(Self: ExplorerState; Width: integer; Height: integer): real;
  begin
    return Self.CenterX + (Self.SpanX(Width, Height) * 0.5);
  end function;

  function YMin(Self: ExplorerState): real;
  begin
    return Self.CenterY - (Self.SpanY * 0.5);
  end function;

  function YMax(Self: ExplorerState): real;
  begin
    return Self.CenterY + (Self.SpanY * 0.5);
  end function;

  function GetZoom(Self: ExplorerState): real;
  begin
    return 3.0 / Self.SpanY;
  end function;
end record;

function RenderWidth(): integer;
begin
  return Math.Max(Console.ScreenWidth(), 1);
end function;

function RenderHeight(): integer;
begin
  return Math.Max(Console.ScreenHeight() - 3, 1);
end function;

function ViewportCX(State: ExplorerState; W: integer; H: integer; CellX: integer): real;
begin
  const Wr: integer := Math.Max(W - 1, 1);
  return State.XMin(W, H) +
    Conv.IntToReal(CellX - 1) / Conv.IntToReal(Wr) * (State.XMax(W, H) - State.XMin(W, H));
end function;

function ViewportCY(State: ExplorerState; W: integer; H: integer; CellY: integer): real;
begin
  const Hr: integer := Math.Max(H - 1, 1);
  return State.YMax() -
    Conv.IntToReal(CellY - 1) / Conv.IntToReal(Hr) * (State.YMax() - State.YMin());
end function;

procedure WriteHudText(Text: string; Width: integer);
begin
  if Width > 0 then
    begin
      const TextLength: integer := Math.Min(Text.Length(), Width);
      if TextLength > 0 then
        begin
          Console.WriteText(Text.Slice(0, TextLength));
        end;
      end if;
    end;
  end if;
end procedure;

procedure DrawHud(S: ExplorerState; Width: integer; Height: integer);
begin
  Console.Window(1, 1, Console.ScreenWidth(), Console.ScreenHeight());
  const HudTop: integer := Math.Max(Console.ScreenHeight() - 2, 1);
  Console.Window(1, HudTop, Console.ScreenWidth(), Console.ScreenHeight());
  Console.NormVideo();
  Console.ClrScr();
  Console.GotoXY(1, 1);
  Console.TextColorRGB(255, 220, 120);
  const Title: string := 'Functional Pascal Newton z^3-1';
  WriteHudText(Title, Width);
  Console.TextColorRGB(156, 204, 255);
  WriteHudText(
    '  tasks | units | records | postfix | truecolor',
    Math.Max(Width - Title.Length(), 0)
  );
  if Console.ScreenHeight() >= 2 then
    begin
      Console.GotoXY(1, 2);
      Console.NormVideo();
      WriteHudText(
        'size=%dx%d  center=(%f, %f)  zoom=%f  iter=%d'.Format(
          Width,
          Height,
          S.CenterX,
          S.CenterY,
          S.GetZoom(),
          S.MaxIter
        ),
        Width
      );
    end;
  end if;

  if Console.ScreenHeight() >= 3 then
    begin
      Console.GotoXY(1, 3);
      Console.NormVideo();
      WriteHudText('click center  wheel zoom  arrows  +/-  PgUp/Dn  R  Esc', Width);
    end;
  end if;

  Console.NormVideo();
  Console.Window(1, 1, Width, Height);
end procedure;

var State: ExplorerState := ExplorerState.Default();
var RenderW: integer := 1;
var RenderH: integer := 1;
var NeedsRedraw: boolean := true;
var Quit: boolean := false;

procedure RequestRedraw();
begin
  NeedsRedraw := true;
end procedure;

procedure PaintFrame();
begin
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  Console.BeginFrame();
  Console.FillRect(
    Console.Rect(x := 1, y := 1, width := Console.ScreenWidth(), height := Console.ScreenHeight()),
    Console.Cell(
      glyph := ' ',
      foreground := Console.RgbColor(0, 0, 0),
      background := Console.RgbColor(0, 0, 0)
    )
  );
  Render.Render(
    State.XMin(RenderW, RenderH),
    State.XMax(RenderW, RenderH),
    State.YMin(),
    State.YMax(),
    RenderW,
    RenderH,
    State.MaxIter
  );
  DrawHud(State, RenderW, RenderH);
  Console.Present();
end procedure;

function HandleKey(Key: Console.KeyEvent): boolean;
begin
  const StepX: real := State.SpanX(RenderW, RenderH) * 0.14;
  const StepY: real := State.SpanY * 0.14;
  if Key.kind = Console.KeyKind.Escape then
    begin
      Quit := true;
      return true;
    end;
  elsif Key.kind = Console.KeyKind.Left then
    begin
      State.CenterX := State.CenterX - StepX;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = Console.KeyKind.Right then
    begin
      State.CenterX := State.CenterX + StepX;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = Console.KeyKind.Up then
    begin
      State.CenterY := State.CenterY + StepY;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = Console.KeyKind.Down then
    begin
      State.CenterY := State.CenterY - StepY;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = Console.KeyKind.PageUp then
    begin
      State.MaxIter := Math.Min(State.MaxIter + 8, 256);
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = Console.KeyKind.PageDown then
    begin
      State.MaxIter := Math.Max(State.MaxIter - 8, 8);
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = Console.KeyKind.Character then
    begin
      case Key.ch of
        when '+', '=':
          begin
            State.SpanY := Math.Max(State.SpanY * 0.82, 0.000001);
            RequestRedraw();
            return true;
          end;
        when '-':
          begin
            State.SpanY := Math.Min(State.SpanY / 0.82, 6.0);
            RequestRedraw();
            return true;
          end;
        when 'r', 'R':
          begin
            State := ExplorerState.Default();
            RequestRedraw();
            return true;
          end;
        else
          null;
      end case;
    end;
  end if;

  return false;
end function;

procedure HandleMouse(InputEvent: Console.ConsoleEvent);
begin
  const InView: boolean := (
    ((InputEvent.mouse_x >= 1) and (InputEvent.mouse_x <= RenderW)) and (InputEvent.mouse_y >= 1)
  )
    and
    (InputEvent.mouse_y <= RenderH);
  if InputEvent.mouse_action = Console.MouseAction.ScrollUp then
    begin
      State.SpanY := Math.Max(State.SpanY * 0.88, 0.000001);
      RequestRedraw();
    end;
  elsif InputEvent.mouse_action = Console.MouseAction.ScrollDown then
    begin
      State.SpanY := Math.Min(State.SpanY / 0.88, 6.0);
      RequestRedraw();
    end;
  elsif InView and (InputEvent.mouse_action = Console.MouseAction.Down) then
    begin
      if InputEvent.mouse_button = Console.MouseButton.Left then
        begin
          State.CenterX := ViewportCX(State, RenderW, RenderH, InputEvent.mouse_x);
          State.CenterY := ViewportCY(State, RenderW, RenderH, InputEvent.mouse_y);
          RequestRedraw();
        end;
      elsif InputEvent.mouse_button = Console.MouseButton.Middle then
        begin
          State := ExplorerState.Default();
          RequestRedraw();
        end;
      end if;
    end;
  end if;
end procedure;

procedure HandleResize(Width: integer; Height: integer);
begin
  const NewW: integer := Math.Max(Width, 1);
  const NewH: integer := Math.Max(Height - 2, 1);
  if (NewW <> RenderW) or (NewH <> RenderH) then
    begin
      RenderW := NewW;
      RenderH := NewH;
      RequestRedraw();
    end;
  end if;
end procedure;

procedure HandleEvent(E: Console.ConsoleEvent);
begin
  if E.kind = Console.EventKind.Key then
    begin
      discard HandleKey(E.key);
    end;
  elsif E.kind = Console.EventKind.Mouse then
    begin
      HandleMouse(E);
    end;
  elsif E.kind = Console.EventKind.Resize then
    begin
      HandleResize(E.width, E.height);
    end;
  end if;
end procedure;

procedure ShutdownTerminal();
begin
  Console.CursorOn();
  Console.DisablePaste();
  Console.DisableFocus();
  Console.DisableMouse();
  Console.DisableRawMode();
  Console.LeaveAltScreen();
end procedure;

begin
  Console.EnableRawMode();
  Console.EnterAltScreen();
  Console.EnableMouse();
  Console.EnableFocus();
  Console.EnablePaste();
  Console.CursorOff();
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  NeedsRedraw := true;
  while not Quit do
    begin
      if NeedsRedraw then
        begin
          PaintFrame();
          NeedsRedraw := false;
        end;
      end if;

      case Console.ReadEventTimeout(16) of
        when Some(const E):
          begin
            HandleEvent(E);
          end;
        when None:
          begin
          end;
      end case;
    end;
  end while;

  ShutdownTerminal();
end.
