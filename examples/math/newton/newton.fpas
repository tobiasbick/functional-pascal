// Run as `fpas run newton.fpasprj` (multi-unit project). Interactive; see examples/README.md.

program NewtonShowcase;

uses Std.Console, Std.Conv, Std.Math, Std.Options, Std.Str, Newton.Render;

type
  ExplorerState = record
    CenterX: real;
    CenterY: real;
    SpanY: real;
    MaxIter: integer;

    static function Default(): ExplorerState;
    begin
      return record
        CenterX := 0.0;
        CenterY := 0.0;
        SpanY := 3.0;
        MaxIter := 48;
      end;
    end function;

    function SpanX(Self: ExplorerState; Width: integer; Height: integer): real;
    begin
      var SafeWidth: integer := Max(Width, 1);
      var SafeHeight: integer := Max(Height, 1);
      return (Self.SpanY * (IntToReal(SafeWidth) / IntToReal(SafeHeight))) * 0.5;
    end function;

    function XMin(Self: ExplorerState; Width: integer; Height: integer): real;
    begin
      return Self.CenterX - (Self.SpanX(Width, Height) * 0.5);
    end function;

    function XMax(Self: ExplorerState; Width: integer; Height: integer): real;
    begin
      return Self.CenterX + (Self.SpanX(Width, Height) * 0.5);
    end function;

    function YMin(Self: ExplorerState): real;
    begin
      return Self.CenterY - (Self.SpanY * 0.5);
    end function;

    function YMax(Self: ExplorerState): real;
    begin
      return Self.CenterY + (Self.SpanY * 0.5);
    end function;

    function GetZoom(Self: ExplorerState): real;
    begin
      return 3.0 / Self.SpanY;
    end function;

    property Zoom: real read GetZoom;
  end record;

function RenderWidth(): integer;
begin
  return Max(ScreenWidth(), 1);
end function;

function RenderHeight(): integer;
begin
  return Max(ScreenHeight() - 3, 1);
end function;

function ViewportCX(State: ExplorerState; W: integer; H: integer; CellX: integer): real;
begin
  var Wr: integer := Max(W - 1, 1);
  return State.XMin(W, H) +
         (IntToReal(CellX - 1) / IntToReal(Wr)) * (State.XMax(W, H) - State.XMin(W, H));
end function;

function ViewportCY(State: ExplorerState; W: integer; H: integer; CellY: integer): real;
begin
  var Hr: integer := Max(H - 1, 1);
  return State.YMax() - (IntToReal(CellY - 1) / IntToReal(Hr)) * (State.YMax() - State.YMin());
end function;

procedure WriteHudText(Text: string; Width: integer);
begin
  if Width > 0 then
    begin
      var TextLength: integer := Min(Std.Str.Length(Text), Width);
      if TextLength > 0 then
        begin
          WriteText(Substring(Text, 0, TextLength));
        end;
      end if;
    end;
  end if;
end procedure;

procedure DrawHud(S: ExplorerState; Width: integer; Height: integer);
begin
  Window(1, 1, ScreenWidth(), ScreenHeight());
  var HudTop: integer := Max(ScreenHeight() - 2, 1);
  Window(1, HudTop, ScreenWidth(), ScreenHeight());
  NormVideo();
  ClrScr();
  GotoXY(1, 1);
  TextColorRGB(255, 220, 120);
  var Title: string := 'Functional Pascal Newton z^3-1';
  WriteHudText(Title, Width);
  TextColorRGB(156, 204, 255);
  WriteHudText('  tasks | units | records | postfix | truecolor', Max(Width - Std.Str.Length(Title), 0));
  if ScreenHeight() >= 2 then
    begin
      GotoXY(1, 2);
      NormVideo();
      WriteHudText(Format('size=%dx%d  center=(%f, %f)  zoom=%f  iter=%d', Width, Height, S.CenterX, S.CenterY, S.Zoom, S.MaxIter), Width);
    end;
  end if;

  if ScreenHeight() >= 3 then
    begin
      GotoXY(1, 3);
      NormVideo();
      WriteHudText('click center  wheel zoom  arrows  +/-  PgUp/Dn  R  Esc', Width);
    end;
  end if;

  NormVideo();
  Window(1, 1, Width, Height);
end procedure;

mutable var
  State: ExplorerState := ExplorerState.Default();
  RenderW: integer := 1;
  RenderH: integer := 1;
  NeedsRedraw: boolean := true;
  Quit: boolean := false;

procedure RequestRedraw();
begin
  NeedsRedraw := true;
end procedure;

procedure PaintFrame();
begin
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  BeginFrame();
  FillRect(record
    x := 1;
    y := 1;
    width := ScreenWidth();
    height := ScreenHeight();
  end, record
    glyph := ' ';
    foreground := RgbColor(0, 0, 0);
    background := RgbColor(0, 0, 0);
  end);
  Render(State.XMin(RenderW, RenderH), State.XMax(RenderW, RenderH), State.YMin(), State.YMax(), RenderW, RenderH, State.MaxIter);
  DrawHud(State, RenderW, RenderH);
  Present();
end procedure;

function HandleKey(Key: KeyEvent): boolean;
begin
  var StepX: real := State.SpanX(RenderW, RenderH) * 0.14;
  var StepY: real := State.SpanY * 0.14;
  if Key.kind = KeyKind.Escape then
    begin
      Quit := true;
      return true;
    end;
  elsif Key.kind = KeyKind.Left then
    begin
      State.CenterX := State.CenterX - StepX;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.Right then
    begin
      State.CenterX := State.CenterX + StepX;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.Up then
    begin
      State.CenterY := State.CenterY + StepY;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.Down then
    begin
      State.CenterY := State.CenterY - StepY;
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.PageUp then
    begin
      State.MaxIter := Min(State.MaxIter + 8, 256);
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.PageDown then
    begin
      State.MaxIter := Max(State.MaxIter - 8, 8);
      RequestRedraw();
      return true;
    end;
  elsif Key.kind = KeyKind.Character then
    begin
      case Key.ch of
        when '+', '=':
          begin
            State.SpanY := Max(State.SpanY * 0.82, 0.000001);
            RequestRedraw();
            return true;
          end;
        when '-':
          begin
            State.SpanY := Min(State.SpanY / 0.82, 6.0);
            RequestRedraw();
            return true;
          end;
        when 'r', 'R':
          begin
            State := ExplorerState.Default();
            RequestRedraw();
            return true;
          end;
      end case;
    end;
  end if;

  return false;
end function;

procedure HandleMouse(InputEvent: ConsoleEvent);
begin
  var InView: boolean := (((InputEvent.mouse_x >= 1) and (InputEvent.mouse_x <= RenderW)) and (InputEvent.mouse_y >= 1)) and
                         (InputEvent.mouse_y <= RenderH);
  if InputEvent.mouse_action = MouseAction.ScrollUp then
    begin
      State.SpanY := Max(State.SpanY * 0.88, 0.000001);
      RequestRedraw();
    end;
  elsif InputEvent.mouse_action = MouseAction.ScrollDown then
    begin
      State.SpanY := Min(State.SpanY / 0.88, 6.0);
      RequestRedraw();
    end;
  elsif InView and (InputEvent.mouse_action = MouseAction.Down) then
    begin
      if InputEvent.mouse_button = MouseButton.Left then
        begin
          State.CenterX := ViewportCX(State, RenderW, RenderH, InputEvent.mouse_x);
          State.CenterY := ViewportCY(State, RenderW, RenderH, InputEvent.mouse_y);
          RequestRedraw();
        end;
      elsif InputEvent.mouse_button = MouseButton.Middle then
        begin
          State := ExplorerState.Default();
          RequestRedraw();
        end;
      end if;
    end;
  end if;
end procedure;

procedure HandleResize(Width: integer; Height: integer);
begin
  var NewW: integer := Max(Width, 1);
  var NewH: integer := Max(Height - 2, 1);
  if (NewW <> RenderW) or (NewH <> RenderH) then
    begin
      RenderW := NewW;
      RenderH := NewH;
      RequestRedraw();
    end;
  end if;
end procedure;

procedure HandleEvent(E: ConsoleEvent);
begin
  if E.kind = EventKind.Key then
    begin
      HandleKey(E.key);
    end;
  elsif E.kind = EventKind.Mouse then
    begin
      HandleMouse(E);
    end;
  elsif E.kind = EventKind.Resize then
    begin
      HandleResize(E.width, E.height);
    end;
  end if;
end procedure;

procedure ShutdownTerminal();
begin
  CursorOn();
  DisablePaste();
  DisableFocus();
  DisableMouse();
  DisableRawMode();
  LeaveAltScreen();
end procedure;

begin
  EnableRawMode();
  EnterAltScreen();
  EnableMouse();
  EnableFocus();
  EnablePaste();
  CursorOff();
  RenderW := RenderWidth();
  RenderH := RenderHeight();
  NeedsRedraw := true;
  while not Quit do
    begin
      if NeedsRedraw then
        begin
          PaintFrame();
          NeedsRedraw := false;
        end;
      end if;

      case ReadEventTimeout(16) of
        when Some(E):
          begin
            HandleEvent(E);
          end;
        when None:
          begin
          end;
      end case;
    end;
  end while;

  ShutdownTerminal();
end.
