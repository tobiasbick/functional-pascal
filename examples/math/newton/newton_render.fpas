// Built only via newton.fpasprj — not a standalone program.

unit Newton.Render;

uses Std.Console, Std.Tasks, Std.Conv, Std.Math, Newton.Color;

type Complex = record
  public Re: real;
  public Im: real;

  public static function Create(Re: real; Im: real): Complex;
  begin
    return record
      Re := Re;
      Im := Im;
    end;
  end function;

  public function Add(Self: Complex; Other: Complex): Complex;
  begin
    return record
      Re := Self.Re + Other.Re;
      Im := Self.Im + Other.Im;
    end;
  end function;

  public function Sub(Self: Complex; Other: Complex): Complex;
  begin
    return record
      Re := Self.Re - Other.Re;
      Im := Self.Im - Other.Im;
    end;
  end function;

  public function Mul(Self: Complex; Other: Complex): Complex;
  begin
    return record
      Re := Self.Re * Other.Re - Self.Im * Other.Im;
      Im := Self.Re * Other.Im + Self.Im * Other.Re;
    end;
  end function;

  public function Scale(Self: Complex; Factor: real): Complex;
  begin
    return record
      Re := Self.Re * Factor;
      Im := Self.Im * Factor;
    end;
  end function;

  public function Sq(Self: Complex): Complex;
  begin
    return Self.Mul(Self);
  end function;

  public function Inv(Self: Complex): Complex;
  begin
    const Den: real := Self.Re * Self.Re + Self.Im * Self.Im;
    return record
      Re := Self.Re / Den;
      Im := - Self.Im / Den;
    end;
  end function;

  public function MagSq(Self: Complex): real;
  begin
    return Self.Re * Self.Re + Self.Im * Self.Im;
  end function;
end record;

type PixelSample = record
  public Root: integer;
  public Shade: real;
end record;

function ClosestRoot(Z: Complex): integer;
begin
  const R1: Complex := Complex.Create(1.0, 0.0);
  const R2: Complex := Complex.Create(-0.5, 0.8660254037844386);
  const R3: Complex := Complex.Create(-0.5, -0.8660254037844386);
  const D1: real := Z.Sub(R1).MagSq();
  const D2: real := Z.Sub(R2).MagSq();
  const D3: real := Z.Sub(R3).MagSq();
  if (D1 <= D2) and (D1 <= D3) then
    begin
      return 1;
    end;
  elsif D2 <= D3 then
    begin
      return 2;
    end;
  else
    begin
      return 3;
    end;
  end if;
end function;

function Iterate(Z0: Complex; MaxIter: integer): PixelSample;
begin
  var Z: Complex := Z0;
  var N: integer := 0;
  const Tolerance: real := 0.000001;
  while N < MaxIter do
    begin
      const Z2: Complex := Z.Sq();
      if Z2.MagSq() < 0.000000000001 then
        begin
          return record
            Root := 0;
            Shade := 0.0;
          end;
        end;
      end if;
      const Next: Complex := Z.Scale(2.0 / 3.0).Add(Z2.Inv().Scale(1.0 / 3.0));
      if Next.Sub(Z).MagSq() < Tolerance then
        begin
          const Shade: real := 1.0 - (IntToReal(N) / IntToReal(Max(MaxIter, 1)));
          return record
            Root := ClosestRoot(Next);
            Shade := Shade;
          end;
        end;
      end if;

      Z := Next;
      N := N + 1;
    end;
  end while;

  return record
    Root := ClosestRoot(Z);
    Shade := 0.25;
  end;
end function;

function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of PixelSample;
begin
  var WidthRange: integer := Width - 1;
  var HeightRange: integer := Height - 1;
  if WidthRange < 1 then
    begin
      WidthRange := 1;
    end;
  end if;

  if HeightRange < 1 then
    begin
      HeightRange := 1;
    end;
  end if;
  const Wr: real := IntToReal(WidthRange);
  const Hr: real := IntToReal(HeightRange);
  const cy: real := YMax - (Py / Hr) * (YMax - YMin);
  var Row: array of PixelSample := [];
  for Px: integer := 0 to Width - 1 do
    begin
      const cx: real := XMin + (Px / Wr) * (XMax - XMin);
      Row.Push(Iterate(Complex.Create(cx, cy), MaxIter));
    end;
  end for;

  return Row;
end function;

function ShadeGlyph(Shade: real): string;
begin
  const Ramp: string := ' ░▒▓█';
  const Count: integer := Ramp.Length();
  const Index: integer := Clamp(Trunc(Shade * IntToReal(Count)), 0, Count - 1);
  return Ramp.CharAt(Index);
end function;

function RenderCell(Sample: PixelSample): Cell;
begin
  if Sample.Root = 0 then
    begin
      const CellShade: Color := InsideColor();
      return record
        glyph := ' ';
        foreground := CellShade;
        background := CellShade;
      end;
    end;
  end if;
  const Fg: Color := RootColor(Sample.Root, Sample.Shade);
  return record
    glyph := ShadeGlyph(Sample.Shade);
    foreground := Fg;
    background := RgbColor(0, 0, 0);
  end;
end function;

procedure DrawRow(Row: array of PixelSample; Width: integer; Y: integer);
begin
  const CurrentWidth: integer := ScreenWidth();
  var DrawWidth: integer := Width;
  if DrawWidth > CurrentWidth then
    begin
      DrawWidth := CurrentWidth;
    end;
  end if;

  if DrawWidth < 1 then
    begin
      return;
    end;
  end if;
  var Cells: array of Cell := [];
  for Px: integer := 0 to DrawWidth - 1 do
    begin
      Cells.Push(RenderCell(Row[Px]));
    end;
  end for;

  WriteCells(1, Y, Cells);
end procedure;

public procedure Render(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer
);
begin
  var Tasks: array of task := [];
  for Py: integer := 0 to Height - 1 do
    begin
      Tasks.Push(go ComputeRow(Py, Width, Height, XMin, XMax, YMin, YMax, MaxIter));
    end;
  end for;

  for Py: integer := 0 to Height - 1 do
    begin
      const Row: array of PixelSample := Wait(Tasks[Py]);
      if (Py + 1) <= Max(ScreenHeight() - 2, 1) then
        begin
          DrawRow(Row, Width, Py + 1);
        end;
      end if;
    end;
  end for;
end procedure;
end unit;
