// Built only via newton.fpasprj — not a standalone program.

unit Newton.Render;

uses Std.Console as Console;
uses Std.Tasks as Tasks2;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Math as Math;
uses Std.Str as Str;
uses Newton.Color as Color2;

type Complex = record
  public Re: real;
  public Im: real;
end record;

function ComplexCreate(Re: real; Im: real): Complex;
begin
  return Complex(Re := Re, Im := Im);
end function;

function ComplexAdd(Receiver: Complex; Other: Complex): Complex;
begin
  return Complex(Re := Receiver.Re + Other.Re, Im := Receiver.Im + Other.Im);
end function;

function ComplexSub(Receiver: Complex; Other: Complex): Complex;
begin
  return Complex(Re := Receiver.Re - Other.Re, Im := Receiver.Im - Other.Im);
end function;

function ComplexMul(Receiver: Complex; Other: Complex): Complex;
begin
  return Complex(Re := Receiver.Re * Other.Re - Receiver.Im * Other.Im, Im := Receiver.Re * Other.Im +
                                                                              Receiver.Im * Other.Re);
end function;

function ComplexScale(Receiver: Complex; Factor: real): Complex;
begin
  return Complex(Re := Receiver.Re * Factor, Im := Receiver.Im * Factor);
end function;

function ComplexSq(Receiver: Complex): Complex;
begin
  return ComplexMul(Receiver, Receiver);
end function;

function ComplexInv(Receiver: Complex): Complex;
begin
  const Den: real := Receiver.Re * Receiver.Re + Receiver.Im * Receiver.Im;
  return Complex(Re := Receiver.Re / Den, Im := - Receiver.Im / Den);
end function;

function ComplexMagSq(Receiver: Complex): real;
begin
  return Receiver.Re * Receiver.Re + Receiver.Im * Receiver.Im;
end function;

type PixelSample = record
  public Root: integer;
  public Shade: real;
end record;

function ClosestRoot(Z: Complex): integer;
begin
  const R1: Complex := ComplexCreate(1.0, 0.0);
  const R2: Complex := ComplexCreate(-0.5, 0.8660254037844386);
  const R3: Complex := ComplexCreate(-0.5, -0.8660254037844386);
  const D1: real := ComplexMagSq(ComplexSub(Z, R1));
  const D2: real := ComplexMagSq(ComplexSub(Z, R2));
  const D3: real := ComplexMagSq(ComplexSub(Z, R3));
  if (D1 <= D2) and (D1 <= D3) then
    begin
      return 1;
    end;
  else
    if D2 <= D3 then
      begin
        return 2;
      end;
    else
      begin
        return 3;
      end;
    end if;
  end if;
end function;

function Iterate(Z0: Complex; MaxIter: integer): PixelSample;
begin
  var Z: Complex := Z0;
  var N: integer := 0;
  const Tolerance: real := 0.000001;
  while N < MaxIter do
    begin
      const Z2: Complex := ComplexSq(Z);
      if ComplexMagSq(Z2) < 0.000000000001 then
        begin
          return PixelSample(Root := 0, Shade := 0.0);
        end;
      end if;
      const Next: Complex := ComplexAdd(ComplexScale(Z, 2.0 / 3.0), ComplexScale(ComplexInv(Z2), 1.0 /
                                                                                                 3.0));
      if ComplexMagSq(ComplexSub(Next, Z)) < Tolerance then
        begin
          const Shade: real := 1.0 - (Conv.IntToReal(N) / Conv.IntToReal(Math.Max(MaxIter, 1)));
          return PixelSample(Root := ClosestRoot(Next), Shade := Shade);
        end;
      end if;

      Z := Next;
      N := N + 1;
    end;
  end while;

  return PixelSample(Root := ClosestRoot(Z), Shade := 0.25);
end function;

function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of (PixelSample);
begin
  var WidthRange: integer := Width - 1;
  var HeightRange: integer := Height - 1;
  if WidthRange < 1 then
    begin
      WidthRange := 1;
    end;
  end if;

  if HeightRange < 1 then
    begin
      HeightRange := 1;
    end;
  end if;
  const Wr: real := Conv.IntToReal(WidthRange);
  const Hr: real := Conv.IntToReal(HeightRange);
  const cy: real := YMax - (Py / Hr) * (YMax - YMin);
  var Row: array of (PixelSample) := [];
  for Px: integer := 0 to Width - 1 do
    begin
      const cx: real := XMin + (Px / Wr) * (XMax - XMin);
      Arrays.Push(var Row, Iterate(ComplexCreate(cx, cy), MaxIter));
    end;
  end for;

  return Row;
end function;

function ShadeGlyph(Shade: real): string;
begin
  const Ramp: string := ' ░▒▓█';
  const Count: integer := Str.Length(Ramp);
  const Index: integer := Math.Clamp(Math.Trunc(Shade * Conv.IntToReal(Count)), 0, Count - 1);
  return Str.CharAt(Ramp, Index);
end function;

function RenderCell(Sample: PixelSample): Console.Cell;
begin
  if Sample.Root = 0 then
    begin
      const CellShade: Console.Color := Color2.InsideColor();
      return Console.Cell(glyph := ' ', foreground := CellShade, background := CellShade);
    end;
  end if;
  const Fg: Console.Color := Color2.RootColor(Sample.Root, Sample.Shade);
  return Console.Cell(glyph := ShadeGlyph(Sample.Shade), foreground := Fg, background := Console.RgbColor(0, 0, 0));
end function;

procedure DrawRow(Row: array of (PixelSample); Width: integer; Y: integer);
begin
  const CurrentWidth: integer := Console.ScreenWidth();
  var DrawWidth: integer := Width;
  if DrawWidth > CurrentWidth then
    begin
      DrawWidth := CurrentWidth;
    end;
  end if;

  if DrawWidth < 1 then
    begin
      return;
    end;
  end if;
  var Cells: array of (Console.Cell) := [];
  for Px: integer := 0 to DrawWidth - 1 do
    begin
      Arrays.Push(var Cells, RenderCell(Row[Px]));
    end;
  end for;

  Console.WriteCells(1, Y, Cells);
end procedure;

public procedure Render(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer
);
begin
  var Tasks: array of (task) := [];
  for Py: integer := 0 to Height - 1 do
    begin
      Arrays.Push(var Tasks, go ComputeRow(Py, Width, Height, XMin, XMax, YMin, YMax, MaxIter));
    end;
  end for;

  for Py: integer := 0 to Height - 1 do
    begin
      const Row: array of (PixelSample) := Tasks2.Wait(Tasks[Py]);
      if (Py + 1) <= Math.Max(Console.ScreenHeight() - 2, 1) then
        begin
          DrawRow(Row, Width, Py + 1);
        end;
      end if;
    end;
  end for;
end procedure;

end unit;
