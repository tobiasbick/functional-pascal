{ Built only via newton.fpasprj — not a standalone program. }

unit Newton.Render;

uses Std.Console, Std.Task, Std.Array, Std.Conv, Std.Math, Std.Str, Newton.Color;

type
  Complex = record
    public Re: real;
    public Im: real;

    public static function Create(Re: real; Im: real): Complex;
    begin
      return record
        Re := Re;
        Im := Im;
      end
    end;

    public function Add(Self: Complex; Other: Complex): Complex;
    begin
      return record
        Re := Self.Re + Other.Re;
        Im := Self.Im + Other.Im;
      end
    end;

    public function Sub(Self: Complex; Other: Complex): Complex;
    begin
      return record
        Re := Self.Re - Other.Re;
        Im := Self.Im - Other.Im;
      end
    end;

    public function Mul(Self: Complex; Other: Complex): Complex;
    begin
      return record
        Re := Self.Re * Other.Re - Self.Im * Other.Im;
        Im := Self.Re * Other.Im + Self.Im * Other.Re;
      end
    end;

    public function Scale(Self: Complex; Factor: real): Complex;
    begin
      return record
        Re := Self.Re * Factor;
        Im := Self.Im * Factor;
      end
    end;

    public function Sq(Self: Complex): Complex;
    begin
      return Self.Mul(Self)
    end;

    public function Inv(Self: Complex): Complex;
    begin
      var Den: real := Self.Re * Self.Re + Self.Im * Self.Im;
      return record
        Re := Self.Re / Den;
        Im := - Self.Im / Den;
      end
    end;

    public function MagSq(Self: Complex): real;
    begin
      return Self.Re * Self.Re + Self.Im * Self.Im
    end;
  end;
  PixelSample = record
    public Root: integer;
    public Shade: real;
  end;

function ClosestRoot(Z: Complex): integer;
begin
  var R1: Complex := Complex.Create(1.0, 0.0);
  var R2: Complex := Complex.Create(-0.5, 0.8660254037844386);
  var R3: Complex := Complex.Create(-0.5, -0.8660254037844386);
  var D1: real := Z.Sub(R1).MagSq();
  var D2: real := Z.Sub(R2).MagSq();
  var D3: real := Z.Sub(R3).MagSq();
  if (D1 <= D2) and (D1 <= D3) then
  begin
    return 1
  end
  else if D2 <= D3 then
  begin
    return 2
  end
  else
  begin
    return 3
  end
end;

function Iterate(Z0: Complex; MaxIter: integer): PixelSample;
begin
  mutable var Z: Complex := Z0;
  mutable var N: integer := 0;
  var Tolerance: real := 0.000001;
  while N < MaxIter do
  begin
    var Z2: Complex := Z.Sq();
    if Z2.MagSq() < 0.000000000001 then
    begin
      return record
        Root := 0;
        Shade := 0.0;
      end
    end;
    var Next: Complex := Z.Scale(2.0 / 3.0).Add(Z2.Inv().Scale(1.0 / 3.0));
    if Next.Sub(Z).MagSq() < Tolerance then
    begin
      var Shade: real := 1.0 - (IntToReal(N) / IntToReal(Max(MaxIter, 1)));
      return record
        Root := ClosestRoot(Next);
        Shade := Shade;
      end
    end;
    Z := Next;
    N := N + 1
  end;
  return record
    Root := ClosestRoot(Z);
    Shade := 0.25;
  end
end;

function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of PixelSample;
begin
  mutable var WidthRange: integer := Width - 1;
  mutable var HeightRange: integer := Height - 1;
  if WidthRange < 1 then
  begin
    WidthRange := 1
  end;
  if HeightRange < 1 then
  begin
    HeightRange := 1
  end;
  var Wr: real := IntToReal(WidthRange);
  var Hr: real := IntToReal(HeightRange);
  var cy: real := YMax - (Py / Hr) * (YMax - YMin);
  mutable var Row: array of PixelSample := [];
  for Px: integer := 0 to Width - 1 do
  begin
    var cx: real := XMin + (Px / Wr) * (XMax - XMin);
    Push(Row, Iterate(Complex.Create(cx, cy), MaxIter))
  end;
  return Row
end;

function ShadeGlyph(Shade: real): string;
begin
  var Ramp: string := ' ░▒▓█';
  var Count: integer := Std.Str.Length(Ramp);
  var Index: integer := Clamp(Trunc(Shade * IntToReal(Count)), 0, Count - 1);
  return CharAt(Ramp, Index)
end;

function RenderCell(Sample: PixelSample): Cell;
begin
  if Sample.Root = 0 then
  begin
    var CellShade: Color := InsideColor();
    return record
      glyph := ' ';
      foreground := CellShade;
      background := CellShade;
    end
  end;
  var Fg: Color := RootColor(Sample.Root, Sample.Shade);
  return record
    glyph := ShadeGlyph(Sample.Shade);
    foreground := Fg;
    background := RgbColor(0, 0, 0);
  end
end;

procedure DrawRow(Row: array of PixelSample; Width: integer; Y: integer);
begin
  var CurrentWidth: integer := ScreenWidth();
  mutable var DrawWidth: integer := Width;
  if DrawWidth > CurrentWidth then
  begin
    DrawWidth := CurrentWidth
  end;
  if DrawWidth < 1 then
  begin
    return
  end;
  mutable var Cells: array of Cell := [];
  for Px: integer := 0 to DrawWidth - 1 do
  begin
    Push(Cells, RenderCell(Row[Px]))
  end;
  WriteCells(1, Y, Cells)
end;

public procedure Render(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer
);
begin
  mutable var Tasks: array of task := [];
  for Py: integer := 0 to Height - 1 do
  begin
    Push(Tasks, go ComputeRow(Py, Width, Height, XMin, XMax, YMin, YMax, MaxIter))
  end;
  for Py: integer := 0 to Height - 1 do
  begin
    var Row: array of PixelSample := Wait(Tasks[Py]);
    if (Py + 1) <= Max(ScreenHeight() - 2, 1) then
    begin
      DrawRow(Row, Width, Py + 1)
    end
  end
end;
