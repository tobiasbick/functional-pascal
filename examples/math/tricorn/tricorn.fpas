// Interactive renderer using the shared fractal explorer lifecycle.
program TricornShowcase;

uses
  Fractal.Camera as Camera, Fractal.Explorer as Explorer, Tricorn.Color as Color,
  Tricorn.Render as Render;

function Palette(Value: integer): Color.PaletteKind;
begin
  case Value of
    when 1:
      begin
        return Color.PaletteKind.DeepOcean;
      end;
    when 2:
      begin
        return Color.PaletteKind.Ember;
      end;
    else
      begin
        return Color.PaletteKind.Aurora;
      end;
  end case;
end function;

function Label(Value: integer): string;
begin
  return Color.PaletteName(Palette(Value));
end function;

procedure Draw(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Value: integer
);
begin
  Render.Render(XMin, XMax, YMin, YMax, Width, Height, MaxIter, Palette(Value));
end procedure;

begin
  const Initial: Camera.ExplorerCamera := Camera.ExplorerCamera(CenterX := 0.0, CenterY := 0.0, SpanY := 2.8, MaxIter := 160, Palette := 3);
  Explorer.RunExplorer('Functional Pascal Tricorn', Initial, Draw, Label);
end.
