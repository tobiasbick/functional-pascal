// Interactive renderer using the shared fractal explorer lifecycle.
program TricornShowcase;

uses Fractal.Camera, Fractal.Explorer, Tricorn.Color, Tricorn.Render;

function Palette(Value: integer): PaletteKind;
begin
  case Value of
    1:
    begin
      return PaletteKind.DeepOcean
    end;
    2:
    begin
      return PaletteKind.Ember
    end
    else
    begin
      return PaletteKind.Aurora
    end
  end
end;

function Label(Value: integer): string;
begin
  return PaletteName(Palette(Value))
end;

procedure Draw(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Value: integer
);
begin
  Render(XMin, XMax, YMin, YMax, Width, Height, MaxIter, Palette(Value))
end;

begin
  var Initial: ExplorerCamera := record
    CenterX := 0.0;
    CenterY := 0.0;
    SpanY := 2.8;
    MaxIter := 160;
    Palette := 3;
  end;

  RunExplorer('Functional Pascal Tricorn', Initial, Draw, Label)
end.
