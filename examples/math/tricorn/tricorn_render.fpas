// Built only via tricorn.fpasprj — not a standalone program.

unit Tricorn.Render;

uses Std.Console, Std.Tasks, Std.Conv, Std.Math, Tricorn.Color;

type Complex = record
  public Re: real;
  public Im: real;

  public static function Zero(): Complex;
  begin
    return record
      Re := 0.0;
      Im := 0.0;
    end;
  end function;

  public static function Create(Re: real; Im: real): Complex;
  begin
    return record
      Re := Re;
      Im := Im;
    end;
  end function;

  public function Conj(Self: Complex): Complex;
  begin
    return record
      Re := Self.Re;
      Im := - Self.Im;
    end;
  end function;

  public function Sq(Self: Complex): Complex;
  begin
    return record
      Re := Self.Re * Self.Re - Self.Im * Self.Im;
      Im := (2.0 * Self.Re) * Self.Im;
    end;
  end function;

  public function Add(Self: Complex; Other: Complex): Complex;
  begin
    return record
      Re := Self.Re + Other.Re;
      Im := Self.Im + Other.Im;
    end;
  end function;

  public function MagSq(Self: Complex): real;
  begin
    return Self.Re * Self.Re + Self.Im * Self.Im;
  end function;
end record;

type PixelSample = record
  public IsInside: boolean;
  public EscapeValue: real;
end record;

function Iterate(C: Complex; MaxIter: integer): PixelSample;
begin
  const EscapeRadiusSq: real := 256.0;
  var Z: Complex := Complex.Zero();
  var N: integer := 0;
  while (N < MaxIter) and (Z.MagSq() <= EscapeRadiusSq) do
    begin
      Z := Z.Conj().Sq().Add(C);
      N := N + 1;
    end;
  end while;

  if N >= MaxIter then
    begin
      return record
        IsInside := true;
        EscapeValue := 0.0;
      end;
    end;
  end if;
  const MagnitudeSq: real := Max(Z.MagSq(), 4.0);
  const Smooth: real := (IntToReal(N) + 1.0) - (Log(Log(MagnitudeSq) * 0.5) / Log(2.0));
  return record
    IsInside := false;
    EscapeValue := Smooth;
  end;
end function;

function ComputeRow(
  Py: integer;
  Width: integer;
  Height: integer;
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  MaxIter: integer
): array of PixelSample;
begin
  var WidthRange: integer := Width - 1;
  var HeightRange: integer := Height - 1;
  if WidthRange < 1 then
    begin
      WidthRange := 1;
    end;
  end if;

  if HeightRange < 1 then
    begin
      HeightRange := 1;
    end;
  end if;
  const Wr: real := IntToReal(WidthRange);
  const Hr: real := IntToReal(HeightRange);
  const cy: real := YMax - (Py / Hr) * (YMax - YMin);
  var Row: array of PixelSample := [];
  for Px: integer := 0 to Width - 1 do
    begin
      const cx: real := XMin + (Px / Wr) * (XMax - XMin);
      Row.Push(Iterate(Complex.Create(cx, cy), MaxIter));
    end;
  end for;

  return Row;
end function;

function EscapeGlyph(EscapeValue: real): string;
begin
  const Ramp: string := ' ░▒▓█';
  const Count: integer := Ramp.Length();
  const Phase: real := Frac(EscapeValue * 0.08);
  const Index: integer := Clamp(Trunc(Phase * IntToReal(Count)), 0, Count - 1);
  return Ramp.CharAt(Index);
end function;

function RenderCell(Sample: PixelSample; Palette: PaletteKind): Cell;
begin
  if Sample.IsInside then
    begin
      const CellShade: Color := InsideColor();
      return record
        glyph := ' ';
        foreground := CellShade;
        background := CellShade;
      end;
    end;
  end if;

  return record
    glyph := EscapeGlyph(Sample.EscapeValue);
    foreground := EscapeColor(Palette, Sample.EscapeValue);
    background := RgbColor(0, 0, 0);
  end;
end function;

procedure DrawRow(Row: array of PixelSample; Width: integer; Y: integer; Palette: PaletteKind);
begin
  const CurrentWidth: integer := ScreenWidth();
  var DrawWidth: integer := Width;
  if DrawWidth > CurrentWidth then
    begin
      DrawWidth := CurrentWidth;
    end;
  end if;

  if DrawWidth < 1 then
    begin
      return;
    end;
  end if;
  var Cells: array of Cell := [];
  for Px: integer := 0 to DrawWidth - 1 do
    begin
      Cells.Push(RenderCell(Row[Px], Palette));
    end;
  end for;

  WriteCells(1, Y, Cells);
end procedure;

public procedure Render(
  XMin: real;
  XMax: real;
  YMin: real;
  YMax: real;
  Width: integer;
  Height: integer;
  MaxIter: integer;
  Palette: PaletteKind
);
begin
  var Tasks: array of task := [];
  for Py: integer := 0 to Height - 1 do
    begin
      Tasks.Push(go ComputeRow(Py, Width, Height, XMin, XMax, YMin, YMax, MaxIter));
    end;
  end for;

  for Py: integer := 0 to Height - 1 do
    begin
      const Row: array of PixelSample := Wait(Tasks[Py]);
      if (Py + 1) <= Max(ScreenHeight() - 2, 1) then
        begin
          DrawRow(Row, Width, Py + 1, Palette);
        end;
      end if;
    end;
  end for;
end procedure;
end unit;
