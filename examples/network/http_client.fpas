// Sends buffered and streaming HTTP requests to the local example server.
program NetworkHttpClient;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Console as Console;
uses Std.Http as Http;
uses Std.Net.Utf8 as Utf8;

// Prints one buffered response after validating its UTF-8 body.
//
// Parameters:
// - `LabelText`: Short operation label written before the response.
// - `ResponseValue`: Buffered HTTP response to display.
procedure PrintBuffered(LabelText: string; ResponseValue: Http.Response);
begin
  case Http.BodyText(ResponseValue) of
    when Result.Ok(const Text):
      begin
        Console.WriteLn((((LabelText + ' ') + Conv.IntToStr(ResponseValue.StatusCode)) + ': ') +
                        Text);
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end procedure;

// Sends one buffered request and prints its response.
//
// Parameters:
// - `LabelText`: Short operation label written before the response.
// - `RequestValue`: Complete request to send.
procedure RunBuffered(LabelText: string; RequestValue: Http.Request);
begin
  case Http.Send(RequestValue) of
    when Result.Ok(const ResponseValue):
      begin
        PrintBuffered(LabelText, ResponseValue);
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end procedure;

// Reads an entire bounded response stream and validates its UTF-8 body.
//
// Parameters:
// - `StreamValue`: Open HTTP response-body stream.
function ReadAll(StreamValue: Http.BodyStream): string;
begin
  mutable var Bytes: array of (integer) := [];
  mutable var Reading: boolean := true;
  while Reading do
    begin
      case Http.ReadStream(StreamValue, 5) of
        when Result.Ok(const Part):
          begin
            if Arrays.Length(Part) = 0 then
              begin
                Reading := false;
              end;
            else
              begin
                Bytes := Arrays.Concat(Bytes, Part);
              end;
            end if;
          end;
        when Result.Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;

  case Utf8.Decode(Bytes) of
    when Result.Ok(const Text):
      begin
        return Text;
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end function;

begin
  mutable var Port: integer := 18080;
  if Args.ParamCount() = 1 then
    begin
      Port := Conv.StrToInt(Args.ParamStr(0));
    end;
  else
    if Args.ParamCount() <> 0 then
      begin
        panic('usage: http_client.fpas -- [PORT]');
      end;
    end if;
  end if;
  var BaseUrl: string := 'http://127.0.0.1:' + Conv.IntToStr(Port);
  RunBuffered('GET', Http.Request.Get(BaseUrl + '/hello'));
  mutable var PostRequest: Http.Request := Http.Request.Post(BaseUrl + '/echo');
  PostRequest.Headers := [Http.Header.Create('Content-Type', 'text/plain; charset=utf-8')];
  PostRequest.Body := Utf8.Encode('hello from client');
  RunBuffered('POST', PostRequest);
  case Http.OpenStream(Http.Request.Get(BaseUrl + '/stream')) of
    when Result.Ok(const ResponseValue):
      begin
        Console.WriteLn((('STREAM ' + Conv.IntToStr(ResponseValue.StatusCode)) + ': ') +
                        ReadAll(ResponseValue.Body));
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end program;
