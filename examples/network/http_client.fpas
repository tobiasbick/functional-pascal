// Sends buffered and streaming HTTP requests to the local example server.
program NetworkHttpClient;

uses Std.Args, Std.Conv, Std.Console, Std.Http, Std.Net.Utf8;

// Prints one buffered response after validating its UTF-8 body.
//
// Parameters:
// - `LabelText`: Short operation label written before the response.
// - `ResponseValue`: Buffered HTTP response to display.
procedure PrintBuffered(LabelText: string; ResponseValue: Response);
begin
  case BodyText(ResponseValue) of
    when Ok(const Text):
      begin
        WriteLn(LabelText + ' ' + IntToStr(ResponseValue.StatusCode) + ': ' + Text);
      end;
    when Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end procedure;

// Sends one buffered request and prints its response.
//
// Parameters:
// - `LabelText`: Short operation label written before the response.
// - `RequestValue`: Complete request to send.
procedure RunBuffered(LabelText: string; RequestValue: Request);
begin
  case Send(RequestValue) of
    when Ok(const ResponseValue):
      begin
        PrintBuffered(LabelText, ResponseValue);
      end;
    when Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end procedure;

// Reads an entire bounded response stream and validates its UTF-8 body.
//
// Parameters:
// - `StreamValue`: Open HTTP response-body stream.
function ReadAll(StreamValue: BodyStream): string;
begin
  var Bytes: array of integer := [];
  var Reading: boolean := true;
  while Reading do
    begin
      case ReadStream(StreamValue, 5) of
        when Ok(const Part):
          begin
            if Part.Length() = 0 then
              begin
                Reading := false;
              end;
            else
              begin
                Bytes := Bytes.Concat(Part);
              end;
            end if;
          end;
        when Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;

  case Std.Net.Utf8.Decode(Bytes) of
    when Ok(const Text):
      begin
        return Text;
      end;
    when Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end function;

begin
  var Port: integer := 18080;
  if ParamCount() = 1 then
    begin
      Port := StrToInt(ParamStr(0));
    end;
  elsif ParamCount() <> 0 then
    begin
      panic('usage: http_client.fpas -- [PORT]');
    end;
  end if;
  const BaseUrl: string := 'http://127.0.0.1:' + IntToStr(Port);
  RunBuffered('GET', Request.Get(BaseUrl + '/hello'));
  var PostRequest: Request := Request.Post(BaseUrl + '/echo');
  PostRequest.Headers := [Header.Create('Content-Type', 'text/plain; charset=utf-8')];
  PostRequest.Body := Std.Net.Utf8.Encode('hello from client');
  RunBuffered('POST', PostRequest);
  case OpenStream(Request.Get(BaseUrl + '/stream')) of
    when Ok(const ResponseValue):
      begin
        WriteLn('STREAM ' + IntToStr(ResponseValue.StatusCode) + ': ' + ReadAll(ResponseValue.Body));
      end;
    when Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end.
