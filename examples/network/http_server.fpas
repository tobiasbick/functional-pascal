// Serves three local HTTP requests and then exits.
program NetworkHttpServer;

uses Std.Args, Std.Conv, Std.Console, Std.Http, Std.Net, Std.Net.Utf8;

// Creates a UTF-8 text response with one content-type field.
//
// Parameters:
// - `StatusCode`: HTTP status code to return.
// - `ReasonPhrase`: HTTP reason phrase to return.
// - `Text`: UTF-8 response body.
function TextResponse(StatusCode: integer; ReasonPhrase: string; Text: string): ServerResponse;
begin
  var ResponseValue: ServerResponse := ServerResponse.Create(StatusCode, ReasonPhrase);
  ResponseValue.Headers := [Header.Create('Content-Type', 'text/plain; charset=utf-8')];
  ResponseValue.Body := Std.Net.Utf8.Encode(Text);
  return ResponseValue;
end function;

// Routes the three requests issued by `http_client.fpas`.
//
// Parameters:
// - `RequestValue`: Validated request accepted by the server loop.
function Handle(RequestValue: ServerRequest): ServerResponse;
begin
  if (RequestValue.Method = 'GET') and (RequestValue.Target = '/hello') then
    begin
      return TextResponse(200, 'OK', 'Hello from FPAS');
    end;
  end if;

  if (RequestValue.Method = 'POST') and (RequestValue.Target = '/echo') then
    begin
      case Std.Net.Utf8.Decode(RequestValue.Body) of
        when Ok(Text):
          begin
            return TextResponse(200, 'OK', 'Echo: ' + Text);
          end;
        when Error(Message):
          begin
            return TextResponse(400, 'Bad Request', Message);
          end;
      end case;
    end;
  end if;

  if (RequestValue.Method = 'GET') and (RequestValue.Target = '/stream') then
    begin
      return TextResponse(200, 'OK', 'streamed in small reads');
    end;
  end if;

  return TextResponse(404, 'Not Found', 'No route for ' + RequestValue.Target);
end function;

begin
  var Port: integer := 18080;
  if ParamCount() = 1 then
    begin
      Port := StrToInt(ParamStr(0));
    end;
  elsif ParamCount() <> 0 then
    begin
      panic('usage: http_server.fpas -- [PORT]');
    end;
  end if;

  case Listen('127.0.0.1', Port) of
    when Ok(ListenerValue):
      begin
        WriteLn('HTTP server listening on http://127.0.0.1:' + IntToStr(Port));
        var Options: ServerOptions := ServerOptions.Create();
        Options.MaxConcurrentRequests := 1;
        Options.MaxRequests := 3;
        case Serve(ListenerValue, Options, Handle) of
          when Ok(_):
            begin
              WriteLn('HTTP server handled 3 requests');
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case CloseListener(ListenerValue) of
          when Ok(_):
            begin
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;
end.
