// Serves three local HTTP requests and then exits.
program NetworkHttpServer;

uses Std.Args as Args;
uses Std.Conv as Conv;
uses Std.Console as Console;
uses Std.Http as Http;
uses Std.Net as Net;
uses Std.Net.Utf8 as Utf8;

// Creates a UTF-8 text response with one content-type field.
//
// Parameters:
// - `StatusCode`: HTTP status code to return.
// - `ReasonPhrase`: HTTP reason phrase to return.
// - `Text`: UTF-8 response body.
function TextResponse(StatusCode: integer; ReasonPhrase: string; Text: string): Http.ServerResponse;
begin
  mutable var ResponseValue: Http.ServerResponse := Http.ServerResponse.Create(StatusCode, ReasonPhrase);
  ResponseValue.Headers := [Http.Header.Create('Content-Type', 'text/plain; charset=utf-8')];
  ResponseValue.Body := Utf8.Encode(Text);
  return ResponseValue;
end function;

// Routes the three requests issued by `http_client.fpas`.
//
// Parameters:
// - `RequestValue`: Validated request accepted by the server loop.
function Handle(RequestValue: Http.ServerRequest): Http.ServerResponse;
begin
  if (RequestValue.Method = 'GET') and (RequestValue.Target = '/hello') then
    begin
      return TextResponse(200, 'OK', 'Hello from FPAS');
    end;
  end if;

  if (RequestValue.Method = 'POST') and (RequestValue.Target = '/echo') then
    begin
      case Utf8.Decode(RequestValue.Body) of
        when Ok(Text):
          begin
            return TextResponse(200, 'OK', 'Echo: ' + Text);
          end;
        when Error(Message):
          begin
            return TextResponse(400, 'Bad Request', Message);
          end;
      end case;
    end;
  end if;

  if (RequestValue.Method = 'GET') and (RequestValue.Target = '/stream') then
    begin
      return TextResponse(200, 'OK', 'streamed in small reads');
    end;
  end if;

  return TextResponse(404, 'Not Found', 'No route for ' + RequestValue.Target);
end function;

begin
  mutable var Port: integer := 18080;
  if Args.ParamCount() = 1 then
    begin
      Port := Conv.StrToInt(Args.ParamStr(0));
    end;
  else
    if Args.ParamCount() <> 0 then
      begin
        panic('usage: http_server.fpas -- [PORT]');
      end;
    end if;
  end if;

  case Net.Listen('127.0.0.1', Port) of
    when Ok(ListenerValue):
      begin
        Console.WriteLn('HTTP server listening on http://127.0.0.1:' + Conv.IntToStr(Port));
        mutable var Options: Http.ServerOptions := Http.ServerOptions.Create();
        Options.MaxConcurrentRequests := 1;
        Options.MaxRequests := 3;
        case Http.Serve(ListenerValue, Options, Handle) of
          when Ok(_):
            begin
              Console.WriteLn('HTTP server handled 3 requests');
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case Net.CloseListener(ListenerValue) of
          when Ok(_):
            begin
              null;
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;
end program;
