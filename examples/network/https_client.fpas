// Fetches one HTTPS URL with operating-system certificate verification.
program NetworkHttpsClient;

uses Std.Args as Args, Std.Conv as Conv, Std.Console as Console, Std.Http as Http;

begin
  if Args.ParamCount() <> 1 then
    begin
      panic('usage: https_client.fpas -- URL');
    end;
  end if;

  case Http.Send(Http.Request.Get(Args.ParamStr(0))) of
    when Ok(const ResponseValue):
      begin
        Console.WriteLn('HTTPS status: ' + Conv.IntToStr(ResponseValue.StatusCode));
        case Http.BodyText(ResponseValue) of
          when Ok(const Text):
            begin
              Console.WriteLn(Text);
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;
      end;
    when Error(const Message):
      begin
        panic(Message.Message());
      end;
  end case;
end.
