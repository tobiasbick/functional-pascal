// Fetches one HTTPS URL with operating-system certificate verification.
program NetworkHttpsClient;

uses Std.Args, Std.Conv, Std.Console, Std.Http;

begin
  if ParamCount() <> 1 then
    begin
      panic('usage: https_client.fpas -- URL');
    end;
  end if;

  case Send(Request.Get(ParamStr(0))) of
    when Ok(const ResponseValue):
      begin
        WriteLn('HTTPS status: ' + IntToStr(ResponseValue.StatusCode));
        case BodyText(ResponseValue) of
          when Ok(const Text):
            begin
              WriteLn(Text);
            end;
          when Error(const Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end.
