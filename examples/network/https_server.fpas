// Serves one HTTPS response using caller-supplied PEM credentials.
program NetworkHttpsServer;

uses Std.Args as Args;
uses Std.Conv as Conv;
uses Std.Console as Console;
uses Std.Http as Http;
uses Std.Net as Net;
uses Std.Net.Utf8 as Utf8;

// Creates the single response returned by this bounded demo server.
//
// Parameters:
// - `_RequestValue`: Validated request accepted over TLS.
function Handle(_RequestValue: Http.ServerRequest): Http.ServerResponse;
begin
  var ResponseValue: Http.ServerResponse := Http.ServerResponseCreate(200, 'OK');
  ResponseValue.Headers := [Http.HeaderCreate('Content-Type', 'text/plain; charset=utf-8')];
  ResponseValue.Body := Utf8.Encode('Hello over HTTPS from FPAS');
  return ResponseValue;
end function;

begin
  if (Args.ParamCount() < 2) or (Args.ParamCount() > 3) then
    begin
      panic('usage: https_server.fpas -- CERTIFICATE_PEM PRIVATE_KEY_PEM [PORT]');
    end;
  end if;
  var Port: integer := 18443;
  if Args.ParamCount() = 3 then
    begin
      Port := Conv.StrToInt(Args.ParamStr(2));
    end;
  end if;

  case Net.ListenTls('127.0.0.1', Port, Args.ParamStr(0), Args.ParamStr(1), 10000) of
    when Result.Ok(const ListenerValue):
      begin
        Console.WriteLn('HTTPS server listening on https://127.0.0.1:' + Conv.IntToStr(Port));
        var Options: Http.ServerOptions := Http.ServerOptionsCreate();
        Options.MaxConcurrentRequests := 1;
        Options.MaxRequests := 1;
        case Http.Serve(ListenerValue, Options, Handle) of
          when Result.Ok(_):
            begin
              null;
            end;
          when Result.Error(const Message):
            begin
              panic(Message);
            end;
        end case;

        case Net.CloseListener(ListenerValue) of
          when Result.Ok(_):
            begin
              Console.WriteLn('HTTPS server handled 1 request');
            end;
          when Result.Error(const Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end program;
