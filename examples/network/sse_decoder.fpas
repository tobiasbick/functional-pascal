// Decodes one Server-Sent InputEvent split across arbitrary byte fragments.
program NetworkSseDecoder;

uses Std.Console, Std.Http, Std.Net.Utf8;

// Prints all complete events returned by one decoder operation.
//
// Parameters:
// - `Events`: Complete SSE events to display.
procedure PrintEvents(Events: array of SseEvent);
begin
  for Index: integer := 0 to Events.Length() - 1 do
    begin
      WriteLn('event: ' + Events[Index].EventType);
      WriteLn('id: ' + Events[Index].Id);
      WriteLn('data: ' + Events[Index].Data);
    end;
  end for;
end procedure;

begin
  case CreateSseDecoder(1024) of
    when Ok(const Decoder):
      begin
        case FeedSse(Decoder, Std.Net.Utf8.Encode(((('id: 42' + #10) + 'event: greeting') + #10) +
                                                  'data: hel')) of
          when Ok(const Events):
            begin
              PrintEvents(Events);
            end;
          when Error(const Message):
            begin
              panic(Message);
            end;
        end case;

        case FeedSse(Decoder, Std.Net.Utf8.Encode(('lo from FPAS' + #10) + #10)) of
          when Ok(const Events):
            begin
              PrintEvents(Events);
            end;
          when Error(const Message):
            begin
              panic(Message);
            end;
        end case;

        case FinishSse(Decoder) of
          when Ok(const Events):
            begin
              PrintEvents(Events);
            end;
          when Error(const Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end.
