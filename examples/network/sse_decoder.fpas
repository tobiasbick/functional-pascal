// Decodes one Server-Sent InputEvent split across arbitrary byte fragments.
program NetworkSseDecoder;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Http as Http;
uses Std.Net.Utf8 as Utf8;

// Prints all complete events returned by one decoder operation.
//
// Parameters:
// - `Events`: Complete SSE events to display.
procedure PrintEvents(Events: array of Http.SseEvent);
begin
  for Index: integer := 0 to Arrays.Length(Events) - 1 do
    begin
      Console.WriteLn('event: ' + Events[Index].EventType);
      Console.WriteLn('id: ' + Events[Index].Id);
      Console.WriteLn('data: ' + Events[Index].Data);
    end;
  end for;
end procedure;

begin
  case Http.CreateSseDecoder(1024) of
    when Ok(Decoder):
      begin
        case Http.FeedSse(Decoder, Utf8.Encode(((('id: 42' + #10) + 'event: greeting') + #10) +
                                               'data: hel')) of
          when Ok(Events):
            begin
              PrintEvents(Events);
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case Http.FeedSse(Decoder, Utf8.Encode(('lo from FPAS' + #10) + #10)) of
          when Ok(Events):
            begin
              PrintEvents(Events);
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case Http.FinishSse(Decoder) of
          when Ok(Events):
            begin
              PrintEvents(Events);
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;
end program;
