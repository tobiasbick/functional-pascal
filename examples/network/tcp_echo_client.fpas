// Sends one LF-delimited TCP request to the local echo server.
program NetworkTcpEchoClient;

uses
  Std.Args as Args, Std.Conv as Conv, Std.Console as Console, Std.Net as Net, Std.Net.Utf8 as Utf8,
  Std.Parse as Parse;

// Writes every byte even when the transport reports a partial write.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
// - `Bytes`: Complete byte sequence to write.
procedure WriteAll(ConnectionValue: Net.Connection; Bytes: array of integer);
begin
  var Offset: integer := 0;
  while Offset < Bytes.Length() do
    begin
      const Remaining: array of integer := Bytes.Slice(Offset, Bytes.Length() - Offset);
      case Net.SendBytes(ConnectionValue, Remaining) of
        when Ok(const Count):
          begin
            if Count <= 0 then
              begin
                panic('TCP connection stopped while writing');
              end;
            end if;

            Offset := Offset + Count;
          end;
        when Error(const Message):
          begin
            panic(Message.Message());
          end;
      end case;
    end;
  end while;
end procedure;

// Reads response fragments until the server closes its side of the connection.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
function ReadToEnd(ConnectionValue: Net.Connection): string;
begin
  var Bytes: array of integer := [];
  var Reading: boolean := true;
  while Reading do
    begin
      case Net.ReceiveBytes(ConnectionValue, 4096) of
        when Ok(const Part):
          begin
            if Part.Length() = 0 then
              begin
                Reading := false;
              end;
            else
              begin
                Bytes := Bytes.Concat(Part);
              end;
            end if;
          end;
        when Error(const Message):
          begin
            panic(Message.Message());
          end;
      end case;
    end;
  end while;

  case Utf8.Decode(Bytes) of
    when Ok(const Text):
      begin
        return Text;
      end;
    when Error(const Message):
      begin
        panic(Message.Message());
      end;
  end case;
end function;

begin
  var Port: integer := 18081;
  if Args.ParamCount() = 1 then
    begin
      Port := Parse.Int(Args.ParamStr(0)).Unwrap();
    end;
  elsif Args.ParamCount() <> 0 then
    begin
      panic('usage: tcp_echo_client.fpas -- [PORT]');
    end;
  end if;

  case Net.Connect('127.0.0.1', Port, 5000) of
    when Ok(const ConnectionValue):
      begin
        case Net.SetTimeout(ConnectionValue, 5000) of
          when Ok(_):
            begin
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;

        WriteAll(ConnectionValue, Utf8.Encode('hello over TCP' + #10));
        Console.WriteLn(ReadToEnd(ConnectionValue));
        case Net.Close(ConnectionValue) of
          when Ok(_):
            begin
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;
      end;
    when Error(const Message):
      begin
        panic(Message.Message());
      end;
  end case;
end.
