// Sends one LF-delimited TCP request to the local echo server.
program NetworkTcpEchoClient;

uses Std.Args, Std.Arrays, Std.Conv, Std.Console, Std.Net, Std.Net.Utf8;

// Writes every byte even when the transport reports a partial write.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
// - `Bytes`: Complete byte sequence to write.
procedure WriteAll(ConnectionValue: Connection; Bytes: array of integer);
begin
  var Offset: integer := 0;
  while Offset < Std.Arrays.Length(Bytes) do
    begin
      const Remaining: array of integer := Std.Arrays.Slice(Bytes, Offset, Std.Arrays.Length(Bytes) -
                                                                           Offset);
      case Std.Net.SendBytes(ConnectionValue, Remaining) of
        when Ok(Count):
          begin
            if Count <= 0 then
              begin
                panic('TCP connection stopped while writing');
              end;
            end if;

            Offset := Offset + Count;
          end;
        when Error(Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;
end procedure;

// Reads response fragments until the server closes its side of the connection.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
function ReadToEnd(ConnectionValue: Connection): string;
begin
  var Bytes: array of integer := [];
  var Reading: boolean := true;
  while Reading do
    begin
      case Std.Net.ReceiveBytes(ConnectionValue, 4096) of
        when Ok(Part):
          begin
            if Std.Arrays.Length(Part) = 0 then
              begin
                Reading := false;
              end;
            else
              begin
                Bytes := Std.Arrays.Concat(Bytes, Part);
              end;
            end if;
          end;
        when Error(Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;

  case Std.Net.Utf8.Decode(Bytes) of
    when Ok(Text):
      begin
        return Text;
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;
end function;

begin
  var Port: integer := 18081;
  if ParamCount() = 1 then
    begin
      Port := StrToInt(ParamStr(0));
    end;
  elsif ParamCount() <> 0 then
    begin
      panic('usage: tcp_echo_client.fpas -- [PORT]');
    end;
  end if;

  case Connect('127.0.0.1', Port, 5000) of
    when Ok(ConnectionValue):
      begin
        case SetTimeout(ConnectionValue, 5000) of
          when Ok(_):
            begin
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        WriteAll(ConnectionValue, Std.Net.Utf8.Encode('hello over TCP' + #10));
        WriteLn(ReadToEnd(ConnectionValue));
        case Close(ConnectionValue) of
          when Ok(_):
            begin
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;
end.
