// Sends one LF-delimited TCP request to the local echo server.
program NetworkTcpEchoClient;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Console as Console;
uses Std.Net as Net;
uses Std.Net.Utf8 as Utf8;

// Writes every byte even when the transport reports a partial write.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
// - `Bytes`: Complete byte sequence to write.
procedure WriteAll(ConnectionValue: Net.Connection; Bytes: array of (integer));
begin
  var Offset: integer := 0;
  while Offset < Arrays.Length(Bytes) do
    begin
      const Remaining: array of (integer) := Arrays.Slice(Bytes, Offset, Arrays.Length(Bytes) -
                                                                         Offset);
      case Net.SendBytes(ConnectionValue, Remaining) of
        when Result.Ok(const Count):
          begin
            if Count <= 0 then
              begin
                panic('TCP connection stopped while writing');
              end;
            end if;

            Offset := Offset + Count;
          end;
        when Result.Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;
end procedure;

// Reads response fragments until the server closes its side of the connection.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
function ReadToEnd(ConnectionValue: Net.Connection): string;
begin
  var Bytes: array of (integer) := [];
  var Reading: boolean := true;
  while Reading do
    begin
      case Net.ReceiveBytes(ConnectionValue, 4096) of
        when Result.Ok(const Part):
          begin
            if Arrays.Length(Part) = 0 then
              begin
                Reading := false;
              end;
            else
              begin
                Bytes := Arrays.Concat(Bytes, Part);
              end;
            end if;
          end;
        when Result.Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;

  case Utf8.Decode(Bytes) of
    when Result.Ok(const Text):
      begin
        return Text;
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end function;

begin
  var Port: integer := 18081;
  if Args.ParamCount() = 1 then
    begin
      Port := Conv.StrToInt(Args.ParamStr(0));
    end;
  else
    if Args.ParamCount() <> 0 then
      begin
        panic('usage: tcp_echo_client.fpas -- [PORT]');
      end;
    end if;
  end if;

  case Net.Connect('127.0.0.1', Port, 5000) of
    when Result.Ok(const ConnectionValue):
      begin
        case Net.SetTimeout(ConnectionValue, 5000) of
          when Result.Ok(_):
            begin
              null;
            end;
          when Result.Error(const Message):
            begin
              panic(Message);
            end;
        end case;

        WriteAll(ConnectionValue, Utf8.Encode('hello over TCP' + #10));
        Console.WriteLn(ReadToEnd(ConnectionValue));
        case Net.Close(ConnectionValue) of
          when Result.Ok(_):
            begin
              null;
            end;
          when Result.Error(const Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end program;
