// Accepts one LF-delimited TCP request, echoes it, and exits.
program NetworkTcpEchoServer;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Console as Console;
uses Std.Net as Net;
uses Std.Net.Utf8 as Utf8;

// Returns the first LF delimiter index or minus one.
//
// Parameters:
// - `Bytes`: Network bytes to inspect.
function LineFeedIndex(Bytes: array of (integer)): integer;
begin
  for Index: integer := 0 to Arrays.Length(Bytes) - 1 do
    begin
      if Bytes[Index] = 10 then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Reads byte fragments until the client sends an LF delimiter.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
function ReadLine(ConnectionValue: Net.Connection): string;
begin
  mutable var Bytes: array of (integer) := [];
  mutable var LineEnd: integer := -1;
  while LineEnd < 0 do
    begin
      case Net.ReceiveBytes(ConnectionValue, 4096) of
        when Result.Ok(const Part):
          begin
            if Arrays.Length(Part) = 0 then
              begin
                panic('TCP connection closed before the LF delimiter');
              end;
            end if;

            Bytes := Arrays.Concat(Bytes, Part);
            LineEnd := LineFeedIndex(Bytes);
          end;
        when Result.Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;

  if LineEnd + 1 <> Arrays.Length(Bytes) then
    begin
      panic('TCP echo server accepts exactly one LF-delimited request per connection');
    end;
  end if;
  var TextBytes: array of (integer) := Arrays.Slice(Bytes, 0, LineEnd);
  case Utf8.Decode(TextBytes) of
    when Result.Ok(const Text):
      begin
        return Text;
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end function;

// Writes every byte even when the transport reports a partial write.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
// - `Bytes`: Complete byte sequence to write.
procedure WriteAll(ConnectionValue: Net.Connection; Bytes: array of (integer));
begin
  mutable var Offset: integer := 0;
  while Offset < Arrays.Length(Bytes) do
    begin
      var Remaining: array of (integer) := Arrays.Slice(Bytes, Offset, Arrays.Length(Bytes) - Offset);
      case Net.SendBytes(ConnectionValue, Remaining) of
        when Result.Ok(const Count):
          begin
            if Count <= 0 then
              begin
                panic('TCP connection stopped while writing');
              end;
            end if;

            Offset := Offset + Count;
          end;
        when Result.Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;
end procedure;

begin
  mutable var Port: integer := 18081;
  if Args.ParamCount() = 1 then
    begin
      Port := Conv.StrToInt(Args.ParamStr(0));
    end;
  else
    if Args.ParamCount() <> 0 then
      begin
        panic('usage: tcp_echo_server.fpas -- [PORT]');
      end;
    end if;
  end if;

  case Net.Listen('127.0.0.1', Port) of
    when Result.Ok(const ListenerValue):
      begin
        Console.WriteLn('TCP echo server listening on 127.0.0.1:' + Conv.IntToStr(Port));
        case Net.Accept(ListenerValue) of
          when Result.Ok(const ConnectionValue):
            begin
              case Net.SetTimeout(ConnectionValue, 5000) of
                when Result.Ok(_):
                  begin
                    null;
                  end;
                when Result.Error(const Message):
                  begin
                    panic(Message);
                  end;
              end case;
              var Text: string := ReadLine(ConnectionValue);
              WriteAll(ConnectionValue, Utf8.Encode('Echo: ' + Text));
              case Net.Close(ConnectionValue) of
                when Result.Ok(_):
                  begin
                    null;
                  end;
                when Result.Error(const Message):
                  begin
                    panic(Message);
                  end;
              end case;
            end;
          when Result.Error(const Message):
            begin
              panic(Message);
            end;
        end case;

        case Net.CloseListener(ListenerValue) of
          when Result.Ok(_):
            begin
              Console.WriteLn('TCP echo server stopped');
            end;
          when Result.Error(const Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end program;
