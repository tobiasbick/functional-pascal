// Accepts one LF-delimited TCP request, echoes it, and exits.
program NetworkTcpEchoServer;

uses Std.Args, Std.Conv, Std.Console, Std.Net, Std.Net.Utf8;

// Returns the first LF delimiter index or minus one.
//
// Parameters:
// - `Bytes`: Network bytes to inspect.
function LineFeedIndex(Bytes: array of integer): integer;
begin
  for Index: integer := 0 to Bytes.Length() - 1 do
    begin
      if Bytes[Index] = 10 then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Reads byte fragments until the client sends an LF delimiter.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
function ReadLine(ConnectionValue: Connection): string;
begin
  var Bytes: array of integer := [];
  var LineEnd: integer := -1;
  while LineEnd < 0 do
    begin
      case Std.Net.ReceiveBytes(ConnectionValue, 4096) of
        when Ok(const Part):
          begin
            if Part.Length() = 0 then
              begin
                panic('TCP connection closed before the LF delimiter');
              end;
            end if;

            Bytes := Bytes.Concat(Part);
            LineEnd := LineFeedIndex(Bytes);
          end;
        when Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;

  if LineEnd + 1 <> Bytes.Length() then
    begin
      panic('TCP echo server accepts exactly one LF-delimited request per connection');
    end;
  end if;
  const TextBytes: array of integer := Bytes.Slice(0, LineEnd);
  case Std.Net.Utf8.Decode(TextBytes) of
    when Ok(const Text):
      begin
        return Text;
      end;
    when Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end function;

// Writes every byte even when the transport reports a partial write.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
// - `Bytes`: Complete byte sequence to write.
procedure WriteAll(ConnectionValue: Connection; Bytes: array of integer);
begin
  var Offset: integer := 0;
  while Offset < Bytes.Length() do
    begin
      const Remaining: array of integer := Bytes.Slice(Offset, Bytes.Length() - Offset);
      case Std.Net.SendBytes(ConnectionValue, Remaining) of
        when Ok(const Count):
          begin
            if Count <= 0 then
              begin
                panic('TCP connection stopped while writing');
              end;
            end if;

            Offset := Offset + Count;
          end;
        when Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end while;
end procedure;

begin
  var Port: integer := 18081;
  if ParamCount() = 1 then
    begin
      Port := StrToInt(ParamStr(0));
    end;
  elsif ParamCount() <> 0 then
    begin
      panic('usage: tcp_echo_server.fpas -- [PORT]');
    end;
  end if;

  case Listen('127.0.0.1', Port) of
    when Ok(const ListenerValue):
      begin
        WriteLn('TCP echo server listening on 127.0.0.1:' + IntToStr(Port));
        case Accept(ListenerValue) of
          when Ok(const ConnectionValue):
            begin
              case SetTimeout(ConnectionValue, 5000) of
                when Ok(_):
                  begin
                  end;
                when Error(const Message):
                  begin
                    panic(Message);
                  end;
              end case;
              const Text: string := ReadLine(ConnectionValue);
              WriteAll(ConnectionValue, Std.Net.Utf8.Encode('Echo: ' + Text));
              case Close(ConnectionValue) of
                when Ok(_):
                  begin
                  end;
                when Error(const Message):
                  begin
                    panic(Message);
                  end;
              end case;
            end;
          when Error(const Message):
            begin
              panic(Message);
            end;
        end case;

        case CloseListener(ListenerValue) of
          when Ok(_):
            begin
              WriteLn('TCP echo server stopped');
            end;
          when Error(const Message):
            begin
              panic(Message);
            end;
        end case;
      end;
    when Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end.
