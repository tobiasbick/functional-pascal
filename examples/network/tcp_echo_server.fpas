// Accepts one LF-delimited TCP request, echoes it, and exits.
program NetworkTcpEchoServer;

uses
  Std.Bytes as ByteStorage,
  Std.Os.Args as Args, Std.Text.Format as Conv, Std.Console as Console, Std.Net.Sockets as Net, Std.Text.Utf8 as Utf8,
  Std.Text.Parse as Parse;

// Returns the first LF delimiter index or minus one.
//
// Parameters:
// - `Bytes`: Network bytes to inspect.
function LineFeedIndex(Bytes: ByteStorage.ByteBuffer): integer;
begin
  for Index: integer := 0 to Bytes.Length() - 1 do
    begin
      if Bytes[Index] = 10 then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Reads byte fragments until the client sends an LF delimiter.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
function ReadLine(ConnectionValue: Net.Connection): string;
begin
  var Bytes: ByteStorage.ByteBuffer := ByteStorage.Create(0).Unwrap();
  var LineEnd: integer := -1;
  while LineEnd < 0 do
    begin
      case Net.ReceiveBytes(ConnectionValue, 4096) of
        when Ok(const Part):
          begin
            if Part.Length() = 0 then
              begin
                panic('TCP connection closed before the LF delimiter');
              end;
            end if;

            discard Bytes.ConcatInPlace(Part).Unwrap();
            LineEnd := LineFeedIndex(Bytes);
          end;
        when Error(const Message):
          begin
            panic(Message.Message());
          end;
      end case;
    end;
  end while;

  if LineEnd + 1 <> Bytes.Length() then
    begin
      panic('TCP echo server accepts exactly one LF-delimited request per connection');
    end;
  end if;
  const TextBytes := Bytes.Slice(0, LineEnd).Unwrap();
  case Utf8.Decode(TextBytes) of
    when Ok(const Text):
      begin
        return Text;
      end;
    when Error(const Message):
      begin
        panic(Message.Message());
      end;
  end case;
end function;

// Writes every byte even when the transport reports a partial write.
//
// Parameters:
// - `ConnectionValue`: Open TCP connection.
// - `Bytes`: Complete byte sequence to write.
procedure WriteAll(ConnectionValue: Net.Connection; Bytes: ByteStorage.ByteBuffer);
begin
  var Offset: integer := 0;
  while Offset < Bytes.Length() do
    begin
      const Remaining := Bytes.Slice(Offset, Bytes.Length() - Offset).Unwrap();
      case Net.SendBytes(ConnectionValue, Remaining) of
        when Ok(const Count):
          begin
            if Count <= 0 then
              begin
                panic('TCP connection stopped while writing');
              end;
            end if;

            Offset := Offset + Count;
          end;
        when Error(const Message):
          begin
            panic(Message.Message());
          end;
      end case;
    end;
  end while;
end procedure;

begin
  var Port: integer := 18081;
  if Args.ParamCount() = 1 then
    begin
      Port := Parse.Int(Args.ParamStr(0)).Unwrap();
    end;
  elsif Args.ParamCount() <> 0 then
    begin
      panic('usage: tcp_echo_server.fpas -- [PORT]');
    end;
  end if;

  case Net.Listen('127.0.0.1', Port) of
    when Ok(const ListenerValue):
      begin
        Console.WriteLn('TCP echo server listening on 127.0.0.1:' + Conv.IntToStr(Port));
        case Net.Accept(ListenerValue) of
          when Ok(const ConnectionValue):
            begin
              case Net.SetTimeout(ConnectionValue, 5000) of
                when Ok(_):
                  begin
                  end;
                when Error(const Message):
                  begin
                    panic(Message.Message());
                  end;
              end case;
              const Text: string := ReadLine(ConnectionValue);
              WriteAll(ConnectionValue, Utf8.Encode('Echo: ' + Text).Unwrap());
              case Net.Close(ConnectionValue) of
                when Ok(_):
                  begin
                  end;
                when Error(const Message):
                  begin
                    panic(Message.Message());
                  end;
              end case;
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;

        case Net.CloseListener(ListenerValue) of
          when Ok(_):
            begin
              Console.WriteLn('TCP echo server stopped');
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;
      end;
    when Error(const Message):
      begin
        panic(Message.Message());
      end;
  end case;
end.
