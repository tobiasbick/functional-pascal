// Four connection workers with signal-aware shutdown and explicit process escalation.
program ParallelTcpEchoServer;

uses Std.Args as Args;
uses Std.Conv as Conv;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Net as Net;
uses Std.Tasks as Tasks;
uses Std.Results as Results;
uses Std.Time as Time;
uses Std.Server as Server;

function Echo(Client: Net.Connection; Token: Tasks.CancellationToken): Result of (boolean, string);
begin
  var Configured: boolean := try Net.SetTimeout(Client, 5000);
  while not Tasks.IsCancellationRequested(Token) do
    begin
      var Bytes: array of (integer) := try Net.ReceiveBytesWithCancellation(Client, 4096, Token);
      if Arrays.Length(Bytes) = 0 then
        begin
          return Result.Ok(true);
        end;
      end if;
      mutable var Offset: integer := 0;
      while Offset < Arrays.Length(Bytes) do
        begin
          var Count: integer := try Net.SendBytesWithCancellation(Client, Arrays.Slice(Bytes, Offset, Arrays.Length(Bytes) -
                                                                                                      Offset), Token);
          if Count <= 0 then
            begin
              return Result.Error('TCP write made no progress');
            end;
          end if;

          Offset := Offset + Count;
        end;
      end while;
    end;
  end while;

  return Result.Ok(true);
end function;

begin
  mutable var Port: integer := 18082;
  mutable var LifetimeMillis: integer := 10000;
  if Args.ParamCount() > 2 then
    begin
      panic('usage: tcp_parallel_echo_server.fpas -- [PORT [LIFETIME_MS]]');
    end;
  end if;

  if Args.ParamCount() >= 1 then
    begin
      Port := Conv.StrToInt(Args.ParamStr(0));
    end;
  end if;

  if Args.ParamCount() = 2 then
    begin
      LifetimeMillis := Conv.StrToInt(Args.ParamStr(1));
    end;
  end if;

  if (LifetimeMillis < 1) or (LifetimeMillis > 300000) then
    begin
      panic('LIFETIME_MS must be 1..300000');
    end;
  end if;
  var ListenerValue: Net.Listener := Results.Unwrap(Net.Listen('127.0.0.1', Port));
  var Life: Server.ServerLifetime := Results.Unwrap(Server.CreateLifetime(1000, true));
  discard Results.Unwrap(Server.OwnListener(Life, ListenerValue));
  discard Results.Unwrap(Server.ObserveSignals(Life));
  var Workers: Tasks.TaskGroup := Server.GetWorkGroup(Life);
  for Index: integer := 1 to 4 do
    begin
      var StartedTask1: task := Tasks.StartTaskInGroup(Workers, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
        while not Tasks.IsCancellationRequested(Token) do
          begin
            case Net.AcceptWithCancellation(ListenerValue, Token) of
              when Result.Ok(const Client):
                begin
                  var Outcome: Result of (boolean, string) := Echo(Client, Token);
                  // Close even on read/write failure. One failed client does not stop admission.
                  var Closed: boolean := try Net.Close(Client);
                  case Outcome of
                    when Result.Error(const Message):
                      begin
                        if not Tasks.IsCancellationRequested(Token) then
                          begin
                            Console.WriteLn(Message);
                          end;
                        end if;
                      end;
                    when Result.Ok(_):
                      begin
                        null;
                      end;
                  end case;
                end;
              when Result.Error(const Message):
                begin
                  if Tasks.IsCancellationRequested(Token) then
                    begin
                      return Result.Ok(true);
                    end;
                  end if;

                  discard Server.RequestStop(Life);
                  return Result.Error(Message);
                end;
            end case;
          end;
        end while;

        return Result.Ok(true);
      end function);
    end;
  end for;

  Console.WriteLn('Parallel TCP echo ready');
  var Started: integer := Time.MonotonicMillis();
  while Server.IsReady(Life) and (Time.ElapsedMillis(Started) < LifetimeMillis) do
    begin
      Time.Sleep(10);
    end;
  end while;

  discard Server.RequestStop(Life);
  mutable var Failures: array of (Tasks.TaskFailure) := [];
  case Tasks.CloseTaskGroupWithTimeout(Workers, Server.RemainingMillis(Life)) of
    when Result.Ok(const Reports):
      begin
        Failures := Reports;
      end;
    when Result.Error(const Message):
      begin
        Console.WriteLn(Message);
        // The independent host watchdog remains armed even if diagnostic output blocks.
        panic('Server shutdown incomplete; process escalation remains armed');
      end;
  end case;

  for Failure: Tasks.TaskFailure in Failures do
    begin
      Console.WriteLn(Failure.Message);
    end;
  end for;

  for Message: string in Server.ShutdownErrors(Life) do
    begin
      Console.WriteLn(Message);
    end;
  end for;

  discard Results.Unwrap(Server.FinishShutdown(Life));
  if Arrays.Length(Failures) <> 0 then
    begin
      panic('TCP worker failed');
    end;
  end if;

  Console.WriteLn('Parallel TCP echo stopped');
end program;
