// Four connection workers with signal-aware shutdown and explicit process escalation.
program ParallelTcpEchoServer;

uses Std.Args, Std.Conv, Std.Console, Std.Net, Std.Tasks, Std.Time, Std.Server;

function Echo(Client: Connection; Token: CancellationToken): result of (boolean, string);
begin
  const Configured: boolean := try SetTimeout(Client, 5000);
  while not IsCancellationRequested(Token) do
    begin
      const Bytes: array of integer := try ReceiveBytesWithCancellation(Client, 4096, Token);
      if Bytes.Length() = 0 then
        begin
          return Ok(true);
        end;
      end if;
      var Offset: integer := 0;
      while Offset < Bytes.Length() do
        begin
          const Count: integer := try SendBytesWithCancellation(Client, Bytes.Slice(Offset, Bytes.Length() -
                                                                                            Offset), Token);
          if Count <= 0 then
            begin
              return Error('TCP write made no progress');
            end;
          end if;

          Offset := Offset + Count;
        end;
      end while;
    end;
  end while;

  return Ok(true);
end function;

begin
  var Port: integer := 18082;
  var LifetimeMillis: integer := 10000;
  if ParamCount() > 2 then
    begin
      panic('usage: tcp_parallel_echo_server.fpas -- [PORT [LIFETIME_MS]]');
    end;
  end if;

  if ParamCount() >= 1 then
    begin
      Port := StrToInt(ParamStr(0));
    end;
  end if;

  if ParamCount() = 2 then
    begin
      LifetimeMillis := StrToInt(ParamStr(1));
    end;
  end if;

  if (LifetimeMillis < 1) or (LifetimeMillis > 300000) then
    begin
      panic('LIFETIME_MS must be 1..300000');
    end;
  end if;
  const ListenerValue: Listener := Listen('127.0.0.1', Port).Unwrap();
  const Life: ServerLifetime := CreateLifetime(1000, true).Unwrap();
  discard OwnListener(Life, ListenerValue).Unwrap();
  discard ObserveSignals(Life).Unwrap();
  const Workers: TaskGroup := GetWorkGroup(Life);
  for Index: integer := 1 to 4 do
    begin
      const ConnectionTask: task := StartTaskInGroup(Workers, function(Token: CancellationToken): result of (boolean, string) begin
        while not IsCancellationRequested(Token) do
          begin
            case AcceptWithCancellation(ListenerValue, Token) of
              when Ok(const Client):
                begin
                  const Outcome: result of (boolean, string) := Echo(Client, Token);
                  // Close even on read/write failure. One failed client does not stop admission.
                  const Closed: boolean := try Close(Client);
                  case Outcome of
                    when Error(const Message):
                      begin
                        if not IsCancellationRequested(Token) then
                          begin
                            WriteLn(Message);
                          end;
                        end if;
                      end;
                    when Ok(_):
                      begin
                      end;
                  end case;
                end;
              when Error(const Message):
                begin
                  if IsCancellationRequested(Token) then
                    begin
                      return Ok(true);
                    end;
                  end if;

                  discard RequestStop(Life);
                  return Error(Message);
                end;
            end case;
          end;
        end while;

        return Ok(true);
      end function);
    end;
  end for;

  WriteLn('Parallel TCP echo ready');
  const Started: integer := MonotonicMillis();
  while IsReady(Life) and (ElapsedMillis(Started) < LifetimeMillis) do
    begin
      Sleep(10);
    end;
  end while;

  discard RequestStop(Life);
  var Failures: array of TaskFailure := [];
  case CloseTaskGroupWithTimeout(Workers, RemainingMillis(Life)) of
    when Ok(const Reports):
      begin
        Failures := Reports;
      end;
    when Error(const Message):
      begin
        WriteLn(Message);
        // The independent host watchdog remains armed even if diagnostic output blocks.
        panic('Server shutdown incomplete; process escalation remains armed');
      end;
  end case;

  for Failure: TaskFailure in Failures do
    begin
      WriteLn(Failure.Message);
    end;
  end for;

  for Message: string in ShutdownErrors(Life) do
    begin
      WriteLn(Message);
    end;
  end for;

  discard FinishShutdown(Life).Unwrap();
  if Failures.Length() <> 0 then
    begin
      panic('TCP worker failed');
    end;
  end if;

  WriteLn('Parallel TCP echo stopped');
end.
