// Four connection workers with signal-aware shutdown and explicit process escalation.
program ParallelTcpEchoServer;

uses
  Std.Bytes as ByteStorage,
  Std.Os.Args as Args, Std.Text.Format as Conv, Std.Console as Console, Std.Net.Sockets as Net, Std.Tasks as Tasks,
  Std.Time as Time, Std.Net.Server as Server, Std.Text.Parse as Parse;

type EchoError = error
  Transport(Cause: Net.NetError);
  Buffer(Cause: ByteStorage.BufferError);
  WriteStopped = 'TCP write made no progress';
end error;

function Echo(Client: Net.Connection; Token: Tasks.CancellationToken): result of (boolean, EchoError);
begin
  const Configured: boolean := try Net.SetTimeout(Client, 5000).MapError(EchoError.Transport);
  while not Tasks.IsCancellationRequested(Token) do
    begin
      const Bytes: ByteStorage.ByteBuffer := try Net.ReceiveBytesWithCancellation(
        Client,
        4096,
        Token
      ).MapError(EchoError.Transport);
      if Bytes.Length() = 0 then
        begin
          return Ok(true);
        end;
      end if;
      var Offset: integer := 0;
      while Offset < Bytes.Length() do
        begin
          const Count: integer := try Net.SendBytesWithCancellation(
            Client, (
              try Bytes.Slice(
                Offset, Bytes.Length() -
                Offset
              ).MapError(EchoError.Buffer)
            ), Token
          ).MapError(EchoError.Transport);
          if Count <= 0 then
            begin
              return Error(EchoError.WriteStopped);
            end;
          end if;

          Offset := Offset + Count;
        end;
      end while;
    end;
  end while;

  return Ok(true);
end function;

begin
  var Port: integer := 18082;
  var LifetimeMillis: integer := 10000;
  if Args.ParamCount() > 2 then
    begin
      panic('usage: tcp_parallel_echo_server.fpas -- [PORT [LIFETIME_MS]]');
    end;
  end if;

  if Args.ParamCount() >= 1 then
    begin
      Port := Parse.Int(Args.ParamStr(0)).Unwrap();
    end;
  end if;

  if Args.ParamCount() = 2 then
    begin
      LifetimeMillis := Parse.Int(Args.ParamStr(1)).Unwrap();
    end;
  end if;

  if (LifetimeMillis < 1) or (LifetimeMillis > 300000) then
    begin
      panic('LIFETIME_MS must be 1..300000');
    end;
  end if;
  const ListenerValue: Net.Listener := Net.Listen('127.0.0.1', Port).Unwrap();
  const Life: Server.ServerLifetime := Server.CreateLifetime(1000, true).Unwrap();
  discard Server.OwnListener(Life, ListenerValue).Unwrap();
  discard Server.ObserveSignals(Life).Unwrap();
  const Workers: Tasks.TaskGroup := Server.GetWorkGroup(Life);
  for Index: integer := 1 to 4 do
    begin
      const ConnectionTask: task of result of (boolean, EchoError) := Tasks.StartTaskInGroup(
        Workers, function(Token: Tasks.CancellationToken): result of (boolean, EchoError) begin
          while not Tasks.IsCancellationRequested(Token) do
            begin
              case Net.AcceptWithCancellation(ListenerValue, Token).MapError(EchoError.Transport) of
                when Ok(const Client):
                  begin
                    const Outcome: result of (boolean, EchoError) := Echo(Client, Token);
                    // Close even on read/write failure. One failed client does not stop admission.
                    const Closed: boolean := try Net.Close(Client).MapError(EchoError.Transport);
                    case Outcome of
                      when Error(const Message):
                        begin
                          if not Tasks.IsCancellationRequested(Token) then
                            begin
                              Console.WriteLn(Message);
                            end;
                          end if;
                        end;
                      when Ok(_):
                        begin
                        end;
                    end case;
                  end;
                when Error(const Message):
                  begin
                    if Tasks.IsCancellationRequested(Token) then
                      begin
                        return Ok(true);
                      end;
                    end if;

                    discard Server.RequestStop(Life);
                    return Error(Message);
                  end;
              end case;
            end;
          end while;

          return Ok(true);
        end function
      );
    end;
  end for;

  Console.WriteLn('Parallel TCP echo ready');
  const Started: integer := Time.MonotonicMillis();
  while Server.IsReady(Life) and (Time.ElapsedMillis(Started) < LifetimeMillis) do
    begin
      Time.Sleep(10);
    end;
  end while;

  discard Server.RequestStop(Life);
  var Failures: array of Tasks.TaskFailure := [];
  case Tasks.CloseTaskGroupWithTimeout(Workers, Server.RemainingMillis(Life)) of
    when Ok(const Reports):
      begin
        Failures := Reports;
      end;
    when Error(const Message):
      begin
        Console.WriteLn(Message);
        // The independent host watchdog remains armed even if diagnostic output blocks.
        panic('Server shutdown incomplete; process escalation remains armed');
      end;
  end case;

  for Failure: Tasks.TaskFailure in Failures do
    begin
      Console.WriteLn(Failure.Message);
    end;
  end for;

  for Message: string in Server.ShutdownErrors(Life) do
    begin
      Console.WriteLn(Message);
    end;
  end for;

  discard Server.FinishShutdown(Life).Unwrap();
  if Failures.Length() <> 0 then
    begin
      panic('TCP worker failed');
    end;
  end if;

  Console.WriteLn('Parallel TCP echo stopped');
end.
