// Parses one network URI and round-trips Unicode text through UTF-8 bytes.
program NetworkUriUtf8;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Net.Uri as Uri;
uses Std.Net.Utf8 as Utf8;

begin
  case Uri.Parse('https://example.com:8443/api/items?limit=2') of
    when Result.Ok(const UriValue):
      begin
        Console.WriteLn('scheme: ' + UriValue.Scheme);
        Console.WriteLn('host: ' + UriValue.Host);
        Console.WriteLn('port: ' + Conv.IntToStr(UriValue.Port));
        Console.WriteLn('path: ' + UriValue.Path);
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
  const Bytes: array of (integer) := Utf8.Encode('Grüße aus FPAS');
  case Utf8.Decode(Bytes) of
    when Result.Ok(const Text):
      begin
        Console.WriteLn('UTF-8: ' + Text);
      end;
    when Result.Error(const Message):
      begin
        panic(Message);
      end;
  end case;
end program;
