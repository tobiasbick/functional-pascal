// Runs an interactive chat against a configured OpenAI-compatible endpoint.
program OpenAiChat;

uses Std.Ai.OpenAi as OpenAi;
uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Env as Env;

begin
  if Args.ParamCount() <> 2 then
    begin
      Console.WriteLn('Usage: fpas run examples/openai-chat/openai-chat.fpasprj -- <base-url> <model>');
      Console.WriteLn('Example: ... -- http://127.0.0.1:8080/v1 local-model');
      return;
    end;
  end if;
  mutable var ClientValue: OpenAi.Client := OpenAi.Client.Create(Args.ParamStr(0), Args.ParamStr(1));
  case Env.Get('OPENAI_API_KEY') of
    when Option.Some(const Value):
      begin
        ClientValue.ApiKey := Option.Some(Value);
      end;
    when Option.None:
      begin
        null;
      end;
  end case;
  mutable var Messages: array of (OpenAi.ChatMessage) := [];
  var Options: OpenAi.ChatOptions := OpenAi.ChatOptions.Default();
  Console.WriteLn('OpenAI-compatible FPAS chat. Enter /exit to quit.');
  while true do
    begin
      Console.WriteText('you> ');
      var Prompt: string := Console.ReadLn();
      if Prompt = '/exit' then
        begin
          break;
        end;
      end if;

      if Prompt <> '' then
        begin
          mutable var RequestMessages: array of (OpenAi.ChatMessage) := Messages;
          Arrays.Push(RequestMessages, OpenAi.ChatMessage.User(Prompt));
          case OpenAi.Complete(ClientValue, RequestMessages, Options) of
            when Result.Ok(const Content):
              begin
                Console.WriteLn('assistant> ' + Content);
                Arrays.Push(Messages, OpenAi.ChatMessage.User(Prompt));
                Arrays.Push(Messages, OpenAi.ChatMessage.Assistant(Content));
              end;
            when Result.Error(const Message):
              begin
                Console.WriteLn('error> ' + Message);
              end;
          end case;
        end;
      end if;
    end;
  end while;
end program;
