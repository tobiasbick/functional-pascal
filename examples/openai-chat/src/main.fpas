// Runs an interactive chat against a configured OpenAI-compatible endpoint.
program OpenAiChat;

uses Std.Ai.OpenAi as OpenAi, Std.Args as Args, Std.Console as Console, Std.Env as Env;

begin
  if Args.ParamCount() <> 2 then
    begin
      Console.WriteLn(
        'Usage: fpas run examples/openai-chat/openai-chat.fpasprj -- <base-url> <model>'
      );
      Console.WriteLn('Example: ... -- http://127.0.0.1:8080/v1 local-model');
      return;
    end;
  end if;
  var ClientValue: OpenAi.Client := OpenAi.Client.Create(Args.ParamStr(0), Args.ParamStr(1));
  case Env.Get('OPENAI_API_KEY') of
    when Some(const Value):
      begin
        ClientValue.ApiKey := Some(Value);
      end;
    when None:
      begin
      end;
  end case;
  var Messages: array of OpenAi.ChatMessage := [];
  const Options: OpenAi.ChatOptions := OpenAi.ChatOptions.Default();
  Console.WriteLn('OpenAI-compatible FPAS chat. Enter /exit to quit.');
  while true do
    begin
      Console.WriteText('you> ');
      const Prompt: string := Console.ReadLn();
      if Prompt = '/exit' then
        begin
          break;
        end;
      end if;

      if Prompt <> '' then
        begin
          var RequestMessages: array of OpenAi.ChatMessage := Messages;
          RequestMessages.PushInPlace(OpenAi.ChatMessage.User(Prompt));
          case OpenAi.Complete(ClientValue, RequestMessages, Options) of
            when Ok(const Content):
              begin
                Console.WriteLn('assistant> ' + Content);
                Messages.PushInPlace(OpenAi.ChatMessage.User(Prompt));
                Messages.PushInPlace(OpenAi.ChatMessage.Assistant(Content));
              end;
            when Error(const Message):
              begin
                Console.WriteLn('error> ' + Message);
              end;
          end case;
        end;
      end if;
    end;
  end while;
end.
