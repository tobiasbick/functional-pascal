// Runs an interactive chat against a configured OpenAI-compatible endpoint.
program OpenAiChat;

uses Std.Ai.OpenAi, Std.Args, Std.Console, Std.Env;

begin
  if ParamCount() <> 2 then
    begin
      WriteLn('Usage: fpas run examples/openai-chat/openai-chat.fpasprj -- <base-url> <model>');
      WriteLn('Example: ... -- http://127.0.0.1:8080/v1 local-model');
      return;
    end;
  end if;
  var ClientValue: Client := Client.Create(ParamStr(0), ParamStr(1));
  case Std.Env.Get('OPENAI_API_KEY') of
    when Some(Value):
      begin
        ClientValue.ApiKey := Some(Value);
      end;
    when None:
      begin
      end;
  end case;
  var Messages: array of ChatMessage := [];
  const Options: ChatOptions := ChatOptions.Default();
  WriteLn('OpenAI-compatible FPAS chat. Enter /exit to quit.');
  while true do
    begin
      WriteText('you> ');
      const Prompt: string := ReadLn();
      if Prompt = '/exit' then
        begin
          break;
        end;
      end if;

      if Prompt <> '' then
        begin
          var RequestMessages: array of ChatMessage := Messages;
          RequestMessages.Push(ChatMessage.User(Prompt));
          case Complete(ClientValue, RequestMessages, Options) of
            when Ok(Content):
              begin
                WriteLn('assistant> ' + Content);
                Messages.Push(ChatMessage.User(Prompt));
                Messages.Push(ChatMessage.Assistant(Content));
              end;
            when Error(Message):
              begin
                WriteLn('error> ' + Message);
              end;
          end case;
        end;
      end if;
    end;
  end while;
end.
