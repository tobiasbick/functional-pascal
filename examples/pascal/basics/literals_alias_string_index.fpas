// Spec: docs/pascal/language/basics/README.md (from repository root).

program LiteralsAliasStringIndex;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;

type Score = integer;

const HexMask: integer := 15;
const BigScore: integer := 1000;

begin
  const Name: string := 'FPAS';
  const First: string := Name[0];
  const Last: string := Name[Str.Length(Name) - 1];
  const Total: Score := BigScore + HexMask;
  Console.WriteLn('total: ', Conv.IntToStr(Total));
  Console.WriteLn('first: ', First);
  Console.WriteLn('last: ', Last);
end program;
