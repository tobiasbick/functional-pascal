// Spec: docs/pascal/language/basics/README.md (from repository root).

program LiteralsAliasStringIndex;

uses Std.Console, Std.Conv;

type Score = integer;

const HexMask: integer := 15;
const BigScore: integer := 1000;

begin
  const Name: string := 'FPAS';
  const First: string := Name[0];
  const Last: string := Name[Name.Length() - 1];
  const Total: Score := BigScore + HexMask;
  WriteLn('total: ', IntToStr(Total));
  WriteLn('first: ', First);
  WriteLn('last: ', Last);
end.
