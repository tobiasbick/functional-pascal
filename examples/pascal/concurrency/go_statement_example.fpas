// Spec: docs/pascal/language/concurrency/go.md — scope-owned task with a discarded handle.

program GoStatementExample;

uses Std.Console as Console, Std.Time as Time;

procedure LogLine(Message: string);
begin
  Console.WriteLn(Message);
end procedure;

begin
  scope
    discard go LogLine('from spawned task');
    Console.WriteLn('main continues immediately');
    Time.Sleep(50);
  end scope;
end.
