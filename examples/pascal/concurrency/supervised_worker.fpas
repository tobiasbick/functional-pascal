program SupervisedWorker;

uses Std.Tasks as Tasks;
uses Std.Console as Console;
uses Std.Results as Results;

begin
  var Workers: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  // This queue models a transient failure followed by a successful operation.
  var Outcomes: channel of (boolean) := Tasks.CreateChannel(2);
  discard Tasks.Send(Outcomes, false);
  discard Tasks.Send(Outcomes, true);
  var Worker: task := Tasks.StartSupervisedTask(Workers, function(Token: Tasks.CancellationToken): Result of (string, string) begin
    Console.WriteLn('Starting an attempt');
    if not Results.Unwrap(Tasks.Receive(Outcomes)) then
      begin
        return Result.Error('temporary failure');
      end;
    end if;

    return Result.Ok('Worker completed');
  end function, 2, 10);
  // Wait retrieves the final result; intermediate failures remain inside the supervisor.
  Console.WriteLn(Results.Unwrap(Tasks.Wait(Worker)));
  discard Tasks.CloseTaskGroup(Workers);
  discard Tasks.CloseChannel(Outcomes);
end program;
