program SupervisedWorker;

uses Std.Tasks, Std.Console;

begin
  const Workers: TaskGroup := CreateTaskGroup();
  // This queue models a transient failure followed by a successful operation.
  const Outcomes: channel of boolean := CreateChannel(2);
  discard Send(Outcomes, false);
  discard Send(Outcomes, true);
  const Worker: task := StartSupervisedTask(Workers, function(Token: CancellationToken): result of (string, string) begin
    WriteLn('Starting an attempt');
    if not Receive(Outcomes).Unwrap() then
      begin
        return Error('temporary failure');
      end;
    end if;

    return Ok('Worker completed');
  end function, 2, 10);
  // Wait retrieves the final result; intermediate failures remain inside the supervisor.
  WriteLn(Wait(Worker).Unwrap());
  discard CloseTaskGroup(Workers);
  discard CloseChannel(Outcomes);
end.
