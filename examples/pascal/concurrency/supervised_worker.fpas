program SupervisedWorker;

uses Std.Task, Std.Console, Std.Result;

begin
  var Workers: TaskGroup := CreateTaskGroup();
  // This queue models a transient failure followed by a successful operation.
  var Outcomes: channel of boolean := CreateChannel(2);
  Send(Outcomes, false);
  Send(Outcomes, true);
  var Worker: task := StartSupervisedTask(Workers, function(Token: CancellationToken): result of string, string begin
    WriteLn('Starting an attempt');
    if not Unwrap(Receive(Outcomes)) then
    begin
      return Error('temporary failure')
    end;

    return Ok('Worker completed')
  end, 2, 10);
  // Wait retrieves the final result; intermediate failures remain inside the supervisor.
  WriteLn(Unwrap(Wait(Worker)));
  CloseTaskGroup(Workers);
  CloseChannel(Outcomes)
end.
