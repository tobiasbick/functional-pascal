// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 20000
// Guard: target/release/fpas run this-file.fpas -- 20000 MAX_MILLIS

program TaskArrayCallbacksBenchmark;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Tasks as Tasks;
uses Std.Time as Time;

const WarmupIterations: integer := 20;
const ArraySize: integer := 64;
const CallbacksPerElement: integer := 3;

function Double(Value: integer): integer;
begin
  return Value * 2;
end function;

function IsEven(Value: integer): boolean;
begin
  return Value mod 2 = 0;
end function;

function Sum(Acc: integer; Value: integer): integer;
begin
  return Acc + Value;
end function;

function MakeValues(): array of (integer);
begin
  mutable var Values: array of (integer) := [];
  for Index: integer := 1 to ArraySize do
    begin
      Arrays.Push(Values, Index);
    end;
  end for;

  return Values;
end function;

function RunCallbacks(Values: array of (integer); Iterations: integer): integer;
begin
  mutable var Total: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      var Mapped: array of (integer) := Arrays.Map(Values, Double);
      var Filtered: array of (integer) := Arrays.Filter(Mapped, IsEven);
      Total := Total + Arrays.Reduce(Filtered, 0, Sum);
    end;
  end for;

  return Total;
end function;

function RunTask(Values: array of (integer); Iterations: integer): integer;
begin
  var Job: task := go RunCallbacks(Values, Iterations);
  return Tasks.Wait(Job);
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: task_array_callbacks_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  mutable var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var Values: array of (integer) := MakeValues();
  mutable var Total: integer := RunTask(Values, WarmupIterations);
  var Started: integer := Time.MonotonicMillis();
  Total := RunTask(Values, Iterations);
  var Elapsed: integer := Time.ElapsedMillis(Started);
  var Callbacks: integer := (Iterations * ArraySize) * CallbacksPerElement;
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Callbacks * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn((('iterations: ' + Conv.IntToStr(Iterations)) + ', callbacks: ') +
                  Conv.IntToStr(Callbacks));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' callbacks/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('checksum: ' + Conv.IntToStr(Total));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('task-array-callbacks benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
