// Model a cleanup operation that needs an explicit release after cancellation.
program TaskGroupCloseTimeout;

uses Std.Tasks as Tasks;
uses Std.Results as Results;
uses Std.Console as Console;
uses Std.Arrays as Arrays;

begin
  const Release: channel of (integer) := Tasks.CreateChannel(1);
  const Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const StartedTask1: task := Tasks.StartTaskInGroup(Group, procedure(Token: Tasks.CancellationToken) begin
    // Intentionally not cancellable: the owner must release this cleanup gate.
    discard Results.Unwrap(Tasks.Receive(Release));
  end procedure);
  case Tasks.CloseTaskGroupWithTimeout(Group, 0) of
    when Result.Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
    when Result.Ok(_):
      begin
        panic('Cleanup gate was not released');
      end;
  end case;

  discard Results.Unwrap(Tasks.Send(Release, 1));
  const Failures: array of (Tasks.TaskFailure) := Tasks.CloseTaskGroup(Group);
  discard Tasks.CloseChannel(Release);
  if Arrays.Length(Failures) <> 0 then
    begin
      panic('Cleanup failed');
    end;
  end if;

  Console.WriteLn('Cleanup joined; ownership released');
end program;
