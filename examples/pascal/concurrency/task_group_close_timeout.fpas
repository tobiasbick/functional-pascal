// Model a cleanup operation that needs an explicit release after cancellation.
program TaskGroupCloseTimeout;

uses Std.Tasks, Std.Results, Std.Console, Std.Arrays;

begin
  const Release: channel of integer := CreateChannel(1);
  const Group: TaskGroup := CreateTaskGroup();
  const WorkerTask: task := StartTaskInGroup(Group, procedure(Token: CancellationToken) begin
    // Intentionally not cancellable: the owner must release this cleanup gate.
    discard Unwrap(Receive(Release));
  end procedure);
  case CloseTaskGroupWithTimeout(Group, 0) of
    when Error(Message):
      begin
        WriteLn(Message);
      end;
    when Ok(_):
      begin
        panic('Cleanup gate was not released');
      end;
  end case;

  discard Unwrap(Send(Release, 1));
  const Failures: array of TaskFailure := CloseTaskGroup(Group);
  discard CloseChannel(Release);
  if Length(Failures) <> 0 then
    begin
      panic('Cleanup failed');
    end;
  end if;

  WriteLn('Cleanup joined; ownership released');
end.
