program TaskGroupWorkers;

uses Std.Tasks, Std.Console;

function CheckConfiguration(Token: CancellationToken): result of (boolean, string);
begin
  return Error('A required setting is missing');
end function;

begin
  const Workers: TaskGroup := CreateTaskGroup();
  // Keep the group even when individual task handles are not needed.
  const ConfigurationTask: task := StartTaskInGroup(Workers, CheckConfiguration);
  const WorkerTask: task := StartTaskInGroup(Workers, procedure(Token: CancellationToken) begin
    const Stop: WaitCase := CancellationCase(Token, procedure() begin
      WriteLn('Background worker stopped');
    end procedure);
    discard Select([Stop]);
  end procedure);
  // Close requests cooperative cancellation and waits for every registered worker.
  const Failures: array of TaskFailure := CloseTaskGroup(Workers);
  for Failure: TaskFailure in Failures do
    begin
      WriteLn(Failure.Message);
    end;
  end for;
end.
