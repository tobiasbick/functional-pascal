program TaskGroupWorkers;

uses Std.Tasks as Tasks;
uses Std.Console as Console;

function CheckConfiguration(Token: Tasks.CancellationToken): result of boolean, string;
begin
  return Error('A required setting is missing');
end function;

begin
  var Workers: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  // Keep the group even when individual task handles are not needed.
  var WorkerHandle: task := Tasks.StartTaskInGroup(Workers, CheckConfiguration);
  var StartedTask1: task := Tasks.StartTaskInGroup(Workers, procedure(Token: Tasks.CancellationToken) begin
    var Stop: Tasks.WaitCase := Tasks.CancellationCase(Token, procedure() begin
      Console.WriteLn('Background worker stopped');
    end procedure);
    discard Tasks.Select([Stop]);
  end procedure);
  // Close requests cooperative cancellation and waits for every registered worker.
  var Failures: array of Tasks.TaskFailure := Tasks.CloseTaskGroup(Workers);
  for Failure: Tasks.TaskFailure in Failures do
    begin
      Console.WriteLn(Failure.Message);
    end;
  end for;
end program;
