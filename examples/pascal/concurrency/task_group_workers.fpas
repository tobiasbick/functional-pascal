program TaskGroupWorkers;

uses Std.Tasks as Tasks, Std.Console as Console;

function CheckConfiguration(Token: Tasks.CancellationToken): result of (boolean, string);
begin
  return Error('A required setting is missing');
end function;

begin
  const Workers: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  // Keep the group even when individual task handles are not needed.
  const ConfigurationTask: task of result of (boolean, string) := Tasks.StartTaskInGroup(
    Workers,
    CheckConfiguration
  );
  const WorkerTask: task := Tasks.StartTaskInGroup(
    Workers, procedure(Token: Tasks.CancellationToken) begin
      const Stop: Tasks.WaitCase := Tasks.CancellationCase(
        Token, procedure() begin
          Console.WriteLn('Background worker stopped');
        end procedure
      );
      discard Tasks.Select([Stop]);
    end procedure
  );
  // A returned Error is ordinary Result data; retrieve it before close releases results.
  case Tasks.Wait(ConfigurationTask) of
    when Ok(_):
      null;
    when Error(const Message):
      Console.WriteLn(Message);
  end case;
  // Close requests cooperative cancellation and waits for every registered worker.
  const Failures: array of Tasks.TaskFailure := Tasks.CloseTaskGroup(Workers);
  for Failure: Tasks.TaskFailure in Failures do
    begin
      Console.WriteLn(Failure.Message);
    end;
  end for;
end.
