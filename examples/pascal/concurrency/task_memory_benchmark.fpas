// Reproduces https://pkolaczk.github.io/memory-consumption-of-async/
// Build first: cargo build --release -p fpas-cli
// Linux: /usr/bin/time -v target/release/fpas run this-file.fpas -- 10000
// PowerShell: use Start-Process -PassThru and inspect PeakWorkingSet64 after WaitForExit().

program TaskMemoryBenchmark;

uses
  Std.Os.Args as Args, Std.Console as Console, Std.Text.Format as Conv, Std.Tasks as StdTasks,
  Std.Time as Time, Std.Text.Parse as Parse;

const SleepMillis: integer := 10000;
const ProgressEvery: integer := 10000;

procedure Worker();
begin
  Time.Sleep(SleepMillis);
end procedure;

begin
  scope
    if Args.ParamCount() <> 1 then
      begin
        panic('usage: task_memory_benchmark.fpas -- TASK_COUNT');
      end;
    end if;
    const TaskCount: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
    if TaskCount < 1 then
      begin
        panic('TASK_COUNT must be positive');
      end;
    end if;

    Console.WriteLn('spawning ' + Conv.IntToStr(TaskCount) + ' tasks');
    const Started: integer := Time.MonotonicMillis();
    var Tasks: array of task := [];
    for I: integer := 1 to TaskCount do
      begin
        Tasks.PushInPlace(go Worker());
        if I mod ProgressEvery = 0 then
          begin
            Console.WriteLn('spawned ' + Conv.IntToStr(I));
          end;
        end if;
      end;
    end for;

    Console.WriteLn('all tasks spawned; waiting');
    StdTasks.WaitAll(Tasks);
    Console.WriteLn('completed in ' + Conv.IntToStr(Time.ElapsedMillis(Started)) + ' ms');
  end scope;
end.
