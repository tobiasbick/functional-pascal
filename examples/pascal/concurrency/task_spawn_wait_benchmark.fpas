// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 100000
// Guard: target/release/fpas run this-file.fpas -- 100000 MAX_MILLIS

program TaskSpawnWaitBenchmark;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Tasks as Tasks2;
uses Std.Time as Time;

const WarmupIterations: integer := 10;

function Worker(Value: integer): integer;
begin
  return Value + 1;
end function;

function RunTasks(Iterations: integer): integer;
begin
  mutable var Tasks: array of (task) := [];
  for Index: integer := 1 to Iterations do
    begin
      Arrays.Push(Tasks, go Worker(Index));
    end;
  end for;

  Tasks2.WaitAll(Tasks);
  return Arrays.Length(Tasks);
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: task_spawn_wait_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  mutable var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  mutable var Completed: integer := RunTasks(WarmupIterations);
  var Started: integer := Time.MonotonicMillis();
  Completed := RunTasks(Iterations);
  var Elapsed: integer := Time.ElapsedMillis(Started);
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn('iterations: ' + Conv.IntToStr(Iterations));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' tasks/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('completed: ' + Conv.IntToStr(Completed));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('task-spawn-wait benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
