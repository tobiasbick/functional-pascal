{ Build first: cargo build --release -p fpas-cli }
{ Baseline: target/release/fpas run this-file.fpas -- 100000 }
{ Guard: target/release/fpas run this-file.fpas -- 100000 MAX_MILLIS }

program TaskSpawnWaitBenchmark;

uses Std.Args, Std.Array, Std.Console, Std.Conv, Std.Task, Std.Time;

const
  WarmupIterations: integer := 10;

function Worker(Value: integer): integer;
begin
  return Value + 1
end;

function RunTasks(Iterations: integer): integer;
begin
  mutable var Tasks: array of task := [];
  for Index: integer := 1 to Iterations do
  begin
    Std.Array.Push(Tasks, go Worker(Index))
  end;

  WaitAll(Tasks);
  return Std.Array.Length(Tasks)
end;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
  begin
    panic('usage: task_spawn_wait_benchmark.fpas -- ITERATIONS [MAX_MILLIS]')
  end;
  var Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
  begin
    panic('ITERATIONS must be positive')
  end;
  mutable var MaxMillis: integer := 0;
  if ParamCount() = 2 then
  begin
    MaxMillis := StrToInt(ParamStr(1));
    if MaxMillis < 1 then
    begin
      panic('MAX_MILLIS must be positive')
    end
  end;
  mutable var Completed: integer := RunTasks(WarmupIterations);
  var Started: integer := MonotonicMillis();
  Completed := RunTasks(Iterations);
  var Elapsed: integer := ElapsedMillis(Started);
  mutable var OpsPerSecond: integer := Iterations;
  if Elapsed > 0 then
  begin
    OpsPerSecond := (Iterations * 1000) div Elapsed
  end;

  WriteLn('iterations: ' + IntToStr(Iterations));
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  WriteLn(('throughput: ' + IntToStr(OpsPerSecond)) + ' tasks/s');
  WriteLn('completed: ' + IntToStr(Completed));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
  begin
    panic(((('task-spawn-wait benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
          ' ms')
  end
end.
