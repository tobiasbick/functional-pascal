// A producer, three workers, and a collector share bounded channels.
program WorkerPipeline;

uses Std.Tasks, Std.Console;

begin
  const Jobs: channel of integer := CreateChannel(2);
  const Results: channel of integer := CreateChannel(2);
  const Group: TaskGroup := CreateTaskGroup();
  const ProducerTask: task := StartTaskInGroup(Group, procedure(Token: CancellationToken) begin
    for Value: integer := 1 to 12 do
      begin
        if SendWithCancellation(Jobs, Value, Token).IsError() then
          begin
            return;
          end;
        end if;
      end;
    end for;

    discard CloseChannel(Jobs);
  end procedure);
  for Worker: integer := 1 to 3 do
    begin
      const WorkerTask: task := StartTaskInGroup(Group, procedure(Token: CancellationToken) begin
        while not IsCancellationRequested(Token) do
          begin
            case ReceiveWithCancellation(Jobs, Token) of
              when Ok(const Value):
                begin
                  if SendWithCancellation(Results, Value * Value, Token).IsError() then
                    begin
                      return;
                    end;
                  end if;
                end;
              when Error(_):
                begin
                  return;
                end;
            end case;
          end;
        end while;
      end procedure);
    end;
  end for;
  // Collect while the producer runs: filling Jobs first could deadlock the pipeline.
  var Total: integer := 0;
  for Index: integer := 1 to 12 do
    begin
      Total := Total + Receive(Results).Unwrap();
    end;
  end for;

  case CloseTaskGroupWithTimeout(Group, 1000) of
    when Ok(const Failures):
      begin
        if Failures.Length() <> 0 then
          begin
            panic('Worker failed');
          end;
        end if;
      end;
    when Error(_):
      begin
        // A timeout retains ownership. Joining is still required, not a forced kill.
        if CloseTaskGroup(Group).Length() <> 0 then
          begin
            panic('Worker failed');
          end;
        end if;
      end;
  end case;

  discard CloseChannel(Results);
  WriteLn(Total);
end.
