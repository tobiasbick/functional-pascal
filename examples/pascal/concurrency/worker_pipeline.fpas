// A producer, three workers, and a collector share bounded channels.
program WorkerPipeline;

uses Std.Tasks as Tasks;
uses Std.Results as Results2;
uses Std.Console as Console;
uses Std.Arrays as Arrays;

begin
  var Jobs: channel of (integer) := Tasks.CreateChannel(2);
  var Results: channel of (integer) := Tasks.CreateChannel(2);
  var Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  var StartedTask1: task := Tasks.StartTaskInGroup(Group, procedure(Token: Tasks.CancellationToken) begin
    for Value: integer := 1 to 12 do
      begin
        if Results2.IsError(Tasks.SendWithCancellation(Jobs, Value, Token)) then
          begin
            return;
          end;
        end if;
      end;
    end for;

    discard Tasks.CloseChannel(Jobs);
  end procedure);
  for Worker: integer := 1 to 3 do
    begin
      var WorkerHandle: task := Tasks.StartTaskInGroup(Group, procedure(Token: Tasks.CancellationToken) begin
        while not Tasks.IsCancellationRequested(Token) do
          begin
            case Tasks.ReceiveWithCancellation(Jobs, Token) of
              when Result.Ok(const Value):
                begin
                  if Results2.IsError(Tasks.SendWithCancellation(Results, Value * Value, Token)) then
                    begin
                      return;
                    end;
                  end if;
                end;
              when Result.Error(_):
                begin
                  return;
                end;
            end case;
          end;
        end while;
      end procedure);
    end;
  end for;
  // Collect while the producer runs: filling Jobs first could deadlock the pipeline.
  mutable var Total: integer := 0;
  for Index: integer := 1 to 12 do
    begin
      Total := Total + Results2.Unwrap(Tasks.Receive(Results));
    end;
  end for;

  case Tasks.CloseTaskGroupWithTimeout(Group, 1000) of
    when Result.Ok(const Failures):
      begin
        if Arrays.Length(Failures) <> 0 then
          begin
            panic('Worker failed');
          end;
        end if;
      end;
    when Result.Error(_):
      begin
        // A timeout retains ownership. Joining is still required, not a forced kill.
        if Arrays.Length(Tasks.CloseTaskGroup(Group)) <> 0 then
          begin
            panic('Worker failed');
          end;
        end if;
      end;
  end case;

  discard Tasks.CloseChannel(Results);
  Console.WriteLn(Total);
end program;
