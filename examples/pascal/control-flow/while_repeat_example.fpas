program WhileRepeatExample;

uses Std.Console, Std.Conv;

begin
  var Count: integer := 0;
  while Count < 3 do
    begin
      WriteLn('while step: ', IntToStr(Count));
      Count := Count + 1;
    end;
  end while;
  var Attempts: integer := 0;
  repeat
    WriteLn('repeat step: ', IntToStr(Attempts));
    Attempts := Attempts + 1;
  until Attempts >= 3;
end.
