program ExpressionEval;

uses Std.Console as Console;
uses Std.Conv as Conv;

// A simple expression tree using enums with associated data
type Expr = enum
  Num(Value: integer);
  Add(Left: Expr; Right: Expr);
  Mul(Left: Expr; Right: Expr);
end enum;

function Eval(E: Expr): integer;
begin
  case E of
    when Expr.Num(const V):
      begin
        return V;
      end;
    when Expr.Add(const L, const R):
      begin
        return Eval(L) + Eval(R);
      end;
    when Expr.Mul(const L, const R):
      begin
        return Eval(L) * Eval(R);
      end;
  end case;
end function;

function Show(E: Expr): string;
begin
  case E of
    when Expr.Num(const V):
      begin
        return Conv.IntToStr(V);
      end;
    when Expr.Add(const L, const R):
      begin
        return ((('(' + Show(L)) + ' + ') + Show(R)) + ')';
      end;
    when Expr.Mul(const L, const R):
      begin
        return ((('(' + Show(L)) + ' * ') + Show(R)) + ')';
      end;
  end case;
end function;

begin
  const E1: Expr := Expr.Num(42);
  const E2: Expr := Expr.Add(Expr.Num(3), Expr.Num(7));
  const E3: Expr := Expr.Mul(E2, Expr.Add(Expr.Num(4), Expr.Num(5)));
  Console.WriteLn((Show(E1) + ' = ') + Conv.IntToStr(Eval(E1)));
  Console.WriteLn((Show(E2) + ' = ') + Conv.IntToStr(Eval(E2)));
  Console.WriteLn((Show(E3) + ' = ') + Conv.IntToStr(Eval(E3)));
end program;
