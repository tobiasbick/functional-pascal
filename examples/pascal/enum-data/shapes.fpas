program ShapesExample;

uses Std.Console, Std.Conv, Std.Math;

type Shape = enum
  Circle(Radius: real);
  Rectangle(Width: real; Height: real);
  Point;
end enum;

function Area(S: Shape): real;
begin
  case S of
    when Shape.Circle(const R):
      begin
        return Pi * R * R;
      end;
    when Shape.Rectangle(const W, const H):
      begin
        return W * H;
      end;
    when Shape.Point:
      begin
        return 0.0;
      end;
  end case;
end function;

function Describe(S: Shape): string;
begin
  case S of
    when Shape.Circle(const R):
      begin
        return 'Circle with radius ' + RealToStr(R);
      end;
    when Shape.Rectangle(const W, const H):
      begin
        return 'Rectangle ' + RealToStr(W) + ' x ' + RealToStr(H);
      end;
    when Shape.Point:
      begin
        return 'Point';
      end;
  end case;
end function;

begin
  const C: Shape := Shape.Circle(5.0);
  const R: Shape := Shape.Rectangle(10.0, 3.0);
  const P: Shape := Shape.Point;
  WriteLn(Describe(C) + ' -> area = ' + RealToStr(Area(C)));
  WriteLn(Describe(R) + ' -> area = ' + RealToStr(Area(R)));
  WriteLn(Describe(P) + ' -> area = ' + RealToStr(Area(P)));
end.
