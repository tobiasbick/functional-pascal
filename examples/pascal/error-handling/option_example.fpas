program OptionExample;

uses Std.Console, Std.Conv;

function FindFirst(Items: array of integer; Min: integer): option of integer;
begin
  for I: integer := 0 to Items.Length() - 1 do
    begin
      if Items[I] >= Min then
        begin
          return Some(Items[I]);
        end;
      end if;
    end;
  end for;

  return None;
end function;

function DoubleFirst(Items: array of integer; Min: integer): option of string;
begin
  const V: integer := try FindFirst(Items, Min);
  return Some(IntToStr(V) + ' x 2 = ' + IntToStr(V * 2));
end function;

begin
  const Data: array of integer := [3, 7, 15, 42, 8];
  const Found: option of integer := FindFirst(Data, 10);
  WriteLn('IsSome: ', Found.IsSome());
  WriteLn('Value: ', Found.Unwrap());
  const Missing: option of integer := FindFirst(Data, 100);
  WriteLn('IsNone: ', Missing.IsNone());
  WriteLn('UnwrapOr: ', Missing.UnwrapOr(0));
  case FindFirst(Data, 40) of
    when Some(const V):
      begin
        WriteLn('Found >= 40: ', V);
      end;
    when None:
      begin
        WriteLn('Nothing >= 40');
      end;
  end case;

  case FindFirst(Data, 100) of
    when Some(const V):
      begin
        WriteLn('Found >= 100: ', V);
      end;
    when None:
      begin
        WriteLn('Nothing >= 100');
      end;
  end case;

  case DoubleFirst(Data, 10) of
    when Some(const S):
      begin
        WriteLn(S);
      end;
    when None:
      begin
        WriteLn('No match to double');
      end;
  end case;

  case DoubleFirst(Data, 100) of
    when Some(const S):
      begin
        WriteLn(S);
      end;
    when None:
      begin
        WriteLn('No match to double');
      end;
  end case;
end.
