program PanicExample;

uses Std.Console;

function DivideChecked(A: integer; B: integer): integer;
begin
  if B = 0 then
  begin
    panic('Division by zero')
  end;

  return A div B
end;

function DayKind(Day: string): string;
begin
  case Day of
    'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday':
    begin
      return 'Weekday'
    end;
    'Saturday', 'Sunday':
    begin
      return 'Weekend'
    end
    else
    begin
      panic('Invalid day: ' + Day)
    end
  end
end;

begin
  WriteLn('10 / 3 = ', DivideChecked(10, 3));
  WriteLn('Monday is a ', DayKind('Monday'));
  WriteLn('Saturday is a ', DayKind('Saturday'))
end.
