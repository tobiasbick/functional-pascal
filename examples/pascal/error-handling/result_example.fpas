program ResultExample;

uses Std.Console as Console, Std.Text.Format as Conv;

function Divide(A: integer; B: integer): result of (integer, string);
begin
  if B = 0 then
    begin
      return Error('Division by zero');
    end;
  else
    begin
      return Ok(A div B);
    end;
  end if;
end function;

function Stringify(A: integer; B: integer): result of (string, string);
begin
  const Quotient: integer := try Divide(A, B);
  return Ok(Conv.IntToStr(A) + ' / ' + Conv.IntToStr(B) + ' = ' + Conv.IntToStr(Quotient));
end function;

begin
  const R1: result of (integer, string) := Divide(10, 3);
  Console.WriteLn('Ok variant: ', (R1 is Ok(_)));
  Console.WriteLn('Value: ', R1.Unwrap());
  const R2: result of (integer, string) := Divide(5, 0);
  Console.WriteLn('Error variant: ', (R2 is Error(_)));
  Console.WriteLn(
    'Default value: ', (
      case R2 of
        when Ok(const AP43Value): AP43Value;
        when Error(_): -1;
      end case
    )
  );
  case Divide(42, 6) of
    when Ok(const V):
      begin
        Console.WriteLn('42 / 6 = ', V);
      end;
    when Error(const E):
      begin
        Console.WriteLn('Error: ', E);
      end;
  end case;

  case Divide(7, 0) of
    when Ok(const V):
      begin
        Console.WriteLn('7 / 0 = ', V);
      end;
    when Error(const E):
      begin
        Console.WriteLn('Error: ', E);
      end;
  end case;

  case Stringify(100, 4) of
    when Ok(const S):
      begin
        Console.WriteLn(S);
      end;
    when Error(const E):
      begin
        Console.WriteLn('Failed: ', E);
      end;
  end case;

  case Stringify(100, 0) of
    when Ok(const S):
      begin
        Console.WriteLn(S);
      end;
    when Error(const E):
      begin
        Console.WriteLn('Failed: ', E);
      end;
  end case;
end.
