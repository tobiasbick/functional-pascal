program ResultExample;

uses Std.Console, Std.Conv, Std.Results;

function Divide(A: integer; B: integer): result of integer, string;
begin
  if B = 0 then
    begin
      return Error('Division by zero');
    end;
  else
    begin
      return Ok(A div B);
    end;
  end if;
end function;

function Stringify(A: integer; B: integer): result of string, string;
begin
  const Quotient: integer := try Divide(A, B);
  return Ok((((IntToStr(A) + ' / ') + IntToStr(B)) + ' = ') + IntToStr(Quotient));
end function;

begin
  const R1: result of integer, string := Divide(10, 3);
  WriteLn('IsOk: ', IsOk(R1));
  WriteLn('Value: ', Unwrap(R1));
  const R2: result of integer, string := Divide(5, 0);
  WriteLn('IsError: ', IsError(R2));
  WriteLn('UnwrapOr: ', UnwrapOr(R2, -1));
  case Divide(42, 6) of
    when Ok(V):
      begin
        WriteLn('42 / 6 = ', V);
      end;
    when Error(E):
      begin
        WriteLn('Error: ', E);
      end;
  end case;

  case Divide(7, 0) of
    when Ok(V):
      begin
        WriteLn('7 / 0 = ', V);
      end;
    when Error(E):
      begin
        WriteLn('Error: ', E);
      end;
  end case;

  case Stringify(100, 4) of
    when Ok(S):
      begin
        WriteLn(S);
      end;
    when Error(E):
      begin
        WriteLn('Failed: ', E);
      end;
  end case;

  case Stringify(100, 0) of
    when Ok(S):
      begin
        WriteLn(S);
      end;
    when Error(E):
      begin
        WriteLn('Failed: ', E);
      end;
  end case;
end.
