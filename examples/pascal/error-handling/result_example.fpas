program ResultExample;

uses Std.Console, Std.Conv;

function Divide(A: integer; B: integer): result of (integer, string);
begin
  if B = 0 then
    begin
      return Error('Division by zero');
    end;
  else
    begin
      return Ok(A div B);
    end;
  end if;
end function;

function Stringify(A: integer; B: integer): result of (string, string);
begin
  const Quotient: integer := try Divide(A, B);
  return Ok(IntToStr(A) + ' / ' + IntToStr(B) + ' = ' + IntToStr(Quotient));
end function;

begin
  const R1: result of (integer, string) := Divide(10, 3);
  WriteLn('IsOk: ', R1.IsOk());
  WriteLn('Value: ', R1.Unwrap());
  const R2: result of (integer, string) := Divide(5, 0);
  WriteLn('IsError: ', R2.IsError());
  WriteLn('UnwrapOr: ', R2.UnwrapOr(-1));
  case Divide(42, 6) of
    when Ok(const V):
      begin
        WriteLn('42 / 6 = ', V);
      end;
    when Error(const E):
      begin
        WriteLn('Error: ', E);
      end;
  end case;

  case Divide(7, 0) of
    when Ok(const V):
      begin
        WriteLn('7 / 0 = ', V);
      end;
    when Error(const E):
      begin
        WriteLn('Error: ', E);
      end;
  end case;

  case Stringify(100, 4) of
    when Ok(const S):
      begin
        WriteLn(S);
      end;
    when Error(const E):
      begin
        WriteLn('Failed: ', E);
      end;
  end case;

  case Stringify(100, 0) of
    when Ok(const S):
      begin
        WriteLn(S);
      end;
    when Error(const E):
      begin
        WriteLn('Failed: ', E);
      end;
  end case;
end.
