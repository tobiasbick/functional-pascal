program DictForInExample;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Dictionaries as Dictionaries;

begin
  const Ages: dict of (string, integer) := ['Alice': 30, 'Bob': 25, 'Cara': 31];
  Console.WriteLn('for Name in Ages (insertion order):');
  for Name: string in Ages do
    begin
      Console.WriteLn('  ', Name, ' -> ', Conv.IntToStr(Ages[Name]));
    end;
  end for;
end program;
