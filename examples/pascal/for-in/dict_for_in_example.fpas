program DictForInExample;

uses Std.Console as Console, Std.Text.Format as Conv;

begin
  const Ages: dict of string to integer := ['Alice': 30, 'Bob': 25, 'Cara': 31];
  Console.WriteLn('for Name in Ages (insertion order):');
  for Name: string in Ages do
    begin
      Console.WriteLn('  ', Name, ' -> ', Conv.IntToStr(Ages[Name]));
    end;
  end for;
end.
