program ForInExample;

uses Std.Console;

begin
  var Scores: array of integer := [12, 45, 3, 67, 29, 88, 51, 7, 93, 34];
  WriteLn('Filtered scores:');
  for S: integer in Scores do
  begin
    if S > 90 then
    begin
      WriteLn('Stopping — score above 90 found');
      break
    end;
    if S <= 10 then
    begin
      continue
    end;
    WriteLn(S)
  end
end.
