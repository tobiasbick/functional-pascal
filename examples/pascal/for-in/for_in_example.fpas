program ForInExample;

uses Std.Console as Console;

begin
  var Scores: array of integer := [12, 45, 3, 67, 29, 88, 51, 7, 93, 34];
  Console.WriteLn('Filtered scores:');
  for S: integer in Scores do
    begin
      if S > 90 then
        begin
          Console.WriteLn('Stopping — score above 90 found');
          break;
        end;
      end if;

      if S <= 10 then
        begin
          continue;
        end;
      end if;

      Console.WriteLn(S);
    end;
  end for;
end program;
