// Spec: docs/pascal/language/control-flow/README.md (from repository root).

program DowntoExample;

uses Std.Console as Console;
uses Std.Conv as Conv;

begin
  var Sum: integer := 0;
  for I: integer := 5 downto 1 do
    begin
      Sum := Sum + I;
    end;
  end for;

  Console.WriteLn('sum: ', Conv.IntToStr(Sum));
end program;
