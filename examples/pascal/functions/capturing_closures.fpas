program CapturingClosures;

uses Std.Console, Std.Conv;

function Counter(): function(): integer;
begin
  var Value: integer := 0;
  return function(): integer begin
    Value := Value + 1;
    return Value;
  end function;
end function;

function MakeAdder(Base: integer): function(Value: integer): integer;
function Add(Value: integer): integer;
begin
  return Base + Value;
end function;
begin
  return Add;
end function;

begin
  const Next: function(): integer := Counter();
  WriteLn('counter: ', IntToStr(Next()), ', ', IntToStr(Next()));
  var Count: integer := 0;
  const Increment: procedure() := procedure() begin
    Count := Count + 1;
  end procedure;

  Increment();
  Increment();
  WriteLn('shared count: ', IntToStr(Count));
  const AddTen: function(Value: integer): integer := MakeAdder(10);
  WriteLn('named escape: ', IntToStr(AddTen(5)));
end.
