program DiscardValues;

uses Std.Console as Console;

function Report(): result of (integer, string);
begin
  Console.WriteLn('Report was evaluated once.');
  return Error('deliberately ignored');
end function;

begin
  discard Report();
  discard Some('unused');
  // Discarding a callable value does not invoke it.
  discard procedure() begin
    Console.WriteLn('This callable was not invoked.');
  end procedure;
end.
