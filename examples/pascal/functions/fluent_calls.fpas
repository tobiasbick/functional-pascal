program FluentCallsExample;

uses Std.Console, Std.Conv;

function IsEven(Value: integer): boolean;
begin
  return Value mod 2 = 0;
end function;

function Double(Value: integer): integer;
begin
  return Value * 2;
end function;

function Sum(Acc: integer; Value: integer): integer;
begin
  return Acc + Value;
end function;

begin
  const Values: array of integer := [1, 2, 3, 4];
  const Total: integer := Values.Filter(IsEven).Map(Double).Reduce(0, Sum);
  WriteLn('Even values doubled: ' + Std.Conv.IntToStr(Total));
  WriteLn(('  Pascal  ').Trim().ToUpper());
end.
