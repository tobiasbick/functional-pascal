program FunctionCompositionExample;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;

pure function IsEven(Value: integer): boolean;
begin
  return Value mod 2 = 0;
end function;

pure function Double(Value: integer): integer;
begin
  return Value * 2;
end function;

pure function Sum(Acc: integer; Value: integer): integer;
begin
  return Acc + Value;
end function;

begin
  const Values: array of (integer) := [1, 2, 3, 4];
  const Total: integer := Arrays.Reduce(Arrays.Map(Arrays.Filter(Values, IsEven), Double), 0, Sum);
  Console.WriteLn('Even values doubled: ' + Conv.IntToStr(Total));
  Console.WriteLn(Str.ToUpper(Str.Trim(('  Pascal  '))));
end program;
