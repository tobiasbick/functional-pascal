// Spec: docs/pascal/language/functions/README.md (from repository root).

program MutableNestedFunctions;

uses Std.Console, Std.Conv;

procedure ClampToRange(Value: integer; Min: integer; Max: integer);
begin
  var LocalValue: integer := Value;
  if LocalValue < Min then
    begin
      LocalValue := Min;
    end;
  elsif LocalValue > Max then
    begin
      LocalValue := Max;
    end;
  end if;

  WriteLn('clamped local: ', IntToStr(LocalValue));
end procedure;

function IsEven(N: integer): boolean;
function IsOdd(X: integer): boolean;
begin
  if X = 0 then
    begin
      return false;
    end;
  else
    begin
      return IsEven(X - 1);
    end;
  end if;
end function;
begin
  if N = 0 then
    begin
      return true;
    end;
  else
    begin
      return IsOdd(N - 1);
    end;
  end if;
end function;

begin
  const Original: integer := 15;
  ClampToRange(Original, 0, 10);
  WriteLn('caller unchanged: ', IntToStr(Original));
  WriteLn('is even 8: ', IsEven(8));
end.
