// Spec: docs/pascal/language/functions/README.md (from repository root).

program MutableNestedFunctions;

uses Std.Console as Console;
uses Std.Conv as Conv;

procedure ClampToRange(InitialValue: integer; Min: integer; Max: integer);
begin
  var Value: integer := InitialValue;
  if Value < Min then
    begin
      Value := Min;
    end;
  else
    if Value > Max then
      begin
        Value := Max;
      end;
    end if;
  end if;

  Console.WriteLn('clamped local: ', Conv.IntToStr(Value));
end procedure;

function IsEven(N: integer): boolean;
function IsOdd(X: integer): boolean;
begin
  if X = 0 then
    begin
      return false;
    end;
  else
    begin
      return IsEven(X - 1);
    end;
  end if;
end function;
begin
  if N = 0 then
    begin
      return true;
    end;
  else
    begin
      return IsOdd(N - 1);
    end;
  end if;
end function;

begin
  const Original: integer := 15;
  ClampToRange(Original, 0, 10);
  Console.WriteLn('caller unchanged: ', Conv.IntToStr(Original));
  Console.WriteLn('is even 8: ', IsEven(8));
end program;
