program PostfixChainingExample;

uses Std.Console as Console;
uses Std.Conv as Conv;

type Num = record
  Value: integer;
end record;

function NumCreate(Value: integer): Num;
begin
  return Num(Value := Value);
end function;

function NumScale(Receiver: Num; Factor: integer): Num;
begin
  return Num(Value := Receiver.Value * Factor);
end function;

function NumNext(Receiver: Num): Num;
begin
  return Num(Value := Receiver.Value + 1);
end function;

begin
  Console.WriteLn(Conv.IntToStr(NumNext(NumScale(NumCreate(3), 2)).Value));
  Console.WriteLn(Conv.IntToStr([10, 20, 30][1]));
  Console.WriteLn(('ab')[0]);
end program;
