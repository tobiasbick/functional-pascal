program PostfixChainingExample;

uses Std.Console as Console;
uses Std.Conv as Conv;

type Num = record
  Value: integer;

  static function Create(Value: integer): Num;
  begin
    return Num(Value := Value);
  end function;

  function Scale(Self: Num; Factor: integer): Num;
  begin
    return Num(Value := Self.Value * Factor);
  end function;

  function Next(Self: Num): Num;
  begin
    return Num(Value := Self.Value + 1);
  end function;
end record;

begin
  Console.WriteLn(Conv.IntToStr(Num.Create(3).Scale(2).Next().Value));
  Console.WriteLn(Conv.IntToStr([10, 20, 30][1]));
  Console.WriteLn(('ab')[0]);
end program;
