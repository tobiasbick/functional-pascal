program GenericFunctionsExample;

uses Std.Console as Console;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;

function Identity of (T)(Value: T): T;
begin
  return Value;
end function;

function Wrap of (T)(Value: T): array of (T);
begin
  return [Value];
end function;

function FirstElement of (T)(Items: array of (T)): T;
begin
  return Items[0];
end function;

begin
  Console.WriteLn('Identity(integer): ', Identity(42));
  Console.WriteLn('Identity(string): ', Identity('hello'));
  Console.WriteLn('Identity(boolean): ', Identity(true));
  const Numbers: array of (integer) := Wrap(99);
  Console.WriteLn('Wrapped length: ', Conv.IntToStr(Arrays.Length(Numbers)));
  Console.WriteLn('First wrapped value: ', FirstElement(Numbers));
  const Words: array of (string) := ['red', 'green', 'blue'];
  Console.WriteLn('First word: ', FirstElement(Words));
end program;
