// Spec: docs/pascal/language/types/generics.md (from repository root).

program GenericRecordMethods;

uses Std.Console, Std.Conv;

type Box = record
  Value: integer;

  function Map<R>(Self: Box; F: function(X: integer): R): R;
  begin
    return F(Self.Value);
  end function;
end record;

type Accumulator = record
  function EchoNumeric<T: Numeric>(Self: Accumulator; Extra: T): T;
  begin
    return Extra;
  end function;
end record;

function ToText(X: integer): string;
begin
  return 'value=' + IntToStr(X);
end function;

begin
  const B: Box := Box(Value := 42);
  WriteLn(B.Map(ToText));
  const A: Accumulator := Accumulator();
  WriteLn('numeric int: ', IntToStr(A.EchoNumeric(21)));
  WriteLn('numeric real ok: ', A.EchoNumeric(1.5) > 1.0);
end.
