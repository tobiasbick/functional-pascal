program HigherOrderFunctionsExample;

uses Std.Console, Std.Arrays;

// First-class named functions

function Square(X: integer): integer;
begin
  return X * X;
end function;

function Double(X: integer): integer;
begin
  return X * 2;
end function;

function IsGreaterThanThree(X: integer): boolean;
begin
  return X > 3;
end function;

function IsGreaterThanTen(X: integer): boolean;
begin
  return X > 10;
end function;

function Sum(Acc: integer; V: integer): integer;
begin
  return Acc + V;
end function;

// Higher-order: accepts any integer->integer function

function Apply(F: function(X: integer): integer; Value: integer): integer;
begin
  return F(Value);
end function;

begin
  WriteLn('Apply(Square, 6) = ', Apply(Square, 6));
  const Op: function(X: integer): integer := Double;
  WriteLn('Op(7) = ', Op(7));
  const Nums: array of integer := [1, 2, 3, 4, 5];
  const Doubled: array of integer := Map(Nums, Double);
  WriteText('Map double: ');
  for V: integer in Doubled do
    begin
      WriteText(V, ' ');
    end;
  end for;

  WriteLn('');
  const Big: array of integer := Filter(Nums, IsGreaterThanThree);
  WriteText('Filter > 3: ');
  for V: integer in Big do
    begin
      WriteText(V, ' ');
    end;
  end for;

  WriteLn('');
  const Total: integer := Reduce(Nums, 0, Sum);
  WriteLn('Reduce sum: ', Total);
  const Squared: array of integer := Map(Nums, Square);
  const LargeSquares: array of integer := Filter(Squared, IsGreaterThanTen);
  WriteText('Squares > 10: ');
  for V: integer in LargeSquares do
    begin
      WriteText(V, ' ');
    end;
  end for;

  WriteLn('');
end.
