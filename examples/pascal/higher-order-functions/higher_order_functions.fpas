program HigherOrderFunctionsExample;

uses Std.Console as Console;
uses Std.Arrays as Arrays;

// First-class named functions

pure function Square(X: integer): integer;
begin
  return X * X;
end function;

pure function Double(X: integer): integer;
begin
  return X * 2;
end function;

pure function IsGreaterThanThree(X: integer): boolean;
begin
  return X > 3;
end function;

pure function IsGreaterThanTen(X: integer): boolean;
begin
  return X > 10;
end function;

pure function Sum(Acc: integer; V: integer): integer;
begin
  return Acc + V;
end function;

// Higher-order: accepts any integer->integer function

function Apply(F: function(X: integer): integer; Value: integer): integer;
begin
  return F(Value);
end function;

begin
  Console.WriteLn('Apply(Square, 6) = ', Apply(Square, 6));
  const Op: function(X: integer): integer := Double;
  Console.WriteLn('Op(7) = ', Op(7));
  const Nums: array of (integer) := [1, 2, 3, 4, 5];
  const Doubled: array of (integer) := Arrays.Map(Nums, Double);
  Console.WriteText('Map double: ');
  for V: integer in Doubled do
    begin
      Console.WriteText(V, ' ');
    end;
  end for;

  Console.WriteLn('');
  const Big: array of (integer) := Arrays.Filter(Nums, IsGreaterThanThree);
  Console.WriteText('Filter > 3: ');
  for V: integer in Big do
    begin
      Console.WriteText(V, ' ');
    end;
  end for;

  Console.WriteLn('');
  const Total: integer := Arrays.Reduce(Nums, 0, Sum);
  Console.WriteLn('Reduce sum: ', Total);
  const Squared: array of (integer) := Arrays.Map(Nums, Square);
  const LargeSquares: array of (integer) := Arrays.Filter(Squared, IsGreaterThanTen);
  Console.WriteText('Squares > 10: ');
  for V: integer in LargeSquares do
    begin
      Console.WriteText(V, ' ');
    end;
  end for;

  Console.WriteLn('');
end program;
