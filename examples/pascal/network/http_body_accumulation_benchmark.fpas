// Driven by the harness's local HTTP fixture; setup and compilation are not timed.
program HttpBodyAccumulationBenchmark;

uses Std.Args, Std.Arrays, Std.Console, Std.Conv, Std.Http, Std.Results, Std.Time;

begin
  if ParamCount() <> 3 then
    begin
      panic('expected ITERATIONS SIZE URL');
    end;
  end if;
  const Iterations: integer := StrToInt(ParamStr(0));
  const Size: integer := StrToInt(ParamStr(1));
  const Url: string := ParamStr(2);
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('arguments must be positive');
    end;
  end if;
  const Started: integer := MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      const ResponseValue: Response := Std.Results.Unwrap(Send(Request.Get(Url)));
      if Std.Arrays.Length(ResponseValue.Body) <> Size * 128 then
        begin
          panic('body length');
        end;
      end if;

      if ResponseValue.Body[Size * 128 - 1] <> 65 then
        begin
          panic('body data');
        end;
      end if;
    end;
  end for;

  WriteLn(('elapsed: ' + IntToStr(ElapsedMillis(Started))) + ' ms');
end.
