// Driven by the harness's local HTTP fixture; setup and compilation are not timed.
program HttpBodyAccumulationBenchmark;

uses Std.Args, Std.Array, Std.Console, Std.Conv, Std.Http, Std.Result, Std.Time;

begin
  if ParamCount() <> 3 then
  begin
    panic('expected ITERATIONS SIZE URL')
  end;
  var Iterations: integer := StrToInt(ParamStr(0));
  var Size: integer := StrToInt(ParamStr(1));
  var Url: string := ParamStr(2);
  if (Iterations < 1) or (Size < 1) then
  begin
    panic('arguments must be positive')
  end;
  var Started: integer := MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
  begin
    var ResponseValue: Response := Std.Result.Unwrap(Send(Request.Get(Url)));
    if Std.Array.Length(ResponseValue.Body) <> Size * 128 then
    begin
      panic('body length')
    end;

    if ResponseValue.Body[Size * 128 - 1] <> 65 then
    begin
      panic('body data')
    end
  end;

  WriteLn(('elapsed: ' + IntToStr(ElapsedMillis(Started))) + ' ms')
end.
