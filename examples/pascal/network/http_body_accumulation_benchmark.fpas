// Driven by the harness's local HTTP fixture; setup and compilation are not timed.
program HttpBodyAccumulationBenchmark;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Http as Http;
uses Std.Results as Results;
uses Std.Time as Time;

begin
  if Args.ParamCount() <> 3 then
    begin
      panic('expected ITERATIONS SIZE URL');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  var Size: integer := Conv.StrToInt(Args.ParamStr(1));
  var Url: string := Args.ParamStr(2);
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('arguments must be positive');
    end;
  end if;
  var Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      var ResponseValue: Http.Response := Results.Unwrap(Http.Send(Http.Request.Get(Url)));
      if Arrays.Length(ResponseValue.Body) <> Size * 128 then
        begin
          panic('body length');
        end;
      end if;

      if ResponseValue.Body[Size * 128 - 1] <> 65 then
        begin
          panic('body data');
        end;
      end if;
    end;
  end for;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started))) + ' ms');
end program;
