// Driven by the harness's local HTTP fixture; setup and compilation are not timed.
program HttpBodyAccumulationBenchmark;

uses
  Std.Args as Args, Std.Console as Console, Std.Conv as Conv, Std.Http as Http, Std.Time as Time,
  Std.Parse as Parse;

begin
  if Args.ParamCount() <> 3 then
    begin
      panic('expected ITERATIONS SIZE URL');
    end;
  end if;
  const Iterations: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  const Size: integer := Parse.Int(Args.ParamStr(1)).Unwrap();
  const Url: string := Args.ParamStr(2);
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('arguments must be positive');
    end;
  end if;
  const Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      const ResponseValue: Http.Response := Http.Send(Http.Request.Get(Url)).Unwrap();
      if ResponseValue.Body.Length() <> Size * 128 then
        begin
          panic('body length');
        end;
      end if;

      if ResponseValue.Body[Size * 128 - 1] <> 65 then
        begin
          panic('body data');
        end;
      end if;
    end;
  end for;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started)) + ' ms');
end.
