program ExhaustivenessExample;

uses Std.Console as Console, Std.Text.Format as Conv;

// Every enum variant must have a case arm unless an else branch is present.
type Light = enum
  Red;
  Yellow;
  Green;
end enum;

function TrafficAdvice(L: Light): string;
begin
  case L of
    when Light.Red:
      begin
        return 'Stop';
      end;
    when Light.Yellow:
      begin
        return 'Caution';
      end;
    when Light.Green:
      begin
        return 'Go';
      end;
  end case;
end function;

function SafeLookup(Items: array of integer; Target: integer): option of integer;
begin
  for I: integer := 0 to Items.Length() - 1 do
    begin
      if Items[I] = Target then
        begin
          return Some(I);
        end;
      end if;
    end;
  end for;

  return None;
end function;

begin
  Console.WriteLn('--- Enum exhaustiveness ---');
  Console.WriteLn(TrafficAdvice(Light.Red));
  Console.WriteLn(TrafficAdvice(Light.Yellow));
  Console.WriteLn(TrafficAdvice(Light.Green));
  Console.WriteLn('--- Option exhaustiveness ---');
  const Idx: option of integer := SafeLookup([10, 20, 30], 20);
  case Idx of
    when Some(const I):
      begin
        Console.WriteLn('Found at index ' + Conv.IntToStr(I));
      end;
    when None:
      begin
        Console.WriteLn('Not found');
      end;
  end case;

  Console.WriteLn('--- Result exhaustiveness ---');
  const R: result of (integer, string) := Ok(42);
  case R of
    when Ok(const V):
      begin
        Console.WriteLn('Value: ' + Conv.IntToStr(V));
      end;
    when Error(const E):
      begin
        Console.WriteLn('Error: ' + E);
      end;
  end case;
end.
