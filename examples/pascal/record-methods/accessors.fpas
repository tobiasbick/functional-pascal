program AccessorsExample;

uses Std.Console as Console, Std.Text.Format as Conv;

type Counter = record
  Base: integer;

  function GetBase(Self: Counter): integer;
  begin
    return Self.Base;
  end function;

  procedure SetBase(Self: Counter; Value: integer);
  begin
    Console.WriteLn('Setter received: ' + Conv.IntToStr(Value));
  end procedure;
end record;

begin
  const C: Counter := Counter(Base := 10);
  Console.WriteLn('Stored value: ' + Conv.IntToStr(C.GetBase()));
  // The setter receives Self by value, so this records the request but does not mutate C.
  C.SetBase(20);
  Console.WriteLn('Stored value after setter: ' + Conv.IntToStr(C.GetBase()));
end.
