program BoundMethodsExample;

uses Std.Console as Console, Std.Conv as Conv;

type Counter = record
  Base: integer;

  function Add(Self: Counter; Value: integer): integer;
  begin
    return Self.Base + Value;
  end function;

  procedure Show(Self: Counter);
  begin
    Console.WriteLn('Base: ' + Conv.IntToStr(Self.Base));
  end procedure;

  static function Make(Base: integer): Counter;
  begin
    return Counter(Base := Base);
  end function;
end record;

function Apply(F: function(Value: integer): integer; Value: integer): integer;
begin
  return F(Value);
end function;

begin
  var C: Counter := Counter(Base := 10);
  const AddTen: function(Value: integer): integer := C.Add;
  C := Counter(Base := 99);
  Console.WriteLn(Conv.IntToStr(AddTen(5)));
  Console.WriteLn(Conv.IntToStr(Apply(AddTen, 7)));
  const ShowBase: procedure() := Counter.Make(3).Show;
  ShowBase();
end.
