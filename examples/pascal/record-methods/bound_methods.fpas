program BoundMethodsExample;

uses Std.Console, Std.Conv;

type Counter = record
  Base: integer;

  function Add(Self: Counter; Value: integer): integer;
  begin
    return Self.Base + Value;
  end function;

  procedure Show(Self: Counter);
  begin
    WriteLn('Base: ' + IntToStr(Self.Base));
  end procedure;

  static function Make(Base: integer): Counter;
  begin
    return record
      Base := Base;
    end;
  end function;
end record;

function Apply(F: function(Value: integer): integer; Value: integer): integer;
begin
  return F(Value);
end function;

begin
  mutable var C: Counter := record
    Base := 10;
  end;
  var AddTen: function(Value: integer): integer := C.Add;
  C := record
    Base := 99;
  end;

  WriteLn(IntToStr(AddTen(5)));
  WriteLn(IntToStr(Apply(AddTen, 7)));
  var ShowBase: procedure() := Counter.Make(3).Show;
  ShowBase();
end.
