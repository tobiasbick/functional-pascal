program CounterExample;

uses Std.Console, Std.Conv;

type
  Counter = record
    Value: integer;
    Step: integer;

    function Increment(Self: Counter): Counter;
    begin
      var NewValue: integer := Self.Value + Self.Step;
      return record
        Value := NewValue;
        Step := Self.Step;
      end
    end;

    function Reset(Self: Counter): Counter;
    begin
      return record
        Value := 0;
        Step := Self.Step;
      end
    end;

    procedure Show(Self: Counter);
    begin
      WriteLn('Counter: ' + IntToStr(Self.Value))
    end;
  end;

begin
  var C: Counter := record
    Value := 0;
    Step := 5;
  end;
  C.Show();
  WriteLn('Counter: ' + IntToStr(C.Increment().Increment().Increment().Value));
  var Cleared: Counter := C.Increment().Increment().Reset();
  Cleared.Show()
end.
