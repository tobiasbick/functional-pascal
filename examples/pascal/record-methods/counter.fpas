program CounterExample;

uses Std.Console as Console;
uses Std.Conv as Conv;

type Counter = record
  Value: integer;
  Step: integer;

  function Increment(Self: Counter): Counter;
  begin
    var NewValue: integer := Self.Value + Self.Step;
    return record
      Value := NewValue;
      Step := Self.Step;
    end record;
  end function;

  function Reset(Self: Counter): Counter;
  begin
    return record
      Value := 0;
      Step := Self.Step;
    end record;
  end function;

  procedure Show(Self: Counter);
  begin
    Console.WriteLn('Counter: ' + Conv.IntToStr(Self.Value));
  end procedure;
end record;

begin
  var C: Counter := record
    Value := 0;
    Step := 5;
  end record;

  C.Show();
  Console.WriteLn('Counter: ' + Conv.IntToStr(C.Increment().Increment().Increment().Value));
  var Cleared: Counter := C.Increment().Increment().Reset();
  Cleared.Show();
end program;
