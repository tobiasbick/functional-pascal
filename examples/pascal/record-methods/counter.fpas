program CounterExample;

uses Std.Console as Console, Std.Text.Format as Conv;

type Counter = record
  Value: integer;
  Step: integer;

  function Increment(Self: Counter): Counter;
  begin
    const NewValue: integer := Self.Value + Self.Step;
    return Counter(Value := NewValue, Step := Self.Step);
  end function;

  function Reset(Self: Counter): Counter;
  begin
    return Counter(Value := 0, Step := Self.Step);
  end function;

  procedure Show(Self: Counter);
  begin
    Console.WriteLn('Counter: ' + Conv.IntToStr(Self.Value));
  end procedure;
end record;

begin
  const C: Counter := Counter(Value := 0, Step := 5);
  C.Show();
  Console.WriteLn('Counter: ' + Conv.IntToStr(C.Increment().Increment().Increment().Value));
  const Cleared: Counter := C.Increment().Increment().Reset();
  Cleared.Show();
end.
