program EventsExample;

uses Std.Console, Std.Conv;

type ClickHandler = procedure(Sender: integer);

type Button = record
  Id: integer;
  OnClick: option of ClickHandler := None;

  procedure Click(Self: Button);
  begin
    if Self.OnClick is Some(const Handler) then
      Handler(Self.Id);
    else
      WriteLn('no handler');
    end if;
  end procedure;
end record;

procedure HandleClick(Sender: integer);
begin
  WriteLn('clicked ' + IntToStr(Sender));
end procedure;

begin
  var B: Button := Button(Id := 1);
  B.Click();
  B.OnClick := Some(HandleClick);
  B.Click();
  B.OnClick := None;
  B.Click();
end.
