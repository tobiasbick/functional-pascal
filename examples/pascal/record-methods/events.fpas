program EventsExample;

uses Std.Console as Console, Std.Text.Format as Conv;

type ClickHandler = procedure(Sender: integer);

type Button = record
  Id: integer;
  OnClick: option of ClickHandler := None;

  procedure Click(Self: Button);
  begin
    case Self.OnClick of
      when Some(const Handler):
        Handler(Self.Id);
      when None:
        Console.WriteLn('no handler');
    end case;
  end procedure;
end record;

procedure HandleClick(Sender: integer);
begin
  Console.WriteLn('clicked ' + Conv.IntToStr(Sender));
end procedure;

begin
  var B: Button := Button(Id := 1);
  B.Click();
  B.OnClick := Some(HandleClick);
  B.Click();
  B.OnClick := None;
  B.Click();
end.
