program EventsExample;

uses Std.Console as Console;
uses Std.Conv as Conv;

// In-memory handler slot standing in for a live registry.
mutable var ClickSlot: Option of (procedure(Sender: integer)) := Option.None;

type ClickHandler = procedure(Sender: integer);

type Button = record
  Id: integer;

  function ReadOnClick(Self: Button): Option of (ClickHandler);
  begin
    return ClickSlot;
  end function;

  procedure WriteOnClick(Self: Button; Handler: Option of (ClickHandler));
  begin
    ClickSlot := Handler;
  end procedure;

  procedure Click(Self: Button);
  begin
    if Assigned(Self.OnClick) then
      begin
        Self.OnClick(Self.Id);
      end;
    else
      begin
        Console.WriteLn('no handler');
      end;
    end if;
  end procedure;

  event OnClick: ClickHandler read ReadOnClick write WriteOnClick;
end record;

procedure HandleClick(Sender: integer);
begin
  Console.WriteLn('clicked ' + Conv.IntToStr(Sender));
end procedure;

begin
  var B: Button := Button(Id := 1);
  B.Click();
  B.OnClick := HandleClick;
  B.Click();
  B.OnClick := nil;
  B.Click();
end program;
