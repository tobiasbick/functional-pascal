program PointExample;

uses Std.Console, Std.Conv;

type Point = record
  X: integer;
  Y: integer;

  function Sum(Self: Point): integer;
  begin
    return Self.X + Self.Y;
  end function;

  function Add(Self: Point; Other: Point): Point;
  begin
    const RX: integer := Self.X + Other.X;
    const RY: integer := Self.Y + Other.Y;
    return record
      X := RX;
      Y := RY;
    end;
  end function;

  procedure Print(Self: Point);
  begin
    WriteLn(((('(' + IntToStr(Self.X)) + ', ') + IntToStr(Self.Y)) + ')');
  end procedure;
end record;

begin
  const A: Point := record
    X := 3;
    Y := 4;
  end;
  const B: Point := record
    X := 10;
    Y := 20;
  end;

  A.Print();
  B.Print();
  WriteLn('Sum of A: ' + IntToStr(A.Sum()));
  const C: Point := A.Add(B);
  WriteLn('A + B =');
  C.Print();
end.
