program PointExample;

uses Std.Console as Console;
uses Std.Conv as Conv;

type Point = record
  X: integer;
  Y: integer;

  function Sum(Self: Point): integer;
  begin
    return Self.X + Self.Y;
  end function;

  function Add(Self: Point; Other: Point): Point;
  begin
    var RX: integer := Self.X + Other.X;
    var RY: integer := Self.Y + Other.Y;
    return Point(X := RX, Y := RY);
  end function;

  procedure Print(Self: Point);
  begin
    Console.WriteLn(((('(' + Conv.IntToStr(Self.X)) + ', ') + Conv.IntToStr(Self.Y)) + ')');
  end procedure;
end record;

begin
  var A: Point := Point(X := 3, Y := 4);
  var B: Point := Point(X := 10, Y := 20);
  A.Print();
  B.Print();
  Console.WriteLn('Sum of A: ' + Conv.IntToStr(A.Sum()));
  var C: Point := A.Add(B);
  Console.WriteLn('A + B =');
  C.Print();
end program;
