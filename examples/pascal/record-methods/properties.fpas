program PropertiesExample;

uses Std.Console as Console;
uses Std.Conv as Conv;

type Counter = record
  Base: integer;

  function GetBase(Self: Counter): integer;
  begin
    return Self.Base;
  end function;

  procedure SetBase(Self: Counter; Value: integer);
  begin
    Console.WriteLn('Setter received: ' + Conv.IntToStr(Value));
  end procedure;

  property Value: integer read GetBase write SetBase;
end record;

begin
  var C: Counter := Counter(Base := 10);
  Console.WriteLn('Stored value: ' + Conv.IntToStr(C.Value));
  // The setter receives Self by value, so this records the request but does not mutate C.
  C.Value := 20;
  Console.WriteLn('Stored value after setter: ' + Conv.IntToStr(C.Value));
end program;
