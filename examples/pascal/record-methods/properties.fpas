program PropertiesExample;

uses Std.Console, Std.Conv;

type
  Counter = record
    Base: integer;

    function GetBase(Self: Counter): integer;
    begin
      return Self.Base
    end;

    procedure SetBase(Self: Counter; Value: integer);
    begin
      WriteLn('Setter received: ' + IntToStr(Value))
    end;

    property Value: integer read GetBase write SetBase;
  end;

begin
  var C: Counter := record
    Base := 10;
  end;

  WriteLn('Stored value: ' + IntToStr(C.Value));
  { The setter receives Self by value, so this records the request but does not mutate C. }
  C.Value := 20;
  WriteLn('Stored value after setter: ' + IntToStr(C.Value))
end.
