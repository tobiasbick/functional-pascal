program RectangleExample;

uses Std.Console, Std.Conv;

type
  Rectangle = record
    W: integer;
    H: integer;

    function Area(Self: Rectangle): integer;
    begin
      return Self.W * Self.H
    end;

    function Perimeter(Self: Rectangle): integer;
    begin
      return 2 * (Self.W + Self.H)
    end;

    function IsSquare(Self: Rectangle): boolean;
    begin
      return Self.W = Self.H
    end;

    procedure Describe(Self: Rectangle);
    begin
      mutable var Kind: string := 'Rectangle';
      if Self.IsSquare() then
      begin
        Kind := 'Square'
      end;
      WriteLn((((((((Kind + ' ') + IntToStr(Self.W)) + 'x') + IntToStr(Self.H)) + ' area=') + IntToStr(Self.Area())) + ' perimeter=') +
              IntToStr(Self.Perimeter()))
    end;
  end;

begin
  var R: Rectangle := record W := 5; H := 3; end;
  R.Describe();
  var S: Rectangle := record W := 4; H := 4; end;
  S.Describe()
end.
