program TextAreaNavigationBenchmark;

uses
  Std.Args as Args, Std.Conv as Conv, Std.Time as Time, Std.Console as Console, Std.Test as Test,
  Std.Tui as Tui, Std.Parse as Parse;

type TextAreaModel = record
  Text: string;
  Caret: integer;
  Offset: Tui.TuiPoint;
end record;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Console.KeyEvent(
    kind := Kind,
    ch := Character,
    shift := false,
    ctrl := false,
    alt := false,
    meta := false
  );
end function;

function ViewTextArea(State: TextAreaModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(
    Some(Tui.TuiControlId.Create(1)), [
      Tui.TuiElementBuilders.MakeTextArea(
        Tui.TuiControlId.Create(1),
        State.Text,
        State.Caret,
        State.Offset,
        Tui.TuiAction.Create(9)
      )
    ]
  );
end function;

function UpdateTextArea(State: TextAreaModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): TextAreaModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(9, Action.Value);
        return TextAreaModel(Text := Text, Caret := Caret, Offset := Offset);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        return State;
      end;
  end case;
end function;

function Press(
  App: Tui.TuiApplication;
  State: TextAreaModel;
  Kind: Tui.TuiKeyKind;
  Character: string
): TextAreaModel;
begin
  App.InjectKeyForTest(MakeKey(Kind, Character));
  return App.RunIterations(State, UpdateTextArea, ViewTextArea, 1, 0);
end function;

begin
  const Size: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  const Mode: string := Args.ParamStr(1);
  var Text: string := 'x'.RepeatStr(Size) + #10 + 'x'.RepeatStr(Size);
  var Caret: integer := Size;
  if Mode = 'lines' then
    begin
      Text := ('short' + #10).RepeatStr(Size);
      Caret := Text.Length() - 7;
    end;
  end if;
  const Initial: TextAreaModel := TextAreaModel(
    Text := Text,
    Caret := Caret,
    Offset := Tui.TuiPoint.Create(0, 0)
  );
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 4));
  const Started: integer := Time.MonotonicMillis();
  for Pass: integer := 1 to 10 do
    begin
      const Moved: TextAreaModel := Press(App, Initial, Tui.TuiKeyKind.Down, '');
      if Moved.Caret <= Caret then
        begin
          panic('caret did not move');
        end;
      end if;
    end;
  end for;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started)) + ' ms');
  App.Close();
end.
