program TextAreaNavigationBenchmark;

uses Std.Args, Std.Conv, Std.Time, Std.Console, Std.Test, Std.Tui;

type TextAreaModel = record
  Text: string;
  Caret: integer;
  Offset: TuiPoint;
end record;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
end function;

function ViewTextArea(State: TextAreaModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakeTextArea(TuiControlId.Create(1), State.Text, State.Caret, State.Offset, TuiAction.Create(9))
                                                                      ]);
end function;

function UpdateTextArea(State: TextAreaModel; Msg: TuiMsg; Cmd: TuiCmdOutput): TextAreaModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.TextAreaChanged(Source, Action, Text, Caret, Offset):
      begin
        AssertEquals(1, Source.Value);
        AssertEquals(9, Action.Value);
        return record
          Text := Text;
          Caret := Caret;
          Offset := Offset;
        end;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function Press(App: TuiApplication; State: TextAreaModel; Kind: TuiKeyKind; Character: string): TextAreaModel;
begin
  App.InjectKeyForTest(MakeKey(Kind, Character));
  return App.RunIterations(State, UpdateTextArea, ViewTextArea, 1, 0);
end function;

begin
  const Size: integer := StrToInt(ParamStr(0));
  const Mode: string := ParamStr(1);
  var Text: string := ('x'.RepeatStr(Size) + #10) + 'x'.RepeatStr(Size);
  var Caret: integer := Size;
  if Mode = 'lines' then
    begin
      Text := ('short' + #10).RepeatStr(Size);
      Caret := Text.Length() - 7;
    end;
  end if;
  const Initial: TextAreaModel := record
    Text := Text;
    Caret := Caret;
    Offset := TuiPoint.Create(0, 0);
  end;
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 4));
  const Started: integer := MonotonicMillis();
  for Pass: integer := 1 to 10 do
    begin
      const Moved: TextAreaModel := Press(App, Initial, TuiKeyKind.Down, '');
      if Moved.Caret <= Caret then
        begin
          panic('caret did not move');
        end;
      end if;
    end;
  end for;

  WriteLn(('elapsed: ' + IntToStr(ElapsedMillis(Started))) + ' ms');
  App.Close();
end.
