program TextAreaNavigationBenchmark;

uses Std.Args as Args;
uses Std.Conv as Conv;
uses Std.Time as Time;
uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type TextAreaModel = record
  Text: string;
  Caret: integer;
  Offset: Tui.TuiPoint;
end record;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end record;
end function;

function ViewTextArea(State: TextAreaModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(1)), [
                                                                                Tui.TuiElementBuilders.MakeTextArea(Tui.TuiControlId.Create(1), State.Text, State.Caret, State.Offset, Tui.TuiAction.Create(9))
                                                                              ]);
end function;

function UpdateTextArea(State: TextAreaModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): TextAreaModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.TextAreaChanged(Source, Action, Text, Caret, Offset):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(9, Action.Value);
        return record
          Text := Text;
          Caret := Caret;
          Offset := Offset;
        end record;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function Press(
  App: Tui.TuiApplication;
  State: TextAreaModel;
  Kind: Tui.TuiKeyKind;
  Character: string
): TextAreaModel;
begin
  App.InjectKeyForTest(MakeKey(Kind, Character));
  return App.RunIterations(State, UpdateTextArea, ViewTextArea, 1, 0);
end function;

begin
  var Size: integer := Conv.StrToInt(Args.ParamStr(0));
  var Mode: string := Args.ParamStr(1);
  mutable var Text: string := (Str.RepeatStr('x', Size) + #10) + Str.RepeatStr('x', Size);
  mutable var Caret: integer := Size;
  if Mode = 'lines' then
    begin
      Text := Str.RepeatStr('short' + #10, Size);
      Caret := Str.Length(Text) - 7;
    end;
  end if;
  var Initial: TextAreaModel := record
    Text := Text;
    Caret := Caret;
    Offset := Tui.TuiPoint.Create(0, 0);
  end record;
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 4));
  var Started: integer := Time.MonotonicMillis();
  for Pass: integer := 1 to 10 do
    begin
      var Moved: TextAreaModel := Press(App, Initial, Tui.TuiKeyKind.Down, '');
      if Moved.Caret <= Caret then
        begin
          panic('caret did not move');
        end;
      end if;
    end;
  end for;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started))) + ' ms');
  App.Close();
end program;
