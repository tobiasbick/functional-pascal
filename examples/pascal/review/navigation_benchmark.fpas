program TextAreaNavigationBenchmark;

uses Std.Args as Args;
uses Std.Conv as Conv;
uses Std.Time as Time;
uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type TextAreaModel = record
  Text: string;
  Caret: integer;
  Offset: Tui.TuiPoint;
end record;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Console.keyevent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewTextArea(State: TextAreaModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(1), State.Text, State.Caret, State.Offset, Ids.TuiActionCreate(9))
                                                                                ]);
end function;

function UpdateTextArea(State: TextAreaModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): TextAreaModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(9, Action.Value);
        return TextAreaModel(Text := Text, Caret := Caret, Offset := Offset);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function Press(
  App: Tui.TuiApplication;
  State: TextAreaModel;
  Kind: Tui.TuiKeyKind;
  Character: string
): TextAreaModel;
begin
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Kind, Character));
  return Runtime.TuiApplicationRunIterations(App, State, UpdateTextArea, ViewTextArea, 1, 0);
end function;

begin
  const Size: integer := Conv.StrToInt(Args.ParamStr(0));
  const Mode: string := Args.ParamStr(1);
  var Text: string := (Str.RepeatStr('x', Size) + #10) + Str.RepeatStr('x', Size);
  var Caret: integer := Size;
  if Mode = 'lines' then
    begin
      Text := Str.RepeatStr('short' + #10, Size);
      Caret := Str.Length(Text) - 7;
    end;
  end if;
  const Initial: TextAreaModel := TextAreaModel(Text := Text, Caret := Caret, Offset := Geometry.TuiPointCreate(0, 0));
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(20, 4));
  const Started: integer := Time.MonotonicMillis();
  for Pass: integer := 1 to 10 do
    begin
      const Moved: TextAreaModel := Press(App, Initial, Tui.TuiKeyKind.Down, '');
      if Moved.Caret <= Caret then
        begin
          panic('caret did not move');
        end;
      end if;
    end;
  end for;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started))) + ' ms');
  Runtime.TuiApplicationClose(App);
end program;
