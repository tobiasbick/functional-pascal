// Targeted source-library workloads; input creation is outside the timer.
program SourceReviewBenchmark;

uses Notes.Model as Model;
uses Notes.Repository as Repository;
uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Net.Utf8 as Utf8;
uses Std.Str as Str;
uses Std.Time as Time;
uses Std.Tui as Tui;

function View(Value: integer): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeEmpty();
end function;

function Update(Value: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  case Msg of
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return Value + Delta;
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return Value;
        end;
      end;
  end case;
end function;

begin
  var Mode: string := Args.ParamStr(0);
  var Size: integer := Conv.StrToInt(Args.ParamStr(1));
  var Text: string := Str.RepeatStr(Args.ParamStr(2), Size);
  mutable var Notes: array of (Model.Note) := [];
  for I: integer := 1 to Size do
    begin
      Arrays.Push(Notes, Model.NoteCreate(Conv.IntToStr(I), I));
    end;
  end for;
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(1, 1));
  mutable var Sum: integer := 0;
  var Started: integer := Time.MonotonicMillis();
  for Pass: integer := 1 to 10 do
    begin
      if Mode = 'utf8' then
        begin
          case Utf8.Decode(Utf8.Encode(Text)) of
            when Result.Ok(const Decoded):
              begin
                if Decoded <> Text then
                  begin
                    panic('roundtrip');
                  end;
                end if;
              end;
            when Result.Error(const Message):
              begin
                panic(Message);
              end;
          end case;
        end;
      else
        if Mode = 'notes' then
          begin
            var Sorted: array of (Model.Note) := Repository.NotesSort(Notes);
            if Sorted[0].UpdatedMillis <> Size then
              begin
                panic('sort');
              end;
            end if;
          end;
        else
          if Mode = 'queue' then
            begin
              for I: integer := 1 to Size do
                begin
                  App.Inject(Tui.TuiMsg.Tick(1));
                end;
              end for;

              Sum := App.RunIterations(0, Update, View, Size, 0);
              if Sum <> Size then
                begin
                  panic('queue');
                end;
              end if;
            end;
          else
            begin
              panic('unknown mode');
            end;
          end if;
        end if;
      end if;
    end;
  end for;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started))) + ' ms');
  App.Close();
end program;
