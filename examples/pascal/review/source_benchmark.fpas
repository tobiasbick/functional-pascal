// Targeted source-library workloads; input creation is outside the timer.
program SourceReviewBenchmark;

uses
  Notes.Model as Model, Notes.Repository as Repository, Std.Os.Args as Args, Std.Console as Console,
  Std.Text.Format as Conv, Std.Text.Utf8 as Utf8, Std.Time as Time, Std.Ui.Terminal as Tui, Std.Text.Parse as Parse;

function View(Value: integer): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeEmpty();
end function;

function Update(Value: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  case Msg of
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return Value + Delta;
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        return Value;
      end;
  end case;
end function;

begin
  const Mode: string := Args.ParamStr(0);
  const Size: integer := Parse.Int(Args.ParamStr(1)).Unwrap();
  const Text: string := Args.ParamStr(2).RepeatStr(Size);
  var Notes: array of Model.Note := [];
  for I: integer := 1 to Size do
    begin
      Notes.PushInPlace(Model.NoteCreate(Conv.IntToStr(I), I));
    end;
  end for;
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(1, 1));
  var Sum: integer := 0;
  const Started: integer := Time.MonotonicMillis();
  for Pass: integer := 1 to 10 do
    begin
      if Mode = 'utf8' then
        begin
          case Utf8.Decode(Utf8.Encode(Text)) of
            when Ok(const Decoded):
              begin
                if Decoded <> Text then
                  begin
                    panic('roundtrip');
                  end;
                end if;
              end;
            when Error(const Message):
              begin
                panic(Message.Message());
              end;
          end case;
        end;
      elsif Mode = 'notes' then
        begin
          const Sorted: array of Model.Note := Repository.NotesSort(Notes);
          if Sorted[0].UpdatedMillis <> Size then
            begin
              panic('sort');
            end;
          end if;
        end;
      elsif Mode = 'queue' then
        begin
          for I: integer := 1 to Size do
            begin
              App.Inject(Tui.TuiMsg.Tick(1));
            end;
          end for;

          Sum := App.RunIterations(0, Update, View, Size, 0);
          if Sum <> Size then
            begin
              panic('queue');
            end;
          end if;
        end;
      else
        begin
          panic('unknown mode');
        end;
      end if;
    end;
  end for;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started)) + ' ms');
  App.Close();
end.
