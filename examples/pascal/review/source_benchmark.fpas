// Targeted source-library workloads; input creation is outside the timer.
program SourceReviewBenchmark;

uses
  Notes.Model, Notes.Repository, Std.Args, Std.Arrays, Std.Console, Std.Conv, Std.Net.Utf8, Std.Str,
  Std.Time, Std.Tui;

function View(Value: integer): TuiElement;
begin
  return TuiElementBuilders.MakeEmpty()
end;

function Update(Value: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  case Msg of
    TuiMsg.Tick(Delta):
    begin
      return Value + Delta
    end
    else
    begin
      return Value
    end
  end
end;

begin
  var Mode: string := ParamStr(0);
  var Size: integer := StrToInt(ParamStr(1));
  var Text: string := Std.Str.RepeatStr(ParamStr(2), Size);
  mutable var Notes: array of Note := [];
  for I: integer := 1 to Size do
  begin
    Std.Arrays.Push(Notes, NoteCreate(IntToStr(I), I))
  end;
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(1, 1));
  mutable var Sum: integer := 0;
  var Started: integer := MonotonicMillis();
  for Pass: integer := 1 to 10 do
  begin
    if Mode = 'utf8' then
    begin
      case Std.Net.Utf8.Decode(Std.Net.Utf8.Encode(Text)) of
        Ok(Decoded):
        begin
          if Decoded <> Text then
          begin
            panic('roundtrip')
          end
        end;
        Error(Message):
        begin
          panic(Message)
        end
      end
    end
    else if Mode = 'notes' then
    begin
      var Sorted: array of Note := NotesSort(Notes);
      if Sorted[0].UpdatedMillis <> Size then
      begin
        panic('sort')
      end
    end
    else if Mode = 'queue' then
    begin
      for I: integer := 1 to Size do
      begin
        App.Inject(TuiMsg.Tick(1))
      end;

      Sum := App.RunIterations(0, Update, View, Size, 0);
      if Sum <> Size then
      begin
        panic('queue')
      end
    end
    else
    begin
      panic('unknown mode')
    end
  end;

  WriteLn(('elapsed: ' + IntToStr(ElapsedMillis(Started))) + ' ms');
  App.Close()
end.
