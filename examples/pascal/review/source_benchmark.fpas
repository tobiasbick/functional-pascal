// Targeted source-library workloads; input creation is outside the timer.
program SourceReviewBenchmark;

uses
  Notes.Model, Notes.Repository, Std.Args, Std.Console, Std.Conv, Std.Net.Utf8, Std.Time, Std.Tui;

function View(Value: integer): TuiElement;
begin
  return TuiElementBuilders.MakeEmpty();
end function;

function Update(Value: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  case Msg of
    when TuiMsg.Tick(const Delta):
      begin
        return Value + Delta;
      end;
    else
      begin
        return Value;
      end;
  end case;
end function;

begin
  const Mode: string := ParamStr(0);
  const Size: integer := StrToInt(ParamStr(1));
  const Text: string := ParamStr(2).RepeatStr(Size);
  var Notes: array of Note := [];
  for I: integer := 1 to Size do
    begin
      Notes.Push(NoteCreate(IntToStr(I), I));
    end;
  end for;
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(1, 1));
  var Sum: integer := 0;
  const Started: integer := MonotonicMillis();
  for Pass: integer := 1 to 10 do
    begin
      if Mode = 'utf8' then
        begin
          case Std.Net.Utf8.Decode(Std.Net.Utf8.Encode(Text)) of
            when Ok(const Decoded):
              begin
                if Decoded <> Text then
                  begin
                    panic('roundtrip');
                  end;
                end if;
              end;
            when Error(const Message):
              begin
                panic(Message);
              end;
          end case;
        end;
      elsif Mode = 'notes' then
        begin
          const Sorted: array of Note := NotesSort(Notes);
          if Sorted[0].UpdatedMillis <> Size then
            begin
              panic('sort');
            end;
          end if;
        end;
      elsif Mode = 'queue' then
        begin
          for I: integer := 1 to Size do
            begin
              App.Inject(TuiMsg.Tick(1));
            end;
          end for;

          Sum := App.RunIterations(0, Update, View, Size, 0);
          if Sum <> Size then
            begin
              panic('queue');
            end;
          end if;
        end;
      else
        begin
          panic('unknown mode');
        end;
      end if;
    end;
  end for;

  WriteLn(('elapsed: ' + IntToStr(ElapsedMillis(Started))) + ' ms');
  App.Close();
end.
