// Run: fpas run examples/pascal/std/args_basics.fpas -- alpha beta

program ArgsBasics;

uses Std.Console as Console, Std.Conv as Conv, Std.Args as Args;

begin
  Console.WriteLn('param count: ', Conv.IntToStr(Args.ParamCount()));
  for I: integer := 0 to Args.ParamCount() - 1 do
    begin
      Console.WriteLn('  [', Conv.IntToStr(I), '] ', Args.ParamStr(I));
    end;
  end for;
end.
