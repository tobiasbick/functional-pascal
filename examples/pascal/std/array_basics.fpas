// Spec: docs/pascal/language/types/array/README.md (from repository root).

program ArrayBasics;

uses Std.Console as Console, Std.Text.Format as Conv;

function IsEven(X: integer): boolean;
begin
  return (X mod 2) = 0;
end function;

function IsPositive(V: integer): boolean;
begin
  return V > 0;
end function;

begin
  const Nums: array of integer := [3, 1, 4, 1, 5];
  Console.WriteLn('length: ', Conv.IntToStr(Nums.Length()));
  case Nums.Sort().IndexOf(4) of
    when Some(const Index):
      Console.WriteLn('sorted index: ', Conv.IntToStr(Index));
    when None:
      Console.WriteLn('value absent');
  end case;

  Console.WriteLn('any even: ', Nums.Any(IsEven));
  Console.WriteLn('all positive: ', Nums.All(IsPositive));
end.
