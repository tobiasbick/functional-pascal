// Spec: docs/pascal/std/collections/array/README.md (from repository root).

program ArrayBasics;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Arrays as Arrays;

function IsEven(X: integer): boolean;
begin
  return (X mod 2) = 0;
end function;

function IsPositive(V: integer): boolean;
begin
  return V > 0;
end function;

begin
  var Nums: array of (integer) := [3, 1, 4, 1, 5];
  Console.WriteLn('length: ', Conv.IntToStr(Arrays.Length(Nums)));
  Console.WriteLn('sorted: ', Conv.IntToStr(Arrays.IndexOf(Arrays.Sort(Nums), 4)));
  Console.WriteLn('any even: ', Arrays.Any(Nums, IsEven));
  Console.WriteLn('all positive: ', Arrays.All(Nums, IsPositive));
end program;
