// Spec: docs/pascal/std/collections/array/README.md (from repository root).

program ArrayBasics;

uses Std.Console as Console, Std.Conv as Conv;

function IsEven(X: integer): boolean;
begin
  return (X mod 2) = 0;
end function;

function IsPositive(V: integer): boolean;
begin
  return V > 0;
end function;

begin
  const Nums: array of integer := [3, 1, 4, 1, 5];
  Console.WriteLn('length: ', Conv.IntToStr(Nums.Length()));
  Console.WriteLn('sorted: ', Conv.IntToStr(Nums.Sort().IndexOf(4)));
  Console.WriteLn('any even: ', Nums.Any(IsEven));
  Console.WriteLn('all positive: ', Nums.All(IsPositive));
end.
