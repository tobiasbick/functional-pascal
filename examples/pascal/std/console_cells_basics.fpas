// Spec: docs/pascal/std/console/cells-frames.md (from repository root).

program ConsoleCellsBasics;

uses Std.Console as Console;
uses Std.Options as Options;

begin
  var Bounds: Console.Rect := record
    x := 1;
    y := 1;
    width := 6;
    height := 1;
  end record;
  var Underlay: Console.SavedRegion := Console.SaveRegion(Bounds);
  Console.BeginFrame();
  Console.FillRect(Bounds, record
    glyph := ' ';
    foreground := Console.CrtColor(Console.White);
    background := Console.Ansi256Color(24);
  end record);
  var First: Console.Cell := record
    glyph := 'O';
    foreground := Console.RgbColor(255, 220, 120);
    background := Console.Ansi256Color(24);
  end record;
  var Second: Console.Cell := record
    glyph := 'K';
    foreground := Console.RgbColor(156, 204, 255);
    background := Console.Ansi256Color(24);
  end record;
  var LabelCells: array of Console.Cell := [First, Second];
  Console.WriteCells(2, 1, LabelCells);
  var ReadBack: option of Console.Cell := Console.GetCell(2, 1);
  Console.Present();
  Console.BeginFrame();
  Console.RestoreRegion(Underlay);
  Console.Present();
  case ReadBack of
    when Some(Value):
      begin
        Console.WriteLn('ReadText back: ' + Value.glyph);
      end;
    when None:
      begin
        Console.WriteLn('No cell');
      end;
  end case;
end program;
