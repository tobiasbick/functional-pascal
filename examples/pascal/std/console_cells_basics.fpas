// Spec: docs/pascal/std/console/cells-frames.md (from repository root).

program ConsoleCellsBasics;

uses Std.Console;

begin
  const Bounds: Rect := record
    x := 1;
    y := 1;
    width := 6;
    height := 1;
  end;
  const Underlay: SavedRegion := SaveRegion(Bounds);
  BeginFrame();
  FillRect(Bounds, record
    glyph := ' ';
    foreground := CrtColor(White);
    background := Ansi256Color(24);
  end);
  const First: Cell := record
    glyph := 'O';
    foreground := RgbColor(255, 220, 120);
    background := Ansi256Color(24);
  end;
  const Second: Cell := record
    glyph := 'K';
    foreground := RgbColor(156, 204, 255);
    background := Ansi256Color(24);
  end;
  const LabelCells: array of Cell := [First, Second];
  WriteCells(2, 1, LabelCells);
  const ReadBack: option of Cell := GetCell(2, 1);
  Present();
  BeginFrame();
  RestoreRegion(Underlay);
  Present();
  case ReadBack of
    when Some(Value):
      begin
        WriteLn('ReadText back: ' + Value.glyph);
      end;
    when None:
      begin
        WriteLn('No cell');
      end;
  end case;
end.
