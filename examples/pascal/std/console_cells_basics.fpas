// Spec: docs/pascal/std/console/cells-frames.md (from repository root).

program ConsoleCellsBasics;

uses Std.Console as Console;

begin
  const Bounds: Console.Rect := Console.Rect(x := 1, y := 1, width := 6, height := 1);
  const Underlay: Console.SavedRegion := Console.SaveRegion(Bounds);
  Console.BeginFrame();
  Console.FillRect(Bounds, Console.Cell(glyph := ' ', foreground := Console.CrtColor(Console.White), background := Console.Ansi256Color(24)));
  const First: Console.Cell := Console.Cell(glyph := 'O', foreground := Console.RgbColor(255, 220, 120), background := Console.Ansi256Color(24));
  const Second: Console.Cell := Console.Cell(glyph := 'K', foreground := Console.RgbColor(156, 204, 255), background := Console.Ansi256Color(24));
  const LabelCells: array of Console.Cell := [First, Second];
  Console.WriteCells(2, 1, LabelCells);
  const ReadBack: option of Console.Cell := Console.GetCell(2, 1);
  Console.Present();
  Console.BeginFrame();
  Console.RestoreRegion(Underlay);
  Console.Present();
  case ReadBack of
    when Some(const Value):
      begin
        Console.WriteLn('ReadText back: ' + Value.glyph);
      end;
    when None:
      begin
        Console.WriteLn('No cell');
      end;
  end case;
end.
