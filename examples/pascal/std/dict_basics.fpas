// Spec: docs/pascal/std/collections/dict.md (from repository root).

program DictBasics;

uses Std.Console, Std.Conv, Std.Dictionaries, Std.Options, Std.Arrays;

function DoubleScore(V: integer): integer;
begin
  return V * 2
end;

function IsHighScore(K: string; V: integer): boolean;
begin
  return V >= 90
end;

function SumScores(Acc: integer; Key: string; Value: integer): integer;
begin
  return Acc + Value
end;

begin
  var Scores: dict of string to integer := ['Ada': 95, 'Bob': 72, 'Cara': 91];
  WriteLn('length: ', IntToStr(Std.Dictionaries.Length(Scores)));
  WriteLn('has Ada: ', ContainsKey(Scores, 'Ada'));
  var Merged: dict of string to integer := Merge(Scores, ['Bob': 88, 'Dan': 70]);
  WriteLn('merged Bob: ', IntToStr(Merged['Bob']));
  case Get(Merged, 'Eve') of
    Some(V):
    begin
      WriteLn('unexpected Eve: ', IntToStr(V))
    end;
    None:
    begin
      WriteLn('get missing: none (ok)')
    end
  end;
  var Doubled: dict of string to integer := Std.Dictionaries.Map(Merged, DoubleScore);
  WriteLn('map Ada doubled: ', IntToStr(Doubled['Ada']));
  var Top: dict of string to integer := Std.Dictionaries.Filter(Merged, IsHighScore);
  WriteLn('filter len: ', IntToStr(Std.Dictionaries.Length(Top)));
  var Ks: array of string := Keys(Top);
  WriteLn('keys array len: ', IntToStr(Std.Arrays.Length(Ks)));
  WriteLn('score total: ', IntToStr(Std.Dictionaries.Reduce(Scores, 0, SumScores)))
end.
