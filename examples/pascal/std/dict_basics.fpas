// Spec: docs/pascal/std/collections/dict.md (from repository root).

program DictBasics;

uses Std.Console, Std.Conv;

function DoubleScore(V: integer): integer;
begin
  return V * 2;
end function;

function IsHighScore(K: string; V: integer): boolean;
begin
  return V >= 90;
end function;

function SumScores(Acc: integer; Key: string; Value: integer): integer;
begin
  return Acc + Value;
end function;

begin
  const Scores: dict of string to integer := ['Ada': 95, 'Bob': 72, 'Cara': 91];
  WriteLn('length: ', IntToStr(Scores.Length()));
  WriteLn('has Ada: ', Scores.ContainsKey('Ada'));
  const Merged: dict of string to integer := Scores.Merge(['Bob': 88, 'Dan': 70]);
  WriteLn('merged Bob: ', IntToStr(Merged['Bob']));
  case Merged.Get('Eve') of
    when Some(const V):
      begin
        WriteLn('unexpected Eve: ', IntToStr(V));
      end;
    when None:
      begin
        WriteLn('get missing: none (ok)');
      end;
  end case;
  const Doubled: dict of string to integer := Merged.Map(DoubleScore);
  WriteLn('map Ada doubled: ', IntToStr(Doubled['Ada']));
  const Top: dict of string to integer := Merged.Filter(IsHighScore);
  WriteLn('filter len: ', IntToStr(Top.Length()));
  const Ks: array of string := Top.Keys();
  WriteLn('keys array len: ', IntToStr(Ks.Length()));
  WriteLn('score total: ', IntToStr(Scores.Reduce(0, SumScores)));
end.
