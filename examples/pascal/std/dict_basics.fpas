// Spec: docs/pascal/std/collections/dict.md (from repository root).

program DictBasics;

uses Std.Console as Console, Std.Conv as Conv;

function DoubleScore(V: integer): integer;
begin
  return V * 2;
end function;

function IsHighScore(K: string; V: integer): boolean;
begin
  return V >= 90;
end function;

function SumScores(Acc: integer; Key: string; Value: integer): integer;
begin
  return Acc + Value;
end function;

begin
  const Scores: dict of string to integer := ['Ada': 95, 'Bob': 72, 'Cara': 91];
  Console.WriteLn('length: ', Conv.IntToStr(Scores.Length()));
  Console.WriteLn('has Ada: ', Scores.ContainsKey('Ada'));
  const Merged: dict of string to integer := Scores.Merge(['Bob': 88, 'Dan': 70]);
  Console.WriteLn('merged Bob: ', Conv.IntToStr(Merged['Bob']));
  case Merged.Get('Eve') of
    when Some(const V):
      begin
        Console.WriteLn('unexpected Eve: ', Conv.IntToStr(V));
      end;
    when None:
      begin
        Console.WriteLn('get missing: none (ok)');
      end;
  end case;
  const Doubled: dict of string to integer := Merged.Map(DoubleScore);
  Console.WriteLn('map Ada doubled: ', Conv.IntToStr(Doubled['Ada']));
  const Top: dict of string to integer := Merged.Filter(IsHighScore);
  Console.WriteLn('filter len: ', Conv.IntToStr(Top.Length()));
  const Ks: array of string := Top.Keys();
  Console.WriteLn('keys array len: ', Conv.IntToStr(Ks.Length()));
  Console.WriteLn('score total: ', Conv.IntToStr(Scores.Reduce(0, SumScores)));
end.
