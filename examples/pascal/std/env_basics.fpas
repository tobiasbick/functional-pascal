// Spec: docs/pascal/std/host/env.md (from repository root).

program EnvBasics;

uses Std.Console, Std.Env;

begin
  WriteLn('PATH set: ', Exists('PATH'));
  case Get('PATH') of
    when Some(_):
      begin
        WriteLn('PATH lookup: some');
      end;
    when None:
      begin
        WriteLn('PATH lookup: none');
      end;
  end case;
end.
