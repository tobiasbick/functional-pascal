// Spec: docs/pascal/std/host/env.md (from repository root).

program EnvBasics;

uses Std.Console as Console;
uses Std.Env as Env;
uses Std.Options as Options;

begin
  Console.WriteLn('PATH set: ', Env.Exists('PATH'));
  case Env.Get('PATH') of
    when Some(_):
      begin
        Console.WriteLn('PATH lookup: some');
      end;
    when None:
      begin
        Console.WriteLn('PATH lookup: none');
      end;
  end case;
end program;
