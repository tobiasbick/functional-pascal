{ Spec: docs/pascal/std/env.md (from repository root). }
program EnvBasics;
uses Std.Console, Std.Env, Std.Option;
begin
  var MissingName: string := 'FPAS_EXAMPLE_MISSING_ENV_7E3B9C1A';
  var MissingValue: Option of string := Get(MissingName);
  WriteLn('missing exists: ', Exists(MissingName));
  WriteLn('missing is none: ', Std.Option.IsNone(MissingValue))
end.
