// Spec: docs/pascal/std/host/fs.md — writes under .temp-data/ (gitignored scratch).

program FsBasics;

uses Std.Console, Std.Fs;

const Scratch: string := '.temp-data';
const DemoPath: string := Scratch + '/_fpas_fs_demo.txt';

begin
  if not Exists(Scratch) then
    begin
      case CreateDir(Scratch) of
        when Ok(_):
          begin
          end;
        when Error(M):
          begin
            WriteLn('create scratch error: ', M);
            return;
          end;
      end case;
    end;
  end if;

  case Std.Fs.WriteText(DemoPath, 'hello from Std.Fs') of
    when Ok(_):
      begin
        WriteLn('write: ok');
      end;
    when Error(M):
      begin
        WriteLn('write error: ', M);
      end;
  end case;

  case Std.Fs.ReadText(DemoPath) of
    when Ok(Text):
      begin
        WriteLn('read: ', Text);
      end;
    when Error(M):
      begin
        WriteLn('read error: ', M);
      end;
  end case;

  WriteLn('exists: ', Exists(DemoPath));
  WriteLn('isFile: ', IsFile(DemoPath));
end.
