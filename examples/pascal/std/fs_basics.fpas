// Spec: docs/pascal/std/host/fs.md — writes under .temp-data/ (gitignored scratch).

program FsBasics;

uses Std.Console as Console;
uses Std.Fs as Fs;
uses Std.Results as Results;

const Scratch: string := '.temp-data';
const DemoPath: string := Scratch + '/_fpas_fs_demo.txt';

begin
  if not Fs.Exists(Scratch) then
    begin
      case Fs.CreateDir(Scratch) of
        when Result.Ok(_):
          begin
            null;
          end;
        when Result.Error(const M):
          begin
            Console.WriteLn('create scratch error: ', M);
            return;
          end;
      end case;
    end;
  end if;

  case Fs.WriteText(DemoPath, 'hello from Std.Fs') of
    when Result.Ok(_):
      begin
        Console.WriteLn('write: ok');
      end;
    when Result.Error(const M):
      begin
        Console.WriteLn('write error: ', M);
      end;
  end case;

  case Fs.ReadText(DemoPath) of
    when Result.Ok(const Text):
      begin
        Console.WriteLn('read: ', Text);
      end;
    when Result.Error(const M):
      begin
        Console.WriteLn('read error: ', M);
      end;
  end case;

  Console.WriteLn('exists: ', Fs.Exists(DemoPath));
  Console.WriteLn('isFile: ', Fs.IsFile(DemoPath));
end program;
