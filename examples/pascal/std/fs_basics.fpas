// Spec: docs/pascal/std/host/fs.md — writes under .temp-data/ (gitignored scratch).

program FsBasics;

uses Std.Console, Std.Fs, Std.Result;

const
  Scratch: string := '.temp-data';
  DemoPath: string := Scratch + '/_fpas_fs_demo.txt';

begin
  if not Exists(Scratch) then
  begin
    case CreateDir(Scratch) of
      Ok(_):
      begin
      end;
      Error(M):
      begin
        WriteLn('create scratch error: ', M);
        return
      end
    end
  end;

  case WriteText(DemoPath, 'hello from Std.Fs') of
    Ok(_):
    begin
      WriteLn('write: ok')
    end;
    Error(M):
    begin
      WriteLn('write error: ', M)
    end
  end;

  case ReadText(DemoPath) of
    Ok(Text):
    begin
      WriteLn('read: ', Text)
    end;
    Error(M):
    begin
      WriteLn('read error: ', M)
    end
  end;

  WriteLn('exists: ', Exists(DemoPath));
  WriteLn('isFile: ', IsFile(DemoPath))
end.
