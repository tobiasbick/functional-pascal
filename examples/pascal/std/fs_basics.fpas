{ Spec: docs/pascal/std/fs.md — writes ./_fpas_fs_demo.txt in the working directory. }
program FsBasics;
uses Std.Console, Std.Fs, Std.Result;

const
  DemoPath: string := '_fpas_fs_demo.txt';

begin
  case WriteText(DemoPath, 'hello from Std.Fs') of
    Ok(_): WriteLn('write: ok');
    Error(M): WriteLn('write error: ', M)
  end;

  case ReadText(DemoPath) of
    Ok(Text): WriteLn('read: ', Text);
    Error(M): WriteLn('read error: ', M)
  end;

  WriteLn('exists: ', Exists(DemoPath));
  WriteLn('isFile: ', IsFile(DemoPath))
end.
