program JsonBasics;

uses Std.Console, Std.Json, Std.Dictionaries, Std.Options, Std.Arrays, Std.Conv;

begin
  var Parsed: result of JsonValue, string := Parse('{"name":"Ada","scores":[10,20],"active":true}');
  case Parsed of
    when Ok(Value):
      begin
        case Value of
          when JsonValue.Object(Fields):
            begin
              var NameValue: option of JsonValue := Std.Dictionaries.Get(Fields, 'name');
              var ScoresValue: option of JsonValue := Std.Dictionaries.Get(Fields, 'scores');
              case Unwrap(NameValue) of
                when JsonValue.String(Name):
                  begin
                    WriteLn('name = ' + Name);
                  end;
                else
                  begin
                    WriteLn('missing name');
                  end;
              end case;

              case Unwrap(ScoresValue) of
                when JsonValue.ArrayValue(Scores):
                  begin
                    WriteLn('scores = ' + IntToStr(Std.Arrays.Length(Scores)));
                  end;
                else
                  begin
                    WriteLn('missing scores');
                  end;
              end case;

              WriteLn(Stringify(Value));
            end;
          else
            begin
              WriteLn('expected object');
            end;
        end case;
      end;
    when Error(Message):
      begin
        WriteLn('JSON error: ' + Message);
      end;
  end case;
end.
