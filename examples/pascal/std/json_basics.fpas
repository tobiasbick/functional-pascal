program JsonBasics;

uses Std.Console as Console, Std.Json as Json, Std.Conv as Conv;

begin
  const Parsed: result of (Json.JsonValue, string) := Json.Parse('{"name":"Ada","scores":[10,20],"active":true}');
  case Parsed of
    when Ok(const Value):
      begin
        case Value of
          when Json.JsonValue.Object(const Fields):
            begin
              const NameValue: option of Json.JsonValue := Fields.Get('name');
              const ScoresValue: option of Json.JsonValue := Fields.Get('scores');
              case NameValue.Unwrap() of
                when Json.JsonValue.String(const Name):
                  begin
                    Console.WriteLn('name = ' + Name);
                  end;
                when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
                  begin
                    Console.WriteLn('missing name');
                  end;
              end case;

              case ScoresValue.Unwrap() of
                when Json.JsonValue.ArrayValue(const Scores):
                  begin
                    Console.WriteLn('scores = ' + Conv.IntToStr(Scores.Length()));
                  end;
                when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
                  begin
                    Console.WriteLn('missing scores');
                  end;
              end case;

              Console.WriteLn(Json.Stringify(Value));
            end;
          when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
            begin
              Console.WriteLn('expected object');
            end;
        end case;
      end;
    when Error(const Message):
      begin
        Console.WriteLn('JSON error: ' + Message);
      end;
  end case;
end.
