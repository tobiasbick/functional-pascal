program JsonBasics;
uses Std.Console, Std.Json, Std.Dict, Std.Option, Std.Array, Std.Conv;

begin
  var Parsed: Result of JsonValue, string := Parse('{"name":"Ada","scores":[10,20],"active":true}');
  case Parsed of
    Ok(Value):
      case Value of
        JsonValue.Object(Fields): begin
          var NameValue: Option of JsonValue := Std.Dict.Get(Fields, 'name');
          var ScoresValue: Option of JsonValue := Std.Dict.Get(Fields, 'scores');

          case Unwrap(NameValue) of
            JsonValue.String(Name): WriteLn('name = ' + Name);
            else WriteLn('missing name')
          end;

          case Unwrap(ScoresValue) of
            JsonValue.Array(Scores): WriteLn('scores = ' + IntToStr(Std.Array.Length(Scores)));
            else WriteLn('missing scores')
          end;

          WriteLn(Stringify(Value))
        end;
        else WriteLn('expected object')
      end;
    Error(Message): WriteLn('JSON error: ' + Message)
  end
end.