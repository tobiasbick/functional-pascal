program JsonBasics;

uses Std.Console, Std.Json, Std.Conv;

begin
  const Parsed: result of (JsonValue, string) := Parse('{"name":"Ada","scores":[10,20],"active":true}');
  case Parsed of
    when Ok(const Value):
      begin
        case Value of
          when JsonValue.Object(const Fields):
            begin
              const NameValue: option of JsonValue := Fields.Get('name');
              const ScoresValue: option of JsonValue := Fields.Get('scores');
              case NameValue.Unwrap() of
                when JsonValue.String(const Name):
                  begin
                    WriteLn('name = ' + Name);
                  end;
                when JsonValue.NullValue, JsonValue.Bool(_), JsonValue.Number(_), JsonValue.ArrayValue(_), JsonValue.Object(_):
                  begin
                    WriteLn('missing name');
                  end;
              end case;

              case ScoresValue.Unwrap() of
                when JsonValue.ArrayValue(const Scores):
                  begin
                    WriteLn('scores = ' + IntToStr(Scores.Length()));
                  end;
                when JsonValue.NullValue, JsonValue.Bool(_), JsonValue.Number(_), JsonValue.String(_), JsonValue.Object(_):
                  begin
                    WriteLn('missing scores');
                  end;
              end case;

              WriteLn(Stringify(Value));
            end;
          when JsonValue.NullValue, JsonValue.Bool(_), JsonValue.Number(_), JsonValue.String(_), JsonValue.ArrayValue(_):
            begin
              WriteLn('expected object');
            end;
        end case;
      end;
    when Error(const Message):
      begin
        WriteLn('JSON error: ' + Message);
      end;
  end case;
end.
