program JsonBasics;

uses Std.Console, Std.Json, Std.Dict, Std.Option, Std.Array, Std.Conv;

begin
  var Parsed: result of JsonValue, string := Parse('{"name":"Ada","scores":[10,20],"active":true}');
  case Parsed of
    Ok(Value):
    begin
      case Value of
        JsonValue.Object(Fields):
        begin
          var NameValue: option of JsonValue := Std.Dict.Get(Fields, 'name');
          var ScoresValue: option of JsonValue := Std.Dict.Get(Fields, 'scores');
          case Unwrap(NameValue) of
            JsonValue.String(Name):
            begin
              WriteLn('name = ' + Name)
            end
            else
            begin
              WriteLn('missing name')
            end
          end;
          case Unwrap(ScoresValue) of
            JsonValue.Array(Scores):
            begin
              WriteLn('scores = ' + IntToStr(Std.Array.Length(Scores)))
            end
            else
            begin
              WriteLn('missing scores')
            end
          end;
          WriteLn(Stringify(Value))
        end
        else
        begin
          WriteLn('expected object')
        end
      end
    end;
    Error(Message):
    begin
      WriteLn('JSON error: ' + Message)
    end
  end
end.
