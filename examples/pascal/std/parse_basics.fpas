// Spec: docs/pascal/std/text/parse.md (from repository root).

program ParseBasics;

uses Std.Console as Console;
uses Std.Parse as Parse;
uses Std.Results as Results;
uses Std.Conv as Conv;

begin
  case Parse.TryInt(' +1_024 ') of
    when Ok(N):
      begin
        Console.WriteLn('try int: ', Conv.IntToStr(N));
      end;
    when Error(M):
      begin
        Console.WriteLn('try int error: ', M);
      end;
  end case;

  case Parse.TryReal('1_024.0e-2') of
    when Ok(R):
      begin
        Console.WriteLn('try real: ', Conv.RealToStr(R));
      end;
    when Error(M):
      begin
        Console.WriteLn('try real error: ', M);
      end;
  end case;

  case Parse.TryBool(' FALSE ') of
    when Ok(B):
      begin
        Console.WriteLn('try bool: ', Conv.BoolToStr(B));
      end;
    when Error(M):
      begin
        Console.WriteLn('try bool error: ', M);
      end;
  end case;
end program;
