{ Spec: docs/pascal/std/parse.md (from repository root). }
program ParseBasics;
uses Std.Console, Std.Parse, Std.Result, Std.Conv;

begin
  case TryInt(' +1_024 ') of
    Ok(N): WriteLn('try int: ', IntToStr(N));
    Error(M): WriteLn('try int error: ', M)
  end;

  case TryReal('1_024.0e-2') of
    Ok(R): WriteLn('try real: ', RealToStr(R));
    Error(M): WriteLn('try real error: ', M)
  end;

  case TryBool(' FALSE ') of
    Ok(B): WriteLn('try bool: ', BoolToStr(B));
    Error(M): WriteLn('try bool error: ', M)
  end
end.
