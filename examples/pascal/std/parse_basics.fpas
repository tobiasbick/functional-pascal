// Spec: docs/pascal/std/text/parse.md (from repository root).

program ParseBasics;

uses Std.Console as Console, Std.Text.Parse as Parse, Std.Text.Format as Conv;

begin
  case parse.Int(' +1_024 ') of
    when Ok(const N):
      begin
        Console.WriteLn('try int: ', Conv.IntToStr(N));
      end;
    when Error(const M):
      begin
        Console.WriteLn('try int error: ', M);
      end;
  end case;

  case parse.Real('1_024.0e-2') of
    when Ok(const R):
      begin
        Console.WriteLn('try real: ', Conv.RealToStr(R));
      end;
    when Error(const M):
      begin
        Console.WriteLn('try real error: ', M);
      end;
  end case;

  case parse.Bool(' FALSE ') of
    when Ok(const B):
      begin
        Console.WriteLn('try bool: ', Conv.BoolToStr(B));
      end;
    when Error(const M):
      begin
        Console.WriteLn('try bool error: ', M);
      end;
  end case;
end.
