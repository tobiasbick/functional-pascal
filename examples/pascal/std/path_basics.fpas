{ Spec: docs/pascal/std/path.md (from repository root). }
program PathBasics;
uses Std.Console, Std.Path;

begin
  WriteLn('join: ', Join(['examples', 'pascal', 'std']));
  WriteLn('base: ', BaseName('dir/nested/file.txt'));
  WriteLn('dir: ', DirName('dir/nested/file.txt'));
  WriteLn('ext: ', Extension('archive.tar.gz'));
  WriteLn('norm: ', Normalize('dir/nested/../file.txt'))
end.
