{ Spec: docs/pascal/std/path.md (from repository root). }
program PathBasics;
uses Std.Console, Std.Path;
begin
  var Joined: string := Join(['src', 'main', 'app.fpas']);
  WriteLn('base: ', BaseName(Joined));
  WriteLn('extension: ', Extension(Joined));
  WriteLn('dir base: ', BaseName(DirName(Joined)));
  WriteLn('normalized base: ', BaseName(Normalize('dir/nested/../file.txt')))
end.
