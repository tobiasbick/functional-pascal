// Spec: docs/pascal/std/host/path.md (from repository root).

program PathBasics;

uses Std.Console as Console;
uses Std.Path as Path;

begin
  Console.WriteLn('join: ', Path.Join(['examples', 'pascal', 'std']));
  Console.WriteLn('base: ', Path.BaseName('dir/nested/file.txt'));
  Console.WriteLn('dir: ', Path.DirName('dir/nested/file.txt'));
  Console.WriteLn('ext: ', Path.Extension('archive.tar.gz'));
  Console.WriteLn('norm: ', Path.Normalize('dir/nested/../file.txt'));
end program;
