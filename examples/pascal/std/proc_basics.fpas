// Spec: docs/pascal/std/host/proc.md — requires `fpas` on PATH.

program ProcBasics;

uses Std.Console, Std.Conv, Std.Proc, Std.Results;

begin
  case Run('fpas', ['--version']) of
    when Ok(Code):
      begin
        WriteLn('fpas --version exit: ', IntToStr(Code));
      end;
    when Error(M):
      begin
        WriteLn('run error: ', M);
      end;
  end case;
end.
