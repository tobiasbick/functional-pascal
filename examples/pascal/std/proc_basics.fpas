// Spec: docs/pascal/std/host/proc.md — requires `fpas` on PATH.

program ProcBasics;

uses Std.Console, Std.Conv, Std.Proc, Std.Result;

begin
  case Run('fpas', ['--version']) of
    Ok(Code):
    begin
      WriteLn('fpas --version exit: ', IntToStr(Code))
    end;
    Error(M):
    begin
      WriteLn('run error: ', M)
    end
  end
end.
