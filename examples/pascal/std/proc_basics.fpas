// Spec: docs/pascal/std/host/proc.md — requires `fpas` on PATH.

program ProcBasics;

uses Std.Console as Console, Std.Text.Format as Conv, Std.Os.Proc as Proc;

begin
  case Proc.Run('fpas', ['--version']) of
    when Ok(const Code):
      begin
        Console.WriteLn('fpas --version exit: ', Conv.IntToStr(Code));
      end;
    when Error(const M):
      begin
        Console.WriteLn('run error: ', M);
      end;
  end case;
end.
