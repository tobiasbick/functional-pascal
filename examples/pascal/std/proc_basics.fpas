// Spec: docs/pascal/std/host/proc.md — requires `fpas` on PATH.

program ProcBasics;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Proc as Proc;
uses Std.Results as Results;

begin
  case Proc.Run('fpas', ['--version']) of
    when Ok(Code):
      begin
        Console.WriteLn('fpas --version exit: ', Conv.IntToStr(Code));
      end;
    when Error(M):
      begin
        Console.WriteLn('run error: ', M);
      end;
  end case;
end program;
