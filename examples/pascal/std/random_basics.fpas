// Spec: docs/pascal/std/numeric/random.md (from repository root).

program RandomBasics;

uses Std.Console as Console, Std.Conv as Conv, Std.Random as Random;

begin
  Random.SetSeed(42);
  Console.WriteLn('repeatable d6: ', Conv.IntToStr(Random.RandomInt(1, 6)));
  Random.Randomize();
  Console.WriteLn('random real: ', Conv.RealToStr(Random.Random()));
  Console.WriteLn('d6: ', Conv.IntToStr(Random.RandomInt(1, 6)));
end.
