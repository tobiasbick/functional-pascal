// Spec: docs/pascal/std/numeric/random.md (from repository root).

program RandomBasics;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Random as Random2;

begin
  Random2.SetSeed(42);
  Console.WriteLn('repeatable d6: ', Conv.IntToStr(Random2.RandomInt(1, 6)));
  Random2.Randomize();
  Console.WriteLn('random real: ', Conv.RealToStr(Random2.Random()));
  Console.WriteLn('d6: ', Conv.IntToStr(Random2.RandomInt(1, 6)));
end program;
