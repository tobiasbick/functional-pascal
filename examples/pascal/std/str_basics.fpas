// Spec: docs/pascal/std/text/str/README.md (from repository root).

program StrBasics;

uses Std.Console as Console, Std.Conv as Conv;

function ReplaceStar(C: string): string;
begin
  if C = '*' then
    begin
      return '★';
    end;
  end if;

  return C;
end function;

function KeepLetter(C: string): boolean;
begin
  return C <> ' ';
end function;

function Count(Acc: integer; C: string): integer;
begin
  return Acc + 1;
end function;

begin
  const S: string := '  Hello, World!  ';
  Console.WriteLn('trim: ', S.Trim());
  Console.WriteLn('upper: ', 'fpas'.ToUpper());
  Console.WriteLn('split+join: ', 'a,b,c'.Split(',').Join('|'));
  const Msg: string := 'n=%d upper=%s'.Format(42, 'ok'.ToUpper());
  Console.WriteLn('format: ', Msg);
  Console.WriteLn('contains b: ', 'abc'.Contains('b'));
  Console.WriteLn('substring: ', 'Hello'.Slice(0, 3));
  Console.WriteLn('replace: ', 'banana'.Replace('na', 'NA'));
  Console.WriteLn('reverse: ', 'draw'.Reverse());
  Console.WriteLn('pad: ', '7'.PadLeft(4, '0'));
  Console.WriteLn('map: ', 'a*b'.Map(ReplaceStar));
  Console.WriteLn('filter: ', 'a b'.Filter(KeepLetter));
  Console.WriteLn('reduce: ', Conv.IntToStr('a😀b'.Reduce(0, Count)));
end.
