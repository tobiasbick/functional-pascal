// Spec: docs/pascal/std/text/str/README.md (from repository root).

program StrBasics;

uses Std.Console, Std.Conv;

function ReplaceStar(C: string): string;
begin
  if C = '*' then
    begin
      return '★';
    end;
  end if;

  return C;
end function;

function KeepLetter(C: string): boolean;
begin
  return C <> ' ';
end function;

function Count(Acc: integer; C: string): integer;
begin
  return Acc + 1;
end function;

begin
  const S: string := '  Hello, World!  ';
  WriteLn('trim: ', S.Trim());
  WriteLn('upper: ', 'fpas'.ToUpper());
  WriteLn('split+join: ', 'a,b,c'.Split(',').Join('|'));
  const Msg: string := 'n=%d upper=%s'.Format(42, 'ok'.ToUpper());
  WriteLn('format: ', Msg);
  WriteLn('contains b: ', 'abc'.Contains('b'));
  WriteLn('substring: ', 'Hello'.Slice(0, 3));
  WriteLn('replace: ', 'banana'.Replace('na', 'NA'));
  WriteLn('reverse: ', 'draw'.Reverse());
  WriteLn('pad: ', '7'.PadLeft(4, '0'));
  WriteLn('map: ', 'a*b'.Map(ReplaceStar));
  WriteLn('filter: ', 'a b'.Filter(KeepLetter));
  WriteLn('reduce: ', IntToStr('a😀b'.Reduce(0, Count)));
end.
