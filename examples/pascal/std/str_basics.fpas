// Spec: docs/pascal/std/text/str/README.md (from repository root).

program StrBasics;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;

pure function ReplaceStar(C: string): string;
begin
  if C = '*' then
    begin
      return '★';
    end;
  end if;

  return C;
end function;

pure function KeepLetter(C: string): boolean;
begin
  return C <> ' ';
end function;

pure function Count(Acc: integer; C: string): integer;
begin
  return Acc + 1;
end function;

begin
  const S: string := '  Hello, World!  ';
  Console.WriteLn('trim: ', Str.Trim(S));
  Console.WriteLn('upper: ', Str.ToUpper('fpas'));
  Console.WriteLn('split+join: ', Str.Join(Str.Split('a,b,c', ','), '|'));
  const Msg: string := Str.Format('n=%d upper=%s', 42, Str.ToUpper('ok'));
  Console.WriteLn('format: ', Msg);
  Console.WriteLn('contains b: ', Str.Contains('abc', 'b'));
  Console.WriteLn('substring: ', Str.Substring('Hello', 0, 3));
  Console.WriteLn('replace: ', Str.Replace('banana', 'na', 'NA'));
  Console.WriteLn('reverse: ', Str.Reverse('draw'));
  Console.WriteLn('pad: ', Str.PadLeft('7', 4, '0'));
  Console.WriteLn('map: ', Str.Map('a*b', ReplaceStar));
  Console.WriteLn('filter: ', Str.Filter('a b', KeepLetter));
  Console.WriteLn('reduce: ', Conv.IntToStr(Str.Reduce('a😀b', 0, Count)));
end program;
