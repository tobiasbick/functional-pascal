// Spec: docs/pascal/std/concurrency/task.md (from repository root); see also docs/pascal/language/concurrency/README.md.

program TaskBasics;

uses Std.Console as Console, Std.Text.Format as Conv, Std.Tasks as Tasks;

function Square(N: integer): integer;
begin
  return N * N;
end function;

begin
  scope
    const One: task of integer := go Square(6);
    Console.WriteLn('wait one: ', Conv.IntToStr(Tasks.Wait(One)));
    var Jobs: array of task of integer := [];
    Jobs.PushInPlace(go Square(3));
    Jobs.PushInPlace(go Square(4));
    Console.WriteLn('wait [0]: ', Conv.IntToStr(Tasks.Wait(Jobs[0])));
    Console.WriteLn('wait [1]: ', Conv.IntToStr(Tasks.Wait(Jobs[1])));
    const Ta: task of integer := go Square(2);
    const Tb: task of integer := go Square(3);
    Tasks.WaitAll([Ta, Tb]);
    Console.WriteLn('after waitall: ', Conv.IntToStr(Tasks.Wait(Ta) + Tasks.Wait(Tb)));
  end scope;
end.
