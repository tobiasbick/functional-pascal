// Spec: docs/pascal/std/concurrency/task.md (from repository root); see also docs/pascal/language/concurrency/README.md.

program TaskBasics;

uses Std.Console, Std.Conv, Std.Tasks;

function Square(N: integer): integer;
begin
  return N * N;
end function;

begin
  const One: task := go Square(6);
  WriteLn('wait one: ', IntToStr(Wait(One)));
  var Jobs: array of task := [];
  Jobs.Push(go Square(3));
  Jobs.Push(go Square(4));
  WriteLn('wait [0]: ', IntToStr(Wait(Jobs[0])));
  WriteLn('wait [1]: ', IntToStr(Wait(Jobs[1])));
  const Ta: task := go Square(2);
  const Tb: task := go Square(3);
  WaitAll([Ta, Tb]);
  WriteLn('after waitall: ', IntToStr(Wait(Ta) + Wait(Tb)));
end.
