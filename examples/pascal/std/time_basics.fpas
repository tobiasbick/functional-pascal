// Spec: docs/pascal/std/host/time.md (from repository root).

program TimeBasics;

uses Std.Console as Console, Std.Text.Format as Conv, Std.Time as Time;

begin
  const Start: integer := Time.MonotonicMillis();
  Time.Sleep(25);
  Console.WriteLn('elapsed ms: ', Conv.IntToStr(Time.ElapsedMillis(Start)));
  Console.WriteLn('timestamp ms: ', Conv.IntToStr(Time.TimestampMillis()));
end.
