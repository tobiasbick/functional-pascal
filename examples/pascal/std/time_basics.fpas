{ Spec: docs/pascal/std/time.md (from repository root). }
program TimeBasics;
uses Std.Console, Std.Conv, Std.Time;

begin
  var Start: integer := MonotonicMillis();
  Sleep(25);
  WriteLn('elapsed ms: ', IntToStr(ElapsedMillis(Start)));
  WriteLn('timestamp ms: ', IntToStr(TimestampMillis()))
end.
