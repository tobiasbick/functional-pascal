program TuiMouseTest;

uses Std.Console, Std.Tui, Std.Test;

mutable var
  mutable var MouseSeen: boolean := false;
  mutable var MouseX: integer := 0;
  mutable var MouseY: integer := 0;

procedure OnPaint(App: Application);
begin
end;

procedure OnMouse(App: Application; Event: Event);
begin
  if Event.mouse_action = MouseAction.Down then
  begin
    MouseSeen := true;
    MouseX := Event.mouse_x;
    MouseY := Event.mouse_y;
    Application.HostRequestQuit(App)
  end
end;

begin
  var App: Application := Application.Open();
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; OnMouse := Some(OnMouse); end;
  Application.Configure(App, Handlers);
  Application.Run(App);
  AssertTrue(MouseSeen);
  AssertEquals(10, MouseX);
  AssertEquals(5, MouseY)
end.
