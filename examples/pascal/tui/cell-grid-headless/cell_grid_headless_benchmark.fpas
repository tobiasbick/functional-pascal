// Measures repeated painting of one prebuilt cell grid through the headless TUI host.
program CellGridHeadlessBenchmark;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Std.Tui.Cells as Cells;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

const GridWidth: integer := 98;
const GridHeight: integer := 32;
const WarmupIterations: integer := 5;

function Update(Grid: Tui.TuiCellGrid; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Tui.TuiCellGrid;
begin
  return Grid;
end function;

function View(Grid: Tui.TuiCellGrid): Tui.TuiElement;
begin
  return Elements.TuiElementMakeCellGrid(Grid);
end function;

function PaintOnce(App: Tui.TuiApplication; Grid: Tui.TuiCellGrid): Tui.TuiCellGrid;
begin
  return Runtime.TuiApplicationRunIterations(App, Grid, Update, View, 0, 0);
end function;

begin
  if Args.ParamCount() <> 1 then
    begin
      panic('usage: cell_grid_headless_benchmark.fpas -- ITERATIONS');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  const Style: Tui.TuiStyle := Cells.TuiStyleFromColors(Cells.TuiColorFromRgb(214, 218, 224), Cells.TuiColorFromRgb(18, 22, 28));
  const Cell: Tui.TuiCell := Cells.TuiCellStyled('#', Style);
  var Grid: Tui.TuiCellGrid := Chrome.TuiCellGridCreate(GridWidth, GridHeight, Arrays.Fill(Cell, GridWidth *
                                                                                                 GridHeight));
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(GridWidth, GridHeight));
  for Warmup: integer := 1 to WarmupIterations do
    begin
      Grid := PaintOnce(App, Grid);
    end;
  end for;
  const Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      Grid := PaintOnce(App, Grid);
    end;
  end for;
  const Elapsed: integer := Time.ElapsedMillis(Started);
  const Snapshot: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Runtime.TuiApplicationClose(App);
  if ((Snapshot.Width <> GridWidth) or (Snapshot.Height <> GridHeight)) or
     (Rendering.TuiSurfaceSnapshotCellAt(Snapshot, GridWidth - 1, GridHeight - 1).Glyph <> '#') then
    begin
      panic('cell grid headless benchmark snapshot mismatch');
    end;
  end if;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr((Iterations * 1000) div Elapsed)) +
                      ' paints/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;
end program;
