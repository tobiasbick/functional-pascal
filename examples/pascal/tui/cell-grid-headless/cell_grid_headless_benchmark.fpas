// Measures repeated painting of one prebuilt cell grid through the headless TUI host.
program CellGridHeadlessBenchmark;

uses Std.Args, Std.Console, Std.Conv, Std.Time, Std.Tui;

const GridWidth: integer := 98;
const GridHeight: integer := 32;
const WarmupIterations: integer := 5;

function Update(Grid: TuiCellGrid; Msg: TuiMsg; Cmd: TuiCmdOutput): TuiCellGrid;
begin
  return Grid;
end function;

function View(Grid: TuiCellGrid): TuiElement;
begin
  return TuiElementBuilders.MakeCellGrid(Grid);
end function;

function PaintOnce(App: TuiApplication; Grid: TuiCellGrid): TuiCellGrid;
begin
  return App.RunIterations(Grid, Update, View, 0, 0);
end function;

begin
  if ParamCount() <> 1 then
    begin
      panic('usage: cell_grid_headless_benchmark.fpas -- ITERATIONS');
    end;
  end if;
  const Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  const Style: TuiStyle := TuiStyle.FromColors(TuiColor.FromRgb(214, 218, 224), TuiColor.FromRgb(18, 22, 28));
  const Cell: TuiCell := TuiCell.Styled('#', Style);
  var Grid: TuiCellGrid := TuiCellGrid.Create(GridWidth, GridHeight, array.Fill(Cell, GridWidth *
                                                                                      GridHeight));
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(GridWidth, GridHeight));
  for Warmup: integer := 1 to WarmupIterations do
    begin
      Grid := PaintOnce(App, Grid);
    end;
  end for;
  const Started: integer := MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      Grid := PaintOnce(App, Grid);
    end;
  end for;
  const Elapsed: integer := ElapsedMillis(Started);
  const Snapshot: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  App.Close();
  if ((Snapshot.Width <> GridWidth) or (Snapshot.Height <> GridHeight)) or
     (Snapshot.CellAt(GridWidth - 1, GridHeight - 1).Glyph <> '#') then
    begin
      panic('cell grid headless benchmark snapshot mismatch');
    end;
  end if;

  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      WriteLn(('throughput: ' + IntToStr((Iterations * 1000) div Elapsed)) + ' paints/s');
    end;
  else
    begin
      WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;
end.
