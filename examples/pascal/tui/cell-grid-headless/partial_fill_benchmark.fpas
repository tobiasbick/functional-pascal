// Measures repeated clipped rectangle fills on a prebuilt working surface.
program PartialFillBenchmark;

uses
  Std.Args as Args, Std.Console as Console, Std.Conv as Conv, Std.Time as Time, Std.Tui as Tui,
  Std.Parse as Parse;

begin
  if Args.ParamCount() <> 1 then
    begin
      panic('usage: partial_fill_benchmark.fpas -- ITERATIONS');
    end;
  end if;
  const Iterations: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  const Surface: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(98, 32));
  const Canvas: Tui.TuiCanvas := Tui.TuiCanvas.Create(Surface, Tui.TuiRect.Create(0, 0, 98, 32));
  const Bounds: Tui.TuiRect := Tui.TuiRect.Create(4, 3, 90, 26);
  const Cell: Tui.TuiCell := Tui.TuiCell.Create('#', Tui.TuiStyleRole.Accent);
  for Warmup: integer := 1 to 5 do
    begin
      Canvas.FillRect(Bounds, Cell);
    end;
  end for;
  const Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      Canvas.FillRect(Bounds, Cell);
    end;
  end for;
  const Elapsed: integer := Time.ElapsedMillis(Started);
  const Snapshot: Tui.TuiSurfaceSnapshot := Surface.Snapshot();
  if (
    ((Snapshot.CellAt(4, 3).Glyph <> '#') or (Snapshot.CellAt(93, 28).Glyph <> '#'))
    or
    (Snapshot.CellAt(3, 3).Glyph <> ' ')
  )
    or
    (Snapshot.CellAt(94, 28).Glyph <> ' ')
  then
    begin
      panic('partial fill snapshot mismatch');
    end;
  end if;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Elapsed) + ' ms');
end.
