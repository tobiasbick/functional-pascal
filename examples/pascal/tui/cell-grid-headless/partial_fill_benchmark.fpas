// Measures repeated clipped rectangle fills on a prebuilt working surface.
program PartialFillBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Std.Tui.Cells as Cells;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Rendering as Rendering;

begin
  if Args.ParamCount() <> 1 then
    begin
      panic('usage: partial_fill_benchmark.fpas -- ITERATIONS');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  const Surface: Tui.TuiWorkingSurface := Rendering.TuiWorkingSurfaceCreate(Geometry.TuiSizeCreate(98, 32));
  const Canvas: Tui.TuiCanvas := Rendering.TuiCanvasCreate(Surface, Geometry.TuiRectCreate(0, 0, 98, 32));
  const Bounds: Tui.TuiRect := Geometry.TuiRectCreate(4, 3, 90, 26);
  const Cell: Tui.TuiCell := Cells.TuiCellCreate('#', Tui.TuiStyleRole.Accent);
  for Warmup: integer := 1 to 5 do
    begin
      Rendering.TuiCanvasFillRect(Canvas, Bounds, Cell);
    end;
  end for;
  const Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      Rendering.TuiCanvasFillRect(Canvas, Bounds, Cell);
    end;
  end for;
  const Elapsed: integer := Time.ElapsedMillis(Started);
  const Snapshot: Tui.TuiSurfaceSnapshot := Rendering.TuiWorkingSurfaceSnapshot(Surface);
  if (((Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 4, 3).Glyph <> '#') or (Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 93, 28).Glyph <> '#')) or (Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 3, 3).Glyph <> ' ')) or
     (Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 94, 28).Glyph <> ' ') then
    begin
      panic('partial fill snapshot mismatch');
    end;
  end if;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
end program;
