{ Turbo Vision modal dialog demo. Run in a terminal; type a name, toggle the }
{ checkbox, then press OK or Cancel. Values are read back after the dialog closes. }

program TuiExecDialog;

uses Std.Console, Std.Tui;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): TuiRect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.Open();
  var Dlg: Dialog := Dialog.NewModal(Bounds(20, 6, 40, 11), 'Your name');
  var Prompt: StaticText := StaticText.New(Bounds(3, 2, 30, 1), 'Enter your name:');
  var NameInput: InputLine := InputLine.New(Bounds(3, 4, 24, 1), 'World', 32);
  var Newsletter: CheckBox := CheckBox.New(Bounds(3, 5, 24, 1), 'Newsletter', false);
  var OkButton: Button := Button.New(Bounds(4, 7, 10, 2), 'O~K~', CM_OK, true);
  var CancelButton: Button := Button.New(Bounds(16, 7, 12, 2), 'Cancel', CM_CANCEL, false);
  Dialog.Add(Dlg, Prompt);
  Dialog.Add(Dlg, NameInput);
  Dialog.Add(Dlg, Newsletter);
  Dialog.Add(Dlg, OkButton);
  Dialog.Add(Dlg, CancelButton);
  var Choice: integer := Application.ExecView(App, Dlg);
  var Name: string := InputLine.Text(NameInput);
  var WantsNews: boolean := CheckBox.Checked(Newsletter);
  Application.Close(App);
  if Choice = CM_OK then
  begin
    if WantsNews then
    begin
      WriteLn(('Hello, ' + Name) + '! Newsletter on.')
    end
    else
    begin
      WriteLn(('Hello, ' + Name) + '!')
    end
  end
  else
  begin
    WriteLn('Canceled.')
  end
end.
