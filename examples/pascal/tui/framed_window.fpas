{ Painted frame windows — movable Turbo Vision-style chrome on a desktop work area. }

program TuiFramedWindow;

uses Std.Console, Std.Str, Std.Tui;

const
  FrameKindWindow: integer := 0;
  CmdNextWindow: integer := -1;
  CmdQuit: integer := 99;

mutable var
  mutable var Status: string := 'Drag a title bar to move. F6 activates the next window.';

procedure OnPaint(App: Application);
begin
  var S: Size := Application.Size(App);
  ClrScr();
  GotoXY(1, 1);
  WriteLn('Framed window demo');
  GotoXY(1, 2);
  WriteLn(Status);
  GotoXY(1, 4);
  WriteLn('Two painted frame roots share the desktop work area.');
  GotoXY(1, 5);
  WriteLn('Click a title bar to raise a window. Drag to move.');
  GotoXY(1, 6);
  WriteLn('Close (■) removes a window. ▲/▼ zooms the Notes window.');
  GotoXY(1, 7);
  WriteLn('F6: next window   Escape: quit');
  if S.height >= 10 then
  begin
    GotoXY(1, S.height - 1);
    Write('Desktop: ', S.width, 'x', S.height)
  end
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdQuit then
  begin
    Application.HostRequestQuit(App)
  end
  else if CommandId = CmdNextWindow then
  begin
    if Application.HostActivateNextWindow(App) then
    begin
      Status := 'Activated the next window root.'
    end
    else
    begin
      Status := 'No other window root to activate.'
    end;
    Application.RequestRedraw(App)
  end
end;

function OnKeyPressed(App: Application; Key: Std.Console.KeyEvent): boolean;
begin
  if Key.kind = KeyKind.Escape then
  begin
    Application.HostRequestQuit(App);
    return true
  end;
  return false
end;

procedure OnResize(App: Application; NewSize: Size);
begin
  Application.HostSetDesktopWorkArea(App, 0, 0, NewSize.width, NewSize.height);
  Application.RequestRedraw(App)
end;

begin
  var App: Application := Application.Open();
  var S: Size := Application.Size(App);
  Application.HostSetDesktopWorkArea(App, 0, 0, S.width, S.height);
  var Notes: ViewId := Application.HostCreateFrameView(App, 4, 3, 30, 11, 'Notes', FrameKindWindow, true, false, true, false, true);
  var NotesText: ViewId := Application.HostCreateLabelView(App, 1, 1, 24, 1, 'Static content in view coordinates.', None);
  Application.HostSetViewParent(App, NotesText, Some(Notes));
  var NotesHint: ViewId := Application.HostCreateLabelView(App, 1, 3, 24, 1, 'Scrollable is off for this demo.', None);
  Application.HostSetViewParent(App, NotesHint, Some(Notes));
  var Tools: ViewId := Application.HostCreateFrameView(App, 36, 5, 24, 9, 'Tools', FrameKindWindow, true, false, false, false, true);
  var ToolsText: ViewId := Application.HostCreateLabelView(App, 1, 1, 18, 1, 'Second frame root.', None);
  Application.HostSetViewParent(App, ToolsText, Some(Tools));
  var ToolsButton: ViewId := Application.HostCreateButtonView(App, 1, 3, 10, 1, 'Focus', None, true);
  Application.HostSetViewParent(App, ToolsButton, Some(Tools));
  var NextWindowKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.F6;
    ch := Std.Str.Chr(0);
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  Application.HostBindCommand(App, NextWindowKey, CmdNextWindow);
  var Handlers: ApplicationHandlers := record
    OnPaint := Some(OnPaint);
    OnCommand := Some(OnCommand);
    OnKeyPressed := Some(OnKeyPressed);
    OnResize := Some(OnResize);
  end;
  Application.Configure(App, Handlers);
  Application.Run(App)
end.
