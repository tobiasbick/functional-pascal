// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 500
// Guard: target/release/fpas run this-file.fpas -- 500 MAX_MILLIS

program TuiHeadlessRenderBenchmark;

uses Std.Args, Std.Arrays, Std.Console, Std.Conv, Std.Time, Std.Tui;

const
  WarmupIterations: integer := 100;
  DeltaMillis: integer := 16;

function UpdateBenchmark(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.Tick(Delta):
      begin
        return State + 1;
      end;
    when TuiMsg.Key(Key):
      begin
        return State;
      end;
    when TuiMsg.Pointer(Pointer):
      begin
        return State;
      end;
    when TuiMsg.Resize(Size):
      begin
        return State;
      end;
    when TuiMsg.FocusChanged(Previous, Current):
      begin
        return State;
      end;
    when TuiMsg.Action(Source, Action):
      begin
        return State;
      end;
    when TuiMsg.TextChanged(Source, Action, Text, Caret):
      begin
        return State;
      end;
    when TuiMsg.TextAreaChanged(Source, Action, Text, Caret, TextAreaOffset):
      begin
        return State;
      end;
    when TuiMsg.CheckChanged(Source, Action, Checked):
      begin
        return State;
      end;
    when TuiMsg.SelectionChanged(Source, Action, Selected):
      begin
        return State;
      end;
    when TuiMsg.ScrollChanged(Source, Action, Offset):
      begin
        return State;
      end;
    when TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
      begin
        return State;
      end;
    when TuiMsg.QuitRequested:
      begin
        return State;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function ViewBenchmark(State: integer): TuiElement;
begin
  mutable var Children: array of TuiElement := [
                                                 TuiElementBuilders.MakeLabel('frame ' + IntToStr(State))
                                               ];
  for Index: integer := 2 to 32 do
    begin
      Std.Arrays.Push(Children, TuiElementBuilders.MakeLabel('row'));
    end;
  end for;
  var SharedAction: TuiAction := TuiAction.Create(100);
  for Index: integer := 1 to 8 do
    begin
      Std.Arrays.Push(Children, TuiElementBuilders.MakeButton(TuiControlId.Create(Index), 'action', SharedAction));
    end;
  end for;

  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakePanel('Headless benchmark', [TuiElementBuilders.MakeColumn(Children)])
                                                                      ]);
end function;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
    begin
      panic('usage: headless_render_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  var Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  mutable var MaxMillis: integer := 0;
  if ParamCount() = 2 then
    begin
      MaxMillis := StrToInt(ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(120, 40));
  mutable var Model: integer := App.RunIterations(0, UpdateBenchmark, ViewBenchmark, WarmupIterations, DeltaMillis);
  var Started: integer := MonotonicMillis();
  Model := App.RunIterations(Model, UpdateBenchmark, ViewBenchmark, Iterations, DeltaMillis);
  var Elapsed: integer := ElapsedMillis(Started);
  App.Close();
  mutable var FramesPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      FramesPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  WriteLn((('iterations: ' + IntToStr(Iterations)) + ', warm-up: ') + IntToStr(WarmupIterations));
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      WriteLn(('throughput: ' + IntToStr(FramesPerSecond)) + ' frames/s');
    end;
  else
    begin
      WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  WriteLn('final state: ' + IntToStr(Model));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('TUI benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end.
