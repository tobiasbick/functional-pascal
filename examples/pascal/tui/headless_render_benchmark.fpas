// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 500
// Guard: target/release/fpas run this-file.fpas -- 500 MAX_MILLIS

program TuiHeadlessRenderBenchmark;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

const WarmupIterations: integer := 100;
const DeltaMillis: integer := 16;

function UpdateBenchmark(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return State + 1;
      end;
    when Tui.TuiMsg.Key(const Key):
      begin
        return State;
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return State;
      end;
    when Tui.TuiMsg.Resize(const Size):
      begin
        return State;
      end;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        return State;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return State;
      end;
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        return State;
      end;
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const TextAreaOffset):
      begin
        return State;
      end;
    when Tui.TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        return State;
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return State;
      end;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return State;
      end;
    when Tui.TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        return State;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        return State;
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _):
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function ViewBenchmark(State: integer): Tui.TuiElement;
begin
  var Children: array of (Tui.TuiElement) := [
                                               Elements.TuiElementMakeLabel('frame ' + Conv.IntToStr(State))
                                             ];
  for Index: integer := 2 to 32 do
    begin
      Arrays.Push(var Children, Elements.TuiElementMakeLabel('row'));
    end;
  end for;
  const SharedAction: Tui.TuiAction := Ids.TuiActionCreate(100);
  for Index: integer := 1 to 8 do
    begin
      Arrays.Push(var Children, Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(Index), 'action', SharedAction));
    end;
  end for;

  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakePanel('Headless benchmark', [Elements.TuiElementMakeColumn(Children)])
                                                                                ]);
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: headless_render_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(120, 40));
  var Model: integer := Runtime.TuiApplicationRunIterations(App, 0, UpdateBenchmark, ViewBenchmark, WarmupIterations, DeltaMillis);
  const Started: integer := Time.MonotonicMillis();
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateBenchmark, ViewBenchmark, Iterations, DeltaMillis);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  Runtime.TuiApplicationClose(App);
  var FramesPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      FramesPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn((('iterations: ' + Conv.IntToStr(Iterations)) + ', warm-up: ') +
                  Conv.IntToStr(WarmupIterations));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(FramesPerSecond)) + ' frames/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('final state: ' + Conv.IntToStr(Model));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('TUI benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
