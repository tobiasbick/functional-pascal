// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 500
// Guard: target/release/fpas run this-file.fpas -- 500 MAX_MILLIS

program TuiHeadlessRenderBenchmark;

uses Std.Args, Std.Console, Std.Conv, Std.Time, Std.Tui;

const WarmupIterations: integer := 100;
const DeltaMillis: integer := 16;

function UpdateBenchmark(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.Tick(const Delta):
      begin
        return State + 1;
      end;
    when TuiMsg.Key(const Key):
      begin
        return State;
      end;
    when TuiMsg.Pointer(const Pointer):
      begin
        return State;
      end;
    when TuiMsg.Resize(const Size):
      begin
        return State;
      end;
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        return State;
      end;
    when TuiMsg.Action(const Source, const Action):
      begin
        return State;
      end;
    when TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        return State;
      end;
    when TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const TextAreaOffset):
      begin
        return State;
      end;
    when TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        return State;
      end;
    when TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return State;
      end;
    when TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return State;
      end;
    when TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        return State;
      end;
    when TuiMsg.QuitRequested:
      begin
        return State;
      end;
    when TuiMsg.Started, TuiMsg.BackgroundFailed(_, _, _, _, _, _):
      begin
        return State;
      end;
  end case;
end function;

function ViewBenchmark(State: integer): TuiElement;
begin
  var Children: array of TuiElement := [TuiElementBuilders.MakeLabel('frame ' + IntToStr(State))];
  for Index: integer := 2 to 32 do
    begin
      Children.Push(TuiElementBuilders.MakeLabel('row'));
    end;
  end for;
  const SharedAction: TuiAction := TuiAction.Create(100);
  for Index: integer := 1 to 8 do
    begin
      Children.Push(TuiElementBuilders.MakeButton(TuiControlId.Create(Index), 'action', SharedAction));
    end;
  end for;

  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakePanel('Headless benchmark', [TuiElementBuilders.MakeColumn(Children)])
                                                                      ]);
end function;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
    begin
      panic('usage: headless_render_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if ParamCount() = 2 then
    begin
      MaxMillis := StrToInt(ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(120, 40));
  var Model: integer := App.RunIterations(0, UpdateBenchmark, ViewBenchmark, WarmupIterations, DeltaMillis);
  const Started: integer := MonotonicMillis();
  Model := App.RunIterations(Model, UpdateBenchmark, ViewBenchmark, Iterations, DeltaMillis);
  const Elapsed: integer := ElapsedMillis(Started);
  App.Close();
  var FramesPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      FramesPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  WriteLn((('iterations: ' + IntToStr(Iterations)) + ', warm-up: ') + IntToStr(WarmupIterations));
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      WriteLn(('throughput: ' + IntToStr(FramesPerSecond)) + ' frames/s');
    end;
  else
    begin
      WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  WriteLn('final state: ' + IntToStr(Model));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('TUI benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end.
