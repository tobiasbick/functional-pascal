{ Minimal host-dispatch API: one ProcessNext spin then exit. See docs/pascal/std/tui-app.md. }

program TuiHostDispatchMinimal;

uses Std.Console, Std.Tui;

begin
  var App: Application := Application.Open();
  Std.Console.WriteLn(Application.HostProcessNext(App, 32));
  Application.Close(App)
end.
