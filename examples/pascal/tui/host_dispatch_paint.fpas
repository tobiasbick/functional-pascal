{ Register an OnPaint handler and dispatch one redraw. See docs/pascal/std/tui/app/README.md. }

program TuiHostDispatchPaint;

uses Std.Console, Std.Tui;

procedure OnPaint(App: Application);
begin
  WriteLn('frame')
end;

begin
  var App: Application := Application.Open();
  Application.RequestRedraw(App);
  Application.HostRegisterOnPaint(App, OnPaint);
  WriteLn(Application.HostDispatchRedraw(App));
  Application.Close(App)
end.
