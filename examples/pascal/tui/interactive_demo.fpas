program TuiInteractiveDemo;

uses Std.Tui as Tui;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type DemoModel = record
  Text: string;
  Caret: integer;
  Confirming: boolean;
end record;

function UpdateDemo(State: DemoModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): DemoModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        return State;
      end;
    when Tui.TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      begin
        return State;
      end;
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        return DemoModel(Text := Text, Caret := Caret, Confirming := State.Confirming);
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        if Action.Value = 2 then
          begin
            return DemoModel(Text := State.Text, Caret := State.Caret, Confirming := true);
          end;
        end if;

        if Action.Value = 3 then
          begin
            Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
        return State;
      end;
    when Tui.TuiMsg.Key(const Key):
      begin
        return State;
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return State;
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return State;
      end;
    when Tui.TuiMsg.Resize(const Size):
      begin
        return State;
      end;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        return State;
      end;
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const TextAreaOffset):
      begin
        return State;
      end;
    when Tui.TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        return State;
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return State;
      end;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return State;
      end;
    when Tui.TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        return State;
      end;
  end case;
end function;

function ViewDemo(State: DemoModel): Tui.TuiElement;
begin
  const Input: Tui.TuiElement := Elements.TuiElementMakeInput(Ids.TuiControlIdCreate(1), State.Text, State.Caret, Ids.TuiActionCreate(1));
  const Confirm: Tui.TuiElement := Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(2), 'Confirm', Ids.TuiActionCreate(2));
  const Quit: Tui.TuiElement := Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(3), 'Quit', Ids.TuiActionCreate(3));
  var Content: array of (Tui.TuiElement) := [Input, Confirm, Quit];
  var Focused: Option of (Tui.TuiControlId) := Option.Some(Ids.TuiControlIdCreate(1));
  if State.Confirming then
    begin
      Content := [
                   Elements.TuiElementMakeOverlay('Confirm', [Elements.TuiElementMakeLabel(State.Text), Quit])
                 ];
      Focused := Option.Some(Ids.TuiControlIdCreate(3));
    end;
  end if;

  return Elements.TuiElementMakeDesktop(Focused, [
                                                   Elements.TuiElementMakeMenuBar([
                                                                                    Chrome.TuiMenuItemWithShortcut(Ids.TuiControlIdCreate(4), 'File', Ids.TuiActionCreate(3), 'F')
                                                                                  ]),
                                                   Elements.TuiElementMakePanel('Tui interactive demo', Content),
                                                   Elements.TuiElementMakeStatusLine([Chrome.TuiStatusItemMakeHint('Type, confirm, then quit')])
                                                 ]);
end function;

begin
  discard Runtime.TuiApplicationRun(DemoModel(Text := '', Caret := 0, Confirming := false), UpdateDemo, ViewDemo);
end program;
