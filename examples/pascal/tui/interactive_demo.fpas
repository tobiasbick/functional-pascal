program TuiInteractiveDemo;

uses Std.Tui as Tui;

type DemoModel = record
  Text: string;
  Caret: integer;
  Confirming: boolean;
end record;

function UpdateDemo(State: DemoModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): DemoModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        return State;
      end;
    when Tui.TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      begin
        return State;
      end;
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        return DemoModel(Text := Text, Caret := Caret, Confirming := State.Confirming);
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        if Action.Value = 2 then
          begin
            return DemoModel(Text := State.Text, Caret := State.Caret, Confirming := true);
          end;
        end if;

        if Action.Value = 3 then
          begin
            Cmd.Set(Tui.TuiCmd.Quit);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return State;
      end;
    when Tui.TuiMsg.Key(const Key):
      begin
        return State;
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return State;
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return State;
      end;
    when Tui.TuiMsg.Resize(const Size):
      begin
        return State;
      end;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        return State;
      end;
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const TextAreaOffset):
      begin
        return State;
      end;
    when Tui.TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        return State;
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return State;
      end;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return State;
      end;
    when Tui.TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        return State;
      end;
  end case;
end function;

function ViewDemo(State: DemoModel): Tui.TuiElement;
begin
  var Input: Tui.TuiElement := Tui.TuiElementBuilders.MakeInput(Tui.TuiControlId.Create(1), State.Text, State.Caret, Tui.TuiAction.Create(1));
  var Confirm: Tui.TuiElement := Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(2), 'Confirm', Tui.TuiAction.Create(2));
  var Quit: Tui.TuiElement := Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(3), 'Quit', Tui.TuiAction.Create(3));
  mutable var Content: array of (Tui.TuiElement) := [Input, Confirm, Quit];
  mutable var Focused: Option of (Tui.TuiControlId) := Option.Some(Tui.TuiControlId.Create(1));
  if State.Confirming then
    begin
      Content := [
                   Tui.TuiElementBuilders.MakeOverlay('Confirm', [Tui.TuiElementBuilders.MakeLabel(State.Text), Quit])
                 ];
      Focused := Option.Some(Tui.TuiControlId.Create(3));
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(Focused, [
                                                       Tui.TuiElementBuilders.MakeMenuBar([
                                                                                            Tui.TuiMenuItem.WithShortcut(Tui.TuiControlId.Create(4), 'File', Tui.TuiAction.Create(3), 'F')
                                                                                          ]),
                                                       Tui.TuiElementBuilders.MakePanel('Tui interactive demo', Content),
                                                       Tui.TuiElementBuilders.MakeStatusLine([
                                                                                               Tui.TuiStatusItemBuilders.MakeHint('Type, confirm, then quit')
                                                                                             ])
                                                     ]);
end function;

begin
  discard Tui.TuiApplication.Run(DemoModel(Text := '', Caret := 0, Confirming := false), UpdateDemo, ViewDemo);
end program;
