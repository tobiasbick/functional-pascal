program TuiInteractiveDemo;

uses Std.Ui.Terminal as Tui;

type DemoModel = record
  Text: string;
  Caret: integer;
  Confirming: boolean;
  Focus: integer;
end record;

function UpdateDemo(State: DemoModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): DemoModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        return State;
      end;
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        return State with Text := Text; Caret := Caret; end with;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        if Action.Value = 2 then
          begin
            return State with Confirming := true; Focus := 3; end with;
          end;
        end if;

        if Action.Value = 3 then
          begin
            Cmd.Set(Tui.TuiCmd.Quit);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return State;
      end;
    when Tui.TuiMsg.Key(const Key):
      begin
        return State;
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return State;
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return State;
      end;
    when Tui.TuiMsg.Resize(const Size):
      begin
        return State;
      end;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Control):
            return State with Focus := Control.Value; end with;
          when None:
            return State;
        end case;
      end;
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const TextAreaOffset):
      begin
        return State;
      end;
    when Tui.TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        return State;
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return State;
      end;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return State;
      end;
    when Tui.TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        return State;
      end;
    when Tui.TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      begin
        return State;
      end;
  end case;
end function;

const ConfirmButton: Tui.TuiElement := Tui.TuiElementBuilders.MakeButton(
  Tui.TuiControlId.Create(2), 'Confirm', Tui.TuiAction.Create(2)
);
const QuitButton: Tui.TuiElement := Tui.TuiElementBuilders.MakeButton(
  Tui.TuiControlId.Create(3), 'Quit', Tui.TuiAction.Create(3)
);
const Menu: Tui.TuiElement := Tui.TuiElementBuilders.MakeMenuBar([
  Tui.TuiMenuItem.WithShortcut(Tui.TuiControlId.Create(4), 'File', Tui.TuiAction.Create(3), 'F')
]);
const Footer: Tui.TuiElement := Tui.TuiElementBuilders.MakeStatusLine([
  Tui.TuiStatusItemBuilders.MakeHint('Type, confirm, then quit')
]);

function BuildConfirmation(Text: string): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    'Confirm',
    [Tui.TuiElementBuilders.MakeLabel(Text), QuitButton]
  );
end function;

function SameText(Previous: string; Current: string): boolean;
begin
  return Previous = Current;
end function;

const Confirmation: Tui.TuiSubview of string := Tui.TuiSubview.Create(BuildConfirmation, SameText);

function ViewDemo(State: DemoModel): Tui.TuiElement;
begin
  const Input: Tui.TuiElement := Tui.TuiElementBuilders.MakeInput(
    Tui.TuiControlId.Create(1),
    State.Text,
    State.Caret,
    Tui.TuiAction.Create(1)
  );
  var Content: array of Tui.TuiElement := [Input, ConfirmButton, QuitButton];
  var Focused: option of Tui.TuiControlId := Some(Tui.TuiControlId.Create(State.Focus));
  if State.Confirming then
    begin
      Content := [Confirmation.Render(State.Text)];
      Focused := Some(Tui.TuiControlId.Create(3));
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(
    Focused, [
      Menu,
      Tui.TuiElementBuilders.MakePanel('Tui interactive demo', Content),
      Footer
    ]
  );
end function;

begin
  discard Tui.TuiApplication.Run(
    DemoModel(Text := '', Caret := 0, Confirming := false, Focus := 1),
    UpdateDemo,
    ViewDemo
  );
end.
