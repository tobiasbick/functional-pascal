program TuiInteractiveDemo;

uses Std.Tui as Tui;

type DemoModel = record
  Text: string;
  Caret: integer;
  Confirming: boolean;
end record;

function UpdateDemo(State: DemoModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): DemoModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        return State;
      end;
    when Tui.TuiMsg.BackgroundFailed(Id, Kind, Message, Code, Line, Column):
      begin
        return State;
      end;
    when Tui.TuiMsg.TextChanged(Source, Action, Text, Caret):
      begin
        return record
          Text := Text;
          Caret := Caret;
          Confirming := State.Confirming;
        end record;
      end;
    when Tui.TuiMsg.Action(Source, Action):
      begin
        if Action.Value = 2 then
          begin
            return record
              Text := State.Text;
              Caret := State.Caret;
              Confirming := true;
            end record;
          end;
        end if;

        if Action.Value = 3 then
          begin
            Cmd.Set(Tui.TuiCmd.Quit);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return State;
      end;
    when Tui.TuiMsg.Key(Key):
      begin
        return State;
      end;
    when Tui.TuiMsg.Pointer(Pointer):
      begin
        return State;
      end;
    when Tui.TuiMsg.Tick(Delta):
      begin
        return State;
      end;
    when Tui.TuiMsg.Resize(Size):
      begin
        return State;
      end;
    when Tui.TuiMsg.FocusChanged(Previous, Current):
      begin
        return State;
      end;
    when Tui.TuiMsg.TextAreaChanged(Source, Action, Text, Caret, TextAreaOffset):
      begin
        return State;
      end;
    when Tui.TuiMsg.CheckChanged(Source, Action, Checked):
      begin
        return State;
      end;
    when Tui.TuiMsg.SelectionChanged(Source, Action, Selected):
      begin
        return State;
      end;
    when Tui.TuiMsg.ScrollChanged(Source, Action, Offset):
      begin
        return State;
      end;
    when Tui.TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
      begin
        return State;
      end;
  end case;
end function;

function ViewDemo(State: DemoModel): Tui.TuiElement;
begin
  var Input: Tui.TuiElement := Tui.TuiElementBuilders.MakeInput(Tui.TuiControlId.Create(1), State.Text, State.Caret, Tui.TuiAction.Create(1));
  var Confirm: Tui.TuiElement := Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(2), 'Confirm', Tui.TuiAction.Create(2));
  var Quit: Tui.TuiElement := Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(3), 'Quit', Tui.TuiAction.Create(3));
  mutable var Content: array of Tui.TuiElement := [Input, Confirm, Quit];
  mutable var Focused: option of Tui.TuiControlId := Some(Tui.TuiControlId.Create(1));
  if State.Confirming then
    begin
      Content := [
                   Tui.TuiElementBuilders.MakeOverlay('Confirm', [Tui.TuiElementBuilders.MakeLabel(State.Text), Quit])
                 ];
      Focused := Some(Tui.TuiControlId.Create(3));
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(Focused, [
                                                       Tui.TuiElementBuilders.MakeMenuBar([
                                                                                            Tui.TuiMenuItem.WithShortcut(Tui.TuiControlId.Create(4), 'File', Tui.TuiAction.Create(3), 'F')
                                                                                          ]),
                                                       Tui.TuiElementBuilders.MakePanel('Tui interactive demo', Content),
                                                       Tui.TuiElementBuilders.MakeStatusLine([
                                                                                               Tui.TuiStatusItemBuilders.MakeHint('Type, confirm, then quit')
                                                                                             ])
                                                     ]);
end function;

begin
  discard Tui.TuiApplication.Run(record
    Text := '';
    Caret := 0;
    Confirming := false;
  end record, UpdateDemo, ViewDemo);
end program;
