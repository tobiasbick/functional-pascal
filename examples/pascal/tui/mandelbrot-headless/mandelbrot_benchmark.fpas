// Measures production rendering, optionally including headless grid updates and paint.
program MandelbrotBenchmark;

uses Mandelbrot.Color as Color;
uses Mandelbrot.Render as Render;
uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Std.Tui.Cells as Cells2;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Runtime as Runtime;

function Update(Grid: Tui.TuiCellGrid; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Tui.TuiCellGrid;
begin
  return Grid;
end function;

function View(Grid: Tui.TuiCellGrid): Tui.TuiElement;
begin
  return Elements.TuiElementMakeCellGrid(Grid);
end function;

function RenderOnce(Paint: boolean): integer;
begin
  const Width: integer := 152;
  const Height: integer := 35;
  const Request: Render.MandelbrotRenderRequest := Render.MandelbrotRenderRequest(Generation := 1, XMin := -3.355714285714286, XMax := 1.855714285714286, YMin := -1.2, YMax := 1.2, Width := Width, Height := Height, MaxIter := 160, Palette := Color.PaletteKind.DeepOcean);
  const Inbox: channel of (Render.MandelbrotRenderFrame) := Tasks.CreateChannel(8);
  const Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  const Worker: task := go Render.RunBackgroundRender(Request, Inbox, Tasks.GetCancellationToken(Source));
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(Width, Height));
  var Grid: Tui.TuiCellGrid := Chrome.TuiCellGridCreate(Width, Height, Arrays.Fill(Cells2.TuiCellStyled(' ', Cells2.TuiStyleFromColors(Cells2.TuiColorFromRgb(0, 0, 0), Cells2.TuiColorFromRgb(0, 0, 0))), Width *
                                                                                                                                                                                                           Height));
  var Count: integer := 0;
  while Count < Width * Height do
    begin
      const Message: Render.MandelbrotRenderFrame := Results.Unwrap(Tasks.ReceiveWithTimeout(Inbox, 30000));
      Count := Count + Arrays.Length(Message.Cells);
      if Paint then
        begin
          Grid := Chrome.TuiCellGridCreate(Width, Height, Message.Cells);
          Grid := Runtime.TuiApplicationRunIterations(App, Grid, Update, View, 1, 0);
        end;
      end if;
    end;
  end while;

  if not Results.IsOk(Tasks.Wait(Worker)) then
    begin
      panic('render failed');
    end;
  end if;

  Runtime.TuiApplicationClose(App);
  discard Tasks.CloseChannel(Inbox);
  return Count;
end function;

begin
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  const Paint: boolean := Args.ParamStr(1) = 'paint';
  if Iterations < 1 then
    begin
      panic('iterations must be positive');
    end;
  end if;
  var Checksum: integer := RenderOnce(Paint);
  const Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      Checksum := Checksum + RenderOnce(Paint);
    end;
  end for;
  const Elapsed: integer := Time.ElapsedMillis(Started);
  if Checksum <> ((Iterations + 1) * 152) * 35 then
    begin
      panic('incomplete render');
    end;
  end if;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  Console.WriteLn('checksum: ' + Conv.IntToStr(Checksum));
end program;
