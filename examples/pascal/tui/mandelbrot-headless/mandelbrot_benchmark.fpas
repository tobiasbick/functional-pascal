// Measures production rendering, optionally including headless grid updates and paint.
program MandelbrotBenchmark;

uses
  Mandelbrot.Color as Color, Mandelbrot.Render as Render, Std.Os.Args as Args, Std.Console as Console,
  Std.Text.Format as Conv, Std.Tasks as Tasks, Std.Time as Time, Std.Ui.Terminal as Tui, Std.Text.Parse as Parse;

function Update(Grid: Tui.TuiCellGrid; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Tui.TuiCellGrid;
begin
  return Grid;
end function;

function View(Grid: Tui.TuiCellGrid): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeCellGrid(Grid);
end function;

function RenderOnce(Paint: boolean): integer;
begin
  scope
    const Width: integer := 152;
    const Height: integer := 35;
    const Request: Render.MandelbrotRenderRequest := Render.MandelbrotRenderRequest(
      Generation := 1,
      XMin := -3.355714285714286,
      XMax := 1.855714285714286,
      YMin := -1.2,
      YMax := 1.2,
      Width := Width,
      Height := Height,
      MaxIter := 160,
      Palette := Color.PaletteKind.DeepOcean
    );
    const Inbox: channel of Render.MandelbrotRenderFrame := Tasks.CreateChannel(8);
    const Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
    const Worker: task of result of (boolean, string) := go Render.RunBackgroundRender(
      Request,
      Inbox,
      Tasks.GetCancellationToken(Source)
    );
    const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(
      Tui.TuiSize.Create(Width, Height)
    );
    var Grid: Tui.TuiCellGrid := Tui.TuiCellGrid.Create(
      Width, Height, array.Fill(
        Tui.TuiCell.Styled(
          ' ',
          Tui.TuiStyle.FromColors(Tui.TuiColor.FromRgb(0, 0, 0), Tui.TuiColor.FromRgb(0, 0, 0))
        ), Width *
        Height
      )
    );
    var Count: integer := 0;
    while Count < Width * Height do
      begin
        const Message: Render.MandelbrotRenderFrame := Tasks.ReceiveWithTimeout(
          Inbox,
          30000
        ).Unwrap();
        Count := Count + Message.Cells.Length();
        if Paint then
          begin
            Grid := Tui.TuiCellGrid.Create(Width, Height, Message.Cells);
            Grid := App.RunIterations(Grid, Update, View, 1, 0);
          end;
        end if;
      end;
    end while;

    if not (Tasks.Wait(Worker) is Ok(_)) then
      begin
        panic('render failed');
      end;
    end if;

    App.Close();
    discard Tasks.CloseChannel(Inbox);
    return Count;
  end scope;
end function;

begin
  const Iterations: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  const Paint: boolean := Args.ParamStr(1) = 'paint';
  if Iterations < 1 then
    begin
      panic('iterations must be positive');
    end;
  end if;
  var Checksum: integer := RenderOnce(Paint);
  const Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      Checksum := Checksum + RenderOnce(Paint);
    end;
  end for;
  const Elapsed: integer := Time.ElapsedMillis(Started);
  if Checksum <> (Iterations + 1) * 152 * 35 then
    begin
      panic('incomplete render');
    end;
  end if;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Elapsed) + ' ms');
  Console.WriteLn('checksum: ' + Conv.IntToStr(Checksum));
end.
