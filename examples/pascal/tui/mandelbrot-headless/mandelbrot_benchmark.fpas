// Measures production rendering, optionally including headless grid updates and paint.
program MandelbrotBenchmark;

uses Mandelbrot.Color as Color;
uses Mandelbrot.Render as Render;
uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Time as Time;
uses Std.Tui as Tui;

function Update(Grid: Tui.TuiCellGrid; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Tui.TuiCellGrid;
begin
  return Grid;
end function;

function View(Grid: Tui.TuiCellGrid): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeCellGrid(Grid);
end function;

function RenderOnce(Paint: boolean): integer;
begin
  var Width: integer := 152;
  var Height: integer := 35;
  var Request: Render.MandelbrotRenderRequest := Render.MandelbrotRenderRequest(Generation := 1, XMin := -3.355714285714286, XMax := 1.855714285714286, YMin := -1.2, YMax := 1.2, Width := Width, Height := Height, MaxIter := 160, Palette := Color.PaletteKind.DeepOcean);
  var Inbox: channel of (Render.MandelbrotRenderFrame) := Tasks.CreateChannel(8);
  var Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  var Worker: task := go Render.RunBackgroundRender(Request, Inbox, Tasks.GetCancellationToken(Source));
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(Width, Height));
  mutable var Grid: Tui.TuiCellGrid := Tui.TuiCellGrid.Create(Width, Height, Arrays.Fill(Tui.TuiCell.Styled(' ', Tui.TuiStyle.FromColors(Tui.TuiColor.FromRgb(0, 0, 0), Tui.TuiColor.FromRgb(0, 0, 0))), Width *
                                                                                                                                                                                                         Height));
  mutable var Count: integer := 0;
  while Count < Width * Height do
    begin
      var Message: Render.MandelbrotRenderFrame := Results.Unwrap(Tasks.ReceiveWithTimeout(Inbox, 30000));
      Count := Count + Arrays.Length(Message.Cells);
      if Paint then
        begin
          Grid := Tui.TuiCellGrid.Create(Width, Height, Message.Cells);
          Grid := App.RunIterations(Grid, Update, View, 1, 0);
        end;
      end if;
    end;
  end while;

  if not Results.IsOk(Tasks.Wait(Worker)) then
    begin
      panic('render failed');
    end;
  end if;

  App.Close();
  discard Tasks.CloseChannel(Inbox);
  return Count;
end function;

begin
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  var Paint: boolean := Args.ParamStr(1) = 'paint';
  if Iterations < 1 then
    begin
      panic('iterations must be positive');
    end;
  end if;
  mutable var Checksum: integer := RenderOnce(Paint);
  var Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      Checksum := Checksum + RenderOnce(Paint);
    end;
  end for;
  var Elapsed: integer := Time.ElapsedMillis(Started);
  if Checksum <> ((Iterations + 1) * 152) * 35 then
    begin
      panic('incomplete render');
    end;
  end if;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  Console.WriteLn('checksum: ' + Conv.IntToStr(Checksum));
end program;
