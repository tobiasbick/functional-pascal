// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run notes-headless-benchmark.fpasprj -- 250
// Guard: target/release/fpas run notes-headless-benchmark.fpasprj -- 250 MAX_MILLIS

program NotesHeadlessBenchmark;

uses Notes.Model, Notes.Update, Notes.View, Std.Args, Std.Console, Std.Conv, Std.Time, Std.Tui;

const WarmupIterations: integer := 25;
const DeltaMillis: integer := 16;
const NoteCount: integer := 40;

function BenchmarkNotes(): array of Note;
begin
  var Notes: array of Note := [];
  for Index: integer := 1 to NoteCount do
    begin
      var NoteValue: Note := NoteCreate('benchmark-' + IntToStr(Index), 1700000000000 + Index);
      NoteValue.Title := ('Performance note ' + IntToStr(Index)) + ' with a representative title';
      NoteValue.Tags := ['performance', 'tui', 'benchmark'];
      NoteValue.Pinned := (Index mod 7) = 0;
      NoteValue.Body := ((('This is a representative note body for frame ' + IntToStr(Index)) + '.') + string.Chr(10)) +
                        'It keeps the editor, list, metadata, and layout paths active.';
      Notes.Push(NoteValue);
    end;
  end for;

  return Notes;
end function;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
    begin
      panic('usage: notes-headless-benchmark.fpasprj -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if ParamCount() = 2 then
    begin
      MaxMillis := StrToInt(ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  const Loaded: NotesLoad := notes.model.notesload(Notes := BenchmarkNotes(), Issues := []);
  var Model: NotesModel := NotesModelCreate('.temp-data/bench/notes', Loaded);
  Model.Width := 120;
  Model.Height := 40;
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(120, 40));
  Model := App.RunIterations(Model, NotesUpdate, NotesView, WarmupIterations, DeltaMillis);
  const Started: integer := MonotonicMillis();
  Model := App.RunIterations(Model, NotesUpdate, NotesView, Iterations, DeltaMillis);
  const Elapsed: integer := ElapsedMillis(Started);
  App.Close();
  var FramesPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      FramesPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  WriteLn((('iterations: ' + IntToStr(Iterations)) + ', warm-up: ') + IntToStr(WarmupIterations));
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      WriteLn(('throughput: ' + IntToStr(FramesPerSecond)) + ' frames/s');
    end;
  else
    begin
      WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  WriteLn('notes rendered: ' + IntToStr(Model.Notes.Length()));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('Notes TUI benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end.
