// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run notes-headless-benchmark.fpasprj -- 250
// Guard: target/release/fpas run notes-headless-benchmark.fpasprj -- 250 MAX_MILLIS

program NotesHeadlessBenchmark;

uses Notes.Model as Model2;
uses Notes.Update as Update;
uses Notes.View as View;
uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;
uses Std.Time as Time;
uses Std.Tui as Tui;

const WarmupIterations: integer := 25;
const DeltaMillis: integer := 16;
const NoteCount: integer := 40;

function BenchmarkNotes(): array of Model2.Note;
begin
  mutable var Notes: array of Model2.Note := [];
  for Index: integer := 1 to NoteCount do
    begin
      mutable var NoteValue: Model2.Note := Model2.NoteCreate('benchmark-' + Conv.IntToStr(Index), 1700000000000 +
                                                                                                   Index);
      NoteValue.Title := ('Performance note ' + Conv.IntToStr(Index)) +
                         ' with a representative title';
      NoteValue.Tags := ['performance', 'tui', 'benchmark'];
      NoteValue.Pinned := (Index mod 7) = 0;
      NoteValue.Body := ((('This is a representative note body for frame ' + Conv.IntToStr(Index)) + '.') + Str.Chr(10)) +
                        'It keeps the editor, list, metadata, and layout paths active.';
      Arrays.Push(Notes, NoteValue);
    end;
  end for;

  return Notes;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: notes-headless-benchmark.fpasprj -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  mutable var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var Loaded: Model2.NotesLoad := record
    Notes := BenchmarkNotes();
    Issues := [];
  end record;
  mutable var Model: Model2.NotesModel := Model2.NotesModelCreate('.temp-data/bench/notes', Loaded);
  Model.Width := 120;
  Model.Height := 40;
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(120, 40));
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, WarmupIterations, DeltaMillis);
  var Started: integer := Time.MonotonicMillis();
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, Iterations, DeltaMillis);
  var Elapsed: integer := Time.ElapsedMillis(Started);
  App.Close();
  mutable var FramesPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      FramesPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn((('iterations: ' + Conv.IntToStr(Iterations)) + ', warm-up: ') +
                  Conv.IntToStr(WarmupIterations));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(FramesPerSecond)) + ' frames/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('notes rendered: ' + Conv.IntToStr(Arrays.Length(Model.Notes)));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('Notes TUI benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
