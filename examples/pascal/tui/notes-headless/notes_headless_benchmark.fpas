// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run notes-headless-benchmark.fpasprj -- 250
// Guard: target/release/fpas run notes-headless-benchmark.fpasprj -- 250 MAX_MILLIS

program NotesHeadlessBenchmark;

uses
  Notes.Model as NotesModel, Notes.Update as Update, Notes.View as View, Std.Os.Args as Args,
  Std.Console as Console, Std.Text.Format as Conv, Std.Time as Time, Std.Ui.Terminal as Tui, Std.Text.Parse as Parse;

const WarmupIterations: integer := 25;
const DeltaMillis: integer := 16;
const NoteCount: integer := 40;

function BenchmarkNotes(): array of NotesModel.Note;
begin
  var Notes: array of NotesModel.Note := [];
  for Index: integer := 1 to NoteCount do
    begin
      var NoteValue: NotesModel.Note := NotesModel.NoteCreate(
        'benchmark-' + Conv.IntToStr(Index), 1700000000000 +
        Index
      );
      NoteValue.Title := 'Performance note ' + Conv.IntToStr(Index) +
        ' with a representative title';
      NoteValue.Tags := ['performance', 'tui', 'benchmark'];
      NoteValue.Pinned := (Index mod 7) = 0;
      NoteValue.Body := 'This is a representative note body for frame ' + Conv.IntToStr(Index) +
        '.' + string.Chr(10) +
        'It keeps the editor, list, metadata, and layout paths active.';
      Notes.PushInPlace(NoteValue);
    end;
  end for;

  return Notes;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: notes-headless-benchmark.fpasprj -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Parse.Int(Args.ParamStr(1)).Unwrap();
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  const Loaded: NotesModel.NotesLoad := NotesModel.NotesLoad(
    Notes := BenchmarkNotes(),
    Issues := []
  );
  var Model: NotesModel.NotesModel := NotesModel.NotesModelCreate('.temp-data/bench/notes', Loaded);
  Model.Width := 120;
  Model.Height := 40;
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(120, 40));
  Model := App.RunIterations(
    Model,
    Update.NotesUpdate,
    View.NotesView,
    WarmupIterations,
    DeltaMillis
  );
  const Started: integer := Time.MonotonicMillis();
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, Iterations, DeltaMillis);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  App.Close();
  var FramesPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      FramesPerSecond := Iterations * 1000 div Elapsed;
    end;
  end if;

  Console.WriteLn(
    'iterations: ' + Conv.IntToStr(Iterations) + ', warm-up: ' +
    Conv.IntToStr(WarmupIterations)
  );
  Console.WriteLn('elapsed: ' + Conv.IntToStr(Elapsed) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn('throughput: ' + Conv.IntToStr(FramesPerSecond) + ' frames/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('notes rendered: ' + Conv.IntToStr(Model.Notes.Length()));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(
        'Notes TUI benchmark regression: ' + Conv.IntToStr(Elapsed) + ' ms exceeds limit ' +
        Conv.IntToStr(MaxMillis) +
        ' ms'
      );
    end;
  end if;
end.
