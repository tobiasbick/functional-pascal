{ Poll-style TUI — run in a terminal; Escape exits. See docs/pascal/11-stdlib.md. }
program PollRedrawTimeout;
uses Std.Console, Std.Tui, Std.Option;

procedure Paint(App: Application);
begin
  var S: Size := Application.Size(App);
  ClrScr();
  GotoXY(1, 1);
  WriteLn('Poll-style Std.Tui (Escape exits)');
  WriteLn('Size: ', S.width, 'x', S.height)
end;

begin
  var App: Application := Application.Open();
  Application.RequestRedraw(App);

  mutable var Quit: boolean := false;
  while not Quit do
  begin
    if Application.RedrawPending(App) then
      Paint(App);

    case Application.ReadEventTimeout(App, 16) of
      Some(E):
        if E.kind = EventKind.Key then
        begin
          if E.key.kind = KeyKind.Escape then
            Quit := true
          else
            Application.RequestRedraw(App)
        end
        else if E.kind = EventKind.Resize then
          Application.RequestRedraw(App);
      None: begin end
    end
  end;

  Application.Close(App)
end.
