{ Runtime property setters demo. Run in a terminal; press Toggle to update the }
{ label and check box, then Quit to exit. }

program TuiRuntimeSetters;

uses Std.Tui;

const
  CmdToggle: integer := 50;

mutable var
  mutable var LabelHandle: StaticText := record  end;
  mutable var CheckHandle: CheckBox := record  end;
  mutable var Checked: boolean := false;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdToggle then
  begin
    Checked := not Checked;
    CheckBox.SetChecked(CheckHandle, Checked);
    if Checked then
    begin
      StaticText.SetText(LabelHandle, 'Enabled')
    end
    else
    begin
      StaticText.SetText(LabelHandle, 'Disabled')
    end
  end
  else if CommandId = CM_QUIT then
  begin
    Application.Quit(App)
  end
end;

begin
  var App: Application := Application.Open();
  var Win: Window := Window.New(Bounds(10, 5, 44, 11), 'Runtime setters');
  LabelHandle := StaticText.New(Bounds(4, 2, 20, 1), 'Disabled');
  CheckHandle := CheckBox.New(Bounds(4, 4, 20, 1), 'option', false);
  var ToggleButton: Button := Button.New(Bounds(4, 6, 12, 2), '~T~oggle', CmdToggle, false);
  var QuitButton: Button := Button.New(Bounds(18, 6, 10, 2), '~Q~uit', CM_QUIT, false);
  Window.Add(Win, LabelHandle);
  Window.Add(Win, CheckHandle);
  Window.Add(Win, ToggleButton);
  Window.Add(Win, QuitButton);
  Desktop.Add(App, Win);
  Application.Run(App, OnCommand);
  Application.Close(App)
end.
