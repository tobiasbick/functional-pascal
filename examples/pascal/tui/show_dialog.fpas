{ ShowDialog demo - owned modal root, host widgets, and validated modal results. }

program TuiShowDialog;

uses Std.Console, Std.Str, Std.Tui;

const
  CmdOpenDialog: integer := 1;
  CmdDialogOk: integer := 2;
  CmdDialogCancel: integer := 3;
  CmdQuit: integer := 99;
  DialogModalId: integer := 10;
  ModalResultAccept: integer := 1;
  ModalResultCancel: integer := 2;
  DialogWidth: integer := 34;
  DialogHeight: integer := 9;

mutable var
  mutable var DialogRoot: option of ViewId := None;
  mutable var LastResult: string := 'none';

procedure PaintDialogChrome(App: Application; ViewId: ViewId; Bounds: Std.Tui.Rect);
begin
  GotoXY(2, 1);
  Write('Confirm action');
  GotoXY(2, 3);
  Write('Save changes before closing?')
end;

procedure PaintDialogButton(App: Application; ViewId: ViewId; Bounds: Std.Tui.Rect; Caption: string);
begin
  GotoXY(1, 1);
  Write(Caption)
end;

procedure PaintOkButton(App: Application; ViewId: ViewId; Bounds: Std.Tui.Rect);
begin
  PaintDialogButton(App, ViewId, Bounds, '[ OK ]')
end;

procedure PaintCancelButton(App: Application; ViewId: ViewId; Bounds: Std.Tui.Rect);
begin
  PaintDialogButton(App, ViewId, Bounds, '[ Cancel ]')
end;

procedure CloseDialog(App: Application; ResultCode: integer);
begin
  if DialogRoot = None then
  begin
    return
  end;
  Application.HostSetActiveModalResult(App, ResultCode);
  Application.CloseModal(App);
  if ResultCode = ModalResultAccept then
  begin
    LastResult := 'Accept'
  end
  else if ResultCode = ModalResultCancel then
  begin
    LastResult := 'Cancel'
  end
  else
  begin
    LastResult := 'Command'
  end;
  DialogRoot := None;
  Application.RequestRedraw(App)
end;

procedure OpenDialog(App: Application);
begin
  if DialogRoot <> None then
  begin
    return
  end;
  var S: Size := Application.Size(App);
  var RawX: integer := ((S.width - DialogWidth) / 2) + 1;
  var RawY: integer := ((S.height - DialogHeight) / 2) + 1;
  mutable var X: integer := RawX;
  mutable var Y: integer := RawY;
  if X < 1 then
  begin
    X := 1
  end;
  if Y < 1 then
  begin
    Y := 1
  end;
  var Root: ViewId := Application.ShowDialog(App, DialogModalId, X, Y, DialogWidth, DialogHeight);
  DialogRoot := Some(Root);
  var Body: ViewId := Application.HostCreateSolidFillView(App, 0, 0, DialogWidth - 2, DialogHeight -

                                                                                      2, LightGray, Some(Black), None);
  Application.HostSetViewParent(App, Body, Some(Root));
  Application.HostSetViewRect(App, Body, 1, 1, DialogWidth - 2, DialogHeight - 2);
  Application.HostRegisterOnViewPaint(App, Root, PaintDialogChrome);
  var OkView: ViewId := Application.HostRegisterView(App, 0, 0, 8, 1);
  var CancelView: ViewId := Application.HostRegisterView(App, 0, 0, 12, 1);
  Application.HostSetViewParent(App, OkView, Some(Root));
  Application.HostSetViewParent(App, CancelView, Some(Root));
  Application.HostSetViewRect(App, OkView, 4, 6, 8, 1);
  Application.HostSetViewRect(App, CancelView, 20, 6, 12, 1);
  Application.HostPushChildView(App, OkView);
  Application.HostPushChildView(App, CancelView);
  Application.HostRegisterOnViewPaint(App, OkView, PaintOkButton);
  Application.HostRegisterOnViewPaint(App, CancelView, PaintCancelButton);
  var EscapeKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Escape;
    ch := Std.Str.Chr(27);
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  Application.HostBindCommandToActiveModal(App, EscapeKey, CmdDialogCancel);
  Application.RequestRedraw(App)
end;

procedure OnPaint(App: Application);
begin
  ClrScr();
  GotoXY(1, 1);
  WriteLn('ShowDialog with modal results');
  GotoXY(1, 2);
  WriteLn('Modal depth: ', Application.QueryModalDepth(App));
  GotoXY(1, 3);
  WriteLn('Last result: ', LastResult);
  GotoXY(1, 5);
  WriteLn('Ctrl+D opens the dialog.');
  GotoXY(1, 6);
  WriteLn('Tab to OK or Cancel, Enter accepts, Escape cancels.');
  GotoXY(1, 7);
  WriteLn('Ctrl+Q exits the application.')
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdOpenDialog then
  begin
    OpenDialog(App)
  end
  else if CommandId = CmdDialogOk then
  begin
    CloseDialog(App, ModalResultAccept)
  end
  else if CommandId = CmdDialogCancel then
  begin
    CloseDialog(App, ModalResultCancel)
  end
  else if CommandId = CmdQuit then
  begin
    Application.HostRequestQuit(App)
  end
end;

procedure OnResize(App: Application; NewSize: Size);
begin
  Application.RequestRedraw(App)
end;

begin
  var App: Application := Application.Open();
  var OpenDialogKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Character;
    ch := 'd';
    shift := false;
    ctrl := true;
    alt := false;
    meta := false;
  end;
  var QuitKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Character;
    ch := 'q';
    shift := false;
    ctrl := true;
    alt := false;
    meta := false;
  end;
  var EnterKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Enter;
    ch := Std.Str.Chr(13);
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  Application.HostBindCommand(App, OpenDialogKey, CmdOpenDialog);
  Application.HostBindCommand(App, QuitKey, CmdQuit);
  Application.HostBindCommandToActiveModal(App, EnterKey, CmdDialogOk);
  var Handlers: ApplicationHandlers := record
    OnPaint := OnPaint;
    OnResize := Some(OnResize);
    OnCommand := Some(OnCommand);
  end;
  Application.Configure(App, Handlers);
  Application.Run(App)
end.
