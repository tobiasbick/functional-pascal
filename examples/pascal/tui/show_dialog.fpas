{ ShowDialog demo — owned framed modal with host controls and validated results. }

program TuiShowDialog;

uses Std.Console, Std.Str, Std.Tui;

const
  CmdOpenDialog: integer := 1;
  CmdDialogOk: integer := 2;
  CmdDialogCancel: integer := 3;
  CmdQuit: integer := 99;
  DialogModalId: integer := 10;
  ModalResultAccept: integer := 1;
  ModalResultCancel: integer := 2;
  DialogWidth: integer := 34;
  DialogHeight: integer := 9;

mutable var
  mutable var RootView: option of ViewId := None;
  mutable var LastResult: string := 'none';

procedure CloseDialog(App: Application; ResultCode: integer);
begin
  if Application.QueryModalDepth(App) = 0 then
  begin
    return
  end;
  Application.HostSetActiveModalResult(App, ResultCode);
  Application.CloseModal(App);
  if ResultCode = ModalResultAccept then
  begin
    LastResult := 'Accept'
  end
  else if ResultCode = ModalResultCancel then
  begin
    LastResult := 'Cancel'
  end
  else
  begin
    LastResult := 'Command'
  end;
  Application.RequestRedraw(App)
end;

procedure OpenDialog(App: Application);
begin
  if Application.QueryModalDepth(App) > 0 then
  begin
    return
  end;
  var S: Size := Application.Size(App);
  var RawX: integer := ((S.width - DialogWidth) div 2) + 1;
  var RawY: integer := ((S.height - DialogHeight) div 2) + 1;
  mutable var X: integer := RawX;
  mutable var Y: integer := RawY;
  if X < 1 then
  begin
    X := 1
  end;
  if Y < 1 then
  begin
    Y := 1
  end;
  var Dialog: ViewId := Application.ShowFramedDialog(App, DialogModalId, X, Y, DialogWidth, DialogHeight, 'Confirm action', false, false, false, false, true);
  var Message: ViewId := Application.HostCreateLabelView(App, 0, 0, 28, 1, 'Save changes before closing?', None);
  Application.HostSetViewParent(App, Message, Some(Dialog));
  Application.HostSetViewRect(App, Message, 2, 1, 28, 1);
  var OkView: ViewId := Application.HostCreateButtonView(App, 0, 0, 8, 1, 'OK', Some(CmdDialogOk), true);
  Application.HostSetViewParent(App, OkView, Some(Dialog));
  Application.HostSetViewRect(App, OkView, 4, 4, 8, 1);
  var CancelView: ViewId := Application.HostCreateButtonView(App, 0, 0, 12, 1, 'Cancel', Some(CmdDialogCancel), false);
  Application.HostSetViewParent(App, CancelView, Some(Dialog));
  Application.HostSetViewRect(App, CancelView, 16, 4, 12, 1);
  var EscapeKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Escape;
    ch := Std.Str.Chr(27);
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  var EnterKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Enter;
    ch := Std.Str.Chr(13);
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  Application.HostBindCommandToActiveModal(App, EnterKey, CmdDialogOk);
  Application.HostBindCommandToActiveModal(App, EscapeKey, CmdDialogCancel);
  Application.RequestRedraw(App)
end;

procedure ClearBounds(Bounds: Std.Tui.Rect);
begin
  for Row: integer := 0 to Bounds.height - 1 do
  begin
    GotoXY(1, Row + 1);
    for Col: integer := 0 to Bounds.width - 1 do
    begin
      Write(' ')
    end
  end
end;

procedure OnViewPaint(App: Application; ViewId: ViewId; Bounds: Std.Tui.Rect);
begin
  ClearBounds(Bounds);
  GotoXY(1, 1);
  WriteLn('ShowDialog with framed modal results');
  GotoXY(1, 2);
  WriteLn('Modal depth: ', Application.QueryModalDepth(App));
  GotoXY(1, 3);
  WriteLn('Last result: ', LastResult);
  GotoXY(1, 5);
  WriteLn('Ctrl+D opens the dialog.');
  GotoXY(1, 6);
  WriteLn('Tab to OK or Cancel, Enter accepts, Escape cancels.');
  GotoXY(1, 7);
  WriteLn('Title-bar close (■) dismisses without a result code.');
  GotoXY(1, 8);
  WriteLn('Ctrl+Q exits the application.')
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdOpenDialog then
  begin
    OpenDialog(App)
  end
  else if CommandId = CmdDialogOk then
  begin
    CloseDialog(App, ModalResultAccept)
  end
  else if CommandId = CmdDialogCancel then
  begin
    CloseDialog(App, ModalResultCancel)
  end
  else if CommandId = CmdQuit then
  begin
    Application.HostRequestQuit(App)
  end
end;

procedure OnResize(App: Application; NewSize: Size);
begin
  case RootView of
    Some(Root):
    begin
      Application.HostSetViewRect(App, Root, 0, 0, NewSize.width, NewSize.height)
    end;
    None:
    begin
    end
  end;
  Application.RequestRedraw(App)
end;

begin
  var App: Application := Application.Open();
  var S: Size := Application.Size(App);
  var OpenDialogKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Character;
    ch := 'd';
    shift := false;
    ctrl := true;
    alt := false;
    meta := false;
  end;
  var QuitKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Character;
    ch := 'q';
    shift := false;
    ctrl := true;
    alt := false;
    meta := false;
  end;
  var Root: ViewId := Application.HostRegisterView(App, 0, 0, S.width, S.height);
  RootView := Some(Root);
  Application.HostRegisterOnViewPaint(App, Root, OnViewPaint);
  Application.HostBindCommand(App, OpenDialogKey, CmdOpenDialog);
  Application.HostBindCommand(App, QuitKey, CmdQuit);
  var Handlers: ApplicationHandlers := record
    OnResize := Some(OnResize);
    OnCommand := Some(OnCommand);
  end;
  Application.Configure(App, Handlers);
  Application.Run(App)
end.
