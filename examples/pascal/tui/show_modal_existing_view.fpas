{ ShowModal demo — an existing host-managed subtree becomes modal; Tab stays inside the dialog subtree until the modal closes. }

program TuiShowModalExistingView;

uses Std.Console, Std.Tui;

mutable var
  mutable var Status: string := 'The existing dialog subtree is modal. Tab stays inside it. Escape closes the modal.';

procedure OnPaint(App: Application);
begin
  ClrScr();
  GotoXY(1, 1);
  WriteLn('ShowModal on an existing view subtree');
  GotoXY(1, 2);
  WriteLn('Focused view: ', Application.HostQueryFocusedViewId(App));
  GotoXY(1, 3);
  WriteLn('Modal depth: ', Application.HostModalDepth(App));
  GotoXY(1, 4);
  WriteLn(Status);
  GotoXY(1, 6);
  WriteLn('Tab cycles between the two dialog buttons.');
  GotoXY(1, 7);
  WriteLn('Escape closes the modal. Ctrl+Q exits the application.');
  GotoXY(6, 11);
  WriteLn('Background view');
  GotoXY(24, 11);
  WriteLn('[Existing modal root]');
  GotoXY(26, 12);
  WriteLn('[OK]');
  GotoXY(36, 12);
  WriteLn('[Cancel]')
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = 2 then
  begin
    Application.CloseModal(App);
    Status := 'Modal closed. Tab can leave the dialog subtree now.';
    Application.RequestRedraw(App)
  end
  else if CommandId = 99 then
  begin
    Application.HostRequestQuit(App)
  end
end;

function OnKeyPressed(App: Application; Key: Std.Console.KeyEvent): boolean;
begin
  if Key.kind = KeyKind.Escape then
  begin
    Application.HostRequestQuit(App);
    return true
  end;
  return false
end;

procedure OnResize(App: Application; NewSize: Size);
begin
  Application.RequestRedraw(App)
end;

begin
  var App: Application := Application.Open();
  var QuitKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Character;
    ch := 'q';
    shift := false;
    ctrl := true;
    alt := false;
    meta := false;
  end;
  var EscapeKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Escape;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  var BackgroundView: integer := Application.HostRegisterView(App, 4, 10, 14, 4);
  var DialogView: integer := Application.HostRegisterView(App, 22, 10, 24, 5);
  var OkButton: integer := Application.HostRegisterView(App, 2, 2, 6, 1);
  var CancelButton: integer := Application.HostRegisterView(App, 12, 2, 8, 1);
  Application.HostSetViewParent(App, OkButton, DialogView);
  Application.HostSetViewParent(App, CancelButton, DialogView);
  Application.HostPushChildView(App, BackgroundView);
  Application.HostPushChildView(App, OkButton);
  Application.HostPushChildView(App, CancelButton);
  Application.HostRegisterOnPaint(App, OnPaint);
  Application.HostRegisterOnCommand(App, OnCommand);
  Application.HostRegisterOnKeyPressed(App, OnKeyPressed);
  Application.HostRegisterOnResize(App, OnResize);
  Application.HostBindCommand(App, QuitKey, 99);
  Application.ShowModal(App, 10, DialogView);
  Application.HostBindCommandToActiveModal(App, EscapeKey, 2);
  Application.Run(App)
end.
