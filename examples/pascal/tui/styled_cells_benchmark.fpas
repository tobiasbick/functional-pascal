// Measures building concretely styled RGB cells, the per-frame path of pixel renderers such as raycasters.
// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 40
// Guard: target/release/fpas run this-file.fpas -- 40 MAX_MILLIS
program TuiStyledCellsBenchmark;

uses
  Std.Args as Args, Std.Console as Console, Std.Conv as Conv, Std.Time as Time, Std.Tui as Tui,
  Std.Parse as Parse;

// One 128 by 44 cell frame of half-block pixels.
const FrameWidth: integer := 128;
const FrameHeight: integer := 44;

// Builds one frame of cells whose colors vary per cell and returns a checksum of its channels.
function BuildFrame(Frame: integer): integer;
begin
  var Cells: array of Tui.TuiCell := [];
  for Y: integer := 0 to FrameHeight - 1 do
    begin
      for X: integer := 0 to FrameWidth - 1 do
        begin
          const Upper: Tui.TuiColor := Tui.TuiColor.FromRgb((X + Frame) mod 256, Y mod 256, 40);
          const Lower: Tui.TuiColor := Tui.TuiColor.FromRgb(X mod 256, (Y + Frame) mod 256, 80);
          Cells.PushInPlace(Tui.TuiCell.Styled('▀', Tui.TuiStyle.FromColors(Upper, Lower)));
        end;
      end for;
    end;
  end for;
  var Checksum: integer := 0;
  for Cell: Tui.TuiCell in Cells do
    begin
      case Cell.ConcreteStyle of
        when Some(const Style):
          begin
            Checksum := Checksum + Style.Foreground.Red + Style.Background.Green;
          end;
        when None:
          begin
            panic('styled cell lost its style');
          end;
      end case;
    end;
  end for;

  return Checksum;
end function;

function RunFrames(Frames: integer): integer;
begin
  var Total: integer := 0;
  for Frame: integer := 1 to Frames do
    begin
      Total := Total + BuildFrame(Frame);
    end;
  end for;

  return Total;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: styled_cells_benchmark.fpas -- FRAMES [MAX_MILLIS]');
    end;
  end if;
  const Frames: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  if Frames < 1 then
    begin
      panic('FRAMES must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Parse.Int(Args.ParamStr(1)).Unwrap();
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  const Warmup: integer := RunFrames(2);
  const Started: integer := Time.MonotonicMillis();
  const Checksum: integer := RunFrames(Frames);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  if (Warmup <= 0) or (Checksum <= 0) then
    begin
      panic('styled cell checksum mismatch');
    end;
  end if;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Elapsed) + ' ms');
  Console.WriteLn('checksum: ' + Conv.IntToStr(Checksum));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic('styled cells benchmark exceeded MAX_MILLIS');
    end;
  end if;
end.
