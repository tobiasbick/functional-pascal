// Long-document caret rendering through the public headless TUI.
program TextAreaLocateBenchmark;

uses
  Std.Args as Args, Std.Console as Console, Std.Conv as Conv, Std.Time as Time, Std.Tui as Tui,
  Std.Parse as Parse;

function View(Text: string): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(1)), [
                                                                                Tui.TuiElementBuilders.MakeTextArea(Tui.TuiControlId.Create(1), Text, Text.Length(), Tui.TuiPoint.Create(0, 0), Tui.TuiAction.Create(1))
                                                                              ]);
end function;

function Update(Text: string; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): string;
begin
  return Text;
end function;

begin
  if Args.ParamCount() <> 2 then
    begin
      panic('expected ITERATIONS SIZE');
    end;
  end if;
  const Iterations: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  const Size: integer := Parse.Int(Args.ParamStr(1)).Unwrap();
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('arguments must be positive');
    end;
  end if;
  const Text: string := 'é'.RepeatStr(Size);
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(80, 24));
  discard App.RunIterations(Text, Update, View, 0, 0);
  const Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      discard App.RunIterations(Text, Update, View, 0, 0);
    end;
  end for;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started)) + ' ms');
  var Visible: integer := Size;
  if Visible > 80 then
    begin
      Visible := 80;
    end;
  end if;

  if (App.SurfaceSnapshot().LineAt(0)).Slice(0, Visible) <> 'é'.RepeatStr(Visible) then
    begin
      panic('rendered text');
    end;
  end if;

  App.Close();
end.
