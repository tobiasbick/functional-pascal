// Long-document caret rendering through the public headless TUI.
program TextAreaLocateBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering2;
uses Std.Tui.Runtime as Runtime;

function View(Text: string): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(1), Text, Str.Length(Text), Geometry.TuiPointCreate(0, 0), Ids.TuiActionCreate(1))
                                                                                ]);
end function;

function Update(Text: string; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): string;
begin
  return Text;
end function;

begin
  if Args.ParamCount() <> 2 then
    begin
      panic('expected ITERATIONS SIZE');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  const Size: integer := Conv.StrToInt(Args.ParamStr(1));
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('arguments must be positive');
    end;
  end if;
  const Text: string := Str.RepeatStr('é', Size);
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(80, 24));
  discard Runtime.TuiApplicationRunIterations(App, Text, Update, View, 0, 0);
  const Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      discard Runtime.TuiApplicationRunIterations(App, Text, Update, View, 0, 0);
    end;
  end for;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started))) + ' ms');
  var Visible: integer := Size;
  if Visible > 80 then
    begin
      Visible := 80;
    end;
  end if;

  if Str.Substring(Rendering2.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 0, Visible) <>
     Str.RepeatStr('é', Visible) then
    begin
      panic('rendered text');
    end;
  end if;

  Runtime.TuiApplicationClose(App);
end program;
