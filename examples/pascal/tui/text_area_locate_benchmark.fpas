// Long-document caret rendering through the public headless TUI.
program TextAreaLocateBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;
uses Std.Time as Time;
uses Std.Tui as Tui;

function View(Text: string): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Option.Some(Tui.TuiControlId.Create(1)), [
                                                                                       Tui.TuiElementBuilders.MakeTextArea(Tui.TuiControlId.Create(1), Text, Str.Length(Text), Tui.TuiPoint.Create(0, 0), Tui.TuiAction.Create(1))
                                                                                     ]);
end function;

function Update(Text: string; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): string;
begin
  return Text;
end function;

begin
  if Args.ParamCount() <> 2 then
    begin
      panic('expected ITERATIONS SIZE');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  var Size: integer := Conv.StrToInt(Args.ParamStr(1));
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('arguments must be positive');
    end;
  end if;
  var Text: string := Str.RepeatStr('é', Size);
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(80, 24));
  discard App.RunIterations(Text, Update, View, 0, 0);
  var Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      discard App.RunIterations(Text, Update, View, 0, 0);
    end;
  end for;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started))) + ' ms');
  mutable var Visible: integer := Size;
  if Visible > 80 then
    begin
      Visible := 80;
    end;
  end if;

  if Str.Substring(App.SurfaceSnapshot().LineAt(0), 0, Visible) <> Str.RepeatStr('é', Visible) then
    begin
      panic('rendered text');
    end;
  end if;

  App.Close();
end program;
