{ Turbo Vision window demo with dialog-style layout. Run in a terminal; choose Quit to exit. }

program TuiTurboVisionDialog;

uses Std.Tui;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): TuiRect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

function ExitMenuItem(): MenuItem;
begin
  return record text := 'E~x~it'; commandId := CM_QUIT; end
end;

function FileMenu(): Menu;
begin
  return record title := '~F~ile'; items := [ExitMenuItem()]; end
end;

function QuitStatusItem(): StatusItem;
begin
  return record text := '~Q~uit'; keyCode := 0; commandId := CM_QUIT; end
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CM_QUIT then
  begin
    Application.Quit(App)
  end
end;

begin
  var App: Application := Application.Open();
  var Bar: MenuBar := MenuBar.New(Bounds(0, 0, 80, 1), [FileMenu()]);
  var Status: StatusLine := StatusLine.New(Bounds(0, 24, 80, 1), [QuitStatusItem()]);
  var Win: Window := Window.New(Bounds(4, 2, 40, 13), 'FPAS');
  var LabelHandle: StaticText := StaticText.New(Bounds(4, 2, 24, 1), 'Turbo Vision facade');
  var NameInput: InputLine := InputLine.New(Bounds(4, 4, 18, 1), 'FPAS', 32);
  var Choices: ListBox := ListBox.New(Bounds(4, 6, 18, 3), ['Edit', 'Build', 'Run'], CM_OK);
  var AutoRun: CheckBox := CheckBox.New(Bounds(24, 6, 12, 1), 'Auto run', false);
  var ButtonHandle: Button := Button.New(Bounds(10, 9, 12, 2), 'Quit', CM_QUIT, false);
  Window.Add(Win, LabelHandle);
  Window.Add(Win, NameInput);
  Window.Add(Win, Choices);
  Window.Add(Win, AutoRun);
  Window.Add(Win, ButtonHandle);
  Desktop.Add(App, Win);
  Application.SetMenuBar(App, Bar);
  Application.SetStatusLine(App, Status);
  Application.Run(App, OnCommand);
  Application.Close(App)
end.
