{ Turbo Vision dialog demo. Run in a terminal; choose the button to exit. }

program TuiTurboVisionDialog;

uses Std.Tui;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

function FileMenuItem(): MenuBarItem;
begin
  return record menuText := '~F~ile'; itemText := 'E~x~it'; commandId := Command.Quit; end
end;

function QuitStatusItem(): StatusItem;
begin
  return record text := '~Q~uit'; keyCode := 0; commandId := Command.Quit; end
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = Command.Quit then
  begin
    Application.Quit(App)
  end
end;

begin
  var App: Application := Application.Open();
  var Menu: MenuBar := Application.CreateMenuBar(App, Bounds(0, 0, 80, 1), [FileMenuItem()]);
  var Status: StatusLine := Application.CreateStatusLine(App, Bounds(0, 24, 80, 1), [
                                                                                      QuitStatusItem()

                                                                                    ]);
  var DialogHandle: Dialog := Application.CreateDialog(App, Bounds(4, 2, 40, 13), 'FPAS');
  var LabelHandle: StaticText := Application.CreateStaticText(App, Bounds(4, 2, 24, 1), 'Turbo Vision facade');
  var NameInput: InputLine := Application.CreateInputLine(App, Bounds(4, 4, 18, 1), 'FPAS', 32);
  var Choices: ListBox := Application.CreateListBox(App, Bounds(4, 6, 18, 3), [
                                                                                'Edit',
                                                                                'Build',
                                                                                'Run'

                                                                              ], Command.Accept);
  var AutoRun: CheckBox := Application.CreateCheckBox(App, Bounds(24, 6, 12, 1), 'Auto run', false);
  var ButtonHandle: Button := Application.CreateButton(App, Bounds(10, 9, 12, 2), 'Quit', Command.Quit);
  Application.SetMenuBar(App, Menu);
  Application.SetStatusLine(App, Status);
  Application.AddChild(App, DialogHandle, LabelHandle);
  Application.AddChild(App, DialogHandle, NameInput);
  Application.AddChild(App, DialogHandle, Choices);
  Application.AddChild(App, DialogHandle, AutoRun);
  Application.AddChild(App, DialogHandle, ButtonHandle);
  Application.OnCommand(App, OnCommand);
  Application.Run(App)
end.
