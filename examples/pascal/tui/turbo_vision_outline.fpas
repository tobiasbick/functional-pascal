program TurboVisionOutlineDemo;

uses Std.Tui;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

function Leaf(Text: string): OutlineNode;
begin
  return record text := Text; children := []; expanded := false; end
end;

function Node(Text: string; Children: array of OutlineNode; Expanded: boolean): OutlineNode;
begin
  return record text := Text; children := Children; expanded := Expanded; end
end;

begin
  var App: Application := Application.Open();
  var Roots: array of OutlineNode := [
                                       Node('demo', [Node('src', [Leaf('main.fpas'), Leaf('lib.fpas')], true), Leaf('README.md')], true)

                                     ];
  var DialogHandle: Dialog := Application.CreateDialog(App, Bounds(8, 3, 44, 14), 'Project tree');
  var TreeHandle: Outline := Application.CreateOutline(App, Bounds(3, 2, 36, 10), Roots);
  var CloseButton: Button := Application.CreateButton(App, Bounds(14, 12, 12, 2), 'Close', Command.Quit);
  Application.AddChild(App, DialogHandle, TreeHandle);
  Application.AddChild(App, DialogHandle, CloseButton);
  Application.Run(App);
  Application.Close(App)
end.
