{ Turbo Vision window demo. Run in a terminal; choose the button to exit. }

program TuiTurboVisionWindow;

uses Std.Tui;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

function FileMenuItem(): MenuBarItem;
begin
  return record menuText := '~F~ile'; itemText := 'E~x~it'; commandId := Command.Quit; end
end;

function QuitStatusItem(): StatusItem;
begin
  return record text := '~Q~uit'; keyCode := 0; commandId := Command.Quit; end
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = Command.Quit then
  begin
    Application.Quit(App)
  end
end;

begin
  var App: Application := Application.Open();
  var Menu: MenuBar := Application.CreateMenuBar(App, Bounds(0, 0, 80, 1), [FileMenuItem()]);
  var Status: StatusLine := Application.CreateStatusLine(App, Bounds(0, 24, 80, 1), [
                                                                                      QuitStatusItem()

                                                                                    ]);
  var WindowHandle: Window := Application.CreateWindow(App, Bounds(5, 3, 42, 12), 'FPAS IDE');
  var LabelHandle: StaticText := Application.CreateStaticText(App, Bounds(4, 2, 28, 1), 'Window with static text');
  var NameInput: InputLine := Application.CreateInputLine(App, Bounds(4, 4, 20, 1), 'main.pas', 64);
  var ButtonHandle: Button := Application.CreateButton(App, Bounds(12, 6, 12, 2), 'Quit', Command.Quit);
  Application.SetMenuBar(App, Menu);
  Application.SetStatusLine(App, Status);
  Application.AddChild(App, WindowHandle, LabelHandle);
  Application.AddChild(App, WindowHandle, NameInput);
  Application.AddChild(App, WindowHandle, ButtonHandle);
  Application.AddWindow(App, WindowHandle);
  Application.OnCommand(App, OnCommand);
  Application.Run(App)
end.
