{ View-scoped command demo — Tab focuses child views; Ctrl+S resolves through the focused view's ancestor chain; Escape exits. }

program TuiViewScopedCommands;

uses Std.Console, Std.Tui;

mutable var
  mutable var Status: string := 'Press Tab to focus a button. Ctrl+S uses the focused panel command.';
  mutable var RootView: option of ViewId := None;

procedure ClearBounds(Bounds: Std.Tui.Rect);
begin
  for Row: integer := 0 to Bounds.height - 1 do
  begin
    GotoXY(1, Row + 1);
    for Col: integer := 0 to Bounds.width - 1 do
    begin
      Write(' ')
    end
  end
end;

procedure OnViewPaint(App: Application; ViewId: ViewId; Bounds: Std.Tui.Rect);
begin
  ClearBounds(Bounds);
  GotoXY(1, 1);
  WriteLn('View-scoped commands');
  GotoXY(1, 2);
  WriteLn('Focused view: ', Application.QueryFocusedViewId(App));
  GotoXY(1, 3);
  WriteLn(Status);
  GotoXY(1, 5);
  WriteLn('Tab moves between the two button views.');
  GotoXY(1, 6);
  WriteLn('Ctrl+S triggers the focused panel command.');
  GotoXY(1, 7);
  WriteLn('Escape exits.');
  GotoXY(6, 10);
  WriteLn('Left panel');
  GotoXY(8, 11);
  WriteLn('[Ctrl+S => command 20]');
  GotoXY(38, 10);
  WriteLn('Right panel');
  GotoXY(40, 11);
  WriteLn('[Ctrl+S => command 30]')
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = 10 then
  begin
    Status := 'Global Ctrl+S fired (no scoped view override).'
  end
  else if CommandId = 20 then
  begin
    Status := 'Left panel Ctrl+S fired through ancestor lookup.'
  end
  else if CommandId = 30 then
  begin
    Status := 'Right panel Ctrl+S fired through ancestor lookup.'
  end
  else if CommandId = 99 then
  begin
    Application.HostRequestQuit(App);
    return
  end
  else
  begin
    Status := 'Unhandled command id'
  end;
  Application.RequestRedraw(App)
end;

function OnKeyPressed(App: Application; Key: Std.Console.KeyEvent): boolean;
begin
  if Key.kind = KeyKind.Escape then
  begin
    Application.HostRequestQuit(App);
    return true
  end;
  return false
end;

procedure OnResize(App: Application; NewSize: Size);
begin
  case RootView of
    Some(Root):
    begin
      Application.HostSetViewRect(App, Root, 0, 0, NewSize.width, NewSize.height)
    end;
    None:
    begin
    end
  end;
  Application.RequestRedraw(App)
end;

begin
  var App: Application := Application.Open();
  var S: Size := Application.Size(App);
  var SaveKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Character;
    ch := 's';
    shift := false;
    ctrl := true;
    alt := false;
    meta := false;
  end;
  var QuitKey: Std.Console.KeyEvent := record
    kind := Std.Console.KeyKind.Character;
    ch := 'q';
    shift := false;
    ctrl := true;
    alt := false;
    meta := false;
  end;
  var Root: ViewId := Application.HostRegisterView(App, 0, 0, S.width, S.height);
  RootView := Some(Root);
  var LeftPanel: ViewId := Application.HostRegisterView(App, 4, 9, 28, 4);
  var RightPanel: ViewId := Application.HostRegisterView(App, 36, 9, 28, 4);
  var LeftButton: ViewId := Application.HostRegisterView(App, 2, 1, 20, 1);
  var RightButton: ViewId := Application.HostRegisterView(App, 2, 1, 20, 1);
  Application.HostSetViewParent(App, LeftButton, Some(LeftPanel));
  Application.HostSetViewParent(App, RightButton, Some(RightPanel));
  Application.HostPushChildView(App, LeftButton);
  Application.HostPushChildView(App, RightButton);
  Application.HostRegisterOnViewPaint(App, Root, OnViewPaint);
  Application.HostRegisterOnCommand(App, OnCommand);
  Application.HostRegisterOnKeyPressed(App, OnKeyPressed);
  Application.HostRegisterOnResize(App, OnResize);
  Application.HostBindCommand(App, SaveKey, 10);
  Application.HostBindCommand(App, QuitKey, 99);
  Application.HostBindCommandToView(App, LeftPanel, SaveKey, 20);
  Application.HostBindCommandToView(App, RightPanel, SaveKey, 30);
  Application.Run(App)
end.
