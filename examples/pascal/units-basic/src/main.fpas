// Run as `fpas run units-basic.fpasprj` — loads App.* units. See examples/README.md.

program UnitsBasic;

uses App.Math as Math;
uses App.Reporting as Reporting;
uses Std.Console as Console;
uses Std.Conv as Conv;

begin
  Console.WriteLn('Short name: ', Reporting.DescribeClamp(135));
  Console.WriteLn('Qualified name: ', Reporting.DescribeScaled(6, 7));
  Console.WriteLn('Clamp direct call: ', Conv.IntToStr(Math.Clamp(-4, 0, 10)));
end program;
