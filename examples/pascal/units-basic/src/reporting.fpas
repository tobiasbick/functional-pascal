// Built only via units-basic.fpasprj — not a standalone program.

unit App.Reporting;

uses App.Math as Math;
uses Std.Conv as Conv;

public function DescribeClamp(Value: integer): string;
begin
  var Clamped: integer := Math.Clamp(Value, 0, 100);
  return (('input=' + Conv.IntToStr(Value)) + ', clamped=') + Conv.IntToStr(Clamped);
end function;

public function DescribeScaled(Value: integer; Factor: integer): string;
begin
  return 'scaled=' + Conv.IntToStr(Math.Scale(Value, Factor));
end function;

end unit;
