// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 500000
// Guard: target/release/fpas run this-file.fpas -- 500000 MAX_MILLIS

program VmArrayLengthBenchmark;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;

const WarmupIterations: integer := 10000;
const ArraySize: integer := 10000;

function MakeValues(Count: integer): array of (integer);
begin
  var Values: array of (integer) := [];
  for Index: integer := 1 to Count do
    begin
      Arrays.Push(var Values, Index);
    end;
  end for;

  return Values;
end function;

function RunLength(Values: array of (integer); Iterations: integer): integer;
begin
  var Total: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      Total := Total + Arrays.Length(Values);
    end;
  end for;

  return Total;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: array_length_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  const Values: array of (integer) := MakeValues(ArraySize);
  var Total: integer := RunLength(Values, WarmupIterations);
  const Started: integer := Time.MonotonicMillis();
  Total := RunLength(Values, Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn((('iterations: ' + Conv.IntToStr(Iterations)) + ', array size: ') +
                  Conv.IntToStr(ArraySize));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' lengths/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('length total: ' + Conv.IntToStr(Total));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('array-length benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
