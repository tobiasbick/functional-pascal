// Local stack drain; each timed iteration includes array construction.
program ArrayPopBenchmark;

uses Std.Args, Std.Console, Std.Conv, Std.Time, Std.Arrays;

begin
  if ParamCount() <> 2 then
    begin
      panic('expected ITERATIONS SIZE');
    end;
  end if;
  const Iterations: integer := StrToInt(ParamStr(0));
  const Size: integer := StrToInt(ParamStr(1));
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('arguments must be positive');
    end;
  end if;
  const Started: integer := MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      var Values: array of integer := Std.Arrays.Fill(7, Size);
      for Index: integer := 1 to Size do
        begin
          if Std.Arrays.Pop(Values) <> 7 then
            begin
              panic('popped value');
            end;
          end if;
        end;
      end for;

      if Std.Arrays.Length(Values) <> 0 then
        begin
          panic('drain length');
        end;
      end if;
    end;
  end for;

  WriteLn(('elapsed: ' + IntToStr(ElapsedMillis(Started))) + ' ms');
end.
