// Local stack drain; each timed iteration includes array construction.
program ArrayPopBenchmark;

uses Std.Args as Args, Std.Console as Console, Std.Conv as Conv, Std.Time as Time;

begin
  if Args.ParamCount() <> 2 then
    begin
      panic('expected ITERATIONS SIZE');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  const Size: integer := Conv.StrToInt(Args.ParamStr(1));
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('arguments must be positive');
    end;
  end if;
  const Started: integer := Time.MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      var Values: array of integer := array.Fill(7, Size);
      for Index: integer := 1 to Size do
        begin
          if Values.PopInPlace() <> 7 then
            begin
              panic('popped value');
            end;
          end if;
        end;
      end for;

      if Values.Length() <> 0 then
        begin
          panic('drain length');
        end;
      end if;
    end;
  end for;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Time.ElapsedMillis(Started)) + ' ms');
end.
