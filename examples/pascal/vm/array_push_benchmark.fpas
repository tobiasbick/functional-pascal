{ Build first: cargo build --release -p fpas-cli }
{ Baseline: target/release/fpas run this-file.fpas -- 2000000 }
{ Guard: target/release/fpas run this-file.fpas -- 2000000 MAX_MILLIS }

program VmArrayPushBenchmark;

uses Std.Args, Std.Array, Std.Console, Std.Conv, Std.Time;

const
  WarmupIterations: integer := 100000;

function RunPush(Iterations: integer): integer;
begin
  mutable var Values: array of integer := [];
  for Index: integer := 1 to Iterations do
  begin
    Std.Array.Push(Values, Index)
  end;
  return Std.Array.Length(Values)
end;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
  begin
    panic('usage: array_push_benchmark.fpas -- ITERATIONS [MAX_MILLIS]')
  end;
  var Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
  begin
    panic('ITERATIONS must be positive')
  end;
  mutable var MaxMillis: integer := 0;
  if ParamCount() = 2 then
  begin
    MaxMillis := StrToInt(ParamStr(1));
    if MaxMillis < 1 then
    begin
      panic('MAX_MILLIS must be positive')
    end
  end;
  mutable var Length: integer := RunPush(WarmupIterations);
  var Started: integer := MonotonicMillis();
  Length := RunPush(Iterations);
  var Elapsed: integer := ElapsedMillis(Started);
  mutable var OpsPerSecond: integer := Iterations;
  if Elapsed > 0 then
  begin
    OpsPerSecond := (Iterations * 1000) div Elapsed
  end;
  WriteLn((('iterations: ' + IntToStr(Iterations)) + ', warm-up: ') + IntToStr(WarmupIterations));
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  WriteLn(('throughput: ' + IntToStr(OpsPerSecond)) + ' pushes/s');
  WriteLn('final length: ' + IntToStr(Length));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
  begin
    panic(((('array-push benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
          ' ms')
  end
end.
