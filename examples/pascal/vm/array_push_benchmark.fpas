// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 2000000
// Guard: target/release/fpas run this-file.fpas -- 2000000 MAX_MILLIS

program VmArrayPushBenchmark;

uses
  Std.Os.Args as Args, Std.Console as Console, Std.Text.Format as Conv, Std.Time as Time, Std.Text.Parse as Parse;

const WarmupIterations: integer := 100000;

function RunPush(Iterations: integer): integer;
begin
  var Values: array of integer := [];
  for Index: integer := 1 to Iterations do
    begin
      Values.PushInPlace(Index);
    end;
  end for;

  return Values.Length();
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: array_push_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Parse.Int(Args.ParamStr(1)).Unwrap();
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var Length: integer := RunPush(WarmupIterations);
  const Started: integer := Time.MonotonicMillis();
  Length := RunPush(Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := Iterations * 1000 div Elapsed;
    end;
  end if;

  Console.WriteLn(
    'iterations: ' + Conv.IntToStr(Iterations) + ', warm-up: ' +
    Conv.IntToStr(WarmupIterations)
  );
  Console.WriteLn('elapsed: ' + Conv.IntToStr(Elapsed) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn('throughput: ' + Conv.IntToStr(OpsPerSecond) + ' pushes/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('final length: ' + Conv.IntToStr(Length));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(
        'array-push benchmark regression: ' + Conv.IntToStr(Elapsed) + ' ms exceeds limit ' +
        Conv.IntToStr(MaxMillis) +
        ' ms'
      );
    end;
  end if;
end.
