// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 20000000
// Guard: target/release/fpas run this-file.fpas -- 20000000 MAX_MILLIS

program VmBranchDispatchBenchmark;

uses Std.Args, Std.Console, Std.Conv, Std.Time;

const WarmupIterations: integer := 100000;

function RunBranches(Iterations: integer): integer;
begin
  var Total: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      if (Index mod 2) = 0 then
        begin
          Total := Total + Index;
        end;
      else
        begin
          Total := Total - Index;
        end;
      end if;
    end;
  end for;

  return Total;
end function;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
    begin
      panic('usage: branch_dispatch_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if ParamCount() = 2 then
    begin
      MaxMillis := StrToInt(ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var Checksum: integer := RunBranches(WarmupIterations);
  const Started: integer := MonotonicMillis();
  Checksum := RunBranches(Iterations);
  const Elapsed: integer := ElapsedMillis(Started);
  var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := Iterations * 1000 div Elapsed;
    end;
  end if;

  WriteLn('iterations: ' + IntToStr(Iterations));
  WriteLn('elapsed: ' + IntToStr(Elapsed) + ' ms');
  if Elapsed > 0 then
    begin
      WriteLn('throughput: ' + IntToStr(OpsPerSecond) + ' branches/s');
    end;
  else
    begin
      WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  WriteLn('checksum: ' + IntToStr(Checksum));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic('branch-dispatch benchmark regression: ' + IntToStr(Elapsed) + ' ms exceeds limit ' + IntToStr(MaxMillis) +
            ' ms');
    end;
  end if;
end.
