// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 3000000
// Guard: target/release/fpas run this-file.fpas -- 3000000 MAX_MILLIS

program VmClosureCallBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;

const WarmupIterations: integer := 10000;

function MakeAdder(Amount: integer): function(Value: integer): integer;
begin
  return function(Value: integer): integer begin
    return Value + Amount;
  end function;
end function;

function RunCalls(Iterations: integer): integer;
begin
  var AddOne: function(Value: integer): integer := MakeAdder(1);
  mutable var Value: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      Value := AddOne(Value);
    end;
  end for;

  return Value;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: closure_call_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  mutable var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  mutable var Value: integer := RunCalls(WarmupIterations);
  var Started: integer := Time.MonotonicMillis();
  Value := RunCalls(Iterations);
  var Elapsed: integer := Time.ElapsedMillis(Started);
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn('iterations: ' + Conv.IntToStr(Iterations));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' closure calls/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('final value: ' + Conv.IntToStr(Value));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('closure-call benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
