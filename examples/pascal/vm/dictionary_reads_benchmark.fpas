// Scaling workload driven by cargo bench-fpas. Setup is outside the timer.
program DictionaryReadsBenchmark;

uses Std.Args, Std.Console, Std.Conv, Std.Time;

begin
  if ParamCount() <> 2 then
    begin
      panic('expected ITERATIONS SIZE');
    end;
  end if;
  const Iterations: integer := StrToInt(ParamStr(0));
  const Size: integer := StrToInt(ParamStr(1));
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('arguments must be positive');
    end;
  end if;
  var Values: dict of integer to integer := [0: 0];
  for Index: integer := 0 to Size - 1 do
    begin
      Values[Index] := Index;
    end;
  end for;
  const Started: integer := MonotonicMillis();
  for Iteration: integer := 1 to Iterations do
    begin
      if Values.Length() <> Size then
        begin
          panic('dictionary length');
        end;
      end if;

      if not Values.ContainsKey(0) then
        begin
          panic('first key');
        end;
      end if;

      if Values.Get(0).Unwrap() <> 0 then
        begin
          panic('first value');
        end;
      end if;
    end;
  end for;

  WriteLn(('elapsed: ' + IntToStr(ElapsedMillis(Started))) + ' ms');
end.
