// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 5000000
// Guard: target/release/fpas run this-file.fpas -- 5000000 MAX_MILLIS

program VmDynamicNumericBenchmark;

uses Std.Args, Std.Console, Std.Conv, Std.Time;

const
  WarmupIterations: integer := 10000;

function Advance<T: Numeric>(Value: T; Step: T): T;
begin
  return Value + Step
end;

function RunNumbers(Iterations: integer): integer;
begin
  mutable var Value: integer := 0;
  for Index: integer := 1 to Iterations do
  begin
    Value := Advance(Value, 1)
  end;

  return Value
end;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
  begin
    panic('usage: dynamic_numeric_benchmark.fpas -- ITERATIONS [MAX_MILLIS]')
  end;
  var Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
  begin
    panic('ITERATIONS must be positive')
  end;
  mutable var MaxMillis: integer := 0;
  if ParamCount() = 2 then
  begin
    MaxMillis := StrToInt(ParamStr(1));
    if MaxMillis < 1 then
    begin
      panic('MAX_MILLIS must be positive')
    end
  end;
  mutable var Value: integer := RunNumbers(WarmupIterations);
  var Started: integer := MonotonicMillis();
  Value := RunNumbers(Iterations);
  var Elapsed: integer := ElapsedMillis(Started);
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
  begin
    OpsPerSecond := (Iterations * 1000) div Elapsed
  end;

  WriteLn('iterations: ' + IntToStr(Iterations));
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
  begin
    WriteLn(('throughput: ' + IntToStr(OpsPerSecond)) + ' dynamic numeric ops/s')
  end
  else
  begin
    WriteLn('throughput: unavailable (elapsed time is 0 ms)')
  end;

  WriteLn('final value: ' + IntToStr(Value));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
  begin
    panic(((('dynamic-numeric benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
          ' ms')
  end
end.
