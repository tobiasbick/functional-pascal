// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 3000000
// Guard: target/release/fpas run this-file.fpas -- 3000000 MAX_MILLIS

program VmFunctionCallBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;

const WarmupIterations: integer := 10000;

function Increment(Value: integer): integer;
begin
  return Value + 1;
end function;

function MakeAdder(Amount: integer): function(Value: integer): integer;
begin
  return function(Value: integer): integer begin
    return Value + Amount;
  end function;
end function;

function RunCalls(Iterations: integer): integer;
begin
  const AddCaptured: function(Value: integer): integer := MakeAdder(1);
  var Value: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      Value := Increment(Value);
      Value := AddCaptured(Value);
    end;
  end for;

  return Value;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: function_call_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var Value: integer := RunCalls(WarmupIterations);
  const Started: integer := Time.MonotonicMillis();
  Value := RunCalls(Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  const Calls: integer := Iterations * 2;
  var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Calls * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn((('iterations: ' + Conv.IntToStr(Iterations)) + ', calls: ') +
                  Conv.IntToStr(Calls));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' calls/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('final value: ' + Conv.IntToStr(Value));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('function-call benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
