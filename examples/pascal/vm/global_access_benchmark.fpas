// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 5000000
// Guard: target/release/fpas run this-file.fpas -- 5000000 MAX_MILLIS

program VmGlobalAccessBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;

const WarmupIterations: integer := 10000;
mutable var GlobalValue: integer := 0;

function RunAccess(Iterations: integer): integer;
begin
  GlobalValue := 0;
  for Index: integer := 1 to Iterations do
    begin
      GlobalValue := GlobalValue + Index;
    end;
  end for;

  return GlobalValue;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: global_access_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  mutable var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  mutable var Checksum: integer := RunAccess(WarmupIterations);
  var Started: integer := Time.MonotonicMillis();
  Checksum := RunAccess(Iterations);
  var Elapsed: integer := Time.ElapsedMillis(Started);
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn('iterations: ' + Conv.IntToStr(Iterations));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' global updates/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('checksum: ' + Conv.IntToStr(Checksum));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('global-access benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
