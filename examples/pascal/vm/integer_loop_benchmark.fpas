// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 50000000
// Guard: target/release/fpas run this-file.fpas -- 50000000 MAX_MILLIS

program VmIntegerLoopBenchmark;

uses Std.Args, Std.Console, Std.Conv, Std.Time;

const
  WarmupIterations: integer := 1000000;

function RunLoop(Iterations: integer): integer;
begin
  mutable var Acc: integer := 0;
  for Index: integer := 1 to Iterations do
  begin
    Acc := (Acc + Index) - (Index div 3)
  end;

  return Acc
end;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
  begin
    panic('usage: integer_loop_benchmark.fpas -- ITERATIONS [MAX_MILLIS]')
  end;
  var Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
  begin
    panic('ITERATIONS must be positive')
  end;
  mutable var MaxMillis: integer := 0;
  if ParamCount() = 2 then
  begin
    MaxMillis := StrToInt(ParamStr(1));
    if MaxMillis < 1 then
    begin
      panic('MAX_MILLIS must be positive')
    end
  end;
  mutable var Acc: integer := RunLoop(WarmupIterations);
  var Started: integer := MonotonicMillis();
  Acc := RunLoop(Iterations);
  var Elapsed: integer := ElapsedMillis(Started);
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
  begin
    OpsPerSecond := (Iterations * 1000) div Elapsed
  end;

  WriteLn((('iterations: ' + IntToStr(Iterations)) + ', warm-up: ') + IntToStr(WarmupIterations));
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
  begin
    WriteLn(('throughput: ' + IntToStr(OpsPerSecond)) + ' iters/s')
  end
  else
  begin
    WriteLn('throughput: unavailable (elapsed time is 0 ms)')
  end;

  WriteLn('accumulator: ' + IntToStr(Acc));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
  begin
    panic(((('integer-loop benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
          ' ms')
  end
end.
