// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 50000000
// Guard: target/release/fpas run this-file.fpas -- 50000000 MAX_MILLIS

program VmIntegerLoopBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;

const WarmupIterations: integer := 1000000;

function RunLoop(Iterations: integer): integer;
begin
  var Acc: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      Acc := (Acc + Index) - (Index div 3);
    end;
  end for;

  return Acc;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: integer_loop_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var Acc: integer := RunLoop(WarmupIterations);
  const Started: integer := Time.MonotonicMillis();
  Acc := RunLoop(Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn((('iterations: ' + Conv.IntToStr(Iterations)) + ', warm-up: ') +
                  Conv.IntToStr(WarmupIterations));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' iters/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('accumulator: ' + Conv.IntToStr(Acc));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('integer-loop benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
