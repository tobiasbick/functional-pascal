// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 5000000
// Guard: target/release/fpas run this-file.fpas -- 5000000 MAX_MILLIS

program VmIntrinsicDispatchBenchmark;

uses
  Std.Os.Args as Args, Std.Console as Console, Std.Text.Format as Conv, Std.Time as Time, Std.Text.Parse as Parse;

const WarmupIterations: integer := 10000;
const CallsPerIteration: integer := 3;

function RunDispatch(
  Values: array of integer;
  Text: string;
  Entries: dict of string to integer;
  Iterations: integer
): integer;
begin
  var Total: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      Total := Total + Values.Length();
      Total := Total + Text.Length();
      Total := Total + Entries.Length();
    end;
  end for;

  return Total;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: intrinsic_dispatch_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Parse.Int(Args.ParamStr(1)).Unwrap();
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  const Values: array of integer := [1, 2, 3];
  const Text: string := 'dispatch';
  const Entries: dict of string to integer := ['value': 1];
  var Total: integer := RunDispatch(Values, Text, Entries, WarmupIterations);
  const Started: integer := Time.MonotonicMillis();
  Total := RunDispatch(Values, Text, Entries, Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  const Calls: integer := Iterations * CallsPerIteration;
  var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := Calls * 1000 div Elapsed;
    end;
  end if;

  Console.WriteLn('iterations: ' + Conv.IntToStr(Iterations) + ', calls per iteration: 3');
  Console.WriteLn('elapsed: ' + Conv.IntToStr(Elapsed) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn('throughput: ' + Conv.IntToStr(OpsPerSecond) + ' intrinsic calls/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('dispatch total: ' + Conv.IntToStr(Total));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(
        'intrinsic-dispatch benchmark regression: ' + Conv.IntToStr(Elapsed) + ' ms exceeds limit ' +
        Conv.IntToStr(MaxMillis) +
        ' ms'
      );
    end;
  end if;
end.
