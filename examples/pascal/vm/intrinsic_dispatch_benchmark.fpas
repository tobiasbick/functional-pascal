// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 5000000
// Guard: target/release/fpas run this-file.fpas -- 5000000 MAX_MILLIS

program VmIntrinsicDispatchBenchmark;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Dictionaries as Dictionaries;
uses Std.Str as Str;
uses Std.Time as Time;

const WarmupIterations: integer := 10000;
const CallsPerIteration: integer := 3;

function RunDispatch(
  Values: array of (integer);
  Text: string;
  Entries: dict of (string, integer);
  Iterations: integer
): integer;
begin
  mutable var Total: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      Total := Total + Arrays.Length(Values);
      Total := Total + Str.Length(Text);
      Total := Total + Dictionaries.Length(Entries);
    end;
  end for;

  return Total;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: intrinsic_dispatch_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  mutable var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var Values: array of (integer) := [1, 2, 3];
  var Text: string := 'dispatch';
  var Entries: dict of (string, integer) := ['value': 1];
  mutable var Total: integer := RunDispatch(Values, Text, Entries, WarmupIterations);
  var Started: integer := Time.MonotonicMillis();
  Total := RunDispatch(Values, Text, Entries, Iterations);
  var Elapsed: integer := Time.ElapsedMillis(Started);
  var Calls: integer := Iterations * CallsPerIteration;
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Calls * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn(('iterations: ' + Conv.IntToStr(Iterations)) + ', calls per iteration: 3');
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' intrinsic calls/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('dispatch total: ' + Conv.IntToStr(Total));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('intrinsic-dispatch benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
