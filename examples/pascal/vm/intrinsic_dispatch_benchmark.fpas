// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 5000000
// Guard: target/release/fpas run this-file.fpas -- 5000000 MAX_MILLIS

program VmIntrinsicDispatchBenchmark;

uses Std.Args, Std.Array, Std.Console, Std.Conv, Std.Dict, Std.Str, Std.Time;

const
  WarmupIterations: integer := 10000;
  CallsPerIteration: integer := 3;

function RunDispatch(
  Values: array of integer;
  Text: string;
  Entries: dict of string to integer;
  Iterations: integer
): integer;
begin
  mutable var Total: integer := 0;
  for Index: integer := 1 to Iterations do
  begin
    Total := Total + Std.Array.Length(Values);
    Total := Total + Std.Str.Length(Text);
    Total := Total + Std.Dict.Length(Entries)
  end;

  return Total
end;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
  begin
    panic('usage: intrinsic_dispatch_benchmark.fpas -- ITERATIONS [MAX_MILLIS]')
  end;
  var Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
  begin
    panic('ITERATIONS must be positive')
  end;
  mutable var MaxMillis: integer := 0;
  if ParamCount() = 2 then
  begin
    MaxMillis := StrToInt(ParamStr(1));
    if MaxMillis < 1 then
    begin
      panic('MAX_MILLIS must be positive')
    end
  end;
  var Values: array of integer := [1, 2, 3];
  var Text: string := 'dispatch';
  var Entries: dict of string to integer := ['value': 1];
  mutable var Total: integer := RunDispatch(Values, Text, Entries, WarmupIterations);
  var Started: integer := MonotonicMillis();
  Total := RunDispatch(Values, Text, Entries, Iterations);
  var Elapsed: integer := ElapsedMillis(Started);
  var Calls: integer := Iterations * CallsPerIteration;
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
  begin
    OpsPerSecond := (Calls * 1000) div Elapsed
  end;

  WriteLn(('iterations: ' + IntToStr(Iterations)) + ', calls per iteration: 3');
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
  begin
    WriteLn(('throughput: ' + IntToStr(OpsPerSecond)) + ' intrinsic calls/s')
  end
  else
  begin
    WriteLn('throughput: unavailable (elapsed time is 0 ms)')
  end;

  WriteLn('dispatch total: ' + IntToStr(Total));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
  begin
    panic(((('intrinsic-dispatch benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
          ' ms')
  end
end.
