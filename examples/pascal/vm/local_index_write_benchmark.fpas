// Measures repeated direct writes to a local copy-on-write array.
program LocalIndexWriteBenchmark;

uses
  Std.Os.Args as Args, Std.Console as Console, Std.Text.Format as Conv, Std.Time as Time, Std.Text.Parse as Parse;

const WarmupIterations: integer := 100;

function RewriteValues(Values: array of integer; Iterations: integer): integer;
begin
  var LocalValues: array of integer := Values;
  for Iteration: integer := 1 to Iterations do
    begin
      for Index: integer := 0 to LocalValues.Length() - 1 do
        begin
          LocalValues[Index] := Iteration + Index;
        end;
      end for;
    end;
  end for;

  return LocalValues[0] + LocalValues[LocalValues.Length() - 1];
end function;

begin
  if Args.ParamCount() <> 2 then
    begin
      panic('usage: local_index_write_benchmark.fpas -- ITERATIONS SIZE');
    end;
  end if;
  const Iterations: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  const Size: integer := Parse.Int(Args.ParamStr(1)).Unwrap();
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('ITERATIONS and SIZE must be positive');
    end;
  end if;
  var Checksum: integer := RewriteValues(array.Fill(0, Size), WarmupIterations);
  const Values: array of integer := array.Fill(0, Size);
  const Started: integer := Time.MonotonicMillis();
  Checksum := RewriteValues(Values, Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  if Checksum <> (Iterations * 2) + Size - 1 then
    begin
      panic('local index write benchmark checksum mismatch');
    end;
  end if;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Elapsed) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(
        'throughput: ' + Conv.IntToStr(Iterations * Size * 1000 div Elapsed) +
        ' writes/s'
      );
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;
end.
