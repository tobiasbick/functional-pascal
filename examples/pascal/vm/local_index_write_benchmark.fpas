// Measures repeated direct writes to a local copy-on-write array.
program LocalIndexWriteBenchmark;

uses Std.Args, Std.Arrays, Std.Console, Std.Conv, Std.Time;

const WarmupIterations: integer := 100;

function RewriteValues(Values: array of integer; Iterations: integer): integer;
begin
  var LocalValues: array of integer := Values;
  for Iteration: integer := 1 to Iterations do
    begin
      for Index: integer := 0 to Std.Arrays.Length(LocalValues) - 1 do
        begin
          LocalValues[Index] := Iteration + Index;
        end;
      end for;
    end;
  end for;

  return LocalValues[0] + LocalValues[Std.Arrays.Length(LocalValues) - 1];
end function;

begin
  if ParamCount() <> 2 then
    begin
      panic('usage: local_index_write_benchmark.fpas -- ITERATIONS SIZE');
    end;
  end if;
  const Iterations: integer := StrToInt(ParamStr(0));
  const Size: integer := StrToInt(ParamStr(1));
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('ITERATIONS and SIZE must be positive');
    end;
  end if;
  var Checksum: integer := RewriteValues(Std.Arrays.Fill(0, Size), WarmupIterations);
  const Values: array of integer := Std.Arrays.Fill(0, Size);
  const Started: integer := MonotonicMillis();
  Checksum := RewriteValues(Values, Iterations);
  const Elapsed: integer := ElapsedMillis(Started);
  if Checksum <> ((Iterations * 2) + Size) - 1 then
    begin
      panic('local index write benchmark checksum mismatch');
    end;
  end if;

  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      WriteLn(('throughput: ' + IntToStr(((Iterations * Size) * 1000) div Elapsed)) + ' writes/s');
    end;
  else
    begin
      WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;
end.
