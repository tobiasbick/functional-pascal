// Measures repeated direct writes to a local copy-on-write array.
program LocalIndexWriteBenchmark;

uses Std.Args as Args;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;

const WarmupIterations: integer := 100;

function RewriteValues(mutable Values: array of integer; Iterations: integer): integer;
begin
  for Iteration: integer := 1 to Iterations do
    begin
      for Index: integer := 0 to Arrays.Length(Values) - 1 do
        begin
          Values[Index] := Iteration + Index;
        end;
      end for;
    end;
  end for;

  return Values[0] + Values[Arrays.Length(Values) - 1];
end function;

begin
  if Args.ParamCount() <> 2 then
    begin
      panic('usage: local_index_write_benchmark.fpas -- ITERATIONS SIZE');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  var Size: integer := Conv.StrToInt(Args.ParamStr(1));
  if (Iterations < 1) or (Size < 1) then
    begin
      panic('ITERATIONS and SIZE must be positive');
    end;
  end if;
  mutable var Checksum: integer := RewriteValues(Arrays.Fill(0, Size), WarmupIterations);
  var Values: array of integer := Arrays.Fill(0, Size);
  var Started: integer := Time.MonotonicMillis();
  Checksum := RewriteValues(Values, Iterations);
  var Elapsed: integer := Time.ElapsedMillis(Started);
  if Checksum <> ((Iterations * 2) + Size) - 1 then
    begin
      panic('local index write benchmark checksum mismatch');
    end;
  end if;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(((Iterations * Size) * 1000) div Elapsed)) +
                      ' writes/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;
end program;
