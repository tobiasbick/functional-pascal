// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 1000000
// Guard: target/release/fpas run this-file.fpas -- 1000000 MAX_MILLIS

program VmRecordUpdateBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;

const WarmupIterations: integer := 10000;

type BenchmarkState = record
  A: integer;
  B: integer;
  C: integer;
  D: integer;
end record;

function RunUpdates(Iterations: integer): integer;
begin
  mutable var State: BenchmarkState := record
    A := 1;
    B := 2;
    C := 3;
    D := 4;
  end record;

  for Index: integer := 1 to Iterations do
    begin
      State := State with A := State.A + 1; C := State.C + State.B; end with;
    end;
  end for;

  return ((State.A + State.B) + State.C) + State.D;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: record_update_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  var Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  mutable var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  mutable var Checksum: integer := RunUpdates(WarmupIterations);
  var Started: integer := Time.MonotonicMillis();
  Checksum := RunUpdates(Iterations);
  var Elapsed: integer := Time.ElapsedMillis(Started);
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn('iterations: ' + Conv.IntToStr(Iterations));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' updates/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('checksum: ' + Conv.IntToStr(Checksum));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('record-update benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
