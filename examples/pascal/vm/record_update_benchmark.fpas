// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 1000000
// Guard: target/release/fpas run this-file.fpas -- 1000000 MAX_MILLIS

program VmRecordUpdateBenchmark;

uses Std.Args, Std.Console, Std.Conv, Std.Time;

const
  WarmupIterations: integer := 10000;

type
  BenchmarkState = record
    A: integer;
    B: integer;
    C: integer;
    D: integer;
  end;

function RunUpdates(Iterations: integer): integer;
begin
  mutable var State: BenchmarkState := record
    A := 1;
    B := 2;
    C := 3;
    D := 4;
  end;

  for Index: integer := 1 to Iterations do
  begin
    State := State with A := State.A + 1; C := State.C + State.B; end
  end;

  return ((State.A + State.B) + State.C) + State.D
end;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
  begin
    panic('usage: record_update_benchmark.fpas -- ITERATIONS [MAX_MILLIS]')
  end;
  var Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
  begin
    panic('ITERATIONS must be positive')
  end;
  mutable var MaxMillis: integer := 0;
  if ParamCount() = 2 then
  begin
    MaxMillis := StrToInt(ParamStr(1));
    if MaxMillis < 1 then
    begin
      panic('MAX_MILLIS must be positive')
    end
  end;
  mutable var Checksum: integer := RunUpdates(WarmupIterations);
  var Started: integer := MonotonicMillis();
  Checksum := RunUpdates(Iterations);
  var Elapsed: integer := ElapsedMillis(Started);
  mutable var OpsPerSecond: integer := Iterations;
  if Elapsed > 0 then
  begin
    OpsPerSecond := (Iterations * 1000) div Elapsed
  end;

  WriteLn('iterations: ' + IntToStr(Iterations));
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  WriteLn(('throughput: ' + IntToStr(OpsPerSecond)) + ' updates/s');
  WriteLn('checksum: ' + IntToStr(Checksum));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
  begin
    panic(((('record-update benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
          ' ms')
  end
end.
