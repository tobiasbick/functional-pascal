program RegisterArrayAccessBenchmark;

begin
  var Values: array of integer := [3, 5, 7, 11];
  mutable var Checksum: integer := 0;
  for Index: integer := 0 to 3999999 do
  begin
    Checksum := Checksum + Values[Index mod 4]
  end;

  if Checksum <> 26000000 then
  begin
    panic('register array-access checksum mismatch')
  end
end.
