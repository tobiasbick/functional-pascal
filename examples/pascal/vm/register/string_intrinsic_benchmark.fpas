program RegisterStringIntrinsicBenchmark;

uses Std.Str;

begin
  var Text: string := 'functional-pascal';
  mutable var Checksum: integer := 0;
  for Index: integer := 1 to 1000 do
  begin
    Checksum := Checksum + Std.Str.Length(Text)
  end;

  if Checksum <> 17000 then
  begin
    panic('register string-intrinsic checksum mismatch')
  end
end.
