{ P7 inactive register-path exercised-workload benchmark. }

program RegisterTaskSpawnWaitBenchmark;

uses Std.Console, Std.Task;

function Worker(Value: integer): integer;
begin
  return Value + 1
end;

begin
  var First: task := go Worker(20);
  var Second: task := go Worker(41);
  Std.Task.WaitAll([First, Second]);
  Std.Console.WriteLn('completed: 2')
end.
