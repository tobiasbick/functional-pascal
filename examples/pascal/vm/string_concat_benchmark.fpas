// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 5000000
// Guard: target/release/fpas run this-file.fpas -- 5000000 MAX_MILLIS

program VmStringConcatBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;
uses Std.Time as Time;

const WarmupIterations: integer := 200000;
const Prefix: string := 'frame-';
const Suffix: string := '-ready';

function RunConcat(Iterations: integer): integer;
begin
  var Total: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      const Built: string := (Prefix + Conv.IntToStr(Index)) + Suffix;
      Total := Total + Str.Length(Built);
    end;
  end for;

  return Total;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: string_concat_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var Total: integer := RunConcat(WarmupIterations);
  const Started: integer := Time.MonotonicMillis();
  Total := RunConcat(Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn((('iterations: ' + Conv.IntToStr(Iterations)) + ', warm-up: ') +
                  Conv.IntToStr(WarmupIterations));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' concats/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('char total: ' + Conv.IntToStr(Total));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('string-concat benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
