// Measures short searches on long strings without including input construction.
program VmStringSearchBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;
uses Std.Time as Time;

function RunSearch(Text: string; Iterations: integer): integer;
begin
  var Matches: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      if Str.StartsWith(Text, 'é') then
        begin
          Matches := Matches + 1;
        end;
      end if;

      if Str.EndsWith(Text, '😀') then
        begin
          Matches := Matches + 1;
        end;
      end if;

      if Str.Contains(Text, 'é') then
        begin
          Matches := Matches + 1;
        end;
      end if;
    end;
  end for;

  return Matches;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: string_search_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  const Text: string := ('é' + Str.RepeatStr('x', 32768)) + '😀';
  if RunSearch(Text, 1000) <> 3000 then
    begin
      panic('warmup search mismatch');
    end;
  end if;
  const Started: integer := Time.MonotonicMillis();
  const Matches: integer := RunSearch(Text, Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  if Matches <> Iterations * 3 then
    begin
      panic('search result mismatch');
    end;
  end if;

  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  Console.WriteLn('matches: ' + Conv.IntToStr(Matches));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic('string search benchmark exceeded MAX_MILLIS');
    end;
  end if;
end program;
