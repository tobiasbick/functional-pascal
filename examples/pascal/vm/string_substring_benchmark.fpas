// Measures short, empty, and full slices of long ASCII or Unicode strings.
program VmStringSubstringBenchmark;

uses
  Std.Os.Args as Args, Std.Console as Console, Std.Text.Format as Conv, Std.Time as Time, Std.Text.Parse as Parse;

function RunSlices(Text: string; UnitText: string; Iterations: integer): integer;
begin
  const Count: integer := Text.Length();
  const Width: integer := UnitText.Length();
  var Matches: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      if Text.Slice(0, Width) = UnitText then
        begin
          Matches := Matches + 1;
        end;
      end if;

      if Text.Slice(Count div 2, Width) = UnitText then
        begin
          Matches := Matches + 1;
        end;
      end if;

      if Text.Slice(Count - Width, Width) = UnitText then
        begin
          Matches := Matches + 1;
        end;
      end if;

      if Text.Slice(Count, 0) = '' then
        begin
          Matches := Matches + 1;
        end;
      end if;

      if Text.Slice(0, Count) = Text then
        begin
          Matches := Matches + 1;
        end;
      end if;
    end;
  end for;

  return Matches;
end function;

begin
  if Args.ParamCount() <> 2 then
    begin
      panic('usage: string_substring_benchmark.fpas -- ITERATIONS ascii|unicode');
    end;
  end if;
  const Iterations: integer := Parse.Int(Args.ParamStr(0)).Unwrap();
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  const Mode: string := Args.ParamStr(1);
  if (Mode <> 'ascii') and (Mode <> 'unicode') then
    begin
      panic('mode must be ascii or unicode');
    end;
  end if;
  var UnitText: string := 'abcd';
  if Mode = 'unicode' then
    begin
      UnitText := 'aé😀界';
    end;
  end if;
  const Text: string := UnitText.RepeatStr(8192);
  if RunSlices(Text, UnitText, 100) <> 500 then
    begin
      panic('warmup substring mismatch');
    end;
  end if;
  const Started: integer := Time.MonotonicMillis();
  const Matches: integer := RunSlices(Text, UnitText, Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  if Matches <> Iterations * 5 then
    begin
      panic('substring result mismatch');
    end;
  end if;

  Console.WriteLn('elapsed: ' + Conv.IntToStr(Elapsed) + ' ms');
  Console.WriteLn('matches: ' + Conv.IntToStr(Matches));
end.
