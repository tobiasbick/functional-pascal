// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 5000000 real

program VmTypedScalarBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Time as Time;

const WarmupIterations: integer := 10000;

function RunReal(Iterations: integer): integer;
begin
  var Value: real := 1.25;
  for Index: integer := 1 to Iterations do
    begin
      Value := (Value + 1.25) * 0.75;
      Value := (Value + 0.5) / 1.125;
      Value := Value - 0.125;
      if Value < 0.0 then
        begin
          Value := 1.25;
        end;
      end if;
    end;
  end for;

  if Value > 0.0 then
    begin
      return 1;
    end;
  end if;

  return 0;
end function;

function RunBoolean(Iterations: integer): integer;
begin
  var Left: boolean := true;
  var Right: boolean := false;
  for Index: integer := 1 to Iterations do
    begin
      Left := (Left and not Right) or Right;
      Right := not Right;
      if Left = Right then
        begin
          Left := not Left;
        end;
      end if;
    end;
  end for;

  if Left then
    begin
      return 1;
    end;
  end if;

  return 0;
end function;

function RunString(Iterations: integer): integer;
begin
  const Left: string := 'alpha';
  const Right: string := 'beta';
  var Count: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      if (Left = 'alpha') and (Left <> Right) then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

function RunWork(Iterations: integer; Mode: string): integer;
begin
  if Mode = 'real' then
    begin
      return RunReal(Iterations);
    end;
  end if;

  if Mode = 'boolean' then
    begin
      return RunBoolean(Iterations);
    end;
  end if;

  if Mode = 'string' then
    begin
      return RunString(Iterations);
    end;
  end if;

  panic('mode must be real, boolean, or string');
end function;

begin
  if Args.ParamCount() <> 2 then
    begin
      panic('usage: typed_scalar_benchmark.fpas -- ITERATIONS real|boolean|string');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  const Mode: string := Args.ParamStr(1);
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  const Warmup: integer := RunWork(WarmupIterations, Mode);
  const Started: integer := Time.MonotonicMillis();
  const Checksum: integer := RunWork(Iterations, Mode);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  if Warmup < 0 then
    begin
      panic('invalid warmup checksum');
    end;
  end if;

  Console.WriteLn((('mode: ' + Mode) + ', iterations: ') + Conv.IntToStr(Iterations));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  Console.WriteLn('checksum: ' + Conv.IntToStr(Checksum));
end program;
