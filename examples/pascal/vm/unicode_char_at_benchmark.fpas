// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 3000000
// Guard: target/release/fpas run this-file.fpas -- 3000000 MAX_MILLIS

program VmUnicodeCharAtBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Str as Str;
uses Std.Time as Time;

const WarmupIterations: integer := 10000;
const PatternRepetitions: integer := 64;
const PatternLength: integer := 4;
const TextLength: integer := PatternRepetitions * PatternLength;

function MakeText(): string;
begin
  var Text: string := '';
  for Index: integer := 1 to PatternRepetitions do
    begin
      Text := Text + 'aé日😀';
    end;
  end for;

  return Text;
end function;

function RunCharAt(Text: string; Iterations: integer): integer;
begin
  var Matches: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      if Str.CharAt(Text, Index mod TextLength) = '😀' then
        begin
          Matches := Matches + 1;
        end;
      end if;
    end;
  end for;

  return Matches;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: unicode_char_at_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  const Text: string := MakeText();
  var Matches: integer := RunCharAt(Text, WarmupIterations);
  const Started: integer := Time.MonotonicMillis();
  Matches := RunCharAt(Text, Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Iterations * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn((('iterations: ' + Conv.IntToStr(Iterations)) + ', text length: ') +
                  Conv.IntToStr(TextLength));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' chars/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('matches: ' + Conv.IntToStr(Matches));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('unicode-char-at benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
