// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 5000000
// Guard: target/release/fpas run this-file.fpas -- 5000000 MAX_MILLIS

program WrapperPayloadBenchmark;

uses Std.Args as Args;
uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Options as Options;
uses Std.Results as Results;
uses Std.Time as Time;

const WarmupIterations: integer := 100;

function RunWrappers(Iterations: integer): integer;
begin
  var Total: integer := 0;
  for Index: integer := 1 to Iterations do
    begin
      const ResultValue: Result of (integer, string) := Result.Ok(Index);
      const OptionValue: Option of (integer) := Option.Some(Results.Unwrap(ResultValue));
      Total := Total + Options.Unwrap(OptionValue);
    end;
  end for;

  return Total;
end function;

begin
  if (Args.ParamCount() < 1) or (Args.ParamCount() > 2) then
    begin
      panic('usage: wrapper_payload_benchmark.fpas -- ITERATIONS [MAX_MILLIS]');
    end;
  end if;
  const Iterations: integer := Conv.StrToInt(Args.ParamStr(0));
  if Iterations < 1 then
    begin
      panic('ITERATIONS must be positive');
    end;
  end if;
  var MaxMillis: integer := 0;
  if Args.ParamCount() = 2 then
    begin
      MaxMillis := Conv.StrToInt(Args.ParamStr(1));
      if MaxMillis < 1 then
        begin
          panic('MAX_MILLIS must be positive');
        end;
      end if;
    end;
  end if;
  var Total: integer := RunWrappers(WarmupIterations);
  const Started: integer := Time.MonotonicMillis();
  Total := RunWrappers(Iterations);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  const Wrappers: integer := Iterations * 2;
  var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
    begin
      OpsPerSecond := (Wrappers * 1000) div Elapsed;
    end;
  end if;

  Console.WriteLn((('iterations: ' + Conv.IntToStr(Iterations)) + ', wrappers: ') +
                  Conv.IntToStr(Wrappers));
  Console.WriteLn(('elapsed: ' + Conv.IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
    begin
      Console.WriteLn(('throughput: ' + Conv.IntToStr(OpsPerSecond)) + ' wrappers/s');
    end;
  else
    begin
      Console.WriteLn('throughput: unavailable (elapsed time is 0 ms)');
    end;
  end if;

  Console.WriteLn('checksum: ' + Conv.IntToStr(Total));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
    begin
      panic(((('wrapper-payload benchmark regression: ' + Conv.IntToStr(Elapsed)) + ' ms exceeds limit ') + Conv.IntToStr(MaxMillis)) +
            ' ms');
    end;
  end if;
end program;
