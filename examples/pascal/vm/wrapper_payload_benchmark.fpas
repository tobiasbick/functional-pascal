// Build first: cargo build --release -p fpas-cli
// Baseline: target/release/fpas run this-file.fpas -- 5000000
// Guard: target/release/fpas run this-file.fpas -- 5000000 MAX_MILLIS

program WrapperPayloadBenchmark;

uses Std.Args, Std.Console, Std.Conv, Std.Option, Std.Result, Std.Time;

const
  WarmupIterations: integer := 100;

function RunWrappers(Iterations: integer): integer;
begin
  mutable var Total: integer := 0;
  for Index: integer := 1 to Iterations do
  begin
    var ResultValue: result of integer, string := Ok(Index);
    var OptionValue: option of integer := Some(Std.Result.Unwrap(ResultValue));
    Total := Total + Std.Option.Unwrap(OptionValue)
  end;

  return Total
end;

begin
  if (ParamCount() < 1) or (ParamCount() > 2) then
  begin
    panic('usage: wrapper_payload_benchmark.fpas -- ITERATIONS [MAX_MILLIS]')
  end;
  var Iterations: integer := StrToInt(ParamStr(0));
  if Iterations < 1 then
  begin
    panic('ITERATIONS must be positive')
  end;
  mutable var MaxMillis: integer := 0;
  if ParamCount() = 2 then
  begin
    MaxMillis := StrToInt(ParamStr(1));
    if MaxMillis < 1 then
    begin
      panic('MAX_MILLIS must be positive')
    end
  end;
  mutable var Total: integer := RunWrappers(WarmupIterations);
  var Started: integer := MonotonicMillis();
  Total := RunWrappers(Iterations);
  var Elapsed: integer := ElapsedMillis(Started);
  var Wrappers: integer := Iterations * 2;
  mutable var OpsPerSecond: integer := 0;
  if Elapsed > 0 then
  begin
    OpsPerSecond := (Wrappers * 1000) div Elapsed
  end;

  WriteLn((('iterations: ' + IntToStr(Iterations)) + ', wrappers: ') + IntToStr(Wrappers));
  WriteLn(('elapsed: ' + IntToStr(Elapsed)) + ' ms');
  if Elapsed > 0 then
  begin
    WriteLn(('throughput: ' + IntToStr(OpsPerSecond)) + ' wrappers/s')
  end
  else
  begin
    WriteLn('throughput: unavailable (elapsed time is 0 ms)')
  end;

  WriteLn('checksum: ' + IntToStr(Total));
  if (MaxMillis > 0) and (Elapsed > MaxMillis) then
  begin
    panic(((('wrapper-payload benchmark regression: ' + IntToStr(Elapsed)) + ' ms exceeds limit ') + IntToStr(MaxMillis)) +
          ' ms')
  end
end.
