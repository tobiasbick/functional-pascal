program FilterList;

uses
  Fpas.Tui.Application as App, Fpas.Tui.Elements as E, Fpas.Tui.Themes as Themes, System as Sys,
  System.Collections.Generic as Generic, System.Console as Console,
  System.Threading as Threads, System.Threading.Tasks as Tasks;

type Preset = enum: byte
  Light;
  Dark;
  Green;
  Blue;
end enum;

type Msg = union
  FilterChanged(Value: string);
  SelectItem(Id: string);
  OpenOptions;
  CloseOptions;
  ShowHidden(Value: bool);
  ChangeTheme(Value: Preset);
  ResetOptions;
  Refresh;
  ProgressChanged(Value: int);
  RefreshFailed(Reason: string);
  Quit;
end union;

type ListDeps = record
  public Filter: string;
  public Selected: string;
  public ShowHidden: bool;
end record;

type Model = record
  public Filter: string := '';
  public Selected: string := '';
  public ShowHidden: bool := false;
  public Options: bool := false;
  public Appearance: Preset := Preset.Dark;
  public Progress: int := 0;
  public Refreshing: bool := false;
  public Failure: string := '';
end record;

const Names: array of string := ['Amber', 'Birch', 'Cedar', 'Hidden'];

function ColorsFor(State: Model): Themes.Palette;
begin
  case State.Appearance of
    when Preset.Light:
      return Themes.Light();
    when Preset.Green:
      return Themes.Green();
    when Preset.Blue:
      return Themes.Blue();
    else
      return Themes.Dark();
  end case;
end function;

function ThemeFor(State: Model): E.Theme;
begin
  return ColorsFor(State).Theme;
end function;

async function RefreshItems(Post: function(Msg): Tasks.Task; Cancellation: Threads.CancellationToken): Tasks.Task;
begin
  for Value: int in [25, 50, 75, 100] do
    await Tasks.Task.Delay(30, Cancellation);
    await Post(Msg.ProgressChanged(Value));
  end for;
end function;

function Update(State: Model; Message: Msg): App.Transition<Model, Msg>;
begin
  var Next: Model := State;
  var Commands: array of App.Command<Msg> := [];
  case Message of
    when Msg.FilterChanged(const Value: string):
      Next := State with
        Filter := Value;
      end with;
    when Msg.SelectItem(const Id: string):
      Next := State with
        Selected := Id;
      end with;
    when Msg.OpenOptions:
      Next := State with
        Options := true;
      end with;
    when Msg.CloseOptions:
      Next := State with
        Options := false;
      end with;
    when Msg.ShowHidden(const Value: bool):
      Next := State with
        ShowHidden := Value;
      end with;
    when Msg.ChangeTheme(const Value: Preset):
      Next := State with
        Appearance := Value;
      end with;
    when Msg.ResetOptions:
      Next := State with
        ShowHidden := false;
        Appearance := Preset.Dark;
      end with;
    when Msg.Refresh:
      Next := State with
        Progress := 0;
        Refreshing := true;
        Failure := '';
      end with;
      Commands := [
        App.StartBackground<Msg>(
          'refresh', RefreshItems,
          function(Error: Sys.Exception): Msg => Msg.RefreshFailed(Error.Message)
        )
      ];
    when Msg.ProgressChanged(const Value: int):
      Next := State with
        Progress := Value;
        Refreshing := Value < 100;
      end with;
    when Msg.RefreshFailed(const Reason: string):
      Next := State with
        Refreshing := false;
        Failure := Reason;
      end with;
    when Msg.Quit:
      Commands := [App.Exit<Msg>()];
  end case;

  return new App.Transition<Model, Msg>(Next, Commands);
end function;

function SameList(Previous: ListDeps; Current: ListDeps): bool;
begin
  return Previous = Current;
end function;

function Matches(Name: string; Deps: ListDeps): bool;
begin
  return (Deps.ShowHidden or Name <> 'Hidden') and Name.Contains(
    Deps.Filter, Sys.StringComparison.OrdinalIgnoreCase
  );
end function;

function BuildList(Deps: ListDeps): E.Element<Msg>;
begin
  const Items: Generic.List<E.ListItem<Msg>> := new Generic.List<E.ListItem<Msg>>();
  for Name: string in Names do
    if Matches(Name, Deps) then
      Items.Add(new E.ListItem<Msg>(Name, Name, Msg.SelectItem(Name), Name = Deps.Selected));
    end if;
  end for;

  return if Items.Count = 0 then E.Text<Msg>('No matches. Try another search.')
    else E.List<Msg>('items', Items.ToArray())
    end if;
end function;

function Action(Colors: Themes.Palette; Id: string; Text: string; Message: Msg; Primary: bool := false): E.Element<Msg>;
begin
  return E.Styled<Msg>(
    E.Button<Msg>(Id, Text, Message), if Primary then Colors.Primary else Colors.Secondary end if
  );
end function;

function Status(State: Model; Colors: Themes.Palette): E.Element<Msg>;
begin
  if State.Failure <> '' then
    return E.Styled<Msg>(E.Text<Msg>('Refresh failed · ' + State.Failure), Colors.Error);
  end if;
  const Label: string := if State.Refreshing then 'Refreshing'
    else if State.Progress = 100 then 'Up to date' else 'Ready' end if
    end if;
  return E.Row<Msg>(
    new E.Flow(Gap := 1),
    E.Styled<Msg>(E.Text<Msg>(Label), Colors.Muted),
    E.Size<Msg>(
      E.ProgressBar<Msg>(State.Progress),
      new E.Flex(Basis := 18, Grow := 1, Maximum := 24)
    ),
    E.Styled<Msg>(E.Text<Msg>(State.Progress.ToString() + '%'), Colors.Muted)
  );
end function;

function ThemeChoice(Colors: Themes.Palette; Value: Preset; Selected: Preset): E.Element<Msg>;
begin
  const Name: string := Value.ToString();
  return Action(
    Colors,
    'theme-' + Name.ToLowerInvariant(),
    Name,
    Msg.ChangeTheme(Value),
    Value = Selected
  );
end function;

function Options(State: Model; Colors: Themes.Palette): E.Element<Msg>;
begin
  const Content: E.Element<Msg> := E.Styled<Msg>(
    E.Border<Msg>(
      E.Column<Msg>(
        new E.Flow(Gap := 1, Padding := 1),
        E.Text<Msg>('Choose which entries appear in the results.'),
        E.Styled<Msg>(
          E.Checkbox<Msg>(
            'show-hidden',
            'Show hidden',
            State.ShowHidden,
            function(Value: bool): Msg => Msg.ShowHidden(Value)
          ), Colors.Secondary
        ),
        E.Row<Msg>(
          new E.Flow(Gap := 1),
          E.Text<Msg>('Theme · ' + State.Appearance.ToString()),
          ThemeChoice(Colors, Preset.Light, State.Appearance),
          ThemeChoice(Colors, Preset.Dark, State.Appearance),
          ThemeChoice(Colors, Preset.Green, State.Appearance),
          ThemeChoice(Colors, Preset.Blue, State.Appearance)
        ),
        E.Row<Msg>(
          new E.Flow(Gap := 1),
          E.Size<Msg>(E.Text<Msg>(''), new E.Flex(Grow := 1)),
          Action(Colors, 'reset', 'Ctrl+R Reset', Msg.ResetOptions),
          Action(Colors, 'close', 'Esc Done', Msg.CloseOptions, true)
        )
      ), 'Options'
    ), Colors.Panel
  );
  return E.Overlay<Msg>(
    'options-overlay', true, 'show-hidden', Msg.CloseOptions, Content,
    [E.Shortcut<Msg>(E.Key.R, E.KeyModifiers.Ctrl, Msg.ResetOptions)]
  );
end function;

function View(State: Model): E.Element<Msg>;
begin
  const Colors: Themes.Palette := ColorsFor(State);
  const Deps: ListDeps := new ListDeps(State.Filter, State.Selected, State.ShowHidden);
  var Count: int := 0;
  for Name: string in Names do
    if Matches(Name, Deps) then
      Count := Count + 1;
    end if;
  end for;
  const Results: E.Element<Msg> := E.CachedSubview<ListDeps, Msg>(
    'results',
    Deps,
    BuildList,
    SameList
  );
  const Footer: E.Element<Msg> := if State.Options then E.Styled<Msg>(
      E.Text<Msg>('Options open · Esc to close'),
      Colors.Muted
    )
    else E.Row<Msg>(
      new E.Flow(Gap := 1),
      Action(Colors, 'options', 'Ctrl+O Options', Msg.OpenOptions),
      Action(Colors, 'refresh', 'Ctrl+R Refresh', Msg.Refresh, true),
      Action(Colors, 'quit', 'Ctrl+Q Quit', Msg.Quit)
    )
    end if;
  const Body: E.Element<Msg> := E.Column<Msg>(
    new E.Flow(Gap := 1, Padding := 1),
    E.Row<Msg>(
      new E.Flow(Gap := 1),
      E.Size<Msg>(E.Styled<Msg>(E.Text<Msg>('Filter list'), Colors.Heading), new E.Flex(Grow := 1)),
      E.Styled<Msg>(
        E.Text<Msg>(Count.ToString() + (if Count = 1 then ' match' else ' matches' end if)),
        Colors.Muted
      )
    ),
    E.Row<Msg>(
      new E.Flow(Gap := 1), E.Styled<Msg>(E.Text<Msg>('Search'), Colors.Muted),
      E.Size<Msg>(
        E.TextInput<Msg>(
          'filter',
          State.Filter,
          function(Value: string): Msg => Msg.FilterChanged(Value)
        ),
        new E.Flex(Grow := 1)
      )
    ),
    E.Size<Msg>(
      E.Styled<Msg>(
        E.Border<Msg>(
          E.Column<Msg>(new E.Flow(Padding := 1), E.Size<Msg>(Results, new E.Flex(Grow := 1))),
          'Results'
        ), Colors.Panel
      ),
      new E.Flex(Basis := 6, Minimum := 3, Grow := 1)
    ),
    Status(State, Colors),
    Footer
  );

  const Layers: array of E.Element<Msg> := if State.Options then [
    Options(State, Colors)
  ] else [] end if;
  return E.Screen<Msg>(
    Body, Layers, [
      E.Shortcut<Msg>(E.Key.O, E.KeyModifiers.Ctrl, Msg.OpenOptions),
      E.Shortcut<Msg>(E.Key.R, E.KeyModifiers.Ctrl, Msg.Refresh),
      E.Shortcut<Msg>(E.Key.Q, E.KeyModifiers.Ctrl, Msg.Quit)
    ]
  );
end function;

function RequireControl(Frame: App.Frame; Id: string; Focused: bool := false): App.ControlSnapshot;
begin
  for Control: App.ControlSnapshot in Frame.Controls do
    if Control.Id = Id and (not Focused or Control.Focused) then
      return Control;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing expected control: ' + Id);
end function;

procedure CheckPalette(Session: App.HeadlessSession; Control: string; Expected: Themes.Palette);
begin
  discard Session.Send(App.Input.Activate(Control));
  discard Session.Step();
  const Frame: App.Frame := Session.Snapshot();
  if Frame.Cells[0].Style.Background <> Expected.Theme.Text.Background then
    raise new Sys.InvalidOperationException(
      'The palette was not applied to the current frame: ' + Control
    );
  end if;

  discard RequireControl(Frame, Control, true);
end procedure;

procedure Demonstrate();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<Model, Msg>(
    new Model(),
    Update,
    View,
    80,
    24,
    ThemeFor
  );
  discard RequireControl(Session.Snapshot(), 'filter', true);
  discard Session.Send(App.Input.Paste('bir' + new string([#13, #10]) + 'ch'));
  discard Session.Step();
  if Session.Snapshot().Controls[0].Value <> 'bir ch' then
    raise new Sys.InvalidOperationException('Paste was not normalized.');
  end if;

  discard Session.Send(App.Input.KeyPress(E.Key.A, E.KeyModifiers.Ctrl));
  discard Session.Step();
  discard Session.Send(App.Input.TextInput('bir'));
  discard Session.Step();
  discard Session.Send(App.Input.Activate('items/Birch'));
  discard Session.Step();
  discard Session.Send(App.Input.Activate('filter'));
  discard Session.Step();
  const Selected: App.Frame := Session.Snapshot();
  const Birch: App.ControlSnapshot := RequireControl(Selected, 'items/Birch');
  const Filter: App.ControlSnapshot := RequireControl(Selected, 'filter', true);
  const Marker: E.Cell := Selected.Cells[Birch.Row * Selected.Columns + Birch.Column];
  const Field: E.Cell := Selected.Cells[Filter.Row * Selected.Columns + Filter.Column];
  if Birch.Focused or Marker.Text <> '▸' or Marker.Style.Background = Field.Style.Background then
    raise new Sys.InvalidOperationException(
      'Selection did not remain visible when focus returned to the filter.'
    );
  end if;

  discard Session.Send(App.Input.Activate('options'));
  discard Session.Step();
  discard RequireControl(Session.Snapshot(), 'show-hidden', true);
  CheckPalette(Session, 'theme-light', Themes.Light());
  CheckPalette(Session, 'theme-green', Themes.Green());
  CheckPalette(Session, 'theme-blue', Themes.Blue());
  CheckPalette(Session, 'theme-dark', Themes.Dark());
  discard Session.Send(App.Input.KeyPress(E.Key.Escape, E.KeyModifiers.None));
  discard Session.Step();
  discard RequireControl(Session.Snapshot(), 'options', true);
  discard Session.Send(App.Input.KeyPress(E.Key.R, E.KeyModifiers.Ctrl));
  discard Session.Step();
  using const Deadline: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(
    5000
  );
  for Index: int := 1 to 4 do
    if not Session.WaitForWork(Deadline.Token).GetAwaiter().GetResult() then
      raise new Sys.InvalidOperationException('Missing progress update.');
    end if;

    discard Session.Step();
  end for;

  discard Session.Send(App.Input.Resize(53, 17));
  discard Session.Step();
  const Frame: App.Frame := Session.Snapshot();
  if Frame.Columns <> 53 or Frame.Rows <> 17 then
    raise new Sys.InvalidOperationException('Unexpected frame size.');
  end if;

  const Text: string := Sys.String.Join('', Frame.Lines);
  if not Text.Contains('Up to date') or not Text.Contains('100%') then
    raise new Sys.InvalidOperationException('The last progress message was not displayed.');
  end if;

  for Line: string in Frame.Lines do
    Console.WriteLine(Line.TrimEnd());
  end for;
end procedure;

begin
  const Arguments: array of string := Sys.Environment.GetCommandLineArgs();
  if Sys.Array.IndexOf<string>(Arguments, '--headless-control') >= 0 then
    using const Session: App.HeadlessSession := App.StartHeadless<Model, Msg>(
      new Model(),
      Update,
      View,
      80,
      24,
      ThemeFor
    );
    while Session.IsOpen() do
      Threads.Thread.Sleep(20);
    end while;
  else
    if Sys.Array.IndexOf<string>(Arguments, '--headless') >= 0 then
      Demonstrate();
    else
      App.Run<Model, Msg>(new Model(), Update, View, ThemeFor);
    end if;
  end if;
end;
end program;
