unit Gallery.State;

uses
  Fpas.Mvu.Application as Mvu, Fpas.Tui.Elements as E, Fpas.Tui.Themes as Themes, Fpas.Tui.Editors as Editors,
  System as Sys;

public type Page = enum: byte
  Buttons;
  Checkbox;
  TextInput;
  Lists;
  Progress;
  Layout;
  Scrolling;
  Canvas;
  Overlay;
  Tabs;
  Table;
  Multiline;
end enum;

public type Preset = enum: byte
  Light;
  Dark;
  Green;
  Blue;
  /// The built-in dark amber palette.
  Amber;
end enum;

public const Pages: array of Page := Sys.Enum.GetValues<Page>();

public type DocumentKind = enum: byte
  Notes;
  Draft;
end enum;

public type Document = record
  public Text: string;
  public Position: Editors.EditorPosition := new Editors.EditorPosition();
  public Dirty: bool := false;
end record;

const NoteLines: array of string := [
  'Field notes', '', '01 · Arrival', '02 · North path', '03 · Birch grove', '04 · Creek',
  '05 · Bridge', '06 · Old mill', '07 · Ridge', '08 · Lookout', '09 · Camp', '10 · Dusk',
  '11 · Map', '12 · Waypoints', '13 · Supplies', '14 · Weather', '15 · Return', '16 · Review',
  'End of notes'
];

const Notes: string := Sys.String.Join(new string(#10, 1), NoteLines);

public type Model = record
  public Active: Page := Page.Buttons;
  public Appearance: Preset := Preset.Dark;
  public Presses: int := 0;
  public Checked: bool := false;
  public Text: string := '';
  public Selection: string := 'birch';
  public Opened: string := '';
  public Empty: bool := false;
  public Progress: int := 0;
  public LogCount: int := 9;
  public LogPosition: E.ScrollPosition := E.ScrollPosition.End;
  public Overlay: bool := false;
  public OverlayPosition: E.ScrollPosition := E.ScrollPosition.Offset(0);
  public ActiveTab: string := 'general';
  public TabName: string := 'Gallery';
  public PreviewColors: bool := true;
  public TableSelection: string := 'alder';
  public TableOpened: string := '';
  public Columns: int := 0;
  public Rows: int := 0;
  public Pointer: string := 'Try the mouse here.';
  public ActiveDocument: DocumentKind := DocumentKind.Notes;
  public Notebook: Document := new Document(Notes);
  public Draft: Document := new Document('Draft idea');
end record;

public type Msg = union
  Show(Value: Page);
  MovePage(Direction: int);
  ChangeTheme(Value: Preset);
  Press;
  ResetPresses;
  Check(Value: bool);
  Edit(Value: string);
  Choose(Value: string);
  OpenItem(Value: string);
  EmptyList(Value: bool);
  Advance;
  ResetProgress;
  AppendLog;
  ScrollLog(Position: E.ScrollPosition);
  ResizeCanvas(Columns: int; Rows: int);
  CanvasEvent(Value: string);
  SetOverlay(Open: bool);
  ScrollOverlay(Position: E.ScrollPosition);
  ChooseTab(Key: string);
  EditTabName(Value: string);
  ToggleTabColors(Value: bool);
  SelectWorld(Key: string);
  OpenWorld(Key: string);
  ChooseDocument(Kind: DocumentKind);
  EditDocument(Change: Editors.TextEdit);
  NavigateDocument(Position: Editors.EditorPosition);
  Quit;
end union;

public function Title(Value: Page): string;
begin
  case Value of
    when Page.TextInput:
      return 'Text input';
    when Page.Progress:
      return 'Progress bar';
    when Page.Layout:
      return 'Text & layout';
    when Page.Scrolling:
      return 'Scroll view';
    when Page.Canvas:
      return 'Cell canvas';
    when Page.Multiline:
      return 'Multiline editor';
    else
      return Value.ToString();
  end case;
end function;

public function Colors(Value: Preset): Themes.Palette;
begin
  case Value of
    when Preset.Light:
      return Themes.Light();
    when Preset.Green:
      return Themes.Green();
    when Preset.Blue:
      return Themes.Blue();
    when Preset.Amber:
      return Themes.Amber();
    else
      return Themes.Dark();
  end case;
end function;

public function ThemeFor(State: Model): E.Theme;
begin
  return Colors(State.Appearance).Theme;
end function;

function Adjacent(Value: Page; Direction: int): Page;
begin
  return Pages[(cast<int>(Value) + Direction + Pages.Length) mod Pages.Length];
end function;

public function CurrentDocument(State: Model): Document;
begin
  return if State.ActiveDocument = DocumentKind.Notes then State.Notebook else State.Draft end if;
end function;

function StoreDocument(State: Model; Value: Document): Model;
begin
  if State.ActiveDocument = DocumentKind.Notes then
    return State with
      Notebook := Value;
    end with;
  end if;

  return State with
    Draft := Value;
  end with;
end function;

public function Update(State: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  const Next: Model := case Message of
    when Msg.Show(const Value: Page): State with
      Active := Value;
    end with;
    when Msg.MovePage(const Direction: int): State with
      Active := Adjacent(State.Active, Direction);
    end with;
    when Msg.ChangeTheme(const Value: Preset): State with
      Appearance := Value;
    end with;
    when Msg.Press: State with
      Presses := State.Presses + 1;
    end with;
    when Msg.ResetPresses: State with
      Presses := 0;
    end with;
    when Msg.Check(const Value: bool): State with
      Checked := Value;
    end with;
    when Msg.Edit(const Value: string): State with
      Text := Value;
    end with;
    when Msg.Choose(const Value: string): State with
      Selection := Value;
    end with;
    when Msg.OpenItem(const Value: string): State with
      Opened := Value;
    end with;
    when Msg.EmptyList(const Value: bool): State with
      Empty := Value;
    end with;
    when Msg.Advance: State with
      Progress := Sys.Math.Min(State.Progress + 25, 100);
    end with;
    when Msg.ResetProgress: State with
      Progress := 0;
    end with;
    when Msg.AppendLog: State with
      LogCount := Sys.Math.Min(State.LogCount + 1, 100);
    end with;
    when Msg.ScrollLog(const Position: E.ScrollPosition): State with
      LogPosition := Position;
    end with;
    when Msg.ResizeCanvas(const Columns: int, const Rows: int): State with
      Columns := Columns;
      Rows := Rows;
    end with;
    when Msg.CanvasEvent(const Value: string): State with
      Pointer := Value;
    end with;
    when Msg.SetOverlay(const Open: bool): State with
      Overlay := Open;
      OverlayPosition := E.ScrollPosition.Offset(0);
    end with;
    when Msg.ScrollOverlay(const Position: E.ScrollPosition): State with
      OverlayPosition := Position;
    end with;
    when Msg.ChooseTab(const Key: string): if State.Active = Page.Tabs then State with
        ActiveTab := Key;
      end with
      else State
      end if;
    when Msg.EditTabName(const Value: string): State with
      TabName := Value;
    end with;
    when Msg.ToggleTabColors(const Value: bool): State with
      PreviewColors := Value;
    end with;
    when Msg.SelectWorld(const Key: string): State with
      TableSelection := Key;
    end with;
    when Msg.OpenWorld(const Key: string): State with
      TableOpened := Key;
    end with;
    when Msg.ChooseDocument(const Kind: DocumentKind): State with
      ActiveDocument := Kind;
    end with;
    when Msg.EditDocument(const Change: Editors.TextEdit): StoreDocument(
      State, new Document(Change.Text, Change.Position, true)
    );
    when Msg.NavigateDocument(const Position: Editors.EditorPosition): StoreDocument(
      State, CurrentDocument(State) with
        Position := Position;
      end with
    );
    when Msg.Quit: State;
  end case;
  const Commands: array of Mvu.Command<Msg> := case Message of
    when Msg.Quit: [Mvu.Exit<Msg>()];
    when Msg.ChooseDocument(_): [Mvu.Focus<Msg>('document-editor')];
    else if Next.Active = Page.Multiline and Next.Active <> State.Active then [
        Mvu.Focus<Msg>('document-editor')
      ]
      else if Next.Active = Page.TextInput and Next.Active <> State.Active then [
          Mvu.Focus<Msg>('text-entry')
        ]
        else []
        end if
      end if;
  end case;
  return new Mvu.Transition<Model, Msg>(Next, Commands);
end function;
end unit;
