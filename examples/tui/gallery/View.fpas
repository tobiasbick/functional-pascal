unit Gallery.View;

uses
  Gallery.State as G, Gallery.Previews as P, Fpas.Tui.Application as App, Fpas.Tui.Elements as E,
  Fpas.Tui.Themes as Themes, Fpas.Tui.Status as Status, System.Collections.Generic as Generic;

function Pages(Active: G.Page): E.Element<G.Msg>;
begin
  const Items: Generic.List<E.ListItem<G.Msg>> := new Generic.List<E.ListItem<G.Msg>>();
  for Page: G.Page in G.Pages do
    Items.Add(
      new E.ListItem<G.Msg>(
        Page.ToString().ToLowerInvariant(), G.Title(Page), G.Msg.Show(Page), Page = Active
      )
    );
  end for;

  return E.Border<G.Msg>(E.List<G.Msg>('pages', Items.ToArray()), 'Widgets');
end function;

function ThemeButton(Current: G.Preset; Target: G.Preset): E.Element<G.Msg>;
begin
  const Label: string := Target.ToString();
  return E.Button<G.Msg>(
    'theme-' + Label.ToLowerInvariant(), Label, G.Msg.ChangeTheme(Target),
    Variant := if Current = Target then E.ButtonVariant.Active else E.ButtonVariant.Secondary end if
  );
end function;

function ThemeBar(Current: G.Preset; Columns: int): E.Element<G.Msg>;
begin
  const Flow: E.Flow := new E.Flow(Gap := 1);
  const Light: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Light);
  const Dark: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Dark);
  const Green: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Green);
  const Blue: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Blue);
  const Amber: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Amber);
  // The five captions, button padding and gaps take 37 cells.
  if Columns < 39 then
    return E.Column<G.Msg>(E.Row<G.Msg>(Flow, Light, Dark, Green), E.Row<G.Msg>(Flow, Blue, Amber));
  end if;

  const Buttons: E.Element<G.Msg> := E.Row<G.Msg>(Flow, Light, Dark, Green, Blue, Amber);
  return if Columns < 52 then Buttons
    else E.Row<G.Msg>(new E.Flow(Gap := 1), E.Text<G.Msg>('Theme: ' + Current.ToString()), Buttons)
    end if;
end function;

const PreviousPage: E.ShortcutBinding<G.Msg> := E.Shortcut<G.Msg>(
  E.Key.PageUp, E.KeyModifiers.None, G.Msg.MovePage(-1)
);
const NextPage: E.ShortcutBinding<G.Msg> := E.Shortcut<G.Msg>(
  E.Key.PageDown, E.KeyModifiers.None, G.Msg.MovePage(1)
);
const Quit: E.ShortcutBinding<G.Msg> := E.Shortcut<G.Msg>(E.Key.Q, E.KeyModifiers.Ctrl, G.Msg.Quit);

const Keys: array of E.ShortcutBinding<G.Msg> := [
  PreviousPage, NextPage,
  E.Shortcut<G.Msg>(E.Key.T, E.KeyModifiers.Ctrl, G.Msg.ChooseTab('general')),
  Quit
];

const QuitHint: string := Status.Hint<G.Msg>(Quit, 'Quit');
const EscapeHint: string := Status.Hint(E.Key.Escape, E.KeyModifiers.None, 'Close');
const Hints: array of string := [
  QuitHint, Status.Hint(E.Key.Tab, E.KeyModifiers.None, 'Focus'),
  Status.Hint<G.Msg>(PreviousPage, 'Previous page'), Status.Hint<G.Msg>(NextPage, 'Next page')
];

function StatusLine(State: G.Model; Compact: bool): E.Element<G.Msg>;
begin
  if State.Overlay then
    return Status.Line<G.Msg>(if Compact then '' else 'Overlay open' end if, EscapeHint);
  end if;

  if Compact then
    return Status.Line<G.Msg>('', QuitHint);
  end if;

  return Status.Line<G.Msg>(G.Title(State.Active), Hints);
end function;

function PageButtons(): E.Element<G.Msg>;
begin
  return E.Row<G.Msg>(
    new E.Flow(Gap := 1),
    E.Button<G.Msg>('previous-page', 'Previous', G.Msg.MovePage(-1)),
    E.Button<G.Msg>('next-page', 'Next', G.Msg.MovePage(1))
  );
end function;

public function View(State: G.Model; Viewport: App.Viewport): E.Element<G.Msg>;
begin
  const Colors: Themes.Palette := G.Colors(State.Appearance);
  const Overlays: array of E.Element<G.Msg> := if State.Overlay then [P.Overlay(State, Colors)]
    else []
    end if;
  if Viewport.Columns < 32 or Viewport.Rows < 12 then
    const Help: string := if State.Overlay then ' Escape closes the overlay.'
      else ' Ctrl+Q quits.'
      end if;
    return E.Screen<G.Msg>(
      E.Styled<G.Msg>(E.Text<G.Msg>('Resize to 32 × 12.' + Help), Colors.Heading),
      Overlays, Keys
    );
  end if;

  const Compact: bool := Viewport.Columns < 42;
  const Dimensions: string := Viewport.Columns.ToString() + ' × ' + Viewport.Rows.ToString();
  const Heading: string := if Compact then 'Gallery' else 'FPAS  /  Widget Gallery' end if;
  const Preview: E.Element<G.Msg> := E.Styled<G.Msg>(
    E.Border<G.Msg>(
      E.Column<G.Msg>(
        new E.Flow(Padding := if Compact then 0 else 1 end if),
        E.Size<G.Msg>(P.Body(State, Colors), new E.Flex(Grow := 1))
      ), G.Title(State.Active)
    ),
    Colors.Panel
  );
  const Body: E.Element<G.Msg> := if Compact then Preview
    else E.Row<G.Msg>(
      new E.Flow(Gap := 1),
      E.Size<G.Msg>(Pages(State.Active), new E.Flex(Basis := 17, Minimum := 11)),
      E.Size<G.Msg>(Preview, new E.Flex(Basis := 0, Grow := 1))
    )
    end if;
  const Line: E.Element<G.Msg> := E.Styled<G.Msg>(StatusLine(State, Compact), Colors.Muted);
  const Footer: E.Element<G.Msg> := if Compact then E.Row<G.Msg>(
      new E.Flow(Gap := 1), PageButtons(), E.Size<G.Msg>(Line, new E.Flex(Basis := 0, Grow := 1))
    )
    else Line
    end if;
  return E.Screen<G.Msg>(
    E.Column<G.Msg>(
      new E.Flow(Padding := 1, Gap := if Compact then 0 else 1 end if),
      E.Styled<G.Msg>(E.Text<G.Msg>(Heading + '   ' + Dimensions), Colors.Heading),
      E.Size<G.Msg>(Body, new E.Flex(Basis := 4, Grow := 1)),
      ThemeBar(State.Appearance, Viewport.Columns),
      Footer
    ),
    Overlays,
    Keys
  );
end function;
end unit;
