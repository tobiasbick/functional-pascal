unit Mandelbrot.Explorer;

uses Fpas.Mvu.Application as Mvu, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as InputKeys, Fpas.Ui.TerminalExtensions.Views as Views, Fpas.Tui.Themes as Themes, Mandelbrot.Model as M, Mandelbrot.Palette as P, Mandelbrot.Render as R, System as Sys, System.Globalization as Globalization, System.Threading as Threads, System.Threading.Tasks as Tasks;

const RenderId: string := 'mandelbrot';
const Colors: Themes.Theme := Themes.Dark();

function Render(State: M.State; Gate: Threads.SemaphoreSlim): Mvu.Command<M.Message>;
  async function Work(Post: function(M.Message): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
  begin
    await Gate.WaitAsync(Token);
    var Image: array of T.Cell := [];
    try
      Image := R.Compute(State.Camera, State.Columns, State.Rows, Token);
    finally
      discard Gate.Release();
    end try;

    Token.ThrowIfCancellationRequested();
    await Post(M.Message.Rendered(Image));
  end function;
begin
  if State.Columns = 0 or State.Rows = 0 then
    return Mvu.CancelBackground<M.Message>(RenderId);
  end if;

  return Mvu.StartBackground<M.Message>(
    RenderId, Work, function(Failure: Sys.Exception): M.Message => M.Message.Failed(Failure.Message)
  );
end function;

public function CreateUpdate(Gate: Threads.SemaphoreSlim): function(M.State, M.Message): Mvu.Transition<M.State, M.Message>;
  function Update(State: M.State; Message: M.Message): Mvu.Transition<M.State, M.Message>;
  begin
    var Next: M.State := State;
    var Camera: M.Camera := State.Camera;
    case Message of
      when M.Message.Resize(const Columns: int, const Rows: int):
        Next := State with
          Columns := Columns;
          Rows := Rows;
          Image := [];
        end with;
      when M.Message.Pan(const X: int, const Y: int):
        Camera := Camera with
          X := Camera.X + cast<double>(X) * Camera.SpanX(State.Columns, State.Rows) * 0.14;
          Y := Camera.Y + cast<double>(Y) * Camera.Span * 0.14;
        end with;
      when M.Message.Center(const Column: int, const Row: int):
        Camera := Camera with
          X := Camera.XAt(Column, State.Columns, State.Rows);
          Y := Camera.YAt(Row, State.Rows);
        end with;
      when M.Message.Zoom(const Factor: double):
        Camera := Camera with
          Span := Sys.Math.Clamp(Camera.Span * Factor, 0.000001, 3.5);
        end with;
      when M.Message.Iterate(const Delta: int):
        Camera := Camera with
          Iterations := Sys.Math.Clamp(Camera.Iterations + Delta, 32, 2048);
        end with;
      when M.Message.SelectPalette(const Kind: P.Kind):
        Camera := Camera with
          Palette := Kind;
        end with;
      when M.Message.Reset:
        Camera := new M.Camera();
      when M.Message.ToggleHelp:
        return new Mvu.Transition<M.State, M.Message>(
          State with
            Help := not State.Help;
          end with, []
        );
      when M.Message.Exit:
        return new Mvu.Transition<M.State, M.Message>(State, [Mvu.Exit<M.Message>()]);
      when M.Message.Rendered(const Image: array of T.Cell):
        return new Mvu.Transition<M.State, M.Message>(
          State with
            Image := Image;
            Ready := true;
          end with, []
        );
      when M.Message.Failed(const Reason: string):
        return new Mvu.Transition<M.State, M.Message>(
          State with
            Failure := Reason;
          end with, []
        );
    end case;

    if Camera = State.Camera and Next.Columns = State.Columns and Next.Rows = State.Rows then
      return new Mvu.Transition<M.State, M.Message>(State, []);
    end if;

    Next := Next with
      Camera := Camera;
      Ready := false;
      Failure := '';
    end with;
    return new Mvu.Transition<M.State, M.Message>(Next, [Render(Next, Gate)]);
  end function;
begin
  return Update;
end function;

function Center(Column: int; Row: int): M.Message;
begin
  return M.Message.Center(Column, Row);
end function;

function Resize(Columns: int; Rows: int): M.Message;
begin
  return M.Message.Resize(Columns, Rows);
end function;

function Reset(Column: int; Row: int): M.Message;
begin
  return M.Message.Reset;
end function;

function Wheel(Column: int; Row: int; Delta: int): M.Message;
begin
  return M.Message.Zoom(
    if Delta < 0 then 0.88 else if Delta > 0 then 1.0 / 0.88 else 1.0 end if end if
  );
end function;

const CanvasInput: T.CanvasEvents<M.Message> := new T.CanvasEvents<M.Message>(
  Resize,
  Center,
  Reset,
  Wheel
);

type Details = record
  public Camera: M.Camera;
  public Ready: bool;
  public Failure: string;
end record;

function DetailsEqual(Previous: Details; Current: Details): bool;
begin
  return Previous = Current;
end function;

function Meter(Label: string; Value: string; Percent: int): E.Element<M.Message>;
begin
  return E.Row<M.Message>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Size<M.Message>(
      E.Text<M.Message>(Label + ' ' + Value),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(17)))
    ),
    E.Size<M.Message>(
      E.ProgressBar<M.Message>(Percent),
      new L.Flex(
        Basis := L.Extent.Fixed(L.Measure.Cells(14)),
        Grow := 1,
        Maximum := L.Measure.Cells(32)
      )
    )
  );
end function;

function DetailView(Data: Details): E.Element<M.Message>;
begin
  const Culture: Globalization.CultureInfo := Globalization.CultureInfo.InvariantCulture;
  const Camera: M.Camera := Data.Camera;
  const Zoom: double := Camera.Zoom();
  const Status: string := if Data.Failure <> '' then 'render failed: ' + Data.Failure
    else if Data.Ready then 'ready' else 'rendering' end if
    end if;
  return E.Column<M.Message>(
    E.CellStyled<M.Message>(
      E.Text<M.Message>(
        'center=(' + Camera.X.ToString('F4', Culture) + ', ' +
        Camera.Y.ToString('F4', Culture) + ')  ' + P.Name(Camera.Palette) + '  ' + Status
      ),
      if Data.Failure = '' then Colors.Heading else Colors.Error end if
    ),
    Meter('Iterations', Camera.Iterations.ToString(), Camera.Iterations * 100 div 2048),
    Meter('Zoom', Zoom.ToString('F2', Culture) + 'x', cast<int>(Sys.Math.Min(Zoom, 100.0)))
  );
end function;

function Help(): E.Element<M.Message>;
begin
  return Views.Layer<M.Message>(
    'help', E.CellStyled<M.Message>(
      E.Border<M.Message>(
        E.Column<M.Message>(
          new L.Flow(Padding := L.Spacing.Fixed(L.Measure.Cells(1))),
          E.Text<M.Message>('Arrows or left click · pan and center'),
          E.Text<M.Message>('+ / - or mouse wheel · zoom'),
          E.Text<M.Message>('Page Up / Down · change iterations'),
          E.Text<M.Message>('1 / 2 / 3 · change color palette'),
          E.Text<M.Message>('R or middle click · reset'),
          E.CellStyled<M.Message>(
            E.Button<M.Message>('close-help', 'Esc Close', M.Message.ToggleHelp),
            Colors.Primary
          )
        ),
        'Controls'
      ),
      Colors.Panel
    ), [], InitialFocus := 'close-help', OnDismiss := function(): M.Message => M.Message.ToggleHelp
  );
end function;

const Shortcuts: array of InputKeys.ShortcutBinding<M.Message> := [
  InputKeys.Shortcut<M.Message>(
    InputKeys.Key.Left,
    InputKeys.KeyModifiers.None,
    M.Message.Pan(-1, 0)
  ),
  InputKeys.Shortcut<M.Message>(
    InputKeys.Key.Right,
    InputKeys.KeyModifiers.None,
    M.Message.Pan(1, 0)
  ),
  InputKeys.Shortcut<M.Message>(InputKeys.Key.Up, InputKeys.KeyModifiers.None, M.Message.Pan(0, 1)),
  InputKeys.Shortcut<M.Message>(
    InputKeys.Key.Down,
    InputKeys.KeyModifiers.None,
    M.Message.Pan(0, -1)
  ),
  InputKeys.Shortcut<M.Message>(
    InputKeys.Key.PageUp,
    InputKeys.KeyModifiers.None,
    M.Message.Iterate(32)
  ),
  InputKeys.Shortcut<M.Message>(
    InputKeys.Key.PageDown,
    InputKeys.KeyModifiers.None,
    M.Message.Iterate(-32)
  ),
  InputKeys.Shortcut<M.Message>(InputKeys.Key.Escape, InputKeys.KeyModifiers.None, M.Message.Exit),
  InputKeys.CharacterShortcut<M.Message>('+', M.Message.Zoom(0.82)),
  InputKeys.CharacterShortcut<M.Message>('=', M.Message.Zoom(0.82)),
  InputKeys.CharacterShortcut<M.Message>('-', M.Message.Zoom(1.0 / 0.82)),
  InputKeys.CharacterShortcut<M.Message>('1', M.Message.SelectPalette(P.Kind.DeepOcean)),
  InputKeys.CharacterShortcut<M.Message>('2', M.Message.SelectPalette(P.Kind.Ember)),
  InputKeys.CharacterShortcut<M.Message>('3', M.Message.SelectPalette(P.Kind.Aurora)),
  InputKeys.CharacterShortcut<M.Message>('h', M.Message.ToggleHelp),
  InputKeys.CharacterShortcut<M.Message>('H', M.Message.ToggleHelp),
  InputKeys.CharacterShortcut<M.Message>('r', M.Message.Reset),
  InputKeys.CharacterShortcut<M.Message>('R', M.Message.Reset)
];

const Footer: E.Element<M.Message> := E.CellStyled<M.Message>(
  E.Text<M.Message>('Arrows pan   +/- zoom   1/2/3 palette   H help   Esc quit'), Colors.Muted
);

public function View(State: M.State): E.Element<M.Message>;
  function Draw(Column: int; Row: int): T.Cell;
  begin
    if Column < State.Columns and Row < State.Rows and State.Image.Length > 0 then
      return State.Image[Row * State.Columns + Column];
    end if;

    return P.Blank;
  end function;
begin
  const Canvas: E.Element<M.Message> := E.Border<M.Message>(
    E.CellCanvas<M.Message>('fractal', Draw, CanvasInput), 'Mandelbrot Explorer'
  );
  const Body: E.Element<M.Message> := E.Column<M.Message>(
    E.Size<M.Message>(Canvas, new L.Flex(Grow := 1)),
    E.CachedSubview<Details, M.Message>(
      'details', new Details(State.Camera, State.Ready, State.Failure), DetailView, DetailsEqual
    ),
    Footer
  );
  return Views.Screen<M.Message>(Body, if State.Help then [Help()] else [] end if, Shortcuts);
end function;
end unit;
