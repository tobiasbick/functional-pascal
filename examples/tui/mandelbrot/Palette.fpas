unit Mandelbrot.Palette;

uses Fpas.Tui.Elements as E, System as Sys;

public type Kind = enum
  DeepOcean;
  Ember;
  Aurora;
end enum;

const DeepOcean: array of int := [
  $051025, $0B1F46, $10336A, $144A8A, $1A63A7, $227FC1,
  $2E9CCF, $4CB7D8, $70D0DB, $A1E0D8, $D4EDE8, $F2F8FF
];
const Ember: array of int := [
  $400000, $6A0A00, $8A1E00, $B03A00, $D45A00, $F07A00,
  $FF9F1A, $FFBE4A, $FFD978, $FFE7A6, $FFF1CC, $FFF8E8
];
const Aurora: array of int := [
  $041020, $0A2E48, $104D6A, $146886, $197C8F, $238E7C,
  $34A968, $64BF64, $94D976, $BCE68A, $EAF0B4, $F8F8E0
];

public const Blank: E.Cell := new E.Cell(' ', new E.Style(0, 0));

public function Name(Palette: Kind): string;
begin
  case Palette of
    when Kind.DeepOcean:
      return 'Deep Ocean';
    when Kind.Ember:
      return 'Ember';
    when Kind.Aurora:
      return 'Aurora';
    else
      raise new Sys.ArgumentOutOfRangeException('Palette');
  end case;
end function;

public function Color(Palette: Kind; Escape: double): E.Cell;
begin
  const Ramp: string := ' ░▒▓█';
  const Phase: double := Escape * 0.08;
  const Fraction: double := Phase - Sys.Math.Truncate(Phase);
  const Band: int := Sys.Math.Clamp(cast<int>(Fraction * 12.0), 0, 11);
  const Shade: int := Sys.Math.Clamp(cast<int>(Fraction * 5.0), 0, 4);
  var Rgb: int := 0;
  case Palette of
    when Kind.DeepOcean:
      Rgb := DeepOcean[Band];
    when Kind.Ember:
      Rgb := Ember[Band];
    when Kind.Aurora:
      Rgb := Aurora[Band];
    else
      raise new Sys.ArgumentOutOfRangeException('Palette');
  end case;

  return new E.Cell(Ramp[Shade].ToString(), new E.Style(Rgb, 0));
end function;
end unit;
