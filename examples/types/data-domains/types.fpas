unit Example.Domains;

// An account identity, separate from ordinary numeric values.
public type AccountId = distinct long;

public type PlayerName = distinct string;

public type Amount = decimal;

// Even default-initialized storage represents a valid port.
public type Port = ushort range 1..65535;

public type Status = enum: byte
  Offline;
  Online;
  Maintenance;
end enum;

public function Describe(Value: Port): string;
begin
  return case Value of
    when 1..1023: 'system';
    when 1024..65535: 'application';
  end case;
end function;

end unit;
