// [Documentation](README.md)

program GenericTree;

uses System.Console as Console;
uses Trees as Model;

begin
  const Input: Model.Tree of int := Model.Tree.Branch(
    Model.Tree.Leaf(21), Model.Tree.Leaf(34)
  );

  const Text: Model.Tree of string := Model.Map(
    Input,
    function(Value: int): string => Value.ToString()
  );

  const Result: Model.Summary of string := new Model.Summary of string(
    Model.Render(Text),
    Model.Count(Text)
  );
  const Updated: Model.Summary of string := Result with
    Label := 'leaves';
  end with;

  Console.WriteLine(Updated.Reader()());
  Console.WriteLine(Updated.Label + ': ' + Updated.Count.ToString());
  Console.WriteLine(Input = Model.Tree.Branch(Model.Tree.Leaf(21), Model.Tree.Leaf(34)));
end;

end program;
