// [Documentation](README.md#background-progress)

unit DesktopCommands.Background;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Ui.Mvu.Application as Mvu;

uses DesktopCommands.State as S;
uses System as Sys;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

// Stable identity shared by start and cancel.
public const Id: string := 'desktop-background';

// Runs a small simulated job and reports progress at each timer tick.
// ## Parameters
// - `SimulateError`: Whether to fail after two successful steps.
// ## Returns
// A cancellable background command whose replies update the application model.
public function Start(SimulateError: bool): Mvu.Command of S.Msg;
  async function Run(Context: Mvu.BackgroundContext of S.Msg; Token: Threads.CancellationToken): Tasks.Task of Fx.Outcome of (Fx.Completion, S.Msg);
  begin
    for Completed: int := 1 to S.WorkSteps do
      await Tasks.Task.Delay(
        Sys.TimeSpan.FromMilliseconds(250),
        Context.Clock,
        Token
      ).ConfigureAwait(false);
      if SimulateError and Completed = 3 then
        return Fx.Outcome.Failure(
          S.Msg.WorkFailed(new Sys.InvalidOperationException('Simulated background error.'))
        );
      end if;

      await Context.Post(S.Msg.WorkTick(Completed)).ConfigureAwait(false);
    end for;

    return Fx.Outcome.Success(Fx.Completion.Done);
  end function;
begin
  return Mvu.StartBackground of S.Msg(
    Id,
    Fx.Effect of (Fx.Completion, S.Msg, Mvu.BackgroundContext of S.Msg).Defer(Run)
  );
end function;

end unit;
