// [Documentation](README.md#background-progress)

unit DesktopCommands.Background;

uses
  DesktopCommands.State as S, Fpas.Ui.Mvu.Application as Mvu,
  System as Sys, System.Threading as Threads, System.Threading.Tasks as Tasks;

// Stable identity shared by start and cancel.
public const Id: string := 'desktop-background';

// Runs a small simulated job and reports progress at each timer tick.
// ## Parameters
// - `SimulateError`: Whether to fail after two successful steps.
// ## Returns
// A cancellable background command whose replies update the application model.
public function Start(SimulateError: bool): Mvu.Command<S.Msg>;
  async function Run(Post: function(S.Msg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
  begin
    for Completed: int := 1 to S.WorkSteps do
      await Tasks.Task.Delay(250, Token).ConfigureAwait(false);
      if SimulateError and Completed = 3 then
        raise new Sys.InvalidOperationException('Simulated background error.');
      end if;

      await Post(S.Msg.WorkTick(Completed)).ConfigureAwait(false);
    end for;
  end function;
begin
  return Mvu.StartBackground<S.Msg>(Id, Run, S.Msg.WorkFailed);
end function;

end unit;
