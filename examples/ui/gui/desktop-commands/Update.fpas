// [Documentation](README.md)

unit DesktopCommands.Update;

uses DesktopCommands.Background as Background;
uses DesktopCommands.Preferences as Preferences;
uses DesktopCommands.State as S;
uses Fpas.Execution.Effects as Fx;
uses Fpas.Ui.Gui.Closing as Closing;
uses Fpas.Ui.Gui.FileDialogs as Files;
uses Fpas.Ui.Gui.Frames as Frames;
uses Fpas.Ui.Gui.Windows as Windows;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Widgets.Theming.ThemeSwitchers as Switchers;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;
uses System as Sys;
uses System.IO as IO;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

// Stable ID for the single in-flight settings save.
public const SaveEffect: string := 'save-settings';

function SaveSettings(Model: S.Model): Mvu.Transition<S.Model, S.Msg>;
  async function Write(Value: Preferences.Settings; Token: Threads.CancellationToken): Tasks.Task<Fx.Outcome<Preferences.Settings, Sys.Exception>>;
  begin
    Token.ThrowIfCancellationRequested();
    try
      Preferences.Save(Model.SettingsPath, Value);
      return Fx.Outcome.Success(Value);
    catch Error: Sys.Exception when Error is IO.IOException or Error is
      Sys.UnauthorizedAccessException do
      return Fx.Outcome.Failure(Error);
    end try;
  end function;
begin
  if Model.Saving then
    return new Mvu.Transition<S.Model, S.Msg>(Model, []);
  end if;

  return new Mvu.Transition<S.Model, S.Msg>(
    Model with
      Saving := true;
      SaveStatus := 'Saving settings…';
    end with,
    [
      Mvu.StartBackground<S.Msg>(
        SaveEffect,
        Mvu.FromEffect<Preferences.Settings, Sys.Exception, Preferences.Settings, S.Msg>(
          Fx.Effect<Preferences.Settings, Sys.Exception, Preferences.Settings>.Defer(Write),
          function(_Context: Mvu.BackgroundContext<S.Msg>): Preferences.Settings => Model.Settings,
          S.Msg.SettingsSaved, S.Msg.SettingsSaveFailed
        )
      )
    ]
  );
end function;

function ChangeSettings(Model: S.Model; Value: Preferences.Settings): Mvu.Transition<S.Model, S.Msg>;
begin
  return new Mvu.Transition<S.Model, S.Msg>(
    Model with
      Settings := Value;
      SaveStatus := if Model.Saving then
        Model.SaveStatus
      else
        ''
      end if;
    end with, []
  );
end function;

// Updates the desktop model and issues native or background commands.
// ## Parameters
// - `Model`: Current desktop application state.
// - `Message`: Native input, application proposal or worker reply.
// ## Returns
// The next model and commands to apply between frames.
public function Apply(Model: S.Model; Message: S.Msg): Mvu.Transition<S.Model, S.Msg>;
begin
  return case Message of
    when S.Msg.Open: new Mvu.Transition<S.Model, S.Msg>(
      Model,
      [
        Files.OpenFile<S.Msg>(
          S.Msg.Selected,
          'Open text file',
          'Text',
          'txt',
          function(): S.Msg => S.Msg.Cancelled
        )
      ]
    );
    when S.Msg.Save: new Mvu.Transition<S.Model, S.Msg>(
      Model,
      [
        Files.SaveFile<S.Msg>(
          S.Msg.Selected,
          'notes.txt',
          'Choose save destination',
          'Text',
          'txt',
          function(): S.Msg => S.Msg.Cancelled
        )
      ]
    );
    when S.Msg.Folder: new Mvu.Transition<S.Model, S.Msg>(
      Model,
      [
        Files.ChooseFolder<S.Msg>(
          S.Msg.Selected,
          'Choose directory',
          function(): S.Msg => S.Msg.Cancelled
        )
      ]
    );
    when S.Msg.Selected(const Path: string): new Mvu.Transition<S.Model, S.Msg>(
      Model with
        Selection := Path;
      end with, [Windows.SetTitle<S.Msg>(Path)]
    );
    when S.Msg.Cancelled: new Mvu.Transition<S.Model, S.Msg>(
      Model with
        Selection := 'No selection.';
      end with, []
    );
    when S.Msg.CloseRequested: new Mvu.Transition<S.Model, S.Msg>(
      Model with
        Closing := true;
      end with, []
    );
    when S.Msg.Stay: new Mvu.Transition<S.Model, S.Msg>(
      Model with
        Closing := false;
      end with, [Closing.Cancel<S.Msg>()]
    );
    when S.Msg.Quit: new Mvu.Transition<S.Model, S.Msg>(
      Model, if Model.Saving then
        []
      else
        [Mvu.Exit<S.Msg>()]
      end if
    );
    when S.Msg.Redraw: new Mvu.Transition<S.Model, S.Msg>(Model, [Frames.Redraw<S.Msg>(0.5F)]);
    when S.Msg.SetAppearance(const Value: Switchers.Selection): ChangeSettings(
      Model,
      Model.Settings with
        Appearance := Value;
      end with
    );
    when S.Msg.SetAccent(const Value: Themes.Accent): ChangeSettings(
      Model,
      Model.Settings with
        Accent := Value;
      end with
    );
    when S.Msg.ResizeSplit(const Ratio: float): ChangeSettings(
      Model,
      Model.Settings with
        Ratio := Ratio;
      end with
    );
    when S.Msg.SaveSettings: SaveSettings(Model);
    when S.Msg.SettingsSaved(const Value: Preferences.Settings): new Mvu.Transition<S.Model, S.Msg>(
      Model with
        Saving := false;
        SaveStatus := if Value.Appearance = Model.Settings.Appearance
          and Value.Accent = Model.Settings.Accent and Value.Ratio = Model.Settings.Ratio
        then
          'Settings saved.'
        else
          'Settings saved. Newer changes are unsaved.'
        end if;
      end with, []
    );
    when S.Msg.SettingsSaveFailed(const Error: Sys.Exception): new Mvu.Transition<S.Model, S.Msg>(
      Model with
        Saving := false;
        SaveStatus := 'Could not save settings. ' + Error.Message;
      end with, []
    );
    when S.Msg.StartWork(const SimulateError: bool): if Model.WorkRunning then
        new Mvu.Transition<S.Model, S.Msg>(Model, [])
      else
        new Mvu.Transition<S.Model, S.Msg>(
          Model with
            WorkRunning := true;
            WorkProgress := 0;
            WorkStatus := 'Running…';
          end with, [Background.Start(SimulateError)]
        )
      end if;
    when S.Msg.CancelWork: if Model.WorkRunning then
        new Mvu.Transition<S.Model, S.Msg>(
          Model with
            WorkRunning := false;
            WorkStatus := 'Cancelled';
          end with, [Mvu.CancelBackground<S.Msg>(Background.Id)]
        )
      else
        new Mvu.Transition<S.Model, S.Msg>(Model, [])
      end if;
    when S.Msg.WorkTick(const Completed: int): new Mvu.Transition<S.Model, S.Msg>(
      Model with
        WorkProgress := Completed;
        WorkRunning := Completed < S.WorkSteps;
        WorkStatus := if Completed = S.WorkSteps then
          'Completed'
        else
          Model.WorkStatus
        end if;
      end with, []
    );
    when S.Msg.WorkFailed(const Error: Sys.Exception): new Mvu.Transition<S.Model, S.Msg>(
      Model with
        WorkRunning := false;
        WorkStatus := Error.Message;
      end with, []
    );
  end case;
end function;

end unit;
