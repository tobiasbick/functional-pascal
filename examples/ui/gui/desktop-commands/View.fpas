// [Documentation](README.md)

unit DesktopCommands.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.Buttons as Buttons;
uses Fpas.Ui.Widgets.Desktop.SplitViews as Split;
uses Fpas.Ui.Widgets.Feedback.ProgressBars as Progress;
uses Fpas.Ui.Widgets.Inputs.Selects as Selects;
uses Fpas.Ui.Widgets.Theming.ThemeSwitchers as Switchers;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses DesktopCommands.State as S;
uses System as Sys;
uses System.Collections.Generic as C;

const Accents: array of Themes.Accent := Sys.Enum.GetValues of Themes.Accent();

function AccentItems(): array of Selects.Item;
begin
  const Items: C.List of Selects.Item := new C.List of Selects.Item();
  for Accent: Themes.Accent in Accents do
    Items.Add(new Selects.Item(Sys.Enum.GetName of Themes.Accent(Accent) ?? ''));
  end for;

  return Items.ToArray();
end function;

const AccentChoices: array of Selects.Item := AccentItems();

// Resolves the loaded appearance and accent before each frame.
// ## Parameters
// - `Model`: Current desktop preferences.
// - `SystemAppearance`: The native appearance when the platform reports it.
// ## Returns
// The concrete palette for the native host.
public function ThemeFor(Model: S.Model; SystemAppearance: Themes.Mode?): Themes.Theme;
begin
  return if Switchers.Resolve(Model.Settings.Appearance, SystemAppearance ?? Themes.Mode.Light) =
    Themes.Mode.Dark
  then
    Themes.Dark(Model.Settings.Accent)
  else
    Themes.Light(Model.Settings.Accent)
  end if;
end function;

function ConfirmClose(Model: S.Model): E.Element of S.Msg;
begin
  return E.Column of S.Msg(
    new L.Flow(Gap := L.Spacing.Normal),
    E.Text of S.Msg('Close this window?'),
    E.Row of S.Msg(
      new L.Flow(Gap := L.Spacing.Normal, Wrap := true),
      Buttons.Button of S.Msg('stay', 'Keep open', S.Msg.Stay),
      Buttons.Button of S.Msg(
        'quit',
        'Close',
        S.Msg.Quit,
        new Buttons.Options(Enabled := not Model.Saving)
      )
    )
  );
end function;

function BackgroundControls(Model: S.Model): E.Element of S.Msg;
begin
  const StartOptions: Buttons.Options := new Buttons.Options(
    ControlSize := Buttons.Size.Small, Enabled := not Model.WorkRunning
  );
  return E.Column of S.Msg(
    new L.Flow(Gap := L.Spacing.Normal),
    Progress.ProgressBar of S.Msg(
      'background-progress', cast<float>(Model.WorkProgress) / cast<float>(S.WorkSteps),
      new Progress.Options(Label := 'Background progress', ShowValue := true)
    ),
    E.Text of S.Msg(Model.WorkStatus),
    E.Row of S.Msg(
      new L.Flow(Gap := L.Spacing.Normal, Wrap := true),
      Buttons.Button of S.Msg('start-work', 'Start', S.Msg.StartWork(false), StartOptions),
      Buttons.Button of S.Msg(
        'cancel-work', 'Cancel', S.Msg.CancelWork, new Buttons.Options(
          ControlSize := Buttons.Size.Small, Enabled := Model.WorkRunning
        )
      ),
      Buttons.Button of S.Msg('fail-work', 'Simulate error', S.Msg.StartWork(true), StartOptions)
    )
  );
end function;

// Builds the settings controls, native dialogs, progress and close confirmation.
// ## Parameters
// - `Model`: Current desktop application state.
// - `Viewport`: Current logical viewport.
// - `Theme`: Resolved palette for the panes.
// ## Returns
// The native CUI view.
public function Build(Model: S.Model; Viewport: L.Viewport; Theme: Themes.Theme): E.Element of S.Msg;
begin
  return E.Column of S.Msg(
    new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Normal),
    E.Text of S.Msg('Native desktop commands'),
    E.Row of S.Msg(
      new L.Flow(Gap := L.Spacing.Normal, Wrap := true),
      Switchers.ThemeSwitcher of S.Msg(
        'appearance',
        Model.Settings.Appearance,
        S.Msg.SetAppearance,
        new Switchers.Options(WithSystem := true)
      ),
      Selects.Select of S.Msg(
        'accent', AccentChoices, Sys.Array.IndexOf of Themes.Accent(Accents, Model.Settings.Accent),
        function(Index: int): S.Msg => S.Msg.SetAccent(Accents[Index])
      ),
      Buttons.Button of S.Msg(
        'save-settings',
        'Save settings',
        S.Msg.SaveSettings,
        new Buttons.Options(Enabled := not Model.Saving)
      )
    ),
    E.Text of S.Msg(Model.SaveStatus),
    Split.SplitView of S.Msg(
      'desktop-split', Model.Settings.Ratio,
      E.Column of S.Msg(
        new L.Flow(
          Padding := L.Spacing.Normal,
          Gap := L.Spacing.Normal,
          Background := Theme.Colors.SurfaceMuted
        ),
        Buttons.Button of S.Msg('open', 'Open file', S.Msg.Open),
        Buttons.Button of S.Msg('save', 'Save destination', S.Msg.Save),
        Buttons.Button of S.Msg('folder', 'Choose folder', S.Msg.Folder),
        Buttons.Button of S.Msg('redraw', 'Request native repaint', S.Msg.Redraw)
      ),
      E.Column of S.Msg(
        new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Normal),
        E.Text of S.Msg(Model.Selection),
        if Model.Closing then
          ConfirmClose(Model)
        else
          BackgroundControls(Model)
        end if
      ),
      S.Msg.ResizeSplit, new Split.Options(MinimumFirst := 184.0F, MinimumSecond := 160.0F)
    )
  );
end function;

end unit;
