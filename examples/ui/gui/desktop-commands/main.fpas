// [Documentation](README.md)

program DesktopCommandsExample;

uses
  DesktopCommands.State as S, DesktopCommands.Update as Update,
  DesktopCommands.View as View, DesktopCommands.Preferences as Preferences,
  Fpas.Ui.Gui.Desktop as Gui;

begin
  Gui.RunThemed<S.Model, S.Msg>(
    S.Initialize(Preferences.DefaultPath()), Update.Apply, View.Build,
    new Gui.Options(
      Title := 'Native desktop commands', Width := 720, Height := 420,
      MinimumWidth := 480, MinimumHeight := 340, AppId := 'org.example.DesktopCommands'
    ),
    View.ThemeFor,
    OnCloseRequested := function(): S.Msg => S.Msg.CloseRequested
  );
end;

end program;
