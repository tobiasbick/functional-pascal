program DesktopCommandsExample;

uses
  DesktopCommands.State as S, DesktopCommands.Update as Update,
  DesktopCommands.View as View, Fpas.Ui.Gui.Application as Gui;

begin
  Gui.Run<S.Model, S.Msg>(
    new S.Model(), Update.Apply, View.Build,
    new Gui.Options(
      Title := 'Native desktop commands', Width := 640, Height := 420,
      MinimumWidth := 420, MinimumHeight := 300, AppId := 'org.example.DesktopCommands'
    ),
    OnCloseRequested := function(): S.Msg => S.Msg.CloseRequested
  );
end;

end program;
