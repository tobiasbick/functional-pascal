// [Documentation](README.md)

unit EditorCommands.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.Buttons as Buttons;
uses Fpas.Ui.Widgets.Canvas.SelectionBars as Bulk;
uses Fpas.Ui.Widgets.Editors.CodeEditors as Editor;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;
uses Fpas.Ui.Widgets.Overlays.Tours as Tours;
uses Fpas.Ui.Widgets.Overlays.UserMenus as Users;

uses EditorCommands.State as S;
uses System as Sys;

// Composes native widgets with model-owned editor commands and optional presentation settings.
// ## Parameters
// - `Model`: Retained application state.
// - `Viewport`: Current logical viewport.
// ## Returns
// The native CUI view and optional guided tour.
public function Build(Model: S.Model; Viewport: L.Viewport): E.Element of S.Msg;
begin
  const Emoji: int := Model.Text.IndexOf('😀', Sys.StringComparison.Ordinal);
  const Marks: array of Editor.Mark := if Emoji < 0 then
    []
  else
    [new Editor.Mark(Emoji, Emoji + 2)]
  end if;
  const Base: E.Element of S.Msg := E.Column of S.Msg(
    new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Normal),
    E.Row of S.Msg(
      new L.Flow(Gap := L.Spacing.Normal),
      Users.UserMenu of S.Msg(
        'account', 'Example account',
        [
          (Menus.Entry of S.Msg).Action(
            new Menus.Item of S.Msg('profile', 'Profile', S.Msg.Account)
          )
        ],
        new Users.Options(
          Detail := 'Native avatar and account menu',
          AvatarPath := Model.AvatarPath
        )
      ),
      Buttons.Button of S.Msg('tour', 'Take the tour (F1)', S.Msg.StartTour)
    ),
    E.Row of S.Msg(
      new L.Flow(Gap := L.Spacing.Normal),
      Buttons.Button of S.Msg('find', 'Find emoji', S.Msg.Search),
      Buttons.Button of S.Msg('goto', 'Go to line 2', S.Msg.GoTo),
      Buttons.Button of S.Msg('select', 'Select all', S.Msg.SelectAll)
    ),
    Bulk.SelectionBar of S.Msg(
      'bulk', Bulk.Selection.Count(Model.Count), [new Bulk.Action('', 'Clear')], S.Msg.Bulk,
      Editor.CodeEditor of S.Msg(
        'editor', Model.Text, S.Msg.Edited,
        new Editor.Options(Height := 280.0F, Marks := Marks)
      ),
      new Bulk.Options(CountFormat := '%d chosen')
    ),
    E.Size of S.Msg(
      E.Text of S.Msg(''),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(56)))
    ),
    E.Text of S.Msg(
      'UTF-16 caret ' + Model.Editor.Cursor.ToString() + ', anchor ' +
      Model.Editor.Anchor.ToString() +
      ', find matches ' + Model.Editor.Matches.ToString()
    ),
    E.Text of S.Msg(Model.Notice)
  );
  return Tours.Tour of S.Msg(
    'guide', Base,
    [
      new Tours.Step(
        Target := 'find',
        Title := 'Native find',
        Body := 'The button requests the native find bar.'
      ),
      new Tours.Step(
        Target := 'editor',
        Title := 'Native editing',
        Body := 'Select, find and go-to use CUI. Marks use UTF-16 scalar boundaries.'
      )
    ],
    Model.Tour, S.Msg.TourChanged,
    new Tours.Options(
      NextLabel := 'Continue',
      BackLabel := 'Previous',
      DoneLabel := 'Finish',
      CountFormat := 'Step %d / %d'
    )
  );
end function;

end unit;
