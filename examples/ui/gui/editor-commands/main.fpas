// [Documentation](README.md)

program EditorCommandsExample;

uses Fpas.Ui.Gui.Desktop as Gui;

uses EditorCommands.State as S;
uses EditorCommands.Update as Update;
uses EditorCommands.View as View;
uses System as Sys;

begin
  const Args: array of string := Sys.Environment.GetCommandLineArgs();
  Gui.Run<S.Model, S.Msg>(
    new S.Model(
      AvatarPath := if Args.Length > 1 then
        Args[1]
      else
        null
      end if
    ),
    Update.Apply,
    View.Build,
    new Gui.Options(Title := 'Native editor commands', Width := 760, Height := 580),
    BindingsFor := Update.Bindings
  );
end;

end program;
