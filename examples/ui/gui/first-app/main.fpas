// [Documentation](../../../../docs/ui/gui/README.md#first-window)

program FirstGuiApp;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Desktop as Gui;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as App;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;

type Msg = variant
  Increment;
  Close;
end variant;

function Update(Count: int; Message: Msg): App.Transition of (int, Msg);
begin
  return case Message of
    when Msg.Increment: new App.Transition of (int, Msg)(Count + 1, []);
    when Msg.Close: new App.Transition of (int, Msg)(Count, [App.Exit of Msg()]);
  end case;
end function;

function View(Count: int; Viewport: L.Viewport): E.Element of Msg;
begin
  return E.Column of Msg(
    new L.Flow(Padding := L.Spacing.Loose, Gap := L.Spacing.Normal),
    E.Text of Msg('Count: ' + Count.ToString()),
    B.Button of Msg(
      'increment', 'Add one', Msg.Increment,
      new B.Options(Variant := S.ButtonVariant.Primary)
    ),
    B.Button of Msg('close', 'Close', Msg.Close)
  );
end function;

begin
  Gui.Run of (int, Msg)(
    0,
    Update,
    View,
    new Gui.Options(Title := 'Counter', Width := 420, Height := 300)
  );
end;

end program;
