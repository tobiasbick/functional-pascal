program FirstGuiApp;

uses
  Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Mvu.Application as App,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Actions.Buttons as B,
  Fpas.Ui.Styles as S;

type Msg = variant
  Increment;
  Close;
end variant;

function Update(Count: int; Message: Msg): App.Transition<int, Msg>;
begin
  return case Message of
    when Msg.Increment: new App.Transition<int, Msg>(Count + 1, []);
    when Msg.Close: new App.Transition<int, Msg>(Count, [App.Exit<Msg>()]);
  end case;
end function;

function View(Count: int; Viewport: L.Viewport): E.Element<Msg>;
begin
  return E.Column<Msg>(
    new L.Flow(Padding := L.Spacing.Loose, Gap := L.Spacing.Normal),
    E.Text<Msg>('Count: ' + Count.ToString()),
    B.Button<Msg>(
      'increment', 'Add one', Msg.Increment,
      new B.Options(Variant := S.ButtonVariant.Primary)
    ),
    B.Button<Msg>('close', 'Close', Msg.Close)
  );
end function;

begin
  Gui.Run<int, Msg>(
    0,
    Update,
    View,
    new Gui.Options(Title := 'Counter', Width := 420, Height := 300)
  );
end;

end program;
