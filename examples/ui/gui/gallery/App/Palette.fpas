// [Documentation](../../../../../docs/ui/gui/overlays/command-palette.md)

unit GuiGallery.App.Palette;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Shortcuts as Shortcuts;
uses Fpas.Ui.Widgets.Inputs.ShortcutRecorders as Keys;
uses Fpas.Ui.Widgets.Overlays.CommandPalettes as P;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.App.State as G;
uses GuiGallery.Pages.Overlays.State as O;
uses GuiGallery.Shared.State as S;
uses System as Sys;

function Command(
  Title: string;
  Message: G.Msg;
  Icon: int;
  Group: string;
  Shortcut: string := ''
): P.Command of G.Msg;
begin
  return new P.Command of G.Msg(Title, Message, Sys.Char.ConvertFromUtf32(Icon), Group, Shortcut);
end function;

// Selects the gallery's theme shortcut. Native editors keep keyboard ownership.
// ## Parameters
// - `Model`: Current gallery state.
// ## Returns
// The primary modifier plus J binding used by the gallery.
public function Bindings(Model: G.Model): array of Shortcuts.Binding of G.Msg;
begin
  return [
    new Shortcuts.Binding of G.Msg(
      new Keys.Combination(Keys.Key.J, Keys.PrimaryModifier()),
      G.Msg.Shared(S.Msg.ToggleAppearance)
    )
  ];
end function;

// Presents the original searchable gallery commands.
// ## Parameters
// - `Open`: Current palette visibility.
// - `Base`: The gallery below the modal.
// ## Returns
// The gallery with its command palette.
public function Wrap(Open: bool; Base: E.Element of G.Msg): E.Element of G.Msg;
begin
  return P.CommandPalette of G.Msg(
    'gallery-palette', Base, Open, [
      Command(
        Strings.Get('Palette.Overview'),
        G.Msg.Jump(G.Page.Overview),
        $E1C1,
        Strings.Get('Page.Navigation')
      ),
      Command(
        Strings.Get('Palette.Buttons'),
        G.Msg.Jump(G.Page.Buttons),
        $E1B4,
        Strings.Get('Page.Navigation')
      ),
      Command(
        Strings.Get('Palette.Inputs'),
        G.Msg.Jump(G.Page.Inputs),
        $E198,
        Strings.Get('Page.Navigation')
      ),
      Command(
        Strings.Get('Palette.Charts'),
        G.Msg.Jump(G.Page.Charts),
        $E2A5,
        Strings.Get('Page.Navigation')
      ),
      Command(
        Strings.Get('Palette.ToggleDark'),
        G.Msg.Shared(S.Msg.ToggleAppearance),
        $E11E,
        Strings.Get('Palette.Preferences'),
        'Ctrl J'
      ),
      Command(
        Strings.Get('Palette.ChangeAccent'),
        G.Msg.Shared(S.Msg.NextAccent),
        $E1DD,
        Strings.Get('Palette.Preferences')
      ),
      Command(
        Strings.Get('Text.NewProject'),
        G.Msg.Jump(G.Page.Feedback),
        $E13D,
        Strings.Get('Page.Actions'),
        'Ctrl N'
      ),
      Command(
        Strings.Get('Palette.InviteTeammate'),
        G.Msg.Overlays(O.Msg.SetProfileDialog(true)),
        $E1A2,
        Strings.Get('Page.Actions')
      ),
      Command(
        Strings.Get('Palette.OpenSettings'),
        G.Msg.Overlays(O.Msg.SetSheet(true)),
        $E154,
        Strings.Get('Page.Actions'),
        'Ctrl ,'
      )
    ], function(Visible: bool): G.Msg => G.Msg.Overlays(O.Msg.SetPalette(Visible))
  );
end function;

end unit;
