unit GuiGallery.App.State;

uses
  GuiGallery.Pages.Instruments.State as Instruments,
  GuiGallery.Pages.Motion.State as Motion,
  GuiGallery.Pages.Creative.State as Creative,
  GuiGallery.Pages.Files.State as Files,
  GuiGallery.Pages.Planning.State as Planning,
  GuiGallery.Pages.DataGrid.State as Grid,
  GuiGallery.Pages.MoreCharts.State as MoreCharts,
  GuiGallery.Pages.MoreCharts.Data as MoreChartsData,
  GuiGallery.Pages.Charts.State as Charts,
  GuiGallery.Pages.Overview.State as Overview,
  GuiGallery.Pages.Buttons.State as Buttons,
  GuiGallery.Pages.Inputs.State as Inputs,
  GuiGallery.Pages.Selection.State as Selection,
  GuiGallery.Pages.Navigation.State as Navigation,
  GuiGallery.Pages.Lists.State as Lists,
  GuiGallery.Pages.Overlays.State as Overlays,
  GuiGallery.Pages.Actions.State as Actions,
  GuiGallery.Pages.Capture.State as Capture,
  GuiGallery.Pages.Audio.State as Audio,
  GuiGallery.Pages.Pickers.State as Pickers,
  GuiGallery.Pages.SmartInputs.State as SmartInputs,
  GuiGallery.Pages.Disclosure.State as Disclosure,
  GuiGallery.Shared.State as Demo;

// Pages from the CUI gallery with accepted FPAS previews.
public type Page = enum: byte
  // Gallery introduction.
  Overview;
  // Buttons and their related actions.
  Buttons;
  // Native text fields and their validation state.
  Inputs;
  // Native selection controls and sliders.
  Selection;
  // Native tabs, breadcrumb, pagination and stepper.
  Navigation;
  // Accepted native list components, starting with the accordion.
  Lists;
  // The sheet, popover, context menu and native toasts.
  Overlays;
  // Related actions from the extended gallery.
  Actions;
  // Native text-field affixes from the extended gallery.
  SmartInputs;
  // Native disclosure examples.
  Disclosure;
  // Native alerts, progress and activity indicators.
  Feedback;
  // The extended selection pickers.
  Pickers;
  // Synth and mixer controls.
  Audio;
  // File drop, avatar upload and signature examples.
  Capture;
  // Anchored sections and the native table of contents.
  Reader;
  // Supplementary native layout primitives absent from the upstream pages.
  Layout;
  // Native chart examples.
  Charts;
  // Accepted extended visualizations.
  MoreCharts;
  // Filter bar, editable data grid and tree tables.
  DataGrid;
  // Original syntax highlighting and JSON examples.
  Code;
  // Original caffeine readouts and chart controls.
  Instruments;
  // Motion effects and compact controls.
  Motion;
  // Creative controls and color settings.
  CreativeControls;
  // File browser and pickers.
  Files;
  // Project board and scheduling.
  Planning;
end enum;

// Application state with one owner per feature.
public type Model = record
  // Active gallery page.
  public Active: Page := Page.Overview;
  // New viewport identity for every navigation selection, including the active page.
  public NavigationRevision: int := 0;
  // Visibility of the compact navigation drawer.
  public Drawer: bool := false;
  // Demo values shared by several pages.
  public Shared: Demo.Model := new Demo.Model();
  // State owned by the Overview workspace form.
  public Overview: Overview.Model := new Overview.Model();
  // State owned by the Buttons page.
  public Buttons: Buttons.Model := new Buttons.Model();
  // State owned by the Inputs page.
  public Inputs: Inputs.Model := new Inputs.Model();
  // State owned by the Selection page.
  public Selection: Selection.Model := new Selection.Model();
  // State owned by the Navigation page.
  public Navigation: Navigation.Model := new Navigation.Model();
  // State owned by the Lists page.
  public Lists: Lists.Model := new Lists.Model();
  // State owned by the Overlays page.
  public Overlays: Overlays.Model := new Overlays.Model();
  // State owned by the Actions page.
  public Actions: Actions.Model := new Actions.Model();
  // State owned by the extended Pickers page.
  public Pickers: Pickers.Model := new Pickers.Model();
  // State owned by the SmartInputs page.
  public SmartInputs: SmartInputs.Model := new SmartInputs.Model();
  // State owned by the Disclosure page.
  public Disclosure: Disclosure.Model := new Disclosure.Model();
  // State owned by the Audio page.
  public Audio: Audio.Model := new Audio.Model();
  // State owned by the Capture page.
  public Capture: Capture.Model := new Capture.Model();
  // State owned by the Charts page.
  public Charts: Charts.Model := new Charts.Model();
  // Deterministic data for the native More charts examples.
  public MoreCharts: MoreChartsData.Samples := MoreChartsData.Create();
  // State owned by the data grid page.
  public DataGrid: Grid.Model := new Grid.Model();
  // State owned by the Instruments page.
  public Instruments: Instruments.Model := new Instruments.Model();
  // State owned by the Motion page.
  public Motion: Motion.Model := new Motion.Model();
  // State owned by the Creative controls page.
  public Creative: Creative.Model := new Creative.Model();
  // State owned by Files.
  public Files: Files.Model := new Files.Model();
  // State owned by Planning.
  public Planning: Planning.Model := new Planning.Model();
end record;

// Application navigation and typed child messages.
public type Msg = variant
  // Route an input proposal to Instruments.
  Instruments(Value: Instruments.Msg);
  // Route an input proposal to Motion.
  Motion(Value: Motion.Msg);
  // Route a proposal to Creative controls.
  Creative(Value: Creative.Msg);
  // Routes file navigation and selection.
  Files(Value: Files.Msg);
  // Routes board and calendar changes.
  Planning(Value: Planning.Msg);
  // Route an input proposal to the data grid page.
  DataGrid(Value: Grid.Msg);
  // Navigate to an accepted page.
  Show(Value: Page);
  // Open or close the navigation drawer.
  SetDrawer(Open: bool);
  // A harmless application activation.
  Preview;
  // Change values with a shared owner.
  Shared(Value: Demo.Msg);
  // Route an action to the Overview slice.
  Overview(Value: Overview.Msg);
  // Route an action to the Buttons slice.
  Buttons(Value: Buttons.Msg);
  // Route an action to the Inputs slice.
  Inputs(Value: Inputs.Msg);
  // Route an action to the Selection slice.
  Selection(Value: Selection.Msg);
  // Route an action to the Navigation slice.
  Navigation(Value: Navigation.Msg);
  // Route an action to the Lists slice.
  Lists(Value: Lists.Msg);
  // Route an action to the Overlays slice.
  Overlays(Value: Overlays.Msg);
  // Route an action to the Actions slice.
  Actions(Value: Actions.Msg);
  // Route an action to the Pickers slice.
  Pickers(Value: Pickers.Msg);
  // Route an action to the SmartInputs slice.
  SmartInputs(Value: SmartInputs.Msg);
  // Route an action to the Disclosure slice.
  Disclosure(Value: Disclosure.Msg);
  // Route an action to the Audio slice.
  Audio(Value: Audio.Msg);
  // Route an action to the Capture slice.
  Capture(Value: Capture.Msg);
  // Route an action to the More charts slice.
  MoreCharts(Value: MoreCharts.Msg);
  // Route an action to the Charts slice.
  Charts(Value: Charts.Msg);
end variant;

end unit;
