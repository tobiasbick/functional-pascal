unit GuiGallery.App.Update;

uses
  GuiGallery.Pages.Desktop.State as Desktop, GuiGallery.Pages.Desktop.Update as DesktopUpdate,
  GuiGallery.Pages.EditingTools.State as Editing, GuiGallery.Pages.EditingTools.Update as EditUpdate,
  Fpas.Ui.Gui.Toasts as Toasts, Fpas.Ui.Terminals as TerminalWidget,
  GuiGallery.Pages.Code.State as CodePage, GuiGallery.Pages.Code.Update as CodeUpdate,
  GuiGallery.Pages.Ai.State as Ai, GuiGallery.Pages.Ai.Update as AiUpdate,
  GuiGallery.Pages.Voice.State as Voice, GuiGallery.Pages.Voice.Update as VoiceUpdate,
  GuiGallery.Pages.Feedback.State as Feedback, GuiGallery.Pages.Feedback.Update as FeedbackUpdate,
  GuiGallery.Pages.Social.State as Social, GuiGallery.Pages.Social.Update as SocialUpdate,
  GuiGallery.Pages.Instruments.State as Instruments,
  GuiGallery.Pages.Motion.State as Motion,
  GuiGallery.Pages.Motion.Update as MotionUpdate,
  GuiGallery.Pages.Motion.Clock as MotionClock,
  GuiGallery.Pages.Creative.State as Creative,
  GuiGallery.Pages.Creative.Update as CreativeUpdate,
  GuiGallery.Pages.Canvas.State as Canvas, GuiGallery.Pages.Canvas.Update as CanvasUpdate,
  GuiGallery.Pages.Files.State as Files,
  GuiGallery.Pages.Developer.State as Developer, GuiGallery.Pages.Developer.Update as DeveloperUpdate,
  GuiGallery.Pages.MoreDeveloper.State as MoreDeveloper, GuiGallery.Pages.MoreDeveloper.Update as MoreDeveloperUpdate,
  GuiGallery.Pages.Files.Update as FileUpdate,
  GuiGallery.Pages.Planning.State as Planning,
  GuiGallery.Pages.Planning.Update as PlanningUpdate,
  GuiGallery.Pages.Instruments.Update as InstrumentsUpdate,
  GuiGallery.Pages.DataGrid.State as Grid,
  GuiGallery.Pages.DataGrid.Update as GridUpdate,
  GuiGallery.Pages.MoreCharts.Data as MoreChartsData,
  GuiGallery.Pages.MoreCharts.State as MoreCharts,
  GuiGallery.Pages.MoreCharts.Update as MoreChartsUpdate,
  GuiGallery.Pages.Charts.State as Charts,
  GuiGallery.Pages.Charts.Update as ChartsUpdate,
  GuiGallery.Pages.Overview.State as Overview,
  GuiGallery.Pages.Overview.Update as OverviewUpdate,
  GuiGallery.Pages.Buttons.State as Buttons,
  GuiGallery.Pages.Inputs.State as Inputs,
  GuiGallery.Pages.Selection.State as Selection,
  GuiGallery.Pages.Navigation.State as Navigation,
  GuiGallery.Pages.Lists.State as Lists,
  GuiGallery.Pages.Overlays.State as Overlays,
  GuiGallery.Pages.Actions.State as Actions,
  GuiGallery.Pages.Capture.State as Capture,
  GuiGallery.Pages.Capture.Update as CaptureUpdate,
  GuiGallery.Pages.Audio.State as Audio,
  GuiGallery.Pages.Audio.Update as AudioUpdate,
  GuiGallery.Pages.Audio.Clock as AudioClock,
  System as Sys,
  GuiGallery.Pages.Pickers.State as Pickers,
  GuiGallery.Pages.Pickers.Update as PickersUpdate,
  GuiGallery.Pages.SmartInputs.State as SmartInputs,
  GuiGallery.Pages.Disclosure.State as Disclosure,
  GuiGallery.Pages.Buttons.Update as ButtonsUpdate,
  GuiGallery.Pages.Inputs.Update as InputsUpdate,
  GuiGallery.Pages.Selection.Update as SelectionUpdate,
  GuiGallery.Pages.Navigation.Update as NavigationUpdate,
  GuiGallery.Pages.Lists.Update as ListsUpdate,
  GuiGallery.Pages.Overlays.Update as OverlaysUpdate,
  GuiGallery.Pages.Actions.Update as ActionsUpdate,
  GuiGallery.Pages.SmartInputs.Update as SmartInputsUpdate,
  GuiGallery.Pages.Disclosure.Clock as DisclosureClock,
  System.Collections.Generic as Collections,
  GuiGallery.Pages.Disclosure.Update as DisclosureUpdate,
  GuiGallery.App.State as G,
  GuiGallery.Shared.State as Demo,
  GuiGallery.Shared.Update as DemoUpdate,
  Fpas.Ui.Mvu.Application as Mvu,
  Fpas.Ui.Mvu.Composition as C,
  Fpas.Ui.ThemeSwitchers as Switchers,
  Fpas.Ui.Themes as Themes;

// Resolves the application theme from its shared appearance state.
// ## Parameters
// - `State`: Current application model.
// ## Returns
// The current CUI palette.
public function ThemeFor(State: G.Model): Themes.Theme;
begin
  return if Switchers.Resolve(
    State.Shared.Appearance,
    State.Shared.SystemAppearance
  ) = Themes.Mode.Dark
  then
    Themes.Dark(State.Shared.Accent)
  else
    Themes.Light(State.Shared.Accent)
  end if;
end function;

// Routes one message to its owner in the application's single MVU session.
// ## Parameters
// - `State`: Current application model.
// - `Message`: Navigation or a typed slice message.
// ## Returns
// Next application model and mapped commands.
public function Update(State: G.Model; Message: G.Msg): Mvu.Transition<G.Model, G.Msg>;
begin
  case Message of
    when G.Msg.Feedback(const Value: Feedback.Msg):
      const Child: Mvu.Transition<Feedback.Model, G.Msg> := C.MapTransition<Feedback.Model, Feedback.Msg, G.Msg>(
        FeedbackUpdate.Update(State.Feedback, Value), G.Msg.Feedback, 'feedback'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Feedback := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.AI(const Value: Ai.Msg):
      const Child: Mvu.Transition<Ai.Model, G.Msg> := C.MapTransition<Ai.Model, Ai.Msg, G.Msg>(
        AiUpdate.Update(State.AI, Value),
        G.Msg.AI,
        'ai'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          AI := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Voice(const Value: Voice.Msg):
      const Child: Mvu.Transition<Voice.Model, G.Msg> := C.MapTransition<Voice.Model, Voice.Msg, G.Msg>(
        VoiceUpdate.Update(State.Voice, Value),
        G.Msg.Voice,
        'voice'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Voice := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Social(const Value: Social.Msg):
      const Child: Mvu.Transition<Social.Model, G.Msg> := C.MapTransition<Social.Model, Social.Msg, G.Msg>(
        SocialUpdate.Update(State.Social, Value), G.Msg.Social, 'social'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Social := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Developer(const Value: Developer.Msg):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Developer := DeveloperUpdate.Update(State.Developer, Value);
        end with, []
      );
    when G.Msg.MoreDeveloper(const Value: MoreDeveloper.Msg):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          MoreDeveloper := MoreDeveloperUpdate.Update(State.MoreDeveloper, Value);
        end with, []
      );
    when G.Msg.Editing(const Value: Editing.Msg):
      const Child: Mvu.Transition<Editing.Model, G.Msg> := C.MapTransition<Editing.Model, Editing.Msg, G.Msg>(
        EditUpdate.Update(State.Editing, Value), G.Msg.Editing, 'editing'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Editing := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Code(const Value: CodePage.Msg):
      const Child: Mvu.Transition<CodePage.Model, G.Msg> := C.MapTransition<CodePage.Model, CodePage.Msg, G.Msg>(
        CodeUpdate.Update(State.Code, Value), G.Msg.Code, 'code'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Code := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Files(Files.Msg.Terminal(TerminalWidget.Event.Interrupt)):
      return new Mvu.Transition<G.Model, G.Msg>(State, [Toasts.Show<G.Msg>('Interrupted')]);
    when G.Msg.Files(const Value: Files.Msg):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Files := FileUpdate.Update(State.Files, Value);
        end with, []
      );
    when G.Msg.Planning(const Value: Planning.Msg):
      const Child: Mvu.Transition<Planning.Model, G.Msg> := C.MapTransition<Planning.Model, Planning.Msg, G.Msg>(
        PlanningUpdate.Update(State.Planning, Value), G.Msg.Planning, 'planning'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Planning := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Desktop(const Value: Desktop.Msg):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Desktop := DesktopUpdate.Update(State.Desktop, Value);
        end with, []
      );
    when G.Msg.Canvas(const Value: Canvas.Msg):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Canvas := CanvasUpdate.Update(State.Canvas, Value);
        end with, []
      );
    when G.Msg.Creative(const Value: Creative.Msg):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Creative := CreativeUpdate.Update(State.Creative, Value);
        end with, []
      );
    when G.Msg.Motion(const Value: Motion.Msg):
      const Child: Mvu.Transition<Motion.Model, G.Msg> := C.MapTransition<Motion.Model, Motion.Msg, G.Msg>(
        MotionUpdate.Update(State.Motion, Value), G.Msg.Motion, 'motion'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Motion := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Instruments(const Value: Instruments.Msg):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Instruments := InstrumentsUpdate.Update(State.Instruments, Value);
        end with, []
      );
    when G.Msg.DataGrid(const Value: Grid.Msg):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          DataGrid := GridUpdate.Update(State.DataGrid, Value);
        end with, []
      );
    when G.Msg.MoreCharts(const Value: MoreCharts.Msg):
      const Child: Mvu.Transition<MoreChartsData.Samples, G.Msg> := C.MapTransition<MoreChartsData.Samples, MoreCharts.Msg, G.Msg>(
        MoreChartsUpdate.Update(State.MoreCharts, Value), G.Msg.MoreCharts, 'more-charts'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          MoreCharts := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Charts(const Value: Charts.Msg):
      const Child: Mvu.Transition<Charts.Model, G.Msg> := C.MapTransition<Charts.Model, Charts.Msg, G.Msg>(
        ChartsUpdate.Update(State.Charts, Value), G.Msg.Charts, 'charts'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Charts := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Shared(const Value: Demo.Msg), G.Msg.Buttons(
      Buttons.Msg.Shared(const Value: Demo.Msg)
    ), G.Msg.Inputs(
      Inputs.Msg.Shared(const Value: Demo.Msg)
    ), G.Msg.Selection(
      Selection.Msg.Shared(const Value: Demo.Msg)
    ), G.Msg.Overlays(
      Overlays.Msg.Shared(const Value: Demo.Msg)
    ), G.Msg.Actions(
      Actions.Msg.Shared(const Value: Demo.Msg)
    ), G.Msg.Overview(Overview.Msg.Shared(const Value: Demo.Msg)):
      const Child: Mvu.Transition<Demo.Model, G.Msg> := C.MapTransition<Demo.Model, Demo.Msg, G.Msg>(
        DemoUpdate.Update(State.Shared, Value),
        G.Msg.Shared,
        'shared'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Shared := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Overview(const Value: Overview.Msg):
      const Child: Mvu.Transition<Overview.Model, G.Msg> := C.MapTransition<Overview.Model, Overview.Msg, G.Msg>(
        OverviewUpdate.Update(State.Overview, Value), G.Msg.Overview, 'overview'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Overview := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Buttons(Buttons.Msg.OpenDeleteDialog):
      return Update(State, G.Msg.Overlays(Overlays.Msg.SetDeleteDialog(true)));
    when G.Msg.Buttons(const Value: Buttons.Msg):
      const Child: Mvu.Transition<Buttons.Model, G.Msg> := C.MapTransition<Buttons.Model, Buttons.Msg, G.Msg>(
        ButtonsUpdate.Update(State.Buttons, Value),
        G.Msg.Buttons,
        'buttons'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Buttons := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Inputs(const Value: Inputs.Msg):
      const Child: Mvu.Transition<Inputs.Model, G.Msg> := C.MapTransition<Inputs.Model, Inputs.Msg, G.Msg>(
        InputsUpdate.Update(State.Inputs, Value),
        G.Msg.Inputs,
        'inputs'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Inputs := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Selection(const Value: Selection.Msg):
      const Child: Mvu.Transition<Selection.Model, G.Msg> := C.MapTransition<Selection.Model, Selection.Msg, G.Msg>(
        SelectionUpdate.Update(State.Selection, Value),
        G.Msg.Selection,
        'selection'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Selection := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Navigation(const Value: Navigation.Msg):
      const Child: Mvu.Transition<Navigation.Model, G.Msg> := C.MapTransition<Navigation.Model, Navigation.Msg, G.Msg>(
        NavigationUpdate.Update(State.Navigation, Value),
        G.Msg.Navigation,
        'navigation'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Navigation := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Lists(const Value: Lists.Msg):
      const Child: Mvu.Transition<Lists.Model, G.Msg> := C.MapTransition<Lists.Model, Lists.Msg, G.Msg>(
        ListsUpdate.Update(State.Lists, Value),
        G.Msg.Lists,
        'lists'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Lists := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Overlays(const Value: Overlays.Msg):
      const Child: Mvu.Transition<Overlays.Model, G.Msg> := C.MapTransition<Overlays.Model, Overlays.Msg, G.Msg>(
        OverlaysUpdate.Update(State.Overlays, Value),
        G.Msg.Overlays,
        'overlays'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Overlays := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Actions(const Value: Actions.Msg):
      const Child: Mvu.Transition<Actions.Model, G.Msg> := C.MapTransition<Actions.Model, Actions.Msg, G.Msg>(
        ActionsUpdate.Update(State.Actions, Value),
        G.Msg.Actions,
        'actions'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Actions := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.SmartInputs(const Value: SmartInputs.Msg):
      const Child: Mvu.Transition<SmartInputs.Model, G.Msg> := C.MapTransition<SmartInputs.Model, SmartInputs.Msg, G.Msg>(
        SmartInputsUpdate.Update(State.SmartInputs, Value),
        G.Msg.SmartInputs,
        'smartinputs'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          SmartInputs := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Pickers(const Value: Pickers.Msg):
      const Child: Mvu.Transition<Pickers.Model, G.Msg> := C.MapTransition<Pickers.Model, Pickers.Msg, G.Msg>(
        PickersUpdate.Update(State.Pickers, Value), G.Msg.Pickers, 'pickers'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Pickers := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Disclosure(const Value: Disclosure.Msg):
      const Child: Mvu.Transition<Disclosure.Model, G.Msg> := C.MapTransition<Disclosure.Model, Disclosure.Msg, G.Msg>(
        DisclosureUpdate.Update(State.Disclosure, Value),
        G.Msg.Disclosure,
        'disclosure'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Disclosure := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Capture(const Value: Capture.Msg):
      const Child: Mvu.Transition<Capture.Model, G.Msg> := C.MapTransition<Capture.Model, Capture.Msg, G.Msg>(
        CaptureUpdate.Update(State.Capture, Value), G.Msg.Capture, 'capture'
      );
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Capture := Child.Model;
        end with, Child.Commands
      );
    when G.Msg.Audio(const Value: Audio.Msg):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Audio := AudioUpdate.Update(State.Audio, Value);
        end with, []
      );
    when G.Msg.Show(const Value: G.Page):
      const Commands: Collections.List<Mvu.Command<G.Msg>> := new Collections.List<Mvu.Command<G.Msg>>();
      if Value <> State.Active then
        if State.Active = G.Page.Audio then
          Commands.Add(Mvu.CancelBackground<G.Msg>(AudioClock.Id));
        elsif State.Active = G.Page.Motion or State.Active = G.Page.Voice or State.Active =
          G.Page.AI or State.Active = G.Page.CanvasAndBars
        then
          Commands.Add(Mvu.CancelBackground<G.Msg>(MotionClock.Id));
        elsif State.Active = G.Page.EditingTools then
          Commands.Add(Mvu.CancelBackground<G.Msg>('editing/shot-playback'));
        elsif State.Active = G.Page.Code then
          Commands.Add(Mvu.CancelBackground<G.Msg>('code/markdown-replay'));
        elsif State.Active = G.Page.Disclosure then
          Commands.Add(Mvu.CancelBackground<G.Msg>(DisclosureClock.Id));
        end if;

        if Value = G.Page.Audio then
          Commands.Add(
            AudioClock.Start<G.Msg>(
              G.Msg.Audio(Audio.Msg.Tick), function(Error: Sys.Exception): G.Msg => G.Msg.Preview
            )
          );
        elsif Value = G.Page.Motion then
          Commands.Add(
            MotionClock.Start<G.Msg>(
              function(Seconds: float): G.Msg => G.Msg.Motion(Motion.Msg.Tick(Seconds)),
              function(Error: Sys.Exception): G.Msg => G.Msg.Preview
            )
          );
        elsif Value = G.Page.CanvasAndBars then
          Commands.Add(
            MotionClock.Start<G.Msg>(
              function(Seconds: float): G.Msg => G.Msg.Canvas(Canvas.Msg.Tick(Seconds)),
              function(Error: Sys.Exception): G.Msg => G.Msg.Preview, 400
            )
          );
        elsif Value = G.Page.Voice then
          Commands.Add(
            MotionClock.Start<G.Msg>(
              function(Seconds: float): G.Msg => G.Msg.Voice(Voice.Msg.Tick(Seconds)),
              function(Error: Sys.Exception): G.Msg => G.Msg.Preview, 50
            )
          );
        elsif Value = G.Page.AI then
          Commands.Add(
            MotionClock.Start<G.Msg>(
              function(Seconds: float): G.Msg => G.Msg.AI(Ai.Msg.Tick(Seconds)),
              function(Error: Sys.Exception): G.Msg => G.Msg.Preview
            )
          );
        elsif Value = G.Page.Disclosure then
          Commands.Add(
            DisclosureClock.Start<G.Msg>(
              State.Disclosure.Deadline,
              function(Target: Sys.DateTimeOffset; Seconds: double): G.Msg => G.Msg.Disclosure(
                Disclosure.Msg.SetCountdown(Target, Seconds)
              ),
              function(Error: Sys.Exception): G.Msg => G.Msg.Preview
            )
          );
        end if;
      end if;

      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Active := Value;
          NavigationRevision := State.NavigationRevision + 1;
          Code := if Value <> G.Page.Code then
            State.Code with
              Replay := -1;
            end with
          else
            State.Code
          end if;
          Drawer := false;
          Editing := if Value <> G.Page.EditingTools then
            State.Editing with
              Playing := false;
            end with
          else
            State.Editing
          end if;
          Overlays := State.Overlays with
            Sheet := false;
            ProfileDialog := false;
            DeleteDialog := false;
            PaletteOpen := false;
            Filters := false;
          end with;
          Disclosure := State.Disclosure with
            BranchQuestion := false;
          end with;
          SmartInputs := State.SmartInputs with
            EmojiOpen := false;
          end with;
        end with, Commands.ToArray()
      );
    when G.Msg.SetDrawer(const Open: bool):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          Drawer := Open;
        end with, []
      );
    when G.Msg.DisplaySwatch(const Index: int):
      return new Mvu.Transition<G.Model, G.Msg>(
        State with
          DisplaySwatch := Index;
        end with, []
      );
    when G.Msg.Preview:
      return new Mvu.Transition<G.Model, G.Msg>(State, []);
  end case;
end function;

end unit;
