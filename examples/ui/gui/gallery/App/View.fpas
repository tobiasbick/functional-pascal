unit GuiGallery.App.View;

uses
  GuiGallery.Pages.Code.View as Code,
  GuiGallery.Pages.Instruments.State as InstrumentState,
  GuiGallery.Pages.Instruments.View as Instruments,
  GuiGallery.Pages.Motion.State as MotionState,
  GuiGallery.Pages.Motion.View as Motion,
  GuiGallery.Pages.Creative.State as CreativeState,
  GuiGallery.Pages.Creative.View as Creative,
  GuiGallery.Pages.Files.State as FileState,
  GuiGallery.Pages.Files.View as Files,
  GuiGallery.Pages.Planning.State as PlanningState,
  GuiGallery.Pages.Planning.View as Planning,
  GuiGallery.Pages.DataGrid.State as GridState,
  GuiGallery.Pages.DataGrid.View as GridView,
  GuiGallery.Pages.MoreCharts.State as MoreChartsState,
  GuiGallery.Pages.MoreCharts.View as MoreCharts,
  GuiGallery.Pages.Charts.State as ChartsState,
  GuiGallery.Pages.Charts.View as Charts,
  System.Collections.Generic as Collections,
  GuiGallery.Pages.Feedback.View as Feedback,
  GuiGallery.Pages.Layout.View as LayoutDemo,
  GuiGallery.Pages.Buttons.State as ButtonsState,
  GuiGallery.Pages.Buttons.View as Buttons,
  GuiGallery.Pages.Inputs.State as InputsState,
  GuiGallery.Pages.Inputs.View as Inputs,
  GuiGallery.Pages.Selection.State as SelectionState,
  GuiGallery.Pages.Selection.View as Selection,
  GuiGallery.Pages.Navigation.State as NavigationState,
  GuiGallery.Pages.Navigation.View as Navigation,
  GuiGallery.Pages.Lists.State as ListsState,
  GuiGallery.Pages.Lists.View as Lists,
  GuiGallery.Pages.Overlays.State as OverlaysState,
  GuiGallery.Pages.Overlays.View as Overlays,
  GuiGallery.Pages.Actions.State as ActionsState,
  GuiGallery.Pages.Actions.View as Actions,
  GuiGallery.Pages.Capture.State as CaptureState,
  GuiGallery.Pages.Capture.View as Capture,
  GuiGallery.Pages.Audio.State as AudioState,
  GuiGallery.Pages.Audio.View as Audio,
  GuiGallery.Pages.Pickers.State as PickersState,
  GuiGallery.Pages.Pickers.View as Pickers,
  GuiGallery.Pages.SmartInputs.State as SmartInputsState,
  GuiGallery.Pages.SmartInputs.View as SmartInputs,
  GuiGallery.Pages.Disclosure.State as DisclosureState,
  GuiGallery.Pages.Disclosure.View as Disclosure,
  GuiGallery.Pages.Reader.View as Reader,
  GuiGallery.App.Palette as Palette, GuiGallery.Pages.Overview.View as Overview, Fpas.Ui.Gui.Toasts as Toasts,
  GuiGallery.Pages.Overlays.Widgets.Dialog as Dialog,
  GuiGallery.Pages.Overlays.Widgets.DeleteDialog as DeleteDialog,
  GuiGallery.Pages.Overlays.Widgets.Notifications as Notifications,
  GuiGallery.App.State as State,
  GuiGallery.Shared.State as Demo,
  Fpas.Ui.Composition as U,
  Fpas.Ui.ThemeSwitchers as Switchers,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L,
  Fpas.Ui.Navigation as N,
  Fpas.Ui.Sheets as Sheets,
  Fpas.Ui.IconButtons as Icons,
  Fpas.Ui.Styles as S,
  System as Sys;

const SidebarWidth: int := 240;
const DrawerBreakpoint: int := 760;

function Gap(Units: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Units));
end function;

function Fixed(Units: int): L.Flex;
begin
  return new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(Units)));
end function;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);

function Space(Units: int): E.Element<State.Msg>;
begin
  return E.Size<State.Msg>(E.Column<State.Msg>(), Fixed(Units));
end function;

function PageTitle(Page: State.Page): string;
begin
  return if Page = State.Page.Lists then
    'Data display'
  elsif Page = State.Page.MoreCharts then
    'More charts'
  elsif Page = State.Page.CreativeControls then
    'Creative controls'
  elsif Page = State.Page.DataGrid then
    'Data grid'
  elsif Page = State.Page.SmartInputs then
    'Smart inputs'
  else
    Page.ToString()
  end if;
end function;

function Destination(Page: State.Page; Icon: int): N.Item<State.Msg>;
begin
  return new N.Item<State.Msg>(
    Page.ToString().ToLowerInvariant(),
    PageTitle(Page),
    State.Msg.Show(Page),
    Icon := Sys.Char.ConvertFromUtf32(Icon)
  );
end function;

function NavigationItems(Page: State.Page): E.Element<State.Msg>;
begin
  return N.Sidebar<State.Msg>(
    'navigation',
    [
      new N.Section<State.Msg>(
        'Components', [
          Destination(State.Page.Overview, $E1C1),
          Destination(State.Page.Buttons, $E1B4),
          Destination(State.Page.Inputs, $E198),
          Destination(State.Page.Selection, $E29A),
          Destination(State.Page.Navigation, $E09B),
          Destination(State.Page.Lists, $E106),
          Destination(State.Page.Overlays, $E529),
          Destination(State.Page.Feedback, $E059),
          Destination(State.Page.Charts, $E2A5)
        ]
      ),
      new N.Section<State.Msg>(
        'Extended',
        [
          Destination(State.Page.Actions, $E09A),
          Destination(State.Page.SmartInputs, $E172),
          Destination(State.Page.Pickers, $E063),
          Destination(State.Page.Capture, $E19E),
          Destination(State.Page.Disclosure, $E529),
          Destination(State.Page.Reader, $E0CC),
          Destination(State.Page.DataGrid, $E0E9),
          Destination(State.Page.Code, $E093),
          Destination(State.Page.Planning, $E1D0),
          Destination(State.Page.MoreCharts, $E06B),
          Destination(State.Page.Motion, $E038),
          Destination(State.Page.Audio, $E55A),
          Destination(State.Page.Files, $E0D7),
          Destination(State.Page.Instruments, $E2A5),
          Destination(State.Page.CreativeControls, $E1DD),
          Destination(State.Page.Layout, $E529)
        ]
      )
    ],
    Page.ToString().ToLowerInvariant()
  );
end function;

function ThemeControl(Model: State.Model): E.Element<State.Msg>;
begin
  return Switchers.ThemeSwitcher<State.Msg>(
    'theme',
    Model.Shared.Appearance,
    function(Value: Switchers.Selection): State.Msg => State.Msg.Shared(
      Demo.Msg.SetAppearance(Value)
    ),
    new Switchers.Options(WithSystem := true)
  );
end function;

function Sidebar(Model: State.Model; Pages: E.Element<State.Msg>): E.Element<State.Msg>;
begin
  return E.Styled<State.Msg>(
    E.Column<State.Msg>(
      new L.Flow(Padding := Gap(12), Gap := Gap(2), Align := L.Alignment.Stretch),
      E.Column<State.Msg>(
        new L.Flow(Padding := Gap(8)),
        E.Styled<State.Msg>(E.Text<State.Msg>('FPas CUI'), S.Role.Heading)
      ),
      Space(11),
      E.Size<State.Msg>(
        E.ScrollView<State.Msg>('navigation-scroll', Pages, ShowScrollbar := false),
        Fill
      ),
      E.Column<State.Msg>(new L.Flow(Padding := Gap(8)), ThemeControl(Model))
    ),
    S.Role.MutedPanel
  );
end function;

function Preview(Model: State.Model; Width: int): array of E.Element<State.Msg>;
begin
  case Model.Active of
    when State.Page.Files:
      const Parts: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
      for Item: E.Element<FileState.Msg> in Files.View(Model.Files) do
        Parts.Add(U.Map<FileState.Msg, State.Msg>(Item, State.Msg.Files));
      end for;

      return Parts.ToArray();
    when State.Page.Planning:
      const Parts: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
      for Item: E.Element<PlanningState.Msg> in Planning.View(Model.Planning) do
        Parts.Add(U.Map<PlanningState.Msg, State.Msg>(Item, State.Msg.Planning));
      end for;

      return Parts.ToArray();
    when State.Page.CreativeControls:
      const Parts: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
      for Item: E.Element<CreativeState.Msg> in Creative.View(Model.Creative) do
        Parts.Add(U.Map<CreativeState.Msg, State.Msg>(Item, State.Msg.Creative));
      end for;

      return Parts.ToArray();
    when State.Page.Motion:
      const Parts: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
      for Item: E.Element<MotionState.Msg> in Motion.View(Model.Motion) do
        Parts.Add(U.Map<MotionState.Msg, State.Msg>(Item, State.Msg.Motion));
      end for;

      return Parts.ToArray();
    when State.Page.Code:
      return Code.View<State.Msg>();
    when State.Page.Instruments:
      const Parts: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
      for Item: E.Element<InstrumentState.Msg> in Instruments.View(Model.Instruments) do
        Parts.Add(U.Map<InstrumentState.Msg, State.Msg>(Item, State.Msg.Instruments));
      end for;

      return Parts.ToArray();
    when State.Page.DataGrid:
      const Parts: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
      for Item: E.Element<GridState.Msg> in GridView.View(Model.DataGrid) do
        Parts.Add(U.Map<GridState.Msg, State.Msg>(Item, State.Msg.DataGrid));
      end for;

      return Parts.ToArray();
    when State.Page.MoreCharts:
      return MoreCharts.View<State.Msg>(
        Model.MoreCharts,
        State.Msg.MoreCharts(MoreChartsState.Msg.Shuffle)
      );
    when State.Page.Charts:
      const Parts: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
      for Item: E.Element<ChartsState.Msg> in Charts.View(Model.Charts) do
        Parts.Add(U.Map<ChartsState.Msg, State.Msg>(Item, State.Msg.Charts));
      end for;

      return Parts.ToArray();
    when State.Page.Layout:
      return [LayoutDemo.View<State.Msg>(State.Msg.Preview)];
    when State.Page.Feedback:
      return [
        Feedback.View<State.Msg>(
          State.Msg.Shared(
            Demo.Msg.Notify(
              'Project created',
              new Toasts.Options(Appearance := Toasts.Tone.Success)
            )
          )
        )
      ];
    when State.Page.Overview:
      return [
        Overview.View<State.Msg>(
          Model.Overview,
          Model.Shared,
          State.Msg.Show(State.Page.Buttons),
          State.Msg.Overlays(OverlaysState.Msg.SetPalette(true)),
          State.Msg.Overview
        )
      ];
    when State.Page.Buttons:
      return [
        U.Map<ButtonsState.Msg, State.Msg>(
          Buttons.View(Model.Buttons, Model.Shared, Width >= 600),
          State.Msg.Buttons
        )
      ];
    when State.Page.Inputs:
      return [
        U.Map<InputsState.Msg, State.Msg>(
          Inputs.View(Model.Inputs, Model.Shared),
          State.Msg.Inputs
        )
      ];
    when State.Page.Selection:
      return [
        U.Map<SelectionState.Msg, State.Msg>(
          Selection.View(Model.Selection, Model.Shared, Width >= 536),
          State.Msg.Selection
        )
      ];
    when State.Page.Navigation:
      return [
        U.Map<NavigationState.Msg, State.Msg>(
          Navigation.View(Model.Navigation),
          State.Msg.Navigation
        )
      ];
    when State.Page.Lists:
      const Sections: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
      for Part: E.Element<ListsState.Msg> in Lists.View(Model.Lists) do
        Sections.Add(U.Map<ListsState.Msg, State.Msg>(Part, State.Msg.Lists));
      end for;

      return Sections.ToArray();
    when State.Page.Overlays:
      return [
        U.Map<OverlaysState.Msg, State.Msg>(
          Overlays.View(Model.Overlays, Model.Shared),
          State.Msg.Overlays
        )
      ];
    when State.Page.Actions:
      return [
        U.Map<ActionsState.Msg, State.Msg>(
          Actions.View(Model.Actions, Model.Shared),
          State.Msg.Actions
        )
      ];
    when State.Page.SmartInputs:
      const Parts: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
      for Part: E.Element<SmartInputsState.Msg> in SmartInputs.View(Model.SmartInputs) do
        Parts.Add(U.Map<SmartInputsState.Msg, State.Msg>(Part, State.Msg.SmartInputs));
      end for;

      return Parts.ToArray();
    when State.Page.Capture:
      return [U.Map<CaptureState.Msg, State.Msg>(Capture.View(Model.Capture), State.Msg.Capture)];
    when State.Page.Audio:
      return [U.Map<AudioState.Msg, State.Msg>(Audio.View(Model.Audio), State.Msg.Audio)];
    when State.Page.Pickers:
      return [U.Map<PickersState.Msg, State.Msg>(Pickers.View(Model.Pickers), State.Msg.Pickers)];
    when State.Page.Reader:
      return [Reader.View<State.Msg>()];
    when State.Page.Disclosure:
      return [
        U.Map<DisclosureState.Msg, State.Msg>(
          Disclosure.View(Model.Disclosure),
          State.Msg.Disclosure
        )
      ];
    else
      raise new Sys.InvalidOperationException('Unknown gallery page.');
  end case;
end function;

function Content(Model: State.Model; Compact: bool; Inset: int; Width: int): E.Element<State.Msg>;
begin
  const Parts: Collections.List<E.Element<State.Msg>> := new Collections.List<E.Element<State.Msg>>();
  if Compact then
    Parts.Add(
      E.Row<State.Msg>(
        new L.Flow(Gap := Gap(8), Align := L.Alignment.Center),
        Icons.IconButton<State.Msg>(
          'drawer-open',
          Sys.Char.ConvertFromUtf32($E115),
          'Components',
          State.Msg.SetDrawer(true)
        ),
        E.Text<State.Msg>('FPas CUI')
      )
    );
  end if;

  if Model.Active <> State.Page.Overview then
    Parts.Add(
      E.Column<State.Msg>(
        new L.Flow(Gap := Gap(6), PaddingBottom := Gap(8), Clip := false),
        E.Styled<State.Msg>(E.Text<State.Msg>(PageTitle(Model.Active)), S.Role.PageTitle)
      )
    );
  end if;

  Parts.AddRange(Preview(Model, Width));
  return E.ScrollView<State.Msg>(
    'main-' + Model.Active.ToString().ToLowerInvariant() + '-' +
    Model.NavigationRevision.ToString(),
    E.Row<State.Msg>(
      new L.Flow(Align := L.Alignment.Start, Justify := L.Justification.Center, Clip := false),
      E.Size<State.Msg>(
        E.Column<State.Msg>(
          new L.Flow(
            Gap := Gap(20), Clip := false,
            PaddingStart := Gap(Inset), PaddingEnd := Gap(Inset),
            PaddingTop := Gap(
              if Compact then
                12
              else
                36
              end if
            ), PaddingBottom := Gap(64)
          ),
          Parts.ToArray()
        ),
        new L.Flex(
          Width := new L.AxisSize(Basis := L.Extent.Fill, Maximum := L.Measure.Logical(920))
        )
      )
    ),
    FadeEdges := true
  );
end function;

// Builds the graphical gallery with CUI's sidebar, centered content and drawer.
//
// ## Parameters
// - `Model`: Retained gallery state.
// - `Viewport`: Measured window size and responsive classes.
// ## Returns
// The complete gallery view.
public function Build(Model: State.Model; Viewport: L.Viewport): E.Element<State.Msg>;
begin
  const Width: int := Viewport.LogicalWidth ?? if Viewport.Width = L.SizeClass.Compact then
    600
  else
    1240
  end if;
  const Compact: bool := Width < DrawerBreakpoint;
  const Available: int := if Compact then
    Width
  else
    Width - SidebarWidth - 1
  end if;
  const Inset: int := if Compact then
    16
  else
    40
  end if;
  const Pages: E.Element<State.Msg> := NavigationItems(Model.Active);
  const Main: E.Element<State.Msg> := Content(
    Model,
    Compact,
    Inset,
    Sys.Math.Min(Available, 920) - 2 * Inset
  );
  const Body: E.Element<State.Msg> := if Compact then
    Sheets.Sheet<State.Msg>(
      'drawer',
      Main,
      E.Column<State.Msg>(new L.Flow(Gap := Gap(8)), Pages, ThemeControl(Model)),
      Model.Drawer,
      new Sheets.Options('FPas CUI', Edge := Sheets.Side.Left, Size := 280),
      State.Msg.SetDrawer(false)
    )
  else
    E.Size<State.Msg>(
      E.Row<State.Msg>(
        new L.Flow(Align := L.Alignment.Stretch),
        E.Size<State.Msg>(Sidebar(Model, Pages), Fixed(SidebarWidth)),
        E.Size<State.Msg>(E.Styled<State.Msg>(E.Column<State.Msg>(), S.Role.Divider), Fixed(1)),
        E.Size<State.Msg>(Main, Fill)
      ),
      Fill
    )
  end if;
  const WithSheet: E.Element<State.Msg> := Notifications.Wrap<State.Msg>(
    Body, Model.Shared, Model.Overlays.Sheet, State.Msg.Overlays(OverlaysState.Msg.SetSheet(false)),
    State.Msg.Shared
  );
  const WithProfile: E.Element<State.Msg> := Dialog.Wrap<State.Msg>(
    Model.Overlays, Model.Shared, WithSheet, State.Msg.Overlays
  );
  const WithDelete: E.Element<State.Msg> := DeleteDialog.Wrap<State.Msg>(
    WithProfile,
    Model.Overlays.DeleteDialog,
    State.Msg.Overlays
  );
  return Palette.Wrap(Model.Overlays.PaletteOpen, WithDelete);
end function;

end unit;
