uses Fpas.Ui.Widgets.Overlays.Sheets as Sheets;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.App.Palette as Palette;
uses GuiGallery.App.Sidebar as Sidebar;
uses GuiGallery.App.State as State;
uses GuiGallery.App.Update as AppUpdate;
