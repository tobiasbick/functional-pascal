unit GuiGallery.CredentialFields;

uses
  GuiGallery.State as State, GuiGallery.Sections as G, Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L, Fpas.Ui.TagInputs as T, Fpas.Ui.OneTimeCodes as O,
  Fpas.Ui.TextFields as F, Fpas.Ui.PasswordStrengthMeters as P, Fpas.Ui.Gui.Toasts as Toasts;

// Builds the original tags, codes and password strength card.
//
// ## Parameters
// - `Model`: Current example values.
// ## Returns
// The second Inputs section.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading('Tags, codes and password strength', ''),
    G.Card(
      16, [
        T.TagInput<State.Msg>(
          'input-topics', Model.Topics, State.Msg.SetTopics,
          new T.Options(Label := 'Topics', Placeholder := 'Add a topic', MaxUtf8Bytes := 255)
        ),
        O.OneTimeCodeInput<State.Msg>(
          'input-code', Model.VerificationCode, State.Msg.SetVerificationCode,
          new O.Options(Label := 'Verification code'),
          function(Code: string): State.Msg => State.Msg.Notify(
            'Code entered', new Toasts.Options(Appearance := Toasts.Tone.Success)
          )
        ),
        E.Column<State.Msg>(
          new L.Flow(Gap := G.Points(8)),
          F.TextField<State.Msg>(
            'input-new-password', Model.Password, State.Msg.SetPassword,
            new F.Options(
              Label := 'New password', Password := true,
              Placeholder := 'Try a long passphrase', MaxUtf8Bytes := 63
            )
          ),
          P.PasswordStrengthMeter<State.Msg>('input-password-strength', Model.Password)
        )
      ]
    )
  );
end function;
end unit;
