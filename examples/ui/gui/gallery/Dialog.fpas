unit GuiGallery.Dialog;

uses
  GuiGallery.State as State, GuiGallery.Sections as G, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L,
  Fpas.Ui.Styles as S, Fpas.Ui.Buttons as B, Fpas.Ui.Dialogs as D, Fpas.Ui.ActionFooters as F,
  Fpas.Ui.TextFields as TextFields, Fpas.Ui.Switches as Switches, System as Sys;

// Shows the original dialog and sheet triggers on Overlays.
//
// ## Returns
// The native gallery's accepted actions in their original card.
public function Section(): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading('Dialogs and sheets', 'Esc or a click outside closes them. Focus stays inside.'),
    G.Card(
      12, [
        E.Row<State.Msg>(
          new L.Flow(Gap := G.Points(8), Wrap := true),
          B.Button<State.Msg>(
            'edit-profile-open', 'Edit profile', State.Msg.SetProfileDialog(true),
            new B.Options(Icon := Sys.Char.ConvertFromUtf32($E1F9))
          ),
          B.Button<State.Msg>(
            'sheet-open', 'Open sheet', State.Msg.SetSheet(true),
            new B.Options(Icon := Sys.Char.ConvertFromUtf32($E12A))
          )
        )
      ]
    )
  );
end function;

// Presents the original Edit profile dialog over the gallery.
//
// ## Parameters
// - `Model`: Shared sample profile values and dialog visibility.
// - `Base`: Current gallery view.
// ## Returns
// The view with the controlled native dialog and action footer.
public function Wrap(Model: State.Model; Base: E.Element<State.Msg>): E.Element<State.Msg>;
begin
  const Content: E.Element<State.Msg> := E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(16), Align := L.Alignment.Stretch),
    TextFields.TextField<State.Msg>(
      'edit-profile-name',
      Model.Name,
      State.Msg.SetName,
      new TextFields.Options(Label := 'Name', MaxUtf8Bytes := 63)
    ),
    TextFields.TextField<State.Msg>(
      'edit-profile-email', Model.Email, State.Msg.SetEmail,
      new TextFields.Options(
        Label := 'Email',
        Icon := Sys.Char.ConvertFromUtf32($E10F),
        MaxUtf8Bytes := 95
      )
    ),
    Switches.Switch<State.Msg>(
      'edit-profile-public',
      'Public profile',
      Model.Wifi,
      State.Msg.SetWifi
    ),
    F.ActionFooter<State.Msg>(
      B.Button<State.Msg>('edit-profile-cancel', 'Cancel', State.Msg.SetProfileDialog(false)),
      B.Button<State.Msg>(
        'edit-profile-save', 'Save changes', State.Msg.SaveProfile,
        new B.Options(Variant := S.ButtonVariant.Primary)
      )
    )
  );
  return D.Dialog<State.Msg>(
    'edit-profile', Base, Content, Model.ProfileDialog,
    new D.Options('Edit profile', Description := 'Changes are visible to your team.'),
    State.Msg.SetProfileDialog(false)
  );
end function;
end unit;
