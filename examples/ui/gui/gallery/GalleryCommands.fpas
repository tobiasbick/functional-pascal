unit GuiGallery.Commands;

uses
  GuiGallery.State as G, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.StatusButtons as Work,
  Fpas.Ui.Gui.Toasts as Toasts, System as Sys, System.Threading as Threads,
  System.Threading.Tasks as Tasks;

function SaveAfter(Milliseconds: int; Status: Work.Status): Mvu.Command<G.Msg>;
  async function Advance(Post: function(G.Msg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
  begin
    await Tasks.Task.Delay(Milliseconds, Token).ConfigureAwait(false);
    await Post(G.Msg.SetSaveStatus(Status)).ConfigureAwait(false);
  end function;
begin
  return Mvu.StartBackground<G.Msg>(
    'actions-save',
    Advance,
    function(Error: Sys.Exception): G.Msg => G.Msg.SetSaveStatus(Work.Status.Idle)
  );
end function;

// Returns the effects associated with a gallery action.
//
// ## Parameters
// - `State`: Model before applying the action.
// - `Message`: Action to apply.
// ## Returns
// Background work and notifications to run after the next view is prepared.
public function ForAction(State: G.Model; Message: G.Msg): array of Mvu.Command<G.Msg>;
begin
  return case Message of
    when G.Msg.StartSave: if State.SaveStatus = Work.Status.Idle then [
        SaveAfter(1400, Work.Status.Success)
      ]
      else []
      end if;
    when G.Msg.SetSaveStatus(const Value: Work.Status): if Value = Work.Status.Success then [
        SaveAfter(1600, Work.Status.Idle)
      ]
      else []
      end if;
    when G.Msg.SaveProfile: [
      Toasts.Show<G.Msg>('Profile updated', new Toasts.Options(Appearance := Toasts.Tone.Success))
    ];
    when G.Msg.SelectAncestor(const Label: string): [Toasts.Show<G.Msg>(Label)];
    when G.Msg.FinishSteps: [
      Toasts.Show<G.Msg>('All set', new Toasts.Options(Appearance := Toasts.Tone.Success))
    ];
    when G.Msg.Notify(
      const Title: string,
      const Settings: Toasts.Options
    ): [Toasts.Show<G.Msg>(Title, Settings)];
    when G.Msg.ArchiveMessage: [
      Toasts.Show<G.Msg>(
        'Message archived', new Toasts.Options(ActionLabel := 'Undo', ShowTimer := true),
        function(): G.Msg => G.Msg.UndoArchive
      )
    ];
    when G.Msg.UndoArchive: [
      Toasts.Show<G.Msg>('Message restored', new Toasts.Options(Appearance := Toasts.Tone.Success))
    ];
    else [];
  end case;
end function;
end unit;
