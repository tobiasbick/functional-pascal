unit GuiGallery.State;

uses
  Fpas.Ui.ThemeSwitchers as Switchers, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Themes as Themes,
  Fpas.Ui.StatusButtons as Work, Fpas.Ui.RangeSliders as R, Fpas.Ui.Gui.Toasts as Toasts,
  System as Sys, GuiGallery.Commands as Commands, GuiGallery.Reactions as ReactionDemo, Fpas.Ui.Reactions as React;

// Pages from the CUI gallery with accepted FPAS previews.
public type Page = enum: byte
  // Gallery introduction.
  Overview;
  // Buttons and their related actions.
  Buttons;
  // Native text fields and their validation state.
  Inputs;
  // Native selection controls and sliders.
  Selection;
  // Native tabs, breadcrumb, pagination and stepper.
  Navigation;
  // The sheet, popover, context menu and native toasts.
  Overlays;
  // Related actions from the extended gallery.
  Actions;
  // Native text-field affixes from the extended gallery.
  SmartInputs;
  // Native disclosure examples.
  Disclosure;
end enum;

// Independent actions in the button group.
public type TextFormat = enum: byte
  // Draw text in bold.
  Bold = 1;
  // Draw text in italics.
  Italic = 2;
  // Draw an underline.
  Underline = 4;
end enum;

// Retained gallery and preview state.
public type Model = record
  // Active navigation destination.
  public Active: Page := Page.Overview;
  // Appearance shared by both selectors and the light/dark toggle.
  public Appearance: Switchers.Selection := Switchers.Selection.Light;
  // Application-supplied appearance used by the System demo choice.
  public SystemAppearance: Themes.Mode := Themes.Mode.Light;
  // Whether the save action is busy.
  public ButtonLoading: bool := false;
  // Selected position in the native view segment demo.
  public SegmentedView: int := 0;
  // Selected position in the compact date-range demo.
  public SegmentedRange: int := 0;
  // Email notifications preference.
  public Newsletter: bool := true;
  // Partner offers preference.
  public Marketing: bool := false;
  // Wi-Fi switch value.
  public Wifi: bool := true;
  // Bluetooth switch value.
  public Bluetooth: bool := false;
  // Airplane-mode switch value.
  public Airplane: bool := false;
  // Selected save-frequency example.
  public SaveFrequency: int := 1;
  // Selected destination in the radio cards.
  public SavePlace: int := 1;
  // Current volume on the continuous slider.
  public Volume: float := 64.0F;
  // Current brightness on the stepped slider.
  public Brightness: float := 40.0F;
  // Lower price bound in the range slider.
  public PriceLower: float := 20.0F;
  // Upper price bound in the range slider.
  public PriceUpper: float := 75.0F;
  // Independent category chips, with Design and Marketing selected initially.
  public SelectedChips: int := 5;
  // Current whole-star rating.
  public Stars: int := 4;
  // Selected underline tab on the Navigation page.
  public ActiveTab: int := 0;
  // Selected pill tab on the Navigation page.
  public ActivePillTab: int := 0;
  // Current zero-based page in the pagination example.
  public PageIndex: int := 0;
  // Current zero-based step, starting at Workspace.
  public ActiveStep: int := 1;
  // Last harmless dropdown command; previews do not alter files or projects.
  public MenuResult: string := '';
  // Active formatting actions.
  public Formats: int := 0;
  // Independent formatting flags on the Actions page, with Bold selected initially.
  public ToggleFormats: (array of bool)? := null;
  // Exclusive alignment flags on the Actions page, with Left selected initially.
  public ToggleAlignment: (array of bool)? := null;
  // Completed holds shown by the gallery preview.
  public HoldCount: int := 0;
  // Whether the confirmation preview has completed.
  public ProjectDeleted: bool := false;
  // Model-owned state of the inline save preview.
  public SaveStatus: Work.Status := Work.Status.Idle;
  // Last action from the Save split button.
  public SplitResult: string := '';
  // Reaction counts and activation on the Actions page.
  public Reactions: array of React.Item := ReactionDemo.Initial();
  // Whether the compact navigation drawer is open.
  public Drawer: bool := false;
  // Whether the sheet preview is open.
  public Sheet: bool := false;
  // Whether the Edit profile dialog is open.
  public ProfileDialog: bool := false;
  // Whether the Filters panel is open.
  public Filters: bool := false;
  // Whether the branch confirmation is open.
  public BranchQuestion: bool := false;
  // Whether the harmless confirmation preview has completed.
  public BranchDeleted: bool := false;
  // Sample name in the text-field example.
  public Name: string := 'Maya Okafor';
  // Current query in the Search projects example.
  public SearchQuery: string := '';
  // Current multiline value in the About example.
  public About: string := 'Mathematician and writer. I like engines that compute and interfaces that stay out of the way.';
  // Sample email in the reserved example domain.
  public Email: string := 'maya@example.com';
  // Current value of the password example.
  public Password: string := '';
  // Ordered topics in the tag input example.
  public Topics: array of string := ['design', 'c99', 'native'];
  // Partial verification code in the example.
  public VerificationCode: string := '418';
  // Current country in the picker example.
  public Country: int := 2;
  // Current language, or minus one before selection.
  public Language: int := -1;
  // Bounded seat count.
  public Seats: double := 3.0;
  // Editable part of the URL after its prefix.
  public Url: string := 'cui.dev';
  // Editable weight before the unit suffix.
  public Weight: string := '72';
end record;

// Actions available to the gallery.
public type Msg = variant
  // Select a navigation destination.
  Show(Value: Page);
  // Propose an appearance from the header or preview selector.
  SetAppearance(Value: Switchers.Selection);
  // Simulate a change from the application's appearance provider.
  SetSystemAppearance(Value: Themes.Mode);
  // Activate a button that has no retained effect.
  Preview;
  // Change the save action's busy state.
  SetButtonLoading(Value: bool);
  // Select List, Board or Timeline.
  SetSegmentedView(Value: int);
  // Select Day, Week, Month or Year.
  SetSegmentedRange(Value: int);
  // Set the email notifications preference.
  SetNewsletter(Value: bool);
  // Set the partner offers preference.
  SetMarketing(Value: bool);
  // Set the Wi-Fi switch.
  SetWifi(Value: bool);
  // Set the Bluetooth switch.
  SetBluetooth(Value: bool);
  // Set the airplane-mode switch.
  SetAirplane(Value: bool);
  // Select a save frequency.
  SetSaveFrequency(Value: int);
  // Select the save destination.
  SetPlace(Value: int);
  // Adjust the volume.
  SetVolume(Value: float);
  // Adjust the brightness.
  SetBrightness(Value: float);
  // Adjust both price bounds as one interval.
  SetPrice(Value: R.Interval);
  // Set one category's selected flag.
  SetChip(Mask: int; Selected: bool);
  // Accept a whole-star rating.
  SetRating(Value: int);
  // Choose a tab in the underline strip.
  SetTab(Value: int);
  // Choose a tab in the pill strip.
  SetPillTab(Value: int);
  // Notify the user which breadcrumb ancestor was activated.
  SelectAncestor(Label: string);
  // Accept a page in the pagination example.
  SetPageIndex(Value: int);
  // Move to another step in the preview.
  SetStep(Value: int);
  // Show the completion feedback from the final step.
  FinishSteps;
  // Show one of the passive toast examples.
  Notify(Title: string; Settings: Toasts.Options);
  // Preview archiving a message and offer an Undo action.
  ArchiveMessage;
  // Handle the timed toast's Undo action.
  UndoArchive;
  // Record a dropdown command without performing external actions.
  MenuChoice(Value: string);
  // Toggle one formatting action.
  ToggleFormat(Style: TextFormat);
  // Accept the formatting group's changed flags.
  SetToggleFormats(Value: array of bool);
  // Accept the alignment group's changed flags.
  SetToggleAlignment(Value: array of bool);
  // Record one completed hold.
  ConfirmHold;
  // Record one completed two-step confirmation.
  ConfirmDelete;
  // Start the inline save preview while idle.
  StartSave;
  // Apply a scheduled feedback state to the save preview.
  SetSaveStatus(Value: Work.Status);
  // Record a primary or menu action.
  SplitChoice(Value: string);
  // Apply the changed reaction proposed by CUI.
  SetReaction(Index: int; Value: React.Item);
  // Choose a command from the simulated account menu.
  UserCommand(Key: string);
  // Open or close the compact navigation drawer.
  SetDrawer(Open: bool);
  // Open or close the sheet preview.
  SetSheet(Open: bool);
  // Open or close the Edit profile dialog.
  SetProfileDialog(Open: bool);
  // Close the profile preview and show its success notification.
  SaveProfile;
  // Open or close the Filters panel.
  SetFilters(Open: bool);
  // Open or cancel the branch confirmation.
  SetBranchQuestion(Open: bool);
  // Record confirmation without changing a repository.
  PreviewBranchDeletion;
  // Update the sample full name.
  SetName(Value: string);
  // Update the search query.
  SetSearchQuery(Value: string);
  // Update the About text.
  SetAbout(Value: string);
  // Update the sample email address.
  SetEmail(Value: string);
  // Update the sample password.
  SetPassword(Value: string);
  // Replace the selected topics.
  SetTopics(Value: array of string);
  // Replace the partial verification code.
  SetVerificationCode(Value: string);
  // Select a country.
  SetCountry(Index: int);
  // Select a language.
  SetLanguage(Index: int);
  // Adjust the seat count.
  SetSeats(Value: double);
  // Update the URL without its displayed prefix.
  SetUrl(Value: string);
  // Update the weight without its displayed unit.
  SetWeight(Value: string);
end variant;

// Resolves the palette for the current gallery appearance.
//
// ## Parameters
// - `State`: Current gallery model.
// ## Returns
// The light or dark CUI palette.
public function ThemeFor(State: Model): Themes.Theme;
begin
  return if Switchers.Resolve(
      State.Appearance,
      State.SystemAppearance
    ) = Themes.Mode.Dark then Themes.Dark()
    else Themes.Light()
    end if;
end function;

function ChangeReaction(Items: array of React.Item; Index: int; Value: React.Item): array of React.Item;
begin
  const Next: array of React.Item := cast<array of React.Item>(Items.Clone());
  Next[Index] := Value;
  return Next;
end function;

// Applies a gallery action.
//
// ## Parameters
// - `State`: Current gallery model.
// - `Message`: Action to apply.
// ## Returns
// The next model and any host commands.
public function Update(State: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  const Next: Model := case Message of
    when Msg.Show(const Value: Page): State with
      Active := Value;
      Drawer := false;
      Sheet := false;
      ProfileDialog := false;
      Filters := false;
      BranchQuestion := false;
    end with;
    when Msg.SetAppearance(const Value: Switchers.Selection): State with
      Appearance := Value;
    end with;
    when Msg.SetSystemAppearance(const Value: Themes.Mode): State with
      SystemAppearance := Value;
    end with;
    when Msg.SetButtonLoading(const Value: bool): State with
      ButtonLoading := Value;
    end with;
    when Msg.SetSegmentedView(const Value: int): State with
      SegmentedView := Value;
    end with;
    when Msg.MenuChoice(const Value: string): State with
      MenuResult := Value;
    end with;
    when Msg.SetSegmentedRange(const Value: int): State with
      SegmentedRange := Value;
    end with;
    when Msg.SetNewsletter(const Value: bool): State with
      Newsletter := Value;
    end with;
    when Msg.SetMarketing(const Value: bool): State with
      Marketing := Value;
    end with;
    when Msg.SetWifi(const Value: bool): State with
      Wifi := Value;
    end with;
    when Msg.SetBluetooth(const Value: bool): State with
      Bluetooth := Value;
    end with;
    when Msg.SetAirplane(const Value: bool): State with
      Airplane := Value;
    end with;
    when Msg.SetSaveFrequency(const Value: int): State with
      SaveFrequency := Value;
    end with;
    when Msg.SetPlace(const Value: int): State with
      SavePlace := Value;
    end with;
    when Msg.SetVolume(const Value: float): State with
      Volume := Value;
    end with;
    when Msg.SetBrightness(const Value: float): State with
      Brightness := Value;
    end with;
    when Msg.SetPrice(const Value: R.Interval): State with
      PriceLower := Value.Lower;
      PriceUpper := Value.Upper;
    end with;
    when Msg.SetChip(const Mask: int, const Selected: bool): State with
      SelectedChips := if Selected then State.SelectedChips or Mask
        else State.SelectedChips and not Mask
        end if;
    end with;
    when Msg.SetRating(const Value: int): State with
      Stars := Value;
    end with;
    when Msg.SetTab(const Value: int): State with
      ActiveTab := Value;
    end with;
    when Msg.SetPillTab(const Value: int): State with
      ActivePillTab := Value;
    end with;
    when Msg.SetPageIndex(const Value: int): State with
      PageIndex := Value;
    end with;
    when Msg.SetStep(const Value: int): State with
      ActiveStep := Value;
    end with;
    when Msg.SelectAncestor(_), Msg.FinishSteps, Msg.Notify(
      _,
      _
    ), Msg.ArchiveMessage, Msg.UndoArchive: State;
    when Msg.ToggleFormat(const Style: TextFormat): State with
      Formats := State.Formats xor cast<int>(Style);
    end with;
    when Msg.SetToggleFormats(const Value: array of bool): State with
      ToggleFormats := Value;
    end with;
    when Msg.SetToggleAlignment(const Value: array of bool): State with
      ToggleAlignment := Value;
    end with;
    when Msg.SplitChoice(const Value: string): State with
      SplitResult := Value;
    end with;
    when Msg.ConfirmHold: State with
      HoldCount := State.HoldCount + 1;
    end with;
    when Msg.ConfirmDelete: State with
      ProjectDeleted := true;
    end with;
    when Msg.StartSave: if State.SaveStatus = Work.Status.Idle then State with
        SaveStatus := Work.Status.Busy;
      end with
      else State
      end if;
    when Msg.SetSaveStatus(const Value: Work.Status): State with
      SaveStatus := Value;
    end with;
    when Msg.SetDrawer(const Open: bool): State with
      Drawer := Open;
    end with;
    when Msg.SetSheet(const Open: bool): State with
      Sheet := Open;
    end with;
    when Msg.SetProfileDialog(const Open: bool): State with
      ProfileDialog := Open;
    end with;
    when Msg.SaveProfile: State with
      ProfileDialog := false;
    end with;
    when Msg.SetFilters(const Open: bool): State with
      Filters := Open;
    end with;
    when Msg.SetBranchQuestion(const Open: bool): State with
      BranchQuestion := Open;
    end with;
    when Msg.PreviewBranchDeletion: State with
      BranchQuestion := false;
      BranchDeleted := true;
    end with;
    when Msg.SetName(const Value: string): State with
      Name := Value;
    end with;
    when Msg.SetSearchQuery(const Value: string): State with
      SearchQuery := Value;
    end with;
    when Msg.SetAbout(const Value: string): State with
      About := Value;
    end with;
    when Msg.SetEmail(const Value: string): State with
      Email := Value;
    end with;
    when Msg.SetPassword(const Value: string): State with
      Password := Value;
    end with;
    when Msg.SetTopics(const Value: array of string): State with
      Topics := Value;
    end with;
    when Msg.SetVerificationCode(const Value: string): State with
      VerificationCode := Value;
    end with;
    when Msg.SetCountry(const Index: int): State with
      Country := Index;
    end with;
    when Msg.SetLanguage(const Index: int): State with
      Language := Index;
    end with;
    when Msg.SetSeats(const Value: double): State with
      Seats := Value;
    end with;
    when Msg.SetUrl(const Value: string): State with
      Url := Value;
    end with;
    when Msg.SetWeight(const Value: string): State with
      Weight := Value;
    end with;
    when Msg.SetReaction(const Index: int, const Value: React.Item): State with
      Reactions := ChangeReaction(State.Reactions, Index, Value);
    end with;
    when Msg.UserCommand(_): State;
    when Msg.Preview: State;
  end case;
  return new Mvu.Transition<Model, Msg>(Next, Commands.ForAction(State, Message));
end function;
end unit;
