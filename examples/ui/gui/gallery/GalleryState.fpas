unit GuiGallery.State;

uses
  Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Editors as Ed, Fpas.Ui.Layout as L,
  System as Sys, System.Threading as Threads, System.Threading.Tasks as Tasks;

// Retained gallery state, independent of viewport and theme.
public type Model = record
  // Navigation key.
  public Page: string := 'controls';
  // Native color theme.
  public Dark: bool := false;
  // Counter value.
  public Count: int := 0;
  // Controlled checkbox.
  public Checked: bool := false;
  // Single-line document.
  public Text: string := 'Pascal λ 👋';
  // Single-line selection.
  public Position: Ed.EditorPosition := new Ed.EditorPosition();
  // Multiline document.
  public Document: string := 'First line';
  // Multiline selection.
  public DocumentPosition: Ed.EditorPosition := new Ed.EditorPosition();
  // Collection selection.
  public Selected: string? := 'alpha';
  // Active tab.
  public Tab: string? := 'one';
  // Overlay visibility.
  public Modal: bool := false;
  // Background operation status.
  public Status: string := 'Ready';
  // Controlled scroll request.
  public Scroll: L.ScrollPosition := L.ScrollPosition.Start;
end record;

// All application and preview messages.
public type Msg = variant
  Navigate(Page: string);
  Theme;
  Increment;
  Check(Value: bool);
  Edit(Value: Ed.TextEdit);
  Move(Value: Ed.EditorPosition);
  EditDocument(Value: Ed.TextEdit);
  MoveDocument(Value: Ed.EditorPosition);
  Select(Key: string);
  Activate(Key: string);
  Tab(Key: string);
  Open;
  Close;
  Start;
  Cancel;
  Done;
  Failed(Text: string);
  Scroll(Value: L.ScrollChange);
  Focus(Id: string);
  Quit;
end variant;

async function Work(Post: function(Msg): Tasks.Task; Cancellation: Threads.CancellationToken): Tasks.Task;
begin
  await Tasks.Task.Delay(1200, Cancellation).ConfigureAwait(false);
  await Post(Msg.Done).ConfigureAwait(false);
end function;

// Applies one message and returns declarative effects.
//
// ## Parameters
// - `Current`: Previous model.
// - `Message`: Typed input.
//
// ## Returns
// Next model and commands.
public function Update(Current: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  var Next: Model := Current;
  var Commands: array of Mvu.Command<Msg> := [];
  case Message of
    when Msg.Navigate(const Page: string):
      Next := Current with
        Page := Page;
      end with;
    when Msg.Theme:
      Next := Current with
        Dark := not Current.Dark;
      end with;
    when Msg.Increment:
      Next := Current with
        Count := Current.Count + 1;
      end with;
    when Msg.Check(const Value: bool):
      Next := Current with
        Checked := Value;
      end with;
    when Msg.Edit(const Value: Ed.TextEdit):
      Next := Current with
        Text := Value.Text;
        Position := Value.Position;
      end with;
    when Msg.Move(const Value: Ed.EditorPosition):
      Next := Current with
        Position := Value;
      end with;
    when Msg.EditDocument(const Value: Ed.TextEdit):
      Next := Current with
        Document := Value.Text;
        DocumentPosition := Value.Position;
      end with;
    when Msg.MoveDocument(const Value: Ed.EditorPosition):
      Next := Current with
        DocumentPosition := Value;
      end with;
    when Msg.Select(const Key: string):
      Next := Current with
        Selected := Key;
      end with;
    when Msg.Activate(const Key: string):
      Next := Current with
        Status := 'Activated: ' + Key;
      end with;
    when Msg.Tab(const Key: string):
      Next := Current with
        Tab := Key;
      end with;
    when Msg.Open:
      Next := Current with
        Modal := true;
      end with;
    when Msg.Close:
      Next := Current with
        Modal := false;
      end with;
    when Msg.Start:
      Next := Current with
        Status := 'Working';
      end with;
      Commands := [
        Mvu.StartBackground<Msg>(
          'gallery-work',
          Work,
          function(Error: Sys.Exception): Msg => Msg.Failed(Error.Message)
        )
      ];
    when Msg.Cancel:
      Next := Current with
        Status := 'Cancelled';
      end with;
      Commands := [Mvu.CancelBackground<Msg>('gallery-work')];
    when Msg.Done:
      Next := Current with
        Status := 'Completed';
      end with;
    when Msg.Failed(const Text: string):
      Next := Current with
        Status := Text;
      end with;
    when Msg.Scroll(const Value: L.ScrollChange):
      Next := Current with
        Scroll := Value.Position;
      end with;
    when Msg.Focus(const Id: string):
      Commands := [Mvu.Focus<Msg>(Id)];
    when Msg.Quit:
      Commands := [Mvu.Exit<Msg>()];
  end case;

  return new Mvu.Transition<Model, Msg>(Next, Commands);
end function;
end unit;
