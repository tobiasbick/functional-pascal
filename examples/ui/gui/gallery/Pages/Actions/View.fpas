unit GuiGallery.Pages.Actions.View;

uses
  GuiGallery.Shared.State as Demo,
  GuiGallery.Pages.Actions.Widgets.ToggleGroup as ToggleGroup,
  GuiGallery.Pages.Actions.Widgets.ThemeSwitcher as Theme,
  GuiGallery.Pages.Actions.State as State,
  GuiGallery.Pages.Actions.Widgets.SplitButton as Split,
  GuiGallery.Pages.Actions.Widgets.ConfirmButton as Confirm,
  GuiGallery.Pages.Actions.Widgets.StatusButton as Status,
  GuiGallery.Shared.Sections as G,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L,
  Fpas.Ui.Styles as S,
  GuiGallery.Pages.Actions.Widgets.Reactions as Reactions,
  GuiGallery.Pages.Actions.Widgets.UserMenu as UserMenu;

// Composes the accepted examples from CUI's extended Actions page.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current gallery state.
// ## Returns
// The implemented CUI Actions sections in their original order.
public function View(Model: State.Model; Data: Demo.Model): E.Element<State.Msg>;
begin
  const Delete: E.Element<State.Msg> := Confirm.View();
  const Save: E.Element<State.Msg> := Status.View(Model, Data);
  const Morphing: array of E.Element<State.Msg> := if Model.ProjectDeleted then [
      Delete, Save, E.Styled<State.Msg>(E.Text<State.Msg>('Project deleted'), S.Role.Muted)
    ]
    else [Delete, Save]
    end if;
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading<State.Msg>('Split button', 'A main action with related actions one click away.'),
    Split.View(Model, Data),
    G.Heading<State.Msg>(
      'Toggle group',
      'Independent toggles for toolbars, or exclusive like radio buttons.'
    ),
    ToggleGroup.View(Model, Data),
    G.Heading<State.Msg>(
      'Morphing buttons',
      'Confirm before destroying, and show the result of work in place.'
    ),
    E.Row<State.Msg>(new L.Flow(Gap := G.Points(12), Wrap := true), Morphing),
    G.Heading<State.Msg>('Reactions', 'Counts roll when they change.'),
    Reactions.View(Model, Data),
    G.Heading<State.Msg>(
      'Theme',
      'A compact switcher and a single toggle that morphs between sun and moon.'
    ),
    Theme.View(Model, Data),
    G.Heading<State.Msg>('User menu', 'Account trigger for sidebars and headers.'),
    UserMenu.View()
  );
end function;
end unit;
