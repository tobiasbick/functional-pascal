// [Documentation](../../../../../../../docs/ui/gui/actions/confirm-button.md)

unit GuiGallery.Pages.Actions.Widgets.ConfirmButton;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Actions.ConfirmButtons as Confirm;
uses GuiGallery.Pages.Actions.State as State;
uses System as Sys;

// Shows CUI's two-step destructive action.
//
// ## Returns
// The native gallery's Delete project button.
public function View(): E.Element<State.Msg>;
begin
  return Confirm.ConfirmButton<State.Msg>(
    'confirm-delete', 'Delete project', State.Msg.ConfirmDelete,
    new Confirm.Options(Icon := Sys.Char.ConvertFromUtf32($E18E))
  );
end function;

end unit;
