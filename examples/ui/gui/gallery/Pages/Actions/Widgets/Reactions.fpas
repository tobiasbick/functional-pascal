// [Documentation](../../../../../../../docs/ui/gui/actions/reactions.md)

unit GuiGallery.Pages.Actions.Widgets.Reactions;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Conversation.Reactions as R;

uses GuiGallery.Pages.Actions.State as State;
uses GuiGallery.Shared.State as Demo;

// Shows the native reaction group in the Actions page.
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current gallery state.
// ## Returns
// The four independent reactions.
public function View(Model: State.Model; Data: Demo.Model): E.Element of State.Msg;
begin
  return R.Reactions of State.Msg(
    'action-reactions', Model.Reactions,
    function(Index: int; Value: R.Item): State.Msg => State.Msg.SetReaction(Index, Value)
  );
end function;

end unit;
