// [Documentation](../../../../../../../docs/ui/gui/actions/speed-dial.md)

unit GuiGallery.Pages.Actions.Widgets.SpeedDial;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.SpeedDials as D;
uses Fpas.Ui.Widgets.Display.Texts as Texts;

uses GuiGallery.Pages.Actions.State as State;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;

// Shows the CUI gallery's floating Create actions.
// ## Parameters
// - `Model`: Current Actions state.
// ## Returns
// The original dial and its chosen-action caption.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  const Items: array of D.Item := [
    new D.Item('New note', Sys.Char.ConvertFromUtf32($E0CC)),
    new D.Item('Upload image', Sys.Char.ConvertFromUtf32($E0F6)),
    new D.Item('Record memo', Sys.Char.ConvertFromUtf32($E118))
  ];
  const Trigger: E.Element of State.Msg := D.SpeedDial of State.Msg(
    'action-speed-dial', Items, State.Msg.DialChoice, new D.Options(Tooltip := 'Create')
  );
  const Row: array of E.Element of State.Msg := if Model.DialChoice < 0 then
    [Trigger]
  else
    [
      Trigger,
      Texts.Text of State.Msg(Items[Model.DialChoice].Label ?? '', Texts.Appearance.Muted)
    ]
  end if;
  return E.Size of State.Msg(
    E.Row of State.Msg(
      new L.Flow(Gap := G.Points(16), Align := L.Alignment.Center, Clip := false),
      Row
    ),
    new L.Flex(Height := new L.AxisSize(Basis := L.Extent.Fixed(L.Measure.Logical(80))))
  );
end function;

end unit;
