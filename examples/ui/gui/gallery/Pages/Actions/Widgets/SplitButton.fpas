unit GuiGallery.Pages.Actions.Widgets.SplitButton;

uses
  GuiGallery.Shared.State as Demo,
  GuiGallery.Pages.Actions.State as State,
  GuiGallery.Shared.Sections as G,
  Fpas.Ui.SplitButtons as Split,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L,
  Fpas.Ui.Styles as S,
  System as Sys;

function Items(ShowResult: bool): array of Split.Item<State.Msg>;
  function Item(Key: string; Caption: string; Glyph: int; TerminalIcon: string): Split.Item<State.Msg>;
  begin
    return new Split.Item<State.Msg>(
      Key, Caption, if ShowResult then
        State.Msg.SplitChoice(Caption)
      else
        State.Msg.Preview
      end if,
      if ShowResult then
        Sys.Char.ConvertFromUtf32(Glyph)
      else
        ''
      end if,
      if ShowResult then
        TerminalIcon
      else
        ''
      end if
    );
  end function;
begin
  return [
    Item('draft', 'Save as draft', $E0CC, '▤'),
    Item('publish', 'Save and publish', $E152, '↑'),
    Item('schedule', 'Schedule…', $E087, '◷')
  ];
end function;

// Builds the accepted Split button section from CUI's Actions page.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current gallery state.
// ## Returns
// Primary and outline split buttons with an inline result.
public function View(Model: State.Model; Data: Demo.Model): E.Element<State.Msg>;
begin
  const Save: E.Element<State.Msg> := Split.SplitButton<State.Msg>(
    'split-save', 'Save', State.Msg.SplitChoice('Saved'), Items(true),
    new Split.Options(Icon := Sys.Char.ConvertFromUtf32($E14D), TerminalIcon := '↓')
  );
  const Export: E.Element<State.Msg> := Split.SplitButton<State.Msg>(
    'split-export', 'Export', State.Msg.Preview, Items(false),
    new Split.Options(
      Variant := S.ButtonVariant.Outline,
      Icon := Sys.Char.ConvertFromUtf32($E0B2),
      TerminalIcon := '↓'
    )
  );
  const Content: array of E.Element<State.Msg> := if Model.SplitResult = '' then
    [Save, Export]
  else
    [Save, Export, E.Styled<State.Msg>(E.Text<State.Msg>(Model.SplitResult), S.Role.Muted)]
  end if;
  return E.Row<State.Msg>(new L.Flow(Gap := G.Points(12), Wrap := true), Content);
end function;

end unit;
