// [Documentation](../../../../../../../docs/ui/gui/actions/split-button.md)

unit GuiGallery.Pages.Actions.Widgets.SplitButton;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.SplitButtons as Split;
uses Fpas.Ui.Widgets.Display.Texts as Texts;

uses GuiGallery.Pages.Actions.State as State;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;
uses System as Sys;

function Items(ShowResult: bool): array of Split.Item of State.Msg;
  function Item(Key: string; Caption: string; Glyph: int): Split.Item of State.Msg;
  begin
    return new Split.Item of State.Msg(
      Key, Caption, if ShowResult then
        State.Msg.SplitChoice(Caption)
      else
        State.Msg.Preview
      end if,
      if ShowResult then
        Sys.Char.ConvertFromUtf32(Glyph)
      else
        ''
      end if
    );
  end function;
begin
  return [
    Item('draft', 'Save as draft', $E0CC),
    Item('publish', 'Save and publish', $E152),
    Item('schedule', 'Schedule…', $E087)
  ];
end function;

// Builds the accepted Split button section from CUI's Actions page.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current gallery state.
// ## Returns
// Primary and outline split buttons with an inline result.
public function View(Model: State.Model; Data: Demo.Model): E.Element of State.Msg;
begin
  const Save: E.Element of State.Msg := Split.SplitButton of State.Msg(
    'split-save', 'Save', State.Msg.SplitChoice('Saved'), Items(true),
    new Split.Options(Icon := Sys.Char.ConvertFromUtf32($E14D))
  );
  const Export: E.Element of State.Msg := Split.SplitButton of State.Msg(
    'split-export', 'Export', State.Msg.Preview, Items(false),
    new Split.Options(
      Variant := S.ButtonVariant.Outline,
      Icon := Sys.Char.ConvertFromUtf32($E0B2)
    )
  );
  const Content: array of E.Element of State.Msg := if Model.SplitResult = '' then
    [Save, Export]
  else
    [Save, Export, Texts.Text of State.Msg(Model.SplitResult, Texts.Appearance.Muted)]
  end if;
  return E.Row of State.Msg(new L.Flow(Gap := G.Points(12), Wrap := true, Clip := false), Content);
end function;

end unit;
