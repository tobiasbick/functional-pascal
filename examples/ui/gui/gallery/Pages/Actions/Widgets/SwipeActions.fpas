// [Documentation](../../../../../../../docs/ui/gui/actions/swipe-actions.md)

unit GuiGallery.Pages.Actions.Widgets.SwipeActions;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as Graphics;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.SwipeActions as Swipe;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;

uses GuiGallery.Pages.Actions.State as State;
uses System as Sys;

function Row(Id: string; Title: string): E.Element of State.Msg;
begin
  return Swipe.SwipeItem of State.Msg(
    Id, E.FormattedText of State.Msg(
      Title, Graphics.Font.Body, 0.0F, new Graphics.Color(0, 0, 0, 0),
      NoWrap := true, Width := L.Extent.Fill
    ),
    [new Swipe.Item('Done', Sys.Char.ConvertFromUtf32($E06C), S.Tone.Success)],
    [
      new Swipe.Item('Archive', Sys.Char.ConvertFromUtf32($E041), S.Tone.Info),
      new Swipe.Item('Delete', Sys.Char.ConvertFromUtf32($E18E), S.Tone.Danger)
    ],
    State.Msg.SwipeChoice,
    new Swipe.Options(Icon := Sys.Char.ConvertFromUtf32($E076), Detail := 'Today')
  );
end function;

// Shows the three original CUI swipe rows.
// ## Returns
// A compact card of preview tasks.
public function View(): E.Element of State.Msg;
begin
  return Cards.Card of State.Msg(
    'swipe-card', [
      Row('swipe-design', 'Review the design tokens'),
      Row('swipe-release', 'Reply to Jonas about the release'),
      Row('swipe-venue', 'Book the offsite venue')
    ], new Cards.Options(Padding := 6.0F, Gap := 6.0F)
  );
end function;

end unit;
