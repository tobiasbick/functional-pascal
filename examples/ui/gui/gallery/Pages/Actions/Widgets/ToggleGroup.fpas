// [Documentation](../../../../../../../docs/ui/gui/actions/toggle-group.md)

unit GuiGallery.Pages.Actions.Widgets.ToggleGroup;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.ToggleGroups as T;

uses GuiGallery.Pages.Actions.State as State;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;
uses System as Sys;

// Shows CUI's icon formatting group and exclusive alignment group.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current selections for both groups.
// ## Returns
// The Toggle group section of the native Actions page.
public function View(Model: State.Model; Data: Demo.Model): E.Element of State.Msg;
begin
  const Formats: E.Element of State.Msg := T.ToggleGroup of State.Msg(
    'action-format', [
      new T.Item('Bold', Sys.Char.ConvertFromUtf32($E05D)),
      new T.Item('Italic', Sys.Char.ConvertFromUtf32($E0FB)),
      new T.Item('Underline', Sys.Char.ConvertFromUtf32($E19A)),
      new T.Item('Code', Sys.Char.ConvertFromUtf32($E093))
    ], Model.ToggleFormats ?? [true, false, false, false], State.Msg.SetToggleFormats,
    new T.Options(IconOnly := true)
  );
  const Alignment: E.Element of State.Msg := T.ToggleGroup of State.Msg(
    'action-align', [
      new T.Item('Left', Sys.Char.ConvertFromUtf32($E185)),
      new T.Item('Center', Sys.Char.ConvertFromUtf32($E106)),
      new T.Item('Right', Sys.Char.ConvertFromUtf32($E115))
    ], Model.ToggleAlignment ?? [true, false, false], State.Msg.SetToggleAlignment,
    new T.Options(Exclusive := true)
  );
  return E.Row of State.Msg(new L.Flow(Gap := G.Points(12), Wrap := true), Formats, Alignment);
end function;

end unit;
