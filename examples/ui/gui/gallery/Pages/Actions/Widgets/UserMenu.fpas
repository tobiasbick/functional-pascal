unit GuiGallery.Pages.Actions.Widgets.UserMenu;

uses
  GuiGallery.Pages.Actions.State as State,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L,
  Fpas.Ui.Widgets.Overlays.Menus as M,
  Fpas.Ui.Widgets.Overlays.UserMenus as U,
  System as Sys;

function Command(Key: string; Name: string; Icon: int; Shortcut: string := ''): M.Entry<State.Msg>;
begin
  return M.Entry<State.Msg>.Action(
    new M.Item<State.Msg>(
      Key, Name, State.Msg.UserCommand(Key), Icon := Sys.Char.ConvertFromUtf32(Icon),
      Shortcut := Shortcut
    )
  );
end function;

// Shows CUI's original account trigger and preview commands.
// ## Returns
// A user menu in the original 260-point box.
public function View(): E.Element<State.Msg>;
begin
  return E.Row<State.Msg>(
    E.Size<State.Msg>(
      U.UserMenu<State.Msg>(
        'action-user', 'Maya Okafor',
        [
          Command('profile', 'Profile', $E19F, 'Ctrl P'),
          Command('billing', 'Billing', $E0AA),
          Command('settings', 'Settings', $E154, 'Ctrl ,'),
          M.Entry<State.Msg>.Separator,
          Command('log-out', 'Log out', $E10E)
        ],
        new U.Options(Detail := 'maya@example.com', Status := 'online')
      ),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(260)))
    )
  );
end function;

end unit;
