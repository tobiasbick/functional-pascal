// [Documentation](../../../../../../docs/ui/gui/actions/README.md)

unit GuiGallery.Pages.Buttons.State;

uses GuiGallery.Shared.State as Demo;

// State owned by this gallery feature.
public type Model = record
  // Whether the save action is busy.
  public ButtonLoading: bool := false;
  // Selected position in the native view segment demo.
  public SegmentedView: int := 0;
  // Selected position in the compact date-range demo.
  public SegmentedRange: int := 0;
end record;

// Messages handled by this gallery feature.
public type Msg = variant
  // Change the save action's busy state.
  SetButtonLoading(Value: bool);
  // Select List, Board or Timeline.
  SetSegmentedView(Value: int);
  // Select Day, Week, Month or Year.
  SetSegmentedRange(Value: int);
  // Show the confirmation toast after one completed hold.
  ConfirmHold;
  // A harmless preview activation.
  Preview;
  // Open the shared project deletion dialog from the Options menu.
  OpenDeleteDialog;
  // Propose a change to shared demo values.
  Shared(Value: Demo.Msg);
end variant;

end unit;
