// [Documentation](../../../../../../docs/ui/gui/actions/README.md)

unit GuiGallery.Pages.Buttons.Update;

uses Fpas.Ui.Gui.Toasts as Toasts;
uses Fpas.Ui.Mvu.Application as Mvu;

uses GuiGallery.Pages.Buttons.State as S;

// Applies a message to this feature and describes its effects.
// ## Parameters
// - `State`: Current feature model.
// - `Message`: Feature message.
// ## Returns
// Next feature model and commands.
public function Update(State: S.Model; Message: S.Msg): Mvu.Transition of (S.Model, S.Msg);
begin
  const Next: S.Model := case Message of
    when S.Msg.SetButtonLoading(const Value: bool): State with
      ButtonLoading := Value;
    end with;
    when S.Msg.SetSegmentedView(const Value: int): State with
      SegmentedView := Value;
    end with;
    when S.Msg.SetSegmentedRange(const Value: int): State with
      SegmentedRange := Value;
    end with;
    else State;
  end case;
  return new Mvu.Transition of (S.Model, S.Msg)(
    Next, case Message of
      when S.Msg.ConfirmHold: [
        Toasts.Show of S.Msg('Deleted', new Toasts.Options(Appearance := Toasts.Tone.Danger))
      ];
      else [];
    end case
  );
end function;

end unit;
