// [Documentation](../../../../../../docs/ui/gui/actions/README.md)

unit GuiGallery.Pages.Buttons.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.IconButtons as I;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses Gallery.Shared.ButtonExamples as Samples;
uses GuiGallery.Pages.Buttons.State as State;
uses GuiGallery.Pages.Buttons.Widgets.ButtonGroup as Group;
uses GuiGallery.Pages.Buttons.Widgets.CopyButton as Copy;
uses GuiGallery.Pages.Buttons.Widgets.DropdownMenu as Dropdown;
uses GuiGallery.Pages.Buttons.Widgets.HoldButton as Hold;
uses GuiGallery.Pages.Buttons.Widgets.SegmentedControl as Segmented;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;

const Row: L.Flow := new L.Flow(Gap := G.Points(8), Wrap := true);

function Glyph(Code: int): string;
begin
  return Sys.Char.ConvertFromUtf32(Code);
end function;

function IconSample(
  Id: string;
  Code: int;
  Caption: string;
  Style: S.ButtonVariant := S.ButtonVariant.Default;
  Shortcut: string := ''
): E.Element of State.Msg;
begin
  return I.IconButton of State.Msg(
    Id, Glyph(Code), Caption, State.Msg.Preview,
    new I.Options(Variant := Style, Shortcut := Shortcut)
  );
end function;

// Builds the six sections of the CUI Buttons page.
//
// ## Parameters
// - `Model`: Current gallery model.
// - `Colors`: Active gallery theme colors.
// ## Returns
// Section headings and cards in gallery order.
public function View(Model: State.Model; Colors: Themes.Palette): array of E.Element of State.Msg;
begin
  const Sizes: E.Element of State.Msg := Samples.Sizes of State.Msg(
    State.Msg.Preview,
    Wrap := true
  );
  const Actions: array of E.Element of State.Msg := Samples.Icons of State.Msg(State.Msg.Preview);
  const CopyIcon: E.Element of State.Msg := IconSample(
    'icon-copy',
    $E09E,
    'Copy',
    Shortcut := 'Ctrl C'
  );
  const Share: E.Element of State.Msg := IconSample('icon-share', $E156, 'Share');
  const Like: E.Element of State.Msg := IconSample(
    'icon-like',
    $E0F2,
    'Like',
    S.ButtonVariant.Outline
  );
  const Delete: E.Element of State.Msg := IconSample(
    'icon-delete',
    $E18E,
    'Delete',
    S.ButtonVariant.Secondary
  );
  const Variants: E.Element of State.Msg := Samples.Variants of State.Msg(
    State.Msg.Preview,
    true,
    Wrap := true
  );
  const Icons: E.Element of State.Msg := E.Row of State.Msg(
    Row, Actions[0], Actions[1], Actions[2], CopyIcon, Share, Like, Delete
  );
  const States: E.Element of State.Msg := Samples.States of State.Msg(
    State.Msg.Preview,
    true,
    Model.ButtonLoading,
    State.Msg.SetButtonLoading,
    Wrap := true
  );
  const GroupAndCopy: E.Element of State.Msg := E.Row of State.Msg(
    new L.Flow(Gap := G.Points(12), Wrap := true),
    Group.View(),
    Copy.View(Colors),
    Hold.View()
  );

  return [
    G.Heading of State.Msg(
      'Variants',
      'One primary action per view. Secondary for everything else.'
    ),
    Cards.Card of State.Msg('button-variants-card', [Variants]),
    G.Heading of State.Msg('Sizes and icons'),
    Cards.Card of State.Msg('button-sizes-card', [Sizes, Icons], new Cards.Options(Gap := 16.0F)),
    G.Heading of State.Msg('States', 'Loading keeps the label so the layout does not jump.'),
    Cards.Card of State.Msg('button-states-card', [States]),
    G.Heading of State.Msg(
      'Groups, copy and hold to confirm',
      'Hold the button until it fills to confirm a destructive action.'
    ),
    Cards.Card of State.Msg('button-group-card', [GroupAndCopy]),
    G.Heading of State.Msg('Segmented control', 'A highlight glides to the selected option.'),
    Cards.Card of State.Msg(
      'button-segments-card',
      Segmented.View(Model),
      new Cards.Options(Gap := 16.0F)
    ),
    G.Heading of State.Msg('Dropdown menu'),
    Cards.Card of State.Msg('button-menus-card', [Dropdown.View()])
  ];
end function;

end unit;
