// [Documentation](../../../../../../docs/ui/gui/actions/README.md)

unit GuiGallery.Pages.Buttons.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.IconButtons as I;

uses Gallery.Shared.ButtonExamples as Samples;
uses GuiGallery.Pages.Buttons.State as State;
uses GuiGallery.Pages.Buttons.Widgets.ButtonGroup as Group;
uses GuiGallery.Pages.Buttons.Widgets.CopyButton as Copy;
uses GuiGallery.Pages.Buttons.Widgets.DropdownMenu as Dropdown;
uses GuiGallery.Pages.Buttons.Widgets.HoldButton as Hold;
uses GuiGallery.Pages.Buttons.Widgets.SegmentedControl as Segmented;
uses GuiGallery.Shared.State as Demo;
uses System as Sys;

const Row: L.Flow := new L.Flow(Gap := L.Spacing.Normal, Align := L.Alignment.Center);
const Card: L.Flow := new L.Flow(Padding := L.Spacing.Fixed(L.Measure.Logical(24)));

const Stack: L.Flow := new L.Flow(Gap := L.Spacing.Loose);

function Glyph(Code: int): string;
begin
  return Sys.Char.ConvertFromUtf32(Code);
end function;

function IconSample(
  Id: string;
  Code: int;
  Caption: string;
  Style: S.ButtonVariant := S.ButtonVariant.Default;
  Shortcut: string := ''
): E.Element of State.Msg;
begin
  return I.IconButton of State.Msg(
    Id, Glyph(Code), Caption, State.Msg.Preview,
    new I.Options(Variant := Style, Shortcut := Shortcut)
  );
end function;

function Section(Title: string; Description: string := ''): E.Element of State.Msg;
begin
  const Padding: E.Element of State.Msg := E.Size of State.Msg(
    E.Column of State.Msg(), new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(18)))
  );
  const Heading: E.Element of State.Msg := E.Styled of State.Msg(
    E.Text of State.Msg(Title),
    S.Role.Heading
  );
  if Description = '' then
    return E.Column of State.Msg(Padding, Heading);
  end if;

  return E.Column of State.Msg(
    Padding,
    E.Column of State.Msg(
      new L.Flow(Gap := L.Spacing.Tight),
      Heading,
      E.Styled of State.Msg(E.Text of State.Msg(Description), S.Role.Secondary)
    )
  );
end function;

function Panel(Child: E.Element of State.Msg): E.Element of State.Msg;
begin
  return E.Styled of State.Msg(E.Column of State.Msg(Card, Child), S.Role.OutlinedPanel);
end function;

// Builds the accepted examples from the CUI Buttons page.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current gallery model.
// - `Wide`: Whether complete example rows fit side by side.
// ## Returns
// The button variants, sizes, states, group and copy action.
public function View(Model: State.Model; Data: Demo.Model; Wide: bool): E.Element of State.Msg;
begin
  const Sizes: E.Element of State.Msg := Samples.Sizes of State.Msg(State.Msg.Preview);
  const Actions: array of E.Element of State.Msg := Samples.Icons of State.Msg(State.Msg.Preview);
  const CopyIcon: E.Element of State.Msg := IconSample(
    'icon-copy',
    $E09E,
    'Copy',
    Shortcut := 'Ctrl C'
  );
  const Share: E.Element of State.Msg := IconSample('icon-share', $E156, 'Share');
  const Like: E.Element of State.Msg := IconSample(
    'icon-like',
    $E0F2,
    'Like',
    S.ButtonVariant.Outline
  );
  const Delete: E.Element of State.Msg := IconSample(
    'icon-delete',
    $E18E,
    'Delete',
    S.ButtonVariant.Secondary
  );
  const Variants: E.Element of State.Msg := Samples.Variants of State.Msg(State.Msg.Preview, Wide);
  const Icons: E.Element of State.Msg := if Wide then
    E.Row of State.Msg(
      Row,
      Actions[0],
      Actions[1],
      Actions[2],
      CopyIcon,
      Share,
      Like,
      Delete
    )
  else
    E.Column of State.Msg(
      Stack,
      E.Row of State.Msg(Row, Actions[0], Actions[1]),
      E.Row of State.Msg(Row, Actions[2], CopyIcon, Share, Like, Delete)
    )
  end if;
  const States: E.Element of State.Msg := Samples.States of State.Msg(
    State.Msg.Preview,
    Wide,
    Model.ButtonLoading,
    State.Msg.SetButtonLoading
  );
  const GroupAndCopy: E.Element of State.Msg := if Wide then
    E.Row of State.Msg(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(12))),
      Group.View(Model, Data),
      Copy.View(),
      Hold.View(Model, Data)
    )
  else
    E.Column of State.Msg(Stack, Group.View(Model, Data), Copy.View(), Hold.View(Model, Data))
  end if;

  return E.Column of State.Msg(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(20))),
    Section('Variants', 'One primary action per view. Secondary for everything else.'),
    Panel(Variants),
    Section('Sizes and icons'),
    Panel(E.Column of State.Msg(Stack, Sizes, Icons)),
    Section('States', 'Loading keeps the label so the layout does not jump.'),
    Panel(States),
    Section(
      'Groups, copy and hold to confirm',
      'Hold the button until it fills to confirm a destructive action.'
    ),
    Panel(GroupAndCopy),
    Section('Segmented control', 'A highlight glides to the selected option.'),
    Panel(Segmented.View(Model, Data)),
    Section('Dropdown menu'),
    Panel(Dropdown.View())
  );
end function;

end unit;
