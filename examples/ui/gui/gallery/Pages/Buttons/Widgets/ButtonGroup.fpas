// [Documentation](../../../../../../../docs/ui/gui/actions/button-group.md)

unit GuiGallery.Pages.Buttons.Widgets.ButtonGroup;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Actions.ButtonGroups as Groups;
uses Fpas.Ui.Widgets.Actions.Buttons as B;

uses GuiGallery.Pages.Buttons.State as State;
uses System as Sys;

function FormatButton(Id: string; Label: string; Icon: int): E.Element of State.Msg;
begin
  return B.Button of State.Msg(
    Id, Label, State.Msg.Preview, new B.Options(Icon := Sys.Char.ConvertFromUtf32(Icon))
  );
end function;

// Displays three preview buttons inside one outline.
//
// ## Returns
// The gallery's formatting group.
public function View(): E.Element of State.Msg;
begin
  return Groups.ButtonGroup of State.Msg(
    FormatButton('format-bold', 'Bold', $E05D),
    FormatButton('format-italic', 'Italic', $E0FB),
    FormatButton('format-underline', 'Underline', $E19A)
  );
end function;

end unit;
