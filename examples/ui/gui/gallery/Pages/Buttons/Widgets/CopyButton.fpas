// [Documentation](../../../../../../../docs/ui/gui/actions/copy-button.md)

unit GuiGallery.Pages.Buttons.Widgets.CopyButton;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.CopyButtons as Copy;

uses GuiGallery.Pages.Buttons.State as State;

// Displays a command with a copy action.
//
// ## Returns
// The gallery's copy-button example.
public function View(): E.Element of State.Msg;
begin
  const Command: string := 'npm i cui';
  return E.Styled of State.Msg(
    E.Row of State.Msg(
      new L.Flow(Gap := L.Spacing.Tight, Padding := L.Spacing.Tight, Align := L.Alignment.Center),
      E.Text of State.Msg(Command),
      Copy.CopyButton of State.Msg('copy-install', Command)
    ),
    S.Role.MutedPanel
  );
end function;

end unit;
