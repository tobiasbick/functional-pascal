// [Documentation](../../../../../../../docs/ui/gui/actions/dropdown-menu.md)

unit GuiGallery.Pages.Buttons.Widgets.DropdownMenu;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Overlays.Menus as M;
uses Gallery.Shared.ProjectOptions as Options;
uses GuiGallery.Pages.Buttons.State as State;
uses GuiGallery.Shared.State as Demo;
uses System as Sys;

function Icon(Code: int): string;
begin
  return Sys.Char.ConvertFromUtf32(Code);
end function;

// Clones both dropdown examples on CUI's Buttons page.
// ## Returns
// Options with sections, hints and a danger command, plus the icon-only More actions menu.
public function View(): E.Element<State.Msg>;
begin
  return E.Row<State.Msg>(
    new L.Flow(Gap := L.Spacing.Normal),
    Options.View<State.Msg>(
      function(Name: string): State.Msg => State.Msg.Shared(Demo.Msg.MenuChoice(Name)),
      State.Msg.OpenDeleteDialog
    ),
    M.Menu<State.Msg>(
      'more-actions', 'More actions', [
        M.Entry<State.Msg>.Action(
          new M.Item<State.Msg>(
            'archive',
            'Archive',
            State.Msg.Shared(Demo.Msg.MenuChoice('Archive')),
            Icon($E041)
          )
        ),
        M.Entry<State.Msg>.Action(
          new M.Item<State.Msg>(
            'export',
            'Export',
            State.Msg.Shared(Demo.Msg.MenuChoice('Export')),
            Icon($E0B2)
          )
        )
      ], new M.Options(Icon := Icon($E0B6), IconOnly := true)
    )
  );
end function;

end unit;
