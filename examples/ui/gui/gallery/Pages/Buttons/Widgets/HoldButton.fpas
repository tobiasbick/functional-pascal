unit GuiGallery.Pages.Buttons.Widgets.HoldButton;

uses
  GuiGallery.Shared.State as Demo,
  GuiGallery.Pages.Buttons.State as State,
  Fpas.Ui.Elements as E,
  Fpas.Ui.HoldButtons as Holds,
  System as Sys;

// Shows the CUI hold-to-confirm demo with a harmless confirmation counter.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Retained gallery state.
// ## Returns
// A hold button and any completed confirmation count.
public function View(Model: State.Model; Data: Demo.Model): E.Element<State.Msg>;
begin
  const Button: E.Element<State.Msg> := Holds.HoldButton<State.Msg>(
    'hold-delete', 'Hold to delete', State.Msg.ConfirmHold,
    new Holds.Options(Icon := Sys.Char.ConvertFromUtf32($E18E), TerminalIcon := '×')
  );
  if Model.HoldCount = 0 then
    return Button;
  end if;

  return E.Column<State.Msg>(Button, E.Text<State.Msg>('Confirmed: ' + Model.HoldCount.ToString()));
end function;
end unit;
