unit GuiGallery.Pages.Buttons.Widgets.SegmentedControl;

uses
  GuiGallery.Shared.State as Demo,
  GuiGallery.Pages.Buttons.State as State,
  Fpas.Ui.Widgets.Actions.SegmentedControls as S,
  Fpas.Ui.Widgets.Actions.Buttons as B,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L,
  System as Sys;

// Clones CUI's medium icon choices and compact date-range example.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current model-owned selection indices.
// ## Returns
// The two native selectors, with the upstream card's 16-point gap.
public function View(Model: State.Model; Data: Demo.Model): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(16))),
    S.SegmentedControl<State.Msg>(
      'view', [
        new S.Item('List', Sys.Char.ConvertFromUtf32($E106)),
        new S.Item('Board', Sys.Char.ConvertFromUtf32($E1C1)),
        new S.Item('Timeline', Sys.Char.ConvertFromUtf32($E1F5))
      ], Model.SegmentedView, State.Msg.SetSegmentedView
    ),
    S.SegmentedControl<State.Msg>(
      'range', [
        new S.Item('Day'), new S.Item('Week'),
        new S.Item('Month'), new S.Item('Year')
      ], Model.SegmentedRange, State.Msg.SetSegmentedRange,
      new S.Options(ControlSize := B.Size.Small)
    )
  );
end function;

end unit;
