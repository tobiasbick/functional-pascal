// [Documentation](../../../../../../docs/ui/gui/capture/README.md)

unit GuiGallery.Pages.Capture.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Files.AvatarUploads as A;
uses Fpas.Ui.Widgets.Files.Dropzones as D;
uses Fpas.Ui.Widgets.Files.SignaturePads as P;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Capture.State as C;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;
uses System.Collections.Generic as Lists;

function Target(Id: string; Settings: D.Options): E.Element of C.Msg;
begin
  return D.Dropzone of C.Msg(
    Id,
    if Settings.Compact then
      function(Paths: array of string): C.Msg => C.Msg.CompactDrop
    else
      C.Msg.Dropped
    end if,
    Settings := Settings
  );
end function;

function Box(Child: E.Element of C.Msg; Width: L.Extent): E.Element of C.Msg;
begin
  return E.Size of C.Msg(
    E.Column of C.Msg(new L.Flow(Clip := false), Child),
    new L.Flex(Width := new L.AxisSize(Basis := Width))
  );
end function;

// Displays the original Capture examples in their gallery order.
// ## Parameters
// - `Model`: Current file selections.
// ## Returns
// The direct children of the three sections.
public function View(Model: C.Model): array of E.Element of C.Msg;
begin
  const Children: array of E.Element of C.Msg := [
    G.Heading of C.Msg(Strings.Get('Heading.Dropzone'), Strings.Get('Heading.DropzoneHint')),
    Target(
      'capture-files',
      new D.Options(Description := 'PNG, JPG or PDF, up to 25 MB', Accept := C.Files)
    ),
    E.Row of C.Msg(
      new L.Flow(Gap := G.Points(12), Wrap := true, Clip := false),
      Box(
        Target(
          'capture-attach',
          new D.Options(Title := 'Attach a file', Description := 'Any type', Compact := true)
        ),
        L.Extent.Fill
      ),
      Box(
        Target(
          'capture-images', new D.Options(
            Title := 'Add images',
            Description := 'PNG or JPG',
            Icon := Sys.Char.ConvertFromUtf32($E0F6),
            Accept := C.Images,
            Compact := true
          )
        ),
        L.Extent.Fill
      )
    )
  ];
  const Remaining: array of E.Element of C.Msg := [
    G.Heading of C.Msg(
      Strings.Get('Heading.AvatarUpload'),
      Strings.Get('Heading.AvatarUploadHint')
    ),
    E.Row of C.Msg(
      new L.Flow(Gap := G.Points(20), Align := L.Alignment.Center, Clip := false),
      A.AvatarUpload of C.Msg(
        'capture-avatar',
        'Maya Okafor',
        Model.Avatar,
        C.Msg.SetAvatar
      ),
      E.Column of C.Msg(
        new L.Flow(Gap := G.Points(4), Clip := false),
        Texts.Text of C.Msg('Profile photo', Texts.Appearance.Label),
        Texts.Text of C.Msg('At least 256 by 256 pixels.', Texts.Appearance.Secondary)
      )
    ),
    G.Heading of C.Msg(
      Strings.Get('Heading.Signature'),
      Strings.Get('Heading.SignatureHint')
    ),
    Box(
      P.SignaturePad of C.Msg('capture-signature', Settings := new P.Options(Height := 180.0F)),
      L.Extent.Fixed(L.Measure.Logical(520))
    )
  ];
  const Parts: Lists.List of E.Element of C.Msg := new Lists.List of E.Element of C.Msg(Children);
  if Model.Last <> '' then
    Parts.Add(Texts.Text of C.Msg(Model.Last, Texts.Appearance.Muted));
  end if;

  Parts.AddRange(Remaining);
  return Parts.ToArray();
end function;

end unit;
