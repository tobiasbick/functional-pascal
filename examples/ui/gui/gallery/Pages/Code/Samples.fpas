unit GuiGallery.Pages.Code.Samples;

uses Fpas.Ui.Widgets.Developer.LogConsoles as Log, System as Sys;

function Lines(Values: array of string): string;
begin
  const Result: Sys.Text.StringBuilder := new Sys.Text.StringBuilder();
  for Index: int := 0 to Values.Length - 1 do
    if Index > 0 then
      discard Result.Append(cast<char>(10));
    end if;

    discard Result.Append(Values[Index]);
  end for;

  return Result.ToString();
end function;

// Original release notes with links and tasks.
public const Notes: string := Lines(
  [
    '## Tern 2.4 release notes',
    '',
    'The ~~beta~~ sync engine is now the default. It batches writes, so **a 2,000 item import takes 3.1 s** instead of 14 s. Run `tern migrate` once after updating; the [upgrade guide](https://tern.dev/docs/upgrade) lists every *breaking* change.',
    '',
    '### What changed',
    '',
    '- The offline banner waits 2 s before it appears',
    '  - It no longer flickers on a slow network',
    '  - Retry keeps your scroll position',
    '- Attachments upload in the background',
    '',
    '### Before you ship',
    '',
    '- [x] Update the changelog',
    '- [ ] Rerun the sync benchmark on Android',
    '- [ ] Tag the release',
    '',
    '> Builds made before March 4 still read the old cache format, but they write the new one.',
    '',
    '```c',
    'int sync_flush(sync_queue *q) {',
    '    if (q->count == 0) return 0;   /* nothing to send */',
    '    return send_batch(q->items, q->count);',
    '}',
    '```',
    '',
    '| Platform | Cold start | vs 2.3 |',
    '|:---------|-----------:|:------:|',
    '| macOS | 412 ms | -18% |',
    '| Windows | 498 ms | -11% |',
    '| Android | 731 ms | -9% |',
    ''
  ]
);

// Original editable C tile cache.
public const Code: string := Lines(
  [
    '/* tile_cache.c: a small LRU cache of decoded map tiles */',
    '#include <stdint.h>',
    '#include <stdlib.h>',
    '#include <string.h>',
    '',
    '#define CACHE_SLOTS 64',
    '',
    'typedef struct {',
    '    uint32_t key;           /* zoom << 24 | y << 12 | x */',
    '    uint32_t last_used;',
    '    uint8_t *pixels;',
    '} tile;',
    '',
    'static tile cache[CACHE_SLOTS];',
    'static uint32_t clock_now;',
    '',
    'static uint32_t tile_key(int zoom, int x, int y) {',
    '    return (uint32_t)zoom << 24 | (uint32_t)y << 12 | (uint32_t)x;',
    '}',
    '',
    'tile *tile_get(int zoom, int x, int y) {',
    '    uint32_t key = tile_key(zoom, x, y);',
    '    tile *oldest = &cache[0];',
    '    for (int i = 0; i < CACHE_SLOTS; i++) {',
    '        if (cache[i].key == key && cache[i].pixels) {',
    '            cache[i].last_used = ++clock_now;',
    '            return &cache[i];',
    '        }',
    '        if (cache[i].last_used < oldest->last_used) oldest = &cache[i];',
    '    }',
    '    /* miss: reuse the least recently used slot */',
    '    free(oldest->pixels);',
    '    oldest->pixels = decode_tile(zoom, x, y);',
    '    oldest->key = key;',
    '    oldest->last_used = ++clock_now;',
    '    return oldest;',
    '}',
    '',
    'void tile_cache_clear(void) {',
    '    for (int i = 0; i < CACHE_SLOTS; i++) free(cache[i].pixels);',
    '    memset(cache, 0, sizeof cache);',
    '}',
    ''
  ]
);

// Previous source in the original diff specimen.
public const DiffBefore: string := Lines(
  [
    '#include <stdio.h>',
    '#include <stdlib.h>',
    '#include <string.h>',
    '',
    '#include "config.h"',
    '',
    '#define LINE_MAX 256',
    '',
    'static void trim(char *s) {',
    '    size_t n = strlen(s);',
    '    while (n > 0 && (s[n - 1] == ''\n'' || s[n - 1] == '' '')) s[--n] = ''\0'';',
    '}',
    '',
    'static int parse_line(const char *line, char *key, char *value) {',
    '    const char *eq = strchr(line, ''='');',
    '    if (!eq) return 0;',
    '    size_t n = (size_t)(eq - line);',
    '    memcpy(key, line, n);',
    '    key[n] = ''\0'';',
    '    strcpy(value, eq + 1);',
    '    trim(value);',
    '    return 1;',
    '}',
    '',
    'int config_load(config *cfg, const char *path) {',
    '    FILE *f = fopen(path, "r");',
    '    char buf[LINE_MAX];',
    '    int count = 0;',
    '    while (fgets(buf, sizeof buf, f)) {',
    '        char key[LINE_MAX], value[LINE_MAX];',
    '        if (buf[0] == ''#'') continue;',
    '        if (!parse_line(buf, key, value)) continue;',
    '        /* keys from version 1 used dashes */',
    '        for (char *p = key; *p; p++)',
    '            if (*p == ''-'') *p = ''_'';',
    '        config_set(cfg, key, value);',
    '        count++;',
    '    }',
    '    fclose(f);',
    '    return count;',
    '}',
    '',
    'void config_free(config *cfg) {',
    '    for (int i = 0; i < cfg->count; i++) {',
    '        free(cfg->keys[i]);',
    '        free(cfg->values[i]);',
    '    }',
    '    free(cfg->keys);',
    '    free(cfg->values);',
    '    cfg->count = 0;',
    '}',
    ''
  ]
);

// Revised source in the original diff specimen.
public const DiffAfter: string := Lines(
  [
    '#include <stdio.h>',
    '#include <stdlib.h>',
    '#include <string.h>',
    '',
    '#include "config.h"',
    '#include "log.h"',
    '',
    '#define LINE_MAX 256',
    '',
    'static void trim(char *s) {',
    '    size_t n = strlen(s);',
    '    while (n > 0 && (s[n - 1] == ''\n'' || s[n - 1] == '' '')) s[--n] = ''\0'';',
    '}',
    '',
    'static int parse_line(const char *line, char *key, char *value) {',
    '    const char *eq = strchr(line, ''='');',
    '    if (!eq || eq == line) return 0;',
    '    size_t n = (size_t)(eq - line);',
    '    memcpy(key, line, n);',
    '    key[n] = ''\0'';',
    '    snprintf(value, LINE_MAX, "%s", eq + 1);',
    '    trim(value);',
    '    return 1;',
    '}',
    '',
    'int config_load(config *cfg, const char *path) {',
    '    FILE *f = fopen(path, "r");',
    '    if (!f) {',
    '        log_error("cannot open %s", path);',
    '        return -1;',
    '    }',
    '    char buf[LINE_MAX];',
    '    int loaded = 0;',
    '    while (fgets(buf, sizeof buf, f)) {',
    '        char key[LINE_MAX], value[LINE_MAX];',
    '        if (buf[0] == ''#'') continue;',
    '        if (!parse_line(buf, key, value)) continue;',
    '        config_set(cfg, key, value);',
    '        loaded++;',
    '    }',
    '    fclose(f);',
    '    return loaded;',
    '}',
    '',
    'void config_free(config *cfg) {',
    '    for (int i = 0; i < cfg->count; i++) {',
    '        free(cfg->keys[i]);',
    '        free(cfg->values[i]);',
    '    }',
    '    free(cfg->keys);',
    '    free(cfg->values);',
    '    cfg->count = 0;',
    '}',
    ''
  ]
);

