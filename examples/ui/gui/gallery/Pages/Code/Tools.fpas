// [Documentation](../../../../../../docs/ui/gui/code/README.md)

unit GuiGallery.Pages.Code.Tools;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as Graphics;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Actions.IconButtons as I;
uses Fpas.Ui.Widgets.Actions.SegmentedControls as Seg;
uses Fpas.Ui.Widgets.Developer.DiffViews as Diff;
uses Fpas.Ui.Widgets.Developer.HexViews as Hex;
uses Fpas.Ui.Widgets.Developer.LogConsoles as Log;
uses Fpas.Ui.Widgets.Display.Markdowns as Markdown;
uses Fpas.Ui.Widgets.Editors.CodeEditors as Editor;
uses Fpas.Ui.Widgets.Inputs.TextFields as Field;
uses Fpas.Ui.Widgets.Theming.Themes as Theme;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Code.Samples as Sample;
uses GuiGallery.Pages.Code.State as M;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;
uses System.Linq as Linq;

function Join(
  First: array of E.Element of M.Msg;
  Second: array of E.Element of M.Msg
): array of E.Element of M.Msg;
begin
  return Linq.Enumerable.ToArray of E.Element of M.Msg(
    Linq.Enumerable.Concat of E.Element of M.Msg(First, Second)
  );
end function;

function ReleaseNotes(Model: M.Model; Colors: Theme.Palette): E.Element of M.Msg;
begin
  const Streaming: bool := Model.Replay >= 0;
  const Visible: string := if Streaming then
    Model.Notes.Substring(0, Model.Replay)
  else
    Model.Notes
  end if;
  return E.Size of M.Msg(
    E.Column of M.Msg(
      new L.Flow(Gap := G.Points(16), Clip := false),
      Markdown.Markdown of M.Msg(
        'markdown-notes',
        Visible,
        M.Msg.Markdown,
        new Markdown.Options(Streaming := Streaming)
      ),
      E.Divider of M.Msg(),
      E.Row of M.Msg(
        new L.Flow(Gap := G.Points(12), Align := L.Alignment.Center, Wrap := true, Clip := false),
        B.Button of M.Msg(
          'markdown-replay', 'Replay as a stream', M.Msg.Replay,
          new B.Options(ControlSize := B.Size.Small, Icon := Sys.Char.ConvertFromUtf32($E13C))
        ),
        E.FormattedText of M.Msg(
          if Model.NotesStatus = '' then
            if Model.NotesHover = '' then
              'Click a link or a task box'
            else
              Model.NotesHover
            end if
          else
            Model.NotesStatus
          end if,
          Graphics.Font.Body, 12.5F, Colors.TextSecondary
        )
      )
    ),
    new L.Flex(Width := new L.AxisSize(Basis := L.Extent.Fill, Maximum := L.Measure.Logical(640)))
  );
end function;

function EditCode(Model: M.Model; Colors: Theme.Palette): E.Element of M.Msg;
begin
  const Status: E.Element of M.Msg := E.Row of M.Msg(
    new L.Flow(Gap := G.Points(16), Align := L.Alignment.Center, Wrap := true, Clip := false),
    E.Text of M.Msg('Ln ' + Model.Line.ToString() + ', Col ' + Model.Column.ToString()),
    E.Text of M.Msg(Model.Lines.ToString() + ' lines'),
    E.FormattedText of M.Msg('Spaces: 4', Graphics.Font.Body, 12.5F, Colors.TextMuted)
  );
  const Warnings: array of E.Element of M.Msg := if Model.Full then
    [E.FormattedText of M.Msg('Buffer full', Graphics.Font.Body, 12.5F, Colors.Danger)]
  else
    []
  end if;
  return E.Column of M.Msg(
    new L.Flow(Gap := G.Points(10), Clip := false),
    Join(
      [
        Editor.CodeEditor of M.Msg(
          'code-editor', Model.Source, M.Msg.Code,
          new Editor.Options(Language := 'c', Height := 356.0F, Placeholder := 'Write some C')
        ),
        Status
      ], Warnings
    )
  );
end function;

function DiffToolbar(Model: M.Model; Colors: Theme.Palette): E.Element of M.Msg;
begin
  const Size: I.Size := I.Size.Small;
  const Caption: string := if Model.Change >= 0 then
    'Change ' + (Model.Change + 1).ToString() + ' of ' +
    Model.Changes.ToString()
  else
    Model.Changes.ToString() + ' changes'
  end if;
  const Mode: E.Element of M.Msg := Seg.SegmentedControl of M.Msg(
    'diff-mode', [new Seg.Item('Split'), new Seg.Item('Inline')],
    if Model.Inline then
      1
    else
      0
    end if, M.Msg.Mode, new Seg.Options(ControlSize := B.Size.Small)
  );
  const Parts: array of E.Element of M.Msg := if Model.ActualInline and not Model.Inline then
    [
      Mode,
      E.FormattedText of M.Msg(
        'Inline on narrow screens',
        Graphics.Font.Body,
        12.5F,
        Colors.TextMuted
      )
    ]
  else
    [Mode]
  end if;
  return E.Row of M.Msg(
    new L.Flow(Gap := G.Points(8), Align := L.Alignment.Center, Wrap := true, Clip := false),
    Join(
      Parts, [
        E.Size of M.Msg(E.Column of M.Msg(), new L.Flex(Basis := L.Extent.Fill)),
        E.Row of M.Msg(
          new L.Flow(Gap := G.Points(4), Align := L.Alignment.Center, Clip := false),
          E.Styled of M.Msg(
            E.FormattedText of M.Msg(Caption, Graphics.Font.Body, 12.5F, Colors.TextSecondary),
            S.Role.Tabular
          ),
          E.Gap of M.Msg(L.Measure.Logical(4)),
          I.IconButton of M.Msg(
            'diff-previous',
            Sys.Char.ConvertFromUtf32($E04A),
            'Previous change',
            M.Msg.Navigate(-1),
            new I.Options(ControlSize := Size, Enabled := Model.Change > 0, Shortcut := 'P')
          ),
          I.IconButton of M.Msg(
            'diff-next', Sys.Char.ConvertFromUtf32($E042), 'Next change', M.Msg.Navigate(1),
            new I.Options(
              ControlSize := Size,
              Enabled := Model.Change < Model.Changes - 1,
              Shortcut := 'N'
            )
          )
        )
      ]
    )
  );
end function;

function CompareFiles(Model: M.Model; Colors: Theme.Palette): E.Element of M.Msg;
begin
  return E.Column of M.Msg(
    new L.Flow(Gap := G.Points(16), Clip := false),
    DiffToolbar(Model, Colors),
    Diff.DiffView of M.Msg(
      'diff', Sample.DiffBefore, Sample.DiffAfter, Model.Change, M.Msg.Diff,
      new Diff.Options(
        Height := 372.0F,
        Language := 'c',
        OldTitle := 'config.c (main)',
        NewTitle := 'config.c',
        Inline := Model.Inline
      )
    )
  );
end function;

function InspectBytes(Model: M.Model; Colors: Theme.Palette): E.Element of M.Msg;
begin
  const Selection: Hex.Selection := Model.Selection;
  const Status: string := if Selection.Length > 0 then
    Selection.Start.ToString(
      'X4'
    ) + ' to ' + (Selection.Start + Selection.Length - 1).ToString('X4') +
    ', ' + Selection.Length.ToString() + (if Selection.Length = 1 then
      ' byte selected'
    else
      ' bytes selected'
    end if)
  else
    'Cursor at ' + Selection.Cursor.ToString('X4')
  end if;
  const Offset: E.Element of M.Msg := E.Size of M.Msg(
    Field.TextField of M.Msg(
      'hex-offset', Model.Offset, M.Msg.Offset,
      new Field.Options(Placeholder := 'Go to offset', ControlSize := B.Size.Small),
      function(Text: string): M.Msg => M.Msg.GoTo(Text)
    ),
    new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(150)))
  );
  const Tags: array of E.Element of M.Msg := if Model.Edited = '' then
    []
  else
    [
      E.Styled of M.Msg(
        E.FormattedText of M.Msg(Model.Edited, Graphics.Font.Body, 12.5F, Colors.TextMuted),
        S.Role.Tabular
      )
    ]
  end if;
  return E.Column of M.Msg(
    new L.Flow(Gap := G.Points(12), Clip := false),
    Hex.HexView of M.Msg(
      'hex', Model.Bytes, Selection, M.Msg.Hex, new Hex.Options(
        Height := 300.0F, Editable := true, GoTo := Model.Jump,
        Marks := [
          new Hex.Mark(0, 8, S.Tone.Info, 'PNG signature'),
          new Hex.Mark(8, 25, S.Tone.Violet, 'IHDR chunk, 1280 by 720 RGBA'),
          new Hex.Mark(33, 28, S.Tone.Teal, 'tEXt chunk, Software')
        ]
      )
    ),
    E.Row of M.Msg(
      new L.Flow(Gap := G.Points(12), Align := L.Alignment.Center, Wrap := true, Clip := false),
      Join(
        [
          Offset,
          E.Styled of M.Msg(
            E.FormattedText of M.Msg(Status, Graphics.Font.Body, 12.5F, Colors.TextSecondary),
            S.Role.Tabular
          )
        ],
        Tags
      )
    )
  );
end function;

// Reuses the native CUI component specimens on the Code page.
// ## Parameters
// - `Model`: Current Code state.
// - `Colors`: Active theme colors.
// ## Returns
// The interactive Code extensions in their gallery order.
public function View(Model: M.Model; Colors: Theme.Palette): array of E.Element of M.Msg;
begin
  return [
    G.Heading of M.Msg(Strings.Get('Heading.Markdown')), ReleaseNotes(Model, Colors),
    G.Heading of M.Msg(Strings.Get('Heading.CodeEditor')), EditCode(Model, Colors),
    G.Heading of M.Msg(Strings.Get('Heading.SqlEditor')),
    Editor.CodeEditor of M.Msg(
      'sql-editor', Model.Sql, M.Msg.Sql,
      new Editor.Options(Language := 'sql', Height := 128.0F)
    ),
    G.Heading of M.Msg(Strings.Get('Heading.DiffViewer')), CompareFiles(Model, Colors),
    G.Heading of M.Msg(Strings.Get('Heading.HexViewer')), InspectBytes(Model, Colors),
    G.Heading of M.Msg(Strings.Get('Heading.LogConsole')),
    Log.LogConsole of M.Msg(
      'log-console',
      Model.Entries,
      M.Msg.Clear,
      new Log.Options(Height := 352.0F, Timestamps := true)
    )
  ];
end function;

end unit;
