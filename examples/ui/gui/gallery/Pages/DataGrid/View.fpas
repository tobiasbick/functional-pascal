unit GuiGallery.Pages.DataGrid.View;

uses
  GuiGallery.Pages.DataGrid.State as S, GuiGallery.Pages.DataGrid.People as P,
  GuiGallery.Shared.Sections as H, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L,
  Fpas.Ui.Widgets.Collections.FilterBars as F, Fpas.Ui.Widgets.Collections.DataGrids as D, Fpas.Ui.Widgets.Collections.Tables as T, Fpas.Ui.Widgets.Collections.TreeTables as TT,
  Fpas.Ui.Widgets.Media.Avatars as A, Fpas.Ui.Widgets.Feedback.Badges as B, Fpas.Ui.Widgets.Feedback.ProgressBars as Progress, Fpas.Ui.Styles as Style,
  System as Sys, System.Globalization as Culture, System.Collections.Generic as Lists;

function Points(Value: int): L.Extent;
begin
  return L.Extent.Fixed(L.Measure.Logical(Value));
end function;

function Filter(Model: S.Model): E.Element<S.Msg>;
begin
  return F.FilterBar<S.Msg>(
    'filters', [
      new F.Field('Team', ['Engine', 'Design', 'Platform', 'Docs', 'Growth'], P.Icon($E1A4)),
      new F.Field('Status', ['Active', 'Away', 'Invited'], P.Icon($E345)),
      new F.Field('Role', ['Owner', 'Admin', 'Member'], P.Icon($E4A3))
    ], Model.Filter, S.Msg.SetFilter, 64
  );
end function;

function GridRow(Model: S.Model; Position: int): D.Row<S.Msg>;
begin
  const Source: int := Model.Order[Position];
  const Id: string := 'grid-person-' + Source.ToString(Culture.CultureInfo.InvariantCulture);
  const Person: P.Person := P.At(Source);
  const Name: string := P.Name(Model.Names, Source, Person.Name);
  const Score: float := cast<float>(Person.Score) / 10.0F;
  return new D.Row<S.Msg>(
    Id, [
      D.Cell<S.Msg>.Editable(
        Name, 48, function(Value: string): S.Msg => S.Msg.Rename(Source, Value),
        [A.Avatar<S.Msg>(Id + '/avatar', Name, new A.Options(Size := 24.0F))]
      ),
      D.Cell<S.Msg>.Text(Person.Email),
      D.Cell<S.Msg>.Content([B.Badge<S.Msg>(Id + '/team', Person.Team)]),
      D.Cell<S.Msg>.Text(Person.Commits.ToString(Culture.CultureInfo.InvariantCulture)),
      D.Cell<S.Msg>.Content(
        [
          Progress.ProgressBar<S.Msg>(
            Id + '/score', Score / 100.0F,
            new Progress.Options(Height := 5.0F, Width := Points(70))
          ),
          E.Styled<S.Msg>(
            E.Styled<S.Msg>(
              E.Styled<S.Msg>(
                E.Text<S.Msg>(Score.ToString('F1', Culture.CultureInfo.InvariantCulture)),
                Style.Role.Secondary
              ),
              Style.Role.SmallBody
            ), Style.Role.Tabular
          )
        ]
      )
    ]
  );
end function;

function OriginalRow(
  Id: string; Label: string; Depth: int; Files: string; Size: string; Icon: int;
  Open: bool? := null; Toggle: Sys.Func<bool, S.Msg>? := null
): T.Row<S.Msg>;
begin
  return new T.Row<S.Msg>(
    Id, [
      T.Cell<S.Msg>.Content(
        [TT.TreeCell<S.Msg>(Id + '/name', Label, Depth, Open, Toggle, P.Icon(Icon))]
      ),
      T.Cell<S.Msg>.Text(Files), T.Cell<S.Msg>.Text(Size)
    ]
  );
end function;

function OriginalTree(Model: S.Model): E.Element<S.Msg>;
begin
  const Rows: Lists.List<T.Row<S.Msg>> := new Lists.List<T.Row<S.Msg>>();
  Rows.Add(
    OriginalRow(
      'source-tree-src',
      'src',
      0,
      '42',
      '1.2 MB',
      $E0D7,
      Model.SourceOpen,
      S.Msg.SetSource
    )
  );
  if Model.SourceOpen then
    Rows.Add(
      OriginalRow('source-tree-ui', 'ui', 1, '18', '640 KB', $E0D7, Model.UiOpen, S.Msg.SetUi)
    );
    if Model.UiOpen then
      Rows.Add(OriginalRow('source-tree-button', 'button.c', 2, '1', '24 KB', $E0C0));
    end if;

    Rows.Add(OriginalRow('source-tree-main', 'main.c', 1, '1', '8 KB', $E0C0));
  end if;

  Rows.Add(OriginalRow('source-tree-readme', 'README.md', 0, '1', '12 KB', $E0CC));
  return T.Table<S.Msg>(
    'source-tree', [
      new T.Column('Name'), new T.Column('Files', Points(80), Align := T.Alignment.Right),
      new T.Column('Size', Points(100), Align := T.Alignment.Right)
    ], Rows.ToArray()
  );
end function;

// Builds the original Data grid page and a standalone tree-table example.
// ## Parameters
// - `Model`: Current demonstration state.
// ## Returns
// Gallery sections in display order.
public function View(Model: S.Model): array of E.Element<S.Msg>;
begin
  const Mask: array of bool := new bool[Model.Order.Length];
  var Any: bool := false;
  for Index: int := 0 to Mask.Length - 1 do
    Mask[Index] := Model.Selected[Model.Order[Index]];
    Any := Any or Mask[Index];
  end for;

  return [
    H.Heading<S.Msg>('Filter bar', 'Chips for active filters, values in a list, and a search.'),
    Filter(Model),
    H.Heading<S.Msg>(
      'Data grid',
      '2,000 rows, virtualized. Sort, resize columns, select with Shift and Ctrl, edit names with a double click.'
    ),
    D.DataGrid<S.Msg>(
      'people-grid', [
        new D.Column('Name', 200.0F, Sortable := true),
        new D.Column('Email', 196.0F),
        new D.Column('Team', 110.0F, Sortable := true),
        new D.Column('Commits', 96.0F, T.Alignment.Right, true),
        new D.Column('Score', 130.0F, T.Alignment.Right, true)
      ], Model.Order.Length, function(Position: int): D.Row<S.Msg> => GridRow(Model, Position),
      Model.Grid with
        Selected := Mask;
      end with, function(Value: D.Value): S.Msg => S.Msg.SetGrid(Value, Model.Order),
      new D.Options(Height := Points(420))
    ),
    E.Styled<S.Msg>(
      E.Text<S.Msg>(
        if Any then
          'Rows selected. Press Esc to clear.'
        else
          'Click a row, Shift+click to select a range, Ctrl+A for all.'
        end if
      ), Style.Role.Caption
    ),
    H.Heading<S.Msg>('Tree table', 'Tree cells inside a table: disclosure, indentation, totals.'),
    OriginalTree(Model),
    H.Heading<S.Msg>(
      'Virtual tree table',
      'Use the arrow keys to navigate and expand. Opening ui loads its children.'
    ),
    TT.TreeTable<S.Msg>(
      'virtual-tree',
      [
        new D.Column('Name', 380.0F),
        new D.Column('Files', 96.0F, T.Alignment.Right, Priority := 1),
        new D.Column('Size', 112.0F, T.Alignment.Right, Priority := 2)
      ],
      Model.TreeNodes,
      Model.TreeCursor,
      null,
      S.Msg.SetTree,
      new TT.Options(Height := Points(240), Guides := true)
    ),
    E.Styled<S.Msg>(
      E.Text<S.Msg>(
        if Model.Activated = '' then
          'Enter opens the selected item.'
        else
          'Opened ' + Model.Activated
        end if
      ), Style.Role.Muted
    )
  ];
end function;

end unit;
