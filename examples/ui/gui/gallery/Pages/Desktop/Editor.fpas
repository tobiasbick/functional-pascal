// [Documentation](../../../../../../docs/ui/gui/host.md#code-editor-commands)

unit GuiGallery.Pages.Desktop.Editor;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Desktop.DocumentTabs as Docs;
uses Fpas.Ui.Widgets.Desktop.MenuBars as Bar;
uses Fpas.Ui.Widgets.Desktop.Toolbars as Tools;
uses Fpas.Ui.Widgets.Motion.Motion as Glyphs;
uses Fpas.Ui.Widgets.Overlays.Menus as M;
uses Fpas.Ui.Widgets.Theming.Themes as Theme;

uses Gallery.Shared.EditorStatus as StatusExample;
uses GuiGallery.Pages.Desktop.State as S;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;
uses System.Collections.Generic as Lists;

function Action(
  Key: string;
  Label: string;
  Hint: string := '';
  Enabled: bool := true;
  Checked: bool := false
): M.Entry of S.Msg;
begin
  return (M.Entry of S.Msg).Action(
    new M.Item of S.Msg(
      Key, Label, S.Msg.Command(Key),
      Shortcut := Hint, Enabled := Enabled, Checked := Checked
    )
  );
end function;

function Menus(Model: S.Model): E.Element of S.Msg;
begin
  return Bar.MenuBar of S.Msg(
    'desktop-menu', [
      new Bar.Menu of S.Msg(
        'file', 'File', [
          Action('new', 'New file', 'Ctrl N'),
          Action('open', 'Open…', 'Ctrl O'),
          (M.Entry of S.Msg).Separator,
          Action(
            'save',
            'Save',
            'Ctrl S'
          ),
          Action('save-as', 'Save as…', 'Ctrl Shift S'),
          (M.Entry of S.Msg).Separator,
          Action('close', 'Close window', 'Ctrl Shift W')
        ]
      ),
      new Bar.Menu of S.Msg(
        'edit', 'Edit', [
          Action('undo', 'Undo', 'Ctrl Z'),
          Action('redo', 'Redo', 'Ctrl Shift Z', false),
          (M.Entry of S.Msg).Separator,
          Action(
            'cut',
            'Cut',
            'Ctrl X'
          ),
          Action('copy', 'Copy', 'Ctrl C'),
          Action('paste', 'Paste', 'Ctrl V'),
          (M.Entry of S.Msg).Separator,
          Action('find', 'Find…', 'Ctrl F')
        ]
      ),
      new Bar.Menu of S.Msg(
        'view', 'View', [
          Action('sidebar', 'Sidebar', Checked := Model.Sidebar),
          Action('minimap', 'Minimap', Checked := Model.Minimap),
          Action('wrap', 'Word wrap', Checked := Model.Wrap), (M.Entry of S.Msg).Separator,
          Action('zoom-in', 'Zoom in', 'Ctrl ='), Action('zoom-out', 'Zoom out', 'Ctrl −')
        ]
      ),
      new Bar.Menu of S.Msg(
        'go', 'Go', [
          Action('go-file', 'Go to file…', 'Ctrl P'), Action('go-line', 'Go to line…', 'Ctrl G')
        ]
      ),
      new Bar.Menu of S.Msg(
        'help',
        'Help',
        [Action('keys', 'Keyboard shortcuts', 'Ctrl K'), Action('notes', 'Release notes')]
      )
    ]
  );
end function;

function Tool(
  Icon: int;
  Tip: string := '';
  Shortcut: string := '';
  Toggle: bool? := null;
  Disabled: bool := false;
  Label: string? := null
): Tools.Item;
begin
  return Tools.Item.Button(
    new Tools.Button(Sys.Char.ConvertFromUtf32(Icon), Label, Tip, Shortcut, Toggle, Disabled)
  );
end function;

function Toolbar(Model: S.Model): E.Element of S.Msg;
begin
  return Tools.Toolbar of S.Msg(
    'desktop-tools', [
      Tool($E13D, 'New file', 'Ctrl N'),
      Tool($E247, 'Open', 'Ctrl O'),
      Tool($E14D, 'Save', 'Ctrl S'),
      Tools.Item.Separator,
      Tool($E2A1, 'Undo', 'Ctrl Z'),
      Tool($E2A0, 'Redo', Disabled := true),
      Tools.Item.Separator,
      Tool(
        $E05D,
        'Bold',
        'Ctrl B',
        Model.Bold
      ),
      Tool($E0FB, 'Italic', 'Ctrl I', Model.Italic),
      Tool($E19A, 'Underline', 'Ctrl U', Model.Underline),
      Tools.Item.Separator,
      Tool($E106, 'Bulleted list', Toggle := Model.List),
      Tool($E102, 'Insert link', 'Ctrl K'),
      Tool($E0F6, 'Insert image'),
      Tools.Item.Spacer,
      Tool(
        $E13C,
        Label := 'Preview'
      ),
      Tool($E156, Label := 'Share')
    ], S.Msg.Tool
  );
end function;

function Statusbar(Model: S.Model; Colors: Theme.Palette): E.Element of S.Msg;
begin
  return E.Column of S.Msg(
    new L.Flow(Background := Colors.SurfaceMuted),
    StatusExample.View of S.Msg(Model.Spaces, Model.Encoding, Model.Language, S.Msg.Command)
  );
end function;

function Code(Colors: Theme.Palette): E.Element of S.Msg;
begin
  const Lines: array of string := StatusExample.CodeLines;
  const Rows: Lists.List of E.Element of S.Msg := new Lists.List of E.Element of S.Msg();
  for Index: int := 0 to Lines.Length - 1 do
    Rows.Add(
      E.Row of S.Msg(
        new L.Flow(Gap := G.Points(18)),
        E.Size of S.Msg(
          E.Column of S.Msg(
            new L.Flow(Align := L.Alignment.End), E.FormattedText of S.Msg(
              (41 + Index).ToString(),
              Glyphs.Font.Mono,
              12.0F,
              Colors.TextMuted
            )
          ),
          new L.Flex(Width := new L.AxisSize(Basis := L.Extent.Fixed(L.Measure.Logical(18))))
        ),
        E.FormattedText of S.Msg(Lines[Index], Glyphs.Font.Mono, 12.0F, Colors.Foreground)
      )
    );
  end for;

  return E.Column of S.Msg(
    new L.Flow(
      Padding := G.Points(14), PaddingStart := G.Points(16),
      PaddingEnd := G.Points(16), Gap := G.Points(3)
    ), Rows.ToArray()
  );
end function;

// Builds the CUI app-chrome documentation example.
// ## Parameters
// - `Model`: Active document, toolbar and status values.
// - `Colors`: Current CUI palette.
// ## Returns
// Editor chrome and sample code.
public function View(Model: S.Model; Colors: Theme.Palette): E.Element of S.Msg;
begin
  return E.Column of S.Msg(
    new L.Flow(Background := Colors.Surface, CornerRadius := 14.0F),
    E.Column of S.Msg(
      new L.Flow(Background := Colors.SurfaceMuted, CornerRadius := 13.0F),
      Menus(Model), Toolbar(Model),
      Docs.DocumentTabs of S.Msg(
        'desktop-documents', Model.Tabs, Model.Selected, S.Msg.Tabs,
        new Docs.Options(Shortcuts := true)
      )
    ),
    Code(Colors), Statusbar(Model, Colors)
  );
end function;

end unit;
