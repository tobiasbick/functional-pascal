// [Documentation](../../../../../../docs/ui/gui/app-chrome/README.md)

unit GuiGallery.Pages.Desktop.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Desktop.SplitViews as Split;
uses Fpas.Ui.Widgets.Theming.Themes as Theme;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Desktop.Editor as Editor;
uses GuiGallery.Pages.Desktop.HostActions as HostActions;
uses GuiGallery.Pages.Desktop.State as S;
uses GuiGallery.Pages.Desktop.Workspace as Workspace;
uses GuiGallery.Shared.Sections as G;

// Builds the native desktop chrome page from CUI's reference examples.
// ## Parameters
// - `Model`: Editor and workspace state.
// - `Colors`: Current CUI palette.
// - `Width`: Window width in logical points.
// ## Returns
// Editor chrome, docking, split view, and host commands.
public function View(Model: S.Model; Colors: Theme.Palette; Width: int): array of E.Element of S.Msg;
begin
  return [
    G.Heading of S.Msg(
      Strings.Get('Page.Desktop'),
      Strings.Get('Text.AppChromeIntro')
    ),
    Editor.View(Model, Colors),
    G.Heading of S.Msg(Strings.Get('Heading.Docking'), Strings.Get('Heading.DockingHint')),
    Workspace.View(Model, Colors, Width < 620),
    G.Heading of S.Msg(Strings.Get('Heading.SplitView'), Strings.Get('Heading.SplitViewHint')),
    Split.SplitView of S.Msg(
      'desktop-split', Model.Ratio,
      E.Column of S.Msg(
        new L.Flow(Padding := G.Points(16), Background := Colors.SurfaceMuted),
        E.Text of S.Msg('Notes')
      ),
      E.Column of S.Msg(
        new L.Flow(Padding := G.Points(16), Background := Colors.Surface),
        E.Text of S.Msg('Selected note')
      ),
      S.Msg.Resize, new Split.Options(
        Height := L.Extent.Fixed(L.Measure.Logical(128)),
        MinimumFirst := 96.0F, MinimumSecond := 120.0F, Vertical := Width < 440
      )
    ),
    G.Heading of S.Msg(Strings.Get('Heading.WindowAndClipboard')),
    HostActions.View(Model)
  ];
end function;

end unit;
