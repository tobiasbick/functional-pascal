const FrameSpans: array of T.Span := [
  new T.Span('Frame', 0.0004, 0.0151, 0, 0, 0U),
  new T.Span('Input', 0.0006, 0.0019, 0, 1, 0U),
  new T.Span('Update', 0.0021, 0.0092, 0, 1, 0U),
  new T.Span('Layout', 0.0094, 0.0121, 0, 1, 0U),
  new T.Span('Paint', 0.0123, 0.0149, 0, 1, 0U),
  new T.Span('Physics', 0.0023, 0.0051, 0, 2, 0U),
  new T.Span('Animation', 0.0053, 0.0068, 0, 2, 0U),
  new T.Span('Scripts', 0.0070, 0.0090, 0, 2, 0U),
  new T.Span('Measure', 0.0095, 0.0108, 0, 2, 0U),
  new T.Span('Record', 0.0124, 0.0139, 0, 2, 0U),
  new T.Span('Submit', 0.0152, 0.0163, 1, 0, 0U),
  new T.Span('Upload', 0.0153, 0.0157, 1, 1, 0U),
  new T.Span('Encode', 0.0157, 0.0162, 1, 1, 0U),
  new T.Span('Decode image', 0.0012, 0.0074, 2, 0, 0U),
  new T.Span('Inflate', 0.0013, 0.0049, 2, 1, 0U),
  new T.Span('Parse JSON', 0.0081, 0.0118, 3, 0, 0U),
  new T.Span('Draw', 0.0164, 0.0166 + 0.0105, 4, 0, 0U)
];

function TraceSpans(): array of T.Span;
begin
  const Values: Lists.List<T.Span> := new Lists.List<T.Span>(3 * FrameSpans.Length);
  for Lane: int := 0 to 4 do
    for Depth: int := 0 to 2 do
      for Frame: int := 0 to 2 do
        const Time: double := Frame * 0.0166;
        for Entry: T.Span in FrameSpans do
          if Entry.Track = Lane and Entry.Depth = Depth then
            Values.Add(
              new T.Span(Entry.Name, Time + Entry.Start, Time + Entry.End, Lane, Depth, 0U)
            );
          end if;
        end for;
      end for;
    end for;
  end for;

  return Values.ToArray();
end function;

// Spans in native track, depth and time order.
public const Spans: array of T.Span := TraceSpans();

// The original selection is the second frame's Update span.
public function SelectedSpan(): int;
begin
  for Index: int := 0 to Spans.Length - 1 do
    if Spans[
      Index
    ].Name = 'Update' and Spans[Index].Start > 0.016 and Spans[Index].Start < 0.03
    then
      return Index;
    end if;
  end for;

  return -1;
end function;

end unit;
