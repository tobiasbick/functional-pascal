// [Documentation](../../../../../../docs/ui/gui/developer-tools/README.md)

unit GuiGallery.Pages.Developer.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as Graphics;
uses Fpas.Ui.Gui.QueryBuilders as NativeQuery;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Developer.CommitGraphs as C;
uses Fpas.Ui.Widgets.Developer.DependencyGraphs as G;
uses Fpas.Ui.Widgets.Developer.KeyValueEditors as K;
uses Fpas.Ui.Widgets.Developer.Keymaps as Keys;
uses Fpas.Ui.Widgets.Developer.NetworkWaterfalls as W;
uses Fpas.Ui.Widgets.Developer.Pipelines as J;
uses Fpas.Ui.Widgets.Developer.ProblemsPanels as P;
uses Fpas.Ui.Widgets.Developer.QueryBuilders as Q;
uses Fpas.Ui.Widgets.Developer.TraceViewers as T;
uses Fpas.Ui.Widgets.Pickers.SchedulePickers as S;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Developer.Samples as D;
uses GuiGallery.Pages.Developer.State as M;
uses GuiGallery.Shared.Sections as Section;

function Limit(
  Maximum: int;
  Gap: int;
  params Children: array of E.Element of M.Msg
): E.Element of M.Msg;
begin
  return E.Size of M.Msg(
    E.Column of M.Msg(new L.Flow(Gap := Section.Points(Gap), Clip := false), Children),
    new L.Flex(
      Width := new L.AxisSize(Basis := L.Extent.Fill, Maximum := L.Measure.Logical(Maximum))
    )
  );
end function;

// Builds the original CUI Developer tools page.
// ## Parameters
// - `Model`: Retained page state.
// - `Palette`: Colors for the sample labels.
// ## Returns
// Sections and examples in the original order.
public function View(Model: M.Model; Palette: Themes.Palette): array of E.Element of M.Msg;
begin
  return [
    Section.Heading of M.Msg(
      Strings.Get('Heading.TraceViewer'),
      Strings.Get('Heading.TraceViewerHint')
    ),
    Limit(
      1000, 10,
      T.TraceViewer of M.Msg(
        'dev-trace',
        Model.Tracks,
        D.Spans,
        D.Markers,
        Model.Timeline,
        Model.Span,
        M.Msg.Trace,
        new T.Options(Height := 320.0F)
      )
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.NetworkWaterfall'),
      Strings.Get('Heading.NetworkWaterfallHint')
    ),
    Limit(
      1000, 10,
      W.NetworkWaterfall of M.Msg(
        'dev-net',
        D.Requests,
        Model.Waterfall,
        M.Msg.Waterfall,
        new W.Options(Height := 340.0F, DomLoaded := 0.395, Loaded := 0.68)
      )
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.DependencyGraph'),
      Strings.Get('Heading.DependencyGraphHint')
    ),
    Limit(
      1000, 10,
      G.DependencyGraph of M.Msg(
        'dev-deps',
        D.Vertices,
        D.Edges,
        Model.Graph,
        M.Msg.Graph,
        new G.Options(Height := 340.0F)
      )
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.CommitGraph'),
      Strings.Get('Heading.CommitGraphHint')
    ),
    Limit(
      920, 10,
      C.CommitGraph of M.Msg(
        'dev-history',
        D.Commits,
        Model.Commit,
        M.Msg.Commit,
        new C.Options(Height := 320.0F)
      )
    ),
    Section.Heading of M.Msg(Strings.Get('Heading.Pipeline'), Strings.Get('Heading.PipelineHint')),
    Limit(
      920, 10,
      J.Pipeline of M.Msg('dev-pipeline', D.Stages, D.Jobs, Model.Pipeline, M.Msg.Pipeline)
    ),
    Section.Heading of M.Msg(Strings.Get('Heading.Problems'), Strings.Get('Heading.ProblemsHint')),
    Limit(
      760, 10,
      P.Problems of M.Msg(
        'dev-problems',
        D.Diagnostics,
        M.Msg.Problems,
        new P.Options(Height := 300.0F)
      )
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.KeyValueEditor'),
      Strings.Get('Heading.KeyValueEditorHint')
    ),
    Limit(
      680, 10,
      E.FormattedText of M.Msg('Headers', Graphics.Font.Medium, 0.0F, Palette.Foreground),
      K.KeyValueEditor of M.Msg(
        'dev-headers',
        Model.Headers,
        M.Msg.Headers,
        new K.Options(Capacity := 12)
      )
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.QueryBuilder'),
      Strings.Get('Heading.QueryBuilderHint')
    ),
    Limit(
      720, 10,
      Q.QueryBuilder of M.Msg(
        'dev-filter',
        D.Fields,
        Model.Rules,
        M.Msg.Query,
        new Q.Options(Capacity := 16)
      ),
      E.FormattedText of M.Msg(
        NativeQuery.Description(D.Fields, Model.Rules),
        Graphics.Font.Body,
        12.0F,
        Palette.TextMuted
      )
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.SchedulePicker'),
      Strings.Get('Heading.SchedulePickerHint')
    ),
    Limit(
      560, 10,
      S.SchedulePicker of M.Msg(
        'dev-backup',
        Model.Cron,
        M.Msg.Schedule,
        new S.Options(Now := 1794211200L, Utc := true)
      )
    ),
    Section.Heading of M.Msg(Strings.Get('Heading.Keymap'), Strings.Get('Heading.KeymapHint')),
    Limit(
      900, 10,
      Keys.Keymap of M.Msg('dev-keys', D.Bindings, D.Categories, Model.Modifiers, M.Msg.Keys)
    )
  ];
end function;

end unit;
