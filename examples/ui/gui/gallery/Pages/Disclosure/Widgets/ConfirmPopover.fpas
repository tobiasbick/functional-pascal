// [Documentation](../../../../../../../docs/ui/gui/disclosure/confirm-popover.md)

unit GuiGallery.Pages.Disclosure.Widgets.ConfirmPopover;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Overlays.ConfirmPopovers as P;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Disclosure.State as State;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;

// Builds the native inline branch-confirmation example.
//
// ## Parameters
// - `Model`: Current confirmation and preview result.
// ## Returns
// The Confirm popover section on the Disclosure page.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  const Trigger: E.Element of State.Msg := B.Button of State.Msg(
    'branch-trigger', 'Delete branch', State.Msg.SetBranchQuestion(true),
    new B.Options(Icon := Sys.Char.ConvertFromUtf32($E18E))
  );
  const Question: E.Element of State.Msg := P.ConfirmPopover of State.Msg(
    'branch-question', Trigger, Model.BranchQuestion,
    new P.Options(
      'Delete feature/grid?', 'The branch and its 12 commits are removed from the remote.',
      ConfirmLabel := 'Delete branch', Danger := true
    ),
    State.Msg.PreviewBranchDeletion, State.Msg.SetBranchQuestion(false)
  );
  const Row: E.Element of State.Msg := if Model.BranchDeleted then
    E.Row of State.Msg(
      new L.Flow(Gap := G.Points(12), Wrap := true), Question,
      E.Styled of State.Msg(E.Text of State.Msg('Branch deleted'), S.Role.Muted)
    )
  else
    E.Row of State.Msg(new L.Flow(Gap := G.Points(12), Wrap := true), Question)
  end if;
  return E.Column of State.Msg(
    new L.Flow(Gap := G.Points(20)),
    G.Heading of State.Msg(
      Strings.Get('Heading.ConfirmPopover'),
      Strings.Get('Heading.ConfirmPopoverHint')
    ),
    Row
  );
end function;

end unit;
