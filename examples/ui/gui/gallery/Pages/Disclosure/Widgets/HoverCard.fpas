unit GuiGallery.Pages.Disclosure.Widgets.HoverCard;

uses
  GuiGallery.Pages.Disclosure.State as State, GuiGallery.Shared.Sections as G,
  Fpas.Ui.Avatars as A, Fpas.Ui.Links as Link, Fpas.Ui.HoverCards as H,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, System as Sys;

function Details(): E.Element<State.Msg>;
begin
  const Copy: E.Element<State.Msg> := E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(4), Clip := false),
    E.Styled<State.Msg>(E.Text<State.Msg>('Jonas Berg'), S.Role.Strong),
    E.Styled<State.Msg>(
      E.Text<State.Msg>('Engineer on the rendering team. Joined March 2024.'),
      S.Role.Secondary
    ),
    E.Column<State.Msg>(
      G.Space<State.Msg>(4),
      E.Row<State.Msg>(
        new L.Flow(Gap := G.Points(6), Wrap := true),
        E.Styled<State.Msg>(E.Text<State.Msg>(Sys.Char.ConvertFromUtf32($E063)), S.Role.MutedGlyph),
        E.Styled<State.Msg>(E.Text<State.Msg>('Usually replies within an hour'), S.Role.Caption)
      )
    )
  );
  return E.Row<State.Msg>(
    new L.Flow(Gap := G.Points(12), Align := L.Alignment.Start, Clip := false),
    A.Avatar<State.Msg>(
      'jonas-avatar',
      'Jonas Berg',
      new A.Options(Size := 44.0F, Status := 'online')
    ),
    E.Size<State.Msg>(Copy, new L.Flex(Basis := L.Extent.Fill))
  );
end function;

// Shows the original assignment link and the native profile card.
// ## Returns
// The Hover card section with CUI-owned pointer timing.
public function View(): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20), Clip := false),
    G.Heading<State.Msg>('Hover card', 'Rest the pointer on a name.'),
    E.Row<State.Msg>(
      new L.Flow(Gap := G.Points(6), Wrap := true),
      E.Text<State.Msg>('Assigned to'),
      H.HoverCard<State.Msg>(
        'jonas-card', Link.Link<State.Msg>('jonas-link', '@jonas', State.Msg.Preview), Details()
      ),
      E.Text<State.Msg>('and due Friday.')
    )
  );
end function;

end unit;
