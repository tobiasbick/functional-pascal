// [Documentation](../../../../../../../docs/ui/gui/disclosure/undo-toast.md)

unit GuiGallery.Pages.Disclosure.Widgets.UndoToast;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.Buttons as B;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Disclosure.State as State;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;

// Builds the original timed Undo toast trigger.
// ## Returns
// The Undo toast section.
public function View(): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading<State.Msg>(Strings.Get('Heading.UndoToast'), Strings.Get('Heading.UndoToastHint')),
    B.Button<State.Msg>(
      'archive-conversations', 'Archive 3 conversations', State.Msg.ArchiveConversations,
      new B.Options(Icon := Sys.Char.ConvertFromUtf32($E041))
    )
  );
end function;

end unit;
