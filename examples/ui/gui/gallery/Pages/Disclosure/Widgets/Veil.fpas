// [Documentation](../../../../../../../docs/ui/gui/disclosure/veil.md)

unit GuiGallery.Pages.Disclosure.Widgets.Veil;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Media.Images as I;
uses Fpas.Ui.Widgets.Motion.Motion as M;
uses Fpas.Ui.Widgets.Overlays.Veils as V;
uses Fpas.Ui.Widgets.Theming.Themes as Theme;

uses GuiGallery.Pages.Canvas.Picture as Picture;
uses GuiGallery.Pages.Disclosure.State as State;
uses GuiGallery.Shared.Sections as G;

function SampleKey(Model: State.Model; Colors: Theme.Palette): E.Element of State.Msg;
begin
  return E.Row of State.Msg(
    new L.Flow(
      Gap := G.Points(8), Align := L.Alignment.Center, Padding := G.Points(8),
      PaddingStart := G.Points(10), PaddingEnd := G.Points(10),
      Background := Colors.SurfaceMuted, CornerRadius := 10.0F, Clip := false
    ),
    E.FormattedText of State.Msg('demo-id-', M.Font.Mono, 12.5F, Colors.TextSecondary),
    E.Size of State.Msg(
      E.Column of State.Msg(
        new L.Flow(Clip := false),
        V.Veil of State.Msg(
          'sample-key', Model.KeyShown, State.Msg.SetKey,
          E.FormattedText of State.Msg('example-value-0000', M.Font.Mono, 12.5F, Colors.Foreground),
          new V.Options(Color := Colors.Surface)
        )
      ),
      new L.Flex(Width := new L.AxisSize(Basis := L.Extent.Fill))
    ),
    B.Button of State.Msg(
      'reveal-sample-key', if Model.KeyShown then
        'Hide'
      else
        'Reveal'
      end if,
      State.Msg.SetKey(not Model.KeyShown), new B.Options(ControlSize := B.Size.Small)
    )
  );
end function;

// Builds the original picture, sample key and spoiler example.
// ## Parameters
// - `Model`: Current reveal state for the examples.
// - `Colors`: Active theme palette.
// ## Returns
// A card containing the three native veils.
public function View(Model: State.Model; Colors: Theme.Palette): E.Element of State.Msg;
begin
  return E.Size of State.Msg(
    E.Styled of State.Msg(
      E.Column of State.Msg(
        new L.Flow(
          Gap := G.Points(12),
          Padding := G.Points(12),
          CornerRadius := 16.0F,
          Clip := false
        ),
        V.Veil of State.Msg(
          'photo', Model.Photo, State.Msg.SetPhoto,
          I.Image of State.Msg(
            'veil-picture', Picture.Result,
            new I.Options(
              Width := L.Extent.Fixed(L.Measure.Logical(234)),
              Height := L.Extent.Fixed(L.Measure.Logical(150)), Radius := 10.0F
            )
          ),
          new V.Options(
            Label := 'Sensitive image',
            Hint := 'Click to show',
            Toggle := true,
            Radius := 10.0F
          )
        ),
        SampleKey(Model, Colors),
        E.Row of State.Msg(
          new L.Flow(Gap := G.Points(4), Wrap := true, Align := L.Alignment.Center, Clip := false),
          E.Text of State.Msg('Finished it last night. The ending:'),
          V.Veil of State.Msg(
            'spoiler',
            Model.Spoiler,
            State.Msg.SetSpoiler,
            E.Text of State.Msg('the keeper was the narrator'),
            new V.Options(Toggle := true, Radius := 4.0F)
          )
        )
      ),
      S.Role.OutlinedPanel
    ),
    new L.Flex(Width := new L.AxisSize(Basis := L.Extent.Fill, Maximum := L.Measure.Logical(420)))
  );
end function;

end unit;
