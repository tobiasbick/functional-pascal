// [Documentation](../../../../../../docs/ui/gui/feedback/README.md)

unit GuiGallery.Pages.Feedback.Update;

uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Widgets.Actions.StatusButtons as Work;

uses GuiGallery.Pages.Feedback.State as S;
uses System as Sys;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

function Complete(Status: Work.Status): Mvu.Command of S.Msg;
  async function Run(Post: function(S.Msg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
  begin
    await Tasks.Task.Delay(2000, Token).ConfigureAwait(false);
    await Post(S.Msg.Finish(Status)).ConfigureAwait(false);
  end function;
begin
  return Mvu.StartBackground of S.Msg(
    'upload',
    Mvu.FromWorker of S.Msg(
      Run,
      function(Error: Sys.Exception): S.Msg => S.Msg.Finish(Work.Status.Error)
    )
  );
end function;

// Applies an upload action to the status spinner demo.
// ## Parameters
// - `Model`: Previous upload state.
// - `Message`: An activation or result.
// ## Returns
// The next state and any upload command.
public function Update(Model: S.Model; Message: S.Msg): Mvu.Transition of (S.Model, S.Msg);
begin
  case Message of
    when S.Msg.Upload:
      if Model.Status = Work.Status.Busy then
        return new Mvu.Transition of (S.Model, S.Msg)(Model, []);
      end if;
      const Runs: int := Model.Runs + 1;
      const Result: Work.Status := if Runs mod 2 = 1 then
        Work.Status.Success
      else
        Work.Status.Error
      end if;
      return new Mvu.Transition of (S.Model, S.Msg)(
        Model with
          Status := Work.Status.Busy;
          Runs := Runs;
        end with, [Complete(Result)]
      );
    when S.Msg.Finish(const Result: Work.Status):
      return new Mvu.Transition of (S.Model, S.Msg)(
        Model with
          Status := Result;
        end with, []
      );
  end case;
end function;

end unit;
