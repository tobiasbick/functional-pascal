// [Documentation](../../../../../../docs/ui/gui/feedback/README.md)

unit GuiGallery.Pages.Feedback.Update;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Widgets.Actions.StatusButtons as Work;

uses GuiGallery.Pages.Feedback.State as S;
uses System as Sys;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

function Complete(Status: Work.Status): Mvu.Command of S.Msg;
  async function Run(
    Context: Mvu.BackgroundContext of S.Msg;
    Token: Threads.CancellationToken
  ): Tasks.Task of Fx.Outcome of (Fx.Completion, S.Msg);
  begin
    try
      await Tasks.Task.Delay(
        Sys.TimeSpan.FromSeconds(2.0),
        Context.Clock,
        Token
      ).ConfigureAwait(false);
      await Context.Post(S.Msg.Finish(Status)).ConfigureAwait(false);
    catch Error: Sys.Exception do
      Token.ThrowIfCancellationRequested();
      return Fx.Outcome.Failure(S.Msg.Finish(Work.Status.Error));
    end try;

    return Fx.Outcome.Success(Fx.Completion.Done);
  end function;
begin
  return Mvu.StartBackground of S.Msg(
    'upload',
    Fx.Effect of (Fx.Completion, S.Msg, Mvu.BackgroundContext of S.Msg).Defer(Run)
  );
end function;

// Applies a Feedback action to the page model.
// ## Parameters
// - `Model`: Previous upload state.
// - `Message`: A dismissal, upload or result.
// ## Returns
// The next state and any upload command.
public function Update(Model: S.Model; Message: S.Msg): Mvu.Transition of (S.Model, S.Msg);
begin
  case Message of
    when S.Msg.DismissStorage:
      return new Mvu.Transition of (S.Model, S.Msg)(
        Model with
          StorageDismissed := true;
        end with, []
      );
    when S.Msg.Upload:
      if Model.Status = Work.Status.Busy then
        return new Mvu.Transition of (S.Model, S.Msg)(Model, []);
      end if;
      const Runs: int := Model.Runs + 1;
      const Result: Work.Status := if Runs mod 2 = 1 then
        Work.Status.Success
      else
        Work.Status.Error
      end if;
      return new Mvu.Transition of (S.Model, S.Msg)(
        Model with
          Status := Work.Status.Busy;
          Runs := Runs;
        end with, [Complete(Result)]
      );
    when S.Msg.Finish(const Result: Work.Status):
      return new Mvu.Transition of (S.Model, S.Msg)(
        Model with
          Status := Result;
        end with, []
      );
  end case;
end function;

end unit;
