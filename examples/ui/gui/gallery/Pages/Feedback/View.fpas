// [Documentation](../../../../../../docs/ui/gui/feedback/README.md)

unit GuiGallery.Pages.Feedback.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Charts.Meters as Meters;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Containers.EmptyStates as Empty;
uses Fpas.Ui.Widgets.Containers.Grids as Grid;
uses Fpas.Ui.Widgets.Feedback.Alerts as A;
uses Fpas.Ui.Widgets.Feedback.ProgressBars as P;
uses Fpas.Ui.Widgets.Feedback.ProgressRings as Rings;
uses Fpas.Ui.Widgets.Feedback.Skeletons as Skel;
uses Fpas.Ui.Widgets.Feedback.Spinners as Spin;
uses Fpas.Ui.Widgets.Planning.TimelineItems as Timeline;

uses Gallery.Shared.ProgressExample as Samples;
uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Feedback.State as Model;
uses GuiGallery.Pages.Feedback.Widgets.BadgesAndAvatars as BadgesAndAvatars;
uses GuiGallery.Pages.Feedback.Widgets.Loading as Loading;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;

// Reproduces the accepted native CUI Feedback examples.
// ## Type parameters
// - `TMsg`: Message type of the containing application.
// ## Parameters
// - `CreateProject`: The empty-state action message.
// - `State`: Current upload state.
// - `Upload`: Starts the status spinner example.
// ## Returns
// Native feedback widgets with their responsive card layout.
public function View of TMsg(
  CreateProject: TMsg;
  State: Model.Model;
  Upload: TMsg
): E.Element of TMsg;
begin
  const Columns: Grid.Options := new Grid.Options(
    Columns := 2,
    MinimumColumnWidth := 260.0F,
    Gap := G.Points(16)
  );
  return E.Column of TMsg(
    new L.Flow(Gap := G.Points(20), Clip := false),
    G.Heading of TMsg(Strings.Get('Heading.Alerts'), Strings.Get('Heading.AlertsHint')),
    E.Column of TMsg(
      new L.Flow(Gap := G.Points(10)),
      A.Alert of TMsg(
        'update', 'A new version is available',
        new A.Options(Description := 'Restart to update to 1.1.')
      ),
      A.Alert of TMsg(
        'payment', 'Payment received',
        new A.Options(Description := 'Your invoice was paid on November 5.', Tone := S.Tone.Success)
      ),
      A.Alert of TMsg(
        'storage', 'Storage almost full',
        new A.Options(
          Description := 'You have used 92% of your plan.',
          Tone := S.Tone.Warning,
          Dismissible := true
        )
      ),
      A.Alert of TMsg(
        'build', 'Build failed',
        new A.Options(
          Description := 'Missing symbol cui_frame in main.c line 42.',
          Tone := S.Tone.Danger
        )
      )
    ),
    Grid.Grid of TMsg(
      Columns,
      Cards.Card of TMsg(
        'progress-card', [
          E.Styled of TMsg(E.Text of TMsg('Progress'), S.Role.Heading),
          Samples.Upload of TMsg(),
          P.ProgressBar of TMsg(
            'index',
            0.0F,
            new P.Options(Label := 'Indexing', Indeterminate := true)
          ),
          Samples.ExportBar of TMsg(true),
          P.ProgressBar of TMsg(
            'sync', 0.0F,
            new P.Options(Label := 'Syncing library', Indeterminate := true, Dither := true)
          ),
          Meters.Meter of TMsg('storage-usage', 'Storage', 18.4F, 20.0F, 'GB'),
          E.Row of TMsg(
            new L.Flow(Gap := G.Points(16), Wrap := true),
            Spin.Spinner of TMsg('spinner-small', 16.0F),
            Spin.Spinner of TMsg('spinner-medium', 22.0F),
            Spin.Spinner of TMsg('spinner-large', 28.0F)
          )
        ], new Cards.Options(Gap := 18.0F)
      ),
      Cards.Card of TMsg(
        'loading-card', [
          E.Styled of TMsg(E.Text of TMsg('Loading'), S.Role.Heading),
          E.Row of TMsg(
            new L.Flow(Gap := G.Points(12), Wrap := true),
            Skel.Skeleton of TMsg('loading-avatar', L.Extent.Fixed(L.Measure.Logical(40)), 40.0F),
            E.Size of TMsg(
              E.Column of TMsg(
                new L.Flow(Gap := G.Points(8)),
                Skel.Skeleton of TMsg('loading-title', L.Extent.Percent(70.0F), 12.0F),
                Skel.Skeleton of TMsg('loading-subtitle', L.Extent.Percent(45.0F), 12.0F)
              ),
              new L.Flex(Basis := L.Extent.Fill)
            )
          ),
          Skel.Skeleton of TMsg('loading-body', Height := 88.0F),
          Skel.Skeleton of TMsg('loading-line-1', L.Extent.Percent(90.0F), 12.0F),
          Skel.Skeleton of TMsg('loading-line-2', L.Extent.Percent(60.0F), 12.0F),
          Loading.Placeholders of TMsg()
        ], new Cards.Options(Gap := 14.0F)
      ),
      Loading.Spinners of TMsg(State, Upload)
    ),
    Grid.Grid of TMsg(
      Columns,
      Cards.Card of TMsg(
        'activity-card', [
          E.Styled of TMsg(E.Text of TMsg('Activity'), S.Role.Heading),
          Timeline.TimelineItem of TMsg(
            'deployed', 'Deployed to production',
            new Timeline.Options(
              Time := '2m ago', Description := 'Release 1.0.3 is live in all regions.',
              Icon := Sys.Char.ConvertFromUtf32($E286), Tone := S.Tone.Success
            )
          ),
          Timeline.TimelineItem of TMsg(
            'review', 'Review requested',
            new Timeline.Options(
              Time := '1h ago', Description := 'Jonas asked you to review the theming changes.',
              Icon := Sys.Char.ConvertFromUtf32($E117), Tone := S.Tone.Info
            )
          ),
          Timeline.TimelineItem of TMsg(
            'failed', 'Build failed',
            new Timeline.Options(
              Time := '3h ago', Icon := Sys.Char.ConvertFromUtf32($E077),
              Tone := S.Tone.Danger, Last := true
            )
          )
        ], new Cards.Options(Gap := 14.0F)
      ),
      Cards.Card of TMsg(
        'goals-card', [
          E.Styled of TMsg(E.Text of TMsg('Goals'), S.Role.Heading),
          E.Row of TMsg(
            new L.Flow(Gap := G.Points(24), Justify := L.Justification.Around, Clip := false),
            Rings.ProgressRing of TMsg('onboarding', 'Onboarding', 0.72F, 104.0F),
            Rings.ProgressRing of TMsg('quota', 'Quota', 0.35F, 104.0F)
          )
        ], new Cards.Options(Gap := 14.0F)
      )
    ),
    G.Heading of TMsg(Strings.Get('Heading.BadgesAndAvatars')),
    BadgesAndAvatars.View of TMsg(),
    Cards.Card of TMsg(
      'no-projects-card', [
        Empty.EmptyState of TMsg(
          'no-projects', 'No projects yet',
          new Empty.Options(
            Icon := Sys.Char.ConvertFromUtf32($E247),
            Description := 'A project holds your screens, their builds and who can see them.',
            ActionLabel := 'New project'
          ),
          function(): TMsg => CreateProject
        )
      ]
    )
  );
end function;

end unit;
