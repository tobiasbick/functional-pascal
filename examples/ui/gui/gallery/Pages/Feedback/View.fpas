unit GuiGallery.Pages.Feedback.View;

uses
  GuiGallery.Pages.Feedback.State as Model, GuiGallery.Pages.Feedback.Widgets.Loading as Loading,
  GuiGallery.Shared.Sections as G, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L,
  Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Feedback.Alerts as A, Fpas.Ui.Widgets.Feedback.ProgressBars as P, Fpas.Ui.Widgets.Feedback.Spinners as Spin,
  Fpas.Ui.Widgets.Charts.Meters as Meters, Fpas.Ui.Widgets.Feedback.ProgressRings as Rings,
  Fpas.Ui.Widgets.Planning.TimelineItems as Timeline, Fpas.Ui.Widgets.Feedback.Skeletons as Skel, System as Sys,
  Fpas.Ui.Widgets.Containers.Cards as Cards, Fpas.Ui.Widgets.Containers.Grids as Grid, Fpas.Ui.Widgets.Containers.EmptyStates as Empty,
  GuiGallery.Pages.Feedback.Widgets.BadgesAndAvatars as BadgesAndAvatars;

// Reproduces the accepted native CUI Feedback examples.
// ## Type parameters
// - `TMsg`: Message type of the containing application.
// ## Parameters
// - `CreateProject`: The empty-state action message.
// - `State`: Current upload state.
// - `Upload`: Starts the status spinner example.
// ## Returns
// Native feedback widgets with their responsive card layout.
public function View<TMsg>(CreateProject: TMsg; State: Model.Model; Upload: TMsg): E.Element<TMsg>;
begin
  const Columns: Grid.Options := new Grid.Options(
    Columns := 2,
    MinimumColumnWidth := 260.0F,
    Gap := G.Points(16)
  );
  return E.Column<TMsg>(
    new L.Flow(Gap := G.Points(20), Clip := false),
    G.Heading<TMsg>('Alerts', 'Color only when something succeeded, needs attention or failed.'),
    E.Column<TMsg>(
      new L.Flow(Gap := G.Points(10)),
      A.Alert<TMsg>(
        'update', 'A new version is available',
        new A.Options(Description := 'Restart to update to 1.1.')
      ),
      A.Alert<TMsg>(
        'payment', 'Payment received',
        new A.Options(Description := 'Your invoice was paid on November 5.', Tone := S.Tone.Success)
      ),
      A.Alert<TMsg>(
        'storage', 'Storage almost full',
        new A.Options(
          Description := 'You have used 92% of your plan.',
          Tone := S.Tone.Warning,
          Dismissible := true
        )
      ),
      A.Alert<TMsg>(
        'build', 'Build failed',
        new A.Options(
          Description := 'Missing symbol cui_frame in main.c line 42.',
          Tone := S.Tone.Danger
        )
      )
    ),
    Grid.Grid<TMsg>(
      Columns,
      Cards.Card<TMsg>(
        'progress-card', [
          E.Styled<TMsg>(E.Text<TMsg>('Progress'), S.Role.Heading),
          P.ProgressBar<TMsg>(
            'upload',
            0.68F,
            new P.Options(Label := 'Uploading assets', ShowValue := true)
          ),
          P.ProgressBar<TMsg>(
            'index',
            0.0F,
            new P.Options(Label := 'Indexing', Indeterminate := true)
          ),
          P.ProgressBar<TMsg>(
            'export', 0.42F,
            new P.Options(Label := 'Exporting clip.mp4', ShowValue := true, Dither := true)
          ),
          P.ProgressBar<TMsg>(
            'sync', 0.0F,
            new P.Options(Label := 'Syncing library', Indeterminate := true, Dither := true)
          ),
          Meters.Meter<TMsg>('storage-usage', 'Storage', 18.4F, 20.0F, 'GB'),
          E.Row<TMsg>(
            new L.Flow(Gap := G.Points(16), Wrap := true),
            Spin.Spinner<TMsg>('spinner-small', 16.0F),
            Spin.Spinner<TMsg>('spinner-medium', 22.0F),
            Spin.Spinner<TMsg>('spinner-large', 28.0F)
          )
        ], new Cards.Options(Gap := 18.0F)
      ),
      Cards.Card<TMsg>(
        'loading-card', [
          E.Styled<TMsg>(E.Text<TMsg>('Loading'), S.Role.Heading),
          E.Row<TMsg>(
            new L.Flow(Gap := G.Points(12), Wrap := true),
            Skel.Skeleton<TMsg>('loading-avatar', L.Extent.Fixed(L.Measure.Logical(40)), 40.0F),
            E.Size<TMsg>(
              E.Column<TMsg>(
                new L.Flow(Gap := G.Points(8)),
                Skel.Skeleton<TMsg>('loading-title', L.Extent.Percent(70.0F), 12.0F),
                Skel.Skeleton<TMsg>('loading-subtitle', L.Extent.Percent(45.0F), 12.0F)
              ),
              new L.Flex(Basis := L.Extent.Fill)
            )
          ),
          Skel.Skeleton<TMsg>('loading-body', Height := 88.0F),
          Skel.Skeleton<TMsg>('loading-line-1', L.Extent.Percent(90.0F), 12.0F),
          Skel.Skeleton<TMsg>('loading-line-2', L.Extent.Percent(60.0F), 12.0F),
          Loading.Placeholders<TMsg>()
        ], new Cards.Options(Gap := 14.0F)
      ),
      Loading.Spinners<TMsg>(State, Upload)
    ),
    Grid.Grid<TMsg>(
      Columns,
      Cards.Card<TMsg>(
        'activity-card', [
          E.Styled<TMsg>(E.Text<TMsg>('Activity'), S.Role.Heading),
          Timeline.TimelineItem<TMsg>(
            'deployed', 'Deployed to production',
            new Timeline.Options(
              Time := '2m ago', Description := 'Release 1.0.3 is live in all regions.',
              Icon := Sys.Char.ConvertFromUtf32($E286), Tone := S.Tone.Success
            )
          ),
          Timeline.TimelineItem<TMsg>(
            'review', 'Review requested',
            new Timeline.Options(
              Time := '1h ago', Description := 'Jonas asked you to review the theming changes.',
              Icon := Sys.Char.ConvertFromUtf32($E117), Tone := S.Tone.Info
            )
          ),
          Timeline.TimelineItem<TMsg>(
            'failed', 'Build failed',
            new Timeline.Options(
              Time := '3h ago', Icon := Sys.Char.ConvertFromUtf32($E077),
              Tone := S.Tone.Danger, Last := true
            )
          )
        ], new Cards.Options(Gap := 14.0F)
      ),
      Cards.Card<TMsg>(
        'goals-card', [
          E.Styled<TMsg>(E.Text<TMsg>('Goals'), S.Role.Heading),
          E.Row<TMsg>(
            new L.Flow(Gap := G.Points(24), Justify := L.Justification.Around, Clip := false),
            Rings.ProgressRing<TMsg>('onboarding', 'Onboarding', 0.72F, 104.0F),
            Rings.ProgressRing<TMsg>('quota', 'Quota', 0.35F, 104.0F)
          )
        ], new Cards.Options(Gap := 14.0F)
      )
    ),
    G.Heading<TMsg>('Badges and avatars'),
    BadgesAndAvatars.View<TMsg>(),
    Cards.Card<TMsg>(
      'no-projects-card', [
        Empty.EmptyState<TMsg>(
          'no-projects', 'No projects yet',
          new Empty.Options(
            Icon := Sys.Char.ConvertFromUtf32($E247),
            Description := 'A project holds your screens, their builds and who can see them.',
            ActionLabel := 'New project'
          ),
          function(): TMsg => CreateProject
        )
      ]
    )
  );
end function;

end unit;
