// [Documentation](../../../../../../../docs/ui/gui/feedback/README.md)

unit GuiGallery.Pages.Feedback.Widgets.BadgesAndAvatars;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Feedback.Badges as B;
uses Fpas.Ui.Widgets.Media.AvatarGroups as Groups;
uses Fpas.Ui.Widgets.Media.Avatars as A;

uses GuiGallery.Shared.Sections as G;

// Shows the native badges, status avatars and overlapping team from Feedback.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Returns
// The Badges and avatars card.
public function View of TMsg(): E.Element of TMsg;
begin
  return Cards.Card of TMsg(
    'badges-and-avatars-card', [
      E.Row of TMsg(
        new L.Flow(Gap := G.Points(8), Wrap := true),
        B.Badge of TMsg('badge-draft', 'Draft'),
        B.Badge of TMsg('badge-recommended', 'Recommended', new B.Options(Tone := S.Tone.Accent)),
        B.Badge of TMsg(
          'badge-active',
          'Active',
          new B.Options(Tone := S.Tone.Success, Dot := true)
        ),
        B.Badge of TMsg(
          'badge-pending',
          'Pending',
          new B.Options(Tone := S.Tone.Warning, Dot := true)
        ),
        B.Badge of TMsg(
          'badge-overdue',
          'Overdue',
          new B.Options(Tone := S.Tone.Danger, Dot := true)
        ),
        B.Badge of TMsg('badge-beta', 'Beta', new B.Options(Tone := S.Tone.Violet)),
        B.Badge of TMsg('badge-new', 'New', new B.Options(Tone := S.Tone.Info, Solid := true))
      ),
      E.Row of TMsg(
        new L.Flow(Gap := G.Points(16), Wrap := true),
        A.Avatar of TMsg(
          'avatar-online',
          'Sam Whitfield',
          new A.Options(Size := 40.0F, Status := 'online')
        ),
        A.Avatar of TMsg(
          'avatar-busy',
          'Daniel Mensah',
          new A.Options(Size := 40.0F, Status := 'busy')
        ),
        A.Avatar of TMsg(
          'avatar-square',
          'Rosa Delgado',
          new A.Options(Size := 40.0F, Square := true)
        ),
        Groups.AvatarGroup of TMsg(
          'feedback-team', [
            'Kwame Asante', 'Hana Novak', 'Elif Kaya', 'Ben Carter',
            'Omar Haddad', 'Felix Moreau', 'Iris Coleman'
          ]
        )
      )
    ], new Cards.Options(Gap := 16.0F)
  );
end function;

end unit;
