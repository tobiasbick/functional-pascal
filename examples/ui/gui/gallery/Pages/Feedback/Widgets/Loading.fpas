// [Documentation](../../../../../../../docs/ui/gui/feedback/README.md)

unit GuiGallery.Pages.Feedback.Widgets.Loading;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Actions.StatusButtons as Work;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Feedback.SkeletonGroups as Group;
uses Fpas.Ui.Widgets.Feedback.Skeletons as Skeleton;
uses Fpas.Ui.Widgets.Feedback.Spinners as Spin;
uses Fpas.Ui.Widgets.Feedback.StatusSpinners as Status;

uses GuiGallery.Pages.Feedback.State as M;
uses GuiGallery.Shared.Sections as G;
uses System.Collections.Generic as Lists;

// Recreates the native skeleton group's shared dither sweep.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Returns
// Grouped placeholders with the original layout.
public function Placeholders of TMsg(): E.Element of TMsg;
begin
  return Group.SkeletonGroup of TMsg(
    'loading-dither', [
      E.Row of TMsg(
        new L.Flow(Gap := G.Points(12), Align := L.Alignment.Center),
        Skeleton.Skeleton of TMsg(
          'loading-dither-avatar',
          L.Extent.Fixed(L.Measure.Logical(32)),
          32.0F
        ),
        E.Size of TMsg(
          E.Column of TMsg(
            new L.Flow(Gap := G.Points(8)),
            Skeleton.Skeleton of TMsg('loading-dither-title', L.Extent.Percent(60.0F), 8.0F),
            Skeleton.Skeleton of TMsg('loading-dither-subtitle', L.Extent.Percent(40.0F), 8.0F)
          ),
          new L.Flex(Basis := L.Extent.Fill)
        )
      ),
      Skeleton.Skeleton of TMsg('loading-dither-line', Height := 8.0F)
    ], new Group.Options(Gap := 10.0F, Dither := true)
  );
end function;

function Inline of TMsg(Id: string; Caption: string; Animation: Spin.Style): E.Element of TMsg;
begin
  const Inverse: bool := Animation = Spin.Style.Comet;
  const InsetX: L.Spacing := G.Points(
    if Inverse then
      14
    else
      11
    end if
  );
  const InsetY: L.Spacing := G.Points(
    if Inverse then
      8
    else
      6
    end if
  );
  return E.Styled of TMsg(
    E.Row of TMsg(
      new L.Flow(
        Gap := G.Points(8), Align := L.Alignment.Center,
        PaddingStart := InsetX, PaddingEnd := InsetX, PaddingTop := InsetY, PaddingBottom := InsetY
      ),
      Spin.Spinner of TMsg(Id, 14.0F, new Spin.Options(Animation := Animation, Inverse := Inverse)),
      E.Styled of TMsg(
        E.Text of TMsg(Caption), if Inverse then
          S.Role.InverseLabel
        else
          S.Role.Secondary
        end if
      )
    ),
    if Inverse then
      S.Role.InverseSurface
    else
      S.Role.PillSurface
    end if
  );
end function;

// Recreates the dither spinner collection and the upload status example.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Model`: Current upload state.
// - `Upload`: Starts an upload.
// ## Returns
// A native feedback card.
public function Spinners of TMsg(Model: M.Model; Upload: TMsg): E.Element of TMsg;
begin
  const Styles: array of Spin.Style := [
    Spin.Style.Comet, Spin.Style.DotMatrix, Spin.Style.FillDrain, Spin.Style.Radar,
    Spin.Style.Ripple, Spin.Style.Transfer, Spin.Style.Orbit, Spin.Style.Bounce,
    Spin.Style.Scan, Spin.Style.Pulse, Spin.Style.Spiral, Spin.Style.Plasma
  ];
  const Demos: Lists.List of E.Element of TMsg := new Lists.List of E.Element of TMsg();
  for Animation: Spin.Style in Styles do
    Demos.Add(
      Spin.Spinner of TMsg(
        'dither-' + Animation.ToString(),
        40.0F,
        new Spin.Options(Animation := Animation)
      )
    );
  end for;

  const Caption: string := case Model.Status of
    when Work.Status.Busy: 'Uploading';
    when Work.Status.Success: 'Uploaded';
    when Work.Status.Error: 'Upload failed';
    else '';
  end case;
  return Cards.Card of TMsg(
    'dither-spinners-card', [
      E.Styled of TMsg(E.Text of TMsg('Dither spinners'), S.Role.Heading),
      E.Row of TMsg(
        new L.Flow(Gap := G.Points(20), Wrap := true, Align := L.Alignment.Center),
        Demos.ToArray()
      ),
      E.Row of TMsg(
        new L.Flow(Gap := G.Points(10), Wrap := true, Align := L.Alignment.Center),
        Inline of TMsg('dither-saving', 'Saving…', Spin.Style.Comet),
        Inline of TMsg('dither-syncing', 'Syncing 24 files', Spin.Style.Orbit),
        Inline of TMsg('dither-connecting', 'Connecting', Spin.Style.Ripple)
      ),
      E.Row of TMsg(
        new L.Flow(Gap := G.Points(10), Align := L.Alignment.Center),
        B.Button of TMsg(
          'feedback-upload', 'Upload', Upload,
          new B.Options(ControlSize := B.Size.Small, Enabled := Model.Status <> Work.Status.Busy)
        ),
        Status.StatusSpinner of TMsg(
          'feedback-upload-status',
          Model.Status,
          new Status.Options(Size := 18.0F)
        ),
        E.Styled of TMsg(E.Text of TMsg(Caption), S.Role.Secondary)
      )
    ], new Cards.Options(Gap := 14.0F)
  );
end function;

end unit;
