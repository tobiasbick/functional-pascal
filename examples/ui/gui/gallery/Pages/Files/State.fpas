// [Documentation](../../../../../../docs/ui/gui/files/README.md)

unit GuiGallery.Pages.Files.State;

uses Fpas.Ui.Widgets.Developer.Terminals as Terminal;
uses Fpas.Ui.Widgets.Files.FileBrowsers as Browser;
uses Fpas.Ui.Widgets.Files.FilePickers as Picker;
uses Fpas.Ui.Widgets.Navigation.PathBars as Paths;

uses GuiGallery.Pages.Files.ProjectTree as Tree;
uses GuiGallery.Pages.Files.Terminal as Shell;

// File gallery state.
public type Model = record
  // Browser's current folder.
  public Folder: string := '.';
  // Cumulative output for the terminal.
  public Output: string := Shell.Welcome;
  // Explicit terminal reset revision.
  public TerminalRevision: int := 0;
  // Last chosen filename.
  public Chosen: string := '';
  // Native open picker visibility.
  public Opening: bool := false;
  // Native save picker visibility.
  public Saving: bool := false;
  // Project tree shown between the file browser and terminal.
  public Project: Tree.Model := new Tree.Model();
end record;

// File gallery actions.
public type Msg = variant
  // Applies a folder or selection proposal.
  Browse(Event: Browser.Event);
  // Opens the native Open dialog.
  Open;
  // Opens the native Save dialog.
  Save;
  // Closes Open with an optional selection.
  Opened(Event: Picker.Event);
  // Closes Save with an optional filename.
  Saved(Event: Picker.Event);
  // Native terminal input.
  Terminal(Value: Terminal.Event);
  // Sample project tree interaction.
  Project(Value: Tree.Msg);
  // Navigates the standalone path bar.
  Path(Event: Paths.Event);
end variant;

end unit;
