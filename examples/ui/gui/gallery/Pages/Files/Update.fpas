// [Documentation](../../../../../../docs/ui/gui/files/file-picker.md)

unit GuiGallery.Pages.Files.Update;

uses Fpas.Ui.Widgets.Developer.Terminals as Terminal;
uses Fpas.Ui.Widgets.Files.FileBrowsers as Browser;
uses Fpas.Ui.Widgets.Files.FilePickers as Picker;
uses Fpas.Ui.Widgets.Navigation.PathBars as Paths;

uses GuiGallery.Pages.Files.State as M;
uses GuiGallery.Pages.Files.Terminal as Shell;
uses GuiGallery.Pages.Files.View as V;
uses System as Sys;
uses System.IO as IO;

function ValidFolder(Current: string; Proposed: string): string;
begin
  try
    discard IO.Path.GetFullPath(Proposed);
    return Proposed;
  catch Failure: Sys.ArgumentException do
    return Current;
  catch Failure: Sys.NotSupportedException do
    return Current;
  catch Failure: IO.PathTooLongException do
    return Current;
  end try;
end function;

// Applies native file navigation and picker results.
// ## Parameters
// - `Model`: Current Files state.
// - `Message`: Proposed file action.
// ## Returns
// The new gallery state.
public function Update(Model: M.Model; Message: M.Msg): M.Model;
begin
  return case Message of
    when M.Msg.Browse(const Event: Browser.Event): Model with
      Folder := ValidFolder(Model.Folder, Event.Folder);
      Chosen := Event.Picked ?? Model.Chosen;
    end with;
    when M.Msg.Open: Model with
      Opening := true;
    end with;
    when M.Msg.Save: Model with
      Saving := true;
    end with;
    when M.Msg.Opened(const Event: Picker.Event): Model with
      Opening := false;
      Chosen := Event.Path ?? Model.Chosen;
    end with;
    when M.Msg.Saved(const Event: Picker.Event): Model with
      Saving := false;
      Chosen := Event.Path ?? Model.Chosen;
    end with;
    when M.Msg.Terminal(Terminal.Event.Command(const Command: string)): if Command = 'clear' then
        Model with
          Output := '';
          TerminalRevision := Model.TerminalRevision + 1;
        end with
      else
        Model with
          Output := Model.Output + Shell.Run(Command, Model.Folder);
        end with
      end if;
    when M.Msg.Terminal(Terminal.Event.Interrupt): Model;
    when M.Msg.Path(const Event: Paths.Event): Model with
      Folder := if Event.Text <> null then
        ValidFolder(Model.Folder, Event.Text ?? Model.Folder)
      elsif Event.Child >= 0 then
        V.MenuPath(Model.Folder, Event.MenuSegment, Event.Child)
      elsif Event.Segment >= 0 then
        V.At(Model.Folder, Event.Segment)
      else
        Model.Folder
      end if;
    end with;
  end case;
end function;

end unit;
