unit GuiGallery.Pages.Files.Update;

uses
  GuiGallery.Pages.Files.State as M, GuiGallery.Pages.Files.View as V,
  GuiGallery.Pages.Files.Terminal as Shell, Fpas.Ui.Widgets.Developer.Terminals as Terminal,
  Fpas.Ui.Widgets.Files.FileBrowsers as Browser, Fpas.Ui.Widgets.Files.FilePickers as Picker, Fpas.Ui.Widgets.Navigation.PathBars as Paths;

// Applies native file navigation and picker results.
// ## Parameters
// - `Model`: Current Files state.
// - `Message`: Proposed file action.
// ## Returns
// The new gallery state.
public function Update(Model: M.Model; Message: M.Msg): M.Model;
begin
  return case Message of
    when M.Msg.Browse(const Event: Browser.Event): Model with
      Folder := Event.Folder;
      Chosen := Event.Picked ?? Model.Chosen;
    end with;
    when M.Msg.Open: Model with
      Opening := true;
    end with;
    when M.Msg.Save: Model with
      Saving := true;
    end with;
    when M.Msg.Opened(const Event: Picker.Event): Model with
      Opening := false;
      Chosen := Event.Path ?? Model.Chosen;
    end with;
    when M.Msg.Saved(const Event: Picker.Event): Model with
      Saving := false;
      Chosen := Event.Path ?? Model.Chosen;
    end with;
    when M.Msg.Terminal(Terminal.Event.Command(const Command: string)): if Command = 'clear' then
        Model with
          Output := '';
          TerminalRevision := Model.TerminalRevision + 1;
        end with
      else
        Model with
          Output := Model.Output + Shell.Run(Command, Model.Folder);
        end with
      end if;
    when M.Msg.Terminal(Terminal.Event.Interrupt): Model;
    when M.Msg.Path(const Event: Paths.Event): Model with
      Folder := if Event.Text <> null then
        Event.Text ?? Model.Folder
      elsif Event.Child >= 0 then
        V.MenuPath(Model.Folder, Event.MenuSegment, Event.Child)
      elsif Event.Segment >= 0 then
        V.At(Model.Folder, Event.Segment)
      else
        Model.Folder
      end if;
    end with;
  end case;
end function;

end unit;
