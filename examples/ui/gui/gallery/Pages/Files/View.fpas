// [Documentation](../../../../../../docs/ui/gui/files/README.md)

unit GuiGallery.Pages.Files.View;

uses Fpas.Ui.Composition as Composition;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Developer.Terminals as Terminal;
uses Fpas.Ui.Widgets.Files.FileBrowsers as Browser;
uses Fpas.Ui.Widgets.Files.FileListings as Listings;
uses Fpas.Ui.Widgets.Files.FilePickers as Picker;
uses Fpas.Ui.Widgets.Navigation.PathBars as Paths;

uses Gallery.Shared.FilePickerExample as PickerSample;
uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Files.Folders as Directory;
uses GuiGallery.Pages.Files.ProjectTree as Tree;
uses GuiGallery.Pages.Files.State as M;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;
uses System.Collections.Generic as Lists;
uses System.IO as IO;

function Controls(Model: M.Model): E.Element of M.Msg;
begin
  const Row: Lists.List of E.Element of M.Msg := new Lists.List of E.Element of M.Msg();
  Row.Add(
    B.Button of M.Msg(
      'files-open', PickerSample.OpenLabel, M.Msg.Open,
      new B.Options(Icon := Sys.Char.ConvertFromUtf32($E247))
    )
  );
  Row.Add(
    B.Button of M.Msg(
      'files-save', PickerSample.SaveLabel, M.Msg.Save,
      new B.Options(Icon := Sys.Char.ConvertFromUtf32($E0B2))
    )
  );
  if Model.Chosen <> '' then
    Row.Add(E.Styled of M.Msg(E.Text of M.Msg(Model.Chosen), S.Role.Caption));
  end if;

  return E.Row of M.Msg(
    new L.Flow(Gap := G.Points(8), Align := L.Alignment.Center, Wrap := true, Clip := false),
    Row.ToArray()
  );
end function;

function Original(Model: M.Model): E.Element of M.Msg;
begin
  return E.Column of M.Msg(
    new L.Flow(Gap := G.Points(20), Clip := false),
    G.Heading of M.Msg(Strings.Get('Heading.FileBrowser'), Strings.Get('Heading.FileBrowserHint')),
    Browser.FileBrowser of M.Msg(
      'files-browser', Model.Folder, M.Msg.Browse, new Browser.Options(
        Height := L.Extent.Fixed(L.Measure.Logical(380)), Source := Directory.ReadFolder
      )
    ),
    Controls(Model)
  );
end function;

function Segments(Path: string): array of string;
begin
  const Parts: Lists.List of string := new Lists.List of string();
  const Root: string := IO.Path.GetPathRoot(Path) ?? '';
  if Root <> '' then
    Parts.Add(Root);
  end if;

  const Relative: string := Path.Substring(Root.Length).Replace(Sys.Char.ConvertFromUtf32(92), '/');
  for Part: string in Relative.Split(cast 47 as char) do
    if Part <> '' then
      Parts.Add(Part);
    end if;
  end for;

  if Parts.Count = 0 then
    Parts.Add('.');
  end if;

  return Parts.ToArray();
end function;

function ChildFolders(Folder: string): array of string;
begin
  const Listing: Listings.Listing? := Directory.ReadFolder(Folder, false);
  const Names: Lists.List of string := new Lists.List of string();
  if Listing <> null then
    for Entry: Listings.Entry in Listing.Entries do
      if Entry.Directory then
        Names.Add(Entry.Name);
      end if;
    end for;
  end if;

  Names.Sort(Sys.StringComparer.OrdinalIgnoreCase);
  return Names.ToArray();
end function;

function Children(Path: array of string): array of array of string;
begin
  const Menus: Lists.List of array of string := new Lists.List of array of string();
  var Folder: string := Path[0];
  for Index: int := 0 to Path.Length - 2 do
    Menus.Add(ChildFolders(Folder));
    Folder := IO.Path.Combine(Folder, Path[Index + 1]);
  end for;

  return Menus.ToArray();
end function;

// Resolves a standalone path segment to its folder.
// ## Parameters
// - `Folder`: Browser folder.
// - `Index`: Zero-based segment index.
// ## Returns
// Folder through the chosen segment.
public function At(Folder: string; Index: int): string;
begin
  const Parts: array of string := Segments(Folder);
  var Path: string := Parts[0];
  for Slot: int := 1 to Sys.Math.Min(Index, Parts.Length - 1) do
    Path := IO.Path.Combine(Path, Parts[Slot]);
  end for;

  return Path;
end function;

// Finds a menu item's directory in the standalone example.
// ## Parameters
// - `Folder`: Browser folder.
// - `Parent`: Index of the menu's parent.
// - `Child`: Index of the selected directory.
// ## Returns
// The proposed folder, or the existing folder if the listing changed.
public function MenuPath(Folder: string; Parent: int; Child: int): string;
begin
  const Path: string := At(Folder, Parent);
  const Names: array of string := ChildFolders(Path);
  return if Child < Names.Length then
    IO.Path.Combine(Path, Names[Child])
  else
    Folder
  end if;
end function;

// Displays the Files page and both dialogs.
// ## Parameters
// - `Model`: Current Files state.
// ## Returns
// Browser, project tree, terminal and standalone path bar.
public function View(Model: M.Model): array of E.Element of M.Msg;
begin
  const Path: array of string := Segments(Model.Folder);
  const Base: E.Element of M.Msg := E.Column of M.Msg(
    new L.Flow(Gap := G.Points(20), Clip := false),
    Original(Model),
    Composition.Map of (Tree.Msg, M.Msg)(Tree.View(Model.Project), M.Msg.Project),
    G.Heading of M.Msg(
      Strings.Get('Text.SectionTerminal'),
      Strings.Get('Heading.TerminalHint')
    ),
    Terminal.Terminal of M.Msg(
      'files-terminal', Model.Output, Model.TerminalRevision, M.Msg.Terminal,
      new Terminal.Options(Height := 300.0F, Prompt := '> ')
    ),
    G.Heading of M.Msg(Strings.Get('Heading.PathBar'), Strings.Get('Heading.PathBarHint')),
    Paths.PathBar of M.Msg(
      'files-path-bar', new Paths.Value(Path, Model.Folder, Children(Path)),
      M.Msg.Path, new Paths.Options(Icon := Sys.Char.ConvertFromUtf32($E0D7))
    )
  );
  return [
    Picker.FilePicker of M.Msg(
      'files-open-picker', Model.Opening, M.Msg.Opened,
      PickerSample.Settings(false, Directory.ReadFolder), Base
    ),
    Picker.FilePicker of M.Msg(
      'files-save-picker', Model.Saving, M.Msg.Saved,
      PickerSample.Settings(true, Directory.ReadFolder)
    )
  ];
end function;

end unit;
