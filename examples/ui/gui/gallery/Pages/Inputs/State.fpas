unit GuiGallery.Pages.Inputs.State;

uses
  GuiGallery.Shared.State as Demo, Fpas.Ui.Graphics as G, System as Sys;

// State owned by this gallery feature.
public type Model = record
  // Current query in the Search projects example.
  public SearchQuery: string := '';
  // Current multiline value in the About example.
  public About: string := 'Mathematician and writer. I like engines that compute and interfaces that stay out of the way.';
  // Current value of the password example.
  public Password: string := '';
  // Ordered topics in the tag input example.
  public Topics: array of string := ['design', 'c99', 'native'];
  // Partial verification code in the example.
  public VerificationCode: string := '418';
  // Current country in the picker example.
  public Country: int := 2;
  // Current language, or minus one before selection.
  public Language: int := -1;
  // Due date shared by the date field and standalone calendar.
  public DueDate: Sys.DateOnly? := new Sys.DateOnly(2026, 11, 14);
  // Bounded seat count.
  public Seats: double := 3.0;
  // Selected brand swatch.
  public BrandColor: G.Color := new G.Color(119, 71, 255);
end record;

// Messages handled by this gallery feature.
public type Msg = variant
  // Update the search query.
  SetSearchQuery(Value: string);
  // Update the About text.
  SetAbout(Value: string);
  // Update the sample password.
  SetPassword(Value: string);
  // Replace the selected topics.
  SetTopics(Value: array of string);
  // Replace the partial verification code.
  SetVerificationCode(Value: string);
  // Select a country.
  SetCountry(Index: int);
  // Select a language.
  SetLanguage(Index: int);
  // Select the due date from either calendar.
  SetDueDate(Value: Sys.DateOnly);
  // Adjust the seat count.
  SetSeats(Value: double);
  // Select a new brand swatch.
  SetBrandColor(Value: G.Color);
  // A harmless preview activation.
  Preview;
  // Propose a change to shared demo values.
  Shared(Value: Demo.Msg);
end variant;

end unit;
