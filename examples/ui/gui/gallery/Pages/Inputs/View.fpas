// [Documentation](../../../../../../docs/ui/gui/inputs/README.md)

unit GuiGallery.Pages.Inputs.View;

uses Fpas.Ui.Elements as E;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Inputs.State as S;
uses GuiGallery.Pages.Inputs.Widgets.CredentialFields as Credentials;
uses GuiGallery.Pages.Inputs.Widgets.PickerFields as Pickers;
uses GuiGallery.Pages.Inputs.Widgets.TextField as Fields;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;

// Builds the native input sections.
// ## Parameters
// - `Model`: Values owned by Inputs.
// - `Data`: Shared name and email.
// ## Returns
// Section headings and cards in gallery order.
public function View(Model: S.Model; Data: Demo.Model): array of E.Element of S.Msg;
begin
  return [
    G.Heading of S.Msg(Strings.Get('Text.TextFields'), Strings.Get('Text.FieldHints')),
    Fields.View(Model, Data),
    G.Heading of S.Msg(Strings.Get('Heading.TagsCodesAndPasswordStrength')),
    Credentials.View(Model),
    G.Heading of S.Msg(Strings.Get('Page.Pickers')),
    Pickers.View(Model)
  ];
end function;

end unit;
