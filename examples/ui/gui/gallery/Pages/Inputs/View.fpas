// [Documentation](../../../../../../docs/ui/gui/inputs/README.md)

unit GuiGallery.Pages.Inputs.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses GuiGallery.Pages.Inputs.State as S;
uses GuiGallery.Pages.Inputs.Widgets.CredentialFields as Credentials;
uses GuiGallery.Pages.Inputs.Widgets.InlineCalendar as InlineCalendar;
uses GuiGallery.Pages.Inputs.Widgets.PickerFields as Pickers;
uses GuiGallery.Pages.Inputs.Widgets.TextField as Fields;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;

// Builds the native input sections.
// ## Parameters
// - `Model`: Values owned by Inputs.
// - `Data`: Shared name and email.
// ## Returns
// The Inputs page.
public function View(Model: S.Model; Data: Demo.Model): E.Element<S.Msg>;
begin
  return E.Column<S.Msg>(
    new L.Flow(Gap := G.Points(20)),
    Fields.Inputs(Model, Data),
    Credentials.View(Model, Data),
    Pickers.View(Model),
    InlineCalendar.View(Model)
  );
end function;

end unit;
