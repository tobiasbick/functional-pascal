unit GuiGallery.Pages.Inputs.Widgets.InlineCalendar;

uses
  GuiGallery.Pages.Inputs.State as State, GuiGallery.Shared.Sections as G,
  Fpas.Ui.Calendars as C, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S;

// Shows the standalone calendar below the original Inputs sections.
// ## Parameters
// - `Model`: Inputs model containing the shared due date.
// ## Returns
// The calendar section linked to the Due date field.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading<State.Msg>('Calendar'),
    E.Row<State.Msg>(
      E.Styled<State.Msg>(
        E.Column<State.Msg>(
          new L.Flow(Padding := G.Points(16)),
          C.Calendar<State.Msg>('input-calendar', Model.DueDate, State.Msg.SetDueDate)
        ),
        S.Role.OutlinedPanel
      )
    )
  );
end function;
end unit;
