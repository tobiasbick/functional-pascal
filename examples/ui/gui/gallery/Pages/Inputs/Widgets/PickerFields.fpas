// [Documentation](../../../../../../../docs/ui/gui/inputs/README.md)

unit GuiGallery.Pages.Inputs.Widgets.PickerFields;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Containers.Grids as Grid;
uses Fpas.Ui.Widgets.Inputs.NumberFields as N;
uses Fpas.Ui.Widgets.Pickers.DatePickers as D;
uses Gallery.Shared.PickerChoices as Choices;
uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Inputs.State as State;
uses GuiGallery.Pages.Inputs.Widgets.BrandColor as BrandColor;
uses GuiGallery.Shared.Sections as G;

// Builds the accepted fields in the original Pickers card.
//
// ## Parameters
// - `Model`: Model-owned choices, due date, seat count and brand color.
// ## Returns
// The Pickers section of the Inputs page.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  const Country: E.Element<State.Msg> := Choices.Country<State.Msg>(
    Model.Country,
    State.Msg.SetCountry
  );
  const Language: E.Element<State.Msg> := Choices.Language<State.Msg>(
    Model.Language,
    State.Msg.SetLanguage
  );
  const Due: E.Element<State.Msg> := D.DatePicker<State.Msg>(
    'input-due-date', Model.DueDate, State.Msg.SetDueDate, new D.Options(Label := 'Due date')
  );
  const Seats: E.Element<State.Msg> := N.NumberField<State.Msg>(
    'input-seats', Model.Seats, 0.0, 99.0, State.Msg.SetSeats, new N.Options(Label := 'Seats')
  );
  const Brand: E.Element<State.Msg> := BrandColor.View(Model);
  const Fields: array of E.Element<State.Msg> := [
    Grid.Grid<State.Msg>(
      new Grid.Options(Columns := 2, MinimumColumnWidth := 260.0F, Gap := G.Points(16)),
      Country, Language, Due, Seats
    ),
    Brand
  ];
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading<State.Msg>(Strings.Get('Page.Pickers')),
    G.Card<State.Msg>(16, Fields)
  );
end function;

end unit;
