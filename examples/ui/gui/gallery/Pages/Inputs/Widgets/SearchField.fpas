// [Documentation](../../../../../../../docs/ui/gui/inputs/search-field.md)

unit GuiGallery.Pages.Inputs.Widgets.SearchField;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Inputs.SearchFields as Search;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Inputs.State as State;

// Builds the search box alongside the password field in the Inputs card.
//
// ## Parameters
// - `Model`: Current search query.
// ## Returns
// The original Search projects field.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  return Search.SearchField of State.Msg(
    'input-search', Model.SearchQuery, State.Msg.SetSearchQuery,
    new Search.Options(
      Label := Strings.Get('Text.Search'),
      Placeholder := Strings.Get('Text.SearchProjects'),
      MaxUtf8Bytes := 63
    )
  );
end function;

end unit;
