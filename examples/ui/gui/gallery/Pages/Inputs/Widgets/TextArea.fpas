// [Documentation](../../../../../../../docs/ui/gui/inputs/text-area.md)

unit GuiGallery.Pages.Inputs.Widgets.TextArea;

uses Fpas.Ui.Elements as E;

uses Gallery.Shared.AboutField as About;
uses GuiGallery.Pages.Inputs.State as State;

// Builds the full-width About field under the Inputs grid.
// ## Parameters
// - `Model`: Current profile description.
// ## Returns
// The shared About field with the page's update callback.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  return About.View<State.Msg>(Model.About, State.Msg.SetAbout);
end function;

end unit;
