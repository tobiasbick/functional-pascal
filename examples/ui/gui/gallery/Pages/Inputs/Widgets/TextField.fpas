unit GuiGallery.Pages.Inputs.Widgets.TextField;

uses
  GuiGallery.Shared.State as Demo,
  GuiGallery.Pages.Inputs.Widgets.SearchField as Search,
  GuiGallery.Pages.Inputs.Widgets.TextArea as Area,
  GuiGallery.Pages.Inputs.State as State,
  GuiGallery.Shared.Sections as G,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L,
  Fpas.Ui.Widgets.Containers.Grids as Grid,
  Fpas.Ui.Widgets.Inputs.TextFields as F,
  System as Sys,
  System.Text as Text;

// Builds the accepted text fields in the original responsive card.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current values.
// ## Returns
// The Text fields section of the Inputs page.
public function Inputs(Model: State.Model; Data: Demo.Model): E.Element<State.Msg>;
begin
  const Name: E.Element<State.Msg> := F.TextField<State.Msg>(
    'input-name',
    Data.Name,
    function(SharedValue: string): State.Msg => State.Msg.Shared(Demo.Msg.SetName(SharedValue)),
    new F.Options(Label := 'Full name', Placeholder := 'Maya Okafor', MaxUtf8Bytes := 63)
  );
  const Email: E.Element<State.Msg> := F.TextField<State.Msg>(
    'input-email',
    Data.Email,
    function(SharedValue: string): State.Msg => State.Msg.Shared(Demo.Msg.SetEmail(SharedValue)),
    new F.Options(
      Label := 'Email', Icon := Sys.Char.ConvertFromUtf32($E04E),
      Hint := 'We never share your email.', MaxUtf8Bytes := 95
    )
  );
  const Error: string := if Model.Password <> '' and Text.Encoding.UTF8.GetByteCount(
    Model.Password
  ) < 8
  then
    'Use 8 or more characters.'
  else
    ''
  end if;
  const Password: E.Element<State.Msg> := F.TextField<State.Msg>(
    'input-password', Model.Password, State.Msg.SetPassword,
    new F.Options(
      Label := 'Password', Placeholder := 'At least 8 characters', Password := true,
      Error := Error, MaxUtf8Bytes := 63
    )
  );
  const Query: E.Element<State.Msg> := Search.View(Model, Data);
  const About: E.Element<State.Msg> := Area.View(Model, Data);
  const Fields: array of E.Element<State.Msg> := [
    Grid.Grid<State.Msg>(
      new Grid.Options(Columns := 2, MinimumColumnWidth := 260.0F, Gap := G.Points(16)),
      Name, Email, Password, Query
    ),
    About
  ];
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading<State.Msg>('Text fields', 'Labels above, hints and errors below.'),
    G.Card<State.Msg>(16, Fields)
  );
end function;

end unit;
