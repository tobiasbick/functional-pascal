// [Documentation](../../../../../../../docs/ui/gui/inputs/text-field.md)

unit GuiGallery.Pages.Inputs.Widgets.TextField;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Containers.Grids as Grid;
uses Fpas.Ui.Widgets.Inputs.TextFields as F;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Inputs.State as State;
uses GuiGallery.Pages.Inputs.Widgets.SearchField as Search;
uses GuiGallery.Pages.Inputs.Widgets.TextArea as Area;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;
uses System as Sys;
uses System.Text as Text;

// Builds the accepted text fields in the original responsive card.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current values.
// ## Returns
// The Text fields section of the Inputs page.
public function Inputs(Model: State.Model; Data: Demo.Model): E.Element of State.Msg;
begin
  const Name: E.Element of State.Msg := F.TextField of State.Msg(
    'input-name',
    Data.Name,
    function(SharedValue: string): State.Msg => State.Msg.Shared(Demo.Msg.SetName(SharedValue)),
    new F.Options(
      Label := Strings.Get('Text.FullName'),
      Placeholder := 'Maya Okafor',
      MaxUtf8Bytes := 63
    )
  );
  const Email: E.Element of State.Msg := F.TextField of State.Msg(
    'input-email',
    Data.Email,
    function(SharedValue: string): State.Msg => State.Msg.Shared(Demo.Msg.SetEmail(SharedValue)),
    new F.Options(
      Label := Strings.Get('Text.Email'), Icon := Sys.Char.ConvertFromUtf32($E04E),
      Hint := Strings.Get('Text.EmailPrivacy'), MaxUtf8Bytes := 95
    )
  );
  const Error: string := if Model.Password <> '' and Text.Encoding.UTF8.GetByteCount(
    Model.Password
  ) < 8
  then
    Strings.Get('Text.ShortPassword')
  else
    ''
  end if;
  const Password: E.Element of State.Msg := F.TextField of State.Msg(
    'input-password', Model.Password, State.Msg.SetPassword,
    new F.Options(
      Label := Strings.Get('Text.Password'),
      Placeholder := Strings.Get('Text.MinimumPasswordLength'),
      Password := true,
      Error := Error,
      MaxUtf8Bytes := 63
    )
  );
  const Query: E.Element of State.Msg := Search.View(Model, Data);
  const About: E.Element of State.Msg := Area.View(Model);
  const Fields: array of E.Element of State.Msg := [
    Grid.Grid of State.Msg(
      new Grid.Options(Columns := 2, MinimumColumnWidth := 260.0F, Gap := G.Points(16)),
      Name, Email, Password, Query
    ),
    About
  ];
  return E.Column of State.Msg(
    new L.Flow(Gap := G.Points(20)),
    G.Heading of State.Msg(Strings.Get('Text.TextFields'), Strings.Get('Text.FieldHints')),
    G.Card of State.Msg(16, Fields)
  );
end function;

end unit;
