// [Documentation](../../../../../../docs/ui/gui/layout/README.md)

unit GuiGallery.Pages.Layout.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as Buttons;
uses Fpas.Ui.Widgets.Containers.Stacks as Stacks;
uses Fpas.Ui.Widgets.Feedback.Badges as Badges;
uses Fpas.Ui.Widgets.Feedback.Skeletons as Skeletons;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Shared.Sections as G;
uses System.Collections.Generic as Lists;

function DirectionRow of TMsg(Id: string; Direction: L.Direction; Message: TMsg): E.Element of TMsg;
begin
  return E.Row of TMsg(
    new L.Flow(
      Padding := G.Points(12), PaddingStart := G.Points(24),
      ReadingDirection := Direction, Clip := false
    ),
    Buttons.Button of TMsg(Id + '-start', 'Start', Message),
    E.Gap of TMsg(L.Measure.Logical(12)), E.Spacer of TMsg(),
    Buttons.Button of TMsg(Id + '-end', 'End', Message)
  );
end function;

// Shows native layout primitives that have no dedicated upstream gallery page.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Message`: Harmless activation for the direction examples.
// ## Returns
// Layered, mirrored and horizontally scrolling examples, all laid out by CUI.
public function View of TMsg(Message: TMsg): E.Element of TMsg;
begin
  const Tiles: Lists.List of E.Element of TMsg := new Lists.List of E.Element of TMsg();
  for Index: int := 1 to 6 do
    Tiles.Add(
      E.Size of TMsg(
        G.Card of TMsg(
          8,
          [E.Text of TMsg('Card ' + Index.ToString()), E.Text of TMsg('Scroll sideways')]
        ),
        new L.Flex(Width := new L.AxisSize(Basis := L.Extent.Fixed(L.Measure.Logical(180))))
      )
    );
  end for;

  return E.Column of TMsg(
    new L.Flow(Gap := G.Points(20), Clip := false),
    G.Heading of TMsg(Strings.Get('Heading.LayeredStack'), Strings.Get('Heading.LayeredStackHint')),
    E.Size of TMsg(
      Stacks.Stack of TMsg(
        new L.Flow(
          Align := L.Alignment.End, Justify := L.Justification.End,
          Padding := G.Points(12), PaddingTop := L.Spacing.None
        ),
        Skeletons.Skeleton of TMsg('layout-back', Height := 140.0F),
        Badges.Badge of TMsg('layout-front', 'On top', new Badges.Options(Tone := S.Tone.Info))
      ),
      new L.Flex(
        Width := new L.AxisSize(Basis := L.Extent.Fill, Maximum := L.Measure.Logical(420)),
        Height := new L.AxisSize(Basis := L.Extent.Fixed(L.Measure.Logical(160)))
      )
    ),
    G.Heading of TMsg(
      Strings.Get('Heading.ReadingDirection'),
      Strings.Get('Heading.ReadingDirectionHint')
    ),
    DirectionRow of TMsg('ltr', L.Direction.LeftToRight, Message),
    DirectionRow of TMsg('rtl', L.Direction.RightToLeft, Message),
    G.Heading of TMsg(
      Strings.Get('Heading.HorizontalScrolling'),
      Strings.Get('Heading.HorizontalScrollingHint')
    ),
    E.Size of TMsg(
      E.ScrollView of TMsg(
        'layout-horizontal',
        E.Row of TMsg(new L.Flow(Gap := G.Points(12), Clip := false), Tiles.ToArray()),
        FadeEdges := true, Horizontal := true
      ),
      new L.Flex(Height := new L.AxisSize(Basis := L.Extent.Fixed(L.Measure.Logical(150))))
    )
  );
end function;

end unit;
