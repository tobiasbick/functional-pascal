unit GuiGallery.Pages.Lists.Update;

uses
  Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Tables as T, Fpas.Ui.Gui.Toasts as Toasts,
  GuiGallery.Pages.Lists.State as S;

// Applies a message to this feature and describes its effects.
// ## Parameters
// - `State`: Current feature model.
// - `Message`: Feature message.
// ## Returns
// Next feature model and commands.
public function Update(State: S.Model; Message: S.Msg): Mvu.Transition<S.Model, S.Msg>;
begin
  const Next: S.Model := case Message of
    when S.Msg.SetAccordion(const Index: int, const Open: bool): State with
      AccordionOpen := [
        if Index = 0 then
          Open
        else
          State.AccordionOpen[0]
        end if,
        if Index = 1 then
          Open
        else
          State.AccordionOpen[1]
        end if,
        if Index = 2 then
          Open
        else
          State.AccordionOpen[2]
        end if
      ];
    end with;
    when S.Msg.SetSort(const Value: T.Sort): State with
      Sort := Value;
    end with;
    when S.Msg.SelectPerson(const Id: string): State with
      Selected := Id;
    end with;
    when S.Msg.SetSource(const Open: bool): State with
      SourceOpen := Open;
    end with;
    when S.Msg.SetComponents(const Open: bool): State with
      ComponentsOpen := Open;
    end with;
    when S.Msg.SetAssets(const Open: bool): State with
      AssetsOpen := Open;
    end with;
    when S.Msg.SelectFile(const Name: string): State with
      File := Name;
    end with;
    when S.Msg.Reorder(const Order: array of int): State with
      TaskOrder := Order;
    end with;
    else State;
  end case;
  return new Mvu.Transition<S.Model, S.Msg>(
    Next, case Message of
      when S.Msg.Reorder(_): [Toasts.Show<S.Msg>('Order saved')];
      else [];
    end case
  );
end function;

end unit;
