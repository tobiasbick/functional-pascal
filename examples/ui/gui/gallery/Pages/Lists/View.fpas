unit GuiGallery.Pages.Lists.View;

uses
  GuiGallery.Pages.Lists.State as State,
  GuiGallery.Shared.Sections as G,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L,
  Fpas.Ui.Styles as S,
  Fpas.Ui.Widgets.Containers.Accordions as A, Fpas.Ui.Widgets.Containers.Cards as Cards,
  GuiGallery.Pages.Lists.Widgets.People as People,
  GuiGallery.Pages.Lists.Widgets.TreeAndList as TreeAndList,
  GuiGallery.Pages.Lists.Widgets.Tasks as Tasks,
  GuiGallery.Pages.Lists.Widgets.Invoices as Invoices;

function Question(Model: State.Model; Index: int; Title: string; Answer: string): E.Element<State.Msg>;
begin
  return A.Accordion<State.Msg>(
    'accordion/' + Index.ToString(), Title, Model.AccordionOpen[Index],
    function(Open: bool): State.Msg => State.Msg.SetAccordion(Index, Open),
    E.Styled<State.Msg>(E.Text<State.Msg>(Answer), S.Role.Secondary)
  );
end function;

// Reproduces the native Data display sections in their original order.
//
// ## Parameters
// - `Model`: Model-owned expansion for each question.
// ## Returns
// The Data display page sections.
public function View(Model: State.Model): array of E.Element<State.Msg>;
begin
  const Items: array of E.Element<State.Msg> := [
    Question(
      Model, 0, 'Is it really dependency free?',
      'Yes. The core is plain C99. Windows uses Win32, macOS uses Cocoa and Linux uses X11. Fonts and icons are embedded.'
    ),
    Question(
      Model, 1, 'Can I use my own renderer?',
      'CUI outputs vertices and draw commands. Port the 60 line shader to Vulkan, Metal or Direct3D and you are done.'
    ),
    Question(
      Model, 2, 'Does it respect reduced motion?',
      'Every animation has a reduced motion path that keeps the final state and feedback.'
    )
  ];
  return [
    G.Heading<State.Msg>('Table', 'Sortable columns, row selection and components in cells.'),
    People.View(Model),
    TreeAndList.View(Model),
    G.Heading<State.Msg>('Reorderable list', 'Drag a row. The others make room as you go.'),
    Tasks.View(Model),
    G.Heading<State.Msg>('Accordion'),
    Cards.Card<State.Msg>('accordion-card', Items, new Cards.Options(PaddingY := 4.0F)),
    G.Heading<State.Msg>('Virtual list', 'Ten thousand rows. Only the visible ones are built.'),
    Invoices.View()
  ];
end function;

end unit;
