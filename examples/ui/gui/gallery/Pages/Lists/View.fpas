// [Documentation](../../../../../../docs/ui/gui/data-display/README.md)

unit GuiGallery.Pages.Lists.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Containers.Accordions as A;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Lists.State as State;
uses GuiGallery.Pages.Lists.Widgets.Invoices as Invoices;
uses GuiGallery.Pages.Lists.Widgets.People as People;
uses GuiGallery.Pages.Lists.Widgets.Tasks as Tasks;
uses GuiGallery.Pages.Lists.Widgets.TreeAndList as TreeAndList;
uses GuiGallery.Shared.Sections as G;

function Question(
  Model: State.Model;
  Index: int;
  Title: string;
  Answer: string
): E.Element of State.Msg;
begin
  return A.Accordion of State.Msg(
    'accordion/' + Index.ToString(), Title, Model.AccordionOpen[Index],
    function(Open: bool): State.Msg => State.Msg.SetAccordion(Index, Open),
    E.Styled of State.Msg(E.Text of State.Msg(Answer), S.Role.Secondary)
  );
end function;

// Reproduces the native Data display sections in their original order.
//
// ## Parameters
// - `Model`: Model-owned expansion for each question.
// ## Returns
// The Data display page sections.
public function View(Model: State.Model): array of E.Element of State.Msg;
begin
  const Items: array of E.Element of State.Msg := [
    Question(
      Model, 0, 'Is it really dependency free?',
      'Yes. The core is plain C99. Windows uses Win32, macOS uses Cocoa and Linux uses X11. Fonts and icons are embedded.'
    ),
    Question(
      Model, 1, 'Can I use my own renderer?',
      'CUI outputs vertices and draw commands. Port the 60 line shader to Vulkan, Metal or Direct3D and you are done.'
    ),
    Question(
      Model, 2, 'Does it respect reduced motion?',
      'Every animation has a reduced motion path that keeps the final state and feedback.'
    )
  ];
  return [
    G.Heading of State.Msg(Strings.Get('Text.Table'), Strings.Get('Heading.TableHint')),
    People.View(Model),
    TreeAndList.View(Model),
    G.Heading of State.Msg(
      Strings.Get('Heading.ReorderableList'),
      Strings.Get('Heading.ReorderableListHint')
    ),
    Tasks.View(Model),
    G.Heading of State.Msg(Strings.Get('Heading.Accordion')),
    Cards.Card of State.Msg('accordion-card', Items, new Cards.Options(PaddingY := 4.0F)),
    G.Heading of State.Msg(
      Strings.Get('Heading.VirtualList'),
      Strings.Get('Heading.VirtualListHint')
    ),
    Invoices.View()
  ];
end function;

end unit;
