// [Documentation](../../../../../../../docs/ui/gui/data-display/virtual-list.md)

unit GuiGallery.Pages.Lists.Widgets.Invoices;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Collections.VirtualLists as V;
uses Fpas.Ui.Widgets.Containers.Cards as C;

uses GuiGallery.Pages.Lists.State as State;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;
uses System.Globalization as Culture;

function Row(Index: int): E.Element of State.Msg;
begin
  const Invariant: Culture.CultureInfo := Culture.CultureInfo.InvariantCulture;
  const Hash: long := (cast (Index + 1) as long * 2654435761L) mod 4294967296L;
  const Dollars: long := 40L + (Hash div 256L) mod 2400L;
  const Cents: long := (Hash div 16L) mod 100L;
  const Title: string := 'Invoice 2026-' + (10000 - Index).ToString('D5', Invariant);
  const Amount: string := '$' + Dollars.ToString(Invariant) + '.' + Cents.ToString('D2', Invariant);
  const Status: string := if (Hash div 1048576L) mod 5L = 0L then
    'Due'
  else
    'Paid'
  end if;
  return E.Row of State.Msg(
    new L.Flow(
      Gap := G.Points(12),
      PaddingStart := G.Points(12),
      PaddingEnd := G.Points(12),
      Clip := false
    ),
    E.Styled of State.Msg(E.Text of State.Msg(Sys.Char.ConvertFromUtf32($E0CC)), S.Role.MutedIcon),
    E.Size of State.Msg(
      E.Styled of State.Msg(
        E.Styled of State.Msg(E.Text of State.Msg(Title), S.Role.SingleLine),
        S.Role.Tabular
      ),
      new L.Flex(Basis := L.Extent.Fill)
    ),
    E.Styled of State.Msg(
      E.Styled of State.Msg(
        E.Styled of State.Msg(E.Text of State.Msg(Amount), S.Role.SingleLine),
        S.Role.SmallBody
      ),
      S.Role.Tabular
    ),
    E.Size of State.Msg(
      E.Styled of State.Msg(
        E.Styled of State.Msg(E.Text of State.Msg(Status), S.Role.Caption),
        S.Role.SingleLine
      ),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(32)))
    )
  );
end function;

// Presents the original ten-thousand-row invoice viewport.
// ## Returns
// A native card around the virtual list.
public function View(): E.Element of State.Msg;
begin
  return C.Card of State.Msg(
    'invoice-card', [
      V.VirtualList of State.Msg(
        'invoices',
        10000,
        36.0F,
        L.Extent.Fixed(L.Measure.Logical(220)),
        Row
      )
    ], new C.Options(Padding := 6.0F)
  );
end function;

end unit;
