// [Documentation](../../../../../../../docs/ui/gui/data-display/table.md)

unit GuiGallery.Pages.Lists.Widgets.People;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Collections.Tables as T;
uses Fpas.Ui.Widgets.Feedback.Badges as B;
uses Fpas.Ui.Widgets.Media.Avatars as A;

uses Gallery.Shared.PeopleTable as People;
uses GuiGallery.Pages.Lists.State as State;
uses System.Collections.Generic as Lists;

function Fixed(Points: int): L.Extent;
begin
  return L.Extent.Fixed(L.Measure.Logical(Points));
end function;

// Draws the original five-person sortable table.
// ## Parameters
// - `Model`: Current sort and selection.
// ## Returns
// The native people table.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  const Rows: Lists.List of T.Row of State.Msg := new Lists.List of T.Row of State.Msg();
  for Item: People.Person in People.Ordered(Model.Sort) do
    const Id: string := Item.Id;
    Rows.Add(
      new T.Row of State.Msg(
        Id, [
          (T.Cell of State.Msg).Content(
            [
              A.Avatar of State.Msg(Id + '/avatar', Item.Name, new A.Options(Size := 26.0F)),
              E.Styled of State.Msg(
                E.Styled of State.Msg(E.Text of State.Msg(Item.Name), S.Role.Strong),
                S.Role.SingleLine
              )
            ]
          ),
          (T.Cell of State.Msg).Content(
            [
              E.Styled of State.Msg(
                E.Styled of State.Msg(E.Text of State.Msg(Item.Email), S.Role.Secondary),
                S.Role.SingleLine
              )
            ]
          ),
          (T.Cell of State.Msg).Text(Item.Role),
          (T.Cell of State.Msg).Content(
            [
              B.Badge of State.Msg(
                Id + '/status',
                Item.Status,
                new B.Options(Tone := Item.Tone, Dot := true)
              )
            ]
          ),
          (T.Cell of State.Msg).Text(Item.Revenue)
        ], Model.Selected = Id
      )
    );
  end for;

  return T.Table of State.Msg(
    'people',
    People.Columns(Fixed(110), Fixed(120), Fixed(110)),
    Rows.ToArray(),
    Model.Sort,
    State.Msg.SetSort,
    State.Msg.SelectPerson
  );
end function;

end unit;
