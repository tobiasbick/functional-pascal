// [Documentation](../../../../../../../docs/ui/gui/data-display/reorderable-list.md)

unit GuiGallery.Pages.Lists.Widgets.Tasks;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as Color;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Collections.ReorderableLists as R;
uses Fpas.Ui.Widgets.Feedback.Badges as B;

uses GuiGallery.Pages.Lists.State as State;

function Row(
  Id: string;
  Title: string;
  Label: string;
  Tone: S.Tone
): array of E.Element of State.Msg;
begin
  return [
    E.FormattedText of State.Msg(
      Title, Color.Font.Body, 0.0F, new Color.Color(0, 0, 0, 0),
      NoWrap := true, Width := L.Extent.Fill
    ),
    B.Badge of State.Msg(Id, Label, new B.Options(Tone := Tone))
  ];
end function;

// Presents the original draggable task rows.
// ## Parameters
// - `Model`: Current task permutation.
// ## Returns
// The native reorderable list.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  const Tasks: E.Element of State.Msg := R.ReorderableList of State.Msg(
    'task-order', [
      Row('task-docs', 'Write the release notes', 'Docs', S.Tone.Info),
      Row('task-video', 'Record the demo video', 'Video', S.Tone.Neutral),
      Row('task-screenshots', 'Update the screenshots', 'Docs', S.Tone.Info),
      Row('task-tag', 'Tag version 1.0', 'Release', S.Tone.Warning),
      Row('task-blog', 'Post the announcement', 'Blog', S.Tone.Teal)
    ], Model.TaskOrder, State.Msg.Reorder
  );
  return E.Size of State.Msg(
    E.Column of State.Msg(new L.Flow(Clip := false), Tasks),
    new L.Flex(Width := new L.AxisSize(Basis := L.Extent.Fill))
  );
end function;

end unit;
