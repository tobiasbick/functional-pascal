// [Documentation](../../../../../../../docs/ui/gui/data-display/tree.md)

unit GuiGallery.Pages.Lists.Widgets.TreeAndList;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Collections.ListItems as I;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Containers.Grids as Grid;

uses Gallery.Shared.ListEntries as List;
uses Gallery.Shared.SourceTree as SourceTree;
uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Lists.State as State;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;

// Builds the original tree and list examples side by side when space allows.
// ## Parameters
// - `Model`: Current tree expansion and selection.
// ## Returns
// The two responsive examples.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  return Grid.Grid<State.Msg>(
    new Grid.Options(Columns := 2, MinimumColumnWidth := 260.0F, Gap := G.Points(16)),
    E.Column<State.Msg>(
      new L.Flow(Gap := G.Points(12), Clip := false),
      G.Heading<State.Msg>(Strings.Get('Heading.TreeView')),
      Cards.Card<State.Msg>(
        'tree-card', [
          SourceTree.View<State.Msg>(
            Model.SourceOpen, Model.ComponentsOpen, Model.AssetsOpen, Model.File,
            State.Msg.SetSource, State.Msg.SetComponents, State.Msg.SetAssets, State.Msg.SelectFile
          )
        ], new Cards.Options(Padding := 10.0F, Gap := 1.0F)
      )
    ),
    E.Column<State.Msg>(
      new L.Flow(Gap := G.Points(12), Clip := false),
      G.Heading<State.Msg>(Strings.Get('Heading.List')),
      Cards.Card<State.Msg>(
        'list-card',
        Sys.Array.ConvertAll<List.Entry, E.Element<State.Msg>>(
          List.Entries,
          function(Item: List.Entry): E.Element<State.Msg> => I.ListItem<State.Msg>(
            Item.Id, Item.Title,
            Settings := new I.Options(
              Avatar := Item.Person, Subtitle := Item.Subtitle, Trailing := Item.Duration,
              Selected := Item.Id = List.Initial
            )
          )
        ), new Cards.Options(Padding := 8.0F, Gap := 2.0F)
      )
    )
  );
end function;

end unit;
