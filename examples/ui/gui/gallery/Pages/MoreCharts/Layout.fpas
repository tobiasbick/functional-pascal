// [Documentation](../../../../../../docs/ui/gui/more-charts/README.md)

unit GuiGallery.Pages.MoreCharts.Layout;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

uses GuiGallery.Shared.Sections as G;

// Builds the native gallery's full-width section row.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Children`: Sections in display order.
// ## Returns
// The native row.
public function Row of TMsg(params Children: array of E.Element of TMsg): E.Element of TMsg;
begin
  return E.Size of TMsg(
    E.Row of TMsg(
      new L.Flow(Gap := G.Points(24), Align := L.Alignment.Start, Clip := false),
      Children
    ),
    new L.Flex(Width := new L.AxisSize(Basis := L.Extent.Fill))
  );
end function;

// Builds a weighted native gallery column.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Weight`: Native positive growth weight.
// - `Centered`: Center children on the cross axis.
// - `Children`: Section content.
// ## Returns
// The native column.
public function Column of TMsg(
  Weight: float;
  Centered: bool;
  params Children: array of E.Element of TMsg
): E.Element of TMsg;
begin
  return E.Size of TMsg(
    E.Column of TMsg(
      new L.Flow(
        Gap := G.Points(10), Clip := false,
        Align := if Centered then
          L.Alignment.Center
        else
          L.Alignment.Default
        end if
      ), Children
    ),
    new L.Flex(Basis := L.Extent.Fill, Grow := Weight)
  );
end function;

end unit;
