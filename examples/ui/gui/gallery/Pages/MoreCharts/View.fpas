// [Documentation](../../../../../../docs/ui/gui/more-charts/README.md)

unit GuiGallery.Pages.MoreCharts.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.CalendarHeatmaps as Calendars;
uses Fpas.Ui.Widgets.Charts.Charts as C;
uses Fpas.Ui.Widgets.Charts.Funnels as Funnels;
uses Fpas.Ui.Widgets.Charts.Heatmaps as Heatmaps;
uses Fpas.Ui.Widgets.Charts.RadarCharts as Radar;
uses Fpas.Ui.Widgets.Charts.SplitBars as Splits;
uses Fpas.Ui.Widgets.Charts.Treemaps as Treemaps;
uses Fpas.Ui.Widgets.Charts.Waffles as Waffles;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.MoreCharts.Data as Data;
uses GuiGallery.Pages.MoreCharts.Layout as Layout;
uses GuiGallery.Pages.MoreCharts.Widgets.Flows as Flows;
uses GuiGallery.Pages.MoreCharts.Widgets.Market as Market;
uses GuiGallery.Shared.Sections as G;

function Matrix of TMsg(Samples: Data.Samples): E.Element of TMsg;
begin
  return Layout.Row of TMsg(
    Layout.Column of TMsg(
      1.0F, false,
      G.Heading of TMsg(Strings.Get('Heading.Heatmap'), Strings.Get('Heading.HeatmapHint')),
      Cards.Card of TMsg(
        'traffic-card', [
          Heatmaps.Heatmap of TMsg(
            'traffic', Samples.Traffic, 7, 24, new Heatmaps.Options(
              RowLabels := ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
              ColumnLabels := [
                '0h',
                '',
                '',
                '3h',
                '',
                '',
                '6h',
                '',
                '',
                '9h',
                '',
                '',
                '12h',
                '',
                '',
                '15h',
                '',
                '',
                '18h',
                '',
                '',
                '21h',
                '',
                ''
              ],
              Format := new C.ValueFormat(Suffix := ' req')
            )
          )
        ],
        new Cards.Options(Padding := 18.0F, Width := L.Extent.Fill)
      )
    )
  );
end function;

function Areas of TMsg(): E.Element of TMsg;
begin
  return Layout.Row of TMsg(
    Layout.Column of TMsg(
      1.3F, false,
      G.Heading of TMsg(Strings.Get('Heading.Treemap'), Strings.Get('Heading.TreemapHint')),
      Treemaps.Treemap of TMsg(
        'bundle', [
          new C.Item('Layout', 55.0F),
          new C.Item('Text', 42.0F),
          new C.Item('Draw', 35.0F),
          new C.Item('Controls', 31.0F),
          new C.Item('Charts', 23.0F),
          new C.Item('Overlays', 19.0F),
          new C.Item('Platform', 16.0F),
          new C.Item('Theme', 9.0F),
          new C.Item('Icons', 7.0F),
          new C.Item('Grid', 6.0F)
        ], new Treemaps.Options(Height := 280.0F, Format := new C.ValueFormat(Suffix := ' KB'))
      )
    ),
    Layout.Column of TMsg(
      1.0F, true,
      G.Heading of TMsg(Strings.Get('Heading.Radar'), Strings.Get('Heading.RadarHint')),
      Radar.RadarChart of TMsg(
        'radar',
        [
          new C.Series('1.0', [82.0F, 64.0F, 90.0F, 58.0F, 75.0F, 88.0F]),
          new C.Series('1.1', [70.0F, 85.0F, 72.0F, 80.0F, 60.0F, 79.0F])
        ],
        ['Speed', 'Size', 'Polish', 'Docs', 'Platforms', 'Tests'],
        new Radar.Options(Size := 220.0F, Maximum := 100.0F)
      )
    )
  );
end function;

function Shares of TMsg(): E.Element of TMsg;
begin
  return Layout.Row of TMsg(
    Layout.Column of TMsg(
      1.0F, false,
      G.Heading of TMsg(Strings.Get('Heading.Funnel'), Strings.Get('Heading.FunnelHint')),
      Funnels.Funnel of TMsg(
        'funnel', [
          new C.Item('Visited', 12840.0F), new C.Item('Signed up', 4210.0F),
          new C.Item('Activated', 2380.0F), new C.Item('Subscribed', 860.0F)
        ]
      )
    ),
    Layout.Column of TMsg(
      1.0F, false,
      G.Heading of TMsg(Strings.Get('Heading.SplitBar'), Strings.Get('Heading.SplitBarHint')),
      Splits.SplitBar of TMsg(
        'split', [
          new C.Item('Layout', 38.0F), new C.Item('Text', 24.0F), new C.Item('Paint', 21.0F),
          new C.Item('Input', 9.0F), new C.Item('Other', 8.0F)
        ], new Splits.Options(Format := new C.ValueFormat(Suffix := ' ms'))
      ),
      E.Gap of TMsg(L.Measure.Logical(18)),
      G.Heading of TMsg(Strings.Get('Heading.Waffle'), Strings.Get('Heading.WaffleHint')),
      Waffles.Waffle of TMsg(
        'waffle',
        [new C.Item('Windows', 46.0F), new C.Item('macOS', 31.0F), new C.Item('Linux', 23.0F)],
        new Waffles.Options(CellSize := 14.0F)
      )
    )
  );
end function;

// Builds all widgets from the native More charts page.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Samples`: Original data and current ranked amounts.
// - `Shuffle`: Replaces the ranked amounts.
// ## Returns
// The complete native More charts page.
public function View of TMsg(Samples: Data.Samples; Shuffle: TMsg): array of E.Element of TMsg;
begin
  return [
    Matrix of TMsg(Samples),
    G.Heading of TMsg(
      Strings.Get('Heading.CalendarHeatmap'),
      Strings.Get('Heading.CalendarHeatmapHint')
    ),
    Cards.Card of TMsg(
      'activity-card', [
        Calendars.CalendarHeatmap of TMsg(
          'activity',
          Samples.Start,
          Samples.Activity,
          new Calendars.Options(Unit := 'contributions')
        )
      ],
      new Cards.Options(Padding := 18.0F)
    ),
    Areas of TMsg(),
    Shares of TMsg(),
    G.Heading of TMsg(Strings.Get('Heading.Sankey'), Strings.Get('Heading.SankeyHint')),
    Flows.Sankey of TMsg(),
    Flows.Ranked of TMsg(Samples, Shuffle),
    G.Heading of TMsg(Strings.Get('Heading.Scatter'), Strings.Get('Heading.ScatterHint')),
    Market.Scatter of TMsg(Samples),
    Market.Gauges of TMsg(),
    Market.Price of TMsg(Samples)
  ];
end function;

end unit;
