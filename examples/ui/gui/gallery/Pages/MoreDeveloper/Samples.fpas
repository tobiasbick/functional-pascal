function Availability(): array of U.Service;
begin
  const Api: array of float := new float[90];
  const Web: array of float := new float[90];
  const Db: array of float := new float[90];
  const Cdn: array of float := new float[90];
  for Day: int := 0 to 89 do
    Api[Day] := if Day = 61 then
      0.962F
    elsif Day mod 17 = 5 then
      0.9985F
    else
      1.0F
    end if;
    Web[Day] := if Day = 44 then
      0.93F
    else
      1.0F
    end if;
    Db[Day] := if Day = 88 then
      0.97F
    elsif Day mod 23 = 9 then
      0.995F
    else
      1.0F
    end if;
    Cdn[Day] := if Day < 20 then
      -1.0F
    else
      1.0F
    end if;
  end for;

  return [
    new U.Service('API', Api),
    new U.Service('Website', Web),
    new U.Service('Database', Db),
    new U.Service('CDN', Cdn)
  ];
end function;

// Original 90-day availability series.
public const Services: array of U.Service := Availability();

function Histograms(): array of H.Series;
begin
  const Info: array of float := new float[96];
  const Warnings: array of float := new float[96];
  const Errors: array of float := new float[96];
  for Index: int := 0 to 95 do
    Info[Index] := cast<float>(120.0 + 80.0 * Sys.Math.Sin(
      Index / 96.0 * 6.28 * 2
    ) + (Index * 37 mod 23));
    Warnings[Index] := cast<float>(12 + (Index * 13 mod 9) + (if Index > 60 and Index < 70 then
      40
    else
      0
    end if));
    Errors[Index] := cast<float>((Index * 7 mod 5) + (if Index > 62 and Index < 67 then
      30
    else
      0
    end if));
  end for;

  return [
    new H.Series('Info', Info, 1),
    new H.Series('Warning', Warnings, 3),
    new H.Series('Error', Errors, 4)
  ];
end function;

// Original 15-minute log count buckets.
public const Histogram: array of H.Series := Histograms();

end unit;
