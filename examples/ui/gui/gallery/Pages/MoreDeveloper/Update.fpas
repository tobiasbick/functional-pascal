// [Documentation](../../../../../../docs/ui/gui/more-developer-tools/http-request-bar.md)

unit GuiGallery.Pages.MoreDeveloper.Update;

uses Fpas.Ui.Gui.UrlParameters as Urls;
uses Fpas.Ui.Widgets.Charts.TimeHistograms as G;
uses Fpas.Ui.Widgets.Developer.ApiExplorers as A;
uses Fpas.Ui.Widgets.Developer.FeatureFlagEditors as F;
uses Fpas.Ui.Widgets.Developer.KeyValueEditors as K;
uses Fpas.Ui.Widgets.Developer.RegexTesters as R;
uses Fpas.Ui.Widgets.Developer.RequestBars as H;

uses GuiGallery.Pages.MoreDeveloper.Samples as D;
uses GuiGallery.Pages.MoreDeveloper.State as M;

function Request(Model: M.Model; Value: H.Event): M.Model;
begin
  if not Value.Changed then
    return Model;
  end if;

  return Model with
    Method := Value.Method;
    Url := Value.Url;
    Parameters := Urls.Parse(Value.Url, D.ParameterCapacity);
  end with;
end function;

function Parameters(Model: M.Model; Value: K.Event): M.Model;
begin
  const Url: string? := Urls.Replace(Model.Url, Value.Pairs, D.RequestCapacity);
  if Url = null then
    return Model;
  end if;

  return Model with
    Url := Url;
    Parameters := Value.Pairs;
  end with;
end function;

function Flag(Model: M.Model; Value: F.Event): M.Model;
begin
  const Flags: array of F.Flag := cast Model.Flags.Clone() as array of F.Flag;
  const Row: F.Flag := Flags[Value.Index];
  const Enabled: array of bool := cast Row.On.Clone() as array of bool;
  const Rollout: array of int := cast Row.Rollout.Clone() as array of int;
  Enabled[Value.Environment] := Value.On;
  Rollout[Value.Environment] := Value.Rollout;
  Flags[Value.Index] := Row with
    On := Enabled;
    Rollout := Rollout;
  end with;
  return Model with
    Flags := Flags;
  end with;
end function;

// Applies an interaction to the More developer tools examples.
// ## Parameters
// - `Model`: Current example state.
// - `Message`: Native widget proposal.
// ## Returns
// Updated example state.
public function Update(Model: M.Model; Message: M.Msg): M.Model;
begin
  return case Message of
    when M.Msg.Regex(const Value: R.Event): Model with
      Pattern := Value.Pattern;
      Sample := Value.Sample;
      Modifiers := Value.Modifiers;
    end with;
    when M.Msg.Request(const Value: H.Event): Request(Model, Value);
    when M.Msg.Parameters(const Value: K.Event): Parameters(Model, Value);
    when M.Msg.Endpoint(const Value: A.Event): Model with
      Endpoint := Value.Selection;
    end with;
    when M.Msg.Flag(const Value: F.Event): Flag(Model, Value);
    when M.Msg.Range(const Value: G.Event): Model with
      Range := new G.Range(Value.Start, Value.End);
    end with;
    else Model;
  end case;
end function;

end unit;
