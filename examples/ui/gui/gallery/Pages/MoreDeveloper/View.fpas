// [Documentation](../../../../../../docs/ui/gui/more-developer-tools/README.md)

unit GuiGallery.Pages.MoreDeveloper.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.TimeHistograms as G;
uses Fpas.Ui.Widgets.Developer.ApiExplorers as A;
uses Fpas.Ui.Widgets.Developer.Blames as B;
uses Fpas.Ui.Widgets.Developer.Coverages as C;
uses Fpas.Ui.Widgets.Developer.FeatureFlagEditors as F;
uses Fpas.Ui.Widgets.Developer.KeyValueEditors as K;
uses Fpas.Ui.Widgets.Developer.RegexTesters as R;
uses Fpas.Ui.Widgets.Developer.RequestBars as H;
uses Fpas.Ui.Widgets.Developer.ResponseStatuses as Status;
uses Fpas.Ui.Widgets.Developer.StackTraces as S;
uses Fpas.Ui.Widgets.Developer.TestExplorers as T;
uses Fpas.Ui.Widgets.Developer.Uptimes as U;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.MoreDeveloper.Samples as D;
uses GuiGallery.Pages.MoreDeveloper.State as M;
uses GuiGallery.Shared.Sections as Section;
uses System as Sys;

function Limit(
  Maximum: int;
  Gap: int;
  params Children: array of E.Element of M.Msg
): E.Element of M.Msg;
begin
  return E.Size of M.Msg(
    E.Column of M.Msg(new L.Flow(Gap := Section.Points(Gap), Clip := false), Children),
    new L.Flex(
      Width := new L.AxisSize(Basis := L.Extent.Fill, Maximum := L.Measure.Logical(Maximum))
    )
  );
end function;

// Builds the original CUI More developer tools page.
// ## Parameters
// - `Model`: Retained page state.
// ## Returns
// Sections and examples in the original order.
public function View(Model: M.Model): array of E.Element of M.Msg;
begin
  return [
    Section.Heading of M.Msg(
      Strings.Get('Heading.TestExplorer'),
      Strings.Get('Heading.TestExplorerHint')
    ),
    Limit(
      760, 10,
      T.TestExplorer of M.Msg('dev-tests', D.Tests, M.Msg.Tests, new T.Options(Height := 500.0F))
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.StackTrace'),
      Strings.Get('Heading.StackTraceHint')
    ),
    Limit(
      760, 10,
      S.StackTrace of M.Msg(
        'dev-stack',
        D.Frames,
        M.Msg.Stack,
        new S.Options(
          Title := 'TypeError',
          Message := 'Cannot read properties of undefined (reading ''items'')',
          Language := 'js'
        )
      )
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.Blame'),
      Strings.Get('Heading.BlameHint')
    ),
    Limit(
      900, 10,
      B.Blame of M.Msg(
        'dev-blame',
        D.Lines,
        D.LineCommits,
        D.Revisions,
        M.Msg.Blame,
        new B.Options(Language := 'c', Now := 1794211200L, Height := 320.0F, FirstLine := 120)
      )
    ),
    Section.Heading of M.Msg(Strings.Get('Heading.Coverage'), Strings.Get('Heading.CoverageHint')),
    Limit(
      820, 10,
      C.Coverage of M.Msg(
        'dev-coverage',
        D.Coverage,
        M.Msg.Coverage,
        new C.Options(Height := 372.0F)
      )
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.RegexTester'),
      Strings.Get('Heading.RegexTesterHint')
    ),
    Limit(
      760, 10,
      R.RegexTester of M.Msg(
        'dev-regex',
        Model.Pattern,
        Model.Sample,
        Model.Modifiers,
        M.Msg.Regex,
        new R.Options(Height := 110.0F)
      )
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.HttpRequestBar'),
      Strings.Get('Heading.HttpRequestBarHint')
    ),
    Limit(
      760, 12,
      H.RequestBar of M.Msg(
        'dev-request', Model.Method, Model.Url, M.Msg.Request,
        new H.Options(Capacity := D.RequestCapacity)
      ),
      K.KeyValueEditor of M.Msg(
        'dev-params',
        Model.Parameters,
        M.Msg.Parameters,
        new K.Options(Capacity := D.ParameterCapacity)
      ),
      Status.ResponseStatus of M.Msg('dev-response', 201, 0.142, 18400.0)
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.ApiExplorer'),
      Strings.Get('Heading.ApiExplorerHint')
    ),
    Limit(
      820, 10,
      A.ApiExplorer of M.Msg('dev-api', D.Endpoints, Model.Endpoint, M.Msg.Endpoint)
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.FeatureFlags'),
      Strings.Get('Heading.FeatureFlagsHint')
    ),
    Limit(
      860, 10,
      F.FeatureFlags of M.Msg('dev-flags', Model.Flags, D.Environments, M.Msg.Flag)
    ),
    Section.Heading of M.Msg(Strings.Get('Heading.Uptime'), Strings.Get('Heading.UptimeHint')),
    Limit(
      860, 10,
      U.Uptime of M.Msg('dev-uptime', D.Services, new Sys.DateOnly(2026, 11, 9))
    ),
    Section.Heading of M.Msg(
      Strings.Get('Heading.TimeHistogram'),
      Strings.Get('Heading.TimeHistogramHint')
    ),
    Limit(
      900, 10,
      G.TimeHistogram of M.Msg(
        'dev-histogram',
        1794240000.0,
        900.0,
        96,
        D.Histogram,
        Model.Range,
        M.Msg.Range,
        new G.Options(Utc := true, Height := 150.0F)
      )
    )
  ];
end function;

end unit;
