unit GuiGallery.Pages.Motion.Clock;

uses
  Fpas.Ui.Mvu.Application as A, System as Sys, System.Diagnostics as Diagnostics,
  System.Threading as Threads, System.Threading.Tasks as Tasks;

// Identity of the playback clock while Motion is visible.
public const Id: string := 'motion-playback-clock';

// Starts the playback clock.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Tick`: Converts elapsed seconds into a message.
// - `OnFailure`: Converts a worker failure into a message.
// - `Interval`: Clock interval in milliseconds.
// - `Identity`: Background effect identity.
// ## Returns
// The cancellable playback command.
public function Start<TMsg>(Tick: function(float): TMsg; OnFailure: function(Sys.Exception): TMsg; Interval: int := 100; Identity: string := 'motion-playback-clock'): A.Command<TMsg>;
  async function Run(Post: function(TMsg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
  begin
    const Clock: Diagnostics.Stopwatch := Diagnostics.Stopwatch.StartNew();
    while not Token.IsCancellationRequested do
      await Tasks.Task.Delay(Interval, Token).ConfigureAwait(false);
      const Seconds: float := cast<float>(Clock.Elapsed.TotalSeconds);
      Clock.Restart();
      await Post(Tick(Seconds)).ConfigureAwait(false);
    end while;
  end function;
begin
  return A.StartBackground<TMsg>(Identity, Run, OnFailure);
end function;

end unit;
