// [Documentation](../../../../../../docs/ui/gui/navigation/README.md)

unit GuiGallery.Pages.Navigation.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Navigation.State as State;
uses GuiGallery.Pages.Navigation.Widgets.Breadcrumb as Breadcrumb;
uses GuiGallery.Pages.Navigation.Widgets.Pagination as Pagination;
uses GuiGallery.Pages.Navigation.Widgets.Stepper as Stepper;
uses GuiGallery.Pages.Navigation.Widgets.Tabs as Tabs;
uses GuiGallery.Shared.Sections as G;

// Builds the accepted controls in the original Navigation page order.
//
// ## Parameters
// - `Model`: Current gallery state.
// ## Returns
// The tabs, breadcrumb, pagination and stepper previews.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  const Trail: E.Element of State.Msg := Breadcrumb.View();
  const Pager: E.Element of State.Msg := Pagination.View(Model);
  return E.Column of State.Msg(
    new L.Flow(Gap := G.Points(20)),
    G.Heading of State.Msg(Strings.Get('Text.Tabs'), Strings.Get('Heading.TabsHint')),
    G.Card of State.Msg(16, Tabs.Rows(Model)),
    G.Heading of State.Msg(Strings.Get('Heading.BreadcrumbAndPagination')),
    G.Card of State.Msg(18, [Trail, Pager]),
    G.Heading of State.Msg(Strings.Get('Heading.Stepper')),
    G.Card of State.Msg(18, Stepper.Rows(Model))
  );
end function;

end unit;
