// [Documentation](../../../../../../../docs/ui/gui/navigation/pagination.md)

unit GuiGallery.Pages.Navigation.Widgets.Pagination;

uses
  GuiGallery.Pages.Navigation.State as State,
  Gallery.Shared.PaginationExample as Sample,
  Fpas.Ui.Elements as E;

// Builds the original twelve-page pager.
//
// ## Parameters
// - `Model`: Current gallery state.
// ## Returns
// The native pagination example.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  return Sample.View<State.Msg>(Model.PageIndex, State.Msg.SetPageIndex);
end function;

end unit;
