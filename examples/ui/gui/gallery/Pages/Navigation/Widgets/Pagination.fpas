// [Documentation](../../../../../../../docs/ui/gui/navigation/pagination.md)

unit GuiGallery.Pages.Navigation.Widgets.Pagination;

uses Fpas.Ui.Elements as E;

uses Gallery.Shared.PaginationExample as Sample;
uses GuiGallery.Pages.Navigation.State as State;

// Builds the original twelve-page pager.
//
// ## Parameters
// - `Model`: Current gallery state.
// ## Returns
// The native pagination example.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  return Sample.View of State.Msg(Model.PageIndex, State.Msg.SetPageIndex);
end function;

end unit;
