// [Documentation](../../../../../../../docs/ui/gui/navigation/stepper.md)

unit GuiGallery.Pages.Navigation.Widgets.Stepper;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Navigation.Steppers as Steppers;

uses GuiGallery.Pages.Navigation.State as State;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;

// Builds the original workflow preview and its Back and Next or Finish buttons.
//
// ## Parameters
// - `Model`: Current gallery state.
// ## Returns
// The native progress display and navigation buttons.
public function Rows(Model: State.Model): array of E.Element of State.Msg;
begin
  const Steps: array of string := ['Account', 'Workspace', 'Invite team', 'Done'];
  const Last: bool := Model.ActiveStep = Steps.Length - 1;
  const Progress: E.Element of State.Msg := Steppers.Stepper of State.Msg(
    'workflow-steps',
    Steps,
    Model.ActiveStep
  );
  const Buttons: E.Element of State.Msg := E.Row of State.Msg(
    new L.Flow(Gap := G.Points(8), Wrap := true),
    B.Button of State.Msg(
      'step-back', 'Back', State.Msg.SetStep(Sys.Math.Max(0, Model.ActiveStep - 1)),
      new B.Options(Enabled := Model.ActiveStep > 0)
    ),
    B.Button of State.Msg(
      'step-next', if Last then
        'Finish'
      else
        'Next'
      end if,
      if Last then
        State.Msg.FinishSteps
      else
        State.Msg.SetStep(Model.ActiveStep + 1)
      end if,
      new B.Options(
        Variant := S.ButtonVariant.Primary,
        IconRight := Sys.Char.ConvertFromUtf32($E049)
      )
    )
  );
  return [Progress, Buttons];
end function;

end unit;
