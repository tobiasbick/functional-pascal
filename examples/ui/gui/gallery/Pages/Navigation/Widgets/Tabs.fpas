// [Documentation](../../../../../../../docs/ui/gui/navigation/tabs.md)

unit GuiGallery.Pages.Navigation.Widgets.Tabs;

uses Fpas.Ui.Elements as E;

uses Gallery.Shared.TabExamples as Sample;
uses GuiGallery.Pages.Navigation.State as State;

// Builds the two original tab previews for the Navigation page.
// ## Parameters
// - `Model`: Current gallery state.
// ## Returns
// Both tab strips and the active underline tab's content.
public function Rows(Model: State.Model): array of E.Element of State.Msg;
begin
  return Sample.Rows of State.Msg(
    Model.ActiveTab,
    Model.ActivePillTab,
    State.Msg.SetTab,
    State.Msg.SetPillTab,
    Graphical := true
  );
end function;

end unit;
