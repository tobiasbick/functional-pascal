// [Documentation](../../../../../../../docs/ui/gui/navigation/tabs.md)

unit GuiGallery.Pages.Navigation.Widgets.Tabs;

uses
  GuiGallery.Pages.Navigation.State as State, Gallery.Shared.TabExamples as Sample, Fpas.Ui.Elements as E;

// Builds the two original tab previews for the Navigation page.
// ## Parameters
// - `Model`: Current gallery state.
// ## Returns
// Both tab strips and the active underline tab's content.
public function Rows(Model: State.Model): array of E.Element<State.Msg>;
begin
  return Sample.Rows<State.Msg>(
    Model.ActiveTab,
    Model.ActivePillTab,
    State.Msg.SetTab,
    State.Msg.SetPillTab
  );
end function;

end unit;
