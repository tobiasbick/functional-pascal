// [Documentation](../../../../../../docs/ui/gui/overlays/README.md)

unit GuiGallery.Pages.Overlays.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

uses GuiGallery.Pages.Overlays.State as S;
uses GuiGallery.Pages.Overlays.Widgets.ContextMenu as Context;
uses GuiGallery.Pages.Overlays.Widgets.Dialog as Dialog;
uses GuiGallery.Pages.Overlays.Widgets.Toast as Toast;
uses GuiGallery.Pages.Overlays.Widgets.Tooltip as Tooltip;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;

// Builds the native overlay triggers and examples.
// ## Parameters
// - `Model`: Overlay visibility.
// - `Data`: Shared form and filter values.
// ## Returns
// The Overlays page.
public function View(Model: S.Model; Data: Demo.Model): E.Element<S.Msg>;
begin
  return E.Column<S.Msg>(
    new L.Flow(Gap := G.Points(20)),
    Dialog.Section(),
    Context.View(Model, Data),
    Toast.View(),
    Tooltip.View()
  );
end function;

end unit;
