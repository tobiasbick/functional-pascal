// [Documentation](../../../../../../../docs/ui/gui/overlays/context-menu.md)

unit GuiGallery.Pages.Overlays.Widgets.ContextMenu;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Display.IconGlyphs as Glyphs;
uses Fpas.Ui.Widgets.Display.Icons as Icons;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Overlays.Menus as M;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses GuiGallery.Pages.Overlays.State as State;
uses GuiGallery.Pages.Overlays.Widgets.Popover as Filter;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;

// Shows the Filters panel and the native right-click area.
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Filter values and visibility.
// ## Returns
// The section heading and native card with the filter and context menu.
public function View(Model: State.Model; Data: Demo.Model): array of E.Element of State.Msg;
begin
  const Target: E.Element of State.Msg := Cards.Card of State.Msg(
    'ctx-area',
    [
      Icons.Icon of State.Msg(Glyphs.Ellipsis, 18.0F, ThemeColor := Themes.ColorToken.TextMuted),
      Texts.Text of State.Msg(
        'Right click this area', Texts.Appearance.Secondary,
        new Texts.Options(Align := Texts.Alignment.Center)
      )
    ],
    new Cards.Options(
      Muted := true,
      Padding := 28.0F,
      Align := L.Alignment.Center,
      Hoverable := true
    )
  );
  return [
    G.Heading of State.Msg('Popover and context menu'),
    Cards.Card of State.Msg(
      'overlays-context-card', [
        E.Row of State.Msg(
          new L.Flow(Gap := G.Points(8), Wrap := true, Clip := false),
          Filter.View(Model, Data)
        ),
        M.ContextMenu of State.Msg(
          'context', Target, [
            (M.Entry of State.Msg).Action(
              new M.Item of State.Msg(
                'cut',
                'Cut',
                State.Msg.Shared(Demo.Msg.MenuChoice('Cut')),
                Glyphs.Scissors,
                Shortcut := 'Ctrl X'
              )
            ),
            (M.Entry of State.Msg).Action(
              new M.Item of State.Msg(
                'copy',
                'Copy',
                State.Msg.Shared(Demo.Msg.MenuChoice('Copy')),
                Glyphs.Copy,
                Shortcut := 'Ctrl C'
              )
            ),
            (M.Entry of State.Msg).Action(
              new M.Item of State.Msg(
                'paste',
                'Paste',
                State.Msg.Shared(Demo.Msg.MenuChoice('Paste')),
                Glyphs.Clipboard,
                Shortcut := 'Ctrl V'
              )
            ),
            (M.Entry of State.Msg).Separator,
            (M.Entry of State.Msg).Action(
              new M.Item of State.Msg(
                'delete',
                'Delete',
                State.Msg.Shared(Demo.Msg.MenuChoice('Delete')),
                Glyphs.Trash2,
                Danger := true
              )
            )
          ]
        )
      ], new Cards.Options(Gap := 16.0F)
    )
  ];
end function;

end unit;
