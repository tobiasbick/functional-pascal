// [Documentation](../../../../../../../docs/ui/gui/overlays/context-menu.md)

unit GuiGallery.Pages.Overlays.Widgets.ContextMenu;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Overlays.Menus as M;

uses GuiGallery.Pages.Overlays.State as State;
uses GuiGallery.Pages.Overlays.Widgets.Popover as Filter;
uses GuiGallery.Shared.State as Demo;
uses System as Sys;

function Icon(Code: int): string;
begin
  return Sys.Char.ConvertFromUtf32(Code);
end function;

// Shows the Filters panel and the native right-click area.
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Filter values and visibility.
// ## Returns
// A muted target with Cut, Copy, Paste and Delete; commands only update preview state.
public function View(Model: State.Model; Data: Demo.Model): E.Element of State.Msg;
begin
  const Target: E.Element of State.Msg := E.Styled of State.Msg(
    E.Column of State.Msg(
      new L.Flow(Padding := L.Spacing.Fixed(L.Measure.Logical(28)), Align := L.Alignment.Center),
      E.Styled of State.Msg(E.Text of State.Msg('Right click this area'), S.Role.Secondary)
    ), S.Role.MutedPanel
  );
  return E.Column of State.Msg(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(16))),
    E.Styled of State.Msg(E.Text of State.Msg('Popover and context menu'), S.Role.Heading),
    E.Styled of State.Msg(
      E.Column of State.Msg(
        new L.Flow(
          Padding := L.Spacing.Fixed(L.Measure.Logical(24)),
          Gap := L.Spacing.Fixed(L.Measure.Logical(16))
        ),
        E.Row of State.Msg(
          new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(8)), Wrap := true),
          Filter.View(Model, Data)
        ),
        M.ContextMenu of State.Msg(
          'context', Target, [
            (M.Entry of State.Msg).Action(
              new M.Item of State.Msg(
                'cut',
                'Cut',
                State.Msg.Shared(Demo.Msg.MenuChoice('Cut')),
                Icon($E14E),
                Shortcut := 'Ctrl X'
              )
            ),
            (M.Entry of State.Msg).Action(
              new M.Item of State.Msg(
                'copy',
                'Copy',
                State.Msg.Shared(Demo.Msg.MenuChoice('Copy')),
                Icon($E09E),
                Shortcut := 'Ctrl C'
              )
            ),
            (M.Entry of State.Msg).Action(
              new M.Item of State.Msg(
                'paste',
                'Paste',
                State.Msg.Shared(Demo.Msg.MenuChoice('Paste')),
                Icon($E085),
                Shortcut := 'Ctrl V'
              )
            ),
            (M.Entry of State.Msg).Separator,
            (M.Entry of State.Msg).Action(
              new M.Item of State.Msg(
                'delete',
                'Delete',
                State.Msg.Shared(Demo.Msg.MenuChoice('Delete')),
                Icon($E18E),
                Danger := true
              )
            )
          ]
        )
      ), S.Role.OutlinedPanel
    )
  );
end function;

end unit;
