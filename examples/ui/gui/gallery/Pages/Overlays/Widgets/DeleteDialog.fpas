// [Documentation](../../../../../../../docs/ui/gui/overlays/dialog.md)

unit GuiGallery.Pages.Overlays.Widgets.DeleteDialog;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.ActionFooters as F;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Overlays.Dialogs as D;

uses GuiGallery.Pages.Overlays.State as State;

// Wraps the active page with the shared project deletion confirmation.
// ## Type parameters
// - `TMsg`: Message type of the containing gallery.
// ## Parameters
// - `Base`: Current gallery view.
// - `Open`: Visibility of the deletion dialog.
// - `Messages`: Maps confirmation messages into the parent session.
// ## Returns
// The active page and its controlled native confirmation.
public function Wrap of TMsg(
  Base: E.Element of TMsg; Open: bool; Messages: function(State.Msg): TMsg
): E.Element of TMsg;
begin
  const Cancel: TMsg := Messages(State.Msg.SetDeleteDialog(false));
  return D.Dialog of TMsg(
    'delete-project', Base,
    F.ActionFooter of TMsg(
      B.Button of TMsg('delete-project-cancel', 'Cancel', Cancel),
      B.Button of TMsg(
        'delete-project-confirm', 'Delete project', Messages(State.Msg.DeleteProject),
        new B.Options(Variant := S.ButtonVariant.Destructive)
      )
    ),
    Open,
    new D.Options(
      'Delete this project?',
      Description := 'This removes the project and its history for everyone. You cannot undo this.',
      Width := 400
    ),
    Cancel
  );
end function;

end unit;
