// [Documentation](../../../../../../../docs/ui/gui/overlays/dialog.md)

unit GuiGallery.Pages.Overlays.Widgets.Dialog;

uses Fpas.Ui.Composition as U;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.ActionFooters as F;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Inputs.TextFields as TextFields;
uses Fpas.Ui.Widgets.Overlays.Dialogs as D;

uses Gallery.Shared.Strings as Strings;
uses Gallery.Shared.SwitchExamples as Switches;
uses GuiGallery.Pages.Overlays.State as State;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;
uses System as Sys;

// Shows the original dialog and sheet triggers on Overlays.
//
// ## Returns
// The native gallery's accepted actions in their original card.
public function Section(): E.Element of State.Msg;
begin
  return E.Column of State.Msg(
    new L.Flow(Gap := G.Points(20)),
    G.Heading of State.Msg(
      Strings.Get('Text.DialogsAndSheets'),
      Strings.Get('Text.OverlayHint')
    ),
    G.Card of State.Msg(
      12, [
        E.Row of State.Msg(
          new L.Flow(Gap := G.Points(8), Wrap := true),
          B.Button of State.Msg(
            'edit-profile-open', Strings.Get('Text.EditProfile'), State.Msg.SetProfileDialog(true),
            new B.Options(Icon := Sys.Char.ConvertFromUtf32($E1F9))
          ),
          B.Button of State.Msg(
            'sheet-open', Strings.Get('Text.OpenSheet'), State.Msg.SetSheet(true),
            new B.Options(Icon := Sys.Char.ConvertFromUtf32($E12A))
          ),
          B.Button of State.Msg(
            'delete-project-open',
            Strings.Get('Text.DeleteProject'),
            State.Msg.SetDeleteDialog(true),
            new B.Options(
              Variant := S.ButtonVariant.Destructive,
              Icon := Sys.Char.ConvertFromUtf32($E18E)
            )
          ),
          B.Button of State.Msg(
            'overlay-palette', Strings.Get('Text.CommandPalette'), State.Msg.SetPalette(true),
            new B.Options(
              Variant := S.ButtonVariant.Outline, Icon := Sys.Char.ConvertFromUtf32($E09A),
              Tooltip := Strings.Get('Text.SearchEverything'), Shortcut := 'Ctrl K'
            )
          )
        )
      ]
    )
  );
end function;

// Presents the original Edit profile dialog over the gallery.
//
// ## Type parameters
// - `TParent`: Message type of the containing application.
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Shared sample profile values and dialog visibility.
// - `Base`: Current gallery view.
// - `Messages`: Embeds this page's messages in the application.
// ## Returns
// The view with the controlled native dialog and action footer.
public function Wrap of TParent(
  Model: State.Model;
  Data: Demo.Model;
  Base: E.Element of TParent;
  Messages: function(State.Msg): TParent
): E.Element of TParent;
begin
  const Content: E.Element of State.Msg := E.Column of State.Msg(
    new L.Flow(Gap := G.Points(16), Align := L.Alignment.Stretch),
    TextFields.TextField of State.Msg(
      'edit-profile-name',
      Data.Name,
      function(SharedValue: string): State.Msg => State.Msg.Shared(Demo.Msg.SetName(SharedValue)),
      new TextFields.Options(Label := Strings.Get('Text.Name'), MaxUtf8Bytes := 63)
    ),
    TextFields.TextField of State.Msg(
      'edit-profile-email',
      Data.Email,
      function(SharedValue: string): State.Msg => State.Msg.Shared(Demo.Msg.SetEmail(SharedValue)),
      new TextFields.Options(
        Label := Strings.Get('Text.Email'),
        Icon := Sys.Char.ConvertFromUtf32($E10F),
        MaxUtf8Bytes := 95
      )
    ),
    Switches.View of State.Msg(
      Switches.PublicProfile,
      Data.Wifi,
      function(SharedValue: bool): State.Msg => State.Msg.Shared(Demo.Msg.SetWifi(SharedValue))
    ),
    F.ActionFooter of State.Msg(
      B.Button of State.Msg(
        'edit-profile-cancel',
        Strings.Get('Text.Cancel'),
        State.Msg.SetProfileDialog(false)
      ),
      B.Button of State.Msg(
        'edit-profile-save', Strings.Get('Text.SaveChanges'), State.Msg.SaveProfile,
        new B.Options(Variant := S.ButtonVariant.Primary)
      )
    )
  );
  return D.Dialog of TParent(
    'edit-profile', Base, U.Map of (State.Msg, TParent)(
      E.Size of State.Msg(Content, new L.Flex(Height := new L.AxisSize(Basis := L.Extent.Fill))),
      Messages
    ), Model.ProfileDialog,
    new D.Options(
      Strings.Get('Text.EditProfile'),
      Description := Strings.Get('Text.ProfileVisibility'),
      Draggable := true,
      Resizable := true
    ),
    Messages(State.Msg.SetProfileDialog(false))
  );
end function;

end unit;
