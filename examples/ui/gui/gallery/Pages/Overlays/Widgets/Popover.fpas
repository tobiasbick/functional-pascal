// [Documentation](../../../../../../../docs/ui/gui/overlays/popover.md)

unit GuiGallery.Pages.Overlays.Widgets.Popover;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Display.IconGlyphs as Glyphs;
uses Fpas.Ui.Widgets.Inputs.Checkboxes as Checks;
uses Fpas.Ui.Widgets.Inputs.Sliders as Sliders;
uses Fpas.Ui.Widgets.Overlays.Popovers as P;

uses GuiGallery.Pages.Overlays.State as State;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;

// Builds the Filters button and the CUI gallery's filter controls.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current filter values and visibility.
// ## Returns
// An anchored panel shown in the Overlays card.
public function View(Model: State.Model; Data: Demo.Model): E.Element of State.Msg;
begin
  const Trigger: E.Element of State.Msg := B.Button of State.Msg(
    'filters-trigger', 'Filters', State.Msg.SetFilters(not Model.Filters),
    new B.Options(Icon := Glyphs.Filter)
  );
  const Children: array of E.Element of State.Msg := [
    E.Styled of State.Msg(E.Text of State.Msg('Filter results'), S.Role.Label),
    Checks.Checkbox of State.Msg(
      'filters-active',
      'Only active',
      Data.Newsletter,
      function(SharedValue: bool): State.Msg => State.Msg.Shared(
        Demo.Msg.SetNewsletter(SharedValue)
      )
    ),
    Checks.Checkbox of State.Msg(
      'filters-archived',
      'Include archived',
      Data.Marketing,
      function(SharedValue: bool): State.Msg => State.Msg.Shared(Demo.Msg.SetMarketing(SharedValue))
    ),
    Sliders.Slider of State.Msg(
      'filters-score',
      'Minimum score',
      Data.Brightness,
      0.0F,
      100.0F,
      function(SharedValue: float): State.Msg => State.Msg.Shared(
        Demo.Msg.SetBrightness(SharedValue)
      ),
      new Sliders.Options(ShowValue := true)
    ),
    E.Row of State.Msg(
      new L.Flow(Gap := G.Points(8), Justify := L.Justification.End, Clip := false),
      B.Button of State.Msg(
        'filters-apply', 'Apply', State.Msg.SetFilters(false),
        new B.Options(Variant := S.ButtonVariant.Primary, ControlSize := B.Size.Small)
      )
    )
  ];
  return P.Popover of State.Msg(
    'filters',
    Trigger,
    Children,
    Model.Filters,
    State.Msg.SetFilters(false),
    new P.Options(Width := 280.0F)
  );
end function;

end unit;
