unit GuiGallery.Pages.Overlays.Widgets.Toast;

uses
  GuiGallery.Shared.State as Demo,
  GuiGallery.Pages.Overlays.State as State,
  GuiGallery.Shared.Sections as G,
  Fpas.Ui.Widgets.Actions.Buttons as B,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L,
  Fpas.Ui.Gui.Toasts as Toasts;

// Builds the four toast triggers from CUI's Overlays page.
//
// ## Returns
// The native gallery section with passive notifications and timed Undo.
public function View(): E.Element<State.Msg>;
begin
  const Buttons: E.Element<State.Msg> := E.Row<State.Msg>(
    new L.Flow(Gap := G.Points(8), Wrap := true),
    B.Button<State.Msg>(
      'toast-save-profile', 'Save profile',
      State.Msg.Shared(
        Demo.Msg.Notify(
          'Changes saved',
          new Toasts.Options(
            Description := 'Your profile is up to date.',
            Appearance := Toasts.Tone.Success
          )
        )
      )
    ),
    B.Button<State.Msg>(
      'toast-upload', 'Upload a 30 MB file',
      State.Msg.Shared(
        Demo.Msg.Notify(
          'Upload failed',
          new Toasts.Options(
            Description := 'The file is larger than 25 MB.',
            Appearance := Toasts.Tone.Danger
          )
        )
      )
    ),
    B.Button<State.Msg>('toast-archive', 'Archive a message', State.Msg.ArchiveMessage),
    B.Button<State.Msg>(
      'toast-update', 'Check for updates',
      State.Msg.Shared(
        Demo.Msg.Notify(
          'Update available',
          new Toasts.Options(
            Description := 'Version 1.1 is ready to install.',
            Appearance := Toasts.Tone.Info
          )
        )
      )
    )
  );
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading<State.Msg>('Toasts', 'They stack, expand on hover and pause while you read.'),
    G.Card<State.Msg>(12, [Buttons])
  );
end function;

end unit;
