// [Documentation](../../../../../../../docs/ui/gui/overlays/toast.md)

unit GuiGallery.Pages.Overlays.Widgets.Toast;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Toasts as Toasts;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Overlays.State as State;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;

// Builds the four toast triggers from CUI's Overlays page.
//
// ## Returns
// The section heading and native card for the toast examples.
public function View(): array of E.Element of State.Msg;
begin
  const Buttons: E.Element of State.Msg := E.Row of State.Msg(
    new L.Flow(Gap := G.Points(8), Wrap := true, Clip := false),
    B.Button of State.Msg(
      'toast-save-profile', 'Save profile',
      State.Msg.Shared(
        Demo.Msg.Notify(
          'Changes saved',
          new Toasts.Options(
            Description := 'Your profile is up to date.',
            Appearance := Toasts.Tone.Success
          )
        )
      )
    ),
    B.Button of State.Msg(
      'toast-upload', 'Upload a 30 MB file',
      State.Msg.Shared(
        Demo.Msg.Notify(
          'Upload failed',
          new Toasts.Options(
            Description := 'The file is larger than 25 MB.',
            Appearance := Toasts.Tone.Danger
          )
        )
      )
    ),
    B.Button of State.Msg(
      'toast-archive', 'Archive a message',
      State.Msg.Shared(
        Demo.Msg.Notify('Message archived', new Toasts.Options(ActionLabel := 'Undo'))
      )
    ),
    B.Button of State.Msg(
      'toast-update', 'Check for updates',
      State.Msg.Shared(
        Demo.Msg.Notify(
          'Update available',
          new Toasts.Options(
            Description := 'Version 1.1 is ready to install.',
            Appearance := Toasts.Tone.Info
          )
        )
      )
    )
  );
  return [
    G.Heading of State.Msg(Strings.Get('Heading.Toasts'), Strings.Get('Heading.ToastsHint')),
    Cards.Card of State.Msg('overlays-toast-card', [Buttons])
  ];
end function;

end unit;
