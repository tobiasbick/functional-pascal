// [Documentation](../../../../../../../docs/ui/gui/overlays/tooltip.md)

unit GuiGallery.Pages.Overlays.Widgets.Tooltip;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icons;
uses Fpas.Ui.Widgets.Overlays.Tooltips as Tips;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Overlays.State as State;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;

function Help(Id: string; Glyph: int; Label: string; Shortcut: string := ''): E.Element of State.Msg;
begin
  return Tips.Tooltip of State.Msg(
    Icons.IconButton of State.Msg(Id, Sys.Char.ConvertFromUtf32(Glyph), Label, State.Msg.Preview),
    Label, Shortcut
  );
end function;

// Builds the native gallery's icon toolbar with pointer hints.
//
// ## Returns
// The Tooltips section of the Overlays page.
public function View(): E.Element of State.Msg;
begin
  return E.Column of State.Msg(
    new L.Flow(Gap := G.Points(20)),
    G.Heading of State.Msg(Strings.Get('Heading.Tooltips')),
    G.Card of State.Msg(
      12, [
        E.Row of State.Msg(
          new L.Flow(Gap := G.Points(4), Wrap := true),
          Help('tooltip-bold', $E05D, 'Bold', 'Ctrl B'),
          Help('tooltip-italic', $E0FB, 'Italic', 'Ctrl I'),
          Help('tooltip-underline', $E19A, 'Underline', 'Ctrl U'),
          E.Divider of State.Msg(),
          Help('tooltip-align', $E185, 'Align left'),
          Help('tooltip-list', $E106, 'Bulleted list'),
          Help('tooltip-link', $E102, 'Insert link')
        )
      ]
    )
  );
end function;

end unit;
