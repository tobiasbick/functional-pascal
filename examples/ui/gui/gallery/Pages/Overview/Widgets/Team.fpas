// [Documentation](../../../../../../../docs/ui/gui/overview/README.md)

unit GuiGallery.Pages.Overview.Widgets.Team;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as Graphics;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Feedback.Badges as Badges;
uses Fpas.Ui.Widgets.Media.Avatars as Avatars;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Overview.State as State;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;
uses System as Sys;
uses System.Collections.Generic as Lists;

type Person = record
  // Display name for the team row and avatar initials.
  public Name: string;
  // Contact caption in the team row.
  public Email: string;
  // Team permission displayed as a badge.
  public Role: string;
  // Avatar presence indicator, or empty for no explicit status.
  public Status: string := '';
end record;

// Builds the original Team card with native presence avatars and role badges.
// ## Parameters
// - `Colors`: Colors from the active gallery theme.
// ## Returns
// The Overview team card.
public function View(Colors: Themes.Palette): E.Element of State.Msg;
begin
  const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
  const People: array of Person := [
    new Person('Jonas Berg', 'jonas@example.com', 'Owner', 'online'),
    new Person('Priya Nair', 'priya@example.com', 'Admin', 'away'),
    new Person('Tomas Rivera', 'tomas@example.com', 'Editor'),
    new Person('Lena Fischer', 'lena@example.com', 'Viewer')
  ];
  const Rows: Lists.List of E.Element of State.Msg := new Lists.List of E.Element of State.Msg();
  Rows.Add(
    E.Row of State.Msg(
      E.Size of State.Msg(
        E.Column of State.Msg(
          new L.Flow(Gap := G.Points(4)),
          E.Styled of State.Msg(E.Text of State.Msg(Strings.Get('Text.Team')), S.Role.Heading),
          E.Styled of State.Msg(
            E.Text of State.Msg(Strings.Get('Text.TeamSummary')),
            S.Role.Secondary
          )
        ),
        Fill
      ),
      B.Button of State.Msg(
        'team-invite', Strings.Get('Text.Invite'), State.Msg.Shared(Demo.Msg.Preview),
        new B.Options(Icon := Sys.Char.ConvertFromUtf32($E1A2), ControlSize := B.Size.Small)
      )
    )
  );
  for Item: Person in People do
    const Key: string := 'team-' + Item.Role.ToLowerInvariant();
    const Tone: S.Tone := if Item.Role = 'Owner' then
      S.Tone.Accent
    else
      S.Tone.Neutral
    end if;
    Rows.Add(
      E.Row of State.Msg(
        new L.Flow(Gap := G.Points(12), PaddingY := G.Points(4), Clip := false),
        Avatars.Avatar of State.Msg(
          Key + '-avatar',
          Item.Name,
          new Avatars.Options(Size := 34.0F, Status := Item.Status)
        ),
        E.Size of State.Msg(
          E.Column of State.Msg(
            new L.Flow(Gap := G.Points(1), Clip := false),
            E.FormattedText of State.Msg(
              Item.Name, Graphics.Font.Medium, 0.0F, Colors.Foreground, NoWrap := true
            ),
            E.FormattedText of State.Msg(
              Item.Email, Graphics.Font.Body, 12.0F, Colors.TextSecondary, NoWrap := true
            )
          ),
          Fill
        ),
        Badges.Badge of State.Msg(
          Key + '-badge',
          Strings.Get('Text.' + Item.Role),
          new Badges.Options(Tone := Tone)
        )
      )
    );
  end for;

  return Cards.Card of State.Msg('team-card', Rows.ToArray());
end function;

end unit;
