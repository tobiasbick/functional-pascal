// [Documentation](../../../../../../../docs/ui/gui/pickers/README.md)

unit GuiGallery.Pages.Pickers.Widgets.DateRange;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Pickers.DateRangeCalendars as C;
uses Fpas.Ui.Widgets.Pickers.DateRangePickers as P;

uses GuiGallery.Pages.Pickers.State as State;
uses GuiGallery.Shared.Sections as G;

// Shows the two original CUI date range fields and inline calendar.
// ## Parameters
// - `Model`: Picker and shared stay selections.
// ## Returns
// The presets and preset-free fields followed by the linked calendar.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  return E.Column of State.Msg(
    new L.Flow(Gap := G.Points(20)),
    E.Row of State.Msg(
      new L.Flow(Gap := G.Points(12), Wrap := true),
      P.DateRangePicker of State.Msg(
        'picker-date-range', Model.DateRange, State.Msg.SetDateRange, new P.Options(Width := 300.0F)
      ),
      P.DateRangePicker of State.Msg(
        'picker-stay',
        Model.Stay,
        State.Msg.SetStay,
        new P.Options(Width := 300.0F, Presets := false)
      )
    ),
    E.Row of State.Msg(
      E.Styled of State.Msg(
        E.Column of State.Msg(
          new L.Flow(Padding := G.Points(16)),
          C.DateRangeCalendar of State.Msg('picker-inline-range', Model.Stay, State.Msg.SetStay)
        ),
        S.Role.OutlinedPanel
      )
    )
  );
end function;

end unit;
