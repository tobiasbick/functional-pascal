// [Documentation](../../../../../../../docs/ui/gui/pickers/README.md)

unit GuiGallery.Pages.Pickers.Widgets.RulerAndHistogram;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.Charts as Charts;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Inputs.HistogramSliders as H;
uses Fpas.Ui.Widgets.Inputs.RulerSliders as R;

uses GuiGallery.Pages.Pickers.State as State;
uses GuiGallery.Shared.Sections as G;

// Shows the original measurement rulers and price histogram.
// ## Parameters
// - `Model`: Model-owned measurements and price interval.
// ## Returns
// The two native rulers and the native histogram card.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  const Height: E.Element of State.Msg := R.RulerSlider of State.Msg(
    'picker-height', 'Height', Model.Height, 120.0F, 220.0F, State.Msg.SetHeight,
    new R.Options(UnitLabel := 'cm')
  );
  const Temperature: E.Element of State.Msg := R.RulerSlider of State.Msg(
    'picker-temperature', 'Temperature', Model.Temperature, 10.0F, 30.0F, State.Msg.SetTemperature,
    new R.Options(
      Step := 0.5F,
      MajorEvery := 4,
      Spacing := 14.0F,
      Format := new Charts.ValueFormat(DecimalPlaces := 1),
      UnitLabel := '°C'
    )
  );
  const Bins: array of float := [
    2.0F, 4.0F, 7.0F, 12.0F, 18.0F, 26.0F, 31.0F, 29.0F, 34.0F, 40.0F, 37.0F, 30.0F,
    24.0F, 22.0F, 18.0F, 15.0F, 11.0F, 9.0F, 7.0F, 5.0F, 4.0F, 3.0F, 2.0F, 1.0F
  ];
  const Price: E.Element of State.Msg := H.HistogramSlider of State.Msg(
    'picker-price', 'Price', Bins, Model.Price, 0.0F, 240.0F, State.Msg.SetPrice,
    new H.Options(Format := new Charts.ValueFormat(Prefix := '$'))
  );
  const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
  return E.Row of State.Msg(
    new L.Flow(Gap := G.Points(24), Align := L.Alignment.Start, Clip := false),
    E.Size of State.Msg(
      E.Column of State.Msg(new L.Flow(Gap := G.Points(20), Clip := false), Height, Temperature),
      Fill
    ),
    Cards.Card of State.Msg(
      'picker-price-card',
      [Price, Texts.Text of State.Msg('1,204 listings in range', Texts.Appearance.Muted)],
      new Cards.Options(Width := L.Extent.Fill, Gap := 6.0F)
    )
  );
end function;

end unit;
