// [Documentation](../../../../../../../docs/ui/gui/pickers/README.md)

unit GuiGallery.Pages.Pickers.Widgets.WheelsAndDial;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Pickers.TimeDials as D;
uses Fpas.Ui.Widgets.Pickers.WheelPickers as W;

uses GuiGallery.Pages.Pickers.State as State;
uses GuiGallery.Shared.Sections as G;
uses System.Collections.Generic as Generic;
uses System.Globalization as Culture;

function Numbered(First: int; Count: int): array of string;
begin
  const Captions: Generic.List of string := new Generic.List of string(Count);
  for Index: int := 0 to Count - 1 do
    Captions.Add((First + Index).ToString(Culture.CultureInfo.InvariantCulture));
  end for;

  return Captions.ToArray();
end function;

// Shows the original joined date reel and analog dial.
// ## Parameters
// - `Model`: Model-owned wheel indices and dial time.
// ## Returns
// The three native wheels and the time dial.
public function View(Model: State.Model): E.Element of State.Msg;
begin
  const Months: array of string := [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'
  ];
  const Reel: E.Element of State.Msg := Cards.Card of State.Msg(
    'picker-wheel-reel', [
      W.WheelPicker of State.Msg(
        'picker-wheel-day', Numbered(1, 31), Model.Day, State.Msg.SetDay,
        new W.Options(
          Width := L.Extent.Fixed(L.Measure.Logical(64)),
          Loop := true,
          JoinRight := true
        )
      ),
      W.WheelPicker of State.Msg(
        'picker-wheel-month', Months, Model.Month, State.Msg.SetMonth,
        new W.Options(
          Width := L.Extent.Fixed(L.Measure.Logical(128)), Loop := true,
          JoinLeft := true, JoinRight := true
        )
      ),
      W.WheelPicker of State.Msg(
        'picker-wheel-year', Numbered(2020, 12), Model.Year, State.Msg.SetYear,
        new W.Options(Width := L.Extent.Fixed(L.Measure.Logical(80)), JoinLeft := true)
      )
    ], new Cards.Options(Direction := Cards.Arrangement.Row, Padding := 8.0F)
  );
  return E.Row of State.Msg(
    new L.Flow(Gap := G.Points(32), Align := L.Alignment.Center, Clip := false),
    Reel,
    D.TimeDial of State.Msg(
      'picker-time-dial',
      Model.DialTime,
      State.Msg.SetDialTime,
      Size := 232.0F
    )
  );
end function;

end unit;
