// [Documentation](../../../../../../docs/ui/gui/planning/README.md)

unit GuiGallery.Pages.Planning.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Planning.Gantts as Timeline;
uses Fpas.Ui.Widgets.Planning.MonthCalendars as Month;
uses Fpas.Ui.Widgets.Planning.WeekCalendars as W;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Planning.Board as Board;
uses GuiGallery.Pages.Planning.State as M;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;
uses System.Collections.Generic as Lists;

// Original month appointments positioned relative to the current month.
// ## Parameters
// - `Today`: Date used for the examples.
// ## Returns
// The twelve original appointments.
public function MonthEvents(Today: Sys.DateOnly): array of Month.Appointment;
begin
  const First: Sys.DateOnly := new Sys.DateOnly(Today.Year, Today.Month, 1);
  const Names: array of string := [
    'Standup', 'Design review', 'Offsite', '1:1', 'Release', 'Planning',
    'Customer call', 'Lunch', 'Retro', 'Holiday', 'Demo', 'Board meeting'
  ];
  const Result: Lists.List of Month.Appointment := new Lists.List of Month.Appointment();
  for Index: int := 0 to Names.Length - 1 do
    const Start: Sys.DateOnly := First.AddDays((Index * 5) mod 27);
    const Span: bool := Index = 2 or Index = 9;
    const Finish: Sys.DateOnly? := if Span then
      Start.AddDays(2)
    else
      null
    end if;
    Result.Add(
      new Month.Appointment(
        Names[Index], Start, Finish,
        9.0F + cast<float>(Index mod 8), Span or Index = 4, cast<S.Tone>(1 + Index mod 8)
      )
    );
  end for;

  return Result.ToArray();
end function;

// Displays the original Planning sections.
// ## Parameters
// - `Model`: Current board and schedule.
// ## Returns
// Native examples in gallery order.
public function View(Model: M.Model): array of E.Element of M.Msg;
begin
  const Day: int := (cast<int>(Model.Today.DayOfWeek) + 6) mod 7;
  const Monday: Sys.DateOnly := Model.Today.AddDays(-Day);
  return [
    G.Heading of M.Msg(
      Strings.Get('Heading.Kanban'),
      Strings.Get('Heading.KanbanHint')
    ),
    Board.View(Model),
    G.Heading of M.Msg(
      Strings.Get('Heading.WeekCalendar'),
      Strings.Get('Heading.WeekCalendarHint')
    ),
    W.WeekCalendar of M.Msg(
      'planning-week', new W.Value(Monday, Model.Events), M.Msg.Week,
      new W.Options(
        StartHour := 8.0F,
        EndHour := 19.0F,
        Height := L.Extent.Fixed(L.Measure.Logical(420))
      )
    ),
    G.Heading of M.Msg(
      Strings.Get('Heading.Gantt'),
      Strings.Get('Heading.GanttHint')
    ),
    Timeline.Gantt of M.Msg(
      'planning-gantt', new Timeline.Value(Monday.AddDays(-7), 42, Model.Tasks),
      M.Msg.Timeline, new Timeline.Options(Today := 7 + Day)
    ),
    G.Heading of M.Msg(
      Strings.Get('Heading.MonthCalendar'),
      Strings.Get('Heading.MonthCalendarHint')
    ),
    Month.MonthCalendar of M.Msg(
      'planning-month',
      new Month.Value(Model.Month ?? Model.Today, MonthEvents(Model.Today), Model.Selected),
      M.Msg.Month,
      new Month.Options(Today := Model.Today)
    )
  ];
end function;

end unit;
