// [Documentation](../../../../../../docs/ui/gui/reader/README.md)

unit GuiGallery.Pages.Reader.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Navigation.ScrollAnchors as A;
uses Fpas.Ui.Widgets.Navigation.TableOfContents as T;

uses GuiGallery.Shared.Sections as G;
uses System.Collections.Generic as Lists;

const Paragraph: string := 'Components are functions. They draw themselves, handle input and return what happened. Your variables are the ' +
  'source of truth, so there is nothing to keep in sync, and conditional interface is just an if statement. ';

// Builds the original Reader example with native anchor navigation.
// ## Type parameters
// - `TMsg`: Gallery message type.
// ## Returns
// The article viewport and its outline.
public function View of TMsg(): E.Element of TMsg;
begin
  const Items: array of T.Item := [
    new T.Item('Introduction', 'intro'), new T.Item('Install', 'install'),
    new T.Item('With CMake', 'cmake', 1), new T.Item('Without CMake', 'nocmake', 1),
    new T.Item('First window', 'window'), new T.Item('Immediate mode', 'imm'),
    new T.Item('Layout', 'layout'), new T.Item('Next steps', 'next')
  ];
  const Sections: Lists.List of E.Element of TMsg := new Lists.List of E.Element of TMsg();
  const Body: E.Element of TMsg := E.Styled of TMsg(E.Text of TMsg(Paragraph), S.Role.Secondary);
  for Item: T.Item in Items do
    Sections.Add(A.ScrollAnchor of TMsg(Item.Anchor));
    Sections.Add(
      E.Styled of TMsg(
        E.Text of TMsg(Item.Title), if Item.Level = 0 then
          S.Role.SectionTitle
        else
          S.Role.Heading
        end if
      )
    );
    for Index: int := 1 to 3 do
      Sections.Add(Body);
    end for;
  end for;

  Sections.Add(G.Space of TMsg(200));
  const Article: E.Element of TMsg := E.ScrollView of TMsg(
    'reader',
    E.Column of TMsg(new L.Flow(Gap := G.Points(14), Clip := false), Sections.ToArray()),
    FadeEdges := true
  );
  return E.Row of TMsg(
    new L.Flow(Gap := G.Points(28), Align := L.Alignment.Start),
    E.Size of TMsg(
      E.Column of TMsg(
        E.Size of TMsg(Article, new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(560))))
      ),
      new L.Flex(Basis := L.Extent.Fill)
    ),
    E.Size of TMsg(
      E.Column of TMsg(
        new L.Flow(Gap := G.Points(10), Clip := false),
        E.Styled of TMsg(
          E.Styled of TMsg(E.Text of TMsg('On this page'), S.Role.Strong),
          S.Role.Caption
        ),
        T.TableOfContents of TMsg('reader-outline', 'reader', Items)
      ),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(200)))
    )
  );
end function;

end unit;
