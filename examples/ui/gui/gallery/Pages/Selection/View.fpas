// [Documentation](../../../../../../docs/ui/gui/selection/README.md)

unit GuiGallery.Pages.Selection.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;
uses Fpas.Ui.Widgets.Containers.Grids as Grids;

uses Gallery.Shared.CheckboxExamples as Checkbox;
uses Gallery.Shared.SaveFrequency as Frequency;
uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.Selection.State as State;
uses GuiGallery.Pages.Selection.Widgets.Chip as Chip;
uses GuiGallery.Pages.Selection.Widgets.RadioCards as RadioCards;
uses GuiGallery.Pages.Selection.Widgets.RangeSlider as RangeSlider;
uses GuiGallery.Pages.Selection.Widgets.Rating as Rating;
uses GuiGallery.Pages.Selection.Widgets.Slider as Slider;
uses GuiGallery.Pages.Selection.Widgets.Switch as Switch;
uses GuiGallery.Shared.Sections as G;
uses GuiGallery.Shared.State as Demo;

// Builds the accepted controls in CUI's Selection page order.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current controlled values.
// - `WeeklySummary`: The workspace preference shown in the disabled example.
// ## Returns
// The native grid, headings, and cards in page order.
public function View(
  Model: State.Model;
  Data: Demo.Model;
  WeeklySummary: bool
): array of E.Element of State.Msg;
begin
  const SectionFlow: L.Flow := new L.Flow(Gap := G.Points(12), Clip := false);
  const Checkboxes: E.Element of State.Msg := E.Column of State.Msg(
    SectionFlow, G.Heading of State.Msg(Strings.Get('Text.Checkbox')), Cards.Card of State.Msg(
      'selection-checkbox-card', Checkbox.Rows of State.Msg(
        Data.Newsletter,
        Data.Marketing,
        WeeklySummary,
        function(Value: bool): State.Msg => State.Msg.Shared(Demo.Msg.SetNewsletter(Value)),
        function(Value: bool): State.Msg => State.Msg.Shared(
          Demo.Msg.SetMarketing(Value)
        ),
        State.Msg.Preview
      ), new Cards.Options(Gap := 14.0F)
    )
  );
  const Switches: E.Element of State.Msg := E.Column of State.Msg(
    SectionFlow,
    G.Heading of State.Msg(Strings.Get('Text.Switch')),
    Cards.Card of State.Msg(
      'selection-switch-card',
      Switch.Rows(Model, Data),
      new Cards.Options(Gap := 14.0F)
    )
  );
  return [
    Grids.Grid of State.Msg(
      new Grids.Options(Columns := 2, MinimumColumnWidth := 260.0F, Gap := G.Points(16)),
      Checkboxes, Switches
    ),
    G.Heading of State.Msg(Strings.Get('Text.RadioGroup')),
    Cards.Card of State.Msg(
      'selection-radio-card',
      Frequency.Rows of State.Msg(Model.SaveFrequency, State.Msg.SetSaveFrequency),
      new Cards.Options(Gap := 12.0F)
    ),
    G.Heading of State.Msg(
      Strings.Get('Heading.RadioCards'),
      Strings.Get('Heading.RadioCardsHint')
    ),
    RadioCards.View(Model),
    G.Heading of State.Msg(Strings.Get('Heading.Sliders'), Strings.Get('Heading.SlidersHint')),
    Cards.Card of State.Msg(
      'selection-sliders-card',
      [Slider.Volume(Model, Data), Slider.Brightness(Model, Data), RangeSlider.View(Model, Data)],
      new Cards.Options(Gap := 20.0F)
    ),
    G.Heading of State.Msg(Strings.Get('Heading.ChipsAndRating')),
    Cards.Card of State.Msg(
      'selection-chips-card', [Chip.View(Model, Data), Rating.View(Model, Data)],
      new Cards.Options(Gap := 16.0F)
    )
  ];
end function;

end unit;
