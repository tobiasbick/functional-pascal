unit GuiGallery.Pages.Selection.Widgets.Checkbox;

uses
  GuiGallery.Shared.State as Demo,
  GuiGallery.Pages.Selection.State as State,
  Fpas.Ui.Checkboxes as C,
  Fpas.Ui.Elements as E;

// Builds the three checkboxes from the native Selection page.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current notification choices.
// ## Returns
// The independent notification rows and disabled example.
public function Rows(Model: State.Model; Data: Demo.Model): array of E.Element<State.Msg>;
begin
  return [
    C.Checkbox<State.Msg>(
      'newsletter',
      'Email notifications',
      Data.Newsletter,
      function(SharedValue: bool): State.Msg => State.Msg.Shared(
        Demo.Msg.SetNewsletter(SharedValue)
      ),
      Description := 'Product news, at most once a month.'
    ),
    C.Checkbox<State.Msg>(
      'marketing',
      'Marketing',
      Data.Marketing,
      function(SharedValue: bool): State.Msg => State.Msg.Shared(
        Demo.Msg.SetMarketing(SharedValue)
      ),
      Description := 'Offers from our partners.'
    ),
    C.Checkbox<State.Msg>(
      'disabled-option', 'Disabled option', false,
      function(Value: bool): State.Msg => State.Msg.Preview, Enabled := false
    )
  ];
end function;
end unit;
