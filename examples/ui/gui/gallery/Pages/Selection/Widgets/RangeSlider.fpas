// [Documentation](../../../../../../../docs/ui/gui/selection/range-slider.md)

unit GuiGallery.Pages.Selection.Widgets.RangeSlider;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Inputs.RangeSliders as R;

uses GuiGallery.Pages.Selection.State as State;
uses GuiGallery.Shared.State as Demo;

// Builds the native Selection page's two-endpoint price slider.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current gallery state.
// ## Returns
// The price range slider.
public function View(Model: State.Model; Data: Demo.Model): E.Element of State.Msg;
begin
  return R.RangeSlider of State.Msg(
    'price-range', 'Price range', new R.Interval(Model.PriceLower, Model.PriceUpper),
    0.0F, 100.0F, State.Msg.SetPrice
  );
end function;

end unit;
