unit GuiGallery.Pages.Selection.Widgets.RangeSlider;

uses
  GuiGallery.Shared.State as Demo,
  GuiGallery.Pages.Selection.State as State,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Widgets.Inputs.RangeSliders as R;

// Builds the native Selection page's two-endpoint price slider.
//
// ## Parameters
// - `Data`: Shared demo values owned by the application.
// - `Model`: Current gallery state.
// ## Returns
// The price range slider.
public function View(Model: State.Model; Data: Demo.Model): E.Element<State.Msg>;
begin
  return R.RangeSlider<State.Msg>(
    'price-range', 'Price range', new R.Interval(Model.PriceLower, Model.PriceUpper),
    0.0F, 100.0F, State.Msg.SetPrice
  );
end function;

end unit;
