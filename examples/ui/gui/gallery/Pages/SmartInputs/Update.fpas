unit GuiGallery.Pages.SmartInputs.Update;

uses
  Fpas.Ui.ShortcutRecorders as Keys,
  Fpas.Ui.Mvu.Application as Mvu,
  GuiGallery.Pages.SmartInputs.State as S, Fpas.Ui.EmojiPickers as Emojis, System.Text as Text;

function ApplyEmoji(State: S.Model; Change: Emojis.Change): S.Model;
begin
  const Chosen: string? := Change.Emoji;
  const Combined: string := State.Message + (Chosen ?? '');
  const Insert: bool := Chosen <> null and Text.Encoding.UTF8.GetByteCount(
    Combined
  ) <= S.MessageCapacity;
  return State with
    Emoji := Change.Value;
    Message := if Insert then
      Combined
    else
      State.Message
    end if;
    EmojiOpen := State.EmojiOpen and not Insert;
  end with;
end function;

// Applies a message to this feature and describes its effects.
// ## Parameters
// - `State`: Current feature model.
// - `Message`: Feature message.
// ## Returns
// Next feature model and commands.
public function Update(State: S.Model; Message: S.Msg): Mvu.Transition<S.Model, S.Msg>;
begin
  const Next: S.Model := case Message of
    when S.Msg.SetTitle(const Value: string): State with
      Title := Value;
    end with;
    when S.Msg.SetOwner(const Value: string): State with
      Owner := Value;
    end with;
    when S.Msg.SetOpacity(const Value: float): State with
      Opacity := Value;
    end with;
    when S.Msg.SetRadius(const Value: float): State with
      Radius := Value;
    end with;
    when S.Msg.SetBlur(const Value: float): State with
      Blur := Value;
    end with;
    when S.Msg.SetAmount(const Value: double): State with
      Amount := Value;
    end with;
    when S.Msg.SetSalary(const Value: double): State with
      Salary := Value;
    end with;
    when S.Msg.SetPaletteKey(const Value: Keys.Combination): State with
      PaletteKey := Value;
    end with;
    when S.Msg.SetSearchKey(const Value: Keys.Combination): State with
      SearchKey := Value;
    end with;
    when S.Msg.SetUrl(const Value: string): State with
      Url := Value;
    end with;
    when S.Msg.SetWeight(const Value: string): State with
      Weight := Value;
    end with;
    when S.Msg.SetMessage(const Value: string): State with
      Message := Value;
    end with;
    when S.Msg.SetEmojiOpen(const Open: bool): State with
      EmojiOpen := Open;
    end with;
    when S.Msg.ChangeEmoji(const Change: Emojis.Change): ApplyEmoji(State, Change);
    else State;
  end case;
  return new Mvu.Transition<S.Model, S.Msg>(Next, []);
end function;

end unit;
