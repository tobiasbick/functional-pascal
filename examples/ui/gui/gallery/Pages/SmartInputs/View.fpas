// [Documentation](../../../../../../docs/ui/gui/smart-inputs/README.md)

unit GuiGallery.Pages.SmartInputs.View;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Inputs.ShortcutRecorders as Keys;
uses Fpas.Ui.Widgets.Inputs.TextFields as F;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.SmartInputs.State as State;
uses GuiGallery.Pages.SmartInputs.Widgets.Editors as Editors;
uses GuiGallery.Pages.SmartInputs.Widgets.EmojiMessage as EmojiMessage;
uses GuiGallery.Shared.Sections as G;
uses System.Collections.Generic as Lists;

// Builds the complete original Smart inputs page with native CUI widgets.
//
// ## Parameters
// - `Model`: Editable field values and emoji preferences.
// ## Returns
// Inline edits, scrub and money fields, affixes, shortcut recording and emoji.
public function View(Model: State.Model): array of E.Element of State.Msg;
begin
  const Parts: Lists.List of E.Element of State.Msg := new Lists.List of E.Element of State.Msg();
  Parts.AddRange(Editors.Inline(Model));
  Parts.AddRange(Editors.Scrub(Model));
  Parts.AddRange(Editors.Money(Model));
  Parts.AddRange(
    [
      G.Heading of State.Msg(
        Strings.Get('Heading.PrefixAndSuffix'),
        Strings.Get('Heading.PrefixAndSuffixHint')
      ),
      E.Row of State.Msg(
        new L.Flow(Gap := G.Points(12), Wrap := true, Clip := false),
        F.TextField of State.Msg(
          'input-url',
          Model.Url,
          State.Msg.SetUrl,
          new F.Options(
            Prefix := 'https://',
            MaxUtf8Bytes := 95,
            Width := L.Extent.Fixed(L.Measure.Logical(260))
          )
        ),
        F.TextField of State.Msg(
          'input-weight',
          Model.Weight,
          State.Msg.SetWeight,
          new F.Options(
            Suffix := 'kg',
            MaxUtf8Bytes := 15,
            Width := L.Extent.Fixed(L.Measure.Logical(120))
          )
        )
      ),
      G.Heading of State.Msg(
        Strings.Get('Heading.ShortcutRecorder'),
        Strings.Get('Heading.ShortcutRecorderHint')
      ),
      E.Row of State.Msg(
        new L.Flow(Gap := G.Points(12), Wrap := true, Clip := false),
        Keys.ShortcutRecorder of State.Msg(
          'palette-key',
          Model.PaletteKey,
          State.Msg.SetPaletteKey
        ),
        Keys.ShortcutRecorder of State.Msg(
          'search-key', Model.SearchKey, State.Msg.SetSearchKey,
          new Keys.Options(Placeholder := 'Record shortcut')
        )
      )
    ]
  );
  Parts.AddRange(EmojiMessage.View(Model));
  return Parts.ToArray();
end function;

end unit;
