unit GuiGallery.Pages.SmartInputs.Widgets.EmojiMessage;

uses
  GuiGallery.Pages.SmartInputs.State as State, GuiGallery.Shared.Sections as G,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Inputs.TextFields as F,
  Fpas.Ui.Widgets.Pickers.EmojiPickers as Emoji, Fpas.Ui.Widgets.Actions.IconButtons as B, Fpas.Ui.Widgets.Overlays.Popovers as P,
  Fpas.Ui.Widgets.Overlays.Menus as M, System as Sys;

// Shows the original Smart inputs message field with the native emoji palette.
// ## Parameters
// - `Model`: Editable message, visibility and emoji preferences.
// ## Returns
// The original Emoji picker section.
public function View(Model: State.Model): array of E.Element<State.Msg>;
begin
  const Message: E.Element<State.Msg> := F.TextField<State.Msg>(
    'smart-message', Model.Message, State.Msg.SetMessage,
    new F.Options(MaxUtf8Bytes := State.MessageCapacity)
  );
  const Button: E.Element<State.Msg> := B.IconButton<State.Msg>(
    'smart-emoji-trigger', Sys.Char.ConvertFromUtf32($E164), 'Emoji',
    State.Msg.SetEmojiOpen(not Model.EmojiOpen)
  );
  const Picker: E.Element<State.Msg> := Emoji.EmojiPicker<State.Msg>(
    'smart-emoji', Model.Emoji, State.Msg.ChangeEmoji, new Emoji.Options(Height := 260.0F)
  );
  const Popup: E.Element<State.Msg> := P.Popover<State.Msg>(
    'smart-emoji-popup', Button, Picker, Model.EmojiOpen, State.Msg.SetEmojiOpen(false),
    new P.Options(Position := M.Placement.BottomEnd, Width := 340)
  );
  return [
    G.Heading<State.Msg>(
      'Emoji picker', 'Search by name, jump by group, pick a skin tone. Recent emoji come first.'
    ),
    E.Row<State.Msg>(
      E.Size<State.Msg>(
        E.Row<State.Msg>(
          new L.Flow(Gap := G.Points(8), Align := L.Alignment.Center),
          E.Size<State.Msg>(Message, new L.Flex(Basis := L.Extent.Fill)),
          Popup
        ),
        new L.Flex(Basis := L.Extent.Fill, Maximum := L.Measure.Logical(480))
      )
    )
  ];
end function;

end unit;
