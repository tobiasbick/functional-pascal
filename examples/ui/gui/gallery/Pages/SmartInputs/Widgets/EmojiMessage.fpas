// [Documentation](../../../../../../../docs/ui/gui/smart-inputs/emoji-picker.md)

unit GuiGallery.Pages.SmartInputs.Widgets.EmojiMessage;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.IconButtons as B;
uses Fpas.Ui.Widgets.Inputs.TextFields as F;
uses Fpas.Ui.Widgets.Overlays.Menus as M;
uses Fpas.Ui.Widgets.Overlays.Popovers as P;
uses Fpas.Ui.Widgets.Pickers.EmojiPickers as Emoji;

uses Gallery.Shared.Strings as Strings;
uses GuiGallery.Pages.SmartInputs.State as State;
uses GuiGallery.Shared.Sections as G;
uses System as Sys;

// Shows the original Smart inputs message field with the native emoji palette.
// ## Parameters
// - `Model`: Editable message, visibility and emoji preferences.
// ## Returns
// The original Emoji picker section.
public function View(Model: State.Model): array of E.Element of State.Msg;
begin
  const Message: E.Element of State.Msg := F.TextField of State.Msg(
    'smart-message', Model.Message, State.Msg.SetMessage,
    new F.Options(MaxUtf8Bytes := State.MessageCapacity)
  );
  const Button: E.Element of State.Msg := B.IconButton of State.Msg(
    'smart-emoji-trigger', Sys.Char.ConvertFromUtf32($E164), 'Emoji',
    State.Msg.SetEmojiOpen(not Model.EmojiOpen)
  );
  const Picker: E.Element of State.Msg := Emoji.EmojiPicker of State.Msg(
    'smart-emoji', Model.Emoji, State.Msg.ChangeEmoji, new Emoji.Options(Height := 260.0F)
  );
  const Popup: E.Element of State.Msg := P.Popover of State.Msg(
    'smart-emoji-popup', Button, [Picker], Model.EmojiOpen, State.Msg.SetEmojiOpen(false),
    new P.Options(Position := M.Placement.BottomEnd, Width := 340.0F)
  );
  return [
    G.Heading of State.Msg(
      Strings.Get('Heading.EmojiPicker'), Strings.Get('Heading.EmojiPickerHint')
    ),
    E.Row of State.Msg(
      E.Size of State.Msg(
        E.Row of State.Msg(
          new L.Flow(Gap := G.Points(8), Align := L.Alignment.Center),
          E.Size of State.Msg(Message, new L.Flex(Basis := L.Extent.Fill)),
          Popup
        ),
        new L.Flex(Basis := L.Extent.Fill, Maximum := L.Measure.Logical(480))
      )
    )
  ];
end function;

end unit;
