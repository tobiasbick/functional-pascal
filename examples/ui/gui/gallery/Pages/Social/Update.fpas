unit GuiGallery.Pages.Social.Update;

uses GuiGallery.Pages.Social.State as S, Fpas.Ui.Widgets.Conversation.Comments as Comments, Fpas.Ui.Widgets.Media.ImageViewers as Viewer, Fpas.Ui.Widgets.Media.ImageCroppers as Cropper, Fpas.Ui.Widgets.Containers.CardStacks as Deck, Fpas.Ui.Mvu.Application as A, Fpas.Ui.Gui.Toasts as Toasts;

// Applies changes to the social examples.
// ## Parameters
// - `Model`: Previous social state.
// - `Message`: The native widget action.
// ## Returns
// The updated model and any toast for a dismissed card.
public function Update(Model: S.Model; Message: S.Msg): A.Transition<S.Model, S.Msg>;
  function Apply(): S.Model;
  begin
    case Message of
      when S.Msg.Slide(const Index: int):
        return Model with
          Slide := Index;
        end with;
      when S.Msg.Picture(const Value: Viewer.Value):
        return Model with
          Picture := Value;
        end with;
      when S.Msg.Crop(const Value: Cropper.Value):
        return Model with
          Crop := Value;
        end with;
      when S.Msg.Divider(const Position: float):
        return Model with
          Divider := Position;
        end with;
      when S.Msg.Swipe(_):
        return Model with
          Destination := (Model.Destination + 1) mod 5;
        end with;
      when S.Msg.Sale:
        return Model with
          Revenue := Model.Revenue + 1287.0;
        end with;
      when S.Msg.Comment(const Index: int, const Change: Comments.Event):
        case Change of
          when Comments.Event.Like(const Value: Comments.Value):
            const Likes: array of Comments.Value := cast<array of Comments.Value>(Model.Likes.Clone());
            Likes[Index] := Value;
            return Model with
              Likes := Likes;
            end with;
          when Comments.Event.Reply:
            return Model;
        end case;
    end case;
  end function;
begin
  const Next: S.Model := Apply();
  case Message of
    when S.Msg.Swipe(const Direction: Deck.Direction):
      return new A.Transition<S.Model, S.Msg>(
        Next, [
          Toasts.Show<S.Msg>(
            if Direction = Deck.Direction.Right then
              'Saved'
            else
              'Skipped'
            end if
          )
        ]
      );
    else
      return new A.Transition<S.Model, S.Msg>(Next, []);
  end case;
end function;

end unit;
