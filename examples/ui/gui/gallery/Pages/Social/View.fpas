unit GuiGallery.Pages.Social.View;

uses
  GuiGallery.Pages.Social.State as S, GuiGallery.Shared.Sections as G,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Containers.Cards as Cards,
  Fpas.Ui.Widgets.Conversation.ChatMessages as Chat, Fpas.Ui.Widgets.Conversation.ChatDividers as Divider, Fpas.Ui.Widgets.Conversation.TypingIndicators as Typing,
  Fpas.Ui.Widgets.Conversation.Comments as Comments, Fpas.Ui.Widgets.Conversation.Presences as Presence, Fpas.Ui.Widgets.Feedback.Counters as Counter,
  Fpas.Ui.Widgets.Feedback.Tickers as Ticker, Fpas.Ui.Widgets.Actions.Buttons as B, Fpas.Ui.Widgets.Charts.Charts as Charts,
  Fpas.Ui.Graphics as Color, GuiGallery.Pages.Social.Media as Media, System as Sys, System.Collections.Generic as Lists;

function ChatColumn(): E.Element<S.Msg>;
begin
  return E.Column<S.Msg>(
    new L.Flow(Gap := G.Points(10), Clip := false),
    G.Heading<S.Msg>('Chat', 'Grouped bubbles, read receipts and a typing indicator.'),
    Cards.Card<S.Msg>(
      'social-chat', [
        Divider.ChatDivider<S.Msg>('social-today', 'Today'),
        Chat.ChatMessage<S.Msg>(
          'social-message-1', 'Did the data grid make it into 1.1?',
          new Chat.Options(Author := 'Jonas Berg', Time := '9:41')
        ),
        Chat.ChatMessage<S.Msg>(
          'social-message-2', 'I need it for the billing page.',
          new Chat.Options(Author := 'Jonas Berg', Grouped := true, LastInGroup := true)
        ),
        Chat.ChatMessage<S.Msg>(
          'social-message-3', 'It did. 2,000 rows scroll at 60 fps on my laptop.',
          new Chat.Options(Mine := true)
        ),
        Chat.ChatMessage<S.Msg>(
          'social-message-4', 'Shift and Ctrl clicks select like a spreadsheet.',
          new Chat.Options(
            Mine := true,
            Grouped := true,
            LastInGroup := true,
            Status := 'Read',
            Time := '9:43'
          )
        ),
        Typing.TypingIndicator<S.Msg>('social-typing', 'Jonas')
      ], new Cards.Options(Padding := 16.0F)
    )
  );
end function;

function CommentColumn(Model: S.Model): E.Element<S.Msg>;
begin
  return E.Column<S.Msg>(
    new L.Flow(Gap := G.Points(10), Clip := false),
    G.Heading<S.Msg>('Comments', 'Threads with replies, likes and badges.'),
    Cards.Card<S.Msg>(
      'social-comments', [
        Comments.Comment<S.Msg>(
          'social-comment-1', 'Tomas Rivera',
          'The new numbers match the staging run. I would still test the import on a large file before Friday.',
          Model.Likes[0], function(Change: Comments.Event): S.Msg => S.Msg.Comment(0, Change),
          new Comments.Options(Time := '2h', Badge := 'Author')
        ),
        Comments.Comment<S.Msg>(
          'social-comment-2', 'Priya Nair', 'Agreed. I have a 2 GB export we can use.',
          Model.Likes[1], function(Change: Comments.Event): S.Msg => S.Msg.Comment(1, Change),
          new Comments.Options(Time := '1h', Depth := 1)
        ),
        Comments.Comment<S.Msg>(
          'social-comment-3', 'Maya Okafor', 'Scheduled it for 3 pm.',
          Model.Likes[2], function(Change: Comments.Event): S.Msg => S.Msg.Comment(2, Change),
          new Comments.Options(Time := '40m', Depth := 1, Edited := true)
        )
      ], new Cards.Options(Padding := 14.0F, Gap := 4.0F)
    )
  );
end function;

function User(Name: string; Red: byte; Green: byte; Blue: byte; Idle: bool := false): Presence.User;
begin
  return new Presence.User(
    Name,
    Charts.Color.Rgba(new Color.Color(Red, Green, Blue)),
    Idle := Idle
  );
end function;

// Builds the original conversation, presence and ticker examples.
// ## Parameters
// - `Model`: Current like and counter values.
// ## Returns
// The native examples in gallery order.
public function View(Model: S.Model): array of E.Element<S.Msg>;
begin
  const Column: L.Flex := new L.Flex(Grow := 1.0F);
  const Sections: Lists.List<E.Element<S.Msg>> := new Lists.List<E.Element<S.Msg>>(
    [
      E.Row<S.Msg>(
        new L.Flow(Gap := G.Points(24), Align := L.Alignment.Start, Clip := false),
        E.Size<S.Msg>(ChatColumn(), Column),
        E.Size<S.Msg>(CommentColumn(Model), Column)
      ),
      G.Heading<S.Msg>('Presence', 'Who is here now. Hover to spread them out.'),
      E.Row<S.Msg>(
        new L.Flow(Gap := G.Points(24), Align := L.Alignment.Center, Clip := false),
        Presence.Presence<S.Msg>(
          'social-presence', [
            User('Maya Okafor', $7C, $5C, $FF), User('Jonas Berg', $22, $C5, $8B),
            User('Priya Nair', $F5, $9E, $0B), User('Lena Fischer', $38, $BD, $F8, true),
            User('Aiko Tanaka', $EC, $48, $99), User('Daniel Mensah', $10, $B9, $81),
            User('Rosa Delgado', $A8, $55, $F7)
          ]
        ),
        Counter.Counter<S.Msg>(
          'social-revenue', Model.Revenue,
          new Counter.Options(
            Format := new Charts.ValueFormat(Prefix := '$'),
            Size := 34.0F,
            GroupThousands := true
          )
        ),
        B.Button<S.Msg>(
          'social-sale', 'Add a sale', S.Msg.Sale,
          new B.Options(ControlSize := B.Size.Small, Icon := Sys.Char.ConvertFromUtf32($E13D))
        )
      ),
      G.Heading<S.Msg>('Ticker', 'A continuous strip of figures. It pauses under the pointer.'),
      Ticker.Ticker<S.Msg>(
        'social-ticker', [
          new Ticker.Item('Revenue', '$48.2k', 6.9F),
          new Ticker.Item('Active users', '12,408', 3.1F),
          new Ticker.Item('Churn', '1.7%', -0.6F, true),
          new Ticker.Item('Latency', '182 ms', -8.4F, true),
          new Ticker.Item('Builds', '1,204', 12.0F),
          new Ticker.Item('Uptime', '99.98%')
        ]
      )
    ]
  );
  Sections.AddRange(Media.View(Model));
  return Sections.ToArray();
end function;

end unit;
