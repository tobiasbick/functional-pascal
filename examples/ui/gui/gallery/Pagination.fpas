unit GuiGallery.Pagination;

uses GuiGallery.State as State, Fpas.Ui.Paginations as P, Fpas.Ui.Elements as E;

// Builds the original twelve-page pager.
//
// ## Parameters
// - `Model`: Current gallery state.
// ## Returns
// The native pagination example.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  return P.Pagination<State.Msg>('pages', Model.PageIndex, 12, State.Msg.SetPageIndex);
end function;
end unit;
