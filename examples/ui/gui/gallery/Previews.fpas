unit GuiGallery.Previews;

uses
  GuiGallery.State as State, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L,
  Fpas.Ui.Styles as S, Fpas.Ui.Editors as Ed, Fpas.Ui.Choices as C,
  Fpas.Ui.Graphics as G, System.Collections.Generic as Lists;

function Select(Key: string): State.Msg;
begin
  return State.Msg.Select(Key);
end function;

function Activate(Key: string): State.Msg;
begin
  return State.Msg.Activate(Key);
end function;

// Builds the selected gallery preview using shared widgets.
//
// ## Parameters
// - `Model`: Retained application state.
//
// ## Returns
// The preview tree.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  case Model.Page of
    when 'controls':
      return E.Column<State.Msg>(
        new L.Flow(Gap := L.Spacing.Normal),
        E.Text<State.Msg>('Count: ' + Model.Count.ToString()),
        E.Button<State.Msg>('increment', 'Increment ## literal label', State.Msg.Increment),
        E.Button<State.Msg>(
          'primary',
          'Primary',
          State.Msg.Increment,
          Variant := S.ButtonVariant.Primary
        ),
        E.Button<State.Msg>(
          'secondary',
          'Secondary',
          State.Msg.Increment,
          Variant := S.ButtonVariant.Secondary
        ),
        E.Button<State.Msg>(
          'active',
          'Active',
          State.Msg.Increment,
          Variant := S.ButtonVariant.Active
        ),
        E.Button<State.Msg>(
          'destructive',
          'Destructive',
          State.Msg.Increment,
          Variant := S.ButtonVariant.Destructive
        ),
        E.Button<State.Msg>('disabled', 'Disabled', State.Msg.Increment, false),
        E.Checkbox<State.Msg>(
          'checked',
          'Model-owned checkbox',
          Model.Checked,
          function(Value: bool): State.Msg => State.Msg.Check(Value)
        ),
        E.ProgressBar<State.Msg>(Model.Count mod 101)
      );
    when 'editors':
      return E.Column<State.Msg>(
        new L.Flow(Gap := L.Spacing.Normal),
        E.TextInput<State.Msg>(
          'text',
          Model.Text,
          Model.Position,
          function(Value: Ed.TextEdit): State.Msg => State.Msg.Edit(Value),
          function(Value: Ed.EditorPosition): State.Msg => State.Msg.Move(Value),
          'Write Unicode'
        ),
        E.Multiline<State.Msg>(
          'document',
          Model.Document,
          Model.DocumentPosition,
          function(Value: Ed.TextEdit): State.Msg => State.Msg.EditDocument(Value),
          function(Value: Ed.EditorPosition): State.Msg => State.Msg.MoveDocument(Value),
          'Multiple lines'
        ),
        E.TextInput<State.Msg>(
          'empty',
          '',
          new Ed.EditorPosition(),
          function(Value: Ed.TextEdit): State.Msg => State.Msg.Edit(Value),
          function(Value: Ed.EditorPosition): State.Msg => State.Msg.Move(Value),
          'Disabled empty editor',
          false
        ),
        E.Text<State.Msg>('Text: ' + Model.Text)
      );
    when 'collections':
      return E.Column<State.Msg>(
        new L.Flow(Gap := L.Spacing.Normal),
        E.List<State.Msg>(
          'actions',
          [
            new C.ListItem<State.Msg>('add', 'Independent action', State.Msg.Increment),
            new C.ListItem<State.Msg>(
              'off',
              'Disabled action',
              State.Msg.Increment,
              Enabled := false
            )
          ]
        ),
        E.SelectionList<State.Msg>(
          'selection',
          [
            new C.SelectionItem('alpha', 'Alpha'),
            new C.SelectionItem('disabled', 'Skip me', false),
            new C.SelectionItem('beta', 'Beta', CanActivate := false)
          ],
          Model.Selected,
          Select,
          Activate
        ),
        E.Table<State.Msg>(
          'table',
          [new C.TableColumn('Name'), new C.TableColumn('Value')],
          [
            new C.TableRow('alpha', ['Alpha', '1']),
            new C.TableRow('beta', ['Beta', '2'], CanActivate := false),
            new C.TableRow('disabled', ['Disabled', '3'], Enabled := false)
          ],
          Model.Selected,
          Select,
          Activate
        ),
        E.Tabs<State.Msg>(
          'tabs',
          [
            new C.TabItem('one', 'First'),
            new C.TabItem('off', 'Disabled', false),
            new C.TabItem('two', 'Second')
          ],
          Model.Tab,
          function(Key: string): State.Msg => State.Msg.Tab(Key),
          function(Key: string): E.Element<State.Msg> => E.Text<State.Msg>('Tab: ' + Key)
        ),
        E.SelectionList<State.Msg>('empty-list', [], null, Select),
        E.Tabs<State.Msg>(
          'empty-tabs', [], null, function(Key: string): State.Msg => State.Msg.Tab(Key),
          function(Key: string): E.Element<State.Msg> => E.Text<State.Msg>(
            'Empty tabs have no panel'
          )
        ),
        E.Text<State.Msg>('Selection: ' + Model.Status)
      );
    when 'layout':
      const Lines: Lists.List<E.Element<State.Msg>> := new Lists.List<E.Element<State.Msg>>();
      for I: int := 1 to 40 do
        Lines.Add(E.Text<State.Msg>('Scrollable line ' + I.ToString()));
      end for;

      return E.Column<State.Msg>(
        new L.Flow(Gap := L.Spacing.Normal),
        E.Row<State.Msg>(
          new L.Flow(Gap := L.Spacing.Tight),
          E.Size<State.Msg>(
            E.Border<State.Msg>(E.Text<State.Msg>('Fixed'), 'Basis'),
            new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(160)))
          ),
          E.Size<State.Msg>(
            E.Border<State.Msg>(E.Text<State.Msg>('Grow'), 'Fill'),
            new L.Flex(Basis := L.Extent.Fill)
          )
        ),
        E.Styled<State.Msg>(E.Text<State.Msg>('Heading role'), S.Role.Heading),
        E.Styled<State.Msg>(E.Text<State.Msg>('Muted role'), S.Role.Muted),
        E.Styled<State.Msg>(E.Text<State.Msg>('Panel role'), S.Role.Panel),
        E.Styled<State.Msg>(E.Text<State.Msg>('Primary role'), S.Role.Primary),
        E.Styled<State.Msg>(E.Text<State.Msg>('Secondary role'), S.Role.Secondary),
        E.Styled<State.Msg>(E.Text<State.Msg>('Error role'), S.Role.Error),
        E.Divider<State.Msg>('Scrolling'),
        E.Size<State.Msg>(
          E.ScrollView<State.Msg>(
            'scroll',
            E.Column<State.Msg>(Lines.ToArray()),
            Model.Scroll,
            function(Value: L.ScrollChange): State.Msg => State.Msg.Scroll(Value)
          ),
          new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(180)))
        )
      );
    when 'graphics':
      return E.Column<State.Msg>(
        new L.Flow(Gap := L.Spacing.Normal),
        E.Text<State.Msg>('Owned RGBA image and clipped vector canvas'),
        E.Image<State.Msg>(
          'pixels',
          new G.Pixels(2, 2, [255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 0, 255]),
          80,
          80
        ),
        E.Canvas<State.Msg>(
          'canvas',
          320,
          160,
          [
            G.Paint.FillRect(0, 0, 320, 160, new G.Color(25, 40, 65)),
            G.Paint.FillRect(20, 20, 90, 90, new G.Color(40, 180, 160)),
            G.Paint.Line(0, 150, 310, 10, 3, new G.Color(240, 160, 40))
          ]
        )
      );
    else
      return E.Column<State.Msg>(
        new L.Flow(Gap := L.Spacing.Normal),
        E.Text<State.Msg>('Status: ' + Model.Status),
        E.Button<State.Msg>('start', 'Start background work', State.Msg.Start),
        E.Button<State.Msg>('cancel', 'Cancel work', State.Msg.Cancel),
        E.Button<State.Msg>('modal-open', 'Open modal', State.Msg.Open),
        E.Button<State.Msg>('responsive-increment', 'Increment while working', State.Msg.Increment),
        E.Text<State.Msg>('Count: ' + Model.Count.ToString())
      );
  end case;
end function;
end unit;
