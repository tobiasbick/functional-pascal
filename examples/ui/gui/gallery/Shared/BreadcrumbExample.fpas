// [Documentation](../../../../../docs/ui/gui/navigation/breadcrumb.md)

unit Gallery.Shared.BreadcrumbExample;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Navigation.Breadcrumbs as B;

const Path: array of string := ['Home', 'Projects', 'CUI', 'Settings'];

// Builds the original project trail in either gallery.
// ## Type parameters
// - `TMsg`: Gallery message type.
// ## Parameters
// - `Navigate`: Maps an activated ancestor caption to a message.
// ## Returns
// The shared breadcrumb trail.
public function View of TMsg(Navigate: function(string): TMsg): E.Element of TMsg;
begin
  return B.Breadcrumb of TMsg(
    'breadcrumbs',
    Path,
    function(Index: int): TMsg => Navigate(Path[Index])
  );
end function;

end unit;
