// [Documentation](../../../../../docs/ui/gui/actions/button.md)

unit Gallery.Shared.ButtonExamples;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;

uses Gallery.Shared.Strings as Strings;
uses System as Sys;

const Row: L.Flow := new L.Flow(Gap := L.Spacing.Normal, Align := L.Alignment.Center);
const Stack: L.Flow := new L.Flow(Gap := L.Spacing.Loose);

function Sample of TMsg(Preview: TMsg; Id: string; Label: string; Style: S.ButtonVariant := S.ButtonVariant.Default; Size: B.Size := B.Size.Medium): E.Element of TMsg;
begin
  return B.Button of TMsg(
    Id,
    Label,
    Preview,
    new B.Options(Variant := Style, ControlSize := Size)
  );
end function;

// Builds the six gallery button variants.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Preview`: Message for a harmless sample activation.
// - `Wide`: Whether the samples fit on one row.
// ## Returns
// Variant buttons in gallery order.
public function Variants of TMsg(Preview: TMsg; Wide: bool): E.Element of TMsg;
begin
  const Primary: E.Element of TMsg := Sample of TMsg(
    Preview,
    'primary',
    Strings.Get('Text.Primary'),
    S.ButtonVariant.Primary
  );
  const Secondary: E.Element of TMsg := Sample of TMsg(
    Preview,
    'secondary',
    Strings.Get('Text.Secondary')
  );
  const Outline: E.Element of TMsg := Sample of TMsg(
    Preview,
    'outline',
    Strings.Get('Text.Outline'),
    S.ButtonVariant.Outline
  );
  const Ghost: E.Element of TMsg := Sample of TMsg(
    Preview,
    'ghost',
    Strings.Get('Text.Ghost'),
    S.ButtonVariant.Ghost
  );
  const Danger: E.Element of TMsg := Sample of TMsg(
    Preview,
    'danger',
    Strings.Get('Text.Danger'),
    S.ButtonVariant.Destructive
  );
  const Link: E.Element of TMsg := Sample of TMsg(
    Preview,
    'link',
    Strings.Get('Text.Link'),
    S.ButtonVariant.Link
  );

  return if Wide then
    E.Row of TMsg(
      Row,
      Primary,
      Secondary,
      Outline,
      Ghost,
      Danger,
      Link
    )
  else
    E.Column of TMsg(
      Stack,
      E.Row of TMsg(Row, Primary, Secondary, Outline),
      E.Row of TMsg(Row, Ghost, Danger, Link)
    )
  end if;
end function;

// Builds the gallery button sizes.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Preview`: Message for a harmless sample activation.
// ## Returns
// The small, medium and large buttons.
public function Sizes of TMsg(Preview: TMsg): E.Element of TMsg;
begin
  return E.Row of TMsg(
    Row,
    Sample of TMsg(Preview, 'small', Strings.Get('Text.Small'), Size := B.Size.Small),
    Sample of TMsg(Preview, 'medium', Strings.Get('Text.Medium')),
    Sample of TMsg(Preview, 'large', Strings.Get('Text.Large'), Size := B.Size.Large)
  );
end function;

// Builds the labelled icon actions.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Preview`: Message for a harmless sample activation.
// ## Returns
// New project, Download and Continue.
public function Icons of TMsg(Preview: TMsg): array of E.Element of TMsg;
begin
  const Project: E.Element of TMsg := B.Button of TMsg(
    'new-project', Strings.Get('Text.NewProject'), Preview,
    new B.Options(
      Variant := S.ButtonVariant.Primary,
      Icon := Sys.Char.ConvertFromUtf32($E13D),
      TerminalIcon := '+'
    )
  );
  const Download: E.Element of TMsg := B.Button of TMsg(
    'download',
    Strings.Get('Text.Download'),
    Preview,
    new B.Options(Icon := Sys.Char.ConvertFromUtf32($E0B2), TerminalIcon := '↓')
  );
  const Continue: E.Element of TMsg := B.Button of TMsg(
    'continue', Strings.Get('Text.Continue'), Preview,
    new B.Options(
      Variant := S.ButtonVariant.Outline,
      IconRight := Sys.Char.ConvertFromUtf32($E049),
      TerminalIconRight := '→'
    )
  );
  return [Project, Download, Continue];
end function;

// Builds the interactive and disabled button states.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Preview`: Message for a harmless sample activation.
// - `Wide`: Whether the samples fit on one row.
// - `Loading`: Current save state.
// - `Toggle`: Maps a save or reset action.
// ## Returns
// The four state examples.
public function States of TMsg(Preview: TMsg; Wide: bool; Loading: bool; Toggle: function(bool): TMsg): E.Element of TMsg;
begin
  const Save: E.Element of TMsg := B.Button of TMsg(
    'save',
    if Loading then
      Strings.Get('Text.Saving')
    else
      Strings.Get('Text.SaveChanges')
    end if,
    Toggle(true),
    new B.Options(Loading := Loading, Variant := S.ButtonVariant.Primary)
  );
  const Reset: E.Element of TMsg := B.Button of TMsg(
    'finish-save',
    Strings.Get('Text.Reset'),
    Toggle(false)
  );
  const Disabled: E.Element of TMsg := B.Button of TMsg(
    'disabled', Strings.Get('Text.Disabled'), Preview, new B.Options(Enabled := false)
  );
  const Selected: E.Element of TMsg := B.Button of TMsg(
    'selected', Strings.Get('Text.Selected'), Preview,
    new B.Options(
      Variant := S.ButtonVariant.Ghost,
      Selected := true,
      Icon := Sys.Char.ConvertFromUtf32($E06C),
      TerminalIcon := '✓'
    )
  );
  return if Wide then
    E.Row of TMsg(
      Row,
      Save,
      Reset,
      Disabled,
      Selected
    )
  else
    E.Column of TMsg(
      Stack,
      E.Row of TMsg(Row, Save, Reset),
      E.Row of TMsg(Row, Disabled, Selected)
    )
  end if;
end function;

end unit;
