// [Documentation](../../../../../docs/ui/gui/selection/checkbox.md)

unit Gallery.Shared.CheckboxExamples;

uses Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Inputs.Checkboxes as C;

// Builds the notification checkboxes in gallery order.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Newsletter`: Current email notification setting.
// - `Marketing`: Current marketing setting.
// - `SetNewsletter`: Maps email notification changes.
// - `SetMarketing`: Maps marketing changes.
// - `Preview`: Inert message for the disabled example.
// ## Returns
// Email notifications, Marketing and Disabled option.
public function Rows<TMsg>(Newsletter: bool; Marketing: bool; SetNewsletter: function(bool): TMsg; SetMarketing: function(bool): TMsg; Preview: TMsg): array of E.Element<TMsg>;
begin
  return [
    C.Checkbox<TMsg>(
      'newsletter',
      'Email notifications',
      Newsletter,
      SetNewsletter,
      Description := 'Product news, at most once a month.'
    ),
    C.Checkbox<TMsg>(
      'marketing',
      'Marketing',
      Marketing,
      SetMarketing,
      Description := 'Offers from our partners.'
    ),
    C.Checkbox<TMsg>(
      'disabled-option',
      'Disabled option',
      false,
      function(Value: bool): TMsg => Preview,
      Enabled := false
    )
  ];
end function;

// Builds the checkbox in the workspace form.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Checked`: Whether to send a weekly workspace summary.
// - `Change`: Maps changes to this workspace preference.
// ## Returns
// The workspace summary checkbox.
public function WeeklySummary<TMsg>(Checked: bool; Change: function(bool): TMsg): E.Element<TMsg>;
begin
  return C.Checkbox<TMsg>('workspace-summary', 'Email me a weekly summary', Checked, Change);
end function;

end unit;
