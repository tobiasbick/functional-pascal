// [Documentation](../../../../../docs/ui/gui/selection/checkbox.md)

unit Gallery.Shared.CheckboxExamples;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Inputs.Checkboxes as C;

uses Gallery.Shared.Strings as Strings;

// Builds the notification checkboxes in gallery order.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Newsletter`: Current email notification setting.
// - `Marketing`: Current marketing setting.
// - `SetNewsletter`: Maps email notification changes.
// - `SetMarketing`: Maps marketing changes.
// - `Preview`: Inert message for the disabled example.
// ## Returns
// Email notifications, Marketing and Disabled option.
public function Rows of TMsg(Newsletter: bool; Marketing: bool; SetNewsletter: function(bool): TMsg; SetMarketing: function(bool): TMsg; Preview: TMsg): array of E.Element of TMsg;
begin
  return [
    C.Checkbox of TMsg(
      'newsletter',
      Strings.Get('Text.EmailNotifications'),
      Newsletter,
      SetNewsletter,
      Description := Strings.Get('Text.EmailNotificationsHint')
    ),
    C.Checkbox of TMsg(
      'marketing',
      Strings.Get('Text.Marketing'),
      Marketing,
      SetMarketing,
      Description := Strings.Get('Text.MarketingHint')
    ),
    C.Checkbox of TMsg(
      'disabled-option',
      Strings.Get('Text.DisabledOption'),
      false,
      function(Value: bool): TMsg => Preview,
      Enabled := false
    )
  ];
end function;

// Builds the checkbox in the workspace form.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Checked`: Whether to send a weekly workspace summary.
// - `Change`: Maps changes to this workspace preference.
// ## Returns
// The workspace summary checkbox.
public function WeeklySummary of TMsg(Checked: bool; Change: function(bool): TMsg): E.Element of TMsg;
begin
  return C.Checkbox of TMsg(
    'workspace-summary',
    Strings.Get('Text.SendWeeklySummary'),
    Checked,
    Change
  );
end function;

end unit;
