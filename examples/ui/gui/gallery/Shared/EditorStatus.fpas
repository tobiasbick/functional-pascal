// [Documentation](../../../../../docs/ui/gui/app-chrome/status-bar.md)

unit Gallery.Shared.EditorStatus;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Styles as Style;
uses Fpas.Ui.Widgets.Desktop.StatusBars as Status;

uses Gallery.Shared.Strings as Strings;
uses System.Collections.Generic as C;

// Source excerpt shown above the editor status bar.
public const CodeLines: array of string := [
  'static tile *cache_lookup(tile_cache *c, uint32_t key) {',
  '    uint32_t slot = key & (c->capacity - 1);',
  '    while (c->tiles[slot].key != key) {',
  '        if (!c->tiles[slot].used) return NULL;',
  '        slot = (slot + 1) & (c->capacity - 1);',
  '    }',
  '    return &c->tiles[slot];',
  '}'
];

// Builds the editor status bar in gallery order.
// ## Type parameters
// - `TMsg`: Host message type.
// ## Parameters
// - `Indent`: Spacing choice (2, 4 or 8).
// - `Encoding`: UTF-8 or UTF-16 choice.
// - `Language`: Markdown, C or plain text choice.
// - `Command`: Maps an item key to a host action.
// - `Columns`: Available terminal cells, or unlimited for the full editor.
// ## Returns
// The shared status bar.
public function View of TMsg(
  Indent: int;
  Encoding: int;
  Language: int;
  Command: function(string): TMsg;
  Columns: int := int.MaxValue
): E.Element of TMsg;
requires Indent >= 0 and Indent < 3 and Encoding >= 0 and Encoding < 2 and Language >= 0
  and Language < 3;
  function Item(
    Key: string;
    Text: string;
    Tip: string := '';
    Icon: string := ''
  ): Status.Item of TMsg;
  begin
    return (Status.Item of TMsg).Action(
      Key,
      new Status.Label(Text, Icon),
      Tip,
      true,
      Command(Key)
    );
  end function;

begin
  const Spaces: array of string := ['2', '4', '8'];
  const Encodings: array of string := ['UTF-8', 'UTF-16'];
  const Languages: array of string := ['Markdown', 'C', Strings.Get('Text.PlainText')];
  const Items: C.List of Status.Item of TMsg := new C.List of Status.Item of TMsg();
  if Columns >= 12 then
    Items.Add(Item('branch', 'main', Strings.Get('Text.SwitchBranch'), ''));
  end if;

  if Columns >= 18 then
    Items.Add(
      (Status.Item of TMsg).Text(
        new Status.Label(Strings.Get('Text.Saved'), '', Style.Tone.Success)
      )
    );
  end if;

  if Columns >= 40 then
    Items.Add(
      (Status.Item of TMsg).Progress(0.62F, Strings.Get('Text.IndexingProgress'), 0.0F, false)
    );
  end if;

  Items.Add((Status.Item of TMsg).Spacer);
  if Columns >= 55 then
    Items.Add(Item('line', Strings.Get('Text.LineColumn'), Strings.Get('Text.GoToLine')));
  end if;

  if Columns >= 65 then
    Items.Add(Item('spaces', Strings.Get('Text.SpacesPrefix') + Spaces[Indent]));
  end if;

  Items.Add(Item('encoding', Encodings[Encoding]));
  if Columns >= 76 then
    Items.Add(Item('language', Languages[Language]));
  end if;

  if Columns >= 90 then
    Items.Add(Item('notifications', '', Strings.Get('Text.Notifications'), ''));
  end if;

  return Status.StatusBar of TMsg('desktop-status', Items.ToArray());
end function;

end unit;
