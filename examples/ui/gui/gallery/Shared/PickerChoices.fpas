// [Documentation](../../../../../docs/ui/gui/inputs/select.md)

unit Gallery.Shared.PickerChoices;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Inputs.Selects as S;

uses Gallery.Shared.Strings as Strings;

const Countries: array of S.Item := [
  new S.Item(Strings.Get('Text.Canada')),
  new S.Item(Strings.Get('Text.Denmark')),
  new S.Item(Strings.Get('Text.Germany')),
  new S.Item(Strings.Get('Text.Iran')),
  new S.Item(
    Strings.Get('Text.Japan')
  ),
  new S.Item(Strings.Get('Text.Kenya')),
  new S.Item(Strings.Get('Text.Netherlands')),
  new S.Item(Strings.Get('Text.Portugal')),
  new S.Item(Strings.Get('Text.UnitedStates'))
];
const Languages: array of S.Item := [
  new S.Item('C99'),
  new S.Item('C11'),
  new S.Item('C17'),
  new S.Item('C23'),
  new S.Item('C++17'),
  new S.Item('Objective-C'),
  new S.Item('Zig'),
  new S.Item('Odin'),
  new S.Item('Rust')
];

// Germany is initially selected in the Country field.
public const InitialCountry: int := 2;
// Language starts with its placeholder.
public const InitialLanguage: int := -1;

// Builds the Country field for the Inputs page.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Index`: Current model selection.
// - `Change`: Maps a new choice to a message.
// ## Returns
// The shared Country select.
public function Country<TMsg>(Index: int; Change: function(int): TMsg): E.Element<TMsg>;
begin
  return S.Select<TMsg>(
    'input-country',
    Countries,
    Index,
    Change,
    new S.Options(Label := Strings.Get('Text.Country'))
  );
end function;

// Builds the Language field for the Inputs page.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Index`: Current model selection.
// - `Change`: Maps a new choice to a message.
// ## Returns
// The shared Language select.
public function Language<TMsg>(Index: int; Change: function(int): TMsg): E.Element<TMsg>;
begin
  return S.Select<TMsg>(
    'input-language',
    Languages,
    Index,
    Change,
    new S.Options(
      Label := Strings.Get('Text.Language'),
      Placeholder := Strings.Get('Text.PickLanguage'),
      Searchable := true
    )
  );
end function;

end unit;
