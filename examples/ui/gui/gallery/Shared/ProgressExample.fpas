// [Documentation](../../../../../docs/ui/gui/feedback/progress-bar.md)

unit Gallery.Shared.ProgressExample;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Feedback.ProgressBars as P;

uses Gallery.Shared.Strings as Strings;

// Builds the determinate upload indicator.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Returns
// The gallery upload at 68 percent.
public function Upload of TMsg(): E.Element of TMsg;
begin
  return P.ProgressBar of TMsg(
    'upload',
    0.68F,
    new P.Options(Label := Strings.Get('Text.UploadingAssets'), ShowValue := true)
  );
end function;

// Builds the determinate export indicator.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Dither`: Enable the graphical dither pattern.
// ## Returns
// The gallery export at 42 percent.
public function ExportBar of TMsg(Dither: bool): E.Element of TMsg;
begin
  return P.ProgressBar of TMsg(
    'export',
    0.42F,
    new P.Options(Label := Strings.Get('Text.ExportingClip'), ShowValue := true, Dither := Dither)
  );
end function;

end unit;
