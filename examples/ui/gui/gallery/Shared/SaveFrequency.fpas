// [Documentation](../../../../../docs/ui/gui/selection/radio-group.md)

unit Gallery.Shared.SaveFrequency;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Inputs.RadioGroups as R;

uses Gallery.Shared.Strings as Strings;

// Initially select Every 5 minutes in both galleries.
public const Initial: int := 1;

// Builds the Selection page's save-frequency choices.
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Selected`: Current save frequency.
// - `Change`: Maps a new frequency to a message.
// ## Returns
// The exclusive radio rows with their original descriptions.
public function View of TMsg(Selected: int; Change: function(int): TMsg): E.Element of TMsg;
begin
  return R.RadioGroup of TMsg(
    'save-frequency', [
      new R.Item(Strings.Get('Text.EveryChange'), Strings.Get('Text.EveryChangeHint')),
      new R.Item(Strings.Get('Text.EveryFiveMinutes'), Strings.Get('Text.EveryFiveMinutesHint')),
      new R.Item(Strings.Get('Text.OnlyManualSave'), Strings.Get('Text.OnlyManualSaveHint'))
    ], Selected, Change,
    Gap := L.Spacing.Fixed(L.Measure.Logical(12))
  );
end function;

end unit;
