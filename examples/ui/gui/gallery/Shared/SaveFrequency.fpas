// [Documentation](../../../../../docs/ui/gui/selection/radio-group.md)

unit Gallery.Shared.SaveFrequency;

uses
  Fpas.Ui.Widgets.Inputs.RadioGroups as R,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L;

// Initially select Every 5 minutes in both galleries.
public const Initial: int := 1;

// Builds the Selection page's save-frequency choices.
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Selected`: Current save frequency.
// - `Change`: Maps a new frequency to a message.
// ## Returns
// The exclusive radio rows with their original descriptions.
public function View<TMsg>(Selected: int; Change: function(int): TMsg): E.Element<TMsg>;
begin
  return R.RadioGroup<TMsg>(
    'save-frequency', [
      new R.Item('Every change', 'Save as you type. Uses the most disk.'),
      new R.Item('Every 5 minutes', 'A good balance for most projects.'),
      new R.Item('Only when I save', 'Nothing is written until you press Ctrl S.')
    ], Selected, Change,
    Gap := L.Spacing.Fixed(L.Measure.Logical(12))
  );
end function;

end unit;
