// [Documentation](../README.md#source-structure)

unit GuiGallery.Shared.Sections;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;

// Creates logical spacing matching the CUI gallery.
//
// ## Parameters
// - `Amount`: Distance in logical points.
// ## Returns
// The corresponding fixed spacing.
public function Points(Amount: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Amount));
end function;

// Creates vertical space in a gallery column.
//
// ## Type parameters
// - `TMsg`: Message type of the containing page.
// ## Parameters
// - `Amount`: Height in logical points.
// ## Returns
// An empty element with the requested height.
public function Space of TMsg(Amount: int): E.Element of TMsg;
begin
  return E.Gap of TMsg(L.Measure.Logical(Amount));
end function;

// Builds a CUI gallery section heading with its top inset.
//
// ## Type parameters
// - `TMsg`: Message type of the containing page.
// ## Parameters
// - `Title`: Heading caption.
// - `Description`: Optional secondary text.
// ## Returns
// The padded title block.
public function Heading of TMsg(Title: string; Description: string := ''): E.Element of TMsg;
begin
  const Label: E.Element of TMsg := E.Styled of TMsg(
    E.Text of TMsg(Title),
    S.Role.Heading
  );
  const Children: array of E.Element of TMsg := if Description = '' then
    [Label]
  else
    [Label, E.Styled of TMsg(E.Text of TMsg(Description), S.Role.Secondary)]
  end if;
  return E.Column of TMsg(
    new L.Flow(Gap := Points(4), PaddingTop := Points(18), Clip := false),
    Children
  );
end function;

// Builds the outlined card used by the native gallery.
//
// ## Type parameters
// - `TMsg`: Message type of the containing page.
// ## Parameters
// - `RowGap`: Distance in logical points between children.
// - `Children`: Card content in display order.
// ## Returns
// The card with the original 24-point inset.
public function Card of TMsg(RowGap: int; Children: array of E.Element of TMsg): E.Element of TMsg;
begin
  return E.Styled of TMsg(
    E.Column of TMsg(
      new L.Flow(Padding := Points(24), Gap := Points(RowGap), Clip := false),
      Children
    ),
    S.Role.OutlinedPanel
  );
end function;

end unit;
