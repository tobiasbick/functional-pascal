unit GuiGallery.Shared.Sections;

uses
  Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L,
  Fpas.Ui.Styles as S;

// Creates logical spacing matching the CUI gallery.
//
// ## Parameters
// - `Amount`: Distance in logical points.
// ## Returns
// The corresponding fixed spacing.
public function Points(Amount: int): L.Spacing;
begin
  return L.Spacing.Fixed(L.Measure.Logical(Amount));
end function;

// Creates vertical space in a gallery column.
//
// ## Type parameters
// - `TMsg`: Message type of the containing page.
// ## Parameters
// - `Amount`: Height in logical points.
// ## Returns
// An empty element with the requested height.
public function Space<TMsg>(Amount: int): E.Element<TMsg>;
begin
  return E.Gap<TMsg>(L.Measure.Logical(Amount));
end function;

// Builds a CUI gallery section heading with its top inset.
//
// ## Type parameters
// - `TMsg`: Message type of the containing page.
// ## Parameters
// - `Title`: Heading caption.
// - `Description`: Optional secondary text.
// ## Returns
// The padded title block.
public function Heading<TMsg>(Title: string; Description: string := ''): E.Element<TMsg>;
begin
  const Label: E.Element<TMsg> := E.Styled<TMsg>(
    E.Text<TMsg>(Title),
    S.Role.Heading
  );
  const TitleBlock: E.Element<TMsg> := if Description = '' then
    Label
  else
    E.Column<TMsg>(
      new L.Flow(Gap := Points(4)),
      Label,
      E.Styled<TMsg>(E.Text<TMsg>(Description), S.Role.Secondary)
    )
  end if;
  return E.Column<TMsg>(Space<TMsg>(18), TitleBlock);
end function;

// Builds the outlined card used by the native gallery.
//
// ## Type parameters
// - `TMsg`: Message type of the containing page.
// ## Parameters
// - `RowGap`: Distance in logical points between children.
// - `Children`: Card content in display order.
// ## Returns
// The card with the original 24-point inset.
public function Card<TMsg>(RowGap: int; Children: array of E.Element<TMsg>): E.Element<TMsg>;
begin
  return E.Styled<TMsg>(
    E.Column<TMsg>(new L.Flow(Padding := Points(24), Gap := Points(RowGap)), Children),
    S.Role.OutlinedPanel
  );
end function;

end unit;
