// [Documentation](../../../../../docs/ui/gui/disclosure/expandable-card.md)

unit Gallery.Shared.SecurityCard;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Containers.ExpandableCards as Cards, System as Sys;

// Security starts closed in both galleries.
public const Initial: bool := false;

// Builds the shared Security disclosure example.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Open`: Expansion state owned by the gallery.
// - `Change`: Maps a proposed expansion to a message.
// ## Returns
// The Security card with its summary and recovery-code details.
public function View<TMsg>(Open: bool; Change: function(bool): TMsg): E.Element<TMsg>;
begin
  return Cards.ExpandableCard<TMsg>(
    'security', 'Security', Open, Change,
    E.Styled<TMsg>(E.Text<TMsg>('Recovery codes were generated 3 months ago.'), S.Role.Secondary),
    new Cards.Options(
      Description := 'Two-factor authentication is on',
      Icon := Sys.Char.ConvertFromUtf32($E158)
    )
  );
end function;

end unit;
