// [Documentation](../../../../../docs/ui/gui/data-display/tree.md)

unit Gallery.Shared.SourceTree;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Collections.Trees as T;

uses System as Sys;

// Builds the same sample source hierarchy in both galleries.
// ## Type parameters
// - `TMsg`: Gallery message type.
// ## Parameters
// - `Source`: Expansion of the source root.
// - `Components`: Expansion of the components branch.
// - `Assets`: Expansion of the assets branch.
// - `Selected`: Name of the selected file.
// - `SetSource`: Source expansion mapper.
// - `SetComponents`: Components expansion mapper.
// - `SetAssets`: Assets expansion mapper.
// - `SelectFile`: File activation mapper.
// ## Returns
// The source tree.
public function View of TMsg(
  Source: bool;
  Components: bool;
  Assets: bool;
  Selected: string;
  SetSource: function(bool): TMsg;
  SetComponents: function(bool): TMsg;
  SetAssets: function(bool): TMsg;
  SelectFile: function(string): TMsg
): E.Element of TMsg;
  function SelectableFile(Name: string): E.Element of TMsg;
  begin
    return T.Leaf of TMsg(
      'file-' + Name, Name, function(): TMsg => SelectFile(Name),
      new T.Options(Selected := Selected = Name)
    );
  end function;
begin
  return T.Branch of TMsg(
    'tree-src', 'src', Source, [
      T.Branch of TMsg(
        'tree-components', 'components', Components, [
          SelectableFile('button.c'), SelectableFile('dialog.c'), SelectableFile('slider.c'),
          SelectableFile('table.c')
        ], SetComponents
      ),
      T.Branch of TMsg(
        'tree-assets',
        'assets',
        Assets,
        [
          T.Leaf of TMsg(
            'file-logo.png', 'logo.png',
            Settings := new T.Options(Icon := Sys.Char.ConvertFromUtf32($E0F6))
          )
        ],
        SetAssets
      ),
      T.Leaf of TMsg('file-main.c', 'main.c')
    ], SetSource
  );
end function;

end unit;
