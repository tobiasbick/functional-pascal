unit GuiGallery.TextField;

uses
  GuiGallery.State as State, GuiGallery.Sections as G, Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L, Fpas.Ui.TextFields as F, System as Sys, System.Text as Text;

// Builds the accepted text fields in the original responsive card.
//
// ## Parameters
// - `Model`: Current values.
// - `Wide`: Whether the native two-column grid fits.
// ## Returns
// The Text fields section of the Inputs page.
public function Inputs(Model: State.Model; Wide: bool): E.Element<State.Msg>;
begin
  const Name: E.Element<State.Msg> := F.TextField<State.Msg>(
    'input-name', Model.Name, State.Msg.SetName,
    new F.Options(Label := 'Full name', Placeholder := 'Maya Okafor', MaxUtf8Bytes := 63)
  );
  const Email: E.Element<State.Msg> := F.TextField<State.Msg>(
    'input-email', Model.Email, State.Msg.SetEmail,
    new F.Options(
      Label := 'Email', Icon := Sys.Char.ConvertFromUtf32($E04E),
      Hint := 'We never share your email.', MaxUtf8Bytes := 95
    )
  );
  const Error: string := if Model.Password <> '' and Text.Encoding.UTF8.GetByteCount(
      Model.Password
    ) < 8 then 'Use 8 or more characters.'
    else ''
    end if;
  const Password: E.Element<State.Msg> := F.TextField<State.Msg>(
    'input-password', Model.Password, State.Msg.SetPassword,
    new F.Options(
      Label := 'Password', Placeholder := 'At least 8 characters', Password := true,
      Error := Error, MaxUtf8Bytes := 63
    )
  );
  const Flow: L.Flow := new L.Flow(Gap := G.Points(16), Align := L.Alignment.Start);
  const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
  const Fields: array of E.Element<State.Msg> := if Wide then [
      E.Row<State.Msg>(Flow, E.Size<State.Msg>(Name, Fill), E.Size<State.Msg>(Email, Fill)),
      E.Row<State.Msg>(
        Flow,
        E.Size<State.Msg>(Password, Fill),
        E.Size<State.Msg>(E.Column<State.Msg>(), Fill)
      )
    ]
    else [Name, Email, Password]
    end if;
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading('Text fields', 'Labels above, hints and errors below.'),
    G.Card(16, Fields)
  );
end function;

// Builds the two fixed-width prefix and suffix examples from Smart inputs.
//
// ## Parameters
// - `Model`: Editable URL and weight values.
// ## Returns
// The Prefix and suffix section.
public function Affixes(Model: State.Model): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading(
      'Prefix and suffix',
      'Any text field can carry muted text before and after the value.'
    ),
    E.Row<State.Msg>(
      new L.Flow(Gap := G.Points(12), Wrap := true),
      E.Size<State.Msg>(
        F.TextField<State.Msg>(
          'input-url',
          Model.Url,
          State.Msg.SetUrl,
          new F.Options(Prefix := 'https://', MaxUtf8Bytes := 95)
        ),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(260)))
      ),
      E.Size<State.Msg>(
        F.TextField<State.Msg>(
          'input-weight',
          Model.Weight,
          State.Msg.SetWeight,
          new F.Options(Suffix := 'kg', MaxUtf8Bytes := 15)
        ),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(120)))
      )
    )
  );
end function;
end unit;
