unit GuiGallery.ToggleGroup;

uses
  GuiGallery.State as State, GuiGallery.Sections as G, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L,
  Fpas.Ui.ToggleGroups as T, System as Sys;

// Shows CUI's icon formatting group and exclusive alignment group.
//
// ## Parameters
// - `Model`: Current selections for both groups.
// ## Returns
// The Toggle group section of the native Actions page.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  const Formats: E.Element<State.Msg> := T.ToggleGroup<State.Msg>(
    'action-format', [
      new T.Item('Bold', Sys.Char.ConvertFromUtf32($E05D)),
      new T.Item('Italic', Sys.Char.ConvertFromUtf32($E0FB)),
      new T.Item('Underline', Sys.Char.ConvertFromUtf32($E19A)),
      new T.Item('Code', Sys.Char.ConvertFromUtf32($E093))
    ], Model.ToggleFormats ?? [true, false, false, false], State.Msg.SetToggleFormats,
    new T.Options(IconOnly := true)
  );
  const Alignment: E.Element<State.Msg> := T.ToggleGroup<State.Msg>(
    'action-align', [
      new T.Item('Left', Sys.Char.ConvertFromUtf32($E185)),
      new T.Item('Center', Sys.Char.ConvertFromUtf32($E106)),
      new T.Item('Right', Sys.Char.ConvertFromUtf32($E115))
    ], Model.ToggleAlignment ?? [true, false, false], State.Msg.SetToggleAlignment,
    new T.Options(Exclusive := true)
  );
  return E.Row<State.Msg>(new L.Flow(Gap := G.Points(12), Wrap := true), Formats, Alignment);
end function;
end unit;
