unit GuiGallery.Tooltip;

uses
  GuiGallery.State as State, GuiGallery.Sections as G, Fpas.Ui.Elements as E,
  Fpas.Ui.IconButtons as Icons, Fpas.Ui.Tooltips as Tips, Fpas.Ui.Layout as L, System as Sys;

function Help(Id: string; Glyph: int; Label: string; Shortcut: string := ''): E.Element<State.Msg>;
begin
  return Tips.Tooltip<State.Msg>(
    Icons.IconButton<State.Msg>(Id, Sys.Char.ConvertFromUtf32(Glyph), Label, State.Msg.Preview),
    Label, Shortcut
  );
end function;

// Builds the native gallery's icon toolbar with pointer hints.
//
// ## Returns
// The Tooltips section of the Overlays page.
public function View(): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := G.Points(20)),
    G.Heading('Tooltips'),
    G.Card(
      12, [
        E.Row<State.Msg>(
          new L.Flow(Gap := G.Points(4), Wrap := true),
          Help('tooltip-bold', $E05D, 'Bold', 'Ctrl B'),
          Help('tooltip-italic', $E0FB, 'Italic', 'Ctrl I'),
          Help('tooltip-underline', $E19A, 'Underline', 'Ctrl U'),
          E.Divider<State.Msg>(),
          Help('tooltip-align', $E185, 'Align left'),
          Help('tooltip-list', $E106, 'Bulleted list'),
          Help('tooltip-link', $E102, 'Insert link')
        )
      ]
    )
  );
end function;
end unit;
