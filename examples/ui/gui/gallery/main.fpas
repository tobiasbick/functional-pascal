program GuiWidgetGallery;

uses
  GuiGallery.App.Sidebar as Sidebar,
  GuiGallery.App.State as State,
  GuiGallery.App.Update as Update,
  GuiGallery.App.View as View,
  Fpas.Ui.Gui.Application as Gui;

begin
  Gui.Run<State.Model, State.Msg>(
    new State.Model(), Update.Update, View.Build,
    new Gui.Options(Title := Sidebar.Title, Width := 1240, Height := 820), Update.ThemeFor
  );
end;

end program;
