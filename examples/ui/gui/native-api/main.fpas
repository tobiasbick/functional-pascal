// [Documentation](README.md)

program NativeApiExample;

uses Fpas.Ui.Gui.Desktop as Gui;
uses NativeApi.State as S;
uses NativeApi.Update as Update;
uses NativeApi.View as View;

begin
  Gui.Run<S.Model, S.Msg>(
    new S.Model(), Update.Apply, View.Build,
    new Gui.Options(Title := 'Native CUI APIs', Width := 720, Height := 600)
  );
end;

end program;
