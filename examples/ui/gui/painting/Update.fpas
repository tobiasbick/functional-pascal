// [Documentation](README.md)

unit NativePainting.Update;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Gui.Cui.Resources as Resources;
uses Fpas.Ui.Gui.Fonts as Fonts;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Widgets.Canvas.Canvases as Canvas;

uses NativePainting.State as S;
uses System.IO as IO;

// Acknowledges native events and schedules resource work between frames.
// ## Parameters
// - `Model`: Current application state.
// - `Message`: User action or native completion.
// ## Returns
// Next model and owner-thread commands.
public function Apply(Model: S.Model; Message: S.Msg): Mvu.Transition of (S.Model, S.Msg);
begin
  return case Message of
    when S.Msg.LoadFont: new Mvu.Transition of (S.Model, S.Msg)(
      Model, [
        Fonts.Apply of S.Msg(
          if Model.Face = null then
            (Fonts.Operation of S.Msg).Load(IO.File.ReadAllBytes(Model.FontPath), S.Msg.Loaded)
          else
            (Fonts.Operation of S.Msg).Assign(G.Font.Body, Model.Face)
          end if
        )
      ]
    );
    when S.Msg.Loaded(const Face: Resources.CuiFontFace?): new Mvu.Transition of (S.Model, S.Msg)(
      Model with
        Face := Face;
        Status := if Face = null then
          'CUI rejected the font.'
        else
          'The window owns a copy of the loaded face.'
        end if;
      end with,
      if Face = null then
        []
      else
        [Fonts.Apply of S.Msg((Fonts.Operation of S.Msg).Assign(G.Font.Body, Face))]
      end if
    );
    when S.Msg.RestoreFont: new Mvu.Transition of (S.Model, S.Msg)(
      Model with
        Status := 'Built-in body role restored; loaded faces live until close.';
      end with, [Fonts.Apply of S.Msg((Fonts.Operation of S.Msg).Assign(G.Font.Body, null))]
    );
    when S.Msg.ScaleText: new Mvu.Transition of (S.Model, S.Msg)(
      Model with
        Scale := if Model.Scale = 1.0F then
          1.35F
        else
          1.0F
        end if;
      end with, []
    );
    when S.Msg.Motion: new Mvu.Transition of (S.Model, S.Msg)(
      Model with
        ReducedMotion := not Model.ReducedMotion;
      end with, []
    );
    when S.Msg.PointerChanged(const Value: Canvas.Pointer): new Mvu.Transition of (S.Model, S.Msg)(
      Model with
        Pointer := Value;
      end with, []
    );
    when S.Msg.Clicked(_): new Mvu.Transition of (S.Model, S.Msg)(Model, []);
  end case;
end function;

end unit;
