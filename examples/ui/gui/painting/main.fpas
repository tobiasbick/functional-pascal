// [Documentation](README.md)

program NativePaintingExample;

uses Fpas.Ui.Gui.Desktop as Gui;
uses NativePainting.State as S;
uses NativePainting.Update as Update;
uses NativePainting.View as View;
uses System as Sys;

begin
  const Args: array of string := Sys.Environment.GetCommandLineArgs();
  Gui.RunThemed<S.Model, S.Msg>(
    new S.Model(
      FontPath := if Args.Length > 1 then
        Args[1]
      else
        ''
      end if
    ),
    Update.Apply,
    View.Build,
    new Gui.Options(
      Title := 'Native CUI painting',
      Width := 720,
      Height := 440,
      MinimumWidth := 500,
      MinimumHeight := 360
    ),
    View.ThemeFor
  );
end;

end program;
