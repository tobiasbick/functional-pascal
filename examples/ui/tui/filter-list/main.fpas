program FilterList;

uses Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Tui.Application as App, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Choices as Ch, Fpas.Ui.Styles as S, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as InputKeys, Fpas.Ui.TerminalExtensions.Views as Views, Fpas.Ui.Editors as Ed, Fpas.Ui.Themes as TerminalThemes, System as Sys, System.Collections.Generic as Generic, System.Console as Console, System.Threading as Threads, System.Threading.Tasks as Tasks;

type Preset = enum: byte
  Light;
  Dark;
  Green;
  Blue;
  Amber;
end enum;

type Msg = union
  FilterChanged(Value: Ed.TextEdit);
  FilterMoved(Position: Ed.EditorPosition);
  SelectItem(Id: string);
  OpenOptions;
  CloseOptions;
  ScrollOptions(Position: L.ScrollPosition);
  ShowHidden(Value: bool);
  ChangeTheme(Value: Preset);
  ResetOptions;
  Refresh;
  ProgressChanged(Value: int);
  RefreshFailed(Reason: string);
  Quit;
end union;

type ListDeps = record
  public Filter: string;
  public Selected: string;
  public ShowHidden: bool;
end record;

type Model = record
  public Filter: string := '';
  public FilterPosition: Ed.EditorPosition := new Ed.EditorPosition();
  public Selected: string := '';
  public ShowHidden: bool := false;
  public Options: bool := false;
  public OptionsPosition: L.ScrollPosition := L.ScrollPosition.Offset(L.Measure.Cells(0));
  public Appearance: Preset := Preset.Dark;
  public Progress: int := 0;
  public Refreshing: bool := false;
  public Failure: string := '';
end record;

const Names: array of string := ['Amber', 'Birch', 'Cedar', 'Hidden'];

function ThemeFor(State: Model): TerminalThemes.Theme;
begin
  case State.Appearance of
    when Preset.Light:
      return TerminalThemes.Light();
    when Preset.Green:
      return TerminalThemes.Dark(TerminalThemes.Accent.Green);
    when Preset.Blue:
      return TerminalThemes.Dark(TerminalThemes.Accent.Blue);
    when Preset.Amber:
      return TerminalThemes.Dark(TerminalThemes.Accent.Amber);
    else
      return TerminalThemes.Dark();
  end case;
end function;

async function RefreshItems(Post: function(Msg): Tasks.Task; Cancellation: Threads.CancellationToken): Tasks.Task;
begin
  for Value: int in [25, 50, 75, 100] do
    await Tasks.Task.Delay(30, Cancellation);
    await Post(Msg.ProgressChanged(Value));
  end for;
end function;

function Update(State: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  var Next: Model := State;
  var Commands: array of Mvu.Command<Msg> := [];
  case Message of
    when Msg.FilterChanged(const Value: Ed.TextEdit):
      Next := State with
        Filter := Value.Text;
        FilterPosition := Value.Position;
      end with;
    when Msg.FilterMoved(const Position: Ed.EditorPosition):
      Next := State with
        FilterPosition := Position;
      end with;
    when Msg.SelectItem(const Id: string):
      Next := State with
        Selected := Id;
      end with;
    when Msg.OpenOptions:
      Next := State with
        Options := true;
        OptionsPosition := L.ScrollPosition.Offset(L.Measure.Cells(0));
      end with;
    when Msg.CloseOptions:
      Next := State with
        Options := false;
      end with;
    when Msg.ScrollOptions(const Position: L.ScrollPosition):
      Next := State with
        OptionsPosition := Position;
      end with;
    when Msg.ShowHidden(const Value: bool):
      Next := State with
        ShowHidden := Value;
      end with;
    when Msg.ChangeTheme(const Value: Preset):
      Next := State with
        Appearance := Value;
      end with;
    when Msg.ResetOptions:
      Next := State with
        ShowHidden := false;
        Appearance := Preset.Dark;
      end with;
    when Msg.Refresh:
      Next := State with
        Progress := 0;
        Refreshing := true;
        Failure := '';
      end with;
      Commands := [
        Mvu.StartBackground<Msg>(
          'refresh', RefreshItems,
          function(Error: Sys.Exception): Msg => Msg.RefreshFailed(Error.Message)
        )
      ];
    when Msg.ProgressChanged(const Value: int):
      Next := State with
        Progress := Value;
        Refreshing := Value < 100;
      end with;
    when Msg.RefreshFailed(const Reason: string):
      Next := State with
        Refreshing := false;
        Failure := Reason;
      end with;
    when Msg.Quit:
      Commands := [Mvu.Exit<Msg>()];
  end case;

  return new Mvu.Transition<Model, Msg>(Next, Commands);
end function;

function SameList(Previous: ListDeps; Current: ListDeps): bool;
begin
  return Previous = Current;
end function;

function Matches(Name: string; Deps: ListDeps): bool;
begin
  return (Deps.ShowHidden or Name <> 'Hidden') and Name.Contains(
    Deps.Filter, Sys.StringComparison.OrdinalIgnoreCase
  );
end function;

function BuildList(Deps: ListDeps): E.Element<Msg>;
begin
  const Items: Generic.List<Ch.ListItem<Msg>> := new Generic.List<Ch.ListItem<Msg>>();
  for Name: string in Names do
    if Matches(Name, Deps) then
      Items.Add(new Ch.ListItem<Msg>(Name, Name, Msg.SelectItem(Name), Name = Deps.Selected));
    end if;
  end for;

  return if Items.Count = 0 then E.Text<Msg>('No matches. Try another search.')
    else E.List<Msg>('items', Items.ToArray())
    end if;
end function;

function Status(State: Model): E.Element<Msg>;
begin
  if State.Failure <> '' then
    return E.Styled<Msg>(E.Text<Msg>('Refresh failed · ' + State.Failure), S.Role.Error);
  end if;
  const Label: string := if State.Refreshing then 'Refreshing'
    else if State.Progress = 100 then 'Up to date' else 'Ready' end if
    end if;
  return E.Row<Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Styled<Msg>(E.Text<Msg>(Label), S.Role.Muted),
    E.Size<Msg>(
      E.ProgressBar<Msg>(State.Progress),
      new L.Flex(
        Basis := L.Extent.Fill, Minimum := L.Measure.Cells(18),
        Maximum := L.Measure.Cells(24)
      )
    ),
    E.Styled<Msg>(E.Text<Msg>(State.Progress.ToString() + '%'), S.Role.Muted)
  );
end function;

function ThemeChoice(Value: Preset; Selected: Preset): E.Element<Msg>;
begin
  const Name: string := Value.ToString();
  return E.Button<Msg>(
    'theme-' + Name.ToLowerInvariant(),
    Name,
    Msg.ChangeTheme(Value),
    Variant := if Value = Selected then S.ButtonVariant.Active else S.ButtonVariant.Secondary end if
  );
end function;

function OptionsScrolled(Change: L.ScrollChange): Msg;
begin
  return Msg.ScrollOptions(Change.Position);
end function;

function Options(State: Model): E.Element<Msg>;
begin
  const Settings: E.Element<Msg> := E.Column<Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Text<Msg>('Choose which entries appear in the results.'),
    E.Styled<Msg>(
      E.Checkbox<Msg>(
        'show-hidden', 'Show hidden', State.ShowHidden,
        function(Value: bool): Msg => Msg.ShowHidden(Value)
      ), S.Role.Secondary
    ),
    E.Column<Msg>(
      E.Text<Msg>('Theme · ' + State.Appearance.ToString()),
      E.Row<Msg>(
        new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
        ThemeChoice(Preset.Light, State.Appearance),
        ThemeChoice(Preset.Dark, State.Appearance),
        ThemeChoice(Preset.Green, State.Appearance)
      ),
      E.Row<Msg>(
        new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
        ThemeChoice(Preset.Blue, State.Appearance),
        ThemeChoice(Preset.Amber, State.Appearance)
      )
    ),
    E.Text<Msg>('')
  );
  const Body: E.Element<Msg> := E.ScrollView<Msg>(
    'options-body', Settings, State.OptionsPosition, OptionsScrolled
  );
  const Footer: E.Element<Msg> := E.Row<Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Size<Msg>(E.Text<Msg>(''), new L.Flex(Grow := 1)),
    E.Button<Msg>('reset', 'Ctrl+R Reset', Msg.ResetOptions, Variant := S.ButtonVariant.Secondary),
    E.Button<Msg>('close', 'Esc Done', Msg.CloseOptions, Variant := S.ButtonVariant.Primary)
  );
  const Content: E.Element<Msg> := E.Styled<Msg>(
    Views.Panel<Msg>(Body, Footer, 'Options', Padding := 1), S.Role.Panel
  );
  return Views.Layer<Msg>(
    'options-overlay',
    Content,
    [InputKeys.Shortcut<Msg>(InputKeys.Key.R, InputKeys.KeyModifiers.Ctrl, Msg.ResetOptions)],
    InitialFocus := 'show-hidden',
    OnDismiss := function(): Msg => Msg.CloseOptions,
    Limits := new InputKeys.OverlayLimits(MaxWidthPercent := 95, MaxHeightPercent := 90)
  );
end function;

function View(State: Model): E.Element<Msg>;
begin
  const Deps: ListDeps := new ListDeps(State.Filter, State.Selected, State.ShowHidden);
  var Count: int := 0;
  for Name: string in Names do
    if Matches(Name, Deps) then
      Count := Count + 1;
    end if;
  end for;
  const Results: E.Element<Msg> := E.CachedSubview<ListDeps, Msg>(
    'results',
    Deps,
    BuildList,
    SameList
  );
  const Footer: E.Element<Msg> := if State.Options then E.Styled<Msg>(
      E.Text<Msg>('Options open · Esc to close'),
      S.Role.Muted
    )
    else E.Row<Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Button<Msg>(
        'options',
        'Ctrl+O Options',
        Msg.OpenOptions,
        Variant := S.ButtonVariant.Secondary
      ),
      E.Button<Msg>('refresh', 'Ctrl+R Refresh', Msg.Refresh, Variant := S.ButtonVariant.Primary),
      E.Button<Msg>('quit', 'Ctrl+Q Quit', Msg.Quit, Variant := S.ButtonVariant.Secondary)
    )
    end if;
  const Body: E.Element<Msg> := E.Column<Msg>(
    new L.Flow(
      Gap := L.Spacing.Fixed(L.Measure.Cells(1)),
      Padding := L.Spacing.Fixed(L.Measure.Cells(1))
    ),
    E.Row<Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Size<Msg>(
        E.Styled<Msg>(E.Text<Msg>('Filter list'), S.Role.Heading),
        new L.Flex(Grow := 1)
      ),
      E.Styled<Msg>(
        E.Text<Msg>(Count.ToString() + (if Count = 1 then ' match' else ' matches' end if)),
        S.Role.Muted
      )
    ),
    E.Row<Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Styled<Msg>(E.Text<Msg>('Search'), S.Role.Muted),
      E.Size<Msg>(
        E.TextInput<Msg>(
          'filter',
          State.Filter,
          State.FilterPosition,
          function(Value: Ed.TextEdit): Msg => Msg.FilterChanged(Value),
          function(Position: Ed.EditorPosition): Msg => Msg.FilterMoved(Position),
          Placeholder := 'Filter by name…'
        ),
        new L.Flex(Grow := 1)
      )
    ),
    E.Size<Msg>(
      E.Styled<Msg>(
        E.Border<Msg>(
          E.Column<Msg>(
            new L.Flow(Padding := L.Spacing.Fixed(L.Measure.Cells(1))),
            E.Size<Msg>(Results, new L.Flex(Grow := 1))
          ),
          'Results'
        ), S.Role.Panel
      ),
      new L.Flex(
        Basis := L.Extent.Fill,
        Minimum := L.Measure.Cells(3),
        Grow := 1
      )
    ),
    Status(State),
    Footer
  );

  const Layers: array of E.Element<Msg> := if State.Options then [
      Options(State)
    ]
    else []
    end if;
  return Views.Screen<Msg>(
    Body, Layers, [
      InputKeys.Shortcut<Msg>(InputKeys.Key.O, InputKeys.KeyModifiers.Ctrl, Msg.OpenOptions),
      InputKeys.Shortcut<Msg>(InputKeys.Key.R, InputKeys.KeyModifiers.Ctrl, Msg.Refresh),
      InputKeys.Shortcut<Msg>(InputKeys.Key.Q, InputKeys.KeyModifiers.Ctrl, Msg.Quit)
    ]
  );
end function;

function RequireControl(Frame: App.Frame; Id: string; Focused: bool := false): App.ControlSnapshot;
begin
  for Control: App.ControlSnapshot in Frame.Controls do
    if Control.Id = Id and (not Focused or Control.Focused) then
      return Control;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing expected control: ' + Id);
end function;

procedure CheckPalette(Session: App.HeadlessSession; Control: string; Expected: TerminalThemes.Theme);
begin
  discard Session.Send(App.Input.Focus(Control));
  discard Session.Step();
  discard Session.Send(App.Input.Activate(Control));
  discard Session.Step();
  const Frame: App.Frame := Session.Snapshot();
  if Frame.Cells[0].Colors.Background <> TerminalThemes.Rgb(
    Expected.Colors.Background,
    Expected.Colors.Background
  )
  then
    raise new Sys.InvalidOperationException(
      'The palette was not applied to the current frame: ' + Control
    );
  end if;

  discard RequireControl(Frame, Control, true);
end procedure;

procedure Demonstrate();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<Model, Msg>(
    new Model(),
    Update,
    View,
    80,
    24,
    ThemeFor
  );
  discard RequireControl(Session.Snapshot(), 'filter', true);
  discard Session.Send(App.Input.Paste('bir' + new string([#13, #10]) + 'ch'));
  discard Session.Step();
  if Session.Snapshot().Controls[0].Value <> 'bir ch' then
    raise new Sys.InvalidOperationException('Paste was not normalized.');
  end if;

  discard Session.Send(App.Input.KeyPress(InputKeys.Key.A, InputKeys.KeyModifiers.Ctrl));
  discard Session.Step();
  discard Session.Send(App.Input.TextInput('bir'));
  discard Session.Step();
  discard Session.Send(App.Input.Activate('items/Birch'));
  discard Session.Step();
  discard Session.Send(App.Input.Focus('filter'));
  discard Session.Step();
  const Selected: App.Frame := Session.Snapshot();
  const Birch: App.ControlSnapshot := RequireControl(Selected, 'items/Birch');
  const Filter: App.ControlSnapshot := RequireControl(Selected, 'filter', true);
  const Marker: T.Cell := Selected.Cells[Birch.Row * Selected.Columns + Birch.Column];
  const Field: T.Cell := Selected.Cells[Filter.Row * Selected.Columns + Filter.Column];
  if Birch.Focused or Marker.Text <> '▸' or Marker.Colors.Background = Field.Colors.Background then
    raise new Sys.InvalidOperationException(
      'Selection did not remain visible when focus returned to the filter.'
    );
  end if;

  discard Session.Send(App.Input.Focus('options'));
  discard Session.Step();
  discard Session.Send(App.Input.Activate('options'));
  discard Session.Step();
  discard RequireControl(Session.Snapshot(), 'show-hidden', true);
  CheckPalette(Session, 'theme-light', TerminalThemes.Light());
  CheckPalette(Session, 'theme-green', TerminalThemes.Dark(TerminalThemes.Accent.Green));
  CheckPalette(Session, 'theme-blue', TerminalThemes.Dark(TerminalThemes.Accent.Blue));
  CheckPalette(Session, 'theme-amber', TerminalThemes.Dark(TerminalThemes.Accent.Amber));
  CheckPalette(Session, 'theme-dark', TerminalThemes.Dark());
  discard Session.Send(App.Input.KeyPress(InputKeys.Key.Escape, InputKeys.KeyModifiers.None));
  discard Session.Step();
  discard RequireControl(Session.Snapshot(), 'options', true);
  discard Session.Send(App.Input.KeyPress(InputKeys.Key.R, InputKeys.KeyModifiers.Ctrl));
  discard Session.Step();
  using const Deadline: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(
    5000
  );
  for Index: int := 1 to 4 do
    if not Session.WaitForWork(Deadline.Token).GetAwaiter().GetResult() then
      raise new Sys.InvalidOperationException('Missing progress update.');
    end if;

    discard Session.Step();
  end for;

  discard Session.Send(App.Input.Resize(53, 17));
  discard Session.Step();
  const Frame: App.Frame := Session.Snapshot();
  if Frame.Columns <> 53 or Frame.Rows <> 17 then
    raise new Sys.InvalidOperationException('Unexpected frame size.');
  end if;

  const Text: string := Sys.String.Join('', Frame.Lines);
  if not Text.Contains('Up to date') or not Text.Contains('100%') then
    raise new Sys.InvalidOperationException('The last progress message was not displayed.');
  end if;

  for Line: string in Frame.Lines do
    Console.WriteLine(Line.TrimEnd());
  end for;
end procedure;

begin
  const Arguments: array of string := Sys.Environment.GetCommandLineArgs();
  if Sys.Array.IndexOf<string>(Arguments, '--headless-control') >= 0 then
    using const Session: App.HeadlessSession := App.StartHeadless<Model, Msg>(
      new Model(),
      Update,
      View,
      80,
      24,
      ThemeFor
    );
    while Session.IsOpen() do
      Threads.Thread.Sleep(20);
    end while;
  else
    if Sys.Array.IndexOf<string>(Arguments, '--headless') >= 0 then
      Demonstrate();
    else
      App.Run<Model, Msg>(new Model(), Update, View, ThemeFor);
    end if;
  end if;
end;
end program;
