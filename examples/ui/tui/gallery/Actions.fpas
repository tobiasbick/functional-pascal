unit Gallery.Actions;

uses
  Gallery.State as State, Gallery.SplitButton as Split, Gallery.ConfirmButton as Confirm,
  Gallery.StatusButton as Status, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S;

// Composes the accepted examples from CUI's extended Actions page.
//
// ## Parameters
// - `Model`: Current gallery state.
// - `Wide`: Whether the previews fit alongside each other.
// ## Returns
// Split buttons and the two morphing feedback controls.
public function View(Model: State.Model; Wide: bool): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := L.Spacing.Normal),
    Split.View(Model),
    E.Column<State.Msg>(
      E.Styled<State.Msg>(E.Text<State.Msg>('Morphing buttons'), S.Role.Heading),
      E.Styled<State.Msg>(
        E.Text<State.Msg>('Confirm before destroying, and show the result of work in place.'),
        S.Role.Secondary
      ),
      if Wide then E.Row<State.Msg>(
          new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Logical(12)), Align := L.Alignment.Start),
          Confirm.View(Model), Status.View(Model)
        )
        else E.Column<State.Msg>(Confirm.View(Model), Status.View(Model))
        end if
    )
  );
end function;
end unit;
