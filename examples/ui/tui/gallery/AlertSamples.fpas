// [Documentation](../../../../docs/ui/tui/feedback/alert.md)

unit TuiGallery.AlertSamples;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Feedback.Alerts as A;

uses Gallery.Shared.Strings as Strings;

// Shows the CUI Feedback examples in a terminal column.
// ## Type parameters
// - `TMsg`: Gallery message type.
// ## Returns
// Neutral, success, warning, and danger alerts.
public function View of TMsg(): E.Element of TMsg;
begin
  return E.Column of TMsg(
    new L.Flow(Gap := L.Spacing.Tight),
    E.Styled of TMsg(E.Text of TMsg(Strings.Get('Heading.Alerts')), S.Role.Heading),
    A.Alert of TMsg(
      'update', 'A new version is available',
      new A.Options(Description := 'Restart to update to 1.1.')
    ),
    A.Alert of TMsg(
      'payment', 'Payment received',
      new A.Options(Description := 'Your invoice was paid on November 5.', Tone := S.Tone.Success)
    ),
    A.Alert of TMsg(
      'storage', 'Storage almost full',
      new A.Options(
        Description := 'You have used 92% of your plan.',
        Tone := S.Tone.Warning,
        Dismissible := true
      )
    ),
    A.Alert of TMsg(
      'build', 'Build failed',
      new A.Options(
        Description := 'Missing symbol cui_frame in main.c line 42.',
        Tone := S.Tone.Danger
      )
    )
  );
end function;

end unit;
