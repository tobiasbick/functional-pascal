// [Documentation](README.md)

unit TuiGallery.Catalog;

// Terminal preview associated with a catalog entry.
public type Preview = enum
  Description;
  Overview;
  Buttons;
  Inputs;
  Selection;
  Overlays;
  Feedback;
  DataDisplay;
  AppChrome;
  Text;
  CellGrid;
end enum;

// One destination in the terminal gallery.
public type Entry = record
  // Visible destination name, also used as the sidebar key.
  public Title: string;
  // Short introduction shown in the preview panel.
  public Description: string;
  // Live example to display below the introduction.
  public Demo: Preview := Preview.Description;
end record;

// Core destinations in GUI gallery order.
public const Components: array of Entry := [
  new Entry('Overview', 'Components for FPas', Preview.Overview),
  new Entry('Buttons', 'Variants, sizes and states.', Preview.Buttons),
  new Entry('Inputs', 'Text fields', Preview.Inputs),
  new Entry('Selection', 'Controls for choosing one option or several.', Preview.Selection),
  new Entry('Navigation', 'Sidebars, tabs and paths between views.'),
  new Entry(
    'Overlays',
    'Dialogs and sheets',
    Preview.Overlays
  ),
  new Entry('Feedback', 'Show how far a task has progressed.', Preview.Feedback),
  new Entry(
    'Data display',
    'Rows and lists for presenting structured information.',
    Preview.DataDisplay
  ),
  new Entry('Charts', 'Visual summaries of values and trends.')
];

// Supplementary destinations in GUI gallery order.
public const Extended: array of Entry := [
  new Entry('Actions', 'Commands with confirmation, menus or status feedback.'),
  new Entry('Smart inputs', 'Editors for structured values.'),
  new Entry('Pickers', 'Choose colors, dates and other values.'),
  new Entry('Capture', 'Controls for capturing user input.'),
  new Entry('Disclosure', 'Expand and collapse related content.'),
  new Entry('Reader', 'Outlines and anchors for navigating a document.'),
  new Entry('Data grid', 'Tabular data organized into rows and columns.'),
  new Entry('Code', 'Source listings and code presentation.'),
  new Entry('Social and media', 'Profiles, conversations and media content.'),
  new Entry('Planning', 'Calendars, schedules and timelines.'),
  new Entry('More charts', 'Additional views of series and distributions.'),
  new Entry('Motion', 'Transitions and animated feedback.'),
  new Entry('AI', 'Conversations, sources and tool activity.'),
  new Entry('Audio', 'Audio levels, waveforms and playback controls.'),
  new Entry('Files', 'File listings and file operations.'),
  new Entry('Developer tools', 'Diagnostic views and developer controls.'),
  new Entry('More developer tools', 'Additional developer and inspection tools.'),
  new Entry('Instruments', 'Indicators for measurements and signals.'),
  new Entry('Creative controls', 'Controls for creative editing.'),
  new Entry('Canvas and bars', 'Drawing surfaces and contextual actions.'),
  new Entry('Voice', 'Voice input and conversation controls.'),
  new Entry('Layout', 'Containers that arrange and size their children.'),
  new Entry('Text and display', 'Typography and secondary information.', Preview.Text),
  new Entry('Editing tools', 'Actions for editing and formatting content.'),
  new Entry('App chrome', 'The panels and bars that frame an application.', Preview.AppChrome)
];

// Additional widgets specific to terminal applications.
public const Terminal: array of Entry := [
  new Entry('Cell grid', 'Explore a colored ripple field.', Preview.CellGrid)
];

end unit;
