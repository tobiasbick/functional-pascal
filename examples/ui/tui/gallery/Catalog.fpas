// [Documentation](README.md)

unit TuiGallery.Catalog;

uses Gallery.Shared.Strings as Strings;

// Live example associated with a catalog entry.
public type Preview = enum
  Overview;
  Buttons;
  Inputs;
  Pickers;
  Selection;
  Navigation;
  Overlays;
  Feedback;
  Charts;
  DataDisplay;
  DataGrid;
  Disclosure;
  AppChrome;
  Code;
  Files;
  Text;
end enum;

// One destination in the terminal gallery.
public type Entry = record
  // Stable sidebar and preview key.
  public Id: string;
  // Visible localized destination name.
  public Title: string;
  // Live example displayed in the preview.
  public Demo: Preview;
end record;

// Core terminal examples.
public const Components: array of Entry := [
  new Entry('Overview', Strings.Get('Page.Overview'), Preview.Overview),
  new Entry('Buttons', Strings.Get('Page.Buttons'), Preview.Buttons),
  new Entry('Inputs', Strings.Get('Page.Inputs'), Preview.Inputs),
  new Entry('Selection', Strings.Get('Page.Selection'), Preview.Selection),
  new Entry('Navigation', Strings.Get('Page.Navigation'), Preview.Navigation),
  new Entry('Overlays', Strings.Get('Page.Overlays'), Preview.Overlays),
  new Entry('Feedback', Strings.Get('Page.Feedback'), Preview.Feedback),
  new Entry('Data display', Strings.Get('Page.Lists'), Preview.DataDisplay),
  new Entry('Charts', Strings.Get('Page.Charts'), Preview.Charts)
];

// Supplementary terminal examples.
public const Extended: array of Entry := [
  new Entry('Pickers', Strings.Get('Page.Pickers'), Preview.Pickers),
  new Entry('Disclosure', Strings.Get('Page.Disclosure'), Preview.Disclosure),
  new Entry('Data grid', Strings.Get('Page.DataGrid'), Preview.DataGrid),
  new Entry('Code', Strings.Get('Page.Code'), Preview.Code),
  new Entry('Files', Strings.Get('Page.Files'), Preview.Files),
  new Entry('Text and display', Strings.Get('Page.Display'), Preview.Text),
  new Entry('App chrome', Strings.Get('Page.Desktop'), Preview.AppChrome)
];

end unit;
