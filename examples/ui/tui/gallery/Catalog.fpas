// [Documentation](README.md)

unit TuiGallery.Catalog;

uses Gallery.Shared.Strings as Strings;

// Terminal preview associated with a catalog entry.
public type Preview = enum
  Description;
  Overview;
  Buttons;
  Actions;
  Inputs;
  Pickers;
  Selection;
  Navigation;
  Overlays;
  Feedback;
  Charts;
  DataDisplay;
  DataGrid;
  Disclosure;
  AppChrome;
  Code;
  Files;
  Text;
  CellGrid;
end enum;

// One destination in the terminal gallery.
public type Entry = record
  // Stable sidebar and preview key.
  public Id: string;
  // Visible localized destination name.
  public Title: string;
  // Short introduction shown in the preview panel.
  public Description: string;
  // Live example to display below the introduction.
  public Demo: Preview := Preview.Description;
end record;

// Core destinations in GUI gallery order.
public const Components: array of Entry := [
  new Entry(
    'Overview',
    Strings.Get('Page.Overview'),
    Strings.Get('Text.ComponentsForFpas'),
    Preview.Overview
  ),
  new Entry(
    'Buttons',
    Strings.Get('Page.Buttons'),
    Strings.Get('Description.Buttons'),
    Preview.Buttons
  ),
  new Entry('Inputs', Strings.Get('Page.Inputs'), Strings.Get('Text.TextFields'), Preview.Inputs),
  new Entry(
    'Selection',
    Strings.Get('Page.Selection'),
    Strings.Get('Description.Selection'),
    Preview.Selection
  ),
  new Entry(
    'Navigation',
    Strings.Get('Page.Navigation'),
    Strings.Get('Description.Navigation'),
    Preview.Navigation
  ),
  new Entry(
    'Overlays', Strings.Get('Page.Overlays'), Strings.Get('Text.DialogsAndSheets'),
    Preview.Overlays
  ),
  new Entry(
    'Feedback',
    Strings.Get('Page.Feedback'),
    Strings.Get('Description.Feedback'),
    Preview.Feedback
  ),
  new Entry(
    'Data display', Strings.Get('Page.Lists'), Strings.Get('Description.Lists'),
    Preview.DataDisplay
  ),
  new Entry('Charts', Strings.Get('Page.Charts'), Strings.Get('Description.Charts'), Preview.Charts)
];

