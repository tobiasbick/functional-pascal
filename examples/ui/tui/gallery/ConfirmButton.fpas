unit Gallery.ConfirmButton;

uses
  Gallery.State as State, Fpas.Ui.Widgets.Actions.ConfirmButtons as Confirm, Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, System as Sys;

// Shows CUI's two-step destructive action with a harmless confirmation counter.
//
// ## Parameters
// - `Model`: Current gallery state.
// ## Returns
// A terminal confirmation button with countdown and its completed action count.
public function View(Model: State.Model): E.Element<State.Msg>;
begin
  return E.Column<State.Msg>(
    new L.Flow(Gap := L.Spacing.Normal),
    Confirm.ConfirmButton<State.Msg>(
      'confirm-delete', 'Delete project', State.Msg.ConfirmDelete,
      new Confirm.Options(Icon := Sys.Char.ConvertFromUtf32($E18E), TerminalIcon := '×')
    ),
    E.Styled<State.Msg>(
      E.Text<State.Msg>('Confirmed: ' + Model.DeleteCount.ToString()),
      S.Role.Muted
    )
  );
end function;

end unit;
