unit Gallery.CopyButton;

uses
  Gallery.State as State, Fpas.Ui.CopyButtons as Copy, Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L, Fpas.Ui.Styles as S;

// Displays a command with a copy action.
//
// ## Returns
// The gallery's copy-button example.
public function View(): E.Element<State.Msg>;
begin
  const Command: string := 'npm i cui';
  return E.Styled<State.Msg>(
    E.Row<State.Msg>(
      new L.Flow(Gap := L.Spacing.Tight, Padding := L.Spacing.Tight, Align := L.Alignment.Center),
      E.Text<State.Msg>(Command),
      Copy.CopyButton<State.Msg>('copy-install', Command)
    ),
    S.Role.Panel
  );
end function;

end unit;
