// [Documentation](../../../../docs/ui/tui/data-display/table.md)

unit TuiGallery.PeopleSample;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Collections.Tables as T;

uses Gallery.Shared.PeopleTable as People;
uses Gallery.Shared.Strings as Strings;
uses System.Collections.Generic as C;

// Displays compact columns and the selected person's details.
// ## Type parameters
// - `TMsg`: Gallery message type.
// ## Parameters
// - `Order`: Current sort.
// - `Selected`: Selected person's stable ID.
// - `SortBy`: Maps a header activation.
// - `SelectPerson`: Maps a row activation.
// - `Height`: Visible terminal rows including the header.
// ## Returns
// The Data display table and details.
public function View of TMsg(
  Order: T.Sort;
  Selected: string;
  SortBy: function(T.Sort): TMsg;
  SelectPerson: function(string): TMsg;
  Height: int
): E.Element of TMsg;
begin
  const Rows: C.List of T.Row of TMsg := new C.List of T.Row of TMsg();
  const Columns: array of T.Column := People.Columns(
    L.Extent.Content,
    L.Extent.Content,
    L.Extent.Content
  );
  const SharedSortColumn: int := case Order.Column of
    when 1: 2;
    when 2: 3;
    else Order.Column;
  end case;
  var Details: string := '';
  for Item: People.Person in People.Ordered(
    new T.Sort(SharedSortColumn, Order.Descending)
  ) do
    if Item.Id = Selected then
      Details := Item.Email + '  ·  ' + Strings.Get('Text.TableRevenue') + ' ' + Item.Revenue;
    end if;

    Rows.Add(
      new T.Row of TMsg(
        Item.Id, [
          (T.Cell of TMsg).Text(Item.Name),
          (T.Cell of TMsg).Text(Item.Role),
          (T.Cell of TMsg).Text(Item.Status)
        ], Item.Id = Selected
      )
    );
  end for;

  return E.Column of TMsg(
    T.Table of TMsg(
      'people', [Columns[0], Columns[2], Columns[3]], Rows.ToArray(), Order, SortBy, SelectPerson,
      new T.Options(Height := L.Extent.Fixed(L.Measure.Cells(Height)), HorizontalScroll := true)
    ),
    E.Text of TMsg(Details)
  );
end function;

end unit;
