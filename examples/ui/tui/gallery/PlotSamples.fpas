// [Documentation](README.md)

unit TuiGallery.PlotSamples;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.Sparklines as Charts;
uses Fpas.Ui.Widgets.Feedback.Spinners as Spin;

uses Gallery.Shared.Strings as Strings;
uses System.Globalization as Culture;

// Shows a single activity indicator with the task it represents.
// ## Type parameters
// - `TMsg`: Gallery message type.
// ## Returns
// One line of activity feedback.
public function Activity of TMsg(): E.Element of TMsg;
begin
  return E.Row of TMsg(
    new L.Flow(Gap := L.Spacing.Tight),
    Spin.Spinner of TMsg('spinner-sync'),
    E.Text of TMsg(Strings.Get('Tui.Spinner.Sync'))
  );
end function;

// Shows the original CUI Charts series together with its latest value.
// ## Type parameters
// - `TMsg`: Gallery message type.
// ## Returns
// A single line with the trend and latest sample.
public function Sparkline of TMsg(): E.Element of TMsg;
begin
  const Values: array of float := [3.0F, 5.0F, 4.0F, 8.0F, 6.0F, 9.0F, 8.0F];
  return E.Row of TMsg(
    new L.Flow(Gap := L.Spacing.Tight),
    Charts.Sparkline of TMsg('chart-sparkline', Values),
    E.Text of TMsg(
      Strings.Get('Tui.Sparkline.Latest') +
      Values[Values.Length - 1].ToString(Culture.CultureInfo.CurrentCulture)
    )
  );
end function;

end unit;
