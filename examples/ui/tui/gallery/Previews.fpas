unit Gallery.Previews;

uses Gallery.State as G, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Choices as Ch, Fpas.Ui.Styles as S, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as InputKeys, Fpas.Ui.TerminalExtensions.Views as Views, Fpas.Ui.Editors as Ed, Fpas.Ui.Tui.Themes as Themes, System.Collections.Generic as Generic;

function Buttons(State: G.Model): E.Element<G.Msg>;
begin
  return E.Column<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Text<G.Msg>('Presses: ' + State.Presses.ToString()),
    E.Row<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Button<G.Msg>('button-press', 'Press me', G.Msg.Press, Variant := S.ButtonVariant.Primary),
      E.Button<G.Msg>(
        'button-reset',
        'Reset',
        G.Msg.ResetPresses,
        Variant := S.ButtonVariant.Destructive
      ),
      E.Button<G.Msg>('button-disabled', 'Disabled', G.Msg.Press, false, S.ButtonVariant.Primary)
    )
  );
end function;

function Checkboxes(State: G.Model): E.Element<G.Msg>;
begin
  return E.Column<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Checkbox<G.Msg>(
      'check-toggle',
      'Toggle this option',
      State.Checked,
      function(Value: bool): G.Msg => G.Msg.Check(Value)
    ),
    E.Checkbox<G.Msg>(
      'check-disabled',
      'Disabled and checked',
      true,
      function(Value: bool): G.Msg => G.Msg.Check(Value),
      false
    )
  );
end function;

function EditText(Value: Ed.TextEdit): G.Msg;
begin
  return G.Msg.Edit(Value);
end function;

function Editor(State: G.Model): E.Element<G.Msg>;
begin
  return E.Column<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Text<G.Msg>('Type, select, or paste text.'),
    E.TextInput<G.Msg>(
      'text-entry',
      State.Text,
      State.TextPosition,
      EditText,
      function(Position: Ed.EditorPosition): G.Msg => G.Msg.MoveText(Position),
      Placeholder := 'Type something…'
    ),
    E.Text<G.Msg>('Text length: ' + State.Text.Length.ToString())
  );
end function;

const SampleItems: array of Ch.SelectionItem := [
  new Ch.SelectionItem('amber', 'Amber'),
  new Ch.SelectionItem('birch', 'Birch'),
  new Ch.SelectionItem('cedar', 'Cedar', CanActivate := false),
  new Ch.SelectionItem('dogwood', 'Dogwood'),
  new Ch.SelectionItem('elm', 'Elm'),
  new Ch.SelectionItem('fir', 'Fir'),
  new Ch.SelectionItem('ginkgo', 'Ginkgo'),
  new Ch.SelectionItem('hazel', 'Hazel'),
  new Ch.SelectionItem('juniper', 'Juniper')
];

function ItemName(Key: string): string;
begin
  for Item: Ch.SelectionItem in SampleItems do
    if Item.Key = Key then
      return Item.Text;
    end if;
  end for;

  return '-';
end function;

function Lists(State: G.Model): E.Element<G.Msg>;
begin
  const Items: E.Element<G.Msg> := if State.Empty then E.Text<G.Msg>('No items.')
    else E.Size<G.Msg>(
      E.SelectionList<G.Msg>(
        'sample-list', SampleItems, State.Selection,
        function(Key: string): G.Msg => G.Msg.Choose(Key),
        function(Key: string): G.Msg => G.Msg.OpenItem(Key)
      ),
      new L.Flex(
        Basis := L.Extent.Fixed(L.Measure.Cells(3)),
        Grow := 1,
        Maximum := L.Measure.Cells(6)
      )
    )
    end if;
  return E.Column<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Checkbox<G.Msg>(
      'list-empty',
      'Show empty state',
      State.Empty,
      function(Value: bool): G.Msg => G.Msg.EmptyList(Value)
    ),
    Items,
    E.Column<G.Msg>(
      E.Text<G.Msg>(
        if State.Empty then 'Selection hidden' else 'Selected: ' + ItemName(State.Selection) end if
      ),
      E.Text<G.Msg>('Opened: ' + ItemName(State.Opened))
    )
  );
end function;

function Progress(State: G.Model): E.Element<G.Msg>;
begin
  return E.Column<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Text<G.Msg>(State.Progress.ToString() + '% complete'),
    E.ProgressBar<G.Msg>(State.Progress),
    E.Row<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Button<G.Msg>(
        'progress-advance',
        '+25%',
        G.Msg.Advance,
        State.Progress < 100,
        S.ButtonVariant.Primary
      ),
      E.Button<G.Msg>(
        'progress-reset',
        'Reset',
        G.Msg.ResetProgress,
        Variant := S.ButtonVariant.Secondary
      )
    )
  );
end function;

function Layout(Colors: Themes.Theme): E.Element<G.Msg>;
begin
  return E.Column<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Divider<G.Msg>('Rows and columns'),
    E.Text<G.Msg>('A row with a fixed and a growing child.'),
    E.Row<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Size<G.Msg>(
        E.CellStyled<G.Msg>(E.Text<G.Msg>('Fixed'), Colors.Secondary),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(8)))
      ),
      E.Size<G.Msg>(
        E.CellStyled<G.Msg>(E.Text<G.Msg>('Fills the rest'), Colors.Primary),
        new L.Flex(Grow := 1)
      )
    ),
    E.Divider<G.Msg>(),
    E.Border<G.Msg>(E.Text<G.Msg>('A border around text'), 'Border')
  );
end function;

function LogScrolled(Change: L.ScrollChange): G.Msg;
begin
  return G.Msg.ScrollLog(Change.Position);
end function;

function Scrolling(State: G.Model): E.Element<G.Msg>;
begin
  const Lines: Generic.List<E.Element<G.Msg>> := new Generic.List<E.Element<G.Msg>>();
  for Entry: int := 1 to State.LogCount do
    Lines.Add(E.Text<G.Msg>('Event ' + Entry.ToString('00')));
  end for;
  const Status: string := case State.LogPosition of
    when L.ScrollPosition.End: 'Following newest';
    else 'Paused · End follows newest';
  end case;
  return E.Column<G.Msg>(
    E.Text<G.Msg>(Status),
    E.Size<G.Msg>(
      E.Border<G.Msg>(
        E.ScrollView<G.Msg>(
          'sample-scroll', E.Column<G.Msg>(Lines.ToArray()), State.LogPosition, LogScrolled
        ), 'Event log'
      ),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(6)), Minimum := L.Measure.Cells(4))
    ),
    E.Row<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Button<G.Msg>(
        'log-append',
        'Append event',
        G.Msg.AppendLog,
        State.LogCount < 100,
        S.ButtonVariant.Primary
      ),
      E.Button<G.Msg>(
        'log-follow',
        'Follow newest',
        G.Msg.ScrollLog(L.ScrollPosition.End),
        Variant := S.ButtonVariant.Secondary
      )
    )
  );
end function;

function Position(Label: string; Column: int; Row: int): G.Msg;
begin
  return G.Msg.CanvasEvent(Label + ' at ' + Column.ToString() + ', ' + Row.ToString());
end function;

function Canvas(State: G.Model; Colors: Themes.Theme): E.Element<G.Msg>;
  function Draw(Column: int; Row: int): T.Cell;
  begin
    return if (Column div 4 + Row div 2) mod 2 = 0 then Tile else Other end if;
  end function;
begin
  const Tile: T.Cell := new T.Cell(' ', Colors.Primary);
  const Other: T.Cell := new T.Cell(' ', Colors.Secondary);
  return E.Column<G.Msg>(
    E.Text<G.Msg>('Canvas: ' + State.Columns.ToString() + ' × ' + State.Rows.ToString()),
    E.Size<G.Msg>(
      E.CellCanvas<G.Msg>(
        'sample-canvas', Draw, new T.CanvasEvents<G.Msg>(
          OnResize := function(Columns: int; Rows: int): G.Msg => G.Msg.ResizeCanvas(Columns, Rows),
          OnClick := function(Column: int; Row: int): G.Msg => Position('Left click', Column, Row),
          OnMiddleClick := function(Column: int; Row: int): G.Msg => Position(
            'Middle click',
            Column,
            Row
          ),
          OnScroll := function(Column: int; Row: int; Delta: int): G.Msg => Position(
            if Delta < 0 then 'Wheel up' else 'Wheel down' end if,
            Column,
            Row
          )
        )
      ),
      new L.Flex(Grow := 1)
    ),
    E.Text<G.Msg>(State.Pointer)
  );
end function;

const SettingsTabs: array of Ch.TabItem := [
  new Ch.TabItem('general', 'General settings'),
  new Ch.TabItem('updates', 'Updates unavailable', false),
  new Ch.TabItem('appearance', 'Appearance and themes'),
  new Ch.TabItem('shortcuts', 'Keyboard shortcuts')
];

function SettingsPanel(State: G.Model; Key: string): E.Element<G.Msg>;
begin
  case Key of
    when 'general':
      return E.Column<G.Msg>(
        E.Text<G.Msg>('Display name'),
        E.TextInput<G.Msg>(
          'tab-name',
          State.TabName,
          State.TabPosition,
          function(Value: Ed.TextEdit): G.Msg => G.Msg.EditTabName(Value),
          function(Position: Ed.EditorPosition): G.Msg => G.Msg.MoveTabName(Position)
        )
      );
    when 'appearance':
      return E.Checkbox<G.Msg>(
        'tab-colors',
        'Preview colors',
        State.PreviewColors,
        function(Value: bool): G.Msg => G.Msg.ToggleTabColors(Value)
      );
    else
      return E.Text<G.Msg>('Ctrl+T returns to General.');
  end case;
end function;

function Settings(State: G.Model): E.Element<G.Msg>;
begin
  return E.Tabs<G.Msg>(
    'settings-tabs', SettingsTabs, State.ActiveTab,
    function(Key: string): G.Msg => G.Msg.ChooseTab(Key),
    function(Key: string): E.Element<G.Msg> => SettingsPanel(State, Key)
  );
end function;

const WorldColumns: array of Ch.TableColumn := [
  new Ch.TableColumn(
    'World',
    new L.Flex(
      Basis := L.Extent.Fixed(L.Measure.Cells(12)),
      Minimum := L.Measure.Cells(5),
      Grow := 1
    )
  ),
  new Ch.TableColumn(
    'Status',
    new L.Flex(
      Basis := L.Extent.Fixed(L.Measure.Cells(8)),
      Minimum := L.Measure.Cells(8),
      Maximum := L.Measure.Cells(8)
    )
  ),
  new Ch.TableColumn(
    'Players',
    new L.Flex(
      Basis := L.Extent.Fixed(L.Measure.Cells(7)),
      Minimum := L.Measure.Cells(7),
      Maximum := L.Measure.Cells(7)
    )
  )
];

const Worlds: array of Ch.TableRow := [
  new Ch.TableRow('alder', ['Alder', 'Ready', '2']),
  new Ch.TableRow('birch', ['Birch', 'Offline', '0'], CanActivate := false),
  new Ch.TableRow('cedar', ['Cedar', 'Ready', '4']),
  new Ch.TableRow('dogwood', ['Dogwood', 'Ready', '1']),
  new Ch.TableRow('elm', ['Elm', 'Ready', '3']),
  new Ch.TableRow('fir', ['Fir', 'Offline', '0'], CanActivate := false),
  new Ch.TableRow('ginkgo', ['Ginkgo', 'Ready', '1']),
  new Ch.TableRow('hazel', ['Hazel', 'Ready', '5']),
  new Ch.TableRow('juniper', ['Juniper', 'Ready', '2'])
];

function WorldTable(State: G.Model): E.Element<G.Msg>;
begin
  return E.Column<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Size<G.Msg>(
      E.Table<G.Msg>(
        'world-table', WorldColumns, Worlds, State.TableSelection,
        function(Key: string): G.Msg => G.Msg.SelectWorld(Key),
        function(Key: string): G.Msg => G.Msg.OpenWorld(Key)
      ),
      new L.Flex(
        Basis := L.Extent.Fixed(L.Measure.Cells(3)),
        Grow := 1,
        Maximum := L.Measure.Cells(7)
      )
    ),
    E.Column<G.Msg>(
      E.Text<G.Msg>('Selected: ' + State.TableSelection),
      E.Text<G.Msg>('Opened: ' + (if State.TableOpened = '' then '-' else State.TableOpened end if))
    )
  );
end function;

function EditDocument(Change: Ed.TextEdit): G.Msg;
begin
  return G.Msg.EditDocument(Change);
end function;

function NavigateDocument(Position: Ed.EditorPosition): G.Msg;
begin
  return G.Msg.NavigateDocument(Position);
end function;

function DocumentButton(State: G.Model; Kind: G.DocumentKind): E.Element<G.Msg>;
begin
  const Name: string := Kind.ToString();
  return E.Button<G.Msg>(
    'document-' + Name.ToLowerInvariant(), Name, G.Msg.ChooseDocument(Kind),
    Variant := if State.ActiveDocument = Kind then S.ButtonVariant.Active
      else S.ButtonVariant.Secondary
      end if
  );
end function;

function Multiline(State: G.Model): E.Element<G.Msg>;
begin
  const Document: G.Document := G.CurrentDocument(State);
  const Status: string := if Document.Dirty then 'Edited' else 'Unchanged' end if;
  return E.Column<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Row<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      DocumentButton(State, G.DocumentKind.Notes),
      DocumentButton(State, G.DocumentKind.Draft),
      E.Text<G.Msg>(Status)
    ),
    E.Size<G.Msg>(
      E.Multiline<G.Msg>(
        'document-editor',
        Document.Text,
        Document.Position,
        EditDocument,
        NavigateDocument
      ),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(1)), Grow := 1)
    )
  );
end function;

public function Body(State: G.Model; Colors: Themes.Theme): E.Element<G.Msg>;
begin
  return case State.Active of
    when G.Page.Buttons: Buttons(State);
    when G.Page.Checkbox: Checkboxes(State);
    when G.Page.TextInput: Editor(State);
    when G.Page.Lists: Lists(State);
    when G.Page.Progress: Progress(State);
    when G.Page.Layout: Layout(Colors);
    when G.Page.Scrolling: Scrolling(State);
    when G.Page.Canvas: Canvas(State, Colors);
    when G.Page.Tabs: Settings(State);
    when G.Page.Table: WorldTable(State);
    when G.Page.Multiline: Multiline(State);
    when G.Page.Overlay: E.Column<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Text<G.Msg>('Focus returns here when you close it.'),
      E.Button<G.Msg>(
        'overlay-open',
        'Open overlay',
        G.Msg.SetOverlay(true),
        Variant := S.ButtonVariant.Primary
      )
    );
    else E.Text<G.Msg>('Choose a widget.');
  end case;
end function;

function OverlayScrolled(Change: L.ScrollChange): G.Msg;
begin
  return G.Msg.ScrollOverlay(Change.Position);
end function;

public function Overlay(State: G.Model; Colors: Themes.Theme): E.Element<G.Msg>;
begin
  const Instructions: E.Element<G.Msg> := E.Column<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Text<G.Msg>('Scroll from here. Tab to the body and use Page Down, or use the mouse wheel.'),
    E.Text<G.Msg>('Resize the terminal to make the body narrower or shorter.'),
    E.Text<G.Msg>('The text wraps to the available width, including space for the scrollbar.'),
    E.Text<G.Msg>('Only the body scrolls. The Close button stays in the footer.'),
    E.Text<G.Msg>('Focus stays inside the overlay until you close it.'),
    E.Text<G.Msg>('End of overlay notes.')
  );
  const Body: E.Element<G.Msg> := E.ScrollView<G.Msg>(
    'overlay-body', Instructions, State.OverlayPosition, OverlayScrolled
  );
  return Views.Layer<G.Msg>(
    'sample-overlay',
    E.CellStyled<G.Msg>(
      Views.Panel<G.Msg>(
        Body,
        E.Button<G.Msg>(
          'overlay-close',
          'Esc Close',
          G.Msg.SetOverlay(false),
          Variant := S.ButtonVariant.Primary
        ),
        'Modal overlay',
        Padding := 1
      ),
      Colors.Panel
    ),
    [],
    InitialFocus := 'overlay-close',
    OnDismiss := function(): G.Msg => G.Msg.SetOverlay(false),
    Limits := new InputKeys.OverlayLimits(MaxWidthPercent := 80, MaxHeightPercent := 60)
  );
end function;
end unit;
