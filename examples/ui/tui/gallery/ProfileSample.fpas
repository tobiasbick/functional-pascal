// [Documentation](../../../../docs/ui/mvu/README.md#composing-larger-views)

unit TuiGallery.ProfileSample;

uses Fpas.Ui.Composition as Composition;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Inputs.TextFields as Fields;
uses Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs;
uses Fpas.Ui.Widgets.Overlays.Sheets as Sheets;

uses Gallery.Shared.Profile as Demo;
uses Gallery.Shared.Strings as Strings;
uses Gallery.Shared.SwitchExamples as Switches;

// Modal example presented over the gallery.
public type Layer = enum
  Closed;
  Profile;
  Notifications;
  Delete;
end enum;

// Profile shared by Overview, Inputs and Overlays.
public type State = record
  // Full name shown by all three views.
  public Name: string := Demo.Name;
  // Email address shared by the same views.
  public Email: string := Demo.Email;
  // Wi-Fi, profile visibility and mention notifications.
  public Wifi: bool := true;
  // Bluetooth and weekly digest.
  public Bluetooth: bool := false;
  // Reply notifications.
  public Newsletter: bool := true;
  // Independent airplane mode setting.
  public Airplane: bool := false;
  // Current modal.
  public Open: Layer := Layer.Closed;
end record;

// Profile edits and modal actions.
public type Msg = variant
  // Edit the full name.
  SetName(Value: string);
  // Edit the email address.
  SetEmail(Value: string);
  // Set the shared connectivity and profile switch.
  SetWifi(Value: bool);
  // Set Bluetooth and weekly notifications.
  SetBluetooth(Value: bool);
  // Set reply notifications.
  SetNewsletter(Value: bool);
  // Set airplane mode.
  SetAirplane(Value: bool);
  // Open or dismiss a modal.
  Show(Value: Layer);
end variant;

// Applies a profile edit or overlay request.
// ## Parameters
// - `Model`: Current sample.
// - `Message`: Requested change.
// ## Returns
// Updated sample.
public function Update(Model: State; Message: Msg): State;
begin
  return case Message of
    when Msg.SetName(const Value: string): Model with
      Name := Value;
    end with;
    when Msg.SetEmail(const Value: string): Model with
      Email := Value;
    end with;
    when Msg.SetWifi(const Value: bool): Model with
      Wifi := Value;
    end with;
    when Msg.SetBluetooth(const Value: bool): Model with
      Bluetooth := Value;
    end with;
    when Msg.SetNewsletter(const Value: bool): Model with
      Newsletter := Value;
    end with;
    when Msg.SetAirplane(const Value: bool): Model with
      Airplane := Value;
    end with;
    when Msg.Show(const Value: Layer): Model with
      Open := Value;
    end with;
  end case;
end function;

// Builds the two supported profile fields in their page-specific presentation.
// ## Parameters
// - `Model`: Shared name and email.
// - `Prefix`: Stable ID prefix used by the GUI example.
// - `SideBySide`: Use the wide Inputs layout.
// ## Returns
// Name and email editors in gallery order.
public function Editors(Model: State; Prefix: string; SideBySide: bool := false): E.Element of Msg;
begin
  const Inputs: bool := Prefix = 'input';
  const Workspace: bool := Prefix = 'workspace';
  const Name: E.Element of Msg := Fields.TextField of Msg(
    Prefix + '-name', Model.Name, Msg.SetName,
    new Fields.Options(
      Label := if Inputs then
        Strings.Get('Text.FullName')
      else
        Strings.Get('Text.Name')
      end if,
      Placeholder := if Inputs then
        Demo.Name
      elsif Workspace then
        Strings.Get('Text.YourName')
      else
        ''
      end if, MaxUtf8Bytes := 63
    )
  );
  const Email: E.Element of Msg := Fields.TextField of Msg(
    Prefix + '-email', Model.Email, Msg.SetEmail,
    new Fields.Options(
      Label := Strings.Get('Text.Email'), Hint := if Inputs then
        Strings.Get('Text.EmailPrivacy')
      else
        ''
      end if,
      Placeholder := if Workspace then
        'you@example.com'
      else
        ''
      end if, MaxUtf8Bytes := 95
    )
  );
  const Flow: L.Flow := new L.Flow(Gap := L.Spacing.Normal);
  const Half: L.Flex := new L.Flex(Basis := L.Extent.Fill, Grow := 1);
  return if SideBySide then
    E.Row of Msg(Flow, E.Size of Msg(Name, Half), E.Size of Msg(Email, Half))
  else
    E.Column of Msg(Flow, Name, Email)
  end if;
end function;

// Displays the switches under Components → Selection in GUI order.
// ## Parameters
// - `Model`: Current shared preferences.
// ## Returns
// Wi-Fi, Bluetooth and airplane mode.
public function Selection(Model: State): E.Element of Msg;
begin
  return E.Column of Msg(
    new L.Flow(Gap := L.Spacing.Normal),
    Switches.View of Msg(Switches.Wifi, Model.Wifi, Msg.SetWifi),
    Switches.View of Msg(Switches.Bluetooth, Model.Bluetooth, Msg.SetBluetooth),
    Switches.View of Msg(Switches.Airplane, Model.Airplane, Msg.SetAirplane)
  );
end function;

// Builds the supported triggers in the GUI's Dialogs and sheets section.
// ## Parameters
// - `Wide`: Whether all three actions fit on one row.
// ## Returns
// Three overlay actions.
public function Openers(Wide: bool): E.Element of Msg;
begin
  const Flow: L.Flow := new L.Flow(Gap := L.Spacing.Tight);
  const Triggers: array of E.Element of Msg := [
    B.Button of Msg('edit-profile-open', Strings.Get('Text.EditProfile'), Msg.Show(Layer.Profile)),
    B.Button of Msg('sheet-open', Strings.Get('Text.OpenSheet'), Msg.Show(Layer.Notifications)),
    B.Button of Msg(
      'delete-project-open', Strings.Get('Text.DeleteProject'), Msg.Show(Layer.Delete),
      new B.Options(Variant := S.ButtonVariant.Destructive)
    )
  ];
  return if Wide then
    E.Row of Msg(Flow, Triggers)
  else
    E.Column of Msg(Flow, Triggers)
  end if;
end function;

// Presents the selected example over the complete gallery.
// ## Type parameters
// - `TMsg`: Parent message type.
// ## Parameters
// - `Base`: Gallery screen.
// - `Model`: Shared fields and open overlay.
// - `Lift`: Maps an edit into the parent update.
// ## Returns
// The screen with its active dialog or sheet.
public function Present of TMsg(Base: E.Element of TMsg; Model: State; Lift: function(Msg): TMsg): E.Element of TMsg;
begin
  const Close: TMsg := Lift(Msg.Show(Layer.Closed));
  const Flow: L.Flow := new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Normal);
  case Model.Open of
    when Layer.Profile:
      return Dialogs.Dialog of TMsg(
        'edit-profile',
        Base,
        E.Column of TMsg(
          Flow,
          Composition.Map of (Msg, TMsg)(Editors(Model, 'edit-profile'), Lift),
          Switches.View of TMsg(
            Switches.PublicProfile,
            Model.Wifi,
            function(Value: bool): TMsg => Lift(Msg.SetWifi(Value))
          ),
          E.Row of TMsg(
            new L.Flow(Gap := L.Spacing.Tight),
            B.Button of TMsg('edit-profile-cancel', Strings.Get('Text.Cancel'), Close),
            B.Button of TMsg(
              'edit-profile-save',
              Strings.Get('Text.SaveChanges'),
              Close,
              new B.Options(Variant := S.ButtonVariant.Primary)
            )
          )
        ),
        true,
        new Dialogs.Options(
          Strings.Get('Text.EditProfile'),
          Description := Strings.Get('Text.TeamChanges'),
          InitialFocus := 'edit-profile-name'
        ),
        Close
      );
    when Layer.Notifications:
      return Sheets.Sheet of TMsg(
        'sheet',
        Base,
        E.Column of TMsg(
          new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Tight),
          Switches.View of TMsg(
            Switches.Comments,
            Model.Newsletter,
            function(Value: bool): TMsg => Lift(Msg.SetNewsletter(Value))
          ),
          Switches.View of TMsg(
            Switches.Mentions,
            Model.Wifi,
            function(Value: bool): TMsg => Lift(Msg.SetWifi(Value))
          ),
          Switches.View of TMsg(
            Switches.WeeklyDigest,
            Model.Bluetooth,
            function(Value: bool): TMsg => Lift(Msg.SetBluetooth(Value))
          ),
          E.Styled of TMsg(E.Text of TMsg(Strings.Get('Text.Recent')), S.Role.Heading),
          E.Text of TMsg(
            Strings.Get('Text.RecentComment') + ' · ' + Strings.Get('Text.MinutesAgo')
          ),
          E.Text of TMsg(
            Strings.Get('Text.RecentInvitation') + ' · ' + Strings.Get('Text.HourAgo')
          )
        ),
        true,
        new Sheets.Options(
          Strings.Get('Text.Notifications'),
          Description := Strings.Get('Text.NotificationsHint')
        ),
        Close
      );
    when Layer.Delete:
      return Dialogs.Dialog of TMsg(
        'delete-project',
        Base,
        E.Column of TMsg(
          Flow,
          E.Text of TMsg(
            Strings.Get('Text.DeleteProjectWarning')
          ),
          E.Row of TMsg(
            new L.Flow(Gap := L.Spacing.Tight),
            B.Button of TMsg('delete-project-cancel', Strings.Get('Text.Cancel'), Close),
            B.Button of TMsg(
              'delete-project-confirm',
              Strings.Get('Text.DeleteProject'),
              Close,
              new B.Options(Variant := S.ButtonVariant.Destructive)
            )
          )
        ),
        true,
        new Dialogs.Options(
          Strings.Get('Text.DeleteProjectQuestion'),
          Width := 400,
          InitialFocus := 'delete-project-cancel'
        ),
        Close
      );
    else
      return Base;
  end case;
end function;

end unit;
