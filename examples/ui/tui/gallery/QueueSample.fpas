unit TuiGallery.QueueSample;

uses
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S,
  Fpas.Ui.Widgets.Inputs.TextFields as Fields, Fpas.Ui.Widgets.Actions.Buttons as B, Fpas.Ui.Widgets.Overlays.Dialogs as D,
  Fpas.Ui.Widgets.Overlays.Sheets as Sheets, System as Sys, System.Collections.Generic as C;

// The single overlay open over the gallery.
public type Layer = enum
  Closed;
  Sheet;
  Dialog;
end enum;

// Model shared by the Buttons and Overlays previews.
public type State = record
  // Tracks in playback order.
  public Tracks: array of string := ['First light', 'Night train'];
  // Unsubmitted track title.
  public Title: string := '';
  // Current overlay.
  public Open: Layer := Layer.Closed;
end record;

// Actions available in the queue previews.
public type Msg = variant
  EditTitle(Value: string);
  Add;
  Remove;
  Show(Surface: Layer);
  Clear;
end variant;

// Maximum number of tracks in the gallery sample.
public const Capacity: int := 3;

function Summary(Value: State): string;
begin
  return if Value.Tracks.Length = 1 then
    '1 track queued'
  else
    Value.Tracks.Length.ToString() + ' tracks queued'
  end if;
end function;

// Applies a queue action.
// ## Parameters
// - `Value`: Current queue and overlay.
// - `Action`: Requested change.
// ## Returns
// Updated sample state.
public function Update(Value: State; Action: Msg): State;
begin
  case Action of
    when Msg.EditTitle(const Title: string):
      return Value with
        Title := Title;
      end with;
    when Msg.Add:
      if Value.Tracks.Length < Capacity and not Sys.String.IsNullOrWhiteSpace(Value.Title) then
        const Items: C.List<string> := new C.List<string>(Value.Tracks);
        Items.Add(Value.Title.Trim());
        return Value with
          Tracks := Items.ToArray();
          Title := '';
        end with;
      end if;
    when Msg.Remove:
      if Value.Tracks.Length > 0 then
        const Items: C.List<string> := new C.List<string>(Value.Tracks);
        Items.RemoveAt(Items.Count - 1);
        return Value with
          Tracks := Items.ToArray();
        end with;
      end if;
    when Msg.Show(const Surface: Layer):
      return Value with
        Open := Surface;
      end with;
    when Msg.Clear:
      return Value with
        Tracks := [];
        Open := Layer.Closed;
      end with;
  end case;

  return Value;
end function;

// Builds the queue editing buttons and count.
// ## Parameters
// - `Value`: Current queue.
// ## Returns
// The interactive Buttons preview.
public function Buttons(Value: State): E.Element<Msg>;
begin
  const CanAdd: bool := Value.Tracks.Length < Capacity and not Sys.String.IsNullOrWhiteSpace(
    Value.Title
  );
  const Submit: Sys.Func<string, Msg>? := if CanAdd then
    function(Title: string): Msg => Msg.Add
  else
    null
  end if;
  return E.Column<Msg>(
    new L.Flow(Gap := L.Spacing.Normal),
    Fields.TextField<Msg>(
      'queue-title', Value.Title, Msg.EditTitle,
      new Fields.Options(
        Label := 'Track title', Placeholder := 'Enter a track title',
        Hint := if Value.Tracks.Length = Capacity then
          'Queue full. Remove a track to add another.'
        else
          'Press Enter to add the track.'
        end if
      ), Submit
    ),
    E.Row<Msg>(
      new L.Flow(Gap := L.Spacing.Normal),
      B.Button<Msg>(
        'queue-add', 'Add track', Msg.Add,
        new B.Options(Variant := S.ButtonVariant.Primary, Enabled := CanAdd)
      ),
      B.Button<Msg>(
        'queue-remove',
        'Remove last',
        Msg.Remove,
        new B.Options(Enabled := Value.Tracks.Length > 0)
      )
    ),
    E.Text<Msg>(Summary(Value))
  );
end function;

// Builds the two overlay launchers.
// ## Parameters
// - `Value`: Current queue.
// ## Returns
// The interactive Overlays preview.
public function Openers(Value: State): E.Element<Msg>;
begin
  return E.Column<Msg>(
    new L.Flow(Gap := L.Spacing.Normal),
    B.Button<Msg>('queue-show', 'View queue', Msg.Show(Layer.Sheet)),
    B.Button<Msg>(
      'queue-reset',
      'Clear queue…',
      Msg.Show(Layer.Dialog),
      new B.Options(Enabled := Value.Tracks.Length > 0)
    ),
    E.Text<Msg>(Summary(Value))
  );
end function;

// Places the open queue overlay over the full gallery.
// ## Type parameters
// - `TMsg`: Gallery message type.
// ## Parameters
// - `Base`: Full two-panel gallery view.
// - `Value`: Queue and open overlay.
// - `Lift`: Maps a sample action to a gallery message.
// ## Returns
// The gallery with its current modal, if any.
public function Present<TMsg>(Base: E.Element<TMsg>; Value: State; Lift: function(Msg): TMsg): E.Element<TMsg>;
begin
  const Close: TMsg := Lift(Msg.Show(Layer.Closed));
  const Flow: L.Flow := new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Normal);
  case Value.Open of
    when Layer.Sheet:
      const Rows: C.List<E.Element<TMsg>> := new C.List<E.Element<TMsg>>();
      for Index: int := 0 to Value.Tracks.Length - 1 do
        Rows.Add(E.Text<TMsg>((Index + 1).ToString() + '. ' + Value.Tracks[Index]));
      end for;

      Rows.Add(B.Button<TMsg>('queue-done', 'Done', Close));
      return Sheets.Sheet<TMsg>(
        'queue-sheet',
        Base,
        E.Column<TMsg>(Flow, Rows.ToArray()),
        true,
        new Sheets.Options(
          'Play queue',
          Description := Summary(Value),
          Size := 272,
          InitialFocus := 'queue-done'
        ),
        Close
      );
    when Layer.Dialog:
      return D.Dialog<TMsg>(
        'queue-dialog', Base, E.Column<TMsg>(
          Flow,
          E.Text<TMsg>(
            if Value.Tracks.Length = 1 then
              'Remove the queued track?'
            else
              'Remove all ' + Value.Tracks.Length.ToString() + ' queued tracks?'
            end if
          ),
          E.Row<TMsg>(
            new L.Flow(Gap := L.Spacing.Normal),
            B.Button<TMsg>('queue-cancel', 'Cancel', Close),
            B.Button<TMsg>(
              'queue-clear',
              'Clear',
              Lift(Msg.Clear),
              new B.Options(Variant := S.ButtonVariant.Destructive)
            )
          )
        ),
        true, new D.Options('Clear queue?', Width := 304, InitialFocus := 'queue-cancel'), Close
      );
    else
      return Base;
  end case;
end function;

end unit;
