unit Gallery.State;

uses Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Themes as Themes;

// Pages from the CUI gallery with accepted FPAS previews.
public type Page = enum: byte
  // Gallery introduction.
  Overview;
  // Buttons and their related actions.
  Buttons;
  // The model-controlled sheet.
  Overlays;
  // Related actions from the extended gallery.
  Actions;
end enum;

// Independent actions in the button group.
public type TextFormat = enum: byte
  // Draw text in bold.
  Bold = 1;
  // Draw text in italics.
  Italic = 2;
  // Draw an underline.
  Underline = 4;
end enum;

// Retained gallery and preview state.
public type Model = record
  // Active navigation destination.
  public Active: Page := Page.Overview;
  // Whether the gallery uses the dark palette.
  public Dark: bool := true;
  // Whether the save action is busy.
  public ButtonLoading: bool := false;
  // Active formatting actions.
  public Formats: int := 0;
  // Completed holds shown by the gallery preview.
  public HoldCount: int := 0;
  // Last action from either split button.
  public SplitResult: string := '';
  // Whether the compact navigation drawer is open.
  public Drawer: bool := false;
  // Whether the sheet preview is open.
  public Sheet: bool := false;
end record;

// Actions available to the gallery.
public type Msg = variant
  // Select a navigation destination.
  Show(Value: Page);
  // Move forward or backward between the gallery pages.
  MovePage(Direction: int);
  // Switch the gallery's palette.
  Theme;
  // Activate a button that has no retained effect.
  Preview;
  // Change the save action's busy state.
  SetButtonLoading(Value: bool);
  // Toggle one formatting action.
  ToggleFormat(Style: TextFormat);
  // Record one completed hold.
  ConfirmHold;
  // Record a primary or menu action.
  SplitChoice(Value: string);
  // Open or close the compact navigation drawer.
  SetDrawer(Open: bool);
  // Open or close the sheet preview.
  SetSheet(Open: bool);
  // Leave the terminal application.
  Quit;
end variant;

// Resolves the palette for the current gallery appearance.
//
// ## Parameters
// - `State`: Current gallery model.
// ## Returns
// The light or dark CUI palette.
public function ThemeFor(State: Model): Themes.Theme;
begin
  return if State.Dark then Themes.Dark() else Themes.Light() end if;
end function;

// Applies a gallery action.
//
// ## Parameters
// - `State`: Current gallery model.
// - `Message`: Action to apply.
// ## Returns
// The next model and any host commands.
public function Update(State: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  const Next: Model := case Message of
    when Msg.Show(const Value: Page): State with
      Active := Value;
      Drawer := false;
      Sheet := false;
    end with;
    when Msg.MovePage(const Direction: int): State with
      Active := cast<Page>((cast<int>(State.Active) + Direction + 4) mod 4);
      Drawer := false;
      Sheet := false;
    end with;
    when Msg.Theme: State with
      Dark := not State.Dark;
    end with;
    when Msg.SetButtonLoading(const Value: bool): State with
      ButtonLoading := Value;
    end with;
    when Msg.ToggleFormat(const Style: TextFormat): State with
      Formats := State.Formats xor cast<int>(Style);
    end with;
    when Msg.SplitChoice(const Value: string): State with
      SplitResult := Value;
    end with;
    when Msg.ConfirmHold: State with
      HoldCount := State.HoldCount + 1;
    end with;
    when Msg.SetDrawer(const Open: bool): State with
      Drawer := Open;
    end with;
    when Msg.SetSheet(const Open: bool): State with
      Sheet := Open;
    end with;
    when Msg.Preview: State;
    when Msg.Quit: State;
  end case;
  const Commands: array of Mvu.Command<Msg> := case Message of
    when Msg.Quit: [Mvu.Exit<Msg>()];
    else [];
  end case;
  return new Mvu.Transition<Model, Msg>(Next, Commands);
end function;
end unit;
