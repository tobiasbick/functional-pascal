<!-- [Documentation](README.md) -->
<Project Sdk="Fpas.NET.Sdk/0.1.0-dev">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>fpas-tui-gallery</AssemblyName>
    <AssemblyTitle>FPas TUI Gallery</AssemblyTitle>
    <ApplicationIcon>packaging/windows/FpasTuiGallery.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../gui/gallery/Shared/Strings.fpas" />
    <Compile Include="../../gui/gallery/Shared/ListEntries.fpas" />
    <Compile Include="../../gui/gallery/Shared/PeopleFilters.fpas" />
    <Compile Include="../../gui/gallery/Shared/PaginationExample.fpas" />
    <Compile Include="../../gui/gallery/Shared/BreadcrumbExample.fpas" />
    <Compile Include="../../gui/gallery/Shared/LanguagesExample.fpas" />
    <Compile Include="../../gui/gallery/Shared/FilePickerExample.fpas" />
    <EmbeddedResource Include="../../gui/gallery/Shared/Strings.resx" LogicalName="Gallery.Shared.Strings.resources" />
    <EmbeddedResource Include="../../gui/gallery/Shared/Strings.de.resx" LogicalName="Gallery.Shared.Strings.de.resources" />
    <Compile Include="../../gui/gallery/Shared/PeopleTable.fpas;../../gui/gallery/Shared/ButtonExamples.fpas;../../gui/gallery/Shared/EditorStatus.fpas;../../gui/gallery/Shared/Profile.fpas;../../gui/gallery/Shared/ProgressExample.fpas;../../gui/gallery/Shared/SwitchExamples.fpas;../../gui/gallery/Shared/CheckboxExamples.fpas;../../gui/gallery/Shared/SaveFrequency.fpas;../../gui/gallery/Shared/PickerChoices.fpas;../../gui/gallery/Shared/TabExamples.fpas;../../gui/gallery/Shared/AboutField.fpas;../../gui/gallery/Shared/ProjectOptions.fpas;../../gui/gallery/Shared/SecurityCard.fpas;../../gui/gallery/Shared/BuildLog.fpas;../../gui/gallery/Shared/SourceTree.fpas" />
    <ProjectReference Include="../../../../src/Fpas.Ui.Tui/Fpas.Ui.Tui.fpasproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Content Include="packaging/linux/io.github.tobiasbick.FpasTuiGallery.desktop"
             Link="share/applications/%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="packaging/linux/io.github.tobiasbick.FpasTuiGallery.svg"
             Link="share/icons/hicolor/scalable/apps/%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
