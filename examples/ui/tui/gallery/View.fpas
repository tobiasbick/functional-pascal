unit Gallery.View;

uses Gallery.State as G, Gallery.Previews as P, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Navigation as N, Fpas.Ui.Sheets as Sheets, Fpas.Ui.IconButtons as Icons, Fpas.Ui.Styles as S, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as InputKeys, Fpas.Ui.TerminalExtensions.Views as Views, Fpas.Ui.Themes as Themes, Fpas.Ui.Tui.Status as Status, System.Collections.Generic as Generic, System as Sys;

function Pages(Active: G.Page): E.Element<G.Msg>;
begin
  const Sections: Generic.List<N.Section<G.Msg>> := new Generic.List<N.Section<G.Msg>>();
  const Items: Generic.List<N.Item<G.Msg>> := new Generic.List<N.Item<G.Msg>>();
  for Page: G.Page in G.Pages do
    if Page = G.Page.Layout then
      Sections.Add(new N.Section<G.Msg>('Components', Items.ToArray()));
      Items.Clear();
    end if;

    Items.Add(
      new N.Item<G.Msg>(Page.ToString().ToLowerInvariant(), G.Title(Page), G.Msg.Show(Page))
    );
  end for;

  Sections.Add(new N.Section<G.Msg>('Extended', Items.ToArray()));
  return N.Sidebar<G.Msg>(
    'pages',
    Sections.ToArray(),
    Active.ToString().ToLowerInvariant()
  );
end function;

function ThemeButton(Current: G.Preset; Target: G.Preset): E.Element<G.Msg>;
begin
  const Label: string := Target.ToString();
  return E.Button<G.Msg>(
    'theme-' + Label.ToLowerInvariant(), Label, G.Msg.ChangeTheme(Target),
    Variant := if Current = Target then S.ButtonVariant.Active else S.ButtonVariant.Secondary end if
  );
end function;

function ThemeBar(Current: G.Preset; Columns: int): E.Element<G.Msg>;
begin
  const Flow: L.Flow := new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1)));
  const Light: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Light);
  const Dark: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Dark);
  const Green: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Green);
  const Blue: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Blue);
  const Amber: E.Element<G.Msg> := ThemeButton(Current, G.Preset.Amber);
  // The five captions, button padding and gaps take 37 cells.
  if Columns < 39 then
    return E.Column<G.Msg>(E.Row<G.Msg>(Flow, Light, Dark, Green), E.Row<G.Msg>(Flow, Blue, Amber));
  end if;

  const Buttons: E.Element<G.Msg> := E.Row<G.Msg>(Flow, Light, Dark, Green, Blue, Amber);
  return if Columns < 52 then Buttons
    else E.Row<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Text<G.Msg>('Theme: ' + Current.ToString()),
      Buttons
    )
    end if;
end function;

const PreviousPage: InputKeys.ShortcutBinding<G.Msg> := InputKeys.Shortcut<G.Msg>(
  InputKeys.Key.PageUp, InputKeys.KeyModifiers.None, G.Msg.MovePage(-1)
);
const NextPage: InputKeys.ShortcutBinding<G.Msg> := InputKeys.Shortcut<G.Msg>(
  InputKeys.Key.PageDown, InputKeys.KeyModifiers.None, G.Msg.MovePage(1)
);
const Quit: InputKeys.ShortcutBinding<G.Msg> := InputKeys.Shortcut<G.Msg>(
  InputKeys.Key.Q,
  InputKeys.KeyModifiers.Ctrl,
  G.Msg.Quit
);

const Keys: array of InputKeys.ShortcutBinding<G.Msg> := [
  PreviousPage, NextPage,
  InputKeys.Shortcut<G.Msg>(
    InputKeys.Key.T,
    InputKeys.KeyModifiers.Ctrl,
    G.Msg.ChooseTab('general')
  ),
  Quit
];

const QuitHint: string := Status.Hint<G.Msg>(Quit, 'Quit');
const EscapeHint: string := Status.Hint(InputKeys.Key.Escape, InputKeys.KeyModifiers.None, 'Close');
const Hints: array of string := [
  QuitHint, Status.Hint(InputKeys.Key.Tab, InputKeys.KeyModifiers.None, 'Focus'),
  Status.Hint<G.Msg>(PreviousPage, 'Previous page'), Status.Hint<G.Msg>(NextPage, 'Next page')
];

function StatusLine(State: G.Model; Compact: bool): E.Element<G.Msg>;
begin
  if State.Overlay then
    return Status.Line<G.Msg>(if Compact then '' else 'Overlay open' end if, EscapeHint);
  end if;

  if Compact then
    return Status.Line<G.Msg>('', QuitHint);
  end if;

  return Status.Line<G.Msg>(G.Title(State.Active), Hints);
end function;

function PageButtons(): E.Element<G.Msg>;
begin
  return E.Row<G.Msg>(
    new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
    E.Button<G.Msg>('previous-page', 'Previous', G.Msg.MovePage(-1)),
    E.Button<G.Msg>('next-page', 'Next', G.Msg.MovePage(1))
  );
end function;

function Build(State: G.Model; Viewport: T.Viewport): E.Element<G.Msg>;
begin
  const Colors: Themes.Theme := G.Colors(State.Appearance);
  const Overlays: array of E.Element<G.Msg> := if State.Overlay then [P.Overlay(State)]
    else []
    end if;
  if Viewport.Columns < 32 or Viewport.Rows < 12 then
    const Help: string := if State.Overlay then ' Escape closes the overlay.'
      else ' Ctrl+Q quits.'
      end if;
    return Views.Screen<G.Msg>(
      E.Styled<G.Msg>(E.Text<G.Msg>('Resize to 32 × 12.' + Help), S.Role.Heading),
      Overlays, Keys
    );
  end if;

  const Compact: bool := Viewport.Columns < 42;
  const Dimensions: string := Viewport.Columns.ToString() + ' × ' + Viewport.Rows.ToString();
  const Heading: string := if Compact then 'Gallery' else 'FPAS  /  Widget Gallery' end if;
  const Title: E.Element<G.Msg> := E.Styled<G.Msg>(
    E.Text<G.Msg>(Heading + '   ' + Dimensions),
    S.Role.Heading
  );
  const Header: E.Element<G.Msg> := if Compact then E.Row<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      Title, Icons.IconButton<G.Msg>(
        'drawer-open', Sys.Char.ConvertFromUtf32($E115), 'Components', G.Msg.SetDrawer(true),
        new Icons.Options(TerminalGlyph := '≡')
      )
    )
    else Title
    end if;
  const Navigation: E.Element<G.Msg> := Pages(State.Active);
  const Preview: E.Element<G.Msg> := E.Styled<G.Msg>(
    E.Border<G.Msg>(
      E.Column<G.Msg>(
        new L.Flow(Padding := L.Spacing.Fixed(L.Measure.Cells(if Compact then 0 else 1 end if))),
        E.Size<G.Msg>(P.Body(State, Colors), new L.Flex(Grow := 1))
      ), G.Title(State.Active)
    ),
    S.Role.Panel
  );
  const Body: E.Element<G.Msg> := if Compact then Preview
    else E.Row<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      E.Size<G.Msg>(
        E.Border<G.Msg>(E.ScrollView<G.Msg>('pages-scroll', Navigation), 'Widgets'),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(17)), Minimum := L.Measure.Cells(11))
      ),
      E.Size<G.Msg>(Preview, new L.Flex(Basis := L.Extent.Fill))
    )
    end if;
  const Line: E.Element<G.Msg> := E.Styled<G.Msg>(StatusLine(State, Compact), S.Role.Muted);
  const Footer: E.Element<G.Msg> := if Compact then E.Row<G.Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1))),
      PageButtons(),
      E.Size<G.Msg>(Line, new L.Flex(Basis := L.Extent.Fill))
    )
    else Line
    end if;
  const Page: E.Element<G.Msg> := Views.Screen<G.Msg>(
    E.Column<G.Msg>(
      new L.Flow(
        Padding := L.Spacing.Fixed(L.Measure.Cells(1)),
        Gap := L.Spacing.Fixed(L.Measure.Cells(if Compact then 0 else 1 end if))
      ),
      Header,
      E.Size<G.Msg>(Body, new L.Flex(Basis := L.Extent.Fill, Minimum := L.Measure.Cells(4))),
      ThemeBar(State.Appearance, Viewport.Columns),
      Footer
    ),
    Overlays,
    Keys
  );
  return if Compact then Sheets.Sheet<G.Msg>(
      'drawer', Page, Navigation, State.Drawer,
      new Sheets.Options('Components', Edge := Sheets.Side.Left, Size := 200),
      G.Msg.SetDrawer(false)
    )
    else Page
    end if;
end function;

public function View(State: G.Model; Viewport: L.Viewport): E.Element<G.Msg>;
begin
  return Views.Viewport<G.Msg>(
    'gallery-window',
    function(Size: T.Viewport): E.Element<G.Msg> => Build(State, Size)
  );
end function;
end unit;
