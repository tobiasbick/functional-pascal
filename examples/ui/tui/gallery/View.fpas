unit Gallery.View;

uses
  Gallery.State as G, Gallery.Buttons as Buttons, Gallery.Actions as Actions, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L,
  Fpas.Ui.Navigation as N, Fpas.Ui.Sheets as Sheets, Fpas.Ui.IconButtons as Icons,
  Fpas.Ui.Buttons as B, Fpas.Ui.Styles as S, Fpas.Ui.Terminal as T,
  Fpas.Ui.TerminalExtensions.Input as Keys, Fpas.Ui.TerminalExtensions.Views as Views,
  System as Sys;

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill);
const Padded: L.Flow := new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Normal);
const Shortcuts: array of Keys.ShortcutBinding<G.Msg> := [
  Keys.Shortcut<G.Msg>(Keys.Key.PageUp, Keys.KeyModifiers.None, G.Msg.MovePage(-1)),
  Keys.Shortcut<G.Msg>(Keys.Key.PageDown, Keys.KeyModifiers.None, G.Msg.MovePage(1)),
  Keys.Shortcut<G.Msg>(Keys.Key.Q, Keys.KeyModifiers.Ctrl, G.Msg.Quit)
];

function Item(Page: G.Page): N.Item<G.Msg>;
begin
  const Label: string := Page.ToString();
  return new N.Item<G.Msg>(Label.ToLowerInvariant(), Label, G.Msg.Show(Page));
end function;

function Navigation(Page: G.Page): E.Element<G.Msg>;
begin
  return N.Sidebar<G.Msg>(
    'pages',
    [
      new N.Section<G.Msg>(
        'Components',
        [Item(G.Page.Overview), Item(G.Page.Buttons), Item(G.Page.Overlays)]
      ),
      new N.Section<G.Msg>('Extended', [Item(G.Page.Actions)])
    ],
    Page.ToString().ToLowerInvariant()
  );
end function;

function ThemeButton(State: G.Model): E.Element<G.Msg>;
begin
  return B.Button<G.Msg>('theme', if State.Dark then 'Light' else 'Dark' end if, G.Msg.Theme);
end function;

function Preview(State: G.Model; Wide: bool): E.Element<G.Msg>;
begin
  case State.Active of
    when G.Page.Overview:
      return E.Column<G.Msg>(
        new L.Flow(Gap := L.Spacing.Normal),
        E.Styled<G.Msg>(E.Text<G.Msg>('Components for FPAS'), S.Role.Heading),
        E.Text<G.Msg>('Explore the CUI components available in the terminal.'),
        B.Button<G.Msg>(
          'browse',
          'Browse components',
          G.Msg.Show(G.Page.Buttons),
          new B.Options(Variant := S.ButtonVariant.Primary)
        )
      );
    when G.Page.Actions:
      return Actions.View(State, Wide);
    when G.Page.Buttons:
      return Buttons.View(State, Wide);
    when G.Page.Overlays:
      return E.Column<G.Msg>(
        new L.Flow(Gap := L.Spacing.Normal),
        E.Styled<G.Msg>(E.Text<G.Msg>('Sheet'), S.Role.Heading),
        B.Button<G.Msg>('sheet-open', 'Open sheet', G.Msg.SetSheet(true))
      );
    else
      raise new Sys.InvalidOperationException('Unknown gallery page.');
  end case;
end function;

function Build(State: G.Model; Size: T.Viewport): E.Element<G.Msg>;
begin
  const Compact: bool := Size.Columns < 56;
  const Pages: E.Element<G.Msg> := Navigation(State.Active);
  const PreviewContent: E.Element<G.Msg> := Preview(State, Size.Columns >= 100);
  const Content: E.Element<G.Msg> := E.ScrollView<G.Msg>(
    'main-' + State.Active.ToString().ToLowerInvariant(),
    E.Column<G.Msg>(
      Padded,
      if State.Active = G.Page.Overview then PreviewContent
        else E.Column<G.Msg>(
          new L.Flow(Gap := L.Spacing.Normal),
          E.Styled<G.Msg>(E.Text<G.Msg>(State.Active.ToString()), S.Role.PageTitle), PreviewContent
        )
        end if
    )
  );
  const Body: E.Element<G.Msg> := if Compact then E.Column<G.Msg>(
      E.Styled<G.Msg>(
        E.Row<G.Msg>(
          Padded,
          Icons.IconButton<G.Msg>(
            'drawer-open', Sys.Char.ConvertFromUtf32($E115), 'Components', G.Msg.SetDrawer(true),
            new Icons.Options(TerminalGlyph := '≡')
          ),
          E.Text<G.Msg>('FPas CUI')
        ),
        S.Role.MutedPanel
      ),
      E.Size<G.Msg>(Content, Fill)
    )
    else E.Row<G.Msg>(
      new L.Flow(Align := L.Alignment.Stretch),
      E.Size<G.Msg>(
        E.Styled<G.Msg>(
          E.Column<G.Msg>(
            Padded,
            E.Styled<G.Msg>(E.Text<G.Msg>('FPas CUI'), S.Role.Heading),
            E.Size<G.Msg>(Pages, Fill),
            ThemeButton(State)
          ),
          S.Role.MutedPanel
        ),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(24)))
      ),
      E.Size<G.Msg>(Content, Fill)
    )
    end if;
  const Page: E.Element<G.Msg> := Views.Screen<G.Msg>(
    E.Column<G.Msg>(
      E.Size<G.Msg>(Body, Fill),
      E.Styled<G.Msg>(
        E.Text<G.Msg>(' Ctrl+Q Quit   Tab Focus'),
        S.Role.Muted
      )
    ),
    [], Shortcuts
  );
  const Main: E.Element<G.Msg> := if Compact then Sheets.Sheet<G.Msg>(
      'drawer',
      Page,
      E.Column<G.Msg>(new L.Flow(Gap := L.Spacing.Normal), Pages, ThemeButton(State)),
      State.Drawer,
      new Sheets.Options(
        'FPas CUI',
        Edge := Sheets.Side.Left,
        Size := 200
      ),
      G.Msg.SetDrawer(false)
    )
    else Page
    end if;
  return Sheets.Sheet<G.Msg>(
    'sheet', Main, E.Text<G.Msg>('Choose what we tell you about.'), State.Sheet,
    new Sheets.Options('Notifications', Size := 240), G.Msg.SetSheet(false)
  );
end function;

// Builds the gallery against the terminal viewport.
//
// ## Parameters
// - `State`: Retained gallery state.
// - `Viewport`: Portable host size information.
// ## Returns
// The gallery view with terminal cell sizing.
public function View(State: G.Model; Viewport: L.Viewport): E.Element<G.Msg>;
begin
  return Views.Viewport<G.Msg>(
    'gallery-window',
    function(Size: T.Viewport): E.Element<G.Msg> => Build(State, Size)
  );
end function;
end unit;
