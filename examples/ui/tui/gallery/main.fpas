// [Documentation](README.md)

program TuiWidgetGallery;

uses
  Gallery.Shared.SecurityCard as Security,
  Gallery.Shared.ProjectOptions as ProjectOptions,
  Gallery.Shared.AboutField as AboutSample,
  Fpas.Ui.Tui.Application as App, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Elements as E,
  TuiGallery.PeopleSample as People, Fpas.Ui.Widgets.Collections.Tables as Tables, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Theming.Themes as Themes,
  TuiGallery.CellGridSample as GridSample, Fpas.Ui.TerminalExtensions.CellGrids as Grids, Fpas.Ui.Composition as Composition,
  Fpas.Ui.TerminalExtensions.Input as Keys, Fpas.Ui.TerminalExtensions.Views as Views,
  Gallery.Shared.PickerChoices as Pickers, Gallery.Shared.SaveFrequency as Frequency, Gallery.Shared.CheckboxExamples as Checks, Gallery.Shared.EditorStatus as Status, Gallery.Shared.ButtonExamples as Buttons, Gallery.Shared.ProgressExample as Progress,
  Fpas.Ui.Widgets.Actions.Buttons as B, Fpas.Ui.Widgets.Developer.Terminal as Term,
  TuiGallery.ProfileSample as Profile, TuiGallery.Catalog as Catalog, Fpas.Ui.Widgets.Navigation.Navigation as Nav,
  Gallery.Shared.TabExamples as TabExamples, Fpas.Ui.Widgets.Navigation.Tabs as Tabs, System as Sys, System.Threading as Threads;

type Msg = variant
  SelectPage(Page: Catalog.Entry);
  Preview;
  SetSaving(Value: bool);
  MenuChoice(Name: string);
  DesktopCommand(Id: string);
  CreateWorkspace;
  SetWeeklySummary(Value: bool);
  SetMarketing(Value: bool);
  SetSaveFrequency(Value: int);
  SetCountry(Value: int);
  SetAbout(Value: string);
  SetTab(Value: int);
  SetPillTab(Value: int);
  SetSecurity(Value: bool);
  SetPickerLanguage(Value: int);
  Grid(Event: Grids.Event);
  ProfileAction(Action: Profile.Msg);
  Focus(Id: string);
  SortPeople(Order: Tables.Sort);
  SelectPerson(Id: string);
  ToggleTheme;
  Quit;
end variant;

type Model = record
  public Active: Catalog.Entry;
  public Mode: Themes.Mode := Themes.Mode.Dark;
  public Saving: bool := false;
  public MenuChoice: string := '';
  public WeeklySummary: bool := false;
  public Marketing: bool := false;
  public SecurityOpen: bool := Security.Initial;
  public ActiveTab: int := 0;
  public ActivePillTab: int := 0;
  public About: string := AboutSample.Initial;
  public Country: int := Pickers.InitialCountry;
  public PickerLanguage: int := Pickers.InitialLanguage;
  public SaveFrequency: int := Frequency.Initial;
  public WorkspaceCreated: bool := false;
  public ProfileState: Profile.State := new Profile.State();
  public PeopleOrder: Tables.Sort := new Tables.Sort(0);
  public Person: string := 'person-1';
  public Encoding: int := 0;
  public Indent: int := 1;
  public Language: int := 0;
  public Grid: GridSample.State := new GridSample.State();
end record;

function ThemeFor(State: Model): Themes.Theme;
begin
  const Base: Themes.Theme := if State.Mode = Themes.Mode.Dark then
    Themes.Dark(Themes.Accent.Blue)
  else
    Themes.Light(Themes.Accent.Blue)
  end if;
  return Base with
    Colors := Base.Colors with
      Border := Base.Colors.Info;
    end with;
  end with;
end function;

function Update(State: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  var Next: Model := State;
  case Message of
    when Msg.Quit:
      return new Mvu.Transition<Model, Msg>(State, [Mvu.Exit<Msg>()]);
    when Msg.SelectPage(const Page: Catalog.Entry):
      Next := State with
        Active := Page;
      end with;
    when Msg.Grid(const Event: Grids.Event):
      Next := State with
        Grid := GridSample.Update(State.Grid, Event);
      end with;
    when Msg.Preview:
    when Msg.MenuChoice(const Name: string):
      Next := State with
        MenuChoice := Name;
      end with;
    when Msg.SetSaving(const Value: bool):
      Next := State with
        Saving := Value;
      end with;
    when Msg.SetWeeklySummary(const Value: bool):
      Next := State with
        WeeklySummary := Value;
      end with;
    when Msg.SetTab(const Value: int):
      Next := State with
        ActiveTab := Value;
      end with;
    when Msg.SetSecurity(const Value: bool):
      Next := State with
        SecurityOpen := Value;
      end with;
    when Msg.SetPillTab(const Value: int):
      Next := State with
        ActivePillTab := Value;
      end with;
    when Msg.SetAbout(const Value: string):
      Next := State with
        About := Value;
      end with;
    when Msg.SetCountry(const Value: int):
      Next := State with
        Country := Value;
      end with;
    when Msg.SetPickerLanguage(const Value: int):
      Next := State with
        PickerLanguage := Value;
      end with;
    when Msg.SetSaveFrequency(const Value: int):
      Next := State with
        SaveFrequency := Value;
      end with;
    when Msg.SetMarketing(const Value: bool):
      Next := State with
        Marketing := Value;
      end with;
    when Msg.CreateWorkspace:
      Next := State with
        WorkspaceCreated := true;
      end with;
    when Msg.Focus(const Id: string):
      return new Mvu.Transition<Model, Msg>(State, [Mvu.Focus<Msg>(Id)]);
    when Msg.ProfileAction(const Action: Profile.Msg):
      Next := State with
        ProfileState := Profile.Update(State.ProfileState, Action);
      end with;
    when Msg.DesktopCommand(const Id: string):
      case Id of
        when 'encoding':
          Next := State with
            Encoding := 1 - State.Encoding;
          end with;
        when 'spaces':
          Next := State with
            Indent := (State.Indent + 1) mod 3;
          end with;
        when 'language':
          Next := State with
            Language := (State.Language + 1) mod 3;
          end with;
        else
      end case;
    when Msg.SelectPerson(const Id: string):
      Next := State with
        Person := Id;
      end with;
    when Msg.SortPeople(const Order: Tables.Sort):
      Next := State with
        PeopleOrder := Order;
      end with;
    when Msg.ToggleTheme:
      Next := State with
        Mode := if State.Mode = Themes.Mode.Dark then
          Themes.Mode.Light
        else
          Themes.Mode.Dark
        end if;
      end with;
  end case;

  return new Mvu.Transition<Model, Msg>(Next, []);
end function;

function Section(Title: string; Pages: array of Catalog.Entry): Nav.Section<Msg>;
begin
  return new Nav.Section<Msg>(
    Title, Sys.Array.ConvertAll<Catalog.Entry, Nav.Item<Msg>>(
      Pages,
      function(Page: Catalog.Entry): Nav.Item<Msg> => new Nav.Item<Msg>(
        Page.Title,
        Page.Title,
        Msg.SelectPage(Page)
      )
    )
  );
end function;

function Panel(Weight: float; Content: E.Element<Msg>): E.Element<Msg>;
begin
  return E.Size<Msg>(
    E.Styled<Msg>(E.Border<Msg>(Content), S.Role.Panel),
    new L.Flex(Basis := L.Extent.Fill, Grow := Weight)
  );
end function;

function Label(Value: string; Role: S.Role): E.Element<Msg>;
begin
  return E.Styled<Msg>(E.Text<Msg>(Value), Role);
end function;

function Selection(State: Model; Wide: bool): E.Element<Msg>;
begin
  const Flow: L.Flow := new L.Flow(Gap := L.Spacing.Normal);
  const Boxes: E.Element<Msg> := E.Column<Msg>(
    Flow, Label('Checkbox', S.Role.Heading),
    E.Column<Msg>(
      Flow, Checks.Rows<Msg>(
        State.ProfileState.Newsletter,
        State.Marketing,
        function(Value: bool): Msg => Msg.ProfileAction(Profile.Msg.SetNewsletter(Value)),
        Msg.SetMarketing,
        Msg.Preview
      )
    )
  );
  const Switches: E.Element<Msg> := E.Column<Msg>(
    Flow, Label('Switch', S.Role.Heading),
    Composition.Map<Profile.Msg, Msg>(Profile.Selection(State.ProfileState), Msg.ProfileAction)
  );
  const Half: L.Flex := new L.Flex(Basis := L.Extent.Fill, Grow := 1);
  const Toggles: E.Element<Msg> := if Wide then
    E.Row<Msg>(
      new L.Flow(Gap := L.Spacing.Normal, Align := L.Alignment.Start),
      E.Size<Msg>(Boxes, Half),
      E.Size<Msg>(Switches, Half)
    )
  else
    E.Column<Msg>(Flow, Boxes, Switches)
  end if;
  return E.Column<Msg>(
    Flow,
    Toggles,
    Label('Radio group', S.Role.Heading),
    Frequency.View<Msg>(State.SaveFrequency, Msg.SetSaveFrequency)
  );
end function;

function Detail(State: Model; Columns: int): E.Element<Msg>;
begin
  const Flow: L.Flow := new L.Flow(Gap := L.Spacing.Tight);
  var Example: E.Element<Msg> := E.Column<Msg>();
  case State.Active.Demo of
    when Catalog.Preview.Overview:
      Example := E.Column<Msg>(
        Flow,
        Label('Components for FPas', S.Role.Heading),
        E.Text<Msg>(
          'Forms, tables, charts, planning boards and chat pieces with native rendering on Windows and Linux.'
        ),
        B.Button<Msg>(
          'browse',
          'Browse components',
          Msg.SelectPage(Catalog.Components[1]),
          new B.Options(Variant := S.ButtonVariant.Primary, TerminalIconRight := '→')
        ),
        Label('Create a workspace', S.Role.Heading),
        E.Text<Msg>('You can invite people once it exists.'),
        Composition.Map<Profile.Msg, Msg>(
          Profile.Editors(State.ProfileState, 'workspace'),
          Msg.ProfileAction
        ),
        Checks.WeeklySummary<Msg>(State.WeeklySummary, Msg.SetWeeklySummary),
        B.Button<Msg>(
          'workspace-create',
          'Create workspace',
          Msg.CreateWorkspace,
          new B.Options(Variant := S.ButtonVariant.Primary)
        ),
        E.Text<Msg>(
          if State.WorkspaceCreated then
            'Workspace created'
          else
            ''
          end if
        )
      );
    when Catalog.Preview.DataDisplay:
      return E.Column<Msg>(
        new L.Flow(Gap := L.Spacing.Normal, Padding := L.Spacing.Normal),
        Label(State.Active.Title, S.Role.Heading), Label('Table', S.Role.Heading),
        People.View<Msg>(State.PeopleOrder, State.Person, Msg.SortPeople, Msg.SelectPerson)
      );
    when Catalog.Preview.Feedback:
      Example := E.Column<Msg>(
        Flow,
        Label('Progress', S.Role.Heading),
        Progress.Upload<Msg>(),
        Progress.ExportBar<Msg>(false)
      );
    when Catalog.Preview.Buttons:
      const Wide: bool := Columns >= 62;
      const Icons: array of E.Element<Msg> := Buttons.Icons<Msg>(Msg.Preview);
      Example := E.Column<Msg>(
        Flow,
        Label('Variants', S.Role.Heading),
        E.Text<Msg>('One primary action per view. Secondary for everything else.'),
        Buttons.Variants<Msg>(Msg.Preview, Wide),
        Label('Sizes and icons', S.Role.Heading),
        Buttons.Sizes<Msg>(Msg.Preview),
        E.Row<Msg>(new L.Flow(Gap := L.Spacing.Normal), Icons),
        Label('States', S.Role.Heading),
        E.Text<Msg>('Loading keeps the label so the layout does not jump.'),
        Buttons.States<Msg>(Msg.Preview, Wide, State.Saving, Msg.SetSaving),
        Label('Dropdown menu', S.Role.Heading),
        ProjectOptions.View<Msg>(
          Msg.MenuChoice,
          Msg.ProfileAction(Profile.Msg.Show(Profile.Layer.Delete))
        ),
        E.Text<Msg>(
          if State.MenuChoice = '' then
            ''
          else
            'Selected ' + State.MenuChoice
          end if
        )
      );
    when Catalog.Preview.Inputs:
      const Wide: bool := Columns >= 66;
      const Country: E.Element<Msg> := Pickers.Country<Msg>(State.Country, Msg.SetCountry);
      const Language: E.Element<Msg> := Pickers.Language<Msg>(
        State.PickerLanguage,
        Msg.SetPickerLanguage
      );
      const Half: L.Flex := new L.Flex(Basis := L.Extent.Fill, Grow := 1);
      const Choices: E.Element<Msg> := if Wide then
        E.Row<Msg>(
          new L.Flow(Gap := L.Spacing.Normal),
          E.Size<Msg>(Country, Half),
          E.Size<Msg>(Language, Half)
        )
      else
        E.Column<Msg>(Flow, Country, Language)
      end if;
      Example := E.Column<Msg>(
        Flow,
        Label('Text fields', S.Role.Heading),
        E.Text<Msg>('Labels above, hints and errors below.'),
        Composition.Map<Profile.Msg, Msg>(
          Profile.Editors(State.ProfileState, 'input', Wide),
          Msg.ProfileAction
        ),
        AboutSample.View<Msg>(State.About, Msg.SetAbout),
        Label('Pickers', S.Role.Heading),
        Choices
      );
    when Catalog.Preview.Selection:
      Example := Selection(State, Columns >= 66);
    when Catalog.Preview.Navigation:
      Example := E.Column<Msg>(
        Flow, Label('Tabs', S.Role.Heading),
        E.Column<Msg>(
          Flow,
          TabExamples.Rows<Msg>(State.ActiveTab, State.ActivePillTab, Msg.SetTab, Msg.SetPillTab)
        )
      );
    when Catalog.Preview.Overlays:
      Example := E.Column<Msg>(
        Flow, Label('Dialogs and sheets', S.Role.Heading),
        E.Text<Msg>('Esc or a click outside closes them. Focus stays inside.'),
        Composition.Map<Profile.Msg, Msg>(Profile.Openers(Columns >= 42), Msg.ProfileAction)
      );
    when Catalog.Preview.AppChrome:
      return E.Column<Msg>(
        new L.Flow(Padding := L.Spacing.Normal), Label('App chrome', S.Role.Heading),
        E.Size<Msg>(
          E.ScrollView<Msg>(
            'editor-code', E.Column<Msg>(
              Flow,
              E.Text<Msg>('Menu bar, toolbar, document tabs and status bar around an editor.'),
              E.Text<Msg>(Sys.String.Join(#10, Status.CodeLines))
            )
          ), new L.Flex(Basis := L.Extent.Fill, Grow := 1)
        ),
        Status.View<Msg>(State.Indent, State.Encoding, State.Language, Msg.DesktopCommand, Columns)
      );
    when Catalog.Preview.Disclosure:
      Example := E.Column<Msg>(
        Flow, Label('Expandable cards', S.Role.Heading),
        Security.View<Msg>(State.SecurityOpen, Msg.SetSecurity)
      );
    when Catalog.Preview.CellGrid:
      return Composition.Map<Grids.Event, Msg>(GridSample.View(State.Grid), Msg.Grid);
    when Catalog.Preview.Text:
      Example := E.Column<Msg>(
        Flow,
        Label('Text and inline code', S.Role.Heading),
        Label('Components for FPas', S.Role.Heading),
        E.Text<Msg>('Components are functions.'),
        E.Text<Msg>('Label'),
        Label('Secondary text', S.Role.Secondary),
        Label('Muted text', S.Role.Muted),
        E.Text<Msg>('Run the gallery with  fpas run')
      );
    else
      Example := E.Text<Msg>(State.Active.Description);
  end case;

  const PageFlow: L.Flow := new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Normal);
  const Content: E.Element<Msg> := if State.Active.Demo = Catalog.Preview.Overview then
    E.Column<Msg>(PageFlow, Example)
  else
    E.Column<Msg>(PageFlow, Label(State.Active.Title, S.Role.Heading), Example)
  end if;
  return E.ScrollView<Msg>('preview-' + State.Active.Title, Content);
end function;

function View(State: Model): E.Element<Msg>;
begin
  const List: E.Element<Msg> := Nav.Sidebar<Msg>(
    'navigation',
    [
      Section('Components', Catalog.Components),
      Section('Extended', Catalog.Extended),
      Section('Terminal', Catalog.Terminal)
    ],
    State.Active.Title
  );
  const FirstControl: string := case State.Active.Demo of
    when Catalog.Preview.Overview: 'browse';
    when Catalog.Preview.Buttons: 'primary';
    when Catalog.Preview.Inputs: 'input-name';
    when Catalog.Preview.Selection: 'newsletter';
    when Catalog.Preview.Navigation: Tabs.ItemId(TabExamples.UnderlineId, State.ActiveTab);
    when Catalog.Preview.Overlays: 'edit-profile-open';
    when Catalog.Preview.DataDisplay: State.Person;
    when Catalog.Preview.Disclosure: 'security';
    when Catalog.Preview.AppChrome: 'desktop-status/encoding';
    else '';
  end case;
  const SidebarFocus: Msg := Msg.Focus(Nav.ItemId('navigation', State.Active.Title));
  const Screen: E.Element<Msg> := Views.Screen<Msg>(
    E.Row<Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1)), Align := L.Alignment.Stretch),
      Panel(1.0F, E.ScrollView<Msg>('navigation-scroll', List)), Panel(
        2.0F, Views.Viewport<Msg>(
          'gallery-preview',
          function(Size: Term.Viewport): E.Element<Msg> => Detail(
            State,
            Size.Columns - (Size.Columns - 1) div 3 - 5
          )
        )
      )
    ),
    [],
    [
      Keys.Shortcut<Msg>(Keys.Key.Left, Keys.KeyModifiers.None, SidebarFocus),
      Keys.Shortcut<Msg>(
        Keys.Key.Right, Keys.KeyModifiers.None, if FirstControl = '' then
          Msg.Preview
        else
          Msg.Focus(FirstControl)
        end if
      ),
      Keys.Shortcut<Msg>(Keys.Key.Escape, Keys.KeyModifiers.None, SidebarFocus),
      Keys.Shortcut<Msg>(Keys.Key.T, Keys.KeyModifiers.Ctrl, Msg.ToggleTheme),
      Keys.Shortcut<Msg>(Keys.Key.Q, Keys.KeyModifiers.Ctrl, Msg.Quit)
    ]
  );
  return Profile.Present<Msg>(Screen, State.ProfileState, Msg.ProfileAction);
end function;

begin
  const Initial: Model := new Model(Catalog.Components[0]);
  const Arguments: array of string := Sys.Environment.GetCommandLineArgs();
  if Sys.Array.IndexOf<string>(Arguments, '--headless-control') >= 0 then
    if Sys.String.IsNullOrEmpty(
      Sys.Environment.GetEnvironmentVariable('FPAS_TUI_CONTROL_PIPE')
    )
    then
      raise new Sys.InvalidOperationException('Set FPAS_TUI_CONTROL_PIPE for headless control.');
    end if;

    using const Session: App.HeadlessSession := App.StartHeadless<Model, Msg>(
      Initial, Update, View, 80, 24, ThemeFor
    );
    while Session.IsOpen() do
      Threads.Thread.Sleep(20);
    end while;
  else
    App.Run<Model, Msg>(Initial, Update, View, ThemeFor);
  end if;
end;

end program;
