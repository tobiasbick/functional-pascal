program TuiWidgetGallery;

uses
  Fpas.Ui.Tui.Application as App, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Theming.Themes as Themes,
  TuiGallery.CellGridSample as GridSample, Fpas.Ui.TerminalExtensions.CellGrids as Grids, Fpas.Ui.Composition as Composition,
  Fpas.Ui.TerminalExtensions.Input as Keys, Fpas.Ui.TerminalExtensions.Views as Views,
  Fpas.Ui.Widgets.Desktop.StatusBars as Status,
  TuiGallery.QueueSample as Queue, TuiGallery.Catalog as Catalog, Fpas.Ui.Widgets.Navigation.Navigation as Nav,
  Fpas.Ui.Widgets.Feedback.ProgressBars as Bars, System as Sys, System.Threading as Threads;

type Msg = variant
  SelectPage(Page: Catalog.Entry);
  ChangeProgress(Delta: int);
  Grid(Event: Grids.Event);
  QueueAction(Action: Queue.Msg);
  Focus(Id: string);
  ToggleEncoding;
  ToggleTheme;
  Quit;
end variant;

type Model = record
  public Active: Catalog.Entry;
  public Mode: Themes.Mode := Themes.Mode.Dark;
  public Percent: int := 60;
  public Upload: int := 68;
  public QueueState: Queue.State := new Queue.State();
  public Utf8: bool := true;
  public Grid: GridSample.State := new GridSample.State();
end record;

function ThemeFor(State: Model): Themes.Theme;
begin
  const Base: Themes.Theme := if State.Mode = Themes.Mode.Dark then
    Themes.Dark(Themes.Accent.Blue)
  else
    Themes.Light(Themes.Accent.Blue)
  end if;
  return Base with
    Colors := Base.Colors with
      Border := Base.Colors.Info;
    end with;
  end with;
end function;

function Update(State: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  var Next: Model := State;
  case Message of
    when Msg.Quit:
      return new Mvu.Transition<Model, Msg>(State, [Mvu.Exit<Msg>()]);
    when Msg.SelectPage(const Page: Catalog.Entry):
      Next := State with
        Active := Page;
      end with;
    when Msg.Grid(const Event: Grids.Event):
      Next := State with
        Grid := GridSample.Update(State.Grid, Event);
      end with;
    when Msg.ChangeProgress(const Delta: int):
      if State.Active.Demo = Catalog.Preview.Feedback then
        Next := State with
          Upload := Sys.Math.Clamp(State.Upload + Delta, 0, 100);
        end with;
      elsif State.Active.Demo = Catalog.Preview.Progress or State.Active.Demo =
        Catalog.Preview.Overview
      then
        Next := State with
          Percent := Sys.Math.Clamp(State.Percent + Delta, 0, 100);
        end with;
      end if;
    when Msg.Focus(const Id: string):
      return new Mvu.Transition<Model, Msg>(State, [Mvu.Focus<Msg>(Id)]);
    when Msg.QueueAction(const Action: Queue.Msg):
      Next := State with
        QueueState := Queue.Update(State.QueueState, Action);
      end with;
      case Action of
        when Queue.Msg.Add:
          if Next.QueueState.Tracks.Length = Queue.Capacity then
            return new Mvu.Transition<Model, Msg>(Next, [Mvu.Focus<Msg>('queue-remove')]);
          end if;

          return new Mvu.Transition<Model, Msg>(Next, [Mvu.Focus<Msg>('queue-title')]);
        when Queue.Msg.Remove:
          if Next.QueueState.Tracks.Length = 0 then
            return new Mvu.Transition<Model, Msg>(Next, [Mvu.Focus<Msg>('queue-title')]);
          end if;
        when Queue.Msg.Clear:
          return new Mvu.Transition<Model, Msg>(Next, [Mvu.Focus<Msg>('queue-show')]);
        else
      end case;
    when Msg.ToggleEncoding:
      Next := State with
        Utf8 := not State.Utf8;
      end with;
    when Msg.ToggleTheme:
      Next := State with
        Mode := if State.Mode = Themes.Mode.Dark then
          Themes.Mode.Light
        else
          Themes.Mode.Dark
        end if;
      end with;
  end case;

  return new Mvu.Transition<Model, Msg>(Next, []);
end function;

function Section(Title: string; Pages: array of Catalog.Entry): Nav.Section<Msg>;
begin
  return new Nav.Section<Msg>(
    Title, Sys.Array.ConvertAll<Catalog.Entry, Nav.Item<Msg>>(
      Pages,
      function(Page: Catalog.Entry): Nav.Item<Msg> => new Nav.Item<Msg>(
        Page.Title,
        Page.Title,
        Msg.SelectPage(Page)
      )
    )
  );
end function;

function Panel(Weight: float; Content: E.Element<Msg>): E.Element<Msg>;
begin
  return E.Size<Msg>(
    E.Styled<Msg>(E.Border<Msg>(Content), S.Role.Panel),
    new L.Flex(Basis := L.Extent.Fill, Grow := Weight)
  );
end function;

function Label(Value: string; Role: S.Role): E.Element<Msg>;
begin
  return E.Styled<Msg>(E.Text<Msg>(Value), Role);
end function;

function Detail(State: Model): E.Element<Msg>;
begin
  const Flow: L.Flow := new L.Flow(Gap := L.Spacing.Tight);
  var Example: E.Element<Msg> := E.Column<Msg>();
  case State.Active.Demo of
    when Catalog.Preview.Progress, Catalog.Preview.Overview:
      Example := E.Column<Msg>(
        Flow,
        Bars.ProgressBar<Msg>(
          'sample-progress', cast<float>(State.Percent) / 100.0F,
          new Bars.Options(Label := 'Loading tracks', ShowValue := true, Tone := S.Tone.Info)
        ),
        Label('←/→  Adjust by 10%', S.Role.Muted)
      );
    when Catalog.Preview.Feedback:
      Example := E.Column<Msg>(
        Flow,
        Bars.ProgressBar<Msg>(
          'upload', cast<float>(State.Upload) / 100.0F,
          new Bars.Options(Label := 'Uploading assets', ShowValue := true, Tone := S.Tone.Info)
        ),
        Bars.ProgressBar<Msg>(
          'export', 0.42F,
          new Bars.Options(Label := 'Exporting clip.mp4', ShowValue := true, Tone := S.Tone.Success)
        ),
        Label('←/→  Adjust upload by 10%', S.Role.Muted)
      );
    when Catalog.Preview.Buttons:
      Example := Composition.Map<Queue.Msg, Msg>(Queue.Buttons(State.QueueState), Msg.QueueAction);
    when Catalog.Preview.Overlays:
      Example := Composition.Map<Queue.Msg, Msg>(Queue.Openers(State.QueueState), Msg.QueueAction);
    when Catalog.Preview.AppChrome:
      return E.Column<Msg>(
        new L.Flow(Padding := L.Spacing.Normal),
        Label('App chrome', S.Role.Heading),
        E.Size<Msg>(
          E.Column<Msg>(
            Flow, E.Text<Msg>('Status bar'),
            Label('Select the encoding to change it.', S.Role.Muted)
          ),
          new L.Flex(Basis := L.Extent.Fill, Grow := 1)
        ),
        Status.StatusBar<Msg>(
          'editor-status', [
            Status.Item<Msg>.Text(new Status.Label('main')),
            Status.Item<Msg>.Text(new Status.Label('Saved')),
            Status.Item<Msg>.Progress(0.62F, 'Indexing 62%', 0.0F, false),
            Status.Item<Msg>.Spacer,
            Status.Item<Msg>.Text(new Status.Label('Ln 48, Col 17')),
            Status.Item<Msg>.Action(
              'encoding', new Status.Label(
                if State.Utf8 then
                  'UTF-8'
                else
                  'UTF-16'
                end if
              ),
              'Change encoding', true, Msg.ToggleEncoding
            )
          ]
        )
      );
    when Catalog.Preview.CellGrid:
      return Composition.Map<Grids.Event, Msg>(GridSample.View(State.Grid), Msg.Grid);
    when Catalog.Preview.Text:
      Example := E.Column<Msg>(
        Flow, Label('Field recording', S.Role.Heading),
        E.Text<Msg>(
          'Rain drums softly on the roof. Footsteps cross the room, then fade into the distance.'
        ),
        Label('Recorded at dusk · Stereo', S.Role.Muted)
      );
    else
  end case;

  return E.ScrollView<Msg>(
    'preview-scroll', E.Column<Msg>(
      new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Normal),
      Label(State.Active.Title, S.Role.Heading), E.Text<Msg>(State.Active.Description), Example
    )
  );
end function;

function View(State: Model): E.Element<Msg>;
begin
  const List: E.Element<Msg> := Nav.Sidebar<Msg>(
    'navigation',
    [Section('Components', Catalog.Components), Section('Extended', Catalog.Extended)],
    State.Active.Title
  );
  const Editing: bool := State.Active.Demo = Catalog.Preview.Buttons or State.Active.Demo =
    Catalog.Preview.Overlays;
  const FirstButton: string := if State.Active.Demo = Catalog.Preview.Overlays then
    'queue-show'
  else
    'queue-title'
  end if;
  const SidebarFocus: Msg := Msg.Focus(Nav.ItemId('navigation', State.Active.Title));
  const Screen: E.Element<Msg> := Views.Screen<Msg>(
    E.Row<Msg>(
      new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1)), Align := L.Alignment.Stretch),
      Panel(1.0F, E.ScrollView<Msg>('navigation-scroll', List)), Panel(2.0F, Detail(State))
    ),
    [],
    [
      Keys.Shortcut<Msg>(
        Keys.Key.Left, Keys.KeyModifiers.None, if Editing then
          SidebarFocus
        else
          Msg.ChangeProgress(-10)
        end if
      ),
      Keys.Shortcut<Msg>(
        Keys.Key.Right, Keys.KeyModifiers.None, if Editing then
          Msg.Focus(FirstButton)
        else
          Msg.ChangeProgress(10)
        end if
      ),
      Keys.Shortcut<Msg>(Keys.Key.Escape, Keys.KeyModifiers.None, SidebarFocus),
      Keys.Shortcut<Msg>(Keys.Key.T, Keys.KeyModifiers.Ctrl, Msg.ToggleTheme),
      Keys.Shortcut<Msg>(Keys.Key.Q, Keys.KeyModifiers.Ctrl, Msg.Quit)
    ]
  );
  return Queue.Present<Msg>(Screen, State.QueueState, Msg.QueueAction);
end function;

begin
  const Initial: Model := new Model(Catalog.Components[0]);
  const Arguments: array of string := Sys.Environment.GetCommandLineArgs();
  if Sys.Array.IndexOf<string>(Arguments, '--headless-control') >= 0 then
    if Sys.String.IsNullOrEmpty(
      Sys.Environment.GetEnvironmentVariable('FPAS_TUI_CONTROL_PIPE')
    )
    then
      raise new Sys.InvalidOperationException('Set FPAS_TUI_CONTROL_PIPE for headless control.');
    end if;

    using const Session: App.HeadlessSession := App.StartHeadless<Model, Msg>(
      Initial, Update, View, 80, 24, ThemeFor
    );
    while Session.IsOpen() do
      Threads.Thread.Sleep(20);
    end while;
  else
    App.Run<Model, Msg>(Initial, Update, View, ThemeFor);
  end if;
end;

end program;
