// [Documentation](README.md)

program TuiWidgetGallery;

uses
  TuiGallery.PlotSamples as PlotSamples,
  TuiGallery.ChoiceSamples as ChoiceSamples,
  TuiGallery.InputSamples as InputSamples, TuiGallery.AlertSamples as AlertSamples,
  Gallery.Shared.PeopleFilters as FilterSample,
  Gallery.Shared.PaginationExample as Pagination,
  Gallery.Shared.BreadcrumbExample as Breadcrumb,
  Gallery.Shared.LanguagesExample as LanguageSample,
  TuiGallery.State as GalleryState, TuiGallery.State.Model as Model, TuiGallery.State.Msg as Msg,
  Gallery.Shared.Strings as Strings,
  Gallery.Shared.SecurityCard as Security,
  Gallery.Shared.ProjectOptions as ProjectOptions,
  Gallery.Shared.AboutField as AboutSample,
  TuiGallery.ListSample as ListSample,
  TuiGallery.FilePickerSample as Files,
  TuiGallery.ToolSamples as Tools, Fpas.Ui.Widgets.Overlays.CommandPalettes as Palettes,
  Fpas.Ui.Tui.Application as App, Fpas.Ui.Tui.Headless as Headless, Fpas.Ui.Tui.Host as Host, Fpas.Ui.Elements as E,
  TuiGallery.PeopleSample as People, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Theming.Themes as Themes,
  Fpas.Ui.Composition as Composition,
  Fpas.Ui.TerminalExtensions.Input as Keys, Fpas.Ui.TerminalExtensions.Views as Views,
  Gallery.Shared.PickerChoices as Pickers, Gallery.Shared.SaveFrequency as Frequency, Gallery.Shared.CheckboxExamples as Checks, Gallery.Shared.EditorStatus as Status, Gallery.Shared.ButtonExamples as Buttons, Gallery.Shared.ProgressExample as Progress,
  Fpas.Ui.Widgets.Actions.Buttons as B, Fpas.Ui.Widgets.Developer.Terminal as Term,
  TuiGallery.ProfileSample as Profile, TuiGallery.Catalog as Catalog, Fpas.Ui.Widgets.Navigation.Navigation as Nav,
  Gallery.Shared.TabExamples as TabExamples, Fpas.Ui.Widgets.Navigation.Tabs as Tabs, System as Sys, System.Threading as Threads;

function ThemeFor(State: Model): Themes.Theme;
begin
  const Base: Themes.Theme := if State.Mode = Themes.Mode.Dark then
    Themes.Dark(Themes.Accent.Blue)
  else
    Themes.Light(Themes.Accent.Blue)
  end if;
  return Base with
    Colors := Base.Colors with
      Border := Base.Colors.Info;
    end with;
  end with;
end function;

function Section(Title: string; Pages: array of Catalog.Entry): Nav.Section<Msg>;
begin
  return new Nav.Section<Msg>(
    Title, Sys.Array.ConvertAll<Catalog.Entry, Nav.Item<Msg>>(
      Pages,
      function(Page: Catalog.Entry): Nav.Item<Msg> => new Nav.Item<Msg>(
        Page.Id,
        Page.Title,
        Msg.SelectPage(Page)
      )
    )
  );
end function;

function Panel(Size: L.Flex; Content: E.Element<Msg>): E.Element<Msg>;
begin
  return E.Size<Msg>(
    E.Styled<Msg>(E.Border<Msg>(Content), S.Role.Panel),
    Size
  );
end function;

function Label(Value: string; Role: S.Role): E.Element<Msg>;
begin
  return E.Styled<Msg>(E.Text<Msg>(Value), Role);
end function;

function Selection(State: Model; Wide: bool): E.Element<Msg>;
begin
  const Flow: L.Flow := new L.Flow(Gap := L.Spacing.Normal);
  const Boxes: E.Element<Msg> := E.Column<Msg>(
    Flow, Label(Strings.Get('Text.Checkbox'), S.Role.Heading),
    E.Column<Msg>(
      Flow, Checks.Rows<Msg>(
        State.ProfileState.Newsletter,
        State.Marketing,
        function(Value: bool): Msg => Msg.ProfileAction(Profile.Msg.SetNewsletter(Value)),
        Msg.SetMarketing,
        Msg.Preview
      )
    )
  );
  const Switches: E.Element<Msg> := E.Column<Msg>(
    Flow, Label(Strings.Get('Text.Switch'), S.Role.Heading),
    Composition.Map<Profile.Msg, Msg>(Profile.Selection(State.ProfileState), Msg.ProfileAction)
  );
  const Half: L.Flex := new L.Flex(Basis := L.Extent.Fill, Grow := 1);
  const Toggles: E.Element<Msg> := if Wide then
    E.Row<Msg>(
      new L.Flow(Gap := L.Spacing.Normal, Align := L.Alignment.Start),
      E.Size<Msg>(Boxes, Half),
      E.Size<Msg>(Switches, Half)
    )
  else
    E.Column<Msg>(Flow, Boxes, Switches)
  end if;
  return E.Column<Msg>(
    Flow,
    Toggles,
    Label(Strings.Get('Text.RadioGroup'), S.Role.Heading),
    Frequency.View<Msg>(State.SaveFrequency, Msg.SetSaveFrequency)
  );
end function;

function Detail(State: Model; Columns: int; Rows: int): E.Element<Msg>;
begin
  const Flow: L.Flow := new L.Flow(Gap := L.Spacing.Tight);
  var Example: E.Element<Msg> := E.Column<Msg>();
  case State.Active.Demo of
    when Catalog.Preview.Overview:
      Example := E.Column<Msg>(
        Flow,
        Label(Strings.Get('Text.ComponentsForFpas'), S.Role.Heading),
        E.Text<Msg>(
          Strings.Get('Text.GalleryIntro')
        ),
        B.Button<Msg>(
          'browse',
          Strings.Get('Text.BrowseComponents'),
          Msg.SelectPage(Catalog.Components[1]),
          new B.Options(Variant := S.ButtonVariant.Primary, TerminalIconRight := '→')
        ),
        Label(Strings.Get('Text.CreateWorkspaceHeading'), S.Role.Heading),
        Composition.Map<Profile.Msg, Msg>(
          Profile.Editors(State.ProfileState, 'workspace'),
          Msg.ProfileAction
        ),
        Checks.WeeklySummary<Msg>(State.WeeklySummary, Msg.SetWeeklySummary),
        E.Row<Msg>(
          Flow,
          B.Button<Msg>(
            'workspace-create', Strings.Get('Text.CreateWorkspace'), Msg.CreateWorkspace,
            new B.Options(Variant := S.ButtonVariant.Primary)
          ),
          if State.WorkspaceCreated then
            E.Text<Msg>(Strings.Get('Text.WorkspaceCreated'))
          else
            E.Column<Msg>()
          end if
        )
      );
    when Catalog.Preview.DataDisplay:
      Example := E.Column<Msg>(
        Flow,
        Label(Strings.Get('Text.Table'), S.Role.Heading),
        People.View<Msg>(
          State.PeopleOrder,
          State.Person,
          Msg.SortPeople,
          Msg.SelectPerson,
          Sys.Math.Clamp(Rows - 7, 2, 6)
        ),
        Label(Strings.Get('Heading.List'), S.Role.Heading),
        Composition.Map<ListSample.Msg, Msg>(
          ListSample.View(State.ListState),
          Msg.ListAction
        ),
        Label(Strings.Get('Heading.TreeView'), S.Role.Heading),
        Composition.Map<Tools.Msg, Msg>(Tools.Tree(State.ToolState), Msg.ToolAction)
      );
    when Catalog.Preview.Code:
      Example := E.Column<Msg>(
        Flow, Label(Strings.Get('Heading.LogConsole'), S.Role.Heading),
        Composition.Map<Tools.Msg, Msg>(Tools.Build(State.ToolState), Msg.ToolAction)
      );
    when Catalog.Preview.DataGrid:
      Example := E.Column<Msg>(
        Flow, E.Text<Msg>(Strings.Get('Tui.Filter.Keys')),
        FilterSample.View<Msg>(State.Filter, Msg.SetFilter)
      );
    when Catalog.Preview.Feedback:
      Example := E.Column<Msg>(
        Flow,
        Label(Strings.Get('Text.Progress'), S.Role.Heading),
        Progress.Upload<Msg>(),
        Progress.ExportBar<Msg>(false),
        PlotSamples.Activity<Msg>(),
        AlertSamples.View<Msg>()
      );
    when Catalog.Preview.Charts:
      Example := PlotSamples.Sparkline<Msg>();
    when Catalog.Preview.Buttons:
      const Wide: bool := Columns >= 62;
      const Icons: array of E.Element<Msg> := Buttons.Icons<Msg>(Msg.Preview);
      Example := E.Column<Msg>(
        Flow,
        Label(Strings.Get('Text.Variants'), S.Role.Heading),
        E.Text<Msg>(Strings.Get('Text.VariantsHint')),
        Buttons.Variants<Msg>(Msg.Preview, Wide),
        Label(Strings.Get('Text.SizesAndIcons'), S.Role.Heading),
        Buttons.Sizes<Msg>(Msg.Preview),
        E.Row<Msg>(new L.Flow(Gap := L.Spacing.Normal), Icons),
        Label(Strings.Get('Text.States'), S.Role.Heading),
        E.Text<Msg>(Strings.Get('Text.LoadingLabelHint')),
        Buttons.States<Msg>(Msg.Preview, Wide, State.Saving, Msg.SetSaving),
        Label(Strings.Get('Text.DropdownMenu'), S.Role.Heading),
        E.Row<Msg>(
          Flow,
          ProjectOptions.View<Msg>(
            Msg.MenuChoice,
            Msg.ProfileAction(Profile.Msg.Show(Profile.Layer.Delete))
          ),
          if State.MenuChoice <> '' then
            E.Text<Msg>(Strings.Get('Text.SelectedPrefix') + State.MenuChoice)
          else
            E.Column<Msg>()
          end if
        ),
        Composition.Map<ChoiceSamples.Msg, Msg>(
          ChoiceSamples.Segments(State.ChoiceState),
          Msg.SetChoice
        )
      );
    when Catalog.Preview.Inputs:
      const Wide: bool := Columns >= 66;
      const Country: E.Element<Msg> := Pickers.Country<Msg>(State.Country, Msg.SetCountry);
      const Language: E.Element<Msg> := Pickers.Language<Msg>(
        State.PickerLanguage,
        Msg.SetPickerLanguage
      );
      const Half: L.Flex := new L.Flex(Basis := L.Extent.Fill, Grow := 1);
      const Choices: E.Element<Msg> := if Wide then
        E.Row<Msg>(
          new L.Flow(Gap := L.Spacing.Normal),
          E.Size<Msg>(Country, Half),
          E.Size<Msg>(Language, Half)
        )
      else
        E.Column<Msg>(Flow, Country, Language)
      end if;
      Example := E.Column<Msg>(
        Flow,
        Label(Strings.Get('Text.TextFields'), S.Role.Heading),
        E.Text<Msg>(Strings.Get('Text.FieldHints')),
        Composition.Map<Profile.Msg, Msg>(
          Profile.Editors(State.ProfileState, 'input', Wide),
          Msg.ProfileAction
        ),
        AboutSample.View<Msg>(State.About, Msg.SetAbout),
        InputSamples.Projects<Msg>(State.SearchQuery, Msg.SetSearchQuery),
        Label(Strings.Get('Page.Pickers'), S.Role.Heading),
        Choices,
        InputSamples.Seats<Msg>(State.Seats, Msg.SetSeats)
      );
    when Catalog.Preview.Pickers:
      Example := E.Column<Msg>(
        Flow, Label(Strings.Get('Heading.MultiSelect'), S.Role.Heading),
        LanguageSample.View<Msg>(State.Languages, Msg.SetLanguages)
      );
    when Catalog.Preview.Selection:
      Example := Selection(State, Columns >= 66);
    when Catalog.Preview.Navigation:
      Example := E.Column<Msg>(
        Flow, Label(Strings.Get('Text.Tabs'), S.Role.Heading),
        E.Column<Msg>(
          Flow,
          TabExamples.Rows<Msg>(State.ActiveTab, State.ActivePillTab, Msg.SetTab, Msg.SetPillTab)
        ),
        Label(Strings.Get('Heading.BreadcrumbAndPagination'), S.Role.Heading),
        Breadcrumb.View<Msg>(Msg.SelectAncestor),
        if State.Ancestor <> '' then
          E.Text<Msg>(Strings.Get('Text.SelectedPrefix') + State.Ancestor)
        else
          E.Column<Msg>()
        end if,
        E.Row<Msg>(
          E.Size<Msg>(
            Pagination.View<Msg>(State.PageIndex, Msg.SetPageIndex),
            new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(22)))
          )
        )
      );
    when Catalog.Preview.Overlays:
      const OpenPalette: E.Element<Msg> := B.Button<Msg>(
        'open-palette',
        Strings.Get('Text.OpenCommandPalette'),
        Msg.ToolAction(Tools.Msg.Palette(true))
      );
      Example := E.Column<Msg>(
        Flow, Label(Strings.Get('Text.DialogsAndSheets'), S.Role.Heading),
        E.Text<Msg>(Strings.Get('Text.OverlayHint')),
        Composition.Map<Profile.Msg, Msg>(Profile.Openers(Columns >= 42), Msg.ProfileAction),
        Label(Strings.Get('Text.CommandPalette'), S.Role.Heading), OpenPalette
      );
    when Catalog.Preview.AppChrome:
      Example := E.Column<Msg>(
        Flow,
        E.Text<Msg>(Sys.String.Join(#10, Status.CodeLines)),
        Tools.EditorStatus<Msg>(State.Indent, State.Encoding, State.Language, Msg.DesktopCommand)
      );
    when Catalog.Preview.Disclosure:
      Example := E.Column<Msg>(
        Flow, Label(Strings.Get('Text.ExpandableCards'), S.Role.Heading),
        Security.View<Msg>(State.SecurityOpen, Msg.SetSecurity)
      );
    when Catalog.Preview.Files:
      Example := Composition.Map<Files.Msg, Msg>(Files.Controls(State.FileState), Msg.FilesAction);
    when Catalog.Preview.Text:
      Example := E.Column<Msg>(
        Flow,
        Label(Strings.Get('Text.TextAndInlineCode'), S.Role.Heading),
        Label(Strings.Get('Text.ComponentsForFpas'), S.Role.Heading),
        E.Text<Msg>(Strings.Get('Text.ComponentsAreFunctions')),
        E.Text<Msg>(Strings.Get('Text.Label')),
        Label(Strings.Get('Text.SecondaryText'), S.Role.Secondary),
        Label(Strings.Get('Text.MutedText'), S.Role.Muted),
        E.Text<Msg>(Strings.Get('Text.RunGallery'))
      );
    else
      raise new Sys.InvalidOperationException('Unknown terminal gallery preview.');
  end case;

  const PageFlow: L.Flow := new L.Flow(Padding := L.Spacing.Normal, Gap := L.Spacing.Normal);
  const Content: E.Element<Msg> := if State.Active.Demo = Catalog.Preview.Overview then
    E.Column<Msg>(PageFlow, Example)
  else
    E.Column<Msg>(PageFlow, Label(State.Active.Title, S.Role.Heading), Example)
  end if;
  return E.ScrollView<Msg>(
    'preview-' + State.Active.Id, Content, State.PreviewPosition,
    function(Change: L.ScrollChange): Msg => Msg.ScrollPreview(Change.Position)
  );
end function;

function SidebarColumns(Total: int): int;
begin
  return Sys.Math.Clamp((Total - 1) div 4, 1, 24);
end function;

function View(State: Model): E.Element<Msg>;
begin
  const List: E.Element<Msg> := Nav.Sidebar<Msg>(
    'navigation',
    [
      Section(Strings.Get('Text.SectionComponents'), Catalog.Components),
      Section(Strings.Get('Text.SectionExtended'), Catalog.Extended)
    ],
    State.Active.Id
  );
  const FirstControl: string := case State.Active.Demo of
    when Catalog.Preview.Overview: 'browse';
    when Catalog.Preview.Buttons: 'primary';
    when Catalog.Preview.Inputs: 'input-name';
    when Catalog.Preview.Feedback: 'storage/dismiss';
    when Catalog.Preview.Selection: 'newsletter';
    when Catalog.Preview.Pickers: 'picker-languages';
    when Catalog.Preview.Navigation: Tabs.ItemId(TabExamples.UnderlineId, State.ActiveTab);
    when Catalog.Preview.Overlays: 'edit-profile-open';
    when Catalog.Preview.DataDisplay: State.Person;
    when Catalog.Preview.DataGrid: 'filters/search';
    when Catalog.Preview.Code: 'log-console';
    when Catalog.Preview.Files: 'files-open';
    when Catalog.Preview.Disclosure: 'security';
    when Catalog.Preview.AppChrome: 'desktop-status/encoding';
    else '';
  end case;
  const SidebarFocus: Msg := Msg.Focus(Nav.ItemId('navigation', State.Active.Id));
  const Screen: E.Element<Msg> := Views.Screen<Msg>(
    Views.Viewport<Msg>(
      'gallery-viewport',
      function(Size: Term.Viewport): E.Element<Msg> => E.Row<Msg>(
        new L.Flow(Gap := L.Spacing.Fixed(L.Measure.Cells(1)), Align := L.Alignment.Stretch),
        Panel(
          new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(SidebarColumns(Size.Columns)))),
          E.Column<Msg>(
            E.Size<Msg>(
              E.ScrollView<Msg>('navigation-scroll', List),
              new L.Flex(Basis := L.Extent.Fill, Grow := 1)
            ),
            Label(Strings.Get('Tui.Preview.Keys'), S.Role.Secondary)
          )
        ),
        Panel(
          new L.Flex(Basis := L.Extent.Fill, Grow := 1),
          Detail(State, Size.Columns - SidebarColumns(Size.Columns) - 6, Size.Rows)
        )
      )
    ),
    [],
    [
      Keys.Shortcut<Msg>(Keys.Key.Left, Keys.KeyModifiers.None, SidebarFocus),
      Keys.Shortcut<Msg>(
        Keys.Key.Right, Keys.KeyModifiers.None, if FirstControl = '' then
          Msg.Preview
        else
          Msg.Focus(FirstControl)
        end if
      ),
      Keys.Shortcut<Msg>(
        Keys.Key.F6,
        Keys.KeyModifiers.None,
        Msg.Focus('preview-' + State.Active.Id)
      ),
      Keys.Shortcut<Msg>(Keys.Key.Escape, Keys.KeyModifiers.None, SidebarFocus),
      Keys.Shortcut<Msg>(Keys.Key.T, Keys.KeyModifiers.Ctrl, Msg.ToggleTheme),
      Keys.Shortcut<Msg>(Keys.Key.Q, Keys.KeyModifiers.Ctrl, Msg.Quit)
    ]
  );
  const Commands: array of Palettes.Command<Msg> := [
    new Palettes.Command<Msg>(
      Strings.Get('Palette.Overview'),
      Msg.SelectPage(Catalog.Components[0])
    ),
    new Palettes.Command<Msg>(
      Strings.Get('Palette.Buttons'),
      Msg.SelectPage(Catalog.Components[1])
    ),
    new Palettes.Command<Msg>(Strings.Get('Palette.Inputs'), Msg.SelectPage(Catalog.Components[2])),
    new Palettes.Command<Msg>(Strings.Get('Palette.Charts'), Msg.SelectPage(Catalog.Components[8])),
    new Palettes.Command<Msg>(
      Strings.Get('Palette.ToggleDark'),
      Msg.ToggleTheme,
      Shortcut := 'Ctrl+T'
    )
  ];
  const Base: E.Element<Msg> := Palettes.CommandPalette<Msg>(
    'gallery-palette',
    Profile.Present<Msg>(Screen, State.ProfileState, Msg.ProfileAction),
    State.ToolState.Palette,
    Commands,
    function(Open: bool): Msg => Msg.ToolAction(Tools.Msg.Palette(Open))
  );
  return if State.Active.Demo = Catalog.Preview.Files then
    Files.Present<Msg>(Base, State.FileState, Msg.FilesAction)
  else
    Base
  end if;
end function;

begin
  const Initial: Model := new Model(Catalog.Components[0]);
  const Arguments: array of string := Sys.Environment.GetCommandLineArgs();
  if Sys.Array.IndexOf<string>(Arguments, '--headless-control') >= 0 then
    if Sys.String.IsNullOrEmpty(
      Sys.Environment.GetEnvironmentVariable('FPAS_TUI_CONTROL_PIPE')
    )
    then
      raise new Sys.InvalidOperationException('Set FPAS_TUI_CONTROL_PIPE for headless control.');
    end if;

    using const Session: App.HeadlessSession := Headless.Start<Model, Msg>(
      Initial, GalleryState.Update, View, 80, 25, ThemeFor
    );
    while Session.IsOpen() do
      Threads.Thread.Sleep(20);
    end while;
  else
    Host.Run<Model, Msg>(Initial, GalleryState.Update, View, ThemeFor);
  end if;
end;

end program;
