program MandelbrotExplorer;

uses Fpas.Ui.Tui.Application as App, Fpas.Ui.Tui.Themes as Themes, Mandelbrot.Explorer as Explorer, Mandelbrot.Model as M, System.Threading as Threads;

begin
  using const Gate: Threads.SemaphoreSlim := new Threads.SemaphoreSlim(1, 1);
  App.Run<M.State, M.Message>(
    new M.State(),
    Explorer.CreateUpdate(Gate),
    Explorer.View,
    Themes.Dark()
  );
end;
end program;
