// HTTP orchestration for OpenAI-compatible chat completions.
unit Std.Ai.OpenAi.Client;

uses Std.Ai.OpenAi.Json, Std.Ai.OpenAi.Types, Std.Array, Std.Conv, Std.Http, Std.Net.Utf8, Std.Str;

// Appends the chat-completions path to a base API URL.
//
// Parameters:
// - `BaseUrl`: Base API URL with or without a trailing slash.
function CompletionUrl(BaseUrl: string): string;
begin
  if Std.Str.EndsWith(BaseUrl, '/') then
  begin
    return BaseUrl + 'chat/completions'
  end;

  return BaseUrl + '/chat/completions'
end;

// Validates, sends, and decodes one non-streaming chat completion.
//
// Parameters:
// - `ClientValue`: Endpoint, model, authorization, and response-limit settings.
// - `Messages`: Conversation messages sent in order.
// - `Options`: Optional generation controls for this completion.
public function Complete(ClientValue: Client; Messages: array of ChatMessage; Options: ChatOptions): result of string, string;
begin
  if ClientValue.BaseUrl = '' then
  begin
    return Error('OpenAI-compatible BaseUrl must not be empty')
  end;

  if ClientValue.Model = '' then
  begin
    return Error('OpenAI-compatible model name must not be empty')
  end;

  if Std.Array.Length(Messages) = 0 then
  begin
    return Error('OpenAI-compatible chat requires at least one message')
  end;
  mutable var Headers: array of Header := [
                                            Header.Create('Content-Type', 'application/json'),
                                            Header.Create('Accept', 'application/json')
                                          ];
  case ClientValue.ApiKey of
    Some(Value):
    begin
      if Value <> '' then
      begin
        Std.Array.Push(Headers, Header.Create('Authorization', 'Bearer ' + Value))
      end
    end;
    None:
    begin
    end
  end;
  mutable var RequestValue: Request := Request.Create('POST', CompletionUrl(ClientValue.BaseUrl));
  RequestValue.Headers := Headers;
  RequestValue.Body := Std.Net.Utf8.Encode(Std.Ai.OpenAi.Json.EncodeRequest(ClientValue.Model, Messages, Options));
  RequestValue.TimeoutMillis := ClientValue.TimeoutMillis;
  RequestValue.MaxResponseBytes := ClientValue.MaxResponseBytes;
  case Std.Http.Send(RequestValue) of
    Ok(ResponseValue):
    begin
      case Std.Http.BodyText(ResponseValue) of
        Ok(Text):
        begin
          if (ResponseValue.StatusCode < 200) or (ResponseValue.StatusCode >= 300) then
          begin
            return Error((('OpenAI-compatible endpoint returned HTTP ' + Std.Conv.IntToStr(ResponseValue.StatusCode)) + ': ') +
                         Text)
          end;

          return Std.Ai.OpenAi.Json.DecodeResponse(Text)
        end;
        Error(Message):
        begin
          return Error('OpenAI-compatible response body is not UTF-8: ' + Message)
        end
      end
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end
end;
