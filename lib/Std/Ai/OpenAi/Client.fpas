// HTTP orchestration for OpenAI-compatible chat completions.
unit Std.Ai.OpenAi.Client;

uses Std.Ai.OpenAi.Json as Json;
uses Std.Ai.OpenAi.Types as Types;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Http as Http;
uses Std.Net.Utf8 as Utf8;
uses Std.Str as Str;
uses Std.Http.Types as Types2;

// Appends the chat-completions path to a base API URL.
//
// Parameters:
// - `BaseUrl`: Base API URL with or without a trailing slash.
function CompletionUrl(BaseUrl: string): string;
begin
  if Str.EndsWith(BaseUrl, '/') then
    begin
      return BaseUrl + 'chat/completions';
    end;
  end if;

  return BaseUrl + '/chat/completions';
end function;

// Validates, sends, and decodes one non-streaming chat completion.
//
// Parameters:
// - `ClientValue`: Endpoint, model, authorization, and response-limit settings.
// - `Messages`: Conversation messages sent in order.
// - `Options`: Optional generation controls for this completion.
public function Complete(
  ClientValue: Types.Client;
  Messages: array of (Types.ChatMessage);
  Options: Types.ChatOptions
): Result of (string, string);
begin
  if ClientValue.BaseUrl = '' then
    begin
      return Result.Error('OpenAI-compatible BaseUrl must not be empty');
    end;
  end if;

  if ClientValue.Model = '' then
    begin
      return Result.Error('OpenAI-compatible model name must not be empty');
    end;
  end if;

  if Arrays.Length(Messages) = 0 then
    begin
      return Result.Error('OpenAI-compatible chat requires at least one message');
    end;
  end if;
  var Headers: array of (Http.Header) := [
                                           Types2.HeaderCreate('Content-Type', 'application/json'),
                                           Types2.HeaderCreate('Accept', 'application/json')
                                         ];
  case ClientValue.ApiKey of
    when Option.Some(const Value):
      begin
        if Value <> '' then
          begin
            Arrays.Push(var Headers, Types2.HeaderCreate('Authorization', 'Bearer ' + Value));
          end;
        end if;
      end;
    when Option.None:
      begin
        null;
      end;
  end case;
  var RequestValue: Http.Request := Types2.RequestCreate('POST', CompletionUrl(ClientValue.BaseUrl));
  RequestValue.Headers := Headers;
  RequestValue.Body := Utf8.Encode(Json.EncodeRequest(ClientValue.Model, Messages, Options));
  RequestValue.TimeoutMillis := ClientValue.TimeoutMillis;
  RequestValue.MaxResponseBytes := ClientValue.MaxResponseBytes;
  case Http.Send(RequestValue) of
    when Result.Ok(const ResponseValue):
      begin
        case Http.BodyText(ResponseValue) of
          when Result.Ok(const Text):
            begin
              if (ResponseValue.StatusCode < 200) or (ResponseValue.StatusCode >= 300) then
                begin
                  return Result.Error((('OpenAI-compatible endpoint returned HTTP ' + Conv.IntToStr(ResponseValue.StatusCode)) + ': ') +
                                      Text);
                end;
              end if;

              return Json.DecodeResponse(Text);
            end;
          when Result.Error(const Message):
            begin
              return Result.Error('OpenAI-compatible response body is not UTF-8: ' + Message);
            end;
        end case;
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;
end function;

end unit;
