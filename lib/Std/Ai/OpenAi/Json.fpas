// JSON encoding and decoding for OpenAI-compatible chat completions.
unit Std.Ai.OpenAi.Json;

uses Std.Ai.OpenAi.Types as Types, Std.Math as Math, Std.Encoding.Json as Json;

// Encodes one non-streaming chat-completion request body.
//
// Parameters:
// - `Model`: Model identifier placed in the request.
// - `Messages`: Conversation messages encoded in order.
// - `Options`: Optional generation controls to include.
public function EncodeRequest(
  Model: string;
  Messages: array of Types.ChatMessage;
  Options: Types.ChatOptions
): string;
begin
  var MessageValues: array of Json.JsonValue := [];
  for Index: integer := 0 to Messages.Length() - 1 do
    begin
      MessageValues.PushInPlace(
        Json.JsonValue.Object([
          'role': Json.JsonValue.String(Messages[Index].Role),
          'content': Json.JsonValue.String(Messages[Index].Content)
        ])
      );
    end;
  end for;
  var Fields: dict of string to Json.JsonValue := [
    'model': Json.JsonValue.String(Model),
    'messages': Json.JsonValue.ArrayValue(MessageValues),
    'stream': Json.JsonValue.Bool(false)
  ];
  case Options.Temperature of
    when Some(const Value):
      begin
        Fields['temperature'] := Json.JsonValue.Number(Value);
      end;
    when None:
      begin
      end;
  end case;

  case Options.MaxTokens of
    when Some(const Value):
      begin
        Fields['max_tokens'] := Json.JsonValue.Number(Math.IntToReal(Value));
      end;
    when None:
      begin
      end;
  end case;

  return Json.Stringify(Json.JsonValue.Object(Fields));
end function;

// Returns a required object field or an actionable error.
//
// Parameters:
// - `Fields`: JSON object fields to inspect.
// - `Name`: Required field name.
function RequiredField(Fields: dict of string to Json.JsonValue; Name: string): result of (Json.JsonValue, string);
begin
  case Fields.Get(Name) of
    when Some(const Value):
      begin
        return Ok(Value);
      end;
    when None:
      begin
        return Error('OpenAI-compatible response is missing field ' + Name);
      end;
  end case;
end function;

// Decodes the first assistant content value from a completion response.
//
// Parameters:
// - `Text`: Complete JSON response text.
public function DecodeResponse(Text: string): result of (string, string);
begin
  case Json.Parse(Text) of
    when Ok(const Root):
      begin
        case Root of
          when Json.JsonValue.Object(const RootFields):
            begin
              case RequiredField(RootFields, 'choices') of
                when Ok(const ChoicesValue):
                  begin
                    case ChoicesValue of
                      when Json.JsonValue.ArrayValue(const Choices):
                        begin
                          if Choices.Length() = 0 then
                            begin
                              return Error('OpenAI-compatible response contains no choices');
                            end;
                          end if;

                          case Choices[0] of
                            when Json.JsonValue.Object(const ChoiceFields):
                              begin
                                case RequiredField(ChoiceFields, 'message') of
                                  when Ok(const MessageValue):
                                    begin
                                      case MessageValue of
                                        when Json.JsonValue.Object(const MessageFields):
                                          begin
                                            case RequiredField(MessageFields, 'content') of
                                              when Ok(const ContentValue):
                                                begin
                                                  case ContentValue of
                                                    when Json.JsonValue.String(const Content):
                                                      begin
                                                        return Ok(Content);
                                                      end;
                                                    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
                                                      begin
                                                        return Error(
                                                          'OpenAI-compatible message content is not text'
                                                        );
                                                      end;
                                                  end case;
                                                end;
                                              when Error(const Message):
                                                begin
                                                  return Error(Message);
                                                end;
                                            end case;
                                          end;
                                        when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
                                          begin
                                            return Error(
                                              'OpenAI-compatible choice message is not an object'
                                            );
                                          end;
                                      end case;
                                    end;
                                  when Error(const Message):
                                    begin
                                      return Error(Message);
                                    end;
                                end case;
                              end;
                            when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
                              begin
                                return Error('OpenAI-compatible choice is not an object');
                              end;
                          end case;
                        end;
                      when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
                        begin
                          return Error('OpenAI-compatible choices field is not an array');
                        end;
                    end case;
                  end;
                when Error(const Message):
                  begin
                    return Error(Message);
                  end;
              end case;
            end;
          when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
            begin
              return Error('OpenAI-compatible response root is not an object');
            end;
        end case;
      end;
    when Error(const Message):
      begin
        return Error('Invalid OpenAI-compatible JSON response: ' + Message.Message());
      end;
  end case;
end function;
end unit;
