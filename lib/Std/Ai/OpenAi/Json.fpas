// JSON encoding and decoding for OpenAI-compatible chat completions.
unit Std.Ai.OpenAi.Json;

uses Std.Ai.OpenAi.Types as Types;
uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Dictionaries as Dictionaries;
uses Std.Json as Json;
uses Std.Options as Options2;

// Encodes one non-streaming chat-completion request body.
//
// Parameters:
// - `Model`: Model identifier placed in the request.
// - `Messages`: Conversation messages encoded in order.
// - `Options`: Optional generation controls to include.
public function EncodeRequest(
  Model: string;
  Messages: array of (Types.ChatMessage);
  Options: Types.ChatOptions
): string;
begin
  mutable var MessageValues: array of (Json.JsonValue) := [];
  for Index: integer := 0 to Arrays.Length(Messages) - 1 do
    begin
      Arrays.Push(MessageValues, Json.JsonValue.Object(['role': Json.JsonValue.String(Messages[Index].Role), 'content': Json.JsonValue.String(Messages[Index].Content)]));
    end;
  end for;
  mutable var Fields: dict of (string, Json.JsonValue) := ['model': Json.JsonValue.String(Model), 'messages': Json.JsonValue.ArrayValue(MessageValues), 'stream': Json.JsonValue.Bool(false)];
  case Options.Temperature of
    when Option.Some(const Value):
      begin
        Fields['temperature'] := Json.JsonValue.Number(Value);
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  case Options.MaxTokens of
    when Option.Some(const Value):
      begin
        Fields['max_tokens'] := Json.JsonValue.Number(Conv.IntToReal(Value));
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  return Json.Stringify(Json.JsonValue.Object(Fields));
end function;

// Returns a required object field or an actionable error.
//
// Parameters:
// - `Fields`: JSON object fields to inspect.
// - `Name`: Required field name.
function RequiredField(Fields: dict of (string, Json.JsonValue); Name: string): Result of (Json.JsonValue, string);
begin
  case Dictionaries.Get(Fields, Name) of
    when Option.Some(const Value):
      begin
        return Result.Ok(Value);
      end;
    when Option.None:
      begin
        return Result.Error('OpenAI-compatible response is missing field ' + Name);
      end;
  end case;
end function;

// Decodes the first assistant content value from a completion response.
//
// Parameters:
// - `Text`: Complete JSON response text.
public function DecodeResponse(Text: string): Result of (string, string);
begin
  case Json.Parse(Text) of
    when Result.Ok(const Root):
      begin
        case Root of
          when Json.JsonValue.Object(const RootFields):
            begin
              case RequiredField(RootFields, 'choices') of
                when Result.Ok(const ChoicesValue):
                  begin
                    case ChoicesValue of
                      when Json.JsonValue.ArrayValue(const Choices):
                        begin
                          if Arrays.Length(Choices) = 0 then
                            begin
                              return Result.Error('OpenAI-compatible response contains no choices');
                            end;
                          end if;

                          case Choices[0] of
                            when Json.JsonValue.Object(const ChoiceFields):
                              begin
                                case RequiredField(ChoiceFields, 'message') of
                                  when Result.Ok(const MessageValue):
                                    begin
                                      case MessageValue of
                                        when Json.JsonValue.Object(const MessageFields):
                                          begin
                                            case RequiredField(MessageFields, 'content') of
                                              when Result.Ok(const ContentValue):
                                                begin
                                                  case ContentValue of
                                                    when Json.JsonValue.String(const Content):
                                                      begin
                                                        return Result.Ok(Content);
                                                      end;
                                                    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
                                                      begin
                                                        begin
                                                          return Result.Error('OpenAI-compatible message content is not text');
                                                        end;
                                                      end;
                                                  end case;
                                                end;
                                              when Result.Error(const Message):
                                                begin
                                                  return Result.Error(Message);
                                                end;
                                            end case;
                                          end;
                                        when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
                                          begin
                                            begin
                                              return Result.Error('OpenAI-compatible choice message is not an object');
                                            end;
                                          end;
                                      end case;
                                    end;
                                  when Result.Error(const Message):
                                    begin
                                      return Result.Error(Message);
                                    end;
                                end case;
                              end;
                            when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
                              begin
                                begin
                                  return Result.Error('OpenAI-compatible choice is not an object');
                                end;
                              end;
                          end case;
                        end;
                      when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
                        begin
                          begin
                            return Result.Error('OpenAI-compatible choices field is not an array');
                          end;
                        end;
                    end case;
                  end;
                when Result.Error(const Message):
                  begin
                    return Result.Error(Message);
                  end;
              end case;
            end;
          when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
            begin
              begin
                return Result.Error('OpenAI-compatible response root is not an object');
              end;
            end;
        end case;
      end;
    when Result.Error(const Message):
      begin
        return Result.Error('Invalid OpenAI-compatible JSON response: ' + Message);
      end;
  end case;
end function;

end unit;
