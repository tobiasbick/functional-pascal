unit Std.Ai.OpenAi.Types;

public type
  // One role-tagged message in an OpenAI-compatible chat conversation.
  ChatMessage = record
    public Role: string;
    public Content: string;

    public static function Create(Role: string; Content: string): ChatMessage;
    begin
      return record
        Role := Role;
        Content := Content;
      end
    end;

    public static function System(Content: string): ChatMessage;
    begin
      return ChatMessage.Create('system', Content)
    end;

    public static function User(Content: string): ChatMessage;
    begin
      return ChatMessage.Create('user', Content)
    end;

    public static function Assistant(Content: string): ChatMessage;
    begin
      return ChatMessage.Create('assistant', Content)
    end;
  end;
  // Connection and model settings for an OpenAI-compatible endpoint.
  Client = record
    public BaseUrl: string;
    public Model: string;
    public ApiKey: option of string;
    public TimeoutMillis: integer;
    public MaxResponseBytes: integer;

    public static function Create(BaseUrl: string; Model: string): Client;
    begin
      return record
        BaseUrl := BaseUrl;
        Model := Model;
        ApiKey := None;
        TimeoutMillis := 120000;
        MaxResponseBytes := 16777216;
      end
    end;
  end;
  // Optional generation controls sent with a chat completion.
  ChatOptions = record
    public Temperature: option of real;
    public MaxTokens: option of integer;

    public static function Default(): ChatOptions;
    begin
      return record
        Temperature := None;
        MaxTokens := None;
      end
    end;
  end;
