// Data types used by the OpenAI-compatible chat client.
unit Std.Ai.OpenAi.Types;

// One role-tagged message in an OpenAI-compatible chat conversation.
public type ChatMessage = record
  // OpenAI-compatible message role such as `system`, `user`, or `assistant`.
  public Role: string;
  // Text content of the message.
  public Content: string;
end record;

// Creates a message with an explicit role.
//
// Parameters:
// - `Role`: OpenAI-compatible role name.
// - `Content`: Text content of the message.
public function ChatMessageCreate(Role: string; Content: string): ChatMessage;
begin
  return ChatMessage(Role := Role, Content := Content);
end function;

// Creates a system instruction message.
//
// Parameters:
// - `Content`: System instruction text.
public function ChatMessageSystem(Content: string): ChatMessage;
begin
  return ChatMessageCreate('system', Content);
end function;

// Creates a user message.
//
// Parameters:
// - `Content`: User message text.
public function ChatMessageUser(Content: string): ChatMessage;
begin
  return ChatMessageCreate('user', Content);
end function;

// Creates an assistant message.
//
// Parameters:
// - `Content`: Assistant message text.
public function ChatMessageAssistant(Content: string): ChatMessage;
begin
  return ChatMessageCreate('assistant', Content);
end function;

// Connection and model settings for an OpenAI-compatible endpoint.
public type Client = record
  // Base API URL, normally ending in `/v1`.
  public BaseUrl: string;
  // Model identifier sent with each request.
  public Model: string;
  // Optional bearer token used for authorization.
  public ApiKey: Option of (string);
  // TCP, TLS, and response-read timeout in milliseconds.
  public TimeoutMillis: integer;
  // Maximum complete response size in bytes.
  public MaxResponseBytes: integer;
end record;

// Creates client settings with default limits and no API key.
//
// Parameters:
// - `BaseUrl`: Base URL of the OpenAI-compatible API.
// - `Model`: Model identifier sent with chat requests.
public function ClientCreate(BaseUrl: string; Model: string): Client;
begin
  return Client(BaseUrl := BaseUrl, Model := Model, ApiKey := Option.None, TimeoutMillis := 120000, MaxResponseBytes := 16777216);
end function;

// Optional generation controls sent with a chat completion.
public type ChatOptions = record
  // Optional sampling temperature.
  public Temperature: Option of (real);
  // Optional maximum number of generated tokens.
  public MaxTokens: Option of (integer);
end record;

// Returns options that omit every optional generation control.
public function ChatOptionsDefault(): ChatOptions;
begin
  return ChatOptions(Temperature := Option.None, MaxTokens := Option.None);
end function;

end unit;
