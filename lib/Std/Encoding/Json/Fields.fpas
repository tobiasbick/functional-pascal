// Strict typed access to the fields of parsed JSON objects.
//
// Handbook: `docs/pascal/std/text/json-fields.md`.
unit Std.Encoding.Json.Fields;

uses Std.Encoding.Json as Json, Std.Math as Math;

// Exclusive upper and inclusive lower real bounds of the 64-bit integer range.
const IntegerUpperBound: real := 9223372036854776000.0;
const IntegerLowerBound: real := -9223372036854776000.0;

// Structured failures of strict JSON field access.
public type FieldError = error
  ParseFailure(Cause: Json.JsonError) = 'Invalid JSON field';
  ExpectedObject = 'Invalid JSON field';
  MissingField(Name: string) = 'Invalid JSON field';
  WrongType(Name: string; Expected: string) = 'Invalid JSON field';
  InvalidValue(Name: string; Reason: string) = 'Invalid JSON field';
  UnknownField(Name: string) = 'Invalid JSON field';
end error;

// Parses JSON text whose root must be an object and returns its fields.
//
// Parameters:
// - `Text`: JSON document text.
public function ParseObject(Text: string): result of (dict of string to Json.JsonValue, FieldError);
begin
  case try Json.Parse(Text).MapError(FieldError.ParseFailure) of
    when Json.JsonValue.Object(const Fields):
      begin
        return Ok(Fields);
      end;
    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
      begin
        return Error(FieldError.ExpectedObject);
      end;
  end case;
end function;

// Returns one present field of any JSON kind.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function Field(Fields: dict of string to Json.JsonValue; Name: string): result of (Json.JsonValue, FieldError);
begin
  case Fields.Get(Name) of
    when Some(const Value):
      begin
        return Ok(Value);
      end;
    when None:
      begin
        return Error(FieldError.MissingField(Name));
      end;
  end case;
end function;

// Returns one required string field.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function StringField(Fields: dict of string to Json.JsonValue; Name: string): result of (string, FieldError);
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.String(const Value):
      begin
        return Ok(Value);
      end;
    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
      begin
        return Error(FieldError.WrongType(Name, 'a string'));
      end;
  end case;
end function;

// Returns one required boolean field.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function BooleanField(Fields: dict of string to Json.JsonValue; Name: string): result of (boolean, FieldError);
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.Bool(const Value):
      begin
        return Ok(Value);
      end;
    when Json.JsonValue.NullValue, Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
      begin
        return Error(FieldError.WrongType(Name, 'a boolean'));
      end;
  end case;
end function;

// Returns one required number field as a real value.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function NumberField(Fields: dict of string to Json.JsonValue; Name: string): result of (real, FieldError);
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.Number(const Value):
      begin
        return Ok(Value);
      end;
    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
      begin
        return Error(FieldError.WrongType(Name, 'a number'));
      end;
  end case;
end function;

// Returns one required number field that holds an exact integer in the 64-bit range.
// Fractional or out-of-range numbers return `Error` instead of raising a runtime error.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function IntegerField(Fields: dict of string to Json.JsonValue; Name: string): result of (integer, FieldError);
begin
  const Value: real := try NumberField(Fields, Name);
  if (Value < IntegerLowerBound) or (Value >= IntegerUpperBound) then
    begin
      return Error(FieldError.InvalidValue(Name, 'outside the integer range'));
    end;
  end if;
  const IntegerValue: integer := Math.Trunc(Value);
  if Math.IntToReal(IntegerValue) <> Value then
    begin
      return Error(FieldError.WrongType(Name, 'an integer'));
    end;
  end if;

  return Ok(IntegerValue);
end function;

// Returns one required nested object field.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function ObjectField(Fields: dict of string to Json.JsonValue; Name: string): result of (dict of string to Json.JsonValue, FieldError);
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.Object(const Value):
      begin
        return Ok(Value);
      end;
    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
      begin
        return Error(FieldError.WrongType(Name, 'an object'));
      end;
  end case;
end function;

// Returns one required array field without checking element kinds.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function ArrayField(Fields: dict of string to Json.JsonValue; Name: string): result of (array of Json.JsonValue, FieldError);
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.ArrayValue(const Items):
      begin
        return Ok(Items);
      end;
    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
      begin
        return Error(FieldError.WrongType(Name, 'an array'));
      end;
  end case;
end function;

// Returns one required array field whose elements must all be strings.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function StringArrayField(Fields: dict of string to Json.JsonValue; Name: string): result of (array of string, FieldError);
begin
  var Values: array of string := [];
  for Item: Json.JsonValue in try ArrayField(Fields, Name) do
    begin
      case Item of
        when Json.JsonValue.String(const Value):
          begin
            Values.PushInPlace(Value);
          end;
        when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
          begin
            return Error(FieldError.WrongType(Name, 'an array of strings'));
          end;
      end case;
    end;
  end for;

  return Ok(Values);
end function;

// Rejects the first field whose name is not listed in `Allowed`; missing fields are not checked.
//
// Parameters:
// - `Fields`: Object fields.
// - `Allowed`: Every permitted field name.
public function RequireOnlyFields(Fields: dict of string to Json.JsonValue; Allowed: array of string): result of (boolean, FieldError);
begin
  for Name: string in Fields.Keys() do
    begin
      if not (Name in Allowed) then
        begin
          return Error(FieldError.UnknownField(Name));
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;
end unit;
