// Public buffered, streaming, server, and SSE HTTP API.
unit Std.Http;

uses
  Std.Http.Client, Std.Http.Headers, Std.Http.Server, Std.Http.ServerLoop, Std.Http.Sse,
  Std.Http.Stream, Std.Http.Types, Std.Net, Std.Net.Utf8;

public type
  // One HTTP field name and value.
  Header = Std.Http.Types.Header;
  // One complete non-streaming HTTP request.
  Request = Std.Http.Types.Request;
  // One complete non-streaming HTTP response.
  Response = Std.Http.Types.Response;
  // Status, headers, and a pull-based response body.
  StreamResponse = Std.Http.Types.StreamResponse;
  // One request accepted by the HTTP server helpers.
  ServerRequest = Std.Http.Types.ServerRequest;
  // One complete response written by the HTTP server helpers.
  ServerResponse = Std.Http.Types.ServerResponse;
  // Limits and concurrency used by the HTTP server loop.
  ServerOptions = Std.Http.Types.ServerOptions;
  // Maps one accepted request to its complete response.
  RequestHandler = Std.Http.Types.RequestHandler;
  // Opaque pull-based HTTP response body.
  BodyStream = Std.Http.Types.BodyStream;
  // One decoded Server-Sent Events message.
  SseEvent = Std.Http.Types.SseEvent;
  // Opaque incremental Server-Sent Events decoder.
  SseDecoder = Std.Http.Types.SseDecoder;

// Sends one HTTP/1.1 request and follows bounded redirects.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function Send(RequestValue: Std.Http.Types.Request): result of Std.Http.Types.Response, string;
begin
  return Std.Http.Client.Send(RequestValue)
end;

// Sends one HTTP/1.1 request, follows bounded redirects, and returns the final response stream.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function OpenStream(RequestValue: Std.Http.Types.Request): result of Std.Http.Types.StreamResponse, string;
begin
  return Std.Http.Client.OpenStream(RequestValue)
end;

// Reads at most MaxBytes decoded body bytes. An empty array means end of stream.
//
// Parameters:
// - `StreamValue`: Open response-body handle.
// - `MaxBytes`: Maximum number of decoded bytes to return.
public function ReadStream(StreamValue: Std.Http.Types.BodyStream; MaxBytes: integer): result of array of integer, string;
begin
  return Std.Http.Stream.ReadBody(StreamValue, MaxBytes)
end;

// Closes a streaming response body before end of stream.
//
// Parameters:
// - `StreamValue`: Open response-body handle to close.
public function CloseStream(StreamValue: Std.Http.Types.BodyStream): result of boolean, string;
begin
  return Std.Http.Stream.CloseBody(StreamValue)
end;

// Reads one bounded HTTP/1.x request from a connected client.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `MaxHeaderBytes`: Maximum request-head size in bytes.
// - `MaxBodyBytes`: Maximum request-body size in bytes.
public function ReadRequest(Connection: Std.Net.Connection; MaxHeaderBytes: integer; MaxBodyBytes: integer): result of Std.Http.Types.ServerRequest, string;
begin
  return Std.Http.Server.ReadRequest(Connection, MaxHeaderBytes, MaxBodyBytes)
end;

// Writes one complete HTTP/1.1 response without closing the connection.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `ResponseValue`: Complete response to serialize and write.
public function WriteResponse(Connection: Std.Net.Connection; ResponseValue: Std.Http.Types.ServerResponse): result of boolean, string;
begin
  return Std.Http.Server.WriteResponse(Connection, ResponseValue)
end;

// Accepts requests in bounded concurrent batches and dispatches each one to Handler.
//
// Parameters:
// - `Listener`: Open TCP or TLS listener.
// - `Options`: Request limits and server-loop bounds.
// - `Handler`: Callback that maps each accepted request to a response.
public function Serve(
  Listener: Std.Net.Listener;
  Options: Std.Http.Types.ServerOptions;
  Handler: Std.Http.Types.RequestHandler
): result of boolean, string;
begin
  return Std.Http.ServerLoop.Serve(Listener, Options, Handler)
end;

// Creates an incremental Server-Sent Events decoder with one bounded event buffer.
//
// Parameters:
// - `MaxEventBytes`: Maximum buffered bytes for one incomplete event.
public function CreateSseDecoder(MaxEventBytes: integer): result of Std.Http.Types.SseDecoder, string;
begin
  return Std.Http.Sse.Create(MaxEventBytes)
end;

// Feeds one byte fragment and returns every complete event decoded from it.
//
// Parameters:
// - `Decoder`: Open incremental SSE decoder.
// - `Bytes`: Next response-body byte fragment.
public function FeedSse(Decoder: Std.Http.Types.SseDecoder; Bytes: array of integer): result of array of Std.Http.Types.SseEvent, string;
begin
  return Std.Http.Sse.Feed(Decoder, Bytes)
end;

// Flushes the final SSE line and prevents further input.
//
// Parameters:
// - `Decoder`: Open incremental SSE decoder to finish.
public function FinishSse(Decoder: Std.Http.Types.SseDecoder): result of array of Std.Http.Types.SseEvent, string;
begin
  return Std.Http.Sse.Finish(Decoder)
end;

// Finds the first response header with a case-insensitive name.
//
// Parameters:
// - `ResponseValue`: Response whose headers are searched.
// - `Name`: Case-insensitive header name.
public function HeaderValue(ResponseValue: Std.Http.Types.Response; Name: string): option of string;
begin
  return Std.Http.Headers.Find(ResponseValue.Headers, Name)
end;

// Decodes a response body as validated UTF-8 text.
//
// Parameters:
// - `ResponseValue`: Buffered response whose body is decoded.
public function BodyText(ResponseValue: Std.Http.Types.Response): result of string, string;
begin
  return Std.Net.Utf8.Decode(ResponseValue.Body)
end;
