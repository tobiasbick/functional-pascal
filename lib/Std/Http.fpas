// Public buffered, streaming, server, and SSE HTTP API.
unit Std.Http;

uses Std.Http.Client as Client;
uses Std.Http.Headers as Headers;
uses Std.Http.Server as Server;
uses Std.Http.ServerLoop as ServerLoop;
uses Std.Http.Sse as Sse;
uses Std.Http.Stream as Stream;
uses Std.Http.Types as Types;
uses Std.Net as Net;
uses Std.Net.Utf8 as Utf8;

// One HTTP field name and value.
public type Header = Types.Header;

// One complete non-streaming HTTP request.
public type Request = Types.Request;

// One complete non-streaming HTTP response.
public type Response = Types.Response;

// Status, headers, and a pull-based response body.
public type StreamResponse = Types.StreamResponse;

// One request accepted by the HTTP server helpers.
public type ServerRequest = Types.ServerRequest;

// One complete response written by the HTTP server helpers.
public type ServerResponse = Types.ServerResponse;

// Limits and concurrency used by the HTTP server loop.
public type ServerOptions = Types.ServerOptions;

// Maps one accepted request to its complete response.
public type RequestHandler = Types.RequestHandler;

// Opaque pull-based HTTP response body.
public type BodyStream = Types.BodyStream;

// One decoded Server-Sent Events message.
public type SseEvent = Types.SseEvent;

// Opaque incremental Server-Sent Events decoder.
public type SseDecoder = Types.SseDecoder;

// Sends one HTTP/1.1 request and follows bounded redirects.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function Send(RequestValue: Types.Request): Result of (Types.Response, string);
begin
  return Client.Send(RequestValue);
end function;

// Sends one HTTP/1.1 request, follows bounded redirects, and returns the final response stream.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function OpenStream(RequestValue: Types.Request): Result of (Types.StreamResponse, string);
begin
  return Client.OpenStream(RequestValue);
end function;

// Reads at most MaxBytes decoded body bytes. An empty array means end of stream.
//
// Parameters:
// - `StreamValue`: Open response-body handle.
// - `MaxBytes`: Maximum number of decoded bytes to return.
public function ReadStream(StreamValue: Types.BodyStream; MaxBytes: integer): Result of (array of (integer), string);
begin
  return Stream.ReadBody(StreamValue, MaxBytes);
end function;

// Closes a streaming response body before end of stream.
//
// Parameters:
// - `StreamValue`: Open response-body handle to close.
public function CloseStream(StreamValue: Types.BodyStream): Result of (boolean, string);
begin
  return Stream.CloseBody(StreamValue);
end function;

// Reads one bounded HTTP/1.x request from a connected client.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `MaxHeaderBytes`: Maximum request-head size in bytes.
// - `MaxBodyBytes`: Maximum request-body size in bytes.
public function ReadRequest(Connection: Net.Connection; MaxHeaderBytes: integer; MaxBodyBytes: integer): Result of (Types.ServerRequest, string);
begin
  return Server.ReadRequest(Connection, MaxHeaderBytes, MaxBodyBytes);
end function;

// Writes one complete HTTP/1.1 response without closing the connection.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `ResponseValue`: Complete response to serialize and write.
public function WriteResponse(Connection: Net.Connection; ResponseValue: Types.ServerResponse): Result of (boolean, string);
begin
  return Server.WriteResponse(Connection, ResponseValue);
end function;

// Accepts requests in bounded concurrent batches and dispatches each one to Handler.
//
// Parameters:
// - `Listener`: Open TCP or TLS listener.
// - `Options`: Request limits and server-loop bounds.
// - `Handler`: Callback that maps each accepted request to a response.
public function Serve(Listener: Net.Listener; Options: Types.ServerOptions; Handler: Types.RequestHandler): Result of (boolean, string);
begin
  return ServerLoop.Serve(Listener, Options, Handler);
end function;

// Creates an incremental Server-Sent Events decoder with one bounded event buffer.
//
// Parameters:
// - `MaxEventBytes`: Maximum buffered bytes for one incomplete event.
public function CreateSseDecoder(MaxEventBytes: integer): Result of (Types.SseDecoder, string);
begin
  return Sse.Create(MaxEventBytes);
end function;

// Feeds one byte fragment and returns every complete event decoded from it.
//
// Parameters:
// - `Decoder`: Open incremental SSE decoder.
// - `Bytes`: Next response-body byte fragment.
public function FeedSse(Decoder: Types.SseDecoder; Bytes: array of (integer)): Result of (array of (Types.SseEvent), string);
begin
  return Sse.Feed(Decoder, Bytes);
end function;

// Flushes the final SSE line and prevents further input.
//
// Parameters:
// - `Decoder`: Open incremental SSE decoder to finish.
public function FinishSse(Decoder: Types.SseDecoder): Result of (array of (Types.SseEvent), string);
begin
  return Sse.Finish(Decoder);
end function;

// Finds the first response header with a case-insensitive name.
//
// Parameters:
// - `ResponseValue`: Response whose headers are searched.
// - `Name`: Case-insensitive header name.
public function HeaderValue(ResponseValue: Types.Response; Name: string): Option of (string);
begin
  return Headers.Find(ResponseValue.Headers, Name);
end function;

// Decodes a response body as validated UTF-8 text.
//
// Parameters:
// - `ResponseValue`: Buffered response whose body is decoded.
public function BodyText(ResponseValue: Types.Response): Result of (string, string);
begin
  return Utf8.Decode(ResponseValue.Body);
end function;

end unit;
