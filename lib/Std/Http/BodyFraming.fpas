// Strict HTTP message-body framing selection.
unit Std.Http.BodyFraming;

uses Std.Arrays as Arrays;
uses Std.Http.Headers as Headers2;
uses Std.Http.Types as Types;
uses Std.Net.Decimal as Decimal;
uses Std.Str as Str;

// Selected HTTP message-body framing mode and remaining fixed length.
public type Framing = record
  // Internal framing mode identifier.
  public Mode: integer;
  // Bytes remaining for fixed-length framing.
  public Remaining: integer;
end record;

// Selects one unambiguous HTTP message-body framing mode.
//
// Parameters:
// - `Headers`: Parsed message fields used to determine framing.
public function Select(Headers: array of (Types.Header)): Result of (Framing, string);
begin
  mutable var TransferEncoding: string := '';
  mutable var TransferEncodingCount: integer := 0;
  mutable var ContentLength: integer := 0;
  mutable var ContentLengthCount: integer := 0;
  for Index: integer := 0 to Arrays.Length(Headers) - 1 do
    begin
      if Headers2.IsName(Headers[Index].Name, 'Transfer-Encoding') then
        begin
          TransferEncodingCount := TransferEncodingCount + 1;
          TransferEncoding := Str.ToLower(Str.Trim(Headers[Index].Value));
        end;
      end if;

      if Headers2.IsName(Headers[Index].Name, 'Content-Length') then
        begin
          case Decimal.Parse(Headers[Index].Value, 9223372036854775807) of
            when Result.Ok(const Length):
              begin
                if (ContentLengthCount > 0) and (Length <> ContentLength) then
                  begin
                    return Result.Error('HTTP message contains conflicting Content-Length headers');
                  end;
                end if;

                ContentLength := Length;
                ContentLengthCount := ContentLengthCount + 1;
              end;
            when Result.Error(const Message):
              begin
                return Result.Error('Invalid HTTP Content-Length: ' + Message);
              end;
          end case;
        end;
      end if;
    end;
  end for;

  if TransferEncodingCount > 1 then
    begin
      return Result.Error('HTTP message contains multiple Transfer-Encoding headers');
    end;
  end if;

  if (TransferEncodingCount > 0) and (ContentLengthCount > 0) then
    begin
      return Result.Error('HTTP message contains both Transfer-Encoding and Content-Length');
    end;
  end if;

  if TransferEncodingCount > 0 then
    begin
      if TransferEncoding <> 'chunked' then
        begin
          return Result.Error('Unsupported HTTP Transfer-Encoding: ' + TransferEncoding);
        end;
      end if;

      return Result.Ok(Framing(Mode := 2, Remaining := 0));
    end;
  end if;

  if ContentLengthCount > 0 then
    begin
      return Result.Ok(Framing(Mode := 1, Remaining := ContentLength));
    end;
  end if;

  return Result.Ok(Framing(Mode := 3, Remaining := 0));
end function;

end unit;
