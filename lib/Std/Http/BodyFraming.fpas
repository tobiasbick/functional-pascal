// Strict HTTP message-body framing selection.
unit Std.Http.BodyFraming;

uses Std.Http.Headers, Std.Http.Types, Std.Net.Decimal;

// Selected HTTP message-body framing mode and remaining fixed length.
public type Framing = record
  // Internal framing mode identifier.
  public Mode: integer;
  // Bytes remaining for fixed-length framing.
  public Remaining: integer;
end record;

// Selects one unambiguous HTTP message-body framing mode.
//
// Parameters:
// - `Headers`: Parsed message fields used to determine framing.
public function Select(Headers: array of Header): result of Framing, string;
begin
  var TransferEncoding: string := '';
  var TransferEncodingCount: integer := 0;
  var ContentLength: integer := 0;
  var ContentLengthCount: integer := 0;
  for Index: integer := 0 to Headers.Length() - 1 do
    begin
      if Std.Http.Headers.IsName(Headers[Index].Name, 'Transfer-Encoding') then
        begin
          TransferEncodingCount := TransferEncodingCount + 1;
          TransferEncoding := Headers[Index].Value.Trim().ToLower();
        end;
      end if;

      if Std.Http.Headers.IsName(Headers[Index].Name, 'Content-Length') then
        begin
          case Std.Net.Decimal.Parse(Headers[Index].Value, 9223372036854775807) of
            when Ok(Length):
              begin
                if (ContentLengthCount > 0) and (Length <> ContentLength) then
                  begin
                    return Error('HTTP message contains conflicting Content-Length headers');
                  end;
                end if;

                ContentLength := Length;
                ContentLengthCount := ContentLengthCount + 1;
              end;
            when Error(Message):
              begin
                return Error('Invalid HTTP Content-Length: ' + Message);
              end;
          end case;
        end;
      end if;
    end;
  end for;

  if TransferEncodingCount > 1 then
    begin
      return Error('HTTP message contains multiple Transfer-Encoding headers');
    end;
  end if;

  if (TransferEncodingCount > 0) and (ContentLengthCount > 0) then
    begin
      return Error('HTTP message contains both Transfer-Encoding and Content-Length');
    end;
  end if;

  if TransferEncodingCount > 0 then
    begin
      if TransferEncoding <> 'chunked' then
        begin
          return Error('Unsupported HTTP Transfer-Encoding: ' + TransferEncoding);
        end;
      end if;

      return Ok(record
        Mode := 2;
        Remaining := 0;
      end);
    end;
  end if;

  if ContentLengthCount > 0 then
    begin
      return Ok(record
        Mode := 1;
        Remaining := ContentLength;
      end);
    end;
  end if;

  return Ok(record
    Mode := 3;
    Remaining := 0;
  end);
end function;
end unit;
