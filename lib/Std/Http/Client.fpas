unit Std.Http.Client;

uses Std.Array, Std.Http.Stream, Std.Http.Types, Std.Http.Wire, Std.Net, Std.Net.Uri;

function WriteAll(Connection: Std.Net.Connection; Bytes: array of integer): result of boolean, string;
begin
  mutable var Offset: integer := 0;
  while Offset < Std.Array.Length(Bytes) do
  begin
    var Remaining: array of integer := Std.Array.Slice(Bytes, Offset, Std.Array.Length(Bytes) -
                                                                      Offset);
    case Std.Net.Write(Connection, Remaining) of
      Ok(Count):
      begin
        if Count <= 0 then
        begin
          return Error('Network connection stopped while writing the HTTP request')
        end;

        Offset := Offset + Count
      end;
      Error(Message):
      begin
        return Error(Message)
      end
    end
  end;

  return Ok(true)
end;

function ReadHead(Connection: Std.Net.Connection; Maximum: integer): result of array of integer, string;
begin
  if Maximum < 1 then
  begin
    return Error('HTTP MaxResponseBytes must be positive')
  end;
  mutable var Bytes: array of integer := [];
  while Std.Http.Wire.FindSeparator(Bytes, 0) < 0 do
  begin
    case Std.Net.Read(Connection, 65536) of
      Ok(Chunk):
      begin
        if Std.Array.Length(Chunk) = 0 then
        begin
          return Error('HTTP response is missing the header terminator')
        end;

        if Std.Array.Length(Bytes) + Std.Array.Length(Chunk) > Maximum then
        begin
          return Error('HTTP response exceeds MaxResponseBytes')
        end;

        Bytes := Std.Array.Concat(Bytes, Chunk)
      end;
      Error(Message):
      begin
        return Error(Message)
      end
    end
  end;

  return Ok(Bytes)
end;

function OpenConnection(UriValue: Uri; TimeoutMillis: integer): result of Std.Net.Connection, string;
begin
  if UriValue.Scheme = 'http' then
  begin
    return Std.Net.Connect(UriValue.Host, UriValue.Port, TimeoutMillis)
  end;

  if UriValue.Scheme = 'https' then
  begin
    return Std.Net.ConnectTls(UriValue.Host, UriValue.Port, TimeoutMillis)
  end;

  return Error('Std.Http supports only http:// and https:// URLs')
end;

procedure CloseQuietly(Connection: Std.Net.Connection);
begin
  case Std.Net.Close(Connection) of
    Ok(_):
    begin
    end;
    Error(_):
    begin
    end
  end
end;

public function OpenStream(RequestValue: Request): result of StreamResponse, string;
begin
  if RequestValue.MaxResponseBytes < 1 then
  begin
    return Error('HTTP MaxResponseBytes must be positive')
  end;
  mutable var UriValue: Uri := record
    Scheme := '';
    Host := '';
    Port := 0;
    Path := '';
  end;

  case Std.Net.Uri.Parse(RequestValue.Url) of
    Ok(Value):
    begin
      UriValue := Value
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;
  mutable var Encoded: array of integer := [];
  case Std.Http.Wire.EncodeRequest(RequestValue, UriValue) of
    Ok(Value):
    begin
      Encoded := Value
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;

  case OpenConnection(UriValue, RequestValue.TimeoutMillis) of
    Ok(Connection):
    begin
      case Std.Net.SetTimeout(Connection, RequestValue.TimeoutMillis) of
        Ok(Configured):
        begin
          if not Configured then
          begin
            CloseQuietly(Connection);
            return Error('Network timeout configuration failed')
          end
        end;
        Error(Message):
        begin
          CloseQuietly(Connection);
          return Error(Message)
        end
      end;

      case WriteAll(Connection, Encoded) of
        Ok(Written):
        begin
        end;
        Error(Message):
        begin
          CloseQuietly(Connection);
          return Error(Message)
        end
      end;
      mutable var ResponseBytes: array of integer := [];
      case ReadHead(Connection, RequestValue.MaxResponseBytes) of
        Ok(Value):
        begin
          ResponseBytes := Value
        end;
        Error(Message):
        begin
          CloseQuietly(Connection);
          return Error(Message)
        end
      end;

      case Std.Http.Wire.ParseResponseHead(ResponseBytes) of
        Ok(Head):
        begin
          var InitialBody: array of integer := Std.Array.Slice(ResponseBytes, Head.BodyOffset, Std.Array.Length(ResponseBytes) -
                                                                                               Head.BodyOffset);
          case Std.Http.Stream.CreateBody(Connection, InitialBody, Head.Headers, Std.Http.Wire.ResponseHasBody(RequestValue.Method, Head.StatusCode), Std.Array.Length(ResponseBytes), RequestValue.MaxResponseBytes) of
            Ok(Body):
            begin
              return Ok(record
                StatusCode := Head.StatusCode;
                ReasonPhrase := Head.ReasonPhrase;
                Headers := Head.Headers;
                Body := Body;
              end)
            end;
            Error(Message):
            begin
              return Error(Message)
            end
          end
        end;
        Error(Message):
        begin
          CloseQuietly(Connection);
          return Error(Message)
        end
      end
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end
end;

public function Send(RequestValue: Request): result of Response, string;
begin
  case OpenStream(RequestValue) of
    Ok(StreamResponseValue):
    begin
      mutable var Body: array of integer := [];
      while true do
      begin
        case Std.Http.Stream.ReadBody(StreamResponseValue.Body, 65536) of
          Ok(Bytes):
          begin
            if Std.Array.Length(Bytes) = 0 then
            begin
              return Ok(record
                StatusCode := StreamResponseValue.StatusCode;
                ReasonPhrase := StreamResponseValue.ReasonPhrase;
                Headers := StreamResponseValue.Headers;
                Body := Body;
              end)
            end;

            Body := Std.Array.Concat(Body, Bytes)
          end;
          Error(Message):
          begin
            case Std.Http.Stream.CloseBody(StreamResponseValue.Body) of
              Ok(_):
              begin
              end;
              Error(_):
              begin
              end
            end;

            return Error(Message)
          end
        end
      end;

      return Error('HTTP response stream ended unexpectedly')
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end
end;
