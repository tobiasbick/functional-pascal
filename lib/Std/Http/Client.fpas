// Buffered and streaming HTTP client orchestration.
unit Std.Http.Client;

uses Std.Arrays as Arrays;
uses Std.Http.Head as Head;
uses Std.Http.Headers as Headers2;
uses Std.Http.Io as Io;
uses Std.Http.Redirect as Redirect;
uses Std.Http.Stream as Stream;
uses Std.Http.Types as Types;
uses Std.Http.Wire as Wire;
uses Std.Net as Net;
uses Std.Net.Uri as Uri2;

// Opens a TCP or verified TLS connection selected by URI scheme.
//
// Parameters:
// - `UriValue`: Parsed absolute request URI.
// - `TimeoutMillis`: Connection and TLS handshake timeout.
function OpenConnection(UriValue: Uri2.Uri; TimeoutMillis: integer): result of Net.Connection, string;
begin
  if UriValue.Scheme = 'http' then
    begin
      return Net.Connect(UriValue.Host, UriValue.Port, TimeoutMillis);
    end;
  end if;

  if UriValue.Scheme = 'https' then
    begin
      return Net.ConnectTls(UriValue.Host, UriValue.Port, TimeoutMillis);
    end;
  end if;

  return Error('Std.Http supports only http:// and https:// URLs');
end function;

// Closes a connection while deliberately ignoring close errors.
//
// Parameters:
// - `Connection`: Connection to close.
procedure CloseQuietly(Connection: Net.Connection);
begin
  case Net.Close(Connection) of
    when Ok(_):
      begin
        null;
      end;
    when Error(_):
      begin
        null;
      end;
  end case;
end procedure;

// Sends one request without applying redirect policy.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
function OpenOnce(RequestValue: Types.Request): result of Types.StreamResponse, string;
begin
  var UriValue: Uri2.Uri := try Uri2.Parse(RequestValue.Url);
  var Encoded: array of integer := try Wire.EncodeRequest(RequestValue, UriValue);
  case OpenConnection(UriValue, RequestValue.TimeoutMillis) of
    when Ok(Connection):
      begin
        case Net.SetTimeout(Connection, RequestValue.TimeoutMillis) of
          when Ok(Configured):
            begin
              if not Configured then
                begin
                  CloseQuietly(Connection);
                  return Error('Network timeout configuration failed');
                end;
              end if;
            end;
          when Error(Message):
            begin
              CloseQuietly(Connection);
              return Error(Message);
            end;
        end case;

        case Io.WriteAll(Connection, Encoded) of
          when Ok(Written):
            begin
              null;
            end;
          when Error(Message):
            begin
              CloseQuietly(Connection);
              return Error(Message);
            end;
        end case;

        case Head.ReadFinal(Connection, RequestValue.MaxHeaderBytes, RequestValue.MaxResponseBytes) of
          when Ok(FinalHead):
            begin
              case Stream.CreateBody(Connection, FinalHead.InitialBody, FinalHead.Head.Headers, Wire.ResponseHasBody(RequestValue.Method, FinalHead.Head.StatusCode), FinalHead.BytesReceived, RequestValue.MaxResponseBytes) of
                when Ok(Body):
                  begin
                    return Ok(record
                      StatusCode := FinalHead.Head.StatusCode;
                      ReasonPhrase := FinalHead.Head.ReasonPhrase;
                      Headers := FinalHead.Head.Headers;
                      Body := Body;
                    end record);
                  end;
                when Error(Message):
                  begin
                    return Error(Message);
                  end;
              end case;
            end;
          when Error(Message):
            begin
              CloseQuietly(Connection);
              return Error(Message);
            end;
        end case;
      end;
    when Error(Message):
      begin
        return Error(Message);
      end;
  end case;
end function;

// Opens the final response body after following bounded HTTP redirects.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function OpenStream(RequestValue: Types.Request): result of Types.StreamResponse, string;
begin
  if RequestValue.MaxHeaderBytes < 1 then
    begin
      return Error('HTTP MaxHeaderBytes must be positive');
    end;
  end if;

  if RequestValue.MaxResponseBytes < 1 then
    begin
      return Error('HTTP MaxResponseBytes must be positive');
    end;
  end if;

  if RequestValue.MaxRedirects < 0 then
    begin
      return Error('HTTP MaxRedirects must not be negative');
    end;
  end if;
  mutable var Current: Types.Request := RequestValue;
  mutable var Redirects: integer := 0;
  while true do
    begin
      case OpenOnce(Current) of
        when Ok(ResponseValue):
          begin
            if Redirect.IsStatus(ResponseValue.StatusCode) then
              begin
                case Headers2.Find(ResponseValue.Headers, 'Location') of
                  when Some(Location):
                    begin
                      if Redirects >= RequestValue.MaxRedirects then
                        begin
                          case Stream.CloseBody(ResponseValue.Body) of
                            when Ok(_):
                              begin
                                null;
                              end;
                            when Error(_):
                              begin
                                null;
                              end;
                          end case;

                          return Error('HTTP redirect count exceeds MaxRedirects');
                        end;
                      end if;
                      mutable var Next: Types.Request := Current;
                      case Redirect.NextRequest(Current, ResponseValue.StatusCode, Location) of
                        when Ok(Value):
                          begin
                            Next := Value;
                          end;
                        when Error(Message):
                          begin
                            case Stream.CloseBody(ResponseValue.Body) of
                              when Ok(_):
                                begin
                                  null;
                                end;
                              when Error(_):
                                begin
                                  null;
                                end;
                            end case;

                            return Error(Message);
                          end;
                      end case;

                      case Stream.CloseBody(ResponseValue.Body) of
                        when Ok(_):
                          begin
                            null;
                          end;
                        when Error(_):
                          begin
                            null;
                          end;
                      end case;

                      Current := Next;
                      Redirects := Redirects + 1;
                    end;
                  when None:
                    begin
                      return Ok(ResponseValue);
                    end;
                end case;
              end;
            else
              begin
                return Ok(ResponseValue);
              end;
            end if;
          end;
        when Error(Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end while;

  return Error('HTTP redirect loop ended unexpectedly');
end function;

// Sends one request, follows bounded redirects, and buffers the final body.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function Send(RequestValue: Types.Request): result of Types.Response, string;
begin
  case OpenStream(RequestValue) of
    when Ok(StreamResponseValue):
      begin
        mutable var Chunks: array of array of integer := [];
        while true do
          begin
            case Stream.ReadBody(StreamResponseValue.Body, 65536) of
              when Ok(Bytes):
                begin
                  if Arrays.Length(Bytes) = 0 then
                    begin
                      return Ok(record
                        StatusCode := StreamResponseValue.StatusCode;
                        ReasonPhrase := StreamResponseValue.ReasonPhrase;
                        Headers := StreamResponseValue.Headers;
                        Body := Io.JoinChunks(Chunks);
                      end record);
                    end;
                  end if;

                  Arrays.Push(Chunks, Bytes);
                end;
              when Error(Message):
                begin
                  case Stream.CloseBody(StreamResponseValue.Body) of
                    when Ok(_):
                      begin
                        null;
                      end;
                    when Error(_):
                      begin
                        null;
                      end;
                  end case;

                  return Error(Message);
                end;
            end case;
          end;
        end while;

        return Error('HTTP response stream ended unexpectedly');
      end;
    when Error(Message):
      begin
        return Error(Message);
      end;
  end case;
end function;

end unit;
