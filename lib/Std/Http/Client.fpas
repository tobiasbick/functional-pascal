// Buffered and streaming HTTP client orchestration.
unit Std.Http.Client;

uses
  Std.Array, Std.Http.Head, Std.Http.Headers, Std.Http.Io, Std.Http.Redirect, Std.Http.Stream,
  Std.Http.Types, Std.Http.Wire, Std.Net, Std.Net.Uri;

// Opens a TCP or verified TLS connection selected by URI scheme.
//
// Parameters:
// - `UriValue`: Parsed absolute request URI.
// - `TimeoutMillis`: Connection and TLS handshake timeout.
function OpenConnection(UriValue: Uri; TimeoutMillis: integer): result of Std.Net.Connection, string;
begin
  if UriValue.Scheme = 'http' then
  begin
    return Std.Net.Connect(UriValue.Host, UriValue.Port, TimeoutMillis)
  end;

  if UriValue.Scheme = 'https' then
  begin
    return Std.Net.ConnectTls(UriValue.Host, UriValue.Port, TimeoutMillis)
  end;

  return Error('Std.Http supports only http:// and https:// URLs')
end;

// Closes a connection while deliberately ignoring close errors.
//
// Parameters:
// - `Connection`: Connection to close.
procedure CloseQuietly(Connection: Std.Net.Connection);
begin
  case Std.Net.Close(Connection) of
    Ok(_):
    begin
    end;
    Error(_):
    begin
    end
  end
end;

// Sends one request without applying redirect policy.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
function OpenOnce(RequestValue: Request): result of StreamResponse, string;
begin
  mutable var UriValue: Uri := record
    Scheme := '';
    Host := '';
    Port := 0;
    Path := '';
  end;

  case Std.Net.Uri.Parse(RequestValue.Url) of
    Ok(Value):
    begin
      UriValue := Value
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;
  mutable var Encoded: array of integer := [];
  case Std.Http.Wire.EncodeRequest(RequestValue, UriValue) of
    Ok(Value):
    begin
      Encoded := Value
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end;

  case OpenConnection(UriValue, RequestValue.TimeoutMillis) of
    Ok(Connection):
    begin
      case Std.Net.SetTimeout(Connection, RequestValue.TimeoutMillis) of
        Ok(Configured):
        begin
          if not Configured then
          begin
            CloseQuietly(Connection);
            return Error('Network timeout configuration failed')
          end
        end;
        Error(Message):
        begin
          CloseQuietly(Connection);
          return Error(Message)
        end
      end;

      case Std.Http.Io.WriteAll(Connection, Encoded) of
        Ok(Written):
        begin
        end;
        Error(Message):
        begin
          CloseQuietly(Connection);
          return Error(Message)
        end
      end;

      case Std.Http.Head.ReadFinal(Connection, RequestValue.MaxHeaderBytes, RequestValue.MaxResponseBytes) of
        Ok(FinalHead):
        begin
          case Std.Http.Stream.CreateBody(Connection, FinalHead.InitialBody, FinalHead.Head.Headers, Std.Http.Wire.ResponseHasBody(RequestValue.Method, FinalHead.Head.StatusCode), FinalHead.BytesReceived, RequestValue.MaxResponseBytes) of
            Ok(Body):
            begin
              return Ok(record
                StatusCode := FinalHead.Head.StatusCode;
                ReasonPhrase := FinalHead.Head.ReasonPhrase;
                Headers := FinalHead.Head.Headers;
                Body := Body;
              end)
            end;
            Error(Message):
            begin
              return Error(Message)
            end
          end
        end;
        Error(Message):
        begin
          CloseQuietly(Connection);
          return Error(Message)
        end
      end
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end
end;

// Opens the final response body after following bounded HTTP redirects.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function OpenStream(RequestValue: Request): result of StreamResponse, string;
begin
  if RequestValue.MaxHeaderBytes < 1 then
  begin
    return Error('HTTP MaxHeaderBytes must be positive')
  end;

  if RequestValue.MaxResponseBytes < 1 then
  begin
    return Error('HTTP MaxResponseBytes must be positive')
  end;

  if RequestValue.MaxRedirects < 0 then
  begin
    return Error('HTTP MaxRedirects must not be negative')
  end;
  mutable var Current: Request := RequestValue;
  mutable var Redirects: integer := 0;
  while true do
  begin
    case OpenOnce(Current) of
      Ok(ResponseValue):
      begin
        if Std.Http.Redirect.IsStatus(ResponseValue.StatusCode) then
        begin
          case Std.Http.Headers.Find(ResponseValue.Headers, 'Location') of
            Some(Location):
            begin
              if Redirects >= RequestValue.MaxRedirects then
              begin
                case Std.Http.Stream.CloseBody(ResponseValue.Body) of
                  Ok(_):
                  begin
                  end;
                  Error(_):
                  begin
                  end
                end;

                return Error('HTTP redirect count exceeds MaxRedirects')
              end;
              mutable var Next: Request := Current;
              case Std.Http.Redirect.NextRequest(Current, ResponseValue.StatusCode, Location) of
                Ok(Value):
                begin
                  Next := Value
                end;
                Error(Message):
                begin
                  case Std.Http.Stream.CloseBody(ResponseValue.Body) of
                    Ok(_):
                    begin
                    end;
                    Error(_):
                    begin
                    end
                  end;

                  return Error(Message)
                end
              end;

              case Std.Http.Stream.CloseBody(ResponseValue.Body) of
                Ok(_):
                begin
                end;
                Error(_):
                begin
                end
              end;

              Current := Next;
              Redirects := Redirects + 1
            end;
            None:
            begin
              return Ok(ResponseValue)
            end
          end
        end
        else
        begin
          return Ok(ResponseValue)
        end
      end;
      Error(Message):
      begin
        return Error(Message)
      end
    end
  end;

  return Error('HTTP redirect loop ended unexpectedly')
end;

// Sends one request, follows bounded redirects, and buffers the final body.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function Send(RequestValue: Request): result of Response, string;
begin
  case OpenStream(RequestValue) of
    Ok(StreamResponseValue):
    begin
      mutable var Body: array of integer := [];
      while true do
      begin
        case Std.Http.Stream.ReadBody(StreamResponseValue.Body, 65536) of
          Ok(Bytes):
          begin
            if Std.Array.Length(Bytes) = 0 then
            begin
              return Ok(record
                StatusCode := StreamResponseValue.StatusCode;
                ReasonPhrase := StreamResponseValue.ReasonPhrase;
                Headers := StreamResponseValue.Headers;
                Body := Body;
              end)
            end;

            Body := Std.Array.Concat(Body, Bytes)
          end;
          Error(Message):
          begin
            case Std.Http.Stream.CloseBody(StreamResponseValue.Body) of
              Ok(_):
              begin
              end;
              Error(_):
              begin
              end
            end;

            return Error(Message)
          end
        end
      end;

      return Error('HTTP response stream ended unexpectedly')
    end;
    Error(Message):
    begin
      return Error(Message)
    end
  end
end;
