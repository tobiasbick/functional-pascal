// Buffered and streaming HTTP client orchestration.
unit Std.Http.Client;

uses
  Std.Http.Head as Head, Std.Http.Headers as Headers, Std.Http.Io as Io,
  Std.Http.Redirect as Redirect, Std.Http.Stream as Stream, Std.Http.Types as Types,
  Std.Http.Wire as Wire, Std.Net as Net, Std.Net.Uri as Uri;

// Opens a TCP or verified TLS connection selected by URI scheme.
//
// Parameters:
// - `UriValue`: Parsed absolute request URI.
// - `TimeoutMillis`: Connection and TLS handshake timeout.
function OpenConnection(UriValue: Uri.Uri; TimeoutMillis: integer): result of (Net.Connection, Types.HttpError);
begin
  if UriValue.Scheme = 'http' then
    begin
      return Net.Connect(
        UriValue.Host,
        UriValue.Port,
        TimeoutMillis
      ).MapError(Types.HttpError.Transport);
    end;
  end if;

  if UriValue.Scheme = 'https' then
    begin
      return Net.ConnectTls(
        UriValue.Host,
        UriValue.Port,
        TimeoutMillis
      ).MapError(Types.HttpError.Transport);
    end;
  end if;

  return Error(Types.HttpError.InvalidArgument('Scheme', 'HTTP requires an http or https URI'));
end function;

// Closes a connection while deliberately ignoring close errors.
//
// Parameters:
// - `Connection`: Connection to close.
procedure CloseQuietly(Connection: Net.Connection);
begin
  case Net.Close(Connection).MapError(Types.HttpError.Transport) of
    when Ok(_):
      begin
      end;
    when Error(_):
      begin
      end;
  end case;
end procedure;

// Sends one request without applying redirect policy.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
function OpenOnce(RequestValue: Types.Request): result of (Types.StreamResponse, Types.HttpError);
begin
  const UriValue: Uri.Uri := try Uri.Parse(RequestValue.Url).MapError(Types.HttpError.Address);
  const Encoded: array of integer := try Wire.EncodeRequest(RequestValue, UriValue);
  case OpenConnection(UriValue, RequestValue.TimeoutMillis) of
    when Ok(const Connection):
      begin
        case Net.SetTimeout(
          Connection,
          RequestValue.TimeoutMillis
        ).MapError(Types.HttpError.Transport) of
          when Ok(const Configured):
            begin
              if not Configured then
                begin
                  CloseQuietly(Connection);
                  return Error(
                    Types.HttpError.InvalidMessage('Network timeout configuration failed')
                  );
                end;
              end if;
            end;
          when Error(const Message):
            begin
              CloseQuietly(Connection);
              return Error(Message);
            end;
        end case;

        case Io.WriteAll(Connection, Encoded) of
          when Ok(const Written):
            begin
            end;
          when Error(const Message):
            begin
              CloseQuietly(Connection);
              return Error(Message);
            end;
        end case;

        case Head.ReadFinal(Connection, RequestValue.MaxHeaderBytes, RequestValue.MaxResponseBytes) of
          when Ok(const FinalHead):
            begin
              case Stream.CreateBody(
                Connection,
                FinalHead.InitialBody,
                FinalHead.Head.Headers,
                Wire.ResponseHasBody(RequestValue.Method, FinalHead.Head.StatusCode),
                FinalHead.BytesReceived,
                RequestValue.MaxResponseBytes
              ) of
                when Ok(const Body):
                  begin
                    return Ok(
                      Types.StreamResponse(
                        StatusCode := FinalHead.Head.StatusCode,
                        ReasonPhrase := FinalHead.Head.ReasonPhrase,
                        Headers := FinalHead.Head.Headers,
                        Body := Body
                      )
                    );
                  end;
                when Error(const Message):
                  begin
                    return Error(Message);
                  end;
              end case;
            end;
          when Error(const Message):
            begin
              CloseQuietly(Connection);
              return Error(Message);
            end;
        end case;
      end;
    when Error(const Message):
      begin
        return Error(Message);
      end;
  end case;
end function;

// Opens the final response body after following bounded HTTP redirects.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function OpenStream(RequestValue: Types.Request): result of (Types.StreamResponse, Types.HttpError);
begin
  if RequestValue.MaxHeaderBytes < 1 then
    begin
      return Error(
        Types.HttpError.InvalidArgument('MaxHeaderBytes', 'HTTP MaxHeaderBytes must be positive')
      );
    end;
  end if;

  if RequestValue.MaxResponseBytes < 1 then
    begin
      return Error(
        Types.HttpError.InvalidArgument(
          'MaxResponseBytes',
          'HTTP MaxResponseBytes must be positive'
        )
      );
    end;
  end if;

  if RequestValue.MaxRedirects < 0 then
    begin
      return Error(
        Types.HttpError.InvalidArgument('MaxRedirects', 'HTTP MaxRedirects must not be negative')
      );
    end;
  end if;
  var Current: Types.Request := RequestValue;
  var Redirects: integer := 0;
  while true do
    begin
      case OpenOnce(Current) of
        when Ok(const ResponseValue):
          begin
            if Redirect.IsStatus(ResponseValue.StatusCode) then
              begin
                case Headers.Find(ResponseValue.Headers, 'Location') of
                  when Some(const Location):
                    begin
                      if Redirects >= RequestValue.MaxRedirects then
                        begin
                          case Stream.CloseBody(ResponseValue.Body) of
                            when Ok(_):
                              begin
                              end;
                            when Error(_):
                              begin
                              end;
                          end case;

                          return Error(
                            Types.HttpError.RedirectFailure(
                              'HTTP redirect count exceeds MaxRedirects'
                            )
                          );
                        end;
                      end if;
                      var Next: Types.Request := Current;
                      case Redirect.NextRequest(Current, ResponseValue.StatusCode, Location) of
                        when Ok(const Value):
                          begin
                            Next := Value;
                          end;
                        when Error(const Message):
                          begin
                            case Stream.CloseBody(ResponseValue.Body) of
                              when Ok(_):
                                begin
                                end;
                              when Error(_):
                                begin
                                end;
                            end case;

                            return Error(Message);
                          end;
                      end case;

                      case Stream.CloseBody(ResponseValue.Body) of
                        when Ok(_):
                          begin
                          end;
                        when Error(_):
                          begin
                          end;
                      end case;

                      Current := Next;
                      Redirects := Redirects + 1;
                    end;
                  when None:
                    begin
                      return Ok(ResponseValue);
                    end;
                end case;
              end;
            else
              begin
                return Ok(ResponseValue);
              end;
            end if;
          end;
        when Error(const Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end while;

  return Error(Types.HttpError.RedirectFailure('HTTP redirect loop ended unexpectedly'));
end function;

// Sends one request, follows bounded redirects, and buffers the final body.
//
// Parameters:
// - `RequestValue`: Complete request and its transport limits.
public function Send(RequestValue: Types.Request): result of (Types.Response, Types.HttpError);
begin
  case OpenStream(RequestValue) of
    when Ok(const StreamResponseValue):
      begin
        var Chunks: array of array of integer := [];
        while true do
          begin
            case Stream.ReadBody(StreamResponseValue.Body, 65536) of
              when Ok(const Bytes):
                begin
                  if Bytes.Length() = 0 then
                    begin
                      return Ok(
                        Types.Response(
                          StatusCode := StreamResponseValue.StatusCode,
                          ReasonPhrase := StreamResponseValue.ReasonPhrase,
                          Headers := StreamResponseValue.Headers,
                          Body := Io.JoinChunks(Chunks)
                        )
                      );
                    end;
                  end if;

                  Chunks.PushInPlace(Bytes);
                end;
              when Error(const Message):
                begin
                  case Stream.CloseBody(StreamResponseValue.Body) of
                    when Ok(_):
                      begin
                      end;
                    when Error(_):
                      begin
                      end;
                  end case;

                  return Error(Message);
                end;
            end case;
          end;
        end while;

        return Error(Types.HttpError.UnexpectedEnd('Std.Http.Client.Send'));
      end;
    when Error(const Message):
      begin
        return Error(Message);
      end;
  end case;
end function;
end unit;
