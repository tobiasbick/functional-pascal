// Shared HTTP field validation and parsing.
unit Std.Http.Fields;

uses Std.Array, Std.Http.Method, Std.Http.Types, Std.Str;

// Reports whether an HTTP field value contains only permitted text characters.
//
// Parameters:
// - `Value`: Field value to validate.
public function IsValidValue(Value: string): boolean;
begin
  for Index: integer := 0 to Std.Str.Length(Value) - 1 do
  begin
    var Code: integer := Std.Str.Ord(Std.Str.CharAt(Value, Index));
    if ((Code < 32) and (Code <> 9)) or (Code = 127) then
    begin
      return false
    end
  end;

  return true
end;

// Parses validated HTTP fields after the first start-line in a text block.
//
// Parameters:
// - `Text`: Complete decoded message head.
// - `MessageKind`: Message label used in diagnostics.
public function Parse(Text: string; MessageKind: string): result of array of Header, string;
begin
  var Lines: array of string := Std.Str.Split(Text, #13 + #10);
  mutable var Headers: array of Header := [];
  for Index: integer := 1 to Std.Array.Length(Lines) - 1 do
  begin
    var Colon: integer := Std.Str.IndexOf(Lines[Index], ':');
    if Colon <= 0 then
    begin
      return Error((('Invalid HTTP ' + MessageKind) + ' header: ') + Lines[Index])
    end;
    var Name: string := Std.Str.Substring(Lines[Index], 0, Colon);
    var Value: string := Std.Str.Trim(Std.Str.Substring(Lines[Index], Colon + 1, (Std.Str.Length(Lines[Index]) - Colon) -
                                                                                 1));
    if not Std.Http.Method.IsValidToken(Name) then
    begin
      return Error((('Invalid HTTP ' + MessageKind) + ' header name: ') + Name)
    end;

    if not IsValidValue(Value) then
    begin
      return Error(('HTTP ' + MessageKind) + ' header contains an invalid control character')
    end;

    Std.Array.Push(Headers, Header.Create(Name, Value))
  end;

  return Ok(Headers)
end;
