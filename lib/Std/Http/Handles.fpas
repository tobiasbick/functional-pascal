// Opaque handle wrappers shared by HTTP implementation units.
unit Std.Http.Handles;

// Opaque pull-based HTTP response body.
public type BodyStream = record
  // Private index into the streaming body registry.
  Slot: integer;
end record;

// Opaque incremental Server-Sent Events decoder.
public type SseDecoder = record
  // Private index into the SSE decoder registry.
  Slot: integer;
end record;

// Creates an HTTP body handle for the streaming implementation.
//
// Parameters:
// - `Slot`: Index of the backing stream state.
public function NewBodyStream(Slot: integer): BodyStream;
begin
  return record
    Slot := Slot;
  end record;
end function;

// Returns the backing slot for an HTTP body handle.
//
// Parameters:
// - `StreamValue`: Body handle to inspect.
public function BodyStreamSlot(StreamValue: BodyStream): integer;
begin
  return StreamValue.Slot;
end function;

// Creates an SSE decoder handle for the decoder implementation.
//
// Parameters:
// - `Slot`: Index of the backing decoder state.
public function NewSseDecoder(Slot: integer): SseDecoder;
begin
  return record
    Slot := Slot;
  end record;
end function;

// Returns the backing slot for an SSE decoder handle.
//
// Parameters:
// - `Decoder`: SSE decoder handle to inspect.
public function SseDecoderSlot(Decoder: SseDecoder): integer;
begin
  return Decoder.Slot;
end function;

end unit;
