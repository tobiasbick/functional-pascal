// Bounded HTTP response-head reading and informational-response handling.
unit Std.Http.Head;

uses Std.Http.Types, Std.Http.Wire, Std.Net;

// Maximum informational responses accepted before the final response.
const MaxInterimResponses: integer := 8;

// One final response head plus bytes already read from its body.
public type FinalHead = record
  // Parsed final response metadata.
  public Head: ResponseHead;
  // Body bytes read together with the response head.
  public InitialBody: array of integer;
  // Total network bytes consumed so far.
  public BytesReceived: integer;
end record;

// Reads bounded response heads and skips supported informational responses.
//
// Parameters:
// - `Connection`: Open HTTP transport connection.
// - `MaxHeaderBytes`: Maximum size of each response head.
// - `MaxResponseBytes`: Maximum total response bytes.
public function ReadFinal(
  Connection: Std.Net.Connection;
  MaxHeaderBytes: integer;
  MaxResponseBytes: integer
): result of FinalHead, string;
begin
  var Buffer: array of integer := [];
  var BytesReceived: integer := 0;
  var InterimResponses: integer := 0;
  while true do
    begin
      var Separator: integer := Std.Http.Wire.FindSeparator(Buffer, 0);
      while Separator < 0 do
        begin
          if Buffer.Length() >= MaxHeaderBytes then
            begin
              return Error('HTTP response headers exceed MaxHeaderBytes');
            end;
          end if;
          const ResponseAvailable: integer := MaxResponseBytes - BytesReceived;
          if ResponseAvailable < 1 then
            begin
              return Error('HTTP response exceeds MaxResponseBytes');
            end;
          end if;
          var ReadMaximum: integer := MaxHeaderBytes - Buffer.Length();
          if ResponseAvailable < ReadMaximum then
            begin
              ReadMaximum := ResponseAvailable;
            end;
          end if;

          if ReadMaximum > 65536 then
            begin
              ReadMaximum := 65536;
            end;
          end if;

          case Std.Net.ReceiveBytes(Connection, ReadMaximum) of
            when Ok(Bytes):
              begin
                if Bytes.Length() = 0 then
                  begin
                    return Error('HTTP response is missing the header terminator');
                  end;
                end if;

                BytesReceived := BytesReceived + Bytes.Length();
                Buffer := Buffer.Concat(Bytes);
              end;
            when Error(Message):
              begin
                return Error(Message);
              end;
          end case;

          Separator := Std.Http.Wire.FindSeparator(Buffer, 0);
        end;
      end while;

      if Separator + 4 > MaxHeaderBytes then
        begin
          return Error('HTTP response headers exceed MaxHeaderBytes');
        end;
      end if;

      case Std.Http.Wire.ParseResponseHead(Buffer) of
        when Ok(Head):
          begin
            if (Head.StatusCode >= 100) and (Head.StatusCode < 200) then
              begin
                if Head.StatusCode = 101 then
                  begin
                    return Error('HTTP 101 Switching Protocols is not supported');
                  end;
                end if;

                InterimResponses := InterimResponses + 1;
                if InterimResponses > MaxInterimResponses then
                  begin
                    return Error('HTTP response contains too many informational responses');
                  end;
                end if;

                Buffer := Buffer.Slice(Head.BodyOffset, Buffer.Length() - Head.BodyOffset);
              end;
            else
              begin
                const Output: FinalHead := FinalHead(Head := Head, InitialBody := Buffer.Slice(Head.BodyOffset, Buffer.Length() -
                                                                                                                Head.BodyOffset), BytesReceived := BytesReceived);
                return Ok(Output);
              end;
            end if;
          end;
        when Error(Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end while;

  return Error('HTTP response head loop ended unexpectedly');
end function;
end unit;
