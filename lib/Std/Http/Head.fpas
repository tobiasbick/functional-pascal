// Bounded HTTP response-head reading and informational-response handling.
unit Std.Http.Head;

uses Std.Arrays as Arrays;
uses Std.Http.Types as Types;
uses Std.Http.Wire as Wire;
uses Std.Net as Net;

// Maximum informational responses accepted before the final response.
const MaxInterimResponses: integer := 8;

// One final response head plus bytes already read from its body.
public type FinalHead = record
  // Parsed final response metadata.
  public Head: Types.ResponseHead;
  // Body bytes read together with the response head.
  public InitialBody: array of (integer);
  // Total network bytes consumed so far.
  public BytesReceived: integer;
end record;

// Reads bounded response heads and skips supported informational responses.
//
// Parameters:
// - `Connection`: Open HTTP transport connection.
// - `MaxHeaderBytes`: Maximum size of each response head.
// - `MaxResponseBytes`: Maximum total response bytes.
public function ReadFinal(Connection: Net.Connection; MaxHeaderBytes: integer; MaxResponseBytes: integer): Result of (FinalHead, string);
begin
  mutable var Buffer: array of (integer) := [];
  mutable var BytesReceived: integer := 0;
  mutable var InterimResponses: integer := 0;
  while true do
    begin
      mutable var Separator: integer := Wire.FindSeparator(Buffer, 0);
      while Separator < 0 do
        begin
          if Arrays.Length(Buffer) >= MaxHeaderBytes then
            begin
              return Result.Error('HTTP response headers exceed MaxHeaderBytes');
            end;
          end if;
          var ResponseAvailable: integer := MaxResponseBytes - BytesReceived;
          if ResponseAvailable < 1 then
            begin
              return Result.Error('HTTP response exceeds MaxResponseBytes');
            end;
          end if;
          mutable var ReadMaximum: integer := MaxHeaderBytes - Arrays.Length(Buffer);
          if ResponseAvailable < ReadMaximum then
            begin
              ReadMaximum := ResponseAvailable;
            end;
          end if;

          if ReadMaximum > 65536 then
            begin
              ReadMaximum := 65536;
            end;
          end if;

          case Net.ReceiveBytes(Connection, ReadMaximum) of
            when Result.Ok(const Bytes):
              begin
                if Arrays.Length(Bytes) = 0 then
                  begin
                    return Result.Error('HTTP response is missing the header terminator');
                  end;
                end if;

                BytesReceived := BytesReceived + Arrays.Length(Bytes);
                Buffer := Arrays.Concat(Buffer, Bytes);
              end;
            when Result.Error(const Message):
              begin
                return Result.Error(Message);
              end;
          end case;

          Separator := Wire.FindSeparator(Buffer, 0);
        end;
      end while;

      if Separator + 4 > MaxHeaderBytes then
        begin
          return Result.Error('HTTP response headers exceed MaxHeaderBytes');
        end;
      end if;

      case Wire.ParseResponseHead(Buffer) of
        when Result.Ok(const Head):
          begin
            if (Head.StatusCode >= 100) and (Head.StatusCode < 200) then
              begin
                if Head.StatusCode = 101 then
                  begin
                    return Result.Error('HTTP 101 Switching Protocols is not supported');
                  end;
                end if;

                InterimResponses := InterimResponses + 1;
                if InterimResponses > MaxInterimResponses then
                  begin
                    return Result.Error('HTTP response contains too many informational responses');
                  end;
                end if;

                Buffer := Arrays.Slice(Buffer, Head.BodyOffset, Arrays.Length(Buffer) -
                                                                Head.BodyOffset);
              end;
            else
              begin
                var Output: FinalHead := FinalHead(Head := Head, InitialBody := Arrays.Slice(Buffer, Head.BodyOffset, Arrays.Length(Buffer) -
                                                                                                                      Head.BodyOffset), BytesReceived := BytesReceived);
                return Result.Ok(Output);
              end;
            end if;
          end;
        when Result.Error(const Message):
          begin
            return Result.Error(Message);
          end;
      end case;
    end;
  end while;

  return Result.Error('HTTP response head loop ended unexpectedly');
end function;

end unit;
