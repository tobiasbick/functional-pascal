// Bounded byte transfers for HTTP transports.
unit Std.Http.Io;

uses Std.Arrays as Arrays;
uses Std.Net as Net;

// Materializes ordered response or request fragments as one byte array.
public function JoinChunks(Chunks: array of (array of (integer))): array of (integer);
begin
  return Arrays.FlatMap(Chunks, function(Chunk: array of (integer)): array of (integer) begin
    return Chunk;
  end function);
end function;

// Reads within the remaining response budget, probing only for EOF at its boundary.
public function ReadResponseBytes(Connection: Net.Connection; Available: integer): Result of (array of (integer), string);
begin
  if Available < 0 then
    begin
      return Result.Error('HTTP response exceeds MaxResponseBytes');
    end;
  end if;
  mutable var Count: integer := Available;
  if Count > 65536 then
    begin
      Count := 65536;
    end;
  end if;

  if Count = 0 then
    begin
      Count := 1;
    end;
  end if;

  case Net.ReceiveBytes(Connection, Count) of
    when Result.Ok(const Bytes):
      begin
        if Arrays.Length(Bytes) > Available then
          begin
            return Result.Error('HTTP response exceeds MaxResponseBytes');
          end;
        end if;

        return Result.Ok(Bytes);
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;
end function;

// Writes every byte or reports when the connection stops making progress.
//
// Parameters:
// - `Connection`: Open TCP or TLS connection.
// - `Bytes`: Complete byte sequence to write.
public function WriteAll(Connection: Net.Connection; Bytes: array of (integer)): Result of (boolean, string);
begin
  mutable var Offset: integer := 0;
  while Offset < Arrays.Length(Bytes) do
    begin
      mutable var Count: integer := Arrays.Length(Bytes) - Offset;
      if Count > 1048576 then
        begin
          Count := 1048576;
        end;
      end if;
      var Remaining: array of (integer) := Arrays.Slice(Bytes, Offset, Count);
      case Net.SendBytes(Connection, Remaining) of
        when Result.Ok(const Count):
          begin
            if Count <= 0 then
              begin
                return Result.Error('Network connection stopped while writing HTTP bytes');
              end;
            end if;

            Offset := Offset + Count;
          end;
        when Result.Error(const Message):
          begin
            return Result.Error(Message);
          end;
      end case;
    end;
  end while;

  return Result.Ok(true);
end function;

end unit;
