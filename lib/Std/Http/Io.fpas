unit Std.Http.Io;

uses Std.Array, Std.Net;

// Writes every byte or reports when the connection stops making progress.
public function WriteAll(Connection: Std.Net.Connection; Bytes: array of integer): result of boolean, string;
begin
  mutable var Offset: integer := 0;
  while Offset < Std.Array.Length(Bytes) do
  begin
    mutable var Count: integer := Std.Array.Length(Bytes) - Offset;
    if Count > 1048576 then
    begin
      Count := 1048576
    end;
    var Remaining: array of integer := Std.Array.Slice(Bytes, Offset, Count);
    case Std.Net.Write(Connection, Remaining) of
      Ok(Count):
      begin
        if Count <= 0 then
        begin
          return Error('Network connection stopped while writing HTTP bytes')
        end;

        Offset := Offset + Count
      end;
      Error(Message):
      begin
        return Error(Message)
      end
    end
  end;

  return Ok(true)
end;
