// HTTP method and field-name token validation.
unit Std.Http.Method;

// Reports whether a method is a non-empty RFC 9110 token.
//
// Parameters:
// - `Method`: Method or field-name token to validate.
public function IsValidToken(Method: string): boolean;
begin
  if Method = '' then
    begin
      return false;
    end;
  end if;

  for Index: integer := 0 to Method.Length() - 1 do
    begin
      const Code: integer := Method.CharAt(Index).Ord();
      if (((Code >= 48) and (Code <= 57)) or ((Code >= 65) and (Code <= 90))) or
         ((Code >= 97) and (Code <= 122)) then
        begin
          continue;
        end;
      end if;

      case Code of
        when 33, 35, 36, 37, 38, 39, 42, 43, 45, 46, 94, 95, 96, 124, 126:
          begin
          end;
        else
          begin
            return false;
          end;
      end case;
    end;
  end for;

  return true;
end function;
end unit;
