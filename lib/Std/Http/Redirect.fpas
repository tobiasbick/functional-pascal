// Redirect URL resolution, header filtering, and method rewriting.
unit Std.Http.Redirect;

uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Http.Headers as Headers2;
uses Std.Http.Types as Types;
uses Std.Net.Uri as Uri2;
uses Std.Str as Str;

// Formats a URI authority with a non-default port when required.
//
// Parameters:
// - `UriValue`: Parsed absolute URI.
function Authority(UriValue: Uri2.Uri): string;
begin
  mutable var Host: string := UriValue.Host;
  if Str.Contains(Host, ':') then
    begin
      Host := ('[' + Host) + ']';
    end;
  end if;

  if ((UriValue.Scheme = 'http') and (UriValue.Port = 80)) or
     ((UriValue.Scheme = 'https') and (UriValue.Port = 443)) then
    begin
      return Host;
    end;
  end if;

  return (Host + ':') + Conv.IntToStr(UriValue.Port);
end function;

// Formats the scheme and authority portion of a URI.
//
// Parameters:
// - `UriValue`: Parsed absolute URI.
function Origin(UriValue: Uri2.Uri): string;
begin
  return ((UriValue.Scheme + '://') + Authority(UriValue));
end function;

// Removes a fragment from a URI reference.
//
// Parameters:
// - `Text`: URI reference that may contain a fragment.
function WithoutFragment(Text: string): string;
begin
  var Fragment: integer := Str.IndexOf(Text, '#');
  if Fragment < 0 then
    begin
      return Text;
    end;
  end if;

  return Str.Substring(Text, 0, Fragment);
end function;

// Removes the query from a path-and-query value.
//
// Parameters:
// - `Path`: URI path that may contain a query.
function PathWithoutQuery(Path: string): string;
begin
  var Query: integer := Str.IndexOf(Path, '?');
  if Query < 0 then
    begin
      return Path;
    end;
  end if;

  return Str.Substring(Path, 0, Query);
end function;

// Resolves dot segments in an absolute path while preserving its query.
//
// Parameters:
// - `PathAndQuery`: Absolute path with an optional query.
function NormalizePath(PathAndQuery: string): string;
begin
  mutable var Path: string := PathAndQuery;
  mutable var Query: string := '';
  var QueryStart: integer := Str.IndexOf(PathAndQuery, '?');
  if QueryStart >= 0 then
    begin
      Path := Str.Substring(PathAndQuery, 0, QueryStart);
      Query := Str.Substring(PathAndQuery, QueryStart, Str.Length(PathAndQuery) - QueryStart);
    end;
  end if;
  var Parts: array of string := Str.Split(Path, '/');
  mutable var Segments: array of string := [];
  // The first empty segment belongs to the absolute root. All others are significant.
  for Index: integer := 1 to Arrays.Length(Parts) - 1 do
    begin
      var Part: string := Parts[Index];
      if Part = '..' then
        begin
          if Arrays.Length(Segments) > 0 then
            begin
              Segments := Arrays.Slice(Segments, 0, Arrays.Length(Segments) - 1);
            end;
          end if;
        end;
      else
        if Part <> '.' then
          begin
            Arrays.Push(Segments, Part);
          end;
        end if;
      end if;

      if ((Part = '.') or (Part = '..')) and (Index = Arrays.Length(Parts) - 1) then
        begin
          Arrays.Push(Segments, '');
        end;
      end if;
    end;
  end for;
  var Output: string := '/' + Str.Join(Segments, '/');
  return Output + Query;
end function;

// Resolves a redirect location against an absolute base URI.
//
// Parameters:
// - `Base`: Parsed URI of the current request.
// - `Location`: Location field value from the redirect response.
function Resolve(Base: Uri2.Uri; Location: string): result of string, string;
begin
  if Headers2.ContainsUnsafeText(Location) then
    begin
      return Error('HTTP redirect Location contains CR or LF');
    end;
  end if;
  var Reference: string := WithoutFragment(Str.Trim(Location));
  mutable var Target: string := '';
  if Reference = '' then
    begin
      Target := Origin(Base) + Base.Path;
    end;
  else
    if Str.Contains(Reference, '://') then
      begin
        Target := Reference;
      end;
    else
      if Str.StartsWith(Reference, '//') then
        begin
          Target := (Base.Scheme + ':') + Reference;
        end;
      else
        if Str.StartsWith(Reference, '/') then
          begin
            Target := Origin(Base) + NormalizePath(Reference);
          end;
        else
          if Str.StartsWith(Reference, '?') then
            begin
              Target := (Origin(Base) + PathWithoutQuery(Base.Path)) + Reference;
            end;
          else
            begin
              var BasePath: string := PathWithoutQuery(Base.Path);
              var LastSlash: integer := Str.LastIndexOf(BasePath, '/');
              mutable var Directory: string := '/';
              if LastSlash >= 0 then
                begin
                  Directory := Str.Substring(BasePath, 0, LastSlash + 1);
                end;
              end if;

              Target := Origin(Base) + NormalizePath(Directory + Reference);
            end;
          end if;
        end if;
      end if;
    end if;
  end if;

  case Uri2.Parse(Target) of
    when Ok(Parsed):
      begin
        if Str.Contains(Reference, '://') or Str.StartsWith(Reference, '//') then
          begin
            return Ok(Origin(Parsed) + NormalizePath(Parsed.Path));
          end;
        end if;

        return Ok(Target);
      end;
    when Error(Message):
      begin
        return Error('Invalid HTTP redirect Location: ' + Message);
      end;
  end case;
end function;

// Reports whether two URIs have the same scheme, host, and port.
//
// Parameters:
// - `Left`: First parsed URI.
// - `Right`: Second parsed URI.
function SameOrigin(Left: Uri2.Uri; Right: Uri2.Uri): boolean;
begin
  return ((Str.ToLower(Left.Scheme) = Str.ToLower(Right.Scheme)) and (Str.ToLower(Left.Host) = Str.ToLower(Right.Host))) and
         (Left.Port = Right.Port);
end function;

// Removes sensitive or entity fields required by redirect policy.
//
// Parameters:
// - `Headers`: Current request fields.
// - `CrossOrigin`: Whether the redirect changes origin.
// - `DropBody`: Whether redirect semantics discard the request body.
function FilterHeaders(Headers: array of Types.Header; CrossOrigin: boolean; DropBody: boolean): array of Types.Header;
begin
  mutable var Output: array of Types.Header := [];
  for Index: integer := 0 to Arrays.Length(Headers) - 1 do
    begin
      var Name: string := Headers[Index].Name;
      if CrossOrigin and
         ((Headers2.IsName(Name, 'Authorization') or Headers2.IsName(Name, 'Proxy-Authorization')) or Headers2.IsName(Name, 'Cookie')) then
        begin
          continue;
        end;
      end if;

      if DropBody and
         (Headers2.IsName(Name, 'Content-Type') or Headers2.IsName(Name, 'Content-Encoding')) then
        begin
          continue;
        end;
      end if;

      Arrays.Push(Output, Headers[Index]);
    end;
  end for;

  return Output;
end function;

// Reports whether a status code uses the automatic redirect policy.
//
// Parameters:
// - `StatusCode`: HTTP response status code.
public function IsStatus(StatusCode: integer): boolean;
begin
  return (((StatusCode = 301) or (StatusCode = 302)) or (StatusCode = 303)) or
         ((StatusCode = 307) or (StatusCode = 308));
end function;

// Builds the next request from one redirect response.
//
// Parameters:
// - `Current`: Request that received the redirect response.
// - `StatusCode`: Redirect response status code.
// - `Location`: Location field value from the redirect response.
public function NextRequest(Current: Types.Request; StatusCode: integer; Location: string): result of Types.Request, string;
begin
  mutable var Base: Uri2.Uri := record
    Scheme := '';
    Host := '';
    Port := 0;
    Path := '';
  end record;

  case Uri2.Parse(Current.Url) of
    when Ok(Value):
      begin
        Base := Value;
      end;
    when Error(Message):
      begin
        return Error(Message);
      end;
  end case;
  mutable var Target: string := '';
  case Resolve(Base, Location) of
    when Ok(Value):
      begin
        Target := Value;
      end;
    when Error(Message):
      begin
        return Error(Message);
      end;
  end case;
  mutable var TargetUri: Uri2.Uri := Base;
  case Uri2.Parse(Target) of
    when Ok(Value):
      begin
        TargetUri := Value;
      end;
    when Error(Message):
      begin
        return Error(Message);
      end;
  end case;
  var DropBody: boolean := ((StatusCode = 303) and (Current.Method <> 'HEAD')) or
                           (((StatusCode = 301) or (StatusCode = 302)) and (Current.Method = 'POST'));
  mutable var Output: Types.Request := Current;
  Output.Url := Target;
  Output.Headers := FilterHeaders(Current.Headers, not SameOrigin(Base, TargetUri), DropBody);
  if DropBody then
    begin
      Output.Method := 'GET';
      Output.Body := [];
    end;
  end if;

  return Ok(Output);
end function;

end unit;
