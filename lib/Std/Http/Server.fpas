// Bounded HTTP/1.x request parsing and HTTP/1.1 response writing.
unit Std.Http.Server;

uses
  Std.Conv as Conv, Std.Http.BodyFraming as BodyFraming, Std.Http.Fields as Fields,
  Std.Http.Headers as HttpHeaders, Std.Http.Io as Io, Std.Http.Method as Method,
  Std.Http.Types as Types, Std.Http.Wire as Wire, Std.Net as Net, Std.Net.Utf8 as Utf8;

// Reads through the HTTP head terminator within a byte limit.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `Maximum`: Maximum request-head size in bytes.
function ReadHead(Connection: Net.Connection; Maximum: integer): result of (array of integer, string);
begin
  var Bytes: array of integer := [];
  while Wire.FindSeparator(Bytes, 0) < 0 do
    begin
      if Bytes.Length() >= Maximum then
        begin
          return Error('HTTP request headers exceed MaxHeaderBytes');
        end;
      end if;
      var ReadMaximum: integer := Maximum - Bytes.Length();
      if ReadMaximum > 65536 then
        begin
          ReadMaximum := 65536;
        end;
      end if;

      case Net.ReceiveBytes(Connection, ReadMaximum) of
        when Ok(const Chunk):
          begin
            if Chunk.Length() = 0 then
              begin
                return Error('HTTP request is missing the header terminator');
              end;
            end if;

            Bytes := Bytes.Concat(Chunk);
          end;
        when Error(const Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end while;

  return Ok(Bytes);
end function;

// Parses and validates an HTTP/1.0 or HTTP/1.1 request line.
//
// Parameters:
// - `Line`: Decoded request line.
function ParseRequestLine(Line: string): result of (array of string, string);
begin
  const Parts: array of string := Line.Split(' ');
  if Parts.Length() <> 3 then
    begin
      return Error('HTTP request line must contain method, target, and version');
    end;
  end if;

  if not Method.IsValidToken(Parts[0]) then
    begin
      return Error('HTTP request method must be a non-empty RFC 9110 token');
    end;
  end if;

  if ((((not Parts[1].StartsWith('/')) or HttpHeaders.ContainsUnsafeText(Parts[1])) or (#9 in Parts[1])) or ('#' in Parts[1])) or
     (not Fields.IsValidValue(Parts[1])) then
    begin
      return Error('HTTP server supports only safe origin-form request targets');
    end;
  end if;

  if (Parts[2] <> 'HTTP/1.0') and (Parts[2] <> 'HTTP/1.1') then
    begin
      return Error('HTTP server supports only HTTP/1.0 and HTTP/1.1 requests');
    end;
  end if;

  return Ok(Parts);
end function;

// Counts fields with a case-insensitive name.
//
// Parameters:
// - `Headers`: Parsed request fields.
// - `Name`: Case-insensitive field name to count.
function HeaderCount(Headers: array of Types.Header; Name: string): integer;
begin
  var Count: integer := 0;
  for Index: integer := 0 to Headers.Length() - 1 do
    begin
      if HttpHeaders.IsName(Headers[Index].Name, Name) then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

// Reads exactly one Content-Length request body.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `Initial`: Body bytes already read with the request head.
// - `Length`: Declared complete body length.
function ReadBody(Connection: Net.Connection; Initial: array of integer; Length: integer): result of (array of integer, string);
begin
  var InitialLength: integer := Initial.Length();
  if Length < InitialLength then
    begin
      InitialLength := Length;
    end;
  end if;
  var Chunks: array of array of integer := [Initial.Slice(0, InitialLength)];
  var Received: integer := InitialLength;
  while Received < Length do
    begin
      var ReadMaximum: integer := Length - Received;
      if ReadMaximum > 1048576 then
        begin
          ReadMaximum := 1048576;
        end;
      end if;

      case Net.ReceiveBytes(Connection, ReadMaximum) of
        when Ok(const Chunk):
          begin
            if Chunk.Length() = 0 then
              begin
                return Error('HTTP request body is shorter than Content-Length');
              end;
            end if;

            Chunks.PushInPlace(Chunk);
            Received := Received + Chunk.Length();
          end;
        when Error(const Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end while;

  return Ok(Io.JoinChunks(Chunks));
end function;

// Reads and validates one bounded HTTP/1.x request from a connected client.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `MaxHeaderBytes`: Maximum request-head size in bytes.
// - `MaxBodyBytes`: Maximum request-body size in bytes.
public function ReadRequest(Connection: Net.Connection; MaxHeaderBytes: integer; MaxBodyBytes: integer): result of (Types.ServerRequest, string);
begin
  if MaxHeaderBytes < 1 then
    begin
      return Error('HTTP server MaxHeaderBytes must be positive');
    end;
  end if;

  if MaxBodyBytes < 0 then
    begin
      return Error('HTTP server MaxBodyBytes must not be negative');
    end;
  end if;
  var Bytes: array of integer := [];
  case ReadHead(Connection, MaxHeaderBytes) of
    when Ok(const Value):
      begin
        Bytes := Value;
      end;
    when Error(const Message):
      begin
        return Error(Message);
      end;
  end case;
  const Separator: integer := Wire.FindSeparator(Bytes, 0);
  const HeadBytes: array of integer := Bytes.Slice(0, Separator);
  var HeadText: string := '';
  case Utf8.Decode(HeadBytes) of
    when Ok(const Value):
      begin
        HeadText := Value;
      end;
    when Error(const Message):
      begin
        return Error('HTTP request headers are not valid UTF-8: ' + Message);
      end;
  end case;
  const Lines: array of string := HeadText.Split(#13 + #10);
  if Lines.Length() = 0 then
    begin
      return Error('HTTP request line is missing');
    end;
  end if;
  var RequestLine: array of string := [];
  case ParseRequestLine(Lines[0]) of
    when Ok(const Value):
      begin
        RequestLine := Value;
      end;
    when Error(const Message):
      begin
        return Error(Message);
      end;
  end case;
  var Headers: array of Types.Header := [];
  case Fields.Parse(HeadText, 'request') of
    when Ok(const Value):
      begin
        Headers := Value;
      end;
    when Error(const Message):
      begin
        return Error(Message);
      end;
  end case;

  if (RequestLine[2] = 'HTTP/1.1') and (HeaderCount(Headers, 'Host') <> 1) then
    begin
      return Error('HTTP/1.1 request must contain exactly one Host header');
    end;
  end if;

  if RequestLine[2] = 'HTTP/1.1' then
    begin
      case HttpHeaders.Find(Headers, 'Host') of
        when Some(const Value):
          begin
            if Value.Trim() = '' then
              begin
                return Error('HTTP/1.1 Host header must not be empty');
              end;
            end if;
          end;
        when None:
          begin
          end;
      end case;
    end;
  end if;
  var BodyLength: integer := 0;
  case BodyFraming.Select(Headers) of
    when Ok(const Framing):
      begin
        if Framing.Mode = 2 then
          begin
            return Error('HTTP server does not support chunked request bodies');
          end;
        end if;

        if Framing.Mode = 1 then
          begin
            BodyLength := Framing.Remaining;
          end;
        end if;
      end;
    when Error(const Message):
      begin
        return Error(Message);
      end;
  end case;

  if BodyLength > MaxBodyBytes then
    begin
      return Error('HTTP request body exceeds MaxBodyBytes');
    end;
  end if;
  const InitialBody: array of integer := Bytes.Slice(Separator + 4, Bytes.Length() - Separator - 4);
  var Body: array of integer := [];
  case ReadBody(Connection, InitialBody, BodyLength) of
    when Ok(const Value):
      begin
        Body := Value;
      end;
    when Error(const Message):
      begin
        return Error(Message);
      end;
  end case;
  const Output: Types.ServerRequest := Types.ServerRequest(Method := RequestLine[0], Target := RequestLine[1], Headers := Headers, Body := Body);
  return Ok(Output);
end function;

// Validates and serializes one complete HTTP/1.1 response.
//
// Parameters:
// - `ResponseValue`: Complete response to encode.
function EncodeResponse(ResponseValue: Types.ServerResponse): result of (array of integer, string);
begin
  if (ResponseValue.StatusCode < 100) or (ResponseValue.StatusCode > 599) then
    begin
      return Error('HTTP response status code must be in 100..599');
    end;
  end if;

  if (not Fields.IsValidValue(ResponseValue.ReasonPhrase)) or
     HttpHeaders.ContainsUnsafeText(ResponseValue.ReasonPhrase) then
    begin
      return Error('HTTP response reason phrase contains an invalid control character');
    end;
  end if;
  var Head: string := 'HTTP/1.1 ' + Conv.IntToStr(ResponseValue.StatusCode) + ' ' + ResponseValue.ReasonPhrase + #13 +
                      #10;
  Head := Head + 'Connection: close' + #13 + #10;
  Head := Head + 'Content-Length: ' + Conv.IntToStr(ResponseValue.Body.Length()) + #13 + #10;
  for Index: integer := 0 to ResponseValue.Headers.Length() - 1 do
    begin
      const Field: Types.Header := ResponseValue.Headers[Index];
      if (not Method.IsValidToken(Field.Name)) or (not Fields.IsValidValue(Field.Value)) then
        begin
          return Error('HTTP response contains an invalid header');
        end;
      end if;

      if ((HttpHeaders.IsName(Field.Name, 'Content-Length') or HttpHeaders.IsName(Field.Name, 'Transfer-Encoding')) or HttpHeaders.IsName(Field.Name, 'Connection')) then
        begin
          return Error('Content-Length, Transfer-Encoding, and Connection are managed by Std.Http');
        end;
      end if;

      Head := Head + Field.Name + ': ' + Field.Value + #13 + #10;
    end;
  end for;

  Head := Head + #13 + #10;
  return Ok(Utf8.Encode(Head).Concat(ResponseValue.Body));
end function;

// Writes one complete HTTP/1.1 response without closing the connection.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `ResponseValue`: Complete response to serialize and write.
public function WriteResponse(Connection: Net.Connection; ResponseValue: Types.ServerResponse): result of (boolean, string);
begin
  case EncodeResponse(ResponseValue) of
    when Ok(const Bytes):
      begin
        return Io.WriteAll(Connection, Bytes);
      end;
    when Error(const Message):
      begin
        return Error(Message);
      end;
  end case;
end function;
end unit;
