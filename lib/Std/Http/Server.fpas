// Bounded HTTP/1.x request parsing and HTTP/1.1 response writing.
unit Std.Http.Server;

uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Http.BodyFraming as BodyFraming;
uses Std.Http.Fields as Fields;
uses Std.Http.Headers as Headers2;
uses Std.Http.Io as Io;
uses Std.Http.Method as Method2;
uses Std.Http.Types as Types;
uses Std.Http.Wire as Wire;
uses Std.Net as Net;
uses Std.Net.Utf8 as Utf8;
uses Std.Str as Str;

// Reads through the HTTP head terminator within a byte limit.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `Maximum`: Maximum request-head size in bytes.
function ReadHead(Connection: Net.Connection; Maximum: integer): Result of (array of (integer), string);
begin
  mutable var Bytes: array of (integer) := [];
  while Wire.FindSeparator(Bytes, 0) < 0 do
    begin
      if Arrays.Length(Bytes) >= Maximum then
        begin
          return Result.Error('HTTP request headers exceed MaxHeaderBytes');
        end;
      end if;
      mutable var ReadMaximum: integer := Maximum - Arrays.Length(Bytes);
      if ReadMaximum > 65536 then
        begin
          ReadMaximum := 65536;
        end;
      end if;

      case Net.ReceiveBytes(Connection, ReadMaximum) of
        when Result.Ok(const Chunk):
          begin
            if Arrays.Length(Chunk) = 0 then
              begin
                return Result.Error('HTTP request is missing the header terminator');
              end;
            end if;

            Bytes := Arrays.Concat(Bytes, Chunk);
          end;
        when Result.Error(const Message):
          begin
            return Result.Error(Message);
          end;
      end case;
    end;
  end while;

  return Result.Ok(Bytes);
end function;

// Parses and validates an HTTP/1.0 or HTTP/1.1 request line.
//
// Parameters:
// - `Line`: Decoded request line.
function ParseRequestLine(Line: string): Result of (array of (string), string);
begin
  var Parts: array of (string) := Str.Split(Line, ' ');
  if Arrays.Length(Parts) <> 3 then
    begin
      return Result.Error('HTTP request line must contain method, target, and version');
    end;
  end if;

  if not Method2.IsValidToken(Parts[0]) then
    begin
      return Result.Error('HTTP request method must be a non-empty RFC 9110 token');
    end;
  end if;

  if ((((not Str.StartsWith(Parts[1], '/')) or Headers2.ContainsUnsafeText(Parts[1])) or Str.Contains(Parts[1], #9)) or Str.Contains(Parts[1], '#')) or
     (not Fields.IsValidValue(Parts[1])) then
    begin
      return Result.Error('HTTP server supports only safe origin-form request targets');
    end;
  end if;

  if (Parts[2] <> 'HTTP/1.0') and (Parts[2] <> 'HTTP/1.1') then
    begin
      return Result.Error('HTTP server supports only HTTP/1.0 and HTTP/1.1 requests');
    end;
  end if;

  return Result.Ok(Parts);
end function;

// Counts fields with a case-insensitive name.
//
// Parameters:
// - `Headers`: Parsed request fields.
// - `Name`: Case-insensitive field name to count.
function HeaderCount(Headers: array of (Types.Header); Name: string): integer;
begin
  mutable var Count: integer := 0;
  for Index: integer := 0 to Arrays.Length(Headers) - 1 do
    begin
      if Headers2.IsName(Headers[Index].Name, Name) then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

// Reads exactly one Content-Length request body.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `Initial`: Body bytes already read with the request head.
// - `Length`: Declared complete body length.
function ReadBody(Connection: Net.Connection; Initial: array of (integer); Length: integer): Result of (array of (integer), string);
begin
  mutable var InitialLength: integer := Arrays.Length(Initial);
  if Length < InitialLength then
    begin
      InitialLength := Length;
    end;
  end if;
  mutable var Chunks: array of (array of (integer)) := [Arrays.Slice(Initial, 0, InitialLength)];
  mutable var Received: integer := InitialLength;
  while Received < Length do
    begin
      mutable var ReadMaximum: integer := Length - Received;
      if ReadMaximum > 1048576 then
        begin
          ReadMaximum := 1048576;
        end;
      end if;

      case Net.ReceiveBytes(Connection, ReadMaximum) of
        when Result.Ok(const Chunk):
          begin
            if Arrays.Length(Chunk) = 0 then
              begin
                return Result.Error('HTTP request body is shorter than Content-Length');
              end;
            end if;

            Arrays.Push(Chunks, Chunk);
            Received := Received + Arrays.Length(Chunk);
          end;
        when Result.Error(const Message):
          begin
            return Result.Error(Message);
          end;
      end case;
    end;
  end while;

  return Result.Ok(Io.JoinChunks(Chunks));
end function;

// Reads and validates one bounded HTTP/1.x request from a connected client.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `MaxHeaderBytes`: Maximum request-head size in bytes.
// - `MaxBodyBytes`: Maximum request-body size in bytes.
public function ReadRequest(Connection: Net.Connection; MaxHeaderBytes: integer; MaxBodyBytes: integer): Result of (Types.ServerRequest, string);
begin
  if MaxHeaderBytes < 1 then
    begin
      return Result.Error('HTTP server MaxHeaderBytes must be positive');
    end;
  end if;

  if MaxBodyBytes < 0 then
    begin
      return Result.Error('HTTP server MaxBodyBytes must not be negative');
    end;
  end if;
  mutable var Bytes: array of (integer) := [];
  case ReadHead(Connection, MaxHeaderBytes) of
    when Result.Ok(const Value):
      begin
        Bytes := Value;
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;
  var Separator: integer := Wire.FindSeparator(Bytes, 0);
  var HeadBytes: array of (integer) := Arrays.Slice(Bytes, 0, Separator);
  mutable var HeadText: string := '';
  case Utf8.Decode(HeadBytes) of
    when Result.Ok(const Value):
      begin
        HeadText := Value;
      end;
    when Result.Error(const Message):
      begin
        return Result.Error('HTTP request headers are not valid UTF-8: ' + Message);
      end;
  end case;
  var Lines: array of (string) := Str.Split(HeadText, #13 + #10);
  if Arrays.Length(Lines) = 0 then
    begin
      return Result.Error('HTTP request line is missing');
    end;
  end if;
  mutable var RequestLine: array of (string) := [];
  case ParseRequestLine(Lines[0]) of
    when Result.Ok(const Value):
      begin
        RequestLine := Value;
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;
  mutable var Headers: array of (Types.Header) := [];
  case Fields.Parse(HeadText, 'request') of
    when Result.Ok(const Value):
      begin
        Headers := Value;
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;

  if (RequestLine[2] = 'HTTP/1.1') and (HeaderCount(Headers, 'Host') <> 1) then
    begin
      return Result.Error('HTTP/1.1 request must contain exactly one Host header');
    end;
  end if;

  if RequestLine[2] = 'HTTP/1.1' then
    begin
      case Headers2.Find(Headers, 'Host') of
        when Option.Some(const Value):
          begin
            if Str.Trim(Value) = '' then
              begin
                return Result.Error('HTTP/1.1 Host header must not be empty');
              end;
            end if;
          end;
        when Option.None:
          begin
            null;
          end;
      end case;
    end;
  end if;
  mutable var BodyLength: integer := 0;
  case BodyFraming.Select(Headers) of
    when Result.Ok(const Framing):
      begin
        if Framing.Mode = 2 then
          begin
            return Result.Error('HTTP server does not support chunked request bodies');
          end;
        end if;

        if Framing.Mode = 1 then
          begin
            BodyLength := Framing.Remaining;
          end;
        end if;
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;

  if BodyLength > MaxBodyBytes then
    begin
      return Result.Error('HTTP request body exceeds MaxBodyBytes');
    end;
  end if;
  var InitialBody: array of (integer) := Arrays.Slice(Bytes, Separator + 4, (Arrays.Length(Bytes) - Separator) -
                                                                            4);
  mutable var Body: array of (integer) := [];
  case ReadBody(Connection, InitialBody, BodyLength) of
    when Result.Ok(const Value):
      begin
        Body := Value;
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;
  var Output: Types.ServerRequest := Types.ServerRequest(Method := RequestLine[0], Target := RequestLine[1], Headers := Headers, Body := Body);
  return Result.Ok(Output);
end function;

// Validates and serializes one complete HTTP/1.1 response.
//
// Parameters:
// - `ResponseValue`: Complete response to encode.
function EncodeResponse(ResponseValue: Types.ServerResponse): Result of (array of (integer), string);
begin
  if (ResponseValue.StatusCode < 100) or (ResponseValue.StatusCode > 599) then
    begin
      return Result.Error('HTTP response status code must be in 100..599');
    end;
  end if;

  if (not Fields.IsValidValue(ResponseValue.ReasonPhrase)) or
     Headers2.ContainsUnsafeText(ResponseValue.ReasonPhrase) then
    begin
      return Result.Error('HTTP response reason phrase contains an invalid control character');
    end;
  end if;
  mutable var Head: string := (((('HTTP/1.1 ' + Conv.IntToStr(ResponseValue.StatusCode)) + ' ') + ResponseValue.ReasonPhrase) + #13) +
                              #10;
  Head := ((Head + 'Connection: close') + #13) + #10;
  Head := (((Head + 'Content-Length: ') + Conv.IntToStr(Arrays.Length(ResponseValue.Body))) + #13) +
          #10;
  for Index: integer := 0 to Arrays.Length(ResponseValue.Headers) - 1 do
    begin
      var Field: Types.Header := ResponseValue.Headers[Index];
      if (not Method2.IsValidToken(Field.Name)) or (not Fields.IsValidValue(Field.Value)) then
        begin
          return Result.Error('HTTP response contains an invalid header');
        end;
      end if;

      if ((Headers2.IsName(Field.Name, 'Content-Length') or Headers2.IsName(Field.Name, 'Transfer-Encoding')) or Headers2.IsName(Field.Name, 'Connection')) then
        begin
          return Result.Error('Content-Length, Transfer-Encoding, and Connection are managed by Std.Http');
        end;
      end if;

      Head := ((((Head + Field.Name) + ': ') + Field.Value) + #13) + #10;
    end;
  end for;

  Head := (Head + #13) + #10;
  return Result.Ok(Arrays.Concat(Utf8.Encode(Head), ResponseValue.Body));
end function;

// Writes one complete HTTP/1.1 response without closing the connection.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `ResponseValue`: Complete response to serialize and write.
public function WriteResponse(Connection: Net.Connection; ResponseValue: Types.ServerResponse): Result of (boolean, string);
begin
  case EncodeResponse(ResponseValue) of
    when Result.Ok(const Bytes):
      begin
        return Io.WriteAll(Connection, Bytes);
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;
end function;

end unit;
