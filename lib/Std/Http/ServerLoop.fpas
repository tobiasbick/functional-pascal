// Bounded concurrent HTTP server-loop orchestration.
unit Std.Http.ServerLoop;

uses Std.Arrays as Arrays;
uses Std.Http.Server as Server;
uses Std.Http.Types as Types;
uses Std.Net as Net;
uses Std.Tasks as Tasks2;

// Validates all server-loop limits before accepting a connection.
//
// Parameters:
// - `Options`: Server-loop limits to validate.
function ValidateOptions(Options: Types.ServerOptions): Result of (boolean, string);
begin
  if Options.MaxHeaderBytes < 1 then
    begin
      return Result.Error('HTTP server MaxHeaderBytes must be positive');
    end;
  end if;

  if Options.MaxBodyBytes < 0 then
    begin
      return Result.Error('HTTP server MaxBodyBytes must not be negative');
    end;
  end if;

  if Options.ConnectionTimeoutMillis < 1 then
    begin
      return Result.Error('HTTP server ConnectionTimeoutMillis must be positive');
    end;
  end if;

  if Options.MaxConcurrentRequests < 1 then
    begin
      return Result.Error('HTTP server MaxConcurrentRequests must be positive');
    end;
  end if;

  if Options.MaxRequests < 0 then
    begin
      return Result.Error('HTTP server MaxRequests must not be negative');
    end;
  end if;

  return Result.Ok(true);
end function;

// Closes a connection while deliberately ignoring close errors.
//
// Parameters:
// - `Connection`: Connection to close.
procedure CloseQuietly(Connection: Net.Connection);
begin
  case Net.Close(Connection) of
    when Result.Ok(_):
      begin
        null;
      end;
    when Result.Error(_):
      begin
        null;
      end;
  end case;
end procedure;

// Attempts to write an empty 400 response without propagating failures.
//
// Parameters:
// - `Connection`: Connection that supplied a malformed request.
procedure WriteBadRequestQuietly(Connection: Net.Connection);
begin
  var ResponseValue: Types.ServerResponse := Types.ServerResponse.Create(400, 'Bad Request');
  case Server.WriteResponse(Connection, ResponseValue) of
    when Result.Ok(_):
      begin
        null;
      end;
    when Result.Error(_):
      begin
        null;
      end;
  end case;
end procedure;

// Serves and closes one accepted connection.
//
// Parameters:
// - `Connection`: Accepted TCP or TLS connection.
// - `Options`: Request and connection limits.
// - `Handler`: Callback that maps the parsed request to a response.
function ServeConnection(
  Connection: Net.Connection;
  Options: Types.ServerOptions;
  Handler: Types.RequestHandler
): boolean;
begin
  case Net.SetTimeout(Connection, Options.ConnectionTimeoutMillis) of
    when Result.Ok(_):
      begin
        null;
      end;
    when Result.Error(_):
      begin
        CloseQuietly(Connection);
        return false;
      end;
  end case;
  mutable var RequestValue: Types.ServerRequest := Types.ServerRequest(Method := '', Target := '', Headers := [], Body := []);
  case Server.ReadRequest(Connection, Options.MaxHeaderBytes, Options.MaxBodyBytes) of
    when Result.Ok(const Value):
      begin
        RequestValue := Value;
      end;
    when Result.Error(_):
      begin
        WriteBadRequestQuietly(Connection);
        CloseQuietly(Connection);
        return false;
      end;
  end case;
  var ResponseValue: Types.ServerResponse := Handler(RequestValue);
  mutable var Succeeded: boolean := false;
  case Server.WriteResponse(Connection, ResponseValue) of
    when Result.Ok(_):
      begin
        Succeeded := true;
      end;
    when Result.Error(_):
      begin
        null;
      end;
  end case;

  CloseQuietly(Connection);
  return Succeeded;
end function;

// Reports whether the current batch may accept another connection.
//
// Parameters:
// - `Options`: Server-loop concurrency and request limits.
// - `Accepted`: Total accepted connections.
// - `BatchLength`: Connections already present in the current batch.
function HasCapacity(Options: Types.ServerOptions; Accepted: integer; BatchLength: integer): boolean;
begin
  return (BatchLength < Options.MaxConcurrentRequests) and
         ((Options.MaxRequests = 0) or (Accepted < Options.MaxRequests));
end function;

// Accepts requests in bounded concurrent batches and dispatches each one to Handler.
//
// Parameters:
// - `Listener`: Open TCP or TLS listener.
// - `Options`: Request limits and server-loop bounds.
// - `Handler`: Callback that maps each accepted request to a response.
public function Serve(Listener: Net.Listener; Options: Types.ServerOptions; Handler: Types.RequestHandler): Result of (boolean, string);
begin
  case ValidateOptions(Options) of
    when Result.Ok(_):
      begin
        null;
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;
  mutable var Accepted: integer := 0;
  while (Options.MaxRequests = 0) or (Accepted < Options.MaxRequests) do
    begin
      mutable var Tasks: array of (task) := [];
      while HasCapacity(Options, Accepted, Arrays.Length(Tasks)) do
        begin
          case Net.Accept(Listener) of
            when Result.Ok(const Connection):
              begin
                Arrays.Push(Tasks, go ServeConnection(Connection, Options, Handler));
                Accepted := Accepted + 1;
              end;
            when Result.Error(const Message):
              begin
                Tasks2.WaitAll(Tasks);
                return Result.Error(Message);
              end;
          end case;
        end;
      end while;

      Tasks2.WaitAll(Tasks);
    end;
  end while;

  return Result.Ok(true);
end function;

end unit;
