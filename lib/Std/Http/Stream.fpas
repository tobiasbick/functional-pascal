// Pull-based decoded HTTP response-body streaming.
unit Std.Http.Stream;

uses Std.Arrays as Arrays;
uses Std.Http.Stream.Types as Types;
uses Std.Http.Io as Io;
uses Std.Http.BodyFraming as BodyFraming;
uses Std.Http.Handles as Handles;
uses Std.Http.Types as Types2;
uses Std.Http.Wire as Wire;
uses Std.Net as Net;
uses Std.Net.Utf8 as Utf8;

// Reserves and stores one state in the hosted HTTP registry.
function ReserveState(State: Types.StreamState): integer;
begin
  return 0;
end function;

// Tests whether one hosted body-stream state exists.
function HasState(Slot: integer): boolean;
begin
  return false;
end function;

// Loads one state from the hosted HTTP registry.
function LoadState(Slot: integer): Types.StreamState;
begin
  panic('internal HTTP stream state intrinsic was not lowered');
end function;

// Replaces one state in the hosted HTTP registry.
procedure StoreState(Slot: integer; State: Types.StreamState);
begin
  null;
end procedure;

// Resolves and validates an opaque body-stream handle.
//
// Parameters:
// - `StreamValue`: Body-stream handle to resolve.
function StateIndex(StreamValue: Types2.BodyStream): Result of (integer, string);
begin
  const Slot: integer := Handles.BodyStreamSlot(StreamValue);
  if (Slot < 1) or (not HasState(Slot)) then
    begin
      return Result.Error('HTTP body stream handle is invalid');
    end;
  end if;

  return Result.Ok(Slot);
end function;

// Closes one indexed stream state and its backing connection.
//
// Parameters:
// - `Index`: One-based stream-state slot.
procedure CloseAt(Index: integer);
begin
  var State: Types.StreamState := LoadState(Index);
  if State.Open then
    begin
      case Net.Close(State.Connection) of
        when Result.Ok(_):
          begin
            null;
          end;
        when Result.Error(_):
          begin
            null;
          end;
      end case;

      State.Open := false;
    end;
  end if;

  State.Finished := true;
  StoreState(Index, State);
end procedure;

// Reads another bounded fragment into an open stream buffer.
//
// Parameters:
// - `Index`: One-based stream-state slot.
function ReadNetwork(Index: integer): Result of (boolean, string);
begin
  var State: Types.StreamState := LoadState(Index);
  if not State.Open then
    begin
      return Result.Ok(false);
    end;
  end if;

  case Io.ReadResponseBytes(State.Connection, State.Maximum - State.BytesReceived) of
    when Result.Ok(const Bytes):
      begin
        if Arrays.Length(Bytes) = 0 then
          begin
            return Result.Ok(false);
          end;
        end if;

        State.BytesReceived := State.BytesReceived + Arrays.Length(Bytes);
        State.Buffer := Arrays.Concat(State.Buffer, Bytes);
        StoreState(Index, State);
        return Result.Ok(true);
      end;
    when Result.Error(const Message):
      begin
        CloseAt(Index);
        return Result.Error(Message);
      end;
  end case;
end function;

// Reads until the buffer contains a requested number of bytes or reaches EOF.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Count`: Required buffered byte count.
function EnsureBytes(Index: integer; Count: integer): Result of (boolean, string);
begin
  while Arrays.Length(LoadState(Index).Buffer) < Count do
    begin
      case ReadNetwork(Index) of
        when Result.Ok(const ReadMore):
          begin
            if not ReadMore then
              begin
                return Result.Ok(false);
              end;
            end if;
          end;
        when Result.Error(const Message):
          begin
            return Result.Error(Message);
          end;
      end case;
    end;
  end while;

  return Result.Ok(true);
end function;

// Removes and returns at most a requested number of buffered bytes.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Maximum`: Maximum bytes to remove.
function TakeBuffer(Index: integer; Maximum: integer): array of (integer);
begin
  var State: Types.StreamState := LoadState(Index);
  var Count: integer := Arrays.Length(State.Buffer);
  if Maximum < Count then
    begin
      Count := Maximum;
    end;
  end if;
  const Bytes: array of (integer) := Arrays.Slice(State.Buffer, 0, Count);
  State.Buffer := Arrays.Slice(State.Buffer, Count, Arrays.Length(State.Buffer) - Count);
  StoreState(Index, State);
  return Bytes;
end function;

// Reads one fragment from a fixed-length body.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Maximum`: Maximum decoded bytes to return.
function ReadFixed(Index: integer; Maximum: integer): Result of (array of (integer), string);
begin
  if LoadState(Index).Remaining = 0 then
    begin
      CloseAt(Index);
      return Result.Ok([]);
    end;
  end if;

  if Arrays.Length(LoadState(Index).Buffer) = 0 then
    begin
      case ReadNetwork(Index) of
        when Result.Ok(const ReadMore):
          begin
            if not ReadMore then
              begin
                CloseAt(Index);
                return Result.Error('HTTP response body is shorter than Content-Length');
              end;
            end if;
          end;
        when Result.Error(const Message):
          begin
            return Result.Error(Message);
          end;
      end case;
    end;
  end if;
  var Count: integer := Maximum;
  if LoadState(Index).Remaining < Count then
    begin
      Count := LoadState(Index).Remaining;
    end;
  end if;
  const Bytes: array of (integer) := TakeBuffer(Index, Count);
  var State: Types.StreamState := LoadState(Index);
  State.Remaining := State.Remaining - Arrays.Length(Bytes);
  StoreState(Index, State);
  if State.Remaining = 0 then
    begin
      CloseAt(Index);
    end;
  end if;

  return Result.Ok(Bytes);
end function;

// Reads one fragment from a connection-delimited body.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Maximum`: Maximum decoded bytes to return.
function ReadUntilClose(Index: integer; Maximum: integer): Result of (array of (integer), string);
begin
  if Arrays.Length(LoadState(Index).Buffer) = 0 then
    begin
      case ReadNetwork(Index) of
        when Result.Ok(const ReadMore):
          begin
            if not ReadMore then
              begin
                CloseAt(Index);
                return Result.Ok([]);
              end;
            end if;
          end;
        when Result.Error(const Message):
          begin
            return Result.Error(Message);
          end;
      end case;
    end;
  end if;

  return Result.Ok(TakeBuffer(Index, Maximum));
end function;

// Reads and consumes the next chunk-size line.
//
// Parameters:
// - `Index`: One-based stream-state slot.
function ReadChunkSize(Index: integer): Result of (integer, string);
begin
  var LineEnd: integer := Wire.FindLineEnd(LoadState(Index).Buffer, 0);
  while LineEnd < 0 do
    begin
      case ReadNetwork(Index) of
        when Result.Ok(const ReadMore):
          begin
            if not ReadMore then
              begin
                CloseAt(Index);
                return Result.Error('HTTP chunk size line is incomplete');
              end;
            end if;
          end;
        when Result.Error(const Message):
          begin
            return Result.Error(Message);
          end;
      end case;

      LineEnd := Wire.FindLineEnd(LoadState(Index).Buffer, 0);
    end;
  end while;
  var State: Types.StreamState := LoadState(Index);
  const LineBytes: array of (integer) := Arrays.Slice(State.Buffer, 0, LineEnd);
  State.Buffer := Arrays.Slice(State.Buffer, LineEnd + 2, (Arrays.Length(State.Buffer) - LineEnd) -
                                                          2);
  StoreState(Index, State);
  case Utf8.Decode(LineBytes) of
    when Result.Ok(const Line):
      begin
        return Wire.ParseChunkSize(Line);
      end;
    when Result.Error(const Message):
      begin
        return Result.Error('HTTP chunk size is not ASCII: ' + Message);
      end;
  end case;
end function;

// Reads one decoded fragment from a chunked body.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Maximum`: Maximum decoded bytes to return.
function ReadChunked(Index: integer; Maximum: integer): Result of (array of (integer), string);
begin
  while true do
    begin
      if LoadState(Index).ChunkRemaining > 0 then
        begin
          if Arrays.Length(LoadState(Index).Buffer) = 0 then
            begin
              case ReadNetwork(Index) of
                when Result.Ok(const ReadMore):
                  begin
                    if not ReadMore then
                      begin
                        CloseAt(Index);
                        return Result.Error('HTTP chunk body is incomplete');
                      end;
                    end if;
                  end;
                when Result.Error(const Message):
                  begin
                    return Result.Error(Message);
                  end;
              end case;
            end;
          end if;
          var Count: integer := Maximum;
          if LoadState(Index).ChunkRemaining < Count then
            begin
              Count := LoadState(Index).ChunkRemaining;
            end;
          end if;
          const Bytes: array of (integer) := TakeBuffer(Index, Count);
          var DataState: Types.StreamState := LoadState(Index);
          DataState.ChunkRemaining := DataState.ChunkRemaining - Arrays.Length(Bytes);
          if DataState.ChunkRemaining = 0 then
            begin
              DataState.NeedChunkTerminator := true;
            end;
          end if;

          StoreState(Index, DataState);
          return Result.Ok(Bytes);
        end;
      end if;

      if LoadState(Index).NeedChunkTerminator then
        begin
          case EnsureBytes(Index, 2) of
            when Result.Ok(const Complete):
              begin
                if not Complete then
                  begin
                    CloseAt(Index);
                    return Result.Error('HTTP chunk is missing its trailing CRLF');
                  end;
                end if;
              end;
            when Result.Error(const Message):
              begin
                return Result.Error(Message);
              end;
          end case;
          var TerminatorState: Types.StreamState := LoadState(Index);
          if (TerminatorState.Buffer[0] <> 13) or (TerminatorState.Buffer[1] <> 10) then
            begin
              CloseAt(Index);
              return Result.Error('HTTP chunk is missing its trailing CRLF');
            end;
          end if;

          TerminatorState.Buffer := Arrays.Slice(TerminatorState.Buffer, 2, Arrays.Length(TerminatorState.Buffer) -
                                                                            2);
          TerminatorState.NeedChunkTerminator := false;
          StoreState(Index, TerminatorState);
        end;
      end if;

      case ReadChunkSize(Index) of
        when Result.Ok(const Size):
          begin
            if Size = 0 then
              begin
                CloseAt(Index);
                return Result.Ok([]);
              end;
            end if;

            if Size > LoadState(Index).Maximum then
              begin
                CloseAt(Index);
                return Result.Error('HTTP chunk exceeds MaxResponseBytes');
              end;
            end if;
            var SizeState: Types.StreamState := LoadState(Index);
            SizeState.ChunkRemaining := Size;
            StoreState(Index, SizeState);
          end;
        when Result.Error(const Message):
          begin
            CloseAt(Index);
            return Result.Error(Message);
          end;
      end case;
    end;
  end while;

  return Result.Ok([]);
end function;

// Creates one body stream after the response head has been parsed.
//
// Parameters:
// - `Connection`: Open connection positioned after the response head.
// - `InitialBody`: Body bytes already read with the response head.
// - `Headers`: Parsed response fields used to select framing.
// - `HasBody`: Whether request method and response status permit a body.
// - `BytesReceived`: Network bytes already counted against the limit.
// - `Maximum`: Maximum total response bytes.
public function CreateBody(
  Connection: Net.Connection;
  InitialBody: array of (integer);
  Headers: array of (Types2.Header);
  HasBody: boolean;
  BytesReceived: integer;
  Maximum: integer
): Result of (Types2.BodyStream, string);
begin
  var Mode: integer := 0;
  var Remaining: integer := 0;
  if HasBody then
    begin
      case BodyFraming.Select(Headers) of
        when Result.Ok(const Value):
          begin
            Mode := Value.Mode;
            Remaining := Value.Remaining;
          end;
        when Result.Error(const Message):
          begin
            case Net.Close(Connection) of
              when Result.Ok(_):
                begin
                  null;
                end;
              when Result.Error(_):
                begin
                  null;
                end;
            end case;

            return Result.Error(Message);
          end;
      end case;
    end;
  end if;
  const State: Types.StreamState := Types.StreamState(Connection := Connection, Buffer := InitialBody, Mode := Mode, Remaining := Remaining, ChunkRemaining := 0, NeedChunkTerminator := false, BytesReceived := BytesReceived, Maximum := Maximum, Finished := false, Open := true);
  const Index: integer := ReserveState(State);
  if (not HasBody) or ((Mode = 1) and (Remaining = 0)) then
    begin
      CloseAt(Index);
    end;
  end if;

  return Result.Ok(Handles.NewBodyStream(Index));
end function;

// Reads at most MaxBytes decoded body bytes. An empty array means end of stream.
//
// Parameters:
// - `StreamValue`: Open response-body handle.
// - `MaxBytes`: Maximum decoded bytes to return.
public function ReadBody(StreamValue: Types2.BodyStream; MaxBytes: integer): Result of (array of (integer), string);
begin
  if MaxBytes < 1 then
    begin
      return Result.Error('HTTP stream MaxBytes must be positive');
    end;
  end if;

  case StateIndex(StreamValue) of
    when Result.Ok(const Index):
      begin
        if LoadState(Index).Finished then
          begin
            return Result.Ok([]);
          end;
        end if;

        if LoadState(Index).Mode = 1 then
          begin
            return ReadFixed(Index, MaxBytes);
          end;
        end if;

        if LoadState(Index).Mode = 2 then
          begin
            return ReadChunked(Index, MaxBytes);
          end;
        end if;

        return ReadUntilClose(Index, MaxBytes);
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;
end function;

// Closes a body stream before end of stream.
//
// Parameters:
// - `StreamValue`: Open response-body handle to close.
public function CloseBody(StreamValue: Types2.BodyStream): Result of (boolean, string);
begin
  case StateIndex(StreamValue) of
    when Result.Ok(const Index):
      begin
        CloseAt(Index);
        return Result.Ok(true);
      end;
    when Result.Error(const Message):
      begin
        return Result.Error(Message);
      end;
  end case;
end function;

end unit;
