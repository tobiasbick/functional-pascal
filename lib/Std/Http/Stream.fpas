// Pull-based decoded HTTP response-body streaming.
unit Std.Http.Stream;

uses
  Std.Http.Stream.Types, Std.Http.Io, Std.Http.BodyFraming, Std.Http.Handles, Std.Http.Types,
  Std.Http.Wire, Std.Net, Std.Net.Utf8;

// Reserves and stores one state in the hosted HTTP registry.
function ReserveState(State: StreamState): integer;
begin
  return 0;
end function;

// Tests whether one hosted body-stream state exists.
function HasState(Slot: integer): boolean;
begin
  return false;
end function;

// Loads one state from the hosted HTTP registry.
function LoadState(Slot: integer): StreamState;
begin
  panic('internal HTTP stream state intrinsic was not lowered');
end function;

// Replaces one state in the hosted HTTP registry.
procedure StoreState(Slot: integer; State: StreamState);
begin
end procedure;

// Resolves and validates an opaque body-stream handle.
//
// Parameters:
// - `StreamValue`: Body-stream handle to resolve.
function StateIndex(StreamValue: Std.Http.Types.BodyStream): result of integer, string;
begin
  const Slot: integer := Std.Http.Handles.BodyStreamSlot(StreamValue);
  if (Slot < 1) or (not HasState(Slot)) then
    begin
      return Error('HTTP body stream handle is invalid');
    end;
  end if;

  return Ok(Slot);
end function;

// Closes one indexed stream state and its backing connection.
//
// Parameters:
// - `Index`: One-based stream-state slot.
procedure CloseAt(Index: integer);
begin
  var State: StreamState := LoadState(Index);
  if State.Open then
    begin
      case Std.Net.Close(State.Connection) of
        when Ok(_):
          begin
          end;
        when Error(_):
          begin
          end;
      end case;

      State.Open := false;
    end;
  end if;

  State.Finished := true;
  StoreState(Index, State);
end procedure;

// Reads another bounded fragment into an open stream buffer.
//
// Parameters:
// - `Index`: One-based stream-state slot.
function ReadNetwork(Index: integer): result of boolean, string;
begin
  var State: StreamState := LoadState(Index);
  if not State.Open then
    begin
      return Ok(false);
    end;
  end if;

  case Std.Http.Io.ReadResponseBytes(State.Connection, State.Maximum - State.BytesReceived) of
    when Ok(Bytes):
      begin
        if Bytes.Length() = 0 then
          begin
            return Ok(false);
          end;
        end if;

        State.BytesReceived := State.BytesReceived + Bytes.Length();
        State.Buffer := State.Buffer.Concat(Bytes);
        StoreState(Index, State);
        return Ok(true);
      end;
    when Error(Message):
      begin
        CloseAt(Index);
        return Error(Message);
      end;
  end case;
end function;

// Reads until the buffer contains a requested number of bytes or reaches EOF.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Count`: Required buffered byte count.
function EnsureBytes(Index: integer; Count: integer): result of boolean, string;
begin
  while LoadState(Index).Buffer.Length() < Count do
    begin
      case ReadNetwork(Index) of
        when Ok(ReadMore):
          begin
            if not ReadMore then
              begin
                return Ok(false);
              end;
            end if;
          end;
        when Error(Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end while;

  return Ok(true);
end function;

// Removes and returns at most a requested number of buffered bytes.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Maximum`: Maximum bytes to remove.
function TakeBuffer(Index: integer; Maximum: integer): array of integer;
begin
  var State: StreamState := LoadState(Index);
  var Count: integer := State.Buffer.Length();
  if Maximum < Count then
    begin
      Count := Maximum;
    end;
  end if;
  const Bytes: array of integer := State.Buffer.Slice(0, Count);
  State.Buffer := State.Buffer.Slice(Count, State.Buffer.Length() - Count);
  StoreState(Index, State);
  return Bytes;
end function;

// Reads one fragment from a fixed-length body.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Maximum`: Maximum decoded bytes to return.
function ReadFixed(Index: integer; Maximum: integer): result of array of integer, string;
begin
  if LoadState(Index).Remaining = 0 then
    begin
      CloseAt(Index);
      return Ok([]);
    end;
  end if;

  if LoadState(Index).Buffer.Length() = 0 then
    begin
      case ReadNetwork(Index) of
        when Ok(ReadMore):
          begin
            if not ReadMore then
              begin
                CloseAt(Index);
                return Error('HTTP response body is shorter than Content-Length');
              end;
            end if;
          end;
        when Error(Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end if;
  var Count: integer := Maximum;
  if LoadState(Index).Remaining < Count then
    begin
      Count := LoadState(Index).Remaining;
    end;
  end if;
  const Bytes: array of integer := TakeBuffer(Index, Count);
  var State: StreamState := LoadState(Index);
  State.Remaining := State.Remaining - Bytes.Length();
  StoreState(Index, State);
  if State.Remaining = 0 then
    begin
      CloseAt(Index);
    end;
  end if;

  return Ok(Bytes);
end function;

// Reads one fragment from a connection-delimited body.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Maximum`: Maximum decoded bytes to return.
function ReadUntilClose(Index: integer; Maximum: integer): result of array of integer, string;
begin
  if LoadState(Index).Buffer.Length() = 0 then
    begin
      case ReadNetwork(Index) of
        when Ok(ReadMore):
          begin
            if not ReadMore then
              begin
                CloseAt(Index);
                return Ok([]);
              end;
            end if;
          end;
        when Error(Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end if;

  return Ok(TakeBuffer(Index, Maximum));
end function;

// Reads and consumes the next chunk-size line.
//
// Parameters:
// - `Index`: One-based stream-state slot.
function ReadChunkSize(Index: integer): result of integer, string;
begin
  var LineEnd: integer := Std.Http.Wire.FindLineEnd(LoadState(Index).Buffer, 0);
  while LineEnd < 0 do
    begin
      case ReadNetwork(Index) of
        when Ok(ReadMore):
          begin
            if not ReadMore then
              begin
                CloseAt(Index);
                return Error('HTTP chunk size line is incomplete');
              end;
            end if;
          end;
        when Error(Message):
          begin
            return Error(Message);
          end;
      end case;

      LineEnd := Std.Http.Wire.FindLineEnd(LoadState(Index).Buffer, 0);
    end;
  end while;
  var State: StreamState := LoadState(Index);
  const LineBytes: array of integer := State.Buffer.Slice(0, LineEnd);
  State.Buffer := State.Buffer.Slice(LineEnd + 2, (State.Buffer.Length() - LineEnd) - 2);
  StoreState(Index, State);
  case Std.Net.Utf8.Decode(LineBytes) of
    when Ok(Line):
      begin
        return Std.Http.Wire.ParseChunkSize(Line);
      end;
    when Error(Message):
      begin
        return Error('HTTP chunk size is not ASCII: ' + Message);
      end;
  end case;
end function;

// Reads one decoded fragment from a chunked body.
//
// Parameters:
// - `Index`: One-based stream-state slot.
// - `Maximum`: Maximum decoded bytes to return.
function ReadChunked(Index: integer; Maximum: integer): result of array of integer, string;
begin
  while true do
    begin
      if LoadState(Index).ChunkRemaining > 0 then
        begin
          if LoadState(Index).Buffer.Length() = 0 then
            begin
              case ReadNetwork(Index) of
                when Ok(ReadMore):
                  begin
                    if not ReadMore then
                      begin
                        CloseAt(Index);
                        return Error('HTTP chunk body is incomplete');
                      end;
                    end if;
                  end;
                when Error(Message):
                  begin
                    return Error(Message);
                  end;
              end case;
            end;
          end if;
          var Count: integer := Maximum;
          if LoadState(Index).ChunkRemaining < Count then
            begin
              Count := LoadState(Index).ChunkRemaining;
            end;
          end if;
          const Bytes: array of integer := TakeBuffer(Index, Count);
          var DataState: StreamState := LoadState(Index);
          DataState.ChunkRemaining := DataState.ChunkRemaining - Bytes.Length();
          if DataState.ChunkRemaining = 0 then
            begin
              DataState.NeedChunkTerminator := true;
            end;
          end if;

          StoreState(Index, DataState);
          return Ok(Bytes);
        end;
      end if;

      if LoadState(Index).NeedChunkTerminator then
        begin
          case EnsureBytes(Index, 2) of
            when Ok(Complete):
              begin
                if not Complete then
                  begin
                    CloseAt(Index);
                    return Error('HTTP chunk is missing its trailing CRLF');
                  end;
                end if;
              end;
            when Error(Message):
              begin
                return Error(Message);
              end;
          end case;
          var TerminatorState: StreamState := LoadState(Index);
          if (TerminatorState.Buffer[0] <> 13) or (TerminatorState.Buffer[1] <> 10) then
            begin
              CloseAt(Index);
              return Error('HTTP chunk is missing its trailing CRLF');
            end;
          end if;

          TerminatorState.Buffer := TerminatorState.Buffer.Slice(2, TerminatorState.Buffer.Length() -
                                                                    2);
          TerminatorState.NeedChunkTerminator := false;
          StoreState(Index, TerminatorState);
        end;
      end if;

      case ReadChunkSize(Index) of
        when Ok(Size):
          begin
            if Size = 0 then
              begin
                CloseAt(Index);
                return Ok([]);
              end;
            end if;

            if Size > LoadState(Index).Maximum then
              begin
                CloseAt(Index);
                return Error('HTTP chunk exceeds MaxResponseBytes');
              end;
            end if;
            var SizeState: StreamState := LoadState(Index);
            SizeState.ChunkRemaining := Size;
            StoreState(Index, SizeState);
          end;
        when Error(Message):
          begin
            CloseAt(Index);
            return Error(Message);
          end;
      end case;
    end;
  end while;

  return Ok([]);
end function;

// Creates one body stream after the response head has been parsed.
//
// Parameters:
// - `Connection`: Open connection positioned after the response head.
// - `InitialBody`: Body bytes already read with the response head.
// - `Headers`: Parsed response fields used to select framing.
// - `HasBody`: Whether request method and response status permit a body.
// - `BytesReceived`: Network bytes already counted against the limit.
// - `Maximum`: Maximum total response bytes.
public function CreateBody(
  Connection: Std.Net.Connection;
  InitialBody: array of integer;
  Headers: array of Header;
  HasBody: boolean;
  BytesReceived: integer;
  Maximum: integer
): result of Std.Http.Types.BodyStream, string;
begin
  var Mode: integer := 0;
  var Remaining: integer := 0;
  if HasBody then
    begin
      case Std.Http.BodyFraming.Select(Headers) of
        when Ok(Value):
          begin
            Mode := Value.Mode;
            Remaining := Value.Remaining;
          end;
        when Error(Message):
          begin
            case Std.Net.Close(Connection) of
              when Ok(_):
                begin
                end;
              when Error(_):
                begin
                end;
            end case;

            return Error(Message);
          end;
      end case;
    end;
  end if;
  const State: StreamState := record
    Connection := Connection;
    Buffer := InitialBody;
    Mode := Mode;
    Remaining := Remaining;
    ChunkRemaining := 0;
    NeedChunkTerminator := false;
    BytesReceived := BytesReceived;
    Maximum := Maximum;
    Finished := false;
    Open := true;
  end;
  const Index: integer := ReserveState(State);
  if (not HasBody) or ((Mode = 1) and (Remaining = 0)) then
    begin
      CloseAt(Index);
    end;
  end if;

  return Ok(Std.Http.Handles.NewBodyStream(Index));
end function;

// Reads at most MaxBytes decoded body bytes. An empty array means end of stream.
//
// Parameters:
// - `StreamValue`: Open response-body handle.
// - `MaxBytes`: Maximum decoded bytes to return.
public function ReadBody(StreamValue: Std.Http.Types.BodyStream; MaxBytes: integer): result of array of integer, string;
begin
  if MaxBytes < 1 then
    begin
      return Error('HTTP stream MaxBytes must be positive');
    end;
  end if;

  case StateIndex(StreamValue) of
    when Ok(Index):
      begin
        if LoadState(Index).Finished then
          begin
            return Ok([]);
          end;
        end if;

        if LoadState(Index).Mode = 1 then
          begin
            return ReadFixed(Index, MaxBytes);
          end;
        end if;

        if LoadState(Index).Mode = 2 then
          begin
            return ReadChunked(Index, MaxBytes);
          end;
        end if;

        return ReadUntilClose(Index, MaxBytes);
      end;
    when Error(Message):
      begin
        return Error(Message);
      end;
  end case;
end function;

// Closes a body stream before end of stream.
//
// Parameters:
// - `StreamValue`: Open response-body handle to close.
public function CloseBody(StreamValue: Std.Http.Types.BodyStream): result of boolean, string;
begin
  case StateIndex(StreamValue) of
    when Ok(Index):
      begin
        CloseAt(Index);
        return Ok(true);
      end;
    when Error(Message):
      begin
        return Error(Message);
      end;
  end case;
end function;
end unit;
