// Strict typed access to the fields of parsed JSON objects.
// See docs/pascal/std/text/json-fields.md.
unit Std.Json.Fields;

uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Dictionaries as Dictionaries;
uses Std.Json as Json;
uses Std.Math as Math;

// Exclusive upper and inclusive lower real bounds of the 64-bit integer range.
const IntegerUpperBound: real := 9223372036854776000.0;
const IntegerLowerBound: real := -9223372036854776000.0;

// Builds the type-mismatch error for one field.
//
// Parameters:
// - `Name`: Field name reported in the message.
// - `Expectation`: Required JSON kind, such as `a string`.
function MismatchError(Name: string; Expectation: string): string;
begin
  return (('field ' + Name) + ' must be ') + Expectation;
end function;

// Parses JSON text whose root must be an object and returns its fields.
//
// Parameters:
// - `Text`: JSON document text.
public function ParseObject(Text: string): result of dict of string to Json.JsonValue, string;
begin
  case try Json.Parse(Text) of
    when Json.JsonValue.Object(Fields):
      begin
        return Ok(Fields);
      end;
    else
      begin
        return Error('JSON root must be an object');
      end;
  end case;
end function;

// Returns one present field of any JSON kind.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function Field(Fields: dict of string to Json.JsonValue; Name: string): result of Json.JsonValue, string;
begin
  case Dictionaries.Get(Fields, Name) of
    when Some(Value):
      begin
        return Ok(Value);
      end;
    when None:
      begin
        return Error('missing field ' + Name);
      end;
  end case;
end function;

// Returns one required string field.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function StringField(Fields: dict of string to Json.JsonValue; Name: string): result of string, string;
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.String(Value):
      begin
        return Ok(Value);
      end;
    else
      begin
        return Error(MismatchError(Name, 'a string'));
      end;
  end case;
end function;

// Returns one required boolean field.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function BooleanField(Fields: dict of string to Json.JsonValue; Name: string): result of boolean, string;
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.Bool(Value):
      begin
        return Ok(Value);
      end;
    else
      begin
        return Error(MismatchError(Name, 'a boolean'));
      end;
  end case;
end function;

// Returns one required number field as a real value.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function NumberField(Fields: dict of string to Json.JsonValue; Name: string): result of real, string;
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.Number(Value):
      begin
        return Ok(Value);
      end;
    else
      begin
        return Error(MismatchError(Name, 'a number'));
      end;
  end case;
end function;

// Returns one required number field that holds an exact integer in the 64-bit range.
// Fractional or out-of-range numbers return `Error` instead of raising a runtime error.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function IntegerField(Fields: dict of string to Json.JsonValue; Name: string): result of integer, string;
begin
  var Value: real := try NumberField(Fields, Name);
  if (Value < IntegerLowerBound) or (Value >= IntegerUpperBound) then
    begin
      return Error(('field ' + Name) + ' is outside the integer range');
    end;
  end if;
  var IntegerValue: integer := Math.Trunc(Value);
  if Conv.IntToReal(IntegerValue) <> Value then
    begin
      return Error(MismatchError(Name, 'an integer'));
    end;
  end if;

  return Ok(IntegerValue);
end function;

// Returns one required nested object field.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function ObjectField(Fields: dict of string to Json.JsonValue; Name: string): result of dict of string to Json.JsonValue, string;
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.Object(Value):
      begin
        return Ok(Value);
      end;
    else
      begin
        return Error(MismatchError(Name, 'an object'));
      end;
  end case;
end function;

// Returns one required array field without checking element kinds.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function ArrayField(Fields: dict of string to Json.JsonValue; Name: string): result of array of Json.JsonValue, string;
begin
  case try Field(Fields, Name) of
    when Json.JsonValue.ArrayValue(Items):
      begin
        return Ok(Items);
      end;
    else
      begin
        return Error(MismatchError(Name, 'an array'));
      end;
  end case;
end function;

// Returns one required array field whose elements must all be strings.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function StringArrayField(Fields: dict of string to Json.JsonValue; Name: string): result of array of string, string;
begin
  mutable var Values: array of string := [];
  for Item: Json.JsonValue in try ArrayField(Fields, Name) do
    begin
      case Item of
        when Json.JsonValue.String(Value):
          begin
            Arrays.Push(Values, Value);
          end;
        else
          begin
            return Error(MismatchError(Name, 'an array of strings'));
          end;
      end case;
    end;
  end for;

  return Ok(Values);
end function;

// Rejects the first field whose name is not listed in `Allowed`; missing fields are not checked.
//
// Parameters:
// - `Fields`: Object fields.
// - `Allowed`: Every permitted field name.
public function RequireOnlyFields(Fields: dict of string to Json.JsonValue; Allowed: array of string): result of boolean, string;
begin
  for Name: string in Dictionaries.Keys(Fields) do
    begin
      if not Arrays.Contains(Allowed, Name) then
        begin
          return Error('unexpected field ' + Name);
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;

end unit;
