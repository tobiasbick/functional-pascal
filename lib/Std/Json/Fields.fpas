// Strict typed access to the fields of parsed JSON objects.
// See docs/pascal/std/text/json-fields.md.
unit Std.Json.Fields;

uses Std.Conv, Std.Json, Std.Math;

// Exclusive upper and inclusive lower real bounds of the 64-bit integer range.
const IntegerUpperBound: real := 9223372036854776000.0;
const IntegerLowerBound: real := -9223372036854776000.0;

// Builds the type-mismatch error for one field.
//
// Parameters:
// - `Name`: Field name reported in the message.
// - `Expectation`: Required JSON kind, such as `a string`.
function MismatchError(Name: string; Expectation: string): string;
begin
  return 'field ' + Name + ' must be ' + Expectation;
end function;

// Parses JSON text whose root must be an object and returns its fields.
//
// Parameters:
// - `Text`: JSON document text.
public function ParseObject(Text: string): result of (dict of string to JsonValue, string);
begin
  if try Std.Json.Parse(Text) is JsonValue.Object(const Fields) then
    begin
      return Ok(Fields);
    end;
  else
    begin
      return Error('JSON root must be an object');
    end;
  end if;
end function;

// Returns one present field of any JSON kind.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function Field(Fields: dict of string to JsonValue; Name: string): result of (JsonValue, string);
begin
  case Fields.Get(Name) of
    when Some(const Value):
      begin
        return Ok(Value);
      end;
    when None:
      begin
        return Error('missing field ' + Name);
      end;
  end case;
end function;

// Returns one required string field.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function StringField(Fields: dict of string to JsonValue; Name: string): result of (string, string);
begin
  if try Field(Fields, Name) is JsonValue.String(const Value) then
    begin
      return Ok(Value);
    end;
  else
    begin
      return Error(MismatchError(Name, 'a string'));
    end;
  end if;
end function;

// Returns one required boolean field.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function BooleanField(Fields: dict of string to JsonValue; Name: string): result of (boolean, string);
begin
  if try Field(Fields, Name) is JsonValue.Bool(const Value) then
    begin
      return Ok(Value);
    end;
  else
    begin
      return Error(MismatchError(Name, 'a boolean'));
    end;
  end if;
end function;

// Returns one required number field as a real value.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function NumberField(Fields: dict of string to JsonValue; Name: string): result of (real, string);
begin
  if try Field(Fields, Name) is JsonValue.Number(const Value) then
    begin
      return Ok(Value);
    end;
  else
    begin
      return Error(MismatchError(Name, 'a number'));
    end;
  end if;
end function;

// Returns one required number field that holds an exact integer in the 64-bit range.
// Fractional or out-of-range numbers return `Error` instead of raising a runtime error.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function IntegerField(Fields: dict of string to JsonValue; Name: string): result of (integer, string);
begin
  const Value: real := try NumberField(Fields, Name);
  if (Value < IntegerLowerBound) or (Value >= IntegerUpperBound) then
    begin
      return Error('field ' + Name + ' is outside the integer range');
    end;
  end if;
  const IntegerValue: integer := Trunc(Value);
  if Std.Conv.IntToReal(IntegerValue) <> Value then
    begin
      return Error(MismatchError(Name, 'an integer'));
    end;
  end if;

  return Ok(IntegerValue);
end function;

// Returns one required nested object field.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function ObjectField(Fields: dict of string to JsonValue; Name: string): result of (dict of string to JsonValue, string);
begin
  if try Field(Fields, Name) is JsonValue.Object(const Value) then
    begin
      return Ok(Value);
    end;
  else
    begin
      return Error(MismatchError(Name, 'an object'));
    end;
  end if;
end function;

// Returns one required array field without checking element kinds.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function ArrayField(Fields: dict of string to JsonValue; Name: string): result of (array of JsonValue, string);
begin
  if try Field(Fields, Name) is JsonValue.ArrayValue(const Items) then
    begin
      return Ok(Items);
    end;
  else
    begin
      return Error(MismatchError(Name, 'an array'));
    end;
  end if;
end function;

// Returns one required array field whose elements must all be strings.
//
// Parameters:
// - `Fields`: Object fields.
// - `Name`: Required field name.
public function StringArrayField(Fields: dict of string to JsonValue; Name: string): result of (array of string, string);
begin
  var Values: array of string := [];
  for Item: JsonValue in try ArrayField(Fields, Name) do
    begin
      if Item is JsonValue.String(const Value) then
        begin
          Values.Push(Value);
        end;
      else
        begin
          return Error(MismatchError(Name, 'an array of strings'));
        end;
      end if;
    end;
  end for;

  return Ok(Values);
end function;

// Rejects the first field whose name is not listed in `Allowed`; missing fields are not checked.
//
// Parameters:
// - `Fields`: Object fields.
// - `Allowed`: Every permitted field name.
public function RequireOnlyFields(Fields: dict of string to JsonValue; Allowed: array of string): result of (boolean, string);
begin
  for Name: string in Fields.Keys() do
    begin
      if not Allowed.Contains(Name) then
        begin
          return Error('unexpected field ' + Name);
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;
end unit;
