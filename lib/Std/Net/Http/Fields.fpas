// Shared HTTP field validation and parsing.
unit Std.Net.Http.Fields;

uses Std.Net.Http.Method as Method, Std.Net.Http.Types as Types;

// Reports whether an HTTP field value contains only permitted text characters.
//
// Parameters:
// - `Value`: Field value to validate.
public function IsValidValue(Value: string): boolean;
begin
  for Index: integer := 0 to Value.Length() - 1 do
    begin
      const Code: integer := Value[Index].Ord();
      if ((Code < 32) and (Code <> 9)) or (Code = 127) then
        begin
          return false;
        end;
      end if;
    end;
  end for;

  return true;
end function;

function TrimOptionalWhitespace(Value: string): string;
begin
  var First: integer := 0;
  var Last: integer := Value.Length();
  while First < Last do
    const Character: string := Value[First];
    if (Character <> ' ') and (Character <> #9) then
      break;
    end if;

    First := First + 1;
  end while;

  while Last > First do
    const Character: string := Value[Last - 1];
    if (Character <> ' ') and (Character <> #9) then
      break;
    end if;

    Last := Last - 1;
  end while;

  return Value.Slice(First, Last - First);
end function;

// Parses validated HTTP fields after the first start-line in a text block.
//
// Parameters:
// - `Text`: Complete decoded message head.
// - `MessageKind`: Message label used in diagnostics.
public function Parse(Text: string; MessageKind: string): result of (array of Types.Header, Types.HttpError);
begin
  const Lines: array of string := Text.Split(#13 + #10);
  var Headers: array of Types.Header := [];
  for Index: integer := 1 to Lines.Length() - 1 do
    begin
      const Delimiter := Lines[Index].IndexOf(':');
      case Delimiter of
        when None:
          return Error(
            Types.HttpError.InvalidMessage(
              'Invalid HTTP ' + MessageKind + ' header: ' + Lines[Index]
            )
          );
        when Some(const Colon):
          if Colon = 0 then
            return Error(
              Types.HttpError.InvalidMessage(
                'Invalid HTTP ' + MessageKind + ' header: ' + Lines[Index]
              )
            );
          end if;
          const Name: string := (Lines[Index]).Slice(0, Colon);
          const Value: string := (Lines[Index]).Slice(Colon + 1, Lines[Index].Length() - Colon - 1);
          if not Method.IsValidToken(Name) then
            begin
              return Error(
                Types.HttpError.InvalidMessage(
                  'Invalid HTTP ' + MessageKind + ' header name: ' + Name
                )
              );
            end;
          end if;

          if not IsValidValue(Value) then
            begin
              return Error(
                Types.HttpError.InvalidMessage(
                  'HTTP ' + MessageKind + ' header contains an invalid control character'
                )
              );
            end;
          end if;

          Headers.PushInPlace(Types.Header.Create(Name, TrimOptionalWhitespace(Value)));
      end case;
    end;
  end for;

  return Ok(Headers);
end function;
end unit;
