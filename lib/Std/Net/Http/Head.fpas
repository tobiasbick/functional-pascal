// Bounded HTTP response-head reading and informational-response handling.
unit Std.Net.Http.Head;

uses Std.Bytes as ByteStorage, Std.Net.Http.Types as Types, Std.Net.Http.Wire as Wire, Std.Net.Sockets as Net;

// Maximum informational responses accepted before the final response.
const MaxInterimResponses: integer := 8;

// One final response head plus bytes already read from its body.
public type FinalHead = record
  // Parsed final response metadata.
  public Head: Types.ResponseHead;
  // Body bytes read together with the response head.
  public InitialBody: ByteStorage.ByteBuffer;
  // Total network bytes consumed so far.
  public BytesReceived: integer;
end record;

// Reads bounded response heads and skips supported informational responses.
//
// Parameters:
// - `Connection`: Open HTTP transport connection.
// - `MaxHeaderBytes`: Maximum size of each response head.
// - `MaxResponseBytes`: Maximum total response bytes.
public function ReadFinal(Connection: Net.Connection; MaxHeaderBytes: integer; MaxResponseBytes: integer): result of (FinalHead, Types.HttpError);
begin
  var Buffer: ByteStorage.ByteBuffer := ByteStorage.Create(0).Unwrap();
  var BytesReceived: integer := 0;
  var InterimResponses: integer := 0;
  while true do
    begin
      var Separator: integer := Wire.FindSeparator(Buffer, 0);
      while Separator < 0 do
        begin
          if Buffer.Length() >= MaxHeaderBytes then
            begin
              return Error(
                Types.HttpError.LimitExceeded('Std.Net.Http.Head.ReadFinal', MaxHeaderBytes)
              );
            end;
          end if;
          const ResponseAvailable: integer := MaxResponseBytes - BytesReceived;
          if ResponseAvailable < 1 then
            begin
              return Error(
                Types.HttpError.LimitExceeded('Std.Net.Http.Head.ReadFinal', MaxResponseBytes)
              );
            end;
          end if;
          var ReadMaximum: integer := MaxHeaderBytes - Buffer.Length();
          if ResponseAvailable < ReadMaximum then
            begin
              ReadMaximum := ResponseAvailable;
            end;
          end if;

          if ReadMaximum > 65536 then
            begin
              ReadMaximum := 65536;
            end;
          end if;

          case Net.ReceiveBytes(Connection, ReadMaximum).MapError(Types.HttpError.Transport) of
            when Ok(const Bytes):
              begin
                if Bytes.Length() = 0 then
                  begin
                    return Error(Types.HttpError.UnexpectedEnd('Std.Net.Http.Head.ReadFinal'));
                  end;
                end if;

                BytesReceived := BytesReceived + Bytes.Length();
                Buffer := (try Buffer.Concat(Bytes).MapError(Types.HttpError.Buffer));
              end;
            when Error(const Message):
              begin
                return Error(Message);
              end;
          end case;

          Separator := Wire.FindSeparator(Buffer, 0);
        end;
      end while;

      if Separator + 4 > MaxHeaderBytes then
        begin
          return Error(
            Types.HttpError.LimitExceeded('Std.Net.Http.Head.ReadFinal', MaxHeaderBytes)
          );
        end;
      end if;

      case Wire.ParseResponseHead(Buffer) of
        when Ok(const Head):
          begin
            if (Head.StatusCode >= 100) and (Head.StatusCode < 200) then
              begin
                if Head.StatusCode = 101 then
                  begin
                    return Error(
                      Types.HttpError.InvalidMessage(
                        'HTTP 101 Switching Protocols is not supported'
                      )
                    );
                  end;
                end if;

                InterimResponses := InterimResponses + 1;
                if InterimResponses > MaxInterimResponses then
                  begin
                    return Error(
                      Types.HttpError.LimitExceeded(
                        'Std.Net.Http.Head.ReadFinal',
                        MaxInterimResponses
                      )
                    );
                  end;
                end if;

                Buffer := (
                  try Buffer.Slice(
                    Head.BodyOffset,
                    Buffer.Length() - Head.BodyOffset
                  ).MapError(Types.HttpError.Buffer)
                );
              end;
            else
              begin
                const Output: FinalHead := FinalHead(
                  Head := Head, InitialBody := (
                    try Buffer.Slice(
                      Head.BodyOffset, Buffer.Length() -
                      Head.BodyOffset
                    ).MapError(Types.HttpError.Buffer)
                  ), BytesReceived := BytesReceived
                );
                return Ok(Output);
              end;
            end if;
          end;
        when Error(const Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end while;

  return Error(Types.HttpError.InvalidMessage('HTTP response head loop ended unexpectedly'));
end function;
end unit;
