// Bounded byte transfers for HTTP transports.
unit Std.Net.Http.Io;

uses Std.Bytes as ByteStorage, Std.Net.Sockets as Net, Std.Net.Http.Types as Types;

// The native implementation allocates the combined storage only once.
function JoinBuffers(Chunks: array of ByteStorage.ByteBuffer): result of (ByteStorage.ByteBuffer, ByteStorage.BufferError);
begin
  panic('HTTP buffer materialization intrinsic was not lowered');
end function;

// Materializes ordered response or request fragments as one managed byte value.
public function JoinChunks(Chunks: array of ByteStorage.ByteBuffer): result of (ByteStorage.ByteBuffer, Types.HttpError);
begin
  return JoinBuffers(Chunks).MapError(Types.HttpError.Buffer);
end function;

// Reads within the remaining response budget, probing only for EOF at its boundary.
public function ReadResponseBytes(Connection: Net.Connection; Available: integer): result of (ByteStorage.ByteBuffer, Types.HttpError);
begin
  if Available < 0 then
    begin
      return Error(
        Types.HttpError.InvalidArgument(
          'Available',
          'Remaining response budget must not be negative'
        )
      );
    end;
  end if;
  var Count: integer := Available;
  if Count > 65536 then
    begin
      Count := 65536;
    end;
  end if;

  if Count = 0 then
    begin
      Count := 1;
    end;
  end if;

  case Net.ReceiveBytes(Connection, Count).MapError(Types.HttpError.Transport) of
    when Ok(const Bytes):
      begin
        if Bytes.Length() > Available then
          begin
            return Error(
              Types.HttpError.LimitExceeded('Std.Net.Http.Io.ReadResponseBytes', Available)
            );
          end;
        end if;

        return Ok(Bytes);
      end;
    when Error(const Message):
      begin
        return Error(Message);
      end;
  end case;
end function;

// Writes every byte or reports when the connection stops making progress.
//
// Parameters:
// - `Connection`: Open TCP or TLS connection.
// - `Bytes`: Complete byte sequence to write.
public function WriteAll(Connection: Net.Connection; Bytes: ByteStorage.ByteBuffer): result of (boolean, Types.HttpError);
begin
  var Offset: integer := 0;
  while Offset < Bytes.Length() do
    begin
      var Count: integer := Bytes.Length() - Offset;
      if Count > 1048576 then
        begin
          Count := 1048576;
        end;
      end if;
      const Remaining: ByteStorage.ByteBuffer := try Bytes.Slice(
        Offset,
        Count
      ).MapError(Types.HttpError.Buffer);
      case Net.SendBytes(Connection, Remaining).MapError(Types.HttpError.Transport) of
        when Ok(const Count):
          begin
            if Count <= 0 then
              begin
                return Error(Types.HttpError.UnexpectedEnd('Std.Net.Http.Io.WriteAll'));
              end;
            end if;

            Offset := Offset + Count;
          end;
        when Error(const Message):
          begin
            return Error(Message);
          end;
      end case;
    end;
  end while;

  return Ok(true);
end function;
end unit;
