// Absolute HTTP and HTTPS URI parsing for network clients.
unit Std.Net.Uri;

uses Std.Net.Decimal;

// Parsed absolute network URI used by protocol clients.
public type Uri = record
  // Lowercase URI scheme.
  public Scheme: string;
  // Host name or unbracketed IPv6 address.
  public Host: string;
  // Explicit or scheme-default TCP port.
  public Port: integer;
  // Origin-form path including an optional query.
  public Path: string;
end record;

// Returns the default port for a supported URI scheme.
//
// Parameters:
// - `Scheme`: Lowercase URI scheme.
function DefaultPort(Scheme: string): result of integer, string;
begin
  if Scheme = 'http' then
    begin
      return Ok(80);
    end;
  end if;

  if Scheme = 'https' then
    begin
      return Ok(443);
    end;
  end if;

  return Error('Unsupported URI scheme: ' + Scheme);
end function;

// Parses and validates a decimal TCP port.
//
// Parameters:
// - `Text`: Decimal port text.
function ParsePort(Text: string): result of integer, string;
begin
  case Std.Net.Decimal.Parse(Text, 65535) of
    when Ok(Port):
      begin
        if (Port >= 1) and (Port <= 65535) then
          begin
            return Ok(Port);
          end;
        end if;

        return Error('URI port must be in 1..65535');
      end;
    when Error(Message):
      begin
        return Error('Invalid URI port: ' + Message);
      end;
  end case;
end function;

// Parses one authority and constructs the final URI value.
//
// Parameters:
// - `Scheme`: Lowercase supported URI scheme.
// - `Authority`: Host and optional port text.
// - `Path`: Origin-form path including an optional query.
function BuildUri(Scheme: string; Authority: string; Path: string): result of Uri, string;
begin
  if Authority = '' then
    begin
      return Error('URI host must not be empty');
    end;
  end if;

  if Authority.Contains('@') then
    begin
      return Error('URI user information is not supported');
    end;
  end if;
  const SchemePort: integer := try DefaultPort(Scheme);
  var HasPort: boolean := false;
  var Host: string := Authority;
  var PortText: string := '';
  if Authority.StartsWith('[') then
    begin
      const Closing: integer := Authority.IndexOf(']');
      if Closing < 0 then
        begin
          return Error('IPv6 URI host is missing closing bracket');
        end;
      end if;

      Host := Authority.Slice(1, Closing - 1);
      const Remainder: string := Authority.Slice(Closing + 1, (Authority.Length() - Closing) - 1);
      if Remainder <> '' then
        begin
          if not Remainder.StartsWith(':') then
            begin
              return Error('Unexpected text after IPv6 URI host');
            end;
          end if;

          HasPort := true;
          PortText := Remainder.Slice(1, Remainder.Length() - 1);
        end;
      end if;
    end;
  else
    begin
      const Colon: integer := Authority.LastIndexOf(':');
      if Colon >= 0 then
        begin
          Host := Authority.Slice(0, Colon);
          HasPort := true;
          PortText := Authority.Slice(Colon + 1, (Authority.Length() - Colon) - 1);
        end;
      end if;
    end;
  end if;

  if Host = '' then
    begin
      return Error('URI host must not be empty');
    end;
  end if;
  var Port: integer := SchemePort;
  if HasPort then
    begin
      Port := try ParsePort(PortText);
    end;
  end if;

  return Ok(Uri(Scheme := Scheme, Host := Host, Port := Port, Path := Path));
end function;

// Parses an absolute HTTP or HTTPS URI.
//
// Parameters:
// - `Text`: Absolute URI text to parse.
public function Parse(Text: string): result of Uri, string;
begin
  const SchemeEnd: integer := Text.IndexOf('://');
  if SchemeEnd <= 0 then
    begin
      return Error('URI must be absolute and include ://');
    end;
  end if;
  const Scheme: string := Text.Slice(0, SchemeEnd).ToLower();
  var Rest: string := Text.Slice(SchemeEnd + 3, (Text.Length() - SchemeEnd) - 3);
  const FragmentStart: integer := Rest.IndexOf('#');
  if FragmentStart >= 0 then
    begin
      Rest := Rest.Slice(0, FragmentStart);
    end;
  end if;
  var PathStart: integer := Rest.IndexOf('/');
  const QueryStart: integer := Rest.IndexOf('?');
  if (PathStart < 0) or ((QueryStart >= 0) and (QueryStart < PathStart)) then
    begin
      PathStart := QueryStart;
    end;
  end if;
  var Authority: string := Rest;
  var Path: string := '/';
  if PathStart >= 0 then
    begin
      Authority := Rest.Slice(0, PathStart);
      Path := Rest.Slice(PathStart, Rest.Length() - PathStart);
      if Path.StartsWith('?') then
        begin
          Path := '/' + Path;
        end;
      end if;
    end;
  end if;

  return BuildUri(Scheme, Authority, Path);
end function;
end unit;
