// Absolute HTTP URI parsing and bounded URL component/query helpers.
//
// Handbook: `docs/pascal/std/network/uri.md`.
unit Std.Net.Uri;

uses
  Std.Net.Decimal as Decimal, Std.Net.Uri.Components as Components,
  Std.Net.Uri.Percent as Percent, Std.Net.Uri.Queries as Queries;

// Structured address failures preserve the parser's existing grammar.
public type UriError = error
  InvalidSyntax(Detail: string) = 'Invalid URI';
  UnsupportedScheme(Scheme: string) = 'Invalid URI';
  InvalidPort(Detail: string) = 'Invalid URI';
end error;

// One ordered query entry; None is a flag and Some('') an explicit empty value.
public type QueryParam = Components.QueryParam;

// Component failures retain original percent offsets and typed UTF-8 causes.
public type ComponentError = Components.ComponentError;

// Parsed absolute network URI used by protocol clients.
public type Uri = record
  // Lowercase URI scheme.
  public Scheme: string;
  // Host name or unbracketed IPv6 address.
  public Host: string;
  // Explicit or scheme-default TCP port.
  public Port: integer;
  // Origin-form path including an optional query.
  public Path: string;
end record;

// Returns the default port for a supported URI scheme.
//
// Parameters:
// - `Scheme`: Lowercase URI scheme.
function DefaultPort(Scheme: string): result of (integer, UriError);
begin
  if Scheme = 'http' then
    begin
      return Ok(80);
    end;
  end if;

  if Scheme = 'https' then
    begin
      return Ok(443);
    end;
  end if;

  return Error(UriError.UnsupportedScheme(Scheme));
end function;

// Parses and validates a decimal TCP port.
//
// Parameters:
// - `Text`: Decimal port text.
function ParsePort(Text: string): result of (integer, UriError);
begin
  case Decimal.Parse(Text, 65535) of
    when Ok(const Port):
      begin
        if (Port >= 1) and (Port <= 65535) then
          begin
            return Ok(Port);
          end;
        end if;

        return Error(UriError.InvalidPort('URI port must be in 1..65535'));
      end;
    when Error(const Message):
      begin
        return Error(UriError.InvalidPort('Invalid URI port: ' + Message));
      end;
  end case;
end function;

// Parses one authority and constructs the final URI value.
//
// Parameters:
// - `Scheme`: Lowercase supported URI scheme.
// - `Authority`: Host and optional port text.
// - `Path`: Origin-form path including an optional query.
function BuildUri(Scheme: string; Authority: string; Path: string): result of (Uri, UriError);
begin
  if Authority = '' then
    begin
      return Error(UriError.InvalidSyntax('URI host must not be empty'));
    end;
  end if;

  if ('@' in Authority) then
    begin
      return Error(UriError.InvalidSyntax('URI user information is not supported'));
    end;
  end if;
  const SchemePort: integer := try DefaultPort(Scheme);
  var HasPort: boolean := false;
  var Host: string := Authority;
  var PortText: string := '';
  if Authority.StartsWith('[') then
    begin
      const ClosingBracket := Authority.IndexOf(']');
      case ClosingBracket of
        when None:
          return Error(UriError.InvalidSyntax('IPv6 URI host is missing closing bracket'));
        when Some(const Closing):
          Host := Authority.Slice(1, Closing - 1);
          const Remainder: string := Authority.Slice(Closing + 1, Authority.Length() - Closing - 1);
          if Remainder <> '' then
            begin
              if not Remainder.StartsWith(':') then
                begin
                  return Error(UriError.InvalidSyntax('Unexpected text after IPv6 URI host'));
                end;
              end if;

              HasPort := true;
              PortText := Remainder.Slice(1, Remainder.Length() - 1);
            end;
          end if;
      end case;
    end;
  else
    begin
      case Authority.LastIndexOf(':') of
        when Some(const Colon):
          Host := Authority.Slice(0, Colon);
          HasPort := true;
          PortText := Authority.Slice(Colon + 1, Authority.Length() - Colon - 1);
        when None:
          null;
      end case;
    end;
  end if;

  if Host = '' then
    begin
      return Error(UriError.InvalidSyntax('URI host must not be empty'));
    end;
  end if;
  var Port: integer := SchemePort;
  if HasPort then
    begin
      Port := try ParsePort(PortText);
    end;
  end if;

  return Ok(Uri(Scheme := Scheme, Host := Host, Port := Port, Path := Path));
end function;

// Parses an absolute HTTP or HTTPS URI.
//
// Parameters:
// - `Text`: Absolute URI text to parse.
public function Parse(Text: string): result of (Uri, UriError);
begin
  const SchemeDelimiter := Text.IndexOf('://');
  case SchemeDelimiter of
    when None:
      return Error(UriError.InvalidSyntax('URI must be absolute and include ://'));
    when Some(const SchemeEnd):
      if SchemeEnd = 0 then
        return Error(UriError.InvalidSyntax('URI must be absolute and include ://'));
      end if;
      const Scheme: string := Text.Slice(0, SchemeEnd).ToLower();
      var Rest: string := Text.Slice(SchemeEnd + 3, Text.Length() - SchemeEnd - 3);
      case Rest.IndexOf('#') of
        when Some(const FragmentStart):
          Rest := Rest.Slice(0, FragmentStart);
        when None:
          null;
      end case;
      var PathPosition := Rest.IndexOf('/');
      case Rest.IndexOf('?') of
        when Some(const QueryStart):
          case PathPosition of
            when Some(const PathStart):
              if QueryStart < PathStart then
                PathPosition := Some(QueryStart);
              end if;
            when None:
              PathPosition := Some(QueryStart);
          end case;
        when None:
          null;
      end case;
      var Authority: string := Rest;
      var Path: string := '/';
      case PathPosition of
        when Some(const PathStart):
          Authority := Rest.Slice(0, PathStart);
          Path := Rest.Slice(PathStart, Rest.Length() - PathStart);
          if Path.StartsWith('?') then
            begin
              Path := '/' + Path;
            end;
          end if;
        when None:
          null;
      end case;

      return BuildUri(Scheme, Authority, Path);
  end case;
end function;

// Encodes one path segment using uppercase UTF-8 escapes; slash becomes %2F.
//
// Parameters:
// - `Text`: Decoded segment text.
public function EncodePathSegment(Text: string): result of (string, ComponentError);
begin
  return Percent.Encode(Text);
end function;

// Decodes one percent-encoded segment, preserving a literal plus sign.
//
// Parameters:
// - `Text`: Component text, with strict percent escapes and UTF-8 validation.
public function DecodePathSegment(Text: string): result of (string, ComponentError);
begin
  return Percent.Decode(Text);
end function;

// Encodes one query name or value; space becomes %20 and plus becomes %2B.
//
// Parameters:
// - `Text`: Decoded query-component text.
public function EncodeQueryComponent(Text: string): result of (string, ComponentError);
begin
  return Percent.Encode(Text);
end function;

// Decodes one query name or value once, keeping a literal plus sign.
//
// Parameters:
// - `Text`: Component text, with strict percent escapes and UTF-8 validation.
public function DecodeQueryComponent(Text: string): result of (string, ComponentError);
begin
  return Percent.Decode(Text);
end function;

// Parses a query body into ordered entries, preserving duplicate names and flags.
//
// Parameters:
// - `Text`: Query body without a leading question mark; empty ampersand fields are ignored.
public function ParseQuery(Text: string): result of (array of QueryParam, ComponentError);
begin
  return Queries.Parse(Text);
end function;

// Builds a canonical query body from ordered entries, without a leading question mark.
//
// Parameters:
// - `Parameters`: Names and optional values; empty flag names are not representable.
public function BuildQuery(Parameters: array of QueryParam): result of (string, ComponentError);
begin
  return Queries.Build(Parameters);
end function;
end unit;
