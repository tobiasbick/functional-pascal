// Strict native conversion between FPAS strings and managed UTF-8 bytes.
//
// Handbook: `docs/pascal/std/network/utf8.md`.
unit Std.Text.Utf8;

uses Std.Bytes as ByteStorage;

// Offsets identify the zero-based start of the first invalid or incomplete sequence.
public type Utf8Error = error
  InvalidByte(Offset: integer; Detail: string) = 'Invalid UTF-8';
  IncompleteSequence(Offset: integer) = 'Invalid UTF-8';
  AllocationFailed(RequestedBytes: integer) = 'UTF-8 string allocation failed';
end error;

function EncodeBytes(Text: string): result of (ByteStorage.ByteBuffer, ByteStorage.BufferError);
begin
  panic('UTF-8 encode intrinsic was not lowered');
end function;

function DecodeBytes(Bytes: ByteStorage.ByteBuffer): result of (string, Utf8Error);
begin
  panic('UTF-8 decode intrinsic was not lowered');
end function;

// Internal bulk append; encoding does not create an intermediate buffer.
function AppendText(Buffer: ByteStorage.ByteBuffer; Text: string): result of (ByteStorage.ByteBuffer, ByteStorage.BufferError);
begin
  panic('UTF-8 append intrinsic was not lowered');
end function;

// Encodes text into an exact-capacity byte value in one native pass.
//
// Parameters:
// - `Text`: Text whose UTF-8 bytes are preserved, including NUL and BOM.
public function Encode(Text: string): result of (ByteStorage.ByteBuffer, ByteStorage.BufferError);
begin
  return EncodeBytes(Text);
end function;

// Strictly decodes bytes without replacement, normalization or BOM removal.
//
// Parameters:
// - `Bytes`: Arbitrary bytes to validate as UTF-8.
public function Decode(Bytes: ByteStorage.ByteBuffer): result of (string, Utf8Error);
begin
  return DecodeBytes(Bytes);
end function;

// Appends encoded text, committing the caller's buffer only on success.
//
// Parameters:
// - `Buffer`: Writable byte storage; errors preserve its value and capacity.
// - `Text`: Text appended in its original UTF-8 representation.
public function AppendInPlace(var Buffer: ByteStorage.ByteBuffer; Text: string): result of (boolean, ByteStorage.BufferError);
begin
  const Updated := try AppendText(Buffer, Text);
  Buffer := Updated;
  return Ok(true);
end function;
end unit;
