// Strict bounded calendar text and canonical UTC presentation.
//
// Handbook: `docs/pascal/std/host/calendar.md`.
unit Std.Time.Calendar.Text;

uses Std.Time.Calendar.Values as Values;

type DateFields = record
  Year: integer;
  Month: integer;
  Day: integer;
end record;

function IsDigit(Character: string): boolean;
begin
  return Character >= '0' and Character <= '9';
end function;

function Number(Text: string; Start: integer; Count: integer): result of (integer, Values.CalendarError);
begin
  var Value := 0;
  for Index: integer := Start to Start + Count - 1 do
    if Index >= Text.Length() then
      return Error(Values.CalendarError.InvalidSyntax(Index, 'Expected an ASCII digit'));
    end if;
    const Character := Text[Index];
    if not IsDigit(Character) then
      return Error(Values.CalendarError.InvalidSyntax(Index, 'Expected an ASCII digit'));
    end if;

    Value := Value * 10 + Character.Ord() - 48;
  end for;

  return Ok(Value);
end function;

function Expect(Text: string; Index: integer; Character: string): result of (boolean, Values.CalendarError);
begin
  if Index >= Text.Length() then
    return Error(Values.CalendarError.InvalidSyntax(Index, 'Expected a date or time separator'));
  end if;

  if Text[Index] <> Character then
    return Error(Values.CalendarError.InvalidSyntax(Index, 'Expected a date or time separator'));
  end if;

  return Ok(true);
end function;

function ReadDate(Text: string): result of (DateFields, Values.CalendarError);
begin
  const Year := try Number(Text, 0, 4);
  discard try Expect(Text, 4, '-');
  const Month := try Number(Text, 5, 2);
  discard try Expect(Text, 7, '-');
  const Day := try Number(Text, 8, 2);
  return Ok(DateFields(Year := Year, Month := Month, Day := Day));
end function;

function ReadOffset(Text: string; Start: integer): result of (integer, Values.CalendarError);
begin
  if Start >= Text.Length() then
    return Error(Values.CalendarError.InvalidSyntax(Start, 'A UTC offset is required'));
  end if;
  const Sign := Text[Start];
  if Sign = 'Z' or Sign = 'z' then
    if Start + 1 <> Text.Length() then
      return Error(
        Values.CalendarError.InvalidSyntax(Start + 1, 'Unexpected text after the UTC designator')
      );
    end if;

    return Ok(0);
  end if;

  if Sign <> '+' and Sign <> '-' then
    return Error(Values.CalendarError.InvalidSyntax(Start, 'Expected Z or a signed UTC offset'));
  end if;
  const Hour := try Number(Text, Start + 1, 2);
  discard try Expect(Text, Start + 3, ':');
  const Minute := try Number(Text, Start + 4, 2);
  if Start + 6 <> Text.Length() then
    return Error(
      Values.CalendarError.InvalidSyntax(Start + 6, 'Unexpected text after the UTC offset')
    );
  end if;

  if (Hour > 23) or (Minute > 59) or ((Sign = '-') and (Hour = 0) and (Minute = 0)) then
    return Error(Values.CalendarError.InvalidOffset(Text.Slice(Start, 6)));
  end if;
  const Minutes := Hour * 60 + Minute;
  if Sign = '-' then
    return Ok(- Minutes);
  end if;

  return Ok(Minutes);
end function;

// Parse exactly four year digits and two digits for month and day.
public function ParseDate(Text: string): result of (Values.Date, Values.CalendarError);
begin
  if Text.Length() > 10 then
    return Error(
      Values.CalendarError.InvalidSyntax(10, 'Expected YYYY-MM-DD without trailing text')
    );
  end if;
  const Date := try ReadDate(Text);
  return Values.CreateDate(Date.Year, Date.Month, Date.Day);
end function;

// Parse millisecond-precision RFC 3339 and normalize the signed offset to UTC.
public function ParseDateTime(Text: string): result of (Values.DateTime, Values.CalendarError);
begin
  if Text.Length() > 29 then
    return Error(
      Values.CalendarError.InvalidSyntax(29, 'Date-time text exceeds the maximum length')
    );
  end if;
  const Date := try ReadDate(Text);
  if Text.Length() <= 10 then
    return Error(Values.CalendarError.InvalidSyntax(10, 'Expected T before the time'));
  end if;

  if Text[10] <> 'T' and Text[10] <> 't' then
    return Error(Values.CalendarError.InvalidSyntax(10, 'Expected T before the time'));
  end if;
  const Hour := try Number(Text, 11, 2);
  discard try Expect(Text, 13, ':');
  const Minute := try Number(Text, 14, 2);
  discard try Expect(Text, 16, ':');
  const Second := try Number(Text, 17, 2);
  var Index := 19;
  var Millisecond := 0;
  if Index < Text.Length() and Text[Index] = '.' then
    Index := Index + 1;
    var Digits := 0;
    while Index < Text.Length() do
      if not IsDigit(Text[Index]) then
        break;
      end if;

      if Digits = 3 then
        return Error(
          Values.CalendarError.InvalidSyntax(
            Index,
            'At most three fractional digits are supported'
          )
        );
      end if;

      Millisecond := Millisecond * 10 + Text[Index].Ord() - 48;
      Digits := Digits + 1;
      Index := Index + 1;
    end while;

    if Digits = 0 then
      return Error(Values.CalendarError.InvalidSyntax(Index, 'Expected a fractional ASCII digit'));
    end if;

    while Digits < 3 do
      Millisecond := Millisecond * 10;
      Digits := Digits + 1;
    end while;
  end if;
  const Offset := try ReadOffset(Text, Index);
  const Local := try Values.CreateDateTime(
    Date.Year, Date.Month, Date.Day, Hour, Minute, Second, Millisecond
  );
  const Timestamp := Values.ToTimestampMillis(Local) - Offset * 60000;
  case Values.FromTimestampMillis(Timestamp) of
    when Ok(const Utc):
      return Ok(Utc);
    when Error(_):
      return Error(Values.CalendarError.OutOfRange('Std.Time.Calendar.ParseDateTime'));
  end case;
end function;

// Canonical calendar dates always use ten ASCII characters.
public function FormatDate(Value: Values.Date): string;
begin
  return '%04d-%02d-%02d'.Format(Value.Year(), Value.Month(), Value.Day());
end function;

// Canonical date-times always include three fractional digits and the UTC suffix.
public function FormatDateTime(Value: Values.DateTime): string;
begin
  return '%sT%02d:%02d:%02d.%03dZ'.Format(
    FormatDate(Value.ToDate()), Value.Hour(), Value.Minute(), Value.Second(), Value.Millisecond()
  );
end function;
end unit;
