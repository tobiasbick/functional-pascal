// Strict typed access to the keys of parsed TOML tables.
//
// Handbook: `docs/pascal/std/text/toml-fields.md`.
unit Std.Toml.Fields;

uses Std.Toml as Toml;

// Structured failures of strict TOML field access.
public type FieldError = error
  ParseFailure(Cause: Toml.TomlError) = 'Invalid TOML field';
  ExpectedTable = 'Invalid TOML field';
  MissingField(Name: string) = 'Invalid TOML field';
  WrongType(Name: string; Expected: string) = 'Invalid TOML field';
  InvalidValue(Name: string; Reason: string) = 'Invalid TOML field';
  UnknownField(Name: string) = 'Invalid TOML field';
end error;

// Parses one TOML document and returns its root table.
//
// Parameters:
// - `Text`: TOML document text.
public function ParseTable(Text: string): result of (dict of string to Toml.TomlValue, FieldError);
begin
  case try Toml.Parse(Text).MapError(FieldError.ParseFailure) of
    when Toml.TomlValue.Table(const Fields):
      begin
        return Ok(Fields);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
      begin
        return Error(FieldError.ExpectedTable);
      end;
  end case;
end function;

// Returns one present key of any TOML kind.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function Field(Fields: dict of string to Toml.TomlValue; Name: string): result of (Toml.TomlValue, FieldError);
begin
  case Fields.Get(Name) of
    when Some(const Value):
      begin
        return Ok(Value);
      end;
    when None:
      begin
        return Error(FieldError.MissingField(Name));
      end;
  end case;
end function;

// Returns one required string key.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function StringField(Fields: dict of string to Toml.TomlValue; Name: string): result of (string, FieldError);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.String(const Value):
      begin
        return Ok(Value);
      end;
    when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
      begin
        return Error(FieldError.WrongType(Name, 'a string'));
      end;
  end case;
end function;

// Returns one required integer key; floats are rejected.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function IntegerField(Fields: dict of string to Toml.TomlValue; Name: string): result of (integer, FieldError);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.Integer(const Value):
      begin
        return Ok(Value);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
      begin
        return Error(FieldError.WrongType(Name, 'an integer'));
      end;
  end case;
end function;

// Returns one required float key; integers are rejected.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function FloatField(Fields: dict of string to Toml.TomlValue; Name: string): result of (real, FieldError);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.Float(const Value):
      begin
        return Ok(Value);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
      begin
        return Error(FieldError.WrongType(Name, 'a float'));
      end;
  end case;
end function;

// Returns one required boolean key.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function BooleanField(Fields: dict of string to Toml.TomlValue; Name: string): result of (boolean, FieldError);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.Boolean(const Value):
      begin
        return Ok(Value);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
      begin
        return Error(FieldError.WrongType(Name, 'a boolean'));
      end;
  end case;
end function;

// Returns one required nested table key.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function TableField(Fields: dict of string to Toml.TomlValue; Name: string): result of (dict of string to Toml.TomlValue, FieldError);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.Table(const Value):
      begin
        return Ok(Value);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
      begin
        return Error(FieldError.WrongType(Name, 'a table'));
      end;
  end case;
end function;

// Returns one required array key without checking element kinds.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function ArrayField(Fields: dict of string to Toml.TomlValue; Name: string): result of (array of Toml.TomlValue, FieldError);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.ArrayValue(const Items):
      begin
        return Ok(Items);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.Table(_):
      begin
        return Error(FieldError.WrongType(Name, 'an array'));
      end;
  end case;
end function;

// Returns one required array key whose elements must all be strings.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function StringArrayField(Fields: dict of string to Toml.TomlValue; Name: string): result of (array of string, FieldError);
begin
  var Values: array of string := [];
  for Item: Toml.TomlValue in try ArrayField(Fields, Name) do
    begin
      case Item of
        when Toml.TomlValue.String(const Value):
          begin
            Values.PushInPlace(Value);
          end;
        when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
          begin
            return Error(FieldError.WrongType(Name, 'an array of strings'));
          end;
      end case;
    end;
  end for;

  return Ok(Values);
end function;

// Rejects the first key whose name is not listed in `Allowed`; missing keys are not checked.
//
// Parameters:
// - `Fields`: Table entries.
// - `Allowed`: Every permitted key name.
public function RequireOnlyFields(Fields: dict of string to Toml.TomlValue; Allowed: array of string): result of (boolean, FieldError);
begin
  for Name: string in Fields.Keys() do
    begin
      if not (Name in Allowed) then
        begin
          return Error(FieldError.UnknownField(Name));
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;
end unit;
