// Strict typed access to the keys of parsed TOML tables.
// See docs/pascal/std/text/toml-fields.md.
unit Std.Toml.Fields;

uses Std.Toml;

// Builds the type-mismatch error for one key.
//
// Parameters:
// - `Name`: Key name reported in the message.
// - `Expectation`: Required TOML kind, such as `a string`.
function MismatchError(Name: string; Expectation: string): string;
begin
  return (('field ' + Name) + ' must be ') + Expectation;
end function;

// Parses one TOML document and returns its root table.
//
// Parameters:
// - `Text`: TOML document text.
public function ParseTable(Text: string): result of dict of string to TomlValue, string;
begin
  if try Std.Toml.Parse(Text) is TomlValue.Table(const Fields) then
    begin
      return Ok(Fields);
    end;
  else
    begin
      return Error('TOML root must be a table');
    end;
  end if;
end function;

// Returns one present key of any TOML kind.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function Field(Fields: dict of string to TomlValue; Name: string): result of TomlValue, string;
begin
  case Fields.Get(Name) of
    when Some(const Value):
      begin
        return Ok(Value);
      end;
    when None:
      begin
        return Error('missing field ' + Name);
      end;
  end case;
end function;

// Returns one required string key.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function StringField(Fields: dict of string to TomlValue; Name: string): result of string, string;
begin
  if try Field(Fields, Name) is TomlValue.String(const Value) then
    begin
      return Ok(Value);
    end;
  else
    begin
      return Error(MismatchError(Name, 'a string'));
    end;
  end if;
end function;

// Returns one required integer key; floats are rejected.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function IntegerField(Fields: dict of string to TomlValue; Name: string): result of integer, string;
begin
  if try Field(Fields, Name) is TomlValue.Integer(const Value) then
    begin
      return Ok(Value);
    end;
  else
    begin
      return Error(MismatchError(Name, 'an integer'));
    end;
  end if;
end function;

// Returns one required float key; integers are rejected.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function FloatField(Fields: dict of string to TomlValue; Name: string): result of real, string;
begin
  if try Field(Fields, Name) is TomlValue.Float(const Value) then
    begin
      return Ok(Value);
    end;
  else
    begin
      return Error(MismatchError(Name, 'a float'));
    end;
  end if;
end function;

// Returns one required boolean key.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function BooleanField(Fields: dict of string to TomlValue; Name: string): result of boolean, string;
begin
  if try Field(Fields, Name) is TomlValue.Boolean(const Value) then
    begin
      return Ok(Value);
    end;
  else
    begin
      return Error(MismatchError(Name, 'a boolean'));
    end;
  end if;
end function;

// Returns one required nested table key.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function TableField(Fields: dict of string to TomlValue; Name: string): result of dict of string to TomlValue, string;
begin
  if try Field(Fields, Name) is TomlValue.Table(const Value) then
    begin
      return Ok(Value);
    end;
  else
    begin
      return Error(MismatchError(Name, 'a table'));
    end;
  end if;
end function;

// Returns one required array key without checking element kinds.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function ArrayField(Fields: dict of string to TomlValue; Name: string): result of array of TomlValue, string;
begin
  if try Field(Fields, Name) is TomlValue.ArrayValue(const Items) then
    begin
      return Ok(Items);
    end;
  else
    begin
      return Error(MismatchError(Name, 'an array'));
    end;
  end if;
end function;

// Returns one required array key whose elements must all be strings.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function StringArrayField(Fields: dict of string to TomlValue; Name: string): result of array of string, string;
begin
  var Values: array of string := [];
  for Item: TomlValue in try ArrayField(Fields, Name) do
    begin
      if Item is TomlValue.String(const Value) then
        begin
          Values.Push(Value);
        end;
      else
        begin
          return Error(MismatchError(Name, 'an array of strings'));
        end;
      end if;
    end;
  end for;

  return Ok(Values);
end function;

// Rejects the first key whose name is not listed in `Allowed`; missing keys are not checked.
//
// Parameters:
// - `Fields`: Table entries.
// - `Allowed`: Every permitted key name.
public function RequireOnlyFields(Fields: dict of string to TomlValue; Allowed: array of string): result of boolean, string;
begin
  for Name: string in Fields.Keys() do
    begin
      if not Allowed.Contains(Name) then
        begin
          return Error('unexpected field ' + Name);
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;
end unit;
