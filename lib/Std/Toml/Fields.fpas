// Strict typed access to the keys of parsed TOML tables.
// See docs/pascal/std/text/toml-fields.md.
unit Std.Toml.Fields;

uses Std.Arrays as Arrays;
uses Std.Dictionaries as Dictionaries;
uses Std.Toml as Toml;

// Builds the type-mismatch error for one key.
//
// Parameters:
// - `Name`: Key name reported in the message.
// - `Expectation`: Required TOML kind, such as `a string`.
function MismatchError(Name: string; Expectation: string): string;
begin
  return (('field ' + Name) + ' must be ') + Expectation;
end function;

// Parses one TOML document and returns its root table.
//
// Parameters:
// - `Text`: TOML document text.
public function ParseTable(Text: string): Result of (dict of (string, Toml.TomlValue), string);
begin
  case try Toml.Parse(Text) of
    when Toml.TomlValue.Table(const Fields):
      begin
        return Result.Ok(Fields);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
      begin
        begin
          return Result.Error('TOML root must be a table');
        end;
      end;
  end case;
end function;

// Returns one present key of any TOML kind.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function Field(Fields: dict of (string, Toml.TomlValue); Name: string): Result of (Toml.TomlValue, string);
begin
  case Dictionaries.Get(Fields, Name) of
    when Option.Some(const Value):
      begin
        return Result.Ok(Value);
      end;
    when Option.None:
      begin
        return Result.Error('missing field ' + Name);
      end;
  end case;
end function;

// Returns one required string key.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function StringField(Fields: dict of (string, Toml.TomlValue); Name: string): Result of (string, string);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.String(const Value):
      begin
        return Result.Ok(Value);
      end;
    when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
      begin
        begin
          return Result.Error(MismatchError(Name, 'a string'));
        end;
      end;
  end case;
end function;

// Returns one required integer key; floats are rejected.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function IntegerField(Fields: dict of (string, Toml.TomlValue); Name: string): Result of (integer, string);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.Integer(const Value):
      begin
        return Result.Ok(Value);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
      begin
        begin
          return Result.Error(MismatchError(Name, 'an integer'));
        end;
      end;
  end case;
end function;

// Returns one required float key; integers are rejected.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function FloatField(Fields: dict of (string, Toml.TomlValue); Name: string): Result of (real, string);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.Float(const Value):
      begin
        return Result.Ok(Value);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
      begin
        begin
          return Result.Error(MismatchError(Name, 'a float'));
        end;
      end;
  end case;
end function;

// Returns one required boolean key.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function BooleanField(Fields: dict of (string, Toml.TomlValue); Name: string): Result of (boolean, string);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.Boolean(const Value):
      begin
        return Result.Ok(Value);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
      begin
        begin
          return Result.Error(MismatchError(Name, 'a boolean'));
        end;
      end;
  end case;
end function;

// Returns one required nested table key.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function TableField(Fields: dict of (string, Toml.TomlValue); Name: string): Result of (dict of (string, Toml.TomlValue), string);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.Table(const Value):
      begin
        return Result.Ok(Value);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
      begin
        begin
          return Result.Error(MismatchError(Name, 'a table'));
        end;
      end;
  end case;
end function;

// Returns one required array key without checking element kinds.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function ArrayField(Fields: dict of (string, Toml.TomlValue); Name: string): Result of (array of (Toml.TomlValue), string);
begin
  case try Field(Fields, Name) of
    when Toml.TomlValue.ArrayValue(const Items):
      begin
        return Result.Ok(Items);
      end;
    when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.Table(_):
      begin
        begin
          return Result.Error(MismatchError(Name, 'an array'));
        end;
      end;
  end case;
end function;

// Returns one required array key whose elements must all be strings.
//
// Parameters:
// - `Fields`: Table entries.
// - `Name`: Required key name.
public function StringArrayField(Fields: dict of (string, Toml.TomlValue); Name: string): Result of (array of (string), string);
begin
  mutable var Values: array of (string) := [];
  for Item: Toml.TomlValue in try ArrayField(Fields, Name) do
    begin
      case Item of
        when Toml.TomlValue.String(const Value):
          begin
            Arrays.Push(Values, Value);
          end;
        when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
          begin
            begin
              return Result.Error(MismatchError(Name, 'an array of strings'));
            end;
          end;
      end case;
    end;
  end for;

  return Result.Ok(Values);
end function;

// Rejects the first key whose name is not listed in `Allowed`; missing keys are not checked.
//
// Parameters:
// - `Fields`: Table entries.
// - `Allowed`: Every permitted key name.
public function RequireOnlyFields(Fields: dict of (string, Toml.TomlValue); Allowed: array of (string)): Result of (boolean, string);
begin
  for Name: string in Dictionaries.Keys(Fields) do
    begin
      if not Arrays.Contains(Allowed, Name) then
        begin
          return Result.Error('unexpected field ' + Name);
        end;
      end if;
    end;
  end for;

  return Result.Ok(true);
end function;

end unit;
