unit Std.Tui;

uses Std.Console as Console;
uses Std.Tui.Cells.ButtonPalette as ButtonPalette;
uses Std.Tui.Cells.Cell as Cell;
uses Std.Tui.Cells.Color as Color;
uses Std.Tui.Cells.InputPalette as InputPalette;
uses Std.Tui.Cells.Palette as Palette;
uses Std.Tui.Cells.Style as Style;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Chrome.Button as Button;
uses Std.Tui.Chrome.CellGrid as CellGrid;
uses Std.Tui.Chrome.Gauge as Gauge;
uses Std.Tui.Chrome.Input as Input;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Geometry.Size as Size;
uses Std.Tui.Chrome.KeyGesture as KeyGesture;
uses Std.Tui.Chrome.MenuItem as MenuItem;
uses Std.Tui.Chrome.MenuNode as MenuNode;
uses Std.Tui.Chrome.StatusItem as StatusItem;
uses Std.Tui.Ids.Action as Action2;
uses Std.Tui.Ids.ControlId as ControlId;
uses Std.Tui.Layout.Alignment as Alignment;
uses Std.Tui.Layout.LayoutFit as LayoutFit;
uses Std.Tui.Layout.LayoutSettings as LayoutSettings;
uses Std.Tui.Layout.Margins as Margins;
uses Std.Tui.Layout.Measure as Measure;
uses Std.Tui.Layout.MeasureConstraint as MeasureConstraint;
uses Std.Tui.Layout.MeasureResult as MeasureResult;
uses Std.Tui.Layout.MeasureSpec as MeasureSpec;
uses Std.Tui.Layout.SizePolicy as SizePolicy;
uses Std.Tui.Layout.Spacer as Spacer;
uses Std.Tui.Rendering.Canvas as Canvas;
uses Std.Tui.Rendering.Paint as Paint;
uses Std.Tui.Rendering.Surface as Surface2;
uses Std.Tui.Runtime.Application as Application;
uses Std.Tui.Runtime.Application.Background as Background;
uses Std.Tui.Runtime.Cmd as Cmd;
uses Std.Tui.Runtime.Helpers as Helpers;
uses Std.Tui.Runtime.Msg as Msg;
uses Std.Tui.Runtime.PointerEvent as PointerEvent;

// Zero-based terminal-cell coordinate.
public type TuiPoint = Point.TuiPoint;

// Fixed terminal extent used by headless Tui hosts.
public type TuiSize = Size.TuiSize;

// Zero-based half-open terminal-cell rectangle.
public type TuiRect = Rect.TuiRect;

// Color representation kind for terminal painting.
public type TuiColorKind = Color.TuiColorKind;

// Validated CRT, ANSI-256, or RGB color value.
public type TuiColor = Color.TuiColor;

// Semantic style role resolved through `TuiPalette`.
public type TuiStyleRole = StyleRole.TuiStyleRole;

// Concrete foreground/background colors and text attributes.
public type TuiStyle = Style.TuiStyle;

// One validated renderable grapheme with a semantic style role.
public type TuiCell = Cell.TuiCell;

// Maps every `TuiStyleRole` to a concrete `TuiStyle`.
public type TuiPalette = Palette.TuiPalette;

// Concrete styles for every visual button state.
public type TuiButtonPalette = ButtonPalette.TuiButtonPalette;

// Concrete styles for every visual one-line input state.
public type TuiInputPalette = InputPalette.TuiInputPalette;

// Per-axis growth and shrink policy kind.
public type TuiSizePolicyKind = SizePolicy.TuiSizePolicyKind;

// Independent horizontal and vertical size policies.
public type TuiSizePolicy = SizePolicy.TuiSizePolicy;

// Alignment of content inside an allocated layout slot.
public type TuiAlignmentKind = Alignment.TuiAlignmentKind;

// Independent horizontal and vertical alignment.
public type TuiAlignment = Alignment.TuiAlignment;

// Non-negative outer margins around a laid-out child.
public type TuiMargins = Margins.TuiMargins;

// Immutable layout inputs for a single-child layout wrapper.
public type TuiLayoutSettings = LayoutSettings.TuiLayoutSettings;

// Whether a measure axis is unbounded or capped.
public type TuiMeasureConstraintKind = MeasureConstraint.TuiMeasureConstraintKind;

// One-axis measurement constraint.
public type TuiMeasureConstraint = MeasureConstraint.TuiMeasureConstraint;

// Width and height measurement constraints.
public type TuiMeasureSpec = MeasureSpec.TuiMeasureSpec;

// Minimum, preferred, and maximum extents.
public type TuiMeasureResult = MeasureResult.TuiMeasureResult;

// Whether a spacer is fixed or expanding.
public type TuiSpacerKind = Spacer.TuiSpacerKind;

// Empty layout extent used between siblings.
public type TuiSpacer = Spacer.TuiSpacer;

// Fit report for terminal-too-small layout.
public type TuiLayoutFit = LayoutFit.TuiLayoutFit;

// Positive identity unique among interactive nodes in one rendered tree.
public type TuiControlId = ControlId.TuiControlId;

// Positive application intent; repetitions across controls are allowed.
public type TuiAction = Action2.TuiAction;

// Immutable button identity, label, mnemonic, action, and state.
public type TuiButtonSpec = Button.TuiButtonSpec;

// Immutable one-line input state, hint, and optional history.
public type TuiInputSpec = Input.TuiInputSpec;

// Immutable rectangular grid of concrete or theme-resolved terminal cells.
public type TuiCellGrid = CellGrid.TuiCellGrid;

// Immutable bounded value displayed as a compact dashboard gauge.
public type TuiGauge = Gauge.TuiGauge;

// Immutable description of one flat menu-bar action.
public type TuiMenuItem = MenuItem.TuiMenuItem;

// Structural keyboard gesture used by menu commands.
public type TuiKeyGesture = KeyGesture.TuiKeyGesture;

// Positive identity of one node in a flat menu definition.
public type TuiMenuNodeId = MenuNode.TuiMenuNodeId;

// One flat parent-linked menu node.
public type TuiMenuNode = MenuNode.TuiMenuNode;

// Model-owned open and active menu state.
public type TuiMenuState = MenuNode.TuiMenuState;

// Named constructors for flat menu nodes.
public type TuiMenuNodeBuilders = MenuNode.TuiMenuNodeBuilders;

// Immutable display or action item in a status line.
public type TuiStatusItem = StatusItem.TuiStatusItem;

// Constructors for immutable status-line items.
public type TuiStatusItemBuilders = StatusItem.TuiStatusItemBuilders;

// Runtime command returned through Update's mutable output parameter.
public type TuiCmd = Cmd.TuiCmd;

// Observable command output passed to Update.
public type TuiCmdOutput = Cmd.TuiCmdOutput;

// Cooperative callback executed as application-owned background work.
public type TuiBackgroundWork = Background.TuiBackgroundWork;

// Framework message delivered to Update.
public type TuiMsg = Msg.TuiMsg;

// Pointer button carried by a normalized pointer event.
public type TuiPointerButton = PointerEvent.TuiPointerButton;

// Normalized pointer action in zero-based application coordinates.
public type TuiPointerEvent = PointerEvent.TuiPointerEvent;

// Console mouse action used by pointer events.
public type TuiPointerAction = Console.MouseAction;

// Immutable element-tree node.
public type TuiElement = Element.TuiElement;

// Named element constructors.
public type TuiElementBuilders = Element.TuiElementBuilders;

// Explicit copy of the last painted headless surface.
public type TuiSurfaceSnapshot = Surface2.TuiSurfaceSnapshot;

// Host-owned mutable working surface handle.
public type TuiWorkingSurface = Surface2.TuiWorkingSurface;

// Private frame-scoped drawing capability over one working surface.
public type TuiCanvas = Canvas.TuiCanvas;

// Headless application host.
public type TuiApplication = Application.TuiApplication;

// Console key event used by headless key injection.
public type TuiKeyEvent = Console.KeyEvent;

// Console key kind used by headless key injection.
public type TuiKeyKind = Console.KeyKind;

// Creates a source-aware action message.
//
// Parameters:
// - `Source`: Identifier of the control that produced the message.
// - `Action`: Application action associated with the control or emitted message.
public function TuiMsgAction(Source: ControlId.TuiControlId; Action: Action2.TuiAction): Msg.TuiMsg;
begin
  return Msg.TuiMsgAction(Source, Action);
end function;

// Measures one element under the given constraints.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
// - `Spec`: Measurement constraints for width and height.
public function TuiMeasure(Node: Element.TuiElement; Spec: MeasureSpec.TuiMeasureSpec): MeasureResult.TuiMeasureResult;
begin
  return Measure.TuiMeasure(Node, Spec);
end function;

// Creates a source-aware controlled-input change message.
//
// Parameters:
// - `Source`: Identifier of the control that produced the message.
// - `Action`: Application action associated with the control or emitted message.
// - `Text`: Text processed or displayed by the operation.
// - `Caret`: Zero-based character index of the caret.
public function TuiMsgTextChanged(
  Source: ControlId.TuiControlId;
  Action: Action2.TuiAction;
  Text: string;
  Caret: integer
): Msg.TuiMsg;
begin
  return Msg.TuiMsgTextChanged(Source, Action, Text, Caret);
end function;

// Creates a source-aware controlled multiline text-area change message.
//
// Parameters:
// - `Source`: Identifier of the control that produced the message.
// - `Action`: Application action associated with the control or emitted message.
// - `Text`: Text processed or displayed by the operation.
// - `Caret`: Zero-based character index of the caret.
// - `Offset`: Scroll offset or position applied by the operation.
public function TuiMsgTextAreaChanged(
  Source: ControlId.TuiControlId;
  Action: Action2.TuiAction;
  Text: string;
  Caret: integer;
  Offset: Point.TuiPoint
): Msg.TuiMsg;
begin
  return Msg.TuiMsgTextAreaChanged(Source, Action, Text, Caret, Offset);
end function;

// Creates a source-aware controlled check-box change message.
//
// Parameters:
// - `Source`: Identifier of the control that produced the message.
// - `Action`: Application action associated with the control or emitted message.
// - `Checked`: Proposed checked state.
public function TuiMsgCheckChanged(
  Source: ControlId.TuiControlId;
  Action: Action2.TuiAction;
  Checked: boolean
): Msg.TuiMsg;
begin
  return Msg.TuiMsgCheckChanged(Source, Action, Checked);
end function;

// Creates a source-aware controlled list selection-change message.
//
// Parameters:
// - `Source`: Identifier of the control that produced the message.
// - `Action`: Application action associated with the control or emitted message.
// - `Selected`: Selected item index.
public function TuiMsgSelectionChanged(
  Source: ControlId.TuiControlId;
  Action: Action2.TuiAction;
  Selected: integer
): Msg.TuiMsg;
begin
  return Msg.TuiMsgSelectionChanged(Source, Action, Selected);
end function;

// Creates a source-aware controlled scroll-offset change message.
//
// Parameters:
// - `Source`: Identifier of the control that produced the message.
// - `Action`: Application action associated with the control or emitted message.
// - `Offset`: Scroll offset or position applied by the operation.
public function TuiMsgScrollChanged(
  Source: ControlId.TuiControlId;
  Action: Action2.TuiAction;
  Offset: Point.TuiPoint
): Msg.TuiMsg;
begin
  return Msg.TuiMsgScrollChanged(Source, Action, Offset);
end function;

// Returns the first focusable control in the active modal or full tree.
//
// Parameters:
// - `Root`: Root of the element tree.
public function TuiFocusFirst(Root: Element.TuiElement): option of ControlId.TuiControlId;
begin
  return Helpers.TuiFocusFirst(Root);
end function;

// Keeps a preferred focus id when still valid; otherwise selects the first focusable id.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Preferred`: Preferred size or focus identifier.
public function TuiFocusResolve(Root: Element.TuiElement; Preferred: option of ControlId.TuiControlId): option of ControlId.TuiControlId;
begin
  return Helpers.TuiFocusResolve(Root, Preferred);
end function;

// Reports whether a root's unconstrained minimum fits an available terminal size.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Available`: Available terminal size.
public function TuiLayoutFitFor(Root: Element.TuiElement; Available: Size.TuiSize): LayoutFit.TuiLayoutFit;
begin
  return Helpers.TuiLayoutFitFor(Root, Available);
end function;

// Clears a working surface and paints the terminal-too-small notice.
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
public procedure TuiPaintTooSmallOverlay(Surface: Surface2.TuiWorkingSurface);
begin
  Paint.TuiPaintTooSmallOverlay(Surface);
end procedure;

end unit;
