unit Std.Tui.Cells.Color;

public type
  // Color representation kind for terminal painting.
  TuiColorKind = enum
    Crt;
    Ansi256;
    Rgb;
  end;

function TuiColorRequireRange(Value: integer; Minimum: integer; Maximum: integer; Name: string): integer;
begin
  if (Value < Minimum) or (Value > Maximum) then
  begin
    panic(('Tui ' + Name) + ' is outside its supported range')
  end;

  return Value
end;

public type
  // Validated CRT, ANSI-256, or RGB color value.
  TuiColor = record
    public Kind: TuiColorKind;
    public Index: integer;
    public Red: integer;
    public Green: integer;
    public Blue: integer;

    // Creates a CRT color (`0..15`).
    public static function FromCrt(Index: integer): TuiColor;
    begin
      TuiColorRequireRange(Index, 0, 15, 'CRT color index');
      return record
        Kind := TuiColorKind.Crt;
        Index := Index;
        Red := 0;
        Green := 0;
        Blue := 0;
      end
    end;

    // Creates an ANSI-256 color (`0..255`).
    public static function FromAnsi256(Index: integer): TuiColor;
    begin
      TuiColorRequireRange(Index, 0, 255, 'ANSI-256 color index');
      return record
        Kind := TuiColorKind.Ansi256;
        Index := Index;
        Red := 0;
        Green := 0;
        Blue := 0;
      end
    end;

    // Creates an RGB color; each channel is `0..255`.
    public static function FromRgb(Red: integer; Green: integer; Blue: integer): TuiColor;
    begin
      TuiColorRequireRange(Red, 0, 255, 'red channel');
      TuiColorRequireRange(Green, 0, 255, 'green channel');
      TuiColorRequireRange(Blue, 0, 255, 'blue channel');
      return record
        Kind := TuiColorKind.Rgb;
        Index := 0;
        Red := Red;
        Green := Green;
        Blue := Blue;
      end
    end;
  end;
