unit Std.Tui.Cells.InputPalette;

uses Std.Tui.Cells.Style, Std.Tui.Cells.StyleRole;

public type
  // Concrete styles for every one-line input state.
  TuiInputPalette = record
    // Style used for normal content.
    public Normal: TuiStyle;
    // Style or identifier used for focused content.
    public Focused: TuiStyle;
    // Hint text or style for an empty input.
    public Hint: TuiStyle;
    // Style used for the input cursor.
    public Cursor: TuiStyle;
    // Style used for input scroll indicators.
    public Scroll: TuiStyle;

    // Creates a complete one-line input palette.
    //
    // Parameters:
    // - `Normal`: Normal-state style.
    // - `Focused`: Whether the control currently owns focus.
    // - `Hint`: Hint text displayed for an empty input.
    // - `Cursor`: Current layout or drawing cursor.
    // - `Scroll`: Whether scrolling behavior is enabled.
    public static function Create(
  Normal: TuiStyle;
  Focused: TuiStyle;
  Hint: TuiStyle;
  Cursor: TuiStyle;
  Scroll: TuiStyle
): TuiInputPalette;
    begin
      return record
        Normal := Normal;
        Focused := Focused;
        Hint := Hint;
        Cursor := Cursor;
        Scroll := Scroll;
      end
    end;

    // Resolves one input role.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Role`: Semantic style role used by the operation.
    public function ForRole(Self: TuiInputPalette; Role: TuiStyleRole): TuiStyle;
    begin
      case Role of
        TuiStyleRole.InputNormal:
        begin
          return Self.Normal
        end;
        TuiStyleRole.InputFocused:
        begin
          return Self.Focused
        end;
        TuiStyleRole.InputHint:
        begin
          return Self.Hint
        end;
        TuiStyleRole.InputCursor:
        begin
          return Self.Cursor
        end;
        TuiStyleRole.InputScroll:
        begin
          return Self.Scroll
        end
        else
        begin
          panic('Tui input palette requires an input style role')
        end
      end
    end;

    // Returns a copy with one input role replaced.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Role`: Semantic style role used by the operation.
    // - `Style`: Concrete terminal style.
    public function WithRole(Self: TuiInputPalette; Role: TuiStyleRole; Style: TuiStyle): TuiInputPalette;
    begin
      mutable var Updated: TuiInputPalette := Self;
      case Role of
        TuiStyleRole.InputNormal:
        begin
          Updated.Normal := Style
        end;
        TuiStyleRole.InputFocused:
        begin
          Updated.Focused := Style
        end;
        TuiStyleRole.InputHint:
        begin
          Updated.Hint := Style
        end;
        TuiStyleRole.InputCursor:
        begin
          Updated.Cursor := Style
        end;
        TuiStyleRole.InputScroll:
        begin
          Updated.Scroll := Style
        end
        else
        begin
          panic('Tui input palette requires an input style role')
        end
      end;

      return Updated
    end;
  end;
