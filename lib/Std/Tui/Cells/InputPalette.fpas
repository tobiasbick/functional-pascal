unit Std.Tui.Cells.InputPalette;

uses Std.Tui.Cells.Style as CellsStyle, Std.Tui.Cells.StyleRole as StyleRole;

// Concrete styles for every one-line input state.
public type TuiInputPalette = record
  // Style used for normal content.
  public Normal: CellsStyle.TuiStyle;
  // Style or identifier used for focused content.
  public Focused: CellsStyle.TuiStyle;
  // Hint text or style for an empty input.
  public Hint: CellsStyle.TuiStyle;
  // Style used for the input cursor.
  public Cursor: CellsStyle.TuiStyle;
  // Style used for input scroll indicators.
  public Scroll: CellsStyle.TuiStyle;

  // Creates a complete one-line input palette.
  //
  // Parameters:
  // - `Normal`: Normal-state style.
  // - `Focused`: Whether the control currently owns focus.
  // - `Hint`: Hint text displayed for an empty input.
  // - `Cursor`: Current layout or drawing cursor.
  // - `Scroll`: Whether scrolling behavior is enabled.
  public static function Create(
  Normal: CellsStyle.TuiStyle;
  Focused: CellsStyle.TuiStyle;
  Hint: CellsStyle.TuiStyle;
  Cursor: CellsStyle.TuiStyle;
  Scroll: CellsStyle.TuiStyle
): TuiInputPalette;
  begin
    return TuiInputPalette(Normal := Normal, Focused := Focused, Hint := Hint, Cursor := Cursor, Scroll := Scroll);
  end function;

  // Resolves one input role.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Role`: Semantic style role used by the operation.
  public function ForRole(Self: TuiInputPalette; Role: StyleRole.TuiStyleRole): CellsStyle.TuiStyle;
  begin
    case Role of
      when StyleRole.TuiStyleRole.InputNormal:
        begin
          return Self.Normal;
        end;
      when StyleRole.TuiStyleRole.InputFocused:
        begin
          return Self.Focused;
        end;
      when StyleRole.TuiStyleRole.InputHint:
        begin
          return Self.Hint;
        end;
      when StyleRole.TuiStyleRole.InputCursor:
        begin
          return Self.Cursor;
        end;
      when StyleRole.TuiStyleRole.InputScroll:
        begin
          return Self.Scroll;
        end;
      when StyleRole.TuiStyleRole.Normal, StyleRole.TuiStyleRole.Disabled, StyleRole.TuiStyleRole.Focused, StyleRole.TuiStyleRole.Selected, StyleRole.TuiStyleRole.Shortcut, StyleRole.TuiStyleRole.Frame, StyleRole.TuiStyleRole.Title, StyleRole.TuiStyleRole.MenuNormal, StyleRole.TuiStyleRole.MenuDisabled, StyleRole.TuiStyleRole.MenuShortcut, StyleRole.TuiStyleRole.MenuSelected, StyleRole.TuiStyleRole.MenuSelectedShortcut, StyleRole.TuiStyleRole.StatusNormal, StyleRole.TuiStyleRole.StatusDisabled, StyleRole.TuiStyleRole.StatusShortcut, StyleRole.TuiStyleRole.StatusSelected, StyleRole.TuiStyleRole.ButtonNormal, StyleRole.TuiStyleRole.ButtonDefault, StyleRole.TuiStyleRole.ButtonSelected, StyleRole.TuiStyleRole.ButtonDisabled, StyleRole.TuiStyleRole.ButtonShortcut, StyleRole.TuiStyleRole.ButtonDefaultShortcut, StyleRole.TuiStyleRole.ButtonSelectedShortcut, StyleRole.TuiStyleRole.Rule, StyleRole.TuiStyleRole.GaugeTrack, StyleRole.TuiStyleRole.GaugeFill, StyleRole.TuiStyleRole.Failure, StyleRole.TuiStyleRole.Warning, StyleRole.TuiStyleRole.Accent:
        begin
          panic('Tui input palette requires an input style role');
        end;
    end case;
  end function;

  // Returns a copy with one input role replaced.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Role`: Semantic style role used by the operation.
  // - `Style`: Concrete terminal style.
  public function WithRole(Self: TuiInputPalette; Role: StyleRole.TuiStyleRole; Style: CellsStyle.TuiStyle): TuiInputPalette;
  begin
    var Updated: TuiInputPalette := Self;
    case Role of
      when StyleRole.TuiStyleRole.InputNormal:
        begin
          Updated.Normal := Style;
        end;
      when StyleRole.TuiStyleRole.InputFocused:
        begin
          Updated.Focused := Style;
        end;
      when StyleRole.TuiStyleRole.InputHint:
        begin
          Updated.Hint := Style;
        end;
      when StyleRole.TuiStyleRole.InputCursor:
        begin
          Updated.Cursor := Style;
        end;
      when StyleRole.TuiStyleRole.InputScroll:
        begin
          Updated.Scroll := Style;
        end;
      when StyleRole.TuiStyleRole.Normal, StyleRole.TuiStyleRole.Disabled, StyleRole.TuiStyleRole.Focused, StyleRole.TuiStyleRole.Selected, StyleRole.TuiStyleRole.Shortcut, StyleRole.TuiStyleRole.Frame, StyleRole.TuiStyleRole.Title, StyleRole.TuiStyleRole.MenuNormal, StyleRole.TuiStyleRole.MenuDisabled, StyleRole.TuiStyleRole.MenuShortcut, StyleRole.TuiStyleRole.MenuSelected, StyleRole.TuiStyleRole.MenuSelectedShortcut, StyleRole.TuiStyleRole.StatusNormal, StyleRole.TuiStyleRole.StatusDisabled, StyleRole.TuiStyleRole.StatusShortcut, StyleRole.TuiStyleRole.StatusSelected, StyleRole.TuiStyleRole.ButtonNormal, StyleRole.TuiStyleRole.ButtonDefault, StyleRole.TuiStyleRole.ButtonSelected, StyleRole.TuiStyleRole.ButtonDisabled, StyleRole.TuiStyleRole.ButtonShortcut, StyleRole.TuiStyleRole.ButtonDefaultShortcut, StyleRole.TuiStyleRole.ButtonSelectedShortcut, StyleRole.TuiStyleRole.Rule, StyleRole.TuiStyleRole.GaugeTrack, StyleRole.TuiStyleRole.GaugeFill, StyleRole.TuiStyleRole.Failure, StyleRole.TuiStyleRole.Warning, StyleRole.TuiStyleRole.Accent:
        begin
          panic('Tui input palette requires an input style role');
        end;
    end case;

    return Updated;
  end function;
end record;
end unit;
