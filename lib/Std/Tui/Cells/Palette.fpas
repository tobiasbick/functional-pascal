unit Std.Tui.Cells.Palette;

uses Std.Tui.Cells.ButtonPalette as ButtonPalette;
uses Std.Tui.Cells.Color as Color;
uses Std.Tui.Cells.InputPalette as InputPalette;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Cells.Style as Style2;

// Maps every semantic `TuiStyleRole` to a concrete terminal style.
public type TuiPalette = record
  // Style used for normal content.
  public Normal: Style2.TuiStyle;
  // Style used for disabled content.
  public Disabled: Style2.TuiStyle;
  // Style or identifier used for focused content.
  public Focused: Style2.TuiStyle;
  // Selected item index or style.
  public Selected: Style2.TuiStyle;
  // Shortcut text, gesture, or style.
  public Shortcut: Style2.TuiStyle;
  // Style used for borders and frames.
  public Frame: Style2.TuiStyle;
  // Style used for titles.
  public Title: Style2.TuiStyle;
  // Style used for normal menu items.
  public MenuNormal: Style2.TuiStyle;
  // Style used for disabled menu items.
  public MenuDisabled: Style2.TuiStyle;
  // Style used for menu shortcuts.
  public MenuShortcut: Style2.TuiStyle;
  // Style used for the selected menu item.
  public MenuSelected: Style2.TuiStyle;
  // Shortcut style used for the selected menu item.
  public MenuSelectedShortcut: Style2.TuiStyle;
  // Style used for normal status-line items.
  public StatusNormal: Style2.TuiStyle;
  // Style used for disabled status-line items.
  public StatusDisabled: Style2.TuiStyle;
  // Style used for status-line shortcuts.
  public StatusShortcut: Style2.TuiStyle;
  // Style used for selected status-line items.
  public StatusSelected: Style2.TuiStyle;
  // Styles used by button controls.
  public Buttons: ButtonPalette.TuiButtonPalette;
  // Styles used by input controls.
  public Inputs: InputPalette.TuiInputPalette;
  // Style used for horizontal rules.
  public Rule: Style2.TuiStyle;
  // Style used for the unfilled gauge track.
  public GaugeTrack: Style2.TuiStyle;
  // Style used for the filled gauge region.
  public GaugeFill: Style2.TuiStyle;
  // Style used for failure content.
  public Failure: Style2.TuiStyle;
  // Style used for warning content.
  public Warning: Style2.TuiStyle;
  // Style used for accent content.
  public Accent: Style2.TuiStyle;
end record;

// Returns the modern dark default palette.
public function TuiPaletteDefault(): TuiPalette;
begin
  const Background: Color.TuiColor := Color.TuiColorFromRgb(13, 17, 23);
  const Surface: Color.TuiColor := Color.TuiColorFromRgb(22, 27, 34);
  const Text: Color.TuiColor := Color.TuiColorFromRgb(201, 209, 217);
  const Muted: Color.TuiColor := Color.TuiColorFromRgb(139, 148, 158);
  const Border: Color.TuiColor := Color.TuiColorFromRgb(48, 54, 61);
  const Accent: Color.TuiColor := Color.TuiColorFromRgb(88, 166, 255);
  const Selected: Color.TuiColor := Color.TuiColorFromRgb(31, 111, 235);
  const Success: Color.TuiColor := Color.TuiColorFromRgb(63, 185, 80);
  const Failure: Color.TuiColor := Color.TuiColorFromRgb(248, 81, 73);
  const Warning: Color.TuiColor := Color.TuiColorFromRgb(210, 153, 34);
  const NormalStyle: Style2.TuiStyle := Style2.TuiStyleFromColors(Text, Background);
  const SelectedStyle: Style2.TuiStyle := Style2.TuiStyleFromColors(Text, Selected);
  const AccentStyle: Style2.TuiStyle := Style2.TuiStyleFromColors(Accent, Background);
  const Buttons: ButtonPalette.TuiButtonPalette := ButtonPalette.TuiButtonPaletteCreate(Style2.TuiStyleFromColors(Text, Surface), Style2.TuiStyleFromColors(Background, Accent), SelectedStyle, Style2.TuiStyleFromColors(Muted, Surface), Style2.TuiStyleFromColors(Accent, Surface), Style2.TuiStyleFromColors(Background, Accent), Style2.TuiStyleFromColors(Text, Selected));
  const Inputs: InputPalette.TuiInputPalette := InputPalette.TuiInputPaletteCreate(Style2.TuiStyleFromColors(Text, Surface), Style2.TuiStyleFromColors(Text, Color.TuiColorFromRgb(30, 36, 44)), Style2.TuiStyleFromColors(Muted, Surface), Style2.TuiStyleFromColors(Background, Accent), Style2.TuiStyleFromColors(Accent, Surface));
  return TuiPalette(Normal := NormalStyle, Disabled := Style2.TuiStyleFromColors(Muted, Background), Focused := SelectedStyle, Selected := SelectedStyle, Shortcut := AccentStyle, Frame := Style2.TuiStyleFromColors(Border, Background), Title := Style2.TuiStyleFromColors(Text, Background), MenuNormal := Style2.TuiStyleFromColors(Text, Surface), MenuDisabled := Style2.TuiStyleFromColors(Muted, Surface), MenuShortcut := Style2.TuiStyleFromColors(Accent, Surface), MenuSelected := SelectedStyle, MenuSelectedShortcut := Style2.TuiStyleFromColors(Text, Selected), StatusNormal := Style2.TuiStyleFromColors(Text, Surface), StatusDisabled := Style2.TuiStyleFromColors(Muted, Surface), StatusShortcut := Style2.TuiStyleFromColors(Accent, Surface), StatusSelected := SelectedStyle, Buttons := Buttons, Inputs := Inputs, Rule := Style2.TuiStyleFromColors(Border, Background), GaugeTrack := Style2.TuiStyleFromColors(Border, Background), GaugeFill := Style2.TuiStyleFromColors(Success, Background), Failure := Style2.TuiStyleFromColors(Failure, Background), Warning := Style2.TuiStyleFromColors(Warning, Background), Accent := AccentStyle);
end function;

// Resolves the concrete style for one semantic role.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Role`: Semantic style role used by the operation.
public function TuiPaletteForRole(Receiver: TuiPalette; Role: StyleRole.TuiStyleRole): Style2.TuiStyle;
begin
  case Role of
    when StyleRole.TuiStyleRole.Normal:
      begin
        return Receiver.Normal;
      end;
    when StyleRole.TuiStyleRole.Disabled:
      begin
        return Receiver.Disabled;
      end;
    when StyleRole.TuiStyleRole.Focused:
      begin
        return Receiver.Focused;
      end;
    when StyleRole.TuiStyleRole.Selected:
      begin
        return Receiver.Selected;
      end;
    when StyleRole.TuiStyleRole.Shortcut:
      begin
        return Receiver.Shortcut;
      end;
    when StyleRole.TuiStyleRole.Frame:
      begin
        return Receiver.Frame;
      end;
    when StyleRole.TuiStyleRole.Title:
      begin
        return Receiver.Title;
      end;
    when StyleRole.TuiStyleRole.MenuNormal:
      begin
        return Receiver.MenuNormal;
      end;
    when StyleRole.TuiStyleRole.MenuDisabled:
      begin
        return Receiver.MenuDisabled;
      end;
    when StyleRole.TuiStyleRole.MenuShortcut:
      begin
        return Receiver.MenuShortcut;
      end;
    when StyleRole.TuiStyleRole.MenuSelected:
      begin
        return Receiver.MenuSelected;
      end;
    when StyleRole.TuiStyleRole.MenuSelectedShortcut:
      begin
        return Receiver.MenuSelectedShortcut;
      end;
    when StyleRole.TuiStyleRole.StatusNormal:
      begin
        return Receiver.StatusNormal;
      end;
    when StyleRole.TuiStyleRole.StatusDisabled:
      begin
        return Receiver.StatusDisabled;
      end;
    when StyleRole.TuiStyleRole.StatusShortcut:
      begin
        return Receiver.StatusShortcut;
      end;
    when StyleRole.TuiStyleRole.StatusSelected:
      begin
        return Receiver.StatusSelected;
      end;
    when StyleRole.TuiStyleRole.ButtonNormal, StyleRole.TuiStyleRole.ButtonDefault, StyleRole.TuiStyleRole.ButtonSelected, StyleRole.TuiStyleRole.ButtonDisabled, StyleRole.TuiStyleRole.ButtonShortcut, StyleRole.TuiStyleRole.ButtonDefaultShortcut, StyleRole.TuiStyleRole.ButtonSelectedShortcut:
      begin
        return ButtonPalette.TuiButtonPaletteForRole(Receiver.Buttons, Role);
      end;
    when StyleRole.TuiStyleRole.InputNormal, StyleRole.TuiStyleRole.InputFocused, StyleRole.TuiStyleRole.InputHint, StyleRole.TuiStyleRole.InputCursor, StyleRole.TuiStyleRole.InputScroll:
      begin
        return InputPalette.TuiInputPaletteForRole(Receiver.Inputs, Role);
      end;
    when StyleRole.TuiStyleRole.Rule:
      begin
        return Receiver.Rule;
      end;
    when StyleRole.TuiStyleRole.GaugeTrack:
      begin
        return Receiver.GaugeTrack;
      end;
    when StyleRole.TuiStyleRole.GaugeFill:
      begin
        return Receiver.GaugeFill;
      end;
    when StyleRole.TuiStyleRole.Failure:
      begin
        return Receiver.Failure;
      end;
    when StyleRole.TuiStyleRole.Warning:
      begin
        return Receiver.Warning;
      end;
    when StyleRole.TuiStyleRole.Accent:
      begin
        return Receiver.Accent;
      end;
  end case;
end function;

// Returns a copy with one semantic role replaced.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Role`: Semantic style role used by the operation.
// - `Style`: Concrete terminal style.
public function TuiPaletteWithRole(
  Receiver: TuiPalette;
  Role: StyleRole.TuiStyleRole;
  Style: Style2.TuiStyle
): TuiPalette;
begin
  var Updated: TuiPalette := Receiver;
  case Role of
    when StyleRole.TuiStyleRole.Normal:
      begin
        Updated.Normal := Style;
      end;
    when StyleRole.TuiStyleRole.Disabled:
      begin
        Updated.Disabled := Style;
      end;
    when StyleRole.TuiStyleRole.Focused:
      begin
        Updated.Focused := Style;
      end;
    when StyleRole.TuiStyleRole.Selected:
      begin
        Updated.Selected := Style;
      end;
    when StyleRole.TuiStyleRole.Shortcut:
      begin
        Updated.Shortcut := Style;
      end;
    when StyleRole.TuiStyleRole.Frame:
      begin
        Updated.Frame := Style;
      end;
    when StyleRole.TuiStyleRole.Title:
      begin
        Updated.Title := Style;
      end;
    when StyleRole.TuiStyleRole.MenuNormal:
      begin
        Updated.MenuNormal := Style;
      end;
    when StyleRole.TuiStyleRole.MenuDisabled:
      begin
        Updated.MenuDisabled := Style;
      end;
    when StyleRole.TuiStyleRole.MenuShortcut:
      begin
        Updated.MenuShortcut := Style;
      end;
    when StyleRole.TuiStyleRole.MenuSelected:
      begin
        Updated.MenuSelected := Style;
      end;
    when StyleRole.TuiStyleRole.MenuSelectedShortcut:
      begin
        Updated.MenuSelectedShortcut := Style;
      end;
    when StyleRole.TuiStyleRole.StatusNormal:
      begin
        Updated.StatusNormal := Style;
      end;
    when StyleRole.TuiStyleRole.StatusDisabled:
      begin
        Updated.StatusDisabled := Style;
      end;
    when StyleRole.TuiStyleRole.StatusShortcut:
      begin
        Updated.StatusShortcut := Style;
      end;
    when StyleRole.TuiStyleRole.StatusSelected:
      begin
        Updated.StatusSelected := Style;
      end;
    when StyleRole.TuiStyleRole.ButtonNormal, StyleRole.TuiStyleRole.ButtonDefault, StyleRole.TuiStyleRole.ButtonSelected, StyleRole.TuiStyleRole.ButtonDisabled, StyleRole.TuiStyleRole.ButtonShortcut, StyleRole.TuiStyleRole.ButtonDefaultShortcut, StyleRole.TuiStyleRole.ButtonSelectedShortcut:
      begin
        Updated.Buttons := ButtonPalette.TuiButtonPaletteWithRole(Updated.Buttons, Role, Style);
      end;
    when StyleRole.TuiStyleRole.InputNormal, StyleRole.TuiStyleRole.InputFocused, StyleRole.TuiStyleRole.InputHint, StyleRole.TuiStyleRole.InputCursor, StyleRole.TuiStyleRole.InputScroll:
      begin
        Updated.Inputs := InputPalette.TuiInputPaletteWithRole(Updated.Inputs, Role, Style);
      end;
    when StyleRole.TuiStyleRole.Rule:
      begin
        Updated.Rule := Style;
      end;
    when StyleRole.TuiStyleRole.GaugeTrack:
      begin
        Updated.GaugeTrack := Style;
      end;
    when StyleRole.TuiStyleRole.GaugeFill:
      begin
        Updated.GaugeFill := Style;
      end;
    when StyleRole.TuiStyleRole.Failure:
      begin
        Updated.Failure := Style;
      end;
    when StyleRole.TuiStyleRole.Warning:
      begin
        Updated.Warning := Style;
      end;
    when StyleRole.TuiStyleRole.Accent:
      begin
        Updated.Accent := Style;
      end;
  end case;

  return Updated;
end function;

end unit;
