unit Std.Tui.Cells.Palette;

uses Std.Tui.Cells.ButtonPalette as ButtonPalette;
uses Std.Tui.Cells.Color as Color;
uses Std.Tui.Cells.InputPalette as InputPalette;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Cells.Style as Style2;

// Maps every semantic `TuiStyleRole` to a concrete terminal style.
public type TuiPalette = record
  // Style used for normal content.
  public Normal: Style2.TuiStyle;
  // Style used for disabled content.
  public Disabled: Style2.TuiStyle;
  // Style or identifier used for focused content.
  public Focused: Style2.TuiStyle;
  // Selected item index or style.
  public Selected: Style2.TuiStyle;
  // Shortcut text, gesture, or style.
  public Shortcut: Style2.TuiStyle;
  // Style used for borders and frames.
  public Frame: Style2.TuiStyle;
  // Style used for titles.
  public Title: Style2.TuiStyle;
  // Style used for normal menu items.
  public MenuNormal: Style2.TuiStyle;
  // Style used for disabled menu items.
  public MenuDisabled: Style2.TuiStyle;
  // Style used for menu shortcuts.
  public MenuShortcut: Style2.TuiStyle;
  // Style used for the selected menu item.
  public MenuSelected: Style2.TuiStyle;
  // Shortcut style used for the selected menu item.
  public MenuSelectedShortcut: Style2.TuiStyle;
  // Style used for normal status-line items.
  public StatusNormal: Style2.TuiStyle;
  // Style used for disabled status-line items.
  public StatusDisabled: Style2.TuiStyle;
  // Style used for status-line shortcuts.
  public StatusShortcut: Style2.TuiStyle;
  // Style used for selected status-line items.
  public StatusSelected: Style2.TuiStyle;
  // Styles used by button controls.
  public Buttons: ButtonPalette.TuiButtonPalette;
  // Styles used by input controls.
  public Inputs: InputPalette.TuiInputPalette;
  // Style used for horizontal rules.
  public Rule: Style2.TuiStyle;
  // Style used for the unfilled gauge track.
  public GaugeTrack: Style2.TuiStyle;
  // Style used for the filled gauge region.
  public GaugeFill: Style2.TuiStyle;
  // Style used for failure content.
  public Failure: Style2.TuiStyle;
  // Style used for warning content.
  public Warning: Style2.TuiStyle;
  // Style used for accent content.
  public Accent: Style2.TuiStyle;

  // Returns the modern dark default palette.
  public static function Default(): TuiPalette;
  begin
    var Background: Color.TuiColor := Color.TuiColor.FromRgb(13, 17, 23);
    var Surface: Color.TuiColor := Color.TuiColor.FromRgb(22, 27, 34);
    var Text: Color.TuiColor := Color.TuiColor.FromRgb(201, 209, 217);
    var Muted: Color.TuiColor := Color.TuiColor.FromRgb(139, 148, 158);
    var Border: Color.TuiColor := Color.TuiColor.FromRgb(48, 54, 61);
    var Accent: Color.TuiColor := Color.TuiColor.FromRgb(88, 166, 255);
    var Selected: Color.TuiColor := Color.TuiColor.FromRgb(31, 111, 235);
    var Success: Color.TuiColor := Color.TuiColor.FromRgb(63, 185, 80);
    var Failure: Color.TuiColor := Color.TuiColor.FromRgb(248, 81, 73);
    var Warning: Color.TuiColor := Color.TuiColor.FromRgb(210, 153, 34);
    var NormalStyle: Style2.TuiStyle := Style2.TuiStyle.FromColors(Text, Background);
    var SelectedStyle: Style2.TuiStyle := Style2.TuiStyle.FromColors(Text, Selected);
    var AccentStyle: Style2.TuiStyle := Style2.TuiStyle.FromColors(Accent, Background);
    var Buttons: ButtonPalette.TuiButtonPalette := ButtonPalette.TuiButtonPalette.Create(Style2.TuiStyle.FromColors(Text, Surface), Style2.TuiStyle.FromColors(Background, Accent), SelectedStyle, Style2.TuiStyle.FromColors(Muted, Surface), Style2.TuiStyle.FromColors(Accent, Surface), Style2.TuiStyle.FromColors(Background, Accent), Style2.TuiStyle.FromColors(Text, Selected));
    var Inputs: InputPalette.TuiInputPalette := InputPalette.TuiInputPalette.Create(Style2.TuiStyle.FromColors(Text, Surface), Style2.TuiStyle.FromColors(Text, Color.TuiColor.FromRgb(30, 36, 44)), Style2.TuiStyle.FromColors(Muted, Surface), Style2.TuiStyle.FromColors(Background, Accent), Style2.TuiStyle.FromColors(Accent, Surface));
    return TuiPalette(Normal := NormalStyle, Disabled := Style2.TuiStyle.FromColors(Muted, Background), Focused := SelectedStyle, Selected := SelectedStyle, Shortcut := AccentStyle, Frame := Style2.TuiStyle.FromColors(Border, Background), Title := Style2.TuiStyle.FromColors(Text, Background), MenuNormal := Style2.TuiStyle.FromColors(Text, Surface), MenuDisabled := Style2.TuiStyle.FromColors(Muted, Surface), MenuShortcut := Style2.TuiStyle.FromColors(Accent, Surface), MenuSelected := SelectedStyle, MenuSelectedShortcut := Style2.TuiStyle.FromColors(Text, Selected), StatusNormal := Style2.TuiStyle.FromColors(Text, Surface), StatusDisabled := Style2.TuiStyle.FromColors(Muted, Surface), StatusShortcut := Style2.TuiStyle.FromColors(Accent, Surface), StatusSelected := SelectedStyle, Buttons := Buttons, Inputs := Inputs, Rule := Style2.TuiStyle.FromColors(Border, Background), GaugeTrack := Style2.TuiStyle.FromColors(Border, Background), GaugeFill := Style2.TuiStyle.FromColors(Success, Background), Failure := Style2.TuiStyle.FromColors(Failure, Background), Warning := Style2.TuiStyle.FromColors(Warning, Background), Accent := AccentStyle);
  end function;

  // Resolves the concrete style for one semantic role.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Role`: Semantic style role used by the operation.
  public function ForRole(Self: TuiPalette; Role: StyleRole.TuiStyleRole): Style2.TuiStyle;
  begin
    case Role of
      when StyleRole.TuiStyleRole.Normal:
        begin
          return Self.Normal;
        end;
      when StyleRole.TuiStyleRole.Disabled:
        begin
          return Self.Disabled;
        end;
      when StyleRole.TuiStyleRole.Focused:
        begin
          return Self.Focused;
        end;
      when StyleRole.TuiStyleRole.Selected:
        begin
          return Self.Selected;
        end;
      when StyleRole.TuiStyleRole.Shortcut:
        begin
          return Self.Shortcut;
        end;
      when StyleRole.TuiStyleRole.Frame:
        begin
          return Self.Frame;
        end;
      when StyleRole.TuiStyleRole.Title:
        begin
          return Self.Title;
        end;
      when StyleRole.TuiStyleRole.MenuNormal:
        begin
          return Self.MenuNormal;
        end;
      when StyleRole.TuiStyleRole.MenuDisabled:
        begin
          return Self.MenuDisabled;
        end;
      when StyleRole.TuiStyleRole.MenuShortcut:
        begin
          return Self.MenuShortcut;
        end;
      when StyleRole.TuiStyleRole.MenuSelected:
        begin
          return Self.MenuSelected;
        end;
      when StyleRole.TuiStyleRole.MenuSelectedShortcut:
        begin
          return Self.MenuSelectedShortcut;
        end;
      when StyleRole.TuiStyleRole.StatusNormal:
        begin
          return Self.StatusNormal;
        end;
      when StyleRole.TuiStyleRole.StatusDisabled:
        begin
          return Self.StatusDisabled;
        end;
      when StyleRole.TuiStyleRole.StatusShortcut:
        begin
          return Self.StatusShortcut;
        end;
      when StyleRole.TuiStyleRole.StatusSelected:
        begin
          return Self.StatusSelected;
        end;
      when StyleRole.TuiStyleRole.ButtonNormal, StyleRole.TuiStyleRole.ButtonDefault, StyleRole.TuiStyleRole.ButtonSelected, StyleRole.TuiStyleRole.ButtonDisabled, StyleRole.TuiStyleRole.ButtonShortcut, StyleRole.TuiStyleRole.ButtonDefaultShortcut, StyleRole.TuiStyleRole.ButtonSelectedShortcut:
        begin
          return Self.Buttons.ForRole(Role);
        end;
      when StyleRole.TuiStyleRole.InputNormal, StyleRole.TuiStyleRole.InputFocused, StyleRole.TuiStyleRole.InputHint, StyleRole.TuiStyleRole.InputCursor, StyleRole.TuiStyleRole.InputScroll:
        begin
          return Self.Inputs.ForRole(Role);
        end;
      when StyleRole.TuiStyleRole.Rule:
        begin
          return Self.Rule;
        end;
      when StyleRole.TuiStyleRole.GaugeTrack:
        begin
          return Self.GaugeTrack;
        end;
      when StyleRole.TuiStyleRole.GaugeFill:
        begin
          return Self.GaugeFill;
        end;
      when StyleRole.TuiStyleRole.Failure:
        begin
          return Self.Failure;
        end;
      when StyleRole.TuiStyleRole.Warning:
        begin
          return Self.Warning;
        end;
      when StyleRole.TuiStyleRole.Accent:
        begin
          return Self.Accent;
        end;
    end case;
  end function;

  // Returns a copy with one semantic role replaced.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Role`: Semantic style role used by the operation.
  // - `Style`: Concrete terminal style.
  public function WithRole(Self: TuiPalette; Role: StyleRole.TuiStyleRole; Style: Style2.TuiStyle): TuiPalette;
  begin
    mutable var Updated: TuiPalette := Self;
    case Role of
      when StyleRole.TuiStyleRole.Normal:
        begin
          Updated.Normal := Style;
        end;
      when StyleRole.TuiStyleRole.Disabled:
        begin
          Updated.Disabled := Style;
        end;
      when StyleRole.TuiStyleRole.Focused:
        begin
          Updated.Focused := Style;
        end;
      when StyleRole.TuiStyleRole.Selected:
        begin
          Updated.Selected := Style;
        end;
      when StyleRole.TuiStyleRole.Shortcut:
        begin
          Updated.Shortcut := Style;
        end;
      when StyleRole.TuiStyleRole.Frame:
        begin
          Updated.Frame := Style;
        end;
      when StyleRole.TuiStyleRole.Title:
        begin
          Updated.Title := Style;
        end;
      when StyleRole.TuiStyleRole.MenuNormal:
        begin
          Updated.MenuNormal := Style;
        end;
      when StyleRole.TuiStyleRole.MenuDisabled:
        begin
          Updated.MenuDisabled := Style;
        end;
      when StyleRole.TuiStyleRole.MenuShortcut:
        begin
          Updated.MenuShortcut := Style;
        end;
      when StyleRole.TuiStyleRole.MenuSelected:
        begin
          Updated.MenuSelected := Style;
        end;
      when StyleRole.TuiStyleRole.MenuSelectedShortcut:
        begin
          Updated.MenuSelectedShortcut := Style;
        end;
      when StyleRole.TuiStyleRole.StatusNormal:
        begin
          Updated.StatusNormal := Style;
        end;
      when StyleRole.TuiStyleRole.StatusDisabled:
        begin
          Updated.StatusDisabled := Style;
        end;
      when StyleRole.TuiStyleRole.StatusShortcut:
        begin
          Updated.StatusShortcut := Style;
        end;
      when StyleRole.TuiStyleRole.StatusSelected:
        begin
          Updated.StatusSelected := Style;
        end;
      when StyleRole.TuiStyleRole.ButtonNormal, StyleRole.TuiStyleRole.ButtonDefault, StyleRole.TuiStyleRole.ButtonSelected, StyleRole.TuiStyleRole.ButtonDisabled, StyleRole.TuiStyleRole.ButtonShortcut, StyleRole.TuiStyleRole.ButtonDefaultShortcut, StyleRole.TuiStyleRole.ButtonSelectedShortcut:
        begin
          Updated.Buttons := Updated.Buttons.WithRole(Role, Style);
        end;
      when StyleRole.TuiStyleRole.InputNormal, StyleRole.TuiStyleRole.InputFocused, StyleRole.TuiStyleRole.InputHint, StyleRole.TuiStyleRole.InputCursor, StyleRole.TuiStyleRole.InputScroll:
        begin
          Updated.Inputs := Updated.Inputs.WithRole(Role, Style);
        end;
      when StyleRole.TuiStyleRole.Rule:
        begin
          Updated.Rule := Style;
        end;
      when StyleRole.TuiStyleRole.GaugeTrack:
        begin
          Updated.GaugeTrack := Style;
        end;
      when StyleRole.TuiStyleRole.GaugeFill:
        begin
          Updated.GaugeFill := Style;
        end;
      when StyleRole.TuiStyleRole.Failure:
        begin
          Updated.Failure := Style;
        end;
      when StyleRole.TuiStyleRole.Warning:
        begin
          Updated.Warning := Style;
        end;
      when StyleRole.TuiStyleRole.Accent:
        begin
          Updated.Accent := Style;
        end;
    end case;

    return Updated;
  end function;
end record;

end unit;
