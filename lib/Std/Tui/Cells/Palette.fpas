unit Std.Tui.Cells.Palette;

uses
  Std.Tui.Cells.ButtonPalette, Std.Tui.Cells.Color, Std.Tui.Cells.InputPalette,
  Std.Tui.Cells.StyleRole, Std.Tui.Cells.Style;

type
  /// Maps every `TuiStyleRole` to a concrete `TuiStyle`.
  TuiPalette = record
    Normal: TuiStyle;
    Disabled: TuiStyle;
    Focused: TuiStyle;
    Selected: TuiStyle;
    Shortcut: TuiStyle;
    Frame: TuiStyle;
    Title: TuiStyle;
    MenuNormal: TuiStyle;
    MenuDisabled: TuiStyle;
    MenuShortcut: TuiStyle;
    MenuSelected: TuiStyle;
    MenuSelectedShortcut: TuiStyle;
    MenuShadow: TuiStyle;
    StatusNormal: TuiStyle;
    StatusDisabled: TuiStyle;
    StatusShortcut: TuiStyle;
    StatusSelected: TuiStyle;
    Buttons: TuiButtonPalette;
    Inputs: TuiInputPalette;
    DialogNormal: TuiStyle;
    DialogFrame: TuiStyle;
    DialogTitle: TuiStyle;
    DialogInput: TuiStyle;
    DialogInputFocused: TuiStyle;
    DialogShadow: TuiStyle;
    Failure: TuiStyle;
    Warning: TuiStyle;
    Accent: TuiStyle;

    /// Creates a palette from explicit per-role styles.

    static function Create(
  Normal: TuiStyle;
  Disabled: TuiStyle;
  Focused: TuiStyle;
  Selected: TuiStyle;
  Shortcut: TuiStyle;
  Frame: TuiStyle;
  Title: TuiStyle;
  MenuNormal: TuiStyle;
  MenuDisabled: TuiStyle;
  MenuShortcut: TuiStyle;
  MenuSelected: TuiStyle;
  MenuSelectedShortcut: TuiStyle;
  MenuShadow: TuiStyle;
  StatusNormal: TuiStyle;
  StatusDisabled: TuiStyle;
  StatusShortcut: TuiStyle;
  StatusSelected: TuiStyle;
  Buttons: TuiButtonPalette;
  Inputs: TuiInputPalette;
  DialogNormal: TuiStyle;
  DialogFrame: TuiStyle;
  DialogTitle: TuiStyle;
  DialogInput: TuiStyle;
  DialogInputFocused: TuiStyle;
  DialogShadow: TuiStyle;
  Failure: TuiStyle;
  Warning: TuiStyle;
  Accent: TuiStyle
): TuiPalette;
    begin
      return record
        Normal := Normal;
        Disabled := Disabled;
        Focused := Focused;
        Selected := Selected;
        Shortcut := Shortcut;
        Frame := Frame;
        Title := Title;
        MenuNormal := MenuNormal;
        MenuDisabled := MenuDisabled;
        MenuShortcut := MenuShortcut;
        MenuSelected := MenuSelected;
        MenuSelectedShortcut := MenuSelectedShortcut;
        MenuShadow := MenuShadow;
        StatusNormal := StatusNormal;
        StatusDisabled := StatusDisabled;
        StatusShortcut := StatusShortcut;
        StatusSelected := StatusSelected;
        Buttons := Buttons;
        Inputs := Inputs;
        DialogNormal := DialogNormal;
        DialogFrame := DialogFrame;
        DialogTitle := DialogTitle;
        DialogInput := DialogInput;
        DialogInputFocused := DialogInputFocused;
        DialogShadow := DialogShadow;
        Failure := Failure;
        Warning := Warning;
        Accent := Accent;
      end
    end;

    /// Returns the standard CRT semantic palette.

    static function Default(): TuiPalette;
    begin
      var Black: TuiColor := TuiColor.FromCrt(0);
      var DarkGray: TuiColor := TuiColor.FromCrt(8);
      var LightGray: TuiColor := TuiColor.FromCrt(7);
      var White: TuiColor := TuiColor.FromCrt(15);
      var Blue: TuiColor := TuiColor.FromCrt(1);
      var Green: TuiColor := TuiColor.FromCrt(2);
      var Red: TuiColor := TuiColor.FromCrt(4);
      var LightCyan: TuiColor := TuiColor.FromCrt(11);
      var LightRed: TuiColor := TuiColor.FromCrt(12);
      var Yellow: TuiColor := TuiColor.FromCrt(14);
      var Normal: TuiStyle := TuiStyle.FromColors(LightGray, Black);
      var ChromeNormal: TuiStyle := TuiStyle.FromColors(Black, LightGray);
      var ChromeDisabled: TuiStyle := TuiStyle.FromColors(DarkGray, LightGray);
      var ChromeShortcut: TuiStyle := TuiStyle.FromColors(Red, LightGray);
      var ChromeSelected: TuiStyle := TuiStyle.FromColors(Black, Green);
      var ChromeSelectedShortcut: TuiStyle := TuiStyle.FromColors(Red, Green);
      var Buttons: TuiButtonPalette := TuiButtonPalette.Create(TuiStyle.FromColors(Black, Green), TuiStyle.FromColors(LightCyan, Green), TuiStyle.FromColors(White, Green), TuiStyle.FromColors(DarkGray, LightGray), TuiStyle.FromColors(Yellow, Green), TuiStyle.FromColors(Yellow, Green), TuiStyle.FromColors(Yellow, Green), TuiStyle.FromColors(Black, LightGray));
      var Inputs: TuiInputPalette := TuiInputPalette.Create(TuiStyle.FromColors(LightGray, Blue), TuiStyle.FromColors(White, Blue), TuiStyle.FromColors(DarkGray, Blue), TuiStyle.FromColors(Blue, LightGray), TuiStyle.FromColors(Yellow, Blue));
      return TuiPalette.Create(Normal, TuiStyle.FromColors(DarkGray, Black), TuiStyle.FromColors(Black, LightCyan), TuiStyle.FromColors(Black, LightGray), TuiStyle.FromColors(LightCyan, Black), Normal, TuiStyle.FromColors(Yellow, Black), ChromeNormal, ChromeDisabled, ChromeShortcut, ChromeSelected, ChromeSelectedShortcut, TuiStyle.FromColors(DarkGray, Black), ChromeNormal, ChromeDisabled, ChromeShortcut, ChromeSelected, Buttons, Inputs, TuiStyle.FromColors(Black, LightGray), TuiStyle.FromColors(White, LightGray), TuiStyle.FromColors(White, LightGray), TuiStyle.FromColors(White, Blue), TuiStyle.FromColors(White, Green), TuiStyle.FromColors(DarkGray, Black), TuiStyle.FromColors(LightRed, Black), TuiStyle.FromColors(Yellow, Black), TuiStyle.FromColors(LightCyan, Black))
    end;

    /// Resolves the concrete style for one semantic role.

    function ForRole(Self: TuiPalette; Role: TuiStyleRole): TuiStyle;
    begin
      case Role of
        TuiStyleRole.Normal:
        begin
          return Self.Normal
        end;
        TuiStyleRole.Disabled:
        begin
          return Self.Disabled
        end;
        TuiStyleRole.Focused:
        begin
          return Self.Focused
        end;
        TuiStyleRole.Selected:
        begin
          return Self.Selected
        end;
        TuiStyleRole.Shortcut:
        begin
          return Self.Shortcut
        end;
        TuiStyleRole.Frame:
        begin
          return Self.Frame
        end;
        TuiStyleRole.Title:
        begin
          return Self.Title
        end;
        TuiStyleRole.MenuNormal:
        begin
          return Self.MenuNormal
        end;
        TuiStyleRole.MenuDisabled:
        begin
          return Self.MenuDisabled
        end;
        TuiStyleRole.MenuShortcut:
        begin
          return Self.MenuShortcut
        end;
        TuiStyleRole.MenuSelected:
        begin
          return Self.MenuSelected
        end;
        TuiStyleRole.MenuSelectedShortcut:
        begin
          return Self.MenuSelectedShortcut
        end;
        TuiStyleRole.MenuShadow:
        begin
          return Self.MenuShadow
        end;
        TuiStyleRole.StatusNormal:
        begin
          return Self.StatusNormal
        end;
        TuiStyleRole.StatusDisabled:
        begin
          return Self.StatusDisabled
        end;
        TuiStyleRole.StatusShortcut:
        begin
          return Self.StatusShortcut
        end;
        TuiStyleRole.StatusSelected:
        begin
          return Self.StatusSelected
        end;
        TuiStyleRole.ButtonNormal, TuiStyleRole.ButtonDefault, TuiStyleRole.ButtonSelected, TuiStyleRole.ButtonDisabled, TuiStyleRole.ButtonShortcut, TuiStyleRole.ButtonDefaultShortcut, TuiStyleRole.ButtonSelectedShortcut, TuiStyleRole.ButtonShadow:
        begin
          return Self.Buttons.ForRole(Role)
        end;
        TuiStyleRole.InputNormal, TuiStyleRole.InputFocused, TuiStyleRole.InputHint, TuiStyleRole.InputCursor, TuiStyleRole.InputScroll:
        begin
          return Self.Inputs.ForRole(Role)
        end;
        TuiStyleRole.DialogNormal:
        begin
          return Self.DialogNormal
        end;
        TuiStyleRole.DialogFrame:
        begin
          return Self.DialogFrame
        end;
        TuiStyleRole.DialogTitle:
        begin
          return Self.DialogTitle
        end;
        TuiStyleRole.DialogInput:
        begin
          return Self.DialogInput
        end;
        TuiStyleRole.DialogInputFocused:
        begin
          return Self.DialogInputFocused
        end;
        TuiStyleRole.DialogShadow:
        begin
          return Self.DialogShadow
        end;
        TuiStyleRole.Failure:
        begin
          return Self.Failure
        end;
        TuiStyleRole.Warning:
        begin
          return Self.Warning
        end
        else
        begin
          return Self.Accent
        end
      end
    end;

    /// Returns a copy with one role replaced; the original palette is unchanged.

    function WithRole(Self: TuiPalette; Role: TuiStyleRole; Style: TuiStyle): TuiPalette;
    begin
      mutable var Updated: TuiPalette := Self;
      case Role of
        TuiStyleRole.Normal:
        begin
          Updated.Normal := Style
        end;
        TuiStyleRole.Disabled:
        begin
          Updated.Disabled := Style
        end;
        TuiStyleRole.Focused:
        begin
          Updated.Focused := Style
        end;
        TuiStyleRole.Selected:
        begin
          Updated.Selected := Style
        end;
        TuiStyleRole.Shortcut:
        begin
          Updated.Shortcut := Style
        end;
        TuiStyleRole.Frame:
        begin
          Updated.Frame := Style
        end;
        TuiStyleRole.Title:
        begin
          Updated.Title := Style
        end;
        TuiStyleRole.MenuNormal:
        begin
          Updated.MenuNormal := Style
        end;
        TuiStyleRole.MenuDisabled:
        begin
          Updated.MenuDisabled := Style
        end;
        TuiStyleRole.MenuShortcut:
        begin
          Updated.MenuShortcut := Style
        end;
        TuiStyleRole.MenuSelected:
        begin
          Updated.MenuSelected := Style
        end;
        TuiStyleRole.MenuSelectedShortcut:
        begin
          Updated.MenuSelectedShortcut := Style
        end;
        TuiStyleRole.MenuShadow:
        begin
          Updated.MenuShadow := Style
        end;
        TuiStyleRole.StatusNormal:
        begin
          Updated.StatusNormal := Style
        end;
        TuiStyleRole.StatusDisabled:
        begin
          Updated.StatusDisabled := Style
        end;
        TuiStyleRole.StatusShortcut:
        begin
          Updated.StatusShortcut := Style
        end;
        TuiStyleRole.StatusSelected:
        begin
          Updated.StatusSelected := Style
        end;
        TuiStyleRole.ButtonNormal, TuiStyleRole.ButtonDefault, TuiStyleRole.ButtonSelected, TuiStyleRole.ButtonDisabled, TuiStyleRole.ButtonShortcut, TuiStyleRole.ButtonDefaultShortcut, TuiStyleRole.ButtonSelectedShortcut, TuiStyleRole.ButtonShadow:
        begin
          Updated.Buttons := Updated.Buttons.WithRole(Role, Style)
        end;
        TuiStyleRole.InputNormal, TuiStyleRole.InputFocused, TuiStyleRole.InputHint, TuiStyleRole.InputCursor, TuiStyleRole.InputScroll:
        begin
          Updated.Inputs := Updated.Inputs.WithRole(Role, Style)
        end;
        TuiStyleRole.DialogNormal:
        begin
          Updated.DialogNormal := Style
        end;
        TuiStyleRole.DialogFrame:
        begin
          Updated.DialogFrame := Style
        end;
        TuiStyleRole.DialogTitle:
        begin
          Updated.DialogTitle := Style
        end;
        TuiStyleRole.DialogInput:
        begin
          Updated.DialogInput := Style
        end;
        TuiStyleRole.DialogInputFocused:
        begin
          Updated.DialogInputFocused := Style
        end;
        TuiStyleRole.DialogShadow:
        begin
          Updated.DialogShadow := Style
        end;
        TuiStyleRole.Failure:
        begin
          Updated.Failure := Style
        end;
        TuiStyleRole.Warning:
        begin
          Updated.Warning := Style
        end
        else
        begin
          Updated.Accent := Style
        end
      end;
      return Updated
    end;
  end;
