unit Std.Tui.Cells.Style;

uses Std.Tui.Cells.Color;

public type
  /// Concrete foreground/background colors and text attributes.
  TuiStyle = record
    public Foreground: TuiColor;
    public Background: TuiColor;
    public Bold: boolean;
    public Dim: boolean;
    public Underline: boolean;
    public Inverse: boolean;

    /// Creates a style with colors and no text attributes.

    public static function FromColors(Foreground: TuiColor; Background: TuiColor): TuiStyle;
    begin
      return record
        Foreground := Foreground;
        Background := Background;
        Bold := false;
        Dim := false;
        Underline := false;
        Inverse := false;
      end
    end;

    /// Creates a style with colors and explicit text attributes.

    public static function Create(
  Foreground: TuiColor;
  Background: TuiColor;
  Bold: boolean;
  Dim: boolean;
  Underline: boolean;
  Inverse: boolean
): TuiStyle;
    begin
      return record
        Foreground := Foreground;
        Background := Background;
        Bold := Bold;
        Dim := Dim;
        Underline := Underline;
        Inverse := Inverse;
      end
    end;
  end;
