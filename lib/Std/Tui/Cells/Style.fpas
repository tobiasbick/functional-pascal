unit Std.Tui.Cells.Style;

uses Std.Tui.Cells.Color as Color;

// Concrete foreground/background colors and text attributes.
public type TuiStyle = record
  // Foreground color.
  public Foreground: Color.TuiColor;
  // Background color.
  public Background: Color.TuiColor;
  // Whether bold rendering is enabled.
  public Bold: boolean;
  // Whether dim rendering is enabled.
  public Dim: boolean;
  // Whether underlined rendering is enabled.
  public Underline: boolean;
  // Whether inverse rendering is enabled.
  public Inverse: boolean;
end record;

// Creates a style with colors and no text attributes.
//
// Parameters:
// - `Foreground`: Foreground color.
// - `Background`: Background color.
public function TuiStyleFromColors(Foreground: Color.TuiColor; Background: Color.TuiColor): TuiStyle;
begin
  return TuiStyle(Foreground := Foreground, Background := Background, Bold := false, Dim := false, Underline := false, Inverse := false);
end function;

// Creates a style with colors and explicit text attributes.
//
// Parameters:
// - `Foreground`: Foreground color.
// - `Background`: Background color.
// - `Bold`: Whether bold text rendering is enabled.
// - `Dim`: Whether dim text rendering is enabled.
// - `Underline`: Whether underlined text rendering is enabled.
// - `Inverse`: Whether inverse text rendering is enabled.
public function TuiStyleCreate(
  Foreground: Color.TuiColor;
  Background: Color.TuiColor;
  Bold: boolean;
  Dim: boolean;
  Underline: boolean;
  Inverse: boolean
): TuiStyle;
begin
  return TuiStyle(Foreground := Foreground, Background := Background, Bold := Bold, Dim := Dim, Underline := Underline, Inverse := Inverse);
end function;

end unit;
