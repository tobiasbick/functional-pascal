unit Std.Tui.Cells.Style;

uses Std.Tui.Cells.Color;

public type
  // Concrete foreground/background colors and text attributes.
  TuiStyle = record
    // Foreground color.
    public Foreground: TuiColor;
    // Background color.
    public Background: TuiColor;
    // Whether bold rendering is enabled.
    public Bold: boolean;
    // Whether dim rendering is enabled.
    public Dim: boolean;
    // Whether underlined rendering is enabled.
    public Underline: boolean;
    // Whether inverse rendering is enabled.
    public Inverse: boolean;

    // Creates a style with colors and no text attributes.
    //
    // Parameters:
    // - `Foreground`: Foreground color.
    // - `Background`: Background color.
    public static function FromColors(Foreground: TuiColor; Background: TuiColor): TuiStyle;
    begin
      return record
        Foreground := Foreground;
        Background := Background;
        Bold := false;
        Dim := false;
        Underline := false;
        Inverse := false;
      end
    end;

    // Creates a style with colors and explicit text attributes.
    //
    // Parameters:
    // - `Foreground`: Foreground color.
    // - `Background`: Background color.
    // - `Bold`: Whether bold text rendering is enabled.
    // - `Dim`: Whether dim text rendering is enabled.
    // - `Underline`: Whether underlined text rendering is enabled.
    // - `Inverse`: Whether inverse text rendering is enabled.
    public static function Create(
  Foreground: TuiColor;
  Background: TuiColor;
  Bold: boolean;
  Dim: boolean;
  Underline: boolean;
  Inverse: boolean
): TuiStyle;
    begin
      return record
        Foreground := Foreground;
        Background := Background;
        Bold := Bold;
        Dim := Dim;
        Underline := Underline;
        Inverse := Inverse;
      end
    end;
  end;
