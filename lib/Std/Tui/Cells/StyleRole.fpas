unit Std.Tui.Cells.StyleRole;

type
  /// Semantic style role resolved through `TuiPalette`.
  TuiStyleRole = enum
    Normal;
    Disabled;
    Focused;
    Selected;
    Shortcut;
    Frame;
    Title;
    MenuNormal;
    MenuDisabled;
    MenuShortcut;
    MenuSelected;
    MenuSelectedShortcut;
    StatusNormal;
    StatusDisabled;
    StatusShortcut;
    StatusSelected;
    DialogNormal;
    DialogFrame;
    DialogTitle;
    DialogInput;
    DialogInputFocused;
    DialogButton;
    DialogButtonFocused;
    DialogShadow;
    Failure;
    Warning;
    Accent;
  end;
