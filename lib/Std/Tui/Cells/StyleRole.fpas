    MenuNormal;
    MenuDisabled;
    MenuShortcut;
    MenuSelected;
    MenuSelectedShortcut;
    StatusNormal;
    StatusDisabled;
    StatusShortcut;
    StatusSelected;
    ButtonNormal;
    ButtonDefault;
    ButtonSelected;
    ButtonDisabled;
    ButtonShortcut;
    ButtonDefaultShortcut;
    ButtonSelectedShortcut;
    InputNormal;
    InputFocused;
    InputHint;
    InputCursor;
    InputScroll;
    Rule;
    GaugeTrack;
    GaugeFill;
    Failure;
    Warning;
    Accent;
  end;
