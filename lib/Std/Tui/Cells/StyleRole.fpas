    Frame;
    // Represents the `Title` variant of `TuiStyleRole`.
    Title;
    // Represents the `MenuNormal` variant of `TuiStyleRole`.
    MenuNormal;
    // Represents the `MenuDisabled` variant of `TuiStyleRole`.
    MenuDisabled;
    // Represents the `MenuShortcut` variant of `TuiStyleRole`.
    MenuShortcut;
    // Represents the `MenuSelected` variant of `TuiStyleRole`.
    MenuSelected;
    // Represents the `MenuSelectedShortcut` variant of `TuiStyleRole`.
    MenuSelectedShortcut;
    // Represents the `StatusNormal` variant of `TuiStyleRole`.
    StatusNormal;
    // Represents the `StatusDisabled` variant of `TuiStyleRole`.
    StatusDisabled;
    // Represents the `StatusShortcut` variant of `TuiStyleRole`.
    StatusShortcut;
    // Represents the `StatusSelected` variant of `TuiStyleRole`.
    StatusSelected;
    // Represents the `ButtonNormal` variant of `TuiStyleRole`.
    ButtonNormal;
    // Represents the `ButtonDefault` variant of `TuiStyleRole`.
    ButtonDefault;
    // Represents the `ButtonSelected` variant of `TuiStyleRole`.
    ButtonSelected;
