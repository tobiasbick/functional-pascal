unit Std.Tui.Cells.StyleRole;

type
  /// Semantic style role resolved through `TuiPalette`.
  TuiStyleRole = enum
    Normal;
    Disabled;
    Focused;
    Selected;
    Shortcut;
    Frame;
    Title;
    MenuNormal;
    MenuDisabled;
    MenuShortcut;
    MenuSelected;
    MenuSelectedShortcut;
    MenuShadow;
    StatusNormal;
    StatusDisabled;
    StatusShortcut;
    StatusSelected;
    ButtonNormal;
    ButtonDefault;
    ButtonSelected;
    ButtonDisabled;
    ButtonShortcut;
    ButtonDefaultShortcut;
    ButtonSelectedShortcut;
    ButtonShadow;
    InputNormal;
    InputFocused;
    InputHint;
    InputCursor;
    InputScroll;
    DialogNormal;
    DialogFrame;
    DialogTitle;
    DialogInput;
    DialogInputFocused;
    DialogShadow;
    Failure;
    Warning;
    Accent;
  end;
