unit Std.Tui.Chrome.Button;

uses Std.Tui.Ids.Action as Action2;
uses Std.Tui.Ids.ControlId as ControlId;

// Immutable description of one flat terminal button.
public type TuiButtonSpec = record
  // Stable identifier of the value.
  public Id: ControlId.TuiControlId;
  // Text stored or displayed by the value.
  public Text: string;
  // Keyboard mnemonic used to activate the item.
  public Mnemonic: string;
  // Application action associated with the value.
  public Action: Action2.TuiAction;
  // Style used for the default state.
  public Default: boolean;
  // Whether the item can be activated.
  public Enabled: boolean;
end record;

// Creates an enabled normal button.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Text`: Text processed or displayed by the operation.
// - `Mnemonic`: Keyboard mnemonic used to activate the item.
// - `Action`: Application action associated with the control or emitted message.
public function TuiButtonSpecNormal(
  Id: ControlId.TuiControlId;
  Text: string;
  Mnemonic: string;
  Action: Action2.TuiAction
): TuiButtonSpec;
begin
  return TuiButtonSpec(Id := Id, Text := Text, Mnemonic := Mnemonic, Action := Action, Default := false, Enabled := true);
end function;

// Creates an enabled default button.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Text`: Text processed or displayed by the operation.
// - `Mnemonic`: Keyboard mnemonic used to activate the item.
// - `Action`: Application action associated with the control or emitted message.
public function TuiButtonSpecDefaultButton(
  Id: ControlId.TuiControlId;
  Text: string;
  Mnemonic: string;
  Action: Action2.TuiAction
): TuiButtonSpec;
begin
  return TuiButtonSpec(Id := Id, Text := Text, Mnemonic := Mnemonic, Action := Action, Default := true, Enabled := true);
end function;

// Creates a disabled normal button.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Text`: Text processed or displayed by the operation.
// - `Mnemonic`: Keyboard mnemonic used to activate the item.
// - `Action`: Application action associated with the control or emitted message.
public function TuiButtonSpecDisabled(
  Id: ControlId.TuiControlId;
  Text: string;
  Mnemonic: string;
  Action: Action2.TuiAction
): TuiButtonSpec;
begin
  return TuiButtonSpec(Id := Id, Text := Text, Mnemonic := Mnemonic, Action := Action, Default := false, Enabled := false);
end function;

end unit;
