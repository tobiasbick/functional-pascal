unit Std.Tui.Chrome.Button;

uses Std.Tui.Ids.Action, Std.Tui.Ids.ControlId;

public type
  // Immutable description of one flat terminal button.
  TuiButtonSpec = record
    public Id: TuiControlId;
    public Text: string;
    public Mnemonic: string;
    public Action: TuiAction;
    public Default: boolean;
    public Enabled: boolean;

    // Creates an enabled normal button.
    public static function Normal(Id: TuiControlId; Text: string; Mnemonic: string; Action: TuiAction): TuiButtonSpec;
    begin
      return record
        Id := Id;
        Text := Text;
        Mnemonic := Mnemonic;
        Action := Action;
        Default := false;
        Enabled := true;
      end
    end;

    // Creates an enabled default button.
    public static function DefaultButton(Id: TuiControlId; Text: string; Mnemonic: string; Action: TuiAction): TuiButtonSpec;
    begin
      return record
        Id := Id;
        Text := Text;
        Mnemonic := Mnemonic;
        Action := Action;
        Default := true;
        Enabled := true;
      end
    end;

    // Creates a disabled normal button.
    public static function Disabled(Id: TuiControlId; Text: string; Mnemonic: string; Action: TuiAction): TuiButtonSpec;
    begin
      return record
        Id := Id;
        Text := Text;
        Mnemonic := Mnemonic;
        Action := Action;
        Default := false;
        Enabled := false;
      end
    end;
  end;
