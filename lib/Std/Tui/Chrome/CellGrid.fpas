unit Std.Tui.Chrome.CellGrid;

uses Std.Arrays as Arrays;
uses Std.Tui.Cells.Cell as Cell;

// Immutable rectangular grid of concrete or theme-resolved terminal cells.
public type TuiCellGrid = record
  // Width in terminal cells.
  public Width: integer;
  // Height in terminal cells.
  public Height: integer;
  // Row-major terminal cells.
  public Cells: array of (Cell.TuiCell);

  // Creates a row-major cell grid.
  //
  // Parameters:
  // - `Width`: Width in terminal cells.
  // - `Height`: Height in terminal cells.
  // - `Cells`: Row-major terminal cells used to populate the grid.
  public static function Create(Width: integer; Height: integer; Cells: array of (Cell.TuiCell)): TuiCellGrid;
  begin
    if (Width < 0) or (Height < 0) then
      begin
        panic('Tui cell grid dimensions must be non-negative');
      end;
    end if;

    if Arrays.Length(Cells) <> Width * Height then
      begin
        panic('Tui cell grid length must equal width times height');
      end;
    end if;

    return TuiCellGrid(Width := Width, Height := Height, Cells := Cells);
  end function;
end record;

end unit;
