unit Std.Tui.Chrome.Gauge;

public type
  /// Immutable bounded value displayed as a compact dashboard gauge.
  TuiGauge = record
    public LabelText: string;
    public Value: integer;
    public Maximum: integer;

    /// Creates a gauge; validation rejects invalid ranges during rendering.

    public static function Create(LabelText: string; Value: integer; Maximum: integer): TuiGauge;
    begin
      return record LabelText := LabelText; Value := Value; Maximum := Maximum; end
    end;
  end;
