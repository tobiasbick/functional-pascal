unit Std.Tui.Chrome.Input;

uses Std.Tui.Ids.Action as Action;
uses Std.Tui.Ids.ControlId as ControlId;

// Immutable controlled one-line input state and optional history.
public type TuiInputSpec = record
  // Stable identifier of the value.
  public Id: ControlId.TuiControlId;
  // Text stored or displayed by the value.
  public Text: string;
  // Zero-based character index of the caret.
  public Caret: integer;
  // Hint text or style for an empty input.
  public Hint: string;
  // Ordered input-history entries.
  public History: array of (string);
  // Editable text retained while browsing input history.
  public HistoryDraft: string;
  // Action emitted when the controlled value changes.
  public ChangeAction: Action.TuiAction;
end record;

// Creates an input without a hint or history.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Text`: Text processed or displayed by the operation.
// - `Caret`: Zero-based character index of the caret.
// - `ChangeAction`: Application action emitted when the value changes.
public function TuiInputSpecCreate(
  Id: ControlId.TuiControlId;
  Text: string;
  Caret: integer;
  ChangeAction: Action.TuiAction
): TuiInputSpec;
begin
  return TuiInputSpec(Id := Id, Text := Text, Caret := Caret, Hint := '', History := [], HistoryDraft := '', ChangeAction := ChangeAction);
end function;

// Creates an input that paints a hint while its text is empty.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Text`: Text processed or displayed by the operation.
// - `Caret`: Zero-based character index of the caret.
// - `Hint`: Hint text displayed for an empty input.
// - `ChangeAction`: Application action emitted when the value changes.
public function TuiInputSpecWithHint(
  Id: ControlId.TuiControlId;
  Text: string;
  Caret: integer;
  Hint: string;
  ChangeAction: Action.TuiAction
): TuiInputSpec;
begin
  return TuiInputSpec(Id := Id, Text := Text, Caret := Caret, Hint := Hint, History := [], HistoryDraft := '', ChangeAction := ChangeAction);
end function;

// Creates an input with oldest-to-newest Up/Down history and a restorable draft.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Text`: Text processed or displayed by the operation.
// - `Caret`: Zero-based character index of the caret.
// - `Hint`: Hint text displayed for an empty input.
// - `History`: Ordered input-history entries.
// - `HistoryDraft`: Current editable text retained while browsing history.
// - `ChangeAction`: Application action emitted when the value changes.
public function TuiInputSpecWithHistory(
  Id: ControlId.TuiControlId;
  Text: string;
  Caret: integer;
  Hint: string;
  History: array of (string);
  HistoryDraft: string;
  ChangeAction: Action.TuiAction
): TuiInputSpec;
begin
  return TuiInputSpec(Id := Id, Text := Text, Caret := Caret, Hint := Hint, History := History, HistoryDraft := HistoryDraft, ChangeAction := ChangeAction);
end function;

end unit;
