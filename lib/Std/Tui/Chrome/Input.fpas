unit Std.Tui.Chrome.Input;

uses Std.Tui.Ids.Action, Std.Tui.Ids.ControlId;

type
  /// Immutable controlled one-line input state and optional history.
  TuiInputSpec = record
    Id: TuiControlId;
    Text: string;
    Caret: integer;
    Hint: string;
    History: array of string;
    HistoryDraft: string;
    ChangeAction: TuiAction;

    /// Creates an input without a hint or history.

    static function Create(Id: TuiControlId; Text: string; Caret: integer; ChangeAction: TuiAction): TuiInputSpec;
    begin
      return record
        Id := Id;
        Text := Text;
        Caret := Caret;
        Hint := '';
        History := [];
        HistoryDraft := '';
        ChangeAction := ChangeAction;
      end
    end;

    /// Creates an input that paints a hint while its text is empty.

    static function WithHint(
  Id: TuiControlId;
  Text: string;
  Caret: integer;
  Hint: string;
  ChangeAction: TuiAction
): TuiInputSpec;
    begin
      return record
        Id := Id;
        Text := Text;
        Caret := Caret;
        Hint := Hint;
        History := [];
        HistoryDraft := '';
        ChangeAction := ChangeAction;
      end
    end;

    /// Creates an input with oldest-to-newest Up/Down history and a restorable draft.

    static function WithHistory(
  Id: TuiControlId;
  Text: string;
  Caret: integer;
  Hint: string;
  History: array of string;
  HistoryDraft: string;
  ChangeAction: TuiAction
): TuiInputSpec;
    begin
      return record
        Id := Id;
        Text := Text;
        Caret := Caret;
        Hint := Hint;
        History := History;
        HistoryDraft := HistoryDraft;
        ChangeAction := ChangeAction;
      end
    end;
  end;
