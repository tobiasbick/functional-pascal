unit Std.Tui.Chrome.KeyGesture;

uses Std.Console as Console;
uses Std.Str as Str;

// Structural keyboard gesture used by menu commands.
public type TuiKeyGesture = record
  // Variant kind represented by the value.
  public Kind: Console.KeyKind;
  // Character component of the key gesture.
  public Character: string;
  // Whether the Shift modifier is active.
  public Shift: boolean;
  // Whether the Ctrl modifier is active.
  public Ctrl: boolean;
  // Whether the Alt modifier is active.
  public Alt: boolean;
  // Whether the Meta modifier is active.
  public Meta: boolean;
  // Human-readable representation of the gesture.
  public Display: string;
end record;

// Creates a keyboard gesture and its menu display label.
//
// Parameters:
// - `Kind`: Variant kind assigned to the value.
// - `Character`: Character used by the drawing operation.
// - `Shift`: Whether the Shift modifier is active.
// - `Ctrl`: Whether the Ctrl modifier is active.
// - `Alt`: Whether the Alt modifier is active.
// - `Meta`: Whether the Meta modifier is active.
// - `Display`: Text displayed by the element.
public function TuiKeyGestureCreate(
  Kind: Console.KeyKind;
  Character: string;
  Shift: boolean;
  Ctrl: boolean;
  Alt: boolean;
  Meta: boolean;
  Display: string
): TuiKeyGesture;
begin
  return TuiKeyGesture(Kind := Kind, Character := Character, Shift := Shift, Ctrl := Ctrl, Alt := Alt, Meta := Meta, Display := Display);
end function;

// Reports whether a console key event matches this gesture.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Key`: Console key event to route or match.
public function TuiKeyGestureMatches(Receiver: TuiKeyGesture; Key: Console.KeyEvent): boolean;
begin
  if ((((Receiver.Kind <> Key.kind) or (Receiver.Shift <> Key.shift)) or (Receiver.Ctrl <> Key.ctrl)) or (Receiver.Alt <> Key.alt)) or
     (Receiver.Meta <> Key.meta) then
    begin
      return false;
    end;
  end if;

  if Receiver.Kind = Console.KeyKind.Character then
    begin
      return Str.ToLower(Receiver.Character) = Str.ToLower(Key.ch);
    end;
  end if;

  return true;
end function;

end unit;
