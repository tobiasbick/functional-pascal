unit Std.Tui.Chrome.MenuGeometry;

uses Std.Console, Std.Tui.Chrome.MenuNode, Std.Tui.Chrome.MenuQuery, Std.Tui.Geometry.Rect;

// Bounds of one open popup and the submenu whose children it displays.
public type TuiMenuPopup = record
  // Parent menu-node identifier.
  public Parent: TuiMenuNodeId;
  // Rectangle occupied by the value.
  public Bounds: TuiRect;
end record;

function TuiMenuRootItemX(Nodes: array of TuiMenuNode; BarBounds: TuiRect; Target: TuiMenuNodeId): integer;
begin
  var X: integer := BarBounds.X;
  for Index: integer := 0 to Nodes.Length() - 1 do
    begin
      case TuiMenuNodeParent(Nodes[Index]) of
        when Some(Parent):
          begin
          end;
        when None:
          begin
            if TuiMenuNodeIdOf(Nodes[Index]).Value = Target.Value then
              begin
                return X;
              end;
            end if;

            X := (X + Std.Console.DisplayWidth(TuiMenuNodeText(Nodes[Index]))) + 2;
          end;
      end case;
    end;
  end for;

  return BarBounds.X;
end function;

function TuiMenuChildRow(Nodes: array of TuiMenuNode; Parent: TuiMenuNodeId; Target: TuiMenuNodeId): integer;
begin
  var Row: integer := 0;
  for Index: integer := 0 to Nodes.Length() - 1 do
    begin
      if TuiMenuHasParent(Nodes[Index], Some(Parent)) then
        begin
          if TuiMenuNodeIdOf(Nodes[Index]).Value = Target.Value then
            begin
              return Row;
            end;
          end if;

          Row := Row + 1;
        end;
      end if;
    end;
  end for;

  return 0;
end function;

function TuiMenuPopupSize(Nodes: array of TuiMenuNode; Parent: TuiMenuNodeId): TuiRect;
begin
  var Width: integer := 4;
  var Height: integer := 2;
  for Index: integer := 0 to Nodes.Length() - 1 do
    begin
      if TuiMenuHasParent(Nodes[Index], Some(Parent)) then
        begin
          Height := Height + 1;
          var ContentWidth: integer := Std.Console.DisplayWidth(TuiMenuNodeText(Nodes[Index]));
          case TuiMenuNodeShortcut(Nodes[Index]) of
            when Some(Shortcut):
              begin
                ContentWidth := (ContentWidth + Std.Console.DisplayWidth(Shortcut.Display)) + 2;
              end;
            when None:
              begin
              end;
          end case;

          if TuiMenuNodeIsSubmenu(Nodes[Index]) then
            begin
              ContentWidth := ContentWidth + 2;
            end;
          end if;

          if ContentWidth + 4 > Width then
            begin
              Width := ContentWidth + 4;
            end;
          end if;
        end;
      end if;
    end;
  end for;

  return TuiRect.Create(0, 0, Width, Height);
end function;

function TuiMenuOpenParents(Nodes: array of TuiMenuNode; State: TuiMenuState): array of TuiMenuNodeId;
begin
  var Reversed: array of TuiMenuNodeId := [];
  var Opened: array of TuiMenuNodeId := [];
  if not State.Open then
    begin
      return [];
    end;
  end if;

  case State.Active of
    when Some(Active):
      begin
        var Current: TuiMenuNodeId := Active;
        var CurrentIndex: integer := TuiMenuFind(Nodes, Current);
        if not TuiMenuNodeIsSubmenu(Nodes[CurrentIndex]) then
          begin
            case TuiMenuNodeParent(Nodes[CurrentIndex]) of
              when Some(Parent):
                begin
                  Current := Parent;
                end;
              when None:
                begin
                end;
            end case;
          end;
        end if;
        var Remaining: integer := Nodes.Length() + 1;
        while Remaining > 0 do
          begin
            Remaining := Remaining - 1;
            Reversed.Push(Current);
            CurrentIndex := TuiMenuFind(Nodes, Current);
            case TuiMenuNodeParent(Nodes[CurrentIndex]) of
              when Some(Parent):
                begin
                  Current := Parent;
                end;
              when None:
                begin
                  Remaining := 0;
                end;
            end case;
          end;
        end while;
      end;
    when None:
      begin
      end;
  end case;
  var Index: integer := Reversed.Length() - 1;
  while Index >= 0 do
    begin
      Opened.Push(Reversed[Index]);
      Index := Index - 1;
    end;
  end while;

  return Opened;
end function;

// Computes popup rectangles while reserving their right and bottom terminal shadow.
//
// Parameters:
// - `Nodes`: Flat ordered menu-node collection.
// - `State`: Controlled state used by the operation.
// - `BarBounds`: Arranged bounds of the menu bar.
// - `TerminalBounds`: Bounds of the terminal viewport.
public function TuiMenuPopupGeometry(
  Nodes: array of TuiMenuNode;
  State: TuiMenuState;
  BarBounds: TuiRect;
  TerminalBounds: TuiRect
): array of TuiMenuPopup;
begin
  var PopupBounds: TuiRect := TerminalBounds;
  if PopupBounds.Width > 2 then
    begin
      PopupBounds.Width := PopupBounds.Width - 2;
    end;
  end if;

  if PopupBounds.Height > 1 then
    begin
      PopupBounds.Height := PopupBounds.Height - 1;
    end;
  end if;
  const Parents: array of TuiMenuNodeId := TuiMenuOpenParents(Nodes, State);
  var Popups: array of TuiMenuPopup := [];
  for Index: integer := 0 to Parents.Length() - 1 do
    begin
      const Size: TuiRect := TuiMenuPopupSize(Nodes, Parents[Index]);
      var X: integer := TuiMenuRootItemX(Nodes, BarBounds, Parents[0]);
      var Y: integer := BarBounds.Y + 1;
      if Index > 0 then
        begin
          const Previous: TuiMenuPopup := Popups[Index - 1];
          X := Previous.Bounds.X + Previous.Bounds.Width;
          Y := (Previous.Bounds.Y + 1) + TuiMenuChildRow(Nodes, Previous.Parent, Parents[Index]);
        end;
      end if;

      if X + Size.Width > PopupBounds.X + PopupBounds.Width then
        begin
          if Index > 0 then
            begin
              X := Popups[Index - 1].Bounds.X - Size.Width;
            end;
          else
            begin
              X := (PopupBounds.X + PopupBounds.Width) - Size.Width;
            end;
          end if;
        end;
      end if;

      if X < PopupBounds.X then
        begin
          X := PopupBounds.X;
        end;
      end if;

      if Y + Size.Height > PopupBounds.Y + PopupBounds.Height then
        begin
          Y := (PopupBounds.Y + PopupBounds.Height) - Size.Height;
        end;
      end if;

      if Y < PopupBounds.Y then
        begin
          Y := PopupBounds.Y;
        end;
      end if;

      Popups.Push(record
        Parent := Parents[Index];
        Bounds := TuiRect.Create(X, Y, Size.Width, Size.Height);
      end);
    end;
  end for;

  return Popups;
end function;
end unit;
