unit Std.Tui.Chrome.MenuItem;

uses Std.Tui.Ids.Action as Action2;
uses Std.Tui.Ids.ControlId as ControlId;

// Immutable description of one flat menu-bar action.
public type TuiMenuItem = record
  // Stable identifier of the value.
  public Id: ControlId.TuiControlId;
  // Text stored or displayed by the value.
  public Text: string;
  // Application action associated with the value.
  public Action: Action2.TuiAction;
  // Whether the item can be activated.
  public Enabled: boolean;
  // Shortcut text, gesture, or style.
  public Shortcut: string;

  // Creates an enabled menu item without a shortcut hint.
  //
  // Parameters:
  // - `Id`: Identifier assigned to the created or selected value.
  // - `Text`: Text processed or displayed by the operation.
  // - `Action`: Application action associated with the control or emitted message.
  public static function Create(Id: ControlId.TuiControlId; Text: string; Action: Action2.TuiAction): TuiMenuItem;
  begin
    return TuiMenuItem(Id := Id, Text := Text, Action := Action, Enabled := true, Shortcut := '');
  end function;

  // Creates a disabled menu item without a shortcut hint.
  //
  // Parameters:
  // - `Id`: Identifier assigned to the created or selected value.
  // - `Text`: Text processed or displayed by the operation.
  // - `Action`: Application action associated with the control or emitted message.
  public static function Disabled(Id: ControlId.TuiControlId; Text: string; Action: Action2.TuiAction): TuiMenuItem;
  begin
    return TuiMenuItem(Id := Id, Text := Text, Action := Action, Enabled := false, Shortcut := '');
  end function;

  // Creates an enabled menu item with a display-only shortcut hint.
  //
  // Parameters:
  // - `Id`: Identifier assigned to the created or selected value.
  // - `Text`: Text processed or displayed by the operation.
  // - `Action`: Application action associated with the control or emitted message.
  // - `Shortcut`: Shortcut gesture or display text.
  public static function WithShortcut(
  Id: ControlId.TuiControlId;
  Text: string;
  Action: Action2.TuiAction;
  Shortcut: string
): TuiMenuItem;
  begin
    return TuiMenuItem(Id := Id, Text := Text, Action := Action, Enabled := true, Shortcut := Shortcut);
  end function;
end record;

end unit;
