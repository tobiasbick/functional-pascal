unit Std.Tui.Chrome.MenuNode;

uses Std.Options as Options;
uses Std.Tui.Chrome.KeyGesture as KeyGesture;
uses Std.Tui.Ids.Action as Action2;

// Positive identity of one node in a flat menu definition.
public type TuiMenuNodeId = record
  // Validated scalar value represented by the record.
  public Value: integer;
end record;

// Creates a validated menu-node identity.
//
// Parameters:
// - `Value`: Value used to create or update the result.
public function TuiMenuNodeIdCreate(Value: integer): TuiMenuNodeId;
begin
  if Value <= 0 then
    begin
      panic('Tui menu node id must be positive');
    end;
  end if;

  return TuiMenuNodeId(Value := Value);
end function;

// One flat menu node. Parent ids form the hierarchy without recursive arrays.
public type TuiMenuNode = enum
  // Represents the `Command` variant of `TuiMenuNode`.
  //
  // Parameters:
  // - `Id`: Identifier carried by the variant.
  // - `Parent`: Optional parent menu-node identifier.
  // - `Text`: Text carried or displayed by the variant.
  // - `Mnemonic`: Keyboard mnemonic used to activate the item.
  // - `Action`: Application action carried by the variant.
  // - `Enabled`: Whether the represented item is enabled.
  // - `Shortcut`: Optional keyboard shortcut.
  Command(Id: TuiMenuNodeId; Parent: Option of (TuiMenuNodeId); Text: string; Mnemonic: string; Action: Action2.TuiAction; Enabled: boolean; Shortcut: Option of (KeyGesture.TuiKeyGesture));
  // Represents the `Submenu` variant of `TuiMenuNode`.
  //
  // Parameters:
  // - `Id`: Identifier carried by the variant.
  // - `Parent`: Optional parent menu-node identifier.
  // - `Text`: Text carried or displayed by the variant.
  // - `Mnemonic`: Keyboard mnemonic used to activate the item.
  // - `Enabled`: Whether the represented item is enabled.
  Submenu(Id: TuiMenuNodeId; Parent: Option of (TuiMenuNodeId); Text: string; Mnemonic: string; Enabled: boolean);
  // Represents the `Separator` variant of `TuiMenuNode`.
  //
  // Parameters:
  // - `Id`: Identifier carried by the variant.
  // - `Parent`: Optional parent menu-node identifier.
  Separator(Id: TuiMenuNodeId; Parent: Option of (TuiMenuNodeId));
end enum;

// Model-owned open and active state of a controlled menu.
public type TuiMenuState = record
  // Whether the menu is open.
  public Open: boolean;
  // Currently active menu-node identifier.
  public Active: Option of (TuiMenuNodeId);
end record;

// Creates a closed menu state.
public function TuiMenuStateClosed(): TuiMenuState;
begin
  return TuiMenuState(Open := false, Active := Option.None);
end function;

// Creates an open menu state with one active node.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
public function TuiMenuStateOpenAt(Id: TuiMenuNodeId): TuiMenuState;
begin
  return TuiMenuState(Open := true, Active := Option.Some(Id));
end function;

// Creates an enabled submenu.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Parent`: Optional parent menu-node identifier.
// - `Text`: Text processed or displayed by the operation.
// - `Mnemonic`: Keyboard mnemonic used to activate the item.
public function TuiMenuNodeSubmenu(
  Id: TuiMenuNodeId;
  Parent: Option of (TuiMenuNodeId);
  Text: string;
  Mnemonic: string
): TuiMenuNode;
begin
  return TuiMenuNode.Submenu(Id, Parent, Text, Mnemonic, true);
end function;

// Creates an enabled command without a shortcut.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Parent`: Optional parent menu-node identifier.
// - `Text`: Text processed or displayed by the operation.
// - `Mnemonic`: Keyboard mnemonic used to activate the item.
// - `Action`: Application action associated with the control or emitted message.
public function TuiMenuNodeCommand(
  Id: TuiMenuNodeId;
  Parent: Option of (TuiMenuNodeId);
  Text: string;
  Mnemonic: string;
  Action: Action2.TuiAction
): TuiMenuNode;
begin
  return TuiMenuNode.Command(Id, Parent, Text, Mnemonic, Action, true, Option.None);
end function;

// Creates an enabled command with a structural shortcut.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Parent`: Optional parent menu-node identifier.
// - `Text`: Text processed or displayed by the operation.
// - `Mnemonic`: Keyboard mnemonic used to activate the item.
// - `Action`: Application action associated with the control or emitted message.
// - `Shortcut`: Shortcut gesture or display text.
public function TuiMenuNodeCommandWithShortcut(
  Id: TuiMenuNodeId;
  Parent: Option of (TuiMenuNodeId);
  Text: string;
  Mnemonic: string;
  Action: Action2.TuiAction;
  Shortcut: KeyGesture.TuiKeyGesture
): TuiMenuNode;
begin
  return TuiMenuNode.Command(Id, Parent, Text, Mnemonic, Action, true, Option.Some(Shortcut));
end function;

// Creates a disabled command.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Parent`: Optional parent menu-node identifier.
// - `Text`: Text processed or displayed by the operation.
// - `Mnemonic`: Keyboard mnemonic used to activate the item.
// - `Action`: Application action associated with the control or emitted message.
public function TuiMenuNodeDisabledCommand(
  Id: TuiMenuNodeId;
  Parent: Option of (TuiMenuNodeId);
  Text: string;
  Mnemonic: string;
  Action: Action2.TuiAction
): TuiMenuNode;
begin
  return TuiMenuNode.Command(Id, Parent, Text, Mnemonic, Action, false, Option.None);
end function;

// Creates a separator under one submenu.
//
// Parameters:
// - `Id`: Identifier assigned to the created or selected value.
// - `Parent`: Optional parent menu-node identifier.
public function TuiMenuNodeSeparator(Id: TuiMenuNodeId; Parent: TuiMenuNodeId): TuiMenuNode;
begin
  return TuiMenuNode.Separator(Id, Option.Some(Parent));
end function;

end unit;
