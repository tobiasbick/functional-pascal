unit Std.Tui.Chrome.MenuQuery;

uses Std.Arrays as Arrays;
uses Std.Options as Options;
uses Std.Tui.Chrome.KeyGesture as KeyGesture;
uses Std.Tui.Chrome.MenuNode as MenuNode;
uses Std.Tui.Ids.Action as Action2;

// Returns a menu node's identity.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMenuNodeIdOf(Node: MenuNode.TuiMenuNode): MenuNode.TuiMenuNodeId;
begin
  case Node of
    when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
      begin
        return Id;
      end;
    when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
      begin
        return Id;
      end;
    when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
      begin
        return Id;
      end;
  end case;
end function;

// Returns a menu node's parent.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMenuNodeParent(Node: MenuNode.TuiMenuNode): Option of (MenuNode.TuiMenuNodeId);
begin
  case Node of
    when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
      begin
        return Parent;
      end;
    when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
      begin
        return Parent;
      end;
    when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
      begin
        return Parent;
      end;
  end case;
end function;

// Returns a menu node's label, or an empty string for a separator.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMenuNodeText(Node: MenuNode.TuiMenuNode): string;
begin
  case Node of
    when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
      begin
        return Text;
      end;
    when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
      begin
        return Text;
      end;
    when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
      begin
        return '';
      end;
  end case;
end function;

// Returns a menu node's mnemonic, or an empty string for a separator.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMenuNodeMnemonic(Node: MenuNode.TuiMenuNode): string;
begin
  case Node of
    when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
      begin
        return Mnemonic;
      end;
    when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
      begin
        return Mnemonic;
      end;
    when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
      begin
        return '';
      end;
  end case;
end function;

// Reports whether a node can be selected.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMenuNodeSelectable(Node: MenuNode.TuiMenuNode): boolean;
begin
  case Node of
    when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
      begin
        return Enabled;
      end;
    when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
      begin
        return Enabled;
      end;
    when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
      begin
        return false;
      end;
  end case;
end function;

// Reports whether a node opens a child menu.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMenuNodeIsSubmenu(Node: MenuNode.TuiMenuNode): boolean;
begin
  case Node of
    when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
      begin
        return true;
      end;
    when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
      begin
        return false;
      end;
    when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
      begin
        return false;
      end;
  end case;
end function;

// Returns a command action when the node is a command.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMenuNodeAction(Node: MenuNode.TuiMenuNode): Option of (Action2.TuiAction);
begin
  case Node of
    when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
      begin
        return Option.Some(Action);
      end;
    when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
      begin
        return Option.None;
      end;
    when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
      begin
        return Option.None;
      end;
  end case;
end function;

// Returns a command shortcut when present.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMenuNodeShortcut(Node: MenuNode.TuiMenuNode): Option of (KeyGesture.TuiKeyGesture);
begin
  case Node of
    when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
      begin
        return Shortcut;
      end;
    when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
      begin
        return Option.None;
      end;
    when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
      begin
        return Option.None;
      end;
  end case;
end function;

// Finds a node index by identity, or returns `-1`.
//
// Parameters:
// - `Nodes`: Flat ordered menu-node collection.
// - `Id`: Identifier assigned to the created or selected value.
public function TuiMenuFind(Nodes: array of (MenuNode.TuiMenuNode); Id: MenuNode.TuiMenuNodeId): integer;
begin
  for Index: integer := 0 to Arrays.Length(Nodes) - 1 do
    begin
      if TuiMenuNodeIdOf(Nodes[Index]).Value = Id.Value then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Reports whether a node has the supplied parent.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
// - `Parent`: Optional parent menu-node identifier.
public function TuiMenuHasParent(Node: MenuNode.TuiMenuNode; Parent: Option of (MenuNode.TuiMenuNodeId)): boolean;
begin
  case TuiMenuNodeParent(Node) of
    when Option.Some(const NodeParent):
      begin
        case Parent of
          when Option.Some(const Expected):
            begin
              return NodeParent.Value = Expected.Value;
            end;
          when Option.None:
            begin
              return false;
            end;
        end case;
      end;
    when Option.None:
      begin
        case Parent of
          when Option.Some(const Expected):
            begin
              return false;
            end;
          when Option.None:
            begin
              return true;
            end;
        end case;
      end;
  end case;
end function;

// Returns the first selectable child of a parent.
//
// Parameters:
// - `Nodes`: Flat ordered menu-node collection.
// - `Parent`: Optional parent menu-node identifier.
public function TuiMenuFirstSelectable(
  Nodes: array of (MenuNode.TuiMenuNode);
  Parent: Option of (MenuNode.TuiMenuNodeId)
): Option of (MenuNode.TuiMenuNodeId);
begin
  for Index: integer := 0 to Arrays.Length(Nodes) - 1 do
    begin
      if TuiMenuHasParent(Nodes[Index], Parent) and TuiMenuNodeSelectable(Nodes[Index]) then
        begin
          return Option.Some(TuiMenuNodeIdOf(Nodes[Index]));
        end;
      end if;
    end;
  end for;

  return Option.None;
end function;

// Returns the next selectable sibling, wrapping in the requested direction.
//
// Parameters:
// - `Nodes`: Flat ordered menu-node collection.
// - `Current`: Current extent used by the calculation.
// - `Direction`: Direction of the requested movement.
public function TuiMenuNextSelectable(
  Nodes: array of (MenuNode.TuiMenuNode);
  Current: MenuNode.TuiMenuNodeId;
  Direction: integer
): Option of (MenuNode.TuiMenuNodeId);
begin
  const CurrentIndex: integer := TuiMenuFind(Nodes, Current);
  if CurrentIndex < 0 then
    begin
      return Option.None;
    end;
  end if;
  const Parent: Option of (MenuNode.TuiMenuNodeId) := TuiMenuNodeParent(Nodes[CurrentIndex]);
  var Siblings: array of (MenuNode.TuiMenuNodeId) := [];
  for Index: integer := 0 to Arrays.Length(Nodes) - 1 do
    begin
      if TuiMenuHasParent(Nodes[Index], Parent) and TuiMenuNodeSelectable(Nodes[Index]) then
        begin
          Arrays.Push(var Siblings, TuiMenuNodeIdOf(Nodes[Index]));
        end;
      end if;
    end;
  end for;

  if Arrays.Length(Siblings) = 0 then
    begin
      return Option.None;
    end;
  end if;
  var Position: integer := 0;
  for Index: integer := 0 to Arrays.Length(Siblings) - 1 do
    begin
      if Siblings[Index].Value = Current.Value then
        begin
          Position := Index;
        end;
      end if;
    end;
  end for;

  Position := Position + Direction;
  if Position < 0 then
    begin
      Position := Arrays.Length(Siblings) - 1;
    end;
  else
    if Position >= Arrays.Length(Siblings) then
      begin
        Position := 0;
      end;
    end if;
  end if;

  return Option.Some(Siblings[Position]);
end function;

// Returns the root ancestor of one node.
//
// Parameters:
// - `Nodes`: Flat ordered menu-node collection.
// - `Id`: Identifier assigned to the created or selected value.
public function TuiMenuRootOf(Nodes: array of (MenuNode.TuiMenuNode); Id: MenuNode.TuiMenuNodeId): Option of (MenuNode.TuiMenuNodeId);
begin
  var Current: MenuNode.TuiMenuNodeId := Id;
  var Remaining: integer := Arrays.Length(Nodes) + 1;
  while Remaining > 0 do
    begin
      Remaining := Remaining - 1;
      const Index: integer := TuiMenuFind(Nodes, Current);
      if Index < 0 then
        begin
          return Option.None;
        end;
      end if;

      case TuiMenuNodeParent(Nodes[Index]) of
        when Option.Some(const Parent):
          begin
            Current := Parent;
          end;
        when Option.None:
          begin
            return Option.Some(Current);
          end;
      end case;
    end;
  end while;

  return Option.None;
end function;

end unit;
