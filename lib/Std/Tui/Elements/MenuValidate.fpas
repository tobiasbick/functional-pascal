unit Std.Tui.Elements.MenuValidate;

uses Std.Arrays as Arrays;
uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Tui.Chrome.MenuNode as MenuNode;
uses Std.Tui.Chrome.MenuQuery as MenuQuery;

function TuiMenuSameOptionalId(
  Left: Option of (MenuNode.TuiMenuNodeId);
  Right: Option of (MenuNode.TuiMenuNodeId)
): boolean;
begin
  case Left of
    when Option.Some(const LeftId):
      begin
        case Right of
          when Option.Some(const RightId):
            begin
              return LeftId.Value = RightId.Value;
            end;
          when Option.None:
            begin
              return false;
            end;
        end case;
      end;
    when Option.None:
      begin
        case Right of
          when Option.Some(const RightId):
            begin
              return false;
            end;
          when Option.None:
            begin
              return true;
            end;
        end case;
      end;
  end case;
end function;

// Validates identities, parents, cycles, mnemonics, shortcuts, and controlled state.
//
// Parameters:
// - `Nodes`: Flat ordered menu-node collection.
// - `State`: Controlled state used by the operation.
public procedure TuiMenuValidate(Nodes: array of (MenuNode.TuiMenuNode); State: MenuNode.TuiMenuState);
begin
  for Index: integer := 0 to Arrays.Length(Nodes) - 1 do
    begin
      var Id: MenuNode.TuiMenuNodeId := MenuQuery.TuiMenuNodeIdOf(Nodes[Index]);
      for Previous: integer := 0 to Index - 1 do
        begin
          if MenuQuery.TuiMenuNodeIdOf(Nodes[Previous]).Value = Id.Value then
            begin
              panic('Tui menu node id must be unique');
            end;
          end if;
        end;
      end for;
      var Mnemonic: string := MenuQuery.TuiMenuNodeMnemonic(Nodes[Index]);
      if Str.Length(Mnemonic) > 1 then
        begin
          panic('Tui menu mnemonic must be empty or one character');
        end;
      end if;

      case MenuQuery.TuiMenuNodeParent(Nodes[Index]) of
        when Option.Some(const Parent):
          begin
            var ParentIndex: integer := MenuQuery.TuiMenuFind(Nodes, Parent);
            if ParentIndex < 0 then
              begin
                panic('Tui menu parent id must exist');
              end;
            end if;

            if not MenuQuery.TuiMenuNodeIsSubmenu(Nodes[ParentIndex]) then
              begin
                panic('Tui menu parent must be a submenu');
              end;
            end if;
          end;
        when Option.None:
          begin
            if not MenuQuery.TuiMenuNodeIsSubmenu(Nodes[Index]) then
              begin
                panic('Tui root menu nodes must be submenus');
              end;
            end if;
          end;
      end case;
      mutable var Current: MenuNode.TuiMenuNodeId := Id;
      mutable var Remaining: integer := Arrays.Length(Nodes);
      while Remaining > 0 do
        begin
          Remaining := Remaining - 1;
          var CurrentIndex: integer := MenuQuery.TuiMenuFind(Nodes, Current);
          case MenuQuery.TuiMenuNodeParent(Nodes[CurrentIndex]) of
            when Option.Some(const Parent):
              begin
                if Parent.Value = Id.Value then
                  begin
                    panic('Tui menu parent links must not contain a cycle');
                  end;
                end if;

                Current := Parent;
              end;
            when Option.None:
              begin
                Remaining := 0;
              end;
          end case;
        end;
      end while;

      for Other: integer := 0 to Index - 1 do
        begin
          if (TuiMenuSameOptionalId(MenuQuery.TuiMenuNodeParent(Nodes[Other]), MenuQuery.TuiMenuNodeParent(Nodes[Index])) and (Mnemonic <> '')) and
             (Str.ToLower(Mnemonic) = Str.ToLower(MenuQuery.TuiMenuNodeMnemonic(Nodes[Other]))) then
            begin
              panic('Tui sibling menu mnemonics must be unique');
            end;
          end if;
        end;
      end for;
    end;
  end for;

  if State.Open then
    begin
      case State.Active of
        when Option.Some(const Active):
          begin
            var ActiveIndex: integer := MenuQuery.TuiMenuFind(Nodes, Active);
            if (ActiveIndex < 0) or not MenuQuery.TuiMenuNodeSelectable(Nodes[ActiveIndex]) then
              begin
                panic('Tui open menu active id must select an enabled node');
              end;
            end if;
          end;
        when Option.None:
          begin
            panic('Tui open menu requires an active node');
          end;
      end case;
    end;
  else
    begin
      case State.Active of
        when Option.Some(const Active):
          begin
            panic('Tui closed menu must not have an active node');
          end;
        when Option.None:
          begin
            null;
          end;
      end case;
    end;
  end if;
end procedure;

end unit;
