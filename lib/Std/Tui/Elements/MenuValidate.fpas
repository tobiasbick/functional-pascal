unit Std.Tui.Elements.MenuValidate;

uses Std.Tui.Chrome.MenuNode, Std.Tui.Chrome.MenuQuery;

function TuiMenuSameOptionalId(Left: option of TuiMenuNodeId; Right: option of TuiMenuNodeId): boolean;
begin
  case Left of
    when Some(const LeftId):
      begin
        case Right of
          when Some(const RightId):
            begin
              return LeftId.Value = RightId.Value;
            end;
          when None:
            begin
              return false;
            end;
        end case;
      end;
    when None:
      begin
        case Right of
          when Some(const RightId):
            begin
              return false;
            end;
          when None:
            begin
              return true;
            end;
        end case;
      end;
  end case;
end function;

// Validates identities, parents, cycles, mnemonics, shortcuts, and controlled state.
//
// Parameters:
// - `Nodes`: Flat ordered menu-node collection.
// - `State`: Controlled state used by the operation.
public procedure TuiMenuValidate(Nodes: array of TuiMenuNode; State: TuiMenuState);
begin
  for Index: integer := 0 to Nodes.Length() - 1 do
    begin
      const Id: TuiMenuNodeId := TuiMenuNodeIdOf(Nodes[Index]);
      for Previous: integer := 0 to Index - 1 do
        begin
          if TuiMenuNodeIdOf(Nodes[Previous]).Value = Id.Value then
            begin
              panic('Tui menu node id must be unique');
            end;
          end if;
        end;
      end for;
      const Mnemonic: string := TuiMenuNodeMnemonic(Nodes[Index]);
      if Mnemonic.Length() > 1 then
        begin
          panic('Tui menu mnemonic must be empty or one character');
        end;
      end if;

      case TuiMenuNodeParent(Nodes[Index]) of
        when Some(const Parent):
          begin
            const ParentIndex: integer := TuiMenuFind(Nodes, Parent);
            if ParentIndex < 0 then
              begin
                panic('Tui menu parent id must exist');
              end;
            end if;

            if not TuiMenuNodeIsSubmenu(Nodes[ParentIndex]) then
              begin
                panic('Tui menu parent must be a submenu');
              end;
            end if;
          end;
        when None:
          begin
            if not TuiMenuNodeIsSubmenu(Nodes[Index]) then
              begin
                panic('Tui root menu nodes must be submenus');
              end;
            end if;
          end;
      end case;
      var Current: TuiMenuNodeId := Id;
      var Remaining: integer := Nodes.Length();
      while Remaining > 0 do
        begin
          Remaining := Remaining - 1;
          const CurrentIndex: integer := TuiMenuFind(Nodes, Current);
          case TuiMenuNodeParent(Nodes[CurrentIndex]) of
            when Some(const Parent):
              begin
                if Parent.Value = Id.Value then
                  begin
                    panic('Tui menu parent links must not contain a cycle');
                  end;
                end if;

                Current := Parent;
              end;
            when None:
              begin
                Remaining := 0;
              end;
          end case;
        end;
      end while;

      for Other: integer := 0 to Index - 1 do
        begin
          if (TuiMenuSameOptionalId(TuiMenuNodeParent(Nodes[Other]), TuiMenuNodeParent(Nodes[Index])) and (Mnemonic <> '')) and
             (Mnemonic.ToLower() = TuiMenuNodeMnemonic(Nodes[Other]).ToLower()) then
            begin
              panic('Tui sibling menu mnemonics must be unique');
            end;
          end if;
        end;
      end for;
    end;
  end for;

  if State.Open then
    begin
      case State.Active of
        when Some(const Active):
          begin
            const ActiveIndex: integer := TuiMenuFind(Nodes, Active);
            if (ActiveIndex < 0) or not TuiMenuNodeSelectable(Nodes[ActiveIndex]) then
              begin
                panic('Tui open menu active id must select an enabled node');
              end;
            end if;
          end;
        when None:
          begin
            panic('Tui open menu requires an active node');
          end;
      end case;
    end;
  else
    begin
      case State.Active of
        when Some(const Active):
          begin
            panic('Tui closed menu must not have an active node');
          end;
        when None:
          begin
          end;
      end case;
    end;
  end if;
end procedure;
end unit;
