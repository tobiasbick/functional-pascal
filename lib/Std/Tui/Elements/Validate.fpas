unit Std.Tui.Elements.Validate;

uses
  Std.Conv, Std.Tui.Chrome.StatusItem, Std.Tui.Elements.Element, Std.Tui.Elements.MenuValidate,
  Std.Tui.Ids.Action, Std.Tui.Ids.ControlId;

function TuiElementControlSeen(Seen: array of integer; Value: integer): boolean;
begin
  for Index: integer := 0 to Seen.Length() - 1 do
    begin
      if Seen[Index] = Value then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

procedure TuiElementValidateControl(Id: TuiControlId);
begin
  if Id.Value <= 0 then
    begin
      panic('Tui interactive elements require a positive control id');
    end;
  end if;
end procedure;

procedure TuiElementValidateAction(Action: TuiAction);
begin
  if Action.Value <= 0 then
    begin
      panic('Tui interactive elements require a positive action id');
    end;
  end if;
end procedure;

function TuiElementChildren(Node: TuiElement): array of TuiElement;
begin
  case Node of
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        return Children;
      end;
    when TuiElement.Row(const Children, const Spacing):
      begin
        return Children;
      end;
    when TuiElement.Column(const Children, const Spacing):
      begin
        return Children;
      end;
    when TuiElement.Layout(const Settings, const Children):
      begin
        return Children;
      end;
    when TuiElement.Panel(const Title, const Children):
      begin
        return Children;
      end;
    when TuiElement.Overlay(const Title, const Children):
      begin
        return Children;
      end;
    when TuiElement.Desktop(const Focused, const Children):
      begin
        return Children;
      end;
    when TuiElement.Empty, TuiElement.Label(_), TuiElement.Button(_), TuiElement.Input(_), TuiElement.TextArea(_, _, _, _, _), TuiElement.CheckBox(_, _, _, _), TuiElement.List(_, _, _, _), TuiElement.MenuBar(_), TuiElement.Menu(_, _, _, _), TuiElement.StatusLine(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Spacer(_):
      begin
        return [];
      end;
  end case;
end function;

function TuiElementValidateAndCollect(Node: TuiElement): array of integer;
begin
  var Seen: array of integer := [];
  case Node of
    when TuiElement.Button(const Button):
      begin
        TuiElementValidateControl(Button.Id);
        TuiElementValidateAction(Button.Action);
        if Button.Mnemonic.Length() > 1 then
          begin
            panic('Tui button mnemonic must be empty or one character');
          end;
        end if;

        if (Button.Mnemonic <> '') and not Button.Text.ToLower().Contains(Button.Mnemonic.ToLower()) then
          begin
            panic('Tui button mnemonic must occur in its text');
          end;
        end if;

        Seen.Push(Button.Id.Value);
      end;
    when TuiElement.Input(const Input):
      begin
        TuiElementValidateControl(Input.Id);
        TuiElementValidateAction(Input.ChangeAction);
        if (Input.Caret < 0) or (Input.Caret > Input.Text.Length()) then
          begin
            panic('Tui input caret must be within its text');
          end;
        end if;

        Seen.Push(Input.Id.Value);
      end;
    when TuiElement.TextArea(const Id, const Text, const Caret, const Offset, const ChangeAction):
      begin
        TuiElementValidateControl(Id);
        TuiElementValidateAction(ChangeAction);
        if (Caret < 0) or (Caret > Text.Length()) then
          begin
            panic('Tui text area caret must be within its text');
          end;
        end if;

        if (Offset.X < 0) or (Offset.Y < 0) then
          begin
            panic('Tui text area offset must not be negative');
          end;
        end if;

        Seen.Push(Id.Value);
      end;
    when TuiElement.CheckBox(const Id, const Text, const Checked, const ChangeAction):
      begin
        TuiElementValidateControl(Id);
        TuiElementValidateAction(ChangeAction);
        Seen.Push(Id.Value);
      end;
    when TuiElement.List(const Id, const Items, const Selected, const ChangeAction):
      begin
        TuiElementValidateControl(Id);
        TuiElementValidateAction(ChangeAction);
        const Count: integer := Items.Length();
        if Count = 0 then
          begin
            if Selected <> -1 then
              begin
                panic('Tui empty list selection must be -1');
              end;
            end if;
          end;
        elsif (Selected < 0) or (Selected >= Count) then
          begin
            panic('Tui list selection must be within its items');
          end;
        end if;

        Seen.Push(Id.Value);
      end;
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        TuiElementValidateControl(Id);
        TuiElementValidateAction(ChangeAction);
        if (Offset.X < 0) or (Offset.Y < 0) then
          begin
            panic('Tui scroll offset must not be negative');
          end;
        end if;

        if Children.Length() <> 1 then
          begin
            panic('Tui scroll wrappers require exactly one child');
          end;
        end if;

        Seen.Push(Id.Value);
      end;
    when TuiElement.MenuBar(const Items):
      begin
        for Index: integer := 0 to Items.Length() - 1 do
          begin
            TuiElementValidateControl(Items[Index].Id);
            TuiElementValidateAction(Items[Index].Action);
            if TuiElementControlSeen(Seen, Items[Index].Id.Value) then
              begin
                panic('Tui control id must be unique in one tree: ' +
                      Std.Conv.IntToStr(Items[Index].Id.Value));
              end;
            end if;

            Seen.Push(Items[Index].Id.Value);
          end;
        end for;
      end;
    when TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        TuiElementValidateControl(Id);
        TuiElementValidateAction(ChangeAction);
        TuiMenuValidate(Nodes, State);
        Seen.Push(Id.Value);
      end;
    when TuiElement.Gauge(const Gauge):
      begin
        if Gauge.Maximum <= 0 then
          begin
            panic('Tui gauge maximum must be positive');
          end;
        end if;

        if (Gauge.Value < 0) or (Gauge.Value > Gauge.Maximum) then
          begin
            panic('Tui gauge value must be between zero and its maximum');
          end;
        end if;
      end;
    when TuiElement.StatusLine(const Items):
      begin
        for Index: integer := 0 to Items.Length() - 1 do
          begin
            if Items[Index] is TuiStatusItem.Command(const Id, const Text, const Action, const Enabled) then
              begin
                TuiElementValidateControl(Id);
                TuiElementValidateAction(Action);
                if TuiElementControlSeen(Seen, Id.Value) then
                  begin
                    panic('Tui control id must be unique in one tree: ' +
                          Std.Conv.IntToStr(Id.Value));
                  end;
                end if;

                Seen.Push(Id.Value);
              end;
            end if;
          end;
        end for;
      end;
    when TuiElement.Row(const Children, const Spacing), TuiElement.Column(const Children, const Spacing):
      begin
        if Spacing < 0 then
          begin
            panic('Tui row and column spacing must not be negative');
          end;
        end if;
      end;
    when TuiElement.Layout(const Settings, const Children):
      begin
        if Children.Length() <> 1 then
          begin
            panic('Tui layout wrappers require exactly one child');
          end;
        end if;
      end;
    when TuiElement.Empty, TuiElement.Label(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Spacer(_), TuiElement.Panel(_, _), TuiElement.Overlay(_, _), TuiElement.Desktop(_, _):
      null;
  end case;
  const Children: array of TuiElement := TuiElementChildren(Node);
  for ChildIndex: integer := 0 to Children.Length() - 1 do
    begin
      const ChildIds: array of integer := TuiElementValidateAndCollect(Children[ChildIndex]);
      for IdIndex: integer := 0 to ChildIds.Length() - 1 do
        begin
          if TuiElementControlSeen(Seen, ChildIds[IdIndex]) then
            begin
              panic('Tui control id must be unique in one tree: ' +
                    Std.Conv.IntToStr(ChildIds[IdIndex]));
            end;
          end if;

          Seen.Push(ChildIds[IdIndex]);
        end;
      end for;
    end;
  end for;

  if Node is TuiElement.Desktop(const Focused, const DesktopChildren) then
    begin
      case Focused of
        when Some(const Id):
          begin
            if not TuiElementControlSeen(Seen, Id.Value) then
              begin
                panic('Tui focused control id must exist in the rendered tree: ' +
                      Std.Conv.IntToStr(Id.Value));
              end;
            end if;
          end;
        when None:
          begin
          end;
      end case;
    end;
  end if;

  return Seen;
end function;

// Validates one complete Tui view tree before layout or routing.
//
// Parameters:
// - `Root`: Root of the element tree.
public procedure TuiElementValidate(Root: TuiElement);
begin
  discard TuiElementValidateAndCollect(Root);
end procedure;
end unit;
