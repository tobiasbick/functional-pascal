unit Std.Tui.Elements.Validate;

uses
  Std.Array, Std.Conv, Std.Str, Std.Tui.Chrome.StatusItem, Std.Tui.Elements.Element,
  Std.Tui.Elements.MenuValidate, Std.Tui.Ids.Action, Std.Tui.Ids.ControlId;

function TuiElementControlSeen(Seen: array of integer; Value: integer): boolean;
begin
  for Index: integer := 0 to Std.Array.Length(Seen) - 1 do
  begin
    if Seen[Index] = Value then
    begin
      return true
    end
  end;

  return false
end;

procedure TuiElementValidateControl(Id: TuiControlId);
begin
  if Id.Value <= 0 then
  begin
    panic('Tui interactive elements require a positive control id')
  end
end;

procedure TuiElementValidateAction(Action: TuiAction);
begin
  if Action.Value <= 0 then
  begin
    panic('Tui interactive elements require a positive action id')
  end
end;

function TuiElementChildren(Node: TuiElement): array of TuiElement;
begin
  case Node of
    TuiElement.Scroll(Id, Offset, ChangeAction, Children):
    begin
      return Children
    end;
    TuiElement.Row(Children, Spacing):
    begin
      return Children
    end;
    TuiElement.Column(Children, Spacing):
    begin
      return Children
    end;
    TuiElement.Layout(Settings, Children):
    begin
      return Children
    end;
    TuiElement.Panel(Title, Children):
    begin
      return Children
    end;
    TuiElement.Overlay(Title, Children):
    begin
      return Children
    end;
    TuiElement.Desktop(Focused, Children):
    begin
      return Children
    end
    else
    begin
      return []
    end
  end
end;

function TuiElementValidateAndCollect(Node: TuiElement): array of integer;
begin
  mutable var Seen: array of integer := [];
  case Node of
    TuiElement.Button(Button):
    begin
      TuiElementValidateControl(Button.Id);
      TuiElementValidateAction(Button.Action);
      if Std.Str.Length(Button.Mnemonic) > 1 then
      begin
        panic('Tui button mnemonic must be empty or one character')
      end;

      if (Button.Mnemonic <> '') and
         not Std.Str.Contains(Std.Str.ToLower(Button.Text), Std.Str.ToLower(Button.Mnemonic)) then
      begin
        panic('Tui button mnemonic must occur in its text')
      end;

      Std.Array.Push(Seen, Button.Id.Value)
    end;
    TuiElement.Input(Input):
    begin
      TuiElementValidateControl(Input.Id);
      TuiElementValidateAction(Input.ChangeAction);
      if (Input.Caret < 0) or (Input.Caret > Std.Str.Length(Input.Text)) then
      begin
        panic('Tui input caret must be within its text')
      end;

      Std.Array.Push(Seen, Input.Id.Value)
    end;
    TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction):
    begin
      TuiElementValidateControl(Id);
      TuiElementValidateAction(ChangeAction);
      if (Caret < 0) or (Caret > Std.Str.Length(Text)) then
      begin
        panic('Tui text area caret must be within its text')
      end;

      if (Offset.X < 0) or (Offset.Y < 0) then
      begin
        panic('Tui text area offset must not be negative')
      end;

      Std.Array.Push(Seen, Id.Value)
    end;
    TuiElement.CheckBox(Id, Text, Checked, ChangeAction):
    begin
      TuiElementValidateControl(Id);
      TuiElementValidateAction(ChangeAction);
      Std.Array.Push(Seen, Id.Value)
    end;
    TuiElement.List(Id, Items, Selected, ChangeAction):
    begin
      TuiElementValidateControl(Id);
      TuiElementValidateAction(ChangeAction);
      var Count: integer := Std.Array.Length(Items);
      if Count = 0 then
      begin
        if Selected <> -1 then
        begin
          panic('Tui empty list selection must be -1')
        end
      end
      else if (Selected < 0) or (Selected >= Count) then
      begin
        panic('Tui list selection must be within its items')
      end;

      Std.Array.Push(Seen, Id.Value)
    end;
    TuiElement.Scroll(Id, Offset, ChangeAction, Children):
    begin
      TuiElementValidateControl(Id);
      TuiElementValidateAction(ChangeAction);
      if (Offset.X < 0) or (Offset.Y < 0) then
      begin
        panic('Tui scroll offset must not be negative')
      end;

      if Std.Array.Length(Children) <> 1 then
      begin
        panic('Tui scroll wrappers require exactly one child')
      end;

      Std.Array.Push(Seen, Id.Value)
    end;
    TuiElement.MenuBar(Items):
    begin
      for Index: integer := 0 to Std.Array.Length(Items) - 1 do
      begin
        TuiElementValidateControl(Items[Index].Id);
        TuiElementValidateAction(Items[Index].Action);
        if TuiElementControlSeen(Seen, Items[Index].Id.Value) then
        begin
          panic('Tui control id must be unique in one tree: ' +
                Std.Conv.IntToStr(Items[Index].Id.Value))
        end;

        Std.Array.Push(Seen, Items[Index].Id.Value)
      end
    end;
    TuiElement.Menu(Id, Nodes, State, ChangeAction):
    begin
      TuiElementValidateControl(Id);
      TuiElementValidateAction(ChangeAction);
      TuiMenuValidate(Nodes, State);
      Std.Array.Push(Seen, Id.Value)
    end;
    TuiElement.Gauge(Gauge):
    begin
      if Gauge.Maximum <= 0 then
      begin
        panic('Tui gauge maximum must be positive')
      end;

      if (Gauge.Value < 0) or (Gauge.Value > Gauge.Maximum) then
      begin
        panic('Tui gauge value must be between zero and its maximum')
      end
    end;
    TuiElement.StatusLine(Items):
    begin
      for Index: integer := 0 to Std.Array.Length(Items) - 1 do
      begin
        case Items[Index] of
          TuiStatusItem.Command(Id, Text, Action, Enabled):
          begin
            TuiElementValidateControl(Id);
            TuiElementValidateAction(Action);
            if TuiElementControlSeen(Seen, Id.Value) then
            begin
              panic('Tui control id must be unique in one tree: ' + Std.Conv.IntToStr(Id.Value))
            end;

            Std.Array.Push(Seen, Id.Value)
          end
          else
          begin
          end
        end
      end
    end;
    TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing):
    begin
      if Spacing < 0 then
      begin
        panic('Tui row and column spacing must not be negative')
      end
    end;
    TuiElement.Layout(Settings, Children):
    begin
      if Std.Array.Length(Children) <> 1 then
      begin
        panic('Tui layout wrappers require exactly one child')
      end
    end
    else
    begin
    end
  end;
  var Children: array of TuiElement := TuiElementChildren(Node);
  for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
  begin
    var ChildIds: array of integer := TuiElementValidateAndCollect(Children[ChildIndex]);
    for IdIndex: integer := 0 to Std.Array.Length(ChildIds) - 1 do
    begin
      if TuiElementControlSeen(Seen, ChildIds[IdIndex]) then
      begin
        panic('Tui control id must be unique in one tree: ' + Std.Conv.IntToStr(ChildIds[IdIndex]))
      end;

      Std.Array.Push(Seen, ChildIds[IdIndex])
    end
  end;

  case Node of
    TuiElement.Desktop(Focused, DesktopChildren):
    begin
      case Focused of
        Some(Id):
        begin
          if not TuiElementControlSeen(Seen, Id.Value) then
          begin
            panic('Tui focused control id must exist in the rendered tree: ' +
                  Std.Conv.IntToStr(Id.Value))
          end
        end;
        None:
        begin
        end
      end
    end
    else
    begin
    end
  end;

  return Seen
end;

/// Validates one complete Tui view tree before layout or routing.

public procedure TuiElementValidate(Root: TuiElement);
begin
  TuiElementValidateAndCollect(Root)
end;
