unit Std.Tui.Geometry.Point;

// Zero-based terminal-cell coordinate.
public type TuiPoint = record
  // Zero-based horizontal terminal-cell coordinate.
  public X: integer;
  // Zero-based vertical terminal-cell coordinate.
  public Y: integer;
end record;

// Creates a point. All integer coordinates are accepted.
//
// Parameters:
// - `X`: Zero-based horizontal terminal-cell coordinate.
// - `Y`: Zero-based vertical terminal-cell coordinate.
public function TuiPointCreate(X: integer; Y: integer): TuiPoint;
begin
  return TuiPoint(X := X, Y := Y);
end function;

end unit;
