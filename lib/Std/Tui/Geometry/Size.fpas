unit Std.Tui.Geometry.Size;

function TuiSizeRequireNonNegative(Value: integer; Name: string): integer;
begin
  if Value < 0 then
    begin
      panic(('Tui ' + Name) + ' must not be negative');
    end;
  end if;

  return Value;
end function;

// Non-negative terminal-cell extent.
public type TuiSize = record
  // Width in terminal cells.
  public Width: integer;
  // Height in terminal cells.
  public Height: integer;
end record;

// Creates a validated extent.
//
// Parameters:
// - `Width`: Width in terminal cells.
// - `Height`: Height in terminal cells.
public function TuiSizeCreate(Width: integer; Height: integer): TuiSize;
begin
  discard TuiSizeRequireNonNegative(Width, 'width');
  discard TuiSizeRequireNonNegative(Height, 'height');
  return TuiSize(Width := Width, Height := Height);
end function;

// Returns whether either extent is zero.
//
// Parameters:
// - `Receiver`: Value processed by the function.
public function TuiSizeIsEmpty(Receiver: TuiSize): boolean;
begin
  return (Receiver.Width = 0) or (Receiver.Height = 0);
end function;

end unit;
