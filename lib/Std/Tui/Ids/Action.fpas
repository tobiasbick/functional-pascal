unit Std.Tui.Ids.Action;

function TuiActionRequirePositive(Value: integer): integer;
begin
  if Value <= 0 then
    begin
      panic('Tui action id must be positive');
    end;
  end if;

  return Value;
end function;

// Positive application-intent identity; duplicates across controls are allowed.
public type TuiAction = record
  // Validated scalar value represented by the record.
  public Value: integer;
end record;

// Creates a validated positive action identity.
//
// Parameters:
// - `Value`: Value used to create or update the result.
public function TuiActionCreate(Value: integer): TuiAction;
begin
  return TuiAction(Value := TuiActionRequirePositive(Value));
end function;

end unit;
