unit Std.Tui.Ids.Action;

private function TuiActionRequirePositive(Value: integer): integer;
begin
  if Value <= 0 then
  begin
    panic('Tui action id must be positive')
  end;
  return Value
end;

type
  /// Positive application-intent identity; duplicates across controls are allowed.
  TuiAction = record
    Value: integer;

    /// Creates a validated positive action identity.

    static function Create(Value: integer): TuiAction;
    begin
      return record Value := TuiActionRequirePositive(Value); end
    end;
  end;
