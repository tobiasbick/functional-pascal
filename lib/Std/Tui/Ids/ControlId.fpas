unit Std.Tui.Ids.ControlId;

function TuiControlIdRequirePositive(Value: integer): integer;
begin
  if Value <= 0 then
  begin
    panic('Tui control id must be positive')
  end;

  return Value
end;

public type
  // Unique positive interactive-node identity within one rendered tree.
  TuiControlId = record
    // Validated scalar value represented by the record.
    public Value: integer;

    // Creates a validated positive identity.
    //
    // Parameters:
    // - `Value`: Value used to create or update the result.
    public static function Create(Value: integer): TuiControlId;
    begin
      return record
        Value := TuiControlIdRequirePositive(Value);
      end
    end;
  end;
