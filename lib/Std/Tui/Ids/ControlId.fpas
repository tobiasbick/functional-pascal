unit Std.Tui.Ids.ControlId;

private function TuiControlIdRequirePositive(Value: integer): integer;
begin
  if Value <= 0 then
  begin
    panic('Tui control id must be positive')
  end;
  return Value
end;

type
  /// Unique positive interactive-node identity within one rendered tree.
  TuiControlId = record
    Value: integer;

    /// Creates a validated positive identity.

    static function Create(Value: integer): TuiControlId;
    begin
      return record Value := TuiControlIdRequirePositive(Value); end
    end;
  end;
