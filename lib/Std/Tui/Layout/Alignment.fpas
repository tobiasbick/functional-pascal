unit Std.Tui.Layout.Alignment;

// Alignment of content inside an allocated layout slot.
public type TuiAlignmentKind = enum
  // Represents the `Leading` variant of `TuiAlignmentKind`.
  Leading;
  // Represents the `Center` variant of `TuiAlignmentKind`.
  Center;
  // Represents the `Trailing` variant of `TuiAlignmentKind`.
  Trailing;
  // Represents the `Fill` variant of `TuiAlignmentKind`.
  Fill;
end enum;

// Independent horizontal and vertical alignment.
public type TuiAlignment = record
  // Horizontal policy, alignment, or extent.
  public Horizontal: TuiAlignmentKind;
  // Vertical policy, alignment, or extent.
  public Vertical: TuiAlignmentKind;
end record;

// Creates a mixed-axis alignment.
//
// Parameters:
// - `Horizontal`: Horizontal policy, alignment, or extent.
// - `Vertical`: Vertical policy, alignment, or extent.
public function TuiAlignmentCreate(Horizontal: TuiAlignmentKind; Vertical: TuiAlignmentKind): TuiAlignment;
begin
  return TuiAlignment(Horizontal := Horizontal, Vertical := Vertical);
end function;

// Leading on both axes.
public function TuiAlignmentLeading(): TuiAlignment;
begin
  return TuiAlignmentCreate(TuiAlignmentKind.Leading, TuiAlignmentKind.Leading);
end function;

// Centered on both axes.
public function TuiAlignmentCenter(): TuiAlignment;
begin
  return TuiAlignmentCreate(TuiAlignmentKind.Center, TuiAlignmentKind.Center);
end function;

// Trailing on both axes.
public function TuiAlignmentTrailing(): TuiAlignment;
begin
  return TuiAlignmentCreate(TuiAlignmentKind.Trailing, TuiAlignmentKind.Trailing);
end function;

// Fill on both axes.
public function TuiAlignmentFill(): TuiAlignment;
begin
  return TuiAlignmentCreate(TuiAlignmentKind.Fill, TuiAlignmentKind.Fill);
end function;

end unit;
