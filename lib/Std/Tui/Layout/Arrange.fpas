unit Std.Tui.Layout.Arrange;

uses Std.Arrays as Arrays;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Geometry.Size as Size;
uses Std.Tui.Layout.AlignmentBounds as AlignmentBounds;
uses Std.Tui.Layout.Frame as Frame2;
uses Std.Tui.Layout.LayoutSettings as LayoutSettings;
uses Std.Tui.Layout.Margins as Margins2;
uses Std.Tui.Layout.Measure as Measure;
uses Std.Tui.Layout.MeasureResult as MeasureResult;
uses Std.Tui.Layout.MeasureSpec as MeasureSpec;
uses Std.Tui.Layout.SizePolicy as SizePolicy;
uses Std.Tui.Layout.Spacer as Spacer;

mutable var TuiArrangeBuilding: array of Frame2.TuiArrangedEntry := [];

function TuiArrangeMin(Left: integer; Right: integer): integer;
begin
  if Left < Right then
    begin
      return Left;
    end;
  end if;

  return Right;
end function;

function TuiArrangeClamp(Value: integer; Maximum: integer): integer;
begin
  if Value > Maximum then
    begin
      return Maximum;
    end;
  end if;

  return Value;
end function;

function TuiArrangeChildParticipates(Node: Element.TuiElement): boolean;
begin
  case Node of
    when Element.TuiElement.Empty:
      begin
        return false;
      end;
    else
      begin
        return true;
      end;
  end case;
end function;

function TuiArrangeMainPreferred(Measured: MeasureResult.TuiMeasureResult; Horizontal: boolean): integer;
begin
  if Horizontal then
    begin
      return Measured.Preferred.Width;
    end;
  end if;

  return Measured.Preferred.Height;
end function;

function TuiArrangeMainMinimum(Measured: MeasureResult.TuiMeasureResult; Horizontal: boolean): integer;
begin
  if Horizontal then
    begin
      return Measured.Minimum.Width;
    end;
  end if;

  return Measured.Minimum.Height;
end function;

function TuiArrangeGrowthWeight(Node: Element.TuiElement; Horizontal: boolean): integer;
begin
  case Node of
    when Element.TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction):
      begin
        return 1;
      end;
    when Element.TuiElement.Spacer(Value):
      begin
        if Value.Kind = Spacer.TuiSpacerKind.Expanding then
          begin
            return 1;
          end;
        end if;

        return 0;
      end;
    when Element.TuiElement.Layout(Settings, Children):
      begin
        if Horizontal then
          begin
            case Settings.Width of
              when Some(Width):
                begin
                  return 0;
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        else
          begin
            case Settings.Height of
              when Some(Height):
                begin
                  return 0;
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end if;

        if Settings.Stretch > 0 then
          begin
            return Settings.Stretch;
          end;
        end if;

        if Horizontal then
          begin
            if Settings.SizePolicy.Horizontal = SizePolicy.TuiSizePolicyKind.Expanding then
              begin
                return 1;
              end;
            end if;

            return 0;
          end;
        end if;

        if Settings.SizePolicy.Vertical = SizePolicy.TuiSizePolicyKind.Expanding then
          begin
            return 1;
          end;
        end if;

        return 0;
      end;
    else
      begin
        return 0;
      end;
  end case;
end function;

function TuiArrangeContentRect(Outer: Rect.TuiRect; Margins: Margins2.TuiMargins): Rect.TuiRect;
begin
  mutable var Width: integer := Outer.Width - Margins.Horizontal();
  mutable var Height: integer := Outer.Height - Margins.Vertical();
  if Width < 0 then
    begin
      Width := 0;
    end;
  end if;

  if Height < 0 then
    begin
      Height := 0;
    end;
  end if;

  return Rect.TuiRect.Create(Outer.X + Margins.Left, Outer.Y + Margins.Top, Width, Height);
end function;

function TuiArrangeLayoutChildMeasure(
  Measured: MeasureResult.TuiMeasureResult;
  Policy: SizePolicy.TuiSizePolicy;
  Available: Size.TuiSize
): MeasureResult.TuiMeasureResult;
begin
  mutable var MaximumWidth: integer := Measured.Maximum.Width;
  mutable var MaximumHeight: integer := Measured.Maximum.Height;
  if (Policy.Horizontal = SizePolicy.TuiSizePolicyKind.Expanding) and
     (MaximumWidth < Available.Width) then
    begin
      MaximumWidth := Available.Width;
    end;
  end if;

  if (Policy.Vertical = SizePolicy.TuiSizePolicyKind.Expanding) and
     (MaximumHeight < Available.Height) then
    begin
      MaximumHeight := Available.Height;
    end;
  end if;

  return MeasureResult.TuiMeasureResult.Create(Measured.Minimum, Measured.Preferred, Size.TuiSize.Create(MaximumWidth, MaximumHeight));
end function;

// Clear the shared handle before Push so copy-on-write stays unique (amortized O(1)).

function TuiArrangePushEntry(ParentIndex: integer; NodeBounds: Rect.TuiRect; Clip: Rect.TuiRect): integer;
begin
  var Index: integer := Arrays.Length(TuiArrangeBuilding);
  mutable var Entries: array of Frame2.TuiArrangedEntry := TuiArrangeBuilding;
  TuiArrangeBuilding := [];
  Arrays.Push(Entries, record
    ParentIndex := ParentIndex;
    Bounds := NodeBounds;
    Clip := Clip;
  end record);
  TuiArrangeBuilding := Entries;
  return Index;
end function;

// Builds a preorder arranged-frame index for one element tree.
//
// Parameters:
// - `Frame`: Arranged frame containing element geometry.
// - `Root`: Root of the element tree.
// - `Bounds`: Rectangle affected by the operation.
public procedure TuiArrange(Frame: Frame2.TuiArrangedFrame; Root: Element.TuiElement; Bounds: Rect.TuiRect);
procedure ArrangeNode(
  Node: Element.TuiElement;
  NodeBounds: Rect.TuiRect;
  ParentClip: Rect.TuiRect;
  ParentIndex: integer
);
procedure ArrangeRowColumn(
  Horizontal: boolean;
  Children: array of Element.TuiElement;
  Spacing: integer;
  Area: Rect.TuiRect;
  Clip: Rect.TuiRect;
  Parent: integer
);
begin
  mutable var AvailableMain: integer := Area.Width;
  mutable var AvailableCross: integer := Area.Height;
  if not Horizontal then
    begin
      AvailableMain := Area.Height;
      AvailableCross := Area.Width;
    end;
  end if;
  var Spec: MeasureSpec.TuiMeasureSpec := MeasureSpec.TuiMeasureSpec.AtMost(Size.TuiSize.Create(Area.Width, Area.Height));
  var ChildCount: integer := Arrays.Length(Children);
  mutable var Assigned: array of integer := Arrays.Fill(0, ChildCount);
  mutable var Preferred: array of integer := Arrays.Fill(0, ChildCount);
  mutable var ParticipatingIndices: array of integer := [];
  mutable var MinimumTotal: integer := 0;
  for Index: integer := 0 to ChildCount - 1 do
    begin
      if TuiArrangeChildParticipates(Children[Index]) then
        begin
          Arrays.Push(ParticipatingIndices, Index);
          var Measured: MeasureResult.TuiMeasureResult := Measure.TuiMeasure(Children[Index], Spec);
          Assigned[Index] := TuiArrangeMainMinimum(Measured, Horizontal);
          Preferred[Index] := TuiArrangeMainPreferred(Measured, Horizontal);
          MinimumTotal := MinimumTotal + Assigned[Index];
        end;
      end if;
    end;
  end for;
  var ParticipatingCount: integer := Arrays.Length(ParticipatingIndices);
  mutable var SpacingTotal: integer := 0;
  if ParticipatingCount > 1 then
    begin
      SpacingTotal := Spacing * (ParticipatingCount - 1);
    end;
  end if;
  mutable var AvailableForItems: integer := AvailableMain - SpacingTotal;
  if AvailableForItems < 0 then
    begin
      AvailableForItems := 0;
    end;
  end if;

  if AvailableForItems >= MinimumTotal then
    begin
      mutable var Remaining: integer := AvailableForItems - MinimumTotal;
      mutable var Progress: boolean := true;
      while (Remaining > 0) and Progress do
        begin
          Progress := false;
          for P: integer := 0 to ParticipatingCount - 1 do
            begin
              var ChildIndex: integer := ParticipatingIndices[P];
              if (Remaining > 0) and (Assigned[ChildIndex] < Preferred[ChildIndex]) then
                begin
                  Assigned[ChildIndex] := Assigned[ChildIndex] + 1;
                  Remaining := Remaining - 1;
                  Progress := true;
                end;
              end if;
            end;
          end for;
        end;
      end while;

      Progress := true;
      while (Remaining > 0) and Progress do
        begin
          Progress := false;
          for P: integer := 0 to ParticipatingCount - 1 do
            begin
              var ChildIndex: integer := ParticipatingIndices[P];
              var Weight: integer := TuiArrangeGrowthWeight(Children[ChildIndex], Horizontal);
              if Weight > 0 then
                begin
                  for Share: integer := 1 to Weight do
                    begin
                      if (Remaining > 0) and (Assigned[ChildIndex] < AvailableMain) then
                        begin
                          Assigned[ChildIndex] := Assigned[ChildIndex] + 1;
                          Remaining := Remaining - 1;
                          Progress := true;
                        end;
                      end if;
                    end;
                  end for;
                end;
              end if;
            end;
          end for;
        end;
      end while;
    end;
  end if;
  mutable var MainCursor: integer := Area.X;
  mutable var CrossOrigin: integer := Area.Y;
  if not Horizontal then
    begin
      MainCursor := Area.Y;
      CrossOrigin := Area.X;
    end;
  end if;
  mutable var ParticipatingSeen: integer := 0;
  for Index: integer := 0 to ChildCount - 1 do
    begin
      if not TuiArrangeChildParticipates(Children[Index]) then
        begin
          mutable var EmptyBounds: Rect.TuiRect := Rect.TuiRect.Create(MainCursor, CrossOrigin, 0, 0);
          if not Horizontal then
            begin
              EmptyBounds := Rect.TuiRect.Create(CrossOrigin, MainCursor, 0, 0);
            end;
          end if;

          ArrangeNode(Children[Index], EmptyBounds, Clip, Parent);
        end;
      else
        begin
          if ParticipatingSeen > 0 then
            begin
              MainCursor := MainCursor + Spacing;
            end;
          end if;

          ParticipatingSeen := ParticipatingSeen + 1;
          var MainSize: integer := Assigned[Index];
          mutable var ChildBounds: Rect.TuiRect := Rect.TuiRect.Create(MainCursor, CrossOrigin, MainSize, AvailableCross);
          if not Horizontal then
            begin
              ChildBounds := Rect.TuiRect.Create(CrossOrigin, MainCursor, AvailableCross, MainSize);
            end;
          end if;

          ArrangeNode(Children[Index], ChildBounds, Clip, Parent);
          MainCursor := MainCursor + MainSize;
        end;
      end if;
    end;
  end for;
end procedure;
begin
  var Clip: Rect.TuiRect := NodeBounds.Intersect(ParentClip);
  var SelfIndex: integer := TuiArrangePushEntry(ParentIndex, NodeBounds, Clip);
  case Node of
    when Element.TuiElement.Row(Children, Spacing):
      begin
        ArrangeRowColumn(true, Children, Spacing, NodeBounds, Clip, SelfIndex);
      end;
    when Element.TuiElement.Column(Children, Spacing):
      begin
        ArrangeRowColumn(false, Children, Spacing, NodeBounds, Clip, SelfIndex);
      end;
    when Element.TuiElement.Layout(Settings, Children):
      begin
        var Content: Rect.TuiRect := TuiArrangeContentRect(NodeBounds, Settings.Margins);
        if Arrays.Length(Children) = 1 then
          begin
            var Available: Size.TuiSize := Size.TuiSize.Create(Content.Width, Content.Height);
            var Measured: MeasureResult.TuiMeasureResult := TuiArrangeLayoutChildMeasure(Measure.TuiMeasure(Children[0], MeasureSpec.TuiMeasureSpec.AtMost(Available)), Settings.SizePolicy, Available);
            ArrangeNode(Children[0], AlignmentBounds.TuiAlignmentBounds.Resolve(Measured, Settings.Alignment, Content), Clip, SelfIndex);
          end;
        end if;
      end;
    when Element.TuiElement.Scroll(Id, Offset, ChangeAction, Children):
      begin
        if Arrays.Length(Children) = 1 then
          begin
            var Content: Size.TuiSize := Measure.TuiMeasure(Children[0], MeasureSpec.TuiMeasureSpec.Unbounded())
                                           .Preferred;
            mutable var MaximumX: integer := Content.Width - NodeBounds.Width;
            mutable var MaximumY: integer := Content.Height - NodeBounds.Height;
            if MaximumX < 0 then
              begin
                MaximumX := 0;
              end;
            end if;

            if MaximumY < 0 then
              begin
                MaximumY := 0;
              end;
            end if;
            var EffectiveX: integer := TuiArrangeClamp(Offset.X, MaximumX);
            var EffectiveY: integer := TuiArrangeClamp(Offset.Y, MaximumY);
            ArrangeNode(Children[0], Rect.TuiRect.Create(NodeBounds.X - EffectiveX, NodeBounds.Y -
                                                                                    EffectiveY, Content.Width, Content.Height), Clip, SelfIndex);
          end;
        end if;
      end;
    when Element.TuiElement.Panel(Title, Children), Element.TuiElement.Overlay(Title, Children):
      begin
        ArrangeRowColumn(false, Children, 0, NodeBounds.Inset(), Clip, SelfIndex);
      end;
    when Element.TuiElement.Desktop(Focused, Children):
      begin
        var Spec: MeasureSpec.TuiMeasureSpec := MeasureSpec.TuiMeasureSpec.AtMost(Size.TuiSize.Create(NodeBounds.Width, NodeBounds.Height));
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case Children[Index] of
              when Element.TuiElement.Overlay(Title, OverlayChildren):
                begin
                  var Measured: MeasureResult.TuiMeasureResult := Measure.TuiMeasure(Children[Index], Spec);
                  var Width: integer := TuiArrangeMin(Measured.Preferred.Width, NodeBounds.Width);
                  var Height: integer := TuiArrangeMin(Measured.Preferred.Height, NodeBounds.Height);
                  var X: integer := NodeBounds.X + ((NodeBounds.Width - Width) div 2);
                  var Y: integer := NodeBounds.Y + ((NodeBounds.Height - Height) div 2);
                  ArrangeNode(Children[Index], Rect.TuiRect.Create(X, Y, Width, Height), Clip, SelfIndex);
                end;
              else
                begin
                  ArrangeNode(Children[Index], NodeBounds, Clip, SelfIndex);
                end;
            end case;
          end;
        end for;
      end;
    else
      begin
        null;
      end;
  end case;
end procedure;
begin
  TuiArrangeBuilding := [];
  ArrangeNode(Root, Bounds, Bounds, -1);
  Frame.ReplaceEntries(TuiArrangeBuilding);
  TuiArrangeBuilding := [];
end procedure;

end unit;
