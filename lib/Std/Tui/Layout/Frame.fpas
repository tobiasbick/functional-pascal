unit Std.Tui.Layout.Frame;

uses Std.Arrays as Arrays;
uses Std.Tui.Geometry.Rect as Rect;

// One private arranged-frame entry for a preorder element visit.
public type TuiArrangedEntry = record
  // Index of the parent arranged entry.
  public ParentIndex: integer;
  // Rectangle occupied by the value.
  public Bounds: Rect.TuiRect;
  // Clipping rectangle in surface coordinates.
  public Clip: Rect.TuiRect;
end record;

var TuiFrameEntries: array of (array of (TuiArrangedEntry)) := [];

function TuiFrameRequire(Slot: integer): integer;
begin
  if (Slot < 1) or (Slot > Arrays.Length(TuiFrameEntries)) then
    begin
      panic('Tui arranged frame handle is invalid');
    end;
  end if;

  return Slot;
end function;

// Host-owned arranged-frame index for one painted tree.
public type TuiArrangedFrame = record
  // Opaque backing-storage slot.
  public Slot: integer;
end record;

// Allocates an empty arranged frame.
public function TuiArrangedFrameCreate(): TuiArrangedFrame;
begin
  var Empty: array of (TuiArrangedEntry) := [];
  TuiFrameEntries := Arrays.Concat(TuiFrameEntries, [Empty]);
  return TuiArrangedFrame(Slot := Arrays.Length(TuiFrameEntries));
end function;

// Clears all entries before a fresh arrange pass.
//
// Parameters:
// - `Receiver`: Value processed by the function.
public procedure TuiArrangedFrameClear(Receiver: TuiArrangedFrame);
begin
  const Slot: integer := TuiFrameRequire(Receiver.Slot);
  var Empty: array of (TuiArrangedEntry) := [];
  TuiFrameEntries[Slot - 1] := Empty;
end procedure;

// Appends one preorder entry and returns its index.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `ParentIndex`: Index of the parent arranged entry.
// - `Bounds`: Rectangle affected by the operation.
// - `Clip`: Clipping rectangle for drawing.
public function TuiArrangedFramePush(
  Receiver: TuiArrangedFrame;
  ParentIndex: integer;
  Bounds: Rect.TuiRect;
  Clip: Rect.TuiRect
): integer;
begin
  const Slot: integer := TuiFrameRequire(Receiver.Slot);
  var Entries: array of (TuiArrangedEntry) := TuiFrameEntries[Slot - 1];
  const Index: integer := Arrays.Length(Entries);
  TuiFrameEntries[Slot - 1] := [];
  Arrays.Push(var Entries, TuiArrangedEntry(ParentIndex := ParentIndex, Bounds := Bounds, Clip := Clip));
  TuiFrameEntries[Slot - 1] := Entries;
  return Index;
end function;

// Drop the shared slot handle before Push so copy-on-write stays unique.
// Replaces every entry atomically after a successful arrange pass.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Entries`: Arranged entries replacing the current frame contents.
public procedure TuiArrangedFrameReplaceEntries(
  Receiver: TuiArrangedFrame;
  Entries: array of (TuiArrangedEntry)
);
begin
  const Slot: integer := TuiFrameRequire(Receiver.Slot);
  TuiFrameEntries[Slot - 1] := Entries;
end procedure;

// Returns the number of arranged entries.
//
// Parameters:
// - `Receiver`: Value processed by the function.
public function TuiArrangedFrameCount(Receiver: TuiArrangedFrame): integer;
begin
  const Slot: integer := TuiFrameRequire(Receiver.Slot);
  return Arrays.Length(TuiFrameEntries[Slot - 1]);
end function;

// Returns one arranged entry by preorder index.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Index`: Zero-based index used by the operation.
public function TuiArrangedFrameEntryAt(Receiver: TuiArrangedFrame; Index: integer): TuiArrangedEntry;
begin
  const Slot: integer := TuiFrameRequire(Receiver.Slot);
  const Entries: array of (TuiArrangedEntry) := TuiFrameEntries[Slot - 1];
  if (Index < 0) or (Index >= Arrays.Length(Entries)) then
    begin
      panic('Tui arranged frame index is out of range');
    end;
  end if;

  return Entries[Index];
end function;

end unit;
