unit Std.Tui.Layout.Frame;

uses Std.Array, Std.Tui.Geometry.Rect;

public type
  // One private arranged-frame entry for a preorder element visit.
  TuiArrangedEntry = record
    // Index of the parent arranged entry.
    public ParentIndex: integer;
    // Rectangle occupied by the value.
    public Bounds: TuiRect;
    // Clipping rectangle in surface coordinates.
    public Clip: TuiRect;
  end;

mutable var
  TuiFrameEntries: array of array of TuiArrangedEntry := [];

function TuiFrameRequire(Slot: integer): integer;
begin
  if (Slot < 1) or (Slot > Std.Array.Length(TuiFrameEntries)) then
  begin
    panic('Tui arranged frame handle is invalid')
  end;

  return Slot
end;

public type
  // Host-owned arranged-frame index for one painted tree.
  TuiArrangedFrame = record
    // Opaque backing-storage slot.
    public Slot: integer;

    // Allocates an empty arranged frame.
    public static function Create(): TuiArrangedFrame;
    begin
      mutable var Empty: array of TuiArrangedEntry := [];
      TuiFrameEntries := Std.Array.Concat(TuiFrameEntries, [Empty]);
      return record
        Slot := Std.Array.Length(TuiFrameEntries);
      end
    end;

    // Clears all entries before a fresh arrange pass.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    public procedure Clear(Self: TuiArrangedFrame);
    begin
      var Slot: integer := TuiFrameRequire(Self.Slot);
      mutable var Empty: array of TuiArrangedEntry := [];
      TuiFrameEntries[Slot - 1] := Empty
    end;

    // Appends one preorder entry and returns its index.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `ParentIndex`: Index of the parent arranged entry.
    // - `Bounds`: Rectangle affected by the operation.
    // - `Clip`: Clipping rectangle for drawing.
    public function Push(Self: TuiArrangedFrame; ParentIndex: integer; Bounds: TuiRect; Clip: TuiRect): integer;
    begin
      var Slot: integer := TuiFrameRequire(Self.Slot);
      mutable var Entries: array of TuiArrangedEntry := TuiFrameEntries[Slot - 1];
      var Index: integer := Std.Array.Length(Entries);
      TuiFrameEntries[Slot - 1] := [];
      Std.Array.Push(Entries, record
        ParentIndex := ParentIndex;
        Bounds := Bounds;
        Clip := Clip;
      end);
      TuiFrameEntries[Slot - 1] := Entries;
      return Index
    end;

    // Drop the shared slot handle before Push so copy-on-write stays unique.
    // Replaces every entry atomically after a successful arrange pass.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Entries`: Arranged entries replacing the current frame contents.
    public procedure ReplaceEntries(Self: TuiArrangedFrame; Entries: array of TuiArrangedEntry);
    begin
      var Slot: integer := TuiFrameRequire(Self.Slot);
      TuiFrameEntries[Slot - 1] := Entries
    end;

    // Returns the number of arranged entries.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    public function Count(Self: TuiArrangedFrame): integer;
    begin
      var Slot: integer := TuiFrameRequire(Self.Slot);
      return Std.Array.Length(TuiFrameEntries[Slot - 1])
    end;

    // Returns one arranged entry by preorder index.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Index`: Zero-based index used by the operation.
    public function EntryAt(Self: TuiArrangedFrame; Index: integer): TuiArrangedEntry;
    begin
      var Slot: integer := TuiFrameRequire(Self.Slot);
      var Entries: array of TuiArrangedEntry := TuiFrameEntries[Slot - 1];
      if (Index < 0) or (Index >= Std.Array.Length(Entries)) then
      begin
        panic('Tui arranged frame index is out of range')
      end;

      return Entries[Index]
    end;
  end;
