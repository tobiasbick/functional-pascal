unit Std.Tui.Layout.Key;

uses
  Std.Console as Console, Std.Tui.Elements.Element as Element, Std.Tui.Elements.Tree as Tree,
  Std.Tui.Layout.Measure as Measure, Std.Tui.Layout.MeasureSpec as Spec,
  Std.Tui.Layout.MeasureResult as Measured, Std.Tui.Layout.LayoutSettings as Settings,
  Std.Tui.Layout.Spacer as Spacer, Std.Tui.Geometry.Point as Point;

// Preorder tokens contain only geometry inputs, including parent-axis growth rules.
public type TuiLayoutToken = enum
  Empty;
  Label(Hint: Measured.TuiMeasureResult);
  Button(Hint: Measured.TuiMeasureResult);
  Input(Hint: Measured.TuiMeasureResult);
  TextArea(Hint: Measured.TuiMeasureResult);
  CheckBox(Hint: Measured.TuiMeasureResult);
  List(Hint: Measured.TuiMeasureResult);
  MenuBar(Hint: Measured.TuiMeasureResult);
  Menu(Hint: Measured.TuiMeasureResult);
  StatusLine(Hint: Measured.TuiMeasureResult);
  CellGrid(Hint: Measured.TuiMeasureResult);
  Rule(Hint: Measured.TuiMeasureResult);
  Gauge(Hint: Measured.TuiMeasureResult);
  Row(Count: integer; Spacing: integer);
  Column(Count: integer; Spacing: integer);
  Layout(Value: Settings.TuiLayoutSettings);
  Scroll(Offset: Point.TuiPoint);
  Spacer(Value: Spacer.TuiSpacer);
  Panel(Count: integer; TitleWidth: integer);
  Overlay(Count: integer; TitleWidth: integer);
  Desktop(Count: integer);
end enum;

procedure TuiCollectLayoutKey(Node: Element.TuiElement; var Key: array of TuiLayoutToken);
begin
  case Node of
    when Element.TuiElement.Empty:
      Key.PushInPlace(TuiLayoutToken.Empty);
    when Element.TuiElement.Label(_):
      Key.PushInPlace(
        TuiLayoutToken.Label(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.Button(_):
      Key.PushInPlace(
        TuiLayoutToken.Button(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.Input(_):
      Key.PushInPlace(
        TuiLayoutToken.Input(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.TextArea(_, _, _, _, _):
      Key.PushInPlace(
        TuiLayoutToken.TextArea(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.CheckBox(_, _, _, _):
      Key.PushInPlace(
        TuiLayoutToken.CheckBox(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.List(_, _, _, _):
      Key.PushInPlace(
        TuiLayoutToken.List(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.MenuBar(_):
      Key.PushInPlace(
        TuiLayoutToken.MenuBar(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.Menu(_, _, _, _):
      Key.PushInPlace(
        TuiLayoutToken.Menu(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.StatusLine(_):
      Key.PushInPlace(
        TuiLayoutToken.StatusLine(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.CellGrid(_):
      Key.PushInPlace(
        TuiLayoutToken.CellGrid(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.Rule(_):
      Key.PushInPlace(
        TuiLayoutToken.Rule(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.Gauge(_):
      Key.PushInPlace(
        TuiLayoutToken.Gauge(Measure.TuiMeasure(Node, Spec.TuiMeasureSpec.Unbounded()))
      );
    when Element.TuiElement.Row(const Children, const Spacing):
      Key.PushInPlace(TuiLayoutToken.Row(Children.Length(), Spacing));
    when Element.TuiElement.Column(const Children, const Spacing):
      Key.PushInPlace(TuiLayoutToken.Column(Children.Length(), Spacing));
    when Element.TuiElement.Layout(const Value, _):
      Key.PushInPlace(TuiLayoutToken.Layout(Value));
    when Element.TuiElement.Scroll(_, const Offset, _, _):
      Key.PushInPlace(TuiLayoutToken.Scroll(Offset));
    when Element.TuiElement.Spacer(const Value):
      Key.PushInPlace(TuiLayoutToken.Spacer(Value));
    when Element.TuiElement.Panel(const Title, const Children):
      Key.PushInPlace(TuiLayoutToken.Panel(Children.Length(), Console.DisplayWidth(Title)));
    when Element.TuiElement.Overlay(const Title, const Children):
      Key.PushInPlace(TuiLayoutToken.Overlay(Children.Length(), Console.DisplayWidth(Title)));
    when Element.TuiElement.Desktop(_, const Children):
      Key.PushInPlace(TuiLayoutToken.Desktop(Children.Length()));
  end case;

  for Child: Element.TuiElement in Tree.TuiElementChildren(Node) do
    TuiCollectLayoutKey(Child, var Key);
  end for;
end procedure;

public function TuiLayoutKey(Node: Element.TuiElement): array of TuiLayoutToken;
begin
  var Key: array of TuiLayoutToken := [];
  TuiCollectLayoutKey(Node, var Key);
  return Key;
end function;

public function TuiLayoutKeysEqual(Left: array of TuiLayoutToken; Right: array of TuiLayoutToken): boolean;
begin
  if Left.Length() <> Right.Length() then
    return false;
  end if;

  for I: integer := 0 to Left.Length() - 1 do
    if Left[I] <> Right[I] then
      return false;
    end if;
  end for;

  return true;
end function;
end unit;
