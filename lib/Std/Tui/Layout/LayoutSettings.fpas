unit Std.Tui.Layout.LayoutSettings;

uses Std.Tui.Layout.Alignment, Std.Tui.Layout.Margins, Std.Tui.Layout.SizePolicy;

function TuiLayoutSettingsRequireNonNegativeStretch(Value: integer): integer;
begin
  if Value < 0 then
  begin
    panic('Tui layout stretch must not be negative')
  end;

  return Value
end;

public type
  // Immutable layout inputs attached to a single-child layout wrapper.
  TuiLayoutSettings = record
    // Outer margins applied during layout.
    public Margins: TuiMargins;
    // Horizontal and vertical size policy.
    public SizePolicy: TuiSizePolicy;
    // Alignment applied within the allocated area.
    public Alignment: TuiAlignment;
    // Whether the item stretches across the available extent.
    public Stretch: integer;
    // Width in terminal cells.
    public Width: option of integer;
    // Height in terminal cells.
    public Height: option of integer;

    // Creates validated layout settings.
    //
    // Parameters:
    // - `Margins`: Outer margins applied during layout.
    // - `SizePolicy`: Horizontal and vertical size policy.
    // - `Alignment`: Alignment applied within the available area.
    // - `Stretch`: Whether the element stretches across the available extent.
    public static function Create(
  Margins: TuiMargins;
  SizePolicy: TuiSizePolicy;
  Alignment: TuiAlignment;
  Stretch: integer
): TuiLayoutSettings;
    begin
      return record
        Margins := Margins;
        SizePolicy := SizePolicy;
        Alignment := Alignment;
        Stretch := TuiLayoutSettingsRequireNonNegativeStretch(Stretch);
        Width := None;
        Height := None;
      end
    end;

    // Returns a copy constrained to one total width; negative widths panic.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Width`: Width in terminal cells.
    public function WithFixedWidth(Self: TuiLayoutSettings; Width: integer): TuiLayoutSettings;
    begin
      if Width < 0 then
      begin
        panic('Tui fixed layout width must not be negative')
      end;

      return record
        Margins := Self.Margins;
        SizePolicy := Self.SizePolicy;
        Alignment := Self.Alignment;
        Stretch := Self.Stretch;
        Width := Some(Width);
        Height := Self.Height;
      end
    end;

    // Returns a copy constrained to one total height; negative heights panic.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Height`: Height in terminal cells.
    public function WithFixedHeight(Self: TuiLayoutSettings; Height: integer): TuiLayoutSettings;
    begin
      if Height < 0 then
      begin
        panic('Tui fixed layout height must not be negative')
      end;

      return record
        Margins := Self.Margins;
        SizePolicy := Self.SizePolicy;
        Alignment := Self.Alignment;
        Stretch := Self.Stretch;
        Width := Self.Width;
        Height := Some(Height);
      end
    end;

    // Zero margins, preferred policy, fill alignment, and stretch zero.
    public static function Default(): TuiLayoutSettings;
    begin
      return TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Preferred(), TuiAlignment.Fill(), 0)
    end;
  end;
