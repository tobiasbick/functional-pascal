unit Std.Tui.Layout.Margins;

function TuiMarginsRequireNonNegative(Value: integer; Name: string): integer;
begin
  if Value < 0 then
  begin
    panic(('Tui layout margin ' + Name) + ' must not be negative')
  end;
  return Value
end;

public type
  /// Non-negative outer margins around a laid-out child.
  TuiMargins = record
    public Left: integer;
    public Top: integer;
    public Right: integer;
    public Bottom: integer;

    /// Creates validated margins.

    public static function Create(Left: integer; Top: integer; Right: integer; Bottom: integer): TuiMargins;
    begin
      return record
        Left := TuiMarginsRequireNonNegative(Left, 'left');
        Top := TuiMarginsRequireNonNegative(Top, 'top');
        Right := TuiMarginsRequireNonNegative(Right, 'right');
        Bottom := TuiMarginsRequireNonNegative(Bottom, 'bottom');
      end
    end;

    /// Creates equal margins on every side.

    public static function Uniform(Value: integer): TuiMargins;
    begin
      return TuiMargins.Create(Value, Value, Value, Value)
    end;

    /// Creates symmetric horizontal and vertical margins.

    public static function Symmetric(Horizontal: integer; Vertical: integer): TuiMargins;
    begin
      return TuiMargins.Create(Horizontal, Vertical, Horizontal, Vertical)
    end;

    /// Returns left plus right.

    public function Horizontal(Self: TuiMargins): integer;
    begin
      return Self.Left + Self.Right
    end;

    /// Returns top plus bottom.

    public function Vertical(Self: TuiMargins): integer;
    begin
      return Self.Top + Self.Bottom
    end;
  end;
