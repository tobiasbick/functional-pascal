unit Std.Tui.Layout.Margins;

function TuiMarginsRequireNonNegative(Value: integer; Name: string): integer;
begin
  if Value < 0 then
    begin
      panic(('Tui layout margin ' + Name) + ' must not be negative');
    end;
  end if;

  return Value;
end function;

// Non-negative outer margins around a laid-out child.
public type TuiMargins = record
  // Left margin in terminal cells.
  public Left: integer;
  // Top margin in terminal cells.
  public Top: integer;
  // Right margin in terminal cells.
  public Right: integer;
  // Bottom margin in terminal cells.
  public Bottom: integer;
end record;

// Creates validated margins.
//
// Parameters:
// - `Left`: Left input value or edge.
// - `Top`: Top edge or margin.
// - `Right`: Right input value or edge.
// - `Bottom`: Bottom edge or margin.
public function TuiMarginsCreate(Left: integer; Top: integer; Right: integer; Bottom: integer): TuiMargins;
begin
  return TuiMargins(Left := TuiMarginsRequireNonNegative(Left, 'left'), Top := TuiMarginsRequireNonNegative(Top, 'top'), Right := TuiMarginsRequireNonNegative(Right, 'right'), Bottom := TuiMarginsRequireNonNegative(Bottom, 'bottom'));
end function;

// Creates equal margins on every side.
//
// Parameters:
// - `Value`: Value used to create or update the result.
public function TuiMarginsUniform(Value: integer): TuiMargins;
begin
  return TuiMarginsCreate(Value, Value, Value, Value);
end function;

// Creates symmetric horizontal and vertical margins.
//
// Parameters:
// - `Horizontal`: Horizontal policy, alignment, or extent.
// - `Vertical`: Vertical policy, alignment, or extent.
public function TuiMarginsSymmetric(Horizontal: integer; Vertical: integer): TuiMargins;
begin
  return TuiMarginsCreate(Horizontal, Vertical, Horizontal, Vertical);
end function;

// Returns left plus right.
//
// Parameters:
// - `Receiver`: Value processed by the function.
public function TuiMarginsHorizontal(Receiver: TuiMargins): integer;
begin
  return Receiver.Left + Receiver.Right;
end function;

// Returns top plus bottom.
//
// Parameters:
// - `Receiver`: Value processed by the function.
public function TuiMarginsVertical(Receiver: TuiMargins): integer;
begin
  return Receiver.Top + Receiver.Bottom;
end function;

end unit;
