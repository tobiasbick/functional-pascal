unit Std.Tui.Layout.Measure;

uses
  Std.Console, Std.Tui.Chrome.MenuItem, Std.Tui.Chrome.MenuNode, Std.Tui.Chrome.MenuQuery,
  Std.Tui.Chrome.StatusItem, Std.Tui.Elements.Element, Std.Tui.Geometry.Size,
  Std.Tui.Layout.LayoutSettings, Std.Tui.Layout.MeasureAxis, Std.Tui.Layout.MeasureResult,
  Std.Tui.Layout.MeasureSpec, Std.Tui.Layout.SizePolicy, Std.Tui.Layout.Spacer,
  Std.Tui.Text.TextArea;

// Sentinel maximum extent used by expanding layout measurements.
public const TuiMeasureExpandingMaximum: integer := 9223372036854775807;

function TuiMeasureLeafLabel(Text: string): TuiMeasureResult;
begin
  return TuiMeasureResult.Fixed(TuiSize.Create(Std.Console.DisplayWidth(Text), 1));
end function;

function TuiMeasureLeafMenu(Nodes: array of TuiMenuNode): TuiMeasureResult;
begin
  var Width: integer := 0;
  for Index: integer := 0 to Nodes.Length() - 1 do
    begin
      case TuiMenuNodeParent(Nodes[Index]) of
        when Some(Parent):
          begin
          end;
        when None:
          begin
            Width := (Width + Std.Console.DisplayWidth(TuiMenuNodeText(Nodes[Index]))) + 2;
          end;
      end case;
    end;
  end for;

  return TuiMeasureResult.Fixed(TuiSize.Create(Width, 1));
end function;

function TuiMeasureLeafButton(Text: string): TuiMeasureResult;
begin
  return TuiMeasureResult.Fixed(TuiSize.Create(Std.Console.DisplayWidth(Text) + 4, 1));
end function;

function TuiMeasureLeafInput(Text: string; Hint: string): TuiMeasureResult;
begin
  const ContentWidth: integer := TuiMeasureAxis.Max(Std.Console.DisplayWidth(Text), Std.Console.DisplayWidth(Hint));
  const Preferred: integer := TuiMeasureAxis.Max(ContentWidth + 2, 10);
  return TuiMeasureResult.Create(TuiSize.Create(10, 1), TuiSize.Create(Preferred, 1), TuiSize.Create(Preferred, 1));
end function;

function TuiMeasureLeafTextArea(Text: string): TuiMeasureResult;
begin
  const Content: TuiSize := TuiTextAreaContentSize(Text);
  return TuiMeasureResult.Create(TuiSize.Create(1, 1), Content, TuiSize.Create(TuiMeasureExpandingMaximum, TuiMeasureExpandingMaximum));
end function;

function TuiMeasureLeafCheckBox(Text: string): TuiMeasureResult;
begin
  return TuiMeasureResult.Fixed(TuiSize.Create(Std.Console.DisplayWidth(Text) + 4, 1));
end function;

function TuiMeasureLeafList(Items: array of string): TuiMeasureResult;
begin
  var Width: integer := 2;
  for Index: integer := 0 to Items.Length() - 1 do
    begin
      Width := TuiMeasureAxis.Max(Width, Std.Console.DisplayWidth(Items[Index]) + 2);
    end;
  end for;
  const Count: integer := Items.Length();
  const Height: integer := TuiMeasureAxis.Max(Count, 1);
  return TuiMeasureResult.Fixed(TuiSize.Create(Width, Height));
end function;

function TuiMeasureLeafMenuBar(Items: array of TuiMenuItem): TuiMeasureResult;
begin
  var Width: integer := 0;
  for Index: integer := 0 to Items.Length() - 1 do
    begin
      Width := (Width + Std.Console.DisplayWidth(Items[Index].Text)) + 2;
    end;
  end for;

  return TuiMeasureResult.Fixed(TuiSize.Create(Width, 1));
end function;

function TuiMeasureLeafStatusLine(Items: array of TuiStatusItem): TuiMeasureResult;
begin
  var Width: integer := 0;
  for Index: integer := 0 to Items.Length() - 1 do
    begin
      if Index > 0 then
        begin
          Width := Width + 1;
        end;
      end if;

      case Items[Index] of
        when TuiStatusItem.Hint(Text):
          begin
            Width := Width + Std.Console.DisplayWidth(Text);
          end;
        when TuiStatusItem.Command(Id, Text, Action, Enabled):
          begin
            Width := Width + Std.Console.DisplayWidth(Text);
          end;
        when TuiStatusItem.KeyHint(KeyText, Text):
          begin
            Width := ((Width + Std.Console.DisplayWidth(KeyText)) + Std.Console.DisplayWidth(Text)) +
                     1;
          end;
      end case;
    end;
  end for;

  return TuiMeasureResult.Fixed(TuiSize.Create(Width, 1));
end function;

function TuiMeasureSpacerValue(Value: TuiSpacer; Horizontal: boolean): TuiMeasureResult;
begin
  if Horizontal then
    begin
      if Value.Kind = TuiSpacerKind.Expanding then
        begin
          return TuiMeasureResult.Create(TuiSize.Create(Value.MinimumExtent, 0), TuiSize.Create(Value.MinimumExtent, 0), TuiSize.Create(TuiMeasureExpandingMaximum, 0));
        end;
      end if;

      return TuiMeasureResult.Fixed(TuiSize.Create(Value.MinimumExtent, 0));
    end;
  end if;

  if Value.Kind = TuiSpacerKind.Expanding then
    begin
      return TuiMeasureResult.Create(TuiSize.Create(0, Value.MinimumExtent), TuiSize.Create(0, Value.MinimumExtent), TuiSize.Create(0, TuiMeasureExpandingMaximum));
    end;
  end if;

  return TuiMeasureResult.Fixed(TuiSize.Create(0, Value.MinimumExtent));
end function;

function TuiMeasureApplyPolicy(Hint: TuiMeasureResult; Policy: TuiSizePolicy; Spec: TuiMeasureSpec): TuiMeasureResult;
begin
  var MinimumWidth: integer := Hint.Minimum.Width;
  var MinimumHeight: integer := Hint.Minimum.Height;
  var PreferredWidth: integer := Hint.Preferred.Width;
  var PreferredHeight: integer := Hint.Preferred.Height;
  var MaximumWidth: integer := Hint.Maximum.Width;
  var MaximumHeight: integer := Hint.Maximum.Height;
  if Policy.Horizontal = TuiSizePolicyKind.Fixed then
    begin
      MinimumWidth := PreferredWidth;
      MaximumWidth := PreferredWidth;
    end;
  end if;

  if Policy.Horizontal = TuiSizePolicyKind.Minimum then
    begin
      MinimumWidth := PreferredWidth;
    end;
  end if;

  if Policy.Horizontal = TuiSizePolicyKind.Maximum then
    begin
      MaximumWidth := PreferredWidth;
    end;
  end if;

  if Policy.Horizontal = TuiSizePolicyKind.Expanding then
    begin
      MaximumWidth := TuiMeasureExpandingMaximum;
    end;
  end if;

  if Policy.Vertical = TuiSizePolicyKind.Fixed then
    begin
      MinimumHeight := PreferredHeight;
      MaximumHeight := PreferredHeight;
    end;
  end if;

  if Policy.Vertical = TuiSizePolicyKind.Minimum then
    begin
      MinimumHeight := PreferredHeight;
    end;
  end if;

  if Policy.Vertical = TuiSizePolicyKind.Maximum then
    begin
      MaximumHeight := PreferredHeight;
    end;
  end if;

  if Policy.Vertical = TuiSizePolicyKind.Expanding then
    begin
      MaximumHeight := TuiMeasureExpandingMaximum;
    end;
  end if;
  const Width: TuiMeasureAxisResult := TuiMeasureAxis.Apply(MinimumWidth, PreferredWidth, MaximumWidth, Spec.Width);
  const Height: TuiMeasureAxisResult := TuiMeasureAxis.Apply(MinimumHeight, PreferredHeight, MaximumHeight, Spec.Height);
  return TuiMeasureResult.Create(TuiSize.Create(MinimumWidth, MinimumHeight), TuiSize.Create(Width.Preferred, Height.Preferred), TuiSize.Create(Width.Maximum, Height.Maximum));
end function;

function TuiMeasureChildParticipates(Node: TuiElement): boolean;
begin
  case Node of
    when TuiElement.Empty:
      begin
        return false;
      end;
    else
      begin
        return true;
      end;
  end case;
end function;

// Measures one element under the given constraints.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
// - `Spec`: Measurement constraints for width and height.
public function TuiMeasure(Node: TuiElement; Spec: TuiMeasureSpec): TuiMeasureResult;
begin
  case Node of
    when TuiElement.Empty:
      begin
        return TuiMeasureResult.Fixed(TuiSize.Create(0, 0));
      end;
    when TuiElement.Label(Text):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafLabel(Text), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.Button(Button):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafButton(Button.Text), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.Input(Input):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafInput(Input.Text, Input.Hint), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafTextArea(Text), TuiSizePolicy.Expanding(), Spec);
      end;
    when TuiElement.CheckBox(Id, Text, Checked, ChangeAction):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafCheckBox(Text), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.List(Id, Items, Selected, ChangeAction):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafList(Items), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.Scroll(Id, Offset, ChangeAction, Children):
      begin
        if Children.Length() = 1 then
          begin
            const Child: TuiMeasureResult := TuiMeasure(Children[0], TuiMeasureSpec.Unbounded());
            const Preferred: TuiSize := TuiSize.Create(TuiMeasureAxis.Max(1, Child.Preferred.Width), TuiMeasureAxis.Max(1, Child.Preferred.Height));
            return TuiMeasureApplyPolicy(TuiMeasureResult.Create(TuiSize.Create(1, 1), Preferred, TuiSize.Create(TuiMeasureExpandingMaximum, TuiMeasureExpandingMaximum)), TuiSizePolicy.Expanding(), Spec);
          end;
        end if;

        return TuiMeasureResult.Fixed(TuiSize.Create(0, 0));
      end;
    when TuiElement.MenuBar(Items):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafMenuBar(Items), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.Menu(Id, Nodes, State, ChangeAction):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafMenu(Nodes), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.StatusLine(Items):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafStatusLine(Items), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.CellGrid(Grid):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureResult.Fixed(TuiSize.Create(Grid.Width, Grid.Height)), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.Rule(Text):
      begin
        const MinimumWidth: integer := Std.Console.DisplayWidth(Text) + 4;
        return TuiMeasureApplyPolicy(TuiMeasureResult.Create(TuiSize.Create(MinimumWidth, 1), TuiSize.Create(MinimumWidth, 1), TuiSize.Create(TuiMeasureExpandingMaximum, 1)), TuiSizePolicy.Create(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Fixed), Spec);
      end;
    when TuiElement.Gauge(Gauge):
      begin
        const MinimumWidth: integer := Std.Console.DisplayWidth(Gauge.LabelText) + 10;
        return TuiMeasureApplyPolicy(TuiMeasureResult.Create(TuiSize.Create(MinimumWidth, 1), TuiSize.Create(MinimumWidth +
                                                                                                             8, 1), TuiSize.Create(TuiMeasureExpandingMaximum, 1)), TuiSizePolicy.Create(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Fixed), Spec);
      end;
    when TuiElement.Spacer(Value):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureSpacerValue(Value, true), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.Row(Children, Spacing):
      begin
        var MinimumMain: integer := 0;
        var PreferredMain: integer := 0;
        var MaximumMain: integer := 0;
        var MinimumCross: integer := 0;
        var PreferredCross: integer := 0;
        var MaximumCross: integer := 0;
        var VisibleCount: integer := 0;
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            if TuiMeasureChildParticipates(Children[Index]) then
              begin
                const Measured: TuiMeasureResult := TuiMeasure(Children[Index], Spec);
                if VisibleCount > 0 then
                  begin
                    MinimumMain := TuiMeasureAxis.Add(MinimumMain, Spacing);
                    PreferredMain := TuiMeasureAxis.Add(PreferredMain, Spacing);
                    MaximumMain := TuiMeasureAxis.Add(MaximumMain, Spacing);
                  end;
                end if;

                MinimumMain := TuiMeasureAxis.Add(MinimumMain, Measured.Minimum.Width);
                PreferredMain := TuiMeasureAxis.Add(PreferredMain, Measured.Preferred.Width);
                MaximumMain := TuiMeasureAxis.Add(MaximumMain, Measured.Maximum.Width);
                MinimumCross := TuiMeasureAxis.Max(MinimumCross, Measured.Minimum.Height);
                PreferredCross := TuiMeasureAxis.Max(PreferredCross, Measured.Preferred.Height);
                MaximumCross := TuiMeasureAxis.Max(MaximumCross, Measured.Maximum.Height);
                VisibleCount := VisibleCount + 1;
              end;
            end if;
          end;
        end for;

        return TuiMeasureApplyPolicy(TuiMeasureResult.Create(TuiSize.Create(MinimumMain, MinimumCross), TuiSize.Create(PreferredMain, PreferredCross), TuiSize.Create(MaximumMain, MaximumCross)), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.Column(Children, Spacing):
      begin
        var MinimumMain: integer := 0;
        var PreferredMain: integer := 0;
        var MaximumMain: integer := 0;
        var MinimumCross: integer := 0;
        var PreferredCross: integer := 0;
        var MaximumCross: integer := 0;
        var VisibleCount: integer := 0;
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            if TuiMeasureChildParticipates(Children[Index]) then
              begin
                const Measured: TuiMeasureResult := TuiMeasure(Children[Index], Spec);
                if VisibleCount > 0 then
                  begin
                    MinimumMain := TuiMeasureAxis.Add(MinimumMain, Spacing);
                    PreferredMain := TuiMeasureAxis.Add(PreferredMain, Spacing);
                    MaximumMain := TuiMeasureAxis.Add(MaximumMain, Spacing);
                  end;
                end if;

                MinimumMain := TuiMeasureAxis.Add(MinimumMain, Measured.Minimum.Height);
                PreferredMain := TuiMeasureAxis.Add(PreferredMain, Measured.Preferred.Height);
                MaximumMain := TuiMeasureAxis.Add(MaximumMain, Measured.Maximum.Height);
                MinimumCross := TuiMeasureAxis.Max(MinimumCross, Measured.Minimum.Width);
                PreferredCross := TuiMeasureAxis.Max(PreferredCross, Measured.Preferred.Width);
                MaximumCross := TuiMeasureAxis.Max(MaximumCross, Measured.Maximum.Width);
                VisibleCount := VisibleCount + 1;
              end;
            end if;
          end;
        end for;

        return TuiMeasureApplyPolicy(TuiMeasureResult.Create(TuiSize.Create(MinimumCross, MinimumMain), TuiSize.Create(PreferredCross, PreferredMain), TuiSize.Create(MaximumCross, MaximumMain)), TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.Layout(Settings, Children):
      begin
        var Child: TuiMeasureResult := TuiMeasureResult.Fixed(TuiSize.Create(0, 0));
        if (Children.Length() = 1) and TuiMeasureChildParticipates(Children[0]) then
          begin
            Child := TuiMeasure(Children[0], Spec);
          end;
        end if;
        var Hint: TuiMeasureResult := TuiMeasureResult.Create(TuiSize.Create(Child.Minimum.Width +
                                                                             Settings.Margins.Horizontal(), Child.Minimum.Height +
                                                                                                            Settings.Margins.Vertical()), TuiSize.Create(Child.Preferred.Width +
                                                                                                                                                         Settings.Margins.Horizontal(), Child.Preferred.Height +
                                                                                                                                                                                        Settings.Margins.Vertical()), TuiSize.Create(Child.Maximum.Width +
                                                                                                                                                                                                                                     Settings.Margins.Horizontal(), Child.Maximum.Height +
                                                                                                                                                                                                                                                                    Settings.Margins.Vertical()));
        Hint := TuiMeasureApplyPolicy(Hint, Settings.SizePolicy, Spec);
        case Settings.Width of
          when Some(Width):
            begin
              Hint := TuiMeasureResult.Create(TuiSize.Create(Width, Hint.Minimum.Height), TuiSize.Create(Width, Hint.Preferred.Height), TuiSize.Create(Width, Hint.Maximum.Height));
            end;
          when None:
            begin
            end;
        end case;

        case Settings.Height of
          when Some(Height):
            begin
              Hint := TuiMeasureResult.Create(TuiSize.Create(Hint.Minimum.Width, Height), TuiSize.Create(Hint.Preferred.Width, Height), TuiSize.Create(Hint.Maximum.Width, Height));
            end;
          when None:
            begin
            end;
        end case;

        return Hint;
      end;
    when TuiElement.Panel(Title, Children), TuiElement.Overlay(Title, Children):
      begin
        var ContentMinW: integer := 0;
        var ContentPrefW: integer := 0;
        var ContentMaxW: integer := 0;
        var ContentMinH: integer := 0;
        var ContentPrefH: integer := 0;
        var ContentMaxH: integer := 0;
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            if TuiMeasureChildParticipates(Children[Index]) then
              begin
                const Measured: TuiMeasureResult := TuiMeasure(Children[Index], Spec);
                ContentMinW := TuiMeasureAxis.Max(ContentMinW, Measured.Minimum.Width);
                ContentPrefW := TuiMeasureAxis.Max(ContentPrefW, Measured.Preferred.Width);
                ContentMaxW := TuiMeasureAxis.Max(ContentMaxW, Measured.Maximum.Width);
                ContentMinH := TuiMeasureAxis.Add(ContentMinH, Measured.Minimum.Height);
                ContentPrefH := TuiMeasureAxis.Add(ContentPrefH, Measured.Preferred.Height);
                ContentMaxH := TuiMeasureAxis.Add(ContentMaxH, Measured.Maximum.Height);
              end;
            end if;
          end;
        end for;
        const TitleWidth: integer := Std.Console.DisplayWidth(Title) + 6;
        const Hint: TuiMeasureResult := TuiMeasureResult.Create(TuiSize.Create(TuiMeasureAxis.Max(ContentMinW +
                                                                                                  2, TitleWidth), ContentMinH +
                                                                                                                  2), TuiSize.Create(TuiMeasureAxis.Max(ContentPrefW +
                                                                                                                                                        2, TitleWidth), ContentPrefH +
                                                                                                                                                                        2), TuiSize.Create(TuiMeasureAxis.Max(ContentMaxW +
                                                                                                                                                                                                              2, TitleWidth), ContentMaxH +
                                                                                                                                                                                                                              2));
        return TuiMeasureApplyPolicy(Hint, TuiSizePolicy.Preferred(), Spec);
      end;
    when TuiElement.Desktop(Focused, Children):
      begin
        var MinimumWidth: integer := 0;
        var PreferredWidth: integer := 0;
        var MaximumWidth: integer := 0;
        var MinimumHeight: integer := 0;
        var PreferredHeight: integer := 0;
        var MaximumHeight: integer := 0;
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            if TuiMeasureChildParticipates(Children[Index]) then
              begin
                const Measured: TuiMeasureResult := TuiMeasure(Children[Index], Spec);
                MinimumWidth := TuiMeasureAxis.Max(MinimumWidth, Measured.Minimum.Width);
                PreferredWidth := TuiMeasureAxis.Max(PreferredWidth, Measured.Preferred.Width);
                MaximumWidth := TuiMeasureAxis.Max(MaximumWidth, Measured.Maximum.Width);
                MinimumHeight := TuiMeasureAxis.Max(MinimumHeight, Measured.Minimum.Height);
                PreferredHeight := TuiMeasureAxis.Max(PreferredHeight, Measured.Preferred.Height);
                MaximumHeight := TuiMeasureAxis.Max(MaximumHeight, Measured.Maximum.Height);
              end;
            end if;
          end;
        end for;

        return TuiMeasureApplyPolicy(TuiMeasureResult.Create(TuiSize.Create(MinimumWidth, MinimumHeight), TuiSize.Create(PreferredWidth, PreferredHeight), TuiSize.Create(MaximumWidth, MaximumHeight)), TuiSizePolicy.Preferred(), Spec);
      end;
  end case;
end function;

// Returns the unconstrained preferred size of an element subtree.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMeasureElement(Node: TuiElement): TuiSize;
begin
  return TuiMeasure(Node, TuiMeasureSpec.Unbounded()).Preferred;
end function;
end unit;
