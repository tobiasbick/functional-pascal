unit Std.Tui.Layout.Measure;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Tui.Chrome.MenuItem as MenuItem;
uses Std.Tui.Chrome.MenuNode as MenuNode;
uses Std.Tui.Chrome.MenuQuery as MenuQuery;
uses Std.Tui.Chrome.StatusItem as StatusItem;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Geometry.Size as Size;
uses Std.Tui.Layout.LayoutSettings as LayoutSettings;
uses Std.Tui.Layout.MeasureAxis as MeasureAxis;
uses Std.Tui.Layout.MeasureResult as MeasureResult;
uses Std.Tui.Layout.MeasureSpec as MeasureSpec;
uses Std.Tui.Layout.SizePolicy as SizePolicy;
uses Std.Tui.Layout.Spacer as Spacer;
uses Std.Tui.Text.TextArea as TextArea;
uses Std.Tui.Layout.Margins as Margins2;

// Sentinel maximum extent used by expanding layout measurements.
public const TuiMeasureExpandingMaximum: integer := 9223372036854775807;

function TuiMeasureLeafLabel(Text: string): MeasureResult.TuiMeasureResult;
begin
  return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(Console.DisplayWidth(Text), 1));
end function;

function TuiMeasureLeafMenu(Nodes: array of (MenuNode.TuiMenuNode)): MeasureResult.TuiMeasureResult;
begin
  var Width: integer := 0;
  for Index: integer := 0 to Arrays.Length(Nodes) - 1 do
    begin
      case MenuQuery.TuiMenuNodeParent(Nodes[Index]) of
        when Option.Some(const Parent):
          begin
            null;
          end;
        when Option.None:
          begin
            Width := (Width + Console.DisplayWidth(MenuQuery.TuiMenuNodeText(Nodes[Index]))) + 2;
          end;
      end case;
    end;
  end for;

  return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(Width, 1));
end function;

function TuiMeasureLeafButton(Text: string): MeasureResult.TuiMeasureResult;
begin
  return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(Console.DisplayWidth(Text) + 4, 1));
end function;

function TuiMeasureLeafInput(Text: string; Hint: string): MeasureResult.TuiMeasureResult;
begin
  const ContentWidth: integer := MeasureAxis.TuiMeasureAxisMax(Console.DisplayWidth(Text), Console.DisplayWidth(Hint));
  const Preferred: integer := MeasureAxis.TuiMeasureAxisMax(ContentWidth + 2, 10);
  return MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(10, 1), Size.TuiSizeCreate(Preferred, 1), Size.TuiSizeCreate(Preferred, 1));
end function;

function TuiMeasureLeafTextArea(Text: string): MeasureResult.TuiMeasureResult;
begin
  const Content: Size.TuiSize := TextArea.TuiTextAreaContentSize(Text);
  return MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(1, 1), Content, Size.TuiSizeCreate(TuiMeasureExpandingMaximum, TuiMeasureExpandingMaximum));
end function;

function TuiMeasureLeafCheckBox(Text: string): MeasureResult.TuiMeasureResult;
begin
  return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(Console.DisplayWidth(Text) + 4, 1));
end function;

function TuiMeasureLeafList(Items: array of (string)): MeasureResult.TuiMeasureResult;
begin
  var Width: integer := 2;
  for Index: integer := 0 to Arrays.Length(Items) - 1 do
    begin
      Width := MeasureAxis.TuiMeasureAxisMax(Width, Console.DisplayWidth(Items[Index]) + 2);
    end;
  end for;
  const Count: integer := Arrays.Length(Items);
  const Height: integer := MeasureAxis.TuiMeasureAxisMax(Count, 1);
  return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(Width, Height));
end function;

function TuiMeasureLeafMenuBar(Items: array of (MenuItem.TuiMenuItem)): MeasureResult.TuiMeasureResult;
begin
  var Width: integer := 0;
  for Index: integer := 0 to Arrays.Length(Items) - 1 do
    begin
      Width := (Width + Console.DisplayWidth(Items[Index].Text)) + 2;
    end;
  end for;

  return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(Width, 1));
end function;

function TuiMeasureLeafStatusLine(Items: array of (StatusItem.TuiStatusItem)): MeasureResult.TuiMeasureResult;
begin
  var Width: integer := 0;
  for Index: integer := 0 to Arrays.Length(Items) - 1 do
    begin
      if Index > 0 then
        begin
          Width := Width + 1;
        end;
      end if;

      case Items[Index] of
        when StatusItem.TuiStatusItem.Hint(const Text):
          begin
            Width := Width + Console.DisplayWidth(Text);
          end;
        when StatusItem.TuiStatusItem.Command(const Id, const Text, const Action, const Enabled):
          begin
            Width := Width + Console.DisplayWidth(Text);
          end;
        when StatusItem.TuiStatusItem.KeyHint(const KeyText, const Text):
          begin
            Width := ((Width + Console.DisplayWidth(KeyText)) + Console.DisplayWidth(Text)) + 1;
          end;
      end case;
    end;
  end for;

  return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(Width, 1));
end function;

function TuiMeasureSpacerValue(Value: Spacer.TuiSpacer; Horizontal: boolean): MeasureResult.TuiMeasureResult;
begin
  if Horizontal then
    begin
      if Value.Kind = Spacer.TuiSpacerKind.Expanding then
        begin
          return MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(Value.MinimumExtent, 0), Size.TuiSizeCreate(Value.MinimumExtent, 0), Size.TuiSizeCreate(TuiMeasureExpandingMaximum, 0));
        end;
      end if;

      return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(Value.MinimumExtent, 0));
    end;
  end if;

  if Value.Kind = Spacer.TuiSpacerKind.Expanding then
    begin
      return MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(0, Value.MinimumExtent), Size.TuiSizeCreate(0, Value.MinimumExtent), Size.TuiSizeCreate(0, TuiMeasureExpandingMaximum));
    end;
  end if;

  return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(0, Value.MinimumExtent));
end function;

function TuiMeasureApplyPolicy(
  Hint: MeasureResult.TuiMeasureResult;
  Policy: SizePolicy.TuiSizePolicy;
  Spec: MeasureSpec.TuiMeasureSpec
): MeasureResult.TuiMeasureResult;
begin
  var MinimumWidth: integer := Hint.Minimum.Width;
  var MinimumHeight: integer := Hint.Minimum.Height;
  var PreferredWidth: integer := Hint.Preferred.Width;
  var PreferredHeight: integer := Hint.Preferred.Height;
  var MaximumWidth: integer := Hint.Maximum.Width;
  var MaximumHeight: integer := Hint.Maximum.Height;
  if Policy.Horizontal = SizePolicy.TuiSizePolicyKind.Fixed then
    begin
      MinimumWidth := PreferredWidth;
      MaximumWidth := PreferredWidth;
    end;
  end if;

  if Policy.Horizontal = SizePolicy.TuiSizePolicyKind.Minimum then
    begin
      MinimumWidth := PreferredWidth;
    end;
  end if;

  if Policy.Horizontal = SizePolicy.TuiSizePolicyKind.Maximum then
    begin
      MaximumWidth := PreferredWidth;
    end;
  end if;

  if Policy.Horizontal = SizePolicy.TuiSizePolicyKind.Expanding then
    begin
      MaximumWidth := TuiMeasureExpandingMaximum;
    end;
  end if;

  if Policy.Vertical = SizePolicy.TuiSizePolicyKind.Fixed then
    begin
      MinimumHeight := PreferredHeight;
      MaximumHeight := PreferredHeight;
    end;
  end if;

  if Policy.Vertical = SizePolicy.TuiSizePolicyKind.Minimum then
    begin
      MinimumHeight := PreferredHeight;
    end;
  end if;

  if Policy.Vertical = SizePolicy.TuiSizePolicyKind.Maximum then
    begin
      MaximumHeight := PreferredHeight;
    end;
  end if;

  if Policy.Vertical = SizePolicy.TuiSizePolicyKind.Expanding then
    begin
      MaximumHeight := TuiMeasureExpandingMaximum;
    end;
  end if;
  const Width: MeasureAxis.TuiMeasureAxisResult := MeasureAxis.TuiMeasureAxisApply(MinimumWidth, PreferredWidth, MaximumWidth, Spec.Width);
  const Height: MeasureAxis.TuiMeasureAxisResult := MeasureAxis.TuiMeasureAxisApply(MinimumHeight, PreferredHeight, MaximumHeight, Spec.Height);
  return MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(MinimumWidth, MinimumHeight), Size.TuiSizeCreate(Width.Preferred, Height.Preferred), Size.TuiSizeCreate(Width.Maximum, Height.Maximum));
end function;

function TuiMeasureChildParticipates(Node: Element.TuiElement): boolean;
begin
  case Node of
    when Element.TuiElement.Empty:
      begin
        return false;
      end;
    when Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.Scroll(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.Menu(_, _, _, _), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Row(_, _), Element.TuiElement.Column(_, _), Element.TuiElement.Layout(_, _), Element.TuiElement.Spacer(_), Element.TuiElement.Panel(_, _), Element.TuiElement.Overlay(_, _), Element.TuiElement.Desktop(_, _):
      begin
        begin
          return true;
        end;
      end;
  end case;
end function;

// Measures one element under the given constraints.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
// - `Spec`: Measurement constraints for width and height.
public function TuiMeasure(Node: Element.TuiElement; Spec: MeasureSpec.TuiMeasureSpec): MeasureResult.TuiMeasureResult;
begin
  case Node of
    when Element.TuiElement.Empty:
      begin
        return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(0, 0));
      end;
    when Element.TuiElement.Label(const Text):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafLabel(Text), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.Button(const Button):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafButton(Button.Text), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.Input(const Input):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafInput(Input.Text, Input.Hint), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.TextArea(const Id, const Text, const Caret, const Offset, const ChangeAction):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafTextArea(Text), SizePolicy.TuiSizePolicyExpanding(), Spec);
      end;
    when Element.TuiElement.CheckBox(const Id, const Text, const Checked, const ChangeAction):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafCheckBox(Text), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.List(const Id, const Items, const Selected, const ChangeAction):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafList(Items), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        if Arrays.Length(Children) = 1 then
          begin
            const Child: MeasureResult.TuiMeasureResult := TuiMeasure(Children[0], MeasureSpec.TuiMeasureSpecUnbounded());
            const Preferred: Size.TuiSize := Size.TuiSizeCreate(MeasureAxis.TuiMeasureAxisMax(1, Child.Preferred.Width), MeasureAxis.TuiMeasureAxisMax(1, Child.Preferred.Height));
            return TuiMeasureApplyPolicy(MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(1, 1), Preferred, Size.TuiSizeCreate(TuiMeasureExpandingMaximum, TuiMeasureExpandingMaximum)), SizePolicy.TuiSizePolicyExpanding(), Spec);
          end;
        end if;

        return MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(0, 0));
      end;
    when Element.TuiElement.MenuBar(const Items):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafMenuBar(Items), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafMenu(Nodes), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.StatusLine(const Items):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureLeafStatusLine(Items), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.CellGrid(const Grid):
      begin
        return TuiMeasureApplyPolicy(MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(Grid.Width, Grid.Height)), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.Rule(const Text):
      begin
        const MinimumWidth: integer := Console.DisplayWidth(Text) + 4;
        return TuiMeasureApplyPolicy(MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(MinimumWidth, 1), Size.TuiSizeCreate(MinimumWidth, 1), Size.TuiSizeCreate(TuiMeasureExpandingMaximum, 1)), SizePolicy.TuiSizePolicyCreate(SizePolicy.TuiSizePolicyKind.Expanding, SizePolicy.TuiSizePolicyKind.Fixed), Spec);
      end;
    when Element.TuiElement.Gauge(const Gauge):
      begin
        const MinimumWidth: integer := Console.DisplayWidth(Gauge.LabelText) + 10;
        return TuiMeasureApplyPolicy(MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(MinimumWidth, 1), Size.TuiSizeCreate(MinimumWidth +
                                                                                                                                  8, 1), Size.TuiSizeCreate(TuiMeasureExpandingMaximum, 1)), SizePolicy.TuiSizePolicyCreate(SizePolicy.TuiSizePolicyKind.Expanding, SizePolicy.TuiSizePolicyKind.Fixed), Spec);
      end;
    when Element.TuiElement.Spacer(const Value):
      begin
        return TuiMeasureApplyPolicy(TuiMeasureSpacerValue(Value, true), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.Row(const Children, const Spacing):
      begin
        var MinimumMain: integer := 0;
        var PreferredMain: integer := 0;
        var MaximumMain: integer := 0;
        var MinimumCross: integer := 0;
        var PreferredCross: integer := 0;
        var MaximumCross: integer := 0;
        var VisibleCount: integer := 0;
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            if TuiMeasureChildParticipates(Children[Index]) then
              begin
                const Measured: MeasureResult.TuiMeasureResult := TuiMeasure(Children[Index], Spec);
                if VisibleCount > 0 then
                  begin
                    MinimumMain := MeasureAxis.TuiMeasureAxisAdd(MinimumMain, Spacing);
                    PreferredMain := MeasureAxis.TuiMeasureAxisAdd(PreferredMain, Spacing);
                    MaximumMain := MeasureAxis.TuiMeasureAxisAdd(MaximumMain, Spacing);
                  end;
                end if;

                MinimumMain := MeasureAxis.TuiMeasureAxisAdd(MinimumMain, Measured.Minimum.Width);
                PreferredMain := MeasureAxis.TuiMeasureAxisAdd(PreferredMain, Measured.Preferred.Width);
                MaximumMain := MeasureAxis.TuiMeasureAxisAdd(MaximumMain, Measured.Maximum.Width);
                MinimumCross := MeasureAxis.TuiMeasureAxisMax(MinimumCross, Measured.Minimum.Height);
                PreferredCross := MeasureAxis.TuiMeasureAxisMax(PreferredCross, Measured.Preferred.Height);
                MaximumCross := MeasureAxis.TuiMeasureAxisMax(MaximumCross, Measured.Maximum.Height);
                VisibleCount := VisibleCount + 1;
              end;
            end if;
          end;
        end for;

        return TuiMeasureApplyPolicy(MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(MinimumMain, MinimumCross), Size.TuiSizeCreate(PreferredMain, PreferredCross), Size.TuiSizeCreate(MaximumMain, MaximumCross)), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.Column(const Children, const Spacing):
      begin
        var MinimumMain: integer := 0;
        var PreferredMain: integer := 0;
        var MaximumMain: integer := 0;
        var MinimumCross: integer := 0;
        var PreferredCross: integer := 0;
        var MaximumCross: integer := 0;
        var VisibleCount: integer := 0;
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            if TuiMeasureChildParticipates(Children[Index]) then
              begin
                const Measured: MeasureResult.TuiMeasureResult := TuiMeasure(Children[Index], Spec);
                if VisibleCount > 0 then
                  begin
                    MinimumMain := MeasureAxis.TuiMeasureAxisAdd(MinimumMain, Spacing);
                    PreferredMain := MeasureAxis.TuiMeasureAxisAdd(PreferredMain, Spacing);
                    MaximumMain := MeasureAxis.TuiMeasureAxisAdd(MaximumMain, Spacing);
                  end;
                end if;

                MinimumMain := MeasureAxis.TuiMeasureAxisAdd(MinimumMain, Measured.Minimum.Height);
                PreferredMain := MeasureAxis.TuiMeasureAxisAdd(PreferredMain, Measured.Preferred.Height);
                MaximumMain := MeasureAxis.TuiMeasureAxisAdd(MaximumMain, Measured.Maximum.Height);
                MinimumCross := MeasureAxis.TuiMeasureAxisMax(MinimumCross, Measured.Minimum.Width);
                PreferredCross := MeasureAxis.TuiMeasureAxisMax(PreferredCross, Measured.Preferred.Width);
                MaximumCross := MeasureAxis.TuiMeasureAxisMax(MaximumCross, Measured.Maximum.Width);
                VisibleCount := VisibleCount + 1;
              end;
            end if;
          end;
        end for;

        return TuiMeasureApplyPolicy(MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(MinimumCross, MinimumMain), Size.TuiSizeCreate(PreferredCross, PreferredMain), Size.TuiSizeCreate(MaximumCross, MaximumMain)), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.Layout(const Settings, const Children):
      begin
        var Child: MeasureResult.TuiMeasureResult := MeasureResult.TuiMeasureResultFixed(Size.TuiSizeCreate(0, 0));
        if (Arrays.Length(Children) = 1) and TuiMeasureChildParticipates(Children[0]) then
          begin
            Child := TuiMeasure(Children[0], Spec);
          end;
        end if;
        var Hint: MeasureResult.TuiMeasureResult := MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(Child.Minimum.Width +
                                                                                                            Margins2.TuiMarginsHorizontal(Settings.Margins), Child.Minimum.Height +
                                                                                                                                                             Margins2.TuiMarginsVertical(Settings.Margins)), Size.TuiSizeCreate(Child.Preferred.Width +
                                                                                                                                                                                                                                Margins2.TuiMarginsHorizontal(Settings.Margins), Child.Preferred.Height +
                                                                                                                                                                                                                                                                                 Margins2.TuiMarginsVertical(Settings.Margins)), Size.TuiSizeCreate(Child.Maximum.Width +
                                                                                                                                                                                                                                                                                                                                                    Margins2.TuiMarginsHorizontal(Settings.Margins), Child.Maximum.Height +
                                                                                                                                                                                                                                                                                                                                                                                                     Margins2.TuiMarginsVertical(Settings.Margins)));
        Hint := TuiMeasureApplyPolicy(Hint, Settings.SizePolicy, Spec);
        case Settings.Width of
          when Option.Some(const Width):
            begin
              Hint := MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(Width, Hint.Minimum.Height), Size.TuiSizeCreate(Width, Hint.Preferred.Height), Size.TuiSizeCreate(Width, Hint.Maximum.Height));
            end;
          when Option.None:
            begin
              null;
            end;
        end case;

        case Settings.Height of
          when Option.Some(const Height):
            begin
              Hint := MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(Hint.Minimum.Width, Height), Size.TuiSizeCreate(Hint.Preferred.Width, Height), Size.TuiSizeCreate(Hint.Maximum.Width, Height));
            end;
          when Option.None:
            begin
              null;
            end;
        end case;

        return Hint;
      end;
    when Element.TuiElement.Panel(const Title, const Children), Element.TuiElement.Overlay(const Title, const Children):
      begin
        var ContentMinW: integer := 0;
        var ContentPrefW: integer := 0;
        var ContentMaxW: integer := 0;
        var ContentMinH: integer := 0;
        var ContentPrefH: integer := 0;
        var ContentMaxH: integer := 0;
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            if TuiMeasureChildParticipates(Children[Index]) then
              begin
                const Measured: MeasureResult.TuiMeasureResult := TuiMeasure(Children[Index], Spec);
                ContentMinW := MeasureAxis.TuiMeasureAxisMax(ContentMinW, Measured.Minimum.Width);
                ContentPrefW := MeasureAxis.TuiMeasureAxisMax(ContentPrefW, Measured.Preferred.Width);
                ContentMaxW := MeasureAxis.TuiMeasureAxisMax(ContentMaxW, Measured.Maximum.Width);
                ContentMinH := MeasureAxis.TuiMeasureAxisAdd(ContentMinH, Measured.Minimum.Height);
                ContentPrefH := MeasureAxis.TuiMeasureAxisAdd(ContentPrefH, Measured.Preferred.Height);
                ContentMaxH := MeasureAxis.TuiMeasureAxisAdd(ContentMaxH, Measured.Maximum.Height);
              end;
            end if;
          end;
        end for;
        const TitleWidth: integer := Console.DisplayWidth(Title) + 6;
        const Hint: MeasureResult.TuiMeasureResult := MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(MeasureAxis.TuiMeasureAxisMax(ContentMinW +
                                                                                                                                            2, TitleWidth), ContentMinH +
                                                                                                                                                            2), Size.TuiSizeCreate(MeasureAxis.TuiMeasureAxisMax(ContentPrefW +
                                                                                                                                                                                                                 2, TitleWidth), ContentPrefH +
                                                                                                                                                                                                                                 2), Size.TuiSizeCreate(MeasureAxis.TuiMeasureAxisMax(ContentMaxW +
                                                                                                                                                                                                                                                                                      2, TitleWidth), ContentMaxH +
                                                                                                                                                                                                                                                                                                      2));
        return TuiMeasureApplyPolicy(Hint, SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
    when Element.TuiElement.Desktop(const Focused, const Children):
      begin
        var MinimumWidth: integer := 0;
        var PreferredWidth: integer := 0;
        var MaximumWidth: integer := 0;
        var MinimumHeight: integer := 0;
        var PreferredHeight: integer := 0;
        var MaximumHeight: integer := 0;
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            if TuiMeasureChildParticipates(Children[Index]) then
              begin
                const Measured: MeasureResult.TuiMeasureResult := TuiMeasure(Children[Index], Spec);
                MinimumWidth := MeasureAxis.TuiMeasureAxisMax(MinimumWidth, Measured.Minimum.Width);
                PreferredWidth := MeasureAxis.TuiMeasureAxisMax(PreferredWidth, Measured.Preferred.Width);
                MaximumWidth := MeasureAxis.TuiMeasureAxisMax(MaximumWidth, Measured.Maximum.Width);
                MinimumHeight := MeasureAxis.TuiMeasureAxisMax(MinimumHeight, Measured.Minimum.Height);
                PreferredHeight := MeasureAxis.TuiMeasureAxisMax(PreferredHeight, Measured.Preferred.Height);
                MaximumHeight := MeasureAxis.TuiMeasureAxisMax(MaximumHeight, Measured.Maximum.Height);
              end;
            end if;
          end;
        end for;

        return TuiMeasureApplyPolicy(MeasureResult.TuiMeasureResultCreate(Size.TuiSizeCreate(MinimumWidth, MinimumHeight), Size.TuiSizeCreate(PreferredWidth, PreferredHeight), Size.TuiSizeCreate(MaximumWidth, MaximumHeight)), SizePolicy.TuiSizePolicyPreferred(), Spec);
      end;
  end case;
end function;

// Returns the unconstrained preferred size of an element subtree.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiMeasureElement(Node: Element.TuiElement): Size.TuiSize;
begin
  return TuiMeasure(Node, MeasureSpec.TuiMeasureSpecUnbounded()).Preferred;
end function;

end unit;
