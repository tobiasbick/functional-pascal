unit Std.Tui.Layout.MeasureConstraint;

// Whether a measure axis is unbounded or capped.
public type TuiMeasureConstraintKind = enum
  // Represents the `Unbounded` variant of `TuiMeasureConstraintKind`.
  Unbounded;
  // Represents the `AtMost` variant of `TuiMeasureConstraintKind`.
  AtMost;
end enum;

function TuiMeasureConstraintRequireNonNegative(Value: integer): integer;
begin
  if Value < 0 then
    begin
      panic('Tui measure constraint limit must not be negative');
    end;
  end if;

  return Value;
end function;

// One-axis measurement constraint.
public type TuiMeasureConstraint = record
  // Variant kind represented by the value.
  public Kind: TuiMeasureConstraintKind;
  // Maximum extent of a bounded constraint.
  public Limit: integer;
end record;

// Creates an unbounded axis constraint.
public function TuiMeasureConstraintUnbounded(): TuiMeasureConstraint;
begin
  return TuiMeasureConstraint(Kind := TuiMeasureConstraintKind.Unbounded, Limit := 0);
end function;

// Creates a non-negative upper bound.
//
// Parameters:
// - `Limit`: Upper bound applied by the constraint.
public function TuiMeasureConstraintAtMost(Limit: integer): TuiMeasureConstraint;
begin
  return TuiMeasureConstraint(Kind := TuiMeasureConstraintKind.AtMost, Limit := TuiMeasureConstraintRequireNonNegative(Limit));
end function;

// Returns whether the constraint has an upper bound.
//
// Parameters:
// - `Receiver`: Value processed by the function.
public function TuiMeasureConstraintIsBounded(Receiver: TuiMeasureConstraint): boolean;
begin
  return Receiver.Kind = TuiMeasureConstraintKind.AtMost;
end function;

end unit;
