unit Std.Tui.Layout.MeasureResult;

uses Std.Tui.Geometry.Size;

procedure TuiMeasureResultRequireOrdered(Minimum: TuiSize; Preferred: TuiSize; Maximum: TuiSize);
begin
  if (Minimum.Width > Preferred.Width) or (Minimum.Height > Preferred.Height) then
  begin
    panic('Tui measure result minimum size must not exceed preferred size')
  end;

  if (Preferred.Width > Maximum.Width) or (Preferred.Height > Maximum.Height) then
  begin
    panic('Tui measure result preferred size must not exceed maximum size')
  end
end;

public type
  // Minimum, preferred, and maximum extents for one element.
  TuiMeasureResult = record
    // Minimum value or size.
    public Minimum: TuiSize;
    // Preferred size.
    public Preferred: TuiSize;
    // Maximum value or size.
    public Maximum: TuiSize;

    // Creates an ordered measure result.
    //
    // Parameters:
    // - `Minimum`: Minimum accepted value or extent.
    // - `Preferred`: Preferred size or focus identifier.
    // - `Maximum`: Maximum accepted value or extent.
    public static function Create(Minimum: TuiSize; Preferred: TuiSize; Maximum: TuiSize): TuiMeasureResult;
    begin
      TuiMeasureResultRequireOrdered(Minimum, Preferred, Maximum);
      return record
        Minimum := Minimum;
        Preferred := Preferred;
        Maximum := Maximum;
      end
    end;

    // Creates a fixed measure where all three sizes match.
    //
    // Parameters:
    // - `Size`: Size in terminal cells.
    public static function Fixed(Size: TuiSize): TuiMeasureResult;
    begin
      return TuiMeasureResult.Create(Size, Size, Size)
    end;
  end;
