unit Std.Tui.Layout.MeasureSpec;

uses Std.Tui.Geometry.Size as Size2;
uses Std.Tui.Layout.MeasureConstraint as MeasureConstraint;

// Width and height measurement constraints for one element.
public type TuiMeasureSpec = record
  // Width in terminal cells.
  public Width: MeasureConstraint.TuiMeasureConstraint;
  // Height in terminal cells.
  public Height: MeasureConstraint.TuiMeasureConstraint;
end record;

// Creates a two-axis measure specification.
//
// Parameters:
// - `Width`: Width in terminal cells.
// - `Height`: Height in terminal cells.
public function TuiMeasureSpecCreate(
  Width: MeasureConstraint.TuiMeasureConstraint;
  Height: MeasureConstraint.TuiMeasureConstraint
): TuiMeasureSpec;
begin
  return TuiMeasureSpec(Width := Width, Height := Height);
end function;

// Both axes unbounded.
public function TuiMeasureSpecUnbounded(): TuiMeasureSpec;
begin
  return TuiMeasureSpecCreate(MeasureConstraint.TuiMeasureConstraintUnbounded(), MeasureConstraint.TuiMeasureConstraintUnbounded());
end function;

// Both axes capped by the given size.
//
// Parameters:
// - `Size`: Size in terminal cells.
public function TuiMeasureSpecAtMost(Size: Size2.TuiSize): TuiMeasureSpec;
begin
  return TuiMeasureSpecCreate(MeasureConstraint.TuiMeasureConstraintAtMost(Size.Width), MeasureConstraint.TuiMeasureConstraintAtMost(Size.Height));
end function;

end unit;
