unit Std.Tui.Layout.SizePolicy;

// Per-axis growth and shrink policy for layout.
public type TuiSizePolicyKind = enum
  // Represents the `Fixed` variant of `TuiSizePolicyKind`.
  Fixed;
  // Represents the `Minimum` variant of `TuiSizePolicyKind`.
  Minimum;
  // Represents the `Maximum` variant of `TuiSizePolicyKind`.
  Maximum;
  // Represents the `Preferred` variant of `TuiSizePolicyKind`.
  Preferred;
  // Represents the `Expanding` variant of `TuiSizePolicyKind`.
  Expanding;
end enum;

// Independent horizontal and vertical size policies.
public type TuiSizePolicy = record
  // Horizontal policy, alignment, or extent.
  public Horizontal: TuiSizePolicyKind;
  // Vertical policy, alignment, or extent.
  public Vertical: TuiSizePolicyKind;
end record;

// Creates a mixed-axis size policy.
//
// Parameters:
// - `Horizontal`: Horizontal policy, alignment, or extent.
// - `Vertical`: Vertical policy, alignment, or extent.
public function TuiSizePolicyCreate(Horizontal: TuiSizePolicyKind; Vertical: TuiSizePolicyKind): TuiSizePolicy;
begin
  return TuiSizePolicy(Horizontal := Horizontal, Vertical := Vertical);
end function;

// Both axes fixed to preferred size.
public function TuiSizePolicyFixed(): TuiSizePolicy;
begin
  return TuiSizePolicyCreate(TuiSizePolicyKind.Fixed, TuiSizePolicyKind.Fixed);
end function;

// Both axes use preferred as the minimum.
public function TuiSizePolicyMinimum(): TuiSizePolicy;
begin
  return TuiSizePolicyCreate(TuiSizePolicyKind.Minimum, TuiSizePolicyKind.Minimum);
end function;

// Both axes use preferred as the maximum.
public function TuiSizePolicyMaximum(): TuiSizePolicy;
begin
  return TuiSizePolicyCreate(TuiSizePolicyKind.Maximum, TuiSizePolicyKind.Maximum);
end function;

// Both axes treat preferred as ideal with grow and shrink.
public function TuiSizePolicyPreferred(): TuiSizePolicy;
begin
  return TuiSizePolicyCreate(TuiSizePolicyKind.Preferred, TuiSizePolicyKind.Preferred);
end function;

// Both axes request additional space beyond preferred.
public function TuiSizePolicyExpanding(): TuiSizePolicy;
begin
  return TuiSizePolicyCreate(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Expanding);
end function;

end unit;
