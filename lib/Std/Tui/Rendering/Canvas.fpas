unit Std.Tui.Rendering.Canvas;

uses
  Std.Console, Std.Str, Std.Tui.Cells.Cell, Std.Tui.Cells.StyleRole, Std.Tui.Geometry.Point,
  Std.Tui.Geometry.Rect, Std.Tui.Geometry.Size, Std.Tui.Rendering.Surface;

public type
  /// Private frame-scoped drawing capability over one working surface.
  TuiCanvas = record
    public Surface: TuiWorkingSurface;
    public Clip: TuiRect;
    public Origin: TuiPoint;

    /// Creates a canvas clipped to `Bounds` intersected with the surface.

    public static function Create(Surface: TuiWorkingSurface; Bounds: TuiRect): TuiCanvas;
    begin
      var Size: TuiSize := Surface.Size();
      var SurfaceBounds: TuiRect := TuiRect.Create(0, 0, Size.Width, Size.Height);
      return record
        Surface := Surface;
        Clip := Bounds.Intersect(SurfaceBounds);
        Origin := TuiPoint.Create(0, 0);
      end
    end;

    /// Creates a canvas with an explicit surface origin and local clip rectangle.

    public static function CreateLocal(Surface: TuiWorkingSurface; Origin: TuiPoint; Clip: TuiRect): TuiCanvas;
    begin
      return record Surface := Surface; Clip := Clip; Origin := Origin; end
    end;

    /// Returns a nested canvas for `LocalBounds` in this canvas's local coordinates.

    public function Child(Self: TuiCanvas; LocalBounds: TuiRect): TuiCanvas;
    begin
      var Visible: TuiRect := LocalBounds.Intersect(Self.Clip);
      var ChildClip: TuiRect := TuiRect.Create(Visible.X - LocalBounds.X, Visible.Y - LocalBounds.Y, Visible.Width, Visible.Height);
      return TuiCanvas.CreateLocal(Self.Surface, TuiPoint.Create(Self.Origin.X + LocalBounds.X, Self.Origin.Y +
                                                                                                LocalBounds.Y), ChildClip)
    end;

    /// Paints one cell in local coordinates; clipped and wide-glyph aware.

    public procedure PutCell(Self: TuiCanvas; Position: TuiPoint; Cell: TuiCell);
    begin
      if not Self.Clip.Contains(Position) then
      begin
        return
      end;
      var CellWidth: integer := Cell.Width();
      if (CellWidth = 2) and not Self.Clip.Contains(TuiPoint.Create(Position.X + 1, Position.Y)) then
      begin
        Self.Surface.PutCell(TuiPoint.Create(Self.Origin.X + Position.X, Self.Origin.Y + Position.Y), TuiCell.Create(' ', TuiStyleRole.Normal));
        return
      end;
      Self.Surface.PutCell(TuiPoint.Create(Self.Origin.X + Position.X, Self.Origin.Y + Position.Y), Cell)
    end;

    /// Paints one glyph with the normal role.

    public procedure PutGlyph(Self: TuiCanvas; X: integer; Y: integer; Glyph: string);
    begin
      Self.PutCell(TuiPoint.Create(X, Y), TuiCell.Create(Glyph, TuiStyleRole.Normal))
    end;

    /// Fills the visible intersection with a one-column cell.

    public procedure FillRect(Self: TuiCanvas; Bounds: TuiRect; Cell: TuiCell);
    begin
      var CellWidth: integer := Cell.Width();
      if CellWidth <> 1 then
      begin
        panic('Tui canvas FillRect requires a one-column cell')
      end;
      var Visible: TuiRect := Bounds.Intersect(Self.Clip);
      TuiSurfaceFillRect(Self.Surface, TuiRect.Create(Self.Origin.X + Visible.X, Self.Origin.Y +
                                                                                 Visible.Y, Visible.Width, Visible.Height), Cell)
    end;

    /// Draws one logical line of text; stops before a newline.

    public procedure WriteText(Self: TuiCanvas; Position: TuiPoint; Text: string; Role: TuiStyleRole);
    begin
      mutable var X: integer := Position.X;
      mutable var AsciiOnly: boolean := true;
      var TextLength: integer := Std.Str.Length(Text);
      for Index: integer := 0 to TextLength - 1 do
      begin
        var Code: integer := Std.Str.Ord(Std.Str.CharAt(Text, Index));
        if (Code <> 10) and ((Code < 32) or (Code > 126)) then
        begin
          AsciiOnly := false
        end
      end;
      if AsciiOnly then
      begin
        for Index: integer := 0 to TextLength - 1 do
        begin
          var Glyph: string := Std.Str.CharAt(Text, Index);
          if Glyph = Std.Str.Chr(10) then
          begin
            return
          end;
          Self.PutCell(TuiPoint.Create(X, Position.Y), TuiCell.Create(Glyph, Role));
          X := X + 1
        end;
        return
      end;
      for Glyph: string in Std.Console.SplitGraphemes(Text) do
      begin
        if Glyph = Std.Str.Chr(10) then
        begin
          return
        end;
        Self.PutCell(TuiPoint.Create(X, Position.Y), TuiCell.Create(Glyph, Role));
        X := X + Std.Console.DisplayWidth(Glyph)
      end
    end;

    /// Draws a horizontal box-drawing line.

    public procedure DrawHorizontalLine(
  Self: TuiCanvas;
  X: integer;
  Y: integer;
  Width: integer;
  Role: TuiStyleRole
);
    begin
      var Cell: TuiCell := TuiCell.Create('─', Role);
      for Offset: integer := 0 to Width - 1 do
      begin
        Self.PutCell(TuiPoint.Create(X + Offset, Y), Cell)
      end
    end;

    /// Draws a vertical box-drawing line.

    public procedure DrawVerticalLine(
  Self: TuiCanvas;
  X: integer;
  Y: integer;
  Height: integer;
  Role: TuiStyleRole
);
    begin
      var Cell: TuiCell := TuiCell.Create('│', Role);
      for Offset: integer := 0 to Height - 1 do
      begin
        Self.PutCell(TuiPoint.Create(X, Y + Offset), Cell)
      end
    end;

    /// Draws a box frame using Unicode box-drawing glyphs.

    public procedure DrawFrame(Self: TuiCanvas; Bounds: TuiRect; Role: TuiStyleRole);
    begin
      if Bounds.IsEmpty() then
      begin
        return
      end;
      if Bounds.Width = 1 then
      begin
        Self.DrawVerticalLine(Bounds.X, Bounds.Y, Bounds.Height, Role);
        Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Y), TuiCell.Create('╭', Role));
        if Bounds.Height > 1 then
        begin
          Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Bottom() - 1), TuiCell.Create('╰', Role))
        end;
        return
      end;
      if Bounds.Height = 1 then
      begin
        Self.DrawHorizontalLine(Bounds.X, Bounds.Y, Bounds.Width, Role);
        Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Y), TuiCell.Create('╭', Role));
        Self.PutCell(TuiPoint.Create(Bounds.Right() - 1, Bounds.Y), TuiCell.Create('╮', Role));
        return
      end;
      Self.DrawHorizontalLine(Bounds.X, Bounds.Y, Bounds.Width, Role);
      Self.DrawHorizontalLine(Bounds.X, Bounds.Bottom() - 1, Bounds.Width, Role);
      Self.DrawVerticalLine(Bounds.X, Bounds.Y + 1, Bounds.Height - 2, Role);
      Self.DrawVerticalLine(Bounds.Right() - 1, Bounds.Y + 1, Bounds.Height - 2, Role);
      Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Y), TuiCell.Create('╭', Role));
      Self.PutCell(TuiPoint.Create(Bounds.Right() - 1, Bounds.Y), TuiCell.Create('╮', Role));
      Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Bottom() - 1), TuiCell.Create('╰', Role));
      Self.PutCell(TuiPoint.Create(Bounds.Right() - 1, Bounds.Bottom() - 1), TuiCell.Create('╯', Role))
    end;
  end;
