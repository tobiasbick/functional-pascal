unit Std.Tui.Rendering.Canvas;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Tui.Cells.Cell as Cell2;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Geometry.Size as Size2;
uses Std.Tui.Rendering.Surface as Surface2;

// Private frame-scoped drawing capability over one working surface.
public type TuiCanvas = record
  // Working surface targeted by the canvas.
  public Surface: Surface2.TuiWorkingSurface;
  // Clipping rectangle in surface coordinates.
  public Clip: Rect.TuiRect;
  // Canvas origin in surface coordinates.
  public Origin: Point.TuiPoint;

  // Creates a canvas clipped to `Bounds` intersected with the surface.
  //
  // Parameters:
  // - `Surface`: Working surface affected by the operation.
  // - `Bounds`: Rectangle affected by the operation.
  public static function Create(Surface: Surface2.TuiWorkingSurface; Bounds: Rect.TuiRect): TuiCanvas;
  begin
    var Size: Size2.TuiSize := Surface.Size();
    var SurfaceBounds: Rect.TuiRect := Rect.TuiRect.Create(0, 0, Size.Width, Size.Height);
    return record
      Surface := Surface;
      Clip := Bounds.Intersect(SurfaceBounds);
      Origin := Point.TuiPoint.Create(0, 0);
    end record;
  end function;

  // Creates a canvas with an explicit surface origin and local clip rectangle.
  //
  // Parameters:
  // - `Surface`: Working surface affected by the operation.
  // - `Origin`: Canvas origin in surface coordinates.
  // - `Clip`: Clipping rectangle for drawing.
  public static function CreateLocal(
  Surface: Surface2.TuiWorkingSurface;
  Origin: Point.TuiPoint;
  Clip: Rect.TuiRect
): TuiCanvas;
  begin
    return record
      Surface := Surface;
      Clip := Clip;
      Origin := Origin;
    end record;
  end function;

  // Returns a nested canvas for `LocalBounds` in this canvas's local coordinates.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `LocalBounds`: Bounds expressed in the parent canvas coordinate system.
  public function Child(Self: TuiCanvas; LocalBounds: Rect.TuiRect): TuiCanvas;
  begin
    var Visible: Rect.TuiRect := LocalBounds.Intersect(Self.Clip);
    var ChildClip: Rect.TuiRect := Rect.TuiRect.Create(Visible.X - LocalBounds.X, Visible.Y -
                                                                                  LocalBounds.Y, Visible.Width, Visible.Height);
    return TuiCanvas.CreateLocal(Self.Surface, Point.TuiPoint.Create(Self.Origin.X + LocalBounds.X, Self.Origin.Y +
                                                                                                    LocalBounds.Y), ChildClip);
  end function;

  // Paints one cell in local coordinates; clipped and wide-glyph aware.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Position`: Position in terminal-cell coordinates.
  // - `Cell`: Terminal cell written by the operation.
  public procedure PutCell(Self: TuiCanvas; Position: Point.TuiPoint; Cell: Cell2.TuiCell);
  begin
    if not Self.Clip.Contains(Position) then
      begin
        return;
      end;
    end if;
    var CellWidth: integer := Cell.Width();
    if (CellWidth = 2) and not Self.Clip.Contains(Point.TuiPoint.Create(Position.X + 1, Position.Y)) then
      begin
        Self.Surface.PutCell(Point.TuiPoint.Create(Self.Origin.X + Position.X, Self.Origin.Y +
                                                                               Position.Y), Cell2.TuiCell.Create(' ', StyleRole.TuiStyleRole.Normal));
        return;
      end;
    end if;

    Self.Surface.PutCell(Point.TuiPoint.Create(Self.Origin.X + Position.X, Self.Origin.Y +
                                                                           Position.Y), Cell);
  end procedure;

  // Paints one glyph with the normal role.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `X`: Zero-based horizontal terminal-cell coordinate.
  // - `Y`: Zero-based vertical terminal-cell coordinate.
  // - `Glyph`: Single renderable grapheme.
  public procedure PutGlyph(Self: TuiCanvas; X: integer; Y: integer; Glyph: string);
  begin
    Self.PutCell(Point.TuiPoint.Create(X, Y), Cell2.TuiCell.Create(Glyph, StyleRole.TuiStyleRole.Normal));
  end procedure;

  // Fills the visible intersection with a one-column cell.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Bounds`: Rectangle affected by the operation.
  // - `Cell`: Terminal cell written by the operation.
  public procedure FillRect(Self: TuiCanvas; Bounds: Rect.TuiRect; Cell: Cell2.TuiCell);
  begin
    var CellWidth: integer := Cell.Width();
    if CellWidth <> 1 then
      begin
        panic('Tui canvas FillRect requires a one-column cell');
      end;
    end if;
    var Visible: Rect.TuiRect := Bounds.Intersect(Self.Clip);
    Surface2.TuiSurfaceFillRect(Self.Surface, Rect.TuiRect.Create(Self.Origin.X + Visible.X, Self.Origin.Y +
                                                                                             Visible.Y, Visible.Width, Visible.Height), Cell);
  end procedure;

  // Draws one logical line of text; stops before a newline.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Position`: Position in terminal-cell coordinates.
  // - `Text`: Text processed or displayed by the operation.
  // - `Role`: Semantic style role used by the operation.
  public procedure WriteText(
  Self: TuiCanvas;
  Position: Point.TuiPoint;
  Text: string;
  Role: StyleRole.TuiStyleRole
);
  begin
    mutable var X: integer := Position.X;
    mutable var AsciiOnly: boolean := true;
    var TextLength: integer := Str.Length(Text);
    for Index: integer := 0 to TextLength - 1 do
      begin
        var Code: integer := Str.Ord(Str.CharAt(Text, Index));
        if (Code <> 10) and ((Code < 32) or (Code > 126)) then
          begin
            AsciiOnly := false;
          end;
        end if;
      end;
    end for;

    if AsciiOnly then
      begin
        for Index: integer := 0 to TextLength - 1 do
          begin
            var Glyph: string := Str.CharAt(Text, Index);
            if Glyph = Str.Chr(10) then
              begin
                return;
              end;
            end if;

            Self.PutCell(Point.TuiPoint.Create(X, Position.Y), Cell2.TuiCell.Create(Glyph, Role));
            X := X + 1;
          end;
        end for;

        return;
      end;
    end if;

    for Glyph: string in Console.SplitGraphemes(Text) do
      begin
        if Glyph = Str.Chr(10) then
          begin
            return;
          end;
        end if;
        var GlyphWidth: integer := Console.DisplayWidth(Glyph);
        if GlyphWidth > 0 then
          begin
            Self.PutCell(Point.TuiPoint.Create(X, Position.Y), Cell2.TuiCell.Create(Glyph, Role));
            X := X + GlyphWidth;
          end;
        end if;
      end;
    end for;
  end procedure;

  // Draws a horizontal box-drawing line.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `X`: Zero-based horizontal terminal-cell coordinate.
  // - `Y`: Zero-based vertical terminal-cell coordinate.
  // - `Width`: Width in terminal cells.
  // - `Role`: Semantic style role used by the operation.
  public procedure DrawHorizontalLine(
  Self: TuiCanvas;
  X: integer;
  Y: integer;
  Width: integer;
  Role: StyleRole.TuiStyleRole
);
  begin
    var Cell: Cell2.TuiCell := Cell2.TuiCell.Create('─', Role);
    for Offset: integer := 0 to Width - 1 do
      begin
        Self.PutCell(Point.TuiPoint.Create(X + Offset, Y), Cell);
      end;
    end for;
  end procedure;

  // Draws a vertical box-drawing line.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `X`: Zero-based horizontal terminal-cell coordinate.
  // - `Y`: Zero-based vertical terminal-cell coordinate.
  // - `Height`: Height in terminal cells.
  // - `Role`: Semantic style role used by the operation.
  public procedure DrawVerticalLine(
  Self: TuiCanvas;
  X: integer;
  Y: integer;
  Height: integer;
  Role: StyleRole.TuiStyleRole
);
  begin
    var Cell: Cell2.TuiCell := Cell2.TuiCell.Create('│', Role);
    for Offset: integer := 0 to Height - 1 do
      begin
        Self.PutCell(Point.TuiPoint.Create(X, Y + Offset), Cell);
      end;
    end for;
  end procedure;

  // Draws a box frame using Unicode box-drawing glyphs.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Bounds`: Rectangle affected by the operation.
  // - `Role`: Semantic style role used by the operation.
  public procedure DrawFrame(Self: TuiCanvas; Bounds: Rect.TuiRect; Role: StyleRole.TuiStyleRole);
  begin
    if Bounds.IsEmpty() then
      begin
        return;
      end;
    end if;

    if Bounds.Width = 1 then
      begin
        Self.DrawVerticalLine(Bounds.X, Bounds.Y, Bounds.Height, Role);
        Self.PutCell(Point.TuiPoint.Create(Bounds.X, Bounds.Y), Cell2.TuiCell.Create('╭', Role));
        if Bounds.Height > 1 then
          begin
            Self.PutCell(Point.TuiPoint.Create(Bounds.X, Bounds.Bottom() - 1), Cell2.TuiCell.Create('╰', Role));
          end;
        end if;

        return;
      end;
    end if;

    if Bounds.Height = 1 then
      begin
        Self.DrawHorizontalLine(Bounds.X, Bounds.Y, Bounds.Width, Role);
        Self.PutCell(Point.TuiPoint.Create(Bounds.X, Bounds.Y), Cell2.TuiCell.Create('╭', Role));
        Self.PutCell(Point.TuiPoint.Create(Bounds.Right() - 1, Bounds.Y), Cell2.TuiCell.Create('╮', Role));
        return;
      end;
    end if;

    Self.DrawHorizontalLine(Bounds.X, Bounds.Y, Bounds.Width, Role);
    Self.DrawHorizontalLine(Bounds.X, Bounds.Bottom() - 1, Bounds.Width, Role);
    Self.DrawVerticalLine(Bounds.X, Bounds.Y + 1, Bounds.Height - 2, Role);
    Self.DrawVerticalLine(Bounds.Right() - 1, Bounds.Y + 1, Bounds.Height - 2, Role);
    Self.PutCell(Point.TuiPoint.Create(Bounds.X, Bounds.Y), Cell2.TuiCell.Create('╭', Role));
    Self.PutCell(Point.TuiPoint.Create(Bounds.Right() - 1, Bounds.Y), Cell2.TuiCell.Create('╮', Role));
    Self.PutCell(Point.TuiPoint.Create(Bounds.X, Bounds.Bottom() - 1), Cell2.TuiCell.Create('╰', Role));
    Self.PutCell(Point.TuiPoint.Create(Bounds.Right() - 1, Bounds.Bottom() - 1), Cell2.TuiCell.Create('╯', Role));
  end procedure;
end record;

// Paints consecutive cells in local coordinates with canvas clipping.
public procedure TuiCanvasPutCells(
  Canvas: TuiCanvas;
  Position: Point.TuiPoint;
  Cells: array of Cell2.TuiCell
);
begin
  if (Position.Y < Canvas.Clip.Y) or (Position.Y >= Canvas.Clip.Bottom()) then
    begin
      return;
    end;
  end if;
  mutable var SourceX: integer := 0;
  mutable var TargetX: integer := Position.X;
  if TargetX < Canvas.Clip.X then
    begin
      SourceX := Canvas.Clip.X - TargetX;
      TargetX := Canvas.Clip.X;
    end;
  end if;
  mutable var Count: integer := Arrays.Length(Cells) - SourceX;
  if Count > Canvas.Clip.Right() - TargetX then
    begin
      Count := Canvas.Clip.Right() - TargetX;
    end;
  end if;

  if Count <= 0 then
    begin
      return;
    end;
  end if;
  mutable var Values: array of Cell2.TuiCell := Arrays.Slice(Cells, SourceX, Count);
  if (TargetX + Count = Canvas.Clip.Right()) and (Values[Count - 1].Columns = 2) then
    begin
      Values[Count - 1] := Cell2.TuiCell.Create(' ', StyleRole.TuiStyleRole.Normal);
    end;
  end if;

  Surface2.TuiSurfacePutCells(Canvas.Surface, Point.TuiPoint.Create(Canvas.Origin.X + TargetX, Canvas.Origin.Y +
                                                                                               Position.Y), Values);
end procedure;

end unit;
