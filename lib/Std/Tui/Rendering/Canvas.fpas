unit Std.Tui.Rendering.Canvas;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Tui.Cells.Cell as Cell2;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Geometry.Size as Size2;
uses Std.Tui.Rendering.Surface as Surface2;

// Private frame-scoped drawing capability over one working surface.
public type TuiCanvas = record
  // Working surface targeted by the canvas.
  public Surface: Surface2.TuiWorkingSurface;
  // Clipping rectangle in surface coordinates.
  public Clip: Rect.TuiRect;
  // Canvas origin in surface coordinates.
  public Origin: Point.TuiPoint;
end record;

// Creates a canvas clipped to `Bounds` intersected with the surface.
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
// - `Bounds`: Rectangle affected by the operation.
public function TuiCanvasCreate(Surface: Surface2.TuiWorkingSurface; Bounds: Rect.TuiRect): TuiCanvas;
begin
  const Size: Size2.TuiSize := Surface2.TuiWorkingSurfaceSize(Surface);
  const SurfaceBounds: Rect.TuiRect := Rect.TuiRectCreate(0, 0, Size.Width, Size.Height);
  return TuiCanvas(Surface := Surface, Clip := Rect.TuiRectIntersect(Bounds, SurfaceBounds), Origin := Point.TuiPointCreate(0, 0));
end function;

// Creates a canvas with an explicit surface origin and local clip rectangle.
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
// - `Origin`: Canvas origin in surface coordinates.
// - `Clip`: Clipping rectangle for drawing.
public function TuiCanvasCreateLocal(
  Surface: Surface2.TuiWorkingSurface;
  Origin: Point.TuiPoint;
  Clip: Rect.TuiRect
): TuiCanvas;
begin
  return TuiCanvas(Surface := Surface, Clip := Clip, Origin := Origin);
end function;

// Returns a nested canvas for `LocalBounds` in this canvas's local coordinates.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `LocalBounds`: Bounds expressed in the parent canvas coordinate system.
public function TuiCanvasChild(Receiver: TuiCanvas; LocalBounds: Rect.TuiRect): TuiCanvas;
begin
  const Visible: Rect.TuiRect := Rect.TuiRectIntersect(LocalBounds, Receiver.Clip);
  const ChildClip: Rect.TuiRect := Rect.TuiRectCreate(Visible.X - LocalBounds.X, Visible.Y -
                                                                                 LocalBounds.Y, Visible.Width, Visible.Height);
  return TuiCanvasCreateLocal(Receiver.Surface, Point.TuiPointCreate(Receiver.Origin.X +
                                                                     LocalBounds.X, Receiver.Origin.Y +
                                                                                    LocalBounds.Y), ChildClip);
end function;

// Paints one cell in local coordinates; clipped and wide-glyph aware.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Position`: Position in terminal-cell coordinates.
// - `Cell`: Terminal cell written by the operation.
public procedure TuiCanvasPutCell(Receiver: TuiCanvas; Position: Point.TuiPoint; Cell: Cell2.TuiCell);
begin
  if not Rect.TuiRectContains(Receiver.Clip, Position) then
    begin
      return;
    end;
  end if;
  const CellWidth: integer := Cell2.TuiCellWidth(Cell);
  if (CellWidth = 2) and
     not Rect.TuiRectContains(Receiver.Clip, Point.TuiPointCreate(Position.X + 1, Position.Y)) then
    begin
      Surface2.TuiWorkingSurfacePutCell(Receiver.Surface, Point.TuiPointCreate(Receiver.Origin.X +
                                                                               Position.X, Receiver.Origin.Y +
                                                                                           Position.Y), Cell2.TuiCellCreate(' ', StyleRole.TuiStyleRole.Normal));
      return;
    end;
  end if;

  Surface2.TuiWorkingSurfacePutCell(Receiver.Surface, Point.TuiPointCreate(Receiver.Origin.X +
                                                                           Position.X, Receiver.Origin.Y +
                                                                                       Position.Y), Cell);
end procedure;

// Paints one glyph with the normal role.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `X`: Zero-based horizontal terminal-cell coordinate.
// - `Y`: Zero-based vertical terminal-cell coordinate.
// - `Glyph`: Single renderable grapheme.
public procedure TuiCanvasPutGlyph(Receiver: TuiCanvas; X: integer; Y: integer; Glyph: string);
begin
  TuiCanvasPutCell(Receiver, Point.TuiPointCreate(X, Y), Cell2.TuiCellCreate(Glyph, StyleRole.TuiStyleRole.Normal));
end procedure;

// Fills the visible intersection with a one-column cell.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Bounds`: Rectangle affected by the operation.
// - `Cell`: Terminal cell written by the operation.
public procedure TuiCanvasFillRect(Receiver: TuiCanvas; Bounds: Rect.TuiRect; Cell: Cell2.TuiCell);
begin
  const CellWidth: integer := Cell2.TuiCellWidth(Cell);
  if CellWidth <> 1 then
    begin
      panic('Tui canvas FillRect requires a one-column cell');
    end;
  end if;
  const Visible: Rect.TuiRect := Rect.TuiRectIntersect(Bounds, Receiver.Clip);
  Surface2.TuiSurfaceFillRect(Receiver.Surface, Rect.TuiRectCreate(Receiver.Origin.X + Visible.X, Receiver.Origin.Y +
                                                                                                  Visible.Y, Visible.Width, Visible.Height), Cell);
end procedure;

// Draws one logical line of text; stops before a newline.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Position`: Position in terminal-cell coordinates.
// - `Text`: Text processed or displayed by the operation.
// - `Role`: Semantic style role used by the operation.
public procedure TuiCanvasWriteText(
  Receiver: TuiCanvas;
  Position: Point.TuiPoint;
  Text: string;
  Role: StyleRole.TuiStyleRole
);
begin
  var X: integer := Position.X;
  var AsciiOnly: boolean := true;
  const TextLength: integer := Str.Length(Text);
  for Index: integer := 0 to TextLength - 1 do
    begin
      const Code: integer := Str.Ord(Str.CharAt(Text, Index));
      if (Code <> 10) and ((Code < 32) or (Code > 126)) then
        begin
          AsciiOnly := false;
        end;
      end if;
    end;
  end for;

  if AsciiOnly then
    begin
      for Index: integer := 0 to TextLength - 1 do
        begin
          const Glyph: string := Str.CharAt(Text, Index);
          if Glyph = Str.Chr(10) then
            begin
              return;
            end;
          end if;

          TuiCanvasPutCell(Receiver, Point.TuiPointCreate(X, Position.Y), Cell2.TuiCellCreate(Glyph, Role));
          X := X + 1;
        end;
      end for;

      return;
    end;
  end if;

  for Glyph: string in Console.SplitGraphemes(Text) do
    begin
      if Glyph = Str.Chr(10) then
        begin
          return;
        end;
      end if;
      const GlyphWidth: integer := Console.DisplayWidth(Glyph);
      if GlyphWidth > 0 then
        begin
          TuiCanvasPutCell(Receiver, Point.TuiPointCreate(X, Position.Y), Cell2.TuiCellCreate(Glyph, Role));
          X := X + GlyphWidth;
        end;
      end if;
    end;
  end for;
end procedure;

// Draws a horizontal box-drawing line.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `X`: Zero-based horizontal terminal-cell coordinate.
// - `Y`: Zero-based vertical terminal-cell coordinate.
// - `Width`: Width in terminal cells.
// - `Role`: Semantic style role used by the operation.
public procedure TuiCanvasDrawHorizontalLine(
  Receiver: TuiCanvas;
  X: integer;
  Y: integer;
  Width: integer;
  Role: StyleRole.TuiStyleRole
);
begin
  const Cell: Cell2.TuiCell := Cell2.TuiCellCreate('─', Role);
  for Offset: integer := 0 to Width - 1 do
    begin
      TuiCanvasPutCell(Receiver, Point.TuiPointCreate(X + Offset, Y), Cell);
    end;
  end for;
end procedure;

// Draws a vertical box-drawing line.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `X`: Zero-based horizontal terminal-cell coordinate.
// - `Y`: Zero-based vertical terminal-cell coordinate.
// - `Height`: Height in terminal cells.
// - `Role`: Semantic style role used by the operation.
public procedure TuiCanvasDrawVerticalLine(
  Receiver: TuiCanvas;
  X: integer;
  Y: integer;
  Height: integer;
  Role: StyleRole.TuiStyleRole
);
begin
  const Cell: Cell2.TuiCell := Cell2.TuiCellCreate('│', Role);
  for Offset: integer := 0 to Height - 1 do
    begin
      TuiCanvasPutCell(Receiver, Point.TuiPointCreate(X, Y + Offset), Cell);
    end;
  end for;
end procedure;

// Draws a box frame using Unicode box-drawing glyphs.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Bounds`: Rectangle affected by the operation.
// - `Role`: Semantic style role used by the operation.
public procedure TuiCanvasDrawFrame(
  Receiver: TuiCanvas;
  Bounds: Rect.TuiRect;
  Role: StyleRole.TuiStyleRole
);
begin
  if Rect.TuiRectIsEmpty(Bounds) then
    begin
      return;
    end;
  end if;

  if Bounds.Width = 1 then
    begin
      TuiCanvasDrawVerticalLine(Receiver, Bounds.X, Bounds.Y, Bounds.Height, Role);
      TuiCanvasPutCell(Receiver, Point.TuiPointCreate(Bounds.X, Bounds.Y), Cell2.TuiCellCreate('╭', Role));
      if Bounds.Height > 1 then
        begin
          TuiCanvasPutCell(Receiver, Point.TuiPointCreate(Bounds.X, Rect.TuiRectBottom(Bounds) - 1), Cell2.TuiCellCreate('╰', Role));
        end;
      end if;

      return;
    end;
  end if;

  if Bounds.Height = 1 then
    begin
      TuiCanvasDrawHorizontalLine(Receiver, Bounds.X, Bounds.Y, Bounds.Width, Role);
      TuiCanvasPutCell(Receiver, Point.TuiPointCreate(Bounds.X, Bounds.Y), Cell2.TuiCellCreate('╭', Role));
      TuiCanvasPutCell(Receiver, Point.TuiPointCreate(Rect.TuiRectRight(Bounds) - 1, Bounds.Y), Cell2.TuiCellCreate('╮', Role));
      return;
    end;
  end if;

  TuiCanvasDrawHorizontalLine(Receiver, Bounds.X, Bounds.Y, Bounds.Width, Role);
  TuiCanvasDrawHorizontalLine(Receiver, Bounds.X, Rect.TuiRectBottom(Bounds) - 1, Bounds.Width, Role);
  TuiCanvasDrawVerticalLine(Receiver, Bounds.X, Bounds.Y + 1, Bounds.Height - 2, Role);
  TuiCanvasDrawVerticalLine(Receiver, Rect.TuiRectRight(Bounds) - 1, Bounds.Y + 1, Bounds.Height - 2, Role);
  TuiCanvasPutCell(Receiver, Point.TuiPointCreate(Bounds.X, Bounds.Y), Cell2.TuiCellCreate('╭', Role));
  TuiCanvasPutCell(Receiver, Point.TuiPointCreate(Rect.TuiRectRight(Bounds) - 1, Bounds.Y), Cell2.TuiCellCreate('╮', Role));
  TuiCanvasPutCell(Receiver, Point.TuiPointCreate(Bounds.X, Rect.TuiRectBottom(Bounds) - 1), Cell2.TuiCellCreate('╰', Role));
  TuiCanvasPutCell(Receiver, Point.TuiPointCreate(Rect.TuiRectRight(Bounds) - 1, Rect.TuiRectBottom(Bounds) -
                                                                                 1), Cell2.TuiCellCreate('╯', Role));
end procedure;

// Paints consecutive cells in local coordinates with canvas clipping.
public procedure TuiCanvasPutCells(
  Canvas: TuiCanvas;
  Position: Point.TuiPoint;
  Cells: array of (Cell2.TuiCell)
);
begin
  if (Position.Y < Canvas.Clip.Y) or (Position.Y >= Rect.TuiRectBottom(Canvas.Clip)) then
    begin
      return;
    end;
  end if;
  var SourceX: integer := 0;
  var TargetX: integer := Position.X;
  if TargetX < Canvas.Clip.X then
    begin
      SourceX := Canvas.Clip.X - TargetX;
      TargetX := Canvas.Clip.X;
    end;
  end if;
  var Count: integer := Arrays.Length(Cells) - SourceX;
  if Count > Rect.TuiRectRight(Canvas.Clip) - TargetX then
    begin
      Count := Rect.TuiRectRight(Canvas.Clip) - TargetX;
    end;
  end if;

  if Count <= 0 then
    begin
      return;
    end;
  end if;
  var Values: array of (Cell2.TuiCell) := Arrays.Slice(Cells, SourceX, Count);
  if (TargetX + Count = Rect.TuiRectRight(Canvas.Clip)) and (Values[Count - 1].Columns = 2) then
    begin
      Values[Count - 1] := Cell2.TuiCellCreate(' ', StyleRole.TuiStyleRole.Normal);
    end;
  end if;

  Surface2.TuiSurfacePutCells(Canvas.Surface, Point.TuiPointCreate(Canvas.Origin.X + TargetX, Canvas.Origin.Y +
                                                                                              Position.Y), Values);
end procedure;

end unit;
