// Cell-grid painting.
unit Std.Tui.Rendering.CellGrid;

uses
  Std.Tui.Chrome.CellGrid as CellGrid, Std.Tui.Geometry.Point as Point,
  Std.Tui.Geometry.Rect as Rect, Std.Tui.Rendering.Canvas as RenderingCanvas;

// Paints the visible part of a row-major terminal cell grid.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Grid`: Cell grid to paint.
public procedure TuiPaintCellGrid(
  Canvas: RenderingCanvas.TuiCanvas;
  Bounds: Rect.TuiRect;
  Grid: CellGrid.TuiCellGrid
);
begin
  var Width: integer := Grid.Width;
  var Height: integer := Grid.Height;
  if Width > Bounds.Width then
    begin
      Width := Bounds.Width;
    end;
  end if;

  if Height > Bounds.Height then
    begin
      Height := Bounds.Height;
    end;
  end if;

  for Y: integer := 0 to Height - 1 do
    begin
      RenderingCanvas.TuiCanvasPutCells(Canvas, Point.TuiPoint.Create(Bounds.X, Bounds.Y + Y), Grid.Cells.Slice(Y *
                                                                                                                Grid.Width, Width));
    end;
  end for;
end procedure;
end unit;
