// Cell-grid painting.
unit Std.Tui.Rendering.CellGrid;

uses Std.Arrays as Arrays;
uses Std.Tui.Chrome.CellGrid as CellGrid;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Rendering.Canvas as Canvas2;

// Paints the visible part of a row-major terminal cell grid.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Grid`: Cell grid to paint.
public procedure TuiPaintCellGrid(
  Canvas: Canvas2.TuiCanvas;
  Bounds: Rect.TuiRect;
  Grid: CellGrid.TuiCellGrid
);
begin
  var Width: integer := Grid.Width;
  var Height: integer := Grid.Height;
  if Width > Bounds.Width then
    begin
      Width := Bounds.Width;
    end;
  end if;

  if Height > Bounds.Height then
    begin
      Height := Bounds.Height;
    end;
  end if;

  for Y: integer := 0 to Height - 1 do
    begin
      Canvas2.TuiCanvasPutCells(Canvas, Point.TuiPointCreate(Bounds.X, Bounds.Y + Y), Arrays.Slice(Grid.Cells, Y *
                                                                                                               Grid.Width, Width));
    end;
  end for;
end procedure;

end unit;
