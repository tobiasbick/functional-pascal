// Flat panel and overlay chrome painting.
unit Std.Tui.Rendering.Chrome;

uses Std.Tui.Cells.Cell as Cell;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Rendering.Canvas as Canvas2;

// Paints an opaque panel with a thin rounded frame and left-aligned title.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Title`: Title displayed by the panel.
public procedure TuiPaintPanel(Canvas: Canvas2.TuiCanvas; Bounds: Rect.TuiRect; Title: string);
begin
  if Rect.TuiRectIsEmpty(Bounds) then
    begin
      return;
    end;
  end if;

  Canvas2.TuiCanvasFillRect(Canvas, Bounds, Cell.TuiCellCreate(' ', StyleRole.TuiStyleRole.Normal));
  Canvas2.TuiCanvasDrawFrame(Canvas, Bounds, StyleRole.TuiStyleRole.Frame);
  if (Title <> '') and (Bounds.Width > 6) then
    begin
      Canvas2.TuiCanvasWriteText(Canvas2.TuiCanvasChild(Canvas, Rect.TuiRectCreate(Bounds.X + 2, Bounds.Y, Bounds.Width -
                                                                                                           4, 1)), Point.TuiPointCreate(0, 0), (' ' + Title) +
                                                                                                                                               ' ', StyleRole.TuiStyleRole.Title);
    end;
  end if;
end procedure;

end unit;
