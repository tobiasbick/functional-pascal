// Flat panel and overlay chrome painting.
unit Std.Tui.Rendering.Chrome;

uses
  Std.Tui.Cells.Cell, Std.Tui.Cells.StyleRole, Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect,
  Std.Tui.Rendering.Canvas;

// Paints an opaque panel with a thin rounded frame and left-aligned title.
public procedure TuiPaintPanel(Canvas: TuiCanvas; Bounds: TuiRect; Title: string);
begin
  if Bounds.IsEmpty() then
  begin
    return
  end;

  Canvas.FillRect(Bounds, TuiCell.Create(' ', TuiStyleRole.Normal));
  Canvas.DrawFrame(Bounds, TuiStyleRole.Frame);
  if (Title <> '') and (Bounds.Width > 6) then
  begin
    Canvas.Child(TuiRect.Create(Bounds.X + 2, Bounds.Y, Bounds.Width - 4, 1))
      .WriteText(TuiPoint.Create(0, 0), (' ' + Title) + ' ', TuiStyleRole.Title)
  end
end;
