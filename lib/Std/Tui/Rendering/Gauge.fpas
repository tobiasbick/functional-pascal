// Compact dashboard-gauge painting.
unit Std.Tui.Rendering.Gauge;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Tui.Cells.Cell as Cell;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Chrome.Gauge as Gauge2;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Rendering.Canvas as Canvas2;

// Paints a label, bounded bar, and percentage on one row.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Gauge`: Gauge specification to paint.
public procedure TuiPaintGauge(Canvas: Canvas2.TuiCanvas; Bounds: Rect.TuiRect; Gauge: Gauge2.TuiGauge);
begin
  if Bounds.IsEmpty() then
    begin
      return;
    end;
  end if;
  var LabelWidth: integer := Console.DisplayWidth(Gauge.LabelText);
  var Percent: integer := (Gauge.Value * 100) div Gauge.Maximum;
  var PercentText: string := Conv.IntToStr(Percent) + '%';
  var PercentWidth: integer := Console.DisplayWidth(PercentText);
  mutable var BarWidth: integer := ((Bounds.Width - LabelWidth) - PercentWidth) - 4;
  if BarWidth < 1 then
    begin
      BarWidth := 1;
    end;
  end if;
  var BarX: integer := (Bounds.X + LabelWidth) + 2;
  var FillWidth: integer := (BarWidth * Gauge.Value) div Gauge.Maximum;
  Canvas.FillRect(Bounds, Cell.TuiCell.Create(' ', StyleRole.TuiStyleRole.Normal));
  Canvas.WriteText(Point.TuiPoint.Create(Bounds.X, Bounds.Y), Gauge.LabelText, StyleRole.TuiStyleRole.Normal);
  Canvas.DrawHorizontalLine(BarX, Bounds.Y, BarWidth, StyleRole.TuiStyleRole.GaugeTrack);
  Canvas.DrawHorizontalLine(BarX, Bounds.Y, FillWidth, StyleRole.TuiStyleRole.GaugeFill);
  Canvas.WriteText(Point.TuiPoint.Create(Bounds.Right() - PercentWidth, Bounds.Y), PercentText, StyleRole.TuiStyleRole.Accent);
end procedure;

end unit;
