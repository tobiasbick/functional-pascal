// Compact dashboard-gauge painting.
unit Std.Tui.Rendering.Gauge;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Tui.Cells.Cell as Cell;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Chrome.Gauge as Gauge2;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Rendering.Canvas as Canvas2;

// Paints a label, bounded bar, and percentage on one row.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Gauge`: Gauge specification to paint.
public procedure TuiPaintGauge(Canvas: Canvas2.TuiCanvas; Bounds: Rect.TuiRect; Gauge: Gauge2.TuiGauge);
begin
  if Rect.TuiRectIsEmpty(Bounds) then
    begin
      return;
    end;
  end if;
  const LabelWidth: integer := Console.DisplayWidth(Gauge.LabelText);
  const Percent: integer := (Gauge.Value * 100) div Gauge.Maximum;
  const PercentText: string := Conv.IntToStr(Percent) + '%';
  const PercentWidth: integer := Console.DisplayWidth(PercentText);
  var BarWidth: integer := ((Bounds.Width - LabelWidth) - PercentWidth) - 4;
  if BarWidth < 1 then
    begin
      BarWidth := 1;
    end;
  end if;
  const BarX: integer := (Bounds.X + LabelWidth) + 2;
  const FillWidth: integer := (BarWidth * Gauge.Value) div Gauge.Maximum;
  Canvas2.TuiCanvasFillRect(Canvas, Bounds, Cell.TuiCellCreate(' ', StyleRole.TuiStyleRole.Normal));
  Canvas2.TuiCanvasWriteText(Canvas, Point.TuiPointCreate(Bounds.X, Bounds.Y), Gauge.LabelText, StyleRole.TuiStyleRole.Normal);
  Canvas2.TuiCanvasDrawHorizontalLine(Canvas, BarX, Bounds.Y, BarWidth, StyleRole.TuiStyleRole.GaugeTrack);
  Canvas2.TuiCanvasDrawHorizontalLine(Canvas, BarX, Bounds.Y, FillWidth, StyleRole.TuiStyleRole.GaugeFill);
  Canvas2.TuiCanvasWriteText(Canvas, Point.TuiPointCreate(Rect.TuiRectRight(Bounds) - PercentWidth, Bounds.Y), PercentText, StyleRole.TuiStyleRole.Accent);
end procedure;

end unit;
