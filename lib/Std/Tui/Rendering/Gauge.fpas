// Compact dashboard-gauge painting.
unit Std.Tui.Rendering.Gauge;

uses
  Std.Console as Console, Std.Conv as Conv, Std.Tui.Cells.Cell as Cell,
  Std.Tui.Cells.StyleRole as StyleRole, Std.Tui.Chrome.Gauge as ChromeGauge,
  Std.Tui.Geometry.Point as Point, Std.Tui.Geometry.Rect as Rect,
  Std.Tui.Rendering.Canvas as RenderingCanvas;

// Paints a label, bounded bar, and percentage on one row.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Gauge`: Gauge specification to paint.
public procedure TuiPaintGauge(
  Canvas: RenderingCanvas.TuiCanvas;
  Bounds: Rect.TuiRect;
  Gauge: ChromeGauge.TuiGauge
);
begin
  if Bounds.IsEmpty() then
    begin
      return;
    end;
  end if;
  const LabelWidth: integer := Console.DisplayWidth(Gauge.LabelText);
  const Percent: integer := Gauge.Value * 100 div Gauge.Maximum;
  const PercentText: string := Conv.IntToStr(Percent) + '%';
  const PercentWidth: integer := Console.DisplayWidth(PercentText);
  var BarWidth: integer := Bounds.Width - LabelWidth - PercentWidth - 4;
  if BarWidth < 1 then
    begin
      BarWidth := 1;
    end;
  end if;
  const BarX: integer := Bounds.X + LabelWidth + 2;
  const FillWidth: integer := BarWidth * Gauge.Value div Gauge.Maximum;
  Canvas.FillRect(Bounds, Cell.TuiCell.Create(' ', StyleRole.TuiStyleRole.Normal));
  Canvas.WriteText(
    Point.TuiPoint.Create(Bounds.X, Bounds.Y),
    Gauge.LabelText,
    StyleRole.TuiStyleRole.Normal
  );
  Canvas.DrawHorizontalLine(BarX, Bounds.Y, BarWidth, StyleRole.TuiStyleRole.GaugeTrack);
  Canvas.DrawHorizontalLine(BarX, Bounds.Y, FillWidth, StyleRole.TuiStyleRole.GaugeFill);
  Canvas.WriteText(
    Point.TuiPoint.Create(Bounds.Right() - PercentWidth, Bounds.Y),
    PercentText,
    StyleRole.TuiStyleRole.Accent
  );
end procedure;
end unit;
