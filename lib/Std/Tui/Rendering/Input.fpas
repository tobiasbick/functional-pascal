// One-line input painting.
unit Std.Tui.Rendering.Input;

uses
  Std.Tui.Cells.Cell, Std.Tui.Cells.StyleRole, Std.Tui.Chrome.Input, Std.Tui.Geometry.Point,
  Std.Tui.Geometry.Rect, Std.Tui.Rendering.Canvas, Std.Tui.Text.Input;

// Paints one input with hint text, horizontal scroll markers, and a block cursor.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Input`: Controlled input specification.
// - `Focused`: Whether the control currently owns focus.
public procedure TuiPaintInput(Canvas: TuiCanvas; Bounds: TuiRect; Input: TuiInputSpec; Focused: boolean);
begin
  if Bounds.IsEmpty() then
    begin
      return;
    end;
  end if;
  var Role: TuiStyleRole := TuiStyleRole.InputNormal;
  if Focused then
    begin
      Role := TuiStyleRole.InputFocused;
    end;
  end if;

  Canvas.FillRect(Bounds, TuiCell.Create(' ', Role));
  if Bounds.Width <= 2 then
    begin
      if Focused then
        begin
          Canvas.WriteText(TuiPoint.Create(Bounds.X, Bounds.Y), ' ', TuiStyleRole.InputCursor);
        end;
      end if;

      return;
    end;
  end if;
  const ContentWidth: integer := Bounds.Width - 2;
  const Viewport: TuiInputViewport := TuiInputViewportFor(Input.Text, Input.Caret, ContentWidth);
  if Input.Text = '' then
    begin
      var HintX: integer := Bounds.X + 1;
      var HintWidth: integer := ContentWidth;
      if Focused and (HintWidth > 1) then
        begin
          HintX := HintX + 1;
          HintWidth := HintWidth - 1;
        end;
      end if;

      Canvas.Child(TuiRect.Create(HintX, Bounds.Y, HintWidth, 1))
        .WriteText(TuiPoint.Create(0, 0), Input.Hint, TuiStyleRole.InputHint);
    end;
  else
    begin
      Canvas.Child(TuiRect.Create(Bounds.X + 1, Bounds.Y, ContentWidth, 1))
        .WriteText(TuiPoint.Create(0, 0), Input.Text.Slice(Viewport.Start, Viewport.EndIndex -
                                                                           Viewport.Start), Role);
    end;
  end if;

  if Viewport.LeftClipped then
    begin
      Canvas.WriteText(TuiPoint.Create(Bounds.X, Bounds.Y), '◄', TuiStyleRole.InputScroll);
    end;
  end if;

  if Viewport.RightClipped then
    begin
      Canvas.WriteText(TuiPoint.Create(Bounds.Right() - 1, Bounds.Y), '►', TuiStyleRole.InputScroll);
    end;
  end if;

  if Focused then
    begin
      var CursorX: integer := (Bounds.X + 1) + Viewport.CaretColumn;
      if CursorX >= Bounds.Right() - 1 then
        begin
          CursorX := Bounds.Right() - 2;
        end;
      end if;
      var CursorGlyph: string := ' ';
      if Input.Caret < Input.Text.Length() then
        begin
          CursorGlyph := Input.Text.CharAt(Input.Caret);
        end;
      end if;

      Canvas.WriteText(TuiPoint.Create(CursorX, Bounds.Y), CursorGlyph, TuiStyleRole.InputCursor);
    end;
  end if;
end procedure;
end unit;
