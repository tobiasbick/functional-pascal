// One-line input painting.
unit Std.Tui.Rendering.Input;

uses Std.Str as Str;
uses Std.Tui.Cells.Cell as Cell;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Chrome.Input as Input2;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Rendering.Canvas as Canvas2;
uses Std.Tui.Text.Input as Input3;

// Paints one input with hint text, horizontal scroll markers, and a block cursor.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Input`: Controlled input specification.
// - `Focused`: Whether the control currently owns focus.
public procedure TuiPaintInput(
  Canvas: Canvas2.TuiCanvas;
  Bounds: Rect.TuiRect;
  Input: Input2.TuiInputSpec;
  Focused: boolean
);
begin
  if Rect.TuiRectIsEmpty(Bounds) then
    begin
      return;
    end;
  end if;
  var Role: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.InputNormal;
  if Focused then
    begin
      Role := StyleRole.TuiStyleRole.InputFocused;
    end;
  end if;

  Canvas2.TuiCanvasFillRect(Canvas, Bounds, Cell.TuiCellCreate(' ', Role));
  if Bounds.Width <= 2 then
    begin
      if Focused then
        begin
          Canvas2.TuiCanvasWriteText(Canvas, Point.TuiPointCreate(Bounds.X, Bounds.Y), ' ', StyleRole.TuiStyleRole.InputCursor);
        end;
      end if;

      return;
    end;
  end if;
  const ContentWidth: integer := Bounds.Width - 2;
  const Viewport: Input3.TuiInputViewport := Input3.TuiInputViewportFor(Input.Text, Input.Caret, ContentWidth);
  if Input.Text = '' then
    begin
      var HintX: integer := Bounds.X + 1;
      var HintWidth: integer := ContentWidth;
      if Focused and (HintWidth > 1) then
        begin
          HintX := HintX + 1;
          HintWidth := HintWidth - 1;
        end;
      end if;

      Canvas2.TuiCanvasWriteText(Canvas2.TuiCanvasChild(Canvas, Rect.TuiRectCreate(HintX, Bounds.Y, HintWidth, 1)), Point.TuiPointCreate(0, 0), Input.Hint, StyleRole.TuiStyleRole.InputHint);
    end;
  else
    begin
      Canvas2.TuiCanvasWriteText(Canvas2.TuiCanvasChild(Canvas, Rect.TuiRectCreate(Bounds.X + 1, Bounds.Y, ContentWidth, 1)), Point.TuiPointCreate(0, 0), Str.Substring(Input.Text, Viewport.Start, Viewport.EndIndex -
                                                                                                                                                                                                    Viewport.Start), Role);
    end;
  end if;

  if Viewport.LeftClipped then
    begin
      Canvas2.TuiCanvasWriteText(Canvas, Point.TuiPointCreate(Bounds.X, Bounds.Y), '◄', StyleRole.TuiStyleRole.InputScroll);
    end;
  end if;

  if Viewport.RightClipped then
    begin
      Canvas2.TuiCanvasWriteText(Canvas, Point.TuiPointCreate(Rect.TuiRectRight(Bounds) - 1, Bounds.Y), '►', StyleRole.TuiStyleRole.InputScroll);
    end;
  end if;

  if Focused then
    begin
      var CursorX: integer := (Bounds.X + 1) + Viewport.CaretColumn;
      if CursorX >= Rect.TuiRectRight(Bounds) - 1 then
        begin
          CursorX := Rect.TuiRectRight(Bounds) - 2;
        end;
      end if;
      var CursorGlyph: string := ' ';
      if Input.Caret < Str.Length(Input.Text) then
        begin
          CursorGlyph := Str.CharAt(Input.Text, Input.Caret);
        end;
      end if;

      Canvas2.TuiCanvasWriteText(Canvas, Point.TuiPointCreate(CursorX, Bounds.Y), CursorGlyph, StyleRole.TuiStyleRole.InputCursor);
    end;
  end if;
end procedure;

end unit;
