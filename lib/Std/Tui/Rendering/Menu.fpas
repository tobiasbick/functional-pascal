unit Std.Tui.Rendering.Menu;

uses
  Std.Console as Console, Std.Tui.Cells.Cell as Cell, Std.Tui.Cells.StyleRole as StyleRole,
  Std.Tui.Chrome.MenuGeometry as MenuGeometry, Std.Tui.Chrome.MenuNode as MenuNode,
  Std.Tui.Chrome.MenuQuery as MenuQuery, Std.Tui.Geometry.Point as Point,
  Std.Tui.Geometry.Rect as Rect, Std.Tui.Rendering.Canvas as RenderingCanvas;

function TuiMenuIdMatches(Value: option of MenuNode.TuiMenuNodeId; Id: MenuNode.TuiMenuNodeId): boolean;
begin
  case Value of
    when Some(const Current):
      begin
        return Current.Value = Id.Value;
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;

procedure TuiPaintMenuLabel(
  Canvas: RenderingCanvas.TuiCanvas;
  Position: Point.TuiPoint;
  Text: string;
  Mnemonic: string;
  Role: StyleRole.TuiStyleRole;
  MnemonicRole: StyleRole.TuiStyleRole
);
begin
  var X: integer := Position.X;
  var MnemonicPainted: boolean := false;
  for Index: integer := 0 to Text.Length() - 1 do
    begin
      const Glyph: string := Text.CharAt(Index);
      var GlyphRole: StyleRole.TuiStyleRole := Role;
      if (not MnemonicPainted and (Mnemonic <> '')) and (Glyph.ToLower() = Mnemonic.ToLower()) then
        begin
          GlyphRole := MnemonicRole;
          MnemonicPainted := true;
        end;
      end if;

      Canvas.WriteText(Point.TuiPoint.Create(X, Position.Y), Glyph, GlyphRole);
      X := X + Console.DisplayWidth(Glyph);
    end;
  end for;
end procedure;

// Paints the one-line root menu bar.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Nodes`: Flat ordered menu-node collection.
// - `State`: Controlled state used by the operation.
// - `Focused`: Whether the control currently owns focus.
public procedure TuiPaintMenuBar(
  Canvas: RenderingCanvas.TuiCanvas;
  Bounds: Rect.TuiRect;
  Nodes: array of MenuNode.TuiMenuNode;
  State: MenuNode.TuiMenuState;
  Focused: boolean
);
begin
  Canvas.FillRect(Bounds, Cell.TuiCell.Create(' ', StyleRole.TuiStyleRole.MenuNormal));
  var ActiveRoot: option of MenuNode.TuiMenuNodeId := None;
  case State.Active of
    when Some(const Active):
      begin
        ActiveRoot := MenuQuery.TuiMenuRootOf(Nodes, Active);
      end;
    when None:
      begin
      end;
  end case;
  var X: integer := Bounds.X;
  for Index: integer := 0 to Nodes.Length() - 1 do
    begin
      case MenuQuery.TuiMenuNodeParent(Nodes[Index]) of
        when Some(const Parent):
          begin
          end;
        when None:
          begin
            const Id: MenuNode.TuiMenuNodeId := MenuQuery.TuiMenuNodeIdOf(Nodes[Index]);
            const Text: string := MenuQuery.TuiMenuNodeText(Nodes[Index]);
            const Width: integer := Console.DisplayWidth(Text) + 2;
            var Role: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.MenuNormal;
            if (State.Open and TuiMenuIdMatches(ActiveRoot, Id)) or
               ((Focused and not State.Open) and (X = Bounds.X)) then
              begin
                Role := StyleRole.TuiStyleRole.MenuSelected;
                Canvas.FillRect(Rect.TuiRect.Create(X, Bounds.Y, Width, 1), Cell.TuiCell.Create(' ', Role));
              end;
            end if;

            if not MenuQuery.TuiMenuNodeSelectable(Nodes[Index]) then
              begin
                Role := StyleRole.TuiStyleRole.MenuDisabled;
              end;
            end if;
            var MnemonicRole: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.MenuShortcut;
            if Role = StyleRole.TuiStyleRole.MenuSelected then
              begin
                MnemonicRole := StyleRole.TuiStyleRole.MenuSelectedShortcut;
              end;
            elsif Role = StyleRole.TuiStyleRole.MenuDisabled then
              begin
                MnemonicRole := StyleRole.TuiStyleRole.MenuDisabled;
              end;
            end if;

            TuiPaintMenuLabel(Canvas, Point.TuiPoint.Create(X + 1, Bounds.Y), Text, MenuQuery.TuiMenuNodeMnemonic(Nodes[Index]), Role, MnemonicRole);
            X := X + Width;
          end;
      end case;
    end;
  end for;
end procedure;

procedure TuiPaintMenuPopupEntry(
  Canvas: RenderingCanvas.TuiCanvas;
  Bounds: Rect.TuiRect;
  Y: integer;
  Node: MenuNode.TuiMenuNode;
  Id: MenuNode.TuiMenuNodeId;
  Text: string;
  Mnemonic: string;
  Enabled: boolean;
  State: MenuNode.TuiMenuState
);
begin
  var Role: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.MenuNormal;
  if TuiMenuIdMatches(State.Active, Id) then
    begin
      Role := StyleRole.TuiStyleRole.MenuSelected;
      Canvas.FillRect(Rect.TuiRect.Create(Bounds.X + 1, Y, Bounds.Width - 2, 1), Cell.TuiCell.Create(' ', Role));
    end;
  end if;

  if not Enabled then
    begin
      Role := StyleRole.TuiStyleRole.MenuDisabled;
    end;
  end if;
  var MnemonicRole: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.MenuShortcut;
  if Role = StyleRole.TuiStyleRole.MenuSelected then
    begin
      MnemonicRole := StyleRole.TuiStyleRole.MenuSelectedShortcut;
    end;
  elsif Role = StyleRole.TuiStyleRole.MenuDisabled then
    begin
      MnemonicRole := StyleRole.TuiStyleRole.MenuDisabled;
    end;
  end if;

  TuiPaintMenuLabel(Canvas, Point.TuiPoint.Create(Bounds.X + 2, Y), Text, Mnemonic, Role, MnemonicRole);
  case MenuQuery.TuiMenuNodeShortcut(Node) of
    when Some(const Gesture):
      begin
        Canvas.WriteText(Point.TuiPoint.Create(Bounds.Right() - 2 -
                                               Console.DisplayWidth(Gesture.Display), Y), Gesture.Display, Role);
      end;
    when None:
      begin
      end;
  end case;

  if MenuQuery.TuiMenuNodeIsSubmenu(Node) then
    begin
      Canvas.WriteText(Point.TuiPoint.Create(Bounds.Right() - 2, Y), '▶', Role);
    end;
  end if;
end procedure;

procedure TuiPaintMenuPopup(
  Canvas: RenderingCanvas.TuiCanvas;
  Popup: MenuGeometry.TuiMenuPopup;
  Nodes: array of MenuNode.TuiMenuNode;
  State: MenuNode.TuiMenuState
);
begin
  const Bounds: Rect.TuiRect := Popup.Bounds;
  Canvas.FillRect(Bounds, Cell.TuiCell.Create(' ', StyleRole.TuiStyleRole.MenuNormal));
  Canvas.DrawFrame(Bounds, StyleRole.TuiStyleRole.MenuNormal);
  var Row: integer := 0;
  for Index: integer := 0 to Nodes.Length() - 1 do
    begin
      if MenuQuery.TuiMenuHasParent(Nodes[Index], Some(Popup.Parent)) then
        begin
          const Y: integer := Bounds.Y + 1 + Row;
          case Nodes[Index] of
            when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
              begin
                Canvas.DrawHorizontalLine(Bounds.X + 1, Y, Bounds.Width - 2, StyleRole.TuiStyleRole.MenuNormal);
              end;
            when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
              begin
                TuiPaintMenuPopupEntry(Canvas, Bounds, Y, Nodes[Index], Id, Text, Mnemonic, Enabled, State);
              end;
            when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
              begin
                TuiPaintMenuPopupEntry(Canvas, Bounds, Y, Nodes[Index], Id, Text, Mnemonic, Enabled, State);
              end;
          end case;

          Row := Row + 1;
        end;
      end if;
    end;
  end for;
end procedure;

// Paints all open menu popups over the completed desktop frame.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `BarBounds`: Arranged bounds of the menu bar.
// - `Nodes`: Flat ordered menu-node collection.
// - `State`: Controlled state used by the operation.
public procedure TuiPaintMenuPopups(
  Canvas: RenderingCanvas.TuiCanvas;
  BarBounds: Rect.TuiRect;
  Nodes: array of MenuNode.TuiMenuNode;
  State: MenuNode.TuiMenuState
);
begin
  const TerminalBounds: Rect.TuiRect := Rect.TuiRect.Create(0, 0, Canvas.Surface.Size().Width, Canvas.Surface.Size()
                                                                                                 .Height);
  const Popups: array of MenuGeometry.TuiMenuPopup := MenuGeometry.TuiMenuPopupGeometry(Nodes, State, BarBounds, TerminalBounds);
  for Index: integer := 0 to Popups.Length() - 1 do
    begin
      TuiPaintMenuPopup(Canvas, Popups[Index], Nodes, State);
    end;
  end for;
end procedure;
end unit;
