unit Std.Tui.Rendering.Menu;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Tui.Cells.Cell as Cell;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Chrome.MenuGeometry as MenuGeometry;
uses Std.Tui.Chrome.MenuNode as MenuNode;
uses Std.Tui.Chrome.MenuQuery as MenuQuery;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Rendering.Canvas as Canvas2;
uses Std.Tui.Rendering.Surface as Surface2;

function TuiMenuIdMatches(Value: Option of (MenuNode.TuiMenuNodeId); Id: MenuNode.TuiMenuNodeId): boolean;
begin
  case Value of
    when Option.Some(const Current):
      begin
        return Current.Value = Id.Value;
      end;
    when Option.None:
      begin
        return false;
      end;
  end case;
end function;

procedure TuiPaintMenuLabel(
  Canvas: Canvas2.TuiCanvas;
  Position: Point.TuiPoint;
  Text: string;
  Mnemonic: string;
  Role: StyleRole.TuiStyleRole;
  MnemonicRole: StyleRole.TuiStyleRole
);
begin
  var X: integer := Position.X;
  var MnemonicPainted: boolean := false;
  for Index: integer := 0 to Str.Length(Text) - 1 do
    begin
      const Glyph: string := Str.CharAt(Text, Index);
      var GlyphRole: StyleRole.TuiStyleRole := Role;
      if (not MnemonicPainted and (Mnemonic <> '')) and (Str.ToLower(Glyph) = Str.ToLower(Mnemonic)) then
        begin
          GlyphRole := MnemonicRole;
          MnemonicPainted := true;
        end;
      end if;

      Canvas2.TuiCanvasWriteText(Canvas, Point.TuiPointCreate(X, Position.Y), Glyph, GlyphRole);
      X := X + Console.DisplayWidth(Glyph);
    end;
  end for;
end procedure;

// Paints the one-line root menu bar.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Nodes`: Flat ordered menu-node collection.
// - `State`: Controlled state used by the operation.
// - `Focused`: Whether the control currently owns focus.
public procedure TuiPaintMenuBar(
  Canvas: Canvas2.TuiCanvas;
  Bounds: Rect.TuiRect;
  Nodes: array of (MenuNode.TuiMenuNode);
  State: MenuNode.TuiMenuState;
  Focused: boolean
);
begin
  Canvas2.TuiCanvasFillRect(Canvas, Bounds, Cell.TuiCellCreate(' ', StyleRole.TuiStyleRole.MenuNormal));
  var ActiveRoot: Option of (MenuNode.TuiMenuNodeId) := Option.None;
  case State.Active of
    when Option.Some(const Active):
      begin
        ActiveRoot := MenuQuery.TuiMenuRootOf(Nodes, Active);
      end;
    when Option.None:
      begin
        null;
      end;
  end case;
  var X: integer := Bounds.X;
  for Index: integer := 0 to Arrays.Length(Nodes) - 1 do
    begin
      case MenuQuery.TuiMenuNodeParent(Nodes[Index]) of
        when Option.Some(const Parent):
          begin
            null;
          end;
        when Option.None:
          begin
            const Id: MenuNode.TuiMenuNodeId := MenuQuery.TuiMenuNodeIdOf(Nodes[Index]);
            const Text: string := MenuQuery.TuiMenuNodeText(Nodes[Index]);
            const Width: integer := Console.DisplayWidth(Text) + 2;
            var Role: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.MenuNormal;
            if (State.Open and TuiMenuIdMatches(ActiveRoot, Id)) or
               ((Focused and not State.Open) and (X = Bounds.X)) then
              begin
                Role := StyleRole.TuiStyleRole.MenuSelected;
                Canvas2.TuiCanvasFillRect(Canvas, Rect.TuiRectCreate(X, Bounds.Y, Width, 1), Cell.TuiCellCreate(' ', Role));
              end;
            end if;

            if not MenuQuery.TuiMenuNodeSelectable(Nodes[Index]) then
              begin
                Role := StyleRole.TuiStyleRole.MenuDisabled;
              end;
            end if;
            var MnemonicRole: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.MenuShortcut;
            if Role = StyleRole.TuiStyleRole.MenuSelected then
              begin
                MnemonicRole := StyleRole.TuiStyleRole.MenuSelectedShortcut;
              end;
            else
              if Role = StyleRole.TuiStyleRole.MenuDisabled then
                begin
                  MnemonicRole := StyleRole.TuiStyleRole.MenuDisabled;
                end;
              end if;
            end if;

            TuiPaintMenuLabel(Canvas, Point.TuiPointCreate(X + 1, Bounds.Y), Text, MenuQuery.TuiMenuNodeMnemonic(Nodes[Index]), Role, MnemonicRole);
            X := X + Width;
          end;
      end case;
    end;
  end for;
end procedure;

procedure TuiPaintMenuPopupEntry(
  Canvas: Canvas2.TuiCanvas;
  Bounds: Rect.TuiRect;
  Y: integer;
  Node: MenuNode.TuiMenuNode;
  Id: MenuNode.TuiMenuNodeId;
  Text: string;
  Mnemonic: string;
  Enabled: boolean;
  State: MenuNode.TuiMenuState
);
begin
  var Role: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.MenuNormal;
  if TuiMenuIdMatches(State.Active, Id) then
    begin
      Role := StyleRole.TuiStyleRole.MenuSelected;
      Canvas2.TuiCanvasFillRect(Canvas, Rect.TuiRectCreate(Bounds.X + 1, Y, Bounds.Width - 2, 1), Cell.TuiCellCreate(' ', Role));
    end;
  end if;

  if not Enabled then
    begin
      Role := StyleRole.TuiStyleRole.MenuDisabled;
    end;
  end if;
  var MnemonicRole: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.MenuShortcut;
  if Role = StyleRole.TuiStyleRole.MenuSelected then
    begin
      MnemonicRole := StyleRole.TuiStyleRole.MenuSelectedShortcut;
    end;
  else
    if Role = StyleRole.TuiStyleRole.MenuDisabled then
      begin
        MnemonicRole := StyleRole.TuiStyleRole.MenuDisabled;
      end;
    end if;
  end if;

  TuiPaintMenuLabel(Canvas, Point.TuiPointCreate(Bounds.X + 2, Y), Text, Mnemonic, Role, MnemonicRole);
  case MenuQuery.TuiMenuNodeShortcut(Node) of
    when Option.Some(const Gesture):
      begin
        Canvas2.TuiCanvasWriteText(Canvas, Point.TuiPointCreate((Rect.TuiRectRight(Bounds) - 2) -
                                                                Console.DisplayWidth(Gesture.Display), Y), Gesture.Display, Role);
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  if MenuQuery.TuiMenuNodeIsSubmenu(Node) then
    begin
      Canvas2.TuiCanvasWriteText(Canvas, Point.TuiPointCreate(Rect.TuiRectRight(Bounds) - 2, Y), '▶', Role);
    end;
  end if;
end procedure;

procedure TuiPaintMenuPopup(
  Canvas: Canvas2.TuiCanvas;
  Popup: MenuGeometry.TuiMenuPopup;
  Nodes: array of (MenuNode.TuiMenuNode);
  State: MenuNode.TuiMenuState
);
begin
  const Bounds: Rect.TuiRect := Popup.Bounds;
  Canvas2.TuiCanvasFillRect(Canvas, Bounds, Cell.TuiCellCreate(' ', StyleRole.TuiStyleRole.MenuNormal));
  Canvas2.TuiCanvasDrawFrame(Canvas, Bounds, StyleRole.TuiStyleRole.MenuNormal);
  var Row: integer := 0;
  for Index: integer := 0 to Arrays.Length(Nodes) - 1 do
    begin
      if MenuQuery.TuiMenuHasParent(Nodes[Index], Option.Some(Popup.Parent)) then
        begin
          const Y: integer := (Bounds.Y + 1) + Row;
          case Nodes[Index] of
            when MenuNode.TuiMenuNode.Separator(const Id, const Parent):
              begin
                Canvas2.TuiCanvasDrawHorizontalLine(Canvas, Bounds.X + 1, Y, Bounds.Width - 2, StyleRole.TuiStyleRole.MenuNormal);
              end;
            when MenuNode.TuiMenuNode.Command(const Id, const Parent, const Text, const Mnemonic, const Action, const Enabled, const Shortcut):
              begin
                TuiPaintMenuPopupEntry(Canvas, Bounds, Y, Nodes[Index], Id, Text, Mnemonic, Enabled, State);
              end;
            when MenuNode.TuiMenuNode.Submenu(const Id, const Parent, const Text, const Mnemonic, const Enabled):
              begin
                TuiPaintMenuPopupEntry(Canvas, Bounds, Y, Nodes[Index], Id, Text, Mnemonic, Enabled, State);
              end;
          end case;

          Row := Row + 1;
        end;
      end if;
    end;
  end for;
end procedure;

// Paints all open menu popups over the completed desktop frame.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `BarBounds`: Arranged bounds of the menu bar.
// - `Nodes`: Flat ordered menu-node collection.
// - `State`: Controlled state used by the operation.
public procedure TuiPaintMenuPopups(
  Canvas: Canvas2.TuiCanvas;
  BarBounds: Rect.TuiRect;
  Nodes: array of (MenuNode.TuiMenuNode);
  State: MenuNode.TuiMenuState
);
begin
  const TerminalBounds: Rect.TuiRect := Rect.TuiRectCreate(0, 0, Surface2.TuiWorkingSurfaceSize(Canvas.Surface)
                                                                   .Width, Surface2.TuiWorkingSurfaceSize(Canvas.Surface)
                                                                             .Height);
  const Popups: array of (MenuGeometry.TuiMenuPopup) := MenuGeometry.TuiMenuPopupGeometry(Nodes, State, BarBounds, TerminalBounds);
  for Index: integer := 0 to Arrays.Length(Popups) - 1 do
    begin
      TuiPaintMenuPopup(Canvas, Popups[Index], Nodes, State);
    end;
  end for;
end procedure;

end unit;
