unit Std.Tui.Rendering.Menu;

uses
  Std.Arrays, Std.Console, Std.Str, Std.Tui.Cells.Cell, Std.Tui.Cells.StyleRole,
  Std.Tui.Chrome.MenuGeometry, Std.Tui.Chrome.MenuNode, Std.Tui.Chrome.MenuQuery,
  Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect, Std.Tui.Rendering.Canvas;

function TuiMenuIdMatches(Value: option of TuiMenuNodeId; Id: TuiMenuNodeId): boolean;
begin
  case Value of
    when Some(Current):
      begin
        return Current.Value = Id.Value;
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;

procedure TuiPaintMenuLabel(
  Canvas: TuiCanvas;
  Position: TuiPoint;
  Text: string;
  Mnemonic: string;
  Role: TuiStyleRole;
  MnemonicRole: TuiStyleRole
);
begin
  var X: integer := Position.X;
  var MnemonicPainted: boolean := false;
  for Index: integer := 0 to Std.Str.Length(Text) - 1 do
    begin
      const Glyph: string := Std.Str.CharAt(Text, Index);
      var GlyphRole: TuiStyleRole := Role;
      if (not MnemonicPainted and (Mnemonic <> '')) and
         (Std.Str.ToLower(Glyph) = Std.Str.ToLower(Mnemonic)) then
        begin
          GlyphRole := MnemonicRole;
          MnemonicPainted := true;
        end;
      end if;

      Canvas.WriteText(TuiPoint.Create(X, Position.Y), Glyph, GlyphRole);
      X := X + Std.Console.DisplayWidth(Glyph);
    end;
  end for;
end procedure;

// Paints the one-line root menu bar.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Nodes`: Flat ordered menu-node collection.
// - `State`: Controlled state used by the operation.
// - `Focused`: Whether the control currently owns focus.
public procedure TuiPaintMenuBar(
  Canvas: TuiCanvas;
  Bounds: TuiRect;
  Nodes: array of TuiMenuNode;
  State: TuiMenuState;
  Focused: boolean
);
begin
  Canvas.FillRect(Bounds, TuiCell.Create(' ', TuiStyleRole.MenuNormal));
  var ActiveRoot: option of TuiMenuNodeId := None;
  case State.Active of
    when Some(Active):
      begin
        ActiveRoot := TuiMenuRootOf(Nodes, Active);
      end;
    when None:
      begin
      end;
  end case;
  var X: integer := Bounds.X;
  for Index: integer := 0 to Std.Arrays.Length(Nodes) - 1 do
    begin
      case TuiMenuNodeParent(Nodes[Index]) of
        when Some(Parent):
          begin
          end;
        when None:
          begin
            const Id: TuiMenuNodeId := TuiMenuNodeIdOf(Nodes[Index]);
            const Text: string := TuiMenuNodeText(Nodes[Index]);
            const Width: integer := Std.Console.DisplayWidth(Text) + 2;
            var Role: TuiStyleRole := TuiStyleRole.MenuNormal;
            if (State.Open and TuiMenuIdMatches(ActiveRoot, Id)) or
               ((Focused and not State.Open) and (X = Bounds.X)) then
              begin
                Role := TuiStyleRole.MenuSelected;
                Canvas.FillRect(TuiRect.Create(X, Bounds.Y, Width, 1), TuiCell.Create(' ', Role));
              end;
            end if;

            if not TuiMenuNodeSelectable(Nodes[Index]) then
              begin
                Role := TuiStyleRole.MenuDisabled;
              end;
            end if;
            var MnemonicRole: TuiStyleRole := TuiStyleRole.MenuShortcut;
            if Role = TuiStyleRole.MenuSelected then
              begin
                MnemonicRole := TuiStyleRole.MenuSelectedShortcut;
              end;
            elsif Role = TuiStyleRole.MenuDisabled then
              begin
                MnemonicRole := TuiStyleRole.MenuDisabled;
              end;
            end if;

            TuiPaintMenuLabel(Canvas, TuiPoint.Create(X + 1, Bounds.Y), Text, TuiMenuNodeMnemonic(Nodes[Index]), Role, MnemonicRole);
            X := X + Width;
          end;
      end case;
    end;
  end for;
end procedure;

procedure TuiPaintMenuPopupEntry(
  Canvas: TuiCanvas;
  Bounds: TuiRect;
  Y: integer;
  Node: TuiMenuNode;
  Id: TuiMenuNodeId;
  Text: string;
  Mnemonic: string;
  Enabled: boolean;
  State: TuiMenuState
);
begin
  var Role: TuiStyleRole := TuiStyleRole.MenuNormal;
  if TuiMenuIdMatches(State.Active, Id) then
    begin
      Role := TuiStyleRole.MenuSelected;
      Canvas.FillRect(TuiRect.Create(Bounds.X + 1, Y, Bounds.Width - 2, 1), TuiCell.Create(' ', Role));
    end;
  end if;

  if not Enabled then
    begin
      Role := TuiStyleRole.MenuDisabled;
    end;
  end if;
  var MnemonicRole: TuiStyleRole := TuiStyleRole.MenuShortcut;
  if Role = TuiStyleRole.MenuSelected then
    begin
      MnemonicRole := TuiStyleRole.MenuSelectedShortcut;
    end;
  elsif Role = TuiStyleRole.MenuDisabled then
    begin
      MnemonicRole := TuiStyleRole.MenuDisabled;
    end;
  end if;

  TuiPaintMenuLabel(Canvas, TuiPoint.Create(Bounds.X + 2, Y), Text, Mnemonic, Role, MnemonicRole);
  case TuiMenuNodeShortcut(Node) of
    when Some(Gesture):
      begin
        Canvas.WriteText(TuiPoint.Create((Bounds.Right() - 2) -
                                         Std.Console.DisplayWidth(Gesture.Display), Y), Gesture.Display, Role);
      end;
    when None:
      begin
      end;
  end case;

  if TuiMenuNodeIsSubmenu(Node) then
    begin
      Canvas.WriteText(TuiPoint.Create(Bounds.Right() - 2, Y), '▶', Role);
    end;
  end if;
end procedure;

procedure TuiPaintMenuPopup(
  Canvas: TuiCanvas;
  Popup: TuiMenuPopup;
  Nodes: array of TuiMenuNode;
  State: TuiMenuState
);
begin
  const Bounds: TuiRect := Popup.Bounds;
  Canvas.FillRect(Bounds, TuiCell.Create(' ', TuiStyleRole.MenuNormal));
  Canvas.DrawFrame(Bounds, TuiStyleRole.MenuNormal);
  var Row: integer := 0;
  for Index: integer := 0 to Std.Arrays.Length(Nodes) - 1 do
    begin
      if TuiMenuHasParent(Nodes[Index], Some(Popup.Parent)) then
        begin
          const Y: integer := (Bounds.Y + 1) + Row;
          case Nodes[Index] of
            when TuiMenuNode.Separator(Id, Parent):
              begin
                Canvas.DrawHorizontalLine(Bounds.X + 1, Y, Bounds.Width - 2, TuiStyleRole.MenuNormal);
              end;
            when TuiMenuNode.Command(Id, Parent, Text, Mnemonic, Action, Enabled, Shortcut):
              begin
                TuiPaintMenuPopupEntry(Canvas, Bounds, Y, Nodes[Index], Id, Text, Mnemonic, Enabled, State);
              end;
            when TuiMenuNode.Submenu(Id, Parent, Text, Mnemonic, Enabled):
              begin
                TuiPaintMenuPopupEntry(Canvas, Bounds, Y, Nodes[Index], Id, Text, Mnemonic, Enabled, State);
              end;
          end case;

          Row := Row + 1;
        end;
      end if;
    end;
  end for;
end procedure;

// Paints all open menu popups over the completed desktop frame.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `BarBounds`: Arranged bounds of the menu bar.
// - `Nodes`: Flat ordered menu-node collection.
// - `State`: Controlled state used by the operation.
public procedure TuiPaintMenuPopups(
  Canvas: TuiCanvas;
  BarBounds: TuiRect;
  Nodes: array of TuiMenuNode;
  State: TuiMenuState
);
begin
  const TerminalBounds: TuiRect := TuiRect.Create(0, 0, Canvas.Surface.Size().Width, Canvas.Surface.Size()
                                                                                       .Height);
  const Popups: array of TuiMenuPopup := TuiMenuPopupGeometry(Nodes, State, BarBounds, TerminalBounds);
  for Index: integer := 0 to Std.Arrays.Length(Popups) - 1 do
    begin
      TuiPaintMenuPopup(Canvas, Popups[Index], Nodes, State);
    end;
  end for;
end procedure;
end unit;
