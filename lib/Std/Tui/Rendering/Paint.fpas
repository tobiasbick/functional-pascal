unit Std.Tui.Rendering.Paint;

uses
  Std.Console, Std.Tui.Cells.Cell, Std.Tui.Cells.StyleRole, Std.Tui.Chrome.StatusItem,
  Std.Tui.Elements.Element, Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect, Std.Tui.Geometry.Size,
  Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame, Std.Tui.Rendering.Button, Std.Tui.Rendering.Canvas,
  Std.Tui.Rendering.CellGrid, Std.Tui.Rendering.Chrome, Std.Tui.Rendering.Gauge,
  Std.Tui.Rendering.Input, Std.Tui.Rendering.Menu, Std.Tui.Rendering.Rule,
  Std.Tui.Rendering.StatusLine, Std.Tui.Rendering.Surface, Std.Tui.Rendering.TextArea;

function TuiPaintFocused(Focused: option of TuiControlId; Id: TuiControlId): boolean;
begin
  case Focused of
    when Some(const Value):
      begin
        return Value.Value = Id.Value;
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;

procedure TuiPaintTextInBounds(Canvas: TuiCanvas; Bounds: TuiRect; Text: string; Role: TuiStyleRole);
begin
  if Bounds.IsEmpty() then
    begin
      return;
    end;
  end if;

  Canvas.Child(Bounds).WriteText(TuiPoint.Create(0, 0), Text, Role);
end procedure;

// Paints one arranged node and returns the next unused frame index.
function TuiPaintArranged(
  Canvas: TuiCanvas;
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  Focused: option of TuiControlId;
  Pressed: option of TuiControlId
): integer;
begin
  const Entry: TuiArrangedEntry := Frame.EntryAt(Index);
  var Next: integer := Index + 1;
  const Clipped: TuiCanvas := TuiCanvas.CreateLocal(Canvas.Surface, TuiPoint.Create(0, 0), Entry.Clip);
  case Node of
    when TuiElement.Empty:
      begin
      end;
    when TuiElement.Spacer(const Value):
      begin
      end;
    when TuiElement.Label(const Text):
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, Text, TuiStyleRole.Normal);
      end;
    when TuiElement.Button(const Button):
      begin
        TuiPaintButton(Clipped, Entry.Bounds, Button, TuiPaintFocused(Focused, Button.Id), TuiPaintFocused(Pressed, Button.Id));
      end;
    when TuiElement.Input(const Input):
      begin
        TuiPaintInput(Clipped, Entry.Bounds, Input, TuiPaintFocused(Focused, Input.Id));
      end;
    when TuiElement.TextArea(const Id, const Text, const Caret, const Offset, const ChangeAction):
      begin
        TuiPaintTextArea(Clipped, Entry.Bounds, Text, Caret, Offset, TuiPaintFocused(Focused, Id), TuiStyleRole.Normal, TuiStyleRole.Focused);
      end;
    when TuiElement.CheckBox(const Id, const Text, const Checked, const ChangeAction):
      begin
        var Mark: string := ' ';
        if Checked then
          begin
            Mark := 'x';
          end;
        end if;

        if TuiPaintFocused(Focused, Id) then
          begin
            TuiPaintTextInBounds(Clipped, Entry.Bounds, (('>[' + Mark) + '] ') + Text, TuiStyleRole.Focused);
          end;
        else
          begin
            TuiPaintTextInBounds(Clipped, Entry.Bounds, ((' [' + Mark) + '] ') + Text, TuiStyleRole.Normal);
          end;
        end if;
      end;
    when TuiElement.List(const Id, const Items, const Selected, const ChangeAction):
      begin
        var RowLimit: integer := Entry.Bounds.Height;
        if RowLimit > Items.Length() then
          begin
            RowLimit := Items.Length();
          end;
        end if;

        for Row: integer := 0 to RowLimit - 1 do
          begin
            var Prefix: string := '  ';
            if Row = Selected then
              begin
                Prefix := '> ';
              end;
            end if;

            TuiPaintTextInBounds(Clipped, TuiRect.Create(Entry.Bounds.X, Entry.Bounds.Y + Row, Entry.Bounds.Width, 1), Prefix +
                                                                                                                       Items[Row], TuiStyleRole.Normal);
          end;
        end for;
      end;
    when TuiElement.MenuBar(const Items):
      begin
        Clipped.FillRect(Entry.Bounds, TuiCell.Create(' ', TuiStyleRole.MenuNormal));
        var X: integer := Entry.Bounds.X;
        for ItemIndex: integer := 0 to Items.Length() - 1 do
          begin
            var Role: TuiStyleRole := TuiStyleRole.MenuNormal;
            if Items[ItemIndex].Enabled and TuiPaintFocused(Focused, Items[ItemIndex].Id) then
              begin
                Role := TuiStyleRole.MenuSelected;
              end;
            elsif not Items[ItemIndex].Enabled then
              begin
                Role := TuiStyleRole.MenuDisabled;
              end;
            end if;
            const ItemText: string := (' ' + Items[ItemIndex].Text) + ' ';
            Clipped.WriteText(TuiPoint.Create(X, Entry.Bounds.Y), ItemText, Role);
            X := X + Std.Console.DisplayWidth(ItemText);
          end;
        end for;
      end;
    when TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        TuiPaintMenuBar(Clipped, Entry.Bounds, Nodes, State, TuiPaintFocused(Focused, Id));
      end;
    when TuiElement.StatusLine(const Items):
      begin
        TuiPaintStatusLine(Clipped, Entry.Bounds, Items, Focused);
      end;
    when TuiElement.CellGrid(const Grid):
      begin
        TuiPaintCellGrid(Clipped, Entry.Bounds, Grid);
      end;
    when TuiElement.Rule(const Text):
      begin
        TuiPaintRule(Clipped, Entry.Bounds, Text);
      end;
    when TuiElement.Gauge(const Gauge):
      begin
        TuiPaintGauge(Clipped, Entry.Bounds, Gauge);
      end;
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused, Pressed);
          end;
        end for;
      end;
    when TuiElement.Row(const Children, const Spacing):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused, Pressed);
          end;
        end for;
      end;
    when TuiElement.Column(const Children, const Spacing):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused, Pressed);
          end;
        end for;
      end;
    when TuiElement.Layout(const Settings, const Children):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused, Pressed);
          end;
        end for;
      end;
    when TuiElement.Panel(const Title, const Children), TuiElement.Overlay(const Title, const Children):
      begin
        TuiPaintPanel(Clipped, Entry.Bounds, Title);
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused, Pressed);
          end;
        end for;
      end;
    when TuiElement.Desktop(const DesktopFocus, const Children):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, DesktopFocus, Pressed);
          end;
        end for;
      end;
  end case;

  return Next;
end function;

function TuiPaintMenuOverlays(
  Canvas: TuiCanvas;
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  AllowMenu: boolean
): integer;
begin
  var Next: integer := Index + 1;
  case Node of
    when TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        if AllowMenu and State.Open then
          begin
            TuiPaintMenuPopups(Canvas, Frame.EntryAt(Index).Bounds, Nodes, State);
          end;
        end if;
      end;
    when TuiElement.Desktop(const Focused, const Children):
      begin
        var ModalIndex: integer := -1;
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            if Children[ChildIndex] is TuiElement.Overlay(const Title, const OverlayChildren) then
              begin
                ModalIndex := ChildIndex;
              end;
            end if;
          end;
        end for;

        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintMenuOverlays(Canvas, Frame, Children[ChildIndex], Next, AllowMenu and
                                                                                    ((ModalIndex < 0) or (ModalIndex = ChildIndex)));
          end;
        end for;
      end;
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintMenuOverlays(Canvas, Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Row(const Children, const Spacing):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintMenuOverlays(Canvas, Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Column(const Children, const Spacing):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintMenuOverlays(Canvas, Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Layout(const Settings, const Children):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintMenuOverlays(Canvas, Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Panel(const Title, const Children):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintMenuOverlays(Canvas, Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Overlay(const Title, const Children):
      begin
        for ChildIndex: integer := 0 to Children.Length() - 1 do
          begin
            Next := TuiPaintMenuOverlays(Canvas, Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Empty, TuiElement.Label(_), TuiElement.Button(_), TuiElement.Input(_), TuiElement.TextArea(_, _, _, _, _), TuiElement.CheckBox(_, _, _, _), TuiElement.List(_, _, _, _), TuiElement.MenuBar(_), TuiElement.StatusLine(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Spacer(_):
      null;
  end case;

  return Next;
end function;

// Paints one complete frame using arranged geometry only (no measurement).
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
// - `Frame`: Arranged frame containing element geometry.
// - `Root`: Root of the element tree.
// - `Pressed`: Whether the control is displayed as pressed.
public procedure TuiPaintView(
  Surface: TuiWorkingSurface;
  Frame: TuiArrangedFrame;
  Root: TuiElement;
  Pressed: option of TuiControlId
);
begin
  Surface.Clear();
  const Canvas: TuiCanvas := TuiCanvas.Create(Surface, TuiRectForSize(Surface.Size()));
  const NextIndex: integer := TuiPaintArranged(Canvas, Frame, Root, 0, None, Pressed);
  if NextIndex <> Frame.Count() then
    begin
      panic('Tui paint did not consume the complete arranged frame');
    end;
  end if;

  if TuiPaintMenuOverlays(Canvas, Frame, Root, 0, true) <> Frame.Count() then
    begin
      panic('Tui menu overlay paint did not consume the complete arranged frame');
    end;
  end if;
end procedure;

// Overwrites the surface with a terminal-too-small notice when layout overflows.
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
public procedure TuiPaintTooSmallOverlay(Surface: TuiWorkingSurface);
begin
  Surface.Clear();
  const Size: TuiSize := Surface.Size();
  if Size.IsEmpty() then
    begin
      return;
    end;
  end if;
  const Canvas: TuiCanvas := TuiCanvas.Create(Surface, TuiRectForSize(Size));
  const Message: string := 'Terminal too small';
  var X: integer := 0;
  if Size.Width > Std.Console.DisplayWidth(Message) then
    begin
      X := (Size.Width - Std.Console.DisplayWidth(Message)) div 2;
    end;
  end if;
  var Y: integer := 0;
  if Size.Height > 1 then
    begin
      Y := Size.Height div 2;
    end;
  end if;

  Canvas.WriteText(TuiPoint.Create(X, Y), Message, TuiStyleRole.Warning);
end procedure;
end unit;
