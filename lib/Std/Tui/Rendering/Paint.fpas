unit Std.Tui.Rendering.Paint;

uses
  Std.Array, Std.Console, Std.Tui.Cells.Cell, Std.Tui.Cells.StyleRole, Std.Tui.Chrome.StatusItem,
  Std.Tui.Elements.Element, Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect, Std.Tui.Geometry.Size,
  Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame, Std.Tui.Rendering.Canvas, Std.Tui.Rendering.Chrome,
  Std.Tui.Rendering.Menu, Std.Tui.Rendering.StatusLine, Std.Tui.Rendering.Surface,
  Std.Tui.Rendering.TextArea;

private function TuiPaintFocused(Focused: option of TuiControlId; Id: TuiControlId): boolean;
begin
  case Focused of
    Some(Value):
    begin
      return Value.Value = Id.Value
    end;
    None:
    begin
      return false
    end
  end
end;

private procedure TuiPaintTextInBounds(Canvas: TuiCanvas; Bounds: TuiRect; Text: string; Role: TuiStyleRole);
begin
  if Bounds.IsEmpty() then
  begin
    return
  end;
  Canvas.Child(Bounds).WriteText(TuiPoint.Create(0, 0), Text, Role)
end;

/// Paints one arranged node and returns the next unused frame index.

private function TuiPaintArranged(
  Canvas: TuiCanvas;
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  Focused: option of TuiControlId;
  InDialog: boolean
): integer;
begin
  var Entry: TuiArrangedEntry := Frame.EntryAt(Index);
  mutable var Next: integer := Index + 1;
  var Clipped: TuiCanvas := TuiCanvas.CreateLocal(Canvas.Surface, TuiPoint.Create(0, 0), Entry.Clip);
  case Node of
    TuiElement.Empty, TuiElement.Spacer(Value):
    begin
    end;
    TuiElement.Label(Text):
    begin
      mutable var Role: TuiStyleRole := TuiStyleRole.Normal;
      if InDialog then
      begin
        Role := TuiStyleRole.DialogNormal
      end;
      TuiPaintTextInBounds(Clipped, Entry.Bounds, Text, Role)
    end;
    TuiElement.Button(Id, Text, Action):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        mutable var Role: TuiStyleRole := TuiStyleRole.Focused;
        if InDialog then
        begin
          Role := TuiStyleRole.DialogButtonFocused
        end;
        TuiPaintTextInBounds(Clipped, Entry.Bounds, ('>[ ' + Text) + ' ]', Role)
      end
      else
      begin
        mutable var Role: TuiStyleRole := TuiStyleRole.Normal;
        if InDialog then
        begin
          Role := TuiStyleRole.DialogButton
        end;
        TuiPaintTextInBounds(Clipped, Entry.Bounds, (' [ ' + Text) + ' ]', Role)
      end
    end;
    TuiElement.Input(Id, Text, Caret, ChangeAction):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        mutable var Role: TuiStyleRole := TuiStyleRole.Focused;
        if InDialog then
        begin
          Role := TuiStyleRole.DialogInputFocused
        end;
        TuiPaintTextInBounds(Clipped, Entry.Bounds, ('> ' + Text) + '_', Role)
      end
      else
      begin
        mutable var Role: TuiStyleRole := TuiStyleRole.Normal;
        if InDialog then
        begin
          Role := TuiStyleRole.DialogInput
        end;
        TuiPaintTextInBounds(Clipped, Entry.Bounds, '  ' + Text, Role)
      end
    end;
    TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction):
    begin
      mutable var NormalRole: TuiStyleRole := TuiStyleRole.Normal;
      mutable var FocusedRole: TuiStyleRole := TuiStyleRole.Focused;
      if InDialog then
      begin
        NormalRole := TuiStyleRole.DialogInput;
        FocusedRole := TuiStyleRole.DialogInputFocused
      end;
      TuiPaintTextArea(Clipped, Entry.Bounds, Text, Caret, Offset, TuiPaintFocused(Focused, Id), NormalRole, FocusedRole)
    end;
    TuiElement.CheckBox(Id, Text, Checked, ChangeAction):
    begin
      mutable var Mark: string := ' ';
      if Checked then
      begin
        Mark := 'x'
      end;
      if TuiPaintFocused(Focused, Id) then
      begin
        mutable var Role: TuiStyleRole := TuiStyleRole.Focused;
        if InDialog then
        begin
          Role := TuiStyleRole.DialogButtonFocused
        end;
        TuiPaintTextInBounds(Clipped, Entry.Bounds, (('>[' + Mark) + '] ') + Text, Role)
      end
      else
      begin
        mutable var Role: TuiStyleRole := TuiStyleRole.Normal;
        if InDialog then
        begin
          Role := TuiStyleRole.DialogNormal
        end;
        TuiPaintTextInBounds(Clipped, Entry.Bounds, ((' [' + Mark) + '] ') + Text, Role)
      end
    end;
    TuiElement.List(Id, Items, Selected, ChangeAction):
    begin
      mutable var RowLimit: integer := Entry.Bounds.Height;
      if RowLimit > Std.Array.Length(Items) then
      begin
        RowLimit := Std.Array.Length(Items)
      end;
      for Row: integer := 0 to RowLimit - 1 do
      begin
        mutable var Prefix: string := '  ';
        if Row = Selected then
        begin
          Prefix := '> '
        end;
        mutable var Role: TuiStyleRole := TuiStyleRole.Normal;
        if InDialog then
        begin
          Role := TuiStyleRole.DialogNormal
        end;
        TuiPaintTextInBounds(Clipped, TuiRect.Create(Entry.Bounds.X, Entry.Bounds.Y + Row, Entry.Bounds.Width, 1), Prefix +
                                                                                                                   Items[Row], Role)
      end
    end;
    TuiElement.MenuBar(Items):
    begin
      Clipped.FillRect(Entry.Bounds, TuiCell.Create(' ', TuiStyleRole.MenuNormal));
      mutable var X: integer := Entry.Bounds.X;
      for ItemIndex: integer := 0 to Std.Array.Length(Items) - 1 do
      begin
        mutable var Role: TuiStyleRole := TuiStyleRole.MenuNormal;
        if Items[ItemIndex].Enabled and TuiPaintFocused(Focused, Items[ItemIndex].Id) then
        begin
          Role := TuiStyleRole.MenuSelected
        end
        else if not Items[ItemIndex].Enabled then
        begin
          Role := TuiStyleRole.MenuDisabled
        end;
        var ItemText: string := (' ' + Items[ItemIndex].Text) + ' ';
        Clipped.WriteText(TuiPoint.Create(X, Entry.Bounds.Y), ItemText, Role);
        X := X + Std.Console.DisplayWidth(ItemText)
      end
    end;
    TuiElement.Menu(Id, Nodes, State, ChangeAction):
    begin
      TuiPaintMenuBar(Clipped, Entry.Bounds, Nodes, State, TuiPaintFocused(Focused, Id))
    end;
    TuiElement.StatusLine(Items):
    begin
      TuiPaintStatusLine(Clipped, Entry.Bounds, Items, Focused)
    end;
    TuiElement.Scroll(Id, Offset, ChangeAction, Children), TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused, InDialog)
      end
    end;
    TuiElement.Window(Title, Children):
    begin
      TuiPaintFrameChrome(Clipped, Entry.Bounds, Title, TuiStyleRole.Frame, TuiStyleRole.Title, false);
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused, InDialog)
      end
    end;
    TuiElement.Dialog(Title, Children):
    begin
      TuiPaintDialogShadow(Canvas, Entry.Bounds);
      TuiPaintDialogSurface(Canvas, Entry.Bounds);
      TuiPaintFrameChrome(Clipped, Entry.Bounds, Title, TuiStyleRole.DialogFrame, TuiStyleRole.DialogTitle, false);
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused, true)
      end
    end;
    TuiElement.MovableDialog(Id, Title, Position, DragOffset, ChangeAction, Children):
    begin
      TuiPaintDialogShadow(Canvas, Entry.Bounds);
      TuiPaintDialogSurface(Canvas, Entry.Bounds);
      TuiPaintFrameChrome(Clipped, Entry.Bounds, Title, TuiStyleRole.DialogFrame, TuiStyleRole.DialogTitle, true);
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused, true)
      end
    end;
    TuiElement.Desktop(DesktopFocus, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, DesktopFocus, false)
      end
    end
  end;
  return Next
end;

private function TuiPaintMenuOverlays(
  Canvas: TuiCanvas;
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  AllowMenu: boolean
): integer;
begin
  mutable var Next: integer := Index + 1;
  case Node of
    TuiElement.Menu(Id, Nodes, State, ChangeAction):
    begin
      if AllowMenu and State.Open then
      begin
        TuiPaintMenuPopups(Canvas, Frame.EntryAt(Index).Bounds, Nodes, State)
      end
    end;
    TuiElement.Desktop(Focused, Children):
    begin
      mutable var ModalIndex: integer := -1;
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        case Children[ChildIndex] of
          TuiElement.Dialog(Title, DialogChildren):
          begin
            ModalIndex := ChildIndex
          end;
          TuiElement.MovableDialog(Id, Title, Position, DragOffset, ChangeAction, DialogChildren):
          begin
            ModalIndex := ChildIndex
          end
          else
          begin
          end
        end
      end;
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintMenuOverlays(Canvas, Frame, Children[ChildIndex], Next, AllowMenu and
                                                                                ((ModalIndex < 0) or (ModalIndex = ChildIndex)))
      end
    end;
    TuiElement.Scroll(Id, Offset, ChangeAction, Children), TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children), TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children), TuiElement.MovableDialog(Id, Title, Position, DragOffset, ChangeAction, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintMenuOverlays(Canvas, Frame, Children[ChildIndex], Next, AllowMenu)
      end
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction), TuiElement.CheckBox(Id, Text, Checked, ChangeAction), TuiElement.List(Id, Items, Selected, ChangeAction), TuiElement.MenuBar(Items), TuiElement.StatusLine(StatusItems), TuiElement.Spacer(Value):
    begin
    end
  end;
  return Next
end;

/// Paints one complete frame using arranged geometry only (no measurement).

procedure TuiPaintView(Surface: TuiWorkingSurface; Frame: TuiArrangedFrame; Root: TuiElement);
begin
  Surface.Clear();
  var Canvas: TuiCanvas := TuiCanvas.Create(Surface, TuiRectForSize(Surface.Size()));
  var NextIndex: integer := TuiPaintArranged(Canvas, Frame, Root, 0, None, false);
  if NextIndex <> Frame.Count() then
  begin
    panic('Tui paint did not consume the complete arranged frame')
  end;
  if TuiPaintMenuOverlays(Canvas, Frame, Root, 0, true) <> Frame.Count() then
  begin
    panic('Tui menu overlay paint did not consume the complete arranged frame')
  end
end;

/// Overwrites the surface with a terminal-too-small notice when layout overflows.

procedure TuiPaintTooSmallOverlay(Surface: TuiWorkingSurface);
begin
  Surface.Clear();
  var Size: TuiSize := Surface.Size();
  if Size.IsEmpty() then
  begin
    return
  end;
  var Canvas: TuiCanvas := TuiCanvas.Create(Surface, TuiRectForSize(Size));
  var Message: string := 'Terminal too small';
  mutable var X: integer := 0;
  if Size.Width > Std.Console.DisplayWidth(Message) then
  begin
    X := (Size.Width - Std.Console.DisplayWidth(Message)) div 2
  end;
  mutable var Y: integer := 0;
  if Size.Height > 1 then
  begin
    Y := Size.Height div 2
  end;
  Canvas.WriteText(TuiPoint.Create(X, Y), Message, TuiStyleRole.Warning)
end;
