unit Std.Tui.Rendering.Paint;

uses
  Std.Array, Std.Console, Std.Tui.Cells.StyleRole, Std.Tui.Chrome.StatusItem,
  Std.Tui.Elements.Element, Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect, Std.Tui.Geometry.Size,
  Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame, Std.Tui.Rendering.Canvas, Std.Tui.Rendering.Surface,
  Std.Tui.Rendering.TextArea;

private function TuiPaintFocused(Focused: option of TuiControlId; Id: TuiControlId): boolean;
begin
  case Focused of
    Some(Value):
    begin
      return Value.Value = Id.Value
    end;
    None:
    begin
      return false
    end
  end
end;

private procedure TuiPaintTextInBounds(Canvas: TuiCanvas; Bounds: TuiRect; Text: string);
begin
  if Bounds.IsEmpty() then
  begin
    return
  end;
  Canvas.Child(Bounds).WriteText(TuiPoint.Create(0, 0), Text, TuiStyleRole.Normal)
end;

private procedure TuiPaintFrameChrome(Canvas: TuiCanvas; Bounds: TuiRect; Title: string);
begin
  if Bounds.IsEmpty() then
  begin
    return
  end;
  Canvas.Child(Bounds)
    .DrawFrame(TuiRect.Create(0, 0, Bounds.Width, Bounds.Height), TuiStyleRole.Frame);
  if (Title <> '') and (Bounds.Width > 6) then
  begin
    TuiPaintTextInBounds(Canvas, TuiRect.Create(Bounds.X + 2, Bounds.Y, Bounds.Width - 4, 1), (' ' + Title) +
                                                                                              ' ')
  end
end;

/// Paints one arranged node and returns the next unused frame index.

private function TuiPaintArranged(
  Canvas: TuiCanvas;
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  Focused: option of TuiControlId
): integer;
begin
  var Entry: TuiArrangedEntry := Frame.EntryAt(Index);
  mutable var Next: integer := Index + 1;
  var Clipped: TuiCanvas := TuiCanvas.CreateLocal(Canvas.Surface, TuiPoint.Create(0, 0), Entry.Clip);
  case Node of
    TuiElement.Empty, TuiElement.Spacer(Value):
    begin
    end;
    TuiElement.Label(Text):
    begin
      TuiPaintTextInBounds(Clipped, Entry.Bounds, Text)
    end;
    TuiElement.Button(Id, Text, Action):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, ('>[ ' + Text) + ' ]')
      end
      else
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, (' [ ' + Text) + ' ]')
      end
    end;
    TuiElement.Input(Id, Text, Caret, ChangeAction):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, ('> ' + Text) + '_')
      end
      else
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, '  ' + Text)
      end
    end;
    TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction):
    begin
      TuiPaintTextArea(Clipped, Entry.Bounds, Text, Caret, Offset, TuiPaintFocused(Focused, Id))
    end;
    TuiElement.CheckBox(Id, Text, Checked, ChangeAction):
    begin
      mutable var Mark: string := ' ';
      if Checked then
      begin
        Mark := 'x'
      end;
      if TuiPaintFocused(Focused, Id) then
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, (('>[' + Mark) + '] ') + Text)
      end
      else
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, ((' [' + Mark) + '] ') + Text)
      end
    end;
    TuiElement.List(Id, Items, Selected, ChangeAction):
    begin
      mutable var RowLimit: integer := Entry.Bounds.Height;
      if RowLimit > Std.Array.Length(Items) then
      begin
        RowLimit := Std.Array.Length(Items)
      end;
      for Row: integer := 0 to RowLimit - 1 do
      begin
        mutable var Prefix: string := '  ';
        if Row = Selected then
        begin
          Prefix := '> '
        end;
        TuiPaintTextInBounds(Clipped, TuiRect.Create(Entry.Bounds.X, Entry.Bounds.Y + Row, Entry.Bounds.Width, 1), Prefix +
                                                                                                                   Items[Row])
      end
    end;
    TuiElement.MenuBar(Items):
    begin
      mutable var Text: string := '';
      for ItemIndex: integer := 0 to Std.Array.Length(Items) - 1 do
      begin
        if Items[ItemIndex].Enabled and TuiPaintFocused(Focused, Items[ItemIndex].Id) then
        begin
          Text := (Text + ('>' + Items[ItemIndex].Text)) + ' '
        end
        else
        begin
          Text := (Text + (' ' + Items[ItemIndex].Text)) + ' '
        end
      end;
      TuiPaintTextInBounds(Clipped, Entry.Bounds, Text)
    end;
    TuiElement.StatusLine(Items):
    begin
      mutable var Text: string := '';
      for ItemIndex: integer := 0 to Std.Array.Length(Items) - 1 do
      begin
        if ItemIndex > 0 then
        begin
          Text := Text + ' '
        end;
        case Items[ItemIndex] of
          TuiStatusItem.Hint(ItemText):
          begin
            Text := Text + ItemText
          end;
          TuiStatusItem.Command(Id, ItemText, Action, Enabled):
          begin
            if Enabled and TuiPaintFocused(Focused, Id) then
            begin
              Text := Text + ('>' + ItemText)
            end
            else
            begin
              Text := Text + ItemText
            end
          end
        end
      end;
      TuiPaintTextInBounds(Clipped, Entry.Bounds, Text)
    end;
    TuiElement.Scroll(Id, Offset, ChangeAction, Children), TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused)
      end
    end;
    TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children):
    begin
      TuiPaintFrameChrome(Clipped, Entry.Bounds, Title);
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused)
      end
    end;
    TuiElement.Desktop(DesktopFocus, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, DesktopFocus)
      end
    end
  end;
  return Next
end;

/// Paints one complete frame using arranged geometry only (no measurement).

procedure TuiPaintView(Surface: TuiWorkingSurface; Frame: TuiArrangedFrame; Root: TuiElement);
begin
  Surface.Clear();
  var Canvas: TuiCanvas := TuiCanvas.Create(Surface, TuiRectForSize(Surface.Size()));
  var NextIndex: integer := TuiPaintArranged(Canvas, Frame, Root, 0, None);
  if NextIndex <> Frame.Count() then
  begin
    panic('Tui paint did not consume the complete arranged frame')
  end
end;

/// Overwrites the surface with a terminal-too-small notice when layout overflows.

procedure TuiPaintTooSmallOverlay(Surface: TuiWorkingSurface);
begin
  Surface.Clear();
  var Size: TuiSize := Surface.Size();
  if Size.IsEmpty() then
  begin
    return
  end;
  var Canvas: TuiCanvas := TuiCanvas.Create(Surface, TuiRectForSize(Size));
  var Message: string := 'Terminal too small';
  mutable var X: integer := 0;
  if Size.Width > Std.Console.DisplayWidth(Message) then
  begin
    X := (Size.Width - Std.Console.DisplayWidth(Message)) div 2
  end;
  mutable var Y: integer := 0;
  if Size.Height > 1 then
  begin
    Y := Size.Height div 2
  end;
  Canvas.WriteText(TuiPoint.Create(X, Y), Message, TuiStyleRole.Warning)
end;
