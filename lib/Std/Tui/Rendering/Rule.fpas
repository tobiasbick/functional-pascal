// Separator-rule painting.
unit Std.Tui.Rendering.Rule;

uses
  Std.Tui.Cells.StyleRole, Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect, Std.Tui.Rendering.Canvas;

// Paints a thin horizontal separator with optional left-aligned text.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Text`: Text processed or displayed by the operation.
public procedure TuiPaintRule(Canvas: TuiCanvas; Bounds: TuiRect; Text: string);
begin
  if Bounds.IsEmpty() then
  begin
    return
  end;

  Canvas.DrawHorizontalLine(Bounds.X, Bounds.Y, Bounds.Width, TuiStyleRole.Rule);
  if (Text <> '') and (Bounds.Width > 4) then
  begin
    Canvas.Child(TuiRect.Create(Bounds.X + 2, Bounds.Y, Bounds.Width - 4, 1))
      .WriteText(TuiPoint.Create(0, 0), (' ' + Text) + ' ', TuiStyleRole.Title)
  end
end;
