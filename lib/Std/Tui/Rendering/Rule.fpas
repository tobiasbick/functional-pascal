// Separator-rule painting.
unit Std.Tui.Rendering.Rule;

uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Rendering.Canvas as Canvas2;

// Paints a thin horizontal separator with optional left-aligned text.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Text`: Text processed or displayed by the operation.
public procedure TuiPaintRule(Canvas: Canvas2.TuiCanvas; Bounds: Rect.TuiRect; Text: string);
begin
  if Rect.TuiRectIsEmpty(Bounds) then
    begin
      return;
    end;
  end if;

  Canvas2.TuiCanvasDrawHorizontalLine(Canvas, Bounds.X, Bounds.Y, Bounds.Width, StyleRole.TuiStyleRole.Rule);
  if (Text <> '') and (Bounds.Width > 4) then
    begin
      Canvas2.TuiCanvasWriteText(Canvas2.TuiCanvasChild(Canvas, Rect.TuiRectCreate(Bounds.X + 2, Bounds.Y, Bounds.Width -
                                                                                                           4, 1)), Point.TuiPointCreate(0, 0), (' ' + Text) +
                                                                                                                                               ' ', StyleRole.TuiStyleRole.Title);
    end;
  end if;
end procedure;

end unit;
