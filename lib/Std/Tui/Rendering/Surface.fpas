unit Std.Tui.Rendering.Surface;

uses
  Std.Array, Std.Option, Std.Str, Std.Tui.Cells.Cell, Std.Tui.Cells.Color, Std.Tui.Cells.Style,
  Std.Tui.Cells.StyleRole, Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect, Std.Tui.Geometry.Size;

mutable var
  TuiSurfaceSizes: array of TuiSize := [];
  TuiSurfaceRowOffsets: array of integer := [];
  TuiSurfaceCells: array of array of TuiCell := [];
  TuiSurfaceContinuations: array of array of boolean := [];
  TuiSurfacePresentedCells: array of array of TuiCell := [];
  TuiSurfacePresentedContinuations: array of array of boolean := [];
  TuiSurfacePresentedReady: array of boolean := [];

public type
  // One changed horizontal range prepared for the internal terminal renderer.
  TuiSurfaceDamage = record
    // Zero-based vertical terminal-cell coordinate.
    public Y: integer;
    // First changed horizontal cell coordinate.
    public FirstX: integer;
    // Row-major terminal cells.
    public Cells: array of TuiCell;
  end;

function TuiSurfaceBlank(): TuiCell;
begin
  return TuiCell.Create(' ', TuiStyleRole.Normal)
end;

function TuiSurfaceBlankRow(Width: integer): array of TuiCell;
begin
  return Std.Array.Fill(TuiSurfaceBlank(), Width)
end;

function TuiSurfaceBlankContinuationRow(Width: integer): array of boolean;
begin
  return Std.Array.Fill(false, Width)
end;

function TuiSurfaceRequire(Slot: integer): integer;
begin
  if (Slot < 1) or (Slot > Std.Array.Length(TuiSurfaceSizes)) then
  begin
    panic('Tui working surface handle is invalid')
  end;

  return Slot
end;

procedure TuiSurfaceClearGlyphAt(RowIndex: integer; X: integer);
begin
  var Blank: TuiCell := TuiSurfaceBlank();
  if TuiSurfaceContinuations[RowIndex][X] then
  begin
    TuiSurfaceCells[RowIndex][X - 1] := Blank;
    TuiSurfaceContinuations[RowIndex][X] := false
  end
  else if TuiSurfaceCells[RowIndex][X].Width() = 2 then
  begin
    TuiSurfaceCells[RowIndex][X + 1] := Blank;
    TuiSurfaceContinuations[RowIndex][X + 1] := false
  end;

  TuiSurfaceCells[RowIndex][X] := Blank
end;

procedure TuiSurfacePutCellAt(
  RowOffset: integer;
  Size: TuiSize;
  X: integer;
  Y: integer;
  Cell: TuiCell
);
begin
  var RowIndex: integer := RowOffset + Y;
  var CellWidth: integer := Cell.Width();
  TuiSurfaceClearGlyphAt(RowIndex, X);
  if CellWidth = 2 then
  begin
    if X + 1 >= Size.Width then
    begin
      return
    end;

    TuiSurfaceClearGlyphAt(RowIndex, X + 1)
  end;

  TuiSurfaceCells[RowIndex][X] := Cell;
  if CellWidth = 2 then
  begin
    TuiSurfaceCells[RowIndex][X + 1] := TuiSurfaceBlank();
    TuiSurfaceContinuations[RowIndex][X + 1] := true
  end
end;

function TuiSurfaceColorEqual(Left: TuiColor; Right: TuiColor): boolean;
begin
  return ((((Left.Kind = Right.Kind) and (Left.Index = Right.Index)) and (Left.Red = Right.Red)) and (Left.Green = Right.Green)) and
         (Left.Blue = Right.Blue)
end;

function TuiSurfaceStyleEqual(Left: TuiStyle; Right: TuiStyle): boolean;
begin
  return ((((TuiSurfaceColorEqual(Left.Foreground, Right.Foreground) and TuiSurfaceColorEqual(Left.Background, Right.Background)) and (Left.Bold = Right.Bold)) and (Left.Dim = Right.Dim)) and (Left.Underline = Right.Underline)) and
         (Left.Inverse = Right.Inverse)
end;

function TuiSurfaceConcreteStyleEqual(Left: option of TuiStyle; Right: option of TuiStyle): boolean;
begin
  case Left of
    Some(LeftStyle):
    begin
      case Right of
        Some(RightStyle):
        begin
          return TuiSurfaceStyleEqual(LeftStyle, RightStyle)
        end;
        None:
        begin
          return false
        end
      end
    end;
    None:
    begin
      case Right of
        Some(RightStyle):
        begin
          return false
        end;
        None:
        begin
          return true
        end
      end
    end
  end
end;

function TuiSurfaceCellChanged(RowIndex: integer; X: integer): boolean;
begin
  if TuiSurfaceContinuations[RowIndex][X] <> TuiSurfacePresentedContinuations[RowIndex][X] then
  begin
    return true
  end;

  if TuiSurfaceContinuations[RowIndex][X] then
  begin
    return false
  end;

  return ((TuiSurfaceCells[RowIndex][X].Glyph <> TuiSurfacePresentedCells[RowIndex][X].Glyph) or (TuiSurfaceCells[RowIndex][X].Role <> TuiSurfacePresentedCells[RowIndex][X].Role)) or
         not TuiSurfaceConcreteStyleEqual(TuiSurfaceCells[RowIndex][X].ConcreteStyle, TuiSurfacePresentedCells[RowIndex][X].ConcreteStyle)
end;

function TuiSurfaceDamageForRange(RowIndex: integer; Y: integer; FirstX: integer; LastX: integer): TuiSurfaceDamage;
begin
  mutable var Cells: array of TuiCell := [];
  for X: integer := FirstX to LastX do
  begin
    if not TuiSurfaceContinuations[RowIndex][X] then
    begin
      Std.Array.Push(Cells, TuiSurfaceCells[RowIndex][X])
    end
  end;

  return record
    Y := Y;
    FirstX := FirstX;
    Cells := Cells;
  end
end;

public type
  // Explicit immutable copy of the most recently painted headless surface.
  TuiSurfaceSnapshot = record
    // Width in terminal cells.
    public Width: integer;
    // Height in terminal cells.
    public Height: integer;
    // Row-major terminal cells.
    public Cells: array of TuiCell;

    // Returns one leading cell at a zero-based position.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `X`: Zero-based horizontal terminal-cell coordinate.
    // - `Y`: Zero-based vertical terminal-cell coordinate.
    public function CellAt(Self: TuiSurfaceSnapshot; X: integer; Y: integer): TuiCell;
    begin
      if (((X < 0) or (X >= Self.Width)) or (Y < 0)) or (Y >= Self.Height) then
      begin
        panic('Tui snapshot position is outside the surface')
      end;

      return Self.Cells[(Y * Self.Width) + X]
    end;

    // Returns one complete row as text.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Y`: Zero-based vertical terminal-cell coordinate.
    public function LineAt(Self: TuiSurfaceSnapshot; Y: integer): string;
    begin
      if (Y < 0) or (Y >= Self.Height) then
      begin
        panic('Tui snapshot row is outside the surface')
      end;
      mutable var Line: string := '';
      for X: integer := 0 to Self.Width - 1 do
      begin
        Line := Line + Self.CellAt(X, Y).Glyph
      end;

      return Line
    end;
  end;
  // Host-owned mutable working surface handle.
  TuiWorkingSurface = record
    // Opaque backing-storage slot.
    public Slot: integer;

    // Allocates one working grid for a headless application.
    //
    // Parameters:
    // - `Size`: Size in terminal cells.
    public static function Create(Size: TuiSize): TuiWorkingSurface;
    begin
      TuiSurfaceSizes := Std.Array.Concat(TuiSurfaceSizes, [Size]);
      TuiSurfaceRowOffsets := Std.Array.Concat(TuiSurfaceRowOffsets, [
                                                                       Std.Array.Length(TuiSurfaceCells)
                                                                     ]);
      mutable var Rows: array of array of TuiCell := [];
      mutable var ContinuationRows: array of array of boolean := [];
      for Y: integer := 0 to Size.Height - 1 do
      begin
        Std.Array.Push(Rows, TuiSurfaceBlankRow(Size.Width));
        Std.Array.Push(ContinuationRows, TuiSurfaceBlankContinuationRow(Size.Width))
      end;

      TuiSurfaceCells := Std.Array.Concat(TuiSurfaceCells, Rows);
      TuiSurfaceContinuations := Std.Array.Concat(TuiSurfaceContinuations, ContinuationRows);
      TuiSurfacePresentedCells := Std.Array.Concat(TuiSurfacePresentedCells, Rows);
      TuiSurfacePresentedContinuations := Std.Array.Concat(TuiSurfacePresentedContinuations, ContinuationRows);
      TuiSurfacePresentedReady := Std.Array.Concat(TuiSurfacePresentedReady, [false]);
      return record
        Slot := Std.Array.Length(TuiSurfaceSizes);
      end
    end;

    // Returns the current surface size.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    public function Size(Self: TuiWorkingSurface): TuiSize;
    begin
      var Slot: integer := TuiSurfaceRequire(Self.Slot);
      return TuiSurfaceSizes[Slot - 1]
    end;

    // Returns whether the zero-based position lies inside the surface.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Position`: Position in terminal-cell coordinates.
    public function Contains(Self: TuiWorkingSurface; Position: TuiPoint): boolean;
    begin
      var Size: TuiSize := Self.Size();
      return (((Position.X >= 0) and (Position.X < Size.Width)) and (Position.Y >= 0)) and
             (Position.Y < Size.Height)
    end;

    // Returns the leading cell at a position, or `None` outside the grid or on a continuation.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Position`: Position in terminal-cell coordinates.
    public function TryCellAt(Self: TuiWorkingSurface; Position: TuiPoint): option of TuiCell;
    begin
      if not Self.Contains(Position) then
      begin
        return None
      end;
      var Slot: integer := TuiSurfaceRequire(Self.Slot);
      var RowIndex: integer := TuiSurfaceRowOffsets[Slot - 1] + Position.Y;
      if TuiSurfaceContinuations[RowIndex][Position.X] then
      begin
        return None
      end;

      return Some(TuiSurfaceCells[RowIndex][Position.X])
    end;

    // Clears the surface by sharing one blank row across every line.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    public procedure Clear(Self: TuiWorkingSurface);
    begin
      var Slot: integer := TuiSurfaceRequire(Self.Slot);
      var Size: TuiSize := TuiSurfaceSizes[Slot - 1];
      var RowOffset: integer := TuiSurfaceRowOffsets[Slot - 1];
      var BlankRow: array of TuiCell := TuiSurfaceBlankRow(Size.Width);
      var BlankContinuations: array of boolean := TuiSurfaceBlankContinuationRow(Size.Width);
      for Y: integer := 0 to Size.Height - 1 do
      begin
        TuiSurfaceCells[RowOffset + Y] := BlankRow;
        TuiSurfaceContinuations[RowOffset + Y] := BlankContinuations
      end
    end;

    // Paints one validated cell; out-of-bounds writes are ignored.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Position`: Position in terminal-cell coordinates.
    // - `Cell`: Terminal cell written by the operation.
    public procedure PutCell(Self: TuiWorkingSurface; Position: TuiPoint; Cell: TuiCell);
    begin
      if not Self.Contains(Position) then
      begin
        return
      end;
      var Slot: integer := TuiSurfaceRequire(Self.Slot);
      TuiSurfacePutCellAt(TuiSurfaceRowOffsets[Slot - 1], Self.Size(), Position.X, Position.Y, Cell)
    end;

    // Paints one glyph with the normal style role; out-of-bounds writes are ignored.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `X`: Zero-based horizontal terminal-cell coordinate.
    // - `Y`: Zero-based vertical terminal-cell coordinate.
    // - `Glyph`: Single renderable grapheme.
    public procedure PutGlyph(Self: TuiWorkingSurface; X: integer; Y: integer; Glyph: string);
    begin
      Self.PutCell(TuiPoint.Create(X, Y), TuiCell.Create(Glyph, TuiStyleRole.Normal))
    end;

    // Copies the current leading glyphs for explicit test inspection.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    public function Snapshot(Self: TuiWorkingSurface): TuiSurfaceSnapshot;
    begin
      var Slot: integer := TuiSurfaceRequire(Self.Slot);
      var Size: TuiSize := TuiSurfaceSizes[Slot - 1];
      var RowOffset: integer := TuiSurfaceRowOffsets[Slot - 1];
      mutable var Cells: array of TuiCell := [];
      for Y: integer := 0 to Size.Height - 1 do
      begin
        for X: integer := 0 to Size.Width - 1 do
        begin
          if TuiSurfaceContinuations[RowOffset + Y][X] then
          begin
            Std.Array.Push(Cells, TuiSurfaceBlank())
          end
          else
          begin
            Std.Array.Push(Cells, TuiSurfaceCells[RowOffset + Y][X])
          end
        end
      end;

      return record
        Width := Size.Width;
        Height := Size.Height;
        Cells := Cells;
      end
    end;
  end;

// Fills one clipped surface rectangle with a one-column cell.
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Cell`: Terminal cell written by the operation.
public procedure TuiSurfaceFillRect(Surface: TuiWorkingSurface; Bounds: TuiRect; Cell: TuiCell);
begin
  if Cell.Width() <> 1 then
  begin
    panic('Tui surface FillRect requires a one-column cell')
  end;
  var Slot: integer := TuiSurfaceRequire(Surface.Slot);
  var Size: TuiSize := TuiSurfaceSizes[Slot - 1];
  var Visible: TuiRect := Bounds.Intersect(TuiRect.Create(0, 0, Size.Width, Size.Height));
  var RowOffset: integer := TuiSurfaceRowOffsets[Slot - 1];
  if (Visible.X = 0) and (Visible.Width = Size.Width) then
  begin
    var FilledRow: array of TuiCell := Std.Array.Fill(Cell, Size.Width);
    var FilledContinuations: array of boolean := Std.Array.Fill(false, Size.Width);
    for Y: integer := Visible.Y to Visible.Bottom() - 1 do
    begin
      TuiSurfaceCells[RowOffset + Y] := FilledRow;
      TuiSurfaceContinuations[RowOffset + Y] := FilledContinuations
    end;

    return
  end;

  for Y: integer := Visible.Y to Visible.Bottom() - 1 do
  begin
    for X: integer := Visible.X to Visible.Right() - 1 do
    begin
      TuiSurfacePutCellAt(RowOffset, Size, X, Y, Cell)
    end
  end
end;

// Returns changed terminal-cell runs and commits the current surface as the presented baseline.
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
public function TuiSurfaceTakeTerminalDamage(Surface: TuiWorkingSurface): array of TuiSurfaceDamage;
begin
  var Slot: integer := TuiSurfaceRequire(Surface.Slot);
  var Size: TuiSize := TuiSurfaceSizes[Slot - 1];
  var RowOffset: integer := TuiSurfaceRowOffsets[Slot - 1];
  var ComparePrevious: boolean := TuiSurfacePresentedReady[Slot - 1];
  mutable var Damage: array of TuiSurfaceDamage := [];
  for Y: integer := 0 to Size.Height - 1 do
  begin
    var RowIndex: integer := RowOffset + Y;
    mutable var FirstX: integer := -1;
    for X: integer := 0 to Size.Width - 1 do
    begin
      var Changed: boolean := not ComparePrevious or TuiSurfaceCellChanged(RowIndex, X);
      if Changed then
      begin
        if FirstX < 0 then
        begin
          FirstX := X
        end;

        TuiSurfacePresentedCells[RowIndex][X] := TuiSurfaceCells[RowIndex][X];
        TuiSurfacePresentedContinuations[RowIndex][X] := TuiSurfaceContinuations[RowIndex][X]
      end
      else if FirstX >= 0 then
      begin
        Std.Array.Push(Damage, TuiSurfaceDamageForRange(RowIndex, Y, FirstX, X - 1));
        FirstX := -1
      end
    end;

    if FirstX >= 0 then
    begin
      Std.Array.Push(Damage, TuiSurfaceDamageForRange(RowIndex, Y, FirstX, Size.Width - 1))
    end
  end;

  TuiSurfacePresentedReady[Slot - 1] := true;
  return Damage
end;

// Marks every terminal cell as damaged without changing the surface contents.
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
public procedure TuiSurfaceInvalidateTerminal(Surface: TuiWorkingSurface);
begin
  var Slot: integer := TuiSurfaceRequire(Surface.Slot);
  TuiSurfacePresentedReady[Slot - 1] := false
end;
