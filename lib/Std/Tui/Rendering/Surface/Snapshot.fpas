unit Std.Tui.Rendering.Surface.Snapshot;

uses Std.Tui.Cells.Cell as Cell;

// Explicit immutable copy of the most recently painted headless surface.
public type TuiSurfaceSnapshot = record
  // Width in terminal cells.
  public Width: integer;
  // Height in terminal cells.
  public Height: integer;
  // Row-major terminal cells.
  public Cells: array of (Cell.TuiCell);
end record;

// Returns one leading cell at a zero-based position.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `X`: Zero-based horizontal terminal-cell coordinate.
// - `Y`: Zero-based vertical terminal-cell coordinate.
public function TuiSurfaceSnapshotCellAt(Receiver: TuiSurfaceSnapshot; X: integer; Y: integer): Cell.TuiCell;
begin
  if (((X < 0) or (X >= Receiver.Width)) or (Y < 0)) or (Y >= Receiver.Height) then
    begin
      panic('Tui snapshot position is outside the surface');
    end;
  end if;

  return Receiver.Cells[(Y * Receiver.Width) + X];
end function;

// Returns one complete row as text.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Y`: Zero-based vertical terminal-cell coordinate.
public function TuiSurfaceSnapshotLineAt(Receiver: TuiSurfaceSnapshot; Y: integer): string;
begin
  if (Y < 0) or (Y >= Receiver.Height) then
    begin
      panic('Tui snapshot row is outside the surface');
    end;
  end if;
  var Line: string := '';
  for X: integer := 0 to Receiver.Width - 1 do
    begin
      Line := Line + TuiSurfaceSnapshotCellAt(Receiver, X, Y).Glyph;
    end;
  end for;

  return Line;
end function;

end unit;
