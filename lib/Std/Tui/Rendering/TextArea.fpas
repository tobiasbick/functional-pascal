unit Std.Tui.Rendering.TextArea;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Tui.Cells.Cell as Cell;
uses Std.Tui.Cells.StyleRole as StyleRole;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Rendering.Canvas as Canvas2;
uses Std.Tui.Text.TextArea as TextArea;

// Paints clipped text-area lines and a focused visible caret.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Text`: Text processed or displayed by the operation.
// - `Caret`: Zero-based character index of the caret.
// - `Offset`: Scroll offset or position applied by the operation.
// - `Focused`: Whether the control currently owns focus.
// - `NormalRole`: Style role used in the normal state.
// - `FocusedRole`: Style role used while the control owns focus.
public procedure TuiPaintTextArea(
  Canvas: Canvas2.TuiCanvas;
  Bounds: Rect.TuiRect;
  Text: string;
  Caret: integer;
  Offset: Point.TuiPoint;
  Focused: boolean;
  NormalRole: StyleRole.TuiStyleRole;
  FocusedRole: StyleRole.TuiStyleRole
);
begin
  if Bounds.IsEmpty() then
    begin
      return;
    end;
  end if;
  var Area: Canvas2.TuiCanvas := Canvas.Child(Bounds);
  var Lines: array of string := Str.Split(Text, Str.Chr(10));
  var LineCount: integer := Arrays.Length(Lines);
  for Row: integer := 0 to Bounds.Height - 1 do
    begin
      var Line: integer := Offset.Y + Row;
      if Line < LineCount then
        begin
          Area.WriteText(Point.TuiPoint.Create(- Offset.X, Row), Lines[Line], NormalRole);
        end;
      end if;
    end;
  end for;

  if Focused then
    begin
      var Position: TextArea.TuiTextAreaPosition := TextArea.TuiTextAreaLocate(Text, Caret);
      var CaretX: integer := Position.DisplayColumn - Offset.X;
      var CaretY: integer := Position.Line - Offset.Y;
      if (((CaretX >= 0) and (CaretX < Bounds.Width)) and (CaretY >= 0)) and
         (CaretY < Bounds.Height) then
        begin
          Area.PutCell(Point.TuiPoint.Create(CaretX, CaretY), Cell.TuiCell.Create('▏', FocusedRole));
        end;
      end if;
    end;
  end if;
end procedure;

end unit;
