unit Std.Tui.Runtime.Application.Background;

uses Std.Arrays, Std.Options, Std.Results, Std.Task, Std.Tui.Runtime.Msg;

public type
  // Cooperative function executed as host-owned background work.
  TuiBackgroundWork = function(Token: CancellationToken): result of boolean, string;
  // Work requested by one completed Update callback.
  TuiBackgroundCommand = enum
    // Starts one independently owned operation.
    Start(Id: integer; Work: TuiBackgroundWork);
    // Requests cancellation and defers the latest replacement until the old source ends.
    ReplaceSubscription(Id: integer; Work: TuiBackgroundWork);
    // Requests cancellation and clears any pending replacement with the matching id.
    CancelSubscription(Id: integer);
  end;

type
  TuiOwnedWork = record
    Id: integer;
    Subscription: boolean;
    Group: TaskGroup;
    Cancelling: boolean;
    Replacement: option of TuiBackgroundWork;
  end;

mutable var
  TuiBackgroundOpen: array of boolean := [];
  TuiBackgroundWorkItems: array of array of TuiOwnedWork := [];

function TuiBackgroundRequireOpen(ApplicationId: integer): integer;
begin
  if ((ApplicationId < 1) or (ApplicationId > Std.Arrays.Length(TuiBackgroundOpen))) or
     not TuiBackgroundOpen[ApplicationId - 1] then
  begin
    panic('Tui background host is closed')
  end;

  return ApplicationId
end;

procedure TuiBackgroundRemove(ApplicationId: integer; Index: integer);
begin
  mutable var Items: array of TuiOwnedWork := TuiBackgroundWorkItems[ApplicationId - 1];
  TuiBackgroundWorkItems[ApplicationId - 1] := Std.Arrays.Concat(Std.Arrays.Slice(Items, 0, Index), Std.Arrays.Slice(Items, Index +
                                                                                                                            1, (Std.Arrays.Length(Items) - Index) -
                                                                                                                               1))
end;

function TuiBackgroundFailureMessages(
  Id: integer;
  Failures: array of TaskFailure;
  IncludeCancellation: boolean
): array of TuiMsg;
begin
  mutable var Messages: array of TuiMsg := [];
  for Failure: TaskFailure in Failures do
  begin
    if IncludeCancellation or (Failure.Kind <> TaskFailureKind.Cancelled) then
    begin
      Std.Arrays.Push(Messages, TuiMsg.BackgroundFailed(Id, Failure.Kind, Failure.Message, Failure.Code, Failure.Line, Failure.Column))
    end
  end;

  return Messages
end;

function TuiBackgroundCloseAt(ApplicationId: integer; Index: integer; IncludeCancellation: boolean): array of TuiMsg;
begin
  var Item: TuiOwnedWork := TuiBackgroundWorkItems[ApplicationId - 1][Index];
  var Messages: array of TuiMsg := TuiBackgroundFailureMessages(Item.Id, CloseTaskGroup(Item.Group), IncludeCancellation);
  TuiBackgroundRemove(ApplicationId, Index);
  return Messages
end;

function TuiBackgroundFindSubscription(ApplicationId: integer; Id: integer): integer;
begin
  mutable var Items: array of TuiOwnedWork := TuiBackgroundWorkItems[ApplicationId - 1];
  for Index: integer := 0 to Std.Arrays.Length(Items) - 1 do
  begin
    if Items[Index].Subscription and (Items[Index].Id = Id) then
    begin
      return Index
    end
  end;

  return -1
end;

procedure TuiBackgroundStart(
  ApplicationId: integer;
  Id: integer;
  Subscription: boolean;
  Work: TuiBackgroundWork
);
begin
  mutable var Items: array of TuiOwnedWork := TuiBackgroundWorkItems[ApplicationId - 1];
  if Std.Arrays.Length(Items) >= 256 then
  begin
    panic('Tui application cannot own more than 256 background operations')
  end;
  var Group: TaskGroup := CreateTaskGroup();
  StartTaskInGroup(Group, Work);
  Std.Arrays.Push(Items, record
    Id := Id;
    Subscription := Subscription;
    Group := Group;
    Cancelling := false;
    Replacement := None;
  end);
  TuiBackgroundWorkItems[ApplicationId - 1] := Items
end;

procedure TuiBackgroundRequestStop(
  ApplicationId: integer;
  Index: integer;
  Replacement: option of TuiBackgroundWork
);
begin
  mutable var Items: array of TuiOwnedWork := TuiBackgroundWorkItems[ApplicationId - 1];
  CancelTaskGroup(Items[Index].Group);
  Items[Index].Cancelling := true;
  Items[Index].Replacement := Replacement;
  TuiBackgroundWorkItems[ApplicationId - 1] := Items
end;

// Allocates the background ownership slot for a new application.
public procedure TuiBackgroundOpenApplication();
begin
  TuiBackgroundOpen := Std.Arrays.Concat(TuiBackgroundOpen, [true]);
  TuiBackgroundWorkItems := Std.Arrays.Concat(TuiBackgroundWorkItems, [[]])
end;

// Requests cancellation without joining on the UI path; replacement admission is deferred to reap.
public function TuiBackgroundApply(ApplicationId: integer; Commands: array of TuiBackgroundCommand): array of TuiMsg;
begin
  TuiBackgroundRequireOpen(ApplicationId);
  for Command: TuiBackgroundCommand in Commands do
  begin
    case Command of
      TuiBackgroundCommand.Start(Id, Work):
      begin
        TuiBackgroundStart(ApplicationId, Id, false, Work)
      end;
      TuiBackgroundCommand.ReplaceSubscription(Id, Work):
      begin
        var Existing: integer := TuiBackgroundFindSubscription(ApplicationId, Id);
        if Existing >= 0 then
        begin
          TuiBackgroundRequestStop(ApplicationId, Existing, Some(Work))
        end
        else
        begin
          TuiBackgroundStart(ApplicationId, Id, true, Work)
        end
      end;
      TuiBackgroundCommand.CancelSubscription(Id):
      begin
        var Existing: integer := TuiBackgroundFindSubscription(ApplicationId, Id);
        if Existing >= 0 then
        begin
          TuiBackgroundRequestStop(ApplicationId, Existing, None)
        end
      end
    end
  end;

  return []
end;

// Reports whether an application currently owns any operation.
public function TuiBackgroundHasWork(ApplicationId: integer): boolean;
begin
  TuiBackgroundRequireOpen(ApplicationId);
  return Std.Arrays.Length(TuiBackgroundWorkItems[ApplicationId - 1]) > 0
end;

// Collects completed groups and starts only the latest pending replacement after its predecessor ends.
public function TuiBackgroundReap(ApplicationId: integer): array of TuiMsg;
begin
  TuiBackgroundRequireOpen(ApplicationId);
  mutable var Messages: array of TuiMsg := [];
  mutable var Index: integer := Std.Arrays.Length(TuiBackgroundWorkItems[ApplicationId - 1]) - 1;
  while Index >= 0 do
  begin
    var Item: TuiOwnedWork := TuiBackgroundWorkItems[ApplicationId - 1][Index];
    case TryCloseCompletedTaskGroup(Item.Group) of
      Some(Failures):
      begin
        Messages := Std.Arrays.Concat(Messages, TuiBackgroundFailureMessages(Item.Id, Failures, not Item.Cancelling));
        TuiBackgroundRemove(ApplicationId, Index);
        case Item.Replacement of
          Some(Work):
          begin
            TuiBackgroundStart(ApplicationId, Item.Id, true, Work)
          end;
          None:
          begin
          end
        end
      end;
      None:
      begin
      end
    end;

    Index := Index - 1
  end;

  return Messages
end;

// Cancels and joins all owned work at shutdown without starting pending replacements.
public function TuiBackgroundCloseApplication(ApplicationId: integer): array of TuiMsg;
begin
  if ((ApplicationId < 1) or (ApplicationId > Std.Arrays.Length(TuiBackgroundOpen))) or
     not TuiBackgroundOpen[ApplicationId - 1] then
  begin
    return []
  end;
  mutable var Messages: array of TuiMsg := [];
  while Std.Arrays.Length(TuiBackgroundWorkItems[ApplicationId - 1]) > 0 do
  begin
    Messages := Std.Arrays.Concat(Messages, TuiBackgroundCloseAt(ApplicationId, Std.Arrays.Length(TuiBackgroundWorkItems[ApplicationId -
                                                                                                                         1]) -
                                                                                1, false))
  end;

  TuiBackgroundOpen[ApplicationId - 1] := false;
  return Messages
end;
