unit Std.Tui.Runtime.Application.Background;

uses Std.Arrays as Arrays;
uses Std.Options as Options;
uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Tui.Runtime.Msg as Msg;

// Cooperative function executed as host-owned background work.
public type TuiBackgroundWork = function(Token: Tasks.CancellationToken): Result of (boolean, string);

// Work requested by one completed Update callback.
public type TuiBackgroundCommand = enum
  // Starts one independently owned operation.
  Start(Id: integer; Work: TuiBackgroundWork);
  // Requests cancellation and defers the latest replacement until the old source ends.
  ReplaceSubscription(Id: integer; Work: TuiBackgroundWork);
  // Requests cancellation and clears any pending replacement with the matching id.
  CancelSubscription(Id: integer);
end enum;

type TuiOwnedWork = record
  Id: integer;
  Subscription: boolean;
  Group: Tasks.TaskGroup;
  Cancelling: boolean;
  Replacement: Option of (TuiBackgroundWork);
end record;

mutable var TuiBackgroundOpen: array of (boolean) := [];
mutable var TuiBackgroundWorkItems: array of (array of (TuiOwnedWork)) := [];

function TuiBackgroundRequireOpen(ApplicationId: integer): integer;
begin
  if ((ApplicationId < 1) or (ApplicationId > Arrays.Length(TuiBackgroundOpen))) or
     not TuiBackgroundOpen[ApplicationId - 1] then
    begin
      panic('Tui background host is closed');
    end;
  end if;

  return ApplicationId;
end function;

procedure TuiBackgroundRemove(ApplicationId: integer; Index: integer);
begin
  mutable var Items: array of (TuiOwnedWork) := TuiBackgroundWorkItems[ApplicationId - 1];
  TuiBackgroundWorkItems[ApplicationId - 1] := Arrays.Concat(Arrays.Slice(Items, 0, Index), Arrays.Slice(Items, Index +
                                                                                                                1, (Arrays.Length(Items) - Index) -
                                                                                                                   1));
end procedure;

function TuiBackgroundFailureMessages(
  Id: integer;
  Failures: array of (Tasks.TaskFailure);
  IncludeCancellation: boolean
): array of (Msg.TuiMsg);
begin
  mutable var Messages: array of (Msg.TuiMsg) := [];
  for Failure: Tasks.TaskFailure in Failures do
    begin
      if IncludeCancellation or (Failure.Kind <> Tasks.TaskFailureKind.Cancelled) then
        begin
          Arrays.Push(Messages, Msg.TuiMsg.BackgroundFailed(Id, Failure.Kind, Failure.Message, Failure.Code, Failure.Line, Failure.Column));
        end;
      end if;
    end;
  end for;

  return Messages;
end function;

function TuiBackgroundCloseAt(ApplicationId: integer; Index: integer; IncludeCancellation: boolean): array of (Msg.TuiMsg);
begin
  var Item: TuiOwnedWork := TuiBackgroundWorkItems[ApplicationId - 1][Index];
  var Messages: array of (Msg.TuiMsg) := TuiBackgroundFailureMessages(Item.Id, Tasks.CloseTaskGroup(Item.Group), IncludeCancellation);
  TuiBackgroundRemove(ApplicationId, Index);
  return Messages;
end function;

function TuiBackgroundFindSubscription(ApplicationId: integer; Id: integer): integer;
begin
  mutable var Items: array of (TuiOwnedWork) := TuiBackgroundWorkItems[ApplicationId - 1];
  for Index: integer := 0 to Arrays.Length(Items) - 1 do
    begin
      if Items[Index].Subscription and (Items[Index].Id = Id) then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

procedure TuiBackgroundStart(
  ApplicationId: integer;
  Id: integer;
  Subscription: boolean;
  Work: TuiBackgroundWork
);
begin
  mutable var Items: array of (TuiOwnedWork) := TuiBackgroundWorkItems[ApplicationId - 1];
  if Arrays.Length(Items) >= 256 then
    begin
      panic('Tui application cannot own more than 256 background operations');
    end;
  end if;
  var Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  var WorkerHandle: task := Tasks.StartTaskInGroup(Group, Work);
  Arrays.Push(Items, TuiOwnedWork(Id := Id, Subscription := Subscription, Group := Group, Cancelling := false, Replacement := Option.None));
  TuiBackgroundWorkItems[ApplicationId - 1] := Items;
end procedure;

procedure TuiBackgroundRequestStop(
  ApplicationId: integer;
  Index: integer;
  Replacement: Option of (TuiBackgroundWork)
);
begin
  mutable var Items: array of (TuiOwnedWork) := TuiBackgroundWorkItems[ApplicationId - 1];
  discard Tasks.CancelTaskGroup(Items[Index].Group);
  Items[Index].Cancelling := true;
  Items[Index].Replacement := Replacement;
  TuiBackgroundWorkItems[ApplicationId - 1] := Items;
end procedure;

// Allocates the background ownership slot for a new application.
public procedure TuiBackgroundOpenApplication();
begin
  TuiBackgroundOpen := Arrays.Concat(TuiBackgroundOpen, [true]);
  TuiBackgroundWorkItems := Arrays.Concat(TuiBackgroundWorkItems, [[]]);
end procedure;

// Requests cancellation without joining on the UI path; replacement admission is deferred to reap.
public function TuiBackgroundApply(ApplicationId: integer; Commands: array of (TuiBackgroundCommand)): array of (Msg.TuiMsg);
begin
  discard TuiBackgroundRequireOpen(ApplicationId);
  for Command: TuiBackgroundCommand in Commands do
    begin
      case Command of
        when TuiBackgroundCommand.Start(const Id, const Work):
          begin
            TuiBackgroundStart(ApplicationId, Id, false, Work);
          end;
        when TuiBackgroundCommand.ReplaceSubscription(const Id, const Work):
          begin
            var Existing: integer := TuiBackgroundFindSubscription(ApplicationId, Id);
            if Existing >= 0 then
              begin
                TuiBackgroundRequestStop(ApplicationId, Existing, Option.Some(Work));
              end;
            else
              begin
                TuiBackgroundStart(ApplicationId, Id, true, Work);
              end;
            end if;
          end;
        when TuiBackgroundCommand.CancelSubscription(const Id):
          begin
            var Existing: integer := TuiBackgroundFindSubscription(ApplicationId, Id);
            if Existing >= 0 then
              begin
                TuiBackgroundRequestStop(ApplicationId, Existing, Option.None);
              end;
            end if;
          end;
      end case;
    end;
  end for;

  return [];
end function;

// Reports whether an application currently owns any operation.
public function TuiBackgroundHasWork(ApplicationId: integer): boolean;
begin
  discard TuiBackgroundRequireOpen(ApplicationId);
  return Arrays.Length(TuiBackgroundWorkItems[ApplicationId - 1]) > 0;
end function;

// Collects completed groups and starts only the latest pending replacement after its predecessor ends.
public function TuiBackgroundReap(ApplicationId: integer): array of (Msg.TuiMsg);
begin
  discard TuiBackgroundRequireOpen(ApplicationId);
  mutable var Messages: array of (Msg.TuiMsg) := [];
  mutable var Index: integer := Arrays.Length(TuiBackgroundWorkItems[ApplicationId - 1]) - 1;
  while Index >= 0 do
    begin
      var Item: TuiOwnedWork := TuiBackgroundWorkItems[ApplicationId - 1][Index];
      case Tasks.TryCloseCompletedTaskGroup(Item.Group) of
        when Option.Some(const Failures):
          begin
            Messages := Arrays.Concat(Messages, TuiBackgroundFailureMessages(Item.Id, Failures, not Item.Cancelling));
            TuiBackgroundRemove(ApplicationId, Index);
            case Item.Replacement of
              when Option.Some(const Work):
                begin
                  TuiBackgroundStart(ApplicationId, Item.Id, true, Work);
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        when Option.None:
          begin
            null;
          end;
      end case;

      Index := Index - 1;
    end;
  end while;

  return Messages;
end function;

// Cancels and joins all owned work at shutdown without starting pending replacements.
public function TuiBackgroundCloseApplication(ApplicationId: integer): array of (Msg.TuiMsg);
begin
  if ((ApplicationId < 1) or (ApplicationId > Arrays.Length(TuiBackgroundOpen))) or
     not TuiBackgroundOpen[ApplicationId - 1] then
    begin
      return [];
    end;
  end if;
  mutable var Messages: array of (Msg.TuiMsg) := [];
  while Arrays.Length(TuiBackgroundWorkItems[ApplicationId - 1]) > 0 do
    begin
      Messages := Arrays.Concat(Messages, TuiBackgroundCloseAt(ApplicationId, Arrays.Length(TuiBackgroundWorkItems[ApplicationId -
                                                                                                                   1]) -
                                                                              1, false));
    end;
  end while;

  TuiBackgroundOpen[ApplicationId - 1] := false;
  return Messages;
end function;

end unit;
