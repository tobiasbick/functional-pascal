unit Std.Tui.Runtime.Application.ConsoleInput;

uses
  Std.Tasks, Std.Time, Std.Tui.Geometry.Size, Std.Tui.Runtime.ConsoleEvents, Std.Tui.Runtime.Input;

const TuiResizeSettleMilliseconds: integer := 50;

function TuiConsoleInputSend(
  Token: CancellationToken;
  Output: channel of TuiHostInput;
  Input: TuiHostInput
): boolean;
begin
  return SendWithCancellation(Output, Input, Token).IsError();
end function;

function TuiConsoleInputSettleResize(
  Token: CancellationToken;
  Output: channel of TuiHostInput;
  InitialSize: TuiSize
): boolean;
begin
  var LatestSize: TuiSize := InitialSize;
  while not IsCancellationRequested(Token) do
    begin
      case TuiReadConsoleHostInputWithTimeout(TuiResizeSettleMilliseconds) of
        when Some(const Input):
          begin
            case Input of
              when TuiHostInput.Resize(const Size):
                begin
                  LatestSize := Size;
                  Sleep(0);
                end;
              else
                begin
                  if TuiConsoleInputSend(Token, Output, TuiHostInput.Resize(LatestSize)) then
                    begin
                      return true;
                    end;
                  end if;

                  return TuiConsoleInputSend(Token, Output, Input);
                end;
            end case;
          end;
        when None:
          begin
            return TuiConsoleInputSend(Token, Output, TuiHostInput.Resize(LatestSize));
          end;
      end case;
    end;
  end while;

  return true;
end function;

// Pumps Console input while collapsing a resize burst after a quiet period.
//
// Parameters:
// - `Token`: Cancellation token owned by the interactive application.
// - `Output`: Destination for normalized host input.
public function TuiConsoleInputPump(Token: CancellationToken; Output: channel of TuiHostInput): result of boolean, string;
begin
  while not IsCancellationRequested(Token) do
    begin
      case TuiReadConsoleHostInputWithTimeout(TuiResizeSettleMilliseconds) of
        when Some(const Input):
          begin
            case Input of
              when TuiHostInput.Resize(const Size):
                begin
                  if TuiConsoleInputSettleResize(Token, Output, Size) then
                    begin
                      return Ok(true);
                    end;
                  end if;
                end;
              else
                begin
                  if TuiConsoleInputSend(Token, Output, Input) then
                    begin
                      return Ok(true);
                    end;
                  end if;
                end;
            end case;
          end;
        when None:
          begin
          end;
      end case;

      // Release the pool worker even when Console polling returns no event.
      Sleep(0);
    end;
  end while;

  return Ok(true);
end function;
end unit;
