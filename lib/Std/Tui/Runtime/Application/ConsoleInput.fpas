unit Std.Tui.Runtime.Application.ConsoleInput;

uses Std.Options as Options;
uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Time as Time;
uses Std.Tui.Geometry.Size as Size2;
uses Std.Tui.Runtime.ConsoleEvents as ConsoleEvents;
uses Std.Tui.Runtime.Input as Input2;

const TuiResizeSettleMilliseconds: integer := 50;

function TuiConsoleInputSend(
  Token: Tasks.CancellationToken;
  Output: channel of (Input2.TuiHostInput);
  Input: Input2.TuiHostInput
): boolean;
begin
  return Results.IsError(Tasks.SendWithCancellation(Output, Input, Token));
end function;

function TuiConsoleInputSettleResize(
  Token: Tasks.CancellationToken;
  Output: channel of (Input2.TuiHostInput);
  InitialSize: Size2.TuiSize
): boolean;
begin
  var LatestSize: Size2.TuiSize := InitialSize;
  while not Tasks.IsCancellationRequested(Token) do
    begin
      case ConsoleEvents.TuiReadConsoleHostInputWithTimeout(TuiResizeSettleMilliseconds) of
        when Option.Some(const Input):
          begin
            case Input of
              when Input2.TuiHostInput.Resize(const Size):
                begin
                  LatestSize := Size;
                  Time.Sleep(0);
                end;
              when Input2.TuiHostInput.Message(_), Input2.TuiHostInput.Key(_), Input2.TuiHostInput.Pointer(_):
                begin
                  begin
                    if TuiConsoleInputSend(Token, Output, Input2.TuiHostInput.Resize(LatestSize)) then
                      begin
                        return true;
                      end;
                    end if;

                    return TuiConsoleInputSend(Token, Output, Input);
                  end;
                end;
            end case;
          end;
        when Option.None:
          begin
            return TuiConsoleInputSend(Token, Output, Input2.TuiHostInput.Resize(LatestSize));
          end;
      end case;
    end;
  end while;

  return true;
end function;

// Pumps Console input while collapsing a resize burst after a quiet period.
//
// Parameters:
// - `Token`: Cancellation token owned by the interactive application.
// - `Output`: Destination for normalized host input.
public function TuiConsoleInputPump(
  Token: Tasks.CancellationToken;
  Output: channel of (Input2.TuiHostInput)
): Result of (boolean, string);
begin
  while not Tasks.IsCancellationRequested(Token) do
    begin
      case ConsoleEvents.TuiReadConsoleHostInputWithTimeout(TuiResizeSettleMilliseconds) of
        when Option.Some(const Input):
          begin
            case Input of
              when Input2.TuiHostInput.Resize(const Size):
                begin
                  if TuiConsoleInputSettleResize(Token, Output, Size) then
                    begin
                      return Result.Ok(true);
                    end;
                  end if;
                end;
              when Input2.TuiHostInput.Message(_), Input2.TuiHostInput.Key(_), Input2.TuiHostInput.Pointer(_):
                begin
                  begin
                    if TuiConsoleInputSend(Token, Output, Input) then
                      begin
                        return Result.Ok(true);
                      end;
                    end if;
                  end;
                end;
            end case;
          end;
        when Option.None:
          begin
            null;
          end;
      end case;

      // Release the pool worker even when Console polling returns no event.
      Time.Sleep(0);
    end;
  end while;

  return Result.Ok(true);
end function;

end unit;
