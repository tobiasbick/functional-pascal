unit Std.Tui.Runtime.Application.Loop;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Tui.Cells.Palette as Palette;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Runtime.Application.Background as Background;
uses Std.Tui.Runtime.Application.ConsoleInput as ConsoleInput2;
uses Std.Tui.Runtime.Application.State as State2;
uses Std.Tui.Runtime.Cmd as Cmd2;
uses Std.Tui.Runtime.Frame as Frame;
uses Std.Tui.Runtime.Input as Input2;
uses Std.Tui.Runtime.Msg as Msg2;
uses Std.Tui.Runtime.Routing.Pointer as Pointer;
uses Std.Tui.Runtime.TerminalRenderer as TerminalRenderer;

procedure TuiLoopRender(ApplicationId: integer; Tree: Element.TuiElement; Present: boolean);
begin
  Frame.TuiRenderFrame(State2.TuiAppSurfaces[ApplicationId - 1], State2.TuiAppFrames[ApplicationId -
                                                                                     1], Tree, Pointer.TuiPointerRoutingPressed(ApplicationId));
  State2.TuiAppTrees[ApplicationId - 1] := Tree;
  if Present then
    begin
      TerminalRenderer.TuiFlushSurface(State2.TuiAppSurfaces[ApplicationId - 1], State2.TuiAppPalettes[ApplicationId -
                                                                                                       1]);
    end;
  end if;
end procedure;

function TuiLoopApplyFramework of (TModel)(
  ApplicationId: integer;
  Model: TModel;
  Msg: Msg2.TuiMsg;
  Update: function(State: TModel; Msg: Msg2.TuiMsg; Cmd: Cmd2.TuiCmdOutput): TModel
): TModel;
begin
  State2.TuiAppApplyResizeIfNeeded(ApplicationId, Msg);
  const Cmd: Cmd2.TuiCmdOutput := State2.TuiAppCommands[ApplicationId - 1];
  Cmd2.TuiCmdOutputReset(Cmd);
  return Update(Model, Msg, Cmd);
end function;

function TuiLoopApplyApplication of (TModel, TMessage)(
  ApplicationId: integer;
  Model: TModel;
  Message: TMessage;
  UpdateApplication: function(State: TModel; Message: TMessage; Cmd: Cmd2.TuiCmdOutput): TModel
): TModel;
begin
  const Cmd: Cmd2.TuiCmdOutput := State2.TuiAppCommands[ApplicationId - 1];
  Cmd2.TuiCmdOutputReset(Cmd);
  return UpdateApplication(Model, Message, Cmd);
end function;

function TuiLoopFinishUpdate of (TModel)(
  ApplicationId: integer;
  Model: TModel;
  View: function(State: TModel): Element.TuiElement;
  Present: boolean
): boolean;
begin
  const Cmd: Cmd2.TuiCmdOutput := State2.TuiAppCommands[ApplicationId - 1];
  if State2.TuiAppApplyCommand(ApplicationId, Cmd) then
    begin
      return true;
    end;
  end if;

  TuiLoopRender(ApplicationId, View(Model), Present);
  return false;
end function;

procedure TuiLoopClose(ApplicationId: integer);
begin
  State2.TuiAppRaiseShutdownFailure(State2.TuiAppCloseApplication(ApplicationId));
end procedure;

procedure TuiLoopCloseWithInbox of (TMessage)(ApplicationId: integer; Inbox: channel of (TMessage));
begin
  const Failures: array of (Msg2.TuiMsg) := State2.TuiAppCloseApplication(ApplicationId);
  discard Tasks.CloseChannel(Inbox);
  State2.TuiAppRaiseShutdownFailure(Failures);
end procedure;

// Runs a deterministic bounded headless loop with an optional typed inbox.
public function TuiRunHeadless of (TModel, TMessage)(
  ApplicationId: integer;
  InitialModel: TModel;
  Inbox: channel of (TMessage);
  Update: function(State: TModel; Msg: Msg2.TuiMsg; Cmd: Cmd2.TuiCmdOutput): TModel;
  UpdateApplication: function(State: TModel; Message: TMessage; Cmd: Cmd2.TuiCmdOutput): TModel;
  View: function(State: TModel): Element.TuiElement;
  IterationCount: integer;
  DeltaMilliseconds: integer;
  BackgroundEnabled: boolean
): TModel;
begin
  discard State2.TuiAppRequireOpen(ApplicationId);
  if IterationCount < 0 then
    begin
      panic('Tui iteration count must not be negative');
    end;
  end if;

  if DeltaMilliseconds < 0 then
    begin
      panic('Tui tick delta must not be negative');
    end;
  end if;
  var Model: TModel := InitialModel;
  TuiLoopRender(ApplicationId, View(Model), false);
  if BackgroundEnabled then
    begin
      State2.TuiAppStart(ApplicationId);
    end;
  end if;
  var Remaining: integer := IterationCount;
  while Remaining > 0 do
    begin
      if not State2.TuiAppOpen[ApplicationId - 1] then
        begin
          return Model;
        end;
      end if;

      State2.TuiAppPushMessages(ApplicationId, Background.TuiBackgroundReap(ApplicationId));
      if (State2.TuiAppMessageCount(ApplicationId) = 0) and
         (State2.TuiAppInputCount(ApplicationId) > 0) then
        begin
          State2.TuiAppRouteInput(ApplicationId, State2.TuiAppPopInput(ApplicationId));
          if State2.TuiAppMessageCount(ApplicationId) = 0 then
            begin
              continue;
            end;
          end if;
        end;
      end if;

      if State2.TuiAppMessageCount(ApplicationId) > 0 then
        begin
          Remaining := Remaining - 1;
          Model := TuiLoopApplyFramework(ApplicationId, Model, State2.TuiAppPopMessage(ApplicationId), Update);
          if TuiLoopFinishUpdate(ApplicationId, Model, View, false) then
            begin
              if BackgroundEnabled then
                begin
                  TuiLoopCloseWithInbox(ApplicationId, Inbox);
                end;
              else
                begin
                  TuiLoopClose(ApplicationId);
                end;
              end if;

              return Model;
            end;
          end if;
        end;
      else
        if BackgroundEnabled then
          begin
            case Tasks.TryReceive(Inbox) of
              when Result.Ok(Option.Some(const Message)):
                begin
                  Remaining := Remaining - 1;
                  Model := TuiLoopApplyApplication(ApplicationId, Model, Message, UpdateApplication);
                  if TuiLoopFinishUpdate(ApplicationId, Model, View, false) then
                    begin
                      TuiLoopCloseWithInbox(ApplicationId, Inbox);
                      return Model;
                    end;
                  end if;
                end;
              when Result.Ok(Option.None):
                begin
                  Remaining := Remaining - 1;
                  // The deterministic tick also answers a pending tick request.
                  State2.TuiAppClearTick(ApplicationId);
                  Model := TuiLoopApplyFramework(ApplicationId, Model, Msg2.TuiMsg.Tick(DeltaMilliseconds), Update);
                  if TuiLoopFinishUpdate(ApplicationId, Model, View, false) then
                    begin
                      TuiLoopCloseWithInbox(ApplicationId, Inbox);
                      return Model;
                    end;
                  end if;
                end;
              when Result.Error(const Message):
                panic(Message);
            end case;
          end;
        else
          begin
            Remaining := Remaining - 1;
            // The deterministic tick also answers a pending tick request.
            State2.TuiAppClearTick(ApplicationId);
            Model := TuiLoopApplyFramework(ApplicationId, Model, Msg2.TuiMsg.Tick(DeltaMilliseconds), Update);
            if TuiLoopFinishUpdate(ApplicationId, Model, View, false) then
              begin
                TuiLoopClose(ApplicationId);
                return Model;
              end;
            end if;
          end;
        end if;
      end if;
    end;
  end while;

  return Model;
end function;

// Runs the interactive loop, selecting fairly between Console and application messages.
public function TuiRunInteractive of (TModel, TMessage)(
  ApplicationId: integer;
  InitialModel: TModel;
  Inbox: channel of (TMessage);
  Update: function(State: TModel; Msg: Msg2.TuiMsg; Cmd: Cmd2.TuiCmdOutput): TModel;
  UpdateApplication: function(State: TModel; Message: TMessage; Cmd: Cmd2.TuiCmdOutput): TModel;
  View: function(State: TModel): Element.TuiElement;
  BackgroundEnabled: boolean
): TModel;
begin
  discard State2.TuiAppRequireOpen(ApplicationId);
  const ConsoleInputs: channel of (Input2.TuiHostInput) := Tasks.CreateChannel(32);
  const InputGroup: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const ConsoleInputHandle: task := Tasks.StartTaskInGroup(InputGroup, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
    return ConsoleInput2.TuiConsoleInputPump(Token, ConsoleInputs);
  end function);
  var Model: TModel := InitialModel;
  TuiLoopRender(ApplicationId, View(Model), true);
  if BackgroundEnabled then
    begin
      State2.TuiAppStart(ApplicationId);
    end;
  end if;
  var PreferApplication: boolean := false;
  while State2.TuiAppOpen[ApplicationId - 1] do
    begin
      State2.TuiAppPushMessages(ApplicationId, Background.TuiBackgroundReap(ApplicationId));
      if State2.TuiAppMessageCount(ApplicationId) > 0 then
        begin
          Model := TuiLoopApplyFramework(ApplicationId, Model, State2.TuiAppPopMessage(ApplicationId), Update);
          if TuiLoopFinishUpdate(ApplicationId, Model, View, true) then
            begin
              discard Tasks.CloseTaskGroup(InputGroup);
              discard Tasks.CloseChannel(ConsoleInputs);
              if BackgroundEnabled then
                begin
                  TuiLoopCloseWithInbox(ApplicationId, Inbox);
                end;
              else
                begin
                  TuiLoopClose(ApplicationId);
                end;
              end if;

              return Model;
            end;
          end if;

          continue;
        end;
      end if;

      if State2.TuiAppInputCount(ApplicationId) > 0 then
        begin
          State2.TuiAppRouteInput(ApplicationId, State2.TuiAppPopInput(ApplicationId));
          continue;
        end;
      end if;
      // A due tick is queued like any framework message; a pending one bounds the wait below.
      const TickWait: integer := State2.TuiAppTickWait(ApplicationId);
      if TickWait = 0 then
        begin
          State2.TuiAppPushMessages(ApplicationId, [State2.TuiAppTakeTick(ApplicationId)]);
          continue;
        end;
      end if;
      var ConsoleInput: Option of (Input2.TuiHostInput) := Option.None;
      var ApplicationInput: Option of (TMessage) := Option.None;
      var Cases: array of (Tasks.WaitCase) := [];
      const ConsoleCase: Tasks.WaitCase := Tasks.ReceiveCase(ConsoleInputs, procedure(Outcome: Result of (Input2.TuiHostInput, string)) begin
        case Outcome of
          when Result.Ok(const Input):
            begin
              ConsoleInput := Option.Some(Input);
            end;
          when Result.Error(const Message):
            begin
              null;
            end;
        end case;
      end procedure);
      if BackgroundEnabled then
        begin
          const ApplicationCase: Tasks.WaitCase := Tasks.ReceiveCase(Inbox, procedure(Outcome: Result of (TMessage, string)) begin
            case Outcome of
              when Result.Ok(const Message):
                begin
                  ApplicationInput := Option.Some(Message);
                end;
              when Result.Error(const Failure):
                begin
                  null;
                end;
            end case;
          end procedure);
          if PreferApplication then
            begin
              Arrays.Push(var Cases, ApplicationCase);
              Arrays.Push(var Cases, ConsoleCase);
            end;
          else
            begin
              Arrays.Push(var Cases, ConsoleCase);
              Arrays.Push(var Cases, ApplicationCase);
            end;
          end if;
        end;
      else
        begin
          Arrays.Push(var Cases, ConsoleCase);
        end;
      end if;

      if Background.TuiBackgroundHasWork(ApplicationId) then
        begin
          Arrays.Push(var Cases, Tasks.TimerCase(50, procedure() begin
            null;
          end procedure));
        end;
      end if;

      if TickWait > 0 then
        begin
          Arrays.Push(var Cases, Tasks.TimerCase(TickWait, procedure() begin
            null;
          end procedure));
        end;
      end if;

      discard Tasks.Select(Cases);
      PreferApplication := not PreferApplication;
      case ConsoleInput of
        when Option.Some(const Input):
          begin
            State2.TuiAppRouteInput(ApplicationId, Input);
          end;
        when Option.None:
          begin
            null;
          end;
      end case;

      case ApplicationInput of
        when Option.Some(const Message):
          begin
            Model := TuiLoopApplyApplication(ApplicationId, Model, Message, UpdateApplication);
            if TuiLoopFinishUpdate(ApplicationId, Model, View, true) then
              begin
                discard Tasks.CloseTaskGroup(InputGroup);
                discard Tasks.CloseChannel(ConsoleInputs);
                TuiLoopCloseWithInbox(ApplicationId, Inbox);
                return Model;
              end;
            end if;
          end;
        when Option.None:
          begin
            null;
          end;
      end case;
    end;
  end while;

  discard Tasks.CloseTaskGroup(InputGroup);
  discard Tasks.CloseChannel(ConsoleInputs);
  if BackgroundEnabled then
    begin
      TuiLoopCloseWithInbox(ApplicationId, Inbox);
    end;
  else
    begin
      TuiLoopClose(ApplicationId);
    end;
  end if;

  return Model;
end function;

end unit;
