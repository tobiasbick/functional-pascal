unit Std.Tui.Runtime.Application.Loop;

uses
  Std.Console, Std.Tasks, Std.Tui.Cells.Palette, Std.Tui.Elements.Element,
  Std.Tui.Runtime.Application.Background, Std.Tui.Runtime.Application.ConsoleInput,
  Std.Tui.Runtime.Application.State, Std.Tui.Runtime.Cmd, Std.Tui.Runtime.Frame,
  Std.Tui.Runtime.Input, Std.Tui.Runtime.Msg, Std.Tui.Runtime.Routing.Pointer,
  Std.Tui.Runtime.TerminalRenderer;

procedure TuiLoopRender(ApplicationId: integer; Tree: TuiElement; Present: boolean);
begin
  TuiRenderFrame(TuiAppSurfaces[ApplicationId - 1], TuiAppFrames[ApplicationId - 1], Tree, Std.Tui.Runtime.Routing.Pointer.TuiPointerRoutingPressed(ApplicationId));
  TuiAppTrees[ApplicationId - 1] := Tree;
  if Present then
    begin
      TuiFlushSurface(TuiAppSurfaces[ApplicationId - 1], TuiAppPalettes[ApplicationId - 1]);
    end;
  end if;
end procedure;

function TuiLoopApplyFramework<TModel>(
  ApplicationId: integer;
  Model: TModel;
  Msg: TuiMsg;
  Update: function(State: TModel; Msg: TuiMsg; Cmd: TuiCmdOutput): TModel
): TModel;
begin
  TuiAppApplyResizeIfNeeded(ApplicationId, Msg);
  const Cmd: TuiCmdOutput := TuiAppCommands[ApplicationId - 1];
  Cmd.Reset();
  return Update(Model, Msg, Cmd);
end function;

function TuiLoopApplyApplication<TModel, TMessage>(
  ApplicationId: integer;
  Model: TModel;
  Message: TMessage;
  UpdateApplication: function(State: TModel; Message: TMessage; Cmd: TuiCmdOutput): TModel
): TModel;
begin
  const Cmd: TuiCmdOutput := TuiAppCommands[ApplicationId - 1];
  Cmd.Reset();
  return UpdateApplication(Model, Message, Cmd);
end function;

function TuiLoopFinishUpdate<TModel>(
  ApplicationId: integer;
  Model: TModel;
  View: function(State: TModel): TuiElement;
  Present: boolean
): boolean;
begin
  const Cmd: TuiCmdOutput := TuiAppCommands[ApplicationId - 1];
  if TuiAppApplyCommand(ApplicationId, Cmd) then
    begin
      return true;
    end;
  end if;

  TuiLoopRender(ApplicationId, View(Model), Present);
  return false;
end function;

procedure TuiLoopClose(ApplicationId: integer);
begin
  TuiAppRaiseShutdownFailure(TuiAppCloseApplication(ApplicationId));
end procedure;

procedure TuiLoopCloseWithInbox<TMessage>(ApplicationId: integer; Inbox: channel of TMessage);
begin
  const Failures: array of TuiMsg := TuiAppCloseApplication(ApplicationId);
  discard CloseChannel(Inbox);
  TuiAppRaiseShutdownFailure(Failures);
end procedure;

// Runs a deterministic bounded headless loop with an optional typed inbox.
public function TuiRunHeadless<TModel, TMessage>(
  ApplicationId: integer;
  InitialModel: TModel;
  Inbox: channel of TMessage;
  Update: function(State: TModel; Msg: TuiMsg; Cmd: TuiCmdOutput): TModel;
  UpdateApplication: function(State: TModel; Message: TMessage; Cmd: TuiCmdOutput): TModel;
  View: function(State: TModel): TuiElement;
  IterationCount: integer;
  DeltaMilliseconds: integer;
  BackgroundEnabled: boolean
): TModel;
begin
  discard TuiAppRequireOpen(ApplicationId);
  if IterationCount < 0 then
    begin
      panic('Tui iteration count must not be negative');
    end;
  end if;

  if DeltaMilliseconds < 0 then
    begin
      panic('Tui tick delta must not be negative');
    end;
  end if;
  var Model: TModel := InitialModel;
  TuiLoopRender(ApplicationId, View(Model), false);
  if BackgroundEnabled then
    begin
      TuiAppStart(ApplicationId);
    end;
  end if;
  var Remaining: integer := IterationCount;
  while Remaining > 0 do
    begin
      if not TuiAppOpen[ApplicationId - 1] then
        begin
          return Model;
        end;
      end if;

      TuiAppPushMessages(ApplicationId, TuiBackgroundReap(ApplicationId));
      if (TuiAppMessageCount(ApplicationId) = 0) and (TuiAppInputCount(ApplicationId) > 0) then
        begin
          TuiAppRouteInput(ApplicationId, TuiAppPopInput(ApplicationId));
          if TuiAppMessageCount(ApplicationId) = 0 then
            begin
              continue;
            end;
          end if;
        end;
      end if;

      if TuiAppMessageCount(ApplicationId) > 0 then
        begin
          Remaining := Remaining - 1;
          Model := TuiLoopApplyFramework(ApplicationId, Model, TuiAppPopMessage(ApplicationId), Update);
          if TuiLoopFinishUpdate(ApplicationId, Model, View, false) then
            begin
              if BackgroundEnabled then
                begin
                  TuiLoopCloseWithInbox(ApplicationId, Inbox);
                end;
              else
                begin
                  TuiLoopClose(ApplicationId);
                end;
              end if;

              return Model;
            end;
          end if;
        end;
      elsif BackgroundEnabled then
        begin
          case TryReceive(Inbox).Unwrap() of
            when Some(const Message):
              begin
                Remaining := Remaining - 1;
                Model := TuiLoopApplyApplication(ApplicationId, Model, Message, UpdateApplication);
                if TuiLoopFinishUpdate(ApplicationId, Model, View, false) then
                  begin
                    TuiLoopCloseWithInbox(ApplicationId, Inbox);
                    return Model;
                  end;
                end if;
              end;
            when None:
              begin
                Remaining := Remaining - 1;
                // The deterministic tick also answers a pending tick request.
                TuiAppClearTick(ApplicationId);
                Model := TuiLoopApplyFramework(ApplicationId, Model, TuiMsg.Tick(DeltaMilliseconds), Update);
                if TuiLoopFinishUpdate(ApplicationId, Model, View, false) then
                  begin
                    TuiLoopCloseWithInbox(ApplicationId, Inbox);
                    return Model;
                  end;
                end if;
              end;
          end case;
        end;
      else
        begin
          Remaining := Remaining - 1;
          // The deterministic tick also answers a pending tick request.
          TuiAppClearTick(ApplicationId);
          Model := TuiLoopApplyFramework(ApplicationId, Model, TuiMsg.Tick(DeltaMilliseconds), Update);
          if TuiLoopFinishUpdate(ApplicationId, Model, View, false) then
            begin
              TuiLoopClose(ApplicationId);
              return Model;
            end;
          end if;
        end;
      end if;
    end;
  end while;

  return Model;
end function;

// Runs the interactive loop, selecting fairly between Console and application messages.
public function TuiRunInteractive<TModel, TMessage>(
  ApplicationId: integer;
  InitialModel: TModel;
  Inbox: channel of TMessage;
  Update: function(State: TModel; Msg: TuiMsg; Cmd: TuiCmdOutput): TModel;
  UpdateApplication: function(State: TModel; Message: TMessage; Cmd: TuiCmdOutput): TModel;
  View: function(State: TModel): TuiElement;
  BackgroundEnabled: boolean
): TModel;
begin
  discard TuiAppRequireOpen(ApplicationId);
  const ConsoleInputs: channel of TuiHostInput := CreateChannel(32);
  const InputGroup: TaskGroup := CreateTaskGroup();
  const InputTask: task := StartTaskInGroup(InputGroup, function(Token: CancellationToken): result of boolean, string begin
    return TuiConsoleInputPump(Token, ConsoleInputs);
  end function);
  var Model: TModel := InitialModel;
  TuiLoopRender(ApplicationId, View(Model), true);
  if BackgroundEnabled then
    begin
      TuiAppStart(ApplicationId);
    end;
  end if;
  var PreferApplication: boolean := false;
  while TuiAppOpen[ApplicationId - 1] do
    begin
      TuiAppPushMessages(ApplicationId, TuiBackgroundReap(ApplicationId));
      if TuiAppMessageCount(ApplicationId) > 0 then
        begin
          Model := TuiLoopApplyFramework(ApplicationId, Model, TuiAppPopMessage(ApplicationId), Update);
          if TuiLoopFinishUpdate(ApplicationId, Model, View, true) then
            begin
              discard CloseTaskGroup(InputGroup);
              discard CloseChannel(ConsoleInputs);
              if BackgroundEnabled then
                begin
                  TuiLoopCloseWithInbox(ApplicationId, Inbox);
                end;
              else
                begin
                  TuiLoopClose(ApplicationId);
                end;
              end if;

              return Model;
            end;
          end if;

          continue;
        end;
      end if;

      if TuiAppInputCount(ApplicationId) > 0 then
        begin
          TuiAppRouteInput(ApplicationId, TuiAppPopInput(ApplicationId));
          continue;
        end;
      end if;
      // A due tick is queued like any framework message; a pending one bounds the wait below.
      const TickWait: integer := TuiAppTickWait(ApplicationId);
      if TickWait = 0 then
        begin
          TuiAppPushMessages(ApplicationId, [TuiAppTakeTick(ApplicationId)]);
          continue;
        end;
      end if;
      var ConsoleInput: option of TuiHostInput := None;
      var ApplicationInput: option of TMessage := None;
      var Cases: array of WaitCase := [];
      const ConsoleCase: WaitCase := ReceiveCase(ConsoleInputs, procedure(Outcome: result of TuiHostInput, string) begin
        case Outcome of
          when Ok(const Input):
            begin
              ConsoleInput := Some(Input);
            end;
          when Error(const Message):
            begin
            end;
        end case;
      end procedure);
      if BackgroundEnabled then
        begin
          const ApplicationCase: WaitCase := ReceiveCase(Inbox, procedure(Outcome: result of TMessage, string) begin
            case Outcome of
              when Ok(const Message):
                begin
                  ApplicationInput := Some(Message);
                end;
              when Error(const Failure):
                begin
                end;
            end case;
          end procedure);
          if PreferApplication then
            begin
              Cases.Push(ApplicationCase);
              Cases.Push(ConsoleCase);
            end;
          else
            begin
              Cases.Push(ConsoleCase);
              Cases.Push(ApplicationCase);
            end;
          end if;
        end;
      else
        begin
          Cases.Push(ConsoleCase);
        end;
      end if;

      if TuiBackgroundHasWork(ApplicationId) then
        begin
          Cases.Push(TimerCase(50, procedure() begin end procedure));
        end;
      end if;

      if TickWait > 0 then
        begin
          Cases.Push(TimerCase(TickWait, procedure() begin end procedure));
        end;
      end if;

      discard Select(Cases);
      PreferApplication := not PreferApplication;
      case ConsoleInput of
        when Some(const Input):
          begin
            TuiAppRouteInput(ApplicationId, Input);
          end;
        when None:
          begin
          end;
      end case;

      case ApplicationInput of
        when Some(const Message):
          begin
            Model := TuiLoopApplyApplication(ApplicationId, Model, Message, UpdateApplication);
            if TuiLoopFinishUpdate(ApplicationId, Model, View, true) then
              begin
                discard CloseTaskGroup(InputGroup);
                discard CloseChannel(ConsoleInputs);
                TuiLoopCloseWithInbox(ApplicationId, Inbox);
                return Model;
              end;
            end if;
          end;
        when None:
          begin
          end;
      end case;
    end;
  end while;

  discard CloseTaskGroup(InputGroup);
  discard CloseChannel(ConsoleInputs);
  if BackgroundEnabled then
    begin
      TuiLoopCloseWithInbox(ApplicationId, Inbox);
    end;
  else
    begin
      TuiLoopClose(ApplicationId);
    end;
  end if;

  return Model;
end function;
end unit;
