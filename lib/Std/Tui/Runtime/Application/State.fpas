unit Std.Tui.Runtime.Application.State;

uses
  Std.Tui.Cells.Palette, Std.Tui.Elements.Element, Std.Tui.Geometry.Size, Std.Tui.Layout.Frame,
  Std.Tui.Rendering.Surface, Std.Tui.Runtime.Application.Background, Std.Tui.Runtime.Cmd,
  Std.Tui.Runtime.Input, Std.Tui.Runtime.Msg, Std.Tui.Runtime.Routing,
  Std.Tui.Runtime.Routing.Pointer, Std.Tui.Runtime.TerminalSession, Std.Time;

public var TuiAppInputHead: array of integer := [];
public var TuiAppMessageHead: array of integer := [];
public var TuiAppOpen: array of boolean := [];
public var TuiAppInputs: array of array of TuiHostInput := [];
public var TuiAppMessages: array of array of TuiMsg := [];
public var TuiAppSurfaces: array of TuiWorkingSurface := [];
public var TuiAppFrames: array of TuiArrangedFrame := [];
public var TuiAppTrees: array of TuiElement := [];
public var TuiAppCommands: array of TuiCmdOutput := [];
public var TuiAppInteractive: array of boolean := [];
public var TuiAppPalettes: array of TuiPalette := [];
public var TuiAppStarted: array of boolean := [];
// Monotonic time of the pending tick request and its due time; negative due means none.
public var TuiAppTickRequestedAt: array of integer := [];
public var TuiAppTickDueAt: array of integer := [];

// Opens application-owned state and returns its stable identifier.
public function TuiAppOpenApplication(Size: TuiSize; Palette: TuiPalette; Interactive: boolean): integer;
begin
  TuiAppInputHead.Push(0);
  TuiAppMessageHead.Push(0);
  TuiAppOpen := TuiAppOpen.Concat([true]);
  TuiAppInputs := TuiAppInputs.Concat([[]]);
  TuiAppMessages := TuiAppMessages.Concat([[]]);
  TuiAppSurfaces := TuiAppSurfaces.Concat([TuiWorkingSurface.Create(Size)]);
  TuiAppFrames := TuiAppFrames.Concat([TuiArrangedFrame.Create()]);
  TuiAppTrees := TuiAppTrees.Concat([TuiElement.Empty]);
  TuiAppCommands := TuiAppCommands.Concat([TuiCmdOutput.Create()]);
  TuiAppInteractive := TuiAppInteractive.Concat([Interactive]);
  TuiAppPalettes := TuiAppPalettes.Concat([Palette]);
  TuiAppStarted := TuiAppStarted.Concat([false]);
  TuiAppTickRequestedAt := TuiAppTickRequestedAt.Concat([0]);
  TuiAppTickDueAt := TuiAppTickDueAt.Concat([-1]);
  TuiBackgroundOpenApplication();
  Std.Tui.Runtime.Routing.Pointer.TuiPointerRoutingOpen();
  return TuiAppOpen.Length();
end function;

// Cancels owned work, closes application state, and returns shutdown failures.
public function TuiAppCloseApplication(ApplicationId: integer): array of TuiMsg;
begin
  if (ApplicationId < 1) or (ApplicationId > TuiAppOpen.Length()) then
    begin
      return [];
    end;
  end if;

  if not TuiAppOpen[ApplicationId - 1] then
    begin
      return [];
    end;
  end if;
  const BackgroundFailures: array of TuiMsg := TuiBackgroundCloseApplication(ApplicationId);
  TuiAppOpen[ApplicationId - 1] := false;
  TuiAppInputHead[ApplicationId - 1] := 0;
  TuiAppMessageHead[ApplicationId - 1] := 0;
  TuiAppInputs[ApplicationId - 1] := [];
  TuiAppMessages[ApplicationId - 1] := [];
  Std.Tui.Runtime.Routing.Pointer.TuiPointerRoutingClose(ApplicationId);
  if TuiAppInteractive[ApplicationId - 1] then
    begin
      TuiAppInteractive[ApplicationId - 1] := false;
      TuiTerminalSessionRelease();
    end;
  end if;

  return BackgroundFailures;
end function;

// Raises the first shutdown failure after application resources have been released.
public procedure TuiAppRaiseShutdownFailure(Failures: array of TuiMsg);
begin
  if Failures.Length() = 0 then
    begin
      return;
    end;
  end if;

  case Failures[0] of
    when TuiMsg.BackgroundFailed(const IgnoredId, const Kind, const Message, const Code, const Line, const Column):
      begin
        panic(Message);
      end;
    else
      begin
        panic('Tui background operation failed during shutdown');
      end;
  end case;
end procedure;

public function TuiAppRequireHandle(ApplicationId: integer): integer;
begin
  if (ApplicationId < 1) or (ApplicationId > TuiAppOpen.Length()) then
    begin
      panic('Tui application handle is stale');
    end;
  end if;

  return ApplicationId;
end function;

public function TuiAppRequireOpen(ApplicationId: integer): integer;
begin
  discard TuiAppRequireHandle(ApplicationId);
  if not TuiAppOpen[ApplicationId - 1] then
    begin
      panic('Tui application is closed');
    end;
  end if;

  return ApplicationId;
end function;

// Returns the number of unread inputs for one application.
public function TuiAppInputCount(ApplicationId: integer): integer;
begin
  return TuiAppInputs[ApplicationId - 1].Length() - TuiAppInputHead[ApplicationId - 1];
end function;

// Removes the next queued input, compacting only after at least half is consumed.
public function TuiAppPopInput(ApplicationId: integer): TuiHostInput;
begin
  const Slot: integer := ApplicationId - 1;
  const Head: integer := TuiAppInputHead[Slot];
  const Item: TuiHostInput := TuiAppInputs[Slot][Head];
  const Next: integer := Head + 1;
  const Count: integer := TuiAppInputs[Slot].Length();
  if (Next = Count) or ((Next >= 64) and (Next >= Count div 2)) then
    begin
      TuiAppInputs[Slot] := TuiAppInputs[Slot].Slice(Next, Count - Next);
      TuiAppInputHead[Slot] := 0;
    end;
  else
    begin
      TuiAppInputHead[Slot] := Next;
    end;
  end if;

  return Item;
end function;

// Returns the number of unread messages for one application.
public function TuiAppMessageCount(ApplicationId: integer): integer;
begin
  return TuiAppMessages[ApplicationId - 1].Length() - TuiAppMessageHead[ApplicationId - 1];
end function;

// Removes the next queued message, compacting only after at least half is consumed.
public function TuiAppPopMessage(ApplicationId: integer): TuiMsg;
begin
  const Slot: integer := ApplicationId - 1;
  const Head: integer := TuiAppMessageHead[Slot];
  const Item: TuiMsg := TuiAppMessages[Slot][Head];
  const Next: integer := Head + 1;
  const Count: integer := TuiAppMessages[Slot].Length();
  if (Next = Count) or ((Next >= 64) and (Next >= Count div 2)) then
    begin
      TuiAppMessages[Slot] := TuiAppMessages[Slot].Slice(Next, Count - Next);
      TuiAppMessageHead[Slot] := 0;
    end;
  else
    begin
      TuiAppMessageHead[Slot] := Next;
    end;
  end if;

  return Item;
end function;

// Enqueues messages in their original order.
public procedure TuiAppPushMessages(ApplicationId: integer; Messages: array of TuiMsg);
begin
  var Queue: array of TuiMsg := TuiAppMessages[ApplicationId - 1];
  TuiAppMessages[ApplicationId - 1] := [];
  for Item: TuiMsg in Messages do
    begin
      Queue.Push(Item);
    end;
  end for;

  TuiAppMessages[ApplicationId - 1] := Queue;
end procedure;

// Enqueues one input for the application.
public procedure TuiAppPushInput(ApplicationId: integer; Input: TuiHostInput);
begin
  var Queue: array of TuiHostInput := TuiAppInputs[ApplicationId - 1];
  TuiAppInputs[ApplicationId - 1] := [];
  Queue.Push(Input);
  TuiAppInputs[ApplicationId - 1] := Queue;
end procedure;

// Queues Started exactly once for a background-enabled host.
public procedure TuiAppStart(ApplicationId: integer);
begin
  discard TuiAppRequireOpen(ApplicationId);
  if not TuiAppStarted[ApplicationId - 1] then
    begin
      TuiAppStarted[ApplicationId - 1] := true;
      TuiAppPushMessages(ApplicationId, [TuiMsg.Started]);
    end;
  end if;
end procedure;

public procedure TuiAppApplyResize(ApplicationId: integer; Size: TuiSize);
begin
  TuiAppSurfaces[ApplicationId - 1].Resize(Size);
end procedure;

public procedure TuiAppRouteInput(ApplicationId: integer; Input: TuiHostInput);
begin
  case Input of
    when TuiHostInput.Message(const InputMsg):
      begin
        TuiAppPushMessages(ApplicationId, [InputMsg]);
      end;
    when TuiHostInput.Key(const Key):
      begin
        TuiAppPushMessages(ApplicationId, TuiRouteKey(TuiAppTrees[ApplicationId - 1], TuiAppFrames[ApplicationId -
                                                                                                   1], Key));
      end;
    when TuiHostInput.Pointer(const Pointer):
      begin
        TuiAppPushMessages(ApplicationId, Std.Tui.Runtime.Routing.Pointer.TuiRouteApplicationPointer(Pointer, ApplicationId, TuiAppTrees[ApplicationId -
                                                                                                                                         1], TuiAppFrames[ApplicationId -
                                                                                                                                                          1]));
      end;
    when TuiHostInput.Resize(const Size):
      begin
        TuiAppPushMessages(ApplicationId, [TuiMsg.Resize(Size)]);
      end;
  end case;
end procedure;

public procedure TuiAppApplyResizeIfNeeded(ApplicationId: integer; Msg: TuiMsg);
begin
  case Msg of
    when TuiMsg.Resize(const Size):
      begin
        TuiAppApplyResize(ApplicationId, Size);
      end;
    else
      begin
      end;
  end case;
end procedure;

public function TuiAppApplyCommand(ApplicationId: integer; Output: TuiCmdOutput): boolean;
begin
  case Output.Command() of
    when TuiCmd.NoCommand:
      begin
      end;
    when TuiCmd.Quit:
      begin
        return true;
      end;
    when TuiCmd.SetPalette:
      begin
        case Output.ReadPalette() of
          when Some(const Palette):
            begin
              TuiAppPalettes[ApplicationId - 1] := Palette;
            end;
          when None:
            begin
              panic('Tui SetPalette command requires a palette');
            end;
        end case;

        TuiSurfaceInvalidateTerminal(TuiAppSurfaces[ApplicationId - 1]);
      end;
  end case;

  case Output.ReadTickRequest() of
    when Some(const Delay):
      begin
        const Now: integer := MonotonicMillis();
        TuiAppTickRequestedAt[ApplicationId - 1] := Now;
        TuiAppTickDueAt[ApplicationId - 1] := Now + Delay;
      end;
    when None:
      begin
      end;
  end case;

  TuiAppPushMessages(ApplicationId, TuiBackgroundApply(ApplicationId, Output.ReadBackground()));
  return false;
end function;

// Returns milliseconds until the pending tick is due: 0 when due, -1 without a pending tick.
public function TuiAppTickWait(ApplicationId: integer): integer;
begin
  const Due: integer := TuiAppTickDueAt[ApplicationId - 1];
  if Due < 0 then
    begin
      return -1;
    end;
  end if;
  const Remaining: integer := Due - MonotonicMillis();
  if Remaining < 0 then
    begin
      return 0;
    end;
  end if;

  return Remaining;
end function;

// Clears the pending tick and returns it with the milliseconds elapsed since its request.
public function TuiAppTakeTick(ApplicationId: integer): TuiMsg;
begin
  TuiAppTickDueAt[ApplicationId - 1] := -1;
  return TuiMsg.Tick(ElapsedMillis(TuiAppTickRequestedAt[ApplicationId - 1]));
end function;

// Discards a pending tick request; headless runs deliver their own deterministic ticks.
public procedure TuiAppClearTick(ApplicationId: integer);
begin
  TuiAppTickDueAt[ApplicationId - 1] := -1;
end procedure;
end unit;
