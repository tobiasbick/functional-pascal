unit Std.Tui.Runtime.Application.State;

uses
  Std.Tui.Cells.Palette as CellsPalette, Std.Tui.Elements.Element as Element,
  Std.Tui.Geometry.Size as GeometrySize, Std.Tui.Layout.Frame as Frame,
  Std.Tui.Rendering.Surface as Surface, Std.Tui.Runtime.Application.Background as Background,
  Std.Tui.Runtime.Cmd as Cmd, Std.Tui.Runtime.Input as RuntimeInput,
  Std.Tui.Runtime.Msg as RuntimeMsg, Std.Tui.Runtime.Routing as Routing,
  Std.Tui.Runtime.Routing.Pointer as RoutingPointer,
  Std.Tui.Runtime.TerminalSession as TerminalSession, Std.Time as Time;

public var TuiAppInputHead: array of integer := [];
public var TuiAppMessageHead: array of integer := [];
public var TuiAppOpen: array of boolean := [];
public var TuiAppInputs: array of array of RuntimeInput.TuiHostInput := [];
public var TuiAppMessages: array of array of RuntimeMsg.TuiMsg := [];
public var TuiAppSurfaces: array of Surface.TuiWorkingSurface := [];
public var TuiAppFrames: array of Frame.TuiArrangedFrame := [];
public var TuiAppTrees: array of Element.TuiElement := [];
public var TuiAppCommands: array of Cmd.TuiCmdOutput := [];
public var TuiAppInteractive: array of boolean := [];
public var TuiAppPalettes: array of CellsPalette.TuiPalette := [];
public var TuiAppStarted: array of boolean := [];
// Monotonic time of the pending tick request and its due time; negative due means none.
public var TuiAppTickRequestedAt: array of integer := [];
public var TuiAppTickDueAt: array of integer := [];

// Opens application-owned state and returns its stable identifier.
public function TuiAppOpenApplication(
  Size: GeometrySize.TuiSize;
  Palette: CellsPalette.TuiPalette;
  Interactive: boolean
): integer;
begin
  TuiAppInputHead.PushInPlace(0);
  TuiAppMessageHead.PushInPlace(0);
  TuiAppOpen := TuiAppOpen.Concat([true]);
  TuiAppInputs := TuiAppInputs.Concat([[]]);
  TuiAppMessages := TuiAppMessages.Concat([[]]);
  TuiAppSurfaces := TuiAppSurfaces.Concat([Surface.TuiWorkingSurface.Create(Size)]);
  TuiAppFrames := TuiAppFrames.Concat([Frame.TuiArrangedFrame.Create()]);
  TuiAppTrees := TuiAppTrees.Concat([Element.TuiElement.Empty]);
  TuiAppCommands := TuiAppCommands.Concat([Cmd.TuiCmdOutput.Create()]);
  TuiAppInteractive := TuiAppInteractive.Concat([Interactive]);
  TuiAppPalettes := TuiAppPalettes.Concat([Palette]);
  TuiAppStarted := TuiAppStarted.Concat([false]);
  TuiAppTickRequestedAt := TuiAppTickRequestedAt.Concat([0]);
  TuiAppTickDueAt := TuiAppTickDueAt.Concat([-1]);
  Background.TuiBackgroundOpenApplication();
  RoutingPointer.TuiPointerRoutingOpen();
  return TuiAppOpen.Length();
end function;

// Cancels owned work, closes application state, and returns shutdown failures.
public function TuiAppCloseApplication(ApplicationId: integer): array of RuntimeMsg.TuiMsg;
begin
  if (ApplicationId < 1) or (ApplicationId > TuiAppOpen.Length()) then
    begin
      return [];
    end;
  end if;

  if not TuiAppOpen[ApplicationId - 1] then
    begin
      return [];
    end;
  end if;
  const BackgroundFailures: array of RuntimeMsg.TuiMsg := Background.TuiBackgroundCloseApplication(ApplicationId);
  TuiAppOpen[ApplicationId - 1] := false;
  TuiAppInputHead[ApplicationId - 1] := 0;
  TuiAppMessageHead[ApplicationId - 1] := 0;
  TuiAppInputs[ApplicationId - 1] := [];
  TuiAppMessages[ApplicationId - 1] := [];
  RoutingPointer.TuiPointerRoutingClose(ApplicationId);
  if TuiAppInteractive[ApplicationId - 1] then
    begin
      TuiAppInteractive[ApplicationId - 1] := false;
      TerminalSession.TuiTerminalSessionRelease();
    end;
  end if;

  return BackgroundFailures;
end function;

// Raises the first shutdown failure after application resources have been released.
public procedure TuiAppRaiseShutdownFailure(Failures: array of RuntimeMsg.TuiMsg);
begin
  if Failures.Length() = 0 then
    begin
      return;
    end;
  end if;

  case Failures[0] of
    when RuntimeMsg.TuiMsg.BackgroundFailed(const IgnoredId, const Kind, const Message, const Code, const Line, const Column):
      begin
        panic(Message);
      end;
    when RuntimeMsg.TuiMsg.Started, RuntimeMsg.TuiMsg.Key(_), RuntimeMsg.TuiMsg.Pointer(_), RuntimeMsg.TuiMsg.Tick(_), RuntimeMsg.TuiMsg.Resize(_), RuntimeMsg.TuiMsg.FocusChanged(_, _), RuntimeMsg.TuiMsg.Action(_, _), RuntimeMsg.TuiMsg.TextChanged(_, _, _, _), RuntimeMsg.TuiMsg.TextAreaChanged(_, _, _, _, _), RuntimeMsg.TuiMsg.CheckChanged(_, _, _), RuntimeMsg.TuiMsg.SelectionChanged(_, _, _), RuntimeMsg.TuiMsg.ScrollChanged(_, _, _), RuntimeMsg.TuiMsg.MenuChanged(_, _, _), RuntimeMsg.TuiMsg.QuitRequested:
      begin
        panic('Tui background operation failed during shutdown');
      end;
  end case;
end procedure;

public function TuiAppRequireHandle(ApplicationId: integer): integer;
begin
  if (ApplicationId < 1) or (ApplicationId > TuiAppOpen.Length()) then
    begin
      panic('Tui application handle is stale');
    end;
  end if;

  return ApplicationId;
end function;

public function TuiAppRequireOpen(ApplicationId: integer): integer;
begin
  discard TuiAppRequireHandle(ApplicationId);
  if not TuiAppOpen[ApplicationId - 1] then
    begin
      panic('Tui application is closed');
    end;
  end if;

  return ApplicationId;
end function;

// Returns the number of unread inputs for one application.
public function TuiAppInputCount(ApplicationId: integer): integer;
begin
  return TuiAppInputs[ApplicationId - 1].Length() - TuiAppInputHead[ApplicationId - 1];
end function;

// Removes the next queued input, compacting only after at least half is consumed.
public function TuiAppPopInput(ApplicationId: integer): RuntimeInput.TuiHostInput;
begin
  const Slot: integer := ApplicationId - 1;
  const Head: integer := TuiAppInputHead[Slot];
  const Item: RuntimeInput.TuiHostInput := TuiAppInputs[Slot][Head];
  const Next: integer := Head + 1;
  const Count: integer := TuiAppInputs[Slot].Length();
  if (Next = Count) or ((Next >= 64) and (Next >= Count div 2)) then
    begin
      TuiAppInputs[Slot] := TuiAppInputs[Slot].Slice(Next, Count - Next);
      TuiAppInputHead[Slot] := 0;
    end;
  else
    begin
      TuiAppInputHead[Slot] := Next;
    end;
  end if;

  return Item;
end function;

// Returns the number of unread messages for one application.
public function TuiAppMessageCount(ApplicationId: integer): integer;
begin
  return TuiAppMessages[ApplicationId - 1].Length() - TuiAppMessageHead[ApplicationId - 1];
end function;

// Removes the next queued message, compacting only after at least half is consumed.
public function TuiAppPopMessage(ApplicationId: integer): RuntimeMsg.TuiMsg;
begin
  const Slot: integer := ApplicationId - 1;
  const Head: integer := TuiAppMessageHead[Slot];
  const Item: RuntimeMsg.TuiMsg := TuiAppMessages[Slot][Head];
  const Next: integer := Head + 1;
  const Count: integer := TuiAppMessages[Slot].Length();
  if (Next = Count) or ((Next >= 64) and (Next >= Count div 2)) then
    begin
      TuiAppMessages[Slot] := TuiAppMessages[Slot].Slice(Next, Count - Next);
      TuiAppMessageHead[Slot] := 0;
    end;
  else
    begin
      TuiAppMessageHead[Slot] := Next;
    end;
  end if;

  return Item;
end function;

// Enqueues messages in their original order.
public procedure TuiAppPushMessages(ApplicationId: integer; Messages: array of RuntimeMsg.TuiMsg);
begin
  var Queue: array of RuntimeMsg.TuiMsg := TuiAppMessages[ApplicationId - 1];
  TuiAppMessages[ApplicationId - 1] := [];
  for Item: RuntimeMsg.TuiMsg in Messages do
    begin
      Queue.PushInPlace(Item);
    end;
  end for;

  TuiAppMessages[ApplicationId - 1] := Queue;
end procedure;

// Enqueues one input for the application.
public procedure TuiAppPushInput(ApplicationId: integer; Input: RuntimeInput.TuiHostInput);
begin
  var Queue: array of RuntimeInput.TuiHostInput := TuiAppInputs[ApplicationId - 1];
  TuiAppInputs[ApplicationId - 1] := [];
  Queue.PushInPlace(Input);
  TuiAppInputs[ApplicationId - 1] := Queue;
end procedure;

// Queues Started exactly once for a background-enabled host.
public procedure TuiAppStart(ApplicationId: integer);
begin
  discard TuiAppRequireOpen(ApplicationId);
  if not TuiAppStarted[ApplicationId - 1] then
    begin
      TuiAppStarted[ApplicationId - 1] := true;
      TuiAppPushMessages(ApplicationId, [RuntimeMsg.TuiMsg.Started]);
    end;
  end if;
end procedure;

public procedure TuiAppApplyResize(ApplicationId: integer; Size: GeometrySize.TuiSize);
begin
  TuiAppSurfaces[ApplicationId - 1].Resize(Size);
end procedure;

public procedure TuiAppRouteInput(ApplicationId: integer; Input: RuntimeInput.TuiHostInput);
begin
  case Input of
    when RuntimeInput.TuiHostInput.Message(const InputMsg):
      begin
        TuiAppPushMessages(ApplicationId, [InputMsg]);
      end;
    when RuntimeInput.TuiHostInput.Key(const Key):
      begin
        TuiAppPushMessages(ApplicationId, Routing.TuiRouteKey(TuiAppTrees[ApplicationId - 1], TuiAppFrames[ApplicationId -
                                                                                                           1], Key));
      end;
    when RuntimeInput.TuiHostInput.Pointer(const Pointer):
      begin
        TuiAppPushMessages(ApplicationId, RoutingPointer.TuiRouteApplicationPointer(Pointer, ApplicationId, TuiAppTrees[ApplicationId -
                                                                                                                        1], TuiAppFrames[ApplicationId -
                                                                                                                                         1]));
      end;
    when RuntimeInput.TuiHostInput.Resize(const Size):
      begin
        TuiAppPushMessages(ApplicationId, [RuntimeMsg.TuiMsg.Resize(Size)]);
      end;
  end case;
end procedure;

public procedure TuiAppApplyResizeIfNeeded(ApplicationId: integer; Msg: RuntimeMsg.TuiMsg);
begin
  case Msg of
    when RuntimeMsg.TuiMsg.Resize(const Size):
      begin
        TuiAppApplyResize(ApplicationId, Size);
      end;
    when RuntimeMsg.TuiMsg.Started, RuntimeMsg.TuiMsg.Key(_), RuntimeMsg.TuiMsg.Pointer(_), RuntimeMsg.TuiMsg.Tick(_), RuntimeMsg.TuiMsg.FocusChanged(_, _), RuntimeMsg.TuiMsg.Action(_, _), RuntimeMsg.TuiMsg.TextChanged(_, _, _, _), RuntimeMsg.TuiMsg.TextAreaChanged(_, _, _, _, _), RuntimeMsg.TuiMsg.CheckChanged(_, _, _), RuntimeMsg.TuiMsg.SelectionChanged(_, _, _), RuntimeMsg.TuiMsg.ScrollChanged(_, _, _), RuntimeMsg.TuiMsg.MenuChanged(_, _, _), RuntimeMsg.TuiMsg.BackgroundFailed(_, _, _, _, _, _), RuntimeMsg.TuiMsg.QuitRequested:
      null;
  end case;
end procedure;

public function TuiAppApplyCommand(ApplicationId: integer; Output: Cmd.TuiCmdOutput): boolean;
begin
  case Output.Command() of
    when Cmd.TuiCmd.NoCommand:
      begin
      end;
    when Cmd.TuiCmd.Quit:
      begin
        return true;
      end;
    when Cmd.TuiCmd.SetPalette:
      begin
        case Output.ReadPalette() of
          when Some(const Palette):
            begin
              TuiAppPalettes[ApplicationId - 1] := Palette;
            end;
          when None:
            begin
              panic('Tui SetPalette command requires a palette');
            end;
        end case;

        Surface.TuiSurfaceInvalidateTerminal(TuiAppSurfaces[ApplicationId - 1]);
      end;
  end case;

  case Output.ReadTickRequest() of
    when Some(const Delay):
      begin
        const Now: integer := Time.MonotonicMillis();
        TuiAppTickRequestedAt[ApplicationId - 1] := Now;
        TuiAppTickDueAt[ApplicationId - 1] := Now + Delay;
      end;
    when None:
      begin
      end;
  end case;

  TuiAppPushMessages(ApplicationId, Background.TuiBackgroundApply(ApplicationId, Output.ReadBackground()));
  return false;
end function;

// Returns milliseconds until the pending tick is due: 0 when due, -1 without a pending tick.
public function TuiAppTickWait(ApplicationId: integer): integer;
begin
  const Due: integer := TuiAppTickDueAt[ApplicationId - 1];
  if Due < 0 then
    begin
      return -1;
    end;
  end if;
  const Remaining: integer := Due - Time.MonotonicMillis();
  if Remaining < 0 then
    begin
      return 0;
    end;
  end if;

  return Remaining;
end function;

// Clears the pending tick and returns it with the milliseconds elapsed since its request.
public function TuiAppTakeTick(ApplicationId: integer): RuntimeMsg.TuiMsg;
begin
  TuiAppTickDueAt[ApplicationId - 1] := -1;
  return RuntimeMsg.TuiMsg.Tick(Time.ElapsedMillis(TuiAppTickRequestedAt[ApplicationId - 1]));
end function;

// Discards a pending tick request; headless runs deliver their own deterministic ticks.
public procedure TuiAppClearTick(ApplicationId: integer);
begin
  TuiAppTickDueAt[ApplicationId - 1] := -1;
end procedure;
end unit;
