unit Std.Tui.Runtime.Application.State;

uses
  Std.Arrays, Std.Options, Std.Tui.Cells.Palette, Std.Tui.Elements.Element, Std.Tui.Geometry.Size,
  Std.Tui.Layout.Frame, Std.Tui.Rendering.Surface, Std.Tui.Runtime.Application.Background,
  Std.Tui.Runtime.Cmd, Std.Tui.Runtime.Input, Std.Tui.Runtime.Msg, Std.Tui.Runtime.Routing,
  Std.Tui.Runtime.Routing.Pointer, Std.Tui.Runtime.TerminalSession;

public mutable var
  TuiAppInputHead: array of integer := [];
  TuiAppMessageHead: array of integer := [];
  TuiAppOpen: array of boolean := [];
  TuiAppInputs: array of array of TuiHostInput := [];
  TuiAppMessages: array of array of TuiMsg := [];
  TuiAppSurfaces: array of TuiWorkingSurface := [];
  TuiAppFrames: array of TuiArrangedFrame := [];
  TuiAppTrees: array of TuiElement := [];
  TuiAppCommands: array of TuiCmdOutput := [];
  TuiAppInteractive: array of boolean := [];
  TuiAppPalettes: array of TuiPalette := [];
  TuiAppStarted: array of boolean := [];

// Opens application-owned state and returns its stable identifier.
public function TuiAppOpenApplication(Size: TuiSize; Palette: TuiPalette; Interactive: boolean): integer;
begin
  Std.Arrays.Push(TuiAppInputHead, 0);
  Std.Arrays.Push(TuiAppMessageHead, 0);
  TuiAppOpen := Std.Arrays.Concat(TuiAppOpen, [true]);
  TuiAppInputs := Std.Arrays.Concat(TuiAppInputs, [[]]);
  TuiAppMessages := Std.Arrays.Concat(TuiAppMessages, [[]]);
  TuiAppSurfaces := Std.Arrays.Concat(TuiAppSurfaces, [TuiWorkingSurface.Create(Size)]);
  TuiAppFrames := Std.Arrays.Concat(TuiAppFrames, [TuiArrangedFrame.Create()]);
  TuiAppTrees := Std.Arrays.Concat(TuiAppTrees, [TuiElement.Empty]);
  TuiAppCommands := Std.Arrays.Concat(TuiAppCommands, [TuiCmdOutput.Create()]);
  TuiAppInteractive := Std.Arrays.Concat(TuiAppInteractive, [Interactive]);
  TuiAppPalettes := Std.Arrays.Concat(TuiAppPalettes, [Palette]);
  TuiAppStarted := Std.Arrays.Concat(TuiAppStarted, [false]);
  TuiBackgroundOpenApplication();
  Std.Tui.Runtime.Routing.Pointer.TuiPointerRoutingOpen();
  return Std.Arrays.Length(TuiAppOpen)
end;

// Cancels owned work, closes application state, and returns shutdown failures.
public function TuiAppCloseApplication(ApplicationId: integer): array of TuiMsg;
begin
  if (ApplicationId < 1) or (ApplicationId > Std.Arrays.Length(TuiAppOpen)) then
  begin
    return []
  end;

  if not TuiAppOpen[ApplicationId - 1] then
  begin
    return []
  end;
  var BackgroundFailures: array of TuiMsg := TuiBackgroundCloseApplication(ApplicationId);
  TuiAppOpen[ApplicationId - 1] := false;
  TuiAppInputHead[ApplicationId - 1] := 0;
  TuiAppMessageHead[ApplicationId - 1] := 0;
  TuiAppInputs[ApplicationId - 1] := [];
  TuiAppMessages[ApplicationId - 1] := [];
  Std.Tui.Runtime.Routing.Pointer.TuiPointerRoutingClose(ApplicationId);
  if TuiAppInteractive[ApplicationId - 1] then
  begin
    TuiAppInteractive[ApplicationId - 1] := false;
    TuiTerminalSessionRelease()
  end;

  return BackgroundFailures
end;

// Raises the first shutdown failure after application resources have been released.
public procedure TuiAppRaiseShutdownFailure(Failures: array of TuiMsg);
begin
  if Std.Arrays.Length(Failures) = 0 then
  begin
    return
  end;

  case Failures[0] of
    TuiMsg.BackgroundFailed(IgnoredId, Kind, Message, Code, Line, Column):
    begin
      panic(Message)
    end
    else
    begin
      panic('Tui background operation failed during shutdown')
    end
  end
end;

public function TuiAppRequireHandle(ApplicationId: integer): integer;
begin
  if (ApplicationId < 1) or (ApplicationId > Std.Arrays.Length(TuiAppOpen)) then
  begin
    panic('Tui application handle is stale')
  end;

  return ApplicationId
end;

public function TuiAppRequireOpen(ApplicationId: integer): integer;
begin
  TuiAppRequireHandle(ApplicationId);
  if not TuiAppOpen[ApplicationId - 1] then
  begin
    panic('Tui application is closed')
  end;

  return ApplicationId
end;

// Returns the number of unread inputs for one application.
public function TuiAppInputCount(ApplicationId: integer): integer;
begin
  return Std.Arrays.Length(TuiAppInputs[ApplicationId - 1]) - TuiAppInputHead[ApplicationId - 1]
end;

// Removes the next queued input, compacting only after at least half is consumed.
public function TuiAppPopInput(ApplicationId: integer): TuiHostInput;
begin
  var Slot: integer := ApplicationId - 1;
  var Head: integer := TuiAppInputHead[Slot];
  var Item: TuiHostInput := TuiAppInputs[Slot][Head];
  var Next: integer := Head + 1;
  var Count: integer := Std.Arrays.Length(TuiAppInputs[Slot]);
  if (Next = Count) or ((Next >= 64) and (Next >= Count div 2)) then
  begin
    TuiAppInputs[Slot] := Std.Arrays.Slice(TuiAppInputs[Slot], Next, Count - Next);
    TuiAppInputHead[Slot] := 0
  end
  else
  begin
    TuiAppInputHead[Slot] := Next
  end;

  return Item
end;

// Returns the number of unread messages for one application.
public function TuiAppMessageCount(ApplicationId: integer): integer;
begin
  return Std.Arrays.Length(TuiAppMessages[ApplicationId - 1]) - TuiAppMessageHead[ApplicationId - 1]
end;

// Removes the next queued message, compacting only after at least half is consumed.
public function TuiAppPopMessage(ApplicationId: integer): TuiMsg;
begin
  var Slot: integer := ApplicationId - 1;
  var Head: integer := TuiAppMessageHead[Slot];
  var Item: TuiMsg := TuiAppMessages[Slot][Head];
  var Next: integer := Head + 1;
  var Count: integer := Std.Arrays.Length(TuiAppMessages[Slot]);
  if (Next = Count) or ((Next >= 64) and (Next >= Count div 2)) then
  begin
    TuiAppMessages[Slot] := Std.Arrays.Slice(TuiAppMessages[Slot], Next, Count - Next);
    TuiAppMessageHead[Slot] := 0
  end
  else
  begin
    TuiAppMessageHead[Slot] := Next
  end;

  return Item
end;

// Enqueues messages in their original order.
public procedure TuiAppPushMessages(ApplicationId: integer; Messages: array of TuiMsg);
begin
  mutable var Queue: array of TuiMsg := TuiAppMessages[ApplicationId - 1];
  TuiAppMessages[ApplicationId - 1] := [];
  for Item: TuiMsg in Messages do
  begin
    Std.Arrays.Push(Queue, Item)
  end;

  TuiAppMessages[ApplicationId - 1] := Queue
end;

// Enqueues one input for the application.
public procedure TuiAppPushInput(ApplicationId: integer; Input: TuiHostInput);
begin
  mutable var Queue: array of TuiHostInput := TuiAppInputs[ApplicationId - 1];
  TuiAppInputs[ApplicationId - 1] := [];
  Std.Arrays.Push(Queue, Input);
  TuiAppInputs[ApplicationId - 1] := Queue
end;

// Queues Started exactly once for a background-enabled host.
public procedure TuiAppStart(ApplicationId: integer);
begin
  TuiAppRequireOpen(ApplicationId);
  if not TuiAppStarted[ApplicationId - 1] then
  begin
    TuiAppStarted[ApplicationId - 1] := true;
    TuiAppPushMessages(ApplicationId, [TuiMsg.Started])
  end
end;

public procedure TuiAppApplyResize(ApplicationId: integer; Size: TuiSize);
begin
  TuiAppSurfaces[ApplicationId - 1].Resize(Size)
end;

public procedure TuiAppRouteInput(ApplicationId: integer; Input: TuiHostInput);
begin
  case Input of
    TuiHostInput.Message(InputMsg):
    begin
      TuiAppPushMessages(ApplicationId, [InputMsg])
    end;
    TuiHostInput.Key(Key):
    begin
      TuiAppPushMessages(ApplicationId, TuiRouteKey(TuiAppTrees[ApplicationId - 1], TuiAppFrames[ApplicationId -
                                                                                                 1], Key))
    end;
    TuiHostInput.Pointer(Pointer):
    begin
      TuiAppPushMessages(ApplicationId, Std.Tui.Runtime.Routing.Pointer.TuiRouteApplicationPointer(Pointer, ApplicationId, TuiAppTrees[ApplicationId -
                                                                                                                                       1], TuiAppFrames[ApplicationId -
                                                                                                                                                        1]))
    end;
    TuiHostInput.Resize(Size):
    begin
      TuiAppPushMessages(ApplicationId, [TuiMsg.Resize(Size)])
    end
  end
end;

public procedure TuiAppApplyResizeIfNeeded(ApplicationId: integer; Msg: TuiMsg);
begin
  case Msg of
    TuiMsg.Resize(Size):
    begin
      TuiAppApplyResize(ApplicationId, Size)
    end
    else
    begin
    end
  end
end;

public function TuiAppApplyCommand(ApplicationId: integer; Output: TuiCmdOutput): boolean;
begin
  case Output.Command() of
    TuiCmd.NoCommand:
    begin
    end;
    TuiCmd.Quit:
    begin
      return true
    end;
    TuiCmd.SetPalette:
    begin
      case Output.ReadPalette() of
        Some(Palette):
        begin
          TuiAppPalettes[ApplicationId - 1] := Palette
        end;
        None:
        begin
          panic('Tui SetPalette command requires a palette')
        end
      end;

      TuiSurfaceInvalidateTerminal(TuiAppSurfaces[ApplicationId - 1])
    end
  end;

  TuiAppPushMessages(ApplicationId, TuiBackgroundApply(ApplicationId, Output.ReadBackground()));
  return false
end;
