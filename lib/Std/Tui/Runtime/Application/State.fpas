unit Std.Tui.Runtime.Application.State;

uses Std.Arrays as Arrays;
uses Std.Options as Options;
uses Std.Tui.Cells.Palette as Palette2;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Geometry.Size as Size2;
uses Std.Tui.Layout.Frame as Frame;
uses Std.Tui.Rendering.Surface as Surface;
uses Std.Tui.Runtime.Application.Background as Background;
uses Std.Tui.Runtime.Cmd as Cmd;
uses Std.Tui.Runtime.Input as Input2;
uses Std.Tui.Runtime.Msg as Msg2;
uses Std.Tui.Runtime.Routing as Routing;
uses Std.Tui.Runtime.Routing.Pointer as Pointer2;
uses Std.Tui.Runtime.TerminalSession as TerminalSession;
uses Std.Time as Time;

public mutable var TuiAppInputHead: array of integer := [];
public mutable var TuiAppMessageHead: array of integer := [];
public mutable var TuiAppOpen: array of boolean := [];
public mutable var TuiAppInputs: array of array of Input2.TuiHostInput := [];
public mutable var TuiAppMessages: array of array of Msg2.TuiMsg := [];
public mutable var TuiAppSurfaces: array of Surface.TuiWorkingSurface := [];
public mutable var TuiAppFrames: array of Frame.TuiArrangedFrame := [];
public mutable var TuiAppTrees: array of Element.TuiElement := [];
public mutable var TuiAppCommands: array of Cmd.TuiCmdOutput := [];
public mutable var TuiAppInteractive: array of boolean := [];
public mutable var TuiAppPalettes: array of Palette2.TuiPalette := [];
public mutable var TuiAppStarted: array of boolean := [];
// Monotonic time of the pending tick request and its due time; negative due means none.
public mutable var TuiAppTickRequestedAt: array of integer := [];
public mutable var TuiAppTickDueAt: array of integer := [];

// Opens application-owned state and returns its stable identifier.
public function TuiAppOpenApplication(
  Size: Size2.TuiSize;
  Palette: Palette2.TuiPalette;
  Interactive: boolean
): integer;
begin
  Arrays.Push(TuiAppInputHead, 0);
  Arrays.Push(TuiAppMessageHead, 0);
  TuiAppOpen := Arrays.Concat(TuiAppOpen, [true]);
  TuiAppInputs := Arrays.Concat(TuiAppInputs, [[]]);
  TuiAppMessages := Arrays.Concat(TuiAppMessages, [[]]);
  TuiAppSurfaces := Arrays.Concat(TuiAppSurfaces, [Surface.TuiWorkingSurface.Create(Size)]);
  TuiAppFrames := Arrays.Concat(TuiAppFrames, [Frame.TuiArrangedFrame.Create()]);
  TuiAppTrees := Arrays.Concat(TuiAppTrees, [Element.TuiElement.Empty]);
  TuiAppCommands := Arrays.Concat(TuiAppCommands, [Cmd.TuiCmdOutput.Create()]);
  TuiAppInteractive := Arrays.Concat(TuiAppInteractive, [Interactive]);
  TuiAppPalettes := Arrays.Concat(TuiAppPalettes, [Palette]);
  TuiAppStarted := Arrays.Concat(TuiAppStarted, [false]);
  TuiAppTickRequestedAt := Arrays.Concat(TuiAppTickRequestedAt, [0]);
  TuiAppTickDueAt := Arrays.Concat(TuiAppTickDueAt, [-1]);
  Background.TuiBackgroundOpenApplication();
  Pointer2.TuiPointerRoutingOpen();
  return Arrays.Length(TuiAppOpen);
end function;

// Cancels owned work, closes application state, and returns shutdown failures.
public function TuiAppCloseApplication(ApplicationId: integer): array of Msg2.TuiMsg;
begin
  if (ApplicationId < 1) or (ApplicationId > Arrays.Length(TuiAppOpen)) then
    begin
      return [];
    end;
  end if;

  if not TuiAppOpen[ApplicationId - 1] then
    begin
      return [];
    end;
  end if;
  var BackgroundFailures: array of Msg2.TuiMsg := Background.TuiBackgroundCloseApplication(ApplicationId);
  TuiAppOpen[ApplicationId - 1] := false;
  TuiAppInputHead[ApplicationId - 1] := 0;
  TuiAppMessageHead[ApplicationId - 1] := 0;
  TuiAppInputs[ApplicationId - 1] := [];
  TuiAppMessages[ApplicationId - 1] := [];
  Pointer2.TuiPointerRoutingClose(ApplicationId);
  if TuiAppInteractive[ApplicationId - 1] then
    begin
      TuiAppInteractive[ApplicationId - 1] := false;
      TerminalSession.TuiTerminalSessionRelease();
    end;
  end if;

  return BackgroundFailures;
end function;

// Raises the first shutdown failure after application resources have been released.
public procedure TuiAppRaiseShutdownFailure(Failures: array of Msg2.TuiMsg);
begin
  if Arrays.Length(Failures) = 0 then
    begin
      return;
    end;
  end if;

  case Failures[0] of
    when Msg2.TuiMsg.BackgroundFailed(IgnoredId, Kind, Message, Code, Line, Column):
      begin
        panic(Message);
      end;
    else
      begin
        panic('Tui background operation failed during shutdown');
      end;
  end case;
end procedure;

public function TuiAppRequireHandle(ApplicationId: integer): integer;
begin
  if (ApplicationId < 1) or (ApplicationId > Arrays.Length(TuiAppOpen)) then
    begin
      panic('Tui application handle is stale');
    end;
  end if;

  return ApplicationId;
end function;

public function TuiAppRequireOpen(ApplicationId: integer): integer;
begin
  TuiAppRequireHandle(ApplicationId);
  if not TuiAppOpen[ApplicationId - 1] then
    begin
      panic('Tui application is closed');
    end;
  end if;

  return ApplicationId;
end function;

// Returns the number of unread inputs for one application.
public function TuiAppInputCount(ApplicationId: integer): integer;
begin
  return Arrays.Length(TuiAppInputs[ApplicationId - 1]) - TuiAppInputHead[ApplicationId - 1];
end function;

// Removes the next queued input, compacting only after at least half is consumed.
public function TuiAppPopInput(ApplicationId: integer): Input2.TuiHostInput;
begin
  var Slot: integer := ApplicationId - 1;
  var Head: integer := TuiAppInputHead[Slot];
  var Item: Input2.TuiHostInput := TuiAppInputs[Slot][Head];
  var Next: integer := Head + 1;
  var Count: integer := Arrays.Length(TuiAppInputs[Slot]);
  if (Next = Count) or ((Next >= 64) and (Next >= Count div 2)) then
    begin
      TuiAppInputs[Slot] := Arrays.Slice(TuiAppInputs[Slot], Next, Count - Next);
      TuiAppInputHead[Slot] := 0;
    end;
  else
    begin
      TuiAppInputHead[Slot] := Next;
    end;
  end if;

  return Item;
end function;

// Returns the number of unread messages for one application.
public function TuiAppMessageCount(ApplicationId: integer): integer;
begin
  return Arrays.Length(TuiAppMessages[ApplicationId - 1]) - TuiAppMessageHead[ApplicationId - 1];
end function;

// Removes the next queued message, compacting only after at least half is consumed.
public function TuiAppPopMessage(ApplicationId: integer): Msg2.TuiMsg;
begin
  var Slot: integer := ApplicationId - 1;
  var Head: integer := TuiAppMessageHead[Slot];
  var Item: Msg2.TuiMsg := TuiAppMessages[Slot][Head];
  var Next: integer := Head + 1;
  var Count: integer := Arrays.Length(TuiAppMessages[Slot]);
  if (Next = Count) or ((Next >= 64) and (Next >= Count div 2)) then
    begin
      TuiAppMessages[Slot] := Arrays.Slice(TuiAppMessages[Slot], Next, Count - Next);
      TuiAppMessageHead[Slot] := 0;
    end;
  else
    begin
      TuiAppMessageHead[Slot] := Next;
    end;
  end if;

  return Item;
end function;

// Enqueues messages in their original order.
public procedure TuiAppPushMessages(ApplicationId: integer; Messages: array of Msg2.TuiMsg);
begin
  mutable var Queue: array of Msg2.TuiMsg := TuiAppMessages[ApplicationId - 1];
  TuiAppMessages[ApplicationId - 1] := [];
  for Item: Msg2.TuiMsg in Messages do
    begin
      Arrays.Push(Queue, Item);
    end;
  end for;

  TuiAppMessages[ApplicationId - 1] := Queue;
end procedure;

// Enqueues one input for the application.
public procedure TuiAppPushInput(ApplicationId: integer; Input: Input2.TuiHostInput);
begin
  mutable var Queue: array of Input2.TuiHostInput := TuiAppInputs[ApplicationId - 1];
  TuiAppInputs[ApplicationId - 1] := [];
  Arrays.Push(Queue, Input);
  TuiAppInputs[ApplicationId - 1] := Queue;
end procedure;

// Queues Started exactly once for a background-enabled host.
public procedure TuiAppStart(ApplicationId: integer);
begin
  TuiAppRequireOpen(ApplicationId);
  if not TuiAppStarted[ApplicationId - 1] then
    begin
      TuiAppStarted[ApplicationId - 1] := true;
      TuiAppPushMessages(ApplicationId, [Msg2.TuiMsg.Started]);
    end;
  end if;
end procedure;

public procedure TuiAppApplyResize(ApplicationId: integer; Size: Size2.TuiSize);
begin
  TuiAppSurfaces[ApplicationId - 1].Resize(Size);
end procedure;

public procedure TuiAppRouteInput(ApplicationId: integer; Input: Input2.TuiHostInput);
begin
  case Input of
    when Input2.TuiHostInput.Message(InputMsg):
      begin
        TuiAppPushMessages(ApplicationId, [InputMsg]);
      end;
    when Input2.TuiHostInput.Key(Key):
      begin
        TuiAppPushMessages(ApplicationId, Routing.TuiRouteKey(TuiAppTrees[ApplicationId - 1], TuiAppFrames[ApplicationId -
                                                                                                           1], Key));
      end;
    when Input2.TuiHostInput.Pointer(Pointer):
      begin
        TuiAppPushMessages(ApplicationId, Pointer2.TuiRouteApplicationPointer(Pointer, ApplicationId, TuiAppTrees[ApplicationId -
                                                                                                                  1], TuiAppFrames[ApplicationId -
                                                                                                                                   1]));
      end;
    when Input2.TuiHostInput.Resize(Size):
      begin
        TuiAppPushMessages(ApplicationId, [Msg2.TuiMsg.Resize(Size)]);
      end;
  end case;
end procedure;

public procedure TuiAppApplyResizeIfNeeded(ApplicationId: integer; Msg: Msg2.TuiMsg);
begin
  case Msg of
    when Msg2.TuiMsg.Resize(Size):
      begin
        TuiAppApplyResize(ApplicationId, Size);
      end;
    else
      begin
        null;
      end;
  end case;
end procedure;

public function TuiAppApplyCommand(ApplicationId: integer; Output: Cmd.TuiCmdOutput): boolean;
begin
  case Output.Command() of
    when Cmd.TuiCmd.NoCommand:
      begin
        null;
      end;
    when Cmd.TuiCmd.Quit:
      begin
        return true;
      end;
    when Cmd.TuiCmd.SetPalette:
      begin
        case Output.ReadPalette() of
          when Some(Palette):
            begin
              TuiAppPalettes[ApplicationId - 1] := Palette;
            end;
          when None:
            begin
              panic('Tui SetPalette command requires a palette');
            end;
        end case;

        Surface.TuiSurfaceInvalidateTerminal(TuiAppSurfaces[ApplicationId - 1]);
      end;
  end case;

  case Output.ReadTickRequest() of
    when Some(Delay):
      begin
        var Now: integer := Time.MonotonicMillis();
        TuiAppTickRequestedAt[ApplicationId - 1] := Now;
        TuiAppTickDueAt[ApplicationId - 1] := Now + Delay;
      end;
    when None:
      begin
        null;
      end;
  end case;

  TuiAppPushMessages(ApplicationId, Background.TuiBackgroundApply(ApplicationId, Output.ReadBackground()));
  return false;
end function;

// Returns milliseconds until the pending tick is due: 0 when due, -1 without a pending tick.
public function TuiAppTickWait(ApplicationId: integer): integer;
begin
  var Due: integer := TuiAppTickDueAt[ApplicationId - 1];
  if Due < 0 then
    begin
      return -1;
    end;
  end if;
  var Remaining: integer := Due - Time.MonotonicMillis();
  if Remaining < 0 then
    begin
      return 0;
    end;
  end if;

  return Remaining;
end function;

// Clears the pending tick and returns it with the milliseconds elapsed since its request.
public function TuiAppTakeTick(ApplicationId: integer): Msg2.TuiMsg;
begin
  TuiAppTickDueAt[ApplicationId - 1] := -1;
  return Msg2.TuiMsg.Tick(Time.ElapsedMillis(TuiAppTickRequestedAt[ApplicationId - 1]));
end function;

// Discards a pending tick request; headless runs deliver their own deterministic ticks.
public procedure TuiAppClearTick(ApplicationId: integer);
begin
  TuiAppTickDueAt[ApplicationId - 1] := -1;
end procedure;

end unit;
