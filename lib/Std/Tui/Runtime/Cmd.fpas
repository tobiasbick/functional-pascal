unit Std.Tui.Runtime.Cmd;

uses Std.Arrays as Arrays;
uses Std.Options as Options;
uses Std.Tui.Cells.Palette as Palette2;
uses Std.Tui.Runtime.Application.Background as Background;

// Runtime command returned by an application's Update function.
public type TuiCmd = enum
  // Represents the `NoCommand` variant of `TuiCmd`.
  NoCommand;
  // Represents the `Quit` variant of `TuiCmd`.
  Quit;
  // Represents the `SetPalette` variant of `TuiCmd`.
  SetPalette;
end enum;

var TuiCommandValues: array of (TuiCmd) := [];
var TuiCommandPalettes: array of (Option of (Palette2.TuiPalette)) := [];
var TuiCommandBackground: array of (array of (Background.TuiBackgroundCommand)) := [];
// Requested tick delay in milliseconds per output; negative means no request.
var TuiCommandTickDelays: array of (integer) := [];

function TuiCmdOutputRequire(Slot: integer): integer;
begin
  if (Slot < 1) or (Slot > Arrays.Length(TuiCommandValues)) then
    begin
      panic('Tui command output handle is invalid');
    end;
  end if;

  return Slot;
end function;

// Host-owned command output capability passed to Update.
public type TuiCmdOutput = record
  // Opaque backing-storage slot.
  public Slot: integer;
end record;

// Allocates one reusable command output.
public function TuiCmdOutputCreate(): TuiCmdOutput;
begin
  TuiCommandValues := Arrays.Concat(TuiCommandValues, [TuiCmd.NoCommand]);
  TuiCommandPalettes := Arrays.Concat(TuiCommandPalettes, [Option.None]);
  Arrays.Push(var TuiCommandBackground, []);
  TuiCommandTickDelays := Arrays.Concat(TuiCommandTickDelays, [-1]);
  return TuiCmdOutput(Slot := Arrays.Length(TuiCommandValues));
end function;

// Resets the output before one Update call.
//
// Parameters:
// - `Receiver`: Value processed by the function.
public procedure TuiCmdOutputReset(Receiver: TuiCmdOutput);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  TuiCommandValues[Slot - 1] := TuiCmd.NoCommand;
  TuiCommandPalettes[Slot - 1] := Option.None;
  TuiCommandBackground[Slot - 1] := [];
  TuiCommandTickDelays[Slot - 1] := -1;
end procedure;

// Asks the interactive host for one `TuiMsg.Tick` after DelayMilliseconds.
// The latest request of an application replaces an earlier pending one.
public procedure TuiCmdOutputRequestTick(Receiver: TuiCmdOutput; DelayMilliseconds: integer);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  if DelayMilliseconds < 0 then
    begin
      panic('Tui tick delay must not be negative');
    end;
  end if;

  TuiCommandTickDelays[Slot - 1] := DelayMilliseconds;
end procedure;

// Returns the tick delay requested by the current Update call, if any.
public function TuiCmdOutputReadTickRequest(Receiver: TuiCmdOutput): Option of (integer);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  const Delay: integer := TuiCommandTickDelays[Slot - 1];
  if Delay < 0 then
    begin
      return Option.None;
    end;
  end if;

  return Option.Some(Delay);
end function;

// Starts one operation after Update returns. The host owns it until completion or shutdown.
public procedure TuiCmdOutputStartBackground(
  Receiver: TuiCmdOutput;
  Id: integer;
  Work: Background.TuiBackgroundWork
);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  if Id < 1 then
    begin
      panic('Tui background id must be positive');
    end;
  end if;
  var Commands: array of (Background.TuiBackgroundCommand) := TuiCommandBackground[Slot - 1];
  Arrays.Push(var Commands, Background.TuiBackgroundCommand.Start(Id, Work));
  TuiCommandBackground[Slot - 1] := Commands;
end procedure;

// Requests cancellation and starts the latest replacement after the previous operation ends.
public procedure TuiCmdOutputReplaceSubscription(
  Receiver: TuiCmdOutput;
  Id: integer;
  Work: Background.TuiBackgroundWork
);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  if Id < 1 then
    begin
      panic('Tui subscription id must be positive');
    end;
  end if;
  var Commands: array of (Background.TuiBackgroundCommand) := TuiCommandBackground[Slot - 1];
  Arrays.Push(var Commands, Background.TuiBackgroundCommand.ReplaceSubscription(Id, Work));
  TuiCommandBackground[Slot - 1] := Commands;
end procedure;

// Requests cancellation after Update returns; the host joins it when complete or at shutdown.
public procedure TuiCmdOutputCancelSubscription(Receiver: TuiCmdOutput; Id: integer);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  if Id < 1 then
    begin
      panic('Tui subscription id must be positive');
    end;
  end if;
  var Commands: array of (Background.TuiBackgroundCommand) := TuiCommandBackground[Slot - 1];
  Arrays.Push(var Commands, Background.TuiBackgroundCommand.CancelSubscription(Id));
  TuiCommandBackground[Slot - 1] := Commands;
end procedure;

// Sets the command returned by the current Update call.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Value`: Value used to create or update the result.
public procedure TuiCmdOutputSet(Receiver: TuiCmdOutput; Value: TuiCmd);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  TuiCommandValues[Slot - 1] := Value;
  TuiCommandPalettes[Slot - 1] := Option.None;
end procedure;

// Requests an immediate palette change after Update returns.
//
// Parameters:
// - `Receiver`: Value processed by the function.
// - `Palette`: Palette used to resolve semantic style roles.
public procedure TuiCmdOutputSetPalette(Receiver: TuiCmdOutput; Palette: Palette2.TuiPalette);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  TuiCommandValues[Slot - 1] := TuiCmd.SetPalette;
  TuiCommandPalettes[Slot - 1] := Option.Some(Palette);
end procedure;

// Reads the command after Update returns.
//
// Parameters:
// - `Receiver`: Value processed by the function.
public function TuiCmdOutputCommand(Receiver: TuiCmdOutput): TuiCmd;
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  return TuiCommandValues[Slot - 1];
end function;

// Returns the palette attached to a SetPalette command.
//
// Parameters:
// - `Receiver`: Value processed by the function.
public function TuiCmdOutputReadPalette(Receiver: TuiCmdOutput): Option of (Palette2.TuiPalette);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  return TuiCommandPalettes[Slot - 1];
end function;

// Returns background commands emitted by the current Update call.
public function TuiCmdOutputReadBackground(Receiver: TuiCmdOutput): array of (Background.TuiBackgroundCommand);
begin
  const Slot: integer := TuiCmdOutputRequire(Receiver.Slot);
  return TuiCommandBackground[Slot - 1];
end function;

end unit;
