unit Std.Tui.Runtime.Cmd;

uses Std.Array, Std.Option, Std.Tui.Cells.Palette, Std.Tui.Runtime.Application.Background;

public type
  // Runtime command returned by an application's Update function.
  TuiCmd = enum
    // Represents the `NoCommand` variant of `TuiCmd`.
    NoCommand;
    // Represents the `Quit` variant of `TuiCmd`.
    Quit;
    // Represents the `SetPalette` variant of `TuiCmd`.
    SetPalette;
  end;

mutable var
  TuiCommandValues: array of TuiCmd := [];
  TuiCommandPalettes: array of option of TuiPalette := [];
  TuiCommandBackground: array of array of TuiBackgroundCommand := [];

function TuiCmdOutputRequire(Slot: integer): integer;
begin
  if (Slot < 1) or (Slot > Std.Array.Length(TuiCommandValues)) then
  begin
    panic('Tui command output handle is invalid')
  end;

  return Slot
end;

public type
  // Host-owned command output capability passed to Update.
  TuiCmdOutput = record
    // Opaque backing-storage slot.
    public Slot: integer;

    // Allocates one reusable command output.
    public static function Create(): TuiCmdOutput;
    begin
      TuiCommandValues := Std.Array.Concat(TuiCommandValues, [TuiCmd.NoCommand]);
      TuiCommandPalettes := Std.Array.Concat(TuiCommandPalettes, [None]);
      TuiCommandBackground := Std.Array.Concat(TuiCommandBackground, [[]]);
      return record
        Slot := Std.Array.Length(TuiCommandValues);
      end
    end;

    // Resets the output before one Update call.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    public procedure Reset(Self: TuiCmdOutput);
    begin
      var Slot: integer := TuiCmdOutputRequire(Self.Slot);
      TuiCommandValues[Slot - 1] := TuiCmd.NoCommand;
      TuiCommandPalettes[Slot - 1] := None;
      TuiCommandBackground[Slot - 1] := []
    end;

    // Starts one operation after Update returns. The host owns it until completion or shutdown.
    public procedure StartBackground(Self: TuiCmdOutput; Id: integer; Work: TuiBackgroundWork);
    begin
      var Slot: integer := TuiCmdOutputRequire(Self.Slot);
      if Id < 1 then
      begin
        panic('Tui background id must be positive')
      end;
      mutable var Commands: array of TuiBackgroundCommand := TuiCommandBackground[Slot - 1];
      Std.Array.Push(Commands, TuiBackgroundCommand.Start(Id, Work));
      TuiCommandBackground[Slot - 1] := Commands
    end;

    // Requests cancellation and starts the latest replacement after the previous operation ends.
    public procedure ReplaceSubscription(Self: TuiCmdOutput; Id: integer; Work: TuiBackgroundWork);
    begin
      var Slot: integer := TuiCmdOutputRequire(Self.Slot);
      if Id < 1 then
      begin
        panic('Tui subscription id must be positive')
      end;
      mutable var Commands: array of TuiBackgroundCommand := TuiCommandBackground[Slot - 1];
      Std.Array.Push(Commands, TuiBackgroundCommand.ReplaceSubscription(Id, Work));
      TuiCommandBackground[Slot - 1] := Commands
    end;

    // Requests cancellation after Update returns; the host joins it when complete or at shutdown.
    public procedure CancelSubscription(Self: TuiCmdOutput; Id: integer);
    begin
      var Slot: integer := TuiCmdOutputRequire(Self.Slot);
      if Id < 1 then
      begin
        panic('Tui subscription id must be positive')
      end;
      mutable var Commands: array of TuiBackgroundCommand := TuiCommandBackground[Slot - 1];
      Std.Array.Push(Commands, TuiBackgroundCommand.CancelSubscription(Id));
      TuiCommandBackground[Slot - 1] := Commands
    end;

    // Sets the command returned by the current Update call.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Value`: Value used to create or update the result.
    public procedure Set(Self: TuiCmdOutput; Value: TuiCmd);
    begin
      var Slot: integer := TuiCmdOutputRequire(Self.Slot);
      TuiCommandValues[Slot - 1] := Value;
      TuiCommandPalettes[Slot - 1] := None
    end;

    // Requests an immediate palette change after Update returns.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    // - `Palette`: Palette used to resolve semantic style roles.
    public procedure SetPalette(Self: TuiCmdOutput; Palette: TuiPalette);
    begin
      var Slot: integer := TuiCmdOutputRequire(Self.Slot);
      TuiCommandValues[Slot - 1] := TuiCmd.SetPalette;
      TuiCommandPalettes[Slot - 1] := Some(Palette)
    end;

    // Reads the command after Update returns.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    public function Read(Self: TuiCmdOutput): TuiCmd;
    begin
      var Slot: integer := TuiCmdOutputRequire(Self.Slot);
      return TuiCommandValues[Slot - 1]
    end;

    // Returns the palette attached to a SetPalette command.
    //
    // Parameters:
    // - `Self`: Receiver value operated on by the method.
    public function ReadPalette(Self: TuiCmdOutput): option of TuiPalette;
    begin
      var Slot: integer := TuiCmdOutputRequire(Self.Slot);
      return TuiCommandPalettes[Slot - 1]
    end;

    // Returns background commands emitted by the current Update call.
    public function ReadBackground(Self: TuiCmdOutput): array of TuiBackgroundCommand;
    begin
      var Slot: integer := TuiCmdOutputRequire(Self.Slot);
      return TuiCommandBackground[Slot - 1]
    end;
  end;
