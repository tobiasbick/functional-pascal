unit Std.Tui.Runtime.ConsoleEvents;

uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Size as Size;
uses Std.Tui.Runtime.Input as Input;
uses Std.Tui.Runtime.PointerEvent as PointerEvent;

function TuiPointerButtonFromConsole(Button: Console.MouseButton): PointerEvent.TuiPointerButton;
begin
  if Button = Console.MouseButton.Left then
    begin
      return PointerEvent.TuiPointerButton.Left;
    end;
  end if;

  if Button = Console.MouseButton.Right then
    begin
      return PointerEvent.TuiPointerButton.Right;
    end;
  end if;

  if Button = Console.MouseButton.Middle then
    begin
      return PointerEvent.TuiPointerButton.Middle;
    end;
  end if;

  return PointerEvent.TuiPointerButton.NoButton;
end function;

// Converts one Console event to Tui host input, discarding unsupported event kinds.
//
// Parameters:
// - `InputEvent`: Console event to translate.
public function TuiConsoleEventToHostInput(InputEvent: Console.ConsoleEvent): Option of (Input.TuiHostInput);
begin
  case InputEvent.kind of
    when Console.EventKind.Key:
      begin
        return Option.Some(Input.TuiHostInput.Key(InputEvent.key));
      end;
    when Console.EventKind.Mouse:
      begin
        return Option.Some(Input.TuiHostInput.Pointer(PointerEvent.TuiPointerEventWithModifiers(InputEvent.mouse_action, TuiPointerButtonFromConsole(InputEvent.mouse_button), Point.TuiPointCreate(InputEvent.mouse_x -
                                                                                                                                                                                                    1, InputEvent.mouse_y -
                                                                                                                                                                                                       1), InputEvent.shift, InputEvent.ctrl, InputEvent.alt, InputEvent.meta)));
      end;
    when Console.EventKind.Resize:
      begin
        if (InputEvent.width <= 0) or (InputEvent.height <= 0) then
          begin
            return Option.None;
          end;
        end if;

        return Option.Some(Input.TuiHostInput.Resize(Size.TuiSizeCreate(InputEvent.width, InputEvent.height)));
      end;
    when Console.EventKind.Paste, Console.EventKind.FocusGained, Console.EventKind.FocusLost:
      begin
        return Option.None;
      end;
  end case;
end function;

// Blocks for one Console event and maps it to supported Tui host input.
public function TuiReadConsoleHostInput(): Option of (Input.TuiHostInput);
begin
  return TuiConsoleEventToHostInput(Console.ReadEvent());
end function;

// Waits for one Console event up to the given duration.
//
// Parameters:
// - `TimeoutMillis`: Non-negative relative wait duration.
public function TuiReadConsoleHostInputWithTimeout(TimeoutMillis: integer): Option of (Input.TuiHostInput);
begin
  case Console.ReadEventTimeout(TimeoutMillis) of
    when Option.Some(const InputEvent):
      begin
        return TuiConsoleEventToHostInput(InputEvent);
      end;
    when Option.None:
      begin
        return Option.None;
      end;
  end case;
end function;

end unit;
