unit Std.Tui.Runtime.ConsoleEvents;

uses
  Std.Console, Std.Tui.Geometry.Point, Std.Tui.Geometry.Size, Std.Tui.Runtime.Input,
  Std.Tui.Runtime.PointerEvent;

function TuiPointerButtonFromConsole(Button: Std.Console.MouseButton): TuiPointerButton;
begin
  if Button = Std.Console.MouseButton.Left then
    begin
      return TuiPointerButton.Left;
    end;
  end if;

  if Button = Std.Console.MouseButton.Right then
    begin
      return TuiPointerButton.Right;
    end;
  end if;

  if Button = Std.Console.MouseButton.Middle then
    begin
      return TuiPointerButton.Middle;
    end;
  end if;

  return TuiPointerButton.NoButton;
end function;

// Converts one Console event to Tui host input, discarding unsupported event kinds.
//
// Parameters:
// - `InputEvent`: Console event to translate.
public function TuiConsoleEventToHostInput(InputEvent: Std.Console.ConsoleEvent): option of TuiHostInput;
begin
  case InputEvent.kind of
    when Std.Console.EventKind.Key:
      begin
        return Some(TuiHostInput.Key(InputEvent.key));
      end;
    when Std.Console.EventKind.Mouse:
      begin
        return Some(TuiHostInput.Pointer(TuiPointerEvent.WithModifiers(InputEvent.mouse_action, TuiPointerButtonFromConsole(InputEvent.mouse_button), TuiPoint.Create(InputEvent.mouse_x -
                                                                                                                                                                      1, InputEvent.mouse_y -
                                                                                                                                                                         1), InputEvent.shift, InputEvent.ctrl, InputEvent.alt, InputEvent.meta)));
      end;
    when Std.Console.EventKind.Resize:
      begin
        if (InputEvent.width <= 0) or (InputEvent.height <= 0) then
          begin
            return None;
          end;
        end if;

        return Some(TuiHostInput.Resize(TuiSize.Create(InputEvent.width, InputEvent.height)));
      end;
    when Std.Console.EventKind.Paste, Std.Console.EventKind.FocusGained, Std.Console.EventKind.FocusLost:
      begin
        return None;
      end;
  end case;
end function;

// Blocks for one Console event and maps it to supported Tui host input.
public function TuiReadConsoleHostInput(): option of TuiHostInput;
begin
  return TuiConsoleEventToHostInput(ReadEvent());
end function;

// Waits for one Console event up to the given duration.
//
// Parameters:
// - `TimeoutMillis`: Non-negative relative wait duration.
public function TuiReadConsoleHostInputWithTimeout(TimeoutMillis: integer): option of TuiHostInput;
begin
  case ReadEventTimeout(TimeoutMillis) of
    when Some(InputEvent):
      begin
        return TuiConsoleEventToHostInput(InputEvent);
      end;
    when None:
      begin
        return None;
      end;
  end case;
end function;
end unit;
