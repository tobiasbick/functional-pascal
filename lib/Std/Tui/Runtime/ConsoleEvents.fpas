unit Std.Tui.Runtime.ConsoleEvents;

uses
  Std.Console, Std.Option, Std.Tui.Geometry.Point, Std.Tui.Geometry.Size, Std.Tui.Runtime.Input,
  Std.Tui.Runtime.PointerEvent;

private function TuiPointerButtonFromConsole(Button: Std.Console.MouseButton): TuiPointerButton;
begin
  if Button = Std.Console.MouseButton.Left then
  begin
    return TuiPointerButton.Left
  end;
  if Button = Std.Console.MouseButton.Right then
  begin
    return TuiPointerButton.Right
  end;
  if Button = Std.Console.MouseButton.Middle then
  begin
    return TuiPointerButton.Middle
  end;
  return TuiPointerButton.NoButton
end;

/// Converts one Console event to Tui host input, discarding unsupported event kinds.

function TuiConsoleEventToHostInput(Event: Std.Console.Event): option of TuiHostInput;
begin
  case Event.kind of
    Std.Console.EventKind.Key:
    begin
      return Some(TuiHostInput.Key(Event.key))
    end;
    Std.Console.EventKind.Mouse:
    begin
      return Some(TuiHostInput.Pointer(TuiPointerEvent.WithModifiers(Event.mouse_action, TuiPointerButtonFromConsole(Event.mouse_button), TuiPoint.Create(Event.mouse_x -
                                                                                                                                                          1, Event.mouse_y -
                                                                                                                                                             1), Event.shift, Event.ctrl, Event.alt, Event.meta)))
    end;
    Std.Console.EventKind.Resize:
    begin
      if (Event.width <= 0) or (Event.height <= 0) then
      begin
        return None
      end;
      return Some(TuiHostInput.Resize(TuiSize.Create(Event.width, Event.height)))
    end;
    Std.Console.EventKind.Paste, Std.Console.EventKind.FocusGained, Std.Console.EventKind.FocusLost:
    begin
      return None
    end
  end
end;

/// Waits for one Console event and maps it to supported Tui host input.

function TuiReadConsoleHostInput(TimeoutMilliseconds: integer): option of TuiHostInput;
begin
  case ReadEventTimeout(TimeoutMilliseconds) of
    Some(Event):
    begin
      return TuiConsoleEventToHostInput(Event)
    end;
    None:
    begin
      return None
    end
  end
end;
