unit Std.Tui.Runtime.Frame;

uses
  Std.Option, Std.Tui.Elements.Element, Std.Tui.Elements.Validate, Std.Tui.Geometry.Rect,
  Std.Tui.Geometry.Size, Std.Tui.Ids.ControlId, Std.Tui.Layout.Arrange, Std.Tui.Layout.Frame,
  Std.Tui.Rendering.Paint, Std.Tui.Rendering.Surface;

// Validates, arranges, and paints one complete frame into the host-owned arranged frame.
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
// - `Frame`: Arranged frame containing element geometry.
// - `Root`: Root of the element tree.
// - `Pressed`: Whether the control is displayed as pressed.
public procedure TuiRenderFrame(
  Surface: TuiWorkingSurface;
  Frame: TuiArrangedFrame;
  Root: TuiElement;
  Pressed: option of TuiControlId
);
begin
  TuiElementValidate(Root);
  TuiArrange(Frame, Root, TuiRectForSize(Surface.Size()));
  TuiPaintView(Surface, Frame, Root, Pressed)
end;
