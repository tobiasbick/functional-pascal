unit Std.Tui.Runtime.Frame;

uses Std.Options as Options;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Elements.Validate as Validate;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Geometry.Size as Size;
uses Std.Tui.Ids.ControlId as ControlId;
uses Std.Tui.Layout.Arrange as Arrange;
uses Std.Tui.Layout.Frame as Frame2;
uses Std.Tui.Rendering.Paint as Paint;
uses Std.Tui.Rendering.Surface as Surface2;

// Validates, arranges, and paints one complete frame into the host-owned arranged frame.
//
// Parameters:
// - `Surface`: Working surface affected by the operation.
// - `Frame`: Arranged frame containing element geometry.
// - `Root`: Root of the element tree.
// - `Pressed`: Whether the control is displayed as pressed.
public procedure TuiRenderFrame(
  Surface: Surface2.TuiWorkingSurface;
  Frame: Frame2.TuiArrangedFrame;
  Root: Element.TuiElement;
  Pressed: option of ControlId.TuiControlId
);
begin
  Validate.TuiElementValidate(Root);
  Arrange.TuiArrange(Frame, Root, Rect.TuiRectForSize(Surface.Size()));
  Paint.TuiPaintView(Surface, Frame, Root, Pressed);
end procedure;

end unit;
