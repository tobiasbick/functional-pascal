unit Std.Tui.Runtime.Helpers;

uses
  Std.Arrays, Std.Tui.Elements.Element, Std.Tui.Geometry.Size, Std.Tui.Ids.ControlId,
  Std.Tui.Layout.LayoutFit, Std.Tui.Layout.Measure, Std.Tui.Layout.MeasureResult,
  Std.Tui.Layout.MeasureSpec, Std.Tui.Runtime.Routing.Focus;

// Returns the first focusable control in the active modal or full tree, or `None`.
//
// Parameters:
// - `Root`: Root of the element tree.
public function TuiFocusFirst(Root: TuiElement): option of TuiControlId;
begin
  var Controls: array of TuiControlId := TuiFocusableControls(Root);
  if Std.Arrays.Length(Controls) = 0 then
    begin
      return None;
    end;
  end if;

  return Some(Controls[0]);
end function;

// Returns `Preferred` when it is focusable in the active tree; otherwise the first focusable id.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Preferred`: Preferred size or focus identifier.
public function TuiFocusResolve(Root: TuiElement; Preferred: option of TuiControlId): option of TuiControlId;
begin
  var Controls: array of TuiControlId := TuiFocusableControls(Root);
  if Std.Arrays.Length(Controls) = 0 then
    begin
      return None;
    end;
  end if;

  case Preferred of
    when Some(Id):
      begin
        if TuiControlIndex(Controls, Id) >= 0 then
          begin
            return Preferred;
          end;
        end if;
      end;
    when None:
      begin
      end;
  end case;

  return Some(Controls[0]);
end function;

// Reports whether the root's unconstrained minimum fits the available terminal size.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Available`: Available terminal size.
public function TuiLayoutFitFor(Root: TuiElement; Available: TuiSize): TuiLayoutFit;
begin
  var Measured: TuiMeasureResult := TuiMeasure(Root, TuiMeasureSpec.Unbounded());
  return TuiLayoutFit.Create(Measured.Minimum, Available);
end function;
end unit;
