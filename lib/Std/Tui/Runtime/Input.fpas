unit Std.Tui.Runtime.Input;

uses Std.Console as Console;
uses Std.Tui.Geometry.Size as Size2;
uses Std.Tui.Runtime.Msg as Msg2;
uses Std.Tui.Runtime.PointerEvent as PointerEvent;

// One externally injected headless event, kept in arrival order.
public type TuiHostInput = enum
  // Represents the `Message` variant of `TuiHostInput`.
  //
  // Parameters:
  // - `Msg`: Framework message carried by the host input.
  Message(Msg: Msg2.TuiMsg);
  // Represents the `Key` variant of `TuiHostInput`.
  //
  // Parameters:
  // - `Key`: Console key event carried by the variant.
  Key(Key: Console.KeyEvent);
  // Represents the `Pointer` variant of `TuiHostInput`.
  //
  // Parameters:
  // - `Pointer`: Normalized pointer event carried by the variant.
  Pointer(Pointer: PointerEvent.TuiPointerEvent);
  // Represents the `Resize` variant of `TuiHostInput`.
  //
  // Parameters:
  // - `Size`: Size in terminal cells.
  Resize(Size: Size2.TuiSize);
end enum;

end unit;
