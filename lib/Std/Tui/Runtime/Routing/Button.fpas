unit Std.Tui.Runtime.Routing.Button;

uses
  Std.Console, Std.Tui.Chrome.Button, Std.Tui.Elements.Element, Std.Tui.Ids.ControlId,
  Std.Tui.Runtime.Msg;

function TuiButtonFind(Node: TuiElement; RequireDefault: boolean; Mnemonic: string): option of TuiButtonSpec;
begin
  case Node of
    when TuiElement.Button(const Button):
      begin
        if Button.Enabled and
           ((RequireDefault and Button.Default) or ((Mnemonic <> '') and (Button.Mnemonic.ToLower() = Mnemonic.ToLower()))) then
          begin
            return Some(Button);
          end;
        end if;

        return None;
      end;
    when TuiElement.Desktop(const Focused, const Children):
      begin
        var ModalIndex: integer := -1;
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            if Children[Index] is TuiElement.Overlay(const Title, const OverlayChildren) then
              begin
                ModalIndex := Index;
              end;
            end if;
          end;
        end for;

        if ModalIndex >= 0 then
          begin
            return TuiButtonFind(Children[ModalIndex], RequireDefault, Mnemonic);
          end;
        end if;

        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiButtonFind(Children[Index], RequireDefault, Mnemonic) of
              when Some(const Button):
                begin
                  return Some(Button);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiButtonFind(Children[Index], RequireDefault, Mnemonic) of
              when Some(const Button):
                begin
                  return Some(Button);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Row(const Children, const Spacing):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiButtonFind(Children[Index], RequireDefault, Mnemonic) of
              when Some(const Button):
                begin
                  return Some(Button);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Column(const Children, const Spacing):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiButtonFind(Children[Index], RequireDefault, Mnemonic) of
              when Some(const Button):
                begin
                  return Some(Button);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Layout(const Settings, const Children):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiButtonFind(Children[Index], RequireDefault, Mnemonic) of
              when Some(const Button):
                begin
                  return Some(Button);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Panel(const Title, const Children):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiButtonFind(Children[Index], RequireDefault, Mnemonic) of
              when Some(const Button):
                begin
                  return Some(Button);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Overlay(const Title, const Children):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiButtonFind(Children[Index], RequireDefault, Mnemonic) of
              when Some(const Button):
                begin
                  return Some(Button);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Empty, TuiElement.Label(_), TuiElement.Input(_), TuiElement.TextArea(_, _, _, _, _), TuiElement.CheckBox(_, _, _, _), TuiElement.List(_, _, _, _), TuiElement.MenuBar(_), TuiElement.Menu(_, _, _, _), TuiElement.StatusLine(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Spacer(_):
      begin
        return None;
      end;
  end case;
end function;

// Returns the first enabled default button in the active modal or full tree.
//
// Parameters:
// - `Root`: Root of the element tree.
public function TuiFindDefaultButton(Root: TuiElement): option of TuiButtonSpec;
begin
  return TuiButtonFind(Root, true, '');
end function;

// Returns the first enabled button matching an Alt mnemonic in the active modal or full tree.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Mnemonic`: Keyboard mnemonic used to activate the item.
public function TuiFindMnemonicButton(Root: TuiElement; Mnemonic: string): option of TuiButtonSpec;
begin
  if Mnemonic = '' then
    begin
      return None;
    end;
  end if;

  return TuiButtonFind(Root, false, Mnemonic);
end function;

// Routes one Alt mnemonic to an enabled button action.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Key`: Console key event to route or match.
public function TuiRouteButtonMnemonicKey(Root: TuiElement; Key: Std.Console.KeyEvent): option of array of TuiMsg;
begin
  if (Key.kind <> Std.Console.KeyKind.Character) or not Key.alt then
    begin
      return None;
    end;
  end if;

  case TuiFindMnemonicButton(Root, Key.ch) of
    when Some(const Button):
      begin
        return Some([TuiMsg.Action(Button.Id, Button.Action)]);
      end;
    when None:
      begin
        return None;
      end;
  end case;
end function;

// Routes Enter or Space when an enabled button owns keyboard focus.
//
// Parameters:
// - `Button`: Button specification used by the operation.
// - `Target`: Target control identifier.
// - `Key`: Console key event to route or match.
public function TuiRouteFocusedButtonKey(
  Button: TuiButtonSpec;
  Target: TuiControlId;
  Key: Std.Console.KeyEvent
): option of TuiMsg;
begin
  if Button.Id.Value <> Target.Value then
    begin
      return None;
    end;
  end if;

  if Button.Enabled and
     ((Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space)) then
    begin
      return Some(TuiMsg.Action(Button.Id, Button.Action));
    end;
  end if;

  return None;
end function;

// Returns the enabled default button action for Enter.
//
// Parameters:
// - `Root`: Root of the element tree.
public function TuiRouteDefaultButtonEnter(Root: TuiElement): option of TuiMsg;
begin
  case TuiFindDefaultButton(Root) of
    when Some(const Button):
      begin
        return Some(TuiMsg.Action(Button.Id, Button.Action));
      end;
    when None:
      begin
        return None;
      end;
  end case;
end function;
end unit;
