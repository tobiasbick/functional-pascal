/// Pointer routing for controlled movable modal dialogs.

unit Std.Tui.Runtime.Routing.DialogPointer;

uses
  Std.Array, Std.Console, Std.Tui.Elements.Element, Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect,
  Std.Tui.Ids.Action, Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame, Std.Tui.Runtime.Msg,
  Std.Tui.Runtime.PointerEvent;

type
  TuiMovableDialogRoute = record
    Found: boolean;
    Id: TuiControlId;
    Position: option of TuiPoint;
    DragOffset: option of TuiPoint;
    ChangeAction: TuiAction;
    Bounds: TuiRect;
    DesktopBounds: TuiRect;
  end;

private function TuiDialogPointerSkip(Node: TuiElement; Index: integer): integer;
begin
  mutable var Next: integer := Index + 1;
  case Node of
    TuiElement.Scroll(Id, Offset, ChangeAction, Children), TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children), TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children), TuiElement.MovableDialog(Id, Title, Position, DragOffset, ChangeAction, Children), TuiElement.Desktop(Focused, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiDialogPointerSkip(Children[ChildIndex], Next)
      end
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Button), TuiElement.Input(Input), TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction), TuiElement.CheckBox(Id, Text, Checked, ChangeAction), TuiElement.List(Id, Items, Selected, ChangeAction), TuiElement.MenuBar(Items), TuiElement.Menu(Id, Nodes, State, ChangeAction), TuiElement.StatusLine(StatusItems), TuiElement.Spacer(Value):
    begin
    end
  end;
  return Next
end;

private function TuiDialogPointerActive(Root: TuiElement; Frame: TuiArrangedFrame): TuiMovableDialogRoute;
begin
  mutable var Route: TuiMovableDialogRoute := record
    Found := false;
    Id := TuiControlId.Create(1);
    Position := None;
    DragOffset := None;
    ChangeAction := TuiAction.Create(1);
    Bounds := TuiRect.Create(0, 0, 0, 0);
    DesktopBounds := Frame.EntryAt(0).Bounds;
  end;
  case Root of
    TuiElement.Desktop(Focused, Children):
    begin
      mutable var FrameIndex: integer := 1;
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        case Children[ChildIndex] of
          TuiElement.Dialog(Title, DialogChildren):
          begin
            Route.Found := false
          end;
          TuiElement.MovableDialog(Id, Title, Position, DragOffset, ChangeAction, DialogChildren):
          begin
            Route.Found := true;
            Route.Id := Id;
            Route.Position := Position;
            Route.DragOffset := DragOffset;
            Route.ChangeAction := ChangeAction;
            Route.Bounds := Frame.EntryAt(FrameIndex).Bounds
          end
          else
          begin
          end
        end;
        FrameIndex := TuiDialogPointerSkip(Children[ChildIndex], FrameIndex)
      end
    end
    else
    begin
    end
  end;
  return Route
end;

private function TuiDialogPointerClamp(Proposed: TuiPoint; DialogBounds: TuiRect; DesktopBounds: TuiRect): TuiPoint;
begin
  mutable var X: integer := Proposed.X;
  mutable var Y: integer := Proposed.Y;
  mutable var MaximumX: integer := (DesktopBounds.Right() - DialogBounds.Width) - 2;
  mutable var MaximumY: integer := (DesktopBounds.Bottom() - DialogBounds.Height) - 1;
  if MaximumX < DesktopBounds.X then
  begin
    MaximumX := DesktopBounds.X
  end;
  if MaximumY < DesktopBounds.Y then
  begin
    MaximumY := DesktopBounds.Y
  end;
  if X < DesktopBounds.X then
  begin
    X := DesktopBounds.X
  end
  else if X > MaximumX then
  begin
    X := MaximumX
  end;
  if Y < DesktopBounds.Y then
  begin
    Y := DesktopBounds.Y
  end
  else if Y > MaximumY then
  begin
    Y := MaximumY
  end;
  return TuiPoint.Create(X, Y)
end;

/// Routes title-bar press, left-button drag, and release for the active movable dialog.

function TuiRouteDialogPointer(Root: TuiElement; Frame: TuiArrangedFrame; Pointer: TuiPointerEvent): option of array of TuiMsg;
begin
  var Route: TuiMovableDialogRoute := TuiDialogPointerActive(Root, Frame);
  if not Route.Found then
  begin
    return None
  end;
  if Pointer.Action = Std.Console.MouseAction.Down then
  begin
    if Pointer.Button = TuiPointerButton.Left then
    begin
      if Pointer.Position.Y = Route.Bounds.Y then
      begin
        if Route.Bounds.Contains(Pointer.Position) then
        begin
          if (Pointer.Position.X >= Route.Bounds.X + 2) and
             (Pointer.Position.X <= Route.Bounds.X + 4) then
          begin
            return Some([TuiMsg.Action(Route.Id, Route.ChangeAction)])
          end;
          return Some([
                        TuiMsg.DialogChanged(Route.Id, Route.ChangeAction, TuiPoint.Create(Route.Bounds.X, Route.Bounds.Y), Some(TuiPoint.Create(Pointer.Position.X -

                                                                                                                                                 Route.Bounds.X, 0)))

                      ])
        end
      end
    end
  end;
  case Route.DragOffset of
    Some(Offset):
    begin
      if Pointer.Action = Std.Console.MouseAction.Drag then
      begin
        if Pointer.Button = TuiPointerButton.Left then
        begin
          var Position: TuiPoint := TuiDialogPointerClamp(TuiPoint.Create(Pointer.Position.X -
                                                                          Offset.X, Pointer.Position.Y -
                                                                                    Offset.Y), Route.Bounds, Route.DesktopBounds);
          return Some([
                        TuiMsg.DialogChanged(Route.Id, Route.ChangeAction, Position, Route.DragOffset)

                      ])
        end
      end;
      if Pointer.Action = Std.Console.MouseAction.Up then
      begin
        if Pointer.Button = TuiPointerButton.Left then
        begin
          return Some([
                        TuiMsg.DialogChanged(Route.Id, Route.ChangeAction, TuiPoint.Create(Route.Bounds.X, Route.Bounds.Y), None)

                      ])
        end
      end
    end;
    None:
    begin
    end
  end;
  return None
end;
