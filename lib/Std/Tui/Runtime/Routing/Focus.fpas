unit Std.Tui.Runtime.Routing.Focus;

uses
  Std.Tui.Chrome.StatusItem, Std.Tui.Elements.Element, Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame;

function TuiRouteFrameMatchesNode(
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  ParentIndex: integer
): integer;
begin
  if Frame.EntryAt(Index).ParentIndex <> ParentIndex then
    begin
      panic('Tui routing received a frame for a different element tree');
    end;
  end if;
  var Next: integer := Index + 1;
  var Descendants: array of TuiElement := [];
  case Node of
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const ScrollChildren):
      begin
        Descendants := ScrollChildren;
      end;
    when TuiElement.Row(const RowChildren, const Spacing):
      begin
        Descendants := RowChildren;
      end;
    when TuiElement.Column(const ColumnChildren, const Spacing):
      begin
        Descendants := ColumnChildren;
      end;
    when TuiElement.Layout(const Settings, const LayoutChildren):
      begin
        Descendants := LayoutChildren;
      end;
    when TuiElement.Panel(const Title, const PanelChildren):
      begin
        Descendants := PanelChildren;
      end;
    when TuiElement.Overlay(const Title, const OverlayChildren):
      begin
        Descendants := OverlayChildren;
      end;
    when TuiElement.Desktop(const Focused, const DesktopChildren):
      begin
        Descendants := DesktopChildren;
      end;
    else
      begin
      end;
  end case;

  for ChildIndex: integer := 0 to Descendants.Length() - 1 do
    begin
      Next := TuiRouteFrameMatchesNode(Frame, Descendants[ChildIndex], Next, Index);
    end;
  end for;

  return Next;
end function;

// Panics when the arranged frame does not match the previous painted tree.
//
// Parameters:
// - `Frame`: Arranged frame containing element geometry.
// - `Root`: Root of the element tree.
public procedure TuiRouteRequireMatchingFrame(Frame: TuiArrangedFrame; Root: TuiElement);
begin
  if Frame.Count() = 0 then
    begin
      panic('Tui routing requires a successfully painted frame');
    end;
  end if;

  if TuiRouteFrameMatchesNode(Frame, Root, 0, -1) <> Frame.Count() then
    begin
      panic('Tui routing received a frame for a different element tree');
    end;
  end if;
end procedure;

// Returns focusable control ids in the active modal or full tree order.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiFocusableControls(Node: TuiElement): array of TuiControlId;
begin
  var Descendants: array of TuiElement := [];
  case Node of
    when TuiElement.Button(const Button):
      begin
        if Button.Enabled then
          begin
            return [Button.Id];
          end;
        else
          begin
            return [];
          end;
        end if;
      end;
    when TuiElement.Input(const Input):
      begin
        return [Input.Id];
      end;
    when TuiElement.TextArea(const Id, const Text, const Caret, const Offset, const ChangeAction):
      begin
        return [Id];
      end;
    when TuiElement.CheckBox(const Id, const Text, const Checked, const ChangeAction):
      begin
        return [Id];
      end;
    when TuiElement.List(const Id, const Items, const Selected, const ChangeAction):
      begin
        return [Id];
      end;
    when TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        return [Id];
      end;
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        var Controls: array of TuiControlId := [Id];
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            Controls := Controls.Concat(TuiFocusableControls(Children[Index]));
          end;
        end for;

        return Controls;
      end;
    when TuiElement.MenuBar(const Items):
      begin
        var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Items.Length() - 1 do
          begin
            if Items[Index].Enabled then
              begin
                Controls := Controls.Concat([Items[Index].Id]);
              end;
            end if;
          end;
        end for;

        return Controls;
      end;
    when TuiElement.StatusLine(const Items):
      begin
        var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Items.Length() - 1 do
          begin
            case Items[Index] of
              when TuiStatusItem.Command(const Id, const Text, const Action, const Enabled):
                begin
                  if Enabled then
                    begin
                      Controls := Controls.Concat([Id]);
                    end;
                  end if;
                end;
              else
                begin
                end;
            end case;
          end;
        end for;

        return Controls;
      end;
    when TuiElement.Row(const RowChildren, const Spacing):
      begin
        Descendants := RowChildren;
      end;
    when TuiElement.Column(const ColumnChildren, const Spacing):
      begin
        Descendants := ColumnChildren;
      end;
    when TuiElement.Layout(const Settings, const LayoutChildren):
      begin
        Descendants := LayoutChildren;
      end;
    when TuiElement.Panel(const Title, const PanelChildren):
      begin
        Descendants := PanelChildren;
      end;
    when TuiElement.Overlay(const Title, const OverlayChildren):
      begin
        Descendants := OverlayChildren;
      end;
    when TuiElement.Desktop(const Focused, const Children):
      begin
        var LastOverlay: integer := -1;
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case Children[Index] of
              when TuiElement.Overlay(const Title, const OverlayChildren):
                begin
                  LastOverlay := Index;
                end;
              else
                begin
                end;
            end case;
          end;
        end for;

        if LastOverlay >= 0 then
          begin
            return TuiFocusableControls(Children[LastOverlay]);
          end;
        else
          begin
            var Controls: array of TuiControlId := [];
            for Index: integer := 0 to Children.Length() - 1 do
              begin
                Controls := Controls.Concat(TuiFocusableControls(Children[Index]));
              end;
            end for;

            return Controls;
          end;
        end if;
      end;
    else
      begin
        return [];
      end;
  end case;
  var Controls: array of TuiControlId := [];
  for Index: integer := 0 to Descendants.Length() - 1 do
    begin
      Controls := Controls.Concat(TuiFocusableControls(Descendants[Index]));
    end;
  end for;

  return Controls;
end function;

// Reads the desktop focus id, or `None` when the root is not a desktop.
//
// Parameters:
// - `Root`: Root of the element tree.
public function TuiRootFocus(Root: TuiElement): option of TuiControlId;
begin
  case Root of
    when TuiElement.Desktop(const Focused, const Children):
      begin
        return Focused;
      end;
    else
      begin
        return None;
      end;
  end case;
end function;

// Returns the focusable-list index of a control id, or `-1` when absent.
//
// Parameters:
// - `Controls`: Ordered control identifiers to search.
// - `Id`: Identifier assigned to the created or selected value.
public function TuiControlIndex(Controls: array of TuiControlId; Id: TuiControlId): integer;
begin
  for Index: integer := 0 to Controls.Length() - 1 do
    begin
      if Controls[Index].Value = Id.Value then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Returns whether two control ids refer to the same identity.
//
// Parameters:
// - `Left`: Left input value or edge.
// - `Right`: Right input value or edge.
public function TuiSameControlId(Left: TuiControlId; Right: TuiControlId): boolean;
begin
  return Left.Value = Right.Value;
end function;

// Returns whether the option id matches the target control.
//
// Parameters:
// - `Focused`: Whether the control currently owns focus.
// - `Target`: Target control identifier.
public function TuiFocusMatches(Focused: option of TuiControlId; Target: TuiControlId): boolean;
begin
  case Focused of
    when Some(const Id):
      begin
        return TuiSameControlId(Id, Target);
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;
end unit;
