unit Std.Tui.Runtime.Routing.Focus;

uses Std.Arrays as Arrays;
uses Std.Tui.Chrome.StatusItem as StatusItem;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Ids.ControlId as ControlId;
uses Std.Tui.Layout.Frame as Frame2;

function TuiRouteFrameMatchesNode(
  Frame: Frame2.TuiArrangedFrame;
  Node: Element.TuiElement;
  Index: integer;
  ParentIndex: integer
): integer;
begin
  if Frame.EntryAt(Index).ParentIndex <> ParentIndex then
    begin
      panic('Tui routing received a frame for a different element tree');
    end;
  end if;
  mutable var Next: integer := Index + 1;
  mutable var Descendants: array of (Element.TuiElement) := [];
  case Node of
    when Element.TuiElement.Scroll(const Id, const Offset, const ChangeAction, const ScrollChildren):
      begin
        Descendants := ScrollChildren;
      end;
    when Element.TuiElement.Row(const RowChildren, const Spacing):
      begin
        Descendants := RowChildren;
      end;
    when Element.TuiElement.Column(const ColumnChildren, const Spacing):
      begin
        Descendants := ColumnChildren;
      end;
    when Element.TuiElement.Layout(const Settings, const LayoutChildren):
      begin
        Descendants := LayoutChildren;
      end;
    when Element.TuiElement.Panel(const Title, const PanelChildren):
      begin
        Descendants := PanelChildren;
      end;
    when Element.TuiElement.Overlay(const Title, const OverlayChildren):
      begin
        Descendants := OverlayChildren;
      end;
    when Element.TuiElement.Desktop(const Focused, const DesktopChildren):
      begin
        Descendants := DesktopChildren;
      end;
    when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.Menu(_, _, _, _), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Spacer(_):
      begin
        begin
          null;
        end;
      end;
  end case;

  for ChildIndex: integer := 0 to Arrays.Length(Descendants) - 1 do
    begin
      Next := TuiRouteFrameMatchesNode(Frame, Descendants[ChildIndex], Next, Index);
    end;
  end for;

  return Next;
end function;

// Panics when the arranged frame does not match the previous painted tree.
//
// Parameters:
// - `Frame`: Arranged frame containing element geometry.
// - `Root`: Root of the element tree.
public procedure TuiRouteRequireMatchingFrame(Frame: Frame2.TuiArrangedFrame; Root: Element.TuiElement);
begin
  if Frame.Count() = 0 then
    begin
      panic('Tui routing requires a successfully painted frame');
    end;
  end if;

  if TuiRouteFrameMatchesNode(Frame, Root, 0, -1) <> Frame.Count() then
    begin
      panic('Tui routing received a frame for a different element tree');
    end;
  end if;
end procedure;

// Returns focusable control ids in the active modal or full tree order.
//
// Parameters:
// - `Node`: Element or menu node processed by the operation.
public function TuiFocusableControls(Node: Element.TuiElement): array of (ControlId.TuiControlId);
begin
  mutable var Descendants: array of (Element.TuiElement) := [];
  case Node of
    when Element.TuiElement.Button(const Button):
      begin
        if Button.Enabled then
          begin
            return [Button.Id];
          end;
        else
          begin
            return [];
          end;
        end if;
      end;
    when Element.TuiElement.Input(const Input):
      begin
        return [Input.Id];
      end;
    when Element.TuiElement.TextArea(const Id, const Text, const Caret, const Offset, const ChangeAction):
      begin
        return [Id];
      end;
    when Element.TuiElement.CheckBox(const Id, const Text, const Checked, const ChangeAction):
      begin
        return [Id];
      end;
    when Element.TuiElement.List(const Id, const Items, const Selected, const ChangeAction):
      begin
        return [Id];
      end;
    when Element.TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        return [Id];
      end;
    when Element.TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        mutable var Controls: array of (ControlId.TuiControlId) := [Id];
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            Controls := Arrays.Concat(Controls, TuiFocusableControls(Children[Index]));
          end;
        end for;

        return Controls;
      end;
    when Element.TuiElement.MenuBar(const Items):
      begin
        mutable var Controls: array of (ControlId.TuiControlId) := [];
        for Index: integer := 0 to Arrays.Length(Items) - 1 do
          begin
            if Items[Index].Enabled then
              begin
                Controls := Arrays.Concat(Controls, [Items[Index].Id]);
              end;
            end if;
          end;
        end for;

        return Controls;
      end;
    when Element.TuiElement.StatusLine(const Items):
      begin
        mutable var Controls: array of (ControlId.TuiControlId) := [];
        for Index: integer := 0 to Arrays.Length(Items) - 1 do
          begin
            case Items[Index] of
              when StatusItem.TuiStatusItem.Command(const Id, const Text, const Action, const Enabled):
                begin
                  if Enabled then
                    begin
                      Controls := Arrays.Concat(Controls, [Id]);
                    end;
                  end if;
                end;
              when StatusItem.TuiStatusItem.Hint(_), StatusItem.TuiStatusItem.KeyHint(_, _):
                begin
                  begin
                    null;
                  end;
                end;
            end case;
          end;
        end for;

        return Controls;
      end;
    when Element.TuiElement.Row(const RowChildren, const Spacing):
      begin
        Descendants := RowChildren;
      end;
    when Element.TuiElement.Column(const ColumnChildren, const Spacing):
      begin
        Descendants := ColumnChildren;
      end;
    when Element.TuiElement.Layout(const Settings, const LayoutChildren):
      begin
        Descendants := LayoutChildren;
      end;
    when Element.TuiElement.Panel(const Title, const PanelChildren):
      begin
        Descendants := PanelChildren;
      end;
    when Element.TuiElement.Overlay(const Title, const OverlayChildren):
      begin
        Descendants := OverlayChildren;
      end;
    when Element.TuiElement.Desktop(const Focused, const Children):
      begin
        mutable var LastOverlay: integer := -1;
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case Children[Index] of
              when Element.TuiElement.Overlay(const Title, const OverlayChildren):
                begin
                  LastOverlay := Index;
                end;
              when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.Scroll(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.Menu(_, _, _, _), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Row(_, _), Element.TuiElement.Column(_, _), Element.TuiElement.Layout(_, _), Element.TuiElement.Spacer(_), Element.TuiElement.Panel(_, _), Element.TuiElement.Desktop(_, _):
                begin
                  begin
                    null;
                  end;
                end;
            end case;
          end;
        end for;

        if LastOverlay >= 0 then
          begin
            return TuiFocusableControls(Children[LastOverlay]);
          end;
        else
          begin
            mutable var Controls: array of (ControlId.TuiControlId) := [];
            for Index: integer := 0 to Arrays.Length(Children) - 1 do
              begin
                Controls := Arrays.Concat(Controls, TuiFocusableControls(Children[Index]));
              end;
            end for;

            return Controls;
          end;
        end if;
      end;
    when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Spacer(_):
      begin
        begin
          return [];
        end;
      end;
  end case;
  mutable var Controls: array of (ControlId.TuiControlId) := [];
  for Index: integer := 0 to Arrays.Length(Descendants) - 1 do
    begin
      Controls := Arrays.Concat(Controls, TuiFocusableControls(Descendants[Index]));
    end;
  end for;

  return Controls;
end function;

// Reads the desktop focus id, or `None` when the root is not a desktop.
//
// Parameters:
// - `Root`: Root of the element tree.
public function TuiRootFocus(Root: Element.TuiElement): Option of (ControlId.TuiControlId);
begin
  case Root of
    when Element.TuiElement.Desktop(const Focused, const Children):
      begin
        return Focused;
      end;
    when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.Scroll(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.Menu(_, _, _, _), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Row(_, _), Element.TuiElement.Column(_, _), Element.TuiElement.Layout(_, _), Element.TuiElement.Spacer(_), Element.TuiElement.Panel(_, _), Element.TuiElement.Overlay(_, _):
      begin
        begin
          return Option.None;
        end;
      end;
  end case;
end function;

// Returns the focusable-list index of a control id, or `-1` when absent.
//
// Parameters:
// - `Controls`: Ordered control identifiers to search.
// - `Id`: Identifier assigned to the created or selected value.
public function TuiControlIndex(Controls: array of (ControlId.TuiControlId); Id: ControlId.TuiControlId): integer;
begin
  for Index: integer := 0 to Arrays.Length(Controls) - 1 do
    begin
      if Controls[Index].Value = Id.Value then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Returns whether two control ids refer to the same identity.
//
// Parameters:
// - `Left`: Left input value or edge.
// - `Right`: Right input value or edge.
public function TuiSameControlId(Left: ControlId.TuiControlId; Right: ControlId.TuiControlId): boolean;
begin
  return Left.Value = Right.Value;
end function;

// Returns whether the option id matches the target control.
//
// Parameters:
// - `Focused`: Whether the control currently owns focus.
// - `Target`: Target control identifier.
public function TuiFocusMatches(
  Focused: Option of (ControlId.TuiControlId);
  Target: ControlId.TuiControlId
): boolean;
begin
  case Focused of
    when Option.Some(const Id):
      begin
        return TuiSameControlId(Id, Target);
      end;
    when Option.None:
      begin
        return false;
      end;
  end case;
end function;

end unit;
