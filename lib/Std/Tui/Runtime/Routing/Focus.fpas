unit Std.Tui.Runtime.Routing.Focus;

uses
  Std.Array, Std.Tui.Chrome.StatusItem, Std.Tui.Elements.Element, Std.Tui.Ids.ControlId,
  Std.Tui.Layout.Frame;

private function TuiRouteFrameMatchesNode(
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  ParentIndex: integer
): integer;
begin
  if Frame.EntryAt(Index).ParentIndex <> ParentIndex then
  begin
    panic('Tui routing received a frame for a different element tree')
  end;
  mutable var Next: integer := Index + 1;
  case Node of
    TuiElement.Scroll(Id, Offset, ChangeAction, Children), TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children), TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children), TuiElement.MovableDialog(Id, Title, Position, DragOffset, ChangeAction, Children), TuiElement.Desktop(Focused, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiRouteFrameMatchesNode(Frame, Children[ChildIndex], Next, Index)
      end
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Button), TuiElement.Input(Input), TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction), TuiElement.CheckBox(Id, Text, Checked, ChangeAction), TuiElement.List(Id, Items, Selected, ChangeAction), TuiElement.MenuBar(Items), TuiElement.Menu(Id, Nodes, State, ChangeAction), TuiElement.StatusLine(StatusItems), TuiElement.Spacer(Value):
    begin
    end
  end;
  return Next
end;

/// Panics when the arranged frame does not match the previous painted tree.

procedure TuiRouteRequireMatchingFrame(Frame: TuiArrangedFrame; Root: TuiElement);
begin
  if Frame.Count() = 0 then
  begin
    panic('Tui routing requires a successfully painted frame')
  end;
  if TuiRouteFrameMatchesNode(Frame, Root, 0, -1) <> Frame.Count() then
  begin
    panic('Tui routing received a frame for a different element tree')
  end
end;

/// Returns focusable control ids in the active modal or full tree order.

function TuiFocusableControls(Node: TuiElement): array of TuiControlId;
begin
  case Node of
    TuiElement.Button(Button):
    begin
      if Button.Enabled then
      begin
        return [Button.Id]
      end
      else
      begin
        return []
      end
    end;
    TuiElement.Input(Input):
    begin
      return [Input.Id]
    end;
    TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction), TuiElement.CheckBox(Id, Text, Checked, ChangeAction), TuiElement.List(Id, Items, Selected, ChangeAction), TuiElement.Menu(Id, Nodes, State, ChangeAction):
    begin
      return [Id]
    end;
    TuiElement.Scroll(Id, Offset, ChangeAction, Children):
    begin
      mutable var Controls: array of TuiControlId := [Id];
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Controls := Std.Array.Concat(Controls, TuiFocusableControls(Children[Index]))
      end;
      return Controls
    end;
    TuiElement.MenuBar(Items):
    begin
      mutable var Controls: array of TuiControlId := [];
      for Index: integer := 0 to Std.Array.Length(Items) - 1 do
      begin
        if Items[Index].Enabled then
        begin
          Controls := Std.Array.Concat(Controls, [Items[Index].Id])
        end
      end;
      return Controls
    end;
    TuiElement.StatusLine(Items):
    begin
      mutable var Controls: array of TuiControlId := [];
      for Index: integer := 0 to Std.Array.Length(Items) - 1 do
      begin
        case Items[Index] of
          TuiStatusItem.Hint(Text), TuiStatusItem.KeyHint(KeyText, Text):
          begin
          end;
          TuiStatusItem.Command(Id, Text, Action, Enabled):
          begin
            if Enabled then
            begin
              Controls := Std.Array.Concat(Controls, [Id])
            end
          end
        end
      end;
      return Controls
    end;
    TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children), TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children), TuiElement.MovableDialog(Id, Title, Position, DragOffset, ChangeAction, Children):
    begin
      mutable var Controls: array of TuiControlId := [];
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Controls := Std.Array.Concat(Controls, TuiFocusableControls(Children[Index]))
      end;
      return Controls
    end;
    TuiElement.Desktop(Focused, Children):
    begin
      mutable var LastDialog: integer := -1;
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        case Children[Index] of
          TuiElement.Dialog(Title, DialogChildren):
          begin
            LastDialog := Index
          end;
          TuiElement.MovableDialog(Id, Title, Position, DragOffset, ChangeAction, DialogChildren):
          begin
            LastDialog := Index
          end;
          TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Button), TuiElement.Input(Input), TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction), TuiElement.CheckBox(Id, Text, Checked, ChangeAction), TuiElement.List(Id, Items, Selected, ChangeAction), TuiElement.Scroll(Id, Offset, ChangeAction, ScrollChildren), TuiElement.MenuBar(MenuItems), TuiElement.Menu(Id, Nodes, State, ChangeAction), TuiElement.StatusLine(StatusItems), TuiElement.Row(RowChildren, RowSpacing), TuiElement.Column(ColumnChildren, ColumnSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Spacer(SpacerValue), TuiElement.Window(Title, WindowChildren), TuiElement.Desktop(NestedFocus, NestedChildren):
          begin
          end
        end
      end;
      if LastDialog >= 0 then
      begin
        return TuiFocusableControls(Children[LastDialog])
      end
      else
      begin
        mutable var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Std.Array.Length(Children) - 1 do
        begin
          Controls := Std.Array.Concat(Controls, TuiFocusableControls(Children[Index]))
        end;
        return Controls
      end
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Spacer(Value):
    begin
      return []
    end
  end
end;

/// Reads the desktop focus id, or `None` when the root is not a desktop.

function TuiRootFocus(Root: TuiElement): option of TuiControlId;
begin
  case Root of
    TuiElement.Desktop(Focused, Children):
    begin
      return Focused
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Button), TuiElement.Input(Input), TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction), TuiElement.CheckBox(Id, Text, Checked, ChangeAction), TuiElement.List(Id, Items, Selected, ChangeAction), TuiElement.Scroll(Id, Offset, ChangeAction, ScrollChildren), TuiElement.MenuBar(MenuItems), TuiElement.Menu(Id, Nodes, State, ChangeAction), TuiElement.StatusLine(StatusItems), TuiElement.Row(RowChildren, RowSpacing), TuiElement.Column(ColumnChildren, ColumnSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Spacer(SpacerValue), TuiElement.Window(Title, WindowChildren), TuiElement.Dialog(DialogTitle, DialogChildren), TuiElement.MovableDialog(Id, DialogTitle, Position, DragOffset, ChangeAction, DialogChildren):
    begin
      return None
    end
  end
end;

/// Returns the focusable-list index of a control id, or `-1` when absent.

function TuiControlIndex(Controls: array of TuiControlId; Id: TuiControlId): integer;
begin
  for Index: integer := 0 to Std.Array.Length(Controls) - 1 do
  begin
    if Controls[Index].Value = Id.Value then
    begin
      return Index
    end
  end;
  return -1
end;

/// Returns whether two control ids refer to the same identity.

function TuiSameControlId(Left: TuiControlId; Right: TuiControlId): boolean;
begin
  return Left.Value = Right.Value
end;

/// Returns whether the option id matches the target control.

function TuiFocusMatches(Focused: option of TuiControlId; Target: TuiControlId): boolean;
begin
  case Focused of
    Some(Id):
    begin
      return TuiSameControlId(Id, Target)
    end;
    None:
    begin
      return false
    end
  end
end;
