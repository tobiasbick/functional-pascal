unit Std.Tui.Runtime.Routing.FocusNavigation;

uses
  Std.Arrays, Std.Console, Std.Tui.Chrome.StatusItem, Std.Tui.Elements.Element,
  Std.Tui.Ids.ControlId, Std.Tui.Runtime.Msg, Std.Tui.Runtime.Routing.Focus;

function TuiButtonFocusControls(Node: TuiElement): array of TuiControlId;
begin
  case Node of
    when TuiElement.Button(Button):
      begin
        if Button.Enabled then
          begin
            return [Button.Id];
          end;
        end if;

        return [];
      end;
    when TuiElement.Desktop(Focused, Children):
      begin
        mutable var LastOverlay: integer := -1;
        for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            case Children[Index] of
              when TuiElement.Overlay(Title, OverlayChildren):
                begin
                  LastOverlay := Index;
                end;
              else
                begin
                end;
            end case;
          end;
        end for;

        if LastOverlay >= 0 then
          begin
            return TuiButtonFocusControls(Children[LastOverlay]);
          end;
        end if;
        mutable var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Controls := Std.Arrays.Concat(Controls, TuiButtonFocusControls(Children[Index]));
          end;
        end for;

        return Controls;
      end;
    when TuiElement.Scroll(Id, Offset, ChangeAction, Children):
      begin
        mutable var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Controls := Std.Arrays.Concat(Controls, TuiButtonFocusControls(Children[Index]));
          end;
        end for;

        return Controls;
      end;
    when TuiElement.Row(Children, Spacing):
      begin
        mutable var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Controls := Std.Arrays.Concat(Controls, TuiButtonFocusControls(Children[Index]));
          end;
        end for;

        return Controls;
      end;
    when TuiElement.Column(Children, Spacing):
      begin
        mutable var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Controls := Std.Arrays.Concat(Controls, TuiButtonFocusControls(Children[Index]));
          end;
        end for;

        return Controls;
      end;
    when TuiElement.Layout(Settings, Children):
      begin
        mutable var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Controls := Std.Arrays.Concat(Controls, TuiButtonFocusControls(Children[Index]));
          end;
        end for;

        return Controls;
      end;
    when TuiElement.Panel(Title, Children):
      begin
        mutable var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Controls := Std.Arrays.Concat(Controls, TuiButtonFocusControls(Children[Index]));
          end;
        end for;

        return Controls;
      end;
    when TuiElement.Overlay(Title, Children):
      begin
        mutable var Controls: array of TuiControlId := [];
        for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Controls := Std.Arrays.Concat(Controls, TuiButtonFocusControls(Children[Index]));
          end;
        end for;

        return Controls;
      end;
    else
      begin
        return [];
      end;
  end case;
end function;

// Routes an unmodified arrow key between enabled buttons in the active modal or full tree.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Previous`: Previously focused control identifier.
// - `Key`: Console key event to route or match.
public function TuiRouteButtonFocusNavigation(
  Root: TuiElement;
  Previous: option of TuiControlId;
  Key: Std.Console.KeyEvent
): option of array of TuiMsg;
begin
  if ((Key.shift or Key.ctrl) or Key.alt) or Key.meta then
    begin
      return None;
    end;
  end if;
  mutable var Direction: integer := 0;
  if (Key.kind = Std.Console.KeyKind.Up) or (Key.kind = Std.Console.KeyKind.Left) then
    begin
      Direction := -1;
    end;
  elsif (Key.kind = Std.Console.KeyKind.Down) or (Key.kind = Std.Console.KeyKind.Right) then
    begin
      Direction := 1;
    end;
  else
    begin
      return None;
    end;
  end if;
  var Controls: array of TuiControlId := TuiButtonFocusControls(Root);
  if Std.Arrays.Length(Controls) = 0 then
    begin
      return None;
    end;
  end if;
  mutable var CurrentIndex: integer := -1;
  case Previous of
    when Some(Id):
      begin
        CurrentIndex := TuiControlIndex(Controls, Id);
      end;
    when None:
      begin
        return None;
      end;
  end case;

  if CurrentIndex < 0 then
    begin
      return None;
    end;
  end if;
  mutable var NextIndex: integer := CurrentIndex + Direction;
  if NextIndex < 0 then
    begin
      NextIndex := Std.Arrays.Length(Controls) - 1;
    end;
  elsif NextIndex >= Std.Arrays.Length(Controls) then
    begin
      NextIndex := 0;
    end;
  end if;

  if NextIndex = CurrentIndex then
    begin
      return Some([]);
    end;
  end if;

  return Some([TuiMsg.FocusChanged(Previous, Some(Controls[NextIndex]))]);
end function;
end unit;
