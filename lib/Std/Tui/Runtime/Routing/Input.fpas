unit Std.Tui.Runtime.Routing.Input;

uses Std.Console, Std.Tui.Chrome.Input, Std.Tui.Ids.ControlId, Std.Tui.Runtime.Msg;

function TuiInputPreviousWord(Text: string; Caret: integer): integer;
begin
  var Index: integer := Caret;
  while Index > 0 do
    begin
      if Text.CharAt(Index - 1) = ' ' then
        begin
          Index := Index - 1;
        end;
      else
        begin
          break;
        end;
      end if;
    end;
  end while;

  while Index > 0 do
    begin
      if Text.CharAt(Index - 1) <> ' ' then
        begin
          Index := Index - 1;
        end;
      else
        begin
          break;
        end;
      end if;
    end;
  end while;

  return Index;
end function;

function TuiInputNextWord(Text: string; Caret: integer): integer;
begin
  var Index: integer := Caret;
  while Index < Text.Length() do
    begin
      if Text.CharAt(Index) <> ' ' then
        begin
          Index := Index + 1;
        end;
      else
        begin
          break;
        end;
      end if;
    end;
  end while;

  while Index < Text.Length() do
    begin
      if Text.CharAt(Index) = ' ' then
        begin
          Index := Index + 1;
        end;
      else
        begin
          break;
        end;
      end if;
    end;
  end while;

  return Index;
end function;

function TuiInputHistoryIndex(Input: TuiInputSpec): integer;
begin
  if Input.Text = Input.HistoryDraft then
    begin
      return -1;
    end;
  end if;

  for Index: integer := Input.History.Length() - 1 downto 0 do
    begin
      if Input.History[Index] = Input.Text then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function TuiInputHistoryKey(Input: TuiInputSpec; Key: Std.Console.KeyEvent): option of TuiMsg;
begin
  if Input.History.Length() = 0 then
    begin
      return None;
    end;
  end if;
  const Index: integer := TuiInputHistoryIndex(Input);
  if Key.kind = Std.Console.KeyKind.Up then
    begin
      if Index < 0 then
        begin
          const Text: string := Input.History[Input.History.Length() - 1];
          return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Text, Text.Length()));
        end;
      end if;

      if Index > 0 then
        begin
          const Text: string := Input.History[Index - 1];
          return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Text, Text.Length()));
        end;
      end if;

      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text, Input.Caret));
    end;
  end if;

  if Key.kind = Std.Console.KeyKind.Down then
    begin
      if Index < 0 then
        begin
          return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text, Input.Caret));
        end;
      end if;

      if Index < Input.History.Length() - 1 then
        begin
          const Text: string := Input.History[Index + 1];
          return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Text, Text.Length()));
        end;
      end if;

      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.HistoryDraft, Input.HistoryDraft.Length()));
    end;
  end if;

  return None;
end function;

// Routes one key when the supplied input owns focus.
//
// Parameters:
// - `Input`: Controlled input specification.
// - `Target`: Target control identifier.
// - `Key`: Console key event to route or match.
public function TuiRouteInputKey(Input: TuiInputSpec; Target: TuiControlId; Key: Std.Console.KeyEvent): option of TuiMsg;
begin
  if Input.Id.Value <> Target.Value then
    begin
      return None;
    end;
  end if;

  if ((Key.kind = Std.Console.KeyKind.Character) and not Key.ctrl) and
     (not Key.alt and not Key.meta) then
    begin
      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text.Insert(Input.Caret, Key.ch), Input.Caret +
                                                                                                           Key.ch.Length()));
    end;
  end if;

  if ((Key.kind = Std.Console.KeyKind.Space) and not Key.ctrl) and (not Key.alt and not Key.meta) then
    begin
      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text.Insert(Input.Caret, ' '), Input.Caret +
                                                                                                        1));
    end;
  end if;

  if (Key.kind = Std.Console.KeyKind.Backspace) and (Input.Caret > 0) then
    begin
      var Start: integer := Input.Caret - 1;
      if Key.ctrl then
        begin
          Start := TuiInputPreviousWord(Input.Text, Input.Caret);
        end;
      end if;

      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text.Delete(Start, Input.Caret -
                                                                                            Start), Start));
    end;
  end if;

  if (Key.kind = Std.Console.KeyKind.Delete) and (Input.Caret < Input.Text.Length()) then
    begin
      var EndIndex: integer := Input.Caret + 1;
      if Key.ctrl then
        begin
          EndIndex := TuiInputNextWord(Input.Text, Input.Caret);
        end;
      end if;

      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text.Delete(Input.Caret, EndIndex -
                                                                                                  Input.Caret), Input.Caret));
    end;
  end if;

  if (Key.kind = Std.Console.KeyKind.Left) and (Input.Caret > 0) then
    begin
      var Caret: integer := Input.Caret - 1;
      if Key.ctrl then
        begin
          Caret := TuiInputPreviousWord(Input.Text, Input.Caret);
        end;
      end if;

      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text, Caret));
    end;
  end if;

  if (Key.kind = Std.Console.KeyKind.Right) and (Input.Caret < Input.Text.Length()) then
    begin
      var Caret: integer := Input.Caret + 1;
      if Key.ctrl then
        begin
          Caret := TuiInputNextWord(Input.Text, Input.Caret);
        end;
      end if;

      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text, Caret));
    end;
  end if;

  if Key.kind = Std.Console.KeyKind.Home then
    begin
      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text, 0));
    end;
  end if;

  if Key.kind = Std.Console.KeyKind.EndKey then
    begin
      return Some(TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text, Input.Text.Length()));
    end;
  end if;

  if (Key.kind = Std.Console.KeyKind.Up) or (Key.kind = Std.Console.KeyKind.Down) then
    begin
      return TuiInputHistoryKey(Input, Key);
    end;
  end if;

  return None;
end function;
end unit;
