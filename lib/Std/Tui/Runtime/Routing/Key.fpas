unit Std.Tui.Runtime.Routing.Key;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Tui.Chrome.StatusItem as StatusItem;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Geometry.Point as Point;
uses Std.Tui.Geometry.Size as Size;
uses Std.Tui.Ids.ControlId as ControlId;
uses Std.Tui.Layout.Frame as Frame2;
uses Std.Tui.Layout.Measure as Measure;
uses Std.Tui.Layout.MeasureSpec as MeasureSpec;
uses Std.Tui.Runtime.Msg as Msg2;
uses Std.Tui.Runtime.Routing.Button as Button2;
uses Std.Tui.Runtime.Routing.Focus as Focus;
uses Std.Tui.Runtime.Routing.Menu as Menu;
uses Std.Tui.Runtime.Routing.FocusNavigation as FocusNavigation;
uses Std.Tui.Runtime.Routing.Input as Input2;
uses Std.Tui.Runtime.Routing.TextArea as TextArea;

function TuiScrollClamp(Value: integer; Maximum: integer): integer;
begin
  if Value < 0 then
    begin
      return 0;
    end;
  end if;

  if Value > Maximum then
    begin
      return Maximum;
    end;
  end if;

  return Value;
end function;

function TuiRouteSubtreeEnd(Node: Element.TuiElement; Index: integer): integer;
begin
  mutable var Next: integer := Index + 1;
  mutable var Descendants: array of (Element.TuiElement) := [];
  case Node of
    when Element.TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Row(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Column(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Layout(const Settings, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Panel(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Overlay(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Desktop(const Focused, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.Menu(_, _, _, _), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Spacer(_):
      begin
        begin
          null;
        end;
      end;
  end case;

  for ChildIndex: integer := 0 to Arrays.Length(Descendants) - 1 do
    begin
      Next := TuiRouteSubtreeEnd(Descendants[ChildIndex], Next);
    end;
  end for;

  return Next;
end function;

function TuiRouteTarget(
  Frame: Frame2.TuiArrangedFrame;
  Node: Element.TuiElement;
  Index: integer;
  Target: ControlId.TuiControlId;
  Key: Console.KeyEvent
): Option of (Msg2.TuiMsg);
begin
  mutable var Descendants: array of (Element.TuiElement) := [];
  case Node of
    when Element.TuiElement.Button(const Button):
      begin
        return Button2.TuiRouteFocusedButtonKey(Button, Target, Key);
      end;
    when Element.TuiElement.Input(const Input):
      begin
        return Input2.TuiRouteInputKey(Input, Target, Key);
      end;
    when Element.TuiElement.TextArea(const Id, const Text, const Caret, const Offset, const ChangeAction):
      begin
        if Id.Value <> Target.Value then
          begin
            return Option.None;
          end;
        end if;

        return TextArea.TuiRouteTextAreaKey(Id, Text, Caret, Offset, ChangeAction, Frame.EntryAt(Index)
                                                                                     .Bounds, Key);
      end;
    when Element.TuiElement.CheckBox(const Id, const Text, const Checked, const ChangeAction):
      begin
        if Id.Value <> Target.Value then
          begin
            return Option.None;
          end;
        end if;

        if (Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space) then
          begin
            return Option.Some(Msg2.TuiMsg.CheckChanged(Id, ChangeAction, not Checked));
          end;
        end if;

        return Option.None;
      end;
    when Element.TuiElement.List(const Id, const Items, const Selected, const ChangeAction):
      begin
        if Id.Value <> Target.Value then
          begin
            return Option.None;
          end;
        end if;
        var Count: integer := Arrays.Length(Items);
        if Count = 0 then
          begin
            return Option.None;
          end;
        end if;
        mutable var NextSelected: integer := Selected;
        if Key.kind = Console.KeyKind.Up then
          begin
            NextSelected := Selected - 1;
            if NextSelected < 0 then
              begin
                NextSelected := 0;
              end;
            end if;
          end;
        else
          if Key.kind = Console.KeyKind.Down then
            begin
              NextSelected := Selected + 1;
              if NextSelected >= Count then
                begin
                  NextSelected := Count - 1;
                end;
              end if;
            end;
          else
            if Key.kind = Console.KeyKind.Home then
              begin
                NextSelected := 0;
              end;
            else
              if Key.kind = Console.KeyKind.EndKey then
                begin
                  NextSelected := Count - 1;
                end;
              else
                begin
                  return Option.None;
                end;
              end if;
            end if;
          end if;
        end if;

        if NextSelected = Selected then
          begin
            return Option.None;
          end;
        end if;

        return Option.Some(Msg2.TuiMsg.SelectionChanged(Id, ChangeAction, NextSelected));
      end;
    when Element.TuiElement.MenuBar(const Items):
      begin
        for ItemIndex: integer := 0 to Arrays.Length(Items) - 1 do
          begin
            if (Items[ItemIndex].Id.Value = Target.Value) and Items[ItemIndex].Enabled then
              begin
                if (Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space) then
                  begin
                    return Option.Some(Msg2.TuiMsg.Action(Items[ItemIndex].Id, Items[ItemIndex].Action));
                  end;
                end if;

                return Option.None;
              end;
            end if;
          end;
        end for;

        return Option.None;
      end;
    when Element.TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        return Option.None;
      end;
    when Element.TuiElement.StatusLine(const Items):
      begin
        for ItemIndex: integer := 0 to Arrays.Length(Items) - 1 do
          begin
            case Items[ItemIndex] of
              when StatusItem.TuiStatusItem.Command(const Id, const Text, const Action, const Enabled):
                begin
                  if (Id.Value = Target.Value) and Enabled then
                    begin
                      if (Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space) then
                        begin
                          return Option.Some(Msg2.TuiMsg.Action(Id, Action));
                        end;
                      end if;

                      return Option.None;
                    end;
                  end if;
                end;
              when StatusItem.TuiStatusItem.Hint(_), StatusItem.TuiStatusItem.KeyHint(_, _):
                begin
                  begin
                    null;
                  end;
                end;
            end case;
          end;
        end for;

        return Option.None;
      end;
    when Element.TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        if Id.Value = Target.Value then
          begin
            mutable var Content: Size.TuiSize := Size.TuiSize.Create(0, 0);
            if Arrays.Length(Children) = 1 then
              begin
                Content := Measure.TuiMeasure(Children[0], MeasureSpec.TuiMeasureSpec.Unbounded())
                             .Preferred;
              end;
            end if;
            var Viewport: Frame2.TuiArrangedEntry := Frame.EntryAt(Index);
            mutable var MaximumX: integer := Content.Width - Viewport.Bounds.Width;
            mutable var MaximumY: integer := Content.Height - Viewport.Bounds.Height;
            if MaximumX < 0 then
              begin
                MaximumX := 0;
              end;
            end if;

            if MaximumY < 0 then
              begin
                MaximumY := 0;
              end;
            end if;
            mutable var NextOffset: Point.TuiPoint := Offset;
            if Key.kind = Console.KeyKind.Left then
              begin
                NextOffset.X := TuiScrollClamp(Offset.X - 1, MaximumX);
              end;
            else
              if Key.kind = Console.KeyKind.Right then
                begin
                  NextOffset.X := TuiScrollClamp(Offset.X + 1, MaximumX);
                end;
              else
                if Key.kind = Console.KeyKind.Up then
                  begin
                    NextOffset.Y := TuiScrollClamp(Offset.Y - 1, MaximumY);
                  end;
                else
                  if Key.kind = Console.KeyKind.Down then
                    begin
                      NextOffset.Y := TuiScrollClamp(Offset.Y + 1, MaximumY);
                    end;
                  else
                    if Key.kind = Console.KeyKind.PageUp then
                      begin
                        NextOffset.Y := TuiScrollClamp(Offset.Y - Viewport.Bounds.Height, MaximumY);
                      end;
                    else
                      if Key.kind = Console.KeyKind.PageDown then
                        begin
                          NextOffset.Y := TuiScrollClamp(Offset.Y + Viewport.Bounds.Height, MaximumY);
                        end;
                      else
                        if Key.kind = Console.KeyKind.Home then
                          begin
                            NextOffset.Y := 0;
                          end;
                        else
                          if Key.kind = Console.KeyKind.EndKey then
                            begin
                              NextOffset.Y := MaximumY;
                            end;
                          else
                            begin
                              return Option.None;
                            end;
                          end if;
                        end if;
                      end if;
                    end if;
                  end if;
                end if;
              end if;
            end if;

            if (NextOffset.X = Offset.X) and (NextOffset.Y = Offset.Y) then
              begin
                return Option.None;
              end;
            end if;

            return Option.Some(Msg2.TuiMsg.ScrollChanged(Id, ChangeAction, NextOffset));
          end;
        end if;

        Descendants := Children;
      end;
    when Element.TuiElement.Row(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Column(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Layout(const Settings, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Panel(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Overlay(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Desktop(const Focused, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Spacer(_):
      begin
        begin
          return Option.None;
        end;
      end;
  end case;
  mutable var Next: integer := Index + 1;
  for ChildIndex: integer := 0 to Arrays.Length(Descendants) - 1 do
    begin
      case TuiRouteTarget(Frame, Descendants[ChildIndex], Next, Target, Key) of
        when Option.Some(const Msg):
          begin
            return Option.Some(Msg);
          end;
        when Option.None:
          begin
            null;
          end;
      end case;

      Next := TuiRouteSubtreeEnd(Descendants[ChildIndex], Next);
    end;
  end for;

  return Option.None;
end function;

// Routes one key against the previous rendered tree into ordered framework messages.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Frame`: Arranged frame containing element geometry.
// - `Key`: Console key event to route or match.
public function TuiRouteKey(
  Root: Element.TuiElement;
  Frame: Frame2.TuiArrangedFrame;
  Key: Console.KeyEvent
): array of (Msg2.TuiMsg);
begin
  Focus.TuiRouteRequireMatchingFrame(Frame, Root);
  case Menu.TuiRouteMenuKey(Root, Key) of
    when Option.Some(const Messages):
      begin
        return Messages;
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  if Key.kind = Console.KeyKind.Escape then
    begin
      return [Msg2.TuiMsg.QuitRequested];
    end;
  end if;

  case Button2.TuiRouteButtonMnemonicKey(Root, Key) of
    when Option.Some(const Messages):
      begin
        return Messages;
      end;
    when Option.None:
      begin
        null;
      end;
  end case;
  var Controls: array of (ControlId.TuiControlId) := Focus.TuiFocusableControls(Root);
  if Arrays.Length(Controls) = 0 then
    begin
      return [Msg2.TuiMsg.Key(Key)];
    end;
  end if;
  var Previous: Option of (ControlId.TuiControlId) := Focus.TuiRootFocus(Root);
  mutable var CurrentIndex: integer := -1;
  case Previous of
    when Option.Some(const Id):
      begin
        CurrentIndex := Focus.TuiControlIndex(Controls, Id);
      end;
    when Option.None:
      begin
        null;
      end;
  end case;
  mutable var Routed: array of (Msg2.TuiMsg) := [];
  mutable var Target: ControlId.TuiControlId := Controls[0];
  if CurrentIndex >= 0 then
    begin
      Target := Controls[CurrentIndex];
    end;
  else
    begin
      Arrays.Push(Routed, Msg2.TuiMsg.FocusChanged(Previous, Option.Some(Target)));
    end;
  end if;

  if Key.kind = Console.KeyKind.Tab then
    begin
      if CurrentIndex >= 0 then
        begin
          case TuiRouteTarget(Frame, Root, 0, Target, Key) of
            when Option.Some(const Msg):
              begin
                return [Msg];
              end;
            when Option.None:
              begin
                null;
              end;
          end case;
        end;
      end if;
      mutable var NextIndex: integer := CurrentIndex + 1;
      if NextIndex >= Arrays.Length(Controls) then
        begin
          NextIndex := 0;
        end;
      end if;

      return [Msg2.TuiMsg.FocusChanged(Previous, Option.Some(Controls[NextIndex]))];
    end;
  end if;

  case FocusNavigation.TuiRouteButtonFocusNavigation(Root, Previous, Key) of
    when Option.Some(const Messages):
      begin
        return Messages;
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  case TuiRouteTarget(Frame, Root, 0, Target, Key) of
    when Option.Some(const Msg):
      begin
        Arrays.Push(Routed, Msg);
      end;
    when Option.None:
      begin
        if Key.kind = Console.KeyKind.Enter then
          begin
            case Button2.TuiRouteDefaultButtonEnter(Root) of
              when Option.Some(const Msg):
                begin
                  Arrays.Push(Routed, Msg);
                  return Routed;
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end if;

        Arrays.Push(Routed, Msg2.TuiMsg.Key(Key));
      end;
  end case;

  return Routed;
end function;

end unit;
