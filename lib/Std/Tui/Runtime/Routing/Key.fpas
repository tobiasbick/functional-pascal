unit Std.Tui.Runtime.Routing.Key;

uses
  Std.Console, Std.Tui.Chrome.StatusItem, Std.Tui.Elements.Element, Std.Tui.Geometry.Point,
  Std.Tui.Geometry.Size, Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame, Std.Tui.Layout.Measure,
  Std.Tui.Layout.MeasureSpec, Std.Tui.Runtime.Msg, Std.Tui.Runtime.Routing.Button,
  Std.Tui.Runtime.Routing.Focus, Std.Tui.Runtime.Routing.Menu,
  Std.Tui.Runtime.Routing.FocusNavigation, Std.Tui.Runtime.Routing.Input,
  Std.Tui.Runtime.Routing.TextArea;

function TuiScrollClamp(Value: integer; Maximum: integer): integer;
begin
  if Value < 0 then
    begin
      return 0;
    end;
  end if;

  if Value > Maximum then
    begin
      return Maximum;
    end;
  end if;

  return Value;
end function;

function TuiRouteSubtreeEnd(Node: TuiElement; Index: integer): integer;
begin
  var Next: integer := Index + 1;
  var Descendants: array of TuiElement := [];
  case Node of
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        Descendants := Children;
      end;
    when TuiElement.Row(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when TuiElement.Column(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when TuiElement.Layout(const Settings, const Children):
      begin
        Descendants := Children;
      end;
    when TuiElement.Panel(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when TuiElement.Overlay(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when TuiElement.Desktop(const Focused, const Children):
      begin
        Descendants := Children;
      end;
    when TuiElement.Empty, TuiElement.Label(_), TuiElement.Button(_), TuiElement.Input(_), TuiElement.TextArea(_, _, _, _, _), TuiElement.CheckBox(_, _, _, _), TuiElement.List(_, _, _, _), TuiElement.MenuBar(_), TuiElement.Menu(_, _, _, _), TuiElement.StatusLine(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Spacer(_):
      null;
  end case;

  for ChildIndex: integer := 0 to Descendants.Length() - 1 do
    begin
      Next := TuiRouteSubtreeEnd(Descendants[ChildIndex], Next);
    end;
  end for;

  return Next;
end function;

function TuiRouteTarget(
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  Target: TuiControlId;
  Key: Std.Console.KeyEvent
): option of TuiMsg;
begin
  var Descendants: array of TuiElement := [];
  case Node of
    when TuiElement.Button(const Button):
      begin
        return TuiRouteFocusedButtonKey(Button, Target, Key);
      end;
    when TuiElement.Input(const Input):
      begin
        return TuiRouteInputKey(Input, Target, Key);
      end;
    when TuiElement.TextArea(const Id, const Text, const Caret, const Offset, const ChangeAction):
      begin
        if Id.Value <> Target.Value then
          begin
            return None;
          end;
        end if;

        return TuiRouteTextAreaKey(Id, Text, Caret, Offset, ChangeAction, Frame.EntryAt(Index)
                                                                            .Bounds, Key);
      end;
    when TuiElement.CheckBox(const Id, const Text, const Checked, const ChangeAction):
      begin
        if Id.Value <> Target.Value then
          begin
            return None;
          end;
        end if;

        if (Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space) then
          begin
            return Some(TuiMsg.CheckChanged(Id, ChangeAction, not Checked));
          end;
        end if;

        return None;
      end;
    when TuiElement.List(const Id, const Items, const Selected, const ChangeAction):
      begin
        if Id.Value <> Target.Value then
          begin
            return None;
          end;
        end if;
        const Count: integer := Items.Length();
        if Count = 0 then
          begin
            return None;
          end;
        end if;
        var NextSelected: integer := Selected;
        if Key.kind = Std.Console.KeyKind.Up then
          begin
            NextSelected := Selected - 1;
            if NextSelected < 0 then
              begin
                NextSelected := 0;
              end;
            end if;
          end;
        elsif Key.kind = Std.Console.KeyKind.Down then
          begin
            NextSelected := Selected + 1;
            if NextSelected >= Count then
              begin
                NextSelected := Count - 1;
              end;
            end if;
          end;
        elsif Key.kind = Std.Console.KeyKind.Home then
          begin
            NextSelected := 0;
          end;
        elsif Key.kind = Std.Console.KeyKind.EndKey then
          begin
            NextSelected := Count - 1;
          end;
        else
          begin
            return None;
          end;
        end if;

        if NextSelected = Selected then
          begin
            return None;
          end;
        end if;

        return Some(TuiMsg.SelectionChanged(Id, ChangeAction, NextSelected));
      end;
    when TuiElement.MenuBar(const Items):
      begin
        for ItemIndex: integer := 0 to Items.Length() - 1 do
          begin
            if (Items[ItemIndex].Id.Value = Target.Value) and Items[ItemIndex].Enabled then
              begin
                if (Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space) then
                  begin
                    return Some(TuiMsg.Action(Items[ItemIndex].Id, Items[ItemIndex].Action));
                  end;
                end if;

                return None;
              end;
            end if;
          end;
        end for;

        return None;
      end;
    when TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        return None;
      end;
    when TuiElement.StatusLine(const Items):
      begin
        for ItemIndex: integer := 0 to Items.Length() - 1 do
          begin
            if Items[ItemIndex] is TuiStatusItem.Command(const Id, const Text, const Action, const Enabled) then
              begin
                if (Id.Value = Target.Value) and Enabled then
                  begin
                    if (Key.kind = Std.Console.KeyKind.Enter) or
                       (Key.kind = Std.Console.KeyKind.Space) then
                      begin
                        return Some(TuiMsg.Action(Id, Action));
                      end;
                    end if;

                    return None;
                  end;
                end if;
              end;
            end if;
          end;
        end for;

        return None;
      end;
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        if Id.Value = Target.Value then
          begin
            var Content: TuiSize := TuiSize.Create(0, 0);
            if Children.Length() = 1 then
              begin
                Content := TuiMeasure(Children[0], TuiMeasureSpec.Unbounded()).Preferred;
              end;
            end if;
            const Viewport: TuiArrangedEntry := Frame.EntryAt(Index);
            var MaximumX: integer := Content.Width - Viewport.Bounds.Width;
            var MaximumY: integer := Content.Height - Viewport.Bounds.Height;
            if MaximumX < 0 then
              begin
                MaximumX := 0;
              end;
            end if;

            if MaximumY < 0 then
              begin
                MaximumY := 0;
              end;
            end if;
            var NextOffset: TuiPoint := Offset;
            if Key.kind = Std.Console.KeyKind.Left then
              begin
                NextOffset.X := TuiScrollClamp(Offset.X - 1, MaximumX);
              end;
            elsif Key.kind = Std.Console.KeyKind.Right then
              begin
                NextOffset.X := TuiScrollClamp(Offset.X + 1, MaximumX);
              end;
            elsif Key.kind = Std.Console.KeyKind.Up then
              begin
                NextOffset.Y := TuiScrollClamp(Offset.Y - 1, MaximumY);
              end;
            elsif Key.kind = Std.Console.KeyKind.Down then
              begin
                NextOffset.Y := TuiScrollClamp(Offset.Y + 1, MaximumY);
              end;
            elsif Key.kind = Std.Console.KeyKind.PageUp then
              begin
                NextOffset.Y := TuiScrollClamp(Offset.Y - Viewport.Bounds.Height, MaximumY);
              end;
            elsif Key.kind = Std.Console.KeyKind.PageDown then
              begin
                NextOffset.Y := TuiScrollClamp(Offset.Y + Viewport.Bounds.Height, MaximumY);
              end;
            elsif Key.kind = Std.Console.KeyKind.Home then
              begin
                NextOffset.Y := 0;
              end;
            elsif Key.kind = Std.Console.KeyKind.EndKey then
              begin
                NextOffset.Y := MaximumY;
              end;
            else
              begin
                return None;
              end;
            end if;

            if (NextOffset.X = Offset.X) and (NextOffset.Y = Offset.Y) then
              begin
                return None;
              end;
            end if;

            return Some(TuiMsg.ScrollChanged(Id, ChangeAction, NextOffset));
          end;
        end if;

        Descendants := Children;
      end;
    when TuiElement.Row(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when TuiElement.Column(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when TuiElement.Layout(const Settings, const Children):
      begin
        Descendants := Children;
      end;
    when TuiElement.Panel(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when TuiElement.Overlay(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when TuiElement.Desktop(const Focused, const Children):
      begin
        Descendants := Children;
      end;
    when TuiElement.Empty, TuiElement.Label(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Spacer(_):
      begin
        return None;
      end;
  end case;
  var Next: integer := Index + 1;
  for ChildIndex: integer := 0 to Descendants.Length() - 1 do
    begin
      case TuiRouteTarget(Frame, Descendants[ChildIndex], Next, Target, Key) of
        when Some(const Msg):
          begin
            return Some(Msg);
          end;
        when None:
          begin
          end;
      end case;

      Next := TuiRouteSubtreeEnd(Descendants[ChildIndex], Next);
    end;
  end for;

  return None;
end function;

// Routes one key against the previous rendered tree into ordered framework messages.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Frame`: Arranged frame containing element geometry.
// - `Key`: Console key event to route or match.
public function TuiRouteKey(Root: TuiElement; Frame: TuiArrangedFrame; Key: Std.Console.KeyEvent): array of TuiMsg;
begin
  TuiRouteRequireMatchingFrame(Frame, Root);
  case TuiRouteMenuKey(Root, Key) of
    when Some(const Messages):
      begin
        return Messages;
      end;
    when None:
      begin
      end;
  end case;

  if Key.kind = Std.Console.KeyKind.Escape then
    begin
      return [TuiMsg.QuitRequested];
    end;
  end if;

  case TuiRouteButtonMnemonicKey(Root, Key) of
    when Some(const Messages):
      begin
        return Messages;
      end;
    when None:
      begin
      end;
  end case;
  const Controls: array of TuiControlId := TuiFocusableControls(Root);
  if Controls.Length() = 0 then
    begin
      return [TuiMsg.Key(Key)];
    end;
  end if;
  const Previous: option of TuiControlId := TuiRootFocus(Root);
  var CurrentIndex: integer := -1;
  case Previous of
    when Some(const Id):
      begin
        CurrentIndex := TuiControlIndex(Controls, Id);
      end;
    when None:
      begin
      end;
  end case;
  var Routed: array of TuiMsg := [];
  var Target: TuiControlId := Controls[0];
  if CurrentIndex >= 0 then
    begin
      Target := Controls[CurrentIndex];
    end;
  else
    begin
      Routed.Push(TuiMsg.FocusChanged(Previous, Some(Target)));
    end;
  end if;

  if Key.kind = Std.Console.KeyKind.Tab then
    begin
      if CurrentIndex >= 0 then
        begin
          case TuiRouteTarget(Frame, Root, 0, Target, Key) of
            when Some(const Msg):
              begin
                return [Msg];
              end;
            when None:
              begin
              end;
          end case;
        end;
      end if;
      var NextIndex: integer := CurrentIndex + 1;
      if NextIndex >= Controls.Length() then
        begin
          NextIndex := 0;
        end;
      end if;

      return [TuiMsg.FocusChanged(Previous, Some(Controls[NextIndex]))];
    end;
  end if;

  case TuiRouteButtonFocusNavigation(Root, Previous, Key) of
    when Some(const Messages):
      begin
        return Messages;
      end;
    when None:
      begin
      end;
  end case;

  case TuiRouteTarget(Frame, Root, 0, Target, Key) of
    when Some(const Msg):
      begin
        Routed.Push(Msg);
      end;
    when None:
      begin
        if Key.kind = Std.Console.KeyKind.Enter then
          begin
            case TuiRouteDefaultButtonEnter(Root) of
              when Some(const Msg):
                begin
                  Routed.Push(Msg);
                  return Routed;
                end;
              when None:
                begin
                end;
            end case;
          end;
        end if;

        Routed.Push(TuiMsg.Key(Key));
      end;
  end case;

  return Routed;
end function;
end unit;
