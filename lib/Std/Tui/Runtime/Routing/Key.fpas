unit Std.Tui.Runtime.Routing.Key;

uses
  Std.Array, Std.Console, Std.Str, Std.Tui.Chrome.StatusItem, Std.Tui.Elements.Element,
  Std.Tui.Geometry.Point, Std.Tui.Geometry.Size, Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame,
  Std.Tui.Layout.Measure, Std.Tui.Layout.MeasureSpec, Std.Tui.Runtime.Msg,
  Std.Tui.Runtime.Routing.Button, Std.Tui.Runtime.Routing.Focus, Std.Tui.Runtime.Routing.Menu,
  Std.Tui.Runtime.Routing.FocusNavigation, Std.Tui.Runtime.Routing.Input,
  Std.Tui.Runtime.Routing.TextArea;

function TuiScrollClamp(Value: integer; Maximum: integer): integer;
begin
  if Value < 0 then
  begin
    return 0
  end;
  if Value > Maximum then
  begin
    return Maximum
  end;
  return Value
end;

function TuiRouteSubtreeEnd(Node: TuiElement; Index: integer): integer;
begin
  mutable var Next: integer := Index + 1;
  case Node of
    TuiElement.Scroll(Id, Offset, ChangeAction, Children), TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children), TuiElement.Panel(Title, Children), TuiElement.Overlay(Title, Children), TuiElement.Desktop(Focused, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiRouteSubtreeEnd(Children[ChildIndex], Next)
      end
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Button), TuiElement.Input(Input), TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction), TuiElement.CheckBox(Id, Text, Checked, ChangeAction), TuiElement.List(Id, Items, Selected, ChangeAction), TuiElement.MenuBar(Items), TuiElement.Menu(Id, Nodes, State, ChangeAction), TuiElement.StatusLine(StatusItems), TuiElement.CellGrid(Grid), TuiElement.Rule(RuleText), TuiElement.Gauge(Gauge), TuiElement.Spacer(Value):
    begin
    end
  end;
  return Next
end;

function TuiRouteTarget(
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  Target: TuiControlId;
  Key: Std.Console.KeyEvent
): option of TuiMsg;
begin
  case Node of
    TuiElement.Button(Button):
    begin
      return TuiRouteFocusedButtonKey(Button, Target, Key)
    end;
    TuiElement.Input(Input):
    begin
      return TuiRouteInputKey(Input, Target, Key)
    end;
    TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction):
    begin
      if Id.Value <> Target.Value then
      begin
        return None
      end;
      return TuiRouteTextAreaKey(Id, Text, Caret, Offset, ChangeAction, Frame.EntryAt(Index).Bounds, Key)
    end;
    TuiElement.CheckBox(Id, Text, Checked, ChangeAction):
    begin
      if Id.Value <> Target.Value then
      begin
        return None
      end;
      if (Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space) then
      begin
        return Some(TuiMsg.CheckChanged(Id, ChangeAction, not Checked))
      end;
      return None
    end;
    TuiElement.List(Id, Items, Selected, ChangeAction):
    begin
      if Id.Value <> Target.Value then
      begin
        return None
      end;
      var Count: integer := Std.Array.Length(Items);
      if Count = 0 then
      begin
        return None
      end;
      mutable var NextSelected: integer := Selected;
      if Key.kind = Std.Console.KeyKind.Up then
      begin
        NextSelected := Selected - 1;
        if NextSelected < 0 then
        begin
          NextSelected := 0
        end
      end
      else if Key.kind = Std.Console.KeyKind.Down then
      begin
        NextSelected := Selected + 1;
        if NextSelected >= Count then
        begin
          NextSelected := Count - 1
        end
      end
      else if Key.kind = Std.Console.KeyKind.Home then
      begin
        NextSelected := 0
      end
      else if Key.kind = Std.Console.KeyKind.EndKey then
      begin
        NextSelected := Count - 1
      end
      else
      begin
        return None
      end;
      if NextSelected = Selected then
      begin
        return None
      end;
      return Some(TuiMsg.SelectionChanged(Id, ChangeAction, NextSelected))
    end;
    TuiElement.MenuBar(Items):
    begin
      for ItemIndex: integer := 0 to Std.Array.Length(Items) - 1 do
      begin
        if (Items[ItemIndex].Id.Value = Target.Value) and Items[ItemIndex].Enabled then
        begin
          if (Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space) then
          begin
            return Some(TuiMsg.Action(Items[ItemIndex].Id, Items[ItemIndex].Action))
          end;
          return None
        end
      end;
      return None
    end;
    TuiElement.Menu(Id, Nodes, State, ChangeAction):
    begin
      return None
    end;
    TuiElement.StatusLine(Items):
    begin
      for ItemIndex: integer := 0 to Std.Array.Length(Items) - 1 do
      begin
        case Items[ItemIndex] of
          TuiStatusItem.Hint(Text), TuiStatusItem.KeyHint(KeyText, Text):
          begin
          end;
          TuiStatusItem.Command(Id, Text, Action, Enabled):
          begin
            if (Id.Value = Target.Value) and Enabled then
            begin
              if (Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space) then
              begin
                return Some(TuiMsg.Action(Id, Action))
              end;
              return None
            end
          end
        end
      end;
      return None
    end;
    TuiElement.Scroll(Id, Offset, ChangeAction, Children):
    begin
      mutable var Next: integer := Index + 1;
      if Id.Value = Target.Value then
      begin
        mutable var Content: TuiSize := TuiSize.Create(0, 0);
        if Std.Array.Length(Children) = 1 then
        begin
          Content := TuiMeasure(Children[0], TuiMeasureSpec.Unbounded()).Preferred
        end;
        var Viewport: TuiArrangedEntry := Frame.EntryAt(Index);
        mutable var MaximumX: integer := Content.Width - Viewport.Bounds.Width;
        mutable var MaximumY: integer := Content.Height - Viewport.Bounds.Height;
        if MaximumX < 0 then
        begin
          MaximumX := 0
        end;
        if MaximumY < 0 then
        begin
          MaximumY := 0
        end;
        mutable var NextOffset: TuiPoint := Offset;
        if Key.kind = Std.Console.KeyKind.Left then
        begin
          NextOffset.X := TuiScrollClamp(Offset.X - 1, MaximumX)
        end
        else if Key.kind = Std.Console.KeyKind.Right then
        begin
          NextOffset.X := TuiScrollClamp(Offset.X + 1, MaximumX)
        end
        else if Key.kind = Std.Console.KeyKind.Up then
        begin
          NextOffset.Y := TuiScrollClamp(Offset.Y - 1, MaximumY)
        end
        else if Key.kind = Std.Console.KeyKind.Down then
        begin
          NextOffset.Y := TuiScrollClamp(Offset.Y + 1, MaximumY)
        end
        else if Key.kind = Std.Console.KeyKind.PageUp then
        begin
          NextOffset.Y := TuiScrollClamp(Offset.Y - Viewport.Bounds.Height, MaximumY)
        end
        else if Key.kind = Std.Console.KeyKind.PageDown then
        begin
          NextOffset.Y := TuiScrollClamp(Offset.Y + Viewport.Bounds.Height, MaximumY)
        end
        else if Key.kind = Std.Console.KeyKind.Home then
        begin
          NextOffset.Y := 0
        end
        else if Key.kind = Std.Console.KeyKind.EndKey then
        begin
          NextOffset.Y := MaximumY
        end
        else
        begin
          return None
        end;
        if (NextOffset.X = Offset.X) and (NextOffset.Y = Offset.Y) then
        begin
          return None
        end;
        return Some(TuiMsg.ScrollChanged(Id, ChangeAction, NextOffset))
      end;
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        case TuiRouteTarget(Frame, Children[ChildIndex], Next, Target, Key) of
          Some(Msg):
          begin
            return Some(Msg)
          end;
          None:
          begin
          end
        end;
        Next := TuiRouteSubtreeEnd(Children[ChildIndex], Next)
      end;
      return None
    end;
    TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children), TuiElement.Panel(Title, Children), TuiElement.Overlay(Title, Children), TuiElement.Desktop(Focused, Children):
    begin
      mutable var Next: integer := Index + 1;
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        case TuiRouteTarget(Frame, Children[ChildIndex], Next, Target, Key) of
          Some(Msg):
          begin
            return Some(Msg)
          end;
          None:
          begin
          end
        end;
        Next := TuiRouteSubtreeEnd(Children[ChildIndex], Next)
      end;
      return None
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.CellGrid(Grid), TuiElement.Rule(RuleText), TuiElement.Gauge(Gauge), TuiElement.Spacer(Value):
    begin
      return None
    end
  end
end;

/// Routes one key against the previous rendered tree into ordered framework messages.

public function TuiRouteKey(Root: TuiElement; Frame: TuiArrangedFrame; Key: Std.Console.KeyEvent): array of TuiMsg;
begin
  TuiRouteRequireMatchingFrame(Frame, Root);
  case TuiRouteMenuKey(Root, Key) of
    Some(Messages):
    begin
      return Messages
    end;
    None:
    begin
    end
  end;
  if Key.kind = Std.Console.KeyKind.Escape then
  begin
    return [TuiMsg.QuitRequested]
  end;
  case TuiRouteButtonMnemonicKey(Root, Key) of
    Some(Messages):
    begin
      return Messages
    end;
    None:
    begin
    end
  end;
  var Controls: array of TuiControlId := TuiFocusableControls(Root);
  if Std.Array.Length(Controls) = 0 then
  begin
    return [TuiMsg.Key(Key)]
  end;
  var Previous: option of TuiControlId := TuiRootFocus(Root);
  mutable var CurrentIndex: integer := -1;
  case Previous of
    Some(Id):
    begin
      CurrentIndex := TuiControlIndex(Controls, Id)
    end;
    None:
    begin
    end
  end;
  mutable var Routed: array of TuiMsg := [];
  mutable var Target: TuiControlId := Controls[0];
  if CurrentIndex >= 0 then
  begin
    Target := Controls[CurrentIndex]
  end
  else
  begin
    Std.Array.Push(Routed, TuiMsg.FocusChanged(Previous, Some(Target)))
  end;
  if Key.kind = Std.Console.KeyKind.Tab then
  begin
    if CurrentIndex >= 0 then
    begin
      case TuiRouteTarget(Frame, Root, 0, Target, Key) of
        Some(Msg):
        begin
          return [Msg]
        end;
        None:
        begin
        end
      end
    end;
    mutable var NextIndex: integer := CurrentIndex + 1;
    if NextIndex >= Std.Array.Length(Controls) then
    begin
      NextIndex := 0
    end;
    return [TuiMsg.FocusChanged(Previous, Some(Controls[NextIndex]))]
  end;
  case TuiRouteButtonFocusNavigation(Root, Previous, Key) of
    Some(Messages):
    begin
      return Messages
    end;
    None:
    begin
    end
  end;
  case TuiRouteTarget(Frame, Root, 0, Target, Key) of
    Some(Msg):
    begin
      Std.Array.Push(Routed, Msg)
    end;
    None:
    begin
      if Key.kind = Std.Console.KeyKind.Enter then
      begin
        case TuiRouteDefaultButtonEnter(Root) of
          Some(Msg):
          begin
            Std.Array.Push(Routed, Msg);
            return Routed
          end;
          None:
          begin
          end
        end
      end;
      Std.Array.Push(Routed, TuiMsg.Key(Key))
    end
  end;
  return Routed
end;
