unit Std.Tui.Runtime.Routing.Key;

uses
  Std.Console as Console, Std.Tui.Chrome.StatusItem as StatusItem,
  Std.Tui.Elements.Element as Element, Std.Tui.Geometry.Point as Point,
  Std.Tui.Geometry.Size as Size, Std.Tui.Ids.ControlId as ControlId,
  Std.Tui.Layout.Frame as LayoutFrame, Std.Tui.Layout.Measure as Measure,
  Std.Tui.Layout.MeasureSpec as MeasureSpec, Std.Tui.Runtime.Msg as RuntimeMsg,
  Std.Tui.Runtime.Routing.Button as RoutingButton, Std.Tui.Runtime.Routing.Focus as Focus,
  Std.Tui.Runtime.Routing.Menu as Menu, Std.Tui.Runtime.Routing.FocusNavigation as FocusNavigation,
  Std.Tui.Runtime.Routing.Input as RoutingInput, Std.Tui.Runtime.Routing.TextArea as TextArea;

function TuiScrollClamp(Value: integer; Maximum: integer): integer;
begin
  if Value < 0 then
    begin
      return 0;
    end;
  end if;

  if Value > Maximum then
    begin
      return Maximum;
    end;
  end if;

  return Value;
end function;

function TuiRouteSubtreeEnd(Node: Element.TuiElement; Index: integer): integer;
begin
  var Next: integer := Index + 1;
  var Descendants: array of Element.TuiElement := [];
  case Node of
    when Element.TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Row(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Column(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Layout(const Settings, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Panel(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Overlay(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Desktop(const Focused, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.Menu(_, _, _, _), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Spacer(_):
      null;
  end case;

  for ChildIndex: integer := 0 to Descendants.Length() - 1 do
    begin
      Next := TuiRouteSubtreeEnd(Descendants[ChildIndex], Next);
    end;
  end for;

  return Next;
end function;

function TuiRouteTarget(
  Frame: LayoutFrame.TuiArrangedFrame;
  Node: Element.TuiElement;
  Index: integer;
  Target: ControlId.TuiControlId;
  Key: Console.KeyEvent
): option of RuntimeMsg.TuiMsg;
begin
  var Descendants: array of Element.TuiElement := [];
  case Node of
    when Element.TuiElement.Button(const Button):
      begin
        return RoutingButton.TuiRouteFocusedButtonKey(Button, Target, Key);
      end;
    when Element.TuiElement.Input(const Input):
      begin
        return RoutingInput.TuiRouteInputKey(Input, Target, Key);
      end;
    when Element.TuiElement.TextArea(const Id, const Text, const Caret, const Offset, const ChangeAction):
      begin
        if Id.Value <> Target.Value then
          begin
            return None;
          end;
        end if;

        return TextArea.TuiRouteTextAreaKey(
          Id,
          Text,
          Caret,
          Offset,
          ChangeAction,
          Frame.EntryAt(Index).Bounds,
          Key
        );
      end;
    when Element.TuiElement.CheckBox(const Id, const Text, const Checked, const ChangeAction):
      begin
        if Id.Value <> Target.Value then
          begin
            return None;
          end;
        end if;

        if (Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space) then
          begin
            return Some(RuntimeMsg.TuiMsg.CheckChanged(Id, ChangeAction, not Checked));
          end;
        end if;

        return None;
      end;
    when Element.TuiElement.List(const Id, const Items, const Selected, const ChangeAction):
      begin
        if Id.Value <> Target.Value then
          begin
            return None;
          end;
        end if;
        const Count: integer := Items.Length();
        if Count = 0 then
          begin
            return None;
          end;
        end if;
        var NextSelected: integer := Selected;
        if Key.kind = Console.KeyKind.Up then
          begin
            NextSelected := Selected - 1;
            if NextSelected < 0 then
              begin
                NextSelected := 0;
              end;
            end if;
          end;
        elsif Key.kind = Console.KeyKind.Down then
          begin
            NextSelected := Selected + 1;
            if NextSelected >= Count then
              begin
                NextSelected := Count - 1;
              end;
            end if;
          end;
        elsif Key.kind = Console.KeyKind.Home then
          begin
            NextSelected := 0;
          end;
        elsif Key.kind = Console.KeyKind.EndKey then
          begin
            NextSelected := Count - 1;
          end;
        else
          begin
            return None;
          end;
        end if;

        if NextSelected = Selected then
          begin
            return None;
          end;
        end if;

        return Some(RuntimeMsg.TuiMsg.SelectionChanged(Id, ChangeAction, NextSelected));
      end;
    when Element.TuiElement.MenuBar(const Items):
      begin
        for ItemIndex: integer := 0 to Items.Length() - 1 do
          begin
            if (Items[ItemIndex].Id.Value = Target.Value) and Items[ItemIndex].Enabled then
              begin
                if (Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space) then
                  begin
                    return Some(
                      RuntimeMsg.TuiMsg.Action(Items[ItemIndex].Id, Items[ItemIndex].Action)
                    );
                  end;
                end if;

                return None;
              end;
            end if;
          end;
        end for;

        return None;
      end;
    when Element.TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        return None;
      end;
    when Element.TuiElement.StatusLine(const Items):
      begin
        for ItemIndex: integer := 0 to Items.Length() - 1 do
          begin
            case Items[ItemIndex] of
              when StatusItem.TuiStatusItem.Command(const Id, const Text, const Action, const Enabled):
                begin
                  if (Id.Value = Target.Value) and Enabled then
                    begin
                      if (Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space) then
                        begin
                          return Some(RuntimeMsg.TuiMsg.Action(Id, Action));
                        end;
                      end if;

                      return None;
                    end;
                  end if;
                end;
              when StatusItem.TuiStatusItem.Hint(_), StatusItem.TuiStatusItem.KeyHint(_, _):
                null;
            end case;
          end;
        end for;

        return None;
      end;
    when Element.TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        if Id.Value = Target.Value then
          begin
            var Content: Size.TuiSize := Size.TuiSize.Create(0, 0);
            if Children.Length() = 1 then
              begin
                Content := Measure.TuiMeasure(
                  Children[0],
                  MeasureSpec.TuiMeasureSpec.Unbounded()
                ).Preferred;
              end;
            end if;
            const Viewport: LayoutFrame.TuiArrangedEntry := Frame.EntryAt(Index);
            var MaximumX: integer := Content.Width - Viewport.Bounds.Width;
            var MaximumY: integer := Content.Height - Viewport.Bounds.Height;
            if MaximumX < 0 then
              begin
                MaximumX := 0;
              end;
            end if;

            if MaximumY < 0 then
              begin
                MaximumY := 0;
              end;
            end if;
            var NextOffset: Point.TuiPoint := Offset;
            if Key.kind = Console.KeyKind.Left then
              begin
                NextOffset.X := TuiScrollClamp(Offset.X - 1, MaximumX);
              end;
            elsif Key.kind = Console.KeyKind.Right then
              begin
                NextOffset.X := TuiScrollClamp(Offset.X + 1, MaximumX);
              end;
            elsif Key.kind = Console.KeyKind.Up then
              begin
                NextOffset.Y := TuiScrollClamp(Offset.Y - 1, MaximumY);
              end;
            elsif Key.kind = Console.KeyKind.Down then
              begin
                NextOffset.Y := TuiScrollClamp(Offset.Y + 1, MaximumY);
              end;
            elsif Key.kind = Console.KeyKind.PageUp then
              begin
                NextOffset.Y := TuiScrollClamp(Offset.Y - Viewport.Bounds.Height, MaximumY);
              end;
            elsif Key.kind = Console.KeyKind.PageDown then
              begin
                NextOffset.Y := TuiScrollClamp(Offset.Y + Viewport.Bounds.Height, MaximumY);
              end;
            elsif Key.kind = Console.KeyKind.Home then
              begin
                NextOffset.Y := 0;
              end;
            elsif Key.kind = Console.KeyKind.EndKey then
              begin
                NextOffset.Y := MaximumY;
              end;
            else
              begin
                return None;
              end;
            end if;

            if (NextOffset.X = Offset.X) and (NextOffset.Y = Offset.Y) then
              begin
                return None;
              end;
            end if;

            return Some(RuntimeMsg.TuiMsg.ScrollChanged(Id, ChangeAction, NextOffset));
          end;
        end if;

        Descendants := Children;
      end;
    when Element.TuiElement.Row(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Column(const Children, const Spacing):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Layout(const Settings, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Panel(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Overlay(const Title, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Desktop(const Focused, const Children):
      begin
        Descendants := Children;
      end;
    when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Spacer(_):
      begin
        return None;
      end;
  end case;
  var Next: integer := Index + 1;
  for ChildIndex: integer := 0 to Descendants.Length() - 1 do
    begin
      case TuiRouteTarget(Frame, Descendants[ChildIndex], Next, Target, Key) of
        when Some(const Msg):
          begin
            return Some(Msg);
          end;
        when None:
          begin
          end;
      end case;

      Next := TuiRouteSubtreeEnd(Descendants[ChildIndex], Next);
    end;
  end for;

  return None;
end function;

// Routes one key against the previous rendered tree into ordered framework messages.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Frame`: Arranged frame containing element geometry.
// - `Key`: Console key event to route or match.
public function TuiRouteKey(
  Root: Element.TuiElement;
  Frame: LayoutFrame.TuiArrangedFrame;
  Key: Console.KeyEvent
): array of RuntimeMsg.TuiMsg;
begin
  Focus.TuiRouteRequireMatchingFrame(Frame, Root);
  case Menu.TuiRouteMenuKey(Root, Key) of
    when Some(const Messages):
      begin
        return Messages;
      end;
    when None:
      begin
      end;
  end case;

  if Key.kind = Console.KeyKind.Escape then
    begin
      return [RuntimeMsg.TuiMsg.QuitRequested];
    end;
  end if;

  case RoutingButton.TuiRouteButtonMnemonicKey(Root, Key) of
    when Some(const Messages):
      begin
        return Messages;
      end;
    when None:
      begin
      end;
  end case;
  const Controls: array of ControlId.TuiControlId := Focus.TuiFocusableControls(Root);
  if Controls.Length() = 0 then
    begin
      return [RuntimeMsg.TuiMsg.Key(Key)];
    end;
  end if;
  const Previous: option of ControlId.TuiControlId := Focus.TuiRootFocus(Root);
  var CurrentIndex: integer := -1;
  case Previous of
    when Some(const Id):
      begin
        CurrentIndex := Focus.TuiControlIndex(Controls, Id);
      end;
    when None:
      begin
      end;
  end case;
  var Routed: array of RuntimeMsg.TuiMsg := [];
  var Target: ControlId.TuiControlId := Controls[0];
  if CurrentIndex >= 0 then
    begin
      Target := Controls[CurrentIndex];
    end;
  else
    begin
      Routed.PushInPlace(RuntimeMsg.TuiMsg.FocusChanged(Previous, Some(Target)));
    end;
  end if;

  if Key.kind = Console.KeyKind.Tab then
    begin
      if CurrentIndex >= 0 then
        begin
          case TuiRouteTarget(Frame, Root, 0, Target, Key) of
            when Some(const Msg):
              begin
                return [Msg];
              end;
            when None:
              begin
              end;
          end case;
        end;
      end if;
      var NextIndex: integer := CurrentIndex + 1;
      if NextIndex >= Controls.Length() then
        begin
          NextIndex := 0;
        end;
      end if;

      return [RuntimeMsg.TuiMsg.FocusChanged(Previous, Some(Controls[NextIndex]))];
    end;
  end if;

  case FocusNavigation.TuiRouteButtonFocusNavigation(Root, Previous, Key) of
    when Some(const Messages):
      begin
        return Messages;
      end;
    when None:
      begin
      end;
  end case;

  case TuiRouteTarget(Frame, Root, 0, Target, Key) of
    when Some(const Msg):
      begin
        Routed.PushInPlace(Msg);
      end;
    when None:
      begin
        if Key.kind = Console.KeyKind.Enter then
          begin
            case RoutingButton.TuiRouteDefaultButtonEnter(Root) of
              when Some(const Msg):
                begin
                  Routed.PushInPlace(Msg);
                  return Routed;
                end;
              when None:
                begin
                end;
            end case;
          end;
        end if;

        Routed.PushInPlace(RuntimeMsg.TuiMsg.Key(Key));
      end;
  end case;

  return Routed;
end function;
end unit;
