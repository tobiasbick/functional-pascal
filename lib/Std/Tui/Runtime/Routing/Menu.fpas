unit Std.Tui.Runtime.Routing.Menu;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Tui.Chrome.MenuNode as MenuNode;
uses Std.Tui.Chrome.MenuQuery as MenuQuery;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Ids.Action as Action2;
uses Std.Tui.Ids.ControlId as ControlId;
uses Std.Tui.Runtime.Msg as Msg;
uses Std.Tui.Runtime.Routing.Focus as Focus;
uses Std.Tui.Chrome.KeyGesture as KeyGesture;

// One controlled menu found in the active routing subtree.
public type TuiRouteMenu = record
  // Stable identifier of the value.
  public Id: ControlId.TuiControlId;
  // Flat ordered menu-node collection.
  public Nodes: array of (MenuNode.TuiMenuNode);
  // Controlled menu state.
  public State: MenuNode.TuiMenuState;
  // Action emitted when the controlled value changes.
  public ChangeAction: Action2.TuiAction;
end record;

function TuiFindRouteMenu(Node: Element.TuiElement): Option of (TuiRouteMenu);
begin
  case Node of
    when Element.TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        return Option.Some(TuiRouteMenu(Id := Id, Nodes := Nodes, State := State, ChangeAction := ChangeAction));
      end;
    when Element.TuiElement.Desktop(const Focused, const Children):
      begin
        var LastOverlay: integer := -1;
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case Children[Index] of
              when Element.TuiElement.Overlay(const Title, const OverlayChildren):
                begin
                  LastOverlay := Index;
                end;
              when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.Scroll(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.Menu(_, _, _, _), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Row(_, _), Element.TuiElement.Column(_, _), Element.TuiElement.Layout(_, _), Element.TuiElement.Spacer(_), Element.TuiElement.Panel(_, _), Element.TuiElement.Desktop(_, _):
                begin
                  begin
                    null;
                  end;
                end;
            end case;
          end;
        end for;

        if LastOverlay >= 0 then
          begin
            return TuiFindRouteMenu(Children[LastOverlay]);
          end;
        end if;

        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Option.Some(const Menu):
                begin
                  return Option.Some(Menu);
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return Option.None;
      end;
    when Element.TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Option.Some(const Menu):
                begin
                  return Option.Some(Menu);
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return Option.None;
      end;
    when Element.TuiElement.Row(const Children, const Spacing):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Option.Some(const Menu):
                begin
                  return Option.Some(Menu);
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return Option.None;
      end;
    when Element.TuiElement.Column(const Children, const Spacing):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Option.Some(const Menu):
                begin
                  return Option.Some(Menu);
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return Option.None;
      end;
    when Element.TuiElement.Layout(const Settings, const Children):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Option.Some(const Menu):
                begin
                  return Option.Some(Menu);
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return Option.None;
      end;
    when Element.TuiElement.Panel(const Title, const Children):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Option.Some(const Menu):
                begin
                  return Option.Some(Menu);
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return Option.None;
      end;
    when Element.TuiElement.Overlay(const Title, const Children):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Option.Some(const Menu):
                begin
                  return Option.Some(Menu);
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return Option.None;
      end;
    when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Spacer(_):
      begin
        begin
          return Option.None;
        end;
      end;
  end case;
end function;

function TuiMenuChange(Menu: TuiRouteMenu; State: MenuNode.TuiMenuState): Msg.TuiMsg;
begin
  return Msg.TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, State);
end function;

function TuiMenuOpenFirst(Menu: TuiRouteMenu; Previous: Option of (ControlId.TuiControlId)): array of (Msg.TuiMsg);
begin
  case MenuQuery.TuiMenuFirstSelectable(Menu.Nodes, Option.None) of
    when Option.Some(const First):
      begin
        var Messages: array of (Msg.TuiMsg) := [];
        if not Focus.TuiFocusMatches(Previous, Menu.Id) then
          begin
            Arrays.Push(var Messages, Msg.TuiMsg.FocusChanged(Previous, Option.Some(Menu.Id)));
          end;
        end if;

        Arrays.Push(var Messages, TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(First)));
        return Messages;
      end;
    when Option.None:
      begin
        return [];
      end;
  end case;
end function;

function TuiMenuCommandMessages(Menu: TuiRouteMenu; Node: MenuNode.TuiMenuNode): array of (Msg.TuiMsg);
begin
  case MenuQuery.TuiMenuNodeAction(Node) of
    when Option.Some(const Action):
      begin
        if Menu.State.Open then
          begin
            return [
                     TuiMenuChange(Menu, MenuNode.TuiMenuStateClosed()),
                     Msg.TuiMsg.Action(Menu.Id, Action)
                   ];
          end;
        end if;

        return [Msg.TuiMsg.Action(Menu.Id, Action)];
      end;
    when Option.None:
      begin
        return [];
      end;
  end case;
end function;

function TuiMenuShortcut(Menu: TuiRouteMenu; Key: Console.KeyEvent): Option of (array of (Msg.TuiMsg));
begin
  for Index: integer := 0 to Arrays.Length(Menu.Nodes) - 1 do
    begin
      if MenuQuery.TuiMenuNodeSelectable(Menu.Nodes[Index]) then
        begin
          case MenuQuery.TuiMenuNodeShortcut(Menu.Nodes[Index]) of
            when Option.Some(const Shortcut):
              begin
                if KeyGesture.TuiKeyGestureMatches(Shortcut, Key) then
                  begin
                    return Option.Some(TuiMenuCommandMessages(Menu, Menu.Nodes[Index]));
                  end;
                end if;
              end;
            when Option.None:
              begin
                null;
              end;
          end case;
        end;
      end if;
    end;
  end for;

  return Option.None;
end function;

function TuiMenuMnemonic(
  Menu: TuiRouteMenu;
  Key: Console.KeyEvent;
  Parent: Option of (MenuNode.TuiMenuNodeId)
): Option of (array of (Msg.TuiMsg));
begin
  if Key.kind <> Console.KeyKind.Character then
    begin
      return Option.None;
    end;
  end if;

  for Index: integer := 0 to Arrays.Length(Menu.Nodes) - 1 do
    begin
      if ((MenuQuery.TuiMenuHasParent(Menu.Nodes[Index], Parent) and MenuQuery.TuiMenuNodeSelectable(Menu.Nodes[Index])) and (MenuQuery.TuiMenuNodeMnemonic(Menu.Nodes[Index]) <> '')) and
         (Str.ToLower(MenuQuery.TuiMenuNodeMnemonic(Menu.Nodes[Index])) = Str.ToLower(Key.ch)) then
        begin
          if MenuQuery.TuiMenuNodeIsSubmenu(Menu.Nodes[Index]) then
            begin
              return Option.Some([
                                   TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(MenuQuery.TuiMenuNodeIdOf(Menu.Nodes[Index])))
                                 ]);
            end;
          end if;

          return Option.Some(TuiMenuCommandMessages(Menu, Menu.Nodes[Index]));
        end;
      end if;
    end;
  end for;

  return Option.None;
end function;

function TuiMenuRouteOpen(Menu: TuiRouteMenu; Key: Console.KeyEvent): Option of (array of (Msg.TuiMsg));
begin
  if Key.kind = Console.KeyKind.Escape then
    begin
      return Option.Some([TuiMenuChange(Menu, MenuNode.TuiMenuStateClosed())]);
    end;
  end if;

  case Menu.State.Active of
    when Option.Some(const Active):
      begin
        const ActiveIndex: integer := MenuQuery.TuiMenuFind(Menu.Nodes, Active);
        const Parent: Option of (MenuNode.TuiMenuNodeId) := MenuQuery.TuiMenuNodeParent(Menu.Nodes[ActiveIndex]);
        case TuiMenuMnemonic(Menu, Key, Parent) of
          when Option.Some(const Messages):
            begin
              return Option.Some(Messages);
            end;
          when Option.None:
            begin
              null;
            end;
        end case;

        if (Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space) then
          begin
            if MenuQuery.TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
              begin
                case MenuQuery.TuiMenuFirstSelectable(Menu.Nodes, Option.Some(Active)) of
                  when Option.Some(const Child):
                    begin
                      return Option.Some([TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(Child))]);
                    end;
                  when Option.None:
                    begin
                      return Option.Some([]);
                    end;
                end case;
              end;
            end if;

            return Option.Some(TuiMenuCommandMessages(Menu, Menu.Nodes[ActiveIndex]));
          end;
        end if;

        if (Key.kind = Console.KeyKind.Down) or (Key.kind = Console.KeyKind.Up) then
          begin
            if (Key.kind = Console.KeyKind.Down) and
               MenuQuery.TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
              begin
                case MenuQuery.TuiMenuFirstSelectable(Menu.Nodes, Option.Some(Active)) of
                  when Option.Some(const Child):
                    begin
                      return Option.Some([TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(Child))]);
                    end;
                  when Option.None:
                    begin
                      null;
                    end;
                end case;
              end;
            end if;
            var Direction: integer := -1;
            if Key.kind = Console.KeyKind.Down then
              begin
                Direction := 1;
              end;
            end if;

            case MenuQuery.TuiMenuNextSelectable(Menu.Nodes, Active, Direction) of
              when Option.Some(const Next):
                begin
                  return Option.Some([TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(Next))]);
                end;
              when Option.None:
                begin
                  return Option.Some([]);
                end;
            end case;
          end;
        end if;

        if Key.kind = Console.KeyKind.Right then
          begin
            if MenuQuery.TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
              begin
                case MenuQuery.TuiMenuFirstSelectable(Menu.Nodes, Option.Some(Active)) of
                  when Option.Some(const Child):
                    begin
                      return Option.Some([TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(Child))]);
                    end;
                  when Option.None:
                    begin
                      null;
                    end;
                end case;
              end;
            end if;

            case MenuQuery.TuiMenuRootOf(Menu.Nodes, Active) of
              when Option.Some(const Root):
                begin
                  case MenuQuery.TuiMenuNextSelectable(Menu.Nodes, Root, 1) of
                    when Option.Some(const NextRoot):
                      begin
                        return Option.Some([
                                             TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(NextRoot))
                                           ]);
                      end;
                    when Option.None:
                      begin
                        null;
                      end;
                  end case;
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end if;

        if Key.kind = Console.KeyKind.Left then
          begin
            case Parent of
              when Option.Some(const ParentId):
                begin
                  const ParentIndex: integer := MenuQuery.TuiMenuFind(Menu.Nodes, ParentId);
                  case MenuQuery.TuiMenuNodeParent(Menu.Nodes[ParentIndex]) of
                    when Option.Some(const GrandParent):
                      begin
                        return Option.Some([
                                             TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(ParentId))
                                           ]);
                      end;
                    when Option.None:
                      begin
                        case MenuQuery.TuiMenuNextSelectable(Menu.Nodes, ParentId, -1) of
                          when Option.Some(const NextRoot):
                            begin
                              return Option.Some([
                                                   TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(NextRoot))
                                                 ]);
                            end;
                          when Option.None:
                            begin
                              null;
                            end;
                        end case;
                      end;
                  end case;
                end;
              when Option.None:
                begin
                  case MenuQuery.TuiMenuNextSelectable(Menu.Nodes, Active, -1) of
                    when Option.Some(const NextRoot):
                      begin
                        return Option.Some([
                                             TuiMenuChange(Menu, MenuNode.TuiMenuStateOpenAt(NextRoot))
                                           ]);
                      end;
                    when Option.None:
                      begin
                        null;
                      end;
                  end case;
                end;
            end case;
          end;
        end if;
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  return Option.None;
end function;

// Routes menu shortcuts, F10, mnemonics, and open-menu navigation.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Key`: Console key event to route or match.
public function TuiRouteMenuKey(Root: Element.TuiElement; Key: Console.KeyEvent): Option of (array of (Msg.TuiMsg));
begin
  case TuiFindRouteMenu(Root) of
    when Option.Some(const Menu):
      begin
        case TuiMenuShortcut(Menu, Key) of
          when Option.Some(const Messages):
            begin
              return Option.Some(Messages);
            end;
          when Option.None:
            begin
              null;
            end;
        end case;

        if Menu.State.Open then
          begin
            return TuiMenuRouteOpen(Menu, Key);
          end;
        end if;

        if Key.kind = Console.KeyKind.F10 then
          begin
            return Option.Some(TuiMenuOpenFirst(Menu, Focus.TuiRootFocus(Root)));
          end;
        end if;

        if Key.alt then
          begin
            case TuiMenuMnemonic(Menu, Key, Option.None) of
              when Option.Some(const Messages):
                begin
                  var FocusMessages: array of (Msg.TuiMsg) := [];
                  if not Focus.TuiFocusMatches(Focus.TuiRootFocus(Root), Menu.Id) then
                    begin
                      Arrays.Push(var FocusMessages, Msg.TuiMsg.FocusChanged(Focus.TuiRootFocus(Root), Option.Some(Menu.Id)));
                    end;
                  end if;

                  return Option.Some(Arrays.Concat(FocusMessages, Messages));
                end;
              when Option.None:
                begin
                  null;
                end;
            end case;
          end;
        end if;

        if Focus.TuiFocusMatches(Focus.TuiRootFocus(Root), Menu.Id) and
           (((Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space)) or (Key.kind = Console.KeyKind.Down)) then
          begin
            return Option.Some(TuiMenuOpenFirst(Menu, Focus.TuiRootFocus(Root)));
          end;
        end if;

        return Option.None;
      end;
    when Option.None:
      begin
        return Option.None;
      end;
  end case;
end function;

end unit;
