unit Std.Tui.Runtime.Routing.Menu;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Tui.Chrome.MenuNode as MenuNode;
uses Std.Tui.Chrome.MenuQuery as MenuQuery;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Ids.Action as Action2;
uses Std.Tui.Ids.ControlId as ControlId;
uses Std.Tui.Runtime.Msg as Msg;
uses Std.Tui.Runtime.Routing.Focus as Focus;

// One controlled menu found in the active routing subtree.
public type TuiRouteMenu = record
  // Stable identifier of the value.
  public Id: ControlId.TuiControlId;
  // Flat ordered menu-node collection.
  public Nodes: array of MenuNode.TuiMenuNode;
  // Controlled menu state.
  public State: MenuNode.TuiMenuState;
  // Action emitted when the controlled value changes.
  public ChangeAction: Action2.TuiAction;
end record;

function TuiFindRouteMenu(Node: Element.TuiElement): option of TuiRouteMenu;
begin
  case Node of
    when Element.TuiElement.Menu(Id, Nodes, State, ChangeAction):
      begin
        return Some(record
          Id := Id;
          Nodes := Nodes;
          State := State;
          ChangeAction := ChangeAction;
        end record);
      end;
    when Element.TuiElement.Desktop(Focused, Children):
      begin
        mutable var LastOverlay: integer := -1;
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case Children[Index] of
              when Element.TuiElement.Overlay(Title, OverlayChildren):
                begin
                  LastOverlay := Index;
                end;
              else
                begin
                  null;
                end;
            end case;
          end;
        end for;

        if LastOverlay >= 0 then
          begin
            return TuiFindRouteMenu(Children[LastOverlay]);
          end;
        end if;

        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when Element.TuiElement.Scroll(Id, Offset, ChangeAction, Children):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when Element.TuiElement.Row(Children, Spacing):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when Element.TuiElement.Column(Children, Spacing):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when Element.TuiElement.Layout(Settings, Children):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when Element.TuiElement.Panel(Title, Children):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when Element.TuiElement.Overlay(Title, Children):
      begin
        for Index: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end for;

        return None;
      end;
    else
      begin
        return None;
      end;
  end case;
end function;

function TuiMenuChange(Menu: TuiRouteMenu; State: MenuNode.TuiMenuState): Msg.TuiMsg;
begin
  return Msg.TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, State);
end function;

function TuiMenuOpenFirst(Menu: TuiRouteMenu; Previous: option of ControlId.TuiControlId): array of Msg.TuiMsg;
begin
  case MenuQuery.TuiMenuFirstSelectable(Menu.Nodes, None) of
    when Some(First):
      begin
        mutable var Messages: array of Msg.TuiMsg := [];
        if not Focus.TuiFocusMatches(Previous, Menu.Id) then
          begin
            Arrays.Push(Messages, Msg.TuiMsg.FocusChanged(Previous, Some(Menu.Id)));
          end;
        end if;

        Arrays.Push(Messages, TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(First)));
        return Messages;
      end;
    when None:
      begin
        return [];
      end;
  end case;
end function;

function TuiMenuCommandMessages(Menu: TuiRouteMenu; Node: MenuNode.TuiMenuNode): array of Msg.TuiMsg;
begin
  case MenuQuery.TuiMenuNodeAction(Node) of
    when Some(Action):
      begin
        if Menu.State.Open then
          begin
            return [
                     TuiMenuChange(Menu, MenuNode.TuiMenuState.Closed()),
                     Msg.TuiMsg.Action(Menu.Id, Action)
                   ];
          end;
        end if;

        return [Msg.TuiMsg.Action(Menu.Id, Action)];
      end;
    when None:
      begin
        return [];
      end;
  end case;
end function;

function TuiMenuShortcut(Menu: TuiRouteMenu; Key: Console.KeyEvent): option of array of Msg.TuiMsg;
begin
  for Index: integer := 0 to Arrays.Length(Menu.Nodes) - 1 do
    begin
      if MenuQuery.TuiMenuNodeSelectable(Menu.Nodes[Index]) then
        begin
          case MenuQuery.TuiMenuNodeShortcut(Menu.Nodes[Index]) of
            when Some(Shortcut):
              begin
                if Shortcut.Matches(Key) then
                  begin
                    return Some(TuiMenuCommandMessages(Menu, Menu.Nodes[Index]));
                  end;
                end if;
              end;
            when None:
              begin
                null;
              end;
          end case;
        end;
      end if;
    end;
  end for;

  return None;
end function;

function TuiMenuMnemonic(
  Menu: TuiRouteMenu;
  Key: Console.KeyEvent;
  Parent: option of MenuNode.TuiMenuNodeId
): option of array of Msg.TuiMsg;
begin
  if Key.kind <> Console.KeyKind.Character then
    begin
      return None;
    end;
  end if;

  for Index: integer := 0 to Arrays.Length(Menu.Nodes) - 1 do
    begin
      if ((MenuQuery.TuiMenuHasParent(Menu.Nodes[Index], Parent) and MenuQuery.TuiMenuNodeSelectable(Menu.Nodes[Index])) and (MenuQuery.TuiMenuNodeMnemonic(Menu.Nodes[Index]) <> '')) and
         (Str.ToLower(MenuQuery.TuiMenuNodeMnemonic(Menu.Nodes[Index])) = Str.ToLower(Key.ch)) then
        begin
          if MenuQuery.TuiMenuNodeIsSubmenu(Menu.Nodes[Index]) then
            begin
              return Some([
                            TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(MenuQuery.TuiMenuNodeIdOf(Menu.Nodes[Index])))
                          ]);
            end;
          end if;

          return Some(TuiMenuCommandMessages(Menu, Menu.Nodes[Index]));
        end;
      end if;
    end;
  end for;

  return None;
end function;

function TuiMenuRouteOpen(Menu: TuiRouteMenu; Key: Console.KeyEvent): option of array of Msg.TuiMsg;
begin
  if Key.kind = Console.KeyKind.Escape then
    begin
      return Some([TuiMenuChange(Menu, MenuNode.TuiMenuState.Closed())]);
    end;
  end if;

  case Menu.State.Active of
    when Some(Active):
      begin
        var ActiveIndex: integer := MenuQuery.TuiMenuFind(Menu.Nodes, Active);
        var Parent: option of MenuNode.TuiMenuNodeId := MenuQuery.TuiMenuNodeParent(Menu.Nodes[ActiveIndex]);
        case TuiMenuMnemonic(Menu, Key, Parent) of
          when Some(Messages):
            begin
              return Some(Messages);
            end;
          when None:
            begin
              null;
            end;
        end case;

        if (Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space) then
          begin
            if MenuQuery.TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
              begin
                case MenuQuery.TuiMenuFirstSelectable(Menu.Nodes, Some(Active)) of
                  when Some(Child):
                    begin
                      return Some([TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(Child))]);
                    end;
                  when None:
                    begin
                      return Some([]);
                    end;
                end case;
              end;
            end if;

            return Some(TuiMenuCommandMessages(Menu, Menu.Nodes[ActiveIndex]));
          end;
        end if;

        if (Key.kind = Console.KeyKind.Down) or (Key.kind = Console.KeyKind.Up) then
          begin
            if (Key.kind = Console.KeyKind.Down) and
               MenuQuery.TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
              begin
                case MenuQuery.TuiMenuFirstSelectable(Menu.Nodes, Some(Active)) of
                  when Some(Child):
                    begin
                      return Some([TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(Child))]);
                    end;
                  when None:
                    begin
                      null;
                    end;
                end case;
              end;
            end if;
            mutable var Direction: integer := -1;
            if Key.kind = Console.KeyKind.Down then
              begin
                Direction := 1;
              end;
            end if;

            case MenuQuery.TuiMenuNextSelectable(Menu.Nodes, Active, Direction) of
              when Some(Next):
                begin
                  return Some([TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(Next))]);
                end;
              when None:
                begin
                  return Some([]);
                end;
            end case;
          end;
        end if;

        if Key.kind = Console.KeyKind.Right then
          begin
            if MenuQuery.TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
              begin
                case MenuQuery.TuiMenuFirstSelectable(Menu.Nodes, Some(Active)) of
                  when Some(Child):
                    begin
                      return Some([TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(Child))]);
                    end;
                  when None:
                    begin
                      null;
                    end;
                end case;
              end;
            end if;

            case MenuQuery.TuiMenuRootOf(Menu.Nodes, Active) of
              when Some(Root):
                begin
                  case MenuQuery.TuiMenuNextSelectable(Menu.Nodes, Root, 1) of
                    when Some(NextRoot):
                      begin
                        return Some([TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(NextRoot))]);
                      end;
                    when None:
                      begin
                        null;
                      end;
                  end case;
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end if;

        if Key.kind = Console.KeyKind.Left then
          begin
            case Parent of
              when Some(ParentId):
                begin
                  var ParentIndex: integer := MenuQuery.TuiMenuFind(Menu.Nodes, ParentId);
                  case MenuQuery.TuiMenuNodeParent(Menu.Nodes[ParentIndex]) of
                    when Some(GrandParent):
                      begin
                        return Some([TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(ParentId))]);
                      end;
                    when None:
                      begin
                        case MenuQuery.TuiMenuNextSelectable(Menu.Nodes, ParentId, -1) of
                          when Some(NextRoot):
                            begin
                              return Some([
                                            TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(NextRoot))
                                          ]);
                            end;
                          when None:
                            begin
                              null;
                            end;
                        end case;
                      end;
                  end case;
                end;
              when None:
                begin
                  case MenuQuery.TuiMenuNextSelectable(Menu.Nodes, Active, -1) of
                    when Some(NextRoot):
                      begin
                        return Some([TuiMenuChange(Menu, MenuNode.TuiMenuState.OpenAt(NextRoot))]);
                      end;
                    when None:
                      begin
                        null;
                      end;
                  end case;
                end;
            end case;
          end;
        end if;
      end;
    when None:
      begin
        null;
      end;
  end case;

  return None;
end function;

// Routes menu shortcuts, F10, mnemonics, and open-menu navigation.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Key`: Console key event to route or match.
public function TuiRouteMenuKey(Root: Element.TuiElement; Key: Console.KeyEvent): option of array of Msg.TuiMsg;
begin
  case TuiFindRouteMenu(Root) of
    when Some(Menu):
      begin
        case TuiMenuShortcut(Menu, Key) of
          when Some(Messages):
            begin
              return Some(Messages);
            end;
          when None:
            begin
              null;
            end;
        end case;

        if Menu.State.Open then
          begin
            return TuiMenuRouteOpen(Menu, Key);
          end;
        end if;

        if Key.kind = Console.KeyKind.F10 then
          begin
            return Some(TuiMenuOpenFirst(Menu, Focus.TuiRootFocus(Root)));
          end;
        end if;

        if Key.alt then
          begin
            case TuiMenuMnemonic(Menu, Key, None) of
              when Some(Messages):
                begin
                  mutable var FocusMessages: array of Msg.TuiMsg := [];
                  if not Focus.TuiFocusMatches(Focus.TuiRootFocus(Root), Menu.Id) then
                    begin
                      Arrays.Push(FocusMessages, Msg.TuiMsg.FocusChanged(Focus.TuiRootFocus(Root), Some(Menu.Id)));
                    end;
                  end if;

                  return Some(Arrays.Concat(FocusMessages, Messages));
                end;
              when None:
                begin
                  null;
                end;
            end case;
          end;
        end if;

        if Focus.TuiFocusMatches(Focus.TuiRootFocus(Root), Menu.Id) and
           (((Key.kind = Console.KeyKind.Enter) or (Key.kind = Console.KeyKind.Space)) or (Key.kind = Console.KeyKind.Down)) then
          begin
            return Some(TuiMenuOpenFirst(Menu, Focus.TuiRootFocus(Root)));
          end;
        end if;

        return None;
      end;
    when None:
      begin
        return None;
      end;
  end case;
end function;

end unit;
