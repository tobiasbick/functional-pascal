unit Std.Tui.Runtime.Routing.Menu;

uses
  Std.Arrays, Std.Console, Std.Str, Std.Tui.Chrome.MenuNode, Std.Tui.Chrome.MenuQuery,
  Std.Tui.Elements.Element, Std.Tui.Ids.Action, Std.Tui.Ids.ControlId, Std.Tui.Runtime.Msg,
  Std.Tui.Runtime.Routing.Focus;

public type
  // One controlled menu found in the active routing subtree.
  TuiRouteMenu = record
    // Stable identifier of the value.
    public Id: TuiControlId;
    // Flat ordered menu-node collection.
    public Nodes: array of TuiMenuNode;
    // Controlled menu state.
    public State: TuiMenuState;
    // Action emitted when the controlled value changes.
    public ChangeAction: TuiAction;
  end record;

function TuiFindRouteMenu(Node: TuiElement): option of TuiRouteMenu;
begin
  case Node of
    TuiElement.Menu(Id, Nodes, State, ChangeAction):
    begin
      return Some(record
        Id := Id;
        Nodes := Nodes;
        State := State;
        ChangeAction := ChangeAction;
      end);
    end;
    TuiElement.Desktop(Focused, Children):
    begin
      mutable var LastOverlay: integer := -1;
      for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
        begin
          case Children[Index] of
            TuiElement.Overlay(Title, OverlayChildren):
            begin
              LastOverlay := Index;
            end;
            else
            begin
            end;
          end;
        end;
      end for;

      if LastOverlay >= 0 then
        begin
          return TuiFindRouteMenu(Children[LastOverlay]);
        end;
      end if;

      for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
        begin
          case TuiFindRouteMenu(Children[Index]) of
            Some(Menu):
            begin
              return Some(Menu);
            end;
            None:
            begin
            end;
          end;
        end;
      end for;

      return None;
    end;
    TuiElement.Scroll(Id, Offset, ChangeAction, Children):
    begin
      for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
        begin
          case TuiFindRouteMenu(Children[Index]) of
            Some(Menu):
            begin
              return Some(Menu);
            end;
            None:
            begin
            end;
          end;
        end;
      end for;

      return None;
    end;
    TuiElement.Row(Children, Spacing):
    begin
      for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
        begin
          case TuiFindRouteMenu(Children[Index]) of
            Some(Menu):
            begin
              return Some(Menu);
            end;
            None:
            begin
            end;
          end;
        end;
      end for;

      return None;
    end;
    TuiElement.Column(Children, Spacing):
    begin
      for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
        begin
          case TuiFindRouteMenu(Children[Index]) of
            Some(Menu):
            begin
              return Some(Menu);
            end;
            None:
            begin
            end;
          end;
        end;
      end for;

      return None;
    end;
    TuiElement.Layout(Settings, Children):
    begin
      for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
        begin
          case TuiFindRouteMenu(Children[Index]) of
            Some(Menu):
            begin
              return Some(Menu);
            end;
            None:
            begin
            end;
          end;
        end;
      end for;

      return None;
    end;
    TuiElement.Panel(Title, Children):
    begin
      for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
        begin
          case TuiFindRouteMenu(Children[Index]) of
            Some(Menu):
            begin
              return Some(Menu);
            end;
            None:
            begin
            end;
          end;
        end;
      end for;

      return None;
    end;
    TuiElement.Overlay(Title, Children):
    begin
      for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
        begin
          case TuiFindRouteMenu(Children[Index]) of
            Some(Menu):
            begin
              return Some(Menu);
            end;
            None:
            begin
            end;
          end;
        end;
      end for;

      return None;
    end;
    else
    begin
      return None;
    end;
  end;
end function;

function TuiMenuChange(Menu: TuiRouteMenu; State: TuiMenuState): TuiMsg;
begin
  return TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, State);
end function;

function TuiMenuOpenFirst(Menu: TuiRouteMenu; Previous: option of TuiControlId): array of TuiMsg;
begin
  case TuiMenuFirstSelectable(Menu.Nodes, None) of
    Some(First):
    begin
      mutable var Messages: array of TuiMsg := [];
      if not TuiFocusMatches(Previous, Menu.Id) then
        begin
          Std.Arrays.Push(Messages, TuiMsg.FocusChanged(Previous, Some(Menu.Id)));
        end;
      end if;

      Std.Arrays.Push(Messages, TuiMenuChange(Menu, TuiMenuState.OpenAt(First)));
      return Messages;
    end;
    None:
    begin
      return [];
    end;
  end;
end function;

function TuiMenuCommandMessages(Menu: TuiRouteMenu; Node: TuiMenuNode): array of TuiMsg;
begin
  case TuiMenuNodeAction(Node) of
    Some(Action):
    begin
      if Menu.State.Open then
        begin
          return [TuiMenuChange(Menu, TuiMenuState.Closed()), TuiMsg.Action(Menu.Id, Action)];
        end;
      end if;

      return [TuiMsg.Action(Menu.Id, Action)];
    end;
    None:
    begin
      return [];
    end;
  end;
end function;

function TuiMenuShortcut(Menu: TuiRouteMenu; Key: Std.Console.KeyEvent): option of array of TuiMsg;
begin
  for Index: integer := 0 to Std.Arrays.Length(Menu.Nodes) - 1 do
    begin
      if TuiMenuNodeSelectable(Menu.Nodes[Index]) then
        begin
          case TuiMenuNodeShortcut(Menu.Nodes[Index]) of
            Some(Shortcut):
            begin
              if Shortcut.Matches(Key) then
                begin
                  return Some(TuiMenuCommandMessages(Menu, Menu.Nodes[Index]));
                end;
              end if;
            end;
            None:
            begin
            end;
          end;
        end;
      end if;
    end;
  end for;

  return None;
end function;

function TuiMenuMnemonic(
  Menu: TuiRouteMenu;
  Key: Std.Console.KeyEvent;
  Parent: option of TuiMenuNodeId
): option of array of TuiMsg;
begin
  if Key.kind <> Std.Console.KeyKind.Character then
    begin
      return None;
    end;
  end if;

  for Index: integer := 0 to Std.Arrays.Length(Menu.Nodes) - 1 do
    begin
      if ((TuiMenuHasParent(Menu.Nodes[Index], Parent) and TuiMenuNodeSelectable(Menu.Nodes[Index])) and (TuiMenuNodeMnemonic(Menu.Nodes[Index]) <> '')) and
         (Std.Str.ToLower(TuiMenuNodeMnemonic(Menu.Nodes[Index])) = Std.Str.ToLower(Key.ch)) then
        begin
          if TuiMenuNodeIsSubmenu(Menu.Nodes[Index]) then
            begin
              return Some([
                            TuiMenuChange(Menu, TuiMenuState.OpenAt(TuiMenuNodeIdOf(Menu.Nodes[Index])))
                          ]);
            end;
          end if;

          return Some(TuiMenuCommandMessages(Menu, Menu.Nodes[Index]));
        end;
      end if;
    end;
  end for;

  return None;
end function;

function TuiMenuRouteOpen(Menu: TuiRouteMenu; Key: Std.Console.KeyEvent): option of array of TuiMsg;
begin
  if Key.kind = Std.Console.KeyKind.Escape then
    begin
      return Some([TuiMenuChange(Menu, TuiMenuState.Closed())]);
    end;
  end if;

  case Menu.State.Active of
    Some(Active):
    begin
      var ActiveIndex: integer := TuiMenuFind(Menu.Nodes, Active);
      var Parent: option of TuiMenuNodeId := TuiMenuNodeParent(Menu.Nodes[ActiveIndex]);
      case TuiMenuMnemonic(Menu, Key, Parent) of
        Some(Messages):
        begin
          return Some(Messages);
        end;
        None:
        begin
        end;
      end;

      if (Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space) then
        begin
          if TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
            begin
              case TuiMenuFirstSelectable(Menu.Nodes, Some(Active)) of
                Some(Child):
                begin
                  return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(Child))]);
                end;
                None:
                begin
                  return Some([]);
                end;
              end;
            end;
          end if;

          return Some(TuiMenuCommandMessages(Menu, Menu.Nodes[ActiveIndex]));
        end;
      end if;

      if (Key.kind = Std.Console.KeyKind.Down) or (Key.kind = Std.Console.KeyKind.Up) then
        begin
          if (Key.kind = Std.Console.KeyKind.Down) and TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
            begin
              case TuiMenuFirstSelectable(Menu.Nodes, Some(Active)) of
                Some(Child):
                begin
                  return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(Child))]);
                end;
                None:
                begin
                end;
              end;
            end;
          end if;
          mutable var Direction: integer := -1;
          if Key.kind = Std.Console.KeyKind.Down then
            begin
              Direction := 1;
            end;
          end if;

          case TuiMenuNextSelectable(Menu.Nodes, Active, Direction) of
            Some(Next):
            begin
              return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(Next))]);
            end;
            None:
            begin
              return Some([]);
            end;
          end;
        end;
      end if;

      if Key.kind = Std.Console.KeyKind.Right then
        begin
          if TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
            begin
              case TuiMenuFirstSelectable(Menu.Nodes, Some(Active)) of
                Some(Child):
                begin
                  return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(Child))]);
                end;
                None:
                begin
                end;
              end;
            end;
          end if;

          case TuiMenuRootOf(Menu.Nodes, Active) of
            Some(Root):
            begin
              case TuiMenuNextSelectable(Menu.Nodes, Root, 1) of
                Some(NextRoot):
                begin
                  return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(NextRoot))]);
                end;
                None:
                begin
                end;
              end;
            end;
            None:
            begin
            end;
          end;
        end;
      end if;

      if Key.kind = Std.Console.KeyKind.Left then
        begin
          case Parent of
            Some(ParentId):
            begin
              var ParentIndex: integer := TuiMenuFind(Menu.Nodes, ParentId);
              case TuiMenuNodeParent(Menu.Nodes[ParentIndex]) of
                Some(GrandParent):
                begin
                  return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(ParentId))]);
                end;
                None:
                begin
                  case TuiMenuNextSelectable(Menu.Nodes, ParentId, -1) of
                    Some(NextRoot):
                    begin
                      return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(NextRoot))]);
                    end;
                    None:
                    begin
                    end;
                  end;
                end;
              end;
            end;
            None:
            begin
              case TuiMenuNextSelectable(Menu.Nodes, Active, -1) of
                Some(NextRoot):
                begin
                  return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(NextRoot))]);
                end;
                None:
                begin
                end;
              end;
            end;
          end;
        end;
      end if;
    end;
    None:
    begin
    end;
  end;

  return None;
end function;

// Routes menu shortcuts, F10, mnemonics, and open-menu navigation.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Key`: Console key event to route or match.
public function TuiRouteMenuKey(Root: TuiElement; Key: Std.Console.KeyEvent): option of array of TuiMsg;
begin
  case TuiFindRouteMenu(Root) of
    Some(Menu):
    begin
      case TuiMenuShortcut(Menu, Key) of
        Some(Messages):
        begin
          return Some(Messages);
        end;
        None:
        begin
        end;
      end;

      if Menu.State.Open then
        begin
          return TuiMenuRouteOpen(Menu, Key);
        end;
      end if;

      if Key.kind = Std.Console.KeyKind.F10 then
        begin
          return Some(TuiMenuOpenFirst(Menu, TuiRootFocus(Root)));
        end;
      end if;

      if Key.alt then
        begin
          case TuiMenuMnemonic(Menu, Key, None) of
            Some(Messages):
            begin
              mutable var FocusMessages: array of TuiMsg := [];
              if not TuiFocusMatches(TuiRootFocus(Root), Menu.Id) then
                begin
                  Std.Arrays.Push(FocusMessages, TuiMsg.FocusChanged(TuiRootFocus(Root), Some(Menu.Id)));
                end;
              end if;

              return Some(Std.Arrays.Concat(FocusMessages, Messages));
            end;
            None:
            begin
            end;
          end;
        end;
      end if;

      if TuiFocusMatches(TuiRootFocus(Root), Menu.Id) and
         (((Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space)) or (Key.kind = Std.Console.KeyKind.Down)) then
        begin
          return Some(TuiMenuOpenFirst(Menu, TuiRootFocus(Root)));
        end;
      end if;

      return None;
    end;
    None:
    begin
      return None;
    end;
  end;
end function;
end unit;
