unit Std.Tui.Runtime.Routing.Menu;

uses
  Std.Console, Std.Tui.Chrome.MenuNode, Std.Tui.Chrome.MenuQuery, Std.Tui.Elements.Element,
  Std.Tui.Ids.Action, Std.Tui.Ids.ControlId, Std.Tui.Runtime.Msg, Std.Tui.Runtime.Routing.Focus;

// One controlled menu found in the active routing subtree.
public type TuiRouteMenu = record
  // Stable identifier of the value.
  public Id: TuiControlId;
  // Flat ordered menu-node collection.
  public Nodes: array of TuiMenuNode;
  // Controlled menu state.
  public State: TuiMenuState;
  // Action emitted when the controlled value changes.
  public ChangeAction: TuiAction;
end record;

function TuiFindRouteMenu(Node: TuiElement): option of TuiRouteMenu;
begin
  case Node of
    when TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        return Some(TuiRouteMenu(Id := Id, Nodes := Nodes, State := State, ChangeAction := ChangeAction));
      end;
    when TuiElement.Desktop(const Focused, const Children):
      begin
        var LastOverlay: integer := -1;
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            if Children[Index] is TuiElement.Overlay(const Title, const OverlayChildren) then
              begin
                LastOverlay := Index;
              end;
            end if;
          end;
        end for;

        if LastOverlay >= 0 then
          begin
            return TuiFindRouteMenu(Children[LastOverlay]);
          end;
        end if;

        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(const Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(const Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Row(const Children, const Spacing):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(const Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Column(const Children, const Spacing):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(const Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Layout(const Settings, const Children):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(const Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Panel(const Title, const Children):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(const Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Overlay(const Title, const Children):
      begin
        for Index: integer := 0 to Children.Length() - 1 do
          begin
            case TuiFindRouteMenu(Children[Index]) of
              when Some(const Menu):
                begin
                  return Some(Menu);
                end;
              when None:
                begin
                end;
            end case;
          end;
        end for;

        return None;
      end;
    when TuiElement.Empty, TuiElement.Label(_), TuiElement.Button(_), TuiElement.Input(_), TuiElement.TextArea(_, _, _, _, _), TuiElement.CheckBox(_, _, _, _), TuiElement.List(_, _, _, _), TuiElement.MenuBar(_), TuiElement.StatusLine(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Spacer(_):
      begin
        return None;
      end;
  end case;
end function;

function TuiMenuChange(Menu: TuiRouteMenu; State: TuiMenuState): TuiMsg;
begin
  return TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, State);
end function;

function TuiMenuOpenFirst(Menu: TuiRouteMenu; Previous: option of TuiControlId): array of TuiMsg;
begin
  case TuiMenuFirstSelectable(Menu.Nodes, None) of
    when Some(const First):
      begin
        var Messages: array of TuiMsg := [];
        if not TuiFocusMatches(Previous, Menu.Id) then
          begin
            Messages.Push(TuiMsg.FocusChanged(Previous, Some(Menu.Id)));
          end;
        end if;

        Messages.Push(TuiMenuChange(Menu, TuiMenuState.OpenAt(First)));
        return Messages;
      end;
    when None:
      begin
        return [];
      end;
  end case;
end function;

function TuiMenuCommandMessages(Menu: TuiRouteMenu; Node: TuiMenuNode): array of TuiMsg;
begin
  case TuiMenuNodeAction(Node) of
    when Some(const Action):
      begin
        if Menu.State.Open then
          begin
            return [TuiMenuChange(Menu, TuiMenuState.Closed()), TuiMsg.Action(Menu.Id, Action)];
          end;
        end if;

        return [TuiMsg.Action(Menu.Id, Action)];
      end;
    when None:
      begin
        return [];
      end;
  end case;
end function;

function TuiMenuShortcut(Menu: TuiRouteMenu; Key: Std.Console.KeyEvent): option of array of TuiMsg;
begin
  for Index: integer := 0 to Menu.Nodes.Length() - 1 do
    begin
      if TuiMenuNodeSelectable(Menu.Nodes[Index]) then
        begin
          case TuiMenuNodeShortcut(Menu.Nodes[Index]) of
            when Some(const Shortcut):
              begin
                if Shortcut.Matches(Key) then
                  begin
                    return Some(TuiMenuCommandMessages(Menu, Menu.Nodes[Index]));
                  end;
                end if;
              end;
            when None:
              begin
              end;
          end case;
        end;
      end if;
    end;
  end for;

  return None;
end function;

function TuiMenuMnemonic(
  Menu: TuiRouteMenu;
  Key: Std.Console.KeyEvent;
  Parent: option of TuiMenuNodeId
): option of array of TuiMsg;
begin
  if Key.kind <> Std.Console.KeyKind.Character then
    begin
      return None;
    end;
  end if;

  for Index: integer := 0 to Menu.Nodes.Length() - 1 do
    begin
      if ((TuiMenuHasParent(Menu.Nodes[Index], Parent) and TuiMenuNodeSelectable(Menu.Nodes[Index])) and (TuiMenuNodeMnemonic(Menu.Nodes[Index]) <> '')) and
         (TuiMenuNodeMnemonic(Menu.Nodes[Index]).ToLower() = Key.ch.ToLower()) then
        begin
          if TuiMenuNodeIsSubmenu(Menu.Nodes[Index]) then
            begin
              return Some([
                            TuiMenuChange(Menu, TuiMenuState.OpenAt(TuiMenuNodeIdOf(Menu.Nodes[Index])))
                          ]);
            end;
          end if;

          return Some(TuiMenuCommandMessages(Menu, Menu.Nodes[Index]));
        end;
      end if;
    end;
  end for;

  return None;
end function;

function TuiMenuRouteOpen(Menu: TuiRouteMenu; Key: Std.Console.KeyEvent): option of array of TuiMsg;
begin
  if Key.kind = Std.Console.KeyKind.Escape then
    begin
      return Some([TuiMenuChange(Menu, TuiMenuState.Closed())]);
    end;
  end if;

  case Menu.State.Active of
    when Some(const Active):
      begin
        const ActiveIndex: integer := TuiMenuFind(Menu.Nodes, Active);
        const Parent: option of TuiMenuNodeId := TuiMenuNodeParent(Menu.Nodes[ActiveIndex]);
        case TuiMenuMnemonic(Menu, Key, Parent) of
          when Some(const Messages):
            begin
              return Some(Messages);
            end;
          when None:
            begin
            end;
        end case;

        if (Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space) then
          begin
            if TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
              begin
                case TuiMenuFirstSelectable(Menu.Nodes, Some(Active)) of
                  when Some(const Child):
                    begin
                      return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(Child))]);
                    end;
                  when None:
                    begin
                      return Some([]);
                    end;
                end case;
              end;
            end if;

            return Some(TuiMenuCommandMessages(Menu, Menu.Nodes[ActiveIndex]));
          end;
        end if;

        if (Key.kind = Std.Console.KeyKind.Down) or (Key.kind = Std.Console.KeyKind.Up) then
          begin
            if (Key.kind = Std.Console.KeyKind.Down) and
               TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
              begin
                case TuiMenuFirstSelectable(Menu.Nodes, Some(Active)) of
                  when Some(const Child):
                    begin
                      return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(Child))]);
                    end;
                  when None:
                    begin
                    end;
                end case;
              end;
            end if;
            var Direction: integer := -1;
            if Key.kind = Std.Console.KeyKind.Down then
              begin
                Direction := 1;
              end;
            end if;

            case TuiMenuNextSelectable(Menu.Nodes, Active, Direction) of
              when Some(const Next):
                begin
                  return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(Next))]);
                end;
              when None:
                begin
                  return Some([]);
                end;
            end case;
          end;
        end if;

        if Key.kind = Std.Console.KeyKind.Right then
          begin
            if TuiMenuNodeIsSubmenu(Menu.Nodes[ActiveIndex]) then
              begin
                case TuiMenuFirstSelectable(Menu.Nodes, Some(Active)) of
                  when Some(const Child):
                    begin
                      return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(Child))]);
                    end;
                  when None:
                    begin
                    end;
                end case;
              end;
            end if;

            case TuiMenuRootOf(Menu.Nodes, Active) of
              when Some(const Root):
                begin
                  case TuiMenuNextSelectable(Menu.Nodes, Root, 1) of
                    when Some(const NextRoot):
                      begin
                        return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(NextRoot))]);
                      end;
                    when None:
                      begin
                      end;
                  end case;
                end;
              when None:
                begin
                end;
            end case;
          end;
        end if;

        if Key.kind = Std.Console.KeyKind.Left then
          begin
            case Parent of
              when Some(const ParentId):
                begin
                  const ParentIndex: integer := TuiMenuFind(Menu.Nodes, ParentId);
                  case TuiMenuNodeParent(Menu.Nodes[ParentIndex]) of
                    when Some(const GrandParent):
                      begin
                        return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(ParentId))]);
                      end;
                    when None:
                      begin
                        case TuiMenuNextSelectable(Menu.Nodes, ParentId, -1) of
                          when Some(const NextRoot):
                            begin
                              return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(NextRoot))]);
                            end;
                          when None:
                            begin
                            end;
                        end case;
                      end;
                  end case;
                end;
              when None:
                begin
                  case TuiMenuNextSelectable(Menu.Nodes, Active, -1) of
                    when Some(const NextRoot):
                      begin
                        return Some([TuiMenuChange(Menu, TuiMenuState.OpenAt(NextRoot))]);
                      end;
                    when None:
                      begin
                      end;
                  end case;
                end;
            end case;
          end;
        end if;
      end;
    when None:
      begin
      end;
  end case;

  return None;
end function;

// Routes menu shortcuts, F10, mnemonics, and open-menu navigation.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Key`: Console key event to route or match.
public function TuiRouteMenuKey(Root: TuiElement; Key: Std.Console.KeyEvent): option of array of TuiMsg;
begin
  case TuiFindRouteMenu(Root) of
    when Some(const Menu):
      begin
        case TuiMenuShortcut(Menu, Key) of
          when Some(const Messages):
            begin
              return Some(Messages);
            end;
          when None:
            begin
            end;
        end case;

        if Menu.State.Open then
          begin
            return TuiMenuRouteOpen(Menu, Key);
          end;
        end if;

        if Key.kind = Std.Console.KeyKind.F10 then
          begin
            return Some(TuiMenuOpenFirst(Menu, TuiRootFocus(Root)));
          end;
        end if;

        if Key.alt then
          begin
            case TuiMenuMnemonic(Menu, Key, None) of
              when Some(const Messages):
                begin
                  var FocusMessages: array of TuiMsg := [];
                  if not TuiFocusMatches(TuiRootFocus(Root), Menu.Id) then
                    begin
                      FocusMessages.Push(TuiMsg.FocusChanged(TuiRootFocus(Root), Some(Menu.Id)));
                    end;
                  end if;

                  return Some(FocusMessages.Concat(Messages));
                end;
              when None:
                begin
                end;
            end case;
          end;
        end if;

        if TuiFocusMatches(TuiRootFocus(Root), Menu.Id) and
           (((Key.kind = Std.Console.KeyKind.Enter) or (Key.kind = Std.Console.KeyKind.Space)) or (Key.kind = Std.Console.KeyKind.Down)) then
          begin
            return Some(TuiMenuOpenFirst(Menu, TuiRootFocus(Root)));
          end;
        end if;

        return None;
      end;
    when None:
      begin
        return None;
      end;
  end case;
end function;
end unit;
