unit Std.Tui.Runtime.Routing.MenuPointer;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Tui.Chrome.MenuGeometry as MenuGeometry;
uses Std.Tui.Chrome.MenuNode as MenuNode;
uses Std.Tui.Chrome.MenuQuery as MenuQuery;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Geometry.Point as Point2;
uses Std.Tui.Geometry.Rect as Rect;
uses Std.Tui.Ids.Action as Action2;
uses Std.Tui.Ids.ControlId as ControlId;
uses Std.Tui.Layout.Frame as Frame2;
uses Std.Tui.Runtime.Msg as Msg;
uses Std.Tui.Runtime.Routing.Focus as Focus;

// Controlled menu and arranged bar bounds used by pointer routing.
public type TuiPointerMenu = record
  // Stable identifier of the value.
  public Id: ControlId.TuiControlId;
  // Flat ordered menu-node collection.
  public Nodes: array of (MenuNode.TuiMenuNode);
  // Controlled menu state.
  public State: MenuNode.TuiMenuState;
  // Action emitted when the controlled value changes.
  public ChangeAction: Action2.TuiAction;
  // Rectangle occupied by the value.
  public Bounds: Rect.TuiRect;
end record;

var TuiPointerMenus: array of (TuiPointerMenu) := [];

function TuiPointerMenuWalk(
  Frame: Frame2.TuiArrangedFrame;
  Node: Element.TuiElement;
  Index: integer;
  AllowMenu: boolean
): integer;
begin
  var Next: integer := Index + 1;
  case Node of
    when Element.TuiElement.Menu(const Id, const Nodes, const State, const ChangeAction):
      begin
        if AllowMenu then
          begin
            var Menus: array of (TuiPointerMenu) := TuiPointerMenus;
            TuiPointerMenus := [];
            Arrays.Push(var Menus, TuiPointerMenu(Id := Id, Nodes := Nodes, State := State, ChangeAction := ChangeAction, Bounds := Frame2.TuiArrangedFrameEntryAt(Frame, Index)
                                                                                                                                      .Bounds));
            TuiPointerMenus := Menus;
          end;
        end if;
      end;
    when Element.TuiElement.Desktop(const Focused, const Children):
      begin
        var ModalIndex: integer := -1;
        for ChildIndex: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            case Children[ChildIndex] of
              when Element.TuiElement.Overlay(const Title, const OverlayChildren):
                begin
                  ModalIndex := ChildIndex;
                end;
              when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.Scroll(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.Menu(_, _, _, _), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Row(_, _), Element.TuiElement.Column(_, _), Element.TuiElement.Layout(_, _), Element.TuiElement.Spacer(_), Element.TuiElement.Panel(_, _), Element.TuiElement.Desktop(_, _):
                begin
                  begin
                    null;
                  end;
                end;
            end case;
          end;
        end for;

        for ChildIndex: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu and
                                                                          ((ModalIndex < 0) or (ModalIndex = ChildIndex)));
          end;
        end for;
      end;
    when Element.TuiElement.Scroll(const Id, const Offset, const ChangeAction, const Children):
      begin
        for ChildIndex: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when Element.TuiElement.Row(const Children, const Spacing):
      begin
        for ChildIndex: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when Element.TuiElement.Column(const Children, const Spacing):
      begin
        for ChildIndex: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when Element.TuiElement.Layout(const Settings, const Children):
      begin
        for ChildIndex: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when Element.TuiElement.Panel(const Title, const Children):
      begin
        for ChildIndex: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when Element.TuiElement.Overlay(const Title, const Children):
      begin
        for ChildIndex: integer := 0 to Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when Element.TuiElement.Empty, Element.TuiElement.Label(_), Element.TuiElement.Button(_), Element.TuiElement.Input(_), Element.TuiElement.TextArea(_, _, _, _, _), Element.TuiElement.CheckBox(_, _, _, _), Element.TuiElement.List(_, _, _, _), Element.TuiElement.MenuBar(_), Element.TuiElement.StatusLine(_), Element.TuiElement.CellGrid(_), Element.TuiElement.Rule(_), Element.TuiElement.Gauge(_), Element.TuiElement.Spacer(_):
      begin
        begin
          null;
        end;
      end;
  end case;

  return Next;
end function;

function TuiPointerMenuFocus(Root: Element.TuiElement; Menu: TuiPointerMenu): array of (Msg.TuiMsg);
begin
  const Previous: Option of (ControlId.TuiControlId) := Focus.TuiRootFocus(Root);
  if Focus.TuiFocusMatches(Previous, Menu.Id) then
    begin
      return [];
    end;
  end if;

  return [Msg.TuiMsg.FocusChanged(Previous, Option.Some(Menu.Id))];
end function;

function TuiPointerMenuHover(Menu: TuiPointerMenu; Id: MenuNode.TuiMenuNodeId): array of (Msg.TuiMsg);
begin
  case Menu.State.Active of
    when Option.Some(const Active):
      begin
        if Active.Value = Id.Value then
          begin
            return [];
          end;
        end if;
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  return [Msg.TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, MenuNode.TuiMenuStateOpenAt(Id))];
end function;

function TuiPointerMenuBarHit(
  Root: Element.TuiElement;
  Menu: TuiPointerMenu;
  Point: Point2.TuiPoint;
  Activate: boolean
): Option of (array of (Msg.TuiMsg));
begin
  if not Rect.TuiRectContains(Rect.TuiRectCreate(Menu.Bounds.X, Menu.Bounds.Y, Menu.Bounds.Width, 1), Point) then
    begin
      return Option.None;
    end;
  end if;
  var X: integer := Menu.Bounds.X;
  for Index: integer := 0 to Arrays.Length(Menu.Nodes) - 1 do
    begin
      case MenuQuery.TuiMenuNodeParent(Menu.Nodes[Index]) of
        when Option.Some(const Parent):
          begin
            null;
          end;
        when Option.None:
          begin
            const Width: integer := Console.DisplayWidth(MenuQuery.TuiMenuNodeText(Menu.Nodes[Index])) +
                                    2;
            if Rect.TuiRectContains(Rect.TuiRectCreate(X, Menu.Bounds.Y, Width, 1), Point) and
               MenuQuery.TuiMenuNodeSelectable(Menu.Nodes[Index]) then
              begin
                if not Activate then
                  begin
                    return Option.Some(TuiPointerMenuHover(Menu, MenuQuery.TuiMenuNodeIdOf(Menu.Nodes[Index])));
                  end;
                end if;

                return Option.Some(Arrays.Concat(TuiPointerMenuFocus(Root, Menu), [
                                                                                    Msg.TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, MenuNode.TuiMenuStateOpenAt(MenuQuery.TuiMenuNodeIdOf(Menu.Nodes[Index])))
                                                                                  ]));
              end;
            end if;

            X := X + Width;
          end;
      end case;
    end;
  end for;

  return Option.Some([]);
end function;

function TuiPointerMenuPopupHit(
  Menu: TuiPointerMenu;
  Point: Point2.TuiPoint;
  TerminalBounds: Rect.TuiRect;
  Activate: boolean
): Option of (array of (Msg.TuiMsg));
begin
  const Popups: array of (MenuGeometry.TuiMenuPopup) := MenuGeometry.TuiMenuPopupGeometry(Menu.Nodes, Menu.State, Menu.Bounds, TerminalBounds);
  for PopupIndex: integer := Arrays.Length(Popups) - 1 downto 0 do
    begin
      if Rect.TuiRectContains(Popups[PopupIndex].Bounds, Point) then
        begin
          const Row: integer := (Point.Y - Popups[PopupIndex].Bounds.Y) - 1;
          if (Row < 0) or (Row >= Popups[PopupIndex].Bounds.Height - 2) then
            begin
              return Option.Some([]);
            end;
          end if;
          var ChildRow: integer := 0;
          for Index: integer := 0 to Arrays.Length(Menu.Nodes) - 1 do
            begin
              if MenuQuery.TuiMenuHasParent(Menu.Nodes[Index], Option.Some(Popups[PopupIndex].Parent)) then
                begin
                  if ChildRow = Row then
                    begin
                      if not MenuQuery.TuiMenuNodeSelectable(Menu.Nodes[Index]) then
                        begin
                          return Option.Some([]);
                        end;
                      end if;

                      if MenuQuery.TuiMenuNodeIsSubmenu(Menu.Nodes[Index]) then
                        begin
                          if not Activate then
                            begin
                              return Option.Some(TuiPointerMenuHover(Menu, MenuQuery.TuiMenuNodeIdOf(Menu.Nodes[Index])));
                            end;
                          end if;

                          return Option.Some([
                                               Msg.TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, MenuNode.TuiMenuStateOpenAt(MenuQuery.TuiMenuNodeIdOf(Menu.Nodes[Index])))
                                             ]);
                        end;
                      end if;

                      if not Activate then
                        begin
                          return Option.Some(TuiPointerMenuHover(Menu, MenuQuery.TuiMenuNodeIdOf(Menu.Nodes[Index])));
                        end;
                      end if;

                      case MenuQuery.TuiMenuNodeAction(Menu.Nodes[Index]) of
                        when Option.Some(const Action):
                          begin
                            return Option.Some([
                                                 Msg.TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, MenuNode.TuiMenuStateClosed()),
                                                 Msg.TuiMsg.Action(Menu.Id, Action)
                                               ]);
                          end;
                        when Option.None:
                          begin
                            return Option.Some([]);
                          end;
                      end case;
                    end;
                  end if;

                  ChildRow := ChildRow + 1;
                end;
              end if;
            end;
          end for;

          return Option.Some([]);
        end;
      end if;
    end;
  end for;

  return Option.None;
end function;

// Routes a left-button press or movement over one active hierarchical menu.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Frame`: Arranged frame containing element geometry.
// - `Point`: Point tested by the operation.
// - `Activate`: Whether the control is activated by the operation.
public function TuiRouteMenuPointer(
  Root: Element.TuiElement;
  Frame: Frame2.TuiArrangedFrame;
  Point: Point2.TuiPoint;
  Activate: boolean
): Option of (array of (Msg.TuiMsg));
begin
  TuiPointerMenus := [];
  if TuiPointerMenuWalk(Frame, Root, 0, true) <> Frame2.TuiArrangedFrameCount(Frame) then
    begin
      panic('Tui menu pointer routing did not consume the complete arranged frame');
    end;
  end if;

  if Arrays.Length(TuiPointerMenus) = 0 then
    begin
      return Option.None;
    end;
  end if;
  const Menu: TuiPointerMenu := TuiPointerMenus[0];
  if not Activate and not Menu.State.Open then
    begin
      return Option.None;
    end;
  end if;

  case TuiPointerMenuBarHit(Root, Menu, Point, Activate) of
    when Option.Some(const Messages):
      begin
        return Option.Some(Messages);
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  if Menu.State.Open then
    begin
      case TuiPointerMenuPopupHit(Menu, Point, Frame2.TuiArrangedFrameEntryAt(Frame, 0).Bounds, Activate) of
        when Option.Some(const Messages):
          begin
            return Option.Some(Messages);
          end;
        when Option.None:
          begin
            if not Activate then
              begin
                return Option.Some([]);
              end;
            end if;

            return Option.Some([
                                 Msg.TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, MenuNode.TuiMenuStateClosed())
                               ]);
          end;
      end case;
    end;
  end if;

  return Option.None;
end function;

end unit;
