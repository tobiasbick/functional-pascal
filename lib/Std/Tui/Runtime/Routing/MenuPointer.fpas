unit Std.Tui.Runtime.Routing.MenuPointer;

uses
  Std.Arrays, Std.Console, Std.Tui.Chrome.MenuGeometry, Std.Tui.Chrome.MenuNode,
  Std.Tui.Chrome.MenuQuery, Std.Tui.Elements.Element, Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect,
  Std.Tui.Ids.Action, Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame, Std.Tui.Runtime.Msg,
  Std.Tui.Runtime.Routing.Focus;

// Controlled menu and arranged bar bounds used by pointer routing.
public type TuiPointerMenu = record
  // Stable identifier of the value.
  public Id: TuiControlId;
  // Flat ordered menu-node collection.
  public Nodes: array of TuiMenuNode;
  // Controlled menu state.
  public State: TuiMenuState;
  // Action emitted when the controlled value changes.
  public ChangeAction: TuiAction;
  // Rectangle occupied by the value.
  public Bounds: TuiRect;
end record;

var TuiPointerMenus: array of TuiPointerMenu := [];

function TuiPointerMenuWalk(
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  AllowMenu: boolean
): integer;
begin
  var Next: integer := Index + 1;
  case Node of
    when TuiElement.Menu(Id, Nodes, State, ChangeAction):
      begin
        if AllowMenu then
          begin
            var Menus: array of TuiPointerMenu := TuiPointerMenus;
            TuiPointerMenus := [];
            Std.Arrays.Push(Menus, record
              Id := Id;
              Nodes := Nodes;
              State := State;
              ChangeAction := ChangeAction;
              Bounds := Frame.EntryAt(Index).Bounds;
            end);
            TuiPointerMenus := Menus;
          end;
        end if;
      end;
    when TuiElement.Desktop(Focused, Children):
      begin
        var ModalIndex: integer := -1;
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            case Children[ChildIndex] of
              when TuiElement.Overlay(Title, OverlayChildren):
                begin
                  ModalIndex := ChildIndex;
                end;
              else
                begin
                end;
            end case;
          end;
        end for;

        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu and
                                                                          ((ModalIndex < 0) or (ModalIndex = ChildIndex)));
          end;
        end for;
      end;
    when TuiElement.Scroll(Id, Offset, ChangeAction, Children):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Row(Children, Spacing):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Column(Children, Spacing):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Layout(Settings, Children):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Panel(Title, Children):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    when TuiElement.Overlay(Title, Children):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerMenuWalk(Frame, Children[ChildIndex], Next, AllowMenu);
          end;
        end for;
      end;
    else
      begin
      end;
  end case;

  return Next;
end function;

function TuiPointerMenuFocus(Root: TuiElement; Menu: TuiPointerMenu): array of TuiMsg;
begin
  const Previous: option of TuiControlId := TuiRootFocus(Root);
  if TuiFocusMatches(Previous, Menu.Id) then
    begin
      return [];
    end;
  end if;

  return [TuiMsg.FocusChanged(Previous, Some(Menu.Id))];
end function;

function TuiPointerMenuHover(Menu: TuiPointerMenu; Id: TuiMenuNodeId): array of TuiMsg;
begin
  case Menu.State.Active of
    when Some(Active):
      begin
        if Active.Value = Id.Value then
          begin
            return [];
          end;
        end if;
      end;
    when None:
      begin
      end;
  end case;

  return [TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, TuiMenuState.OpenAt(Id))];
end function;

function TuiPointerMenuBarHit(
  Root: TuiElement;
  Menu: TuiPointerMenu;
  Point: TuiPoint;
  Activate: boolean
): option of array of TuiMsg;
begin
  if not TuiRect.Create(Menu.Bounds.X, Menu.Bounds.Y, Menu.Bounds.Width, 1).Contains(Point) then
    begin
      return None;
    end;
  end if;
  var X: integer := Menu.Bounds.X;
  for Index: integer := 0 to Std.Arrays.Length(Menu.Nodes) - 1 do
    begin
      case TuiMenuNodeParent(Menu.Nodes[Index]) of
        when Some(Parent):
          begin
          end;
        when None:
          begin
            const Width: integer := Std.Console.DisplayWidth(TuiMenuNodeText(Menu.Nodes[Index])) + 2;
            if TuiRect.Create(X, Menu.Bounds.Y, Width, 1).Contains(Point) and
               TuiMenuNodeSelectable(Menu.Nodes[Index]) then
              begin
                if not Activate then
                  begin
                    return Some(TuiPointerMenuHover(Menu, TuiMenuNodeIdOf(Menu.Nodes[Index])));
                  end;
                end if;

                return Some(Std.Arrays.Concat(TuiPointerMenuFocus(Root, Menu), [
                                                                                 TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, TuiMenuState.OpenAt(TuiMenuNodeIdOf(Menu.Nodes[Index])))
                                                                               ]));
              end;
            end if;

            X := X + Width;
          end;
      end case;
    end;
  end for;

  return Some([]);
end function;

function TuiPointerMenuPopupHit(
  Menu: TuiPointerMenu;
  Point: TuiPoint;
  TerminalBounds: TuiRect;
  Activate: boolean
): option of array of TuiMsg;
begin
  const Popups: array of TuiMenuPopup := TuiMenuPopupGeometry(Menu.Nodes, Menu.State, Menu.Bounds, TerminalBounds);
  for PopupIndex: integer := Std.Arrays.Length(Popups) - 1 downto 0 do
    begin
      if Popups[PopupIndex].Bounds.Contains(Point) then
        begin
          const Row: integer := (Point.Y - Popups[PopupIndex].Bounds.Y) - 1;
          if (Row < 0) or (Row >= Popups[PopupIndex].Bounds.Height - 2) then
            begin
              return Some([]);
            end;
          end if;
          var ChildRow: integer := 0;
          for Index: integer := 0 to Std.Arrays.Length(Menu.Nodes) - 1 do
            begin
              if TuiMenuHasParent(Menu.Nodes[Index], Some(Popups[PopupIndex].Parent)) then
                begin
                  if ChildRow = Row then
                    begin
                      if not TuiMenuNodeSelectable(Menu.Nodes[Index]) then
                        begin
                          return Some([]);
                        end;
                      end if;

                      if TuiMenuNodeIsSubmenu(Menu.Nodes[Index]) then
                        begin
                          if not Activate then
                            begin
                              return Some(TuiPointerMenuHover(Menu, TuiMenuNodeIdOf(Menu.Nodes[Index])));
                            end;
                          end if;

                          return Some([
                                        TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, TuiMenuState.OpenAt(TuiMenuNodeIdOf(Menu.Nodes[Index])))
                                      ]);
                        end;
                      end if;

                      if not Activate then
                        begin
                          return Some(TuiPointerMenuHover(Menu, TuiMenuNodeIdOf(Menu.Nodes[Index])));
                        end;
                      end if;

                      case TuiMenuNodeAction(Menu.Nodes[Index]) of
                        when Some(Action):
                          begin
                            return Some([
                                          TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, TuiMenuState.Closed()),
                                          TuiMsg.Action(Menu.Id, Action)
                                        ]);
                          end;
                        when None:
                          begin
                            return Some([]);
                          end;
                      end case;
                    end;
                  end if;

                  ChildRow := ChildRow + 1;
                end;
              end if;
            end;
          end for;

          return Some([]);
        end;
      end if;
    end;
  end for;

  return None;
end function;

// Routes a left-button press or movement over one active hierarchical menu.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Frame`: Arranged frame containing element geometry.
// - `Point`: Point tested by the operation.
// - `Activate`: Whether the control is activated by the operation.
public function TuiRouteMenuPointer(
  Root: TuiElement;
  Frame: TuiArrangedFrame;
  Point: TuiPoint;
  Activate: boolean
): option of array of TuiMsg;
begin
  TuiPointerMenus := [];
  if TuiPointerMenuWalk(Frame, Root, 0, true) <> Frame.Count() then
    begin
      panic('Tui menu pointer routing did not consume the complete arranged frame');
    end;
  end if;

  if Std.Arrays.Length(TuiPointerMenus) = 0 then
    begin
      return None;
    end;
  end if;
  const Menu: TuiPointerMenu := TuiPointerMenus[0];
  if not Activate and not Menu.State.Open then
    begin
      return None;
    end;
  end if;

  case TuiPointerMenuBarHit(Root, Menu, Point, Activate) of
    when Some(Messages):
      begin
        return Some(Messages);
      end;
    when None:
      begin
      end;
  end case;

  if Menu.State.Open then
    begin
      case TuiPointerMenuPopupHit(Menu, Point, Frame.EntryAt(0).Bounds, Activate) of
        when Some(Messages):
          begin
            return Some(Messages);
          end;
        when None:
          begin
            if not Activate then
              begin
                return Some([]);
              end;
            end if;

            return Some([TuiMsg.MenuChanged(Menu.Id, Menu.ChangeAction, TuiMenuState.Closed())]);
          end;
      end case;
    end;
  end if;

  return None;
end function;
end unit;
