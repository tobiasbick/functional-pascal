unit Std.Tui.Runtime.Routing.Pointer;

uses
  Std.Arrays, Std.Console, Std.Tui.Chrome.Button, Std.Tui.Elements.Element, Std.Tui.Geometry.Point,
  Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame, Std.Tui.Runtime.Msg, Std.Tui.Runtime.PointerEvent,
  Std.Tui.Runtime.Routing.ButtonCapture, Std.Tui.Runtime.Routing.Focus,
  Std.Tui.Runtime.Routing.MenuPointer, Std.Tui.Runtime.Routing.PointerHit,
  Std.Tui.Runtime.Routing.TextArea, Std.Tui.Text.Input;

function TuiRoutePointerFocusMessages(Previous: option of TuiControlId; Target: TuiControlId): array of TuiMsg;
begin
  if TuiFocusMatches(Previous, Target) then
    begin
      return [];
    end;
  end if;

  return [TuiMsg.FocusChanged(Previous, Some(Target))];
end function;

function TuiIdlePointerResult(ApplicationId: integer; Messages: array of TuiMsg): array of TuiMsg;
begin
  TuiButtonCaptureRelease(ApplicationId);
  return Messages;
end function;

function TuiCapturedPointerResult(
  ApplicationId: integer;
  Messages: array of TuiMsg;
  Button: TuiButtonSpec;
  Inside: boolean
): array of TuiMsg;
begin
  TuiButtonCaptureSet(ApplicationId, Button, Inside);
  return Messages;
end function;

function TuiPointerInsideCapturedButton(
  Root: TuiElement;
  Frame: TuiArrangedFrame;
  Position: TuiPoint;
  Button: TuiButtonSpec
): boolean;
begin
  case TuiPointerHitAt(Frame, Root, Position) of
    when TuiPointerHit.ElementButton(Hit):
      begin
        return Hit.Id.Value = Button.Id.Value;
      end;
    else
      begin
        return false;
      end;
  end case;
end function;

// Allocates idle pointer-button state for one application.
public procedure TuiPointerRoutingOpen();
begin
  TuiButtonCaptureOpen();
end procedure;

// Clears pointer-button state for one application.
//
// Parameters:
// - `ApplicationId`: Identifier of the application-owned routing state.
public procedure TuiPointerRoutingClose(ApplicationId: integer);
begin
  TuiButtonCaptureClose(ApplicationId);
end procedure;

// Returns the button painted pressed for one application.
//
// Parameters:
// - `ApplicationId`: Identifier of the application-owned routing state.
public function TuiPointerRoutingPressed(ApplicationId: integer): option of TuiControlId;
begin
  return TuiButtonCapturePressed(ApplicationId);
end function;

// Routes one pointer event and advances application-owned button capture.
//
// Parameters:
// - `Pointer`: Normalized pointer event to route.
// - `ApplicationId`: Identifier of the application-owned routing state.
// - `Root`: Root of the element tree.
// - `Frame`: Arranged frame containing element geometry.
public function TuiRouteApplicationPointer(
  Pointer: TuiPointerEvent;
  ApplicationId: integer;
  Root: TuiElement;
  Frame: TuiArrangedFrame
): array of TuiMsg;
begin
  var PointerAction: Std.Console.MouseAction := Pointer.Action;
  var PointerButton: TuiPointerButton := Pointer.Button;
  var PointerPosition: TuiPoint := Pointer.Position;
  var PointerShift: boolean := Pointer.Shift;
  var PointerCtrl: boolean := Pointer.Ctrl;
  var PointerAlt: boolean := Pointer.Alt;
  var PointerMeta: boolean := Pointer.Meta;
  TuiRouteRequireMatchingFrame(Frame, Root);
  case TuiButtonCaptureGet(ApplicationId) of
    when TuiButtonPressState.Captured(Button, PreviousInside):
      begin
        var Inside: boolean := TuiPointerInsideCapturedButton(Root, Frame, PointerPosition, Button);
        if PointerAction = Std.Console.MouseAction.Up then
          begin
            if Inside then
              begin
                return TuiIdlePointerResult(ApplicationId, [TuiMsg.Action(Button.Id, Button.Action)]);
              end;
            end if;

            return TuiIdlePointerResult(ApplicationId, [
                                                         TuiMsg.Pointer(TuiPointerEvent.WithModifiers(PointerAction, PointerButton, PointerPosition, PointerShift, PointerCtrl, PointerAlt, PointerMeta))
                                                       ]);
          end;
        end if;

        return TuiCapturedPointerResult(ApplicationId, [
                                                         TuiMsg.Pointer(TuiPointerEvent.WithModifiers(PointerAction, PointerButton, PointerPosition, PointerShift, PointerCtrl, PointerAlt, PointerMeta))
                                                       ], Button, Inside);
      end;
    when TuiButtonPressState.Idle:
      begin
      end;
  end case;
  var MenuPointer: boolean := (PointerAction = Std.Console.MouseAction.Move) or
                              ((PointerAction = Std.Console.MouseAction.Down) and (PointerButton = TuiPointerButton.Left));
  if MenuPointer then
    begin
      case TuiRouteMenuPointer(Root, Frame, PointerPosition, PointerAction =
                                                             Std.Console.MouseAction.Down) of
        when Some(Messages):
          begin
            return TuiIdlePointerResult(ApplicationId, Messages);
          end;
        when None:
          begin
          end;
      end case;
    end;
  end if;

  if (PointerAction <> Std.Console.MouseAction.Down) or (PointerButton <> TuiPointerButton.Left) then
    begin
      return TuiIdlePointerResult(ApplicationId, [
                                                   TuiMsg.Pointer(TuiPointerEvent.WithModifiers(PointerAction, PointerButton, PointerPosition, PointerShift, PointerCtrl, PointerAlt, PointerMeta))
                                                 ]);
    end;
  end if;
  var Previous: option of TuiControlId := TuiRootFocus(Root);
  case TuiPointerHitAt(Frame, Root, PointerPosition) of
    when TuiPointerHit.Miss:
      begin
        return TuiIdlePointerResult(ApplicationId, [
                                                     TuiMsg.Pointer(TuiPointerEvent.WithModifiers(PointerAction, PointerButton, PointerPosition, PointerShift, PointerCtrl, PointerAlt, PointerMeta))
                                                   ]);
      end;
    when TuiPointerHit.ElementButton(Button):
      begin
        var Messages: array of TuiMsg := Std.Arrays.Concat(TuiRoutePointerFocusMessages(Previous, Button.Id), [
                                                                                                                TuiMsg.Pointer(TuiPointerEvent.WithModifiers(PointerAction, PointerButton, PointerPosition, PointerShift, PointerCtrl, PointerAlt, PointerMeta))
                                                                                                              ]);
        return TuiCapturedPointerResult(ApplicationId, Messages, Button, true);
      end;
    when TuiPointerHit.ImmediateButton(Id, Action):
      begin
        return TuiIdlePointerResult(ApplicationId, Std.Arrays.Concat(TuiRoutePointerFocusMessages(Previous, Id), [
                                                                                                                   TuiMsg.Action(Id, Action)
                                                                                                                 ]));
      end;
    when TuiPointerHit.Input(Input, Bounds):
      begin
        var Viewport: TuiInputViewport := TuiInputViewportFor(Input.Text, Input.Caret, Bounds.Width -
                                                                                       2);
        var Caret: integer := TuiInputCaretAtColumn(Input.Text, Viewport, (PointerPosition.X - Bounds.X) -
                                                                          1);
        return TuiIdlePointerResult(ApplicationId, Std.Arrays.Concat(TuiRoutePointerFocusMessages(Previous, Input.Id), [
                                                                                                                         TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text, Caret)
                                                                                                                       ]));
      end;
    when TuiPointerHit.TextArea(Id, Action, Text, Offset, Bounds):
      begin
        return TuiIdlePointerResult(ApplicationId, Std.Arrays.Concat(TuiRoutePointerFocusMessages(Previous, Id), [
                                                                                                                   TuiRouteTextAreaPointer(Id, Text, Offset, Action, Bounds, PointerPosition)
                                                                                                                 ]));
      end;
    when TuiPointerHit.CheckBox(Id, Action, Checked):
      begin
        return TuiIdlePointerResult(ApplicationId, Std.Arrays.Concat(TuiRoutePointerFocusMessages(Previous, Id), [
                                                                                                                   TuiMsg.CheckChanged(Id, Action, not Checked)
                                                                                                                 ]));
      end;
    when TuiPointerHit.List(Id, Action, CurrentSelected, Proposed):
      begin
        var FocusMessages: array of TuiMsg := TuiRoutePointerFocusMessages(Previous, Id);
        if Proposed = CurrentSelected then
          begin
            if Std.Arrays.Length(FocusMessages) = 0 then
              begin
                return TuiIdlePointerResult(ApplicationId, [
                                                             TuiMsg.Pointer(TuiPointerEvent.WithModifiers(PointerAction, PointerButton, PointerPosition, PointerShift, PointerCtrl, PointerAlt, PointerMeta))
                                                           ]);
              end;
            end if;

            return TuiIdlePointerResult(ApplicationId, FocusMessages);
          end;
        end if;

        return TuiIdlePointerResult(ApplicationId, Std.Arrays.Concat(FocusMessages, [
                                                                                      TuiMsg.SelectionChanged(Id, Action, Proposed)
                                                                                    ]));
      end;
    when TuiPointerHit.Scroll(Id):
      begin
        var FocusMessages: array of TuiMsg := TuiRoutePointerFocusMessages(Previous, Id);
        if Std.Arrays.Length(FocusMessages) = 0 then
          begin
            return TuiIdlePointerResult(ApplicationId, [
                                                         TuiMsg.Pointer(TuiPointerEvent.WithModifiers(PointerAction, PointerButton, PointerPosition, PointerShift, PointerCtrl, PointerAlt, PointerMeta))
                                                       ]);
          end;
        end if;

        return TuiIdlePointerResult(ApplicationId, FocusMessages);
      end;
  end case;
end function;
end unit;
