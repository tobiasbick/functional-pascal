unit Std.Tui.Runtime.Routing.PointerHit;

uses
  Std.Arrays, Std.Console, Std.Tui.Chrome.Button, Std.Tui.Chrome.Input, Std.Tui.Chrome.StatusItem,
  Std.Tui.Elements.Element, Std.Tui.Geometry.Point, Std.Tui.Geometry.Rect, Std.Tui.Ids.Action,
  Std.Tui.Ids.ControlId, Std.Tui.Layout.Frame;

// Hit result for pointer routing against arranged geometry.
public type TuiPointerHit = enum
  // Represents the `Miss` variant of `TuiPointerHit`.
  Miss;
  // Represents the `ElementButton` variant of `TuiPointerHit`.
  //
  // Parameters:
  // - `Button`: Button specification carried by the variant.
  ElementButton(Button: TuiButtonSpec);
  // Represents the `ImmediateButton` variant of `TuiPointerHit`.
  //
  // Parameters:
  // - `Id`: Identifier carried by the variant.
  // - `Action`: Application action carried by the variant.
  ImmediateButton(Id: TuiControlId; Action: TuiAction);
  // Represents the `Input` variant of `TuiPointerHit`.
  //
  // Parameters:
  // - `Value`: Typed value wrapped by the variant.
  // - `Bounds`: Arranged bounds associated with the hit or control.
  Input(Value: TuiInputSpec; Bounds: TuiRect);
  // Represents the `TextArea` variant of `TuiPointerHit`.
  //
  // Parameters:
  // - `Id`: Identifier carried by the variant.
  // - `Action`: Application action carried by the variant.
  // - `Text`: Text carried or displayed by the variant.
  // - `Offset`: Scroll offset carried by the variant.
  // - `Bounds`: Arranged bounds associated with the hit or control.
  TextArea(Id: TuiControlId; Action: TuiAction; Text: string; Offset: TuiPoint; Bounds: TuiRect);
  // Represents the `CheckBox` variant of `TuiPointerHit`.
  //
  // Parameters:
  // - `Id`: Identifier carried by the variant.
  // - `Action`: Application action carried by the variant.
  // - `Checked`: Checked state carried by the variant.
  CheckBox(Id: TuiControlId; Action: TuiAction; Checked: boolean);
  // Represents the `List` variant of `TuiPointerHit`.
  //
  // Parameters:
  // - `Id`: Identifier carried by the variant.
  // - `Action`: Application action carried by the variant.
  // - `CurrentSelected`: Current selected item index.
  // - `Proposed`: Proposed selected item index.
  List(Id: TuiControlId; Action: TuiAction; CurrentSelected: integer; Proposed: integer);
  // Represents the `Scroll` variant of `TuiPointerHit`.
  //
  // Parameters:
  // - `Id`: Identifier carried by the variant.
  Scroll(Id: TuiControlId);
end enum;

var TuiPointerBestHit: TuiPointerHit := TuiPointerHit.Miss;

function TuiPointerModalChildIndex(Children: array of TuiElement): integer;
begin
  var LastOverlay: integer := -1;
  for Index: integer := 0 to Std.Arrays.Length(Children) - 1 do
    begin
      case Children[Index] of
        when TuiElement.Overlay(Title, OverlayChildren):
          begin
            LastOverlay := Index;
          end;
        else
          begin
          end;
      end case;
    end;
  end for;

  return LastOverlay;
end function;

function TuiPointerHitWalk(
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  Point: TuiPoint;
  AllowHits: boolean
): integer;
begin
  const Entry: TuiArrangedEntry := Frame.EntryAt(Index);
  var Next: integer := Index + 1;
  case Node of
    when TuiElement.Button(Button):
      begin
        var ActiveWidth: integer := Entry.Bounds.Width - 1;
        if ActiveWidth < 0 then
          begin
            ActiveWidth := 0;
          end;
        end if;
        const ActiveBounds: TuiRect := TuiRect.Create(Entry.Bounds.X, Entry.Bounds.Y, ActiveWidth, 1);
        if (Button.Enabled and AllowHits) and Entry.Clip.Intersect(ActiveBounds).Contains(Point) then
          begin
            TuiPointerBestHit := TuiPointerHit.ElementButton(Button);
          end;
        end if;
      end;
    when TuiElement.Input(Input):
      begin
        if AllowHits and Entry.Clip.Contains(Point) then
          begin
            TuiPointerBestHit := TuiPointerHit.Input(Input, Entry.Bounds);
          end;
        end if;
      end;
    when TuiElement.TextArea(Id, Text, Caret, Offset, ChangeAction):
      begin
        if AllowHits and Entry.Clip.Contains(Point) then
          begin
            TuiPointerBestHit := TuiPointerHit.TextArea(Id, ChangeAction, Text, Offset, Entry.Bounds);
          end;
        end if;
      end;
    when TuiElement.CheckBox(Id, Text, Checked, ChangeAction):
      begin
        if AllowHits and Entry.Clip.Contains(Point) then
          begin
            TuiPointerBestHit := TuiPointerHit.CheckBox(Id, ChangeAction, Checked);
          end;
        end if;
      end;
    when TuiElement.List(Id, Items, Selected, ChangeAction):
      begin
        if AllowHits and Entry.Clip.Contains(Point) then
          begin
            const Row: integer := Point.Y - Entry.Bounds.Y;
            if (Row >= 0) and (Row < Std.Arrays.Length(Items)) then
              begin
                TuiPointerBestHit := TuiPointerHit.List(Id, ChangeAction, Selected, Row);
              end;
            end if;
          end;
        end if;
      end;
    when TuiElement.MenuBar(Items):
      begin
        var Cursor: integer := Entry.Bounds.X;
        for ItemIndex: integer := 0 to Std.Arrays.Length(Items) - 1 do
          begin
            const Width: integer := Std.Console.DisplayWidth(Items[ItemIndex].Text) + 2;
            const ItemBounds: TuiRect := TuiRect.Create(Cursor, Entry.Bounds.Y, Width, 1);
            if (AllowHits and Items[ItemIndex].Enabled) and
               Entry.Clip.Intersect(ItemBounds).Contains(Point) then
              begin
                TuiPointerBestHit := TuiPointerHit.ImmediateButton(Items[ItemIndex].Id, Items[ItemIndex].Action);
              end;
            end if;

            Cursor := Cursor + Width;
          end;
        end for;
      end;
    when TuiElement.Menu(Id, Nodes, State, ChangeAction):
      begin
      end;
    when TuiElement.StatusLine(Items):
      begin
        var Cursor: integer := Entry.Bounds.X;
        for ItemIndex: integer := 0 to Std.Arrays.Length(Items) - 1 do
          begin
            if ItemIndex > 0 then
              begin
                Cursor := Cursor + 1;
              end;
            end if;

            case Items[ItemIndex] of
              when TuiStatusItem.Hint(Text):
                begin
                  Cursor := Cursor + Std.Console.DisplayWidth(Text);
                end;
              when TuiStatusItem.KeyHint(KeyText, Text):
                begin
                  Cursor := ((Cursor + Std.Console.DisplayWidth(KeyText)) + Std.Console.DisplayWidth(Text)) +
                            1;
                end;
              when TuiStatusItem.Command(Id, Text, Action, Enabled):
                begin
                  const Width: integer := Std.Console.DisplayWidth(Text);
                  const ItemBounds: TuiRect := TuiRect.Create(Cursor, Entry.Bounds.Y, Width, 1);
                  if (AllowHits and Enabled) and Entry.Clip.Intersect(ItemBounds).Contains(Point) then
                    begin
                      TuiPointerBestHit := TuiPointerHit.ImmediateButton(Id, Action);
                    end;
                  end if;

                  Cursor := Cursor + Width;
                end;
            end case;
          end;
        end for;
      end;
    when TuiElement.Scroll(Id, Offset, ChangeAction, Children):
      begin
        const ScrollAllowsHits: boolean := AllowHits and Entry.Clip.Contains(Point);
        if ScrollAllowsHits then
          begin
            TuiPointerBestHit := TuiPointerHit.Scroll(Id);
          end;
        end if;

        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerHitWalk(Frame, Children[ChildIndex], Next, Point, ScrollAllowsHits);
          end;
        end for;
      end;
    when TuiElement.Row(Children, Spacing):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerHitWalk(Frame, Children[ChildIndex], Next, Point, AllowHits);
          end;
        end for;
      end;
    when TuiElement.Column(Children, Spacing):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerHitWalk(Frame, Children[ChildIndex], Next, Point, AllowHits);
          end;
        end for;
      end;
    when TuiElement.Layout(Settings, Children):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerHitWalk(Frame, Children[ChildIndex], Next, Point, AllowHits);
          end;
        end for;
      end;
    when TuiElement.Panel(Title, Children):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerHitWalk(Frame, Children[ChildIndex], Next, Point, AllowHits);
          end;
        end for;
      end;
    when TuiElement.Overlay(Title, Children):
      begin
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            Next := TuiPointerHitWalk(Frame, Children[ChildIndex], Next, Point, AllowHits);
          end;
        end for;
      end;
    when TuiElement.Desktop(Focused, Children):
      begin
        const ModalIndex: integer := TuiPointerModalChildIndex(Children);
        for ChildIndex: integer := 0 to Std.Arrays.Length(Children) - 1 do
          begin
            var ChildAllow: boolean := AllowHits;
            if ModalIndex >= 0 then
              begin
                ChildAllow := AllowHits and (ChildIndex = ModalIndex);
              end;
            end if;

            Next := TuiPointerHitWalk(Frame, Children[ChildIndex], Next, Point, ChildAllow);
          end;
        end for;
      end;
    else
      begin
      end;
  end case;

  return Next;
end function;

// Returns the deepest eligible hit at a point.
//
// Parameters:
// - `Frame`: Arranged frame containing element geometry.
// - `Root`: Root of the element tree.
// - `Point`: Point tested by the operation.
public function TuiPointerHitAt(Frame: TuiArrangedFrame; Root: TuiElement; Point: TuiPoint): TuiPointerHit;
begin
  TuiPointerBestHit := TuiPointerHit.Miss;
  if TuiPointerHitWalk(Frame, Root, 0, Point, true) <> Frame.Count() then
    begin
      panic('Tui pointer routing did not consume the complete arranged frame');
    end;
  end if;

  return TuiPointerBestHit;
end function;
end unit;
