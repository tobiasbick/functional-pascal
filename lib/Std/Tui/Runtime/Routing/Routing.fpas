unit Std.Tui.Runtime.Routing;

uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Tui.Elements.Element as Element;
uses Std.Tui.Ids.ControlId as ControlId;
uses Std.Tui.Layout.Frame as Frame2;
uses Std.Tui.Runtime.Msg as Msg;
uses Std.Tui.Runtime.PointerEvent as PointerEvent;
uses Std.Tui.Runtime.Routing.Key as Key2;
uses Std.Tui.Runtime.Routing.Pointer as Pointer;

// Routes one key against the previous rendered tree into ordered framework messages.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Frame`: Arranged frame containing element geometry.
// - `Key`: Console key event to route or match.
public function TuiRouteKey(
  Root: Element.TuiElement;
  Frame: Frame2.TuiArrangedFrame;
  Key: Console.KeyEvent
): array of Msg.TuiMsg;
begin
  return Key2.TuiRouteKey(Root, Frame, Key);
end function;

// Routes one pointer event against arranged geometry into ordered framework messages.
// Allocates idle pointer-button state for one application.
public procedure TuiPointerRoutingOpen();
begin
  Pointer.TuiPointerRoutingOpen();
end procedure;

// Clears pointer-button state for one application.
//
// Parameters:
// - `ApplicationId`: Identifier of the application-owned routing state.
public procedure TuiPointerRoutingClose(ApplicationId: integer);
begin
  Pointer.TuiPointerRoutingClose(ApplicationId);
end procedure;

// Returns the button painted pressed for one application.
//
// Parameters:
// - `ApplicationId`: Identifier of the application-owned routing state.
public function TuiPointerRoutingPressed(ApplicationId: integer): option of ControlId.TuiControlId;
begin
  return Pointer.TuiPointerRoutingPressed(ApplicationId);
end function;

end unit;
