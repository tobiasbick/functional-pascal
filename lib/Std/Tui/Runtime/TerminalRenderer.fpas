unit Std.Tui.Runtime.TerminalRenderer;

uses
  Std.Array, Std.Console, Std.Tui.Cells.Cell, Std.Tui.Cells.Color, Std.Tui.Cells.Palette,
  Std.Tui.Cells.Style, Std.Tui.Rendering.Surface;

private function TuiColorToConsole(Color: TuiColor): Std.Console.Color;
begin
  case Color.Kind of
    TuiColorKind.Crt:
    begin
      return CrtColor(Color.Index)
    end;
    TuiColorKind.Ansi256:
    begin
      return Ansi256Color(Color.Index)
    end;
    TuiColorKind.Rgb:
    begin
      return RgbColor(Color.Red, Color.Green, Color.Blue)
    end
  end
end;

private function TuiCellToConsole(Cell: TuiCell; Palette: TuiPalette): Std.Console.Cell;
begin
  mutable var Style: TuiStyle := Palette.ForRole(Cell.Role);
  case Cell.ConcreteStyle of
    Some(Concrete):
    begin
      Style := Concrete
    end;
    None:
    begin
    end
  end;
  return record
    glyph := Cell.Glyph;
    foreground := TuiColorToConsole(Style.Foreground);
    background := TuiColorToConsole(Style.Background);
  end
end;

private function TuiTerminalDamageRow(Damage: TuiSurfaceDamage; Palette: TuiPalette): array of Std.Console.Cell;
begin
  mutable var Row: array of Std.Console.Cell := [];
  for Cell: TuiCell in Damage.Cells do
  begin
    Std.Array.Push(Row, TuiCellToConsole(Cell, Palette))
  end;
  return Row
end;

/// Flushes the current working surface through the Console frame API.
///
/// The Console cell format carries glyph and colors. Tui style attributes are intentionally
/// resolved here as color-only output because the existing Console frame API has no attributes.

procedure TuiFlushSurface(Surface: TuiWorkingSurface; Palette: TuiPalette);
begin
  var Damage: array of TuiSurfaceDamage := TuiSurfaceTakeTerminalDamage(Surface);
  if Std.Array.Length(Damage) = 0 then
  begin
    return
  end;
  BeginFrame();
  for Item: TuiSurfaceDamage in Damage do
  begin
    var Row: array of Std.Console.Cell := TuiTerminalDamageRow(Item, Palette);
    if Std.Array.Length(Row) > 0 then
    begin
      WriteCells(Item.FirstX + 1, Item.Y + 1, Row)
    end
  end;
  Present()
end;
