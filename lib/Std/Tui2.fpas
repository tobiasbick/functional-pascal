unit Std.Tui2;

const
  TuiIntegerMax: integer := 9223372036854775807;

private function TuiRequireNonNegative(Value: integer; Name: string): integer;
begin
  if Value < 0 then
  begin
    panic(('Tui2 ' + Name) + ' must not be negative')
  end;
  return Value
end;

private function TuiCheckedEdge(Origin: integer; Extent: integer; Name: string): integer;
begin
  if Origin > TuiIntegerMax - Extent then
  begin
    panic(('Tui2 ' + Name) + ' edge overflows integer coordinates')
  end;
  return Origin + Extent
end;

private function TuiMin(Left: integer; Right: integer): integer;
begin
  if Left < Right then
  begin
    return Left
  end;
  return Right
end;

private function TuiMax(Left: integer; Right: integer): integer;
begin
  if Left > Right then
  begin
    return Left
  end;
  return Right
end;

type
  TuiPoint = record
    X: integer;
    Y: integer;
  end;
  TuiSize = record
    Width: integer;
    Height: integer;

    function IsEmpty(Self: TuiSize): boolean;
    begin
      return (Self.Width = 0) or (Self.Height = 0)
    end;
  end;
  TuiRect = record
    X: integer;
    Y: integer;
    Width: integer;
    Height: integer;

    function Right(Self: TuiRect): integer;
    begin
      return TuiCheckedEdge(Self.X, Self.Width, 'right')
    end;

    function Bottom(Self: TuiRect): integer;
    begin
      return TuiCheckedEdge(Self.Y, Self.Height, 'bottom')
    end;

    function IsEmpty(Self: TuiRect): boolean;
    begin
      return (Self.Width = 0) or (Self.Height = 0)
    end;

    function Contains(Self: TuiRect; Point: TuiPoint): boolean;
    begin
      return (((Point.X >= Self.X) and (Point.X < Self.Right())) and (Point.Y >= Self.Y)) and
             (Point.Y < Self.Bottom())
    end;

    function Intersects(Self: TuiRect; Other: TuiRect): boolean;
    begin
      return (((Self.X < Other.Right()) and (Other.X < Self.Right())) and (Self.Y < Other.Bottom())) and
             (Other.Y < Self.Bottom())
    end;

    function Intersect(Self: TuiRect; Other: TuiRect): TuiRect;
    begin
      var X: integer := TuiMax(Self.X, Other.X);
      var Y: integer := TuiMax(Self.Y, Other.Y);
      var Right: integer := TuiMin(Self.Right(), Other.Right());
      var Bottom: integer := TuiMin(Self.Bottom(), Other.Bottom());
      if (Right <= X) or (Bottom <= Y) then
      begin
        return record X := X; Y := Y; Width := 0; Height := 0; end
      end;
      return record X := X; Y := Y; Width := Right - X; Height := Bottom - Y; end
    end;
  end;

function TuiPointAt(X: integer; Y: integer): TuiPoint;
begin
  return record X := X; Y := Y; end
end;

function TuiSizeOf(Width: integer; Height: integer): TuiSize;
begin
  TuiRequireNonNegative(Width, 'width');
  TuiRequireNonNegative(Height, 'height');
  return record Width := Width; Height := Height; end
end;

function TuiRectOf(X: integer; Y: integer; Width: integer; Height: integer): TuiRect;
begin
  TuiRequireNonNegative(Width, 'width');
  TuiRequireNonNegative(Height, 'height');
  TuiCheckedEdge(X, Width, 'right');
  TuiCheckedEdge(Y, Height, 'bottom');
  return record X := X; Y := Y; Width := Width; Height := Height; end
end;
