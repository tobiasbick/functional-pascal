unit Std.Tui2.Cells.Cell;

uses Std.Tui2.Cells.Glyph, Std.Tui2.Cells.StyleRole;

type
  TuiCell = record
    Glyph: string;
    Role: TuiStyleRole;

    static function Create(Glyph: string; Role: TuiStyleRole): TuiCell;
    begin
      TuiGlyphWidth(Glyph);
      return record Glyph := Glyph; Role := Role; end
    end;

    function Width(Self: TuiCell): integer;
    begin
      return TuiGlyphWidth(Self.Glyph)
    end;
  end;
