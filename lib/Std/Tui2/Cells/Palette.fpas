unit Std.Tui2.Cells.Palette;

uses Std.Tui2.Cells.Color, Std.Tui2.Cells.StyleRole, Std.Tui2.Cells.Style;

type
  TuiPalette = record
    Normal: TuiStyle;
    Disabled: TuiStyle;
    Focused: TuiStyle;
    Selected: TuiStyle;
    Shortcut: TuiStyle;
    Frame: TuiStyle;
    Title: TuiStyle;
    Failure: TuiStyle;
    Warning: TuiStyle;
    Accent: TuiStyle;

    static function Create(
  Normal: TuiStyle;
  Disabled: TuiStyle;
  Focused: TuiStyle;
  Selected: TuiStyle;
  Shortcut: TuiStyle;
  Frame: TuiStyle;
  Title: TuiStyle;
  Failure: TuiStyle;
  Warning: TuiStyle;
  Accent: TuiStyle
): TuiPalette;
    begin
      return record
        Normal := Normal;
        Disabled := Disabled;
        Focused := Focused;
        Selected := Selected;
        Shortcut := Shortcut;
        Frame := Frame;
        Title := Title;
        Failure := Failure;
        Warning := Warning;
        Accent := Accent;
      end
    end;

    static function Default(): TuiPalette;
    begin
      var Black: TuiColor := TuiColor.FromCrt(0);
      var DarkGray: TuiColor := TuiColor.FromCrt(8);
      var LightGray: TuiColor := TuiColor.FromCrt(7);
      var LightCyan: TuiColor := TuiColor.FromCrt(11);
      var LightRed: TuiColor := TuiColor.FromCrt(12);
      var Yellow: TuiColor := TuiColor.FromCrt(14);
      var Normal: TuiStyle := TuiStyle.FromColors(LightGray, Black);
      return TuiPalette.Create(Normal, TuiStyle.FromColors(DarkGray, Black), TuiStyle.FromColors(Black, LightCyan), TuiStyle.FromColors(Black, LightGray), TuiStyle.FromColors(LightCyan, Black), Normal, TuiStyle.FromColors(Yellow, Black), TuiStyle.FromColors(LightRed, Black), TuiStyle.FromColors(Yellow, Black), TuiStyle.FromColors(LightCyan, Black))
    end;

    function ForRole(Self: TuiPalette; Role: TuiStyleRole): TuiStyle;
    begin
      case Role of
        TuiStyleRole.Normal:
        begin
          return Self.Normal
        end;
        TuiStyleRole.Disabled:
        begin
          return Self.Disabled
        end;
        TuiStyleRole.Focused:
        begin
          return Self.Focused
        end;
        TuiStyleRole.Selected:
        begin
          return Self.Selected
        end;
        TuiStyleRole.Shortcut:
        begin
          return Self.Shortcut
        end;
        TuiStyleRole.Frame:
        begin
          return Self.Frame
        end;
        TuiStyleRole.Title:
        begin
          return Self.Title
        end;
        TuiStyleRole.Failure:
        begin
          return Self.Failure
        end;
        TuiStyleRole.Warning:
        begin
          return Self.Warning
        end
        else
        begin
          return Self.Accent
        end
      end
    end;

    function WithRole(Self: TuiPalette; Role: TuiStyleRole; Style: TuiStyle): TuiPalette;
    begin
      case Role of
        TuiStyleRole.Normal:
        begin
          return TuiPalette.Create(Style, Self.Disabled, Self.Focused, Self.Selected, Self.Shortcut, Self.Frame, Self.Title, Self.Failure, Self.Warning, Self.Accent)
        end;
        TuiStyleRole.Disabled:
        begin
          return TuiPalette.Create(Self.Normal, Style, Self.Focused, Self.Selected, Self.Shortcut, Self.Frame, Self.Title, Self.Failure, Self.Warning, Self.Accent)
        end;
        TuiStyleRole.Focused:
        begin
          return TuiPalette.Create(Self.Normal, Self.Disabled, Style, Self.Selected, Self.Shortcut, Self.Frame, Self.Title, Self.Failure, Self.Warning, Self.Accent)
        end;
        TuiStyleRole.Selected:
        begin
          return TuiPalette.Create(Self.Normal, Self.Disabled, Self.Focused, Style, Self.Shortcut, Self.Frame, Self.Title, Self.Failure, Self.Warning, Self.Accent)
        end;
        TuiStyleRole.Shortcut:
        begin
          return TuiPalette.Create(Self.Normal, Self.Disabled, Self.Focused, Self.Selected, Style, Self.Frame, Self.Title, Self.Failure, Self.Warning, Self.Accent)
        end;
        TuiStyleRole.Frame:
        begin
          return TuiPalette.Create(Self.Normal, Self.Disabled, Self.Focused, Self.Selected, Self.Shortcut, Style, Self.Title, Self.Failure, Self.Warning, Self.Accent)
        end;
        TuiStyleRole.Title:
        begin
          return TuiPalette.Create(Self.Normal, Self.Disabled, Self.Focused, Self.Selected, Self.Shortcut, Self.Frame, Style, Self.Failure, Self.Warning, Self.Accent)
        end;
        TuiStyleRole.Failure:
        begin
          return TuiPalette.Create(Self.Normal, Self.Disabled, Self.Focused, Self.Selected, Self.Shortcut, Self.Frame, Self.Title, Style, Self.Warning, Self.Accent)
        end;
        TuiStyleRole.Warning:
        begin
          return TuiPalette.Create(Self.Normal, Self.Disabled, Self.Focused, Self.Selected, Self.Shortcut, Self.Frame, Self.Title, Self.Failure, Style, Self.Accent)
        end
        else
        begin
          return TuiPalette.Create(Self.Normal, Self.Disabled, Self.Focused, Self.Selected, Self.Shortcut, Self.Frame, Self.Title, Self.Failure, Self.Warning, Style)
        end
      end
    end;
  end;
