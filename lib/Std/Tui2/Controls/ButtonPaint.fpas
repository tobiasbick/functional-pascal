unit Std.Tui2.Controls.ButtonPaint;

uses
  Std.Tui2.Cells.Cell, Std.Tui2.Cells.Palette, Std.Tui2.Cells.StyleRole, Std.Tui2.Controls.Button,
  Std.Tui2.Drawing.Canvas, Std.Tui2.Drawing.PaintContext, Std.Tui2.Geometry.Point,
  Std.Tui2.Geometry.Rect, Std.Tui2.Runtime.ApplicationFocus, Std.Tui2.Surface.Surface,
  Std.Tui2.Views.View, Std.Tui2.Views.ViewPaintGeometry;

private function TuiButtonPaintRole(Context: TuiPaintContext): TuiStyleRole;
begin
  if not Context.Enabled then
  begin
    return TuiStyleRole.Disabled
  end;
  if Context.Focused then
  begin
    return TuiStyleRole.Focused
  end;
  return TuiStyleRole.Normal
end;

procedure TuiButtonPaintOne(View: TuiView; Surface: TuiSurface);
begin
  if not TuiButtonMatchesView(View) then
  begin
    return
  end;
  case TuiResolveViewPaintGeometry(View, Surface.Bounds()) of
    None:
    begin
      return
    end;
    Some(Geometry):
    begin
      var LocalBounds: TuiRect := TuiRect.Create(0, 0, Geometry.Bounds.Width, Geometry.Bounds.Height);
      var LocalClip: TuiRect := TuiRect.Create(Geometry.Clip.X - Geometry.Bounds.X, Geometry.Clip.Y -
                                                                                    Geometry.Bounds.Y, Geometry.Clip.Width, Geometry.Clip.Height);
      var Canvas: TuiCanvas := TuiCanvas.CreateLocal(Surface, TuiPoint.Create(Geometry.Bounds.X, Geometry.Bounds.Y), LocalClip);
      var Context: TuiPaintContext := TuiPaintContext.Create(LocalBounds, LocalClip, Geometry.Enabled, TuiApplicationFocusMatches(View.ApplicationId, 1, View.Slot, View.Generation), TuiPalette.Default());
      var Role: TuiStyleRole := TuiButtonPaintRole(Context);
      Canvas.FillRect(Context.Bounds, TuiCell.Create(' ', Role));
      Canvas.WriteText(TuiPoint.Create(0, 0), ('[' + TuiButtonTextForView(View)) + ']', Role)
    end
  end
end;
