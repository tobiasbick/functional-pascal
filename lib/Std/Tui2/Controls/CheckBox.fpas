unit Std.Tui2.Controls.CheckBox;

uses
  Std.Array, Std.Console, Std.Tui2.Actions.Action, Std.Tui2.Cells.Cell, Std.Tui2.Cells.StyleRole,
  Std.Tui2.Controls.CheckBoxPaint, Std.Tui2.Drawing.Canvas, Std.Tui2.Drawing.PaintContext,
  Std.Tui2.Events.ChangeOrigin, Std.Tui2.Geometry.Size, Std.Tui2.Input.PointerEvent,
  Std.Tui2.Input.ViewInput, Std.Tui2.Layouts.MeasureResult, Std.Tui2.Runtime.Application,
  Std.Tui2.Runtime.ApplicationPaint, Std.Tui2.Views.CustomView, Std.Tui2.Views.View;

type
  TuiCheckBoxCallback = procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  Value: boolean;
  Origin: TuiChangeOrigin
);

private mutable var CheckBoxApplicationIds: array of integer := [];
private mutable var CheckBoxGenerations: array of integer := [];
private mutable var CheckBoxAlive: array of boolean := [];
private mutable var CheckBoxTexts: array of string := [];
private mutable var CheckBoxChecked: array of boolean := [];
private mutable var CheckBoxViews: array of TuiCustomView := [];
private mutable var CheckBoxHasAction: array of boolean := [];
private mutable var CheckBoxActions: array of TuiAction := [];
private mutable var CheckBoxOnChanged: array of option of TuiCheckBoxCallback := [];

private function CheckBoxTextWidth(Text: string): integer;
begin
  mutable var Width: integer := 4;
  for Glyph: string in Std.Console.SplitGraphemes(Text) do
  begin
    Width := Width + TuiCell.Create(Glyph, TuiStyleRole.Normal).Width()
  end;
  return Width
end;

private procedure CheckBoxRequire(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(CheckBoxGenerations)) then
  begin
    panic('Tui2 check box handle has an invalid registry slot')
  end;
  if not CheckBoxAlive[Slot - 1] then
  begin
    panic('Tui2 check box handle is stale')
  end;
  if CheckBoxGenerations[Slot - 1] <> Generation then
  begin
    panic('Tui2 check box handle generation does not match the registry')
  end;
  if CheckBoxApplicationIds[Slot - 1] <> ApplicationId then
  begin
    panic('Tui2 check box belongs to a different application')
  end;
  var Custom: TuiCustomView := CheckBoxViews[Slot - 1];
  if not Custom.IsAlive() then
  begin
    panic('Tui2 check box owns a stale view')
  end
end;

private procedure CheckBoxRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot > 0) and (Slot <= Std.Array.Length(CheckBoxGenerations)) then
  begin
    if ((CheckBoxApplicationIds[Slot - 1] = ApplicationId) and (CheckBoxGenerations[Slot - 1] = Generation)) and
       CheckBoxAlive[Slot - 1] then
    begin
      CheckBoxOnChanged[Slot - 1] := None;
      CheckBoxHasAction[Slot - 1] := false;
      CheckBoxAlive[Slot - 1] := false;
      CheckBoxGenerations[Slot - 1] := Generation + 1
    end
  end
end;

private function CheckBoxUpdate(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  Value: boolean
): boolean;
begin
  CheckBoxRequire(ApplicationId, Slot, Generation);
  var Index: integer := Slot - 1;
  if CheckBoxChecked[Index] = Value then
  begin
    return false
  end;
  CheckBoxChecked[Index] := Value;
  TuiApplicationPaintInvalidate(ApplicationId, 1);
  return true
end;

private procedure CheckBoxNotify(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  Value: boolean;
  Origin: TuiChangeOrigin
);
begin
  var Index: integer := Slot - 1;
  case CheckBoxOnChanged[Index] of
    None:
    begin
    end;
    Some(Callback):
    begin
      Callback(ApplicationId, Slot, Generation, Value, Origin)
    end
  end
end;

type
  TuiCheckBox = record
    ApplicationId: integer;
    Slot: integer;
    Generation: integer;

    static function Create(App: TuiApplication; Text: string): TuiCheckBox;
    begin
      if not App.IsOpen() then
      begin
        panic('Tui2 cannot create a check box for a closed application')
      end;
      var Custom: TuiCustomView := TuiCustomView.Create(App);
      var View: TuiView := TuiCustomView.AsView(Custom);
      View.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(CheckBoxTextWidth(Text), 1));
      CheckBoxApplicationIds := Std.Array.Concat(CheckBoxApplicationIds, [App.Id]);
      CheckBoxGenerations := Std.Array.Concat(CheckBoxGenerations, [1]);
      CheckBoxAlive := Std.Array.Concat(CheckBoxAlive, [true]);
      CheckBoxTexts := Std.Array.Concat(CheckBoxTexts, [Text]);
      CheckBoxChecked := Std.Array.Concat(CheckBoxChecked, [false]);
      CheckBoxViews := Std.Array.Concat(CheckBoxViews, [Custom]);
      CheckBoxHasAction := Std.Array.Concat(CheckBoxHasAction, [false]);
      var EmptyAction: TuiAction := record ApplicationId := 0; Slot := 0; Generation := 0; end;
      CheckBoxActions := Std.Array.Concat(CheckBoxActions, [EmptyAction]);
      CheckBoxOnChanged := Std.Array.Concat(CheckBoxOnChanged, [None]);
      var CheckBox: TuiCheckBox := record
        ApplicationId := App.Id;
        Slot := Std.Array.Length(CheckBoxGenerations);
        Generation := 1;
      end;
      var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
        CheckBoxRelease(ApplicationId, CheckBox.Slot, CheckBox.Generation)
      end;
      RegisterViewCleanup(View, Cleanup);
      var Input: TuiViewInput := Custom.Input;
      Input.OnKey := function(Sender: TuiView; Key: Std.Console.KeyEvent): boolean begin
        if (Key.kind <> Std.Console.KeyKind.Space) and (Key.kind <> Std.Console.KeyKind.Enter) then
        begin
          return false
        end;
        CheckBoxRequire(CheckBox.ApplicationId, CheckBox.Slot, CheckBox.Generation);
        return CheckBox.Toggle()
      end;
      Input.OnPointer := function(Sender: TuiView; Pointer: TuiPointerEvent): boolean begin
        if (Pointer.Action <> Std.Console.MouseAction.Down) or
           (Pointer.Button <> TuiPointerButton.Left) then
        begin
          return false
        end;
        CheckBoxRequire(CheckBox.ApplicationId, CheckBox.Slot, CheckBox.Generation);
        return CheckBox.Toggle()
      end;
      Custom.OnPaint := procedure(Sender: TuiCustomView; Canvas: TuiCanvas; Context: TuiPaintContext) begin
        CheckBoxRequire(CheckBox.ApplicationId, CheckBox.Slot, CheckBox.Generation);
        var Index: integer := CheckBox.Slot - 1;
        TuiCheckBoxPaint(Canvas, Context, CheckBoxTexts[Index], CheckBoxChecked[Index])
      end;
      return CheckBox
    end;

    function IsAlive(Self: TuiCheckBox): boolean;
    begin
      if (Self.Slot <= 0) or (Self.Slot > Std.Array.Length(CheckBoxGenerations)) then
      begin
        return false
      end;
      var Custom: TuiCustomView := CheckBoxViews[Self.Slot - 1];
      return ((CheckBoxAlive[Self.Slot - 1] and (CheckBoxGenerations[Self.Slot - 1] = Self.Generation)) and ((CheckBoxApplicationIds[Self.Slot -
                                                                                                                                     1] = Self.ApplicationId) and Custom.IsAlive()))
    end;

    static function AsView(CheckBox: TuiCheckBox): TuiView;
    begin
      CheckBoxRequire(CheckBox.ApplicationId, CheckBox.Slot, CheckBox.Generation);
      var View: TuiView := TuiCustomView.AsView(CheckBoxViews[CheckBox.Slot - 1]);
      return record
        ApplicationId := View.ApplicationId;
        Slot := View.Slot;
        Generation := View.Generation;
        Kind := TuiViewKind.CheckBox;
      end
    end;

    function ReadText(Self: TuiCheckBox): string;
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return CheckBoxTexts[Self.Slot - 1]
    end;

    procedure WriteText(Self: TuiCheckBox; Value: string);
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Index: integer := Self.Slot - 1;
      if CheckBoxTexts[Index] <> Value then
      begin
        CheckBoxTexts[Index] := Value;
        var View: TuiView := TuiCustomView.AsView(CheckBoxViews[Index]);
        View.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(CheckBoxTextWidth(Value), 1));
        TuiApplicationPaintInvalidate(Self.ApplicationId, 1)
      end
    end;

    function ReadChecked(Self: TuiCheckBox): boolean;
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return CheckBoxChecked[Self.Slot - 1]
    end;

    procedure WriteChecked(Self: TuiCheckBox; Value: boolean);
    begin
      if CheckBoxHasAction[Self.Slot - 1] then
      begin
        var Action: TuiAction := CheckBoxActions[Self.Slot - 1];
        Action.Checked := Value
      end;
      if CheckBoxUpdate(Self.ApplicationId, Self.Slot, Self.Generation, Value) then
      begin
        CheckBoxNotify(Self.ApplicationId, Self.Slot, Self.Generation, Value, TuiChangeOrigin.Programmatic)
      end
    end;

    function ReadAction(Self: TuiCheckBox): TuiAction;
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      if not CheckBoxHasAction[Self.Slot - 1] then
      begin
        panic('Tui2 check box has no action')
      end;
      return CheckBoxActions[Self.Slot - 1]
    end;

    procedure WriteAction(Self: TuiCheckBox; Value: TuiAction);
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      if Value.ApplicationId <> Self.ApplicationId then
      begin
        panic('Tui2 check box action belongs to a different application')
      end;
      if not Value.IsAlive() then
      begin
        panic('Tui2 check box action is stale')
      end;
      CheckBoxActions[Self.Slot - 1] := Value;
      CheckBoxHasAction[Self.Slot - 1] := true;
      if CheckBoxUpdate(Self.ApplicationId, Self.Slot, Self.Generation, Value.Checked) then
      begin
        CheckBoxNotify(Self.ApplicationId, Self.Slot, Self.Generation, Value.Checked, TuiChangeOrigin.Programmatic)
      end
    end;

    function Toggle(Self: TuiCheckBox): boolean;
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      mutable var Value: boolean := not CheckBoxChecked[Self.Slot - 1];
      if CheckBoxHasAction[Self.Slot - 1] then
      begin
        var Action: TuiAction := CheckBoxActions[Self.Slot - 1];
        if not Action.Enabled then
        begin
          return false
        end;
        CheckBoxUpdate(Self.ApplicationId, Self.Slot, Self.Generation, Value);
        Action.Checked := Value;
        var Source: TuiView := TuiCheckBox.AsView(Self);
        Action.Activate(Source);
        if not Self.IsAlive() then
        begin
          return true
        end;
        Value := Action.Checked
      end;
      if CheckBoxUpdate(Self.ApplicationId, Self.Slot, Self.Generation, Value) then
      begin
        CheckBoxNotify(Self.ApplicationId, Self.Slot, Self.Generation, Value, TuiChangeOrigin.User);
        return true
      end;
      if CheckBoxHasAction[Self.Slot - 1] then
      begin
        CheckBoxNotify(Self.ApplicationId, Self.Slot, Self.Generation, Value, TuiChangeOrigin.User);
        return true
      end;
      return false
    end;

    function Focus(Self: TuiCheckBox): boolean;
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Custom: TuiCustomView := CheckBoxViews[Self.Slot - 1];
      return Custom.Focus()
    end;

    function ReadFocused(Self: TuiCheckBox): boolean;
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Custom: TuiCustomView := CheckBoxViews[Self.Slot - 1];
      return Custom.Focused
    end;

    procedure Destroy(Self: TuiCheckBox);
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var View: TuiView := TuiCustomView.AsView(CheckBoxViews[Self.Slot - 1]);
      View.Destroy()
    end;

    function ReadOnChanged(Self: TuiCheckBox): option of procedure(Sender: TuiCheckBox; Value: boolean; Origin: TuiChangeOrigin);
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      case CheckBoxOnChanged[Self.Slot - 1] of
        None:
        begin
          return None
        end;
        Some(Callback):
        begin
          return Some(procedure(Sender: TuiCheckBox; Value: boolean; Origin: TuiChangeOrigin) begin
            Callback(Sender.ApplicationId, Sender.Slot, Sender.Generation, Value, Origin)
          end)
        end
      end
    end;

    procedure WriteOnChanged(
  Self: TuiCheckBox;
  Handler: option of procedure(Sender: TuiCheckBox; Value: boolean; Origin: TuiChangeOrigin)
);
    begin
      CheckBoxRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      case Handler of
        None:
        begin
          CheckBoxOnChanged[Self.Slot - 1] := None
        end;
        Some(Value):
        begin
          var Callback: TuiCheckBoxCallback := procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  Checked: boolean;
  Origin: TuiChangeOrigin
) begin
            var Sender: TuiCheckBox := record
              ApplicationId := ApplicationId;
              Slot := Slot;
              Generation := Generation;
            end;
            Value(Sender, Checked, Origin)
          end;
          CheckBoxOnChanged[Self.Slot - 1] := Some(Callback)
        end
      end
    end;

    property Text: string read ReadText write WriteText;
    property Checked: boolean read ReadChecked write WriteChecked;
    property Action: TuiAction read ReadAction write WriteAction;
    property Focused: boolean read ReadFocused;

    event OnChanged: procedure(Sender: TuiCheckBox; Value: boolean; Origin: TuiChangeOrigin) read ReadOnChanged write WriteOnChanged;
  end;
