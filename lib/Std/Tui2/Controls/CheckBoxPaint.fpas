unit Std.Tui2.Controls.CheckBoxPaint;

uses
  Std.Tui2.Cells.Cell, Std.Tui2.Cells.StyleRole, Std.Tui2.Drawing.Canvas,
  Std.Tui2.Drawing.PaintContext, Std.Tui2.Geometry.Point;

procedure TuiCheckBoxPaint(
  Canvas: TuiCanvas;
  Context: TuiPaintContext;
  Text: string;
  Checked: boolean
);
begin
  mutable var Role: TuiStyleRole := TuiStyleRole.Normal;
  if not Context.Enabled then
  begin
    Role := TuiStyleRole.Disabled
  end
  else if Context.Focused then
  begin
    Role := TuiStyleRole.Focused
  end;
  Canvas.FillRect(Context.Bounds, TuiCell.Create(' ', Role));
  mutable var Mark: string := ' ';
  if Checked then
  begin
    Mark := 'x'
  end;
  Canvas.WriteText(TuiPoint.Create(0, 0), ('[' + Mark) + '] ', Role);
  Canvas.WriteText(TuiPoint.Create(4, 0), Text, Role)
end;
