unit Std.Tui2.Controls.Dialog;

uses
  Std.Array, Std.Tui2.Controls.TitledFramePaint, Std.Tui2.Drawing.Canvas,
  Std.Tui2.Drawing.PaintContext, Std.Tui2.Actions.Command, Std.Tui2.Geometry.Rect,
  Std.Tui2.Layouts.Layout, Std.Tui2.Runtime.Application, Std.Tui2.Runtime.ApplicationPaint,
  Std.Tui2.Views.Container, Std.Tui2.Views.ContentContainer, Std.Tui2.Views.CustomView,
  Std.Tui2.Views.Modal, Std.Tui2.Views.View, Std.Tui2.Views.ViewContent;

private mutable var DialogApps: array of integer := [];
private mutable var DialogGens: array of integer := [];
private mutable var DialogAlive: array of boolean := [];
private mutable var DialogTitles: array of string := [];
private mutable var DialogContents: array of TuiContentContainer := [];
private mutable var DialogModals: array of option of TuiModal := [];
private mutable var DialogResults: array of option of TuiCommand := [];

private procedure TuiDialogRequire(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(DialogGens)) then
  begin
    panic('Tui2 dialog handle has an invalid registry slot')
  end;
  if not DialogAlive[Slot - 1] then
  begin
    panic('Tui2 dialog handle is stale')
  end;
  if DialogGens[Slot - 1] <> Generation then
  begin
    panic('Tui2 dialog handle generation does not match the registry')
  end;
  if DialogApps[Slot - 1] <> ApplicationId then
  begin
    panic('Tui2 dialog belongs to a different application')
  end;
  var Content: TuiContentContainer := DialogContents[Slot - 1];
  if not Content.IsAlive() then
  begin
    panic('Tui2 dialog owns a stale view')
  end
end;

private procedure TuiDialogRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot > 0) and (Slot <= Std.Array.Length(DialogGens)) then
  begin
    if ((DialogApps[Slot - 1] = ApplicationId) and (DialogGens[Slot - 1] = Generation)) and
       DialogAlive[Slot - 1] then
    begin
      DialogModals[Slot - 1] := None;
      DialogResults[Slot - 1] := None;
      DialogAlive[Slot - 1] := false;
      DialogGens[Slot - 1] := Generation + 1
    end
  end
end;

type
  TuiDialog = record
    ApplicationId: integer;
    Slot: integer;
    Generation: integer;

    static function Create(App: TuiApplication; Title: string): TuiDialog;
    begin
      if not App.IsOpen() then
      begin
        panic('Tui2 cannot create a dialog for a closed application')
      end;
      var Content: TuiContentContainer := TuiContentContainer.Create(App, 1, 1, 1, 1);
      DialogApps := Std.Array.Concat(DialogApps, [App.Id]);
      DialogGens := Std.Array.Concat(DialogGens, [1]);
      DialogAlive := Std.Array.Concat(DialogAlive, [true]);
      DialogTitles := Std.Array.Concat(DialogTitles, [Title]);
      DialogContents := Std.Array.Concat(DialogContents, [Content]);
      DialogModals := Std.Array.Concat(DialogModals, [None]);
      DialogResults := Std.Array.Concat(DialogResults, [None]);
      var Dialog: TuiDialog := record
        ApplicationId := App.Id;
        Slot := Std.Array.Length(DialogGens);
        Generation := 1;
      end;
      var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
        TuiDialogRelease(ApplicationId, Dialog.Slot, Dialog.Generation)
      end;
      RegisterViewCleanup(TuiContentContainer.AsView(Content), Cleanup);
      var Custom: TuiCustomView := TuiContentContainer.AsCustom(Content);
      Custom.OnPaint := procedure(Sender: TuiCustomView; Canvas: TuiCanvas; Context: TuiPaintContext) begin
        TuiDialogRequire(Dialog.ApplicationId, Dialog.Slot, Dialog.Generation);
        TuiTitleFramePaint(Canvas, Context, DialogTitles[Dialog.Slot - 1])
      end;
      return Dialog
    end;

    static function AsView(Dialog: TuiDialog): TuiView;
    begin
      TuiDialogRequire(Dialog.ApplicationId, Dialog.Slot, Dialog.Generation);
      var Content: TuiContentContainer := DialogContents[Dialog.Slot - 1];
      var View: TuiView := TuiContentContainer.AsView(Content);
      return record
        ApplicationId := View.ApplicationId;
        Slot := View.Slot;
        Generation := View.Generation;
        Kind := TuiViewKind.Dialog;
      end
    end;

    static function AsContainer(Dialog: TuiDialog): TuiContainer;
    begin
      TuiDialogRequire(Dialog.ApplicationId, Dialog.Slot, Dialog.Generation);
      var Content: TuiContentContainer := DialogContents[Dialog.Slot - 1];
      return TuiContentContainer.AsContainer(Content)
    end;

    function IsAlive(Self: TuiDialog): boolean;
    begin
      if (Self.Slot <= 0) or (Self.Slot > Std.Array.Length(DialogGens)) then
      begin
        return false
      end;
      var IsCurrent: boolean := (DialogAlive[Self.Slot - 1] and (DialogGens[Self.Slot - 1] = Self.Generation)) and
                                (DialogApps[Self.Slot - 1] = Self.ApplicationId);
      if not IsCurrent then
      begin
        return false
      end;
      var Content: TuiContentContainer := DialogContents[Self.Slot - 1];
      return Content.IsAlive()
    end;

    function ReadTitle(Self: TuiDialog): string;
    begin
      TuiDialogRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return DialogTitles[Self.Slot - 1]
    end;

    procedure WriteTitle(Self: TuiDialog; Value: string);
    begin
      TuiDialogRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      if DialogTitles[Self.Slot - 1] <> Value then
      begin
        DialogTitles[Self.Slot - 1] := Value;
        TuiApplicationPaintInvalidate(Self.ApplicationId, 1)
      end
    end;

    function ReadLayout(Self: TuiDialog): option of TuiLayout;
    begin
      return TuiDialog.AsContainer(Self).Layout
    end;

    procedure WriteLayout(Self: TuiDialog; Value: option of TuiLayout);
    begin
      var Container: TuiContainer := TuiDialog.AsContainer(Self);
      Container.Layout := Value
    end;

    function ReadContentBounds(Self: TuiDialog): TuiRect;
    begin
      return TuiViewContentBounds(TuiDialog.AsView(Self))
    end;

    procedure Add(Self: TuiDialog; Child: TuiView);
    begin
      TuiDialog.AsContainer(Self).Add(Child)
    end;

    function OpenModal(Self: TuiDialog): boolean;
    begin
      TuiDialogRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Index: integer := Self.Slot - 1;
      case DialogModals[Index] of
        Some(Modal):
        begin
          if Modal.IsActive() then
          begin
            return false
          end
        end;
        None:
        begin
        end
      end;
      var Container: TuiContainer := TuiDialog.AsContainer(Self);
      DialogResults[Index] := None;
      DialogModals[Index] := Some(TuiModal.Open(Container));
      return true
    end;

    function CloseModal(Self: TuiDialog): boolean;
    begin
      TuiDialogRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Index: integer := Self.Slot - 1;
      case DialogModals[Index] of
        None:
        begin
          return false
        end;
        Some(Modal):
        begin
          var Closed: boolean := Modal.Close();
          if Closed then
          begin
            DialogModals[Index] := None
          end;
          return Closed
        end
      end
    end;

    function IsModal(Self: TuiDialog): boolean;
    begin
      TuiDialogRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      case DialogModals[Self.Slot - 1] of
        None:
        begin
          return false
        end;
        Some(Modal):
        begin
          return Modal.IsActive()
        end
      end
    end;

    function ReadCompletedCommand(Self: TuiDialog): option of TuiCommand;
    begin
      TuiDialogRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return DialogResults[Self.Slot - 1]
    end;

    function Complete(Self: TuiDialog; Command: TuiCommand): boolean;
    begin
      if not Self.CloseModal() then
      begin
        return false
      end;
      TuiDialogRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      DialogResults[Self.Slot - 1] := Some(Command);
      return true
    end;

    function NeedsLayout(Self: TuiDialog): boolean;
    begin
      return TuiDialog.AsContainer(Self).NeedsLayout()
    end;

    function PerformLayout(Self: TuiDialog): boolean;
    begin
      return TuiDialog.AsContainer(Self).PerformLayout()
    end;

    procedure Destroy(Self: TuiDialog);
    begin
      TuiDialog.AsView(Self).Destroy()
    end;

    property Title: string read ReadTitle write WriteTitle;
    property Layout: option of TuiLayout read ReadLayout write WriteLayout;
    property ContentBounds: TuiRect read ReadContentBounds;
    property CompletedCommand: option of TuiCommand read ReadCompletedCommand;
  end;
