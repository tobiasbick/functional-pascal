unit Std.Tui2.Controls.FramePaint;

uses Std.Tui2.Cells.StyleRole, Std.Tui2.Drawing.Canvas, Std.Tui2.Drawing.PaintContext;

procedure TuiFramePaint(Canvas: TuiCanvas; Context: TuiPaintContext);
begin
  mutable var Role: TuiStyleRole := TuiStyleRole.Frame;
  if not Context.Enabled then
  begin
    Role := TuiStyleRole.Disabled
  end;
  Canvas.DrawFrame(Context.Bounds, Role)
end;
