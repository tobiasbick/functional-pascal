unit Std.Tui2.Controls.InputLine;

uses
  Std.Array, Std.Console, Std.Str, Std.Tui2.Controls.InputLinePaint, Std.Tui2.Drawing.Canvas,
  Std.Tui2.Drawing.PaintContext, Std.Tui2.Geometry.Rect, Std.Tui2.Geometry.Size,
  Std.Tui2.Input.PointerEvent, Std.Tui2.Input.ViewInput, Std.Tui2.Layouts.MeasureResult,
  Std.Tui2.Runtime.Application, Std.Tui2.Runtime.ApplicationPaint, Std.Tui2.Views.CustomView,
  Std.Tui2.Views.View;

private mutable var InputLineApplicationIds: array of integer := [];
private mutable var InputLineGenerations: array of integer := [];
private mutable var InputLineAlive: array of boolean := [];
private mutable var InputLineMaxLengths: array of integer := [];
private mutable var InputLineTexts: array of string := [];
private mutable var InputLineCursors: array of integer := [];
private mutable var InputLineViews: array of TuiCustomView := [];

private procedure InputLineRequire(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(InputLineGenerations)) then
  begin
    panic('Tui2 input line handle has an invalid registry slot')
  end;
  if not InputLineAlive[Slot - 1] then
  begin
    panic('Tui2 input line handle is stale')
  end;
  if InputLineGenerations[Slot - 1] <> Generation then
  begin
    panic('Tui2 input line handle generation does not match the registry')
  end;
  if InputLineApplicationIds[Slot - 1] <> ApplicationId then
  begin
    panic('Tui2 input line belongs to a different application')
  end;
  var Custom: TuiCustomView := InputLineViews[Slot - 1];
  if not Custom.IsAlive() then
  begin
    panic('Tui2 input line owns a stale view')
  end
end;

private procedure InputLineRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot > 0) and (Slot <= Std.Array.Length(InputLineGenerations)) then
  begin
    if ((InputLineApplicationIds[Slot - 1] = ApplicationId) and (InputLineGenerations[Slot - 1] = Generation)) and
       InputLineAlive[Slot - 1] then
    begin
      InputLineAlive[Slot - 1] := false;
      InputLineGenerations[Slot - 1] := Generation + 1
    end
  end
end;

type
  TuiInputLine = record
    ApplicationId: integer;
    Slot: integer;
    Generation: integer;

    static function Create(App: TuiApplication; MaxLength: integer): TuiInputLine;
    begin
      if not App.IsOpen() then
      begin
        panic('Tui2 cannot create an input line for a closed application')
      end;
      if MaxLength <= 0 then
      begin
        panic('Tui2 input line maximum length must be positive')
      end;
      var Custom: TuiCustomView := TuiCustomView.Create(App);
      var View: TuiView := TuiCustomView.AsView(Custom);
      View.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(MaxLength, 1));
      InputLineApplicationIds := Std.Array.Concat(InputLineApplicationIds, [App.Id]);
      InputLineGenerations := Std.Array.Concat(InputLineGenerations, [1]);
      InputLineAlive := Std.Array.Concat(InputLineAlive, [true]);
      InputLineMaxLengths := Std.Array.Concat(InputLineMaxLengths, [MaxLength]);
      InputLineTexts := Std.Array.Concat(InputLineTexts, ['']);
      InputLineCursors := Std.Array.Concat(InputLineCursors, [0]);
      InputLineViews := Std.Array.Concat(InputLineViews, [Custom]);
      var InputLine: TuiInputLine := record
        ApplicationId := App.Id;
        Slot := Std.Array.Length(InputLineGenerations);
        Generation := 1;
      end;
      var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
        InputLineRelease(ApplicationId, InputLine.Slot, InputLine.Generation)
      end;
      RegisterViewCleanup(View, Cleanup);
      var Input: TuiViewInput := Custom.Input;
      Input.OnKey := function(Sender: TuiView; Key: Std.Console.KeyEvent): boolean begin
        InputLineRequire(InputLine.ApplicationId, InputLine.Slot, InputLine.Generation);
        var Index: integer := InputLine.Slot - 1;
        mutable var Changed: boolean := false;
        if Key.kind = Std.Console.KeyKind.Character then
        begin
          if ((not Key.ctrl) and ((not Key.alt) and (not Key.meta))) and
             (Std.Str.Length(InputLineTexts[Index]) < InputLineMaxLengths[Index]) then
          begin
            InputLineTexts[Index] := Std.Str.Insert(InputLineTexts[Index], InputLineCursors[Index], Key.ch);
            InputLineCursors[Index] := InputLineCursors[Index] + Std.Str.Length(Key.ch);
            Changed := true
          end
        end
        else if Key.kind = Std.Console.KeyKind.Space then
        begin
          if Std.Str.Length(InputLineTexts[Index]) < InputLineMaxLengths[Index] then
          begin
            InputLineTexts[Index] := Std.Str.Insert(InputLineTexts[Index], InputLineCursors[Index], ' ');
            InputLineCursors[Index] := InputLineCursors[Index] + 1;
            Changed := true
          end
        end
        else if Key.kind = Std.Console.KeyKind.Backspace then
        begin
          if InputLineCursors[Index] > 0 then
          begin
            InputLineTexts[Index] := Std.Str.Delete(InputLineTexts[Index], InputLineCursors[Index] -
                                                                           1, 1);
            InputLineCursors[Index] := InputLineCursors[Index] - 1;
            Changed := true
          end
        end
        else if Key.kind = Std.Console.KeyKind.Delete then
        begin
          if InputLineCursors[Index] < Std.Str.Length(InputLineTexts[Index]) then
          begin
            InputLineTexts[Index] := Std.Str.Delete(InputLineTexts[Index], InputLineCursors[Index], 1);
            Changed := true
          end
        end
        else if Key.kind = Std.Console.KeyKind.Left then
        begin
          if InputLineCursors[Index] > 0 then
          begin
            InputLineCursors[Index] := InputLineCursors[Index] - 1
          end;
          return true
        end
        else if Key.kind = Std.Console.KeyKind.Right then
        begin
          if InputLineCursors[Index] < Std.Str.Length(InputLineTexts[Index]) then
          begin
            InputLineCursors[Index] := InputLineCursors[Index] + 1
          end;
          return true
        end
        else if Key.kind = Std.Console.KeyKind.Home then
        begin
          InputLineCursors[Index] := 0;
          return true
        end
        else
        begin
          return false
        end;
        if Changed then
        begin
          TuiApplicationPaintInvalidate(InputLine.ApplicationId, 1)
        end;
        return Changed
      end;
      Input.OnPointer := function(Sender: TuiView; Pointer: TuiPointerEvent): boolean begin
        if (Pointer.Action <> Std.Console.MouseAction.Down) or
           (Pointer.Button <> TuiPointerButton.Left) then
        begin
          return false
        end;
        InputLineRequire(InputLine.ApplicationId, InputLine.Slot, InputLine.Generation);
        var Index: integer := InputLine.Slot - 1;
        var Bounds: TuiRect := TuiCustomView.AsView(InputLineViews[Index]).Bounds;
        mutable var Cursor: integer := Pointer.Position.X - Bounds.X;
        if Cursor < 0 then
        begin
          Cursor := 0
        end;
        var Length: integer := Std.Str.Length(InputLineTexts[Index]);
        if Cursor > Length then
        begin
          Cursor := Length
        end;
        InputLineCursors[Index] := Cursor;
        return true
      end;
      Custom.OnPaint := procedure(Sender: TuiCustomView; Canvas: TuiCanvas; Context: TuiPaintContext) begin
        InputLineRequire(InputLine.ApplicationId, InputLine.Slot, InputLine.Generation);
        TuiInputLinePaintText(Canvas, Context, InputLineTexts[InputLine.Slot - 1])
      end;
      return InputLine
    end;

    function IsAlive(Self: TuiInputLine): boolean;
    begin
      if (Self.Slot <= 0) or (Self.Slot > Std.Array.Length(InputLineGenerations)) then
      begin
        return false
      end;
      var Custom: TuiCustomView := InputLineViews[Self.Slot - 1];
      return ((InputLineAlive[Self.Slot - 1] and (InputLineGenerations[Self.Slot - 1] = Self.Generation)) and ((InputLineApplicationIds[Self.Slot -
                                                                                                                                        1] = Self.ApplicationId) and Custom.IsAlive()))
    end;

    static function AsView(InputLine: TuiInputLine): TuiView;
    begin
      InputLineRequire(InputLine.ApplicationId, InputLine.Slot, InputLine.Generation);
      var View: TuiView := TuiCustomView.AsView(InputLineViews[InputLine.Slot - 1]);
      return record
        ApplicationId := View.ApplicationId;
        Slot := View.Slot;
        Generation := View.Generation;
        Kind := TuiViewKind.InputLine;
      end
    end;

    function ReadText(Self: TuiInputLine): string;
    begin
      InputLineRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return InputLineTexts[Self.Slot - 1]
    end;

    procedure WriteText(Self: TuiInputLine; Value: string);
    begin
      InputLineRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Index: integer := Self.Slot - 1;
      if Std.Str.Length(Value) > InputLineMaxLengths[Index] then
      begin
        panic('Tui2 input line text exceeds its maximum length')
      end;
      if InputLineTexts[Index] <> Value then
      begin
        InputLineTexts[Index] := Value;
        InputLineCursors[Index] := Std.Str.Length(Value);
        TuiApplicationPaintInvalidate(Self.ApplicationId, 1)
      end
    end;

    function ReadMaxLength(Self: TuiInputLine): integer;
    begin
      InputLineRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return InputLineMaxLengths[Self.Slot - 1]
    end;

    function ReadFocused(Self: TuiInputLine): boolean;
    begin
      InputLineRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Custom: TuiCustomView := InputLineViews[Self.Slot - 1];
      return Custom.Focused
    end;

    function Focus(Self: TuiInputLine): boolean;
    begin
      InputLineRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Custom: TuiCustomView := InputLineViews[Self.Slot - 1];
      return Custom.Focus()
    end;

    procedure Destroy(Self: TuiInputLine);
    begin
      InputLineRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Custom: TuiCustomView := InputLineViews[Self.Slot - 1];
      var View: TuiView := TuiCustomView.AsView(Custom);
      View.Destroy()
    end;

    property Text: string read ReadText write WriteText;
    property MaxLength: integer read ReadMaxLength;
    property Focused: boolean read ReadFocused;
  end;
