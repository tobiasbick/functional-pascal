unit Std.Tui2.Controls.LabelPaint;

uses
  Std.Tui2.Cells.Cell, Std.Tui2.Cells.StyleRole, Std.Tui2.Controls.Label, Std.Tui2.Drawing.Canvas,
  Std.Tui2.Geometry.Point, Std.Tui2.Geometry.Rect, Std.Tui2.Surface.Surface, Std.Tui2.Views.View,
  Std.Tui2.Views.ViewPaintGeometry;

procedure TuiLabelPaintOne(View: TuiView; Surface: TuiSurface);
begin
  if not TuiLabelMatchesView(View) then
  begin
    return
  end;
  case TuiResolveViewPaintGeometry(View, Surface.Bounds()) of
    None:
    begin
      return
    end;
    Some(Geometry):
    begin
      var LocalBounds: TuiRect := TuiRect.Create(0, 0, Geometry.Bounds.Width, Geometry.Bounds.Height);
      var LocalClip: TuiRect := TuiRect.Create(Geometry.Clip.X - Geometry.Bounds.X, Geometry.Clip.Y -
                                                                                    Geometry.Bounds.Y, Geometry.Clip.Width, Geometry.Clip.Height);
      var Canvas: TuiCanvas := TuiCanvas.CreateLocal(Surface, TuiPoint.Create(Geometry.Bounds.X, Geometry.Bounds.Y), LocalClip);
      mutable var Role: TuiStyleRole := TuiStyleRole.Normal;
      if not Geometry.Enabled then
      begin
        Role := TuiStyleRole.Disabled
      end;
      Canvas.FillRect(LocalBounds, TuiCell.Create(' ', Role));
      Canvas.WriteText(TuiPoint.Create(0, 0), TuiLabelTextForView(View), Role)
    end
  end
end;
