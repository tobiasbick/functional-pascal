unit Std.Tui2.Controls.ScrollBar;

uses
  Std.Array, Std.Console, Std.Tui2.Controls.ScrollBarGeometry, Std.Tui2.Controls.ScrollBarPaint,
  Std.Tui2.Drawing.Canvas, Std.Tui2.Drawing.PaintContext, Std.Tui2.Events.ChangeOrigin,
  Std.Tui2.Geometry.Rect, Std.Tui2.Geometry.Size, Std.Tui2.Input.PointerEvent,
  Std.Tui2.Input.ViewInput, Std.Tui2.Layouts.MeasureResult, Std.Tui2.Runtime.Application,
  Std.Tui2.Runtime.ApplicationPaint, Std.Tui2.Views.CustomView, Std.Tui2.Views.View;

type
  TuiScrollBarCallback = procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  Position: integer;
  Origin: TuiChangeOrigin
);

private mutable var ScrollBarApplicationIds: array of integer := [];
private mutable var ScrollBarGenerations: array of integer := [];
private mutable var ScrollBarAlive: array of boolean := [];
private mutable var ScrollBarMaximums: array of integer := [];
private mutable var ScrollBarPageSizes: array of integer := [];
private mutable var ScrollBarPositions: array of integer := [];
private mutable var ScrollBarViews: array of TuiCustomView := [];
private mutable var ScrollBarOnPositionChanged: array of option of TuiScrollBarCallback := [];

private procedure TuiScrollBarRequire(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(ScrollBarGenerations)) then
  begin
    panic('Tui2 scroll bar handle has an invalid registry slot')
  end;
  if not ScrollBarAlive[Slot - 1] then
  begin
    panic('Tui2 scroll bar handle is stale')
  end;
  if ScrollBarGenerations[Slot - 1] <> Generation then
  begin
    panic('Tui2 scroll bar handle generation does not match the registry')
  end;
  if ScrollBarApplicationIds[Slot - 1] <> ApplicationId then
  begin
    panic('Tui2 scroll bar belongs to a different application')
  end;
  var Custom: TuiCustomView := ScrollBarViews[Slot - 1];
  if not Custom.IsAlive() then
  begin
    panic('Tui2 scroll bar owns a stale view')
  end
end;

private procedure TuiScrollBarRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot > 0) and (Slot <= Std.Array.Length(ScrollBarGenerations)) then
  begin
    if ((ScrollBarApplicationIds[Slot - 1] = ApplicationId) and (ScrollBarGenerations[Slot - 1] = Generation)) and
       ScrollBarAlive[Slot - 1] then
    begin
      ScrollBarOnPositionChanged[Slot - 1] := None;
      ScrollBarAlive[Slot - 1] := false;
      ScrollBarGenerations[Slot - 1] := Generation + 1
    end
  end
end;

private function TuiScrollBarCommitPosition(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  Value: integer;
  Origin: TuiChangeOrigin
): boolean;
begin
  TuiScrollBarRequire(ApplicationId, Slot, Generation);
  var Index: integer := Slot - 1;
  var Position: integer := TuiScrollBarClamp(Value, ScrollBarMaximums[Index]);
  if ScrollBarPositions[Index] = Position then
  begin
    return false
  end;
  ScrollBarPositions[Index] := Position;
  TuiApplicationPaintInvalidate(ApplicationId, 1);
  case ScrollBarOnPositionChanged[Index] of
    None:
    begin
    end;
    Some(Callback):
    begin
      Callback(ApplicationId, Slot, Generation, Position, Origin)
    end
  end;
  return true
end;

type
  TuiScrollBar = record
    ApplicationId: integer;
    Slot: integer;
    Generation: integer;

    static function Create(App: TuiApplication): TuiScrollBar;
    begin
      if not App.IsOpen() then
      begin
        panic('Tui2 cannot create a scroll bar for a closed application')
      end;
      var Custom: TuiCustomView := TuiCustomView.Create(App);
      var View: TuiView := TuiCustomView.AsView(Custom);
      View.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(1, 5));
      ScrollBarApplicationIds := Std.Array.Concat(ScrollBarApplicationIds, [App.Id]);
      ScrollBarGenerations := Std.Array.Concat(ScrollBarGenerations, [1]);
      ScrollBarAlive := Std.Array.Concat(ScrollBarAlive, [true]);
      ScrollBarMaximums := Std.Array.Concat(ScrollBarMaximums, [0]);
      ScrollBarPageSizes := Std.Array.Concat(ScrollBarPageSizes, [1]);
      ScrollBarPositions := Std.Array.Concat(ScrollBarPositions, [0]);
      ScrollBarViews := Std.Array.Concat(ScrollBarViews, [Custom]);
      ScrollBarOnPositionChanged := Std.Array.Concat(ScrollBarOnPositionChanged, [None]);
      var ScrollBar: TuiScrollBar := record
        ApplicationId := App.Id;
        Slot := Std.Array.Length(ScrollBarGenerations);
        Generation := 1;
      end;
      var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
        TuiScrollBarRelease(ApplicationId, ScrollBar.Slot, ScrollBar.Generation)
      end;
      RegisterViewCleanup(View, Cleanup);
      var Input: TuiViewInput := Custom.Input;
      Input.OnKey := function(Sender: TuiView; Key: Std.Console.KeyEvent): boolean begin
        TuiScrollBarRequire(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation);
        var Index: integer := ScrollBar.Slot - 1;
        if Key.kind = Std.Console.KeyKind.Up then
        begin
          TuiScrollBarCommitPosition(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation, ScrollBarPositions[Index] -
                                                                                                    1, TuiChangeOrigin.User);
          return true
        end;
        if Key.kind = Std.Console.KeyKind.Down then
        begin
          TuiScrollBarCommitPosition(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation, ScrollBarPositions[Index] +
                                                                                                    1, TuiChangeOrigin.User);
          return true
        end;
        if Key.kind = Std.Console.KeyKind.Home then
        begin
          TuiScrollBarCommitPosition(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation, 0, TuiChangeOrigin.User);
          return true
        end;
        return false
      end;
      Input.OnPointer := function(Sender: TuiView; Pointer: TuiPointerEvent): boolean begin
        if (Pointer.Action <> Std.Console.MouseAction.Down) or
           (Pointer.Button <> TuiPointerButton.Left) then
        begin
          return false
        end;
        TuiScrollBarRequire(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation);
        var Index: integer := ScrollBar.Slot - 1;
        var Bounds: TuiRect := TuiCustomView.AsView(ScrollBarViews[Index]).Bounds;
        var LocalY: integer := Pointer.Position.Y - Bounds.Y;
        if LocalY = 0 then
        begin
          TuiScrollBarCommitPosition(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation, ScrollBarPositions[Index] -
                                                                                                    1, TuiChangeOrigin.User)
        end
        else if LocalY = Bounds.Height - 1 then
        begin
          TuiScrollBarCommitPosition(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation, ScrollBarPositions[Index] +
                                                                                                    1, TuiChangeOrigin.User)
        end
        else
        begin
          TuiScrollBarCommitPosition(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation, TuiScrollBarPositionAt(Bounds.Height, ScrollBarMaximums[Index], ScrollBarPageSizes[Index], LocalY), TuiChangeOrigin.User)
        end;
        return true
      end;
      Custom.OnPaint := procedure(Sender: TuiCustomView; Canvas: TuiCanvas; Context: TuiPaintContext) begin
        TuiScrollBarRequire(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation);
        var Index: integer := ScrollBar.Slot - 1;
        TuiScrollBarPaint(Canvas, Context, ScrollBarMaximums[Index], ScrollBarPageSizes[Index], ScrollBarPositions[Index])
      end;
      return ScrollBar
    end;

    function IsAlive(Self: TuiScrollBar): boolean;
    begin
      if (Self.Slot <= 0) or (Self.Slot > Std.Array.Length(ScrollBarGenerations)) then
      begin
        return false
      end;
      return ((ScrollBarAlive[Self.Slot - 1] and (ScrollBarGenerations[Self.Slot - 1] = Self.Generation)) and (ScrollBarApplicationIds[Self.Slot -
                                                                                                                                       1] = Self.ApplicationId)) and
             ScrollBarViews[Self.Slot - 1].IsAlive()
    end;

    static function AsView(ScrollBar: TuiScrollBar): TuiView;
    begin
      TuiScrollBarRequire(ScrollBar.ApplicationId, ScrollBar.Slot, ScrollBar.Generation);
      var View: TuiView := TuiCustomView.AsView(ScrollBarViews[ScrollBar.Slot - 1]);
      return record
        ApplicationId := View.ApplicationId;
        Slot := View.Slot;
        Generation := View.Generation;
        Kind := TuiViewKind.ScrollBar;
      end
    end;

    function ReadMaximum(Self: TuiScrollBar): integer;
    begin
      TuiScrollBarRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return ScrollBarMaximums[Self.Slot - 1]
    end;

    procedure WriteMaximum(Self: TuiScrollBar; Value: integer);
    begin
      if Value < 0 then
      begin
        panic('Tui2 scroll bar maximum must not be negative')
      end;
      TuiScrollBarRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Index: integer := Self.Slot - 1;
      if ScrollBarMaximums[Index] <> Value then
      begin
        ScrollBarMaximums[Index] := Value;
        TuiScrollBarCommitPosition(Self.ApplicationId, Self.Slot, Self.Generation, ScrollBarPositions[Index], TuiChangeOrigin.Programmatic);
        TuiApplicationPaintInvalidate(Self.ApplicationId, 1)
      end
    end;

    function ReadPageSize(Self: TuiScrollBar): integer;
    begin
      TuiScrollBarRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return ScrollBarPageSizes[Self.Slot - 1]
    end;

    procedure WritePageSize(Self: TuiScrollBar; Value: integer);
    begin
      if Value <= 0 then
      begin
        panic('Tui2 scroll bar page size must be positive')
      end;
      TuiScrollBarRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Index: integer := Self.Slot - 1;
      if ScrollBarPageSizes[Index] <> Value then
      begin
        ScrollBarPageSizes[Index] := Value;
        TuiApplicationPaintInvalidate(Self.ApplicationId, 1)
      end
    end;

    function ReadPosition(Self: TuiScrollBar): integer;
    begin
      TuiScrollBarRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return ScrollBarPositions[Self.Slot - 1]
    end;

    procedure WritePosition(Self: TuiScrollBar; Value: integer);
    begin
      TuiScrollBarCommitPosition(Self.ApplicationId, Self.Slot, Self.Generation, Value, TuiChangeOrigin.Programmatic)
    end;

    function Focus(Self: TuiScrollBar): boolean;
    begin
      TuiScrollBarRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return ScrollBarViews[Self.Slot - 1].Focus()
    end;

    procedure Destroy(Self: TuiScrollBar);
    begin
      TuiScrollBar.AsView(Self).Destroy()
    end;

    function ReadOnPositionChanged(Self: TuiScrollBar): option of procedure(Sender: TuiScrollBar; Position: integer; Origin: TuiChangeOrigin);
    begin
      TuiScrollBarRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      case ScrollBarOnPositionChanged[Self.Slot - 1] of
        None:
        begin
          return None
        end;
        Some(Callback):
        begin
          return Some(procedure(Sender: TuiScrollBar; Position: integer; Origin: TuiChangeOrigin) begin
            Callback(Sender.ApplicationId, Sender.Slot, Sender.Generation, Position, Origin)
          end)
        end
      end
    end;

    procedure WriteOnPositionChanged(
  Self: TuiScrollBar;
  Handler: option of procedure(Sender: TuiScrollBar; Position: integer; Origin: TuiChangeOrigin)
);
    begin
      TuiScrollBarRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      case Handler of
        None:
        begin
          ScrollBarOnPositionChanged[Self.Slot - 1] := None
        end;
        Some(Value):
        begin
          var Callback: TuiScrollBarCallback := procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  Position: integer;
  Origin: TuiChangeOrigin
) begin
            var Sender: TuiScrollBar := record
              ApplicationId := ApplicationId;
              Slot := Slot;
              Generation := Generation;
            end;
            Value(Sender, Position, Origin)
          end;
          ScrollBarOnPositionChanged[Self.Slot - 1] := Some(Callback)
        end
      end
    end;

    property Maximum: integer read ReadMaximum write WriteMaximum;
    property PageSize: integer read ReadPageSize write WritePageSize;
    property Position: integer read ReadPosition write WritePosition;

    event OnPositionChanged: procedure(Sender: TuiScrollBar; Position: integer; Origin: TuiChangeOrigin) read ReadOnPositionChanged write WriteOnPositionChanged;
  end;
