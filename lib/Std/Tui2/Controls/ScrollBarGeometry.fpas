unit Std.Tui2.Controls.ScrollBarGeometry;

function TuiScrollBarClamp(Value: integer; Maximum: integer): integer;
begin
  if Value < 0 then
  begin
    return 0
  end;
  if Value > Maximum then
  begin
    return Maximum
  end;
  return Value
end;

function TuiScrollBarTrackLength(Height: integer): integer;
begin
  if Height <= 2 then
  begin
    return 0
  end;
  return Height - 2
end;

function TuiScrollBarThumbLength(Height: integer; Maximum: integer; PageSize: integer): integer;
begin
  var Track: integer := TuiScrollBarTrackLength(Height);
  if Track = 0 then
  begin
    return Height
  end;
  if Maximum = 0 then
  begin
    return Track
  end;
  var Length: integer := (Track * PageSize) div (Maximum + PageSize);
  if Length < 1 then
  begin
    return 1
  end;
  if Length > Track then
  begin
    return Track
  end;
  return Length
end;

function TuiScrollBarThumbOffset(
  Height: integer;
  Maximum: integer;
  PageSize: integer;
  Position: integer
): integer;
begin
  var Track: integer := TuiScrollBarTrackLength(Height);
  var Length: integer := TuiScrollBarThumbLength(Height, Maximum, PageSize);
  if (Maximum = 0) or (Track <= Length) then
  begin
    return 0
  end;
  return ((Track - Length) * Position) div Maximum
end;

function TuiScrollBarPositionAt(
  Height: integer;
  Maximum: integer;
  PageSize: integer;
  LocalY: integer
): integer;
begin
  var Track: integer := TuiScrollBarTrackLength(Height);
  var Length: integer := TuiScrollBarThumbLength(Height, Maximum, PageSize);
  if (Maximum = 0) or (Track <= Length) then
  begin
    return 0
  end;
  mutable var Offset: integer := LocalY - 1;
  if Offset < 0 then
  begin
    Offset := 0
  end;
  if Offset > (Track - Length) then
  begin
    Offset := Track - Length
  end;
  return (Offset * Maximum) div (Track - Length)
end;
