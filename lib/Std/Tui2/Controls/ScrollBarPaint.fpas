unit Std.Tui2.Controls.ScrollBarPaint;

uses
  Std.Tui2.Cells.Cell, Std.Tui2.Cells.StyleRole, Std.Tui2.Controls.ScrollBarGeometry,
  Std.Tui2.Drawing.Canvas, Std.Tui2.Drawing.PaintContext, Std.Tui2.Geometry.Point;

procedure TuiScrollBarPaint(
  Canvas: TuiCanvas;
  Context: TuiPaintContext;
  Maximum: integer;
  PageSize: integer;
  Position: integer
);
begin
  mutable var TrackRole: TuiStyleRole := TuiStyleRole.Normal;
  mutable var ThumbRole: TuiStyleRole := TuiStyleRole.Accent;
  if Context.Focused then
  begin
    ThumbRole := TuiStyleRole.Focused
  end;
  if not Context.Enabled then
  begin
    TrackRole := TuiStyleRole.Disabled;
    ThumbRole := TuiStyleRole.Disabled
  end;
  if Context.Bounds.Height = 1 then
  begin
    Canvas.PutCell(TuiPoint.Create(0, 0), TuiCell.Create('█', ThumbRole));
    return
  end;
  Canvas.PutCell(TuiPoint.Create(0, 0), TuiCell.Create('▲', TrackRole));
  if Context.Bounds.Height > 1 then
  begin
    Canvas.PutCell(TuiPoint.Create(0, Context.Bounds.Height - 1), TuiCell.Create('▼', TrackRole))
  end;
  var Track: integer := TuiScrollBarTrackLength(Context.Bounds.Height);
  for Y: integer := 0 to Track - 1 do
  begin
    Canvas.PutCell(TuiPoint.Create(0, Y + 1), TuiCell.Create('░', TrackRole))
  end;
  var Length: integer := TuiScrollBarThumbLength(Context.Bounds.Height, Maximum, PageSize);
  var Offset: integer := TuiScrollBarThumbOffset(Context.Bounds.Height, Maximum, PageSize, Position);
  for Y: integer := 0 to Length - 1 do
  begin
    Canvas.PutCell(TuiPoint.Create(0, (Offset + Y) + 1), TuiCell.Create('█', ThumbRole))
  end
end;
