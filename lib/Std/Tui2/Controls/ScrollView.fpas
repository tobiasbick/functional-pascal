unit Std.Tui2.Controls.ScrollView;

uses
  Std.Tui2.Controls.ScrollViewGeometry, Std.Tui2.Controls.ScrollViewState, Std.Tui2.Geometry.Point,
  Std.Tui2.Geometry.Rect, Std.Tui2.Geometry.Size, Std.Tui2.Layouts.Invalidation,
  Std.Tui2.Layouts.Layout, Std.Tui2.Runtime.Application, Std.Tui2.Views.Container,
  Std.Tui2.Views.ContainerLayoutPass, Std.Tui2.Views.View;

private procedure TuiScrollViewInvalidateLayout(Container: TuiContainer);
begin
  case Container.Layout of
    None:
    begin
    end;
    Some(Layout):
    begin
      TuiLayoutInvalidation.Invalidate(Layout)
    end
  end
end;

private function TuiScrollViewNormalize(Container: TuiContainer): TuiPoint;
begin
  var View: TuiView := TuiContainer.AsView(Container);
  var Viewport: TuiSize := TuiScrollViewViewportSize(View);
  var Content: TuiSize := TuiScrollViewContentSize(View, Container.Layout);
  var Maximum: TuiPoint := TuiScrollViewMaximumOffset(Viewport, Content);
  var Existing: TuiPoint := TuiScrollViewStateRead(View);
  var Normalized: TuiPoint := TuiScrollViewClampOffset(Existing, Maximum);
  if TuiScrollViewStateWrite(View, Normalized) then
  begin
    TuiScrollViewInvalidateLayout(Container)
  end;
  return Normalized
end;

private function TuiScrollViewLayoutBounds(Container: TuiContainer; Offset: TuiPoint): TuiRect;
begin
  var View: TuiView := TuiContainer.AsView(Container);
  var Content: TuiSize := TuiScrollViewContentSize(View, Container.Layout);
  return TuiRect.Create(- Offset.X, - Offset.Y, Content.Width, Content.Height)
end;

type
  TuiScrollView = record
    Container: TuiContainer;

    static function Create(App: TuiApplication): TuiScrollView;
    begin
      var Container: TuiContainer := TuiContainer.Create(App);
      TuiScrollViewStateRead(TuiContainer.AsView(Container));
      return record Container := Container; end
    end;

    static function AsContainer(ScrollView: TuiScrollView): TuiContainer;
    begin
      if not ScrollView.IsAlive() then
      begin
        panic('Tui2 scroll view handle is stale')
      end;
      return ScrollView.Container
    end;

    static function AsView(ScrollView: TuiScrollView): TuiView;
    begin
      return TuiContainer.AsView(TuiScrollView.AsContainer(ScrollView))
    end;

    function IsAlive(Self: TuiScrollView): boolean;
    begin
      return Self.Container.IsAlive()
    end;

    function ReadLayout(Self: TuiScrollView): option of TuiLayout;
    begin
      return TuiScrollView.AsContainer(Self).Layout
    end;

    procedure WriteLayout(Self: TuiScrollView; Value: option of TuiLayout);
    begin
      var Container: TuiContainer := TuiScrollView.AsContainer(Self);
      Container.Layout := Value;
      TuiScrollViewNormalize(Container)
    end;

    function ReadOffset(Self: TuiScrollView): TuiPoint;
    begin
      return TuiScrollViewNormalize(TuiScrollView.AsContainer(Self))
    end;

    procedure WriteOffset(Self: TuiScrollView; Value: TuiPoint);
    begin
      if (Value.X < 0) or (Value.Y < 0) then
      begin
        panic('Tui2 scroll offset must not be negative')
      end;
      var Container: TuiContainer := TuiScrollView.AsContainer(Self);
      var View: TuiView := TuiContainer.AsView(Container);
      var Viewport: TuiSize := TuiScrollViewViewportSize(View);
      var Content: TuiSize := TuiScrollViewContentSize(View, Container.Layout);
      var Maximum: TuiPoint := TuiScrollViewMaximumOffset(Viewport, Content);
      var Normalized: TuiPoint := TuiScrollViewClampOffset(Value, Maximum);
      if TuiScrollViewStateWrite(View, Normalized) then
      begin
        TuiScrollViewInvalidateLayout(Container)
      end
    end;

    function ReadViewportSize(Self: TuiScrollView): TuiSize;
    begin
      return TuiScrollViewViewportSize(TuiScrollView.AsView(Self))
    end;

    function ReadContentSize(Self: TuiScrollView): TuiSize;
    begin
      var Container: TuiContainer := TuiScrollView.AsContainer(Self);
      return TuiScrollViewContentSize(TuiContainer.AsView(Container), Container.Layout)
    end;

    function ReadMaximumOffset(Self: TuiScrollView): TuiPoint;
    begin
      return TuiScrollViewMaximumOffset(Self.ViewportSize, Self.ContentSize)
    end;

    function NeedsLayout(Self: TuiScrollView): boolean;
    begin
      var Container: TuiContainer := TuiScrollView.AsContainer(Self);
      var Offset: TuiPoint := TuiScrollViewNormalize(Container);
      return TuiContainerLayoutNeedsPassAt(TuiContainer.AsView(Container), TuiScrollViewLayoutBounds(Container, Offset))
    end;

    function PerformLayout(Self: TuiScrollView): boolean;
    begin
      var Container: TuiContainer := TuiScrollView.AsContainer(Self);
      var Offset: TuiPoint := TuiScrollViewNormalize(Container);
      return TuiContainerLayoutPerformPassAt(TuiContainer.AsView(Container), TuiScrollViewLayoutBounds(Container, Offset))
    end;

    procedure Destroy(Self: TuiScrollView);
    begin
      TuiScrollView.AsView(Self).Destroy()
    end;

    property Layout: option of TuiLayout read ReadLayout write WriteLayout;
    property Offset: TuiPoint read ReadOffset write WriteOffset;
    property ViewportSize: TuiSize read ReadViewportSize;
    property ContentSize: TuiSize read ReadContentSize;
    property MaximumOffset: TuiPoint read ReadMaximumOffset;
  end;
