unit Std.Tui2.Controls.ScrollViewState;

uses Std.Array, Std.Tui2.Geometry.Point, Std.Tui2.Views.View;

private mutable var TuiScrollViewStateApplicationIds: array of integer := [];
private mutable var TuiScrollViewStateSlots: array of integer := [];
private mutable var TuiScrollViewStateGenerations: array of integer := [];
private mutable var TuiScrollViewStateOffsets: array of TuiPoint := [];
private mutable var TuiScrollViewStateActive: array of boolean := [];

private function TuiScrollViewStateFind(View: TuiView): integer;
begin
  for I: integer := 0 to Std.Array.Length(TuiScrollViewStateActive) - 1 do
  begin
    if (((TuiScrollViewStateActive[I] and (TuiScrollViewStateApplicationIds[I] = View.ApplicationId)) and (TuiScrollViewStateSlots[I] = View.Slot)) and (TuiScrollViewStateGenerations[I] = View.Generation)) then
    begin
      return I
    end
  end;
  return -1
end;

private procedure TuiScrollViewStateRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var View: TuiView := record
    ApplicationId := ApplicationId;
    Slot := Slot;
    Generation := Generation;
    Kind := TuiViewKind.Custom;
  end;
  var Index: integer := TuiScrollViewStateFind(View);
  if Index >= 0 then
  begin
    TuiScrollViewStateActive[Index] := false
  end
end;

private function TuiScrollViewStateEnsure(View: TuiView): integer;
begin
  if not View.IsAlive() then
  begin
    panic('Tui2 cannot access scroll state for a stale view')
  end;
  var Existing: integer := TuiScrollViewStateFind(View);
  if Existing >= 0 then
  begin
    return Existing
  end;
  TuiScrollViewStateApplicationIds := Std.Array.Concat(TuiScrollViewStateApplicationIds, [
                                                                                           View.ApplicationId

                                                                                         ]);
  TuiScrollViewStateSlots := Std.Array.Concat(TuiScrollViewStateSlots, [View.Slot]);
  TuiScrollViewStateGenerations := Std.Array.Concat(TuiScrollViewStateGenerations, [View.Generation]);
  TuiScrollViewStateOffsets := Std.Array.Concat(TuiScrollViewStateOffsets, [TuiPoint.Create(0, 0)]);
  TuiScrollViewStateActive := Std.Array.Concat(TuiScrollViewStateActive, [true]);
  var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiScrollViewStateRelease(ApplicationId, Slot, Generation)
  end;
  RegisterViewCleanup(View, Cleanup);
  return Std.Array.Length(TuiScrollViewStateActive) - 1
end;

function TuiScrollViewStateRead(View: TuiView): TuiPoint;
begin
  var Index: integer := TuiScrollViewStateEnsure(View);
  return TuiScrollViewStateOffsets[Index]
end;

function TuiScrollViewStateWrite(View: TuiView; Offset: TuiPoint): boolean;
begin
  var Index: integer := TuiScrollViewStateEnsure(View);
  var Existing: TuiPoint := TuiScrollViewStateOffsets[Index];
  if (Existing.X = Offset.X) and (Existing.Y = Offset.Y) then
  begin
    return false
  end;
  TuiScrollViewStateOffsets[Index] := Offset;
  return true
end;
