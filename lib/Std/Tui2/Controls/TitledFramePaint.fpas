unit Std.Tui2.Controls.TitledFramePaint;

uses
  Std.Console, Std.Tui2.Cells.Cell, Std.Tui2.Cells.StyleRole, Std.Tui2.Drawing.Canvas,
  Std.Tui2.Drawing.PaintContext, Std.Tui2.Geometry.Point;

procedure TuiTitleFramePaint(Canvas: TuiCanvas; Context: TuiPaintContext; Title: string);
begin
  mutable var BorderRole: TuiStyleRole := TuiStyleRole.Frame;
  mutable var TitleRole: TuiStyleRole := TuiStyleRole.Title;
  if not Context.Enabled then
  begin
    BorderRole := TuiStyleRole.Disabled;
    TitleRole := TuiStyleRole.Disabled
  end;
  Canvas.DrawFrame(Context.Bounds, BorderRole);
  mutable var X: integer := 2;
  for Glyph: string in Std.Console.SplitGraphemes(Title) do
  begin
    var Cell: TuiCell := TuiCell.Create(Glyph, TitleRole);
    if (X + Cell.Width()) >= (Context.Bounds.Width - 1) then
    begin
      return
    end;
    Canvas.PutCell(TuiPoint.Create(X, 0), Cell);
    X := X + Cell.Width()
  end
end;
