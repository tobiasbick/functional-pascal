unit Std.Tui2.Controls.Window;

uses
  Std.Array, Std.Tui2.Controls.WindowPaint, Std.Tui2.Drawing.Canvas, Std.Tui2.Drawing.PaintContext,
  Std.Tui2.Geometry.Rect, Std.Tui2.Layouts.Layout, Std.Tui2.Runtime.Application,
  Std.Tui2.Runtime.ApplicationPaint, Std.Tui2.Views.Container, Std.Tui2.Views.ContentContainer,
  Std.Tui2.Views.CustomView, Std.Tui2.Views.View, Std.Tui2.Views.ViewContent;

private mutable var WindowApps: array of integer := [];
private mutable var WindowGens: array of integer := [];
private mutable var WindowAlive: array of boolean := [];
private mutable var WindowTitles: array of string := [];
private mutable var WindowContents: array of TuiContentContainer := [];

private procedure TuiWindowRequire(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(WindowGens)) then
  begin
    panic('Tui2 window handle has an invalid registry slot')
  end;
  if not WindowAlive[Slot - 1] then
  begin
    panic('Tui2 window handle is stale')
  end;
  if WindowGens[Slot - 1] <> Generation then
  begin
    panic('Tui2 window handle generation does not match the registry')
  end;
  if WindowApps[Slot - 1] <> ApplicationId then
  begin
    panic('Tui2 window belongs to a different application')
  end;
  var Content: TuiContentContainer := WindowContents[Slot - 1];
  if not Content.IsAlive() then
  begin
    panic('Tui2 window owns a stale view')
  end
end;

private procedure TuiWindowRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot > 0) and (Slot <= Std.Array.Length(WindowGens)) then
  begin
    if ((WindowApps[Slot - 1] = ApplicationId) and (WindowGens[Slot - 1] = Generation)) and
       WindowAlive[Slot - 1] then
    begin
      WindowAlive[Slot - 1] := false;
      WindowGens[Slot - 1] := Generation + 1
    end
  end
end;

type
  TuiWindow = record
    ApplicationId: integer;
    Slot: integer;
    Generation: integer;

    static function Create(App: TuiApplication; Title: string): TuiWindow;
    begin
      if not App.IsOpen() then
      begin
        panic('Tui2 cannot create a window for a closed application')
      end;
      var Content: TuiContentContainer := TuiContentContainer.Create(App, 1, 1, 1, 1);
      WindowApps := Std.Array.Concat(WindowApps, [App.Id]);
      WindowGens := Std.Array.Concat(WindowGens, [1]);
      WindowAlive := Std.Array.Concat(WindowAlive, [true]);
      WindowTitles := Std.Array.Concat(WindowTitles, [Title]);
      WindowContents := Std.Array.Concat(WindowContents, [Content]);
      var Window: TuiWindow := record
        ApplicationId := App.Id;
        Slot := Std.Array.Length(WindowGens);
        Generation := 1;
      end;
      var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
        TuiWindowRelease(ApplicationId, Window.Slot, Window.Generation)
      end;
      RegisterViewCleanup(TuiContentContainer.AsView(Content), Cleanup);
      var Custom: TuiCustomView := TuiContentContainer.AsCustom(Content);
      Custom.OnPaint := procedure(Sender: TuiCustomView; Canvas: TuiCanvas; Context: TuiPaintContext) begin
        TuiWindowRequire(Window.ApplicationId, Window.Slot, Window.Generation);
        TuiWindowPaint(Canvas, Context, WindowTitles[Window.Slot - 1])
      end;
      return Window
    end;

    static function AsView(Window: TuiWindow): TuiView;
    begin
      TuiWindowRequire(Window.ApplicationId, Window.Slot, Window.Generation);
      var View: TuiView := TuiContentContainer.AsView(WindowContents[Window.Slot - 1]);
      return record
        ApplicationId := View.ApplicationId;
        Slot := View.Slot;
        Generation := View.Generation;
        Kind := TuiViewKind.Window;
      end
    end;

    static function AsContainer(Window: TuiWindow): TuiContainer;
    begin
      TuiWindowRequire(Window.ApplicationId, Window.Slot, Window.Generation);
      return TuiContentContainer.AsContainer(WindowContents[Window.Slot - 1])
    end;

    function IsAlive(Self: TuiWindow): boolean;
    begin
      if (Self.Slot <= 0) or (Self.Slot > Std.Array.Length(WindowGens)) then
      begin
        return false
      end;
      var Content: TuiContentContainer := WindowContents[Self.Slot - 1];
      var IsCurrent: boolean := (WindowAlive[Self.Slot - 1] and (WindowGens[Self.Slot - 1] = Self.Generation)) and
                                (WindowApps[Self.Slot - 1] = Self.ApplicationId);
      return IsCurrent and Content.IsAlive()
    end;

    function ReadTitle(Self: TuiWindow): string;
    begin
      TuiWindowRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return WindowTitles[Self.Slot - 1]
    end;

    procedure WriteTitle(Self: TuiWindow; Value: string);
    begin
      TuiWindowRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      if WindowTitles[Self.Slot - 1] <> Value then
      begin
        WindowTitles[Self.Slot - 1] := Value;
        TuiApplicationPaintInvalidate(Self.ApplicationId, 1)
      end
    end;

    function ReadLayout(Self: TuiWindow): option of TuiLayout;
    begin
      return TuiWindow.AsContainer(Self).Layout
    end;

    procedure WriteLayout(Self: TuiWindow; Value: option of TuiLayout);
    begin
      var Container: TuiContainer := TuiWindow.AsContainer(Self);
      Container.Layout := Value
    end;

    function ReadContentBounds(Self: TuiWindow): TuiRect;
    begin
      return TuiViewContentBounds(TuiWindow.AsView(Self))
    end;

    procedure Add(Self: TuiWindow; Child: TuiView);
    begin
      TuiWindow.AsContainer(Self).Add(Child)
    end;

    function NeedsLayout(Self: TuiWindow): boolean;
    begin
      return TuiWindow.AsContainer(Self).NeedsLayout()
    end;

    function PerformLayout(Self: TuiWindow): boolean;
    begin
      return TuiWindow.AsContainer(Self).PerformLayout()
    end;

    procedure Destroy(Self: TuiWindow);
    begin
      TuiWindow.AsView(Self).Destroy()
    end;

    property Title: string read ReadTitle write WriteTitle;
    property Layout: option of TuiLayout read ReadLayout write WriteLayout;
    property ContentBounds: TuiRect read ReadContentBounds;
  end;
