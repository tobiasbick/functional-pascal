unit Std.Tui2.Drawing.Canvas;

uses
  Std.Console, Std.Str, Std.Tui2.Cells.Cell, Std.Tui2.Cells.StyleRole, Std.Tui2.Geometry.Point,
  Std.Tui2.Geometry.Rect, Std.Tui2.Surface.Surface;

type
  TuiCanvas = record
    Surface: TuiSurface;
    Clip: TuiRect;
    Origin: TuiPoint;

    static function Create(Surface: TuiSurface; Bounds: TuiRect): TuiCanvas;
    begin
      return record
        Surface := Surface;
        Clip := Bounds.Intersect(Surface.Bounds());
        Origin := TuiPoint.Create(0, 0);
      end
    end;

    static function CreateLocal(Surface: TuiSurface; Origin: TuiPoint; Clip: TuiRect): TuiCanvas;
    begin
      return record Surface := Surface; Clip := Clip; Origin := Origin; end
    end;

    procedure PutCell(Self: TuiCanvas; Position: TuiPoint; Cell: TuiCell);
    begin
      if not Self.Clip.Contains(Position) then
      begin
        return
      end;
      var CellWidth: integer := Cell.Width();
      if (CellWidth = 2) and not Self.Clip.Contains(TuiPoint.Create(Position.X + 1, Position.Y)) then
      begin
        Self.Surface.PutCell(TuiPoint.Create(Self.Origin.X + Position.X, Self.Origin.Y + Position.Y), TuiCell.Create(' ', TuiStyleRole.Normal));
        return
      end;
      Self.Surface.PutCell(TuiPoint.Create(Self.Origin.X + Position.X, Self.Origin.Y + Position.Y), Cell)
    end;

    procedure FillRect(Self: TuiCanvas; Bounds: TuiRect; Cell: TuiCell);
    begin
      var CellWidth: integer := Cell.Width();
      if CellWidth <> 1 then
      begin
        panic('Tui2 canvas FillRect requires a one-column cell')
      end;
      var Visible: TuiRect := Bounds.Intersect(Self.Clip);
      for Y: integer := Visible.Y to Visible.Bottom() - 1 do
      begin
        for X: integer := Visible.X to Visible.Right() - 1 do
        begin
          Self.Surface.PutCell(TuiPoint.Create(Self.Origin.X + X, Self.Origin.Y + Y), Cell)
        end
      end
    end;

    procedure WriteText(Self: TuiCanvas; Position: TuiPoint; Text: string; Role: TuiStyleRole);
    begin
      mutable var X: integer := Position.X;
      for Glyph: string in Std.Console.SplitGraphemes(Text) do
      begin
        if Glyph = Std.Str.Chr(10) then
        begin
          return
        end;
        var Cell: TuiCell := TuiCell.Create(Glyph, Role);
        Self.PutCell(TuiPoint.Create(X, Position.Y), Cell);
        X := X + Cell.Width()
      end
    end;

    procedure DrawHorizontalLine(
  Self: TuiCanvas;
  X: integer;
  Y: integer;
  Width: integer;
  Role: TuiStyleRole
);
    begin
      var Bounds: TuiRect := TuiRect.Create(X, Y, Width, 1);
      for Offset: integer := 0 to Bounds.Width - 1 do
      begin
        Self.PutCell(TuiPoint.Create(Bounds.X + Offset, Bounds.Y), TuiCell.Create('─', Role))
      end
    end;

    procedure DrawVerticalLine(
  Self: TuiCanvas;
  X: integer;
  Y: integer;
  Height: integer;
  Role: TuiStyleRole
);
    begin
      var Bounds: TuiRect := TuiRect.Create(X, Y, 1, Height);
      for Offset: integer := 0 to Bounds.Height - 1 do
      begin
        Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Y + Offset), TuiCell.Create('│', Role))
      end
    end;

    procedure DrawFrame(Self: TuiCanvas; Bounds: TuiRect; Role: TuiStyleRole);
    begin
      if Bounds.IsEmpty() then
      begin
        return
      end;
      if Bounds.Width = 1 then
      begin
        Self.DrawVerticalLine(Bounds.X, Bounds.Y, Bounds.Height, Role);
        Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Y), TuiCell.Create('┌', Role));
        if Bounds.Height > 1 then
        begin
          Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Bottom() - 1), TuiCell.Create('└', Role))
        end;
        return
      end;
      if Bounds.Height = 1 then
      begin
        Self.DrawHorizontalLine(Bounds.X, Bounds.Y, Bounds.Width, Role);
        Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Y), TuiCell.Create('┌', Role));
        Self.PutCell(TuiPoint.Create(Bounds.Right() - 1, Bounds.Y), TuiCell.Create('┐', Role));
        return
      end;
      Self.DrawHorizontalLine(Bounds.X, Bounds.Y, Bounds.Width, Role);
      Self.DrawHorizontalLine(Bounds.X, Bounds.Bottom() - 1, Bounds.Width, Role);
      Self.DrawVerticalLine(Bounds.X, Bounds.Y + 1, Bounds.Height - 2, Role);
      Self.DrawVerticalLine(Bounds.Right() - 1, Bounds.Y + 1, Bounds.Height - 2, Role);
      Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Y), TuiCell.Create('┌', Role));
      Self.PutCell(TuiPoint.Create(Bounds.Right() - 1, Bounds.Y), TuiCell.Create('┐', Role));
      Self.PutCell(TuiPoint.Create(Bounds.X, Bounds.Bottom() - 1), TuiCell.Create('└', Role));
      Self.PutCell(TuiPoint.Create(Bounds.Right() - 1, Bounds.Bottom() - 1), TuiCell.Create('┘', Role))
    end;
  end;
