unit Std.Tui2.Drawing.PaintContext;

uses Std.Tui2.Cells.Palette, Std.Tui2.Geometry.Rect;

type
  TuiPaintContext = record
    Bounds: TuiRect;
    Clip: TuiRect;
    Enabled: boolean;
    Focused: boolean;
    Palette: TuiPalette;

    static function Create(
  Bounds: TuiRect;
  Clip: TuiRect;
  Enabled: boolean;
  Focused: boolean;
  Palette: TuiPalette
): TuiPaintContext;
    begin
      return record
        Bounds := Bounds;
        Clip := Clip;
        Enabled := Enabled;
        Focused := Focused;
        Palette := Palette;
      end
    end;
  end;
