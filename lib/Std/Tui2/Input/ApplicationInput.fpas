unit Std.Tui2.Input.ApplicationInput;

uses
  Std.Array, Std.Console, Std.Tui2.Input.PointerEvent, Std.Tui2.Runtime.ApplicationInputPhase,
  Std.Tui2.Runtime.ApplicationInputQueue, Std.Tui2.Runtime.ApplicationRegistry;

type
  TuiApplicationKeyInputHandler = function(Key: Std.Console.KeyEvent): boolean;
  TuiApplicationPointerInputHandler = function(Pointer: TuiPointerEvent): boolean;

private mutable var TuiApplicationInputOnKey: array of option of TuiApplicationKeyInputHandler := [];
private mutable var TuiApplicationInputOnPointer: array of option of TuiApplicationPointerInputHandler := [];

function TuiApplicationInputDispatchKey(
  ApplicationId: integer;
  Generation: integer;
  Key: Std.Console.KeyEvent
): boolean;
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  case TuiApplicationInputOnKey[ApplicationId - 1] of
    None:
    begin
      return false
    end;
    Some(Handler):
    begin
      return Handler(Key)
    end
  end
end;

function TuiApplicationInputDispatchPointer(
  ApplicationId: integer;
  Generation: integer;
  Pointer: TuiPointerEvent
): boolean;
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  case TuiApplicationInputOnPointer[ApplicationId - 1] of
    None:
    begin
      return false
    end;
    Some(Handler):
    begin
      return Handler(Pointer)
    end
  end
end;

private function TuiApplicationInputDefaultRoute(ApplicationId: integer; Generation: integer): boolean;
begin
  case TuiApplicationInputQueuePop(ApplicationId, Generation) of
    None:
    begin
      return false
    end;
    Some(Input):
    begin
      case Input.Kind of
        TuiQueuedInputKind.Key:
        begin
          TuiApplicationInputDispatchKey(ApplicationId, Generation, Input.Key)
        end;
        TuiQueuedInputKind.Pointer:
        begin
          TuiApplicationInputDispatchPointer(ApplicationId, Generation, Input.Pointer)
        end
      end;
      return true
    end
  end
end;

procedure TuiApplicationInputInitialize(ApplicationId: integer; Generation: integer);
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  TuiApplicationInputOnKey := Std.Array.Concat(TuiApplicationInputOnKey, [None]);
  TuiApplicationInputOnPointer := Std.Array.Concat(TuiApplicationInputOnPointer, [None]);
  var Route: TuiApplicationInputRouteCallback := function(ApplicationId: integer; Generation: integer): boolean begin
    return TuiApplicationInputDefaultRoute(ApplicationId, Generation)
  end;
  RegisterApplicationInputRoute(ApplicationId, Generation, Route)
end;

procedure TuiApplicationInputRelease(ApplicationId: integer; Generation: integer);
begin
  TuiApplicationInputOnKey[ApplicationId - 1] := None;
  TuiApplicationInputOnPointer[ApplicationId - 1] := None;
  TuiApplicationInputQueueRelease(ApplicationId, Generation)
end;

type
  TuiApplicationInput = record
    ApplicationId: integer;
    Generation: integer;

    function InjectKeyForTest(Self: TuiApplicationInput; Key: Std.Console.KeyEvent): boolean;
    begin
      return TuiApplicationInputQueuePushKey(Self.ApplicationId, Self.Generation, Key)
    end;

    function InjectPointerForTest(Self: TuiApplicationInput; Pointer: TuiPointerEvent): boolean;
    begin
      return TuiApplicationInputQueuePushPointer(Self.ApplicationId, Self.Generation, Pointer)
    end;

    function ReadOnKey(Self: TuiApplicationInput): option of TuiApplicationKeyInputHandler;
    begin
      TuiApplicationRegistryRequire(Self.ApplicationId, Self.Generation);
      return TuiApplicationInputOnKey[Self.ApplicationId - 1]
    end;

    procedure WriteOnKey(Self: TuiApplicationInput; Handler: option of TuiApplicationKeyInputHandler);
    begin
      TuiApplicationRegistryRequire(Self.ApplicationId, Self.Generation);
      TuiApplicationInputOnKey[Self.ApplicationId - 1] := Handler
    end;

    function ReadOnPointer(Self: TuiApplicationInput): option of TuiApplicationPointerInputHandler;
    begin
      TuiApplicationRegistryRequire(Self.ApplicationId, Self.Generation);
      return TuiApplicationInputOnPointer[Self.ApplicationId - 1]
    end;

    procedure WriteOnPointer(
  Self: TuiApplicationInput;
  Handler: option of TuiApplicationPointerInputHandler
);
    begin
      TuiApplicationRegistryRequire(Self.ApplicationId, Self.Generation);
      TuiApplicationInputOnPointer[Self.ApplicationId - 1] := Handler
    end;

    event OnKey: TuiApplicationKeyInputHandler read ReadOnKey write WriteOnKey;
    event OnPointer: TuiApplicationPointerInputHandler read ReadOnPointer write WriteOnPointer;
  end;
