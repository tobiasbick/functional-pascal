unit Std.Tui2.Input.ViewInput;

uses
  Std.Array, Std.Console, Std.Tui2.Geometry.Rect, Std.Tui2.Input.PointerEvent,
  Std.Tui2.Runtime.PointerCapture, Std.Tui2.Views.CustomViewIdentity, Std.Tui2.Views.View,
  Std.Tui2.Views.ViewLifecycleHooks, Std.Tui2.Views.ViewTreeState;

type
  TuiViewKeyInputHandler = function(Sender: TuiView; Key: Std.Console.KeyEvent): boolean;
  TuiViewPointerInputHandler = function(Sender: TuiView; Pointer: TuiPointerEvent): boolean;

private mutable var TuiViewInputApplicationIds: array of integer := [];
private mutable var TuiViewInputSlots: array of integer := [];
private mutable var TuiViewInputGenerations: array of integer := [];
private mutable var TuiViewInputOnKey: array of option of TuiViewKeyInputHandler := [];
private mutable var TuiViewInputOnPointer: array of option of TuiViewPointerInputHandler := [];
private mutable var TuiViewInputActive: array of boolean := [];

private function TuiViewInputFind(View: TuiView): integer;
begin
  for I: integer := 0 to Std.Array.Length(TuiViewInputActive) - 1 do
  begin
    if (((TuiViewInputActive[I] and (TuiViewInputApplicationIds[I] = View.ApplicationId)) and (TuiViewInputSlots[I] = View.Slot)) and (TuiViewInputGenerations[I] = View.Generation)) then
    begin
      return I
    end
  end;
  return -1
end;

private procedure TuiViewInputAttach(ApplicationId: integer; Slot: integer; Generation: integer);
begin
end;

private procedure TuiViewInputBeforeRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var View: TuiView := record
    ApplicationId := ApplicationId;
    Slot := Slot;
    Generation := Generation;
    Kind := TuiViewKind.Custom;
  end;
  if View.IsAlive() then
  begin
    TuiPointerCaptureReleaseView(View)
  end
end;

private procedure TuiViewInputBoundsChanged(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
);
begin
end;

private procedure TuiViewInputReleased(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var View: TuiView := record
    ApplicationId := ApplicationId;
    Slot := Slot;
    Generation := Generation;
    Kind := TuiViewKind.Custom;
  end;
  var Index: integer := TuiViewInputFind(View);
  if Index >= 0 then
  begin
    TuiViewInputOnKey[Index] := None;
    TuiViewInputOnPointer[Index] := None;
    TuiViewInputActive[Index] := false
  end
end;

function TuiViewInputEnsure(View: TuiView): integer;
begin
  if not TuiCustomViewIdentityMatches(View) then
  begin
    panic('Tui2 input target must be a live custom view')
  end;
  var Existing: integer := TuiViewInputFind(View);
  if Existing >= 0 then
  begin
    return Existing
  end;
  TuiViewInputApplicationIds := Std.Array.Concat(TuiViewInputApplicationIds, [View.ApplicationId]);
  TuiViewInputSlots := Std.Array.Concat(TuiViewInputSlots, [View.Slot]);
  TuiViewInputGenerations := Std.Array.Concat(TuiViewInputGenerations, [View.Generation]);
  TuiViewInputOnKey := Std.Array.Concat(TuiViewInputOnKey, [None]);
  TuiViewInputOnPointer := Std.Array.Concat(TuiViewInputOnPointer, [None]);
  TuiViewInputActive := Std.Array.Concat(TuiViewInputActive, [true]);
  var AttachHook: TuiViewAttachHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiViewInputAttach(ApplicationId, Slot, Generation)
  end;
  var BeforeReleaseHook: TuiViewBeforeReleaseHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiViewInputBeforeRelease(ApplicationId, Slot, Generation)
  end;
  var BoundsChangedHook: TuiViewBoundsChangedHook := procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
) begin
    TuiViewInputBoundsChanged(ApplicationId, Slot, Generation, OldBounds, NewBounds)
  end;
  var ReleasedHook: TuiViewReleasedHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiViewInputReleased(ApplicationId, Slot, Generation)
  end;
  RegisterViewLifecycleHooks(View.ApplicationId, View.Slot, View.Generation, AttachHook, BeforeReleaseHook, BoundsChangedHook, ReleasedHook);
  return Std.Array.Length(TuiViewInputActive) - 1
end;

function TuiViewInputDispatchKey(View: TuiView; Key: Std.Console.KeyEvent): boolean;
begin
  var Index: integer := TuiViewInputEnsure(View);
  case TuiViewInputOnKey[Index] of
    None:
    begin
      return false
    end;
    Some(Handler):
    begin
      return Handler(View, Key)
    end
  end
end;

function TuiViewInputDispatchPointer(View: TuiView; Pointer: TuiPointerEvent): boolean;
begin
  var Index: integer := TuiViewInputEnsure(View);
  case TuiViewInputOnPointer[Index] of
    None:
    begin
      return false
    end;
    Some(Handler):
    begin
      return Handler(View, Pointer)
    end
  end
end;

type
  TuiViewInput = record
    View: TuiView;

    static function ForView(View: TuiView): TuiViewInput;
    begin
      TuiViewInputEnsure(View);
      return record View := View; end
    end;

    function ReadOnKey(Self: TuiViewInput): option of TuiViewKeyInputHandler;
    begin
      var Index: integer := TuiViewInputEnsure(Self.View);
      return TuiViewInputOnKey[Index]
    end;

    procedure WriteOnKey(Self: TuiViewInput; Handler: option of TuiViewKeyInputHandler);
    begin
      var Index: integer := TuiViewInputEnsure(Self.View);
      TuiViewInputOnKey[Index] := Handler
    end;

    function ReadOnPointer(Self: TuiViewInput): option of TuiViewPointerInputHandler;
    begin
      var Index: integer := TuiViewInputEnsure(Self.View);
      return TuiViewInputOnPointer[Index]
    end;

    procedure WriteOnPointer(Self: TuiViewInput; Handler: option of TuiViewPointerInputHandler);
    begin
      var Index: integer := TuiViewInputEnsure(Self.View);
      TuiViewInputOnPointer[Index] := Handler
    end;

    function CapturePointer(Self: TuiViewInput): boolean;
    begin
      TuiViewInputEnsure(Self.View);
      if not TuiViewTreeIsInteractive(Self.View) then
      begin
        return false
      end;
      TuiPointerCaptureSet(Self.View);
      return true
    end;

    function ReleasePointer(Self: TuiViewInput): boolean;
    begin
      TuiViewInputEnsure(Self.View);
      return TuiPointerCaptureReleaseView(Self.View)
    end;

    function ReadPointerCaptured(Self: TuiViewInput): boolean;
    begin
      TuiViewInputEnsure(Self.View);
      return TuiPointerCaptureMatches(Self.View)
    end;

    property PointerCaptured: boolean read ReadPointerCaptured;

    event OnKey: TuiViewKeyInputHandler read ReadOnKey write WriteOnKey;
    event OnPointer: TuiViewPointerInputHandler read ReadOnPointer write WriteOnPointer;
  end;
