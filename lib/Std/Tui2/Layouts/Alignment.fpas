unit Std.Tui2.Layouts.Alignment;

type
  TuiAlignmentKind = enum
    Leading;
    Center;
    Trailing;
    Fill;
  end;
  TuiAlignment = record
    Horizontal: TuiAlignmentKind;
    Vertical: TuiAlignmentKind;

    static function Create(Horizontal: TuiAlignmentKind; Vertical: TuiAlignmentKind): TuiAlignment;
    begin
      return record Horizontal := Horizontal; Vertical := Vertical; end
    end;

    static function Leading(): TuiAlignment;
    begin
      return TuiAlignment.Create(TuiAlignmentKind.Leading, TuiAlignmentKind.Leading)
    end;

    static function Center(): TuiAlignment;
    begin
      return TuiAlignment.Create(TuiAlignmentKind.Center, TuiAlignmentKind.Center)
    end;

    static function Trailing(): TuiAlignment;
    begin
      return TuiAlignment.Create(TuiAlignmentKind.Trailing, TuiAlignmentKind.Trailing)
    end;

    static function Fill(): TuiAlignment;
    begin
      return TuiAlignment.Create(TuiAlignmentKind.Fill, TuiAlignmentKind.Fill)
    end;
  end;
