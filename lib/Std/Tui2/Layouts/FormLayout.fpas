unit Std.Tui2.Layouts.FormLayout;

uses Std.Tui2.Layouts.Layout, Std.Tui2.Layouts.LayoutKind, Std.Tui2.Runtime.Application;

type
  TuiFormLayout = record
    Layout: TuiLayout;

    static function Create(App: TuiApplication): TuiFormLayout;
    begin
      return record Layout := TuiLayout.CreateKind(App, TuiLayoutKind.Form); end
    end;

    function AsLayout(Self: TuiFormLayout): TuiLayout;
    begin
      return Self.Layout
    end;

    function IsAlive(Self: TuiFormLayout): boolean;
    begin
      return Self.Layout.IsAlive()
    end;

    procedure Destroy(Self: TuiFormLayout);
    begin
      Self.Layout.Destroy()
    end;
  end;
