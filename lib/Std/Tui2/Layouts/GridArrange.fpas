unit Std.Tui2.Layouts.GridArrange;

uses
  Std.Array, Std.Tui2.Geometry.Rect, Std.Tui2.Geometry.Size, Std.Tui2.Layouts.Direction,
  Std.Tui2.Layouts.GridItems, Std.Tui2.Layouts.GridLayout, Std.Tui2.Layouts.GridPlacement,
  Std.Tui2.Layouts.GridTracks, Std.Tui2.Layouts.Layout, Std.Tui2.Layouts.LayoutContent,
  Std.Tui2.Layouts.LayoutItem, Std.Tui2.Layouts.LayoutItemBounds, Std.Tui2.Layouts.LayoutMeasure,
  Std.Tui2.Layouts.LayoutSettings, Std.Tui2.Layouts.Margins, Std.Tui2.Layouts.MeasureResult,
  Std.Tui2.Layouts.MeasureSpec;

type
  TuiGridArrangeCallback = function(Layout: TuiLayout; Bounds: TuiRect): boolean;

private function TuiGridArrangeVisible(Item: TuiLayoutItem): boolean;
begin
  if Item.Kind = TuiLayoutItemKind.View then
  begin
    return Item.View.Visible
  end;
  return true
end;

private function TuiGridArrangeSpacingTotal(Count: integer; Spacing: integer): integer;
begin
  mutable var Total: integer := 0;
  if Count > 1 then
  begin
    for I: integer := 1 to Count - 1 do
    begin
      Total := Total + Spacing
    end
  end;
  return Total
end;

private function TuiGridArrangeAllocate(
  Minimums: array of integer;
  Preferreds: array of integer;
  Maximums: array of integer;
  Weights: array of integer;
  Available: integer;
  Spacing: integer
): array of integer;
begin
  mutable var Extents: array of integer := Minimums;
  mutable var MinimumTotal: integer := 0;
  for I: integer := 0 to Std.Array.Length(Extents) - 1 do
  begin
    MinimumTotal := MinimumTotal + Extents[I]
  end;
  mutable var AvailableForTracks: integer := Available -
                                             TuiGridArrangeSpacingTotal(Std.Array.Length(Extents), Spacing);
  if AvailableForTracks < 0 then
  begin
    AvailableForTracks := 0
  end;
  if AvailableForTracks < MinimumTotal then
  begin
    return Extents
  end;
  mutable var Remaining: integer := AvailableForTracks - MinimumTotal;
  mutable var Progress: boolean := true;
  while (Remaining > 0) and Progress do
  begin
    Progress := false;
    for I: integer := 0 to Std.Array.Length(Extents) - 1 do
    begin
      if (Remaining > 0) and (Extents[I] < Preferreds[I]) then
      begin
        Extents[I] := Extents[I] + 1;
        Remaining := Remaining - 1;
        Progress := true
      end
    end
  end;
  Progress := true;
  while (Remaining > 0) and Progress do
  begin
    Progress := false;
    for I: integer := 0 to Std.Array.Length(Extents) - 1 do
    begin
      if Weights[I] > 0 then
      begin
        for Share: integer := 1 to Weights[I] do
        begin
          if (Remaining > 0) and (Extents[I] < Maximums[I]) then
          begin
            Extents[I] := Extents[I] + 1;
            Remaining := Remaining - 1;
            Progress := true
          end
        end
      end
    end
  end;
  return Extents
end;

private function TuiGridArrangeTrackOffset(Extents: array of integer; Index: integer; Spacing: integer): integer;
begin
  mutable var Offset: integer := 0;
  for I: integer := 0 to Index - 1 do
  begin
    Offset := (Offset + Extents[I]) + Spacing
  end;
  return Offset
end;

private function TuiGridArrangeTrackExtent(
  Extents: array of integer;
  Start: integer;
  Span: integer;
  Spacing: integer
): integer;
begin
  mutable var Extent: integer := 0;
  for I: integer := Start to (Start + Span) - 1 do
  begin
    Extent := Extent + Extents[I]
  end;
  if Span > 1 then
  begin
    Extent := Extent + TuiGridArrangeSpacingTotal(Span, Spacing)
  end;
  return Extent
end;

type
  TuiGridArrange = record
    static function Arrange(Grid: TuiGridLayout; Bounds: TuiRect; ArrangeNested: TuiGridArrangeCallback): boolean;
    begin
      var Margins: TuiMargins := TuiLayoutSettings.Margins(Grid.AsLayout());
      var Content: TuiRect := TuiLayoutContent.Inset(Bounds, Margins);
      var Spec: TuiMeasureSpec := TuiMeasureSpec.AtMost(TuiSize.Create(Content.Width, Content.Height));
      var MeasureItem: TuiGridMeasureCallback := function(Item: TuiLayoutItem; ChildSpec: TuiMeasureSpec): TuiMeasureResult begin
        return TuiLayoutMeasure.MeasureItem(Item, TuiLayoutDirection.Horizontal, ChildSpec)
      end;
      var Tracks: TuiGridTrackSet := TuiGridTracks.Resolve(Grid, Spec, MeasureItem);
      var Spacing: integer := TuiLayoutSettings.Spacing(Grid.AsLayout());
      var Widths: array of integer := TuiGridArrangeAllocate(Tracks.MinimumWidths, Tracks.PreferredWidths, Tracks.MaximumWidths, Tracks.ColumnWeights, Content.Width, Spacing);
      var Heights: array of integer := TuiGridArrangeAllocate(Tracks.MinimumHeights, Tracks.PreferredHeights, Tracks.MaximumHeights, Tracks.RowWeights, Content.Height, Spacing);
      for I: integer := 0 to TuiGridItems.Count(Grid) - 1 do
      begin
        var Item: TuiLayoutItem := TuiGridItems.Get(Grid, I);
        if TuiGridArrangeVisible(Item) then
        begin
          var Placement: TuiGridPlacement := TuiGridItems.PlacementAt(Grid, I);
          var CellX: integer := Content.X +
                                TuiGridArrangeTrackOffset(Widths, Placement.Column, Spacing);
          var CellY: integer := Content.Y +
                                TuiGridArrangeTrackOffset(Heights, Placement.Row, Spacing);
          var CellWidth: integer := TuiGridArrangeTrackExtent(Widths, Placement.Column, Placement.ColumnSpan, Spacing);
          var CellHeight: integer := TuiGridArrangeTrackExtent(Heights, Placement.Row, Placement.RowSpan, Spacing);
          var Measured: TuiMeasureResult := MeasureItem(Item, Spec);
          var Cell: TuiRect := TuiRect.Create(CellX, CellY, CellWidth, CellHeight);
          var ItemBounds: TuiRect := TuiLayoutItemBounds.Align(Measured, Item.Alignment, Cell);
          case Item.Kind of
            TuiLayoutItemKind.View:
            begin
              Item.View.Bounds := ItemBounds
            end;
            TuiLayoutItemKind.Layout:
            begin
              ArrangeNested(Item.Layout, ItemBounds)
            end;
            TuiLayoutItemKind.Spacer:
            begin
            end
          end
        end
      end;
      return true
    end;
  end;
