unit Std.Tui2.Layouts.GridItems;

uses
  Std.Array, Std.Tui2.Layouts.GridLayout, Std.Tui2.Layouts.GridPlacement, Std.Tui2.Layouts.Layout,
  Std.Tui2.Layouts.LayoutItem, Std.Tui2.Layouts.LayoutItems, Std.Tui2.Layouts.LayoutKind,
  Std.Tui2.Views.View;

private mutable var TuiGridItemOwnerApplicationIds: array of integer := [];
private mutable var TuiGridItemOwnerSlots: array of integer := [];
private mutable var TuiGridItemOwnerGenerations: array of integer := [];
private mutable var TuiGridItemValues: array of TuiLayoutItem := [];
private mutable var TuiGridItemPlacements: array of TuiGridPlacement := [];
private mutable var TuiGridItemsActive: array of boolean := [];
private mutable var TuiGridCleanupApplicationIds: array of integer := [];
private mutable var TuiGridCleanupSlots: array of integer := [];
private mutable var TuiGridCleanupGenerations: array of integer := [];

private function TuiGridItemsOwnerMatches(Index: integer; Layout: TuiLayout): boolean;
begin
  return (((TuiGridItemsActive[Index] and (TuiGridItemOwnerApplicationIds[Index] = Layout.ApplicationId)) and (TuiGridItemOwnerSlots[Index] = Layout.Slot)) and (TuiGridItemOwnerGenerations[Index] = Layout.Generation))
end;

private function TuiGridItemsFind(Layout: TuiLayout; ItemIndex: integer): integer;
begin
  if ItemIndex < 0 then
  begin
    return -1
  end;
  mutable var Current: integer := 0;
  for I: integer := 0 to Std.Array.Length(TuiGridItemsActive) - 1 do
  begin
    if TuiGridItemsOwnerMatches(I, Layout) then
    begin
      if Current = ItemIndex then
      begin
        return I
      end;
      Current := Current + 1
    end
  end;
  return -1
end;

private procedure TuiGridItemsReleaseOwned(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var Layout: TuiLayout := record
    ApplicationId := ApplicationId;
    Slot := Slot;
    Generation := Generation;
  end;
  for I: integer := 0 to Std.Array.Length(TuiGridItemsActive) - 1 do
  begin
    if TuiGridItemsOwnerMatches(I, Layout) then
    begin
      TuiGridItemsActive[I] := false
    end
  end
end;

private procedure TuiGridItemsDetachView(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiGridItemsActive) - 1 do
  begin
    var Item: TuiLayoutItem := TuiGridItemValues[I];
    if (((TuiGridItemsActive[I] and (Item.Kind = TuiLayoutItemKind.View)) and (Item.View.ApplicationId = ApplicationId)) and (Item.View.Slot = Slot)) and
       (Item.View.Generation = Generation) then
    begin
      TuiGridItemsActive[I] := false
    end
  end
end;

private procedure TuiGridItemsDetachLayout(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiGridItemsActive) - 1 do
  begin
    var Item: TuiLayoutItem := TuiGridItemValues[I];
    if (((TuiGridItemsActive[I] and (Item.Kind = TuiLayoutItemKind.Layout)) and (Item.Layout.ApplicationId = ApplicationId)) and (Item.Layout.Slot = Slot)) and
       (Item.Layout.Generation = Generation) then
    begin
      TuiGridItemsActive[I] := false
    end
  end
end;

private procedure TuiGridItemsEnsureCleanup(Layout: TuiLayout);
begin
  for I: integer := 0 to Std.Array.Length(TuiGridCleanupApplicationIds) - 1 do
  begin
    if ((TuiGridCleanupApplicationIds[I] = Layout.ApplicationId) and (TuiGridCleanupSlots[I] = Layout.Slot)) and
       (TuiGridCleanupGenerations[I] = Layout.Generation) then
    begin
      return
    end
  end;
  TuiGridCleanupApplicationIds := Std.Array.Concat(TuiGridCleanupApplicationIds, [
                                                                                   Layout.ApplicationId

                                                                                 ]);
  TuiGridCleanupSlots := Std.Array.Concat(TuiGridCleanupSlots, [Layout.Slot]);
  TuiGridCleanupGenerations := Std.Array.Concat(TuiGridCleanupGenerations, [Layout.Generation]);
  var Cleanup: TuiLayoutCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiGridItemsReleaseOwned(ApplicationId, Slot, Generation)
  end;
  RegisterLayoutCleanup(Layout, Cleanup)
end;

private function TuiGridItemsCountActive(Layout: TuiLayout): integer;
begin
  mutable var Count: integer := 0;
  for I: integer := 0 to Std.Array.Length(TuiGridItemsActive) - 1 do
  begin
    if TuiGridItemsOwnerMatches(I, Layout) then
    begin
      Count := Count + 1
    end
  end;
  return Count
end;

private procedure TuiGridItemsRequire(Grid: TuiGridLayout);
begin
  if not Grid.IsAlive() then
  begin
    panic('Tui2 cannot access a stale grid layout')
  end;
  if Grid.Layout.Kind <> TuiLayoutKind.Grid then
  begin
    panic('Tui2 grid handle no longer identifies a grid layout')
  end
end;

private procedure TuiGridItemsRequireSynchronized(Layout: TuiLayout);
begin
  if TuiGridItemsCountActive(Layout) <> TuiLayoutItems.Count(Layout) then
  begin
    panic('Tui2 grid items must be modified through TuiGridItems')
  end
end;

type
  TuiGridItems = record
    static function CanAdd(Grid: TuiGridLayout; Item: TuiLayoutItem; Placement: TuiGridPlacement): boolean;
    begin
      TuiGridItemsRequire(Grid);
      TuiGridItemsRequireSynchronized(Grid.AsLayout());
      if Item.Kind = TuiLayoutItemKind.Spacer then
      begin
        return false
      end;
      if not TuiLayoutItems.CanAdd(Grid.AsLayout(), Item) then
      begin
        return false
      end;
      for I: integer := 0 to Std.Array.Length(TuiGridItemsActive) - 1 do
      begin
        if TuiGridItemsOwnerMatches(I, Grid.AsLayout()) and
           Placement.Overlaps(TuiGridItemPlacements[I]) then
        begin
          return false
        end
      end;
      return true
    end;

    static function Add(Grid: TuiGridLayout; Item: TuiLayoutItem; Placement: TuiGridPlacement): boolean;
    begin
      if not TuiGridItems.CanAdd(Grid, Item, Placement) then
      begin
        panic('Tui2 grid cannot attach the item; check placement, ownership, and item kind')
      end;
      TuiLayoutItems.Add(Grid.AsLayout(), Item);
      TuiGridItemOwnerApplicationIds := Std.Array.Concat(TuiGridItemOwnerApplicationIds, [
                                                                                           Grid.Layout.ApplicationId

                                                                                         ]);
      TuiGridItemOwnerSlots := Std.Array.Concat(TuiGridItemOwnerSlots, [Grid.Layout.Slot]);
      TuiGridItemOwnerGenerations := Std.Array.Concat(TuiGridItemOwnerGenerations, [
                                                                                     Grid.Layout.Generation

                                                                                   ]);
      TuiGridItemValues := Std.Array.Concat(TuiGridItemValues, [Item]);
      TuiGridItemPlacements := Std.Array.Concat(TuiGridItemPlacements, [Placement]);
      TuiGridItemsActive := Std.Array.Concat(TuiGridItemsActive, [true]);
      TuiGridItemsEnsureCleanup(Grid.AsLayout());
      case Item.Kind of
        TuiLayoutItemKind.View:
        begin
          var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
            TuiGridItemsDetachView(ApplicationId, Slot, Generation)
          end;
          RegisterViewCleanup(Item.View, Cleanup)
        end;
        TuiLayoutItemKind.Layout:
        begin
          var Cleanup: TuiLayoutCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
            TuiGridItemsDetachLayout(ApplicationId, Slot, Generation)
          end;
          RegisterLayoutCleanup(Item.Layout, Cleanup)
        end;
        TuiLayoutItemKind.Spacer:
        begin
        end
      end;
      return true
    end;

    static function Count(Grid: TuiGridLayout): integer;
    begin
      TuiGridItemsRequire(Grid);
      TuiGridItemsRequireSynchronized(Grid.AsLayout());
      return TuiGridItemsCountActive(Grid.AsLayout())
    end;

    static function Get(Grid: TuiGridLayout; Index: integer): TuiLayoutItem;
    begin
      TuiGridItemsRequire(Grid);
      TuiGridItemsRequireSynchronized(Grid.AsLayout());
      return TuiLayoutItems.Get(Grid.AsLayout(), Index)
    end;

    static function PlacementAt(Grid: TuiGridLayout; Index: integer): TuiGridPlacement;
    begin
      TuiGridItemsRequire(Grid);
      TuiGridItemsRequireSynchronized(Grid.AsLayout());
      var StorageIndex: integer := TuiGridItemsFind(Grid.AsLayout(), Index);
      if StorageIndex < 0 then
      begin
        panic('Tui2 grid item index is out of bounds')
      end;
      return TuiGridItemPlacements[StorageIndex]
    end;

    static function RemoveAt(Grid: TuiGridLayout; Index: integer): boolean;
    begin
      TuiGridItemsRequire(Grid);
      TuiGridItemsRequireSynchronized(Grid.AsLayout());
      var StorageIndex: integer := TuiGridItemsFind(Grid.AsLayout(), Index);
      if StorageIndex < 0 then
      begin
        panic('Tui2 grid item index is out of bounds')
      end;
      TuiGridItemsActive[StorageIndex] := false;
      TuiLayoutItems.RemoveAt(Grid.AsLayout(), Index);
      return true
    end;

    static function Clear(Grid: TuiGridLayout): boolean;
    begin
      TuiGridItemsRequire(Grid);
      TuiGridItemsRequireSynchronized(Grid.AsLayout());
      TuiGridItemsReleaseOwned(Grid.Layout.ApplicationId, Grid.Layout.Slot, Grid.Layout.Generation);
      TuiLayoutItems.Clear(Grid.AsLayout());
      return true
    end;
  end;
