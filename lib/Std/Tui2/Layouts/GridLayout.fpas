unit Std.Tui2.Layouts.GridLayout;

uses Std.Tui2.Layouts.Layout, Std.Tui2.Layouts.LayoutKind, Std.Tui2.Runtime.Application;

type
  TuiGridLayout = record
    Layout: TuiLayout;

    static function Create(App: TuiApplication): TuiGridLayout;
    begin
      var Layout: TuiLayout := TuiLayout.CreateKind(App, TuiLayoutKind.Grid);
      return record Layout := Layout; end
    end;

    function AsLayout(Self: TuiGridLayout): TuiLayout;
    begin
      return Self.Layout
    end;

    function IsAlive(Self: TuiGridLayout): boolean;
    begin
      return Self.Layout.IsAlive()
    end;

    procedure Destroy(Self: TuiGridLayout);
    begin
      Self.Layout.Destroy()
    end;
  end;
