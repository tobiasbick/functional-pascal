unit Std.Tui2.Layouts.GridMeasure;

uses
  Std.Array, Std.Tui2.Geometry.Size, Std.Tui2.Layouts.GridLayout, Std.Tui2.Layouts.GridTracks,
  Std.Tui2.Layouts.LayoutSettings, Std.Tui2.Layouts.Margins, Std.Tui2.Layouts.MeasureAxis,
  Std.Tui2.Layouts.MeasureResult, Std.Tui2.Layouts.MeasureSpec;

private function TuiGridMeasureSum(Values: array of integer; Spacing: integer): integer;
begin
  mutable var Total: integer := 0;
  for I: integer := 0 to Std.Array.Length(Values) - 1 do
  begin
    Total := TuiMeasureAxis.Add(Total, Values[I])
  end;
  if Std.Array.Length(Values) > 1 then
  begin
    for I: integer := 1 to Std.Array.Length(Values) - 1 do
    begin
      Total := TuiMeasureAxis.Add(Total, Spacing)
    end
  end;
  return Total
end;

private function TuiGridMeasureHasWeight(Values: array of integer): boolean;
begin
  for I: integer := 0 to Std.Array.Length(Values) - 1 do
  begin
    if Values[I] > 0 then
    begin
      return true
    end
  end;
  return false
end;

type
  TuiGridMeasure = record
    static function Measure(Grid: TuiGridLayout; Spec: TuiMeasureSpec; MeasureItem: TuiGridMeasureCallback): TuiMeasureResult;
    begin
      var Tracks: TuiGridTrackSet := TuiGridTracks.Resolve(Grid, Spec, MeasureItem);
      var Spacing: integer := TuiLayoutSettings.Spacing(Grid.AsLayout());
      var Margins: TuiMargins := TuiLayoutSettings.Margins(Grid.AsLayout());
      var MinimumWidth: integer := TuiMeasureAxis.Add(TuiGridMeasureSum(Tracks.MinimumWidths, Spacing), Margins.Horizontal());
      var PreferredWidth: integer := TuiMeasureAxis.Add(TuiGridMeasureSum(Tracks.PreferredWidths, Spacing), Margins.Horizontal());
      mutable var MaximumWidth: integer := TuiMeasureAxis.Add(TuiGridMeasureSum(Tracks.MaximumWidths, Spacing), Margins.Horizontal());
      var MinimumHeight: integer := TuiMeasureAxis.Add(TuiGridMeasureSum(Tracks.MinimumHeights, Spacing), Margins.Vertical());
      var PreferredHeight: integer := TuiMeasureAxis.Add(TuiGridMeasureSum(Tracks.PreferredHeights, Spacing), Margins.Vertical());
      mutable var MaximumHeight: integer := TuiMeasureAxis.Add(TuiGridMeasureSum(Tracks.MaximumHeights, Spacing), Margins.Vertical());
      if Spec.Width.IsBounded() and TuiGridMeasureHasWeight(Tracks.ColumnWeights) then
      begin
        MaximumWidth := TuiMeasureAxis.Max(MaximumWidth, Spec.Width.Limit)
      end;
      if Spec.Height.IsBounded() and TuiGridMeasureHasWeight(Tracks.RowWeights) then
      begin
        MaximumHeight := TuiMeasureAxis.Max(MaximumHeight, Spec.Height.Limit)
      end;
      var Width: TuiMeasureAxisResult := TuiMeasureAxis.Apply(MinimumWidth, PreferredWidth, MaximumWidth, Spec.Width);
      var Height: TuiMeasureAxisResult := TuiMeasureAxis.Apply(MinimumHeight, PreferredHeight, MaximumHeight, Spec.Height);
      return TuiMeasureResult.Create(TuiSize.Create(MinimumWidth, MinimumHeight), TuiSize.Create(Width.Preferred, Height.Preferred), TuiSize.Create(Width.Maximum, Height.Maximum))
    end;
  end;
