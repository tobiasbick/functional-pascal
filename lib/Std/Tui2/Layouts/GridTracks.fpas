unit Std.Tui2.Layouts.GridTracks;

uses
  Std.Array, Std.Tui2.Layouts.GridItems, Std.Tui2.Layouts.GridLayout, Std.Tui2.Layouts.GridPlacement,
  Std.Tui2.Layouts.LayoutItem, Std.Tui2.Layouts.LayoutSettings, Std.Tui2.Layouts.MeasureResult,
  Std.Tui2.Layouts.MeasureSpec, Std.Tui2.Layouts.SizePolicy;

type
  TuiGridMeasureCallback = function(Item: TuiLayoutItem; Spec: TuiMeasureSpec): TuiMeasureResult;
  TuiGridTrackSet = record
    MinimumWidths: array of integer;
    PreferredWidths: array of integer;
    MaximumWidths: array of integer;
    ColumnWeights: array of integer;
    MinimumHeights: array of integer;
    PreferredHeights: array of integer;
    MaximumHeights: array of integer;
    RowWeights: array of integer;
  end;

private function TuiGridTracksMax(Left: integer; Right: integer): integer;
begin
  if Left > Right then
  begin
    return Left
  end;
  return Right
end;

private function TuiGridTracksVisible(Item: TuiLayoutItem): boolean;
begin
  if Item.Kind = TuiLayoutItemKind.View then
  begin
    return Item.View.Visible
  end;
  return true
end;

private function TuiGridTracksZeros(Count: integer): array of integer;
begin
  mutable var Values: array of integer := [];
  for I: integer := 1 to Count do
  begin
    Values := Std.Array.Concat(Values, [0])
  end;
  return Values
end;

private function TuiGridTracksGrowSpan(
  Values: array of integer;
  Start: integer;
  Span: integer;
  Spacing: integer;
  Required: integer
): array of integer;
begin
  mutable var Grown: array of integer := Values;
  mutable var Current: integer := 0;
  for I: integer := Start to (Start + Span) - 1 do
  begin
    Current := Current + Grown[I]
  end;
  if Span > 1 then
  begin
    for I: integer := 1 to Span - 1 do
    begin
      Current := Current + Spacing
    end
  end;
  mutable var Remaining: integer := Required - Current;
  while Remaining > 0 do
  begin
    for I: integer := Start to (Start + Span) - 1 do
    begin
      if Remaining > 0 then
      begin
        Grown[I] := Grown[I] + 1;
        Remaining := Remaining - 1
      end
    end
  end;
  return Grown
end;

private function TuiGridTracksWeight(Item: TuiLayoutItem; Horizontal: boolean): integer;
begin
  if Item.Stretch > 0 then
  begin
    return Item.Stretch
  end;
  if Item.Kind = TuiLayoutItemKind.View then
  begin
    if Horizontal and (Item.View.SizePolicy.Horizontal = TuiSizePolicyKind.Expanding) then
    begin
      return 1
    end;
    if (not Horizontal) and (Item.View.SizePolicy.Vertical = TuiSizePolicyKind.Expanding) then
    begin
      return 1
    end
  end;
  return 0
end;

type
  TuiGridTracks = record
    static function Resolve(Grid: TuiGridLayout; Spec: TuiMeasureSpec; MeasureItem: TuiGridMeasureCallback): TuiGridTrackSet;
    begin
      mutable var RowCount: integer := 0;
      mutable var ColumnCount: integer := 0;
      for I: integer := 0 to TuiGridItems.Count(Grid) - 1 do
      begin
        var Item: TuiLayoutItem := TuiGridItems.Get(Grid, I);
        if TuiGridTracksVisible(Item) then
        begin
          var Placement: TuiGridPlacement := TuiGridItems.PlacementAt(Grid, I);
          RowCount := TuiGridTracksMax(RowCount, Placement.RowEnd());
          ColumnCount := TuiGridTracksMax(ColumnCount, Placement.ColumnEnd())
        end
      end;
      mutable var MinimumWidths: array of integer := TuiGridTracksZeros(ColumnCount);
      mutable var PreferredWidths: array of integer := TuiGridTracksZeros(ColumnCount);
      mutable var MaximumWidths: array of integer := TuiGridTracksZeros(ColumnCount);
      mutable var ColumnWeights: array of integer := TuiGridTracksZeros(ColumnCount);
      mutable var MinimumHeights: array of integer := TuiGridTracksZeros(RowCount);
      mutable var PreferredHeights: array of integer := TuiGridTracksZeros(RowCount);
      mutable var MaximumHeights: array of integer := TuiGridTracksZeros(RowCount);
      mutable var RowWeights: array of integer := TuiGridTracksZeros(RowCount);
      var Spacing: integer := TuiLayoutSettings.Spacing(Grid.AsLayout());
      for I: integer := 0 to TuiGridItems.Count(Grid) - 1 do
      begin
        var Item: TuiLayoutItem := TuiGridItems.Get(Grid, I);
        if TuiGridTracksVisible(Item) then
        begin
          var Placement: TuiGridPlacement := TuiGridItems.PlacementAt(Grid, I);
          var Measured: TuiMeasureResult := MeasureItem(Item, Spec);
          MinimumWidths := TuiGridTracksGrowSpan(MinimumWidths, Placement.Column, Placement.ColumnSpan, Spacing, Measured.Minimum.Width);
          PreferredWidths := TuiGridTracksGrowSpan(PreferredWidths, Placement.Column, Placement.ColumnSpan, Spacing, Measured.Preferred.Width);
          MaximumWidths := TuiGridTracksGrowSpan(MaximumWidths, Placement.Column, Placement.ColumnSpan, Spacing, Measured.Maximum.Width);
          MinimumHeights := TuiGridTracksGrowSpan(MinimumHeights, Placement.Row, Placement.RowSpan, Spacing, Measured.Minimum.Height);
          PreferredHeights := TuiGridTracksGrowSpan(PreferredHeights, Placement.Row, Placement.RowSpan, Spacing, Measured.Preferred.Height);
          MaximumHeights := TuiGridTracksGrowSpan(MaximumHeights, Placement.Row, Placement.RowSpan, Spacing, Measured.Maximum.Height);
          var ColumnWeight: integer := TuiGridTracksWeight(Item, true);
          var RowWeight: integer := TuiGridTracksWeight(Item, false);
          for Column: integer := Placement.Column to Placement.ColumnEnd() - 1 do
          begin
            ColumnWeights[Column] := TuiGridTracksMax(ColumnWeights[Column], ColumnWeight)
          end;
          for RowIndex: integer := Placement.Row to Placement.RowEnd() - 1 do
          begin
            RowWeights[RowIndex] := TuiGridTracksMax(RowWeights[RowIndex], RowWeight)
          end
        end
      end;
      for I: integer := 0 to Std.Array.Length(MinimumWidths) - 1 do
      begin
        PreferredWidths[I] := TuiGridTracksMax(PreferredWidths[I], MinimumWidths[I]);
        MaximumWidths[I] := TuiGridTracksMax(MaximumWidths[I], PreferredWidths[I]);
        if (ColumnWeights[I] > 0) and Spec.Width.IsBounded() then
        begin
          MaximumWidths[I] := TuiGridTracksMax(MaximumWidths[I], Spec.Width.Limit)
        end
      end;
      for I: integer := 0 to Std.Array.Length(MinimumHeights) - 1 do
      begin
        PreferredHeights[I] := TuiGridTracksMax(PreferredHeights[I], MinimumHeights[I]);
        MaximumHeights[I] := TuiGridTracksMax(MaximumHeights[I], PreferredHeights[I]);
        if (RowWeights[I] > 0) and Spec.Height.IsBounded() then
        begin
          MaximumHeights[I] := TuiGridTracksMax(MaximumHeights[I], Spec.Height.Limit)
        end
      end;
      return record
        MinimumWidths := MinimumWidths;
        PreferredWidths := PreferredWidths;
        MaximumWidths := MaximumWidths;
        ColumnWeights := ColumnWeights;
        MinimumHeights := MinimumHeights;
        PreferredHeights := PreferredHeights;
        MaximumHeights := MaximumHeights;
        RowWeights := RowWeights;
      end
    end;
  end;
