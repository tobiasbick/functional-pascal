unit Std.Tui2.Layouts.Invalidation;

uses Std.Array, Std.Tui2.Layouts.Layout;

type
  TuiLayoutInvalidationCallback = procedure(ApplicationId: integer; Slot: integer; Generation: integer);

private mutable var TuiLayoutInvalidationApplicationIds: array of integer := [];
private mutable var TuiLayoutInvalidationSlots: array of integer := [];
private mutable var TuiLayoutInvalidationGenerations: array of integer := [];
private mutable var TuiLayoutInvalidationDirty: array of boolean := [];
private mutable var TuiLayoutInvalidationActive: array of boolean := [];
private mutable var TuiLayoutInvalidationCallbackApplicationIds: array of integer := [];
private mutable var TuiLayoutInvalidationCallbackSlots: array of integer := [];
private mutable var TuiLayoutInvalidationCallbackGenerations: array of integer := [];
private mutable var TuiLayoutInvalidationCallbacks: array of TuiLayoutInvalidationCallback := [];

private function TuiLayoutInvalidationMatches(Index: integer; Layout: TuiLayout): boolean;
begin
  return (((TuiLayoutInvalidationActive[Index] and (TuiLayoutInvalidationApplicationIds[Index] = Layout.ApplicationId)) and (TuiLayoutInvalidationSlots[Index] = Layout.Slot)) and (TuiLayoutInvalidationGenerations[Index] = Layout.Generation))
end;

private function TuiLayoutInvalidationFind(Layout: TuiLayout): integer;
begin
  for I: integer := 0 to Std.Array.Length(TuiLayoutInvalidationActive) - 1 do
  begin
    if TuiLayoutInvalidationMatches(I, Layout) then
    begin
      return I
    end
  end;
  return -1
end;

private procedure TuiLayoutInvalidationRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var Layout: TuiLayout := record
    ApplicationId := ApplicationId;
    Slot := Slot;
    Generation := Generation;
  end;
  var Index: integer := TuiLayoutInvalidationFind(Layout);
  if Index >= 0 then
  begin
    TuiLayoutInvalidationActive[Index] := false
  end
end;

private function TuiLayoutInvalidationEnsure(Layout: TuiLayout): integer;
begin
  if not Layout.IsAlive() then
  begin
    panic('Tui2 cannot access invalidation state for a stale layout')
  end;
  var Existing: integer := TuiLayoutInvalidationFind(Layout);
  if Existing >= 0 then
  begin
    return Existing
  end;
  TuiLayoutInvalidationApplicationIds := Std.Array.Concat(TuiLayoutInvalidationApplicationIds, [
                                                                                                 Layout.ApplicationId

                                                                                               ]);
  TuiLayoutInvalidationSlots := Std.Array.Concat(TuiLayoutInvalidationSlots, [Layout.Slot]);
  TuiLayoutInvalidationGenerations := Std.Array.Concat(TuiLayoutInvalidationGenerations, [
                                                                                           Layout.Generation

                                                                                         ]);
  TuiLayoutInvalidationDirty := Std.Array.Concat(TuiLayoutInvalidationDirty, [true]);
  TuiLayoutInvalidationActive := Std.Array.Concat(TuiLayoutInvalidationActive, [true]);
  var Cleanup: TuiLayoutCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiLayoutInvalidationRelease(ApplicationId, Slot, Generation)
  end;
  RegisterLayoutCleanup(Layout, Cleanup);
  return Std.Array.Length(TuiLayoutInvalidationActive) - 1
end;

private procedure TuiLayoutInvalidationNotify(Layout: TuiLayout);
begin
  for I: integer := 0 to Std.Array.Length(TuiLayoutInvalidationCallbacks) - 1 do
  begin
    if ((TuiLayoutInvalidationCallbackApplicationIds[I] = Layout.ApplicationId) and (TuiLayoutInvalidationCallbackSlots[I] = Layout.Slot)) and
       (TuiLayoutInvalidationCallbackGenerations[I] = Layout.Generation) then
    begin
      var Callback: TuiLayoutInvalidationCallback := TuiLayoutInvalidationCallbacks[I];
      Callback(Layout.ApplicationId, Layout.Slot, Layout.Generation)
    end
  end
end;

type
  TuiLayoutInvalidation = record
    static function IsDirty(Layout: TuiLayout): boolean;
    begin
      return TuiLayoutInvalidationDirty[TuiLayoutInvalidationEnsure(Layout)]
    end;

    static procedure Invalidate(Layout: TuiLayout);
    begin
      var Index: integer := TuiLayoutInvalidationEnsure(Layout);
      if not TuiLayoutInvalidationDirty[Index] then
      begin
        TuiLayoutInvalidationDirty[Index] := true;
        TuiLayoutInvalidationNotify(Layout)
      end
    end;

    static procedure MarkClean(Layout: TuiLayout);
    begin
      TuiLayoutInvalidationDirty[TuiLayoutInvalidationEnsure(Layout)] := false
    end;

    static procedure Register(Layout: TuiLayout; Callback: TuiLayoutInvalidationCallback);
    begin
      TuiLayoutInvalidationEnsure(Layout);
      TuiLayoutInvalidationCallbackApplicationIds := Std.Array.Concat(TuiLayoutInvalidationCallbackApplicationIds, [
                                                                                                                     Layout.ApplicationId

                                                                                                                   ]);
      TuiLayoutInvalidationCallbackSlots := Std.Array.Concat(TuiLayoutInvalidationCallbackSlots, [
                                                                                                   Layout.Slot

                                                                                                 ]);
      TuiLayoutInvalidationCallbackGenerations := Std.Array.Concat(TuiLayoutInvalidationCallbackGenerations, [
                                                                                                               Layout.Generation

                                                                                                             ]);
      TuiLayoutInvalidationCallbacks := Std.Array.Concat(TuiLayoutInvalidationCallbacks, [Callback])
    end;
  end;
