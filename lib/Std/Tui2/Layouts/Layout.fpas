unit Std.Tui2.Layouts.Layout;

uses Std.Array, Std.Tui2.Runtime.Application;

private mutable var TuiLayoutApplicationIds: array of integer := [];
private mutable var TuiLayoutGenerations: array of integer := [];
private mutable var TuiLayoutAlive: array of boolean := [];
private mutable var TuiLayoutTags: array of integer := [];

private procedure TuiLayoutRequire(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(TuiLayoutGenerations)) then
  begin
    panic('Tui2 layout handle has an invalid registry slot')
  end;
  if not TuiLayoutAlive[Slot - 1] then
  begin
    panic('Tui2 layout handle is stale')
  end;
  if TuiLayoutGenerations[Slot - 1] <> Generation then
  begin
    panic('Tui2 layout handle generation does not match the registry')
  end;
  if TuiLayoutApplicationIds[Slot - 1] <> ApplicationId then
  begin
    panic('Tui2 layout belongs to a different application')
  end;
  var App: TuiApplication := record Id := ApplicationId; Generation := 1; end;
  if not App.IsOpen() then
  begin
    panic('Tui2 layout belongs to a closed application')
  end
end;

private procedure TuiLayoutRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(TuiLayoutGenerations)) then
  begin
    return
  end;
  if ((TuiLayoutApplicationIds[Slot - 1] = ApplicationId) and (TuiLayoutGenerations[Slot - 1] = Generation)) and
     TuiLayoutAlive[Slot - 1] then
  begin
    TuiLayoutAlive[Slot - 1] := false;
    TuiLayoutGenerations[Slot - 1] := Generation + 1
  end
end;

type
  TuiLayoutCleanupCallback = procedure(ApplicationId: integer; Slot: integer; Generation: integer);

private mutable var TuiLayoutCleanupApplicationIds: array of integer := [];
private mutable var TuiLayoutCleanupSlots: array of integer := [];
private mutable var TuiLayoutCleanupGenerations: array of integer := [];
private mutable var TuiLayoutCleanupCallbacks: array of TuiLayoutCleanupCallback := [];

private procedure TuiLayoutRunCleanups(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiLayoutCleanupCallbacks) - 1 do
  begin
    if ((TuiLayoutCleanupApplicationIds[I] = ApplicationId) and (TuiLayoutCleanupSlots[I] = Slot)) and
       (TuiLayoutCleanupGenerations[I] = Generation) then
    begin
      var Callback: TuiLayoutCleanupCallback := TuiLayoutCleanupCallbacks[I];
      Callback(ApplicationId, Slot, Generation)
    end
  end
end;

type
  TuiLayout = record
    ApplicationId: integer;
    Slot: integer;
    Generation: integer;

    static function Create(App: TuiApplication): TuiLayout;
    begin
      if not App.IsOpen() then
      begin
        panic('Tui2 cannot create a layout for a closed application')
      end;
      mutable var Slot: integer := 0;
      for I: integer := 0 to Std.Array.Length(TuiLayoutAlive) - 1 do
      begin
        if not TuiLayoutAlive[I] then
        begin
          Slot := I + 1;
          TuiLayoutApplicationIds[I] := App.Id;
          TuiLayoutAlive[I] := true;
          TuiLayoutTags[I] := 0;
          break
        end
      end;
      if Slot = 0 then
      begin
        TuiLayoutApplicationIds := Std.Array.Concat(TuiLayoutApplicationIds, [App.Id]);
        TuiLayoutGenerations := Std.Array.Concat(TuiLayoutGenerations, [1]);
        TuiLayoutAlive := Std.Array.Concat(TuiLayoutAlive, [true]);
        TuiLayoutTags := Std.Array.Concat(TuiLayoutTags, [0]);
        Slot := Std.Array.Length(TuiLayoutGenerations)
      end;
      var Layout: TuiLayout := record
        ApplicationId := App.Id;
        Slot := Slot;
        Generation := TuiLayoutGenerations[Slot - 1];
      end;
      var Cleanup: TuiApplicationCleanupCallback := procedure(ApplicationId: integer) begin
        TuiLayoutRelease(ApplicationId, Layout.Slot, Layout.Generation)
      end;
      RegisterApplicationCleanup(App.Id, App.Generation, Cleanup);
      return Layout
    end;

    function IsAlive(Self: TuiLayout): boolean;
    begin
      if (Self.Slot <= 0) or (Self.Slot > Std.Array.Length(TuiLayoutGenerations)) then
      begin
        return false
      end;
      return ((TuiLayoutApplicationIds[Self.Slot - 1] = Self.ApplicationId) and (TuiLayoutGenerations[Self.Slot -
                                                                                                      1] = Self.Generation)) and
             TuiLayoutAlive[Self.Slot - 1]
    end;

    function ReadTag(Self: TuiLayout): integer;
    begin
      TuiLayoutRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return TuiLayoutTags[Self.Slot - 1]
    end;

    procedure WriteTag(Self: TuiLayout; Value: integer);
    begin
      TuiLayoutRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      TuiLayoutTags[Self.Slot - 1] := Value
    end;

    procedure Destroy(Self: TuiLayout);
    begin
      TuiLayoutRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      TuiLayoutRunCleanups(Self.ApplicationId, Self.Slot, Self.Generation);
      TuiLayoutRelease(Self.ApplicationId, Self.Slot, Self.Generation)
    end;

    property Tag: integer read ReadTag write WriteTag;
  end;

procedure RegisterLayoutCleanup(Layout: TuiLayout; Callback: TuiLayoutCleanupCallback);
begin
  TuiLayoutRequire(Layout.ApplicationId, Layout.Slot, Layout.Generation);
  TuiLayoutCleanupApplicationIds := Std.Array.Concat(TuiLayoutCleanupApplicationIds, [
                                                                                       Layout.ApplicationId

                                                                                     ]);
  TuiLayoutCleanupSlots := Std.Array.Concat(TuiLayoutCleanupSlots, [Layout.Slot]);
  TuiLayoutCleanupGenerations := Std.Array.Concat(TuiLayoutCleanupGenerations, [Layout.Generation]);
  TuiLayoutCleanupCallbacks := Std.Array.Concat(TuiLayoutCleanupCallbacks, [Callback])
end;
