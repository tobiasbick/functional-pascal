unit Std.Tui2.Layouts.LayoutItem;

uses
  Std.Tui2.Layouts.Alignment, Std.Tui2.Layouts.Layout, Std.Tui2.Layouts.Spacer, Std.Tui2.Views.View;

private procedure TuiLayoutItemRequireStretch(Stretch: integer);
begin
  if Stretch < 0 then
  begin
    panic('Tui2 layout item stretch must not be negative')
  end
end;

private function TuiLayoutItemEmptyView(): TuiView;
begin
  return record ApplicationId := 0; Slot := 0; Generation := 0; Kind := TuiViewKind.Empty; end
end;

private function TuiLayoutItemEmptyLayout(): TuiLayout;
begin
  return record ApplicationId := 0; Slot := 0; Generation := 0; end
end;

type
  TuiLayoutItemKind = enum
    View;
    Layout;
    Spacer;
  end;
  TuiLayoutItem = record
    Kind: TuiLayoutItemKind;
    View: TuiView;
    Layout: TuiLayout;
    Spacer: TuiSpacer;
    Alignment: TuiAlignment;
    Stretch: integer;

    static function ForView(View: TuiView; Alignment: TuiAlignment; Stretch: integer): TuiLayoutItem;
    begin
      if (View.Kind = TuiViewKind.Empty) or not View.IsAlive() then
      begin
        panic('Tui2 layout item requires a live registry view')
      end;
      TuiLayoutItemRequireStretch(Stretch);
      return record
        Kind := TuiLayoutItemKind.View;
        View := View;
        Layout := TuiLayoutItemEmptyLayout();
        Spacer := TuiSpacer.Fixed(0);
        Alignment := Alignment;
        Stretch := Stretch;
      end
    end;

    static function ForLayout(Layout: TuiLayout; Alignment: TuiAlignment; Stretch: integer): TuiLayoutItem;
    begin
      if not Layout.IsAlive() then
      begin
        panic('Tui2 layout item requires a live layout')
      end;
      TuiLayoutItemRequireStretch(Stretch);
      return record
        Kind := TuiLayoutItemKind.Layout;
        View := TuiLayoutItemEmptyView();
        Layout := Layout;
        Spacer := TuiSpacer.Fixed(0);
        Alignment := Alignment;
        Stretch := Stretch;
      end
    end;

    static function ForSpacer(Spacer: TuiSpacer; Alignment: TuiAlignment; Stretch: integer): TuiLayoutItem;
    begin
      TuiLayoutItemRequireStretch(Stretch);
      return record
        Kind := TuiLayoutItemKind.Spacer;
        View := TuiLayoutItemEmptyView();
        Layout := TuiLayoutItemEmptyLayout();
        Spacer := Spacer;
        Alignment := Alignment;
        Stretch := Stretch;
      end
    end;
  end;
