unit Std.Tui2.Layouts.LayoutItemBounds;

uses Std.Tui2.Geometry.Rect, Std.Tui2.Layouts.Alignment, Std.Tui2.Layouts.MeasureResult;

private function TuiLayoutItemBoundsMin(Left: integer; Right: integer): integer;
begin
  if Left < Right then
  begin
    return Left
  end;
  return Right
end;

private function TuiLayoutItemBoundsMax(Left: integer; Right: integer): integer;
begin
  if Left > Right then
  begin
    return Left
  end;
  return Right
end;

private function TuiLayoutItemBoundsExtent(
  Minimum: integer;
  Preferred: integer;
  Maximum: integer;
  Available: integer;
  Alignment: TuiAlignmentKind
): integer;
begin
  mutable var Extent: integer := Preferred;
  if Alignment = TuiAlignmentKind.Fill then
  begin
    Extent := TuiLayoutItemBoundsMin(Available, Maximum)
  end;
  Extent := TuiLayoutItemBoundsMax(Minimum, Extent);
  if Available >= Minimum then
  begin
    Extent := TuiLayoutItemBoundsMin(Extent, Available)
  end;
  return Extent
end;

private function TuiLayoutItemBoundsOffset(Available: integer; Extent: integer; Alignment: TuiAlignmentKind): integer;
begin
  case Alignment of
    TuiAlignmentKind.Leading:
    begin
      return 0
    end;
    TuiAlignmentKind.Center:
    begin
      return (Available - Extent) div 2
    end;
    TuiAlignmentKind.Trailing:
    begin
      return Available - Extent
    end;
    TuiAlignmentKind.Fill:
    begin
      return 0
    end
  end;
  return 0
end;

type
  TuiLayoutItemBounds = record
    static function Align(Measured: TuiMeasureResult; Alignment: TuiAlignment; Area: TuiRect): TuiRect;
    begin
      var Width: integer := TuiLayoutItemBoundsExtent(Measured.Minimum.Width, Measured.Preferred.Width, Measured.Maximum.Width, Area.Width, Alignment.Horizontal);
      var Height: integer := TuiLayoutItemBoundsExtent(Measured.Minimum.Height, Measured.Preferred.Height, Measured.Maximum.Height, Area.Height, Alignment.Vertical);
      var X: integer := Area.X + TuiLayoutItemBoundsOffset(Area.Width, Width, Alignment.Horizontal);
      var Y: integer := Area.Y + TuiLayoutItemBoundsOffset(Area.Height, Height, Alignment.Vertical);
      return TuiRect.Create(X, Y, Width, Height)
    end;
  end;
