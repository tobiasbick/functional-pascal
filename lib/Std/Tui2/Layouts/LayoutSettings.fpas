unit Std.Tui2.Layouts.LayoutSettings;

uses Std.Array, Std.Tui2.Layouts.Invalidation, Std.Tui2.Layouts.Layout, Std.Tui2.Layouts.Margins;

private mutable var TuiLayoutSettingsApplicationIds: array of integer := [];
private mutable var TuiLayoutSettingsSlots: array of integer := [];
private mutable var TuiLayoutSettingsGenerations: array of integer := [];
private mutable var TuiLayoutSettingsMargins: array of TuiMargins := [];
private mutable var TuiLayoutSettingsSpacing: array of integer := [];
private mutable var TuiLayoutSettingsActive: array of boolean := [];

private function TuiLayoutSettingsFind(Layout: TuiLayout): integer;
begin
  for I: integer := 0 to Std.Array.Length(TuiLayoutSettingsActive) - 1 do
  begin
    if (((TuiLayoutSettingsActive[I] and (TuiLayoutSettingsApplicationIds[I] = Layout.ApplicationId)) and (TuiLayoutSettingsSlots[I] = Layout.Slot)) and (TuiLayoutSettingsGenerations[I] = Layout.Generation)) then
    begin
      return I
    end
  end;
  return -1
end;

private procedure TuiLayoutSettingsRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiLayoutSettingsActive) - 1 do
  begin
    if (((TuiLayoutSettingsActive[I] and (TuiLayoutSettingsApplicationIds[I] = ApplicationId)) and (TuiLayoutSettingsSlots[I] = Slot)) and (TuiLayoutSettingsGenerations[I] = Generation)) then
    begin
      TuiLayoutSettingsActive[I] := false
    end
  end
end;

private function TuiLayoutSettingsEnsure(Layout: TuiLayout): integer;
begin
  if not Layout.IsAlive() then
  begin
    panic('Tui2 cannot access settings for a stale layout')
  end;
  var Existing: integer := TuiLayoutSettingsFind(Layout);
  if Existing >= 0 then
  begin
    return Existing
  end;
  TuiLayoutSettingsApplicationIds := Std.Array.Concat(TuiLayoutSettingsApplicationIds, [
                                                                                         Layout.ApplicationId

                                                                                       ]);
  TuiLayoutSettingsSlots := Std.Array.Concat(TuiLayoutSettingsSlots, [Layout.Slot]);
  TuiLayoutSettingsGenerations := Std.Array.Concat(TuiLayoutSettingsGenerations, [Layout.Generation]);
  TuiLayoutSettingsMargins := Std.Array.Concat(TuiLayoutSettingsMargins, [TuiMargins.Uniform(0)]);
  TuiLayoutSettingsSpacing := Std.Array.Concat(TuiLayoutSettingsSpacing, [0]);
  TuiLayoutSettingsActive := Std.Array.Concat(TuiLayoutSettingsActive, [true]);
  var Cleanup: TuiLayoutCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiLayoutSettingsRelease(ApplicationId, Slot, Generation)
  end;
  RegisterLayoutCleanup(Layout, Cleanup);
  return Std.Array.Length(TuiLayoutSettingsActive) - 1
end;

type
  TuiLayoutSettings = record
    static function Margins(Layout: TuiLayout): TuiMargins;
    begin
      var Index: integer := TuiLayoutSettingsEnsure(Layout);
      return TuiLayoutSettingsMargins[Index]
    end;

    static function SetMargins(Layout: TuiLayout; Margins: TuiMargins): boolean;
    begin
      var Index: integer := TuiLayoutSettingsEnsure(Layout);
      var Existing: TuiMargins := TuiLayoutSettingsMargins[Index];
      if (((Existing.Left <> Margins.Left) or (Existing.Top <> Margins.Top)) or (Existing.Right <> Margins.Right)) or
         (Existing.Bottom <> Margins.Bottom) then
      begin
        TuiLayoutSettingsMargins[Index] := Margins;
        TuiLayoutInvalidation.Invalidate(Layout)
      end;
      return true
    end;

    static function Spacing(Layout: TuiLayout): integer;
    begin
      var Index: integer := TuiLayoutSettingsEnsure(Layout);
      return TuiLayoutSettingsSpacing[Index]
    end;

    static function SetSpacing(Layout: TuiLayout; Spacing: integer): boolean;
    begin
      if Spacing < 0 then
      begin
        panic('Tui2 layout spacing must not be negative')
      end;
      var Index: integer := TuiLayoutSettingsEnsure(Layout);
      if TuiLayoutSettingsSpacing[Index] <> Spacing then
      begin
        TuiLayoutSettingsSpacing[Index] := Spacing;
        TuiLayoutInvalidation.Invalidate(Layout)
      end;
      return true
    end;
  end;
