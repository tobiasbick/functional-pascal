unit Std.Tui2.Layouts.MeasureConstraint;

type
  TuiMeasureConstraintKind = enum
    Unbounded;
    AtMost;
  end;

private function TuiMeasureConstraintRequireNonNegative(Value: integer): integer;
begin
  if Value < 0 then
  begin
    panic('Tui2 measure constraint limit must not be negative')
  end;
  return Value
end;

type
  TuiMeasureConstraint = record
    Kind: TuiMeasureConstraintKind;
    Limit: integer;

    static function Unbounded(): TuiMeasureConstraint;
    begin
      return record Kind := TuiMeasureConstraintKind.Unbounded; Limit := 0; end
    end;

    static function AtMost(Limit: integer): TuiMeasureConstraint;
    begin
      return record
        Kind := TuiMeasureConstraintKind.AtMost;
        Limit := TuiMeasureConstraintRequireNonNegative(Limit);
      end
    end;

    function IsBounded(Self: TuiMeasureConstraint): boolean;
    begin
      return Self.Kind = TuiMeasureConstraintKind.AtMost
    end;
  end;
