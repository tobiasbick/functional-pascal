unit Std.Tui2.Layouts.StackedArrange;

uses
  Std.Tui2.Geometry.Rect, Std.Tui2.Layouts.Layout, Std.Tui2.Layouts.LayoutContent,
  Std.Tui2.Layouts.LayoutItem, Std.Tui2.Layouts.LayoutItemBounds, Std.Tui2.Layouts.LayoutSettings,
  Std.Tui2.Layouts.Margins, Std.Tui2.Layouts.MeasureResult, Std.Tui2.Layouts.StackedItems,
  Std.Tui2.Layouts.StackedLayout;

type
  TuiStackedArrangeCallback = function(Layout: TuiLayout; Bounds: TuiRect): boolean;
  TuiStackedArrange = record
    static function Arrange(
  Stacked: TuiStackedLayout;
  Bounds: TuiRect;
  Measured: TuiMeasureResult;
  ArrangeNested: TuiStackedArrangeCallback
): boolean;
    begin
      var CurrentIndex: integer := Stacked.CurrentIndex;
      if CurrentIndex < 0 then
      begin
        return true
      end;
      var Item: TuiLayoutItem := TuiStackedItems.Get(Stacked, CurrentIndex);
      if Item.Kind = TuiLayoutItemKind.View then
      begin
        if not Item.View.Visible then
        begin
          return true
        end
      end;
      var Margins: TuiMargins := TuiLayoutSettings.Margins(Stacked.AsLayout());
      var Content: TuiRect := TuiLayoutContent.Inset(Bounds, Margins);
      var ItemBounds: TuiRect := TuiLayoutItemBounds.Align(Measured, Item.Alignment, Content);
      case Item.Kind of
        TuiLayoutItemKind.View:
        begin
          Item.View.Bounds := ItemBounds
        end;
        TuiLayoutItemKind.Layout:
        begin
          ArrangeNested(Item.Layout, ItemBounds)
        end;
        TuiLayoutItemKind.Spacer:
        begin
        end
      end;
      return true
    end;
  end;
