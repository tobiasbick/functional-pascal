unit Std.Tui2.Runtime.Application;

uses
  Std.Array, Std.Tui2.Geometry.Size, Std.Tui2.Runtime.ApplicationLayout,
  Std.Tui2.Runtime.ApplicationLoop, Std.Tui2.Runtime.ApplicationPosts,
  Std.Tui2.Runtime.ApplicationRegistry, Std.Tui2.Runtime.ApplicationResize;

type
  TuiApplicationCallback = procedure(ApplicationId: integer);
  TuiApplicationTickCallback = procedure(ApplicationId: integer; DeltaMilliseconds: integer);
  TuiApplicationCleanupCallback = procedure(ApplicationId: integer);

private mutable var TuiApplicationOnStart: array of option of TuiApplicationCallback := [];
private mutable var TuiApplicationOnStop: array of option of TuiApplicationCallback := [];
private mutable var TuiApplicationOnTick: array of option of TuiApplicationTickCallback := [];
private mutable var TuiCleanupApplicationIds: array of integer := [];
private mutable var TuiCleanupCallbacks: array of TuiApplicationCleanupCallback := [];

procedure RegisterApplicationCleanup(
  ApplicationId: integer;
  Generation: integer;
  Callback: TuiApplicationCleanupCallback
);
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  TuiCleanupApplicationIds := Std.Array.Concat(TuiCleanupApplicationIds, [ApplicationId]);
  TuiCleanupCallbacks := Std.Array.Concat(TuiCleanupCallbacks, [Callback])
end;

type
  TuiApplication = record
    Id: integer;
    Generation: integer;

    static function OpenForTest(Size: TuiSize): TuiApplication;
    begin
      var ApplicationId: integer := TuiApplicationRegistryOpen(Size);
      TuiApplicationLoopInitialize(ApplicationId);
      TuiApplicationOnStart := Std.Array.Concat(TuiApplicationOnStart, [None]);
      TuiApplicationOnStop := Std.Array.Concat(TuiApplicationOnStop, [None]);
      TuiApplicationOnTick := Std.Array.Concat(TuiApplicationOnTick, [None]);
      return record
        Id := ApplicationId;
        Generation := TuiApplicationRegistryGeneration(ApplicationId);
      end
    end;

    function IsOpen(Self: TuiApplication): boolean;
    begin
      return TuiApplicationRegistryIsOpen(Self.Id, Self.Generation)
    end;

    function ReadTag(Self: TuiApplication): integer;
    begin
      return TuiApplicationRegistryReadTag(Self.Id, Self.Generation)
    end;

    procedure WriteTag(Self: TuiApplication; Value: integer);
    begin
      TuiApplicationRegistryWriteTag(Self.Id, Self.Generation, Value)
    end;

    function ReadSize(Self: TuiApplication): TuiSize;
    begin
      return TuiApplicationRegistryReadSize(Self.Id, Self.Generation)
    end;

    procedure ResizeForTest(Self: TuiApplication; Size: TuiSize);
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      if TuiApplicationRegistryIsClosing(Self.Id) then
      begin
        panic('Tui2 application cannot resize while closing')
      end;
      if TuiApplicationRegistryWriteSize(Self.Id, Self.Generation, Size) then
      begin
        TuiApplicationResizeDispatch(Self.Id, Self.Generation, Size)
      end
    end;

    function ReadOnStart(Self: TuiApplication): option of procedure(Sender: TuiApplication);
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      case TuiApplicationOnStart[Self.Id - 1] of
        Some(Callback):
        begin
          return Some(procedure(Sender: TuiApplication) begin
            Callback(Sender.Id)
          end)
        end;
        None:
        begin
          return None
        end
      end
    end;

    procedure WriteOnStart(Self: TuiApplication; Handler: option of procedure(Sender: TuiApplication));
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      case Handler of
        Some(Value):
        begin
          var Callback: TuiApplicationCallback := procedure(ApplicationId: integer) begin
            var Sender: TuiApplication := record
              Id := ApplicationId;
              Generation := Self.Generation;
            end;
            Value(Sender)
          end;
          TuiApplicationOnStart[Self.Id - 1] := Some(Callback)
        end;
        None:
        begin
          TuiApplicationOnStart[Self.Id - 1] := None
        end
      end
    end;

    function ReadOnStop(Self: TuiApplication): option of procedure(Sender: TuiApplication);
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      case TuiApplicationOnStop[Self.Id - 1] of
        Some(Callback):
        begin
          return Some(procedure(Sender: TuiApplication) begin
            Callback(Sender.Id)
          end)
        end;
        None:
        begin
          return None
        end
      end
    end;

    procedure WriteOnStop(Self: TuiApplication; Handler: option of procedure(Sender: TuiApplication));
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      case Handler of
        Some(Value):
        begin
          var Callback: TuiApplicationCallback := procedure(ApplicationId: integer) begin
            var Sender: TuiApplication := record
              Id := ApplicationId;
              Generation := Self.Generation;
            end;
            Value(Sender)
          end;
          TuiApplicationOnStop[Self.Id - 1] := Some(Callback)
        end;
        None:
        begin
          TuiApplicationOnStop[Self.Id - 1] := None
        end
      end
    end;

    function ReadOnTick(Self: TuiApplication): option of procedure(Sender: TuiApplication; DeltaMilliseconds: integer);
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      case TuiApplicationOnTick[Self.Id - 1] of
        Some(Callback):
        begin
          return Some(procedure(Sender: TuiApplication; DeltaMilliseconds: integer) begin
            Callback(Sender.Id, DeltaMilliseconds)
          end)
        end;
        None:
        begin
          return None
        end
      end
    end;

    procedure WriteOnTick(
  Self: TuiApplication;
  Handler: option of procedure(Sender: TuiApplication; DeltaMilliseconds: integer)
);
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      case Handler of
        Some(Value):
        begin
          var Callback: TuiApplicationTickCallback := procedure(ApplicationId: integer; DeltaMilliseconds: integer) begin
            var Sender: TuiApplication := record
              Id := ApplicationId;
              Generation := Self.Generation;
            end;
            Value(Sender, DeltaMilliseconds)
          end;
          TuiApplicationOnTick[Self.Id - 1] := Some(Callback)
        end;
        None:
        begin
          TuiApplicationOnTick[Self.Id - 1] := None
        end
      end
    end;

    procedure Start(Self: TuiApplication);
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      TuiApplicationLoopMarkStarted(Self.Id);
      if Assigned(Self.OnStart) then
      begin
        Self.OnStart(Self)
      end
    end;

    function Post(Self: TuiApplication; Handler: procedure()): boolean;
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      if TuiApplicationRegistryIsClosing(Self.Id) then
      begin
        return false
      end;
      TuiApplicationPostsEnqueue(Self.Id, Self.Generation, Handler);
      return true
    end;

    procedure Tick(Self: TuiApplication; DeltaMilliseconds: integer);
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      if not TuiApplicationLoopIsStarted(Self.Id) then
      begin
        panic('Tui2 application must be started before ticking')
      end;
      if DeltaMilliseconds < 0 then
      begin
        panic('Tui2 tick delta must not be negative')
      end;
      TuiApplicationPostsDrain(Self.Id, Self.Generation);
      if (not Self.IsOpen()) or TuiApplicationLoopShouldQuit(Self.Id) then
      begin
        return
      end;
      TuiApplicationLayoutPerform(Self.Id, Self.Generation);
      if (not Self.IsOpen()) or TuiApplicationLoopShouldQuit(Self.Id) then
      begin
        return
      end;
      if Assigned(Self.OnTick) then
      begin
        Self.OnTick(Self, DeltaMilliseconds)
      end;
      if Self.IsOpen() and (not TuiApplicationLoopShouldQuit(Self.Id)) then
      begin
        TuiApplicationPostsDrain(Self.Id, Self.Generation)
      end
    end;

    procedure RunIterations(Self: TuiApplication; IterationCount: integer; DeltaMilliseconds: integer);
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      if TuiApplicationRegistryIsClosing(Self.Id) then
      begin
        panic('Tui2 application cannot run while closing')
      end;
      if IterationCount < 0 then
      begin
        panic('Tui2 iteration count must not be negative')
      end;
      if DeltaMilliseconds < 0 then
      begin
        panic('Tui2 tick delta must not be negative')
      end;
      TuiApplicationLoopBegin(Self.Id);
      if not TuiApplicationLoopIsStarted(Self.Id) then
      begin
        Self.Start()
      end;
      for I: integer := 0 to IterationCount - 1 do
      begin
        if (not Self.IsOpen()) or TuiApplicationLoopShouldQuit(Self.Id) then
        begin
          break
        end;
        Self.Tick(DeltaMilliseconds)
      end;
      var QuitRequested: boolean := TuiApplicationLoopShouldQuit(Self.Id);
      TuiApplicationLoopEnd(Self.Id);
      if QuitRequested and Self.IsOpen() then
      begin
        Self.Close()
      end
    end;

    procedure Quit(Self: TuiApplication);
    begin
      TuiApplicationRegistryRequire(Self.Id, Self.Generation);
      if TuiApplicationLoopIsRunning(Self.Id) then
      begin
        TuiApplicationLoopRequestQuit(Self.Id)
      end
      else
      begin
        Self.Close()
      end
    end;

    procedure Close(Self: TuiApplication);
    begin
      if not Self.IsOpen() then
      begin
        return
      end;
      if not TuiApplicationRegistryBeginClose(Self.Id, Self.Generation) then
      begin
        return
      end;
      if TuiApplicationLoopIsStarted(Self.Id) and Assigned(Self.OnStop) then
      begin
        Self.OnStop(Self)
      end;
      TuiApplicationPostsDiscard(Self.Id, Self.Generation);
      for I: integer := 0 to Std.Array.Length(TuiCleanupApplicationIds) - 1 do
      begin
        if TuiCleanupApplicationIds[I] = Self.Id then
        begin
          var Callback: TuiApplicationCleanupCallback := TuiCleanupCallbacks[I];
          Callback(Self.Id)
        end
      end;
      TuiApplicationLayoutRelease(Self.Id, Self.Generation);
      TuiApplicationResizeRelease(Self.Id, Self.Generation);
      TuiApplicationLoopRelease(Self.Id);
      TuiApplicationOnStart[Self.Id - 1] := None;
      TuiApplicationOnStop[Self.Id - 1] := None;
      TuiApplicationOnTick[Self.Id - 1] := None;
      TuiApplicationRegistryFinishClose(Self.Id, Self.Generation)
    end;

    property Tag: integer read ReadTag write WriteTag;
    property Size: TuiSize read ReadSize;

    event OnStart: procedure(Sender: TuiApplication) read ReadOnStart write WriteOnStart;
    event OnStop: procedure(Sender: TuiApplication) read ReadOnStop write WriteOnStop;
    event OnTick: procedure(Sender: TuiApplication; DeltaMilliseconds: integer) read ReadOnTick write WriteOnTick;
  end;
