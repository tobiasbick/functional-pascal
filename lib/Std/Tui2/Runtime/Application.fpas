unit Std.Tui2.Runtime.Application;

uses Std.Array, Std.Tui2.Geometry.Size;

type
  TuiApplicationCallback = procedure(ApplicationId: integer);
  TuiApplicationTickCallback = procedure(ApplicationId: integer; DeltaMilliseconds: integer);
  TuiApplicationCleanupCallback = procedure(ApplicationId: integer);
  TuiApplicationPostCallback = procedure();

private mutable var TuiApplicationGenerations: array of integer := [];
private mutable var TuiApplicationAlive: array of boolean := [];
private mutable var TuiApplicationStarted: array of boolean := [];
private mutable var TuiApplicationClosing: array of boolean := [];
private mutable var TuiApplicationTags: array of integer := [];
private mutable var TuiApplicationSizes: array of TuiSize := [];
private mutable var TuiApplicationOnStart: array of option of TuiApplicationCallback := [];
private mutable var TuiApplicationOnStop: array of option of TuiApplicationCallback := [];
private mutable var TuiApplicationOnTick: array of option of TuiApplicationTickCallback := [];
private mutable var TuiCleanupApplicationIds: array of integer := [];
private mutable var TuiCleanupCallbacks: array of TuiApplicationCleanupCallback := [];
private mutable var TuiPostApplicationIds: array of integer := [];
private mutable var TuiPostCallbacks: array of TuiApplicationPostCallback := [];
private mutable var TuiPostQueued: array of boolean := [];

private procedure TuiApplicationRequire(ApplicationId: integer; Generation: integer);
begin
  if (ApplicationId <= 0) or (ApplicationId > Std.Array.Length(TuiApplicationGenerations)) then
  begin
    panic('Tui2 application handle has an invalid registry slot')
  end;
  var Alive: boolean := TuiApplicationAlive[ApplicationId - 1];
  if not Alive then
  begin
    panic('Tui2 application handle is stale')
  end;
  if TuiApplicationGenerations[ApplicationId - 1] <> Generation then
  begin
    panic('Tui2 application handle generation does not match the registry')
  end
end;

procedure RegisterApplicationCleanup(
  ApplicationId: integer;
  Generation: integer;
  Callback: TuiApplicationCleanupCallback
);
begin
  TuiApplicationRequire(ApplicationId, Generation);
  TuiCleanupApplicationIds := Std.Array.Concat(TuiCleanupApplicationIds, [ApplicationId]);
  TuiCleanupCallbacks := Std.Array.Concat(TuiCleanupCallbacks, [Callback])
end;

private procedure TuiApplicationDrainPosts(ApplicationId: integer; Generation: integer);
begin
  var Last: integer := Std.Array.Length(TuiPostQueued);
  for I: integer := 0 to Last - 1 do
  begin
    if TuiPostQueued[I] and (TuiPostApplicationIds[I] = ApplicationId) then
    begin
      TuiPostQueued[I] := false;
      var Callback: TuiApplicationPostCallback := TuiPostCallbacks[I];
      Callback();
      if not TuiApplicationAlive[ApplicationId - 1] or
         (TuiApplicationGenerations[ApplicationId - 1] <> Generation) then
      begin
        return
      end
    end
  end
end;

private procedure TuiApplicationDiscardPosts(ApplicationId: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiPostQueued) - 1 do
  begin
    if TuiPostApplicationIds[I] = ApplicationId then
    begin
      TuiPostQueued[I] := false
    end
  end
end;

type
  TuiApplication = record
    Id: integer;
    Generation: integer;

    static function OpenForTest(Size: TuiSize): TuiApplication;
    begin
      TuiApplicationGenerations := Std.Array.Concat(TuiApplicationGenerations, [1]);
      TuiApplicationAlive := Std.Array.Concat(TuiApplicationAlive, [true]);
      TuiApplicationStarted := Std.Array.Concat(TuiApplicationStarted, [false]);
      TuiApplicationClosing := Std.Array.Concat(TuiApplicationClosing, [false]);
      TuiApplicationTags := Std.Array.Concat(TuiApplicationTags, [0]);
      TuiApplicationSizes := Std.Array.Concat(TuiApplicationSizes, [Size]);
      TuiApplicationOnStart := Std.Array.Concat(TuiApplicationOnStart, [None]);
      TuiApplicationOnStop := Std.Array.Concat(TuiApplicationOnStop, [None]);
      TuiApplicationOnTick := Std.Array.Concat(TuiApplicationOnTick, [None]);
      return record Id := Std.Array.Length(TuiApplicationGenerations); Generation := 1; end
    end;

    function IsOpen(Self: TuiApplication): boolean;
    begin
      if (Self.Id <= 0) or (Self.Id > Std.Array.Length(TuiApplicationGenerations)) then
      begin
        return false
      end;
      return TuiApplicationAlive[Self.Id - 1] and
             (TuiApplicationGenerations[Self.Id - 1] = Self.Generation)
    end;

    function ReadTag(Self: TuiApplication): integer;
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      return TuiApplicationTags[Self.Id - 1]
    end;

    procedure WriteTag(Self: TuiApplication; Value: integer);
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      TuiApplicationTags[Self.Id - 1] := Value
    end;

    function ReadOnStart(Self: TuiApplication): option of procedure(Sender: TuiApplication);
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      case TuiApplicationOnStart[Self.Id - 1] of
        Some(Callback):
        begin
          return Some(procedure(Sender: TuiApplication) begin
            Callback(Sender.Id)
          end)
        end;
        None:
        begin
          return None
        end
      end
    end;

    procedure WriteOnStart(Self: TuiApplication; Handler: option of procedure(Sender: TuiApplication));
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      case Handler of
        Some(Value):
        begin
          var Callback: TuiApplicationCallback := procedure(ApplicationId: integer) begin
            var Sender: TuiApplication := record
              Id := ApplicationId;
              Generation := Self.Generation;
            end;
            Value(Sender)
          end;
          TuiApplicationOnStart[Self.Id - 1] := Some(Callback)
        end;
        None:
        begin
          TuiApplicationOnStart[Self.Id - 1] := None
        end
      end
    end;

    function ReadOnStop(Self: TuiApplication): option of procedure(Sender: TuiApplication);
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      case TuiApplicationOnStop[Self.Id - 1] of
        Some(Callback):
        begin
          return Some(procedure(Sender: TuiApplication) begin
            Callback(Sender.Id)
          end)
        end;
        None:
        begin
          return None
        end
      end
    end;

    procedure WriteOnStop(Self: TuiApplication; Handler: option of procedure(Sender: TuiApplication));
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      case Handler of
        Some(Value):
        begin
          var Callback: TuiApplicationCallback := procedure(ApplicationId: integer) begin
            var Sender: TuiApplication := record
              Id := ApplicationId;
              Generation := Self.Generation;
            end;
            Value(Sender)
          end;
          TuiApplicationOnStop[Self.Id - 1] := Some(Callback)
        end;
        None:
        begin
          TuiApplicationOnStop[Self.Id - 1] := None
        end
      end
    end;

    function ReadOnTick(Self: TuiApplication): option of procedure(Sender: TuiApplication; DeltaMilliseconds: integer);
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      case TuiApplicationOnTick[Self.Id - 1] of
        Some(Callback):
        begin
          return Some(procedure(Sender: TuiApplication; DeltaMilliseconds: integer) begin
            Callback(Sender.Id, DeltaMilliseconds)
          end)
        end;
        None:
        begin
          return None
        end
      end
    end;

    procedure WriteOnTick(
  Self: TuiApplication;
  Handler: option of procedure(Sender: TuiApplication; DeltaMilliseconds: integer)
);
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      case Handler of
        Some(Value):
        begin
          var Callback: TuiApplicationTickCallback := procedure(ApplicationId: integer; DeltaMilliseconds: integer) begin
            var Sender: TuiApplication := record
              Id := ApplicationId;
              Generation := Self.Generation;
            end;
            Value(Sender, DeltaMilliseconds)
          end;
          TuiApplicationOnTick[Self.Id - 1] := Some(Callback)
        end;
        None:
        begin
          TuiApplicationOnTick[Self.Id - 1] := None
        end
      end
    end;

    procedure Start(Self: TuiApplication);
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      if TuiApplicationStarted[Self.Id - 1] then
      begin
        panic('Tui2 application has already started')
      end;
      TuiApplicationStarted[Self.Id - 1] := true;
      if Assigned(Self.OnStart) then
      begin
        Self.OnStart(Self)
      end
    end;

    function Post(Self: TuiApplication; Handler: procedure()): boolean;
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      if TuiApplicationClosing[Self.Id - 1] then
      begin
        return false
      end;
      TuiPostApplicationIds := Std.Array.Concat(TuiPostApplicationIds, [Self.Id]);
      TuiPostCallbacks := Std.Array.Concat(TuiPostCallbacks, [Handler]);
      TuiPostQueued := Std.Array.Concat(TuiPostQueued, [true]);
      return true
    end;

    procedure Tick(Self: TuiApplication; DeltaMilliseconds: integer);
    begin
      TuiApplicationRequire(Self.Id, Self.Generation);
      var Started: boolean := TuiApplicationStarted[Self.Id - 1];
      if not Started then
      begin
        panic('Tui2 application must be started before ticking')
      end;
      if DeltaMilliseconds < 0 then
      begin
        panic('Tui2 tick delta must not be negative')
      end;
      TuiApplicationDrainPosts(Self.Id, Self.Generation);
      if not Self.IsOpen() then
      begin
        return
      end;
      if Assigned(Self.OnTick) then
      begin
        Self.OnTick(Self, DeltaMilliseconds)
      end;
      if Self.IsOpen() then
      begin
        TuiApplicationDrainPosts(Self.Id, Self.Generation)
      end
    end;

    procedure Close(Self: TuiApplication);
    begin
      if not Self.IsOpen() then
      begin
        return
      end;
      if TuiApplicationClosing[Self.Id - 1] then
      begin
        return
      end;
      TuiApplicationClosing[Self.Id - 1] := true;
      if TuiApplicationStarted[Self.Id - 1] and Assigned(Self.OnStop) then
      begin
        Self.OnStop(Self)
      end;
      TuiApplicationDiscardPosts(Self.Id);
      for I: integer := 0 to Std.Array.Length(TuiCleanupApplicationIds) - 1 do
      begin
        if TuiCleanupApplicationIds[I] = Self.Id then
        begin
          var Callback: TuiApplicationCleanupCallback := TuiCleanupCallbacks[I];
          Callback(Self.Id)
        end
      end;
      TuiApplicationOnStart[Self.Id - 1] := None;
      TuiApplicationOnStop[Self.Id - 1] := None;
      TuiApplicationOnTick[Self.Id - 1] := None;
      TuiApplicationStarted[Self.Id - 1] := false;
      TuiApplicationAlive[Self.Id - 1] := false;
      TuiApplicationClosing[Self.Id - 1] := false;
      TuiApplicationGenerations[Self.Id - 1] := Self.Generation + 1
    end;

    property Tag: integer read ReadTag write WriteTag;

    event OnStart: procedure(Sender: TuiApplication) read ReadOnStart write WriteOnStart;
    event OnStop: procedure(Sender: TuiApplication) read ReadOnStop write WriteOnStop;
    event OnTick: procedure(Sender: TuiApplication; DeltaMilliseconds: integer) read ReadOnTick write WriteOnTick;
  end;
