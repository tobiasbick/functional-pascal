unit Std.Tui2.Runtime.ApplicationPaint;

uses
  Std.Array, Std.Tui2.Geometry.Size, Std.Tui2.Runtime.ApplicationLoop,
  Std.Tui2.Runtime.ApplicationRegistry, Std.Tui2.Surface.Surface;

type
  TuiApplicationPaintCallback = procedure(ApplicationId: integer; Surface: TuiSurface);

private mutable var TuiApplicationPaintGenerations: array of integer := [];
private mutable var TuiApplicationPaintSurfaces: array of TuiSurface := [];
private mutable var TuiApplicationPaintDirty: array of boolean := [];
private mutable var TuiApplicationPaintCallbackApplicationIds: array of integer := [];
private mutable var TuiApplicationPaintCallbackGenerations: array of integer := [];
private mutable var TuiApplicationPaintCallbacks: array of TuiApplicationPaintCallback := [];
private mutable var TuiApplicationPaintCallbackActive: array of boolean := [];

procedure TuiApplicationPaintInitialize(ApplicationId: integer; Generation: integer; Size: TuiSize);
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  TuiApplicationPaintGenerations := Std.Array.Concat(TuiApplicationPaintGenerations, [Generation]);
  TuiApplicationPaintSurfaces := Std.Array.Concat(TuiApplicationPaintSurfaces, [
                                                                                 TuiSurface.Create(Size)

                                                                               ]);
  TuiApplicationPaintDirty := Std.Array.Concat(TuiApplicationPaintDirty, [true])
end;

procedure TuiApplicationPaintInvalidate(ApplicationId: integer; Generation: integer);
begin
  if (ApplicationId <= 0) or (ApplicationId > Std.Array.Length(TuiApplicationPaintDirty)) then
  begin
    return
  end;
  if TuiApplicationPaintGenerations[ApplicationId - 1] <> Generation then
  begin
    return
  end;
  TuiApplicationPaintDirty[ApplicationId - 1] := true
end;

procedure TuiApplicationPaintResize(ApplicationId: integer; Generation: integer; Size: TuiSize);
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  TuiApplicationPaintSurfaces[ApplicationId - 1] := TuiSurface.Create(Size);
  TuiApplicationPaintDirty[ApplicationId - 1] := true
end;

function TuiApplicationPaintReadSurface(ApplicationId: integer; Generation: integer): TuiSurface;
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  return TuiApplicationPaintSurfaces[ApplicationId - 1]
end;

procedure RegisterApplicationPaint(
  ApplicationId: integer;
  Generation: integer;
  Callback: TuiApplicationPaintCallback
);
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  TuiApplicationPaintCallbackApplicationIds := Std.Array.Concat(TuiApplicationPaintCallbackApplicationIds, [
                                                                                                             ApplicationId

                                                                                                           ]);
  TuiApplicationPaintCallbackGenerations := Std.Array.Concat(TuiApplicationPaintCallbackGenerations, [
                                                                                                       Generation

                                                                                                     ]);
  TuiApplicationPaintCallbacks := Std.Array.Concat(TuiApplicationPaintCallbacks, [Callback]);
  TuiApplicationPaintCallbackActive := Std.Array.Concat(TuiApplicationPaintCallbackActive, [true])
end;

procedure TuiApplicationPaintPerform(ApplicationId: integer; Generation: integer);
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  if not TuiApplicationPaintDirty[ApplicationId - 1] then
  begin
    return
  end;
  var Size: TuiSize := TuiApplicationRegistryReadSize(ApplicationId, Generation);
  var Surface: TuiSurface := TuiSurface.Create(Size);
  TuiApplicationPaintSurfaces[ApplicationId - 1] := Surface;
  TuiApplicationPaintDirty[ApplicationId - 1] := false;
  var Last: integer := Std.Array.Length(TuiApplicationPaintCallbackActive);
  for I: integer := 0 to Last - 1 do
  begin
    if ((TuiApplicationPaintCallbackActive[I] and (TuiApplicationPaintCallbackApplicationIds[I] = ApplicationId)) and (TuiApplicationPaintCallbackGenerations[I] = Generation)) then
    begin
      var Callback: TuiApplicationPaintCallback := TuiApplicationPaintCallbacks[I];
      Callback(ApplicationId, Surface);
      if (not TuiApplicationRegistryIsOpen(ApplicationId, Generation)) or
         TuiApplicationLoopShouldQuit(ApplicationId) then
      begin
        return
      end
    end
  end
end;

procedure TuiApplicationPaintRelease(ApplicationId: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiApplicationPaintCallbackActive) - 1 do
  begin
    if (TuiApplicationPaintCallbackApplicationIds[I] = ApplicationId) and
       (TuiApplicationPaintCallbackGenerations[I] = Generation) then
    begin
      TuiApplicationPaintCallbackActive[I] := false
    end
  end;
  TuiApplicationPaintDirty[ApplicationId - 1] := false
end;
