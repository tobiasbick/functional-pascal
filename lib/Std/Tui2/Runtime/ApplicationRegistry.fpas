unit Std.Tui2.Runtime.ApplicationRegistry;

uses Std.Array, Std.Tui2.Geometry.Size;

private mutable var TuiApplicationRegistryGenerations: array of integer := [];
private mutable var TuiApplicationRegistryAlive: array of boolean := [];
private mutable var TuiApplicationRegistryClosing: array of boolean := [];
private mutable var TuiApplicationRegistryTags: array of integer := [];
private mutable var TuiApplicationRegistrySizes: array of TuiSize := [];

function TuiApplicationRegistryOpen(Size: TuiSize): integer;
begin
  TuiApplicationRegistryGenerations := Std.Array.Concat(TuiApplicationRegistryGenerations, [1]);
  TuiApplicationRegistryAlive := Std.Array.Concat(TuiApplicationRegistryAlive, [true]);
  TuiApplicationRegistryClosing := Std.Array.Concat(TuiApplicationRegistryClosing, [false]);
  TuiApplicationRegistryTags := Std.Array.Concat(TuiApplicationRegistryTags, [0]);
  TuiApplicationRegistrySizes := Std.Array.Concat(TuiApplicationRegistrySizes, [Size]);
  return Std.Array.Length(TuiApplicationRegistryGenerations)
end;

function TuiApplicationRegistryGeneration(ApplicationId: integer): integer;
begin
  if (ApplicationId <= 0) or (ApplicationId > Std.Array.Length(TuiApplicationRegistryGenerations)) then
  begin
    panic('Tui2 application handle has an invalid registry slot')
  end;
  return TuiApplicationRegistryGenerations[ApplicationId - 1]
end;

procedure TuiApplicationRegistryRequire(ApplicationId: integer; Generation: integer);
begin
  if (ApplicationId <= 0) or (ApplicationId > Std.Array.Length(TuiApplicationRegistryGenerations)) then
  begin
    panic('Tui2 application handle has an invalid registry slot')
  end;
  if not TuiApplicationRegistryAlive[ApplicationId - 1] then
  begin
    panic('Tui2 application handle is stale')
  end;
  if TuiApplicationRegistryGenerations[ApplicationId - 1] <> Generation then
  begin
    panic('Tui2 application handle generation does not match the registry')
  end
end;

function TuiApplicationRegistryIsOpen(ApplicationId: integer; Generation: integer): boolean;
begin
  if (ApplicationId <= 0) or (ApplicationId > Std.Array.Length(TuiApplicationRegistryGenerations)) then
  begin
    return false
  end;
  return TuiApplicationRegistryAlive[ApplicationId - 1] and
         (TuiApplicationRegistryGenerations[ApplicationId - 1] = Generation)
end;

function TuiApplicationRegistryIsClosing(ApplicationId: integer): boolean;
begin
  return TuiApplicationRegistryClosing[ApplicationId - 1]
end;

function TuiApplicationRegistryBeginClose(ApplicationId: integer; Generation: integer): boolean;
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  if TuiApplicationRegistryClosing[ApplicationId - 1] then
  begin
    return false
  end;
  TuiApplicationRegistryClosing[ApplicationId - 1] := true;
  return true
end;

procedure TuiApplicationRegistryFinishClose(ApplicationId: integer; Generation: integer);
begin
  TuiApplicationRegistryAlive[ApplicationId - 1] := false;
  TuiApplicationRegistryClosing[ApplicationId - 1] := false;
  TuiApplicationRegistryGenerations[ApplicationId - 1] := Generation + 1
end;

function TuiApplicationRegistryReadTag(ApplicationId: integer; Generation: integer): integer;
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  return TuiApplicationRegistryTags[ApplicationId - 1]
end;

procedure TuiApplicationRegistryWriteTag(
  ApplicationId: integer;
  Generation: integer;
  Value: integer
);
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  TuiApplicationRegistryTags[ApplicationId - 1] := Value
end;

function TuiApplicationRegistryReadSize(ApplicationId: integer; Generation: integer): TuiSize;
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  return TuiApplicationRegistrySizes[ApplicationId - 1]
end;

function TuiApplicationRegistryWriteSize(
  ApplicationId: integer;
  Generation: integer;
  Value: TuiSize
): boolean;
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  var Existing: TuiSize := TuiApplicationRegistrySizes[ApplicationId - 1];
  if (Existing.Width = Value.Width) and (Existing.Height = Value.Height) then
  begin
    return false
  end;
  TuiApplicationRegistrySizes[ApplicationId - 1] := Value;
  return true
end;
