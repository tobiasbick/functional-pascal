unit Std.Tui2.Runtime.ApplicationTerminal;

uses
  Std.Array, Std.Console, Std.Tui2.Cells.Cell, Std.Tui2.Cells.Color, Std.Tui2.Cells.Palette,
  Std.Tui2.Cells.Style, Std.Tui2.Geometry.Point, Std.Tui2.Geometry.Size,
  Std.Tui2.Input.PointerEvent, Std.Tui2.Runtime.ApplicationInputQueue,
  Std.Tui2.Runtime.ApplicationPaint, Std.Tui2.Runtime.ApplicationRegistry,
  Std.Tui2.Runtime.ApplicationResize, Std.Tui2.Surface.Surface;

private mutable var TuiApplicationTerminalInteractive: array of boolean := [];
private mutable var TuiApplicationTerminalOwnsSession: array of boolean := [];

procedure TuiApplicationTerminalInitialize(ApplicationId: integer; Generation: integer; Interactive: boolean);
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  TuiApplicationTerminalInteractive := Std.Array.Concat(TuiApplicationTerminalInteractive, [Interactive]);
  TuiApplicationTerminalOwnsSession := Std.Array.Concat(TuiApplicationTerminalOwnsSession, [Interactive])
end;

function TuiApplicationTerminalIsInteractive(ApplicationId: integer; Generation: integer): boolean;
begin
  TuiApplicationRegistryRequire(ApplicationId, Generation);
  if (ApplicationId <= 0) or (ApplicationId > Std.Array.Length(TuiApplicationTerminalInteractive)) then
  begin
    return false
  end;
  return TuiApplicationTerminalInteractive[ApplicationId - 1]
end;

private function TuiColorToConsole(Color: TuiColor): Std.Console.Color;
begin
  case Color.Kind of
    TuiColorKind.Crt:
    begin
      return CrtColor(Color.Index)
    end;
    TuiColorKind.Ansi256:
    begin
      return Ansi256Color(Color.Index)
    end;
    TuiColorKind.Rgb:
    begin
      return RgbColor(Color.Red, Color.Green, Color.Blue)
    end
  end
end;

private function TuiCellToConsole(Cell: TuiCell; Palette: TuiPalette): Std.Console.Cell;
begin
  var Style: TuiStyle := Palette.ForRole(Cell.Role);
  return record
    glyph := Cell.Glyph;
    foreground := TuiColorToConsole(Style.Foreground);
    background := TuiColorToConsole(Style.Background);
  end
end;

procedure TuiApplicationTerminalPresent(ApplicationId: integer; Generation: integer);
begin
  if not TuiApplicationTerminalIsInteractive(ApplicationId, Generation) then
  begin
    return
  end;
  var Surface: TuiSurface := TuiApplicationPaintReadSurface(ApplicationId, Generation);
  var Size: TuiSize := Surface.Size();
  var Palette: TuiPalette := TuiPalette.Default();
  BeginFrame();
  for Y: integer := 0 to Size.Height - 1 do
  begin
    mutable var Row: array of Std.Console.Cell := [];
    for X: integer := 0 to Size.Width - 1 do
    begin
      case Surface.TryCellAt(TuiPoint.Create(X, Y)) of
        Some(Cell):
        begin
          Row := Std.Array.Concat(Row, [TuiCellToConsole(Cell, Palette)])
        end;
        None:
        begin
        end
      end
    end;
    if Std.Array.Length(Row) > 0 then
    begin
      WriteCells(1, Y + 1, Row)
    end
  end;
  Present()
end;

private function TuiPointerButtonFromConsole(Button: Std.Console.MouseButton): TuiPointerButton;
begin
  if Button = Std.Console.MouseButton.Left then
  begin
    return TuiPointerButton.Left
  end;
  if Button = Std.Console.MouseButton.Right then
  begin
    return TuiPointerButton.Right
  end;
  if Button = Std.Console.MouseButton.Middle then
  begin
    return TuiPointerButton.Middle
  end;
  return TuiPointerButton.NoButton
end;

procedure TuiApplicationTerminalApplyResize(
  ApplicationId: integer;
  Generation: integer;
  Width: integer;
  Height: integer
);
begin
  if (Width <= 0) or (Height <= 0) then
  begin
    return
  end;
  var Size: TuiSize := TuiSize.Create(Width, Height);
  if TuiApplicationRegistryWriteSize(ApplicationId, Generation, Size) then
  begin
    TuiApplicationPaintResize(ApplicationId, Generation, Size);
    TuiApplicationResizeDispatch(ApplicationId, Generation, Size)
  end
end;

procedure TuiApplicationTerminalPoll(ApplicationId: integer; Generation: integer; TimeoutMilliseconds: integer);
begin
  if not TuiApplicationTerminalIsInteractive(ApplicationId, Generation) then
  begin
    return
  end;
  case ReadEventTimeout(TimeoutMilliseconds) of
    None:
    begin
      return
    end;
    Some(Event):
    begin
      case Event.kind of
        Std.Console.EventKind.Key:
        begin
          TuiApplicationInputQueuePushKey(ApplicationId, Generation, Event.key)
        end;
        Std.Console.EventKind.Mouse:
        begin
          var Pointer: TuiPointerEvent := TuiPointerEvent.WithModifiers(Event.mouse_action, TuiPointerButtonFromConsole(Event.mouse_button), TuiPoint.Create(Event.mouse_x - 1, Event.mouse_y - 1), Event.shift, Event.ctrl, Event.alt, Event.meta);
          TuiApplicationInputQueuePushPointer(ApplicationId, Generation, Pointer)
        end;
        Std.Console.EventKind.Resize:
        begin
          TuiApplicationTerminalApplyResize(ApplicationId, Generation, Event.width, Event.height)
        end;
        Std.Console.EventKind.Paste:
        begin
        end;
        Std.Console.EventKind.FocusGained:
        begin
        end;
        Std.Console.EventKind.FocusLost:
        begin
        end
      end
    end
  end
end;

procedure TuiApplicationTerminalRelease(ApplicationId: integer; Generation: integer);
begin
  if (ApplicationId <= 0) or (ApplicationId > Std.Array.Length(TuiApplicationTerminalOwnsSession)) then
  begin
    return
  end;
  if TuiApplicationTerminalOwnsSession[ApplicationId - 1] then
  begin
    ReleaseInteractiveTerminal();
    TuiApplicationTerminalOwnsSession[ApplicationId - 1] := false
  end;
  TuiApplicationTerminalInteractive[ApplicationId - 1] := false
end;
