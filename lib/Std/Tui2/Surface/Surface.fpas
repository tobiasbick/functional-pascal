unit Std.Tui2.Surface.Surface;

uses
  Std.Array, Std.Tui2.Cells.Cell, Std.Tui2.Cells.StyleRole, Std.Tui2.Geometry.Point,
  Std.Tui2.Geometry.Rect, Std.Tui2.Geometry.Size;

private mutable var TuiSurfaceSizes: array of TuiSize := [];
private mutable var TuiSurfaceCells: array of array of TuiCell := [];
private mutable var TuiSurfaceContinuations: array of array of boolean := [];

private function TuiSurfaceBlank(): TuiCell;
begin
  return TuiCell.Create(' ', TuiStyleRole.Normal)
end;

private procedure TuiSurfaceRequire(Slot: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(TuiSurfaceSizes)) then
  begin
    panic('Tui2 surface handle is invalid')
  end
end;

private function TuiSurfaceIndex(Size: TuiSize; Position: TuiPoint): integer;
begin
  return (Position.Y * Size.Width) + Position.X
end;

type
  TuiSurface = record
    Slot: integer;

    static function Create(Size: TuiSize): TuiSurface;
    begin
      mutable var Cells: array of TuiCell := [];
      mutable var Continuations: array of boolean := [];
      for I: integer := 0 to (Size.Width * Size.Height) - 1 do
      begin
        Cells := Std.Array.Concat(Cells, [TuiSurfaceBlank()]);
        Continuations := Std.Array.Concat(Continuations, [false])
      end;
      TuiSurfaceSizes := Std.Array.Concat(TuiSurfaceSizes, [Size]);
      TuiSurfaceCells := Std.Array.Concat(TuiSurfaceCells, [Cells]);
      TuiSurfaceContinuations := Std.Array.Concat(TuiSurfaceContinuations, [Continuations]);
      return record Slot := Std.Array.Length(TuiSurfaceSizes); end
    end;

    function Size(Self: TuiSurface): TuiSize;
    begin
      TuiSurfaceRequire(Self.Slot);
      return TuiSurfaceSizes[Self.Slot - 1]
    end;

    function Bounds(Self: TuiSurface): TuiRect;
    begin
      return TuiRect.FromPointSize(TuiPoint.Create(0, 0), Self.Size())
    end;

    function Contains(Self: TuiSurface; Position: TuiPoint): boolean;
    begin
      return Self.Bounds().Contains(Position)
    end;

    function TryCellAt(Self: TuiSurface; Position: TuiPoint): option of TuiCell;
    begin
      if not Self.Contains(Position) then
      begin
        return None
      end;
      var Index: integer := TuiSurfaceIndex(Self.Size(), Position);
      if TuiSurfaceContinuations[Self.Slot - 1][Index] then
      begin
        return None
      end;
      return Some(TuiSurfaceCells[Self.Slot - 1][Index])
    end;

    procedure PutCell(Self: TuiSurface; Position: TuiPoint; Cell: TuiCell);
    begin
      if not Self.Contains(Position) then
      begin
        return
      end;
      var Size: TuiSize := Self.Size();
      var Index: integer := TuiSurfaceIndex(Size, Position);
      var Blank: TuiCell := TuiSurfaceBlank();
      var CellWidth: integer := Cell.Width();
      mutable var Cells: array of TuiCell := TuiSurfaceCells[Self.Slot - 1];
      mutable var Continuations: array of boolean := TuiSurfaceContinuations[Self.Slot - 1];
      var ExistingCell: TuiCell := Cells[Index];
      var ExistingWidth: integer := ExistingCell.Width();
      if Continuations[Index] then
      begin
        Cells[Index - 1] := Blank;
        Continuations[Index] := false
      end
      else if ExistingWidth = 2 then
      begin
        Cells[Index + 1] := Blank;
        Continuations[Index + 1] := false
      end;
      if (CellWidth = 2) and (Position.X + 1 >= Size.Width) then
      begin
        Cells[Index] := Blank;
        TuiSurfaceCells[Self.Slot - 1] := Cells;
        TuiSurfaceContinuations[Self.Slot - 1] := Continuations;
        return
      end;
      Cells[Index] := Cell;
      Continuations[Index] := false;
      if CellWidth = 2 then
      begin
        Cells[Index + 1] := Blank;
        Continuations[Index + 1] := true
      end;
      TuiSurfaceCells[Self.Slot - 1] := Cells;
      TuiSurfaceContinuations[Self.Slot - 1] := Continuations
    end;
  end;
