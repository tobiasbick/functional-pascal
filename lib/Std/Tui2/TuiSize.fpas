unit Std.Tui2.TuiSize;

private function TuiSizeRequireNonNegative(Value: integer; Name: string): integer;
begin
  if Value < 0 then
  begin
    panic(('Tui2 ' + Name) + ' must not be negative')
  end;
  return Value
end;

type
  TuiSize = record
    Width: integer;
    Height: integer;

    static function Create(Width: integer; Height: integer): TuiSize;
    begin
      TuiSizeRequireNonNegative(Width, 'width');
      TuiSizeRequireNonNegative(Height, 'height');
      return record Width := Width; Height := Height; end
    end;

    function IsEmpty(Self: TuiSize): boolean;
    begin
      return (Self.Width = 0) or (Self.Height = 0)
    end;
  end;
