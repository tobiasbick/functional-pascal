unit Std.Tui2.Views.Container;

uses
  Std.Array, Std.Tui2.Layouts.Layout, Std.Tui2.Runtime.Application, Std.Tui2.Views.ContainerLayout,
  Std.Tui2.Views.View;

private mutable var TuiContainerParentApplicationIds: array of integer := [];
private mutable var TuiContainerParentSlots: array of integer := [];
private mutable var TuiContainerParentGenerations: array of integer := [];
private mutable var TuiContainerChildApplicationIds: array of integer := [];
private mutable var TuiContainerChildSlots: array of integer := [];
private mutable var TuiContainerChildGenerations: array of integer := [];
private mutable var TuiContainerAttached: array of boolean := [];

private procedure TuiContainerRequire(Container: TuiView);
begin
  if not Container.IsAlive() then
  begin
    panic('Tui2 container handle is stale')
  end
end;

private function TuiContainerFindChild(Container: TuiView; Child: TuiView): integer;
begin
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if (((((TuiContainerAttached[I] and (TuiContainerParentApplicationIds[I] = Container.ApplicationId)) and (TuiContainerParentSlots[I] = Container.Slot)) and (TuiContainerParentGenerations[I] = Container.Generation)) and (TuiContainerChildApplicationIds[I] = Child.ApplicationId)) and (TuiContainerChildSlots[I] = Child.Slot)) and
       (TuiContainerChildGenerations[I] = Child.Generation) then
    begin
      return I
    end
  end;
  return -1
end;

private procedure TuiContainerDestroyChildren(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if ((TuiContainerAttached[I] and (TuiContainerParentApplicationIds[I] = ApplicationId)) and (TuiContainerParentSlots[I] = Slot)) and
       (TuiContainerParentGenerations[I] = Generation) then
    begin
      TuiContainerAttached[I] := false;
      var Child: TuiView := record
        ApplicationId := TuiContainerChildApplicationIds[I];
        Slot := TuiContainerChildSlots[I];
        Generation := TuiContainerChildGenerations[I];
        Kind := TuiViewKind.Custom;
      end;
      if Child.IsAlive() then
      begin
        Child.Destroy()
      end
    end
  end
end;

private procedure TuiContainerDetachChild(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if ((TuiContainerAttached[I] and (TuiContainerChildApplicationIds[I] = ApplicationId)) and (TuiContainerChildSlots[I] = Slot)) and
       (TuiContainerChildGenerations[I] = Generation) then
    begin
      TuiContainerAttached[I] := false
    end
  end
end;

private procedure TuiContainerDestroyOwnedContent(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer
);
begin
  TuiContainerLayoutDestroy(ApplicationId, Slot, Generation);
  TuiContainerDestroyChildren(ApplicationId, Slot, Generation)
end;

private function TuiContainerIsAttached(Child: TuiView): boolean;
begin
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if ((TuiContainerAttached[I] and (TuiContainerChildApplicationIds[I] = Child.ApplicationId)) and (TuiContainerChildSlots[I] = Child.Slot)) and
       (TuiContainerChildGenerations[I] = Child.Generation) then
    begin
      return true
    end
  end;
  return false
end;

type
  TuiContainer = record
    View: TuiView;

    static function Create(App: TuiApplication): TuiContainer;
    begin
      var Container: TuiContainer := record View := TuiView.Create(App); end;
      var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
        TuiContainerDestroyOwnedContent(ApplicationId, Slot, Generation)
      end;
      RegisterViewCleanup(Container.View, Cleanup);
      return Container
    end;

    static function AsView(Container: TuiContainer): TuiView;
    begin
      TuiContainerRequire(Container.View);
      return Container.View
    end;

    function IsAlive(Self: TuiContainer): boolean;
    begin
      return Self.View.IsAlive()
    end;

    function ReadLayout(Self: TuiContainer): option of TuiLayout;
    begin
      TuiContainerRequire(Self.View);
      return TuiContainerLayoutRead(Self.View)
    end;

    procedure WriteLayout(Self: TuiContainer; Value: option of TuiLayout);
    begin
      TuiContainerRequire(Self.View);
      TuiContainerLayoutWrite(Self.View, Value)
    end;

    procedure Add(Self: TuiContainer; Child: TuiView);
    begin
      TuiContainerRequire(Self.View);
      if not Child.IsAlive() then
      begin
        panic('Tui2 container cannot attach a stale view')
      end;
      if Child.ApplicationId <> Self.View.ApplicationId then
      begin
        panic('Tui2 container child belongs to a different application')
      end;
      if TuiContainerIsAttached(Child) then
      begin
        panic('Tui2 view is already attached to a container')
      end;
      TuiContainerParentApplicationIds := Std.Array.Concat(TuiContainerParentApplicationIds, [
                                                                                               Self.View.ApplicationId

                                                                                             ]);
      TuiContainerParentSlots := Std.Array.Concat(TuiContainerParentSlots, [Self.View.Slot]);
      TuiContainerParentGenerations := Std.Array.Concat(TuiContainerParentGenerations, [
                                                                                         Self.View.Generation

                                                                                       ]);
      TuiContainerChildApplicationIds := Std.Array.Concat(TuiContainerChildApplicationIds, [
                                                                                             Child.ApplicationId

                                                                                           ]);
      TuiContainerChildSlots := Std.Array.Concat(TuiContainerChildSlots, [Child.Slot]);
      TuiContainerChildGenerations := Std.Array.Concat(TuiContainerChildGenerations, [
                                                                                       Child.Generation

                                                                                     ]);
      TuiContainerAttached := Std.Array.Concat(TuiContainerAttached, [true]);
      var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
        TuiContainerDetachChild(ApplicationId, Slot, Generation)
      end;
      RegisterViewCleanup(Child, Cleanup)
    end;

    function Contains(Self: TuiContainer; Child: TuiView): boolean;
    begin
      TuiContainerRequire(Self.View);
      return TuiContainerFindChild(Self.View, Child) >= 0
    end;

    procedure Remove(Self: TuiContainer; Child: TuiView);
    begin
      TuiContainerRequire(Self.View);
      var Index: integer := TuiContainerFindChild(Self.View, Child);
      if Index < 0 then
      begin
        panic('Tui2 container does not own the view')
      end;
      TuiContainerAttached[Index] := false;
      Child.Destroy()
    end;

    property Layout: option of TuiLayout read ReadLayout write WriteLayout;
  end;
