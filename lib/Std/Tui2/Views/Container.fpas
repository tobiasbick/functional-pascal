unit Std.Tui2.Views.Container;

uses
  Std.Array, Std.Tui2.Layouts.Layout, Std.Tui2.Layouts.LayoutFit, Std.Tui2.Runtime.Application,
  Std.Tui2.Runtime.ApplicationPaint, Std.Tui2.Views.ContainerLayout,
  Std.Tui2.Views.ContainerLayoutFit, Std.Tui2.Views.ContainerLayoutPass, Std.Tui2.Views.View,
  Std.Tui2.Views.ViewLifecycleHooks;

private mutable var TuiContainerParentApplicationIds: array of integer := [];
private mutable var TuiContainerParentSlots: array of integer := [];
private mutable var TuiContainerParentGenerations: array of integer := [];
private mutable var TuiContainerChildApplicationIds: array of integer := [];
private mutable var TuiContainerChildSlots: array of integer := [];
private mutable var TuiContainerChildGenerations: array of integer := [];
private mutable var TuiContainerAttached: array of boolean := [];
private mutable var TuiContainerOrders: array of integer := [];

private procedure TuiContainerRequire(Container: TuiView);
begin
  if not Container.IsAlive() then
  begin
    panic('Tui2 container handle is stale')
  end
end;

private function TuiContainerFindChild(Container: TuiView; Child: TuiView): integer;
begin
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if (((((TuiContainerAttached[I] and (TuiContainerParentApplicationIds[I] = Container.ApplicationId)) and (TuiContainerParentSlots[I] = Container.Slot)) and (TuiContainerParentGenerations[I] = Container.Generation)) and (TuiContainerChildApplicationIds[I] = Child.ApplicationId)) and (TuiContainerChildSlots[I] = Child.Slot)) and
       (TuiContainerChildGenerations[I] = Child.Generation) then
    begin
      return I
    end
  end;
  return -1
end;

private function TuiContainerChildCount(Container: TuiView): integer;
begin
  mutable var Count: integer := 0;
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if ((TuiContainerAttached[I] and (TuiContainerParentApplicationIds[I] = Container.ApplicationId)) and (TuiContainerParentSlots[I] = Container.Slot)) and
       (TuiContainerParentGenerations[I] = Container.Generation) then
    begin
      Count := Count + 1
    end
  end;
  return Count
end;

function TuiContainerParentOf(Child: TuiView): option of TuiView;
begin
  if not Child.IsAlive() then
  begin
    return None
  end;
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if ((TuiContainerAttached[I] and (TuiContainerChildApplicationIds[I] = Child.ApplicationId)) and (TuiContainerChildSlots[I] = Child.Slot)) and
       (TuiContainerChildGenerations[I] = Child.Generation) then
    begin
      return Some(record
        ApplicationId := TuiContainerParentApplicationIds[I];
        Slot := TuiContainerParentSlots[I];
        Generation := TuiContainerParentGenerations[I];
        Kind := TuiViewKind.Custom;
      end)
    end
  end;
  return None
end;

function TuiContainerChildrenOf(Container: TuiView): array of TuiView;
begin
  mutable var Children: array of TuiView := [];
  var Count: integer := TuiContainerChildCount(Container);
  for Order: integer := 0 to Count - 1 do
  begin
    for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
    begin
      if ((((TuiContainerAttached[I] and (TuiContainerParentApplicationIds[I] = Container.ApplicationId)) and (TuiContainerParentSlots[I] = Container.Slot)) and (TuiContainerParentGenerations[I] = Container.Generation)) and (TuiContainerOrders[I] = Order)) then
      begin
        var Child: TuiView := record
          ApplicationId := TuiContainerChildApplicationIds[I];
          Slot := TuiContainerChildSlots[I];
          Generation := TuiContainerChildGenerations[I];
          Kind := TuiViewKind.Custom;
        end;
        Children := Std.Array.Concat(Children, [Child])
      end
    end
  end;
  return Children
end;

private function TuiContainerSameView(Left: TuiView; Right: TuiView): boolean;
begin
  return ((Left.ApplicationId = Right.ApplicationId) and (Left.Slot = Right.Slot)) and
         (Left.Generation = Right.Generation)
end;

private function TuiContainerWouldCreateCycle(Container: TuiView; Child: TuiView): boolean;
begin
  if TuiContainerSameView(Container, Child) then
  begin
    return true
  end;
  case TuiContainerParentOf(Container) of
    None:
    begin
      return false
    end;
    Some(Parent):
    begin
      return TuiContainerWouldCreateCycle(Parent, Child)
    end
  end
end;

private procedure TuiContainerDetachChild(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if ((TuiContainerAttached[I] and (TuiContainerChildApplicationIds[I] = ApplicationId)) and (TuiContainerChildSlots[I] = Slot)) and
       (TuiContainerChildGenerations[I] = Generation) then
    begin
      var ParentApplicationId: integer := TuiContainerParentApplicationIds[I];
      var ParentSlot: integer := TuiContainerParentSlots[I];
      var ParentGeneration: integer := TuiContainerParentGenerations[I];
      var RemovedOrder: integer := TuiContainerOrders[I];
      TuiContainerAttached[I] := false;
      for J: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
      begin
        if ((((TuiContainerAttached[J] and (TuiContainerParentApplicationIds[J] = ParentApplicationId)) and (TuiContainerParentSlots[J] = ParentSlot)) and (TuiContainerParentGenerations[J] = ParentGeneration)) and (TuiContainerOrders[J] > RemovedOrder)) then
        begin
          TuiContainerOrders[J] := TuiContainerOrders[J] - 1
        end
      end
    end
  end
end;

private procedure TuiContainerDestroyChildren(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var Parent: TuiView := record
    ApplicationId := ApplicationId;
    Slot := Slot;
    Generation := Generation;
    Kind := TuiViewKind.Custom;
  end;
  var Children: array of TuiView := TuiContainerChildrenOf(Parent);
  for I: integer := 0 to Std.Array.Length(Children) - 1 do
  begin
    var Child: TuiView := Children[I];
    TuiContainerDetachChild(Child.ApplicationId, Child.Slot, Child.Generation);
    if Child.IsAlive() then
    begin
      Child.Destroy()
    end
  end
end;

private procedure TuiContainerDestroyOwnedContent(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer
);
begin
  TuiContainerLayoutDestroy(ApplicationId, Slot, Generation);
  TuiContainerDestroyChildren(ApplicationId, Slot, Generation)
end;

private function TuiContainerIsAttached(Child: TuiView): boolean;
begin
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if ((TuiContainerAttached[I] and (TuiContainerChildApplicationIds[I] = Child.ApplicationId)) and (TuiContainerChildSlots[I] = Child.Slot)) and
       (TuiContainerChildGenerations[I] = Child.Generation) then
    begin
      return true
    end
  end;
  return false
end;

private function TuiContainerMoveToFront(Container: TuiView; Child: TuiView): boolean;
begin
  var Index: integer := TuiContainerFindChild(Container, Child);
  if Index < 0 then
  begin
    panic('Tui2 container does not own the view')
  end;
  var LastOrder: integer := TuiContainerChildCount(Container) - 1;
  var OldOrder: integer := TuiContainerOrders[Index];
  if OldOrder = LastOrder then
  begin
    return false
  end;
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if ((((TuiContainerAttached[I] and (TuiContainerParentApplicationIds[I] = Container.ApplicationId)) and (TuiContainerParentSlots[I] = Container.Slot)) and (TuiContainerParentGenerations[I] = Container.Generation)) and (TuiContainerOrders[I] > OldOrder)) then
    begin
      TuiContainerOrders[I] := TuiContainerOrders[I] - 1
    end
  end;
  TuiContainerOrders[Index] := LastOrder;
  return true
end;

private function TuiContainerMoveToBack(Container: TuiView; Child: TuiView): boolean;
begin
  var Index: integer := TuiContainerFindChild(Container, Child);
  if Index < 0 then
  begin
    panic('Tui2 container does not own the view')
  end;
  var OldOrder: integer := TuiContainerOrders[Index];
  if OldOrder = 0 then
  begin
    return false
  end;
  for I: integer := 0 to Std.Array.Length(TuiContainerAttached) - 1 do
  begin
    if ((((TuiContainerAttached[I] and (TuiContainerParentApplicationIds[I] = Container.ApplicationId)) and (TuiContainerParentSlots[I] = Container.Slot)) and (TuiContainerParentGenerations[I] = Container.Generation)) and (TuiContainerOrders[I] < OldOrder)) then
    begin
      TuiContainerOrders[I] := TuiContainerOrders[I] + 1
    end
  end;
  TuiContainerOrders[Index] := 0;
  return true
end;

type
  TuiContainer = record
    View: TuiView;

    static function Create(App: TuiApplication): TuiContainer;
    begin
      var Container: TuiContainer := record View := TuiView.Create(App); end;
      var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
        TuiContainerDestroyOwnedContent(ApplicationId, Slot, Generation)
      end;
      RegisterViewCleanup(Container.View, Cleanup);
      return Container
    end;

    static function AsView(Container: TuiContainer): TuiView;
    begin
      TuiContainerRequire(Container.View);
      return Container.View
    end;

    function IsAlive(Self: TuiContainer): boolean;
    begin
      return Self.View.IsAlive()
    end;

    function ReadLayout(Self: TuiContainer): option of TuiLayout;
    begin
      TuiContainerRequire(Self.View);
      return TuiContainerLayoutRead(Self.View)
    end;

    procedure WriteLayout(Self: TuiContainer; Value: option of TuiLayout);
    begin
      TuiContainerRequire(Self.View);
      TuiContainerLayoutWrite(Self.View, Value)
    end;

    procedure Add(Self: TuiContainer; Child: TuiView);
    begin
      TuiContainerRequire(Self.View);
      if not Child.IsAlive() then
      begin
        panic('Tui2 container cannot attach a stale view')
      end;
      if Child.ApplicationId <> Self.View.ApplicationId then
      begin
        panic('Tui2 container child belongs to a different application')
      end;
      if TuiContainerWouldCreateCycle(Self.View, Child) then
      begin
        panic('Tui2 container attachment would create an ownership cycle')
      end;
      if TuiContainerIsAttached(Child) then
      begin
        panic('Tui2 view is already attached to a container')
      end;
      TuiContainerParentApplicationIds := Std.Array.Concat(TuiContainerParentApplicationIds, [
                                                                                               Self.View.ApplicationId

                                                                                             ]);
      TuiContainerParentSlots := Std.Array.Concat(TuiContainerParentSlots, [Self.View.Slot]);
      TuiContainerParentGenerations := Std.Array.Concat(TuiContainerParentGenerations, [
                                                                                         Self.View.Generation

                                                                                       ]);
      TuiContainerChildApplicationIds := Std.Array.Concat(TuiContainerChildApplicationIds, [
                                                                                             Child.ApplicationId

                                                                                           ]);
      TuiContainerChildSlots := Std.Array.Concat(TuiContainerChildSlots, [Child.Slot]);
      TuiContainerChildGenerations := Std.Array.Concat(TuiContainerChildGenerations, [
                                                                                       Child.Generation

                                                                                     ]);
      TuiContainerAttached := Std.Array.Concat(TuiContainerAttached, [true]);
      TuiContainerOrders := Std.Array.Concat(TuiContainerOrders, [
                                                                   TuiContainerChildCount(Self.View) - 1

                                                                 ]);
      var Cleanup: TuiViewCleanupCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
        TuiContainerDetachChild(ApplicationId, Slot, Generation)
      end;
      RegisterViewCleanup(Child, Cleanup);
      TuiViewLifecycleNotifyAttach(Child.ApplicationId, Child.Slot, Child.Generation)
    end;

    function Contains(Self: TuiContainer; Child: TuiView): boolean;
    begin
      TuiContainerRequire(Self.View);
      return TuiContainerFindChild(Self.View, Child) >= 0
    end;

    procedure Remove(Self: TuiContainer; Child: TuiView);
    begin
      TuiContainerRequire(Self.View);
      var Index: integer := TuiContainerFindChild(Self.View, Child);
      if Index < 0 then
      begin
        panic('Tui2 container does not own the view')
      end;
      TuiContainerDetachChild(Child.ApplicationId, Child.Slot, Child.Generation);
      if Child.IsAlive() then
      begin
        Child.Destroy()
      end
    end;

    function BringToFront(Self: TuiContainer; Child: TuiView): boolean;
    begin
      TuiContainerRequire(Self.View);
      var Changed: boolean := TuiContainerMoveToFront(Self.View, Child);
      if Changed then
      begin
        TuiApplicationPaintInvalidate(Self.View.ApplicationId, 1)
      end;
      return Changed
    end;

    function SendToBack(Self: TuiContainer; Child: TuiView): boolean;
    begin
      TuiContainerRequire(Self.View);
      var Changed: boolean := TuiContainerMoveToBack(Self.View, Child);
      if Changed then
      begin
        TuiApplicationPaintInvalidate(Self.View.ApplicationId, 1)
      end;
      return Changed
    end;

    function NeedsLayout(Self: TuiContainer): boolean;
    begin
      TuiContainerRequire(Self.View);
      return TuiContainerLayoutNeedsPass(Self.View)
    end;

    function PerformLayout(Self: TuiContainer): boolean;
    begin
      TuiContainerRequire(Self.View);
      return TuiContainerLayoutPerformPass(Self.View)
    end;

    function ReadLayoutFit(Self: TuiContainer): TuiLayoutFit;
    begin
      TuiContainerRequire(Self.View);
      return TuiContainerMeasureLayoutFit(Self.View)
    end;

    property Layout: option of TuiLayout read ReadLayout write WriteLayout;
    property LayoutFit: TuiLayoutFit read ReadLayoutFit;
  end;
