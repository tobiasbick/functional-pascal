unit Std.Tui2.Views.CustomViewClose;

uses Std.Array, Std.Tui2.Geometry.Rect, Std.Tui2.Views.View, Std.Tui2.Views.ViewLifecycleHooks;

type
  TuiCustomViewCloseRequestHandler = function(ApplicationId: integer; Slot: integer; Generation: integer): boolean;
  TuiCustomViewClosedHandler = procedure(ApplicationId: integer; Slot: integer; Generation: integer);

private mutable var TuiCustomViewCloseApplicationIds: array of integer := [];
private mutable var TuiCustomViewCloseSlots: array of integer := [];
private mutable var TuiCustomViewCloseGenerations: array of integer := [];
private mutable var TuiCustomViewCloseOnRequest: array of option of TuiCustomViewCloseRequestHandler := [];
private mutable var TuiCustomViewCloseOnClosed: array of option of TuiCustomViewClosedHandler := [];
private mutable var TuiCustomViewCloseClosing: array of boolean := [];
private mutable var TuiCustomViewCloseNotified: array of boolean := [];
private mutable var TuiCustomViewCloseActive: array of boolean := [];

private function TuiCustomViewCloseFind(ApplicationId: integer; Slot: integer; Generation: integer): integer;
begin
  for I: integer := 0 to Std.Array.Length(TuiCustomViewCloseActive) - 1 do
  begin
    if (((TuiCustomViewCloseActive[I] and (TuiCustomViewCloseApplicationIds[I] = ApplicationId)) and (TuiCustomViewCloseSlots[I] = Slot)) and (TuiCustomViewCloseGenerations[I] = Generation)) then
    begin
      return I
    end
  end;
  return -1
end;

private procedure TuiCustomViewCloseAttach(ApplicationId: integer; Slot: integer; Generation: integer);
begin
end;

private procedure TuiCustomViewCloseBeforeRelease(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer
);
begin
  var Index: integer := TuiCustomViewCloseFind(ApplicationId, Slot, Generation);
  if Index < 0 then
  begin
    return
  end;
  if (not TuiCustomViewCloseClosing[Index]) or TuiCustomViewCloseNotified[Index] then
  begin
    return
  end;
  TuiCustomViewCloseNotified[Index] := true;
  case TuiCustomViewCloseOnClosed[Index] of
    None:
    begin
    end;
    Some(Callback):
    begin
      Callback(ApplicationId, Slot, Generation)
    end
  end
end;

private procedure TuiCustomViewCloseBoundsChanged(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
);
begin
end;

private procedure TuiCustomViewCloseReleased(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var Index: integer := TuiCustomViewCloseFind(ApplicationId, Slot, Generation);
  if Index >= 0 then
  begin
    TuiCustomViewCloseOnRequest[Index] := None;
    TuiCustomViewCloseOnClosed[Index] := None;
    TuiCustomViewCloseClosing[Index] := false;
    TuiCustomViewCloseActive[Index] := false
  end
end;

function TuiCustomViewCloseEnsure(View: TuiView): integer;
begin
  if not View.IsAlive() then
  begin
    panic('Tui2 custom view handle is stale')
  end;
  var Existing: integer := TuiCustomViewCloseFind(View.ApplicationId, View.Slot, View.Generation);
  if Existing >= 0 then
  begin
    return Existing
  end;
  TuiCustomViewCloseApplicationIds := Std.Array.Concat(TuiCustomViewCloseApplicationIds, [
                                                                                           View.ApplicationId

                                                                                         ]);
  TuiCustomViewCloseSlots := Std.Array.Concat(TuiCustomViewCloseSlots, [View.Slot]);
  TuiCustomViewCloseGenerations := Std.Array.Concat(TuiCustomViewCloseGenerations, [View.Generation]);
  TuiCustomViewCloseOnRequest := Std.Array.Concat(TuiCustomViewCloseOnRequest, [None]);
  TuiCustomViewCloseOnClosed := Std.Array.Concat(TuiCustomViewCloseOnClosed, [None]);
  TuiCustomViewCloseClosing := Std.Array.Concat(TuiCustomViewCloseClosing, [false]);
  TuiCustomViewCloseNotified := Std.Array.Concat(TuiCustomViewCloseNotified, [false]);
  TuiCustomViewCloseActive := Std.Array.Concat(TuiCustomViewCloseActive, [true]);
  var AttachHook: TuiViewAttachHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiCustomViewCloseAttach(ApplicationId, Slot, Generation)
  end;
  var BeforeReleaseHook: TuiViewBeforeReleaseHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiCustomViewCloseBeforeRelease(ApplicationId, Slot, Generation)
  end;
  var BoundsChangedHook: TuiViewBoundsChangedHook := procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
) begin
    TuiCustomViewCloseBoundsChanged(ApplicationId, Slot, Generation, OldBounds, NewBounds)
  end;
  var ReleasedHook: TuiViewReleasedHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiCustomViewCloseReleased(ApplicationId, Slot, Generation)
  end;
  RegisterViewLifecycleHooks(View.ApplicationId, View.Slot, View.Generation, AttachHook, BeforeReleaseHook, BoundsChangedHook, ReleasedHook);
  return Std.Array.Length(TuiCustomViewCloseActive) - 1
end;

function TuiCustomViewCloseReadRequest(View: TuiView): option of TuiCustomViewCloseRequestHandler;
begin
  var Index: integer := TuiCustomViewCloseEnsure(View);
  return TuiCustomViewCloseOnRequest[Index]
end;

procedure TuiCustomViewCloseWriteRequest(
  View: TuiView;
  Handler: option of TuiCustomViewCloseRequestHandler
);
begin
  var Index: integer := TuiCustomViewCloseEnsure(View);
  TuiCustomViewCloseOnRequest[Index] := Handler
end;

function TuiCustomViewCloseReadClosed(View: TuiView): option of TuiCustomViewClosedHandler;
begin
  var Index: integer := TuiCustomViewCloseEnsure(View);
  return TuiCustomViewCloseOnClosed[Index]
end;

procedure TuiCustomViewCloseWriteClosed(
  View: TuiView;
  Handler: option of TuiCustomViewClosedHandler
);
begin
  var Index: integer := TuiCustomViewCloseEnsure(View);
  TuiCustomViewCloseOnClosed[Index] := Handler
end;

function TuiCustomViewRequestClose(View: TuiView): boolean;
begin
  var Index: integer := TuiCustomViewCloseEnsure(View);
  if TuiCustomViewCloseClosing[Index] then
  begin
    return false
  end;
  TuiCustomViewCloseClosing[Index] := true;
  mutable var Accepted: boolean := true;
  case TuiCustomViewCloseOnRequest[Index] of
    None:
    begin
    end;
    Some(Callback):
    begin
      Accepted := Callback(View.ApplicationId, View.Slot, View.Generation)
    end
  end;
  if not View.IsAlive() then
  begin
    return true
  end;
  if not Accepted then
  begin
    TuiCustomViewCloseClosing[Index] := false;
    return false
  end;
  View.Destroy();
  return true
end;
