unit Std.Tui2.Views.CustomViewFocus;

uses
  Std.Array, Std.Tui2.Geometry.Rect, Std.Tui2.Runtime.ApplicationFocus, Std.Tui2.Views.View,
  Std.Tui2.Views.ViewLifecycleHooks, Std.Tui2.Views.ViewTreeState;

type
  TuiCustomViewFocusHandler = procedure(ApplicationId: integer; Slot: integer; Generation: integer);

private mutable var TuiCustomViewFocusApplicationIds: array of integer := [];
private mutable var TuiCustomViewFocusSlots: array of integer := [];
private mutable var TuiCustomViewFocusGenerations: array of integer := [];
private mutable var TuiCustomViewFocusOnFocus: array of option of TuiCustomViewFocusHandler := [];
private mutable var TuiCustomViewFocusOnBlur: array of option of TuiCustomViewFocusHandler := [];
private mutable var TuiCustomViewFocusActive: array of boolean := [];
private mutable var TuiCustomViewFocusRegisteredApplicationIds: array of integer := [];

private function TuiCustomViewFocusApplicationRegistered(ApplicationId: integer): boolean;
begin
  for I: integer := 0 to Std.Array.Length(TuiCustomViewFocusRegisteredApplicationIds) - 1 do
  begin
    if TuiCustomViewFocusRegisteredApplicationIds[I] = ApplicationId then
    begin
      return true
    end
  end;
  return false
end;

private function TuiCustomViewFocusFind(ApplicationId: integer; Slot: integer; Generation: integer): integer;
begin
  for I: integer := 0 to Std.Array.Length(TuiCustomViewFocusActive) - 1 do
  begin
    if (((TuiCustomViewFocusActive[I] and (TuiCustomViewFocusApplicationIds[I] = ApplicationId)) and (TuiCustomViewFocusSlots[I] = Slot)) and (TuiCustomViewFocusGenerations[I] = Generation)) then
    begin
      return I
    end
  end;
  return -1
end;

private function TuiCustomViewFocusView(ApplicationId: integer; Slot: integer; Generation: integer): TuiView;
begin
  return record
    ApplicationId := ApplicationId;
    Slot := Slot;
    Generation := Generation;
    Kind := TuiViewKind.Custom;
  end
end;

private function TuiCustomViewFocusEligible(ApplicationId: integer; Slot: integer; Generation: integer): boolean;
begin
  var View: TuiView := TuiCustomViewFocusView(ApplicationId, Slot, Generation);
  return TuiViewTreeIsInteractive(View)
end;

private procedure TuiCustomViewFocusChanged(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  Focused: boolean
);
begin
  var Index: integer := TuiCustomViewFocusFind(ApplicationId, Slot, Generation);
  if Index < 0 then
  begin
    return
  end;
  if Focused then
  begin
    case TuiCustomViewFocusOnFocus[Index] of
      None:
      begin
      end;
      Some(Callback):
      begin
        Callback(ApplicationId, Slot, Generation)
      end
    end
  end
  else
  begin
    case TuiCustomViewFocusOnBlur[Index] of
      None:
      begin
      end;
      Some(Callback):
      begin
        Callback(ApplicationId, Slot, Generation)
      end
    end
  end
end;

private procedure TuiCustomViewFocusAttach(ApplicationId: integer; Slot: integer; Generation: integer);
begin
end;

private procedure TuiCustomViewFocusBeforeRelease(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer
);
begin
  if TuiApplicationFocusMatches(ApplicationId, 1, Slot, Generation) then
  begin
    TuiApplicationFocusRequest(ApplicationId, 1, 0, 0)
  end
end;

private procedure TuiCustomViewFocusBoundsChanged(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
);
begin
end;

private procedure TuiCustomViewFocusReleased(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var Index: integer := TuiCustomViewFocusFind(ApplicationId, Slot, Generation);
  if Index >= 0 then
  begin
    TuiCustomViewFocusOnFocus[Index] := None;
    TuiCustomViewFocusOnBlur[Index] := None;
    TuiCustomViewFocusActive[Index] := false
  end
end;

function TuiCustomViewFocusEnsure(View: TuiView): integer;
begin
  if not View.IsAlive() then
  begin
    panic('Tui2 custom view handle is stale')
  end;
  var Existing: integer := TuiCustomViewFocusFind(View.ApplicationId, View.Slot, View.Generation);
  if Existing >= 0 then
  begin
    return Existing
  end;
  TuiCustomViewFocusApplicationIds := Std.Array.Concat(TuiCustomViewFocusApplicationIds, [
                                                                                           View.ApplicationId

                                                                                         ]);
  TuiCustomViewFocusSlots := Std.Array.Concat(TuiCustomViewFocusSlots, [View.Slot]);
  TuiCustomViewFocusGenerations := Std.Array.Concat(TuiCustomViewFocusGenerations, [View.Generation]);
  TuiCustomViewFocusOnFocus := Std.Array.Concat(TuiCustomViewFocusOnFocus, [None]);
  TuiCustomViewFocusOnBlur := Std.Array.Concat(TuiCustomViewFocusOnBlur, [None]);
  TuiCustomViewFocusActive := Std.Array.Concat(TuiCustomViewFocusActive, [true]);
  if not TuiCustomViewFocusApplicationRegistered(View.ApplicationId) then
  begin
    TuiCustomViewFocusRegisteredApplicationIds := Std.Array.Concat(TuiCustomViewFocusRegisteredApplicationIds, [
                                                                                                                 View.ApplicationId

                                                                                                               ]);
    var Eligibility: TuiApplicationFocusEligibilityCallback := function(ApplicationId: integer; Slot: integer; Generation: integer): boolean begin
      return TuiCustomViewFocusEligible(ApplicationId, Slot, Generation)
    end;
    RegisterApplicationFocusEligibility(View.ApplicationId, 1, Eligibility);
    var Changed: TuiApplicationFocusChangedCallback := procedure(ApplicationId: integer; Slot: integer; Generation: integer; Focused: boolean) begin
      TuiCustomViewFocusChanged(ApplicationId, Slot, Generation, Focused)
    end;
    RegisterApplicationFocusChanged(View.ApplicationId, 1, Changed)
  end;
  var AttachHook: TuiViewAttachHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiCustomViewFocusAttach(ApplicationId, Slot, Generation)
  end;
  var BeforeReleaseHook: TuiViewBeforeReleaseHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiCustomViewFocusBeforeRelease(ApplicationId, Slot, Generation)
  end;
  var BoundsChangedHook: TuiViewBoundsChangedHook := procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
) begin
    TuiCustomViewFocusBoundsChanged(ApplicationId, Slot, Generation, OldBounds, NewBounds)
  end;
  var ReleasedHook: TuiViewReleasedHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiCustomViewFocusReleased(ApplicationId, Slot, Generation)
  end;
  RegisterViewLifecycleHooks(View.ApplicationId, View.Slot, View.Generation, AttachHook, BeforeReleaseHook, BoundsChangedHook, ReleasedHook);
  return Std.Array.Length(TuiCustomViewFocusActive) - 1
end;

function TuiCustomViewFocusReadFocus(View: TuiView): option of TuiCustomViewFocusHandler;
begin
  var Index: integer := TuiCustomViewFocusEnsure(View);
  return TuiCustomViewFocusOnFocus[Index]
end;

procedure TuiCustomViewFocusWriteFocus(View: TuiView; Handler: option of TuiCustomViewFocusHandler);
begin
  var Index: integer := TuiCustomViewFocusEnsure(View);
  TuiCustomViewFocusOnFocus[Index] := Handler
end;

function TuiCustomViewFocusReadBlur(View: TuiView): option of TuiCustomViewFocusHandler;
begin
  var Index: integer := TuiCustomViewFocusEnsure(View);
  return TuiCustomViewFocusOnBlur[Index]
end;

procedure TuiCustomViewFocusWriteBlur(View: TuiView; Handler: option of TuiCustomViewFocusHandler);
begin
  var Index: integer := TuiCustomViewFocusEnsure(View);
  TuiCustomViewFocusOnBlur[Index] := Handler
end;

function TuiCustomViewRequestFocus(View: TuiView): boolean;
begin
  TuiCustomViewFocusEnsure(View);
  if not TuiViewTreeIsInteractive(View) then
  begin
    return false
  end;
  TuiApplicationFocusRequest(View.ApplicationId, 1, View.Slot, View.Generation);
  if not View.IsAlive() then
  begin
    return false
  end;
  return TuiApplicationFocusMatches(View.ApplicationId, 1, View.Slot, View.Generation)
end;

function TuiCustomViewRequestBlur(View: TuiView): boolean;
begin
  TuiCustomViewFocusEnsure(View);
  if not TuiApplicationFocusMatches(View.ApplicationId, 1, View.Slot, View.Generation) then
  begin
    return false
  end;
  TuiApplicationFocusRequest(View.ApplicationId, 1, 0, 0);
  return true
end;

function TuiCustomViewIsFocused(View: TuiView): boolean;
begin
  TuiCustomViewFocusEnsure(View);
  return TuiApplicationFocusMatches(View.ApplicationId, 1, View.Slot, View.Generation)
end;
