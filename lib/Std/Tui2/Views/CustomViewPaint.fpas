unit Std.Tui2.Views.CustomViewPaint;

uses
  Std.Array, Std.Tui2.Cells.Palette, Std.Tui2.Controls.ButtonPaint, Std.Tui2.Controls.LabelPaint,
  Std.Tui2.Drawing.Canvas, Std.Tui2.Drawing.PaintContext, Std.Tui2.Geometry.Point,
  Std.Tui2.Geometry.Rect, Std.Tui2.Runtime.ApplicationFocus, Std.Tui2.Runtime.ApplicationPaint,
  Std.Tui2.Surface.Surface, Std.Tui2.Views.View, Std.Tui2.Views.ViewLifecycleHooks,
  Std.Tui2.Views.ViewPaintGeometry, Std.Tui2.Views.ViewTreeOrder;

type
  TuiCustomViewPaintCallback = procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  Canvas: TuiCanvas;
  Context: TuiPaintContext
);

private mutable var TuiCustomViewPaintApplicationIds: array of integer := [];
private mutable var TuiCustomViewPaintSlots: array of integer := [];
private mutable var TuiCustomViewPaintGenerations: array of integer := [];
private mutable var TuiCustomViewPaintHandlers: array of option of TuiCustomViewPaintCallback := [];
private mutable var TuiCustomViewPaintAttached: array of boolean := [];
private mutable var TuiCustomViewPaintActive: array of boolean := [];
private mutable var TuiCustomViewPaintRegisteredApplicationIds: array of integer := [];

private function TuiCustomViewPaintApplicationRegistered(ApplicationId: integer): boolean;
begin
  for I: integer := 0 to Std.Array.Length(TuiCustomViewPaintRegisteredApplicationIds) - 1 do
  begin
    if TuiCustomViewPaintRegisteredApplicationIds[I] = ApplicationId then
    begin
      return true
    end
  end;
  return false
end;

private function TuiCustomViewPaintFind(ApplicationId: integer; Slot: integer; Generation: integer): integer;
begin
  for I: integer := 0 to Std.Array.Length(TuiCustomViewPaintActive) - 1 do
  begin
    if (((TuiCustomViewPaintActive[I] and (TuiCustomViewPaintApplicationIds[I] = ApplicationId)) and (TuiCustomViewPaintSlots[I] = Slot)) and (TuiCustomViewPaintGenerations[I] = Generation)) then
    begin
      return I
    end
  end;
  return -1
end;

private procedure TuiCustomViewPaintAttach(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var Index: integer := TuiCustomViewPaintFind(ApplicationId, Slot, Generation);
  if Index >= 0 then
  begin
    TuiCustomViewPaintAttached[Index] := true;
    TuiApplicationPaintInvalidate(ApplicationId, 1)
  end
end;

private procedure TuiCustomViewPaintBeforeRelease(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer
);
begin
  var Index: integer := TuiCustomViewPaintFind(ApplicationId, Slot, Generation);
  if Index >= 0 then
  begin
    TuiCustomViewPaintAttached[Index] := false;
    TuiApplicationPaintInvalidate(ApplicationId, 1)
  end
end;

private procedure TuiCustomViewPaintBoundsChanged(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
);
begin
  if TuiCustomViewPaintFind(ApplicationId, Slot, Generation) >= 0 then
  begin
    TuiApplicationPaintInvalidate(ApplicationId, 1)
  end
end;

private procedure TuiCustomViewPaintReleased(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var Index: integer := TuiCustomViewPaintFind(ApplicationId, Slot, Generation);
  if Index >= 0 then
  begin
    TuiCustomViewPaintHandlers[Index] := None;
    TuiCustomViewPaintAttached[Index] := false;
    TuiCustomViewPaintActive[Index] := false
  end
end;

private procedure TuiCustomViewPaintOne(View: TuiView; Surface: TuiSurface);
begin
  var Index: integer := TuiCustomViewPaintFind(View.ApplicationId, View.Slot, View.Generation);
  if Index < 0 then
  begin
    return
  end;
  if not TuiCustomViewPaintAttached[Index] then
  begin
    return
  end;
  if not View.IsAlive() then
  begin
    return
  end;
  case TuiCustomViewPaintHandlers[Index] of
    None:
    begin
      return
    end;
    Some(Callback):
    begin
      case TuiResolveViewPaintGeometry(View, Surface.Bounds()) of
        None:
        begin
          return
        end;
        Some(Geometry):
        begin
          var LocalBounds: TuiRect := TuiRect.Create(0, 0, Geometry.Bounds.Width, Geometry.Bounds.Height);
          var LocalClip: TuiRect := TuiRect.Create(Geometry.Clip.X - Geometry.Bounds.X, Geometry.Clip.Y -
                                                                                        Geometry.Bounds.Y, Geometry.Clip.Width, Geometry.Clip.Height);
          var Canvas: TuiCanvas := TuiCanvas.CreateLocal(Surface, TuiPoint.Create(Geometry.Bounds.X, Geometry.Bounds.Y), LocalClip);
          var Context: TuiPaintContext := TuiPaintContext.Create(LocalBounds, LocalClip, Geometry.Enabled, TuiApplicationFocusMatches(View.ApplicationId, 1, View.Slot, View.Generation), TuiPalette.Default());
          Callback(View.ApplicationId, View.Slot, View.Generation, Canvas, Context)
        end
      end
    end
  end
end;

private procedure TuiCustomViewPaintAll(ApplicationId: integer; Surface: TuiSurface);
begin
  var Views: array of TuiView := TuiViewTreeOrderedViews(ApplicationId);
  for I: integer := 0 to Std.Array.Length(Views) - 1 do
  begin
    TuiCustomViewPaintOne(Views[I], Surface);
    TuiButtonPaintOne(Views[I], Surface);
    TuiLabelPaintOne(Views[I], Surface)
  end
end;

procedure TuiViewPaintEnsure(ApplicationId: integer; Generation: integer);
begin
  if TuiCustomViewPaintApplicationRegistered(ApplicationId) then
  begin
    return
  end;
  TuiCustomViewPaintRegisteredApplicationIds := Std.Array.Concat(TuiCustomViewPaintRegisteredApplicationIds, [
                                                                                                               ApplicationId

                                                                                                             ]);
  var PaintCallback: TuiApplicationPaintCallback := procedure(ApplicationId: integer; Surface: TuiSurface) begin
    TuiCustomViewPaintAll(ApplicationId, Surface)
  end;
  RegisterApplicationPaint(ApplicationId, Generation, PaintCallback)
end;

function TuiCustomViewPaintEnsure(View: TuiView): integer;
begin
  if not View.IsAlive() then
  begin
    panic('Tui2 custom view handle is stale')
  end;
  var Existing: integer := TuiCustomViewPaintFind(View.ApplicationId, View.Slot, View.Generation);
  if Existing >= 0 then
  begin
    return Existing
  end;
  TuiCustomViewPaintApplicationIds := Std.Array.Concat(TuiCustomViewPaintApplicationIds, [
                                                                                           View.ApplicationId

                                                                                         ]);
  TuiCustomViewPaintSlots := Std.Array.Concat(TuiCustomViewPaintSlots, [View.Slot]);
  TuiCustomViewPaintGenerations := Std.Array.Concat(TuiCustomViewPaintGenerations, [View.Generation]);
  TuiCustomViewPaintHandlers := Std.Array.Concat(TuiCustomViewPaintHandlers, [None]);
  TuiCustomViewPaintAttached := Std.Array.Concat(TuiCustomViewPaintAttached, [false]);
  TuiCustomViewPaintActive := Std.Array.Concat(TuiCustomViewPaintActive, [true]);
  var AttachHook: TuiViewAttachHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiCustomViewPaintAttach(ApplicationId, Slot, Generation)
  end;
  var BeforeReleaseHook: TuiViewBeforeReleaseHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiCustomViewPaintBeforeRelease(ApplicationId, Slot, Generation)
  end;
  var BoundsChangedHook: TuiViewBoundsChangedHook := procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
) begin
    TuiCustomViewPaintBoundsChanged(ApplicationId, Slot, Generation, OldBounds, NewBounds)
  end;
  var ReleasedHook: TuiViewReleasedHook := procedure(ApplicationId: integer; Slot: integer; Generation: integer) begin
    TuiCustomViewPaintReleased(ApplicationId, Slot, Generation)
  end;
  RegisterViewLifecycleHooks(View.ApplicationId, View.Slot, View.Generation, AttachHook, BeforeReleaseHook, BoundsChangedHook, ReleasedHook);
  TuiViewPaintEnsure(View.ApplicationId, 1);
  return Std.Array.Length(TuiCustomViewPaintActive) - 1
end;

function TuiCustomViewPaintRead(View: TuiView): option of TuiCustomViewPaintCallback;
begin
  var Index: integer := TuiCustomViewPaintEnsure(View);
  return TuiCustomViewPaintHandlers[Index]
end;

procedure TuiCustomViewPaintWrite(View: TuiView; Handler: option of TuiCustomViewPaintCallback);
begin
  var Index: integer := TuiCustomViewPaintEnsure(View);
  TuiCustomViewPaintHandlers[Index] := Handler;
  TuiApplicationPaintInvalidate(View.ApplicationId, 1)
end;

procedure TuiCustomViewInvalidatePaint(View: TuiView);
begin
  TuiCustomViewPaintEnsure(View);
  TuiApplicationPaintInvalidate(View.ApplicationId, 1)
end;
