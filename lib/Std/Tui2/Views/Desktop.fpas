unit Std.Tui2.Views.Desktop;

uses
  Std.Array, Std.Tui2.Geometry.Rect, Std.Tui2.Geometry.Size, Std.Tui2.Layouts.LayoutFit,
  Std.Tui2.Runtime.Application, Std.Tui2.Runtime.ApplicationLayout,
  Std.Tui2.Runtime.ApplicationResize, Std.Tui2.Views.Container, Std.Tui2.Views.View;

private mutable var TuiDesktopApplicationIds: array of integer := [];
private mutable var TuiDesktopContainers: array of TuiContainer := [];

function TuiDesktopOwnsRoot(View: TuiView): boolean;
begin
  for I: integer := 0 to Std.Array.Length(TuiDesktopApplicationIds) - 1 do
  begin
    if TuiDesktopContainers[I].IsAlive() then
    begin
      var Root: TuiView := TuiContainer.AsView(TuiDesktopContainers[I]);
      if ((Root.ApplicationId = View.ApplicationId) and (Root.Slot = View.Slot)) and
         (Root.Generation = View.Generation) then
      begin
        return true
      end
    end
  end;
  return false
end;

type
  TuiDesktop = record
    ApplicationId: integer;
    Container: TuiContainer;

    static function Create(App: TuiApplication): TuiDesktop;
    begin
      if not App.IsOpen() then
      begin
        panic('Tui2 cannot create a desktop for a closed application')
      end;
      for I: integer := 0 to Std.Array.Length(TuiDesktopApplicationIds) - 1 do
      begin
        if (TuiDesktopApplicationIds[I] = App.Id) and TuiDesktopContainers[I].IsAlive() then
        begin
          panic('Tui2 application already has a desktop root')
        end
      end;
      var Container: TuiContainer := TuiContainer.Create(App);
      var View: TuiView := TuiContainer.AsView(Container);
      var Size: TuiSize := App.Size;
      View.Bounds := TuiRect.Create(0, 0, Size.Width, Size.Height);
      TuiDesktopApplicationIds := Std.Array.Concat(TuiDesktopApplicationIds, [App.Id]);
      TuiDesktopContainers := Std.Array.Concat(TuiDesktopContainers, [Container]);
      var LayoutCallback: TuiApplicationLayoutCallback := procedure(ApplicationId: integer) begin
        if (ApplicationId = App.Id) and Container.IsAlive() then
        begin
          Container.PerformLayout()
        end
      end;
      RegisterApplicationLayout(App.Id, App.Generation, LayoutCallback);
      var ResizeCallback: TuiApplicationResizeCallback := procedure(ApplicationId: integer; NewSize: TuiSize) begin
        if (ApplicationId = App.Id) and Container.IsAlive() then
        begin
          var DesktopView: TuiView := TuiContainer.AsView(Container);
          DesktopView.Bounds := TuiRect.Create(0, 0, NewSize.Width, NewSize.Height)
        end
      end;
      RegisterApplicationResize(App.Id, App.Generation, ResizeCallback);
      return record ApplicationId := App.Id; Container := Container; end
    end;

    function IsAlive(Self: TuiDesktop): boolean;
    begin
      return Self.Container.IsAlive()
    end;

    static function AsContainer(Desktop: TuiDesktop): TuiContainer;
    begin
      if not Desktop.IsAlive() then
      begin
        panic('Tui2 desktop handle is stale')
      end;
      return Desktop.Container
    end;

    static function AsView(Desktop: TuiDesktop): TuiView;
    begin
      return TuiContainer.AsView(TuiDesktop.AsContainer(Desktop))
    end;

    procedure Add(Self: TuiDesktop; Child: TuiView);
    begin
      var Parent: TuiContainer := TuiDesktop.AsContainer(Self);
      Parent.Add(Child)
    end;

    function Contains(Self: TuiDesktop; Child: TuiView): boolean;
    begin
      var Parent: TuiContainer := TuiDesktop.AsContainer(Self);
      return Parent.Contains(Child)
    end;

    procedure Remove(Self: TuiDesktop; Child: TuiView);
    begin
      var Parent: TuiContainer := TuiDesktop.AsContainer(Self);
      Parent.Remove(Child)
    end;

    function NeedsLayout(Self: TuiDesktop): boolean;
    begin
      var Parent: TuiContainer := TuiDesktop.AsContainer(Self);
      return Parent.NeedsLayout()
    end;

    function PerformLayout(Self: TuiDesktop): boolean;
    begin
      var Parent: TuiContainer := TuiDesktop.AsContainer(Self);
      return Parent.PerformLayout()
    end;

    function ReadLayoutFit(Self: TuiDesktop): TuiLayoutFit;
    begin
      var Parent: TuiContainer := TuiDesktop.AsContainer(Self);
      return Parent.LayoutFit
    end;

    property LayoutFit: TuiLayoutFit read ReadLayoutFit;
  end;
