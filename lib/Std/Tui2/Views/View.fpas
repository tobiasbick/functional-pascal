unit Std.Tui2.Views.View;

uses
  Std.Array, Std.Tui2.Geometry.Rect, Std.Tui2.Geometry.Size, Std.Tui2.Layouts.MeasureResult,
  Std.Tui2.Layouts.SizePolicy, Std.Tui2.Runtime.Application, Std.Tui2.Runtime.ApplicationFocus,
  Std.Tui2.Runtime.ApplicationPaint, Std.Tui2.Views.ViewLifecycleHooks;

type
  TuiViewKind = enum
    Empty;
    Button;
    CheckBox;
    InputLine;
    Label;
    ListBox;
    Custom;
  end;
  TuiViewCleanupCallback = procedure(ApplicationId: integer; Slot: integer; Generation: integer);
  TuiViewLayoutInputCallback = procedure(ApplicationId: integer; Slot: integer; Generation: integer);

private mutable var TuiViewApplicationIds: array of integer := [];
private mutable var TuiViewGenerations: array of integer := [];
private mutable var TuiViewAlive: array of boolean := [];
private mutable var TuiViewTags: array of integer := [];
private mutable var TuiViewBounds: array of TuiRect := [];
private mutable var TuiViewVisible: array of boolean := [];
private mutable var TuiViewEnabled: array of boolean := [];
private mutable var TuiViewSizeHints: array of TuiMeasureResult := [];
private mutable var TuiViewSizePolicies: array of TuiSizePolicy := [];
private mutable var TuiViewCleanupApplicationIds: array of integer := [];
private mutable var TuiViewCleanupSlots: array of integer := [];
private mutable var TuiViewCleanupGenerations: array of integer := [];
private mutable var TuiViewCleanupCallbacks: array of TuiViewCleanupCallback := [];
private mutable var TuiViewLayoutInputApplicationIds: array of integer := [];
private mutable var TuiViewLayoutInputSlots: array of integer := [];
private mutable var TuiViewLayoutInputGenerations: array of integer := [];
private mutable var TuiViewLayoutInputCallbacks: array of TuiViewLayoutInputCallback := [];

private procedure TuiViewNotifyLayoutInput(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiViewLayoutInputCallbacks) - 1 do
  begin
    if ((TuiViewLayoutInputApplicationIds[I] = ApplicationId) and (TuiViewLayoutInputSlots[I] = Slot)) and
       (TuiViewLayoutInputGenerations[I] = Generation) then
    begin
      var Callback: TuiViewLayoutInputCallback := TuiViewLayoutInputCallbacks[I];
      Callback(ApplicationId, Slot, Generation)
    end
  end
end;

private function TuiViewMeasureResultEquals(Left: TuiMeasureResult; Right: TuiMeasureResult): boolean;
begin
  return (((((Left.Minimum.Width = Right.Minimum.Width) and (Left.Minimum.Height = Right.Minimum.Height)) and (Left.Preferred.Width = Right.Preferred.Width)) and (Left.Preferred.Height = Right.Preferred.Height)) and (Left.Maximum.Width = Right.Maximum.Width)) and
         (Left.Maximum.Height = Right.Maximum.Height)
end;

private procedure TuiViewRunCleanups(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  for I: integer := 0 to Std.Array.Length(TuiViewCleanupCallbacks) - 1 do
  begin
    if ((TuiViewCleanupApplicationIds[I] = ApplicationId) and (TuiViewCleanupSlots[I] = Slot)) and
       (TuiViewCleanupGenerations[I] = Generation) then
    begin
      var Callback: TuiViewCleanupCallback := TuiViewCleanupCallbacks[I];
      Callback(ApplicationId, Slot, Generation)
    end
  end
end;

private procedure TuiViewRequire(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(TuiViewGenerations)) then
  begin
    panic('Tui2 view handle has an invalid registry slot')
  end;
  if not TuiViewAlive[Slot - 1] then
  begin
    panic('Tui2 view handle is stale')
  end;
  if TuiViewGenerations[Slot - 1] <> Generation then
  begin
    panic('Tui2 view handle generation does not match the registry')
  end;
  if TuiViewApplicationIds[Slot - 1] <> ApplicationId then
  begin
    panic('Tui2 view belongs to a different application')
  end;
  var App: TuiApplication := record Id := ApplicationId; Generation := 1; end;
  if not App.IsOpen() then
  begin
    panic('Tui2 view belongs to a closed application')
  end
end;

private function TuiViewIsCurrent(ApplicationId: integer; Slot: integer; Generation: integer): boolean;
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(TuiViewGenerations)) then
  begin
    return false
  end;
  return ((TuiViewApplicationIds[Slot - 1] = ApplicationId) and (TuiViewGenerations[Slot - 1] = Generation)) and
         TuiViewAlive[Slot - 1]
end;

private procedure TuiViewRelease(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if (Slot <= 0) or (Slot > Std.Array.Length(TuiViewGenerations)) then
  begin
    return
  end;
  if ((TuiViewApplicationIds[Slot - 1] = ApplicationId) and (TuiViewGenerations[Slot - 1] = Generation)) and
     TuiViewAlive[Slot - 1] then
  begin
    TuiViewAlive[Slot - 1] := false;
    TuiViewGenerations[Slot - 1] := Generation + 1
  end
end;

private procedure TuiViewDestroyLive(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  if not TuiViewIsCurrent(ApplicationId, Slot, Generation) then
  begin
    return
  end;
  TuiViewRunCleanups(ApplicationId, Slot, Generation);
  if TuiViewIsCurrent(ApplicationId, Slot, Generation) then
  begin
    TuiViewLifecycleNotifyBeforeRelease(ApplicationId, Slot, Generation)
  end;
  if TuiViewIsCurrent(ApplicationId, Slot, Generation) then
  begin
    TuiViewRelease(ApplicationId, Slot, Generation)
  end;
  TuiViewLifecycleNotifyReleased(ApplicationId, Slot, Generation)
end;

type
  TuiView = record
    ApplicationId: integer;
    Slot: integer;
    Generation: integer;
    Kind: TuiViewKind;

    static function Empty(App: TuiApplication): TuiView;
    begin
      if not App.IsOpen() then
      begin
        panic('Tui2 cannot create a view source for a closed application')
      end;
      return record
        ApplicationId := App.Id;
        Slot := 0;
        Generation := 0;
        Kind := TuiViewKind.Empty;
      end
    end;

    static function Create(App: TuiApplication): TuiView;
    begin
      if not App.IsOpen() then
      begin
        panic('Tui2 cannot create a view for a closed application')
      end;
      mutable var Slot: integer := 0;
      for I: integer := 0 to Std.Array.Length(TuiViewAlive) - 1 do
      begin
        if not TuiViewAlive[I] then
        begin
          Slot := I + 1;
          TuiViewApplicationIds[I] := App.Id;
          TuiViewAlive[I] := true;
          TuiViewTags[I] := 0;
          TuiViewBounds[I] := TuiRect.Create(0, 0, 0, 0);
          TuiViewVisible[I] := true;
          TuiViewEnabled[I] := true;
          TuiViewSizeHints[I] := TuiMeasureResult.Fixed(TuiSize.Create(0, 0));
          TuiViewSizePolicies[I] := TuiSizePolicy.Preferred();
          break
        end
      end;
      if Slot = 0 then
      begin
        TuiViewApplicationIds := Std.Array.Concat(TuiViewApplicationIds, [App.Id]);
        TuiViewGenerations := Std.Array.Concat(TuiViewGenerations, [1]);
        TuiViewAlive := Std.Array.Concat(TuiViewAlive, [true]);
        TuiViewTags := Std.Array.Concat(TuiViewTags, [0]);
        TuiViewBounds := Std.Array.Concat(TuiViewBounds, [TuiRect.Create(0, 0, 0, 0)]);
        TuiViewVisible := Std.Array.Concat(TuiViewVisible, [true]);
        TuiViewEnabled := Std.Array.Concat(TuiViewEnabled, [true]);
        TuiViewSizeHints := Std.Array.Concat(TuiViewSizeHints, [
                                                                 TuiMeasureResult.Fixed(TuiSize.Create(0, 0))

                                                               ]);
        TuiViewSizePolicies := Std.Array.Concat(TuiViewSizePolicies, [TuiSizePolicy.Preferred()]);
        Slot := Std.Array.Length(TuiViewGenerations)
      end;
      var View: TuiView := record
        ApplicationId := App.Id;
        Slot := Slot;
        Generation := TuiViewGenerations[Slot - 1];
        Kind := TuiViewKind.Custom;
      end;
      var Cleanup: TuiApplicationCleanupCallback := procedure(ApplicationId: integer) begin
        TuiViewDestroyLive(ApplicationId, View.Slot, View.Generation)
      end;
      RegisterApplicationCleanup(App.Id, App.Generation, Cleanup);
      return View
    end;

    function IsAlive(Self: TuiView): boolean;
    begin
      if Self.Kind = TuiViewKind.Empty then
      begin
        var App: TuiApplication := record Id := Self.ApplicationId; Generation := 1; end;
        return App.IsOpen()
      end;
      return TuiViewIsCurrent(Self.ApplicationId, Self.Slot, Self.Generation)
    end;

    function ReadTag(Self: TuiView): integer;
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return TuiViewTags[Self.Slot - 1]
    end;

    procedure WriteTag(Self: TuiView; Value: integer);
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      TuiViewTags[Self.Slot - 1] := Value
    end;

    function ReadBounds(Self: TuiView): TuiRect;
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return TuiViewBounds[Self.Slot - 1]
    end;

    procedure WriteBounds(Self: TuiView; Value: TuiRect);
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Existing: TuiRect := TuiViewBounds[Self.Slot - 1];
      if (((Existing.X <> Value.X) or (Existing.Y <> Value.Y)) or (Existing.Width <> Value.Width)) or
         (Existing.Height <> Value.Height) then
      begin
        TuiViewBounds[Self.Slot - 1] := Value;
        TuiViewLifecycleNotifyBoundsChanged(Self.ApplicationId, Self.Slot, Self.Generation, Existing, Value);
        TuiApplicationPaintInvalidate(Self.ApplicationId, 1)
      end
    end;

    function ReadVisible(Self: TuiView): boolean;
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return TuiViewVisible[Self.Slot - 1]
    end;

    procedure WriteVisible(Self: TuiView; Value: boolean);
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      if TuiViewVisible[Self.Slot - 1] <> Value then
      begin
        TuiViewVisible[Self.Slot - 1] := Value;
        TuiViewNotifyLayoutInput(Self.ApplicationId, Self.Slot, Self.Generation);
        TuiApplicationFocusRevalidate(Self.ApplicationId, 1);
        TuiApplicationPaintInvalidate(Self.ApplicationId, 1)
      end
    end;

    function ReadEnabled(Self: TuiView): boolean;
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return TuiViewEnabled[Self.Slot - 1]
    end;

    procedure WriteEnabled(Self: TuiView; Value: boolean);
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      if TuiViewEnabled[Self.Slot - 1] <> Value then
      begin
        TuiViewEnabled[Self.Slot - 1] := Value;
        TuiApplicationFocusRevalidate(Self.ApplicationId, 1);
        TuiApplicationPaintInvalidate(Self.ApplicationId, 1)
      end
    end;

    function ReadSizeHint(Self: TuiView): TuiMeasureResult;
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return TuiViewSizeHints[Self.Slot - 1]
    end;

    procedure WriteSizeHint(Self: TuiView; Value: TuiMeasureResult);
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      if not TuiViewMeasureResultEquals(TuiViewSizeHints[Self.Slot - 1], Value) then
      begin
        TuiViewSizeHints[Self.Slot - 1] := Value;
        TuiViewNotifyLayoutInput(Self.ApplicationId, Self.Slot, Self.Generation)
      end
    end;

    function ReadSizePolicy(Self: TuiView): TuiSizePolicy;
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      return TuiViewSizePolicies[Self.Slot - 1]
    end;

    procedure WriteSizePolicy(Self: TuiView; Value: TuiSizePolicy);
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      var Existing: TuiSizePolicy := TuiViewSizePolicies[Self.Slot - 1];
      if (Existing.Horizontal <> Value.Horizontal) or (Existing.Vertical <> Value.Vertical) then
      begin
        TuiViewSizePolicies[Self.Slot - 1] := Value;
        TuiViewNotifyLayoutInput(Self.ApplicationId, Self.Slot, Self.Generation)
      end
    end;

    procedure Destroy(Self: TuiView);
    begin
      TuiViewRequire(Self.ApplicationId, Self.Slot, Self.Generation);
      TuiViewDestroyLive(Self.ApplicationId, Self.Slot, Self.Generation)
    end;

    property Tag: integer read ReadTag write WriteTag;
    property Bounds: TuiRect read ReadBounds write WriteBounds;
    property Visible: boolean read ReadVisible write WriteVisible;
    property Enabled: boolean read ReadEnabled write WriteEnabled;
    property SizeHint: TuiMeasureResult read ReadSizeHint write WriteSizeHint;
    property SizePolicy: TuiSizePolicy read ReadSizePolicy write WriteSizePolicy;
  end;

procedure RegisterViewCleanup(View: TuiView; Callback: TuiViewCleanupCallback);
begin
  TuiViewRequire(View.ApplicationId, View.Slot, View.Generation);
  TuiViewCleanupApplicationIds := Std.Array.Concat(TuiViewCleanupApplicationIds, [
                                                                                   View.ApplicationId

                                                                                 ]);
  TuiViewCleanupSlots := Std.Array.Concat(TuiViewCleanupSlots, [View.Slot]);
  TuiViewCleanupGenerations := Std.Array.Concat(TuiViewCleanupGenerations, [View.Generation]);
  TuiViewCleanupCallbacks := Std.Array.Concat(TuiViewCleanupCallbacks, [Callback])
end;

procedure RegisterViewLayoutInput(View: TuiView; Callback: TuiViewLayoutInputCallback);
begin
  TuiViewRequire(View.ApplicationId, View.Slot, View.Generation);
  TuiViewLayoutInputApplicationIds := Std.Array.Concat(TuiViewLayoutInputApplicationIds, [
                                                                                           View.ApplicationId

                                                                                         ]);
  TuiViewLayoutInputSlots := Std.Array.Concat(TuiViewLayoutInputSlots, [View.Slot]);
  TuiViewLayoutInputGenerations := Std.Array.Concat(TuiViewLayoutInputGenerations, [View.Generation]);
  TuiViewLayoutInputCallbacks := Std.Array.Concat(TuiViewLayoutInputCallbacks, [Callback])
end;

procedure InvalidateViewMeasurement(View: TuiView);
begin
  TuiViewRequire(View.ApplicationId, View.Slot, View.Generation);
  TuiViewNotifyLayoutInput(View.ApplicationId, View.Slot, View.Generation)
end;
