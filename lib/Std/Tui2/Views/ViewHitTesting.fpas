unit Std.Tui2.Views.ViewHitTesting;

uses
  Std.Array, Std.Tui2.Controls.Button, Std.Tui2.Geometry.Point, Std.Tui2.Geometry.Rect,
  Std.Tui2.Geometry.Size, Std.Tui2.Runtime.ApplicationRegistry, Std.Tui2.Views.CustomViewIdentity,
  Std.Tui2.Views.View, Std.Tui2.Views.ViewPaintGeometry, Std.Tui2.Views.ViewTreeOrder,
  Std.Tui2.Views.ViewTreeState;

function TuiViewHitTest(ApplicationId: integer; Generation: integer; Point: TuiPoint): option of TuiView;
begin
  var Size: TuiSize := TuiApplicationRegistryReadSize(ApplicationId, Generation);
  var SurfaceBounds: TuiRect := TuiRect.Create(0, 0, Size.Width, Size.Height);
  var Views: array of TuiView := TuiViewTreeOrderedViews(ApplicationId);
  for I: integer := Std.Array.Length(Views) - 1 downto 0 do
  begin
    var View: TuiView := Views[I];
    if (TuiCustomViewIdentityMatches(View) or TuiButtonMatchesView(View)) and
       TuiViewTreeIsInteractive(View) then
    begin
      case TuiResolveViewPaintGeometry(View, SurfaceBounds) of
        None:
        begin
        end;
        Some(Geometry):
        begin
          if Geometry.Enabled and Geometry.Clip.Contains(Point) then
          begin
            return Some(View)
          end
        end
      end
    end
  end;
  return None
end;
