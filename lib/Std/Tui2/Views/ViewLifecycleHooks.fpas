unit Std.Tui2.Views.ViewLifecycleHooks;

uses Std.Array, Std.Tui2.Geometry.Rect;

type
  TuiViewAttachHook = procedure(ApplicationId: integer; Slot: integer; Generation: integer);
  TuiViewBeforeReleaseHook = procedure(ApplicationId: integer; Slot: integer; Generation: integer);
  TuiViewBoundsChangedHook = procedure(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
);
  TuiViewReleasedHook = procedure(ApplicationId: integer; Slot: integer; Generation: integer);

private mutable var TuiViewLifecycleApplicationIds: array of integer := [];
private mutable var TuiViewLifecycleSlots: array of integer := [];
private mutable var TuiViewLifecycleGenerations: array of integer := [];
private mutable var TuiViewLifecycleAttachHooks: array of TuiViewAttachHook := [];
private mutable var TuiViewLifecycleBeforeReleaseHooks: array of TuiViewBeforeReleaseHook := [];
private mutable var TuiViewLifecycleBoundsChangedHooks: array of TuiViewBoundsChangedHook := [];
private mutable var TuiViewLifecycleReleasedHooks: array of TuiViewReleasedHook := [];
private mutable var TuiViewLifecycleActive: array of boolean := [];

private function TuiViewLifecycleMatches(
  Index: integer;
  ApplicationId: integer;
  Slot: integer;
  Generation: integer
): boolean;
begin
  return (((TuiViewLifecycleActive[Index] and (TuiViewLifecycleApplicationIds[Index] = ApplicationId)) and (TuiViewLifecycleSlots[Index] = Slot)) and (TuiViewLifecycleGenerations[Index] = Generation))
end;

procedure RegisterViewLifecycleHooks(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  AttachHook: TuiViewAttachHook;
  BeforeReleaseHook: TuiViewBeforeReleaseHook;
  BoundsChangedHook: TuiViewBoundsChangedHook;
  ReleasedHook: TuiViewReleasedHook
);
begin
  TuiViewLifecycleApplicationIds := Std.Array.Concat(TuiViewLifecycleApplicationIds, [ApplicationId]);
  TuiViewLifecycleSlots := Std.Array.Concat(TuiViewLifecycleSlots, [Slot]);
  TuiViewLifecycleGenerations := Std.Array.Concat(TuiViewLifecycleGenerations, [Generation]);
  TuiViewLifecycleAttachHooks := Std.Array.Concat(TuiViewLifecycleAttachHooks, [AttachHook]);
  TuiViewLifecycleBeforeReleaseHooks := Std.Array.Concat(TuiViewLifecycleBeforeReleaseHooks, [
                                                                                               BeforeReleaseHook

                                                                                             ]);
  TuiViewLifecycleBoundsChangedHooks := Std.Array.Concat(TuiViewLifecycleBoundsChangedHooks, [
                                                                                               BoundsChangedHook

                                                                                             ]);
  TuiViewLifecycleReleasedHooks := Std.Array.Concat(TuiViewLifecycleReleasedHooks, [ReleasedHook]);
  TuiViewLifecycleActive := Std.Array.Concat(TuiViewLifecycleActive, [true])
end;

procedure TuiViewLifecycleNotifyAttach(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var Last: integer := Std.Array.Length(TuiViewLifecycleActive);
  for I: integer := 0 to Last - 1 do
  begin
    if TuiViewLifecycleMatches(I, ApplicationId, Slot, Generation) then
    begin
      var Callback: TuiViewAttachHook := TuiViewLifecycleAttachHooks[I];
      Callback(ApplicationId, Slot, Generation)
    end
  end
end;

procedure TuiViewLifecycleNotifyBeforeRelease(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer
);
begin
  var Last: integer := Std.Array.Length(TuiViewLifecycleActive);
  for I: integer := 0 to Last - 1 do
  begin
    if TuiViewLifecycleMatches(I, ApplicationId, Slot, Generation) then
    begin
      var Callback: TuiViewBeforeReleaseHook := TuiViewLifecycleBeforeReleaseHooks[I];
      Callback(ApplicationId, Slot, Generation)
    end
  end
end;

procedure TuiViewLifecycleNotifyBoundsChanged(
  ApplicationId: integer;
  Slot: integer;
  Generation: integer;
  OldBounds: TuiRect;
  NewBounds: TuiRect
);
begin
  var Last: integer := Std.Array.Length(TuiViewLifecycleActive);
  for I: integer := 0 to Last - 1 do
  begin
    if TuiViewLifecycleMatches(I, ApplicationId, Slot, Generation) then
    begin
      var Callback: TuiViewBoundsChangedHook := TuiViewLifecycleBoundsChangedHooks[I];
      Callback(ApplicationId, Slot, Generation, OldBounds, NewBounds)
    end
  end
end;

procedure TuiViewLifecycleNotifyReleased(ApplicationId: integer; Slot: integer; Generation: integer);
begin
  var Last: integer := Std.Array.Length(TuiViewLifecycleActive);
  for I: integer := 0 to Last - 1 do
  begin
    if TuiViewLifecycleMatches(I, ApplicationId, Slot, Generation) then
    begin
      TuiViewLifecycleActive[I] := false;
      var Callback: TuiViewReleasedHook := TuiViewLifecycleReleasedHooks[I];
      Callback(ApplicationId, Slot, Generation)
    end
  end
end;
