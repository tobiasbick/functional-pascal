unit Std.Tui2.Views.ViewPaintGeometry;

uses
  Std.Tui2.Geometry.Rect, Std.Tui2.Views.Container, Std.Tui2.Views.DesktopState,
  Std.Tui2.Views.View;

type
  TuiViewPaintGeometry = record
    Bounds: TuiRect;
    Clip: TuiRect;
    Enabled: boolean;
  end;

function TuiResolveViewPaintGeometry(View: TuiView; SurfaceBounds: TuiRect): option of TuiViewPaintGeometry;
begin
  if not View.IsAlive() then
  begin
    return None
  end;
  if not View.Visible then
  begin
    return None
  end;
  var LocalBounds: TuiRect := View.Bounds;
  case TuiContainerParentOf(View) of
    None:
    begin
      if not TuiDesktopStateOwnsRoot(View) then
      begin
        return None
      end;
      var RootClip: TuiRect := SurfaceBounds.Intersect(LocalBounds);
      return Some(record Bounds := LocalBounds; Clip := RootClip; Enabled := View.Enabled; end)
    end;
    Some(Parent):
    begin
      case TuiResolveViewPaintGeometry(Parent, SurfaceBounds) of
        None:
        begin
          return None
        end;
        Some(ParentGeometry):
        begin
          var Bounds: TuiRect := TuiRect.Create(ParentGeometry.Bounds.X + LocalBounds.X, ParentGeometry.Bounds.Y +
                                                                                         LocalBounds.Y, LocalBounds.Width, LocalBounds.Height);
          return Some(record
            Bounds := Bounds;
            Clip := ParentGeometry.Clip.Intersect(Bounds);
            Enabled := ParentGeometry.Enabled and View.Enabled;
          end)
        end
      end
    end
  end
end;
