unit Std.Tui2.Views.ViewTreeState;

uses
  Std.Tui2.Views.Container, Std.Tui2.Views.DesktopState, Std.Tui2.Views.ModalState,
  Std.Tui2.Views.View;

private function TuiViewTreeIsAttachedVisibleEnabled(View: TuiView): boolean;
begin
  if not View.IsAlive() then
  begin
    return false
  end;
  if (not View.Visible) or (not View.Enabled) then
  begin
    return false
  end;
  case TuiContainerParentOf(View) of
    None:
    begin
      return TuiDesktopStateOwnsRoot(View)
    end;
    Some(Parent):
    begin
      return TuiViewTreeIsAttachedVisibleEnabled(Parent)
    end
  end
end;

function TuiViewTreeIsInteractive(View: TuiView): boolean;
begin
  return TuiViewTreeIsAttachedVisibleEnabled(View) and TuiModalStateAllows(View)
end;
