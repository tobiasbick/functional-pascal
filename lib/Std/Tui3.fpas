unit Std.Tui3;

uses
  Std.Console, Std.Tui3.Cells.Cell, Std.Tui3.Cells.Color, Std.Tui3.Cells.Palette,
  Std.Tui3.Cells.Style, Std.Tui3.Cells.StyleRole, Std.Tui3.Elements.Element, Std.Tui3.Geometry.Point,
  Std.Tui3.Geometry.Rect, Std.Tui3.Geometry.Size, Std.Tui3.Ids.Action, Std.Tui3.Ids.ControlId,
  Std.Tui3.Layout.Alignment, Std.Tui3.Layout.LayoutFit, Std.Tui3.Layout.LayoutSettings,
  Std.Tui3.Layout.Margins, Std.Tui3.Layout.Measure, Std.Tui3.Layout.MeasureConstraint,
  Std.Tui3.Layout.MeasureResult, Std.Tui3.Layout.MeasureSpec, Std.Tui3.Layout.SizePolicy,
  Std.Tui3.Layout.Spacer, Std.Tui3.Rendering.Canvas, Std.Tui3.Rendering.Surface,
  Std.Tui3.Runtime.Application, Std.Tui3.Runtime.Cmd, Std.Tui3.Runtime.Msg;

type
  /// Zero-based terminal-cell coordinate.
  TuiPoint = Std.Tui3.Geometry.Point.TuiPoint;
  /// Fixed terminal extent used by headless Tui3 hosts.
  TuiSize = Std.Tui3.Geometry.Size.TuiSize;
  /// Zero-based half-open terminal-cell rectangle.
  TuiRect = Std.Tui3.Geometry.Rect.TuiRect;
  /// Color representation kind for terminal painting.
  TuiColorKind = Std.Tui3.Cells.Color.TuiColorKind;
  /// Validated CRT, ANSI-256, or RGB color value.
  TuiColor = Std.Tui3.Cells.Color.TuiColor;
  /// Semantic style role resolved through `TuiPalette`.
  TuiStyleRole = Std.Tui3.Cells.StyleRole.TuiStyleRole;
  /// Concrete foreground/background colors and text attributes.
  TuiStyle = Std.Tui3.Cells.Style.TuiStyle;
  /// One validated renderable grapheme with a semantic style role.
  TuiCell = Std.Tui3.Cells.Cell.TuiCell;
  /// Maps every `TuiStyleRole` to a concrete `TuiStyle`.
  TuiPalette = Std.Tui3.Cells.Palette.TuiPalette;
  /// Per-axis growth and shrink policy kind.
  TuiSizePolicyKind = Std.Tui3.Layout.SizePolicy.TuiSizePolicyKind;
  /// Independent horizontal and vertical size policies.
  TuiSizePolicy = Std.Tui3.Layout.SizePolicy.TuiSizePolicy;
  /// Alignment of content inside an allocated layout slot.
  TuiAlignmentKind = Std.Tui3.Layout.Alignment.TuiAlignmentKind;
  /// Independent horizontal and vertical alignment.
  TuiAlignment = Std.Tui3.Layout.Alignment.TuiAlignment;
  /// Non-negative outer margins around a laid-out child.
  TuiMargins = Std.Tui3.Layout.Margins.TuiMargins;
  /// Immutable layout inputs for a single-child layout wrapper.
  TuiLayoutSettings = Std.Tui3.Layout.LayoutSettings.TuiLayoutSettings;
  /// Whether a measure axis is unbounded or capped.
  TuiMeasureConstraintKind = Std.Tui3.Layout.MeasureConstraint.TuiMeasureConstraintKind;
  /// One-axis measurement constraint.
  TuiMeasureConstraint = Std.Tui3.Layout.MeasureConstraint.TuiMeasureConstraint;
  /// Width and height measurement constraints.
  TuiMeasureSpec = Std.Tui3.Layout.MeasureSpec.TuiMeasureSpec;
  /// Minimum, preferred, and maximum extents.
  TuiMeasureResult = Std.Tui3.Layout.MeasureResult.TuiMeasureResult;
  /// Whether a spacer is fixed or expanding.
  TuiSpacerKind = Std.Tui3.Layout.Spacer.TuiSpacerKind;
  /// Empty layout extent used between siblings.
  TuiSpacer = Std.Tui3.Layout.Spacer.TuiSpacer;
  /// Fit report for terminal-too-small layout.
  TuiLayoutFit = Std.Tui3.Layout.LayoutFit.TuiLayoutFit;
  /// Positive identity unique among interactive nodes in one rendered tree.
  TuiControlId = Std.Tui3.Ids.ControlId.TuiControlId;
  /// Positive application intent; repetitions across controls are allowed.
  TuiAction = Std.Tui3.Ids.Action.TuiAction;
  /// Runtime command returned through Update's mutable output parameter.
  TuiCmd = Std.Tui3.Runtime.Cmd.TuiCmd;
  /// Observable command output passed to Update.
  TuiCmdOutput = Std.Tui3.Runtime.Cmd.TuiCmdOutput;
  /// Framework message delivered to Update.
  TuiMsg = Std.Tui3.Runtime.Msg.TuiMsg;
  /// Immutable element-tree node.
  TuiElement = Std.Tui3.Elements.Element.TuiElement;
  /// Named element constructors.
  TuiElementBuilders = Std.Tui3.Elements.Element.TuiElementBuilders;
  /// Explicit copy of the last painted headless surface.
  TuiSurfaceSnapshot = Std.Tui3.Rendering.Surface.TuiSurfaceSnapshot;
  /// Host-owned mutable working surface handle.
  TuiWorkingSurface = Std.Tui3.Rendering.Surface.TuiWorkingSurface;
  /// Private frame-scoped drawing capability over one working surface.
  TuiCanvas = Std.Tui3.Rendering.Canvas.TuiCanvas;
  /// Headless application host.
  TuiApplication = Std.Tui3.Runtime.Application.TuiApplication;
  /// Console key event used by headless key injection.
  TuiKeyEvent = Std.Console.KeyEvent;
  /// Console key kind used by headless key injection.
  TuiKeyKind = Std.Console.KeyKind;

/// Creates a source-aware action message.

function TuiMsgAction(
  Source: Std.Tui3.Ids.ControlId.TuiControlId;
  Action: Std.Tui3.Ids.Action.TuiAction
): Std.Tui3.Runtime.Msg.TuiMsg;
begin
  return Std.Tui3.Runtime.Msg.TuiMsgAction(Source, Action)
end;

/// Measures one element under the given constraints.

function TuiMeasure(
  Node: Std.Tui3.Elements.Element.TuiElement;
  Spec: Std.Tui3.Layout.MeasureSpec.TuiMeasureSpec
): Std.Tui3.Layout.MeasureResult.TuiMeasureResult;
begin
  return Std.Tui3.Layout.Measure.TuiMeasure(Node, Spec)
end;

/// Creates a source-aware controlled-input change message.

function TuiMsgTextChanged(
  Source: Std.Tui3.Ids.ControlId.TuiControlId;
  Action: Std.Tui3.Ids.Action.TuiAction;
  Text: string;
  Caret: integer
): Std.Tui3.Runtime.Msg.TuiMsg;
begin
  return Std.Tui3.Runtime.Msg.TuiMsgTextChanged(Source, Action, Text, Caret)
end;
