unit Std.Tui3.Cells.Cell;

uses Std.Tui3.Cells.Glyph, Std.Tui3.Cells.StyleRole;

type
  /// One validated renderable grapheme with a semantic style role.
  TuiCell = record
    Glyph: string;
    Role: TuiStyleRole;

    /// Creates a cell; the glyph must be one non-zero-width grapheme cluster.

    static function Create(Glyph: string; Role: TuiStyleRole): TuiCell;
    begin
      TuiGlyphWidth(Glyph);
      return record Glyph := Glyph; Role := Role; end
    end;

    /// Returns the terminal-column width of the cell glyph (`1` or `2`).

    function Width(Self: TuiCell): integer;
    begin
      return TuiGlyphWidth(Self.Glyph)
    end;
  end;
