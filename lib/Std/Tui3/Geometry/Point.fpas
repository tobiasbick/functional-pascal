unit Std.Tui3.Geometry.Point;

type
  /// Zero-based terminal-cell coordinate.
  TuiPoint = record
    X: integer;
    Y: integer;

    /// Creates a point. All integer coordinates are accepted.

    static function Create(X: integer; Y: integer): TuiPoint;
    begin
      return record X := X; Y := Y; end
    end;
  end;
