unit Std.Tui3.Layout.Frame;

uses Std.Array, Std.Tui3.Geometry.Rect;

type
  /// One private arranged-frame entry for a preorder element visit.
  TuiArrangedEntry = record
    ParentIndex: integer;
    Bounds: TuiRect;
    Clip: TuiRect;
  end;

private mutable var Tui3FrameEntries: array of array of TuiArrangedEntry := [];

private function Tui3FrameRequire(Slot: integer): integer;
begin
  if (Slot < 1) or (Slot > Std.Array.Length(Tui3FrameEntries)) then
  begin
    panic('Tui3 arranged frame handle is invalid')
  end;
  return Slot
end;

type
  /// Host-owned arranged-frame index for one painted tree.
  TuiArrangedFrame = record
    Slot: integer;

    /// Allocates an empty arranged frame.

    static function Create(): TuiArrangedFrame;
    begin
      mutable var Empty: array of TuiArrangedEntry := [];
      Tui3FrameEntries := Std.Array.Concat(Tui3FrameEntries, [Empty]);
      return record Slot := Std.Array.Length(Tui3FrameEntries); end
    end;

    /// Clears all entries before a fresh arrange pass.

    procedure Clear(Self: TuiArrangedFrame);
    begin
      var Slot: integer := Tui3FrameRequire(Self.Slot);
      mutable var Empty: array of TuiArrangedEntry := [];
      Tui3FrameEntries[Slot - 1] := Empty
    end;

    /// Appends one preorder entry and returns its index.

    function Push(Self: TuiArrangedFrame; ParentIndex: integer; Bounds: TuiRect; Clip: TuiRect): integer;
    begin
      var Slot: integer := Tui3FrameRequire(Self.Slot);
      mutable var Entries: array of TuiArrangedEntry := Tui3FrameEntries[Slot - 1];
      var Index: integer := Std.Array.Length(Entries);
      Std.Array.Push(Entries, record ParentIndex := ParentIndex; Bounds := Bounds; Clip := Clip; end);
      Tui3FrameEntries[Slot - 1] := Entries;
      return Index
    end;

    /// Replaces every entry atomically after a successful arrange pass.

    procedure ReplaceEntries(Self: TuiArrangedFrame; Entries: array of TuiArrangedEntry);
    begin
      var Slot: integer := Tui3FrameRequire(Self.Slot);
      Tui3FrameEntries[Slot - 1] := Entries
    end;

    /// Returns the number of arranged entries.

    function Count(Self: TuiArrangedFrame): integer;
    begin
      var Slot: integer := Tui3FrameRequire(Self.Slot);
      return Std.Array.Length(Tui3FrameEntries[Slot - 1])
    end;

    /// Returns one arranged entry by preorder index.

    function EntryAt(Self: TuiArrangedFrame; Index: integer): TuiArrangedEntry;
    begin
      var Slot: integer := Tui3FrameRequire(Self.Slot);
      var Entries: array of TuiArrangedEntry := Tui3FrameEntries[Slot - 1];
      if (Index < 0) or (Index >= Std.Array.Length(Entries)) then
      begin
        panic('Tui3 arranged frame index is out of range')
      end;
      return Entries[Index]
    end;
  end;
