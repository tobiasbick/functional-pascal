unit Std.Tui3.Rendering.Paint;

uses
  Std.Array, Std.Console, Std.Tui3.Elements.Element, Std.Tui3.Geometry.Rect, Std.Tui3.Geometry.Size,
  Std.Tui3.Ids.ControlId, Std.Tui3.Layout.Measure, Std.Tui3.Rendering.Surface;

private function TuiPaintMin(Left: integer; Right: integer): integer;
begin
  if Left < Right then
  begin
    return Left
  end;
  return Right
end;

private function TuiPaintNonNegative(Value: integer): integer;
begin
  if Value < 0 then
  begin
    return 0
  end;
  return Value
end;

private function TuiPaintFocused(Focused: option of TuiControlId; Id: TuiControlId): boolean;
begin
  case Focused of
    Some(Value):
    begin
      return Value.Value = Id.Value
    end;
    None:
    begin
      return false
    end
  end
end;

private procedure TuiPaintTextClipped(
  Surface: TuiWorkingSurface;
  X: integer;
  Y: integer;
  Width: integer;
  Text: string
);
begin
  if Width <= 0 then
  begin
    return
  end;
  mutable var Offset: integer := 0;
  for Glyph: string in Std.Console.SplitGraphemes(Text) do
  begin
    var GlyphWidth: integer := Std.Console.DisplayWidth(Glyph);
    if Offset + GlyphWidth > Width then
    begin
      return
    end;
    Surface.PutGlyph(X + Offset, Y, Glyph);
    Offset := Offset + GlyphWidth
  end
end;

private procedure TuiPaintFrame(Surface: TuiWorkingSurface; Bounds: TuiRect; Title: string);
begin
  if Bounds.IsEmpty() then
  begin
    return
  end;
  for Offset: integer := 0 to Bounds.Width - 1 do
  begin
    Surface.PutGlyph(Bounds.X + Offset, Bounds.Y, '─');
    if Bounds.Height > 1 then
    begin
      Surface.PutGlyph(Bounds.X + Offset, Bounds.Bottom() - 1, '─')
    end
  end;
  for Offset: integer := 0 to Bounds.Height - 1 do
  begin
    Surface.PutGlyph(Bounds.X, Bounds.Y + Offset, '│');
    if Bounds.Width > 1 then
    begin
      Surface.PutGlyph(Bounds.Right() - 1, Bounds.Y + Offset, '│')
    end
  end;
  Surface.PutGlyph(Bounds.X, Bounds.Y, '┌');
  if Bounds.Width > 1 then
  begin
    Surface.PutGlyph(Bounds.Right() - 1, Bounds.Y, '┐')
  end;
  if Bounds.Height > 1 then
  begin
    Surface.PutGlyph(Bounds.X, Bounds.Bottom() - 1, '└');
    if Bounds.Width > 1 then
    begin
      Surface.PutGlyph(Bounds.Right() - 1, Bounds.Bottom() - 1, '┘')
    end
  end;
  if (Title <> '') and (Bounds.Width > 6) then
  begin
    TuiPaintTextClipped(Surface, Bounds.X + 2, Bounds.Y, Bounds.Width - 4, (' ' + Title) + ' ')
  end
end;

private procedure TuiPaintElement(
  Surface: TuiWorkingSurface;
  Node: TuiElement;
  Bounds: TuiRect;
  Focused: option of TuiControlId
);
begin
  case Node of
    TuiElement.Empty:
    begin
    end;
    TuiElement.Label(Text):
    begin
      TuiPaintTextClipped(Surface, Bounds.X, Bounds.Y, Bounds.Width, Text)
    end;
    TuiElement.Button(Id, Text, Action):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        TuiPaintTextClipped(Surface, Bounds.X, Bounds.Y, Bounds.Width, ('>[ ' + Text) + ' ]')
      end
      else
      begin
        TuiPaintTextClipped(Surface, Bounds.X, Bounds.Y, Bounds.Width, (' [ ' + Text) + ' ]')
      end
    end;
    TuiElement.Input(Id, Text, Caret, ChangeAction):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        TuiPaintTextClipped(Surface, Bounds.X, Bounds.Y, Bounds.Width, ('> ' + Text) + '_')
      end
      else
      begin
        TuiPaintTextClipped(Surface, Bounds.X, Bounds.Y, Bounds.Width, '  ' + Text)
      end
    end;
    TuiElement.Row(Children):
    begin
      mutable var ChildX: integer := Bounds.X;
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        var ChildSize: TuiSize := TuiMeasureElement(Children[Index]);
        var ChildWidth: integer := TuiPaintNonNegative(TuiPaintMin(ChildSize.Width, Bounds.Right() -
                                                                                    ChildX));
        TuiPaintElement(Surface, Children[Index], TuiRect.Create(ChildX, Bounds.Y, ChildWidth, Bounds.Height), Focused);
        ChildX := (ChildX + ChildSize.Width) + 1
      end
    end;
    TuiElement.Column(Children):
    begin
      mutable var ChildY: integer := Bounds.Y;
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        var ChildSize: TuiSize := TuiMeasureElement(Children[Index]);
        var ChildHeight: integer := TuiPaintNonNegative(TuiPaintMin(ChildSize.Height, Bounds.Bottom() -
                                                                                      ChildY));
        TuiPaintElement(Surface, Children[Index], TuiRect.Create(Bounds.X, ChildY, Bounds.Width, ChildHeight), Focused);
        ChildY := ChildY + ChildSize.Height
      end
    end;
    TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children):
    begin
      TuiPaintFrame(Surface, Bounds, Title);
      var Content: TuiRect := Bounds.Inset();
      mutable var ChildY: integer := Content.Y;
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        var ChildSize: TuiSize := TuiMeasureElement(Children[Index]);
        var ChildHeight: integer := TuiPaintNonNegative(TuiPaintMin(ChildSize.Height, Content.Bottom() -
                                                                                      ChildY));
        TuiPaintElement(Surface, Children[Index], TuiRect.Create(Content.X, ChildY, Content.Width, ChildHeight), Focused);
        ChildY := ChildY + ChildSize.Height
      end
    end;
    TuiElement.Desktop(DesktopFocus, Children):
    begin
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        case Children[Index] of
          TuiElement.Dialog(Title, DialogChildren):
          begin
            var Preferred: TuiSize := TuiMeasureElement(Children[Index]);
            var Width: integer := TuiPaintMin(Preferred.Width, Bounds.Width);
            var Height: integer := TuiPaintMin(Preferred.Height, Bounds.Height);
            TuiPaintElement(Surface, Children[Index], TuiRect.Create(Bounds.X +
                                                                     ((Bounds.Width - Width) div 2), Bounds.Y +
                                                                                                     ((Bounds.Height - Height) div 2), Width, Height), DesktopFocus)
          end;
          TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(RowChildren), TuiElement.Column(ColumnChildren), TuiElement.Window(Title, WindowChildren), TuiElement.Desktop(NestedFocus, NestedChildren):
          begin
            TuiPaintElement(Surface, Children[Index], Bounds, DesktopFocus)
          end
        end
      end
    end
  end
end;

/// Validates, lays out, and paints one complete frame into the working surface.

procedure TuiPaintView(Surface: TuiWorkingSurface; Root: TuiElement);
begin
  Surface.Clear();
  TuiPaintElement(Surface, Root, TuiRectForSize(Surface.Size()), None)
end;
