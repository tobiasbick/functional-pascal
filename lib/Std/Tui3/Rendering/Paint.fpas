unit Std.Tui3.Rendering.Paint;

uses
  Std.Array, Std.Tui3.Cells.StyleRole, Std.Tui3.Elements.Element, Std.Tui3.Geometry.Point,
  Std.Tui3.Geometry.Rect, Std.Tui3.Geometry.Size, Std.Tui3.Ids.ControlId, Std.Tui3.Layout.Measure,
  Std.Tui3.Rendering.Canvas, Std.Tui3.Rendering.Surface;

private function TuiPaintMin(Left: integer; Right: integer): integer;
begin
  if Left < Right then
  begin
    return Left
  end;
  return Right
end;

private function TuiPaintNonNegative(Value: integer): integer;
begin
  if Value < 0 then
  begin
    return 0
  end;
  return Value
end;

private function TuiPaintFocused(Focused: option of TuiControlId; Id: TuiControlId): boolean;
begin
  case Focused of
    Some(Value):
    begin
      return Value.Value = Id.Value
    end;
    None:
    begin
      return false
    end
  end
end;

private procedure TuiPaintTextClipped(
  Canvas: TuiCanvas;
  X: integer;
  Y: integer;
  Width: integer;
  Text: string
);
begin
  if Width <= 0 then
  begin
    return
  end;
  Canvas.Child(TuiRect.Create(X, Y, Width, 1))
    .WriteText(TuiPoint.Create(0, 0), Text, TuiStyleRole.Normal)
end;

private procedure TuiPaintFrame(Canvas: TuiCanvas; Bounds: TuiRect; Title: string);
begin
  Canvas.Child(Bounds)
    .DrawFrame(TuiRect.Create(0, 0, Bounds.Width, Bounds.Height), TuiStyleRole.Frame);
  if (Title <> '') and (Bounds.Width > 6) then
  begin
    TuiPaintTextClipped(Canvas, Bounds.X + 2, Bounds.Y, Bounds.Width - 4, (' ' + Title) + ' ')
  end
end;

private procedure TuiPaintElement(
  Canvas: TuiCanvas;
  Node: TuiElement;
  Bounds: TuiRect;
  Focused: option of TuiControlId
);
begin
  case Node of
    TuiElement.Empty:
    begin
    end;
    TuiElement.Label(Text):
    begin
      TuiPaintTextClipped(Canvas, Bounds.X, Bounds.Y, Bounds.Width, Text)
    end;
    TuiElement.Button(Id, Text, Action):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        TuiPaintTextClipped(Canvas, Bounds.X, Bounds.Y, Bounds.Width, ('>[ ' + Text) + ' ]')
      end
      else
      begin
        TuiPaintTextClipped(Canvas, Bounds.X, Bounds.Y, Bounds.Width, (' [ ' + Text) + ' ]')
      end
    end;
    TuiElement.Input(Id, Text, Caret, ChangeAction):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        TuiPaintTextClipped(Canvas, Bounds.X, Bounds.Y, Bounds.Width, ('> ' + Text) + '_')
      end
      else
      begin
        TuiPaintTextClipped(Canvas, Bounds.X, Bounds.Y, Bounds.Width, '  ' + Text)
      end
    end;
    TuiElement.Row(Children):
    begin
      mutable var ChildX: integer := Bounds.X;
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        var ChildSize: TuiSize := TuiMeasureElement(Children[Index]);
        var ChildWidth: integer := TuiPaintNonNegative(TuiPaintMin(ChildSize.Width, Bounds.Right() -
                                                                                    ChildX));
        TuiPaintElement(Canvas, Children[Index], TuiRect.Create(ChildX, Bounds.Y, ChildWidth, Bounds.Height), Focused);
        ChildX := (ChildX + ChildSize.Width) + 1
      end
    end;
    TuiElement.Column(Children):
    begin
      mutable var ChildY: integer := Bounds.Y;
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        var ChildSize: TuiSize := TuiMeasureElement(Children[Index]);
        var ChildHeight: integer := TuiPaintNonNegative(TuiPaintMin(ChildSize.Height, Bounds.Bottom() -
                                                                                      ChildY));
        TuiPaintElement(Canvas, Children[Index], TuiRect.Create(Bounds.X, ChildY, Bounds.Width, ChildHeight), Focused);
        ChildY := ChildY + ChildSize.Height
      end
    end;
    TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children):
    begin
      TuiPaintFrame(Canvas, Bounds, Title);
      var Content: TuiRect := Bounds.Inset();
      mutable var ChildY: integer := Content.Y;
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        var ChildSize: TuiSize := TuiMeasureElement(Children[Index]);
        var ChildHeight: integer := TuiPaintNonNegative(TuiPaintMin(ChildSize.Height, Content.Bottom() -
                                                                                      ChildY));
        TuiPaintElement(Canvas, Children[Index], TuiRect.Create(Content.X, ChildY, Content.Width, ChildHeight), Focused);
        ChildY := ChildY + ChildSize.Height
      end
    end;
    TuiElement.Desktop(DesktopFocus, Children):
    begin
      for Index: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        case Children[Index] of
          TuiElement.Dialog(Title, DialogChildren):
          begin
            var Preferred: TuiSize := TuiMeasureElement(Children[Index]);
            var Width: integer := TuiPaintMin(Preferred.Width, Bounds.Width);
            var Height: integer := TuiPaintMin(Preferred.Height, Bounds.Height);
            TuiPaintElement(Canvas, Children[Index], TuiRect.Create(Bounds.X +
                                                                    ((Bounds.Width - Width) div 2), Bounds.Y +
                                                                                                    ((Bounds.Height - Height) div 2), Width, Height), DesktopFocus)
          end;
          TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(RowChildren), TuiElement.Column(ColumnChildren), TuiElement.Window(Title, WindowChildren), TuiElement.Desktop(NestedFocus, NestedChildren):
          begin
            TuiPaintElement(Canvas, Children[Index], Bounds, DesktopFocus)
          end
        end
      end
    end
  end
end;

/// Validates, lays out, and paints one complete frame into the working surface.

procedure TuiPaintView(Surface: TuiWorkingSurface; Root: TuiElement);
begin
  Surface.Clear();
  var Canvas: TuiCanvas := TuiCanvas.Create(Surface, TuiRectForSize(Surface.Size()));
  TuiPaintElement(Canvas, Root, TuiRectForSize(Surface.Size()), None)
end;
