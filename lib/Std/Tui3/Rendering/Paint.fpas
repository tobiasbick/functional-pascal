unit Std.Tui3.Rendering.Paint;

uses
  Std.Array, Std.Tui3.Cells.StyleRole, Std.Tui3.Elements.Element, Std.Tui3.Geometry.Point,
  Std.Tui3.Geometry.Rect, Std.Tui3.Ids.ControlId, Std.Tui3.Layout.Frame, Std.Tui3.Rendering.Canvas,
  Std.Tui3.Rendering.Surface;

private function TuiPaintFocused(Focused: option of TuiControlId; Id: TuiControlId): boolean;
begin
  case Focused of
    Some(Value):
    begin
      return Value.Value = Id.Value
    end;
    None:
    begin
      return false
    end
  end
end;

private procedure TuiPaintTextInBounds(Canvas: TuiCanvas; Bounds: TuiRect; Text: string);
begin
  if Bounds.IsEmpty() then
  begin
    return
  end;
  Canvas.Child(Bounds).WriteText(TuiPoint.Create(0, 0), Text, TuiStyleRole.Normal)
end;

private procedure TuiPaintFrameChrome(Canvas: TuiCanvas; Bounds: TuiRect; Title: string);
begin
  if Bounds.IsEmpty() then
  begin
    return
  end;
  Canvas.Child(Bounds)
    .DrawFrame(TuiRect.Create(0, 0, Bounds.Width, Bounds.Height), TuiStyleRole.Frame);
  if (Title <> '') and (Bounds.Width > 6) then
  begin
    TuiPaintTextInBounds(Canvas, TuiRect.Create(Bounds.X + 2, Bounds.Y, Bounds.Width - 4, 1), (' ' + Title) +
                                                                                              ' ')
  end
end;

/// Paints one arranged node and returns the next unused frame index.

private function TuiPaintArranged(
  Canvas: TuiCanvas;
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  Focused: option of TuiControlId
): integer;
begin
  var Entry: TuiArrangedEntry := Frame.EntryAt(Index);
  mutable var Next: integer := Index + 1;
  var Clipped: TuiCanvas := TuiCanvas.CreateLocal(Canvas.Surface, TuiPoint.Create(0, 0), Entry.Clip);
  case Node of
    TuiElement.Empty, TuiElement.Spacer(Value):
    begin
    end;
    TuiElement.Label(Text):
    begin
      TuiPaintTextInBounds(Clipped, Entry.Bounds, Text)
    end;
    TuiElement.Button(Id, Text, Action):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, ('>[ ' + Text) + ' ]')
      end
      else
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, (' [ ' + Text) + ' ]')
      end
    end;
    TuiElement.Input(Id, Text, Caret, ChangeAction):
    begin
      if TuiPaintFocused(Focused, Id) then
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, ('> ' + Text) + '_')
      end
      else
      begin
        TuiPaintTextInBounds(Clipped, Entry.Bounds, '  ' + Text)
      end
    end;
    TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused)
      end
    end;
    TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children):
    begin
      TuiPaintFrameChrome(Clipped, Entry.Bounds, Title);
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, Focused)
      end
    end;
    TuiElement.Desktop(DesktopFocus, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiPaintArranged(Canvas, Frame, Children[ChildIndex], Next, DesktopFocus)
      end
    end
  end;
  return Next
end;

/// Paints one complete frame using arranged geometry only (no measurement).

procedure TuiPaintView(Surface: TuiWorkingSurface; Frame: TuiArrangedFrame; Root: TuiElement);
begin
  Surface.Clear();
  var Canvas: TuiCanvas := TuiCanvas.Create(Surface, TuiRectForSize(Surface.Size()));
  var NextIndex: integer := TuiPaintArranged(Canvas, Frame, Root, 0, None);
  if NextIndex <> Frame.Count() then
  begin
    panic('Tui3 paint did not consume the complete arranged frame')
  end
end;
