unit Std.Tui3.Rendering.Surface;

uses
  Std.Array, Std.Option, Std.Str, Std.Tui3.Cells.Cell, Std.Tui3.Cells.StyleRole,
  Std.Tui3.Geometry.Point, Std.Tui3.Geometry.Size;

private mutable var Tui3SurfaceSizes: array of TuiSize := [];
private mutable var Tui3SurfaceRowOffsets: array of integer := [];
private mutable var Tui3SurfaceCells: array of array of TuiCell := [];
private mutable var Tui3SurfaceContinuations: array of array of boolean := [];

private function Tui3SurfaceBlank(): TuiCell;
begin
  return TuiCell.Create(' ', TuiStyleRole.Normal)
end;

private function Tui3SurfaceBlankRow(Width: integer): array of TuiCell;
begin
  mutable var Cells: array of TuiCell := [];
  for X: integer := 0 to Width - 1 do
  begin
    Std.Array.Push(Cells, Tui3SurfaceBlank())
  end;
  return Cells
end;

private function Tui3SurfaceBlankContinuationRow(Width: integer): array of boolean;
begin
  mutable var Continuations: array of boolean := [];
  for X: integer := 0 to Width - 1 do
  begin
    Std.Array.Push(Continuations, false)
  end;
  return Continuations
end;

private function Tui3SurfaceRequire(Slot: integer): integer;
begin
  if (Slot < 1) or (Slot > Std.Array.Length(Tui3SurfaceSizes)) then
  begin
    panic('Tui3 working surface handle is invalid')
  end;
  return Slot
end;

private procedure Tui3SurfaceClearGlyphAt(RowIndex: integer; X: integer);
begin
  var Blank: TuiCell := Tui3SurfaceBlank();
  if Tui3SurfaceContinuations[RowIndex][X] then
  begin
    Tui3SurfaceCells[RowIndex][X - 1] := Blank;
    Tui3SurfaceContinuations[RowIndex][X] := false
  end
  else if Tui3SurfaceCells[RowIndex][X].Width() = 2 then
  begin
    Tui3SurfaceCells[RowIndex][X + 1] := Blank;
    Tui3SurfaceContinuations[RowIndex][X + 1] := false
  end;
  Tui3SurfaceCells[RowIndex][X] := Blank
end;

private procedure Tui3SurfacePutCellAt(
  RowOffset: integer;
  Size: TuiSize;
  X: integer;
  Y: integer;
  Cell: TuiCell
);
begin
  var RowIndex: integer := RowOffset + Y;
  var CellWidth: integer := Cell.Width();
  Tui3SurfaceClearGlyphAt(RowIndex, X);
  if CellWidth = 2 then
  begin
    if X + 1 >= Size.Width then
    begin
      return
    end;
    Tui3SurfaceClearGlyphAt(RowIndex, X + 1)
  end;
  Tui3SurfaceCells[RowIndex][X] := Cell;
  if CellWidth = 2 then
  begin
    Tui3SurfaceCells[RowIndex][X + 1] := Tui3SurfaceBlank();
    Tui3SurfaceContinuations[RowIndex][X + 1] := true
  end
end;

type
  /// Explicit immutable copy of the most recently painted headless surface.
  TuiSurfaceSnapshot = record
    Width: integer;
    Height: integer;
    Cells: array of TuiCell;

    /// Returns one leading cell at a zero-based position.

    function CellAt(Self: TuiSurfaceSnapshot; X: integer; Y: integer): TuiCell;
    begin
      if (((X < 0) or (X >= Self.Width)) or (Y < 0)) or (Y >= Self.Height) then
      begin
        panic('Tui3 snapshot position is outside the surface')
      end;
      return Self.Cells[(Y * Self.Width) + X]
    end;

    /// Returns one complete row as text.

    function LineAt(Self: TuiSurfaceSnapshot; Y: integer): string;
    begin
      if (Y < 0) or (Y >= Self.Height) then
      begin
        panic('Tui3 snapshot row is outside the surface')
      end;
      mutable var Line: string := '';
      for X: integer := 0 to Self.Width - 1 do
      begin
        Line := Line + Self.CellAt(X, Y).Glyph
      end;
      return Line
    end;
  end;
  /// Host-owned mutable working surface handle.
  TuiWorkingSurface = record
    Slot: integer;

    /// Allocates one working grid for a headless application.

    static function Create(Size: TuiSize): TuiWorkingSurface;
    begin
      Tui3SurfaceSizes := Std.Array.Concat(Tui3SurfaceSizes, [Size]);
      Tui3SurfaceRowOffsets := Std.Array.Concat(Tui3SurfaceRowOffsets, [
                                                                         Std.Array.Length(Tui3SurfaceCells)

                                                                       ]);
      mutable var Rows: array of array of TuiCell := [];
      mutable var ContinuationRows: array of array of boolean := [];
      for Y: integer := 0 to Size.Height - 1 do
      begin
        Std.Array.Push(Rows, Tui3SurfaceBlankRow(Size.Width));
        Std.Array.Push(ContinuationRows, Tui3SurfaceBlankContinuationRow(Size.Width))
      end;
      Tui3SurfaceCells := Std.Array.Concat(Tui3SurfaceCells, Rows);
      Tui3SurfaceContinuations := Std.Array.Concat(Tui3SurfaceContinuations, ContinuationRows);
      return record Slot := Std.Array.Length(Tui3SurfaceSizes); end
    end;

    /// Returns the current surface size.

    function Size(Self: TuiWorkingSurface): TuiSize;
    begin
      var Slot: integer := Tui3SurfaceRequire(Self.Slot);
      return Tui3SurfaceSizes[Slot - 1]
    end;

    /// Returns whether the zero-based position lies inside the surface.

    function Contains(Self: TuiWorkingSurface; Position: TuiPoint): boolean;
    begin
      var Size: TuiSize := Self.Size();
      return (((Position.X >= 0) and (Position.X < Size.Width)) and (Position.Y >= 0)) and
             (Position.Y < Size.Height)
    end;

    /// Returns the leading cell at a position, or `None` outside the grid or on a continuation.

    function TryCellAt(Self: TuiWorkingSurface; Position: TuiPoint): option of TuiCell;
    begin
      if not Self.Contains(Position) then
      begin
        return None
      end;
      var Slot: integer := Tui3SurfaceRequire(Self.Slot);
      var RowIndex: integer := Tui3SurfaceRowOffsets[Slot - 1] + Position.Y;
      if Tui3SurfaceContinuations[RowIndex][Position.X] then
      begin
        return None
      end;
      return Some(Tui3SurfaceCells[RowIndex][Position.X])
    end;

    /// Replaces every row with fresh blank leading cells.

    procedure Clear(Self: TuiWorkingSurface);
    begin
      var Slot: integer := Tui3SurfaceRequire(Self.Slot);
      var Size: TuiSize := Tui3SurfaceSizes[Slot - 1];
      var RowOffset: integer := Tui3SurfaceRowOffsets[Slot - 1];
      for Y: integer := 0 to Size.Height - 1 do
      begin
        Tui3SurfaceCells[RowOffset + Y] := Tui3SurfaceBlankRow(Size.Width);
        Tui3SurfaceContinuations[RowOffset + Y] := Tui3SurfaceBlankContinuationRow(Size.Width)
      end
    end;

    /// Paints one validated cell; out-of-bounds writes are ignored.

    procedure PutCell(Self: TuiWorkingSurface; Position: TuiPoint; Cell: TuiCell);
    begin
      if not Self.Contains(Position) then
      begin
        return
      end;
      var Slot: integer := Tui3SurfaceRequire(Self.Slot);
      Tui3SurfacePutCellAt(Tui3SurfaceRowOffsets[Slot - 1], Self.Size(), Position.X, Position.Y, Cell)
    end;

    /// Paints one glyph with the normal style role; out-of-bounds writes are ignored.

    procedure PutGlyph(Self: TuiWorkingSurface; X: integer; Y: integer; Glyph: string);
    begin
      Self.PutCell(TuiPoint.Create(X, Y), TuiCell.Create(Glyph, TuiStyleRole.Normal))
    end;

    /// Copies the current leading glyphs for explicit test inspection.

    function Snapshot(Self: TuiWorkingSurface): TuiSurfaceSnapshot;
    begin
      var Slot: integer := Tui3SurfaceRequire(Self.Slot);
      var Size: TuiSize := Tui3SurfaceSizes[Slot - 1];
      var RowOffset: integer := Tui3SurfaceRowOffsets[Slot - 1];
      mutable var Cells: array of TuiCell := [];
      for Y: integer := 0 to Size.Height - 1 do
      begin
        for X: integer := 0 to Size.Width - 1 do
        begin
          if Tui3SurfaceContinuations[RowOffset + Y][X] then
          begin
            Std.Array.Push(Cells, Tui3SurfaceBlank())
          end
          else
          begin
            Std.Array.Push(Cells, Tui3SurfaceCells[RowOffset + Y][X])
          end
        end
      end;
      return record Width := Size.Width; Height := Size.Height; Cells := Cells; end
    end;
  end;
