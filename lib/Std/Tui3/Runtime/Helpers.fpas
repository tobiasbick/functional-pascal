unit Std.Tui3.Runtime.Helpers;

uses
  Std.Array, Std.Tui3.Elements.Element, Std.Tui3.Geometry.Size, Std.Tui3.Ids.ControlId,
  Std.Tui3.Layout.LayoutFit, Std.Tui3.Layout.Measure, Std.Tui3.Layout.MeasureResult,
  Std.Tui3.Layout.MeasureSpec, Std.Tui3.Runtime.Routing.Focus;

/// Returns the first focusable control in the active modal or full tree, or `None`.

function TuiFocusFirst(Root: TuiElement): option of TuiControlId;
begin
  var Controls: array of TuiControlId := TuiFocusableControls(Root);
  if Std.Array.Length(Controls) = 0 then
  begin
    return None
  end;
  return Some(Controls[0])
end;

/// Returns `Preferred` when it is focusable in the active tree; otherwise the first focusable id.

function TuiFocusResolve(Root: TuiElement; Preferred: option of TuiControlId): option of TuiControlId;
begin
  var Controls: array of TuiControlId := TuiFocusableControls(Root);
  if Std.Array.Length(Controls) = 0 then
  begin
    return None
  end;
  case Preferred of
    Some(Id):
    begin
      if TuiControlIndex(Controls, Id) >= 0 then
      begin
        return Preferred
      end
    end;
    None:
    begin
    end
  end;
  return Some(Controls[0])
end;

/// Reports whether the root's unconstrained minimum fits the available terminal size.

function TuiLayoutFitFor(Root: TuiElement; Available: TuiSize): TuiLayoutFit;
begin
  var Measured: TuiMeasureResult := TuiMeasure(Root, TuiMeasureSpec.Unbounded());
  return TuiLayoutFit.Create(Measured.Minimum, Available)
end;
