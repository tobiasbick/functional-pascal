unit Std.Tui3.Runtime.Input;

uses Std.Console, Std.Tui3.Geometry.Size, Std.Tui3.Runtime.Msg, Std.Tui3.Runtime.PointerEvent;

type
  /// One externally injected headless event, kept in arrival order.
  TuiHostInput = enum
    Message(Msg: TuiMsg);
    Key(Key: Std.Console.KeyEvent);
    Pointer(Pointer: TuiPointerEvent);
    Resize(Size: TuiSize);
  end;
