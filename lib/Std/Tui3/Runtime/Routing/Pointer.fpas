unit Std.Tui3.Runtime.Routing.Pointer;

uses
  Std.Array, Std.Console, Std.Tui3.Elements.Element, Std.Tui3.Geometry.Point, Std.Tui3.Ids.Action,
  Std.Tui3.Ids.ControlId, Std.Tui3.Layout.Frame, Std.Tui3.Runtime.Msg, Std.Tui3.Runtime.PointerEvent,
  Std.Tui3.Runtime.Routing.Focus;

type
  /// Private hit result for pointer routing against arranged geometry.
  TuiPointerHit = enum
    Miss;
    Button(Id: TuiControlId; Action: TuiAction);
    Input(Id: TuiControlId);
  end;

private mutable var Tui3PointerBestHit: TuiPointerHit := TuiPointerHit.Miss;

private function TuiRouteDesktopModalChildIndex(Children: array of TuiElement): integer;
begin
  mutable var LastDialog: integer := -1;
  for Index: integer := 0 to Std.Array.Length(Children) - 1 do
  begin
    case Children[Index] of
      TuiElement.Dialog(Title, DialogChildren):
      begin
        LastDialog := Index
      end;
      TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(RowChildren, RowSpacing), TuiElement.Column(ColumnChildren, ColumnSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Spacer(SpacerValue), TuiElement.Window(Title, WindowChildren), TuiElement.Desktop(NestedFocus, NestedChildren):
      begin
      end
    end
  end;
  return LastDialog
end;

private function TuiRoutePointerHitWalk(
  Frame: TuiArrangedFrame;
  Node: TuiElement;
  Index: integer;
  Point: TuiPoint;
  AllowHits: boolean
): integer;
begin
  var Entry: TuiArrangedEntry := Frame.EntryAt(Index);
  mutable var Next: integer := Index + 1;
  case Node of
    TuiElement.Button(Id, Text, Action):
    begin
      if AllowHits and Entry.Clip.Contains(Point) then
      begin
        Tui3PointerBestHit := TuiPointerHit.Button(Id, Action)
      end
    end;
    TuiElement.Input(Id, Text, Caret, ChangeAction):
    begin
      if AllowHits and Entry.Clip.Contains(Point) then
      begin
        Tui3PointerBestHit := TuiPointerHit.Input(Id)
      end
    end;
    TuiElement.Row(Children, Spacing), TuiElement.Column(Children, Spacing), TuiElement.Layout(Settings, Children), TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children):
    begin
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        Next := TuiRoutePointerHitWalk(Frame, Children[ChildIndex], Next, Point, AllowHits)
      end
    end;
    TuiElement.Desktop(Focused, Children):
    begin
      var ModalIndex: integer := TuiRouteDesktopModalChildIndex(Children);
      for ChildIndex: integer := 0 to Std.Array.Length(Children) - 1 do
      begin
        mutable var ChildAllow: boolean := AllowHits;
        if ModalIndex >= 0 then
        begin
          ChildAllow := AllowHits and (ChildIndex = ModalIndex)
        end;
        Next := TuiRoutePointerHitWalk(Frame, Children[ChildIndex], Next, Point, ChildAllow)
      end
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Spacer(Value):
    begin
    end
  end;
  return Next
end;

private function TuiRoutePointerFocusMessages(Previous: option of TuiControlId; Target: TuiControlId): array of TuiMsg;
begin
  if TuiFocusMatches(Previous, Target) then
  begin
    return []
  end;
  return [TuiMsg.FocusChanged(Previous, Some(Target))]
end;

/// Routes one pointer event against arranged geometry into ordered framework messages.

function TuiRoutePointer(Root: TuiElement; Frame: TuiArrangedFrame; Pointer: TuiPointerEvent): array of TuiMsg;
begin
  TuiRouteRequireMatchingFrame(Frame, Root);
  if (Pointer.Action <> Std.Console.MouseAction.Down) or (Pointer.Button <> TuiPointerButton.Left) then
  begin
    return [TuiMsg.Pointer(Pointer)]
  end;
  Tui3PointerBestHit := TuiPointerHit.Miss;
  if TuiRoutePointerHitWalk(Frame, Root, 0, Pointer.Position, true) <> Frame.Count() then
  begin
    panic('Tui3 pointer routing did not consume the complete arranged frame')
  end;
  var Previous: option of TuiControlId := TuiRootFocus(Root);
  case Tui3PointerBestHit of
    TuiPointerHit.Miss:
    begin
      return [TuiMsg.Pointer(Pointer)]
    end;
    TuiPointerHit.Button(Id, Action):
    begin
      return Std.Array.Concat(TuiRoutePointerFocusMessages(Previous, Id), [
                                                                            TuiMsg.Action(Id, Action)

                                                                          ])
    end;
    TuiPointerHit.Input(Id):
    begin
      var FocusMessages: array of TuiMsg := TuiRoutePointerFocusMessages(Previous, Id);
      if Std.Array.Length(FocusMessages) = 0 then
      begin
        return [TuiMsg.Pointer(Pointer)]
      end;
      return FocusMessages
    end
  end
end;
