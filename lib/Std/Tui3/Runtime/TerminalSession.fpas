unit Std.Tui3.Runtime.TerminalSession;

uses Std.Console;

private mutable var Tui3TerminalSessionOpen: boolean := false;

/// Acquires the process terminal for one interactive Tui3 host.
///
/// `Std.Console` performs transactional mode acquisition and reverse-order rollback.

procedure TuiTerminalSessionAcquire();
begin
  AcquireInteractiveTerminal();
  Tui3TerminalSessionOpen := true
end;

/// Releases the process terminal when this Tui3 host owns it.

procedure TuiTerminalSessionRelease();
begin
  if not Tui3TerminalSessionOpen then
  begin
    return
  end;
  Tui3TerminalSessionOpen := false;
  ReleaseInteractiveTerminal()
end;
