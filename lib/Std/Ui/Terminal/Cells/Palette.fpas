unit Std.Ui.Terminal.Cells.Palette;

uses
  Std.Ui.Terminal.Cells.ButtonPalette as ButtonPalette, Std.Ui.Terminal.Cells.Color as Color,
  Std.Ui.Terminal.Cells.InputPalette as InputPalette, Std.Ui.Terminal.Cells.StyleRole as StyleRole,
  Std.Ui.Terminal.Cells.Style as CellsStyle;

function TuiContainerStyle(Override: option of CellsStyle.TuiStyle; Fallback: CellsStyle.TuiStyle): CellsStyle.TuiStyle;
begin
  case Override of
    when Some(const Style):
      return Style;
    when None:
      return Fallback;
  end case;
end function;

function TuiDefaultButtonColors(Foreground: Color.TuiColor; Surface: Color.TuiColor; Focus: Color.TuiColor; Muted: Color.TuiColor; Shortcut: Color.TuiColor): ButtonPalette.TuiButtonColors;
begin
  return ButtonPalette.TuiButtonColors.Create(
    CellsStyle.TuiStyle.FromColors(Foreground, Surface),
    CellsStyle.TuiStyle.FromColors(Foreground, Focus),
    CellsStyle.TuiStyle.FromColors(Foreground, Focus),
    CellsStyle.TuiStyle.FromColors(Surface, Foreground),
    CellsStyle.TuiStyle.FromColors(Muted, Surface),
    CellsStyle.TuiStyle.FromColors(Focus, Foreground)
  ) with ShortcutForeground := Some(Shortcut); end with;
end function;

// Maps every semantic `TuiStyleRole` to a concrete terminal style.
public type TuiPalette = record
  // Style used for normal content.
  public Normal: CellsStyle.TuiStyle;
  // Style used for disabled content.
  public Disabled: CellsStyle.TuiStyle;
  // Style or identifier used for focused content.
  public Focused: CellsStyle.TuiStyle;
  // Selected item index or style.
  public Selected: CellsStyle.TuiStyle;
  // Shortcut text, gesture, or style.
  public Shortcut: CellsStyle.TuiStyle;
  // Style used for borders and frames.
  public Frame: CellsStyle.TuiStyle;
  // Style used for titles.
  public Title: CellsStyle.TuiStyle;
  // Normal content and title styles on panel surfaces.
  public PanelNormal: option of CellsStyle.TuiStyle;
  public PanelTitle: option of CellsStyle.TuiStyle;
  // Frame style for a panel containing the focused control.
  public PanelFocusedFrame: option of CellsStyle.TuiStyle;
  // Normal content, frame, focused frame and title styles on overlays.
  public OverlayNormal: option of CellsStyle.TuiStyle;
  public OverlayFrame: option of CellsStyle.TuiStyle;
  public OverlayFocusedFrame: option of CellsStyle.TuiStyle;
  public OverlayTitle: option of CellsStyle.TuiStyle;
  // Optional styles for ordinary, selected, focused, and disabled tabs.
  public TabNormal: option of CellsStyle.TuiStyle;
  public TabSelected: option of CellsStyle.TuiStyle;
  public TabSelectedFocused: option of CellsStyle.TuiStyle;
  public TabDisabled: option of CellsStyle.TuiStyle;
  // Style used for normal menu items.
  public MenuNormal: CellsStyle.TuiStyle;
  // Style used for disabled menu items.
  public MenuDisabled: CellsStyle.TuiStyle;
  // Style used for menu shortcuts.
  public MenuShortcut: CellsStyle.TuiStyle;
  // Style used for the selected menu item.
  public MenuSelected: CellsStyle.TuiStyle;
  // Shortcut style used for the selected menu item.
  public MenuSelectedShortcut: CellsStyle.TuiStyle;
  // Style used for normal status-line items.
  public StatusNormal: CellsStyle.TuiStyle;
  // Style used for disabled status-line items.
  public StatusDisabled: CellsStyle.TuiStyle;
  // Style used for status-line shortcuts.
  public StatusShortcut: CellsStyle.TuiStyle;
  // Style used for selected status-line items.
  public StatusSelected: CellsStyle.TuiStyle;
  // Styles used by button controls.
  public Buttons: ButtonPalette.TuiButtonPalette;
  // Styles used by input controls.
  public Inputs: InputPalette.TuiInputPalette;
  // Style used for horizontal rules.
  public Rule: CellsStyle.TuiStyle;
  // Style used for the unfilled gauge track.
  public GaugeTrack: CellsStyle.TuiStyle;
  // Style used for the filled gauge region.
  public GaugeFill: CellsStyle.TuiStyle;
  // Style used for failure content.
  public Failure: CellsStyle.TuiStyle;
  // Style used for warning content.
  public Warning: CellsStyle.TuiStyle;
  // Style used for accent content.
  public Accent: CellsStyle.TuiStyle;

  // Returns the modern dark default palette.
  public static function Default(): TuiPalette;
  begin
    const Background: Color.TuiColor := Color.TuiColor.FromRgb(13, 17, 23);
    const Surface: Color.TuiColor := Color.TuiColor.FromRgb(22, 27, 34);
    const Text: Color.TuiColor := Color.TuiColor.FromRgb(201, 209, 217);
    const Muted: Color.TuiColor := Color.TuiColor.FromRgb(139, 148, 158);
    const Border: Color.TuiColor := Color.TuiColor.FromRgb(48, 54, 61);
    const Accent: Color.TuiColor := Color.TuiColor.FromRgb(88, 166, 255);
    const Selected: Color.TuiColor := Color.TuiColor.FromRgb(31, 111, 235);
    const Success: Color.TuiColor := Color.TuiColor.FromRgb(63, 185, 80);
    const Failure: Color.TuiColor := Color.TuiColor.FromRgb(248, 81, 73);
    const Warning: Color.TuiColor := Color.TuiColor.FromRgb(210, 153, 34);
    const ButtonShortcut: Color.TuiColor := Color.TuiColor.FromRgb(255, 223, 100);
    const NormalStyle: CellsStyle.TuiStyle := CellsStyle.TuiStyle.FromColors(Text, Background);
    const SelectedStyle: CellsStyle.TuiStyle := CellsStyle.TuiStyle.FromColors(Text, Selected);
    const AccentStyle: CellsStyle.TuiStyle := CellsStyle.TuiStyle.FromColors(Accent, Background);
    var Buttons: ButtonPalette.TuiButtonPalette := ButtonPalette.TuiButtonPalette.Create(
      CellsStyle.TuiStyle.FromColors(Text, Surface),
      CellsStyle.TuiStyle.FromColors(Background, Accent),
      SelectedStyle,
      CellsStyle.TuiStyle.FromColors(Muted, Surface),
      CellsStyle.TuiStyle.FromColors(Accent, Surface),
      CellsStyle.TuiStyle.FromColors(ButtonShortcut, Accent),
      CellsStyle.TuiStyle.FromColors(ButtonShortcut, Selected)
    );
    Buttons.Primary := Some(
      TuiDefaultButtonColors(Accent, Surface, Selected, Muted, ButtonShortcut)
    );
    Buttons.Cancel := Some(TuiDefaultButtonColors(Text, Surface, Border, Muted, ButtonShortcut));
    Buttons.Warning := Some(
      TuiDefaultButtonColors(Warning, Surface, Border, Muted, ButtonShortcut)
    );
    Buttons.Dangerous := Some(
      TuiDefaultButtonColors(Failure, Surface, Border, Muted, ButtonShortcut)
    );
    const Inputs: InputPalette.TuiInputPalette := InputPalette.TuiInputPalette.Create(
      CellsStyle.TuiStyle.FromColors(Text, Surface),
      CellsStyle.TuiStyle.FromColors(Text, Color.TuiColor.FromRgb(30, 36, 44)),
      CellsStyle.TuiStyle.FromColors(Muted, Surface),
      CellsStyle.TuiStyle.FromColors(Background, Accent),
      CellsStyle.TuiStyle.FromColors(Accent, Surface)
    );
    return TuiPalette(
      Normal := NormalStyle,
      Disabled := CellsStyle.TuiStyle.FromColors(Muted, Background),
      Focused := SelectedStyle,
      Selected := SelectedStyle,
      Shortcut := AccentStyle,
      Frame := CellsStyle.TuiStyle.FromColors(Border, Background),
      Title := CellsStyle.TuiStyle.FromColors(Text, Background),
      PanelNormal := None,
      PanelTitle := None,
      PanelFocusedFrame := None,
      OverlayNormal := None,
      OverlayFrame := None,
      OverlayFocusedFrame := None,
      OverlayTitle := None,
      TabNormal := None,
      TabSelected := None,
      TabSelectedFocused := None,
      TabDisabled := None,
      MenuNormal := CellsStyle.TuiStyle.FromColors(Text, Surface),
      MenuDisabled := CellsStyle.TuiStyle.FromColors(Muted, Surface),
      MenuShortcut := CellsStyle.TuiStyle.FromColors(Accent, Surface),
      MenuSelected := SelectedStyle,
      MenuSelectedShortcut := CellsStyle.TuiStyle.FromColors(Text, Selected),
      StatusNormal := CellsStyle.TuiStyle.FromColors(Text, Surface),
      StatusDisabled := CellsStyle.TuiStyle.FromColors(Muted, Surface),
      StatusShortcut := CellsStyle.TuiStyle.FromColors(Accent, Surface),
      StatusSelected := SelectedStyle,
      Buttons := Buttons,
      Inputs := Inputs,
      Rule := CellsStyle.TuiStyle.FromColors(Border, Background),
      GaugeTrack := CellsStyle.TuiStyle.FromColors(Border, Background),
      GaugeFill := CellsStyle.TuiStyle.FromColors(Success, Background),
      Failure := CellsStyle.TuiStyle.FromColors(Failure, Background),
      Warning := CellsStyle.TuiStyle.FromColors(Warning, Background),
      Accent := AccentStyle
    );
  end function;

  // Resolves the concrete style for one semantic role.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Role`: Semantic style role used by the operation.
  public function ForRole(Self: TuiPalette; Role: StyleRole.TuiStyleRole): CellsStyle.TuiStyle;
  begin
    case Role of
      when StyleRole.TuiStyleRole.Normal:
        begin
          return Self.Normal;
        end;
      when StyleRole.TuiStyleRole.Disabled:
        begin
          return Self.Disabled;
        end;
      when StyleRole.TuiStyleRole.Focused:
        begin
          return Self.Focused;
        end;
      when StyleRole.TuiStyleRole.Selected:
        begin
          return Self.Selected;
        end;
      when StyleRole.TuiStyleRole.Shortcut:
        begin
          return Self.Shortcut;
        end;
      when StyleRole.TuiStyleRole.Frame:
        begin
          return Self.Frame;
        end;
      when StyleRole.TuiStyleRole.Title:
        begin
          return Self.Title;
        end;
      when StyleRole.TuiStyleRole.MenuNormal:
        begin
          return Self.MenuNormal;
        end;
      when StyleRole.TuiStyleRole.PanelNormal:
        return TuiContainerStyle(Self.PanelNormal, Self.Normal);
      when StyleRole.TuiStyleRole.PanelTitle:
        return TuiContainerStyle(Self.PanelTitle, Self.Title);
      when StyleRole.TuiStyleRole.PanelFocusedFrame:
        return TuiContainerStyle(Self.PanelFocusedFrame, Self.Frame);
      when StyleRole.TuiStyleRole.OverlayNormal:
        return TuiContainerStyle(Self.OverlayNormal, Self.Normal);
      when StyleRole.TuiStyleRole.OverlayFrame:
        return TuiContainerStyle(Self.OverlayFrame, Self.Frame);
      when StyleRole.TuiStyleRole.OverlayFocusedFrame:
        return TuiContainerStyle(Self.OverlayFocusedFrame, Self.Frame);
      when StyleRole.TuiStyleRole.OverlayTitle:
        return TuiContainerStyle(Self.OverlayTitle, Self.Title);
      when StyleRole.TuiStyleRole.TabNormal:
        return TuiContainerStyle(Self.TabNormal, Self.Normal);
      when StyleRole.TuiStyleRole.TabSelected:
        return TuiContainerStyle(Self.TabSelected, Self.Selected);
      when StyleRole.TuiStyleRole.TabSelectedFocused:
        return TuiContainerStyle(Self.TabSelectedFocused, Self.Focused);
      when StyleRole.TuiStyleRole.TabDisabled:
        return TuiContainerStyle(Self.TabDisabled, Self.Disabled);
      when StyleRole.TuiStyleRole.MenuDisabled:
        begin
          return Self.MenuDisabled;
        end;
      when StyleRole.TuiStyleRole.MenuShortcut:
        begin
          return Self.MenuShortcut;
        end;
      when StyleRole.TuiStyleRole.MenuSelected:
        begin
          return Self.MenuSelected;
        end;
      when StyleRole.TuiStyleRole.MenuSelectedShortcut:
        begin
          return Self.MenuSelectedShortcut;
        end;
      when StyleRole.TuiStyleRole.StatusNormal:
        begin
          return Self.StatusNormal;
        end;
      when StyleRole.TuiStyleRole.StatusDisabled:
        begin
          return Self.StatusDisabled;
        end;
      when StyleRole.TuiStyleRole.StatusShortcut:
        begin
          return Self.StatusShortcut;
        end;
      when StyleRole.TuiStyleRole.StatusSelected:
        begin
          return Self.StatusSelected;
        end;
      when StyleRole.TuiStyleRole.ButtonNormal, StyleRole.TuiStyleRole.ButtonDefault, StyleRole.TuiStyleRole.ButtonSelected, StyleRole.TuiStyleRole.ButtonDisabled, StyleRole.TuiStyleRole.ButtonShortcut, StyleRole.TuiStyleRole.ButtonDefaultShortcut, StyleRole.TuiStyleRole.ButtonSelectedShortcut:
        begin
          return Self.Buttons.ForRole(Role);
        end;
      when StyleRole.TuiStyleRole.InputNormal, StyleRole.TuiStyleRole.InputFocused, StyleRole.TuiStyleRole.InputHint, StyleRole.TuiStyleRole.InputCursor, StyleRole.TuiStyleRole.InputScroll:
        begin
          return Self.Inputs.ForRole(Role);
        end;
      when StyleRole.TuiStyleRole.Rule:
        begin
          return Self.Rule;
        end;
      when StyleRole.TuiStyleRole.GaugeTrack:
        begin
          return Self.GaugeTrack;
        end;
      when StyleRole.TuiStyleRole.GaugeFill:
        begin
          return Self.GaugeFill;
        end;
      when StyleRole.TuiStyleRole.Failure:
        begin
          return Self.Failure;
        end;
      when StyleRole.TuiStyleRole.Warning:
        begin
          return Self.Warning;
        end;
      when StyleRole.TuiStyleRole.Accent:
        begin
          return Self.Accent;
        end;
    end case;
  end function;

  // Returns a copy with one semantic role replaced.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Role`: Semantic style role used by the operation.
  // - `Style`: Concrete terminal style.
  public function WithRole(Self: TuiPalette; Role: StyleRole.TuiStyleRole; Style: CellsStyle.TuiStyle): TuiPalette;
  begin
    var Updated: TuiPalette := Self;
    case Role of
      when StyleRole.TuiStyleRole.Normal:
        begin
          Updated.Normal := Style;
        end;
      when StyleRole.TuiStyleRole.Disabled:
        begin
          Updated.Disabled := Style;
        end;
      when StyleRole.TuiStyleRole.Focused:
        begin
          Updated.Focused := Style;
        end;
      when StyleRole.TuiStyleRole.Selected:
        begin
          Updated.Selected := Style;
        end;
      when StyleRole.TuiStyleRole.Shortcut:
        begin
          Updated.Shortcut := Style;
        end;
      when StyleRole.TuiStyleRole.Frame:
        begin
          Updated.Frame := Style;
        end;
      when StyleRole.TuiStyleRole.Title:
        begin
          Updated.Title := Style;
        end;
      when StyleRole.TuiStyleRole.MenuNormal:
        begin
          Updated.MenuNormal := Style;
        end;
      when StyleRole.TuiStyleRole.PanelNormal:
        Updated.PanelNormal := Some(Style);
      when StyleRole.TuiStyleRole.PanelTitle:
        Updated.PanelTitle := Some(Style);
      when StyleRole.TuiStyleRole.PanelFocusedFrame:
        Updated.PanelFocusedFrame := Some(Style);
      when StyleRole.TuiStyleRole.OverlayNormal:
        Updated.OverlayNormal := Some(Style);
      when StyleRole.TuiStyleRole.OverlayFrame:
        Updated.OverlayFrame := Some(Style);
      when StyleRole.TuiStyleRole.OverlayFocusedFrame:
        Updated.OverlayFocusedFrame := Some(Style);
      when StyleRole.TuiStyleRole.OverlayTitle:
        Updated.OverlayTitle := Some(Style);
      when StyleRole.TuiStyleRole.TabNormal:
        Updated.TabNormal := Some(Style);
      when StyleRole.TuiStyleRole.TabSelected:
        Updated.TabSelected := Some(Style);
      when StyleRole.TuiStyleRole.TabSelectedFocused:
        Updated.TabSelectedFocused := Some(Style);
      when StyleRole.TuiStyleRole.TabDisabled:
        Updated.TabDisabled := Some(Style);
      when StyleRole.TuiStyleRole.MenuDisabled:
        begin
          Updated.MenuDisabled := Style;
        end;
      when StyleRole.TuiStyleRole.MenuShortcut:
        begin
          Updated.MenuShortcut := Style;
        end;
      when StyleRole.TuiStyleRole.MenuSelected:
        begin
          Updated.MenuSelected := Style;
        end;
      when StyleRole.TuiStyleRole.MenuSelectedShortcut:
        begin
          Updated.MenuSelectedShortcut := Style;
        end;
      when StyleRole.TuiStyleRole.StatusNormal:
        begin
          Updated.StatusNormal := Style;
        end;
      when StyleRole.TuiStyleRole.StatusDisabled:
        begin
          Updated.StatusDisabled := Style;
        end;
      when StyleRole.TuiStyleRole.StatusShortcut:
        begin
          Updated.StatusShortcut := Style;
        end;
      when StyleRole.TuiStyleRole.StatusSelected:
        begin
          Updated.StatusSelected := Style;
        end;
      when StyleRole.TuiStyleRole.ButtonNormal, StyleRole.TuiStyleRole.ButtonDefault, StyleRole.TuiStyleRole.ButtonSelected, StyleRole.TuiStyleRole.ButtonDisabled, StyleRole.TuiStyleRole.ButtonShortcut, StyleRole.TuiStyleRole.ButtonDefaultShortcut, StyleRole.TuiStyleRole.ButtonSelectedShortcut:
        begin
          Updated.Buttons := Updated.Buttons.WithRole(Role, Style);
        end;
      when StyleRole.TuiStyleRole.InputNormal, StyleRole.TuiStyleRole.InputFocused, StyleRole.TuiStyleRole.InputHint, StyleRole.TuiStyleRole.InputCursor, StyleRole.TuiStyleRole.InputScroll:
        begin
          Updated.Inputs := Updated.Inputs.WithRole(Role, Style);
        end;
      when StyleRole.TuiStyleRole.Rule:
        begin
          Updated.Rule := Style;
        end;
      when StyleRole.TuiStyleRole.GaugeTrack:
        begin
          Updated.GaugeTrack := Style;
        end;
      when StyleRole.TuiStyleRole.GaugeFill:
        begin
          Updated.GaugeFill := Style;
        end;
      when StyleRole.TuiStyleRole.Failure:
        begin
          Updated.Failure := Style;
        end;
      when StyleRole.TuiStyleRole.Warning:
        begin
          Updated.Warning := Style;
        end;
      when StyleRole.TuiStyleRole.Accent:
        begin
          Updated.Accent := Style;
        end;
    end case;

    return Updated;
  end function;
end record;
end unit;
