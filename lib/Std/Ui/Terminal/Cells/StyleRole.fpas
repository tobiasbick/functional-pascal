unit Std.Ui.Terminal.Cells.StyleRole;

// Semantic style role resolved through `TuiPalette`.
public type TuiStyleRole = enum
  // Represents the `Normal` variant of `TuiStyleRole`.
  Normal;
  // Represents the `Disabled` variant of `TuiStyleRole`.
  Disabled;
  // Represents the `Focused` variant of `TuiStyleRole`.
  Focused;
  // Represents the `Selected` variant of `TuiStyleRole`.
  Selected;
  // Represents the `Shortcut` variant of `TuiStyleRole`.
  Shortcut;
  // Represents the `Frame` variant of `TuiStyleRole`.
  Frame;
  // Represents the `Title` variant of `TuiStyleRole`.
  Title;
  // Normal text and background inside a panel.
  PanelNormal;
  // Panel title on its surface.
  PanelTitle;
  // Frame of a panel containing the focused control.
  PanelFocusedFrame;
  // Normal text and background inside an overlay.
  OverlayNormal;
  // Frame of an inactive overlay.
  OverlayFrame;
  // Frame of the active overlay.
  OverlayFocusedFrame;
  // Overlay title on its surface.
  OverlayTitle;
  // Tab label in its ordinary state.
  TabNormal;
  // Selected tab without keyboard focus.
  TabSelected;
  // Selected tab whose bar owns keyboard focus.
  TabSelectedFocused;
  // Tab that cannot be selected.
  TabDisabled;
  // Represents the `MenuNormal` variant of `TuiStyleRole`.
  MenuNormal;
  // Represents the `MenuDisabled` variant of `TuiStyleRole`.
  MenuDisabled;
  // Represents the `MenuShortcut` variant of `TuiStyleRole`.
  MenuShortcut;
  // Represents the `MenuSelected` variant of `TuiStyleRole`.
  MenuSelected;
  // Represents the `MenuSelectedShortcut` variant of `TuiStyleRole`.
  MenuSelectedShortcut;
  // Represents the `StatusNormal` variant of `TuiStyleRole`.
  StatusNormal;
  // Represents the `StatusDisabled` variant of `TuiStyleRole`.
  StatusDisabled;
  // Represents the `StatusShortcut` variant of `TuiStyleRole`.
  StatusShortcut;
  // Represents the `StatusSelected` variant of `TuiStyleRole`.
  StatusSelected;
  // Represents the `ButtonNormal` variant of `TuiStyleRole`.
  ButtonNormal;
  // Represents the `ButtonDefault` variant of `TuiStyleRole`.
  ButtonDefault;
  // Represents the `ButtonSelected` variant of `TuiStyleRole`.
  ButtonSelected;
  // Represents the `ButtonDisabled` variant of `TuiStyleRole`.
  ButtonDisabled;
  // Represents the `ButtonShortcut` variant of `TuiStyleRole`.
  ButtonShortcut;
  // Represents the `ButtonDefaultShortcut` variant of `TuiStyleRole`.
  ButtonDefaultShortcut;
  // Represents the `ButtonSelectedShortcut` variant of `TuiStyleRole`.
  ButtonSelectedShortcut;
  // Represents the `InputNormal` variant of `TuiStyleRole`.
  InputNormal;
  // Represents the `InputFocused` variant of `TuiStyleRole`.
  InputFocused;
  // Represents the `InputHint` variant of `TuiStyleRole`.
  InputHint;
  // Represents the `InputCursor` variant of `TuiStyleRole`.
  InputCursor;
  // Represents the `InputScroll` variant of `TuiStyleRole`.
  InputScroll;
  // Represents the `Rule` variant of `TuiStyleRole`.
  Rule;
  // Represents the `GaugeTrack` variant of `TuiStyleRole`.
  GaugeTrack;
  // Represents the `GaugeFill` variant of `TuiStyleRole`.
  GaugeFill;
  // Represents the `Failure` variant of `TuiStyleRole`.
  Failure;
  // Represents the `Warning` variant of `TuiStyleRole`.
  Warning;
  // Represents the `Accent` variant of `TuiStyleRole`.
  Accent;
end enum;
end unit;
