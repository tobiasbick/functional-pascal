unit Std.Ui.Terminal.Chrome.Button;

uses Std.Ui.Terminal.Ids.Action as IdsAction, Std.Ui.Terminal.Ids.ControlId as ControlId;

// Semantic purpose, independent of focus or default-action behavior.
public type TuiButtonKind = enum
  Normal;
  Primary;
  Cancel;
  Warning;
  Dangerous;
end enum;

// Current visual interaction state, resolved together with the button kind.
public type TuiButtonState = enum
  Normal;
  Active;
  Focused;
  Pressed;
  Disabled;
end enum;

// Theme lookup key carried by rendered button cells.
public type TuiButtonAppearance = record
  public Kind: TuiButtonKind;
  public State: TuiButtonState;
  public Default: boolean;
  public Shortcut: boolean;
end record;

// Immutable description of one flat terminal button.
public type TuiButtonSpec = record
  // Stable identifier of the value.
  public Id: ControlId.TuiControlId;
  // Text stored or displayed by the value.
  public Text: string;
  // Keyboard mnemonic used to activate the item.
  public Mnemonic: string;
  // Application action associated with the value.
  public Action: IdsAction.TuiAction;
  // Style used for the default state.
  public Default: boolean;
  // Marks a persistent choice without making it the default action.
  public Active: boolean := false;
  // Meaning used by the theme, independently of keyboard behavior.
  public Kind: TuiButtonKind := TuiButtonKind.Normal;
  // Whether the item can be activated.
  public Enabled: boolean;

  // Creates an enabled normal button.
  //
  // Parameters:
  // - `Id`: Identifier assigned to the created or selected value.
  // - `Text`: Text processed or displayed by the operation.
  // - `Mnemonic`: Keyboard mnemonic used to activate the item.
  // - `Action`: Application action associated with the control or emitted message.
  public static function Normal(
    Id: ControlId.TuiControlId;
    Text: string;
    Mnemonic: string;
    Action: IdsAction.TuiAction
  ): TuiButtonSpec;
  begin
    return TuiButtonSpec(
      Id := Id,
      Text := Text,
      Mnemonic := Mnemonic,
      Action := Action,
      Default := false,
      Enabled := true
    );
  end function;

  // Creates an enabled default button.
  //
  // Parameters:
  // - `Id`: Identifier assigned to the created or selected value.
  // - `Text`: Text processed or displayed by the operation.
  // - `Mnemonic`: Keyboard mnemonic used to activate the item.
  // - `Action`: Application action associated with the control or emitted message.
  public static function DefaultButton(
    Id: ControlId.TuiControlId;
    Text: string;
    Mnemonic: string;
    Action: IdsAction.TuiAction
  ): TuiButtonSpec;
  begin
    return TuiButtonSpec(
      Id := Id,
      Text := Text,
      Mnemonic := Mnemonic,
      Action := Action,
      Default := true,
      Enabled := true
    );
  end function;

  // Creates a disabled normal button.
  //
  // Parameters:
  // - `Id`: Identifier assigned to the created or selected value.
  // - `Text`: Text processed or displayed by the operation.
  // - `Mnemonic`: Keyboard mnemonic used to activate the item.
  // - `Action`: Application action associated with the control or emitted message.
  public static function Disabled(
    Id: ControlId.TuiControlId;
    Text: string;
    Mnemonic: string;
    Action: IdsAction.TuiAction
  ): TuiButtonSpec;
  begin
    return TuiButtonSpec(
      Id := Id,
      Text := Text,
      Mnemonic := Mnemonic,
      Action := Action,
      Default := false,
      Enabled := false
    );
  end function;
end record;
end unit;
