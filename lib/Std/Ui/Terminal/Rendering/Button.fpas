// Flat modern button painting.
unit Std.Ui.Terminal.Rendering.Button;

uses
  Std.Console as Console, Std.Ui.Terminal.Cells.Cell as Cell, Std.Ui.Terminal.Cells.StyleRole as StyleRole,
  Std.Ui.Terminal.Chrome.Button as ChromeButton, Std.Ui.Terminal.Geometry.Point as Point,
  Std.Ui.Terminal.Geometry.Rect as Rect, Std.Ui.Terminal.Rendering.Canvas as RenderingCanvas;

procedure TuiPaintButtonText(
  Canvas: RenderingCanvas.TuiCanvas;
  Position: Point.TuiPoint;
  Button: ChromeButton.TuiButtonSpec;
  Role: StyleRole.TuiStyleRole;
  ShortcutRole: StyleRole.TuiStyleRole;
  Appearance: ChromeButton.TuiButtonAppearance
);
begin
  var X: integer := Position.X;
  for Glyph: string in Console.SplitGraphemes(Button.Text) do
    begin
      if Glyph = string.Chr(10) then
        return;
      end if;
      var GlyphRole: StyleRole.TuiStyleRole := Role;
      const IsShortcut := (Button.Mnemonic <> '') and (Glyph.ToLower() = Button.Mnemonic.ToLower());
      if IsShortcut then
        begin
          GlyphRole := ShortcutRole;
        end;
      end if;

      Canvas.PutCell(
        Point.TuiPoint.Create(X, Position.Y),
        Cell.TuiCell.Create(Glyph, GlyphRole) with ButtonAppearance := Some(
          Appearance with Shortcut := IsShortcut; end with
        ); end with
      );
      X := X + Console.DisplayWidth(Glyph);
    end;
  end for;
end procedure;

function TuiButtonRole(Button: ChromeButton.TuiButtonSpec; Focused: boolean): StyleRole.TuiStyleRole;
begin
  if not Button.Enabled then
    begin
      return StyleRole.TuiStyleRole.ButtonDisabled;
    end;
  end if;

  if Focused then
    begin
      return StyleRole.TuiStyleRole.ButtonSelected;
    end;
  end if;

  if Button.Default or Button.Active then
    begin
      return StyleRole.TuiStyleRole.ButtonDefault;
    end;
  end if;

  return StyleRole.TuiStyleRole.ButtonNormal;
end function;

function TuiButtonShortcutRole(Button: ChromeButton.TuiButtonSpec; Focused: boolean): StyleRole.TuiStyleRole;
begin
  if not Button.Enabled then
    begin
      return StyleRole.TuiStyleRole.ButtonDisabled;
    end;
  end if;

  if Focused then
    begin
      return StyleRole.TuiStyleRole.ButtonSelectedShortcut;
    end;
  end if;

  if Button.Default or Button.Active then
    begin
      return StyleRole.TuiStyleRole.ButtonDefaultShortcut;
    end;
  end if;

  return StyleRole.TuiStyleRole.ButtonShortcut;
end function;

// Paints a compact one-row button.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Button`: Button specification used by the operation.
// - `Focused`: Whether the control currently owns focus.
// - `Pressed`: Whether the control is displayed as pressed.
public procedure TuiPaintButton(
  Canvas: RenderingCanvas.TuiCanvas;
  Bounds: Rect.TuiRect;
  Button: ChromeButton.TuiButtonSpec;
  Focused: boolean;
  Pressed: boolean
);
begin
  if Bounds.IsEmpty() then
    begin
      return;
    end;
  end if;
  var Role: StyleRole.TuiStyleRole := TuiButtonRole(Button, Focused);
  var ShortcutRole: StyleRole.TuiStyleRole := TuiButtonShortcutRole(Button, Focused);
  const ContentWidth: integer := Bounds.Width;
  const TextWidth: integer := Console.DisplayWidth(Button.Text);
  var Left: integer := Bounds.X + ((ContentWidth - TextWidth) div 2);
  if Left < Bounds.X then
    Left := Bounds.X;
  end if;

  if Pressed and Button.Enabled then
    begin
      Role := StyleRole.TuiStyleRole.ButtonSelected;
      ShortcutRole := StyleRole.TuiStyleRole.ButtonSelectedShortcut;
    end;
  end if;
  var State := ChromeButton.TuiButtonState.Normal;
  if Button.Active then
    State := ChromeButton.TuiButtonState.Active;
  end if;

  if Focused then
    State := ChromeButton.TuiButtonState.Focused;
  end if;

  if Pressed then
    State := ChromeButton.TuiButtonState.Pressed;
  end if;

  if not Button.Enabled then
    State := ChromeButton.TuiButtonState.Disabled;
  end if;
  const Appearance := ChromeButton.TuiButtonAppearance(
    Kind := Button.Kind, State := State,
    Default := Button.Default, Shortcut := false
  );
  Canvas.FillRect(
    Bounds,
    Cell.TuiCell.Create(' ', Role) with ButtonAppearance := Some(Appearance); end with
  );
  const Clipped := Canvas.Child(Bounds);
  TuiPaintButtonText(
    Clipped,
    Point.TuiPoint.Create(Left - Bounds.X, 0),
    Button,
    Role,
    ShortcutRole,
    Appearance
  );
end procedure;
end unit;
