unit Std.Ui.Terminal.Rendering.Canvas;

uses
  Std.Console as Console, Std.Ui.Terminal.Cells.Cell as CellsCell, Std.Ui.Terminal.Cells.StyleRole as StyleRole,
  Std.Ui.Terminal.Geometry.Point as Point, Std.Ui.Terminal.Geometry.Rect as Rect,
  Std.Ui.Terminal.Geometry.Size as GeometrySize, Std.Ui.Terminal.Rendering.Surface as RenderingSurface;

// Private frame-scoped drawing capability over one working surface.
public type TuiCanvas = record
  // Working surface targeted by the canvas.
  public Surface: RenderingSurface.TuiWorkingSurface;
  // Clipping rectangle in surface coordinates.
  public Clip: Rect.TuiRect;
  // Canvas origin in surface coordinates.
  public Origin: Point.TuiPoint;
  // Semantic normal role inherited by cells on this surface.
  public SurfaceRole: StyleRole.TuiStyleRole := StyleRole.TuiStyleRole.Normal;
  // Whether the current desktop child is the topmost overlay.
  public ActiveOverlay: boolean := false;

  // Creates a canvas clipped to `Bounds` intersected with the surface.
  //
  // Parameters:
  // - `Surface`: Working surface affected by the operation.
  // - `Bounds`: Rectangle affected by the operation.
  public static function Create(Surface: RenderingSurface.TuiWorkingSurface; Bounds: Rect.TuiRect): TuiCanvas;
  begin
    const Size: GeometrySize.TuiSize := Surface.Size();
    const SurfaceBounds: Rect.TuiRect := Rect.TuiRect.Create(0, 0, Size.Width, Size.Height);
    return TuiCanvas(
      Surface := Surface,
      Clip := Bounds.Intersect(SurfaceBounds),
      Origin := Point.TuiPoint.Create(0, 0)
    );
  end function;

  // Creates a canvas with an explicit surface origin and local clip rectangle.
  //
  // Parameters:
  // - `Surface`: Working surface affected by the operation.
  // - `Origin`: Canvas origin in surface coordinates.
  // - `Clip`: Clipping rectangle for drawing.
  public static function CreateLocal(
    Surface: RenderingSurface.TuiWorkingSurface;
    Origin: Point.TuiPoint;
    Clip: Rect.TuiRect
  ): TuiCanvas;
  begin
    return TuiCanvas(Surface := Surface, Clip := Clip, Origin := Origin);
  end function;

  // Returns a nested canvas for `LocalBounds` in this canvas's local coordinates.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `LocalBounds`: Bounds expressed in the parent canvas coordinate system.
  public function Child(Self: TuiCanvas; LocalBounds: Rect.TuiRect): TuiCanvas;
  begin
    const Visible: Rect.TuiRect := LocalBounds.Intersect(Self.Clip);
    const ChildClip: Rect.TuiRect := Rect.TuiRect.Create(
      Visible.X - LocalBounds.X, Visible.Y -
      LocalBounds.Y, Visible.Width, Visible.Height
    );
    return TuiCanvas.CreateLocal(
      Self.Surface, Point.TuiPoint.Create(
        Self.Origin.X + LocalBounds.X, Self.Origin.Y +
        LocalBounds.Y
      ), ChildClip
    ) with SurfaceRole := Self.SurfaceRole; ActiveOverlay := Self.ActiveOverlay; end with;
  end function;

  // Resolves ordinary semantic cells against the enclosing surface without changing concrete cells.
  public function SurfaceCell(Self: TuiCanvas; Cell: CellsCell.TuiCell): CellsCell.TuiCell;
  begin
    if (Cell.Role = StyleRole.TuiStyleRole.Normal) and (Cell.ConcreteStyle is None) then
      return Cell with Role := Self.SurfaceRole; end with;
    end if;

    return Cell;
  end function;

  // Paints one cell in local coordinates; clipped and wide-glyph aware.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Position`: Position in terminal-cell coordinates.
  // - `Cell`: Terminal cell written by the operation.
  public procedure PutCell(Self: TuiCanvas; Position: Point.TuiPoint; Cell: CellsCell.TuiCell);
  begin
    if not Self.Clip.Contains(Position) then
      begin
        return;
      end;
    end if;
    const CellWidth: integer := Cell.Width();
    if (CellWidth = 2)
      and
      not Self.Clip.Contains(Point.TuiPoint.Create(Position.X + 1, Position.Y))
    then
      begin
        Self.Surface.PutCell(
          Point.TuiPoint.Create(
            Self.Origin.X + Position.X, Self.Origin.Y +
            Position.Y
          ), Self.SurfaceCell(CellsCell.TuiCell.Create(' ', StyleRole.TuiStyleRole.Normal))
        );
        return;
      end;
    end if;

    Self.Surface.PutCell(
      Point.TuiPoint.Create(
        Self.Origin.X + Position.X, Self.Origin.Y +
        Position.Y
      ), Self.SurfaceCell(Cell)
    );
  end procedure;

  // Paints one glyph with the normal role.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `X`: Zero-based horizontal terminal-cell coordinate.
  // - `Y`: Zero-based vertical terminal-cell coordinate.
  // - `Glyph`: Single renderable grapheme.
  public procedure PutGlyph(Self: TuiCanvas; X: integer; Y: integer; Glyph: string);
  begin
    Self.PutCell(
      Point.TuiPoint.Create(X, Y),
      CellsCell.TuiCell.Create(Glyph, StyleRole.TuiStyleRole.Normal)
    );
  end procedure;

  // Fills the visible intersection with a one-column cell.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Bounds`: Rectangle affected by the operation.
  // - `Cell`: Terminal cell written by the operation.
  public procedure FillRect(Self: TuiCanvas; Bounds: Rect.TuiRect; Cell: CellsCell.TuiCell);
  begin
    const CellWidth: integer := Cell.Width();
    if CellWidth <> 1 then
      begin
        panic('Tui canvas FillRect requires a one-column cell');
      end;
    end if;
    const Visible: Rect.TuiRect := Bounds.Intersect(Self.Clip);
    RenderingSurface.TuiSurfaceFillRect(
      Self.Surface, Rect.TuiRect.Create(
        Self.Origin.X + Visible.X, Self.Origin.Y +
        Visible.Y, Visible.Width, Visible.Height
      ), Self.SurfaceCell(Cell)
    );
  end procedure;

  // Draws one logical line of text; stops before a newline.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Position`: Position in terminal-cell coordinates.
  // - `Text`: Text processed or displayed by the operation.
  // - `Role`: Semantic style role used by the operation.
  public procedure WriteText(
    Self: TuiCanvas;
    Position: Point.TuiPoint;
    Text: string;
    Role: StyleRole.TuiStyleRole
  );
  begin
    var X: integer := Position.X;
    var AsciiOnly: boolean := true;
    const TextLength: integer := Text.Length();
    for Index: integer := 0 to TextLength - 1 do
      begin
        const Code: integer := Text[Index].Ord();
        if (Code <> 10) and ((Code < 32) or (Code > 126)) then
          begin
            AsciiOnly := false;
          end;
        end if;
      end;
    end for;

    if AsciiOnly then
      begin
        for Index: integer := 0 to TextLength - 1 do
          begin
            const Glyph: string := Text[Index];
            if Glyph = string.Chr(10) then
              begin
                return;
              end;
            end if;

            Self.PutCell(
              Point.TuiPoint.Create(X, Position.Y),
              CellsCell.TuiCell.Create(Glyph, Role)
            );
            X := X + 1;
          end;
        end for;

        return;
      end;
    end if;

    for Glyph: string in Console.SplitGraphemes(Text) do
      begin
        if Glyph = string.Chr(10) then
          begin
            return;
          end;
        end if;
        const GlyphWidth: integer := Console.DisplayWidth(Glyph);
        if GlyphWidth > 0 then
          begin
            Self.PutCell(
              Point.TuiPoint.Create(X, Position.Y),
              CellsCell.TuiCell.Create(Glyph, Role)
            );
            X := X + GlyphWidth;
          end;
        end if;
      end;
    end for;
  end procedure;

  // Draws a horizontal box-drawing line.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `X`: Zero-based horizontal terminal-cell coordinate.
  // - `Y`: Zero-based vertical terminal-cell coordinate.
  // - `Width`: Width in terminal cells.
  // - `Role`: Semantic style role used by the operation.
  public procedure DrawHorizontalLine(
    Self: TuiCanvas;
    X: integer;
    Y: integer;
    Width: integer;
    Role: StyleRole.TuiStyleRole
  );
  begin
    if (Width <= 0) or (Y < Self.Clip.Y) or (Y >= Self.Clip.Bottom()) then
      return;
    end if;
    const Visible := Rect.TuiRect.Create(X, Y, Width, 1).Intersect(Self.Clip);
    const Cell: CellsCell.TuiCell := CellsCell.TuiCell.Create('─', Role);
    for Offset: integer := 0 to Visible.Width - 1 do
      begin
        Self.PutCell(Point.TuiPoint.Create(Visible.X + Offset, Y), Cell);
      end;
    end for;
  end procedure;

  // Draws a vertical box-drawing line.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `X`: Zero-based horizontal terminal-cell coordinate.
  // - `Y`: Zero-based vertical terminal-cell coordinate.
  // - `Height`: Height in terminal cells.
  // - `Role`: Semantic style role used by the operation.
  public procedure DrawVerticalLine(
    Self: TuiCanvas;
    X: integer;
    Y: integer;
    Height: integer;
    Role: StyleRole.TuiStyleRole
  );
  begin
    if (Height <= 0) or (X < Self.Clip.X) or (X >= Self.Clip.Right()) then
      return;
    end if;
    const Visible := Rect.TuiRect.Create(X, Y, 1, Height).Intersect(Self.Clip);
    const Cell: CellsCell.TuiCell := CellsCell.TuiCell.Create('│', Role);
    for Offset: integer := 0 to Visible.Height - 1 do
      begin
        Self.PutCell(Point.TuiPoint.Create(X, Visible.Y + Offset), Cell);
      end;
    end for;
  end procedure;

  // Draws a box frame using Unicode box-drawing glyphs.
  //
  // Parameters:
  // - `Self`: Receiver value operated on by the method.
  // - `Bounds`: Rectangle affected by the operation.
  // - `Role`: Semantic style role used by the operation.
  public procedure DrawFrame(Self: TuiCanvas; Bounds: Rect.TuiRect; Role: StyleRole.TuiStyleRole);
  begin
    if Bounds.IsEmpty() then
      begin
        return;
      end;
    end if;

    if Bounds.Width = 1 then
      begin
        Self.DrawVerticalLine(Bounds.X, Bounds.Y, Bounds.Height, Role);
        Self.PutCell(
          Point.TuiPoint.Create(Bounds.X, Bounds.Y),
          CellsCell.TuiCell.Create('╭', Role)
        );
        if Bounds.Height > 1 then
          begin
            Self.PutCell(
              Point.TuiPoint.Create(Bounds.X, Bounds.Bottom() - 1),
              CellsCell.TuiCell.Create('╰', Role)
            );
          end;
        end if;

        return;
      end;
    end if;

    if Bounds.Height = 1 then
      begin
        Self.DrawHorizontalLine(Bounds.X, Bounds.Y, Bounds.Width, Role);
        Self.PutCell(
          Point.TuiPoint.Create(Bounds.X, Bounds.Y),
          CellsCell.TuiCell.Create('╭', Role)
        );
        Self.PutCell(
          Point.TuiPoint.Create(Bounds.Right() - 1, Bounds.Y),
          CellsCell.TuiCell.Create('╮', Role)
        );
        return;
      end;
    end if;

    Self.DrawHorizontalLine(Bounds.X, Bounds.Y, Bounds.Width, Role);
    Self.DrawHorizontalLine(Bounds.X, Bounds.Bottom() - 1, Bounds.Width, Role);
    Self.DrawVerticalLine(Bounds.X, Bounds.Y + 1, Bounds.Height - 2, Role);
    Self.DrawVerticalLine(Bounds.Right() - 1, Bounds.Y + 1, Bounds.Height - 2, Role);
    Self.PutCell(Point.TuiPoint.Create(Bounds.X, Bounds.Y), CellsCell.TuiCell.Create('╭', Role));
    Self.PutCell(
      Point.TuiPoint.Create(Bounds.Right() - 1, Bounds.Y),
      CellsCell.TuiCell.Create('╮', Role)
    );
    Self.PutCell(
      Point.TuiPoint.Create(Bounds.X, Bounds.Bottom() - 1),
      CellsCell.TuiCell.Create('╰', Role)
    );
    Self.PutCell(
      Point.TuiPoint.Create(Bounds.Right() - 1, Bounds.Bottom() - 1),
      CellsCell.TuiCell.Create('╯', Role)
    );
  end procedure;
end record;

// Paints consecutive cells in local coordinates with canvas clipping.
public procedure TuiCanvasPutCells(
  Canvas: TuiCanvas;
  Position: Point.TuiPoint;
  Cells: array of CellsCell.TuiCell
);
begin
  if (Position.Y < Canvas.Clip.Y) or (Position.Y >= Canvas.Clip.Bottom()) then
    begin
      return;
    end;
  end if;
  var SourceX: integer := 0;
  var TargetX: integer := Position.X;
  if TargetX < Canvas.Clip.X then
    begin
      SourceX := Canvas.Clip.X - TargetX;
      TargetX := Canvas.Clip.X;
    end;
  end if;
  var Count: integer := Cells.Length() - SourceX;
  if Count > Canvas.Clip.Right() - TargetX then
    begin
      Count := Canvas.Clip.Right() - TargetX;
    end;
  end if;

  if Count <= 0 then
    begin
      return;
    end;
  end if;
  var Values: array of CellsCell.TuiCell := Cells.Slice(SourceX, Count);
  if (TargetX + Count = Canvas.Clip.Right()) and (Values[Count - 1].Columns = 2) then
    begin
      Values[Count - 1] := CellsCell.TuiCell.Create(' ', StyleRole.TuiStyleRole.Normal);
    end;
  end if;

  for Index: integer := 0 to Values.Length() - 1 do
    if (Values[Index].Role = StyleRole.TuiStyleRole.Normal)
      and
      (Values[Index].ConcreteStyle is None)
      and
      (Canvas.SurfaceRole <> StyleRole.TuiStyleRole.Normal)
    then
      Values[Index] := Canvas.SurfaceCell(Values[Index]);
    end if;
  end for;

  RenderingSurface.TuiSurfacePutCells(
    Canvas.Surface, Point.TuiPoint.Create(
      Canvas.Origin.X +
      TargetX, Canvas.Origin.Y +
      Position.Y
    ), Values
  );
end procedure;
end unit;
