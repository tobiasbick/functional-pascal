// Cell-grid painting.
unit Std.Ui.Terminal.Rendering.CellGrid;

uses
  Std.Ui.Terminal.Chrome.CellGrid as CellGrid, Std.Ui.Terminal.Geometry.Point as Point,
  Std.Ui.Terminal.Geometry.Rect as Rect, Std.Ui.Terminal.Rendering.Canvas as RenderingCanvas;

// Paints the visible part of a row-major terminal cell grid.
//
// Parameters:
// - `Canvas`: Canvas that receives the drawing operation.
// - `Bounds`: Rectangle affected by the operation.
// - `Grid`: Cell grid to paint.
public procedure TuiPaintCellGrid(
  Canvas: RenderingCanvas.TuiCanvas;
  Bounds: Rect.TuiRect;
  Grid: CellGrid.TuiCellGrid
);
begin
  var Width: integer := Grid.Width;
  var Height: integer := Grid.Height;
  if Width > Bounds.Width then
    begin
      Width := Bounds.Width;
    end;
  end if;

  if Height > Bounds.Height then
    begin
      Height := Bounds.Height;
    end;
  end if;
  var FirstRow := Canvas.Clip.Y - Bounds.Y;
  if FirstRow < 0 then
    FirstRow := 0;
  end if;
  var EndRow := Canvas.Clip.Bottom() - Bounds.Y;
  if EndRow > Height then
    EndRow := Height;
  end if;

  for Y: integer := FirstRow to EndRow - 1 do
    begin
      RenderingCanvas.TuiCanvasPutCells(
        Canvas, Point.TuiPoint.Create(Bounds.X, Bounds.Y + Y), Grid.Cells.Slice(
          Y *
          Grid.Width, Width
        )
      );
    end;
  end for;
end procedure;
end unit;
