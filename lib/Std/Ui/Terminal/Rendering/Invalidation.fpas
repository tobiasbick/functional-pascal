unit Std.Ui.Terminal.Rendering.Invalidation;

uses
  Std.Ui.Terminal.Elements.Element as Element, Std.Ui.Terminal.Elements.Tree as Tree,
  Std.Ui.Terminal.Geometry.Rect as Rect, Std.Ui.Terminal.Layout.Frame as Frame;

type TuiNodePair = enum
  Nodes(Previous: Element.TuiElement; Current: Element.TuiElement);
end enum;

procedure TuiInvalidateBounds(Bounds: Rect.TuiRect; var Rows: array of boolean);
begin
  for Y: integer := Bounds.Y to Bounds.Bottom() - 1 do
    Rows[Y] := true;
  end for;
end procedure;

function TuiInvalidateNode(
  Previous: Element.TuiElement; Current: Element.TuiElement;
  Arranged: Frame.TuiArrangedFrame; Index: integer; var Rows: array of boolean
): integer;
begin
  const Entry := Arranged.EntryAt(Index);
  if Tree.TuiElementSameTree(Previous, Current) then
    return Entry.SubtreeEnd;
  end if;

  if not Tree.TuiElementSameLocal(Previous, Current) then
    case TuiNodePair.Nodes(Previous, Current) of
      when TuiNodePair.Nodes(Element.TuiElement.Menu(_, _, _, _), Element.TuiElement.Menu(_, _, _, _)):
        for Y: integer := 0 to Rows.Length() - 1 do
          Rows[Y] := true;
        end for;
      when TuiNodePair.Nodes(Element.TuiElement.CellGrid(const A), Element.TuiElement.CellGrid(const B)):
        var Width := B.Width;
        if Width > Entry.Bounds.Width then
          Width := Entry.Bounds.Width;
        end if;
        var Height := B.Height;
        if Height > Entry.Bounds.Height then
          Height := Entry.Bounds.Height;
        end if;

        for Y: integer := 0 to Height - 1 do
          const SurfaceY := Entry.Bounds.Y + Y;
          if (SurfaceY >= Entry.Clip.Y) and (SurfaceY < Entry.Clip.Bottom()) then
            if not Tree.TuiSameItems(
              A.Cells.Slice(Y * A.Width, Width),
              B.Cells.Slice(Y * B.Width, Width)
            )
            then
              Rows[SurfaceY] := true;
            end if;
          end if;
        end for;
      when TuiNodePair.Nodes(Element.TuiElement.Panel(_, _), Element.TuiElement.Panel(_, _)), TuiNodePair.Nodes(Element.TuiElement.Overlay(_, _), Element.TuiElement.Overlay(_, _)):
        if (Entry.Clip.Width > 0) and (Entry.Bounds.Y >= Entry.Clip.Y)
          and
          (Entry.Bounds.Y < Entry.Clip.Bottom())
        then
          Rows[Entry.Bounds.Y] := true;
        end if;
      when TuiNodePair.Nodes(_, _):
        TuiInvalidateBounds(Entry.Clip, var Rows);
    end case;
  end if;
  const OldChildren := Tree.TuiElementChildren(Previous);
  const Children := Tree.TuiElementChildren(Current);
  var Next := Index + 1;
  for I: integer := 0 to Children.Length() - 1 do
    Next := TuiInvalidateNode(OldChildren[I], Children[I], Arranged, Next, var Rows);
  end for;

  return Next;
end function;

// Layout keys must match: node kinds, child order and arranged entry indices are stable.
public function TuiInvalidatedRows(
  Previous: Element.TuiElement; Current: Element.TuiElement;
  Arranged: Frame.TuiArrangedFrame; Height: integer
): array of boolean;
begin
  var Rows := array.Fill(false, Height);
  discard TuiInvalidateNode(Previous, Current, Arranged, 0, var Rows);
  return Rows;
end function;
end unit;
