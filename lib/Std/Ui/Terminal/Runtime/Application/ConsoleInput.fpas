unit Std.Ui.Terminal.Runtime.Application.ConsoleInput;

uses
  Std.Tasks as Tasks, Std.Time as Time, Std.Ui.Terminal.Geometry.Size as GeometrySize,
  Std.Ui.Terminal.Runtime.ConsoleEvents as ConsoleEvents, Std.Ui.Terminal.Runtime.Input as RuntimeInput;

const TuiResizeSettleMilliseconds: integer := 50;

function TuiConsoleInputSend(
  Token: Tasks.CancellationToken;
  Output: channel of RuntimeInput.TuiHostInput;
  Input: RuntimeInput.TuiHostInput
): boolean;
begin
  return (Tasks.SendWithCancellation(Output, Input, Token) is Error(_));
end function;

function TuiConsoleInputSettleResize(
  Token: Tasks.CancellationToken;
  Output: channel of RuntimeInput.TuiHostInput;
  InitialSize: GeometrySize.TuiSize
): boolean;
begin
  var LatestSize: GeometrySize.TuiSize := InitialSize;
  while not Tasks.IsCancellationRequested(Token) do
    begin
      case ConsoleEvents.TuiReadConsoleHostInputWithTimeout(TuiResizeSettleMilliseconds) of
        when Some(const Input):
          begin
            case Input of
              when RuntimeInput.TuiHostInput.Resize(const Size):
                begin
                  LatestSize := Size;
                  Time.Sleep(0);
                end;
              when RuntimeInput.TuiHostInput.Message(_), RuntimeInput.TuiHostInput.Key(_), RuntimeInput.TuiHostInput.Pointer(_):
                begin
                  if TuiConsoleInputSend(
                    Token,
                    Output,
                    RuntimeInput.TuiHostInput.Resize(LatestSize)
                  )
                  then
                    begin
                      return true;
                    end;
                  end if;

                  return TuiConsoleInputSend(Token, Output, Input);
                end;
            end case;
          end;
        when None:
          begin
            return TuiConsoleInputSend(Token, Output, RuntimeInput.TuiHostInput.Resize(LatestSize));
          end;
      end case;
    end;
  end while;

  return true;
end function;

// Pumps Console input while collapsing a resize burst after a quiet period.
//
// Parameters:
// - `Token`: Cancellation token owned by the interactive application.
// - `Output`: Destination for normalized host input.
public function TuiConsoleInputPump(
  Token: Tasks.CancellationToken;
  Output: channel of RuntimeInput.TuiHostInput
): result of (boolean, string);
begin
  while not Tasks.IsCancellationRequested(Token) do
    begin
      case ConsoleEvents.TuiReadConsoleHostInputWithTimeout(TuiResizeSettleMilliseconds) of
        when Some(const Input):
          begin
            case Input of
              when RuntimeInput.TuiHostInput.Resize(const Size):
                begin
                  if TuiConsoleInputSettleResize(Token, Output, Size) then
                    begin
                      return Ok(true);
                    end;
                  end if;
                end;
              when RuntimeInput.TuiHostInput.Message(_), RuntimeInput.TuiHostInput.Key(_), RuntimeInput.TuiHostInput.Pointer(_):
                begin
                  if TuiConsoleInputSend(Token, Output, Input) then
                    begin
                      return Ok(true);
                    end;
                  end if;
                end;
            end case;
          end;
        when None:
          begin
          end;
      end case;

      // Release the pool worker even when Console polling returns no event.
      Time.Sleep(0);
    end;
  end while;

  return Ok(true);
end function;
end unit;
