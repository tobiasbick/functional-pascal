unit Std.Ui.Terminal.Runtime.Frame;

uses
  Std.Ui.Terminal.Elements.Element as Element, Std.Ui.Terminal.Elements.Validate as Validate, Std.Ui.Terminal.Elements.Tree as Tree,
  Std.Ui.Terminal.Geometry.Rect as Rect, Std.Ui.Terminal.Geometry.Size as Size, Std.Ui.Terminal.Ids.ControlId as ControlId,
  Std.Ui.Terminal.Layout.Arrange as Arrange, Std.Ui.Terminal.Layout.Frame as LayoutFrame,
  Std.Ui.Terminal.Rendering.Paint as Paint, Std.Ui.Terminal.Rendering.Surface as RenderingSurface,
  Std.Ui.Terminal.Layout.Key as Key, Std.Ui.Terminal.Rendering.Invalidation as Invalidation;

// One last successful tree, bounded geometry cache and reusable staging frame per host.
public type TuiRenderState = record
  public Ready: boolean;
  public Tree: Element.TuiElement;
  public Frame: LayoutFrame.TuiArrangedFrame;
  public WorkFrame: LayoutFrame.TuiArrangedFrame;
  public Size: Size.TuiSize;
  public Pressed: option of ControlId.TuiControlId;
  public LayoutKey: array of Key.TuiLayoutToken;

  public static function Create(): TuiRenderState;
  begin
    return TuiRenderState(
      Ready := false, Tree := Element.TuiElement.Empty,
      Frame := LayoutFrame.TuiArrangedFrame.Create(),
      WorkFrame := LayoutFrame.TuiArrangedFrame.Create(),
      Size := Size.TuiSize.Create(0, 0), Pressed := None, LayoutKey := []
    );
  end function;
end record;

// Publish the returned state only after validation, layout and painting succeed.
public function TuiRenderFrame(
  Surface: RenderingSurface.TuiWorkingSurface;
  Previous: TuiRenderState;
  Root: Element.TuiElement;
  Pressed: option of ControlId.TuiControlId
): TuiRenderState;
begin
  const SameTree := Previous.Ready and Tree.TuiElementSameTree(Previous.Tree, Root);
  const Extent := Surface.Size();
  if SameTree and (Previous.Size = Extent) and (Previous.Pressed = Pressed) then
    return Previous;
  end if;

  if not SameTree then
    Validate.TuiElementValidate(Root);
  end if;
  var LayoutKey := Previous.LayoutKey;
  if not SameTree then
    LayoutKey := Key.TuiLayoutKey(Root);
  end if;
  const Reuse := Previous.Ready and (Previous.Size = Extent)
    and
    Tree.TuiSameItems(Previous.LayoutKey, LayoutKey);
  var Next := Previous;
  if Reuse then
    if Previous.Pressed <> Pressed then
      Paint.TuiPaintView(Surface, Previous.Frame, Root, Pressed);
    else
      Paint.TuiPaintRows(
        Surface, Previous.Frame, Root, Pressed,
        Invalidation.TuiInvalidatedRows(Previous.Tree, Root, Previous.Frame, Extent.Height)
      );
    end if;
  else
    Arrange.TuiArrange(Previous.WorkFrame, Root, Rect.TuiRectForSize(Extent));
    Paint.TuiPaintView(Surface, Previous.WorkFrame, Root, Pressed);
    Next.Frame := Previous.WorkFrame;
    Next.WorkFrame := Previous.Frame;
  end if;

  Next.Ready := true;
  Next.Tree := Root;
  Next.Size := Extent;
  Next.Pressed := Pressed;
  Next.LayoutKey := LayoutKey;
  return Next;
end function;

public function TuiReleaseRenderState(State: TuiRenderState): TuiRenderState;
begin
  State.Frame.Clear();
  State.WorkFrame.Clear();
  var Released := State;
  Released.Ready := false;
  Released.Tree := Element.TuiElement.Empty;
  Released.LayoutKey := [];
  Released.Pressed := None;
  return Released;
end function;
end unit;
