unit Std.Ui.Terminal.Runtime.Helpers;

uses
  Std.Ui.Terminal.Elements.Element as Element, Std.Ui.Terminal.Geometry.Size as Size,
  Std.Ui.Terminal.Ids.ControlId as ControlId, Std.Ui.Terminal.Layout.LayoutFit as LayoutFit,
  Std.Ui.Terminal.Layout.Measure as Measure, Std.Ui.Terminal.Layout.MeasureResult as MeasureResult,
  Std.Ui.Terminal.Layout.MeasureSpec as MeasureSpec, Std.Ui.Terminal.Runtime.Routing.Focus as Focus;

// Returns the first focusable control in the active modal or full tree, or `None`.
//
// Parameters:
// - `Root`: Root of the element tree.
public function TuiFocusFirst(Root: Element.TuiElement): option of ControlId.TuiControlId;
begin
  const Controls: array of ControlId.TuiControlId := Focus.TuiFocusableControls(Root);
  if Controls.Length() = 0 then
    begin
      return None;
    end;
  end if;

  return Some(Controls[0]);
end function;

// Returns `Preferred` when it is focusable in the active tree; otherwise the first focusable id.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Preferred`: Preferred size or focus identifier.
public function TuiFocusResolve(Root: Element.TuiElement; Preferred: option of ControlId.TuiControlId): option of ControlId.TuiControlId;
begin
  const Controls: array of ControlId.TuiControlId := Focus.TuiFocusableControls(Root);
  if Controls.Length() = 0 then
    begin
      return None;
    end;
  end if;

  case Preferred of
    when Some(const Id):
      begin
        if Focus.TuiControlIndex(Controls, Id) >= 0 then
          begin
            return Preferred;
          end;
        end if;
      end;
    when None:
      begin
      end;
  end case;

  return Some(Controls[0]);
end function;

// Reports whether the root's unconstrained minimum fits the available terminal size.
//
// Parameters:
// - `Root`: Root of the element tree.
// - `Available`: Available terminal size.
public function TuiLayoutFitFor(Root: Element.TuiElement; Available: Size.TuiSize): LayoutFit.TuiLayoutFit;
begin
  const Measured: MeasureResult.TuiMeasureResult := Measure.TuiMeasure(
    Root,
    MeasureSpec.TuiMeasureSpec.Unbounded()
  );
  return LayoutFit.TuiLayoutFit.Create(Measured.Minimum, Available);
end function;
end unit;
