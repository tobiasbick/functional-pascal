unit Std.Ui.Terminal.Runtime.Routing.Pointer;

uses
  Std.Console as Console, Std.Ui.Terminal.Chrome.Button as ChromeButton, Std.Ui.Terminal.Elements.Element as Element,
  Std.Ui.Terminal.Geometry.Point as Point, Std.Ui.Terminal.Ids.ControlId as ControlId,
  Std.Ui.Terminal.Layout.Frame as LayoutFrame, Std.Ui.Terminal.Runtime.Msg as Msg,
  Std.Ui.Terminal.Runtime.PointerEvent as PointerEvent,
  Std.Ui.Terminal.Runtime.Routing.ButtonCapture as ButtonCapture, Std.Ui.Terminal.Runtime.Routing.Focus as Focus,
  Std.Ui.Terminal.Runtime.Routing.ListActivation as ListActivation,
  Std.Ui.Terminal.Runtime.Routing.MenuPointer as RoutingMenuPointer,
  Std.Ui.Terminal.Runtime.Routing.PointerHit as PointerHit, Std.Ui.Terminal.Runtime.Routing.TextArea as TextArea,
  Std.Ui.Terminal.Text.Input as TextInput;

function TuiRoutePointerFocusMessages(
  Previous: option of ControlId.TuiControlId;
  Target: ControlId.TuiControlId
): array of Msg.TuiMsg;
begin
  if Focus.TuiFocusMatches(Previous, Target) then
    begin
      return [];
    end;
  end if;

  return [Msg.TuiMsg.FocusChanged(Previous, Some(Target))];
end function;

function TuiIdlePointerResult(ApplicationId: integer; Messages: array of Msg.TuiMsg): array of Msg.TuiMsg;
begin
  ButtonCapture.TuiButtonCaptureRelease(ApplicationId);
  return Messages;
end function;

function TuiCapturedPointerResult(
  ApplicationId: integer;
  Messages: array of Msg.TuiMsg;
  Button: ChromeButton.TuiButtonSpec;
  Inside: boolean
): array of Msg.TuiMsg;
begin
  ButtonCapture.TuiButtonCaptureSet(ApplicationId, Button, Inside);
  return Messages;
end function;

function TuiPointerInsideCapturedButton(
  Root: Element.TuiElement;
  Frame: LayoutFrame.TuiArrangedFrame;
  Position: Point.TuiPoint;
  Button: ChromeButton.TuiButtonSpec
): boolean;
begin
  case PointerHit.TuiPointerHitAt(Frame, Root, Position) of
    when PointerHit.TuiPointerHit.ElementButton(const Hit):
      begin
        return Hit.Id.Value = Button.Id.Value;
      end;
    when PointerHit.TuiPointerHit.Miss, PointerHit.TuiPointerHit.ImmediateButton(_, _), PointerHit.TuiPointerHit.Input(_, _), PointerHit.TuiPointerHit.TextArea(_, _, _, _, _), PointerHit.TuiPointerHit.CheckBox(_, _, _), PointerHit.TuiPointerHit.List(_, _, _, _, _, _), PointerHit.TuiPointerHit.Scroll(_):
      begin
        return false;
      end;
  end case;
end function;

// Allocates idle pointer-button state for one application.
public procedure TuiPointerRoutingOpen();
begin
  ButtonCapture.TuiButtonCaptureOpen();
end procedure;

// Clears pointer-button state for one application.
//
// Parameters:
// - `ApplicationId`: Identifier of the application-owned routing state.
public procedure TuiPointerRoutingClose(ApplicationId: integer);
begin
  ButtonCapture.TuiButtonCaptureClose(ApplicationId);
  ListActivation.TuiListActivationClear(ApplicationId);
end procedure;

// Returns the button painted pressed for one application.
//
// Parameters:
// - `ApplicationId`: Identifier of the application-owned routing state.
public function TuiPointerRoutingPressed(ApplicationId: integer): option of ControlId.TuiControlId;
begin
  return ButtonCapture.TuiButtonCapturePressed(ApplicationId);
end function;

// Routes one pointer event and advances application-owned button capture.
//
// Parameters:
// - `Pointer`: Normalized pointer event to route.
// - `ApplicationId`: Identifier of the application-owned routing state.
// - `Root`: Root of the element tree.
// - `Frame`: Arranged frame containing element geometry.
public function TuiRouteApplicationPointer(
  Pointer: PointerEvent.TuiPointerEvent;
  ApplicationId: integer;
  Root: Element.TuiElement;
  Frame: LayoutFrame.TuiArrangedFrame
): array of Msg.TuiMsg;
begin
  const PointerAction: Console.MouseAction := Pointer.Action;
  const PointerButton: PointerEvent.TuiPointerButton := Pointer.Button;
  const PointerPosition: Point.TuiPoint := Pointer.Position;
  const PointerShift: boolean := Pointer.Shift;
  const PointerCtrl: boolean := Pointer.Ctrl;
  const PointerAlt: boolean := Pointer.Alt;
  const PointerMeta: boolean := Pointer.Meta;
  Focus.TuiRouteRequireMatchingFrame(Frame, Root);
  case ButtonCapture.TuiButtonCaptureGet(ApplicationId) of
    when ButtonCapture.TuiButtonPressState.Captured(const Button, const PreviousInside):
      begin
        const Inside: boolean := TuiPointerInsideCapturedButton(
          Root,
          Frame,
          PointerPosition,
          Button
        );
        if PointerAction = Console.MouseAction.Up then
          begin
            if Inside then
              begin
                return TuiIdlePointerResult(
                  ApplicationId, [
                    Msg.TuiMsg.Action(Button.Id, Button.Action)
                  ]
                );
              end;
            end if;

            return TuiIdlePointerResult(
              ApplicationId, [
                Msg.TuiMsg.Pointer(
                  PointerEvent.TuiPointerEvent.WithModifiers(
                    PointerAction,
                    PointerButton,
                    PointerPosition,
                    PointerShift,
                    PointerCtrl,
                    PointerAlt,
                    PointerMeta
                  )
                )
              ]
            );
          end;
        end if;

        return TuiCapturedPointerResult(
          ApplicationId, [
            Msg.TuiMsg.Pointer(
              PointerEvent.TuiPointerEvent.WithModifiers(
                PointerAction,
                PointerButton,
                PointerPosition,
                PointerShift,
                PointerCtrl,
                PointerAlt,
                PointerMeta
              )
            )
          ], Button, Inside
        );
      end;
    when ButtonCapture.TuiButtonPressState.Idle:
      begin
      end;
  end case;
  const MenuPointer: boolean := (PointerAction = Console.MouseAction.Move)
    or
    (
      (PointerAction = Console.MouseAction.Down)
      and
      (PointerButton = PointerEvent.TuiPointerButton.Left)
    );
  if MenuPointer then
    begin
      case RoutingMenuPointer.TuiRouteMenuPointer(
        Root, Frame, PointerPosition, PointerAction =
        Console.MouseAction.Down
      ) of
        when Some(const Messages):
          begin
            return TuiIdlePointerResult(ApplicationId, Messages);
          end;
        when None:
          begin
          end;
      end case;
    end;
  end if;

  if (PointerAction <> Console.MouseAction.Down)
    or
    (PointerButton <> PointerEvent.TuiPointerButton.Left)
  then
    begin
      return TuiIdlePointerResult(
        ApplicationId, [
          Msg.TuiMsg.Pointer(
            PointerEvent.TuiPointerEvent.WithModifiers(
              PointerAction,
              PointerButton,
              PointerPosition,
              PointerShift,
              PointerCtrl,
              PointerAlt,
              PointerMeta
            )
          )
        ]
      );
    end;
  end if;
  const Previous: option of ControlId.TuiControlId := Focus.TuiRootFocus(Root);
  case PointerHit.TuiPointerHitAt(Frame, Root, PointerPosition) of
    when PointerHit.TuiPointerHit.Miss:
      begin
        return TuiIdlePointerResult(
          ApplicationId, [
            Msg.TuiMsg.Pointer(
              PointerEvent.TuiPointerEvent.WithModifiers(
                PointerAction,
                PointerButton,
                PointerPosition,
                PointerShift,
                PointerCtrl,
                PointerAlt,
                PointerMeta
              )
            )
          ]
        );
      end;
    when PointerHit.TuiPointerHit.ElementButton(const Button):
      begin
        const Messages: array of Msg.TuiMsg := TuiRoutePointerFocusMessages(
          Previous,
          Button.Id
        ).Concat([
          Msg.TuiMsg.Pointer(
            PointerEvent.TuiPointerEvent.WithModifiers(
              PointerAction,
              PointerButton,
              PointerPosition,
              PointerShift,
              PointerCtrl,
              PointerAlt,
              PointerMeta
            )
          )
        ]);
        return TuiCapturedPointerResult(ApplicationId, Messages, Button, true);
      end;
    when PointerHit.TuiPointerHit.ImmediateButton(const Id, const Action):
      begin
        return TuiIdlePointerResult(
          ApplicationId,
          TuiRoutePointerFocusMessages(Previous, Id).Concat([Msg.TuiMsg.Action(Id, Action)])
        );
      end;
    when PointerHit.TuiPointerHit.Input(const Input, const Bounds):
      begin
        const Viewport: TextInput.TuiInputViewport := TextInput.TuiInputViewportFor(
          Input.Text, Input.Caret, Bounds.Width -
          2
        );
        const Caret: integer := TextInput.TuiInputCaretAtColumn(
          Input.Text, Viewport, PointerPosition.X - Bounds.X -
          1
        );
        return TuiIdlePointerResult(
          ApplicationId, TuiRoutePointerFocusMessages(
            Previous,
            Input.Id
          ).Concat([
            Msg.TuiMsg.TextChanged(Input.Id, Input.ChangeAction, Input.Text, Caret)
          ])
        );
      end;
    when PointerHit.TuiPointerHit.TextArea(const Id, const Action, const Text, const Offset, const Bounds):
      begin
        return TuiIdlePointerResult(
          ApplicationId, TuiRoutePointerFocusMessages(
            Previous,
            Id
          ).Concat([
            TextArea.TuiRouteTextAreaPointer(Id, Text, Offset, Action, Bounds, PointerPosition)
          ])
        );
      end;
    when PointerHit.TuiPointerHit.CheckBox(const Id, const Action, const Checked):
      begin
        return TuiIdlePointerResult(
          ApplicationId, TuiRoutePointerFocusMessages(
            Previous,
            Id
          ).Concat([
            Msg.TuiMsg.CheckChanged(Id, Action, not Checked)
          ])
        );
      end;
    when PointerHit.TuiPointerHit.List(const Id, const Action, const CurrentSelected, const Proposed, const Activate, const Text):
      begin
        const FocusMessages: array of Msg.TuiMsg := TuiRoutePointerFocusMessages(Previous, Id);
        case Activate of
          when Some(const ActivateAction):
            ListActivation.TuiListActivationRemember(
              ApplicationId,
              Id,
              ActivateAction,
              Proposed,
              Text
            );
            var Messages := FocusMessages;
            if Proposed <> CurrentSelected then
              Messages.PushInPlace(Msg.TuiMsg.SelectionChanged(Id, Action, Proposed));
            end if;

            Messages.PushInPlace(Msg.TuiMsg.Action(Id, ActivateAction));
            return TuiIdlePointerResult(ApplicationId, Messages);
          when None:
            null;
        end case;

        if Proposed = CurrentSelected then
          begin
            if FocusMessages.Length() = 0 then
              begin
                return TuiIdlePointerResult(
                  ApplicationId, [
                    Msg.TuiMsg.Pointer(
                      PointerEvent.TuiPointerEvent.WithModifiers(
                        PointerAction,
                        PointerButton,
                        PointerPosition,
                        PointerShift,
                        PointerCtrl,
                        PointerAlt,
                        PointerMeta
                      )
                    )
                  ]
                );
              end;
            end if;

            return TuiIdlePointerResult(ApplicationId, FocusMessages);
          end;
        end if;

        return TuiIdlePointerResult(
          ApplicationId, FocusMessages.Concat([
            Msg.TuiMsg.SelectionChanged(Id, Action, Proposed)
          ])
        );
      end;
    when PointerHit.TuiPointerHit.Scroll(const Id):
      begin
        const FocusMessages: array of Msg.TuiMsg := TuiRoutePointerFocusMessages(Previous, Id);
        if FocusMessages.Length() = 0 then
          begin
            return TuiIdlePointerResult(
              ApplicationId, [
                Msg.TuiMsg.Pointer(
                  PointerEvent.TuiPointerEvent.WithModifiers(
                    PointerAction,
                    PointerButton,
                    PointerPosition,
                    PointerShift,
                    PointerCtrl,
                    PointerAlt,
                    PointerMeta
                  )
                )
              ]
            );
          end;
        end if;

        return TuiIdlePointerResult(ApplicationId, FocusMessages);
      end;
  end case;
end function;
end unit;
