// Shared tool values, handler context and operational errors.
//
// Handbook: `docs/pascal/std/ai/mcp/types.md`.
unit Std.Mcp.Types;

uses Std.Mcp as StdMcp;

// Generated by `cargo run -p fpas-sema --example export_intrinsic_std_api`.
// Edit the Rust registry and `docs/pascal/std/`, then regenerate this editor declaration surface.
// Runtime behavior is implemented by the compiler, VM, or Rust standard-library crate.

// Url and Headers for one intended consumer.
public type HttpAccess = record
  public Url: string;
  public Headers: array of HttpHeader;
end record;

// Name and confidential Value.
public type HttpHeader = record
  public Name: string;
  public Value: string;
end record;

// Nominal registration, serving and transport failure.
public type McpError = error
  // `InvalidArgument` enum member.
  //
  // Parameters:
  // - `Argument`: `string` input value used by `InvalidArgument`.
  InvalidArgument(Argument: string) = 'Invalid MCP argument';
  // `InvalidSchema` enum member.
  //
  // Parameters:
  // - `Schema`: `string` input value used by `InvalidSchema`.
  InvalidSchema(Schema: string) = 'Invalid MCP tool schema';
  // `DuplicateTool` enum member.
  DuplicateTool = 'MCP tool name is already registered';
  // `UnknownTool` enum member.
  UnknownTool = 'Unknown MCP tool';
  // `InvalidArguments` enum member.
  InvalidArguments = 'MCP arguments do not match the input schema';
  // `InvalidResult` enum member.
  InvalidResult = 'Invalid MCP tool result';
  // `LimitExceeded` enum member.
  //
  // Parameters:
  // - `Resource`: `string` input value used by `LimitExceeded`.
  // - `Limit`: `integer` input value used by `LimitExceeded`.
  LimitExceeded(Resource: string; Limit: integer) = 'MCP resource limit exceeded';
  // `Busy` enum member.
  Busy = 'MCP server already has a serving task';
  // `Closed` enum member.
  Closed = 'MCP resource is closed';
  // `Transport` enum member.
  //
  // Parameters:
  // - `Kind`: `string` input value used by `Transport`.
  Transport(Kind: string) = 'MCP transport failed';
  // `Cancelled` enum member.
  Cancelled = 'MCP serving was cancelled';
  // `Timeout` enum member.
  Timeout = 'MCP operation timed out';
  // `PermissionDenied` enum member.
  PermissionDenied = 'MCP application access denied';
end error;

// Text carrying bounded JSON and exact numeric representations.
public type RawJson = record
  public Text: string;
end record;

// Server, AttachmentId, CallId, RequestId, Meta, ProtocolVersion, ConnectionId and SessionId.
public type RequestContext = record
  public Server: StdMcp.Server;
  public AttachmentId: integer;
  public CallId: integer;
  public RequestId: RawJson;
  public Meta: RawJson;
  public ProtocolVersion: option of string;
  public ConnectionId: option of integer;
  public SessionId: option of string;
end record;

// Name, Description, InputSchema, optional OutputSchema, Annotations and Meta.
public type ToolDefinition = record
  public Name: string;
  public Description: string;
  public InputSchema: RawJson;
  public OutputSchema: option of RawJson;
  public Annotations: option of RawJson;
  public Meta: option of RawJson;
end record;

// Function taking RequestContext and RawJson and returning result of ToolResult and McpError.
//
// Parameters:
// - `Context`: `Std.Mcp.Types.RequestContext` input value used by `ToolHandler`.
// - `Arguments`: `Std.Mcp.Types.RawJson` input value used by `ToolHandler`.
public type ToolHandler = function(Context: RequestContext; Arguments: RawJson): result of (ToolResult, McpError);

// SDK tool-result envelope in Payload.
public type ToolResult = record
  public Payload: RawJson;
end record;
end unit;
