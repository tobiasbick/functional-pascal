// Intrinsic `BoardInfo` data type.
public type BoardInfo = record
  public Name: option of string;
  public Vendor: option of string;
  public Version: option of string;
  public Serial: option of string;
  public AssetTag: option of string;
end record;

// Intrinsic `CgroupMemory` data type.
public type CgroupMemory = record
  public TotalBytes: integer;
  public FreeBytes: integer;
  public FreeSwapBytes: integer;
  public ResidentBytes: integer;
end record;

// Intrinsic `ComponentInfo` data type.
public type ComponentInfo = record
  public Id: option of string;
  public Label: string;
  public TemperatureCelsius: option of real;
  public MaximumCelsius: option of real;
  public CriticalCelsius: option of real;
end record;

// Intrinsic `ComponentSample` data type.
public type ComponentSample = record
  public SampledAtMilliseconds: integer;
  public Components: array of ComponentInfo;
end record;

// Intrinsic `CpuInfo` data type.
public type CpuInfo = record
  public Name: string;
  public Vendor: string;
  public Brand: string;
  public FrequencyMHz: integer;
  public UsagePercent: option of real;
end record;

// Intrinsic `CpuSample` data type.
public type CpuSample = record
  public SampledAtMilliseconds: integer;
  public IntervalMilliseconds: option of integer;
  public PhysicalCores: result of (integer, System.SystemError);
  public UsagePercent: option of real;
  public Cpus: array of CpuInfo;
end record;

// Intrinsic `DiskInfo` data type.
public type DiskInfo = record
  public Id: option of string;
  public Name: string;
  public Kind: string;
  public FileSystem: string;
  public MountPoint: string;
  public TotalBytes: integer;
  public AvailableBytes: integer;
  public Removable: boolean;
  public ReadOnly: boolean;
  public ReadBytes: integer;
  public WrittenBytes: integer;
  public TotalReadBytes: integer;
  public TotalWrittenBytes: integer;
end record;

// Intrinsic `DiskSample` data type.
public type DiskSample = record
  public SampledAtMilliseconds: integer;
  public IntervalMilliseconds: option of integer;
  public Disks: array of DiskInfo;
end record;

// Intrinsic `GpuInfo` data type.
public type GpuInfo = record
  public PciAddress: string;
  public Vendor: option of string;
  public Model: option of string;
  public UsagePercent: option of real;
  public TotalMemoryBytes: option of integer;
  public UsedMemoryBytes: option of integer;
end record;

// Intrinsic `GpuSample` data type.
public type GpuSample = record
  public SampledAtMilliseconds: integer;
  public IntervalMilliseconds: option of integer;
  public Gpus: array of GpuInfo;
end record;

// Intrinsic `MachineInfo` data type.
public type MachineInfo = record
  public ProductName: result of (string, System.SystemError);
  public ProductFamily: result of (string, System.SystemError);
  public ProductVendor: result of (string, System.SystemError);
  public ProductVersion: result of (string, System.SystemError);
  public ProductSerial: result of (string, System.SystemError);
  public ProductSku: result of (string, System.SystemError);
  public ProductUuid: result of (string, System.SystemError);
  public Motherboard: result of (BoardInfo, System.SystemError);
end record;

// Intrinsic `MemoryInfo` data type.
public type MemoryInfo = record
  public SampledAtMilliseconds: integer;
  public TotalBytes: integer;
  public FreeBytes: integer;
  public AvailableBytes: integer;
  public UsedBytes: integer;
  public TotalSwapBytes: integer;
  public FreeSwapBytes: integer;
  public UsedSwapBytes: integer;
  public Cgroup: option of CgroupMemory;
end record;

// Intrinsic `NetworkInfo` data type.
public type NetworkInfo = record
  public Name: string;
  public MacAddress: string;
  public IpNetworks: array of string;
  public Mtu: integer;
  public State: string;
  public TransmitBitsPerSecond: option of integer;
  public ReceiveBitsPerSecond: option of integer;
  public ReceivedBytes: integer;
  public TransmittedBytes: integer;
  public TotalReceivedBytes: integer;
  public TotalTransmittedBytes: integer;
  public ReceivedPackets: integer;
  public TransmittedPackets: integer;
  public TotalReceivedPackets: integer;
  public TotalTransmittedPackets: integer;
  public ReceiveErrors: integer;
  public TransmitErrors: integer;
  public TotalReceiveErrors: integer;
  public TotalTransmitErrors: integer;
end record;

// Intrinsic `NetworkSample` data type.
public type NetworkSample = record
  public SampledAtMilliseconds: integer;
  public IntervalMilliseconds: option of integer;
  public Networks: array of NetworkInfo;
end record;

