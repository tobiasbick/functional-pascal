// `Std.Os.Hardware` queries hardware inventories and resource measurements.
//
// Handbook: `docs/pascal/std/host/hardware.md`.
unit Std.Os.Hardware;

uses Std.Os.System as System;

// Generated by `cargo run -p fpas-sema --example export_intrinsic_std_api`.
// Edit the Rust registry and `docs/pascal/std/`, then regenerate this editor declaration surface.
