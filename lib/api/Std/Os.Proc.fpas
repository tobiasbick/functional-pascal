// `Name: string` and `Value: Option of string`; `None` removes the child variable.
public type EnvironmentVariable = record
  public Name: string;
  public Value: option of string;
end record;

// Intrinsic `ProcError` data type.
public type ProcError = error
  // `StartFailed` enum member.
  //
  // Parameters:
  // - `Cause`: `Std.Os.Errors.HostError` input value used by `StartFailed`.
  StartFailed(Cause: Errors.HostError) = 'Process operation failed';
  // `WaitFailed` enum member.
  //
  // Parameters:
  // - `Cause`: `Std.Os.Errors.HostError` input value used by `WaitFailed`.
  WaitFailed(Cause: Errors.HostError) = 'Process operation failed';
  // `InvalidArgument` enum member.
  //
  // Parameters:
  // - `Name`: Name looked up or processed by the operation.
  // - `Reason`: `string` input value used by `InvalidArgument`.
  InvalidArgument(Name: string; Reason: string) = 'Process operation failed';
  // `IoFailure` enum member.
  //
  // Parameters:
  // - `Cause`: `Std.Os.Errors.HostError` input value used by `IoFailure`.
  IoFailure(Cause: Errors.HostError) = 'Process operation failed';
  // `Timeout` enum member.
  //
  // Parameters:
  // - `Operation`: `string` input value used by `Timeout`.
  // - `Stdout`: `string` input value used by `Timeout`.
  // - `Stderr`: `string` input value used by `Timeout`.
  Timeout(Operation: string; Stdout: string; Stderr: string) = 'Process timed out';
  // `Cancelled` enum member.
  //
  // Parameters:
  // - `Operation`: `string` input value used by `Cancelled`.
  // - `Stdout`: `string` input value used by `Cancelled`.
  // - `Stderr`: `string` input value used by `Cancelled`.
  Cancelled(Operation: string; Stdout: string; Stderr: string) = 'Process cancelled';
  // `LimitExceeded` enum member.
  //
  // Parameters:
  // - `Operation`: `string` input value used by `LimitExceeded`.
  // - `Resource`: `string` input value used by `LimitExceeded`.
  // - `Limit`: `integer` input value used by `LimitExceeded`.
  // - `Stdout`: `string` input value used by `LimitExceeded`.
  // - `Stderr`: `string` input value used by `LimitExceeded`.
  LimitExceeded(Operation: string; Resource: string; Limit: integer; Stdout: string; Stderr: string) = 'Process resource limit exceeded';
  // `ExecutionFailed` enum member.
  //
  // Parameters:
  // - `Cause`: `Std.Os.Errors.HostError` input value used by `ExecutionFailed`.
  // - `Stdout`: `string` input value used by `ExecutionFailed`.
  // - `Stderr`: `string` input value used by `ExecutionFailed`.
  ExecutionFailed(Cause: Errors.HostError; Stdout: string; Stderr: string) = 'Process execution failed';
end error;

// Intrinsic `Process` data type.
public type Process = record
  _IntrinsicHandle: integer;
end record;

// Optional native `ExitCode` and terminating `Signal`.
public type ProcessExitStatus = record
  public ExitCode: option of integer;
  public Signal: option of string;
end record;

// Child configuration; start from `DefaultOptions()`.
public type ProcessOptions = record
  public WorkingDirectory: option of string;
  public Environment: array of EnvironmentVariable;
  public Input: string;
  public TimeoutMillis: option of integer;
  public MaxOutputBytes: integer;
  public CancellationToken: option of Tasks.CancellationToken;
end record;

// Captured `ExitCode`, `Stdout`, and `Stderr`.
public type ProcessOutput = record
  public ExitCode: integer;
  public Stdout: string;
  public Stderr: string;
end record;

// Intrinsic `ProcessStartOptions` data type.
public type ProcessStartOptions = record
  public WorkingDirectory: option of string;
  public Environment: array of EnvironmentVariable;
end record;

