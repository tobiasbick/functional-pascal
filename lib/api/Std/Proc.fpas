  ExecutionFailed(Cause: Errors.HostError; Stdout: string; Stderr: string) = 'Process execution failed';
end error;

// Child configuration; start from `DefaultOptions()`.
public type ProcessOptions = record
  public WorkingDirectory: option of string;
  public Environment: array of EnvironmentVariable;
  public Input: string;
  public TimeoutMillis: option of integer;
  public MaxOutputBytes: integer;
  public CancellationToken: option of Tasks.CancellationToken;
end record;

// Captured `ExitCode`, `Stdout`, and `Stderr`.
public type ProcessOutput = record
  public ExitCode: integer;
  public Stdout: string;
  public Stderr: string;
end record;

