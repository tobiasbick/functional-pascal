  // - `Limit`: `integer` input value used by `LimitExceeded`.
  // - `Stdout`: `string` input value used by `LimitExceeded`.
  // - `Stderr`: `string` input value used by `LimitExceeded`.
  LimitExceeded(Operation: string; Resource: string; Limit: integer; Stdout: string; Stderr: string) = 'Process resource limit exceeded';
  // `ExecutionFailed` enum member.
  //
  // Parameters:
  // - `Cause`: `Std.Errors.HostError` input value used by `ExecutionFailed`.
