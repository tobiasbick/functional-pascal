[project]
name = "fpas-standard-library"
kind = "library"

[exports]
units = [
  "Std.Version",
  "Std.Cli",
  "Std.Time.Calendar",
  "Std.Ui.Terminal",
  "Std.Net.Uri",
  "Std.Text.Utf8",
  "Std.Encoding.Json.Fields",
  "Std.Encoding.Toml.Fields",
  "Std.Net.Http",
  "Std.Ai.OpenAi",
]

[sources]
include = ["Std/**/*.fpas"]
