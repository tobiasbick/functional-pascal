[project]
name = "fpas-standard-library"
kind = "library"

[exports]
units = [
  "Std.Version",
  "Std.Tui",
  "Std.Tui.Cells",
  "Std.Tui.Chrome",
  "Std.Tui.Elements",
  "Std.Tui.Geometry",
  "Std.Tui.Ids",
  "Std.Tui.Layout",
  "Std.Tui.Rendering",
  "Std.Tui.Runtime",
  "Std.Net.Uri",
  "Std.Net.Utf8",
  "Std.Json.Fields",
  "Std.Toml.Fields",
  "Std.Http",
  "Std.Ai.OpenAi",
]

[sources]
include = ["Std/**/*.fpas"]
