<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Fpas.NET.Sdk</PackageId>
    <Version>$(FpasSdkVersion)</Version>
    <Description>Project SDK and direct CIL compiler for Functional Pascal for .NET.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fpas.Build.Tasks/Fpas.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Fpas.Cli/Fpas.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Fpas.Core/Fpas.Core.csproj" ReferenceOutputAssembly="false" />
    <None Update="Sdk/Sdk.props" Pack="true" PackagePath="Sdk/Sdk.props" />
    <None Update="Sdk/Sdk.targets" Pack="true" PackagePath="Sdk/Sdk.targets" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="IncludeFpasToolAssets" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../../src/Fpas.Cli/Fpas.Cli.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_FpasCompilerAssembly" />
    </MSBuild>
    <MSBuild Projects="../../src/Fpas.Build.Tasks/Fpas.Build.Tasks.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_FpasTaskAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_FpasCompilerDirectory>@(_FpasCompilerAssembly->'%(RootDir)%(Directory)')</_FpasCompilerDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_FpasLanguageServerAsset Include="$(_FpasCompilerDirectory)Fpas.LanguageServer.dll;$(_FpasCompilerDirectory)OmniSharp.Extensions.LanguageProtocol.dll;$(_FpasCompilerDirectory)StreamJsonRpc.dll;$(_FpasCompilerDirectory)Newtonsoft.Json.dll;$(_FpasCompilerDirectory)Fpas.SdkResolver.dll" />
      <_FpasCompilerManagedAsset Include="$(_FpasCompilerDirectory)**/*.dll" />
      <None Include="@(_FpasCompilerManagedAsset)" Pack="true" PackagePath="tools/compiler/%(_FpasCompilerManagedAsset.RecursiveDir)%(_FpasCompilerManagedAsset.Filename)%(_FpasCompilerManagedAsset.Extension)" />
      <_FpasCompilerNativeAsset Include="$(_FpasCompilerDirectory)**/*.so;$(_FpasCompilerDirectory)debugger-notices.txt" />
      <None Include="@(_FpasCompilerNativeAsset)" Pack="true" PackagePath="tools/compiler/%(_FpasCompilerNativeAsset.RecursiveDir)%(_FpasCompilerNativeAsset.Filename)%(_FpasCompilerNativeAsset.Extension)" />
      <None Include="$(_FpasCompilerDirectory)Fpas.Cli.deps.json;$(_FpasCompilerDirectory)Fpas.Cli.runtimeconfig.json" Pack="true" PackagePath="tools/compiler/" />
      <None Include="@(_FpasTaskAssembly)" Pack="true" PackagePath="tools/tasks/" />
    </ItemGroup>
    <Error Condition="!Exists('%(_FpasLanguageServerAsset.Identity)')" Text="Missing language-server deployment asset: %(_FpasLanguageServerAsset.Identity). Build the matching CLI before packing." />
  </Target>
</Project>
