<!-- [Documentation](../../docs/build/distribution.md#windows-portable-launcher) -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(PortableGui)' == 'true'">WinExe</OutputType>
    <AssemblyName>$(PortableName)</AssemblyName>
    <AssemblyTitle Condition="'$(PortableTitleFile)' != ''">$([System.IO.File]::ReadAllText('$(PortableTitleFile)'))</AssemblyTitle>
    <Product Condition="'$(PortableTitleFile)' != ''">$(AssemblyTitle)</Product>
    <PublishAot>true</PublishAot>
    <ApplicationIcon Condition="'$(PortableIcon)' != ''">$(PortableIcon)</ApplicationIcon>
    <DefineConstants Condition="'$(PortableGui)' == 'true'">$(DefineConstants);PORTABLE_GUI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PortableArchive)" LogicalName="Fpas.Portable.Archive" />
    <EmbeddedResource Include="$(PortableManifest)" LogicalName="Fpas.Portable.Manifest" />
    <EmbeddedResource Include="$(PortableTitleFile)" Condition="'$(PortableTitleFile)' != ''" LogicalName="Fpas.Portable.Title" />
  </ItemGroup>
</Project>
