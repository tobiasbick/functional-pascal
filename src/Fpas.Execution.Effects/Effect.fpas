// [Documentation](../../docs/pascal/libraries/effects.md)

// Deferred effects on .NET tasks with typed success, failure, and environment.
unit Fpas.Execution.Effects;

uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

// The ordinary result of an effect.
//
// ## Type parameters
// - `A`: Success value type.
// - `E`: Expected failure type.
public type Outcome of (A, E) = variant
  // The effect produced Value.
  Success(Value: A);
  // The effect reported Reason as data.
  Failure(Reason: E);
end variant;

// The success value of an operation which produces no data.
public type Completion = enum
  // The operation completed.
  Done;
end enum;

// A callable description of work. Each run calls the body independently.
//
// ## Type parameters
// - `A`: Success value type.
// - `E`: Expected failure type.
// - `R`: Required environment type.
public type Effect of (A, E, R) = record
  Body: function(R, Threads.CancellationToken): Tasks.Task of Outcome of (A, E);

  // Stores a body for later execution.
  //
  // ## Parameters
  // - `Body`: Work invoked with the environment and cancellation token.
  //
  // ## Returns
  // The deferred effect.
  public static function Defer(
    Body: function(R, Threads.CancellationToken): Tasks.Task of Outcome of (A, E)
  ): Effect of (A, E, R);
  begin
    return new Effect of (A, E, R)(Body);
  end function;

  // Runs the effect. Expected failures are results. CLR faults and cancellation
  // propagate through the task.
  //
  // ## Parameters
  // - `Environment`: Dependencies supplied by the caller.
  // - `Cancellation`: Cancellation for this run.
  //
  // ## Returns
  // A task that completes after the effect and its cleanup finish.
  public async function Run(
    Environment: R;
    Cancellation: Threads.CancellationToken
  ): Tasks.Task of Outcome of (A, E);
  begin
    Cancellation.ThrowIfCancellationRequested();
    return await self.Body(Environment, Cancellation).ConfigureAwait(false);
  end function;
end record;

// Transforms a successful value.
//
// ## Type parameters
// - `A`: Original success type.
// - `B`: New success type.
// - `E`: Expected failure type.
// - `R`: Environment type.
//
// ## Parameters
// - `Work`: The effect to run first.
// - `Transform`: Function called with a successful value.
//
// ## Returns
// The deferred transformation.
public function Map of (A, B, E, R)(
  Work: Effect of (A, E, R);
  Transform: function(A): B
): Effect of (B, E, R);
  async function Execute(
    Environment: R;
    Cancellation: Threads.CancellationToken
  ): Tasks.Task of Outcome of (B, E);
  begin
    return case await Work.Run(Environment, Cancellation).ConfigureAwait(false) of
      when Outcome.Success(const Value: A): Outcome.Success(Transform(Value));
      when Outcome.Failure(const Reason: E): Outcome.Failure(Reason);
    end case;
  end function;
begin
  return Effect of (B, E, R).Defer(Execute);
end function;

// Runs a second effect after the first succeeds.
//
// ## Type parameters
// - `A`: First success type.
// - `B`: Second success type.
// - `E`: Shared expected failure type.
// - `R`: Shared environment type.
//
// ## Parameters
// - `Work`: The effect to run first.
// - `Next`: Builds the next step from a successful value.
//
// ## Returns
// The deferred sequence.
public function AndThen of (A, B, E, R)(
  Work: Effect of (A, E, R);
  Next: function(A): Effect of (B, E, R)
): Effect of (B, E, R);
  async function Execute(
    Environment: R;
    Cancellation: Threads.CancellationToken
  ): Tasks.Task of Outcome of (B, E);
  begin
    case await Work.Run(Environment, Cancellation).ConfigureAwait(false) of
      when Outcome.Success(const Value: A):
        Cancellation.ThrowIfCancellationRequested();
        return await Next(Value).Run(Environment, Cancellation).ConfigureAwait(false);
      when Outcome.Failure(const Reason: E):
        return Outcome.Failure(Reason);
    end case;
  end function;
begin
  return Effect of (B, E, R).Defer(Execute);
end function;

// Transforms an expected failure.
//
// ## Type parameters
// - `A`: Success type.
// - `E`: Original expected failure type.
// - `F`: New expected failure type.
// - `R`: Environment type.
//
// ## Parameters
// - `Work`: The effect to run.
// - `Transform`: Function called with an expected failure.
//
// ## Returns
// The deferred failure transformation.
public function MapFailure of (A, E, F, R)(
  Work: Effect of (A, E, R);
  Transform: function(E): F
): Effect of (A, F, R);
  async function Execute(
    Environment: R;
    Cancellation: Threads.CancellationToken
  ): Tasks.Task of Outcome of (A, F);
  begin
    return case await Work.Run(Environment, Cancellation).ConfigureAwait(false) of
      when Outcome.Success(const Value: A): Outcome.Success(Value);
      when Outcome.Failure(const Reason: E): Outcome.Failure(Transform(Reason));
    end case;
  end function;
begin
  return Effect of (A, F, R).Defer(Execute);
end function;

// Recovers from an expected failure by choosing another effect.
//
// ## Type parameters
// - `A`: Shared success type.
// - `E`: Expected failure type.
// - `R`: Shared environment type.
//
// ## Parameters
// - `Work`: The effect to try.
// - `Recover`: Builds a fallback from an expected failure.
//
// ## Returns
// The deferred recovery.
public function OrElse of (A, E, R)(
  Work: Effect of (A, E, R);
  Recover: function(E): Effect of (A, E, R)
): Effect of (A, E, R);
  async function Execute(
    Environment: R;
    Cancellation: Threads.CancellationToken
  ): Tasks.Task of Outcome of (A, E);
  begin
    const Result: Outcome of (A, E) := await Work.Run(
      Environment,
      Cancellation
    ).ConfigureAwait(false);
    case Result of
      when Outcome.Success(_):
        return Result;
      when Outcome.Failure(const Reason: E):
        Cancellation.ThrowIfCancellationRequested();
        return await Recover(Reason).Run(Environment, Cancellation).ConfigureAwait(false);
    end case;
  end function;
begin
  return Effect of (A, E, R).Defer(Execute);
end function;

// Supplies part of a larger environment to an effect.
//
// ## Type parameters
// - `A`: Success type.
// - `E`: Expected failure type.
// - `R`: Required environment type.
// - `S`: Caller environment type.
//
// ## Parameters
// - `Work`: The workflow needing R.
// - `Select`: Projects R from S at execution.
//
// ## Returns
// The workflow accepting the larger environment.
public function FromEnvironment of (A, E, R, S)(
  Work: Effect of (A, E, R);
  Select: function(S): R
): Effect of (A, E, S);
  function Execute(
    Environment: S;
    Cancellation: Threads.CancellationToken
  ): Tasks.Task of Outcome of (A, E);
  begin
    return Work.Run(Select(Environment), Cancellation);
  end function;
begin
  return Effect of (A, E, S).Defer(Execute);
end function;

end unit;
