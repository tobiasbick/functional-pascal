// [Documentation](../../docs/pascal/libraries/workflows.md#parallel-work-and-streams)

// Bounded parallel execution of deferred workflows.
unit Fpas.Execution.Workflows.Parallel;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Execution.Workflows.Scopes as S;

uses System as Sys;
uses System.Collections.Generic as C;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

// Executes workflows with a bounded number of workers and returns results in input order.
//
// ## Type parameters
// - `A`: Success type of each workflow.
// - `E`: Shared expected failure type.
// - `R`: Shared environment type.
//
// ## Parameters
// - `Work`: The workflows to execute. The array is copied when composing.
// - `Concurrency`: Positive maximum number of simultaneous executions.
//
// ## Returns
// A deferred workflow. A failure stops admission, requests cancellation of the
// other workers, and waits for them to finish. Unexpected faults remain task faults.
public function All of (A, E, R)(Work: array of Fx.Effect of (A, E, R); Concurrency: int): Fx.Effect of (array of A, E, R);
requires Concurrency > 0;
  function Execute(Environment: R; Cancellation: Threads.CancellationToken): Tasks.Task of Fx.Outcome of (array of A, E);
    async function RunWorkers(Lifetime: S.Scope): Tasks.Task of Fx.Outcome of (array of A, E);
      async function Worker(Child: S.Scope): Tasks.Task of Fx.Completion;
      begin
        try
          await Ready.Task.WaitAsync(Child.Token).ConfigureAwait(false);
          while not Lifetime.Token.IsCancellationRequested and not Failure.Task.IsCompleted do
            const Slot: long := Threads.Interlocked.Increment(ref Cursor[0]);
            if Slot >= Inputs.Length then
              break;
            end if;

            const Index: int := cast<int>(Slot);
            const Result: Fx.Outcome of (A, E) := await Inputs[Index].Run(
              Environment,
              Child.Token
            ).ConfigureAwait(false);
            case Result of
              when Fx.Outcome.Success(_):
                Values[Index] := Result;
              when Fx.Outcome.Failure(const Reason: E):
                if Failure.TrySetResult(Fx.Outcome.Failure(Reason)) then
                  discard Lifetime.Cancel();
                end if;

                break;
            end case;
          end while;
        catch Cancelled: Sys.OperationCanceledException when Child.Token.IsCancellationRequested
          and Cancelled.CancellationToken = Child.Token do
        catch Fault: Sys.Exception do
          discard Lifetime.Cancel();
          raise;
        end try;

        return Fx.Completion.Done;
      end function;
    begin
      const Values: array of Fx.Outcome of (A, E)? := new Fx.Outcome of (A, E)?[Inputs.Length];
      const Failure: Tasks.TaskCompletionSource of Fx.Outcome of (array of A, E) := new Tasks.TaskCompletionSource of Fx.Outcome of (array of A, E)();
      const Cursor: array of long := [-1L];
      // Let the workers wait until the parent has registered the full group.
      const Ready: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
        Tasks.TaskCreationOptions.RunContinuationsAsynchronously
      );
      const Workers: C.List of Tasks.Task := new C.List of Tasks.Task();
      for Index: int := 1 to Sys.Math.Min(Concurrency, Inputs.Length) do
        Workers.Add(Lifetime.Fork of Fx.Completion(Worker).Join);
      end for;

      Ready.SetResult();

      await Tasks.Task.WhenAll(Workers).ConfigureAwait(false);
      Cancellation.ThrowIfCancellationRequested();
      if Failure.Task.IsCompleted then
        return await Failure.Task.ConfigureAwait(false);
      end if;
      const Ordered: C.List of A := new C.List of A(Inputs.Length);
      for Result: Fx.Outcome of (A, E)? in Values do
        case Result of
          when Fx.Outcome.Success(const Value: A):
            Ordered.Add(Value);
          else
            raise new Sys.InvalidOperationException(
              'A workflow did not produce a successful value'
            );
        end case;
      end for;

      return Fx.Outcome.Success(Ordered.ToArray());
    end function;
  begin
    return S.Scope.Use of Fx.Outcome of (array of A, E)(RunWorkers, Cancellation);
  end function;
begin
  const Inputs: array of Fx.Effect of (A, E, R) := cast<array of Fx.Effect of (A, E, R)>(Work.Clone());
  return Fx.Effect of (array of A, E, R).Defer(Execute);
end function;

end unit;
