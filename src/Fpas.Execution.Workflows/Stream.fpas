// [Documentation](../../docs/pascal/libraries/workflows.md#parallel-work-and-streams)

// Bounded, ordered event streams with structured producer lifetime.
unit Fpas.Execution.Workflows.Streams;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Execution.Workflows.Scopes as S;

uses System.Threading as Threads;
uses System.Threading.Channels as Channels;
uses System.Threading.Tasks as Tasks;

// Describes a producer. Each subscription creates a fresh bounded channel.
//
// ## Type parameters
// - `A`: Event type.
// - `E`: Expected producer failure type.
// - `R`: Environment required by the producer.
public type Stream of (A, E, R) = record
  Produce: function(R, function(A): Tasks.Task, Threads.CancellationToken): Tasks.Task of Fx.Outcome of (Fx.Completion, E);

  // Stores a producer for later subscription.
  //
  // ## Parameters
  // - `Produce`: Producer that awaits each write in publication order.
  //
  // ## Returns
  // The deferred stream.
  public static function Create(Produce: function(R, function(A): Tasks.Task, Threads.CancellationToken): Tasks.Task of Fx.Outcome of (Fx.Completion, E)): Stream of (A, E, R);
  begin
    return new Stream of (A, E, R)(Produce);
  end function;

  // Runs a producer and consumes each event before observing producer completion.
  //
  // ## Parameters
  // - `Capacity`: Positive maximum number of buffered events.
  // - `Receive`: Asynchronous handler for one event, with the subscription token.
  //
  // ## Returns
  // A workflow returning the producer outcome after draining the channel and
  // joining the producer. Cancellation interrupts channel waits.
  public function Consume(Capacity: int; Receive: function(A, Threads.CancellationToken): Tasks.Task): Fx.Effect of (Fx.Completion, E, R);
  requires Capacity > 0;
    function Execute(Environment: R; Cancellation: Threads.CancellationToken): Tasks.Task of Fx.Outcome of (Fx.Completion, E);
      async function Read(Lifetime: S.Scope): Tasks.Task of Fx.Outcome of (Fx.Completion, E);
        async function Write(Producer: S.Scope): Tasks.Task of Fx.Outcome of (Fx.Completion, E);
          function Publish(Value: A): Tasks.Task;
          begin
            return Pipe.Writer.WriteAsync(Value, Producer.Token).AsTask();
          end function;
        begin
          try
            return await self.Produce(Environment, Publish, Producer.Token).ConfigureAwait(false);
          finally
            discard Pipe.Writer.TryComplete();
          end try;
        end function;
      begin
        const Pipe: Channels.Channel of A := Channels.Channel.CreateBounded of A(Capacity);
        const Producer: S.Child of Fx.Outcome of (Fx.Completion, E) := Lifetime.Fork of Fx.Outcome of (Fx.Completion, E)(
          Write
        );
        while await Pipe.Reader.WaitToReadAsync(Lifetime.Token).ConfigureAwait(false) do
          const Value: A := await Pipe.Reader.ReadAsync(Lifetime.Token).ConfigureAwait(false);
          await Receive(Value, Lifetime.Token).ConfigureAwait(false);
        end while;

        return await Producer.Join.ConfigureAwait(false);
      end function;
    begin
      return S.Scope.Use of Fx.Outcome of (Fx.Completion, E)(Read, Cancellation);
    end function;
  begin
    return Fx.Effect of (Fx.Completion, E, R).Defer(Execute);
  end function;
end record;

end unit;
