unit Fpas.Gui.Internal.Focus;

uses Fpas.Ui.Elements as E, Fpas.Ui.Validation as V, Fpas.Ui.Choices as Ch;

/// Finds the first enabled focus stop in the active modal/view scope.
/// <typeparam name="TMsg">Message type.</typeparam>
/// <param name="Node">Prepared subtree.</param>
/// <param name="Prepared">Resolved cached subviews.</param>
/// <param name="Preferred">Optional enabled ID to locate instead of the first stop.</param>
/// <returns>Its application ID, or null.</returns>
public function First<TMsg>(Node: E.Element<TMsg>; Prepared: V.Prepared<TMsg>; Preferred: string? := null): string?;
begin
  case Node of
    when E.Element.Action(const Id: string, _, _, const Enabled: bool, _):
      if Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.Toggle(const Id: string, _, _, _, const Enabled: bool):
      if Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.Editor(const Id: string, _, _, _, _, _, const Enabled: bool, _):
      if Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.ActionList(
      const Id: string,
      const Items: array of Ch.ListItem<TMsg>,
      const Enabled: bool
    ):
      if Enabled and (Preferred = null or Preferred = Id) then
        for Item: Ch.ListItem<TMsg> in Items do
          if Item.Enabled then
            return Id;
          end if;
        end for;
      end if;
    when E.Element.Selectable(
      const Id: string,
      const Items: array of Ch.SelectionItem,
      _,
      _,
      _,
      const Enabled: bool
    ):
      if Enabled and (Preferred = null or Preferred = Id) then
        for Item: Ch.SelectionItem in Items do
          if Item.Enabled then
            return Id;
          end if;
        end for;
      end if;
    when E.Element.TabSet(
      const Id: string,
      const Items: array of Ch.TabItem,
      _,
      _,
      const Panel: E.Element<TMsg>?,
      const Enabled: bool
    ):
      if Enabled and (Preferred = null or Preferred = Id) then
        for Item: Ch.TabItem in Items do
          if Item.Enabled then
            return Id;
          end if;
        end for;
      end if;

      if Panel <> null then
        return First<TMsg>(Panel, Prepared, Preferred);
      end if;
    when E.Element.TableView(
      const Id: string,
      _,
      const Rows: array of Ch.TableRow,
      _,
      _,
      _,
      const Enabled: bool
    ):
      if Enabled and (Preferred = null or Preferred = Id) then
        for Row: Ch.TableRow in Rows do
          if Row.Enabled then
            return Id;
          end if;
        end for;
      end if;
    when E.Element.Stack(const Children: array of E.Element<TMsg>, _, _):
      for Child: E.Element<TMsg> in Children do
        const Found: string? := First<TMsg>(Child, Prepared, Preferred);
        if Found <> null then
          return Found;
        end if;
      end for;
    when E.Element.Sized(const Child: E.Element<TMsg>, _):
      return First<TMsg>(Child, Prepared, Preferred);
    when E.Element.Styled(const Child: E.Element<TMsg>, _):
      return First<TMsg>(Child, Prepared, Preferred);
    when E.Element.Framed(const Child: E.Element<TMsg>, _):
      return First<TMsg>(Child, Prepared, Preferred);
    when E.Element.Scroll(_, const Child: E.Element<TMsg>, _, _, _):
      return First<TMsg>(Child, Prepared, Preferred);
    when E.Element.Modal(_, _, const Content: E.Element<TMsg>, _, _):
      return First<TMsg>(Content, Prepared, Preferred);
    when E.Element.Deferred(const Id: string, _):
      return First<TMsg>(Prepared.Subviews[Id].Tree, Prepared, Preferred);
    else
  end case;

  return null;
end function;

/// Finds the last/deepest active modal scope in traversal order.
/// <typeparam name="TMsg">Message type.</typeparam>
/// <param name="Node">Prepared subtree.</param>
/// <param name="Prepared">Resolved subviews.</param>
/// <returns>The top modal identity or null.</returns>
public function TopModal<TMsg>(Node: E.Element<TMsg>; Prepared: V.Prepared<TMsg>): string?;
begin
  case Node of
    when E.Element.Modal(const Id: string, _, const Content: E.Element<TMsg>, _, _):
      const Inner: string? := TopModal<TMsg>(Content, Prepared);
      return if Inner = null then Id else Inner end if;
    when E.Element.Stack(const Children: array of E.Element<TMsg>, _, _):
      var Found: string? := null;
      for Child: E.Element<TMsg> in Children do
        const Next: string? := TopModal<TMsg>(Child, Prepared);
        if Next <> null then
          Found := Next;
        end if;
      end for;

      return Found;
    when E.Element.Sized(const Child: E.Element<TMsg>, _):
      return TopModal<TMsg>(Child, Prepared);
    when E.Element.Styled(const Child: E.Element<TMsg>, _):
      return TopModal<TMsg>(Child, Prepared);
    when E.Element.Framed(const Child: E.Element<TMsg>, _):
      return TopModal<TMsg>(Child, Prepared);
    when E.Element.Scroll(_, const Child: E.Element<TMsg>, _, _, _):
      return TopModal<TMsg>(Child, Prepared);
    when E.Element.TabSet(_, _, _, _, const Panel: E.Element<TMsg>?, _):
      if Panel <> null then
        return TopModal<TMsg>(Panel, Prepared);
      end if;
    when E.Element.Deferred(const Id: string, _):
      return TopModal<TMsg>(Prepared.Subviews[Id].Tree, Prepared);
    else
  end case;

  return null;
end function;
end unit;
