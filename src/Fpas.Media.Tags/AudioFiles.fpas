// [Documentation](../../docs/pascal/libraries/media/tags.md#audio-properties-and-descriptive-tags)

// ATL is the parser; this boundary selects fields and detaches mutable values.
unit Fpas.Media.Tags.AudioFiles;

uses
  ATL as A, ATL.ChannelsArrangements.ChannelsArrangement as Channels,
  System.IO as IO, System as Sys,
  System.Collections.Generic as C, System.Globalization as G;

// Selected audio tags; missing text is empty and missing numeric values are null.
public type Info = record
  // Display title.
  public Title: string := '';
  // Optional subtitle/description supplied by ATL.
  public Subtitle: string := '';
  // Album title, without assuming that equal names identify the same release.
  public Album: string := '';
  // Ordered credited performers, using ATL's multi-value convention.
  public Artists: array of string := [];
  // Ordered album-wide artist credits.
  public AlbumArtists: array of string := [];
  // Ordered musical genres.
  public Genres: array of string := [];
  // Ordered composer credits.
  public Composers: array of string := [];
  // Release/recording date normalized from ATL to invariant ISO form.
  public ReleaseDate: string := '';
  // Original release date in invariant ISO form where supplied.
  public OriginalReleaseDate: string := '';
  // One-based track position, when supplied.
  public TrackNumber: int? := null;
  // Number of tracks on the disc.
  public TrackTotal: int? := null;
  // One-based disc position within the release.
  public DiscNumber: int? := null;
  // Number of discs in the release.
  public DiscTotal: int? := null;
  // Explicit title sort tag; empty when absent.
  public SortTitle: string := '';
  // Explicit performer sort tag, empty when absent.
  public SortArtist: string := '';
  // Explicit album-artist sort tag, empty when absent.
  public SortAlbumArtist: string := '';
  // Explicit album sort tag, empty when absent.
  public SortAlbum: string := '';
  // Whether the file is tagged as part of a compilation.
  public Compilation: bool := false;
  // File-supplied comment, independent of any user annotation.
  public Comment: string := '';
  // File-supplied musical grouping.
  public Grouping: string := '';
  // Publisher/label supplied by the file.
  public Label: string := '';
  // File-supplied copyright text.
  public Copyright: string := '';
  // Tempo in beats per minute where supplied.
  public Bpm: double? := null;
  // External recording identity, if present in the file.
  public MusicBrainzRecordingId: string := '';
  // External release identity, if present in the file.
  public MusicBrainzReleaseId: string := '';
  // Ordered external artist identities, where supplied.
  public MusicBrainzArtistIds: array of string := [];
  // Audio duration in milliseconds, without decoding the audio.
  public DurationMilliseconds: double? := null;
  // Format name detected by ATL.
  public Codec: string := '';
  // Average bitrate in kbit/s.
  public Bitrate: double? := null;
  // Sample rate in hertz.
  public SampleRate: double? := null;
  // Number of audio channels.
  public Channels: int? := null;
  // Bits per sample where meaningful for the format.
  public BitDepth: int? := null;
  // File-supplied track ReplayGain in dB.
  public ReplayGainTrack: double? := null;
  // File-supplied album ReplayGain in dB.
  public ReplayGainAlbum: double? := null;
  // File-supplied linear track peak.
  public ReplayPeakTrack: double? := null;
  // File-supplied linear album peak.
  public ReplayPeakAlbum: double? := null;
end record;

function Values(Text: string?): array of string;
begin
  return (Text ?? '').Split(
    [A.Settings.DisplayValueSeparator],
    Sys.StringSplitOptions.RemoveEmptyEntries or Sys.StringSplitOptions.TrimEntries
  );
end function;

function Key(Text: string): string;
begin
  var Result: string := Text.ToUpperInvariant().Replace('_', '').Replace(' ', '');
  if Result.StartsWith('TXXX:') then
    Result := Result.Substring(5);
  end if;

  return Result;
end function;

function Extra(Track: A.Track; Name: string): string;
begin
  const Fields: C.IDictionary<string?, string?>? := Track.AdditionalFields;
  if Fields <> null then
    for Pair: C.KeyValuePair<string?, string?> in Fields do
      if Key(Pair.Key ?? '') = Name then
        return Pair.Value ?? '';
      end if;
    end for;
  end if;

  return '';
end function;

function Number(Text: string): double?;
begin
  var Value: double := 0.0;
  if double.TryParse(
    Text.Replace('dB', '', Sys.StringComparison.OrdinalIgnoreCase).Trim(),
    G.NumberStyles.Float, G.CultureInfo.InvariantCulture, out Value
  ) and double.IsFinite(Value)
  then
    return Value;
  end if;

  return null;
end function;

function Date(Value: Sys.DateTime?): string;
begin
  return if Value <> null and Value > Sys.DateTime.MinValue then
    Value.Value.ToString('yyyy-MM-dd', G.CultureInfo.InvariantCulture)
  else
    ''
  end if;
end function;

function Positive(Value: int?): int?;
begin
  return if Value > 0 then
    Value
  else
    null
  end if;
end function;

function PositiveReal(Value: double?): double?;
begin
  return if Value > 0.0 and double.IsFinite(Value.Value) then
    Value
  else
    null
  end if;
end function;

// Reads descriptive tags and audio properties without loading embedded pictures.
// ## Parameters
// - `Stream`: Readable, seekable audio stream owned by the caller.
// - `Extension`: Audio file extension including its leading dot.
// ## Returns
// Detached metadata with ordered credits and nullable numeric properties.
public function Read(Stream: IO.Stream; Extension: string): Info;
requires Stream <> null;
begin
  if not Stream.CanRead or not Stream.CanSeek then
    raise new Sys.ArgumentException('Expected a readable, seekable audio stream.', 'Stream');
  end if;
  const Track: A.Track := new A.Track(Stream, Extension);
  if Track.DurationMs <= 0.0 then
    raise new IO.InvalidDataException('ATL could not read a supported audio stream.');
  end if;
  const Format: A.AudioFormat? := Track.AudioFormat;
  if Format = null then
    raise new Sys.InvalidOperationException('Missing audio format.');
  end if;
  const Arrangement: Channels? := Track.ChannelsArrangement;
  return new Info(
    Title := Track.Title ?? '', Subtitle := Track.Description ?? '',
    Album := Track.Album ?? '', Artists := Values(Track.Artist),
    AlbumArtists := Values(Track.AlbumArtist), Genres := Values(Track.Genre),
    Composers := Values(Track.Composer), ReleaseDate := Date(Track.Date),
    OriginalReleaseDate := Date(Track.OriginalReleaseDate),
    TrackNumber := Positive(Track.TrackNumber), TrackTotal := Positive(Track.TrackTotal),
    DiscNumber := Positive(Track.DiscNumber), DiscTotal := Positive(Track.DiscTotal),
    SortTitle := Track.SortTitle ?? '', SortArtist := Track.SortArtist ?? '',
    SortAlbumArtist := Track.SortAlbumArtist ?? '', SortAlbum := Track.SortAlbum ?? '',
    Compilation := Extra(Track, 'COMPILATION') = '1' or Extra(Track, 'TCMP') = '1',
    Comment := Track.Comment ?? '', Grouping := Track.Group ?? '', Label := Track.Publisher ?? '',
    Copyright := Track.Copyright ?? '', Bpm := PositiveReal(cast<double?>(Track.BPM)),
    MusicBrainzRecordingId := Extra(Track, 'MUSICBRAINZTRACKID'),
    MusicBrainzReleaseId := Extra(Track, 'MUSICBRAINZALBUMID'),
    MusicBrainzArtistIds := Values(Extra(Track, 'MUSICBRAINZARTISTID')),
    DurationMilliseconds := Track.DurationMs, Codec := Format.Name ?? '',
    Bitrate := PositiveReal(Track.Bitrate), SampleRate := PositiveReal(Track.SampleRate),
    Channels := if Arrangement <> null then
      Positive(Arrangement.NbChannels)
    else
      null
    end if,
    BitDepth := if Track.BitDepth > 0 then
      Track.BitDepth
    else
      null
    end if,
    ReplayGainTrack := Number(Extra(Track, 'REPLAYGAINTRACKGAIN')),
    ReplayGainAlbum := Number(Extra(Track, 'REPLAYGAINALBUMGAIN')),
    ReplayPeakTrack := Number(Extra(Track, 'REPLAYGAINTRACKPEAK')),
    ReplayPeakAlbum := Number(Extra(Track, 'REPLAYGAINALBUMPEAK'))
  );
end function;

end unit;
