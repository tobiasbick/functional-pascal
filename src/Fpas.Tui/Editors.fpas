unit Fpas.Tui.Editors;

uses Fpas.Tui.Elements as E;

/// Caret and anchor are UTF-16 offsets. View offsets are zero-based rows and cells.
public type EditorPosition = record
  public Caret: int := 0;
  public Anchor: int := 0;
  public TopRow: int := 0;
  public LeftColumn: int := 0;
  public PreferredColumn: int := -1;
  public FollowCaret: bool := true;
end record;

public type TextEdit = record
  public Text: string;
  public Position: EditorPosition;
end record;

/// Displays an app-owned document and reports edits separately from navigation.
public function Multiline<TMsg>(
  Id: string; Text: string; Position: EditorPosition; OnEdit: function(TextEdit): TMsg;
  OnNavigate: function(EditorPosition): TMsg
): E.Element<TMsg>;
begin
  return E.Element<TMsg>.DocumentEditor(Id, Text, Position, OnEdit, OnNavigate);
end function;
end unit;
