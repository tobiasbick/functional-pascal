unit Fpas.Tui.Internal.Hosting.Interaction;

uses
  Fpas.Tui.Elements as E, Fpas.Tui.Internal.Layout.Arrangement as A,
  Fpas.Tui.Internal.Hosting.Editing as Edit, Fpas.Tui.Internal.Rendering.Glyphs as G,
  System as Sys, System.Collections.Generic as Generic;

public type State<TMsg> = record
  public FocusId: function(): string;
  public HoverId: function(): string;
  public ScopeId: function(): string;
  public Reconcile: procedure(A.Layout<TMsg>);
  public Activate: procedure(A.Layout<TMsg>, string);
  public Click: procedure(A.Layout<TMsg>, int, int);
  public Pointer: procedure(A.Layout<TMsg>, E.PointerKind, int, int);
  public Scroll: procedure(A.Layout<TMsg>, int, int, int);
  public Key: procedure(A.Layout<TMsg>, E.Key, E.KeyModifiers);
  public Insert: procedure(A.Layout<TMsg>, string);
  public Selection: function(string, string): Edit.Selection;
end record;

public function Create<TMsg>(Apply: procedure(TMsg); ScrollOffsets: Generic.Dictionary<string, int>): State<TMsg>;
  function ActiveId(Layout: A.Layout<TMsg>): string;
  begin
    const Active: A.Scope<TMsg>? := Layout.Active;
    if Active <> null then
      return Active.Id;
    end if;

    return '';
  end function;

  function Eligible(Control: A.Control<TMsg>; Scope: string): bool;
  begin
    return Control.Enabled and Control.Scope = Scope;
  end function;

  procedure ReconcileFocus(Layout: A.Layout<TMsg>);
  begin
    const Scope: string := ActiveId(Layout);
    if Scope <> FocusScope then
      Captured := '';
      Hover := '';
      if FocusScope <> '' and Saved.ContainsKey(
        FocusScope
      ) and (Scope = '' or Saved.ContainsKey(Scope))
      then
        Focus := Saved[FocusScope];
        discard Saved.Remove(FocusScope);
      else
        if Scope <> '' then
          Saved[Scope] := Focus;
        end if;
        const Modal: A.Scope<TMsg>? := Layout.Active;
        Focus := if Modal = null then '' else Modal.Initial end if;
      end if;

      FocusScope := Scope;
    end if;

    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, Scope) and Control.Id = Focus then
        return;
      end if;
    end for;

    Focus := '';
    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, Scope) then
        Focus := Control.Id;
        return;
      end if;
    end for;
  end procedure;

  procedure Cycle(Layout: A.Layout<TMsg>; Backwards: bool);
  begin
    const Keys: Generic.List<string> := new Generic.List<string>();
    var Index: int := 0;
    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, FocusScope) then
        if Control.Id = Focus then
          Index := Keys.Count;
        end if;

        Keys.Add(Control.Id);
      end if;
    end for;

    if Keys.Count > 0 then
      Focus := Keys[(Index + (if Backwards then Keys.Count - 1 else 1 end if)) mod Keys.Count];
    end if;
  end procedure;

  function Focused(Layout: A.Layout<TMsg>): A.Control<TMsg>?;
  begin
    for Control: A.Control<TMsg> in Layout.Controls do
      if Control.Id = Focus and Eligible(Control, FocusScope) then
        return Control;
      end if;
    end for;

    return null;
  end function;

  function Hit(Layout: A.Layout<TMsg>; Column: int; Row: int): A.Control<TMsg>?;
  begin
    for Index: int := Layout.Controls.Length - 1 downto 0 do
      const Control: A.Control<TMsg> := Layout.Controls[Index];
      if Control.Scope = FocusScope and Control.Bounds.Contains(Column, Row) then
        if Control.Enabled then
          return Control;
        end if;

        return null;
      end if;
    end for;

    return null;
  end function;

  procedure ClickAt(Layout: A.Layout<TMsg>; Column: int; Row: int);
  begin
    const Control: A.Control<TMsg>? := Hit(Layout, Column, Row);
    if Control = null then
      return;
    end if;

    Focus := Control.Id;
    case Control.Action of
      when A.Binding.Invoke(const Message: TMsg):
        Apply(Message);
      when A.Binding.Edit(const Value: string, _):
        const Start: int := G.ViewStart(
          Value,
          SelectionFor(Control.Id, Value).Caret,
          Control.Bounds.Width - 2
        );
        const Position: int := G.IndexAt(Value, Start, Column - Control.Bounds.X - 2);
        Selections[Control.Id] := new Edit.Selection(Position, Position);
      when A.Binding.Canvas(const X: int, const Y: int, const Click: function(int, int): TMsg):
        Apply(Click(Column - X, Row - Y));
    end case;
  end procedure;

  procedure Point(Layout: A.Layout<TMsg>; Kind: E.PointerKind; Column: int; Row: int);
  begin
    const Target: A.Control<TMsg>? := Hit(Layout, Column, Row);
    Hover := if Target = null then '' else Target.Id end if;
    case Kind of
      when E.PointerKind.Press:
        Captured := Hover;
        if Captured <> '' then
          Focus := Captured;
        end if;
      when E.PointerKind.Release:
        const Held: string := Captured;
        Captured := '';
        if Held <> '' and Held = Hover then
          ClickAt(Layout, Column, Row);
        end if;
      else
    end case;
  end procedure;

  function SelectionFor(Id: string; Value: string): Edit.Selection;
  begin
    if Selections.ContainsKey(Id) then
      const Previous: Edit.Selection := Selections[Id];
      return new Edit.Selection(
        Edit.Clamp(Value, Previous.Caret),
        Edit.Clamp(Value, Previous.Anchor)
      );
    end if;

    return new Edit.Selection(Value.Length, Value.Length);
  end function;

  procedure Replace(Id: string; Value: string; Selection: Edit.Selection; Insert: string; Change: function(string): TMsg);
  begin
    const First: int := Sys.Math.Min(Selection.Caret, Selection.Anchor);
    const Last: int := Sys.Math.Max(Selection.Caret, Selection.Anchor);
    const Caret: int := First + Insert.Length;
    Selections[Id] := new Edit.Selection(Caret, Caret);
    Apply(Change(Value.Substring(0, First) + Insert + Value.Substring(Last)));
  end procedure;

  function EditKey(Id: string; Value: string; Change: function(string): TMsg; Key: E.Key; Modifiers: E.KeyModifiers): bool;
  begin
    const Selection: Edit.Selection := SelectionFor(Id, Value);
    var Caret: int := Selection.Caret;
    case Key of
      when E.Key.Left:
        Caret := Edit.Previous(Value, Caret);
      when E.Key.Right:
        Caret := Edit.Next(Value, Caret);
      when E.Key.Home:
        Caret := 0;
      when E.Key.End:
        Caret := Value.Length;
      when E.Key.A:
        if Modifiers <> E.KeyModifiers.Ctrl then
          return false;
        end if;

        Selections[Id] := new Edit.Selection(Value.Length, 0);
        return true;
      when E.Key.Backspace, E.Key.Delete:
        var Deletion: Edit.Selection := Selection;
        if Selection.Caret = Selection.Anchor then
          const Other: int := if Key = E.Key.Backspace then Edit.Previous(
              Value,
              Caret
            )
            else Edit.Next(Value, Caret)
            end if;
          Deletion := new Edit.Selection(Caret, Other);
        end if;

        Replace(Id, Value, Deletion, '', Change);
        return true;
      else
        return false;
    end case;

    Selections[Id] := new Edit.Selection(
      Caret,
      if Modifiers = E.KeyModifiers.Shift then Selection.Anchor else Caret end if
    );
    return true;
  end function;

  procedure RouteKey(Layout: A.Layout<TMsg>; Key: E.Key; Modifiers: E.KeyModifiers);
  begin
    if Key = E.Key.Tab and (Modifiers = E.KeyModifiers.None or Modifiers =
      E.KeyModifiers.Shift)
    then
      Cycle(Layout, Modifiers = E.KeyModifiers.Shift);
      return;
    end if;
    const Modal: A.Scope<TMsg>? := Layout.Active;
    if Modal <> null and Key = E.Key.Escape then
      case Modal.Escape of
        when E.EscapeBinding.Send(const Message: TMsg):
          Apply(Message);
          return;
        when E.EscapeBinding.None:
      end case;
    end if;
    const Control: A.Control<TMsg>? := Focused(Layout);
    if Control <> null then
      case Control.Action of
        when A.Binding.Invoke(const Message: TMsg):
          if Key = E.Key.Enter then
            Apply(Message);
            return;
          end if;

          if Key = E.Key.Up or Key = E.Key.Down then
            Cycle(Layout, Key = E.Key.Up);
            return;
          end if;
        when A.Binding.Edit(const Value: string, const Change: function(string): TMsg):
          if EditKey(Control.Id, Value, Change, Key, Modifiers) then
            return;
          end if;
        when A.Binding.Canvas(_, _, _):
      end case;
    end if;
    const Keys: array of E.ShortcutBinding<TMsg> := if Modal = null then Layout.GlobalKeys
      else Modal.Shortcuts
      end if;
    for Shortcut: E.ShortcutBinding<TMsg> in Keys do
      if Shortcut.PressedKey = Key and Shortcut.Modifiers = Modifiers then
        Apply(Shortcut.Message);
        return;
      end if;
    end for;
  end procedure;

  procedure Activate(Layout: A.Layout<TMsg>; Id: string);
  begin
    for Control: A.Control<TMsg> in Layout.Controls do
      if Control.Id = Id and Eligible(Control, FocusScope) then
        ClickAt(
          Layout,
          Control.Bounds.X + Control.Bounds.Width div 2,
          Control.Bounds.Y + Control.Bounds.Height div 2
        );
        return;
      end if;
    end for;
  end procedure;

  procedure ScrollAt(Layout: A.Layout<TMsg>; Column: int; Row: int; Delta: int);
  begin
    for Index: int := Layout.Regions.Length - 1 downto 0 do
      const Region: A.ScrollRegion := Layout.Regions[Index];
      if Region.Scope = FocusScope and Region.Bounds.Contains(Column, Row) then
        const Before: int := if ScrollOffsets.ContainsKey(
            Region.Id
          ) then ScrollOffsets[Region.Id]
          else 0
          end if;
        ScrollOffsets[Region.Id] := cast<int>(Sys.Math.Clamp(
          cast<long>(Before) + cast<long>(Delta),
          0L,
          cast<long>(Region.Maximum)
        ));
        return;
      end if;
    end for;
  end procedure;

  procedure Insert(Layout: A.Layout<TMsg>; Text: string);
  begin
    const Control: A.Control<TMsg>? := Focused(Layout);
    if Control <> null then
      case Control.Action of
        when A.Binding.Edit(const Value: string, const Change: function(string): TMsg):
          Replace(Control.Id, Value, SelectionFor(Control.Id, Value), G.SingleLine(Text), Change);
        else
      end case;
    end if;
  end procedure;
begin
  const Selections: Generic.Dictionary<string, Edit.Selection> := new Generic.Dictionary<string, Edit.Selection>();
  const Saved: Generic.Dictionary<string, string> := new Generic.Dictionary<string, string>();
  var Focus: string := '';
  var Hover: string := '';
  var Captured: string := '';
  var FocusScope: string := '';
  return new State<TMsg>(
    function(): string => Focus, function(): string => Hover, function(): string => FocusScope,
    ReconcileFocus, Activate, ClickAt, Point, ScrollAt, RouteKey, Insert, SelectionFor
  );
end function;
end unit;
