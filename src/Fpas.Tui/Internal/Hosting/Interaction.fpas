unit Fpas.Tui.Internal.Hosting.Interaction;

uses
  Fpas.Tui.Elements as E, Fpas.Tui.Application as App, Fpas.Tui.Internal.Layout.Scene as A,
  Fpas.Tui.Internal.Controls.Activation as Actions,
  Fpas.Tui.Internal.Controls.Selection as SelectionOps,
  Fpas.Tui.Internal.Layout.TabHeaders as Tabs, Fpas.Tui.Internal.Hosting.TabNavigation as TabKeys,
  Fpas.Tui.Internal.Layout.SelectionLists as S, Fpas.Tui.Internal.Hosting.ListNavigation as Lists,
  Fpas.Tui.Internal.Layout.ScrollViews as V, Fpas.Tui.Internal.Hosting.ScrollNavigation as Scrolling,
  Fpas.Tui.Internal.Hosting.Editing as Edit, Fpas.Tui.Internal.Controls.TextEditing as TextEditing,
  Fpas.Tui.Internal.Hosting.SingleLineEditor as Single, Fpas.Tui.Internal.Hosting.MultilineEditor as Multi,
  Fpas.Tui.Internal.Layout.EditorView as EditorView,
  System as Sys, System.Collections.Generic as Generic;

public type State<TMsg> = record
  public FocusId: function(): string;
  public HoverId: function(): string;
  public ScopeId: function(): string;
  public Reconcile: procedure(A.Layout<TMsg>, A.Layout<TMsg>?);
  public SetFocus: procedure(A.Layout<TMsg>, string);
  public Activate: procedure(A.Layout<TMsg>, string);
  public Click: procedure(A.Layout<TMsg>, E.MouseButton, int, int);
  public Pointer: procedure(A.Layout<TMsg>, E.PointerKind, E.MouseButton, int, int);
  public Scroll: procedure(A.Layout<TMsg>, int, int, int);
  public Key: procedure(A.Layout<TMsg>, E.Key, E.KeyModifiers);
  public Insert: procedure(A.Layout<TMsg>, string, bool);
  public Selection: function(string, string): Edit.Selection;
end record;

public function Create<TMsg>(Apply: procedure(TMsg); ScrollOffsets: Generic.Dictionary<string, int>): State<TMsg>;
  function ActiveId(Layout: A.Layout<TMsg>): string;
  begin
    const Active: A.Scope<TMsg>? := Layout.Active;
    if Active <> null then
      return Active.Id;
    end if;

    return '';
  end function;

  function Eligible(Control: A.Control<TMsg>; Scope: string): bool;
  begin
    return Control.Enabled and Control.Scope = Scope;
  end function;

  procedure SetFocus(Layout: A.Layout<TMsg>; Id: string);
  begin
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
    if Control <> null and Eligible(Control, FocusScope) then
      Focus := Control.Id;
    end if;
  end procedure;

  function Invoke(Control: A.Control<TMsg>): bool;
  begin
    const Handler: Actions.IActivatable<TMsg>? := A.Activatable<TMsg>(Control.Action);
    if Handler = null then
      return false;
    end if;

    case Handler.Activate() of
      when Actions.Result.Send(const Message: TMsg):
        Apply(Message);
      when Actions.Result.NoAction:
    end case;

    return true;
  end function;

  procedure ReconcileFocus(Layout: A.Layout<TMsg>; Previous: A.Layout<TMsg>?);
  begin
    const Scope: string := ActiveId(Layout);
    if Scope <> FocusScope then
      Captured := '';
      MiddleCaptured := '';
      Hover := '';
      if FocusScope <> '' and Saved.ContainsKey(
        FocusScope
      ) and (Scope = '' or Saved.ContainsKey(Scope))
      then
        Focus := Saved[FocusScope];
        discard Saved.Remove(FocusScope);
      else
        if Scope <> '' then
          Saved[Scope] := Focus;
        end if;
        const Modal: A.Scope<TMsg>? := Layout.Active;
        Focus := if Modal = null then '' else Modal.Initial end if;
      end if;

      FocusScope := Scope;
    end if;

    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, Scope) and Control.Id = Focus then
        return;
      end if;
    end for;

    var Old: A.Control<TMsg>? := A.FindControl<TMsg>(Previous, Focus);
    while Old <> null and Old.FocusReturn <> '' do
      const Parent: string := Old.FocusReturn;
      const Candidate: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Parent);
      if Candidate <> null and Eligible(Candidate, Scope) then
        Focus := Candidate.Id;
        return;
      end if;

      Old := A.FindControl<TMsg>(Previous, Parent);
    end while;

    Focus := '';
    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, Scope) then
        Focus := Control.Id;
        return;
      end if;
    end for;
  end procedure;

  procedure Cycle(Layout: A.Layout<TMsg>; Backwards: bool);
  begin
    const Keys: Generic.List<string> := new Generic.List<string>();
    var Index: int := 0;
    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, FocusScope) then
        if Control.Id = Focus then
          Index := Keys.Count;
        end if;

        Keys.Add(Control.Id);
      end if;
    end for;

    if Keys.Count > 0 then
      Focus := Keys[(Index + (if Backwards then Keys.Count - 1 else 1 end if)) mod Keys.Count];
    end if;
  end procedure;

  function Focused(Layout: A.Layout<TMsg>): A.Control<TMsg>?;
  begin
    for Control: A.Control<TMsg> in Layout.Controls do
      if Control.Id = Focus and Eligible(Control, FocusScope) then
        return Control;
      end if;
    end for;

    return null;
  end function;

  function Hit(Layout: A.Layout<TMsg>; Column: int; Row: int): A.Control<TMsg>?;
  begin
    for Index: int := Layout.Controls.Length - 1 downto 0 do
      const Control: A.Control<TMsg> := Layout.Controls[Index];
      if Control.Scope = FocusScope and Control.Bounds.Contains(Column, Row) then
        if Control.Enabled then
          return Control;
        end if;

        return null;
      end if;
    end for;

    return null;
  end function;

  procedure ClickAt(Layout: A.Layout<TMsg>; Button: E.MouseButton; Column: int; Row: int);
  begin
    const Control: A.Control<TMsg>? := Hit(Layout, Column, Row);
    if Control = null or (Button = E.MouseButton.Middle and Control.Role <> 'canvas') then
      return;
    end if;

    Focus := Control.Id;
    case Control.Action of
      when A.Binding.Invoke(_):
        discard Invoke(Control);
      when A.Binding.Edit(_, _, _), A.Binding.Multiline(_):
        const Editor: TextEditing.ITextEditor? := EditorFor(Control);
        if Editor <> null then
          Editor.Place(Column - Control.Bounds.X, Row - Control.Bounds.Y);
        end if;
      when A.Binding.SelectList(const List: S.Viewport<TMsg>):
        SelectionOps.SelectAt<TMsg>(List, List.First + Row - Control.Bounds.Y, Apply);
      when A.Binding.SelectTab(const Bar: Tabs.Header<TMsg>):
        SelectionOps.SelectAt<TMsg>(Bar, Bar.Targets[Column - Control.Bounds.X], Apply);
      when A.Binding.Scroll(_):
      when A.Binding.Canvas(const X: int, const Y: int, const Events: E.CanvasEvents<TMsg>):
        const Click: Sys.Func<int, int, TMsg>? := if Button = E.MouseButton.Left then Events.OnClick
          else Events.OnMiddleClick
          end if;
        case Click of
          when is Sys.Func<int, int, TMsg> as Callback:
            Apply(Callback.Invoke(Column - X, Row - Y));
          else
        end case;
    end case;
  end procedure;

  procedure Point(Layout: A.Layout<TMsg>; Kind: E.PointerKind; Button: E.MouseButton; Column: int; Row: int);
  begin
    const Target: A.Control<TMsg>? := Hit(Layout, Column, Row);
    Hover := if Target = null then '' else Target.Id end if;
    case Kind of
      when E.PointerKind.Press:
        if Button = E.MouseButton.Left then
          Captured := Hover;
          if Captured <> '' then
            Focus := Captured;
          end if;
        else
          MiddleCaptured := Hover;
        end if;
      when E.PointerKind.Release:
        const Held: string := if Button = E.MouseButton.Left then Captured
          else MiddleCaptured
          end if;
        if Button = E.MouseButton.Left then
          Captured := '';
        else
          MiddleCaptured := '';
        end if;

        if Held <> '' and Held = Hover then
          ClickAt(Layout, Button, Column, Row);
        end if;
      else
    end case;
  end procedure;

  function SelectionFor(Id: string; Value: string): Edit.Selection;
  begin
    if Selections.ContainsKey(Id) then
      const Previous: Edit.Selection := Selections[Id];
      return new Edit.Selection(
        Edit.Clamp(Value, Previous.Caret),
        Edit.Clamp(Value, Previous.Anchor)
      );
    end if;

    return new Edit.Selection(Value.Length, Value.Length);
  end function;

  function EditorFor(Control: A.Control<TMsg>): TextEditing.ITextEditor?;
  begin
    case Control.Action of
      when A.Binding.Edit(const Value: string, const Change: function(string): TMsg, _):
        const Id: string := Control.Id;
        const Save: procedure(Edit.Selection) := procedure(Range: Edit.Selection) begin
          Selections[Id] := Range;
        end procedure;
        return new Single.Handler<TMsg>(
          Value,
          SelectionFor(Id, Value),
          Control.Bounds.Width,
          Save,
          Change,
          Apply
        );
      when A.Binding.Multiline(const View: EditorView.Viewport<TMsg>):
        return new Multi.Handler<TMsg>(View, Apply);
      else
        return null;
    end case;
  end function;

  procedure RouteKey(Layout: A.Layout<TMsg>; Key: E.Key; Modifiers: E.KeyModifiers);
  begin
    if Key = E.Key.Tab and (Modifiers = E.KeyModifiers.None or Modifiers =
      E.KeyModifiers.Shift)
    then
      Cycle(Layout, Modifiers = E.KeyModifiers.Shift);
      return;
    end if;
    const Modal: A.Scope<TMsg>? := Layout.Active;
    if Modal <> null and Key = E.Key.Escape then
      case Modal.Escape of
        when E.EscapeBinding.Send(const Message: TMsg):
          Apply(Message);
          return;
        when E.EscapeBinding.None:
      end case;
    end if;
    const Control: A.Control<TMsg>? := Focused(Layout);
    if Control <> null then
      if Key = E.Key.Enter and Modifiers = E.KeyModifiers.None and Invoke(Control) then
        return;
      end if;

      case Control.Action of
        when A.Binding.Invoke(_):
          if Key = E.Key.Up or Key = E.Key.Down then
            Cycle(Layout, Key = E.Key.Up);
            return;
          end if;
        when A.Binding.Edit(_, _, _), A.Binding.Multiline(_):
          const Editor: TextEditing.ITextEditor? := EditorFor(Control);
          if Editor <> null and Editor.Key(Key, Modifiers) then
            return;
          end if;
        when A.Binding.SelectList(const List: S.Viewport<TMsg>):
          const Id: string := Control.Id;
          const Scroll: procedure(int) := procedure(First: int) begin
            ScrollOffsets[Id] := First;
          end procedure;
          if Lists.Key<TMsg>(List, Key, Modifiers, Apply, Scroll) then
            return;
          end if;
        when A.Binding.SelectTab(const Bar: Tabs.Header<TMsg>):
          if TabKeys.Key<TMsg>(Bar, Key, Modifiers, Apply) then
            return;
          end if;
        when A.Binding.Scroll(const View: V.Viewport<TMsg>):
          if Scrolling.Key<TMsg>(View, Key, Modifiers, Apply) then
            return;
          end if;
        when A.Binding.Canvas(_, _, _):
      end case;
    end if;
    const Keys: array of E.ShortcutBinding<TMsg> := if Modal = null then Layout.GlobalKeys
      else Modal.Shortcuts
      end if;
    for Shortcut: E.ShortcutBinding<TMsg> in Keys do
      if Shortcut.Character = '' and Shortcut.PressedKey = Key and Shortcut.Modifiers =
        Modifiers
      then
        Apply(Shortcut.Message);
        return;
      end if;
    end for;
  end procedure;

  procedure Activate(Layout: A.Layout<TMsg>; Id: string);
  begin
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
    if Control <> null and Eligible(Control, FocusScope) then
      discard Invoke(Control);
    end if;
  end procedure;

  procedure ScrollAt(Layout: A.Layout<TMsg>; Column: int; Row: int; Delta: int);
  begin
    const Control: A.Control<TMsg>? := Hit(Layout, Column, Row);
    if Control <> null then
      case Control.Action of
        when A.Binding.Multiline(const View: EditorView.Viewport<TMsg>):
          Multi.Scroll<TMsg>(View, Delta, Apply);
          return;
        when A.Binding.Canvas(const X: int, const Y: int, const Events: E.CanvasEvents<TMsg>):
          const Wheel: Sys.Func<int, int, int, TMsg>? := Events.OnScroll;
          case Wheel of
            when is Sys.Func<int, int, int, TMsg> as Callback:
              Apply(Callback.Invoke(Column - X, Row - Y, Delta));
              return;
            else
          end case;
        else
      end case;
    end if;

    for Index: int := Layout.Regions.Length - 1 downto 0 do
      const Region: A.ScrollRegion := Layout.Regions[Index];
      if Region.Scope = FocusScope and Region.Bounds.Contains(Column, Row) then
        if Region.Controlled then
          const Target: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Region.Id);
          if Target <> null then
            case Target.Action of
              when A.Binding.Scroll(const View: V.Viewport<TMsg>):
                Scrolling.Move<TMsg>(View, Delta, Apply);
              else
            end case;
          end if;

          return;
        end if;
        const Before: int := if ScrollOffsets.ContainsKey(
            Region.Id
          ) then ScrollOffsets[Region.Id]
          else 0
          end if;
        ScrollOffsets[Region.Id] := cast<int>(Sys.Math.Clamp(
          cast<long>(Before) + cast<long>(Delta),
          0L,
          cast<long>(Region.Maximum)
        ));
        return;
      end if;
    end for;
  end procedure;

  procedure Insert(Layout: A.Layout<TMsg>; Text: string; Typed: bool);
  begin
    const Control: A.Control<TMsg>? := Focused(Layout);
    if Control <> null then
      const Editor: TextEditing.ITextEditor? := EditorFor(Control);
      if Editor <> null then
        Editor.Insert(Text);
        return;
      end if;
    end if;

    if Typed and Text <> '' then
      const Modal: A.Scope<TMsg>? := Layout.Active;
      const Keys: array of E.ShortcutBinding<TMsg> := if Modal = null then Layout.GlobalKeys
        else Modal.Shortcuts
        end if;
      for Shortcut: E.ShortcutBinding<TMsg> in Keys do
        if Shortcut.Character = Text then
          Apply(Shortcut.Message);
          return;
        end if;
      end for;
    end if;
  end procedure;
begin
  const Selections: Generic.Dictionary<string, Edit.Selection> := new Generic.Dictionary<string, Edit.Selection>();
  const Saved: Generic.Dictionary<string, string> := new Generic.Dictionary<string, string>();
  var Focus: string := '';
  var Hover: string := '';
  var Captured: string := '';
  var MiddleCaptured: string := '';
  var FocusScope: string := '';
  return new State<TMsg>(
    function(): string => Focus, function(): string => Hover, function(): string => FocusScope,
    ReconcileFocus, SetFocus, Activate, ClickAt, Point, ScrollAt, RouteKey, Insert, SelectionFor
  );
end function;

public procedure Dispatch<TMsg>(Routing: State<TMsg>; Layout: A.Layout<TMsg>; Event: App.Input);
begin
  case Event of
    when App.Input.Focus(const Id: string):
      Routing.SetFocus(Layout, Id);
    when App.Input.Activate(const Id: string):
      Routing.Activate(Layout, Id);
    when App.Input.Click(const Column: int, const Row: int):
      Routing.Click(Layout, E.MouseButton.Left, Column, Row);
    when App.Input.ButtonClick(const Button: E.MouseButton, const Column: int, const Row: int):
      Routing.Click(Layout, Button, Column, Row);
    when App.Input.Pointer(const Kind: E.PointerKind, const Column: int, const Row: int):
      Routing.Pointer(Layout, Kind, E.MouseButton.Left, Column, Row);
    when App.Input.ButtonPointer(
      const Kind: E.PointerKind,
      const Button: E.MouseButton,
      const Column: int,
      const Row: int
    ):
      Routing.Pointer(Layout, Kind, Button, Column, Row);
    when App.Input.Scroll(const Column: int, const Row: int, const Delta: int):
      Routing.Scroll(Layout, Column, Row, Delta);
    when App.Input.KeyPress(const Key: E.Key, const Modifiers: E.KeyModifiers):
      Routing.Key(Layout, Key, Modifiers);
    when App.Input.Character(const Text: string):
      Routing.Insert(Layout, Text, true);
    when App.Input.TextInput(const Text: string), App.Input.Paste(const Text: string):
      Routing.Insert(Layout, Text, false);
    when App.Input.Resize(_, _):
  end case;
end procedure;
end unit;
