unit Fpas.Tui.Internal.Hosting.ListNavigation;

uses
  Fpas.Tui.Elements as E, Fpas.Tui.Internal.Layout.SelectionLists as S,
  Fpas.Tui.Internal.Controls.Selection as Selections, System as Sys;

public function Key<TMsg>(
  List: S.Viewport<TMsg>; Pressed: E.Key; Modifiers: E.KeyModifiers; Apply: procedure(TMsg);
  Scroll: procedure(int)
): bool;
begin
  if Modifiers <> E.KeyModifiers.None then
    return false;
  end if;
  const Last: int := List.Items.Length - 1;
  var Next: int := List.Selected;
  case Pressed of
    when E.Key.Up:
      Next := if Next < 0 then Last else Next - 1 end if;
    when E.Key.Down:
      Next := Next + 1;
    when E.Key.Home:
      Next := 0;
    when E.Key.End:
      Next := Last;
    when E.Key.PageUp:
      Next := if Next < 0 then Last else Next - List.Rows end if;
    when E.Key.PageDown:
      Next := if Next < 0 then 0 else Next + List.Rows end if;
    else
      return false;
  end case;

  const Index: int := Sys.Math.Clamp(Next, 0, Last);
  if Index = List.Selected then
    Scroll(S.Reveal(Index, List.First, List.Rows));
  else
    Selections.SelectAt<TMsg>(List, Index, Apply);
  end if;

  return true;
end function;
end unit;
