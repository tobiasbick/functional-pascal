unit Fpas.Tui.Internal.Hosting.MultilineEditor;

uses Fpas.Ui.TerminalExtensions.Input as K, Fpas.Tui.Internal.View.Editors as Editors, Fpas.Tui.Internal.Layout.EditorView as View, Fpas.Tui.Internal.Controls.TextEditing as TextEditing, Fpas.Tui.Internal.Hosting.Editing as Edit, Fpas.Tui.Internal.Controls.Activation as Actions, Fpas.Tui.Internal.Rendering.Glyphs as G, System as Sys;

const NewLine: string := new string(#10, 1);
const ExtendDocument: K.KeyModifiers := cast<K.KeyModifiers>(cast<int>(K.KeyModifiers.Ctrl)
  or cast<int>(K.KeyModifiers.Shift));

public type Handler<TMsg> = record implements TextEditing.ITextEditor
  public Viewport: View.Viewport<TMsg>;
  public Apply: procedure(TMsg);

  procedure Navigate(Requested: Editors.EditorPosition);
  begin
    const Document: View.Document := self.Viewport.Document;
    const Position: Editors.EditorPosition := View.Resolve(Document, Requested);
    if Position <> Document.Position then
      case self.Viewport.Events.Navigate(Position) of
        when Actions.Result.Send(const Message: TMsg):
          self.Apply(Message);
        when Actions.Result.NoAction:
      end case;
    end if;
  end procedure;

  procedure Move(Caret: int; Extend: bool; PreferredColumn: int := -1);
  begin
    const Current: Editors.EditorPosition := self.Viewport.Document.Position;
    self.Navigate(
      Current with
        Caret := Caret;
        Anchor := if Extend then Current.Anchor else Caret end if;
        PreferredColumn := PreferredColumn;
        FollowCaret := true;
      end with
    );
  end procedure;

  procedure Commit(Change: Edit.Change);
  begin
    const Document: View.Document := self.Viewport.Document;
    const Requested: Editors.EditorPosition := Document.Position with
      Caret := Change.Caret;
      Anchor := Change.Caret;
      PreferredColumn := -1;
      FollowCaret := true;
    end with;
    if Change.Text = Document.Text then
      self.Navigate(Requested);
      return;
    end if;

    const Updated: View.Document := View.Arrange(Change.Text, Document.Area, Requested);
    self.Apply(self.Viewport.Events.Edit(new Editors.TextEdit(Updated.Text, Updated.Position)));
  end procedure;

  public procedure Insert(Text: string);
  begin
    if Text = '' then
      return;
    end if;
    const Document: View.Document := self.Viewport.Document;
    const Position: Editors.EditorPosition := Document.Position;
    const Normalized: string := Text.Replace(
      new string([#13, #10]),
      NewLine
    ).Replace(#13, #10).Replace(#8232, #10).Replace(#8233, #10);
    self.Commit(
      Edit.Replace(
        Document.Text,
        new Edit.Selection(Position.Caret, Position.Anchor),
        if self.Viewport.MultipleLines then Normalized else G.SingleLine(Normalized) end if
      )
    );
  end procedure;

  public procedure Place(Column: int; Row: int);
  begin
    const Document: View.Document := self.Viewport.Document;
    const Position: Editors.EditorPosition := Document.Position;
    self.Move(
      View.IndexAt(
        Document,
        Position.TopRow + Row,
        Position.LeftColumn + Column - (if self.Viewport.MultipleLines then 0 else 2 end if)
      ),
      false
    );
  end procedure;

  public function Key(Pressed: K.Key; Modifiers: K.KeyModifiers): bool;
  begin
    const Document: View.Document := self.Viewport.Document;
    const Position: Editors.EditorPosition := Document.Position;
    const Extend: bool := Modifiers = K.KeyModifiers.Shift or Modifiers = ExtendDocument;
    if not self.Viewport.MultipleLines and (Pressed = K.Key.Enter or Pressed = K.Key.Up or Pressed =
      K.Key.Down or Pressed = K.Key.PageUp or Pressed = K.Key.PageDown)
    then
      return false;
    end if;

    if Modifiers = K.KeyModifiers.Ctrl or Modifiers = ExtendDocument then
      case Pressed of
        when K.Key.Home:
          self.Move(0, Extend);
        when K.Key.End:
          self.Move(Document.Text.Length, Extend);
        when K.Key.A:
          if Extend then
            return false;
          end if;

          self.Navigate(
            Position with
              Caret := Document.Text.Length;
              Anchor := 0;
              PreferredColumn := -1;
              FollowCaret := true;
            end with
          );
        else
          return false;
      end case;

      return true;
    end if;

    if Modifiers <> K.KeyModifiers.None and Modifiers <> K.KeyModifiers.Shift then
      return false;
    end if;

    case Pressed of
      when K.Key.Enter:
        if Extend then
          return false;
        end if;

        self.Insert(NewLine);
      when K.Key.Backspace, K.Key.Delete:
        self.Commit(
          Edit.Delete(
            Document.Text,
            new Edit.Selection(Position.Caret, Position.Anchor),
            Pressed = K.Key.Backspace
          )
        );
      when K.Key.Left:
        const First: int := Sys.Math.Min(Position.Caret, Position.Anchor);
        self.Move(
          if not Extend and Position.Caret <> Position.Anchor then First
            else Edit.Previous(Document.Text, Position.Caret)
            end if, Extend
        );
      when K.Key.Right:
        const Last: int := Sys.Math.Max(Position.Caret, Position.Anchor);
        self.Move(
          if not Extend and Position.Caret <> Position.Anchor then Last
            else Edit.Next(Document.Text, Position.Caret)
            end if, Extend
        );
      when K.Key.Home, K.Key.End:
        const Line: View.Line := Document.Lines[View.RowAt(Document.Lines, Position.Caret)];
        self.Move(
          if Pressed = K.Key.Home then Line.Start else Line.Start + Line.Text.Length end if,
          Extend
        );
      when K.Key.Up, K.Key.Down, K.Key.PageUp, K.Key.PageDown:
        const Row: int := View.RowAt(Document.Lines, Position.Caret);
        const Goal: int := if Position.PreferredColumn >= 0 then Position.PreferredColumn
          else View.ColumnAt(Document.Lines[Row], Position.Caret)
          end if;
        const Delta: int := case Pressed of
          when K.Key.Up: -1;
          when K.Key.Down: 1;
          when K.Key.PageUp: -Document.Area.Height;
          else Document.Area.Height;
        end case;
        const Target: int := Sys.Math.Clamp(Row + Delta, 0, Document.Lines.Length - 1);
        self.Move(View.IndexAt(Document, Target, Goal), Extend, Goal);
      else
        return false;
    end case;

    return true;
  end function;
end record;

public procedure Scroll<TMsg>(Viewport: View.Viewport<TMsg>; Delta: int; Apply: procedure(TMsg));
begin
  const Position: Editors.EditorPosition := Viewport.Document.Position;
  const Top: int := cast<int>(Sys.Math.Clamp(
    cast<long>(Position.TopRow) + cast<long>(Delta),
    0L,
    cast<long>(View.MaximumTop(Viewport.Document))
  ));
  if Top <> Position.TopRow then
    case Viewport.Events.Navigate(
      Position with
        TopRow := Top;
        FollowCaret := false;
      end with
    ) of
      when Actions.Result.Send(const Message: TMsg):
        Apply(Message);
      when Actions.Result.NoAction:
    end case;
  end if;
end procedure;
end unit;
