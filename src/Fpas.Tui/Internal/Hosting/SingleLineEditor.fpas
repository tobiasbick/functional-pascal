unit Fpas.Tui.Internal.Hosting.SingleLineEditor;

uses
  Fpas.Tui.Elements as E, Fpas.Tui.Internal.Controls.TextEditing as TextEditing,
  Fpas.Tui.Internal.Hosting.Editing as Edit, Fpas.Tui.Internal.Rendering.Glyphs as G;

public type Handler<TMsg> = record implements TextEditing.ITextEditor
  public Value: string;
  public Range: Edit.Selection;
  public Width: int;
  public SetSelection: procedure(Edit.Selection);
  public Change: function(string): TMsg;
  public Apply: procedure(TMsg);

  procedure Commit(Change: Edit.Change);
  begin
    self.SetSelection(new Edit.Selection(Change.Caret, Change.Caret));
    self.Apply(self.Change(Change.Text));
  end procedure;

  public procedure Insert(Text: string);
  begin
    self.Commit(Edit.Replace(self.Value, self.Range, G.SingleLine(Text)));
  end procedure;

  public procedure Place(Column: int; Row: int);
  begin
    const Start: int := G.ViewStart(self.Value, self.Range.Caret, self.Width - 2);
    const Position: int := G.IndexAt(self.Value, Start, Column - 2);
    self.SetSelection(new Edit.Selection(Position, Position));
  end procedure;

  public function Key(Pressed: E.Key; Modifiers: E.KeyModifiers): bool;
  begin
    var Caret: int := self.Range.Caret;
    case Pressed of
      when E.Key.Left:
        Caret := Edit.Previous(self.Value, Caret);
      when E.Key.Right:
        Caret := Edit.Next(self.Value, Caret);
      when E.Key.Home:
        Caret := 0;
      when E.Key.End:
        Caret := self.Value.Length;
      when E.Key.A:
        if Modifiers <> E.KeyModifiers.Ctrl then
          return false;
        end if;

        self.SetSelection(new Edit.Selection(self.Value.Length, 0));
        return true;
      when E.Key.Backspace, E.Key.Delete:
        self.Commit(Edit.Delete(self.Value, self.Range, Pressed = E.Key.Backspace));
        return true;
      else
        return false;
    end case;

    const Anchor: int := if Modifiers = E.KeyModifiers.Shift then self.Range.Anchor
      else Caret
      end if;
    self.SetSelection(new Edit.Selection(Caret, Anchor));
    return true;
  end function;
end record;
end unit;
