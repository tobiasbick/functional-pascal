unit Fpas.Tui.Internal.Hosting.TabNavigation;

uses Fpas.Ui.TerminalExtensions.Input as K, Fpas.Tui.Internal.Controls.Selection as Selections, Fpas.Tui.Internal.Layout.TabHeaders as Tabs;

public function Key<TMsg>(
  Bar: Tabs.Header<TMsg>; Pressed: K.Key; Modifiers: K.KeyModifiers; Apply: procedure(TMsg)
): bool;
begin
  if Modifiers <> K.KeyModifiers.None then
    return false;
  end if;
  var Index: int := -1;
  case Pressed of
    when K.Key.Left:
      Index := Selections.Find<TMsg>(Bar, Bar.Active - 1, -1, true);
    when K.Key.Right:
      Index := Selections.Find<TMsg>(Bar, Bar.Active + 1, 1, true);
    when K.Key.Home:
      Index := Selections.Find<TMsg>(Bar, 0, 1, false);
    when K.Key.End:
      Index := Selections.Find<TMsg>(Bar, Bar.Count() - 1, -1, false);
    else
      return false;
  end case;

  Selections.SelectAt<TMsg>(Bar, Index, Apply);
  return true;
end function;
end unit;
