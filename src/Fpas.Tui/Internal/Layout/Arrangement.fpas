unit Fpas.Tui.Internal.Layout.Arrangement;

uses
  Fpas.Tui.Elements as E, Fpas.Tui.Internal.Layout.Flexible as F,
  Fpas.Tui.Internal.Layout.SelectionLists as S,
  Fpas.Tui.Internal.Layout.ScrollViews as V, Fpas.Tui.Internal.Layout.Subviews as Subviews,
  Fpas.Tui.Internal.Controls.Activation as Actions, Fpas.Tui.Internal.Layout.TabHeaders as Tabs,
  Fpas.Tui.Internal.Layout.Stacks as Stacks, Fpas.Tui.Internal.Layout.Tables as Tables,
  Fpas.Tui.Internal.Layout.Overlays as Overlays, Fpas.Tui.Internal.Rendering.Canvases as Canvases,
  Fpas.Tui.Internal.Rendering.StatusLines as Status,
  Fpas.Tui.Internal.Rendering.Buttons as Buttons,
  Fpas.Tui.Editors as Editors, Fpas.Tui.Internal.Layout.EditorView as EditorView,
  Fpas.Tui.Internal.Rendering.EditorText as EditorText, Fpas.Tui.Internal.Layout.Scene as A,
  Fpas.Tui.Internal.Rendering.Glyphs as G, Fpas.Tui.Internal.Rendering.Drawing as D,
  System as Sys, System.Collections.Generic as Generic;

public function Arrange<TMsg>(
  Root: E.Element<TMsg>; Columns: int; Rows: int;
  Previous: A.Layout<TMsg>?; Scroll: Generic.Dictionary<string, int>; Theme: E.Theme;
  Caret: function(string, string): int
): A.Layout<TMsg>;
  procedure Draw(Value: string; Area: F.Rect; Clip: F.Rect; Style: E.Style; Wrap: bool);
  begin
    if Value.Length > 0 then
      Operations.Add(new D.Operation(Value, Area, Clip, Style, Wrap));
    end if;
  end procedure;

  function ArrangeRows(
    Id: string; Role: string; Items: array of E.SelectionItem; Key: string; Bounds: F.Rect; ScopeId: string;
    OnSelect: function(string): TMsg; OnActivate: function(string): TMsg
  ): S.Viewport<TMsg>;
  begin
    const Max: int := Sys.Math.Max(0, Items.Length - Bounds.Height);
    const List: S.Viewport<TMsg> := S.Arrange<TMsg>(
      Items, Key, Bounds.Height, Offset(Id, Max), OnSelect, OnActivate, PriorList(Id)
    );
    Scroll[Id] := List.First;
    if Max > 0 then
      Regions.Add(new A.ScrollRegion(Id, ScopeId, Bounds, Max));
    end if;
    const Action: A.Binding<TMsg> := A.Binding<TMsg>.SelectList(List);
    Register(Id, Id, Role, List.Key(), Bounds, ScopeId, Items.Length > 0, Action);
    return List;
  end function;

  function PriorList(Id: string): S.Viewport<TMsg>?;
  begin
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Previous, Id);
    if Control <> null then
      case Control.Action of
        when A.Binding.SelectList(const List: S.Viewport<TMsg>):
          return List;
        else
      end case;
    end if;

    return null;
  end function;

  procedure Register(
    Id: string; Label: string; Role: string; Value: string;
    Area: F.Rect; ScopeId: string; Enabled: bool; Action: A.Binding<TMsg>;
    Variant: E.ButtonVariant := E.ButtonVariant.Default
  );
  begin
    if Id.Length = 0 or not Ids.Add(Id) then
      raise new Sys.ArgumentException('Control IDs must be nonempty and unique.');
    end if;

    if Area.Width > 0 and Area.Height > 0 then
      Controls.Add(
        new A.Control<TMsg>(
          Id, Label, Role, Value, Area, ScopeId, FocusReturn, Enabled, Action, Variant
        )
      );
    end if;
  end procedure;

  procedure Visit(Node: E.Element<TMsg>; Area: F.Rect; Limit: F.Rect; ScopeId: string; Style: E.Style);
  begin
    const Clip: F.Rect := F.Intersect(Area, Limit);
    if Clip.Width = 0 or Clip.Height = 0 then
      return;
    end if;

    case Node of
      when E.Element.Label(const Value: string):
        Draw(Value, Area, Clip, Style, true);
      when E.Element.Separator(const Title: string):
        D.Divider(Operations, Area, Clip, Title, Style, Widgets);
      when E.Element.StatusLine(const Message: string, const Hints: array of string):
        Status.Draw(Operations, Area, Clip, Style, Message, Hints);
      when E.Element.Action(
        const Id: string, const Caption: string, const Message: TMsg, const Enabled: bool,
        const Role: string, const Value: string, const Variant: E.ButtonVariant
      ):
        Buttons.Paint(
          Operations, Area, Clip, Style, Theme, Caption, Role = 'button', Variant, Enabled
        );
        const Action: A.Binding<TMsg> := A.Binding<TMsg>.Invoke(new Actions.Direct<TMsg>(Message));
        Register(Id, Caption, Role, Value, Clip, ScopeId, Enabled, Action, Variant);
      when E.Element.Editor(
        const Id: string,
        const Value: string,
        const Change: function(string): TMsg,
        const Placeholder: string
      ):
        const Hint: string := if Value = '' then G.SingleLine(Placeholder) else '' end if;
        D.TextField(Operations, Area, Clip, Value, Hint, Caret(Id, Value), Style, Theme);
        Register(
          Id,
          Id,
          'textbox',
          Value,
          Clip,
          ScopeId,
          true,
          A.Binding<TMsg>.Edit(Value, Change, Hint <> '')
        );
      when E.Element.DocumentEditor(
        const Id: string,
        const Text: string,
        const Position: Editors.EditorPosition,
        const OnEdit: function(Editors.TextEdit): TMsg,
        const OnNavigate: function(Editors.EditorPosition): TMsg
      ):
        const Document: EditorView.Document := EditorView.Arrange(Text, Clip, Position);
        EditorText.Draw(Operations, Document, Style, Theme);
        const View: EditorView.Viewport<TMsg> := new EditorView.Viewport<TMsg>(
          Document,
          OnEdit,
          OnNavigate
        );
        Register(Id, Id, 'textbox', Text, Clip, ScopeId, true, A.Binding<TMsg>.Multiline(View));
      when E.Element.Choices(const Id: string, const Items: array of E.ListItem<TMsg>):
        const Max: int := Sys.Math.Max(0, Items.Length - Area.Height);
        const First: int := Offset(Id, Max);
        Regions.Add(new A.ScrollRegion(Id, ScopeId, Clip, Max));
        for Index: int := First to Sys.Math.Min(Items.Length, First + Area.Height) - 1 do
          const Item: E.ListItem<TMsg> := Items[Index];
          const Line: F.Rect := new F.Rect(Area.X, Area.Y + Index - First, Area.Width, 1);
          D.ListRow(Operations, Line, Clip, Item.Text, Item.Selected, Style, Widgets);
          Register(
            Id + '/' + Item.Key,
            Item.Text,
            'listitem',
            if Item.Selected then 'true' else 'false' end if,
            F.Intersect(Line, Clip),
            ScopeId,
            true,
            A.Binding<TMsg>.Invoke(new Actions.Direct<TMsg>(Item.Message))
          );
        end for;
      when E.Element.Selectable(
        const Id: string, const Items: array of E.SelectionItem, const Key: string,
        const OnSelect: function(string): TMsg, const OnActivate: function(string): TMsg
      ):
        const List: S.Viewport<TMsg> := ArrangeRows(
          Id,
          'listbox',
          Items,
          Key,
          Clip,
          ScopeId,
          OnSelect,
          OnActivate
        );
        S.Draw<TMsg>(List, Operations, Clip, Style, Widgets);
      when E.Element.TableView(
        const Id: string,
        const Columns: array of E.TableColumn,
        const Rows: array of E.TableRow,
        const Key: string,
        const OnSelect: function(string): TMsg,
        const OnActivate: function(string): TMsg
      ):
        const Widths: array of int := Tables.Widths(Columns, Area.Width);
        const Header: F.Rect := new F.Rect(Area.X, Area.Y, Area.Width, 1);
        Tables.DrawHeader(Columns, Widths, Header, Clip, Style, Widgets, Operations);
        const Body: F.Rect := F.Intersect(
          new F.Rect(Area.X, Area.Y + 1, Area.Width, Area.Height - 1),
          Clip
        );
        if Body.Height > 0 then
          const List: S.Viewport<TMsg> := ArrangeRows(
            Id, 'table', Tables.Items(Rows), Key, Body, ScopeId, OnSelect, OnActivate
          );
          Tables.DrawBody<TMsg>(Rows, Widths, List, Area, Body, Style, Widgets, Operations);
        end if;
      when E.Element.TabSet(
        const Id: string, const Items: array of E.TabItem, const ActiveIndex: int,
        const OnSelect: function(string): TMsg, const Panel: E.Element<TMsg>?
      ):
        if Items.Length = 0 then
          return;
        end if;
        const Bar: F.Rect := new F.Rect(Area.X, Area.Y, Area.Width, 1);
        const Visible: F.Rect := F.Intersect(Bar, Clip);
        if Visible.Height > 0 then
          const Header: Tabs.Header<TMsg> := Tabs.Draw<TMsg>(
            Items,
            ActiveIndex,
            OnSelect,
            Bar,
            Visible,
            Style,
            Widgets,
            Operations
          );
          const Action: A.Binding<TMsg> := A.Binding<TMsg>.SelectTab(Header);
          Register(Id, Id, 'tablist', Header.Key(), Visible, ScopeId, ActiveIndex >= 0, Action);
        end if;

        if Panel <> null then
          const Parent: string := FocusReturn;
          FocusReturn := Id;
          Visit(
            Panel,
            new F.Rect(Area.X, Area.Y + 1, Area.Width, Area.Height - 1),
            Clip,
            ScopeId,
            Style
          );
          FocusReturn := Parent;
        end if;
      when E.Element.Gauge(const Percent: int):
        D.Progress(Operations, Area, Clip, Percent, Style, Widgets);
      when E.Element.Sized(const Child: E.Element<TMsg>, _):
        Visit(Child, Area, Clip, ScopeId, Style);
      when E.Element.Decorated(const Child: E.Element<TMsg>, const ChildStyle: E.Style):
        if ChildStyle.Background >= 0 and ChildStyle.Background <> Style.Background then
          D.Fill(Operations, Clip, ChildStyle);
        end if;

        Visit(Child, Area, Clip, ScopeId, ChildStyle);
      when E.Element.Stack(
        const Children: array of E.Element<TMsg>,
        const Axis: bool,
        const Flow: E.Flow
      ):
        VisitStack(Children, Axis, Flow, Area, Clip, ScopeId, Style);
      when E.Element.Framed(const Child: E.Element<TMsg>, const Title: string):
        D.Border(Operations, Area, Clip, Title, Style, Widgets);
        Visit(
          Child, new F.Rect(
            Area.X + 1, Area.Y + 1, Sys.Math.Max(0, Area.Width - 2),
            Sys.Math.Max(0, Area.Height - 2)
          ), Clip, ScopeId, Style
        );
      when E.Element.Scrollable(const Id: string, const Child: E.Element<TMsg>):
        const Height: int := V.ContentHeight<TMsg>(Child, Area);
        const Max: int := Height - Area.Height;
        Regions.Add(new A.ScrollRegion(Id, ScopeId, Clip, Max));
        VisitScrolled(
          Child,
          new F.Rect(Area.X, Area.Y - Offset(Id, Max), Area.Width, Height),
          Clip,
          ScopeId,
          Style
        );
      when E.Element.ControlledScroll(
        const Id: string, const Child: E.Element<TMsg>, const Position: E.ScrollPosition,
        const OnScroll: function(E.ScrollChange): TMsg, const ShowScrollbar: bool
      ):
        const Layout: V.Geometry<TMsg> := V.Arrange<TMsg>(
          Child, Position, Area, Clip, ShowScrollbar, OnScroll
        );
        const View: V.Viewport<TMsg> := Layout.View;
        const Action: A.Binding<TMsg> := A.Binding<TMsg>.Scroll(View);
        Register(
          Id,
          Id,
          'scrollview',
          View.Offset.ToString(),
          Clip,
          ScopeId,
          View.Maximum > 0,
          Action
        );
        if View.Maximum > 0 then
          Regions.Add(new A.ScrollRegion(Id, ScopeId, Clip, View.Maximum, true));
        end if;

        VisitScrolled(Child, Layout.Content, Layout.Clip, ScopeId, Style);
        V.DrawBar<TMsg>(View, Operations, Area, Clip, Style, Widgets);
      when E.Element.Custom(
        const Width: int, const Height: int, const DrawCell: function(int, int): E.Cell,
        const Action: E.CanvasBinding<TMsg>
      ):
        var CanvasArea: F.Rect := F.Intersect(Clip, new F.Rect(Area.X, Area.Y, Width, Height));
        var OriginX: int := Area.X;
        var OriginY: int := Area.Y;
        case Action of
          when E.CanvasBinding.Click(const Id: string, const Click: function(int, int): TMsg):
            Register(
              Id, Id, 'canvas', '', CanvasArea, ScopeId, true,
              A.Binding<TMsg>.Canvas(OriginX, OriginY, new E.CanvasEvents<TMsg>(OnClick := Click))
            );
          when E.CanvasBinding.Responsive(const Id: string, const Events: E.CanvasEvents<TMsg>):
            CanvasArea := Clip;
            OriginX := Clip.X;
            OriginY := Clip.Y;
            Register(
              Id,
              Id,
              'canvas',
              '',
              Clip,
              ScopeId,
              true,
              A.Binding<TMsg>.Canvas(OriginX, OriginY, Events)
            );
            if Events.OnResize <> null then
              const Old: F.Rect := A.CanvasBounds<TMsg>(Previous, Id);
              if Old.Width <> Clip.Width or Old.Height <> Clip.Height then
                return;
              end if;
            end if;
          when E.CanvasBinding.None:
        end case;

        Canvases.Paint(DrawCell, OriginX, OriginY, CanvasArea, Operations);
      when E.Element.Desktop(
        const Content: E.Element<TMsg>, const Layers: array of E.Element<TMsg>,
        const Keys: array of E.ShortcutBinding<TMsg>
      ):
        GlobalKeys := Keys;
        Visit(Content, Area, Clip, ScopeId, Style);
        for Layer: E.Element<TMsg> in Layers do
          Visit(Layer, Area, Clip, ScopeId, Style);
        end for;
      when E.Element.Panel(
        const Body: E.Element<TMsg>,
        const Footer: E.Element<TMsg>,
        const Title: string,
        const Padding: byte
      ):
        const Parts: Overlays.PanelBounds := Overlays.Partition<TMsg>(Area, Footer, Padding);
        if Parts.Framed then
          D.Border(Operations, Area, Clip, Title, Style, Widgets);
        end if;

        Visit(Body, Parts.Body, Clip, ScopeId, Style);
        Visit(Footer, Parts.Footer, Clip, ScopeId, Style);
      when E.Element.Layer(
        const Id: string,
        const Modal: bool,
        const Initial: string,
        const Escape: E.EscapeBinding<TMsg>,
        const Content: E.Element<TMsg>,
        const Keys: array of E.ShortcutBinding<TMsg>,
        const Limits: E.OverlayLimits?
      ):
        if Modal then
          Active := new A.Scope<TMsg>(Id, Initial, Escape, Keys);
        end if;
        const Bounds: F.Rect := Overlays.Place<TMsg>(Content, Clip, Limits);
        D.Fill(Operations, Bounds, Style);
        Visit(Content, Bounds, Bounds, if Modal then Id else ScopeId end if, Style);
      when E.Element.Deferred(_, _):
        raise new Sys.InvalidOperationException('Unresolved cached subview.');
    end case;
  end procedure;

  procedure VisitScrolled(Child: E.Element<TMsg>; Area: F.Rect; Clip: F.Rect; ScopeId: string; Style: E.Style);
  begin
    const PreviousWrap: bool := WrapText;
    WrapText := true;
    Visit(Child, Area, Clip, ScopeId, Style);
    WrapText := PreviousWrap;
  end procedure;

  function Offset(Id: string; Maximum: int): int;
  begin
    if Scroll.ContainsKey(Id) then
      return Sys.Math.Clamp(Scroll[Id], 0, Maximum);
    end if;

    return 0;
  end function;

  procedure VisitStack(
    Children: array of E.Element<TMsg>; Axis: bool; Flow: E.Flow;
    Area: F.Rect; Clip: F.Rect; ScopeId: string; Style: E.Style
  );
  begin
    const Bounds: array of F.Rect := Stacks.Bounds<TMsg>(
      Children,
      Axis,
      Flow,
      Area,
      PreviousAllocations,
      Allocations,
      WrapText
    );
    for Index: int := 0 to Children.Length - 1 do
      Visit(Children[Index], Bounds[Index], Clip, ScopeId, Style);
    end for;
  end procedure;
begin
  const Widgets: E.WidgetStyles? := Theme.Widgets;
  const Operations: Generic.List<D.Operation> := new Generic.List<D.Operation>();
  const Allocations: Generic.List<F.AllocationMemo> := new Generic.List<F.AllocationMemo>();
  const PreviousAllocations: array of F.AllocationMemo := if Previous = null then []
    else Previous.Allocations
    end if;
  const Controls: Generic.List<A.Control<TMsg>> := new Generic.List<A.Control<TMsg>>();
  const Regions: Generic.List<A.ScrollRegion> := new Generic.List<A.ScrollRegion>();
  const Ids: Generic.HashSet<string> := new Generic.HashSet<string>();
  const Next: Generic.Dictionary<string, E.CacheEntry<TMsg>> := new Generic.Dictionary<string, E.CacheEntry<TMsg>>();
  const PreviousCache: Generic.Dictionary<string, E.CacheEntry<TMsg>> := if Previous =
      null then new Generic.Dictionary<string, E.CacheEntry<TMsg>>()
    else Previous.Cache
    end if;
  var Active: A.Scope<TMsg>? := null;
  var FocusReturn: string := '';
  var WrapText: bool := false;
  var GlobalKeys: array of E.ShortcutBinding<TMsg> := [];
  const Screen: F.Rect := new F.Rect(0, 0, Columns, Rows);
  Visit(Subviews.Resolve<TMsg>(Root, PreviousCache, Next), Screen, Screen, '', Theme.Text);
  const PreviousRows: array of D.PaintedRow := if Previous = null then []
    else Previous.Painted
    end if;
  const Surface: D.Surface := D.Render(Operations, Columns, Rows, PreviousRows, Theme.Text);
  return new A.Layout<TMsg>(
    Surface.Lines, Surface.Cells, Controls.ToArray(), Active, GlobalKeys, Regions.ToArray(),
    Next, Surface.Rows, Allocations.ToArray()
  );
end function;
end unit;
