unit Fpas.Tui.Internal.Layout.EditorView;

uses Fpas.Tui.Internal.View.Editors as Editors, Fpas.Tui.Internal.Hosting.Editing as Edit, Fpas.Tui.Internal.Layout.Flexible as F, Fpas.Tui.Internal.Rendering.Glyphs as G, System as Sys, System.Collections.Generic as Generic;

public type Line = record
  public Start: int;
  public Text: string;
end record;

public type Document = record
  public Text: string;
  public Lines: array of Line;
  public Area: F.Rect;
  public Position: Editors.EditorPosition;
end record;

public type Viewport<TMsg> = record
  public Document: Document;
  public Events: Editors.IEvents<TMsg>;
  public MultipleLines: bool;
end record;

function Split(Text: string): array of Line;
begin
  const Lines: Generic.List<Line> := new Generic.List<Line>();
  var Start: int := 0;
  var Index: int := 0;
  while Index < Text.Length do
    const Letter: char := Text[Index];
    if Letter = #13 or Letter = #10 or Letter = #8232 or Letter = #8233 then
      Lines.Add(new Line(Start, Text.Substring(Start, Index - Start)));
      if Letter = #13 and Index + 1 < Text.Length and Text[Index + 1] = #10 then
        Index := Index + 1;
      end if;

      Start := Index + 1;
    end if;

    Index := Index + 1;
  end while;

  Lines.Add(new Line(Start, Text.Substring(Start)));
  return Lines.ToArray();
end function;

public function RowAt(Lines: array of Line; Index: int): int;
begin
  var Low: int := 0;
  var High: int := Lines.Length - 1;
  while Low < High do
    const Middle: int := Low + (High - Low + 1) div 2;
    if Lines[Middle].Start <= Index then
      Low := Middle;
    else
      High := Middle - 1;
    end if;
  end while;

  return Low;
end function;

public function ColumnAt(Line: Line; Index: int): int;
begin
  return G.Measure(Line.Text.Substring(0, Sys.Math.Clamp(Index - Line.Start, 0, Line.Text.Length)));
end function;

public function IndexAt(Document: Document; Row: int; Column: int): int;
begin
  if Row >= Document.Lines.Length then
    return Document.Text.Length;
  end if;

  const Target: Line := Document.Lines[Sys.Math.Max(0, Row)];
  return Target.Start + G.IndexAt(Target.Text, 0, Column);
end function;

public function MaximumTop(Document: Document): int;
begin
  return Sys.Math.Max(0, Document.Lines.Length - Document.Area.Height);
end function;

public function Resolve(Document: Document; Requested: Editors.EditorPosition): Editors.EditorPosition;
begin
  const Caret: int := Edit.Clamp(Document.Text, Requested.Caret);
  const Anchor: int := Edit.Clamp(Document.Text, Requested.Anchor);
  const Row: int := RowAt(Document.Lines, Caret);
  const Line: Line := Document.Lines[Row];
  var Top: int := Sys.Math.Clamp(Requested.TopRow, 0, MaximumTop(Document));
  const MaxLeft: int := Sys.Math.Max(0, G.Measure(Line.Text) + 1 - Document.Area.Width);
  var Left: int := Sys.Math.Clamp(Requested.LeftColumn, 0, MaxLeft);
  if Requested.FollowCaret then
    const Column: int := ColumnAt(Line, Caret);
    Top := Sys.Math.Clamp(Top, Sys.Math.Max(0, Row - Document.Area.Height + 1), Row);
    Left := Sys.Math.Clamp(Left, Sys.Math.Max(0, Column - Document.Area.Width + 1), Column);
  end if;

  return new Editors.EditorPosition(
    Caret, Anchor, Top, Left, Sys.Math.Max(-1, Requested.PreferredColumn), Requested.FollowCaret
  );
end function;

public function Arrange(Text: string; Area: F.Rect; Position: Editors.EditorPosition): Document;
begin
  const Source: Document := new Document(Text, Split(Text), Area, Position);
  return Source with
    Position := Resolve(Source, Position);
  end with;
end function;

public function Equivalent<TMsg>(Left: Viewport<TMsg>; Right: Viewport<TMsg>): bool;
begin
  return Left.Document.Text = Right.Document.Text and Left.Document.Position =
    Right.Document.Position
    and Left.MultipleLines = Right.MultipleLines;
end function;
end unit;
