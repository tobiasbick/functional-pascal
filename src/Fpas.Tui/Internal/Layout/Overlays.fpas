unit Fpas.Tui.Internal.Layout.Overlays;

uses
  Fpas.Tui.Elements as E, Fpas.Tui.Internal.Layout.Flexible as F,
  Fpas.Tui.Internal.Layout.Measurement as M, System as Sys;

public type PanelBounds = record
  public Body: F.Rect;
  public Footer: F.Rect;
  public Framed: bool;
end record;

public function Place<TMsg>(Content: E.Element<TMsg>; Area: F.Rect; Limits: E.OverlayLimits?): F.Rect;
begin
  var MaxWidth: int := Area.Width;
  var MaxHeight: int := Area.Height;
  if Limits <> null then
    if Limits.MaxWidthPercent < 1 or Limits.MaxWidthPercent > 100
      or Limits.MaxHeightPercent < 1 or Limits.MaxHeightPercent > 100
    then
      raise new Sys.ArgumentOutOfRangeException('Limits', 'Overlay percentages must be in 1..100.');
    end if;

    MaxWidth := Sys.Math.Max(1, Area.Width * Limits.MaxWidthPercent div 100);
    MaxHeight := Sys.Math.Max(1, Area.Height * Limits.MaxHeightPercent div 100);
  end if;

  const Width: int := Sys.Math.Min(MaxWidth, M.Intrinsic<TMsg>(Content, true));
  const Height: int := Sys.Math.Min(MaxHeight, M.Intrinsic<TMsg>(Content, false, Width));
  return new F.Rect(
    Area.X + (Area.Width - Width) div 2, Area.Y + (Area.Height - Height) div 2, Width, Height
  );
end function;

public function Partition<TMsg>(Area: F.Rect; Footer: E.Element<TMsg>; Padding: byte): PanelBounds;
begin
  const FooterWidth: int := Sys.Math.Max(1, M.Intrinsic<TMsg>(Footer, true));
  const FooterRows: int := M.Intrinsic<TMsg>(Footer, false);
  const Framed: bool := Area.Width - 2 >= FooterWidth and Area.Height - 2 > FooterRows;
  const Edge: int := if Framed then 1 else 0 end if;
  const X: int := Edge + Sys.Math.Clamp(
    (Area.Width - 2 * Edge - FooterWidth) div 2, 0, cast<int>(Padding)
  );
  const Y: int := Edge + Sys.Math.Clamp(
    (Area.Height - 2 * Edge - FooterRows - 1) div 2, 0, cast<int>(Padding)
  );

  const Width: int := Area.Width - 2 * X;
  const Height: int := Area.Height - 2 * Y;
  const FooterHeight: int := Sys.Math.Min(FooterRows, Height);
  const BodyHeight: int := Height - FooterHeight;
  return new PanelBounds(
    new F.Rect(Area.X + X, Area.Y + Y, Width, BodyHeight),
    new F.Rect(Area.X + X, Area.Y + Y + BodyHeight, Width, FooterHeight),
    Framed
  );
end function;
end unit;
