unit Fpas.Tui.Internal.Layout.Tables;

uses
  Fpas.Tui.Elements as E, Fpas.Tui.Internal.Layout.Flexible as F, Fpas.Tui.Internal.Layout.SelectionLists as S,
  Fpas.Tui.Internal.Rendering.Glyphs as G, Fpas.Tui.Internal.Rendering.Drawing as D,
  System as Sys, System.Collections.Generic as Generic;

const Gutter: int := 4;

public function Items(Rows: array of E.TableRow): array of E.SelectionItem;
begin
  const Values: Generic.List<E.SelectionItem> := new Generic.List<E.SelectionItem>(Rows.Length);
  for Row: E.TableRow in Rows do
    Values.Add(new E.SelectionItem(Row.Key, '', Row.CanActivate));
  end for;

  return Values.ToArray();
end function;

function HeaderWidth(Column: E.TableColumn): int;
begin
  return G.Measure(G.SingleLine(Column.Header));
end function;

public function Preferred(Columns: array of E.TableColumn): int;
begin
  var Width: int := Gutter + Columns.Length - 1;
  for Column: E.TableColumn in Columns do
    const Rule: E.Flex := Column.Sizing;
    const Basis: int := if Rule.Basis < 0 then HeaderWidth(Column) else Rule.Basis end if;
    Width := Width + Sys.Math.Clamp(Basis, Rule.Minimum, Rule.Maximum);
  end for;

  return Width;
end function;

public function Widths(Columns: array of E.TableColumn; Available: int): array of int;
begin
  const Bases: array of int := new int[Columns.Length];
  const Rules: Generic.List<E.Flex> := new Generic.List<E.Flex>(Columns.Length);
  for Index: int := 0 to Columns.Length - 1 do
    Bases[Index] := HeaderWidth(Columns[Index]);
    Rules.Add(Columns[Index].Sizing);
  end for;

  return F.Allocate(
    Bases,
    Rules.ToArray(),
    Sys.Math.Max(0, Available - Gutter - Columns.Length + 1)
  );
end function;

procedure DrawCells(
  Widths: array of int; Caption: function(int): string; Line: F.Rect; Clip: F.Rect;
  Style: E.Style; Operations: Generic.List<D.Operation>
);
begin
  const Right: int := Line.X + Line.Width;
  var X: int := Line.X + Gutter;
  for Index: int := 0 to Widths.Length - 1 do
    if X >= Right then
      break;
    end if;
    const Width: int := Sys.Math.Min(Widths[Index], Right - X);
    if Width > 0 then
      const Cell: F.Rect := new F.Rect(X, Line.Y, Width, 1);
      const Visible: F.Rect := F.Intersect(Cell, Clip);
      if Visible.Width > 0 and Visible.Height > 0 then
        Operations.Add(new D.Operation(G.SingleLine(Caption(Index)), Cell, Visible, Style, false));
      end if;
    end if;

    X := X + Width + 1;
  end for;
end procedure;

public procedure DrawHeader(
  Columns: array of E.TableColumn; Widths: array of int; Line: F.Rect; Clip: F.Rect;
  Style: E.Style; Widgets: E.WidgetStyles?; Operations: Generic.List<D.Operation>
);
begin
  const Header: E.Style := if Widgets = null then Style
    else new E.Style(
      Widgets.BorderColor,
      Style.Background
    )
    end if;
  DrawCells(
    Widths,
    function(Index: int): string => Columns[Index].Header,
    Line,
    Clip,
    Header,
    Operations
  );
end procedure;

public procedure DrawBody<TMsg>(
  Rows: array of E.TableRow; Widths: array of int; List: S.Viewport<TMsg>; Area: F.Rect; Clip: F.Rect;
  Style: E.Style; Widgets: E.WidgetStyles?; Operations: Generic.List<D.Operation>
);
begin
  for Index: int := List.First to Sys.Math.Min(Rows.Length, List.First + List.Rows) - 1 do
    const Row: E.TableRow := Rows[Index];
    const Line: F.Rect := new F.Rect(Area.X, Clip.Y + Index - List.First, Area.Width, 1);
    const Selected: bool := Index = List.Selected;
    D.ListRow(
      Operations,
      Line,
      Clip,
      if Row.CanActivate then '' else '×' end if,
      Selected,
      Style,
      Widgets
    );
    DrawCells(
      Widths, function(Column: int): string => Row.Cells[Column], Line, Clip,
      D.SelectionStyle(Selected, Style, Widgets), Operations
    );
  end for;
end procedure;
end unit;
