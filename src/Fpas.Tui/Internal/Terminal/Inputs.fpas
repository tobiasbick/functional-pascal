unit Fpas.Tui.Internal.Terminal.Inputs;

uses
  Fpas.Tui.Application as App, Fpas.Tui.Elements as E,
  Fpas.Processes.Terminal as Terminal, System as Sys;

public function Translate(Event: Terminal.TerminalInput): App.Input?;
begin
  const Button: E.MouseButton := if Event.Button = 'middle' then E.MouseButton.Middle
    else E.MouseButton.Left
    end if;
  case Event.Kind of
    when 'activate':
      return App.Input.Activate(Event.Text);
    when 'resize':
      return App.Input.Resize(Event.Column, Event.Row);
    when 'text':
      return App.Input.TextInput(Event.Text);
    when 'character':
      return App.Input.Character(Event.Text);
    when 'paste':
      return App.Input.Paste(Event.Text);
    when 'click':
      if Event.Button = 'left' or Event.Button = 'middle' then
        return App.Input.ButtonClick(Button, Event.Column, Event.Row);
      end if;

      return null;
    when 'move':
      return App.Input.Pointer(E.PointerKind.Move, Event.Column, Event.Row);
    when 'press', 'release':
      if Event.Button = 'left' or Event.Button = 'middle' then
        const Kind: E.PointerKind := if Event.Kind = 'press' then E.PointerKind.Press
          else E.PointerKind.Release
          end if;
        return App.Input.ButtonPointer(Kind, Button, Event.Column, Event.Row);
      end if;

      return null;
    when 'scroll':
      return App.Input.Scroll(Event.Column, Event.Row, Event.Delta);
    when 'key':
      var Key: E.Key := E.Key.Unknown;
      if Sys.Enum.TryParse<E.Key>(Event.Key, out Key) then
        return App.Input.KeyPress(Key, cast<E.KeyModifiers>(Event.Modifiers));
      end if;

      return null;
    else
      return null;
  end case;
end function;
end unit;
