unit Fpas.Tui.Internal.View.EditorState;

uses Fpas.Ui.Editors as Ed, Fpas.Tui.Internal.View.Editors as Native, Fpas.Tui.Internal.Controls.Activation as Actions, System.Collections.Generic as C;

/// Retained visual state for one controlled document.
public type Entry = record
  /// The document associated with the visual offsets.
  public Text: string;
  /// Cell viewport and directional UTF-16 selection.
  public Position: Native.EditorPosition;
end record;

/// Maps backend navigation to the shared editor contract.
/// <typeparam name="TMsg">Application message type.</typeparam>
public type Events<TMsg> = record implements Native.IEvents<TMsg>
  /// Stable editor identity.
  public Id: string;
  /// Authoritative document during this frame.
  public Text: string;
  /// Authoritative directional selection.
  public Position: Ed.EditorPosition;
  /// Shared replacement mapper.
  public OnEdit: function(Ed.TextEdit): TMsg;
  /// Shared selection mapper.
  public OnNavigate: function(Ed.EditorPosition): TMsg;
  /// Host-owned visual offsets.
  public Storage: C.Dictionary<string, Entry>;

  /// Retains visual offsets and maps a proposed edit.
  /// <param name="Change">Backend edit.</param>
  /// <returns>The application message.</returns>
  public function Edit(Change: Native.TextEdit): TMsg;
  begin
    self.Storage[self.Id] := new Entry(Change.Text, Change.Position);
    return self.OnEdit(
      new Ed.TextEdit(
        Change.Text,
        new Ed.EditorPosition(Change.Position.Caret, Change.Position.Anchor)
      )
    );
  end function;

  /// Keeps scrolling and preferred columns in the host.
  /// <param name="Position">Resolved visual state.</param>
  /// <returns>A selection proposal only when caret or anchor changed.</returns>
  public function Navigate(Position: Native.EditorPosition): Actions.Result<TMsg>;
  begin
    self.Storage[self.Id] := new Entry(self.Text, Position);
    if Position.Caret = self.Position.Caret and Position.Anchor = self.Position.Anchor then
      return Actions.Result<TMsg>.NoAction;
    end if;

    return Actions.Result<TMsg>.Send(
      self.OnNavigate(new Ed.EditorPosition(Position.Caret, Position.Anchor))
    );
  end function;
end record;

/// Reconciles a controlled document with its host-owned visual offsets.
/// <param name="Storage">Visual state store.</param>
/// <param name="Id">Stable identity.</param>
/// <param name="Text">Model document.</param>
/// <param name="Position">Model selection.</param>
/// <returns>Reusable visual offsets or a fresh caret-following state.</returns>
public function Resolve(Storage: C.Dictionary<string, Entry>; Id: string; Text: string; Position: Ed.EditorPosition): Native.EditorPosition;
begin
  if Storage.ContainsKey(Id) then
    const Prior: Entry := Storage[Id];
    if Prior.Text = Text and Prior.Position.Caret = Position.Caret and Prior.Position.Anchor =
      Position.Anchor
    then
      return Prior.Position;
    end if;
  end if;

  return new Native.EditorPosition(Caret := Position.Caret, Anchor := Position.Anchor);
end function;
end unit;
