<Project>
  <PropertyGroup>
    <_FpasCuiPackageRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</_FpasCuiPackageRoot>
  </PropertyGroup>

  <Target Name="ResolveFpasCuiPackageAssets" BeforeTargets="AssignTargetPaths;ComputeIlcCompileInputs"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">
    <PropertyGroup>
      <_FpasCuiPackageRid>$(RuntimeIdentifier)</_FpasCuiPackageRid>
      <_FpasCuiPackageRid Condition="'$(_FpasCuiPackageRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_FpasCuiPackageRid>
      <_FpasCuiShared Condition="'$(_FpasCuiPackageRid)' == 'win-x64'">fpas_cui.dll</_FpasCuiShared>
      <_FpasCuiArchive Condition="'$(_FpasCuiPackageRid)' == 'win-x64'">fpas_cui.lib</_FpasCuiArchive>
      <_FpasCuiShared Condition="'$(_FpasCuiPackageRid)' == 'linux-x64'">libfpas_cui.so</_FpasCuiShared>
      <_FpasCuiArchive Condition="'$(_FpasCuiPackageRid)' == 'linux-x64'">libfpas_cui.a</_FpasCuiArchive>
      <_FpasCuiAssetRoot>$(_FpasCuiPackageRoot)native/$(_FpasCuiPackageRid)</_FpasCuiAssetRoot>
      <_FpasCuiAsset Condition="'$(PublishAot)' == 'true'">$(_FpasCuiAssetRoot)/static/$(_FpasCuiArchive)</_FpasCuiAsset>
      <_FpasCuiAsset Condition="'$(PublishAot)' != 'true'">$(_FpasCuiAssetRoot)/shared/$(_FpasCuiShared)</_FpasCuiAsset>
    </PropertyGroup>

    <Error Condition="'$(_FpasCuiShared)' == ''"
           Text="Fpas.Ui.Gui.Cui does not support runtime identifier '$(_FpasCuiPackageRid)'. Use win-x64 or linux-x64." />
    <Error Condition="!Exists('$(_FpasCuiAsset)')"
           Text="Fpas.Ui.Gui.Cui package is missing the native asset for '$(_FpasCuiPackageRid)'. Restore the package built for that runtime identifier." />

    <ItemGroup>
      <_FpasCuiNotice Include="$(_FpasCuiPackageRoot)licenses/cui/LICENSE-*.txt" />
      <Content Include="@(_FpasCuiNotice)" Link="licenses/cui/%(_FpasCuiNotice.Filename)%(_FpasCuiNotice.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
    <ItemGroup Condition="'$(PublishAot)' == 'true'">
      <DirectPInvoke Include="fpas_cui" />
      <NativeLibrary Include="$(_FpasCuiAsset)" />
      <NativeLibrary Include="user32.lib;gdi32.lib;opengl32.lib;shell32.lib;imm32.lib;dwmapi.lib;comdlg32.lib;ole32.lib"
                     Condition="'$(_FpasCuiPackageRid)' == 'win-x64'" />
      <NativeLibrary Include="-l:libX11.so.6" Condition="'$(_FpasCuiPackageRid)' == 'linux-x64'" />
    </ItemGroup>
    <ItemGroup Condition="'$(PublishAot)' != 'true'">
      <Content Include="$(_FpasCuiAsset)" Link="$(_FpasCuiShared)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
