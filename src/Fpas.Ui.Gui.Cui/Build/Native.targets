<Project>
  <PropertyGroup>
    <FpasCuiCMakeCommand Condition="'$(FpasCuiCMakeCommand)' == ''">cmake</FpasCuiCMakeCommand>
    <FpasCuiNativeRid Condition="'$(FpasCuiNativeRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FpasCuiNativeRid>
    <FpasCuiNativeRid Condition="'$(FpasCuiNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</FpasCuiNativeRid>
    <FpasCuiNativeLinkage Condition="'$(FpasCuiNativeLinkage)' == ''">shared</FpasCuiNativeLinkage>
    <FpasCuiBuildShared Condition="'$(FpasCuiNativeLinkage)' == 'shared'">ON</FpasCuiBuildShared>
    <FpasCuiBuildShared Condition="'$(FpasCuiNativeLinkage)' == 'static'">OFF</FpasCuiBuildShared>
    <FpasCuiNativeBuildDirectory Condition="'$(FpasCuiNativeBuildDirectory)' == ''">$(MSBuildProjectDirectory)/obj/native/$(FpasCuiNativeRid)/$(Configuration)/$(FpasCuiNativeLinkage)</FpasCuiNativeBuildDirectory>
    <FpasCuiNativeOutput>$(FpasCuiNativeBuildDirectory)/out</FpasCuiNativeOutput>
    <FpasCuiNativeFile Condition="'$(FpasCuiNativeRid)' == 'linux-x64'">libfpas_cui.so</FpasCuiNativeFile>
    <FpasCuiNativeFile Condition="'$(FpasCuiNativeRid)' == 'win-x64'">fpas_cui.dll</FpasCuiNativeFile>
    <!-- The pinned CUI Gantt code shadows a local. Keep MSVC's warning visible. -->
    <MSBuildWarningsNotAsErrors Condition="'$(FpasCuiNativeRid)' == 'win-x64'">$(MSBuildWarningsNotAsErrors);C4456</MSBuildWarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(FpasCuiSkipSourceBuild)' != 'true'">
    <Content Include="$(FpasCuiNativeOutput)/$(FpasCuiNativeFile)" Link="$(FpasCuiNativeFile)"
             Condition="'$(FpasCuiNativeFile)' != '' and '$(FpasCuiNativeLinkage)' == 'shared'"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildProjectDirectory)/../../third-party/cui/LICENSE-*.txt"
             Link="licenses/cui/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- CMake owns incremental recompilation; reconfigure when callers change options. -->
  <Target Name="BuildFpasCuiNative" BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(FpasCuiSkipSourceBuild)' != 'true'">
    <Error Condition="'$(PublishAot)' == 'true'"
           Text="Native AOT publishing requires a PackageReference to Fpas.Ui.Gui.Cui from the distribution feed. Replace the source ProjectReference to obtain the transitive static link inputs." />
    <Error Condition="'$(FpasCuiNativeFile)' == ''" Text="CUI supports linux-x64 and win-x64. Requested $(FpasCuiNativeRid)." />
    <Error Condition="'$(FpasCuiBuildShared)' == ''" Text="CUI native linkage must be shared or static. Requested $(FpasCuiNativeLinkage)." />
    <Error Condition="'$(FpasCuiNativeRid)' != '$(NETCoreSdkRuntimeIdentifier)'"
           Text="CUI cannot build $(FpasCuiNativeRid) assets on $(NETCoreSdkRuntimeIdentifier). Build on the matching host with its native toolchain." />
    <Exec Command="&quot;$(FpasCuiCMakeCommand)&quot; -S &quot;$(MSBuildProjectDirectory)/native&quot; -B &quot;$(FpasCuiNativeBuildDirectory)&quot; -DFPAS_CUI_BUILD_CONFIGURATION=$(Configuration) -DBUILD_SHARED_LIBS=$(FpasCuiBuildShared) -DFPAS_CUI_BUILD_TESTS=OFF -DFPAS_CUI_OUTPUT_DIRECTORY=&quot;$(FpasCuiNativeOutput)&quot; $(FpasCuiCMakeArguments)" />
    <Exec Command="&quot;$(FpasCuiCMakeCommand)&quot; --build &quot;$(FpasCuiNativeBuildDirectory)&quot; --config $(Configuration) --parallel" />
  </Target>
</Project>
