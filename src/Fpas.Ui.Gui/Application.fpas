unit Fpas.Ui.Gui.Application;

uses
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Shortcuts as Shortcuts, Fpas.Ui.Gui.Windows as Windows,
  Fpas.Ui.Gui.Internal.Hosting.Session as Host, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Mvu.Session as Core,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Theming.Themes as Themes, System as Sys;

// Native window configuration in logical units.
public type Options = record
  // The window title.
  public Title: string := 'FPAS';
  // Positive initial width.
  public Width: int := 640;
  // Positive initial height.
  public Height: int := 480;
  // Requested renderer; the session reports the actual selection.
  public Renderer: Cui.CuiRenderer := Cui.CuiRenderer.Auto;
  // Positive mailbox capacity.
  public Capacity: int := 128;
  // Initial native theme, unless selected from the model.
  public Theme: Themes.Theme := new Themes.Theme();
  // A saved placement to open at, maximized if it was; its size replaces Width
  // and Height. Null lets the system choose the place.
  public Placement: Cui.CuiWindowPlacement? := null;
  // Minimum logical dimensions, zero for CUI's native defaults.
  public MinimumWidth: int := 0;
  // Minimum logical height, zero for CUI's native default.
  public MinimumHeight: int := 0;
  // Whether to disable interactive resizing and native maximization.
  public FixedSize: bool := false;
  // Linux desktop identity, matching the .desktop filename without its suffix.
  public AppId: string := '';
  // Whether to render even when there is no input or animation.
  public Continuous: bool := false;
  // Whether OpenGL presents without waiting for vertical sync.
  public NoVsync: bool := false;
  // Whether to create the window without showing it, for example during testing.
  public Hidden: bool := false;
end record;

function CreateWindow(Settings: Options): Cui.CuiWindow;
begin
  return new Cui.CuiWindow(
    Settings.Title,
    Settings.Width,
    Settings.Height,
    Settings.Renderer,
    Settings.Continuous,
    Settings.Placement,
    Settings.MinimumWidth,
    Settings.MinimumHeight,
    Settings.FixedSize,
    Settings.AppId,
    Settings.NoVsync,
    Settings.Hidden
  );
end function;

// A detached description of a presented graphical control.
public type Control = record
  // Stable application identity.
  public Id: string;
  // Visible text.
  public Text: string;
  // Semantic role; collection items additionally carry a key.
  public Role: string;
  // Logical coordinates and dimensions, not terminal cells.
  public Bounds: Cui.CuiRectangle;
  // Whether the control accepts input.
  public Enabled: bool;
  // Collection item key, empty for a standalone control.
  public Key: string := '';
  // Displayed model/edit value.
  public Value: string := '';
  // Current native keyboard focus.
  public Focused: bool := false;
  // Current native pointer hover.
  public Hovered: bool := false;
end record;

// The last successfully presented graphical view.
public type Frame = record
  // Session-local presentation sequence.
  public Id: long;
  // Observed logical window size.
  public Size: Cui.CuiSize;
  // Text labels in traversal order.
  public Text: array of string;
  // Detached control descriptors.
  public Controls: array of Control;
  // Model-selected shared theme.
  public Theme: Themes.Theme := new Themes.Theme();
end record;

// A manually driven GUI session. Drive and dispose it on its creating thread.
//
// ## Type parameters
// - `TMsg`: The application's typed messages.
public type Session<TMsg> = record implements Sys.IDisposable
  Process: function(): bool;
  Enqueue: function(TMsg): Core.Admission;
  Read: function(): Frame;
  Status: function(): bool;
  Software: function(): bool;
  Capture: procedure(string);
  Release: procedure();
  Place: function(): Cui.CuiWindowPlacement;
  Inspect: function(): Windows.Info;

  // Wraps the host implementation's operations.
  //
  // ## Parameters
  // - `Process`: Processes a frame on the owner.
  // - `Enqueue`: Admits an external typed message and wakes the owner.
  // - `Read`: Returns a detached presented snapshot.
  // - `Status`: Reports mailbox admission.
  // - `Software`: Reports actual renderer selection on the owner.
  // - `Capture`: Writes the presented native frame on the owner.
  // - `Release`: Stops and releases the session on the owner.
  // - `Place`: Reads the window placement on the owner, or the one kept when the window closed.
  // - `Inspect`: Reads the live window information on the owner.
  //
  // ## Returns
  // The owned session.
  public static function Create(
    Process: function(): bool; Enqueue: function(TMsg): Core.Admission;
    Read: function(): Frame; Status: function(): bool; Software: function(): bool;
    Release: procedure(); Capture: procedure(string); Place: function(): Cui.CuiWindowPlacement;
    Inspect: function(): Windows.Info
  ): Session<TMsg>;
  begin
    return new Session<TMsg>(
      Process,
      Enqueue,
      Read,
      Status,
      Software,
      Capture,
      Release,
      Place,
      Inspect
    );
  end function;

  // Reads the live native window on the owner thread.
  //
  // ## Returns
  // Current size, state, backend and borrowed native handle. Throws after the window is released.
  public function InspectWindow(): Windows.Info;
  begin
    return self.Inspect();
  end function;

  // Processes admitted messages and presents one frame, waiting for native input when idle.
  //
  // ## Returns
  // False after native or application close.
  public function Step(): bool;
  begin
    return self.Process();
  end function;

  // Posts from any thread. A full mailbox does not admit the message.
  //
  // ## Parameters
  // - `Message`: The application message.
  //
  // ## Returns
  // The shared mailbox admission result.
  public function Post(Message: TMsg): Core.Admission;
  begin
    return self.Enqueue(Message);
  end function;

  // Returns a detached snapshot of the last successful presentation.
  //
  // ## Returns
  // The frame; throws before the first presentation.
  public function Snapshot(): Frame;
  begin
    return self.Read();
  end function;

  // Reports whether the mailbox still accepts messages.
  //
  // ## Returns
  // True while the session is open.
  public function IsOpen(): bool;
  begin
    return self.Status();
  end function;

  // Reports the actual native renderer on the owner.
  //
  // ## Returns
  // True for software rendering, including fallback.
  public function IsSoftware(): bool;
  begin
    return self.Software();
  end function;

  // Saves the last presented native frame as PNG on the owner thread, outside Step.
  //
  // ## Parameters
  // - `Path`: Nonempty output path in an existing directory.
  public procedure CapturePng(Path: string);
  requires Path.Length > 0;
  begin
    self.Capture(Path);
  end procedure;

  // Reads the window's normal size and place and whether it is or comes back
  // maximized. After Step returns false it returns the placement the window had
  // when it closed, so an application can save it before Dispose.
  //
  // ## Returns
  // The placement to pass as `Options.Placement` at the next start.
  public function Placement(): Cui.CuiWindowPlacement;
  begin
    return self.Place();
  end function;

  // Stops admission and destroys native resources on the creating thread.
  public procedure Dispose();
  begin
    self.Release();
  end procedure;
end record;

// Creates a GUI window and session using the shared MVU and widget contracts.
//
// ## Type parameters
// - `TModel`: The model type.
// - `TMsg`: The message type.
//
// ## Parameters
// - `InitialModel`: The model before any transitions.
// - `Update`: Handles one message after the preceding frame.
// - `View`: Builds the declarative view for the current model.
// - `Settings`: Window and mailbox configuration.
// - `ThemeFor`: Optional model-owned shared theme selector.
// - `OnCloseRequested`: Optional native close message factory. Exit approves; Closing.Cancel rejects.
// - `BindingsFor`: Optional model-owned application shortcuts, evaluated after native widgets.
//
// ## Returns
// The owned session; its first Step presents the initial model.
public function Start<TModel, TMsg>(
  InitialModel: TModel;
  Update: function(TModel, TMsg): Mvu.Transition<TModel, TMsg>;
  View: function(TModel, L.Viewport): E.Element<TMsg>; Settings: Options;
  ThemeFor: Sys.Func<TModel, Themes.Theme>? := null; OnCloseRequested: Sys.Func<TMsg>? := null;
  BindingsFor: Sys.Func<TModel, array of Shortcuts.Binding<TMsg>>? := null
): Session<TMsg>;
requires Settings.Width > 0;
requires Settings.Height > 0;
requires Settings.Capacity > 0;
requires Settings.MinimumWidth >= 0 and Settings.MinimumHeight >= 0;
begin
  return Host.Start<TModel, TMsg>(
    InitialModel,
    Update,
    View,
    CreateWindow(Settings),
    Settings.Capacity, null, Settings.Theme, ThemeFor, OnCloseRequested, BindingsFor
  );
end function;

// Runs the owner loop until native or application close.
//
// ## Type parameters
// - `TModel`: The model type.
// - `TMsg`: The message type.
//
// ## Parameters
// - `InitialModel`: The initial model.
// - `Update`: The shared MVU transition.
// - `View`: The shared declarative view.
// - `Settings`: Window and mailbox configuration.
// - `ThemeFor`: Optional model-owned shared theme selector.
// - `OnCloseRequested`: Optional native close message factory. Exit approves; Closing.Cancel rejects.
// - `BindingsFor`: Optional model-owned application shortcuts, evaluated after native widgets.
public procedure Run<TModel, TMsg>(
  InitialModel: TModel;
  Update: function(TModel, TMsg): Mvu.Transition<TModel, TMsg>;
  View: function(TModel, L.Viewport): E.Element<TMsg>; Settings: Options;
  ThemeFor: Sys.Func<TModel, Themes.Theme>? := null; OnCloseRequested: Sys.Func<TMsg>? := null;
  BindingsFor: Sys.Func<TModel, array of Shortcuts.Binding<TMsg>>? := null
);
requires Settings.Width > 0;
requires Settings.Height > 0;
requires Settings.Capacity > 0;
requires Settings.MinimumWidth >= 0 and Settings.MinimumHeight >= 0;
begin
  using const Running: Session<TMsg> := Start<TModel, TMsg>(
    InitialModel,
    Update,
    View,
    Settings,
    ThemeFor, OnCloseRequested, BindingsFor
  );
  while Running.Step() do
  end while;
end procedure;

// Creates a GUI session that observes the desktop appearance and supplies the
// same resolved theme to native widgets and the declarative view.
//
// ## Type parameters
// - `TModel`: Application model.
// - `TMsg`: Typed messages.
// ## Parameters
// - `InitialModel`: The model before any transitions.
// - `Update`: The shared MVU transition.
// - `View`: Builds a view from the model, viewport and resolved theme.
// - `Settings`: Window and mailbox configuration.
// - `ThemeFor`: Resolves a theme from the model and system appearance, which is null when unavailable.
// - `OnCloseRequested`: Optional native close message factory. Exit approves; Closing.Cancel rejects.
// - `BindingsFor`: Optional model-owned application shortcuts, evaluated after native widgets.
// ## Returns
// The owned session. Its first Step resolves the theme and presents the initial view.
public function StartThemed<TModel, TMsg>(
  InitialModel: TModel; Update: function(TModel, TMsg): Mvu.Transition<TModel, TMsg>;
  View: function(TModel, L.Viewport, Themes.Theme): E.Element<TMsg>; Settings: Options;
  ThemeFor: function(TModel, Themes.Mode?): Themes.Theme; OnCloseRequested: Sys.Func<TMsg>? := null;
  BindingsFor: Sys.Func<TModel, array of Shortcuts.Binding<TMsg>>? := null
): Session<TMsg>;
requires Settings.Width > 0;
requires Settings.Height > 0;
requires Settings.Capacity > 0;
requires Settings.MinimumWidth >= 0 and Settings.MinimumHeight >= 0;
begin
  return Host.StartThemed<TModel, TMsg>(
    InitialModel, Update, View,
    CreateWindow(Settings),
    Settings.Capacity, null, Settings.Theme, ThemeFor, true, OnCloseRequested, BindingsFor
  );
end function;

// Runs a system-aware GUI session until native or application close.
//
// ## Type parameters
// - `TModel`: Application model.
// - `TMsg`: Typed messages.
// ## Parameters
// - `InitialModel`: The initial model.
// - `Update`: The shared MVU transition.
// - `View`: Builds a view from the model, viewport and resolved theme.
// - `Settings`: Window and mailbox configuration.
// - `ThemeFor`: Resolves a theme from the model and system appearance, which is null when unavailable.
// - `OnCloseRequested`: Optional native close message factory. Exit approves; Closing.Cancel rejects.
// - `BindingsFor`: Optional model-owned application shortcuts, evaluated after native widgets.
public procedure RunThemed<TModel, TMsg>(
  InitialModel: TModel; Update: function(TModel, TMsg): Mvu.Transition<TModel, TMsg>;
  View: function(TModel, L.Viewport, Themes.Theme): E.Element<TMsg>; Settings: Options;
  ThemeFor: function(TModel, Themes.Mode?): Themes.Theme; OnCloseRequested: Sys.Func<TMsg>? := null;
  BindingsFor: Sys.Func<TModel, array of Shortcuts.Binding<TMsg>>? := null
);
requires Settings.Width > 0;
requires Settings.Height > 0;
requires Settings.Capacity > 0;
requires Settings.MinimumWidth >= 0 and Settings.MinimumHeight >= 0;
begin
  using const Running: Session<TMsg> := StartThemed<TModel, TMsg>(
    InitialModel,
    Update,
    View,
    Settings,
    ThemeFor, OnCloseRequested, BindingsFor
  );
  while Running.Step() do
  end while;
end procedure;

end unit;
