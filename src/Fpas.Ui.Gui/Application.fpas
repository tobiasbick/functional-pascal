unit Fpas.Ui.Gui.Application;

uses Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Session as Host, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Mvu.Session as Core, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Themes as Themes, System as Sys;

// Native window configuration in logical units.
public type Options = record
  // The window title.
  public Title: string := 'FPAS';
  // Positive initial width.
  public Width: int := 640;
  // Positive initial height.
  public Height: int := 480;
  // Requested renderer; the session reports the actual selection.
  public Renderer: Cui.CuiRenderer := Cui.CuiRenderer.Auto;
  // Positive mailbox capacity.
  public Capacity: int := 128;
  // Initial native theme, unless selected from the model.
  public Theme: Themes.Theme := new Themes.Theme();
end record;

// A detached description of a presented graphical control.
public type Control = record
  // Stable application identity.
  public Id: string;
  // Visible text.
  public Text: string;
  // Semantic role; collection items additionally carry a key.
  public Role: string;
  // Logical coordinates and dimensions, not terminal cells.
  public Bounds: Cui.CuiRectangle;
  // Whether the control accepts input.
  public Enabled: bool;
  // Collection item key, empty for a standalone control.
  public Key: string := '';
  // Displayed model/edit value.
  public Value: string := '';
  // Current native keyboard focus.
  public Focused: bool := false;
  // Current native pointer hover.
  public Hovered: bool := false;
end record;

// The last successfully presented graphical view.
public type Frame = record
  // Session-local presentation sequence.
  public Id: long;
  // Observed logical window size.
  public Size: Cui.CuiSize;
  // Text labels in traversal order.
  public Text: array of string;
  // Detached control descriptors.
  public Controls: array of Control;
  // Model-selected shared theme.
  public Theme: Themes.Theme := new Themes.Theme();
end record;

// A manually driven GUI session. Drive and dispose it on its creating thread.
//
// ## Type parameters
// - `TMsg`: The application's typed messages.
public type Session<TMsg> = record implements Sys.IDisposable
  Process: function(): bool;
  Enqueue: function(TMsg): Core.Admission;
  Read: function(): Frame;
  Status: function(): bool;
  Software: function(): bool;
  Capture: procedure(string);
  Release: procedure();

  // Wraps the host implementation's operations.
  //
  // ## Parameters
  // - `Process`: Processes a frame on the owner.
  // - `Enqueue`: Admits an external typed message and wakes the owner.
  // - `Read`: Returns a detached presented snapshot.
  // - `Status`: Reports mailbox admission.
  // - `Software`: Reports actual renderer selection on the owner.
  // - `Capture`: Writes the presented native frame on the owner.
  // - `Release`: Stops and releases the session on the owner.
  //
  // ## Returns
  // The owned session.
  public static function Create(
    Process: function(): bool; Enqueue: function(TMsg): Core.Admission;
    Read: function(): Frame; Status: function(): bool; Software: function(): bool;
    Release: procedure(); Capture: procedure(string)
  ): Session<TMsg>;
  begin
    return new Session<TMsg>(Process, Enqueue, Read, Status, Software, Capture, Release);
  end function;

  // Processes admitted messages and presents one frame, waiting for native input when idle.
  //
  // ## Returns
  // False after native or application close.
  public function Step(): bool;
  begin
    return self.Process();
  end function;

  // Posts from any thread. A full mailbox does not admit the message.
  //
  // ## Parameters
  // - `Message`: The application message.
  //
  // ## Returns
  // The shared mailbox admission result.
  public function Post(Message: TMsg): Core.Admission;
  begin
    return self.Enqueue(Message);
  end function;

  // Returns a detached snapshot of the last successful presentation.
  //
  // ## Returns
  // The frame; throws before the first presentation.
  public function Snapshot(): Frame;
  begin
    return self.Read();
  end function;

  // Reports whether the mailbox still accepts messages.
  //
  // ## Returns
  // True while the session is open.
  public function IsOpen(): bool;
  begin
    return self.Status();
  end function;

  // Reports the actual native renderer on the owner.
  //
  // ## Returns
  // True for software rendering, including fallback.
  public function IsSoftware(): bool;
  begin
    return self.Software();
  end function;

  // Saves the last presented native frame as PNG on the owner thread, outside Step.
  //
  // ## Parameters
  // - `Path`: Nonempty output path in an existing directory.
  public procedure CapturePng(Path: string);
  requires Path.Length > 0;
  begin
    self.Capture(Path);
  end procedure;

  // Stops admission and destroys native resources on the creating thread.
  public procedure Dispose();
  begin
    self.Release();
  end procedure;
end record;

// Creates a GUI window and session using the shared MVU and widget contracts.
//
// ## Type parameters
// - `TModel`: The model type.
// - `TMsg`: The message type.
//
// ## Parameters
// - `InitialModel`: The model before any transitions.
// - `Update`: Handles one message after the preceding frame.
// - `View`: Builds the declarative view for the current model.
// - `Settings`: Window and mailbox configuration.
// - `ThemeFor`: Optional model-owned shared theme selector.
//
// ## Returns
// The owned session; its first Step presents the initial model.
public function Start<TModel, TMsg>(
  InitialModel: TModel;
  Update: function(TModel, TMsg): Mvu.Transition<TModel, TMsg>;
  View: function(TModel, L.Viewport): E.Element<TMsg>; Settings: Options;
  ThemeFor: Sys.Func<TModel, Themes.Theme>? := null
): Session<TMsg>;
requires Settings.Width > 0;
requires Settings.Height > 0;
requires Settings.Capacity > 0;
begin
  return Host.Start<TModel, TMsg>(
    InitialModel,
    Update,
    View,
    new Cui.CuiWindow(Settings.Title, Settings.Width, Settings.Height, Settings.Renderer),
    Settings.Capacity, null, Settings.Theme, ThemeFor
  );
end function;

// Runs the owner loop until native or application close.
//
// ## Type parameters
// - `TModel`: The model type.
// - `TMsg`: The message type.
//
// ## Parameters
// - `InitialModel`: The initial model.
// - `Update`: The shared MVU transition.
// - `View`: The shared declarative view.
// - `Settings`: Window and mailbox configuration.
// - `ThemeFor`: Optional model-owned shared theme selector.
public procedure Run<TModel, TMsg>(
  InitialModel: TModel;
  Update: function(TModel, TMsg): Mvu.Transition<TModel, TMsg>;
  View: function(TModel, L.Viewport): E.Element<TMsg>; Settings: Options;
  ThemeFor: Sys.Func<TModel, Themes.Theme>? := null
);
requires Settings.Width > 0;
requires Settings.Height > 0;
requires Settings.Capacity > 0;
begin
  using const Running: Session<TMsg> := Start<TModel, TMsg>(
    InitialModel,
    Update,
    View,
    Settings,
    ThemeFor
  );
  while Running.Step() do
  end while;
end procedure;
end unit;
