// [Documentation](../../docs/ui/gui/host.md#application-lifecycle)

unit Fpas.Ui.Gui.Closing;

uses Fpas.Ui.Mvu.Application as Mvu;

// Rejects the pending native close and allows a subsequent native close request.
// ## Type parameters
// - `TMsg`: Application message type.
public type CancelRequest of TMsg = record implements Mvu.HostExtension of TMsg
  // Retains the cancellation when a child command maps to its parent.
  // ## Type parameters
  // - `TNext`: Parent message type.
  // ## Parameters
  // - `Messages`: Parent message mapper.
  // ## Returns
  // The same graphical close decision in the parent message space.
  public function Map of TNext(Messages: function(TMsg): TNext): Mvu.HostExtension of TNext;
  begin
    return new CancelRequest of TNext();
  end function;
end record;

// Rejects a native close request delivered through Application.OnCloseRequested.
// Confirm closing with the existing MVU Exit command instead.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Returns
// An owner-thread command that keeps the session and its background work open.
public function Cancel of TMsg(): Mvu.Command of TMsg;
begin
  return (Mvu.Command of TMsg).Host(Mvu.HostRequest.Extension(new CancelRequest of TMsg()));
end function;

end unit;
