<Project Sdk="Fpas.NET.Sdk/0.1.0-dev">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Fpas.Ui.Gui</PackageId>
    <Version>0.1.0-dev</Version>
    <Description>Declarative desktop GUI host for Functional Pascal.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Fpas.Ui.Mvu/Fpas.Ui.Mvu.fpasproj" />
    <ProjectReference Include="../Fpas.Ui/Fpas.Ui.fpasproj" />
    <ProjectReference Include="../Fpas.Ui.Gui.Cui/Fpas.Ui.Gui.Cui.csproj" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
