unit Fpas.Ui.Gui.Internal.ChartData;

uses
  Fpas.Ui.Charts as C, Fpas.Ui.Gui.Cui as Native, Fpas.Ui.Gui.Internal.Sizing as Size,
  Fpas.Ui.Graphics as G, System.Collections.Generic as Lists;

// Converts a semantic chart color without resolving theme tokens early.
// ## Parameters
// - `Value`: Shared color.
// ## Returns
// Native palette selector or packed RGBA.
public function Color(Value: C.Color): Native.CuiChartColor;
begin
  return case Value of
    when C.Color.Automatic: new Native.CuiChartColor();
    when C.Color.Palette(const Index: int): new Native.CuiChartColor(Index);
    when C.Color.Rgba(const Rgba: G.Color): new Native.CuiChartColor(
      -1,
      cast<uint>(Rgba.Red) or (cast<uint>(Rgba.Green) shl 8) or (cast<uint>(Rgba.Blue) shl 16)
      or (cast<uint>(Rgba.Alpha) shl 24)
    );
  end case;
end function;

// Converts safe value formatting.
// ## Parameters
// - `Value`: Optional shared format.
// ## Returns
// Native format, or null for automatic formatting.
public function Format(Value: C.ValueFormat?): Native.CuiChartFormat?;
begin
  return if Value = null then
    null
  else
    new Native.CuiChartFormat(Value.DecimalPlaces, Value.Prefix, Value.Suffix)
  end if;
end function;

// Converts the series without retaining pinned application storage.
// ## Parameters
// - `Values`: Shared series.
// ## Returns
// Native binding series.
public function Series(Values: array of C.Series): array of Native.CuiChartSeries;
begin
  const Result: Lists.List<Native.CuiChartSeries> := new Lists.List<Native.CuiChartSeries>();
  for Item: C.Series in Values do
    Result.Add(new Native.CuiChartSeries(Item.Name, Item.Values, Color(Item.Color)));
  end for;

  return Result.ToArray();
end function;

// Converts named visualization amounts.
// ## Parameters
// - `Values`: Shared items.
// ## Returns
// Native items retaining input order and semantic colors.
public function Items(Values: array of C.Item): array of Native.CuiVizItem;
begin
  const Result: Lists.List<Native.CuiVizItem> := new Lists.List<Native.CuiVizItem>();
  for Item: C.Item in Values do
    Result.Add(new Native.CuiVizItem(Item.Label, Item.Value, Color(Item.Color)));
  end for;

  return Result.ToArray();
end function;

// Converts options for native line and bar widgets.
// ## Parameters
// - `Value`: Shared chart settings.
// ## Returns
// Native presentation, including reference lines and point annotations.
public function Options(Value: C.Options): Native.CuiChartOptions;
begin
  const Width: Size.NativeExtent := Size.Extent(Value.Width);
  const Items: Lists.List<Native.CuiChartAnnotation> := new Lists.List<Native.CuiChartAnnotation>();
  for Item: C.Annotation in Value.Annotations do
    Items.Add(
      new Native.CuiChartAnnotation(
        cast<int>(Item.Kind),
        Item.X,
        Item.Y,
        Item.Label,
        Item.Detail,
        Item.Accent
      )
    );
  end for;
  const Range: C.ValueRange? := Value.Range;
  return new Native.CuiChartOptions(
    Width.Kind, Width.Value, Value.Height, Value.Labels, Format(Value.Format),
    Value.Area, Value.Grid, Value.Legend, Value.Stacked, Value.Smooth, Value.Dither,
    if Range = null then
      0.0F
    else
      Range.Minimum
    end if,
    if Range = null then
      0.0F
    else
      Range.Maximum
    end if, Items.ToArray()
  );
end function;

end unit;
