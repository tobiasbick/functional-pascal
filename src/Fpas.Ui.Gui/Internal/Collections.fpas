unit Fpas.Ui.Gui.Internal.Collections;

uses
  Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as C,
  Fpas.Ui.Choices as Ch, Fpas.Ui.Layout as L, Fpas.Ui.Gui.Internal.Sizing as Size,
  System as Sys, System.Collections.Generic as Generic;

function Move<TMsg>(
  State: C.State<TMsg>; Role: string; Id: string; Keys: array of string;
  Enabled: array of bool; Horizontal: bool
): string?;
begin
  if not State.AcceptInput then
    return null;
  end if;
  var Current: int := -1;
  for I: int := 0 to Keys.Length - 1 do
    if State.Window.WasFocused(C.Token(Role, Id, Keys[I])) then
      Current := I;
    end if;
  end for;

  if Current < 0 then
    return null;
  end if;
  var Direction: int := 0;
  if State.Window.KeyPressed(if Horizontal then 7 else 9 end if) then
    Direction := -1;
  end if;

  if State.Window.KeyPressed(if Horizontal then 8 else 10 end if) then
    Direction := 1;
  end if;

  if Direction = 0 then
    return null;
  end if;
  var Next: int := Current + Direction;
  while Next >= 0 and Next < Keys.Length do
    if Enabled[Next] then
      State.Focus.Enqueue('native:' + C.Token(Role, Id, Keys[Next]));
      return Keys[Next];
    end if;

    Next := Next + Direction;
  end while;

  return null;
end function;

// Draws keyed independent actions.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `State`: Frame context.
// - `Id`: Collection identity.
// - `Items`: Ordered keyed actions.
// - `Enabled`: Collection permission.
public procedure Actions<TMsg>(State: C.State<TMsg>; Id: string; Items: array of Ch.ListItem<TMsg>; Enabled: bool);
begin
  var Preferred: string? := null;
  for Item: Ch.ListItem<TMsg> in Items do
    if Item.Enabled and (Preferred = null or Item.Selected) then
      Preferred := Item.Key;
    end if;
  end for;

  State.Window.BeginGroup(false, 0, 0, 0, false);
  for Item: Ch.ListItem<TMsg> in Items do
    const Allowed: bool := Enabled and Item.Enabled and State.AcceptInput;
    const Token: string := C.Token('action', Id, Item.Key);
    const Events: int := State.Window.Control(
      Token,
      Item.Text,
      2,
      Allowed,
      Item.Selected,
      0,
      C.WantsFocus<TMsg>(State, Id, Token, Allowed, Item.Key = Preferred)
    );
    if (Events and 1) <> 0 and Allowed then
      State.Messages.Add(Item.Message);
    end if;

    State.Window.FillLastWidth();
    C.Track<TMsg>(
      State,
      new App.Control(
        Id,
        Item.Text,
        'action',
        new Cui.CuiRectangle(),
        Allowed,
        Key := Item.Key,
        Value := Item.Selected.ToString()
      )
    );
  end for;

  State.Window.EndGroup();
end procedure;

// Draws controlled selection or tabs; activation is distinct from selection.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `State`: Frame context.
// - `Id`: Collection identity.
// - `Items`: Ordered items.
// - `Selected`: Model selection.
// - `OnSelect`: Selection mapper.
// - `OnActivate`: Optional activation mapper.
// - `Enabled`: Collection permission.
// - `Tabs`: Whether to present a tab strip.
public procedure Select<TMsg>(
  State: C.State<TMsg>; Id: string; Items: array of Ch.SelectionItem; Selected: string?;
  OnSelect: function(string): TMsg; OnActivate: Sys.Func<string, TMsg>?; Enabled: bool; Tabs: bool := false
);
begin
  const Role: string := if Tabs then 'tab' else 'selection' end if;
  const Keys: Generic.List<string> := new Generic.List<string>();
  const Permissions: array of bool := new bool[Items.Length];
  for I: int := 0 to Items.Length - 1 do
    Keys.Add(Items[I].Key);
    Permissions[I] := Enabled and Items[I].Enabled;
  end for;
  const Moved: string? := Move<TMsg>(State, Role, Id, Keys.ToArray(), Permissions, Tabs);
  var Preferred: string? := null;
  for Item: Ch.SelectionItem in Items do
    if Item.Enabled and (Preferred = null or Item.Key = Selected) then
      Preferred := Item.Key;
    end if;
  end for;

  State.Window.BeginGroup(Tabs, 0, 4, 0, false);
  for Item: Ch.SelectionItem in Items do
    const Allowed: bool := Enabled and Item.Enabled and State.AcceptInput;
    const Token: string := C.Token(Role, Id, Item.Key);
    const Events: int := State.Window.Control(
      Token,
      Item.Text,
      if Tabs then 3 else 2 end if,
      Allowed,
      Selected = Item.Key,
      0,
      C.WantsFocus<TMsg>(State, Id, Token, Allowed, Item.Key = Preferred)
    );
    if not Tabs then
      State.Window.FillLastWidth();
    end if;

    if Allowed then
      if ((Events and 1) <> 0 or Moved = Item.Key) and Selected <> Item.Key then
        State.Messages.Add(OnSelect(Item.Key));
      end if;

      if (Events and 1) <> 0 and Item.CanActivate and State.Window.IsActivation then
        case OnActivate of
          when is Sys.Func<string, TMsg> as Activate:
            State.Messages.Add(Activate.Invoke(Item.Key));
          else
        end case;
      end if;
    end if;

    C.Track<TMsg>(
      State,
      new App.Control(
        Id,
        Item.Text,
        Role,
        new Cui.CuiRectangle(),
        Allowed,
        Key := Item.Key,
        Value := (Selected = Item.Key).ToString()
      )
    );
  end for;

  State.Window.EndGroup();
end procedure;

// Draws tabular cells with common column constraints and keyed row selection.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `State`: Frame context.
// - `Id`: Table identity.
// - `Columns`: Column descriptions.
// - `Rows`: Keyed rows.
// - `Selected`: Model selection.
// - `OnSelect`: Selection mapper.
// - `OnActivate`: Optional row activation mapper.
// - `Enabled`: Input permission.
public procedure Table<TMsg>(
  State: C.State<TMsg>; Id: string; Columns: array of Ch.TableColumn; Rows: array of Ch.TableRow;
  Selected: string?; OnSelect: function(string): TMsg; OnActivate: Sys.Func<string, TMsg>?; Enabled: bool
);
  function MinimumWord(Text: string): float;
  begin
    var Width: float := 0;
    for Word: string in Text.Split(new char[0], Sys.StringSplitOptions.RemoveEmptyEntries) do
      Width := Sys.Math.Max(Width, State.Window.MeasureText(Word));
    end for;

    return Width;
  end function;
begin
  const Keys: Generic.List<string> := new Generic.List<string>();
  const Permissions: array of bool := new bool[Rows.Length];
  for I: int := 0 to Rows.Length - 1 do
    Keys.Add(Rows[I].Key);
    Permissions[I] := Enabled and Rows[I].Enabled;
  end for;
  const Moved: string? := Move<TMsg>(State, 'row', Id, Keys.ToArray(), Permissions, false);
  var Preferred: string? := null;
  for Row: Ch.TableRow in Rows do
    if Row.Enabled and (Preferred = null or Row.Key = Selected) then
      Preferred := Row.Key;
    end if;
  end for;
  const Sizes: Generic.List<L.Flex> := new Generic.List<L.Flex>();
  const ContentWidths: array of float := new float[Columns.Length];
  for I: int := 0 to Columns.Length - 1 do
    var Settings: L.Flex := Columns[I].Sizing;
    case Settings.Basis of
      when L.Extent.Fixed(_):
      else
        var Width: float := State.Window.MeasureText(Columns[I].Header);
        var Minimum: float := MinimumWord(Columns[I].Header);
        for Row: Ch.TableRow in Rows do
          Width := Sys.Math.Max(Width, State.Window.MeasureText(Row.Cells[I]));
          Minimum := Sys.Math.Max(Minimum, MinimumWord(Row.Cells[I]));
        end for;

        ContentWidths[I] := Width;
        const LowerBound: L.Measure? := Settings.Minimum;
        const UpperBound: L.Measure? := Settings.Maximum;
        const Lower: float := if LowerBound = null then 0 else Size.Measure(LowerBound) end if;
        const Upper: float := if UpperBound = null then float.MaxValue
          else Size.Measure(
            UpperBound
          )
          end if;
        Settings := Settings with
          Minimum := L.Measure.Logical(
            cast<int>(Sys.Math.Ceiling(Sys.Math.Clamp(Minimum, Lower, Upper)))
          );
        end with;
    end case;

    Sizes.Add(Settings);
  end for;

  State.Window.BeginGroup(false, 0, 0, 0, false);
  State.Window.BeginGroup(true, 12, 8, 0, false);
  for I: int := 0 to Columns.Length - 1 do
    State.Window.Text(Columns[I].Header);
    State.Window.PreferLastWidth(ContentWidths[I]);
    Size.Apply(State.Window, Sizes[I], true, L.Alignment.Stretch);
  end for;

  State.Window.EndGroup();
  State.Window.FillLastWidth();
  for Row: Ch.TableRow in Rows do
    const Allowed: bool := Enabled and Row.Enabled and State.AcceptInput;
    const Token: string := C.Token('row', Id, Row.Key);
    const Events: int := State.Window.BeginChoiceRow(
      Token,
      Allowed,
      Selected = Row.Key,
      C.WantsFocus<TMsg>(State, Id, Token, Allowed, Row.Key = Preferred)
    );
    for I: int := 0 to Row.Cells.Length - 1 do
      State.Window.Text(Row.Cells[I]);
      State.Window.PreferLastWidth(ContentWidths[I]);
      Size.Apply(State.Window, Sizes[I], true, L.Alignment.Stretch);
    end for;

    State.Window.EndGroup();
    State.Window.FillLastWidth();
    if Allowed then
      if ((Events and 1) <> 0 or Moved = Row.Key) and Selected <> Row.Key then
        State.Messages.Add(OnSelect(Row.Key));
      end if;

      if (Events and 1) <> 0 and Row.CanActivate and State.Window.IsActivation then
        case OnActivate of
          when is Sys.Func<string, TMsg> as Activate:
            State.Messages.Add(Activate.Invoke(Row.Key));
          else
        end case;
      end if;
    end if;

    C.Track<TMsg>(
      State,
      new App.Control(
        Id,
        Sys.String.Join(' | ', Row.Cells),
        'row',
        new Cui.CuiRectangle(),
        Allowed,
        Key := Row.Key,
        Value := (Selected = Row.Key).ToString()
      )
    );
  end for;

  State.Window.EndGroup();
end procedure;
end unit;
