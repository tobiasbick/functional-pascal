// [Documentation](../../../../docs/ui/gui/host.md#frame-preparation-and-presentation)

unit Fpas.Ui.Gui.Internal.Core.Parts;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Values as V;

uses System as Sys;
uses System.Collections.Generic as Lists;

// Builds indexed native part names.
// ## Parameters
// - `Count`: Number of indexed parts.
// - `Last`: Optional trailing action name.
// ## Returns
// The part names in native order.
public function Indexed(Count: int; Last: string := ''): array of string;
begin
  const Parts: Lists.List of string := new Lists.List of string(Count + V.Bits(Last <> '', 1));
  for Index: int := 0 to Count - 1 do
    Parts.Add(Index.ToString(Sys.Globalization.CultureInfo.InvariantCulture));
  end for;

  if Last <> '' then
    Parts.Add(Last);
  end if;

  return Parts.ToArray();
end function;

// Builds a common input mask for native parts.
// ## Parameters
// - `Count`: Number of parts.
// - `Enabled`: Default input permission.
// ## Returns
// The per-part mask.
public function Inputs(Count: int; Enabled: bool): array of bool;
begin
  const Values: array of bool := new bool[Count];
  Sys.Array.Fill of bool(Values, Enabled);
  return Values;
end function;

function PartId(Id: string; Key: string): string;
begin
  return if Key = '' then
    Id
  else
    Id + '/' + Key
  end if;
end function;

// Finds a pending focus request for a native part.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Role`: Snapshot role.
// - `Parts`: Part names in native order.
// - `Accept`: Input permission by part.
// - `Preferred`: Preferred part for a whole-widget request.
// ## Returns
// The native part index or minus one.
public function Focus of TMsg(Frame: C.State of TMsg; Id: string; Role: string; Parts: array of string; Accept: array of bool; Preferred: int): int;
begin
  for Index: int := 0 to Parts.Length - 1 do
    const Part: string := PartId(Id, Parts[Index]);
    const Native: string := C.Token(Role, Part);
    if C.WantsFocus of TMsg(Frame, Part, Native, Accept[Index])
      or (Index = Preferred and C.WantsFocus of TMsg(Frame, Id, Native, Accept[Index]))
    then
      return Index;
    end if;
  end for;

  return -1;
end function;

// Maps CUI part indices to snapshot tracking identities.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Role`: Snapshot role.
// - `Parts`: Part names in native order.
// ## Returns
// The tracking mapper, or null while painting a closing view.
public function Tracker of TMsg(Frame: C.State of TMsg; Id: string; Role: string; Parts: array of string): Sys.Func of (int, string)?;
begin
  if Frame.PaintingClosed then
    return null;
  end if;

  return function(Index: int): string => C.Token(Role, PartId(Id, Parts[Index]));
end function;

// Records the outer widget's native rectangle.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Role`: Snapshot role.
// - `Caption`: Visible label.
// - `Enabled`: Input permission.
// - `Value`: Snapshot value.
public procedure Root of TMsg(Frame: C.State of TMsg; Id: string; Role: string; Caption: string; Enabled: bool; Value: string);
begin
  C.Track of TMsg(
    Frame,
    new App.Control(Id, Caption, Role, new Cui.CuiRectangle(), Enabled, Value := Value)
  );
end procedure;

// Records a tracked child part.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Role`: Snapshot role.
// - `Key`: Part name.
// - `Caption`: Visible label.
// - `Enabled`: Input permission.
// - `Value`: Snapshot value.
public procedure Part of TMsg(Frame: C.State of TMsg; Id: string; Role: string; Key: string; Caption: string; Enabled: bool; Value: string);
begin
  if not Frame.PaintingClosed then
    Frame.Controls.Add(
      new App.Control(
        PartId(Id, Key),
        Caption,
        Role,
        new Cui.CuiRectangle(),
        Enabled,
        Value := Value
      )
    );
  end if;
end procedure;

end unit;
