// [Documentation](../../../../docs/ui/gui/host.md#frame-preparation-and-presentation)

unit Fpas.Ui.Gui.Internal.Core.Values;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Widgets.Audio.ControlWells as Wells;

// Encodes a flag.
// ## Parameters
// - `Set`: Whether to set the flag.
// - `Bit`: Native bit mask.
// ## Returns
// The mask or zero.
public function Bits(Set: bool; Bit: int): int;
begin
  return if Set then
    Bit
  else
    0
  end if;
end function;

// Encodes an RGBA color.
// ## Parameters
// - `Color`: Straight-alpha color.
// ## Returns
// Packed native channels.
public function Pack(Color: G.Color): uint;
begin
  return cast Color.Red as uint or (cast Color.Green as uint shl 8)
    or (cast Color.Blue as uint shl 16) or (cast Color.Alpha as uint shl 24);
end function;

// Encodes an optional RGBA color.
// ## Parameters
// - `Color`: Straight-alpha color, or null.
// ## Returns
// Packed native channels, or null for the widget default.
public function PackOptional(Color: G.Color?): uint?;
begin
  return if Color = null then
    null
  else
    Pack(Color)
  end if;
end function;

// Decodes an RGBA color.
// ## Parameters
// - `Value`: Packed native channels.
// ## Returns
// Straight-alpha color.
public function Unpack(Value: uint): G.Color;
begin
  return new G.Color(
    cast (Value and 255U) as byte, cast ((Value shr 8) and 255U) as byte,
    cast ((Value shr 16) and 255U) as byte, cast (Value shr 24) as byte
  );
end function;

// Encodes the pressed appearance.
// ## Parameters
// - `Tool`: Optional action button.
// ## Returns
// The native active flag.
public function ToolBits(Tool: Wells.Tool?): int;
begin
  return Bits(Tool <> null and Tool.Active, 4);
end function;

// Gets the action glyph.
// ## Parameters
// - `Tool`: Optional action button.
// ## Returns
// The glyph or an empty string.
public function Icon(Tool: Wells.Tool?): string;
begin
  return if Tool = null then
    ''
  else
    Tool.Icon
  end if;
end function;

// Gets the action name.
// ## Parameters
// - `Tool`: Optional action button.
// ## Returns
// The tooltip or an empty string.
public function Tooltip(Tool: Wells.Tool?): string;
begin
  return if Tool = null then
    ''
  else
    Tool.Tooltip
  end if;
end function;

end unit;
