// [Documentation](../../../../docs/ui/gui/host.md#frame-preparation-and-presentation)

unit Fpas.Ui.Gui.Internal.Data.ChartData;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Gui.Cui.Widgets.Charts as CuiCharts;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as Size;
uses Fpas.Ui.Widgets.Charts.Charts as C;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System.Collections.Generic as Lists;

// Converts a semantic chart color without resolving theme tokens early.
// ## Parameters
// - `Value`: Shared color.
// ## Returns
// Native palette selector or packed RGBA.
public function Color(Value: C.Color): CuiCharts.CuiChartColor;
begin
  return case Value of
    when C.Color.Automatic: new CuiCharts.CuiChartColor();
    when C.Color.Theme(
      const Token: Themes.ColorToken
    ): CuiCharts.CuiChartColor.Theme(cast Token as int);
    when C.Color.Rgba(const Rgba: G.Color): new CuiCharts.CuiChartColor(
      -1,
      cast Rgba.Red as uint or (cast Rgba.Green as uint shl 8) or (cast Rgba.Blue as uint shl 16)
      or (cast Rgba.Alpha as uint shl 24)
    );
  end case;
end function;

// Converts safe value formatting.
// ## Parameters
// - `Value`: Optional shared format.
// ## Returns
// Native format, or null for automatic formatting.
public function Format(Value: C.ValueFormat?): CuiCharts.CuiChartFormat?;
begin
  return if Value = null then
    null
  else
    new CuiCharts.CuiChartFormat(
      Value.DecimalPlaces, Value.Prefix, Value.Suffix,
      cast cast Value.Notation as int as CuiCharts.CuiValueNotation, Value.FieldWidth,
      cast cast Value.Padding as int as CuiCharts.CuiValuePadding,
      cast cast Value.Sign as int as CuiCharts.CuiValueSign,
      Value.Alternate, Value.Uppercase
    )
  end if;
end function;

// Converts the series without retaining pinned application storage.
// ## Parameters
// - `Values`: Shared series.
// ## Returns
// Native binding series.
public function Series(Values: array of C.Series): array of CuiCharts.CuiChartSeries;
begin
  const Result: Lists.List of CuiCharts.CuiChartSeries := new Lists.List of CuiCharts.CuiChartSeries();
  for Item: C.Series in Values do
    Result.Add(new CuiCharts.CuiChartSeries(Item.Name, Item.Values, Color(Item.Color)));
  end for;

  return Result.ToArray();
end function;

// Converts named visualization amounts.
// ## Parameters
// - `Values`: Shared items.
// ## Returns
// Native items retaining input order and semantic colors.
public function Items(Values: array of C.Item): array of CuiCharts.CuiVizItem;
begin
  const Result: Lists.List of CuiCharts.CuiVizItem := new Lists.List of CuiCharts.CuiVizItem();
  for Item: C.Item in Values do
    Result.Add(new CuiCharts.CuiVizItem(Item.Label, Item.Value, Color(Item.Color)));
  end for;

  return Result.ToArray();
end function;

// Converts options for native line and bar widgets.
// ## Parameters
// - `Value`: Shared chart settings.
// ## Returns
// Native presentation, including reference lines and point annotations.
public function Options(Value: C.Options): CuiCharts.CuiChartOptions;
begin
  const Width: Size.NativeExtent := Size.Extent(Value.Width);
  const Items: Lists.List of CuiCharts.CuiChartAnnotation := new Lists.List of CuiCharts.CuiChartAnnotation();
  for Item: C.Annotation in Value.Annotations do
    Items.Add(
      new CuiCharts.CuiChartAnnotation(
        cast Item.Kind as int,
        Item.X,
        Item.Y,
        Item.Label,
        Item.Detail,
        Item.Accent,
        Color(Item.Color)
      )
    );
  end for;
  const Range: C.ValueRange? := Value.Range;
  return new CuiCharts.CuiChartOptions(
    Width.Kind, Width.Value, Value.Height, Value.Labels, Format(Value.Format),
    Value.Area, Value.Grid, Value.Legend, Value.Stacked, Value.Smooth, Value.Dither,
    if Range = null then
      0.0F
    else
      Range.Minimum
    end if,
    if Range = null then
      0.0F
    else
      Range.Maximum
    end if, Items.ToArray(), Value.XMinimum, Value.XMaximum
  );
end function;

end unit;
