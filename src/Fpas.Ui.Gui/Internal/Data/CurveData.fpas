// [Documentation](../../../../docs/ui/gui/host.md#frame-preparation-and-presentation)

unit Fpas.Ui.Gui.Internal.Data.CurveData;

uses Fpas.Ui.Gui.Cui.Widgets.Editors as CuiEditors;
uses Fpas.Ui.Widgets.Editors.CurveEditors as W;

// Converts one curve key for CUI.
// ## Parameters
// - `Value`: Model key.
// ## Returns
// Native position, handles and mode.
public function Pack(Value: W.Key): CuiEditors.CuiCurveKey;
begin
  return new CuiEditors.CuiCurveKey(
    Value.X,
    Value.Y,
    Value.InX,
    Value.InY,
    Value.OutX,
    Value.OutY,
    cast Value.Interpolation as byte
  );
end function;

// Converts one edited key to FPAS.
// ## Parameters
// - `Value`: Native key.
// ## Returns
// The proposed model key.
public function Read(Value: CuiEditors.CuiCurveKey): W.Key;
begin
  return new W.Key(
    Value.X,
    Value.Y,
    Value.InX,
    Value.InY,
    Value.OutX,
    Value.OutY,
    cast Value.Mode as W.Mode
  );
end function;

end unit;
