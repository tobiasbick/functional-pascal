unit Fpas.Ui.Gui.Internal.Data.MediaData;

uses Fpas.Ui.Widgets.Media.MediaImages as Media, Fpas.Ui.Gui.Cui.Widgets.Media as CuiMedia;

// Converts a shared picture source to the native upload descriptor.
// ## Parameters
// - `Source`: Validated file path or RGBA data.
// ## Returns
// A descriptor retaining the original source.
public function Convert(Source: Media.Source): CuiMedia.CuiMediaImage;
begin
  case Source of
    when Media.Source.File(const Path: string):
      return new CuiMedia.CuiMediaImage(Path);
    when Media.Source.Rgba(const Width: int, const Height: int, const Pixels: array of byte):
      return new CuiMedia.CuiMediaImage(null, Width, Height, Pixels);
  end case;
end function;

end unit;
