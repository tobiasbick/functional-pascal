// [Documentation](../../../../docs/ui/gui/host.md#frame-preparation-and-presentation)

unit Fpas.Ui.Gui.Internal.Data.MotionData;

uses Fpas.Ui.Gui.Cui.Widgets.Motion as CuiMotion;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Colors;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Motion.Motion as M;

// Converts common animated-text settings.
// ## Parameters
// - `Value`: Validated effect options.
// ## Returns
// Native layout and effect options.
public function Options(Value: M.TextOptions): CuiMotion.CuiMotionText;
begin
  const Width: S.NativeExtent := S.Extent(Value.Width);
  return new CuiMotion.CuiMotionText(
    cast Value.Font as int, Width.Kind, Width.Value, Colors.Color(Value.Color),
    Value.Size, Value.Speed, Value.Delay, Value.NoWrap, Value.Caret
  );
end function;

end unit;
