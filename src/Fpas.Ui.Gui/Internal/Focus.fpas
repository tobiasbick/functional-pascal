unit Fpas.Ui.Gui.Internal.Focus;

uses Fpas.Ui.ExpandableTexts as ExpandableTexts, Fpas.Ui.ExpandableCards as ExpandableCards, Fpas.Ui.Reactions as Reactions, Fpas.Ui.UserMenus as UserMenus, Fpas.Ui.Selects as Selects, Fpas.Ui.NumberFields as NumberFields, Fpas.Ui.TagInputs as TagInputs, Fpas.Ui.OneTimeCodes as OneTimeCodes, Fpas.Ui.SearchFields as SearchFields, Fpas.Ui.TextAreas as TextAreas, Fpas.Ui.Dialogs as Dialogs, Fpas.Ui.TextFields as TextFields, Fpas.Ui.Tabs as Tabs, Fpas.Ui.Breadcrumbs as Breadcrumbs, Fpas.Ui.RadioCards as RadioCards, Fpas.Ui.Sliders as Sliders, Fpas.Ui.RangeSliders as RangeSliders, Fpas.Ui.RadioGroups as RadioGroups, Fpas.Ui.ToggleGroups as ToggleGroups, Fpas.Ui.Menus as Menus, Fpas.Ui.SegmentedControls as Segmented, Fpas.Ui.ThemeSwitchers as ThemeSwitchers, Fpas.Ui.StatusButtons as Status, Fpas.Ui.ConfirmButtons as Confirms, Fpas.Ui.SplitButtons as Split, Fpas.Ui.HoldButtons as Holds, Fpas.Ui.Elements as E, Fpas.Ui.Validation as V, Fpas.Ui.Navigation as N, Fpas.Ui.Sheets as Sheets, Fpas.Ui.Buttons as B, Fpas.Ui.IconButtons as Icons, System as Sys;

// Finds the first enabled focus stop in the active modal/view scope.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `Node`: Prepared subtree.
// - `Prepared`: Resolved cached subviews.
// - `Preferred`: Optional enabled ID to locate instead of the first stop.
//
// ## Returns
// Its application ID, or null.
public function First<TMsg>(Node: E.Element<TMsg>; Prepared: V.Prepared<TMsg>; Preferred: string? := null): string?;
begin
  case Node of
    when E.Element.SelectInput(const Id: string, _, _, _, const Settings: Selects.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.NumberField(const Id: string, _, _, _, _, const Settings: NumberFields.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.TextField(const Id: string, _, _, const Settings: TextFields.Options, _):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.SearchField(const Id: string, _, _, const Settings: SearchFields.Options, _):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.TextArea(const Id: string, _, _, const Settings: TextAreas.Options, _):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.TagInput(const Id: string, _, _, const Settings: TagInputs.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.OneTimeCodeInput(
      const Id: string,
      _,
      _,
      const Settings: OneTimeCodes.Options,
      _
    ):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.CopyAction(const Id: string, _, _, const Enabled: bool):
      if Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.HoldAction(const Id: string, _, _, const Settings: Holds.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.ConfirmAction(const Id: string, _, _, const Settings: Confirms.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.StatusAction(const Id: string, _, _, _, const Settings: Status.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.ThemeFlip(const Id: string, _, _, const Enabled: bool):
      if Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.Segments(
      const Id: string,
      const Items: array of Segmented.Item,
      const Selected: int,
      _,
      const Settings: Segmented.Options
    ):
      if Settings.Enabled then
        if Preferred = Id then
          return Segmented.ItemId(Id, Selected);
        end if;

        for Index: int := 0 to Items.Length - 1 do
          const Item: string := Segmented.ItemId(Id, Index);
          if Preferred = null or Preferred = Item then
            return Item;
          end if;
        end for;
      end if;
    when E.Element.Toggles(
      const Id: string,
      const Items: array of ToggleGroups.Item,
      _,
      _,
      const Settings: ToggleGroups.Options
    ):
      if Settings.Enabled then
        for Index: int := 0 to Items.Length - 1 do
          const Item: string := ToggleGroups.ItemId(Id, Index);
          if Preferred = null or Preferred = Item or (Preferred = Id and Index = 0) then
            return Item;
          end if;
        end for;
      end if;
    when E.Element.TabStrip(
      const Id: string,
      const Items: array of Tabs.Item,
      const Selected: int,
      _,
      const Settings: Tabs.Options
    ):
      if Settings.Enabled then
        if Preferred = Id then
          return Tabs.ItemId(Id, Selected);
        end if;

        for Index: int := 0 to Items.Length - 1 do
          const Item: string := Tabs.ItemId(Id, Index);
          if Preferred = null or Preferred = Item then
            return Item;
          end if;
        end for;
      end if;
    when E.Element.BreadcrumbTrail(
      const Id: string,
      const Items: array of string,
      _,
      const Enabled: bool
    ):
      if Enabled then
        for Index: int := 0 to Items.Length - 2 do
          const Item: string := Breadcrumbs.ItemId(Id, Index);
          if Preferred = null or Preferred = Item or (Preferred = Id and Index = 0) then
            return Item;
          end if;
        end for;
      end if;
    when E.Element.PaginationAction(const Id: string, _, _, _, const Enabled: bool):
      if Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.CheckboxAction(
      const Id: string,
      _,
      _,
      _,
      _,
      const Enabled: bool,
      _
    ), E.Element.SwitchAction(
      const Id: string,
      _,
      _,
      _,
      _,
      const Enabled: bool
    ), E.Element.RadioAction(
      const Id: string,
      _,
      _,
      _,
      _,
      const Enabled: bool
    ), E.Element.ChipAction(const Id: string, _, _, _, _, const Enabled: bool):
      if Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.Radios(
      const Id: string,
      const Items: array of RadioGroups.Item,
      _,
      _,
      const Enabled: bool,
      _
    ):
      if Enabled then
        for Index: int := 0 to Items.Length - 1 do
          const Item: string := RadioGroups.ItemId(Id, Index);
          if Items[Index].Enabled and (Preferred = null or Preferred = Item) then
            return Item;
          end if;
        end for;
      end if;
    when E.Element.SliderAction(const Id: string, _, _, _, _, _, const Settings: Sliders.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.RangeSliderAction(const Id: string, _, _, _, _, _, const Enabled: bool):
      if Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.Cards(
      const Id: string,
      const Items: array of RadioCards.Item,
      const Selected: int,
      _,
      const Settings: RadioCards.Options
    ):
      if Settings.Enabled then
        if Preferred = Id then
          return RadioCards.ItemId(Id, Sys.Math.Max(0, Selected));
        end if;

        for Index: int := 0 to Items.Length - 1 do
          const Item: string := RadioCards.ItemId(Id, Index);
          if Preferred = null or Preferred = Item then
            return Item;
          end if;
        end for;
      end if;
    when E.Element.ThemeChoice(const Id: string, _, _, const Settings: ThemeSwitchers.Options):
      if Settings.Enabled then
        for Index: int := 0 to (if Settings.WithSystem then 2 else 1 end if) do
          const Item: string := ThemeSwitchers.ItemId(Id, cast<ThemeSwitchers.Selection>(Index));
          if Preferred = null or Preferred = Item then
            return Item;
          end if;
        end for;
      end if;
    when E.Element.ReactionGroup(
      const Id: string,
      const Items: array of Reactions.Item,
      _,
      const Enabled: bool
    ):
      if Enabled then
        for Index: int := 0 to Items.Length - 1 do
          const Item: string := Reactions.ItemId(Id, Index);
          if Preferred = null or Preferred = Item then
            return Item;
          end if;
        end for;
      end if;
    when E.Element.AccountMenu(const Id: string, _, _, const Settings: UserMenus.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.Dropdown(const Id: string, _, _, const Settings: Menus.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.SplitAction(const Id: string, _, _, _, const Settings: Split.Options):
      if Settings.Enabled then
        if Preferred = null or Preferred = Id then
          return Id;
        elsif Preferred = Split.MenuId(Id) then
          return Preferred;
        end if;
      end if;
    when E.Element.ButtonAction(const Id: string, _, _, const Settings: B.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.IconAction(const Id: string, _, _, _, const Settings: Icons.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.Sidebar(
      const Id: string,
      const Sections: array of N.Section<TMsg>,
      _,
      const Enabled: bool
    ):
      if Enabled then
        for Section: N.Section<TMsg> in Sections do
          for Item: N.Item<TMsg> in Section.Items do
            const ItemId: string := N.ItemId(Id, Item.Key);
            if Item.Enabled and (Preferred = null or Preferred = ItemId) then
              return ItemId;
            end if;
          end for;
        end for;
      end if;
    when E.Element.Stack(
      const Children: array of E.Element<TMsg>,
      _,
      _
    ), E.Element.ButtonGroup(
      const Children: array of E.Element<TMsg>
    ), E.Element.ActionFooter(const Children: array of E.Element<TMsg>):
      for Child: E.Element<TMsg> in Children do
        const Found: string? := First<TMsg>(Child, Prepared, Preferred);
        if Found <> null then
          return Found;
        end if;
      end for;
    when E.Element.Contextual(
      _,
      const Child: E.Element<TMsg>,
      _,
      _
    ), E.Element.Hinted(const Child: E.Element<TMsg>, _, _):
      return First<TMsg>(Child, Prepared, Preferred);
    when E.Element.Accordion(
      const Id: string,
      _,
      const Open: bool,
      _,
      const Content: E.Element<TMsg>,
      const Enabled: bool
    ):
      if Enabled then
        if Preferred = null or Preferred = Id then
          return Id;
        end if;

        if Open then
          return First<TMsg>(Content, Prepared, Preferred);
        end if;
      end if;
    when E.Element.ExpandableCard(
      const Id: string,
      _,
      const Open: bool,
      _,
      const Content: E.Element<TMsg>,
      const Settings: ExpandableCards.Options
    ):
      if Settings.Enabled then
        if Preferred = null or Preferred = Id then
          return Id;
        end if;

        if Open then
          return First<TMsg>(Content, Prepared, Preferred);
        end if;
      end if;
    when E.Element.ExpandableText(const Id: string, _, const Settings: ExpandableTexts.Options, _):
      // The native link may not exist until layout decides whether the text overflows.
      if Settings.Enabled and (Preferred = Id or Preferred =
        ExpandableTexts.ToggleId(
        Id
      ))
      then
        return ExpandableTexts.ToggleId(Id);
      end if;
    when E.Element.Popover(
      _,
      const Trigger: E.Element<TMsg>,
      const Content: E.Element<TMsg>,
      const Open: bool,
      _,
      _
    ):
      const Found: string? := First<TMsg>(Trigger, Prepared, Preferred);
      if Found <> null or not Open then
        return Found;
      end if;

      return First<TMsg>(Content, Prepared, Preferred);
    when E.Element.Dialog(
      const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>,
      const Open: bool, const Settings: Dialogs.Options, _
    ):
      if not Open then
        return First<TMsg>(Base, Prepared, Preferred);
      end if;
      const Close: string := Dialogs.CloseId(Id);
      if Settings.CloseButton and (Preferred = null or Preferred = Close) then
        return Close;
      end if;

      return First<TMsg>(Content, Prepared, Preferred);
    when E.Element.ConfirmPopover(_, const Trigger: E.Element<TMsg>, _, _, _, _):
      return First<TMsg>(Trigger, Prepared, Preferred);
    when E.Element.Sized(const Child: E.Element<TMsg>, _):
      return First<TMsg>(Child, Prepared, Preferred);
    when E.Element.Styled(const Child: E.Element<TMsg>, _):
      return First<TMsg>(Child, Prepared, Preferred);
    when E.Element.Framed(const Child: E.Element<TMsg>, _):
      return First<TMsg>(Child, Prepared, Preferred);
    when E.Element.Scroll(_, const Child: E.Element<TMsg>, _, _, _):
      return First<TMsg>(Child, Prepared, Preferred);
    when E.Element.Sheet(
      const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>,
      const Open: bool, _, _
    ):
      if not Open then
        return First<TMsg>(Base, Prepared, Preferred);
      end if;
      const Close: string := Sheets.CloseId(Id);
      if Preferred = null or Preferred = Close then
        return Close;
      end if;

      return First<TMsg>(Content, Prepared, Preferred);
    when E.Element.Deferred(const Id: string, _):
      return First<TMsg>(Prepared.Subviews[Id].Tree, Prepared, Preferred);
    else
  end case;

  return null;
end function;
end unit;
