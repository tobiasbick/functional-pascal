// [Documentation](../../../../docs/ui/gui/host.md#application-shortcuts)

unit Fpas.Ui.Gui.Internal.Hosting.KeyBindings;

uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Shortcuts as S;

uses System as Sys;
uses System.Collections.Generic as Lists;

// Retained typed bindings and their ABI-ready native combinations.
// ## Type parameters
// - `TMsg`: Application message type.
public type Prepared of TMsg = record
  // Immutable model-owned typed bindings.
  public Entries: array of S.Binding of TMsg;
  // Corresponding native key/modifier policies.
  public Native: array of Cui.CuiShortcut;
end record;

// Resolves bindings only when the model view changes.
// ## Type parameters
// - `TModel`: Current model type.
// - `TMsg`: Application message type.
// ## Parameters
// - `Model`: Current committed model.
// - `Select`: Optional model selector.
// ## Returns
// Retained bindings; an absent selector supplies no application shortcuts.
public function Prepare of (TModel, TMsg)(
  Model: TModel;
  Select: Sys.Func of (TModel, array of S.Binding of TMsg)?
): Prepared of TMsg;
begin
  const Entries: array of S.Binding of TMsg := case Select of
    when is Sys.Func of (TModel, array of S.Binding of TMsg) as Choose: Choose.Invoke(Model);
    else [];
  end case;
  const Native: Lists.List of Cui.CuiShortcut := new Lists.List of Cui.CuiShortcut(Entries.Length);
  for Entry: S.Binding of TMsg in Entries do
    Native.Add(
      new Cui.CuiShortcut(
        cast Entry.Combination.Key as int, cast Entry.Combination.Modifiers as int,
        Entry.Enabled, Entry.Repeat, Entry.AllowWhileEditing
      )
    );
  end for;

  return new Prepared of TMsg(Entries, Native.ToArray());
end function;

// Collects application shortcuts after all native widgets have processed input.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Window`: Owner window in an active frame.
// - `Bindings`: Retained bindings for this view.
// - `Accept`: Whether application input is admitted.
// - `Messages`: Typed proposals to enqueue after presentation.
public procedure Collect of TMsg(
  Window: Cui.CuiWindow;
  Bindings: Prepared of TMsg;
  Accept: bool;
  Messages: Lists.List of TMsg
);
begin
  if not Accept then
    return;
  end if;

  for Index: int in Window.ReadShortcuts(Bindings.Native) do
    Messages.Add(Bindings.Entries[Index].Message);
  end for;
end procedure;

end unit;
