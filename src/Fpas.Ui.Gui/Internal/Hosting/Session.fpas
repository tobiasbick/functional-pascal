// [Documentation](../../../../docs/ui/gui/host.md#application-lifecycle)

unit Fpas.Ui.Gui.Internal.Hosting.Session;

uses Fpas.Ui.Gui.Internal.Hosting.ThemeApplication as ThemeApplication, Fpas.Ui.Gui.Internal.Hosting.KeyBindings as KeyBindings, Fpas.Ui.Gui.Shortcuts as Shortcuts, Fpas.Ui.Gui.Internal.Hosting.FrameControls as FrameControls, Fpas.Ui.Gui.Internal.Hosting.Requests as Requests, Fpas.Ui.Gui.Internal.Layout.LayoutValidation as LayoutValidation, Fpas.Ui.Gui.Internal.Layout.Sizing as Sizing, Fpas.Ui.Gui.Internal.Widgets.Overlays.Tooltip as Tooltip, Fpas.Ui.Gui.Toasts as Toasts, Fpas.Ui.Gui.Internal.Widgets.Feedback.Toast as Toast, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Presentation.Presentation as P, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Input.ModalFocus as F, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Mvu.Session as Runtime, Fpas.Ui.Elements as E, Fpas.Ui.Validation as V, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Theming.Themes as Themes, System as Sys, System.Collections.Generic as Generic, System.Threading.Tasks as Tasks, Fpas.Ui.Gui.Windows as Windows;

// Takes ownership of a native window and drives shared MVU transitions on its creating thread.
//
// ## Type parameters
// - `TModel`: Application model.
// - `TMsg`: Typed messages.
//
// ## Parameters
// - `InitialModel`: Initial state.
// - `Update`: Shared transition and effect commands.
// - `View`: Declarative view with responsive size classes and the resolved theme.
// - `Window`: New owned window.
// - `Capacity`: Positive mailbox capacity.
// - `BeforeDraw`: Owner input injection for integration fixtures.
// - `Theme`: Initial shared theme.
// - `ThemeFor`: Selects a theme from the model and the available system appearance.
// - `ReadSystemAppearance`: Whether native appearance changes invalidate the view.
// - `OnCloseRequested`: Optional close message factory; Exit approves, Closing.Cancel rejects.
// - `BindingsFor`: Optional immutable application bindings selected from the model.
//
// ## Returns
// The manually driven session.
public function StartThemed<TModel, TMsg>(
  InitialModel: TModel;
  Update: function(TModel, TMsg): Mvu.Transition<TModel, TMsg>;
  View: function(TModel, L.Viewport, Themes.Theme): E.Element<TMsg>;
  Window: Cui.CuiWindow; Capacity: int; BeforeDraw: Sys.Action?;
  Theme: Themes.Theme; ThemeFor: function(TModel, Themes.Mode?): Themes.Theme;
  ReadSystemAppearance: bool; OnCloseRequested: Sys.Func<TMsg>? := null;
  BindingsFor: Sys.Func<TModel, array of Shortcuts.Binding<TMsg>>? := null
): App.Session<TMsg>;
requires Capacity > 0;
  procedure CheckOwner();
  begin
    if Sys.Environment.CurrentManagedThreadId <> Owner then
      raise new Sys.InvalidOperationException(
        'Drive and dispose the GUI session on its creating thread.'
      );
    end if;
  end procedure;

  procedure BeginClose();
  begin
    if Cleanup = null then
      const Completion: Tasks.Task := Core.Close();
      Cleanup := Completion;
      Pending.Clear();
      Focus.Clear();
      PendingToasts.Clear();
      ActiveToasts.Clear();
      PendingFrames.Clear();
      Window.WakeWhenCompleted(Completion);
      discard Window.TryWake();
    end if;
  end procedure;

  procedure Finish();
  begin
    const Completion: Tasks.Task? := Cleanup;
    if Completion = null then
      return;
    end if;

    try
      Completion.GetAwaiter().GetResult();
    finally
      Released := true;
      Closed := Window.Placement;
      Window.SetResizeRenderer(null);
      Window.Dispose();
    end try;
  end procedure;

  function Snapshot(): App.Frame;
  begin
    CheckOwner();
    if Driving then
      raise new Sys.InvalidOperationException('Do not inspect a GUI session from its callbacks.');
    end if;

    const Last: App.Frame? := Published;
    if Last = null then
      raise new Sys.InvalidOperationException('No GUI frame has been presented.');
    end if;

    return Last with
      Text := cast<array of string>(Last.Text.Clone());
      Controls := cast<array of App.Control>(Last.Controls.Clone());
    end with;
  end function;

  function Software(): bool;
  begin
    CheckOwner();
    return Window.IsSoftware;
  end function;

  function Inspect(): Windows.Info;
  begin
    CheckOwner();
    return new Windows.Info(Window.Size, Window.State, Window.Backend, Window.NativeWindow);
  end function;

  function Placement(): Cui.CuiWindowPlacement;
  begin
    CheckOwner();
    const Last: Cui.CuiWindowPlacement? := Closed;
    return if Last <> null then
      Last.Value
    else
      Window.Placement
    end if;
  end function;

  procedure Capture(Path: string);
  begin
    CheckOwner();
    if Driving then
      raise new Sys.InvalidOperationException('Capture a GUI frame outside Step callbacks.');
    end if;

    Window.CapturePng(Path);
  end procedure;

  function Context(Candidate: V.Prepared<TMsg>; Accept: bool; ObserveTransitions: bool): C.State<TMsg>;
  begin
    const Last: App.Frame? := Published;
    const Previous: array of App.Control := if Last = null then
      []
    else
      Last.Controls
    end if;
    const Modal: string? := F.TopModal<TMsg>(Candidate.Tree, Candidate, Previous);
    return new C.State<TMsg>(
      Window,
      Candidate,
      new Generic.List<TMsg>(),
      new Generic.List<string>(),
      new Generic.List<App.Control>(),
      Focus,
      Modals,
      new Generic.HashSet<string>(),
      Previous,
      Accept and Modal = null,
      Accept,
      Modal,
      ObserveTransitions := ObserveTransitions,
      CompletedAnimations := CompletedAnimations,
      PreviousFocus := PreviousFocus
    );
  end function;

  procedure ResizeDraw();
  begin
    const Cached: V.Prepared<TMsg>? := Prepared;
    if Cached = null then
      return;
    end if;

    P.Draw<TMsg>(Context(Cached, false, false));
  end procedure;

  procedure Paint(Candidate: V.Prepared<TMsg>; Accept: bool; Size: Cui.CuiSize);
  begin
    const State: C.State<TMsg> := Context(Candidate, Accept, Cleanup = null);
    P.Draw<TMsg>(State);
    KeyBindings.Collect<TMsg>(Window, Bindings, Accept, State.Messages);
    if Accept then
      Focus.Clear();
    end if;

    while PendingFrames.Count > 0 do
      Window.RequestFrame(PendingFrames.Dequeue());
    end while;

    Window.Present();
    C.CommitAnimations<TMsg>(State);
    FrameControls.Resolve(Window, State.Controls);
    if Accept then
      PreviousFocus := '';
      for Control: App.Control in State.Controls do
        if Control.Focused then
          PreviousFocus := C.Token(Control.Role, Control.Id, Control.Key);
        end if;
      end for;
    end if;

    Tooltip.Collect<TMsg>(State);
    if ActiveToasts.Count > 0 then
      Toast.Collect<TMsg>(State, ActiveToasts);
    end if;

    FrameId := FrameId + 1L;
    Published := new App.Frame(
      FrameId, Size, State.Labels.ToArray(), State.Controls.ToArray(),
      CurrentTheme
    );
    for Message: TMsg in State.Messages do
      Pending.Enqueue(Message);
    end for;

    F.RestoreClosed<TMsg>(State);
    if Pending.Count > 0 then
      discard Window.TryWake();
    end if;
  end procedure;

  procedure ClosingFrame();
  begin
    if not Window.NextFrame() then
      return;
    end if;
    const Cached: V.Prepared<TMsg>? := Prepared;
    try
      if Cached <> null and not BrokenView then
        Paint(Cached, false, Window.Size);
      else
        Window.Text('Closing…');
        Window.Present();
      end if;
    catch Error: Sys.Exception do
      BrokenView := true;
      Window.DiscardFrame();
    end try;
  end procedure;

  procedure Stop();
  begin
    if Released then
      return;
    end if;

    BeginClose();
    const Completion: Tasks.Task? := Cleanup;
    if Completion <> null then
      while not Completion.IsCompleted do
        ClosingFrame();
      end while;
    end if;

    Finish();
  end procedure;

  procedure Release();
  begin
    CheckOwner();
    if Driving then
      raise new Sys.InvalidOperationException('Do not dispose a GUI session from its callbacks.');
    end if;

    Stop();
  end procedure;

  function Step(): bool;
  begin
    CheckOwner();
    if Released then
      return false;
    end if;

    if Driving then
      raise new Sys.InvalidOperationException('GUI Step cannot be reentered.');
    end if;

    Driving := true;
    try
      var Consumed: int := 0;
      while Core.IsOpen() and Consumed < Capacity do
        if Pending.Count > 0 then
          case Core.Post(Pending.Peek()) of
            when Runtime.Admission.Queued:
              discard Pending.Dequeue();
            else
          end case;
        end if;

        if Core.QueueCount() = 0 then
          break;
        end if;

        case Core.Advance() of
          when Runtime.Step.Updated:
            Dirty := true;
          else
        end case;

        Consumed := Consumed + 1;
      end while;

      if not Core.IsOpen() then
        BeginClose();
      end if;
      const Completion: Tasks.Task? := Cleanup;
      if Completion <> null and Completion.IsCompleted then
        Finish();
        return false;
      end if;

      if Dirty or Pending.Count > 0 or Core.QueueCount() > 0 then
        discard Window.TryWake();
      end if;

      if not Window.NextFrame() then
        Stop();
        return false;
      end if;

      if Window.TakeCloseRequest() and Cleanup = null then
        case OnCloseRequested of
          when is Sys.Func<TMsg> as Notify:
            if not Services.ClosePending.Value then
              Services.ClosePending.Value := true;
              Pending.Enqueue(Notify.Invoke());
            end if;
          else
            BeginClose();
        end case;
      end if;
      const AfterPump: Tasks.Task? := Cleanup;
      if AfterPump <> null and AfterPump.IsCompleted then
        Window.DiscardFrame();
        Finish();
        return false;
      end if;
      const Size: Cui.CuiSize := Window.Size;
      if Size.Width <> PreviousSize.Width or Size.Height <> PreviousSize.Height then
        Dirty := true;
      end if;

      if Cleanup = null and ReadSystemAppearance then
        const Appearance: Themes.Mode? := ThemeApplication.Appearance(Window);
        if Appearance <> SystemAppearance then
          SystemAppearance := Appearance;
          Dirty := true;
        end if;
      end if;
      var Candidate: V.Prepared<TMsg>? := Prepared;
      if Cleanup = null and (Dirty or Candidate = null) then
        const Model: TModel := Core.Model();
        Bindings := KeyBindings.Prepare<TModel, TMsg>(Model, BindingsFor);
        CurrentTheme := ThemeFor(Model, SystemAppearance);

        ThemeApplication.Apply(Window, CurrentTheme);
        Candidate := V.Prepare<TMsg>(
          View(Model, Sizing.Viewport(Size), CurrentTheme),
          V.Target.Graphical,
          Prepared
        );
        LayoutValidation.Check<TMsg>(Candidate);
      end if;

      if Candidate = null then
        raise new Sys.InvalidOperationException('No prepared GUI view.');
      end if;

      case BeforeDraw of
        when is Sys.Action as Inject:
          Inject.Invoke();
        else
      end case;

      Toast.Submit<TMsg>(Window, PendingToasts, ActiveToasts);
      Paint(Candidate, Cleanup = null and Pending.Count = 0, Size);
      Prepared := Candidate;
      PreviousSize := Size;
      Dirty := false;
      return true;
    catch Error: Sys.Exception do
      try
        if not Released then
          Window.DiscardFrame();
          Stop();
        end if;
      catch CleanupError: Sys.Exception do
        raise new Sys.AggregateException(
          'GUI execution and cleanup failed.',
          [Error, CleanupError]
        );
      end try;

      raise;
    finally
      Driving := false;
    end try;
  end function;
begin
  const Owner: int := Sys.Environment.CurrentManagedThreadId;
  var Released: bool := false;
  var Closed: Cui.CuiWindowPlacement? := null;
  var Driving: bool := false;
  var Dirty: bool := true;
  var BrokenView: bool := false;
  var CurrentTheme: Themes.Theme := Theme;
  var SystemAppearance: Themes.Mode? := null;
  var FrameId: long := 0L;
  var Published: App.Frame? := null;
  var PreviousFocus: string := '';
  var Prepared: V.Prepared<TMsg>? := null;
  var Bindings: KeyBindings.Prepared<TMsg> := new KeyBindings.Prepared<TMsg>([], []);
  var PreviousSize: Cui.CuiSize := new Cui.CuiSize();
  var Cleanup: Tasks.Task? := null;
  const Pending: Generic.Queue<TMsg> := new Generic.Queue<TMsg>();
  const Focus: Generic.Queue<string> := new Generic.Queue<string>();
  const PendingToasts: Generic.Queue<Toasts.Request<TMsg>> := new Generic.Queue<Toasts.Request<TMsg>>();
  const PendingFrames: Generic.Queue<float> := new Generic.Queue<float>();
  const Services: Requests.State<TMsg> := new Requests.State<TMsg>(
    Window,
    Pending,
    PendingToasts,
    PendingFrames
  );
  const ActiveToasts: Generic.Dictionary<int, Toasts.Request<TMsg>> := new Generic.Dictionary<int, Toasts.Request<TMsg>>();
  const Modals: Generic.Dictionary<string, string> := new Generic.Dictionary<string, string>();
  const CompletedAnimations: Generic.Dictionary<string, C.AnimationCompletion> := new Generic.Dictionary<string, C.AnimationCompletion>();
  const Core: Runtime.Runtime<TModel, TMsg, bool> := Runtime.Start<TModel, TMsg, bool>(
    InitialModel, Update,
    procedure(Request: Mvu.HostRequest) begin
      case Request of
        when Mvu.HostRequest.Focus(const Id: string):
          Focus.Clear();
          Focus.Enqueue('app:' + Id);
        when Mvu.HostRequest.Extension(const Value: Sys.Object):
          Requests.Apply<TMsg>(Value, Services);
        else
      end case;
    end procedure, Capacity,
    procedure() begin
      discard Window.TryWake();
    end procedure
  );
  Window.DeferClose := true;
  try
    Window.FollowSystemTheme(ReadSystemAppearance);
    ThemeApplication.Apply(Window, CurrentTheme);
    Window.SetResizeRenderer(ResizeDraw);
    return App.Session<TMsg>.Create(
      Step, Core.Post, Snapshot, Core.IsOpen, Software, Release, Capture, Placement, Inspect
    );
  catch Error: Sys.Exception do
    Stop();
    raise;
  end try;
end function;

// Takes ownership of a native window using the application's model-owned theme.
//
// ## Type parameters
// - `TModel`: Application model.
// - `TMsg`: Typed messages.
// ## Parameters
// - `InitialModel`: Initial state.
// - `Update`: Shared transition and effect commands.
// - `View`: Declarative view with responsive size classes.
// - `Window`: New owned window.
// - `Capacity`: Positive mailbox capacity.
// - `BeforeDraw`: Owner input injection for integration fixtures.
// - `Theme`: Initial shared theme.
// - `ThemeFor`: Optional model-owned theme selector.
// - `OnCloseRequested`: Optional close message factory; Exit approves, Closing.Cancel rejects.
// - `BindingsFor`: Optional immutable application bindings selected from the model.
// ## Returns
// The manually driven session.
public function Start<TModel, TMsg>(
  InitialModel: TModel;
  Update: function(TModel, TMsg): Mvu.Transition<TModel, TMsg>;
  View: function(TModel, L.Viewport): E.Element<TMsg>; Window: Cui.CuiWindow; Capacity: int;
  BeforeDraw: Sys.Action? := null; Theme: Themes.Theme? := null; ThemeFor: Sys.Func<TModel, Themes.Theme>? := null;
  OnCloseRequested: Sys.Func<TMsg>? := null;
  BindingsFor: Sys.Func<TModel, array of Shortcuts.Binding<TMsg>>? := null
): App.Session<TMsg>;
requires Capacity > 0;
begin
  const InitialTheme: Themes.Theme := Theme ?? new Themes.Theme();
  return StartThemed<TModel, TMsg>(
    InitialModel, Update,
    function(Model: TModel; Size: L.Viewport; _Theme: Themes.Theme): E.Element<TMsg> => View(
      Model,
      Size
    ),
    Window, Capacity, BeforeDraw, InitialTheme,
    function(Model: TModel; _Appearance: Themes.Mode?): Themes.Theme begin
      case ThemeFor of
        when is Sys.Func<TModel, Themes.Theme> as SelectTheme:
          return SelectTheme.Invoke(Model);
        else
          return InitialTheme;
      end case;
    end function,
    false, OnCloseRequested, BindingsFor
  );
end function;

end unit;
