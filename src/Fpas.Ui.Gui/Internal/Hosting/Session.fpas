// [Documentation](../../../../docs/ui/gui/host.md#application-lifecycle)

unit Fpas.Ui.Gui.Internal.Hosting.Session;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Hosting.FrameControls as FrameControls;
uses Fpas.Ui.Gui.Internal.Hosting.KeyBindings as KeyBindings;
uses Fpas.Ui.Gui.Internal.Hosting.Requests as Requests;
uses Fpas.Ui.Gui.Internal.Hosting.ThemeApplication as ThemeApplication;
uses Fpas.Ui.Gui.Internal.Input.ModalFocus as F;
uses Fpas.Ui.Gui.Internal.Layout.LayoutValidation as LayoutValidation;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as Sizing;
uses Fpas.Ui.Gui.Internal.Presentation.Presentation as P;
uses Fpas.Ui.Gui.Internal.Widgets.Feedback.Toast as Toast;
uses Fpas.Ui.Gui.Internal.Widgets.Overlays.Tooltip as Tooltip;
uses Fpas.Ui.Gui.Shortcuts as Shortcuts;
uses Fpas.Ui.Gui.Toasts as Toasts;
uses Fpas.Ui.Gui.Windows as Windows;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Mvu.Session as Runtime;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;
uses System.Collections.Generic as Generic;
uses System.Threading.Tasks as Tasks;

// Takes ownership of a native window and drives shared MVU transitions on its creating thread.
//
// ## Type parameters
// - `TModel`: Application model.
// - `TMsg`: Typed messages.
//
// ## Parameters
// - `InitialModel`: Initial state.
// - `Update`: Shared transition and effect commands.
// - `View`: Declarative view with responsive size classes and the resolved theme.
// - `Window`: New owned window.
// - `Capacity`: Positive mailbox capacity.
// - `BeforeDraw`: Owner input injection for integration fixtures.
// - `Theme`: Initial shared theme.
// - `ThemeFor`: Selects a theme from the model and the available system appearance.
// - `ReadSystemAppearance`: Whether native appearance changes invalidate the view.
// - `OnCloseRequested`: Optional close message factory; Exit approves, Closing.Cancel rejects.
// - `BindingsFor`: Optional immutable application bindings selected from the model.
//
// ## Returns
// The manually driven session.
public function StartThemed of (TModel, TMsg)(
  InitialModel: TModel;
  Update: function(TModel, TMsg): Mvu.Transition of (TModel, TMsg);
  View: function(TModel, L.Viewport, Themes.Theme): E.Element of TMsg;
  Window: Cui.CuiWindow;
  Capacity: int;
  BeforeDraw: Sys.Action?;
  Theme: Themes.Theme;
  ThemeFor: function(TModel, Themes.Mode?): Themes.Theme;
  ReadSystemAppearance: bool;
  OnCloseRequested: (Sys.Func of TMsg)? := null;
  BindingsFor: Sys.Func of (TModel, array of Shortcuts.Binding of TMsg)? := null
): App.Session of TMsg;
requires Capacity > 0;
  procedure CheckOwner();
  begin
    if Sys.Environment.CurrentManagedThreadId <> Owner then
      raise new Sys.InvalidOperationException(
        'Drive and dispose the GUI session on its creating thread.'
      );
    end if;
  end procedure;

  procedure BeginClose();
  begin
    if Cleanup = null then
      const Completion: Tasks.Task := Core.Close();
      Cleanup := Completion;
      Pending.Clear();
      Focus.Clear();
      PendingToasts.Clear();
      ActiveToasts.Clear();
      PendingFrames.Clear();
      Window.WakeWhenCompleted(Completion);
      discard Window.TryWake();
    end if;
  end procedure;

  procedure Finish();
  begin
    const Completion: Tasks.Task? := Cleanup;
    if Completion = null then
      return;
    end if;

    try
      Completion.GetAwaiter().GetResult();
    finally
      Released := true;
      Closed := Window.Placement;
      Window.SetResizeRenderer(null);
      Window.Dispose();
    end try;
  end procedure;

  function Snapshot(): App.Frame;
  begin
    CheckOwner();
    if Driving then
      raise new Sys.InvalidOperationException('Do not inspect a GUI session from its callbacks.');
    end if;

    const Last: App.Frame? := Published;
    if Last = null then
      raise new Sys.InvalidOperationException('No GUI frame has been presented.');
    end if;

    return Last with
      Text := cast Last.Text.Clone() as array of string;
      Controls := cast Last.Controls.Clone() as array of App.Control;
    end with;
  end function;

  function Software(): bool;
  begin
    CheckOwner();
    return Window.IsSoftware;
  end function;

  function Inspect(): Windows.Info;
  begin
    CheckOwner();
    return new Windows.Info(Window.Size, Window.State, Window.Backend, Window.NativeWindow);
  end function;

  function Placement(): Cui.CuiWindowPlacement;
  begin
    CheckOwner();
    const Last: Cui.CuiWindowPlacement? := Closed;
    return if Last <> null then
      Last.Value
    else
      Window.Placement
    end if;
  end function;

  procedure Capture(Path: string);
  begin
    CheckOwner();
    if Driving then
      raise new Sys.InvalidOperationException('Capture a GUI frame outside Step callbacks.');
    end if;

    Window.CapturePng(Path);
  end procedure;

  function Context(
    Candidate: V.Prepared of TMsg;
    Accept: bool;
    ObserveTransitions: bool;
    PreserveCanvasFocus: bool := false
  ): C.State of TMsg;
  begin
    const Last: App.Frame? := Published;
    const Previous: array of App.Control := if Last = null then
      []
    else
      Last.Controls
    end if;
    const Modal: string? := F.TopModal of TMsg(Candidate.Tree, Candidate, Previous);
    return new C.State of TMsg(
      Window,
      Candidate,
      new Generic.List of TMsg(),
      new Generic.List of string(),
      new Generic.List of App.Control(),
      Focus,
      Modals,
      new Generic.HashSet of string(),
      Previous,
      Accept and Modal = null,
      Accept,
      Modal,
      ObserveTransitions := ObserveTransitions,
      CompletedAnimations := CompletedAnimations,
      PreviousFocus := PreviousFocus,
      PreserveCanvasFocus := PreserveCanvasFocus
    );
  end function;

  procedure ResizeDraw();
  begin
    const Cached: (V.Prepared of TMsg)? := Prepared;
    if Cached = null then
      return;
    end if;

    P.Draw of TMsg(Context(Cached, false, false));
  end procedure;

  function HasDockPanel(Controls: array of App.Control): bool;
  begin
    for Control: App.Control in Controls do
      if Control.Role = 'dock-panel' then
        return true;
      end if;
    end for;

    return false;
  end function;

  procedure Paint(Candidate: V.Prepared of TMsg; Accept: bool; Size: Cui.CuiSize);
  begin
    const State: C.State of TMsg := Context(
      Candidate,
      Accept,
      Cleanup = null,
      Cleanup = null and not Accept
    );
    P.Draw of TMsg(State);
    KeyBindings.Collect of TMsg(Window, Bindings, Accept, State.Messages);
    if Accept then
      Focus.Clear();
    end if;

    while PendingFrames.Count > 0 do
      Window.RequestFrame(PendingFrames.Dequeue());
    end while;

    Window.Present();
    C.CommitAnimations of TMsg(State);
    FrameControls.Resolve(Window, State.Controls);
    if Accept then
      PreviousFocus := '';
      for Control: App.Control in State.Controls do
        if Control.Focused then
          PreviousFocus := C.Token(Control.Role, Control.Id, Control.Key);
        end if;
      end for;
    end if;

    Tooltip.Collect of TMsg(State);
    if ActiveToasts.Count > 0 then
      Toast.Collect of TMsg(State, ActiveToasts);
    end if;

    FrameId := FrameId + 1L;
    const Controls: array of App.Control := State.Controls.ToArray();
    Published := new App.Frame(
      FrameId, Size, State.Labels.ToArray(), Controls, CurrentTheme
    );
    if Cleanup = null and (HasDockPanel(Controls) or HasDockPanel(State.Previous))
      and F.TopModal of TMsg(Candidate.Tree, Candidate, Controls) <> State.ActiveModal
    then
      discard Window.TryWake();
    end if;

    for Message: TMsg in State.Messages do
      Pending.Enqueue(Message);
    end for;

    F.RestoreClosed of TMsg(State);
    if Pending.Count > 0 then
      discard Window.TryWake();
    end if;
  end procedure;

  procedure ClosingFrame();
  begin
    try
      if not Window.NextFrame() then
        return;
      end if;
      const Cached: (V.Prepared of TMsg)? := Prepared;
      if Cached <> null and not BrokenView then
        Paint(Cached, false, Window.ViewportSize);
      else
        Window.Text('Closing…');
        Window.Present();
      end if;
    catch Error: Sys.Exception do
      BrokenView := true;
      Window.DiscardFrame();
    end try;
  end procedure;

  procedure Stop();
  begin
    if Released then
      return;
    end if;

    BeginClose();
    const Completion: Tasks.Task? := Cleanup;
    if Completion <> null then
      while not Completion.IsCompleted do
        ClosingFrame();
      end while;
    end if;

    Finish();
  end procedure;

  procedure Release();
  begin
    CheckOwner();
    if Driving then
      raise new Sys.InvalidOperationException('Do not dispose a GUI session from its callbacks.');
    end if;

    Driving := true;
    try
      Stop();
    finally
      Driving := false;
    end try;
  end procedure;

  function Step(): bool;
  begin
    CheckOwner();
    if Released then
      return false;
    end if;

    if Driving then
      raise new Sys.InvalidOperationException('GUI Step cannot be reentered.');
    end if;

    Driving := true;
    try
      var Consumed: int := 0;
      while Core.IsOpen() and Consumed < Capacity do
        if Pending.Count > 0 then
          case Core.Post(Pending.Peek()) of
            when Runtime.Admission.Queued:
              discard Pending.Dequeue();
            else
          end case;
        end if;

        if Core.QueueCount() = 0 then
          break;
        end if;

        case Core.Advance() of
          when Runtime.Step.Updated:
            Dirty := true;
          else
        end case;

        Consumed := Consumed + 1;
      end while;

      if not Core.IsOpen() then
        BeginClose();
      end if;
      const Completion: Tasks.Task? := Cleanup;
      if Completion <> null and Completion.IsCompleted then
        Finish();
        return false;
      end if;

      if Dirty or Pending.Count > 0 or Core.QueueCount() > 0 then
        discard Window.TryWake();
      end if;

      if not Window.NextFrame() then
        Stop();
        return false;
      end if;

      if Window.TakeCloseRequest() and Cleanup = null then
        case OnCloseRequested of
          when is Sys.Func of TMsg as Notify:
            if not Services.ClosePending.Value then
              Services.ClosePending.Value := true;
              Pending.Enqueue(Notify.Invoke());
            end if;
          else
            BeginClose();
        end case;
      end if;
      const AfterPump: Tasks.Task? := Cleanup;
      if AfterPump <> null and AfterPump.IsCompleted then
        Window.DiscardFrame();
        Finish();
        return false;
      end if;
      const Size: Cui.CuiSize := Window.ViewportSize;
      if Size.Width <> PreviousSize.Width or Size.Height <> PreviousSize.Height then
        Dirty := true;
      end if;

      if Cleanup = null and ReadSystemAppearance then
        const Appearance: Themes.Mode? := ThemeApplication.Appearance(Window);
        if Appearance <> SystemAppearance then
          SystemAppearance := Appearance;
          Dirty := true;
        end if;
      end if;
      var Candidate: (V.Prepared of TMsg)? := Prepared;
      if Cleanup = null and (Dirty or Candidate = null) then
        const Model: TModel := Core.Model();
        Bindings := KeyBindings.Prepare of (TModel, TMsg)(Model, BindingsFor);
        CurrentTheme := ThemeFor(Model, SystemAppearance);

        ThemeApplication.Apply(Window, CurrentTheme);
        Candidate := V.Prepare of TMsg(
          View(Model, Sizing.Viewport(Size), CurrentTheme),
          V.Target.Graphical,
          Prepared
        );
        LayoutValidation.Check of TMsg(Candidate);
      end if;

      if Candidate = null then
        raise new Sys.InvalidOperationException('No prepared GUI view.');
      end if;

      case BeforeDraw of
        when is Sys.Action as Inject:
          Inject.Invoke();
        else
      end case;

      Toast.Submit of TMsg(Window, PendingToasts, ActiveToasts);
      Paint(Candidate, Cleanup = null and Pending.Count = 0, Size);
      Prepared := Candidate;
      PreviousSize := Size;
      Dirty := false;
      return true;
    catch Error: Sys.Exception do
      try
        if not Released then
          Window.DiscardFrame();
          Stop();
        end if;
      catch CleanupError: Sys.Exception do
        raise new Sys.AggregateException(
          'GUI execution and cleanup failed.',
          [Error, CleanupError]
        );
      end try;

      raise;
    finally
      Driving := false;
    end try;
  end function;
begin
  const Owner: int := Sys.Environment.CurrentManagedThreadId;
  var Released: bool := false;
  var Closed: Cui.CuiWindowPlacement? := null;
  var Driving: bool := false;
  var Dirty: bool := true;
  var BrokenView: bool := false;
  var CurrentTheme: Themes.Theme := Theme;
  var SystemAppearance: Themes.Mode? := null;
  var FrameId: long := 0L;
  var Published: App.Frame? := null;
  var PreviousFocus: string := '';
  var Prepared: (V.Prepared of TMsg)? := null;
  var Bindings: KeyBindings.Prepared of TMsg := new KeyBindings.Prepared of TMsg([], []);
  var PreviousSize: Cui.CuiSize := new Cui.CuiSize();
  var Cleanup: Tasks.Task? := null;
  const Pending: Generic.Queue of TMsg := new Generic.Queue of TMsg();
  const Focus: Generic.Queue of string := new Generic.Queue of string();
  const PendingToasts: Generic.Queue of Toasts.Request of TMsg := new Generic.Queue of Toasts.Request of TMsg();
  const PendingFrames: Generic.Queue of float := new Generic.Queue of float();
  const Services: Requests.State of TMsg := new Requests.State of TMsg(
    Window,
    Pending,
    PendingToasts,
    PendingFrames
  );
  const ActiveToasts: Generic.Dictionary of (int, Toasts.Request of TMsg) := new Generic.Dictionary of (int, Toasts.Request of TMsg)();
  const Modals: Generic.Dictionary of (string, string) := new Generic.Dictionary of (string, string)();
  const CompletedAnimations: Generic.Dictionary of (string, C.AnimationCompletion) := new Generic.Dictionary of (string, C.AnimationCompletion)();
  const Core: Runtime.Runtime of (TModel, TMsg, bool) := Runtime.Start of (TModel, TMsg, bool)(
    InitialModel, Update,
    procedure(Request: Mvu.HostRequest) begin
      case Request of
        when Mvu.HostRequest.Focus(const Id: string):
          Focus.Clear();
          Focus.Enqueue('app:' + Id);
        when Mvu.HostRequest.Extension(const Value: Sys.Object):
          Requests.Apply of TMsg(Value, Services);
        else
      end case;
    end procedure, Capacity,
    procedure() begin
      discard Window.TryWake();
    end procedure
  );
  Window.DeferClose := true;
  try
    Window.FollowSystemTheme(ReadSystemAppearance);
    ThemeApplication.Apply(Window, CurrentTheme);
    Window.SetResizeRenderer(ResizeDraw);
    return (App.Session of TMsg).Create(
      Step, Core.Post, Snapshot, Core.IsOpen, Software, Release, Capture, Placement, Inspect
    );
  catch Error: Sys.Exception do
    Stop();
    raise;
  end try;
end function;

// Takes ownership of a native window using the application's model-owned theme.
//
// ## Type parameters
// - `TModel`: Application model.
// - `TMsg`: Typed messages.
// ## Parameters
// - `InitialModel`: Initial state.
// - `Update`: Shared transition and effect commands.
// - `View`: Declarative view with responsive size classes.
// - `Window`: New owned window.
// - `Capacity`: Positive mailbox capacity.
// - `BeforeDraw`: Owner input injection for integration fixtures.
// - `Theme`: Initial shared theme.
// - `ThemeFor`: Optional model-owned theme selector.
// - `OnCloseRequested`: Optional close message factory; Exit approves, Closing.Cancel rejects.
// - `BindingsFor`: Optional immutable application bindings selected from the model.
// ## Returns
// The manually driven session.
public function Start of (TModel, TMsg)(
  InitialModel: TModel;
  Update: function(TModel, TMsg): Mvu.Transition of (TModel, TMsg);
  View: function(TModel, L.Viewport): E.Element of TMsg;
  Window: Cui.CuiWindow;
  Capacity: int;
  BeforeDraw: Sys.Action? := null;
  Theme: Themes.Theme? := null;
  ThemeFor: Sys.Func of (TModel, Themes.Theme)? := null;
  OnCloseRequested: (Sys.Func of TMsg)? := null;
  BindingsFor: Sys.Func of (TModel, array of Shortcuts.Binding of TMsg)? := null
): App.Session of TMsg;
requires Capacity > 0;
begin
  const InitialTheme: Themes.Theme := Theme ?? new Themes.Theme();
  return StartThemed of (TModel, TMsg)(
    InitialModel, Update,
    function(Model: TModel; Size: L.Viewport; _Theme: Themes.Theme): E.Element of TMsg => View(
      Model,
      Size
    ),
    Window, Capacity, BeforeDraw, InitialTheme,
    function(Model: TModel; _Appearance: Themes.Mode?): Themes.Theme begin
      case ThemeFor of
        when is Sys.Func of (TModel, Themes.Theme) as SelectTheme:
          return SelectTheme.Invoke(Model);
        else
          return InitialTheme;
      end case;
    end function,
    false, OnCloseRequested, BindingsFor
  );
end function;

end unit;
