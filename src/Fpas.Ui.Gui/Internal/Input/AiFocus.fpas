unit Fpas.Ui.Gui.Internal.Input.AiFocus;

uses
  Fpas.Ui.Elements as E, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Widgets.Audio.VoiceWaves as Wave,
  Fpas.Ui.Widgets.Audio.VoiceNotes as Note, Fpas.Ui.Widgets.Audio.VoiceSessions as Call, Fpas.Ui.Widgets.Audio.VoiceOrbs as Orb,
  Fpas.Ui.Widgets.Ai.Composers as Composer, Fpas.Ui.Widgets.Ai.Reasonings as Reason, Fpas.Ui.Widgets.Ai.ToolCalls as Tool,
  Fpas.Ui.Widgets.Ai.SourceLists as List, Fpas.Ui.Widgets.Ai.Sources as Sources, Fpas.Ui.Widgets.Ai.Citations as Cite,
  Fpas.Ui.Widgets.Ai.ModelPickers as Model, Fpas.Ui.Widgets.Ai.PromptSuggestions as Suggestions, System as Sys;

function Part(Id: string; Preferred: string?; Key: string): string?;
begin
  const Target: string := Id + '/' + Key;
  return if Preferred = null or Preferred = Id or Preferred = Target then
    Target
  else
    null
  end if;
end function;

function Parts(Id: string; Preferred: string?; Keys: array of string): string?;
begin
  for Key: string in Keys do
    const Target: string? := Part(Id, Preferred, Key);
    if Target <> null then
      return Target;
    end if;
  end for;

  return null;
end function;

// Resolves a focus request for a native Voice or AI control.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Prepared native widget.
// - `Preferred`: Requested widget or part ID.
// ## Returns
// A focusable application ID if the widget can handle the request.
public function First<TMsg>(Node: E.Element<TMsg>; Preferred: string?): string?;
begin
  case Node of
    when E.Element.VoiceWave(
      const Id: string,
      _,
      const Progress: float?,
      _,
      const Settings: Wave.Options
    ):
      if Settings.Enabled and Progress <> null and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.VoiceNote(const Id: string, _, _, _, const Settings: Note.Options):
      if Settings.Enabled then
        return Parts(Id, Preferred, ['play', 'seek', 'speed']);
      end if;
    when E.Element.VoiceSession(
      const Id: string,
      _,
      _,
      const Muted: bool?,
      _,
      const Settings: Call.Options
    ):
      if Settings.Enabled then
        if Muted <> null then
          const Mute: string? := Part(Id, Preferred, 'mute');
          if Mute <> null then
            return Mute;
          end if;
        end if;

        if not Settings.HideEnd then
          return Part(Id, Preferred, 'end');
        end if;
      end if;
    when E.Element.Composer(
      const Id: string,
      const Content: Composer.Value,
      _,
      const Settings: Composer.Options
    ):
      if Settings.Enabled then
        if Content.Take <> null then
          return Parts(Id, Preferred, ['send', 'cancel']);
        end if;

        return Parts(
          Id, Preferred, if Settings.Microphone then
            ['editor', 'send', 'record']
          else
            ['editor', 'send']
          end if
        );
      end if;
    when E.Element.VoiceOrb(
      const Id: string,
      _,
      _,
      const Activate: Sys.Func<TMsg>?,
      const Settings: Orb.Options
    ):
      if Settings.Enabled and Activate <> null and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.Reasoning(const Id: string, _, const Settings: Reason.Options):
      if Settings.Enabled then
        return Part(Id, Preferred, 'toggle');
      end if;
    when E.Element.ToolCall(const Id: string, _, const Settings: Tool.Options):
      if Settings.Enabled and (Settings.Input <> '' or Settings.Output <> '') then
        return Part(Id, Preferred, 'toggle');
      end if;
    when E.Element.SourceList(
      const Id: string,
      const Documents: array of Sources.Item,
      _,
      const Settings: List.Options
    ):
      if Settings.Enabled then
        return Parts(Id, Preferred, P.Indexed(Documents.Length));
      end if;
    when E.Element.Citation(const Id: string, _, _, _, const Settings: Cite.Options):
      if Settings.Enabled and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    when E.Element.ContextMeter(const Id: string, _, _, _, _):
      if Preferred = null or Preferred = Id then
        return Id;
      end if;
    when E.Element.PromptSuggestions(
      const Id: string,
      const Items: array of Suggestions.Item,
      _,
      const Settings: Suggestions.Options
    ):
      if Settings.Enabled then
        return Parts(Id, Preferred, P.Indexed(Items.Length));
      end if;
    when E.Element.ModelPicker(
      const Id: string,
      const Items: array of Model.Item,
      _,
      _,
      const Settings: Model.Options
    ):
      if Settings.Enabled and Items.Length > 0 and (Preferred = null or Preferred = Id) then
        return Id;
      end if;
    else
  end case;

  return null;
end function;

end unit;
