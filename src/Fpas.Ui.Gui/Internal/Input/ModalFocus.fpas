// [Documentation](../../../../docs/ui/gui/host.md#widgets-and-input)

unit Fpas.Ui.Gui.Internal.Input.ModalFocus;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Input.Focus as F;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Actions.SwipeActions as Swipe;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Containers.CardStacks as CardStacks;
uses Fpas.Ui.Widgets.Containers.ExpandableCards as Cards;
uses Fpas.Ui.Widgets.Desktop.Dockspaces as Dock;
uses Fpas.Ui.Widgets.Editors.NodeEditors as Nodes;
uses Fpas.Ui.Widgets.Media.Carousels as Carousels;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;
uses Fpas.Ui.Widgets.Overlays.Veils as Veils;
uses Fpas.Ui.Widgets.Planning.Kanbans as Kanbans;

uses System as Sys;
uses System.Collections.Generic as Generic;

// Finds the last/deepest active modal scope in traversal order.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `Node`: Prepared subtree.
// - `Prepared`: Resolved subviews.
// - `Previous`: Previously visible dock tabs, when available.
//
// ## Returns
// The top modal identity or null.
public function TopModal of TMsg(
  Node: E.Element of TMsg;
  Prepared: V.Prepared of TMsg;
  Previous: (array of App.Control)? := null
): string?;
begin
  case Node of
    when E.Element.NodeEditor(
      _,
      _,
      const Items: array of Nodes.Node of TMsg,
      _,
      _,
      const Settings: Nodes.Options
    ):
      if Settings.Enabled then
        var Found: string? := null;
        for Item: Nodes.Node of TMsg in Items do
          case Item.Body of
            when is E.Element of TMsg as Body:
              Found := TopModal of TMsg(Body, Prepared, Previous) ?? Found;
            else
          end case;
        end for;

        return Found;
      end if;
    when E.Element.Veil(
      _,
      const Revealed: bool,
      _,
      const Child: E.Element of TMsg,
      const Settings: Veils.Options
    ):
      if Revealed and Settings.Enabled then
        return TopModal of TMsg(Child, Prepared, Previous);
      end if;
    when E.Element.Kanban(
      _,
      const Columns: array of Kanbans.Column of TMsg,
      _,
      const Settings: Kanbans.Options
    ):
      if Settings.Enabled then
        var Found: string? := null;
        for Column: Kanbans.Column of TMsg in Columns do
          for Card: Kanbans.Card of TMsg in Column.Cards do
            Found := TopModal of TMsg(Card.Content, Prepared, Previous) ?? Found;
          end for;
        end for;

        return Found;
      end if;
    when E.Element.FilePicker(
      const Id: string,
      const Base: (E.Element of TMsg)?,
      const Open: bool,
      _,
      _
    ):
      if Open then
        return Id;
      end if;

      if Base <> null then
        return TopModal of TMsg(Base, Prepared, Previous);
      end if;
    when E.Element.CommandPalette(
      const Id: string,
      const Base: E.Element of TMsg,
      const Open: bool,
      _,
      _,
      _
    ):
      return if Open then
        Id
      else
        TopModal of TMsg(Base, Prepared, Previous)
      end if;
    when E.Element.Tour(_, const Base: E.Element of TMsg, _, _, _, _):
      return TopModal of TMsg(Base, Prepared, Previous);
    when E.Element.Sheet(
      const Id: string, const Base: E.Element of TMsg, const Content: E.Element of TMsg,
      const Open: bool, _, _
    ), E.Element.Dialog(
      const Id: string, const Base: E.Element of TMsg, const Content: E.Element of TMsg,
      const Open: bool, _, _
    ):
      if not Open then
        return TopModal of TMsg(Base, Prepared, Previous);
      end if;
      const Inner: string? := TopModal of TMsg(Content, Prepared, Previous);
      return if Inner = null then
        Id
      else
        Inner
      end if;
    when E.Element.Carousel(
      _,
      const Slides: array of E.Element of TMsg,
      const Index: int,
      _,
      const Settings: Carousels.Options
    ):
      if Settings.Enabled then
        return TopModal of TMsg(Slides[Index], Prepared, Previous);
      end if;
    when E.Element.CardStack(
      _,
      const DeckItems: array of E.Element of TMsg,
      _,
      const Settings: CardStacks.Options
    ):
      if Settings.Enabled and DeckItems.Length > 0 then
        return TopModal of TMsg(DeckItems[0], Prepared, Previous);
      end if;
    when E.Element.Dockspace(const Id: string, const Panels: array of Dock.Panel of TMsg, _, _):
      if Previous = null then
        return null;
      end if;
      var Found: string? := null;
      for Panel: Dock.Panel of TMsg in Panels do
        if not Panel.Open and Panel.OnOpenChanged <> null then
          continue;
        end if;
        const PanelId: string := Menus.ItemId(Id, Panel.Key);
        for Control: App.Control in Previous do
          if Control.Role = 'dock-panel' and Control.Id = PanelId and Control.Value = 'True' then
            Found := TopModal of TMsg(Panel.Content, Prepared, Previous) ?? Found;
            break;
          end if;
        end for;
      end for;

      return Found;
    when E.Element.SplitView(
      _,
      _,
      const First: E.Element of TMsg,
      const Second: E.Element of TMsg,
      _,
      _
    ):
      return TopModal of TMsg(
        Second,
        Prepared,
        Previous
      ) ?? TopModal of TMsg(First, Prepared, Previous);
    when E.Element.Layered(
      const Children: array of E.Element of TMsg,
      _
    ), E.Element.Grid(_, const Children: array of E.Element of TMsg), E.Element.Spotlight(
      _,
      const Children: array of E.Element of TMsg,
      _
    ), E.Element.Card(
      _,
      const Children: array of E.Element of TMsg,
      _,
      _
    ), E.Element.Stack(
      const Children: array of E.Element of TMsg,
      _,
      _
    ), E.Element.Scroll(
      _,
      const Children: array of E.Element of TMsg,
      _,
      _,
      _
    ), E.Element.ActionFooter(const Children: array of E.Element of TMsg), E.Element.SkeletonGroup(
      _,
      const Children: array of E.Element of TMsg,
      _
    ):
      var Found: string? := null;
      for Child: E.Element of TMsg in Children do
        const Next: string? := TopModal of TMsg(Child, Prepared, Previous);
        if Next <> null then
          Found := Next;
        end if;
      end for;

      return Found;
    when E.Element.Table(_, _, const Rows: array of Tables.Row of TMsg, _, _, _, _):
      var Found: string? := null;
      for Row: Tables.Row of TMsg in Rows do
        for Cell: Tables.Cell of TMsg in Row.Cells do
          case Cell of
            when Tables.Cell.Content(const Children: array of E.Element of TMsg):
              for Child: E.Element of TMsg in Children do
                Found := TopModal of TMsg(Child, Prepared, Previous) ?? Found;
              end for;
            else
          end case;
        end for;
      end for;

      return Found;
    when E.Element.ReorderableList(
      _, const Items: array of E.Element of TMsg, const Order: array of int, _, _
    ):
      var Found: string? := null;
      for Index: int in Order do
        Found := TopModal of TMsg(Items[Index], Prepared, Previous) ?? Found;
      end for;

      return Found;
    when E.Element.TreeNode(
      _, _, const Open: bool?, const Children: array of E.Element of TMsg, _, _, _
    ):
      if Open ?? false then
        var Found: string? := null;
        for Child: E.Element of TMsg in Children do
          Found := TopModal of TMsg(Child, Prepared, Previous) ?? Found;
        end for;

        return Found;
      end if;
    when E.Element.LiveCursors(
      _, _, const Child: E.Element of TMsg, _
    ), E.Element.SelectionRing(_, const Child: E.Element of TMsg, _), E.Element.CanvasControls(
      _, _, _, _, const Child: E.Element of TMsg, _
    ), E.Element.SelectionBar(_, _, _, _, const Child: E.Element of TMsg, _):
      return TopModal of TMsg(Child, Prepared, Previous);
    when E.Element.Contextual(
      _,
      const Child: E.Element of TMsg,
      _,
      _
    ), E.Element.Sized(const Child: E.Element of TMsg, _), E.Element.Hinted(
      const Child: E.Element of TMsg,
      _,
      _
    ):
      return TopModal of TMsg(Child, Prepared, Previous);
    when E.Element.Accordion(
      _,
      _,
      const Open: bool,
      _,
      const Content: E.Element of TMsg,
      const Enabled: bool
    ):
      if Open and Enabled then
        return TopModal of TMsg(Content, Prepared, Previous);
      end if;
    when E.Element.ExpandableCard(
      _,
      _,
      const Open: bool,
      _,
      const Content: E.Element of TMsg,
      const Settings: Cards.Options
    ):
      if Open and Settings.Enabled then
        return TopModal of TMsg(Content, Prepared, Previous);
      end if;
    when E.Element.Popover(_, _, const Content: E.Element of TMsg, const Open: bool, _, _):
      if Open then
        return TopModal of TMsg(Content, Prepared, Previous);
      end if;
    when E.Element.Styled(const Child: E.Element of TMsg, _):
      return TopModal of TMsg(Child, Prepared, Previous);
    when E.Element.SwipeRow(
      _,
      const Child: E.Element of TMsg,
      _,
      _,
      _,
      const Settings: Swipe.Options
    ):
      if Settings.Enabled then
        return TopModal of TMsg(Child, Prepared, Previous);
      end if;
    when E.Element.Framed(const Child: E.Element of TMsg, _):
      return TopModal of TMsg(Child, Prepared, Previous);
    when E.Element.Deferred(const Id: string, _):
      return TopModal of TMsg(Prepared.Subviews[Id].Tree, Prepared, Previous);
    else
  end case;

  return null;
end function;

// Records the focus return target and resolves the first request for a new modal.
//
// ## Type parameters
// - `TMsg`: Message type.
// ## Parameters
// - `State`: Current frame.
// - `Id`: Modal identity.
// - `Content`: Prepared modal subtree.
// - `Initial`: Preferred focus request when opening.
// - `Close`: Optional built-in close button and default focus.
public procedure Enter of TMsg(
  State: C.State of TMsg;
  Id: string;
  Content: E.Element of TMsg;
  Initial: string?;
  Close: string? := null
);
  function Resolve(Preferred: string?): string?;
  begin
    if Preferred = null or Preferred = Close then
      return Preferred;
    end if;

    return F.First of TMsg(Content, State.Prepared, Preferred);
  end function;
begin
  discard State.SeenModals.Add(Id);
  if not State.Interactive or State.Modals.ContainsKey(Id) then
    return;
  end if;

  State.Modals.Add(Id, State.PreviousFocus);

  var Requested: string? := null;
  if State.Focus.Count > 0 and State.Focus.Peek().StartsWith(
    'app:',
    Sys.StringComparison.Ordinal
  )
  then
    Requested := Resolve(State.Focus.Peek().Substring(4));
  end if;

  State.Focus.Clear();
  const Target: string? := Requested ?? Resolve(Initial) ?? Close ?? F.First of TMsg(
    Content,
    State.Prepared
  );
  if Target <> null then
    State.Focus.Enqueue('app:' + Target);
  end if;
end procedure;

// Queues focus restoration for modals absent from a successful input-enabled frame.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Presented frame and its modal focus state.
public procedure RestoreClosed of TMsg(State: C.State of TMsg);
begin
  if not State.Interactive then
    return;
  end if;

  for Id: string in new Generic.List of string(State.Modals.Keys) do
    if State.SeenModals.Contains(Id) then
      continue;
    end if;

    const Restore: string := State.Modals[Id];
    discard State.Modals.Remove(Id);
    var Target: string? := null;
    for Control: App.Control in State.Controls do
      if Control.Enabled and Control.Role <> 'scroll' then
        const Token: string := C.Token(Control.Role, Control.Id, Control.Key);
        if Target = null or Token = Restore then
          Target := Token;
        end if;
      end if;
    end for;

    if Target <> null then
      State.Focus.Enqueue('native:' + Target);
      discard State.Window.TryWake();
    end if;
  end for;
end procedure;

end unit;
