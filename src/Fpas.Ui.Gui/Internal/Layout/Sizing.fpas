// [Documentation](../../../../docs/ui/gui/layout/container-options.md)

unit Fpas.Ui.Gui.Internal.Layout.Sizing;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Values as P;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;

// Resolves a graphical measure and rejects terminal distances.
//
// ## Parameters
// - `Value`: Explicit target distance.
//
// ## Returns
// Logical units.
public function Measure(Value: L.Measure): float;
begin
  case Value of
    when L.Measure.Logical(const Units: int):
      return cast Units as float;
    when L.Measure.Points(const Points: float):
      return Points;
    else
      raise new Sys.NotSupportedException('GUI layout requires logical units.');
  end case;
end function;

// Resolves [semantic spacing](../../../../docs/ui/gui/layout/spacing.md).
//
// ## Parameters
// - `Value`: Semantic or explicit spacing.
//
// ## Returns
// Logical distance.
public function Spacing(Value: L.Spacing): float;
begin
  case Value of
    when L.Spacing.None:
      return 0;
    when L.Spacing.Tight:
      return 4;
    when L.Spacing.Normal:
      return 8;
    when L.Spacing.Loose:
      return 16;
    when L.Spacing.Fixed(const Distance: L.Measure):
      return Measure(Distance);
  end case;
end function;

// Native extent encoding shared by widget widths and general layout constraints.
public type NativeExtent = record
  // Content zero, fill one, logical pixels two, or percentage three.
  public Kind: int;
  // Logical pixels or percentage; zero for content and fill.
  public Value: float;
end record;

// Translates an extent for CUI without resolving parent-dependent allocation.
// ## Parameters
// - `Value`: Graphically validated extent.
// ## Returns
// The native bridge kind and its numeric value.
public function Extent(Value: L.Extent): NativeExtent;
begin
  case Value of
    when L.Extent.Content:
      return new NativeExtent(Kind := 0, Value := 0.0F);
    when L.Extent.Fill:
      return new NativeExtent(Kind := 1, Value := 0.0F);
    when L.Extent.Fixed(const Distance: L.Measure):
      return new NativeExtent(Kind := 2, Value := Measure(Distance));
    when L.Extent.Percent(const Percent: float):
      return new NativeExtent(Kind := 3, Value := Percent);
  end case;
end function;

function ThemeToken(Value: Themes.ColorToken?): int;
begin
  return if Value = null then
    0
  else
    cast Value.Value as int
  end if;
end function;

// Applies native insets, reading direction and paint options to a new container.
// ## Parameters
// - `Window`: Current drawing window, immediately after opening the container.
// - `Settings`: Validated container options.
// - `Layered`: Whether uniform padding still needs applying to a native stack.
public procedure Container(Window: Cui.CuiWindow; Settings: L.Flow; Layered: bool := false);
begin
  const Background: G.Color? := Settings.Background;
  const Border: L.Border? := Settings.Border;
  const Corners: L.CornerRadii? := Settings.Corners;
  const Radius: float := Settings.CornerRadius;
  if Background <> null or Settings.BackgroundTheme <> null or Radius > 0.0F
    or Corners <> null or Border <> null or Settings.Elevation <> L.Elevation.None
    or Settings.Opacity <> 1.0F
  then
    const Stroke: G.Color? := if Border = null then
      null
    else
      Border.Color
    end if;
    const StrokeToken: Themes.ColorToken? := if Border = null then
      null
    else
      Border.ThemeColor
    end if;
    Window.StyleGroup(
      if Background = null then
        0U
      else
        P.Pack(Background)
      end if,
      ThemeToken(Settings.BackgroundTheme),
      if Corners = null then
        Radius
      else
        Corners.TopLeft ?? Radius
      end if,
      if Corners = null then
        Radius
      else
        Corners.TopRight ?? Radius
      end if,
      if Corners = null then
        Radius
      else
        Corners.BottomRight ?? Radius
      end if,
      if Corners = null then
        Radius
      else
        Corners.BottomLeft ?? Radius
      end if,
      if Border = null then
        0.0F
      else
        Border.Width
      end if,
      if Stroke = null then
        null
      else
        P.Pack(Stroke)
      end if,
      ThemeToken(StrokeToken), cast Settings.Elevation as int, Settings.Opacity
    );
  end if;

  if not Layered and Settings.PaddingTop = null and Settings.PaddingEnd = null
    and Settings.PaddingBottom = null and Settings.PaddingStart = null
    and Settings.PaddingX = null and Settings.PaddingY = null
    and Settings.ReadingDirection = L.Direction.Inherit
  then
    return;
  end if;

  const X: L.Spacing := Settings.PaddingX ?? Settings.Padding;
  const Y: L.Spacing := Settings.PaddingY ?? Settings.Padding;
  Window.LayoutLast(
    Spacing(Settings.PaddingTop ?? Y), Spacing(Settings.PaddingEnd ?? X),
    Spacing(Settings.PaddingBottom ?? Y), Spacing(Settings.PaddingStart ?? X),
    cast Settings.ReadingDirection as int
  );
end procedure;

// Applies CUI sizing directly after drawing one child.
//
// ## Parameters
// - `Window`: Owner drawing context.
// - `Value`: Main-axis constraints.
// - `Horizontal`: Parent axis.
// - `Align`: Parent cross-axis alignment.
public procedure Apply(Window: Cui.CuiWindow; Value: L.Flex; Horizontal: bool; Align: L.Alignment);
  procedure Axis(Settings: L.AxisSize?; Width: bool);
  begin
    if Settings = null then
      return;
    end if;
    const Basis: NativeExtent := Extent(Settings.Basis);
    const Minimum: L.Measure? := Settings.Minimum;
    const Maximum: L.Measure? := Settings.Maximum;
    Window.SizeLast(
      Width, Basis.Kind, Basis.Value,
      if Minimum = null then
        0.0F
      else
        Measure(Minimum)
      end if,
      if Maximum = null then
        -1.0F
      else
        Measure(Maximum)
      end if,
      Settings.Grow, 0
    );
  end procedure;
begin
  if Value.Width <> null or Value.Height <> null then
    Axis(Value.Width, true);
    Axis(Value.Height, false);
    return;
  end if;

  const Basis: NativeExtent := Extent(Value.Basis);
  var Minimum: float := 0;
  var Maximum: float := -1;
  case Value.Minimum of
    when is L.Measure as Distance:
      Minimum := Measure(Distance);
    else
  end case;

  case Value.Maximum of
    when is L.Measure as Distance:
      Maximum := Measure(Distance);
    else
  end case;

  Window.SizeLast(
    Horizontal,
    Basis.Kind,
    Basis.Value,
    Minimum,
    Maximum,
    Value.Grow,
    cast Align as int
  );
end procedure;

// Builds the responsive viewport from CUI's drawable dimensions.
//
// ## Parameters
// - `Size`: The native viewport size in logical points.
// ## Returns
// The responsive width and height classes and logical dimensions.
public function Viewport(Size: Cui.CuiSize): L.Viewport;
begin
  return new L.Viewport(
    if Size.Width < 600 then
      L.SizeClass.Compact
    elsif Size.Width < 1200 then
      L.SizeClass.Regular
    else
      L.SizeClass.Expanded
    end if,
    if Size.Height < 400 then
      L.SizeClass.Compact
    elsif Size.Height < 900 then
      L.SizeClass.Regular
    else
      L.SizeClass.Expanded
    end if,
    Size.Width, Size.Height
  );
end function;

end unit;
