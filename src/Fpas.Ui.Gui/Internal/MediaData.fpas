unit Fpas.Ui.Gui.Internal.MediaData;

uses Fpas.Ui.MediaImages as Media, Fpas.Ui.Gui.Cui as Cui;

// Converts a shared picture source to the native upload descriptor.
// ## Parameters
// - `Source`: Validated file path or RGBA data.
// ## Returns
// A descriptor retaining the original source.
public function Convert(Source: Media.Source): Cui.CuiMediaImage;
begin
  case Source of
    when Media.Source.File(const Path: string):
      return new Cui.CuiMediaImage(Path);
    when Media.Source.Rgba(const Width: int, const Height: int, const Pixels: array of byte):
      return new Cui.CuiMediaImage(null, Width, Height, Pixels);
  end case;
end function;

end unit;
