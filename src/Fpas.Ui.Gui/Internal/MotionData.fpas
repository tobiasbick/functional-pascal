unit Fpas.Ui.Gui.Internal.MotionData;

uses
  Fpas.Ui.Motion as M, Fpas.Ui.Gui.Internal.Sizing as S, Fpas.Ui.Gui.Internal.ChartData as Colors,
  Fpas.Ui.Gui.Cui as Cui;

// Converts common animated-text settings.
// ## Parameters
// - `Value`: Validated effect options.
// ## Returns
// Native layout and effect options.
public function Options(Value: M.TextOptions): Cui.CuiMotionText;
begin
  const Width: S.NativeExtent := S.Extent(Value.Width);
  return new Cui.CuiMotionText(
    cast<int>(Value.Font), Width.Kind, Width.Value, Colors.Color(Value.Color),
    Value.Size, Value.Speed, Value.Delay, Value.NoWrap, Value.Caret
  );
end function;

end unit;
