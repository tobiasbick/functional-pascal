  Fpas.Ui.Gui.Internal.Widgets.Dropzone as DropzoneWidget,
  Fpas.Ui.Gui.Internal.Widgets.AvatarUpload as AvatarUploadWidget,
  Fpas.Ui.Gui.Internal.Widgets.SignaturePad as SignaturePadWidget,
  Fpas.Ui.Knobs as Knobs, Fpas.Ui.Faders as Faders, Fpas.Ui.LevelMeters as Levels,
  Fpas.Ui.Gui.Internal.Widgets.Knob as KnobWidget,
  Fpas.Ui.Gui.Internal.Widgets.Fader as FaderWidget,
  Fpas.Ui.Gui.Internal.Widgets.LevelMeter as LevelMeterWidget,
  Fpas.Ui.RulerSliders as Rulers, Fpas.Ui.HistogramSliders as Histograms,
  Fpas.Ui.Gui.Internal.Widgets.RulerSlider as RulerWidget,
  Fpas.Ui.Gui.Internal.Widgets.HistogramSlider as HistogramWidget,
  Fpas.Ui.TimePickers as TimePickers, Fpas.Ui.WheelPickers as WheelPickers,
  Fpas.Ui.Gui.Internal.Widgets.TimePicker as TimePickerWidget,
  Fpas.Ui.Gui.Internal.Widgets.WheelPicker as WheelPickerWidget,
  Fpas.Ui.Gui.Internal.Widgets.TimeDial as TimeDialWidget,
  Fpas.Ui.DateRanges as Dates, Fpas.Ui.DateRangePickers as RangePickers,
  Fpas.Ui.Gui.Internal.Widgets.DateRangePicker as RangePickerWidget,
  Fpas.Ui.Gui.Internal.Widgets.DateRangeCalendar as RangeCalendarWidget,
  Fpas.Ui.SpeedDials as Speed, Fpas.Ui.Gui.Internal.Widgets.SpeedDial as SpeedWidget,
  Fpas.Ui.SwipeActions as Swipe, Fpas.Ui.Gui.Internal.Widgets.SwipeItem as SwipeWidget,
  Fpas.Ui.MultiSelects as Multi, Fpas.Ui.Gui.Internal.Widgets.MultiSelect as MultiWidget,
  Fpas.Ui.Gui.Internal.Widgets.Skeleton as SkeletonWidget,
  Fpas.Ui.TimelineItems as Timeline, Fpas.Ui.Gui.Internal.Widgets.TimelineItem as TimelineWidget,
  Fpas.Ui.Gui.Internal.Widgets.ProgressRing as RingWidget,
  Fpas.Ui.Gui.Internal.Widgets.Meter as MeterWidget, Fpas.Ui.Gui.Internal.Widgets.Alert as AlertWidget, Fpas.Ui.Gui.Internal.Widgets.ProgressBar as ProgressWidget, Fpas.Ui.Gui.Internal.Widgets.Spinner as SpinnerWidget, Fpas.Ui.Alerts as Alerts, Fpas.Ui.ProgressBars as ProgressBars, Fpas.Ui.ExpandableTexts as ExpandableTexts, Fpas.Ui.ExpandableCards as ExpandableCards, Fpas.Ui.Gui.Internal.Widgets.ExpandableText as ExpandableTextWidget, Fpas.Ui.Gui.Internal.Widgets.Disclosure as DisclosureWidget, Fpas.Ui.Reactions as Reactions, Fpas.Ui.UserMenus as UserMenus, Fpas.Ui.Gui.Internal.Widgets.Reactions as ReactionsWidget, Fpas.Ui.Gui.Internal.Widgets.UserMenu as UserMenuWidget, Fpas.Ui.Selects as Selects, Fpas.Ui.NumberFields as NumberFields, Fpas.Ui.Gui.Internal.Widgets.Select as SelectWidget, Fpas.Ui.Gui.Internal.Widgets.NumberField as NumberWidget, Fpas.Ui.TagInputs as TagInputs, Fpas.Ui.OneTimeCodes as OneTimeCodes, Fpas.Ui.Gui.Internal.Widgets.TagInput as TagWidget, Fpas.Ui.Gui.Internal.Widgets.OneTimeCode as CodeWidget, Fpas.Ui.Gui.Internal.Widgets.PasswordStrength as StrengthWidget, Fpas.Ui.SearchFields as SearchFields, Fpas.Ui.TextAreas as TextAreas, Fpas.Ui.Gui.Internal.Widgets.SearchField as SearchFieldWidget, Fpas.Ui.Gui.Internal.Widgets.TextArea as TextAreaWidget, Fpas.Ui.Dialogs as Dialogs, Fpas.Ui.Gui.Internal.Widgets.Dialog as DialogWidget, Fpas.Ui.Gui.Internal.Widgets.ActionFooter as ActionFooterWidget, Fpas.Ui.TextFields as TextFields, Fpas.Ui.Gui.Internal.Widgets.TextField as TextFieldWidget, Fpas.Ui.Popovers as Popovers, Fpas.Ui.ConfirmPopovers as ConfirmPopovers, Fpas.Ui.Gui.Internal.Widgets.Popover as PopoverWidget, Fpas.Ui.Gui.Internal.Widgets.ConfirmPopover as ConfirmPopoverWidget, Fpas.Ui.Gui.Internal.Widgets.Tooltip as TooltipWidget, Fpas.Ui.Gui.Internal.Widgets.Stepper as Stepper, Fpas.Ui.Tabs as Tabs, Fpas.Ui.Gui.Internal.Widgets.Tabs as TabsWidget, Fpas.Ui.Gui.Internal.Widgets.Breadcrumb as Breadcrumb, Fpas.Ui.Gui.Internal.Widgets.Pagination as Pagination, Fpas.Ui.Gui.Internal.Widgets.Chip as Chip, Fpas.Ui.Gui.Internal.Widgets.Rating as Rating, Fpas.Ui.RadioCards as RadioCards, Fpas.Ui.Sliders as Sliders, Fpas.Ui.RangeSliders as RangeSliders, Fpas.Ui.Gui.Internal.Widgets.RadioCards as RadioCardsWidget, Fpas.Ui.Gui.Internal.Widgets.Slider as Slider, Fpas.Ui.Gui.Internal.Widgets.RangeSlider as RangeSlider, Fpas.Ui.RadioGroups as RadioGroups, Fpas.Ui.Gui.Internal.Widgets.Checkbox as Checkbox, Fpas.Ui.Gui.Internal.Widgets.Switch as Switch, Fpas.Ui.Gui.Internal.Widgets.RadioButton as RadioButton, Fpas.Ui.Gui.Internal.Widgets.RadioGroup as RadioGroup, Fpas.Ui.ToggleGroups as ToggleGroups, Fpas.Ui.Gui.Internal.Widgets.ToggleGroup as ToggleGroup, Fpas.Ui.Gui.Internal.Widgets.ContextMenu as ContextMenu, Fpas.Ui.Menus as Menus, Fpas.Ui.Gui.Internal.Widgets.DropdownMenu as DropdownMenu, Fpas.Ui.SegmentedControls as Segmented, Fpas.Ui.Gui.Internal.Widgets.SegmentedControl as SegmentedWidget, Fpas.Ui.Gui.Internal.Widgets.ThemeToggle as ThemeToggle, Fpas.Ui.Themes as Themes, Fpas.Ui.ThemeSwitchers as ThemeSwitchers, Fpas.Ui.Gui.Internal.Widgets.ThemeSwitcher as ThemeSwitcher, Fpas.Ui.StatusButtons as Status, Fpas.Ui.Gui.Internal.Widgets.StatusButton as StatusButton, Fpas.Ui.ConfirmButtons as Confirms, Fpas.Ui.Gui.Internal.Widgets.ConfirmButton as ConfirmButton, Fpas.Ui.SplitButtons as Split, Fpas.Ui.Gui.Internal.Widgets.SplitButton as SplitButton, Fpas.Ui.HoldButtons as Holds, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.Sizing as Size, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, Fpas.Ui.Navigation as N, Fpas.Ui.Gui.Internal.Widgets.Sidebar as Sidebar, Fpas.Ui.Sheets as Sheets, Fpas.Ui.Gui.Internal.Widgets.Sheet as Sheet, Fpas.Ui.Buttons as B, Fpas.Ui.Gui.Internal.Widgets.Button as Button, Fpas.Ui.Gui.Internal.Widgets.ButtonGroup as ButtonGroup, Fpas.Ui.Gui.Internal.Widgets.CopyButton as CopyButton, Fpas.Ui.Gui.Internal.Widgets.HoldButton as HoldButton, Fpas.Ui.IconButtons as Icons, Fpas.Ui.Gui.Internal.Widgets.IconButton as IconButton, Fpas.Ui.Graphics as G, System as Sys, System.Collections.Generic as Generic;

// Draws a prepared tree and gathers messages without running Update or effects.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `State`: Frame context and retained resources.
public procedure Draw<TMsg>(State: C.State<TMsg>);
  procedure Visit(Node: E.Element<TMsg>; Current: C.State<TMsg>; Horizontal: bool; Align: L.Alignment);
  begin
    case Node of
      when E.Element.Label(const Value: string):
        Current.Window.Text(Value);
        Current.Labels.Add(Value);
      when E.Element.TextField(
        const Id: string, const Value: string, const OnChange: function(string): TMsg,
        const Settings: TextFields.Options, const OnSubmit: Sys.Func<string, TMsg>?
      ):
        TextFieldWidget.Draw<TMsg>(Current, Id, Value, OnChange, Settings, OnSubmit);
      when E.Element.SearchField(
        const Id: string, const Value: string, const OnChange: function(string): TMsg,
        const Settings: SearchFields.Options, const OnSubmit: Sys.Func<string, TMsg>?
      ):
        SearchFieldWidget.Draw<TMsg>(Current, Id, Value, OnChange, Settings, OnSubmit);
      when E.Element.TextArea(
        const Id: string, const Value: string, const OnChange: function(string): TMsg,
        const Settings: TextAreas.Options, const OnSubmit: Sys.Func<string, TMsg>?
      ):
        TextAreaWidget.Draw<TMsg>(Current, Id, Value, OnChange, Settings, OnSubmit);
      when E.Element.TagInput(
        const Id: string,
        const Tags: array of string,
        const OnChange: function(array of string): TMsg,
        const Settings: TagInputs.Options
      ):
        TagWidget.Draw<TMsg>(Current, Id, Tags, OnChange, Settings);
      when E.Element.OneTimeCodeInput(
        const Id: string, const Value: string, const OnChange: function(string): TMsg,
        const Settings: OneTimeCodes.Options, const OnComplete: Sys.Func<string, TMsg>?
      ):
        CodeWidget.Draw<TMsg>(Current, Id, Value, OnChange, Settings, OnComplete);
      when E.Element.PasswordStrengthMeter(const Id: string, const Password: string):
        StrengthWidget.Draw<TMsg>(Current, Id, Password);
      when E.Element.Alert(
        const Id: string, const Title: string, const Settings: Alerts.Options,
        const Notify: Sys.Func<TMsg>?
      ):
        AlertWidget.Draw<TMsg>(Current, Id, Title, Settings, Notify);
      when E.Element.ProgressBar(
        const Id: string,
        const Value: float,
        const Settings: ProgressBars.Options
      ):
        ProgressWidget.Draw<TMsg>(Current, Id, Value, Settings);
      when E.Element.Spinner(const Id: string, const Diameter: float):
        SpinnerWidget.Draw<TMsg>(Current, Id, Diameter);
      when E.Element.Skeleton(const Id: string, const Width: L.Extent, const Height: float):
        SkeletonWidget.Draw<TMsg>(Current, Id, Width, Height);
      when E.Element.TimelineItem(
        const Id: string,
        const Title: string,
        const Settings: Timeline.Options
      ):
        TimelineWidget.Draw<TMsg>(Current, Id, Title, Settings);
      when E.Element.ProgressRing(
        const Id: string, const Label: string, const Value: float, const Diameter: float
      ):
        RingWidget.Draw<TMsg>(Current, Id, Label, Value, Diameter);
      when E.Element.LevelMeter(
        const Id: string,
        const Peaks: array of float,
        const Settings: Levels.Options,
        const Notify: Sys.Func<TMsg>?
      ):
        LevelMeterWidget.Draw<TMsg>(Current, Id, Peaks, Settings, Notify);
      when E.Element.Meter(
        const Id: string, const Label: string, const Used: float,
        const Total: float, const Unit: string
      ):
        MeterWidget.Draw<TMsg>(Current, Id, Label, Used, Total, Unit);
      when E.Element.ColorPicker(
        const Id: string, const Value: G.Color, const Change: function(G.Color): TMsg,
        const Enabled: bool
      ):
        ColorPickerWidget.Draw<TMsg>(Current, Id, Value, Change, Enabled);
      when E.Element.EmojiPicker(
        const Id: string, const Value: Emojis.State, const Change: function(Emojis.Change): TMsg,
        const Settings: Emojis.Options
      ):
        EmojiPickerWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
      when E.Element.Calendar(
        const Id: string, const Value: Sys.DateOnly?, const Change: function(Sys.DateOnly): TMsg,
        const Enabled: bool
      ):
        CalendarWidget.Draw<TMsg>(Current, Id, Value, Change, Enabled);
      when E.Element.DatePicker(
        const Id: string, const Value: Sys.DateOnly?, const Change: function(Sys.DateOnly): TMsg,
        const Settings: DatePickers.Options
      ):
        DatePickerWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
      when E.Element.RangeCalendar(
        const Id: string, const Value: Dates.Value, const Change: function(Dates.Value): TMsg,
        const Months: int, const Enabled: bool
      ):
        RangeCalendarWidget.Draw<TMsg>(Current, Id, Value, Change, Months, Enabled);
      when E.Element.RangePicker(
        const Id: string, const Value: Dates.Value, const Change: function(Dates.Value): TMsg,
        const Settings: RangePickers.Options
      ):
        RangePickerWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
      when E.Element.TimePicker(
        const Id: string, const Value: Sys.TimeOnly, const Change: function(Sys.TimeOnly): TMsg,
        const Settings: TimePickers.Options
      ):
        TimePickerWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
      when E.Element.WheelPicker(
        const Id: string, const Items: array of string, const Selected: int,
        const Change: function(int): TMsg, const Settings: WheelPickers.Options
      ):
        WheelPickerWidget.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.TimeDial(
        const Id: string, const Value: Sys.TimeOnly, const Change: function(Sys.TimeOnly): TMsg,
        const Diameter: float, const Enabled: bool
      ):
        TimeDialWidget.Draw<TMsg>(Current, Id, Value, Change, Diameter, Enabled);
      when E.Element.MultiSelectInput(
        const Id: string, const Items: array of Selects.Item, const Selected: array of bool,
        const Change: function(array of bool): TMsg, const Settings: Multi.Options
      ):
        MultiWidget.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.SelectInput(
        const Id: string, const Items: array of Selects.Item, const Selected: int,
        const OnChange: function(int): TMsg, const Settings: Selects.Options
      ):
        SelectWidget.Draw<TMsg>(Current, Id, Items, Selected, OnChange, Settings);
      when E.Element.NumberField(
        const Id: string, const Value: double, const Minimum: double, const Maximum: double,
        const OnChange: function(double): TMsg, const Settings: NumberFields.Options
      ):
        NumberWidget.Draw<TMsg>(Current, Id, Value, Minimum, Maximum, OnChange, Settings);
      when E.Element.Separator(const Title: string):
        if Title = '' then
          Current.Window.Separator();
        else
          Current.Window.BeginGroup(false, 0, 4, 0, false);
          Current.Window.Text(Title);
          Current.Labels.Add(Title);
          Current.Window.Separator();
          Current.Window.EndGroup();
        end if;
      when E.Element.ButtonAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: B.Options
      ):
        Button.Draw<TMsg>(Current, Id, Label, Message, Settings);
      when E.Element.IconAction(
        const Id: string, const Icon: string, const Tooltip: string, const Message: TMsg,
        const Settings: Icons.Options
      ):
        IconButton.Draw<TMsg>(Current, Id, Icon, Tooltip, Message, Settings);
      when E.Element.CopyAction(
        const Id: string,
        const Text: string,
        const OnCopied: Sys.Func<TMsg>?,
        const Enabled: bool
      ):
        CopyButton.Draw<TMsg>(Current, Id, Text, OnCopied, Enabled);
      when E.Element.HoldAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Holds.Options
      ):
        HoldButton.Draw<TMsg>(Current, Id, Label, Message, Settings);
      when E.Element.ConfirmAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Confirms.Options
      ):
        ConfirmButton.Draw<TMsg>(Current, Id, Label, Message, Settings);
      when E.Element.StatusAction(
        const Id: string,
        const Label: string,
        const Value: Status.Status,
        const Message: TMsg,
        const Settings: Status.Options
      ):
        StatusButton.Draw<TMsg>(Current, Id, Label, Value, Message, Settings);
      when E.Element.ThemeFlip(
        const Id: string, const Appearance: Themes.Mode,
        const Change: function(Themes.Mode): TMsg, const Enabled: bool
      ):
        ThemeToggle.Draw<TMsg>(Current, Id, Appearance, Change, Enabled);
      when E.Element.Segments(
        const Id: string, const Items: array of Segmented.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: Segmented.Options
      ):
        SegmentedWidget.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.TabStrip(
        const Id: string, const Items: array of Tabs.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: Tabs.Options
      ):
        TabsWidget.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.BreadcrumbTrail(
        const Id: string,
        const Items: array of string,
        const Navigate: function(int): TMsg,
        const Enabled: bool
      ):
        Breadcrumb.Draw<TMsg>(Current, Id, Items, Navigate, Enabled);
      when E.Element.PaginationAction(
        const Id: string,
        const Page: int,
        const Count: int,
        const Change: function(int): TMsg,
        const Enabled: bool
      ):
        Pagination.Draw<TMsg>(Current, Id, Page, Count, Change, Enabled);
      when E.Element.StepProgress(const Id: string, const Steps: array of string, const Index: int):
        Stepper.Draw<TMsg>(Current, Id, Steps, Index);
      when E.Element.Toggles(
        const Id: string, const Items: array of ToggleGroups.Item, const Selected: array of bool,
        const Change: function(array of bool): TMsg, const Settings: ToggleGroups.Options
      ):
        ToggleGroup.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.ThemeChoice(
        const Id: string,
        const Selected: ThemeSwitchers.Selection,
        const Change: function(ThemeSwitchers.Selection): TMsg,
        const Settings: ThemeSwitchers.Options
      ):
        ThemeSwitcher.Draw<TMsg>(Current, Id, Selected, Change, Settings);
      when E.Element.CheckboxAction(
        const Id: string,
        const Label: string,
        const Checked: bool,
        const Change: function(bool): TMsg,
        const Description: string,
        const Enabled: bool,
        const Indeterminate: bool
      ):
        Checkbox.Draw<TMsg>(
          Current,
          Id,
          Label,
          Checked,
          Change,
          Description,
          Enabled,
          Indeterminate
        );
      when E.Element.SwitchAction(
        const Id: string, const Label: string, const On: bool, const Change: function(bool): TMsg,
        const Description: string, const Enabled: bool
      ):
        Switch.Draw<TMsg>(Current, Id, Label, On, Change, Description, Enabled);
      when E.Element.RadioAction(
        const Id: string, const Label: string, const Selected: bool, const Select: function(): TMsg,
        const Description: string, const Enabled: bool
      ):
        RadioButton.Draw<TMsg>(Current, Id, Label, Selected, Select, Description, Enabled);
      when E.Element.Radios(
        const Id: string, const Items: array of RadioGroups.Item, const Selected: int,
        const Change: function(int): TMsg, const Enabled: bool, const Gap: L.Spacing
      ):
        RadioGroup.Draw<TMsg>(Current, Id, Items, Selected, Change, Enabled, Gap);
      when E.Element.Cards(
        const Id: string, const Items: array of RadioCards.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: RadioCards.Options
      ):
        RadioCardsWidget.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.SliderAction(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Sliders.Options
      ):
        Slider.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.RangeSliderAction(
        const Id: string,
        const Label: string,
        const Value: RangeSliders.Interval,
        const Minimum: float,
        const Maximum: float,
        const Change: function(RangeSliders.Interval): TMsg,
        const Enabled: bool
      ):
        RangeSlider.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Enabled);
      when E.Element.Dropzone(
        const Id: string,
        const Drop: function(array of string): TMsg,
        const Browse: Sys.Func<TMsg>?,
        const Settings: Dropzones.Options
      ):
        DropzoneWidget.Draw<TMsg>(Current, Id, Drop, Browse, Settings);
      when E.Element.AvatarUpload(
        const Id: string,
        const Name: string,
        const Path: string?,
        const Drop: function(string): TMsg,
        const Browse: Sys.Func<TMsg>?,
        const Diameter: float,
        const Enabled: bool
      ):
        AvatarUploadWidget.Draw<TMsg>(Current, Id, Name, Path, Drop, Browse, Diameter, Enabled);
      when E.Element.SignaturePad(
        const Id: string,
        const Change: Sys.Func<Signatures.Signature, TMsg>?,
        const Settings: Signatures.Options
      ):
        SignaturePadWidget.Draw<TMsg>(Current, Id, Change, Settings);
      when E.Element.Knob(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Knobs.Options
      ):
        KnobWidget.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.Fader(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Faders.Options
      ):
        FaderWidget.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.RulerSlider(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Rulers.Options
      ):
        RulerWidget.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.HistogramSlider(
        const Id: string, const Label: string, const Bins: array of float,
        const Value: RangeSliders.Interval, const Minimum: float, const Maximum: float,
        const Change: function(RangeSliders.Interval): TMsg, const Settings: Histograms.Options
      ):
        HistogramWidget.Draw<TMsg>(
          Current,
          Id,
          Label,
          Bins,
          Value,
          Minimum,
          Maximum,
          Change,
          Settings
        );
      when E.Element.ChipAction(
        const Id: string,
        const Label: string,
        const Selected: bool,
        const Change: function(bool): TMsg,
        const Icon: string,
        const Enabled: bool
      ):
        Chip.Draw<TMsg>(Current, Id, Label, Selected, Change, Icon, Enabled);
      when E.Element.RatingAction(
        const Id: string, const Label: string, const Value: int, const Change: function(int): TMsg,
        const Maximum: int, const Enabled: bool
      ):
        Rating.Draw<TMsg>(Current, Id, Label, Value, Change, Maximum, Enabled);
      when E.Element.SplitAction(
        const Id: string, const Label: string, const Message: TMsg,
        const Items: array of Split.Item<TMsg>, const Settings: Split.Options
      ):
        SplitButton.Draw<TMsg>(Current, Id, Label, Message, Items, Settings);
      when E.Element.Contextual(
        const Id: string,
        const Child: E.Element<TMsg>,
        const Entries: array of Menus.Entry<TMsg>,
        const Enabled: bool
      ):
        Visit(Child, Current, Horizontal, Align);
        ContextMenu.Draw<TMsg>(Current, Id, Entries, Enabled);
        return;
      when E.Element.Hinted(
        const Child: E.Element<TMsg>,
        const Caption: string,
        const Shortcut: string
      ):
        Visit(Child, Current, Horizontal, Align);
        TooltipWidget.Attach<TMsg>(Current, Caption, Shortcut);
        return;
      when E.Element.Accordion(
        const Id: string, const Title: string, const Open: bool,
        const OnChange: function(bool): TMsg, const Content: E.Element<TMsg>, const Enabled: bool
      ):
        DisclosureWidget.Draw<TMsg>(
          Current, Id, Title, Open, OnChange, Content, false,
          new ExpandableCards.Options(Enabled := Enabled), Visit
        );
      when E.Element.ExpandableCard(
        const Id: string,
        const Title: string,
        const Open: bool,
        const OnChange: function(bool): TMsg,
        const Content: E.Element<TMsg>,
        const Settings: ExpandableCards.Options
      ):
        DisclosureWidget.Draw<TMsg>(
          Current,
          Id,
          Title,
          Open,
          OnChange,
          Content,
          true,
          Settings,
          Visit
        );
      when E.Element.ExpandableText(
        const Id: string, const Text: string, const Settings: ExpandableTexts.Options,
        const OnToggle: Sys.Func<TMsg>?
      ):
        ExpandableTextWidget.Draw<TMsg>(Current, Id, Text, Settings, OnToggle);
      when E.Element.Popover(
        const Id: string, const Trigger: E.Element<TMsg>, const Content: E.Element<TMsg>,
        const Open: bool, const Dismiss: TMsg, const Settings: Popovers.Options
      ):
        PopoverWidget.Draw<TMsg>(
          Current,
          Id,
          Trigger,
          Content,
          Open,
          Dismiss,
          Settings,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.ConfirmPopover(
        const Id: string, const Trigger: E.Element<TMsg>, const Open: bool,
        const Settings: ConfirmPopovers.Options, const Confirm: TMsg, const Dismiss: TMsg
      ):
        ConfirmPopoverWidget.Draw<TMsg>(
          Current,
          Id,
          Trigger,
          Open,
          Settings,
          Confirm,
          Dismiss,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.ReactionGroup(
        const Id: string, const Items: array of Reactions.Item,
        const Change: function(int, Reactions.Item): TMsg, const Enabled: bool
      ):
        ReactionsWidget.Draw<TMsg>(Current, Id, Items, Change, Enabled);
      when E.Element.SpeedDialAction(
        const Id: string, const Items: array of Speed.Item, const Choose: function(int): TMsg,
        const Settings: Speed.Options
      ):
        SpeedWidget.Draw<TMsg>(Current, Id, Items, Choose, Settings);
      when E.Element.SwipeRow(
        const Id: string, const Content: E.Element<TMsg>, const Left: array of Swipe.Item,
        const Right: array of Swipe.Item, const Choose: function(Swipe.Side, int): TMsg,
        const Settings: Swipe.Options
      ):
        SwipeWidget.Draw<TMsg>(Current, Id, Content, Left, Right, Choose, Settings, Visit);
      when E.Element.AccountMenu(
        const Id: string, const Name: string, const Entries: array of Menus.Entry<TMsg>,
        const Settings: UserMenus.Options
      ):
        UserMenuWidget.Draw<TMsg>(Current, Id, Name, Entries, Settings);
      when E.Element.Dropdown(
        const Id: string,
        const Label: string,
        const Entries: array of Menus.Entry<TMsg>,
        const Settings: Menus.Options
      ):
        DropdownMenu.Draw<TMsg>(Current, Id, Label, Entries, Settings);
      when E.Element.Sidebar(
        const Id: string,
        const Sections: array of N.Section<TMsg>,
        const Active: string?,
        const Enabled: bool
      ):
        Sidebar.Draw<TMsg>(Current, Id, Sections, Active, Enabled);
      when E.Element.ButtonGroup(const Children: array of E.Element<TMsg>):
        ButtonGroup.Draw<TMsg>(Current, Children, Visit);
      when E.Element.ActionFooter(const Children: array of E.Element<TMsg>):
        ActionFooterWidget.Draw<TMsg>(Current, Children, Visit);
      when E.Element.Stack(
        const Children: array of E.Element<TMsg>,
        const Row: bool,
        const Settings: L.Flow
      ):
        Current.Window.BeginGroup(
          Row,
          Size.Spacing(Settings.Padding),
          Size.Spacing(Settings.Gap),
          cast<int>(Settings.Align),
          false,
          Settings.Wrap, Settings.Clip ?? not Settings.Wrap
        );
        for Child: E.Element<TMsg> in Children do
          Visit(Child, Current, Row, Settings.Align);
        end for;

        Current.Window.EndGroup();
      when E.Element.Sized(const Child: E.Element<TMsg>, const Settings: L.Flex):
        Visit(Child, Current, Horizontal, Align);
        Size.Apply(Current.Window, Settings, Horizontal, Align);
        return;
      when E.Element.Styled(const Child: E.Element<TMsg>, const Role: S.Role):
        Visit(Child, Current, Horizontal, Align);
        Current.Window.StyleLast(cast<int>(Role));
        return;
      when E.Element.Framed(const Child: E.Element<TMsg>, const Title: string):
        Current.Window.BeginGroup(false, 8, 8, 0, true);
        if Title <> '' then
          Current.Window.Text(Title);
          Current.Labels.Add(Title);
        end if;

        Visit(Child, Current, false, L.Alignment.Stretch);
        Current.Window.EndGroup();
      when E.Element.Scroll(
        const Id: string,
        const Child: E.Element<TMsg>,
        const Position: L.ScrollPosition?,
        const Scroll: Sys.Func<L.ScrollChange, TMsg>?,
        const Bar: bool
      ):
        const Token: string := C.Token('scroll', Id);
        var Before: float := 0;
        var Maximum: float := 0;
        Current.Window.ScrollState(Token, -1, 0, out Before, out Maximum);
        var Mode: int := -1;
        var Offset: float := 0;
        case Position of
          when L.ScrollPosition.Start:
            Mode := 0;
          when L.ScrollPosition.End:
            Mode := 1;
          when L.ScrollPosition.Offset(const Distance: L.Measure):
            Mode := 0;
            Offset := Size.Measure(Distance);
          else
        end case;

        Current.Window.ScrollState(Token, Mode, Offset, out Before, out Maximum);
        Current.Window.ScrollState(Token, -1, 0, out Before, out Maximum);
        Current.Window.BeginViewport(Token, Bar, Current.AcceptInput);
        Visit(Child, Current, false, L.Alignment.Stretch);
        Current.Window.EndScroll();
        var After: float := 0;
        Current.Window.ScrollState(Token, -1, 0, out After, out Maximum);
        if Current.AcceptInput and After <> Before then
          case Scroll of
            when is Sys.Func<L.ScrollChange, TMsg> as Changed:
              const Units: L.Measure := L.Measure.Logical(cast<int>(After));
              Current.Messages.Add(
                Changed.Invoke(
                  new L.ScrollChange(
                    L.ScrollPosition.Offset(Units),
                    Units,
                    L.Measure.Logical(cast<int>(Maximum))
                  )
                )
              );
            else
          end case;
        end if;

        C.Track<TMsg>(
          Current,
          new App.Control(
            Id,
            '',
            'scroll',
            new Cui.CuiRectangle(),
            Current.AcceptInput,
            Value := After.ToString()
          )
        );
      when E.Element.Sheet(
        const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>,
        const Open: bool, const Settings: Sheets.Options, const Dismiss: TMsg
      ):
        Sheet.Draw<TMsg>(
          Current,
          Id,
          Base,
          Content,
          Open,
          Settings,
          Dismiss,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.Dialog(
        const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>,
        const Open: bool, const Settings: Dialogs.Options, const Dismiss: TMsg
      ):
        DialogWidget.Draw<TMsg>(
          Current,
          Id,
          Base,
          Content,
          Open,
          Settings,
          Dismiss,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.Deferred(const Id: string, _):
        Visit(Current.Prepared.Subviews[Id].Tree, Current, Horizontal, Align);
        return;
      else
        raise new Sys.InvalidOperationException('An invalid target widget reached GUI drawing.');
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;
begin
  State.Window.BeginHostView();
  State.Window.BeginGroup(false, 0, 0, 0, false);
  Visit(State.Prepared.Tree, State, false, L.Alignment.Stretch);
  State.Window.EndGroup();
  State.Window.SizeLast(false, 1, 0, 0, -1, 1, 0);
end procedure;

end unit;
