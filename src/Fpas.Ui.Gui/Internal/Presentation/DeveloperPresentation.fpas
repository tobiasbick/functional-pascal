// [Documentation](../../../../docs/ui/gui/host.md#frame-preparation-and-presentation)

unit Fpas.Ui.Gui.Internal.Presentation.DeveloperPresentation;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Widgets.Charts.TimeHistogram as TimeHistogramWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.ApiExplorer as ApiExplorerWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.Blame as BlameWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.CommitGraph as CommitGraphWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.Coverage as CoverageWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.DependencyGraph as DependencyGraphWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.FeatureFlags as FeatureFlagsWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.KeyValueEditor as KeyValueEditorWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.Keymap as KeymapWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.NetworkWaterfall as NetworkWaterfallWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.Pipeline as PipelineWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.Problems as ProblemsWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.QueryBuilder as QueryBuilderWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.RegexTester as RegexTesterWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.RequestBar as RequestBarWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.ResponseStatus as ResponseStatusWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.StackTrace as StackTraceWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.TestExplorer as TestExplorerWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.TraceViewer as TraceViewerWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Developer.Uptime as UptimeWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Pickers.SchedulePicker as SchedulePickerWidget;
uses Fpas.Ui.Widgets.Charts.TimeHistograms as TimeHistograms;
uses Fpas.Ui.Widgets.Developer.ApiExplorers as ApiExplorers;
uses Fpas.Ui.Widgets.Developer.Blames as Blames;
uses Fpas.Ui.Widgets.Developer.CommitGraphs as CommitGraphs;
uses Fpas.Ui.Widgets.Developer.Coverages as Coverages;
uses Fpas.Ui.Widgets.Developer.DependencyGraphs as DependencyGraphs;
uses Fpas.Ui.Widgets.Developer.FeatureFlagEditors as FeatureFlagEditors;
uses Fpas.Ui.Widgets.Developer.KeyValueEditors as KeyValueEditors;
uses Fpas.Ui.Widgets.Developer.Keymaps as Keymaps;
uses Fpas.Ui.Widgets.Developer.NetworkWaterfalls as NetworkWaterfalls;
uses Fpas.Ui.Widgets.Developer.Pipelines as Pipelines;
uses Fpas.Ui.Widgets.Developer.ProblemsPanels as ProblemsPanels;
uses Fpas.Ui.Widgets.Developer.QueryBuilders as QueryBuilders;
uses Fpas.Ui.Widgets.Developer.RegexTesters as RegexTesters;
uses Fpas.Ui.Widgets.Developer.RequestBars as RequestBars;
uses Fpas.Ui.Widgets.Developer.ResponseStatuses as ResponseStatuses;
uses Fpas.Ui.Widgets.Developer.StackTraces as StackTraces;
uses Fpas.Ui.Widgets.Developer.TestExplorers as TestExplorers;
uses Fpas.Ui.Widgets.Developer.TraceViewers as TraceViewers;
uses Fpas.Ui.Widgets.Developer.Uptimes as Uptimes;
uses Fpas.Ui.Widgets.Pickers.SchedulePickers as SchedulePickers;

uses System as Sys;

// Presents a prepared developer widget through its CUI adapter.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Node`: Developer widget.
public procedure Draw of TMsg(Frame: C.State of TMsg; Node: E.Element of TMsg);
begin
  case Node of
    when E.Element.Problems(
      const Id: string,
      const Diagnostics: array of ProblemsPanels.Diagnostic,
      const Changed: function(ProblemsPanels.Event): TMsg,
      const Settings: ProblemsPanels.Options
    ):
      ProblemsWidget.Draw of TMsg(Frame, Id, Diagnostics, Changed, Settings);
    when E.Element.Pipeline(
      const Id: string,
      const Stages: array of string,
      const Jobs: array of Pipelines.Job,
      const Selection: int,
      const Changed: function(Pipelines.Event): TMsg,
      const Settings: Pipelines.Options
    ):
      PipelineWidget.Draw of TMsg(Frame, Id, Stages, Jobs, Selection, Changed, Settings);
    when E.Element.Keymap(
      const Id: string,
      const Bindings: array of Keymaps.Binding,
      const Categories: array of string,
      const Modifiers: int,
      const Changed: function(Keymaps.Event): TMsg,
      const Settings: Keymaps.Options
    ):
      KeymapWidget.Draw of TMsg(Frame, Id, Bindings, Categories, Modifiers, Changed, Settings);
    when E.Element.CommitGraph(
      const Id: string,
      const Commits: array of CommitGraphs.Commit,
      const Selection: int,
      const Changed: function(CommitGraphs.Event): TMsg,
      const Settings: CommitGraphs.Options
    ):
      CommitGraphWidget.Draw of TMsg(Frame, Id, Commits, Selection, Changed, Settings);
    when E.Element.DependencyGraph(
      const Id: string,
      const Vertices: array of DependencyGraphs.Vertex,
      const Edges: array of DependencyGraphs.Edge,
      const Selection: int,
      const Changed: function(DependencyGraphs.Event): TMsg,
      const Settings: DependencyGraphs.Options
    ):
      DependencyGraphWidget.Draw of TMsg(Frame, Id, Vertices, Edges, Selection, Changed, Settings);
    when E.Element.NetworkWaterfall(
      const Id: string,
      const Requests: array of NetworkWaterfalls.Request,
      const Selection: int,
      const Changed: function(NetworkWaterfalls.Event): TMsg,
      const Settings: NetworkWaterfalls.Options
    ):
      NetworkWaterfallWidget.Draw of TMsg(Frame, Id, Requests, Selection, Changed, Settings);
    when E.Element.TraceViewer(
      const Id: string,
      const Tracks: array of TraceViewers.Track,
      const Spans: array of TraceViewers.Span,
      const Markers: array of TraceViewers.Marker,
      const Value: TraceViewers.View,
      const Selection: int,
      const Changed: function(TraceViewers.Event): TMsg,
      const Settings: TraceViewers.Options
    ):
      TraceViewerWidget.Draw of TMsg(
        Frame,
        Id,
        Tracks,
        Spans,
        Markers,
        Value,
        Selection,
        Changed,
        Settings
      );
    when E.Element.TestExplorer(
      const Id: string,
      const Entries: array of TestExplorers.Item,
      const Changed: function(TestExplorers.Event): TMsg,
      const Settings: TestExplorers.Options
    ):
      TestExplorerWidget.Draw of TMsg(Frame, Id, Entries, Changed, Settings);
    when E.Element.StackTrace(
      const Id: string,
      const Frames: array of StackTraces.Frame,
      const Changed: function(StackTraces.Event): TMsg,
      const Settings: StackTraces.Options
    ):
      StackTraceWidget.Draw of TMsg(Frame, Id, Frames, Changed, Settings);
    when E.Element.ResponseStatus(
      const Id: string,
      const Status: int,
      const Seconds: double,
      const Bytes: double,
      const Settings: ResponseStatuses.Options
    ):
      ResponseStatusWidget.Draw of TMsg(Frame, Id, Status, Seconds, Bytes, Settings);
    when E.Element.Uptime(
      const Id: string,
      const Services: array of Uptimes.Service,
      const LastDay: Sys.DateOnly,
      const Settings: Uptimes.Options
    ):
      UptimeWidget.Draw of TMsg(Frame, Id, Services, LastDay, Settings);
    when E.Element.TimeHistogram(
      const Id: string,
      const Start: double,
      const Bucket: double,
      const Buckets: int,
      const SeriesData: array of TimeHistograms.Series,
      const Value: TimeHistograms.Range,
      const Changed: function(TimeHistograms.Event): TMsg,
      const Settings: TimeHistograms.Options
    ):
      TimeHistogramWidget.Draw of TMsg(
        Frame,
        Id,
        Start,
        Bucket,
        Buckets,
        SeriesData,
        Value,
        Changed,
        Settings
      );
    when E.Element.Coverage(
      const Id: string,
      const ReportFiles: array of Coverages.File,
      const Changed: function(Coverages.Event): TMsg,
      const Settings: Coverages.Options
    ):
      CoverageWidget.Draw of TMsg(Frame, Id, ReportFiles, Changed, Settings);
    when E.Element.Blame(
      const Id: string,
      const Lines: array of string,
      const LineCommits: array of int,
      const Revisions: array of Blames.Revision,
      const Changed: function(Blames.Event): TMsg,
      const Settings: Blames.Options
    ):
      BlameWidget.Draw of TMsg(Frame, Id, Lines, LineCommits, Revisions, Changed, Settings);
    when E.Element.ApiExplorer(
      const Id: string,
      const Endpoints: array of ApiExplorers.Endpoint,
      const Selection: int,
      const Changed: function(ApiExplorers.Event): TMsg,
      const Settings: ApiExplorers.Options
    ):
      ApiExplorerWidget.Draw of TMsg(Frame, Id, Endpoints, Selection, Changed, Settings);
    when E.Element.KeyValueEditor(
      const Id: string,
      const Pairs: array of KeyValueEditors.Pair,
      const Changed: function(KeyValueEditors.Event): TMsg,
      const Settings: KeyValueEditors.Options
    ):
      KeyValueEditorWidget.Draw of TMsg(Frame, Id, Pairs, Changed, Settings);
    when E.Element.QueryBuilder(
      const Id: string,
      const Fields: array of QueryBuilders.Field,
      const RulesData: array of QueryBuilders.Rule,
      const Changed: function(QueryBuilders.Event): TMsg,
      const Settings: QueryBuilders.Options
    ):
      QueryBuilderWidget.Draw of TMsg(Frame, Id, Fields, RulesData, Changed, Settings);
    when E.Element.SchedulePicker(
      const Id: string,
      const Expression: string,
      const Changed: function(SchedulePickers.Event): TMsg,
      const Settings: SchedulePickers.Options
    ):
      SchedulePickerWidget.Draw of TMsg(Frame, Id, Expression, Changed, Settings);
    when E.Element.RegexTester(
      const Id: string,
      const Pattern: string,
      const Sample: string,
      const Modifiers: int,
      const Changed: function(RegexTesters.Event): TMsg,
      const Settings: RegexTesters.Options
    ):
      RegexTesterWidget.Draw of TMsg(Frame, Id, Pattern, Sample, Modifiers, Changed, Settings);
    when E.Element.RequestBar(
      const Id: string,
      const Method: int,
      const Url: string,
      const Changed: function(RequestBars.Event): TMsg,
      const Settings: RequestBars.Options
    ):
      RequestBarWidget.Draw of TMsg(Frame, Id, Method, Url, Changed, Settings);
    when E.Element.FeatureFlags(
      const Id: string,
      const Entries: array of FeatureFlagEditors.Flag,
      const Environments: array of string,
      const Changed: function(FeatureFlagEditors.Event): TMsg,
      const Settings: FeatureFlagEditors.Options
    ):
      FeatureFlagsWidget.Draw of TMsg(Frame, Id, Entries, Environments, Changed, Settings);
    else
  end case;
end procedure;

end unit;
