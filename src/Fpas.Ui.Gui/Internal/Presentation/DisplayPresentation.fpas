// [Documentation](../../../../docs/ui/gui/host.md#frame-preparation-and-presentation)

unit Fpas.Ui.Gui.Internal.Presentation.DisplayPresentation;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Widgets.Canvas.Canvas as CanvasWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Display.Emoji as EmojiWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Display.Icon as IconWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Display.Keycap as KeycapWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Display.NativeText as NativeTextWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Media.Image as ImageWidget;
uses Fpas.Ui.Gui.Internal.Widgets.Overlays.Veil as VeilWidget;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Canvas.Canvases as Canvases;
uses Fpas.Ui.Widgets.Canvas.Painting as Painting;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Media.Images as Images;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;
uses Fpas.Ui.Widgets.Overlays.Veils as Veils;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;

// Presents the native display elements.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Node`: Native display element.
// - `Visit`: Renders the veil's content.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Node: E.Element of TMsg;
  Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment)
);
begin
  case Node of
    when E.Element.NativeText(
      const Text: string,
      const Role: Texts.Appearance,
      const Settings: Texts.Options
    ):
      NativeTextWidget.Draw of TMsg(Frame, Text, Role, Settings);
    when E.Element.Icon(
      const Glyph: string, const Size: float, const Color: G.Color?,
      const ThemeColor: Themes.ColorToken?
    ):
      IconWidget.Draw of TMsg(Frame, Glyph, Size, Color, ThemeColor);
    when E.Element.Emoji(const Glyph: string, const Size: float):
      EmojiWidget.Draw of TMsg(Frame, Glyph, Size);
    when E.Element.Keycap(const Keys: string):
      KeycapWidget.Draw of TMsg(Frame, Keys);
    when E.Element.Image(
      const Id: string,
      const Source: Media.Source,
      const Settings: Images.Options
    ):
      ImageWidget.Draw of TMsg(Frame, Id, Source, Settings);
    when E.Element.Canvas(
      const Id: string,
      const Drawing: array of Canvases.Shape,
      const Clicked: function(Canvases.Event): TMsg,
      const Settings: Canvases.Options,
      const OnWheel: Sys.Func of (Canvases.Wheel, TMsg)?,
      const Paint: (Sys.Action of Painting.Surface)?,
      const OnPointer: Sys.Func of (Canvases.Pointer, TMsg)?,
      const OnInput: Sys.Func of (Canvases.Input, TMsg)?,
      const OnRightClick: Sys.Func of (Canvases.Event, TMsg)?
    ):
      CanvasWidget.Draw of TMsg(
        Frame,
        Id,
        Drawing,
        Clicked,
        Settings,
        OnWheel,
        Paint,
        OnPointer,
        OnInput,
        OnRightClick
      );
    when E.Element.Veil(
      const Id: string,
      const Revealed: bool,
      const Changed: function(bool): TMsg,
      const Child: E.Element of TMsg,
      const Settings: Veils.Options
    ):
      VeilWidget.Draw of TMsg(Frame, Id, Revealed, Changed, Child, Settings, Visit);
    else
  end case;
end procedure;

end unit;
