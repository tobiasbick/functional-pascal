  procedure DrawButtonsAndMenus(Node: E.Element<TMsg>; Current: C.State<TMsg>; Horizontal: bool; Align: L.Alignment);
  begin
    case Node of
      when E.Element.NumberField(
        const Id: string, const Value: double, const Minimum: double, const Maximum: double,
        const OnChange: function(double): TMsg, const Settings: NumberFields.Options
      ):
        NumberWidget.Draw<TMsg>(Current, Id, Value, Minimum, Maximum, OnChange, Settings);
      when E.Element.Separator(const Title: string):
        if Title = '' then
          Current.Window.Separator();
        else
          Current.Window.BeginGroup(false, 0, 4, 0, false);
          Current.Window.Text(Title);
          Current.Labels.Add(Title);
          Current.Window.Separator();
          Current.Window.EndGroup();
        end if;
      when E.Element.ButtonAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: B.Options
      ):
        Button.Draw<TMsg>(Current, Id, Label, Message, Settings);
      when E.Element.IconAction(
        const Id: string, const Icon: string, const Tooltip: string, const Message: TMsg,
        const Settings: Icons.Options
      ):
        IconButton.Draw<TMsg>(Current, Id, Icon, Tooltip, Message, Settings);
      when E.Element.CopyAction(
        const Id: string,
        const Text: string,
        const OnCopied: Sys.Func<TMsg>?,
        const Enabled: bool
      ):
        CopyButton.Draw<TMsg>(Current, Id, Text, OnCopied, Enabled);
      when E.Element.HoldAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Holds.Options
      ):
        HoldButton.Draw<TMsg>(Current, Id, Label, Message, Settings);
      when E.Element.ConfirmAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Confirms.Options
      ):
        ConfirmButton.Draw<TMsg>(Current, Id, Label, Message, Settings);
      when E.Element.StatusAction(
        const Id: string,
        const Label: string,
        const Value: Status.Status,
        const Message: TMsg,
        const Settings: Status.Options
      ):
        StatusButton.Draw<TMsg>(Current, Id, Label, Value, Message, Settings);
      when E.Element.ThemeFlip(
        const Id: string, const Appearance: Themes.Mode,
        const Change: function(Themes.Mode): TMsg, const Enabled: bool
      ):
        ThemeToggle.Draw<TMsg>(Current, Id, Appearance, Change, Enabled);
      when E.Element.Segments(
        const Id: string, const Items: array of Segmented.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: Segmented.Options
      ):
        SegmentedWidget.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.TabStrip(
        const Id: string, const Items: array of Tabs.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: Tabs.Options
      ):
        TabsWidget.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.BreadcrumbTrail(
        const Id: string,
        const Items: array of string,
        const Navigate: function(int): TMsg,
        const Enabled: bool
      ):
        Breadcrumb.Draw<TMsg>(Current, Id, Items, Navigate, Enabled);
      when E.Element.PaginationAction(
        const Id: string,
        const Page: int,
        const Count: int,
        const Change: function(int): TMsg,
        const Enabled: bool
      ):
        Pagination.Draw<TMsg>(Current, Id, Page, Count, Change, Enabled);
      when E.Element.StepProgress(const Id: string, const Steps: array of string, const Index: int):
        Stepper.Draw<TMsg>(Current, Id, Steps, Index);
      when E.Element.Toggles(
        const Id: string, const Items: array of ToggleGroups.Item, const Selected: array of bool,
        const Change: function(array of bool): TMsg, const Settings: ToggleGroups.Options
      ):
        ToggleGroup.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.ThemeChoice(
        const Id: string,
        const Selected: ThemeSwitchers.Selection,
        const Change: function(ThemeSwitchers.Selection): TMsg,
        const Settings: ThemeSwitchers.Options
      ):
        ThemeSwitcher.Draw<TMsg>(Current, Id, Selected, Change, Settings);
      when E.Element.CheckboxAction(
        const Id: string,
        const Label: string,
        const Checked: bool,
        const Change: function(bool): TMsg,
        const Description: string,
        const Enabled: bool,
        const Indeterminate: bool, const HideLabel: bool
      ):
        Checkbox.Draw<TMsg>(
          Current,
          Id,
          Label,
          Checked,
          Change,
          Description,
          Enabled,
          Indeterminate,
          HideLabel
        );
      when E.Element.SwitchAction(
        const Id: string, const Label: string, const On: bool, const Change: function(bool): TMsg,
        const Description: string, const Enabled: bool
      ):
        Switch.Draw<TMsg>(Current, Id, Label, On, Change, Description, Enabled);
      when E.Element.RadioAction(
        const Id: string, const Label: string, const Selected: bool, const Select: function(): TMsg,
        const Description: string, const Enabled: bool
      ):
        RadioButton.Draw<TMsg>(Current, Id, Label, Selected, Select, Description, Enabled);
      when E.Element.Radios(
        const Id: string, const Items: array of RadioGroups.Item, const Selected: int,
        const Change: function(int): TMsg, const Enabled: bool, const Gap: L.Spacing
      ):
        RadioGroup.Draw<TMsg>(Current, Id, Items, Selected, Change, Enabled, Gap);
      when E.Element.Cards(
        const Id: string, const Items: array of RadioCards.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: RadioCards.Options
      ):
        RadioCardsWidget.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.SliderAction(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Sliders.Options
      ):
        Slider.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      else
        DrawPickersAndSelection(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawPickersAndSelection(Node: E.Element<TMsg>; Current: C.State<TMsg>; Horizontal: bool; Align: L.Alignment);
  begin
    case Node of
      when E.Element.RangeSliderAction(
        const Id: string,
        const Label: string,
        const Value: RangeSliders.Interval,
        const Minimum: float,
        const Maximum: float,
        const Change: function(RangeSliders.Interval): TMsg,
        const Enabled: bool
      ):
        RangeSlider.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Enabled);
      when E.Element.Banner(
        const Id: string, const Text: string, const Open: bool, const Dismiss: Sys.Func<TMsg>?,
        const Action: Sys.Func<TMsg>?, const Settings: Banners.Options
      ):
        BannerWidget.Draw<TMsg>(Current, Id, Text, Open, Dismiss, Action, Settings);
      when E.Element.Countdown(
        const Id: string,
        const Seconds: double,
        const Settings: Countdowns.Options
      ):
        CountdownWidget.Draw<TMsg>(Current, Id, Seconds, Settings);
      when E.Element.Checklist(
        const Id: string,
        const Steps: array of Checklists.Step,
        const Toggle: function(int, bool): TMsg,
        const Action: Sys.Func<int, TMsg>?,
        const Settings: Checklists.Options
      ):
        ChecklistWidget.Draw<TMsg>(Current, Id, Steps, Toggle, Action, Settings);
      when E.Element.Dropzone(
        const Id: string,
        const Drop: function(array of string): TMsg,
        const Browse: Sys.Func<TMsg>?,
        const Settings: Dropzones.Options
      ):
        DropzoneWidget.Draw<TMsg>(Current, Id, Drop, Browse, Settings);
      when E.Element.AvatarUpload(
        const Id: string,
        const Name: string,
        const Path: string?,
        const Drop: function(string): TMsg,
        const Browse: Sys.Func<TMsg>?,
        const Diameter: float,
        const Enabled: bool
      ):
        AvatarUploadWidget.Draw<TMsg>(Current, Id, Name, Path, Drop, Browse, Diameter, Enabled);
      when E.Element.SignaturePad(
        const Id: string,
        const Change: Sys.Func<Signatures.Signature, TMsg>?,
        const Settings: Signatures.Options
      ):
        SignaturePadWidget.Draw<TMsg>(Current, Id, Change, Settings);
      when E.Element.Knob(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Knobs.Options
      ):
        KnobWidget.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.Fader(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Faders.Options
      ):
        FaderWidget.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.RulerSlider(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Rulers.Options
      ):
        RulerWidget.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.HistogramSlider(
        const Id: string, const Label: string, const Bins: array of float,
        const Value: RangeSliders.Interval, const Minimum: float, const Maximum: float,
        const Change: function(RangeSliders.Interval): TMsg, const Settings: Histograms.Options
      ):
        HistogramWidget.Draw<TMsg>(
          Current,
          Id,
          Label,
          Bins,
          Value,
          Minimum,
          Maximum,
          Change,
          Settings
        );
      when E.Element.ChipAction(
        const Id: string,
        const Label: string,
        const Selected: bool,
        const Change: function(bool): TMsg,
        const Icon: string,
        const Enabled: bool
      ):
        Chip.Draw<TMsg>(Current, Id, Label, Selected, Change, Icon, Enabled);
      when E.Element.RatingAction(
        const Id: string, const Label: string, const Value: int, const Change: function(int): TMsg,
        const Maximum: int, const Enabled: bool
      ):
        Rating.Draw<TMsg>(Current, Id, Label, Value, Change, Maximum, Enabled);
      when E.Element.SplitAction(
        const Id: string, const Label: string, const Message: TMsg,
        const Items: array of Split.Item<TMsg>, const Settings: Split.Options
      ):
        SplitButton.Draw<TMsg>(Current, Id, Label, Message, Items, Settings);
      when E.Element.Contextual(
        const Id: string,
        const Child: E.Element<TMsg>,
        const Entries: array of Menus.Entry<TMsg>,
        const Enabled: bool
      ):
        Visit(Child, Current, Horizontal, Align);
        ContextMenu.Draw<TMsg>(Current, Id, Entries, Enabled);
        return;
      when E.Element.Hinted(
        const Child: E.Element<TMsg>,
        const Caption: string,
        const Shortcut: string
      ):
        Visit(Child, Current, Horizontal, Align);
        TooltipWidget.Attach<TMsg>(Current, Caption, Shortcut);
        return;
      when E.Element.Accordion(
        const Id: string, const Title: string, const Open: bool,
        const OnChange: function(bool): TMsg, const Content: E.Element<TMsg>, const Enabled: bool
      ):
        DisclosureWidget.Draw<TMsg>(
          Current, Id, Title, Open, OnChange, Content, false,
          new ExpandableCards.Options(Enabled := Enabled), Visit
        );
      when E.Element.ExpandableCard(
        const Id: string,
        const Title: string,
        const Open: bool,
        const OnChange: function(bool): TMsg,
        const Content: E.Element<TMsg>,
        const Settings: ExpandableCards.Options
      ):
        DisclosureWidget.Draw<TMsg>(
          Current,
          Id,
          Title,
          Open,
          OnChange,
          Content,
          true,
          Settings,
          Visit
        );
      when E.Element.ExpandableText(
        const Id: string, const Text: string, const Settings: ExpandableTexts.Options,
        const OnToggle: Sys.Func<TMsg>?
      ):
        ExpandableTextWidget.Draw<TMsg>(Current, Id, Text, Settings, OnToggle);
      when E.Element.LinkAction(
        const Id: string,
        const Label: string,
        const Activate: TMsg,
        const Enabled: bool
      ):
        LinkWidget.Draw<TMsg>(Current, Id, Label, Activate, Enabled);
      when E.Element.Avatar(const Id: string, const Name: string, const Settings: Avatars.Options):
        AvatarWidget.Draw<TMsg>(Current, Id, Name, Settings);
        // CUI's avatar centers itself on the cross axis inside its row.
        return;
      when E.Element.HoverCard(
        const Id: string,
        const Trigger: E.Element<TMsg>,
        const Content: E.Element<TMsg>,
        const Settings: HoverCards.Options
      ):
        HoverCardWidget.Draw<TMsg>(
          Current,
          Id,
          Trigger,
          Content,
          Settings,
          Horizontal,
          Align,
          Visit
        );
        return;
      else
        DrawDisclosureAndData(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawDisclosureAndData(Node: E.Element<TMsg>; Current: C.State<TMsg>; Horizontal: bool; Align: L.Alignment);
  begin
    case Node of
      when E.Element.Popover(
        const Id: string, const Trigger: E.Element<TMsg>, const Content: E.Element<TMsg>,
        const Open: bool, const Dismiss: TMsg, const Settings: Popovers.Options
      ):
        PopoverWidget.Draw<TMsg>(
          Current,
          Id,
          Trigger,
          Content,
          Open,
          Dismiss,
          Settings,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.ConfirmPopover(
        const Id: string, const Trigger: E.Element<TMsg>, const Open: bool,
        const Settings: ConfirmPopovers.Options, const Confirm: TMsg, const Dismiss: TMsg
      ):
        ConfirmPopoverWidget.Draw<TMsg>(
          Current,
          Id,
          Trigger,
          Open,
          Settings,
          Confirm,
          Dismiss,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.ReactionGroup(
        const Id: string, const Items: array of Reactions.Item,
        const Change: function(int, Reactions.Item): TMsg, const Enabled: bool
      ):
        ReactionsWidget.Draw<TMsg>(Current, Id, Items, Change, Enabled);
      when E.Element.SpeedDialAction(
        const Id: string, const Items: array of Speed.Item, const Choose: function(int): TMsg,
        const Settings: Speed.Options
      ):
        SpeedWidget.Draw<TMsg>(Current, Id, Items, Choose, Settings);
      when E.Element.SwipeRow(
        const Id: string, const Content: E.Element<TMsg>, const Left: array of Swipe.Item,
        const Right: array of Swipe.Item, const Choose: function(Swipe.Side, int): TMsg,
        const Settings: Swipe.Options
      ):
        SwipeWidget.Draw<TMsg>(Current, Id, Content, Left, Right, Choose, Settings, Visit);
      when E.Element.AccountMenu(
        const Id: string, const Name: string, const Entries: array of Menus.Entry<TMsg>,
        const Settings: UserMenus.Options
      ):
        UserMenuWidget.Draw<TMsg>(Current, Id, Name, Entries, Settings);
      when E.Element.Dropdown(
        const Id: string,
        const Label: string,
        const Entries: array of Menus.Entry<TMsg>,
        const Settings: Menus.Options
      ):
        DropdownMenu.Draw<TMsg>(Current, Id, Label, Entries, Settings);
      when E.Element.Sidebar(
        const Id: string,
        const Sections: array of N.Section<TMsg>,
        const Active: string?,
        const Enabled: bool
      ):
        Sidebar.Draw<TMsg>(Current, Id, Sections, Active, Enabled);
      when E.Element.ButtonGroup(const Children: array of E.Element<TMsg>):
        ButtonGroup.Draw<TMsg>(Current, Children, Visit);
      when E.Element.ActionFooter(const Children: array of E.Element<TMsg>):
        ActionFooterWidget.Draw<TMsg>(Current, Children, Visit);
      when E.Element.ListItem(
        const Id: string,
        const Title: string,
        const Activate: Sys.Func<TMsg>?,
        const Settings: ListItems.Options
      ):
        ListItemWidget.Draw<TMsg>(Current, Id, Title, Activate, Settings);
      when E.Element.TreeNode(
        const Id: string,
        const Label: string,
        const Open: bool?,
        const Children: array of E.Element<TMsg>,
        const Change: Sys.Func<bool, TMsg>?,
        const Activate: Sys.Func<TMsg>?,
        const Settings: Trees.Options
      ):
        TreeWidget.Draw<TMsg>(
          Current,
          Id,
          Label,
          Open,
          Children,
          Change,
          Activate,
          Settings,
          Visit
        );
      when E.Element.Table(
        const Id: string,
        const Columns: array of Tables.Column,
        const Rows: array of Tables.Row<TMsg>,
        const Order: Tables.Sort?,
        const OnSort: Sys.Func<Tables.Sort, TMsg>?,
        const OnSelect: Sys.Func<string, TMsg>?,
        const Settings: Tables.Options
      ):
        TableWidget.Draw<TMsg>(
          Current,
          Id,
          Columns,
          Rows,
          Order,
          OnSort,
          OnSelect,
          Settings,
          Visit
        );
      when E.Element.VirtualList(
        const Id: string, const Count: int, const RowHeight: float, const Height: L.Extent,
        const Build: function(int): E.Element<TMsg>
      ):
        VirtualWidget.Draw<TMsg>(Current, Id, Count, RowHeight, Height, Build, Visit);
      when E.Element.FilterBar(
        const Id: string,
        const Fields: array of Filters.Field,
        const Value: Filters.Value,
        const Change: function(Filters.Value): TMsg,
        const Capacity: int,
        const Enabled: bool
      ):
        FilterWidget.Draw<TMsg>(Current, Id, Fields, Value, Change, Capacity, Enabled);
      when E.Element.DataGrid(
        const Id: string, const Columns: array of DataGrids.Column, const Count: int,
        const Build: function(int): DataGrids.Row<TMsg>, const Value: DataGrids.Value,
        const Change: function(DataGrids.Value): TMsg, const Settings: DataGrids.Options
      ):
        GridDataWidget.Draw<TMsg>(
          Current,
          Id,
          Columns,
          Count,
          Build,
          Value,
          Change,
          Settings,
          Visit
        );
      when E.Element.TreeCell(
        const Id: string, const Label: string, const Depth: int, const Open: bool?,
        const Change: Sys.Func<bool, TMsg>?, const Icon: string
      ):
        TreeTableWidget.Cell<TMsg>(Current, Id, Label, Depth, Open, Change, Icon);
      when E.Element.TreeTable(
        const Id: string, const Columns: array of DataGrids.Column,
        const Nodes: array of TreeTables.Node, const Cursor: int, const Order: Tables.Sort?,
        const Change: function(TreeTables.Change): TMsg, const Settings: TreeTables.Options
      ):
        TreeTableWidget.Draw<TMsg>(Current, Id, Columns, Nodes, Cursor, Order, Change, Settings);
      when E.Element.ReorderableList(
        const Id: string, const Items: array of E.Element<TMsg>, const Order: array of int,
        const Change: function(array of int): TMsg, const Enabled: bool
      ):
        ReorderWidget.Draw<TMsg>(Current, Id, Items, Order, Change, Enabled, Visit);
      when E.Element.CodeBlock(
        const Id: string,
        const Code: string,
        const Settings: CodeBlocks.Options
      ):
        CodeBlockWidget.Draw<TMsg>(Current, Id, Code, Settings);
      when E.Element.JsonView(
        const Id: string,
        const Json: string,
        const Settings: JsonViews.Options
      ):
        JsonViewWidget.Draw<TMsg>(Current, Id, Json, Settings);
      when E.Element.Readout(
        const Id: string,
        const Label: string,
        const Value: string,
        const Settings: Readouts.Options
      ):
        ReadoutWidget.Draw<TMsg>(Current, Id, Label, Value, Settings);
      else
        DrawChartsAndSections(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawChartsAndSections(Node: E.Element<TMsg>; Current: C.State<TMsg>; Horizontal: bool; Align: L.Alignment);
  begin
    case Node of
      when E.Element.DotDisplay(
        const Id: string,
        const Text: string,
        const Settings: DotDisplays.Options
      ):
        DotDisplayWidget.Draw<TMsg>(Current, Id, Text, Settings);
      when E.Element.DotChart(
        const Id: string, const Bands: array of DotCharts.Series, const Count: int,
        const Activate: Sys.Func<DotCharts.Hit, TMsg>?, const Settings: DotCharts.Options
      ):
        DotChartWidget.Draw<TMsg>(Current, Id, Bands, Count, Activate, Settings);
      when E.Element.EventTrack(
        const Id: string, const Value: EventTracks.Value,
        const Change: function(EventTracks.Change): TMsg, const Settings: EventTracks.Options
      ):
        EventTrackWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
      when E.Element.PathBar(
        const Id: string,
        const Value: PathBars.Value,
        const Change: function(PathBars.Event): TMsg,
        const Settings: PathBars.Options
      ):
        PathBarWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
      when E.Element.FileBrowser(
        const Id: string,
        const Folder: string,
        const Change: function(FileBrowsers.Event): TMsg,
        const Settings: FileBrowsers.Options
      ):
        FileBrowserWidget.Draw<TMsg>(Current, Id, Folder, Change, Settings);
      when E.Element.FilePicker(
        const Id: string,
        const Base: E.Element<TMsg>?,
        const Open: bool,
        const Change: function(FilePickers.Event): TMsg,
        const Settings: FilePickers.Options
      ):
        FilePickerWidget.Draw<TMsg>(
          Current,
          Id,
          Base,
          Open,
          Change,
          Settings,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.WeekCalendar(
        const Id: string,
        const Value: WeekCalendars.Value,
        const Change: function(WeekCalendars.Event): TMsg,
        const Settings: WeekCalendars.Options
      ):
        WeekCalendarWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
      when E.Element.MonthCalendar(
        const Id: string,
        const Value: MonthCalendars.Value,
        const Change: function(MonthCalendars.Event): TMsg,
        const Settings: MonthCalendars.Options
      ):
        MonthCalendarWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
      when E.Element.Gantt(
        const Id: string,
        const Value: Gantts.Value,
        const Change: function(Gantts.Event): TMsg,
        const Settings: Gantts.Options
      ):
        GanttWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
      when E.Element.Kanban(
        const Id: string,
        const Columns: array of Kanbans.Column<TMsg>,
        const Change: function(Kanbans.Event): TMsg,
        const Settings: Kanbans.Options
      ):
        KanbanWidget.Draw<TMsg>(Current, Id, Columns, Change, Settings, Visit);
        return;
      when E.Element.StatusTag(
        const Id: string,
        const Value: StatusTags.Value,
        const Remove: Sys.Func<TMsg>?,
        const Settings: StatusTags.Options
      ):
        StatusTagWidget.Draw<TMsg>(Current, Id, Value, Remove, Settings);
        return;
      when E.Element.RatioSlider(
        const Id: string,
        const Value: RatioSliders.Value,
        const Change: function(float): TMsg,
        const Settings: RatioSliders.Options
      ):
        RatioSliderWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
        return;
      when E.Element.GradientSlider(
        const Id: string,
        const Value: GradientSliders.Value,
        const Change: function(GradientSliders.Event): TMsg,
        const Settings: GradientSliders.Options
      ):
        GradientSliderWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
        return;
      when E.Element.StepSlider(
        const Id: string,
        const Value: StepSliders.Value,
        const Change: function(StepSliders.Event): TMsg,
        const Settings: StepSliders.Options
      ):
        StepSliderWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
        return;
      when E.Element.PaletteStrip(
        const Id: string,
        const Value: PaletteStrips.Value,
        const Change: function(PaletteStrips.Event): TMsg,
        const Settings: PaletteStrips.Options
      ):
        PaletteStripWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
        return;
      when E.Element.AspectPicker(
        const Id: string,
        const Value: AspectPickers.Value,
        const Change: function(int): TMsg,
        const Settings: AspectPickers.Options
      ):
        AspectPickerWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
        return;
      when E.Element.OptionAction(
        const Id: string,
        const Value: OptionActions.Value,
        const Change: function(OptionActions.Event): TMsg,
        const Settings: OptionActions.Options
      ):
        OptionActionWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
        return;
      when E.Element.SeedField(
        const Id: string,
        const Value: SeedFields.Value,
        const Change: function(SeedFields.Event): TMsg,
        const Settings: SeedFields.Options
      ):
        SeedFieldWidget.Draw<TMsg>(Current, Id, Value, Change, Settings);
        return;
      when E.Element.ShimmerText(
        const Id: string,
        const Text: string,
        const Settings: Motion.TextOptions
      ):
        ShimmerTextWidget.Draw<TMsg>(Current, Id, Text, Settings);
      when E.Element.Typewriter(
        const Id: string,
        const Text: string,
        const Replay: int,
        const Settings: Motion.TextOptions,
        const OnComplete: Sys.Func<TMsg>?
      ):
        TypewriterWidget.Draw<TMsg>(Current, Id, Text, Replay, Settings, OnComplete);
      when E.Element.TextReveal(
        const Id: string,
        const Text: string,
        const Replay: int,
        const Settings: Motion.TextOptions
      ):
        TextRevealWidget.Draw<TMsg>(Current, Id, Text, Replay, Settings);
      when E.Element.WordRotate(
        const Id: string,
        const Words: array of string,
        const Interval: float,
        const Settings: Motion.TextOptions
      ):
        WordRotateWidget.Draw<TMsg>(Current, Id, Words, Interval, Settings);
      when E.Element.NumberRoll(
        const Id: string,
        const Text: string,
        const Settings: Motion.TextOptions
      ):
        NumberRollWidget.Draw<TMsg>(Current, Id, Text, Settings);
      when E.Element.GradientText(
        const Id: string,
        const Text: string,
        const Settings: GradientTexts.Options
      ):
        GradientTextWidget.Draw<TMsg>(Current, Id, Text, Settings);
      when E.Element.Spotlight(
        const Id: string,
        const Children: array of E.Element<TMsg>,
        const Settings: Spotlights.Options
      ):
        SpotlightWidget.Draw<TMsg>(Current, Id, Children, Settings, Visit);
      when E.Element.Loader(
        const Id: string,
        const Style: Loaders.Animation,
        const Settings: Loaders.Options
      ):
        LoaderWidget.Draw<TMsg>(Current, Id, Style, Settings);
      when E.Element.Dock(
        const Id: string,
        const Entries: array of Docks.Entry<TMsg>,
        const Settings: Docks.Options
      ):
        DockWidget.Draw<TMsg>(Current, Id, Entries, Settings);
        return;
      when E.Element.ControlTile(
        const Id: string,
        const Label: string,
        const On: bool,
        const Change: function(bool): TMsg,
        const Settings: ControlTiles.Options
      ):
        ControlTileWidget.Draw<TMsg>(Current, Id, Label, On, Change, Settings);
        return;
      when E.Element.NowPlaying(
        const Id: string,
        const Model: NowPlaying.Value,
        const Change: function(NowPlaying.Event): TMsg,
        const Settings: NowPlaying.Options
      ):
        NowPlayingWidget.Draw<TMsg>(Current, Id, Model, Change, Settings);
      when E.Element.Waveform(
        const Id: string,
        const Peaks: array of float,
        const Progress: float?,
        const Change: Sys.Func<float, TMsg>?,
        const Settings: Waveforms.Options
      ):
        WaveformWidget.Draw<TMsg>(Current, Id, Peaks, Progress, Change, Settings);
      when E.Element.TabBar(
        const Id: string,
        const Items: array of TabBars.Item,
        const Selected: int,
        const Change: function(int): TMsg,
        const Settings: TabBars.Options
      ):
        TabBarWidget.Draw<TMsg>(Current, Id, Items, Selected, Change, Settings);
      when E.Element.CommandPalette(
        const Id: string,
        const Base: E.Element<TMsg>,
        const Open: bool,
        const Commands: array of Palettes.Command<TMsg>,
        const Change: function(bool): TMsg,
        const Shortcut: bool
      ):
        PaletteWidget.Draw<TMsg>(
          Current,
          Id,
          Base,
          Open,
          Commands,
          Change,
          Shortcut,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.Grid(const Settings: Grids.Options, const Children: array of E.Element<TMsg>):
        GridWidget.Draw<TMsg>(Current, Settings, Children, Visit);
      when E.Element.Card(
        const Id: string, const Children: array of E.Element<TMsg>, const Settings: Cards.Options,
        const Activate: Sys.Func<TMsg>?
      ):
        CardWidget.Draw<TMsg>(Current, Id, Children, Settings, Activate, Visit);
      when E.Element.Badge(const Id: string, const Text: string, const Settings: Badges.Options):
        BadgeWidget.Draw<TMsg>(Current, Id, Text, Settings);
      when E.Element.Sankey(
        const Id: string,
        const Nodes: array of Sankeys.Node,
        const Links: array of Sankeys.Link,
        const Settings: Sankeys.Options,
        const OnActivate: Sys.Func<Sankeys.Selection, TMsg>?
      ):
        SankeyWidget.Draw<TMsg>(Current, Id, Nodes, Links, Settings, OnActivate);
      when E.Element.BarList(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: BarLists.Options,
        const OnActivate: Sys.Func<int, TMsg>?
      ):
        BarListWidget.Draw<TMsg>(Current, Id, Items, Settings, OnActivate);
      when E.Element.ActivityRings(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: ActivityRings.Options,
        const OnActivate: Sys.Func<int, TMsg>?
      ):
        ActivityRingsWidget.Draw<TMsg>(Current, Id, Items, Settings, OnActivate);
      when E.Element.ScatterChart(
        const Id: string,
        const Series: array of ScatterCharts.Series,
        const Settings: ScatterCharts.Options,
        const OnActivate: Sys.Func<ScatterCharts.PointIndex, TMsg>?
      ):
        ScatterChartWidget.Draw<TMsg>(Current, Id, Series, Settings, OnActivate);
      when E.Element.RadialGauge(
        const Id: string,
        const Value: float,
        const Minimum: float,
        const Maximum: float,
        const Settings: RadialGauges.Options
      ):
        RadialGaugeWidget.Draw<TMsg>(Current, Id, Value, Minimum, Maximum, Settings);
      when E.Element.Candlestick(
        const Id: string,
        const Candles: array of Candlesticks.Candle,
        const Settings: Candlesticks.Options,
        const OnCursorChange: Sys.Func<int, TMsg>?
      ):
        CandlestickWidget.Draw<TMsg>(Current, Id, Candles, Settings, OnCursorChange);
      when E.Element.Heatmap(
        const Id: string,
        const Values: array of float,
        const Rows: int,
        const Columns: int,
        const Settings: Heatmaps.Options,
        const OnActivate: Sys.Func<Heatmaps.Cell, TMsg>?
      ):
        HeatmapWidget.Draw<TMsg>(Current, Id, Values, Rows, Columns, Settings, OnActivate);
      when E.Element.CalendarHeatmap(
        const Id: string,
        const Start: Sys.DateOnly,
        const Values: array of float,
        const Settings: CalendarHeatmaps.Options,
        const OnActivate: Sys.Func<Sys.DateOnly, TMsg>?
      ):
        CalendarHeatmapWidget.Draw<TMsg>(Current, Id, Start, Values, Settings, OnActivate);
      when E.Element.Treemap(
        const Id: string,
        const Items: array of Charts.Item,
        const Selected: int,
        const OnSelect: Sys.Func<int, TMsg>?,
        const Settings: Treemaps.Options
      ):
        TreemapWidget.Draw<TMsg>(Current, Id, Items, Selected, OnSelect, Settings);
      when E.Element.RadarChart(
        const Id: string,
        const Series: array of Charts.Series,
        const Axes: array of string,
        const Settings: RadarCharts.Options,
        const OnActivate: Sys.Func<int, TMsg>?
      ):
        RadarChartWidget.Draw<TMsg>(Current, Id, Series, Axes, Settings, OnActivate);
      when E.Element.Funnel(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: Funnels.Options,
        const OnActivate: Sys.Func<int, TMsg>?
      ):
        FunnelWidget.Draw<TMsg>(Current, Id, Items, Settings, OnActivate);
      when E.Element.SplitBar(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: SplitBars.Options,
        const OnActivate: Sys.Func<int, TMsg>?
      ):
        SplitBarWidget.Draw<TMsg>(Current, Id, Items, Settings, OnActivate);
      when E.Element.Waffle(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: Waffles.Options,
        const OnActivate: Sys.Func<int, TMsg>?
      ):
        WaffleWidget.Draw<TMsg>(Current, Id, Items, Settings, OnActivate);
      when E.Element.LineChart(
        const Id: string,
        const Series: array of Charts.Series,
        const Settings: Charts.Options
      ):
        LineChartWidget.Draw<TMsg>(Current, Id, Series, Settings);
      when E.Element.BarChart(
        const Id: string,
        const Series: array of Charts.Series,
        const Settings: Charts.Options
      ):
        BarChartWidget.Draw<TMsg>(Current, Id, Series, Settings);
      when E.Element.DonutChart(
        const Id: string,
        const Values: array of float,
        const Labels: array of string,
        const Settings: Donuts.Options
      ):
        DonutChartWidget.Draw<TMsg>(Current, Id, Values, Labels, Settings);
      when E.Element.Gauge(
        const Id: string,
        const Label: string,
        const Value: float,
        const Diameter: float
      ):
        GaugeWidget.Draw<TMsg>(Current, Id, Label, Value, Diameter);
      when E.Element.PatternMeter(
        const Id: string,
        const Parts: array of Patterns.Part,
        const Settings: Patterns.Options
      ):
        PatternMeterWidget.Draw<TMsg>(Current, Id, Parts, Settings);
      when E.Element.Metric(
        const Id: string,
        const Label: string,
        const Reading: string,
        const Settings: Metrics.Options
      ):
        MetricWidget.Draw<TMsg>(Current, Id, Label, Reading, Settings);
      when E.Element.AvatarGroup(
        const Id: string,
        const Names: array of string,
        const Settings: AvatarGroups.Options
      ):
        AvatarGroupWidget.Draw<TMsg>(Current, Id, Names, Settings);
      when E.Element.EmptyState(
        const Id: string,
        const Title: string,
        const Settings: EmptyStates.Options,
        const Action: Sys.Func<TMsg>?
      ):
        EmptyStateWidget.Draw<TMsg>(Current, Id, Title, Settings, Action);
      when E.Element.Tour(
        const Id: string,
        const Base: E.Element<TMsg>,
        const Steps: array of Tours.Step,
        const CurrentStep: int,
        const Changed: function(Tours.Change): TMsg,
        const Settings: Tours.Options
      ):
        Visit(Base, Current, Horizontal, Align);
        TourWidget.Draw<TMsg>(Current, Id, Steps, CurrentStep, Changed, Settings);
        return;
      else
        DrawLayout(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawLayout(Node: E.Element<TMsg>; Current: C.State<TMsg>; Horizontal: bool; Align: L.Alignment);
  begin
    case Node of
      when E.Element.Spacer:
        Current.Window.Spacer();
      when E.Element.Gap(const Distance: L.Measure):
        Current.Window.Gap(Size.Measure(Distance));
      when E.Element.Layered(const Children: array of E.Element<TMsg>, const Settings: L.Flow):
        Current.Window.BeginLayers(
          cast<int>(Settings.Align),
          cast<int>(Settings.Justify),
          Settings.Clip ?? false
        );
        Size.Container(Current.Window, Settings, true);
        for Child: E.Element<TMsg> in Children do
          Visit(Child, Current, false, Settings.Align);
        end for;

        Current.Window.EndGroup();
      when E.Element.Stack(
        const Children: array of E.Element<TMsg>,
        const Row: bool,
        const Settings: L.Flow
      ):
        Current.Window.BeginGroup(
          Row,
          Size.Spacing(Settings.Padding),
          Size.Spacing(Settings.Gap),
          cast<int>(Settings.Align),
          false,
          Settings.Wrap, Settings.Clip ?? not Settings.Wrap, cast<int>(Settings.Justify)
        );
        Size.Container(Current.Window, Settings);
        for Child: E.Element<TMsg> in Children do
          Visit(Child, Current, Row, Settings.Align);
        end for;

        Current.Window.EndGroup();
      when E.Element.Sized(const Child: E.Element<TMsg>, const Settings: L.Flex):
        Visit(Child, Current, Horizontal, Align);
        Size.Apply(Current.Window, Settings, Horizontal, Align);
        return;
      when E.Element.Styled(const Child: E.Element<TMsg>, const Role: S.Role):
        Visit(Child, Current, Horizontal, Align);
        Current.Window.StyleLast(cast<int>(Role));
        return;
      when E.Element.Framed(const Child: E.Element<TMsg>, const Title: string):
        Current.Window.BeginGroup(false, 8, 8, 0, true);
        if Title <> '' then
          Current.Window.Text(Title);
          Current.Labels.Add(Title);
        end if;

        Visit(Child, Current, false, L.Alignment.Stretch);
        Current.Window.EndGroup();
      when E.Element.TableOfContents(
        const Id: string, const ScrollId: string, const Items: array of Toc.Item,
        const Changed: Sys.Func<string, TMsg>?, const Enabled: bool
      ):
        TocWidget.Draw<TMsg>(Current, Id, ScrollId, Items, Changed, Enabled);
      when E.Element.ScrollAnchor(const Id: string):
        AnchorWidget.Draw<TMsg>(Current, Id);
      when E.Element.Scroll(
        const Id: string,
        const Child: E.Element<TMsg>,
        const Position: L.ScrollPosition?,
        const Scroll: Sys.Func<L.ScrollChange, TMsg>?,
        const Bar: bool, const FadeEdges: bool, const HorizontalScroll: bool
      ):
        const Token: string := C.Token('scroll', Id);
        var Before: float := 0;
        var Maximum: float := 0;
        Current.Window.ScrollState(Token, -1, 0, out Before, out Maximum);
        var Mode: int := -1;
        var Offset: float := 0;
        case Position of
          when L.ScrollPosition.Start:
            Mode := 0;
          when L.ScrollPosition.End:
            Mode := 1;
          when L.ScrollPosition.Offset(const Distance: L.Measure):
            Mode := 0;
            Offset := Size.Measure(Distance);
          else
        end case;

        Current.Window.ScrollState(Token, Mode, Offset, out Before, out Maximum);
        Current.Window.ScrollState(Token, -1, 0, out Before, out Maximum);
        Current.Window.BeginViewport(Token, Bar, Current.AcceptInput, FadeEdges, HorizontalScroll);
        Visit(Child, Current, false, L.Alignment.Stretch);
        Current.Window.EndScroll();
        var After: float := 0;
        Current.Window.ScrollState(Token, -1, 0, out After, out Maximum);
        if Current.AcceptInput and After <> Before then
          case Scroll of
            when is Sys.Func<L.ScrollChange, TMsg> as Changed:
              const Units: L.Measure := L.Measure.Logical(cast<int>(After));
              Current.Messages.Add(
                Changed.Invoke(
                  new L.ScrollChange(
                    L.ScrollPosition.Offset(Units),
                    Units,
                    L.Measure.Logical(cast<int>(Maximum))
                  )
                )
              );
            else
          end case;
        end if;

        C.Track<TMsg>(
          Current,
          new App.Control(
            Id,
            '',
            'scroll',
            new Cui.CuiRectangle(),
            Current.AcceptInput,
            Value := After.ToString()
          )
        );
      when E.Element.Sheet(
        const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>,
        const Open: bool, const Settings: Sheets.Options, const Dismiss: TMsg
      ):
        Sheet.Draw<TMsg>(
          Current,
          Id,
          Base,
          Content,
          Open,
          Settings,
          Dismiss,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.Dialog(
        const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>,
        const Open: bool, const Settings: Dialogs.Options, const Dismiss: TMsg
      ):
        DialogWidget.Draw<TMsg>(
          Current,
          Id,
          Base,
          Content,
          Open,
          Settings,
          Dismiss,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.Deferred(const Id: string, _):
        Visit(Current.Prepared.Subviews[Id].Tree, Current, Horizontal, Align);
        return;
      else
        raise new Sys.InvalidOperationException('An invalid target widget reached GUI drawing.');
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;
begin
  State.Window.BeginHostView();
  State.Window.BeginGroup(false, 0, 0, 0, false);
  Visit(State.Prepared.Tree, State, false, L.Alignment.Stretch);
  State.Window.EndGroup();
  State.Window.SizeLast(false, 1, 0, 0, -1, 1, 0);
end procedure;

end unit;
