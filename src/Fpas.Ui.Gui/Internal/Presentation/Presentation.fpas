  procedure DrawVoiceAndChat(Node: E.Element<TMsg>; Current: C.State<TMsg>; Horizontal: bool; Align: L.Alignment);
  begin
    case Node of
      when E.Element.Ticker(
        const Id: string,
        const Items: array of Tickers.Item,
        const Settings: Tickers.Options
      ):
        TickerWidget.Draw<TMsg>(Current, Id, Items, Settings);
      when E.Element.StatusSpinner(
        const Id: string,
        const CurrentStatus: Status.Status,
        const Settings: StatusSpinners.Options
      ):
        StatusSpinnerWidget.Draw<TMsg>(Current, Id, CurrentStatus, Settings);
      when E.Element.SkeletonGroup(
        const Id: string,
        const Children: array of E.Element<TMsg>,
