 as StatusButton, Fpas.Ui.Widgets.Actions.ConfirmButtons as Confirms, Fpas.Ui.Gui.Internal.Widgets.Actions.ConfirmButton as ConfirmButton, Fpas.Ui.Widgets.Actions.SplitButtons as Split, Fpas.Ui.Gui.Internal.Widgets.Actions.SplitButton as SplitButton, Fpas.Ui.Widgets.Actions.HoldButtons as Holds, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Layout.Sizing as Size, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Navigation.Navigation as N, Fpas.Ui.Gui.Internal.Widgets.Navigation.Sidebar as Sidebar, Fpas.Ui.Widgets.Overlays.Sheets as Sheets, Fpas.Ui.Gui.Internal.Widgets.Overlays.Sheet as Sheet, Fpas.Ui.Widgets.Actions.Buttons as B, Fpas.Ui.Gui.Internal.Widgets.Actions.Button as Button, Fpas.Ui.Gui.Internal.Widgets.Actions.ButtonGroup as ButtonGroup, Fpas.Ui.Gui.Internal.Widgets.Actions.CopyButton as CopyButton, Fpas.Ui.Gui.Internal.Widgets.Actions.HoldButton as HoldButton, Fpas.Ui.Widgets.Actions.IconButtons as Icons, Fpas.Ui.Gui.Internal.Widgets.Actions.IconButton as IconButton, Fpas.Ui.Graphics as G, System as Sys, System.Collections.Generic as Generic;

// Draws a prepared tree and gathers messages without running Update or effects.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `State`: Frame context and retained resources.
public procedure Draw<TMsg>(State: C.State<TMsg>);
  // Keep recursive layout visits out of the large widget dispatch frames.
  procedure Visit(Node: E.Element<TMsg>; Current: C.State<TMsg>; Horizontal: bool; Align: L.Alignment);
  begin
    DrawTextAndEditors(Node, Current, Horizontal, Align);
  end procedure;

  procedure DrawTextAndEditors(Node: E.Element<TMsg>; Current: C.State<TMsg>; Horizontal: bool; Align: L.Alignment);
  begin
    case Node of
      when E.Element.FormattedText(
        const Value: string,
        const Font: Motion.Font,
        const FontSize: float,
        const Tint: G.Color
      ):
        Current.Window.FormattedText(Value, cast<int>(Font), FontSize, CreativeParts.Pack(Tint));
        Current.Labels.Add(Value);
      when E.Element.Label(const Value: string):
        Current.Window.Text(Value);
        Current.Labels.Add(Value);
      when E.Element.InlineEdit(
        const Id: string,
        const Value: string,
        const Changed: function(string): TMsg,
        const Settings: InlineEdits.Options
      ):
        InlineWidget.Draw<TMsg>(Current, Id, Value, Changed, Settings);
      when E.Element.ScrubField(
        const Id: string,
        const Label: string,
        const Value: float,
        const Minimum: float,
        const Maximum: float,
        const Changed: function(float): TMsg,
        const Settings: ScrubFields.Options
      ):
        ScrubWidget.Draw<TMsg>(Current, Id, Label, Value, Minimum, Maximum, Changed, Settings);
      when E.Element.MoneyField(
        const Id: string,
        const Value: double,
        const Changed: function(double): TMsg,
        const Settings: MoneyFields.Options
      ):
        MoneyWidget.Draw<TMsg>(Current, Id, Value, Changed, Settings);
      when E.Element.ShortcutRecorder(
        const Id: string,
        const Value: RecorderKeys.Combination,
