        SkeletonWidget.Draw<TMsg>(Current, Id, Width, Height);
      when E.Element.TimelineItem(
        const Id: string,
        const Title: string,
        const Settings: Timeline.Options
      ):
        TimelineWidget.Draw<TMsg>(Current, Id, Title, Settings);
      when E.Element.ProgressRing(
        const Id: string, const Label: string, const Value: float, const Diameter: float
      ):
        RingWidget.Draw<TMsg>(Current, Id, Label, Value, Diameter);
      when E.Element.LevelMeter(
        const Id: string,
        const Peaks: array of float,
        const Settings: Levels.Options,
        const Notify: Sys.Func<TMsg>?
      ):
        LevelMeterWidget.Draw<TMsg>(Current, Id, Peaks, Settings, Notify);
      when E.Element.Meter(
        const Id: string, const Label: string, const Used: float,
