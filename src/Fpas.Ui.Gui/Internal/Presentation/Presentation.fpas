        const Id: string,
        const Users: array of Presences.User,
        const Settings: Presences.Options
      ):
        PresenceWidget.Draw<TMsg>(Current, Id, Users, Settings);
      when E.Element.Counter(
        const Id: string,
        const Value: double,
        const Settings: Counters.Options
      ):
        CounterWidget.Draw<TMsg>(Current, Id, Value, Settings);
      else
        DrawVoiceAndChat(Node, Current, Horizontal, Align);
        return;
