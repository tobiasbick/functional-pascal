      ):
        ImageCropperWidget.Draw<TMsg>(Current, Id, Image, Crop, Changed, Settings);
      when E.Element.ImageCompare(
        const Id: string,
        const Before: Media.Source,
        const After: Media.Source,
        const Position: float,
        const Changed: function(float): TMsg,
        const Settings: ImageComparisons.Options
      ):
        ImageCompareWidget.Draw<TMsg>(Current, Id, Before, After, Position, Changed, Settings);
      when E.Element.ChatMessage(
        const Id: string,
