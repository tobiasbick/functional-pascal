// Draws a prepared tree and gathers messages without running Update or effects.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `State`: Frame context and retained resources.
public procedure Draw of TMsg(State: C.State of TMsg);
  // Keep recursive layout visits out of the large widget dispatch frames.
  procedure Visit(
    Node: E.Element of TMsg;
    Current: C.State of TMsg;
    Horizontal: bool;
    Align: L.Alignment
  );
  begin
    DrawTextAndEditors(Node, Current, Horizontal, Align);
  end procedure;

  procedure DrawTextAndEditors(
    Node: E.Element of TMsg;
    Current: C.State of TMsg;
    Horizontal: bool;
    Align: L.Alignment
  );
  begin
    case Node of
      when E.Element.FormattedText(
        const Value: string,
        const Font: Motion.Font,
        const FontSize: float,
        const Tint: G.Color
      ):
        Current.Window.FormattedText(Value, cast Font as int, FontSize, CreativeParts.Pack(Tint));
        Current.Labels.Add(Value);
      when E.Element.Label(const Value: string):
        Current.Window.Text(Value);
        Current.Labels.Add(Value);
      when E.Element.InlineEdit(
        const Id: string,
        const Value: string,
        const Changed: function(string): TMsg,
        const Settings: InlineEdits.Options
      ):
        InlineWidget.Draw of TMsg(Current, Id, Value, Changed, Settings);
      when E.Element.ScrubField(
        const Id: string,
        const Label: string,
        const Value: float,
        const Minimum: float,
        const Maximum: float,
        const Changed: function(float): TMsg,
        const Settings: ScrubFields.Options
      ):
        ScrubWidget.Draw of TMsg(Current, Id, Label, Value, Minimum, Maximum, Changed, Settings);
      when E.Element.MoneyField(
        const Id: string,
        const Value: decimal,
        const Changed: function(decimal): TMsg,
        const Settings: MoneyFields.Options
      ):
        MoneyWidget.Draw of TMsg(Current, Id, Value, Changed, Settings);
      when E.Element.ShortcutRecorder(
        const Id: string,
        const Value: RecorderKeys.Combination,
        const Changed: function(RecorderKeys.Combination): TMsg,
        const Settings: RecorderKeys.Options
      ):
        ShortcutWidget.Draw of TMsg(Current, Id, Value, Changed, Settings);
      when E.Element.ShortcutLabel(const Value: RecorderKeys.Combination):
        ShortcutWidget.Label of TMsg(Current, Value);
      when E.Element.TextField(
        const Id: string, const Value: string, const OnChange: function(string): TMsg,
        const Settings: TextFields.Options, const OnSubmit: Sys.Func of (string, TMsg)?
      ):
        TextFieldWidget.Draw of TMsg(Current, Id, Value, OnChange, Settings, OnSubmit);
      when E.Element.SearchField(
        const Id: string, const Value: string, const OnChange: function(string): TMsg,
        const Settings: SearchFields.Options, const OnSubmit: Sys.Func of (string, TMsg)?
      ):
        SearchFieldWidget.Draw of TMsg(Current, Id, Value, OnChange, Settings, OnSubmit);
      when E.Element.TextArea(
        const Id: string, const Value: string, const OnChange: function(string): TMsg,
        const Settings: TextAreas.Options, const OnSubmit: Sys.Func of (string, TMsg)?
      ):
        TextAreaWidget.Draw of TMsg(Current, Id, Value, OnChange, Settings, OnSubmit);
      when E.Element.TagInput(
        const Id: string,
        const Tags: array of string,
        const OnChange: function(array of string): TMsg,
        const Settings: TagInputs.Options
      ):
        TagWidget.Draw of TMsg(Current, Id, Tags, OnChange, Settings);
      when E.Element.OneTimeCodeInput(
        const Id: string, const Value: string, const OnChange: function(string): TMsg,
        const Settings: OneTimeCodes.Options, const OnComplete: Sys.Func of (string, TMsg)?
      ):
        CodeWidget.Draw of TMsg(Current, Id, Value, OnChange, Settings, OnComplete);
      when E.Element.PasswordStrengthMeter(const Id: string, const Password: string):
        StrengthWidget.Draw of TMsg(Current, Id, Password);
      when E.Element.Alert(
        const Id: string, const Title: string, const Settings: Alerts.Options,
        const Notify: (Sys.Func of TMsg)?
      ):
        AlertWidget.Draw of TMsg(Current, Id, Title, Settings, Notify);
      when E.Element.Problems(_, _, _, _), E.Element.Pipeline(
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.Keymap(
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.CommitGraph(_, _, _, _, _), E.Element.DependencyGraph(
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.NetworkWaterfall(_, _, _, _, _), E.Element.TraceViewer(
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.TestExplorer(
        _,
        _,
        _,
        _
      ), E.Element.StackTrace(_, _, _, _), E.Element.ResponseStatus(
        _,
        _,
        _,
        _,
        _
      ), E.Element.Uptime(_, _, _, _), E.Element.TimeHistogram(
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.Coverage(_, _, _, _), E.Element.Blame(
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.ApiExplorer(
        _,
        _,
        _,
        _,
        _
      ), E.Element.KeyValueEditor(_, _, _, _), E.Element.QueryBuilder(
        _,
        _,
        _,
        _,
        _
      ), E.Element.SchedulePicker(_, _, _, _), E.Element.RegexTester(
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.RequestBar(_, _, _, _, _), E.Element.FeatureFlags(_, _, _, _, _):
        DeveloperPresentation.Draw of TMsg(Current, Node);
      when E.Element.FormatBar(
        _,
        _,
        _,
        _
      ), E.Element.LiveCursors(
        _,
        _,
        _,
        _
      ), E.Element.PresencePill(
        _,
        _,
        _
      ), E.Element.SelectionRing(_, _, _), E.Element.CanvasControls(
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.ResultCard(_, _, _, _, _), E.Element.SelectionBar(
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.Toolbar(_, _, _, _), E.Element.NodeEditor(_, _, _, _, _, _):
        Canvas.Draw of TMsg(Current, Node, Visit);
      when E.Element.MenuBar(_, _, _), E.Element.StatusBar(_, _, _), E.Element.DocumentTabs(
        _,
        _,
        _,
        _,
        _
      ), E.Element.Dockspace(_, _, _, _), E.Element.SplitView(
        _,
        _,
        _,
        _,
        _,
        _
      ):
        Chrome.Draw of TMsg(Current, Node, Visit);
      when E.Element.Markdown(_, _, _, _), E.Element.CodeEditor(_, _, _, _), E.Element.DiffView(
        _,
        _,
        _,
        _,
        _,
        _
      ), E.Element.HexView(
        _,
        _,
        _,
        _,
        _
      ), E.Element.LogConsole(_, _, _, _), E.Element.Terminal(_, _, _, _, _):
        SourceTools.Draw of TMsg(Current, Node);
      when E.Element.PropertyInspector(_, _, _, _), E.Element.FlameGraph(
        _,
        _,
        _,
        _,
        _
      ), E.Element.CurveEditor(
        _,
        _,
        _,
        _,
        _
      ), E.Element.GradientEditor(_, _, _, _, _), E.Element.TimelineEditor(_, _, _, _, _):
        EditingTools.Draw of TMsg(Current, Node);
      when E.Element.NativeText(_, _), E.Element.Icon(
        _,
        _,
        _,
        _
      ), E.Element.Emoji(_, _), E.Element.Keycap(_), E.Element.Image(_, _, _), E.Element.Canvas(
        _,
        _,
        _,
        _,
        _,
        _,
        _, _
      ), E.Element.Veil(
        _,
        _,
        _,
        _,
        _
      ):
        Display.Draw of TMsg(Current, Node, Visit);
      when E.Element.VoiceWave(
        const Id: string,
        const Signal: Voice.Signal,
        const Progress: float?,
        const Changed: Sys.Func of (float, TMsg)?,
        const Settings: VoiceWaves.Options
      ):
        VoiceWaveWidget.Draw of TMsg(Current, Id, Signal, Progress, Changed, Settings);
      when E.Element.VoiceNote(
        const Id: string,
        const Samples: array of float,
        const Playback: VoiceNotes.Value,
        const Changed: function(VoiceNotes.Event): TMsg,
        const Settings: VoiceNotes.Options
      ):
        VoiceNoteWidget.Draw of TMsg(Current, Id, Samples, Playback, Changed, Settings);
      when E.Element.VoiceSession(
        const Id: string,
        const Mode: Voice.Activity,
        const Signal: Voice.Signal,
        const Muted: bool?,
        const Changed: function(VoiceSessions.Event): TMsg,
        const Settings: VoiceSessions.Options
      ):
        VoiceSessionWidget.Draw of TMsg(Current, Id, Mode, Signal, Muted, Changed, Settings);
      when E.Element.Composer(
        const Id: string,
        const Content: Composers.Value,
        const Changed: function(Composers.Event): TMsg,
        const Settings: Composers.Options
      ):
        ComposerWidget.Draw of TMsg(Current, Id, Content, Changed, Settings);
      else
        DrawDeveloperAndMedia(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawDeveloperAndMedia(
    Node: E.Element of TMsg;
    Current: C.State of TMsg;
    Horizontal: bool;
    Align: L.Alignment
  );
  begin
    case Node of
      when E.Element.VoiceOrb(
        const Id: string,
        const Mode: Voice.Activity,
        const Level: float,
        const Activate: (Sys.Func of TMsg)?,
        const Settings: VoiceOrbs.Options
      ):
        VoiceOrbWidget.Draw of TMsg(Current, Id, Mode, Level, Activate, Settings);
      when E.Element.Reasoning(
        const Id: string,
        const Bodies: array of E.Element of TMsg,
        const Settings: Reasonings.Options
      ):
        ReasoningWidget.Draw of TMsg(Current, Id, Bodies, Settings, Visit);
      when E.Element.ToolCall(
        const Id: string,
        const Name: string,
        const Settings: ToolCalls.Options
      ):
        ToolCallWidget.Draw of TMsg(Current, Id, Name, Settings);
      when E.Element.AgentPlan(
        const Id: string,
        const Steps: array of AgentPlans.Step,
        const Changed: Sys.Func of (int, TMsg)?,
        const Settings: AgentPlans.Options
      ):
        AgentPlanWidget.Draw of TMsg(Current, Id, Steps, Changed, Settings);
      when E.Element.AgentStatus(
        const Id: string,
        const Label: string,
        const Settings: AgentStatuses.Options
      ):
        AgentStatusWidget.Draw of TMsg(Current, Id, Label, Settings);
      when E.Element.SourceList(
        const Id: string,
        const Documents: array of Sources.Item,
        const Changed: Sys.Func of (int, TMsg)?,
        const Settings: SourceLists.Options
      ):
        SourceListWidget.Draw of TMsg(Current, Id, Documents, Changed, Settings);
      when E.Element.Citation(
        const Id: string,
        const Number: int,
        const Source: Sources.Item?,
        const Activate: (Sys.Func of TMsg)?,
        const Settings: Citations.Options
      ):
        CitationWidget.Draw of TMsg(Current, Id, Number, Source, Activate, Settings);
      when E.Element.ContextMeter(
        const Id: string,
        const Used: float,
        const Limit: float,
        const Breakdown: array of ContextMeters.Part,
        const Settings: ContextMeters.Options
      ):
        ContextMeterWidget.Draw of TMsg(Current, Id, Used, Limit, Breakdown, Settings);
      when E.Element.ResponseActions(
        const Id: string,
        const Vote: int?,
        const Changed: function(ResponseActions.Event): TMsg,
        const Settings: ResponseActions.Options
      ):
        ResponseActionsWidget.Draw of TMsg(Current, Id, Vote, Changed, Settings);
      when E.Element.PromptSuggestions(
        const Id: string,
        const Items: array of PromptSuggestions.Item,
        const Changed: function(int): TMsg,
        const Settings: PromptSuggestions.Options
      ):
        PromptSuggestionsWidget.Draw of TMsg(Current, Id, Items, Changed, Settings);
      when E.Element.ModelPicker(
        const Id: string,
        const Items: array of ModelPickers.Item,
        const Selected: int,
        const Changed: function(int): TMsg,
        const Settings: ModelPickers.Options
      ):
        ModelPickerWidget.Draw of TMsg(Current, Id, Items, Selected, Changed, Settings);
      when E.Element.Carousel(
        const Id: string,
        const Slides: array of E.Element of TMsg,
        const Index: int,
        const Changed: function(int): TMsg,
        const Settings: Carousels.Options
      ):
        CarouselWidget.Draw of TMsg(Current, Id, Slides, Index, Changed, Settings, Visit);
      when E.Element.CardStack(
        const Id: string,
        const DeckItems: array of E.Element of TMsg,
        const Changed: function(CardStacks.Direction): TMsg,
        const Settings: CardStacks.Options
      ):
        CardStackWidget.Draw of TMsg(Current, Id, DeckItems, Changed, Settings, Visit);
      when E.Element.ImageViewer(
        const Id: string,
        const Image: Media.Source,
        const ViewValue: ImageViewers.Value,
        const Changed: function(ImageViewers.Value): TMsg,
        const Settings: ImageViewers.Options
      ):
        ImageViewerWidget.Draw of TMsg(Current, Id, Image, ViewValue, Changed, Settings);
      when E.Element.ImageCropper(
        const Id: string,
        const Image: Media.Source,
        const Crop: ImageCroppers.Value,
        const Changed: function(ImageCroppers.Value): TMsg,
        const Settings: ImageCroppers.Options
      ):
        ImageCropperWidget.Draw of TMsg(Current, Id, Image, Crop, Changed, Settings);
      when E.Element.ImageCompare(
        const Id: string,
        const Before: Media.Source,
        const After: Media.Source,
        const Position: float,
        const Changed: function(float): TMsg,
        const Settings: ImageComparisons.Options
      ):
        ImageCompareWidget.Draw of TMsg(Current, Id, Before, After, Position, Changed, Settings);
      when E.Element.ChatMessage(
        const Id: string,
        const Text: string,
        const Settings: ChatMessages.Options
      ):
        ChatMessageWidget.Draw of TMsg(Current, Id, Text, Settings);
      when E.Element.ChatDivider(const Id: string, const Label: string):
        ChatDividerWidget.Draw of TMsg(Current, Id, Label);
      when E.Element.TypingIndicator(const Id: string, const Name: string):
        TypingIndicatorWidget.Draw of TMsg(Current, Id, Name);
      when E.Element.Comment(
        const Id: string,
        const Author: string,
        const Text: string,
        const Likes: Comments.Value,
        const Change: function(Comments.Event): TMsg,
        const Settings: Comments.Options
      ):
        CommentWidget.Draw of TMsg(Current, Id, Author, Text, Likes, Change, Settings);
      when E.Element.Presence(
        const Id: string,
        const Users: array of Presences.User,
        const Settings: Presences.Options
      ):
        PresenceWidget.Draw of TMsg(Current, Id, Users, Settings);
      when E.Element.Counter(
        const Id: string,
        const Value: double,
        const Settings: Counters.Options
      ):
        CounterWidget.Draw of TMsg(Current, Id, Value, Settings);
      else
        DrawVoiceAndChat(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawVoiceAndChat(
    Node: E.Element of TMsg;
    Current: C.State of TMsg;
    Horizontal: bool;
    Align: L.Alignment
  );
  begin
    case Node of
      when E.Element.Ticker(
        const Id: string,
        const Items: array of Tickers.Item,
        const Settings: Tickers.Options
      ):
        TickerWidget.Draw of TMsg(Current, Id, Items, Settings);
      when E.Element.StatusSpinner(
        const Id: string,
        const CurrentStatus: Status.Status,
        const Settings: StatusSpinners.Options
      ):
        StatusSpinnerWidget.Draw of TMsg(Current, Id, CurrentStatus, Settings);
      when E.Element.SkeletonGroup(
        const Id: string,
        const Children: array of E.Element of TMsg,
        const Settings: SkeletonGroups.Options
      ):
        SkeletonGroupWidget.Draw of TMsg(Current, Id, Children, Settings, Visit);
      when E.Element.Sparkline(
        const Id: string,
        const Values: array of float,
        const Settings: Sparklines.Options
      ):
        SparklineWidget.Draw of TMsg(Current, Id, Values, Settings);
      when E.Element.ProgressBar(
        const Id: string,
        const Value: float,
        const Settings: ProgressBars.Options
      ):
        ProgressWidget.Draw of TMsg(Current, Id, Value, Settings);
      when E.Element.Spinner(
        const Id: string,
        const Diameter: float,
        const Settings: Spinners.Options?
      ):
        SpinnerWidget.Draw of TMsg(Current, Id, Diameter, Settings ?? new Spinners.Options());
      when E.Element.Skeleton(const Id: string, const Width: L.Extent, const Height: float):
        SkeletonWidget.Draw of TMsg(Current, Id, Width, Height);
      when E.Element.TimelineItem(
        const Id: string,
        const Title: string,
        const Settings: Timeline.Options
      ):
        TimelineWidget.Draw of TMsg(Current, Id, Title, Settings);
      when E.Element.ProgressRing(
        const Id: string, const Label: string, const Value: float, const Diameter: float
      ):
        RingWidget.Draw of TMsg(Current, Id, Label, Value, Diameter);
      when E.Element.LevelMeter(
        const Id: string,
        const Peaks: array of float,
        const Settings: Levels.Options,
        const Notify: (Sys.Func of TMsg)?
      ):
        LevelMeterWidget.Draw of TMsg(Current, Id, Peaks, Settings, Notify);
      when E.Element.Meter(
        const Id: string, const Label: string, const Used: float,
        const Total: float, const Unit: string
      ):
        MeterWidget.Draw of TMsg(Current, Id, Label, Used, Total, Unit);
      when E.Element.ColorPicker(
        const Id: string, const Value: G.Color, const Change: function(G.Color): TMsg,
        const Enabled: bool
      ):
        ColorPickerWidget.Draw of TMsg(Current, Id, Value, Change, Enabled);
      when E.Element.EmojiPicker(
        const Id: string, const Value: Emojis.State, const Change: function(Emojis.Change): TMsg,
        const Settings: Emojis.Options
      ):
        EmojiPickerWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
      when E.Element.Calendar(
        const Id: string, const Value: Sys.DateOnly?, const Change: function(Sys.DateOnly): TMsg,
        const Enabled: bool
      ):
        CalendarWidget.Draw of TMsg(Current, Id, Value, Change, Enabled);
      when E.Element.DatePicker(
        const Id: string, const Value: Sys.DateOnly?, const Change: function(Sys.DateOnly): TMsg,
        const Settings: DatePickers.Options
      ):
        DatePickerWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
      when E.Element.RangeCalendar(
        const Id: string, const Value: Dates.Value, const Change: function(Dates.Value): TMsg,
        const Months: int, const Enabled: bool
      ):
        RangeCalendarWidget.Draw of TMsg(Current, Id, Value, Change, Months, Enabled);
      when E.Element.RangePicker(
        const Id: string, const Value: Dates.Value, const Change: function(Dates.Value): TMsg,
        const Settings: RangePickers.Options
      ):
        RangePickerWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
      when E.Element.TimePicker(
        const Id: string, const Value: Sys.TimeOnly, const Change: function(Sys.TimeOnly): TMsg,
        const Settings: TimePickers.Options
      ):
        TimePickerWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
      when E.Element.WheelPicker(
        const Id: string, const Items: array of string, const Selected: int,
        const Change: function(int): TMsg, const Settings: WheelPickers.Options
      ):
        WheelPickerWidget.Draw of TMsg(Current, Id, Items, Selected, Change, Settings);
      when E.Element.TimeDial(
        const Id: string, const Value: Sys.TimeOnly, const Change: function(Sys.TimeOnly): TMsg,
        const Diameter: float, const Enabled: bool
      ):
        TimeDialWidget.Draw of TMsg(Current, Id, Value, Change, Diameter, Enabled);
      when E.Element.MultiSelectInput(
        const Id: string, const Items: array of Selects.Item, const Selected: array of bool,
        const Change: function(array of bool): TMsg, const Settings: Multi.Options
      ):
        MultiWidget.Draw of TMsg(Current, Id, Items, Selected, Change, Settings);
      when E.Element.SelectInput(
        const Id: string, const Items: array of Selects.Item, const Selected: int,
        const OnChange: function(int): TMsg, const Settings: Selects.Options
      ):
        SelectWidget.Draw of TMsg(Current, Id, Items, Selected, OnChange, Settings);
      else
        DrawButtonsAndMenus(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawButtonsAndMenus(
    Node: E.Element of TMsg;
    Current: C.State of TMsg;
    Horizontal: bool;
    Align: L.Alignment
  );
  begin
    case Node of
      when E.Element.NumberField(
        const Id: string, const Value: double, const Minimum: double, const Maximum: double,
        const OnChange: function(double): TMsg, const Settings: NumberFields.Options
      ):
        NumberWidget.Draw of TMsg(Current, Id, Value, Minimum, Maximum, OnChange, Settings);
      when E.Element.Separator(const Title: string):
        if Title = '' then
          Current.Window.Separator();
          return;
        end if;

        Current.Window.BeginGroup(false, 0, 4, 0, false);
        Current.Window.Text(Title);
        Current.Labels.Add(Title);
        Current.Window.Separator();
        Current.Window.EndGroup();
      when E.Element.ButtonAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: B.Options
      ):
        Button.Draw of TMsg(Current, Id, Label, Message, Settings);
      when E.Element.IconAction(
        const Id: string, const Icon: string, const Tooltip: string, const Message: TMsg,
        const Settings: Icons.Options
      ):
        IconButton.Draw of TMsg(Current, Id, Icon, Tooltip, Message, Settings);
      when E.Element.CopyAction(
        const Id: string,
        const Text: string,
        const OnCopied: (Sys.Func of TMsg)?,
        const Enabled: bool
      ):
        CopyButton.Draw of TMsg(Current, Id, Text, OnCopied, Enabled);
      when E.Element.HoldAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Holds.Options
      ):
        HoldButton.Draw of TMsg(Current, Id, Label, Message, Settings);
      when E.Element.ConfirmAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Confirms.Options
      ):
        ConfirmButton.Draw of TMsg(Current, Id, Label, Message, Settings);
      when E.Element.StatusAction(
        const Id: string,
        const Label: string,
        const Value: Status.Status,
        const Message: TMsg,
        const Settings: Status.Options
      ):
        StatusButton.Draw of TMsg(Current, Id, Label, Value, Message, Settings);
      when E.Element.ThemeFlip(
        const Id: string, const Appearance: Themes.Mode,
        const Change: function(Themes.Mode): TMsg, const Enabled: bool
      ):
        ThemeToggle.Draw of TMsg(Current, Id, Appearance, Change, Enabled);
      when E.Element.Segments(
        const Id: string, const Items: array of Segmented.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: Segmented.Options
      ):
        SegmentedWidget.Draw of TMsg(Current, Id, Items, Selected, Change, Settings);
      when E.Element.TabStrip(
        const Id: string, const Items: array of Tabs.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: Tabs.Options
      ):
        TabsWidget.Draw of TMsg(Current, Id, Items, Selected, Change, Settings);
      when E.Element.BreadcrumbTrail(
        const Id: string,
        const Items: array of string,
        const Navigate: function(int): TMsg,
        const Enabled: bool
      ):
        Breadcrumb.Draw of TMsg(Current, Id, Items, Navigate, Enabled);
      when E.Element.PaginationAction(
        const Id: string,
        const Page: int,
        const Count: int,
        const Change: function(int): TMsg,
        const Enabled: bool
      ):
        Pagination.Draw of TMsg(Current, Id, Page, Count, Change, Enabled);
      when E.Element.StepProgress(const Id: string, const Steps: array of string, const Index: int):
        Stepper.Draw of TMsg(Current, Id, Steps, Index);
      when E.Element.Toggles(
        const Id: string, const Items: array of ToggleGroups.Item, const Selected: array of bool,
        const Change: function(array of bool): TMsg, const Settings: ToggleGroups.Options
      ):
        ToggleGroup.Draw of TMsg(Current, Id, Items, Selected, Change, Settings);
      when E.Element.ThemeChoice(
        const Id: string,
        const Selected: ThemeSwitchers.Selection,
        const Change: function(ThemeSwitchers.Selection): TMsg,
        const Settings: ThemeSwitchers.Options
      ):
        ThemeSwitcher.Draw of TMsg(Current, Id, Selected, Change, Settings);
      when E.Element.CheckboxAction(
        const Id: string,
        const Label: string,
        const Checked: bool,
        const Change: function(bool): TMsg,
        const Description: string,
        const Enabled: bool,
        const Indeterminate: bool, const HideLabel: bool
      ):
        Checkbox.Draw of TMsg(
          Current,
          Id,
          Label,
          Checked,
          Change,
          Description,
          Enabled,
          Indeterminate,
          HideLabel
        );
      when E.Element.SwitchAction(
        const Id: string, const Label: string, const On: bool, const Change: function(bool): TMsg,
        const Description: string, const Enabled: bool
      ):
        Switch.Draw of TMsg(Current, Id, Label, On, Change, Description, Enabled);
      when E.Element.RadioAction(
        const Id: string, const Label: string, const Selected: bool, const Select: function(): TMsg,
        const Description: string, const Enabled: bool
      ):
        RadioButton.Draw of TMsg(Current, Id, Label, Selected, Select, Description, Enabled);
      when E.Element.Radios(
        const Id: string, const Items: array of RadioGroups.Item, const Selected: int,
        const Change: function(int): TMsg, const Enabled: bool, const Gap: L.Spacing
      ):
        RadioGroup.Draw of TMsg(Current, Id, Items, Selected, Change, Enabled, Gap);
      when E.Element.Cards(
        const Id: string, const Items: array of RadioCards.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: RadioCards.Options
      ):
        RadioCardsWidget.Draw of TMsg(Current, Id, Items, Selected, Change, Settings);
      when E.Element.SliderAction(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Sliders.Options
      ):
        Slider.Draw of TMsg(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      else
        DrawPickersAndSelection(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawPickersAndSelection(
    Node: E.Element of TMsg;
    Current: C.State of TMsg;
    Horizontal: bool;
    Align: L.Alignment
  );
  begin
    case Node of
      when E.Element.RangeSliderAction(
        const Id: string,
        const Label: string,
        const Value: RangeSliders.Interval,
        const Minimum: float,
        const Maximum: float,
        const Change: function(RangeSliders.Interval): TMsg,
        const Enabled: bool
      ):
        RangeSlider.Draw of TMsg(Current, Id, Label, Value, Minimum, Maximum, Change, Enabled);
      when E.Element.Banner(
        const Id: string, const Text: string, const Open: bool, const Dismiss: (Sys.Func of TMsg)?,
        const Action: (Sys.Func of TMsg)?, const Settings: Banners.Options
      ):
        BannerWidget.Draw of TMsg(Current, Id, Text, Open, Dismiss, Action, Settings);
      when E.Element.Countdown(
        const Id: string,
        const Seconds: double,
        const Settings: Countdowns.Options
      ):
        CountdownWidget.Draw of TMsg(Current, Id, Seconds, Settings);
      when E.Element.Checklist(
        const Id: string,
        const Steps: array of Checklists.Step,
        const Toggle: function(int, bool): TMsg,
        const Action: Sys.Func of (int, TMsg)?,
        const Settings: Checklists.Options
      ):
        ChecklistWidget.Draw of TMsg(Current, Id, Steps, Toggle, Action, Settings);
      when E.Element.Dropzone(
        const Id: string,
        const Drop: function(array of string): TMsg,
        const Browse: (Sys.Func of TMsg)?,
        const Settings: Dropzones.Options
      ):
        DropzoneWidget.Draw of TMsg(Current, Id, Drop, Browse, Settings);
      when E.Element.AvatarUpload(
        const Id: string,
        const Name: string,
        const Path: string?,
        const Drop: function(string): TMsg,
        const Browse: (Sys.Func of TMsg)?,
        const Diameter: float,
        const Enabled: bool
      ):
        AvatarUploadWidget.Draw of TMsg(Current, Id, Name, Path, Drop, Browse, Diameter, Enabled);
      when E.Element.SignaturePad(
        const Id: string,
        const Change: Sys.Func of (Signatures.Signature, TMsg)?,
        const Settings: Signatures.Options
      ):
        SignaturePadWidget.Draw of TMsg(Current, Id, Change, Settings);
      when E.Element.Knob(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Knobs.Options
      ):
        KnobWidget.Draw of TMsg(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.Fader(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Faders.Options
      ):
        FaderWidget.Draw of TMsg(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.RulerSlider(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, const Change: function(float): TMsg, const Settings: Rulers.Options
      ):
        RulerWidget.Draw of TMsg(Current, Id, Label, Value, Minimum, Maximum, Change, Settings);
      when E.Element.HistogramSlider(
        const Id: string, const Label: string, const Bins: array of float,
        const Value: RangeSliders.Interval, const Minimum: float, const Maximum: float,
        const Change: function(RangeSliders.Interval): TMsg, const Settings: Histograms.Options
      ):
        HistogramWidget.Draw of TMsg(
          Current,
          Id,
          Label,
          Bins,
          Value,
          Minimum,
          Maximum,
          Change,
          Settings
        );
      when E.Element.ChipAction(
        const Id: string,
        const Label: string,
        const Selected: bool,
        const Change: function(bool): TMsg,
        const Icon: string,
        const Enabled: bool
      ):
        Chip.Draw of TMsg(Current, Id, Label, Selected, Change, Icon, Enabled);
      when E.Element.RatingAction(
        const Id: string, const Label: string, const Value: int, const Change: function(int): TMsg,
        const Maximum: int, const Enabled: bool, const StarSize: float
      ):
        Rating.Draw of TMsg(Current, Id, Label, Value, Change, Maximum, Enabled, StarSize);
      when E.Element.SplitAction(
        const Id: string, const Label: string, const Message: TMsg,
        const Items: array of Split.Item of TMsg, const Settings: Split.Options
      ):
        SplitButton.Draw of TMsg(Current, Id, Label, Message, Items, Settings);
      when E.Element.Contextual(
        const Id: string,
        const Child: E.Element of TMsg,
        const Entries: array of Menus.Entry of TMsg,
        const Enabled: bool
      ):
        Visit(Child, Current, Horizontal, Align);
        ContextMenu.Draw of TMsg(Current, Id, Entries, Enabled);
        return;
      when E.Element.Hinted(
        const Child: E.Element of TMsg,
        const Caption: string,
        const Shortcut: string
      ):
        Visit(Child, Current, Horizontal, Align);
        TooltipWidget.Attach of TMsg(Current, Caption, Shortcut);
        return;
      when E.Element.Accordion(
        const Id: string, const Title: string, const Open: bool,
        const OnChange: function(bool): TMsg, const Content: E.Element of TMsg, const Enabled: bool
      ):
        DisclosureWidget.Draw of TMsg(
          Current, Id, Title, Open, OnChange, Content, false,
          new ExpandableCards.Options(Enabled := Enabled), Visit
        );
      when E.Element.ExpandableCard(
        const Id: string,
        const Title: string,
        const Open: bool,
        const OnChange: function(bool): TMsg,
        const Content: E.Element of TMsg,
        const Settings: ExpandableCards.Options
      ):
        DisclosureWidget.Draw of TMsg(
          Current,
          Id,
          Title,
          Open,
          OnChange,
          Content,
          true,
          Settings,
          Visit
        );
      when E.Element.ExpandableText(
        const Id: string, const Text: string, const Settings: ExpandableTexts.Options,
        const OnToggle: (Sys.Func of TMsg)?
      ):
        ExpandableTextWidget.Draw of TMsg(Current, Id, Text, Settings, OnToggle);
      when E.Element.LinkAction(
        const Id: string,
        const Label: string,
        const Activate: TMsg,
        const Enabled: bool
      ):
        LinkWidget.Draw of TMsg(Current, Id, Label, Activate, Enabled);
      when E.Element.Avatar(const Id: string, const Name: string, const Settings: Avatars.Options):
        AvatarWidget.Draw of TMsg(Current, Id, Name, Settings);
        // CUI's avatar centers itself on the cross axis inside its row.
        return;
      when E.Element.HoverCard(
        const Id: string,
        const Trigger: E.Element of TMsg,
        const Content: E.Element of TMsg,
        const Settings: HoverCards.Options
      ):
        HoverCardWidget.Draw of TMsg(
          Current,
          Id,
          Trigger,
          Content,
          Settings,
          Horizontal,
          Align,
          Visit
        );
        return;
      else
        DrawDisclosureAndData(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawDisclosureAndData(
    Node: E.Element of TMsg;
    Current: C.State of TMsg;
    Horizontal: bool;
    Align: L.Alignment
  );
  begin
    case Node of
      when E.Element.Popover(
        const Id: string, const Trigger: E.Element of TMsg, const Content: E.Element of TMsg,
        const Open: bool, const Dismiss: TMsg, const Settings: Popovers.Options
      ):
        PopoverWidget.Draw of TMsg(
          Current,
          Id,
          Trigger,
          Content,
          Open,
          Dismiss,
          Settings,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.ConfirmPopover(
        const Id: string, const Trigger: E.Element of TMsg, const Open: bool,
        const Settings: ConfirmPopovers.Options, const Confirm: TMsg, const Dismiss: TMsg
      ):
        ConfirmPopoverWidget.Draw of TMsg(
          Current,
          Id,
          Trigger,
          Open,
          Settings,
          Confirm,
          Dismiss,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.ReactionGroup(
        const Id: string, const Items: array of Reactions.Item,
        const Change: function(int, Reactions.Item): TMsg, const Enabled: bool
      ):
        ReactionsWidget.Draw of TMsg(Current, Id, Items, Change, Enabled);
      when E.Element.SpeedDialAction(
        const Id: string, const Items: array of Speed.Item, const Choose: function(int): TMsg,
        const Settings: Speed.Options
      ):
        SpeedWidget.Draw of TMsg(Current, Id, Items, Choose, Settings);
      when E.Element.SwipeRow(
        const Id: string, const Content: E.Element of TMsg, const Left: array of Swipe.Item,
        const Right: array of Swipe.Item, const Choose: function(Swipe.Side, int): TMsg,
        const Settings: Swipe.Options
      ):
        SwipeWidget.Draw of TMsg(Current, Id, Content, Left, Right, Choose, Settings, Visit);
      when E.Element.AccountMenu(
        const Id: string, const Name: string, const Entries: array of Menus.Entry of TMsg,
        const Settings: UserMenus.Options
      ):
        UserMenuWidget.Draw of TMsg(Current, Id, Name, Entries, Settings);
      when E.Element.Dropdown(
        const Id: string,
        const Label: string,
        const Entries: array of Menus.Entry of TMsg,
        const Settings: Menus.Options
      ):
        DropdownMenu.Draw of TMsg(Current, Id, Label, Entries, Settings);
      when E.Element.Sidebar(
        const Id: string,
        const Sections: array of N.Section of TMsg,
        const Active: string?,
        const Enabled: bool
      ):
        Sidebar.Draw of TMsg(Current, Id, Sections, Active, Enabled);
      when E.Element.ButtonGroup(const Children: array of E.Element of TMsg):
        ButtonGroup.Draw of TMsg(Current, Children, Visit);
      when E.Element.ActionFooter(const Children: array of E.Element of TMsg):
        ActionFooterWidget.Draw of TMsg(Current, Children, Visit);
      when E.Element.ListItem(
        const Id: string,
        const Title: string,
        const Activate: (Sys.Func of TMsg)?,
        const Settings: ListItems.Options
      ):
        ListItemWidget.Draw of TMsg(Current, Id, Title, Activate, Settings);
      when E.Element.TreeNode(
        const Id: string,
        const Label: string,
        const Open: bool?,
        const Children: array of E.Element of TMsg,
        const Change: Sys.Func of (bool, TMsg)?,
        const Activate: (Sys.Func of TMsg)?,
        const Settings: Trees.Options
      ):
        TreeWidget.Draw of TMsg(
          Current,
          Id,
          Label,
          Open,
          Children,
          Change,
          Activate,
          Settings,
          Visit
        );
      when E.Element.Table(
        const Id: string,
        const Columns: array of Tables.Column,
        const Rows: array of Tables.Row of TMsg,
        const Order: Tables.Sort?,
        const OnSort: Sys.Func of (Tables.Sort, TMsg)?,
        const OnSelect: Sys.Func of (string, TMsg)?,
        const Settings: Tables.Options
      ):
        TableWidget.Draw of TMsg(
          Current,
          Id,
          Columns,
          Rows,
          Order,
          OnSort,
          OnSelect,
          Settings,
          Visit
        );
      when E.Element.VirtualList(
        const Id: string,
        const Count: int,
        const RowHeight: float,
        const Height: L.Extent,
        const Build: function(int): E.Element of TMsg,
        const Offset: float?,
        const Scroll: Sys.Func of (float, TMsg)?
      ):
        VirtualWidget.Draw of TMsg(
          Current,
          Id,
          Count,
          RowHeight,
          Height,
          Build,
          Offset,
          Scroll,
          Visit
        );
      when E.Element.FilterBar(
        const Id: string,
        const Fields: array of Filters.Field,
        const Value: Filters.Value,
        const Change: function(Filters.Value): TMsg,
        const Capacity: int,
        const Enabled: bool
      ):
        FilterWidget.Draw of TMsg(Current, Id, Fields, Value, Change, Capacity, Enabled);
      when E.Element.DataGrid(
        const Id: string, const Columns: array of DataGrids.Column, const Count: int,
        const Build: function(int): DataGrids.Row of TMsg, const Value: DataGrids.Value,
        const Change: function(DataGrids.Value): TMsg, const Settings: DataGrids.Options,
        const DoubleClick: Sys.Func of (int, TMsg)?
      ):
        GridDataWidget.Draw of TMsg(
          Current,
          Id,
          Columns,
          Count,
          Build,
          Value,
          Change,
          Settings,
          DoubleClick,
          Visit
        );
      when E.Element.TreeCell(
        const Id: string, const Label: string, const Depth: int, const Open: bool?,
        const Change: Sys.Func of (bool, TMsg)?, const Icon: string
      ):
        TreeTableWidget.Cell of TMsg(Current, Id, Label, Depth, Open, Change, Icon);
      when E.Element.TreeTable(
        const Id: string, const Columns: array of DataGrids.Column,
        const Nodes: array of TreeTables.Node, const Cursor: int, const Order: Tables.Sort?,
        const Change: function(TreeTables.Change): TMsg, const Settings: TreeTables.Options,
        const Menu: Sys.Func of (int, array of Menus.Entry of TMsg)?
      ):
        TreeTableWidget.Draw of TMsg(
          Current,
          Id,
          Columns,
          Nodes,
          Cursor,
          Order,
          Change,
          Settings,
          Menu
        );
      when E.Element.ReorderableList(
        const Id: string, const Items: array of E.Element of TMsg, const Order: array of int,
        const Change: function(array of int): TMsg, const Enabled: bool
      ):
        ReorderWidget.Draw of TMsg(Current, Id, Items, Order, Change, Enabled, Visit);
      when E.Element.CodeBlock(
        const Id: string,
        const Code: string,
        const Settings: CodeBlocks.Options
      ):
        CodeBlockWidget.Draw of TMsg(Current, Id, Code, Settings);
      when E.Element.JsonView(
        const Id: string,
        const Json: string,
        const Settings: JsonViews.Options
      ):
        JsonViewWidget.Draw of TMsg(Current, Id, Json, Settings);
      when E.Element.Readout(
        const Id: string,
        const Label: string,
        const Value: string,
        const Settings: Readouts.Options
      ):
        ReadoutWidget.Draw of TMsg(Current, Id, Label, Value, Settings);
      else
        DrawChartsAndSections(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawChartsAndSections(
    Node: E.Element of TMsg;
    Current: C.State of TMsg;
    Horizontal: bool;
    Align: L.Alignment
  );
  begin
    case Node of
      when E.Element.DotDisplay(
        const Id: string,
        const Text: string,
        const Settings: DotDisplays.Options
      ):
        DotDisplayWidget.Draw of TMsg(Current, Id, Text, Settings);
      when E.Element.DotChart(
        const Id: string, const Bands: array of DotCharts.Series, const Count: int,
        const Activate: Sys.Func of (DotCharts.Hit, TMsg)?, const Settings: DotCharts.Options
      ):
        DotChartWidget.Draw of TMsg(Current, Id, Bands, Count, Activate, Settings);
      when E.Element.EventTrack(
        const Id: string, const Value: EventTracks.Value,
        const Change: function(EventTracks.Change): TMsg, const Settings: EventTracks.Options
      ):
        EventTrackWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
      when E.Element.PathBar(
        const Id: string,
        const Value: PathBars.Value,
        const Change: function(PathBars.Event): TMsg,
        const Settings: PathBars.Options
      ):
        PathBarWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
      when E.Element.FileBrowser(
        const Id: string,
        const Folder: string,
        const Change: function(FileBrowsers.Event): TMsg,
        const Settings: FileBrowsers.Options
      ):
        FileBrowserWidget.Draw of TMsg(Current, Id, Folder, Change, Settings);
      when E.Element.FilePicker(
        const Id: string,
        const Base: (E.Element of TMsg)?,
        const Open: bool,
        const Change: function(FilePickers.Event): TMsg,
        const Settings: FilePickers.Options
      ):
        FilePickerWidget.Draw of TMsg(
          Current,
          Id,
          Base,
          Open,
          Change,
          Settings,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.WeekCalendar(
        const Id: string,
        const Value: WeekCalendars.Value,
        const Change: function(WeekCalendars.Event): TMsg,
        const Settings: WeekCalendars.Options
      ):
        WeekCalendarWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
      when E.Element.MonthCalendar(
        const Id: string,
        const Value: MonthCalendars.Value,
        const Change: function(MonthCalendars.Event): TMsg,
        const Settings: MonthCalendars.Options
      ):
        MonthCalendarWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
      when E.Element.Gantt(
        const Id: string,
        const Value: Gantts.Value,
        const Change: function(Gantts.Event): TMsg,
        const Settings: Gantts.Options
      ):
        GanttWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
      when E.Element.Kanban(
        const Id: string,
        const Columns: array of Kanbans.Column of TMsg,
        const Change: function(Kanbans.Event): TMsg,
        const Settings: Kanbans.Options
      ):
        KanbanWidget.Draw of TMsg(Current, Id, Columns, Change, Settings, Visit);
        return;
      when E.Element.StatusTag(
        const Id: string,
        const Value: StatusTags.Value,
        const Remove: (Sys.Func of TMsg)?,
        const Settings: StatusTags.Options
      ):
        StatusTagWidget.Draw of TMsg(Current, Id, Value, Remove, Settings);
        return;
      when E.Element.RatioSlider(
        const Id: string,
        const Value: RatioSliders.Value,
        const Change: function(float): TMsg,
        const Settings: RatioSliders.Options
      ):
        RatioSliderWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
        return;
      when E.Element.GradientSlider(
        const Id: string,
        const Value: GradientSliders.Value,
        const Change: function(GradientSliders.Event): TMsg,
        const Settings: GradientSliders.Options
      ):
        GradientSliderWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
        return;
      when E.Element.StepSlider(
        const Id: string,
        const Value: StepSliders.Value,
        const Change: function(StepSliders.Event): TMsg,
        const Settings: StepSliders.Options
      ):
        StepSliderWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
        return;
      when E.Element.PaletteStrip(
        const Id: string,
        const Value: PaletteStrips.Value,
        const Change: function(PaletteStrips.Event): TMsg,
        const Settings: PaletteStrips.Options
      ):
        PaletteStripWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
        return;
      when E.Element.AspectPicker(
        const Id: string,
        const Value: AspectPickers.Value,
        const Change: function(int): TMsg,
        const Settings: AspectPickers.Options
      ):
        AspectPickerWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
        return;
      when E.Element.OptionAction(
        const Id: string,
        const Value: OptionActions.Value,
        const Change: function(OptionActions.Event): TMsg,
        const Settings: OptionActions.Options
      ):
        OptionActionWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
        return;
      when E.Element.SeedField(
        const Id: string,
        const Value: SeedFields.Value,
        const Change: function(SeedFields.Event): TMsg,
        const Settings: SeedFields.Options
      ):
        SeedFieldWidget.Draw of TMsg(Current, Id, Value, Change, Settings);
        return;
      when E.Element.ShimmerText(
        const Id: string,
        const Text: string,
        const Settings: Motion.TextOptions
      ):
        ShimmerTextWidget.Draw of TMsg(Current, Id, Text, Settings);
      when E.Element.Typewriter(
        const Id: string,
        const Text: string,
        const Replay: int,
        const Settings: Motion.TextOptions,
        const OnComplete: (Sys.Func of TMsg)?
      ):
        TypewriterWidget.Draw of TMsg(Current, Id, Text, Replay, Settings, OnComplete);
      when E.Element.TextReveal(
        const Id: string,
        const Text: string,
        const Replay: int,
        const Settings: Motion.TextOptions
      ):
        TextRevealWidget.Draw of TMsg(Current, Id, Text, Replay, Settings);
      when E.Element.WordRotate(
        const Id: string,
        const Words: array of string,
        const Interval: float,
        const Settings: Motion.TextOptions
      ):
        WordRotateWidget.Draw of TMsg(Current, Id, Words, Interval, Settings);
      when E.Element.NumberRoll(
        const Id: string,
        const Text: string,
        const Settings: Motion.TextOptions
      ):
        NumberRollWidget.Draw of TMsg(Current, Id, Text, Settings);
      when E.Element.GradientText(
        const Id: string,
        const Text: string,
        const Settings: GradientTexts.Options
      ):
        GradientTextWidget.Draw of TMsg(Current, Id, Text, Settings);
      when E.Element.Spotlight(
        const Id: string,
        const Children: array of E.Element of TMsg,
        const Settings: Spotlights.Options
      ):
        SpotlightWidget.Draw of TMsg(Current, Id, Children, Settings, Visit);
      when E.Element.Loader(
        const Id: string,
        const Style: Loaders.Animation,
        const Settings: Loaders.Options
      ):
        LoaderWidget.Draw of TMsg(Current, Id, Style, Settings);
      when E.Element.Dock(
        const Id: string,
        const Entries: array of Docks.Entry of TMsg,
        const Settings: Docks.Options
      ):
        DockWidget.Draw of TMsg(Current, Id, Entries, Settings);
        return;
      when E.Element.ControlTile(
        const Id: string,
        const Label: string,
        const On: bool,
        const Change: function(bool): TMsg,
        const Settings: ControlTiles.Options
      ):
        ControlTileWidget.Draw of TMsg(Current, Id, Label, On, Change, Settings);
        return;
      when E.Element.NowPlaying(
        const Id: string,
        const Model: NowPlaying.Value,
        const Change: function(NowPlaying.Event): TMsg,
        const Settings: NowPlaying.Options
      ):
        NowPlayingWidget.Draw of TMsg(Current, Id, Model, Change, Settings);
      when E.Element.Waveform(
        const Id: string,
        const Peaks: array of float,
        const Progress: float?,
        const Change: Sys.Func of (float, TMsg)?,
        const Settings: Waveforms.Options
      ):
        WaveformWidget.Draw of TMsg(Current, Id, Peaks, Progress, Change, Settings);
      when E.Element.TabBar(
        const Id: string,
        const Items: array of TabBars.Item,
        const Selected: int,
        const Change: function(int): TMsg,
        const Settings: TabBars.Options
      ):
        TabBarWidget.Draw of TMsg(Current, Id, Items, Selected, Change, Settings);
      when E.Element.CommandPalette(
        const Id: string,
        const Base: E.Element of TMsg,
        const Open: bool,
        const Commands: array of Palettes.Command of TMsg,
        const Change: function(bool): TMsg,
        const Shortcut: bool
      ):
        PaletteWidget.Draw of TMsg(
          Current,
          Id,
          Base,
          Open,
          Commands,
          Change,
          Shortcut,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.Grid(
        const Settings: Grids.Options,
        const Children: array of E.Element of TMsg
      ):
        GridWidget.Draw of TMsg(Current, Settings, Children, Visit);
        return;
      when E.Element.Card(
        const Id: string, const Children: array of E.Element of TMsg, const Settings: Cards.Options,
        const Activate: (Sys.Func of TMsg)?
      ):
        CardWidget.Draw of TMsg(Current, Id, Children, Settings, Activate, Visit);
      when E.Element.Badge(const Id: string, const Text: string, const Settings: Badges.Options):
        BadgeWidget.Draw of TMsg(Current, Id, Text, Settings);
      when E.Element.Sankey(
        const Id: string,
        const Nodes: array of Sankeys.Node,
        const Links: array of Sankeys.Link,
        const Settings: Sankeys.Options,
        const OnActivate: Sys.Func of (Sankeys.Selection, TMsg)?
      ):
        SankeyWidget.Draw of TMsg(Current, Id, Nodes, Links, Settings, OnActivate);
      when E.Element.BarList(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: BarLists.Options,
        const OnActivate: Sys.Func of (int, TMsg)?
      ):
        BarListWidget.Draw of TMsg(Current, Id, Items, Settings, OnActivate);
      when E.Element.ActivityRings(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: ActivityRings.Options,
        const OnActivate: Sys.Func of (int, TMsg)?
      ):
        ActivityRingsWidget.Draw of TMsg(Current, Id, Items, Settings, OnActivate);
      when E.Element.ScatterChart(
        const Id: string,
        const Series: array of ScatterCharts.Series,
        const Settings: ScatterCharts.Options,
        const OnActivate: Sys.Func of (ScatterCharts.PointIndex, TMsg)?
      ):
        ScatterChartWidget.Draw of TMsg(Current, Id, Series, Settings, OnActivate);
      when E.Element.RadialGauge(
        const Id: string,
        const Value: float,
        const Minimum: float,
        const Maximum: float,
        const Settings: RadialGauges.Options
      ):
        RadialGaugeWidget.Draw of TMsg(Current, Id, Value, Minimum, Maximum, Settings);
      when E.Element.Candlestick(
        const Id: string,
        const Candles: array of Candlesticks.Candle,
        const Settings: Candlesticks.Options,
        const OnCursorChange: Sys.Func of (int, TMsg)?
      ):
        CandlestickWidget.Draw of TMsg(Current, Id, Candles, Settings, OnCursorChange);
      when E.Element.Heatmap(
        const Id: string,
        const Values: array of float,
        const Rows: int,
        const Columns: int,
        const Settings: Heatmaps.Options,
        const OnActivate: Sys.Func of (Heatmaps.Cell, TMsg)?
      ):
        HeatmapWidget.Draw of TMsg(Current, Id, Values, Rows, Columns, Settings, OnActivate);
      when E.Element.CalendarHeatmap(
        const Id: string,
        const Start: Sys.DateOnly,
        const Values: array of float,
        const Settings: CalendarHeatmaps.Options,
        const OnActivate: Sys.Func of (Sys.DateOnly, TMsg)?
      ):
        CalendarHeatmapWidget.Draw of TMsg(Current, Id, Start, Values, Settings, OnActivate);
      when E.Element.Treemap(
        const Id: string,
        const Items: array of Charts.Item,
        const Selected: int,
        const OnSelect: Sys.Func of (int, TMsg)?,
        const Settings: Treemaps.Options
      ):
        TreemapWidget.Draw of TMsg(Current, Id, Items, Selected, OnSelect, Settings);
      when E.Element.RadarChart(
        const Id: string,
        const Series: array of Charts.Series,
        const Axes: array of string,
        const Settings: RadarCharts.Options,
        const OnActivate: Sys.Func of (int, TMsg)?
      ):
        RadarChartWidget.Draw of TMsg(Current, Id, Series, Axes, Settings, OnActivate);
      when E.Element.Funnel(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: Funnels.Options,
        const OnActivate: Sys.Func of (int, TMsg)?
      ):
        FunnelWidget.Draw of TMsg(Current, Id, Items, Settings, OnActivate);
      when E.Element.SplitBar(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: SplitBars.Options,
        const OnActivate: Sys.Func of (int, TMsg)?
      ):
        SplitBarWidget.Draw of TMsg(Current, Id, Items, Settings, OnActivate);
      when E.Element.Waffle(
        const Id: string,
        const Items: array of Charts.Item,
        const Settings: Waffles.Options,
        const OnActivate: Sys.Func of (int, TMsg)?
      ):
        WaffleWidget.Draw of TMsg(Current, Id, Items, Settings, OnActivate);
      when E.Element.LineChart(
        const Id: string,
        const Series: array of Charts.Series,
        const Settings: Charts.Options
      ):
        LineChartWidget.Draw of TMsg(Current, Id, Series, Settings);
      when E.Element.BarChart(
        const Id: string,
        const Series: array of Charts.Series,
        const Settings: Charts.Options
      ):
        BarChartWidget.Draw of TMsg(Current, Id, Series, Settings);
      when E.Element.DonutChart(
        const Id: string,
        const Values: array of float,
        const Labels: array of string,
        const Settings: Donuts.Options
      ):
        DonutChartWidget.Draw of TMsg(Current, Id, Values, Labels, Settings);
      when E.Element.Gauge(
        const Id: string,
        const Label: string,
        const Value: float,
        const Diameter: float
      ):
        GaugeWidget.Draw of TMsg(Current, Id, Label, Value, Diameter);
      when E.Element.PatternMeter(
        const Id: string,
        const Parts: array of Patterns.Part,
        const Settings: Patterns.Options
      ):
        PatternMeterWidget.Draw of TMsg(Current, Id, Parts, Settings);
      when E.Element.Metric(
        const Id: string,
        const Label: string,
        const Reading: string,
        const Settings: Metrics.Options
      ):
        MetricWidget.Draw of TMsg(Current, Id, Label, Reading, Settings);
      when E.Element.AvatarGroup(
        const Id: string,
        const Names: array of string,
        const Settings: AvatarGroups.Options
      ):
        AvatarGroupWidget.Draw of TMsg(Current, Id, Names, Settings);
      when E.Element.EmptyState(
        const Id: string,
        const Title: string,
        const Settings: EmptyStates.Options,
        const Action: (Sys.Func of TMsg)?
      ):
        EmptyStateWidget.Draw of TMsg(Current, Id, Title, Settings, Action);
      when E.Element.Tour(
        const Id: string,
        const Base: E.Element of TMsg,
        const Steps: array of Tours.Step,
        const CurrentStep: int,
        const Changed: function(Tours.Change): TMsg,
        const Settings: Tours.Options
      ):
        Visit(Base, Current, Horizontal, Align);
        TourWidget.Draw of TMsg(Current, Id, Steps, CurrentStep, Changed, Settings);
        return;
      else
        DrawLayout(Node, Current, Horizontal, Align);
        return;
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;

  procedure DrawLayout(
    Node: E.Element of TMsg;
    Current: C.State of TMsg;
    Horizontal: bool;
    Align: L.Alignment
  );
  begin
    case Node of
      when E.Element.Spacer:
        Current.Window.Spacer();
        return;
      when E.Element.Gap(const Distance: L.Measure):
        Current.Window.Gap(Size.Measure(Distance));
        return;
      when E.Element.Layered(const Children: array of E.Element of TMsg, const Settings: L.Flow):
        Current.Window.BeginLayers(
          cast Settings.Align as int,
          cast Settings.Justify as int,
          Settings.Clip ?? false, Settings.Id, cast Settings.Scrolling as int
        );
        Size.Container(Current.Window, Settings, true);
        const Scope: L.FocusScope? := Settings.Scope;
        if Scope <> null then
          Current.Window.PushFocusScope(Scope.Id, Scope.Active);
        end if;

        for Child: E.Element of TMsg in Children do
          Visit(Child, Current, false, L.Alignment.Default);
        end for;

        if Scope <> null then
          Current.Window.PopFocusScope();
        end if;

        Current.Window.EndGroup();
        C.TrackContainer of TMsg(Current, Settings.Id, 'layers');
        return;
      when E.Element.Stack(
        const Children: array of E.Element of TMsg,
        const Row: bool,
        const Settings: L.Flow
      ):
        Current.Window.BeginGroup(
          Row,
          Size.Spacing(Settings.Padding),
          Size.Spacing(Settings.Gap),
          cast Settings.Align as int,
          false,
          Settings.Wrap, Settings.Clip ?? not Settings.Wrap, cast Settings.Justify as int,
          Settings.Id, cast Settings.Scrolling as int
        );
        Size.Container(Current.Window, Settings);
        const Scope: L.FocusScope? := Settings.Scope;
        if Scope <> null then
          Current.Window.PushFocusScope(Scope.Id, Scope.Active);
        end if;

        for Child: E.Element of TMsg in Children do
          Visit(Child, Current, Row, Settings.Align);
        end for;

        if Scope <> null then
          Current.Window.PopFocusScope();
        end if;

        Current.Window.EndGroup();
        C.TrackContainer of TMsg(
          Current, Settings.Id, if Row then
            'row'
          else
            'column'
          end if
        );
        return;
      when E.Element.Sized(const Child: E.Element of TMsg, const Settings: L.Flex):
        Visit(Child, Current, Horizontal, Align);
        // Sizing a child preserves the alignment chosen while drawing it.
        Size.Apply(Current.Window, Settings, Horizontal, L.Alignment.Default);
        return;
      when E.Element.Styled(const Child: E.Element of TMsg, const Role: S.Role):
        Visit(Child, Current, Horizontal, Align);
        Current.Window.StyleLast(cast Role as int);
        return;
      when E.Element.Framed(const Child: E.Element of TMsg, const Title: string):
        Current.Window.BeginGroup(false, 8, 8, 0, true);
        if Title <> '' then
          Current.Window.Text(Title);
          Current.Labels.Add(Title);
        end if;

        Visit(Child, Current, false, L.Alignment.Stretch);
        Current.Window.EndGroup();
      when E.Element.TableOfContents(
        const Id: string, const ScrollId: string, const Items: array of Toc.Item,
        const Changed: Sys.Func of (string, TMsg)?, const Enabled: bool
      ):
        TocWidget.Draw of TMsg(Current, Id, ScrollId, Items, Changed, Enabled);
      when E.Element.ScrollAnchor(const Id: string):
        AnchorWidget.Draw of TMsg(Current, Id);
      when E.Element.Scroll(
        const Id: string,
        const Children: array of E.Element of TMsg,
        const Position: L.ScrollPosition?,
        const Scroll: Sys.Func of (L.ScrollChange, TMsg)?,
        const Settings: L.ScrollOptions
      ):
        const Token: string := C.Token('scroll', Id);
        var Before: float := 0;
        var Maximum: float := 0;
        Current.Window.ScrollState(Token, -1, 0, out Before, out Maximum);
        var Mode: int := -1;
        var Offset: float := 0;
        case Position of
          when L.ScrollPosition.Start:
            Mode := 0;
          when L.ScrollPosition.End:
            Mode := 1;
          when L.ScrollPosition.Offset(const Distance: L.Measure):
            Mode := 0;
            Offset := Size.Measure(Distance);
          else
        end case;

        Current.Window.ScrollState(Token, Mode, Offset, out Before, out Maximum);
        Current.Window.ScrollState(Token, -1, 0, out Before, out Maximum);
        const Width: Size.NativeExtent := Size.Extent(Settings.Width ?? L.Extent.Fill);
        const Height: Size.NativeExtent := Size.Extent(Settings.Height ?? L.Extent.Fill);
        const Fade: G.Color? := Settings.FadeColor;
        Current.Window.BeginViewport(
          Token,
          Settings.ShowScrollbar,
          Current.AcceptInput,
          Settings.FadeEdges,
          Settings.Horizontal,
          Width.Kind,
          Width.Value,
          Height.Kind,
          Height.Value,
          Size.Spacing(
            Settings.Padding ?? L.Spacing.None
          ),
          Size.Spacing(Settings.Gap ?? L.Spacing.None),
          if Fade = null then
            0U
          else
            CreativeParts.Pack(Fade)
          end if
        );
        for Child: E.Element of TMsg in Children do
          Visit(Child, Current, false, L.Alignment.Stretch);
        end for;

        Current.Window.EndScroll();
        var After: float := 0;
        Current.Window.ScrollState(Token, -1, 0, out After, out Maximum);
        if Current.AcceptInput and After <> Before then
          case Scroll of
            when is Sys.Func of (L.ScrollChange, TMsg) as Changed:
              const Units: L.Measure := L.Measure.Points(After);
              Current.Messages.Add(
                Changed.Invoke(
                  new L.ScrollChange(
                    L.ScrollPosition.Offset(Units),
                    Units,
                    L.Measure.Points(Maximum)
                  )
                )
              );
            else
          end case;
        end if;

        C.Track of TMsg(
          Current,
          new App.Control(
            Id,
            '',
            'scroll',
            new Cui.CuiRectangle(),
            Current.AcceptInput,
            Value := After.ToString()
          )
        );
      when E.Element.Sheet(
        const Id: string, const Base: E.Element of TMsg, const Content: E.Element of TMsg,
        const Open: bool, const Settings: Sheets.Options, const Dismiss: TMsg
      ):
        Sheet.Draw of TMsg(
          Current,
          Id,
          Base,
          Content,
          Open,
          Settings,
          Dismiss,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.Dialog(
        const Id: string, const Base: E.Element of TMsg, const Content: E.Element of TMsg,
        const Open: bool, const Settings: Dialogs.Options, const Dismiss: TMsg
      ):
        DialogWidget.Draw of TMsg(
          Current,
          Id,
          Base,
          Content,
          Open,
          Settings,
          Dismiss,
          Horizontal,
          Align,
          Visit
        );
        return;
      when E.Element.Deferred(const Id: string, _):
        Visit(Current.Prepared.Subviews[Id].Tree, Current, Horizontal, Align);
        return;
      else
        raise new Sys.InvalidOperationException('An invalid target widget reached GUI drawing.');
    end case;

    Size.Apply(Current.Window, new L.Flex(), Horizontal, Align);
  end procedure;
begin
  State.Window.BeginHostView();
  State.Window.BeginGroup(false, 0, 0, 0, false);
  Visit(State.Prepared.Tree, State, false, L.Alignment.Stretch);
  State.Window.EndGroup();
  State.Window.SizeLast(false, 1, 0, 0, -1, 1, 0);
end procedure;

end unit;
