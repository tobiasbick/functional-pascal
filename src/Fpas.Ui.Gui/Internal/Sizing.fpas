unit Fpas.Ui.Gui.Internal.Sizing;

uses Fpas.Ui.Layout as L, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Graphics as G, System as Sys;

// Resolves a graphical measure and rejects terminal distances.
//
// ## Parameters
// - `Value`: Explicit target distance.
//
// ## Returns
// Logical units.
public function Measure(Value: L.Measure): float;
begin
  case Value of
    when L.Measure.Logical(const Units: int):
      return cast<float>(Units);
    else
      raise new Sys.NotSupportedException('GUI layout requires logical units.');
  end case;
end function;

// Resolves semantic theme spacing.
//
// ## Parameters
// - `Value`: Semantic or explicit spacing.
//
// ## Returns
// Logical distance.
public function Spacing(Value: L.Spacing): float;
begin
  case Value of
    when L.Spacing.None:
      return 0;
    when L.Spacing.Tight:
      return 4;
    when L.Spacing.Normal:
      return 8;
    when L.Spacing.Loose:
      return 16;
    when L.Spacing.Fixed(const Distance: L.Measure):
      return Measure(Distance);
  end case;
end function;

// Native extent encoding shared by widget widths and general layout constraints.
public type NativeExtent = record
  // Content zero, fill one, logical pixels two, or percentage three.
  public Kind: int;
  // Logical pixels or percentage; zero for content and fill.
  public Value: float;
end record;

// Translates an extent for CUI without resolving parent-dependent allocation.
// ## Parameters
// - `Value`: Graphically validated extent.
// ## Returns
// The native bridge kind and its numeric value.
public function Extent(Value: L.Extent): NativeExtent;
begin
  case Value of
    when L.Extent.Content:
      return new NativeExtent(Kind := 0, Value := 0.0F);
    when L.Extent.Fill:
      return new NativeExtent(Kind := 1, Value := 0.0F);
    when L.Extent.Fixed(const Distance: L.Measure):
      return new NativeExtent(Kind := 2, Value := Measure(Distance));
    when L.Extent.Percent(const Percent: float):
      return new NativeExtent(Kind := 3, Value := Percent);
  end case;
end function;

// Applies native edge insets and inherited reading direction to a new container.
// ## Parameters
// - `Window`: Current drawing window, immediately after opening the container.
// - `Settings`: Validated container options.
// - `Layered`: Whether uniform padding still needs applying to a native stack.
public procedure Container(Window: Cui.CuiWindow; Settings: L.Flow; Layered: bool := false);
begin
  const Background: G.Color? := Settings.Background;
  if Background <> null or Settings.CornerRadius > 0.0F then
    Window.SurfaceLast(
      if Background = null then
        0U
      else
        P.Pack(Background)
      end if, Settings.CornerRadius
    );
  end if;

  if not Layered and Settings.PaddingTop = null and Settings.PaddingEnd = null
    and Settings.PaddingBottom = null and Settings.PaddingStart = null
    and Settings.ReadingDirection = L.Direction.Inherit
  then
    return;
  end if;

  Window.LayoutLast(
    Spacing(Settings.PaddingTop ?? Settings.Padding),
    Spacing(Settings.PaddingEnd ?? Settings.Padding),
    Spacing(Settings.PaddingBottom ?? Settings.Padding),
    Spacing(Settings.PaddingStart ?? Settings.Padding),
    cast<int>(Settings.ReadingDirection)
  );
end procedure;

// Applies CUI sizing directly after drawing one child.
//
// ## Parameters
// - `Window`: Owner drawing context.
// - `Value`: Main-axis constraints.
// - `Horizontal`: Parent axis.
// - `Align`: Parent cross-axis alignment.
public procedure Apply(Window: Cui.CuiWindow; Value: L.Flex; Horizontal: bool; Align: L.Alignment);
  procedure Axis(Settings: L.AxisSize?; Width: bool);
  begin
    if Settings = null then
      return;
    end if;
    const Basis: NativeExtent := Extent(Settings.Basis);
    const Minimum: L.Measure? := Settings.Minimum;
    const Maximum: L.Measure? := Settings.Maximum;
    Window.SizeLast(
      Width, Basis.Kind, Basis.Value,
      if Minimum = null then
        0.0F
      else
        Measure(Minimum)
      end if,
      if Maximum = null then
        -1.0F
      else
        Measure(Maximum)
      end if,
      0, 0
    );
  end procedure;
begin
  const Basis: NativeExtent := Extent(Value.Basis);
  var Minimum: float := 0;
  var Maximum: float := -1;
  case Value.Minimum of
    when is L.Measure as Distance:
      Minimum := Measure(Distance);
    else
  end case;

  case Value.Maximum of
    when is L.Measure as Distance:
      Maximum := Measure(Distance);
    else
  end case;

  Window.SizeLast(
    Horizontal,
    Basis.Kind,
    Basis.Value,
    Minimum,
    Maximum,
    Value.Grow,
    cast<int>(Align)
  );
  Axis(Value.Width, true);
  Axis(Value.Height, false);
end procedure;

end unit;
