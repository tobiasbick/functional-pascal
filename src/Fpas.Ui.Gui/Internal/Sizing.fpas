unit Fpas.Ui.Gui.Internal.Sizing;

uses Fpas.Ui.Layout as L, Fpas.Ui.Gui.Cui as Cui, System as Sys;

// Resolves a graphical measure and rejects terminal distances.
//
// ## Parameters
// - `Value`: Explicit target distance.
//
// ## Returns
// Logical units.
public function Measure(Value: L.Measure): float;
begin
  case Value of
    when L.Measure.Logical(const Units: int):
      return cast<float>(Units);
    else
      raise new Sys.NotSupportedException('GUI layout requires logical units.');
  end case;
end function;

// Resolves semantic theme spacing.
//
// ## Parameters
// - `Value`: Semantic or explicit spacing.
//
// ## Returns
// Logical distance.
public function Spacing(Value: L.Spacing): float;
begin
  case Value of
    when L.Spacing.None:
      return 0;
    when L.Spacing.Tight:
      return 4;
    when L.Spacing.Normal:
      return 8;
    when L.Spacing.Loose:
      return 16;
    when L.Spacing.Fixed(const Distance: L.Measure):
      return Measure(Distance);
  end case;
end function;

// Native extent encoding shared by widget widths and general layout constraints.
public type NativeExtent = record
  // Content zero, fill one, logical pixels two, or percentage three.
  public Kind: int;
  // Logical pixels or percentage; zero for content and fill.
  public Value: float;
end record;

// Translates an extent for CUI without resolving parent-dependent allocation.
// ## Parameters
// - `Value`: Graphically validated extent.
// ## Returns
// The native bridge kind and its numeric value.
public function Extent(Value: L.Extent): NativeExtent;
begin
  case Value of
    when L.Extent.Content:
      return new NativeExtent(Kind := 0, Value := 0.0F);
    when L.Extent.Fill:
      return new NativeExtent(Kind := 1, Value := 0.0F);
    when L.Extent.Fixed(const Distance: L.Measure):
      return new NativeExtent(Kind := 2, Value := Measure(Distance));
    when L.Extent.Percent(const Percent: float):
      return new NativeExtent(Kind := 3, Value := Percent);
  end case;
end function;

// Applies CUI sizing directly after drawing one child.
//
// ## Parameters
// - `Window`: Owner drawing context.
// - `Value`: Main-axis constraints.
// - `Horizontal`: Parent axis.
// - `Align`: Parent cross-axis alignment.
public procedure Apply(Window: Cui.CuiWindow; Value: L.Flex; Horizontal: bool; Align: L.Alignment);
begin
  const Basis: NativeExtent := Extent(Value.Basis);
  var Minimum: float := 0;
  var Maximum: float := -1;
  case Value.Minimum of
    when is L.Measure as Distance:
      Minimum := Measure(Distance);
    else
  end case;

  case Value.Maximum of
    when is L.Measure as Distance:
      Maximum := Measure(Distance);
    else
  end case;

  Window.SizeLast(
    Horizontal,
    Basis.Kind,
    Basis.Value,
    Minimum,
    Maximum,
    Value.Grow,
    cast<int>(Align)
  );
end procedure;
end unit;
