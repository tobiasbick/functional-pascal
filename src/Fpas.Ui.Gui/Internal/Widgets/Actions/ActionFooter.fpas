// [Documentation](../../../../../docs/ui/gui/overlays/action-footer.md)

unit Fpas.Ui.Gui.Internal.Widgets.Actions.ActionFooter;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Layout as L;

// Draws children in CUI's native right-aligned footer row.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Drawing context.
// - `Children`: Footer actions in display order.
// - `Visit`: Host traversal for each action.
public procedure Draw of TMsg(
  Frame: C.State of TMsg; Children: array of E.Element of TMsg;
  Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment)
);
begin
  Frame.Window.BeginActionFooter();
  for Child: E.Element of TMsg in Children do
    Visit(Child, Frame, true, L.Alignment.Default);
  end for;

  Frame.Window.EndActionFooter();
end procedure;

end unit;
