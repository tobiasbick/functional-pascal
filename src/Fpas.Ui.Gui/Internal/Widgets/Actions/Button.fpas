// [Documentation](../../../../../docs/ui/gui/actions/button.md)

unit Fpas.Ui.Gui.Internal.Widgets.Actions.Button;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.Buttons as B;

// Draws a native button and routes its activation.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current drawing context.
// - `Id`: Stable control identity.
// - `Label`: Literal visible label.
// - `Message`: Proposed activation message.
// - `Settings`: Model-owned input and appearance options.
public procedure Draw of TMsg(State: C.State of TMsg; Id: string; Label: string; Message: TMsg; Settings: B.Options);
begin
  const Enabled: bool := Settings.Enabled and State.AcceptInput;
  const Token: string := C.Token('button', Id);
  const Focus: bool := C.WantsFocus of TMsg(State, Id, Token, Enabled);
  const Width: float := case Settings.Width of
    when L.Extent.Fixed(const Distance: L.Measure): S.Measure(Distance);
    else -1.0f;
  end case;
  const Fill: bool := case Settings.Width of
    when L.Extent.Fill: true;
    else false;
  end case;
  const Color: G.Color? := Settings.Color;
  const Rgba: uint := if Color = null then
    0u
    // CUI reserves all-zero RGBA for its default. Hidden RGB is immaterial at zero alpha.
  elsif Color.Alpha = 0 then
    1u
  else
    cast Color.Red as uint or (cast Color.Green as uint shl 8)
    or (cast Color.Blue as uint shl 16) or (cast Color.Alpha as uint shl 24)
  end if;
  if State.Window.Button(
    Token, Label, cast Settings.Variant as int, cast Settings.ControlSize as int,
    Enabled, Settings.Loading, Settings.Selected, Focus, Settings.Icon, Settings.IconRight,
    Settings.Tooltip, Settings.Shortcut, Fill, Width, Rgba
  )
  then
    State.Messages.Add(Message);
  end if;

  case Settings.Width of
    when L.Extent.Percent(const Percent: float):
      State.Window.SizeLast(true, 3, Percent, 0, -1, 0, 0);
    else
  end case;

  const Value: string := if Settings.Loading then
    'loading'
  elsif Settings.Selected then
    'true'
  else
    ''
  end if;
  C.Track of TMsg(
    State,
    new App.Control(Id, Label, 'button', new Cui.CuiRectangle(), Enabled, Value := Value)
  );
end procedure;

end unit;
