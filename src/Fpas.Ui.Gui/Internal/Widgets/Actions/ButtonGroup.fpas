// [Documentation](../../../../../docs/ui/gui/actions/button-group.md)

unit Fpas.Ui.Gui.Internal.Widgets.Actions.ButtonGroup;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Layout as L;

// Draws existing buttons inside a native CUI button group.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current frame context.
// - `Children`: Validated buttons in drawing and focus order.
// - `Visit`: Shared host traversal for an individual button.
public procedure Draw of TMsg(
  State: C.State of TMsg; Children: array of E.Element of TMsg;
  Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment)
);
begin
  State.Window.BeginButtonGroup();
  try
    for Child: E.Element of TMsg in Children do
      Visit(Child, State, true, L.Alignment.Default);
    end for;
  finally
    State.Window.EndButtonGroup();
  end try;
end procedure;

end unit;
