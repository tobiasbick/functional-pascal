// [Documentation](../../../../../docs/ui/gui/actions/confirm-button.md)

unit Fpas.Ui.Gui.Internal.Widgets.Actions.ConfirmButton;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Cui.Widgets.Actions as CuiActions;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Actions.ConfirmButtons as Buttons;

// Draws native confirmation and proposes a message only after its second activation.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current frame context.
// - `Id`: Stable control identity.
// - `Label`: Literal resting caption.
// - `Message`: Proposed confirmation message.
// - `Settings`: Confirmation caption, timeout, appearance and input permission.
public procedure Draw of TMsg(
  State: C.State of TMsg;
  Id: string;
  Label: string;
  Message: TMsg;
  Settings: Buttons.Options
);
begin
  const Enabled: bool := Settings.Enabled and State.AcceptInput;
  const Token: string := C.Token('confirm-button', Id);
  const Result: CuiActions.CuiConfirmButtonResult := State.Window.ConfirmButton(
    Token, Label, Settings.ConfirmLabel, Settings.Icon, Settings.TimeoutMilliseconds,
    cast Settings.Variant as int, cast Settings.ControlSize as int, Enabled,
    C.WantsFocus of TMsg(State, Id, Token, Enabled)
  );
  if Result.Confirmed then
    State.Messages.Add(Message);
  end if;

  C.Track of TMsg(
    State, new App.Control(
      Id, if Result.Armed then
        Settings.ConfirmLabel
      else
        Label
      end if,
      'confirm-button', new Cui.CuiRectangle(), Enabled,
      Value := if Result.Armed then
        'armed'
      else
        ''
      end if
    )
  );
end procedure;

end unit;
