unit Fpas.Ui.Gui.Internal.Widgets.Actions.CopyButton;

uses Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Hosting.Context as C, System as Sys;

// Draws a copy button and proposes its message after a clipboard request.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current frame context.
// - `Id`: Stable control identity.
// - `Text`: Literal clipboard text.
// - `OnCopied`: Optional application notification.
// - `Enabled`: Model-owned input permission.
public procedure Draw<TMsg>(State: C.State<TMsg>; Id: string; Text: string; OnCopied: Sys.Func<TMsg>?; Enabled: bool);
begin
  const Allowed: bool := Enabled and State.AcceptInput;
  const Token: string := C.Token('copy-button', Id);
  const Focus: bool := C.WantsFocus<TMsg>(State, Id, Token, Allowed);
  const Events: int := State.Window.CopyButton(Token, Text, Allowed, Focus);
  if (Events and 1) <> 0 then
    case OnCopied of
      when is Sys.Func<TMsg> as Notify:
        State.Messages.Add(Notify.Invoke());
      else
    end case;
  end if;

  const Recent: bool := (Events and 2) <> 0;
  C.Track<TMsg>(
    State, new App.Control(
      Id, if Recent then
        'Copied'
      else
        'Copy'
      end if, 'copy-button',
      new Cui.CuiRectangle(), Allowed and (Events and 4) <> 0,
      Value := if Recent then
        'copied'
      else
        ''
      end if
    )
  );
end procedure;

end unit;
