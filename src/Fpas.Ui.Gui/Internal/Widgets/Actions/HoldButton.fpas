// [Documentation](../../../../../docs/ui/gui/actions/hold-button.md)

unit Fpas.Ui.Gui.Internal.Widgets.Actions.HoldButton;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Actions.HoldButtons as H;

// Draws the native hold action and proposes its message when it completes.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current frame context.
// - `Id`: Stable control identity.
// - `Label`: Visible caption.
// - `Message`: Message proposed once per completed hold.
// - `Settings`: Hold duration and appearance.
public procedure Draw of TMsg(
  State: C.State of TMsg;
  Id: string;
  Label: string;
  Message: TMsg;
  Settings: H.Options
);
begin
  const Enabled: bool := Settings.Enabled and State.AcceptInput;
  const Token: string := C.Token('hold-button', Id);
  const Focus: bool := C.WantsFocus of TMsg(State, Id, Token, Enabled);
  if State.Window.HoldButton(
    Token,
    Label,
    Settings.Icon,
    Settings.DurationMilliseconds,
    cast Settings.Variant as int,
    Enabled,
    Focus
  )
  then
    State.Messages.Add(Message);
  end if;

  C.Track of TMsg(
    State,
    new App.Control(Id, Label, 'hold-button', new Cui.CuiRectangle(), Enabled)
  );
end procedure;

end unit;
