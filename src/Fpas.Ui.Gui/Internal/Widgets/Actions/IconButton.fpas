unit Fpas.Ui.Gui.Internal.Widgets.Actions.IconButton;

uses Fpas.Ui.Widgets.Actions.IconButtons as Icons, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui;

// Draws a native icon button and routes its activation.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current drawing context.
// - `Id`: Stable button identity.
// - `Icon`: Native icon glyph.
// - `Tooltip`: Accessible name and tooltip.
// - `Message`: Proposed activation message.
// - `Settings`: Model-owned input and appearance options.
public procedure Draw<TMsg>(
  State: C.State<TMsg>; Id: string; Icon: string; Tooltip: string; Message: TMsg; Settings: Icons.Options
);
begin
  const Enabled: bool := State.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('icon-button', Id);
  const Focus: bool := C.WantsFocus<TMsg>(State, Id, Token, Enabled);
  if State.Window.IconButton(
    Token,
    Icon,
    Tooltip,
    Settings.Shortcut,
    cast<int>(Settings.Variant),
    cast<int>(Settings.ControlSize),
    Enabled,
    Settings.Loading,
    Settings.Selected,
    Focus
  )
  then
    State.Messages.Add(Message);
  end if;

  C.Track<TMsg>(
    State, new App.Control(
      Id, Tooltip, 'icon-button', new Cui.CuiRectangle(), Enabled,
      Value := if Settings.Loading then
        'loading'
      else
        Settings.Selected.ToString()
      end if
    )
  );
end procedure;

end unit;
