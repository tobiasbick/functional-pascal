// [Documentation](../../../../../docs/ui/gui/actions/icon-button.md)

unit Fpas.Ui.Gui.Internal.Widgets.Actions.IconButton;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icons;

// Draws a native icon button and routes its activation.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current drawing context.
// - `Id`: Stable button identity.
// - `Icon`: Native icon glyph.
// - `Tooltip`: Accessible name and tooltip.
// - `Message`: Proposed activation message.
// - `Settings`: Model-owned input and appearance options.
public procedure Draw of TMsg(
  State: C.State of TMsg; Id: string; Icon: string; Tooltip: string; Message: TMsg; Settings: Icons.Options
);
begin
  const Enabled: bool := State.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('icon-button', Id);
  const Focus: bool := C.WantsFocus of TMsg(State, Id, Token, Enabled);
  if State.Window.IconButton(
    Token,
    Icon,
    Tooltip,
    Settings.Shortcut,
    cast Settings.Variant as int,
    cast Settings.ControlSize as int,
    Enabled,
    Settings.Loading,
    Settings.Selected,
    Focus
  )
  then
    State.Messages.Add(Message);
  end if;

  C.Track of TMsg(
    State, new App.Control(
      Id, Tooltip, 'icon-button', new Cui.CuiRectangle(), Enabled,
      Value := if Settings.Loading then
        'loading'
      else
        Settings.Selected.ToString()
      end if
    )
  );
end procedure;

end unit;
