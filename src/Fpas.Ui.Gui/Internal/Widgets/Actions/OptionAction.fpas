// [Documentation](../../../../../docs/ui/gui/creative-controls/option-action.md)

unit Fpas.Ui.Gui.Internal.Widgets.Actions.OptionAction;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as W;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Widgets.Actions.OptionActions as A;

// Presents the native option field with action.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Current`: Model-owned value.
// - `Change`: Maps a native proposal.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Current: A.Value;
  Change: function(A.Event): TMsg;
  Settings: A.Options
);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Role: string := 'option-action';
  const Token: string := C.Token(Role, Id);
  const Count: int := Current.Items.Length;
  const Parts: array of string := W.Indexed(Count, 'tool');
  const Accept: array of bool := W.Inputs(Parts.Length, Enabled);
  Accept[Count] := Enabled and Settings.ActionEnabled;
  var Next: int := Current.Index;
  const Flags: int := Enc.Bits(Enabled, 1) + Enc.ToolBits(Current.Tool) + Enc.Bits(
    Settings.Plain,
    8
  ) + Enc.Bits(
    Accept[Count],
    16
  );
  const Result: int := Frame.Window.OptionAction(
    Token,
    Current.Label,
    Current.Items,
    ref Next,
    Current.Tool.Icon,
    Current.Tool.Tooltip,
    Settings.Display,
    Flags,
    W.Focus of TMsg(Frame, Id, Role, Parts, Accept, Current.Index),
    W.Tracker of TMsg(Frame, Id, Role, Parts)
  );
  if Result <> 0 then
    Frame.Messages.Add(Change(new A.Event(Next, (Result and 1) <> 0, (Result and 2) <> 0)));
  end if;

  W.Root of TMsg(Frame, Id, Role, Current.Label, false, Next.ToString());
  for Index: int := 0 to Count - 1 do
    W.Part of TMsg(
      Frame,
      Id,
      Role,
      Parts[Index],
      Current.Items[Index],
      Enabled,
      (Index = Next).ToString()
    );
  end for;

  W.Part of TMsg(Frame, Id, Role, 'tool', Current.Tool.Tooltip, Accept[Count], '');
end procedure;

end unit;
