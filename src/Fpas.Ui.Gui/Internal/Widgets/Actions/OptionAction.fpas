unit Fpas.Ui.Gui.Internal.Widgets.Actions.OptionAction;

uses
  Fpas.Ui.Widgets.Actions.OptionActions as A, Fpas.Ui.Gui.Internal.Hosting.Context as C,
  Fpas.Ui.Gui.Internal.Data.CreativeParts as W;

// Presents the native option field with action.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Current`: Model-owned value.
// - `Change`: Maps a native proposal.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Current: A.Value; Change: function(A.Event): TMsg; Settings: A.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Role: string := 'option-action';
  const Token: string := C.Token(Role, Id);
  const Count: int := Current.Items.Length;
  const Parts: array of string := W.Indexed(Count, 'tool');
  const Accept: array of bool := W.Inputs(Parts.Length, Enabled);
  Accept[Count] := Enabled and Settings.ActionEnabled;
  var Next: int := Current.Index;
  const Flags: int := W.Bits(Enabled, 1) + W.ToolBits(Current.Tool) + W.Bits(
    Settings.Plain,
    8
  ) + W.Bits(
    Accept[Count],
    16
  );
  const Result: int := Frame.Window.OptionAction(
    Token,
    Current.Label,
    Current.Items,
    ref Next,
    Current.Tool.Icon,
    Current.Tool.Tooltip,
    Settings.Display,
    Flags,
    W.Focus<TMsg>(Frame, Id, Role, Parts, Accept, Current.Index),
    W.Tracker<TMsg>(Frame, Id, Role, Parts)
  );
  if Result <> 0 then
    Frame.Messages.Add(Change(new A.Event(Next, (Result and 1) <> 0, (Result and 2) <> 0)));
  end if;

  W.Root<TMsg>(Frame, Id, Role, Current.Label, false, Next.ToString());
  for Index: int := 0 to Count - 1 do
    W.Part<TMsg>(
      Frame,
      Id,
      Role,
      Parts[Index],
      Current.Items[Index],
      Enabled,
      (Index = Next).ToString()
    );
  end for;

  W.Part<TMsg>(Frame, Id, Role, 'tool', Current.Tool.Tooltip, Accept[Count], '');
end procedure;

end unit;
