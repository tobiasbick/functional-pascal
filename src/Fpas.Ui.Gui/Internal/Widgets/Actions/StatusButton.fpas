unit Fpas.Ui.Gui.Internal.Widgets.Actions.StatusButton;

uses Fpas.Ui.Widgets.Actions.StatusButtons as B, Fpas.Ui.Internal.Actions.StatusButtons as Text, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Hosting.Context as C;

// Draws native work feedback and proposes a message only for idle activation.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current frame context.
// - `Id`: Stable control identity.
// - `Label`: Literal resting caption.
// - `State`: Model-owned work state.
// - `Message`: Proposed idle action.
// - `Settings`: Feedback captions, appearance and input permission.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Label: string; State: B.Status; Message: TMsg; Settings: B.Options);
begin
  const Enabled: bool := Settings.Enabled and Frame.AcceptInput;
  const Token: string := C.Token('status-button', Id);
  if Frame.Window.StatusButton(
    Token, Label, cast<int>(State), Text.Caption(Label, B.Status.Busy, Settings),
    Settings.SuccessLabel, Settings.ErrorLabel, Settings.Icon,
    cast<int>(Settings.Variant), cast<int>(Settings.ControlSize), Enabled,
    C.WantsFocus<TMsg>(Frame, Id, Token, Enabled)
  )
  then
    Frame.Messages.Add(Message);
  end if;

  C.Track<TMsg>(
    Frame, new App.Control(
      Id, Text.Caption(Label, State, Settings), 'status-button', new Cui.CuiRectangle(), Enabled,
      Value := Text.Value(State)
    )
  );
end procedure;

end unit;
