unit Fpas.Ui.Gui.Internal.Widgets.Actions.SwipeItem;

uses
  Fpas.Ui.Widgets.Actions.SwipeActions as S, Fpas.Ui.Gui.Internal.Hosting.Context as C,
  Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L, System as Sys, System.Collections.Generic as Lists;

// Draws the native swipe row and traverses its foreground.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable row identity.
// - `Content`: Foreground view in native horizontal layout.
// - `Left`: Actions on the left.
// - `Right`: Actions on the right.
// - `OnChoose`: Maps a selected side and index to a message.
// - `Settings`: Decorations and input permission.
// - `Visit`: GUI view traversal.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Content: E.Element<TMsg>; Left: array of S.Item; Right: array of S.Item;
  OnChoose: function(S.Side, int): TMsg; Settings: S.Options;
  Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment)
);
  function ActionId(Index: int): string;
  begin
    return if Index < Left.Length then
      S.ItemId(Id, S.Side.Left, Index)
    else
      S.ItemId(Id, S.Side.Right, Index - Left.Length)
    end if;
  end function;

  procedure Append(Items: array of S.Item);
  begin
    for Item: S.Item in Items do
      Labels.Add(Item.Label);
      Icons.Add(Item.Icon);
      Tones.Add(cast<int>(Item.Tone));
    end for;
  end procedure;
begin
  const Count: int := Left.Length + Right.Length;
  const Labels: Lists.List<string> := new Lists.List<string>(Count);
  const Icons: Lists.List<string> := new Lists.List<string>(Count);
  const Tones: Lists.List<int> := new Lists.List<int>(Count);
  Append(Left);
  Append(Right);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Track: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Index: int): string => C.Token('swipe-action', ActionId(Index))
  end if;
  const Visible: array of int := Frame.Window.BeginSwipeItem(
    C.Token('swipe-row', Id), Labels.ToArray(), Icons.ToArray(), Tones.ToArray(),
    Left.Length, Enabled, Settings.Icon, Track
  );
  Visit(
    Content, Frame with
      AcceptInput := Enabled;
      Interactive := Frame.Interactive and Settings.Enabled;
    end with, true, L.Alignment.Default
  );
  const Result: int := Frame.Window.EndSwipeItem(Settings.Detail);
  if Enabled and Result >= 0 then
    Frame.Messages.Add(
      if Result < 100 then
        OnChoose(S.Side.Left, Result)
      else
        OnChoose(S.Side.Right, Result - 100)
      end if
    );
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(new App.Control(Id, '', 'swipe-row', new Cui.CuiRectangle(), Enabled));
  for Index: int in Visible do
    Frame.Controls.Add(
      new App.Control(
        ActionId(Index), Labels[Index], 'swipe-action', new Cui.CuiRectangle(), Enabled
      )
    );
  end for;
end procedure;

end unit;
