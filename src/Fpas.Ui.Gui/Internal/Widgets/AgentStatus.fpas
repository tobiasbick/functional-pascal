unit Fpas.Ui.Gui.Internal.Widgets.AgentStatus;

uses Fpas.Ui.AgentStatuses as AgentStatuses, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P;

// Presents CUI's native AgentStatus.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Label`: Status label.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Label: string; Settings: AgentStatuses.Options);
begin
  const Role: string := 'agent-status';
  const Token: string := C.Token(Role, Id);
  Frame.Window.AgentStatus(
    Token,
    Label,
    cast<int>(Settings.Status),
    Settings.Seconds,
    Settings.Icon
  );
  P.Root<TMsg>(Frame, Id, Role, Label, false, Settings.Status.ToString());
end procedure;

end unit;
