unit Fpas.Ui.Gui.Internal.Widgets.Ai.AgentPlan;

uses Fpas.Ui.Widgets.Ai.AgentPlans as AgentPlans, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Gui.Cui.Widgets.Ai as CuiAi, System as Sys, System.Collections.Generic as Lists;

// Presents CUI's native AgentPlan.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Steps`: Steps in order.
// - `Changed`: Optional step activation mapper.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Steps: array of AgentPlans.Step; Changed: Sys.Func<int, TMsg>?; Settings: AgentPlans.Options);
begin
  const Role: string := 'agent-plan';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Changed <> null;
  const Native: Lists.List<CuiAi.CuiPlanStep> := new Lists.List<CuiAi.CuiPlanStep>(Steps.Length);
  for Step: AgentPlans.Step in Steps do
    Native.Add(new CuiAi.CuiPlanStep(Step.Title, Step.Detail, cast<int>(Step.Status)));
  end for;
  const Keys: array of string := P.Indexed(Steps.Length);
  const Picked: int := Frame.Window.AgentPlan(
    Token,
    Native.ToArray(),
    Settings.Title,
    Enabled,
    P.Tracker<TMsg>(Frame, Id, Role, Keys)
  );
  P.Root<TMsg>(Frame, Id, Role, Settings.Title, false, '');
  for Index: int := 0 to Steps.Length - 1 do
    P.Part<TMsg>(Frame, Id, Role, Keys[Index], Steps[Index].Title, Enabled, '');
  end for;

  if Picked >= 0 then
    case Changed of
      when is Sys.Func<int, TMsg> as Callback:
        Frame.Messages.Add(Callback.Invoke(Picked));
      else
    end case;
  end if;
end procedure;

end unit;
