// [Documentation](../../../../../docs/ui/gui/ai/agent-status.md)

unit Fpas.Ui.Gui.Internal.Widgets.Ai.AgentStatus;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Widgets.Ai.AgentStatuses as AgentStatuses;

// Presents CUI's native AgentStatus.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Label`: Status label.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Label: string; Settings: AgentStatuses.Options);
begin
  const Role: string := 'agent-status';
  const Token: string := C.Token(Role, Id);
  Frame.Window.AgentStatus(
    Token,
    Label,
    cast<int>(Settings.Status),
    Settings.Seconds,
    Settings.Icon
  );
  P.Root of TMsg(Frame, Id, Role, Label, false, Settings.Status.ToString());
end procedure;

end unit;
