// [Documentation](../../../../../docs/ui/gui/ai/citation.md)

unit Fpas.Ui.Gui.Internal.Widgets.Ai.Citation;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.AiData as Data;
uses Fpas.Ui.Widgets.Ai.Citations as Citations;
uses Fpas.Ui.Widgets.Ai.Sources as Sources;

uses System as Sys;

// Presents CUI's native Citation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Number`: Displayed citation number when there is no domain.
// - `Source`: Optional source and hover preview.
// - `Activate`: Optional activation.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Number: int;
  Source: Sources.Item?;
  Activate: (Sys.Func of TMsg)?;
  Settings: Citations.Options
);
begin
  const Role: string := 'citation';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled);
  const Clicked: bool := Frame.Window.Citation(
    Token, Number, if Source = null then
      null
    else
      Data.Source(Source)
    end if,
    Enc.Bits(Enabled, 1) or Enc.Bits(Focus, 2)
  );
  P.Root of TMsg(
    Frame, Id, Role, if Source = null then
      Number.ToString()
    else
      Source.Title
    end if, Enabled, ''
  );
  if Clicked then
    case Activate of
      when is Sys.Func of TMsg as Callback:
        Frame.Messages.Add(Callback.Invoke());
      else
    end case;
  end if;
end procedure;

end unit;
