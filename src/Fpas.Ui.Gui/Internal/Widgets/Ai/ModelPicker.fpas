// [Documentation](../../../../../docs/ui/gui/ai/model-picker.md)

unit Fpas.Ui.Gui.Internal.Widgets.Ai.ModelPicker;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.AiData as Data;
uses Fpas.Ui.Widgets.Ai.ModelPickers as ModelPickers;

// Presents CUI's native ModelPicker.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Items`: Available models.
// - `Selected`: Selected model index.
// - `Changed`: Maps the proposed index.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Items: array of ModelPickers.Item;
  Selected: int;
  Changed: function(int): TMsg;
  Settings: ModelPickers.Options
);
begin
  const Role: string := 'model-picker';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Items.Length > 0;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled);
  const Next: int := Frame.Window.ModelPicker(
    Token, Data.Models(Items), Selected, cast Settings.Placement as int,
    Enc.Bits(Enabled, 1) or Enc.Bits(Focus, 2) or Enc.Bits(Settings.Ghost, 4)
  );
  P.Root of TMsg(
    Frame, Id, Role, if Items.Length = 0 then
      ''
    else
      Items[Selected].Name
    end if, Enabled, Selected.ToString()
  );
  if Enabled and Next <> Selected then
    Frame.Messages.Add(Changed(Next));
  end if;
end procedure;

end unit;
