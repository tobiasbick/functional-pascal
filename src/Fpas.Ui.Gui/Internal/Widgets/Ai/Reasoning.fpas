// [Documentation](../../../../../docs/ui/gui/ai/reasoning.md)

unit Fpas.Ui.Gui.Internal.Widgets.Ai.Reasoning;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Ai.Reasonings as Reasonings;

// Presents CUI's native Reasoning.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Bodies`: Composed reasoning body.
// - `Settings`: Native options.
// - `Visit`: Draws composed children.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Bodies: array of E.Element of TMsg;
  Settings: Reasonings.Options;
  Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment)
);
begin
  const Role: string := 'reasoning';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Header: string := C.Token(Role, Id + '/toggle');
  const Focus: bool := C.WantsFocus of TMsg(
    Frame,
    Id + '/toggle',
    Header,
    Enabled
  ) or C.WantsFocus of TMsg(Frame, Id, Header, Enabled);
  const Status: int := Frame.Window.BeginReasoning(
    Token, Settings.Thinking, Settings.Seconds, Settings.Title,
    Enc.Bits(Enabled, 1) or Enc.Bits(Focus, 2), if Frame.PaintingClosed then
      null
    else
      Header
    end if
  );
  const Open: bool := (Status and 2) <> 0;
  if (Status and 1) <> 0 then
    for Body: E.Element of TMsg in Bodies do
      Visit(
        Body, Frame with
          AcceptInput := Enabled and Open;
          Interactive := Frame.Interactive and Settings.Enabled and Open;
          PaintingClosed := Frame.PaintingClosed or not Open;
        end with, false, L.Alignment.Default
      );
    end for;

    Frame.Window.EndReasoning();
  end if;

  P.Root of TMsg(Frame, Id, Role, Settings.Title, false, Open.ToString());
  P.Part of TMsg(Frame, Id, Role, 'toggle', Settings.Title, Enabled, Open.ToString());
end procedure;

end unit;
