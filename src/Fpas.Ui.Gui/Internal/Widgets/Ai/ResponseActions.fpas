// [Documentation](../../../../../docs/ui/gui/ai/response-actions.md)

unit Fpas.Ui.Gui.Internal.Widgets.Ai.ResponseActions;

uses Fpas.Ui.Gui.Cui.Widgets.Ai as CuiAi;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.AiData as Data;
uses Fpas.Ui.Widgets.Ai.ResponseActions as ResponseActions;

// Presents CUI's native ResponseActions.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Vote`: Current vote: minus one, zero or one. Null leaves votes momentary.
// - `Changed`: Maps a native action.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Vote: int?; Changed: function(ResponseActions.Event): TMsg; Settings: ResponseActions.Options);
begin
  const Role: string := 'response-actions';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Keys: array of string := ['copy', 'regenerate', 'up', 'down', 'share'];
  const Result: CuiAi.CuiResponseResult := Frame.Window.ResponseActions(
    Token, Settings.CopyText, Vote,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.HideRegenerate, 2) or Enc.Bits(Settings.HideShare, 4),
    P.Tracker of TMsg(Frame, Id, Role, Keys)
  );
  P.Root of TMsg(Frame, Id, Role, '', false, (Vote ?? 0).ToString());
  Data.Parts of TMsg(Frame, Id, Role, Keys, Result.Parts, Enabled);
  if (Result.Events and 1) <> 0 then
    Frame.Messages.Add(Changed(ResponseActions.Event.Copy));
  end if;

  if (Result.Events and 2) <> 0 then
    Frame.Messages.Add(Changed(ResponseActions.Event.Regenerate));
  end if;

  if (Result.Events and 12) <> 0 then
    const Proposed: int := if Vote <> null then
      Result.Vote
    elsif (Result.Events and 4) <> 0 then
      1
    else
      -1
    end if;
    Frame.Messages.Add(Changed(ResponseActions.Event.Vote(Proposed)));
  end if;

  if (Result.Events and 16) <> 0 then
    Frame.Messages.Add(Changed(ResponseActions.Event.Share));
  end if;
end procedure;

end unit;
