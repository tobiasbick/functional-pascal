// [Documentation](../../../../../docs/ui/gui/ai/source-list.md)

unit Fpas.Ui.Gui.Internal.Widgets.Ai.SourceList;

uses Fpas.Ui.Gui.Cui.Widgets.Ai as CuiAi;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.AiData as Data;
uses Fpas.Ui.Widgets.Ai.SourceLists as SourceLists;
uses Fpas.Ui.Widgets.Ai.Sources as Sources;

uses System as Sys;
uses System.Collections.Generic as Lists;

// Presents CUI's native SourceList.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Documents`: Documents in display order.
// - `Changed`: Optional source activation mapper.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Documents: array of Sources.Item; Changed: Sys.Func of (int, TMsg)?; Settings: SourceLists.Options);
begin
  const Role: string := 'source-list';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Native: Lists.List of CuiAi.CuiSourceItem := new Lists.List of CuiAi.CuiSourceItem(
    Documents.Length
  );
  for Document: Sources.Item in Documents do
    Native.Add(Data.Source(Document));
  end for;
  const Keys: array of string := P.Indexed(Documents.Length);
  const Focus: int := P.Focus of TMsg(Frame, Id, Role, Keys, P.Inputs(Keys.Length, Enabled), 0);
  const Picked: int := Frame.Window.SourceList(
    Token,
    Native.ToArray(),
    Enabled,
    Focus,
    P.Tracker of TMsg(Frame, Id, Role, Keys)
  );
  P.Root of TMsg(Frame, Id, Role, '', false, '');
  for Index: int := 0 to Documents.Length - 1 do
    P.Part of TMsg(Frame, Id, Role, Keys[Index], Documents[Index].Title, Enabled, '');
  end for;

  if Picked >= 0 then
    case Changed of
      when is Sys.Func of (int, TMsg) as Callback:
        Frame.Messages.Add(Callback.Invoke(Picked));
      else
    end case;
  end if;
end procedure;

end unit;
