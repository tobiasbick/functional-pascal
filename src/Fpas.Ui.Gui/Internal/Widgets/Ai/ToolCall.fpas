// [Documentation](../../../../../docs/ui/gui/ai/tool-call.md)

unit Fpas.Ui.Gui.Internal.Widgets.Ai.ToolCall;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Widgets.Ai.ToolCalls as ToolCalls;

// Presents CUI's native ToolCall.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Name`: Displayed tool name.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Name: string;
  Settings: ToolCalls.Options
);
begin
  const Role: string := 'tool-call';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and (Settings.Input <> ''
    or Settings.Output <> '');
  const Header: string := C.Token(Role, Id + '/toggle');
  const Focus: bool := C.WantsFocus of TMsg(
    Frame,
    Id + '/toggle',
    Header,
    Enabled
  ) or C.WantsFocus of TMsg(Frame, Id, Header, Enabled);
  const Open: bool := Frame.Window.ToolCall(
    Token, Name, cast Settings.Status as int, Settings.Icon, Settings.Detail,
    Settings.Input, Settings.Output, Settings.Seconds, Enc.Bits(Enabled, 1) or Enc.Bits(Focus, 2),
    if Frame.PaintingClosed then
      null
    else
      Header
    end if
  );
  P.Root of TMsg(Frame, Id, Role, Name, false, Open.ToString());
  P.Part of TMsg(Frame, Id, Role, 'toggle', Name, Enabled, Open.ToString());
end procedure;

end unit;
