// [Documentation](../../../../../docs/ui/gui/audio/fader.md)

unit Fpas.Ui.Gui.Internal.Widgets.Audio.Fader;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Data.ChartData as ChartData;
uses Fpas.Ui.Widgets.Audio.Faders as W;

uses System.Globalization as Culture;

// Draws the native mixer fader and forwards proposed values.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable control identity.
// - `Label`: Literal caption.
// - `Value`: Model-owned value.
// - `Minimum`: Inclusive lower bound.
// - `Maximum`: Inclusive upper bound.
// - `OnChange`: Maps a proposed value to a message.
// - `Settings`: Native display and input settings.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Label: string;
  Value: float;
  Minimum: float;
  Maximum: float;
  OnChange: function(float): TMsg;
  Settings: W.Options
);
begin
  const Enabled: bool := Settings.Enabled and Frame.AcceptInput;
  const Role: string := 'fader';
  const Token: string := C.Token(Role, Id);
  const Proposed: float := Frame.Window.Fader(
    Token,
    Label,
    Value,
    Minimum,
    Maximum,
    Settings.Step,
    Settings.Reset,
    ChartData.Format(Settings.Format),
    Settings.UnitLabel,
    Settings.HideValue,
    Settings.Length,
    Settings.Horizontal,
    Settings.Ticks,
    Settings.Levels,
    Enabled,
    C.WantsFocus of TMsg(Frame, Id, Token, Enabled),
    not Frame.PaintingClosed
  );
  if Proposed <> Value then
    Frame.Messages.Add(OnChange(Proposed));
  end if;

  if not Frame.PaintingClosed then
    Frame.Controls.Add(
      new App.Control(
        Id, Label, Role, new Cui.CuiRectangle(), Enabled,
        Value := Value.ToString(Culture.CultureInfo.InvariantCulture)
      )
    );
  end if;
end procedure;

end unit;
