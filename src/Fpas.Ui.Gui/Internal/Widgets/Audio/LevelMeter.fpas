unit Fpas.Ui.Gui.Internal.Widgets.Audio.LevelMeter;

uses
  Fpas.Ui.Widgets.Audio.LevelMeters as M, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.Hosting.Context as C, System as Sys;

// Draws the native level bars and forwards a clip reset if requested.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable meter identity.
// - `Peaks`: Linear channel peaks.
// - `Settings`: Native meter settings.
// - `OnClipCleared`: Optional message on a clip reset.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Peaks: array of float; Settings: M.Options; OnClipCleared: Sys.Func<TMsg>?
);
begin
  const Role: string := 'level-meter';
  const Cleared: bool := Frame.Window.LevelMeter(
    C.Token(Role, Id), Peaks, Settings.MinimumDb, Settings.MaximumDb, Settings.Length,
    Settings.Thickness, Settings.Horizontal, Settings.Scale, Settings.Segmented, Settings.Hold,
    Settings.Decay, Frame.AcceptInput, not Frame.PaintingClosed
  );
  if Cleared then
    case OnClipCleared of
      when is Sys.Func<TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke());
      else
    end case;
  end if;

  if not Frame.PaintingClosed then
    Frame.Controls.Add(new App.Control(Id, '', Role, new Cui.CuiRectangle(), Frame.AcceptInput));
  end if;
end procedure;

end unit;
