// [Documentation](../../../../../docs/ui/gui/voice/voice-note.md)

unit Fpas.Ui.Gui.Internal.Widgets.Audio.VoiceNote;

uses Fpas.Ui.Gui.Cui.Widgets.Audio as CuiAudio;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.AiData as Data;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Audio.VoiceNotes as VoiceNotes;

// Presents CUI's native VoiceNote.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable message identity.
// - `Levels`: The clip's measured levels.
// - `Playback`: Model-owned transport state.
// - `Changed`: Maps a transport proposal.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Levels: array of float;
  Playback: VoiceNotes.Value;
  Changed: function(VoiceNotes.Event): TMsg;
  Settings: VoiceNotes.Options
);
begin
  const Role: string := 'voice-note';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Keys: array of string := ['play', 'seek', 'speed'];
  const Accept: array of bool := [Enabled, Enabled and Playback.Duration > 0.0F, Enabled];
  const Focus: int := P.Focus of TMsg(Frame, Id, Role, Keys, Accept, 0);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiAudio.CuiVoiceNoteResult := Frame.Window.VoiceNote(
    Token,
    Levels,
    Playback.Duration,
    Playback.Position,
    Playback.Speed,
    Playback.Playing,
    Width.Kind,
    Width.Value,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.Mine, 2),
    Focus,
    P.Tracker of TMsg(Frame, Id, Role, Keys)
  );
  P.Root of TMsg(Frame, Id, Role, '', false, Playback.Position.ToString());
  Data.Parts of TMsg(Frame, Id, Role, Keys, Result.Parts, Enabled);
  if (Result.Events and 1) <> 0 then
    Frame.Messages.Add(Changed(VoiceNotes.Event.Toggle(Result.Playing)));
  end if;

  if (Result.Events and 8) <> 0 then
    Frame.Messages.Add(Changed(VoiceNotes.Event.Seek(Result.Position)));
  end if;

  if (Result.Events and 16) <> 0 then
    Frame.Messages.Add(Changed(VoiceNotes.Event.Speed(Result.Speed)));
  end if;
end procedure;

end unit;
