// [Documentation](../../../../../docs/ui/gui/voice/voice-orb.md)

unit Fpas.Ui.Gui.Internal.Widgets.Audio.VoiceOrb;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Colors;
uses Fpas.Ui.Widgets.Audio.Voice as Voice;
uses Fpas.Ui.Widgets.Audio.VoiceOrbs as VoiceOrbs;

uses System as Sys;

// Presents CUI's native VoiceOrb.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable orb identity.
// - `Mode`: Voice activity visualized by the orb.
// - `Level`: Current level from zero to one.
// - `Activate`: Optional activation.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Mode: Voice.Activity; Level: float; Activate: (Sys.Func of TMsg)?; Settings: VoiceOrbs.Options);
begin
  const Role: string := 'voice-orb';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Activate <> null;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled);
  const Clicked: bool := Frame.Window.VoiceOrb(
    Token, cast Mode as int, Level, Settings.Size, Colors.Color(Settings.Color),
    Enc.Bits(Enabled, 1) or Enc.Bits(Focus, 2)
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, Mode.ToString());
  if Clicked then
    case Activate of
      when is Sys.Func of TMsg as Callback:
        Frame.Messages.Add(Callback.Invoke());
      else
    end case;
  end if;
end procedure;

end unit;
