unit Fpas.Ui.Gui.Internal.Widgets.Audio.VoiceOrb;

uses Fpas.Ui.Widgets.Audio.VoiceOrbs as VoiceOrbs, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Widgets.Audio.Voice as Voice, System as Sys, Fpas.Ui.Gui.Internal.Data.ChartData as Colors;

// Presents CUI's native VoiceOrb.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable orb identity.
// - `Mode`: Voice activity visualized by the orb.
// - `Level`: Current level from zero to one.
// - `Activate`: Optional activation.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Mode: Voice.Activity; Level: float; Activate: Sys.Func<TMsg>?; Settings: VoiceOrbs.Options);
begin
  const Role: string := 'voice-orb';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Activate <> null;
  const Focus: bool := C.WantsFocus<TMsg>(Frame, Id, Token, Enabled);
  const Clicked: bool := Frame.Window.VoiceOrb(
    Token, cast<int>(Mode), Level, Settings.Size, Colors.Color(Settings.Color),
    P.Bits(Enabled, 1) or P.Bits(Focus, 2)
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, Mode.ToString());
  if Clicked then
    case Activate of
      when is Sys.Func<TMsg> as Callback:
        Frame.Messages.Add(Callback.Invoke());
      else
    end case;
  end if;
end procedure;

end unit;
