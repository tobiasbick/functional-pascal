// [Documentation](../../../../../docs/ui/gui/voice/voice-session.md)

unit Fpas.Ui.Gui.Internal.Widgets.Audio.VoiceSession;

uses Fpas.Ui.Gui.Cui.Widgets.Ai as CuiAi;
uses Fpas.Ui.Gui.Cui.Widgets.Audio as CuiAudio;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.AiData as Data;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Audio.Voice as Voice;
uses Fpas.Ui.Widgets.Audio.VoiceSessions as VoiceSessions;

// Presents CUI's native VoiceSession.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable session identity.
// - `Mode`: Current conversation activity.
// - `Signal`: The shared timeline.
// - `Muted`: Microphone state, or null to omit the button.
// - `Changed`: Maps a call action.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Mode: Voice.Activity;
  Signal: Voice.Signal;
  Muted: bool?;
  Changed: function(VoiceSessions.Event): TMsg;
  Settings: VoiceSessions.Options
);
begin
  const Role: string := 'voice-session';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Keys: array of string := ['mute', 'end'];
  const Focus: int := P.Focus of TMsg(
    Frame, Id, Role, Keys, [Enabled and Muted <> null, Enabled and not Settings.HideEnd],
    if Muted <> null then
      0
    else
      1
    end if
  );
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Labels: CuiAi.CuiVoiceSessionText := new CuiAi.CuiVoiceSessionText(
    Settings.Label, Settings.Transcript, Settings.Upcoming,
    cast Settings.Speaker as int, Settings.You, Settings.Assistant
  );
  const Result: CuiAudio.CuiVoiceSessionResult := Frame.Window.VoiceSession(
    Token, cast Mode as int, Signal.Levels, Signal.Owners,
    Labels, Muted, Width.Kind, Width.Value, Enc.Bits(Enabled, 1) or Enc.Bits(Settings.HideEnd, 2),
    Focus, P.Tracker of TMsg(Frame, Id, Role, Keys)
  );
  P.Root of TMsg(Frame, Id, Role, Settings.Label, false, Mode.ToString());
  Data.Parts of TMsg(Frame, Id, Role, Keys, Result.Parts, Enabled);
  if (Result.Events and 1) <> 0 then
    Frame.Messages.Add(Changed(VoiceSessions.Event.Mute(Result.Muted)));
  end if;

  if (Result.Events and 2) <> 0 then
    Frame.Messages.Add(Changed(VoiceSessions.Event.EndCall));
  end if;
end procedure;

end unit;
