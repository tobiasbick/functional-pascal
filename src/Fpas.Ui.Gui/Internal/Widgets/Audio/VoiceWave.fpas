// [Documentation](../../../../../docs/ui/gui/voice/voice-waveform.md)

unit Fpas.Ui.Gui.Internal.Widgets.Audio.VoiceWave;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Colors;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Audio.Voice as Voice;
uses Fpas.Ui.Widgets.Audio.VoiceWaves as VoiceWaves;

uses System as Sys;

// Presents CUI's native VoiceWave.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable waveform identity.
// - `Signal`: Ordered levels and optional speaker tags.
// - `Progress`: Current played fraction, or null for passive rendering.
// - `Changed`: Maps a seek proposal.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Signal: Voice.Signal;
  Progress: float?;
  Changed: Sys.Func of (float, TMsg)?;
  Settings: VoiceWaves.Options
);
begin
  const Role: string := 'voice-wave';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Changed <> null;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Next: float := Frame.Window.VoiceWave(
    Token, Signal.Levels, Signal.Owners, Progress, Width.Kind, Width.Value,
    Settings.Pitch, Settings.Step, cast Settings.Owner as int, Colors.Color(Settings.Color),
    Enc.Bits(Enabled, 1) or Enc.Bits(Focus, 2) or Enc.Bits(Settings.Clip, 4)
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, (Progress ?? 0.0F).ToString());
  if Enabled and Next <> Progress then
    case Changed of
      when is Sys.Func of (float, TMsg) as Callback:
        Frame.Messages.Add(Callback.Invoke(Next));
      else
    end case;
  end if;
end procedure;

end unit;
