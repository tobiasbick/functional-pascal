unit Fpas.Ui.Gui.Internal.Widgets.Audio.VoiceWave;

uses Fpas.Ui.Widgets.Audio.VoiceWaves as VoiceWaves, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Widgets.Audio.Voice as Voice, System as Sys, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Internal.Data.ChartData as Colors;

// Presents CUI's native VoiceWave.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable waveform identity.
// - `Signal`: Ordered levels and optional speaker tags.
// - `Progress`: Current played fraction, or null for passive rendering.
// - `Changed`: Maps a seek proposal.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Signal: Voice.Signal; Progress: float?; Changed: Sys.Func<float, TMsg>?; Settings: VoiceWaves.Options);
begin
  const Role: string := 'voice-wave';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Changed <> null;
  const Focus: bool := C.WantsFocus<TMsg>(Frame, Id, Token, Enabled);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Next: float := Frame.Window.VoiceWave(
    Token, Signal.Levels, Signal.Owners, Progress, Width.Kind, Width.Value,
    Settings.Pitch, Settings.Step, cast<int>(Settings.Owner), Colors.Color(Settings.Color),
    P.Bits(Enabled, 1) or P.Bits(Focus, 2) or P.Bits(Settings.Clip, 4)
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, (Progress ?? 0.0F).ToString());
  if Enabled and Next <> Progress then
    case Changed of
      when is Sys.Func<float, TMsg> as Callback:
        Frame.Messages.Add(Callback.Invoke(Next));
      else
    end case;
  end if;
end procedure;

end unit;
