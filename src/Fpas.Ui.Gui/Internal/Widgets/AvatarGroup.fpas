unit Fpas.Ui.Gui.Internal.Widgets.AvatarGroup;

uses Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.AvatarGroups as A;

// Draws native overlapping avatars and the overflow count.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable group identity.
// - `Names`: Names in display order.
// - `Settings`: Avatar diameter and visible limit.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Names: array of string; Settings: A.Options);
begin
  Frame.Window.AvatarGroup(Names, Settings.MaximumVisible, Settings.Size);
  C.Track<TMsg>(Frame, new App.Control(Id, '', 'avatar-group', new Cui.CuiRectangle(), false));
end procedure;

end unit;
