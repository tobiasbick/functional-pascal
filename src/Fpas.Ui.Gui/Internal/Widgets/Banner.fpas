unit Fpas.Ui.Gui.Internal.Widgets.Banner;

uses
  Fpas.Ui.Banners as B, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, System as Sys;

// Draws a native banner and forwards its action and dismissal.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation state.
// - `Id`: Stable banner identity.
// - `Text`: Literal announcement.
// - `Open`: Model-owned visibility.
// - `OnDismiss`: Optional dismissal message factory.
// - `OnAction`: Optional activation message factory.
// - `Settings`: Native presentation and input options.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Text: string; Open: bool;
  OnDismiss: Sys.Func<TMsg>?; OnAction: Sys.Func<TMsg>?; Settings: B.Options
);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Open;
  const ActionId: string := B.ActionId(Id);
  const DismissId: string := B.DismissId(Id);
  const ActionToken: string := C.Token('banner-action', ActionId);
  const DismissToken: string := C.Token('banner-dismiss', DismissId);
  const Focus: int := if OnAction <> null and C.WantsFocus<TMsg>(
    Frame,
    ActionId,
    ActionToken,
    Enabled
  )
  then
    1
  elsif OnDismiss <> null and C.WantsFocus<TMsg>(Frame, DismissId, DismissToken, Enabled) then
    2
  else
    0
  end if;
  const Result: Cui.CuiBannerResult := Frame.Window.Banner(
    C.Token('banner', Id),
    Text,
    Open,
    Settings.ActionLabel,
    Settings.Icon,
    cast<int>(Settings.Tone),
    OnDismiss <> null,
    Enabled,
    Focus,
    ActionToken,
    DismissToken,
    not Frame.PaintingClosed
  );
  if Result.Activated then
    case OnAction of
      when is Sys.Func<TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke());
      else
    end case;
  end if;

  if Result.Dismissed then
    case OnDismiss of
      when is Sys.Func<TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke());
      else
    end case;
  end if;

  if not Frame.PaintingClosed and Result.Visible then
    Frame.Controls.Add(new App.Control(Id, Text, 'banner', new Cui.CuiRectangle(), Enabled));
    if Result.HasAction then
      Frame.Controls.Add(
        new App.Control(
          ActionId,
          Settings.ActionLabel,
          'banner-action',
          new Cui.CuiRectangle(),
          Enabled
        )
      );
    end if;

    if Result.HasDismiss then
      Frame.Controls.Add(
        new App.Control(DismissId, 'Dismiss', 'banner-dismiss', new Cui.CuiRectangle(), Enabled)
      );
    end if;
  end if;
end procedure;

end unit;
