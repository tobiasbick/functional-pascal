unit Fpas.Ui.Gui.Internal.Widgets.CalendarHeatmap;

uses
  Fpas.Ui.CalendarHeatmaps as W, Fpas.Ui.Charts as Ch, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.ChartData as Data,
  Fpas.Ui.Gui.Internal.Sizing as Sizing, Fpas.Ui.Gui.Application as App, System as Sys;

// Presents the native calendar-heatmap and forwards its activation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable identity.
// - `Start`: Date of the first sample.
// - `Values`: One finite sample per day; nonpositive amounts leave empty squares.
// - `Settings`: Native presentation.
// - `OnActivate`: Optional native click callback.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Start: Sys.DateOnly; Values: array of float; Settings: W.Options; OnActivate: Sys.Func<Sys.DateOnly, TMsg>?);
begin
  const Token: string := C.Token('calendar-heatmap', Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Options: Cui.CuiCalendarHeatmapOptions := new Cui.CuiCalendarHeatmapOptions(
    Settings.CellSize, Data.Color(Settings.Color), Data.Format(Settings.Format), Settings.Unit
  );
  const Clicked: int := Frame.Window.CalendarHeatmap(
    Token,
    Start,
    Values,
    Options,
    Enabled,
    not Frame.PaintingClosed
  );
  if Enabled and Clicked >= 0 then
    case OnActivate of
      when is Sys.Func<Sys.DateOnly, TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke(Start.AddDays(Clicked)));
      else
    end case;
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(Id, 'CalendarHeatmap', 'calendar-heatmap', new Cui.CuiRectangle(), Enabled)
  );
end procedure;

end unit;
