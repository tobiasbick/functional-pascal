unit Fpas.Ui.Gui.Internal.Widgets.Canvas.Canvas;

uses
  Fpas.Ui.Widgets.Canvas.Canvases as D, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P,
  Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Graphics as G, Fpas.Ui.Gui.Cui.Widgets.Canvas as CuiCanvas;

function Pack(Shape: D.Shape): CuiCanvas.CuiDrawingShape;
begin
  return case Shape of
    when D.Shape.Rectangle(
      const X: float,
      const Y: float,
      const W: float,
      const H: float,
      const Radius: float,
      const Color: G.Color
    ): new CuiCanvas.CuiDrawingShape(0, X, Y, W, H, Radius, P.Pack(Color));
    when D.Shape.Circle(
      const X: float,
      const Y: float,
      const Radius: float,
      const Color: G.Color
    ): new CuiCanvas.CuiDrawingShape(1, X, Y, 0.0F, 0.0F, Radius, P.Pack(Color));
    when D.Shape.Line(
      const X: float,
      const Y: float,
      const EndX: float,
      const EndY: float,
      const Thickness: float,
      const Color: G.Color
    ): new CuiCanvas.CuiDrawingShape(2, X, Y, EndX, EndY, Thickness, P.Pack(Color));
  end case;
end function;

// Draws the native CUI canvas.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable canvas identity.
// - `Drawing`: Draw commands in paint order.
// - `Clicked`: Maps native activation to an application message.
// - `Settings`: Native canvas options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Drawing: array of D.Shape; Clicked: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'canvas';
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Height: S.NativeExtent := S.Extent(Settings.Height);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Shapes: array of CuiCanvas.CuiDrawingShape := new CuiCanvas.CuiDrawingShape[Drawing.Length];
  for Index: int := 0 to Drawing.Length - 1 do
    Shapes[Index] := Pack(Drawing[Index]);
  end for;
  var X: float := 0.0F;
  var Y: float := 0.0F;
  var W: float := 0.0F;
  var H: float := 0.0F;
  if Frame.Window.DrawingCanvas(
    C.Token(Role, Id), Width.Kind, Width.Value, Height.Kind, Height.Value,
    Shapes, Enabled, out X, out Y, out W, out H
  )
  then
    Frame.Messages.Add(Clicked(new D.Event(X, Y, W, H)));
  end if;

  P.Root<TMsg>(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
