// [Documentation](../../../../../docs/ui/gui/text-and-display/canvas.md)

unit Fpas.Ui.Gui.Internal.Widgets.Canvas.Canvas;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Gui.Cui.Widgets.Canvas as CuiCanvas;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Gui.Internal.Widgets.Canvas.PaintSurface as Surface;
uses Fpas.Ui.Widgets.Canvas.Canvases as D;
uses Fpas.Ui.Widgets.Canvas.Painting as Painting;
uses Fpas.Ui.Widgets.Inputs.ShortcutRecorders as Keys;

uses System as Sys;

function Pack(Shape: D.Shape): CuiCanvas.CuiDrawingShape;
begin
  return case Shape of
    when D.Shape.Rectangle(
      const X: float,
      const Y: float,
      const W: float,
      const H: float,
      const Radius: float,
      const Color: G.Color
    ): new CuiCanvas.CuiDrawingShape(0, X, Y, W, H, Radius, Enc.Pack(Color));
    when D.Shape.Circle(
      const X: float,
      const Y: float,
      const Radius: float,
      const Color: G.Color
    ): new CuiCanvas.CuiDrawingShape(1, X, Y, 0.0F, 0.0F, Radius, Enc.Pack(Color));
    when D.Shape.Line(
      const X: float,
      const Y: float,
      const EndX: float,
      const EndY: float,
      const Thickness: float,
      const Color: G.Color
    ): new CuiCanvas.CuiDrawingShape(2, X, Y, EndX, EndY, Thickness, Enc.Pack(Color));
  end case;
end function;

// Draws the native CUI canvas.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable canvas identity.
// - `Drawing`: Draw commands in paint order.
// - `Clicked`: Maps native activation to an application message.
// - `Settings`: Native canvas options.
// - `OnWheel`: Optional horizontal/vertical wheel mapper.
// - `Paint`: Optional deferred drawing capability, scoped to one native callback.
// - `OnPointer`: Optional changed-state pointer mapper.
// - `OnInput`: Optional ordered key, text and focus mapper.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Drawing: array of D.Shape; Clicked: function(D.Event): TMsg; Settings: D.Options; OnWheel: Sys.Func of (D.Wheel, TMsg)?; Paint: (Sys.Action of Painting.Surface)?; OnPointer: Sys.Func of (D.Pointer, TMsg)?; OnInput: Sys.Func of (D.Input, TMsg)?);
begin
  const Role: string := 'canvas';
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Height: S.NativeExtent := S.Extent(Settings.Height);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token(Role, Id);
  const Focusable: bool := Settings.Focusable or OnInput <> null;
  const PreserveFocus: bool := Frame.PreserveCanvasFocus and Settings.Enabled and Focusable
    and Frame.PreviousFocus = Token;
  const Shapes: array of CuiCanvas.CuiDrawingShape := new CuiCanvas.CuiDrawingShape[Drawing.Length];
  for Index: int := 0 to Drawing.Length - 1 do
    Shapes[Index] := Pack(Drawing[Index]);
  end for;
  var X: float := 0.0F;
  var Y: float := 0.0F;
  var W: float := 0.0F;
  var H: float := 0.0F;
  var WheelX: float := 0.0F;
  var WheelY: float := 0.0F;
  const NativePaint: (Sys.Action of CuiCanvas.CuiCanvasPainter)? := case Paint of
    when is Sys.Action of Painting.Surface as Draw: procedure(Painter: CuiCanvas.CuiCanvasPainter) begin
      Draw.Invoke(new Surface.Adapter(Painter));
    end procedure;
    else null;
  end case;
  const NativePointer: (Sys.Action of CuiCanvas.CuiCanvasPointer)? := case OnPointer of
    when is Sys.Func of (D.Pointer, TMsg) as Notify: procedure(State: CuiCanvas.CuiCanvasPointer) begin
      if Frame.AcceptInput then
        Frame.Messages.Add(
          Notify.Invoke(
            new D.Pointer(State.Hovered, State.Pressed, State.X, State.Y, State.Width, State.Height)
          )
        );
      end if;
    end procedure;
    else null;
  end case;
  const InputHandler: (Sys.Action of CuiCanvas.CuiCanvasInput)? := case OnInput of
    when is Sys.Func of (D.Input, TMsg) as Notify: procedure(Value: CuiCanvas.CuiCanvasInput) begin
      if Enabled then
        const Event: D.Input := if Value.Kind = CuiCanvas.CuiCanvasInputKind.Key then
          D.Input.Key(
            cast<Keys.Key>(Value.Key),
            cast<Keys.Modifier>(Value.Modifiers),
            Value.Down,
            Value.Repeated
          )
        elsif Value.Kind = CuiCanvas.CuiCanvasInputKind.Text then
          D.Input.Text(Value.Text)
        else
          D.Input.WindowFocus(Value.Down)
        end if;
        Frame.Messages.Add(Notify.Invoke(Event));
      end if;
    end procedure;
    else null;
  end case;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled and Focusable);
  const Activated: bool := Frame.Window.DrawingCanvas(
    Token, Width.Kind, Width.Value, Height.Kind, Height.Value,
    Shapes, Enabled or PreserveFocus, out X, out Y, out W, out H, OnWheel <> null and Enabled,
    out WheelX, out WheelY, NativePaint, NativePointer, Settings.Focusable, Focus,
    if Settings.HoverCursor = null then
      -1
    else
      cast<int>(Settings.HoverCursor ?? D.Cursor.Arrow)
    end if, InputHandler, Settings.Enabled
  );
  if Enabled and Activated then
    Frame.Messages.Add(Clicked(new D.Event(X, Y, W, H)));
  end if;

  if Enabled and (WheelX <> 0.0F or WheelY <> 0.0F) then
    case OnWheel of
      when is Sys.Func of (D.Wheel, TMsg) as Notify:
        Frame.Messages.Add(Notify.Invoke(new D.Wheel(WheelX, WheelY)));
      else
    end case;
  end if;

  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
