// [Documentation](../../../../../docs/ui/gui/canvas-and-bars/format-bar.md)

unit Fpas.Ui.Gui.Internal.Widgets.Canvas.FormatBar;

uses Fpas.Ui.Gui.Cui.Widgets.Canvas as CuiCanvas;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Canvas.FormatBars as D;

uses System.Collections.Generic as Lists;

// Presents CUI's native FormatBar widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Format`: Current selection format.
// - `Changed`: Maps native proposals to messages.
// - `Settings`: Native widget settings.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Format: D.Value;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'format-bar';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  var Value: CuiCanvas.CuiTextFormat := new CuiCanvas.CuiTextFormat(
    cast Format.Color as int,
    cast Enc.Bits(Format.Bold, 1) as byte,
    cast Enc.Bits(Format.Underline, 1) as byte,
    cast Enc.Bits(Format.Link, 1) as byte,
    Format.Style,
    Format.Size,
    Format.Alignment,
    Format.List
  );
  const Styles: Lists.List of CuiCanvas.CuiTextStyle := new Lists.List of CuiCanvas.CuiTextStyle(
    Settings.Styles.Length
  );
  for Style: D.Style in Settings.Styles do
    Styles.Add(
      new CuiCanvas.CuiTextStyle(Style.Name, Style.Size, Style.PreviewSize, cast Style.Font as int)
    );
  end for;
  const Tones: Lists.List of int := new Lists.List of int(Settings.Colors.Length);
  for Tone: S.Tone in Settings.Colors do
    Tones.Add(cast Tone as int);
  end for;
  const Event: int := Frame.Window.FormatBar(
    Token, ref Value, Styles.ToArray(), Tones.ToArray(),
    Settings.Footer, Settings.FooterKeys, Settings.DeleteQuestion,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.HideDelete, 2) or Enc.Bits(Settings.HideMore, 4)
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, Value.Size.ToString());
  if Event <> 0 then
    const Next: D.Value := new D.Value(
      cast Value.Color as S.Tone, Value.Bold <> 0, Value.Underline <> 0,
      Value.Link <> 0, Value.Style, Value.Size, Value.Alignment, Value.List
    );
    Frame.Messages.Add(
      Changed(
        new D.Event(
          Next,
          (Event and 1) <> 0,
          (Event and 2) <> 0,
          (Event and 4) <> 0,
          (Event and 8) <> 0
        )
      )
    );
  end if;
end procedure;

end unit;
