// [Documentation](../../../../../docs/ui/gui/canvas-and-bars/live-cursors.md)

unit Fpas.Ui.Gui.Internal.Widgets.Canvas.LiveCursors;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Data.CanvasData as Data;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Canvas.LiveCursors as D;
uses Fpas.Ui.Widgets.Editors.NodeEditors as N;

// Presents CUI's native LiveCursors widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `People`: Current collaborators.
// - `Child`: Component under the cursors.
// - `Settings`: Native widget settings.
// - `Visit`: Presents embedded content.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; People: array of D.Person; Child: E.Element of TMsg; Settings: D.Options; Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment));
begin
  Visit(Child, Frame, false, L.Alignment.Default);
  const Transform: N.View := Settings.View ?? new N.View();
  Frame.Window.LiveCursors(
    C.Token('live-cursors', Id), Data.People(People), Settings.View <> null,
    Data.View(Transform), Settings.NoGlide
  );
end procedure;

end unit;
