// [Documentation](../../../../../docs/ui/gui/canvas-and-bars/presence-pill.md)

unit Fpas.Ui.Gui.Internal.Widgets.Canvas.PresencePill;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.CanvasData as Data;
uses Fpas.Ui.Widgets.Canvas.LiveCursors as Live;
uses Fpas.Ui.Widgets.Canvas.PresencePills as D;

// Presents CUI's native PresencePill widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `People`: Current collaborators.
// - `Settings`: Native widget settings.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; People: array of Live.Person; Settings: D.Options);
begin
  const Role: string := 'presence-pill';
  Frame.Window.PresencePill(
    C.Token(Role, Id),
    Data.People(People),
    Settings.Size,
    Settings.MaxVisible
  );
  P.Root<TMsg>(Frame, Id, Role, '', false, People.Length.ToString());
end procedure;

end unit;
