unit Fpas.Ui.Gui.Internal.Widgets.Canvas.PresencePill;

uses
  Fpas.Ui.Widgets.Canvas.PresencePills as D, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Canvas.LiveCursors as Live, Fpas.Ui.Gui.Internal.Data.CanvasData as Data;

// Presents CUI's native PresencePill widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `People`: Current collaborators.
// - `Settings`: Native widget settings.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; People: array of Live.Person; Settings: D.Options);
begin
  const Role: string := 'presence-pill';
  Frame.Window.PresencePill(
    C.Token(Role, Id),
    Data.People(People),
    Settings.Size,
    Settings.MaxVisible
  );
  P.Root<TMsg>(Frame, Id, Role, '', false, People.Length.ToString());
end procedure;

end unit;
