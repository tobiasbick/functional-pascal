// [Documentation](../../../../../docs/ui/gui/canvas-and-bars/result-card.md)

unit Fpas.Ui.Gui.Internal.Widgets.Canvas.ResultCard;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.MediaData as Images;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as Size;
uses Fpas.Ui.Widgets.Canvas.ResultCards as D;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;

// Presents CUI's native ResultCard widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Image`: Picture displayed in the card.
// - `Title`: Caption title.
// - `Activate`: Message on card activation.
// - `Settings`: Native widget settings.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Image: Media.Source;
  Title: string;
  Activate: TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'result-card';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled);
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Picked: bool := Frame.Window.ResultCard(
    Token, Images.Convert(Image), Title, Settings.Caption, Settings.Badge,
    cast Settings.BadgeTone as int, Width.Kind, Width.Value, Settings.Aspect, Enabled, Focus
  );
  P.Root of TMsg(Frame, Id, Role, Title, Enabled, '');
  if Picked then
    Frame.Messages.Add(Activate);
  end if;
end procedure;

end unit;
