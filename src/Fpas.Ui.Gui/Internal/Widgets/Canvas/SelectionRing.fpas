// [Documentation](../../../../../docs/ui/gui/canvas-and-bars/selection-ring.md)

unit Fpas.Ui.Gui.Internal.Widgets.Canvas.SelectionRing;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Values as P;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Canvas.SelectionRings as D;

// Adds the native decoration to the last completed component.
// ## Parameters
// - `Window`: Native drawing window.
// - `Settings`: Ring color, name and corners.
public procedure Apply(Window: Cui.CuiWindow; Settings: D.Options);
begin
  var Color: uint := 0U;
  case Settings.Color of
    when is G.Color as Value:
      Color := P.Pack(Value);
    else
  end case;

  Window.SelectionRing(cast Settings.Tone as int, Color, Settings.Name, Settings.Radius);
end procedure;

// Presents CUI's native SelectionRing widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Child`: Component framed by the ring.
// - `Settings`: Native widget settings.
// - `Visit`: Presents embedded content.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Child: E.Element of TMsg; Settings: D.Options; Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment));
begin
  Visit(Child, Frame, false, L.Alignment.Default);
  Apply(Frame.Window, Settings);
end procedure;

end unit;
