unit Fpas.Ui.Gui.Internal.Widgets.Charts.ActivityRings;

uses
  Fpas.Ui.Widgets.Charts.ActivityRings as W, Fpas.Ui.Widgets.Charts.Charts as Charts, Fpas.Ui.Gui.Cui.Widgets.Charts as CuiCharts,
  Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.Data.ChartData as Common, Fpas.Ui.Gui.Internal.Data.MoreChartData as Data,
  Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Layout.Sizing as Size, Fpas.Ui.Gui.Application as App, System as Sys;

// Presents CUI's native activity-rings.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable identity.
// - `Items`: Up to eight named nonnegative progress fractions.
// - `Settings`: Native presentation.
// - `OnActivate`: Optional native click callback.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Items: array of Charts.Item; Settings: W.Options; OnActivate: Sys.Func<int, TMsg>?);
begin
  const Token: string := C.Token('activity-rings', Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Options: CuiCharts.CuiActivityRingsOptions := new CuiCharts.CuiActivityRingsOptions(
    Settings.Size,
    Settings.Thickness,
    Settings.Center,
    Settings.Caption,
    Settings.Legend
  );
  const Clicked: int := Frame.Window.ActivityRings(
    Token,
    Common.Items(Items),
    Options,
    Enabled,
    not Frame.PaintingClosed
  );
  if Enabled and Clicked >= 0 then
    case OnActivate of
      when is Sys.Func<int, TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke(Clicked));
      else
    end case;
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(Id, 'ActivityRings', 'activity-rings', new Cui.CuiRectangle(), Enabled)
  );
end procedure;

end unit;
