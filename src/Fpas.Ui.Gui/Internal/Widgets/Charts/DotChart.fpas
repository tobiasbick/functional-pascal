// [Documentation](../../../../../docs/ui/gui/instruments/dot-chart.md)

unit Fpas.Ui.Gui.Internal.Widgets.Charts.DotChart;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Cui.Widgets.Charts as CuiCharts;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Charts;
uses Fpas.Ui.Widgets.Charts.Charts as Data;
uses Fpas.Ui.Widgets.Charts.DotCharts as W;

uses System as Sys;
uses System.Collections.Generic as G;

function SampleX(Index: int; Count: int; Settings: W.Options): double;
begin
  const IndexAxis: bool := Settings.XMinimum = Settings.XMaximum;
  const Lo: double := if IndexAxis then
    0.0
  else
    Settings.XMinimum
  end if;
  const Hi: double := if IndexAxis then
    cast Sys.Math.Max(1, Count - 1) as double
  else
    Settings.XMaximum
  end if;
  if Count <= 1 then
    return Lo;
  end if;

  return Lo + (Hi - Lo) * Index / (Count - 1);
end function;

// Presents the native CUI widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Bands`: Stacked series.
// - `Count`: Samples per series.
// - `Activate`: Optional activation mapper.
// - `Settings`: Native presentation options.
// - `Readout`: Optional mapper for readout changes.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Bands: array of W.Series;
  Count: int;
  Activate: Sys.Func of (W.Hit, TMsg)?;
  Settings: W.Options;
  Readout: Sys.Func of (W.Hit, TMsg)?
);
begin
  const Token: string := C.Token('dot-chart', Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Samples: array of float := new float[Bands.Length * Count];
  const Accent: array of int := new int[Bands.Length];
  const Names: G.List of string := new G.List of string(Bands.Length);
  for Index: int := 0 to Bands.Length - 1 do
    Sys.Array.Copy(Bands[Index].Values, 0, Samples, Index * Count, Count);
    Names.Add(Bands[Index].Name);
    Accent[Index] := if Bands[Index].Accent then
      1
    else
      0
    end if;
  end for;
  const Common: CuiCharts.CuiChartOptions := Charts.Options(
    new Data.Options(
      Width := Settings.Width,
      Height := Settings.Height, Format := Settings.Format, Grid := Settings.Grid,
      Range := Settings.Range, Annotations := Settings.Annotations
    )
  );
  const Native: CuiCharts.CuiDotOptions := new CuiCharts.CuiDotOptions(
    Common, Settings.XMinimum, Settings.XMaximum,
    Settings.XStep, cast Settings.Units as int, Charts.Format(Settings.XFormat), Settings.Unit,
    Settings.Pitch, Settings.Axis, Settings.Readout, Settings.XLabel, Settings.ValueLabel
  );
  const Hit: CuiCharts.CuiDotHit := Frame.Window.DotChart(
    Token, Samples, Accent, Count, Native,
    Enabled, C.WantsFocus of TMsg(Frame, Id, Token, Enabled), Names.ToArray()
  );
  if Enabled then
    if Hit.Clicked then
      case Activate of
        when is Sys.Func of (W.Hit, TMsg) as Notify:
          Frame.Messages.Add(Notify.Invoke(new W.Hit(Hit.X, Hit.Index, Hit.Value)));
        else
      end case;
    end if;

    const Observed: W.Hit? := Settings.Observed;
    if Observed <> null then
      case Readout of
        when is Sys.Func of (W.Hit, TMsg) as Notify:
          const X: double := if Hit.Clicked and Hit.Index >= 0 then
            SampleX(Hit.Index, Count, Settings)
          else
            Hit.X
          end if;
          if Observed.Index <> Hit.Index or Observed.X <> X or Observed.Value <> Hit.Value then
            Frame.Messages.Add(Notify.Invoke(new W.Hit(X, Hit.Index, Hit.Value)));
          end if;
        else
      end case;
    end if;
  end if;

  C.Track of TMsg(
    Frame, new App.Control(
      Id, '', 'dot-chart', new Cui.CuiRectangle(), Enabled,
      Value := Hit.Index.ToString()
    )
  );
end procedure;

end unit;
