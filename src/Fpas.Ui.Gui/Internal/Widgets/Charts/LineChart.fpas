// [Documentation](../../../../../docs/ui/gui/charts/line-chart.md)

unit Fpas.Ui.Gui.Internal.Widgets.Charts.LineChart;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Data;
uses Fpas.Ui.Widgets.Charts.Charts as Ch;

// Draws the native CUI line-chart.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable identity.
// - `Series`: Named finite samples.
// - `Settings`: Native presentation.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Series: array of Ch.Series;
  Settings: Ch.Options
);
begin
  const Token: string := C.Token('line-chart', Id);
  Frame.Window.LineChart(
    Token,
    Data.Series(Series),
    Data.Options(Settings),
    not Frame.PaintingClosed
  );
  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(new App.Control(Id, 'LineChart', 'line-chart', new Cui.CuiRectangle(), false));
end procedure;

end unit;
