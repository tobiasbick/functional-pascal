unit Fpas.Ui.Gui.Internal.Widgets.Charts.PatternMeter;

uses
  Fpas.Ui.Widgets.Charts.PatternMeters as P, Fpas.Ui.Gui.Internal.Data.ChartData as Data,
  Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui.Widgets.Charts as CuiCharts,
  Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.Layout.Sizing as Size, System.Collections.Generic as Lists;

// Draws the native CUI pattern-meter.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable identity.
// - `Parts`: Named nonnegative amounts.
// - `Settings`: Native presentation.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Parts: array of P.Part; Settings: P.Options);
begin
  const Token: string := C.Token('pattern-meter', Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Values: Lists.List<CuiCharts.CuiMeterPart> := new Lists.List<CuiCharts.CuiMeterPart>();
  for Item: P.Part in Parts do
    Values.Add(
      new CuiCharts.CuiMeterPart(Item.Name, Item.Value, Data.Color(Item.Color), Item.Density)
    );
  end for;
  const Options: CuiCharts.CuiMeterOptions := new CuiCharts.CuiMeterOptions(
    Settings.Total,
    Settings.Label,
    Settings.Unit,
    Data.Format(Settings.Format),
    Settings.FreeLabel,
    Settings.Grayscale,
    Settings.Legend,
    Settings.Height,
    Width.Kind,
    Width.Value
  );
  const Shown: int := Frame.Window.PatternMeter(
    Token, Values.ToArray(), Options, Enabled,
    C.WantsFocus<TMsg>(Frame, Id, Token, Enabled), not Frame.PaintingClosed
  );
  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(
      Id,
      Settings.Label,
      'pattern-meter',
      new Cui.CuiRectangle(),
      Enabled,
      Value := Shown.ToString()
    )
  );
end procedure;

end unit;
