// [Documentation](../../../../../docs/ui/gui/more-charts/radar-chart.md)

unit Fpas.Ui.Gui.Internal.Widgets.Charts.RadarChart;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Cui.Widgets.Charts as CuiCharts;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Data;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as Sizing;
uses Fpas.Ui.Widgets.Charts.Charts as Ch;
uses Fpas.Ui.Widgets.Charts.RadarCharts as W;

uses System as Sys;

// Presents the native radar-chart and forwards its activation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable identity.
// - `Series`: Nonnegative samples, one per axis in every series.
// - `Axes`: At least three literal captions.
// - `Settings`: Native presentation.
// - `OnActivate`: Optional native click callback.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Series: array of Ch.Series;
  Axes: array of string;
  Settings: W.Options;
  OnActivate: Sys.Func of (int, TMsg)?
);
begin
  const Token: string := C.Token('radar-chart', Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Options: CuiCharts.CuiRadarOptions := new CuiCharts.CuiRadarOptions(
    Settings.Size,
    Settings.Maximum,
    Data.Format(Settings.Format),
    Settings.Legend
  );
  const Clicked: int := Frame.Window.RadarChart(
    Token,
    Data.Series(Series),
    Axes,
    Options,
    Enabled,
    not Frame.PaintingClosed
  );
  if Enabled and Clicked >= 0 then
    case OnActivate of
      when is Sys.Func of (int, TMsg) as Notify:
        Frame.Messages.Add(Notify.Invoke(Clicked));
      else
    end case;
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(Id, 'RadarChart', 'radar-chart', new Cui.CuiRectangle(), Enabled)
  );
end procedure;

end unit;
