unit Fpas.Ui.Gui.Internal.Widgets.Charts.RadarChart;

uses
  Fpas.Ui.Widgets.Charts.RadarCharts as W, Fpas.Ui.Widgets.Charts.Charts as Ch, Fpas.Ui.Gui.Cui.Widgets.Charts as CuiCharts,
  Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.ChartData as Data,
  Fpas.Ui.Gui.Internal.Layout.Sizing as Sizing, Fpas.Ui.Gui.Application as App, System as Sys;

// Presents the native radar-chart and forwards its activation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable identity.
// - `Series`: Nonnegative samples, one per axis in every series.
// - `Axes`: At least three literal captions.
// - `Settings`: Native presentation.
// - `OnActivate`: Optional native click callback.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Series: array of Ch.Series; Axes: array of string; Settings: W.Options; OnActivate: Sys.Func<int, TMsg>?);
begin
  const Token: string := C.Token('radar-chart', Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Options: CuiCharts.CuiRadarOptions := new CuiCharts.CuiRadarOptions(
    Settings.Size,
    Settings.Maximum,
    Data.Format(Settings.Format),
    Settings.Legend
  );
  const Clicked: int := Frame.Window.RadarChart(
    Token,
    Data.Series(Series),
    Axes,
    Options,
    Enabled,
    not Frame.PaintingClosed
  );
  if Enabled and Clicked >= 0 then
    case OnActivate of
      when is Sys.Func<int, TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke(Clicked));
      else
    end case;
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(Id, 'RadarChart', 'radar-chart', new Cui.CuiRectangle(), Enabled)
  );
end procedure;

end unit;
