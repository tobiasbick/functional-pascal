// [Documentation](../../../../../docs/ui/gui/charts/sparkline.md)

unit Fpas.Ui.Gui.Internal.Widgets.Charts.Sparkline;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Colors;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Charts.Sparklines as W;

// Draws a compact native chart for a series of values.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Values`: Finite samples in display order.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Values: array of float;
  Settings: W.Options
);
begin
  const Role: string := 'sparkline';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  Frame.Window.Sparkline(
    Token,
    Values,
    Width.Kind,
    Width.Value,
    Settings.Height,
    Colors.Color(Settings.Color)
  );
  P.Root of TMsg(Frame, Id, Role, '', false, '');
end procedure;

end unit;
