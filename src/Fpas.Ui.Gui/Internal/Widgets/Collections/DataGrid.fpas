unit Fpas.Ui.Gui.Internal.Widgets.Collections.DataGrid;

uses
  Fpas.Ui.Widgets.Collections.DataGrids as D, Fpas.Ui.Widgets.Collections.Tables as T, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L,
  Fpas.Ui.Validation as V, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Layout.Sizing as S,
  Fpas.Ui.Gui.Internal.Layout.LayoutValidation as LayoutCheck, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui.Widgets.Collections as CuiCollections,
  Fpas.Ui.Gui.Cui as Cui, System as Sys;

// Converts native column descriptors for data grids and tree tables.
// ## Parameters
// - `Values`: Validated columns.
// ## Returns
// The native columns.
public function Columns(Values: array of D.Column): array of CuiCollections.CuiGridColumn;
begin
  const Native: array of CuiCollections.CuiGridColumn := new CuiCollections.CuiGridColumn[
    Values.Length
  ];
  for Index: int := 0 to Values.Length - 1 do
    const Column: D.Column := Values[Index];
    Native[Index] := new CuiCollections.CuiGridColumn(
      Column.Title, Column.Width, cast<int>(Column.Align),
      Column.Sortable, Column.Fixed, Column.Priority
    );
  end for;

  return Native;
end function;

// Reconstructs the optional model sort from a native proposal.
// ## Parameters
// - `State`: Native output with column and descending flag first.
// ## Returns
// The proposed sort, or null when disabled.
public function Sort(State: array of int): T.Sort?;
begin
  return if State[0] < -1 then
    null
  else
    new T.Sort(State[0], State[1] <> 0)
  end if;
end function;

// Presents a native grid and realizes only the requested rows.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current host frame.
// - `Id`: Stable grid identity.
// - `Defs`: Columns in display order.
// - `Count`: Total row count.
// - `Build`: Factory for a realized row.
// - `Current`: Model-owned selection, sort, cursor and anchor.
// - `Change`: Maps native changes to application messages.
// - `Settings`: Viewport and input settings.
// - `Visit`: Host traversal for composed cell content.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Defs: array of D.Column; Count: int; Build: function(int): D.Row<TMsg>; Current: D.Value; Change: function(D.Value): TMsg; Settings: D.Options; Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment));
  procedure Children(Items: array of E.Element<TMsg>);
  begin
    if Items.Length = 0 then
      return;
    end if;
    const Prepared: V.Prepared<TMsg> := V.Prepare<TMsg>(
      E.Row<TMsg>(new L.Flow(), Items),
      V.Target.Graphical
    );
    LayoutCheck.Check<TMsg>(Prepared);
    const Inner: C.State<TMsg> := Frame with
      Prepared := Prepared;
      AcceptInput := Frame.AcceptInput and Settings.Enabled;
    end with;
    for Item: E.Element<TMsg> in Items do
      Visit(Item, Inner, true, L.Alignment.Default);
    end for;
  end procedure;
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('data-grid', Id);
  const Height: S.NativeExtent := S.Extent(Settings.Height);
  const SortOrder: T.Sort? := Current.Order;
  const Order: int := if SortOrder = null then
    -2
  else
    SortOrder.Column
  end if;
  const Desc: int := if SortOrder <> null and SortOrder.Descending then
    1
  else
    0
  end if;
  const State: array of int := [Order, Desc, Current.Cursor, Current.Anchor];
  const Track: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Index: int): string => C.Token('grid-header', T.HeaderId(Id, Index))
  end if;
  const Options: int := (if Enabled then
    1
  else
    0
  end if) +
    (if Settings.Striped then
      2
    else
      0
    end if) +
    (if Settings.HideCheckboxes then
      4
    else
      0
    end if) +
    (if C.WantsFocus<TMsg>(Frame, Id, Token, Enabled) then
      8
    else
      0
    end if);
  const Native: CuiCollections.CuiGridFrame := Frame.Window.BeginDataGrid(
    Token,
    Columns(Defs),
    Count,
    Current.Selected,
    State,
    Height.Kind,
    Height.Value,
    Settings.RowHeight,
    Options,
    Track
  );
  for Index: int := 0 to Defs.Length - 1 do
    if Native.Headers[Index] then
      Frame.Controls.Add(
        new App.Control(
          T.HeaderId(Id, Index),
          Defs[Index].Title,
          'grid-header',
          new Cui.CuiRectangle(),
          Enabled and Current.Order <> null and Defs[Index].Sortable
        )
      );
    end if;
  end for;

  const Selection: (array of bool)? := Current.Selected;
  for Index: int := Native.First to Native.Last - 1 do
    const Row: D.Row<TMsg> := Build(Index);
    if Row.Id = '' or Row.Cells.Length <> Defs.Length then
      raise new Sys.ArgumentException('A native data row needs an ID and one cell per column.');
    end if;

    Frame.Window.DataGridRow(Index, C.Token('grid-row', Row.Id), not Frame.PaintingClosed);
    if not Frame.PaintingClosed then
      Frame.Controls.Add(
        new App.Control(
          Row.Id, '', 'grid-row', new Cui.CuiRectangle(), Enabled,
          Value := (Selection <> null and Selection[Index]).ToString()
        )
      );
    end if;

    for Cell: D.Cell<TMsg> in Row.Cells do
      case Cell of
        when D.Cell.Text(const Caption: string):
          Frame.Window.DataGridCell(Caption);
        when D.Cell.Content(const Items: array of E.Element<TMsg>):
          Frame.Window.DataGridCell(null);
          Children(Items);
        when D.Cell.Editable(
          const Caption: string, const Capacity: int,
          const Commit: function(string): TMsg, const Leading: array of E.Element<TMsg>
        ):
          Frame.Window.DataGridCell(null);
          Children(Leading);
          const Proposed: string? := Frame.Window.DataGridEdit(Caption, Capacity);
          if Enabled and Proposed <> null then
            Frame.Messages.Add(Commit(Proposed));
          end if;
      end case;
    end for;
  end for;

  Frame.Window.EndDataGrid();
  C.Track<TMsg>(
    Frame, new App.Control(
      Id, '', 'data-grid', new Cui.CuiRectangle(), Enabled,
      Value := Native.First.ToString() + ':' + Native.Last.ToString()
    )
  );

  var Changed: bool := Order <> State[0] or Desc <> State[1] or Current.Cursor <> State[2]
    or Current.Anchor <> State[3];
  const Bytes: (array of byte)? := Native.Selected;
  const Before: (array of bool)? := Current.Selected;
  var Selected: (array of bool)? := null;
  if Bytes <> null and Before <> null then
    Selected := new bool[Count];
    for Index: int := 0 to Count - 1 do
      Selected[Index] := Bytes[Index] <> 0;
      Changed := Changed or Selected[Index] <> Before[Index];
    end for;
  end if;

  if Enabled and Changed then
    Frame.Messages.Add(Change(new D.Value(Selected, Sort(State), State[2], State[3])));
  end if;
end procedure;

end unit;
