// [Documentation](../../../../../docs/ui/gui/data-display/reorderable-list.md)

unit Fpas.Ui.Gui.Internal.Widgets.Collections.ReorderableList;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Layout as L;

// Presents the native ReorderableList element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable list identity.
// - `Items`: Direct children of each row in canonical order.
// - `Order`: Model-owned permutation.
// - `Change`: Maps a proposed order to a message.
// - `Enabled`: Whether the list accepts dragging.
// - `Visit`: Host traversal for each reorder row.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Items: array of array of E.Element of TMsg;
  Order: array of int;
  Change: function(array of int): TMsg;
  Enabled: bool;
  Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment)
);
begin
  const Accept: bool := Frame.AcceptInput and Enabled;
  const Proposed: array of int := Frame.Window.BeginReorder(
    C.Token('reorderable-list', Id),
    Order,
    Accept
  );
  for Position: int := 0 to Proposed.Length - 1 do
    const Index: int := Proposed[Position];
    Frame.Window.BeginReorderItem(Position, Accept);
    for Child: E.Element of TMsg in Items[Index] do
      Visit(Child, Frame, true, L.Alignment.Center);
    end for;

    Frame.Window.EndReorderItem();
    C.Track of TMsg(
      Frame, new App.Control(
        Id, '', 'reorder-row', new Cui.CuiRectangle(), Accept,
        Value := Position.ToString(), Key := Index.ToString()
      )
    );
  end for;

  if Frame.Window.EndReorder() and Accept then
    Frame.Messages.Add(Change(Proposed));
  end if;

  C.Track of TMsg(
    Frame,
    new App.Control(Id, '', 'reorderable-list', new Cui.CuiRectangle(), Accept)
  );
end procedure;

end unit;
