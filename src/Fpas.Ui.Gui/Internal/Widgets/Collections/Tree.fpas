// [Documentation](../../../../../docs/ui/gui/data-display/tree.md)

unit Fpas.Ui.Gui.Internal.Widgets.Collections.Tree;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Cui.Widgets.Collections as CuiCollections;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Collections.Trees as T;

uses System as Sys;

// Presents the native Tree element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable row identity.
// - `Label`: Literal row caption.
// - `Open`: Model expansion, or null for a leaf.
// - `Children`: Elements under the expanded branch.
// - `Change`: Optional expansion mapper for a branch.
// - `Activate`: Optional activation mapper for a leaf.
// - `Settings`: Appearance and input settings.
// - `Visit`: Host traversal for the expanded children.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Label: string;
  Open: bool?;
  Children: array of E.Element of TMsg;
  Change: Sys.Func of (bool, TMsg)?;
  Activate: (Sys.Func of TMsg)?;
  Settings: T.Options;
  Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment)
);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('tree-node', Id);
  const Result: CuiCollections.CuiTreeResult := Frame.Window.BeginTree(
    Token, Label, Settings.Icon, Open = null, Open ?? false, Settings.Selected, Enabled,
    C.WantsFocus of TMsg(Frame, Id, Token, Enabled)
  );
  C.Track of TMsg(
    Frame, new App.Control(
      Id, Label, 'tree-node', new Cui.CuiRectangle(), Enabled,
      Value := if Open = null then
        Settings.Selected.ToString()
      else
        Result.Open.ToString()
      end if
    )
  );
  if Enabled then
    case Change of
      when is Sys.Func of (bool, TMsg) as Notify:
        if Result.Open <> (Open ?? false) then
          Frame.Messages.Add(Notify.Invoke(Result.Open));
        end if;
      else
    end case;

    if Result.Clicked then
      case Activate of
        when is Sys.Func of TMsg as Notify:
          Frame.Messages.Add(Notify.Invoke());
        else
      end case;
    end if;
  end if;

  if Result.Open then
    for Child: E.Element of TMsg in Children do
      Visit(Child, Frame, false, L.Alignment.Default);
    end for;

    Frame.Window.EndTree();
  end if;
end procedure;

end unit;
