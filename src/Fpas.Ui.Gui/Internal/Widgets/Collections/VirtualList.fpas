// [Documentation](../../../../../docs/ui/gui/data-display/virtual-list.md)

unit Fpas.Ui.Gui.Internal.Widgets.Collections.VirtualList;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Cui.Widgets.Collections as CuiCollections;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Layout.RealizedValidation as Realized;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Validation as V;

uses System as Sys;

// Presents the native VirtualList element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable viewport identity.
// - `Count`: Total number of rows.
// - `RowHeight`: Fixed logical height of each row.
// - `Height`: Viewport extent.
// - `Build`: Pure factory for each realized row.
// - `Offset`: Saved offset to restore when the list reappears.
// - `OnScroll`: Optional observer for the latest native target offset.
// - `Visit`: Host traversal for a realized row.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Count: int; RowHeight: float; Height: L.Extent; Build: function(int): E.Element<TMsg>; Offset: float?; OnScroll: Sys.Func<float, TMsg>?; Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment));
begin
  const Extent: S.NativeExtent := S.Extent(Height);
  const Token: string := C.Token('virtual-list', Id);
  var Restore: float := Offset ?? -1.0F;
  for Control: App.Control in Frame.Previous do
    if Control.Id = Id and Control.Role = 'virtual-list' then
      Restore := -1.0F;
      break;
    end if;
  end for;
  const Range: CuiCollections.CuiVirtualRange := Frame.Window.BeginVirtualList(
    Token, Count, RowHeight, Extent.Kind, Extent.Value, Frame.AcceptInput, Restore
  );
  for Index: int := Range.First to Range.Last - 1 do
    const Row: E.Element<TMsg> := Build(Index);
    const Prepared: V.Prepared<TMsg> := Realized.Prepare<TMsg>(Row);
    Frame.Window.BeginVirtualRow(Index);
    Visit(
      Row, Frame with
        Prepared := Prepared;
      end with, false, L.Alignment.Default
    );
    Frame.Window.SizeLast(false, 2, RowHeight, 0.0F, -1.0F, 0.0F, 0);
    Frame.Window.EndVirtualRow();
  end for;

  Frame.Window.EndVirtualList();
  if Frame.AcceptInput then
    case OnScroll of
      when is Sys.Func<float, TMsg> as Report:
        var Position: float := 0.0F;
        var Maximum: float := 0.0F;
        Frame.Window.ScrollState(Token, -1, 0.0F, out Position, out Maximum);
        if Position <> (Offset ?? 0.0F) then
          Frame.Messages.Add(Report.Invoke(Position));
        end if;
      else
    end case;
  end if;

  C.Track<TMsg>(
    Frame, new App.Control(
      Id, '', 'virtual-list', new Cui.CuiRectangle(), Frame.AcceptInput,
      Value := Range.First.ToString() + ':' + Range.Last.ToString()
    )
  );
end procedure;

end unit;
