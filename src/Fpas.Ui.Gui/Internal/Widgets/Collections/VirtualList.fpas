unit Fpas.Ui.Gui.Internal.Widgets.Collections.VirtualList;

uses
  Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui.Widgets.Collections as CuiCollections,
  Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Gui.Internal.Layout.Sizing as S,
  Fpas.Ui.Gui.Internal.Layout.LayoutValidation as LayoutCheck, Fpas.Ui.Validation as V;

// Presents the native VirtualList element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable viewport identity.
// - `Count`: Total number of rows.
// - `RowHeight`: Fixed logical height of each row.
// - `Height`: Viewport extent.
// - `Build`: Pure factory for each realized row.
// - `Visit`: Host traversal for a realized row.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Count: int; RowHeight: float; Height: L.Extent; Build: function(int): E.Element<TMsg>; Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment));
begin
  const Extent: S.NativeExtent := S.Extent(Height);
  const Range: CuiCollections.CuiVirtualRange := Frame.Window.BeginVirtualList(
    C.Token('virtual-list', Id), Count, RowHeight, Extent.Kind, Extent.Value, Frame.AcceptInput
  );
  for Index: int := Range.First to Range.Last - 1 do
    const Row: E.Element<TMsg> := Build(Index);
    const Prepared: V.Prepared<TMsg> := V.Prepare<TMsg>(Row, V.Target.Graphical);
    LayoutCheck.Check<TMsg>(Prepared);
    Frame.Window.BeginVirtualRow(Index);
    Visit(
      Row, Frame with
        Prepared := Prepared;
      end with, false, L.Alignment.Default
    );
    Frame.Window.SizeLast(false, 2, RowHeight, 0.0F, -1.0F, 0.0F, 0);
    Frame.Window.EndVirtualRow();
  end for;

  Frame.Window.EndVirtualList();
  C.Track<TMsg>(
    Frame, new App.Control(
      Id, '', 'virtual-list', new Cui.CuiRectangle(), Frame.AcceptInput,
      Value := Range.First.ToString() + ':' + Range.Last.ToString()
    )
  );
end procedure;

end unit;
