unit Fpas.Ui.Gui.Internal.Widgets.ColorPicker;

uses
  Fpas.Ui.ColorPickers as P, Fpas.Ui.Graphics as G, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as C, System as Sys;

function Pack(Value: G.Color): uint;
begin
  return cast<uint>(Value.Red) or (cast<uint>(Value.Green) shl 8)
    or (cast<uint>(Value.Blue) shl 16) or (cast<uint>(Value.Alpha) shl 24);
end function;

function Unpack(Value: uint): G.Color;
begin
  return new G.Color(
    cast<byte>(Value and 255u), cast<byte>((Value shr 8) and 255u),
    cast<byte>((Value shr 16) and 255u), cast<byte>(Value shr 24)
  );
end function;

function Identity(Id: string; Part: int): string;
begin
  return if Part = 0 then
    P.SurfaceId(Id)
  elsif Part = 1 then
    P.HueId(Id)
  else
    P.PresetId(Id, Part - 2)
  end if;
end function;

// Draws the native field and forwards color proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Picker identity.
// - `Value`: Model-owned color.
// - `OnChange`: Maps a new color to a message.
// - `Enabled`: Whether the picker accepts input.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Value: G.Color; OnChange: function(G.Color): TMsg; Enabled: bool
);
begin
  const Accept: bool := Enabled and Frame.AcceptInput;
  const Role: string := 'color-picker';
  const Token: string := C.Token(Role, Id);
  const Track: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Part: int): string => C.Token('color-part', Identity(Id, Part))
  end if;
  const Packed: uint := Pack(Value);
  const Result: Cui.CuiColorPickerResult := Frame.Window.ColorPicker(
    Token, Packed, Accept, C.WantsFocus<TMsg>(Frame, Id, Token, Accept), Track
  );
  if Result.Value <> Packed then
    Frame.Messages.Add(OnChange(Unpack(Result.Value)));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;
  const Hex: string := '#' + Value.Red.ToString(
    'X2'
  ) + Value.Green.ToString('X2') + Value.Blue.ToString('X2');
  Frame.Controls.Add(
    new App.Control(Id, 'Color', Role, new Cui.CuiRectangle(), Accept, Value := Hex)
  );
  if Result.Open then
    for Part: int := 0 to 9 do
      const Caption: string := if Part = 0 then
        'Saturation and value'
      elsif Part = 1 then
        'Hue'
      else
        'Preset ' + (Part - 1).ToString()
      end if;
      Frame.Controls.Add(
        new App.Control(
          Identity(Id, Part), Caption, 'color-part', new Cui.CuiRectangle(), Accept
        )
      );
    end for;
  end if;
end procedure;

end unit;
