// [Documentation](../../../../../docs/ui/gui/feedback/card.md)

unit Fpas.Ui.Gui.Internal.Widgets.Containers.Card;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as Size;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Containers.Cards as K;

uses System as Sys;

// Draws a native card and presents its children inside it.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable card identity.
// - `Children`: Card contents.
// - `Settings`: Presentation and input settings.
// - `Activate`: Optional card activation message factory.
// - `Visit`: Presents one child in the layout.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Children: array of E.Element of TMsg; Settings: K.Options; Activate: (Sys.Func of TMsg)?; Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment));
begin
  const Token: string := C.Token('card', Id);
  const Hoverable: bool := Settings.Hoverable or Activate <> null;
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Hoverable;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled);
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Height: Size.NativeExtent := Size.Extent(Settings.Height);
  const Clicked: bool := Frame.Window.BeginCard(
    Token,
    Width.Kind,
    Width.Value,
    Height.Kind,
    Height.Value,
    Settings.MinimumWidth,
    Settings.MaximumWidth,
    Settings.Padding,
    Settings.PaddingX,
    Settings.PaddingY,
    Settings.Gap,
    Settings.Horizontal,
    cast<int>(Settings.Align),
    Settings.Wrap,
    Settings.Muted,
    Settings.Selected,
    Hoverable,
    Enabled,
    Focus
  );
  for Child: E.Element of TMsg in Children do
    Visit(Child, Frame, Settings.Horizontal, Settings.Align);
  end for;

  Frame.Window.EndCard();
  C.Track of TMsg(Frame, new App.Control(Id, '', 'card', new Cui.CuiRectangle(), Enabled));

  if Enabled and Clicked then
    case Activate of
      when is Sys.Func of TMsg as Notify:
        Frame.Messages.Add(Notify.Invoke());
      else
    end case;
  end if;
end procedure;

end unit;
