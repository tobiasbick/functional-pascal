unit Fpas.Ui.Gui.Internal.Widgets.Containers.EmptyState;

uses Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Widgets.Containers.EmptyStates as E, System as Sys;

// Draws the native empty state and dispatches its optional action.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable empty state identity.
// - `Title`: Literal heading.
// - `Settings`: Appearance and optional action caption.
// - `Action`: Optional action message factory.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Title: string; Settings: E.Options; Action: Sys.Func<TMsg>?);
begin
  const Part: string := E.ActionId(Id);
  const Token: string := C.Token('empty-state-action', Part);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Action <> null;
  const Focus: bool := C.WantsFocus<TMsg>(Frame, Part, Token, Enabled);
  const Track: string? := if Action <> null and not Frame.PaintingClosed then
    Token
  else
    null
  end if;
  const Clicked: bool := Frame.Window.EmptyState(
    C.Token('empty-state', Id), Title, Settings.Icon, Settings.Description, Settings.ActionLabel,
    Enabled, Focus, Track
  );
  C.Track<TMsg>(Frame, new App.Control(Id, Title, 'empty-state', new Cui.CuiRectangle(), false));
  if Track <> null then
    Frame.Controls.Add(
      new App.Control(
        Part,
        Settings.ActionLabel,
        'empty-state-action',
        new Cui.CuiRectangle(),
        Enabled
      )
    );
  end if;

  if Enabled and Clicked then
    case Action of
      when is Sys.Func<TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke());
      else
    end case;
  end if;
end procedure;

end unit;
