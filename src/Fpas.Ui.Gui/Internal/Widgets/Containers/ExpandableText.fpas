unit Fpas.Ui.Gui.Internal.Widgets.Containers.ExpandableText;

uses
  Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Widgets.Containers.ExpandableTexts as T, Fpas.Ui.Graphics as G, System as Sys;

function Pack(Color: G.Color?): uint;
begin
  return if Color = null then
    0u
  elsif Color.Alpha = 0 then
    1u
  else
    cast<uint>(Color.Red) or (cast<uint>(Color.Green) shl 8)
    or (cast<uint>(Color.Blue) shl 16) or (cast<uint>(Color.Alpha) shl 24)
  end if;
end function;

// Draws native expandable text without mirroring its internal expansion state.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Drawing context.
// - `Id`: Stable block identity.
// - `Text`: Literal wrapping text.
// - `Settings`: Native options and input permission.
// - `OnToggle`: Optional notification after native expansion changes.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Text: string; Settings: T.Options;
  OnToggle: Sys.Func<TMsg>?
);
begin
  const Allowed: bool := Settings.Enabled and Frame.AcceptInput;
  const Toggle: string := T.ToggleId(Id);
  const ToggleToken: string := C.Token('expandable-text-toggle', Toggle);
  const Result: int := Frame.Window.ExpandableText(
    C.Token('expandable-text', Id), Text,
    Settings.Lines, Settings.Size, Pack(Settings.Color), Pack(Settings.FadeTo), Allowed,
    C.WantsFocus<TMsg>(Frame, Toggle, ToggleToken, Allowed), ToggleToken
  );
  if (Result and 1) <> 0 then
    case OnToggle of
      when is Sys.Func<TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke());
      else
    end case;
  end if;
  const Expanded: bool := (Result and 2) <> 0;
  if not Frame.PaintingClosed then
    Frame.Controls.Add(
      new App.Control(
        Id, Text, 'expandable-text', new Cui.CuiRectangle(), false,
        Value := if Expanded then
          'true'
        else
          'false'
        end if
      )
    );
    Frame.Labels.Add(Text);
    if (Result and 4) <> 0 then
      Frame.Controls.Add(
        new App.Control(
          Toggle, if Expanded then
            'Show less'
          else
            'Show more'
          end if,
          'expandable-text-toggle', new Cui.CuiRectangle(), Allowed
        )
      );
    end if;
  end if;
end procedure;

end unit;
