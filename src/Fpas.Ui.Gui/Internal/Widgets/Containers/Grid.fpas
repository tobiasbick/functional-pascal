// [Documentation](../../../../../docs/ui/gui/feedback/grid.md)

unit Fpas.Ui.Gui.Internal.Widgets.Containers.Grid;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as Size;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Containers.Grids as G;

// Lets CUI resolve responsive columns and lay out their contents.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Settings`: Native grid settings.
// - `Children`: Elements in reading order.
// - `Visit`: Presents one child in the layout.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Settings: G.Options;
  Children: array of E.Element of TMsg;
  Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment)
);
begin
  const Flow: L.Flow := G.FlowFor(Settings);
  Frame.Window.BeginGrid(
    Settings.Columns,
    Settings.MinimumColumnWidth,
    Size.Spacing(Flow.Padding),
    Size.Spacing(Flow.Gap),
    Flow.Clip ?? false,
    Flow.Id,
    cast Flow.Scrolling as int
  );
  Size.Container(Frame.Window, Flow);
  const Scope: L.FocusScope? := Flow.Scope;
  if Scope <> null then
    Frame.Window.PushFocusScope(Scope.Id, Scope.Active);
  end if;

  for Child: E.Element of TMsg in Children do
    Visit(Child, Frame, false, L.Alignment.Default);
  end for;

  if Scope <> null then
    Frame.Window.PopFocusScope();
  end if;

  Frame.Window.EndGroup();
  C.TrackContainer of TMsg(Frame, Flow.Id, 'grid');
end procedure;

end unit;
