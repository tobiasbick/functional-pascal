unit Fpas.Ui.Gui.Internal.Widgets.ContextMenu;

uses Fpas.Ui.Menus as M, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.Widgets.Menu as Menu;

// Attaches CUI's context menu to the target just drawn by the presenter.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current frame, input permission and message queue.
// - `Id`: Menu identity independent of its target.
// - `Entries`: Shared keyed commands and decorations.
// - `Enabled`: Whether the context menu accepts input.
public procedure Draw<TMsg>(State: C.State<TMsg>; Id: string; Entries: array of M.Entry<TMsg>; Enabled: bool);
begin
  if not State.Window.HasLastWidget then
    return;
  end if;

  Menu.Draw<TMsg>(State, Id, 'Context menu', Entries, null, Enabled);
end procedure;

end unit;
