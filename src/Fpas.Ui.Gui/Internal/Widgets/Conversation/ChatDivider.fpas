unit Fpas.Ui.Gui.Internal.Widgets.Conversation.ChatDivider;

uses Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P;

// Draws a native labeled conversation divider.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Label`: Divider caption.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Label: string);
begin
  const Role: string := 'chat-divider';
  const Token: string := C.Token(Role, Id);
  Frame.Window.ChatDivider(Token, Label);
  P.Root<TMsg>(Frame, Id, Role, Label, false, '');
end procedure;

end unit;
