// [Documentation](../../../../../docs/ui/gui/social-and-media/chat-divider.md)

unit Fpas.Ui.Gui.Internal.Widgets.Conversation.ChatDivider;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;

// Draws a native labeled conversation divider.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Label`: Divider caption.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Label: string);
begin
  const Role: string := 'chat-divider';
  const Token: string := C.Token(Role, Id);
  Frame.Window.ChatDivider(Token, Label);
  P.Root of TMsg(Frame, Id, Role, Label, false, '');
end procedure;

end unit;
