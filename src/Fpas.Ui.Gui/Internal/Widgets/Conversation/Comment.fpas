// [Documentation](../../../../../docs/ui/gui/social-and-media/comment.md)

unit Fpas.Ui.Gui.Internal.Widgets.Conversation.Comment;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Widgets.Conversation.Comments as W;

// Draws a threaded comment and reports native actions.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Author`: Comment author.
// - `Text`: Comment body.
// - `Current`: Current like state.
// - `Change`: Maps the proposed like state or reply.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Author: string;
  Text: string;
  Current: W.Value;
  Change: function(W.Event): TMsg;
  Settings: W.Options
);
begin
  const Role: string := 'comment';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Parts: array of string := ['like', 'reply'];
  const Focus: int := P.Focus of TMsg(Frame, Id, Role, Parts, P.Inputs(2, Enabled), 0);
  const LikeId: string? := if Frame.PaintingClosed then
    null
  else
    C.Token(Role, Id + '/like')
  end if;
  const ReplyId: string? := if Frame.PaintingClosed then
    null
  else
    C.Token(Role, Id + '/reply')
  end if;
  var Likes: int := Current.Likes ?? -1;
  var Liked: int := if Current.Liked = null then
    -1
  else
    Enc.Bits(Current.Liked.Value, 1)
  end if;
  const Result: int := Frame.Window.Comment(
    Token, Author, Text, Settings.Time, Settings.Depth, Settings.Badge,
    Enc.Bits(Settings.Edited, 1) + Enc.Bits(Enabled, 2), Focus, ref Likes, ref Liked,
    LikeId, ReplyId
  );
  if (Result and 1) <> 0 then
    const Count: int? := if Likes < 0 then
      null
    else
      Likes
    end if;
    const Active: bool? := if Liked < 0 then
      null
    else
      Liked <> 0
    end if;
    Frame.Messages.Add(Change(W.Event.Like(new W.Value(Count, Active))));
  end if;

  if (Result and 2) <> 0 then
    Frame.Messages.Add(Change(W.Event.Reply));
  end if;

  P.Root of TMsg(Frame, Id, Role, Author, false, Text);
  P.Part of TMsg(
    Frame, Id, Role, Parts[0], 'Like', Enabled, if Likes < 0 then
      ''
    else
      Likes.ToString()
    end if
  );
  P.Part of TMsg(Frame, Id, Role, Parts[1], 'Reply', Enabled, '');
end procedure;

end unit;
