// [Documentation](../../../../../docs/ui/gui/social-and-media/presence.md)

unit Fpas.Ui.Gui.Internal.Widgets.Conversation.Presence;

uses Fpas.Ui.Gui.Cui.Widgets.Conversation as CuiConversation;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Colors;
uses Fpas.Ui.Widgets.Conversation.Presences as W;

// Draws an overlapping native group of active and away users.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Users`: Users in visible order.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Users: array of W.User; Settings: W.Options);
begin
  const Role: string := 'presence';
  const Token: string := C.Token(Role, Id);
  const Data: array of CuiConversation.CuiPresenceUser := new CuiConversation.CuiPresenceUser[
    Users.Length
  ];
  for Index: int := 0 to Users.Length - 1 do
    const User: W.User := Users[Index];
    Data[Index] := new CuiConversation.CuiPresenceUser(
      User.Name,
      Colors.Color(User.Color),
      User.Avatar,
      User.Idle
    );
  end for;

  Frame.Window.Presence(Token, Data, Settings.MaximumVisible, Settings.Size);
  P.Root of TMsg(Frame, Id, Role, '', false, '');
end procedure;

end unit;
