// [Documentation](../../../../../docs/ui/gui/social-and-media/typing-indicator.md)

unit Fpas.Ui.Gui.Internal.Widgets.Conversation.TypingIndicator;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;

// Draws the native typing indicator.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Name`: Participant name, or null for an anonymous avatar.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Name: string?);
begin
  const Role: string := 'typing-indicator';
  const Token: string := C.Token(Role, Id);
  Frame.Window.TypingIndicator(Token, Name);
  P.Root of TMsg(Frame, Id, Role, Name ?? '', false, '');
end procedure;

end unit;
