unit Fpas.Ui.Gui.Internal.Widgets.Coverage;

uses Fpas.Ui.Coverages as D, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Internal.Sizing as S, Fpas.Ui.Gui.Cui as Cui, System.Collections.Generic as Lists;

function PackCoverageFile(Items: array of D.File): array of Cui.CuiDevCoverageFile;
begin
  const Native: Lists.List<Cui.CuiDevCoverageFile> := new Lists.List<Cui.CuiDevCoverageFile>(
    Items.Length
  );
  for Entry: D.File in Items do
    Native.Add(
      new Cui.CuiDevCoverageFile(
        Entry.Path,
        Entry.Lines,
        Entry.LinesHit,
        Entry.Branches,
        Entry.BranchesHit,
        Entry.Functions,
        Entry.FunctionsHit
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native Coverage widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `ReportFiles`: ReportFiles supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; ReportFiles: array of D.File; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'coverage';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: Cui.CuiDevResult := Frame.Window.Coverage(
    Token,
    PackCoverageFile(ReportFiles),
    Settings.Height,
    Settings.Low,
    Settings.High,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, Result.X.ToString());
  if Enabled and (Result.Action >= 0) then
    Frame.Messages.Add(Changed(new D.Event(Result.Action, cast<float>(Result.X))));
  end if;
end procedure;

end unit;
