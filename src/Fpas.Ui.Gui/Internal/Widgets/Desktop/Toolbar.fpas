// [Documentation](../../../../../docs/ui/gui/canvas-and-bars/toolbar.md)

unit Fpas.Ui.Gui.Internal.Widgets.Desktop.Toolbar;

uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Widgets.Desktop.Toolbars as D;

function Button(Window: Cui.CuiWindow; Value: D.Button; Primary: bool): int;
begin
  const Pressed: bool? := Value.Toggle;
  const Toggle: int := if Pressed = null then
    -1
  else
    Enc.Bits(Pressed = true, 1)
  end if;
  return Window.ToolbarButton(
    Value.Icon, Value.Label, Value.Tooltip, Value.Shortcut, Toggle, cast Value.Tone as int,
    Enc.Bits(Value.Disabled, 1) or Enc.Bits(Value.Flyout, 2) or Enc.Bits(Primary, 4)
  );
end function;

procedure ItemsDraw of TMsg(
  Frame: C.State of TMsg;
  Items: array of D.Item;
  Changed: function(D.Event): TMsg;
  Enabled: bool;
  ref Index: int
);
begin
  for Item: D.Item in Items do
    var Value: int := -1;
    var Action: bool := true;
    case Item of
      when D.Item.Button(const Options: D.Button):
        Value := Button(Frame.Window, Options, false);
      when D.Item.Primary(const Options: D.Button):
        Value := Button(Frame.Window, Options, true);
      when D.Item.Radio(
        const Icons: array of string,
        const Labels: (array of string)?,
        const Selected: int
      ):
        Value := Frame.Window.ToolbarRadio('radio-' + Index.ToString(), Icons, Labels, Selected);
      when D.Item.Cycle(
        const Labels: array of string,
        const Selected: int,
        const Settings: D.CycleOptions?
      ):
        const Current: D.CycleOptions := Settings ?? new D.CycleOptions();
        Value := Frame.Window.ToolbarCycle(
          'cycle-' + Index.ToString(), Labels, Selected, Current.Tooltip, Current.Shortcut,
          Current.Disabled, cast Current.Tone as int, Current.Flyout
        );
      when D.Item.Group(const Children: array of D.Item):
        Action := false;
        Frame.Window.BeginToolbarGroup();
        ItemsDraw of TMsg(Frame, Children, Changed, Enabled, ref Index);
        Frame.Window.EndToolbarGroup();
      when D.Item.Separator:
        Action := false;
        Frame.Window.ToolbarSeparator();
      when D.Item.Spacer:
        Action := false;
        Frame.Window.ToolbarSpacer();
    end case;

    if Action then
      if Enabled and Value >= 0 then
        Frame.Messages.Add(Changed(new D.Event(Index, Value)));
      end if;

      Index := Index + 1;
    end if;
  end for;
end procedure;

// Presents CUI's native Toolbar widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Items`: Buttons, choices and groups in display order.
// - `Changed`: Maps native proposals to messages.
// - `Settings`: Native widget settings.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Items: array of D.Item;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'toolbar';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  var Index: int := 0;
  Frame.Window.BeginToolbar(Token, Settings.Style, Settings.HideBorder, Enabled);
  ItemsDraw of TMsg(Frame, Items, Changed, Enabled, ref Index);
  Frame.Window.EndToolbar();
  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
