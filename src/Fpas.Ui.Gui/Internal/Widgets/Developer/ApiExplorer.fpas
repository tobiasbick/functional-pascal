unit Fpas.Ui.Gui.Internal.Widgets.Developer.ApiExplorer;

uses Fpas.Ui.Widgets.Developer.ApiExplorers as D, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper, System.Collections.Generic as Lists;

function PackParameter(Items: array of D.Parameter): array of CuiDeveloper.CuiDevParameter;
begin
  const Native: Lists.List<CuiDeveloper.CuiDevParameter> := new Lists.List<CuiDeveloper.CuiDevParameter>(
    Items.Length
  );
  for Entry: D.Parameter in Items do
    Native.Add(
      new CuiDeveloper.CuiDevParameter(
        Entry.Name,
        Entry.Location,
        Entry.Type,
        Entry.Required,
        Entry.Description
      )
    );
  end for;

  return Native.ToArray();
end function;

function PackEndpoint(Items: array of D.Endpoint): array of CuiDeveloper.CuiDevEndpoint;
begin
  const Native: Lists.List<CuiDeveloper.CuiDevEndpoint> := new Lists.List<CuiDeveloper.CuiDevEndpoint>(
    Items.Length
  );
  for Entry: D.Endpoint in Items do
    Native.Add(
      new CuiDeveloper.CuiDevEndpoint(
        Entry.Method,
        Entry.Path,
        Entry.Summary,
        Entry.Tag,
        Entry.Deprecated,
        PackParameter(Entry.Parameters)
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native ApiExplorer widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Endpoints`: Endpoints supplied to the widget.
// - `Selection`: Selection supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Endpoints: array of D.Endpoint; Selection: int; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'api-explorer';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.ApiExplorer(
    Token,
    PackEndpoint(Endpoints),
    Selection,
    Settings.Height,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, Selection.ToString());
  if Enabled and (Result.Index <> Selection or Result.Action >= 0) then
    Frame.Messages.Add(Changed(new D.Event(Result.Index, Result.Action)));
  end if;
end procedure;

end unit;
