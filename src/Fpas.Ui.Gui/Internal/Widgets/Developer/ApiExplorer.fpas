// [Documentation](../../../../../docs/ui/gui/more-developer-tools/api-explorer.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.ApiExplorer;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.ApiExplorers as D;

uses System.Collections.Generic as Lists;

function PackParameter(Items: array of D.Parameter): array of CuiDeveloper.CuiDevParameter;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevParameter := new Lists.List of CuiDeveloper.CuiDevParameter(
    Items.Length
  );
  for Entry: D.Parameter in Items do
    Native.Add(
      new CuiDeveloper.CuiDevParameter(
        Entry.Name,
        Entry.Location,
        Entry.Type,
        Entry.Required,
        Entry.Description
      )
    );
  end for;

  return Native.ToArray();
end function;

function PackEndpoint(Items: array of D.Endpoint): array of CuiDeveloper.CuiDevEndpoint;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevEndpoint := new Lists.List of CuiDeveloper.CuiDevEndpoint(
    Items.Length
  );
  for Entry: D.Endpoint in Items do
    Native.Add(
      new CuiDeveloper.CuiDevEndpoint(
        Entry.Method,
        Entry.Path,
        Entry.Summary,
        Entry.Tag,
        Entry.Deprecated,
        PackParameter(Entry.Parameters)
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native ApiExplorer widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Endpoints`: Endpoints supplied to the widget.
// - `Selection`: Model selection or null for native selection.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Endpoints: array of D.Endpoint;
  Selection: int?;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'api-explorer';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.ApiExplorer(
    Token,
    PackEndpoint(Endpoints),
    Selection,
    Settings.Height,
    Width.Kind,
    Width.Value,
    Enabled,
    C.WantsFocus of TMsg(Frame, Id, Token, Enabled)
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, Result.Index.ToString());
  if Enabled and (Result.Flags <> 0 or Result.Action >= 0) then
    Frame.Messages.Add(Changed(new D.Event(Result.Index, Result.Action)));
  end if;
end procedure;

end unit;
