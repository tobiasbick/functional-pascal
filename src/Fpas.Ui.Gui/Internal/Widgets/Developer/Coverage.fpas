// [Documentation](../../../../../docs/ui/gui/more-developer-tools/coverage.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.Coverage;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.Coverages as D;

uses System.Collections.Generic as Lists;

function PackCoverageFile(Items: array of D.File): array of CuiDeveloper.CuiDevCoverageFile;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevCoverageFile := new Lists.List of CuiDeveloper.CuiDevCoverageFile(
    Items.Length
  );
  for Entry: D.File in Items do
    Native.Add(
      new CuiDeveloper.CuiDevCoverageFile(
        Entry.Path,
        Entry.Lines,
        Entry.LinesHit,
        Entry.Branches,
        Entry.BranchesHit,
        Entry.Functions,
        Entry.FunctionsHit
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native Coverage widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `ReportFiles`: ReportFiles supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  ReportFiles: array of D.File;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'coverage';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.Coverage(
    Token,
    PackCoverageFile(ReportFiles),
    Settings.Height,
    Settings.Low,
    Settings.High,
    Width.Kind,
    Width.Value,
    Enabled,
    C.WantsFocus of TMsg(Frame, Id, Token, Enabled)
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, Result.X.ToString());
  const Lines: float := cast Result.X as float;
  const LinesChanged: bool := Settings.ReportedLines <> null and Settings.ReportedLines <> Lines;
  if Enabled and (Result.Action >= 0 or LinesChanged) then
    Frame.Messages.Add(Changed(new D.Event(Result.Action, Lines)));
  end if;
end procedure;

end unit;
