unit Fpas.Ui.Gui.Internal.Widgets.Developer.DependencyGraph;

uses Fpas.Ui.Widgets.Developer.DependencyGraphs as D, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper, System.Collections.Generic as Lists;

function PackGraphNode(Items: array of D.Vertex): array of CuiDeveloper.CuiDevGraphNode;
begin
  const Native: Lists.List<CuiDeveloper.CuiDevGraphNode> := new Lists.List<CuiDeveloper.CuiDevGraphNode>(
    Items.Length
  );
  for Entry: D.Vertex in Items do
    Native.Add(new CuiDeveloper.CuiDevGraphNode(Entry.Label, Entry.Detail, Entry.Tone));
  end for;

  return Native.ToArray();
end function;

function PackEdge(Items: array of D.Edge): array of CuiDeveloper.CuiDevEdge;
begin
  const Native: Lists.List<CuiDeveloper.CuiDevEdge> := new Lists.List<CuiDeveloper.CuiDevEdge>(
    Items.Length
  );
  for Entry: D.Edge in Items do
    Native.Add(new CuiDeveloper.CuiDevEdge(Entry.From, Entry.To));
  end for;

  return Native.ToArray();
end function;

// Presents the native DependencyGraph widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Vertices`: Vertices supplied to the widget.
// - `Edges`: Edges supplied to the widget.
// - `Selection`: Selection supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Vertices: array of D.Vertex; Edges: array of D.Edge; Selection: int; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'dependency-graph';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.DependencyGraph(
    Token,
    PackGraphNode(Vertices),
    PackEdge(Edges),
    Selection,
    Settings.Height,
    Settings.TopDown,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, Selection.ToString());
  if Enabled and (Result.Index <> Selection or Result.Action >= 0 or Result.Count >= 0) then
    Frame.Messages.Add(Changed(new D.Event(Result.Index, Result.Count, Result.Action)));
  end if;
end procedure;

end unit;
