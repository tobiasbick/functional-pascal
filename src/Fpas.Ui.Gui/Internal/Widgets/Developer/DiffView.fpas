// [Documentation](../../../../../docs/ui/gui/code/diff-viewer.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.DiffView;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.DiffViews as D;

// Renders the native DiffView and dispatches its proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable widget identity.
// - `Before`: Previous source.
// - `After`: Updated source.
// - `Current`: Selected change, or minus one.
// - `Changed`: Maps diff and selection updates.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Before: string;
  After: string;
  Current: int;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'diff-view';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Enabled: bool := Frame.AcceptInput;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled);
  const Result: CuiDeveloper.CuiDiffViewEvent? := Frame.Window.DiffView(
    Token,
    Before,
    After,
    Current,
    Settings.Language,
    Settings.OldTitle,
    Settings.NewTitle,
    Settings.Context,
    Width.Kind,
    Width.Value,
    Settings.Height,
    Settings.Size,
    Settings.SplitMinimumWidth,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.Inline, 2) or Enc.Bits(not Settings.Fold, 4)
    or Enc.Bits(Settings.IgnoreLineEndings, 8) or Enc.Bits(Focus, 16)
  );
  if Enabled then
    case Result of
      when is CuiDeveloper.CuiDiffViewEvent as Event:
        Frame.Messages.Add(
          Changed(
            new D.Event(
              Event.Selected, Event.Count, Event.Inline, Event.Added, Event.Removed, Event.Folds,
              Event.Hidden, Event.Approximate, Event.CurrentChanged, Event.Recomputed
            )
          )
        );
      else
    end case;
  end if;

  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
