// [Documentation](../../../../../docs/ui/gui/code/json-viewer.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.JsonView;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Developer.JsonViews as W;

// Presents the native CUI widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Json`: Literal JSON or parse-error example.
// - `Settings`: Native presentation options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Json: string;
  Settings: W.Options
);
begin
  const Valid: bool := Frame.Window.JsonView(
    C.Token('json-view', Id), Json, Settings.ExpandDepth,
    Settings.MaxHeight, Frame.AcceptInput
  );
  C.Track of TMsg(
    Frame, new App.Control(
      Id, '', 'json-view', new Cui.CuiRectangle(),
      Frame.AcceptInput, Value := Valid.ToString()
    )
  );
end procedure;

end unit;
