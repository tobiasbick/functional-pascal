// [Documentation](../../../../../docs/ui/gui/developer-tools/key-value-editor.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.KeyValueEditor;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.KeyValueData as Data;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.KeyValueEditors as D;

uses System as Sys;

// Presents the native KeyValueEditor widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Pairs`: Pairs supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Pairs: array of D.Pair;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'key-value-editor';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Before: array of CuiDeveloper.CuiDevPair := Data.Pack(Pairs);
  const Result: array of CuiDeveloper.CuiDevPair := Frame.Window.KeyValueEditor(
    Token,
    Before,
    Settings.Capacity,
    Settings.KeyPlaceholder,
    Settings.ValuePlaceholder,
    Settings.HideToggles,
    Settings.HideSecrets,
    Settings.ReadOnly,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
  if Enabled and not Sys.Object.ReferenceEquals(Result, Before) then
    Frame.Messages.Add(Changed(new D.Event(Data.Unpack(Result))));
  end if;
end procedure;

end unit;
