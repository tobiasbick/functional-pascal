unit Fpas.Ui.Gui.Internal.Widgets.Developer.Keymap;

uses Fpas.Ui.Widgets.Developer.Keymaps as D, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper, System.Collections.Generic as Lists;

function PackBinding(Items: array of D.Binding): array of CuiDeveloper.CuiDevBinding;
begin
  const Native: Lists.List<CuiDeveloper.CuiDevBinding> := new Lists.List<CuiDeveloper.CuiDevBinding>(
    Items.Length
  );
  for Entry: D.Binding in Items do
    Native.Add(
      new CuiDeveloper.CuiDevBinding(Entry.Modifiers, Entry.Key, Entry.Action, Entry.Category)
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native Keymap widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Bindings`: Bindings supplied to the widget.
// - `Categories`: Categories supplied to the widget.
// - `Modifiers`: Modifiers supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Bindings: array of D.Binding; Categories: array of string; Modifiers: int; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'keymap';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.Keymap(
    Token,
    PackBinding(Bindings),
    Categories,
    Modifiers,
    Settings.HideFunctionRow,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, '');
  if Enabled and (Result.Index <> Modifiers or Result.Action > 0) then
    Frame.Messages.Add(Changed(new D.Event(Result.Index, Result.Action, Result.Count)));
  end if;
end procedure;

end unit;
