unit Fpas.Ui.Gui.Internal.Widgets.Developer.LogConsole;

uses
  Fpas.Ui.Widgets.Developer.LogConsoles as D, Fpas.Ui.Gui.Internal.Hosting.Context as C,
  Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Gui.Internal.Layout.Sizing as S,
  Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper, System.Collections.Generic as Lists;

// Renders the native LogConsole and dispatches its proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable widget identity.
// - `Entries`: Immutable log lines in arrival order.
// - `Cleared`: Message proposed when the native Clear button is used.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Entries: array of D.Entry; Cleared: TMsg; Settings: D.Options);
begin
  const Role: string := 'log-console';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Enabled: bool := Frame.AcceptInput;
  const Rows: Lists.List<CuiDeveloper.CuiLogEntry> := new Lists.List<CuiDeveloper.CuiLogEntry>(
    Entries.Length
  );
  for Entry: D.Entry in Entries do

    Rows.Add(new CuiDeveloper.CuiLogEntry(Entry.Text, Entry.Time, cast<int>(Entry.Severity)));
  end for;

  if Frame.Window.LogConsole(
    Token, Rows.ToArray(), Width.Kind, Width.Value, Settings.Height, Settings.Size,
    P.Bits(Enabled, 1) or P.Bits(Settings.Timestamps, 2) or P.Bits(not Settings.Toolbar, 4)
  )
  then
    Frame.Messages.Add(Cleared);
  end if;

  P.Root<TMsg>(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
