// [Documentation](../../../../../docs/ui/gui/code/log-console.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.LogConsole;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.LogConsoles as D;

uses System.Collections.Generic as Lists;

// Renders the native LogConsole and dispatches its proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable widget identity.
// - `Entries`: Immutable log lines in arrival order.
// - `Cleared`: Message proposed when the native Clear button is used.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Entries: array of D.Entry; Cleared: TMsg; Settings: D.Options);
begin
  const Role: string := 'log-console';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Enabled: bool := Frame.AcceptInput;
  const Rows: Lists.List of CuiDeveloper.CuiLogEntry := new Lists.List of CuiDeveloper.CuiLogEntry(
    Entries.Length
  );
  for Entry: D.Entry in Entries do

    Rows.Add(new CuiDeveloper.CuiLogEntry(Entry.Text, Entry.Time, cast Entry.Severity as int));
  end for;

  if Frame.Window.LogConsole(
    Token, Rows.ToArray(), Width.Kind, Width.Value, Settings.Height, Settings.Size,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.Timestamps, 2) or Enc.Bits(not Settings.Toolbar, 4)
  )
  then
    Frame.Messages.Add(Cleared);
  end if;

  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
