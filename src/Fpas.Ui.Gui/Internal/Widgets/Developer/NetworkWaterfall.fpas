// [Documentation](../../../../../docs/ui/gui/developer-tools/network-waterfall.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.NetworkWaterfall;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.NetworkWaterfalls as D;

uses System.Collections.Generic as Lists;

function PackRequest(Items: array of D.Request): array of CuiDeveloper.CuiDevRequest;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevRequest := new Lists.List of CuiDeveloper.CuiDevRequest(
    Items.Length
  );
  for Entry: D.Request in Items do
    Native.Add(
      new CuiDeveloper.CuiDevRequest(
        Entry.Name,
        Entry.Method,
        Entry.Status,
        Entry.Type,
        Entry.Size,
        Entry.Start,
        Entry.Queued,
        Entry.Dns,
        Entry.Connect,
        Entry.Tls,
        Entry.Wait,
        Entry.Download
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native NetworkWaterfall widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Requests`: Requests supplied to the widget.
// - `Selection`: Model selection or null to use native selection.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Requests: array of D.Request;
  Selection: int?;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'network-waterfall';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.NetworkWaterfall(
    Token,
    PackRequest(Requests),
    Selection,
    Settings.Height,
    Settings.DomLoaded,
    Settings.Loaded,
    Width.Kind,
    Width.Value,
    Enabled,
    C.WantsFocus of TMsg(Frame, Id, Token, Enabled)
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, (Selection ?? Result.Index).ToString());
  if Enabled and (Result.Flags <> 0 or Result.Action >= 0 or Result.Count >= 0
    or (Settings.Hovered <> null and Settings.Hovered <> Result.Hover))
  then
    Frame.Messages.Add(
      Changed(new D.Event(Result.Index, Result.Count, Result.Action, Result.Hover))
    );
  end if;
end procedure;

end unit;
