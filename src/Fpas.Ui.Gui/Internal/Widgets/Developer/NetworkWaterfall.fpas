unit Fpas.Ui.Gui.Internal.Widgets.Developer.NetworkWaterfall;

uses Fpas.Ui.Widgets.Developer.NetworkWaterfalls as D, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper, System.Collections.Generic as Lists;

function PackRequest(Items: array of D.Request): array of CuiDeveloper.CuiDevRequest;
begin
  const Native: Lists.List<CuiDeveloper.CuiDevRequest> := new Lists.List<CuiDeveloper.CuiDevRequest>(
    Items.Length
  );
  for Entry: D.Request in Items do
    Native.Add(
      new CuiDeveloper.CuiDevRequest(
        Entry.Name,
        Entry.Method,
        Entry.Status,
        Entry.Type,
        Entry.Size,
        Entry.Start,
        Entry.Queued,
        Entry.Dns,
        Entry.Connect,
        Entry.Tls,
        Entry.Wait,
        Entry.Download
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native NetworkWaterfall widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Requests`: Requests supplied to the widget.
// - `Selection`: Selection supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Requests: array of D.Request; Selection: int; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'network-waterfall';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.NetworkWaterfall(
    Token,
    PackRequest(Requests),
    Selection,
    Settings.Height,
    Settings.DomLoaded,
    Settings.Loaded,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, Selection.ToString());
  if Enabled and (Result.Index <> Selection or Result.Action >= 0 or Result.Count >= 0) then
    Frame.Messages.Add(Changed(new D.Event(Result.Index, Result.Count, Result.Action)));
  end if;
end procedure;

end unit;
