// [Documentation](../../../../../docs/ui/gui/developer-tools/query-builder.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.QueryBuilder;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.QueryData as Data;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.QueryBuilders as D;

uses System as Sys;
uses System.Collections.Generic as Lists;

// Presents the native QueryBuilder widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Fields`: Fields supplied to the widget.
// - `RulesData`: RulesData supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Fields: array of D.Field;
  RulesData: array of D.Rule;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'query-builder';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Before: array of CuiDeveloper.CuiDevRule := Data.Rules(RulesData);
  const Result: array of CuiDeveloper.CuiDevRule := Frame.Window.QueryBuilder(
    Token,
    Data.Fields(Fields),
    Before,
    Settings.Capacity,
    Settings.MaxDepth,
    Settings.ReadOnly,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
  if Enabled and not Sys.Object.ReferenceEquals(Result, Before) then
    const Values: Lists.List of D.Rule := new Lists.List of D.Rule(Result.Length);
    for Entry: CuiDeveloper.CuiDevRule in Result do
      Values.Add(
        new D.Rule(Entry.Depth, Entry.Group, Entry.Any, Entry.Field, Entry.Operator, Entry.Value)
      );
    end for;

    Frame.Messages.Add(Changed(new D.Event(Values.ToArray())));
  end if;
end procedure;

end unit;
