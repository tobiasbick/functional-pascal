// [Documentation](../../../../../docs/ui/gui/more-developer-tools/http-response-status.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.ResponseStatus;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.ResponseStatuses as D;

// Presents the native ResponseStatus widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Status`: HTTP status code, or a nonpositive value before a response.
// - `Seconds`: Elapsed seconds, or a negative value to omit the time.
// - `Bytes`: Response size in bytes, or a negative value to omit the size.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Status: int;
  Seconds: double;
  Bytes: double;
  Settings: D.Options
);
begin
  const Role: string := 'response-status';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  Frame.Window.ResponseStatus(
    Token,
    Status,
    Seconds,
    Bytes,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
