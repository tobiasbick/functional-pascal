// [Documentation](../../../../../docs/ui/gui/more-developer-tools/stack-trace.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.StackTrace;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.StackTraces as D;

uses System.Collections.Generic as Lists;

function PackStackFrame(Items: array of D.Frame): array of CuiDeveloper.CuiDevStackFrame;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevStackFrame := new Lists.List of CuiDeveloper.CuiDevStackFrame(
    Items.Length
  );
  for Entry: D.Frame in Items do
    const Source: Lists.List of string? := new Lists.List of string? (Entry.Source.Length);
    for Line: string in Entry.Source do
      Source.Add(Line);
    end for;

    Native.Add(
      new CuiDeveloper.CuiDevStackFrame(
        Entry.FunctionName,
        Entry.File,
        Entry.Line,
        Entry.Column,
        Entry.External,
        Source.ToArray(),
        Entry.SourceFirst
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native StackTrace widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Frames`: Frames supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Frames: array of D.Frame; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'stack-trace';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.StackTrace(
    Token,
    PackStackFrame(Frames),
    Settings.Title,
    Settings.Message,
    Settings.Language,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
  if Enabled and (Result.Action >= 0) then
    Frame.Messages.Add(Changed(new D.Event(Result.Action)));
  end if;
end procedure;

end unit;
