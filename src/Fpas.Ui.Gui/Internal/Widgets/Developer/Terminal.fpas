// [Documentation](../../../../../docs/ui/gui/files/terminal.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.Terminal;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.Terminals as D;

// Renders the native Terminal and dispatches its proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable widget identity.
// - `Output`: Cumulative output, with optional ANSI formatting.
// - `Revision`: Change to explicitly clear the scrollback before replaying the supplied output.
// - `Received`: Maps submissions and interrupts.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Output: string;
  Revision: int;
  Received: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'terminal';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Enabled: bool := Frame.AcceptInput;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled and Settings.Input);
  const Result: CuiDeveloper.CuiTerminalEvent := Frame.Window.Terminal(
    Token,
    Output,
    Revision,
    Settings.Prompt,
    Width.Kind,
    Width.Value,
    Settings.Height,
    Settings.Size,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.Input, 2) or Enc.Bits(Focus, 4)
  );
  const Command: string? := Result.Command;
  if Command <> null then
    Frame.Messages.Add(Received(D.Event.Command(Command)));
  end if;

  if Result.Interrupt then
    Frame.Messages.Add(Received(D.Event.Interrupt));
  end if;

  P.Root of TMsg(Frame, Id, Role, '', Enabled and Settings.Input, '');
end procedure;

end unit;
