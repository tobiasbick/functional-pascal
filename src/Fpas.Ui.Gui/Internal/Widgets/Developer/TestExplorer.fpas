unit Fpas.Ui.Gui.Internal.Widgets.Developer.TestExplorer;

uses Fpas.Ui.Widgets.Developer.TestExplorers as D, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper, System.Collections.Generic as Lists;

function PackTestItem(Items: array of D.Item): array of CuiDeveloper.CuiDevTestItem;
begin
  const Native: Lists.List<CuiDeveloper.CuiDevTestItem> := new Lists.List<CuiDeveloper.CuiDevTestItem>(
    Items.Length
  );
  for Entry: D.Item in Items do
    Native.Add(
      new CuiDeveloper.CuiDevTestItem(
        Entry.Name,
        Entry.Depth,
        Entry.Status,
        Entry.Duration,
        Entry.Message
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native TestExplorer widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Entries`: Entries supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Entries: array of D.Item; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'test-explorer';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.TestExplorer(
    Token,
    PackTestItem(Entries),
    Settings.Height,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, Result.Count.ToString());
  if Enabled and (Result.Action >= 0 or Result.Hover >= 0 or Result.Flags <> 0) then
    Frame.Messages.Add(
      Changed(
        new D.Event(
          Result.Index,
          Result.Action,
          Result.Hover,
          Result.Flags <> 0,
          cast<int>(Result.X),
          cast<int>(Result.Y),
          cast<int>(Result.Z),
          Result.Count
        )
      )
    );
  end if;
end procedure;

end unit;
