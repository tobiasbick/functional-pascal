// [Documentation](../../../../../docs/ui/gui/more-developer-tools/test-explorer.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.TestExplorer;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.TestExplorers as D;

uses System.Collections.Generic as Lists;

function PackTestItem(Items: array of D.Item): array of CuiDeveloper.CuiDevTestItem;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevTestItem := new Lists.List of CuiDeveloper.CuiDevTestItem(
    Items.Length
  );
  for Entry: D.Item in Items do
    Native.Add(
      new CuiDeveloper.CuiDevTestItem(
        Entry.Name,
        Entry.Depth,
        Entry.Status,
        Entry.Duration,
        Entry.Message
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native TestExplorer widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Entries`: Entries supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Entries: array of D.Item;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'test-explorer';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: CuiDeveloper.CuiDevResult := Frame.Window.TestExplorer(
    Token,
    PackTestItem(Entries),
    Settings.Height,
    Width.Kind,
    Width.Value,
    Enabled
  );
  const Passed: int := cast Result.X as int;
  const Failed: int := cast Result.Y as int;
  const Skipped: int := cast Result.Z as int;
  const Observed: string := Result.Index.ToString() + ',' + Passed.ToString() + ',' +
    Failed.ToString() + ',' + Skipped.ToString() + ',' + Result.Count.ToString();
  var Previous: string := '-1,0,0,0,0';
  for Control: App.Control in Frame.Previous do
    if Control.Id = Id and Control.Role = Role then
      Previous := Control.Value;
      break;
    end if;
  end for;

  P.Root of TMsg(
    Frame, Id, Role, '', Enabled, if Frame.AcceptInput then
      Observed
    else
      Previous
    end if
  );
  if Enabled and (Previous <> Observed or Result.Action >= 0 or Result.Hover >= 0
    or Result.Flags <> 0)
  then
    Frame.Messages.Add(
      Changed(
        new D.Event(
          Result.Index,
          Result.Action,
          Result.Hover,
          Result.Flags <> 0,
          Passed,
          Failed,
          Skipped,
          Result.Count
        )
      )
    );
  end if;
end procedure;

end unit;
