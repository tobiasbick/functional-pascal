// [Documentation](../../../../../docs/ui/gui/developer-tools/trace-viewer.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.TraceViewer;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.TraceViewers as D;

uses System.Collections.Generic as Lists;

function PackTrack(Items: array of D.Track): array of CuiDeveloper.CuiDevTrack;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevTrack := new Lists.List of CuiDeveloper.CuiDevTrack(
    Items.Length
  );
  for Entry: D.Track in Items do
    Native.Add(new CuiDeveloper.CuiDevTrack(Entry.Name, Entry.Collapsed));
  end for;

  return Native.ToArray();
end function;

function PackSpan(Items: array of D.Span): array of CuiDeveloper.CuiDevSpan;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevSpan := new Lists.List of CuiDeveloper.CuiDevSpan(
    Items.Length
  );
  for Entry: D.Span in Items do
    Native.Add(
      new CuiDeveloper.CuiDevSpan(
        Entry.Name,
        Entry.Start,
        Entry.End,
        Entry.Track,
        Entry.Depth,
        Entry.ColorKey
      )
    );
  end for;

  return Native.ToArray();
end function;

function PackMarker(Items: array of D.Marker): array of CuiDeveloper.CuiDevMarker;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevMarker := new Lists.List of CuiDeveloper.CuiDevMarker(
    Items.Length
  );
  for Entry: D.Marker in Items do
    Native.Add(new CuiDeveloper.CuiDevMarker(Entry.Name, Entry.Time, Entry.Tone));
  end for;

  return Native.ToArray();
end function;

// Presents the native TraceViewer widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Tracks`: Tracks supplied to the widget.
// - `Spans`: Spans supplied to the widget.
// - `Markers`: Markers supplied to the widget.
// - `Value`: Value supplied to the widget.
// - `Selection`: Selection supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Tracks: array of D.Track; Spans: array of D.Span; Markers: array of D.Marker; Value: D.View; Selection: int; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'trace-viewer';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Links: Lists.List of CuiDeveloper.CuiTraceLink := new Lists.List of CuiDeveloper.CuiTraceLink(
    Settings.Links.Length
  );
  for Index: int := 0 to Settings.Links.Length - 1 do
    const Link: D.Link := Settings.Links[Index];
    Links.Add(
      new CuiDeveloper.CuiTraceLink(Link.From, Link.To, Link.Tone, Link.Width, Link.Dashed)
    );
  end for;
  const Native: CuiDeveloper.CuiTraceResult := Frame.Window.TraceViewer(
    Token,
    PackTrack(Tracks),
    PackSpan(Spans),
    PackMarker(Markers),
    Value.Start,
    Value.End,
    Value.Scroll,
    Value.MarkStart,
    Value.MarkEnd,
    Selection,
    Settings.Height,
    Settings.RowHeight,
    Width.Kind,
    Width.Value,
    Enabled,
    Links.ToArray()
  );
  const Result: CuiDeveloper.CuiDevResult := Native.Edit;
  const Hovered: D.Hover := new D.Hover(Result.Hover, Native.HoveredLink);
  const HoverChanged: bool := case Settings.Hovered of
    when is D.Hover as Previous: Previous.Span <> Hovered.Span or Previous.Link <> Hovered.Link;
    else false;
  end case;
  P.Root of TMsg(Frame, Id, Role, '', Enabled, Selection.ToString());
  if Enabled and (Result.Flags <> 0 or HoverChanged) then
    Frame.Messages.Add(
      Changed(
        new D.Event(
          new D.View(Result.X, Result.Y, cast<float>(Result.Z), Result.A, Result.B),
          Result.Index, Result.Action, Result.Count <> 0, Hovered
        )
      )
    );
  end if;
end procedure;

end unit;
