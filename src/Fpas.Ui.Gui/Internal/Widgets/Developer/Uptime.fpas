// [Documentation](../../../../../docs/ui/gui/more-developer-tools/uptime.md)

unit Fpas.Ui.Gui.Internal.Widgets.Developer.Uptime;

uses Fpas.Ui.Gui.Cui.Widgets.Developer as CuiDeveloper;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Developer.Uptimes as D;

uses System as Sys;
uses System.Collections.Generic as Lists;

function PackService(Items: array of D.Service): array of CuiDeveloper.CuiDevService;
begin
  const Native: Lists.List of CuiDeveloper.CuiDevService := new Lists.List of CuiDeveloper.CuiDevService(
    Items.Length
  );
  for Entry: D.Service in Items do
    Native.Add(new CuiDeveloper.CuiDevService(Entry.Name, Entry.Days));
  end for;

  return Native.ToArray();
end function;

// Presents the native Uptime widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Services`: Services supplied to the widget.
// - `LastDay`: LastDay supplied to the widget.
// - `Settings`: Native layout and interaction options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Services: array of D.Service;
  LastDay: Sys.DateOnly;
  Settings: D.Options
);
begin
  const Role: string := 'uptime';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  discard Frame.Window.Uptime(
    Token,
    PackService(Services),
    LastDay.Year,
    LastDay.Month,
    LastDay.Day,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
