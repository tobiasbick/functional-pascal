// [Documentation](../../../../../docs/ui/gui/instruments/dot-display.md)

unit Fpas.Ui.Gui.Internal.Widgets.Display.DotDisplay;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Charts;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Display.DotDisplays as W;

// Presents the native CUI widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Text`: Text for the dot display.
// - `Settings`: Native presentation options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Text: string;
  Settings: W.Options
);
begin
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Flags: int := (if Settings.Accent then
    1
  else
    0
  end if) +
    (if Settings.Dim then
      0
    else
      2
    end if) + (if Settings.Marquee then
      4
    else
      0
    end if);
  Frame.Window.DotDisplay(
    C.Token('dot-display', Id), Text, Settings.Pitch, Charts.Color(Settings.Color),
    cast Settings.Align as int, Width.Kind, Width.Value, Flags
  );
  C.Track of TMsg(Frame, new App.Control(Id, Text, 'dot-display', new Cui.CuiRectangle(), false));
end procedure;

end unit;
