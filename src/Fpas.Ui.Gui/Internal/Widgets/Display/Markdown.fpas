// [Documentation](../../../../../docs/ui/gui/code/markdown.md)

unit Fpas.Ui.Gui.Internal.Widgets.Display.Markdown;

uses Fpas.Ui.Gui.Cui.Widgets.Display as CuiDisplay;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Display.Markdowns as D;

// Renders the native Markdown and dispatches its proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable widget identity.
// - `Text`: Markdown source.
// - `Changed`: Maps link and task activations.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Text: string; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'markdown';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Enabled: bool := Frame.AcceptInput;
  const Result: CuiDisplay.CuiMarkdownEvent := Frame.Window.Markdown(
    Token, Text, Width.Kind, Width.Value, Settings.Size,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.Compact, 2) or Enc.Bits(Settings.Streaming, 4)
  );
  if Enabled then
    const Link: string? := Result.Link;
    if Link <> null then
      Frame.Messages.Add(Changed(D.Event.Link(Link)));
    end if;

    if Result.HoverChanged then
      Frame.Messages.Add(Changed(D.Event.Hover(Result.Hovered)));
    end if;

    if Result.Offset >= 0 then
      Frame.Messages.Add(Changed(D.Event.Task(Result.Offset, Result.Line, Result.Checked)));
    end if;
  end if;

  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
