// [Documentation](../../../../../docs/ui/gui/text-and-display/text.md)

unit Fpas.Ui.Gui.Internal.Widgets.Display.NativeText;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Display.Texts as D;

// Draws the native CUI text.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Text`: Literal text.
// - `Role`: Native text role.
// - `Settings`: Reading direction and alignment of the text node.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Text: string;
  Role: D.Appearance;
  Settings: D.Options
);
begin
  Frame.Window.DisplayText(
    Text,
    cast Role as int,
    cast Settings.ReadingDirection as int,
    cast Settings.Align as int
  );
  Frame.Labels.Add(Text);
end procedure;

end unit;
