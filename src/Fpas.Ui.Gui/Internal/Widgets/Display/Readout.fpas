unit Fpas.Ui.Gui.Internal.Widgets.Display.Readout;

uses
  Fpas.Ui.Widgets.Display.Readouts as W, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Layout.Sizing as S;

// Presents the native CUI widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Label`: Readout heading.
// - `Value`: Displayed value.
// - `Settings`: Native presentation options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Label: string; Value: string; Settings: W.Options);
begin
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  Frame.Window.Readout(
    C.Token('readout', Id),
    Label,
    Value,
    Settings.Unit,
    Settings.Detail,
    cast<int>(Settings.Size),
    cast<int>(Settings.Tone),
    Settings.Accent,
    cast<int>(Settings.Align),
    Width.Kind,
    Width.Value
  );
  C.Track<TMsg>(
    Frame,
    new App.Control(Id, Label, 'readout', new Cui.CuiRectangle(), false, Value := Value)
  );
end procedure;

end unit;
