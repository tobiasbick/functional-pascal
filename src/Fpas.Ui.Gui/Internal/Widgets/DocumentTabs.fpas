unit Fpas.Ui.Gui.Internal.Widgets.DocumentTabs;

uses
  Fpas.Ui.DocumentTabs as D, Fpas.Ui.Menus as M, Fpas.Ui.Gui.Internal.Context as C,
  Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, System.Collections.Generic as Lists;

// Draws the native document strip and returns proposals to the model.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation and input context.
// - `Id`: Stable strip identity.
// - `Tabs`: Documents in display order.
// - `Selected`: Current selected index.
// - `Changed`: Maps native proposals to messages.
// - `Settings`: Native behavior.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Tabs: array of D.Tab; Selected: int; Changed: function(D.Change): TMsg; Settings: D.Options);
begin
  const Role: string := 'document-tabs';
  const Token: string := C.Token(Role, Id);
  const Parts: Lists.List<string> := new Lists.List<string>(Tabs.Length + 1);
  const Native: Lists.List<Cui.CuiDocumentTab> := new Lists.List<Cui.CuiDocumentTab>(Tabs.Length);
  var Focus: bool := C.WantsFocus<TMsg>(Frame, Id, Token, Frame.AcceptInput and Selected >= 0);
  Parts.Add(Token);
  for Index: int := 0 to Tabs.Length - 1 do
    const Item: D.Tab := Tabs[Index];
    const TabId: string := M.ItemId(Id, Item.Key);
    const TabToken: string := C.Token('document-tab', TabId);
    Parts.Add(TabToken);
    Native.Add(
      new Cui.CuiDocumentTab(
        Item.Key,
        Item.Title,
        Item.Icon,
        Item.Tooltip,
        Item.Dirty
      )
    );
    if Index = Selected and C.WantsFocus<TMsg>(
      Frame,
      TabId,
      TabToken,
      Frame.AcceptInput
    )
    then
      Focus := true;
    end if;
  end for;
  const Result: Cui.CuiDocumentTabChange := Frame.Window.DocumentTabs(
    Token,
    Native.ToArray(),
    Selected,
    new Cui.CuiDocumentTabOptions(Settings.Shortcuts, Settings.Closable, Settings.Reorderable),
    Frame.AcceptInput,
    Focus,
    if Frame.PaintingClosed then
      null
    else
      Parts.ToArray()
    end if
  );
  if Frame.AcceptInput and (Result.Selected <> Selected or Result.Close >= 0 or Result.MoveFrom >=
    0)
  then
    Frame.Messages.Add(
      Changed(new D.Change(Result.Selected, Result.Close, Result.MoveFrom, Result.MoveTo))
    );
  end if;

  if not Frame.PaintingClosed then
    Frame.Controls.Add(
      new App.Control(
        Id,
        '',
        Role,
        new Cui.CuiRectangle(),
        Frame.AcceptInput,
        Value := Result.Selected.ToString()
      )
    );
    for Index: int := 0 to Tabs.Length - 1 do
      const Item: D.Tab := Tabs[Index];
      Frame.Controls.Add(
        new App.Control(
          M.ItemId(Id, Item.Key), Item.Title, 'document-tab',
          new Cui.CuiRectangle(), Frame.AcceptInput and Index = Selected
        )
      );
    end for;
  end if;
end procedure;

end unit;
