unit Fpas.Ui.Gui.Internal.Widgets.DonutChart;

uses
  Fpas.Ui.DonutCharts as D, Fpas.Ui.Gui.Internal.ChartData as Data,
  Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Sizing as Size;

// Draws the native CUI donut-chart.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable identity.
// - `Values`: Nonnegative shares.
// - `Labels`: Share captions.
// - `Settings`: Native presentation.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Values: array of float; Labels: array of string; Settings: D.Options);
begin
  const Token: string := C.Token('donut-chart', Id);
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  Frame.Window.DonutChart(
    Token, Values, Labels, Width.Kind, Width.Value, Settings.Height,
    Data.Format(Settings.Format), Settings.Legend, not Frame.PaintingClosed
  );
  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(Id, 'DonutChart', 'donut-chart', new Cui.CuiRectangle(), false)
  );
end procedure;

end unit;
