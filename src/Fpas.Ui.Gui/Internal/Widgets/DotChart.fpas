unit Fpas.Ui.Gui.Internal.Widgets.DotChart;

uses
  Fpas.Ui.DotCharts as W, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.ChartData as Charts,
  Fpas.Ui.Charts as Data, System as Sys;

// Presents the native CUI widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Bands`: Stacked series.
// - `Count`: Samples per series.
// - `Activate`: Optional activation mapper.
// - `Settings`: Native presentation options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Bands: array of W.Series; Count: int; Activate: Sys.Func<W.Hit, TMsg>?; Settings: W.Options);
begin
  const Token: string := C.Token('dot-chart', Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Samples: array of float := new float[Bands.Length * Count];
  const Accent: array of int := new int[Bands.Length];
  for Index: int := 0 to Bands.Length - 1 do
    Sys.Array.Copy(Bands[Index].Values, 0, Samples, Index * Count, Count);
    Accent[Index] := if Bands[Index].Accent then
      1
    else
      0
    end if;
  end for;
  const Common: Cui.CuiChartOptions := Charts.Options(
    new Data.Options(
      Width := Settings.Width,
      Height := Settings.Height, Format := Settings.Format, Grid := Settings.Grid,
      Range := Settings.Range, Annotations := Settings.Annotations
    )
  );
  const Native: Cui.CuiDotOptions := new Cui.CuiDotOptions(
    Common, Settings.XMinimum, Settings.XMaximum,
    Settings.XStep, cast<int>(Settings.Units), Charts.Format(Settings.XFormat), Settings.Unit,
    Settings.Pitch, Settings.Axis, Settings.Readout
  );
  const Hit: Cui.CuiDotHit := Frame.Window.DotChart(
    Token, Samples, Accent, Count, Native,
    Enabled, C.WantsFocus<TMsg>(Frame, Id, Token, Enabled)
  );
  if Hit.Clicked and Enabled then
    case Activate of
      when is Sys.Func<W.Hit, TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke(new W.Hit(Hit.X, Hit.Index, Hit.Value)));
      else
    end case;
  end if;

  C.Track<TMsg>(
    Frame, new App.Control(
      Id, '', 'dot-chart', new Cui.CuiRectangle(), Enabled,
      Value := Hit.Index.ToString()
    )
  );
end procedure;

end unit;
