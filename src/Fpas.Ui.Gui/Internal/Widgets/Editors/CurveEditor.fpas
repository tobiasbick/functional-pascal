// [Documentation](../../../../../docs/ui/gui/editing-tools/curve-editor.md)

unit Fpas.Ui.Gui.Internal.Widgets.Editors.CurveEditor;

uses Fpas.Ui.Gui.Cui.Widgets.Editors as CuiEditors;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.ChartData as ChartData;
uses Fpas.Ui.Gui.Internal.Data.CurveData as KeyData;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Editors.CurveEditors as D;

uses System.Collections.Generic as Lists;

// Presents a native CurveEditor.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable widget identity.
// - `Keys`: Keys, sorted by X.
// - `Selected`: Current key selection.
// - `Changed`: Maps a native proposal.
// - `Settings`: Native layout and behavior options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Keys: array of D.Key;
  Selected: int;
  Changed: function(D.Event): TMsg;
  Settings: D.Options
);
begin
  const Role: string := 'curve-editor';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Enabled: bool := Frame.AcceptInput;
  const Marker: float? := Settings.Playhead;
  const Result: CuiEditors.CuiCurveEdit? := Frame.Window.CurveEditor(
    Token,
    KeyData.PackKeys(Keys),
    Settings.Capacity,
    Selected,
    Settings.XMinimum,
    Settings.XMaximum,
    Settings.YMinimum,
    Settings.YMaximum,
    Settings.XLabel,
    Settings.YLabel,
    Settings.Height,
    Width.Kind,
    Width.Value,
    Marker ??
    0.0F,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.Snap, 2) or Enc.Bits(Marker <> null, 4),
    ChartData.Format(Settings.XFormat), ChartData.Format(Settings.YFormat)
  );
  case Result of
    when is CuiEditors.CuiCurveEdit as Edit:
      const NewKeys: Lists.List of D.Key := new Lists.List of D.Key(Edit.Keys.Length);
      for Item: CuiEditors.CuiCurveKey in Edit.Keys do
        NewKeys.Add(KeyData.Read(Item));
      end for;

      Frame.Messages.Add(
        Changed(
          new D.Event(
            NewKeys.ToArray(), Edit.Selected, Edit.Added, Edit.Removed,
            Edit.Changed, Edit.Hovered, Edit.HoverX, Edit.HoverY
          )
        )
      );
    else
  end case;

  P.Root of TMsg(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
