// [Documentation](../../../../../docs/ui/gui/canvas-and-bars/node-editor.md)

unit Fpas.Ui.Gui.Internal.Widgets.Editors.NodeEditor;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Cui.Widgets.Editors as CuiEditors;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.CanvasData as Data;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as Size;
uses Fpas.Ui.Gui.Internal.Widgets.Canvas.SelectionRing as NativeRing;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Canvas.SelectionRings as Ring;
uses Fpas.Ui.Widgets.Editors.NodeEditors as D;

uses System.Collections.Generic as Lists;
uses System.Linq.Enumerable as Linq;

type NativeStatus = record
  public Nodes: Lists.List of int := new Lists.List of int();
  public Pins: Lists.List of int := new Lists.List of int();
  public Links: Lists.List of int := new Lists.List of int();
end record;

// Presents CUI's native NodeEditor widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Viewport`: Current pan and zoom.
// - `Nodes`: Nodes and their bodies.
// - `Links`: Current links.
// - `Changed`: Maps native proposals to messages.
// - `Settings`: Native widget settings.
// - `Visit`: Presents embedded content.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Viewport: D.View;
  Nodes: array of D.Node of TMsg;
  Links: array of D.Link;
  Changed: function(D.Event): TMsg;
  Settings: D.Options;
  Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment)
);
begin
  const Role: string := 'node-editor';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Height: Size.NativeExtent := Size.Extent(Settings.Height);
  if not Frame.Window.BeginNodeEditor(
    Token,
    Data.View(Viewport),
    Width.Kind,
    Width.Value,
    Height.Kind,
    Height.Value,
    Settings.MinimumZoom,
    Settings.MaximumZoom,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.HideGrid, 2) or Enc.Bits(Settings.Minimap, 4)
  )
  then
    return;
  end if;
  const BodyFrame: C.State of TMsg := Frame with
    AcceptInput := Enabled;
    Interactive := Frame.Interactive and Settings.Enabled;
    PaintingClosed := Frame.PaintingClosed or not Settings.Enabled;
  end with;
  const Expected: D.Status? := if Enabled then
    Settings.ObservedStatus
  else
    null
  end if;
  const Status: NativeStatus? := if Expected <> null then
    new NativeStatus()
  else
    null
  end if;
  for Item: D.Node of TMsg in Nodes do
    var X: float := Item.X;
    var Y: float := Item.Y;
    discard Frame.Window.BeginNode(
      Item.Id,
      ref X,
      ref Y,
      Item.Title,
      Item.Width,
      Item.Icon
    );
    for Pin: D.Pin in Item.Pins do
      const Connected: bool := Frame.Window.NodePin(Pin.Id, Pin.Label, Pin.Output, Pin.Kind);
      if Connected and Status <> null then
        Status.Pins.Add(Pin.Id);
      end if;
    end for;

    case Item.Body of
      when is E.Element of TMsg as Content:
        Frame.Window.BeginNodeContent();
        Visit(Content, BodyFrame, false, L.Alignment.Default);
        Frame.Window.EndNodeContent();
      else
    end case;

    Frame.Window.EndNode();
    case Item.Ring of
      when is Ring.Options as Decoration:
        NativeRing.Apply(Frame.Window, Decoration);
      else
    end case;

    if Enabled and (X <> Item.X or Y <> Item.Y) then
      Frame.Messages.Add(Changed(D.Event.Move(Item.Id, X, Y)));
    end if;
  end for;

  for Link: D.Link in Links do
    const Selected: bool := Frame.Window.NodeLink(Link.Id, Link.FromPin, Link.ToPin);
    if Selected and Status <> null then
      Status.Links.Add(Link.Id);
    end if;
  end for;

  if Status <> null then
    for Item: D.Node of TMsg in Nodes do
      if Frame.Window.IsNodeSelected(Item.Id) then
        Status.Nodes.Add(Item.Id);
      end if;
    end for;
  end if;
  const Next: CuiEditors.CuiNodeView := Frame.Window.EndNodeEditor();
  P.Root of TMsg(Frame, Id, Role, '', Enabled, Next.Zoom.ToString());
  if Enabled then
    if Next.X <> Viewport.X or Next.Y <> Viewport.Y or Next.Zoom <> Viewport.Zoom then
      Frame.Messages.Add(Changed(D.Event.Pan(new D.View(Next.X, Next.Y, Next.Zoom))));
    end if;
    var First: int := 0;
    var Second: int := 0;
    while Frame.Window.NodeEvent(0, out First, out Second) do
      Frame.Messages.Add(Changed(D.Event.Connect(First, Second)));
    end while;

    while Frame.Window.NodeEvent(1, out First, out Second) do
      Frame.Messages.Add(Changed(D.Event.Unlink(First)));
    end while;

    while Frame.Window.NodeEvent(2, out First, out Second) do
      Frame.Messages.Add(Changed(D.Event.Delete(First)));
    end while;

    if Status <> null and Expected <> null and (not Linq.SequenceEqual of int(
      Status.Nodes,
      Expected.SelectedNodes
    )
      or not Linq.SequenceEqual of int(Status.Pins, Expected.ConnectedPins)
      or not Linq.SequenceEqual of int(Status.Links, Expected.SelectedLinks))
    then
      Frame.Messages.Add(
        Changed(
          D.Event.StatusChanged(
            new D.Status(Status.Nodes.ToArray(), Status.Pins.ToArray(), Status.Links.ToArray())
          )
        )
      );
    end if;
  end if;
end procedure;

end unit;
