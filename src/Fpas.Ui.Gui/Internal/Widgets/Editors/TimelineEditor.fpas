unit Fpas.Ui.Gui.Internal.Widgets.Editors.TimelineEditor;

uses
  Fpas.Ui.Widgets.Editors.TimelineEditors as D, Fpas.Ui.Gui.Internal.Hosting.Context as C,
  Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Cui.Widgets.Editors as CuiEditors,
  Fpas.Ui.Gui.Internal.Data.CurveData as KeyData, System.Collections.Generic as Lists;

function Pack(Track: D.Track): CuiEditors.CuiTimelineTrack;
begin
  const Keys: Lists.List<CuiEditors.CuiTimelineKey> := new Lists.List<CuiEditors.CuiTimelineKey>(
    Track.Keys.Length
  );
  const Clips: Lists.List<CuiEditors.CuiTimelineClip> := new Lists.List<CuiEditors.CuiTimelineClip>(
    Track.Clips.Length
  );
  for Item: D.Key in Track.Keys do
    Keys.Add(new CuiEditors.CuiTimelineKey(KeyData.Pack(Item.Curve), Item.Selected));
  end for;

  for Item: D.Clip in Track.Clips do
    Clips.Add(
      new CuiEditors.CuiTimelineClip(Item.Start, Item.Finish, Item.Offset, Item.Name, Item.Selected)
    );
  end for;

  return new CuiEditors.CuiTimelineTrack(
    Track.Name, Track.Icon, Track.Depth, Track.Collapsed, Track.Muted, Track.Locked,
    Track.Color, Keys.ToArray(), Track.Capacity, Clips.ToArray()
  );
end function;

function Read(Track: CuiEditors.CuiTimelineTrack): D.Track;
begin
  const Keys: Lists.List<D.Key> := new Lists.List<D.Key>(Track.Keys.Length);
  const Clips: Lists.List<D.Clip> := new Lists.List<D.Clip>(Track.Clips.Length);
  for Item: CuiEditors.CuiTimelineKey in Track.Keys do
    Keys.Add(new D.Key(KeyData.Read(Item.Curve), Item.Selected));
  end for;

  for Item: CuiEditors.CuiTimelineClip in Track.Clips do
    Clips.Add(new D.Clip(Item.Start, Item.End, Item.Offset, Item.Name, Item.Selected));
  end for;

  return new D.Track(
    Track.Name, Track.Icon, Track.Depth, Track.Collapsed, Track.Muted, Track.Locked,
    Track.Color, Keys.ToArray(), Track.Capacity, Clips.ToArray()
  );
end function;

// Presents a native TimelineEditor.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable widget identity.
// - `Tracks`: Tracks and their edit data.
// - `Current`: Playhead, range and selection.
// - `Changed`: Maps a native proposal.
// - `Settings`: Native layout and behavior options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Tracks: array of D.Track; Current: D.View; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'timeline-editor';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Enabled: bool := Frame.AcceptInput;
  const Native: Lists.List<CuiEditors.CuiTimelineTrack> := new Lists.List<CuiEditors.CuiTimelineTrack>(
    Tracks.Length
  );
  for Track: D.Track in Tracks do
    Native.Add(Pack(Track));
  end for;
  const Focus: bool := C.WantsFocus<TMsg>(Frame, Id, Token, Enabled);
  const Play: D.PlayRange? := Current.Range;
  var From: float := 0.0F;
  var To: float := 0.0F;
  if Play <> null then
    From := Play.Start;
    To := Play.Finish;
  end if;
  const View: CuiEditors.CuiTimelineRange := new CuiEditors.CuiTimelineRange(
    Current.Time, Current.Start, Current.Finish,
    Current.Scroll, Current.TrackIndex, Current.KeyIndex, Play <> null, From, To
  );
  const Result: CuiEditors.CuiTimelineEdit? := Frame.Window.TimelineEditor(
    Token,
    Native.ToArray(),
    View,
    Settings.Start,
    Settings.Finish,
    Settings.FramesPerSecond,
    Settings.Height,
    Settings.RowHeight,
    Settings.TrackWidth,
    cast<int>(Settings.Labels),
    Width.Kind,
    Width.Value,
    P.Bits(Enabled, 1) or P.Bits(
      Settings.Toggles,
      2
    ) or P.Bits(Settings.FreeDrag, 4) or P.Bits(Focus, 8)
  );
  case Result of
    when is CuiEditors.CuiTimelineEdit as Edit:
      const NewTracks: Lists.List<D.Track> := new Lists.List<D.Track>(Edit.Tracks.Length);
      for Track: CuiEditors.CuiTimelineTrack in Edit.Tracks do
        NewTracks.Add(Read(Track));
      end for;
      const State: CuiEditors.CuiTimelineRange := Edit.View;
      const Range: D.PlayRange? := if State.HasRange then
        new D.PlayRange(State.In, State.Out)
      else
        null
      end if;
      Frame.Messages.Add(
        Changed(
          new D.Event(
            NewTracks.ToArray(), new D.View(
              State.Time, State.Start, State.End, State.Scroll, State.Track, State.Key, Range
            ), Edit.Play
          )
        )
      );
    else
  end case;

  P.Root<TMsg>(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
