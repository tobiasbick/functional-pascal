// [Documentation](../../../../../docs/ui/gui/feedback/badge.md)

unit Fpas.Ui.Gui.Internal.Widgets.Feedback.Badge;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Feedback.Badges as B;

// Draws a native badge.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable badge identity.
// - `Text`: Literal caption.
// - `Settings`: Appearance.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Text: string; Settings: B.Options);
begin
  Frame.Window.Badge(
    Text,
    cast Settings.Tone as int,
    Settings.Dot,
    Settings.Solid,
    Settings.Icon,
    cast Settings.Size as int
  );
  C.Track of TMsg(Frame, new App.Control(Id, Text, 'badge', new Cui.CuiRectangle(), false));
end procedure;

end unit;
