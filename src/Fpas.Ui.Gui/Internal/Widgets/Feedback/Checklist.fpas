unit Fpas.Ui.Gui.Internal.Widgets.Feedback.Checklist;

uses
  Fpas.Ui.Widgets.Feedback.Checklists as K, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui.Widgets.Feedback as CuiFeedback,
  Fpas.Ui.Gui.Cui as Cui, System as Sys, System.Collections.Generic as Lists;

function PartToken(Id: string; Slot: int): string;
begin
  const Index: int := Slot div 2;
  return if Slot mod 2 = 0 then
    C.Token('checklist-step', K.StepId(Id, Index))
  else
    C.Token('checklist-action', K.ActionId(Id, Index))
  end if;
end function;

// Draws the native onboarding card and forwards step proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation state.
// - `Id`: Stable checklist identity.
// - `Steps`: Ordered model-owned steps.
// - `OnToggle`: Maps a proposed completion change to a message.
// - `OnAction`: Optional callback for an activated step action.
// - `Settings`: Native presentation and input options.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Steps: array of K.Step; OnToggle: function(int, bool): TMsg;
  OnAction: Sys.Func<int, TMsg>?; Settings: K.Options
);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Titles: Lists.List<string> := new Lists.List<string>(Steps.Length);
  const Descriptions: Lists.List<string> := new Lists.List<string>(Steps.Length);
  const Actions: Lists.List<string> := new Lists.List<string>(Steps.Length);
  const Completed: array of int := new int[Steps.Length];
  var Focus: int := 0;
  var Done: int := 0;
  var ActiveIndex: int := -1;
  for Index: int := 0 to Steps.Length - 1 do
    const Step: K.Step := Steps[Index];
    Titles.Add(Step.Title);
    Descriptions.Add(Step.Description);
    Actions.Add(Step.ActionLabel);
    if Step.Done then
      Completed[Index] := 1;
      Done := Done + 1;
    end if;

    if C.WantsFocus<TMsg>(Frame, K.StepId(Id, Index), PartToken(Id, Index * 2), Enabled) then
      Focus := Index * 2 + 1;
    end if;

    if ActiveIndex < 0 and not Step.Done then
      ActiveIndex := Index;
      if Step.ActionLabel <> '' and C.WantsFocus<TMsg>(
        Frame,
        K.ActionId(Id, Index),
        PartToken(Id, Index * 2 + 1),
        Enabled
      )
      then
        Focus := Index * 2 + 2;
      end if;
    end if;
  end for;
  const Track: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Slot: int): string => PartToken(Id, Slot)
  end if;
  const Result: CuiFeedback.CuiChecklistResult := Frame.Window.Checklist(
    C.Token('checklist', Id), Settings.Title, Settings.Description, Titles.ToArray(),
    Descriptions.ToArray(), Actions.ToArray(), Completed, Enabled, Focus, Track
  );
  for Index: int := 0 to Steps.Length - 1 do
    if Result.Completed[Index] <> Completed[Index] then
      Frame.Messages.Add(OnToggle(Index, Result.Completed[Index] <> 0));
    end if;
  end for;

  if Result.Action >= 0 then
    case OnAction of
      when is Sys.Func<int, TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke(Result.Action));
      else
    end case;
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(
      Id, Settings.Title, 'checklist', new Cui.CuiRectangle(), Enabled,
      Value := Done.ToString() + '/' + Steps.Length.ToString()
    )
  );
  for Index: int := 0 to Steps.Length - 1 do
    Frame.Controls.Add(
      new App.Control(
        K.StepId(Id, Index), Steps[Index].Title, 'checklist-step',
        new Cui.CuiRectangle(), Enabled, Value := if Steps[Index].Done then
          'true'
        else
          'false'
        end if
      )
    );
  end for;

  for Index: int in Result.VisibleActions do
    Frame.Controls.Add(
      new App.Control(
        K.ActionId(Id, Index), Steps[Index].ActionLabel, 'checklist-action',
        new Cui.CuiRectangle(), Enabled and Index = ActiveIndex
      )
    );
  end for;
end procedure;

end unit;
