unit Fpas.Ui.Gui.Internal.Widgets.Feedback.Countdown;

uses
  Fpas.Ui.Widgets.Feedback.Countdowns as D, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, System.Globalization as Culture;

// Draws CUI's rolling digits for the supplied duration.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation state.
// - `Id`: Stable countdown identity.
// - `Seconds`: Model-owned remaining seconds.
// - `Settings`: Native tile options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Seconds: double; Settings: D.Options);
begin
  const Role: string := 'countdown';
  Frame.Window.Countdown(
    C.Token(Role, Id),
    Seconds,
    Settings.Compact,
    Settings.HideDays,
    not Frame.PaintingClosed
  );
  if not Frame.PaintingClosed then
    Frame.Controls.Add(
      new App.Control(
        Id, '', Role, new Cui.CuiRectangle(), false,
        Value := Seconds.ToString(Culture.CultureInfo.InvariantCulture)
      )
    );
  end if;
end procedure;

end unit;
