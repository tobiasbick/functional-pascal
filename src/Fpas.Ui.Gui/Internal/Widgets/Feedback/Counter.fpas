// [Documentation](../../../../../docs/ui/gui/social-and-media/counter.md)

unit Fpas.Ui.Gui.Internal.Widgets.Feedback.Counter;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Colors;
uses Fpas.Ui.Widgets.Feedback.Counters as W;

uses System as Sys;

// Draws the native rolling numeric counter.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Value`: Current numeric value.
// - `Settings`: Native options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Value: double;
  Settings: W.Options
);
begin
  const Role: string := 'counter';
  const Token: string := C.Token(Role, Id);
  Frame.Window.Counter(
    Token, Value, Colors.Format(Settings.Format), Settings.Size,
    Colors.Color(Settings.Color), Settings.GroupThousands, cast Settings.Font as int
  );
  P.Root of TMsg(
    Frame,
    Id,
    Role,
    '',
    false,
    Value.ToString(Sys.Globalization.CultureInfo.InvariantCulture)
  );
end procedure;

end unit;
