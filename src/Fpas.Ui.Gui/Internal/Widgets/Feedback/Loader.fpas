unit Fpas.Ui.Gui.Internal.Widgets.Feedback.Loader;

uses
  Fpas.Ui.Widgets.Feedback.Loaders as W, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Internal.Data.ChartData as Colors;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Style`: Loader style.
// - `Settings`: Native appearance and input options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Style: W.Animation; Settings: W.Options);
begin
  Frame.Window.Loader(
    C.Token('loader', Id),
    cast<int>(Style),
    Settings.Size,
    Colors.Color(Settings.Color)
  );
  C.Track<TMsg>(Frame, new App.Control(Id, '', 'loader', new Cui.CuiRectangle(), false));
end procedure;

end unit;
