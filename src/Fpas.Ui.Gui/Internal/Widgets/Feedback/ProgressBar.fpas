// [Documentation](../../../../../docs/ui/gui/feedback/progress-bar.md)

unit Fpas.Ui.Gui.Internal.Widgets.Feedback.ProgressBar;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Feedback.ProgressBars as P;

uses System.Globalization as Culture;

// Draws native progress without implementing interpolation or activity timers.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable progress identity.
// - `Value`: Model-owned fraction.
// - `Settings`: Native presentation options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Value: float;
  Settings: P.Options
);
begin
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  Frame.Window.Progress(
    C.Token('progress', Id), Value, cast Settings.Tone as int,
    Settings.Indeterminate, Settings.Height, Settings.Label, Settings.ShowValue, Settings.Dither,
    Width.Kind, Width.Value
  );
  if not Frame.PaintingClosed and Settings.Label <> '' then
    Frame.Labels.Add(Settings.Label);
  end if;

  C.Track of TMsg(
    Frame, new App.Control(
      Id, Settings.Label, 'progress', new Cui.CuiRectangle(), false,
      Value := if Settings.Indeterminate then
        'indeterminate'
      else
        Value.ToString(
          Culture.CultureInfo.InvariantCulture
        )
      end if
    )
  );
end procedure;

end unit;
