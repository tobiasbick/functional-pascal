// [Documentation](../../../../../docs/ui/gui/feedback/skeleton.md)

unit Fpas.Ui.Gui.Internal.Widgets.Feedback.Skeleton;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as Size;
uses Fpas.Ui.Layout as L;

// Draws a native placeholder without calculating its width or animating its shimmer.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable placeholder identity.
// - `Width`: Validated native width mode.
// - `Height`: Logical height; zero selects the native default.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Width: L.Extent; Height: float);
begin
  const Native: Size.NativeExtent := Size.Extent(Width);
  Frame.Window.Skeleton(C.Token('skeleton', Id), Native.Kind, Native.Value, Height);
  C.Track of TMsg(Frame, new App.Control(Id, '', 'skeleton', new Cui.CuiRectangle(), false));
end procedure;

end unit;
