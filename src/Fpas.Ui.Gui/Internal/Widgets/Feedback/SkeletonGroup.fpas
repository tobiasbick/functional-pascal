// [Documentation](../../../../../docs/ui/gui/feedback/skeleton-group.md)

unit Fpas.Ui.Gui.Internal.Widgets.Feedback.SkeletonGroup;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Feedback.SkeletonGroups as W;

// Builds a native group of placeholders with a shared animation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Children`: Placeholder views in native layout order.
// - `Settings`: Native options.
// - `Visit`: Presents each composed child.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Children: array of E.Element of TMsg; Settings: W.Options; Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment));
begin
  const Role: string := 'skeleton-group';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  Frame.Window.BeginSkeletonGroup(Token, Width.Kind, Width.Value, Settings.Gap, Settings.Dither);
  for Child: E.Element of TMsg in Children do
    Visit(Child, Frame, false, L.Alignment.Default);
  end for;

  Frame.Window.EndSkeletonGroup();
  P.Root of TMsg(Frame, Id, Role, '', false, '');
end procedure;

end unit;
