unit Fpas.Ui.Gui.Internal.Widgets.Feedback.Spinner;

uses
  Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Widgets.Feedback.Spinners as W, Fpas.Ui.Gui.Internal.Data.ChartData as Colors;

// Draws the native activity spinner without a managed animation loop.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable inspection identity.
// - `Size`: Logical diameter, or zero for the native default.
// - `Settings`: Native animation style and colors.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Size: float; Settings: W.Options);
begin
  Frame.Window.Spinner(
    C.Token('spinner', Id), Size, cast<int>(Settings.Animation),
    Colors.Color(Settings.Color), Colors.Color(Settings.Track), Settings.Inverse
  );
  C.Track<TMsg>(Frame, new App.Control(Id, '', 'spinner', new Cui.CuiRectangle(), false));
end procedure;

end unit;
