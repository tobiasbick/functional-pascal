// [Documentation](../../../../../docs/ui/gui/feedback/status-spinner.md)

unit Fpas.Ui.Gui.Internal.Widgets.Feedback.StatusSpinner;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Colors;
uses Fpas.Ui.Widgets.Actions.StatusButtons as Buttons;
uses Fpas.Ui.Widgets.Feedback.StatusSpinners as W;

// Draws the native status spinner and its result transition.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Status`: Current work state.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Status: Buttons.Status; Settings: W.Options);
begin
  const Role: string := 'status-spinner';
  const Token: string := C.Token(Role, Id);
  const Visible: bool := Frame.Window.StatusSpinner(
    Token, cast<int>(Status), Settings.Size, Colors.Color(Settings.Color), Settings.Keep
  );
  P.Root of TMsg(
    Frame, Id, Role, '', false, if Visible then
      Status.ToString()
    else
      ''
    end if
  );
end procedure;

end unit;
