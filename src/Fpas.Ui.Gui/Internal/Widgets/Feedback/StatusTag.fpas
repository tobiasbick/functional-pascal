// [Documentation](../../../../../docs/ui/gui/creative-controls/status-tag.md)

unit Fpas.Ui.Gui.Internal.Widgets.Feedback.StatusTag;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as W;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Widgets.Feedback.StatusTags as A;

uses System as Sys;

const DefaultLabels: array of string := [
  'Pending',
  'In progress',
  'Submitted',
  'In review',
  'Success',
  'Failed',
  'Expired',
  ''
];

// Presents the native status tag.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Current`: Model-owned value.
// - `Remove`: Optional removal message factory.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Current: A.Value; Remove: (Sys.Func of TMsg)?; Settings: A.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled and Remove <> null;
  const Role: string := 'status-tag';
  const Token: string := C.Token(Role, Id);
  const Flags: int := Enc.Bits(
    Settings.Small,
    1
  ) + Enc.Bits(Remove <> null, 2) + Enc.Bits(Enabled, 4);
  const Focus: int := W.Focus of TMsg(Frame, Id, Role, [''], [Enabled], 0);
  const Result: int := Frame.Window.StatusTag(
    Token, Current.Label, cast Current.Preset as int,
    Settings.Icon, cast Settings.Tone as int, Flags, Focus, null
  );
  if Result <> 0 then
    case Remove of
      when is Sys.Func of TMsg as Notify:
        Frame.Messages.Add(Notify.Invoke());
      else
    end case;
  end if;
  const Caption: string := if Current.Label <> '' then
    Current.Label
  else
    DefaultLabels[cast Current.Preset as int]
  end if;
  W.Root of TMsg(Frame, Id, Role, Caption, Enabled, '');
end procedure;

end unit;
