unit Fpas.Ui.Gui.Internal.Widgets.FilePicker;

uses
  Fpas.Ui.FilePickers as A, Fpas.Ui.Gui.Internal.Context as C,
  Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.FileData as D, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Presents the native file picker.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Base`: Underlying view.
// - `Open`: Model-owned visibility.
// - `Change`: Maps a native proposal.
// - `Settings`: Native options.
// - `Horizontal`: Parent axis.
// - `Align`: Parent alignment.
// - `Visit`: GUI traversal for composed content.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Base: E.Element<TMsg>?; Open: bool; Change: function(A.Event): TMsg; Settings: A.Options; Horizontal: bool; Align: L.Alignment; Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment));
begin
  if Base <> null then
    Visit(
      Base, Frame with
        AcceptInput := Frame.AcceptInput and not Open;
      end with, Horizontal, Align
    );
  end if;

  if Frame.PaintingClosed then
    return;
  end if;
  const Role: string := 'file-picker';
  const Parts: array of string := ['dialog', 'cancel', 'confirm', 'name', 'list'];
  const Enabled: bool := Open and Frame.Interactive and Frame.ActiveModal = Id;
  const Result: Cui.CuiFilePickerResult := Frame.Window.FilePicker(
    C.Token(Role, Id),
    Open,
    Enabled,
    cast<int>(Settings.Kind),
    Settings.Title,
    Settings.Start,
    Settings.Name,
    Settings.Filter,
    Settings.FilterLabel,
    D.Provider(Settings.Source),
    if Open then
      P.Tracker<TMsg>(Frame, Id, Role, Parts)
    else
      null
    end if
  );
  if Enabled and Result.Closed then
    Frame.Messages.Add(Change(new A.Event(Result.Path)));
  end if;

  if Open then
    for Index: int := 0 to Parts.Length - 1 do
      if Result.Parts[Index] then
        P.Part<TMsg>(Frame, Id, Role, Parts[Index], Parts[Index], Enabled and Index <> 0, '');
      end if;
    end for;
  end if;
end procedure;

end unit;
