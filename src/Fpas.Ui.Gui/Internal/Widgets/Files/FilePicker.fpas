// [Documentation](../../../../../docs/ui/gui/files/file-picker.md)

unit Fpas.Ui.Gui.Internal.Widgets.Files.FilePicker;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Cui.Widgets.Files as CuiFiles;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.FileData as D;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Files.FilePickers as A;

// Presents the native file picker.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Base`: Underlying view.
// - `Open`: Model-owned visibility.
// - `Change`: Maps a native proposal.
// - `Settings`: Native options.
// - `Horizontal`: Parent axis.
// - `Align`: Parent alignment.
// - `Visit`: GUI traversal for composed content.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Base: (E.Element of TMsg)?;
  Open: bool;
  Change: function(A.Event): TMsg;
  Settings: A.Options;
  Horizontal: bool;
  Align: L.Alignment;
  Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment)
);
begin
  if Base <> null then
    Visit(
      Base, Frame with
        AcceptInput := Frame.AcceptInput and not Open;
      end with, Horizontal, Align
    );
  end if;

  if Frame.PaintingClosed then
    return;
  end if;
  const Role: string := 'file-picker';
  const Parts: array of string := ['dialog', 'cancel', 'confirm', 'name', 'list'];
  const Enabled: bool := Open and Frame.Interactive and Frame.ActiveModal = Id;
  const Result: CuiFiles.CuiFilePickerResult := Frame.Window.FilePicker(
    C.Token(Role, Id),
    Open,
    Enabled,
    cast Settings.Kind as int,
    Settings.Title,
    Settings.Start,
    Settings.Name,
    Settings.Filter,
    Settings.FilterLabel,
    D.Provider(Settings.Source),
    if Open then
      P.Tracker of TMsg(Frame, Id, Role, Parts)
    else
      null
    end if
  );
  if Enabled and Result.Closed then
    Frame.Messages.Add(Change(new A.Event(Result.Path)));
  end if;

  if Open then
    for Index: int := 0 to Parts.Length - 1 do
      if Result.Parts[Index] then
        P.Part of TMsg(Frame, Id, Role, Parts[Index], Parts[Index], Enabled and Index <> 0, '');
      end if;
    end for;
  end if;
end procedure;

end unit;
