// [Documentation](../../../../../docs/ui/gui/capture/signature-pad.md)

unit Fpas.Ui.Gui.Internal.Widgets.Files.SignaturePad;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Cui.Widgets.Files as CuiFiles;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Files.SignaturePads as S;

uses System as Sys;
uses System.Collections.Generic as Lists;

function Snapshot(Value: CuiFiles.CuiSignature): S.Signature;
begin
  const Coordinates: array of float := Value.Coordinates;
  const Points: Lists.List of S.Point := new Lists.List of S.Point(Coordinates.Length div 2);
  for Index: int := 0 to Coordinates.Length div 2 - 1 do
    Points.Add(new S.Point(Coordinates[Index * 2], Coordinates[Index * 2 + 1]));
  end for;

  return new S.Signature(Points.ToArray(), Value.StrokeEnds);
end function;

// Draws CUI's signature pad and translates its detached points.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation state.
// - `Id`: Stable pad identity.
// - `OnChange`: Optional mapper for points and stroke boundaries.
// - `Settings`: Native display and input settings.
public procedure Draw of TMsg(
  Frame: C.State of TMsg; Id: string; OnChange: Sys.Func of (S.Signature, TMsg)?; Settings: S.Options
);
begin
  const Enabled: bool := Settings.Enabled and Frame.AcceptInput;
  const Role: string := 'signature-pad';
  const ClearRole: string := 'signature-clear';
  const ClearId: string := S.ClearId(Id);
  const ClearToken: string := C.Token(ClearRole, ClearId);
  const Ink: G.Color? := Settings.Ink;
  const Rgba: uint := if Ink = null then
    0u
  elsif Ink.Alpha = 0 then
    1u
  else
    cast Ink.Red as uint or (cast Ink.Green as uint shl 8)
    or (cast Ink.Blue as uint shl 16) or (cast Ink.Alpha as uint shl 24)
  end if;
  var ClearVisible: bool := false;
  const Value: CuiFiles.CuiSignature? := Frame.Window.SignaturePad(
    C.Token(Role, Id), Settings.Placeholder, Settings.Height, Rgba, Enabled,
    C.WantsFocus of TMsg(Frame, ClearId, ClearToken, Enabled),
    not Frame.PaintingClosed, OnChange <> null, ClearToken, out ClearVisible
  );
  case OnChange of
    when is Sys.Func of (S.Signature, TMsg) as Notify:
      case Value of
        when is CuiFiles.CuiSignature as Changed:
          Frame.Messages.Add(Notify.Invoke(Snapshot(Changed)));
        else
      end case;
    else
  end case;

  if not Frame.PaintingClosed then
    Frame.Controls.Add(new App.Control(Id, 'Signature', Role, new Cui.CuiRectangle(), Enabled));
    if ClearVisible then
      Frame.Controls.Add(
        new App.Control(ClearId, 'Clear', ClearRole, new Cui.CuiRectangle(), Enabled)
      );
    end if;
  end if;
end procedure;

end unit;
