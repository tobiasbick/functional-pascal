unit Fpas.Ui.Gui.Internal.Widgets.FilterBar;

uses
  Fpas.Ui.FilterBars as B, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, System as Sys;

// Presents a native filter bar.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current host frame.
// - `Id`: Stable bar identity.
// - `Fields`: Native field descriptors.
// - `Current`: Model value.
// - `Change`: Maps a proposed filter value.
// - `Capacity`: UTF-8 search buffer size.
// - `Enabled`: Whether the bar accepts input.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Fields: array of B.Field; Current: B.Value; Change: function(B.Value): TMsg; Capacity: int; Enabled: bool);
  function Part(Index: int): string;
  begin
    return case Index of
      when 0: Id + '/search';
      when 1: Id + '/add';
      when 2: Id + '/clear';
      else Id + '/chip/' + (Index - 3).ToString(Sys.Globalization.CultureInfo.InvariantCulture);
    end case;
  end function;
begin
  const Accept: bool := Enabled and Frame.AcceptInput;
  const Token: string := C.Token('filter-bar', Id);
  const Native: array of Cui.CuiFilterField := new Cui.CuiFilterField[Fields.Length];
  for Index: int := 0 to Fields.Length - 1 do
    const Field: B.Field := Fields[Index];
    Native[Index] := new Cui.CuiFilterField(Field.Name, Field.Icon, Field.Values);
  end for;

  const Selected: array of uint := cast<array of uint>(Current.Selected.Clone());
  const Track: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Index: int): string => C.Token('filter-part', Part(Index))
  end if;
  const FocusPart: int := if Current.Search = null then
    1
  else
    0
  end if;
  const Result: Cui.CuiFilterResult := Frame.Window.FilterBar(
    Token, Native, Selected, Current.Search, Capacity, Accept,
    C.WantsFocus<TMsg>(Frame, Id, C.Token('filter-part', Part(FocusPart)), Accept), Track
  );
  if Accept and Result.Changed then
    Frame.Messages.Add(Change(new B.Value(Selected, Result.Search)));
  end if;

  C.Track<TMsg>(Frame, new App.Control(Id, '', 'filter-bar', new Cui.CuiRectangle(), Accept));

  for Index: int := 0 to Result.Parts.Length - 1 do
    if not Result.Parts[Index] then
      continue;
    end if;
    const Title: string := case Index of
      when 0: 'Search';
      when 1: 'Filter';
      when 2: 'Clear all';
      else Fields[Index - 3].Name;
    end case;
    Frame.Controls.Add(
      new App.Control(
        Part(Index), Title, 'filter-part', new Cui.CuiRectangle(),
        Accept, Value := if Index = 0 then
          Result.Search ?? ''
        else
          ''
        end if
      )
    );
  end for;
end procedure;

end unit;
