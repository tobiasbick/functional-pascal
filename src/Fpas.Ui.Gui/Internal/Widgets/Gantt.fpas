unit Fpas.Ui.Gui.Internal.Widgets.Gantt;

uses
  Fpas.Ui.Gantts as A, Fpas.Ui.Gui.Internal.Context as C,
  Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Sizing as S, Fpas.Ui.Gui.Internal.ScheduleData as D;

// Presents the native Gantt chart.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Current`: Model-owned input.
// - `Change`: Maps a native proposal.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Current: A.Value; Change: function(A.Event): TMsg; Settings: A.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Role: string := 'gantt';
  const Tasks: array of A.Task := Current.Tasks;
  const Keys: array of string := P.Indexed(Tasks.Length);
  const Data: array of Cui.CuiGanttTask := D.Gantt(Tasks);
  const Height: S.NativeExtent := S.Extent(Settings.Height);
  const Result: Cui.CuiGanttResult := Frame.Window.Gantt(
    C.Token(Role, Id),
    Current.Origin.DayNumber,
    Current.Days,
    Data,
    Settings.Today,
    Settings.DayWidth,
    Settings.RowHeight,
    Height.Kind,
    Height.Value,
    P.Bits(Enabled, 1) + P.Bits(Settings.ReadOnly, 2),
    P.Focus<TMsg>(Frame, Id, Role, Keys, P.Inputs(Keys.Length, Enabled), 0),
    P.Tracker<TMsg>(Frame, Id, Role, Keys)
  );
  const Edited: (array of Cui.CuiGanttTask)? := Result.Tasks;
  if Enabled and (Edited <> null or Result.Activated >= 0) then
    const Proposed: array of A.Task := if Edited = null then
      Tasks
    else
      D.GanttChanges(Edited, Tasks)
    end if;
    Frame.Messages.Add(Change(new A.Event(Proposed, Result.Activated)));
  end if;

  P.Root<TMsg>(Frame, Id, Role, '', false, '');
  for Index: int := 0 to Keys.Length - 1 do
    if Result.Parts[Index] then
      P.Part<TMsg>(
        Frame,
        Id,
        Role,
        Keys[Index],
        Tasks[Index].Name,
        Enabled,
        Data[Index].Start.ToString()
      );
    end if;
  end for;
end procedure;

end unit;
