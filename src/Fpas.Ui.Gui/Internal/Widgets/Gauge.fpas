unit Fpas.Ui.Gui.Internal.Widgets.Gauge;

uses
  Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui;

// Draws the native CUI gauge.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable identity.
// - `Label`: Literal caption.
// - `Value`: Fraction.
// - `Diameter`: Logical diameter.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Label: string; Value: float; Diameter: float);
begin
  const Token: string := C.Token('gauge', Id);
  Frame.Window.Gauge(Token, Label, Value, Diameter, not Frame.PaintingClosed);
  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(new App.Control(Id, Label, 'gauge', new Cui.CuiRectangle(), false));
end procedure;

end unit;
