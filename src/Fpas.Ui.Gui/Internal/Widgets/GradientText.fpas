unit Fpas.Ui.Gui.Internal.Widgets.GradientText;

uses
  Fpas.Ui.GradientTexts as W, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Sizing as S, Fpas.Ui.Gui.Internal.ChartData as Colors, Fpas.Ui.Motion as Motion;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Text`: Display text.
// - `Settings`: Native appearance and input options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Text: string; Settings: W.Options);
begin
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  Frame.Window.GradientText(
    C.Token('gradient-text', Id), Text,
    new Cui.CuiMotionText(
      cast<int>(Settings.Font),
      Width.Kind,
      Width.Value,
      Colors.Color(Settings.From),
      Settings.Size
    ),
    Colors.Color(Settings.To), Settings.Animate
  );
  C.Track<TMsg>(Frame, new App.Control(Id, Text, 'gradient-text', new Cui.CuiRectangle(), false));
end procedure;

end unit;
