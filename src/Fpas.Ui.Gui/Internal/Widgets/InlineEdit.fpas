unit Fpas.Ui.Gui.Internal.Widgets.InlineEdit;

uses
  Fpas.Ui.InlineEdits as I, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Sizing as Size;

// Draws native inline editing and emits only committed model proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation context.
// - `Id`: Stable editor identity.
// - `Value`: Confirmed model text.
// - `OnChange`: Maps a committed proposal.
// - `Settings`: Native presentation and capacity.

public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Value: string; OnChange: function(string): TMsg; Settings: I.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('inline-edit', Id);
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Result: Cui.CuiInlineEditResult := Frame.Window.InlineEdit(
    Token, Value, Settings.Placeholder,
    cast<int>(Settings.Face), Settings.FontSize, Settings.MaxUtf8Bytes, Width.Kind, Width.Value,
    Enabled, C.WantsFocus<TMsg>(Frame, Id, Token, Enabled), not Frame.PaintingClosed
  );
  if Enabled and Result.Value <> Value then
    Frame.Messages.Add(OnChange(Result.Value));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Labels.Add(Result.Draft);
  Frame.Controls.Add(
    new App.Control(
      Id,
      Result.Draft,
      'inline-edit',
      new Cui.CuiRectangle(),
      Enabled,
      Value := Result.Draft
    )
  );
end procedure;

end unit;
