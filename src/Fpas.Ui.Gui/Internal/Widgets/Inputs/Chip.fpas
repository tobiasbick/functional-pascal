// [Documentation](../../../../../docs/ui/gui/selection/chip.md)

unit Fpas.Ui.Gui.Internal.Widgets.Inputs.Chip;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;

// Presents CUI's chip and forwards its selection proposals and activations.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current frame and message queue.
// - `Id`: Stable identity.
// - `Label`: Literal caption.
// - `Selected`: Model-owned selection, or null for a stateless chip.
// - `OnChange`: Maps a proposed selection or stateless activation to a message.
// - `Icon`: Glyph for the unselected state. Null omits the icon.
// - `Enabled`: Model-owned input permission.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Label: string;
  Selected: bool?;
  OnChange: function(bool?): TMsg;
  Icon: string?;
  Enabled: bool
);
begin
  const Allowed: bool := Enabled and Frame.AcceptInput;
  const Token: string := C.Token('chip', Id);
  if Frame.Window.Chip(
    Token,
    Label,
    Icon,
    Selected,
    Allowed,
    C.WantsFocus of TMsg(Frame, Id, Token, Allowed)
  )
  then
    const Proposal: bool? := if Selected = null then
      null
    else
      not Selected.Value
    end if;
    Frame.Messages.Add(OnChange(Proposal));
  end if;

  C.Track of TMsg(
    Frame, new App.Control(
      Id, Label, 'chip', new Cui.CuiRectangle(), Allowed,
      Value := if Selected = null then
        ''
      elsif Selected.Value then
        'true'
      else
        'false'
      end if
    )
  );
end procedure;

end unit;
