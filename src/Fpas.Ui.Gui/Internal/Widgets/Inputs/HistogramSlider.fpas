unit Fpas.Ui.Gui.Internal.Widgets.Inputs.HistogramSlider;

uses
  Fpas.Ui.Widgets.Inputs.HistogramSliders as H, Fpas.Ui.Widgets.Inputs.RangeSliders as R, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Hosting.Context as C, System.Globalization as Culture;

// Draws the native histogram and publishes interval proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable control identity.
// - `Label`: Literal caption.
// - `Bins`: Finite nonnegative bar heights.
// - `Value`: Model-owned ordered interval.
// - `Minimum`: Inclusive lower bound.
// - `Maximum`: Inclusive upper bound.
// - `OnChange`: Maps proposed endpoints to a message.
// - `Settings`: Chart and input settings.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Label: string; Bins: array of float; Value: R.Interval;
  Minimum: float; Maximum: float; OnChange: function(R.Interval): TMsg; Settings: H.Options
);
begin
  const Enabled: bool := Settings.Enabled and Frame.AcceptInput;
  const Role: string := 'histogram-slider';
  const Token: string := C.Token(Role, Id);
  var Lower: float := Value.Lower;
  var Upper: float := Value.Upper;
  if Frame.Window.HistogramSlider(
    Token, Label, Bins, Lower, Upper, Minimum, Maximum, Settings.Height, Settings.DecimalPlaces,
    Settings.Prefix, Settings.Suffix, Enabled, C.WantsFocus<TMsg>(Frame, Id, Token, Enabled),
    not Frame.PaintingClosed, out Lower, out Upper
  )
  then
    Frame.Messages.Add(OnChange(new R.Interval(Lower, Upper)));
  end if;

  if not Frame.PaintingClosed then
    Frame.Controls.Add(
      new App.Control(
        Id, Label, Role, new Cui.CuiRectangle(), Enabled,
        Value := Value.Lower.ToString(Culture.CultureInfo.InvariantCulture) + ' – ' +
          Value.Upper.ToString(Culture.CultureInfo.InvariantCulture)
      )
    );
  end if;
end procedure;

end unit;
