unit Fpas.Ui.Gui.Internal.Widgets.Inputs.MultiSelect;

uses
  Fpas.Ui.Widgets.Inputs.MultiSelects as M, Fpas.Ui.Widgets.Inputs.Selects as S, Fpas.Ui.Gui.Internal.Hosting.Context as C,
  Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui.Widgets.Inputs as CuiInputs,
  Fpas.Ui.Gui.Cui as Cui, System as Sys,
  System.Collections.Generic as Lists;

// Draws the native multi-select and publishes the visible options.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable trigger identity.
// - `Items`: Ordered picker choices.
// - `Selected`: Model-owned flags.
// - `OnChange`: Maps the native proposal to a message.
// - `Settings`: Field appearance and input settings.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Items: array of S.Item; Selected: array of bool;
  OnChange: function(array of bool): TMsg; Settings: M.Options
);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('multi-select', Id);
  const Labels: Lists.List<string> := new Lists.List<string>(Items.Length);
  const Icons: Lists.List<string> := new Lists.List<string>(Items.Length);
  const Captions: Lists.List<string> := new Lists.List<string>();
  for Index: int := 0 to Items.Length - 1 do
    Labels.Add(Items[Index].Label);
    Icons.Add(Items[Index].Icon);
    if Selected[Index] then
      Captions.Add(Items[Index].Label);
    end if;
  end for;
  const Track: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Index: int): string => C.Token('multi-select-option', S.OptionId(Id, Index))
  end if;
  const Result: CuiInputs.CuiMultiSelectResult := Frame.Window.MultiSelect(
    Token,
    Labels.ToArray(),
    Icons.ToArray(),
    Selected,
    Settings.Label,
    Settings.Placeholder,
    Settings.MaxChips,
    Settings.Searchable,
    Enabled,
    C.WantsFocus<TMsg>(Frame, Id, Token, Enabled),
    Track
  );
  const Proposal: (array of bool)? := Result.Selection;
  if Proposal <> null then
    Frame.Messages.Add(OnChange(Proposal));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  if Settings.Label <> '' then
    Frame.Labels.Add(Settings.Label);
  end if;

  Frame.Controls.Add(
    new App.Control(
      Id, Settings.Label, 'multi-select', new Cui.CuiRectangle(), Enabled,
      Value := Sys.String.Join(', ', Captions.ToArray())
    )
  );
  for Index: int in Result.VisibleOptions do
    Frame.Controls.Add(
      new App.Control(
        S.OptionId(Id, Index),
        Labels[Index],
        'multi-select-option',
        new Cui.CuiRectangle(),
        Enabled,
        Value := if Selected[Index] then
          'true'
        else
          'false'
        end if
      )
    );
  end for;
end procedure;

end unit;
