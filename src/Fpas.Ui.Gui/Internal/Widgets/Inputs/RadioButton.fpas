// [Documentation](../../../../../docs/ui/gui/selection/radio-button.md)

unit Fpas.Ui.Gui.Internal.Widgets.Inputs.RadioButton;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;

// Presents native CUI's radio row and queues its proposed change.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current frame and message queue.
// - `Id`: Stable control identity.
// - `Label`: Literal caption.
// - `Selected`: Current model-owned value.
// - `OnSelect`: Maps native activation to an application message.
// - `Description`: Optional secondary caption.
// - `Enabled`: Model-owned input permission.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Label: string;
  Selected: bool;
  OnSelect: function(): TMsg;
  Description: string?;
  Enabled: bool
);
begin
  const Allowed: bool := Enabled and Frame.AcceptInput;
  const Token: string := C.Token('radio', Id);
  if Frame.Window.RadioButton(
    Token, Label, Description, Selected, Allowed, C.WantsFocus of TMsg(Frame, Id, Token, Allowed)
  )
  then
    Frame.Messages.Add(OnSelect());
  end if;

  C.Track of TMsg(
    Frame, new App.Control(
      Id, Label, 'radio', new Cui.CuiRectangle(), Allowed,
      Value := if Selected then
        'true'
      else
        'false'
      end if
    )
  );
end procedure;

end unit;
