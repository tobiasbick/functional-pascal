// [Documentation](../../../../../docs/ui/gui/selection/rating.md)

unit Fpas.Ui.Gui.Internal.Widgets.Inputs.Rating;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;

// Presents CUI's pointer-operated stars and forwards a proposed whole-star value.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current frame and message queue.
// - `Id`: Stable identity.
// - `Label`: Name for control inspection.
// - `Value`: Model-owned rating.
// - `OnChange`: Maps the proposed rating to a message.
// - `Maximum`: Number of stars.
// - `Enabled`: Model-owned input permission.
// - `StarSize`: Logical edge length of the native star boxes.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Label: string;
  Value: int;
  OnChange: function(int): TMsg;
  Maximum: int;
  Enabled: bool;
  StarSize: float
);
begin
  const Allowed: bool := Enabled and Frame.AcceptInput;
  const Proposal: int := Frame.Window.Rating(
    C.Token('rating', Id),
    Value,
    Maximum,
    Allowed,
    StarSize
  );
  if Proposal >= 0 then
    Frame.Messages.Add(OnChange(Proposal));
  end if;

  C.Track of TMsg(
    Frame,
    new App.Control(Id, Label, 'rating', new Cui.CuiRectangle(), Allowed, Value := Value.ToString())
  );
end procedure;

end unit;
