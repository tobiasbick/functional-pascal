unit Fpas.Ui.Gui.Internal.Widgets.Inputs.ShortcutRecorder;

uses
  Fpas.Ui.Widgets.Inputs.ShortcutRecorders as K, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui.Widgets.Inputs as CuiInputs,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Layout.Sizing as Size;

function Native(Value: K.Combination): CuiInputs.CuiKeyCombination;
begin
  return new CuiInputs.CuiKeyCombination(cast<int>(Value.Key), cast<int>(Value.Modifiers));
end function;

// Draws native recording, keycaps and the optional clear action.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation context.
// - `Id`: Stable recorder identity.
// - `Value`: Model-owned shortcut.
// - `OnChange`: Maps a native combination proposal.
// - `Settings`: Native placeholder, width and input settings.

public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Value: K.Combination; OnChange: function(K.Combination): TMsg; Settings: K.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('shortcut-recorder', Id);
  const Clear: string := K.ClearId(Id);
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Result: CuiInputs.CuiShortcutRecorderResult := Frame.Window.ShortcutRecorder(
    Token,
    Native(Value),
    Settings.Placeholder,
    Width.Kind,
    Width.Value,
    Enabled,
    C.WantsFocus<TMsg>(Frame, Id, Token, Enabled),
    if Frame.PaintingClosed then
      null
    else
      C.Token('button', Clear)
    end if,
    C.WantsFocus<TMsg>(Frame, Clear, C.Token('button', Clear), Enabled)
  );
  const Proposed: K.Combination := new K.Combination(
    cast<K.Key>(Result.Value.Key),
    cast<K.Modifier>(Result.Value.Modifiers)
  );
  if Enabled and Proposed <> Value then
    Frame.Messages.Add(OnChange(Proposed));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;
  const Caption: string := Frame.Window.ShortcutLabel(Result.Value);
  Frame.Labels.Add(Caption);
  Frame.Controls.Add(
    new App.Control(
      Id,
      Caption,
      'shortcut-recorder',
      new Cui.CuiRectangle(),
      Enabled,
      Value := Caption
    )
  );
  if Result.ClearVisible then
    Frame.Controls.Add(new App.Control(Clear, 'Clear', 'button', new Cui.CuiRectangle(), Enabled));
  end if;
end procedure;

// Displays the native platform shortcut label as CUI keycaps.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation context.
// - `Value`: Validated combination to display.

public procedure Label<TMsg>(Frame: C.State<TMsg>; Value: K.Combination);
begin
  const Caption: string := Frame.Window.DrawShortcutLabel(Native(Value));
  if not Frame.PaintingClosed then
    Frame.Labels.Add(Caption);
  end if;
end procedure;

end unit;
