// [Documentation](../../../../../docs/ui/gui/creative-controls/step-slider.md)

unit Fpas.Ui.Gui.Internal.Widgets.Inputs.StepSlider;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as W;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Widgets.Audio.ControlWells as Wells;
uses Fpas.Ui.Widgets.Inputs.StepSliders as A;

// Presents the native step slider.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Current`: Model-owned value.
// - `Change`: Maps a native proposal.
// - `Settings`: Native options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Current: A.Value; Change: function(A.Event): TMsg; Settings: A.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Role: string := 'step-slider';
  const Token: string := C.Token(Role, Id);
  const Tool: Wells.Tool? := Settings.Tool;
  const Parts: array of string := ['track', 'tool'];
  const Focus: int := W.Focus of TMsg(
    Frame,
    Id,
    Role,
    Parts,
    [Enabled, Enabled and Tool <> null],
    0
  );
  var Next: int := Current.Current;
  const Flags: int := Enc.Bits(Enabled, 1) + Enc.ToolBits(Tool) + Enc.Bits(Settings.Plain, 8);
  const Result: int := Frame.Window.StepSlider(
    Token,
    Current.Label,
    ref Next,
    Current.Minimum,
    Current.Maximum,
    Settings.Labels,
    Settings.Prefix,
    Settings.Suffix,
    Settings.Display,
    Enc.Icon(Tool),
    Enc.Tooltip(Tool),
    Flags,
    Focus,
    W.Tracker of TMsg(Frame, Id, Role, Parts)
  );
  if Result <> 0 then
    Frame.Messages.Add(Change(new A.Event(Next, (Result and 1) <> 0, (Result and 2) <> 0)));
  end if;

  W.Root of TMsg(Frame, Id, Role, Current.Label, false, Next.ToString());
  W.Part of TMsg(Frame, Id, Role, 'track', Current.Label, Enabled, Next.ToString());
  if Tool <> null then
    W.Part of TMsg(Frame, Id, Role, 'tool', Tool.Tooltip, Enabled, '');
  end if;
end procedure;

end unit;
