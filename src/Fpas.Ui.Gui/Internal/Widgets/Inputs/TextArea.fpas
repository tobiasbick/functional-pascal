// [Documentation](../../../../../docs/ui/gui/inputs/text-area.md)

unit Fpas.Ui.Gui.Internal.Widgets.Inputs.TextArea;

uses Fpas.Ui.Gui.Cui.Widgets.Inputs as CuiInputs;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Input.Editor as Editor;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Inputs.TextAreas as F;

uses System as Sys;

// Draws CUI's native text area with the model's current value.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable editor identity.
// - `Value`: Model-owned text.
// - `OnChange`: Maps a native edit to a message.
// - `Settings`: Presentation, capacity and input options.
// - `OnSubmit`: Optional Ctrl+Enter action.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Value: string;
  OnChange: function(string): TMsg;
  Settings: F.Options;
  OnSubmit: Sys.Func of (string, TMsg)?
);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('text-area', Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width ?? L.Extent.Content);
  const Native: CuiInputs.CuiEditorOptions := new CuiInputs.CuiEditorOptions(
    Settings.Label,
    Settings.Placeholder,
    Settings.Icon,
    Settings.Hint,
    Settings.Error,
    Settings.Prefix,
    Settings.Suffix,
    cast Settings.ControlSize as int,
    Settings.ReadOnly,
    Settings.MaxUtf8Bytes, Width.Kind, Width.Value, Settings.Autofocus
  );
  const Result: CuiInputs.CuiTextFieldResult := Frame.Window.TextArea(
    Token,
    Value,
    Native,
    Settings.Height,
    Settings.Clearable,
    Enabled,
    C.WantsFocus of TMsg(Frame, Id, Token, Enabled),
    not Frame.PaintingClosed,
    C.Token('button', F.ClearId(Id))
  );
  Editor.Publish of TMsg(
    Frame, Id, 'text-area', Value, Result, OnChange, OnSubmit, Enabled,
    Settings.Label, Settings.Hint, Settings.Error, Settings.Prefix, Settings.Suffix
  );
end procedure;

end unit;
