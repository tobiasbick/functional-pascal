// [Documentation](../../../../../docs/ui/gui/inputs/text-field.md)

unit Fpas.Ui.Gui.Internal.Widgets.Inputs.TextField;

uses Fpas.Ui.Gui.Cui.Widgets.Inputs as CuiInputs;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Input.Editor as Editor;
uses Fpas.Ui.Widgets.Inputs.TextFields as F;

uses System as Sys;

// Draws a native editor and delivers its edit before its optional submission.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable field identity.
// - `Value`: Model-owned text.
// - `OnChange`: Maps a native edit to a message.
// - `Settings`: Presentation, capacity and input options.
// - `OnSubmit`: Optional Enter action.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Value: string;
  OnChange: function(string): TMsg;
  Settings: F.Options;
  OnSubmit: Sys.Func of (string, TMsg)?
);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('text-field', Id);
  const Clear: string := F.ClearId(Id);
  const Reveal: string := F.RevealId(Id);
  const Native: CuiInputs.CuiTextFieldOptions := new CuiInputs.CuiTextFieldOptions(
    Settings.Label, Settings.Placeholder, Settings.Icon, Settings.Hint, Settings.Error,
    Settings.Prefix, Settings.Suffix, cast Settings.ControlSize as int, Settings.Password,
    Settings.Clearable, Settings.ReadOnly, Settings.MaxUtf8Bytes
  );
  const Result: CuiInputs.CuiTextFieldResult := Frame.Window.TextField(
    Token, Value, Native, Enabled, C.WantsFocus of TMsg(Frame, Id, Token, Enabled),
    not Frame.PaintingClosed, C.Token('button', Clear), C.Token('button', Reveal)
  );
  Editor.Publish of TMsg(
    Frame,
    Id,
    'text-field',
    Value,
    Result,
    OnChange,
    OnSubmit,
    Enabled,
    Settings.Label,
    Settings.Hint,
    Settings.Error,
    Settings.Prefix,
    Settings.Suffix,
    Settings.Password
  );
end procedure;

end unit;
