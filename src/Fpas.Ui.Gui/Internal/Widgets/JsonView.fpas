unit Fpas.Ui.Gui.Internal.Widgets.JsonView;

uses
  Fpas.Ui.JsonViews as W, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui;

// Presents the native CUI widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Json`: Literal JSON or parse-error example.
// - `Settings`: Native presentation options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Json: string; Settings: W.Options);
begin
  const Valid: bool := Frame.Window.JsonView(
    C.Token('json-view', Id), Json, Settings.ExpandDepth,
    Settings.MaxHeight, Frame.AcceptInput
  );
  C.Track<TMsg>(
    Frame, new App.Control(
      Id, '', 'json-view', new Cui.CuiRectangle(),
      Frame.AcceptInput, Value := Valid.ToString()
    )
  );
end procedure;

end unit;
