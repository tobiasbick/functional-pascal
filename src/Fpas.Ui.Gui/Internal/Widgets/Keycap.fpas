unit Fpas.Ui.Gui.Internal.Widgets.Keycap;

uses
  Fpas.Ui.Gui.Internal.Context as C;

// Draws the native CUI keycap.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Keys`: Space-separated key labels, for example Ctrl Shift P.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Keys: string);
begin
  Frame.Window.DisplayKeycap(Keys);
  Frame.Labels.Add(Keys);
end procedure;

end unit;
