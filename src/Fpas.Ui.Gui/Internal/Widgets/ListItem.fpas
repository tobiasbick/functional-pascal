unit Fpas.Ui.Gui.Internal.Widgets.ListItem;

uses
  Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.ListItems as I, System as Sys;

// Presents the native ListItem element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable row identity.
// - `Title`: Literal primary text.
// - `Activate`: Optional native activation mapper.
// - `Settings`: Appearance and input settings.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Title: string; Activate: Sys.Func<TMsg>?; Settings: I.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('list-item', Id);
  if Frame.Window.ListItem(
    Token,
    Title,
    Settings.Subtitle,
    Settings.Trailing,
    Settings.Avatar,
    Settings.Icon,
    Settings.Selected,
    Enabled,
    C.WantsFocus<TMsg>(Frame, Id, Token, Enabled)
  ) and Enabled
  then
    case Activate of
      when is Sys.Func<TMsg> as Notify:
        Frame.Messages.Add(Notify.Invoke());
      else
    end case;
  end if;

  C.Track<TMsg>(Frame, new App.Control(Id, Title, 'list-item', new Cui.CuiRectangle(), Enabled));
end procedure;

end unit;
