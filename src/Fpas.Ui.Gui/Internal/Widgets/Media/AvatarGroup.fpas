// [Documentation](../../../../../docs/ui/gui/feedback/avatar-group.md)

unit Fpas.Ui.Gui.Internal.Widgets.Media.AvatarGroup;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Media.AvatarGroups as A;

// Draws native overlapping avatars and the overflow count.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable group identity.
// - `Names`: Names in display order.
// - `Settings`: Avatar diameter and visible limit.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Names: array of string;
  Settings: A.Options
);
begin
  Frame.Window.AvatarGroup(Names, Settings.MaximumVisible, Settings.Size);
  C.Track of TMsg(Frame, new App.Control(Id, '', 'avatar-group', new Cui.CuiRectangle(), false));
end procedure;

end unit;
