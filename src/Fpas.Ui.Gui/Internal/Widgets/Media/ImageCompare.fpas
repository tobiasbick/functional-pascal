// [Documentation](../../../../../docs/ui/gui/social-and-media/image-compare.md)

unit Fpas.Ui.Gui.Internal.Widgets.Media.ImageCompare;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Data.MediaData as Data;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Media.ImageComparisons as ImageComparisons;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;

// Presents CUI's native ImageCompare widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Before`: First image.
// - `After`: Second image.
// - `Position`: Current divider position.
// - `Changed`: Maps a native change to a message.
// - `Settings`: Native widget options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Before: Media.Source; After: Media.Source; Position: float; Changed: function(float): TMsg; Settings: ImageComparisons.Options);
begin
  const Role: string := 'image-compare';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  var Next: float := Position;
  const Proposed: bool := Frame.Window.ImageCompare(
    Token,
    Data.Convert(Before),
    Data.Convert(After),
    ref Next,
    Width.Kind,
    Width.Value,
    Settings.Height,
    Settings.Aspect,
    Settings.BeforeLabel,
    Settings.AfterLabel,
    Enabled,
    Focus
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, Position.ToString());
  if Enabled and Proposed then
    Frame.Messages.Add(Changed(Next));
  end if;
end procedure;

end unit;
