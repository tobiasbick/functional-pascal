unit Fpas.Ui.Gui.Internal.Widgets.Media.ImageCompare;

uses Fpas.Ui.Widgets.Media.ImageComparisons as ImageComparisons, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Data.CreativeParts as P, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Widgets.Media.MediaImages as Media, Fpas.Ui.Gui.Internal.Data.MediaData as Data;

// Presents CUI's native ImageCompare widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Before`: First image.
// - `After`: Second image.
// - `Position`: Current divider position.
// - `Changed`: Maps a native change to a message.
// - `Settings`: Native widget options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Before: Media.Source; After: Media.Source; Position: float; Changed: function(float): TMsg; Settings: ImageComparisons.Options);
begin
  const Role: string := 'image-compare';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Focus: bool := C.WantsFocus<TMsg>(Frame, Id, Token, Enabled);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  var Next: float := Position;
  const Proposed: bool := Frame.Window.ImageCompare(
    Token,
    Data.Convert(Before),
    Data.Convert(After),
    ref Next,
    Width.Kind,
    Width.Value,
    Settings.Height,
    Settings.Aspect,
    Settings.BeforeLabel,
    Settings.AfterLabel,
    Enabled,
    Focus
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, Position.ToString());
  if Enabled and Proposed then
    Frame.Messages.Add(Changed(Next));
  end if;
end procedure;

end unit;
