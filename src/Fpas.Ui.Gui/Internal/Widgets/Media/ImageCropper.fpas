// [Documentation](../../../../../docs/ui/gui/social-and-media/image-cropper.md)

unit Fpas.Ui.Gui.Internal.Widgets.Media.ImageCropper;

uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.MediaData as Data;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Media.ImageCroppers as ImageCroppers;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;

// Presents CUI's native ImageCropper widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Image`: Image to display.
// - `Crop`: Current crop bounds.
// - `Changed`: Maps a native change to a message.
// - `Settings`: Native widget options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Image: Media.Source;
  Crop: ImageCroppers.Value;
  Changed: function(ImageCroppers.Value): TMsg;
  Settings: ImageCroppers.Options
);
begin
  const Role: string := 'image-cropper';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Focus: bool := C.WantsFocus of TMsg(Frame, Id, Token, Enabled);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Height: S.NativeExtent := S.Extent(Settings.Height);
  var Next: Cui.CuiRectangle := new Cui.CuiRectangle();
  Next.X := Crop.X;
  Next.Y := Crop.Y;
  Next.Width := Crop.Width;
  Next.Height := Crop.Height;
  const Proposed: bool := Frame.Window.ImageCropper(
    Token,
    Data.Convert(Image),
    ref Next,
    Width.Kind,
    Width.Value,
    Height.Kind,
    Height.Value,
    Settings.Aspect,
    Settings.MinimumSize,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.Round, 2),
    Focus
  );
  P.Root of TMsg(Frame, Id, Role, '', Enabled, Crop.Width.ToString());
  if Enabled and Proposed then
    Frame.Messages.Add(Changed(new ImageCroppers.Value(Next.X, Next.Y, Next.Width, Next.Height)));
  end if;
end procedure;

end unit;
