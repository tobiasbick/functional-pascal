// [Documentation](../../../../../docs/ui/gui/social-and-media/image-viewer.md)

unit Fpas.Ui.Gui.Internal.Widgets.Media.ImageViewer;

uses Fpas.Ui.Gui.Cui.Widgets.Media as CuiMedia;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Core.Parts as P;
uses Fpas.Ui.Gui.Internal.Core.Values as Enc;
uses Fpas.Ui.Gui.Internal.Data.MediaData as Data;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Media.ImageViewers as ImageViewers;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;

// Presents CUI's native ImageViewer widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Image`: Image to display.
// - `ViewValue`: Current zoom and center.
// - `Changed`: Maps a native change to a message.
// - `Settings`: Native widget options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Image: Media.Source; ViewValue: ImageViewers.Value; Changed: function(ImageViewers.Value): TMsg; Settings: ImageViewers.Options);
begin
  const Role: string := 'image-viewer';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Focus: bool := C.WantsFocus<TMsg>(Frame, Id, Token, Enabled);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Height: S.NativeExtent := S.Extent(Settings.Height);
  var Next: CuiMedia.CuiImageView := new CuiMedia.CuiImageView(
    ViewValue.Zoom,
    ViewValue.CenterX,
    ViewValue.CenterY
  );
  const Proposed: bool := Frame.Window.ImageViewer(
    Token,
    Data.Convert(Image),
    ref Next,
    Width.Kind,
    Width.Value,
    Height.Kind,
    Height.Value,
    Settings.MaximumZoom,
    Enc.Bits(Enabled, 1) or Enc.Bits(Settings.HideToolbar, 2) or Enc.Bits(Settings.Checkerboard, 4),
    Focus
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, ViewValue.Zoom.ToString());
  if Enabled and Proposed then
    Frame.Messages.Add(Changed(new ImageViewers.Value(Next.Zoom, Next.CenterX, Next.CenterY)));
  end if;
end procedure;

end unit;
