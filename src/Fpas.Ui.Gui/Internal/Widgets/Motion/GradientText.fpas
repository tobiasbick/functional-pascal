// [Documentation](../../../../../docs/ui/gui/motion/gradient-text.md)

unit Fpas.Ui.Gui.Internal.Widgets.Motion.GradientText;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Cui.Widgets.Motion as CuiMotion;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Colors;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Widgets.Motion.GradientTexts as W;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Text`: Display text.
// - `Settings`: Native appearance and input options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Text: string; Settings: W.Options);
begin
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  Frame.Window.GradientText(
    C.Token('gradient-text', Id), Text,
    new CuiMotion.CuiMotionText(
      cast Settings.Font as int,
      Width.Kind,
      Width.Value,
      Colors.Color(Settings.From),
      Settings.Size
    ),
    Colors.Color(Settings.To), Settings.Animate
  );
  C.Track of TMsg(Frame, new App.Control(Id, Text, 'gradient-text', new Cui.CuiRectangle(), false));
end procedure;

end unit;
