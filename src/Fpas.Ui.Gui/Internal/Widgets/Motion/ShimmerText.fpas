// [Documentation](../../../../../docs/ui/gui/motion/shimmer-text.md)

unit Fpas.Ui.Gui.Internal.Widgets.Motion.ShimmerText;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Data.MotionData as Common;
uses Fpas.Ui.Widgets.Motion.Motion as Motion;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Text`: Display text.
// - `Settings`: Native appearance and input options.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Text: string; Settings: Motion.TextOptions);
begin
  const Token: string := C.Token('shimmer-text', Id);
  Frame.Window.ShimmerText(Token, Text, Common.Options(Settings));
  C.Track of TMsg(Frame, new App.Control(Id, Text, 'shimmer-text', new Cui.CuiRectangle(), false));
end procedure;

end unit;
