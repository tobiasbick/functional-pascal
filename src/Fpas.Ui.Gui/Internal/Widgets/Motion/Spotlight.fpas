unit Fpas.Ui.Gui.Internal.Widgets.Motion.Spotlight;

uses
  Fpas.Ui.Widgets.Motion.Spotlights as W, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Internal.Data.ChartData as Colors, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Children`: Card content.
// - `Settings`: Native appearance and input options.
// - `Visit`: GUI traversal for card content.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Children: array of E.Element<TMsg>; Settings: W.Options; Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment));
begin
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Height: S.NativeExtent := S.Extent(Settings.Height);
  Frame.Window.BeginSpotlight(
    C.Token('spotlight', Id), Width.Kind, Width.Value, Height.Kind, Height.Value,
    Settings.Padding, Settings.Gap, Colors.Color(Settings.Color), Settings.Beam
  );
  for Child: E.Element<TMsg> in Children do
    Visit(Child, Frame, false, L.Alignment.Default);
  end for;

  Frame.Window.EndSpotlight();
  C.Track<TMsg>(Frame, new App.Control(Id, '', 'spotlight', new Cui.CuiRectangle(), false));
end procedure;

end unit;
