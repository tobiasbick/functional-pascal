// [Documentation](../../../../../docs/ui/gui/motion/spotlight-card.md)

unit Fpas.Ui.Gui.Internal.Widgets.Motion.Spotlight;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Data.ChartData as Colors;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as S;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Motion.Spotlights as W;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Children`: Card content.
// - `Settings`: Native appearance and input options.
// - `Visit`: GUI traversal for card content.
public procedure Draw of TMsg(Frame: C.State of TMsg; Id: string; Children: array of E.Element of TMsg; Settings: W.Options; Visit: procedure(E.Element of TMsg, C.State of TMsg, bool, L.Alignment));
begin
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Height: S.NativeExtent := S.Extent(Settings.Height);
  Frame.Window.BeginSpotlight(
    C.Token('spotlight', Id), Width.Kind, Width.Value, Height.Kind, Height.Value,
    Settings.Padding, Settings.Gap, Colors.Color(Settings.Color), Settings.Beam
  );
  for Child: E.Element of TMsg in Children do
    Visit(Child, Frame, false, L.Alignment.Default);
  end for;

  Frame.Window.EndSpotlight();
  C.Track of TMsg(Frame, new App.Control(Id, '', 'spotlight', new Cui.CuiRectangle(), false));
end procedure;

end unit;
