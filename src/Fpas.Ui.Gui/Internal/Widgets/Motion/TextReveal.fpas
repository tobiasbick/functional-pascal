unit Fpas.Ui.Gui.Internal.Widgets.Motion.TextReveal;

uses
  Fpas.Ui.Widgets.Motion.TextReveals as W, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Data.MotionData as Common, Fpas.Ui.Widgets.Motion.Motion as Motion;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Text`: Display text.
// - `Replay`: Animation revision.
// - `Settings`: Native appearance and input options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Text: string; Replay: int; Settings: Motion.TextOptions);
begin
  const Token: string := C.Token('text-reveal', Id);
  Frame.Window.TextReveal(Token, Text, Replay, Common.Options(Settings));
  C.Track<TMsg>(Frame, new App.Control(Id, Text, 'text-reveal', new Cui.CuiRectangle(), false));
end procedure;

end unit;
