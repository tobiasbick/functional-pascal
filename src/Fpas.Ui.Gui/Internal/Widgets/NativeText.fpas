unit Fpas.Ui.Gui.Internal.Widgets.NativeText;

uses
  Fpas.Ui.Texts as D, Fpas.Ui.Gui.Internal.Context as C;

// Draws the native CUI text.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Text`: Literal text.
// - `Role`: Native text role.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Text: string; Role: D.Appearance);
begin
  Frame.Window.DisplayText(Text, cast<int>(Role));
  Frame.Labels.Add(Text);
end procedure;

end unit;
