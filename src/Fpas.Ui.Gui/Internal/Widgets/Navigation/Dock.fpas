unit Fpas.Ui.Gui.Internal.Widgets.Navigation.Dock;

uses
  Fpas.Ui.Widgets.Navigation.Docks as W, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui.Widgets.Charts as CuiCharts,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Layout.Sizing as S, Fpas.Ui.Gui.Internal.Data.ChartData as Colors, System.Collections.Generic as Lists, System as Sys, Fpas.Ui.Widgets.Charts.Charts as Chart;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Entries`: Native dock entries.
// - `Settings`: Native appearance and input options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Entries: array of W.Entry<TMsg>; Settings: W.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('dock', Id);
  const Icons: Lists.List<string> := new Lists.List<string>(Entries.Length);
  const Labels: Lists.List<string> := new Lists.List<string>(Entries.Length);
  const Tones: array of CuiCharts.CuiChartColor := new CuiCharts.CuiChartColor[Entries.Length];
  const Badges: array of int := new int[Entries.Length];
  const Kinds: array of int := new int[Entries.Length];
  var Focus: int := -1;
  for Index: int := 0 to Entries.Length - 1 do
    case Entries[Index] of
      when W.Entry.Separator:
        Icons.Add('');
        Labels.Add('');
      when W.Entry.Item(
        const Icon: string, const Label: string, _, const Color: Chart.Color,
        const Running: bool, const Badge: int
      ):
        Icons.Add(Icon);
        Labels.Add(Label);
        Tones[Index] := Colors.Color(Color);
        Badges[Index] := Badge;
        Kinds[Index] := if Running then
          2
        else
          1
        end if;
        const Part: string := Id + '/' + Index.ToString();
        if C.WantsFocus<TMsg>(Frame, Part, C.Token('dock-item', Part), Enabled) then
          Focus := Index;
        end if;
    end case;
  end for;
  const Track: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Index: int): string => C.Token('dock-item', Id + '/' + Index.ToString())
  end if;
  const Chosen: int := Frame.Window.Dock(
    Token, Icons.ToArray(), Labels.ToArray(), Tones, Badges, Kinds,
    Settings.Size, Settings.Magnify, Enabled, Focus, Track
  );
  if Enabled and Chosen >= 0 then
    case Entries[Chosen] of
      when W.Entry.Item(_, _, const Activate: TMsg, _, _, _):
        Frame.Messages.Add(Activate);
      else
    end case;
  end if;

  C.Track<TMsg>(Frame, new App.Control(Id, '', 'dock', new Cui.CuiRectangle(), false));
  if not Frame.PaintingClosed then
    for Index: int := 0 to Entries.Length - 1 do
      if Kinds[Index] > 0 then
        Frame.Controls.Add(
          new App.Control(
            Id + '/' + Index.ToString(),
            Labels[Index],
            'dock-item',
            new Cui.CuiRectangle(),
            Enabled
          )
        );
      end if;
    end for;
  end if;
end procedure;

end unit;
