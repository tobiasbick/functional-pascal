// [Documentation](../../../../../docs/ui/gui/navigation/sidebar.md)

unit Fpas.Ui.Gui.Internal.Widgets.Navigation.Sidebar;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Navigation.Navigation as N;

// Draws a controlled sidebar through native CUI navigation controls.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Frame context.
// - `Id`: Sidebar identity.
// - `Sections`: Headings and destinations in focus order.
// - `Active`: Model-owned active key.
// - `Enabled`: Input permission for the sidebar.
public procedure Draw of TMsg(State: C.State of TMsg; Id: string; Sections: array of N.Section of TMsg; Active: string?; Enabled: bool);
begin
  const Group: string := C.Token('sidebar', Id);
  State.Window.BeginSidebar(Group, Active <> null);
  for Section: N.Section of TMsg in Sections do
    if Section.GapBefore > 0 then
      State.Window.Gap(cast Section.GapBefore as float);
    end if;

    if Section.Title <> '' then
      State.Window.SidebarHeading(Section.Title);
      State.Labels.Add(Section.Title);
    end if;

    for Item: N.Item of TMsg in Section.Items do
      const Allowed: bool := Enabled and Item.Enabled and State.AcceptInput;
      const Selected: bool := Active = Item.Key;
      const Token: string := C.Token('navigation', Id, Item.Key);
      const Focus: bool := C.WantsFocus of TMsg(State, N.ItemId(Id, Item.Key), Token, Allowed);
      if State.Window.SidebarItem(
        Group,
        Token,
        Item.Label,
        Item.Icon,
        Item.Badge,
        Allowed,
        Selected,
        Focus
      ) and Allowed
      then
        State.Messages.Add(Item.Message);
      end if;

      C.Track of TMsg(
        State, new App.Control(
          Id, Item.Label, 'navigation', new Cui.CuiRectangle(), Allowed,
          Key := Item.Key, Value := Selected.ToString()
        )
      );
    end for;
  end for;

  State.Window.EndGroup();
end procedure;

end unit;
