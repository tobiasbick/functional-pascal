unit Fpas.Ui.Gui.Internal.Widgets.NodeEditor;

uses
  Fpas.Ui.NodeEditors as D, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.SelectionRings as Ring, Fpas.Ui.Gui.Internal.Widgets.SelectionRing as NativeRing, Fpas.Ui.Gui.Internal.Sizing as Size, Fpas.Ui.Gui.Internal.CanvasData as Data;

// Presents CUI's native NodeEditor widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Viewport`: Current pan and zoom.
// - `Nodes`: Nodes and their bodies.
// - `Links`: Current links.
// - `Changed`: Maps native proposals to messages.
// - `Settings`: Native widget settings.
// - `Visit`: Presents embedded content.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Viewport: D.View; Nodes: array of D.Node<TMsg>; Links: array of D.Link; Changed: function(D.Event): TMsg; Settings: D.Options; Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment));
begin
  const Role: string := 'node-editor';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Height: Size.NativeExtent := Size.Extent(Settings.Height);
  if not Frame.Window.BeginNodeEditor(
    Token,
    Data.View(Viewport),
    Width.Kind,
    Width.Value,
    Height.Kind,
    Height.Value,
    Settings.MinimumZoom,
    Settings.MaximumZoom,
    P.Bits(Enabled, 1) or P.Bits(Settings.HideGrid, 2) or P.Bits(Settings.Minimap, 4)
  )
  then
    return;
  end if;
  const BodyFrame: C.State<TMsg> := Frame with
    AcceptInput := Enabled;
  end with;
  for Item: D.Node<TMsg> in Nodes do
    var X: float := Item.X;
    var Y: float := Item.Y;
    Frame.Window.BeginNode(Item.Id, ref X, ref Y, Item.Title, Item.Width, Item.Icon);
    for Pin: D.Pin in Item.Pins do
      Frame.Window.NodePin(Pin.Id, Pin.Label, Pin.Output, Pin.Kind);
    end for;

    case Item.Body of
      when is E.Element<TMsg> as Content:
        Frame.Window.BeginNodeContent();
        Visit(Content, BodyFrame, false, L.Alignment.Default);
        Frame.Window.EndNodeContent();
      else
    end case;

    Frame.Window.EndNode();
    case Item.Ring of
      when is Ring.Options as Decoration:
        NativeRing.Apply(Frame.Window, Decoration);
      else
    end case;

    if Enabled and (X <> Item.X or Y <> Item.Y) then
      Frame.Messages.Add(Changed(D.Event.Move(Item.Id, X, Y)));
    end if;
  end for;

  for Link: D.Link in Links do
    Frame.Window.NodeLink(Link.Id, Link.FromPin, Link.ToPin);
  end for;
  const Next: Cui.CuiNodeView := Frame.Window.EndNodeEditor();
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, Next.Zoom.ToString());
  if Enabled then
    if Next.X <> Viewport.X or Next.Y <> Viewport.Y or Next.Zoom <> Viewport.Zoom then
      Frame.Messages.Add(Changed(D.Event.Pan(new D.View(Next.X, Next.Y, Next.Zoom))));
    end if;
    var First: int := 0;
    var Second: int := 0;
    while Frame.Window.NodeEvent(0, out First, out Second) do
      Frame.Messages.Add(Changed(D.Event.Connect(First, Second)));
    end while;

    while Frame.Window.NodeEvent(1, out First, out Second) do
      Frame.Messages.Add(Changed(D.Event.Unlink(First)));
    end while;

    while Frame.Window.NodeEvent(2, out First, out Second) do
      Frame.Messages.Add(Changed(D.Event.Delete(First)));
    end while;
  end if;
end procedure;

end unit;
