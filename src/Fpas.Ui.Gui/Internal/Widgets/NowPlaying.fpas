unit Fpas.Ui.Gui.Internal.Widgets.NowPlaying;

uses
  Fpas.Ui.NowPlaying as W, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Sizing as S, Fpas.Ui.Gui.Internal.ChartData as Colors, System as Sys;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Current`: Playback model.
// - `Change`: Maps a native proposal.
// - `Settings`: Native appearance and input options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Current: W.Value; Change: function(W.Event): TMsg; Settings: W.Options);
begin
  const Token: string := C.Token('now-playing', Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Parts: array of string := ['toggle', 'previous', 'next', 'seek'];
  var Focus: int := -1;
  for Index: int := 0 to 2 do
    const Part: string := Id + '/' + Parts[Index];
    if C.WantsFocus<TMsg>(Frame, Part, C.Token('player-part', Part), Enabled)
      or (Index = 0 and C.WantsFocus<TMsg>(Frame, Id, C.Token('player-part', Part), Enabled))
    then
      Focus := Index;
    end if;
  end for;
  const Track: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Index: int): string => C.Token('player-part', Id + '/' + Parts[Index])
  end if;
  var Position: float := Current.Position;
  var Playing: int := if Current.Playing then
    1
  else
    0
  end if;
  const Flags: int := (if Settings.Compact then
    1
  else
    0
  end if) + (if Enabled then
    2
  else
    0
  end if);
  const Result: Cui.CuiPlayerResult := Frame.Window.NowPlaying(
    Token, Current.Title, Current.Artist,
    Current.Artwork, Colors.Color(Current.ArtColor), ref Position, Current.Duration, ref Playing,
    Width.Kind, Width.Value, Flags, Focus, Track
  );
  const Mask: int := Result.Events;
  if Enabled and Mask <> 0 then
    Frame.Messages.Add(
      Change(
        new W.Event(
          Current with
            Position := Position;
            Playing := Playing <> 0;
          end with,
          (Mask and 1) <> 0, (Mask and 2) <> 0, (Mask and 4) <> 0, (Mask and 8) <> 0
        )
      )
    );
  end if;

  C.Track<TMsg>(
    Frame, new App.Control(
      Id, Current.Title, 'now-playing', new Cui.CuiRectangle(), false,
      Value := Position.ToString(Sys.Globalization.CultureInfo.InvariantCulture)
    )
  );
  if not Frame.PaintingClosed then
    for Index: int := 0 to 3 do
      if Result.Parts[Index] then
        Frame.Controls.Add(
          new App.Control(
            Id + '/' + Parts[Index], Parts[Index], 'player-part', new Cui.CuiRectangle(),
            Enabled, Value := (Playing <> 0).ToString()
          )
        );
      end if;
    end for;
  end if;
end procedure;

end unit;
