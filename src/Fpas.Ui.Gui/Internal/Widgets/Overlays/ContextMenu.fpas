// [Documentation](../../../../../docs/ui/gui/overlays/context-menu.md)

unit Fpas.Ui.Gui.Internal.Widgets.Overlays.ContextMenu;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Widgets.Overlays.Menu as Menu;
uses Fpas.Ui.Widgets.Overlays.Menus as M;

// Attaches CUI's context menu to the target just drawn by the presenter.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current frame, input permission and message queue.
// - `Id`: Menu identity independent of its target.
// - `Entries`: Shared keyed commands and decorations.
// - `Enabled`: Whether the context menu accepts input.
public procedure Draw of TMsg(
  State: C.State of TMsg;
  Id: string;
  Entries: array of M.Entry of TMsg;
  Enabled: bool
);
begin
  if not State.Window.HasLastWidget then
    return;
  end if;

  Menu.Draw of TMsg(State, Id, 'Context menu', Entries, null, Enabled);
end procedure;

end unit;
