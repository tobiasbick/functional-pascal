// [Documentation](../../../../../docs/ui/gui/actions/dropdown-menu.md)

unit Fpas.Ui.Gui.Internal.Widgets.Overlays.DropdownMenu;

uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Widgets.Overlays.Menu as Menu;
uses Fpas.Ui.Widgets.Overlays.Menus as M;

// Draws a native dropdown through the shared menu binding.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current frame, input permission and message queue.
// - `Id`: Trigger identity.
// - `Label`: Trigger caption and tooltip.
// - `Entries`: Shared keyed commands and decorations.
// - `Settings`: Trigger and popup options.
public procedure Draw of TMsg(
  State: C.State of TMsg;
  Id: string;
  Label: string;
  Entries: array of M.Entry of TMsg;
  Settings: M.Options
);
begin
  Menu.Draw of TMsg(State, Id, Label, Entries, Settings, Settings.Enabled);
end procedure;

end unit;
