unit Fpas.Ui.Gui.Internal.Widgets.Overlays.DropdownMenu;

uses Fpas.Ui.Widgets.Overlays.Menus as M, Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Widgets.Overlays.Menu as Menu;

// Draws a native dropdown through the shared menu binding.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Current frame, input permission and message queue.
// - `Id`: Trigger identity.
// - `Label`: Trigger caption and tooltip.
// - `Entries`: Shared keyed commands and decorations.
// - `Settings`: Trigger and popup options.
public procedure Draw<TMsg>(State: C.State<TMsg>; Id: string; Label: string; Entries: array of M.Entry<TMsg>; Settings: M.Options);
begin
  Menu.Draw<TMsg>(State, Id, Label, Entries, Settings, Settings.Enabled);
end procedure;

end unit;
