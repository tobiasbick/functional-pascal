unit Fpas.Ui.Gui.Internal.Widgets.Overlays.Sheet;

uses
  Fpas.Ui.Gui.Internal.Hosting.Context as C, Fpas.Ui.Gui.Internal.Input.Modal as Modal,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Overlays.Sheets as Sheets;

// Draws a controlled native sheet over its base view.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Current`: Frame context.
// - `Id`: Stable sheet identity.
// - `Base`: Underlying view.
// - `Content`: Scrollable sheet body.
// - `Open`: Model-owned visibility.
// - `Settings`: Header, edge, size and initial focus.
// - `Dismiss`: Proposed dismissal message.
// - `Horizontal`: Parent layout axis.
// - `Align`: Parent layout alignment.
// - `Visit`: Host traversal used to draw the two child views.
public procedure Draw<TMsg>(
  Current: C.State<TMsg>; Id: string; Base: E.Element<TMsg>; Content: E.Element<TMsg>;
  Open: bool; Settings: Sheets.Options; Dismiss: TMsg; Horizontal: bool; Align: L.Alignment;
  Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment)
);
  function BeginNative(Enabled: bool; FocusClose: bool; CloseToken: string): int;
  begin
    return Current.Window.BeginSheet(
      C.Token('sheet', Id), Settings.Title, Settings.Description, cast<int>(Settings.Edge),
      cast<float>(Settings.Size), Open, Enabled, FocusClose, CloseToken
    );
  end function;
  procedure EndNative();
  begin
    Current.Window.EndSheet();
  end procedure;
begin
  Modal.Draw<TMsg>(
    Current, Id, Base, Content, Open, Settings.Title, Settings.Description, Settings.InitialFocus,
    Sheets.CloseId(Id), Dismiss, Horizontal, Align, Visit, BeginNative, EndNative
  );
end procedure;

end unit;
