unit Fpas.Ui.Gui.Internal.Widgets.PasswordStrength;

uses Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui;

// Draws CUI's strength meter and records its score without retaining the password.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable meter identity.
// - `Password`: Current model password.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Password: string);
begin
  const Score: int := Frame.Window.PasswordStrength(C.Token('password-strength', Id), Password);
  const Labels: array of string := ['Too short', 'Weak', 'Fair', 'Good', 'Strong'];
  const Label: string := if Password = '' then
    ''
  else
    Labels[Score]
  end if;
  if not Frame.PaintingClosed and Label <> '' then
    Frame.Labels.Add(Label);
  end if;

  C.Track<TMsg>(
    Frame, new App.Control(
      Id, Label, 'password-strength', new Cui.CuiRectangle(), false, Value := Score.ToString()
    )
  );
end procedure;

end unit;
