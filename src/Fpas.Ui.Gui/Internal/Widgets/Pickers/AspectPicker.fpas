unit Fpas.Ui.Gui.Internal.Widgets.Pickers.AspectPicker;

uses
  Fpas.Ui.Widgets.Pickers.AspectPickers as A, Fpas.Ui.Gui.Internal.Hosting.Context as C,
  Fpas.Ui.Gui.Internal.Data.CreativeParts as W, System.Collections.Generic as Lists;

// Presents the native aspect ratio picker.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Current`: Model-owned value.
// - `Change`: Maps a native proposal.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Current: A.Value; Change: function(int): TMsg; Settings: A.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Role: string := 'aspect-picker';
  const Token: string := C.Token(Role, Id);
  const Count: int := Settings.Ratios.Length;
  const DefaultRatios: array of string := ['1:1', '4:5', '3:2', '16:9', '9:16', '21:9'];
  const Choices: int := if Count = 0 then
    DefaultRatios.Length
  else
    Count
  end if;
  const Total: int := Choices + W.Bits(Settings.Custom, 1);
  const Parts: array of string := W.Indexed(Total);
  const Widths: array of int := new int[Count];
  const Heights: array of int := new int[Count];
  const Captions: Lists.List<string> := new Lists.List<string>(Count);
  for Index: int := 0 to Count - 1 do
    Widths[Index] := Settings.Ratios[Index].Width;
    Heights[Index] := Settings.Ratios[Index].Height;
    Captions.Add(Settings.Ratios[Index].Label);
  end for;
  const Labels: array of string := Captions.ToArray();
  var Next: int := Current.Index;
  const Flags: int := W.Bits(Enabled, 1) + W.Bits(Settings.Custom, 2) + W.Bits(Settings.Plain, 8);
  const Result: int := Frame.Window.AspectPicker(
    Token, Current.Label, ref Next, Widths, Heights, Labels,
    Settings.CustomLabel, Settings.Base, Settings.Display, Flags,
    W.Focus<TMsg>(Frame, Id, Role, Parts, W.Inputs(Total, Enabled), Current.Index),
    W.Tracker<TMsg>(Frame, Id, Role, Parts)
  );
  if Result <> 0 then
    Frame.Messages.Add(Change(Next));
  end if;

  W.Root<TMsg>(Frame, Id, Role, Current.Label, false, Next.ToString());
  for Index: int := 0 to Total - 1 do
    const Caption: string := if Index = Choices then
      if Settings.CustomLabel = '' then
        'Custom'
      else
        Settings.CustomLabel
      end if
    elsif Count = 0 then
      DefaultRatios[Index]
    elsif Labels[Index] <> '' then
      Labels[Index]
    else
      Widths[Index].ToString() + ':' + Heights[Index].ToString()
    end if;
    W.Part<TMsg>(Frame, Id, Role, Parts[Index], Caption, Enabled, (Index = Next).ToString());
  end for;
end procedure;

end unit;
