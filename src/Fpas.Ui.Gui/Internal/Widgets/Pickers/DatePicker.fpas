unit Fpas.Ui.Gui.Internal.Widgets.Pickers.DatePicker;

uses
  Fpas.Ui.Widgets.Pickers.DatePickers as P, Fpas.Ui.Gui.Cui.Widgets.Pickers as CuiPickers, Fpas.Ui.Gui.Internal.Hosting.Context as C,
  Fpas.Ui.Gui.Internal.Widgets.Pickers.CalendarParts as Parts, System as Sys;

// Draws the native date field and its popup.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing state.
// - `Id`: Picker identity.
// - `Value`: Model-owned selection.
// - `OnChange`: Maps a selected date to a message.
// - `Settings`: Field presentation and input settings.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Value: Sys.DateOnly?; OnChange: function(Sys.DateOnly): TMsg;
  Settings: P.Options
);
begin
  const Accept: bool := Settings.Enabled and Frame.AcceptInput;
  const Role: string := 'date-picker';
  const Token: string := C.Token(Role, Id);
  const Track: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Part: int): string => Parts.Token(Id, Part)
  end if;
  const Result: CuiPickers.CuiCalendarResult := Frame.Window.DatePicker(
    Token, Value, Settings.Label, Settings.Placeholder, Settings.Width, Accept,
    C.WantsFocus<TMsg>(Frame, Id, Token, Accept), Track
  );
  if Settings.Label <> '' and not Frame.PaintingClosed then
    Frame.Labels.Add(Settings.Label);
  end if;
  const Label: string := if Settings.Label = '' then
    'Date'
  else
    Settings.Label
  end if;
  Parts.Publish<TMsg>(Frame, Id, Label, Role, Value, Accept, Result, OnChange);
end procedure;

end unit;
