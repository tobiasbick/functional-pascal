unit Fpas.Ui.Gui.Internal.Widgets.Pickers.PaletteStrip;

uses
  Fpas.Ui.Widgets.Pickers.PaletteStrips as A, Fpas.Ui.Gui.Internal.Hosting.Context as C,
  Fpas.Ui.Gui.Internal.Data.CreativeParts as W, Fpas.Ui.Graphics as G, System.Collections.Generic as Lists;

// Presents the native palette strip.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Current`: Model-owned value.
// - `Change`: Maps a native proposal.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Current: A.Value; Change: function(A.Event): TMsg; Settings: A.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Role: string := 'palette-strip';
  const Token: string := C.Token(Role, Id);
  const Count: int := Current.Swatches.Length;
  const Colors: array of uint := new uint[Count];
  const Locks: array of int := new int[Count];
  const Parts: array of string := W.Indexed(Count, 'shuffle');
  const Accept: array of bool := W.Inputs(Parts.Length, Enabled);
  Accept[Count] := Enabled and not Settings.NoShuffle;
  for Index: int := 0 to Count - 1 do
    Colors[Index] := W.Pack(Current.Swatches[Index].Color);
    Locks[Index] := W.Bits(Current.Swatches[Index].Locked, 1);
  end for;
  var Seed: uint := Current.Seed ?? 0U;
  const Flags: int := W.Bits(Enabled, 1) + W.Bits(
    Settings.NoShuffle,
    2
  ) + W.Bits(Settings.Plain, 8);
  const Result: int := Frame.Window.PaletteStrip(
    Token, Current.Label, Colors, Locks, ref Seed,
    Current.Seed <> null, Settings.Display, Settings.Height, Flags,
    W.Focus<TMsg>(Frame, Id, Role, Parts, Accept, 0), W.Tracker<TMsg>(Frame, Id, Role, Parts)
  );
  if Result <> 0 then
    const Swatches: Lists.List<A.Swatch> := new Lists.List<A.Swatch>(Count);
    for Index: int := 0 to Count - 1 do
      Swatches.Add(new A.Swatch(W.Unpack(Colors[Index]), Locks[Index] <> 0));
    end for;
    const Proposed: uint? := if Current.Seed <> null then
      Seed
    else
      null
    end if;
    Frame.Messages.Add(
      Change(new A.Event(Swatches.ToArray(), Proposed, (Result and 1) <> 0, (Result and 2) <> 0))
    );
  end if;

  W.Root<TMsg>(Frame, Id, Role, Current.Label, false, '');
  for Index: int := 0 to Count - 1 do
    const Color: G.Color := W.Unpack(Colors[Index]);
    const Caption: string := '#' + Color.Red.ToString(
      'X2'
    ) + Color.Green.ToString('X2') + Color.Blue.ToString('X2');
    W.Part<TMsg>(Frame, Id, Role, Parts[Index], Caption, Enabled, (Locks[Index] <> 0).ToString());
  end for;

  if not Settings.NoShuffle then
    W.Part<TMsg>(Frame, Id, Role, 'shuffle', 'Shuffle', Enabled, '');
  end if;
end procedure;

end unit;
