// [Documentation](../../../../../docs/ui/gui/pickers/wheel-picker.md)

unit Fpas.Ui.Gui.Internal.Widgets.Pickers.WheelPicker;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Layout.Sizing as Size;
uses Fpas.Ui.Widgets.Pickers.WheelPickers as W;

// Draws the native wheel and publishes selection proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable wheel identity.
// - `Items`: Captions in selection order.
// - `Selected`: Model-owned zero-based index.
// - `OnChange`: Maps a proposed index to a message.
// - `Settings`: Wheel presentation and input settings.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Items: array of string;
  Selected: int;
  OnChange: function(int): TMsg;
  Settings: W.Options
);
begin
  const Enabled: bool := Settings.Enabled and Frame.AcceptInput;
  const Role: string := 'wheel-picker';
  const Token: string := C.Token(Role, Id);
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Proposed: int := Frame.Window.WheelPicker(
    Token,
    Items,
    Selected,
    Width.Kind,
    Width.Value,
    Settings.Rows,
    Settings.Loop,
    Settings.JoinLeft,
    Settings.JoinRight,
    Enabled,
    C.WantsFocus of TMsg(Frame, Id, Token, Enabled),
    not Frame.PaintingClosed
  );
  if Proposed <> Selected then
    Frame.Messages.Add(OnChange(Proposed));
  end if;

  if not Frame.PaintingClosed then
    Frame.Controls.Add(
      new App.Control(
        Id, Items[Selected], Role, new Cui.CuiRectangle(), Enabled, Value := Selected.ToString()
      )
    );
  end if;
end procedure;

end unit;
