// [Documentation](../../../../../docs/ui/gui/feedback/timeline-item.md)

unit Fpas.Ui.Gui.Internal.Widgets.Planning.TimelineItem;

uses Fpas.Ui.Gui.Application as App;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Widgets.Planning.TimelineItems as T;

// Draws CUI's activity entry and exposes its literal text for inspection.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable item identity.
// - `Title`: Literal heading.
// - `Settings`: Native text, icon, tone and final-item options.
public procedure Draw of TMsg(
  Frame: C.State of TMsg;
  Id: string;
  Title: string;
  Settings: T.Options
);
begin
  Frame.Window.TimelineItem(
    C.Token('timeline-item', Id), Title, Settings.Time,
    Settings.Description, Settings.Icon, cast Settings.Tone as int, Settings.Last
  );
  if not Frame.PaintingClosed then
    Frame.Labels.Add(Title);
    if Settings.Time <> '' then
      Frame.Labels.Add(Settings.Time);
    end if;

    if Settings.Description <> '' then
      Frame.Labels.Add(Settings.Description);
    end if;
  end if;

  C.Track of TMsg(
    Frame,
    new App.Control(
      Id,
      Title,
      'timeline-item',
      new Cui.CuiRectangle(),
      false,
      Value := Settings.Time
    )
  );
end procedure;

end unit;
