unit Fpas.Ui.Gui.Internal.Widgets.RadioCards;

uses
  Fpas.Ui.RadioCards as R, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as C,
  System as Sys, System.Collections.Generic as Lists;

// Presents the native CUI card grid and tracks its positional focus targets.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current frame and message queue.
// - `Id`: Stable grid identity.
// - `Items`: Validated positional choices.
// - `Selected`: Model-owned index.
// - `OnChange`: Maps a proposed selection to a message.
// - `Settings`: Native columns and input permission.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Items: array of R.Item; Selected: int;
  OnChange: function(int): TMsg; Settings: R.Options
);
begin
  const Enabled: bool := Settings.Enabled and Frame.AcceptInput;
  const Choices: Lists.List<Cui.CuiRadioCard> := new Lists.List<Cui.CuiRadioCard>();
  const Tokens: Lists.List<string> := new Lists.List<string>();
  Tokens.Add(C.Token('radio-cards', Id));
  var Focus: int := 0;
  for Index: int := 0 to Items.Length - 1 do
    const Item: R.Item := Items[Index];
    Choices.Add(new Cui.CuiRadioCard(Item.Title, Item.Description, Item.Icon, Item.Badge));
    const Token: string := C.Token('radio-card', Id, Index.ToString());
    Tokens.Add(Token);
    if C.WantsFocus<TMsg>(Frame, R.ItemId(Id, Index), Token, Enabled)
      or C.WantsFocus<TMsg>(Frame, Id, Token, Enabled, Index = Sys.Math.Max(0, Selected))
    then
      Focus := Index + 1;
    end if;
  end for;
  const Proposal: int := Frame.Window.RadioCards(
    Tokens[0], Choices.ToArray(), Selected, Settings.Columns, Enabled, Focus,
    if Frame.PaintingClosed then
      null
    else
      Tokens.ToArray()
    end if
  );
  if Proposal >= 0 then
    Frame.Messages.Add(OnChange(Proposal));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(
      Id, 'Radio cards', 'radio-cards', new Cui.CuiRectangle(), false, Value := Selected.ToString()
    )
  );
  for Index: int := 0 to Items.Length - 1 do
    Frame.Controls.Add(
      new App.Control(
        Id, Items[Index].Title, 'radio-card', new Cui.CuiRectangle(), Enabled,
        Key := Index.ToString(), Value := if Index = Selected then
          'true'
        else
          'false'
        end if
      )
    );
  end for;
end procedure;
end unit;
