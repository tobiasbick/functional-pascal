unit Fpas.Ui.Gui.Internal.Widgets.Reasoning;

uses Fpas.Ui.Reasonings as Reasonings, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Presents CUI's native Reasoning.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Bodies`: Composed reasoning body.
// - `Settings`: Native options.
// - `Visit`: Draws composed children.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Bodies: array of E.Element<TMsg>; Settings: Reasonings.Options; Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment));
begin
  const Role: string := 'reasoning';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Header: string := C.Token(Role, Id + '/toggle');
  const Focus: bool := C.WantsFocus<TMsg>(
    Frame,
    Id + '/toggle',
    Header,
    Enabled
  ) or C.WantsFocus<TMsg>(Frame, Id, Header, Enabled);
  const Status: int := Frame.Window.BeginReasoning(
    Token, Settings.Thinking, Settings.Seconds, Settings.Title,
    P.Bits(Enabled, 1) or P.Bits(Focus, 2), if Frame.PaintingClosed then
      null
    else
      Header
    end if
  );
  const Open: bool := (Status and 2) <> 0;
  if (Status and 1) <> 0 then
    for Body: E.Element<TMsg> in Bodies do
      Visit(
        Body, Frame with
          AcceptInput := Enabled and Open;
          Interactive := Frame.Interactive and Settings.Enabled and Open;
          PaintingClosed := Frame.PaintingClosed or not Open;
        end with, false, L.Alignment.Default
      );
    end for;

    Frame.Window.EndReasoning();
  end if;

  P.Root<TMsg>(Frame, Id, Role, Settings.Title, false, Open.ToString());
  P.Part<TMsg>(Frame, Id, Role, 'toggle', Settings.Title, Enabled, Open.ToString());
end procedure;

end unit;
