unit Fpas.Ui.Gui.Internal.Widgets.ResponseActions;

uses Fpas.Ui.ResponseActions as ResponseActions, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.AiData as Data;

// Presents CUI's native ResponseActions.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Vote`: Current vote: minus one, zero or one. Null hides voting.
// - `Changed`: Maps a native action.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Vote: int?; Changed: function(ResponseActions.Event): TMsg; Settings: ResponseActions.Options);
begin
  const Role: string := 'response-actions';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Keys: array of string := ['copy', 'regenerate', 'up', 'down', 'share'];
  const Result: Cui.CuiResponseResult := Frame.Window.ResponseActions(
    Token, Settings.CopyText, Vote,
    P.Bits(Enabled, 1) or P.Bits(Settings.HideRegenerate, 2) or P.Bits(Settings.HideShare, 4),
    P.Tracker<TMsg>(Frame, Id, Role, Keys)
  );
  P.Root<TMsg>(Frame, Id, Role, '', false, (Vote ?? 0).ToString());
  Data.Parts<TMsg>(Frame, Id, Role, Keys, Result.Parts, Enabled);
  if (Result.Events and 1) <> 0 then
    Frame.Messages.Add(Changed(ResponseActions.Event.Copy));
  end if;

  if (Result.Events and 2) <> 0 then
    Frame.Messages.Add(Changed(ResponseActions.Event.Regenerate));
  end if;

  if (Result.Events and 12) <> 0 then
    const Proposed: int := if Vote <> null then
      Result.Vote
    elsif (Result.Events and 4) <> 0 then
      1
    else
      -1
    end if;
    Frame.Messages.Add(Changed(ResponseActions.Event.Vote(Proposed)));
  end if;

  if (Result.Events and 16) <> 0 then
    Frame.Messages.Add(Changed(ResponseActions.Event.Share));
  end if;
end procedure;

end unit;
