unit Fpas.Ui.Gui.Internal.Widgets.Sankey;

uses
  Fpas.Ui.Sankeys as W, Fpas.Ui.Charts as Charts, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.ChartData as Common, Fpas.Ui.Gui.Internal.MoreChartData as Data,
  Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.Sizing as Size, Fpas.Ui.Gui.Application as App, System as Sys;

// Presents CUI's native sankey.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable identity.
// - `Nodes`: Named nodes in input order.
// - `Links`: Directed nonnegative flows; zero flows are hidden.
// - `Settings`: Native presentation.
// - `OnActivate`: Optional native click callback.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Nodes: array of W.Node; Links: array of W.Link; Settings: W.Options; OnActivate: Sys.Func<W.Selection, TMsg>?);
begin
  const Token: string := C.Token('sankey', Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Options: Cui.CuiSankeyOptions := new Cui.CuiSankeyOptions(
    Width.Kind,
    Width.Value,
    Settings.Height,
    Settings.NodeWidth,
    Common.Format(Settings.Format)
  );
  const Clicked: int := Frame.Window.Sankey(
    Token,
    Data.Nodes(Nodes),
    Data.Links(Links),
    Options,
    Enabled,
    not Frame.PaintingClosed
  );
  if Enabled and Clicked >= 0 then
    case OnActivate of
      when is Sys.Func<W.Selection, TMsg> as Notify:
        Frame.Messages.Add(
          Notify.Invoke(
            if Clicked < Nodes.Length then
              W.Selection.Node(Clicked)
            else
              W.Selection.Link(Clicked - Nodes.Length)
            end if
          )
        );
      else
    end case;
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(new App.Control(Id, 'Sankey', 'sankey', new Cui.CuiRectangle(), Enabled));
end procedure;

end unit;
