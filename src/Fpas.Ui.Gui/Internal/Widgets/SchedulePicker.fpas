unit Fpas.Ui.Gui.Internal.Widgets.SchedulePicker;

uses Fpas.Ui.SchedulePickers as D, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Internal.Sizing as S, Fpas.Ui.Gui.Cui as Cui;

// Presents the native SchedulePicker widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Expression`: Expression supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Expression: string; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'schedule-picker';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: Cui.CuiScheduleProposal := Frame.Window.SchedulePicker(
    Token,
    Expression,
    Settings.Capacity,
    Settings.Now,
    Settings.Utc,
    Settings.NextCount,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, Result.Expression);
  if Enabled and (Result.Expression <> Expression) then
    Frame.Messages.Add(Changed(new D.Event(Result.Expression, Result.Valid, Result.Next)));
  end if;
end procedure;

end unit;
