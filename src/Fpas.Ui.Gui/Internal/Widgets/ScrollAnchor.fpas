unit Fpas.Ui.Gui.Internal.Widgets.ScrollAnchor;

uses Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui;

// Emits CUI's zero-height scroll destination.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable anchor identity.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string);
begin
  Frame.Window.ScrollAnchor(Id);
  C.Track<TMsg>(Frame, new App.Control(Id, '', 'scroll-anchor', new Cui.CuiRectangle(), false));
end procedure;

end unit;
