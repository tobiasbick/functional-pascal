unit Fpas.Ui.Gui.Internal.Widgets.ScrubField;

uses
  Fpas.Ui.ScrubFields as S, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Sizing as Size, System.Globalization as Culture;

// Draws CUI scrub and typing modes and publishes native value proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation context.
// - `Id`: Stable field identity.
// - `Label`: Literal caption.
// - `Value`: Model value.
// - `Minimum`: Inclusive lower bound.
// - `Maximum`: Inclusive upper bound.
// - `OnChange`: Maps a value proposal.
// - `Settings`: Native step, precision and presentation.

public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: S.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('scrub-field', Id);
  const Width: Size.NativeExtent := Size.Extent(Settings.Width);
  const Proposed: float := Frame.Window.ScrubField(
    Token, Label, Value, Minimum, Maximum, Settings.Step,
    Settings.DecimalPlaces, Settings.Suffix, Settings.Icon, Width.Kind, Width.Value,
    Enabled, C.WantsFocus<TMsg>(Frame, Id, Token, Enabled), not Frame.PaintingClosed
  );
  if Enabled and Proposed <> Value then
    Frame.Messages.Add(OnChange(Proposed));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Labels.Add(Label);
  Frame.Controls.Add(
    new App.Control(
      Id, Label, 'scrub-field', new Cui.CuiRectangle(), Enabled,
      Value := Proposed.ToString(Culture.CultureInfo.InvariantCulture)
    )
  );
end procedure;

end unit;
