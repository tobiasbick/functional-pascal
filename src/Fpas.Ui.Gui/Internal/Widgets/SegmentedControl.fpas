unit Fpas.Ui.Gui.Internal.Widgets.SegmentedControl;

uses
  Fpas.Ui.SegmentedControls as S, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as C, System.Collections.Generic as Lists;

// Passes controlled choices to native CUI and publishes group/segment snapshots.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current native frame and message queue.
// - `Id`: Group identity.
// - `Items`: Validated positional choices.
// - `Selected`: Model-owned index.
// - `OnChange`: Maps an actual change to a message.
// - `Settings`: Native size, width and permission.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Items: array of S.Item; Selected: int;
  OnChange: function(int): TMsg; Settings: S.Options
);
begin
  const Enabled: bool := Settings.Enabled and Frame.AcceptInput;
  const Labels: Lists.List<string> := new Lists.List<string>();
  const Icons: Lists.List<string> := new Lists.List<string>();
  const Tokens: Lists.List<string> := new Lists.List<string>();
  Tokens.Add(C.Token('segmented', Id));
  var Focus: int := 0;
  for Index: int := 0 to Items.Length - 1 do
    const Item: S.Item := Items[Index];
    Labels.Add(
      if Item.IconOnly then
        ''
      else
        Item.Label
      end if
    );
    Icons.Add(Item.Icon);
    const Token: string := C.Token('segment', Id, Index.ToString());
    Tokens.Add(Token);
    if C.WantsFocus<TMsg>(Frame, S.ItemId(Id, Index), Token, Enabled)
      or C.WantsFocus<TMsg>(Frame, Id, Token, Enabled, Index = Selected)
    then
      Focus := Index + 1;
    end if;
  end for;
  const Proposal: int := Frame.Window.Segmented(
    Tokens[0], Labels.ToArray(), Icons.ToArray(), Selected,
    cast<int>(Settings.ControlSize), Settings.FullWidth, Enabled, Focus,
    if Frame.PaintingClosed then
      null
    else
      Tokens.ToArray()
    end if
  );
  if Proposal >= 0 then
    Frame.Messages.Add(OnChange(Proposal));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(
      Id, 'Segmented control', 'segmented', new Cui.CuiRectangle(), false,
      Value := Selected.ToString()
    )
  );
  for Index: int := 0 to Items.Length - 1 do
    Frame.Controls.Add(
      new App.Control(
        Id, Items[Index].Label, 'segment', new Cui.CuiRectangle(), Enabled,
        Key := Index.ToString(), Value := if Index = Selected then
          'true'
        else
          'false'
        end if
      )
    );
  end for;
end procedure;
end unit;
