unit Fpas.Ui.Gui.Internal.Widgets.SelectionRing;

uses
  Fpas.Ui.SelectionRings as D, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Graphics as G;

// Adds the native decoration to the last completed component.
// ## Parameters
// - `Window`: Native drawing window.
// - `Settings`: Ring color, name and corners.
public procedure Apply(Window: Cui.CuiWindow; Settings: D.Options);
begin
  var Color: uint := 0U;
  case Settings.Color of
    when is G.Color as Value:
      Color := P.Pack(Value);
    else
  end case;

  Window.SelectionRing(cast<int>(Settings.Tone), Color, Settings.Name, Settings.Radius);
end procedure;

// Presents CUI's native SelectionRing widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Child`: Component framed by the ring.
// - `Settings`: Native widget settings.
// - `Visit`: Presents embedded content.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Child: E.Element<TMsg>; Settings: D.Options; Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment));
begin
  Visit(Child, Frame, false, L.Alignment.Default);
  Apply(Frame.Window, Settings);
end procedure;

end unit;
