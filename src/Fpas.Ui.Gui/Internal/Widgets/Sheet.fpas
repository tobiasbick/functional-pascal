unit Fpas.Ui.Gui.Internal.Widgets.Sheet;

uses
  Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as C,
  Fpas.Ui.Gui.Internal.Focus as Focus, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L,
  Fpas.Ui.Sheets as Sheets, System.Collections.Generic as Generic;

// Draws a controlled native sheet over its base view.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Current`: Frame context.
// - `Id`: Stable sheet identity.
// - `Base`: Underlying view.
// - `Content`: Scrollable sheet body.
// - `Open`: Model-owned visibility.
// - `Settings`: Header, edge, size and initial focus.
// - `Dismiss`: Proposed dismissal message.
// - `Horizontal`: Parent layout axis.
// - `Align`: Parent layout alignment.
// - `Visit`: Host traversal used to draw the two child views.
public procedure Draw<TMsg>(
  Current: C.State<TMsg>; Id: string; Base: E.Element<TMsg>; Content: E.Element<TMsg>;
  Open: bool; Settings: Sheets.Options; Dismiss: TMsg; Horizontal: bool; Align: L.Alignment;
  Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment)
);
begin
  Visit(
    Base, Current with
      AcceptInput := Current.AcceptInput and not Open;
    end with, Horizontal, Align
  );
  if Current.PaintingClosed then
    return;
  end if;

  const Close: string := Sheets.CloseId(Id);
  if Open then
    Focus.Enter<TMsg>(Current, Id, Content, Settings.InitialFocus, Close);
  end if;
  const Enabled: bool := Open and Current.Interactive and Current.ActiveModal = Id;
  const Token: string := C.Token('button', Close);
  const Inside: C.State<TMsg> := Current with
    AcceptInput := Enabled;
    PaintingClosed := not Open;
    Labels := if Open then Current.Labels else new Generic.List<string>() end if;
  end with;
  const Result: int := Current.Window.BeginSheet(
    C.Token('sheet', Id), Settings.Title, Settings.Description, cast<int>(Settings.Edge),
    cast<float>(Settings.Size), Open, Enabled,
    C.WantsFocus<TMsg>(Inside, Close, Token, Enabled), Token
  );
  if Enabled and (Result and 2) <> 0 then
    Current.Messages.Add(Dismiss);
  end if;

  if (Result and 1) <> 0 then
    if Open then
      Current.Labels.Add(Settings.Title);
      if Settings.Description <> '' then
        Current.Labels.Add(Settings.Description);
      end if;

      Current.Controls.Add(
        new App.Control(Close, 'Close', 'button', new Cui.CuiRectangle(), Enabled)
      );
    end if;

    Visit(Content, Inside, false, L.Alignment.Stretch);
    Current.Window.EndSheet();
  end if;
end procedure;
end unit;
