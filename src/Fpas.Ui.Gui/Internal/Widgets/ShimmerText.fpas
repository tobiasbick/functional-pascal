unit Fpas.Ui.Gui.Internal.Widgets.ShimmerText;

uses
  Fpas.Ui.ShimmerTexts as W, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.MotionData as Common, Fpas.Ui.Motion as Motion;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Text`: Display text.
// - `Settings`: Native appearance and input options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Text: string; Settings: Motion.TextOptions);
begin
  const Token: string := C.Token('shimmer-text', Id);
  Frame.Window.ShimmerText(Token, Text, Common.Options(Settings));
  C.Track<TMsg>(Frame, new App.Control(Id, Text, 'shimmer-text', new Cui.CuiRectangle(), false));
end procedure;

end unit;
