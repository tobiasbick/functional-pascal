unit Fpas.Ui.Gui.Internal.Widgets.Sidebar;

uses Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Navigation as N;

// Draws a controlled sidebar through native CUI navigation controls.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Frame context.
// - `Id`: Sidebar identity.
// - `Sections`: Headings and destinations in focus order.
// - `Active`: Model-owned active key.
// - `Enabled`: Input permission for the sidebar.
public procedure Draw<TMsg>(State: C.State<TMsg>; Id: string; Sections: array of N.Section<TMsg>; Active: string?; Enabled: bool);
begin
  const Group: string := C.Token('sidebar', Id);
  State.Window.BeginSidebar(Group, Active <> null);
  for Section: N.Section<TMsg> in Sections do
    if Section.Title <> '' then
      State.Window.SidebarHeading(Section.Title);
      State.Labels.Add(Section.Title);
    end if;

    for Item: N.Item<TMsg> in Section.Items do
      const Allowed: bool := Enabled and Item.Enabled and State.AcceptInput;
      const Selected: bool := Active = Item.Key;
      const Token: string := C.Token('navigation', Id, Item.Key);
      const Focus: bool := C.WantsFocus<TMsg>(State, N.ItemId(Id, Item.Key), Token, Allowed);
      if State.Window.SidebarItem(
        Group,
        Token,
        Item.Label,
        Item.Icon,
        Item.Badge,
        Allowed,
        Selected,
        Focus
      ) and Allowed
      then
        State.Messages.Add(Item.Message);
      end if;

      C.Track<TMsg>(
        State, new App.Control(
          Id, Item.Label, 'navigation', new Cui.CuiRectangle(), Allowed,
          Key := Item.Key, Value := Selected.ToString()
        )
      );
    end for;
  end for;

  State.Window.EndGroup();
end procedure;

end unit;
