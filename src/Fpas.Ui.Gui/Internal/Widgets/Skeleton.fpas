unit Fpas.Ui.Gui.Internal.Widgets.Skeleton;

uses
  Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.Sizing as Size,
  Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Layout as L;

// Draws a native placeholder without calculating its width or animating its shimmer.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable placeholder identity.
// - `Width`: Validated native width mode.
// - `Height`: Logical height; zero selects the native default.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Width: L.Extent; Height: float);
begin
  const Native: Size.NativeExtent := Size.Extent(Width);
  Frame.Window.Skeleton(C.Token('skeleton', Id), Native.Kind, Native.Value, Height);
  C.Track<TMsg>(Frame, new App.Control(Id, '', 'skeleton', new Cui.CuiRectangle(), false));
end procedure;

end unit;
