unit Fpas.Ui.Gui.Internal.Widgets.SourceList;

uses Fpas.Ui.SourceLists as SourceLists, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Sources as Sources, Fpas.Ui.Gui.Cui as Cui, System as Sys, System.Collections.Generic as Lists, Fpas.Ui.Gui.Internal.AiData as Data;

// Presents CUI's native SourceList.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable widget identity.
// - `Documents`: Documents in display order.
// - `Changed`: Optional source activation mapper.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Documents: array of Sources.Item; Changed: Sys.Func<int, TMsg>?; Settings: SourceLists.Options);
begin
  const Role: string := 'source-list';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Native: Lists.List<Cui.CuiSourceItem> := new Lists.List<Cui.CuiSourceItem>(
    Documents.Length
  );
  for Document: Sources.Item in Documents do
    Native.Add(Data.Source(Document));
  end for;
  const Keys: array of string := P.Indexed(Documents.Length);
  const Focus: int := P.Focus<TMsg>(Frame, Id, Role, Keys, P.Inputs(Keys.Length, Enabled), 0);
  const Picked: int := Frame.Window.SourceList(
    Token,
    Native.ToArray(),
    Enabled,
    Focus,
    P.Tracker<TMsg>(Frame, Id, Role, Keys)
  );
  P.Root<TMsg>(Frame, Id, Role, '', false, '');
  for Index: int := 0 to Documents.Length - 1 do
    P.Part<TMsg>(Frame, Id, Role, Keys[Index], Documents[Index].Title, Enabled, '');
  end for;

  if Picked >= 0 then
    case Changed of
      when is Sys.Func<int, TMsg> as Callback:
        Frame.Messages.Add(Callback.Invoke(Picked));
      else
    end case;
  end if;
end procedure;

end unit;
