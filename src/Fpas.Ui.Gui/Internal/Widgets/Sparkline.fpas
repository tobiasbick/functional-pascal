unit Fpas.Ui.Gui.Internal.Widgets.Sparkline;

uses Fpas.Ui.Sparklines as W, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Internal.ChartData as Colors, Fpas.Ui.Gui.Internal.Sizing as S;

// Draws a compact native chart for a series of values.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Values`: Finite samples in display order.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Values: array of float; Settings: W.Options);
begin
  const Role: string := 'sparkline';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  Frame.Window.Sparkline(
    Token,
    Values,
    Width.Kind,
    Width.Value,
    Settings.Height,
    Colors.Color(Settings.Color)
  );
  P.Root<TMsg>(Frame, Id, Role, '', false, '');
end procedure;

end unit;
