unit Fpas.Ui.Gui.Internal.Widgets.StackTrace;

uses Fpas.Ui.StackTraces as D, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Internal.Sizing as S, Fpas.Ui.Gui.Cui as Cui, System.Collections.Generic as Lists;

function PackStackFrame(Items: array of D.Frame): array of Cui.CuiDevStackFrame;
begin
  const Native: Lists.List<Cui.CuiDevStackFrame> := new Lists.List<Cui.CuiDevStackFrame>(
    Items.Length
  );
  for Entry: D.Frame in Items do
    const Source: Lists.List<string?> := new Lists.List<string?>(Entry.Source.Length);
    for Line: string in Entry.Source do
      Source.Add(Line);
    end for;

    Native.Add(
      new Cui.CuiDevStackFrame(
        Entry.FunctionName,
        Entry.File,
        Entry.Line,
        Entry.Column,
        Entry.External,
        Source.ToArray(),
        Entry.SourceFirst
      )
    );
  end for;

  return Native.ToArray();
end function;

// Presents the native StackTrace widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Frames`: Frames supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Frames: array of D.Frame; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'stack-trace';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: Cui.CuiDevResult := Frame.Window.StackTrace(
    Token,
    PackStackFrame(Frames),
    Settings.Title,
    Settings.Message,
    Settings.Language,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, '');
  if Enabled and (Result.Action >= 0) then
    Frame.Messages.Add(Changed(new D.Event(Result.Action)));
  end if;
end procedure;

end unit;
