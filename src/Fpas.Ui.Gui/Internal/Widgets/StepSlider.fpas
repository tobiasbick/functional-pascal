unit Fpas.Ui.Gui.Internal.Widgets.StepSlider;

uses
  Fpas.Ui.StepSliders as A, Fpas.Ui.Gui.Internal.Context as C,
  Fpas.Ui.Gui.Internal.CreativeParts as W, Fpas.Ui.ControlWells as Wells;

// Presents the native step slider.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Presentation state.
// - `Id`: Application identity.
// - `Current`: Model-owned value.
// - `Change`: Maps a native proposal.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Current: A.Value; Change: function(A.Event): TMsg; Settings: A.Options);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Role: string := 'step-slider';
  const Token: string := C.Token(Role, Id);
  const Tool: Wells.Tool? := Settings.Tool;
  const Parts: array of string := ['track', 'tool'];
  const Focus: int := W.Focus<TMsg>(Frame, Id, Role, Parts, [Enabled, Enabled and Tool <> null], 0);
  var Next: int := Current.Current;
  const Flags: int := W.Bits(Enabled, 1) + W.ToolBits(Tool) + W.Bits(Settings.Plain, 8);
  const Result: int := Frame.Window.StepSlider(
    Token,
    Current.Label,
    ref Next,
    Current.Minimum,
    Current.Maximum,
    Settings.Labels,
    Settings.Prefix,
    Settings.Suffix,
    Settings.Display,
    W.Icon(Tool),
    W.Tooltip(Tool),
    Flags,
    Focus,
    W.Tracker<TMsg>(Frame, Id, Role, Parts)
  );
  if Result <> 0 then
    Frame.Messages.Add(Change(new A.Event(Next, (Result and 1) <> 0, (Result and 2) <> 0)));
  end if;

  W.Root<TMsg>(Frame, Id, Role, Current.Label, false, Next.ToString());
  W.Part<TMsg>(Frame, Id, Role, 'track', Current.Label, Enabled, Next.ToString());
  if Tool <> null then
    W.Part<TMsg>(Frame, Id, Role, 'tool', Tool.Tooltip, Enabled, '');
  end if;
end procedure;

end unit;
