unit Fpas.Ui.Gui.Internal.Widgets.Tabs;

uses
  Fpas.Ui.Tabs as T, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.Context as C, System.Collections.Generic as Lists;

// Presents the native tab strip and forwards changed selection.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current frame and message queue.
// - `Id`: Stable strip identity.
// - `Items`: Validated positional choices.
// - `Selected`: Model-owned index.
// - `OnChange`: Maps a proposed index to a message.
// - `Settings`: Native appearance, width and input permission.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Items: array of T.Item; Selected: int;
  OnChange: function(int): TMsg; Settings: T.Options
);
begin
  const Enabled: bool := Settings.Enabled and Frame.AcceptInput;
  const Labels: Lists.List<string> := new Lists.List<string>();
  const Icons: Lists.List<string> := new Lists.List<string>();
  const Tokens: Lists.List<string> := new Lists.List<string>();
  Tokens.Add(C.Token('tabs', Id));
  var Focus: int := 0;
  for Index: int := 0 to Items.Length - 1 do
    Labels.Add(Items[Index].Label);
    Icons.Add(Items[Index].Icon);
    const Token: string := C.Token('tab', Id, Index.ToString());
    Tokens.Add(Token);
    if C.WantsFocus<TMsg>(Frame, T.ItemId(Id, Index), Token, Enabled)
      or C.WantsFocus<TMsg>(Frame, Id, Token, Enabled, Index = Selected)
    then
      Focus := Index + 1;
    end if;
  end for;
  const Proposal: int := Frame.Window.Tabs(
    Tokens[0], Labels.ToArray(), Icons.ToArray(), Selected, cast<int>(Settings.Appearance),
    Settings.FullWidth, Enabled, Focus,
    if Frame.PaintingClosed then
      null
    else
      Tokens.ToArray()
    end if
  );
  if Proposal >= 0 then
    Frame.Messages.Add(OnChange(Proposal));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(Id, 'Tabs', 'tabs', new Cui.CuiRectangle(), false, Value := Selected.ToString())
  );
  for Index: int := 0 to Items.Length - 1 do
    Frame.Controls.Add(
      new App.Control(
        Id, Items[Index].Label, 'tab', new Cui.CuiRectangle(), Enabled,
        Key := Index.ToString(), Value := if Index = Selected then
          'true'
        else
          'false'
        end if
      )
    );
  end for;
end procedure;

end unit;
