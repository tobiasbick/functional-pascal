unit Fpas.Ui.Gui.Internal.Widgets.TagInput;

uses
  Fpas.Ui.TagInputs as T, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, System as Sys;

// Draws a native tag input and publishes changes and remove actions.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable widget identity.
// - `Tags`: Model-owned tags.
// - `OnChange`: Maps a proposed tag list to a message.
// - `Settings`: Caption, bounds and input permission.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Tags: array of string; OnChange: function(array of string): TMsg;
  Settings: T.Options
);
begin
  const Allowed: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('tag-input', Id);
  const TrackRemove: Sys.Func<int, string>? := if Frame.PaintingClosed then
    null
  else
    function(Index: int): string => C.Token('button', T.RemoveId(Id, Index))
  end if;
  const Result: Cui.CuiTagInputResult := Frame.Window.TagInput(
    Token, Tags, Settings.Label, Settings.Placeholder, Settings.MaxTags, Settings.MaxUtf8Bytes,
    Allowed, C.WantsFocus<TMsg>(Frame, Id, Token, Allowed), TrackRemove
  );
  if Allowed and not Sys.Object.ReferenceEquals(Tags, Result.Tags) then
    Frame.Messages.Add(OnChange(Result.Tags));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  if Settings.Label <> '' then
    Frame.Labels.Add(Settings.Label);
  end if;

  Frame.Controls.Add(
    new App.Control(
      Id, Settings.Label, 'tag-input', new Cui.CuiRectangle(), Allowed, Value := Result.DisplayValue
    )
  );
  for Index: int := 0 to Result.RemoveCount - 1 do
    Frame.Controls.Add(
      new App.Control(
        T.RemoveId(Id, Index), 'Remove ' + Tags[Index], 'button', new Cui.CuiRectangle(), Allowed
      )
    );
  end for;
end procedure;
end unit;
