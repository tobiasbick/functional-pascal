unit Fpas.Ui.Gui.Internal.Widgets.Terminal;

uses
  Fpas.Ui.Terminals as D, Fpas.Ui.Gui.Internal.Context as C,
  Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Internal.Sizing as S,
  Fpas.Ui.Gui.Cui as Cui;

// Renders the native Terminal and dispatches its proposals.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI frame.
// - `Id`: Stable widget identity.
// - `Output`: Cumulative output, with optional ANSI formatting.
// - `Revision`: Change to explicitly clear the scrollback before replaying the supplied output.
// - `Received`: Maps submissions and interrupts.
// - `Settings`: Native options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Output: string; Revision: int; Received: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'terminal';
  const Token: string := C.Token(Role, Id);
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Enabled: bool := Frame.AcceptInput;
  const Focus: bool := C.WantsFocus<TMsg>(Frame, Id, Token, Enabled and Settings.Input);
  const Result: Cui.CuiTerminalEvent := Frame.Window.Terminal(
    Token,
    Output,
    Revision,
    Settings.Prompt,
    Width.Kind,
    Width.Value,
    Settings.Height,
    Settings.Size,
    P.Bits(Enabled, 1) or P.Bits(Settings.Input, 2) or P.Bits(Focus, 4)
  );
  const Command: string? := Result.Command;
  if Command <> null then
    Frame.Messages.Add(Received(D.Event.Command(Command)));
  end if;

  if Result.Interrupt then
    Frame.Messages.Add(Received(D.Event.Interrupt));
  end if;

  P.Root<TMsg>(Frame, Id, Role, '', Enabled and Settings.Input, '');
end procedure;

end unit;
