unit Fpas.Ui.Gui.Internal.Widgets.TextField;

uses
  Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.TextFields as F, System as Sys;

// Draws a native editor and delivers its edit before its optional submission.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current drawing context.
// - `Id`: Stable field identity.
// - `Value`: Model-owned text.
// - `OnChange`: Maps a native edit to a message.
// - `Settings`: Presentation, capacity and input options.
// - `OnSubmit`: Optional Enter action.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Value: string; OnChange: function(string): TMsg;
  Settings: F.Options; OnSubmit: Sys.Func<string, TMsg>?
);
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('text-field', Id);
  const Clear: string := F.ClearId(Id);
  const Reveal: string := F.RevealId(Id);
  const Native: Cui.CuiTextFieldOptions := new Cui.CuiTextFieldOptions(
    Settings.Label, Settings.Placeholder, Settings.Icon, Settings.Hint, Settings.Error,
    Settings.Prefix, Settings.Suffix, cast<int>(Settings.ControlSize), Settings.Password,
    Settings.Clearable, Settings.ReadOnly, Settings.MaxUtf8Bytes
  );
  const Result: Cui.CuiTextFieldResult := Frame.Window.TextField(
    Token, Value, Native, Enabled, C.WantsFocus<TMsg>(Frame, Id, Token, Enabled),
    not Frame.PaintingClosed, C.Token('button', Clear), C.Token('button', Reveal)
  );
  if Enabled and Result.Value <> Value then
    Frame.Messages.Add(OnChange(Result.Value));
  end if;

  if Enabled and Result.Submitted then
    case OnSubmit of
      when is Sys.Func<string, TMsg> as Submit:
        Frame.Messages.Add(Submit.Invoke(Result.Value));
      else
    end case;
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  const Message: string := if Settings.Error <> '' then Settings.Error else Settings.Hint end if;
  for Caption: string in [Settings.Label, Message, Settings.Prefix, Settings.Suffix] do
    if Caption <> '' then
      Frame.Labels.Add(Caption);
    end if;
  end for;

  Frame.Controls.Add(
    new App.Control(
      Id, Settings.Label, 'text-field', new Cui.CuiRectangle(), Enabled,
      Value := if Settings.Password then '' else Result.Value end if
    )
  );
  if Result.ClearVisible then
    Frame.Controls.Add(new App.Control(Clear, 'Clear', 'button', new Cui.CuiRectangle(), Enabled));
  end if;

  if Result.RevealVisible then
    Frame.Controls.Add(
      new App.Control(
        Reveal, if Result.Revealed then 'Hide password' else 'Show password' end if,
        'button', new Cui.CuiRectangle(), Enabled, Value := Result.Revealed.ToString()
      )
    );
  end if;
end procedure;
end unit;
