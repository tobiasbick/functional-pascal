unit Fpas.Ui.Gui.Internal.Widgets.TimeHistogram;

uses Fpas.Ui.TimeHistograms as D, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Internal.Sizing as S, Fpas.Ui.Gui.Cui as Cui, System.Collections.Generic as Lists;

function PackSeries(Items: array of D.Series): array of Cui.CuiDevSeries;
begin
  const Native: Lists.List<Cui.CuiDevSeries> := new Lists.List<Cui.CuiDevSeries>(Items.Length);
  for Entry: D.Series in Items do
    Native.Add(new Cui.CuiDevSeries(Entry.Name, Entry.Counts, Entry.Tone));
  end for;

  return Native.ToArray();
end function;

// Presents the native TimeHistogram widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Start`: Start supplied to the widget.
// - `Bucket`: Bucket supplied to the widget.
// - `Buckets`: Buckets supplied to the widget.
// - `SeriesData`: SeriesData supplied to the widget.
// - `Value`: Value supplied to the widget.
// - `Changed`: Maps a native proposal to an application message.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Start: double; Bucket: double; Buckets: int; SeriesData: array of D.Series; Value: D.Range; Changed: function(D.Event): TMsg; Settings: D.Options);
begin
  const Role: string := 'time-histogram';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  const Result: Cui.CuiDevResult := Frame.Window.TimeHistogram(
    Token,
    Start,
    Bucket,
    Buckets,
    PackSeries(SeriesData),
    Value.Start,
    Value.End,
    Settings.Height,
    Settings.Utc,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, '');
  if Enabled and (Result.Flags <> 0) then
    Frame.Messages.Add(Changed(new D.Event(Result.X, Result.Y)));
  end if;
end procedure;

end unit;
