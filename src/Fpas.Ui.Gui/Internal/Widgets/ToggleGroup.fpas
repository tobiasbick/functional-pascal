unit Fpas.Ui.Gui.Internal.Widgets.ToggleGroup;

uses
  Fpas.Ui.ToggleGroups as T, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as C, System.Collections.Generic as Lists;

// Passes a controlled selection to native CUI and tracks the toggles.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current native frame and message queue.
// - `Id`: Group identity.
// - `Items`: Validated positional choices.
// - `Selected`: Current model-owned flags.
// - `OnChange`: Maps an actual change to a message.
// - `Settings`: Native appearance and input permission.
public procedure Draw<TMsg>(
  Frame: C.State<TMsg>; Id: string; Items: array of T.Item; Selected: array of bool;
  OnChange: function(array of bool): TMsg; Settings: T.Options
);
begin
  const Enabled: bool := Settings.Enabled and Frame.AcceptInput;
  const Labels: Lists.List<string> := new Lists.List<string>();
  const Icons: Lists.List<string> := new Lists.List<string>();
  const Tokens: Lists.List<string> := new Lists.List<string>();
  Tokens.Add(C.Token('toggle-group', Id));
  var Focus: int := 0;
  for Index: int := 0 to Items.Length - 1 do
    Labels.Add(Items[Index].Label);
    Icons.Add(Items[Index].Icon);
    const Token: string := C.Token('toggle-group-item', Id, Index.ToString());
    Tokens.Add(Token);
    if C.WantsFocus<TMsg>(Frame, T.ItemId(Id, Index), Token, Enabled)
      or C.WantsFocus<TMsg>(Frame, Id, Token, Enabled, Index = 0)
    then
      Focus := Index + 1;
    end if;
  end for;

  const Proposal: (array of bool)? := Frame.Window.ToggleGroup(
    Tokens[0], Labels.ToArray(), Icons.ToArray(), Selected, cast<int>(Settings.ControlSize),
    Settings.Exclusive, Settings.IconOnly, Enabled, Focus,
    if Frame.PaintingClosed then
      null
    else
      Tokens.ToArray()
    end if
  );
  if Proposal <> null then
    Frame.Messages.Add(OnChange(Proposal));
  end if;

  if Frame.PaintingClosed then
    return;
  end if;

  Frame.Controls.Add(
    new App.Control(Id, 'Toggle group', 'toggle-group', new Cui.CuiRectangle(), false)
  );
  for Index: int := 0 to Items.Length - 1 do
    Frame.Controls.Add(
      new App.Control(
        Id, Items[Index].Label, 'toggle-group-item', new Cui.CuiRectangle(), Enabled,
        Key := Index.ToString(), Value := if Selected[Index] then
          'true'
        else
          'false'
        end if
      )
    );
  end for;
end procedure;
end unit;
