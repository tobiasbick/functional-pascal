unit Fpas.Ui.Gui.Internal.Widgets.Tree;

uses
  Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Trees as T, System as Sys;

// Presents the native Tree element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation context.
// - `Id`: Stable row identity.
// - `Label`: Literal row caption.
// - `Open`: Model expansion, or null for a leaf.
// - `Children`: Elements under the expanded branch.
// - `Change`: Optional expansion mapper for a branch.
// - `Activate`: Optional activation mapper for a leaf.
// - `Settings`: Appearance and input settings.
// - `Visit`: Host traversal for the expanded children.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Label: string; Open: bool?; Children: array of E.Element<TMsg>; Change: Sys.Func<bool, TMsg>?; Activate: Sys.Func<TMsg>?; Settings: T.Options; Visit: procedure(E.Element<TMsg>, C.State<TMsg>, bool, L.Alignment));
begin
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Token: string := C.Token('tree-node', Id);
  const Result: Cui.CuiTreeResult := Frame.Window.BeginTree(
    Token, Label, Settings.Icon, Open = null, Open ?? false, Settings.Selected, Enabled,
    C.WantsFocus<TMsg>(Frame, Id, Token, Enabled)
  );
  C.Track<TMsg>(
    Frame, new App.Control(
      Id, Label, 'tree-node', new Cui.CuiRectangle(), Enabled,
      Value := if Open = null then
        Settings.Selected.ToString()
      else
        Result.Open.ToString()
      end if
    )
  );
  if Enabled then
    case Change of
      when is Sys.Func<bool, TMsg> as Notify:
        if Result.Open <> (Open ?? false) then
          Frame.Messages.Add(Notify.Invoke(Result.Open));
        end if;
      else
    end case;

    if Result.Clicked then
      case Activate of
        when is Sys.Func<TMsg> as Notify:
          Frame.Messages.Add(Notify.Invoke());
        else
      end case;
    end if;
  end if;

  if Result.Open then
    for Child: E.Element<TMsg> in Children do
      Visit(Child, Frame, false, L.Alignment.Default);
    end for;

    Frame.Window.EndTree();
  end if;
end procedure;

end unit;
