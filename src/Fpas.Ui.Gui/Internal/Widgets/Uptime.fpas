unit Fpas.Ui.Gui.Internal.Widgets.Uptime;

uses Fpas.Ui.Uptimes as D, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Internal.CreativeParts as P, Fpas.Ui.Gui.Internal.Sizing as S, Fpas.Ui.Gui.Cui as Cui, System.Collections.Generic as Lists, System as Sys;

function PackService(Items: array of D.Service): array of Cui.CuiDevService;
begin
  const Native: Lists.List<Cui.CuiDevService> := new Lists.List<Cui.CuiDevService>(Items.Length);
  for Entry: D.Service in Items do
    Native.Add(new Cui.CuiDevService(Entry.Name, Entry.Days));
  end for;

  return Native.ToArray();
end function;

// Presents the native Uptime widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current GUI presentation frame.
// - `Id`: Stable widget identity.
// - `Services`: Services supplied to the widget.
// - `LastDay`: LastDay supplied to the widget.
// - `Settings`: Native layout and interaction options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Services: array of D.Service; LastDay: Sys.DateOnly; Settings: D.Options);
begin
  const Role: string := 'uptime';
  const Token: string := C.Token(Role, Id);
  const Enabled: bool := Frame.AcceptInput and Settings.Enabled;
  const Width: S.NativeExtent := S.Extent(Settings.Width);
  discard Frame.Window.Uptime(
    Token,
    PackService(Services),
    LastDay.Year,
    LastDay.Month,
    LastDay.Day,
    Width.Kind,
    Width.Value,
    Enabled
  );
  P.Root<TMsg>(Frame, Id, Role, '', Enabled, '');
end procedure;

end unit;
