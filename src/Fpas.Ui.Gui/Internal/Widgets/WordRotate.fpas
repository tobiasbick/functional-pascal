unit Fpas.Ui.Gui.Internal.Widgets.WordRotate;

uses
  Fpas.Ui.WordRotations as W, Fpas.Ui.Gui.Internal.Context as C, Fpas.Ui.Gui.Application as App,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.MotionData as Common, Fpas.Ui.Motion as Motion;

// Presents the native widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Frame`: Current presentation frame.
// - `Id`: Stable widget identity.
// - `Words`: Native rotation order.
// - `Interval`: Seconds per word.
// - `Settings`: Native appearance and input options.
public procedure Draw<TMsg>(Frame: C.State<TMsg>; Id: string; Words: array of string; Interval: float; Settings: Motion.TextOptions);
begin
  const Token: string := C.Token('word-rotate', Id);
  Frame.Window.WordRotate(Token, Words, Interval, Common.Options(Settings));
  C.Track<TMsg>(Frame, new App.Control(Id, '', 'word-rotate', new Cui.CuiRectangle(), false));
end procedure;

end unit;
