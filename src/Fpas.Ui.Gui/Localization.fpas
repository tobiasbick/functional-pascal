// [Documentation](../../docs/ui/gui/host.md#fonts-and-native-captions)

unit Fpas.Ui.Gui.Localization;

uses Fpas.Ui.Gui.Cui.Resources as Resources;
uses Fpas.Ui.Mvu.Application as Mvu;

// An owned native caption-table replacement.
// ## Type parameters
// - `TMsg`: Application message type.
public type Request of TMsg = record implements Mvu.HostExtension of TMsg
  // Partial captions; null restores native English defaults.
  public Strings: Resources.CuiStrings?;

  // Retains the caption table when mapping a feature command.
  // ## Type parameters
  // - `TNext`: Parent message type.
  // ## Parameters
  // - `Messages`: Parent mapper; no completion message is produced.
  // ## Returns
  // The same replacement in the parent message space.
  public function Map of TNext(Messages: function(TMsg): TNext): Mvu.HostExtension of TNext;
  begin
    return new Request of TNext(self.Strings);
  end function;
end record;

// Replaces native calendar/file-browser captions between frames. The window owns a native copy.
// Per-widget captions override this table; null entries use English.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Strings`: Partial table, or null to restore English. Weeks start on Monday.
// ## Returns
// An owner-thread graphical command.
public function Set of TMsg(Strings: Resources.CuiStrings?): Mvu.Command of TMsg;
begin
  return (Mvu.Command of TMsg).Host(Mvu.HostRequest.Extension(new Request of TMsg(Strings)));
end function;

end unit;
