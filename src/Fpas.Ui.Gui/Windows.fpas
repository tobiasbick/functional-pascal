// [Documentation](../../docs/ui/gui/host.md#window-state-and-placement)

unit Fpas.Ui.Gui.Windows;

uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Mvu.Application as Mvu;

uses System as Sys;

// Live information read from the native window on its owner thread.
public type Info = record
  // Logical window size most recently observed by the native event loop.
  public Size: Cui.CuiSize;
  // Current presentation state, including minimized.
  public State: Cui.CuiWindowState;
  // Backend name, such as win32, x11, sdl2 or glfw.
  public Backend: string;
  // Borrowed handle whose type depends on Backend. Valid while the session owns the window.
  public NativeWindow: Sys.IntPtr;
end record;

// Changes how the owner window is shown.
// ## Type parameters
// - `TMsg`: Application message type.
public type StateRequest of TMsg = record implements Mvu.HostExtension of TMsg
  // Maximized or minimized to change to; normal restores the window.
  public Target: Cui.CuiWindowState;

  // Retains the state request in a parent message space.
  // ## Type parameters
  // - `TNext`: Parent message type.
  // ## Parameters
  // - `Messages`: Mapper for child messages.
  // ## Returns
  // The parent state request.
  public function Map of TNext(Messages: function(TMsg): TNext): Mvu.HostExtension of TNext;
  begin
    return new StateRequest of TNext(self.Target);
  end function;
end record;

// Changes the owner window's document title.
// ## Type parameters
// - `TMsg`: Application message type.
public type TitleRequest of TMsg = record implements Mvu.HostExtension of TMsg
  // Valid Unicode title.
  public Title: string;

  // Retains the title when mapping child commands.
  // ## Type parameters
  // - `TNext`: Parent message type.
  // ## Parameters
  // - `Messages`: Parent message mapper.
  // ## Returns
  // The same title request in the parent message space.
  public function Map of TNext(Messages: function(TMsg): TNext): Mvu.HostExtension of TNext;
  begin
    return new TitleRequest of TNext(self.Title);
  end function;
end record;

// Changes the owner window's logical dimensions.
// ## Type parameters
// - `TMsg`: Application message type.
public type SizeRequest of TMsg = record implements Mvu.HostExtension of TMsg
  // Positive logical width.
  public Width: int;
  // Positive logical height.
  public Height: int;

  // Retains the dimensions when mapping child commands.
  // ## Type parameters
  // - `TNext`: Parent message type.
  // ## Parameters
  // - `Messages`: Parent message mapper.
  // ## Returns
  // The same size request in the parent message space.
  public function Map of TNext(Messages: function(TMsg): TNext): Mvu.HostExtension of TNext;
  begin
    return new SizeRequest of TNext(self.Width, self.Height);
  end function;
end record;

// Moves the owner window.
// ## Type parameters
// - `TMsg`: Application message type.
public type MoveRequest of TMsg = record implements Mvu.HostExtension of TMsg
  // Left edge of the content in desktop coordinates.
  public X: int;
  // Top edge of the content in desktop coordinates.
  public Y: int;

  // Retains the move request in a parent message space.
  // ## Type parameters
  // - `TNext`: Parent message type.
  // ## Parameters
  // - `Messages`: Mapper for child messages.
  // ## Returns
  // The parent move request.
  public function Map of TNext(Messages: function(TMsg): TNext): Mvu.HostExtension of TNext;
  begin
    return new MoveRequest of TNext(self.X, self.Y);
  end function;
end record;

// Reads the owner window's placement and produces an application message.
// ## Type parameters
// - `TMsg`: Application message type.
public type PlacementRequest of TMsg = record implements Mvu.HostExtension of TMsg
  // Maps the placement to a message.
  public OnRead: function(Cui.CuiWindowPlacement): TMsg;

  // Maps the resulting message into a parent message space.
  // ## Type parameters
  // - `TNext`: Parent message type.
  // ## Parameters
  // - `Messages`: Mapper for child messages.
  // ## Returns
  // The parent placement request.
  public function Map of TNext(Messages: function(TMsg): TNext): Mvu.HostExtension of TNext;
  begin
    const Result: function(Cui.CuiWindowPlacement): TMsg := self.OnRead;
    return new PlacementRequest of TNext(
      function(Placement: Cui.CuiWindowPlacement): TNext => Messages(Result(Placement))
    );
  end function;
end record;

function Change of TMsg(Target: Cui.CuiWindowState): Mvu.Command of TMsg;
begin
  return (Mvu.Command of TMsg).Host(Mvu.HostRequest.Extension(new StateRequest of TMsg(Target)));
end function;

// Changes the native document title between frames.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Title`: Valid Unicode title, copied by CUI.
// ## Returns
// The owner-thread graphical command.
public function SetTitle of TMsg(Title: string): Mvu.Command of TMsg;
begin
  return (Mvu.Command of TMsg).Host(Mvu.HostRequest.Extension(new TitleRequest of TMsg(Title)));
end function;

// Changes the native window's logical dimensions.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Width`: Positive logical width.
// - `Height`: Positive logical height.
// ## Returns
// The owner-thread graphical command; the platform applies the size request.
public function Resize of TMsg(Width: int; Height: int): Mvu.Command of TMsg;
requires Width > 0 and Height > 0;
begin
  return (Mvu.Command of TMsg).Host(
    Mvu.HostRequest.Extension(new SizeRequest of TMsg(Width, Height))
  );
end function;

// Maximizes the window where the window manager supports it.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Returns
// The graphical window command.
public function Maximize of TMsg(): Mvu.Command of TMsg;
begin
  return Change of TMsg(Cui.CuiWindowState.Maximized);
end function;

// Minimizes the window to the taskbar or dock where the window manager supports it.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Returns
// The graphical window command.
public function Minimize of TMsg(): Mvu.Command of TMsg;
begin
  return Change of TMsg(Cui.CuiWindowState.Minimized);
end function;

// Undoes a maximize or a minimize. A window minimized from maximized comes back
// maximized.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Returns
// The graphical window command.
public function Restore of TMsg(): Mvu.Command of TMsg;
begin
  return Change of TMsg(Cui.CuiWindowState.Normal);
end function;

// Moves the top-left corner of the window's content. Wayland ignores the
// request because it lets no window place itself.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `X`: Left edge in desktop coordinates: pixels on Windows and X11, points on macOS.
// - `Y`: Top edge in the same units, growing down.
// ## Returns
// The graphical window command.
public function MoveTo of TMsg(X: int; Y: int): Mvu.Command of TMsg;
begin
  return (Mvu.Command of TMsg).Host(Mvu.HostRequest.Extension(new MoveRequest of TMsg(X, Y)));
end function;

// Reads the window's normal size and place and whether it is or comes back
// maximized, for an application that saves them and passes them to
// `Application.Options.Placement` at its next start.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `OnRead`: Maps the placement to one message.
// ## Returns
// The graphical window command.
public function ReadPlacement of TMsg(
  OnRead: function(Cui.CuiWindowPlacement): TMsg
): Mvu.Command of TMsg;
begin
  return (Mvu.Command of TMsg).Host(
    Mvu.HostRequest.Extension(new PlacementRequest of TMsg(OnRead))
  );
end function;

end unit;
