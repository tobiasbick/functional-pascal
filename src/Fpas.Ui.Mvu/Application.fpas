unit Fpas.Ui.Mvu.Application;

uses System as Sys, System.Threading as Threads, System.Threading.Tasks as Tasks;

// A request for the host that owns the input, view and presentation.
public type HostRequest = variant
  // Ask the host to finish the session.
  Close;
  // Ask the host to focus the control with the supplied stable ID.
  Focus(Id: string);
end variant;

// Work requested by an update.
//
// ## Type parameters
// - `TMsg`: The application's message type.
public type Command<TMsg> = variant
  // Start work under Id. Work receives a post function and cancellation token.
  // OnFailure maps an exception from the work into an application message.
  Start(
    Id: string; Work: function(function(TMsg): Tasks.Task, Threads.CancellationToken): Tasks.Task;
    OnFailure: function(Sys.Exception): TMsg
  );
  // Cancel the current run of the supplied effect ID.
  Cancel(Id: string);
  // Forward a request to the host.
  Host(Request: HostRequest);
end variant;

// The result of handling one application message.
//
// ## Type parameters
// - `TModel`: The application's model type.
// - `TMsg`: The application's message type.
public type Transition<TModel, TMsg> = record
  // The model to commit.
  public Model: TModel;
  // The commands to execute in order after committing the model.
  public Commands: array of Command<TMsg>;
end record;

// Requests that the host finish the session.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Returns
// The close command.
public function Exit<TMsg>(): Command<TMsg>;
begin
  return Command<TMsg>.Host(HostRequest.Close);
end function;

// Requests focus in the view produced by the update.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `Id`: The host's stable control ID.
//
// ## Returns
// The focus command.
public function Focus<TMsg>(Id: string): Command<TMsg>;
begin
  return Command<TMsg>.Host(HostRequest.Focus(Id));
end function;

// Describes an owned background run that may post messages while it executes.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `Id`: A nonempty ID. Starting it again replaces its previous run.
// - `Work`: The work. Its post task completes when the mailbox admits the message.
// - `OnFailure`: Maps a worker exception into an application message.
//
// ## Returns
// The command that starts the run.
public function StartBackground<TMsg>(
  Id: string; Work: function(function(TMsg): Tasks.Task, Threads.CancellationToken): Tasks.Task;
  OnFailure: function(Sys.Exception): TMsg
): Command<TMsg>;
requires Id.Length > 0;
begin
  return Command<TMsg>.Start(Id, Work, OnFailure);
end function;

// Requests cancellation and invalidates queued messages from the cancelled run.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `Id`: The ID of the run to cancel.
//
// ## Returns
// The cancellation command.
public function CancelBackground<TMsg>(Id: string): Command<TMsg>;
begin
  return Command<TMsg>.Cancel(Id);
end function;
end unit;
