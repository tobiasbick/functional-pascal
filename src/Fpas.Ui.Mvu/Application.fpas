// [Documentation](../../docs/ui/mvu/runtime.md#driving-a-session)

unit Fpas.Ui.Mvu.Application;

uses Fpas.Execution.Effects as Fx;
uses System as Sys;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

// A host-specific payload that can translate its message factories for a parent session.
//
// ## Type parameters
// - `TMsg`: Messages produced by the payload.
public type HostExtension<TMsg> = protocol
  // Rebuilds the payload with translated messages without performing host work.
  //
  // ## Type parameters
  // - `TNext`: Parent message type.
  // ## Parameters
  // - `Messages`: Translates one child message.
  // ## Returns
  // The payload understood by the host of the parent session.
  function Map<TNext>(Messages: function(TMsg): TNext): HostExtension<TNext>;
end protocol;

// A request for the host that owns the input, view and presentation.
public type HostRequest = variant
  // Ask the host to finish the session.
  Close;
  // Ask the host to focus the control with the supplied stable ID.
  Focus(Id: string);
  // Send a typed extension payload to the host that owns its implementation.
  Extension(Value: Sys.Object);
end variant;

// Supplies the message channel and clock for a running background effect.
//
// ## Type parameters
// - `TMsg`: The session's message type.
public type BackgroundContext<TMsg> = record
  // Posts a message and completes when the mailbox admits it.
  public Post: function(TMsg): Tasks.Task;
  // Drives time-based waits and deadlines in the effect.
  public Clock: Sys.TimeProvider;
end record;

// Work requested by an update.
//
// ## Type parameters
// - `TMsg`: The application's message type.
public type Command<TMsg> = variant
  // Start an effect under Id, posting an expected failure as a message.
  Start(Id: string; Work: Fx.Effect<Fx.Completion, TMsg, BackgroundContext<TMsg>>);
  // Cancel the current run of the supplied effect ID.
  Cancel(Id: string);
  // Forward a request to the host.
  Host(Request: HostRequest);
end variant;

// The result of handling one application message.
//
// ## Type parameters
// - `TModel`: The application's model type.
// - `TMsg`: The application's message type.
public type Transition<TModel, TMsg> = record
  // The model to commit.
  public Model: TModel;
  // The commands to execute in order after committing the model.
  public Commands: array of Command<TMsg>;
end record;

// Requests that the host finish the session.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Returns
// The close command.
public function Exit<TMsg>(): Command<TMsg>;
begin
  return Command<TMsg>.Host(HostRequest.Close);
end function;

// Requests focus in the view produced by the update.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `Id`: The host's stable control ID.
//
// ## Returns
// The focus command.
public function Focus<TMsg>(Id: string): Command<TMsg>;
begin
  return Command<TMsg>.Host(HostRequest.Focus(Id));
end function;

// Describes an owned background run that may post messages while it executes.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `Id`: A nonempty ID. Starting it again replaces its previous run.
// - `Work`: The effect with its message context supplied by the session.
//
// ## Returns
// The command that starts the run.
public function StartBackground<TMsg>(Id: string; Work: Fx.Effect<Fx.Completion, TMsg, BackgroundContext<TMsg>>): Command<TMsg>;
requires Id.Length > 0;
begin
  return Command<TMsg>.Start(Id, Work);
end function;

// Adapts callback-based work that can post messages as it runs.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `Work`: The callback receiving the session's post function and cancellation token.
// - `OnFailure`: Maps a worker exception into an expected effect failure message.
//
// ## Returns
// A deferred effect ready for `StartBackground`.
public function FromWorker<TMsg>(
  Work: function(function(TMsg): Tasks.Task, Threads.CancellationToken): Tasks.Task;
  OnFailure: function(Sys.Exception): TMsg
): Fx.Effect<Fx.Completion, TMsg, BackgroundContext<TMsg>>;
  async function Run(Context: BackgroundContext<TMsg>; Token: Threads.CancellationToken): Tasks.Task<Fx.Outcome<Fx.Completion, TMsg>>;
  begin
    try
      await Work(Context.Post, Token).ConfigureAwait(false);
    catch Failure: Sys.Exception do
      Token.ThrowIfCancellationRequested();
      return Fx.Outcome.Failure(OnFailure(Failure));
    end try;

    return Fx.Outcome.Success(Fx.Completion.Done);
  end function;
begin
  return Fx.Effect<Fx.Completion, TMsg, BackgroundContext<TMsg>>.Defer(Run);
end function;

// Adapts a typed effect by translating its outcome into session messages.
//
// ## Type parameters
// - `A`: The effect's success type.
// - `E`: The effect's expected failure type.
// - `R`: The effect's required environment type.
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `Work`: The typed effect to run.
// - `Environment`: Supplies effect dependencies from the running session context.
// - `OnSuccess`: Produces a message for a successful result.
// - `OnFailure`: Produces a message for an expected failure.
//
// ## Returns
// A deferred effect ready for `StartBackground`.
public function FromEffect<A, E, R, TMsg>(
  Work: Fx.Effect<A, E, R>; Environment: function(BackgroundContext<TMsg>): R;
  OnSuccess: function(A): TMsg; OnFailure: function(E): TMsg
): Fx.Effect<Fx.Completion, TMsg, BackgroundContext<TMsg>>;
  async function Run(Context: BackgroundContext<TMsg>; Token: Threads.CancellationToken): Tasks.Task<Fx.Outcome<Fx.Completion, TMsg>>;
  begin
    case await Work.Run(Environment(Context), Token).ConfigureAwait(false) of
      when Fx.Outcome.Success(const Value: A):
        Token.ThrowIfCancellationRequested();
        await Context.Post(OnSuccess(Value)).ConfigureAwait(false);
        return Fx.Outcome.Success(Fx.Completion.Done);
      when Fx.Outcome.Failure(const Reason: E):
        Token.ThrowIfCancellationRequested();
        return Fx.Outcome.Failure(OnFailure(Reason));
    end case;
  end function;
begin
  return Fx.Effect<Fx.Completion, TMsg, BackgroundContext<TMsg>>.Defer(Run);
end function;

// Requests cancellation and invalidates queued messages from the cancelled run.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `Id`: The ID of the run to cancel.
//
// ## Returns
// The cancellation command.
public function CancelBackground<TMsg>(Id: string): Command<TMsg>;
begin
  return Command<TMsg>.Cancel(Id);
end function;

end unit;
