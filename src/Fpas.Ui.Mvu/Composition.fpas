// [Documentation](../../docs/ui/mvu/runtime.md#larger-applications)

unit Fpas.Ui.Mvu.Composition;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Ui.Mvu.Application as A;

uses System as Sys;
uses System.Collections.Generic as Lists;
uses System.Threading.Tasks as Tasks;

function EffectId(Scope: string; Id: string): string;
begin
  if Id = '' then
    raise new Sys.ArgumentException('An effect ID must not be empty.');
  end if;

  return if Scope = '' then
    Id
  else
    Scope + '/' + Id
  end if;
end function;

// Translates a child's command for the parent session without running it.
//
// ## Type parameters
// - `TChild`: Child message type.
// - `TParent`: Parent message type.
// ## Parameters
// - `Value`: Child command to translate.
// - `Messages`: Wraps a child message in its parent message.
// - `Scope`: Optional prefix for background start/cancel IDs; focus IDs stay global.
// ## Returns
// A parent command preserving cancellation, posting backpressure and failure handling.
// Host extension payloads must implement Application.HostExtension<TChild>.
public function MapCommand of (TChild, TParent)(
  Value: A.Command of TChild;
  Messages: function(TChild): TParent; Scope: string := ''
): A.Command of TParent;
  function Start(
    Id: string; Work: Fx.Effect of (Fx.Completion, TChild, A.BackgroundContext of TChild)
  ): A.Command of TParent;
    function Adapt(Parent: A.BackgroundContext of TParent): A.BackgroundContext of TChild;
    begin
      return new A.BackgroundContext of TChild(
        function(Message: TChild): Tasks.Task => Parent.Post(Messages(Message)),
        Parent.Clock
      );
    end function;
  begin
    const Adapted: Fx.Effect of (Fx.Completion, TChild, A.BackgroundContext of TParent) := Fx.FromEnvironment(
      Work,
      Adapt
    );
    return A.StartBackground of TParent(EffectId(Scope, Id), Fx.MapFailure(Adapted, Messages));
  end function;
  function Host(Request: A.HostRequest): A.Command of TParent;
  begin
    case Request of
      when A.HostRequest.Extension(const Payload: Sys.Object):
        if not (Payload is A.HostExtension of TChild) then
          raise new Sys.ArgumentException(
            'A mapped host payload must implement HostExtension for its child message type.'
          );
        end if;

        return (A.Command of TParent).Host(
          A.HostRequest.Extension(
            (cast Payload as A.HostExtension of TChild).Map of TParent(Messages)
          )
        );
      else
        return (A.Command of TParent).Host(Request);
    end case;
  end function;
begin
  return case Value of
    when A.Command.Start(
      const Id: string,
      const Work: Fx.Effect of (Fx.Completion, TChild, A.BackgroundContext of TChild)
    ): Start(Id, Work);
    when A.Command.Cancel(const Id: string): (A.Command of TParent).Cancel(EffectId(Scope, Id));
    when A.Command.Host(const Request: A.HostRequest): Host(Request);
  end case;
end function;

// Translates all commands in a child's transition while retaining its next model.
//
// ## Type parameters
// - `TModel`: Child model type.
// - `TChild`: Child message type.
// - `TParent`: Parent message type.
// ## Parameters
// - `Value`: Child update result.
// - `Messages`: Wraps messages produced by the child's effects.
// - `Scope`: Optional effect ID prefix shared by start and cancel commands.
// ## Returns
// The child model and parent commands in their original order.
public function MapTransition of (TModel, TChild, TParent)(
  Value: A.Transition of (TModel, TChild);
  Messages: function(TChild): TParent; Scope: string := ''
): A.Transition of (TModel, TParent);
begin
  const Commands: Lists.List of A.Command of TParent := new Lists.List of A.Command of TParent();
  for Index: int := 0 to Value.Commands.Length - 1 do
    Commands.Add(MapCommand of (TChild, TParent)(Value.Commands[Index], Messages, Scope));
  end for;

  return new A.Transition of (TModel, TParent)(Value.Model, Commands.ToArray());
end function;

end unit;
