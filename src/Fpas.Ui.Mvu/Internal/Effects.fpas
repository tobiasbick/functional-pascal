// [Documentation](../../../docs/ui/mvu/runtime.md#background-effects)

unit Fpas.Ui.Mvu.Internal.Effects;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Ui.Mvu.Application as App;
uses Fpas.Ui.Mvu.Diagnostics as D;
uses System as Sys;
uses System.Collections.Generic as Generic;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

type Run = record
  // The application's stable effect ID.
  public Id: string;
  // The generation attached to the run's replies.
  public Version: long;
  Source: Threads.CancellationTokenSource;
  Work: Tasks.Task;
  Cancellation: Tasks.Task?;

  // Creates a run and takes ownership of its cancellation source.
  //
  // ## Parameters
  // - `Id`: The stable effect ID.
  // - `Version`: The generation attached to its messages.
  // - `Source`: The worker's cancellation source.
  // - `Work`: The task representing the worker body.
  //
  // ## Returns
  // The run before any cancellation request.
  public static function Start(
    Id: string; Version: long; Source: Threads.CancellationTokenSource; Work: Tasks.Task
  ): Run;
  begin
    return new Run(Id, Version, Source, Work, null);
  end function;

  // Returns the run with its asynchronous cancellation request recorded.
  public function RequestCancel(): Run;
  begin
    if self.Cancellation <> null then
      return self;
    end if;

    return new Run(self.Id, self.Version, self.Source, self.Work, self.Source.CancelAsync());
  end function;

  // Reports whether the body or its cancellation callbacks are still running.
  public function Running(): bool;
  begin
    const Callback: Tasks.Task? := self.Cancellation;
    return not self.Work.IsCompleted or (Callback <> null and not Callback.IsCompleted);
  end function;

  // Copies the run's identity and cancellation state.
  //
  // ## Parameters
  // - `IsCurrent`: Whether the owner accepts messages from this run.
  // ## Returns
  // The diagnostic record for the run.
  public function Describe(IsCurrent: bool): D.EffectRun;
  begin
    return new D.EffectRun(self.Id, self.Version, IsCurrent, self.Cancellation <> null);
  end function;

  // Returns a task that observes the body and callbacks, then disposes the source.
  public async function Join(): Tasks.Task;
  begin
    const Callback: Tasks.Task? := self.Cancellation;
    const Completion: Tasks.Task := if Callback = null then
      self.Work
    else
      Tasks.Task.WhenAll(self.Work, Callback)
    end if;
    try
      await Completion.ConfigureAwait(false);
    catch _Cancelled: Sys.OperationCanceledException when Completion.IsCanceled
      and self.Source.IsCancellationRequested do
    catch _Failure: Sys.Exception do
      const Faults: Sys.AggregateException? := Completion.Exception;
      if Faults <> null and Faults.InnerExceptions.Count > 1 then
        raise Faults;
      end if;

      raise;
    finally
      self.Source.Dispose();
    end try;
  end function;
end record;

type Joining = record
  // Metadata that remains available while shutdown awaits this run.
  public Effect: D.EffectRun;
  // The task that observes the worker and disposes its cancellation source.
  public Completion: Tasks.Task;
end record;

// Manages effect generations and cleanup on the session's owner.
//
// ## Type parameters
// - `TMsg`: The application's message type.
public type State<TMsg> = record
  // Schedules an effect with the supplied ID.
  public Start: procedure(string, Fx.Effect<Fx.Completion, TMsg, App.BackgroundContext<TMsg>>);
  // Invalidates a generation and starts cancellation.
  public Cancel: procedure(string);
  // Reports whether an effect message belongs to the current generation.
  public IsCurrent: function(string, long): bool;
  // Counts runs with a worker or cancellation callbacks still executing.
  public Pending: function(): int;
  // Requests cancellation and returns the cleanup task.
  public Close: function(): Tasks.Task;
  // Copies metadata for runs whose body or cleanup is in progress.
  public Active: function(): Generic.IReadOnlyList<D.EffectRun>;
end record;

// Creates an effect owner that sends results through the session mailbox.
//
// ## Type parameters
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `Enqueue`: Posts a generation-tagged message using the run's cancellation token.
// - `Clock`: Provides time for the owner's effects.
//
// ## Returns
// The effect owner.
public function Create<TMsg>(
  Enqueue: function(string, long, TMsg, Threads.CancellationToken): Tasks.Task; Clock: Sys.TimeProvider
): State<TMsg>;
  async function Perform(
    Id: string; Version: long; Work: Fx.Effect<Fx.Completion, TMsg, App.BackgroundContext<TMsg>>;
    Token: Threads.CancellationToken
  ): Tasks.Task;
    function Post(Message: TMsg): Tasks.Task;
    begin
      return Enqueue(Id, Version, Message, Token);
    end function;
  begin
    case await Work.Run(
      new App.BackgroundContext<TMsg>(Post, Clock),
      Token
    ).ConfigureAwait(false) of
      when Fx.Outcome.Success(_):
      when Fx.Outcome.Failure(const Message: TMsg):
        Token.ThrowIfCancellationRequested();
        await Post(Message).ConfigureAwait(false);
    end case;
  end function;

  procedure Prune();
  begin
    for Index: int := Workers.Count - 1 downto 0 do
      const Worker: Run := Workers[Index];
      if not Worker.Running() then
        const Completion: Tasks.Task := Worker.Join();
        if Completion.IsFaulted then
          Faulted.Add(Completion);
        end if;

        Workers.RemoveAt(Index);
      end if;
    end for;
  end procedure;

  procedure Cancel(Id: string);
  begin
    var Version: long := 0L;
    if not Versions.Remove(Id, out Version) then
      return;
    end if;

    for Index: int := Workers.Count - 1 downto 0 do
      const Worker: Run := Workers[Index];
      if Worker.Version = Version then
        Workers[Index] := Worker.RequestCancel();
        break;
      end if;
    end for;
  end procedure;

  procedure Start(Id: string; Work: Fx.Effect<Fx.Completion, TMsg, App.BackgroundContext<TMsg>>);
  begin
    Prune();
    Cancel(Id);
    Sequence := Sequence + 1L;
    const Version: long := Sequence;
    const Source: Threads.CancellationTokenSource := new Threads.CancellationTokenSource();
    const Task: Tasks.Task := Tasks.TaskExtensions.Unwrap(
      Tasks.Task.Run<Tasks.Task>(
        function(): Tasks.Task => Perform(Id, Version, Work, Source.Token)
      )
    );
    Versions.Add(Id, Version);
    Workers.Add(Run.Start(Id, Version, Source, Task));
  end procedure;

  function IsCurrent(Id: string; Version: long): bool;
  begin
    var Current: long := 0L;
    return Versions.TryGetValue(Id, out Current) and Current = Version;
  end function;

  function Pending(): int;
  begin
    Prune();
    var Count: int := Workers.Count;
    for Worker: Joining in Cleanup do
      if not Worker.Completion.IsCompleted then
        Count := Count + 1;
      end if;
    end for;

    return Count;
  end function;

  function Active(): Generic.IReadOnlyList<D.EffectRun>;
  begin
    const Runs: Generic.List<D.EffectRun> := new Generic.List<D.EffectRun>();
    for Worker: Run in Workers do
      if Worker.Running() then
        Runs.Add(Worker.Describe(IsCurrent(Worker.Id, Worker.Version)));
      end if;
    end for;

    for Worker: Joining in Cleanup do
      if not Worker.Completion.IsCompleted then
        Runs.Add(Worker.Effect);
      end if;
    end for;

    return Runs.AsReadOnly();
  end function;

  function Close(): Tasks.Task;
  begin
    Prune();
    Versions.Clear();
    const Completions: Generic.List<Tasks.Task> := new Generic.List<Tasks.Task>(Faulted);
    for Worker: Run in Workers do
      const Cancelled: Run := Worker.RequestCancel();
      const Completion: Tasks.Task := Cancelled.Join();
      Cleanup.Add(new Joining(Cancelled.Describe(false), Completion));
      Completions.Add(Completion);
    end for;

    Workers.Clear();
    return Tasks.Task.WhenAll(Completions.ToArray());
  end function;
begin
  const Workers: Generic.List<Run> := new Generic.List<Run>();
  const Versions: Generic.Dictionary<string, long> := new Generic.Dictionary<string, long>();
  const Faulted: Generic.List<Tasks.Task> := new Generic.List<Tasks.Task>();
  const Cleanup: Generic.List<Joining> := new Generic.List<Joining>();
  var Sequence: long := 0L;
  return new State<TMsg>(Start, Cancel, IsCurrent, Pending, Close, Active);
end function;

end unit;
