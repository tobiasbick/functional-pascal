// [Documentation](../../docs/ui/mvu/runtime.md#driving-a-session)

unit Fpas.Ui.Mvu.Session;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Ui.Mvu.Application as App;
uses Fpas.Ui.Mvu.Diagnostics as D;
uses Fpas.Ui.Mvu.Internal.Effects as Effects;

uses System as Sys;
uses System.Threading as Threads;
uses System.Threading.Channels as Channels;
uses System.Threading.Tasks as Tasks;

// The outcome of posting to the session mailbox.
public type Admission = variant
  // The item entered the FIFO.
  Queued;
  // The mailbox is open but at capacity.
  Full;
  // The session no longer admits items.
  Closed;
end variant;

// The outcome of advancing the session by at most one mailbox item.
//
// ## Type parameters
// - `TInput`: The host's raw input type.
public type Step of TInput = variant
  // The mailbox has no work for the owner.
  Idle;
  // The owner must route the supplied host input.
  Input(Value: TInput);
  // The runtime applied a message.
  Updated;
  // A superseded effect's result was discarded.
  Stale;
end variant;

// Owns one model, mailbox and group of effects.
//
// ## Type parameters
// - `TModel`: The application's model type.
// - `TMsg`: The application's message type.
// - `TInput`: The host's raw input type.
public type Runtime of (TModel, TMsg, TInput) = record
  // Reads the current model on the host owner.
  public Model: function(): TModel;
  // Posts a host input. Multiple producers may post.
  public Send: function(TInput): Admission;
  // Posts an application message. Multiple producers may post.
  public Post: function(TMsg): Admission;
  // Applies one message synchronously on the owner, for example after routing input.
  public Dispatch: procedure(TMsg);
  // Advances one FIFO item on the host owner.
  public Advance: function(): Step of TInput;
  // Waits for possible work or closure. The supplied token cancels the wait.
  public WaitForWork: function(Threads.CancellationToken): Tasks.Task of bool;
  // Waits for possible capacity or closure. The supplied token cancels the wait.
  public WaitForSpace: function(Threads.CancellationToken): Tasks.Task of bool;
  // Reports whether the session accepts work.
  public IsOpen: function(): bool;
  // Counts queued items for host diagnostics.
  public QueueCount: function(): int;
  // Counts workers and cancellation callbacks still executing, on the owner.
  public PendingEffects: function(): int;
  // Stops admission on the owner and returns the same completion task on every call.
  public Close: function(): Tasks.Task;
  // Reads the mailbox, effects and cleanup state without advancing the session.
  public Snapshot: function(): D.SessionSnapshot;
end record;

type Entry of (TMsg, TInput) = variant
  Empty;
  Input(Value: TInput);
  Message(Value: TMsg);
  Background(Id: string; Version: long; Value: TMsg);
end variant;

procedure Notify(Wake: Sys.Action?);
begin
  case Wake of
    when is Sys.Action as Callback:
      Callback.Invoke();
    else
  end case;
end procedure;

async function WriteBackground of (TMsg, TInput)(
  Queue: Channels.Channel of Entry of (TMsg, TInput);
  Wake: Sys.Action?; Id: string; Version: long; Message: TMsg;
  Cancellation: Threads.CancellationToken
): Tasks.Task;
begin
  try
    await Queue.Writer.WriteAsync(
      Entry of (TMsg, TInput).Background(Id, Version, Message),
      Cancellation
    ).ConfigureAwait(false);
  catch _Closed: Channels.ChannelClosedException when Cancellation.IsCancellationRequested do
    // Close can reach a waiting post before its asynchronous cancellation callback.
    raise new Sys.OperationCanceledException(Cancellation);
  end try;

  Notify(Wake);
end function;

// Creates a manually driven session without a view or window system.
//
// ## Type parameters
// - `TModel`: The application's model type.
// - `TMsg`: The application's message type.
// - `TInput`: The host's raw input type.
//
// ## Parameters
// - `InitialModel`: The model before processing any messages.
// - `Update`: The transition to run on the owner for each applied message.
// - `NotifyHost`: Receives focus and close requests on the owner.
// - `Capacity`: Positive bound for the shared mailbox.
// - `Wake`: Optional nonthrowing producer-thread notification after admission.
// - `Clock`: Clock for background effects. Defaults to the system time provider.
//
// ## Returns
// The session. Serialize model reads, steps and close on the owner.
public function Start of (TModel, TMsg, TInput)(
  InitialModel: TModel; Update: function(TModel, TMsg): App.Transition of (TModel, TMsg);
  NotifyHost: procedure(App.HostRequest); Capacity: int; Wake: Sys.Action? := null;
  Clock: Sys.TimeProvider? := null
): Runtime of (TModel, TMsg, TInput);
requires Capacity > 0;
  function Model(): TModel;
  begin
    return Current;
  end function;

  function IsOpen(): bool;
  begin
    Threads.Monitor.Enter(Gate);
    try
      return Cleanup = null;
    finally
      Threads.Monitor.Exit(Gate);
    end try;
  end function;

  function TryEnqueue(Item: Entry of (TMsg, TInput)): Admission;
  begin
    var Result: Admission := Admission.Closed;
    Threads.Monitor.Enter(Gate);
    try
      if Cleanup = null then
        Result := if Queue.Writer.TryWrite(Item) then
          Admission.Queued
        else
          Admission.Full
        end if;
      end if;
    finally
      Threads.Monitor.Exit(Gate);
    end try;

    case Result of
      when Admission.Queued:
        Notify(Wake);
      else
    end case;

    return Result;
  end function;

  function Send(Input: TInput): Admission;
  begin
    return TryEnqueue(Entry of (TMsg, TInput).Input(Input));
  end function;

  function Post(Message: TMsg): Admission;
  begin
    return TryEnqueue(Entry of (TMsg, TInput).Message(Message));
  end function;

  function WaitForWork(Cancellation: Threads.CancellationToken): Tasks.Task of bool;
  begin
    return if IsOpen() then
      Queue.Reader.WaitToReadAsync(Cancellation).AsTask()
    else
      Tasks.Task.FromResult of bool(false)
    end if;
  end function;

  function WaitForSpace(Cancellation: Threads.CancellationToken): Tasks.Task of bool;
  begin
    return if IsOpen() then
      Queue.Writer.WaitToWriteAsync(Cancellation).AsTask()
    else
      Tasks.Task.FromResult of bool(false)
    end if;
  end function;

  function Close(): Tasks.Task;
  begin
    Threads.Monitor.Enter(Gate);
    try
      const Existing: Tasks.Task? := Cleanup;
      if Existing <> null then
        return Existing;
      end if;

      const Closing: Tasks.Task := Workers.Close();
      Cleanup := Closing;
      discard Queue.Writer.TryComplete();
      var Unused: Entry of (TMsg, TInput) := Entry of (TMsg, TInput).Empty;
      while Queue.Reader.TryRead(out Unused) do
      end while;

      return Closing;
    finally
      Threads.Monitor.Exit(Gate);
    end try;
  end function;

  procedure Dispatch(Message: TMsg);
  begin
    if not IsOpen() then
      return;
    end if;
    const Next: App.Transition of (TModel, TMsg) := Update(Current, Message);
    Current := Next.Model;
    for Command: App.Command of TMsg in Next.Commands do
      if not IsOpen() then
        return;
      end if;

      case Command of
        when App.Command.Cancel(const Id: string):
          Workers.Cancel(Id);
        when App.Command.Start(
          const Id: string,
          const Work: Fx.Effect of (Fx.Completion, TMsg, App.BackgroundContext of TMsg)
        ):
          Workers.Start(Id, Work);
        when App.Command.Host(const Request: App.HostRequest):
          case Request of
            when App.HostRequest.Close:
              discard Close();
              NotifyHost(Request);
              return;
            else
              NotifyHost(Request);
          end case;
      end case;
    end for;
  end procedure;

  function Advance(): Step of TInput;
  begin
    var Item: Entry of (TMsg, TInput) := Entry of (TMsg, TInput).Empty;
    if not IsOpen() or not Queue.Reader.TryRead(out Item) then
      return (Step of TInput).Idle;
    end if;

    case Item of
      when Entry.Input(const Value: TInput):
        return (Step of TInput).Input(Value);
      when Entry.Message(const Value: TMsg):
        Dispatch(Value);
        return (Step of TInput).Updated;
      when Entry.Background(const Id: string, const Version: long, const Value: TMsg):
        if Workers.IsCurrent(Id, Version) then
          Dispatch(Value);
          return (Step of TInput).Updated;
        end if;

        StaleReplies := StaleReplies + 1L;
        return (Step of TInput).Stale;
      when Entry.Empty:
        return (Step of TInput).Idle;
    end case;
  end function;

  function Snapshot(): D.SessionSnapshot;
  begin
    const Closing: Tasks.Task? := Cleanup;
    var State: D.Lifecycle := D.Lifecycle.Open;
    if Closing <> null then
      State := if Closing.IsCompleted then
        D.Lifecycle.Closed
      else
        D.Lifecycle.Closing
      end if;
    end if;

    return new D.SessionSnapshot(
      State,
      Queue.Reader.Count,
      Capacity,
      Workers.Active(),
      StaleReplies
    );
  end function;
begin
  const Gate: Sys.Object := new Sys.Object();
  const Queue: Channels.Channel of Entry of (TMsg, TInput) := Channels.Channel.CreateBounded of Entry of (TMsg, TInput)(
    Capacity
  );
  const Workers: Effects.State of TMsg := Effects.Create of TMsg(
    function(Id: string; Version: long; Message: TMsg; Cancellation: Threads.CancellationToken): Tasks.Task => WriteBackground of (TMsg, TInput)(
      Queue,
      Wake,
      Id,
      Version,
      Message,
      Cancellation
    ),
    Clock ?? Sys.TimeProvider.System
  );
  var Current: TModel := InitialModel;
  var Cleanup: Tasks.Task? := null;
  var StaleReplies: long := 0L;
  return new Runtime of (TModel, TMsg, TInput)(
    Model, Send, Post, Dispatch, Advance, WaitForWork, WaitForSpace, IsOpen,
    function(): int => Queue.Reader.Count, Workers.Pending, Close, Snapshot
  );
end function;

end unit;
