// [Documentation](../../../../docs/ui/tui/host.md#input-and-controlled-state)

unit Fpas.Ui.Tui.Internal.Controls.Activation;

public type Result of TMsg = variant
  NoAction;
  Send(Message: TMsg);
end variant;

public type IActivatable of TMsg = protocol
  function Activate(): Result of TMsg;
end protocol;

// Runs a callback only when an action is activated.
// ## Type parameters
// - `TMsg`: Application message type.
public type Callback of TMsg = record implements IActivatable of TMsg
  // Local action or application message proposal.
  public Run: function(): Result of TMsg;

  // Invokes the delayed action.
  // ## Returns
  // The application message, when the action produces one.
  public function Activate(): Result of TMsg;
  begin
    return self.Run();
  end function;
end record;

// Forwards a proposal when a control produces an application message.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Action`: Outcome of the control input.
// - `Apply`: Application dispatcher.
public procedure Dispatch of TMsg(Action: Result of TMsg; Apply: procedure(TMsg));
begin
  case Action of
    when Result.Send(const Message: TMsg):
      Apply(Message);
    when Result.NoAction:
  end case;
end procedure;

public type Direct of TMsg = record implements IActivatable of TMsg
  public Message: TMsg;
  // Whether activation is suspended while the widget is busy.
  public Busy: bool := false;

  public function Activate(): Result of TMsg;
  begin
    return if self.Busy then
      (Result of TMsg).NoAction
    else
      (Result of TMsg).Send(self.Message)
    end if;
  end function;
end record;

// Defers mapping a proposed value to a message until the user activates a control.
// ## Type parameters
// - `TValue`: Value proposed to the application.
// - `TMsg`: Application message type.
public type Proposal of (TValue, TMsg) = record implements IActivatable of TMsg
  // Maps an accepted activation to an application message.
  public Notify: function(TValue): TMsg;
  // Value proposed by this presentation of the widget.
  public Value: TValue;

  // Invokes the application's mapper once.
  // ## Returns
  // The message to dispatch.
  public function Activate(): Result of TMsg;
  begin
    return (Result of TMsg).Send(self.Notify(self.Value));
  end function;
end record;

end unit;
