// [Documentation](../../../../docs/ui/tui/host.md#input-and-controlled-state)

unit Fpas.Ui.Tui.Internal.Controls.Activation;

public type Result<TMsg> = variant
  NoAction;
  Send(Message: TMsg);
end variant;

public type IActivatable<TMsg> = protocol
  function Activate(): Result<TMsg>;
end protocol;

public type Direct<TMsg> = record implements IActivatable<TMsg>
  public Message: TMsg;
  // Whether activation is suspended while the widget is busy.
  public Busy: bool := false;

  public function Activate(): Result<TMsg>;
  begin
    return if self.Busy then
      Result<TMsg>.NoAction
    else
      Result<TMsg>.Send(self.Message)
    end if;
  end function;
end record;

// Defers mapping a proposed value to a message until the user activates a control.
// ## Type parameters
// - `TValue`: Value proposed to the application.
// - `TMsg`: Application message type.
public type Proposal<TValue, TMsg> = record implements IActivatable<TMsg>
  // Maps an accepted activation to an application message.
  public Notify: function(TValue): TMsg;
  // Value proposed by this presentation of the widget.
  public Value: TValue;

  // Invokes the application's mapper once.
  // ## Returns
  // The message to dispatch.
  public function Activate(): Result<TMsg>;
  begin
    return Result<TMsg>.Send(self.Notify(self.Value));
  end function;
end record;

end unit;
