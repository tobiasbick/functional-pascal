unit Fpas.Ui.Tui.Internal.Hosting.Editing;

uses System as Sys, System.Globalization as Global;

public type Selection = record
  public Caret: int;
  public Anchor: int;
end record;

public type Change = record
  public Text: string;
  public Caret: int;
end record;

public function Previous(Value: string; Index: int): int;
begin
  var Boundary: int := 0;
  for Offset: int in Global.StringInfo.ParseCombiningCharacters(Value) do
    if Offset >= Index then
      break;
    end if;

    Boundary := Offset;
  end for;

  return Boundary;
end function;

public function Next(Value: string; Index: int): int;
begin
  for Offset: int in Global.StringInfo.ParseCombiningCharacters(Value) do
    if Offset > Index then
      return Offset;
    end if;
  end for;

  return Value.Length;
end function;

public function Clamp(Value: string; Index: int): int;
begin
  if Index >= Value.Length then
    return Value.Length;
  end if;

  if Index <= 0 then
    return 0;
  end if;

  return Previous(Value, Index + 1);
end function;

public function Replace(Value: string; Range: Selection; Insert: string): Change;
begin
  const First: int := Sys.Math.Min(Range.Caret, Range.Anchor);
  const Last: int := Sys.Math.Max(Range.Caret, Range.Anchor);
  return new Change(
    Value.Substring(0, First) + Insert + Value.Substring(Last),
    First + Insert.Length
  );
end function;

public function Delete(Value: string; Range: Selection; Backward: bool): Change;
begin
  if Range.Caret <> Range.Anchor then
    return Replace(Value, Range, '');
  end if;

  const Other: int := if Backward then Previous(
      Value,
      Range.Caret
    )
    else Next(Value, Range.Caret)
    end if;
  return Replace(Value, new Selection(Range.Caret, Other), '');
end function;
end unit;
