unit Fpas.Ui.Tui.Internal.Hosting.GridNotifications;

uses
  Fpas.Ui.Tui.Internal.Layout.Scene as A, Fpas.Ui.Tui.Internal.Layout.Flexible as F,
  Fpas.Ui.TerminalExtensions.CellGrids as Grids, Fpas.Ui.Mvu.Session as Runtime,
  System.Collections.Generic as C;

// Admits deferred size messages in order when the bounded host mailbox has space.
// `TMsg` is the application message type, `Pending` the owner's backlog and `Post` its mailbox.
public procedure Flush<TMsg>(Pending: C.Queue<TMsg>; Post: function(TMsg): Runtime.Admission);
begin
  while Pending.Count > 0 do
    case Post(Pending.Peek()) of
      when Runtime.Admission.Full:
        return;
      when Runtime.Admission.Closed:
        Pending.Clear();
        return;
      when Runtime.Admission.Queued:
        discard Pending.Dequeue();
    end case;
  end while;
end procedure;

// Compares the published `Layout` to `Before` by grid identity and allocation.
// Queues first and changed sizes in `Pending` through `Post` for a later update.
// `TMsg` is the application's message type.
public procedure Presented<TMsg>(Before: A.Layout<TMsg>?; Layout: A.Layout<TMsg>; Pending: C.Queue<TMsg>; Post: function(TMsg): Runtime.Admission);
begin
  for Control: A.Control<TMsg> in Layout.Controls do
    case Control.Action of
      when A.Binding.Grid(const Area: F.Rect, const Changed: function(Grids.Event): TMsg):
        const Previous: A.Control<TMsg>? := A.FindControl<TMsg>(Before, Control.Id);
        if Previous <> null then
          case Previous.Action of
            when A.Binding.Grid(const Old: F.Rect, _):
              if Old.Width = Area.Width and Old.Height = Area.Height then
                continue;
              end if;
            else
          end case;
        end if;

        Pending.Enqueue(Changed(Grids.Event.Resized(Area.Width, Area.Height)));
      else
    end case;
  end for;

  Flush<TMsg>(Pending, Post);
end procedure;

end unit;
