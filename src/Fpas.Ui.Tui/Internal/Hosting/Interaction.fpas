// [Documentation](../../../../docs/ui/tui/host.md#input-and-controlled-state)

unit Fpas.Ui.Tui.Internal.Hosting.Interaction;

uses Fpas.Ui.Tui.Internal.Hosting.KeyRouting as KeyRoutes, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Widgets.Collections.SelectionList as SelectionList, Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit, Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit, Fpas.Ui.Tui.Internal.Rendering.Glyphs as Glyphs, Fpas.Ui.TerminalExtensions.CellGrids as Grids, Fpas.Ui.Tui.Internal.Hosting.RowNavigation as Navigation, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Tui.Application as App, Fpas.Ui.Tui.Internal.Layout.Scene as A, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Controls.Activation as Actions, Fpas.Ui.Tui.Internal.Layout.ScrollViews as V, Fpas.Ui.Tui.Internal.Hosting.ScrollNavigation as Scrolling, System as Sys, System.Collections.Generic as Generic;

// Owner-thread interaction state used to route input against a presented scene.
// ## Type parameters
// - `TMsg`: Application message type.
public type State<TMsg> = record
  // Reads the focused control ID, or empty when focus is unset.
  public FocusId: function(): string;
  // Reads the control under the pointer, or empty when no control is eligible.
  public HoverId: function(): string;
  // Reads the active overlay scope, or empty for the base view.
  public ScopeId: function(): string;
  // Updates focus and pointer capture for the next scene using its predecessor.
  public Reconcile: procedure(A.Layout<TMsg>, A.Layout<TMsg>?);
  // Requests focus for a stable control ID in the scene.
  public SetFocus: procedure(A.Layout<TMsg>, string);
  // Invokes the eligible control with the requested ID.
  public Activate: procedure(A.Layout<TMsg>, string);
  // Routes a complete click at the specified cell.
  public Click: procedure(A.Layout<TMsg>, K.MouseButton, int, int);
  // Routes a pointer event.
  public Pointer: procedure(A.Layout<TMsg>, K.PointerKind, K.MouseButton, int, int);
  // Routes a scroll delta at the pointer cell.
  public Scroll: procedure(A.Layout<TMsg>, int, int, int);
  // Handles a terminal key with its modifier state.
  public Key: procedure(A.Layout<TMsg>, K.Key, K.KeyModifiers);
  // Routes text to the editor and permits character shortcuts for typed input.
  public Insert: procedure(A.Layout<TMsg>, string, bool);
end record;

// Starts focus, pointer capture and input routing for one terminal session.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Apply`: Dispatches messages proposed by interactive controls.
// - `ScrollOffsets`: Session scroll offsets keyed by viewport ID.
// ## Returns
// The handlers and queries backed by the new session state.
public function Create<TMsg>(Apply: procedure(TMsg); ScrollOffsets: Generic.Dictionary<string, int>): State<TMsg>;
  function ActiveId(Layout: A.Layout<TMsg>): string;
  begin
    const Active: A.Scope<TMsg>? := Layout.Active;
    if Active <> null then
      return Active.Id;
    end if;

    return '';
  end function;

  function Eligible(Control: A.Control<TMsg>; Scope: string): bool;
  begin
    return Control.Enabled and Control.Scope = Scope;
  end function;

  function RetainCapture(Layout: A.Layout<TMsg>; Id: string; Scope: string): string;
  begin
    if Id = '' then
      return '';
    end if;
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
    return if Control <> null and Eligible(Control, Scope) then
      Id
    else
      ''
    end if;
  end function;

  procedure SetFocus(Layout: A.Layout<TMsg>; Id: string);
  begin
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
    if Control <> null and Eligible(Control, FocusScope) then
      Focus := Control.Id;
    elsif Control = null and Navigation.CanFocusOffscreen<TMsg>(Layout, Id, FocusScope) then
      MoveFocus(Layout, Id);
    end if;
  end procedure;

  function Invoke(Control: A.Control<TMsg>): bool;
  begin
    case Control.Action of
      when A.Binding.SelectionList(const List: E.SelectionListView<TMsg>, _, _):
        SelectionList.Activate<TMsg>(List, Apply);
        return true;
      else
    end case;

    const Handler: Actions.IActivatable<TMsg>? := A.Activatable<TMsg>(Control.Action);
    if Handler = null then
      return false;
    end if;

    if Control.Role = 'select' or Control.Role = 'multi-select' or Control.Role = 'menu' then
      Focus := Control.Id;
    end if;

    Actions.Dispatch<TMsg>(Handler.Activate(), Apply);

    return true;
  end function;

  procedure ReconcileFocus(Layout: A.Layout<TMsg>; Previous: A.Layout<TMsg>?);
    function Restore(Id: string; Scope: string): bool;
    begin
      if Id = '' then
        return false;
      end if;
      const Candidate: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
      if Candidate <> null and Eligible(Candidate, Scope) then
        Focus := Id;
        return true;
      elsif Candidate = null and Navigation.CanFocusOffscreen<TMsg>(Layout, Id, Scope) then
        Focus := Id;
        return true;
      end if;

      return false;
    end function;
  begin
    const Scope: string := ActiveId(Layout);
    Captured := RetainCapture(Layout, Captured, Scope);
    MiddleCaptured := RetainCapture(Layout, MiddleCaptured, Scope);
    if Previous <> null then
      for Id: string in Previous.Scopes do
        if Sys.Array.IndexOf<string>(Layout.Scopes, Id) < 0 then
          discard Saved.Remove(Id);
        end if;
      end for;
    end if;

    const ChangedScope: bool := Scope <> FocusScope;
    if ChangedScope then
      Captured := '';
      MiddleCaptured := '';
      CapturedScrim := false;
      Hover := '';
      // Remember a scope's own focus only while the scope remains open.
      if FocusScope = '' or Sys.Array.IndexOf<string>(Layout.Scopes, FocusScope) >= 0 then
        Saved[FocusScope] := Focus;
      end if;

      if not Saved.TryGetValue(Scope, out Focus) then
        const Modal: A.Scope<TMsg>? := Layout.Active;
        Focus := if Modal = null then
          ''
        else
          Modal.Initial
        end if;
      end if;

      FocusScope := Scope;
    end if;

    if PointerKnown then
      const Target: A.Control<TMsg>? := Hit(Layout, PointerColumn, PointerRow);
      Hover := if Target = null then
        ''
      else
        Target.Id
      end if;
    end if;

    const Layer: A.Scope<TMsg>? := Layout.Active;
    if Layer <> null and Layer.LocalInput <> null then
      Focus := Layer.Initial;
      return;
    end if;

    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, Scope) and Control.Id = Focus then
        return;
      end if;
    end for;

    if ChangedScope and Navigation.CanFocusOffscreen<TMsg>(Layout, Focus, Scope) then
      return;
    end if;

    var Old: A.Control<TMsg>? := A.FindControl<TMsg>(Previous, Focus);
    const Seen: Generic.HashSet<string> := new Generic.HashSet<string>();
    while Old <> null and (Old.FocusReturn <> '' or Old.FocusReplacement <> '') and Seen.Add(
      Old.Id
    ) do
      if Restore(Old.FocusReplacement, Scope) or Restore(Old.FocusReturn, Scope) then
        return;
      end if;

      Old := A.FindControl<TMsg>(Previous, Old.FocusReturn);
    end while;

    Focus := Navigation.NextTab<TMsg>(Layout, Scope, '', false);
    if Previous <> null and A.FindControl<TMsg>(Layout, Focus) = null then
      // Manual scrolling can hide the selected row. Leave the viewport where the user put it.
      Focus := '';
      for Control: A.Control<TMsg> in Layout.Controls do
        if Eligible(Control, Scope) then
          Focus := Control.Id;
          return;
        end if;
      end for;
    end if;
  end procedure;

  procedure MoveFocus(Layout: A.Layout<TMsg>; Target: string);
  begin
    Focus := Target;
    if Target <> '' and A.FindControl<TMsg>(Layout, Target) = null then
      discard Navigation.Reveal<TMsg>(Layout, Target, ScrollOffsets, Apply);
    end if;
  end procedure;

  procedure Cycle(Layout: A.Layout<TMsg>; Backwards: bool);
  begin
    MoveFocus(Layout, Navigation.NextTab<TMsg>(Layout, FocusScope, Focus, Backwards));
  end procedure;

  function Focused(Layout: A.Layout<TMsg>): A.Control<TMsg>?;
  begin
    for Control: A.Control<TMsg> in Layout.Controls do
      if Control.Id = Focus and Eligible(Control, FocusScope) then
        return Control;
      end if;
    end for;

    return null;
  end function;

  function Hit(Layout: A.Layout<TMsg>; Column: int; Row: int): A.Control<TMsg>?;
  begin
    for Index: int := Layout.Controls.Length - 1 downto 0 do
      const Control: A.Control<TMsg> := Layout.Controls[Index];
      if Control.Scope = FocusScope and Control.Bounds.Contains(Column, Row) then
        if Control.Enabled then
          return Control;
        end if;

        return null;
      end if;
    end for;

    return null;
  end function;

  function OnScrim(Layout: A.Layout<TMsg>; Column: int; Row: int): bool;
  begin
    const Modal: A.Scope<TMsg>? := Layout.Active;
    if Modal = null or Row < 0 or Row >= Layout.Lines.Length or Column < 0
      or Column >= Layout.Cells.Length div Layout.Lines.Length
    then
      return false;
    end if;
    const Panel: F.Rect? := Modal.Panel;
    return Panel <> null and not Panel.Contains(Column, Row);
  end function;

  function Dismiss(Modal: A.Scope<TMsg>?): bool;
  begin
    if Modal <> null then
      case Modal.LocalInput of
        when is Sys.Func<App.Input, bool> as Popup:
          return Popup.Invoke(App.Input.KeyPress(K.Key.Escape, K.KeyModifiers.None));
        else
      end case;

      case Modal.Escape of
        when is Sys.Func<TMsg> as Callback:
          Apply(Callback.Invoke());
          return true;
        else
      end case;
    end if;

    return false;
  end function;

  procedure ClickAt(Layout: A.Layout<TMsg>; Button: K.MouseButton; Column: int; Row: int);
  begin
    PointerKnown := true;
    PointerColumn := Column;
    PointerRow := Row;
    if Button = K.MouseButton.Left and OnScrim(Layout, Column, Row) then
      discard Dismiss(Layout.Active);
      return;
    end if;
    const Control: A.Control<TMsg>? := Hit(Layout, Column, Row);
    if Control = null then
      return;
    end if;

    if Button = K.MouseButton.Left then
      Focus := Control.Id;
    end if;

    case Control.Action of
      when A.Binding.SelectionList(
        const List: E.SelectionListView<TMsg>,
        const Body: F.Rect,
        const View: V.Viewport<TMsg>
      ):
        if Button = K.MouseButton.Left then
          SelectionList.Click<TMsg>(List, Body, View.Offset, Column, Row, Apply);
        end if;
      when A.Binding.EditArea(const Area: AreaEdit.View<TMsg>, _, _):
        if Button = K.MouseButton.Left then
          AreaEdit.Click<TMsg>(Area, Column, Row);
        end if;
      when A.Binding.Edit(
        const Field: Edit.Field<TMsg>,
        const Position: Edit.Tracking,
        const Origin: int,
        _
      ):
        if Button = K.MouseButton.Left then
          const Cursor: Edit.Cursor := Position.Read(Field.Value);
          const Clicked: int := Glyphs.IndexAt(
            Field.Value.Substring(Cursor.Start),
            0,
            Column - Origin
          );
          Position.Write(
            Cursor with
              Offset := Cursor.Start + Clicked;
              Anchor := -1;
            end with
          );
        end if;
      when A.Binding.Grid(const Area: F.Rect, const Changed: function(Grids.Event): TMsg):
        Apply(Changed(Grids.Event.Clicked(Column - Area.X, Row - Area.Y, Button)));
      else
        if Button = K.MouseButton.Left then
          discard Invoke(Control);
        end if;
    end case;
  end procedure;

  procedure Point(Layout: A.Layout<TMsg>; Kind: K.PointerKind; Button: K.MouseButton; Column: int; Row: int);
  begin
    PointerKnown := true;
    PointerColumn := Column;
    PointerRow := Row;
    const Target: A.Control<TMsg>? := Hit(Layout, Column, Row);
    Hover := if Target = null then
      ''
    else
      Target.Id
    end if;
    case Kind of
      when K.PointerKind.Press:
        if Button = K.MouseButton.Left then
          CapturedScrim := OnScrim(Layout, Column, Row);
          Captured := Hover;
          if Captured <> '' then
            Focus := Captured;
          end if;
        else
          MiddleCaptured := Hover;
        end if;
      when K.PointerKind.Release:
        if Button = K.MouseButton.Left then
          const WasScrim: bool := CapturedScrim;
          CapturedScrim := false;
          if WasScrim and OnScrim(Layout, Column, Row) then
            discard Dismiss(Layout.Active);
            return;
          end if;
        end if;
        const Held: string := if Button = K.MouseButton.Left then
          Captured
        else
          MiddleCaptured
        end if;
        if Button = K.MouseButton.Left then
          Captured := '';
        else
          MiddleCaptured := '';
        end if;

        if Held <> '' and Held = Hover then
          ClickAt(Layout, Button, Column, Row);
        end if;
      else
    end case;
  end procedure;

  procedure RouteKey(Layout: A.Layout<TMsg>; Key: K.Key; Modifiers: K.KeyModifiers);
  begin
    KeyRoutes.Route<TMsg>(
      Layout, Focused(Layout), Key, Modifiers, ScrollOffsets, Apply, SetFocus,
      procedure(Target: string) begin
        Focus := Target;
      end procedure,
      Invoke, Dismiss, Cycle
    );
  end procedure;

  procedure Activate(Layout: A.Layout<TMsg>; Id: string);
  begin
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
    if Control <> null and Eligible(Control, FocusScope) then
      discard Invoke(Control);
    end if;
  end procedure;

  procedure ScrollAt(Layout: A.Layout<TMsg>; Column: int; Row: int; Delta: int);
  begin
    PointerKnown := true;
    PointerColumn := Column;
    PointerRow := Row;
    Scrolling.Wheel<TMsg>(
      Layout,
      Hit(Layout, Column, Row),
      FocusScope,
      Column,
      Row,
      Delta,
      ScrollOffsets,
      Apply
    );
  end procedure;

  procedure Insert(Layout: A.Layout<TMsg>; Text: string; Typed: bool);
  begin
    const Control: A.Control<TMsg>? := Focused(Layout);
    if Control <> null then
      case Control.Action of
        when A.Binding.EditArea(const Area: AreaEdit.View<TMsg>, _, _):
          AreaEdit.Insert<TMsg>(Area, Text, Apply);
          return;
        when A.Binding.Edit(const Field: Edit.Field<TMsg>, const Position: Edit.Tracking, _, _):
          Edit.Insert<TMsg>(Field, Position, Text, Apply);
          return;
        else
      end case;

      if Typed and Text = ' ' then
        case Control.Action of
          when A.Binding.Invoke(_):
            discard Invoke(Control);
            return;
          else
        end case;
      end if;
    end if;

    if Typed and Text <> '' then
      const Modal: A.Scope<TMsg>? := Layout.Active;
      const Keys: array of K.ShortcutBinding<TMsg> := if Modal = null then
        Layout.GlobalKeys
      else
        Modal.Shortcuts
      end if;
      for Shortcut: K.ShortcutBinding<TMsg> in Keys do
        if Shortcut.Character = Text then
          Apply(Shortcut.Message);
          return;
        end if;
      end for;
    end if;
  end procedure;
begin
  const Saved: Generic.Dictionary<string, string> := new Generic.Dictionary<string, string>();
  var Focus: string := '';
  var Hover: string := '';
  var PointerKnown: bool := false;
  var PointerColumn: int := 0;
  var PointerRow: int := 0;
  var Captured: string := '';
  var CapturedScrim: bool := false;
  var MiddleCaptured: string := '';
  var FocusScope: string := '';
  return new State<TMsg>(
    function(): string => Focus, function(): string => Hover, function(): string => FocusScope,
    ReconcileFocus, SetFocus, Activate, ClickAt, Point, ScrollAt, RouteKey, Insert
  );
end function;

end unit;
