unit Fpas.Ui.Tui.Internal.Hosting.Interaction;

uses Fpas.Ui.Tui.Internal.Widgets.Actions.HoldButton as Hold, Fpas.Ui.Widgets.Developer.Terminal as T, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Tui.Application as App, Fpas.Ui.Tui.Internal.Layout.Scene as A, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Controls.Activation as Actions, Fpas.Ui.Tui.Internal.Layout.ScrollViews as V, Fpas.Ui.Tui.Internal.Hosting.ScrollNavigation as Scrolling, System as Sys, System.Collections.Generic as Generic;

public type State<TMsg> = record
  public FocusId: function(): string;
  public HoverId: function(): string;
  public ScopeId: function(): string;
  public Reconcile: procedure(A.Layout<TMsg>, A.Layout<TMsg>?);
  public SetFocus: procedure(A.Layout<TMsg>, string);
  public Activate: procedure(A.Layout<TMsg>, string);
  public Click: procedure(A.Layout<TMsg>, K.MouseButton, int, int);
  // Routes a pointer event and its admission timestamp.
  public Pointer: procedure(A.Layout<TMsg>, K.PointerKind, K.MouseButton, int, int, long);
  public Scroll: procedure(A.Layout<TMsg>, int, int, int);
  public Key: procedure(A.Layout<TMsg>, K.Key, K.KeyModifiers);
  public Insert: procedure(A.Layout<TMsg>, string, bool);
end record;

public function Create<TMsg>(Apply: procedure(TMsg); ScrollOffsets: Generic.Dictionary<string, int>; HoldTracking: Hold.State): State<TMsg>;
  function ActiveId(Layout: A.Layout<TMsg>): string;
  begin
    const Active: A.Scope<TMsg>? := Layout.Active;
    if Active <> null then
      return Active.Id;
    end if;

    return '';
  end function;

  function Eligible(Control: A.Control<TMsg>; Scope: string): bool;
  begin
    return Control.Enabled and Control.Scope = Scope;
  end function;

  function RetainCapture(Layout: A.Layout<TMsg>; Id: string; Scope: string): string;
  begin
    if Id = '' then
      return '';
    end if;
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
    return if Control <> null and Eligible(Control, Scope) then
      Id
    else
      ''
    end if;
  end function;

  procedure SetFocus(Layout: A.Layout<TMsg>; Id: string);
  begin
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
    if Control <> null and Eligible(Control, FocusScope) then
      Focus := Control.Id;
    end if;
  end procedure;

  function Invoke(Control: A.Control<TMsg>; ConfirmedHold: bool := false): bool;
  begin
    if Control.HoldMilliseconds > 0 and not ConfirmedHold then
      return true;
    end if;

    const Handler: Actions.IActivatable<TMsg>? := A.Activatable<TMsg>(Control.Action);
    if Handler = null then
      return false;
    end if;

    case Handler.Activate() of
      when Actions.Result.Send(const Message: TMsg):
        Apply(Message);
      when Actions.Result.NoAction:
    end case;

    return true;
  end function;

  procedure ReconcileFocus(Layout: A.Layout<TMsg>; Previous: A.Layout<TMsg>?);
  begin
    const Scope: string := ActiveId(Layout);
    Captured := RetainCapture(Layout, Captured, Scope);
    MiddleCaptured := RetainCapture(Layout, MiddleCaptured, Scope);
    const HeldId: string := HoldTracking.ActiveId();
    if HeldId <> '' then
      const Target: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, HeldId);
      const Before: A.Control<TMsg>? := A.FindControl<TMsg>(Previous, HeldId);
      if Target = null or Before = null or not Eligible(Target, Scope)
        or Target.Bounds <> Before.Bounds or Target.HoldMilliseconds <> Before.HoldMilliseconds
      then
        HoldTracking.Cancel();
      end if;
    end if;

    if Scope <> FocusScope then
      HoldTracking.Cancel();
      Captured := '';
      MiddleCaptured := '';
      CapturedScrim := false;
      Hover := '';
      if FocusScope <> '' and Saved.ContainsKey(
        FocusScope
      ) and (Scope = '' or Saved.ContainsKey(Scope))
      then
        Focus := Saved[FocusScope];
        discard Saved.Remove(FocusScope);
      else
        if Scope <> '' then
          Saved[Scope] := Focus;
        end if;
        const Modal: A.Scope<TMsg>? := Layout.Active;
        Focus := if Modal = null then
          ''
        else
          Modal.Initial
        end if;
      end if;

      FocusScope := Scope;
    end if;

    if PointerKnown then
      const Target: A.Control<TMsg>? := Hit(Layout, PointerColumn, PointerRow);
      Hover := if Target = null then
        ''
      else
        Target.Id
      end if;
    end if;

    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, Scope) and Control.Id = Focus then
        return;
      end if;
    end for;

    var Old: A.Control<TMsg>? := A.FindControl<TMsg>(Previous, Focus);
    while Old <> null and Old.FocusReturn <> '' do
      const Parent: string := Old.FocusReturn;
      const Candidate: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Parent);
      if Candidate <> null and Eligible(Candidate, Scope) then
        Focus := Candidate.Id;
        return;
      end if;

      Old := A.FindControl<TMsg>(Previous, Parent);
    end while;

    Focus := '';
    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, Scope) then
        Focus := Control.Id;
        return;
      end if;
    end for;
  end procedure;

  procedure Cycle(Layout: A.Layout<TMsg>; Backwards: bool);
  begin
    const Keys: Generic.List<string> := new Generic.List<string>();
    var Index: int := 0;
    for Control: A.Control<TMsg> in Layout.Controls do
      if Eligible(Control, FocusScope) then
        if Control.Id = Focus then
          Index := Keys.Count;
        end if;

        Keys.Add(Control.Id);
      end if;
    end for;

    if Keys.Count > 0 then
      Focus := Keys[
        (Index + (if Backwards then
          Keys.Count - 1
        else
          1
        end if)) mod Keys.Count
      ];
    end if;
  end procedure;

  function Focused(Layout: A.Layout<TMsg>): A.Control<TMsg>?;
  begin
    for Control: A.Control<TMsg> in Layout.Controls do
      if Control.Id = Focus and Eligible(Control, FocusScope) then
        return Control;
      end if;
    end for;

    return null;
  end function;

  function Hit(Layout: A.Layout<TMsg>; Column: int; Row: int): A.Control<TMsg>?;
  begin
    for Index: int := Layout.Controls.Length - 1 downto 0 do
      const Control: A.Control<TMsg> := Layout.Controls[Index];
      if Control.Scope = FocusScope and Control.Bounds.Contains(Column, Row) then
        if Control.Enabled then
          return Control;
        end if;

        return null;
      end if;
    end for;

    return null;
  end function;

  function OnScrim(Layout: A.Layout<TMsg>; Column: int; Row: int): bool;
  begin
    const Modal: A.Scope<TMsg>? := Layout.Active;
    if Modal = null or Row < 0 or Row >= Layout.Lines.Length or Column < 0
      or Column >= Layout.Cells.Length div Layout.Lines.Length
    then
      return false;
    end if;
    const Panel: F.Rect? := Modal.Panel;
    return Panel <> null and not Panel.Contains(Column, Row);
  end function;

  function Dismiss(Modal: A.Scope<TMsg>?): bool;
  begin
    if Modal <> null then
      case Modal.Dismiss of
        when is Sys.Action as Close:
          Close.Invoke();
          return true;
        else
      end case;

      case Modal.Escape of
        when is Sys.Func<TMsg> as Callback:
          Apply(Callback.Invoke());
          return true;
        else
      end case;
    end if;

    return false;
  end function;

  procedure ClickAt(Layout: A.Layout<TMsg>; Button: K.MouseButton; Column: int; Row: int);
  begin
    PointerKnown := true;
    PointerColumn := Column;
    PointerRow := Row;
    if Button = K.MouseButton.Left and OnScrim(Layout, Column, Row) then
      discard Dismiss(Layout.Active);
      return;
    end if;
    const Control: A.Control<TMsg>? := Hit(Layout, Column, Row);
    if Control = null or Button = K.MouseButton.Middle then
      return;
    end if;

    Focus := Control.Id;
    case Control.Action of
      when A.Binding.Invoke(_):
        discard Invoke(Control);
      when A.Binding.Scroll(_):
    end case;
  end procedure;

  procedure Point(Layout: A.Layout<TMsg>; Kind: K.PointerKind; Button: K.MouseButton; Column: int; Row: int; ReceivedAt: long);
  begin
    PointerKnown := true;
    PointerColumn := Column;
    PointerRow := Row;
    const Target: A.Control<TMsg>? := Hit(Layout, Column, Row);
    Hover := if Target = null then
      ''
    else
      Target.Id
    end if;
    if HoldTracking.ActiveId() <> Hover then
      HoldTracking.Cancel();
    end if;

    case Kind of
      when K.PointerKind.Press:
        if Button = K.MouseButton.Left then
          CapturedScrim := OnScrim(Layout, Column, Row);
          Captured := Hover;
          if Captured <> '' then
            Focus := Captured;
          end if;

          HoldTracking.Cancel();
          if Target <> null and Target.HoldMilliseconds > 0 then
            HoldTracking.Press(Target.Id, Target.HoldMilliseconds, ReceivedAt);
          end if;
        else
          MiddleCaptured := Hover;
        end if;
      when K.PointerKind.Release:
        if Button = K.MouseButton.Left then
          if Target <> null and Target.HoldMilliseconds > 0
            and HoldTracking.Release(Target.Id, Target.HoldMilliseconds, ReceivedAt)
          then
            Captured := '';
            discard Invoke(Target, true);
            return;
          end if;

          HoldTracking.Cancel();
          const WasScrim: bool := CapturedScrim;
          CapturedScrim := false;
          if WasScrim and OnScrim(Layout, Column, Row) then
            discard Dismiss(Layout.Active);
            return;
          end if;
        end if;
        const Held: string := if Button = K.MouseButton.Left then
          Captured
        else
          MiddleCaptured
        end if;
        if Button = K.MouseButton.Left then
          Captured := '';
        else
          MiddleCaptured := '';
        end if;

        if Held <> '' and Held = Hover then
          ClickAt(Layout, Button, Column, Row);
        end if;
      else
    end case;
  end procedure;

  procedure RouteKey(Layout: A.Layout<TMsg>; Key: K.Key; Modifiers: K.KeyModifiers);
  begin
    if Key = K.Key.Tab and (Modifiers = K.KeyModifiers.None or Modifiers =
      K.KeyModifiers.Shift)
    then
      Cycle(Layout, Modifiers = K.KeyModifiers.Shift);
      return;
    end if;
    const Modal: A.Scope<TMsg>? := Layout.Active;
    const Control: A.Control<TMsg>? := Focused(Layout);
    if Key = K.Key.Escape then
      if Dismiss(Modal) then
        return;
      end if;
    end if;

    if Control <> null then
      if (Key = K.Key.Left or Key = K.Key.Right) and Modifiers = K.KeyModifiers.None then
        const Handler: Actions.IActivatable<TMsg>? := A.Activatable<TMsg>(Control.Action);
        case Handler of
          when is Actions.IArrowFocus as Arrows:
            const Id: string? := Arrows.Neighbor(
              if Key = K.Key.Left then
                -1
              else
                1
              end if
            );
            if Id <> null then
              const Target: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
              if Target <> null and Eligible(Target, FocusScope) then
                Focus := Target.Id;
                discard Invoke(Target);
              end if;
            end if;

            return;
          else
        end case;
      end if;

      if (Control.Role = 'split-menu' or Control.Role = 'menu') and Key = K.Key.Down and Modifiers =
        K.KeyModifiers.None
      then
        discard Invoke(Control);
        return;
      end if;

      if Key = K.Key.Enter and Modifiers = K.KeyModifiers.None and Invoke(Control) then
        return;
      end if;

      case Control.Action of
        when A.Binding.Invoke(_):
          if Control.ArrowFocus and (Key = K.Key.Up or Key = K.Key.Down) then
            Cycle(Layout, Key = K.Key.Up);
            return;
          end if;
        when A.Binding.Scroll(const View: V.Viewport<TMsg>):
          if Scrolling.Key<TMsg>(View, Key, Modifiers, Apply) then
            return;
          end if;
      end case;
    end if;

    if Modal <> null and Modal.Panel <> null and Modifiers = K.KeyModifiers.None
      and (Key = K.Key.PageUp or Key = K.Key.PageDown)
    then
      for Region: A.ScrollRegion in Layout.Regions do
        if Region.Id = Modal.Id and Region.Scope = Modal.Id then
          MoveScroll(
            Region,
            if Key = K.Key.PageUp then
              -Region.Bounds.Height
            else
              Region.Bounds.Height
            end if
          );
          return;
        end if;
      end for;
    end if;
    const Keys: array of K.ShortcutBinding<TMsg> := if Modal = null then
      Layout.GlobalKeys
    else
      Modal.Shortcuts
    end if;
    for Shortcut: K.ShortcutBinding<TMsg> in Keys do
      if Shortcut.Character = '' and Shortcut.PressedKey = Key and Shortcut.Modifiers =
        Modifiers
      then
        Apply(Shortcut.Message);
        return;
      end if;
    end for;
  end procedure;

  procedure Activate(Layout: A.Layout<TMsg>; Id: string);
  begin
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Id);
    if Control <> null and Eligible(Control, FocusScope) then
      discard Invoke(Control);
    end if;
  end procedure;

  procedure MoveScroll(Region: A.ScrollRegion; Delta: int);
  begin
    const Before: int := if ScrollOffsets.ContainsKey(Region.Id) then
      ScrollOffsets[Region.Id]
    else
      0
    end if;
    ScrollOffsets[Region.Id] := cast<int>(Sys.Math.Clamp(
      cast<long>(Before) + cast<long>(Delta), 0L, cast<long>(Region.Maximum)
    ));
  end procedure;

  procedure ScrollAt(Layout: A.Layout<TMsg>; Column: int; Row: int; Delta: int);
  begin
    PointerKnown := true;
    PointerColumn := Column;
    PointerRow := Row;
    for Index: int := Layout.Regions.Length - 1 downto 0 do
      const Region: A.ScrollRegion := Layout.Regions[Index];
      if Region.Scope = FocusScope and Region.Bounds.Contains(Column, Row) then
        if Region.Controlled then
          const Target: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Region.Id);
          if Target <> null then
            case Target.Action of
              when A.Binding.Scroll(const View: V.Viewport<TMsg>):
                Scrolling.Move<TMsg>(View, Delta, Apply);
              else
            end case;
          end if;

          return;
        end if;

        MoveScroll(Region, Delta);
        return;
      end if;
    end for;
  end procedure;

  procedure Insert(Layout: A.Layout<TMsg>; Text: string; Typed: bool);
  begin
    const Control: A.Control<TMsg>? := Focused(Layout);
    if Control <> null then
      if Typed and Text = ' ' then
        case Control.Action of
          when A.Binding.Invoke(_):
            discard Invoke(Control);
            return;
          else
        end case;
      end if;
    end if;

    if Typed and Text <> '' then
      const Modal: A.Scope<TMsg>? := Layout.Active;
      const Keys: array of K.ShortcutBinding<TMsg> := if Modal = null then
        Layout.GlobalKeys
      else
        Modal.Shortcuts
      end if;
      for Shortcut: K.ShortcutBinding<TMsg> in Keys do
        if Shortcut.Character = Text then
          Apply(Shortcut.Message);
          return;
        end if;
      end for;
    end if;
  end procedure;
begin
  const Saved: Generic.Dictionary<string, string> := new Generic.Dictionary<string, string>();
  var Focus: string := '';
  var Hover: string := '';
  var PointerKnown: bool := false;
  var PointerColumn: int := 0;
  var PointerRow: int := 0;
  var Captured: string := '';
  var CapturedScrim: bool := false;
  var MiddleCaptured: string := '';
  var FocusScope: string := '';
  return new State<TMsg>(
    function(): string => Focus, function(): string => Hover, function(): string => FocusScope,
    ReconcileFocus, SetFocus, Activate, ClickAt, Point, ScrollAt, RouteKey, Insert
  );
end function;

// Routes an admitted input against the currently presented layout.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Routing`: Session's input router.
// - `Layout`: Presented controls and modal scope.
// - `Event`: Input to route.
// - `ReceivedAt`: Monotonic time at admission, in milliseconds.
public procedure Dispatch<TMsg>(Routing: State<TMsg>; Layout: A.Layout<TMsg>; Event: App.Input; ReceivedAt: long);
begin
  case Event of
    when App.Input.Focus(const Id: string):
      Routing.SetFocus(Layout, Id);
    when App.Input.Activate(const Id: string):
      Routing.Activate(Layout, Id);
    when App.Input.Click(const Column: int, const Row: int):
      Routing.Click(Layout, K.MouseButton.Left, Column, Row);
    when App.Input.ButtonClick(const Button: K.MouseButton, const Column: int, const Row: int):
      Routing.Click(Layout, Button, Column, Row);
    when App.Input.Pointer(const Kind: K.PointerKind, const Column: int, const Row: int):
      Routing.Pointer(Layout, Kind, K.MouseButton.Left, Column, Row, ReceivedAt);
    when App.Input.ButtonPointer(
      const Kind: K.PointerKind,
      const Button: K.MouseButton,
      const Column: int,
      const Row: int
    ):
      Routing.Pointer(Layout, Kind, Button, Column, Row, ReceivedAt);
    when App.Input.Scroll(const Column: int, const Row: int, const Delta: int):
      Routing.Scroll(Layout, Column, Row, Delta);
    when App.Input.KeyPress(const Key: K.Key, const Modifiers: K.KeyModifiers):
      Routing.Key(Layout, Key, Modifiers);
    when App.Input.Character(const Text: string):
      Routing.Insert(Layout, Text, true);
    when App.Input.TextInput(const Text: string), App.Input.Paste(const Text: string):
      Routing.Insert(Layout, Text, false);
    when App.Input.Resize(_, _):
  end case;
end procedure;

end unit;
