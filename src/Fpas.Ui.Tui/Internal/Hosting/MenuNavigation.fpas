unit Fpas.Ui.Tui.Internal.Hosting.MenuNavigation;

uses Fpas.Ui.Tui.Internal.Layout.Scene as A, System as Sys, System.Collections.Generic as Lists;

// Moves through every enabled popup command and scrolls its target into view.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Layout`: Presented popup navigation stops and scroll viewport.
// - `Current`: Currently focused command identity.
// - `Backwards`: Selects the preceding command instead of the following one.
// - `Offsets`: Session-owned scroll offsets updated to reveal the target.
// ## Returns
// The next command identity, or null when the active scope has no popup commands.
public function Move<TMsg>(
  Layout: A.Layout<TMsg>; Current: string; Backwards: bool; Offsets: Lists.Dictionary<string, int>
): string?;
begin
  const Active: A.Scope<TMsg>? := Layout.Active;
  if Active = null or Active.Navigation.Length = 0 then
    return null;
  end if;

  const Stops: array of A.NavigationStop := Active.Navigation;
  var At: int := -1;
  for Index: int := 0 to Stops.Length - 1 do
    if Stops[Index].Id = Current then
      At := Index;
      break;
    end if;
  end for;

  const Next: int := if At < 0 then
    if Backwards then
      Stops.Length - 1
    else
      0
    end if
  else
    (At + (if Backwards then
      Stops.Length - 1
    else
      1
    end if)) mod Stops.Length
  end if;
  const Target: A.NavigationStop := Stops[Next];
  for Region: A.ScrollRegion in Layout.Regions do
    if Region.Id = Active.Id and Region.Scope = Active.Id then
      const Before: int := if Offsets.ContainsKey(Active.Id) then
        Offsets[Active.Id]
      else
        0
      end if;
      const Delta: int := if Target.Bounds.Y < Region.Bounds.Y then
        Target.Bounds.Y - Region.Bounds.Y
      else
        Sys.Math.Max(
          0,
          Target.Bounds.Y + Target.Bounds.Height - Region.Bounds.Y - Region.Bounds.Height
        )
      end if;
      Offsets[Active.Id] := cast<int>(Sys.Math.Clamp(
        cast<long>(Before) + Delta, 0L, cast<long>(Region.Maximum)
      ));
      break;
    end if;
  end for;

  return Target.Id;
end function;

end unit;
