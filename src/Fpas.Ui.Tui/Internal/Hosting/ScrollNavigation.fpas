// [Documentation](../../../../docs/ui/tui/layout/scroll-view.md)

unit Fpas.Ui.Tui.Internal.Hosting.ScrollNavigation;

uses Fpas.Ui.Layout as L;
uses Fpas.Ui.TerminalExtensions.CellGrids as Grids;
uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Layout.Scene as A;
uses Fpas.Ui.Tui.Internal.Layout.ScrollViews as V;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit;

uses System as Sys;
uses System.Collections.Generic as C;

procedure Notify of TMsg(
  View: V.Viewport of TMsg;
  Position: L.ScrollPosition;
  Offset: int;
  Apply: procedure(TMsg)
);
begin
  case View.OnScroll of
    when is Sys.Func of (L.ScrollChange, TMsg) as Callback:
      Apply(
        Callback.Invoke(
          new L.ScrollChange(Position, L.Measure.Cells(Offset), L.Measure.Cells(View.Maximum))
        )
      );
    else
  end case;
end procedure;

public procedure Move of TMsg(View: V.Viewport of TMsg; Delta: int; Apply: procedure(TMsg));
begin
  const Offset: int := cast Sys.Math.Clamp(
    cast View.Offset as long + cast Delta as long,
    0L,
    cast View.Maximum as long
  ) as int;
  if Offset <> View.Offset then
    Notify of TMsg(View, L.ScrollPosition.Offset(L.Measure.Cells(Offset)), Offset, Apply);
  end if;
end procedure;

public function Key of TMsg(
  View: V.Viewport of TMsg;
  Pressed: K.Key;
  Modifiers: K.KeyModifiers;
  Apply: procedure(TMsg)
): bool;
begin

  if Modifiers <> K.KeyModifiers.None then
    return false;
  end if;

  case Pressed of
    when K.Key.Up:
      Move of TMsg(View, -1, Apply);
    when K.Key.Down:
      Move of TMsg(View, 1, Apply);
    when K.Key.PageUp:
      Move of TMsg(View, -View.Rows, Apply);
    when K.Key.PageDown:
      Move of TMsg(View, View.Rows, Apply);
    when K.Key.Home:
      Move of TMsg(View, -View.Offset, Apply);
    when K.Key.End:
      if not View.Following then
        Notify of TMsg(View, L.ScrollPosition.End, View.Maximum, Apply);
      end if;
    else
      return false;
  end case;

  return true;
end function;

// Moves an unmanaged viewport within its scroll bounds.
// ## Parameters
// - `Offsets`: Host-owned scroll offsets.
// - `Region`: Viewport and its scroll limits.
// - `Delta`: Signed row movement.
public procedure MoveOffset(
  Offsets: C.Dictionary of (string, int);
  Region: A.ScrollRegion;
  Delta: int
);
begin
  var Before: int := 0;
  discard Offsets.TryGetValue(Region.Id, out Before);
  Offsets[Region.Id] := cast Sys.Math.Clamp(
    cast Before as long + Delta,
    0L,
    cast Region.Maximum as long
  ) as int;
end procedure;

// Routes the wheel to the active control or its enclosing viewport.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Layout`: Presented scroll regions and controls.
// - `Hit`: Topmost enabled control under the pointer.
// - `Scope`: Active focus scope.
// - `Column`: Pointer column.
// - `Row`: Pointer row.
// - `Delta`: Signed row movement.
// - `Offsets`: Host-owned scroll offsets.
// - `Apply`: Dispatches a proposed application change.
public procedure Wheel of TMsg(
  Layout: A.Layout of TMsg;
  Hit: (A.Control of TMsg)?;
  Scope: string;
  Column: int;
  Row: int;
  Delta: int;
  Offsets: C.Dictionary of (string, int);
  Apply: procedure(TMsg)
);
begin
  if Hit <> null then
    case Hit.Action of
      when A.Binding.EditArea(const Area: AreaEdit.View of TMsg, _, _):
        if AreaEdit.Scroll of TMsg(Area, Delta) then
          return;
        end if;
      when A.Binding.Grid(const Area: F.Rect, const Changed: function(Grids.Event): TMsg):
        Apply(Changed(Grids.Event.Wheel(Column - Area.X, Row - Area.Y, Delta)));
        return;
      else
    end case;
  end if;

  for Index: int := Layout.Regions.Length - 1 downto 0 do
    const Region: A.ScrollRegion := Layout.Regions[Index];
    if Region.Scope = Scope and Region.Bounds.Contains(Column, Row) then
      if Region.Controlled then
        const Target: (A.Control of TMsg)? := A.FindControl of TMsg(Layout, Region.Id);
        if Target <> null then
          case Target.Action of
            when A.Binding.Scroll(const View: V.Viewport of TMsg):
              Move of TMsg(View, Delta, Apply);
            else
          end case;
        end if;
      else
        MoveOffset(Offsets, Region, Delta);
      end if;

      return;
    end if;
  end for;
end procedure;

end unit;
