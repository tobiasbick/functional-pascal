// [Documentation](../../../../docs/ui/tui/host.md#application-lifecycle)

unit Fpas.Ui.Tui.Internal.Hosting.Session;

uses Fpas.Processes.Terminal as Terminal;
uses Fpas.Ui.Elements as Ui;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Mvu.Session as Runtime;
uses Fpas.Ui.Tui.Application as App;
uses Fpas.Ui.Tui.Internal.Hosting.ControlReplies as Replies;
uses Fpas.Ui.Tui.Internal.Hosting.GridNotifications as Grids;
uses Fpas.Ui.Tui.Internal.Hosting.InputDispatch as InputDispatch;
uses Fpas.Ui.Tui.Internal.Hosting.Interaction as I;
uses Fpas.Ui.Tui.Internal.Hosting.RowNavigation as Navigation;
uses Fpas.Ui.Tui.Internal.Layout.Arrangement as Arrangement;
uses Fpas.Ui.Tui.Internal.Layout.Equivalence as Q;
uses Fpas.Ui.Tui.Internal.Layout.Scene as A;
uses Fpas.Ui.Tui.Internal.Rendering.Decoration as D;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Lowering as Lower;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Tui.Internal.Widgets.Feedback.Alert as Alert;
uses Fpas.Ui.Tui.Internal.Widgets.Files.FilePickerState as PickerState;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.NumberField as Number;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.PopupState as PopupState;
uses Fpas.Ui.Validation as Validation;
uses Fpas.Ui.Widgets.Developer.Terminal as T;
uses Fpas.Ui.Widgets.Theming.Themes as SharedThemes;

uses System as Sys;
uses System.Collections.Generic as Generic;
uses System.Diagnostics as Diag;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

type PendingInput = record
  // The input receipt ID exposed by the terminal host.
  public Id: long;
  // The raw event to route against the presented layout.
  public Event: App.Input;
  // The control pipe's acknowledgement when the event came from a debugger.
  public Acknowledgement: Tasks.Task?;
end record;

type ViewSource of TMsg = record
  // Validated view and its shared cache for subsequent frames.
  public Prepared: Validation.Prepared of TMsg;
  // Lowered terminal view ready for arrangement.
  public Root: E.Element of TMsg;
  // Cell palette used to lower and paint this view.
  public Theme: Th.Theme;
end record;

procedure CheckSize(Columns: int; Rows: int);
begin
  if Columns < 1 or Columns > E.MaximumColumns or Rows < 1 or Rows > 300 then
    raise new Sys.ArgumentOutOfRangeException(
      'Terminal size must fit 1..500 columns and 1..300 rows.'
    );
  end if;
end procedure;

// Starts a terminal host around the shared MVU runtime.
//
// ## Type parameters
// - `TModel`: The application's model type.
// - `TMsg`: The application's message type.
//
// ## Parameters
// - `InitialModel`: The model before the first view.
// - `Update`: The application transition.
// - `View`: Builds elements for the current model and viewport.
// - `Columns`: Initial terminal width in cells.
// - `Rows`: Initial terminal height in cells.
// - `Present`: Publishes a successfully rendered frame.
// - `Manual`: Allows stepping through the control pipe.
// - `ThemeFor`: Selects the theme for the current model.
//
// ## Returns
// The host session.
public function Start of (TModel, TMsg)(
  InitialModel: TModel;
  Update: function(TModel, TMsg): Mvu.Transition of (TModel, TMsg);
  View: function(TModel, L.Viewport): Ui.Element of TMsg;
  Columns: int;
  Rows: int;
  Present: procedure(App.Frame);
  Manual: bool;
  ThemeFor: function(TModel): SharedThemes.Theme
): App.HeadlessSession;
  function Close(): Tasks.Task;
  begin
    Threads.Monitor.Enter(StepGate);
    try
      return Core.Close();
    finally
      Threads.Monitor.Exit(StepGate);
    end try;
  end function;

  function Enqueue(Event: App.Input; Acknowledgement: Tasks.Task?): App.Admission;
  begin
    case Event of
      when App.Input.Resize(const NewColumns: int, const NewRows: int):
        CheckSize(NewColumns, NewRows);
      else
    end case;

    Threads.Monitor.Enter(Gate);
    try
      const Id: long := InputId + 1L;
      case Core.Send(new PendingInput(Id, Event, Acknowledgement)) of
        when Runtime.Admission.Queued:
          InputId := Id;
          return App.Admission.Queued(Id);
        when Runtime.Admission.Full:
          return App.Admission.QueueFull;
        when Runtime.Admission.Closed:
          return App.Admission.Closed;
      end case;
    finally
      Threads.Monitor.Exit(Gate);
    end try;
  end function;

  function Send(Event: App.Input): App.Admission;
  begin
    return Enqueue(Event, null);
  end function;

  function ReadFrame(): App.Frame;
  begin
    Threads.Monitor.Enter(Gate);
    try
      const Value: App.Frame? := Published;
      if Value = null then
        raise new Sys.InvalidOperationException('No complete frame.');
      end if;

      return new App.Frame(
        Value.Id,
        Value.Columns,
        Value.Rows,
        cast Value.Lines.Clone() as array of string,
        cast Value.Cells.Clone() as array of T.Cell,
        cast Value.Controls.Clone() as array of App.ControlSnapshot
      );
    finally
      Threads.Monitor.Exit(Gate);
    end try;
  end function;

  function FindOutcome(Id: long): App.StepResult?;
  begin
    Threads.Monitor.Enter(Gate);
    try
      if Outcomes.ContainsKey(Id) then
        return Outcomes[Id];
      end if;

      return null;
    finally
      Threads.Monitor.Exit(Gate);
    end try;
  end function;

  async function Wait(Id: long; Timeout: Sys.TimeSpan): Tasks.Task of App.StepResult?;
  begin
    const Clock: Diag.Stopwatch := Diag.Stopwatch.StartNew();
    while true do
      const Outcome: App.StepResult? := FindOutcome(Id);
      if Outcome <> null then
        return Outcome;
      end if;

      if Clock.Elapsed >= Timeout then
        return null;
      end if;

      await Tasks.Task.Delay(5);
    end while;
  end function;

  procedure DisposeSession();
  begin
    try
      Close().GetAwaiter().GetResult();
    finally
      const Observer: Terminal.TuiControlConnection? := Connection;
      if Observer <> null then
        Observer.Dispose();
      end if;
    end try;
  end procedure;

  function PrepareView(Routing: I.State of TMsg): ViewSource of TMsg;
  begin
    Phase := 'view';
    const Theme: Th.Theme := Th.Resolve(ThemeFor(Core.Model()));
    const Size: L.Viewport := new L.Viewport(
      if Viewport.Columns < 60 then
        L.SizeClass.Compact
      elsif Viewport.Columns < 100 then
        L.SizeClass.Regular
      else
        L.SizeClass.Expanded
      end if,
      if Viewport.Rows < 20 then
        L.SizeClass.Compact
      elsif Viewport.Rows < 35 then
        L.SizeClass.Regular
      else
        L.SizeClass.Expanded
      end if,
      Viewport.Columns * 8, Viewport.Rows * 16
    );
    const Candidate: Validation.Prepared of TMsg := Validation.Prepare of TMsg(
      View(Core.Model(), Size),
      Validation.Target.Terminal,
      if Current = null then
        null
      else
        Current.Prepared
      end if,
      new T.Viewport(Viewport.Columns, Viewport.Rows)
    );
    Numbers.Retain(PendingFocus ?? Routing.FocusId());
    const Root: E.Element of TMsg := Lower.Prepare of TMsg(
      Candidate,
      Theme,
      Popup,
      Pickers,
      Viewport,
      Numbers,
      Alerts
    );
    return new ViewSource of TMsg(Candidate, Root, Theme);
  end function;

  function AnimationPhase(): long;
  begin
    return if Manual then
      0L
    else
      AnimationClock.ElapsedMilliseconds div 100L
    end if;
  end function;

  procedure Paint(AnimationOnly: bool := false);
  begin
    const Routing: (I.State of TMsg)? := Interaction;
    if Routing = null then
      raise new Sys.InvalidOperationException('Missing interaction state.');
    end if;

    const Cached: (ViewSource of TMsg)? := LastView;
    const Source: ViewSource of TMsg := if AnimationOnly and Cached <> null then
      Cached
    else
      PrepareView(Routing)
    end if;
    LastView := Source;
    const Theme: Th.Theme := Source.Theme;
    const Tick: long := AnimationPhase();
    LastAnimationPhase := Tick;
    Phase := 'layout_or_drawing';
    var Layout: A.Layout of TMsg := Arrangement.Arrange of TMsg(
      Source.Root,
      Viewport.Columns,
      Viewport.Rows,
      Current,
      ScrollOffsets,
      Theme, Popup, PendingFocus ?? Routing.FocusId(), Tick
    );
    Routing.Reconcile(Layout, Current);
    const Target: string? := PendingFocus;
    PendingFocus := null;
    const Entry: string := Target ?? Routing.FocusId();
    if Entry <> '' and A.FindControl of TMsg(Layout, Entry) = null and (Navigation.Reveal of TMsg(
      Layout,
      Entry,
      ScrollOffsets,
      Core.Dispatch,
      false
    )
      or Navigation.CanFocusOffscreen of TMsg(Layout, Entry, Routing.ScopeId()))
    then
      Layout := Arrangement.Arrange of TMsg(
        Source.Root,
        Viewport.Columns,
        Viewport.Rows,
        Layout,
        ScrollOffsets,
        Theme, Popup, Entry, Tick
      );
      Routing.Reconcile(Layout, Current);
    end if;

    Layout := Layout with
      Prepared := Source.Prepared;
    end with;
    if Target <> null then
      Routing.SetFocus(Layout, Target);
    end if;
    const Focus: string := Routing.FocusId();
    Numbers.Retain(Focus);
    const Hover: string := Routing.HoverId();
    const Controls: array of App.ControlSnapshot := D.Capture of TMsg(
      Layout, Viewport.Columns, Theme, Focus, Hover, Routing.ScopeId()
    );
    D.ShowHint of TMsg(Layout, Viewport.Columns, Theme, Hover, Routing.ScopeId());
    const Prior: App.Frame? := Published;
    const Before: (A.Layout of TMsg)? := Current;
    if Prior <> null and Before <> null and Prior.Columns = Viewport.Columns and Prior.Rows =
      Viewport.Rows
      and LastFocus = Focus and LastHover = Hover
      and Q.Equivalent of TMsg(Before, Layout)
    then
      Current := Layout;
      return;
    end if;
    const Value: App.Frame := new App.Frame(
      FrameId + 1L,
      Viewport.Columns,
      Viewport.Rows,
      Layout.Lines,
      Layout.Cells,
      Controls
    );
    Phase := 'presentation';
    Present(Value);
    const Observer: Terminal.TuiControlConnection? := Connection;
    if Observer <> null then
      Observer.Publish(Value);
    end if;

    Threads.Monitor.Enter(Gate);
    try
      FrameId := Value.Id;
      Published := Value;
      Current := Layout;
      LastFocus := Focus;
      LastHover := Hover;
    finally
      Threads.Monitor.Exit(Gate);
    end try;

    Grids.Presented of TMsg(Before, Layout, PendingSizes, Core.Post);
  end procedure;

  procedure Route(Entry: PendingInput);
  begin
    const Layout: (A.Layout of TMsg)? := Current;
    const Routing: (I.State of TMsg)? := Interaction;
    if Layout = null or Routing = null then
      return;
    end if;

    case Entry.Event of
      when App.Input.Resize(const NewColumns: int, const NewRows: int):
        Viewport := new T.Viewport(NewColumns, NewRows);
      else
        InputDispatch.Dispatch of TMsg(Routing, Layout, Entry.Event);
    end case;
  end procedure;

  function Step(): App.StepResult;
    function Report(Outcome: App.StepResult): App.StepResult;
    begin
      const Observer: Terminal.TuiControlConnection? := Connection;
      if Observer <> null then
        Observer.PublishOutcome(
          Replies.Describe(Outcome),
          Core.QueueCount(),
          Core.PendingEffects()
        );
      end if;

      return Outcome;
    end function;

    procedure Remember(Id: long; Outcome: App.StepResult);
    begin
      Threads.Monitor.Enter(Gate);
      try
        Outcomes[Id] := Outcome;
        OutcomeOrder.Enqueue(Id);
        if OutcomeOrder.Count > 256 then
          discard Outcomes.Remove(OutcomeOrder.Dequeue());
        end if;
      finally
        Threads.Monitor.Exit(Gate);
      end try;
    end procedure;
  begin
    var Processing: long := 0L;
    Threads.Monitor.Enter(StepGate);
    try
      Phase := 'update';
      const Advanced: Runtime.Step of PendingInput := Core.Advance();
      Grids.Flush of TMsg(PendingSizes, Core.Post);
      case Advanced of
        when Runtime.Step.Idle:
          const Layout: (A.Layout of TMsg)? := Current;
          if not Manual and Layout <> null and Layout.Animated and Core.IsOpen()
            and AnimationPhase() <> LastAnimationPhase
          then
            Paint(true);
          end if;

          return App.StepResult.Idle;
        when Runtime.Step.Input(const Entry: PendingInput):
          // A breakpoint in Update can stop every thread in the debuggee.
          const Receipt: Tasks.Task? := Entry.Acknowledgement;
          if Receipt <> null then
            Receipt.GetAwaiter().GetResult();
          end if;

          Processing := Entry.Id;
          const Before: long := FrameId;
          Route(Entry);
          if Core.IsOpen() then
            Paint();
          end if;
          const Outcome: App.StepResult := App.StepResult.Processed(
            Processing,
            FrameId,
            FrameId <> Before
          );
          Remember(Processing, Outcome);
          return Report(Outcome);
        when Runtime.Step.Updated:
          if Core.IsOpen() then
            Paint();
          end if;

          return Report(App.StepResult.EffectProcessed(FrameId));
        when Runtime.Step.Stale:
          return Report(App.StepResult.EffectProcessed(FrameId));
      end case;
    catch Error: Sys.Exception do
      discard Core.Close();
      const Failure: App.StepResult := App.StepResult.Failed(
        Processing,
        FrameId,
        Phase,
        Error.Message
      );
      if Processing > 0L then
        Remember(Processing, Failure);
      end if;

      return Report(Failure);
    finally
      Threads.Monitor.Exit(StepGate);
    end try;
  end function;
begin
  const Gate: Sys.Object := new Sys.Object();
  const StepGate: Sys.Object := new Sys.Object();
  const Outcomes: Generic.Dictionary of (long, App.StepResult) := new Generic.Dictionary of (long, App.StepResult)();
  const OutcomeOrder: Generic.Queue of long := new Generic.Queue of long();
  const PendingSizes: Generic.Queue of TMsg := new Generic.Queue of TMsg();
  const ScrollOffsets: Generic.Dictionary of (string, int) := new Generic.Dictionary of (string, int)();
  const Numbers: Number.State := Number.Start();
  const Alerts: Alert.State := new Alert.State();
  var PendingFocus: string? := null;
  var Viewport: T.Viewport := new T.Viewport(Columns, Rows);
  var Current: (A.Layout of TMsg)? := null;
  var LastView: (ViewSource of TMsg)? := null;
  const AnimationClock: Diag.Stopwatch := Diag.Stopwatch.StartNew();
  var LastAnimationPhase: long := 0L;
  var Published: App.Frame? := null;
  var FrameId: long := 0L;
  var InputId: long := 0L;
  var Phase: string := 'startup';
  var LastFocus: string := '';
  var LastHover: string := '';
  var Connection: Terminal.TuiControlConnection? := null;
  const Core: Runtime.Runtime of (TModel, TMsg, PendingInput) := Runtime.Start of (TModel, TMsg, PendingInput)(
    InitialModel, Update, procedure(Request: Mvu.HostRequest) begin
      case Request of
        when Mvu.HostRequest.Focus(const Id: string):
          PendingFocus := Id;
        when Mvu.HostRequest.Close:
        when Mvu.HostRequest.Extension(_):
          raise new Sys.NotSupportedException('This host request requires the graphical profile.');
      end case;
    end procedure, 64
  );
  const Popup: PopupState.State of TMsg := PopupState.Start of TMsg(Core.Dispatch);
  const Pickers: PickerState.State := PickerState.Start();
  const Interaction: I.State of TMsg := I.Create of TMsg(Core.Dispatch, ScrollOffsets);
  CheckSize(Columns, Rows);
  try
    Paint();
    if Core.IsOpen() then
      Connection := Terminal.TuiControlConnection.Open(
        function(Event: Terminal.TerminalInput): Terminal.TuiControlReply => Replies.Send(
          Event,
          Enqueue
        ),
        function(): Sys.Object => ReadFrame(),
        function(): Terminal.TuiControlReply => Replies.Describe(Step()),
        function(Id: long; Milliseconds: int): Tasks.Task of Terminal.TuiControlReply => Replies.Wait(
          Id,
          Milliseconds,
          Wait
        ),
        Core.WaitForWork,
        Core.WaitForSpace,
        Manual
      );
    end if;
  catch Error: Sys.Exception do
    try
      DisposeSession();
    catch Cleanup: Sys.Exception do
      raise new Sys.AggregateException('TUI startup and cleanup failed.', [Error, Cleanup]);
    end try;

    raise;
  end try;
  const Observer: Terminal.TuiControlConnection? := Connection;
  if Observer <> null then
    Observer.Publish(ReadFrame());
  end if;

  return App.HeadlessSession.Create(
    Send, Step, ReadFrame, Wait, Core.WaitForWork, Core.IsOpen, Close, DisposeSession
  );
end function;

end unit;
