unit Fpas.Ui.Tui.Internal.Hosting.Viewports;

uses Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Internal.Layout.Scene as A, Fpas.Ui.Tui.Internal.Layout.Flexible as F, System as Sys;

// Exact cell dimensions retained by the terminal host.
public type Dimensions = record
  // Terminal width in cells.
  public Columns: int;
  // Terminal height in cells.
  public Rows: int;
end record;

public function Notify<TMsg>(Before: A.Layout<TMsg>?; After: A.Layout<TMsg>; Apply: procedure(TMsg)): bool;
  function Send(Control: A.Control<TMsg>; Columns: int; Rows: int): bool;
  begin
    case Control.Action of
      when A.Binding.Canvas(_, _, const Events: T.CanvasEvents<TMsg>):
        const Changed: Sys.Func<int, int, TMsg>? := Events.OnResize;
        case Changed of
          when is Sys.Func<int, int, TMsg> as Callback:
            Apply(Callback.Invoke(Columns, Rows));
            return true;
          else
        end case;
      else
    end case;

    return false;
  end function;
begin
  var Notified: bool := false;
  for Control: A.Control<TMsg> in After.Controls do
    if Control.Role = 'canvas' then
      const Old: F.Rect := A.CanvasBounds<TMsg>(Before, Control.Id);
      if Old.Width <> Control.Bounds.Width or Old.Height <> Control.Bounds.Height then
        Notified := Send(Control, Control.Bounds.Width, Control.Bounds.Height) or Notified;
      end if;
    end if;
  end for;

  if Before <> null then
    for Control: A.Control<TMsg> in Before.Controls do
      if Control.Role = 'canvas' and A.CanvasBounds<TMsg>(After, Control.Id).Width = 0 then
        Notified := Send(Control, 0, 0) or Notified;
      end if;
    end for;
  end if;

  return Notified;
end function;
end unit;
