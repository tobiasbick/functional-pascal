unit Fpas.Ui.Tui.Internal.Layout.Arrangement;

uses Fpas.Ui.Tui.Internal.Widgets.SplitButton as SplitWidget, Fpas.Ui.Tui.Internal.Layout.Measurement as M, Fpas.Ui.Graphics as G, Fpas.Ui.Tui.Internal.Widgets.ButtonGroup as Group, Fpas.Ui.Layout as L, Fpas.Ui.Sheets as Sheets, Fpas.Ui.Tui.Internal.Widgets.Sheet as Sheet, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Choices as Ch, Fpas.Ui.Styles as UiStyle, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Layout.SelectionLists as S, Fpas.Ui.Tui.Internal.Layout.ScrollViews as V, Fpas.Ui.Tui.Internal.Controls.Activation as Actions, Fpas.Ui.Tui.Internal.Layout.TabHeaders as Tabs, Fpas.Ui.Tui.Internal.Layout.Stacks as Stacks, Fpas.Ui.Tui.Internal.Layout.Tables as Tables, Fpas.Ui.Tui.Internal.Layout.Overlays as Overlays, Fpas.Ui.Tui.Internal.Rendering.Canvases as Canvases, Fpas.Ui.Tui.Internal.Rendering.StatusLines as Status, Fpas.Ui.Tui.Internal.Rendering.Buttons as Buttons, Fpas.Ui.Tui.Internal.View.Editors as Editors, Fpas.Ui.Tui.Internal.Layout.EditorView as EditorView, Fpas.Ui.Tui.Internal.Rendering.EditorText as EditorText, Fpas.Ui.Tui.Internal.Layout.Scene as A, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, System as Sys, System.Collections.Generic as Generic;

public function Arrange<TMsg>(
  Root: E.Element<TMsg>; Columns: int; Rows: int;
  Previous: A.Layout<TMsg>?; Scroll: Generic.Dictionary<string, int>; Theme: Th.Theme
): A.Layout<TMsg>;
  procedure Draw(Value: string; Area: F.Rect; Clip: F.Rect; Style: T.Style; Wrap: bool);
  begin
    if Value.Length > 0 then
      Operations.Add(new D.Operation(Value, Area, Clip, Style, Wrap));
    end if;
  end procedure;

  function ArrangeRows(
    Id: string; Role: string; Items: array of Ch.SelectionItem; Key: string; Bounds: F.Rect; ScopeId: string;
    OnSelect: function(string): TMsg; OnActivate: Sys.Func<string, TMsg>?
  ): S.Viewport<TMsg>;
  begin
    const Max: int := Sys.Math.Max(0, Items.Length - Bounds.Height);
    const List: S.Viewport<TMsg> := S.Arrange<TMsg>(
      Items, Key, Bounds.Height, Offset(Id, Max), OnSelect, OnActivate, PriorList(Id)
    );
    Scroll[Id] := List.First;
    if Max > 0 then
      Regions.Add(new A.ScrollRegion(Id, ScopeId, Bounds, Max));
    end if;
    const Action: A.Binding<TMsg> := A.Binding<TMsg>.SelectList(List);
    var Enabled: bool := false;
    for Item: Ch.SelectionItem in Items do
      Enabled := Enabled or Item.Enabled;
    end for;

    Register(Id, Id, Role, List.Key(), Bounds, ScopeId, Enabled, Action);
    return List;
  end function;

  function PriorList(Id: string): S.Viewport<TMsg>?;
  begin
    const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Previous, Id);
    if Control <> null then
      case Control.Action of
        when A.Binding.SelectList(const List: S.Viewport<TMsg>):
          return List;
        else
      end case;
    end if;

    return null;
  end function;

  procedure AddControl(Control: A.Control<TMsg>);
  begin
    if Control.Id.Length = 0 or not Ids.Add(Control.Id) then
      raise new Sys.ArgumentException('Control IDs must be nonempty and unique.');
    end if;

    if Control.Bounds.Width > 0 and Control.Bounds.Height > 0 then
      Controls.Add(Control);
    end if;
  end procedure;

  procedure Register(
    Id: string; Label: string; Role: string; Value: string;
    Area: F.Rect; ScopeId: string; Enabled: bool; Action: A.Binding<TMsg>;
    Variant: UiStyle.ButtonVariant := UiStyle.ButtonVariant.Default;
    ButtonStyle: bool := false; ArrowFocus: bool := false; Hint: string := ''; Foreground: G.Color? := null;
    HoldMilliseconds: int := 0; HoldProgress: int := 0; Appearance: Th.ButtonAppearance? := null
  );
  begin
    AddControl(
      new A.Control<TMsg>(
        Id,
        Label,
        Role,
        Value,
        Area,
        ScopeId,
        FocusReturn,
        Enabled,
        Action,
        Variant,
        ButtonStyle,
        ArrowFocus,
        Hint,
        Foreground,
        HoldMilliseconds,
        HoldProgress,
        Appearance
      )
    );
  end procedure;

  procedure Visit(Node: E.Element<TMsg>; Area: F.Rect; Limit: F.Rect; ScopeId: string; Style: T.Style);
  begin
    const Clip: F.Rect := F.Intersect(Area, Limit);
    if Clip.Width = 0 or Clip.Height = 0 then
      return;
    end if;

    case Node of
      when E.Element.Label(const Value: string):
        Draw(Value, Area, Clip, Style, true);
      when E.Element.Separator(const Title: string):
        D.Divider(Operations, Area, Clip, Title, Style, Widgets);
      when E.Element.StatusLine(const Message: string, const Hints: array of string):
        Status.Draw(Operations, Area, Clip, Style, Message, Hints);
      when E.Element.Action(
        const Id: string,
        const Handler: Actions.IActivatable<TMsg>,
        const Enabled: bool,
        const View: E.ActionView
      ):
        Buttons.Paint(
          Operations,
          Area,
          Clip,
          Style,
          Theme,
          View.Caption,
          true,
          View.Variant,
          Enabled,
          View.MinimumWidth,
          View.Padding,
          View.FixedWidth <> null or View.FillWidth,
          View.Foreground,
          View.Joined,
          View.Appearance
        );
        const Action: A.Binding<TMsg> := A.Binding<TMsg>.Invoke(Handler);
        Register(
          Id,
          View.Name ?? View.Caption,
          View.Role,
          View.Value,
          Clip,
          ScopeId,
          Enabled,
          Action,
          View.Variant,
          ButtonStyle := true,
          ArrowFocus := View.ArrowFocus,
          Hint := View.Hint,
          Foreground := View.Foreground,
          HoldMilliseconds := View.HoldMilliseconds,
          HoldProgress := View.HoldProgress,
          Appearance := View.Appearance
        );
      when E.Element.Toggle(
        const Id: string,
        const Caption: string,
        const Checked: bool,
        const Change: function(bool): TMsg,
        const Enabled: bool
      ):
        const Label: string := (if Checked then '[x] ' else '[ ] ' end if) + Caption;
        Buttons.Paint(
          Operations,
          Area,
          Clip,
          Style,
          Theme,
          Label,
          false,
          UiStyle.ButtonVariant.Default,
          Enabled
        );
        Register(
          Id,
          Label,
          'checkbox',
          if Checked then 'true' else 'false' end if,
          Clip,
          ScopeId,
          Enabled,
          A.Binding<TMsg>.Toggle(new Actions.Toggle<TMsg>(Checked, Change)), ArrowFocus := true
        );
      when E.Element.DocumentEditor(
        const Id: string,
        const Text: string,
        const Position: Editors.EditorPosition,
        const Events: Editors.IEvents<TMsg>,
        const Placeholder: string,
        const Enabled: bool,
        const MultipleLines: bool
      ):
        const Inner: F.Rect := if MultipleLines then Clip
          else new F.Rect(
            Clip.X + 2,
            Clip.Y,
            Sys.Math.Max(0, Clip.Width - 2),
            1
          )
          end if;
        const Document: EditorView.Document := EditorView.Arrange(Text, Inner, Position);
        discard Events.Navigate(Document.Position);
        if MultipleLines then
          EditorText.Draw(Operations, Document, Style, Theme);
        else
          EditorText.DrawField(Operations, Document, Area, Clip, Placeholder, Style, Theme);
        end if;
        const View: EditorView.Viewport<TMsg> := new EditorView.Viewport<TMsg>(
          Document,
          Events,
          MultipleLines
        );
        Register(Id, Id, 'textbox', Text, Clip, ScopeId, Enabled, A.Binding<TMsg>.Multiline(View));
      when E.Element.Choices(const Id: string, const Items: array of Ch.ListItem<TMsg>):
        const Max: int := Sys.Math.Max(0, Items.Length - Area.Height);
        const First: int := Offset(Id, Max);
        Regions.Add(new A.ScrollRegion(Id, ScopeId, Clip, Max));
        for Index: int := First to Sys.Math.Min(Items.Length, First + Area.Height) - 1 do
          const Item: Ch.ListItem<TMsg> := Items[Index];
          const Line: F.Rect := new F.Rect(Area.X, Area.Y + Index - First, Area.Width, 1);
          D.ListRow(Operations, Line, Clip, Item.Text, Item.Selected, Style, Widgets);
          Register(
            Id + '/' + Item.Key,
            Item.Text,
            'listitem',
            if Item.Selected then 'true' else 'false' end if,
            F.Intersect(Line, Clip),
            ScopeId,
            Item.Enabled,
            A.Binding<TMsg>.Invoke(new Actions.Direct<TMsg>(Item.Message))
          );
        end for;
      when E.Element.Selectable(
        const Id: string, const Items: array of Ch.SelectionItem, const Key: string,
        const OnSelect: function(string): TMsg, const OnActivate: Sys.Func<string, TMsg>?
      ):
        const List: S.Viewport<TMsg> := ArrangeRows(
          Id,
          'listbox',
          Items,
          Key,
          Clip,
          ScopeId,
          OnSelect,
          OnActivate
        );
        S.Draw<TMsg>(List, Operations, Clip, Style, Widgets);
      when E.Element.TableView(
        const Id: string,
        const Columns: array of E.TableColumn,
        const Rows: array of Ch.TableRow,
        const Key: string,
        const OnSelect: function(string): TMsg,
        const OnActivate: Sys.Func<string, TMsg>?
      ):
        const Widths: array of int := Tables.Widths(Columns, Rows, Area.Width);
        const Header: F.Rect := new F.Rect(Area.X, Area.Y, Area.Width, 1);
        Tables.DrawHeader(Columns, Widths, Header, Clip, Style, Widgets, Operations);
        const Body: F.Rect := F.Intersect(
          new F.Rect(Area.X, Area.Y + 1, Area.Width, Area.Height - 1),
          Clip
        );
        if Body.Height > 0 then
          const List: S.Viewport<TMsg> := ArrangeRows(
            Id, 'table', Tables.Items(Rows), Key, Body, ScopeId, OnSelect, OnActivate
          );
          Tables.DrawBody<TMsg>(Rows, Widths, List, Area, Body, Style, Widgets, Operations);
        end if;
      when E.Element.TabSet(
        const Id: string, const Items: array of Ch.TabItem, const ActiveIndex: int,
        const OnSelect: function(string): TMsg, const Panel: E.Element<TMsg>?
      ):
        if Items.Length = 0 then
          return;
        end if;
        const Bar: F.Rect := new F.Rect(Area.X, Area.Y, Area.Width, 1);
        const Visible: F.Rect := F.Intersect(Bar, Clip);
        if Visible.Height > 0 then
          const Header: Tabs.Header<TMsg> := Tabs.Draw<TMsg>(
            Items,
            ActiveIndex,
            OnSelect,
            Bar,
            Visible,
            Style,
            Widgets,
            Operations
          );
          const Action: A.Binding<TMsg> := A.Binding<TMsg>.SelectTab(Header);
          Register(
            Id,
            Id,
            'tablist',
            Header.Key(),
            Visible,
            ScopeId,
            ActiveIndex >= 0 and Items[ActiveIndex].Enabled,
            Action
          );
        end if;

        if Panel <> null then
          const Parent: string := FocusReturn;
          FocusReturn := Id;
          Visit(
            Panel,
            new F.Rect(Area.X, Area.Y + 1, Area.Width, Area.Height - 1),
            Clip,
            ScopeId,
            Style
          );
          FocusReturn := Parent;
        end if;
      when E.Element.Gauge(const Percent: int):
        D.Progress(Operations, Area, Clip, Percent, Style, Widgets);
      when E.Element.Sized(const Child: E.Element<TMsg>, _):
        Visit(Child, Area, Clip, ScopeId, Style);
      when E.Element.Decorated(const Child: E.Element<TMsg>, const ChildStyle: T.Style):
        if ChildStyle.Background <> null and ChildStyle.Background <> Style.Background then
          D.Fill(Operations, Clip, ChildStyle);
        end if;

        Visit(Child, Area, Clip, ScopeId, ChildStyle);
      when E.Element.Stack(
        const Children: array of E.Element<TMsg>,
        const Axis: bool,
        const Flow: E.Flow
      ):
        VisitStack(Children, Axis, Flow, Area, Clip, ScopeId, Style);
      when E.Element.ButtonGroup(const Body: E.Element<TMsg>):
        Visit(Body, Group.Bounds<TMsg>(Body, Area), Clip, ScopeId, Style);
      when E.Element.PopupAnchor(
        const Trigger: E.Element<TMsg>, const Id: string, const Content: E.Element<TMsg>,
        const Initial: string, const Close: procedure()
      ):
        const Before: int := Controls.Count;
        Visit(Trigger, Area, Clip, ScopeId, Style);
        for Index: int := Before to Controls.Count - 1 do
          const Part: A.Control<TMsg> := Controls[Index];
          if Part.Id = Id then
            Popup := new SplitWidget.Pending<TMsg>(
              Id, ScopeId,
              new F.Rect(
                Clip.X,
                Part.Bounds.Y,
                Part.Bounds.X + Part.Bounds.Width - Clip.X,
                Part.Bounds.Height
              ),
              Content, Initial, Close
            );
          end if;
        end for;
      when E.Element.Framed(const Child: E.Element<TMsg>, const Title: string):
        D.Border(Operations, Area, Clip, Title, Style, Widgets);
        Visit(
          Child, new F.Rect(
            Area.X + 1, Area.Y + 1, Sys.Math.Max(0, Area.Width - 2),
            Sys.Math.Max(0, Area.Height - 2)
          ), Clip, ScopeId, Style
        );
      when E.Element.Scrollable(const Id: string, const Child: E.Element<TMsg>, const Bar: bool):
        const Layout: V.Geometry<TMsg> := V.Arrange<TMsg>(
          Child,
          E.ScrollPosition.Offset(Offset(Id, int.MaxValue)),
          Area,
          Clip,
          Bar,
          null
        );
        Scroll[Id] := Layout.View.Offset;
        Regions.Add(new A.ScrollRegion(Id, ScopeId, Clip, Layout.View.Maximum));
        VisitScrolled(Child, Layout.Content, Layout.Clip, ScopeId, Style);
        V.DrawBar<TMsg>(Layout.View, Operations, Area, Clip, Style, Widgets);
      when E.Element.ControlledScroll(
        const Id: string, const Child: E.Element<TMsg>, const Position: E.ScrollPosition,
        const OnScroll: Sys.Func<L.ScrollChange, TMsg>, const ShowScrollbar: bool
      ):
        const Layout: V.Geometry<TMsg> := V.Arrange<TMsg>(
          Child, Position, Area, Clip, ShowScrollbar, OnScroll
        );
        const View: V.Viewport<TMsg> := Layout.View;
        const Action: A.Binding<TMsg> := A.Binding<TMsg>.Scroll(View);
        Register(
          Id,
          Id,
          'scrollview',
          View.Offset.ToString(),
          Clip,
          ScopeId,
          View.Maximum > 0,
          Action
        );
        if View.Maximum > 0 then
          Regions.Add(new A.ScrollRegion(Id, ScopeId, Clip, View.Maximum, true));
        end if;

        VisitScrolled(Child, Layout.Content, Layout.Clip, ScopeId, Style);
        V.DrawBar<TMsg>(View, Operations, Area, Clip, Style, Widgets);
      when E.Element.Custom(
        const Width: int, const Height: int, const DrawCell: function(int, int): T.Cell,
        const Action: E.CanvasBinding<TMsg>
      ):
        var CanvasArea: F.Rect := F.Intersect(Clip, new F.Rect(Area.X, Area.Y, Width, Height));
        var OriginX: int := Area.X;
        var OriginY: int := Area.Y;
        case Action of
          when E.CanvasBinding.Responsive(const Id: string, const Events: T.CanvasEvents<TMsg>):
            CanvasArea := Clip;
            OriginX := Clip.X;
            OriginY := Clip.Y;
            Register(
              Id,
              Id,
              'canvas',
              '',
              Clip,
              ScopeId,
              true,
              A.Binding<TMsg>.Canvas(OriginX, OriginY, Events)
            );
            if Events.OnResize <> null then
              const Old: F.Rect := A.CanvasBounds<TMsg>(Previous, Id);
              if Old.Width <> Clip.Width or Old.Height <> Clip.Height then
                return;
              end if;
            end if;
          when E.CanvasBinding.Fixed(const Id: string, const Events: T.CanvasEvents<TMsg>):
            Register(
              Id, Id, 'canvas', '', CanvasArea, ScopeId,
              Events.OnClick <> null or Events.OnMiddleClick <> null or Events.OnScroll <> null,
              A.Binding<TMsg>.Canvas(OriginX, OriginY, Events)
            );
        end case;

        Canvases.Paint(DrawCell, OriginX, OriginY, CanvasArea, Style, Operations);
      when E.Element.Desktop(
        const Content: E.Element<TMsg>, const Layers: array of E.Element<TMsg>,
        const Keys: array of K.ShortcutBinding<TMsg>
      ):
        if Keys.Length > 0 then
          GlobalKeys := Keys;
        end if;

        Visit(Content, Area, Clip, ScopeId, Style);
        for Layer: E.Element<TMsg> in Layers do
          Visit(Layer, Area, Clip, ScopeId, Style);
        end for;
      when E.Element.Panel(
        const Body: E.Element<TMsg>,
        const Footer: E.Element<TMsg>,
        const Title: string,
        const Padding: byte
      ):
        const Parts: Overlays.PanelBounds := Overlays.Partition<TMsg>(Area, Footer, Padding);
        if Parts.Framed then
          D.Border(Operations, Area, Clip, Title, Style, Widgets);
        end if;

        Visit(Body, Parts.Body, Clip, ScopeId, Style);
        Visit(Footer, Parts.Footer, Clip, ScopeId, Style);
      when E.Element.Layer(
        const Id: string,
        const Modal: bool,
        const Initial: string,
        const Escape: Sys.Func<TMsg>?,
        const Content: E.Element<TMsg>,
        const Keys: array of K.ShortcutBinding<TMsg>,
        const Limits: K.OverlayLimits?
      ):
        if Modal then
          Active := new A.Scope<TMsg>(Id, Initial, Escape, Keys);
        end if;
        const Bounds: F.Rect := Overlays.Place<TMsg>(Content, Clip, Limits);
        D.Fill(Operations, Bounds, Style);
        Visit(Content, Bounds, Bounds, if Modal then Id else ScopeId end if, Style);
      when E.Element.EdgeSheet(
        const Id: string, const Settings: Sheets.Options, const Size: int,
        const Content: E.Element<TMsg>, const Dismiss: TMsg, const Colors: T.Style
      ):
        const Layer: Sheet.Placement<TMsg> := Sheet.Arrange<TMsg>(
          Operations, Screen, Id, Settings, Size, Colors, Theme, Dismiss, FocusReturn
        );
        Active := Layer.Scope;
        AddControl(Layer.Close);
        Visit(Content, Layer.Body, Layer.Body, Id, Colors);
    end case;
  end procedure;

  procedure VisitScrolled(Child: E.Element<TMsg>; Area: F.Rect; Clip: F.Rect; ScopeId: string; Style: T.Style);
  begin
    const PreviousWrap: bool := WrapText;
    WrapText := true;
    Visit(Child, Area, Clip, ScopeId, Style);
    WrapText := PreviousWrap;
  end procedure;

  function Offset(Id: string; Maximum: int): int;
  begin
    if Scroll.ContainsKey(Id) then
      return Sys.Math.Clamp(Scroll[Id], 0, Maximum);
    end if;

    return 0;
  end function;

  procedure VisitStack(
    Children: array of E.Element<TMsg>; Axis: bool; Flow: E.Flow;
    Area: F.Rect; Clip: F.Rect; ScopeId: string; Style: T.Style
  );
  begin
    const Bounds: array of F.Rect := Stacks.Bounds<TMsg>(
      Children,
      Axis,
      Flow,
      Area,
      PreviousAllocations,
      Allocations,
      WrapText
    );
    for Index: int := 0 to Children.Length - 1 do
      Visit(Children[Index], Bounds[Index], Clip, ScopeId, Style);
    end for;
  end procedure;
begin
  const Widgets: Th.WidgetStyles? := Theme.Widgets;
  const Operations: Generic.List<D.Operation> := new Generic.List<D.Operation>();
  const Allocations: Generic.List<F.AllocationMemo> := new Generic.List<F.AllocationMemo>();
  const PreviousAllocations: array of F.AllocationMemo := if Previous = null then []
    else Previous.Allocations
    end if;
  const Controls: Generic.List<A.Control<TMsg>> := new Generic.List<A.Control<TMsg>>();
  const Regions: Generic.List<A.ScrollRegion> := new Generic.List<A.ScrollRegion>();
  const Ids: Generic.HashSet<string> := new Generic.HashSet<string>();
  var Active: A.Scope<TMsg>? := null;
  var Popup: SplitWidget.Pending<TMsg>? := null;
  var FocusReturn: string := '';
  var WrapText: bool := false;
  var GlobalKeys: array of K.ShortcutBinding<TMsg> := [];
  const Screen: F.Rect := new F.Rect(0, 0, Columns, Rows);
  Visit(Root, Screen, Screen, '', Theme.Text);
  const Pending: SplitWidget.Pending<TMsg>? := Popup;
  if Pending <> null and Pending.Parent = (if Active = null then '' else Active.Id end if) then
    const Surface: int := Th.Rgb(Theme.Colors.SurfaceRaised, Theme.Text.Background ?? 0);
    const Colors: T.Style := new T.Style(Th.Rgb(Theme.Colors.Foreground, Surface), Surface);
    const Width: int := Sys.Math.Max(23, M.Intrinsic<TMsg>(Pending.Content, true));
    const Height: int := Sys.Math.Min(26, M.Intrinsic<TMsg>(Pending.Content, false, Width));
    const Bounds: array of F.Rect := SplitWidget.Place(
      Operations,
      Screen,
      Pending.Anchor,
      Width,
      Height,
      Colors,
      Theme
    );
    const PreviousScope: A.Scope<TMsg>? := if Previous = null then null else Previous.Active end if;
    if PreviousScope = null or PreviousScope.Id <> Pending.Id then
      Scroll[Pending.Id] := 0;
    end if;

    Active := new A.Scope<TMsg>(
      Pending.Id, Pending.Initial, null, [], Bounds[0], Dismiss := Pending.Close
    );
    Visit(
      E.Element<TMsg>.Scrollable(Pending.Id, Pending.Content, false),
      Bounds[1],
      Bounds[1],
      Pending.Id,
      Colors
    );
  end if;
  const PreviousRows: array of D.PaintedRow := if Previous = null then []
    else Previous.Painted
    end if;
  const Surface: D.Surface := D.Render(Operations, Columns, Rows, PreviousRows, Theme.Text);
  return new A.Layout<TMsg>(
    Surface.Lines, Surface.Cells, Controls.ToArray(), Active, GlobalKeys, Regions.ToArray(),
    Surface.Rows, Allocations.ToArray()
  );
end function;
end unit;
