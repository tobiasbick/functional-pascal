// [Documentation](../../../../docs/ui/tui/host.md#views-layout-and-validation)

unit Fpas.Ui.Tui.Internal.Layout.Arrangement;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as UiStyle;
uses Fpas.Ui.TerminalExtensions.CellGrids as Grids;
uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.Tui.Internal.Controls.Activation as Actions;
uses Fpas.Ui.Tui.Internal.Controls.ChoiceStrip as ChoiceStrip;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Layout.PopupHost as PopupHost;
uses Fpas.Ui.Tui.Internal.Layout.Scene as A;
uses Fpas.Ui.Tui.Internal.Layout.ScrollViews as V;
uses Fpas.Ui.Tui.Internal.Layout.Stacks as Stacks;
uses Fpas.Ui.Tui.Internal.Rendering.Buttons as Buttons;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Tui.Internal.Widgets.Charts.Sparkline as Sparkline;
uses Fpas.Ui.Tui.Internal.Widgets.Collections.SelectionList as SelectionList;
uses Fpas.Ui.Tui.Internal.Widgets.Collections.Table as Tables;
uses Fpas.Ui.Tui.Internal.Widgets.Developer.LogConsole as Log;
uses Fpas.Ui.Tui.Internal.Widgets.Feedback.ProgressBar as Progress;
uses Fpas.Ui.Tui.Internal.Widgets.Feedback.Spinner as Spinner;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextArea as AreaWidget;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextField as FieldWidget;
uses Fpas.Ui.Tui.Internal.Widgets.Navigation.Breadcrumb as Breadcrumb;
uses Fpas.Ui.Tui.Internal.Widgets.Navigation.Pagination as Pagination;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.CommandPalette as Palette;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.ModalPanel as Panel;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.PopupState as PopupState;
uses Fpas.Ui.Widgets.Developer.LogConsoles as Logs;
uses Fpas.Ui.Widgets.Developer.Terminal as T;
uses Fpas.Ui.Widgets.Overlays.CommandPalettes as Palettes;

uses System as Sys;
uses System.Collections.Generic as Generic;

// Places and paints a terminal view and gathers the control scene used by input routing.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Root`: Prepared terminal view to arrange.
// - `Columns`: Viewport width in cells.
// - `Rows`: Viewport height in cells.
// - `Previous`: Prior scene for retaining editor positions, allocations and unchanged rows.
// - `Scroll`: Session scroll offsets by view identity.
// - `Theme`: Resolved terminal style and motion settings.
// - `Popup`: Session state for anchored overlays.
// - `Focus`: Requested control identity, used to reveal focus within choice strips.
// - `AnimationPhase`: Current motion step for the rendered frame.
// ## Returns
// Painted cells with control bounds, keyboard navigation and scroll regions.
public function Arrange of TMsg(
  Root: E.Element of TMsg;
  Columns: int;
  Rows: int;
  Previous: (A.Layout of TMsg)?;
  Scroll: Generic.Dictionary of (string, int);
  Theme: Th.Theme;
  Popup: PopupState.State of TMsg;
  Focus: string;
  AnimationPhase: long := 0L
): A.Layout of TMsg;
  procedure Draw(Value: string; Area: F.Rect; Clip: F.Rect; Style: T.Style; Wrap: bool);
  begin
    if Value.Length > 0 then
      Operations.Add(new D.Operation(Value, Area, Clip, Style, Wrap));
    end if;
  end procedure;

  procedure AddControl(Control: A.Control of TMsg);
  begin
    if Control.Id.Length = 0 or not Ids.Add(Control.Id) then
      raise new Sys.ArgumentException('Control IDs must be nonempty and unique.');
    end if;

    if Control.Bounds.Width > 0 and Control.Bounds.Height > 0 then
      Controls.Add(Control);
      if Control.Enabled and Control.TabTarget = '' then
        TabStops.Add(new A.TabStop(Control.Id, Control.Scope));
      end if;
    end if;
  end procedure;

  procedure Register(
    Id: string;
    Label: string;
    Role: string;
    Value: string;
    Area: F.Rect;
    ScopeId: string;
    Enabled: bool;
    Action: A.Binding of TMsg;
    Variant: UiStyle.ButtonVariant := UiStyle.ButtonVariant.Default;
    ButtonStyle: bool := false;
    ArrowFocus: bool := false;
    Hint: string := '';
    Foreground: G.Color? := null;
    TabTarget: string := ''
  );
  begin
    AddControl(
      new A.Control of TMsg(
        Id,
        Label,
        Role,
        Value,
        Area,
        ScopeId,
        FocusReturn,
        Enabled,
        Action,
        Variant,
        ButtonStyle,
        ArrowFocus,
        Hint,
        Foreground, TabTarget
      )
    );
  end procedure;

  procedure Visit(
    Node: E.Element of TMsg;
    Area: F.Rect;
    Limit: F.Rect;
    ScopeId: string;
    Style: T.Style
  );
    procedure HiddenTabStop(Id: string; Focusable: bool := false);
    begin
      TabStops.Add(new A.TabStop(Id, ScopeId));
      NavigationRows.Add(
        new A.NavigationStop(
          Id, Area, '', ScrollId, if Focusable then
            ScopeId
          else
            null
          end if
        )
      );
    end procedure;
  begin
    const Clip: F.Rect := F.Intersect(Area, Limit);
    case Node of
      when E.Element.Action(const Id: string, _, const Enabled: bool, const View: E.ActionView):
        if Enabled and View.NavigationGroup <> '' then
          NavigationRows.Add(new A.NavigationStop(Id, Area, View.NavigationGroup, ScrollId));
          if View.TabTarget = Id and (Clip.Height > 0 or ScrollId <> '') and Clip.Width > 0 then
            TabStops.Add(new A.TabStop(Id, ScopeId));
          end if;
        end if;
      else
    end case;

    if Clip.Width = 0 then
      return;
    end if;

    if Clip.Height = 0 then
      // Keep row geometry below the fold for keyboard navigation.
      if ScrollId = '' or Area.Height = 0 then
        return;
      end if;

      case Node of
        when E.Element.Action(const Id: string, _, const Enabled: bool, const View: E.ActionView):
          if Enabled and View.NavigationGroup = '' then
            HiddenTabStop(Id, View.Role = 'expandable-card');
          end if;

          return;
        when E.Element.TextField(const Field: Edit.Field of TMsg):
          if Field.Settings.Enabled then
            HiddenTabStop(Field.Id);
          end if;

          return;
        when E.Element.TextArea(const Field: AreaEdit.Field of TMsg):
          if Field.Settings.Enabled then
            HiddenTabStop(Field.Id);
          end if;

          return;
        when E.Element.CellGrid(const Id: string, _, _):
          HiddenTabStop(Id);
          return;
        when E.Element.SelectionList(const List: E.SelectionListView of TMsg):
          if List.Items.Length > 0 then
            HiddenTabStop(List.Id, true);
          end if;

          return;
        when E.Element.Log(const Id: string, _, _):
          HiddenTabStop(Id, true);
          return;
        when E.Element.Stack(
          _,
          _,
          _
        ), E.Element.Sized(
          _,
          _
        ), E.Element.Decorated(_, _), E.Element.DisclosureBody(
          _,
          _,
          _
        ), E.Element.Framed(
          _,
          _
        ), E.Element.ChoiceStrip(_), E.Element.Pager(_), E.Element.Breadcrumb(_):
        else
          return;
      end case;
    end if;

    case Node of
      when E.Element.Palette(
        const Id: string,
        const Base: E.Element of TMsg,
        const Open: bool,
        const Commands: array of Palettes.Command of TMsg,
        const Change: function(bool): TMsg,
        const Shortcut: bool
      ):
        Visit(Base, Area, Clip, ScopeId, Style);
        if InputBlocked then
          return;
        end if;

        if Open then
          Scopes.Add(Id);
          Active := Palette.Draw of TMsg(
            Id,
            Commands,
            Change,
            Shortcut,
            Popup,
            Screen,
            Theme,
            Operations,
            Controls
          );
          PaletteOpen := true;
        else
          if Popup.Read().Id = Id then
            Popup.Write(new PopupState.Cursor());
          end if;

          if Shortcut then
            OpenPalette := function(): TMsg => Change(true);
          end if;
        end if;
      when E.Element.Log(
        const Id: string,
        const Entries: array of Logs.Entry,
        const Timestamps: bool
      ):
        AddControl(
          Log.Arrange of TMsg(
            Id, Entries, Timestamps, A.FindControl of TMsg(Previous, Id), Clip, Style, Theme,
            ScopeId, FocusReturn, Scroll, Regions, Operations
          )
        );
      when E.Element.ChoiceStrip(const Strip: E.ChoiceStripView of TMsg):
        ChoiceStrip.Arrange of TMsg(
          Strip, Area, Clip, Style, Theme, ScopeId, FocusReturn, ScrollId, Focus,
          Scroll, Operations, NavigationRows, TabStops, AddControl
        );
      when E.Element.Pager(const Pager: E.PagerView of TMsg):
        Pagination.Arrange of TMsg(
          Pager, Area, Clip, Style, Theme, ScopeId, FocusReturn, ScrollId,
          Operations, NavigationRows, TabStops, AddControl
        );
      when E.Element.Breadcrumb(const Trail: E.BreadcrumbView of TMsg):
        Breadcrumb.Arrange of TMsg(
          Trail, Area, Clip, Style, Theme, Popup, ScopeId, FocusReturn, ScrollId,
          Operations, NavigationRows, TabStops, AddControl
        );
      when E.Element.Table(const Table: E.TableView of TMsg):
        Tables.Arrange of TMsg(
          Table, Area, Clip, Style, Theme, ScopeId, FocusReturn,
          Scroll, Regions, NavigationRows, Operations, AddControl
        );
      when E.Element.SelectionList(const List: E.SelectionListView of TMsg):
        AddControl(
          SelectionList.Arrange of TMsg(
            List, Previous, Clip, Style, Theme, ScopeId, FocusReturn, Scroll, Regions, Operations
          )
        );
      when E.Element.CellGrid(
        const Id: string,
        const Content: Grids.Image?,
        const Changed: function(Grids.Event): TMsg
      ):
        if Content = null then
          D.Fill(Operations, Clip, Style);
        else
          Operations.Add(new D.Operation('', Area, Clip, Style, false, Grid := Content));
        end if;

        Register(
          Id,
          Id,
          'cell-grid',
          '',
          Clip,
          ScopeId,
          true,
          (A.Binding of TMsg).Grid(Area, Changed)
        );
      when E.Element.TextArea(const Field: AreaEdit.Field of TMsg):
        AddControl(
          AreaWidget.Arrange of TMsg(
            Field,
            Previous,
            Area,
            Clip,
            ScopeId,
            FocusReturn,
            Style,
            Theme,
            Operations
          )
        );
      when E.Element.TextField(const Field: Edit.Field of TMsg):
        AddControl(
          FieldWidget.Arrange of TMsg(
            Field,
            Previous,
            Area,
            Clip,
            ScopeId,
            FocusReturn,
            Style,
            Theme,
            Operations
          )
        );
      when E.Element.Label(const Value: string):
        Draw(Value, Area, Clip, Style, true);
      when E.Element.Spinner(
        const Frames: string, const Ink: G.Color, const Inverse: bool
      ):
        const Bounds: F.Rect := new F.Rect(
          Area.X,
          Area.Y,
          Sys.Math.Min(1, Area.Width),
          Sys.Math.Min(1, Area.Height)
        );
        const AnimatedPhase: long := if Theme.ReducedMotion then
          0L
        else
          AnimationPhase
        end if;
        const Visible: bool := Spinner.Paint(
          Operations,
          Bounds,
          F.Intersect(Bounds, Clip),
          Frames,
          AnimatedPhase,
          Ink,
          Inverse,
          Style,
          Theme
        );
        Animated := Animated or (Visible and not Theme.ReducedMotion);
      when E.Element.Sparkline(
        const Values: array of float,
        const Width: int,
        const Fill: bool,
        const Ink: G.Color
      ):
        const Span: int := if Fill then
          Area.Width
        else
          Sys.Math.Min(Width, Area.Width)
        end if;
        const Bounds: F.Rect := new F.Rect(Area.X, Area.Y, Span, Sys.Math.Min(1, Area.Height));
        Sparkline.Paint(Operations, Bounds, F.Intersect(Bounds, Clip), Values, Ink, Style, Theme);
      when E.Element.Progress(
        const Fraction: float,
        const Caption: string,
        const Percent: string,
        const Width: int?,
        const Fill: G.Color
      ):
        Progress.Paint(
          Operations,
          Area,
          Clip,
          Fraction,
          Caption,
          Percent,
          Width,
          Fill,
          Style,
          Theme
        );
      when E.Element.StatusBar(const Row: E.Element of TMsg, const HideBorder: bool):
        var Top: int := Area.Y;
        if not HideBorder and Area.Height > 1 then
          D.HorizontalRule(
            Operations,
            new F.Rect(Area.X, Top, Area.Width, 1),
            Clip,
            Style,
            Widgets
          );
          Top := Top + 1;
        end if;

        Visit(Row, new F.Rect(Area.X, Top, Area.Width, 1), Clip, ScopeId, Style);
      when E.Element.Action(
        const Id: string,
        const Handler: Actions.IActivatable of TMsg,
        const Enabled: bool,
        const View: E.ActionView
      ):
        const Caption: string := case View.CaptionForWidth of
          when is Sys.Func of (int, string) as ResolveCaption: ResolveCaption.Invoke(
            Sys.Math.Max(0, Clip.Width - 2 * View.Padding)
          );
          else View.Caption;
        end case;
        Buttons.Paint(
          Operations,
          Area,
          Clip,
          Style,
          Theme,
          Caption,
          true,
          View.Variant,
          Enabled,
          View.MinimumWidth,
          View.Padding,
          View.Center and (View.FixedWidth <> null or View.FillWidth),
          View.Foreground,
          View.Joined, View.Description
        );
        const Action: A.Binding of TMsg := (A.Binding of TMsg).Invoke(Handler);
        Register(
          Id,
          View.Name ?? View.Caption,
          View.Role,
          View.Value,
          Clip,
          ScopeId,
          Enabled,
          Action,
          View.Variant,
          ButtonStyle := true,
          ArrowFocus := View.ArrowFocus,
          Hint := View.Hint,
          Foreground := View.Foreground, TabTarget := View.TabTarget
        );
      when E.Element.Sized(const Child: E.Element of TMsg, _):
        Visit(Child, Area, Clip, ScopeId, Style);
      when E.Element.DisclosureBody(
        const Header: string,
        const Child: E.Element of TMsg,
        const Enabled: bool
      ):
        const Parent: string := FocusReturn;
        const ParentScroll: string := ScrollId;
        const WasBlocked: bool := InputBlocked;
        FocusReturn := Header;
        InputBlocked := WasBlocked or not Enabled;
        if not Enabled then
          ScrollId := '';
        end if;

        // A disabled body still paints, with its controls in an inactive scope.
        Visit(
          Child, Area, Clip, if Enabled then
            ScopeId
          else
            Header
          end if, Style
        );
        FocusReturn := Parent;
        ScrollId := ParentScroll;
        InputBlocked := WasBlocked;
      when E.Element.Decorated(const Child: E.Element of TMsg, const ChildStyle: T.Style):
        if Clip.Height > 0 and ChildStyle.Background <> null and ChildStyle.Background <>
          Style.Background
        then
          D.Fill(Operations, Clip, ChildStyle);
        end if;

        Visit(Child, Area, Clip, ScopeId, ChildStyle);
      when E.Element.Stack(
        const Children: array of E.Element of TMsg,
        const Axis: bool,
        const Flow: E.Flow
      ):
        VisitStack(Children, Axis, Flow, Area, Clip, ScopeId, Style);
      when E.Element.Framed(const Child: E.Element of TMsg, const Title: string):
        if Clip.Height > 0 then
          D.Border(Operations, Area, Clip, Title, Style, Widgets);
        end if;

        Visit(
          Child, new F.Rect(
            Area.X + 1, Area.Y + 1, Sys.Math.Max(0, Area.Width - 2),
            Sys.Math.Max(0, Area.Height - 2)
          ), Clip, ScopeId, Style
        );
      when E.Element.Scrollable(const Id: string, const Child: E.Element of TMsg, const Bar: bool):
        const Layout: V.Geometry of TMsg := V.Arrange of TMsg(
          Child,
          E.ScrollPosition.Offset(Offset(Id, int.MaxValue)),
          Area,
          Clip,
          Bar,
          null
        );
        Scroll[Id] := Layout.View.Offset;
        Regions.Add(new A.ScrollRegion(Id, ScopeId, Clip, Layout.View.Maximum));
        VisitScrolled(Id, Child, Layout.Content, Layout.Clip, ScopeId, Style);
        V.DrawBar of TMsg(Layout.View, Operations, Area, Clip, Style, Widgets);
      when E.Element.ControlledScroll(
        const Id: string, const Child: E.Element of TMsg, const Position: E.ScrollPosition,
        const OnScroll: Sys.Func of (L.ScrollChange, TMsg), const ShowScrollbar: bool
      ):
        const Layout: V.Geometry of TMsg := V.Arrange of TMsg(
          Child, Position, Area, Clip, ShowScrollbar, OnScroll
        );
        const View: V.Viewport of TMsg := Layout.View;
        const Action: A.Binding of TMsg := (A.Binding of TMsg).Scroll(View);
        Register(
          Id,
          Id,
          'scrollview',
          View.Offset.ToString(),
          Clip,
          ScopeId,
          View.Maximum > 0,
          Action
        );
        if View.Maximum > 0 then
          Regions.Add(new A.ScrollRegion(Id, ScopeId, Clip, View.Maximum, true));
        end if;

        VisitScrolled(Id, Child, Layout.Content, Layout.Clip, ScopeId, Style);
        if Focus = Id and not InputBlocked then
          V.DrawBar of TMsg(View, Operations, Area, Clip, Theme.Focus, null);
        else
          V.DrawBar of TMsg(View, Operations, Area, Clip, Style, Widgets);
        end if;
      when E.Element.Desktop(
        const Content: E.Element of TMsg, const Layers: array of E.Element of TMsg,
        const Keys: array of K.ShortcutBinding of TMsg
      ):
        if not InputBlocked and Keys.Length > 0 then
          GlobalKeys := Keys;
        end if;

        Visit(Content, Area, Clip, ScopeId, Style);
        for Layer: E.Element of TMsg in Layers do
          Visit(Layer, Area, Clip, ScopeId, Style);
        end for;
      when E.Element.ModalPanel(
        const Id: string, const Settings: E.ModalOptions, const Size: int,
        const Content: E.Element of TMsg, const Dismiss: Sys.Func of TMsg, const Colors: T.Style
      ):
        if InputBlocked then
          return;
        end if;
        const Layer: Panel.Placement of TMsg := Panel.Arrange of TMsg(
          Operations, Screen, Id, Settings, Size, Content, Colors, Theme, Dismiss, FocusReturn
        );
        Scopes.Add(Id);
        Active := Layer.Scope;
        case Layer.Close of
          when is A.Control of TMsg as Close:
            AddControl(Close);
          else
        end case;

        Visit(Content, Layer.Body, Layer.Body, Id, Colors);
    end case;
  end procedure;

  procedure VisitScrolled(
    Id: string;
    Child: E.Element of TMsg;
    Area: F.Rect;
    Clip: F.Rect;
    ScopeId: string;
    Style: T.Style
  );
  begin
    const PreviousWrap: bool := WrapText;
    const ParentScroll: string := ScrollId;
    ScrollId := Id;
    WrapText := true;
    Visit(Child, Area, Clip, ScopeId, Style);
    WrapText := PreviousWrap;
    ScrollId := ParentScroll;
  end procedure;

  function Offset(Id: string; Maximum: int): int;
  begin
    if Scroll.ContainsKey(Id) then
      return Sys.Math.Clamp(Scroll[Id], 0, Maximum);
    end if;

    return 0;
  end function;

  procedure VisitStack(
    Children: array of E.Element of TMsg;
    Axis: bool;
    Flow: E.Flow;
    Area: F.Rect;
    Clip: F.Rect;
    ScopeId: string;
    Style: T.Style
  );
  begin
    const Bounds: array of F.Rect := Stacks.Bounds of TMsg(
      Children,
      Axis,
      Flow,
      Area,
      PreviousAllocations,
      Allocations,
      WrapText
    );
    for Index: int := 0 to Children.Length - 1 do
      Visit(Children[Index], Bounds[Index], Clip, ScopeId, Style);
    end for;
  end procedure;
begin
  const Widgets: Th.WidgetStyles? := Theme.Widgets;
  const Operations: Generic.List of D.Operation := new Generic.List of D.Operation();
  const Allocations: Generic.List of F.AllocationMemo := new Generic.List of F.AllocationMemo();
  const PreviousAllocations: array of F.AllocationMemo := if Previous = null then
    []
  else
    Previous.Allocations
  end if;
  const TabStops: Generic.List of A.TabStop := new Generic.List of A.TabStop();
  const Controls: Generic.List of A.Control of TMsg := new Generic.List of A.Control of TMsg();
  const Scopes: Generic.List of string := new Generic.List of string();
  const Regions: Generic.List of A.ScrollRegion := new Generic.List of A.ScrollRegion();
  const NavigationRows: Generic.List of A.NavigationStop := new Generic.List of A.NavigationStop();
  var ScrollId: string := '';
  const Ids: Generic.HashSet of string := new Generic.HashSet of string();
  var Active: (A.Scope of TMsg)? := null;
  var FocusReturn: string := '';
  var InputBlocked: bool := false;
  var WrapText: bool := false;
  var GlobalKeys: array of K.ShortcutBinding of TMsg := [];
  var OpenPalette: (Sys.Func of TMsg)? := null;
  var PaletteOpen: bool := false;
  var Animated: bool := false;
  const Screen: F.Rect := new F.Rect(0, 0, Columns, Rows);
  Visit(Root, Screen, Screen, '', Theme.Text);
  const OpenPopup: (A.Scope of TMsg)? := if PaletteOpen then
    null
  else
    PopupHost.Present of TMsg(
      Popup,
      Active,
      Screen,
      Theme,
      Operations,
      Controls
    )
  end if;
  if OpenPopup <> null then
    Active := OpenPopup;
    Scopes.Add(OpenPopup.Id);
  end if;
  const PreviousRows: array of D.PaintedRow := if Previous = null then
    []
  else
    Previous.Painted
  end if;
  const Surface: D.Surface := D.Render(Operations, Columns, Rows, PreviousRows, Theme.Text);
  return new A.Layout of TMsg(
    Surface.Lines,
    Surface.Cells,
    Controls.ToArray(),
    Active,
    GlobalKeys,
    Regions.ToArray(),
    Surface.Rows,
    Allocations.ToArray(),
    Scopes := Scopes.ToArray(),
    NavigationRows := NavigationRows.ToArray(),
    TabStops := TabStops.ToArray(),
    OpenPalette := OpenPalette,
    Animated := Animated
  );
end function;

end unit;
