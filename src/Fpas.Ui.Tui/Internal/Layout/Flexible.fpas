unit Fpas.Ui.Tui.Internal.Layout.Flexible;

uses Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Layout as L, System as Sys, System.Collections.Generic as Generic, System.Text as Text;

// Resolves an explicit terminal distance.
//
// ## Parameters
// - `Value`: Validated cell or portable logical measure.
// - `Horizontal`: Whether the distance is measured in columns rather than rows.
//
// ## Returns
// Cell count.
public function Cells(Value: L.Measure; Horizontal: bool := true): int;
begin
  case Value of
    when L.Measure.Cells(const Count: int):
      return Count;
    when L.Measure.Logical(const Units: int):
      const Scale: int := if Horizontal then
        8
      else
        16
      end if;
      return cast<int>((cast<long>(Units) + Scale - 1L) div Scale);
  end case;
end function;

public type Rect = record
  public X: int;
  public Y: int;
  public Width: int;
  public Height: int;

  public function Contains(Column: int; Row: int): bool;
  begin
    return Column >= self.X and Column - self.X < self.Width and Row >= self.Y and Row - self.Y <
      self.Height;
  end function;
end record;

public function Intersect(Left: Rect; Right: Rect): Rect;
begin
  const X: int := Sys.Math.Max(Left.X, Right.X);
  const Y: int := Sys.Math.Max(Left.Y, Right.Y);
  return new Rect(
    X, Y,
    Sys.Math.Max(0, Sys.Math.Min(Left.X + Left.Width, Right.X + Right.Width) - X),
    Sys.Math.Max(0, Sys.Math.Min(Left.Y + Left.Height, Right.Y + Right.Height) - Y)
  );
end function;

public function PreferredSize(Intrinsic: int; Rule: E.Flex): int;
begin
  if Rule.Minimum < 0 or Rule.Maximum < Rule.Minimum or Rule.Basis < -1
    or not Sys.Single.IsFinite(Rule.Grow) or Rule.Grow < 0.0F
  then
    raise new Sys.ArgumentException('Invalid flex size rule.');
  end if;

  const Basis: int := if Rule.Basis < 0 then
    Intrinsic
  else
    Rule.Basis
  end if;
  return Sys.Math.Clamp(Basis, Rule.Minimum, Rule.Maximum);
end function;

// CUI allocation: growing children share space from zero; fixed sizes never shrink.
// Content children shrink in proportion to their reducible extent.
//
// ## Parameters
// - `Preferred`: Intrinsic cell extents in traversal order.
// - `Settings`: Resolved constraints, one per extent.
// - `Available`: Nonnegative main-axis budget after gaps and padding.
//
// ## Returns
// Sizes rounded at shared boundaries; unsatisfied minimums may overflow the budget.
public function Allocate(Preferred: array of int; Settings: array of E.Flex; Available: int): array of int;
begin
  const Sizes: array of double := new double[Preferred.Length];
  const Frozen: array of bool := new bool[Preferred.Length];
  var Used: double := 0;
  var Weight: double := 0;
  for Index: int := 0 to Sizes.Length - 1 do
    const Rule: E.Flex := Settings[Index];
    if Rule.Basis < 0 and Rule.Grow > 0 then
      Weight := Weight + Rule.Grow;
    else
      Sizes[Index] := PreferredSize(Preferred[Index], Rule);
      Used := Used + Sizes[Index];
    end if;
  end for;

  var Remaining: double := Sys.Math.Max(0, cast<double>(Available) - Used);
  for Pass: int := 0 to Sizes.Length do
    if Weight <= 0 then
      break;
    end if;
    const Unit: double := Remaining / Weight;
    var Changed: bool := false;
    for Index: int := 0 to Sizes.Length - 1 do
      const Rule: E.Flex := Settings[Index];
      if Rule.Basis < 0 and Rule.Grow > 0 and not Frozen[Index] then
        const Desired: double := Unit * Rule.Grow;
        Sizes[Index] := Sys.Math.Clamp(
          Desired,
          cast<double>(Rule.Minimum),
          cast<double>(Rule.Maximum)
        );
        if Sizes[Index] <> Desired then
          Frozen[Index] := true;
          Remaining := Sys.Math.Max(0, Remaining - Sizes[Index]);
          Weight := Weight - Rule.Grow;
          Changed := true;
        end if;
      end if;
    end for;

    if not Changed then
      break;
    end if;
  end for;

  Used := 0;
  var Reducible: double := 0;
  for Index: int := 0 to Sizes.Length - 1 do
    Used := Used + Sizes[Index];
    if Settings[Index].Basis < 0 then
      Reducible := Reducible + Sys.Math.Max(0, Sizes[Index] - Settings[Index].Minimum);
    end if;
  end for;

  if Used > Available and Reducible > 0 then
    const Ratio: double := Sys.Math.Min(1, (Used - Available) / Reducible);
    for Index: int := 0 to Sizes.Length - 1 do
      if Settings[Index].Basis < 0 then
        Sizes[Index] := Sizes[Index] - Sys.Math.Max(
          0,
          Sizes[Index] - Settings[Index].Minimum
        ) * Ratio;
      end if;
    end for;
  end if;

  // Round shared boundaries, preserving the total instead of rounding each child separately.
  const Result: array of int := new int[Sizes.Length];
  var Boundary: double := 0;
  var Previous: long := 0L;
  for Index: int := 0 to Sizes.Length - 1 do
    Boundary := Boundary + Sizes[Index];
    const Edge: long := cast<long>(Sys.Math.Round(Boundary, Sys.MidpointRounding.AwayFromZero));
    Result[Index] := cast<int>(Sys.Math.Min(
      cast<long>(int.MaxValue),
      Sys.Math.Max(0L, Edge - Previous)
    ));
    Previous := Edge;
  end for;

  return Result;
end function;

public type AllocationMemo = record
  public Key: string;
  public Sizes: array of int;
end record;

public function AllocateCached(
  Preferred: array of int; Rules: array of E.Flex; Available: int;
  Previous: array of AllocationMemo; Next: Generic.List<AllocationMemo>
): array of int;
begin
  const Signature: Text.StringBuilder := new Text.StringBuilder();
  discard Signature.Append(Available);
  for Index: int := 0 to Preferred.Length - 1 do
    const Rule: E.Flex := Rules[Index];
    discard Signature.Append('/').Append(
      Preferred[Index]
    ).Append('/').Append(
      Rule.Basis
    ).Append('/').Append(
      Rule.Minimum
    ).Append('/').Append(
      Rule.Maximum
    ).Append('/').Append(Rule.Grow);
  end for;
  const Key: string := Signature.ToString();
  const Index: int := Next.Count;
  if Index < Previous.Length and Previous[Index].Key = Key then
    const Reused: AllocationMemo := Previous[Index];
    Next.Add(Reused);
    return Reused.Sizes;
  end if;
  const Sizes: array of int := Allocate(Preferred, Rules, Available);
  Next.Add(new AllocationMemo(Key, Sizes));
  return Sizes;
end function;

end unit;
