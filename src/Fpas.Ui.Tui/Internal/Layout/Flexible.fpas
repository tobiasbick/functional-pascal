// [Documentation](../../../../docs/ui/tui/host.md#views-layout-and-validation)

unit Fpas.Ui.Tui.Internal.Layout.Flexible;

uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Tui.Internal.View.Tree as E;

uses System as Sys;

// Resolves an explicit terminal distance.
//
// ## Parameters
// - `Value`: Validated cell or portable logical measure.
// - `Horizontal`: Whether the distance is measured in columns rather than rows.
//
// ## Returns
// Cell count.
public function Cells(Value: L.Measure; Horizontal: bool := true): int;
begin
  case Value of
    when L.Measure.Cells(const Count: int):
      return Count;
    when L.Measure.Logical(const Units: int):
      const Scale: int := if Horizontal then
        8
      else
        16
      end if;
      return cast ((cast Units as long + Scale - 1L) div Scale) as int;
  end case;
end function;

// Converts shared flex rules into resolved cell constraints.
//
// ## Parameters
// - `Value`: Validated shared rule.
// - `Horizontal`: Parent main axis.
//
// ## Returns
// Cell allocation constraints.
public function Flex(Value: L.Flex; Horizontal: bool := true): E.Flex;
begin
  var Basis: int := -1;
  var Grow: float := Value.Grow;
  case Value.Basis of
    when L.Extent.Fixed(const Distance: L.Measure):
      Basis := Cells(Distance, Horizontal);
    when L.Extent.Fill:
      Grow := Sys.Math.Max(1.0F, Grow);
    when L.Extent.Percent(_):
      raise new Sys.NotSupportedException('Percentage extents require the graphical profile.');
    else
  end case;
  const Minimum: L.Measure? := Value.Minimum;
  const Maximum: L.Measure? := Value.Maximum;
  return new E.Flex(
    Basis, if Minimum = null then
      0
    else
      Cells(Minimum, Horizontal)
    end if,
    if Maximum = null then
      int.MaxValue
    else
      Cells(Maximum, Horizontal)
    end if, Grow
  );
end function;

// Resolves a shared spacing rule in terminal cells.
// ## Parameters
// - `Value`: Shared spacing rule.
// - `Horizontal`: Whether the spacing is horizontal.
// ## Returns
// The number of terminal cells.
public function Spacing(Value: L.Spacing; Horizontal: bool): int;
begin
  case Value of
    when L.Spacing.None:
      return 0;
    when L.Spacing.Tight:
      return 1;
    when L.Spacing.Normal:
      return 1;
    when L.Spacing.Loose:
      return if Horizontal then
        2
      else
        1
      end if;
    when L.Spacing.Fixed(const Distance: L.Measure):
      return Cells(Distance, Horizontal);
  end case;
end function;

// A half-open cell rectangle within the terminal scene.
public type Rect = record
  // Column of the left edge.
  public X: int;
  // Row of the top edge.
  public Y: int;
  // Number of columns spanned.
  public Width: int;
  // Number of rows spanned.
  public Height: int;

  // Tests whether a terminal cell lies within the rectangle.
  // ## Parameters
  // - `Column`: Cell column in scene coordinates.
  // - `Row`: Cell row in scene coordinates.
  // ## Returns
  // Whether the cell is covered by the rectangle.
  public function Contains(Column: int; Row: int): bool;
  begin
    return Column >= self.X and Column - self.X < self.Width and Row >= self.Y and Row - self.Y <
      self.Height;
  end function;
end record;

// Clips two rectangles to their common cells.
// ## Parameters
// - `Left`: First rectangle.
// - `Right`: Second rectangle.
// ## Returns
// Their overlap, with zero extent on any disjoint axis.
public function Intersect(Left: Rect; Right: Rect): Rect;
begin
  const X: int := Sys.Math.Max(Left.X, Right.X);
  const Y: int := Sys.Math.Max(Left.Y, Right.Y);
  return new Rect(
    X, Y,
    Sys.Math.Max(0, Sys.Math.Min(Left.X + Left.Width, Right.X + Right.Width) - X),
    Sys.Math.Max(0, Sys.Math.Min(Left.Y + Left.Height, Right.Y + Right.Height) - Y)
  );
end function;

// Applies a resolved flex basis and size limits to an intrinsic measurement.
// ## Parameters
// - `Intrinsic`: Measured content extent in cells.
// - `Rule`: Cell constraints for the allocated axis.
// ## Returns
// Preferred extent before distributing available space.
public function PreferredSize(Intrinsic: int; Rule: E.Flex): int;
begin
  if Rule.Minimum < 0 or Rule.Maximum < Rule.Minimum or Rule.Basis < -1
    or not Sys.Single.IsFinite(Rule.Grow) or Rule.Grow < 0.0F
  then
    raise new Sys.ArgumentException('Invalid flex size rule.');
  end if;

  const Basis: int := if Rule.Basis < 0 then
    Intrinsic
  else
    Rule.Basis
  end if;
  return Sys.Math.Clamp(Basis, Rule.Minimum, Rule.Maximum);
end function;

// CUI allocation: growing children share space from zero; fixed sizes never shrink.
// Content children shrink in proportion to their reducible extent.
//
// ## Parameters
// - `Preferred`: Intrinsic cell extents in traversal order.
// - `Settings`: Resolved constraints, one per extent.
// - `Available`: Nonnegative main-axis budget after gaps and padding.
//
// ## Returns
// Sizes rounded at shared boundaries; unsatisfied minimums may overflow the budget.
public function Allocate(
  Preferred: array of int;
  Settings: array of E.Flex;
  Available: int
): array of int;
begin
  const Sizes: array of double := new double[Preferred.Length];
  const Frozen: array of bool := new bool[Preferred.Length];
  var Used: double := 0;
  var Weight: double := 0;
  for Index: int := 0 to Sizes.Length - 1 do
    const Rule: E.Flex := Settings[Index];
    if Rule.Basis < 0 and Rule.Grow > 0 then
      Weight := Weight + Rule.Grow;
    else
      Sizes[Index] := PreferredSize(Preferred[Index], Rule);
      Used := Used + Sizes[Index];
    end if;
  end for;

  var Remaining: double := Sys.Math.Max(0, cast Available as double - Used);
  for Pass: int := 0 to Sizes.Length do
    if Weight <= 0 then
      break;
    end if;
    const Unit: double := Remaining / Weight;
    var Changed: bool := false;
    for Index: int := 0 to Sizes.Length - 1 do
      const Rule: E.Flex := Settings[Index];
      if Rule.Basis < 0 and Rule.Grow > 0 and not Frozen[Index] then
        const Desired: double := Unit * Rule.Grow;
        Sizes[Index] := Sys.Math.Clamp(
          Desired,
          cast Rule.Minimum as double,
          cast Rule.Maximum as double
        );
        if Sizes[Index] <> Desired then
          Frozen[Index] := true;
          Remaining := Sys.Math.Max(0, Remaining - Sizes[Index]);
          Weight := Weight - Rule.Grow;
          Changed := true;
        end if;
      end if;
    end for;

    if not Changed then
      break;
    end if;
  end for;

  Used := 0;
  var Reducible: double := 0;
  for Index: int := 0 to Sizes.Length - 1 do
    Used := Used + Sizes[Index];
    if Settings[Index].Basis < 0 then
      Reducible := Reducible + Sys.Math.Max(0, Sizes[Index] - Settings[Index].Minimum);
    end if;
  end for;

  if Used > Available and Reducible > 0 then
    const Ratio: double := Sys.Math.Min(1, (Used - Available) / Reducible);
    for Index: int := 0 to Sizes.Length - 1 do
      if Settings[Index].Basis < 0 then
        Sizes[Index] := Sizes[Index] - Sys.Math.Max(
          0,
          Sizes[Index] - Settings[Index].Minimum
        ) * Ratio;
      end if;
    end for;
  end if;

  // Round shared boundaries, preserving the total instead of rounding each child separately.
  const Result: array of int := new int[Sizes.Length];
  var Boundary: double := 0;
  var Previous: long := 0L;
  for Index: int := 0 to Sizes.Length - 1 do
    Boundary := Boundary + Sizes[Index];
    const Edge: long := cast Sys.Math.Round(Boundary, Sys.MidpointRounding.AwayFromZero) as long;
    Result[Index] := cast Sys.Math.Min(
      cast int.MaxValue as long,
      Sys.Math.Max(0L, Edge - Previous)
    ) as int;
    Previous := Edge;
  end for;

  return Result;
end function;

// Reusable allocation for a previous set of sizes, rules and available space.
public type AllocationMemo = record
  // Structural identity of the allocation inputs.
  public Key: string;
  // Allocated cell counts in child order.
  public Sizes: array of int;
end record;

end unit;
