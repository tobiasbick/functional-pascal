// [Documentation](../../../../docs/ui/tui/host.md#views-layout-and-validation)

unit Fpas.Ui.Tui.Internal.Layout.Measurement;

uses Fpas.Ui.Tui.Internal.Widgets.Navigation.Pagination as Pagination, Fpas.Ui.Widgets.Overlays.CommandPalettes as Palettes, Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Layout as L, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, Fpas.Ui.Tui.Internal.Layout.Flexible as F, System as Sys;

public function FlexRule<TMsg>(Node: E.Element<TMsg>): E.Flex;
begin
  case Node of
    when E.Element.Palette(_, const Base: E.Element<TMsg>, _, _, _, _):
      return FlexRule<TMsg>(Base);
    when E.Element.CellGrid(_, _, _):
      return new E.Flex(Grow := 1);
    when E.Element.Sized(_, const Rule: E.Flex):
      return Rule;
    when E.Element.Decorated(const Child: E.Element<TMsg>, _), E.Element.DisclosureBody(
      _,
      const Child: E.Element<TMsg>,
      _
    ):
      return FlexRule<TMsg>(Child);
    else
      return new E.Flex();
  end case;
end function;

// Resolves CUI minimum-content bounds using terminal text metrics.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Node`: Resolved terminal subtree.
// - `Horizontal`: Whether to measure width instead of height.
// - `ParentHorizontal`: Main axis of the enclosing stack; defaults to the measured axis.
//
// ## Returns
// The subtree's minimum content extent in cells.
public function Minimum<TMsg>(Node: E.Element<TMsg>; Horizontal: bool; ParentHorizontal: bool? := null): int;
begin
  case Node of
    when E.Element.Log(_, _, _):
      return 1;
    when E.Element.Palette(_, const Base: E.Element<TMsg>, _, _, _, _):
      return Minimum<TMsg>(Base, Horizontal, ParentHorizontal);
    when E.Element.ChoiceStrip(_):
      return if Horizontal then
        1
      else
        Intrinsic<TMsg>(Node, false)
      end if;
    when E.Element.Table(
      _
    ), E.Element.SelectionList(
      _
    ), E.Element.TextField(_), E.Element.TextArea(_), E.Element.Pager(_), E.Element.Breadcrumb(_):
      return 1;
    when E.Element.StatusBar(_, _):
      return if Horizontal then
        0
      else
        Intrinsic<TMsg>(Node, false)
      end if;
    when E.Element.Label(const Value: string):
      if not Horizontal then
        return if Value = '' then
          0
        else
          G.LineCount(Value, -1)
        end if;
      end if;
      var Width: int := 0;
      for Word: string in Value.Split(new char[0], Sys.StringSplitOptions.RemoveEmptyEntries) do
        Width := Sys.Math.Max(Width, G.Measure(Word));
      end for;

      return Width;
    when E.Element.Sized(const Child: E.Element<TMsg>, const Rule: E.Flex):
      const Content: int := Minimum<TMsg>(Child, Horizontal, ParentHorizontal);
      if Horizontal <> (ParentHorizontal ?? Horizontal) then
        return Content;
      end if;

      return Sys.Math.Clamp(
        if Rule.Basis >= 0 then
          Rule.Basis
        else
          Content
        end if,
        Rule.Minimum,
        Rule.Maximum
      );
    when E.Element.Decorated(
      const Child: E.Element<TMsg>,
      _
    ), E.Element.DisclosureBody(_, const Child: E.Element<TMsg>, _):
      return Minimum<TMsg>(Child, Horizontal, ParentHorizontal);
    when E.Element.Stack(
      const Children: array of E.Element<TMsg>,
      const Axis: bool,
      const Flow: E.Flow
    ):
      var Span: int := 0;
      for Child: E.Element<TMsg> in Children do
        const Size: int := Minimum<TMsg>(Child, Horizontal, Axis);
        Span := if Axis = Horizontal then
          Span + Size
        else
          Sys.Math.Max(Span, Size)
        end if;
      end for;

      return Span + 2 * (if Horizontal then
        Flow.PaddingX
      else
        Flow.PaddingY
      end if) + (if Axis = Horizontal then
        Sys.Math.Max(
          0,
          Children.Length - 1
        ) * Flow.Gap
      else
        0
      end if);
    when E.Element.Scrollable(_, _, _), E.Element.ControlledScroll(
      _,
      _,
      _,
      _,
      _
    ), E.Element.ModalPanel(
      _,
      _,
      _,
      _,
      _,
      _
    ):
      return 0;
    when E.Element.Framed(const Child: E.Element<TMsg>, _):
      return Minimum<TMsg>(Child, Horizontal, false) + 2;
    else
      return Intrinsic<TMsg>(Node, Horizontal);
  end case;
end function;

// Combines explicit bounds with CUI minimum-content sizing for one axis.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Node`: Resolved terminal subtree.
// - `Horizontal`: Parent main axis.
//
// ## Returns
// Constraints with a resolved minimum content size.
public function AllocationRule<TMsg>(Node: E.Element<TMsg>; Horizontal: bool): E.Flex;
begin
  case Node of
    when E.Element.TextArea(const Area: AreaEdit.Field<TMsg>):
      if not Horizontal and Area.Settings.Height < 0 then
        return new E.Flex(Minimum := 1, Grow := 1);
      end if;
    when E.Element.Table(const Table: E.TableView<TMsg>):
      if not Horizontal then
        case Table.Settings.Height of
          when L.Extent.Fill:
            return new E.Flex(Minimum := 1, Grow := 1);
          when L.Extent.Fixed(const Distance: L.Measure):
            return new E.Flex(Basis := F.Cells(Distance, false));
          else
        end case;
      end if;
    else
  end case;

  if Horizontal then
    case Node of
      when E.Element.TextField(_), E.Element.TextArea(_):
        return new E.Flex(Grow := 1);
      when E.Element.Pager(_), E.Element.Breadcrumb(_):
        return new E.Flex(Minimum := 1);
      when E.Element.ChoiceStrip(const Strip: E.ChoiceStripView<TMsg>):
        return new E.Flex(
          Minimum := 1, Grow := if Strip.Settings.FullWidth then
            1
          else
            0
          end if
        );
      when E.Element.Progress(_, _, _, const Width: int?, _):
        if Width <> null then
          return new E.Flex(Basis := Width.Value, Maximum := Width.Value);
        end if;

        return new E.Flex(Grow := 1);
      when E.Element.Sparkline(_, _, const Fill: bool, _) if Fill:
        return new E.Flex(Grow := 1);
      when E.Element.Action(_, _, _, const View: E.ActionView):
        const Width: int? := View.FixedWidth;
        if Width <> null then
          return new E.Flex(Basis := Width.Value, Minimum := Width.Value, Maximum := Width.Value);
        end if;

        if View.FillWidth then
          return new E.Flex(Grow := 1);
        end if;
      when E.Element.Decorated(const Child: E.Element<TMsg>, _), E.Element.DisclosureBody(
        _,
        const Child: E.Element<TMsg>,
        _
      ):
        return AllocationRule<TMsg>(Child, Horizontal);
      else
    end case;
  end if;
  const Rule: E.Flex := FlexRule<TMsg>(Node);
  if Rule.Basis >= 0 then
    return Rule;
  end if;

  return Rule with
    Minimum := Sys.Math.Min(
      Rule.Maximum,
      Sys.Math.Max(Rule.Minimum, Minimum<TMsg>(Node, Horizontal))
    );
  end with;
end function;

// Reports whether a node can stretch across its parent's axis.
// Intrinsically sized controls retain CUI's natural extent by default.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Node`: Resolved terminal subtree.
// - `Horizontal`: Whether the cross axis is horizontal.
// - `Explicit`: Whether the caller explicitly requested stretching.
//
// ## Returns
// True when the node can fill this cross-axis extent.
public function CanStretch<TMsg>(Node: E.Element<TMsg>; Horizontal: bool; Explicit: bool := false): bool;
begin
  case Node of
    when E.Element.ChoiceStrip(const Strip: E.ChoiceStripView<TMsg>):
      return Horizontal and (Explicit or Strip.Settings.FullWidth);
    when E.Element.Sparkline(_, _, const Fill: bool, _):
      return Horizontal and Fill;
    when E.Element.Spinner(_, _, _):
      return false;
    when E.Element.Pager(_), E.Element.Breadcrumb(_):
      return Horizontal;
    when E.Element.Action(_, _, _, const View: E.ActionView):
      return Horizontal and (View.FillWidth or (Explicit and View.FixedWidth = null));
    when E.Element.Sized(
      const Child: E.Element<TMsg>,
      _
    ), E.Element.Decorated(const Child: E.Element<TMsg>, _), E.Element.DisclosureBody(
      _,
      const Child: E.Element<TMsg>,
      _
    ):
      return CanStretch<TMsg>(Child, Horizontal, Explicit);
    else
      return true;
  end case;
end function;

public function CrossWidth<TMsg>(Node: E.Element<TMsg>; Available: int; Align: L.Alignment): int;
begin
  return if (Align = L.Alignment.Stretch or Align = L.Alignment.Default) and CanStretch<TMsg>(
    Node,
    true
  )
  then
    Available
  else
    Sys.Math.Min(Available, Intrinsic<TMsg>(Node, true))
  end if;
end function;

function WrappedStackHeight<TMsg>(
  Children: array of E.Element<TMsg>; Axis: bool; Rule: E.Flow; Columns: int
): int;
begin
  const Width: int := Sys.Math.Max(0, Columns - 2 * Rule.PaddingX);
  const Gaps: int := Sys.Math.Max(0, Children.Length - 1) * Rule.Gap;
  if Axis then
    const Preferred: array of int := new int[Children.Length];
    const Rules: array of E.Flex := Sys.Array.ConvertAll<E.Element<TMsg>, E.Flex>(
      Children,
      function(Child: E.Element<TMsg>): E.Flex => AllocationRule<TMsg>(Child, true)
    );
    for Index: int := 0 to Children.Length - 1 do
      Preferred[Index] := Intrinsic<TMsg>(Children[Index], true);
    end for;
    const Widths: array of int := F.Allocate(Preferred, Rules, Sys.Math.Max(0, Width - Gaps));
    var Height: int := 0;
    for Index: int := 0 to Children.Length - 1 do
      if Widths[Index] > 0 then
        Height := Sys.Math.Max(Height, Intrinsic<TMsg>(Children[Index], false, Widths[Index]));
      end if;
    end for;

    return Height + 2 * Rule.PaddingY;
  end if;

  var Height: int := 2 * Rule.PaddingY + Gaps;
  for Child: E.Element<TMsg> in Children do
    const ChildWidth: int := CrossWidth<TMsg>(Child, Width, Rule.Align);
    Height := Height + F.PreferredSize(
      Intrinsic<TMsg>(Child, false, ChildWidth),
      FlexRule<TMsg>(Child)
    );
  end for;

  return Height;
end function;

public function Intrinsic<TMsg>(Node: E.Element<TMsg>; Horizontal: bool; Columns: int := -1): int;
begin
  case Node of
    when E.Element.Log(_, _, _):
      return if Horizontal then
        32
      else
        8
      end if;
    when E.Element.Palette(_, const Base: E.Element<TMsg>, _, _, _, _):
      return Intrinsic<TMsg>(Base, Horizontal, Columns);
    when E.Element.SelectionList(const List: E.SelectionListView<TMsg>):
      return if Horizontal then
        List.Width
      else
        Sys.Math.Max(1, Sys.Math.Min(List.MaximumRows, List.Items.Length))
      end if;
    when E.Element.Pager(const Pager: E.PagerView<TMsg>):
      return if Horizontal then
        Pagination.PreferredWidth(Pager.Count)
      else
        1
      end if;
    when E.Element.Breadcrumb(const Trail: E.BreadcrumbView<TMsg>):
      return if Horizontal then
        Trail.Width
      else
        1
      end if;
    when E.Element.ChoiceStrip(const Strip: E.ChoiceStripView<TMsg>):
      if not Horizontal then
        return if Strip.Settings.Underline then
          Strip.Settings.Height + 1
        else
          Strip.Settings.Height
        end if;
      end if;
      var Width: int := Strip.Widths.Length - 1;
      for Item: int in Strip.Widths do
        Width := Width + Item;
      end for;

      return Width;
    when E.Element.Table(const Table: E.TableView<TMsg>):
      if Horizontal then
        var Width: int := Sys.Math.Min(E.MaximumColumns, Table.Columns.Length - 1);
        for Cells: int in Table.Preferred do
          Width := Width + Sys.Math.Min(Cells, E.MaximumColumns - Width);
        end for;

        return Width;
      end if;

      case Table.Settings.Height of
        when L.Extent.Fixed(const Distance: L.Measure):
          return F.Cells(Distance, false);
        else
          return Table.Rows.Length + 1;
      end case;
    when E.Element.Label(const Value: string):
      if Horizontal then
        return G.LineWidth(Value);
      end if;

      return G.LineCount(Value, Columns);
    when E.Element.StatusBar(const Row: E.Element<TMsg>, const HideBorder: bool):
      if Horizontal then
        return Intrinsic<TMsg>(Row, true);
      end if;

      return if HideBorder then
        1
      else
        2
      end if;
    when E.Element.TextField(_):
      return if Horizontal then
        24
      else
        1
      end if;
    when E.Element.TextArea(const Field: AreaEdit.Field<TMsg>):
      return if Horizontal then
        24
      else
        Field.Rows
      end if;
    when E.Element.CellGrid(_, _, _):
      return 1;
    when E.Element.Spinner(_, _, _):
      return 1;
    when E.Element.Sparkline(_, const Width: int, _, _):
      return if Horizontal then
        Width
      else
        1
      end if;
    when E.Element.Progress(_, const Caption: string, const Percent: string, const Width: int?, _):
      if Horizontal then
        return Width ?? (G.Measure(Caption) + Percent.Length + 8);
      end if;

      return 1;
    when E.Element.Action(_, _, _, const View: E.ActionView):
      if Horizontal then
        if View.FixedWidth <> null then
          return View.FixedWidth.Value;
        end if;
        var Width: int := G.Measure(View.Caption);
        if View.Description <> '' then
          Width := Sys.Math.Max(Width, G.LineWidth(View.Description));
        end if;

        return Sys.Math.Max(View.MinimumWidth, Width + 2 * View.Padding);
      end if;

      if View.Description = '' then
        return View.Height;
      end if;

      return View.Height + G.LineCount(View.Description, Columns - 2 * View.Padding);
    when E.Element.Stack(
      const Children: array of E.Element<TMsg>,
      const Axis: bool,
      const Rule: E.Flow
    ):
      if not Horizontal and Columns >= 0 then
        return WrappedStackHeight<TMsg>(Children, Axis, Rule, Columns);
      end if;
      var Size: int := 0;
      for Child: E.Element<TMsg> in Children do
        const Span: int := Intrinsic<TMsg>(Child, Horizontal);
        Size := if Axis = Horizontal then
          Size + Span
        else
          Sys.Math.Max(Size, Span)
        end if;
      end for;

      return Size + 2 * (if Horizontal then
        Rule.PaddingX
      else
        Rule.PaddingY
      end if) + (if Axis = Horizontal then
        Sys.Math.Max(
          0,
          Children.Length - 1
        ) * Rule.Gap
      else
        0
      end if);
    when E.Element.Sized(
      const Child: E.Element<TMsg>,
      _
    ), E.Element.Decorated(
      const Child: E.Element<TMsg>,
      _
    ), E.Element.DisclosureBody(
      _,
      const Child: E.Element<TMsg>,
      _
    ), E.Element.Scrollable(_, const Child: E.Element<TMsg>, _), E.Element.ControlledScroll(
      _, const Child: E.Element<TMsg>, _, _, _
    ), E.Element.Desktop(
      const Child: E.Element<TMsg>,
      _,
      _
    ):
      return Intrinsic<TMsg>(Child, Horizontal, Columns);
    when E.Element.ModalPanel(_, _, _, _, _, _):
      return 0;
    when E.Element.Framed(const Child: E.Element<TMsg>, const Title: string):
      return Sys.Math.Max(
        Intrinsic<TMsg>(
          Child,
          Horizontal,
          if Columns < 0 then
            -1
          else
            Sys.Math.Max(0, Columns - 2)
          end if
        ),
        if Horizontal then
          G.Measure(Title)
        else
          0
        end if
      ) + 2;
  end case;
end function;

end unit;
