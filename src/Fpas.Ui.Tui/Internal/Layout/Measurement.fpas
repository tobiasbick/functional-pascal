// [Documentation](../../../../docs/ui/tui/layout/rows-and-columns.md)

unit Fpas.Ui.Tui.Internal.Layout.Measurement;

uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Rendering.Glyphs as G;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit;

uses System as Sys;
uses System.Globalization as Global;

function LineWidth(Value: string): int;
begin
  const Glyphs: Global.TextElementEnumerator := Global.StringInfo.GetTextElementEnumerator(Value);
  var Longest: int := 0;
  var Cells: int := 0;
  while Glyphs.MoveNext() do
    const Glyph: string := Glyphs.GetTextElement();
    if G.LineBreak(Glyph) then
      Longest := Sys.Math.Max(Longest, Cells);
      Cells := 0;
    else
      Cells := Cells + G.Width(Glyph);
    end if;
  end while;

  return Sys.Math.Max(Longest, Cells);
end function;

function LineCount(Value: string; Columns: int): int;
begin
  const Glyphs: Global.TextElementEnumerator := Global.StringInfo.GetTextElementEnumerator(Value);
  var Rows: int := 1;
  var Cells: int := 0;
  while Glyphs.MoveNext() do
    const Glyph: string := Glyphs.GetTextElement();
    if G.LineBreak(Glyph) then
      Rows := Rows + 1;
      Cells := 0;
    else
      if Columns > 0 then
        const Span: int := G.Width(Glyph);
        if Cells + Span > Columns then
          Rows := Rows + 1;
          Cells := 0;
        end if;

        if Span <= Columns then
          Cells := Cells + Span;
        end if;
      end if;
    end if;
  end while;

  return Rows;
end function;

// Measures the expanded pager, allowing space for both possible ellipses.
// ## Parameters
// - `Count`: Positive page count.
// ## Returns
// The width in terminal cells at which numbered buttons fit on every page.
public function PagerWidth(Count: int): int;
begin
  const Numbers: int := if Count <= 7 then
    Count
  else
    5
  end if;
  const Ellipses: int := if Count <= 7 then
    0
  else
    2
  end if;
  const Digits: int := Count.ToString(Global.CultureInfo.InvariantCulture).Length;
  return 6 + Numbers * (Digits + 2) + Ellipses + (Numbers + Ellipses + 1);
end function;

// Gets an element's explicit flex sizing or its default constraints.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Prepared terminal element.
// ## Returns
// The element's resolved size constraints.
public function FlexRule of TMsg(Node: E.Element of TMsg): E.Flex;
begin
  case Node of
    when E.Element.Palette(_, const Base: E.Element of TMsg, _, _, _, _):
      return FlexRule of TMsg(Base);
    when E.Element.CellGrid(_, _, _):
      return new E.Flex(Grow := 1);
    when E.Element.Sized(_, const Rule: E.Flex):
      return Rule;
    when E.Element.Decorated(const Child: E.Element of TMsg, _), E.Element.DisclosureBody(
      _,
      const Child: E.Element of TMsg,
      _
    ):
      return FlexRule of TMsg(Child);
    else
      return new E.Flex();
  end case;
end function;

// Resolves CUI minimum-content bounds using terminal text metrics.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Node`: Resolved terminal subtree.
// - `Horizontal`: Whether to measure width instead of height.
// - `ParentHorizontal`: Main axis of the enclosing stack; defaults to the measured axis.
//
// ## Returns
// The subtree's minimum content extent in cells.
public function Minimum of TMsg(
  Node: E.Element of TMsg;
  Horizontal: bool;
  ParentHorizontal: bool? := null
): int;
begin
  case Node of
    when E.Element.Log(_, _, _):
      return 1;
    when E.Element.Palette(_, const Base: E.Element of TMsg, _, _, _, _):
      return Minimum of TMsg(Base, Horizontal, ParentHorizontal);
    when E.Element.ChoiceStrip(_):
      return if Horizontal then
        1
      else
        Intrinsic of TMsg(Node, false)
      end if;
    when E.Element.Table(
      _
    ), E.Element.SelectionList(
      _
    ), E.Element.TextField(_), E.Element.TextArea(_), E.Element.Pager(_), E.Element.Breadcrumb(_):
      return 1;
    when E.Element.StatusBar(_, _):
      return if Horizontal then
        0
      else
        Intrinsic of TMsg(Node, false)
      end if;
    when E.Element.Label(const Value: string):
      if not Horizontal then
        return if Value = '' then
          0
        else
          LineCount(Value, -1)
        end if;
      end if;
      var Width: int := 0;
      for Word: string in Value.Split(new char[0], Sys.StringSplitOptions.RemoveEmptyEntries) do
        Width := Sys.Math.Max(Width, G.Measure(Word));
      end for;

      return Width;
    when E.Element.Sized(const Child: E.Element of TMsg, const Rule: E.Flex):
      const Content: int := Minimum of TMsg(Child, Horizontal, ParentHorizontal);
      if Horizontal <> (ParentHorizontal ?? Horizontal) then
        return Content;
      end if;

      return Sys.Math.Clamp(
        if Rule.Basis >= 0 then
          Rule.Basis
        else
          Content
        end if,
        Rule.Minimum,
        Rule.Maximum
      );
    when E.Element.Decorated(
      const Child: E.Element of TMsg,
      _
    ), E.Element.DisclosureBody(_, const Child: E.Element of TMsg, _):
      return Minimum of TMsg(Child, Horizontal, ParentHorizontal);
    when E.Element.Stack(
      const Children: array of E.Element of TMsg,
      const Axis: bool,
      const Flow: E.Flow
    ):
      var Span: int := 0;
      for Child: E.Element of TMsg in Children do
        const Size: int := Minimum of TMsg(Child, Horizontal, Axis);
        Span := if Axis = Horizontal then
          Span + Size
        else
          Sys.Math.Max(Span, Size)
        end if;
      end for;

      return Span + 2 * (if Horizontal then
        Flow.PaddingX
      else
        Flow.PaddingY
      end if) + (if Axis = Horizontal then
        Sys.Math.Max(
          0,
          Children.Length - 1
        ) * Flow.Gap
      else
        0
      end if);
    when E.Element.Scrollable(_, _, _), E.Element.ControlledScroll(
      _,
      _,
      _,
      _,
      _
    ), E.Element.ModalPanel(
      _,
      _,
      _,
      _,
      _,
      _
    ):
      return 0;
    when E.Element.Framed(const Child: E.Element of TMsg, _):
      return Minimum of TMsg(Child, Horizontal, false) + 2;
    else
      return Intrinsic of TMsg(Node, Horizontal);
  end case;
end function;

// Combines explicit bounds with CUI minimum-content sizing for one axis.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Node`: Resolved terminal subtree.
// - `Horizontal`: Parent main axis.
//
// ## Returns
// Constraints with a resolved minimum content size.
public function AllocationRule of TMsg(Node: E.Element of TMsg; Horizontal: bool): E.Flex;
begin
  case Node of
    when E.Element.TextArea(const Area: AreaEdit.Field of TMsg):
      if not Horizontal and Area.Settings.Height < 0 then
        return new E.Flex(Minimum := 1, Grow := 1);
      end if;
    when E.Element.Table(const Table: E.TableView of TMsg):
      if not Horizontal then
        case Table.Settings.Height of
          when L.Extent.Fill:
            return new E.Flex(Minimum := 1, Grow := 1);
          when L.Extent.Fixed(const Distance: L.Measure):
            return new E.Flex(Basis := F.Cells(Distance, false));
          else
        end case;
      end if;
    else
  end case;

  if Horizontal then
    case Node of
      when E.Element.TextField(_), E.Element.TextArea(_):
        return new E.Flex(Grow := 1);
      when E.Element.Pager(_), E.Element.Breadcrumb(_):
        return new E.Flex(Minimum := 1);
      when E.Element.ChoiceStrip(const Strip: E.ChoiceStripView of TMsg):
        return new E.Flex(
          Minimum := 1, Grow := if Strip.Settings.FullWidth then
            1
          else
            0
          end if
        );
      when E.Element.Progress(_, _, _, const Width: int?, _):
        if Width <> null then
          return new E.Flex(Basis := Width.Value, Maximum := Width.Value);
        end if;

        return new E.Flex(Grow := 1);
      when E.Element.Sparkline(_, _, const Fill: bool, _) if Fill:
        return new E.Flex(Grow := 1);
      when E.Element.Action(_, _, _, const View: E.ActionView):
        const Width: int? := View.FixedWidth;
        if Width <> null then
          return new E.Flex(Basis := Width.Value, Minimum := Width.Value, Maximum := Width.Value);
        end if;

        if View.FillWidth then
          return new E.Flex(Grow := 1);
        end if;
      when E.Element.Decorated(const Child: E.Element of TMsg, _), E.Element.DisclosureBody(
        _,
        const Child: E.Element of TMsg,
        _
      ):
        return AllocationRule of TMsg(Child, Horizontal);
      else
    end case;
  end if;
  const Rule: E.Flex := FlexRule of TMsg(Node);
  if Rule.Basis >= 0 then
    return Rule;
  end if;

  return Rule with
    Minimum := Sys.Math.Min(
      Rule.Maximum,
      Sys.Math.Max(Rule.Minimum, Minimum of TMsg(Node, Horizontal))
    );
  end with;
end function;

// Reports whether a node can stretch across its parent's axis.
// Intrinsically sized controls retain CUI's natural extent by default.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Node`: Resolved terminal subtree.
// - `Horizontal`: Whether the cross axis is horizontal.
// - `Explicit`: Whether the caller explicitly requested stretching.
//
// ## Returns
// True when the node can fill this cross-axis extent.
public function CanStretch of TMsg(
  Node: E.Element of TMsg;
  Horizontal: bool;
  Explicit: bool := false
): bool;
begin
  case Node of
    when E.Element.ChoiceStrip(const Strip: E.ChoiceStripView of TMsg):
      return Horizontal and (Explicit or Strip.Settings.FullWidth);
    when E.Element.Sparkline(_, _, const Fill: bool, _):
      return Horizontal and Fill;
    when E.Element.Spinner(_, _):
      return false;
    when E.Element.Pager(_), E.Element.Breadcrumb(_):
      return Horizontal;
    when E.Element.Action(_, _, _, const View: E.ActionView):
      return Horizontal and (View.FillWidth or (Explicit and View.FixedWidth = null));
    when E.Element.Sized(
      const Child: E.Element of TMsg,
      _
    ), E.Element.Decorated(const Child: E.Element of TMsg, _), E.Element.DisclosureBody(
      _,
      const Child: E.Element of TMsg,
      _
    ):
      return CanStretch of TMsg(Child, Horizontal, Explicit);
    else
      return true;
  end case;
end function;

// Resolves the width of a child in a vertical stack.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Prepared terminal element.
// - `Available`: Available columns in the stack.
// - `Align`: Cross-axis alignment.
// ## Returns
// Columns assigned to the child for painting and text wrapping.
public function CrossWidth of TMsg(
  Node: E.Element of TMsg;
  Available: int;
  Align: L.Alignment
): int;
begin
  return if (Align = L.Alignment.Stretch or Align = L.Alignment.Default) and CanStretch of TMsg(
    Node,
    true
  )
  then
    Available
  else
    Sys.Math.Min(Available, Intrinsic of TMsg(Node, true))
  end if;
end function;

function WrappedStackHeight of TMsg(
  Children: array of E.Element of TMsg;
  Axis: bool;
  Rule: E.Flow;
  Columns: int
): int;
begin
  const Width: int := Sys.Math.Max(0, Columns - 2 * Rule.PaddingX);
  const Gaps: int := Sys.Math.Max(0, Children.Length - 1) * Rule.Gap;
  if Axis then
    const Preferred: array of int := new int[Children.Length];
    const Rules: array of E.Flex := Sys.Array.ConvertAll of (E.Element of TMsg, E.Flex)(
      Children,
      function(Child: E.Element of TMsg): E.Flex => AllocationRule of TMsg(Child, true)
    );
    for Index: int := 0 to Children.Length - 1 do
      Preferred[Index] := Intrinsic of TMsg(Children[Index], true);
    end for;
    const Widths: array of int := F.Allocate(Preferred, Rules, Sys.Math.Max(0, Width - Gaps));
    var Height: int := 0;
    for Index: int := 0 to Children.Length - 1 do
      if Widths[Index] > 0 then
        Height := Sys.Math.Max(Height, Intrinsic of TMsg(Children[Index], false, Widths[Index]));
      end if;
    end for;

    return Height + 2 * Rule.PaddingY;
  end if;

  var Height: int := 2 * Rule.PaddingY + Gaps;
  for Child: E.Element of TMsg in Children do
    const ChildWidth: int := CrossWidth of TMsg(Child, Width, Rule.Align);
    Height := Height + F.PreferredSize(
      Intrinsic of TMsg(Child, false, ChildWidth),
      FlexRule of TMsg(Child)
    );
  end for;

  return Height;
end function;

// Measures the element's natural extent on one axis.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Prepared terminal element.
// - `Horizontal`: Measure columns when true and rows otherwise.
// - `Columns`: Wrapping width for a vertical measurement, or minus one for unwrapped content.
// ## Returns
// The preferred content extent in cells before applying the parent's allocation.
public function Intrinsic of TMsg(
  Node: E.Element of TMsg;
  Horizontal: bool;
  Columns: int := -1
): int;
begin
  case Node of
    when E.Element.Log(_, _, _):
      return if Horizontal then
        32
      else
        8
      end if;
    when E.Element.Palette(_, const Base: E.Element of TMsg, _, _, _, _):
      return Intrinsic of TMsg(Base, Horizontal, Columns);
    when E.Element.SelectionList(const List: E.SelectionListView of TMsg):
      return if Horizontal then
        List.Width
      else
        Sys.Math.Max(1, Sys.Math.Min(List.MaximumRows, List.Items.Length))
      end if;
    when E.Element.Pager(const Pager: E.PagerView of TMsg):
      return if Horizontal then
        PagerWidth(Pager.Count)
      else
        1
      end if;
    when E.Element.Breadcrumb(const Trail: E.BreadcrumbView of TMsg):
      return if Horizontal then
        Trail.Width
      else
        1
      end if;
    when E.Element.ChoiceStrip(const Strip: E.ChoiceStripView of TMsg):
      if not Horizontal then
        return if Strip.Settings.Underline then
          Strip.Settings.Height + 1
        else
          Strip.Settings.Height
        end if;
      end if;
      var Width: int := Strip.Widths.Length - 1;
      for Item: int in Strip.Widths do
        Width := Width + Item;
      end for;

      return Width;
    when E.Element.Table(const Table: E.TableView of TMsg):
      if Horizontal then
        var Width: int := Sys.Math.Min(E.MaximumColumns, Table.Columns.Length - 1);
        for Cells: int in Table.Preferred do
          Width := Width + Sys.Math.Min(Cells, E.MaximumColumns - Width);
        end for;

        return Width;
      end if;

      case Table.Settings.Height of
        when L.Extent.Fixed(const Distance: L.Measure):
          return F.Cells(Distance, false);
        else
          return Table.Rows.Length + 1;
      end case;
    when E.Element.Label(const Value: string):
      if Horizontal then
        return LineWidth(Value);
      end if;

      return LineCount(Value, Columns);
    when E.Element.StatusBar(const Row: E.Element of TMsg, const HideBorder: bool):
      if Horizontal then
        return Intrinsic of TMsg(Row, true);
      end if;

      return if HideBorder then
        1
      else
        2
      end if;
    when E.Element.TextField(_):
      return if Horizontal then
        24
      else
        1
      end if;
    when E.Element.TextArea(const Field: AreaEdit.Field of TMsg):
      return if Horizontal then
        24
      else
        Field.Rows
      end if;
    when E.Element.CellGrid(_, _, _):
      return 1;
    when E.Element.Spinner(_, _):
      return 1;
    when E.Element.Sparkline(_, const Width: int, _, _):
      return if Horizontal then
        Width
      else
        1
      end if;
    when E.Element.Progress(_, const Caption: string, const Percent: string, const Width: int?, _):
      if Horizontal then
        return Width ?? (G.Measure(Caption) + Percent.Length + 8);
      end if;

      return 1;
    when E.Element.Action(_, _, _, const View: E.ActionView):
      if Horizontal then
        if View.FixedWidth <> null then
          return View.FixedWidth.Value;
        end if;
        var Width: int := G.Measure(View.Caption);
        if View.Description <> '' then
          Width := Sys.Math.Max(Width, LineWidth(View.Description));
        end if;

        return Sys.Math.Max(View.MinimumWidth, Width + 2 * View.Padding);
      end if;

      if View.Description = '' then
        return View.Height;
      end if;

      return View.Height + LineCount(View.Description, Columns - 2 * View.Padding);
    when E.Element.Stack(
      const Children: array of E.Element of TMsg,
      const Axis: bool,
      const Rule: E.Flow
    ):
      if not Horizontal and Columns >= 0 then
        return WrappedStackHeight of TMsg(Children, Axis, Rule, Columns);
      end if;
      var Size: int := 0;
      for Child: E.Element of TMsg in Children do
        const Span: int := Intrinsic of TMsg(Child, Horizontal);
        Size := if Axis = Horizontal then
          Size + Span
        else
          Sys.Math.Max(Size, Span)
        end if;
      end for;

      return Size + 2 * (if Horizontal then
        Rule.PaddingX
      else
        Rule.PaddingY
      end if) + (if Axis = Horizontal then
        Sys.Math.Max(
          0,
          Children.Length - 1
        ) * Rule.Gap
      else
        0
      end if);
    when E.Element.Sized(
      const Child: E.Element of TMsg,
      _
    ), E.Element.Decorated(
      const Child: E.Element of TMsg,
      _
    ), E.Element.DisclosureBody(
      _,
      const Child: E.Element of TMsg,
      _
    ), E.Element.Scrollable(_, const Child: E.Element of TMsg, _), E.Element.ControlledScroll(
      _, const Child: E.Element of TMsg, _, _, _
    ), E.Element.Desktop(
      const Child: E.Element of TMsg,
      _,
      _
    ):
      return Intrinsic of TMsg(Child, Horizontal, Columns);
    when E.Element.ModalPanel(_, _, _, _, _, _):
      return 0;
    when E.Element.Framed(const Child: E.Element of TMsg, const Title: string):
      return Sys.Math.Max(
        Intrinsic of TMsg(
          Child,
          Horizontal,
          if Columns < 0 then
            -1
          else
            Sys.Math.Max(0, Columns - 2)
          end if
        ),
        if Horizontal then
          G.Measure(Title)
        else
          0
        end if
      ) + 2;
  end case;
end function;

end unit;
