unit Fpas.Ui.Tui.Internal.Layout.Measurement;

uses Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Layout as L, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, Fpas.Ui.Tui.Internal.Layout.Flexible as F, System as Sys;

public function FlexRule<TMsg>(Node: E.Element<TMsg>): E.Flex;
begin
  case Node of
    when E.Element.Sized(_, const Rule: E.Flex):
      return Rule;
    when E.Element.Decorated(const Child: E.Element<TMsg>, _):
      return FlexRule<TMsg>(Child);
    else
      return new E.Flex();
  end case;
end function;

// Resolves CUI minimum-content bounds using terminal text metrics.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Node`: Resolved terminal subtree.
// - `Horizontal`: Whether to measure width instead of height.
// - `ParentHorizontal`: Main axis of the enclosing stack; defaults to the measured axis.
//
// ## Returns
// The subtree's minimum content extent in cells.
public function Minimum<TMsg>(Node: E.Element<TMsg>; Horizontal: bool; ParentHorizontal: bool? := null): int;
begin
  case Node of
    when E.Element.Label(const Value: string):
      if not Horizontal then
        return if Value = '' then 0 else G.LineCount(Value, -1) end if;
      end if;
      var Width: int := 0;
      for Word: string in Value.Split(new char[0], Sys.StringSplitOptions.RemoveEmptyEntries) do
        Width := Sys.Math.Max(Width, G.Measure(Word));
      end for;

      return Width;
    when E.Element.Sized(const Child: E.Element<TMsg>, const Rule: E.Flex):
      const Content: int := Minimum<TMsg>(Child, Horizontal, ParentHorizontal);
      if Horizontal <> (ParentHorizontal ?? Horizontal) then
        return Content;
      end if;

      return Sys.Math.Clamp(
        if Rule.Basis >= 0 then Rule.Basis else Content end if,
        Rule.Minimum,
        Rule.Maximum
      );
    when E.Element.Decorated(
      const Child: E.Element<TMsg>,
      _
    ), E.Element.ButtonGroup(const Child: E.Element<TMsg>, _), E.Element.PopupAnchor(
      const Child: E.Element<TMsg>,
      _,
      _,
      _,
      _, _, _
    ):
      return Minimum<TMsg>(Child, Horizontal, ParentHorizontal);
    when E.Element.Stack(
      const Children: array of E.Element<TMsg>,
      const Axis: bool,
      const Flow: E.Flow
    ):
      var Span: int := 0;
      for Child: E.Element<TMsg> in Children do
        const Size: int := Minimum<TMsg>(Child, Horizontal, Axis);
        Span := if Axis = Horizontal then Span + Size else Sys.Math.Max(Span, Size) end if;
      end for;

      return Span + 2 * (if Horizontal then Flow.PaddingX
        else Flow.PaddingY
        end if) + (if Axis = Horizontal then Sys.Math.Max(
          0,
          Children.Length - 1
        ) * Flow.Gap
        else 0
        end if);
    when E.Element.Scrollable(_, _, _), E.Element.ControlledScroll(
      _,
      _,
      _,
      _,
      _
    ), E.Element.EdgeSheet(
      _,
      _,
      _,
      _,
      _,
      _
    ):
      return 0;
    when E.Element.Framed(const Child: E.Element<TMsg>, _):
      return Minimum<TMsg>(Child, Horizontal, false) + 2;
    else
      return Intrinsic<TMsg>(Node, Horizontal);
  end case;
end function;

// Combines explicit bounds with CUI minimum-content sizing for one axis.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Node`: Resolved terminal subtree.
// - `Horizontal`: Parent main axis.
//
// ## Returns
// Constraints with a resolved minimum content size.
public function AllocationRule<TMsg>(Node: E.Element<TMsg>; Horizontal: bool): E.Flex;
begin
  if Horizontal then
    case Node of
      when E.Element.Action(_, _, _, const View: E.ActionView):
        const Width: int? := View.FixedWidth;
        if Width <> null then
          return new E.Flex(Basis := Width.Value, Minimum := Width.Value, Maximum := Width.Value);
        end if;

        if View.FillWidth then
          return new E.Flex(Grow := 1);
        end if;
      when E.Element.Decorated(const Child: E.Element<TMsg>, _):
        return AllocationRule<TMsg>(Child, Horizontal);
      when E.Element.ButtonGroup(_, const FullWidth: bool):
        if FullWidth then
          return new E.Flex(Grow := 1);
        end if;
      else
    end case;
  end if;
  const Rule: E.Flex := FlexRule<TMsg>(Node);
  if Rule.Basis >= 0 then
    return Rule;
  end if;

  return Rule with
    Minimum := Sys.Math.Min(
      Rule.Maximum,
      Sys.Math.Max(Rule.Minimum, Minimum<TMsg>(Node, Horizontal))
    );
  end with;
end function;

// Reports whether a node can stretch across its parent's axis.
// Intrinsically sized controls retain CUI's natural extent by default.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Node`: Resolved terminal subtree.
// - `Horizontal`: Whether the cross axis is horizontal.
// - `Explicit`: Whether the caller explicitly requested stretching.
//
// ## Returns
// True when the node can fill this cross-axis extent.
public function CanStretch<TMsg>(Node: E.Element<TMsg>; Horizontal: bool; Explicit: bool := false): bool;
begin
  case Node of
    when E.Element.Action(_, _, _, const View: E.ActionView):
      return Horizontal and (View.FillWidth or (Explicit and View.FixedWidth = null));
    when E.Element.ButtonGroup(_, const FullWidth: bool):
      return Horizontal and FullWidth;
    when E.Element.PopupAnchor(_, _, _, _, _, _, _):
      return false;
    when E.Element.Sized(
      const Child: E.Element<TMsg>,
      _
    ), E.Element.Decorated(const Child: E.Element<TMsg>, _):
      return CanStretch<TMsg>(Child, Horizontal, Explicit);
    else
      return true;
  end case;
end function;

public function CrossWidth<TMsg>(Node: E.Element<TMsg>; Available: int; Align: L.Alignment): int;
begin
  return if (Align = L.Alignment.Stretch or Align = L.Alignment.Default) and CanStretch<TMsg>(
      Node,
      true
    ) then Available
    else Sys.Math.Min(Available, Intrinsic<TMsg>(Node, true))
    end if;
end function;

function WrappedStackHeight<TMsg>(
  Children: array of E.Element<TMsg>; Axis: bool; Rule: E.Flow; Columns: int
): int;
begin
  const Width: int := Sys.Math.Max(0, Columns - 2 * Rule.PaddingX);
  const Gaps: int := Sys.Math.Max(0, Children.Length - 1) * Rule.Gap;
  if Axis then
    const Preferred: array of int := new int[Children.Length];
    const Rules: array of E.Flex := Sys.Array.ConvertAll<E.Element<TMsg>, E.Flex>(
      Children,
      function(Child: E.Element<TMsg>): E.Flex => AllocationRule<TMsg>(Child, true)
    );
    for Index: int := 0 to Children.Length - 1 do
      Preferred[Index] := Intrinsic<TMsg>(Children[Index], true);
    end for;
    const Widths: array of int := F.Allocate(Preferred, Rules, Sys.Math.Max(0, Width - Gaps));
    var Height: int := 0;
    for Index: int := 0 to Children.Length - 1 do
      if Widths[Index] > 0 then
        Height := Sys.Math.Max(Height, Intrinsic<TMsg>(Children[Index], false, Widths[Index]));
      end if;
    end for;

    return Height + 2 * Rule.PaddingY;
  end if;

  var Height: int := 2 * Rule.PaddingY + Gaps;
  for Child: E.Element<TMsg> in Children do
    const ChildWidth: int := CrossWidth<TMsg>(Child, Width, Rule.Align);
    Height := Height + F.PreferredSize(
      Intrinsic<TMsg>(Child, false, ChildWidth),
      FlexRule<TMsg>(Child)
    );
  end for;

  return Height;
end function;

public function Intrinsic<TMsg>(Node: E.Element<TMsg>; Horizontal: bool; Columns: int := -1): int;
begin
  case Node of
    when E.Element.Label(const Value: string):
      if Horizontal then
        return G.LineWidth(Value);
      end if;

      return G.LineCount(Value, Columns);
    when E.Element.Separator(const Title: string):
      return if Horizontal and Title <> '' then G.Measure(G.SingleLine(Title)) + 4 else 1 end if;
    when E.Element.Action(_, _, _, const View: E.ActionView):
      return if Horizontal then View.FixedWidth ?? Sys.Math.Max(
          View.MinimumWidth,
          G.Measure(View.Caption) + 2 * View.Padding
        )
        else View.Height
        end if;
    when E.Element.Stack(
      const Children: array of E.Element<TMsg>,
      const Axis: bool,
      const Rule: E.Flow
    ):
      if not Horizontal and Columns >= 0 then
        return WrappedStackHeight<TMsg>(Children, Axis, Rule, Columns);
      end if;
      var Size: int := 0;
      for Child: E.Element<TMsg> in Children do
        const Span: int := Intrinsic<TMsg>(Child, Horizontal);
        Size := if Axis = Horizontal then Size + Span else Sys.Math.Max(Size, Span) end if;
      end for;

      return Size + 2 * (if Horizontal then Rule.PaddingX
        else Rule.PaddingY
        end if) + (if Axis = Horizontal then Sys.Math.Max(
          0,
          Children.Length - 1
        ) * Rule.Gap
        else 0
        end if);
    when E.Element.Sized(
      const Child: E.Element<TMsg>,
      _
    ), E.Element.Decorated(
      const Child: E.Element<TMsg>,
      _
    ), E.Element.Scrollable(_, const Child: E.Element<TMsg>, _), E.Element.ControlledScroll(
      _, const Child: E.Element<TMsg>, _, _, _
    ), E.Element.ButtonGroup(const Child: E.Element<TMsg>, _), E.Element.PopupAnchor(
      const Child: E.Element<TMsg>, _, _, _, _, _, _
    ), E.Element.Desktop(
      const Child: E.Element<TMsg>,
      _,
      _
    ):
      return Intrinsic<TMsg>(Child, Horizontal, Columns);
    when E.Element.EdgeSheet(_, _, _, _, _, _):
      return 0;
    when E.Element.Framed(const Child: E.Element<TMsg>, const Title: string):
      return Sys.Math.Max(
        Intrinsic<TMsg>(
          Child,
          Horizontal,
          if Columns < 0 then -1 else Sys.Math.Max(0, Columns - 2) end if
        ),
        if Horizontal then G.Measure(Title) else 0 end if
      ) + 2;
  end case;
end function;
end unit;
