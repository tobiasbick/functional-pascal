// [Documentation](../../../../docs/ui/tui/host.md#popup-input)

unit Fpas.Ui.Tui.Internal.Layout.PopupHost;

uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Layout.Scene as A;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.Widgets.Collections.FilterBar as Filters;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.MultiSelect as MultiSelect;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.Select as Select;
uses Fpas.Ui.Tui.Internal.Widgets.Navigation.Breadcrumb as Breadcrumb;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.AnchoredPopup as Popup;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.Dropdown as Menu;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.PopupState as P;

uses System.Collections.Generic as C;

// Presents an open popup while its trigger is visible in the current scope.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Session-local state.
// - `Parent`: Current underlying modal, if any.
// - `Screen`: Terminal bounds.
// - `Theme`: Active terminal palette.
// - `Operations`: Ordered paint operations.
// - `Controls`: Controls of the current frame.
// ## Returns
// Open popup scope, or null when there is no eligible trigger.
public function Present of TMsg(
  State: P.State of TMsg; Parent: (A.Scope of TMsg)?; Screen: F.Rect; Theme: Th.Theme;
  Operations: C.List of D.Operation; Controls: C.List of A.Control of TMsg
): (A.Scope of TMsg)?;
  function Content(Owner: A.Control of TMsg): (Popup.Content of TMsg)?;
  begin
    case A.Activatable of TMsg(Owner.Action) of
      when is Select.Trigger of TMsg as Field:
        return Select.Content of TMsg(Field, Owner.Bounds);
      when is MultiSelect.Trigger of TMsg as Multi:
        return MultiSelect.Content of TMsg(Multi, Owner.Bounds.Width);
      when is Menu.Trigger of TMsg as Dropdown:
        return Menu.Content of TMsg(Dropdown, Owner.Bounds, Screen.Width);
      when is Filters.Trigger of TMsg as Filter:
        return Filters.Content of TMsg(Filter);
      when is Breadcrumb.Trigger of TMsg as Trail:
        return Breadcrumb.Content of TMsg(Trail);
      else
        return null;
    end case;
  end function;
begin
  const Id: string := State.Read().Id;
  if Id = '' then
    return null;
  end if;
  const Scope: string := if Parent = null then
    ''
  else
    Parent.Id
  end if;
  const Owner: (A.Control of TMsg)? := Controls.Find(
    function(Control: A.Control of TMsg): bool => Control.Id = Id
  );
  if Owner <> null and Owner.Enabled and Owner.Scope = Scope then
    const Active: (Popup.Content of TMsg)? := Content(Owner);
    if Active <> null then
      return Popup.Draw of TMsg(State, Active, Owner.Bounds, Screen, Theme, Operations, Controls);
    end if;
  end if;

  State.Write(new P.Cursor());
  return null;
end function;

end unit;
