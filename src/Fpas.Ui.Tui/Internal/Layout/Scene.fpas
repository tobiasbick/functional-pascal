// [Documentation](../../../../docs/ui/tui/host.md#cell-presentation)

unit Fpas.Ui.Tui.Internal.Layout.Scene;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Styles as UiStyle;
uses Fpas.Ui.TerminalExtensions.CellGrids as Grids;
uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.Tui.Application as App;
uses Fpas.Ui.Tui.Internal.Controls.Activation as Actions;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Layout.ScrollViews as V;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit;
uses Fpas.Ui.Validation as Validation;
uses Fpas.Ui.Widgets.Developer.Terminal as T;

uses System as Sys;
uses System.Collections.Generic as C;

// Input behavior installed by layout for a visible control.
// ## Type parameters
// - `TMsg`: Application message type.
public type Binding of TMsg = variant
  // Single-line editor with its insertion point and first editable column.
  Edit(Field: Edit.Field of TMsg; Position: Edit.Tracking; Origin: int; Caret: int);
  // Multiline editor and the caret cell chosen by layout.
  EditArea(View: AreaEdit.View of TMsg; CaretX: int; CaretY: int);
  // Direct action invoked by pointer input or the activation key.
  Invoke(Action: Actions.IActivatable of TMsg);
  // Scroll viewport and its input policy.
  Scroll(View: V.Viewport of TMsg);
  // Model-owned selection and the visible list body excluding the scrollbar.
  SelectionList(List: E.SelectionListView of TMsg; Body: F.Rect; View: V.Viewport of TMsg);
  // Unclipped allocation and event mapper for an interactive terminal image.
  Grid(Area: F.Rect; Changed: function(Grids.Event): TMsg);
end variant;

// An interactive control in the arranged terminal scene.
// ## Type parameters
// - `TMsg`: Application message type.
public type Control of TMsg = record
  // Stable identity used for input and focus requests.
  public Id: string;
  // Accessible control name.
  public Label: string;
  // Semantic role used by input routing and the snapshot.
  public Role: string;
  // Current selection or edit text exposed by the snapshot.
  public Value: string;
  // Visible interactive cells.
  public Bounds: F.Rect;
  // Owning overlay identity, or empty for the base view.
  public Scope: string;
  // Control to restore if this control leaves the scene.
  public FocusReturn: string;
  // Whether the control can receive input and focus.
  public Enabled: bool;
  // Pointer and keyboard behavior installed for the current model.
  public Action: Binding of TMsg;
  // Semantic colors used for an action's focus and hover state.
  public Variant: UiStyle.ButtonVariant;
  // Apply semantic button styling to keyboard focus and hover.
  public ButtonStyle: bool := false;
  // Allow Up and Down to cycle focus on this direct action.
  public ArrowFocus: bool := false;
  // Optional contextual hint shown on hover.
  public Hint: string := '';
  // Optional foreground retained when the control is focused or hovered.
  public Foreground: G.Color? := null;
  // Tab-entry identity for a composite control, or empty for an ordinary stop.
  public TabTarget: string := '';
  // Horizontal viewport attached to a wide table's row controls.
  public Pan: HorizontalViewport? := null;
  // Preferred replacement when this control disappears within its group.
  public FocusReplacement: string := '';
end record;

// Keyboard panning limits for a table.
public type HorizontalViewport = record
  // Session offset key, separate from the vertical viewport.
  public Id: string;
  // Largest horizontal offset in cells.
  public Maximum: int;
  // Columns traversed by each key press.
  public Step: int;
end record;

// One tab destination in traversal order.
public type TabStop = record
  // Stable identity to receive focus.
  public Id: string;
  // Owning modal scope, or empty for the base screen.
  public Scope: string;
end record;

// An enabled keyboard destination with its full bounds, including scrolled-out rows.
public type NavigationStop = record
  // Stable command identity to receive keyboard focus.
  public Id: string;
  // Unclipped command bounds at the current scroll offset.
  public Bounds: F.Rect;
  // Group traversed by vertical navigation.
  public NavigationGroup: string := '';
  // Nearest enclosing scroll viewport.
  public ScrollId: string := '';
  // Non-null when the destination accepts direct focus before it is visible.
  public Scope: string? := null;
end record;

// Interaction policy for the active modal or anchored overlay.
// ## Type parameters
// - `TMsg`: Application message type.
public type Scope of TMsg = record
  // Stable overlay identity.
  public Id: string;
  // Preferred control to focus when the overlay opens.
  public Initial: string;
  // Optional message factory for dismissal.
  public Escape: (Sys.Func of TMsg)?;
  // Application shortcuts available inside the overlay.
  public Shortcuts: array of K.ShortcutBinding of TMsg;
  // Panel bounds for dismissible scrim input.
  public Panel: F.Rect? := null;
  // Routes transient popup input before application shortcuts and underlying controls.
  public LocalInput: Sys.Func of (App.Input, bool)? := null;
end record;

// The visible bounds and offset limit for a scroll viewport.
public type ScrollRegion = record
  // Stable key for the viewport's offset.
  public Id: string;
  // Owning overlay identity, or empty for the base view.
  public Scope: string;
  // Cells that can receive scroll input.
  public Bounds: F.Rect;
  // Largest allowed offset in cells.
  public Maximum: int;
  // Whether input proposes an offset for the application to accept.
  public Controlled: bool := false;
end record;

// The arranged frame and the scene used to route input until the next frame.
// ## Type parameters
// - `TMsg`: Application message type.
public type Layout of TMsg = record
  // Plain text for each presented terminal row.
  public Lines: array of string;
  // Styled terminal cells in row-major order.
  public Cells: array of T.Cell;
  // Visible controls in display order.
  public Controls: array of Control of TMsg;
  // Overlay that currently owns input.
  public Active: (Scope of TMsg)?;
  // Keyboard shortcuts for the base view.
  public GlobalKeys: array of K.ShortcutBinding of TMsg;
  // Viewports that can receive a scroll request.
  public Regions: array of ScrollRegion;
  // Painted row cache retained for an equivalent region in the next frame.
  public Painted: array of D.PaintedRow;
  // Cached row and column allocations.
  public Allocations: array of F.AllocationMemo;
  // Last successful shared preflight/cache, retained by the owner.
  public Prepared: (Validation.Prepared of TMsg)? := null;
  // Open modal IDs, including those below the active scope.
  public Scopes: array of string := [];
  // Enabled navigation rows in display order, including rows outside a scroll viewport.
  public NavigationRows: array of NavigationStop := [];
  // Enabled tab destinations in view order. A composite control contributes one entry.
  public TabStops: array of TabStop := [];
  // Optional focus-independent shortcut to open the command palette.
  public OpenPalette: (Sys.Func of TMsg)? := null;
  // Whether the scene contains visible motion that needs another frame.
  public Animated: bool := false;
end record;

// Registers an action in a horizontal row and keeps offscreen Tab destinations.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Action`: Control with unclipped bounds.
// - `Clip`: Visible part of the row.
// - `ScrollId`: Enclosing vertical scroll viewport, if any.
// - `Navigation`: Keyboard destinations for that viewport.
// - `Stops`: Tab traversal order.
// - `Register`: Adds the visible control.
public procedure RegisterRowAction of TMsg(
  Action: Control of TMsg; Clip: F.Rect; ScrollId: string; Navigation: C.List of NavigationStop;
  Stops: C.List of TabStop; Register: procedure(Control of TMsg)
);
begin
  const Visible: F.Rect := F.Intersect(Action.Bounds, Clip);
  if Visible.Width = 0 then
    return;
  end if;

  if Action.Enabled and ScrollId <> '' then
    Navigation.Add(new NavigationStop(Action.Id, Action.Bounds, '', ScrollId, Action.Scope));
    if Visible.Height = 0 then
      Stops.Add(new TabStop(Action.Id, Action.Scope));
    end if;
  end if;

  if Visible.Height > 0 then
    Register(
      Action with
        Bounds := Visible;
      end with
    );
  end if;
end procedure;

// Looks up a visible control by its stable identity.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Layout`: Arranged scene, if present.
// - `Id`: Control identity to find.
// ## Returns
// The matching control, or null when it is absent.
public function FindControl of TMsg(Layout: (Layout of TMsg)?; Id: string): (Control of TMsg)?;
begin
  if Layout <> null then
    for Control: Control of TMsg in Layout.Controls do
      if Control.Id = Id then
        return Control;
      end if;
    end for;
  end if;

  return null;
end function;

// Gets the direct activation handler from a binding.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Action`: Control input binding.
// ## Returns
// The command handler, or null for a different kind of input binding.
public function Activatable of TMsg(Action: Binding of TMsg): (Actions.IActivatable of TMsg)?;
begin
  case Action of
    when Binding.Invoke(const Handler: Actions.IActivatable of TMsg):
      return Handler;
    else
      return null;
  end case;
end function;

end unit;
