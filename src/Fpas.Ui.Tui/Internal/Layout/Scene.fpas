unit Fpas.Ui.Tui.Internal.Layout.Scene;

uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Styles as UiStyle, Fpas.Ui.Widgets.Developer.Terminal as T, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Validation as Validation, Fpas.Ui.Graphics as G, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Layout.ScrollViews as V, Fpas.Ui.Tui.Internal.Controls.Activation as Actions, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, System as Sys;

public type Binding<TMsg> = variant
  Invoke(Action: Actions.IActivatable<TMsg>);
  Scroll(View: V.Viewport<TMsg>);
end variant;

public type Control<TMsg> = record
  public Id: string;
  public Label: string;
  public Role: string;
  public Value: string;
  public Bounds: F.Rect;
  public Scope: string;
  public FocusReturn: string;
  public Enabled: bool;
  public Action: Binding<TMsg>;
  public Variant: UiStyle.ButtonVariant;
  // Apply semantic button styling to keyboard focus and hover.
  public ButtonStyle: bool := false;
  // Allow Up and Down to cycle focus on this direct action.
  public ArrowFocus: bool := false;
  // Optional contextual hint shown on hover.
  public Hint: string := '';
  // Optional foreground retained when the control is focused or hovered.
  public Foreground: G.Color? := null;
  // Positive duration for an action that requires a pointer hold.
  public HoldMilliseconds: int := 0;
  // Filled percentage of an active hold.
  public HoldProgress: int := 0;
  // Optional state-specific normal, focus and hover colors.
  public Appearance: Th.ButtonAppearance? := null;
end record;

public type Scope<TMsg> = record
  public Id: string;
  public Initial: string;
  public Escape: Sys.Func<TMsg>?;
  public Shortcuts: array of K.ShortcutBinding<TMsg>;
  // Panel bounds for dismissible scrim input.
  public Panel: F.Rect? := null;
  // Optional host-owned dismissal for transient widget menus.
  public Dismiss: Sys.Action? := null;
end record;

public type ScrollRegion = record
  public Id: string;
  public Scope: string;
  public Bounds: F.Rect;
  public Maximum: int;
  public Controlled: bool := false;
end record;

public type Layout<TMsg> = record
  public Lines: array of string;
  public Cells: array of T.Cell;
  public Controls: array of Control<TMsg>;
  public Active: Scope<TMsg>?;
  public GlobalKeys: array of K.ShortcutBinding<TMsg>;
  public Regions: array of ScrollRegion;
  public Painted: array of D.PaintedRow;
  public Allocations: array of F.AllocationMemo;
  // Last successful shared preflight/cache, retained by the owner.
  public Prepared: Validation.Prepared<TMsg>? := null;
end record;

public function FindControl<TMsg>(Layout: Layout<TMsg>?; Id: string): Control<TMsg>?;
begin
  if Layout <> null then
    for Control: Control<TMsg> in Layout.Controls do
      if Control.Id = Id then
        return Control;
      end if;
    end for;
  end if;

  return null;
end function;

public function Activatable<TMsg>(Action: Binding<TMsg>): Actions.IActivatable<TMsg>?;
begin
  case Action of
    when Binding.Invoke(const Handler: Actions.IActivatable<TMsg>):
      return Handler;
    else
      return null;
  end case;
end function;

end unit;
