// [Documentation](../../../../docs/ui/tui/layout/scroll-view.md)

unit Fpas.Ui.Tui.Internal.Layout.ScrollViews;

uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Layout.Measurement as M;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Widgets.Developer.Terminal as T;

uses System as Sys;
uses System.Collections.Generic as Generic;

public type Viewport of TMsg = record
  public Offset: int;
  public Maximum: int;
  public Rows: int;
  public Following: bool;
  public Bar: bool;
  public OnScroll: Sys.Func of (L.ScrollChange, TMsg)?;
end record;

public type Geometry of TMsg = record
  public View: Viewport of TMsg;
  public Content: F.Rect;
  public Clip: F.Rect;
end record;

public function ContentHeight of TMsg(Child: E.Element of TMsg; Area: F.Rect): int;
begin
  return Sys.Math.Max(Area.Height, M.Intrinsic of TMsg(Child, false, Area.Width));
end function;

// Resolves the offset, visible rows and thumb for a vertical viewport.
// ## Type parameters
// - `TMsg`: Scroll message type.
// ## Parameters
// - `Position`: Requested start or end.
// - `ContentRows`: Number of rows in the content.
// - `Area`: Allocated viewport.
// - `ShowScrollbar`: Allow the track on overflow.
// - `OnScroll`: Optional model-owned scroll mapper.
// ## Returns
// The clamped viewport.
public function Resolve of TMsg(
  Position: E.ScrollPosition;
  ContentRows: int;
  Area: F.Rect;
  ShowScrollbar: bool;
  OnScroll: Sys.Func of (L.ScrollChange, TMsg)?
): Viewport of TMsg;
begin
  const Maximum: int := Sys.Math.Max(0, ContentRows - Area.Height);
  var Offset: int := Maximum;
  var Following: bool := true;
  case Position of
    when E.ScrollPosition.Offset(const Row: int):
      Offset := Sys.Math.Clamp(Row, 0, Maximum);
      Following := false;
    when E.ScrollPosition.End:
  end case;

  return new Viewport of TMsg(
    Offset, Maximum, Area.Height, Following,
    ShowScrollbar and Maximum > 0 and Area.Width > 1, OnScroll
  );
end function;

public function Arrange of TMsg(
  Child: E.Element of TMsg;
  Position: E.ScrollPosition;
  Area: F.Rect;
  Clip: F.Rect;
  ShowScrollbar: bool;
  OnScroll: Sys.Func of (L.ScrollChange, TMsg)?
): Geometry of TMsg;
begin
  var Height: int := ContentHeight of TMsg(Child, Area);
  var View: Viewport of TMsg := Resolve of TMsg(Position, Height, Area, ShowScrollbar, OnScroll);
  const Width: int := Area.Width - (if View.Bar then
    1
  else
    0
  end if);
  const Body: F.Rect := new F.Rect(Area.X, Area.Y, Width, Area.Height);
  if View.Bar then
    Height := Sys.Math.Max(Height, ContentHeight of TMsg(Child, Body));
    View := Resolve of TMsg(Position, Height, Area, ShowScrollbar, OnScroll);
  end if;

  return new Geometry of TMsg(
    View, new F.Rect(Body.X, Body.Y - View.Offset, Width, Height), F.Intersect(Body, Clip)
  );
end function;

public procedure DrawBar of TMsg(
  View: Viewport of TMsg;
  Operations: Generic.List of D.Operation;
  Area: F.Rect;
  Clip: F.Rect;
  Style: T.Style;
  Widgets: Th.WidgetStyles?
);
begin
  if not View.Bar then
    return;
  end if;
  const Thumb: int := Sys.Math.Max(
    1,
    cast (cast View.Rows as long * cast View.Rows as long div (cast View.Maximum as long +
      cast View.Rows as long)) as int
  );
  const Start: int := cast (cast View.Offset as long * cast (View.Rows - Thumb) as long div
    cast View.Maximum as long) as int;
  const TrackStyle: T.Style := if Widgets = null then
    Style
  else
    new T.Style(Widgets.ScrollTrackColor, Style.Background)
  end if;
  const ThumbStyle: T.Style := if Widgets = null then
    Style
  else
    new T.Style(Widgets.ScrollThumbColor, Style.Background)
  end if;
  for Row: int := 0 to View.Rows - 1 do
    const BarCell: F.Rect := new F.Rect(Area.X + Area.Width - 1, Area.Y + Row, 1, 1);
    const Active: bool := Row >= Start and Row < Start + Thumb;
    Operations.Add(
      new D.Operation(
        if Active then
          '┃'
        else
          '│'
        end if, BarCell, Clip,
        if Active then
          ThumbStyle
        else
          TrackStyle
        end if, false
      )
    );
  end for;
end procedure;

public function Equivalent of TMsg(Left: Viewport of TMsg; Right: Viewport of TMsg): bool;
begin
  return Left.Offset = Right.Offset and Left.Maximum = Right.Maximum and Left.Rows = Right.Rows
    and Left.Following = Right.Following and Left.Bar = Right.Bar;
end function;

end unit;
