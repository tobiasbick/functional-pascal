unit Fpas.Ui.Tui.Internal.Layout.ScrollViews;

uses Fpas.Ui.Layout as L, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Widgets.Developer.Terminal as T, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Layout.Measurement as M, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, System as Sys, System.Collections.Generic as Generic;

public type Viewport<TMsg> = record
  public Offset: int;
  public Maximum: int;
  public Rows: int;
  public Following: bool;
  public Bar: bool;
  public OnScroll: Sys.Func<L.ScrollChange, TMsg>?;
end record;

public type Geometry<TMsg> = record
  public View: Viewport<TMsg>;
  public Content: F.Rect;
  public Clip: F.Rect;
end record;

public function ContentHeight<TMsg>(Child: E.Element<TMsg>; Area: F.Rect): int;
begin
  return Sys.Math.Max(Area.Height, M.Intrinsic<TMsg>(Child, false, Area.Width));
end function;

function Resolve<TMsg>(
  Position: E.ScrollPosition; ContentRows: int; Area: F.Rect;
  ShowScrollbar: bool; OnScroll: Sys.Func<L.ScrollChange, TMsg>?
): Viewport<TMsg>;
begin
  const Maximum: int := Sys.Math.Max(0, ContentRows - Area.Height);
  var Offset: int := Maximum;
  var Following: bool := true;
  case Position of
    when E.ScrollPosition.Offset(const Row: int):
      Offset := Sys.Math.Clamp(Row, 0, Maximum);
      Following := false;
    when E.ScrollPosition.End:
  end case;

  return new Viewport<TMsg>(
    Offset, Maximum, Area.Height, Following,
    ShowScrollbar and Maximum > 0 and Area.Width > 1, OnScroll
  );
end function;

public function Arrange<TMsg>(
  Child: E.Element<TMsg>; Position: E.ScrollPosition; Area: F.Rect; Clip: F.Rect;
  ShowScrollbar: bool; OnScroll: Sys.Func<L.ScrollChange, TMsg>?
): Geometry<TMsg>;
begin
  var Height: int := ContentHeight<TMsg>(Child, Area);
  var View: Viewport<TMsg> := Resolve<TMsg>(Position, Height, Area, ShowScrollbar, OnScroll);
  const Width: int := Area.Width - (if View.Bar then
    1
  else
    0
  end if);
  const Body: F.Rect := new F.Rect(Area.X, Area.Y, Width, Area.Height);
  if View.Bar then
    Height := Sys.Math.Max(Height, ContentHeight<TMsg>(Child, Body));
    View := Resolve<TMsg>(Position, Height, Area, ShowScrollbar, OnScroll);
  end if;

  return new Geometry<TMsg>(
    View, new F.Rect(Body.X, Body.Y - View.Offset, Width, Height), F.Intersect(Body, Clip)
  );
end function;

public procedure DrawBar<TMsg>(
  View: Viewport<TMsg>; Operations: Generic.List<D.Operation>; Area: F.Rect; Clip: F.Rect;
  Style: T.Style; Widgets: Th.WidgetStyles?
);
begin
  if not View.Bar then
    return;
  end if;
  const Thumb: int := Sys.Math.Max(
    1,
    cast<int>(cast<long>(View.Rows) * cast<long>(View.Rows) div (cast<long>(View.Maximum) +
      cast<long>(View.Rows)))
  );
  const Start: int := cast<int>(cast<long>(View.Offset) * cast<long>(View.Rows - Thumb) div
    cast<long>(View.Maximum));
  const TrackStyle: T.Style := if Widgets = null then
    Style
  else
    new T.Style(Widgets.ScrollTrackColor, Style.Background)
  end if;
  const ThumbStyle: T.Style := if Widgets = null then
    Style
  else
    new T.Style(Widgets.ScrollThumbColor, Style.Background)
  end if;
  for Row: int := 0 to View.Rows - 1 do
    const BarCell: F.Rect := new F.Rect(Area.X + Area.Width - 1, Area.Y + Row, 1, 1);
    const Active: bool := Row >= Start and Row < Start + Thumb;
    Operations.Add(
      new D.Operation(
        if Active then
          '█'
        else
          '│'
        end if, BarCell, Clip,
        if Active then
          ThumbStyle
        else
          TrackStyle
        end if, false
      )
    );
  end for;
end procedure;

public function Equivalent<TMsg>(Left: Viewport<TMsg>; Right: Viewport<TMsg>): bool;
begin
  return Left.Offset = Right.Offset and Left.Maximum = Right.Maximum and Left.Rows = Right.Rows
    and Left.Following = Right.Following and Left.Bar = Right.Bar;
end function;

end unit;
