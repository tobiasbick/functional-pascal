unit Fpas.Ui.Tui.Internal.Layout.SelectionLists;

uses Fpas.Ui.Tui.Themes as Th, Fpas.Ui.Choices as Ch, Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Controls.Activation as Actions, Fpas.Ui.Tui.Internal.Controls.Selection as Selections, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, System as Sys, System.Collections.Generic as Generic;

public type Viewport<TMsg> = record implements Actions.IActivatable<TMsg>, Selections.ISelectable<TMsg>
  public Items: array of Ch.SelectionItem;
  public Selected: int;
  public First: int;
  public Rows: int;
  public OnSelect: function(string): TMsg;
  public OnActivate: Sys.Func<string, TMsg>?;

  public function Count(): int;
  begin
    return self.Items.Length;
  end function;

  public function SelectedIndex(): int;
  begin
    return self.Selected;
  end function;

  public function CanSelect(Index: int): bool;
  begin
    return Index >= 0 and Index < self.Items.Length and self.Items[Index].Enabled;
  end function;

  public function Select(Index: int): Actions.Result<TMsg>;
  begin
    return Actions.Result<TMsg>.Send(self.OnSelect(self.Items[Index].Key));
  end function;

  public function Key(): string;
  begin
    return if self.Selected < 0 then '' else self.Items[self.Selected].Key end if;
  end function;

  public function Activate(): Actions.Result<TMsg>;
  begin
    if self.Selected >= 0 and self.Items[
      self.Selected
    ].Enabled and self.Items[self.Selected].CanActivate
    then
      case self.OnActivate of
        when is Sys.Func<string, TMsg> as Callback:
          return Actions.Result<TMsg>.Send(Callback.Invoke(self.Key()));
        else
      end case;
    end if;

    return Actions.Result<TMsg>.NoAction;
  end function;
end record;

public function Reveal(Index: int; First: int; Rows: int): int;
begin
  if Index < First then
    return Index;
  end if;

  if Index >= First + Rows then
    return Index - Rows + 1;
  end if;

  return First;
end function;

public function Arrange<TMsg>(
  Items: array of Ch.SelectionItem; Key: string; Rows: int; Offset: int;
  OnSelect: function(string): TMsg; OnActivate: Sys.Func<string, TMsg>?; Previous: Viewport<TMsg>?
): Viewport<TMsg>;
begin
  var Selected: int := -1;
  for Index: int := 0 to Items.Length - 1 do
    if Items[Index].Key = Key then
      Selected := Index;
      break;
    end if;
  end for;
  var First: int := Offset;
  if Selected >= 0 and (Previous = null or Previous.Selected <> Selected or Previous.Key() <> Key
    or Previous.Rows <> Rows)
  then
    First := Reveal(Selected, First, Rows);
  end if;

  return new Viewport<TMsg>(Items, Selected, First, Rows, OnSelect, OnActivate);
end function;

public procedure Draw<TMsg>(
  List: Viewport<TMsg>; Operations: Generic.List<D.Operation>; Clip: F.Rect;
  Style: T.Style; Widgets: Th.WidgetStyles?
);
begin
  for Index: int := List.First to Sys.Math.Min(List.Items.Length, List.First + Clip.Height) - 1 do
    const Item: Ch.SelectionItem := List.Items[Index];
    const Line: F.Rect := new F.Rect(Clip.X, Clip.Y + Index - List.First, Clip.Width, 1);
    const Label: string := if Item.CanActivate then Item.Text else '[x] ' + Item.Text end if;
    D.ListRow(Operations, Line, Clip, Label, Index = List.Selected, Style, Widgets);
  end for;
end procedure;

public function Equivalent<TMsg>(Left: Viewport<TMsg>; Right: Viewport<TMsg>): bool;
begin
  if Left.Selected <> Right.Selected or Left.First <> Right.First or Left.Rows <> Right.Rows
    or Left.Items.Length <> Right.Items.Length
  then
    return false;
  end if;

  for Index: int := 0 to Left.Items.Length - 1 do
    if Left.Items[Index] <> Right.Items[Index] then
      return false;
    end if;
  end for;

  return true;
end function;
end unit;
