unit Fpas.Ui.Tui.Internal.Layout.TabHeaders;

uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Choices as Ch, Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Internal.Controls.Activation as Actions, Fpas.Ui.Tui.Internal.Controls.Selection as Selections, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, System as Sys, System.Collections.Generic as Generic;

public type Header<TMsg> = record implements Selections.ISelectable<TMsg>
  public Items: array of Ch.TabItem;
  public Active: int;
  public Targets: array of int;
  public OnSelect: function(string): TMsg;

  public function Count(): int;
  begin
    return self.Items.Length;
  end function;

  public function SelectedIndex(): int;
  begin
    return self.Active;
  end function;

  public function CanSelect(Index: int): bool;
  begin
    return Index >= 0 and Index < self.Items.Length and self.Items[Index].Enabled;
  end function;

  public function Select(Index: int): Actions.Result<TMsg>;
  begin
    return Actions.Result<TMsg>.Send(self.OnSelect(self.Items[Index].Key));
  end function;

  public function Key(): string;
  begin
    return if self.Active < 0 then '' else self.Items[self.Active].Key end if;
  end function;
end record;

public function Preferred(Items: array of Ch.TabItem): int;
begin
  var Width: int := 0;
  for Item: Ch.TabItem in Items do
    Width := Width + G.Measure(G.SingleLine(Item.Label)) + 2;
  end for;

  return Width;
end function;

public function Draw<TMsg>(
  Items: array of Ch.TabItem; Active: int; OnSelect: function(string): TMsg;
  Bar: F.Rect; Clip: F.Rect; Style: T.Style; Widgets: Th.WidgetStyles?;
  Operations: Generic.List<D.Operation>
): Header<TMsg>;
  procedure DrawPart(Value: string; X: int; Width: int; Target: int; Color: T.Style; Fill: bool := false);
  begin
    const Area: F.Rect := new F.Rect(X, Bar.Y, Width, 1);
    const Visible: F.Rect := F.Intersect(Area, Clip);
    if Visible.Width = 0 then
      return;
    end if;

    if Fill then
      D.Fill(Operations, Visible, Color);
    end if;

    Operations.Add(new D.Operation(Value, Area, Visible, Color, false));
    for Column: int := Visible.X to Visible.X + Visible.Width - 1 do
      Targets[Column - Clip.X] := Target;
    end for;
  end procedure;
begin
  const Targets: array of int := new int[Clip.Width];
  Sys.Array.Fill<int>(Targets, -1);
  const View: Header<TMsg> := new Header<TMsg>(Items, Active, Targets, OnSelect);
  const Widths: array of int := new int[Items.Length];
  var Total: int := 0;
  for Index: int := 0 to Items.Length - 1 do
    Widths[Index] := G.Measure(G.SingleLine(Items[Index].Label)) + 2;
    Total := Total + Widths[Index];
  end for;
  const Overflow: bool := Total > Bar.Width;
  const Arrows: bool := Overflow and Bar.Width >= 3 and Active >= 0;
  const Capacity: int := Bar.Width - (if Arrows then 2 else 0 end if);
  var First: int := 0;
  if Overflow and Active >= 0 then
    First := Active;
    var Occupied: int := Sys.Math.Min(Capacity, Widths[Active]);
    while First > 0 and Widths[First - 1] <= Capacity - Occupied do
      First := First - 1;
      Occupied := Occupied + Widths[First];
    end while;
  end if;

  if Arrows then
    const Previous: int := Selections.Find<TMsg>(View, Active - 1, -1, false);
    const Next: int := Selections.Find<TMsg>(View, Active + 1, 1, false);
    if Previous >= 0 then
      DrawPart('‹', Bar.X, 1, Previous, Style);
    end if;

    if Next >= 0 then
      DrawPart('›', Bar.X + Bar.Width - 1, 1, Next, Style);
    end if;
  end if;
  var Cursor: int := Bar.X + (if Arrows then 1 else 0 end if);
  var Remaining: int := Capacity;
  for Index: int := First to Items.Length - 1 do
    if Remaining <= 0 then
      break;
    end if;
    const Item: Ch.TabItem := Items[Index];
    const Label: string := G.SingleLine(Item.Label);
    const Selected: bool := Index = Active;
    const Caption: string := if Selected then '[' + Label + ']'
      else if Item.Enabled then ' ' + Label + ' ' else '× ' + Label end if
      end if;
    const Color: T.Style := if Selected and Widgets <> null then Widgets.Selected else Style end if;
    const Width: int := Sys.Math.Min(Widths[Index], Remaining);
    DrawPart(Caption, Cursor, Width, if Item.Enabled then Index else -1 end if, Color, Selected);
    Cursor := Cursor + Width;
    Remaining := Remaining - Width;
  end for;

  return View;
end function;

public function Equivalent<TMsg>(Left: Header<TMsg>; Right: Header<TMsg>): bool;
begin
  if Left.Active <> Right.Active or Left.Items.Length <> Right.Items.Length
    or Left.Targets.Length <>
    Right.Targets.Length
  then
    return false;
  end if;

  for Index: int := 0 to Left.Items.Length - 1 do
    if Left.Items[Index] <> Right.Items[Index] then
      return false;
    end if;
  end for;

  for Index: int := 0 to Left.Targets.Length - 1 do
    if Left.Targets[Index] <> Right.Targets[Index] then
      return false;
    end if;
  end for;

  return true;
end function;
end unit;
