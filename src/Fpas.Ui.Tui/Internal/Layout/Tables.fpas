unit Fpas.Ui.Tui.Internal.Layout.Tables;

uses Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Choices as Ch, Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Layout.SelectionLists as S, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, System as Sys, System.Collections.Generic as Generic;

const Gutter: int := 4;

public function Items(Rows: array of Ch.TableRow): array of Ch.SelectionItem;
begin
  const Values: Generic.List<Ch.SelectionItem> := new Generic.List<Ch.SelectionItem>(Rows.Length);
  for Row: Ch.TableRow in Rows do
    Values.Add(new Ch.SelectionItem(Row.Key, '', Row.Enabled, Row.CanActivate));
  end for;

  return Values.ToArray();
end function;

function MinimumWord(Text: string): int;
begin
  var Width: int := 0;
  for Word: string in Text.Split(new char[0], Sys.StringSplitOptions.RemoveEmptyEntries) do
    Width := Sys.Math.Max(Width, G.Measure(Word));
  end for;

  return Width;
end function;

function ColumnRule(Columns: array of E.TableColumn; Rows: array of Ch.TableRow; Index: int): E.Flex;
begin
  const Rule: E.Flex := Columns[Index].Sizing;
  if Rule.Basis >= 0 then
    return Rule;
  end if;
  var Minimum: int := MinimumWord(Columns[Index].Header);
  for Row: Ch.TableRow in Rows do
    Minimum := Sys.Math.Max(Minimum, MinimumWord(Row.Cells[Index]));
  end for;

  return Rule with
    Minimum := Sys.Math.Clamp(Minimum, Rule.Minimum, Rule.Maximum);
  end with;
end function;

function ContentWidth(Columns: array of E.TableColumn; Rows: array of Ch.TableRow; Index: int): int;
begin
  var Width: int := G.Measure(G.SingleLine(Columns[Index].Header));
  for Row: Ch.TableRow in Rows do
    Width := Sys.Math.Max(Width, G.Measure(G.SingleLine(Row.Cells[Index])));
  end for;

  return Width;
end function;

// Measures table content, including body cells, before main-axis allocation.
//
// ## Parameters
// - `Columns`: Validated column headers and constraints.
// - `Rows`: Validated body rows.
//
// ## Returns
// Preferred terminal width, including selection gutter and separators.
public function Preferred(Columns: array of E.TableColumn; Rows: array of Ch.TableRow): int;
begin
  var Width: int := Gutter + Columns.Length - 1;
  for Index: int := 0 to Columns.Length - 1 do
    const Rule: E.Flex := Columns[Index].Sizing;
    const Basis: int := if Rule.Basis < 0 then ContentWidth(
        Columns,
        Rows,
        Index
      )
      else Rule.Basis
      end if;
    Width := Width + Sys.Math.Clamp(Basis, Rule.Minimum, Rule.Maximum);
  end for;

  return Width;
end function;

// Allocates table columns under the shared CUI rules.
//
// ## Parameters
// - `Columns`: Validated column constraints.
// - `Rows`: Validated body rows used for content measurement.
// - `Available`: Visible table width in cells.
//
// ## Returns
// One allocated width per column.
public function Widths(Columns: array of E.TableColumn; Rows: array of Ch.TableRow; Available: int): array of int;
begin
  const Bases: array of int := new int[Columns.Length];
  const Rules: Generic.List<E.Flex> := new Generic.List<E.Flex>(Columns.Length);
  for Index: int := 0 to Columns.Length - 1 do
    Bases[Index] := ContentWidth(Columns, Rows, Index);
    Rules.Add(ColumnRule(Columns, Rows, Index));
  end for;

  return F.Allocate(
    Bases,
    Rules.ToArray(),
    Sys.Math.Max(0, Available - Gutter - Columns.Length + 1)
  );
end function;

procedure DrawCells(
  Widths: array of int; Caption: function(int): string; Line: F.Rect; Clip: F.Rect;
  Style: T.Style; Operations: Generic.List<D.Operation>
);
begin
  const Right: int := Line.X + Line.Width;
  var X: int := Line.X + Gutter;
  for Index: int := 0 to Widths.Length - 1 do
    if X >= Right then
      break;
    end if;
    const Width: int := Sys.Math.Min(Widths[Index], Right - X);
    if Width > 0 then
      const Cell: F.Rect := new F.Rect(X, Line.Y, Width, 1);
      const Visible: F.Rect := F.Intersect(Cell, Clip);
      if Visible.Width > 0 and Visible.Height > 0 then
        Operations.Add(new D.Operation(G.SingleLine(Caption(Index)), Cell, Visible, Style, false));
      end if;
    end if;

    X := X + Width + 1;
  end for;
end procedure;

public procedure DrawHeader(
  Columns: array of E.TableColumn; Widths: array of int; Line: F.Rect; Clip: F.Rect;
  Style: T.Style; Widgets: Th.WidgetStyles?; Operations: Generic.List<D.Operation>
);
begin
  const Header: T.Style := if Widgets = null then Style
    else new T.Style(
      Widgets.BorderColor,
      Style.Background
    )
    end if;
  DrawCells(
    Widths,
    function(Index: int): string => Columns[Index].Header,
    Line,
    Clip,
    Header,
    Operations
  );
end procedure;

public procedure DrawBody<TMsg>(
  Rows: array of Ch.TableRow; Widths: array of int; List: S.Viewport<TMsg>; Area: F.Rect; Clip: F.Rect;
  Style: T.Style; Widgets: Th.WidgetStyles?; Operations: Generic.List<D.Operation>
);
begin
  for Index: int := List.First to Sys.Math.Min(Rows.Length, List.First + List.Rows) - 1 do
    const Row: Ch.TableRow := Rows[Index];
    const Line: F.Rect := new F.Rect(Area.X, Clip.Y + Index - List.First, Area.Width, 1);
    const Selected: bool := Index = List.Selected;
    D.ListRow(
      Operations,
      Line,
      Clip,
      if Row.CanActivate then '' else '×' end if,
      Selected,
      Style,
      Widgets
    );
    DrawCells(
      Widths, function(Column: int): string => Row.Cells[Column], Line, Clip,
      D.SelectionStyle(Selected, Style, Widgets), Operations
    );
  end for;
end procedure;
end unit;
