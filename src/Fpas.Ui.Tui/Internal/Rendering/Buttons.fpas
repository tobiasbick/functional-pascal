unit Fpas.Ui.Tui.Internal.Rendering.Buttons;

uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Styles as UiStyle, Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, Fpas.Ui.Graphics as Graphics, System as Sys, System.Collections.Generic as Generic;

// Resolves semantic button colors for the current input state.
//
// ## Parameters
// - `Theme`: Current terminal theme.
// - `Variant`: Semantic button style.
// - `Enabled`: Whether the widget accepts input.
// - `Focused`: Whether the button has keyboard focus.
// - `Hovered`: Whether the pointer is over the button.
// - `Override`: Optional state-specific colors; disabled styling takes precedence.
// ## Returns
// The button style, or null when semantic button styles are unavailable.
public function Resolve(
  Theme: Th.Theme; Variant: UiStyle.ButtonVariant; Enabled: bool;
  Focused: bool := false; Hovered: bool := false; Override: Th.ButtonAppearance? := null
): T.Style?;
begin
  const Styles: Th.ButtonStyles? := Theme.Buttons;
  if Styles = null then
    return null;
  end if;

  if not Enabled then
    return Styles.Disabled;
  end if;

  const Appearance: Th.ButtonAppearance := Override ?? case Variant of
    when UiStyle.ButtonVariant.Primary: Styles.Primary;
    when UiStyle.ButtonVariant.Active: Styles.Active;
    when UiStyle.ButtonVariant.Destructive: Styles.Destructive;
    when UiStyle.ButtonVariant.Ghost, UiStyle.ButtonVariant.Outline: Styles.Ghost;
    when UiStyle.ButtonVariant.Link: Styles.Link;
    when UiStyle.ButtonVariant.Default: Styles.Default;
    else Styles.Secondary;
  end case;
  return if Focused then
    Appearance.Focused
  else
    if Hovered then
      Appearance.Hovered
    else
      Appearance.Normal
    end if
  end if;
end function;

// Applies a button's foreground override to the resolved backdrop.
//
// ## Parameters
// - `Theme`: Current terminal theme.
// - `Style`: Resolved button colors.
// - `Color`: Optional widget foreground.
// ## Returns
// The style used to paint the caption and its glyphs.
public function WithForeground(Theme: Th.Theme; Style: T.Style; Color: Graphics.Color?): T.Style;
begin
  if Color = null then
    return Style;
  end if;

  return new T.Style(
    Th.Rgb(Color, Style.Background ?? Theme.Text.Background ?? 0),
    Style.Background
  );
end function;

// Paints a terminal action or toggle into its allocated rectangle.
//
// ## Parameters
// - `Operations`: Destination paint operations.
// - `Area`: Widget allocation.
// - `Clip`: Visible portion of the allocation.
// - `Style`: Enclosing style.
// - `Theme`: Current terminal theme.
// - `Caption`: Visible text and glyphs.
// - `IsButton`: Whether to paint a button face.
// - `Variant`: Semantic button style.
// - `Enabled`: Whether the widget accepts input.
// - `MinimumWidth`: Minimum painted button width.
// - `Padding`: Cells on each side of the caption.
// - `Center`: Whether to center the face and caption across the allocation.
// - `Foreground`: Optional caption color.
// - `Joined`: Whether a surrounding group supplies the outline.
// - `Appearance`: Optional state-specific normal, focus and hover colors.
public procedure Paint(
  Operations: Generic.List<D.Operation>; Area: F.Rect; Clip: F.Rect; Style: T.Style;
  Theme: Th.Theme; Caption: string; IsButton: bool; Variant: UiStyle.ButtonVariant; Enabled: bool;
  MinimumWidth: int := 0; Padding: int := 1; Center: bool := false;
  Foreground: Graphics.Color? := null; Joined: bool := false; Appearance: Th.ButtonAppearance? := null
);
begin
  if not IsButton then
    if Caption <> '' then
      Operations.Add(new D.Operation(Caption, Area, Clip, Style, false));
    end if;

    return;
  end if;

  const Resolved: T.Style? := Resolve(Theme, Variant, Enabled, Override := Appearance);
  const Colors: T.Style := if Resolved = null then
    Style
  else
    new T.Style(
      Resolved.Foreground ?? Style.Foreground,
      Resolved.Background ?? Style.Background
    )
  end if;
  const Color: T.Style := WithForeground(
    Theme,
    Colors,
    if Enabled then
      Foreground
    else
      null
    end if
  );
  if Resolved <> null then
    D.Fill(Operations, Clip, Color);
  end if;

  const TextWidth: int := G.Measure(Caption);
  const Width: int := if Center then
    Area.Width
  else
    Sys.Math.Min(Area.Width, Sys.Math.Max(MinimumWidth, TextWidth + 2 * Padding))
  end if;
  const Extra: int := Sys.Math.Max(0, Width - 2 * Padding - TextWidth);
  const X: int := Area.X + Padding + Extra div 2;
  const Y: int := Area.Y;
  const Content: int := Width - Padding - (X - Area.X);
  if Content > 0 and Caption <> '' then
    Operations.Add(new D.Operation(Caption, new F.Rect(X, Y, Content, 1), Clip, Color, false));
  end if;

  if Width > 0 and not Joined and (Theme.Widgets = null or Variant =
    UiStyle.ButtonVariant.Outline)
  then
    Operations.Add(new D.Operation('[', new F.Rect(Area.X, Y, 1, 1), Clip, Color, false));
    if Width > 1 then
      Operations.Add(
        new D.Operation(']', new F.Rect(Area.X + Width - 1, Y, 1, 1), Clip, Color, false)
      );
    end if;
  end if;
end procedure;
end unit;
