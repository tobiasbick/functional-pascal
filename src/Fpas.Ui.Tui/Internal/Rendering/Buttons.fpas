unit Fpas.Ui.Tui.Internal.Rendering.Buttons;

uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Styles as UiStyle, Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, System as Sys, System.Collections.Generic as Generic;

public function Resolve(
  Theme: Th.Theme; Variant: UiStyle.ButtonVariant; Enabled: bool;
  Focused: bool := false; Hovered: bool := false
): T.Style?;
begin
  const Styles: Th.ButtonStyles? := Theme.Buttons;
  if Styles = null then
    return null;
  end if;

  if not Enabled then
    return Styles.Disabled;
  end if;

  const Appearance: Th.ButtonAppearance := case Variant of
    when UiStyle.ButtonVariant.Primary: Styles.Primary;
    when UiStyle.ButtonVariant.Active: Styles.Active;
    when UiStyle.ButtonVariant.Destructive: Styles.Destructive;
    when UiStyle.ButtonVariant.Ghost, UiStyle.ButtonVariant.Outline: Styles.Ghost;
    when UiStyle.ButtonVariant.Link: Styles.Link;
    when UiStyle.ButtonVariant.Default: Styles.Default;
    else Styles.Secondary;
  end case;
  return if Focused then Appearance.Focused
    else if Hovered then Appearance.Hovered else Appearance.Normal end if
    end if;
end function;

public procedure Paint(
  Operations: Generic.List<D.Operation>; Area: F.Rect; Clip: F.Rect; Style: T.Style;
  Theme: Th.Theme; Caption: string; IsButton: bool; Variant: UiStyle.ButtonVariant; Enabled: bool;
  MinimumWidth: int := 0
);
begin
  const Resolved: T.Style? := if IsButton then Resolve(Theme, Variant, Enabled) else null end if;
  const Color: T.Style? := if Resolved = null then null
    else new T.Style(
      Resolved.Foreground ?? Style.Foreground, Resolved.Background ?? Style.Background
    )
    end if;
  if Color <> null then
    D.Fill(Operations, Clip, Color);
  end if;
  const Extra: int := if MinimumWidth <= 2 then 0
    else Sys.Math.Max(0, MinimumWidth - 2 - G.Measure(Caption))
    end if;
  const Centered: string := if Extra = 0 then Caption
    else new string(#32, Extra div 2) + Caption + new string(#32, Extra - Extra div 2)
    end if;
  const Display: string := if not IsButton then Caption
    else if Theme.Widgets = null or Variant = UiStyle.ButtonVariant.Outline then '[' + Centered +
        ']'
      else ' ' + Centered + ' '
      end if
    end if;
  if Display <> '' then
    Operations.Add(new D.Operation(Display, Area, Clip, Color ?? Style, false));
  end if;
end procedure;
end unit;
