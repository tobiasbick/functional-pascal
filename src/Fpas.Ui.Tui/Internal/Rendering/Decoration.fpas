// [Documentation](../../../../docs/ui/tui/host.md#cell-presentation)

unit Fpas.Ui.Tui.Internal.Rendering.Decoration;

uses Fpas.Ui.Tui.Application as App;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Layout.Scene as A;
uses Fpas.Ui.Tui.Internal.Layout.ScrollViews as V;
uses Fpas.Ui.Tui.Internal.Rendering.Buttons as Buttons;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.Rendering.Glyphs as Glyphs;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.EditText as EditText;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaRows as Lines;
uses Fpas.Ui.Widgets.Developer.Terminal as T;

uses System as Sys;
uses System.Collections.Generic as Generic;

public procedure Apply of TMsg(
  Cells: array of T.Cell;
  Columns: int;
  Control: A.Control of TMsg;
  Theme: Th.Theme;
  Focused: bool
);
  procedure Mark(Column: int; Row: int; Style: T.Style);
  begin
    if Control.Bounds.Contains(Column, Row) then
      const Index: int := Row * Columns + Column;
      Cells[Index] := new T.Cell(Cells[Index].Text, Style);
    end if;
  end procedure;
  procedure Caret(Column: int; Row: int);
  begin
    if not Focused or not Bounds.Contains(Column, Row) then
      return;
    end if;
    const Index: int := Row * Columns + Column;
    Mark(Column, Row, Theme.Focus);
    if Cells[Index].Text = '' then
      Mark(Column - 1, Row, Theme.Focus);
    elsif Bounds.Contains(Column + 1, Row) and Cells[Index + 1].Text = '' then
      Mark(Column + 1, Row, Theme.Focus);
    end if;
  end procedure;
  procedure PaintSelection(
    Value: string;
    Span: EditText.Range;
    Start: int;
    Stop: int;
    Column: int;
    Row: int;
    Right: int
  );
  begin
    if not Focused then
      return;
    end if;
    const First: int := Sys.Math.Max(Start, Span.Start);
    const Last: int := Sys.Math.Min(Stop, Span.Stop);
    if First < Last then
      const X: int := Column + Glyphs.Measure(Value.Substring(Start, First - Start));
      const EndX: int := X + Glyphs.Measure(Value.Substring(First, Last - First));
      for Cell: int := Sys.Math.Max(X, Bounds.X) to Sys.Math.Min(EndX, Right) - 1 do
        Mark(Cell, Row, Theme.Buttons.Active.Normal);
      end for;
    end if;
  end procedure;
begin
  const Bounds: F.Rect := Control.Bounds;
  case Control.Action of
    when A.Binding.SelectionList(
      const List: E.SelectionListView of TMsg,
      const Body: F.Rect,
      const View: V.Viewport of TMsg
    ):
      if Focused then
        const Row: int := Body.Y + (List.Selected - View.Offset);
        Mark(
          Body.X, if Body.Contains(Body.X, Row) then
            Row
          else
            Body.Y
          end if, Theme.Focus
        );
      end if;

      return;
    when A.Binding.Edit(
      const Field: Edit.Field of TMsg,
      const Position: Edit.Tracking,
      const Origin: int,
      const X: int
    ):
      const Cursor: Edit.Cursor := Position.Read(Field.Value);
      const Span: EditText.Range := EditText.Selection(Cursor.Offset, Cursor.Anchor);
      PaintSelection(
        Field.Value,
        Span,
        Cursor.Start,
        Field.Value.Length,
        Origin,
        Bounds.Y,
        Bounds.X + Bounds.Width
      );
      Caret(X, Bounds.Y);
      return;
    when A.Binding.EditArea(const Area: AreaEdit.View of TMsg, const X: int, const Y: int):
      const Value: string := Area.Field.Value;
      const Cursor: AreaEdit.Cursor := Area.Position.Read(Value);
      const Span: EditText.Range := EditText.Selection(Cursor.Offset, Cursor.Anchor);
      for Row: int := 0 to Sys.Math.Min(Area.Height, Area.Rows.Length - Cursor.Top) - 1 do
        const Line: Lines.Line := Area.Rows[Cursor.Top + Row];
        PaintSelection(
          Value,
          Span,
          Line.Start,
          Line.Stop,
          Area.X,
          Area.Y + Row,
          Bounds.X + Bounds.Width
        );
      end for;

      Caret(X, Y);
      return;
    when A.Binding.Grid(_, _):
      return;
    when A.Binding.Scroll(const View: V.Viewport of TMsg):
      if Focused then
        Mark(
          if View.Bar then
            Bounds.X + Bounds.Width - 1
          else
            Bounds.X
          end if,
          Bounds.Y,
          Theme.Focus
        );
      end if;

      return;
    else
  end case;
  const Standard: T.Style := if not Focused then
    Theme.Hover
  else
    Theme.Focus
  end if;
  const Style: T.Style := if Control.ButtonStyle then
    Buttons.WithForeground(
      Theme,
      Buttons.Resolve(
        Theme,
        Control.Variant,
        Control.Enabled,
        Focused,
        not Focused
      ) ?? Standard,
      if Control.Enabled then
        Control.Foreground
      else
        null
      end if
    )
  else
    Standard
  end if;
  for Y: int := Bounds.Y to Bounds.Y + Bounds.Height - 1 do
    for X: int := Bounds.X to Bounds.X + Bounds.Width - 1 do
      Mark(X, Y, Style);
    end for;
  end for;
end procedure;

public function Capture of TMsg(
  Layout: A.Layout of TMsg;
  Columns: int;
  Theme: Th.Theme;
  Focus: string;
  Hover: string;
  Scope: string
): array of App.ControlSnapshot;
begin
  const Controls: Generic.List of App.ControlSnapshot := new Generic.List of App.ControlSnapshot(
    Layout.Controls.Length
  );
  for Control: A.Control of TMsg in Layout.Controls do
    const Focused: bool := Control.Id = Focus;
    const Hovered: bool := Control.Id = Hover;
    Controls.Add(
      new App.ControlSnapshot(
        Control.Id,
        Control.Label,
        Control.Role,
        Control.Value,
        Control.Bounds.X,
        Control.Bounds.Y,
        Control.Bounds.Width,
        Control.Bounds.Height,
        Focused,
        Hovered,
        Control.Enabled and Control.Scope = Scope
      )
    );
    if Focused or Hovered then
      Apply of TMsg(Layout.Cells, Columns, Control, Theme, Focused);
    end if;
  end for;

  return Controls.ToArray();
end function;

// Shows a hovered action's hint on the terminal's last line for this frame.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Layout`: Current cells and routing.
// - `Columns`: Terminal width.
// - `Theme`: Colors for the hint.
// - `Hover`: Hovered control identity.
// - `Scope`: Current input scope.
public procedure ShowHint of TMsg(
  Layout: A.Layout of TMsg;
  Columns: int;
  Theme: Th.Theme;
  Hover: string;
  Scope: string
);
begin
  const Control: (A.Control of TMsg)? := A.FindControl of TMsg(Layout, Hover);
  if Control = null or Control.Hint = '' or Control.Scope <> Scope then
    return;
  end if;

  const Area: F.Rect := new F.Rect(0, 0, Columns, 1);
  const Surface: int := Th.Rgb(Theme.Colors.SurfaceRaised, Theme.Text.Background ?? 0);
  const Colors: T.Style := new T.Style(Th.Rgb(Theme.Colors.Foreground, Surface), Surface);
  const Operations: Generic.List of D.Operation := new Generic.List of D.Operation();
  Operations.Add(new D.Operation(' ' + Glyphs.SingleLine(Control.Hint), Area, Area, Colors, false));
  const Hint: D.Surface := D.Render(Operations, Columns, 1, [], Colors);
  const Row: int := Layout.Lines.Length - 1;
  Sys.Array.Copy(Hint.Cells, 0, Layout.Cells, Row * Columns, Columns);
  Layout.Lines[Row] := Hint.Lines[0];
end procedure;

end unit;
