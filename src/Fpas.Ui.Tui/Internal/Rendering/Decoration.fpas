unit Fpas.Ui.Tui.Internal.Rendering.Decoration;

uses Fpas.Ui.Tui.Internal.Widgets.HoldButton as Hold, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Application as App, Fpas.Ui.Tui.Internal.Layout.Scene as A, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Layout.ScrollViews as V, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, Fpas.Ui.Tui.Internal.Rendering.Buttons as Buttons, Fpas.Ui.Tui.Internal.Rendering.Glyphs as Glyphs, System as Sys, System.Collections.Generic as Generic;

public procedure Apply<TMsg>(
  Cells: array of T.Cell; Columns: int; Control: A.Control<TMsg>;
  Theme: Th.Theme; Focused: bool
);
  procedure Mark(Column: int; Row: int; Style: T.Style);
  begin
    if Control.Bounds.Contains(Column, Row) then
      const Index: int := Row * Columns + Column;
      Cells[Index] := new T.Cell(Cells[Index].Text, Style);
    end if;
  end procedure;
begin
  const Bounds: F.Rect := Control.Bounds;
  case Control.Action of
    when A.Binding.Scroll(const View: V.Viewport<TMsg>):
      if Focused then
        Mark(
          if View.Bar then
            Bounds.X + Bounds.Width - 1
          else
            Bounds.X
          end if,
          Bounds.Y,
          Theme.Focus
        );
      end if;

      return;
    else
  end case;
  const Widgets: Th.WidgetStyles? := Theme.Widgets;
  const Standard: T.Style := if not Focused then
    Theme.Hover
  else
    Theme.Focus
  end if;
  const Style: T.Style := if Control.ButtonStyle then
    Buttons.WithForeground(
      Theme,
      Buttons.Resolve(
        Theme,
        Control.Variant,
        Control.Enabled,
        Focused,
        not Focused,
        Control.Appearance
      ) ?? Standard,
      if Control.Enabled then
        Control.Foreground
      else
        null
      end if
    )
  else
    Standard
  end if;
  const Filled: int := Bounds.Width * Control.HoldProgress div 100;
  const FillStyle: T.Style := if Filled > 0 then
    Hold.FillStyle(
      Style,
      Theme.Text.Background ?? 0
    )
  else
    Style
  end if;
  for Y: int := Bounds.Y to Bounds.Y + Bounds.Height - 1 do
    for X: int := Bounds.X to Bounds.X + Bounds.Width - 1 do
      Mark(
        X, Y, if X < Bounds.X + Filled then
          FillStyle
        else
          Style
        end if
      );
    end for;
  end for;
end procedure;

public function Capture<TMsg>(
  Layout: A.Layout<TMsg>; Columns: int; Theme: Th.Theme; Focus: string; Hover: string; Scope: string
): array of App.ControlSnapshot;
begin
  const Controls: Generic.List<App.ControlSnapshot> := new Generic.List<App.ControlSnapshot>(
    Layout.Controls.Length
  );
  for Control: A.Control<TMsg> in Layout.Controls do
    const Focused: bool := Control.Id = Focus;
    const Hovered: bool := Control.Id = Hover;
    Controls.Add(
      new App.ControlSnapshot(
        Control.Id,
        Control.Label,
        Control.Role,
        Control.Value,
        Control.Bounds.X,
        Control.Bounds.Y,
        Control.Bounds.Width,
        Control.Bounds.Height,
        Focused,
        Hovered,
        Control.Enabled and Control.Scope = Scope
      )
    );
    if Focused or Hovered then
      Apply<TMsg>(Layout.Cells, Columns, Control, Theme, Focused);
    end if;
  end for;

  return Controls.ToArray();
end function;

// Shows a hovered action's hint on the terminal's last line for this frame.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Layout`: Current cells and routing.
// - `Columns`: Terminal width.
// - `Theme`: Colors for the hint.
// - `Hover`: Hovered control identity.
// - `Scope`: Current input scope.
public procedure ShowHint<TMsg>(Layout: A.Layout<TMsg>; Columns: int; Theme: Th.Theme; Hover: string; Scope: string);
begin
  const Control: A.Control<TMsg>? := A.FindControl<TMsg>(Layout, Hover);
  if Control = null or Control.Hint = '' or Control.Scope <> Scope then
    return;
  end if;

  const Area: F.Rect := new F.Rect(0, 0, Columns, 1);
  const Surface: int := Th.Rgb(Theme.Colors.SurfaceRaised, Theme.Text.Background ?? 0);
  const Colors: T.Style := new T.Style(Th.Rgb(Theme.Colors.Foreground, Surface), Surface);
  const Operations: Generic.List<D.Operation> := new Generic.List<D.Operation>();
  Operations.Add(new D.Operation(' ' + Glyphs.SingleLine(Control.Hint), Area, Area, Colors, false));
  const Hint: D.Surface := D.Render(Operations, Columns, 1, [], Colors);
  const Row: int := Layout.Lines.Length - 1;
  Sys.Array.Copy(Hint.Cells, 0, Layout.Cells, Row * Columns, Columns);
  Layout.Lines[Row] := Hint.Lines[0];
end procedure;
end unit;
