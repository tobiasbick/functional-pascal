unit Fpas.Ui.Tui.Internal.Rendering.Drawing;

uses Fpas.Ui.Tui.Themes as Th, Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, System as Sys, System.Collections.Generic as Generic, System.Globalization as Global, System.Text as Text;

public type Operation = record
  public Value: string;
  public Area: F.Rect;
  public Clip: F.Rect;
  public Style: T.Style;
  public Wrap: bool;
end record;

public type PaintedRow = record
  public Operations: array of Operation;
  public DefaultStyle: T.Style;
  public Cells: array of T.Cell;
  public Text: string;
end record;

public type Surface = record
  public Rows: array of PaintedRow;
  public Cells: array of T.Cell;
  public Lines: array of string;
end record;

public procedure Fill(Operations: Generic.List<Operation>; Area: F.Rect; Style: T.Style);
begin
  const Spaces: string := new string(#32, Area.Width);
  for Row: int := Area.Y to Area.Y + Area.Height - 1 do
    Operations.Add(
      new Operation(Spaces, new F.Rect(Area.X, Row, Area.Width, 1), Area, Style, false)
    );
  end for;
end procedure;

public function PlaceholderStyle(Field: T.Style; Theme: Th.Theme): T.Style;
begin
  return if Theme.PlaceholderColor < 0 then Field
    else new T.Style(Theme.PlaceholderColor, Field.Background)
    end if;
end function;

public function SelectionStyle(Selected: bool; Style: T.Style; Widgets: Th.WidgetStyles?): T.Style;
begin
  return if Selected and Widgets <> null then Widgets.Selected else Style end if;
end function;

public procedure ListRow(
  Operations: Generic.List<Operation>; Area: F.Rect; Clip: F.Rect;
  Caption: string; Selected: bool; Style: T.Style; Widgets: Th.WidgetStyles?
);
begin
  const Prefix: string := if Selected then if Widgets = null then '* ' else '▸ ' end if
    else '  '
    end if;
  const Color: T.Style := SelectionStyle(Selected, Style, Widgets);
  if Selected and Widgets <> null then
    Fill(Operations, F.Intersect(Area, Clip), Color);
  end if;

  Operations.Add(new Operation(Prefix + Caption, Area, Clip, Color, false));
end procedure;

function BorderStyle(Style: T.Style; Widgets: Th.WidgetStyles?): T.Style;
begin
  return if Widgets = null then Style
    else new T.Style(
      Widgets.BorderColor,
      Style.Background
    )
    end if;
end function;

function HorizontalEdge(Widgets: Th.WidgetStyles?): char;
begin
  return if Widgets = null then #45 else #9472 end if;
end function;

public procedure Divider(
  Operations: Generic.List<Operation>; Area: F.Rect; Clip: F.Rect; Title: string;
  Style: T.Style; Widgets: Th.WidgetStyles?
);
begin
  const Width: int := Clip.X + Clip.Width - Area.X;
  const Edge: char := HorizontalEdge(Widgets);
  var Caption: string := '';
  if Title <> '' and Width > 4 then
    const Normalized: string := G.SingleLine(Title);
    Caption := Normalized.Substring(0, G.IndexAt(Normalized, 0, Width - 4));
  end if;

  const Prefix: string := if Caption = '' then ''
    else new string(
      Edge,
      1
    ) + ' ' + Caption + ' '
    end if;
  const Length: int := if Prefix = '' then 0 else G.Measure(Prefix) end if;
  const Line: F.Rect := new F.Rect(Area.X, Area.Y, Width, 1);
  Operations.Add(
    new Operation(
      Prefix + new string(Edge, Width - Length),
      Line,
      Clip,
      BorderStyle(Style, Widgets),
      false
    )
  );
end procedure;

public procedure Border(
  Operations: Generic.List<Operation>; Area: F.Rect; Clip: F.Rect; Title: string;
  Style: T.Style; Widgets: Th.WidgetStyles?
);
  procedure Line(Value: string; Column: int; Row: int; Width: int);
  begin
    Operations.Add(new Operation(Value, new F.Rect(Column, Row, Width, 1), Clip, Color, false));
  end procedure;
begin
  const Color: T.Style := BorderStyle(Style, Widgets);
  const Rounded: bool := Widgets <> null;
  const Edge: char := HorizontalEdge(Widgets);
  const Vertical: string := if Rounded then '│' else '|' end if;
  const Inner: int := Sys.Math.Max(0, Area.Width - 2);
  const Span: string := new string(Edge, Inner);
  const Top: string := if Rounded then '╭' + Span + '╮' else '+' + Span + '+' end if;
  Line(Top, Area.X, Area.Y, Area.Width);
  if Title.Length > 0 and Inner > 0 then
    Line(if Rounded then ' ' + Title + ' ' else Title end if, Area.X + 1, Area.Y, Inner);
  end if;

  for Row: int := Sys.Math.Max(Clip.Y, Area.Y + 1) to Sys.Math.Min(
    Clip.Y + Clip.Height - 1, Area.Y + Area.Height - 2
  ) do
    Line(Vertical, Area.X, Row, 1);
    if Area.Width > 1 then
      Line(Vertical, Area.X + Area.Width - 1, Row, 1);
    end if;
  end for;

  if Area.Height > 1 then
    const Bottom: string := if Rounded then '╰' + Span + '╯' else '+' + Span + '+' end if;
    Line(Bottom, Area.X, Area.Y + Area.Height - 1, Area.Width);
  end if;
end procedure;

public procedure Progress(
  Operations: Generic.List<Operation>; Area: F.Rect; Clip: F.Rect; Percent: int;
  Style: T.Style; Widgets: Th.WidgetStyles?
);
begin
  const Amount: int := Percent * Area.Width div 100;
  if Widgets = null then
    Operations.Add(
      new Operation(
        new string(#35, Amount) + new string(#45, Area.Width - Amount), Area, Clip, Style, false
      )
    );
    return;
  end if;

  if Amount > 0 then
    Operations.Add(
      new Operation(
        new string(#9473, Amount), new F.Rect(Area.X, Area.Y, Amount, 1), Clip,
        new T.Style(Widgets.ProgressFillColor, Style.Background), false
      )
    );
  end if;
  const Left: int := Area.Width - Amount;
  if Left > 0 then
    Operations.Add(
      new Operation(
        new string(#9472, Left), new F.Rect(Area.X + Amount, Area.Y, Left, 1), Clip,
        new T.Style(Widgets.ProgressTrackColor, Style.Background), false
      )
    );
  end if;
end procedure;

function Same(Left: array of Operation; Right: array of Operation): bool;
begin
  if Left.Length <> Right.Length then
    return false;
  end if;

  for Index: int := 0 to Left.Length - 1 do
    if Left[Index] <> Right[Index] then
      return false;
    end if;
  end for;

  return true;
end function;

function PaintRow(Operations: array of Operation; Columns: int; TargetRow: int; Blank: T.Cell): PaintedRow;
  procedure Erase(Column: int);
  begin
    const Old: string := Buffer[Column].Text;
    if Old = '' and Column > 0 then
      Buffer[Column - 1] := Blank;
    else
      if G.Width(Old) = 2 and Column + 1 < Columns then
        Buffer[Column + 1] := Blank;
      end if;
    end if;

    Buffer[Column] := Blank;
  end procedure;

  procedure Put(Column: int; Value: string; Style: T.Style; Clip: F.Rect);
  begin
    const Glyph: string := G.Sanitize(Value);
    const Span: int := G.Width(Glyph);
    if Clip.Contains(Column, TargetRow) and Clip.Contains(Column + Span - 1, TargetRow) then
      Erase(Column);
      if Span = 2 then
        Erase(Column + 1);
      end if;

      Buffer[Column] := new T.Cell(Glyph, Style);
      if Span = 2 then
        Buffer[Column + 1] := new T.Cell('', Style);
      end if;
    end if;
  end procedure;

  procedure Draw(Item: Operation);
  begin
    const Glyphs: Global.TextElementEnumerator := Global.StringInfo.GetTextElementEnumerator(
      Item.Value
    );
    var X: int := Item.Area.X;
    var Y: int := Item.Area.Y;
    while Y <= TargetRow and Y < Item.Area.Y + Item.Area.Height and Glyphs.MoveNext() do
      const Glyph: string := Glyphs.GetTextElement();
      const Span: int := G.Width(Glyph);
      const LineBreak: bool := G.LineBreak(Glyph);
      if LineBreak or X + Span > Item.Area.X + Item.Area.Width then
        if not Item.Wrap then
          break;
        end if;

        X := Item.Area.X;
        Y := Y + 1;
        if LineBreak then
          continue;
        end if;
      end if;

      if Span <= Item.Area.Width then
        if Y = TargetRow then
          Put(X, Glyph, Item.Style, Item.Clip);
        end if;

        X := X + Span;
      end if;
    end while;
  end procedure;
begin
  const Buffer: Generic.List<T.Cell> := new Generic.List<T.Cell>(Columns);
  for Column: int := 1 to Columns do
    Buffer.Add(Blank);
  end for;

  for Item: Operation in Operations do
    Draw(Item);
  end for;
  const Line: Text.StringBuilder := new Text.StringBuilder();
  for Cell: T.Cell in Buffer do
    discard Line.Append(Cell.Text);
  end for;

  return new PaintedRow(Operations, Blank.Colors, Buffer.ToArray(), Line.ToString());
end function;

public function Render(
  Operations: Generic.List<Operation>; Columns: int; Rows: int;
  Previous: array of PaintedRow; DefaultStyle: T.Style
): Surface;
begin
  const Blank: T.Cell := new T.Cell(' ', DefaultStyle);
  const Pending: Generic.List<Generic.List<Operation>> := new Generic.List<Generic.List<Operation>>(
    Rows
  );
  for Row: int := 1 to Rows do
    Pending.Add(new Generic.List<Operation>());
  end for;

  for Item: Operation in Operations do
    const Visible: F.Rect := F.Intersect(Item.Area, Item.Clip);
    for Row: int := Visible.Y to Visible.Y + Visible.Height - 1 do
      Pending[Row].Add(Item);
    end for;
  end for;
  const Painted: Generic.List<PaintedRow> := new Generic.List<PaintedRow>(Rows);
  const Cells: Generic.List<T.Cell> := new Generic.List<T.Cell>(Columns * Rows);
  const Lines: Generic.List<string> := new Generic.List<string>(Rows);
  for Row: int := 0 to Rows - 1 do
    const Plan: array of Operation := Pending[Row].ToArray();
    const Complete: PaintedRow := if Row < Previous.Length and Previous[Row].Cells.Length = Columns
        and Previous[Row].DefaultStyle = DefaultStyle and Same(
        Plan,
        Previous[Row].Operations
      ) then Previous[Row]
      else PaintRow(Plan, Columns, Row, Blank)
      end if;
    Painted.Add(Complete);
    Cells.AddRange(Complete.Cells);
    Lines.Add(Complete.Text);
  end for;

  return new Surface(Painted.ToArray(), Cells.ToArray(), Lines.ToArray());
end function;
end unit;
