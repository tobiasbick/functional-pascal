unit Fpas.Ui.Tui.Internal.Rendering.EditorText;

uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Internal.View.Editors as Editors, Fpas.Ui.Tui.Internal.Layout.EditorView as View, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Rendering.Drawing as D, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, Fpas.Ui.Tui.Internal.Hosting.Editing as Edit, System as Sys, System.Collections.Generic as Generic;

public procedure Draw(Operations: Generic.List<D.Operation>; Document: View.Document; Style: T.Style; Theme: Th.Theme);
begin
  const Area: F.Rect := Document.Area;
  const Position: Editors.EditorPosition := Document.Position;
  const Widgets: Th.WidgetStyles? := Theme.Widgets;
  const Field: T.Style := if Widgets = null then Style else Widgets.Field end if;
  D.Fill(Operations, Area, Field);
  const Bottom: int := Sys.Math.Min(Document.Lines.Length, Position.TopRow + Area.Height);
  for Row: int := Position.TopRow to Bottom - 1 do
    const Line: string := Document.Lines[Row].Text;
    const Start: int := G.IndexAt(Line, 0, Position.LeftColumn);
    if Start < Line.Length then
      const Left: int := Position.LeftColumn - G.Measure(Line.Substring(0, Start));
      const Bounds: F.Rect := new F.Rect(
        Area.X - Left,
        Area.Y + Row - Position.TopRow,
        Area.Width + Left,
        1
      );
      Operations.Add(new D.Operation(Line.Substring(Start), Bounds, Area, Field, false));
    end if;
  end for;
end procedure;

// Paints a single-line prompt and document using the same viewport as caret placement.
//
// ## Parameters
// - `Operations`: Staged terminal paint operations.
// - `Document`: Resolved cell viewport and controlled text.
// - `Area`: Full field allocation.
// - `Clip`: Visible field bounds.
// - `Placeholder`: Hint displayed only for empty text.
// - `Style`: Enclosing colors.
// - `Theme`: Terminal widget colors.
public procedure DrawField(Operations: Generic.List<D.Operation>; Document: View.Document; Area: F.Rect; Clip: F.Rect; Placeholder: string; Style: T.Style; Theme: Th.Theme);
begin
  const Widgets: Th.WidgetStyles? := Theme.Widgets;
  const Field: T.Style := if Widgets = null then Style else Widgets.Field end if;
  D.Fill(Operations, Clip, Field);
  Operations.Add(
    new D.Operation(if Widgets = null then '> ' else '› ' end if, Area, Clip, Field, false)
  );
  Draw(Operations, Document, Style, Theme);
  if Document.Text = '' and Placeholder <> '' then
    Operations.Add(
      new D.Operation(
        G.SingleLine(Placeholder),
        Document.Area,
        Clip,
        D.PlaceholderStyle(Field, Theme),
        false
      )
    );
  end if;
end procedure;

public procedure MarkSelection(Document: View.Document; Theme: Th.Theme; Mark: procedure(int, int, T.Style));
begin
  const Area: F.Rect := Document.Area;
  const Position: Editors.EditorPosition := Document.Position;
  const Left: int := Position.LeftColumn;
  const First: int := Sys.Math.Min(Position.Caret, Position.Anchor);
  const Last: int := Sys.Math.Max(Position.Caret, Position.Anchor);
  const Widgets: Th.WidgetStyles? := Theme.Widgets;
  const Selection: T.Style := if Widgets = null then Theme.Focus else Widgets.Selected end if;
  const Bottom: int := Sys.Math.Min(Document.Lines.Length, Position.TopRow + Area.Height);
  if First <> Last then
    for Row: int := Position.TopRow to Bottom - 1 do
      const Line: View.Line := Document.Lines[Row];
      const EndIndex: int := Line.Start + Line.Text.Length;
      if Last > Line.Start and First <= EndIndex then
        const StartColumn: int := Sys.Math.Max(Left, View.ColumnAt(Line, First));
        const EndColumn: int := View.ColumnAt(
          Line,
          Last
        ) + (if Last > EndIndex then 1 else 0 end if);
        for Column: int := StartColumn to Sys.Math.Min(Left + Area.Width, EndColumn) - 1 do
          Mark(Area.X + Column - Left, Area.Y + Row - Position.TopRow, Selection);
        end for;
      end if;
    end for;
  end if;

  const CaretRow: int := View.RowAt(Document.Lines, Position.Caret);
  if CaretRow >= Position.TopRow and CaretRow < Bottom then
    const Line: View.Line := Document.Lines[CaretRow];
    const Column: int := View.ColumnAt(Line, Position.Caret) - Left;
    if Column >= 0 and Column < Area.Width then
      const Index: int := Position.Caret - Line.Start;
      const Width: int := if Index < Line.Text.Length then G.Width(
          Line.Text.Substring(Index, Edit.Next(Line.Text, Index) - Index)
        )
        else 1
        end if;
      for X: int := Column to Sys.Math.Min(Area.Width, Column + Width) - 1 do
        Mark(Area.X + X, Area.Y + CaretRow - Position.TopRow, Theme.Caret);
      end for;
    end if;
  end if;
end procedure;
end unit;
