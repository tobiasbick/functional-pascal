unit Fpas.Ui.Tui.Internal.Rendering.Glyphs;

uses System as Sys, System.Globalization as Global;

// Measures one text element in terminal cells.
//
// ## Parameters
// - `Value`: A grapheme cluster or an empty string.
//
// ## Returns
// Zero for an empty string, one for a narrow glyph, or two for a wide glyph.
public function Width(Value: string): int;
begin
  if Value.Length = 0 then
    return 0;
  end if;
  var Code: int := cast<int>(Value[0]);
  if Value.Length > 1 and Sys.Char.IsSurrogatePair(Value[0], Value[1]) then
    Code := Sys.Char.ConvertToUtf32(Value[0], Value[1]);
  end if;

  const FirstIndicator: int := $1F1E6;
  const LastIndicator: int := $1F1FF;
  if Code >= FirstIndicator and Code <= LastIndicator and Value.Length >= 4
    and Sys.Char.IsSurrogatePair(Value[2], Value[3])
  then
    const Second: int := Sys.Char.ConvertToUtf32(Value[2], Value[3]);
    if Second >= FirstIndicator and Second <= LastIndicator then
      return 2;
    end if;
  end if;

  if (Code >= 4352 and Code <= 4447) or (Code >= 11904 and Code <= 42191)
    or (Code >= 44032 and Code <= 55203) or (Code >= 63744 and Code <= 64255)
    or (Code >= 65040 and Code <= 65376) or (Code >= 65504 and Code <= 65510)
    or (Code >= 127744 and Code <= 129791) or (Code >= 131072 and Code <= 196605)
    or Value.IndexOf(cast<char>(65039)) >= 0
  then
    return 2;
  end if;

  return 1;
end function;

public function Sanitize(Value: string): string;
begin
  if Value.Length = 0 then
    return ' ';
  end if;

  if Sys.Char.IsControl(Value[0]) or (Value.Length = 1 and Sys.Char.IsSurrogate(Value[0])) then
    return ' ';
  end if;

  return Value;
end function;

public function Measure(Value: string): int;
begin
  const Glyphs: Global.TextElementEnumerator := Global.StringInfo.GetTextElementEnumerator(Value);
  var Cells: int := 0;
  while Glyphs.MoveNext() do
    Cells := Cells + Width(Glyphs.GetTextElement());
  end while;

  return Cells;
end function;

public function LineBreak(Glyph: string): bool;
begin
  return Glyph[0] = #10 or Glyph[0] = #13;
end function;

public function LineWidth(Value: string): int;
begin
  const Glyphs: Global.TextElementEnumerator := Global.StringInfo.GetTextElementEnumerator(Value);
  var Longest: int := 0;
  var Cells: int := 0;
  while Glyphs.MoveNext() do
    const Glyph: string := Glyphs.GetTextElement();
    if LineBreak(Glyph) then
      Longest := Sys.Math.Max(Longest, Cells);
      Cells := 0;
    else
      Cells := Cells + Width(Glyph);
    end if;
  end while;

  return Sys.Math.Max(Longest, Cells);
end function;

public function LineCount(Value: string; Columns: int): int;
begin
  const Glyphs: Global.TextElementEnumerator := Global.StringInfo.GetTextElementEnumerator(Value);
  var Rows: int := 1;
  var Cells: int := 0;
  while Glyphs.MoveNext() do
    const Glyph: string := Glyphs.GetTextElement();
    if LineBreak(Glyph) then
      Rows := Rows + 1;
      Cells := 0;
    else
      if Columns > 0 then
        const Span: int := Width(Glyph);
        if Cells + Span > Columns then
          Rows := Rows + 1;
          Cells := 0;
        end if;

        if Span <= Columns then
          Cells := Cells + Span;
        end if;
      end if;
    end if;
  end while;

  return Rows;
end function;

public function SingleLine(Value: string): string;
begin
  return Value.Replace(
    new string([#13, #10]),
    ' '
  ).Replace(#13, #32).Replace(#10, #32).Replace(#8232, #32).Replace(#8233, #32);
end function;

public function IndexAt(Value: string; Start: int; Column: int): int;
begin
  if Column <= 0 then
    return Start;
  end if;
  const Glyphs: Global.TextElementEnumerator := Global.StringInfo.GetTextElementEnumerator(
    Value,
    Start
  );
  var Position: int := 0;
  while Glyphs.MoveNext() do
    const Glyph: string := Glyphs.GetTextElement();
    Position := Position + Width(Glyph);
    if Column < Position then
      return Glyphs.ElementIndex;
    end if;
  end while;

  return Value.Length;
end function;
end unit;
