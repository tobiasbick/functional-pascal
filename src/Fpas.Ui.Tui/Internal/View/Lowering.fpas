// [Documentation](../../../../docs/ui/tui/host.md#cell-presentation)

unit Fpas.Ui.Tui.Internal.View.Lowering;

uses Fpas.Ui.Tui.Internal.Widgets.Inputs.Select as Select, Fpas.Ui.Widgets.Inputs.Selects as Selects, Fpas.Ui.Tui.Internal.Widgets.Inputs.RadioGroup as Radios, Fpas.Ui.Widgets.Inputs.RadioGroups as R, Fpas.Ui.Tui.Internal.Widgets.Inputs.ToggleRows as Toggles, Fpas.Ui.Tui.Internal.Widgets.Collections.Table as TableWidget, Fpas.Ui.Widgets.Collections.Tables as Tables, Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit, Fpas.Ui.Tui.Internal.Widgets.Inputs.TextField as FieldWidget, Fpas.Ui.Widgets.Inputs.TextFields as Fields, Fpas.Ui.Widgets.Desktop.StatusBars as StatusBars, Fpas.Ui.Tui.Internal.Widgets.Desktop.StatusBar as StatusLine, Fpas.Ui.TerminalExtensions.CellGrids as Grids, Fpas.Ui.Widgets.Feedback.ProgressBars as ProgressBars, Fpas.Ui.Tui.Internal.Widgets.Feedback.ProgressBar as Progress, Fpas.Ui.Widgets.Actions.Buttons as B, Fpas.Ui.Tui.Internal.Widgets.Actions.Button as Button, Fpas.Ui.Elements as Ui, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Navigation.Navigation as N, Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs, Fpas.Ui.Widgets.Overlays.Sheets as Sheets, Fpas.Ui.Styles as UiStyle, Fpas.Ui.Widgets.Developer.Terminal as T, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Validation as V, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Widgets.Navigation.Sidebar as Sidebar, Fpas.Ui.Tui.Internal.Widgets.Overlays.ModalPanel as Panel, Fpas.Ui.Tui.Internal.Layout.Flexible as Geometry, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, System as Sys, System.Collections.Generic as C;

// Converts shared flex rules into resolved cell constraints.
//
// ## Parameters
// - `Value`: Validated shared rule.
// - `Horizontal`: Parent main axis.
//
// ## Returns
// Cell allocation constraints.
public function Flex(Value: L.Flex; Horizontal: bool := true): E.Flex;
begin
  var Basis: int := -1;
  var Grow: float := Value.Grow;
  case Value.Basis of
    when L.Extent.Fixed(const Distance: L.Measure):
      Basis := Geometry.Cells(Distance, Horizontal);
    when L.Extent.Fill:
      Grow := Sys.Math.Max(1.0F, Grow);
    when L.Extent.Percent(_):
      raise new Sys.NotSupportedException('Percentage extents require the graphical profile.');
    else
  end case;
  const Minimum: L.Measure? := Value.Minimum;
  const Maximum: L.Measure? := Value.Maximum;
  return new E.Flex(
    Basis, if Minimum = null then
      0
    else
      Geometry.Cells(Minimum, Horizontal)
    end if,
    if Maximum = null then
      int.MaxValue
    else
      Geometry.Cells(Maximum, Horizontal)
    end if, Grow
  );
end function;

function Spacing(Value: L.Spacing; Horizontal: bool): int;
begin
  case Value of
    when L.Spacing.None:
      return 0;
    when L.Spacing.Tight:
      return 1;
    when L.Spacing.Normal:
      return 1;
    when L.Spacing.Loose:
      return if Horizontal then
        2
      else
        1
      end if;
    when L.Spacing.Fixed(const Distance: L.Measure):
      return Geometry.Cells(Distance, Horizontal);
  end case;
end function;

function Role(Theme: Th.Theme; Value: UiStyle.Role; Inherited: T.Style): T.Style;
begin
  const Backdrop: int := Inherited.Background ?? Theme.Text.Background ?? 0;
  if Value = UiStyle.Role.Default then
    return new T.Style();
  end if;

  if Value = UiStyle.Role.Panel or Value = UiStyle.Role.OutlinedPanel
    or Value = UiStyle.Role.MutedPanel or Value = UiStyle.Role.Divider
  then
    const Surface: int := Th.Rgb(
      case Value of
        when UiStyle.Role.MutedPanel: Theme.Colors.SurfaceMuted;
        when UiStyle.Role.Divider: Theme.Colors.Border;
        else Theme.Colors.Surface;
      end case, Backdrop
    );
    return new T.Style(Th.Rgb(Theme.Colors.Foreground, Surface), Surface);
  end if;

  return new T.Style(
    Foreground := Th.Rgb(
      case Value of
        when UiStyle.Role.Muted: Theme.Colors.TextMuted;
        when UiStyle.Role.Primary: Theme.Colors.Accent;
        when UiStyle.Role.Secondary: Theme.Colors.TextSecondary;
        when UiStyle.Role.Error: Theme.Colors.Danger;
        else Theme.Colors.Foreground;
      end case, Backdrop
    )
  );
end function;

function Merge(Parent: T.Style; Child: T.Style): T.Style;
begin
  return new T.Style(
    if Child.Foreground = null then
      Parent.Foreground
    else
      Child.Foreground
    end if,
    if Child.Background = null then
      Parent.Background
    else
      Child.Background
    end if
  );
end function;

// Lowers a validated shared tree into terminal measurement and painting data.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Prepared`: Terminal-profile preflight result.
// - `Popup`: Session-local select interactions.
// - `Theme`: Current terminal theme.
//
// ## Returns
// The resolved backend tree, with no application-facing constructors.
public function Prepare<TMsg>(
  Prepared: V.Prepared<TMsg>; Theme: Th.Theme; Popup: Select.State<TMsg>
): E.Element<TMsg>;
  function Children(Items: array of Ui.Element<TMsg>; Colors: T.Style; Horizontal: bool := false): array of E.Element<TMsg>;
  begin
    const Values: C.List<E.Element<TMsg>> := new C.List<E.Element<TMsg>>();
    for Item: Ui.Element<TMsg> in Items do
      Values.Add(Visit(Item, Colors, Horizontal));
    end for;

    return Values.ToArray();
  end function;
  function Visit(Node: Ui.Element<TMsg>; Colors: T.Style; ParentHorizontal: bool := false): E.Element<TMsg>;
  begin
    case Node of
      when Ui.Element.TerminalCellGrid(
        const Id: string,
        const Content: Grids.Image?,
        const Changed: function(Grids.Event): TMsg
      ):
        return E.Element<TMsg>.CellGrid(Id, Content, Changed);
      when Ui.Element.Label(const Text: string):
        return E.Element<TMsg>.Label(Text);
      when Ui.Element.ProgressBar(_, const Fraction: float, const Settings: ProgressBars.Options):
        return Progress.Lower<TMsg>(Fraction, Settings, Theme);
      when Ui.Element.StatusBar(
        const Id: string,
        const Items: array of StatusBars.Item<TMsg>,
        const HideBorder: bool
      ):
        return StatusLine.Lower<TMsg>(Id, Items, HideBorder, Theme);
      when Ui.Element.ButtonAction(
        const Id: string,
        const Text: string,
        const Message: TMsg,
        const Settings: B.Options
      ):
        return Button.Lower<TMsg>(Id, Text, Message, Settings);
      when Ui.Element.SelectInput(
        const Id: string,
        const Items: array of Selects.Item,
        const Selected: int,
        const Change: function(int): TMsg,
        const Settings: Selects.Options
      ):
        return Select.Lower<TMsg>(
          new Select.Trigger<TMsg>(Id, Items, Selected, Change, Settings, Popup)
        );
      when Ui.Element.Radios(
        const Id: string,
        const Items: array of R.Item,
        const Selected: int,
        const Change: function(int): TMsg,
        const Enabled: bool,
        const Gap: L.Spacing
      ):
        return Radios.Lower<TMsg>(Id, Items, Selected, Change, Enabled, Spacing(Gap, false));
      when Ui.Element.CheckboxAction(
        const Id: string,
        const Label: string,
        const Checked: bool,
        const Change: function(bool): TMsg,
        const Description: string,
        const Enabled: bool,
        const Indeterminate: bool,
        const HideLabel: bool
      ):
        return Toggles.Checkbox<TMsg>(
          Id,
          Label,
          Checked,
          Change,
          Description,
          Enabled,
          Indeterminate,
          HideLabel
        );
      when Ui.Element.SwitchAction(
        const Id: string,
        const Label: string,
        const On: bool,
        const Change: function(bool): TMsg,
        const Description: string,
        const Enabled: bool
      ):
        return Toggles.Switch<TMsg>(Id, Label, On, Change, Description, Enabled);
      when Ui.Element.TextField(
        const Id: string, const Value: string, const Change: function(string): TMsg,
        const Settings: Fields.Options, const Submit: Sys.Func<string, TMsg>?
      ):
        return FieldWidget.Lower<TMsg>(
          new Edit.Field<TMsg>(Id, Value, Change, Settings, Submit),
          Colors,
          Theme
        );
      when Ui.Element.Table(
        const Id: string, const Columns: array of Tables.Column,
        const Rows: array of Tables.Row<TMsg>, const Order: Tables.Sort?,
        const OnSort: Sys.Func<Tables.Sort, TMsg>?, const OnSelect: Sys.Func<string, TMsg>?,
        const Settings: Tables.Options
      ):
        return E.Element<TMsg>.Table(
          new E.TableView<TMsg>(
            Id,
            Columns,
            Rows,
            Order,
            OnSort,
            OnSelect,
            Settings,
            TableWidget.MeasureColumns<TMsg>(Columns, Rows, Order)
          )
        );
      when Ui.Element.Sidebar(
        const Id: string,
        const Sections: array of N.Section<TMsg>,
        const Active: string?,
        const Enabled: bool
      ):
        return Sidebar.Lower<TMsg>(Id, Sections, Active, Enabled);
      when Ui.Element.Stack(
        const Items: array of Ui.Element<TMsg>,
        const Horizontal: bool,
        const Flow: L.Flow
      ):
        return E.Element<TMsg>.Stack(
          Children(Items, Colors, Horizontal),
          Horizontal,
          new E.Flow(
            Spacing(Flow.Gap, Horizontal),
            Spacing(Flow.Padding, true),
            Spacing(Flow.Padding, false),
            Flow.Align
          )
        );
      when Ui.Element.Sized(const Child: Ui.Element<TMsg>, const Rule: L.Flex):
        return E.Element<TMsg>.Sized(
          Visit(Child, Colors, ParentHorizontal),
          Flex(Rule, ParentHorizontal)
        );
      when Ui.Element.Styled(const Child: Ui.Element<TMsg>, const Value: UiStyle.Role):
        const Next: T.Style := Merge(Colors, Role(Theme, Value, Colors));
        return E.Element<TMsg>.Decorated(Visit(Child, Next, ParentHorizontal), Next);
      when Ui.Element.TerminalStyle(const Child: Ui.Element<TMsg>, const Value: T.Style):
        const Next: T.Style := Merge(Colors, Value);
        return E.Element<TMsg>.Decorated(Visit(Child, Next, ParentHorizontal), Next);
      when Ui.Element.Framed(const Child: Ui.Element<TMsg>, const Title: string):
        return E.Element<TMsg>.Framed(Visit(Child, Colors), Title);
      when Ui.Element.Scroll(
        const Id: string,
        const Child: Ui.Element<TMsg>,
        const Position: L.ScrollPosition?,
        const Scroll: Sys.Func<L.ScrollChange, TMsg>?,
        const Bar: bool,
        _,
        _
      ):
        case Scroll of
          when is Sys.Func<L.ScrollChange, TMsg> as Callback:
            var Native: E.ScrollPosition := E.ScrollPosition.Offset(0);
            case Position of
              when L.ScrollPosition.End:
                Native := E.ScrollPosition.End;
              when L.ScrollPosition.Offset(const Distance: L.Measure):
                Native := E.ScrollPosition.Offset(Geometry.Cells(Distance, false));
              else
            end case;

            return E.Element<TMsg>.ControlledScroll(
              Id,
              Visit(Child, Colors),
              Native,
              Callback,
              Bar
            );
          else
            return E.Element<TMsg>.Scrollable(Id, Visit(Child, Colors), Bar);
        end case;
      when Ui.Element.Sheet(
        const Id: string, const Base: Ui.Element<TMsg>, const Content: Ui.Element<TMsg>,
        const Open: bool, const Settings: Sheets.Options, const Dismiss: TMsg
      ):
        return Panel.Lower<TMsg>(
          Id, Visit(Base, Colors, ParentHorizontal), Open,
          new E.ModalOptions(
            Settings.Title,
            Settings.Description,
            Settings.Size,
            Settings.Edge,
            Settings.InitialFocus,
            Sheets.CloseId(Id)
          ),
          Dismiss, Colors, Theme,
          function(PanelStyle: T.Style): E.Element<TMsg> => Visit(Content, PanelStyle)
        );
      when Ui.Element.Dialog(
        const Id: string, const Base: Ui.Element<TMsg>, const Content: Ui.Element<TMsg>,
        const Open: bool, const Settings: Dialogs.Options, const Dismiss: TMsg
      ):
        return Panel.Lower<TMsg>(
          Id, Visit(Base, Colors, ParentHorizontal), Open,
          new E.ModalOptions(
            Settings.Title, Settings.Description, Settings.Width, null, Settings.InitialFocus,
            if Settings.CloseButton then
              Dialogs.CloseId(Id)
            else
              null
            end if, not Settings.Persistent
          ),
          Dismiss, Colors, Theme,
          function(PanelStyle: T.Style): E.Element<TMsg> => Visit(Content, PanelStyle)
        );
      when Ui.Element.Deferred(const Id: string, _):
        return Visit(Prepared.Subviews[Id].Tree, Colors, ParentHorizontal);
      when Ui.Element.TerminalViewport(const Id: string, _):
        return Visit(Prepared.Subviews[Id].Tree, Colors, ParentHorizontal);
      when Ui.Element.TerminalScreen(
        const Content: Ui.Element<TMsg>,
        const Layers: array of Ui.Element<TMsg>,
        const Shortcuts: array of K.ShortcutBinding<TMsg>
      ):
        return E.Element<TMsg>.Desktop(Visit(Content, Colors), Children(Layers, Colors), Shortcuts);
      else
        raise new Sys.NotSupportedException('This widget requires the graphical profile.');
    end case;
  end function;
begin
  const Result: E.Element<TMsg> := Visit(Prepared.Tree, Theme.Text);
  return Result;
end function;

end unit;
