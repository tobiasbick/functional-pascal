// Converts shared flex rules into resolved cell constraints.
//
// ## Parameters
// - `Value`: Validated shared rule.
// - `Horizontal`: Parent main axis.
//
// ## Returns
// Cell allocation constraints.
public function Flex(Value: L.Flex; Horizontal: bool := true): E.Flex;
begin
  var Basis: int := -1;
  var Grow: float := Value.Grow;
  case Value.Basis of
    when L.Extent.Fixed(const Distance: L.Measure):
      Basis := Geometry.Cells(Distance, Horizontal);
    when L.Extent.Fill:
      Grow := Sys.Math.Max(1.0F, Grow);
    when L.Extent.Percent(_):
      raise new Sys.NotSupportedException('Percentage extents require the graphical profile.');
    else
  end case;
  const Minimum: L.Measure? := Value.Minimum;
  const Maximum: L.Measure? := Value.Maximum;
  return new E.Flex(
    Basis, if Minimum = null then
      0
    else
      Geometry.Cells(Minimum, Horizontal)
    end if,
    if Maximum = null then
      int.MaxValue
    else
      Geometry.Cells(Maximum, Horizontal)
    end if, Grow
  );
end function;

function Spacing(Value: L.Spacing; Horizontal: bool): int;
begin
  case Value of
    when L.Spacing.None:
      return 0;
    when L.Spacing.Tight:
      return 1;
    when L.Spacing.Normal:
      return 1;
    when L.Spacing.Loose:
      return if Horizontal then
        2
      else
        1
      end if;
    when L.Spacing.Fixed(const Distance: L.Measure):
      return Geometry.Cells(Distance, Horizontal);
  end case;
end function;

function Role(Theme: Th.Theme; Value: UiStyle.Role; Inherited: T.Style): T.Style;
begin
  const Backdrop: int := Inherited.Background ?? Theme.Text.Background ?? 0;
  if Value = UiStyle.Role.Default then
    return new T.Style();
  end if;

  if Value = UiStyle.Role.Panel or Value = UiStyle.Role.OutlinedPanel
    or Value = UiStyle.Role.MutedPanel or Value = UiStyle.Role.Divider
  then
    const Surface: int := Th.Rgb(
      case Value of
        when UiStyle.Role.MutedPanel: Theme.Colors.SurfaceMuted;
        when UiStyle.Role.Divider: Theme.Colors.Border;
        else Theme.Colors.Surface;
      end case, Backdrop
    );
    return new T.Style(Th.Rgb(Theme.Colors.Foreground, Surface), Surface);
  end if;

  return new T.Style(
    Foreground := Th.Rgb(
      case Value of
        when UiStyle.Role.Muted: Theme.Colors.TextMuted;
        when UiStyle.Role.Primary: Theme.Colors.Accent;
        when UiStyle.Role.Secondary: Theme.Colors.TextSecondary;
        when UiStyle.Role.Error: Theme.Colors.Danger;
        else Theme.Colors.Foreground;
      end case, Backdrop
    )
  );
end function;

function Merge(Parent: T.Style; Child: T.Style): T.Style;
begin
  return new T.Style(
    if Child.Foreground = null then
      Parent.Foreground
    else
      Child.Foreground
    end if,
    if Child.Background = null then
      Parent.Background
    else
      Child.Background
    end if
  );
end function;

// Lowers a validated shared tree into terminal measurement and painting data.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Prepared`: Terminal-profile preflight result.
// - `Theme`: Current terminal theme.
// - `Clipboard`: Host-owned copy feedback and clipboard operations.
// - `HoldTracking`: Owner session's active pointer hold.
// - `Menus`: Owner session's command-menu popup state.
// - `Confirmations`: Owner session's confirmation windows.
//
// ## Returns
// The resolved backend tree, with no application-facing constructors.
public function Prepare<TMsg>(
  Prepared: V.Prepared<TMsg>; Theme: Th.Theme;
  Clipboard: CopyWidget.State; HoldTracking: HoldWidget.State; Menus: Popup.State;
  Confirmations: ConfirmWidget.State
): E.Element<TMsg>;
  function Children(Items: array of Ui.Element<TMsg>; Colors: T.Style; Horizontal: bool := false): array of E.Element<TMsg>;
  begin
    const Values: C.List<E.Element<TMsg>> := new C.List<E.Element<TMsg>>();
    for Item: Ui.Element<TMsg> in Items do
      Values.Add(Visit(Item, Colors, Horizontal));
    end for;

    return Values.ToArray();
  end function;
  function Visit(Node: Ui.Element<TMsg>; Colors: T.Style; ParentHorizontal: bool := false): E.Element<TMsg>;
  begin
    case Node of
      when Ui.Element.FormattedText(_, _, _, _):
        raise new Sys.NotSupportedException('Formatted text requires the graphical host.');
      when Ui.Element.Label(const Text: string):
        return E.Element<TMsg>.Label(Text);
      when Ui.Element.Separator(const Title: string):
        return E.Element<TMsg>.Separator(Title);
      when Ui.Element.ButtonAction(
        const Id: string,
        const Text: string,
        const Message: TMsg,
        const Settings: B.Options
      ):
        return Button.Lower<TMsg>(Id, Text, Message, Settings);
      when Ui.Element.IconAction(
        const Id: string,
        _,
        const Tooltip: string,
        const Message: TMsg,
        const Settings: Icons.Options
      ):
        return IconButton.Lower<TMsg>(Id, Tooltip, Message, Settings);
      when Ui.Element.CopyAction(
        const Id: string,
        const Text: string,
        const OnCopied: Sys.Func<TMsg>?,
        const Enabled: bool
      ):
        return CopyWidget.Lower<TMsg>(Id, Text, OnCopied, Enabled, Clipboard, Theme.Colors.Success);
      when Ui.Element.HoldAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Holds.Options
      ):
        return HoldWidget.Lower<TMsg>(Id, Label, Message, Settings, HoldTracking);
      when Ui.Element.ConfirmAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Confirms.Options
      ):
        return ConfirmWidget.Lower<TMsg>(Id, Label, Message, Settings, Confirmations);
      when Ui.Element.StatusAction(
        const Id: string,
        const Label: string,
        const State: Status.Status,
        const Message: TMsg,
        const Settings: Status.Options
      ):
        return StatusWidget.Lower<TMsg>(Id, Label, State, Message, Settings, Theme);
      when Ui.Element.ThemeFlip(
        const Id: string, const Appearance: Themes.Mode,
        const Change: function(Themes.Mode): TMsg, const Enabled: bool
      ):
        return ThemeToggle.Lower<TMsg>(Id, Appearance, Change, Enabled);
      when Ui.Element.Segments(
        const Id: string, const Items: array of Segmented.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: Segmented.Options
      ):
        return SegmentedWidget.Lower<TMsg>(
          Id,
          Items,
          Selected,
          Change,
          Settings,
          Theme,
          Colors,
          []
        );
      when Ui.Element.ThemeChoice(
        const Id: string,
        const Selected: ThemeSwitchers.Selection,
        const Change: function(ThemeSwitchers.Selection): TMsg,
        const Settings: ThemeSwitchers.Options
      ):
        return ThemeSwitcher.Lower<TMsg>(Id, Selected, Change, Settings, Theme, Colors);
      when Ui.Element.Contextual(_, _, _, _):
        raise new Sys.NotSupportedException('Context menus require the graphical profile.');
      when Ui.Element.Hinted(_, _, _):
        raise new Sys.NotSupportedException('Tooltip requires the graphical profile.');
      when Ui.Element.TextField(
