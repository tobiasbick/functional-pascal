// [Documentation](../../../../docs/ui/tui/host.md#cell-presentation)

unit Fpas.Ui.Tui.Internal.View.Lowering;

uses Fpas.Ui.Elements as Ui;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as UiStyle;
uses Fpas.Ui.TerminalExtensions.CellGrids as Grids;
uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.TerminalExtensions.SelectionLists as Lists;
uses Fpas.Ui.Tui.Internal.Controls.Activation as Actions;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as Geometry;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Tui.Internal.Widgets.Actions.Button as Button;
uses Fpas.Ui.Tui.Internal.Widgets.Actions.SegmentedControl as Segments;
uses Fpas.Ui.Tui.Internal.Widgets.Charts.Sparkline as Sparkline;
uses Fpas.Ui.Tui.Internal.Widgets.Collections.FilterBar as FilterWidget;
uses Fpas.Ui.Tui.Internal.Widgets.Collections.SelectionList as SelectionList;
uses Fpas.Ui.Tui.Internal.Widgets.Collections.Table as TableWidget;
uses Fpas.Ui.Tui.Internal.Widgets.Collections.TreeRows as TreeRows;
uses Fpas.Ui.Tui.Internal.Widgets.Containers.ExpandableCard as Card;
uses Fpas.Ui.Tui.Internal.Widgets.Desktop.StatusBar as StatusLine;
uses Fpas.Ui.Tui.Internal.Widgets.Developer.LogConsole as Log;
uses Fpas.Ui.Tui.Internal.Widgets.Feedback.Alert as Alert;
uses Fpas.Ui.Tui.Internal.Widgets.Feedback.ProgressBar as Progress;
uses Fpas.Ui.Tui.Internal.Widgets.Feedback.Spinner as Spinner;
uses Fpas.Ui.Tui.Internal.Widgets.Files.FilePicker as FilePicker;
uses Fpas.Ui.Tui.Internal.Widgets.Files.FilePickerState as PickerState;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.MultiSelect as MultiSelect;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.NumberField as Number;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.RadioGroup as Radios;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.SearchField as Search;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.Select as Select;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextArea as AreaWidget;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextField as FieldWidget;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.ToggleRows as Toggles;
uses Fpas.Ui.Tui.Internal.Widgets.Navigation.Breadcrumb as Breadcrumb;
uses Fpas.Ui.Tui.Internal.Widgets.Navigation.Sidebar as Sidebar;
uses Fpas.Ui.Tui.Internal.Widgets.Navigation.Tabs as Tabs;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.Dropdown as Dropdown;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.ModalPanel as Panel;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.PopupState as PopupState;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Actions.SegmentedControls as Segmented;
uses Fpas.Ui.Widgets.Charts.Sparklines as Sparklines;
uses Fpas.Ui.Widgets.Collections.FilterBars as Filters;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Containers.ExpandableCards as Cards;
uses Fpas.Ui.Widgets.Desktop.StatusBars as StatusBars;
uses Fpas.Ui.Widgets.Developer.LogConsoles as Logs;
uses Fpas.Ui.Widgets.Developer.Terminal as T;
uses Fpas.Ui.Widgets.Feedback.Alerts as Alerts;
uses Fpas.Ui.Widgets.Feedback.ProgressBars as ProgressBars;
uses Fpas.Ui.Widgets.Feedback.Spinners as Spinners;
uses Fpas.Ui.Widgets.Files.FilePickers as Files;
uses Fpas.Ui.Widgets.Inputs.MultiSelects as Multi;
uses Fpas.Ui.Widgets.Inputs.NumberFields as NumberFields;
uses Fpas.Ui.Widgets.Inputs.RadioGroups as R;
uses Fpas.Ui.Widgets.Inputs.SearchFields as SearchFields;
uses Fpas.Ui.Widgets.Inputs.Selects as Selects;
uses Fpas.Ui.Widgets.Inputs.TextAreas as Areas;
uses Fpas.Ui.Widgets.Inputs.TextFields as Fields;
uses Fpas.Ui.Widgets.Navigation.Navigation as N;
uses Fpas.Ui.Widgets.Navigation.Tabs as TabSettings;
uses Fpas.Ui.Widgets.Overlays.CommandPalettes as Palettes;
uses Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;
uses Fpas.Ui.Widgets.Overlays.Sheets as Sheets;

uses System as Sys;
uses System.Collections.Generic as C;

// Lowers a validated shared tree into terminal measurement and painting data.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Prepared`: Terminal-profile preflight result.
// - `Popup`: Session-local popup interactions.
// - `Pickers`: Session-local file picker interactions.
// - `Size`: Current terminal viewport.
// - `Numbers`: Number field editing state.
// - `AlertsState`: Alert dismissal state.
// - `Theme`: Current terminal theme.
//
// ## Returns
// The resolved backend tree, with no application-facing constructors.
public function Prepare<TMsg>(
  Prepared: V.Prepared<TMsg>; Theme: Th.Theme; Popup: PopupState.State<TMsg>;
  Pickers: PickerState.State; Size: T.Viewport; Numbers: Number.State; AlertsState: Alert.State
): E.Element<TMsg>;
  function Children(Items: array of Ui.Element<TMsg>; Colors: T.Style; Horizontal: bool := false): array of E.Element<TMsg>;
  begin
    const Values: C.List<E.Element<TMsg>> := new C.List<E.Element<TMsg>>();
    for Item: Ui.Element<TMsg> in Items do
      case Item of
        when Ui.Element.Alert(const Id: string, _, _, _) if AlertsState.Hidden(Id):
          continue;
        else
      end case;

      Values.Add(Visit(Item, Colors, Horizontal));
    end for;

    return Values.ToArray();
  end function;
  function Visit(Node: Ui.Element<TMsg>; Colors: T.Style; ParentHorizontal: bool := false): E.Element<TMsg>;
  begin
    case Node of
      when Ui.Element.TerminalCellGrid(
        const Id: string,
        const Content: Grids.Image?,
        const Changed: function(Grids.Event): TMsg
      ):
        return E.Element<TMsg>.CellGrid(Id, Content, Changed);
      when Ui.Element.TerminalSelectionList(
        const Id: string, const Items: array of Lists.Item, const Selected: string,
        const OnSelect: function(string): TMsg, const OnActivate: function(string): TMsg
      ):
        return SelectionList.Lower<TMsg>(
          Id, Items, Selected,
          function(Key: string): Actions.Result<TMsg> => Actions.Result<TMsg>.Send(OnSelect(Key)),
          function(Key: string): Actions.Result<TMsg> => Actions.Result<TMsg>.Send(OnActivate(Key))
        );
      when Ui.Element.FilterBar(
        const Id: string, const FilterFields: array of Filters.Field, const Current: Filters.Value,
        const Change: function(Filters.Value): TMsg, const Capacity: int, const Enabled: bool
      ):
        return FilterWidget.Lower<TMsg>(
          Id,
          FilterFields,
          Current,
          Change,
          Capacity,
          Enabled,
          Popup
        );
      when Ui.Element.Label(const Text: string):
        return E.Element<TMsg>.Label(Text);
      when Ui.Element.LogConsole(
        const Id: string,
        const Entries: array of Logs.Entry,
        const Clear: TMsg,
        const Settings: Logs.Options
      ):
        return Log.Lower<TMsg>(Id, Entries, Clear, Settings, ParentHorizontal);
      when Ui.Element.CommandPalette(
        const Id: string,
        const Base: Ui.Element<TMsg>,
        const Open: bool,
        const Commands: array of Palettes.Command<TMsg>,
        const Change: function(bool): TMsg,
        const Shortcut: bool
      ):
        return E.Element<TMsg>.Palette(
          Id,
          Visit(Base, Colors, ParentHorizontal),
          Open,
          Commands,
          Change,
          Shortcut
        );
      when Ui.Element.TreeNode(_, _, _, _, _, _, _):
        return TreeRows.Lower<TMsg>(Node);
      when Ui.Element.ProgressBar(_, const Fraction: float, const Settings: ProgressBars.Options):
        return Progress.Lower<TMsg>(Fraction, Settings, Theme);
      when Ui.Element.Spinner(_, _, const Settings: Spinners.Options?):
        return Spinner.Lower<TMsg>(Settings, Theme);
      when Ui.Element.Sparkline(
        _,
        const Values: array of float,
        const Settings: Sparklines.Options
      ):
        return Sparkline.Lower<TMsg>(Values, Settings, Theme);
      when Ui.Element.Alert(
        const Id: string,
        const Title: string,
        const Settings: Alerts.Options,
        const Notify: Sys.Func<TMsg>?
      ):
        if AlertsState.Hidden(Id) then
          return E.Element<TMsg>.Stack([], false, new E.Flow());
        end if;

        return Alert.Lower<TMsg>(Id, Title, Settings, Notify, AlertsState, Colors, Theme);
      when Ui.Element.StatusBar(
        const Id: string,
        const Items: array of StatusBars.Item<TMsg>,
        const HideBorder: bool
      ):
        return StatusLine.Lower<TMsg>(Id, Items, HideBorder, Theme);
      when Ui.Element.ButtonAction(
        const Id: string,
        const Text: string,
        const Message: TMsg,
        const Settings: B.Options
      ):
        return Button.Lower<TMsg>(Id, Text, Message, Settings);
      when Ui.Element.ExpandableCard(
        const Id: string, const Title: string, const Open: bool, const Change: function(bool): TMsg,
        const Content: Ui.Element<TMsg>, const Settings: Cards.Options
      ):
        const Surface: T.Style := Th.Role(Theme, UiStyle.Role.Panel, Colors);
        return Card.Lower<TMsg>(
          Id, Title, Open, Change, Settings, Surface,
          function(): E.Element<TMsg> => Visit(Content, Surface)
        );
      when Ui.Element.Dropdown(
        const Id: string,
        const Label: string,
        const Entries: array of Menus.Entry<TMsg>,
        const Settings: Menus.Options
      ):
        return Dropdown.Lower<TMsg>(
          new Dropdown.Trigger<TMsg>(Id, Label, Entries, Settings, Popup)
        );
      when Ui.Element.SelectInput(
        const Id: string,
        const Items: array of Selects.Item,
        const Selected: int,
        const Change: function(int): TMsg,
        const Settings: Selects.Options
      ):
        return Select.Lower<TMsg>(
          new Select.Trigger<TMsg>(Id, Items, Selected, Change, Settings, Popup)
        );
      when Ui.Element.MultiSelectInput(
        const Id: string, const Items: array of Selects.Item, const Selected: array of bool,
        const Change: function(array of bool): TMsg, const Settings: Multi.Options
      ):
        return MultiSelect.Lower<TMsg>(
          new MultiSelect.Trigger<TMsg>(Id, Items, Selected, Change, Settings, Popup)
        );
      when Ui.Element.TabStrip(
        const Id: string, const Items: array of TabSettings.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: TabSettings.Options
      ):
        return Tabs.Lower<TMsg>(Id, Items, Selected, Change, Settings);
      when Ui.Element.Segments(
        const Id: string, const Items: array of Segmented.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: Segmented.Options
      ):
        return Segments.Lower<TMsg>(Id, Items, Selected, Change, Settings);
      when Ui.Element.PaginationAction(
        const Id: string, const Page: int, const Count: int,
        const Change: function(int): TMsg, const Enabled: bool
      ):
        return E.Element<TMsg>.Pager(new E.PagerView<TMsg>(Id, Page, Count, Change, Enabled));
      when Ui.Element.BreadcrumbTrail(
        const Id: string, const Items: array of string,
        const Navigate: function(int): TMsg, const Enabled: bool
      ):
        return Breadcrumb.Lower<TMsg>(Id, Items, Navigate, Enabled);
      when Ui.Element.Radios(
        const Id: string,
        const Items: array of R.Item,
        const Selected: int,
        const Change: function(int): TMsg,
        const Enabled: bool,
        const Gap: L.Spacing
      ):
        return Radios.Lower<TMsg>(
          Id,
          Items,
          Selected,
          Change,
          Enabled,
          Geometry.Spacing(Gap, false)
        );
      when Ui.Element.CheckboxAction(
        const Id: string,
        const Label: string,
        const Checked: bool,
        const Change: function(bool): TMsg,
        const Description: string,
        const Enabled: bool,
        const Indeterminate: bool,
        const HideLabel: bool
      ):
        return Toggles.Checkbox<TMsg>(
          Id,
          Label,
          Checked,
          Change,
          Description,
          Enabled,
          Indeterminate,
          HideLabel
        );
      when Ui.Element.SwitchAction(
        const Id: string,
        const Label: string,
        const On: bool,
        const Change: function(bool): TMsg,
        const Description: string,
        const Enabled: bool
      ):
        return Toggles.Switch<TMsg>(Id, Label, On, Change, Description, Enabled);
      when Ui.Element.TextArea(
        const Id: string, const Value: string, const Change: function(string): TMsg,
        const Settings: Areas.Options, const Submit: Sys.Func<string, TMsg>?
      ):
        const Rows: int := Geometry.Cells(
          L.Measure.Logical(
            if Settings.Height > 0 then
              Settings.Height
            else
              96
            end if
          ), false
        );
        return AreaWidget.Lower<TMsg>(
          new AreaEdit.Field<TMsg>(Id, Value, Change, Settings, Submit, Rows),
          Colors,
          Theme
        );
      when Ui.Element.TextField(
        const Id: string, const Value: string, const Change: function(string): TMsg,
        const Settings: Fields.Options, const Submit: Sys.Func<string, TMsg>?
      ):
        const Send: function(string): Actions.Result<TMsg> := function(NewText: string): Actions.Result<TMsg> => Actions.Result<TMsg>.Send(
          Change(NewText)
        );
        const SubmitAction: Sys.Func<string, Actions.Result<TMsg>>? := case Submit of
          when is Sys.Func<string, TMsg> as Callback: function(Text: string): Actions.Result<TMsg> => Actions.Result<TMsg>.Send(
            Callback.Invoke(Text)
          );
          else null;
        end case;
        const Field: Edit.Field<TMsg> := new Edit.Field<TMsg>(
          Id,
          Value,
          Send,
          Settings,
          SubmitAction
        );
        return FieldWidget.WithLabels<TMsg>(
          E.Element<TMsg>.TextField(Field),
          Settings.Label,
          Settings.Hint,
          Settings.Error,
          Colors,
          Theme
        );
      when Ui.Element.SearchField(
        const Id: string, const Value: string, const Change: function(string): TMsg,
        const Settings: SearchFields.Options, const Submit: Sys.Func<string, TMsg>?
      ):
        return Search.Lower<TMsg>(Id, Value, Change, Settings, Submit, Colors, Theme);
      when Ui.Element.NumberField(
        const Id: string, const Value: double, const Minimum: double, const Maximum: double,
        const Change: function(double): TMsg, const Settings: NumberFields.Options
      ):
        return Number.Lower<TMsg>(
          Id,
          Value,
          Minimum,
          Maximum,
          Change,
          Settings,
          Numbers,
          Colors,
          Theme
        );
      when Ui.Element.Table(
        const Id: string, const Columns: array of Tables.Column,
        const Rows: array of Tables.Row<TMsg>, const Order: Tables.Sort?,
        const OnSort: Sys.Func<Tables.Sort, TMsg>?, const OnSelect: Sys.Func<string, TMsg>?,
        const Settings: Tables.Options
      ):
        return E.Element<TMsg>.Table(
          new E.TableView<TMsg>(
            Id,
            Columns,
            Rows,
            Order,
            OnSort,
            OnSelect,
            Settings,
            TableWidget.MeasureColumns<TMsg>(Columns, Rows, Order)
          )
        );
      when Ui.Element.Sidebar(
        const Id: string,
        const Sections: array of N.Section<TMsg>,
        const Active: string?,
        const Enabled: bool
      ):
        return Sidebar.Lower<TMsg>(Id, Sections, Active, Enabled);
      when Ui.Element.Stack(
        const Items: array of Ui.Element<TMsg>,
        const Horizontal: bool,
        const Flow: L.Flow
      ):
        return E.Element<TMsg>.Stack(
          Children(Items, Colors, Horizontal),
          Horizontal,
          new E.Flow(
            Geometry.Spacing(Flow.Gap, Horizontal),
            Geometry.Spacing(Flow.Padding, true),
            Geometry.Spacing(Flow.Padding, false),
            Flow.Align
          )
        );
      when Ui.Element.Sized(const Child: Ui.Element<TMsg>, const Rule: L.Flex):
        return E.Element<TMsg>.Sized(
          Visit(Child, Colors, ParentHorizontal),
          Geometry.Flex(Rule, ParentHorizontal)
        );
      when Ui.Element.Styled(const Child: Ui.Element<TMsg>, const Value: UiStyle.Role):
        const Next: T.Style := Th.Merge(Colors, Th.Role(Theme, Value, Colors));
        return E.Element<TMsg>.Decorated(Visit(Child, Next, ParentHorizontal), Next);
      when Ui.Element.TerminalStyle(const Child: Ui.Element<TMsg>, const Value: T.Style):
        const Next: T.Style := Th.Merge(Colors, Value);
        return E.Element<TMsg>.Decorated(Visit(Child, Next, ParentHorizontal), Next);
      when Ui.Element.Framed(const Child: Ui.Element<TMsg>, const Title: string):
        return E.Element<TMsg>.Framed(Visit(Child, Colors), Title);
      when Ui.Element.Scroll(
        const Id: string,
        const Child: Ui.Element<TMsg>,
        const Position: L.ScrollPosition?,
        const Scroll: Sys.Func<L.ScrollChange, TMsg>?,
        const Bar: bool,
        _,
        _
      ):
        case Scroll of
          when is Sys.Func<L.ScrollChange, TMsg> as Callback:
            var Native: E.ScrollPosition := E.ScrollPosition.Offset(0);
            case Position of
              when L.ScrollPosition.End:
                Native := E.ScrollPosition.End;
              when L.ScrollPosition.Offset(const Distance: L.Measure):
                Native := E.ScrollPosition.Offset(Geometry.Cells(Distance, false));
              else
            end case;

            return E.Element<TMsg>.ControlledScroll(
              Id,
              Visit(Child, Colors),
              Native,
              Callback,
              Bar
            );
          else
            return E.Element<TMsg>.Scrollable(Id, Visit(Child, Colors), Bar);
        end case;
      when Ui.Element.Sheet(
        const Id: string, const Base: Ui.Element<TMsg>, const Content: Ui.Element<TMsg>,
        const Open: bool, const Settings: Sheets.Options, const Dismiss: TMsg
      ):
        return Panel.Lower<TMsg>(
          Id, Visit(Base, Colors, ParentHorizontal), Open,
          new E.ModalOptions(
            Settings.Title,
            Settings.Description,
            Settings.Size,
            Settings.Edge,
            Settings.InitialFocus,
            Sheets.CloseId(Id)
          ),
          function(): TMsg => Dismiss, Colors, Theme,
          function(PanelStyle: T.Style): E.Element<TMsg> => Visit(Content, PanelStyle)
        );
      when Ui.Element.Dialog(
        const Id: string, const Base: Ui.Element<TMsg>, const Content: Ui.Element<TMsg>,
        const Open: bool, const Settings: Dialogs.Options, const Dismiss: TMsg
      ):
        return Panel.Lower<TMsg>(
          Id, Visit(Base, Colors, ParentHorizontal), Open,
          new E.ModalOptions(
            Settings.Title, Settings.Description, Settings.Width, null, Settings.InitialFocus,
            if Settings.CloseButton then
              Dialogs.CloseId(Id)
            else
              null
            end if, not Settings.Persistent
          ),
          function(): TMsg => Dismiss, Colors, Theme,
          function(PanelStyle: T.Style): E.Element<TMsg> => Visit(Content, PanelStyle)
        );
      when Ui.Element.FilePicker(
        const Id: string, const Base: Ui.Element<TMsg>?, const Open: bool,
        const Change: function(Files.Event): TMsg, const Settings: Files.Options
      ):
        const Underneath: E.Element<TMsg> := if Base = null then
          E.Element<TMsg>.Stack([], false, new E.Flow())
        else
          Visit(Base, Colors, ParentHorizontal)
        end if;
        return if Open then
          FilePicker.Lower<TMsg>(Id, Underneath, Change, Settings, Pickers, Size, Colors, Theme)
        else
          Underneath
        end if;
      when Ui.Element.Deferred(const Id: string, _):
        return Visit(Prepared.Subviews[Id].Tree, Colors, ParentHorizontal);
      when Ui.Element.TerminalViewport(const Id: string, _):
        return Visit(Prepared.Subviews[Id].Tree, Colors, ParentHorizontal);
      when Ui.Element.TerminalScreen(
        const Content: Ui.Element<TMsg>,
        const Layers: array of Ui.Element<TMsg>,
        const Shortcuts: array of K.ShortcutBinding<TMsg>
      ):
        return E.Element<TMsg>.Desktop(Visit(Content, Colors), Children(Layers, Colors), Shortcuts);
      else
        raise new Sys.NotSupportedException('This widget requires the graphical profile.');
    end case;
  end function;
begin
  const Result: E.Element<TMsg> := Visit(Prepared.Tree, Theme.Text);
  Pickers.Finish();
  AlertsState.Finish();
  return Result;
end function;

end unit;
