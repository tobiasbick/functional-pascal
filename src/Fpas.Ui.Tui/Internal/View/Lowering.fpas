unit Fpas.Ui.Tui.Internal.View.Lowering;

uses Fpas.Ui.Buttons as B, Fpas.Ui.Tui.Internal.Widgets.CopyButton as CopyWidget, Fpas.Ui.Tui.Internal.Widgets.ButtonGroup as Group, Fpas.Ui.Tui.Internal.Widgets.Button as Button, Fpas.Ui.Elements as Ui, Fpas.Ui.Layout as L, Fpas.Ui.Choices as Ch, Fpas.Ui.Navigation as N, Fpas.Ui.Sheets as Sheets, Fpas.Ui.IconButtons as Icons, Fpas.Ui.Tui.Internal.Widgets.IconButton as IconButton, Fpas.Ui.Styles as UiStyle, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Validation as V, Fpas.Ui.Editors as Ed, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Widgets.Sidebar as Sidebar, Fpas.Ui.Tui.Internal.Widgets.Sheet as Sheet, Fpas.Ui.Tui.Internal.Layout.Flexible as Geometry, Fpas.Ui.Tui.Internal.View.EditorState as Editors, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, System as Sys, System.Collections.Generic as C;

// Converts shared flex rules into resolved cell constraints.
//
// ## Parameters
// - `Value`: Validated shared rule.
// - `Horizontal`: Parent main axis.
//
// ## Returns
// Cell allocation constraints.
public function Flex(Value: L.Flex; Horizontal: bool := true): E.Flex;
begin
  var Basis: int := -1;
  var Grow: int := Value.Grow;
  case Value.Basis of
    when L.Extent.Fixed(const Distance: L.Measure):
      Basis := Geometry.Cells(Distance, Horizontal);
    when L.Extent.Fill:
      Grow := Sys.Math.Max(1, Grow);
    else
  end case;
  const Minimum: L.Measure? := Value.Minimum;
  const Maximum: L.Measure? := Value.Maximum;
  return new E.Flex(
    Basis, if Minimum = null then 0 else Geometry.Cells(Minimum, Horizontal) end if,
    if Maximum = null then int.MaxValue else Geometry.Cells(Maximum, Horizontal) end if, Grow
  );
end function;

function Spacing(Value: L.Spacing; Horizontal: bool): int;
begin
  case Value of
    when L.Spacing.None:
      return 0;
    when L.Spacing.Tight:
      return 1;
    when L.Spacing.Normal:
      return 1;
    when L.Spacing.Loose:
      return if Horizontal then 2 else 1 end if;
    when L.Spacing.Fixed(const Distance: L.Measure):
      return Geometry.Cells(Distance, Horizontal);
  end case;
end function;

function Role(Theme: Th.Theme; Value: UiStyle.Role; Inherited: T.Style): T.Style;
begin
  const Backdrop: int := Inherited.Background ?? Theme.Text.Background ?? 0;
  if Value = UiStyle.Role.Default then
    return new T.Style();
  end if;

  if Value = UiStyle.Role.Panel then
    const Surface: int := Th.Rgb(Theme.Colors.Surface, Backdrop);
    return new T.Style(Th.Rgb(Theme.Colors.Foreground, Surface), Surface);
  end if;

  return new T.Style(
    Foreground := Th.Rgb(
      case Value of
        when UiStyle.Role.Muted: Theme.Colors.TextMuted;
        when UiStyle.Role.Primary: Theme.Colors.Accent;
        when UiStyle.Role.Secondary: Theme.Colors.TextSecondary;
        when UiStyle.Role.Error: Theme.Colors.Danger;
        else Theme.Colors.Foreground;
      end case, Backdrop
    )
  );
end function;

function Merge(Parent: T.Style; Child: T.Style): T.Style;
begin
  return new T.Style(
    if Child.Foreground = null then Parent.Foreground else Child.Foreground end if,
    if Child.Background = null then Parent.Background else Child.Background end if
  );
end function;

// Lowers a validated shared tree into terminal measurement and painting data.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Prepared`: Terminal-profile preflight result.
// - `Theme`: Current terminal theme.
// - `Storage`: Host-owned editor viewport state.
// - `Clipboard`: Host-owned copy feedback and clipboard operations.
//
// ## Returns
// The resolved backend tree, with no application-facing constructors.
public function Prepare<TMsg>(
  Prepared: V.Prepared<TMsg>; Theme: Th.Theme; Storage: C.Dictionary<string, Editors.Entry>; Clipboard: CopyWidget.State
): E.Element<TMsg>;
  function Children(Items: array of Ui.Element<TMsg>; Colors: T.Style; Horizontal: bool := false): array of E.Element<TMsg>;
  begin
    const Values: C.List<E.Element<TMsg>> := new C.List<E.Element<TMsg>>();
    for Item: Ui.Element<TMsg> in Items do
      Values.Add(Visit(Item, Colors, Horizontal));
    end for;

    return Values.ToArray();
  end function;
  function Visit(Node: Ui.Element<TMsg>; Colors: T.Style; ParentHorizontal: bool := false): E.Element<TMsg>;
  begin
    case Node of
      when Ui.Element.Label(const Text: string):
        return E.Element<TMsg>.Label(Text);
      when Ui.Element.Separator(const Title: string):
        return E.Element<TMsg>.Separator(Title);
      when Ui.Element.Action(
        const Id: string,
        const Text: string,
        const Message: TMsg,
        const Enabled: bool,
        const Variant: UiStyle.ButtonVariant
      ):
        return Button.Lower<TMsg>(
          Id,
          Text,
          Message,
          new B.Options(Variant := Variant, Enabled := Enabled)
        );
      when Ui.Element.ButtonAction(
        const Id: string,
        const Text: string,
        const Message: TMsg,
        const Settings: B.Options
      ):
        return Button.Lower<TMsg>(Id, Text, Message, Settings);
      when Ui.Element.Toggle(
        const Id: string,
        const Text: string,
        const Checked: bool,
        const Change: function(bool): TMsg,
        const Enabled: bool
      ):
        return E.Element<TMsg>.Toggle(Id, Text, Checked, Change, Enabled);
      when Ui.Element.Editor(
        const Id: string,
        const Text: string,
        const Position: Ed.EditorPosition,
        const Edit: function(Ed.TextEdit): TMsg,
        const Navigate: function(Ed.EditorPosition): TMsg,
        const Placeholder: string,
        const Enabled: bool,
        const MultipleLines: bool
      ):
        discard Seen.Add(Id);
        return E.Element<TMsg>.DocumentEditor(
          Id,
          Text,
          Editors.Resolve(Storage, Id, Text, Position),
          new Editors.Events<TMsg>(Id, Text, Position, Edit, Navigate, Storage),
          Placeholder,
          Enabled,
          MultipleLines
        );
      when Ui.Element.IconAction(
        const Id: string,
        _,
        const Tooltip: string,
        const Message: TMsg,
        const Settings: Icons.Options
      ):
        return IconButton.Lower<TMsg>(Id, Tooltip, Message, Settings);
      when Ui.Element.CopyAction(
        const Id: string,
        const Text: string,
        const OnCopied: Sys.Func<TMsg>?,
        const Enabled: bool
      ):
        return CopyWidget.Lower<TMsg>(Id, Text, OnCopied, Enabled, Clipboard, Theme.Colors.Success);
      when Ui.Element.ActionList(
        const Id: string,
        const Items: array of Ch.ListItem<TMsg>,
        const Enabled: bool
      ):
        const Copy: C.List<Ch.ListItem<TMsg>> := new C.List<Ch.ListItem<TMsg>>();
        for Item: Ch.ListItem<TMsg> in Items do
          Copy.Add(
            Item with
              Enabled := Enabled and Item.Enabled;
            end with
          );
        end for;

        return E.Element<TMsg>.Choices(Id, Copy.ToArray());
      when Ui.Element.Sidebar(
        const Id: string,
        const Sections: array of N.Section<TMsg>,
        const Active: string?,
        const Enabled: bool
      ):
        return Sidebar.Lower<TMsg>(Id, Sections, Active, Enabled);
      when Ui.Element.Selectable(
        const Id: string,
        const Items: array of Ch.SelectionItem,
        const Selected: string?,
        const Select: function(string): TMsg,
        const Activate: Sys.Func<string, TMsg>?,
        const Enabled: bool
      ):
        const Copy: C.List<Ch.SelectionItem> := new C.List<Ch.SelectionItem>();
        for Item: Ch.SelectionItem in Items do
          Copy.Add(
            Item with
              Enabled := Enabled and Item.Enabled;
            end with
          );
        end for;

        return E.Element<TMsg>.Selectable(
          Id,
          Copy.ToArray(),
          if Selected = null then '' else Selected end if,
          Select,
          Activate
        );
      when Ui.Element.TabSet(
        const Id: string,
        const Items: array of Ch.TabItem,
        const Selected: string?,
        const Select: function(string): TMsg,
        const Panel: Ui.Element<TMsg>?,
        const Enabled: bool
      ):
        var Active: int := -1;
        const Copy: C.List<Ch.TabItem> := new C.List<Ch.TabItem>();
        for I: int := 0 to Items.Length - 1 do
          Copy.Add(
            Items[I] with
              Enabled := Enabled and Items[I].Enabled;
            end with
          );
          if Items[I].Key = Selected then
            Active := I;
          end if;
        end for;

        return E.Element<TMsg>.TabSet(
          Id,
          Copy.ToArray(),
          Active,
          Select,
          if Panel = null then null else Visit(Panel, Colors) end if
        );
      when Ui.Element.TableView(
        const Id: string,
        const Columns: array of Ch.TableColumn,
        const Rows: array of Ch.TableRow,
        const Selected: string?,
        const Select: function(string): TMsg,
        const Activate: Sys.Func<string, TMsg>?,
        const Enabled: bool
      ):
        const Resolved: C.List<E.TableColumn> := new C.List<E.TableColumn>();
        for Column: Ch.TableColumn in Columns do
          Resolved.Add(new E.TableColumn(Column.Header, Flex(Column.Sizing)));
        end for;
        const Copy: C.List<Ch.TableRow> := new C.List<Ch.TableRow>();
        for Row: Ch.TableRow in Rows do
          Copy.Add(
            Row with
              Enabled := Enabled and Row.Enabled;
            end with
          );
        end for;

        return E.Element<TMsg>.TableView(
          Id,
          Resolved.ToArray(),
          Copy.ToArray(),
          if Selected = null then '' else Selected end if,
          Select,
          Activate
        );
      when Ui.Element.Progress(const Percent: int):
        return E.Element<TMsg>.Gauge(Percent);
      when Ui.Element.ButtonGroup(const Items: array of Ui.Element<TMsg>):
        return Group.Lower<TMsg>(Children(Items, Colors, true), Theme, Colors);
      when Ui.Element.Stack(
        const Items: array of Ui.Element<TMsg>,
        const Horizontal: bool,
        const Flow: L.Flow
      ):
        return E.Element<TMsg>.Stack(
          Children(Items, Colors, Horizontal),
          Horizontal,
          new E.Flow(
            Spacing(Flow.Gap, Horizontal),
            Spacing(Flow.Padding, true),
            Spacing(Flow.Padding, false),
            Flow.Align
          )
        );
      when Ui.Element.Sized(const Child: Ui.Element<TMsg>, const Rule: L.Flex):
        return E.Element<TMsg>.Sized(
          Visit(Child, Colors, ParentHorizontal),
          Flex(Rule, ParentHorizontal)
        );
      when Ui.Element.Styled(const Child: Ui.Element<TMsg>, const Value: UiStyle.Role):
        const Next: T.Style := Merge(Colors, Role(Theme, Value, Colors));
        return E.Element<TMsg>.Decorated(Visit(Child, Next, ParentHorizontal), Next);
      when Ui.Element.TerminalStyle(const Child: Ui.Element<TMsg>, const Value: T.Style):
        const Next: T.Style := Merge(Colors, Value);
        return E.Element<TMsg>.Decorated(Visit(Child, Next, ParentHorizontal), Next);
      when Ui.Element.Framed(const Child: Ui.Element<TMsg>, const Title: string):
        return E.Element<TMsg>.Framed(Visit(Child, Colors), Title);
      when Ui.Element.Scroll(
        const Id: string,
        const Child: Ui.Element<TMsg>,
        const Position: L.ScrollPosition?,
        const Scroll: Sys.Func<L.ScrollChange, TMsg>?,
        const Bar: bool
      ):
        case Scroll of
          when is Sys.Func<L.ScrollChange, TMsg> as Callback:
            var Native: E.ScrollPosition := E.ScrollPosition.Offset(0);
            case Position of
              when L.ScrollPosition.End:
                Native := E.ScrollPosition.End;
              when L.ScrollPosition.Offset(const Distance: L.Measure):
                Native := E.ScrollPosition.Offset(Geometry.Cells(Distance, false));
              else
            end case;

            return E.Element<TMsg>.ControlledScroll(
              Id,
              Visit(Child, Colors),
              Native,
              Callback,
              Bar
            );
          else
            return E.Element<TMsg>.Scrollable(Id, Visit(Child, Colors), Bar);
        end case;
      when Ui.Element.Modal(
        const Id: string,
        const Base: Ui.Element<TMsg>,
        const Content: Ui.Element<TMsg>,
        const Initial: string?,
        const Dismiss: Sys.Func<TMsg>?
      ):
        return E.Element<TMsg>.Desktop(
          Visit(Base, Colors, ParentHorizontal),
          [
            E.Element<TMsg>.Layer(
              Id,
              true,
              if Initial = null then '' else Initial end if,
              Dismiss,
              Visit(Content, Colors),
              [],
              null
            )
          ],
          []
        );
      when Ui.Element.Sheet(
        const Id: string, const Base: Ui.Element<TMsg>, const Content: Ui.Element<TMsg>,
        const Open: bool, const Settings: Sheets.Options, const Dismiss: TMsg
      ):
        return Sheet.Lower<TMsg>(
          Id, Visit(Base, Colors, ParentHorizontal), Open, Settings, Dismiss, Colors, Theme,
          function(Panel: T.Style): E.Element<TMsg> => Visit(Content, Panel)
        );
      when Ui.Element.Deferred(const Id: string, _):
        return Visit(Prepared.Subviews[Id].Tree, Colors, ParentHorizontal);
      when Ui.Element.TerminalViewport(const Id: string, _):
        return Visit(Prepared.Subviews[Id].Tree, Colors, ParentHorizontal);
      when Ui.Element.TerminalCanvas(
        const Id: string,
        const Draw: function(int, int): T.Cell,
        const Events: T.CanvasEvents<TMsg>
      ):
        return E.Element<TMsg>.Custom(1, 1, Draw, E.CanvasBinding<TMsg>.Responsive(Id, Events));
      when Ui.Element.TerminalFixedCanvas(
        const Id: string,
        const Width: int,
        const Height: int,
        const Draw: function(int, int): T.Cell,
        const Events: T.CanvasEvents<TMsg>
      ):
        return E.Element<TMsg>.Custom(Width, Height, Draw, E.CanvasBinding<TMsg>.Fixed(Id, Events));
      when Ui.Element.TerminalStatus(const Text: string, const Hints: array of string):
        return E.Element<TMsg>.StatusLine(Text, Hints);
      when Ui.Element.TerminalScreen(
        const Content: Ui.Element<TMsg>,
        const Layers: array of Ui.Element<TMsg>,
        const Shortcuts: array of K.ShortcutBinding<TMsg>
      ):
        return E.Element<TMsg>.Desktop(Visit(Content, Colors), Children(Layers, Colors), Shortcuts);
      when Ui.Element.TerminalLayer(
        const Id: string,
        const Content: Ui.Element<TMsg>,
        const Initial: string?,
        const Dismiss: Sys.Func<TMsg>?,
        const Shortcuts: array of K.ShortcutBinding<TMsg>,
        const Limits: K.OverlayLimits?,
        const Modal: bool
      ):
        return E.Element<TMsg>.Layer(
          Id,
          Modal,
          if Initial = null then '' else Initial end if,
          Dismiss,
          Visit(Content, Colors),
          Shortcuts,
          Limits
        );
      when Ui.Element.TerminalPanel(
        const Body: Ui.Element<TMsg>,
        const Footer: Ui.Element<TMsg>,
        const Title: string,
        const Padding: byte
      ):
        return E.Element<TMsg>.Panel(Visit(Body, Colors), Visit(Footer, Colors), Title, Padding);
      else
        raise new Sys.InvalidOperationException('A graphical extension reached terminal lowering.');
    end case;
  end function;
begin
  const Seen: C.HashSet<string> := new C.HashSet<string>();
  const Result: E.Element<TMsg> := Visit(Prepared.Tree, Theme.Text);
  for Id: string in new C.List<string>(Storage.Keys) do
    if not Seen.Contains(Id) then
      discard Storage.Remove(Id);
    end if;
  end for;

  return Result;
end function;
end unit;
