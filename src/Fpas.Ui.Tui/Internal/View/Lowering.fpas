unit Fpas.Ui.Tui.Internal.View.Lowering;

uses Fpas.Ui.Menus as M, Fpas.Ui.Tui.Internal.Widgets.Menu as Popup, Fpas.Ui.Tui.Internal.Widgets.DropdownMenu as DropdownMenu, Fpas.Ui.SegmentedControls as Segmented, Fpas.Ui.Tui.Internal.Widgets.SegmentedControl as SegmentedWidget, Fpas.Ui.Tui.Internal.Widgets.ThemeToggle as ThemeToggle, Fpas.Ui.Themes as Themes, Fpas.Ui.ThemeSwitchers as ThemeSwitchers, Fpas.Ui.Tui.Internal.Widgets.ThemeSwitcher as ThemeSwitcher, Fpas.Ui.StatusButtons as Status, Fpas.Ui.Tui.Internal.Widgets.StatusButton as StatusWidget, Fpas.Ui.ConfirmButtons as Confirms, Fpas.Ui.Tui.Internal.Widgets.ConfirmButton as ConfirmWidget, Fpas.Ui.SplitButtons as Split, Fpas.Ui.Tui.Internal.Widgets.SplitButton as SplitWidget, Fpas.Ui.HoldButtons as Holds, Fpas.Ui.Tui.Internal.Widgets.HoldButton as HoldWidget, Fpas.Ui.Buttons as B, Fpas.Ui.Tui.Internal.Widgets.CopyButton as CopyWidget, Fpas.Ui.Tui.Internal.Widgets.ButtonGroup as Group, Fpas.Ui.Tui.Internal.Widgets.Button as Button, Fpas.Ui.Elements as Ui, Fpas.Ui.Layout as L, Fpas.Ui.Navigation as N, Fpas.Ui.Sheets as Sheets, Fpas.Ui.IconButtons as Icons, Fpas.Ui.Tui.Internal.Widgets.IconButton as IconButton, Fpas.Ui.Styles as UiStyle, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Validation as V, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Widgets.Sidebar as Sidebar, Fpas.Ui.Tui.Internal.Widgets.Sheet as Sheet, Fpas.Ui.Tui.Internal.Layout.Flexible as Geometry, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, System as Sys, System.Collections.Generic as C;

// Converts shared flex rules into resolved cell constraints.
//
// ## Parameters
// - `Value`: Validated shared rule.
// - `Horizontal`: Parent main axis.
//
// ## Returns
// Cell allocation constraints.
public function Flex(Value: L.Flex; Horizontal: bool := true): E.Flex;
begin
  var Basis: int := -1;
  var Grow: int := Value.Grow;
  case Value.Basis of
    when L.Extent.Fixed(const Distance: L.Measure):
      Basis := Geometry.Cells(Distance, Horizontal);
    when L.Extent.Fill:
      Grow := Sys.Math.Max(1, Grow);
    else
  end case;
  const Minimum: L.Measure? := Value.Minimum;
  const Maximum: L.Measure? := Value.Maximum;
  return new E.Flex(
    Basis, if Minimum = null then 0 else Geometry.Cells(Minimum, Horizontal) end if,
    if Maximum = null then int.MaxValue else Geometry.Cells(Maximum, Horizontal) end if, Grow
  );
end function;

function Spacing(Value: L.Spacing; Horizontal: bool): int;
begin
  case Value of
    when L.Spacing.None:
      return 0;
    when L.Spacing.Tight:
      return 1;
    when L.Spacing.Normal:
      return 1;
    when L.Spacing.Loose:
      return if Horizontal then 2 else 1 end if;
    when L.Spacing.Fixed(const Distance: L.Measure):
      return Geometry.Cells(Distance, Horizontal);
  end case;
end function;

function Role(Theme: Th.Theme; Value: UiStyle.Role; Inherited: T.Style): T.Style;
begin
  const Backdrop: int := Inherited.Background ?? Theme.Text.Background ?? 0;
  if Value = UiStyle.Role.Default then
    return new T.Style();
  end if;

  if Value = UiStyle.Role.Panel or Value = UiStyle.Role.OutlinedPanel
    or Value = UiStyle.Role.MutedPanel or Value = UiStyle.Role.Divider
  then
    const Surface: int := Th.Rgb(
      case Value of
        when UiStyle.Role.MutedPanel: Theme.Colors.SurfaceMuted;
        when UiStyle.Role.Divider: Theme.Colors.Border;
        else Theme.Colors.Surface;
      end case, Backdrop
    );
    return new T.Style(Th.Rgb(Theme.Colors.Foreground, Surface), Surface);
  end if;

  return new T.Style(
    Foreground := Th.Rgb(
      case Value of
        when UiStyle.Role.Muted: Theme.Colors.TextMuted;
        when UiStyle.Role.Primary: Theme.Colors.Accent;
        when UiStyle.Role.Secondary: Theme.Colors.TextSecondary;
        when UiStyle.Role.Error: Theme.Colors.Danger;
        else Theme.Colors.Foreground;
      end case, Backdrop
    )
  );
end function;

function Merge(Parent: T.Style; Child: T.Style): T.Style;
begin
  return new T.Style(
    if Child.Foreground = null then Parent.Foreground else Child.Foreground end if,
    if Child.Background = null then Parent.Background else Child.Background end if
  );
end function;

// Lowers a validated shared tree into terminal measurement and painting data.
//
// ## Type parameters
// - `TMsg`: Application message type.
//
// ## Parameters
// - `Prepared`: Terminal-profile preflight result.
// - `Theme`: Current terminal theme.
// - `Clipboard`: Host-owned copy feedback and clipboard operations.
// - `HoldTracking`: Owner session's active pointer hold.
// - `Menus`: Owner session's command-menu popup state.
// - `Confirmations`: Owner session's confirmation windows.
//
// ## Returns
// The resolved backend tree, with no application-facing constructors.
public function Prepare<TMsg>(
  Prepared: V.Prepared<TMsg>; Theme: Th.Theme;
  Clipboard: CopyWidget.State; HoldTracking: HoldWidget.State; Menus: Popup.State;
  Confirmations: ConfirmWidget.State
): E.Element<TMsg>;
  function Children(Items: array of Ui.Element<TMsg>; Colors: T.Style; Horizontal: bool := false): array of E.Element<TMsg>;
  begin
    const Values: C.List<E.Element<TMsg>> := new C.List<E.Element<TMsg>>();
    for Item: Ui.Element<TMsg> in Items do
      Values.Add(Visit(Item, Colors, Horizontal));
    end for;

    return Values.ToArray();
  end function;
  function Visit(Node: Ui.Element<TMsg>; Colors: T.Style; ParentHorizontal: bool := false): E.Element<TMsg>;
  begin
    case Node of
      when Ui.Element.Label(const Text: string):
        return E.Element<TMsg>.Label(Text);
      when Ui.Element.Separator(const Title: string):
        return E.Element<TMsg>.Separator(Title);
      when Ui.Element.ButtonAction(
        const Id: string,
        const Text: string,
        const Message: TMsg,
        const Settings: B.Options
      ):
        return Button.Lower<TMsg>(Id, Text, Message, Settings);
      when Ui.Element.IconAction(
        const Id: string,
        _,
        const Tooltip: string,
        const Message: TMsg,
        const Settings: Icons.Options
      ):
        return IconButton.Lower<TMsg>(Id, Tooltip, Message, Settings);
      when Ui.Element.CopyAction(
        const Id: string,
        const Text: string,
        const OnCopied: Sys.Func<TMsg>?,
        const Enabled: bool
      ):
        return CopyWidget.Lower<TMsg>(Id, Text, OnCopied, Enabled, Clipboard, Theme.Colors.Success);
      when Ui.Element.HoldAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Holds.Options
      ):
        return HoldWidget.Lower<TMsg>(Id, Label, Message, Settings, HoldTracking);
      when Ui.Element.ConfirmAction(
        const Id: string,
        const Label: string,
        const Message: TMsg,
        const Settings: Confirms.Options
      ):
        return ConfirmWidget.Lower<TMsg>(Id, Label, Message, Settings, Confirmations);
      when Ui.Element.StatusAction(
        const Id: string,
        const Label: string,
        const State: Status.Status,
        const Message: TMsg,
        const Settings: Status.Options
      ):
        return StatusWidget.Lower<TMsg>(Id, Label, State, Message, Settings, Theme);
      when Ui.Element.ThemeFlip(
        const Id: string, const Appearance: Themes.Mode,
        const Change: function(Themes.Mode): TMsg, const Enabled: bool
      ):
        return ThemeToggle.Lower<TMsg>(Id, Appearance, Change, Enabled);
      when Ui.Element.Segments(
        const Id: string, const Items: array of Segmented.Item, const Selected: int,
        const Change: function(int): TMsg, const Settings: Segmented.Options
      ):
        return SegmentedWidget.Lower<TMsg>(
          Id,
          Items,
          Selected,
          Change,
          Settings,
          Theme,
          Colors,
          []
        );
      when Ui.Element.ThemeChoice(
        const Id: string,
        const Selected: ThemeSwitchers.Selection,
        const Change: function(ThemeSwitchers.Selection): TMsg,
        const Settings: ThemeSwitchers.Options
      ):
        return ThemeSwitcher.Lower<TMsg>(Id, Selected, Change, Settings, Theme, Colors);
      when Ui.Element.Contextual(_, _, _, _):
        raise new Sys.NotSupportedException('Context menus require the graphical profile.');
      when Ui.Element.Hinted(_, _, _):
        raise new Sys.NotSupportedException('Tooltip requires the graphical profile.');
      when Ui.Element.Popover(_, _, _, _, _, _), Ui.Element.ConfirmPopover(_, _, _, _, _, _):
        raise new Sys.NotSupportedException('Popovers require the graphical profile.');
      when Ui.Element.Toggles(_, _, _, _, _):
        raise new Sys.NotSupportedException('Toggle groups require the graphical profile.');
      when Ui.Element.CheckboxAction(
        _,
        _,
        _,
        _,
        _,
        _,
        _
      ), Ui.Element.SwitchAction(
        _,
        _,
        _,
        _,
        _,
        _
      ), Ui.Element.RadioAction(_, _, _, _, _, _), Ui.Element.Radios(_, _, _, _, _, _):
        raise new Sys.NotSupportedException(
          'Checkboxes, switches and radio controls require the graphical profile.'
        );
      when Ui.Element.Cards(_, _, _, _, _):
        raise new Sys.NotSupportedException('Radio cards require the graphical profile.');
      when Ui.Element.SliderAction(
        _,
        _,
        _,
        _,
        _,
        _,
        _
      ), Ui.Element.RangeSliderAction(_, _, _, _, _, _, _):
        raise new Sys.NotSupportedException('Sliders require the graphical profile.');
      when Ui.Element.ChipAction(_, _, _, _, _, _), Ui.Element.RatingAction(_, _, _, _, _, _):
        raise new Sys.NotSupportedException('Chip and rating require the graphical profile.');
      when Ui.Element.TabStrip(
        _,
        _,
        _,
        _,
        _
      ), Ui.Element.BreadcrumbTrail(_, _, _, _), Ui.Element.PaginationAction(_, _, _, _, _):
        raise new Sys.NotSupportedException(
          'Tabs, breadcrumb and pagination require the graphical profile.'
        );
      when Ui.Element.StepProgress(_, _, _):
        raise new Sys.NotSupportedException('Stepper requires the graphical profile.');
      when Ui.Element.Dropdown(
        const Id: string,
        const Label: string,
        const Entries: array of M.Entry<TMsg>,
        const Settings: M.Options
      ):
        return DropdownMenu.Lower<TMsg>(Id, Label, Entries, Settings, Menus, Theme);
      when Ui.Element.SplitAction(
        const Id: string, const Label: string, const Message: TMsg,
        const Items: array of Split.Item<TMsg>, const Settings: Split.Options
      ):
        return SplitWidget.Lower<TMsg>(Id, Label, Message, Items, Settings, Menus, Theme, Colors);
      when Ui.Element.Sidebar(
        const Id: string,
        const Sections: array of N.Section<TMsg>,
        const Active: string?,
        const Enabled: bool
      ):
        return Sidebar.Lower<TMsg>(Id, Sections, Active, Enabled);
      when Ui.Element.ButtonGroup(const Items: array of Ui.Element<TMsg>):
        return Group.Lower<TMsg>(Children(Items, Colors, true), Theme, Colors);
      when Ui.Element.Stack(
        const Items: array of Ui.Element<TMsg>,
        const Horizontal: bool,
        const Flow: L.Flow
      ):
        return E.Element<TMsg>.Stack(
          Children(Items, Colors, Horizontal),
          Horizontal,
          new E.Flow(
            Spacing(Flow.Gap, Horizontal),
            Spacing(Flow.Padding, true),
            Spacing(Flow.Padding, false),
            Flow.Align
          )
        );
      when Ui.Element.Sized(const Child: Ui.Element<TMsg>, const Rule: L.Flex):
        return E.Element<TMsg>.Sized(
          Visit(Child, Colors, ParentHorizontal),
          Flex(Rule, ParentHorizontal)
        );
      when Ui.Element.Styled(const Child: Ui.Element<TMsg>, const Value: UiStyle.Role):
        const Next: T.Style := Merge(Colors, Role(Theme, Value, Colors));
        return E.Element<TMsg>.Decorated(Visit(Child, Next, ParentHorizontal), Next);
      when Ui.Element.TerminalStyle(const Child: Ui.Element<TMsg>, const Value: T.Style):
        const Next: T.Style := Merge(Colors, Value);
        return E.Element<TMsg>.Decorated(Visit(Child, Next, ParentHorizontal), Next);
      when Ui.Element.Framed(const Child: Ui.Element<TMsg>, const Title: string):
        return E.Element<TMsg>.Framed(Visit(Child, Colors), Title);
      when Ui.Element.Scroll(
        const Id: string,
        const Child: Ui.Element<TMsg>,
        const Position: L.ScrollPosition?,
        const Scroll: Sys.Func<L.ScrollChange, TMsg>?,
        const Bar: bool
      ):
        case Scroll of
          when is Sys.Func<L.ScrollChange, TMsg> as Callback:
            var Native: E.ScrollPosition := E.ScrollPosition.Offset(0);
            case Position of
              when L.ScrollPosition.End:
                Native := E.ScrollPosition.End;
              when L.ScrollPosition.Offset(const Distance: L.Measure):
                Native := E.ScrollPosition.Offset(Geometry.Cells(Distance, false));
              else
            end case;

            return E.Element<TMsg>.ControlledScroll(
              Id,
              Visit(Child, Colors),
              Native,
              Callback,
              Bar
            );
          else
            return E.Element<TMsg>.Scrollable(Id, Visit(Child, Colors), Bar);
        end case;
      when Ui.Element.Sheet(
        const Id: string, const Base: Ui.Element<TMsg>, const Content: Ui.Element<TMsg>,
        const Open: bool, const Settings: Sheets.Options, const Dismiss: TMsg
      ):
        return Sheet.Lower<TMsg>(
          Id, Visit(Base, Colors, ParentHorizontal), Open, Settings, Dismiss, Colors, Theme,
          function(Panel: T.Style): E.Element<TMsg> => Visit(Content, Panel)
        );
      when Ui.Element.Deferred(const Id: string, _):
        return Visit(Prepared.Subviews[Id].Tree, Colors, ParentHorizontal);
      when Ui.Element.TerminalViewport(const Id: string, _):
        return Visit(Prepared.Subviews[Id].Tree, Colors, ParentHorizontal);
      when Ui.Element.TerminalScreen(
        const Content: Ui.Element<TMsg>,
        const Layers: array of Ui.Element<TMsg>,
        const Shortcuts: array of K.ShortcutBinding<TMsg>
      ):
        return E.Element<TMsg>.Desktop(Visit(Content, Colors), Children(Layers, Colors), Shortcuts);
    end case;
  end function;
begin
  const Result: E.Element<TMsg> := Visit(Prepared.Tree, Theme.Text);
  return Result;
end function;
end unit;
