// [Documentation](../../../../docs/ui/tui/host.md#cell-presentation)

unit Fpas.Ui.Tui.Internal.View.Tree;

uses Fpas.Ui.Widgets.Developer.LogConsoles as Logs, Fpas.Ui.Widgets.Overlays.CommandPalettes as Palettes, Fpas.Ui.TerminalExtensions.SelectionLists as Lists, Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit, Fpas.Ui.Widgets.Navigation.Tabs as Tabs, Fpas.Ui.Widgets.Collections.Tables as Tables, Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit, Fpas.Ui.TerminalExtensions.CellGrids as Grids, Fpas.Ui.Tui.Internal.Controls.Activation as Actions, Fpas.Ui.Styles as UiStyle, Fpas.Ui.Widgets.Developer.Terminal as T, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Overlays.Sheets as Sheets, Fpas.Ui.Graphics as Color, System as Sys;

// Largest column count accepted by the terminal host.
public const MaximumColumns: int := 500;

// Resolved cell allocation data consumed only by terminal layout.
public type Flex = record
  // Intrinsic basis when -1, otherwise an explicit cell extent.
  public Basis: int := -1;
  // Lower cell bound.
  public Minimum: int := 0;
  // Upper cell bound.
  public Maximum: int := int.MaxValue;
  // Share of extra cells.
  public Grow: float := 0.0F;
end record;

// Resolved stack spacing in terminal cells.
public type Flow = record
  // Main-axis gap.
  public Gap: int := 0;
  // Left and right inset.
  public PaddingX: int := 0;
  // Top and bottom inset.
  public PaddingY: int := 0;
  // Shared cross-axis alignment.
  public Align: L.Alignment := L.Alignment.Default;
end record;

// A resolved request in terminal row units.
public type ScrollPosition = variant
  // Request the supplied top row.
  Offset(Row: int);
  // Follow the final row as content grows.
  End;
end variant;

// Appearance and traversal policy for a direct terminal action.
public type ActionView = record
  // Visible text painted inside the button.
  public Caption: string;
  // Semantic label when it differs from the visible text.
  public Name: string? := null;
  // Role exposed in snapshots.
  public Role: string := 'button';
  // Model-owned value exposed in snapshots.
  public Value: string := '';
  // Semantic button style.
  public Variant: UiStyle.ButtonVariant := UiStyle.ButtonVariant.Default;
  // Allow Up and Down to cycle focus as well as Tab.
  public ArrowFocus: bool := true;
  // Group identity for vertical keyboard navigation.
  public NavigationGroup: string := '';
  // Shared tab-entry identity for a composite control.
  public TabTarget: string := '';
  // Minimum total width in cells, including button padding.
  public MinimumWidth: int := 0;
  // Optional contextual hint for the hovered control.
  public Hint: string := '';
  // Exact width in terminal columns, when specified.
  public FixedWidth: int? := null;
  // Whether to fill the available horizontal extent.
  public FillWidth: bool := false;
  // Number of cells on either side of the caption.
  public Padding: int := 1;
  // Intrinsic height in rows.
  public Height: int := 1;
  // Optional color for the caption and its glyphs.
  public Foreground: Color.Color? := null;
  // The surrounding group supplies the outline.
  public Joined: bool := false;
  // Center captions in explicit or filled widths; false keeps leading padding.
  public Center: bool := true;
  // Supporting text painted below the caption inside the same hit target.
  public Description: string := '';
end record;

// Shared terminal geometry and input policy for dialogs and edge sheets.
public type ModalOptions = record
  // Literal header and optional supporting line.
  public Title: string;
  // Text below the title.
  public Description: string;
  // Preferred width or docked extent in logical points.
  public Size: int;
  // Null centers the panel; otherwise it docks at the selected edge.
  public Edge: Sheets.Side?;
  // The control to focus on opening.
  public InitialFocus: string?;
  // Optional header close action identity.
  public CloseId: string?;
  // Whether Escape and scrim clicks propose dismissal.
  public Dismissible: bool := true;
end record;

// Text table with the model's current order and activation mappers.
// ## Type parameters
// - `TMsg`: Application message type.
public type TableView<TMsg> = record
  // Stable identity for scrolling and row navigation.
  public Id: string;
  // Columns in display order.
  public Columns: array of Tables.Column;
  // Plain text rows in model order.
  public Rows: array of Tables.Row<TMsg>;
  // Current model-owned sort.
  public Order: Tables.Sort?;
  // Sort proposal on a heading activation.
  public OnSort: Sys.Func<Tables.Sort, TMsg>?;
  // Selection proposal on a row activation.
  public OnSelect: Sys.Func<string, TMsg>?;
  // Height, row appearance and input policy.
  public Settings: Tables.Options;
  // Intrinsic widths measured once per prepared view.
  public Preferred: array of int;
end record;

// Tab strip with measured caption widths and model-owned selection.
// ## Type parameters
// - `TMsg`: Application message type.
public type TabView<TMsg> = record
  // Stable group ID.
  public Id: string;
  // Options in their original order.
  public Items: array of Tabs.Item;
  // Current selected index.
  public Selected: int;
  // Maps a proposed selection to a message.
  public Change: function(int): TMsg;
  // Appearance and input settings.
  public Settings: Tabs.Options;
  // Intrinsic width of each label including padding.
  public Widths: array of int;
end record;

// Terminal list data shared by measurement, painting and input routing.
// ## Type parameters
// - `TMsg`: Application message type.
public type SelectionListView<TMsg> = record
  // Stable control and viewport identity.
  public Id: string;
  // Rows in display order.
  public Items: array of Lists.Item;
  // Zero-based selected index, or minus one.
  public Selected: int;
  // Natural column count including the selection marker.
  public Width: int;
  // Maps a proposed row key to a message.
  public OnSelect: function(string): TMsg;
  // Maps activation of the current row to a message.
  public OnActivate: function(string): TMsg;
end record;

// Terminal presentation data produced by Lowering from a prepared Fpas.Ui tree.
// This is backend storage, not a second application widget API.
//
// ## Type parameters
// - `TMsg`: Application message type.
public type Element<TMsg> = variant
  // Paint literal text.
  Label(Value: string);
  // Appended messages with a focusable terminal scrollback.
  Log(Id: string; Entries: array of Logs.Entry; Timestamps: bool);
  // Model-controlled searchable commands over a base view.
  Palette(
    Id: string; Base: Element<TMsg>; Open: bool; Commands: array of Palettes.Command<TMsg>;
    Change: function(bool): TMsg; UseShortcut: bool
  );
  // Plain text table with a pinned header.
  Table(Value: TableView<TMsg>);
  // Scrollable rows with one focus stop and separate selection and activation.
  SelectionList(Value: SelectionListView<TMsg>);
  // Horizontally scrollable navigation strip.
  TabStrip(Value: TabView<TMsg>);
  // Single editable row with its model-owned value.
  TextField(Field: Edit.Field<TMsg>);
  // Multiline editor with model-owned text.
  TextArea(Field: AreaEdit.Field<TMsg>);
  // Fill the allocated cell surface with an image and register its input mapper.
  CellGrid(Id: string; Content: Grids.Image?; Changed: function(Grids.Event): TMsg);
  // Paint a determinate progress track and optional caption.
  Progress(Fraction: float; Caption: string; Percent: string; Width: int?; Fill: Color.Color);
  // Fit one status row to the viewport, with an optional divider above.
  StatusBar(Row: Element<TMsg>; HideBorder: bool);
  // Paint and route a direct action with semantic button styling.
  Action(Id: string; Handler: Actions.IActivatable<TMsg>; Enabled: bool; View: ActionView);
  // Arrange children using resolved cell spacing.
  Stack(Children: array of Element<TMsg>; Horizontal: bool; Settings: Flow);
  // Constrain a child using resolved cell sizing.
  Sized(Child: Element<TMsg>; Settings: Flex);
  // Apply inherited, resolved terminal colors.
  Decorated(Child: Element<TMsg>; Settings: T.Style);
  // An open card body that returns focus to its header when it closes.
  DisclosureBody(Header: string; Child: Element<TMsg>; Enabled: bool);
  // Surround a child with a cell border.
  Framed(Child: Element<TMsg>; Title: string);
  // Scroll content using host-owned offsets.
  Scrollable(Id: string; Child: Element<TMsg>; ShowScrollbar: bool);
  // Resolve model-owned scrolling and keep its original shared mapper.
  ControlledScroll(
    Id: string; Child: Element<TMsg>; Position: ScrollPosition;
    OnScroll: Sys.Func<L.ScrollChange, TMsg>; ShowScrollbar: bool
  );
  // Paint base content followed by layers and install base-scope shortcuts.
  Desktop(Content: Element<TMsg>; Overlays: array of Element<TMsg>; Shortcuts: array of K.ShortcutBinding<TMsg>);
  // Place a centered or docked modal with a pinned header and a scrolling body.
  ModalPanel(
    Id: string; Settings: ModalOptions; Size: int; Content: Element<TMsg>;
    Dismiss: TMsg; Colors: T.Style
  );
end variant;

end unit;
