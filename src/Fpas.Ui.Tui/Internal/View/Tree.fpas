// [Documentation](../../../../docs/ui/tui/host.md#cell-presentation)

unit Fpas.Ui.Tui.Internal.View.Tree;

uses Fpas.Ui.Graphics as Color;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as UiStyle;
uses Fpas.Ui.TerminalExtensions.CellGrids as Grids;
uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.TerminalExtensions.SelectionLists as Lists;
uses Fpas.Ui.Tui.Internal.Controls.Activation as Actions;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing as AreaEdit;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Developer.LogConsoles as Logs;
uses Fpas.Ui.Widgets.Developer.Terminal as T;
uses Fpas.Ui.Widgets.Overlays.CommandPalettes as Palettes;
uses Fpas.Ui.Widgets.Overlays.Sheets as Sheets;

uses System as Sys;

// Largest column count accepted by the terminal host.
public const MaximumColumns: int := 500;

// Resolved cell allocation data consumed only by terminal layout.
public type Flex = record
  // Intrinsic basis when -1, otherwise an explicit cell extent.
  public Basis: int := -1;
  // Lower cell bound.
  public Minimum: int := 0;
  // Upper cell bound.
  public Maximum: int := int.MaxValue;
  // Share of extra cells.
  public Grow: float := 0.0F;
end record;

// Resolved stack spacing in terminal cells.
public type Flow = record
  // Main-axis gap.
  public Gap: int := 0;
  // Left and right inset.
  public PaddingX: int := 0;
  // Top and bottom inset.
  public PaddingY: int := 0;
  // Shared cross-axis alignment.
  public Align: L.Alignment := L.Alignment.Default;
end record;

// A resolved request in terminal row units.
public type ScrollPosition = variant
  // Request the supplied top row.
  Offset(Row: int);
  // Follow the final row as content grows.
  End;
end variant;

// Appearance and traversal policy for a direct terminal action.
public type ActionView = record
  // Visible text painted inside the button.
  public Caption: string;
  // Semantic label when it differs from the visible text.
  public Name: string? := null;
  // Role exposed in snapshots.
  public Role: string := 'button';
  // Model-owned value exposed in snapshots.
  public Value: string := '';
  // Semantic button style.
  public Variant: UiStyle.ButtonVariant := UiStyle.ButtonVariant.Default;
  // Allow Up and Down to cycle focus as well as Tab.
  public ArrowFocus: bool := true;
  // Group identity for vertical keyboard navigation.
  public NavigationGroup: string := '';
  // Shared tab-entry identity for a composite control.
  public TabTarget: string := '';
  // Minimum total width in cells, including button padding.
  public MinimumWidth: int := 0;
  // Optional contextual hint for the hovered control.
  public Hint: string := '';
  // Exact width in terminal columns, when specified.
  public FixedWidth: int? := null;
  // Whether to fill the available horizontal extent.
  public FillWidth: bool := false;
  // Number of cells on either side of the caption.
  public Padding: int := 1;
  // Intrinsic height in rows.
  public Height: int := 1;
  // Optional color for the caption and its glyphs.
  public Foreground: Color.Color? := null;
  // The surrounding group supplies the outline.
  public Joined: bool := false;
  // Center captions in explicit or filled widths; false keeps leading padding.
  public Center: bool := true;
  // Supporting text painted below the caption inside the same hit target.
  public Description: string := '';
  // Optional caption resolver for the cell width left after button padding.
  public CaptionForWidth: Sys.Func of (int, string)? := null;
end record;

// Shared terminal geometry and input policy for dialogs and edge sheets.
public type ModalOptions = record
  // Literal header and optional supporting line.
  public Title: string;
  // Text below the title.
  public Description: string;
  // Preferred width or docked extent in logical units.
  public Size: float;
  // Null centers the panel; otherwise it docks at the selected edge.
  public Edge: Sheets.Side?;
  // The control to focus on opening.
  public InitialFocus: string?;
  // Optional header close action identity.
  public CloseId: string?;
  // Whether Escape and scrim clicks propose dismissal.
  public Dismissible: bool := true;
end record;

// Text table with the model's current order and activation mappers.
// ## Type parameters
// - `TMsg`: Application message type.
public type TableView of TMsg = record
  // Stable identity for scrolling and row navigation.
  public Id: string;
  // Columns in display order.
  public Columns: array of Tables.Column;
  // Plain text rows in model order.
  public Rows: array of Tables.Row of TMsg;
  // Current model-owned sort.
  public Order: Tables.Sort?;
  // Sort proposal on a heading activation.
  public OnSort: Sys.Func of (Tables.Sort, TMsg)?;
  // Selection proposal on a row activation.
  public OnSelect: Sys.Func of (string, TMsg)?;
  // Height, row appearance and input policy.
  public Settings: Tables.Options;
  // Intrinsic widths measured once per prepared view.
  public Preferred: array of int;
end record;

// One choice in a horizontal strip.
public type ChoiceItem = record
  // Accessible label without decoration.
  public Label: string;
  // Terminal caption, including any selection marker.
  public Caption: string;
  // Whether the model selects this choice.
  public Selected: bool;
end record;

// Rendering and input policy for a horizontal choice strip.
public type ChoiceStripOptions = record
  // Snapshot role of each choice.
  public Role: string;
  // Whether the strip accepts input.
  public Enabled: bool;
  // Whether to consume spare columns.
  public FullWidth: bool := false;
  // Whether full-width choices use the same natural width.
  public EqualWidth: bool := false;
  // Whether to draw a baseline and an underline for the selected choice.
  public Underline: bool := false;
  // Cell padding on either side of each caption.
  public Padding: int := 1;
  // Height of a choice, excluding an optional underline.
  public Height: int := 1;
end record;

// Tab or segmented control with measured caption widths.
// ## Type parameters
// - `TMsg`: Application message type.
public type ChoiceStripView of TMsg = record
  // Stable group ID.
  public Id: string;
  // Options in their original order.
  public Items: array of ChoiceItem;
  // Choice that receives focus when Tab enters the group.
  public Entry: int;
  // Proposes activation of a positional choice.
  public Activate: function(int): Actions.Result of TMsg;
  // Appearance and input settings.
  public Settings: ChoiceStripOptions;
  // Intrinsic width of each label including padding.
  public Widths: array of int;
end record;

// Terminal list data shared by measurement, painting and input routing.
// ## Type parameters
// - `TMsg`: Application message type.
public type SelectionListView of TMsg = record
  // Stable control and viewport identity.
  public Id: string;
  // Rows in display order.
  public Items: array of Lists.Item;
  // Zero-based selected index, or minus one.
  public Selected: int;
  // Natural column count including the selection marker.
  public Width: int;
  // Handles a proposed row selection.
  public OnSelect: function(string): Actions.Result of TMsg;
  // Handles activation of the current row.
  public OnActivate: function(string): Actions.Result of TMsg;
  // Maximum intrinsic row count before list scrolling.
  public MaximumRows: int := int.MaxValue;
  // Content identity for resetting the viewport when an entire listing changes.
  public ContentKey: string := '';
end record;

// Terminal pagination with a model-owned page and dispatch binding.
// ## Type parameters
// - `TMsg`: Application message type.
public type PagerView of TMsg = record
  // Stable pager identity.
  public Id: string;
  // Current zero-based page.
  public Page: int;
  // Positive page count.
  public Count: int;
  // Maps a proposed zero-based page to a message.
  public Change: function(int): TMsg;
  // Whether navigation accepts input.
  public Enabled: bool;
end record;

// Terminal breadcrumb captions and their measured widths.
// ## Type parameters
// - `TMsg`: Application message type.
public type BreadcrumbView of TMsg = record
  // Stable trail identity.
  public Id: string;
  // Single-line captions in path order.
  public Items: array of string;
  // Caption widths in terminal cells.
  public Widths: array of int;
  // Preferred width of the complete path, capped just above the terminal maximum.
  public Width: int;
  // Maps an ancestor position to a message.
  public Navigate: function(int): TMsg;
  // Whether ancestor actions and the overflow menu accept input.
  public Enabled: bool;
end record;

// Terminal presentation data produced by Lowering from a prepared Fpas.Ui tree.
// This is backend storage, not a second application widget API.
//
// ## Type parameters
// - `TMsg`: Application message type.
public type Element of TMsg = variant
  // Paint literal text.
  Label(Value: string);
  // Appended messages with a focusable terminal scrollback.
  Log(Id: string; Entries: array of Logs.Entry; Timestamps: bool);
  // Model-controlled searchable commands over a base view.
  Palette(
    Id: string; Base: Element of TMsg; Open: bool; Commands: array of Palettes.Command of TMsg;
    Change: function(bool): TMsg; UseShortcut: bool
  );
  // Plain text table with a pinned header.
  Table(Value: TableView of TMsg);
  // Scrollable rows with one focus stop and separate selection and activation.
  SelectionList(Value: SelectionListView of TMsg);
  // Horizontally scrollable strip of choices.
  ChoiceStrip(Value: ChoiceStripView of TMsg);
  // Responsive page navigation.
  Pager(Value: PagerView of TMsg);
  // Responsive trail of ancestor links and a current location.
  Breadcrumb(Value: BreadcrumbView of TMsg);
  // Single editable row with its model-owned value.
  TextField(Field: Edit.Field of TMsg);
  // Multiline editor with model-owned text.
  TextArea(Field: AreaEdit.Field of TMsg);
  // Fill the allocated cell surface with an image and register its input mapper.
  CellGrid(Id: string; Content: Grids.Image?; Changed: function(Grids.Event): TMsg);
  // Animated cell glyph with resolved dimensions and colors.
  Spinner(Frames: string; Ink: Color.Color);
  // Compact plot with one sample per cell at its natural width.
  Sparkline(Values: array of float; Width: int; Fill: bool; Ink: Color.Color);
  // Paint a determinate progress track and optional caption.
  Progress(Fraction: float; Caption: string; Percent: string; Width: int?; Fill: Color.Color);
  // Fit one status row to the viewport, with an optional divider above.
  StatusBar(Row: Element of TMsg; HideBorder: bool);
  // Paint and route a direct action with semantic button styling.
  Action(Id: string; Handler: Actions.IActivatable of TMsg; Enabled: bool; View: ActionView);
  // Arrange children using resolved cell spacing.
  Stack(Children: array of Element of TMsg; Horizontal: bool; Settings: Flow);
  // Constrain a child using resolved cell sizing.
  Sized(Child: Element of TMsg; Settings: Flex);
  // Apply inherited, resolved terminal colors.
  Decorated(Child: Element of TMsg; Settings: T.Style);
  // An open card body that returns focus to its header when it closes.
  DisclosureBody(Header: string; Child: Element of TMsg; Enabled: bool);
  // Surround a child with a cell border.
  Framed(Child: Element of TMsg; Title: string);
  // Scroll content using host-owned offsets.
  Scrollable(Id: string; Child: Element of TMsg; ShowScrollbar: bool);
  // Resolve model-owned scrolling and keep its original shared mapper.
  ControlledScroll(
    Id: string; Child: Element of TMsg; Position: ScrollPosition;
    OnScroll: Sys.Func of (L.ScrollChange, TMsg); ShowScrollbar: bool
  );
  // Paint base content followed by layers and install base-scope shortcuts.
  Desktop(Content: Element of TMsg; Overlays: array of Element of TMsg; Shortcuts: array of K.ShortcutBinding of TMsg);
  // Place a centered or docked modal with a pinned header and a scrolling body.
  ModalPanel(
    Id: string; Settings: ModalOptions; Size: int; Content: Element of TMsg;
    Dismiss: Sys.Func of TMsg; Colors: T.Style
  );
end variant;

end unit;
