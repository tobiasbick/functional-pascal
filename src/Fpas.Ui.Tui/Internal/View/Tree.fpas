unit Fpas.Ui.Tui.Internal.View.Tree;

uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Tui.Internal.Controls.Activation as Actions, Fpas.Ui.Styles as UiStyle, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Layout as L, Fpas.Ui.Sheets as Sheets, Fpas.Ui.Graphics as Color, System as Sys;

// Resolved cell allocation data consumed only by terminal layout.
public type Flex = record
  // Intrinsic basis when -1, otherwise an explicit cell extent.
  public Basis: int := -1;
  // Lower cell bound.
  public Minimum: int := 0;
  // Upper cell bound.
  public Maximum: int := int.MaxValue;
  // Share of extra cells.
  public Grow: int := 0;
end record;

// Resolved stack spacing in terminal cells.
public type Flow = record
  // Main-axis gap.
  public Gap: int := 0;
  // Left and right inset.
  public PaddingX: int := 0;
  // Top and bottom inset.
  public PaddingY: int := 0;
  // Shared cross-axis alignment.
  public Align: L.Alignment := L.Alignment.Default;
end record;

// A resolved request in terminal row units.
public type ScrollPosition = variant
  // Request the supplied top row.
  Offset(Row: int);
  // Follow the final row as content grows.
  End;
end variant;

// Appearance and traversal policy for a direct terminal action.
public type ActionView = record
  // Visible text painted inside the button.
  public Caption: string;
  // Semantic label when it differs from the visible text.
  public Name: string? := null;
  // Role exposed in snapshots.
  public Role: string := 'button';
  // Model-owned value exposed in snapshots.
  public Value: string := '';
  // Semantic button style.
  public Variant: UiStyle.ButtonVariant := UiStyle.ButtonVariant.Default;
  // Allow Up and Down to cycle focus as well as Tab.
  public ArrowFocus: bool := true;
  // Minimum total width in cells, including button padding.
  public MinimumWidth: int := 0;
  // Optional contextual hint for the hovered control.
  public Hint: string := '';
  // Exact width in terminal columns, when specified.
  public FixedWidth: int? := null;
  // Whether to fill the available horizontal extent.
  public FillWidth: bool := false;
  // Number of cells on either side of the caption.
  public Padding: int := 1;
  // Intrinsic height in rows.
  public Height: int := 1;
  // Optional color for the caption and its glyphs.
  public Foreground: Color.Color? := null;
  // The surrounding group supplies the outline.
  public Joined: bool := false;
  // Positive duration for an action that requires a pointer hold.
  public HoldMilliseconds: int := 0;
  // Filled percentage of an active hold.
  public HoldProgress: int := 0;
  // Optional state-specific normal, focus and hover colors; disabled colors remain host-owned.
  public Appearance: Th.ButtonAppearance? := null;
end record;

// Terminal presentation data produced by Lowering from a prepared Fpas.Ui tree.
// This is backend storage, not a second application widget API.
//
// ## Type parameters
// - `TMsg`: Application message type.
public type Element<TMsg> = variant
  // Paint literal text.
  Label(Value: string);
  // Paint a titled or plain cell rule.
  Separator(Title: string);
  // Paint and route a direct action with semantic button styling.
  Action(Id: string; Handler: Actions.IActivatable<TMsg>; Enabled: bool; View: ActionView);
  // Arrange children using resolved cell spacing.
  Stack(Children: array of Element<TMsg>; Horizontal: bool; Settings: Flow);
  // Constrain a child using resolved cell sizing.
  Sized(Child: Element<TMsg>; Settings: Flex);
  // Apply inherited, resolved terminal colors.
  Decorated(Child: Element<TMsg>; Settings: T.Style);
  // Surround a child with a cell border.
  Framed(Child: Element<TMsg>; Title: string);
  // Fit a framed row of joined actions to its content.
  ButtonGroup(Body: Element<TMsg>);
  // A content-sized trigger with an open popup rendered above the base view.
  PopupAnchor(Trigger: Element<TMsg>; Id: string; Content: Element<TMsg>; Initial: string; Close: procedure());
  // Scroll content using host-owned offsets.
  Scrollable(Id: string; Child: Element<TMsg>; ShowScrollbar: bool);
  // Resolve model-owned scrolling and keep its original shared mapper.
  ControlledScroll(
    Id: string; Child: Element<TMsg>; Position: ScrollPosition;
    OnScroll: Sys.Func<L.ScrollChange, TMsg>; ShowScrollbar: bool
  );
  // Paint base content followed by layers and install base-scope shortcuts.
  Desktop(Content: Element<TMsg>; Overlays: array of Element<TMsg>; Shortcuts: array of K.ShortcutBinding<TMsg>);
  // Place a modal sheet at a viewport edge with a fixed header and a scrolling body.
  EdgeSheet(
    Id: string; Settings: Sheets.Options; Size: int; Content: Element<TMsg>;
    Dismiss: TMsg; Colors: T.Style
  );
end variant;
end unit;
