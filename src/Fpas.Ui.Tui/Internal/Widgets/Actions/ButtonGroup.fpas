unit Fpas.Ui.Tui.Internal.Widgets.Actions.ButtonGroup;

uses Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Developer.Terminal as T, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Layout.Measurement as M, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, Fpas.Ui.Tui.Internal.Controls.Activation as A, System as Sys, System.Collections.Generic as C;

// Joins resolved buttons in a content-sized row with one cell frame.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Children`: Validated, lowered buttons in focus order.
// - `Theme`: Current palette for the internal dividers.
// - `Style`: Colors inherited from the containing view.
// - `FullWidth`: Fill the horizontal allocation with equally weighted members.
// ## Returns
// A framed terminal row retaining each button's input binding.
public function Lower<TMsg>(Children: array of E.Element<TMsg>; Theme: Th.Theme; Style: T.Style; FullWidth: bool := false): E.Element<TMsg>;
begin
  const Flow: E.Flow := new E.Flow();
  if Children.Length = 0 then
    return E.Element<TMsg>.Stack([], true, Flow);
  end if;

  var Height: int := 1;
  for Child: E.Element<TMsg> in Children do
    Height := Sys.Math.Max(Height, M.Intrinsic<TMsg>(Child, false));
  end for;
  var Divider: string := '│';
  for Line: int := 1 to Height - 1 do
    Divider := Divider + new string(#10, 1) + '│';
  end for;
  const Border: int := Th.Rgb(
    Theme.Colors.BorderStrong,
    Style.Background ?? Theme.Text.Background ?? 0
  );
  const Separator: E.Element<TMsg> := E.Element<TMsg>.Decorated(
    E.Element<TMsg>.Label(Divider), new T.Style(Border, Style.Background)
  );

  const Row: C.List<E.Element<TMsg>> := new C.List<E.Element<TMsg>>();
  for Child: E.Element<TMsg> in Children do
    if Row.Count > 0 then
      Row.Add(Separator);
    end if;

    case Child of
      when E.Element.Action(
        const Id: string,
        const Handler: A.IActivatable<TMsg>,
        const Enabled: bool,
        const View: E.ActionView
      ):
        const Variant: S.ButtonVariant := if View.Variant =
          S.ButtonVariant.Default
        then
          S.ButtonVariant.Ghost
        else
          View.Variant
        end if;
        const Member: E.Element<TMsg> := E.Element<TMsg>.Action(
          Id, Handler, Enabled, View with
            Variant := Variant;
            ArrowFocus := false;
            Joined := true;
          end with
        );
        Row.Add(
          if FullWidth then
            E.Element<TMsg>.Sized(Member, new E.Flex(Grow := 1))
          else
            Member
          end if
        );
      else
        raise new Sys.InvalidOperationException('A lowered button group member must be an action.');
    end case;
  end for;

  return E.Element<TMsg>.ButtonGroup(
    E.Element<TMsg>.Framed(E.Element<TMsg>.Stack(Row.ToArray(), true, Flow), ''), FullWidth
  );
end function;

// Restricts a joined row to its content and the available allocation.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Body`: The framed row.
// - `Area`: Available terminal cells.
// - `FullWidth`: Whether to fill the horizontal allocation.
// ## Returns
// The fitted group rectangle.
public function Bounds<TMsg>(Body: E.Element<TMsg>; Area: F.Rect; FullWidth: bool): F.Rect;
begin
  const Width: int := if FullWidth then
    Area.Width
  else
    Sys.Math.Min(
      Area.Width,
      M.Intrinsic<TMsg>(Body, true)
    )
  end if;
  const Height: int := Sys.Math.Min(Area.Height, M.Intrinsic<TMsg>(Body, false, Width));
  return new F.Rect(Area.X, Area.Y, Width, Height);
end function;

end unit;
