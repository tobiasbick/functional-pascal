unit Fpas.Ui.Tui.Internal.Widgets.Actions.IconButton;

uses Fpas.Ui.Widgets.Actions.IconButtons as Icons, Fpas.Ui.Styles as S, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, Fpas.Ui.Tui.Internal.Controls.Activation as A;

// Resolves an icon button into a terminal action with a visible glyph or text.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable button identity.
// - `Tooltip`: Accessible name, hover hint and text fallback.
// - `Message`: Proposed activation message.
// - `Settings`: Model-owned input and appearance settings.
// ## Returns
// A themed action with the icon button's focus and activation rules.
public function Lower<TMsg>(Id: string; Tooltip: string; Message: TMsg; Settings: Icons.Options): E.Element<TMsg>;
begin
  const Glyph: string := if Settings.TerminalGlyph = '' then
    Tooltip
  else
    Settings.TerminalGlyph
  end if;
  const Caption: string := if Settings.Loading then
    '…'
  else
    G.SingleLine(Glyph)
  end if;
  const Hint: string := if Settings.Shortcut = '' then
    Tooltip
  else
    Tooltip + ' · ' + Settings.Shortcut
  end if;
  const Variant: S.ButtonVariant := if Settings.Selected then
    S.ButtonVariant.Active
  elsif Settings.Variant = S.ButtonVariant.Default then
    S.ButtonVariant.Ghost
  else
    Settings.Variant
  end if;
  const Width: int := case Settings.ControlSize of
    when Icons.Size.Small: 4;
    when Icons.Size.Large: 6;
    else 5;
  end case;
  return E.Element<TMsg>.Action(
    Id, new A.Direct<TMsg>(Message, Settings.Loading), Settings.Enabled, new E.ActionView(
      Caption,
      Name := Tooltip,
      Role := 'icon-button',
      Value := if Settings.Loading then
        'loading'
      elsif Settings.Selected then
        'true'
      else
        'false'
      end if,
      Variant := Variant,
      ArrowFocus := false,
      MinimumWidth := Width,
      Hint := Hint
    )
  );
end function;

end unit;
