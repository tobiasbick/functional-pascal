// [Documentation](../../../../../docs/ui/tui/charts/sparkline.md)

unit Fpas.Ui.Tui.Internal.Widgets.Charts.Sparkline;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Widgets.Charts.Sparklines as Chart;
uses Fpas.Ui.Widgets.Developer.Terminal as T;

uses System as Sys;
uses System.Collections.Generic as C;

// Resolves a sparkline into a terminal plot.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Values`: Finite samples in display order.
// - `Settings`: Shared width and color.
// - `Theme`: Active terminal palette.
// ## Returns
// A plot on one terminal row.
public function Lower of TMsg(Values: array of float; Settings: Chart.Options; Theme: Th.Theme): E.Element of TMsg;
begin
  const Width: int := case Settings.Width of
    when L.Extent.Fixed(const Distance: L.Measure): F.Cells(Distance);
    else Sys.Math.Clamp(Values.Length, 1, E.MaximumColumns);
  end case;
  return (E.Element of TMsg).Sparkline(
    Values, Width, Settings.Width = L.Extent.Fill,
    Th.ChartColor(Theme, Settings.Color, Theme.Colors.Series1)
  );
end function;

// Draws a relative plot with eight levels on one row.
// ## Parameters
// - `Operations`: Frame paint operations.
// - `Area`: Plot bounds, before clipping.
// - `Clip`: Visible part of the scene.
// - `Values`: Finite samples.
// - `Ink`: Plot color.
// - `Style`: Inherited text colors.
// - `Theme`: Active terminal palette.
public procedure Paint(
  Operations: C.List of D.Operation; Area: F.Rect; Clip: F.Rect; Values: array of float;
  Ink: G.Color; Style: T.Style; Theme: Th.Theme
);
begin
  if Values.Length = 0 or Clip.Width = 0 or Clip.Height = 0 then
    return;
  end if;

  var Minimum: float := Values[0];
  var Maximum: float := Minimum;
  for Value: float in Values do
    Minimum := Sys.MathF.Min(Minimum, Value);
    Maximum := Sys.MathF.Max(Maximum, Value);
  end for;
  const Range: double := cast Maximum as double - cast Minimum as double;
  const Back: int := Style.Background ?? Theme.Text.Background ?? 0;
  const Color: T.Style := new T.Style(Th.Rgb(Ink, Back), Back);
  const Levels: string := '▁▂▃▄▅▆▇█';
  const Last: int := Values.Length - 1;
  const Line: array of char := new char[Clip.Width];
  for Column: int := 0 to Clip.Width - 1 do
    const X: int := Clip.X + Column - Area.X;
    const Position: double := if Area.Width = 1 then
      cast Last as double
    else
      cast X as double * cast Last as double / cast (Area.Width - 1) as double
    end if;
    const Index: int := cast Sys.Math.Floor(Position) as int;
    const Left: double := cast Values[Index] as double;
    const Right: double := cast Values[Sys.Math.Min(Index + 1, Last)] as double;
    const Value: double := Left + (Right - Left) * (Position - Index);
    const Fraction: double := if Range = 0.0 then
      0.5
    else
      (Value - Minimum) / Range
    end if;
    Line[Column] := Levels[
      cast Sys.Math.Round(
        Fraction * 7.0, Sys.MidpointRounding.AwayFromZero
      ) as int
    ];
  end for;

  Operations.Add(new D.Operation(new string(Line), Clip, Clip, Color, false));
end procedure;

end unit;
