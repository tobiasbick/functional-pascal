// [Documentation](../../../../../docs/ui/tui/disclosure/expandable-card.md)

unit Fpas.Ui.Tui.Internal.Widgets.Containers.ExpandableCard;

uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Tui.Internal.Controls.Activation as A;
uses Fpas.Ui.Tui.Internal.Rendering.Glyphs as G;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Widgets.Containers.ExpandableCards as C;
uses Fpas.Ui.Widgets.Developer.Terminal as T;

// Lowers the card to a stable action and a model-controlled body.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Header identity, also used as the body's focus fallback.
// - `Title`: Accessible header caption.
// - `Open`: Whether the model shows the body.
// - `Change`: Maps a proposed expansion to a message.
// - `Settings`: Caption details and input permission.
// - `Colors`: Resolved card surface colors.
// - `Body`: Resolves the body when the card is open.
// ## Returns
// A terminal card whose header keeps a stable identity.
public function Lower<TMsg>(
  Id: string; Title: string; Open: bool; Change: function(bool): TMsg; Settings: C.Options;
  Colors: T.Style; Body: function(): E.Element<TMsg>
): E.Element<TMsg>;
begin
  const Chevron: string := if Open then
    '▾ '
  else
    '▸ '
  end if;
  const Badge: string := if Settings.Badge = '' then
    ''
  else
    '  [' + G.SingleLine(Settings.Badge) + ']'
  end if;
  const Header: E.Element<TMsg> := E.Element<TMsg>.Action(
    Id, new A.Proposal<bool, TMsg>(Change, not Open), Settings.Enabled,
    new E.ActionView(
      Chevron + G.SingleLine(Title) + Badge,
      Name := Title,
      Role := 'expandable-card',
      Value := (if Open then
        'true'
      else
        'false'
      end if),
      Variant := S.ButtonVariant.Ghost,
      ArrowFocus := false,
      FillWidth := true,
      Joined := true,
      Center := false,
      Description := Settings.Description
    )
  );
  const Children: array of E.Element<TMsg> := if Open then
    [
      Header, E.Element<TMsg>.DisclosureBody(
        Id, E.Element<TMsg>.Stack([Body()], false, new E.Flow(PaddingX := 1)),
        Settings.Enabled
      )
    ]
  else
    [Header]
  end if;
  return E.Element<TMsg>.Decorated(
    E.Element<TMsg>.Stack(Children, false, new E.Flow(Gap := 1)),
    Colors
  );
end function;

end unit;
