unit Fpas.Ui.Tui.Internal.Widgets.DropdownMenu;

uses Fpas.Ui.Menus as M, Fpas.Ui.Styles as S, Fpas.Ui.Tui.Internal.Widgets.Menu as Popup, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, System as Sys;

// Composes one trigger and the shared session-owned menu primitive.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Trigger identity.
// - `Label`: Trigger caption and accessible name.
// - `Entries`: Ordered command menu content.
// - `Settings`: Trigger and popup options.
// - `Menus`: Session-owned menu visibility.
// - `Theme`: Current semantic palette.
// ## Returns
// A trigger and, when open, an anchored menu rendered above the base view.
public function Lower<TMsg>(Id: string; Label: string; Entries: array of M.Entry<TMsg>; Settings: M.Options; Menus: Popup.State; Theme: Th.Theme): E.Element<TMsg>;
begin
  if not Settings.Enabled and Menus.Id() = Id then
    Menus.Close();
  end if;
  const Variant: S.ButtonVariant := if Settings.Variant <>
    S.ButtonVariant.Default
  then
    Settings.Variant
  elsif Settings.IconOnly then
    S.ButtonVariant.Ghost
  else
    S.ButtonVariant.Secondary
  end if;
  const Caption: string := if Settings.IconOnly then
    (if Settings.TerminalIcon = '' then
      Label
    else
      Settings.TerminalIcon
    end if)
  else
    (if Settings.TerminalIcon = '' then
      ''
    else
      Settings.TerminalIcon + ' '
    end if) + Label + ' ⌄'
  end if;
  const Trigger: E.Element<TMsg> := E.Element<TMsg>.Action(
    Id, new Popup.Trigger<TMsg>(Id, Menus), Settings.Enabled,
    new E.ActionView(
      Caption,
      Name := Label,
      Role := 'menu',
      Value := if Menus.Id() = Id then
        'true'
      else
        'false'
      end if,
      Variant := Variant,
      ArrowFocus := false,
      Hint := if Settings.IconOnly then
        Label
      else
        ''
      end if
    )
  );
  if Menus.Id() <> Id then
    return Trigger;
  end if;

  return E.Element<TMsg>.PopupAnchor(
    Trigger,
    Id,
    Popup.Rows<TMsg>(Id, Entries, Menus, Theme),
    Popup.Initial<TMsg>(Id, Entries),
    Menus.Close,
    Settings.Position,
    if Settings.Width = 0.0 then
      0
    else
      cast<int>(Sys.Math.Min(
        2147483647.0,
        Sys.Math.Ceiling(Settings.Width / 8.0)
      ))
    end if
  );
end function;

end unit;
