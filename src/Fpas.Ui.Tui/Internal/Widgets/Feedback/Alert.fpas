// [Documentation](../../../../../docs/ui/tui/feedback/alert.md)

unit Fpas.Ui.Tui.Internal.Widgets.Feedback.Alert;

uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Tui.Internal.Controls.Activation as Actions;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Widgets.Developer.Terminal as T;
uses Fpas.Ui.Widgets.Feedback.Alerts as A;

uses System as Sys;
uses System.Collections.Generic as C;

// Dismissal state retained for alerts that remain in the terminal view.
public type State = record
  // IDs dismissed by the user.
  public Dismissed: C.HashSet of string := new C.HashSet of string();
  // Dismissed IDs encountered while preparing the current view.
  public Seen: C.HashSet of string := new C.HashSet of string();

  // Checks visibility and retains dismissal for this presentation.
  // ## Parameters
  // - `Id`: Stable alert identity.
  // ## Returns
  // Whether to omit the alert from layout.
  public function Hidden(Id: string): bool;
  begin
    if not self.Dismissed.Contains(Id) then
      return false;
    end if;

    discard self.Seen.Add(Id);
    return true;
  end function;

  // Releases dismissal state for alerts no longer present.
  public procedure Finish();
  begin
    self.Dismissed.IntersectWith(self.Seen);
    self.Seen.Clear();
  end procedure;
end record;

// Resolves a visible alert into a semantic panel and optional dismiss action.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable alert identity.
// - `Title`: Literal heading.
// - `Settings`: Description, tone and dismissal options.
// - `Notify`: Optional dismissal message factory.
// - `Session`: Terminal dismissal state.
// - `Colors`: Inherited text colors.
// - `Theme`: Active terminal palette.
// ## Returns
// The alert panel.
public function Lower of TMsg(
  Id: string; Title: string; Settings: A.Options; Notify: (Sys.Func of TMsg)?;
  Session: State; Colors: T.Style; Theme: Th.Theme
): E.Element of TMsg;
  function Dismiss(): Actions.Result of TMsg;
  begin
    if not Session.Dismissed.Add(Id) then
      return (Actions.Result of TMsg).NoAction;
    end if;

    return case Notify of
      when is Sys.Func of TMsg as Callback: (Actions.Result of TMsg).Send(Callback.Invoke());
      else (Actions.Result of TMsg).NoAction;
    end case;
  end function;
begin
  const Back: int := Th.Rgb(
    Theme.Colors.SurfaceMuted,
    Colors.Background ?? Theme.Text.Background ?? 0
  );
  const Mark: string := case Settings.Tone of
    when S.Tone.Success: '✓';
    when S.Tone.Warning: '!';
    when S.Tone.Danger: '×';
    else 'i';
  end case;
  const Ink: int := Th.Rgb(Th.ToneColor(Theme, Settings.Tone), Back);
  const Heading: E.Element of TMsg := (E.Element of TMsg).Stack(
    [
      (E.Element of TMsg).Decorated((E.Element of TMsg).Label(Mark + ' '), new T.Style(Ink, Back)),
      (E.Element of TMsg).Sized((E.Element of TMsg).Label(Title), new E.Flex(Grow := 1))
    ], true, new E.Flow()
  );
  var Header: E.Element of TMsg := Heading;
  if Settings.Dismissible then
    const Close: E.Element of TMsg := (E.Element of TMsg).Action(
      A.DismissId(Id), new Actions.Callback of TMsg(Dismiss), Settings.Enabled,
      new E.ActionView(
        '×',
        Name := 'Dismiss ' + Title,
        Role := 'alert-dismiss',
        ArrowFocus := false,
        FixedWidth := 3
      )
    );
    Header := (E.Element of TMsg).Stack(
      [(E.Element of TMsg).Sized(Heading, new E.Flex(Grow := 1)), Close], true, new E.Flow()
    );
  end if;
  const Contents: array of E.Element of TMsg := if Settings.Description = '' then
    [Header]
  else
    [Header, (E.Element of TMsg).Label(Settings.Description)]
  end if;
  return (E.Element of TMsg).Decorated(
    (E.Element of TMsg).Stack(Contents, false, new E.Flow(PaddingX := 1)),
    new T.Style(Th.Rgb(Theme.Colors.Foreground, Back), Back)
  );
end function;

end unit;
