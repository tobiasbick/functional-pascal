// [Documentation](../../../../../docs/ui/tui/feedback/progress-bar.md)

unit Fpas.Ui.Tui.Internal.Widgets.Feedback.ProgressBar;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.Rendering.Glyphs as Glyphs;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Widgets.Developer.Terminal as T;
uses Fpas.Ui.Widgets.Feedback.ProgressBars as Bars;
uses System as Sys;
uses System.Collections.Generic as C;

// Resolves a determinate progress bar into terminal cells.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Fraction`: Validated completion fraction.
// - `Settings`: Caption, percentage, width and semantic color.
// - `Theme`: Active shared palette.
// ## Returns
// A display-only progress track.
public function Lower<TMsg>(Fraction: float; Settings: Bars.Options; Theme: Th.Theme): E.Element<TMsg>;
begin
  const Width: int? := case Settings.Width of
    when L.Extent.Fixed(const Distance: L.Measure): F.Cells(Distance);
    else null;
  end case;
  const Caption: string := Glyphs.SingleLine(Settings.Label);
  const Percent: string := if Settings.ShowValue then
    cast<int>(Sys.MathF.Floor(100.0F * Fraction + 0.5F)).ToString() + '%'
  else
    ''
  end if;
  return E.Element<TMsg>.Progress(
    Fraction,
    Caption,
    Percent,
    Width,
    Th.ToneColor(Theme, Settings.Tone)
  );
end function;

// Paints a single line between the optional caption and percentage.
// ## Parameters
// - `Operations`: Destination paint operations.
// - `Area`: Allocated cell bounds.
// - `Clip`: Visible cell bounds.
// - `Fraction`: Completion fraction.
// - `Caption`: Prepared literal caption.
// - `Percent`: Optional formatted percentage at the trailing edge.
// - `Width`: Optional fixed width in cells.
// - `Fill`: Fill color.
// - `Style`: Enclosing text style.
// - `Theme`: Active track palette.
public procedure Paint(
  Operations: C.List<D.Operation>; Area: F.Rect; Clip: F.Rect; Fraction: float;
  Caption: string; Percent: string; Width: int?; Fill: G.Color; Style: T.Style; Theme: Th.Theme
);
begin
  const Span: int := Sys.Math.Min(Area.Width, Width ?? Area.Width);
  if Span <= 0 or Area.Height <= 0 then
    return;
  end if;

  var TrackWidth: int := Span;
  var Left: int := Area.X;
  if Percent <> '' and Percent.Length <= Span then
    Operations.Add(
      new D.Operation(
        Percent,
        new F.Rect(Left + Span - Percent.Length, Area.Y, Percent.Length, 1),
        Clip,
        Style,
        false
      )
    );
    TrackWidth := Sys.Math.Max(0, Span - Percent.Length - 2);
  end if;
  const LabelEnd: int := Glyphs.IndexAt(Caption, 0, TrackWidth - 3);
  if LabelEnd > 0 then
    const Label: string := Caption.Substring(0, LabelEnd);
    const LabelWidth: int := Glyphs.Measure(Label);
    Operations.Add(
      new D.Operation(Label, new F.Rect(Left, Area.Y, LabelWidth, 1), Clip, Style, false)
    );
    Left := Left + LabelWidth + 2;
    TrackWidth := TrackWidth - LabelWidth - 2;
  end if;
  const Filled: int := cast<int>(Sys.Math.Round(
    cast<double>(Fraction) * TrackWidth, Sys.MidpointRounding.AwayFromZero
  ));
  const Back: int := Style.Background ?? Theme.Text.Background ?? 0;
  Operations.Add(
    new D.Operation(
      new string(#9472, Filled), new F.Rect(Left, Area.Y, Filled, 1),
      Clip, new T.Style(Th.Rgb(Fill, Back), Back), false
    )
  );
  Operations.Add(
    new D.Operation(
      new string(#9472, TrackWidth - Filled),
      new F.Rect(Left + Filled, Area.Y, TrackWidth - Filled, 1),
      Clip, new T.Style(Th.Rgb(Theme.Colors.TextMuted, Back), Back), false
    )
  );
end procedure;

end unit;
