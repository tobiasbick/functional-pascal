// [Documentation](../../../../../docs/ui/tui/files/file-picker.md)

unit Fpas.Ui.Tui.Internal.Widgets.Files.FilePickerState;

uses Fpas.Ui.Tui.Internal.Widgets.Files.FilePickerListing as Data;
uses Fpas.Ui.Widgets.Files.FileListings as F;
uses Fpas.Ui.Widgets.Files.FilePickers as Picker;
uses System as Sys;
uses System.Collections.Generic as C;

// Transient browser state kept while the model holds one picker open.
public type Cursor = record
  // Current directory as understood by the provider.
  public Folder: string;
  // Last read or attempted listing for that directory.
  public Listing: F.Listing?;
  // Selected child name, or empty before selection.
  public Selected: string := '';
  // Proposed save name.
  public Name: string := '';
  // Provider supplying the current listing.
  public Source: Sys.Func<string, bool, F.Listing?>? := null;
end record;

// Per-session access to open pickers.
public type State = record
  // Gets or initializes the cursor and marks the picker as present.
  public Open: function(string, Picker.Options): Cursor;
  // Stores the cursor after dialog input.
  public Write: procedure(string, Cursor);
  // Retires pickers absent from the completed presentation.
  public Finish: procedure();
end record;

// Creates the state owner for one host.
// ## Returns
// State isolated from other terminal sessions.
public function Start(): State;
  function Open(Id: string; Settings: Picker.Options): Cursor;
  begin
    discard Seen.Add(Id);
    if Opened.ContainsKey(Id) then
      var Current: Cursor := Opened[Id];
      if not Sys.Object.Equals(Current.Source, Settings.Source) then
        Current := Current with
          Source := Settings.Source;
          Listing := Data.Read(Current.Folder, Settings.Source);
        end with;
        Opened[Id] := Current;
      end if;

      return Current;
    end if;

    const Folder: string := Data.StartFolder(Settings);
    const Current: Cursor := new Cursor(
      Folder,
      Data.Read(Folder, Settings.Source),
      Name := Settings.Name,
      Source := Settings.Source
    );
    Opened.Add(Id, Current);
    return Current;
  end function;

  procedure Write(Id: string; Current: Cursor);
  begin
    Opened[Id] := Current;
  end procedure;

  procedure Finish();
  begin
    const Closed: C.List<string> := new C.List<string>();
    for Id: string in Opened.Keys do
      if not Seen.Contains(Id) then
        Closed.Add(Id);
      end if;
    end for;

    for Id: string in Closed do
      discard Opened.Remove(Id);
    end for;

    Seen.Clear();
  end procedure;
begin
  const Opened: C.Dictionary<string, Cursor> := new C.Dictionary<string, Cursor>();
  const Seen: C.HashSet<string> := new C.HashSet<string>();
  return new State(Open, Write, Finish);
end function;

// Moves to another directory and resets the row selection.
// ## Parameters
// - `Current`: Open picker cursor.
// - `Folder`: Directory to enter.
// ## Returns
// The browser cursor in its new directory.
public function Move(Current: Cursor; Folder: string): Cursor;
begin
  return Current with
    Folder := Folder;
    Listing := Data.Read(Folder, Current.Source);
    Selected := '';
  end with;
end function;

end unit;
