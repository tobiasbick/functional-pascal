// [Documentation](../../../../../docs/ui/tui/inputs/text-field.md)

unit Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor;

uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.Tui.Internal.Controls.Activation as Actions;
uses Fpas.Ui.Tui.Internal.Rendering.Glyphs as G;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.EditText as TextEdit;
uses Fpas.Ui.Widgets.Inputs.TextFields as Fields;

uses System as Sys;
uses System.Globalization as Global;
uses System.Text as Text;

// Model-owned input and callbacks for one terminal field.
// ## Type parameters
// - `TMsg`: Application message type.
public type Field<TMsg> = record
  // Stable widget identity.
  public Id: string;
  // Text supplied by the model.
  public Value: string;
  // Publishes a proposed replacement.
  public Change: function(string): Actions.Result<TMsg>;
  // Shared field options.
  public Settings: Fields.Options;
  // Optional Enter action.
  public Submit: Sys.Func<string, Actions.Result<TMsg>>?;
  // Snapshot role for the kind of field using the editor.
  public Role: string := 'text-field';
  // Optional widget-specific key action. Null leaves the key to the editor.
  public KeyAction: Sys.Func<K.Key, K.KeyModifiers, Actions.Result<TMsg>?>? := null;
end record;

// Per-field edit position retained between presentations.
public type Cursor = record
  // Model text expected after the last input.
  public Expected: string;
  // UTF-16 insertion offset at a grapheme boundary.
  public Offset: int;
  // First visible UTF-16 offset.
  public Start: int := 0;
  // Selection origin, or minus one.
  public Anchor: int := -1;
end record;

// Access to the input router's cursor between layout passes.
public type Tracking = record
  // Reads the current edit position.
  public Read: function(string): Cursor;
  // Records the expected position for the next layout.
  public Write: procedure(Cursor);
  // Records the position to use if the model accepts an edit.
  public Propose: procedure(Cursor);
end record;

// Retains an editor position for keyboard and pointer input.
// ## Parameters
// - `Initial`: Cursor used to paint this field.
// ## Returns
// Editor state owned by the presented control.
public function Track(Initial: Cursor): Tracking;
  function Read(Value: string): Cursor;
  begin
    const Draft: Cursor? := Pending;
    return if Draft <> null and Draft.Expected = Value then
      Draft
    else
      Current
    end if;
  end function;
  procedure Move(Value: Cursor);
  begin
    Current := Value;
    Pending := null;
  end procedure;
  procedure Propose(Value: Cursor);
  begin
    Pending := Value;
  end procedure;
begin
  var Current: Cursor := Initial;
  var Pending: Cursor? := null;
  return new Tracking(Read, Move, Propose);
end function;

// Fits the caret and its display cell inside the current text viewport.
// ## Parameters
// - `Value`: Current model text.
// - `Old`: Cursor from the previous layout for the same field.
// - `Width`: Available editable columns.
// ## Returns
// Cursor positioned for this frame, reset to the end on an external replacement.
public function Fit(Value: string; Old: Cursor?; Width: int): Cursor;
begin
  var Position: Cursor := new Cursor(Value, Value.Length);
  if Old <> null and Old.Expected = Value then
    Position := new Cursor(Value, Old.Offset, Sys.Math.Min(Old.Offset, Old.Start), Old.Anchor);
  end if;

  // A deletion or insertion can join graphemes across the former viewport boundary.
  if Position.Start > 0 and Position.Start < Value.Length then
    Position := Position with
      Start := TextEdit.Previous(Value, Position.Start + 1);
    end with;
  end if;
  const CaretWidth: int := if Position.Offset = Value.Length then
    1
  else
    G.Width(Global.StringInfo.GetNextTextElement(Value, Position.Offset))
  end if;
  const Budget: int := Sys.Math.Max(0, Width - CaretWidth);
  const Before: string := Value.Substring(Position.Start, Position.Offset - Position.Start);
  const Excess: int := G.Measure(Before) - Budget;
  if Excess > 0 then
    const Cut: int := G.IndexAt(Before, 0, Excess - 1);
    Position := Position with
      Start := Position.Start + TextEdit.Next(Before, Cut);
    end with;
  end if;

  return Position;
end function;

procedure Replace<TMsg>(Field: Field<TMsg>; Position: Tracking; Start: int; Count: int; Added: string; Apply: procedure(TMsg));
begin
  const Value: string := Field.Value.Remove(Start, Count).Insert(Start, Added);
  const EndOffset: int := Start + Added.Length;
  const Next: Cursor := new Cursor(
    Value,
    TextEdit.AfterEdit(Value, EndOffset),
    Position.Read(Field.Value).Start
  );
  if Value = Field.Value then
    Position.Write(Next);
  else
    Position.Propose(Next);
    Actions.Dispatch<TMsg>(Field.Change(Value), Apply);
  end if;
end procedure;

// Inserts a single-line paste or typed text at the caret, up to the UTF-8 limit.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Field`: Current model value and callbacks.
// - `Position`: Field's cursor.
// - `Input`: Incoming text.
// - `Apply`: Dispatches a proposed edit.
public procedure Insert<TMsg>(Field: Field<TMsg>; Position: Tracking; Input: string; Apply: procedure(TMsg));
begin
  if Field.Settings.ReadOnly then
    return;
  end if;
  const Cursor: Cursor := Position.Read(Field.Value);
  const Selected: TextEdit.Range := TextEdit.Selection(Cursor.Offset, Cursor.Anchor);
  const Remaining: string := Field.Value.Remove(Selected.Start, Selected.Stop - Selected.Start);
  const Available: int := Field.Settings.MaxUtf8Bytes - Text.Encoding.UTF8.GetByteCount(Remaining);
  const Added: string := TextEdit.Insertable(Input, Available, false);
  if Added <> '' then
    Replace<TMsg>(Field, Position, Selected.Start, Selected.Stop - Selected.Start, Added, Apply);
  end if;
end procedure;

// Handles editing and submission before application navigation shortcuts.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Field`: Current model value and callbacks.
// - `Position`: Field's cursor.
// - `Pressed`: Terminal key.
// - `Modifiers`: Active modifiers.
// - `Apply`: Dispatches an edit or submission.
// ## Returns
// Whether the field consumed this key.
public function Key<TMsg>(Field: Field<TMsg>; Position: Tracking; Pressed: K.Key; Modifiers: K.KeyModifiers; Apply: procedure(TMsg)): bool;
  procedure Move(Offset: int);
  begin
    Position.Write(
      Current with
        Offset := Offset;
        Anchor := TextEdit.ExtendAnchor(Current.Offset, Current.Anchor, Extend);
      end with
    );
  end procedure;
begin
  case Field.KeyAction of
    when is Sys.Func<K.Key, K.KeyModifiers, Actions.Result<TMsg>?> as Handler:
      const Action: Actions.Result<TMsg>? := Handler.Invoke(Pressed, Modifiers);
      if Action <> null then
        Actions.Dispatch<TMsg>(Action, Apply);
        return true;
      end if;
    else
  end case;
  const Current: Cursor := Position.Read(Field.Value);
  if Modifiers = K.KeyModifiers.Ctrl and Pressed = K.Key.A then
    Position.Write(
      Current with
        Offset := Field.Value.Length;
        Anchor := 0;
      end with
    );
    return true;
  end if;
  const Extend: bool := Modifiers = K.KeyModifiers.Shift;
  if Modifiers <> K.KeyModifiers.None and not Extend then
    return false;
  end if;
  const At: int := Current.Offset;
  const Selected: TextEdit.Range := TextEdit.Selection(At, Current.Anchor);
  const HasSelection: bool := Selected.Start <> Selected.Stop;
  case Pressed of
    when K.Key.Home:
      Move(0);
    when K.Key.End:
      Move(Field.Value.Length);
    when K.Key.Left:
      Move(
        if HasSelection and not Extend then
          Selected.Start
        else
          TextEdit.Previous(Field.Value, At)
        end if
      );
    when K.Key.Right:
      Move(
        if HasSelection and not Extend then
          Selected.Stop
        else
          TextEdit.Next(Field.Value, At)
        end if
      );
    when K.Key.Backspace, K.Key.Delete:
      if Extend then
        return false;
      end if;

      if not Field.Settings.ReadOnly then
        const Start: int := if HasSelection then
          Selected.Start
        elsif Pressed = K.Key.Backspace then
          TextEdit.Previous(Field.Value, At)
        else
          At
        end if;
        const Stop: int := if HasSelection then
          Selected.Stop
        elsif Pressed = K.Key.Delete then
          TextEdit.Next(Field.Value, At)
        else
          At
        end if;
        Replace<TMsg>(Field, Position, Start, Stop - Start, '', Apply);
      end if;
    when K.Key.Enter:
      if Extend then
        return false;
      end if;

      case Field.Submit of
        when is Sys.Func<string, Actions.Result<TMsg>> as Submit:
          Actions.Dispatch<TMsg>(Submit.Invoke(Field.Value), Apply);
        else
      end case;
    else
      return false;
  end case;

  return true;
end function;

end unit;
