// [Documentation](../../../../../docs/ui/tui/inputs/search-field.md)

unit Fpas.Ui.Tui.Internal.Widgets.Inputs.SearchField;

uses Fpas.Ui.Tui.Internal.Controls.Activation as Actions;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextField as TextField;
uses Fpas.Ui.Widgets.Developer.Terminal as T;
uses Fpas.Ui.Widgets.Inputs.SearchFields as Search;
uses Fpas.Ui.Widgets.Inputs.TextFields as Fields;

uses System as Sys;

// Resolves a search editor with an optional clear control.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Value`: Model-owned query.
// - `Change`: Maps a proposed query to a message.
// - `Settings`: Search presentation and input options.
// - `Submit`: Optional Enter callback.
// - `Colors`: Inherited text colors.
// - `Theme`: Active terminal palette.
// ## Returns
// A labeled single-line editor with search adornments.
public function Lower of TMsg(
  Id: string; Value: string; Change: function(string): TMsg; Settings: Search.Options;
  Submit: Sys.Func of (string, TMsg)?; Colors: T.Style; Theme: Th.Theme
): E.Element of TMsg;
  function Propose(Text: string): Actions.Result of TMsg;
  begin
    return (Actions.Result of TMsg).Send(Change(Text));
  end function;
begin
  const OnSubmit: Sys.Func of (string, Actions.Result of TMsg)? := case Submit of
    when is Sys.Func of (string, TMsg) as Callback: function(Text: string): Actions.Result of TMsg => (Actions.Result of TMsg).Send(
      Callback.Invoke(Text)
    );
    else null;
  end case;
  const Field: Edit.Field of TMsg := new Edit.Field of TMsg(
    Id, Value, Propose,
    new Fields.Options(
      Label := Settings.Label,
      Placeholder := if Settings.Placeholder = '' then
        'Search'
      else
        Settings.Placeholder
      end if,
      Enabled := Settings.Enabled,
      ReadOnly := Settings.ReadOnly,
      MaxUtf8Bytes := Settings.MaxUtf8Bytes
    ),
    OnSubmit, Role := 'search-field'
  );
  var Controls: array of E.Element of TMsg := [];
  if Value <> '' and not Settings.ReadOnly then
    const Clear: E.Element of TMsg := (E.Element of TMsg).Action(
      Search.ClearId(Id),
      new Actions.Callback of TMsg(function(): Actions.Result of TMsg => Propose('')),
      Settings.Enabled,
      new E.ActionView(
        '×',
        Name := 'Clear search',
        ArrowFocus := false,
        FixedWidth := 3
      )
    );
    Controls := [(E.Element of TMsg).DisclosureBody(Id, Clear, true)];
  end if;

  return TextField.WithLabels of TMsg(
    TextField.WithAdornments of TMsg(
      Field,
      Settings.Prefix,
      Settings.Suffix,
      Controls,
      Colors,
      Theme
    ),
    Settings.Label, Settings.Hint, Settings.Error, Colors, Theme
  );
end function;

end unit;
