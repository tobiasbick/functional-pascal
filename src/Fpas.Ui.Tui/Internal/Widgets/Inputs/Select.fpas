// [Documentation](../../../../../docs/ui/tui/inputs/select.md)

unit Fpas.Ui.Tui.Internal.Widgets.Inputs.Select;

uses
  Fpas.Ui.Tui.Internal.Widgets.Overlays.PopupState as P, Fpas.Ui.Tui.Internal.Widgets.Overlays.AnchoredPopup as Popup,
  Fpas.Ui.Tui.Internal.Layout.Flexible as F, System as Sys, System.Collections.Generic as C,
  Fpas.Ui.Widgets.Inputs.Selects as S, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Controls.Activation as A,
  Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, Fpas.Ui.Styles as Styles;

// The select trigger and current model bindings.
// ## Type parameters
// - `TMsg`: Application message type.
public type Trigger<TMsg> = record implements A.IActivatable<TMsg>
  // Stable control identity.
  public Id: string;
  // Options in original index order.
  public Items: array of S.Item;
  // Model-owned index or minus one.
  public Selected: int;
  // Maps a new selection to a message.
  public Change: function(int): TMsg;
  // Label, placeholder and input policy.
  public Settings: S.Options;
  // The owning terminal session.
  public Popup: P.State<TMsg>;

  // Opens the popup at the model selection with a fresh query.
  // ## Returns
  // Opening does not send a message.
  public function Activate(): A.Result<TMsg>;
  begin
    const Highlight: string := if self.Selected >= 0 then
      S.OptionId(self.Id, self.Selected)
    else
      ''
    end if;
    self.Popup.Write(new P.Cursor(self.Id, Highlight));
    return A.Result<TMsg>.NoAction;
  end function;
end record;

type Option<TMsg> = record implements A.IActivatable<TMsg>
  public Field: Trigger<TMsg>;
  public Index: int;

  public function Activate(): A.Result<TMsg>;
  begin
    return if self.Index = self.Field.Selected then
      A.Result<TMsg>.NoAction
    else
      A.Result<TMsg>.Send(self.Field.Change(self.Index))
    end if;
  end function;
end record;

// Resolves the options to popup rows with their original index identities.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Field`: Current model binding.
// - `Anchor`: Visible trigger bounds.
// ## Returns
// Popup content with optional search.
public function Content<TMsg>(Field: Trigger<TMsg>; Anchor: F.Rect): Popup.Content<TMsg>;
begin
  const Rows: C.List<Popup.Row<TMsg>> := new C.List<Popup.Row<TMsg>>(Field.Items.Length);
  for Index: int := 0 to Field.Items.Length - 1 do
    const Label: string := Field.Items[Index].Label;
    const Active: bool := Index = Field.Selected;
    const Caption: string := (if Active then
      '✓ '
    else
      '  '
    end if) + G.SingleLine(Label);
    Rows.Add(
      Popup.Row<TMsg>.Choice(
        new Popup.Item<TMsg>(
          S.OptionId(Field.Id, Index), Label, Caption,
          'select-option', new Option<TMsg>(Field, Index), Value := Active.ToString()
        )
      )
    );
  end for;

  return new Popup.Content<TMsg>(
    Rows.ToArray(),
    Sys.Math.Max(18, Anchor.Width),
    Searchable := Field.Settings.Searchable
  );
end function;

// Builds the collapsed field with its optional label.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Field`: Model binding and popup state.
// ## Returns
// A trigger and optional caption in a single column.
public function Lower<TMsg>(Field: Trigger<TMsg>): E.Element<TMsg>;
begin
  const Value: string := if Field.Selected >= 0 then
    Field.Items[Field.Selected].Label
  elsif Field.Settings.Placeholder <> '' then
    Field.Settings.Placeholder
  else
    'Select'
  end if;
  const Button: E.Element<TMsg> := E.Element<TMsg>.Action(
    Field.Id, Field, Field.Settings.Enabled,
    new E.ActionView(
      '▾ ' + G.SingleLine(Value),
      Name := Field.Settings.Label,
      Role := 'select',
      Value := Value,
      Variant := Styles.ButtonVariant.Secondary,
      FillWidth := true,
      Center := false,
      Joined := true,
      ArrowFocus := false
    )
  );
  const Rows: array of E.Element<TMsg> := if Field.Settings.Label = '' then
    [Button]
  else
    [E.Element<TMsg>.Label(Field.Settings.Label), Button]
  end if;
  return E.Element<TMsg>.Stack(Rows, false, new E.Flow());
end function;

end unit;
