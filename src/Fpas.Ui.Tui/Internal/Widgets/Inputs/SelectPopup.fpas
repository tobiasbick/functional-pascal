// [Documentation](../../../../../docs/ui/tui/inputs/select.md)

unit Fpas.Ui.Tui.Internal.Widgets.Inputs.SelectPopup;

uses
  Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit, Fpas.Ui.Tui.Internal.Widgets.Inputs.Select as Select, Fpas.Ui.Widgets.Inputs.Selects as S,
  Fpas.Ui.Tui.Internal.Controls.Activation as Actions, Fpas.Ui.Tui.Internal.Layout.Scene as A, Fpas.Ui.Tui.Internal.Layout.Flexible as F,
  Fpas.Ui.Tui.Internal.Rendering.Drawing as D, Fpas.Ui.Tui.Internal.Rendering.Glyphs as G, Fpas.Ui.Tui.Internal.Rendering.Themes as Th,
  Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Tui.Application as App, Fpas.Ui.Widgets.Developer.Terminal as T, Fpas.Ui.Styles as Styles,
  System as Sys, System.Collections.Generic as C, System.Globalization as Global;

type Option<TMsg> = record implements Actions.IActivatable<TMsg>
  public Field: Select.Trigger<TMsg>;
  public Index: int;

  public function Activate(): Actions.Result<TMsg>;
  begin
    return self.Field.Choose(self.Index);
  end function;
end record;

function Place(Anchor: F.Rect; Screen: F.Rect; Wanted: int): F.Rect;
begin
  const Below: int := Screen.Height - Anchor.Y - Anchor.Height;
  const Above: int := Anchor.Y;
  const Up: bool := Below < Wanted and Above > Below;
  const Height: int := Sys.Math.Max(
    1, Sys.Math.Min(
      Wanted, if Up then
        Above
      else
        Below
      end if
    )
  );
  const Width: int := Sys.Math.Min(Screen.Width, Sys.Math.Max(18, Anchor.Width));
  return new F.Rect(
    Sys.Math.Min(Anchor.X, Screen.Width - Width), Sys.Math.Clamp(
      if Up then
        Anchor.Y - Height
      else
        Anchor.Y + Anchor.Height
      end if,
      0, Screen.Height - Height
    ), Width, Height
  );
end function;

function Draw<TMsg>(
  Field: Select.Trigger<TMsg>; Anchor: F.Rect; Screen: F.Rect; Theme: Th.Theme;
  Operations: C.List<D.Operation>; Controls: C.List<A.Control<TMsg>>
): A.Scope<TMsg>;
  procedure Line(Value: string; Area: F.Rect; Colors: T.Style);
  begin
    Operations.Add(new D.Operation(Value, Area, Area, Colors, false));
  end procedure;

  function Route(Event: App.Input): bool;
    procedure MoveTo(Position: long);
    begin
      if Matches.Count > 0 then
        Field.Popup.Write(
          Cursor with
            Highlight := Matches[
              cast<int>(Sys.Math.Clamp(Position, 0L, cast<long>(Matches.Count - 1)))
            ];
          end with
        );
      end if;
    end procedure;
    procedure Filter(Query: string);
    begin
      Field.Popup.Write(new Select.Cursor(Field.Id, Query));
    end procedure;
  begin
    case Event of
      when App.Input.KeyPress(const Key: K.Key, const Modifiers: K.KeyModifiers):
        if Modifiers = K.KeyModifiers.None then
          case Key of
            when K.Key.Escape, K.Key.Tab:
              Field.Popup.Write(new Select.Cursor());
            when K.Key.Up:
              MoveTo(At - 1);
            when K.Key.Down:
              MoveTo(At + 1);
            when K.Key.PageUp:
              MoveTo(At - Capacity);
            when K.Key.PageDown:
              MoveTo(At + Capacity);
            when K.Key.Home:
              MoveTo(0);
            when K.Key.End:
              MoveTo(Matches.Count - 1);
            when K.Key.Enter:
              if At >= 0 then
                case Field.Choose(Matches[At]) of
                  when Actions.Result.Send(const Message: TMsg):
                    Field.Popup.Apply(Message);
                  else
                end case;
              end if;
            when K.Key.Backspace:
              if Field.Settings.Searchable and Cursor.Query.Length > 0 then
                const Starts: array of int := Global.StringInfo.ParseCombiningCharacters(
                  Cursor.Query
                );
                Filter(Cursor.Query.Substring(0, Starts[Starts.Length - 1]));
              end if;
            else
          end case;
        elsif Key = K.Key.Tab and Modifiers = K.KeyModifiers.Shift then
          Field.Popup.Write(new Select.Cursor());
        end if;
      when App.Input.Character(
        const Text: string
      ), App.Input.TextInput(const Text: string), App.Input.Paste(const Text: string):
        if Field.Settings.Searchable and Text <> '' then
          Filter(Cursor.Query + G.SingleLine(Text));
        end if;
      when App.Input.Scroll(const X: int, const Y: int, const Delta: int):
        if Panel.Contains(X, Y) then
          MoveTo(cast<long>(At) + Delta);
        end if;
      when App.Input.Focus(const Id: string):
        for Index: int := 0 to Matches.Count - 1 do
          if S.OptionId(Field.Id, Matches[Index]) = Id then
            MoveTo(Index);
            break;
          end if;
        end for;
      else
        return false;
    end case;

    return true;
  end function;
begin
  const Current: Select.Cursor := Field.Popup.Read();
  const FilterText: string := if Field.Settings.Searchable then
    Current.Query
  else
    ''
  end if;
  const Matches: C.List<int> := new C.List<int>();
  for Index: int := 0 to Field.Items.Length - 1 do
    if Field.Items[Index].Label.Contains(FilterText, Sys.StringComparison.OrdinalIgnoreCase) then
      Matches.Add(Index);
    end if;
  end for;
  const At: int := if Matches.Count = 0 then
    -1
  else
    Sys.Math.Max(0, Matches.IndexOf(Current.Highlight))
  end if;
  const Wanted: int := Sys.Math.Clamp(Matches.Count, 1, 8) + (if Field.Settings.Searchable then
    1
  else
    0
  end if);
  const Panel: F.Rect := Place(Anchor, Screen, Wanted);
  const Header: int := if Field.Settings.Searchable and Panel.Height > 1 then
    1
  else
    0
  end if;
  const Capacity: int := Panel.Height - Header;
  const Top: int := Sys.Math.Clamp(
    Current.Top,
    Sys.Math.Max(0, At - Capacity + 1),
    Sys.Math.Max(0, Sys.Math.Min(At, Matches.Count - Capacity))
  );
  const Cursor: Select.Cursor := Current with
    Query := FilterText;
    Top := Top;
    Highlight := if At >= 0 then
      Matches[At]
    else
      -1
    end if;
  end with;
  Field.Popup.Write(Cursor);
  const Surface: int := Th.Rgb(Theme.Colors.SurfaceRaised, Theme.Text.Background ?? 0);
  const Colors: T.Style := new T.Style(Th.Rgb(Theme.Colors.Foreground, Surface), Surface);
  D.Fill(Operations, Panel, Colors);
  if Header > 0 then
    const Query: string := Cursor.Query;
    const Prefix: string := if Panel.Width >= 12 then
      'Search: '
    else
      ''
    end if;
    const Position: Edit.Cursor := Edit.Fit(
      Query,
      null,
      Sys.Math.Max(1, Panel.Width - Prefix.Length)
    );
    Line(
      Prefix + Query.Substring(Position.Start) + '▏',
      new F.Rect(Panel.X, Panel.Y, Panel.Width, 1),
      Colors
    );
  end if;

  if Matches.Count = 0 then
    Line('No results', new F.Rect(Panel.X, Panel.Y + Header, Panel.Width, 1), Colors);
  end if;

  for Row: int := 0 to Sys.Math.Min(Capacity, Matches.Count - Top) - 1 do
    const Index: int := Matches[Top + Row];
    const Area: F.Rect := new F.Rect(Panel.X, Panel.Y + Header + Row, Panel.Width, 1);
    const Label: string := Field.Items[Index].Label;
    Line(
      (if Index = Field.Selected then
        '✓ '
      else
        '  '
      end if) + G.SingleLine(Label), Area, Colors
    );
    Controls.Add(
      new A.Control<TMsg>(
        S.OptionId(Field.Id, Index),
        Label,
        'select-option',
        (Index = Field.Selected).ToString(),
        Area,
        Field.Id,
        Field.Id,
        true,
        A.Binding<TMsg>.Invoke(
          new Option<TMsg>(Field, Index)
        ),
        Styles.ButtonVariant.Ghost
      )
    );
  end for;

  return new A.Scope<TMsg>(
    Field.Id, if At >= 0 then
      S.OptionId(Field.Id, Matches[At])
    else
      ''
    end if, null, [], Panel, Route
  );
end function;

// Overlays the current trigger's options inside the terminal viewport.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Popup`: Session-local popup state.
// - `Parent`: Currently active underlying modal scope.
// - `Screen`: Terminal bounds.
// - `Theme`: Active theme.
// - `Operations`: Ordered paint operations.
// - `Controls`: Current visible controls.
// ## Returns
// The popup scope when the trigger is visible, enabled and in the active scope.
public function Present<TMsg>(
  Popup: Select.State<TMsg>; Parent: A.Scope<TMsg>?; Screen: F.Rect; Theme: Th.Theme;
  Operations: C.List<D.Operation>; Controls: C.List<A.Control<TMsg>>
): A.Scope<TMsg>?;
begin
  const Id: string := Popup.Read().Id;
  if Id = '' then
    return null;
  end if;
  const Owner: A.Control<TMsg>? := Controls.Find(
    function(Item: A.Control<TMsg>): bool => Item.Id = Id
  );
  if Owner <> null and Owner.Enabled and Owner.Scope = (if Parent = null then
    ''
  else
    Parent.Id
  end if)
  then
    case A.Activatable<TMsg>(Owner.Action) of
      when is Select.Trigger<TMsg> as Field:
        return Draw<TMsg>(Field, Owner.Bounds, Screen, Theme, Operations, Controls);
      else
    end case;
  end if;

  Popup.Write(new Select.Cursor());
  return null;
end function;

end unit;
