// [Documentation](../../../../../docs/ui/tui/inputs/text-area.md)

unit Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaEditing;

uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.Tui.Internal.Rendering.Glyphs as G;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.EditText as TextEdit;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaRows as Lines;
uses Fpas.Ui.Widgets.Inputs.TextAreas as A;

uses System as Sys;
uses System.Text as Text;

// Model bindings for a multiline field.
// ## Type parameters
// - `TMsg`: Application message type.
public type Field of TMsg = record
  // Stable editor identity.
  public Id: string;
  // Current model text.
  public Value: string;
  // Maps an edit to an application message.
  public Change: function(string): TMsg;
  // Shared appearance and input options.
  public Settings: A.Options;
  // Optional Ctrl+Enter action.
  public Submit: Sys.Func of (string, TMsg)?;
  // Preferred height in terminal rows.
  public Rows: int;
end record;

// Transient caret and vertical viewport.
public type Cursor = record
  // Text for which this position is valid.
  public Expected: string;
  // Insertion offset in UTF-16.
  public Offset: int := 0;
  // First displayed visual row.
  public Top: int := 0;
  // Follow the caret until a manual scroll moves the viewport.
  public Follow: bool := true;
  // When true, a caret on a soft wrap belongs to the previous line.
  public BeforeWrap: bool := false;
  // Column to restore after a short line, or minus one when unset.
  public Goal: int := -1;
  // Selection origin, or minus one.
  public Anchor: int := -1;
end record;

// Cursor state shared between input and layout.
public type Tracking = record
  // Reads the correct position for the accepted text.
  public Read: function(string): Cursor;
  // Updates a caret or viewport without an edit.
  public Move: procedure(Cursor);
  // Remembers a position to use only if the model accepts the new value.
  public Propose: procedure(Cursor);
end record;

// Stores the active and proposed editor positions.
// ## Parameters
// - `Position`: Current position for the presented text.
// ## Returns
// Tracking owned by this control in the presented frame.
public function Track(Position: Cursor): Tracking;
  function Read(Value: string): Cursor;
  begin
    const Draft: Cursor? := Pending;
    return if Draft <> null and Draft.Expected = Value then
      Draft
    elsif Current.Expected = Value then
      Current
    else
      new Cursor(Value)
    end if;
  end function;
  procedure Move(Value: Cursor);
  begin
    Current := Value;
    Pending := null;
  end procedure;
  procedure Propose(Value: Cursor);
  begin
    Pending := Value;
  end procedure;
begin
  var Current: Cursor := Position;
  var Pending: Cursor? := null;
  return new Tracking(Read, Move, Propose);
end function;

// Input geometry captured from the same lines as the renderer.
// ## Type parameters
// - `TMsg`: Application message type.
public type View of TMsg = record
  // Current application binding.
  public Field: Field of TMsg;
  // Wrapped text rows.
  public Rows: array of Lines.Line;
  // Transient state for this presentation.
  public Position: Tracking;
  // Origin column of editable text.
  public X: int;
  // First allocated row.
  public Y: int;
  // Number of allocated rows.
  public Height: int;
end record;

procedure Replace of TMsg(View: View of TMsg; Start: int; Count: int; Added: string; Apply: procedure(TMsg));
begin
  const Field: Field of TMsg := View.Field;
  const Position: Cursor := View.Position.Read(Field.Value);
  const Value: string := Field.Value.Remove(Start, Count).Insert(Start, Added);
  const Next: Cursor := new Cursor(
    Value,
    TextEdit.AfterEdit(Value, Start + Added.Length),
    Position.Top
  );
  if Value = Field.Value then
    View.Position.Move(Next);
  else
    View.Position.Propose(Next);
    Apply(Field.Change(Value));
  end if;
end procedure;

// Inserts text while preserving line breaks and the UTF-8 capacity.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `View`: Presented editor.
// - `Input`: Typed or pasted text.
// - `Apply`: Dispatches a model edit.
public procedure Insert of TMsg(View: View of TMsg; Input: string; Apply: procedure(TMsg));
begin
  const Field: Field of TMsg := View.Field;
  if Field.Settings.ReadOnly then
    return;
  end if;
  const Current: Cursor := View.Position.Read(Field.Value);
  const Selected: TextEdit.Range := TextEdit.Selection(Current.Offset, Current.Anchor);
  const Remaining: string := Field.Value.Remove(Selected.Start, Selected.Stop - Selected.Start);
  const Available: int := Field.Settings.MaxUtf8Bytes - Text.Encoding.UTF8.GetByteCount(Remaining);
  const Added: string := TextEdit.Insertable(Input, Available, true);
  if Added <> '' then
    Replace of TMsg(View, Selected.Start, Selected.Stop - Selected.Start, Added, Apply);
  end if;
end procedure;

procedure Place of TMsg(View: View of TMsg; Index: int; Offset: int; Goal: int; Extend: bool := false);
begin
  const BeforeWrap: bool := Index + 1 < View.Rows.Length and View.Rows[Index + 1].Start = Offset;
  const Current: Cursor := View.Position.Read(View.Field.Value);
  View.Position.Move(
    new Cursor(
      View.Field.Value,
      Offset,
      Current.Top,
      BeforeWrap := BeforeWrap,
      Goal := Goal,
      Anchor := TextEdit.ExtendAnchor(Current.Offset, Current.Anchor, Extend)
    )
  );
end procedure;

// Handles navigation, edits and submission for a multiline field.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `View`: Presented editor.
// - `Pressed`: Terminal key.
// - `Modifiers`: Active key modifiers.
// - `Apply`: Dispatches an edit or submission.
// ## Returns
// Whether the key was handled.
public function Key of TMsg(View: View of TMsg; Pressed: K.Key; Modifiers: K.KeyModifiers; Apply: procedure(TMsg)): bool;
begin
  const Field: Field of TMsg := View.Field;
  const Value: string := Field.Value;
  const Position: Cursor := View.Position.Read(Value);
  const At: int := Position.Offset;
  const Selected: TextEdit.Range := TextEdit.Selection(At, Position.Anchor);
  const HasSelection: bool := Selected.Start <> Selected.Stop;
  if Modifiers = K.KeyModifiers.Ctrl then
    case Pressed of
      when K.Key.A:
        View.Position.Move(new Cursor(Value, Value.Length, Position.Top, Anchor := 0));
      when K.Key.Enter:
        case Field.Submit of
          when is Sys.Func of (string, TMsg) as Submit:
            Apply(Submit.Invoke(Value));
          else
        end case;
      when K.Key.Home, K.Key.End:
        View.Position.Move(
          new Cursor(
            Value, if Pressed = K.Key.Home then
              0
            else
              Value.Length
            end if, Position.Top
          )
        );
      else
        return false;
    end case;

    return true;
  end if;

  const Extend: bool := Modifiers = K.KeyModifiers.Shift;
  if Modifiers <> K.KeyModifiers.None and not Extend then
    return false;
  end if;
  const Index: int := Lines.Locate(View.Rows, At, Position.BeforeWrap);
  const Row: Lines.Line := View.Rows[Index];
  case Pressed of
    when K.Key.Left, K.Key.Right:
      const Offset: int := if Pressed = K.Key.Left then
        if HasSelection and not Extend then
          Selected.Start
        else
          TextEdit.Previous(Value, At)
        end if
      else
        if HasSelection and not Extend then
          Selected.Stop
        else
          TextEdit.Next(Value, At)
        end if
      end if;
      View.Position.Move(
        new Cursor(
          Value,
          Offset,
          Position.Top,
          Anchor := TextEdit.ExtendAnchor(At, Position.Anchor, Extend)
        )
      );
    when K.Key.Home, K.Key.End:
      Place of TMsg(
        View, Index, if Pressed = K.Key.Home then
          Row.Start
        else
          Row.Stop
        end if, -1, Extend
      );
    when K.Key.Up, K.Key.Down, K.Key.PageUp, K.Key.PageDown:
      const Delta: int := case Pressed of
        when K.Key.Up: -1;
        when K.Key.Down: 1;
        when K.Key.PageUp: -View.Height;
        else View.Height;
      end case;
      const Target: int := Sys.Math.Clamp(Index + Delta, 0, View.Rows.Length - 1);
      const Goal: int := if Position.Goal >= 0 then
        Position.Goal
      else
        G.Measure(Value.Substring(Row.Start, At - Row.Start))
      end if;
      Place of TMsg(View, Target, Lines.AtColumn(Value, View.Rows[Target], Goal), Goal, Extend);
    when K.Key.Backspace, K.Key.Delete:
      if Extend then
        return false;
      end if;

      if not Field.Settings.ReadOnly then
        const Start: int := if HasSelection then
          Selected.Start
        elsif Pressed = K.Key.Backspace then
          TextEdit.Previous(Value, At)
        else
          At
        end if;
        const Stop: int := if HasSelection then
          Selected.Stop
        elsif Pressed = K.Key.Delete then
          TextEdit.Next(Value, At)
        else
          At
        end if;
        Replace of TMsg(View, Start, Stop - Start, '', Apply);
      end if;
    when K.Key.Enter:
      if Extend then
        return false;
      end if;

      Insert of TMsg(View, cast<char>(10).ToString(), Apply);
    else
      return false;
  end case;

  return true;
end function;

// Places the caret using the visible row and column.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `View`: Presented editor.
// - `Column`: Pointer column in terminal cells.
// - `Row`: Pointer row in terminal cells.
public procedure Click of TMsg(View: View of TMsg; Column: int; Row: int);
begin
  const Position: Cursor := View.Position.Read(View.Field.Value);
  const Index: int := Position.Top + Row - View.Y;
  if Index >= View.Rows.Length then
    View.Position.Move(new Cursor(View.Field.Value, View.Field.Value.Length, Position.Top));
  else
    Place of TMsg(
      View,
      Index,
      Lines.AtColumn(View.Field.Value, View.Rows[Index], Column - View.X),
      -1
    );
  end if;
end procedure;

// Scrolls the editor viewport without moving the caret.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `View`: Presented editor.
// - `Delta`: Signed row count.
// ## Returns
// True when the editor used the wheel. At an edge the parent may scroll.
public function Scroll of TMsg(View: View of TMsg; Delta: int): bool;
begin
  const Position: Cursor := View.Position.Read(View.Field.Value);
  const Limit: int := Sys.Math.Max(0, View.Rows.Length - View.Height);
  const Top: int := cast<int>(Sys.Math.Clamp(
    cast<long>(Position.Top) + Delta,
    0L,
    cast<long>(Limit)
  ));
  if Top = Position.Top then
    return false;
  end if;

  View.Position.Move(
    Position with
      Top := Top;
      Follow := false;
    end with
  );
  return true;
end function;

end unit;
