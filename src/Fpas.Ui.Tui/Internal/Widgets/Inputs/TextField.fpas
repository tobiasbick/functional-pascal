// [Documentation](../../../../../docs/ui/tui/inputs/text-field.md)

unit Fpas.Ui.Tui.Internal.Widgets.Inputs.TextField;

uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Layout.Scene as A;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.Rendering.Glyphs as G;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.LineEditor as Edit;
uses Fpas.Ui.Widgets.Developer.Terminal as T;

uses System.Collections.Generic as C;

// Composes an editor with its optional caption and supporting text.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Content`: Editable area.
// - `Label`: Caption above the editor.
// - `Hint`: Optional supporting text.
// - `Error`: Validation error replacing the hint.
// - `Colors`: Inherited text style.
// - `Theme`: Semantic colors for errors and hints.
// ## Returns
// A column of the editor and its optional surrounding text.
public function WithLabels of TMsg(Content: E.Element of TMsg; Label: string; Hint: string; Error: string; Colors: T.Style; Theme: Th.Theme): E.Element of TMsg;
begin
  const Rows: C.List of E.Element of TMsg := new C.List of E.Element of TMsg();
  if Label <> '' then
    Rows.Add((E.Element of TMsg).Label(Label));
  end if;

  Rows.Add(Content);
  const HasError: bool := Error <> '';
  const Detail: string := if HasError then
    Error
  else
    Hint
  end if;
  if Detail <> '' then
    const Ink: int := Th.Rgb(
      if HasError then
        Theme.Colors.Danger
      else
        Theme.Colors.TextMuted
      end if, Colors.Background ?? 0
    );
    Rows.Add(
      (E.Element of TMsg).Decorated(
        (E.Element of TMsg).Label(Detail),
        new T.Style(Ink, Colors.Background)
      )
    );
  end if;

  return (E.Element of TMsg).Stack(Rows.ToArray(), false, new E.Flow());
end function;

// Places terminal adornments alongside the editable value.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Field`: Editor and its input handlers.
// - `Prefix`: Text before the editable value.
// - `Suffix`: Text after the editable value.
// - `Actions`: Trailing controls.
// - `Colors`: Inherited text colors.
// - `Theme`: Semantic field colors.
// ## Returns
// A row that gives remaining width to the editor.
public function WithAdornments of TMsg(
  Field: Edit.Field of TMsg; Prefix: string; Suffix: string; Actions: array of E.Element of TMsg;
  Colors: T.Style; Theme: Th.Theme
): E.Element of TMsg;
  function Affix(Value: string): E.Element of TMsg;
  begin
    const Back: int := Colors.Background ?? Theme.Text.Background ?? 0;
    return (E.Element of TMsg).Decorated(
      (E.Element of TMsg).Label(G.SingleLine(Value)),
      new T.Style(Th.Rgb(Theme.Colors.TextMuted, Back), Back)
    );
  end function;
begin
  const Items: C.List of E.Element of TMsg := new C.List of E.Element of TMsg();
  if Prefix <> '' then
    Items.Add(Affix(Prefix));
  end if;

  Items.Add(
    (E.Element of TMsg).Sized(
      (E.Element of TMsg).TextField(Field),
      new E.Flex(Minimum := 1, Grow := 1)
    )
  );
  if Suffix <> '' then
    Items.Add(Affix(Suffix));
  end if;

  Items.AddRange(Actions);
  return (E.Element of TMsg).Stack(Items.ToArray(), true, new E.Flow());
end function;

// Paints the displayed slice and binds it to its cursor and model callbacks.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Field`: Current field.
// - `Previous`: Earlier presented layout.
// - `Area`: Allocated cells.
// - `Clip`: Visible cells.
// - `Scope`: Owning input scope.
// - `FocusReturn`: Fallback focus destination.
// - `Colors`: Inherited text colors.
// - `Theme`: Semantic field colors.
// - `Operations`: Paint operations for this frame.
// ## Returns
// Interactive bounds of the input row.
public function Arrange of TMsg(
  Field: Edit.Field of TMsg; Previous: (A.Layout of TMsg)?; Area: F.Rect;
  Clip: F.Rect; Scope: string; FocusReturn: string; Colors: T.Style; Theme: Th.Theme;
  Operations: C.List of D.Operation
): A.Control of TMsg;
begin
  const Before: (A.Control of TMsg)? := A.FindControl of TMsg(Previous, Field.Id);
  var Old: Edit.Cursor? := null;
  if Before <> null then
    case Before.Action of
      when A.Binding.Edit(_, const Cursor: Edit.Tracking, _, _):
        Old := Cursor.Read(Field.Value);
      else
    end case;
  end if;
  const Pad: int := if Area.Width >= 3 then
    1
  else
    0
  end if;
  const X: int := Area.X + Pad;
  const Width: int := Area.Width - 2 * Pad;
  const Position: Edit.Cursor := Edit.Fit(Field.Value, Old, Width);
  const Surface: int := Th.Rgb(Theme.Colors.SurfaceMuted, Colors.Background ?? 0);
  const Muted: bool := Field.Value = '' or not Field.Settings.Enabled;
  const Ink: int := Th.Rgb(
    if Muted then
      Theme.Colors.TextMuted
    else
      Theme.Colors.Foreground
    end if, Surface
  );
  const Style: T.Style := new T.Style(Ink, Surface);
  const Row: F.Rect := F.Intersect(new F.Rect(Area.X, Area.Y, Area.Width, 1), Clip);
  D.Fill(Operations, Row, Style);
  const Visible: string := if Field.Value = '' then
    G.SingleLine(Field.Settings.Placeholder)
  else
    Field.Value.Substring(Position.Start)
  end if;
  Operations.Add(new D.Operation(Visible, new F.Rect(X, Area.Y, Width, 1), Row, Style, false));
  const Caret: int := X + G.Measure(
    Field.Value.Substring(Position.Start, Position.Offset - Position.Start)
  );
  return new A.Control of TMsg(
    Field.Id, if Field.Settings.Label <> '' then
      Field.Settings.Label
    else
      Field.Id
    end if,
    Field.Role, Field.Value, Row, Scope, FocusReturn, Field.Settings.Enabled,
    (A.Binding of TMsg).Edit(Field, Edit.Track(Position), X, Caret), S.ButtonVariant.Default
  );
end function;

end unit;
