// [Documentation](../../../../../docs/ui/tui/navigation/pagination.md)

unit Fpas.Ui.Tui.Internal.Widgets.Navigation.Pagination;

uses Fpas.Ui.Internal.Navigation.PaginationPages as Pages;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Tui.Internal.Controls.Activation as Actions;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Layout.Measurement as M;
uses Fpas.Ui.Tui.Internal.Layout.Scene as A;
uses Fpas.Ui.Tui.Internal.Rendering.Buttons as Buttons;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.Rendering.Glyphs as G;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Widgets.Developer.Terminal as Terminal;

uses System.Collections.Generic as C;
uses System.Globalization as Culture;

const SideWidth: int := 3;
const Gap: int := 1;

function Number(Value: int): string;
begin
  return Value.ToString(Culture.CultureInfo.InvariantCulture);
end function;

type Choice of TMsg = record implements Actions.IActivatable of TMsg
  public Notify: function(int): TMsg;
  public Target: int;
  public Current: int;

  public function Activate(): Actions.Result of TMsg;
  begin
    return if self.Target = self.Current then
      (Actions.Result of TMsg).NoAction
    else
      (Actions.Result of TMsg).Send(self.Notify(self.Target))
    end if;
  end function;
end record;

// Presents the pager using its own allocated width and registers each action.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Pager`: Current page and input bindings.
// - `Area`: Full allocation.
// - `Clip`: Visible portion of the allocation.
// - `Style`: Inherited terminal colors.
// - `Theme`: Active terminal palette.
// - `Scope`: Owning input scope.
// - `Parent`: Enclosing fallback focus identity.
// - `ScrollId`: Enclosing scroll viewport, if any.
// - `Operations`: Frame paint operations.
// - `Navigation`: Keyboard destinations, including vertically clipped controls.
// - `Stops`: Tab traversal order.
// - `Register`: Registers a visible control.
public procedure Arrange of TMsg(
  Pager: E.PagerView of TMsg;
  Area: F.Rect;
  Clip: F.Rect;
  Style: Terminal.Style;
  Theme: Th.Theme;
  Scope: string;
  Parent: string;
  ScrollId: string;
  Operations: C.List of D.Operation;
  Navigation: C.List of A.NavigationStop;
  Stops: C.List of A.TabStop;
  Register: procedure(A.Control of TMsg)
);
  procedure Text(Value: string);
  begin
    const Width: int := G.Measure(Value);
    if Clip.Height > 0 and Width > 0 then
      const Bounds: F.Rect := new F.Rect(Column, Area.Y, Width, 1);
      Operations.Add(new D.Operation(Value, Bounds, Clip, Style, false));
    end if;

    Column := Column + Width;
  end procedure;

  procedure Button(
    Id: string;
    Caption: string;
    Label: string;
    Target: int;
    Width: int;
    Available: bool;
    Role: string;
    Value: string;
    Variant: S.ButtonVariant;
    Fallback: string
  );
  begin
    const Bounds: F.Rect := new F.Rect(Column, Area.Y, Width, 1);
    const Hit: F.Rect := F.Intersect(Bounds, Clip);
    const Enabled: bool := Pager.Enabled and Available;
    Column := Column + Width;
    if Hit.Width > 0 and Hit.Height > 0 then
      Buttons.Paint(
        Operations, Bounds, Hit, Style, Theme, Caption, true, Variant, Enabled,
        Padding := if Width >= 3 then
          1
        else
          0
        end if, Center := true, Joined := true
      );
    end if;

    A.RegisterRowAction of TMsg(
      new A.Control of TMsg(
        Id, Label, Role, Value, Bounds, Scope, Fallback, Enabled,
        (A.Binding of TMsg).Invoke(new Choice of TMsg(Pager.Change, Target, Pager.Page)),
        Variant, ButtonStyle := true
      ), Clip, ScrollId, Navigation, Stops, Register
    );
  end procedure;

  procedure Previous(Width: int);
  begin
    Button(
      PreviousId, '‹', 'Previous page', Pager.Page - 1, Width, Pager.Page > 0,
      'page-arrow', '', S.ButtonVariant.Secondary, NextId
    );
  end procedure;

  procedure Next(Width: int);
  begin
    Button(
      NextId, '›', 'Next page', Pager.Page + 1, Width, Pager.Page < Last,
      'page-arrow', '', S.ButtonVariant.Secondary, PreviousId
    );
  end procedure;
begin
  const Last: int := Pager.Count - 1;
  const PreviousId: string := Pager.Id + '/previous';
  const NextId: string := Pager.Id + '/next';
  var Column: int := Area.X;
  const IndexText: string := Number(Pager.Page + 1);
  const CountText: string := Number(Pager.Count);
  const Status: string := 'Page ' + IndexText + ' of ' + CountText;
  if Clip.Height > 0 then
    Register(
      new A.Control of TMsg(
        Pager.Id, 'Pagination', 'pagination', Number(Pager.Page), F.Intersect(
          new F.Rect(Area.X, Area.Y, Area.Width, 1), Clip
        ), Scope, Parent, false,
        (A.Binding of TMsg).Invoke(new Choice of TMsg(Pager.Change, Pager.Page, Pager.Page)),
        S.ButtonVariant.Default
      )
    );
  end if;

  if Area.Width >= M.PagerWidth(Pager.Count) then
    const Width: int := CountText.Length + 2;
    const Fallback: string := if Pager.Page < Last then
      NextId
    else
      PreviousId
    end if;
    Previous(SideWidth);
    var Prior: int := -1;
    for Index: int in Pages.Numbered(Pager.Page, Pager.Count) do
      Column := Column + Gap;
      if Index > Prior + 1 then
        Text('…');
        Column := Column + Gap;
      end if;
      const Caption: string := Number(Index + 1);
      const Current: bool := Index = Pager.Page;
      Button(
        Pages.PageId(Pager.Id, Index), Caption, Caption, Index, Width, true,
        'page', if Current then
          'true'
        else
          'false'
        end if,
        if Current then
          S.ButtonVariant.Active
        else
          S.ButtonVariant.Ghost
        end if, Fallback
      );
      Prior := Index;
    end for;

    Column := Column + Gap;
    Next(SideWidth);
    return;
  end if;

  if Area.Width = 1 then
    if Pager.Page < Last then
      Next(1);
    else
      Previous(1);
    end if;

    return;
  end if;

  const Short: string := IndexText + '/' + CountText;
  const CanPad: bool := Area.Width >= 2 * SideWidth + 2 * Gap + Status.Length;
  const ArrowWidth: int := if CanPad then
    SideWidth
  else
    1
  end if;
  Previous(ArrowWidth);
  const Center: int := Area.Width - 2 * ArrowWidth;
  if CanPad then
    Column := Column + Gap;
    Text(Status);
    Column := Column + Gap;
  elsif Status.Length <= Center then
    Text(Status);
  elsif Short.Length <= Center then
    Text(Short);
  end if;

  Next(ArrowWidth);
end procedure;

end unit;
