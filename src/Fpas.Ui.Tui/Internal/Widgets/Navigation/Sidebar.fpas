// [Documentation](../../../../../docs/ui/tui/navigation/sidebar.md)

unit Fpas.Ui.Tui.Internal.Widgets.Navigation.Sidebar;

uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Tui.Internal.Controls.Activation as A;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Widgets.Navigation.Navigation as N;

uses System.Collections.Generic as C;

// Lowers the sidebar into terminal headings and direct actions.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Sidebar identity.
// - `Sections`: Headings and destinations in focus order.
// - `Active`: Model-owned active key.
// - `Enabled`: Input permission for the sidebar.
// ## Returns
// A stack of full-width terminal destinations.
public function Lower of TMsg(Id: string; Sections: array of N.Section of TMsg; Active: string?; Enabled: bool): E.Element of TMsg;
begin
  const Rows: C.List of E.Element of TMsg := new C.List of E.Element of TMsg();
  for Section: N.Section of TMsg in Sections do
    if Section.Title <> '' then
      Rows.Add((E.Element of TMsg).Label(' ' + Section.Title));
    end if;

    for Item: N.Item of TMsg in Section.Items do
      const Selected: bool := Active = Item.Key;
      const Caption: string := if Item.Badge = '' then
        Item.Label
      else
        Item.Label + ' [' + Item.Badge + ']'
      end if;
      Rows.Add(
        (E.Element of TMsg).Action(
          N.ItemId(Id, Item.Key), new A.Direct of TMsg(Item.Message), Enabled and Item.Enabled,
          new E.ActionView(
            Caption, Role := 'navigation', Value := if Selected then
              'true'
            else
              'false'
            end if,
            Variant := if Selected then
              S.ButtonVariant.Secondary
            else
              S.ButtonVariant.Ghost
            end if,
            ArrowFocus := false, NavigationGroup := Id
          )
        )
      );
    end for;
  end for;

  return (E.Element of TMsg).Stack(Rows.ToArray(), false, new E.Flow(Align := L.Alignment.Stretch));
end function;

end unit;
