// [Documentation](../../../../../docs/ui/tui/navigation/tabs.md)

unit Fpas.Ui.Tui.Internal.Widgets.Navigation.Tabs;

uses Fpas.Ui.Tui.Internal.Controls.Activation as A;
uses Fpas.Ui.Tui.Internal.Controls.ChoiceStrip as Strip;
uses Fpas.Ui.Tui.Internal.View.Tree as E;
uses Fpas.Ui.Widgets.Navigation.Tabs as T;

uses System.Collections.Generic as C;

// Prepares tabs with a model-owned selection for the terminal.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable strip identity.
// - `Items`: Validated tabs in model order.
// - `Selected`: Model-owned selected index.
// - `Change`: Maps a new selection to a message.
// - `Settings`: Shared appearance, width and input options.
// ## Returns
// A horizontal strip of tabs.
public function Lower of TMsg(
  Id: string; Items: array of T.Item; Selected: int; Change: function(int): TMsg; Settings: T.Options
): E.Element of TMsg;
  function Activate(Index: int): A.Result of TMsg;
  begin
    return if Index = Selected then
      (A.Result of TMsg).NoAction
    else
      (A.Result of TMsg).Send(Change(Index))
    end if;
  end function;
begin
  const Choices: C.List of E.ChoiceItem := new C.List of E.ChoiceItem(Items.Length);
  for Index: int := 0 to Items.Length - 1 do
    const Label: string := Items[Index].Label;
    Choices.Add(new E.ChoiceItem(Label, Label, Index = Selected));
  end for;

  return Strip.Lower of TMsg(
    Id, Choices.ToArray(), Selected, Activate,
    new E.ChoiceStripOptions(
      'tab', Settings.Enabled, FullWidth := Settings.FullWidth,
      Underline := Settings.Appearance = T.Variant.Underline
    )
  );
end function;

end unit;
