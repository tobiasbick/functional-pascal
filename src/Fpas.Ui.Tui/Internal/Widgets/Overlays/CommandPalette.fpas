// [Documentation](../../../../../docs/ui/tui/overlays/command-palette.md)

unit Fpas.Ui.Tui.Internal.Widgets.Overlays.CommandPalette;

uses Fpas.Ui.Tui.Internal.Controls.Activation as Actions;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.Layout.Scene as A;
uses Fpas.Ui.Tui.Internal.Rendering.Drawing as D;
uses Fpas.Ui.Tui.Internal.Rendering.Themes as Th;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.AnchoredPopup as Popup;
uses Fpas.Ui.Tui.Internal.Widgets.Overlays.PopupState as State;
uses Fpas.Ui.Widgets.Overlays.CommandPalettes as P;

uses System.Collections.Generic as C;
uses System.Globalization as Global;

// Presents the searchable palette in a centered modal scope.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable palette identity.
// - `Commands`: Searchable commands in model order.
// - `Change`: Maps a proposed visibility change to a message.
// - `UseShortcut`: Ctrl+K also dismisses the open palette.
// - `PopupState`: Input cursor and dispatcher.
// - `Screen`: Available cells.
// - `Theme`: Terminal palette.
// - `Operations`: Ordered paint operations.
// - `Controls`: Current visible controls.
// ## Returns
// The dialog input scope.
public function Draw of TMsg(
  Id: string; Commands: array of P.Command of TMsg; Change: function(bool): TMsg; UseShortcut: bool;
  PopupState: State.State of TMsg; Screen: F.Rect; Theme: Th.Theme;
  Operations: C.List of D.Operation; Controls: C.List of A.Control of TMsg
): A.Scope of TMsg;
begin
  if PopupState.Read().Id <> Id then
    PopupState.Write(new State.Cursor(Id));
  end if;
  const Rows: C.List of Popup.Row of TMsg := new C.List of Popup.Row of TMsg(Commands.Length);
  for Index: int := 0 to Commands.Length - 1 do
    const Command: P.Command of TMsg := Commands[Index];
    const Key: string := Id + '/command/' + Index.ToString(Global.CultureInfo.InvariantCulture);
    Rows.Add(
      (Popup.Row of TMsg).Choice(
        new Popup.Item of TMsg(
          Key,
          Command.Title,
          ' ' + Command.Title,
          'command',
          new Actions.Direct of TMsg(Command.Message),
          Hint := Command.Shortcut
        )
      )
    );
  end for;

  return Popup.Draw of TMsg(
    PopupState,
    new Popup.Content of TMsg(
      Rows.ToArray(),
      54,
      Searchable := true,
      Centered := true,
      ToggleShortcut := UseShortcut
    ),
    Screen,
    Screen,
    Theme,
    Operations,
    Controls,
    procedure() begin
      PopupState.Apply(Change(false));
    end procedure
  );
end function;

end unit;
