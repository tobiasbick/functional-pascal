// [Documentation](../../../../../docs/ui/tui/host.md#popup-input)

unit Fpas.Ui.Tui.Internal.Widgets.Overlays.PopupHost;

uses
  Fpas.Ui.Tui.Internal.Widgets.Overlays.PopupState as P, Fpas.Ui.Tui.Internal.Widgets.Overlays.AnchoredPopup as Popup,
  Fpas.Ui.Tui.Internal.Widgets.Overlays.Dropdown as Menu, Fpas.Ui.Tui.Internal.Widgets.Inputs.Select as Select,
  Fpas.Ui.Tui.Internal.Widgets.Collections.FilterBar as Filters,
  Fpas.Ui.Tui.Internal.Layout.Scene as A, Fpas.Ui.Tui.Internal.Layout.Flexible as F,
  Fpas.Ui.Tui.Internal.Rendering.Drawing as D, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, System.Collections.Generic as C;

// Presents an open popup while its trigger is visible in the current scope.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `State`: Session-local state.
// - `Parent`: Current underlying modal, if any.
// - `Screen`: Terminal bounds.
// - `Theme`: Active terminal palette.
// - `Operations`: Ordered paint operations.
// - `Controls`: Controls of the current frame.
// ## Returns
// Open popup scope, or null when there is no eligible trigger.
public function Present<TMsg>(
  State: P.State<TMsg>; Parent: A.Scope<TMsg>?; Screen: F.Rect; Theme: Th.Theme;
  Operations: C.List<D.Operation>; Controls: C.List<A.Control<TMsg>>
): A.Scope<TMsg>?;
begin
  const Id: string := State.Read().Id;
  if Id = '' then
    return null;
  end if;
  const Scope: string := if Parent = null then
    ''
  else
    Parent.Id
  end if;
  const Owner: A.Control<TMsg>? := Controls.Find(
    function(Control: A.Control<TMsg>): bool => Control.Id = Id
  );
  if Owner <> null and Owner.Enabled and Owner.Scope = Scope then
    case A.Activatable<TMsg>(Owner.Action) of
      when is Select.Trigger<TMsg> as Field:
        return Popup.Draw<TMsg>(
          State,
          Select.Content<TMsg>(Field, Owner.Bounds),
          Owner.Bounds,
          Screen,
          Theme,
          Operations,
          Controls
        );
      when is Menu.Trigger<TMsg> as Dropdown:
        return Popup.Draw<TMsg>(
          State,
          Menu.Content<TMsg>(Dropdown, Owner.Bounds, Screen.Width),
          Owner.Bounds,
          Screen,
          Theme,
          Operations,
          Controls
        );
      when is Filters.Trigger<TMsg> as Filter:
        return Popup.Draw<TMsg>(
          State,
          Filters.Content<TMsg>(Filter),
          Owner.Bounds,
          Screen,
          Theme,
          Operations,
          Controls
        );
      else
    end case;
  end if;

  State.Write(new P.Cursor());
  return null;
end function;

end unit;
