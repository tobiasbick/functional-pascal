unit Fpas.Ui.Tui.Internal.Widgets.SplitButton;

uses Fpas.Ui.Menus as M, Fpas.Ui.Tui.Internal.Widgets.Menu as Popup, Fpas.Ui.SplitButtons as Split, Fpas.Ui.Buttons as B, Fpas.Ui.Styles as S, Fpas.Ui.Terminal as T, Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Widgets.Button as Button, Fpas.Ui.Tui.Internal.Widgets.ButtonGroup as Group, Fpas.Ui.Tui.Internal.Rendering.Themes as Th, System.Collections.Generic as C;

// Lowers the two focus stops and their host-owned popup.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Main action identity.
// - `Label`: Main caption.
// - `Message`: Main action message.
// - `Items`: Ordered keyed menu actions.
// - `Settings`: Shared appearance and input options.
// - `Menus`: Session's popup tracker.
// - `Theme`: Resolved terminal theme.
// - `Style`: Inherited cell colors.
// ## Returns
// Joined button halves and an anchored popup when open.
public function Lower<TMsg>(
  Id: string; Label: string; Message: TMsg; Items: array of Split.Item<TMsg>;
  Settings: Split.Options; Menus: Popup.State; Theme: Th.Theme; Style: T.Style
): E.Element<TMsg>;
begin
  const Menu: string := Split.MenuId(Id);
  if not Settings.Enabled and Menus.Id() = Menu then
    Menus.Close();
  end if;
  const Variant: S.ButtonVariant := if Settings.Variant =
    S.ButtonVariant.Default
  then
    S.ButtonVariant.Primary
  else
    Settings.Variant
  end if;
  const Main: E.Element<TMsg> := Button.Lower<TMsg>(
    Id, Label, Message,
    new B.Options(
      Variant := Variant, ControlSize := Settings.ControlSize,
      Icon := Settings.Icon, TerminalIcon := Settings.TerminalIcon, Enabled := Settings.Enabled
    ), 'split-button'
  );
  const Arrow: E.Element<TMsg> := E.Element<TMsg>.Action(
    Menu, new Popup.Trigger<TMsg>(Menu, Menus), Settings.Enabled,
    new E.ActionView(
      '⌄', Name := 'More options', Role := 'split-menu',
      Value := if Menus.Id() = Menu then
        'true'
      else
        'false'
      end if,
      Variant := Variant, ArrowFocus := false,
      Height := if Settings.ControlSize = B.Size.Large then
        2
      else
        1
      end if,
      Hint := 'More options'
    )
  );
  const Joined: E.Element<TMsg> := Group.Lower<TMsg>([Main, Arrow], Theme, Style);
  if Menus.Id() <> Menu then
    return Joined;
  end if;

  const Entries: C.List<M.Entry<TMsg>> := new C.List<M.Entry<TMsg>>();
  for Item: Split.Item<TMsg> in Items do
    Entries.Add(
      M.Entry<TMsg>.Action(
        new M.Item<TMsg>(Item.Key, Item.Label, Item.Message, Item.Icon, Item.TerminalIcon)
      )
    );
  end for;

  return E.Element<TMsg>.PopupAnchor(
    Joined, Menu, Popup.Rows<TMsg>(Menu, Entries.ToArray(), Menus, Theme),
    Split.ItemId(Id, Items[0].Key), Menus.Close, M.Placement.BottomEnd, 0
  );
end function;

end unit;
