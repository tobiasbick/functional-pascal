unit Fpas.Ui.Tui.Internal.Widgets.ThemeSwitcher;

uses
  Fpas.Ui.ThemeSwitchers as S, Fpas.Ui.Internal.ThemeSwitchers as Parts,
  Fpas.Ui.SegmentedControls as Segments, Fpas.Ui.Buttons as B,
  Fpas.Ui.Tui.Internal.Widgets.SegmentedControl as Widget,
  Fpas.Ui.Tui.Internal.View.Tree as E, Fpas.Ui.Tui.Internal.Rendering.Themes as Th,
  Fpas.Ui.Terminal as T, System.Collections.Generic as Lists;

// Composes the appearance selector from the shared terminal segment primitive.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Group identity.
// - `Selected`: Model-owned appearance choice.
// - `OnChange`: Maps a different appearance to a message.
// - `Settings`: System availability and input permission.
// - `Theme`: Current palette.
// - `Colors`: Inherited terminal colors.
// ## Returns
// Two or three named choices with CUI-compatible input behavior.
public function Lower<TMsg>(
  Id: string; Selected: S.Selection; OnChange: function(S.Selection): TMsg;
  Settings: S.Options; Theme: Th.Theme; Colors: T.Style
): E.Element<TMsg>;
begin
  const Items: Lists.List<Segments.Item> := new Lists.List<Segments.Item>();
  const Ids: Lists.List<string> := new Lists.List<string>();
  for Index: int := 0 to (if Settings.WithSystem then 2 else 1 end if) do
    const Choice: S.Selection := cast<S.Selection>(Index);
    Items.Add(new Segments.Item(Parts.Label(Choice)));
    Ids.Add(S.ItemId(Id, Choice));
  end for;

  return Widget.Lower<TMsg>(
    Id, Items.ToArray(), cast<int>(Selected),
    function(Index: int): TMsg => OnChange(cast<S.Selection>(Index)),
    new Segments.Options(ControlSize := B.Size.Small, Enabled := Settings.Enabled), Theme, Colors,
    Ids.ToArray(), 'theme-choice'
  );
end function;
end unit;
