const AmberTheme: Theme := Create(
  new Swatches(
    Canvas := $1B1209, Panel := $2A1C0E, Text := $FFE2B3, Heading := $FFF0D4,
    Muted := $CAA66E, Accent := $FFB84D, AccentText := $2A1704, Hover := $4B3219,
    Border := $936939, Field := $332311, FocusedField := $493218,
    Selection := $593A16, SelectionText := $FFDC91, Track := $906840,
    Secondary := $3C2A17, Error := $FFAAA0
  )
);

public function Light(): Theme;
begin
  return LightTheme;
end function;

public function Dark(): Theme;
begin
  return DarkTheme;
end function;

public function Green(): Theme;
begin
  return GreenTheme;
end function;

public function Blue(): Theme;
begin
  return BlueTheme;
end function;

// Provides warm amber accents on dark brown surfaces.
//
// ## Returns
// The built-in Amber palette with its widget and button styles.
public function Amber(): Theme;
begin
  return AmberTheme;
end function;
end unit;
