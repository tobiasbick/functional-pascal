unit Fpas.Ui.Tui.Themes;

uses Fpas.Ui.Terminal as T;

// Terminal colors for one semantic button variant.
public type ButtonAppearance = record
  // Colors without focus or hover.
  public Normal: T.Style;
  // Keyboard-focus colors.
  public Focused: T.Style;
  // Pointer-hover colors.
  public Hovered: T.Style;
end record;

// Semantic button variants and disabled colors.
public type ButtonStyles = record
  // Supporting action colors.
  public Secondary: ButtonAppearance;
  // Main action colors.
  public Primary: ButtonAppearance;
  // Selected action colors.
  public Active: ButtonAppearance;
  // Discard-action colors.
  public Destructive: ButtonAppearance;
  // Disabled control colors.
  public Disabled: T.Style;
end record;

// Terminal border, editor, selection and progress colors.
public type WidgetStyles = record
  // 24-bit border foreground.
  public BorderColor: int;
  // Editor body colors.
  public Field: T.Style;
  // Focused editor colors.
  public FocusedField: T.Style;
  // Selected row colors.
  public Selected: T.Style;
  // 24-bit filled progress foreground.
  public ProgressFillColor: int;
  // 24-bit empty progress foreground.
  public ProgressTrackColor: int;
end record;

// Resolves shared style roles and terminal interaction colors.
public type Theme = record
  // Default text and surface colors.
  public Text: T.Style := new T.Style();
  // Default keyboard-focus colors.
  public Focus: T.Style := new T.Style(Foreground := 16777215, Background := 2445729);
  // Default pointer-hover colors.
  public Hover: T.Style := new T.Style(Foreground := 16777215, Background := 3355443);
  // Caret and selection colors.
  public Caret: T.Style := new T.Style(Foreground := 0, Background := 16777215);
  // Optional terminal widget overrides.
  public Widgets: WidgetStyles? := null;
  // 24-bit placeholder foreground; -1 inherits the field color.
  public PlaceholderColor: int := -1;
  // Optional semantic button overrides.
  public Buttons: ButtonStyles? := null;
  // Heading role colors.
  public Heading: T.Style := new T.Style();
  // Panel role colors.
  public Panel: T.Style := new T.Style();
  // Muted role colors.
  public Muted: T.Style := new T.Style();
  // Main action colors.
  public Primary: T.Style := new T.Style();
  // Supporting action colors.
  public Secondary: T.Style := new T.Style();
  // Error role colors.
  public Error: T.Style := new T.Style();
end record;

type Swatches = record
  public Canvas: int;
  // Panel role colors.
  public Panel: int;
  // Default text and surface colors.
  public Text: int;
  // Heading role colors.
  public Heading: int;
  // Muted role colors.
  public Muted: int;
  public Accent: int;
  public AccentText: int;
  // Default pointer-hover colors.
  public Hover: int;
  public Border: int;
  // Editor body colors.
  public Field: int;
  // Focused editor colors.
  public FocusedField: int;
  public Selection: int;
  public SelectionText: int;
  public Track: int;
  // Supporting action colors.
  public Secondary: int;
  // Error role colors.
  public Error: int;
end record;

function Create(Colors: Swatches): Theme;
begin
  const Focus: T.Style := new T.Style(Colors.AccentText, Colors.Accent);
  const Hover: T.Style := new T.Style(Colors.Text, Colors.Hover);
  const Secondary: T.Style := new T.Style(Colors.Text, Colors.Secondary);
  const Selected: T.Style := new T.Style(Colors.SelectionText, Colors.Selection);
  const Error: T.Style := new T.Style(Colors.Error, Colors.Canvas);
  const Theme: Theme := new Theme(
    Text := new T.Style(Colors.Text, Colors.Canvas),
    Focus := Focus,
    Hover := Hover,
    Caret := Focus,
    Widgets := new WidgetStyles(
      BorderColor := Colors.Border,
      Field := new T.Style(Colors.Text, Colors.Field),
      FocusedField := new T.Style(Colors.Text, Colors.FocusedField),
      Selected := Selected,
      ProgressFillColor := Colors.Accent,
      ProgressTrackColor := Colors.Track
    ),
    PlaceholderColor := Colors.Muted,
    Buttons := new ButtonStyles(
      Secondary := new ButtonAppearance(Secondary, Focus, Hover),
      Primary := new ButtonAppearance(
        Focus,
        new T.Style(Colors.Accent, Colors.AccentText),
        new T.Style(Colors.Accent, Colors.Hover)
      ),
      Active := new ButtonAppearance(
        Selected,
        new T.Style(Colors.Selection, Colors.SelectionText),
        new T.Style(Colors.SelectionText, Colors.Hover)
      ),
      Destructive := new ButtonAppearance(
        new T.Style(Colors.Canvas, Colors.Error), Error, new T.Style(Colors.Error, Colors.Hover)
      ),
      Disabled := new T.Style(Colors.Muted, Colors.Panel)
    )
  );
  return Theme with
    Heading := new T.Style(Colors.Heading, Colors.Canvas);
    Panel := new T.Style(Colors.Text, Colors.Panel);
    Muted := new T.Style(Colors.Muted, Colors.Canvas);
    Primary := Focus;
    Secondary := Secondary;
    Error := Error;
  end with;
end function;

const LightTheme: Theme := Create(
  new Swatches(
    Canvas := $F3F6FA, Panel := $FFFFFF, Text := $213247, Heading := $142134,
    Muted := $53657A, Accent := $176854, AccentText := $FFFFFF, Hover := $DBE8F2,
    Border := $71849A, Field := $EAF0F6, FocusedField := $DCEDE7,
    Selection := $CFE8DE, SelectionText := $164C3F, Track := $788DA2,
    Secondary := $E3EBF4, Error := $A62B2B
  )
);

