unit Fpas.Ui.BarCharts;

uses Fpas.Ui.Elements as E, Fpas.Ui.Charts as C;

// Draws CUI's native grouped or stacked bar chart.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable chart identity.
// - `Series`: Named finite samples.
// - `Settings`: Native chart presentation.
// ## Returns
// A graphical element.
public function BarChart<TMsg>(Id: string; Series: array of C.Series; Settings: C.Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.BarChart(Id, Series, Settings ?? new C.Options());
end function;

end unit;
