unit Fpas.Ui.Blames;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Data for the native Blame widget.
public type Revision = record
  // Hash supplied to CUI.
  public Hash: string;
  // Author supplied to CUI.
  public Author: string;
  // Summary supplied to CUI.
  public Summary: string?;
  // Time supplied to CUI.
  public Time: long;
end record;

// Action or changed value reported by the native widget.
public type Event = record
  // Clicked zero-based index, or minus one.
  public Clicked: int;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Height supplied to CUI.
  public Height: float := 0.0F;
  // Language supplied to CUI.
  public Language: string := '';
  // Now supplied to CUI.
  public Now: long := 0L;
  // First displayed source line number.
  public FirstLine: int := 0;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native Blame widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Lines`: Model-owned lines data.
// - `LineCommits`: Model-owned linecommits data.
// - `Revisions`: Model-owned revisions data.
// - `Changed`: Maps an action or edit to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function Blame<TMsg>(Id: string; Lines: array of string; LineCommits: array of int; Revisions: array of Revision; Changed: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Blame(
    Id,
    Lines,
    LineCommits,
    Revisions,
    Changed,
    Settings ?? new Options()
  );
end function;

end unit;
