unit Fpas.Ui.ButtonGroups;

uses Fpas.Ui.Elements as E;

// Joins buttons under one outline. Each member retains its identity and message.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Children`: Direct buttons and icon buttons in focus order.
// ## Returns
// A horizontal button group.
public function ButtonGroup<TMsg>(params Children: array of E.Element<TMsg>): E.Element<TMsg>;
requires Children <> null;
begin
  return E.Element<TMsg>.ButtonGroup(Children);
end function;
end unit;
