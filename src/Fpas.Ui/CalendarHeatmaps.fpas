unit Fpas.Ui.CalendarHeatmaps;

uses Fpas.Ui.Elements as E, Fpas.Ui.Charts as C, Fpas.Ui.Layout as L, System as Sys;

// Native calendar heatmap settings.
public type Options = record
  // Logical day size; zero uses CUI's default.
  public CellSize: float := 0.0F;
  // Top color; automatic uses the native accent ramp.
  public Color: C.Color := C.Color.Automatic;
  // Safe numeric formatting; null uses native automatic formatting.
  public Format: C.ValueFormat? := null;
  // Literal unit; empty omits the total caption.
  public Unit: string := '';
  // Allow native pointer interaction.
  public Enabled: bool := true;
end record;

// Draws CUI's native calendar-heatmap with native layout, hover and animation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity.
// - `Start`: Date of the first sample.
// - `Values`: One finite sample per day; nonpositive amounts leave empty squares.
// - `Settings`: Native presentation.
// - `OnActivate`: Optional clicked date callback; hover remains native.
// ## Returns
// A graphical element.
public function CalendarHeatmap<TMsg>(Id: string; Start: Sys.DateOnly; Values: array of float; Settings: Options? := null; OnActivate: Sys.Func<Sys.DateOnly, TMsg>? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.CalendarHeatmap(Id, Start, Values, Settings ?? new Options(), OnActivate);
end function;

end unit;
