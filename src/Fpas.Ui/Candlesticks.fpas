unit Fpas.Ui.Candlesticks;

uses Fpas.Ui.Elements as E, Fpas.Ui.Charts as C, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, System as Sys;

// One native OHLC period.
public type Candle = record
  // Opening price.
  public Open: float;
  // Highest price, at least Open and Close.
  public High: float;
  // Lowest price, at most Open and Close.
  public Low: float;
  // Closing price.
  public Close: float;
  // Nonnegative volume; zero means none.
  public Volume: float := 0.0F;
end record;

// Native candlestick presentation.
public type Options = record
  // Preferred logical width.
  public Width: L.Extent := L.Extent.Fill;
  // Logical height; zero selects CUI's default.
  public Height: float := 0.0F;
  // Empty or one literal time caption per candle.
  public Labels: array of string := [];
  // Safe price format; null keeps CUI's two decimal places.
  public Format: C.ValueFormat? := null;
  // Up to four native line overlays. NaN samples are gaps.
  public Overlays: array of C.Series := [];
  // Show native volume bars when any period has volume.
  public Volume: bool := true;
  // Draw OHLC bars instead of candle bodies.
  public Ohlc: bool := false;
  // Optional rising-period color.
  public Up: C.Color := C.Color.Automatic;
  // Optional falling-period color.
  public Down: C.Color := C.Color.Automatic;
  // Allow native keyboard, wheel and pointer input.
  public Enabled: bool := true;
end record;

// Draws CUI's native candlestick.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity.
// - `Candles`: Finite OHLC periods with nonnegative volume.
// - `Settings`: Native presentation.
// - `OnCursorChange`: Optional crosshair-index change callback; minus one clears inspection.
// ## Returns
// A graphical element.
public function Candlestick<TMsg>(Id: string; Candles: array of Candle; Settings: Options? := null; OnCursorChange: Sys.Func<int, TMsg>? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Candlestick(Id, Candles, Settings ?? new Options(), OnCursorChange);
end function;

end unit;
