unit Fpas.Ui.Checkboxes;

uses Fpas.Ui.Elements as E;

// Creates a model-controlled checkbox for the graphical profile.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Label`: Literal caption for the interactive row.
// - `Checked`: Current model-owned value.
// - `OnChange`: Maps a changed value to an application message.
// - `Description`: Optional secondary text below the caption.
// - `Enabled`: Whether the row accepts input.
// - `Indeterminate`: Draw a dash in place of the check mark while checked.
// - `HideLabel`: Draw only the checkbox while retaining its accessible label.
// ## Returns
// The graphical control that proposes changes to the model.
public function Checkbox<TMsg>(
  Id: string; Label: string; Checked: bool; OnChange: function(bool): TMsg;
  Description: string := ''; Enabled: bool := true; Indeterminate: bool := false; HideLabel: bool := false
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.CheckboxAction(
    Id,
    Label,
    Checked,
    OnChange,
    Description,
    Enabled,
    Indeterminate,
    HideLabel
  );
end function;

end unit;
