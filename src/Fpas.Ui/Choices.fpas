unit Fpas.Ui.Choices;

uses Fpas.Ui.Layout as Layout;

// One action in a list.
//
// ## Type parameters
// - `TMsg`: The application message type.
public type ListItem<TMsg> = record
  // The stable key unique within this list.
  public Key: string;
  // The visible label.
  public Text: string;
  // The message sent on activation.
  public Message: TMsg;
  // Whether the model marks the item selected.
  public Selected: bool := false;
  // Whether the item accepts focus and activation.
  public Enabled: bool := true;
end record;

// One choice in a selection list.
public type SelectionItem = record
  // The stable key unique within this list.
  public Key: string;
  // The visible label.
  public Text: string;
  // Whether user input can select the item.
  public Enabled: bool := true;
  // Whether a selected item can emit an activation message.
  public CanActivate: bool := true;
end record;

// A tab that identifies a panel by key.
public type TabItem = record
  // The stable key unique within this tab set.
  public Key: string;
  // The visible label.
  public Label: string;
  // Whether the tab can be selected and its panel displayed.
  public Enabled: bool := true;
end record;

// A table header and its column sizing.
public type TableColumn = record
  // The visible header text.
  public Header: string;
  // The horizontal constraints and allocation weights.
  public Sizing: Layout.Flex := new Layout.Flex();
end record;

// A keyed row in a table.
public type TableRow = record
  // The stable key unique within this table.
  public Key: string;
  // The cells in column order.
  public Cells: array of string;
  // Whether user input can select the row.
  public Enabled: bool := true;
  // Whether a selected row can emit an activation message.
  public CanActivate: bool := true;
end record;
end unit;
