unit Fpas.Ui.CodeBlocks;

uses Fpas.Ui.Elements as E;

// Native code display options.
public type Options = record
  // Syntax language, such as c, python or sql. Empty uses plain text.
  public Language: string := '';
  // Optional title in the header.
  public Title: string := '';
  // Whether to show line numbers.
  public LineNumbers: bool := false;
  // First highlighted line, or zero.
  public HighlightFrom: int := 0;
  // Last highlighted line, or zero for a single line.
  public HighlightTo: int := 0;
  // Maximum code viewport height, or zero for no limit.
  public MaxHeight: float := 0.0F;
  // Font size, or zero for the native default.
  public Size: float := 0.0F;
  // Hide the title bar and copy button.
  public NoHeader: bool := false;
end record;

// Draws the native CUI code block.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Code`: Literal source text.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function CodeBlock<TMsg>(Id: string; Code: string; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.CodeBlock(Id, Code, Settings ?? new Options());
end function;

end unit;
