unit Fpas.Ui.CommandPalettes;

uses Fpas.Ui.Elements as E;

// A command searchable by title.
// ## Type parameters
// - `TMsg`: Application message type.
public type Command<TMsg> = record
  // Literal searchable caption.
  public Title: string;
  // Message sent when selected.
  public Message: TMsg;
  // Optional CUI glyph.
  public Icon: string := '';
  // Optional heading for a consecutive group.
  public Group: string := '';
  // Optional display-only shortcut hint.
  public Shortcut: string := '';
end record;

// Presents CUI’s searchable command palette over a base view.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable modal identity.
// - `Base`: View underneath the overlay.
// - `Open`: Model-owned visibility.
// - `Commands`: Commands in display order.
// - `OnOpenChange`: Maps a proposed visibility change to a message.
// - `UseShortcut`: Whether the native primary modifier plus K toggles the overlay.
// ## Returns
// The graphical element.
public function CommandPalette<TMsg>(Id: string; Base: E.Element<TMsg>; Open: bool; Commands: array of Command<TMsg>; OnOpenChange: function(bool): TMsg; UseShortcut: bool := true): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.CommandPalette(Id, Base, Open, Commands, OnOpenChange, UseShortcut);
end function;

end unit;
