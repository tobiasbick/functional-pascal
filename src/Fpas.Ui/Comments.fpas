unit Fpas.Ui.Comments;

uses Fpas.Ui.Elements as E;

// Model-owned like state.
public type Value = record
  // Current number of likes.
  public Likes: int := 0;
  // Whether the current user has liked the comment.
  public Liked: bool := false;
end record;

// Native comment action.
public type Event = variant
  // The like button proposed a new value.
  Like(Current: Value);
  // The reply button was activated.
  Reply;
end variant;

// Native comment options.
public type Options = record
  // Optional time caption.
  public Time: string := '';
  // Thread indentation level.
  public Depth: int := 0;
  // Show the edited marker beside the time.
  public Edited: bool := false;
  // Optional badge beside the author.
  public Badge: string := '';
  // Accept like and reply actions.
  public Enabled: bool := true;
end record;

// Draws a threaded comment and reports native actions.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Author`: Comment author.
// - `Text`: Comment body.
// - `Current`: Current like state.
// - `Change`: Maps the proposed like state or reply.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function Comment<TMsg>(Id: string; Author: string; Text: string; Current: Value; Change: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Comment(Id, Author, Text, Current, Change, Settings ?? new Options());
end function;

end unit;
