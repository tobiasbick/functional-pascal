unit Fpas.Ui.CommitGraphs;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Data for the native CommitGraph widget.
public type Commit = record
  // Hash supplied to CUI.
  public Hash: string;
  // Message supplied to CUI.
  public Message: string;
  // Author supplied to CUI.
  public Author: string?;
  // Date supplied to CUI.
  public Date: string?;
  // Refs supplied to CUI.
  public Refs: string?;
  // Parent row index, or minus one.
  public Parent: int;
  // Second parent row index, or minus one.
  public MergeParent: int;
end record;

// Action or changed value reported by the native widget.
public type Event = record
  // Selected zero-based index, or minus one.
  public Selection: int;
  // Clicked zero-based index, or minus one.
  public Clicked: int;
  // Activated zero-based index, or minus one.
  public Activated: int;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Height supplied to CUI.
  public Height: float := 0.0F;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native CommitGraph widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Commits`: Model-owned commits data.
// - `Selection`: Selected zero-based index, or minus one.
// - `Changed`: Maps an action or edit to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function CommitGraph<TMsg>(Id: string; Commits: array of Commit; Selection: int; Changed: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.CommitGraph(Id, Commits, Selection, Changed, Settings ?? new Options());
end function;

end unit;
