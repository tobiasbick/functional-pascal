type MappedCache<TChild, TParent> = record
  public Source: E.CacheEntry<TChild>;
  public Messages: function(TChild): TParent;
end record;

function Deferred<TChild, TParent>(
  Id: string;
  Resolve: function(E.CacheEntry<TChild>?): E.CacheEntry<TChild>;
  Messages: function(TChild): TParent
): E.Element<TParent>;
  function Build(Previous: E.CacheEntry<TParent>?): E.CacheEntry<TParent>;
  begin
    var Saved: MappedCache<TChild, TParent>? := null;
    if Previous <> null and Previous.Dependencies is MappedCache<TChild, TParent> then
      Saved := cast<MappedCache<TChild, TParent>>(Previous.Dependencies);
    end if;
    const Current: E.CacheEntry<TChild> := Resolve(
      if Saved = null then
        null
      else
        Saved.Source
      end if
    );
    if Previous <> null and Saved <> null and Sys.Object.ReferenceEquals(Saved.Source, Current)
      and Sys.Object.Equals(Saved.Messages, Messages)
    then
      return Previous;
    end if;

    return new E.CacheEntry<TParent>(
      new MappedCache<TChild, TParent>(Current, Messages),
      Map<TChild, TParent>(Current.Tree, Messages)
    );
  end function;
begin
  return E.Element<TParent>.Deferred(Id, Build);
end function;

// Embeds a child view by translating all messages, callbacks and lazy subviews.
//
// ## Type parameters
// - `TChild`: Child message type.
// - `TParent`: Parent message type.
// ## Parameters
// - `Value`: Child element tree; its options and control identities are retained.
// - `Messages`: Pure translation of child messages to parent messages.
// ## Returns
// A parent-message tree with unchanged layout, native widgets and callback timing.
// Cached subviews retain their child dependencies and rebuild if the mapper changes.
public function Map<TChild, TParent>(
  Value: E.Element<TChild>;
  Messages: function(TChild): TParent
): E.Element<TParent>;
  function KanbanColumns(Columns: array of Kanbans.Column<TChild>): array of Kanbans.Column<TParent>;
  begin
    const Result: Lists.List<Kanbans.Column<TParent>> := new Lists.List<Kanbans.Column<TParent>>();
    for Column: Kanbans.Column<TChild> in Columns do
      const CardViews: Lists.List<Kanbans.Card<TParent>> := new Lists.List<Kanbans.Card<TParent>>();
      for Card: Kanbans.Card<TChild> in Column.Cards do
        CardViews.Add(
          new Kanbans.Card<TParent>(
            Card.Key,
            Card.Title,
            Map<TChild, TParent>(Card.Content, Messages)
          )
        );
      end for;

      Result.Add(
        new Kanbans.Column<TParent>(
          Column.Title,
          CardViews.ToArray(),
          Column.Dot,
          Column.Limit,
          Column.Width
        )
      );
    end for;

    return Result.ToArray();
  end function;

  function MapDock(Entries: array of Docks.Entry<TChild>): array of Docks.Entry<TParent>;
  begin
    const Result: Lists.List<Docks.Entry<TParent>> := new Lists.List<Docks.Entry<TParent>>(
      Entries.Length
    );
    for Entry: Docks.Entry<TChild> in Entries do
      Result.Add(
        case Entry of
          when Docks.Entry.Separator: Docks.Entry<TParent>.Separator;
          when Docks.Entry.Item(
            const Icon: string, const Label: string, const Message: TChild,
            const Color: MotionColors.Color, const Running: bool, const Badge: int
          ): Docks.Entry<TParent>.Item(Icon, Label, Messages(Message), Color, Running, Badge);
        end case
      );
    end for;

    return Result.ToArray();
  end function;
  function Children(Values: array of E.Element<TChild>): array of E.Element<TParent>;
  begin
    const Result: Lists.List<E.Element<TParent>> := new Lists.List<E.Element<TParent>>();
    for Child: E.Element<TChild> in Values do
      Result.Add(Map<TChild, TParent>(Child, Messages));
    end for;

    return Result.ToArray();
  end function;
  function MapGridRow(Row: DataGrids.Row<TChild>): DataGrids.Row<TParent>;
  begin
    const Cells: Lists.List<DataGrids.Cell<TParent>> := new Lists.List<DataGrids.Cell<TParent>>(
      Row.Cells.Length
    );
    for Cell: DataGrids.Cell<TChild> in Row.Cells do
      Cells.Add(
        case Cell of
          when DataGrids.Cell.Text(const Caption: string): DataGrids.Cell<TParent>.Text(Caption);
          when DataGrids.Cell.Content(
            const Nodes: array of E.Element<TChild>
          ): DataGrids.Cell<TParent>.Content(Children(Nodes));
          when DataGrids.Cell.Editable(
            const Caption: string, const Capacity: int,
            const Commit: function(string): TChild, const Leading: array of E.Element<TChild>
          ): DataGrids.Cell<TParent>.Editable(
            Caption, Capacity,
            function(Text: string): TParent => Messages(Commit(Text)), Children(Leading)
          );
        end case
      );
    end for;

    return new DataGrids.Row<TParent>(Row.Id, Cells.ToArray());
  end function;
  function MapRows(Rows: array of Tables.Row<TChild>): array of Tables.Row<TParent>;
  begin
    const Result: Lists.List<Tables.Row<TParent>> := new Lists.List<Tables.Row<TParent>>(
      Rows.Length
    );
    for Row: Tables.Row<TChild> in Rows do
      const Cells: Lists.List<Tables.Cell<TParent>> := new Lists.List<Tables.Cell<TParent>>(
        Row.Cells.Length
      );
      for Cell: Tables.Cell<TChild> in Row.Cells do
        Cells.Add(
          case Cell of
            when Tables.Cell.Text(const Caption: string): Tables.Cell<TParent>.Text(Caption);
            when Tables.Cell.Content(
              const Nodes: array of E.Element<TChild>
            ): Tables.Cell<TParent>.Content(Children(Nodes));
          end case
        );
      end for;

      Result.Add(new Tables.Row<TParent>(Row.Id, Cells.ToArray(), Row.Selected));
    end for;

    return Result.ToArray();
  end function;

  function MapCommands(Commands: array of Palettes.Command<TChild>): array of Palettes.Command<TParent>;
  begin
    const Result: Lists.List<Palettes.Command<TParent>> := new Lists.List<Palettes.Command<TParent>>(
      Commands.Length
    );
    for Command: Palettes.Command<TChild> in Commands do
      Result.Add(
        new Palettes.Command<TParent>(
          Command.Title,
          Messages(Command.Message),
          Command.Icon,
          Command.Group,
          Command.Shortcut
        )
      );
    end for;

    return Result.ToArray();
  end function;
begin
  return case Value of
    when E.Element.LinkAction(
      const Id: string,
      const Label: string,
      const Activate: TChild,
      const Enabled: bool
    ): E.Element<TParent>.LinkAction(Id, Label, Messages(Activate), Enabled);
    when E.Element.Avatar(
      const Id: string,
      const Name: string,
      const Settings: Avatars.Options
    ): E.Element<TParent>.Avatar(Id, Name, Settings);
    when E.Element.HoverCard(
      const Id: string, const Trigger: E.Element<TChild>, const Content: E.Element<TChild>,
      const Settings: HoverCards.Options
    ): E.Element<TParent>.HoverCard(
      Id,
      Map<TChild, TParent>(Trigger, Messages),
      Map<TChild, TParent>(Content, Messages),
      Settings
    );
    when E.Element.Banner(
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.Countdown(_, _, _), E.Element.Checklist(
      _,
      _,
      _,
      _,
      _
    ): Feedback.Map<TChild, TParent>(Value, Messages);
    when E.Element.Dropzone(_, _, _, _), E.Element.AvatarUpload(
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.SignaturePad(_, _, _): Capture.Map<TChild, TParent>(Value, Messages);
    when E.Element.SwipeRow(
      const Id: string, const Content: E.Element<TChild>, const Left: array of Swipe.Item,
      const Right: array of Swipe.Item, const Choose: function(Swipe.Side, int): TChild,
      const Settings: Swipe.Options
    ): E.Element<TParent>.SwipeRow(
      Id, Map<TChild, TParent>(Content, Messages), Left, Right,
      function(Side: Swipe.Side; Index: int): TParent => Messages(Choose(Side, Index)), Settings
    );
    when E.Element.Accordion(
      const FId: string,
      const FTitle: string,
      const FOpen: bool,
      const FOnChange: function(bool): TChild,
      const FContent: E.Element<TChild>,
      const FEnabled: bool
    ): E.Element<TParent>.Accordion(
      FId,
      FTitle,
      FOpen,
      function(A0: bool): TParent => Messages(FOnChange(A0)),
      Map<TChild, TParent>(FContent, Messages),
      FEnabled
    );
    when E.Element.ExpandableCard(
      const FId: string,
      const FTitle: string,
      const FOpen: bool,
      const FOnChange: function(bool): TChild,
      const FContent: E.Element<TChild>,
      const FSettings: ExpandableCards.Options
    ): E.Element<TParent>.ExpandableCard(
      FId,
      FTitle,
      FOpen,
      function(A0: bool): TParent => Messages(FOnChange(A0)),
      Map<TChild, TParent>(FContent, Messages),
      FSettings
    );
    when E.Element.ButtonGroup(
      const FChildren: array of E.Element<TChild>
    ): E.Element<TParent>.ButtonGroup(Children(FChildren));
    when E.Element.Contextual(
      const FId: string,
      const FTarget: E.Element<TChild>,
      const FEntries: array of Menus.Entry<TChild>,
      const FEnabled: bool
    ): E.Element<TParent>.Contextual(
      FId,
      Map<TChild, TParent>(FTarget, Messages),
      M.Menu<TChild, TParent>(FEntries, Messages),
      FEnabled
    );
    when E.Element.Hinted(
      const FTarget: E.Element<TChild>,
      const FText: string,
      const FShortcut: string
    ): E.Element<TParent>.Hinted(Map<TChild, TParent>(FTarget, Messages), FText, FShortcut);
    when E.Element.Dialog(
      const FId: string,
      const FBase: E.Element<TChild>,
      const FContent: E.Element<TChild>,
      const FOpen: bool,
      const FSettings: Dialogs.Options,
      const FOnDismiss: TChild
    ): E.Element<TParent>.Dialog(
      FId,
      Map<TChild, TParent>(FBase, Messages),
      Map<TChild, TParent>(FContent, Messages),
      FOpen,
      FSettings,
      Messages(FOnDismiss)
    );
    when E.Element.ActionFooter(
      const FChildren: array of E.Element<TChild>
    ): E.Element<TParent>.ActionFooter(Children(FChildren));
    when E.Element.Popover(
      const FId: string,
      const FTrigger: E.Element<TChild>,
      const FContent: E.Element<TChild>,
      const FOpen: bool,
      const FOnDismiss: TChild,
      const FSettings: Popovers.Options
    ): E.Element<TParent>.Popover(
      FId,
      Map<TChild, TParent>(FTrigger, Messages),
      Map<TChild, TParent>(FContent, Messages),
      FOpen,
      Messages(FOnDismiss),
      FSettings
    );
    when E.Element.ConfirmPopover(
      const FId: string,
      const FTrigger: E.Element<TChild>,
      const FOpen: bool,
      const FSettings: ConfirmPopovers.Options,
      const FOnConfirm: TChild,
      const FOnDismiss: TChild
    ): E.Element<TParent>.ConfirmPopover(
      FId,
      Map<TChild, TParent>(FTrigger, Messages),
      FOpen,
      FSettings,
      Messages(FOnConfirm),
      Messages(FOnDismiss)
    );
    when E.Element.ListItem(
      const Id: string,
      const Title: string,
      const Activate: Sys.Func<TChild>?,
      const Settings: ListItems.Options
    ): E.Element<TParent>.ListItem(
      Id,
      Title,
      M.Factory<TChild, TParent>(Activate, Messages),
      Settings
    );
    when E.Element.TreeNode(
      const Id: string,
      const Label: string,
      const Open: bool?,
      const Nodes: array of E.Element<TChild>,
      const Change: Sys.Func<bool, TChild>?,
      const Activate: Sys.Func<TChild>?,
      const Settings: Trees.Options
    ): E.Element<TParent>.TreeNode(
      Id, Label, Open, Children(Nodes), M.Callback<bool, TChild, TParent>(Change, Messages),
      M.Factory<TChild, TParent>(Activate, Messages), Settings
    );
    when E.Element.Table(
      const Id: string,
      const Columns: array of Tables.Column,
      const Rows: array of Tables.Row<TChild>,
      const Order: Tables.Sort?,
      const OnSort: Sys.Func<Tables.Sort, TChild>?,
      const Select: Sys.Func<string, TChild>?,
      const Settings: Tables.Options
    ): E.Element<TParent>.Table(
      Id, Columns, MapRows(Rows), Order, M.Callback<Tables.Sort, TChild, TParent>(OnSort, Messages),
      M.Callback<string, TChild, TParent>(Select, Messages), Settings
    );
    when E.Element.FilterBar(
      const Id: string,
      const Fields: array of Filters.Field,
      const Current: Filters.Value,
      const Change: function(Filters.Value): TChild,
      const Capacity: int,
      const Enabled: bool
    ): E.Element<TParent>.FilterBar(
      Id,
      Fields,
      Current,
      function(Next: Filters.Value): TParent => Messages(Change(Next)),
      Capacity,
      Enabled
    );
    when E.Element.DataGrid(
      const Id: string, const Columns: array of DataGrids.Column, const Count: int,
      const Build: function(int): DataGrids.Row<TChild>, const Current: DataGrids.Value,
      const Change: function(DataGrids.Value): TChild, const Settings: DataGrids.Options
    ): E.Element<TParent>.DataGrid(
      Id, Columns, Count, function(Index: int): DataGrids.Row<TParent> => MapGridRow(Build(Index)),
      Current, function(Next: DataGrids.Value): TParent => Messages(Change(Next)), Settings
    );
    when E.Element.TreeCell(
      const Id: string, const Label: string, const Depth: int, const Open: bool?,
      const Change: Sys.Func<bool, TChild>?, const Icon: string
    ): E.Element<TParent>.TreeCell(
      Id,
      Label,
      Depth,
      Open,
      M.Callback<bool, TChild, TParent>(Change, Messages),
      Icon
    );
    when E.Element.TreeTable(
      const Id: string, const Columns: array of DataGrids.Column,
      const Nodes: array of TreeTables.Node, const Cursor: int, const Order: Tables.Sort?,
      const Change: function(TreeTables.Change): TChild, const Settings: TreeTables.Options
    ): E.Element<TParent>.TreeTable(
      Id, Columns, Nodes, Cursor, Order,
      function(Next: TreeTables.Change): TParent => Messages(Change(Next)), Settings
    );
    when E.Element.ReorderableList(
      const Id: string, const Items: array of E.Element<TChild>, const Order: array of int,
      const Change: function(array of int): TChild, const Enabled: bool
    ): E.Element<TParent>.ReorderableList(
      Id,
      Children(Items),
      Order,
      function(Value: array of int): TParent => Messages(Change(Value)),
      Enabled
    );
    when E.Element.VirtualList(
      const Id: string, const Count: int, const RowHeight: float, const Height: L.Extent,
      const Build: function(int): E.Element<TChild>
    ): E.Element<TParent>.VirtualList(
      Id,
      Count,
      RowHeight,
      Height,
      function(Index: int): E.Element<TParent> => Map<TChild, TParent>(Build(Index), Messages)
    );
    when E.Element.CodeBlock(
      const Id: string,
      const Code: string,
      const Settings: CodeBlocks.Options
    ): E.Element<TParent>.CodeBlock(Id, Code, Settings);
    when E.Element.JsonView(
      const Id: string,
      const Json: string,
      const Settings: JsonViews.Options
    ): E.Element<TParent>.JsonView(Id, Json, Settings);
    when E.Element.Readout(
      const Id: string,
      const Label: string,
      const Text: string,
      const Settings: Readouts.Options
    ): E.Element<TParent>.Readout(Id, Label, Text, Settings);
    when E.Element.DotDisplay(
      const Id: string,
      const Text: string,
      const Settings: DotDisplays.Options
    ): E.Element<TParent>.DotDisplay(Id, Text, Settings);
    when E.Element.DotChart(
      const Id: string, const Bands: array of DotCharts.Series, const Count: int,
