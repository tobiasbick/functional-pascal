uses System.Collections.Generic as Lists;

type MappedCache of (TChild, TParent) = record
  // Child cache entry retained between mapped renders.
  public Source: E.CacheEntry of TChild;
  // Translator used to build the cached parent view.
  public Messages: function(TChild): TParent;
end record;

function Deferred of (TChild, TParent)(
  Id: string;
  Resolve: function((E.CacheEntry of TChild)?): E.CacheEntry of TChild;
  Messages: function(TChild): TParent
): E.Element of TParent;
  function Build(Previous: (E.CacheEntry of TParent)?): E.CacheEntry of TParent;
  begin
    var Saved: MappedCache of (TChild, TParent)? := null;
    if Previous <> null and Previous.Dependencies is MappedCache of (TChild, TParent) then
      Saved := cast Previous.Dependencies as MappedCache of (TChild, TParent);
    end if;
    const Current: E.CacheEntry of TChild := Resolve(
      if Saved = null then
        null
      else
        Saved.Source
      end if
    );
    if Previous <> null and Saved <> null and Sys.Object.ReferenceEquals(Saved.Source, Current)
      and Sys.Object.Equals(Saved.Messages, Messages)
    then
      return Previous;
    end if;

    return new E.CacheEntry of TParent(
      new MappedCache of (TChild, TParent)(Current, Messages),
      Map of (TChild, TParent)(Current.Tree, Messages)
    );
  end function;
begin
  return (E.Element of TParent).Deferred(Id, Build);
end function;

// Embeds a child view by translating all messages, callbacks and lazy subviews.
//
// ## Type parameters
// - `TChild`: Child message type.
// - `TParent`: Parent message type.
// ## Parameters
// - `Value`: Child element tree; its options and control identities are retained.
// - `Messages`: Pure translation of child messages to parent messages.
// ## Returns
// A parent-message tree with unchanged layout, native widgets and callback timing.
// Cached subviews retain their child dependencies and rebuild if the mapper changes.
public function Map of (TChild, TParent)(
  Value: E.Element of TChild;
  Messages: function(TChild): TParent
): E.Element of TParent;
  function KanbanColumns(
    Columns: array of Kanbans.Column of TChild
  ): array of Kanbans.Column of TParent;
  begin
    const Result: Lists.List of Kanbans.Column of TParent := new Lists.List of Kanbans.Column of TParent();
    for Column: Kanbans.Column of TChild in Columns do
      const CardViews: Lists.List of Kanbans.Card of TParent := new Lists.List of Kanbans.Card of TParent();
      for Card: Kanbans.Card of TChild in Column.Cards do
        CardViews.Add(
          new Kanbans.Card of TParent(
            Card.Key,
            Card.Title,
            Map of (TChild, TParent)(Card.Content, Messages)
          )
        );
      end for;

      Result.Add(
        new Kanbans.Column of TParent(
          Column.Title,
          CardViews.ToArray(),
          Column.Dot,
          Column.Limit,
          Column.Width
        )
      );
    end for;

    return Result.ToArray();
  end function;

  function MapDock(Entries: array of Docks.Entry of TChild): array of Docks.Entry of TParent;
  begin
    const Result: Lists.List of Docks.Entry of TParent := new Lists.List of Docks.Entry of TParent(
      Entries.Length
    );
    for Entry: Docks.Entry of TChild in Entries do
      Result.Add(
        case Entry of
          when Docks.Entry.Separator: (Docks.Entry of TParent).Separator;
          when Docks.Entry.Item(
            const Icon: string?, const Label: string?, const Message: TChild,
            const Color: MotionColors.Color, const Running: bool, const Badge: int
          ): (Docks.Entry of TParent).Item(Icon, Label, Messages(Message), Color, Running, Badge);
        end case
      );
    end for;

    return Result.ToArray();
  end function;
  function Children(Values: array of E.Element of TChild): array of E.Element of TParent;
  begin
    const Result: Lists.List of E.Element of TParent := new Lists.List of E.Element of TParent();
    for Child: E.Element of TChild in Values do
      Result.Add(Map of (TChild, TParent)(Child, Messages));
    end for;

    return Result.ToArray();
  end function;
  function ReorderRows(
    Items: array of array of E.Element of TChild
  ): array of array of E.Element of TParent;
  begin
    const Result: Lists.List of array of E.Element of TParent := new Lists.List of array of E.Element of TParent(
      Items.Length
    );
    for Row: array of E.Element of TChild in Items do
      Result.Add(Children(Row));
    end for;

    return Result.ToArray();
  end function;
  function MapGridRow(Row: DataGrids.Row of TChild): DataGrids.Row of TParent;
  begin
    const Cells: Lists.List of DataGrids.Cell of TParent := new Lists.List of DataGrids.Cell of TParent(
      Row.Cells.Length
    );
    for Cell: DataGrids.Cell of TChild in Row.Cells do
      Cells.Add(
        case Cell of
          when DataGrids.Cell.Text(
            const Caption: string
          ): (DataGrids.Cell of TParent).Text(Caption);
          when DataGrids.Cell.Content(
            const Nodes: array of E.Element of TChild
          ): (DataGrids.Cell of TParent).Content(Children(Nodes));
          when DataGrids.Cell.Editable(
            const Caption: string, const Capacity: int,
            const Commit: function(string): TChild, const Leading: array of E.Element of TChild
          ): (DataGrids.Cell of TParent).Editable(
            Caption, Capacity,
            function(Text: string): TParent => Messages(Commit(Text)), Children(Leading)
          );
        end case
      );
    end for;

    return new DataGrids.Row of TParent(Row.Id, Cells.ToArray());
  end function;
  function MapRows(Rows: array of Tables.Row of TChild): array of Tables.Row of TParent;
  begin
    const Result: Lists.List of Tables.Row of TParent := new Lists.List of Tables.Row of TParent(
      Rows.Length
    );
    for Row: Tables.Row of TChild in Rows do
      const Cells: Lists.List of Tables.Cell of TParent := new Lists.List of Tables.Cell of TParent(
        Row.Cells.Length
      );
      for Cell: Tables.Cell of TChild in Row.Cells do
        Cells.Add(
          case Cell of
            when Tables.Cell.Text(const Caption: string): (Tables.Cell of TParent).Text(Caption);
            when Tables.Cell.Content(
              const Nodes: array of E.Element of TChild
            ): (Tables.Cell of TParent).Content(Children(Nodes));
          end case
        );
      end for;

      Result.Add(new Tables.Row of TParent(Row.Id, Cells.ToArray(), Row.Selected));
    end for;

    return Result.ToArray();
  end function;

  function MapCommands(
    Commands: array of Palettes.Command of TChild
  ): array of Palettes.Command of TParent;
  begin
    const Result: Lists.List of Palettes.Command of TParent := new Lists.List of Palettes.Command of TParent(
      Commands.Length
    );
    for Command: Palettes.Command of TChild in Commands do
      Result.Add(
        new Palettes.Command of TParent(
          Command.Title,
          Messages(Command.Message),
          Command.Icon,
          Command.Group,
          Command.Shortcut
        )
      );
    end for;

    return Result.ToArray();
  end function;
begin
  return case Value of
    when E.Element.LinkAction(
      const Id: string,
      const Label: string,
      const Activate: TChild,
      const Enabled: bool
    ): (E.Element of TParent).LinkAction(Id, Label, Messages(Activate), Enabled);
    when E.Element.Avatar(
      const Id: string,
      const Name: string,
      const Settings: Avatars.Options
    ): (E.Element of TParent).Avatar(Id, Name, Settings);
    when E.Element.HoverCard(
      const Id: string, const Trigger: E.Element of TChild, const Content: E.Element of TChild,
      const Settings: HoverCards.Options
    ): (E.Element of TParent).HoverCard(
      Id,
      Map of (TChild, TParent)(Trigger, Messages),
      Map of (TChild, TParent)(Content, Messages),
      Settings
    );
    when E.Element.Banner(
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.Countdown(_, _, _), E.Element.Checklist(
      _,
      _,
      _,
      _,
      _
    ), E.Element.Alert(
      _,
      _,
      _,
      _
    ), E.Element.ProgressBar(
      _,
      _,
      _
    ), E.Element.Spinner(_, _, _), E.Element.Skeleton(
      _,
      _,
      _
    ), E.Element.TimelineItem(_, _, _), E.Element.ProgressRing(
      _,
      _,
      _,
      _
    ), E.Element.LevelMeter(
      _, _, _, _
    ), E.Element.Meter(
      _,
      _,
      _,
      _,
      _
    ): Feedback.Map of (TChild, TParent)(Value, Messages);
    when E.Element.Dropzone(_, _, _, _), E.Element.AvatarUpload(
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.SignaturePad(_, _, _): Capture.Map of (TChild, TParent)(Value, Messages);
    when E.Element.SwipeRow(
      const Id: string, const Content: E.Element of TChild, const Left: array of Swipe.Item,
      const Right: array of Swipe.Item, const Choose: function(Swipe.Side, int): TChild,
      const Settings: Swipe.Options
    ): (E.Element of TParent).SwipeRow(
      Id, Map of (TChild, TParent)(Content, Messages), Left, Right,
      function(Side: Swipe.Side; Index: int): TParent => Messages(Choose(Side, Index)), Settings
    );
    when E.Element.Accordion(
      const FId: string,
      const FTitle: string,
      const FOpen: bool,
      const FOnChange: function(bool): TChild,
      const FContent: E.Element of TChild,
      const FEnabled: bool
    ): (E.Element of TParent).Accordion(
      FId,
      FTitle,
      FOpen,
      function(A0: bool): TParent => Messages(FOnChange(A0)),
      Map of (TChild, TParent)(FContent, Messages),
      FEnabled
    );
    when E.Element.ExpandableCard(
      const FId: string,
      const FTitle: string,
      const FOpen: bool,
      const FOnChange: function(bool): TChild,
      const FContent: E.Element of TChild,
      const FSettings: ExpandableCards.Options
    ): (E.Element of TParent).ExpandableCard(
      FId,
      FTitle,
      FOpen,
      function(A0: bool): TParent => Messages(FOnChange(A0)),
      Map of (TChild, TParent)(FContent, Messages),
      FSettings
    );
    when E.Element.ButtonGroup(
      const FChildren: array of E.Element of TChild
    ): (E.Element of TParent).ButtonGroup(Children(FChildren));
    when E.Element.Contextual(
      const FId: string,
      const FTarget: E.Element of TChild,
      const FEntries: array of Menus.Entry of TChild,
      const FEnabled: bool
    ): (E.Element of TParent).Contextual(
      FId,
      Map of (TChild, TParent)(FTarget, Messages),
      M.Menu of (TChild, TParent)(FEntries, Messages),
      FEnabled
    );
    when E.Element.Hinted(
      const FTarget: E.Element of TChild,
      const FText: string,
      const FShortcut: string
    ): (E.Element of TParent).Hinted(Map of (TChild, TParent)(FTarget, Messages), FText, FShortcut);
    when E.Element.Dialog(
      const FId: string,
      const FBase: E.Element of TChild,
      const FContent: E.Element of TChild,
      const FOpen: bool,
      const FSettings: Dialogs.Options,
      const FOnDismiss: TChild
    ): (E.Element of TParent).Dialog(
      FId,
      Map of (TChild, TParent)(FBase, Messages),
      Map of (TChild, TParent)(FContent, Messages),
      FOpen,
      FSettings,
      Messages(FOnDismiss)
    );
    when E.Element.ActionFooter(
      const FChildren: array of E.Element of TChild
    ): (E.Element of TParent).ActionFooter(Children(FChildren));
    when E.Element.Popover(
      const FId: string,
      const FTrigger: E.Element of TChild,
      const FChildren: array of E.Element of TChild,
      const FOpen: bool,
      const FOnDismiss: TChild,
      const FSettings: Popovers.Options
    ): (E.Element of TParent).Popover(
      FId,
      Map of (TChild, TParent)(FTrigger, Messages),
      Children(FChildren),
      FOpen,
      Messages(FOnDismiss),
      FSettings
    );
    when E.Element.ConfirmPopover(
      const FId: string,
      const FTrigger: E.Element of TChild,
      const FOpen: bool,
      const FSettings: ConfirmPopovers.Options,
      const FOnConfirm: TChild,
      const FOnDismiss: TChild
    ): (E.Element of TParent).ConfirmPopover(
      FId,
      Map of (TChild, TParent)(FTrigger, Messages),
      FOpen,
      FSettings,
      Messages(FOnConfirm),
      Messages(FOnDismiss)
    );
    when E.Element.ListItem(
      const Id: string,
      const Title: string,
      const Activate: (Sys.Func of TChild)?,
      const Settings: ListItems.Options
    ): (E.Element of TParent).ListItem(
      Id,
      Title,
      M.Factory of (TChild, TParent)(Activate, Messages),
      Settings
    );
    when E.Element.TreeNode(
      const Id: string,
      const Label: string,
      const Open: bool?,
      const Nodes: array of E.Element of TChild,
      const Change: Sys.Func of (bool, TChild)?,
      const Activate: (Sys.Func of TChild)?,
      const Settings: Trees.Options
    ): (E.Element of TParent).TreeNode(
      Id, Label, Open, Children(Nodes), M.Callback of (bool, TChild, TParent)(Change, Messages),
      M.Factory of (TChild, TParent)(Activate, Messages), Settings
    );
    when E.Element.Table(
      const Id: string,
      const Columns: array of Tables.Column,
      const Rows: array of Tables.Row of TChild,
      const Order: Tables.Sort?,
      const OnSort: Sys.Func of (Tables.Sort, TChild)?,
      const Select: Sys.Func of (string, TChild)?,
      const Settings: Tables.Options
    ): (E.Element of TParent).Table(
      Id,
      Columns,
      MapRows(Rows),
      Order,
      M.Callback of (Tables.Sort, TChild, TParent)(OnSort, Messages),
      M.Callback of (string, TChild, TParent)(Select, Messages),
      Settings
    );
    when E.Element.FilterBar(
      const Id: string,
      const Fields: array of Filters.Field,
      const Current: Filters.Value,
      const Change: function(Filters.Value): TChild,
      const Capacity: int,
      const Enabled: bool
    ): (E.Element of TParent).FilterBar(
      Id,
      Fields,
      Current,
      function(Next: Filters.Value): TParent => Messages(Change(Next)),
      Capacity,
      Enabled
    );
    when E.Element.DataGrid(
      const Id: string, const Columns: array of DataGrids.Column, const Count: int,
      const Build: function(int): DataGrids.Row of TChild, const Current: DataGrids.Value,
      const Change: function(DataGrids.Value): TChild, const Settings: DataGrids.Options,
      const DoubleClick: Sys.Func of (int, TChild)?, const RowClick: Sys.Func of (int, TChild)?
    ): (E.Element of TParent).DataGrid(
      Id,
      Columns,
      Count,
      function(Index: int): DataGrids.Row of TParent => MapGridRow(Build(Index)),
      Current,
      function(Next: DataGrids.Value): TParent => Messages(Change(Next)),
      Settings,
      M.Callback of (int, TChild, TParent)(DoubleClick, Messages),
      M.Callback of (int, TChild, TParent)(RowClick, Messages)
    );
    when E.Element.TreeCell(
      const Id: string, const Label: string, const Depth: int, const Open: bool?,
      const Change: Sys.Func of (bool, TChild)?, const Icon: string
    ): (E.Element of TParent).TreeCell(
      Id,
      Label,
      Depth,
      Open,
      M.Callback of (bool, TChild, TParent)(Change, Messages),
      Icon
    );
    when E.Element.TreeTable(
      const Id: string, const Columns: array of DataGrids.Column,
      const Nodes: array of TreeTables.Node, const Cursor: int, const Order: Tables.Sort?,
      const Change: function(TreeTables.Change): TChild, const Settings: TreeTables.Options,
      const Menu: Sys.Func of (int, array of Menus.Entry of TChild)?
    ): (E.Element of TParent).TreeTable(
      Id, Columns, Nodes, Cursor, Order,
      function(Next: TreeTables.Change): TParent => Messages(Change(Next)), Settings,
      M.MenuSource of (int, TChild, TParent)(Menu, Messages)
    );
    when E.Element.ReorderableList(
      const Id: string,
      const Items: array of array of E.Element of TChild,
      const Order: array of int,
      const Change: function(array of int): TChild,
      const Enabled: bool
    ): (E.Element of TParent).ReorderableList(
      Id,
      ReorderRows(Items),
      Order,
      function(Value: array of int): TParent => Messages(Change(Value)),
      Enabled
    );
    when E.Element.VirtualList(
      const Id: string,
      const Count: int,
      const RowHeight: float,
      const Height: L.Extent,
      const Build: function(int): E.Element of TChild,
      const Offset: float?,
      const Scroll: Sys.Func of (float, TChild)?
    ): (E.Element of TParent).VirtualList(
      Id,
      Count,
      RowHeight,
      Height,
      function(Index: int): E.Element of TParent => Map of (TChild, TParent)(
        Build(Index),
        Messages
      ),
      Offset, M.Callback of (float, TChild, TParent)(Scroll, Messages)
    );
    when E.Element.CodeBlock(
      const Id: string,
      const Code: string,
      const Settings: CodeBlocks.Options
    ): (E.Element of TParent).CodeBlock(Id, Code, Settings);
    when E.Element.JsonView(
      const Id: string,
      const Json: string,
      const Settings: JsonViews.Options
    ): (E.Element of TParent).JsonView(Id, Json, Settings);
    when E.Element.Readout(
      const Id: string,
      const Label: string,
