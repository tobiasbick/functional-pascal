  System.Collections.Generic as Lists;

type MappedCache<TChild, TParent> = record
  public Source: E.CacheEntry<TChild>;
  public Messages: function(TChild): TParent;
end record;

function Deferred<TChild, TParent>(
  Id: string;
  Resolve: function(E.CacheEntry<TChild>?): E.CacheEntry<TChild>;
  Messages: function(TChild): TParent
): E.Element<TParent>;
  function Build(Previous: E.CacheEntry<TParent>?): E.CacheEntry<TParent>;
  begin
    var Saved: MappedCache<TChild, TParent>? := null;
    if Previous <> null and Previous.Dependencies is MappedCache<TChild, TParent> then
      Saved := cast<MappedCache<TChild, TParent>>(Previous.Dependencies);
    end if;
    const Current: E.CacheEntry<TChild> := Resolve(
      if Saved = null then
        null
      else
        Saved.Source
      end if
    );
    if Previous <> null and Saved <> null and Sys.Object.ReferenceEquals(Saved.Source, Current)
      and Sys.Object.Equals(Saved.Messages, Messages)
    then
      return Previous;
    end if;

    return new E.CacheEntry<TParent>(
      new MappedCache<TChild, TParent>(Current, Messages),
      Map<TChild, TParent>(Current.Tree, Messages)
    );
  end function;
begin
  return E.Element<TParent>.Deferred(Id, Build);
end function;

// Embeds a child view by translating all messages, callbacks and lazy subviews.
//
// ## Type parameters
// - `TChild`: Child message type.
// - `TParent`: Parent message type.
// ## Parameters
// - `Value`: Child element tree; its options and control identities are retained.
// - `Messages`: Pure translation of child messages to parent messages.
// ## Returns
// A parent-message tree with unchanged layout, native widgets and callback timing.
// Cached subviews retain their child dependencies and rebuild if the mapper changes.
public function Map<TChild, TParent>(
  Value: E.Element<TChild>;
  Messages: function(TChild): TParent
): E.Element<TParent>;
  function Children(Values: array of E.Element<TChild>): array of E.Element<TParent>;
  begin
    const Result: Lists.List<E.Element<TParent>> := new Lists.List<E.Element<TParent>>();
    for Child: E.Element<TChild> in Values do
      Result.Add(Map<TChild, TParent>(Child, Messages));
    end for;

    return Result.ToArray();
  end function;
begin
  return case Value of
    when E.Element.LinkAction(
      const Id: string,
      const Label: string,
      const Activate: TChild,
      const Enabled: bool
    ): E.Element<TParent>.LinkAction(Id, Label, Messages(Activate), Enabled);
    when E.Element.Avatar(
      const Id: string,
      const Name: string,
      const Settings: Avatars.Options
    ): E.Element<TParent>.Avatar(Id, Name, Settings);
    when E.Element.HoverCard(
      const Id: string, const Trigger: E.Element<TChild>, const Content: E.Element<TChild>,
      const Settings: HoverCards.Options
    ): E.Element<TParent>.HoverCard(
      Id,
      Map<TChild, TParent>(Trigger, Messages),
      Map<TChild, TParent>(Content, Messages),
      Settings
    );
    when E.Element.Banner(
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.Countdown(_, _, _), E.Element.Checklist(
      _,
      _,
      _,
      _,
      _
    ): Feedback.Map<TChild, TParent>(Value, Messages);
    when E.Element.Dropzone(_, _, _, _), E.Element.AvatarUpload(
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.SignaturePad(_, _, _): Capture.Map<TChild, TParent>(Value, Messages);
    when E.Element.SwipeRow(
      const Id: string, const Content: E.Element<TChild>, const Left: array of Swipe.Item,
      const Right: array of Swipe.Item, const Choose: function(Swipe.Side, int): TChild,
      const Settings: Swipe.Options
    ): E.Element<TParent>.SwipeRow(
      Id, Map<TChild, TParent>(Content, Messages), Left, Right,
      function(Side: Swipe.Side; Index: int): TParent => Messages(Choose(Side, Index)), Settings
    );
    when E.Element.Accordion(
      const FId: string,
      const FTitle: string,
      const FOpen: bool,
      const FOnChange: function(bool): TChild,
      const FContent: E.Element<TChild>,
      const FEnabled: bool
    ): E.Element<TParent>.Accordion(
      FId,
      FTitle,
      FOpen,
      function(A0: bool): TParent => Messages(FOnChange(A0)),
      Map<TChild, TParent>(FContent, Messages),
      FEnabled
    );
    when E.Element.ExpandableCard(
      const FId: string,
      const FTitle: string,
      const FOpen: bool,
      const FOnChange: function(bool): TChild,
      const FContent: E.Element<TChild>,
      const FSettings: ExpandableCards.Options
    ): E.Element<TParent>.ExpandableCard(
      FId,
      FTitle,
      FOpen,
      function(A0: bool): TParent => Messages(FOnChange(A0)),
      Map<TChild, TParent>(FContent, Messages),
      FSettings
    );
    when E.Element.ButtonGroup(
      const FChildren: array of E.Element<TChild>
    ): E.Element<TParent>.ButtonGroup(Children(FChildren));
    when E.Element.Contextual(
      const FId: string,
      const FTarget: E.Element<TChild>,
      const FEntries: array of Menus.Entry<TChild>,
      const FEnabled: bool
    ): E.Element<TParent>.Contextual(
      FId,
      Map<TChild, TParent>(FTarget, Messages),
      M.Menu<TChild, TParent>(FEntries, Messages),
      FEnabled
    );
    when E.Element.Hinted(
      const FTarget: E.Element<TChild>,
      const FText: string,
      const FShortcut: string
    ): E.Element<TParent>.Hinted(Map<TChild, TParent>(FTarget, Messages), FText, FShortcut);
    when E.Element.Dialog(
      const FId: string,
      const FBase: E.Element<TChild>,
      const FContent: E.Element<TChild>,
      const FOpen: bool,
      const FSettings: Dialogs.Options,
      const FOnDismiss: TChild
    ): E.Element<TParent>.Dialog(
      FId,
      Map<TChild, TParent>(FBase, Messages),
      Map<TChild, TParent>(FContent, Messages),
      FOpen,
      FSettings,
      Messages(FOnDismiss)
    );
    when E.Element.ActionFooter(
      const FChildren: array of E.Element<TChild>
    ): E.Element<TParent>.ActionFooter(Children(FChildren));
    when E.Element.Popover(
      const FId: string,
      const FTrigger: E.Element<TChild>,
      const FContent: E.Element<TChild>,
      const FOpen: bool,
      const FOnDismiss: TChild,
      const FSettings: Popovers.Options
    ): E.Element<TParent>.Popover(
      FId,
      Map<TChild, TParent>(FTrigger, Messages),
      Map<TChild, TParent>(FContent, Messages),
      FOpen,
      Messages(FOnDismiss),
      FSettings
    );
    when E.Element.ConfirmPopover(
      const FId: string,
      const FTrigger: E.Element<TChild>,
      const FOpen: bool,
      const FSettings: ConfirmPopovers.Options,
      const FOnConfirm: TChild,
      const FOnDismiss: TChild
    ): E.Element<TParent>.ConfirmPopover(
      FId,
      Map<TChild, TParent>(FTrigger, Messages),
      FOpen,
      FSettings,
      Messages(FOnConfirm),
      Messages(FOnDismiss)
    );
    when E.Element.Grid(
      const Settings: Grids.Options,
      const Nodes: array of E.Element<TChild>
    ): E.Element<TParent>.Grid(Settings, Children(Nodes));
    when E.Element.Card(
      const Id: string, const Nodes: array of E.Element<TChild>, const Settings: Cards.Options,
      const Activate: Sys.Func<TChild>?
    ): E.Element<TParent>.Card(
      Id,
      Children(Nodes),
      Settings,
      M.Factory<TChild, TParent>(Activate, Messages)
    );
    when E.Element.Badge(
      const Id: string,
      const Text: string,
      const Settings: Badges.Options
    ): E.Element<TParent>.Badge(Id, Text, Settings);
    when E.Element.Metric(
      const Id: string,
      const Label: string,
      const Reading: string,
      const Settings: Metrics.Options
    ): E.Element<TParent>.Metric(Id, Label, Reading, Settings);
    when E.Element.AvatarGroup(
      const Id: string,
      const Names: array of string,
      const Settings: AvatarGroups.Options
    ): E.Element<TParent>.AvatarGroup(Id, Names, Settings);
    when E.Element.EmptyState(
      const Id: string,
      const Title: string,
      const Settings: EmptyStates.Options,
      const Action: Sys.Func<TChild>?
    ): E.Element<TParent>.EmptyState(
      Id,
      Title,
      Settings,
      M.Factory<TChild, TParent>(Action, Messages)
    );
    when E.Element.Tour(
      const Id: string,
      const Base: E.Element<TChild>,
      const Steps: array of Tours.Step,
      const Current: int,
      const Changed: function(Tours.Change): TChild,
      const Settings: Tours.Options
    ): E.Element<TParent>.Tour(
      Id, Map<TChild, TParent>(Base, Messages), Steps, Current,
      function(Value: Tours.Change): TParent => Messages(Changed(Value)), Settings
    );
    when E.Element.Spacer: E.Element<TParent>.Spacer;
    when E.Element.Gap(const Distance: L.Measure): E.Element<TParent>.Gap(Distance);
    when E.Element.Layered(
      const FChildren: array of E.Element<TChild>,
      const FSettings: L.Flow
    ): E.Element<TParent>.Layered(Children(FChildren), FSettings);
    when E.Element.Stack(
      const FChildren: array of E.Element<TChild>,
      const FHorizontal: bool,
      const FSettings: L.Flow
    ): E.Element<TParent>.Stack(Children(FChildren), FHorizontal, FSettings);
    when E.Element.Sized(
      const FChild: E.Element<TChild>,
      const FSettings: L.Flex
    ): E.Element<TParent>.Sized(Map<TChild, TParent>(FChild, Messages), FSettings);
    when E.Element.Styled(
      const FChild: E.Element<TChild>,
      const FRole: S.Role
    ): E.Element<TParent>.Styled(Map<TChild, TParent>(FChild, Messages), FRole);
    when E.Element.Framed(
      const FChild: E.Element<TChild>,
      const FTitle: string
    ): E.Element<TParent>.Framed(Map<TChild, TParent>(FChild, Messages), FTitle);
    when E.Element.TableOfContents(
      const FId: string, const FScrollId: string, const FItems: array of Toc.Item,
      const FChanged: Sys.Func<string, TChild>?, const FEnabled: bool
    ): E.Element<TParent>.TableOfContents(
      FId, FScrollId, FItems, M.Callback<string, TChild, TParent>(FChanged, Messages), FEnabled
    );
    when E.Element.ScrollAnchor(const FId: string): E.Element<TParent>.ScrollAnchor(FId);
    when E.Element.Scroll(
      const FId: string,
      const FChild: E.Element<TChild>,
      const FPosition: L.ScrollPosition?,
      const FOnScroll: Sys.Func<L.ScrollChange, TChild>?,
      const FShowScrollbar: bool, const FFadeEdges: bool, const FHorizontal: bool
    ): E.Element<TParent>.Scroll(
      FId,
      Map<TChild, TParent>(FChild, Messages),
      FPosition,
      M.Callback<L.ScrollChange, TChild, TParent>(FOnScroll, Messages),
      FShowScrollbar, FFadeEdges, FHorizontal
    );
    when E.Element.Sheet(
      const FId: string,
      const FBase: E.Element<TChild>,
      const FContent: E.Element<TChild>,
      const FOpen: bool,
      const FSettings: Sheets.Options,
      const FOnDismiss: TChild
    ): E.Element<TParent>.Sheet(
      FId,
      Map<TChild, TParent>(FBase, Messages),
      Map<TChild, TParent>(FContent, Messages),
      FOpen,
      FSettings,
      Messages(FOnDismiss)
    );
    when E.Element.Deferred(
      const FId: string,
      const FResolve: function(E.CacheEntry<TChild>?): E.CacheEntry<TChild>
    ): Deferred<TChild, TParent>(FId, FResolve, Messages);
    when E.Element.TerminalStyle(
      const FChild: E.Element<TChild>,
      const FColors: T.Style
    ): E.Element<TParent>.TerminalStyle(Map<TChild, TParent>(FChild, Messages), FColors);
    when E.Element.TerminalScreen(
      const FContent: E.Element<TChild>,
      const FLayers: array of E.Element<TChild>,
      const FShortcuts: array of Keys.ShortcutBinding<TChild>
    ): E.Element<TParent>.TerminalScreen(
      Map<TChild, TParent>(FContent, Messages),
      Children(FLayers),
      M.Shortcuts<TChild, TParent>(FShortcuts, Messages)
    );
    when E.Element.TerminalViewport(
      const FId: string,
      const FBuild: function(T.Viewport): E.Element<TChild>
    ): E.Element<TParent>.TerminalViewport(
      FId,
      function(A0: T.Viewport): E.Element<TParent> => Map<TChild, TParent>(FBuild(A0), Messages)
    );
    when E.Element.Alert(
