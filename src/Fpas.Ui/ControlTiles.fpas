unit Fpas.Ui.ControlTiles;

uses Fpas.Ui.Elements as E, Fpas.Ui.Charts as C, Fpas.Ui.Layout as L;

// Native options.
public type Options = record
  // Optional CUI icon.
  public Icon: string := '';
  // Optional state line.
  public Detail: string := '';
  // Active tile color.
  public Color: C.Color := C.Color.Automatic;
  // Native width.
  public Width: L.Extent := L.Extent.Fill;
  // Use the horizontal layout.
  public Wide: bool := false;
  // Accept input.
  public Enabled: bool := true;
end record;

// Draws the native CUI control tile.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Label`: Literal tile label.
// - `On`: Model-owned toggle state.
// - `Change`: Maps a native proposal to an application message.
// - `Settings`: Optional native options.
// ## Returns
// The graphical widget.
public function ControlTile<TMsg>(Id: string; Label: string; On: bool; Change: function(bool): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ControlTile(Id, Label, On, Change, Settings ?? new Options());
end function;

end unit;
