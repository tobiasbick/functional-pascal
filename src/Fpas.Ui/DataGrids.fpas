unit Fpas.Ui.DataGrids;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Tables as T;

// A column in a native data grid.
public type Column = record
  // Literal heading.
  public Title: string;
  // Initial width in logical points. Zero uses the native default.
  public Width: float := 0.0F;
  // Horizontal alignment.
  public Align: T.Alignment := T.Alignment.Left;
  // Whether the header proposes sorting.
  public Sortable: bool := false;
  // Whether the width is fixed.
  public Fixed: bool := false;
  // Positive priorities hide first, starting with the largest.
  public Priority: int := 0;
end record;

// Native viewport and input options.
public type Options = record
  // Grid height. Fill uses the available height.
  public Height: L.Extent := L.Extent.Fill;
  // Fixed logical height of each row.
  public RowHeight: float := 40.0F;
  // Tint alternate rows.
  public Striped: bool := false;
  // Hide the checkboxes while retaining selection.
  public HideCheckboxes: bool := false;
  // Whether the grid accepts input.
  public Enabled: bool := true;
end record;

// Model-owned state in display order.
public type Value = record
  // Selection by row position, or null to disable selection.
  public Selected: (array of bool)? := null;
  // Current sort, or null to disable sorting.
  public Order: T.Sort? := null;
  // Current row position or minus one.
  public Cursor: int := -1;
  // Selection range origin or minus one.
  public Anchor: int := -1;
end record;

// A cell rendered by the native grid.
// ## Type parameters
// - `TMsg`: Application message type.
public type Cell<TMsg> = variant
  // Native single-line text.
  Text(Caption: string);
  // Composed graphical children.
  Content(Children: array of E.Element<TMsg>);
  // Editable text, with optional preceding children and a commit mapper.
  Editable(Caption: string; Capacity: int; OnCommit: function(string): TMsg; Leading: array of E.Element<TMsg>);
end variant;

// One realized row.
// ## Type parameters
// - `TMsg`: Application message type.
public type Row<TMsg> = record
  // Stable identity, including across a model reordering.
  public Id: string;
  // One cell per column.
  public Cells: array of Cell<TMsg>;
end record;

// Draws a native grid. CUI calls for the visible rows and its overscan.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable grid identity.
// - `Columns`: Column descriptors in display order.
// - `Count`: Total row count.
// - `BuildRow`: Pure view factory for one display position.
// - `Current`: Model-owned selection, sort, cursor and anchor.
// - `OnChange`: Maps a native state proposal to a message.
// - `Settings`: Optional viewport and input configuration.
// ## Returns
// The graphical grid.
public function DataGrid<TMsg>(Id: string; Columns: array of Column; Count: int; BuildRow: function(int): Row<TMsg>; Current: Value; OnChange: function(Value): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.DataGrid(
    Id,
    Columns,
    Count,
    BuildRow,
    Current,
    OnChange,
    Settings ?? new Options()
  );
end function;

end unit;
