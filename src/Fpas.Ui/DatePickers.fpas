unit Fpas.Ui.DatePickers;

uses Fpas.Ui.Elements as E, System as Sys;

// Presentation and input settings for a native date field.
public type Options = record
  // Optional caption above the field.
  public Label: string := '';
  // Caption for an empty selection. Empty selects CUI's default.
  public Placeholder: string := '';
  // Logical width. Zero selects CUI's default.
  public Width: float := 0.0F;
  // Whether the picker accepts input.
  public Enabled: bool := true;
end record;

// Builds CUI's date field and single-month popup.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable picker identity.
// - `Value`: Model-owned selection, or null.
// - `OnChange`: Maps a chosen date to a message.
// - `Settings`: Optional caption, placeholder, width and input permission.
// ## Returns
// A graphical date picker with a native calendar popup.
public function DatePicker<TMsg>(
  Id: string; Value: Sys.DateOnly?; OnChange: function(Sys.DateOnly): TMsg; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.DatePicker(Id, Value, OnChange, Settings ?? new Options());
end function;

end unit;
