unit Fpas.Ui.Dockspaces;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, System as Sys;

// A native dock panel, identified by a key in the saved layout.
// ## Type parameters
// - `TMsg`: Application message type.
public type Panel<TMsg> = record
  // Stable key of at most 63 UTF-8 bytes within the workspace.
  public Key: string;
  // Visible title.
  public Title: string;
  // Content built in the visible tab.
  public Content: E.Element<TMsg>;
  // Optional CUI icon glyph.
  public Icon: string := '';
  // Whether to show an unsaved-changes dot.
  public Dirty: bool := false;
  // Whether a closable panel is open.
  public Open: bool := true;
  // Receives an open or close proposal. A panel without this callback cannot be closed.
  public OnOpenChanged: Sys.Func<bool, TMsg>? := null;
end record;

// Applies a previously saved CUI layout once for a revision.
public type Restore = record
  // Change this value to apply another restore, including the same text again.
  public Revision: int;
  // Previously saved native dock layout.
  public Layout: string;
end record;

// Native allocation and layout of a docking workspace.
public type Options = record
  // Workspace width.
  public Width: L.Extent := L.Extent.Fill;
  // Workspace height.
  public Height: L.Extent := L.Extent.Fill;
  // Minimum panel width. Zero uses the native default.
  public MinimumWidth: float := 0.0F;
  // Minimum panel height. Zero uses the native default.
  public MinimumHeight: float := 0.0F;
  // Enable window-wide shortcuts for the active leaf.
  public Shortcuts: bool := false;
  // Initial layout expressed in CUI's dock1 format with panel keys.
  public InitialLayout: string := '';
  // Optional new layout to load. Native CUI keeps the previous layout if this is invalid.
  public Load: Restore? := null;
  // Last serialized layout accepted by the model, for deduplicating notifications.
  public KnownLayout: string := '';
end record;

// Draws CUI's native docking workspace. CUI handles placement, dragging and resizing.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Workspace identity, unique in the window.
// - `Panels`: Every panel, including closed and inactive panels.
// - `Settings`: Optional native allocation and layout.
// - `OnLayoutChanged`: Optional receiver for a new serialized layout.
// ## Returns
// A graphical element.
public function Dockspace<TMsg>(Id: string; Panels: array of Panel<TMsg>; Settings: Options? := null; OnLayoutChanged: Sys.Func<string, TMsg>? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Dockspace(Id, Panels, Settings ?? new Options(), OnLayoutChanged);
end function;

end unit;
