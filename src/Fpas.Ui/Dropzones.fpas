unit Fpas.Ui.Dropzones;

uses Fpas.Ui.Elements as E, System as Sys;

// Display and input settings for a native file dropzone.
public type Options = record
  // Literal title, or empty for the native default.
  public Title: string := '';
  // Literal supporting text, or empty for the native default.
  public Description: string := '';
  // Semicolon-separated extensions without dots. Empty accepts any type.
  public Accept: string := '';
  // Optional CUI icon glyph.
  public Icon: string := '';
  // Draw a compact row instead of the tall target.
  public Compact: bool := false;
  // Tall target height in logical points. Zero selects the native default.
  public Height: float := 0.0F;
  // Whether the dropzone accepts input.
  public Enabled: bool := true;
end record;

// Builds CUI's native target for files dropped by the operating system.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable dropzone identity.
// - `OnDrop`: Maps accepted paths copied from the native frame to a message.
// - `OnBrowse`: Optional message factory for browse activation.
// - `Settings`: Optional extension filter, display and input settings.
// ## Returns
// The graphical file dropzone.
public function Dropzone<TMsg>(
  Id: string; OnDrop: function(array of string): TMsg; OnBrowse: Sys.Func<TMsg>? := null;
  Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Dropzone(Id, OnDrop, OnBrowse, Settings ?? new Options());
end function;
end unit;
