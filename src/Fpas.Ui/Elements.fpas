unit Fpas.Ui.Elements;

uses
  Fpas.Ui.Sankeys as Sankeys,
  Fpas.Ui.BarLists as BarLists,
  Fpas.Ui.ActivityRings as ActivityRings,
  Fpas.Ui.ScatterCharts as ScatterCharts,
  Fpas.Ui.RadialGauges as RadialGauges,
  Fpas.Ui.Candlesticks as Candlesticks,
  Fpas.Ui.Heatmaps as Heatmaps,
  Fpas.Ui.CalendarHeatmaps as CalendarHeatmaps,
  Fpas.Ui.Treemaps as Treemaps,
  Fpas.Ui.RadarCharts as RadarCharts,
  Fpas.Ui.Funnels as Funnels,
  Fpas.Ui.SplitBars as SplitBars,
  Fpas.Ui.Waffles as Waffles,
  Fpas.Ui.Charts as Charts, Fpas.Ui.DonutCharts as Donuts, Fpas.Ui.PatternMeters as Patterns,
  Fpas.Ui.InlineEdits as InlineEdits, Fpas.Ui.ScrubFields as ScrubFields,
  Fpas.Ui.MoneyFields as MoneyFields, Fpas.Ui.ShortcutRecorders as RecorderKeys,
  Fpas.Ui.Tours as Tours,
  Fpas.Ui.EmojiPickers as EmojiPickers,
  Fpas.Ui.DatePickers as DatePickers,
  Fpas.Ui.Grids as Grids, Fpas.Ui.Cards as Cards, Fpas.Ui.Badges as Badges,
  Fpas.Ui.Metrics as Metrics, Fpas.Ui.AvatarGroups as AvatarGroups, Fpas.Ui.EmptyStates as EmptyStates,
  Fpas.Ui.TableOfContents as Toc,
  Fpas.Ui.Banners as Banners, Fpas.Ui.Countdowns as Countdowns, Fpas.Ui.Checklists as Checklists,
  Fpas.Ui.Dropzones as Dropzones, Fpas.Ui.SignaturePads as Signatures,
  Fpas.Ui.Avatars as Avatars, Fpas.Ui.HoverCards as HoverCards,
  Fpas.Ui.Knobs as Knobs, Fpas.Ui.Faders as Faders, Fpas.Ui.LevelMeters as Levels,
  Fpas.Ui.RulerSliders as Rulers, Fpas.Ui.HistogramSliders as Histograms,
  Fpas.Ui.TimePickers as TimePickers, Fpas.Ui.WheelPickers as WheelPickers,
  Fpas.Ui.DateRanges as Dates, Fpas.Ui.DateRangePickers as RangePickers,
  Fpas.Ui.SpeedDials as Speed, Fpas.Ui.SwipeActions as Swipe, Fpas.Ui.MultiSelects as Multi,
  Fpas.Ui.TimelineItems as Timeline,
  Fpas.Ui.Alerts as Alerts, Fpas.Ui.ProgressBars as ProgressBars, Fpas.Ui.ExpandableTexts as ExpandableTexts, Fpas.Ui.ExpandableCards as ExpandableCards, Fpas.Ui.Reactions as Reactions, Fpas.Ui.UserMenus as UserMenus, Fpas.Ui.Selects as Selects, Fpas.Ui.NumberFields as NumberFields, Fpas.Ui.TagInputs as TagInputs, Fpas.Ui.OneTimeCodes as OneTimeCodes, Fpas.Ui.SearchFields as SearchFields, Fpas.Ui.TextAreas as TextAreas, Fpas.Ui.Dialogs as Dialogs, Fpas.Ui.TextFields as TextFields, Fpas.Ui.Popovers as Popovers, Fpas.Ui.ConfirmPopovers as ConfirmPopovers, Fpas.Ui.Tabs as Tabs, Fpas.Ui.RadioCards as RadioCards, Fpas.Ui.Sliders as Sliders, Fpas.Ui.RangeSliders as RangeSliders, Fpas.Ui.RadioGroups as RadioGroups, Fpas.Ui.ToggleGroups as ToggleGroups, Fpas.Ui.Menus as Menus, Fpas.Ui.SegmentedControls as Segmented, Fpas.Ui.Themes as Themes, Fpas.Ui.ThemeSwitchers as ThemeSwitchers, Fpas.Ui.StatusButtons as Status, Fpas.Ui.ConfirmButtons as Confirms, Fpas.Ui.SplitButtons as Split, Fpas.Ui.HoldButtons as Holds, Fpas.Ui.Layout as L, Fpas.Ui.Navigation as N, Fpas.Ui.Sheets as Sheets, Fpas.Ui.Buttons as B, Fpas.Ui.IconButtons as Icons, Fpas.Ui.Styles as S, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as Keys, Fpas.Ui.Graphics as G, System as Sys;

// A declarative view for a host to prepare and present.
//
// ## Type parameters
// - `TMsg`: The application message type.
public type Element<TMsg> = variant
  // Draw a native inline link.
  LinkAction(Id: string; Label: string; OnActivate: TMsg; Enabled: bool);
  // Display native initials or a picture with an optional presence dot.
  Avatar(Id: string; Name: string; Settings: Avatars.Options);
  // Attach a native pointer-driven panel to an interactive control.
  HoverCard(Id: string; Trigger: Element<TMsg>; Content: Element<TMsg>; Settings: HoverCards.Options);
  // Display a native banner with model-owned visibility.
  Banner(Id: string; Text: string; Open: bool; OnDismiss: Sys.Func<TMsg>?; OnAction: Sys.Func<TMsg>?; Settings: Banners.Options);
  // Display CUI's rolling countdown tiles.
  Countdown(Id: string; SecondsLeft: double; Settings: Countdowns.Options);
  // Display CUI's onboarding checklist and its native progress.
  Checklist(Id: string; Steps: array of Checklists.Step; OnToggle: function(int, bool): TMsg; OnAction: Sys.Func<int, TMsg>?; Settings: Checklists.Options);
  // Display a native inline alert with CUI-owned dismissal.
  Alert(Id: string; Title: string; Settings: Alerts.Options; OnDismiss: Sys.Func<TMsg>?);
  // Display a native progress fraction or activity animation.
  ProgressBar(Id: string; Value: float; Settings: ProgressBars.Options);
  // Display a native activity spinner.
  Spinner(Id: string; Size: float);
  // Display linear audio peaks on a native dBFS scale.
  LevelMeter(Id: string; Peaks: array of float; Settings: Levels.Options; OnClipCleared: Sys.Func<TMsg>?);
  // Display native capacity usage and its threshold color.
  Meter(Id: string; Label: string; Used: float; Total: float; Unit: string);
  // Display native circular progress with a literal caption.
  ProgressRing(Id: string; Label: string; Value: float; Size: float);
  // Display a native loading placeholder with parent-relative width support.
  Skeleton(Id: string; Width: L.Extent; Height: float);
  // Display a native activity entry with its optional time and connector.
  TimelineItem(Id: string; Title: string; Settings: Timeline.Options);
  // Open a model-controlled native accordion body.
  Accordion(Id: string; Title: string; Open: bool; OnChange: function(bool): TMsg; Content: Element<TMsg>; Enabled: bool);
  // Open a model-controlled native card body.
  ExpandableCard(Id: string; Title: string; Open: bool; OnChange: function(bool): TMsg; Content: Element<TMsg>; Settings: ExpandableCards.Options);
  // Let CUI clamp and expand wrapping text locally.
  ExpandableText(Id: string; Text: string; Settings: ExpandableTexts.Options; OnToggle: Sys.Func<TMsg>?);
  // Display text.
  Label(Text: string);
  // Separate adjacent content, with an optional caption.
  Separator(Title: string);
  // Activate a button with model-owned presentation and input settings.
  ButtonAction(Id: string; Text: string; Message: TMsg; Settings: B.Options);
  // Activate a named icon button with a stable identity and model-owned settings.
  IconAction(Id: string; Icon: string; Tooltip: string; Message: TMsg; Settings: Icons.Options);
  // Submit literal text to the clipboard and optionally propose a message.
  CopyAction(Id: string; Text: string; OnCopied: Sys.Func<TMsg>?; Enabled: bool);
  // Propose a message after a deliberate hold.
  HoldAction(Id: string; Label: string; Message: TMsg; Settings: Holds.Options);
  // Propose a message after two activations within a confirmation window.
  ConfirmAction(Id: string; Label: string; Message: TMsg; Settings: Confirms.Options);
  // Show model-owned work feedback and propose a message only while idle.
  StatusAction(Id: string; Label: string; State: Status.Status; Message: TMsg; Settings: Status.Options);
  // Propose an appearance selection through a controlled segmented selector.
  ThemeChoice(Id: string; Selected: ThemeSwitchers.Selection; OnChange: function(ThemeSwitchers.Selection): TMsg; Settings: ThemeSwitchers.Options);
  // Propose the opposite concrete light/dark appearance through a compact action.
  ThemeFlip(Id: string; Appearance: Themes.Mode; OnChange: function(Themes.Mode): TMsg; Enabled: bool);
  // Select one positional choice through native CUI segments or terminal cells.
  Segments(Id: string; Items: array of Segmented.Item; Selected: int; OnChange: function(int): TMsg; Settings: Segmented.Options);
  // Propose independent or exclusive changes through a native CUI toggle group.
  Toggles(
    Id: string; Items: array of ToggleGroups.Item; Selected: array of bool;
    OnChange: function(array of bool): TMsg; Settings: ToggleGroups.Options
  );
  // A main action and a host-owned popup of related actions.
  SplitAction(Id: string; Label: string; Message: TMsg; Items: array of Split.Item<TMsg>; Settings: Split.Options);
  // Native reaction pills with controlled counts and activation.
  ReactionGroup(Id: string; Items: array of Reactions.Item; OnChange: function(int, Reactions.Item): TMsg; Enabled: bool);
  // Native account trigger and its command popup.
  AccountMenu(Id: string; Name: string; Entries: array of Menus.Entry<TMsg>; Settings: UserMenus.Options);
  // Native floating trigger and ordered actions.
  SpeedDialAction(Id: string; Items: array of Speed.Item; OnChoose: function(int): TMsg; Settings: Speed.Options);
  // Foreground content with native swipe actions on either side.
  SwipeRow(Id: string; Content: Element<TMsg>; Left: array of Swipe.Item; Right: array of Swipe.Item; OnChoose: function(Swipe.Side, int): TMsg; Settings: Swipe.Options);
  // Propose a changed checkbox value through native CUI.
  CheckboxAction(Id: string; Label: string; Checked: bool; OnChange: function(bool): TMsg; Description: string; Enabled: bool; Indeterminate: bool);
  // Propose a changed switch value through native CUI.
  SwitchAction(Id: string; Label: string; On: bool; OnChange: function(bool): TMsg; Description: string; Enabled: bool);
  // Propose selecting one native CUI radio row.
  RadioAction(Id: string; Label: string; Selected: bool; OnSelect: function(): TMsg; Description: string; Enabled: bool);
  // Select one of the native radio rows in positional order.
  Radios(Id: string; Items: array of RadioGroups.Item; Selected: int; OnChange: function(int): TMsg; Enabled: bool; Gap: L.Spacing);
  // Select one card through the native CUI grid.
  Cards(Id: string; Items: array of RadioCards.Item; Selected: int; OnChange: function(int): TMsg; Settings: RadioCards.Options);
  // Propose one adjusted native slider value.
  SliderAction(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: Sliders.Options);
  // Propose both endpoints of a native range slider in one message.
  RangeSliderAction(Id: string; Label: string; Value: RangeSliders.Interval; Minimum: float; Maximum: float; OnChange: function(RangeSliders.Interval): TMsg; Enabled: bool);
  // A native file drop target with an optional browse action.
  Dropzone(Id: string; OnDrop: function(array of string): TMsg; OnBrowse: Sys.Func<TMsg>?; Settings: Dropzones.Options);
  // A native avatar with image drop and an optional browse action.
  AvatarUpload(Id: string; Name: string; Path: string?; OnDrop: function(string): TMsg; OnBrowse: Sys.Func<TMsg>?; Size: float; Enabled: bool);
  // A native drawing pad for signatures and its Clear action.
  SignaturePad(Id: string; OnChange: Sys.Func<Signatures.Signature, TMsg>?; Settings: Signatures.Options);
  // A native rotary control.
  Knob(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: Knobs.Options);
  // A native mixer fader.
  Fader(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: Faders.Options);
  // A native ruler with a movable tape.
  RulerSlider(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: Rulers.Options);
  // A native histogram with an adjustable range.
  HistogramSlider(Id: string; Label: string; Bins: array of float; Value: RangeSliders.Interval; Minimum: float; Maximum: float; OnChange: function(RangeSliders.Interval): TMsg; Settings: Histograms.Options);
  // Toggle an independent graphical selection.
  ChipAction(Id: string; Label: string; Selected: bool; OnChange: function(bool): TMsg; Icon: string; Enabled: bool);
  // Select a graphical whole-star rating.
  RatingAction(Id: string; Label: string; Value: int; OnChange: function(int): TMsg; Maximum: int; Enabled: bool);
  // Select a tab in a native graphical strip.
  TabStrip(Id: string; Items: array of Tabs.Item; Selected: int; OnChange: function(int): TMsg; Settings: Tabs.Options);
  // Navigate to an ancestor in a graphical breadcrumb trail.
  BreadcrumbTrail(Id: string; Items: array of string; OnNavigate: function(int): TMsg; Enabled: bool);
  // Select a page in a native graphical pager.
  PaginationAction(Id: string; Page: int; PageCount: int; OnChange: function(int): TMsg; Enabled: bool);
  // Display model-owned progress through a graphical sequence of steps.
  StepProgress(Id: string; Steps: array of string; Current: int);
  // Join adjacent buttons under a shared outline.
  ButtonGroup(Children: array of Element<TMsg>);
  // Open a native command menu from one trigger.
  Dropdown(Id: string; Label: string; Entries: array of Menus.Entry<TMsg>; Settings: Menus.Options);
  // Attach CUI's GUI-only right-click menu to a target component.
  Contextual(Id: string; Target: Element<TMsg>; Entries: array of Menus.Entry<TMsg>; Enabled: bool);
  // Attach graphical hover help to one interactive control.
  Hinted(Target: Element<TMsg>; Text: string; Shortcut: string);
  // Edit one graphical line with a model-owned value.
  TextField(Id: string; Value: string; OnChange: function(string): TMsg; Settings: TextFields.Options; OnSubmit: Sys.Func<string, TMsg>?);
  // Native inline text with a retained draft and model-owned commit.
  InlineEdit(Id: string; Value: string; OnChange: function(string): TMsg; Settings: InlineEdits.Options);
  // Native draggable numeric field with an optional typing mode.
  ScrubField(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: ScrubFields.Options);
  // Native grouped monetary display and plain-digit editor.
  MoneyField(Id: string; Value: double; OnChange: function(double): TMsg; Settings: MoneyFields.Options);
  // Native key-combination recorder with a model-owned value.
  ShortcutRecorder(Id: string; Value: RecorderKeys.Combination; OnChange: function(RecorderKeys.Combination): TMsg; Settings: RecorderKeys.Options);
  // Native platform key names displayed as keycaps.
  ShortcutLabel(Value: RecorderKeys.Combination);
  // Edit one graphical search query with the native clear action.
  SearchField(Id: string; Value: string; OnChange: function(string): TMsg; Settings: SearchFields.Options; OnSubmit: Sys.Func<string, TMsg>?);
  // Edit wrapping multiline graphical text.
  TextArea(Id: string; Value: string; OnChange: function(string): TMsg; Settings: TextAreas.Options; OnSubmit: Sys.Func<string, TMsg>?);
  // Edit an ordered list of tags.
  TagInput(Id: string; Tags: array of string; OnChange: function(array of string): TMsg; Settings: TagInputs.Options);
  // Enter a fixed-length ASCII alphanumeric verification code.
  OneTimeCodeInput(Id: string; Value: string; OnChange: function(string): TMsg; Settings: OneTimeCodes.Options; OnComplete: Sys.Func<string, TMsg>?);
  // Show CUI's visual strength score for a password.
  PasswordStrengthMeter(Id: string; Password: string);
  // Choose an option by position, with optional filtering.
  SelectInput(Id: string; Items: array of Selects.Item; Selected: int; OnChange: function(int): TMsg; Settings: Selects.Options);
  // Native multi-select with model-owned flags.
  MultiSelectInput(Id: string; Items: array of Selects.Item; Selected: array of bool; OnChange: function(array of bool): TMsg; Settings: Multi.Options);
  // Inline calendar for a model-owned range.
  RangeCalendar(Id: string; Value: Dates.Value; OnChange: function(Dates.Value): TMsg; Months: int; Enabled: bool);
  // Graphical date range field and its native popup.
  RangePicker(Id: string; Value: Dates.Value; OnChange: function(Dates.Value): TMsg; Settings: RangePickers.Options);
  // An inline calendar with a single model-owned selection.
  Calendar(Id: string; Value: Sys.DateOnly?; OnChange: function(Sys.DateOnly): TMsg; Enabled: bool);
  // A date field with a single-month calendar popup.
  DatePicker(Id: string; Value: Sys.DateOnly?; OnChange: function(Sys.DateOnly): TMsg; Settings: DatePickers.Options);
  // A native swatch field and RGB palette.
  ColorPicker(Id: string; Value: G.Color; OnChange: function(G.Color): TMsg; Enabled: bool);
  // A searchable native emoji palette with model-owned history and tone.
  EmojiPicker(Id: string; Value: EmojiPickers.State; OnChange: function(EmojiPickers.Change): TMsg; Settings: EmojiPickers.Options);
  // A native field with hour and minute columns.
  TimePicker(Id: string; Value: Sys.TimeOnly; OnChange: function(Sys.TimeOnly): TMsg; Settings: TimePickers.Options);
  // A native wheel that selects one caption by index.
  WheelPicker(Id: string; Items: array of string; Selected: int; OnChange: function(int): TMsg; Settings: WheelPickers.Options);
  // A native analog face for choosing the hour and minute.
  TimeDial(Id: string; Value: Sys.TimeOnly; OnChange: function(Sys.TimeOnly): TMsg; Size: float; Enabled: bool);
  // Edit a bounded number with native step buttons.
  NumberField(Id: string; Value: double; Minimum: double; Maximum: double; OnChange: function(double): TMsg; Settings: NumberFields.Options);
  // Present a native centered modal over the base view.
  Dialog(Id: string; Base: Element<TMsg>; Content: Element<TMsg>; Open: bool; Settings: Dialogs.Options; OnDismiss: TMsg);
  // Lay actions out in CUI's right-aligned footer.
  ActionFooter(Children: array of Element<TMsg>);
  // Attach a model-controlled floating view to a button.
  Popover(Id: string; Trigger: Element<TMsg>; Content: Element<TMsg>; Open: bool; OnDismiss: TMsg; Settings: Popovers.Options);
  // Ask for confirmation at an existing button.
  ConfirmPopover(Id: string; Trigger: Element<TMsg>; Open: bool; Settings: ConfirmPopovers.Options; OnConfirm: TMsg; OnDismiss: TMsg);
  // Display grouped destinations with a single model-owned active key.
  Sidebar(Id: string; Sections: array of N.Section<TMsg>; ActiveKey: string?; Enabled: bool);
  // Arrange children in the native equal-width responsive grid.
  Grid(Settings: Grids.Options; Children: array of Element<TMsg>);
  // Draw a native card around its children.
  Card(Id: string; Children: array of Element<TMsg>; Settings: Cards.Options; OnActivate: Sys.Func<TMsg>?);
  // Draw a tinted or solid label.
  Badge(Id: string; Text: string; Settings: Badges.Options);
  // Display CUI's native sankey.
  Sankey(Id: string; Nodes: array of Sankeys.Node; Links: array of Sankeys.Link; Settings: Sankeys.Options; OnActivate: Sys.Func<Sankeys.Selection, TMsg>?);
  // Display CUI's native bar-list.
  BarList(Id: string; Items: array of Charts.Item; Settings: BarLists.Options; OnActivate: Sys.Func<int, TMsg>?);
  // Display CUI's native activity-rings.
  ActivityRings(Id: string; Items: array of Charts.Item; Settings: ActivityRings.Options; OnActivate: Sys.Func<int, TMsg>?);
  // Display CUI's native scatter-chart.
  ScatterChart(Id: string; Series: array of ScatterCharts.Series; Settings: ScatterCharts.Options; OnActivate: Sys.Func<ScatterCharts.PointIndex, TMsg>?);
  // Display CUI's native radial-gauge.
  RadialGauge(Id: string; Value: float; Minimum: float; Maximum: float; Settings: RadialGauges.Options);
  // Display CUI's native candlestick.
  Candlestick(Id: string; Candles: array of Candlesticks.Candle; Settings: Candlesticks.Options; OnCursorChange: Sys.Func<int, TMsg>?);
  // Display CUI's native heatmap.
  Heatmap(Id: string; Values: array of float; Rows: int; Columns: int; Settings: Heatmaps.Options; OnActivate: Sys.Func<Heatmaps.Cell, TMsg>?);
  // Display CUI's native calendar-heatmap.
  CalendarHeatmap(Id: string; Start: Sys.DateOnly; Values: array of float; Settings: CalendarHeatmaps.Options; OnActivate: Sys.Func<Sys.DateOnly, TMsg>?);
  // Display CUI's native treemap.
  Treemap(Id: string; Items: array of Charts.Item; Selected: int; OnSelect: Sys.Func<int, TMsg>?; Settings: Treemaps.Options);
  // Display CUI's native radar-chart.
  RadarChart(Id: string; Series: array of Charts.Series; Axes: array of string; Settings: RadarCharts.Options; OnActivate: Sys.Func<int, TMsg>?);
  // Display CUI's native funnel.
  Funnel(Id: string; Items: array of Charts.Item; Settings: Funnels.Options; OnActivate: Sys.Func<int, TMsg>?);
  // Display CUI's native split-bar.
  SplitBar(Id: string; Items: array of Charts.Item; Settings: SplitBars.Options; OnActivate: Sys.Func<int, TMsg>?);
  // Display CUI's native waffle.
  Waffle(Id: string; Items: array of Charts.Item; Settings: Waffles.Options; OnActivate: Sys.Func<int, TMsg>?);
  // Display a native line or area chart.
  LineChart(Id: string; Series: array of Charts.Series; Settings: Charts.Options);
  // Display a native grouped or stacked bar chart.
  BarChart(Id: string; Series: array of Charts.Series; Settings: Charts.Options);
  // Display a native responsive donut and its share legend.
  DonutChart(Id: string; Values: array of float; Labels: array of string; Settings: Donuts.Options);
  // Display a native animated fraction gauge.
  Gauge(Id: string; Label: string; Value: float; Size: float);
  // Display a native capacity bar with patterned segments and keyboard selection.
  PatternMeter(Id: string; Parts: array of Patterns.Part; Settings: Patterns.Options);
  // Display a native metric tile.
  Metric(Id: string; Label: string; Value: string; Settings: Metrics.Options);
  // Draw overlapping avatars and an overflow count.
  AvatarGroup(Id: string; Names: array of string; Settings: AvatarGroups.Options);
  // Draw an empty-state message and its optional native action.
  EmptyState(Id: string; Title: string; Settings: EmptyStates.Options; OnAction: Sys.Func<TMsg>?);
  // Lay children out along one axis in order.
  Stack(Children: array of Element<TMsg>; Horizontal: bool; Settings: L.Flow);
  // Place graphical children on top of each other using native CUI layout.
  Layered(Children: array of Element<TMsg>; Settings: L.Flow);
  // Draw a native model-controlled spotlight tour over its base view.
  Tour(
    Id: string; Base: Element<TMsg>; Steps: array of Tours.Step; Current: int;
    OnChange: function(Tours.Change): TMsg; Settings: Tours.Options
  );
  // Insert a native flexible gap along the containing axis.
  Spacer;
  // Insert a native fixed gap along the containing axis.
  Gap(Distance: L.Measure);
  // Adjust the allocation of one child.
  Sized(Child: Element<TMsg>; Settings: L.Flex);
  // Apply the host theme's semantic role to one child.
  Styled(Child: Element<TMsg>; Role: S.Role);
  // Frame one child with an optional title.
  Framed(Child: Element<TMsg>; Title: string);
  // A native outline linked to an uncontrolled scroll viewport.
  TableOfContents(Id: string; ScrollId: string; Items: array of Toc.Item; OnActiveChange: Sys.Func<string, TMsg>?; Enabled: bool);
  // A zero-height destination inside a graphical viewport.
  ScrollAnchor(Id: string);
  // Clip one child to a vertical viewport with optional model-controlled scrolling.
  Scroll(
    Id: string; Child: Element<TMsg>; Position: L.ScrollPosition?;
    OnScroll: Sys.Func<L.ScrollChange, TMsg>?; ShowScrollbar: bool; FadeEdges: bool; Horizontal: bool
  );
  // Place a controlled, scrollable modal at one viewport edge.
  Sheet(
    Id: string; Base: Element<TMsg>; Content: Element<TMsg>; Open: bool;
    Settings: Sheets.Options; OnDismiss: TMsg
  );
  // Resolve a typed cached subtree by comparing its dependencies.
  Deferred(Id: string; Resolve: function(CacheEntry<TMsg>?): CacheEntry<TMsg>);
  // Apply terminal-specific RGB styling to a subtree.
  TerminalStyle(Child: Element<TMsg>; Colors: T.Style);
  // Compose terminal content, floating layers and scoped shortcuts.
  TerminalScreen(Content: Element<TMsg>; Layers: array of Element<TMsg>; Shortcuts: array of Keys.ShortcutBinding<TMsg>);
  // Resolve a terminal-specific subtree using exact cell dimensions.
  TerminalViewport(Id: string; Build: function(T.Viewport): Element<TMsg>);
end variant;

// A host-owned cache entry for one typed subview.
//
// ## Type parameters
// - `TMsg`: The application message type.
public type CacheEntry<TMsg> = record
  // The captured dependency value, boxed with its original type.
  public Dependencies: Sys.Object;
  // The view built for those dependencies.
  public Tree: Element<TMsg>;
end record;

type DependencyBox<TDeps> = record
  public Value: TDeps;
end record;

// Displays a text label.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Text`: The visible text.
//
// ## Returns
// The declarative widget.
public function Text<TMsg>(Text: string): Element<TMsg>;
begin
  return Element<TMsg>.Label(Text);
end function;

// Separates adjacent content.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Title`: The optional separator caption.
//
// ## Returns
// The declarative widget.
public function Divider<TMsg>(Title: string := ''): Element<TMsg>;
begin
  return Element<TMsg>.Separator(Title);
end function;

// Inserts CUI's flexible space along the containing axis.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Returns
// A GUI-only flexible gap.
public function Spacer<TMsg>(): Element<TMsg>;
begin
  return Element<TMsg>.Spacer;
end function;

// Inserts CUI's fixed space along the containing axis.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Distance`: Nonnegative logical distance.
// ## Returns
// A GUI-only fixed gap.
public function Gap<TMsg>(Distance: L.Measure): Element<TMsg>;
begin
  return Element<TMsg>.Gap(Distance);
end function;

// Arranges children horizontally with default spacing.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Row<TMsg>(params Children: array of Element<TMsg>): Element<TMsg>;
begin
  return Element<TMsg>.Stack(Children, true, new L.Flow());
end function;

// Arranges children horizontally with explicit spacing and alignment.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Settings`: The stack's spacing and alignment.
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Row<TMsg>(Settings: L.Flow; params Children: array of Element<TMsg>): Element<TMsg>;
begin
  return Element<TMsg>.Stack(Children, true, Settings);
end function;

// Arranges children vertically with default spacing.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Column<TMsg>(params Children: array of Element<TMsg>): Element<TMsg>;
begin
  return Element<TMsg>.Stack(Children, false, new L.Flow());
end function;

// Arranges children vertically with explicit spacing and alignment.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Settings`: The stack's spacing and alignment.
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Column<TMsg>(Settings: L.Flow; params Children: array of Element<TMsg>): Element<TMsg>;
begin
  return Element<TMsg>.Stack(Children, false, Settings);
end function;

// Sets the sizing behavior of a child.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The subtree to allocate.
// - `Settings`: The basis, constraints and weights.
//
// ## Returns
// The declarative widget.
public function Size<TMsg>(Child: Element<TMsg>; Settings: L.Flex): Element<TMsg>;
begin
  return Element<TMsg>.Sized(Child, Settings);
end function;

// Applies a semantic style role.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The subtree to style.
// - `Role`: The role resolved by the current host theme.
//
// ## Returns
// The declarative widget.
public function Styled<TMsg>(Child: Element<TMsg>; Role: S.Role): Element<TMsg>;
begin
  return Element<TMsg>.Styled(Child, Role);
end function;

// Frames a child.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The enclosed view.
// - `Title`: The optional title.
//
// ## Returns
// The declarative widget.
public function Border<TMsg>(Child: Element<TMsg>; Title: string := ''): Element<TMsg>;
begin
  return Element<TMsg>.Framed(Child, Title);
end function;

// Displays a vertical viewport whose offset belongs to the host.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Id`: The stable viewport ID.
// - `Child`: The scrollable content.
// - `ShowScrollbar`: Whether to show an overflow indicator.
// - `FadeEdges`: Whether the graphical viewport fades edges with hidden content.
// - `Horizontal`: Also enable graphical horizontal scrolling; model positions remain vertical.
//
// ## Returns
// The declarative widget.
public function ScrollView<TMsg>(Id: string; Child: Element<TMsg>; ShowScrollbar: bool := true; FadeEdges: bool := false; Horizontal: bool := false): Element<TMsg>;
begin
  return Element<TMsg>.Scroll(Id, Child, null, null, ShowScrollbar, FadeEdges, Horizontal);
end function;

// Displays a vertical viewport whose position belongs to the model.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Id`: The stable viewport ID.
// - `Child`: The scrollable content.
// - `Position`: The model's requested position.
// - `OnScroll`: Maps a user scroll request and resolution to a message.
// - `ShowScrollbar`: Whether to show an overflow indicator.
// - `FadeEdges`: Whether the graphical viewport fades edges with hidden content.
// - `Horizontal`: Also enable graphical horizontal scrolling; model positions remain vertical.
//
// ## Returns
// The declarative widget.
public function ScrollView<TMsg>(Id: string; Child: Element<TMsg>; Position: L.ScrollPosition; OnScroll: function(L.ScrollChange): TMsg; ShowScrollbar: bool := true; FadeEdges: bool := false; Horizontal: bool := false): Element<TMsg>;
begin
  return Element<TMsg>.Scroll(Id, Child, Position, OnScroll, ShowScrollbar, FadeEdges, Horizontal);
end function;

// Applies terminal-specific RGB colors.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The subtree to style.
// - `Colors`: The terminal color overrides.
//
// ## Returns
// The declarative widget.
public function CellStyled<TMsg>(Child: Element<TMsg>; Colors: T.Style): Element<TMsg>;
begin
  return Element<TMsg>.TerminalStyle(Child, Colors);
end function;

// Reuses a subtree while its typed dependencies compare equal.
//
// ## Type parameters
// - `TDeps`: The type of dependencies captured for the view.
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Id`: The stable subview ID.
// - `Dependencies`: Every input that can affect the subtree.
// - `Build`: Builds the subtree from its dependencies.
// - `Equal`: Compares old and current dependencies.
//
// ## Returns
// The deferred subtree.
public function CachedSubview<TDeps, TMsg>(
  Id: string; Dependencies: TDeps; Build: function(TDeps): Element<TMsg>; Equal: function(TDeps, TDeps): bool
): Element<TMsg>;
  function Resolve(Previous: CacheEntry<TMsg>?): CacheEntry<TMsg>;
  begin
    if Previous <> null and Previous.Dependencies is DependencyBox<TDeps> then
      const Old: DependencyBox<TDeps> := cast<DependencyBox<TDeps>>(Previous.Dependencies);
      if Equal(Old.Value, Dependencies) then
        return Previous;
      end if;
    end if;

    return new CacheEntry<TMsg>(new DependencyBox<TDeps>(Dependencies), Build(Dependencies));
  end function;
begin
  return Element<TMsg>.Deferred(Id, Resolve);
end function;

end unit;
