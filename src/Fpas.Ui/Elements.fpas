  Fpas.Ui.Widgets.Planning.TimelineItems as Timeline,
  Fpas.Ui.Widgets.Feedback.Alerts as Alerts, Fpas.Ui.Widgets.Feedback.ProgressBars as ProgressBars, Fpas.Ui.Widgets.Containers.ExpandableTexts as ExpandableTexts, Fpas.Ui.Widgets.Containers.ExpandableCards as ExpandableCards, Fpas.Ui.Widgets.Conversation.Reactions as Reactions, Fpas.Ui.Widgets.Overlays.UserMenus as UserMenus, Fpas.Ui.Widgets.Inputs.Selects as Selects, Fpas.Ui.Widgets.Inputs.NumberFields as NumberFields, Fpas.Ui.Widgets.Inputs.TagInputs as TagInputs, Fpas.Ui.Widgets.Inputs.OneTimeCodes as OneTimeCodes, Fpas.Ui.Widgets.Inputs.SearchFields as SearchFields, Fpas.Ui.Widgets.Inputs.TextAreas as TextAreas, Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs, Fpas.Ui.Widgets.Inputs.TextFields as TextFields, Fpas.Ui.Widgets.Overlays.Popovers as Popovers, Fpas.Ui.Widgets.Overlays.ConfirmPopovers as ConfirmPopovers, Fpas.Ui.Widgets.Navigation.Tabs as Tabs, Fpas.Ui.Widgets.Inputs.RadioCards as RadioCards, Fpas.Ui.Widgets.Inputs.Sliders as Sliders, Fpas.Ui.Widgets.Inputs.RangeSliders as RangeSliders, Fpas.Ui.Widgets.Inputs.RadioGroups as RadioGroups, Fpas.Ui.Widgets.Actions.ToggleGroups as ToggleGroups, Fpas.Ui.Widgets.Overlays.Menus as Menus, Fpas.Ui.Widgets.Actions.SegmentedControls as Segmented, Fpas.Ui.Widgets.Theming.Themes as Themes, Fpas.Ui.Widgets.Theming.ThemeSwitchers as ThemeSwitchers, Fpas.Ui.Widgets.Actions.StatusButtons as Status, Fpas.Ui.Widgets.Actions.ConfirmButtons as Confirms, Fpas.Ui.Widgets.Actions.SplitButtons as Split, Fpas.Ui.Widgets.Actions.HoldButtons as Holds, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Navigation.Navigation as N, Fpas.Ui.Widgets.Overlays.Sheets as Sheets, Fpas.Ui.Widgets.Actions.Buttons as B, Fpas.Ui.Widgets.Actions.IconButtons as Icons, Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Developer.Terminal as T, Fpas.Ui.TerminalExtensions.Input as Keys, Fpas.Ui.Graphics as G, System as Sys;

// A declarative view for a host to prepare and present.
//
// ## Type parameters
// - `TMsg`: The application message type.
public type Element<TMsg> = variant
  // Draw a native inline link.
  LinkAction(Id: string; Label: string; OnActivate: TMsg; Enabled: bool);
  // Display native initials or a picture with an optional presence dot.
  Avatar(Id: string; Name: string; Settings: Avatars.Options);
  // Attach a native pointer-driven panel to an interactive control.
  HoverCard(Id: string; Trigger: Element<TMsg>; Content: Element<TMsg>; Settings: HoverCards.Options);
  // Display a native banner with model-owned visibility.
  Banner(Id: string; Text: string; Open: bool; OnDismiss: Sys.Func<TMsg>?; OnAction: Sys.Func<TMsg>?; Settings: Banners.Options);
  // Display CUI's rolling countdown tiles.
  Countdown(Id: string; SecondsLeft: double; Settings: Countdowns.Options);
  // Display CUI's onboarding checklist and its native progress.
  Checklist(Id: string; Steps: array of Checklists.Step; OnToggle: function(int, bool): TMsg; OnAction: Sys.Func<int, TMsg>?; Settings: Checklists.Options);
  // Display a native inline alert with CUI-owned dismissal.
  Alert(Id: string; Title: string; Settings: Alerts.Options; OnDismiss: Sys.Func<TMsg>?);
  // Display a native progress fraction or activity animation.
  ProgressBar(Id: string; Value: float; Settings: ProgressBars.Options);
  // Display a native activity spinner.
  Spinner(Id: string; Size: float; Settings: Spinners.Options?);
  // Display linear audio peaks on a native dBFS scale.
  LevelMeter(Id: string; Peaks: array of float; Settings: Levels.Options; OnClipCleared: Sys.Func<TMsg>?);
  // Display native capacity usage and its threshold color.
  Meter(Id: string; Label: string; Used: float; Total: float; Unit: string);
  // Display native circular progress with a literal caption.
  ProgressRing(Id: string; Label: string; Value: float; Size: float);
  // Display a native loading placeholder with parent-relative width support.
  Skeleton(Id: string; Width: L.Extent; Height: float);
  // Display a native activity entry with its optional time and connector.
  TimelineItem(Id: string; Title: string; Settings: Timeline.Options);
  // Open a model-controlled native accordion body.
  Accordion(Id: string; Title: string; Open: bool; OnChange: function(bool): TMsg; Content: Element<TMsg>; Enabled: bool);
  // Open a model-controlled native card body.
  ExpandableCard(Id: string; Title: string; Open: bool; OnChange: function(bool): TMsg; Content: Element<TMsg>; Settings: ExpandableCards.Options);
  // Let CUI clamp and expand wrapping text locally.
  ExpandableText(Id: string; Text: string; Settings: ExpandableTexts.Options; OnToggle: Sys.Func<TMsg>?);
  // Display text.
  Label(Text: string);
  // Static text with an explicit native typeface, size and color.
  FormattedText(Text: string; Font: Motion.Font; Size: float; Color: G.Color);
  // Separate adjacent content, with an optional caption.
  Separator(Title: string);
  // Activate a button with model-owned presentation and input settings.
  ButtonAction(Id: string; Text: string; Message: TMsg; Settings: B.Options);
  // Activate a named icon button with a stable identity and model-owned settings.
  IconAction(Id: string; Icon: string; Tooltip: string; Message: TMsg; Settings: Icons.Options);
  // Submit literal text to the clipboard and optionally propose a message.
  CopyAction(Id: string; Text: string; OnCopied: Sys.Func<TMsg>?; Enabled: bool);
  // Propose a message after a deliberate hold.
  HoldAction(Id: string; Label: string; Message: TMsg; Settings: Holds.Options);
  // Propose a message after two activations within a confirmation window.
  ConfirmAction(Id: string; Label: string; Message: TMsg; Settings: Confirms.Options);
  // Show model-owned work feedback and propose a message only while idle.
  StatusAction(Id: string; Label: string; State: Status.Status; Message: TMsg; Settings: Status.Options);
  // Propose an appearance selection through a controlled segmented selector.
  ThemeChoice(Id: string; Selected: ThemeSwitchers.Selection; OnChange: function(ThemeSwitchers.Selection): TMsg; Settings: ThemeSwitchers.Options);
  // Propose the opposite concrete light/dark appearance through a compact action.
  ThemeFlip(Id: string; Appearance: Themes.Mode; OnChange: function(Themes.Mode): TMsg; Enabled: bool);
  // Select one positional choice through native CUI segments or terminal cells.
  Segments(Id: string; Items: array of Segmented.Item; Selected: int; OnChange: function(int): TMsg; Settings: Segmented.Options);
  // Propose independent or exclusive changes through a native CUI toggle group.
  Toggles(
    Id: string; Items: array of ToggleGroups.Item; Selected: array of bool;
    OnChange: function(array of bool): TMsg; Settings: ToggleGroups.Options
  );
  // A main action and a host-owned popup of related actions.
  SplitAction(Id: string; Label: string; Message: TMsg; Items: array of Split.Item<TMsg>; Settings: Split.Options);
  // Native reaction pills with controlled counts and activation.
  ReactionGroup(Id: string; Items: array of Reactions.Item; OnChange: function(int, Reactions.Item): TMsg; Enabled: bool);
  // Native account trigger and its command popup.
  AccountMenu(Id: string; Name: string; Entries: array of Menus.Entry<TMsg>; Settings: UserMenus.Options);
  // Native floating trigger and ordered actions.
  SpeedDialAction(Id: string; Items: array of Speed.Item; OnChoose: function(int): TMsg; Settings: Speed.Options);
  // Foreground content with native swipe actions on either side.
  SwipeRow(Id: string; Content: Element<TMsg>; Left: array of Swipe.Item; Right: array of Swipe.Item; OnChoose: function(Swipe.Side, int): TMsg; Settings: Swipe.Options);
  // Propose a changed checkbox value through native CUI.
  CheckboxAction(Id: string; Label: string; Checked: bool; OnChange: function(bool): TMsg; Description: string; Enabled: bool; Indeterminate: bool; HideLabel: bool);
  // Propose a changed switch value through native CUI.
  SwitchAction(Id: string; Label: string; On: bool; OnChange: function(bool): TMsg; Description: string; Enabled: bool);
  // Propose selecting one native CUI radio row.
  RadioAction(Id: string; Label: string; Selected: bool; OnSelect: function(): TMsg; Description: string; Enabled: bool);
  // Select one of the native radio rows in positional order.
  Radios(Id: string; Items: array of RadioGroups.Item; Selected: int; OnChange: function(int): TMsg; Enabled: bool; Gap: L.Spacing);
  // Select one card through the native CUI grid.
  Cards(Id: string; Items: array of RadioCards.Item; Selected: int; OnChange: function(int): TMsg; Settings: RadioCards.Options);
  // Propose one adjusted native slider value.
  SliderAction(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: Sliders.Options);
  // Propose both endpoints of a native range slider in one message.
  RangeSliderAction(Id: string; Label: string; Value: RangeSliders.Interval; Minimum: float; Maximum: float; OnChange: function(RangeSliders.Interval): TMsg; Enabled: bool);
  // A native file drop target with an optional browse action.
  Dropzone(Id: string; OnDrop: function(array of string): TMsg; OnBrowse: Sys.Func<TMsg>?; Settings: Dropzones.Options);
  // A native avatar with image drop and an optional browse action.
  AvatarUpload(Id: string; Name: string; Path: string?; OnDrop: function(string): TMsg; OnBrowse: Sys.Func<TMsg>?; Size: float; Enabled: bool);
  // A native drawing pad for signatures and its Clear action.
  SignaturePad(Id: string; OnChange: Sys.Func<Signatures.Signature, TMsg>?; Settings: Signatures.Options);
  // A native rotary control.
  Knob(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: Knobs.Options);
  // A native mixer fader.
  Fader(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: Faders.Options);
  // A native ruler with a movable tape.
  RulerSlider(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: Rulers.Options);
  // A native histogram with an adjustable range.
  HistogramSlider(Id: string; Label: string; Bins: array of float; Value: RangeSliders.Interval; Minimum: float; Maximum: float; OnChange: function(RangeSliders.Interval): TMsg; Settings: Histograms.Options);
  // Toggle an independent graphical selection.
  ChipAction(Id: string; Label: string; Selected: bool; OnChange: function(bool): TMsg; Icon: string; Enabled: bool);
  // Select a graphical whole-star rating.
  RatingAction(Id: string; Label: string; Value: int; OnChange: function(int): TMsg; Maximum: int; Enabled: bool);
  // Select a tab in a native graphical strip.
  TabStrip(Id: string; Items: array of Tabs.Item; Selected: int; OnChange: function(int): TMsg; Settings: Tabs.Options);
  // Navigate to an ancestor in a graphical breadcrumb trail.
  BreadcrumbTrail(Id: string; Items: array of string; OnNavigate: function(int): TMsg; Enabled: bool);
  // Select a page in a native graphical pager.
  PaginationAction(Id: string; Page: int; PageCount: int; OnChange: function(int): TMsg; Enabled: bool);
  // Display model-owned progress through a graphical sequence of steps.
  StepProgress(Id: string; Steps: array of string; Current: int);
  // Join adjacent buttons under a shared outline.
  ButtonGroup(Children: array of Element<TMsg>);
  // Open a native command menu from one trigger.
  Dropdown(Id: string; Label: string; Entries: array of Menus.Entry<TMsg>; Settings: Menus.Options);
  // Attach CUI's GUI-only right-click menu to a target component.
  Contextual(Id: string; Target: Element<TMsg>; Entries: array of Menus.Entry<TMsg>; Enabled: bool);
  // Attach graphical hover help to one interactive control.
  Hinted(Target: Element<TMsg>; Text: string; Shortcut: string);
  // Edit one graphical line with a model-owned value.
  TextField(Id: string; Value: string; OnChange: function(string): TMsg; Settings: TextFields.Options; OnSubmit: Sys.Func<string, TMsg>?);
  // Native inline text with a retained draft and model-owned commit.
  InlineEdit(Id: string; Value: string; OnChange: function(string): TMsg; Settings: InlineEdits.Options);
  // Native draggable numeric field with an optional typing mode.
  ScrubField(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: ScrubFields.Options);
  // Native grouped monetary display and plain-digit editor.
  MoneyField(Id: string; Value: double; OnChange: function(double): TMsg; Settings: MoneyFields.Options);
  // Native key-combination recorder with a model-owned value.
  ShortcutRecorder(Id: string; Value: RecorderKeys.Combination; OnChange: function(RecorderKeys.Combination): TMsg; Settings: RecorderKeys.Options);
  // Native platform key names displayed as keycaps.
  ShortcutLabel(Value: RecorderKeys.Combination);
  // Edit one graphical search query with the native clear action.
  SearchField(Id: string; Value: string; OnChange: function(string): TMsg; Settings: SearchFields.Options; OnSubmit: Sys.Func<string, TMsg>?);
  // Edit wrapping multiline graphical text.
  TextArea(Id: string; Value: string; OnChange: function(string): TMsg; Settings: TextAreas.Options; OnSubmit: Sys.Func<string, TMsg>?);
  // Edit an ordered list of tags.
  TagInput(Id: string; Tags: array of string; OnChange: function(array of string): TMsg; Settings: TagInputs.Options);
  // Enter a fixed-length ASCII alphanumeric verification code.
  OneTimeCodeInput(Id: string; Value: string; OnChange: function(string): TMsg; Settings: OneTimeCodes.Options; OnComplete: Sys.Func<string, TMsg>?);
  // Show CUI's visual strength score for a password.
  PasswordStrengthMeter(Id: string; Password: string);
  // Choose an option by position, with optional filtering.
  SelectInput(Id: string; Items: array of Selects.Item; Selected: int; OnChange: function(int): TMsg; Settings: Selects.Options);
  // Native multi-select with model-owned flags.
  MultiSelectInput(Id: string; Items: array of Selects.Item; Selected: array of bool; OnChange: function(array of bool): TMsg; Settings: Multi.Options);
  // Inline calendar for a model-owned range.
  RangeCalendar(Id: string; Value: Dates.Value; OnChange: function(Dates.Value): TMsg; Months: int; Enabled: bool);
  // Graphical date range field and its native popup.
  RangePicker(Id: string; Value: Dates.Value; OnChange: function(Dates.Value): TMsg; Settings: RangePickers.Options);
  // An inline calendar with a single model-owned selection.
  Calendar(Id: string; Value: Sys.DateOnly?; OnChange: function(Sys.DateOnly): TMsg; Enabled: bool);
  // A date field with a single-month calendar popup.
  DatePicker(Id: string; Value: Sys.DateOnly?; OnChange: function(Sys.DateOnly): TMsg; Settings: DatePickers.Options);
  // A native swatch field and RGB palette.
  ColorPicker(Id: string; Value: G.Color; OnChange: function(G.Color): TMsg; Enabled: bool);
  // A searchable native emoji palette with model-owned history and tone.
  EmojiPicker(Id: string; Value: EmojiPickers.State; OnChange: function(EmojiPickers.Change): TMsg; Settings: EmojiPickers.Options);
  // A native field with hour and minute columns.
  TimePicker(Id: string; Value: Sys.TimeOnly; OnChange: function(Sys.TimeOnly): TMsg; Settings: TimePickers.Options);
  // A native wheel that selects one caption by index.
