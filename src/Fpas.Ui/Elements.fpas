unit Fpas.Ui.Elements;

uses Fpas.Ui.ExpandableTexts as ExpandableTexts, Fpas.Ui.ExpandableCards as ExpandableCards, Fpas.Ui.Reactions as Reactions, Fpas.Ui.UserMenus as UserMenus, Fpas.Ui.Selects as Selects, Fpas.Ui.NumberFields as NumberFields, Fpas.Ui.TagInputs as TagInputs, Fpas.Ui.OneTimeCodes as OneTimeCodes, Fpas.Ui.SearchFields as SearchFields, Fpas.Ui.TextAreas as TextAreas, Fpas.Ui.Dialogs as Dialogs, Fpas.Ui.TextFields as TextFields, Fpas.Ui.Popovers as Popovers, Fpas.Ui.ConfirmPopovers as ConfirmPopovers, Fpas.Ui.Tabs as Tabs, Fpas.Ui.RadioCards as RadioCards, Fpas.Ui.Sliders as Sliders, Fpas.Ui.RangeSliders as RangeSliders, Fpas.Ui.RadioGroups as RadioGroups, Fpas.Ui.ToggleGroups as ToggleGroups, Fpas.Ui.Menus as Menus, Fpas.Ui.SegmentedControls as Segmented, Fpas.Ui.Themes as Themes, Fpas.Ui.ThemeSwitchers as ThemeSwitchers, Fpas.Ui.StatusButtons as Status, Fpas.Ui.ConfirmButtons as Confirms, Fpas.Ui.SplitButtons as Split, Fpas.Ui.HoldButtons as Holds, Fpas.Ui.Layout as L, Fpas.Ui.Navigation as N, Fpas.Ui.Sheets as Sheets, Fpas.Ui.Buttons as B, Fpas.Ui.IconButtons as Icons, Fpas.Ui.Styles as S, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as Keys, Fpas.Ui.Graphics as G, System as Sys;

// A declarative view for a host to prepare and present.
//
// ## Type parameters
// - `TMsg`: The application message type.
public type Element<TMsg> = variant
  // Open a model-controlled native accordion body.
  Accordion(Id: string; Title: string; Open: bool; OnChange: function(bool): TMsg; Content: Element<TMsg>; Enabled: bool);
  // Open a model-controlled native card body.
  ExpandableCard(Id: string; Title: string; Open: bool; OnChange: function(bool): TMsg; Content: Element<TMsg>; Settings: ExpandableCards.Options);
  // Let CUI clamp and expand wrapping text locally.
  ExpandableText(Id: string; Text: string; Settings: ExpandableTexts.Options; OnToggle: Sys.Func<TMsg>?);
  // Display text.
  Label(Text: string);
  // Separate adjacent content, with an optional caption.
  Separator(Title: string);
  // Activate a button with model-owned presentation and input settings.
  ButtonAction(Id: string; Text: string; Message: TMsg; Settings: B.Options);
  // Activate a named icon button with a stable identity and model-owned settings.
  IconAction(Id: string; Icon: string; Tooltip: string; Message: TMsg; Settings: Icons.Options);
  // Submit literal text to the clipboard and optionally propose a message.
  CopyAction(Id: string; Text: string; OnCopied: Sys.Func<TMsg>?; Enabled: bool);
  // Propose a message after a deliberate hold.
  HoldAction(Id: string; Label: string; Message: TMsg; Settings: Holds.Options);
  // Propose a message after two activations within a confirmation window.
  ConfirmAction(Id: string; Label: string; Message: TMsg; Settings: Confirms.Options);
  // Show model-owned work feedback and propose a message only while idle.
  StatusAction(Id: string; Label: string; State: Status.Status; Message: TMsg; Settings: Status.Options);
  // Propose an appearance selection through a controlled segmented selector.
  ThemeChoice(Id: string; Selected: ThemeSwitchers.Selection; OnChange: function(ThemeSwitchers.Selection): TMsg; Settings: ThemeSwitchers.Options);
  // Propose the opposite concrete light/dark appearance through a compact action.
  ThemeFlip(Id: string; Appearance: Themes.Mode; OnChange: function(Themes.Mode): TMsg; Enabled: bool);
  // Select one positional choice through native CUI segments or terminal cells.
  Segments(Id: string; Items: array of Segmented.Item; Selected: int; OnChange: function(int): TMsg; Settings: Segmented.Options);
  // Propose independent or exclusive changes through a native CUI toggle group.
  Toggles(
    Id: string; Items: array of ToggleGroups.Item; Selected: array of bool;
    OnChange: function(array of bool): TMsg; Settings: ToggleGroups.Options
  );
  // A main action and a host-owned popup of related actions.
  SplitAction(Id: string; Label: string; Message: TMsg; Items: array of Split.Item<TMsg>; Settings: Split.Options);
  // Native reaction pills with controlled counts and activation.
  ReactionGroup(Id: string; Items: array of Reactions.Item; OnChange: function(int, Reactions.Item): TMsg; Enabled: bool);
  // Native account trigger and its command popup.
  AccountMenu(Id: string; Name: string; Entries: array of Menus.Entry<TMsg>; Settings: UserMenus.Options);
  // Propose a changed checkbox value through native CUI.
  CheckboxAction(Id: string; Label: string; Checked: bool; OnChange: function(bool): TMsg; Description: string; Enabled: bool; Indeterminate: bool);
  // Propose a changed switch value through native CUI.
  SwitchAction(Id: string; Label: string; On: bool; OnChange: function(bool): TMsg; Description: string; Enabled: bool);
  // Propose selecting one native CUI radio row.
  RadioAction(Id: string; Label: string; Selected: bool; OnSelect: function(): TMsg; Description: string; Enabled: bool);
  // Select one of the native radio rows in positional order.
  Radios(Id: string; Items: array of RadioGroups.Item; Selected: int; OnChange: function(int): TMsg; Enabled: bool; Gap: L.Spacing);
  // Select one card through the native CUI grid.
  Cards(Id: string; Items: array of RadioCards.Item; Selected: int; OnChange: function(int): TMsg; Settings: RadioCards.Options);
  // Propose one adjusted native slider value.
  SliderAction(Id: string; Label: string; Value: float; Minimum: float; Maximum: float; OnChange: function(float): TMsg; Settings: Sliders.Options);
  // Propose both endpoints of a native range slider in one message.
  RangeSliderAction(Id: string; Label: string; Value: RangeSliders.Interval; Minimum: float; Maximum: float; OnChange: function(RangeSliders.Interval): TMsg; Enabled: bool);
  // Toggle an independent graphical selection.
  ChipAction(Id: string; Label: string; Selected: bool; OnChange: function(bool): TMsg; Icon: string; Enabled: bool);
  // Select a graphical whole-star rating.
  RatingAction(Id: string; Label: string; Value: int; OnChange: function(int): TMsg; Maximum: int; Enabled: bool);
  // Select a tab in a native graphical strip.
  TabStrip(Id: string; Items: array of Tabs.Item; Selected: int; OnChange: function(int): TMsg; Settings: Tabs.Options);
  // Navigate to an ancestor in a graphical breadcrumb trail.
  BreadcrumbTrail(Id: string; Items: array of string; OnNavigate: function(int): TMsg; Enabled: bool);
  // Select a page in a native graphical pager.
  PaginationAction(Id: string; Page: int; PageCount: int; OnChange: function(int): TMsg; Enabled: bool);
  // Display model-owned progress through a graphical sequence of steps.
  StepProgress(Id: string; Steps: array of string; Current: int);
  // Join adjacent buttons under a shared outline.
  ButtonGroup(Children: array of Element<TMsg>);
  // Open a native command menu from one trigger.
  Dropdown(Id: string; Label: string; Entries: array of Menus.Entry<TMsg>; Settings: Menus.Options);
  // Attach CUI's GUI-only right-click menu to a target component.
  Contextual(Id: string; Target: Element<TMsg>; Entries: array of Menus.Entry<TMsg>; Enabled: bool);
  // Attach graphical hover help to one interactive control.
  Hinted(Target: Element<TMsg>; Text: string; Shortcut: string);
  // Edit one graphical line with a model-owned value.
  TextField(Id: string; Value: string; OnChange: function(string): TMsg; Settings: TextFields.Options; OnSubmit: Sys.Func<string, TMsg>?);
  // Edit one graphical search query with the native clear action.
  SearchField(Id: string; Value: string; OnChange: function(string): TMsg; Settings: SearchFields.Options; OnSubmit: Sys.Func<string, TMsg>?);
  // Edit wrapping multiline graphical text.
  TextArea(Id: string; Value: string; OnChange: function(string): TMsg; Settings: TextAreas.Options; OnSubmit: Sys.Func<string, TMsg>?);
  // Edit an ordered list of tags.
  TagInput(Id: string; Tags: array of string; OnChange: function(array of string): TMsg; Settings: TagInputs.Options);
  // Enter a fixed-length ASCII alphanumeric verification code.
  OneTimeCodeInput(Id: string; Value: string; OnChange: function(string): TMsg; Settings: OneTimeCodes.Options; OnComplete: Sys.Func<string, TMsg>?);
  // Show CUI's visual strength score for a password.
  PasswordStrengthMeter(Id: string; Password: string);
  // Choose an option by position, with optional filtering.
  SelectInput(Id: string; Items: array of Selects.Item; Selected: int; OnChange: function(int): TMsg; Settings: Selects.Options);
  // Edit a bounded number with native step buttons.
  NumberField(Id: string; Value: double; Minimum: double; Maximum: double; OnChange: function(double): TMsg; Settings: NumberFields.Options);
  // Present a native centered modal over the base view.
  Dialog(Id: string; Base: Element<TMsg>; Content: Element<TMsg>; Open: bool; Settings: Dialogs.Options; OnDismiss: TMsg);
  // Lay actions out in CUI's right-aligned footer.
  ActionFooter(Children: array of Element<TMsg>);
  // Attach a model-controlled floating view to a button.
  Popover(Id: string; Trigger: Element<TMsg>; Content: Element<TMsg>; Open: bool; OnDismiss: TMsg; Settings: Popovers.Options);
  // Ask for confirmation at an existing button.
  ConfirmPopover(Id: string; Trigger: Element<TMsg>; Open: bool; Settings: ConfirmPopovers.Options; OnConfirm: TMsg; OnDismiss: TMsg);
  // Display grouped destinations with a single model-owned active key.
  Sidebar(Id: string; Sections: array of N.Section<TMsg>; ActiveKey: string?; Enabled: bool);
  // Lay children out along one axis in order.
  Stack(Children: array of Element<TMsg>; Horizontal: bool; Settings: L.Flow);
  // Adjust the allocation of one child.
  Sized(Child: Element<TMsg>; Settings: L.Flex);
  // Apply the host theme's semantic role to one child.
  Styled(Child: Element<TMsg>; Role: S.Role);
  // Frame one child with an optional title.
  Framed(Child: Element<TMsg>; Title: string);
  // Clip one child to a vertical viewport with optional model-controlled scrolling.
  Scroll(
    Id: string; Child: Element<TMsg>; Position: L.ScrollPosition?;
    OnScroll: Sys.Func<L.ScrollChange, TMsg>?; ShowScrollbar: bool
  );
  // Place a controlled, scrollable modal at one viewport edge.
  Sheet(
    Id: string; Base: Element<TMsg>; Content: Element<TMsg>; Open: bool;
    Settings: Sheets.Options; OnDismiss: TMsg
  );
  // Resolve a typed cached subtree by comparing its dependencies.
  Deferred(Id: string; Resolve: function(CacheEntry<TMsg>?): CacheEntry<TMsg>);
  // Apply terminal-specific RGB styling to a subtree.
  TerminalStyle(Child: Element<TMsg>; Colors: T.Style);
  // Compose terminal content, floating layers and scoped shortcuts.
  TerminalScreen(Content: Element<TMsg>; Layers: array of Element<TMsg>; Shortcuts: array of Keys.ShortcutBinding<TMsg>);
  // Resolve a terminal-specific subtree using exact cell dimensions.
  TerminalViewport(Id: string; Build: function(T.Viewport): Element<TMsg>);
end variant;

// A host-owned cache entry for one typed subview.
//
// ## Type parameters
// - `TMsg`: The application message type.
public type CacheEntry<TMsg> = record
  // The captured dependency value, boxed with its original type.
  public Dependencies: Sys.Object;
  // The view built for those dependencies.
  public Tree: Element<TMsg>;
end record;

type DependencyBox<TDeps> = record
  public Value: TDeps;
end record;

// Displays a text label.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Text`: The visible text.
//
// ## Returns
// The declarative widget.
public function Text<TMsg>(Text: string): Element<TMsg>;
begin
  return Element<TMsg>.Label(Text);
end function;

// Separates adjacent content.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Title`: The optional separator caption.
//
// ## Returns
// The declarative widget.
public function Divider<TMsg>(Title: string := ''): Element<TMsg>;
begin
  return Element<TMsg>.Separator(Title);
end function;

// Arranges children horizontally with default spacing.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Row<TMsg>(params Children: array of Element<TMsg>): Element<TMsg>;
begin
  return Element<TMsg>.Stack(Children, true, new L.Flow());
end function;

// Arranges children horizontally with explicit spacing and alignment.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Settings`: The stack's spacing and alignment.
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Row<TMsg>(Settings: L.Flow; params Children: array of Element<TMsg>): Element<TMsg>;
begin
  return Element<TMsg>.Stack(Children, true, Settings);
end function;

// Arranges children vertically with default spacing.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Column<TMsg>(params Children: array of Element<TMsg>): Element<TMsg>;
begin
  return Element<TMsg>.Stack(Children, false, new L.Flow());
end function;

// Arranges children vertically with explicit spacing and alignment.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Settings`: The stack's spacing and alignment.
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Column<TMsg>(Settings: L.Flow; params Children: array of Element<TMsg>): Element<TMsg>;
begin
  return Element<TMsg>.Stack(Children, false, Settings);
end function;

// Sets the sizing behavior of a child.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The subtree to allocate.
// - `Settings`: The basis, constraints and weights.
//
// ## Returns
// The declarative widget.
public function Size<TMsg>(Child: Element<TMsg>; Settings: L.Flex): Element<TMsg>;
begin
  return Element<TMsg>.Sized(Child, Settings);
end function;

// Applies a semantic style role.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The subtree to style.
// - `Role`: The role resolved by the current host theme.
//
// ## Returns
// The declarative widget.
public function Styled<TMsg>(Child: Element<TMsg>; Role: S.Role): Element<TMsg>;
begin
  return Element<TMsg>.Styled(Child, Role);
end function;

// Frames a child.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The enclosed view.
// - `Title`: The optional title.
//
// ## Returns
// The declarative widget.
public function Border<TMsg>(Child: Element<TMsg>; Title: string := ''): Element<TMsg>;
begin
  return Element<TMsg>.Framed(Child, Title);
end function;

// Displays a vertical viewport whose offset belongs to the host.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Id`: The stable viewport ID.
// - `Child`: The scrollable content.
// - `ShowScrollbar`: Whether to show an overflow indicator.
//
// ## Returns
// The declarative widget.
public function ScrollView<TMsg>(Id: string; Child: Element<TMsg>; ShowScrollbar: bool := true): Element<TMsg>;
begin
  return Element<TMsg>.Scroll(Id, Child, null, null, ShowScrollbar);
end function;

// Displays a vertical viewport whose position belongs to the model.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Id`: The stable viewport ID.
// - `Child`: The scrollable content.
// - `Position`: The model's requested position.
// - `OnScroll`: Maps a user scroll request and resolution to a message.
// - `ShowScrollbar`: Whether to show an overflow indicator.
//
// ## Returns
// The declarative widget.
public function ScrollView<TMsg>(Id: string; Child: Element<TMsg>; Position: L.ScrollPosition; OnScroll: function(L.ScrollChange): TMsg; ShowScrollbar: bool := true): Element<TMsg>;
begin
  return Element<TMsg>.Scroll(Id, Child, Position, OnScroll, ShowScrollbar);
end function;

// Applies terminal-specific RGB colors.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The subtree to style.
// - `Colors`: The terminal color overrides.
//
// ## Returns
// The declarative widget.
public function CellStyled<TMsg>(Child: Element<TMsg>; Colors: T.Style): Element<TMsg>;
begin
  return Element<TMsg>.TerminalStyle(Child, Colors);
end function;

// Reuses a subtree while its typed dependencies compare equal.
//
// ## Type parameters
// - `TDeps`: The type of dependencies captured for the view.
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Id`: The stable subview ID.
// - `Dependencies`: Every input that can affect the subtree.
// - `Build`: Builds the subtree from its dependencies.
// - `Equal`: Compares old and current dependencies.
//
// ## Returns
// The deferred subtree.
public function CachedSubview<TDeps, TMsg>(
  Id: string; Dependencies: TDeps; Build: function(TDeps): Element<TMsg>; Equal: function(TDeps, TDeps): bool
): Element<TMsg>;
  function Resolve(Previous: CacheEntry<TMsg>?): CacheEntry<TMsg>;
  begin
    if Previous <> null and Previous.Dependencies is DependencyBox<TDeps> then
      const Old: DependencyBox<TDeps> := cast<DependencyBox<TDeps>>(Previous.Dependencies);
      if Equal(Old.Value, Dependencies) then
        return Previous;
      end if;
    end if;

    return new CacheEntry<TMsg>(new DependencyBox<TDeps>(Dependencies), Build(Dependencies));
  end function;
begin
  return Element<TMsg>.Deferred(Id, Resolve);
end function;
end unit;
