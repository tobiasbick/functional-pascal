  Spotlight(Id: string; Children: array of Element of TMsg; Settings: Spotlights.Options);
  // Native loader.
  Loader(Id: string; Style: Loaders.Animation; Settings: Loaders.Options);
  // Native dock.
  Dock(Id: string; Entries: array of Docks.Entry of TMsg; Settings: Docks.Options);
  // Native control tile.
  ControlTile(Id: string; Label: string; On: bool; Change: function(bool): TMsg; Settings: ControlTiles.Options);
  // Native now playing.
  NowPlaying(Id: string; Current: NowPlaying.Value; Change: function(NowPlaying.Event): TMsg; Settings: NowPlaying.Options);
  // Native waveform.
  Waveform(Id: string; Peaks: array of float; Progress: float?; Change: Sys.Func of (float, TMsg)?; Settings: Waveforms.Options);
  // Native tab bar.
  TabBar(Id: string; Items: array of TabBars.Item; Selected: int; Change: function(int): TMsg; Settings: TabBars.Options);
  // Native searchable modal command palette.
  CommandPalette(Id: string; Base: Element of TMsg; Open: bool; Commands: array of Palettes.Command of TMsg; Change: function(bool): TMsg; UseShortcut: bool);
  // Lay children out along one axis in order.
  Stack(Children: array of Element of TMsg; Horizontal: bool; Settings: L.Flow);
  // Place graphical children on top of each other using native CUI layout.
  Layered(Children: array of Element of TMsg; Settings: L.Flow);
  // Draw a native model-controlled spotlight tour over its base view.
  Tour(
    Id: string; Base: Element of TMsg; Steps: array of Tours.Step; Current: int;
    OnChange: function(Tours.Change): TMsg; Settings: Tours.Options
  );
  // Insert a native flexible gap along the containing axis.
  Spacer;
  // Insert a native fixed gap along the containing axis.
  Gap(Distance: L.Measure);
  // Adjust the allocation of one child.
  Sized(Child: Element of TMsg; Settings: L.Flex);
  // Apply the host theme's semantic role to one child.
  Styled(Child: Element of TMsg; Role: S.Role);
  // Frame one child with an optional title.
  Framed(Child: Element of TMsg; Title: string);
  // A native outline linked to an uncontrolled scroll viewport.
  TableOfContents(Id: string; ScrollId: string; Items: array of Toc.Item; OnActiveChange: Sys.Func of (string, TMsg)?; Enabled: bool);
  // A zero-height destination inside a graphical viewport.
  ScrollAnchor(Id: string);
  // Clip one child to a vertical viewport with optional model-controlled scrolling.
  Scroll(
    Id: string; Child: Element of TMsg; Position: L.ScrollPosition?;
    OnScroll: Sys.Func of (L.ScrollChange, TMsg)?; ShowScrollbar: bool; FadeEdges: bool; Horizontal: bool
  );
  // Place a controlled, scrollable modal at one viewport edge.
  Sheet(
    Id: string; Base: Element of TMsg; Content: Element of TMsg; Open: bool;
    Settings: Sheets.Options; OnDismiss: TMsg
  );
  // Resolve a typed cached subtree by comparing its dependencies.
  Deferred(Id: string; Resolve: function((CacheEntry of TMsg)?): CacheEntry of TMsg);
  // Apply terminal-specific RGB styling to a subtree.
  TerminalStyle(Child: Element of TMsg; Colors: T.Style);
  // Display a cell image and route its local input and size changes.
  TerminalCellGrid(Id: string; Content: CellGrids.Image?; Changed: function(CellGrids.Event): TMsg);
  // Show selectable rows with distinct selection and activation callbacks.
  TerminalSelectionList(
    Id: string; Items: array of SelectionLists.Item; SelectedKey: string;
    OnSelect: function(string): TMsg; OnActivate: function(string): TMsg
  );
  // Compose terminal content, floating layers and scoped shortcuts.
  TerminalScreen(Content: Element of TMsg; Layers: array of Element of TMsg; Shortcuts: array of Keys.ShortcutBinding of TMsg);
  // Resolve a terminal-specific subtree using exact cell dimensions.
  TerminalViewport(Id: string; Build: function(T.Viewport): Element of TMsg);
end variant;

// A host-owned cache entry for one typed subview.
//
// ## Type parameters
// - `TMsg`: The application message type.
public type CacheEntry of TMsg = record
  // The captured dependency value, boxed with its original type.
  public Dependencies: Sys.Object;
  // The view built for those dependencies.
  public Tree: Element of TMsg;
end record;

type DependencyBox of TDeps = record
  // Original dependency value used by the subview's equality check.
  public Value: TDeps;
end record;

// Displays a text label.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Text`: The visible text.
//
// ## Returns
// The declarative widget.
public function Text of TMsg(Text: string): Element of TMsg;
begin
  return (Element of TMsg).Label(Text);
end function;

// Displays text with explicit graphical typography.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Text`: Visible text.
// - `Font`: Native typeface.
// - `Size`: Logical font size, or zero to use the theme.
// - `Color`: Straight-alpha text color.
// ## Returns
// A label for the graphical profile.
public function FormattedText of TMsg(Text: string; Font: Motion.Font; Size: float; Color: G.Color): Element of TMsg;
begin
  return (Element of TMsg).FormattedText(Text, Font, Size, Color);
end function;

// Separates adjacent content.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Title`: The optional separator caption.
//
// ## Returns
// The declarative widget.
public function Divider of TMsg(Title: string := ''): Element of TMsg;
begin
  return (Element of TMsg).Separator(Title);
end function;

// Inserts CUI's flexible space along the containing axis.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Returns
// A GUI-only flexible gap.
public function Spacer of TMsg(): Element of TMsg;
begin
  return (Element of TMsg).Spacer;
end function;

// Inserts CUI's fixed space along the containing axis.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Distance`: Nonnegative logical distance.
// ## Returns
// A GUI-only fixed gap.
public function Gap of TMsg(Distance: L.Measure): Element of TMsg;
begin
  return (Element of TMsg).Gap(Distance);
end function;

// Arranges children horizontally with default spacing.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Row of TMsg(params Children: array of Element of TMsg): Element of TMsg;
begin
  return (Element of TMsg).Stack(Children, true, new L.Flow());
end function;

// Arranges children horizontally with explicit spacing and alignment.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Settings`: The stack's spacing and alignment.
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Row of TMsg(Settings: L.Flow; params Children: array of Element of TMsg): Element of TMsg;
begin
  return (Element of TMsg).Stack(Children, true, Settings);
end function;

// Arranges children vertically with default spacing.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Column of TMsg(params Children: array of Element of TMsg): Element of TMsg;
begin
  return (Element of TMsg).Stack(Children, false, new L.Flow());
end function;

// Arranges children vertically with explicit spacing and alignment.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Settings`: The stack's spacing and alignment.
// - `Children`: The children in display order.
//
// ## Returns
// The declarative widget.
public function Column of TMsg(Settings: L.Flow; params Children: array of Element of TMsg): Element of TMsg;
begin
  return (Element of TMsg).Stack(Children, false, Settings);
end function;

// Sets the sizing behavior of a child.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The subtree to allocate.
// - `Settings`: The basis, constraints and weights.
//
// ## Returns
// The declarative widget.
public function Size of TMsg(Child: Element of TMsg; Settings: L.Flex): Element of TMsg;
begin
  return (Element of TMsg).Sized(Child, Settings);
end function;

// Applies a semantic style role.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The subtree to style.
// - `Role`: The role resolved by the current host theme.
//
// ## Returns
// The declarative widget.
public function Styled of TMsg(Child: Element of TMsg; Role: S.Role): Element of TMsg;
begin
  return (Element of TMsg).Styled(Child, Role);
end function;

// Frames a child.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The enclosed view.
// - `Title`: The optional title.
//
// ## Returns
// The declarative widget.
public function Border of TMsg(Child: Element of TMsg; Title: string := ''): Element of TMsg;
begin
  return (Element of TMsg).Framed(Child, Title);
end function;

// Displays a vertical viewport whose offset belongs to the host.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Id`: The stable viewport ID.
// - `Child`: The scrollable content.
// - `ShowScrollbar`: Whether to show an overflow indicator.
// - `FadeEdges`: Whether the graphical viewport fades edges with hidden content.
// - `Horizontal`: Also enable graphical horizontal scrolling; model positions remain vertical.
//
// ## Returns
// The declarative widget.
public function ScrollView of TMsg(Id: string; Child: Element of TMsg; ShowScrollbar: bool := true; FadeEdges: bool := false; Horizontal: bool := false): Element of TMsg;
begin
  return (Element of TMsg).Scroll(Id, Child, null, null, ShowScrollbar, FadeEdges, Horizontal);
end function;

// Displays a vertical viewport whose position belongs to the model.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Id`: The stable viewport ID.
// - `Child`: The scrollable content.
// - `Position`: The model's requested position.
// - `OnScroll`: Maps a user scroll request and resolution to a message.
// - `ShowScrollbar`: Whether to show an overflow indicator.
// - `FadeEdges`: Whether the graphical viewport fades edges with hidden content.
// - `Horizontal`: Also enable graphical horizontal scrolling; model positions remain vertical.
//
// ## Returns
// The declarative widget.
public function ScrollView of TMsg(Id: string; Child: Element of TMsg; Position: L.ScrollPosition; OnScroll: function(L.ScrollChange): TMsg; ShowScrollbar: bool := true; FadeEdges: bool := false; Horizontal: bool := false): Element of TMsg;
begin
  return (Element of TMsg).Scroll(
    Id,
    Child,
    Position,
    OnScroll,
    ShowScrollbar,
    FadeEdges,
    Horizontal
  );
end function;

// Applies terminal-specific RGB colors.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Child`: The subtree to style.
// - `Colors`: The terminal color overrides.
//
// ## Returns
// The declarative widget.
public function CellStyled of TMsg(Child: Element of TMsg; Colors: T.Style): Element of TMsg;
begin
  return (Element of TMsg).TerminalStyle(Child, Colors);
end function;

// Reuses a subtree while its typed dependencies compare equal.
//
// ## Type parameters
// - `TDeps`: The type of dependencies captured for the view.
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Id`: The stable subview ID.
// - `Dependencies`: Every input that can affect the subtree.
// - `Build`: Builds the subtree from its dependencies.
// - `Equal`: Compares old and current dependencies.
//
// ## Returns
// The deferred subtree.
public function CachedSubview of (TDeps, TMsg)(
  Id: string; Dependencies: TDeps; Build: function(TDeps): Element of TMsg; Equal: function(TDeps, TDeps): bool
): Element of TMsg;
  function Resolve(Previous: (CacheEntry of TMsg)?): CacheEntry of TMsg;
  begin
    if Previous <> null and Previous.Dependencies is DependencyBox of TDeps then
      const Old: DependencyBox of TDeps := cast<DependencyBox of TDeps>(Previous.Dependencies);
      if Equal(Old.Value, Dependencies) then
        return Previous;
      end if;
    end if;

    return new CacheEntry of TMsg(new DependencyBox of TDeps(Dependencies), Build(Dependencies));
  end function;
begin
  return (Element of TMsg).Deferred(Id, Resolve);
end function;

end unit;
