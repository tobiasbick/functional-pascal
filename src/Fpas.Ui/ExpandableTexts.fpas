unit Fpas.Ui.ExpandableTexts;

uses Fpas.Ui.Elements as E, Fpas.Ui.Graphics as G, System as Sys;

// Native text-clamping options.
public type Options = record
  // Positive number of lines visible while collapsed.
  public Lines: int := 3;
  // Font size in logical points; zero uses CUI's body size.
  public Size: float := 0.0F;
  // Optional literal text color; null uses the theme foreground.
  public Color: G.Color? := null;
  // Optional surface color for the fade; null uses the theme background.
  public FadeTo: G.Color? := null;
  // Whether the native Show more / Show less link accepts input.
  public Enabled: bool := true;
end record;

// Builds text whose local expansion, wrapping, fade and animation are owned by CUI.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable text identity; removing the element releases its local state.
// - `Text`: Literal wrapping text.
// - `Settings`: Native clamping, colors and input permission.
// - `OnToggle`: Optional notification after the native link changes expansion.
// ## Returns
// A GUI-only native expandable text block.
public function ExpandableText<TMsg>(
  Id: string; Text: string; Settings: Options? := null;
  OnToggle: Sys.Func<TMsg>? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ExpandableText(Id, Text, Settings ?? new Options(), OnToggle);
end function;

// Gets the native expansion link's application identity.
//
// ## Parameters
// - `Id`: Text block identity.
// ## Returns
// The ID followed by /toggle; the link only exists when the text exceeds Lines.
public function ToggleId(Id: string): string;
requires Id <> '';
begin
  return Id + '/toggle';
end function;

end unit;
