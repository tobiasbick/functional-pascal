unit Fpas.Ui.FileBrowsers;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.FileListings as F, System as Sys;

// Native browser options.
public type Options = record
  // Preferred width.
  public Width: L.Extent := L.Extent.Fill;
  // Preferred height. Content uses the native default.
  public Height: L.Extent := L.Extent.Content;
  // Semicolon-separated file glob patterns.
  public Filter: string := '';
  // Shows folders only.
  public FoldersOnly: bool := false;
  // Shows hidden entries.
  public Hidden: bool := false;
  // Optional sidebar paths. Empty uses CUI places.
  public Places: array of string := [];
  // Hides the places sidebar.
  public NoPlaces: bool := false;
  // Optional listing callback. Empty means local disk.
  public Source: Sys.Func<string, bool, F.Listing?>? := null;
  // Native entry limit. Zero uses the native default.
  public MaximumEntries: int := 0;
  // Change to reload a provider's data in the current folder.
  public Revision: int := 0;
  // Accepts input.
  public Enabled: bool := true;
end record;

// A native browser update.
public type Event = record
  // Proposed current folder.
  public Folder: string;
  // Currently selected path.
  public Selected: string? := null;
  // Activated file path.
  public Picked: string? := null;
  // The current folder could not be listed.
  public Error: bool := false;
end record;

// Presents the native file browser.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Folder`: Model-owned input.
// - `Change`: Maps a native proposal to an application message.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical widget.
public function FileBrowser<TMsg>(Id: string; Folder: string; Change: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.FileBrowser(Id, Folder, Change, Settings ?? new Options());
end function;

end unit;
