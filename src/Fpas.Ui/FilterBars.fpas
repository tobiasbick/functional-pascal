unit Fpas.Ui.FilterBars;

uses Fpas.Ui.Elements as E;

// One field in the native filter menu.
public type Field = record
  // Literal field name.
  public Name: string;
  // Options in bit order, with at most 32 entries.
  public Values: array of string;
  // Optional CUI glyph.
  public Icon: string := '';
end record;

// Current filter state and a native change proposal.
public type Value = record
  // One option mask per field.
  public Selected: array of uint;
  // Search text, or null to hide the search box.
  public Search: string?;
end record;

// Draws CUI's filter search, chips and menus.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable bar identity.
// - `Fields`: Available filter fields in display order.
// - `Current`: Model-owned option masks and search value.
// - `OnChange`: Maps a native change to an application message.
// - `SearchCapacity`: UTF-8 buffer size, including its terminator.
// - `Enabled`: Whether the bar accepts input.
// ## Returns
// The graphical filter bar.
public function FilterBar<TMsg>(Id: string; Fields: array of Field; Current: Value; OnChange: function(Value): TMsg; SearchCapacity: int := 256; Enabled: bool := true): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.FilterBar(Id, Fields, Current, OnChange, SearchCapacity, Enabled);
end function;

end unit;
