unit Fpas.Ui.FlameGraphs;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// A timed call span.
public type Span = record
  // Display name.
  public Name: string;
  // Start in seconds.
  public Start: double;
  // End in seconds.
  public Finish: double;
  // Stack depth.
  public Depth: int;
  // Explicit color key, or zero to hash the name.
  public ColorKey: uint := 0U;
end record;

// Model-owned range, vertical offset and selection.
public type View = record
  // Visible start in seconds.
  public Start: double := 0.0;
  // Visible end in seconds. A nonpositive range fits all spans.
  public Finish: double := 0.0;
  // Vertical offset in points.
  public Scroll: float := 0.0F;
  // Selected span, or minus one.
  public Selected: int := -1;
end record;

// Native view proposal.
public type Event = record
  // Updated range and selection.
  public Current: View;
  // Span zoomed to by activation, or minus one.
  public Zoomed: int;
end record;

// Native FlameGraph settings.
public type Options = record
  // Preferred width.
  public Width: L.Extent := L.Extent.Fill;
  // Graph height, or zero to fit rows.
  public Height: float := 0.0F;
  // Row height, or zero for the native default.
  public RowHeight: float := 0.0F;
  // Deepest zoom in seconds, or zero for the native default.
  public MinimumRange: double := 0.0;
end record;

// Creates a graphical FlameGraph.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Spans`: Spans sorted by depth, start and descending duration on ties.
// - `Current`: Current visible range and selected span.
// - `Changed`: Maps a native proposal to a message.
// - `Settings`: Native layout and behavior options.
// ## Returns
// A graphical element.
public function FlameGraph<TMsg>(Id: string; Spans: array of Span; Current: View; Changed: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.FlameGraph(Id, Spans, Current, Changed, Settings ?? new Options());
end function;

end unit;
