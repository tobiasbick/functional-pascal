<!-- [Documentation](../../docs/ui/widgets.md) -->
<Project Sdk="Fpas.NET.Sdk/0.1.0-dev">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Fpas.Ui</PackageId>
    <Version>0.1.0-dev</Version>
    <Description>Declarative widget contracts for Functional Pascal UI hosts.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeUiRuntime</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/ui/widgets.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <Target Name="IncludeUiRuntime">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)Fpas.Core.dll" />
    </ItemGroup>
  </Target>
</Project>
