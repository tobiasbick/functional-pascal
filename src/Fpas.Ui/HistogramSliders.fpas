unit Fpas.Ui.HistogramSliders;

uses Fpas.Ui.Elements as E, Fpas.Ui.RangeSliders as R;

// Presentation and input settings for a histogram range slider.
public type Options = record
  // Logical height of the bars. Zero selects CUI's default.
  public Height: float := 0.0F;
  // Display precision from zero through six decimal places.
  public DecimalPlaces: int := 0;
  // Literal text before each endpoint, such as a currency symbol.
  public Prefix: string := '';
  // Literal text after each endpoint.
  public Suffix: string := '';
  // Whether the range accepts input.
  public Enabled: bool := true;
end record;

// Builds CUI's two-endpoint slider under the histogram it filters.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Label`: Literal caption.
// - `Bins`: Finite nonnegative heights in order across the full range.
// - `Value`: Ordered model-owned interval.
// - `Minimum`: Finite inclusive lower bound.
// - `Maximum`: Finite inclusive upper bound greater than Minimum.
// - `OnChange`: Maps proposed endpoints to one message.
// - `Settings`: Optional height, endpoint display and input permission.
// ## Returns
// The graphical histogram slider.
public function HistogramSlider<TMsg>(
  Id: string; Label: string; Bins: array of float; Value: R.Interval; Minimum: float;
  Maximum: float; OnChange: function(R.Interval): TMsg; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.HistogramSlider(
    Id, Label, Bins, Value, Minimum, Maximum, OnChange, Settings ?? new Options()
  );
end function;

end unit;
