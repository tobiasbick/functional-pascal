unit Fpas.Ui.HoldButtons;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S;

// Shared options for a deliberate hold-to-confirm action.
public type Options = record
  // Positive time the control must be held before confirmation.
  public DurationMilliseconds: int := 1200;
  // Optional CUI icon glyph.
  public Icon: string := '';
  // Optional terminal equivalent of the icon.
  public TerminalIcon: string := '';
  // CUI button appearance. Active belongs to selection controls.
  public Variant: S.ButtonVariant := S.ButtonVariant.Destructive;
  // Whether this action accepts input.
  public Enabled: bool := true;
end record;

// Builds a button that requires a deliberate hold before proposing a message.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity independent of the caption.
// - `Label`: Literal button caption.
// - `Message`: Message proposed once per completed hold.
// - `Settings`: Duration, icon, appearance and input permission.
// ## Returns
// A hold-to-confirm button for either host.
public function HoldButton<TMsg>(Id: string; Label: string; Message: TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.HoldAction(Id, Label, Message, Settings ?? new Options());
end function;
end unit;
