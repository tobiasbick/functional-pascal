unit Fpas.Ui.ImageComparisons;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.MediaImages as Media;

// Native image comparison options.
public type Options = record
  // Preferred native width.
  public Width: L.Extent := L.Extent.Content;
  // Logical height, or zero for the native default.
  public Height: float := 0.0F;
  // Image width divided by height. Zero uses the first image's aspect.
  public Aspect: float := 0.0F;
  // Caption above the before image.
  public BeforeLabel: string := 'Before';
  // Caption above the after image.
  public AfterLabel: string := 'After';
  // Allow changing the divider.
  public Enabled: bool := true;
end record;

// Builds the native graphical image comparison.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Before`: Picture shown before the divider.
// - `After`: Picture shown after the divider.
// - `Position`: Current divider position, from zero to one.
// - `Change`: Maps the proposed divider position.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function ImageCompare<TMsg>(Id: string; Before: Media.Source; After: Media.Source; Position: float; Change: function(float): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ImageCompare(
    Id,
    Before,
    After,
    Position,
    Change,
    Settings ?? new Options()
  );
end function;

end unit;
