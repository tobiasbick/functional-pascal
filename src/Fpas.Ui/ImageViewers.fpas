unit Fpas.Ui.ImageViewers;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.MediaImages as Media;

// The current image zoom and center in image pixels.
public type Value = record
  // Logical points per image pixel. Zero fits the image.
  public Zoom: float := 0.0F;
  // Horizontal center in image pixels.
  public CenterX: float := 0.0F;
  // Vertical center in image pixels.
  public CenterY: float := 0.0F;
end record;

// Native image viewer options.
public type Options = record
  // Preferred native width.
  public Width: L.Extent := L.Extent.Content;
  // Preferred native height.
  public Height: L.Extent := L.Extent.Content;
  // Maximum zoom ratio, or zero for the native default.
  public MaximumZoom: float := 0.0F;
  // Hide the native zoom buttons.
  public HideToolbar: bool := false;
  // Draw a checkerboard under transparent pixels.
  public Checkerboard: bool := false;
  // Allow navigation.
  public Enabled: bool := true;
end record;

// Builds the native graphical image viewer.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Image`: Picture to display.
// - `Current`: Model-owned zoom and center.
// - `Change`: Maps the next zoom and center.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function ImageViewer<TMsg>(Id: string; Image: Media.Source; Current: Value; Change: function(Value): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ImageViewer(Id, Image, Current, Change, Settings ?? new Options());
end function;

end unit;
