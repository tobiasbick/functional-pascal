unit Fpas.Ui.Images;

uses Fpas.Ui.Elements as E, Fpas.Ui.MediaImages as Media, Fpas.Ui.Graphics as G, Fpas.Ui.Layout as L;

// Native image layout and appearance.
public type Options = record
  // Preferred width.
  public Width: L.Extent := L.Extent.Fixed(L.Measure.Logical(64));
  // Preferred height.
  public Height: L.Extent := L.Extent.Fixed(L.Measure.Logical(64));
  // Corner radius in logical points.
  public Radius: float := 0.0F;
  // Optional tint multiplied with the image.
  public Tint: G.Color? := null;
end record;

// Creates a native CUI image element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable picture identity.
// - `Source`: Picture file or immutable RGBA pixels.
// - `Settings`: Native image settings.
// ## Returns
// A graphical element.
public function Image<TMsg>(Id: string; Source: Media.Source; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Image(Id, Source, Settings ?? new Options());
end function;

end unit;
