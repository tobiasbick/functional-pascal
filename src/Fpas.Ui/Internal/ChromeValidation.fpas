unit Fpas.Ui.Internal.ChromeValidation;

uses
  Fpas.Ui.Elements as E, Fpas.Ui.Validation as V, Fpas.Ui.Internal.Rules as R,
  Fpas.Ui.Internal.MenuRules as Menu, Fpas.Ui.Internal.ChartRules as Chart,
  Fpas.Ui.MenuBars as M, Fpas.Ui.Menus as Entries, Fpas.Ui.DocumentTabs as D,
  Fpas.Ui.StatusBars as S, Fpas.Ui.SplitViews as Split, Fpas.Ui.Dockspaces as Dock,
  Fpas.Ui.Styles as Style, System as Sys, System.Text as Text;

procedure Caption(Value: string; At: string);
begin
  R.CheckText(Value, At);
  if Value.Contains('##') or Value.Contains(#10) or Value.Contains(#13) then
    R.Reject(
      At,
      'A native chrome caption must fit one line and cannot contain the native key delimiter.'
    );
  end if;
end procedure;

procedure Key(Value: string; At: string);
begin
  R.CheckText(Value, At);
  if Sys.String.IsNullOrWhiteSpace(Value) then
    R.Reject(At, 'A native chrome key cannot be empty.');
  end if;
end procedure;

procedure StatusLabel(Value: S.Label; At: string);
begin
  Caption(Value.Text, At);
  R.CheckText(Value.Icon, At);
  if not Sys.Enum.IsDefined<Style.Tone>(Value.Tone) then
    R.Reject(At, 'Unknown status icon tone.');
  end if;
end procedure;

procedure Fraction(Value: float; At: string);
begin
  if not Sys.Single.IsFinite(Value) or Value < 0.0F or Value > 1.0F then
    R.Reject(At, 'Value must be from zero to one.');
  end if;
end procedure;

// Validates native chrome and its child trees before presenting them.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: A chrome element.
// - `Path`: Diagnostic location.
// - `Profile`: Current target capabilities.
// - `Identify`: Registers unique element or part identities.
// - `Visit`: Schedules validation of a child.
public procedure Check<TMsg>(Node: E.Element<TMsg>; Path: string; Profile: V.Target; Identify: function(string, string): string; Visit: procedure(E.Element<TMsg>?, string));
begin
  R.RequireProfile(Profile, V.Target.Graphical, Path + '/desktop-chrome');
  case Node of
    when E.Element.MenuBar(const Id: string, const Items: array of M.Menu<TMsg>, _):
      const At: string := Identify(Id, Path + '/menu-bar');
      if Items.Length > 16 then
        R.Reject(At, 'A CUI menu bar holds at most 16 titles.');
      end if;

      for Item: M.Menu<TMsg> in Items do
        Key(Item.Key, At);
        Caption(Item.Label, At);
        R.CheckText(Item.Mnemonic, At);
        if Item.Mnemonic.Length > 1
          or (Item.Mnemonic.Length = 1 and not Sys.Char.IsAsciiLetterOrDigit(Item.Mnemonic[0]))
        then
          R.Reject(At, 'The menu mnemonic must be an ASCII letter or digit.');
        end if;

        Chart.Distance(Item.Width, At);
        Menu.Check<TMsg>(
          Entries.ItemId(Id, Item.Key),
          Item.Label,
          Item.Entries,
          null,
          At,
          Identify
        );
      end for;
    when E.Element.DocumentTabs(
      const Id: string,
      const Tabs: array of D.Tab,
      const Selected: int,
      _,
      _
    ):
      const At: string := Identify(Id, Path + '/document-tabs');
      if Selected < -1 or Selected >= Tabs.Length then
        R.Reject(At, 'The selected document must be minus one or an available tab.');
      end if;

      for Tab: D.Tab in Tabs do
        Key(Tab.Key, At);
        discard Identify(Entries.ItemId(Id, Tab.Key), At + '/tab');
        Caption(Tab.Title, At);
        R.CheckText(Tab.Icon, At);
        R.CheckText(Tab.Tooltip, At);
      end for;
    when E.Element.StatusBar(const Id: string, const Items: array of S.Item<TMsg>, _):
      const At: string := Identify(Id, Path + '/status-bar');
      for Item: S.Item<TMsg> in Items do
        case Item of
          when S.Item.Text(const Value: S.Label):
            StatusLabel(Value, At);
          when S.Item.Action(
            const IdPart: string,
            const Value: S.Label,
            const Tooltip: string,
            _,
            _
          ):
            Key(IdPart, At);
            discard Identify(Entries.ItemId(Id, IdPart), At + '/item');
            StatusLabel(Value, At);
            R.CheckText(Tooltip, At);
          when S.Item.Progress(const Value: float, const Label: string, const Width: float, _):
            Fraction(Value, At);
            Caption(Label, At);
            Chart.Distance(Width, At);
          when S.Item.Spacer:
        end case;
      end for;
    when E.Element.SplitView(
      const Id: string, const Ratio: float, const First: E.Element<TMsg>,
      const Second: E.Element<TMsg>, _, const Settings: Split.Options
    ):
      const At: string := Identify(Id, Path + '/split-view');
      Fraction(Ratio, At);
      R.CheckExtent(Settings.Width, Profile, At);
      R.CheckExtent(Settings.Height, Profile, At);
      Chart.Distance(Settings.MinimumFirst, At);
      Chart.Distance(Settings.MinimumSecond, At);
      Visit(First, At + '/first');
      Visit(Second, At + '/second');
    when E.Element.Dockspace(
      const Id: string,
      const Panels: array of Dock.Panel<TMsg>,
      const Settings: Dock.Options,
      _
    ):
      const At: string := Identify(Id, Path + '/dockspace');
      R.CheckExtent(Settings.Width, Profile, At);
      R.CheckExtent(Settings.Height, Profile, At);
      Chart.Distance(Settings.MinimumWidth, At);
      Chart.Distance(Settings.MinimumHeight, At);
      R.CheckText(Settings.InitialLayout, At);
      R.CheckText(Settings.KnownLayout, At);
      const Load: Dock.Restore? := Settings.Load;
      if Load <> null then
        R.CheckText(Load.Layout, At);
      end if;

      if Panels.Length > 48 then
        R.Reject(At, 'A CUI dockspace holds at most 48 panels.');
      end if;

      for Panel: Dock.Panel<TMsg> in Panels do
        Key(Panel.Key, At);
        Caption(Panel.Key, At);
        Caption(Panel.Title, At);
        R.CheckText(Panel.Icon, At);
        if Text.Encoding.UTF8.GetByteCount(Panel.Key) > 63
          or Text.Encoding.UTF8.GetByteCount(Panel.Title + '###' + Panel.Key) > 127
          or Text.Encoding.UTF8.GetByteCount(Panel.Icon) > 7
        then
          R.Reject(At, 'The panel key, title or icon exceeds native docking storage.');
        end if;
        const PanelPath: string := Identify(Entries.ItemId(Id, Panel.Key), At + '/panel');
        Visit(Panel.Content, PanelPath);
      end for;
    else
  end case;
end procedure;

end unit;
