unit Fpas.Ui.Internal.DateRangeRules;

uses
  Fpas.Ui.DateRanges as R, Fpas.Ui.DateRangePickers as P, Fpas.Ui.Internal.Rules as Rules,
  System as Sys;

// Validates the model-owned range.
// ## Parameters
// - `Value`: Empty, partial or complete selection.
// - `At`: Diagnostic path.
public procedure Check(Value: R.Value; At: string);
begin
  case Value of
    when R.Value.Complete(const Start: Sys.DateOnly, const Finish: Sys.DateOnly):
      if Start.DayNumber > Finish.DayNumber then
        Rules.Reject(At, 'The end of a date range cannot precede its start.');
      end if;
    else
  end case;
end procedure;

// Checks the range picker options before passing them to CUI.
// ## Parameters
// - `Settings`: Native field options.
// - `At`: Diagnostic path.
public procedure Picker(Settings: P.Options; At: string);
begin
  Rules.CheckText(Settings.Label, At + '/label');
  Rules.CheckText(Settings.Placeholder, At + '/placeholder');
  if not Sys.Single.IsFinite(Settings.Width) or Settings.Width < 0.0F then
    Rules.Reject(At, 'The range picker needs a finite, nonnegative field width.');
  end if;
end procedure;
end unit;
