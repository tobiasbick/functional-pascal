unit Fpas.Ui.Internal.DeveloperReportValidation;

uses
  Fpas.Ui.Elements as E, Fpas.Ui.Validation as V, Fpas.Ui.Internal.Rules as Rules,
  Fpas.Ui.Internal.ChartRules as Chart, System as Sys, System.Text as Text,
  Fpas.Ui.TimeHistograms as TimeHistograms,
  Fpas.Ui.Coverages as Coverages,
  Fpas.Ui.Blames as Blames,
  Fpas.Ui.ApiExplorers as ApiExplorers,
  Fpas.Ui.KeyValueEditors as KeyValueEditors,
  Fpas.Ui.QueryBuilders as QueryBuilders,
  Fpas.Ui.SchedulePickers as SchedulePickers,
  Fpas.Ui.RegexTesters as RegexTesters,
  Fpas.Ui.RequestBars as RequestBars,
  Fpas.Ui.FeatureFlagEditors as FeatureFlagEditors;

procedure Fail(At: string);
begin
  Rules.Reject(At, 'Invalid developer widget data.');
end procedure;

procedure SelectionIndex(Index: int; Count: int; At: string);
begin
  if Index < -1 or Index >= Count then
    Fail(At);
  end if;
end procedure;

procedure Number(Value: double; At: string);
begin
  if not Sys.Double.IsFinite(Value) or Value < 0.0 then
    Fail(At);
  end if;
end procedure;

procedure Capacity(Count: int; Maximum: int; At: string);
begin
  if Maximum < 1 or Maximum > 4096 or Count > Maximum then
    Fail(At);
  end if;
end procedure;

procedure TextLimit(Value: string; Maximum: int; At: string);
begin
  Rules.CheckText(Value, At);
  if Maximum <= 0 or Maximum > 1048576 or Text.Encoding.UTF8.GetByteCount(Value) > Maximum then
    Fail(At);
  end if;
end procedure;

// Checks developer widget data before native presentation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Widget to validate.
// - `Location`: Parent diagnostic path.
// - `Profile`: Target capabilities.
// - `Identify`: Registers a stable widget identity.
public procedure Check<TMsg>(Node: E.Element<TMsg>; Location: string; Profile: V.Target; Identify: function(string, string): string);
begin
  case Node of
    when E.Element.TimeHistogram(
      const Id: string,
      const Start: double,
      const Bucket: double,
      const Buckets: int,
      const SeriesData: array of TimeHistograms.Series,
      const Value: TimeHistograms.Range,
      _,
      const Settings: TimeHistograms.Options
    ):
      const At: string := Identify(Id, Location + '/time-histogram');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      Chart.Distance(Settings.Height, At);
      if Buckets < 0 or not Sys.Double.IsFinite(
        Start
      ) or not Sys.Double.IsFinite(Bucket) or Bucket <= 0.0
        or not Sys.Double.IsFinite(Value.Start) or not Sys.Double.IsFinite(Value.End)
      then
        Fail(At);
      end if;

      for Item: TimeHistograms.Series in SeriesData do
        if Item.Counts.Length <> Buckets then
          Fail(At);
        end if;

        for Amount: float in Item.Counts do
          Chart.Distance(Amount, At);
        end for;
      end for;
    when E.Element.Coverage(
      const Id: string,
      const ReportFiles: array of Coverages.File,
      _,
      const Settings: Coverages.Options
    ):
      const At: string := Identify(Id, Location + '/coverage');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      Chart.Distance(Settings.Height, At);
      Chart.Distance(Settings.Low, At);
      Chart.Distance(Settings.High, At);
      for Item: Coverages.File in ReportFiles do
        if Item.LinesHit < 0 or Item.LinesHit > Item.Lines or Item.BranchesHit < 0
          or Item.BranchesHit > Item.Branches
          or Item.FunctionsHit < 0 or Item.FunctionsHit > Item.Functions
        then
          Fail(At);
        end if;
      end for;
    when E.Element.Blame(
      const Id: string,
      const Lines: array of string,
      const LineCommits: array of int,
      const Revisions: array of Blames.Revision,
      _,
      const Settings: Blames.Options
    ):
      const At: string := Identify(Id, Location + '/blame');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      Chart.Distance(Settings.Height, At);
      Rules.CheckText(Settings.Language, At);
      if Lines.Length <> LineCommits.Length then
        Fail(At);
      end if;

      for Index: int in LineCommits do
        SelectionIndex(Index, Revisions.Length, At);
      end for;
    when E.Element.ApiExplorer(
      const Id: string,
      const Endpoints: array of ApiExplorers.Endpoint,
      const Selection: int,
      _,
      const Settings: ApiExplorers.Options
    ):
      const At: string := Identify(Id, Location + '/api-explorer');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      Chart.Distance(Settings.Height, At);
      SelectionIndex(Selection, Endpoints.Length, At);
    when E.Element.KeyValueEditor(
      const Id: string,
      const Pairs: array of KeyValueEditors.Pair,
      _,
      const Settings: KeyValueEditors.Options
    ):
      const At: string := Identify(Id, Location + '/key-value-editor');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      Rules.CheckText(Settings.KeyPlaceholder, At);
      Rules.CheckText(Settings.ValuePlaceholder, At);
      Capacity(Pairs.Length, Settings.Capacity, At);
      for Item: KeyValueEditors.Pair in Pairs do
        TextLimit(Item.Key, 63, At);
        TextLimit(Item.Value, 255, At);
      end for;
    when E.Element.QueryBuilder(
      const Id: string,
      const Fields: array of QueryBuilders.Field,
      const RulesData: array of QueryBuilders.Rule,
      _,
      const Settings: QueryBuilders.Options
    ):
      const At: string := Identify(Id, Location + '/query-builder');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      Capacity(RulesData.Length, Settings.Capacity, At);
      if Settings.MaxDepth < 0 or Settings.MaxDepth > 64 or Fields.Length = 0 then
        Fail(At);
      end if;

      for Field: QueryBuilders.Field in Fields do
        if Field.Kind < 0 or Field.Kind > 3 or (Field.Kind = 2 and Field.Choices.Length = 0) then
          Fail(At);
        end if;
      end for;

      for Index: int := 0 to RulesData.Length - 1 do
        const Item: QueryBuilders.Rule := RulesData[Index];
        TextLimit(Item.Value, 63, At);
        if Item.Depth < 0 or Item.Depth > 64 or (Index = 0 and (not Item.Group or Item.Depth <>
          0))
        then
          Fail(At);
        end if;

        if Index > 0 then
          const Parent: QueryBuilders.Rule := RulesData[Index - 1];
          if Item.Depth = 0 or Item.Depth > Parent.Depth + 1 or (Item.Depth > Parent.Depth
            and not Parent.Group)
          then
            Fail(At);
          end if;
        end if;

        if not Item.Group then
          if Item.Field < 0 or Item.Field >= Fields.Length then
            Fail(At);
          end if;
          const Kind: int := Fields[Item.Field].Kind;
          const Operators: int := if Kind <= 1 then
            6
          else
            2
          end if;
          if Item.Operator < 0 or Item.Operator >= Operators then
            Fail(At);
          end if;
        end if;
      end for;
    when E.Element.SchedulePicker(
      const Id: string,
      const Expression: string,
      _,
      const Settings: SchedulePickers.Options
    ):
      const At: string := Identify(Id, Location + '/schedule-picker');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      TextLimit(Expression, Settings.Capacity, At);
      if Settings.NextCount < 0 or Settings.NextCount > 32 then
        Fail(At);
      end if;
    when E.Element.RegexTester(
      const Id: string,
      const Pattern: string,
      const Sample: string,
      const Modifiers: int,
      _,
      const Settings: RegexTesters.Options
    ):
      const At: string := Identify(Id, Location + '/regex-tester');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      Chart.Distance(Settings.Height, At);
      TextLimit(Pattern, Settings.PatternCapacity, At);
      TextLimit(Sample, Settings.TextCapacity, At);
      if Modifiers < 0 or Modifiers > 7 then
        Fail(At);
      end if;
    when E.Element.RequestBar(
      const Id: string,
      const Method: int,
      const Url: string,
      _,
      const Settings: RequestBars.Options
    ):
      const At: string := Identify(Id, Location + '/request-bar');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      Rules.CheckText(Settings.Placeholder, At);
      TextLimit(Url, Settings.Capacity, At);
      if Method < 0 or Method > 6 then
        Fail(At);
      end if;
    when E.Element.FeatureFlags(
      const Id: string,
      const Entries: array of FeatureFlagEditors.Flag,
      const Environments: array of string,
      _,
      const Settings: FeatureFlagEditors.Options
    ):
      const At: string := Identify(Id, Location + '/feature-flags');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      Chart.Distance(Settings.Height, At);
      if Environments.Length < 1 or Environments.Length > 8 then
        Fail(At);
      end if;

      for Item: FeatureFlagEditors.Flag in Entries do
        if Item.On.Length <> Environments.Length or Item.Rollout.Length <> Environments.Length then
          Fail(At);
        end if;

        for Share: int in Item.Rollout do
          if Share < 0 or Share > 100 then
            Fail(At);
          end if;
        end for;
      end for;
    else
  end case;
end procedure;

end unit;
