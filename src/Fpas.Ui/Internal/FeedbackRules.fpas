unit Fpas.Ui.Internal.FeedbackRules;

uses
  Fpas.Ui.Alerts as A, Fpas.Ui.ProgressBars as P, Fpas.Ui.Styles as S,
  Fpas.Ui.Internal.Rules as R, System as Sys;

// Validates native alert options.
// ## Parameters
// - `Title`: Literal alert heading.
// - `Settings`: Native presentation options.
// - `Location`: Diagnostic path.
public procedure Alert(Title: string; Settings: A.Options; Location: string);
begin
  R.CheckText(Title, Location + '/title');
  R.CheckText(Settings.Description, Location + '/description');
  R.CheckText(Settings.Icon, Location + '/icon');
  if Sys.String.IsNullOrWhiteSpace(Title) or not Sys.Enum.IsDefined<S.Tone>(Settings.Tone) then
    R.Reject(Location, 'An alert needs a nonempty title and a valid tone.');
  end if;
end procedure;

// Validates a native progress fraction and its presentation.
// ## Parameters
// - `Value`: Progress fraction.
// - `Settings`: Caption, track and activity options.
// - `Location`: Diagnostic path.
public procedure Progress(Value: float; Settings: P.Options; Location: string);
begin
  R.CheckText(Settings.Label, Location + '/label');
  Fraction(Value, Location);

  if not Sys.Enum.IsDefined<S.Tone>(Settings.Tone) then
    R.Reject(Location, 'Progress needs a valid tone.');
  end if;

  Nonnegative(Settings.Height, Location + '/height');
end procedure;

// Validates a native ring's caption, fraction and diameter.
// ## Parameters
// - `Label`: Optional literal caption.
// - `Value`: Progress fraction.
// - `Size`: Nonnegative logical diameter, including the native zero fallback.
// - `Location`: Diagnostic path.
public procedure ProgressRing(Label: string; Value: float; Size: float; Location: string);
begin
  R.CheckText(Label, Location + '/label');
  Fraction(Value, Location);
  Nonnegative(Size, Location + '/size');
end procedure;

procedure Fraction(Value: float; Location: string);
begin
  if not Sys.Single.IsFinite(Value) or Value < 0.0F or Value > 1.0F then
    R.Reject(Location, 'Progress must be finite and between zero and one.');
  end if;
end procedure;

// Validates capacity-meter values and literal text.
// ## Parameters
// - `Label`: Literal caption.
// - `Used`: Nonnegative usage.
// - `Total`: Nonnegative capacity, including the native zero-capacity fallback.
// - `Unit`: Literal value suffix.
// - `Location`: Diagnostic path.
public procedure Meter(Label: string; Used: float; Total: float; Unit: string; Location: string);
begin
  R.CheckText(Label, Location + '/label');
  R.CheckText(Unit, Location + '/unit');
  Nonnegative(Used, Location + '/used');
  Nonnegative(Total, Location + '/total');
end procedure;

// Validates a finite nonnegative quantity.
// ## Parameters
// - `Value`: Logical size, usage or capacity.
// - `Location`: Diagnostic path.
public procedure Nonnegative(Value: float; Location: string);
begin
  if not Sys.Single.IsFinite(Value) or Value < 0.0F then
    R.Reject(Location, 'The value must be finite and nonnegative.');
  end if;
end procedure;
end unit;
