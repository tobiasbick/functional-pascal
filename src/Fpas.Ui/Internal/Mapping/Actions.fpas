// [Documentation](../../../../docs/ui/widgets.md#subview-composition)

unit Fpas.Ui.Internal.Mapping.Actions;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Internal.Mapping.MessageMapping as M;
uses Fpas.Ui.Internal.Mapping.Scopes as Scopes;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Actions.ConfirmButtons as Confirms;
uses Fpas.Ui.Widgets.Actions.HoldButtons as Holds;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icons;
uses Fpas.Ui.Widgets.Actions.SegmentedControls as Segmented;
uses Fpas.Ui.Widgets.Actions.SpeedDials as Speed;
uses Fpas.Ui.Widgets.Actions.SplitButtons as Split;
uses Fpas.Ui.Widgets.Actions.StatusButtons as Status;
uses Fpas.Ui.Widgets.Actions.ToggleGroups as ToggleGroups;
uses Fpas.Ui.Widgets.Audio.Faders as Faders;
uses Fpas.Ui.Widgets.Audio.Knobs as Knobs;
uses Fpas.Ui.Widgets.Containers.ExpandableTexts as ExpandableTexts;
uses Fpas.Ui.Widgets.Conversation.Reactions as Reactions;
uses Fpas.Ui.Widgets.Inputs.HistogramSliders as Histograms;
uses Fpas.Ui.Widgets.Inputs.RadioCards as RadioCards;
uses Fpas.Ui.Widgets.Inputs.RadioGroups as RadioGroups;
uses Fpas.Ui.Widgets.Inputs.RangeSliders as RangeSliders;
uses Fpas.Ui.Widgets.Inputs.RulerSliders as Rulers;
uses Fpas.Ui.Widgets.Inputs.Sliders as Sliders;
uses Fpas.Ui.Widgets.Navigation.Navigation as N;
uses Fpas.Ui.Widgets.Navigation.Tabs as Tabs;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;
uses Fpas.Ui.Widgets.Overlays.UserMenus as UserMenus;
uses Fpas.Ui.Widgets.Theming.ThemeSwitchers as ThemeSwitchers;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;

// Translates a validated family of UI nodes without changing presentation.
// ## Type parameters
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `Value`: Original node.
// - `Messages`: Message translation.
// - `Scope`: Prefix for the element ID, or empty.
// ## Returns
// The node producing parent messages.
public function Map of (TChild, TParent)(
  Value: E.Element of TChild;
  Messages: function(TChild): TParent;
  Scope: string
): E.Element of TParent;
begin
  case Value of
    when E.Element.ExpandableText(
      const FId: string,
      const FText: string,
      const FSettings: ExpandableTexts.Options,
      const FOnToggle: (Sys.Func of TChild)?
    ):
      return (E.Element of TParent).ExpandableText(
        Scopes.Id(Scope, FId),
        FText,
        FSettings,
        M.Factory of (TChild, TParent)(FOnToggle, Messages)
      );
    when E.Element.Label(const FText: string):
      return (E.Element of TParent).Label(FText);
    when E.Element.Separator(const FTitle: string):
      return (E.Element of TParent).Separator(FTitle);
    when E.Element.ButtonAction(
      const FId: string,
      const FText: string,
      const FMessage: TChild,
      const FSettings: B.Options
    ):
      return (E.Element of TParent).ButtonAction(
        Scopes.Id(Scope, FId),
        FText,
        Messages(FMessage),
        FSettings
      );
    when E.Element.IconAction(
      const FId: string,
      const FIcon: string,
      const FTooltip: string,
      const FMessage: TChild,
      const FSettings: Icons.Options
    ):
      return (E.Element of TParent).IconAction(
        Scopes.Id(Scope, FId),
        FIcon,
        FTooltip,
        Messages(FMessage),
        FSettings
      );
    when E.Element.CopyAction(
      const FId: string,
      const FText: string,
      const FOnCopied: (Sys.Func of TChild)?,
      const FEnabled: bool
    ):
      return (E.Element of TParent).CopyAction(
        Scopes.Id(Scope, FId),
        FText,
        M.Factory of (TChild, TParent)(FOnCopied, Messages),
        FEnabled
      );
    when E.Element.HoldAction(
      const FId: string,
      const FLabel: string,
      const FMessage: TChild,
      const FSettings: Holds.Options
    ):
      return (E.Element of TParent).HoldAction(
        Scopes.Id(Scope, FId),
        FLabel,
        Messages(FMessage),
        FSettings
      );
    when E.Element.ConfirmAction(
      const FId: string,
      const FLabel: string,
      const FMessage: TChild,
      const FSettings: Confirms.Options
    ):
      return (E.Element of TParent).ConfirmAction(
        Scopes.Id(Scope, FId),
        FLabel,
        Messages(FMessage),
        FSettings
      );
    when E.Element.StatusAction(
      const FId: string,
      const FLabel: string,
      const FState: Status.Status,
      const FMessage: TChild,
      const FSettings: Status.Options
    ):
      return (E.Element of TParent).StatusAction(
        Scopes.Id(Scope, FId),
        FLabel,
        FState,
        Messages(FMessage),
        FSettings
      );
    when E.Element.ThemeChoice(
      const FId: string,
      const FSelected: ThemeSwitchers.Selection,
      const FOnChange: function(ThemeSwitchers.Selection): TChild,
      const FSettings: ThemeSwitchers.Options
    ):
      return (E.Element of TParent).ThemeChoice(
        Scopes.Id(Scope, FId),
        FSelected,
        function(A0: ThemeSwitchers.Selection): TParent => Messages(FOnChange(A0)),
        FSettings
      );
    when E.Element.ThemeFlip(
      const FId: string,
      const FAppearance: Themes.Mode,
      const FOnChange: function(Themes.Mode): TChild,
      const FEnabled: bool
    ):
      return (E.Element of TParent).ThemeFlip(
        Scopes.Id(Scope, FId),
        FAppearance,
        function(A0: Themes.Mode): TParent => Messages(FOnChange(A0)),
        FEnabled
      );
    when E.Element.Segments(
      const FId: string,
      const FItems: array of Segmented.Item,
      const FSelected: int,
      const FOnChange: function(int): TChild,
      const FSettings: Segmented.Options
    ):
      return (E.Element of TParent).Segments(
        Scopes.Id(Scope, FId),
        FItems,
        FSelected,
        function(A0: int): TParent => Messages(FOnChange(A0)),
        FSettings
      );
    when E.Element.Toggles(
      const FId: string,
      const FItems: array of ToggleGroups.Item,
      const FSelected: array of bool,
      const FOnChange: function(array of bool): TChild,
      const FSettings: ToggleGroups.Options
    ):
      return (E.Element of TParent).Toggles(
        Scopes.Id(Scope, FId),
        FItems,
        FSelected,
        function(A0: array of bool): TParent => Messages(FOnChange(A0)),
        FSettings
      );
    when E.Element.SplitAction(
      const FId: string,
      const FLabel: string,
      const FMessage: TChild,
      const FItems: array of Split.Item of TChild,
      const FSettings: Split.Options
    ):
      return (E.Element of TParent).SplitAction(
        Scopes.Id(Scope, FId),
        FLabel,
        Messages(FMessage),
        M.Split of (TChild, TParent)(FItems, Messages),
        FSettings
      );
    when E.Element.ReactionGroup(
      const FId: string,
      const FItems: array of Reactions.Item,
      const FOnChange: function(int, Reactions.Item): TChild,
      const FEnabled: bool
    ):
      return (E.Element of TParent).ReactionGroup(
        Scopes.Id(Scope, FId),
        FItems,
        function(A0: int; A1: Reactions.Item): TParent => Messages(FOnChange(A0, A1)),
        FEnabled
      );
    when E.Element.SpeedDialAction(
      const Id: string, const Items: array of Speed.Item, const Choose: function(int): TChild,
      const Settings: Speed.Options
    ):
      return (E.Element of TParent).SpeedDialAction(
        Scopes.Id(Scope, Id),
        Items,
        function(Index: int): TParent => Messages(Choose(Index)),
        Settings
      );
    when E.Element.AccountMenu(
      const FId: string,
      const FName: string,
      const FEntries: array of Menus.Entry of TChild,
      const FSettings: UserMenus.Options
    ):
      return (E.Element of TParent).AccountMenu(
        Scopes.Id(Scope, FId),
        FName,
        M.Menu of (TChild, TParent)(FEntries, Messages),
        FSettings
      );
    when E.Element.CheckboxAction(
      const FId: string,
      const FLabel: string,
      const FChecked: bool,
      const FOnChange: function(bool): TChild,
      const FDescription: string?,
      const FEnabled: bool,
      const FIndeterminate: bool, const FHideLabel: bool
    ):
      return (E.Element of TParent).CheckboxAction(
        Scopes.Id(Scope, FId),
        FLabel,
        FChecked,
        function(A0: bool): TParent => Messages(FOnChange(A0)),
        FDescription,
        FEnabled,
        FIndeterminate,
        FHideLabel
      );
    when E.Element.SwitchAction(
      const FId: string,
      const FLabel: string,
      const FOn: bool,
      const FOnChange: function(bool): TChild,
      const FDescription: string?,
      const FEnabled: bool,
      const FHideLabel: bool
    ):
      return (E.Element of TParent).SwitchAction(
        Scopes.Id(Scope, FId),
        FLabel,
        FOn,
        function(A0: bool): TParent => Messages(FOnChange(A0)),
        FDescription,
        FEnabled,
        FHideLabel
      );
    when E.Element.RadioAction(
      const FId: string,
      const FLabel: string,
      const FSelected: bool,
      const FOnSelect: function(): TChild,
      const FDescription: string?,
      const FEnabled: bool
    ):
      return (E.Element of TParent).RadioAction(
        Scopes.Id(Scope, FId),
        FLabel,
        FSelected,
        function(): TParent => Messages(FOnSelect()),
        FDescription,
        FEnabled
      );
    when E.Element.Radios(
      const FId: string,
      const FItems: array of RadioGroups.Item,
      const FSelected: int,
      const FOnChange: function(int): TChild,
      const FEnabled: bool,
      const FGap: L.Spacing
    ):
      return (E.Element of TParent).Radios(
        Scopes.Id(Scope, FId),
        FItems,
        FSelected,
        function(A0: int): TParent => Messages(FOnChange(A0)),
        FEnabled,
        FGap
      );
    when E.Element.Cards(
      const FId: string,
      const FItems: array of RadioCards.Item,
      const FSelected: int,
      const FOnChange: function(int): TChild,
      const FSettings: RadioCards.Options
    ):
      return (E.Element of TParent).Cards(
        Scopes.Id(Scope, FId),
        FItems,
        FSelected,
        function(A0: int): TParent => Messages(FOnChange(A0)),
        FSettings
      );
    when E.Element.SliderAction(
      const FId: string,
      const FLabel: string,
      const FValue: float,
      const FMinimum: float,
      const FMaximum: float,
      const FOnChange: function(float): TChild,
      const FSettings: Sliders.Options
    ):
      return (E.Element of TParent).SliderAction(
        Scopes.Id(Scope, FId),
        FLabel,
        FValue,
        FMinimum,
        FMaximum,
        function(A0: float): TParent => Messages(FOnChange(A0)),
        FSettings
      );
    when E.Element.RangeSliderAction(
      const FId: string,
      const FLabel: string,
      const FValue: RangeSliders.Interval,
      const FMinimum: float,
      const FMaximum: float,
      const FOnChange: function(RangeSliders.Interval): TChild,
      const FEnabled: bool
    ):
      return (E.Element of TParent).RangeSliderAction(
        Scopes.Id(Scope, FId),
        FLabel,
        FValue,
        FMinimum,
        FMaximum,
        function(A0: RangeSliders.Interval): TParent => Messages(FOnChange(A0)),
        FEnabled
      );
    when E.Element.Knob(
      const Id: string, const Label: string, const Value: float, const Minimum: float,
      const Maximum: float, const Change: function(float): TChild, const Settings: Knobs.Options
    ):
      return (E.Element of TParent).Knob(
        Scopes.Id(Scope, Id),
        Label,
        Value,
        Minimum,
        Maximum,
        function(Next: float): TParent => Messages(Change(Next)),
        Settings
      );
    when E.Element.Fader(
      const Id: string, const Label: string, const Value: float, const Minimum: float,
      const Maximum: float, const Change: function(float): TChild, const Settings: Faders.Options
    ):
      return (E.Element of TParent).Fader(
        Scopes.Id(Scope, Id),
        Label,
        Value,
        Minimum,
        Maximum,
        function(Next: float): TParent => Messages(Change(Next)),
        Settings
      );
    when E.Element.RulerSlider(
      const Id: string, const Label: string, const Value: float, const Minimum: float,
      const Maximum: float, const Change: function(float): TChild, const Settings: Rulers.Options
    ):
      return (E.Element of TParent).RulerSlider(
        Scopes.Id(Scope, Id),
        Label,
        Value,
        Minimum,
        Maximum,
        function(Proposal: float): TParent => Messages(Change(Proposal)),
        Settings
      );
    when E.Element.HistogramSlider(
      const Id: string, const Label: string, const Bins: array of float,
      const Value: RangeSliders.Interval, const Minimum: float, const Maximum: float,
      const Change: function(RangeSliders.Interval): TChild, const Settings: Histograms.Options
    ):
      return (E.Element of TParent).HistogramSlider(
        Scopes.Id(Scope, Id), Label, Bins, Value, Minimum, Maximum,
        function(Proposal: RangeSliders.Interval): TParent => Messages(Change(Proposal)), Settings
      );
    when E.Element.ChipAction(
      const FId: string,
      const FLabel: string,
      const FSelected: bool?,
      const FOnChange: function(bool?): TChild,
      const FIcon: string?,
      const FEnabled: bool
    ):
      return (E.Element of TParent).ChipAction(
        Scopes.Id(Scope, FId),
        FLabel,
        FSelected,
        function(A0: bool?): TParent => Messages(FOnChange(A0)),
        FIcon,
        FEnabled
      );
    when E.Element.RatingAction(
      const FId: string,
      const FLabel: string,
      const FValue: int,
      const FOnChange: function(int): TChild,
      const FMaximum: int,
      const FEnabled: bool,
      const FStarSize: float
    ):
      return (E.Element of TParent).RatingAction(
        Scopes.Id(Scope, FId),
        FLabel,
        FValue,
        function(A0: int): TParent => Messages(FOnChange(A0)),
        FMaximum,
        FEnabled,
        FStarSize
      );
    when E.Element.TabStrip(
      const FId: string,
      const FItems: array of Tabs.Item,
      const FSelected: int,
      const FOnChange: function(int): TChild,
      const FSettings: Tabs.Options
    ):
      return (E.Element of TParent).TabStrip(
        Scopes.Id(Scope, FId),
        FItems,
        FSelected,
        function(A0: int): TParent => Messages(FOnChange(A0)),
        FSettings
      );
    when E.Element.BreadcrumbTrail(
      const FId: string,
      const FItems: array of string,
      const FOnNavigate: function(int): TChild,
      const FEnabled: bool
    ):
      return (E.Element of TParent).BreadcrumbTrail(
        Scopes.Id(Scope, FId),
        FItems,
        function(A0: int): TParent => Messages(FOnNavigate(A0)),
        FEnabled
      );
    when E.Element.PaginationAction(
      const FId: string,
      const FPage: int,
      const FPageCount: int,
      const FOnChange: function(int): TChild,
      const FEnabled: bool
    ):
      return (E.Element of TParent).PaginationAction(
        Scopes.Id(Scope, FId),
        FPage,
        FPageCount,
        function(A0: int): TParent => Messages(FOnChange(A0)),
        FEnabled
      );
    when E.Element.StepProgress(
      const FId: string,
      const FSteps: array of string,
      const FCurrent: int
    ):
      return (E.Element of TParent).StepProgress(Scopes.Id(Scope, FId), FSteps, FCurrent);
    when E.Element.Dropdown(
      const FId: string,
      const FLabel: string,
      const FEntries: array of Menus.Entry of TChild,
      const FSettings: Menus.Options
    ):
      return (E.Element of TParent).Dropdown(
        Scopes.Id(Scope, FId),
        FLabel,
        M.Menu of (TChild, TParent)(FEntries, Messages),
        FSettings
      );
    when E.Element.PasswordStrengthMeter(const FId: string, const FPassword: string):
      return (E.Element of TParent).PasswordStrengthMeter(Scopes.Id(Scope, FId), FPassword);
    when E.Element.Sidebar(
      const FId: string,
      const FSections: array of N.Section of TChild,
      const FActiveKey: string?,
      const FEnabled: bool
    ):
      return (E.Element of TParent).Sidebar(
        Scopes.Id(Scope, FId),
        M.Navigation of (TChild, TParent)(FSections, Messages),
        FActiveKey,
        FEnabled
      );
    else
      raise new Sys.InvalidOperationException('An unexpected node reached message mapping.');
  end case;
end function;

end unit;
