// [Documentation](../../../../docs/ui/widgets.md#subview-composition)

unit Fpas.Ui.Internal.Mapping.Canvas;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Internal.Mapping.Scopes as Scopes;
uses Fpas.Ui.Widgets.Canvas.CanvasControls as CanvasControls;
uses Fpas.Ui.Widgets.Canvas.FormatBars as FormatBars;
uses Fpas.Ui.Widgets.Canvas.LiveCursors as LiveCursors;
uses Fpas.Ui.Widgets.Canvas.PresencePills as PresencePills;
uses Fpas.Ui.Widgets.Canvas.ResultCards as ResultCards;
uses Fpas.Ui.Widgets.Canvas.SelectionBars as SelectionBars;
uses Fpas.Ui.Widgets.Canvas.SelectionRings as SelectionRings;
uses Fpas.Ui.Widgets.Desktop.Toolbars as Toolbars;
uses Fpas.Ui.Widgets.Editors.NodeEditors as NodeEditors;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;

uses System as Sys;
uses System.Collections.Generic as Lists;

function MapNodes of (TChild, TParent)(
  Items: array of NodeEditors.Node of TChild;
  Child: function(E.Element of TChild): E.Element of TParent
): array of NodeEditors.Node of TParent;
begin
  const Nodes: Lists.List of NodeEditors.Node of TParent := new Lists.List of NodeEditors.Node of TParent(
    Items.Length
  );
  for Item: NodeEditors.Node of TChild in Items do
    var Body: (E.Element of TParent)? := null;
    case Item.Body of
      when is E.Element of TChild as Content:
        Body := Child(Content);
      else
    end case;

    Nodes.Add(
      new NodeEditors.Node of TParent(
        Item.Id,
        Item.X,
        Item.Y,
        Item.Title,
        Item.Pins,
        Body,
        Item.Width,
        Item.Icon,
        Item.Ring
      )
    );
  end for;

  return Nodes.ToArray();
end function;

// Maps canvas messages and embedded content to a parent view.
// ## Type parameters
// - `TChild`: Child message type.
// - `TParent`: Parent message type.
// ## Parameters
// - `Value`: Canvas widget.
// - `Messages`: Message conversion.
// - `Child`: Element conversion.
// - `Scope`: Prefix for the element ID, or empty.
// ## Returns
// The corresponding parent element.
public function Map of (TChild, TParent)(
  Value: E.Element of TChild;
  Messages: function(TChild): TParent;
  Scope: string;
  Child: function(E.Element of TChild): E.Element of TParent
): E.Element of TParent;
begin
  case Value of
    when E.Element.FormatBar(
      const Id: string,
      const Format: FormatBars.Value,
      const Changed: function(FormatBars.Event): TChild,
      const Settings: FormatBars.Options
    ):
      return (E.Element of TParent).FormatBar(
        Scopes.Id(Scope, Id),
        Format,
        function(Proposal: FormatBars.Event): TParent => Messages(Changed(Proposal)),
        Settings
      );
    when E.Element.LiveCursors(
      const Id: string,
      const People: array of LiveCursors.Person,
      const Content: E.Element of TChild,
      const Settings: LiveCursors.Options
    ):
      return (E.Element of TParent).LiveCursors(
        Scopes.Id(Scope, Id),
        People,
        Child(Content),
        Settings
      );
    when E.Element.PresencePill(
      const Id: string,
      const People: array of LiveCursors.Person,
      const Settings: PresencePills.Options
    ):
      return (E.Element of TParent).PresencePill(Scopes.Id(Scope, Id), People, Settings);
    when E.Element.SelectionRing(
      const Id: string,
      const Content: E.Element of TChild,
      const Settings: SelectionRings.Options
    ):
      return (E.Element of TParent).SelectionRing(Scopes.Id(Scope, Id), Child(Content), Settings);
    when E.Element.CanvasControls(
      const Id: string,
      const Viewport: NodeEditors.View,
      const Toggles: array of CanvasControls.Toggle,
      const Changed: function(CanvasControls.Event): TChild,
      const Content: E.Element of TChild,
      const Settings: CanvasControls.Options
    ):
      return (E.Element of TParent).CanvasControls(
        Scopes.Id(Scope, Id),
        Viewport,
        Toggles,
        function(Proposal: CanvasControls.Event): TParent => Messages(Changed(Proposal)),
        Child(Content),
        Settings
      );
    when E.Element.ResultCard(
      const Id: string,
      const Image: Media.Source?,
      const Title: string,
      const Activate: TChild,
      const Settings: ResultCards.Options
    ):
      return (E.Element of TParent).ResultCard(
        Scopes.Id(Scope, Id),
        Image,
        Title,
        Messages(Activate),
        Settings
      );
    when E.Element.SelectionBar(
      const Id: string,
      const Selected: SelectionBars.Selection,
      const Actions: array of SelectionBars.Action,
      const Changed: function(SelectionBars.Event): TChild,
      const Content: E.Element of TChild,
      const Settings: SelectionBars.Options
    ):
      return (E.Element of TParent).SelectionBar(
        Scopes.Id(Scope, Id),
        Selected,
        Actions,
        function(Proposal: SelectionBars.Event): TParent => Messages(Changed(Proposal)),
        Child(Content),
        Settings
      );
    when E.Element.Toolbar(
      const Id: string,
      const Items: array of Toolbars.Item,
      const Changed: function(Toolbars.Event): TChild,
      const Settings: Toolbars.Options
    ):
      return (E.Element of TParent).Toolbar(
        Scopes.Id(Scope, Id),
        Items,
        function(Proposal: Toolbars.Event): TParent => Messages(Changed(Proposal)),
        Settings
      );
    when E.Element.NodeEditor(
      const Id: string,
      const Viewport: NodeEditors.View,
      const Nodes: array of NodeEditors.Node of TChild,
      const Links: array of NodeEditors.Link,
      const Changed: function(NodeEditors.Event): TChild,
      const Settings: NodeEditors.Options
    ):
      return (E.Element of TParent).NodeEditor(
        Scopes.Id(Scope, Id),
        Viewport,
        MapNodes of (TChild, TParent)(Nodes, Child),
        Links,
        function(Proposal: NodeEditors.Event): TParent => Messages(Changed(Proposal)),
        Settings
      );
    else
      raise new Sys.InvalidOperationException('Expected a canvas element.');
  end case;
end function;

end unit;
