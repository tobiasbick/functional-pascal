// [Documentation](../../../../docs/ui/widgets.md#subview-composition)

unit Fpas.Ui.Internal.Mapping.Capture;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Internal.Mapping.MessageMapping as M;
uses Fpas.Ui.Widgets.Files.Dropzones as Dropzones;
uses Fpas.Ui.Widgets.Files.SignaturePads as Signatures;

uses System as Sys;

// Maps the native capture controls into a parent message space.
// ## Type parameters
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `View`: Capture widget to translate.
// - `Messages`: Application message translator.
// ## Returns
// The translated capture widget.
public function Map of (TChild, TParent)(
  View: E.Element of TChild;
  Messages: function(TChild): TParent
): E.Element of TParent;
begin
  case View of
    when E.Element.Dropzone(
      const Id: string, const Drop: function(array of string): TChild,
      const Browse: (Sys.Func of TChild)?, const Settings: Dropzones.Options
    ):
      return (E.Element of TParent).Dropzone(
        Id, function(Paths: array of string): TParent => Messages(Drop(Paths)),
        M.Factory of (TChild, TParent)(Browse, Messages), Settings
      );
    when E.Element.AvatarUpload(
      const Id: string,
      const Name: string,
      const Path: string?,
      const Drop: function(string): TChild,
      const Browse: (Sys.Func of TChild)?,
      const Size: float,
      const Enabled: bool
    ):
      return (E.Element of TParent).AvatarUpload(
        Id, Name, Path, function(Image: string): TParent => Messages(Drop(Image)),
        M.Factory of (TChild, TParent)(Browse, Messages), Size, Enabled
      );
    when E.Element.SignaturePad(
      const Id: string,
      const Change: Sys.Func of (Signatures.Signature, TChild)?,
      const Settings: Signatures.Options
    ):
      return (E.Element of TParent).SignaturePad(
        Id, M.Callback of (Signatures.Signature, TChild, TParent)(Change, Messages), Settings
      );
    else
      raise new Sys.InvalidOperationException('Expected a capture widget.');
  end case;
end function;

end unit;
