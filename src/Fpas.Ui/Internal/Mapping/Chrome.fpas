// [Documentation](../../../../docs/ui/widgets.md#subview-composition)

unit Fpas.Ui.Internal.Mapping.Chrome;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Internal.Mapping.MessageMapping as Mapping;
uses Fpas.Ui.Internal.Mapping.Scopes as Scopes;
uses Fpas.Ui.Widgets.Desktop.Dockspaces as Dock;
uses Fpas.Ui.Widgets.Desktop.DocumentTabs as D;
uses Fpas.Ui.Widgets.Desktop.MenuBars as M;
uses Fpas.Ui.Widgets.Desktop.SplitViews as Split;
uses Fpas.Ui.Widgets.Desktop.StatusBars as S;

uses System as Sys;
uses System.Collections.Generic as Lists;

// Rebinds desktop chrome messages and maps its child controls.
// ## Type parameters
// - `TChild`: Original message type.
// - `TParent`: Mapped message type.
// ## Parameters
// - `Node`: Native chrome element.
// - `Messages`: Message translation.
// - `Child`: Child-element translation.
// - `Scope`: Prefix for the element ID, or empty.
// ## Returns
// Desktop chrome with mapped messages.
public function Map of (TChild, TParent)(
  Node: E.Element of TChild;
  Messages: function(TChild): TParent;
  Scope: string;
  Child: function(E.Element of TChild): E.Element of TParent
): E.Element of TParent;
begin
  case Node of
    when E.Element.MenuBar(
      const Id: string,
      const Items: array of M.Menu of TChild,
      const Hide: bool
    ):
      const Mapped: Lists.List of M.Menu of TParent := new Lists.List of M.Menu of TParent(
        Items.Length
      );
      for Index: int := 0 to Items.Length - 1 do
        const Item: M.Menu of TChild := Items[Index];
        Mapped.Add(
          new M.Menu of TParent(
            Item.Key, Item.Label, Mapping.Menu of (TChild, TParent)(Item.Entries, Messages),
            Item.Mnemonic, Item.Width, Item.Enabled
          )
        );
      end for;

      return (E.Element of TParent).MenuBar(Scopes.Id(Scope, Id), Mapped.ToArray(), Hide);
    when E.Element.DocumentTabs(
      const Id: string, const Tabs: array of D.Tab, const Selected: int,
      const Change: function(D.Change): TChild, const Settings: D.Options
    ):
      return (E.Element of TParent).DocumentTabs(
        Scopes.Id(Scope, Id),
        Tabs,
        Selected,
        function(Value: D.Change): TParent => Messages(Change(Value)),
        Settings
      );
    when E.Element.StatusBar(
      const Id: string,
      const Items: array of S.Item of TChild,
      const Hide: bool
    ):
      const Mapped: Lists.List of S.Item of TParent := new Lists.List of S.Item of TParent(
        Items.Length
      );
      for Index: int := 0 to Items.Length - 1 do
        Mapped.Add(
          case Items[Index] of
            when S.Item.Text(const Value: S.Label): (S.Item of TParent).Text(Value);
            when S.Item.Action(
              const Key: string,
              const Value: S.Label,
              const Tip: string,
              const Enabled: bool,
              const Clicked: TChild
            ): (S.Item of TParent).Action(Key, Value, Tip, Enabled, Messages(Clicked));
            when S.Item.Progress(
              const Value: float,
              const Caption: string,
              const Width: float,
              const Indeterminate: bool
            ): (S.Item of TParent).Progress(Value, Caption, Width, Indeterminate);
            when S.Item.Spacer: (S.Item of TParent).Spacer;
          end case
        );
      end for;

      return (E.Element of TParent).StatusBar(Scopes.Id(Scope, Id), Mapped.ToArray(), Hide);
    when E.Element.SplitView(
      const Id: string,
      const Ratio: float,
      const First: E.Element of TChild,
      const Second: E.Element of TChild,
      const Change: function(float): TChild,
      const Settings: Split.Options
    ):
      return (E.Element of TParent).SplitView(
        Scopes.Id(Scope, Id), Ratio, Child(First), Child(Second),
        function(Value: float): TParent => Messages(Change(Value)), Settings
      );
    when E.Element.Dockspace(
      const Id: string,
      const Panels: array of Dock.Panel of TChild,
      const Settings: Dock.Options,
      const Change: Sys.Func of (string, TChild)?
    ):
      const Mapped: Lists.List of Dock.Panel of TParent := new Lists.List of Dock.Panel of TParent(
        Panels.Length
      );
      for Index: int := 0 to Panels.Length - 1 do
        const Panel: Dock.Panel of TChild := Panels[Index];
        Mapped.Add(
          new Dock.Panel of TParent(
            Panel.Key,
            Panel.Title,
            Child(Panel.Content),
            Panel.Icon,
            Panel.Dirty,
            Panel.Open,
            Mapping.Callback of (bool, TChild, TParent)(Panel.OnOpenChanged, Messages)
          )
        );
      end for;

      return (E.Element of TParent).Dockspace(
        Scopes.Id(Scope, Id),
        Mapped.ToArray(),
        Settings,
        Mapping.Callback of (string, TChild, TParent)(Change, Messages)
      );
    else
      raise new Sys.ArgumentException('Expected a desktop chrome element.');
  end case;
end function;

end unit;
