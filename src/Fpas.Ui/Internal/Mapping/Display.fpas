// [Documentation](../../../../docs/ui/widgets.md#subview-composition)

unit Fpas.Ui.Internal.Mapping.Display;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Internal.Mapping.MessageMapping as Mapping;
uses Fpas.Ui.Internal.Mapping.Scopes as Scopes;
uses Fpas.Ui.Widgets.Canvas.Canvases as Canvases;
uses Fpas.Ui.Widgets.Canvas.Painting as Painting;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Media.Images as Images;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;
uses Fpas.Ui.Widgets.Overlays.Veils as Veils;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;

// Translates callbacks and children for native display elements.
// ## Type parameters
// - `TChild`: Child message type.
// - `TParent`: Parent message type.
// ## Parameters
// - `Value`: Element to map.
// - `Messages`: Converts proposed messages.
// - `Content`: Maps a nested element.
// - `Scope`: Prefix for the element ID, or empty.
// ## Returns
// The element in the parent message type.
public function Map of (TChild, TParent)(
  Value: E.Element of TChild;
  Messages: function(TChild): TParent;
  Scope: string;
  Content: function(E.Element of TChild): E.Element of TParent
): E.Element of TParent;
begin
  case Value of
    when E.Element.NativeText(
      const Text: string,
      const Role: Texts.Appearance,
      const Settings: Texts.Options
    ):
      return (E.Element of TParent).NativeText(Text, Role, Settings);
    when E.Element.Icon(
      const Glyph: string, const Size: float, const Color: G.Color?,
      const ThemeColor: Themes.ColorToken?
    ):
      return (E.Element of TParent).Icon(Glyph, Size, Color, ThemeColor);
    when E.Element.Emoji(const Glyph: string, const Size: float):
      return (E.Element of TParent).Emoji(Glyph, Size);
    when E.Element.Keycap(const Keys: string):
      return (E.Element of TParent).Keycap(Keys);
    when E.Element.Image(
      const Id: string,
      const Source: Media.Source,
      const Settings: Images.Options
    ):
      return (E.Element of TParent).Image(Scopes.Id(Scope, Id), Source, Settings);
    when E.Element.Canvas(
      const Id: string,
      const Drawing: array of Canvases.Shape,
      const Clicked: function(Canvases.Event): TChild,
      const Settings: Canvases.Options,
      const OnWheel: Sys.Func of (Canvases.Wheel, TChild)?,
      const Paint: (Sys.Action of Painting.Surface)?,
      const OnPointer: Sys.Func of (Canvases.Pointer, TChild)?,
      const OnInput: Sys.Func of (Canvases.Input, TChild)?,
      const OnRightClick: Sys.Func of (Canvases.Event, TChild)?
    ):
      return (E.Element of TParent).Canvas(
        Scopes.Id(Scope, Id),
        Drawing,
        function(Event: Canvases.Event): TParent => Messages(Clicked(Event)),
        Settings,
        Mapping.Callback of (Canvases.Wheel, TChild, TParent)(OnWheel, Messages),
        Paint,
        Mapping.Callback of (Canvases.Pointer, TChild, TParent)(OnPointer, Messages),
        Mapping.Callback of (Canvases.Input, TChild, TParent)(OnInput, Messages),
        Mapping.Callback of (Canvases.Event, TChild, TParent)(OnRightClick, Messages)
      );
    when E.Element.Veil(
      const Id: string,
      const Revealed: bool,
      const Changed: function(bool): TChild,
      const Child: E.Element of TChild,
      const Settings: Veils.Options
    ):
      return (E.Element of TParent).Veil(
        Scopes.Id(Scope, Id),
        Revealed,
        function(Visible: bool): TParent => Messages(Changed(Visible)),
        Content(Child),
        Settings
      );
    else
      raise new Sys.InvalidOperationException('Expected a native display widget.');
  end case;
end function;

end unit;
