unit Fpas.Ui.Internal.Mapping.Editors;

uses
  Fpas.Ui.InlineEdits as InlineEdits, Fpas.Ui.ScrubFields as ScrubFields,
  Fpas.Ui.MoneyFields as MoneyFields, Fpas.Ui.ShortcutRecorders as RecorderKeys,
  Fpas.Ui.EmojiPickers as Emojis, Fpas.Ui.Graphics as Graphics,
  Fpas.Ui.DatePickers as DatePickers,
  Fpas.Ui.TimePickers as TimePickers, Fpas.Ui.WheelPickers as WheelPickers,
  Fpas.Ui.DateRanges as Dates, Fpas.Ui.DateRangePickers as RangePickers,
  Fpas.Ui.MultiSelects as Multi,
  Fpas.Ui.Elements as E,
  Fpas.Ui.Internal.MessageMapping as M,
  Fpas.Ui.Selects as Selects,
  Fpas.Ui.NumberFields as NumberFields,
  Fpas.Ui.TagInputs as TagInputs,
  Fpas.Ui.OneTimeCodes as OneTimeCodes,
  Fpas.Ui.SearchFields as SearchFields,
  Fpas.Ui.TextAreas as TextAreas,
  Fpas.Ui.TextFields as TextFields,
  System as Sys;

// Translates a validated family of UI nodes without changing presentation.
// ## Type parameters
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `Value`: Original node.
// - `Messages`: Message translation.
// ## Returns
// The node producing parent messages.
public function Map<TChild, TParent>(Value: E.Element<TChild>; Messages: function(TChild): TParent): E.Element<TParent>;
begin
  case Value of
    when E.Element.InlineEdit(
      const Id: string,
      const Current: string,
      const Changed: function(string): TChild,
      const Settings: InlineEdits.Options
    ):
      return E.Element<TParent>.InlineEdit(
        Id,
        Current,
        function(Next: string): TParent => Messages(Changed(Next)),
        Settings
      );
    when E.Element.ScrubField(
      const Id: string,
      const Label: string,
      const Current: float,
      const Minimum: float,
      const Maximum: float,
      const Changed: function(float): TChild,
      const Settings: ScrubFields.Options
    ):
      return E.Element<TParent>.ScrubField(
        Id,
        Label,
        Current,
        Minimum,
        Maximum,
        function(Next: float): TParent => Messages(Changed(Next)),
        Settings
      );
    when E.Element.MoneyField(
      const Id: string,
      const Current: double,
      const Changed: function(double): TChild,
      const Settings: MoneyFields.Options
    ):
      return E.Element<TParent>.MoneyField(
        Id,
        Current,
        function(Next: double): TParent => Messages(Changed(Next)),
        Settings
      );
    when E.Element.ShortcutRecorder(
      const Id: string,
      const Current: RecorderKeys.Combination,
      const Changed: function(RecorderKeys.Combination): TChild,
      const Settings: RecorderKeys.Options
    ):
      return E.Element<TParent>.ShortcutRecorder(
        Id,
        Current,
        function(Next: RecorderKeys.Combination): TParent => Messages(Changed(Next)),
        Settings
      );
    when E.Element.TextField(
      const FId: string,
      const FValue: string,
      const FOnChange: function(string): TChild,
      const FSettings: TextFields.Options,
      const FOnSubmit: Sys.Func<string, TChild>?
    ):
      return E.Element<TParent>.TextField(
        FId,
        FValue,
        function(A0: string): TParent => Messages(FOnChange(A0)),
        FSettings,
        M.Callback<string, TChild, TParent>(FOnSubmit, Messages)
      );
    when E.Element.SearchField(
      const FId: string,
      const FValue: string,
      const FOnChange: function(string): TChild,
      const FSettings: SearchFields.Options,
      const FOnSubmit: Sys.Func<string, TChild>?
    ):
      return E.Element<TParent>.SearchField(
        FId,
        FValue,
        function(A0: string): TParent => Messages(FOnChange(A0)),
        FSettings,
        M.Callback<string, TChild, TParent>(FOnSubmit, Messages)
      );
    when E.Element.TextArea(
      const FId: string,
      const FValue: string,
      const FOnChange: function(string): TChild,
      const FSettings: TextAreas.Options,
      const FOnSubmit: Sys.Func<string, TChild>?
    ):
      return E.Element<TParent>.TextArea(
        FId,
        FValue,
        function(A0: string): TParent => Messages(FOnChange(A0)),
        FSettings,
        M.Callback<string, TChild, TParent>(FOnSubmit, Messages)
      );
    when E.Element.TagInput(
      const FId: string,
      const FTags: array of string,
      const FOnChange: function(array of string): TChild,
      const FSettings: TagInputs.Options
    ):
      return E.Element<TParent>.TagInput(
        FId,
        FTags,
        function(A0: array of string): TParent => Messages(FOnChange(A0)),
        FSettings
      );
    when E.Element.OneTimeCodeInput(
      const FId: string,
      const FValue: string,
      const FOnChange: function(string): TChild,
      const FSettings: OneTimeCodes.Options,
      const FOnComplete: Sys.Func<string, TChild>?
    ):
      return E.Element<TParent>.OneTimeCodeInput(
        FId,
        FValue,
        function(A0: string): TParent => Messages(FOnChange(A0)),
        FSettings,
        M.Callback<string, TChild, TParent>(FOnComplete, Messages)
      );
    when E.Element.ColorPicker(
      const Id: string, const Value: Graphics.Color, const Change: function(Graphics.Color): TChild,
      const Enabled: bool
    ):
      return E.Element<TParent>.ColorPicker(
        Id,
        Value,
        function(Proposal: Graphics.Color): TParent => Messages(Change(Proposal)),
        Enabled
      );
    when E.Element.EmojiPicker(
      const Id: string, const Value: Emojis.State, const Change: function(Emojis.Change): TChild,
      const Settings: Emojis.Options
    ):
      return E.Element<TParent>.EmojiPicker(
        Id,
        Value,
        function(Proposal: Emojis.Change): TParent => Messages(Change(Proposal)),
        Settings
      );
    when E.Element.Calendar(
      const Id: string, const Value: Sys.DateOnly?, const Change: function(Sys.DateOnly): TChild,
      const Enabled: bool
    ):
      return E.Element<TParent>.Calendar(
        Id, Value, function(Proposed: Sys.DateOnly): TParent => Messages(Change(Proposed)), Enabled
      );
    when E.Element.DatePicker(
      const Id: string, const Value: Sys.DateOnly?, const Change: function(Sys.DateOnly): TChild,
      const Settings: DatePickers.Options
    ):
      return E.Element<TParent>.DatePicker(
        Id, Value, function(Proposed: Sys.DateOnly): TParent => Messages(Change(Proposed)), Settings
      );
    when E.Element.RangeCalendar(
      const Id: string, const Value: Dates.Value, const Change: function(Dates.Value): TChild,
      const Months: int, const Enabled: bool
    ):
      return E.Element<TParent>.RangeCalendar(
        Id,
        Value,
        function(Proposed: Dates.Value): TParent => Messages(Change(Proposed)),
        Months,
        Enabled
      );
    when E.Element.RangePicker(
      const Id: string, const Value: Dates.Value, const Change: function(Dates.Value): TChild,
      const Settings: RangePickers.Options
    ):
      return E.Element<TParent>.RangePicker(
        Id, Value, function(Proposed: Dates.Value): TParent => Messages(Change(Proposed)), Settings
      );
    when E.Element.TimePicker(
      const Id: string, const Value: Sys.TimeOnly, const Change: function(Sys.TimeOnly): TChild,
      const Settings: TimePickers.Options
    ):
      return E.Element<TParent>.TimePicker(
        Id, Value, function(Proposed: Sys.TimeOnly): TParent => Messages(Change(Proposed)), Settings
      );
    when E.Element.WheelPicker(
      const Id: string, const Items: array of string, const Selected: int,
      const Change: function(int): TChild, const Settings: WheelPickers.Options
    ):
      return E.Element<TParent>.WheelPicker(
        Id,
        Items,
        Selected,
        function(Proposed: int): TParent => Messages(Change(Proposed)),
        Settings
      );
    when E.Element.TimeDial(
      const Id: string, const Value: Sys.TimeOnly, const Change: function(Sys.TimeOnly): TChild,
      const Size: float, const Enabled: bool
    ):
      return E.Element<TParent>.TimeDial(
        Id,
        Value,
        function(Proposed: Sys.TimeOnly): TParent => Messages(Change(Proposed)),
        Size,
        Enabled
      );
    when E.Element.MultiSelectInput(
      const Id: string, const Items: array of Selects.Item, const Selected: array of bool,
      const Change: function(array of bool): TChild, const Settings: Multi.Options
    ):
      return E.Element<TParent>.MultiSelectInput(
        Id,
        Items,
        Selected,
        function(Flags: array of bool): TParent => Messages(Change(Flags)),
        Settings
      );
    when E.Element.SelectInput(
      const FId: string,
      const FItems: array of Selects.Item,
      const FSelected: int,
      const FOnChange: function(int): TChild,
      const FSettings: Selects.Options
    ):
      return E.Element<TParent>.SelectInput(
        FId,
        FItems,
        FSelected,
        function(A0: int): TParent => Messages(FOnChange(A0)),
        FSettings
      );
    when E.Element.NumberField(
      const FId: string,
      const FValue: double,
      const FMinimum: double,
      const FMaximum: double,
      const FOnChange: function(double): TChild,
      const FSettings: NumberFields.Options
    ):
      return E.Element<TParent>.NumberField(
        FId,
        FValue,
        FMinimum,
        FMaximum,
        function(A0: double): TParent => Messages(FOnChange(A0)),
        FSettings
      );
    else
      raise new Sys.InvalidOperationException('An unexpected node reached message mapping.');
  end case;
end function;

end unit;
