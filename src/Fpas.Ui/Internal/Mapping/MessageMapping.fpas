// [Documentation](../../../../docs/ui/widgets.md#subview-composition)

unit Fpas.Ui.Internal.Mapping.MessageMapping;

uses Fpas.Ui.Internal.Mapping.Scopes as Scopes;
uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.Widgets.Actions.SplitButtons as S;
uses Fpas.Ui.Widgets.Navigation.Navigation as N;
uses Fpas.Ui.Widgets.Overlays.Menus as M;

uses System as Sys;
uses System.Collections.Generic as Lists;

// Wraps an optional message factory without invoking it.
// ## Type parameters
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `Value`: Optional native activation factory.
// - `Messages`: Message translation.
// ## Returns
// A translated factory, or null when the original was absent.
public function Factory of (TChild, TParent)(
  Value: (Sys.Func of TChild)?;
  Messages: function(TChild): TParent
): (Sys.Func of TParent)?;
begin
  case Value of
    when is Sys.Func of TChild as Original:
      return function(): TParent => Messages(Original.Invoke());
    else
      return null;
  end case;
end function;

// Wraps an optional one-argument callback without invoking it.
// ## Type parameters
// - `TArg`: Callback argument.
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `Value`: Optional callback.
// - `Messages`: Message translation.
// ## Returns
// A translated callback, retaining absence.
public function Callback of (TArg, TChild, TParent)(
  Value: Sys.Func of (TArg, TChild)?;
  Messages: function(TChild): TParent
): Sys.Func of (TArg, TParent)?;
begin
  case Value of
    when is Sys.Func of (TArg, TChild) as Original:
      return function(Argument: TArg): TParent => Messages(Original.Invoke(Argument));
    else
      return null;
  end case;
end function;

// Wraps a callback that receives a view ID from the host.
// ## Type parameters
// - `TChild`: Source message type.
// - `TParent`: Destination message type.
// ## Parameters
// - `Value`: Optional callback that expects a local ID.
// - `Messages`: Message translation.
// - `Scope`: ID prefix, or empty.
// ## Returns
// A callback that accepts a qualified ID, retaining absence.
public function IdCallback of (TChild, TParent)(
  Value: Sys.Func of (string, TChild)?;
  Messages: function(TChild): TParent;
  Scope: string
): Sys.Func of (string, TParent)?;
begin
  case Value of
    when is Sys.Func of (string, TChild) as Original:
      return function(Id: string): TParent => Messages(Original.Invoke(Scopes.LocalId(Scope, Id)));
    else
      return null;
  end case;
end function;

// Wraps an optional menu builder without invoking it.
// ## Type parameters
// - `TArg`: Builder argument.
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `Value`: Optional builder of menu entries.
// - `Messages`: Message translation.
// ## Returns
// A builder whose entries carry translated messages, retaining absence.
public function MenuSource of (TArg, TChild, TParent)(
  Value: Sys.Func of (TArg, array of M.Entry of TChild)?;
  Messages: function(TChild): TParent
): Sys.Func of (TArg, array of M.Entry of TParent)?;
begin
  case Value of
    when is Sys.Func of (TArg, array of M.Entry of TChild) as Original:
      return function(Argument: TArg): array of M.Entry of TParent => Menu of (TChild, TParent)(
        Original.Invoke(Argument),
        Messages
      );
    else
      return null;
  end case;
end function;

// Translates menu actions while retaining their keys and all decoration.
// ## Type parameters
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `Values`: Original entries.
// - `Messages`: Message translation.
// ## Returns
// Entries in the same order, including captions and separators.
public function Menu of (TChild, TParent)(
  Values: array of M.Entry of TChild;
  Messages: function(TChild): TParent
): array of M.Entry of TParent;
begin
  const Result: Lists.List of M.Entry of TParent := new Lists.List of M.Entry of TParent();
  for Index: int := 0 to Values.Length - 1 do
    Result.Add(
      case Values[Index] of
        when M.Entry.Action(const Item: M.Item of TChild): (M.Entry of TParent).Action(
          new M.Item of TParent(
            Item.Key, Item.Label, Messages(Item.Message), Item.Icon,
            Item.Shortcut, Item.Enabled, Item.Danger, Item.Checked, Item.Font, Item.TextSize
          )
        );
        when M.Entry.Label(const Caption: string): (M.Entry of TParent).Label(Caption);
        when M.Entry.Separator: (M.Entry of TParent).Separator;
      end case
    );
  end for;

  return Result.ToArray();
end function;

// Translates split-button choices while retaining their identities and glyphs.
// ## Type parameters
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `Values`: Original choices.
// - `Messages`: Message translation.
// ## Returns
// Choices in their original order.
public function Split of (TChild, TParent)(
  Values: array of S.Item of TChild;
  Messages: function(TChild): TParent
): array of S.Item of TParent;
begin
  const Result: Lists.List of S.Item of TParent := new Lists.List of S.Item of TParent();
  for Index: int := 0 to Values.Length - 1 do
    const Item: S.Item of TChild := Values[Index];
    Result.Add(
      new S.Item of TParent(
        Item.Key,
        Item.Label,
        Messages(Item.Message),
        Item.Icon
      )
    );
  end for;

  return Result.ToArray();
end function;

// Translates sidebar destinations while retaining keys, badges and input permission.
// ## Type parameters
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `Values`: Original sections.
// - `Messages`: Message translation.
// ## Returns
// Independently rebuilt sections in their original order.
public function Navigation of (TChild, TParent)(
  Values: array of N.Section of TChild;
  Messages: function(TChild): TParent
): array of N.Section of TParent;
begin
  const Result: Lists.List of N.Section of TParent := new Lists.List of N.Section of TParent();
  for Section: int := 0 to Values.Length - 1 do
    const Original: N.Section of TChild := Values[Section];
    const Items: Lists.List of N.Item of TParent := new Lists.List of N.Item of TParent();
    for Index: int := 0 to Original.Items.Length - 1 do
      const Item: N.Item of TChild := Original.Items[Index];
      Items.Add(
        new N.Item of TParent(
          Item.Key,
          Item.Label,
          Messages(Item.Message),
          Item.Enabled,
          Item.Icon,
          Item.Badge
        )
      );
    end for;

    Result.Add(new N.Section of TParent(Original.Title, Items.ToArray(), Original.GapBefore));
  end for;

  return Result.ToArray();
end function;

// Translates terminal shortcut messages without changing their key bindings.
// ## Type parameters
// - `TChild`: Source messages.
// - `TParent`: Destination messages.
// ## Parameters
// - `Values`: Original bindings.
// - `Messages`: Message translation.
// ## Returns
// Equivalent bindings producing parent messages.
public function Shortcuts of (TChild, TParent)(
  Values: array of K.ShortcutBinding of TChild;
  Messages: function(TChild): TParent
): array of K.ShortcutBinding of TParent;
begin
  const Result: Lists.List of K.ShortcutBinding of TParent := new Lists.List of K.ShortcutBinding of TParent();
  for Index: int := 0 to Values.Length - 1 do
    const Item: K.ShortcutBinding of TChild := Values[Index];
    Result.Add(
      new K.ShortcutBinding of TParent(
        Item.PressedKey,
        Item.Modifiers,
        Messages(Item.Message),
        Item.Character
      )
    );
  end for;

  return Result.ToArray();
end function;

end unit;
