unit Fpas.Ui.Internal.MenuRules;

uses Fpas.Ui.Menus as M, Fpas.Ui.Styles as S, Fpas.Ui.Internal.Rules as Rules, System as Sys;

// Validates menu identities, commands and optional dropdown settings.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Trigger identity.
// - `Label`: Trigger caption and accessible name.
// - `Entries`: Ordered commands and decorations.
// - `Settings`: Dropdown options, or null for a native context menu.
// - `Location`: Owning view path.
// - `Identify`: Registers a globally unique identity and returns its diagnostic path.
public procedure Check<TMsg>(Id: string; Label: string; Entries: array of M.Entry<TMsg>; Settings: M.Options?; Location: string; Identify: function(string, string): string);
begin
  const At: string := Identify(Id, Location + '/menu');
  Rules.CheckText(Label, At);
  if Label = '' or Label.Contains(#10) or Label.Contains(#13) then
    Rules.Reject(At, 'A menu needs a single-line name.');
  end if;

  if Settings <> null then
    Rules.CheckText(Settings.Icon, At + '/icon');
    Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
    if Settings.Variant = S.ButtonVariant.Active or not Sys.Enum.IsDefined<S.ButtonVariant>(
      Settings.Variant
    )
      or not Sys.Enum.IsDefined<M.Placement>(Settings.Position)
      or not Sys.Single.IsFinite(Settings.Width) or Settings.Width < 0.0
    then
      Rules.Reject(At, 'A menu needs a CUI variant, placement and finite nonnegative width.');
    end if;
  end if;

  for Entry: M.Entry<TMsg> in Entries do
    case Entry of
      when M.Entry.Action(const Item: M.Item<TMsg>):
        if Sys.String.IsNullOrWhiteSpace(Item.Key) then
          Rules.Reject(At, 'Menu command keys must be nonempty.');
        end if;
        const Path: string := Identify(M.ItemId(Id, Item.Key), At + '/item');
        Rules.CheckText(Item.Label, Path + '/label');
        Rules.CheckText(Item.Icon, Path + '/icon');
        Rules.CheckText(Item.TerminalIcon, Path + '/terminalIcon');
        Rules.CheckText(Item.Shortcut, Path + '/shortcut');
        if Item.Label = '' or Item.Label.Contains(#10) or Item.Label.Contains(#13)
          or Item.Shortcut.Contains(#10) or Item.Shortcut.Contains(#13)
        then
          Rules.Reject(Path, 'Menu captions and shortcut hints must fit one line.');
        end if;
      when M.Entry.Label(const Text: string):
        Rules.CheckText(Text, At + '/label');
        if Text.Contains(#10) or Text.Contains(#13) then
          Rules.Reject(At, 'Menu section captions must fit one line.');
        end if;
      when M.Entry.Separator:
    end case;
  end for;
end procedure;

end unit;
