unit Fpas.Ui.Internal.SelectionRules;

uses
  Fpas.Ui.Internal.Rules as Rules, Fpas.Ui.Validation as V,
  Fpas.Ui.Layout as L, Fpas.Ui.RadioGroups as R, Fpas.Ui.RadioCards as Cards, System as Sys;

// Checks the identity and text of a native selection row.
//
// ## Parameters
// - `Id`: Stable row identity.
// - `Label`: Required caption.
// - `Description`: Optional secondary text.
// - `Profile`: Target profile, which must be graphical.
// - `Location`: View path used for diagnostics.
// - `Identify`: Validates and registers a unique view identity.
public procedure CheckRow(
  Id: string; Label: string; Description: string; Profile: V.Target;
  Location: string; Identify: function(string, string): string
);
begin
  const At: string := Identify(Id, Location);
  Rules.RequireProfile(Profile, V.Target.Graphical, At);
  Rules.CheckText(Label, At + '/label');
  Rules.CheckText(Description, At + '/description');
  if Sys.String.IsNullOrWhiteSpace(Label) then
    Rules.Reject(At, 'A selection row needs an accessible label.');
  end if;
end procedure;

// Checks radio group selection and registers every positional row.
//
// ## Parameters
// - `Id`: Stable group identity.
// - `Items`: Positional radio choices.
// - `Selected`: Selected index, or minus one.
// - `Gap`: Native row spacing.
// - `Profile`: Target profile, which must be graphical.
// - `Location`: View path used for diagnostics.
// - `Identify`: Validates and registers a unique view identity.
public procedure CheckGroup(
  Id: string; Items: array of R.Item; Selected: int; Gap: L.Spacing; Profile: V.Target;
  Location: string; Identify: function(string, string): string
);
begin
  const At: string := Identify(Id, Location);
  Rules.RequireProfile(Profile, V.Target.Graphical, At);
  Rules.CheckSpacing(Gap, Profile, At + '/gap');
  if Items.Length = 0 or Selected < -1 or Selected >= Items.Length then
    Rules.Reject(At, 'A radio group needs choices and a selected index or minus one.');
  end if;

  for Index: int := 0 to Items.Length - 1 do
    const Item: R.Item := Items[Index];
    CheckRow(R.ItemId(Id, Index), Item.Label, Item.Description, Profile, At + '/item', Identify);
  end for;
end procedure;

// Checks the native card grid and registers its positional identities.
//
// ## Parameters
// - `Id`: Stable group identity.
// - `Items`: Nonempty positional choices.
// - `Selected`: Selected index, or minus one.
// - `Columns`: Maximum columns, or zero for automatic layout.
// - `Profile`: Receiving host profile.
// - `Location`: View path for diagnostics.
// - `Identify`: Validates and registers a unique view identity.
public procedure CheckCards(
  Id: string; Items: array of Cards.Item; Selected: int; Columns: int; Profile: V.Target;
  Location: string; Identify: function(string, string): string
);
begin
  const At: string := Identify(Id, Location + '/radioCards');
  Rules.RequireProfile(Profile, V.Target.Graphical, At);
  if Items.Length = 0 or Selected < -1 or Selected >= Items.Length or Columns < 0 then
    Rules.Reject(At, 'Radio cards need choices, a valid selection and a nonnegative column count.');
  end if;

  for Index: int := 0 to Items.Length - 1 do
    const Item: Cards.Item := Items[Index];
    CheckRow(
      Cards.ItemId(Id, Index),
      Item.Title,
      Item.Description,
      Profile,
      At + '/card',
      Identify
    );
    Rules.CheckText(Item.Icon, At + '/icon');
    Rules.CheckText(Item.Badge, At + '/badge');
  end for;
end procedure;
end unit;
