unit Fpas.Ui.Internal.StatusButtons;

uses Fpas.Ui.StatusButtons as B, System as Sys;

// Resolves the same literal caption for native and terminal presentation.
//
// ## Parameters
// - `Label`: Resting caption.
// - `State`: Model-owned work state.
// - `Settings`: Feedback captions.
// ## Returns
// The caption for the supplied state.
public function Caption(Label: string; State: B.Status; Settings: B.Options): string;
begin
  case State of
    when B.Status.Idle:
      return Label;
    when B.Status.Busy:
      return Settings.BusyLabel ?? Label + '…';
    when B.Status.Success:
      return Settings.SuccessLabel;
    when B.Status.Error:
      return Settings.ErrorLabel;
    else
      raise new Sys.ArgumentOutOfRangeException('State');
  end case;
end function;

// Provides the host-independent value used in control snapshots.
//
// ## Parameters
// - `State`: Model-owned work state.
// ## Returns
// idle, busy, success or error.
public function Value(State: B.Status): string;
begin
  case State of
    when B.Status.Idle:
      return 'idle';
    when B.Status.Busy:
      return 'busy';
    when B.Status.Success:
      return 'success';
    when B.Status.Error:
      return 'error';
    else
      raise new Sys.ArgumentOutOfRangeException('State');
  end case;
end function;

end unit;
