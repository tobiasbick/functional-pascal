unit Fpas.Ui.Internal.TextFieldRules;

uses
  Fpas.Ui.TextFields as F, Fpas.Ui.Buttons as B, Fpas.Ui.Internal.Rules as R,
  System as Sys, System.Text as Text;

// Validates a value and its graphical field options before native drawing.
//
// ## Parameters
// - `Value`: Model-owned value.
// - `Settings`: Native options.
// - `Location`: View path for diagnostics.
public procedure Check(Value: string; Settings: F.Options; Location: string);
begin
  R.CheckText(Value, Location + '/value');
  if Value.Contains(cast<char>(10)) or Value.Contains(cast<char>(13)) then
    R.Reject(Location, 'A text field requires a single-line value.');
  end if;
  const Capacity: int := Settings.MaxUtf8Bytes;
  if Capacity <= 0 or Capacity >= Sys.Array.MaxLength or (Settings.Password and Capacity > 341) then
    R.Reject(
      Location,
      'A text field requires a valid UTF-8 capacity, at most 341 bytes for passwords.'
    );
  end if;

  if Text.Encoding.UTF8.GetByteCount(Value) > Capacity then
    R.Reject(Location, 'The text field value exceeds its UTF-8 capacity.');
  end if;

  if not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize) then
    R.Reject(Location, 'The text field requires a valid control size.');
  end if;

  R.CheckText(Settings.Label, Location + '/label');
  R.CheckText(Settings.Placeholder, Location + '/placeholder');
  R.CheckText(Settings.Icon, Location + '/icon');
  R.CheckText(Settings.Hint, Location + '/hint');
  R.CheckText(Settings.Error, Location + '/error');
  R.CheckText(Settings.Prefix, Location + '/prefix');
  R.CheckText(Settings.Suffix, Location + '/suffix');
end procedure;
end unit;
