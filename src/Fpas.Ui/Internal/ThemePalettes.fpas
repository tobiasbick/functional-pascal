function Read(Text: string): G.Color;
begin
  const Value: uint := Sys.UInt32.Parse(
    Text,
    Global.NumberStyles.HexNumber,
    Global.CultureInfo.InvariantCulture
  );
  return new G.Color(
    cast<byte>(Value shr 24), cast<byte>((Value shr 16) and 255),
    cast<byte>((Value shr 8) and 255), cast<byte>(Value and 255)
  );
end function;

// Resolves one CUI palette without loading a native renderer.
//
// ## Parameters
// - `Dark`: Whether to use dark appearance.
// - `Accent`: Validated CUI accent ordinal.
//
// ## Returns
// A detached palette in semantic token order.
public function Create(Dark: bool; Accent: int): Th.Palette;
begin
  const C: array of string := Colors[
    (if Dark then
      8
    else
      0
    end if) + Accent
  ].Split(' ');
  return new Th.Palette(
    Background := Read(C[0]),
    Surface := Read(C[1]),
    SurfaceRaised := Read(C[2]),
    SurfaceMuted := Read(C[3]),
    Foreground := Read(C[4]),
    TextSecondary := Read(C[5]),
    TextMuted := Read(C[6]),
    Border := Read(C[7]),
    BorderSubtle := Read(C[8]),
    BorderStrong := Read(C[9]),
    Accent := Read(C[10]),
    AccentStrong := Read(C[11]),
    AccentSubtle := Read(C[12]),
    AccentForeground := Read(C[13]),
    Success := Read(C[14]),
    Warning := Read(C[15]),
    Danger := Read(C[16]),
    Info := Read(C[17]),
    ControlOn := Read(C[18]),
    ControlGlyph := Read(C[19]),
    ControlTrack := Read(C[20]),
    ControlTrackHover := Read(C[21]),
    ControlThumb := Read(C[22]),
    ControlThumbOn := Read(C[23]),
    Hover := Read(C[24]),
    Active := Read(C[25]),
    Scrim := Read(C[26]),
    FocusRing := Read(C[27]),
    Series1 := Read(C[28]),
    Series2 := Read(C[29]),
    Series3 := Read(C[30]),
    Series4 := Read(C[31]),
    Series5 := Read(C[32]),
    Series6 := Read(C[33])
  );
end function;

end unit;
