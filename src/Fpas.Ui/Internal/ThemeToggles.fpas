unit Fpas.Ui.Internal.ThemeToggles;

uses Fpas.Ui.Themes as Themes;

// Gets the concrete appearance proposed by activation.
//
// ## Parameters
// - `Appearance`: Current validated light/dark appearance.
// ## Returns
// The opposite concrete appearance.
public function Opposite(Appearance: Themes.Mode): Themes.Mode;
begin
  return if Appearance = Themes.Mode.Dark then Themes.Mode.Light else Themes.Mode.Dark end if;
end function;

// Gets the accessible action name for the opposite appearance.
//
// ## Parameters
// - `Appearance`: Current validated light/dark appearance.
// ## Returns
// Switch to light or Switch to dark.
public function Label(Appearance: Themes.Mode): string;
begin
  return if Appearance = Themes.Mode.Dark then 'Switch to light' else 'Switch to dark' end if;
end function;
end unit;
