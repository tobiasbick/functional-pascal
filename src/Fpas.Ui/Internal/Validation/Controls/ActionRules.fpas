// [Documentation](../../../../../docs/ui/widgets.md#host-preflight)

unit Fpas.Ui.Internal.Validation.Controls.ActionRules;

uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Styles as Styles;
uses Fpas.Ui.Widgets.Actions.SpeedDials as D;
uses Fpas.Ui.Widgets.Actions.SwipeActions as S;
uses Fpas.Ui.Widgets.Overlays.Menus as M;

uses System as Sys;

// Validates a speed dial before native presentation.
// ## Parameters
// - `Items`: Ordered actions.
// - `Settings`: Trigger options.
// - `At`: Diagnostic path.
public procedure SpeedDial(Items: array of D.Item; Settings: D.Options; At: string);
begin
  if Items.Length < 1 or Items.Length > 16 or not Sys.Enum.IsDefined of M.Placement(
    Settings.Position
  )
  then
    R.Reject(At, 'A speed dial needs one through sixteen actions and a native placement.');
  end if;

  R.CheckText(Settings.Icon ?? '', At + '/icon');
  R.CheckText(Settings.Tooltip ?? '', At + '/tooltip');
  for Item: D.Item in Items do
    R.CheckText(Item.Label ?? '', At + '/action');
    R.CheckText(Item.Icon ?? '', At + '/glyph');
  end for;
end procedure;

// Validates a row's native swipe actions and decoration.
// ## Parameters
// - `Left`: Left-side actions.
// - `Right`: Right-side actions.
// - `Settings`: Row options.
// - `At`: Diagnostic path.
public procedure SwipeRow(
  Left: array of S.Item;
  Right: array of S.Item;
  Settings: S.Options;
  At: string
);
  procedure Check(Items: array of S.Item);
  begin
    for Item: S.Item in Items do
      R.CheckText(Item.Label ?? '', At + '/action');
      R.CheckText(Item.Icon ?? '', At + '/glyph');
      if not Sys.Enum.IsDefined of Styles.Tone(Item.Tone) then
        R.Reject(At, 'Each swipe action needs a native tone.');
      end if;
    end for;
  end procedure;
begin
  if Left.Length > 100 then
    R.Reject(At, 'A swipe row can have at most 100 left actions.');
  end if;

  R.CheckText(Settings.Icon, At + '/icon');
  R.CheckText(Settings.Detail, At + '/detail');
  Check(Left);
  Check(Right);
end procedure;

end unit;
