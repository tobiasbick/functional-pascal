// [Documentation](../../../../../docs/ui/widgets.md#media)

unit Fpas.Ui.Internal.Validation.Controls.MediaRules;

uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Widgets.Media.MediaImages as M;

uses System as Sys;

procedure Rgba(Width: int; Height: int; Pixels: array of byte; At: string);
begin
  if Width <= 0 or Height <= 0 or cast Width as long * Height > Sys.Int32.MaxValue div 4
    or Pixels = null or Pixels.Length <> cast Width as long * Height * 4
  then
    R.Reject(At, 'The RGBA image must contain four bytes per pixel.');
  end if;
end procedure;

// Checks a graphical image source before uploading it.
// ## Parameters
// - `Source`: Image file or tightly packed RGBA buffer.
// - `At`: Location used for validation diagnostics.
public procedure Image(Source: M.Source; At: string);
begin
  case Source of
    when M.Source.File(const Path: string):
      R.CheckText(Path, At);
      if Sys.String.IsNullOrWhiteSpace(Path) then
        R.Reject(At, 'The image file path is empty.');
      end if;
    when M.Source.UpdatedRgba(
      const W: int,
      const H: int,
      const Data: array of byte,
      const Previous: array of byte,
      const X: int,
      const Y: int,
      const RW: int,
      const RH: int
    ):
      Rgba(W, H, Data, At);
      if Previous = null or Previous.Length <> Data.Length or X < 0 or Y < 0 or RW <= 0 or RH <= 0
        or RW > W - X or RH > H - Y
      then
        R.Reject(At, 'Invalid RGBA update rectangle or previous snapshot.');
      end if;
    when M.Source.Rgba(const Width: int, const Height: int, const Pixels: array of byte):
      Rgba(Width, Height, Pixels, At);
  end case;
end procedure;

// Checks that image coordinates can be represented by CUI.
// ## Parameters
// - `X`: Horizontal coordinate.
// - `Y`: Vertical coordinate.
// - `At`: Location used for validation diagnostics.
public procedure Finite(X: float; Y: float; At: string);
begin
  if not Sys.Single.IsFinite(X) or not Sys.Single.IsFinite(Y) then
    R.Reject(At, 'Image coordinates must be finite.');
  end if;
end procedure;

end unit;
