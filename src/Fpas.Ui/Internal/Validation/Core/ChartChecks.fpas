// [Documentation](../../../../../docs/ui/widgets.md#charts)

unit Fpas.Ui.Internal.Validation.Core.ChartChecks;

uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Widgets.Charts.Charts as C;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;

// Validates a finite nonnegative chart dimension.
// ## Parameters
// - `Value`: Logical distance.
// - `At`: Diagnostic location.
public procedure Distance(Value: float; At: string);
begin
  if not Sys.Single.IsFinite(Value) or Value < 0.0F then
    R.Reject(At, 'Chart dimensions must be finite and nonnegative.');
  end if;
end procedure;

// Validates a safe native number format.
// ## Parameters
// - `Value`: Optional format.
// - `At`: Diagnostic location.
public procedure Format(Value: C.ValueFormat?; At: string);
begin
  if Value = null then
    return;
  end if;

  R.CheckText(Value.Prefix, At);
  R.CheckText(Value.Suffix, At);
  const Digits: int := Value.DecimalPlaces ?? 0;
  if Digits < 0 or Digits > 999 or Value.FieldWidth < 0 or Value.FieldWidth > 999 then
    R.Reject(At, 'Chart precision and field width must be between zero and 999.');
  end if;

  if not Sys.Enum.IsDefined of C.ValueNotation(Value.Notation)
    or not Sys.Enum.IsDefined of C.ValuePadding(Value.Padding)
    or not Sys.Enum.IsDefined of C.ValueSign(Value.Sign)
  then
    R.Reject(At, 'Unknown chart number notation, padding or sign.');
  end if;
end procedure;

// Validates a native chart theme color.
// ## Parameters
// - `Value`: Chart color.
// - `At`: Diagnostic location.
public procedure Color(Value: C.Color; At: string);
begin
  case Value of
    when C.Color.Theme(const Token: Themes.ColorToken):
      if not Sys.Enum.IsDefined of Themes.ColorToken(Token) then
        R.Reject(At, 'A chart theme color needs a known token.');
      end if;
    else
      begin
      end;
  end case;
end procedure;

// Validates a native chart annotation.
// ## Parameters
// - `Value`: Annotation kind, coordinates and appearance.
// - `At`: Diagnostic location.
public procedure Annotation(Value: C.Annotation; At: string);
begin
  R.CheckText(Value.Label ?? '', At);
  R.CheckText(Value.Detail ?? '', At);
  Color(Value.Color, At);
  if not Sys.Enum.IsDefined of C.AnnotationKind(Value.Kind)
    or not Sys.Double.IsFinite(Value.X) or not Sys.Double.IsFinite(Value.Y)
  then
    R.Reject(At, 'Chart annotations need finite coordinates and a known kind.');
  end if;
end procedure;

// Validates nonnegative shares with a finite total.
// ## Parameters
// - `Values`: Native shares.
// - `At`: Diagnostic location.
public procedure Shares(Values: array of float; At: string);
begin
  var Sum: float := 0.0F;
  for Value: float in Values do
    Distance(Value, At);
    Sum := Sum + Value;
  end for;

  Distance(Sum, At);
end procedure;

// Validates named amounts shared by native visualizations.
// ## Parameters
// - `Items`: Named nonnegative amounts.
// - `At`: Diagnostic location.
public procedure Items(Items: array of C.Item; At: string);
begin
  var Total: float := 0.0F;
  for Item: C.Item in Items do
    R.CheckText(Item.Label, At);
    Distance(Item.Value, At);
    Color(Item.Color, At);
    Total := Total + Item.Value;
  end for;

  Distance(Total, At);
end procedure;

end unit;
