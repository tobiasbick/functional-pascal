// [Documentation](../../../../../docs/ui/widgets.md#host-preflight)

unit Fpas.Ui.Internal.Validation.Core.ContainerRules;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Internal.Validation.Core.LayoutRules as LR;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;

procedure CheckColor(Color: G.Color?; Token: Themes.ColorToken?; Location: string);
begin
  if Token <> null then
    if Color <> null or not Sys.Enum.IsDefined of Themes.ColorToken(Token.Value) then
      R.Reject(Location, 'Choose an explicit RGBA color or a valid theme color.');
    end if;
  end if;
end procedure;

procedure CheckContainer(Settings: L.Flow; Current: R.Profile; Location: string);
begin
  const Scope: L.FocusScope? := Settings.Scope;
  if Scope <> null then
    R.RequireProfile(Current, R.Profile.Graphical, Location);
    if Sys.String.IsNullOrWhiteSpace(Scope.Id) then
      R.Reject(Location, 'A focus scope needs an ID.');
    end if;

    R.CheckText(Scope.Id, Location + '/focusScope');
  end if;

  if not Sys.Enum.IsDefined of L.Direction(Settings.ReadingDirection) then
    R.Reject(Location, 'Unknown reading direction.');
  end if;

  if not Sys.Single.IsFinite(Settings.CornerRadius) or Settings.CornerRadius < 0.0F then
    R.Reject(Location, 'The corner radius must be finite and nonnegative.');
  end if;

  if Settings.Background <> null or Settings.BackgroundTheme <> null
    or Settings.CornerRadius > 0.0F or Settings.Border <> null or Settings.Corners <> null
    or Settings.Opacity <> 1.0F or Settings.Elevation <> L.Elevation.None
    or Settings.Scrolling <> L.ScrollMode.None or Settings.Id <> null
  then
    R.RequireProfile(Current, R.Profile.Graphical, Location);
  end if;

  if not Sys.Enum.IsDefined of L.Elevation(Settings.Elevation) then
    R.Reject(Location, 'Unknown container elevation.');
  end if;

  if not Sys.Enum.IsDefined of L.ScrollMode(Settings.Scrolling) then
    R.Reject(Location, 'Unknown container scroll mode.');
  end if;

  if not Sys.Single.IsFinite(Settings.Opacity) or Settings.Opacity < 0.0F
    or Settings.Opacity > 1.0F
  then
    R.Reject(Location, 'Container opacity must be finite and between zero and one.');
  end if;

  CheckColor(Settings.Background, Settings.BackgroundTheme, Location + '/background');
  const Border: L.Border? := Settings.Border;
  if Border <> null then
    if not Sys.Single.IsFinite(Border.Width) or Border.Width < 0.0F then
      R.Reject(Location, 'The border width must be finite and nonnegative.');
    end if;

    CheckColor(Border.Color, Border.ThemeColor, Location + '/border');
  end if;
  const Corners: L.CornerRadii? := Settings.Corners;
  if Corners <> null then
    for Radius: float? in [
      Corners.TopLeft,
      Corners.TopRight,
      Corners.BottomRight,
      Corners.BottomLeft
    ] do
      if Radius <> null then
        if not Sys.Single.IsFinite(Radius.Value) or Radius.Value < 0.0F then
          R.Reject(Location, 'Corner radii must be finite and nonnegative.');
        end if;
      end if;
    end for;
  end if;

  if Settings.ReadingDirection <> L.Direction.Inherit then
    R.RequireProfile(Current, R.Profile.Graphical, Location);
  end if;

  for Inset: L.Spacing? in [
    Settings.PaddingTop,
    Settings.PaddingEnd,
    Settings.PaddingBottom,
    Settings.PaddingStart,
    Settings.PaddingX,
    Settings.PaddingY
  ] do
    if Inset <> null then
      R.RequireProfile(Current, R.Profile.Graphical, Location);
      LR.CheckSpacing(Inset, Current, Location);
    end if;
  end for;
end procedure;

// Validates flow options for a layered stack.
// ## Parameters
// - `Flow`: Layered container options.
// - `Current`: Receiving capability profile.
// - `Location`: Diagnostic path.
public procedure CheckLayered(Flow: L.Flow; Current: R.Profile; Location: string);
begin
  R.RequireProfile(Current, R.Profile.Graphical, Location + '/layers');
  CheckContainer(Flow, Current, Location + '/layers');
  LR.CheckSpacing(Flow.Gap, Current, Location + '/layers');
  LR.CheckSpacing(Flow.Padding, Current, Location + '/layers');
  if Flow.Wrap or not Sys.Enum.IsDefined of L.Alignment(
    Flow.Align
  ) or not Sys.Enum.IsDefined of L.Justification(Flow.Justify)
  then
    R.Reject(
      Location,
      'Layered stacks require valid alignment and justification without wrapping.'
    );
  end if;
end procedure;

// Validates flow options for a row or column stack.
// ## Parameters
// - `Flow`: Stack container options.
// - `Horizontal`: True for a row, false for a column.
// - `Current`: Receiving capability profile.
// - `Location`: Parent diagnostic path.
// - `At`: Stack diagnostic path.
public procedure CheckStack(
  Flow: L.Flow;
  Horizontal: bool;
  Current: R.Profile;
  Location: string;
  At: string
);
begin
  CheckContainer(Flow, Current, At);
  if Flow.Clip <> null then
    R.RequireProfile(Current, R.Profile.Graphical, Location + '/clip');
  end if;

  if Flow.Wrap then
    R.RequireProfile(Current, R.Profile.Graphical, At);
    if not Horizontal then
      R.Reject(At, 'Wrapping requires a row.');
    end if;
  end if;

  if not Sys.Enum.IsDefined of L.Alignment(Flow.Align) then
    R.Reject(At, 'Unknown cross-axis alignment.');
  end if;

  if not Sys.Enum.IsDefined of L.Justification(Flow.Justify) then
    R.Reject(At, 'Unknown main-axis justification.');
  end if;

  if Flow.Justify <> L.Justification.Start then
    R.RequireProfile(Current, R.Profile.Graphical, At + '/justify');
  end if;

  LR.CheckSpacing(Flow.Gap, Current, At + '/gap');
  LR.CheckSpacing(Flow.Padding, Current, At + '/padding');
end procedure;

end unit;
