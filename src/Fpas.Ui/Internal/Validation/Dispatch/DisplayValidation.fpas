// [Documentation](../../../../../docs/ui/widgets.md#native-text-and-drawing)

unit Fpas.Ui.Internal.Validation.Dispatch.DisplayValidation;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Internal.Validation.Controls.MediaRules as M;
uses Fpas.Ui.Internal.Validation.Core.ChartChecks as C;
uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Internal.Validation.Core.LayoutRules as LR;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Canvas.Canvases as Canvas;
uses Fpas.Ui.Widgets.Display.Texts as Texts;
uses Fpas.Ui.Widgets.Media.Images as Images;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;
uses Fpas.Ui.Widgets.Overlays.Veils as Veil;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;

procedure Coordinates(X: float; Y: float; Path: string);
begin
  if not Sys.Single.IsFinite(X) or not Sys.Single.IsFinite(Y) then
    R.Reject(Path, 'Canvas points must be finite.');
  end if;
end procedure;

procedure Drawings(Shapes: array of Canvas.Shape; Path: string);
begin
  for Shape: Canvas.Shape in Shapes do
    case Shape of
      when Canvas.Shape.Rectangle(
        const X: float,
        const Y: float,
        const W: float,
        const H: float,
        const Radius: float,
        _
      ):
        Coordinates(X, Y, Path);
        C.Distance(W, Path);
        C.Distance(H, Path);
        C.Distance(Radius, Path);
      when Canvas.Shape.Circle(const X: float, const Y: float, const Radius: float, _):
        Coordinates(X, Y, Path);
        C.Distance(Radius, Path);
      when Canvas.Shape.Line(
        const X: float,
        const Y: float,
        const EndX: float,
        const EndY: float,
        const Thickness: float,
        _
      ):
        Coordinates(X, Y, Path);
        Coordinates(EndX, EndY, Path);
        C.Distance(Thickness, Path);
    end case;
  end for;
end procedure;

// Validates the native reading direction and alignment shared by text elements.
// ## Parameters
// - `Settings`: The text's native layout options.
// - `Location`: The source element's path for diagnostics.
public procedure CheckTextOptions(Settings: Texts.Options; Location: string);
begin
  if not Sys.Enum.IsDefined of L.Direction(Settings.ReadingDirection) then
    R.Reject(Location, 'Unknown native text reading direction.');
  end if;

  if not Sys.Enum.IsDefined of Texts.Alignment(Settings.Align) then
    R.Reject(Location, 'Unknown native text alignment.');
  end if;
end procedure;

// Validates the graphical display inputs and composed veil content.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Display widget.
// - `Location`: Parent diagnostic path.
// - `Profile`: Target capabilities.
// - `Identify`: Registers the widget ID.
// - `Visit`: Validates composed children.
public procedure Check of TMsg(
  Node: E.Element of TMsg;
  Location: string;
  Profile: R.Profile;
  Identify: function(string, string): string;
  Visit: procedure((E.Element of TMsg)?, string)
);
begin
  R.RequireProfile(Profile, R.Profile.Graphical, Location);
  case Node of
    when E.Element.NativeText(
      const Text: string,
      const Role: Texts.Appearance,
      const Settings: Texts.Options
    ):
      R.CheckText(Text, Location);
      if not Sys.Enum.IsDefined of Texts.Appearance(Role) then
        R.Reject(Location, 'Unknown native text role.');
      end if;

      CheckTextOptions(Settings, Location);
    when E.Element.Icon(
      const Glyph: string,
      const Size: float,
      const Color: G.Color?,
      const ThemeColor: Themes.ColorToken?
    ):
      const Path: string := Location + '/icon';
      R.CheckText(Glyph, Path);
      if not Sys.Single.IsFinite(Size) or Size < 0.0F then
        R.Reject(Path, 'Icon size must be finite and nonnegative.');
      end if;

      if ThemeColor <> null then
        if Color <> null or not Sys.Enum.IsDefined of Themes.ColorToken(ThemeColor.Value) then
          R.Reject(Path, 'Choose one explicit color or a valid theme color for the icon.');
        end if;
      end if;
    when E.Element.Emoji(const Glyph: string, const Size: float):
      R.CheckText(Glyph, Location);
      C.Distance(Size, Location);
    when E.Element.Keycap(const Keys: string):
      R.CheckText(Keys, Location);
    when E.Element.Image(
      const Id: string,
      const Source: Media.Source,
      const Options: Images.Options
    ):
      const Path: string := Identify(Id, Location + '/image');
      M.Image(Source, Path);
      LR.CheckExtent(Options.Width, Profile, Path);
      LR.CheckExtent(Options.Height, Profile, Path);
      C.Distance(Options.Radius, Path);
      C.Color(Options.Tint, Path);
    when E.Element.Canvas(
      const Id: string,
      const Drawing: array of Canvas.Shape,
      _,
      const Options: Canvas.Options,
      _, _,
      _,
      _
    ):
      const Path: string := Identify(Id, Location + '/canvas');
      LR.CheckExtent(Options.Width, Profile, Path);
      LR.CheckExtent(Options.Height, Profile, Path);
      if Options.HoverCursor <> null and not Sys.Enum.IsDefined of Canvas.Cursor(
        Options.HoverCursor ?? Canvas.Cursor.Arrow
      )
      then
        R.Reject(Path, 'Unknown canvas cursor.');
      end if;

      Drawings(Drawing, Path);
    when E.Element.Veil(
      const Id: string,
      _,
      _,
      const Child: E.Element of TMsg,
      const Options: Veil.Options
    ):
      const Path: string := Identify(Id, Location + '/veil');
      R.CheckText(Options.Label ?? '', Path);
      R.CheckText(Options.Hint ?? '', Path);
      C.Distance(Options.Radius, Path);
      C.Color(Options.Color, Path);
      LR.CheckExtent(Options.Width, Profile, Path);
      Visit(Child, Path);
    else
  end case;
end procedure;

end unit;
