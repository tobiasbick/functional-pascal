// [Documentation](../../../../../docs/ui/widgets.md#native-editing-tools)

unit Fpas.Ui.Internal.Validation.Inputs.EditorRules;

uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Inputs.SearchFields as S;
uses Fpas.Ui.Widgets.Inputs.TextAreas as A;
uses Fpas.Ui.Widgets.Inputs.TextFields as F;

uses System as Sys;
uses System.Text as Text;

procedure CheckValue(
  Value: string;
  Capacity: int;
  Size: B.Size;
  Password: bool;
  Multiline: bool;
  At: string
);
begin
  R.CheckText(Value, At + '/value');
  if Multiline then
    if Value.Contains(cast 13 as char) then
      R.Reject(At, 'A text area requires LF line endings.');
    end if;
  elsif Value.Contains(cast 10 as char) or Value.Contains(cast 13 as char) then
    R.Reject(At, 'A single-line editor requires a single-line value.');
  end if;

  if Capacity <= 0 or Capacity >= Sys.Array.MaxLength or (Password and Capacity > 341) then
    R.Reject(At, 'A text editor requires a valid UTF-8 capacity, at most 341 bytes for passwords.');
  end if;

  if Text.Encoding.UTF8.GetByteCount(Value) > Capacity then
    R.Reject(At, 'The text editor value exceeds its UTF-8 capacity.');
  end if;

  if not Sys.Enum.IsDefined of B.Size(Size) then
    R.Reject(At, 'The text editor requires a valid control size.');
  end if;
end procedure;

procedure CheckChrome(
  Label: string;
  Placeholder: string;
  Icon: string;
  Hint: string;
  Error: string;
  Prefix: string;
  Suffix: string;
  At: string
);
begin
  R.CheckText(Label, At + '/label');
  R.CheckText(Placeholder, At + '/placeholder');
  R.CheckText(Icon, At + '/icon');
  R.CheckText(Hint, At + '/hint');
  R.CheckText(Error, At + '/error');
  R.CheckText(Prefix, At + '/prefix');
  R.CheckText(Suffix, At + '/suffix');
end procedure;

// Validates a single-line text field and reserves its native action identities.
//
// ## Parameters
// - `Id`: Stable editor identity.
// - `Value`: Current model text.
// - `Settings`: Native presentation and input options.
// - `Profile`: Requested capability profile.
// - `Location`: Parent view path.
// - `Identify`: Registers a stable ID at a diagnostic path.
public procedure CheckTextField(
  Id: string;
  Value: string;
  Settings: F.Options;
  Profile: R.Profile;
  Location: string;
  Identify: function(string, string): string
);
begin
  const Path: string := Location + '/textField';
  if Settings.Icon <> '' or Settings.Prefix <> '' or Settings.Suffix <> '' or Settings.Password
    or Settings.Clearable or Settings.ControlSize <> B.Size.Medium
  then
    R.RequireProfile(Profile, R.Profile.Graphical, Path);
  end if;
  const At: string := Identify(Id, Path);
  if Settings.Clearable then
    discard Identify(F.ClearId(Id), At + '/clear');
  end if;

  if Settings.Password then
    discard Identify(F.RevealId(Id), At + '/reveal');
  end if;

  CheckValue(Value, Settings.MaxUtf8Bytes, Settings.ControlSize, Settings.Password, false, At);
  CheckChrome(
    Settings.Label, Settings.Placeholder, Settings.Icon, Settings.Hint, Settings.Error,
    Settings.Prefix, Settings.Suffix, At
  );
end procedure;

// Validates a search field and reserves its clear action identity.
//
// ## Parameters
// - `Id`: Stable editor identity.
// - `Value`: Current model text.
// - `Settings`: Native presentation and input options.
// - `Profile`: Requested capability profile.
// - `Location`: Parent view path.
// - `Identify`: Registers a stable ID at a diagnostic path.
public procedure CheckSearchField(
  Id: string;
  Value: string;
  Settings: S.Options;
  Profile: R.Profile;
  Location: string;
  Identify: function(string, string): string
);
begin
  const Path: string := Location + '/searchField';
  if Profile = R.Profile.Portable then
    R.Reject(Path, 'A search field requires the terminal or graphical profile.');
  end if;
  const At: string := Identify(Id, Path);
  discard Identify(S.ClearId(Id), At + '/clear');
  CheckValue(Value, Settings.MaxUtf8Bytes, Settings.ControlSize, false, false, At);
  CheckChrome(
    Settings.Label, Settings.Placeholder, Settings.Icon, Settings.Hint, Settings.Error,
    Settings.Prefix, Settings.Suffix, At
  );
end procedure;

// Validates a text area and reserves its native action identities.
//
// ## Parameters
// - `Id`: Stable editor identity.
// - `Value`: Current model text.
// - `Settings`: Native presentation and input options.
// - `Profile`: Requested capability profile.
// - `Location`: Parent view path.
// - `Identify`: Registers a stable ID at a diagnostic path.
public procedure CheckTextArea(
  Id: string;
  Value: string;
  Settings: A.Options;
  Profile: R.Profile;
  Location: string;
  Identify: function(string, string): string
);
begin
  const Path: string := Location + '/textArea';
  if Settings.Icon <> '' or Settings.Prefix <> '' or Settings.Suffix <> '' or Settings.Clearable
    or Settings.ControlSize <> B.Size.Medium
  then
    R.RequireProfile(Profile, R.Profile.Graphical, Path);
  end if;
  const At: string := Identify(Id, Path);
  if Settings.Clearable then
    discard Identify(A.ClearId(Id), At + '/clear');
  end if;

  CheckValue(Value, Settings.MaxUtf8Bytes, Settings.ControlSize, false, true, At);
  CheckChrome(
    Settings.Label, Settings.Placeholder, Settings.Icon, Settings.Hint, Settings.Error,
    Settings.Prefix, Settings.Suffix, At
  );
end procedure;

end unit;
