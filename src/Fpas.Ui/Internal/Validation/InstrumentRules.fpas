unit Fpas.Ui.Internal.Validation.InstrumentRules;

uses
  Fpas.Ui.Internal.Validation.Rules as R, Fpas.Ui.Internal.Validation.ChartRules as ChartRules,
  Fpas.Ui.Internal.Validation.FeedbackRules as Feedback, Fpas.Ui.Validation as V, Fpas.Ui.Widgets.Developer.CodeBlocks as CodeBlocks,
  Fpas.Ui.Widgets.Developer.JsonViews as JsonViews, Fpas.Ui.Widgets.Display.Readouts as Readouts, Fpas.Ui.Widgets.Display.DotDisplays as Displays,
  Fpas.Ui.Widgets.Charts.DotCharts as Dots, Fpas.Ui.Widgets.Charts.EventTracks as Tracks, Fpas.Ui.Widgets.Charts.Charts as Charts,
  Fpas.Ui.Widgets.Collections.Tables as Tables, Fpas.Ui.Styles as Styles, System as Sys;

// Validates a native code block.
// ## Parameters
// - `Text`: Source text.
// - `Settings`: Native code block options.
// - `At`: Diagnostic path.
public procedure Code(Text: string; Settings: CodeBlocks.Options; At: string);
begin
  R.CheckText(Text, At);
  R.CheckText(Settings.Title, At + '/title');
  R.CheckText(Settings.Language, At + '/language');
  Feedback.Nonnegative(Settings.MaxHeight, At + '/height');
  Feedback.Nonnegative(Settings.Size, At + '/size');
  if Settings.HighlightFrom < 0 or Settings.HighlightTo < 0
    or (Settings.HighlightTo > 0 and (Settings.HighlightFrom = 0 or Settings.HighlightTo <
    Settings.HighlightFrom))
  then
    R.Reject(At, 'Invalid code highlight range.');
  end if;
end procedure;

// Validates a native JSON viewer.
// ## Parameters
// - `Text`: JSON source.
// - `Settings`: Native viewer options.
// - `At`: Diagnostic path.
public procedure Json(Text: string; Settings: JsonViews.Options; At: string);
begin
  R.CheckText(Text, At);
  Feedback.Nonnegative(Settings.MaxHeight, At + '/height');
  if Settings.ExpandDepth < 0 then
    R.Reject(At, 'Initial JSON depth must be nonnegative.');
  end if;
end procedure;

// Validates a readout and its presentation.
// ## Parameters
// - `Label`: Readout heading.
// - `Value`: Displayed value.
// - `Settings`: Native options.
// - `At`: Diagnostic path.
public procedure Readout(Label: string; Value: string; Settings: Readouts.Options; At: string);
begin
  R.CheckText(Label, At);
  R.CheckText(Value, At);
  R.CheckText(Settings.Unit, At + '/unit');
  R.CheckText(Settings.Detail, At + '/detail');
  R.CheckExtent(Settings.Width, V.Target.Graphical, At);
  if not Sys.Enum.IsDefined<Readouts.Size>(
    Settings.Size
  ) or not Sys.Enum.IsDefined<Styles.Tone>(Settings.Tone)
    or not Sys.Enum.IsDefined<Tables.Alignment>(Settings.Align)
  then
    R.Reject(At, 'Invalid readout size, tone or alignment.');
  end if;
end procedure;

// Validates dot-matrix display options.
// ## Parameters
// - `Text`: Literal display text.
// - `Settings`: Native options.
// - `At`: Diagnostic path.
public procedure Display(Text: string; Settings: Displays.Options; At: string);
begin
  R.CheckText(Text, At);
  R.CheckExtent(Settings.Width, V.Target.Graphical, At);
  Feedback.Nonnegative(Settings.Pitch, At);
  ChartRules.Color(Settings.Color, At);
  if not Sys.Enum.IsDefined<Tables.Alignment>(Settings.Align) then
    R.Reject(At, 'Invalid dot display alignment.');
  end if;
end procedure;

procedure Axis(Lo: double; Hi: double; Step: double; Units: Dots.AxisUnits; At: string);
begin
  if not Sys.Enum.IsDefined<Dots.AxisUnits>(Units) or not Sys.Double.IsFinite(Lo)
    or not Sys.Double.IsFinite(Hi) or not Sys.Double.IsFinite(Hi - Lo)
    or not Sys.Double.IsFinite(Step) or Step < 0.0
    or (Step > 0.0 and (Lo + Step <= Lo or Hi - Step >= Hi))
    or (Units = Dots.AxisUnits.Hours and (Sys.Math.Abs(
    Lo
  ) > 35000000.0 or Sys.Math.Abs(Hi) > 35000000.0))
  then
    R.Reject(At, 'The axis needs finite representable bounds and a valid step.');
  end if;
end procedure;

// Validates dot chart samples and native axes.
// ## Parameters
// - `Bands`: Stacked sample arrays.
// - `Count`: Number of samples per band.
// - `Settings`: Native chart options.
// - `At`: Diagnostic path.
public procedure Chart(Bands: array of Dots.Series; Count: int; Settings: Dots.Options; At: string);
begin
  R.CheckExtent(Settings.Width, V.Target.Graphical, At);
  Feedback.Nonnegative(Settings.Height, At);
  Feedback.Nonnegative(Settings.Pitch, At);
  R.CheckText(Settings.Unit, At);
  ChartRules.Format(Settings.Format, At);
  ChartRules.Format(Settings.XFormat, At);
  Axis(Settings.XMinimum, Settings.XMaximum, Settings.XStep, Settings.Units, At);
  if Settings.XMinimum > Settings.XMaximum or Bands.Length > 16 or Count < 0 then
    R.Reject(At, 'The dot chart needs ordered bounds, a sample count and at most 16 series.');
  end if;

  if Settings.Units = Dots.AxisUnits.Hours and Settings.XMinimum = Settings.XMaximum and Count >
    35000000
  then
    R.Reject(At, 'The implicit hours axis exceeds the native time range.');
  end if;
  const Range: Charts.ValueRange? := Settings.Range;
  if Range <> null and (not Sys.Single.IsFinite(
    Range.Maximum - Range.Minimum
  ) or Range.Maximum <= Range.Minimum)
  then
    R.Reject(At, 'The dot chart needs an ordered finite value range.');
  end if;

  for Band: Dots.Series in Bands do
    if Band.Values.Length <> Count then
      R.Reject(At, 'Each band must supply the declared number of samples.');
    end if;

    for Value: float in Band.Values do
      if not Sys.Single.IsFinite(Value) then
        R.Reject(At, 'Chart samples must be finite.');
      end if;
    end for;
  end for;

  for Item: Charts.Annotation in Settings.Annotations do
    R.CheckText(Item.Label, At);
    R.CheckText(Item.Detail, At);
    if not Sys.Enum.IsDefined<Charts.AnnotationKind>(Item.Kind)
      or not Sys.Double.IsFinite(Item.X) or not Sys.Double.IsFinite(Item.Y)
    then
      R.Reject(At, 'Chart annotations need finite coordinates and a known kind.');
    end if;
  end for;
end procedure;

// Validates a controlled event track.
// ## Parameters
// - `Current`: Times and selection.
// - `Settings`: Native axis and capacity settings.
// - `At`: Diagnostic path.
public procedure Events(Current: Tracks.Value; Settings: Tracks.Options; At: string);
begin
  R.CheckExtent(Settings.Width, V.Target.Graphical, At);
  ChartRules.Format(Settings.Format, At);
  Axis(Settings.Minimum, Settings.Maximum, Settings.Step, Settings.Units, At);
  Axis(Settings.Minimum, Settings.Maximum, Settings.LabelStep, Settings.Units, At);
  if Settings.Maximum <= Settings.Minimum or Settings.Capacity < Current.Times.Length
    or Current.Selected < -1 or Current.Selected >= Current.Times.Length
  then
    R.Reject(At, 'Invalid event track bounds, capacity or selection.');
  end if;
  var Previous: double := Settings.Minimum;
  for Time: double in Current.Times do
    if not Sys.Double.IsFinite(Time) or Time < Previous or Time > Settings.Maximum then
      R.Reject(At, 'Event times must be sorted and within the axis.');
    end if;

    Previous := Time;
  end for;
end procedure;

end unit;
