unit Fpas.Ui.Internal.Validation.MediaRules;

uses Fpas.Ui.Widgets.Media.MediaImages as M, Fpas.Ui.Internal.Validation.Rules as R, System as Sys;

// Checks a graphical image source before uploading it.
// ## Parameters
// - `Source`: Image file or tightly packed RGBA buffer.
// - `At`: Location used for validation diagnostics.
public procedure Image(Source: M.Source; At: string);
begin
  case Source of
    when M.Source.File(const Path: string):
      R.CheckText(Path, At);
      if Sys.String.IsNullOrWhiteSpace(Path) then
        R.Reject(At, 'The image file path is empty.');
      end if;
    when M.Source.Rgba(const Width: int, const Height: int, const Pixels: array of byte):
      if Width <= 0 or Height <= 0 or cast<long>(Width) * Height > Sys.Int32.MaxValue div 4
        or Pixels = null or Pixels.Length <> cast<long>(Width) * Height * 4
      then
        R.Reject(At, 'The RGBA image must contain four bytes per pixel.');
      end if;
  end case;
end procedure;

// Checks that image coordinates can be represented by CUI.
// ## Parameters
// - `X`: Horizontal coordinate.
// - `Y`: Vertical coordinate.
// - `At`: Location used for validation diagnostics.
public procedure Finite(X: float; Y: float; At: string);
begin
  if not Sys.Single.IsFinite(X) or not Sys.Single.IsFinite(Y) then
    R.Reject(At, 'Image coordinates must be finite.');
  end if;
end procedure;

end unit;
