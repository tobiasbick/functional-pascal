unit Fpas.Ui.Internal.Validation.MotionRules;

uses
  Fpas.Ui.Internal.Validation.Rules as R, Fpas.Ui.Internal.Validation.ChartRules as Chart, Fpas.Ui.Validation as V,
  Fpas.Ui.Widgets.Motion.Motion as M, Fpas.Ui.Widgets.Charts.Charts as C, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Motion.GradientTexts as Grad,
  Fpas.Ui.Widgets.Motion.Spotlights as Spot, Fpas.Ui.Widgets.Feedback.Loaders as Load, Fpas.Ui.Widgets.Navigation.Docks as D, Fpas.Ui.Widgets.Audio.ControlTiles as Tiles,
  Fpas.Ui.Widgets.Audio.NowPlaying as P, Fpas.Ui.Widgets.Audio.Waveforms as W, Fpas.Ui.Widgets.Navigation.TabBars as T, System as Sys;

procedure Extent(Value: L.Extent; At: string);
begin
  R.CheckExtent(Value, V.Target.Graphical, At);
end procedure;

procedure Fraction(Value: float; At: string);
begin
  if not Sys.Single.IsFinite(Value) or Value < 0.0F or Value > 1.0F then
    R.Reject(At, 'Waveform values must be finite fractions.');
  end if;
end procedure;

// Validates TextEffect input.
// ## Parameters
// - `Text`: Literal display text.
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure TextEffect(Text: string; Settings: M.TextOptions; At: string);
begin
  R.CheckText(Text, At);
  Extent(Settings.Width, At);
  Chart.Color(Settings.Color, At);
  Chart.Distance(Settings.Size, At);
  Chart.Distance(Settings.Speed, At);
  Chart.Distance(Settings.Delay, At);
  if not Sys.Enum.IsDefined<M.Font>(Settings.Font) then
    R.Reject(At, 'Unknown native motion font.');
  end if;
end procedure;

// Validates Words input.
// ## Parameters
// - `Words`: Words in rotation order.
// - `Interval`: Seconds per word.
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure Words(Words: array of string; Interval: float; Settings: M.TextOptions; At: string);
begin
  TextEffect('', Settings, At);
  Chart.Distance(Interval, At);
  for Word: string in Words do
    R.CheckText(Word, At);
  end for;
end procedure;

// Validates Gradient input.
// ## Parameters
// - `Text`: Literal display text.
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure Gradient(Text: string; Settings: Grad.Options; At: string);
begin
  TextEffect(
    Text, new M.TextOptions(
      Font := Settings.Font, Size := Settings.Size, Width := Settings.Width,
      Color := Settings.From
    ), At
  );
  Chart.Color(Settings.To, At);
end procedure;

// Validates Spotlight input.
// ## Parameters
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure Spotlight(Settings: Spot.Options; At: string);
begin
  Extent(Settings.Width, At);
  Extent(Settings.Height, At);
  Chart.Distance(Settings.Padding, At);
  Chart.Distance(Settings.Gap, At);
  Chart.Color(Settings.Color, At);
end procedure;

// Validates Loader input.
// ## Parameters
// - `Style`: Native loader style.
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure Loader(Style: Load.Animation; Settings: Load.Options; At: string);
begin
  Chart.Distance(Settings.Size, At);
  Chart.Color(Settings.Color, At);
  if not Sys.Enum.IsDefined<Load.Animation>(Style) then
    R.Reject(At, 'Unknown loader style.');
  end if;
end procedure;

// Validates Dock input.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Entries`: Dock items and separators.
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure Dock<TMsg>(Entries: array of D.Entry<TMsg>; Settings: D.Options; At: string);
begin
  Chart.Distance(Settings.Size, At);
  Chart.Distance(Settings.Magnify, At);
  for Entry: D.Entry<TMsg> in Entries do
    case Entry of
      when D.Entry.Item(
        const Icon: string,
        const Label: string,
        _,
        const Color: C.Color,
        _,
        const Badge: int
      ):
        R.CheckText(Icon, At);
        R.CheckText(Label, At);
        Chart.Color(Color, At);
        if Icon = '' or Badge < 0 then
          R.Reject(At, 'A dock item needs a glyph and nonnegative badge.');
        end if;
      else
    end case;
  end for;
end procedure;

// Validates Tile input.
// ## Parameters
// - `Label`: Literal tile caption.
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure Tile(Label: string; Settings: Tiles.Options; At: string);
begin
  R.CheckText(Label, At);
  R.CheckText(Settings.Icon, At);
  R.CheckText(Settings.Detail, At);
  Extent(Settings.Width, At);
  Chart.Color(Settings.Color, At);
end procedure;

// Validates Player input.
// ## Parameters
// - `Current`: Playback model.
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure Player(Current: P.Value; Settings: P.Options; At: string);
begin
  R.CheckText(Current.Title, At);
  R.CheckText(Current.Artist, At);
  R.CheckText(Current.Artwork, At);
  Extent(Settings.Width, At);
  Chart.Color(Current.ArtColor, At);
  Chart.Distance(Current.Duration, At);
  Chart.Distance(Current.Position, At);
  if Current.Position > Current.Duration then
    R.Reject(At, 'Playback position exceeds track duration.');
  end if;
end procedure;

// Validates Wave input.
// ## Parameters
// - `Peaks`: Normalized samples.
// - `Progress`: Optional seek position.
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure Wave(Peaks: array of float; Progress: float?; Settings: W.Options; At: string);
begin
  Extent(Settings.Width, At);
  Chart.Color(Settings.Color, At);
  Chart.Distance(Settings.Height, At);
  Chart.Distance(Settings.Bar, At);
  Chart.Distance(Settings.Gap, At);
  for Peak: float in Peaks do
    Fraction(Peak, At);
  end for;

  case Progress of
    when is float as Value:
      Fraction(Value, At);
    else
  end case;
end procedure;

// Validates Tabs input.
// ## Parameters
// - `Items`: Native tab descriptors.
// - `Selected`: Current tab index.
// - `Settings`: Native widget settings.
// - `At`: Diagnostic path.
public procedure Tabs(Items: array of T.Item; Selected: int; Settings: T.Options; At: string);
begin
  Extent(Settings.Width, At);
  if Selected < 0 or Selected >= Items.Length then
    R.Reject(At, 'The selected tab must name an item.');
  end if;

  for Item: T.Item in Items do
    R.CheckText(Item.Icon, At);
    R.CheckText(Item.Label, At);
    if Item.Badge < 0 then
      R.Reject(At, 'A tab badge must be nonnegative.');
    end if;
  end for;
end procedure;

end unit;
