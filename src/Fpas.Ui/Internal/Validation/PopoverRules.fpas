unit Fpas.Ui.Internal.Validation.PopoverRules;

uses
  Fpas.Ui.Widgets.Overlays.Popovers as P, Fpas.Ui.Widgets.Overlays.ConfirmPopovers as C, Fpas.Ui.Widgets.Overlays.Menus as M,
  Fpas.Ui.Elements as E, Fpas.Ui.Internal.Validation.TooltipRules as Buttons, Fpas.Ui.Internal.Validation.Rules as R,
  System as Sys;

// Verifies that a popover has a native button anchor.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Target`: Trigger element.
// - `Location`: View path for diagnostics.
public procedure CheckTrigger<TMsg>(Target: E.Element<TMsg>; Location: string);
begin
  if not Buttons.IsButton<TMsg>(Target) then
    R.Reject(Location, 'A popover needs a button trigger.');
  end if;
end procedure;

// Validates placement and logical spacing.
//
// ## Parameters
// - `Settings`: Panel options.
// - `Location`: View path for diagnostics.
public procedure CheckPanel(Settings: P.Options; Location: string);
begin
  if Settings.Width < 0 or Settings.Padding < 0 or Settings.Gap < 0
    or not Sys.Enum.IsDefined<M.Placement>(Settings.Position)
  then
    R.Reject(Location, 'A popover needs nonnegative dimensions and a valid placement.');
  end if;
end procedure;

// Validates a confirmation question and its actions.
//
// ## Parameters
// - `Settings`: Confirmation options.
// - `Location`: View path for diagnostics.
public procedure CheckQuestion(Settings: C.Options; Location: string);
begin
  R.CheckText(Settings.Title, Location + '/title');
  R.CheckText(Settings.Description, Location + '/description');
  R.CheckText(Settings.ConfirmLabel, Location + '/confirm');
  R.CheckText(Settings.CancelLabel, Location + '/cancel');
  if Sys.String.IsNullOrWhiteSpace(
    Settings.Title
  ) or Sys.String.IsNullOrWhiteSpace(Settings.ConfirmLabel)
    or Sys.String.IsNullOrWhiteSpace(
    Settings.CancelLabel
  ) or not Sys.Enum.IsDefined<M.Placement>(Settings.Position)
  then
    R.Reject(
      Location,
      'A confirmation popover needs a question, action captions and a valid placement.'
    );
  end if;
end procedure;

end unit;
