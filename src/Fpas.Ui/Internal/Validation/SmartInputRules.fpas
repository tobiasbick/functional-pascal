unit Fpas.Ui.Internal.Validation.SmartInputRules;

uses
  Fpas.Ui.Internal.Validation.Rules as R, Fpas.Ui.Layout as L, Fpas.Ui.Validation as V,
  Fpas.Ui.Widgets.Inputs.InlineEdits as I, Fpas.Ui.Widgets.Inputs.ScrubFields as S, Fpas.Ui.Widgets.Inputs.MoneyFields as M,
  Fpas.Ui.Widgets.Inputs.ShortcutRecorders as K, System as Sys, System.Text as Text, System.Globalization as Culture;

procedure Width(Value: L.Extent; At: string);
begin
  R.CheckFlex(new L.Flex(Basis := Value), V.Target.Graphical, At + '/width');
end procedure;

// Validates native inline-edit capacity, literal text and presentation.
// ## Parameters
// - `Value`: Confirmed single-line text.
// - `Settings`: Native presentation and byte capacity.
// - `At`: Diagnostic path.
public procedure Inline(Value: string; Settings: I.Options; At: string);
begin
  R.CheckText(Value, At + '/value');
  R.CheckText(Settings.Placeholder, At + '/placeholder');
  if Settings.MaxUtf8Bytes < 1 or Settings.MaxUtf8Bytes > 511
    or Text.Encoding.UTF8.GetByteCount(
    Value
  ) > Settings.MaxUtf8Bytes or Value.Contains(#10) or Value.Contains(#13)
  then
    R.Reject(At, 'Inline text must fit its one-to-511-byte single-line capacity.');
  end if;

  if not Sys.Enum.IsDefined<I.Font>(
    Settings.Face
  ) or not Sys.Single.IsFinite(Settings.FontSize) or Settings.FontSize < 0.0F
  then
    R.Reject(At, 'Invalid inline editor face or font size.');
  end if;

  Width(Settings.Width, At);
end procedure;

// Validates native scrub bounds, precision and display options.
// ## Parameters
// - `Label`: Literal caption.
// - `Value`: Model value.
// - `Minimum`: Inclusive lower bound.
// - `Maximum`: Inclusive upper bound.
// - `Settings`: Step, precision and native width.
// - `At`: Diagnostic path.
public procedure Scrub(Label: string; Value: float; Minimum: float; Maximum: float; Settings: S.Options; At: string);
begin
  R.CheckText(Label, At + '/label');
  R.CheckText(Settings.Suffix, At + '/suffix');
  R.CheckText(Settings.Icon, At + '/icon');
  if not Sys.Single.IsFinite(
    Value
  ) or not Sys.Single.IsFinite(Minimum) or not Sys.Single.IsFinite(Maximum)
    or Minimum >= Maximum or Value < Minimum or Value > Maximum or not Sys.Single.IsFinite(
    Maximum - Minimum
  )
    or not Sys.Single.IsFinite(Settings.Step) or Settings.Step < 0.0F
    or (Settings.Step > 0.0F and not Sys.Single.IsFinite((Maximum - Minimum) / Settings.Step))
    or Settings.DecimalPlaces < 0 or Settings.DecimalPlaces > 6
  then
    R.Reject(At, 'Invalid finite scrub value, bounds, step or precision.');
  end if;

  Width(Settings.Width, At);
end procedure;

// Validates a finite amount against CUI's fixed grouped-text capacity.
// ## Parameters
// - `Value`: Model amount.
// - `Settings`: Captions, precision and native width.
// - `At`: Diagnostic path.
public procedure Money(Value: double; Settings: M.Options; At: string);
begin
  for Caption: string in [Settings.Label, Settings.Symbol, Settings.Code, Settings.Hint] do
    R.CheckText(Caption, At);
  end for;

  if not Sys.Double.IsFinite(
    Value
  ) or Settings.DecimalPlaces < 0 or Settings.DecimalPlaces > 15
  then
    R.Reject(At, 'Invalid finite money amount or precision.');
  end if;
  const Digits: string := Value.ToString(
    'F' + Settings.DecimalPlaces.ToString(),
    Culture.CultureInfo.InvariantCulture
  );
  const Dot: int := Digits.IndexOf('.');
  const Integers: int := (if Dot < 0 then
    Digits.Length
  else
    Dot
  end if) - (if Value < 0.0 then
    1
  else
    0
  end if);
  if Digits.Length + (Integers - 1) div 3 > 63 then
    R.Reject(At, 'The grouped amount exceeds CUI display capacity.');
  end if;

  Width(Settings.Width, At);
end procedure;

// Validates native key ordinals and modifier flags.
// ## Parameters
// - `Value`: Recorded combination.
// - `At`: Diagnostic path.
public procedure Combination(Value: K.Combination; At: string);
begin
  if not Sys.Enum.IsDefined<K.Key>(Value.Key) or cast<int>(Value.Modifiers) > 15
    or (Value.Key = K.Key.None and Value.Modifiers <> K.Modifier.None)
  then
    R.Reject(At, 'Invalid shortcut key or modifier flags.');
  end if;
end procedure;

// Validates native recorder text, key values and width.
// ## Parameters
// - `Value`: Model combination.
// - `Settings`: Placeholder and width.
// - `At`: Diagnostic path.
public procedure Shortcut(Value: K.Combination; Settings: K.Options; At: string);
begin
  Combination(Value, At);
  R.CheckText(Settings.Placeholder, At + '/placeholder');
  Width(Settings.Width, At);
end procedure;

end unit;
