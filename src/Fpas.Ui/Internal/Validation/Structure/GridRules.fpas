// [Documentation](../../../../../docs/ui/widgets.md#native-grids-and-surfaces)

unit Fpas.Ui.Internal.Validation.Structure.GridRules;

uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Internal.Validation.Core.LayoutRules as LR;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Collections.DataGrids as G;
uses Fpas.Ui.Widgets.Collections.FilterBars as Filters;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Collections.TreeTables as T;

uses System as Sys;
uses System.Globalization as Culture;

// Checks UTF-8 text and its native buffer capacity.
// ## Parameters
// - `Text`: Current model text.
// - `Capacity`: Buffer size including the terminator.
// - `Maximum`: Native maximum buffer size.
// - `At`: Diagnostic path.
public procedure TextBuffer(Text: string; Capacity: int; Maximum: int; At: string);
begin
  R.CheckText(Text, At);
  if Capacity < 2 or Capacity > Maximum or Sys.Text.Encoding.UTF8.GetByteCount(
    Text
  ) >= Capacity
  then
    R.Reject(At, 'Text must fit its native UTF-8 buffer.');
  end if;
end procedure;

// Checks a filter bar and reserves its derived terminal control identities.
// ## Parameters
// - `Id`: Stable control identity.
// - `Fields`: Available fields in mask order.
// - `Current`: Model masks and optional search.
// - `Capacity`: Search buffer size including the terminator.
// - `Profile`: Requested capability profile.
// - `Location`: Parent view path.
// - `Identify`: Registers a stable ID at a diagnostic path.
public procedure FilterBar(
  Id: string; Fields: array of Filters.Field; Current: Filters.Value; Capacity: int;
  Profile: R.Profile; Location: string; Identify: function(string, string): string
);
begin
  const At: string := Identify(Id, Location + '/filterBar');
  if Fields.Length > 32 or Fields.Length <> Current.Selected.Length then
    R.Reject(At, 'Supply at most 32 fields and one mask per field.');
  end if;

  const Terminal: bool := Profile <> R.Profile.Graphical;
  const Search: string? := Current.Search;
  if Search <> null then
    TextBuffer(Search, Capacity, 65536, At + '/search');
    if Terminal then
      if Search.Contains(#10) or Search.Contains(#13) then
        R.Reject(At, 'A filter search requires a single-line value.');
      end if;

      discard Identify(Id + '/search', At + '/search');
    end if;
  end if;
  const Add: string := Id + '/add';
  const HasFields: bool := Sys.Array.Exists of Filters.Field(
    Fields, function(Field: Filters.Field): bool => Field.Values.Length > 0
  );
  if Terminal and HasFields then
    discard Identify(Add, At + '/add');
  end if;

  if Terminal and (HasFields or Search <> null) then
    discard Identify(Id + '/clear', At + '/clear');
  end if;

  for Index: int := 0 to Fields.Length - 1 do
    const Field: Filters.Field := Fields[Index];
    R.CheckText(Field.Name, At + '/name');
    R.CheckText(Field.Icon, At + '/icon');
    if Field.Values.Length > 32 or (Field.Values.Length < 32
      and cast<ulong>(Current.Selected[Index]) >= (1UL shl Field.Values.Length))
    then
      R.Reject(At, 'A filter mask must name available values.');
    end if;
    const Path: string := Add + '/field/' + Index.ToString(Culture.CultureInfo.InvariantCulture);
    if Terminal and Field.Values.Length > 0 then
      discard Identify(Path, At + '/name');
    end if;

    for Option: int := 0 to Field.Values.Length - 1 do
      R.CheckText(Field.Values[Option], At + '/value');
      if Terminal then
        discard Identify(
          Path + '/value/' + Option.ToString(Culture.CultureInfo.InvariantCulture),
          At + '/value'
        );
      end if;
    end for;
  end for;
end procedure;

// Validates columns, sort and viewport constraints before drawing.
// ## Parameters
// - `Columns`: Ordered column definitions.
// - `Count`: Total logical row count.
// - `Order`: Model-owned sort.
// - `Height`: Viewport extent.
// - `RowHeight`: Row height in logical points.
// - `At`: Diagnostic path.
public procedure Grid(Columns: array of G.Column; Count: int; Order: Tables.Sort?; Height: L.Extent; RowHeight: float; At: string);
begin
  LR.CheckExtent(Height, R.Profile.Graphical, At + '/height');
  if Columns.Length < 1 or Columns.Length > 32 then
    R.Reject(At, 'A native data grid needs one to 32 columns.');
  end if;

  if Count < 0 or not Sys.Single.IsFinite(RowHeight) or RowHeight < 1.0F
    or (cast<double>(Count) + 1.0) * cast<double>(RowHeight) >= int.MaxValue
  then
    R.Reject(At, 'The logical row count and height must fit the native viewport.');
  end if;

  if Order <> null and (Order.Column < -1 or Order.Column >= Columns.Length
    or (Order.Column >= 0 and not Columns[Order.Column].Sortable))
  then
    R.Reject(At, 'Sort must name a sortable column or be minus one.');
  end if;

  for Column: G.Column in Columns do
    R.CheckText(Column.Title, At + '/header');
    if not Sys.Single.IsFinite(Column.Width) or Column.Width < 0.0F
      or not Sys.Enum.IsDefined of Tables.Alignment(
      Column.Align
    ) or Column.Priority < 0 or Column.Priority > 255
    then
      R.Reject(At, 'Invalid native column width, alignment or priority.');
    end if;
  end for;
end procedure;

// Checks tree relationships and the row widths.
// ## Parameters
// - `Nodes`: Model tree in parent-first order.
// - `Columns`: Expected number of columns.
// - `Cursor`: Model cursor index or minus one.
// - `At`: Diagnostic path.
public procedure Tree(Nodes: array of T.Node; Columns: int; Cursor: int; At: string);
begin
  if Cursor < -1 or Cursor >= Nodes.Length then
    R.Reject(At, 'The tree cursor must name a node or be minus one.');
  end if;

  for Index: int := 0 to Nodes.Length - 1 do
    const Node: T.Node := Nodes[Index];
    if Node.Parent < -1 or Node.Parent >= Index or Node.Cells.Length <> Columns - 1 then
      R.Reject(At, 'Parents must precede children and each node must fill the columns.');
    end if;

    R.CheckText(Node.Label, At + '/name');
    R.CheckText(Node.Icon, At + '/icon');
    for Value: string in Node.Cells do
      R.CheckText(Value, At + '/cell');
    end for;
  end for;
end procedure;

end unit;
