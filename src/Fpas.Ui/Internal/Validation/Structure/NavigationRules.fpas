// [Documentation](../../../../../docs/ui/widgets.md#tabs-breadcrumb-and-pagination)

unit Fpas.Ui.Internal.Validation.Structure.NavigationRules;

uses Fpas.Ui.Internal.Navigation.PaginationPages as Pages;
uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Widgets.Navigation.Breadcrumbs as Breadcrumbs;
uses Fpas.Ui.Widgets.Navigation.Tabs as Tabs;

uses System as Sys;

procedure Caption(Value: string; Location: string);
begin
  R.CheckText(Value, Location);
  if Sys.String.IsNullOrWhiteSpace(Value) then
    R.Reject(Location, 'A navigation item needs a caption.');
  end if;
end procedure;

// Validates pagination and reserves the identities of its terminal controls.
// ## Parameters
// - `Id`: Stable pager identity.
// - `Page`: Current zero-based page index.
// - `Count`: Positive number of pages.
// - `Profile`: Receiving host profile.
// - `Location`: Parent view path.
// - `Identify`: Validates and registers a unique view identity.
public procedure CheckPagination(
  Id: string;
  Page: int;
  Count: int;
  Profile: R.Profile;
  Location: string;
  Identify: function(string, string): string
);
begin
  const At: string := Identify(Id, Location + '/pagination');
  if Count < 1 or Page < 0 or Page >= Count then
    R.Reject(At, 'Pagination needs a positive page count and a valid page index.');
  end if;

  if Profile <> R.Profile.Graphical then
    discard Identify(Id + '/previous', At + '/previous');
    discard Identify(Id + '/next', At + '/next');
    for Index: int in Pages.Numbered(Page, Count) do
      discard Identify(Pages.PageId(Id, Index), At + '/page');
    end for;
  end if;
end procedure;

// Validates a tab strip and registers its focus identities.
//
// ## Parameters
// - `Id`: Stable strip identity.
// - `Items`: Positional tab captions and glyphs.
// - `Selected`: Current zero-based index.
// - `Settings`: Native variant and width options.
// - `Location`: Control path for diagnostics.
// - `Identify`: Validates and registers a unique view identity.
public procedure CheckTabs(
  Id: string;
  Items: array of Tabs.Item;
  Selected: int;
  Settings: Tabs.Options;
  Location: string;
  Identify: function(string, string): string
);
begin
  const At: string := Identify(Id, Location + '/tabs');
  if Items.Length < 1 or Items.Length > 32 or Selected < 0 or Selected >= Items.Length
    or not Sys.Enum.IsDefined of Tabs.Variant(Settings.Appearance)
  then
    R.Reject(At, 'Tabs need one through 32 choices, a selected index and a valid appearance.');
  end if;

  for Index: int := 0 to Items.Length - 1 do
    const Part: string := Identify(Tabs.ItemId(Id, Index), At + '/tab');
    Caption(Items[Index].Label, Part + '/label');
    R.CheckText(Items[Index].Icon, Part + '/icon');
  end for;
end procedure;

// Validates a breadcrumb trail and registers its positional identities.
//
// ## Parameters
// - `Id`: Stable trail identity.
// - `Items`: Literal path captions.
// - `Profile`: Receiving host profile.
// - `Location`: Control path for diagnostics.
// - `Identify`: Validates and registers a unique view identity.
public procedure CheckBreadcrumb(
  Id: string;
  Items: array of string;
  Profile: R.Profile;
  Location: string;
  Identify: function(string, string): string
);
begin
  const At: string := Identify(Id, Location + '/breadcrumb');
  if Items.Length = 0 then
    R.Reject(At, 'A breadcrumb needs at least one path item.');
  end if;

  for Index: int := 0 to Items.Length - 1 do
    const Part: string := Identify(Breadcrumbs.ItemId(Id, Index), At + '/item');
    Caption(Items[Index], Part + '/label');
  end for;

  if Profile <> R.Profile.Graphical and Items.Length > 1 then
    discard Identify(Id + '/overflow', At + '/overflow');
  end if;
end procedure;

// Validates a graphical stepper's captions and progress.
//
// ## Parameters
// - `Steps`: Literal step captions in display order.
// - `Current`: Current index, or the count when all steps are complete.
// - `Profile`: Receiving host profile.
// - `Location`: Control path for diagnostics.
public procedure CheckStepper(
  Steps: array of string;
  Current: int;
  Profile: R.Profile;
  Location: string
);
begin
  R.RequireProfile(Profile, R.Profile.Graphical, Location);
  if Steps.Length = 0 or Current < 0 or Current > Steps.Length then
    R.Reject(
      Location,
      'A stepper needs at least one step and progress between zero and the step count.'
    );
  end if;

  for Index: int := 0 to Steps.Length - 1 do
    Caption(Steps[Index], Location + '/step/' + Index.ToString());
  end for;
end procedure;

end unit;
