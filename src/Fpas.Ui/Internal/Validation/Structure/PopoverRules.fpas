// [Documentation](../../../../../docs/ui/widgets.md#popover-and-confirmation-popover)

unit Fpas.Ui.Internal.Validation.Structure.PopoverRules;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Internal.Validation.Structure.TooltipRules as Buttons;
uses Fpas.Ui.Widgets.Overlays.ConfirmPopovers as C;
uses Fpas.Ui.Widgets.Overlays.Menus as M;
uses Fpas.Ui.Widgets.Overlays.Popovers as P;

uses System as Sys;

// Verifies that a popover has a native button anchor.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Target`: Trigger element.
// - `Location`: View path for diagnostics.
public procedure CheckTrigger of TMsg(Target: E.Element of TMsg; Location: string);
begin
  if not Buttons.IsButton of TMsg(Target) then
    R.Reject(Location, 'A popover needs a button trigger.');
  end if;
end procedure;

// Validates placement and logical spacing.
//
// ## Parameters
// - `Settings`: Panel options.
// - `Location`: View path for diagnostics.
public procedure CheckPanel(Settings: P.Options; Location: string);
begin
  if not Sys.Single.IsFinite(Settings.Width) or Settings.Width < 0.0F
    or not Sys.Single.IsFinite(Settings.Padding) or Settings.Padding < 0.0F
    or not Sys.Single.IsFinite(Settings.Gap) or Settings.Gap < 0.0F
    or not Sys.Enum.IsDefined of M.Placement(Settings.Position)
  then
    R.Reject(Location, 'A popover needs finite nonnegative dimensions and a valid placement.');
  end if;
end procedure;

// Validates a confirmation question and its actions.
//
// ## Parameters
// - `Settings`: Confirmation options.
// - `Location`: View path for diagnostics.
public procedure CheckQuestion(Settings: C.Options; Location: string);
begin
  R.CheckText(Settings.Title ?? '', Location + '/title');
  R.CheckText(Settings.Description ?? '', Location + '/description');
  R.CheckText(Settings.ConfirmLabel, Location + '/confirm');
  R.CheckText(Settings.CancelLabel, Location + '/cancel');
  if Sys.String.IsNullOrWhiteSpace(Settings.ConfirmLabel)
    or Sys.String.IsNullOrWhiteSpace(Settings.CancelLabel)
    or not Sys.Enum.IsDefined of M.Placement(Settings.Position)
  then
    R.Reject(
      Location,
      'A confirmation popover needs action captions and a valid placement.'
    );
  end if;
end procedure;

end unit;
