// [Documentation](../../../../../docs/ui/widgets.md#tooltip)

unit Fpas.Ui.Internal.Validation.Structure.TooltipRules;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Internal.Validation.Core.Checks as R;
uses Fpas.Ui.Widgets.Containers.Cards as Cards;

uses System as Sys;
uses System.Collections.Generic as Lists;
uses System.Text as Text;

// Checks whether a node is a button or a button with a tooltip.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Node to check.
// ## Returns
// Whether the node can occupy one button group position.
public function IsButton of TMsg(Node: E.Element of TMsg): bool;
begin
  case Node of
    when E.Element.ButtonAction(_, _, _, _), E.Element.IconAction(
      _,
      _,
      _,
      _,
      _
    ), E.Element.CopyAction(
      _,
      _,
      _,
      _
    ), E.Element.HoldAction(
      _,
      _,
      _,
      _
    ), E.Element.ConfirmAction(_, _, _, _), E.Element.StatusAction(
      _,
      _,
      _,
      _,
      _
    ):
      return true;
    when E.Element.Hinted(const Child: E.Element of TMsg, _, _):
      return IsButton of TMsg(Child);
    else
      return false;
  end case;
end function;

// Checks for a single native interactive anchor.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Prepared node to inspect.
// - `Subviews`: Resolved deferred views.
// ## Returns
// Whether the node supplies one interactive anchor.
public function HasAnchor of TMsg(
  Node: E.Element of TMsg;
  Subviews: Lists.IReadOnlyDictionary of (string, E.CacheEntry of TMsg)
): bool;
begin
  case Node of
    when E.Element.Card(_, _, const Settings: Cards.Options, const Activate: (Sys.Func of TMsg)?):
      return Settings.Hoverable or Activate <> null;
    when E.Element.LinkAction(_, _, _, _), E.Element.Canvas(_, _, _, _, _, _, _, _):
      return true;
    when E.Element.CheckboxAction(
      _,
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.SwitchAction(
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.RadioAction(
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.ChipAction(_, _, _, _, _, _), E.Element.SliderAction(
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.RangeSliderAction(
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.Dropzone(_, _, _, _), E.Element.AvatarUpload(
      _, _, _, _, _, _, _
    ), E.Element.Knob(_, _, _, _, _, _, _), E.Element.Fader(
      _, _, _, _, _, _, _
    ), E.Element.RulerSlider(_, _, _, _, _, _, _), E.Element.HistogramSlider(
      _,
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ):
      return true;
    when E.Element.Sized(
      const Child: E.Element of TMsg,
      _
    ), E.Element.Styled(
      const Child: E.Element of TMsg,
      _
    ), E.Element.DisabledScope(const Child: E.Element of TMsg, _):
      return HasAnchor of TMsg(Child, Subviews);
    when E.Element.Deferred(const Id: string, _):
      return HasAnchor of TMsg(Subviews[Id].Tree, Subviews);
    when E.Element.Hinted(_, _, _):
      return false;
    else
      return IsButton of TMsg(Node);
  end case;
end function;

// Checks that a caption and shortcut fit the CUI tooltip buffer.
// ## Parameters
// - `Caption`: Literal tooltip caption.
// - `Shortcut`: Optional shortcut hint.
// - `Location`: View path for diagnostics.
// - `AllowEmpty`: Whether the widget can omit its tooltip.
public procedure CheckCaption(
  Caption: string;
  Shortcut: string;
  Location: string;
  AllowEmpty: bool := false
);
begin
  R.CheckText(Caption, Location + '/text');
  R.CheckText(Shortcut, Location + '/shortcut');
  if AllowEmpty and Caption = '' then
    return;
  end if;

  if Sys.String.IsNullOrWhiteSpace(Caption) or Caption.Contains('  ·  ') then
    R.Reject(Location, 'A tooltip needs a caption without the CUI shortcut delimiter.');
  end if;

  const Length: int := Text.Encoding.UTF8.GetByteCount(Caption) +
    (if Shortcut = '' then
      0
    else
      6 + Text.Encoding.UTF8.GetByteCount(Shortcut)
    end if);
  if Length > 255 then
    R.Reject(Location, 'Tooltip text and its shortcut must fit in 255 UTF-8 bytes.');
  end if;
end procedure;

// Validates the native caption and the resolved single-control anchor.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Target`: Validated target subtree.
// - `Caption`: Literal tooltip caption.
// - `Shortcut`: Optional shortcut hint.
// - `Subviews`: Deferred subtrees resolved during view preparation.
// - `Location`: View path for diagnostics.
public procedure Check of TMsg(
  Target: E.Element of TMsg;
  Caption: string;
  Shortcut: string;
  Subviews: Lists.IReadOnlyDictionary of (string, E.CacheEntry of TMsg);
  Location: string
);
begin
  CheckCaption(Caption, Shortcut, Location);
  if not HasAnchor of TMsg(Target, Subviews) then
    R.Reject(Location, 'A tooltip needs one interactive target control.');
  end if;
end procedure;

end unit;
