unit Fpas.Ui.Internal.Validation.TooltipRules;

uses
  Fpas.Ui.Elements as E, Fpas.Ui.Internal.Validation.Rules as R, System as Sys,
  System.Collections.Generic as Lists, System.Text as Text;

// Checks whether a node is a button or a button with a tooltip.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Node to check.
// ## Returns
// Whether the node can occupy one button group position.
public function IsButton<TMsg>(Node: E.Element<TMsg>): bool;
begin
  case Node of
    when E.Element.ButtonAction(_, _, _, _), E.Element.IconAction(
      _,
      _,
      _,
      _,
      _
    ), E.Element.CopyAction(
      _,
      _,
      _,
      _
    ), E.Element.HoldAction(
      _,
      _,
      _,
      _
    ), E.Element.ConfirmAction(_, _, _, _), E.Element.StatusAction(
      _,
      _,
      _,
      _,
      _
    ):
      return true;
    when E.Element.Hinted(const Child: E.Element<TMsg>, _, _):
      return IsButton<TMsg>(Child);
    else
      return false;
  end case;
end function;

// Checks for a single native interactive anchor.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Prepared node to inspect.
// - `Subviews`: Resolved deferred views.
// ## Returns
// Whether the node supplies one interactive anchor.
public function HasAnchor<TMsg>(Node: E.Element<TMsg>; Subviews: Lists.IReadOnlyDictionary<string, E.CacheEntry<TMsg>>): bool;
begin
  case Node of
    when E.Element.LinkAction(_, _, _, _), E.Element.Canvas(_, _, _, _):
      return true;
    when E.Element.CheckboxAction(
      _,
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.SwitchAction(
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.RadioAction(
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.ChipAction(_, _, _, _, _, _), E.Element.SliderAction(
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.RangeSliderAction(
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ), E.Element.Dropzone(_, _, _, _), E.Element.AvatarUpload(
      _, _, _, _, _, _, _
    ), E.Element.Knob(_, _, _, _, _, _, _), E.Element.Fader(
      _, _, _, _, _, _, _
    ), E.Element.RulerSlider(_, _, _, _, _, _, _), E.Element.HistogramSlider(
      _,
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ):
      return true;
    when E.Element.Sized(
      const Child: E.Element<TMsg>,
      _
    ), E.Element.Styled(const Child: E.Element<TMsg>, _):
      return HasAnchor<TMsg>(Child, Subviews);
    when E.Element.Deferred(const Id: string, _):
      return HasAnchor<TMsg>(Subviews[Id].Tree, Subviews);
    when E.Element.Hinted(_, _, _):
      return false;
    else
      return IsButton<TMsg>(Node);
  end case;
end function;

// Validates the native caption and the resolved single-control anchor.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Target`: Validated target subtree.
// - `Caption`: Literal tooltip caption.
// - `Shortcut`: Optional shortcut hint.
// - `Subviews`: Deferred subtrees resolved during view preparation.
// - `Location`: View path for diagnostics.
public procedure Check<TMsg>(
  Target: E.Element<TMsg>; Caption: string; Shortcut: string;
  Subviews: Lists.IReadOnlyDictionary<string, E.CacheEntry<TMsg>>; Location: string
);
begin
  R.CheckText(Caption, Location + '/text');
  R.CheckText(Shortcut, Location + '/shortcut');
  if Sys.String.IsNullOrWhiteSpace(Caption) or Caption.Contains('  ·  ') then
    R.Reject(Location, 'A tooltip needs a caption without the CUI shortcut delimiter.');
  end if;

  const Length: int := Text.Encoding.UTF8.GetByteCount(Caption) +
    (if Shortcut = '' then
      0
    else
      6 + Text.Encoding.UTF8.GetByteCount(Shortcut)
    end if);
  if Length > 255 then
    R.Reject(Location, 'Tooltip text and its shortcut must fit in 255 UTF-8 bytes.');
  end if;

  if not HasAnchor<TMsg>(Target, Subviews) then
    R.Reject(Location, 'A tooltip needs one interactive target control.');
  end if;
end procedure;

end unit;
