unit Fpas.Ui.Internal.VoiceAndAiValidation;

uses
  Fpas.Ui.Validation as V, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L,
  Fpas.Ui.Internal.Rules as Rules, Fpas.Ui.Internal.ChartRules as ChartRules,
  Fpas.Ui.Internal.VoiceRules as VoiceRules, Fpas.Ui.Internal.AiRules as AiRules,
  Fpas.Ui.Menus as Menus, System as Sys,
  Fpas.Ui.VoiceWaves as VoiceWaves, Fpas.Ui.VoiceNotes as VoiceNotes, Fpas.Ui.VoiceSessions as VoiceSessions, Fpas.Ui.Composers as Composers, Fpas.Ui.VoiceOrbs as VoiceOrbs, Fpas.Ui.Reasonings as Reasonings, Fpas.Ui.ToolCalls as ToolCalls, Fpas.Ui.AgentPlans as AgentPlans, Fpas.Ui.AgentStatuses as AgentStatuses, Fpas.Ui.SourceLists as SourceLists, Fpas.Ui.Citations as Citations, Fpas.Ui.ContextMeters as ContextMeters, Fpas.Ui.ResponseActions as ResponseActions, Fpas.Ui.PromptSuggestions as PromptSuggestions, Fpas.Ui.ModelPickers as ModelPickers, Fpas.Ui.Voice as Voice, Fpas.Ui.Sources as Sources;

// Checks a prepared Voice or AI widget and queues any composed children.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Node`: Voice or AI widget.
// - `Location`: Current tree location.
// - `Profile`: Target capability profile.
// - `Identify`: Registers widget and part identities.
// - `Visit`: Queues a composed child for validation.
public procedure Check<TMsg>(Node: E.Element<TMsg>; Location: string; Profile: V.Target; Identify: function(string, string): string; Visit: procedure(E.Element<TMsg>, string));
begin
  case Node of
    when E.Element.VoiceWave(
      const Id: string,
      const Signal: Voice.Signal,
      const Progress: float?,
      const Changed: Sys.Func<float, TMsg>?,
      const Settings: VoiceWaves.Options
    ):
      const At: string := Identify(Id, Location + '/VoiceWave');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      VoiceRules.Signal(Signal, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      VoiceRules.Fraction(Progress, At);
      ChartRules.Distance(Settings.Pitch, At);
      ChartRules.Distance(Settings.Step, At);
      ChartRules.Color(Settings.Color, At);
      VoiceRules.Owner(Settings.Owner, At);
      if (Progress = null) <> (Changed = null) then
        Rules.Reject(At, 'Seekable waveforms need progress and a change handler.');
      end if;
    when E.Element.VoiceNote(
      const Id: string,
      const Samples: array of float,
      const Playback: VoiceNotes.Value,
      _,
      const Settings: VoiceNotes.Options
    ):
      const At: string := Identify(Id, Location + '/VoiceNote');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      VoiceRules.Levels(Samples, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      ChartRules.Distance(Playback.Duration, At);
      ChartRules.Distance(Playback.Position, At);
      if Playback.Position > Playback.Duration or (Playback.Speed <> 1.0F and Playback.Speed <>
        1.5F and Playback.Speed <> 2.0F)
      then
        Rules.Reject(At, 'Invalid playback position or speed.');
      end if;

      for Part: string in ['play', 'seek', 'speed'] do
        discard Identify(Id + '/' + Part, At);
      end for;
    when E.Element.VoiceSession(
      const Id: string,
      const Mode: Voice.Activity,
      const Signal: Voice.Signal,
      _,
      _,
      const Settings: VoiceSessions.Options
    ):
      const At: string := Identify(Id, Location + '/VoiceSession');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      VoiceRules.Signal(Signal, At);
      VoiceRules.Activity(Mode, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      VoiceRules.Owner(Settings.Speaker, At);
      for Caption: string in [
        Settings.Label,
        Settings.Transcript ?? '',
        Settings.Upcoming ?? '',
        Settings.You,
        Settings.Assistant
      ] do
        Rules.CheckText(Caption, At);
      end for;

      for Part: string in ['mute', 'end'] do
        discard Identify(Id + '/' + Part, At);
      end for;
    when E.Element.Composer(
      const Id: string,
      const Content: Composers.Value,
      _,
      const Settings: Composers.Options
    ):
      const At: string := Identify(Id, Location + '/Composer');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckExtent(Settings.Width, Profile, At);
      VoiceRules.Composer(Content, Settings, At);
      for Part: string in ['editor', 'send', 'record', 'cancel'] do
        discard Identify(Id + '/' + Part, At);
      end for;
    when E.Element.VoiceOrb(
      const Id: string,
      const Mode: Voice.Activity,
      const Level: float,
      _,
      const Settings: VoiceOrbs.Options
    ):
      const At: string := Identify(Id, Location + '/VoiceOrb');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      VoiceRules.Activity(Mode, At);
      VoiceRules.Fraction(Level, At);
      ChartRules.Distance(Settings.Size, At);
      ChartRules.Color(Settings.Color, At);
    when E.Element.Reasoning(
      const Id: string,
      const Bodies: array of E.Element<TMsg>,
      const Settings: Reasonings.Options
    ):
      const At: string := Identify(Id, Location + '/Reasoning');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckText(Settings.Title, At);
      ChartRules.Distance(Settings.Seconds, At);
      for Child: E.Element<TMsg> in Bodies do
        Visit(Child, At);
      end for;

      for Part: string in ['toggle'] do
        discard Identify(Id + '/' + Part, At);
      end for;
    when E.Element.ToolCall(
      const Id: string,
      const Name: string,
      const Settings: ToolCalls.Options
    ):
      const At: string := Identify(Id, Location + '/ToolCall');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      AiRules.Task(
        Settings.Status,
        Settings.Seconds,
        [Name, Settings.Detail, Settings.Icon, Settings.Input, Settings.Output],
        At
      );
      for Part: string in ['toggle'] do
        discard Identify(Id + '/' + Part, At);
      end for;
    when E.Element.AgentPlan(
      const Id: string,
      const Steps: array of AgentPlans.Step,
      _,
      const Settings: AgentPlans.Options
    ):
      const At: string := Identify(Id, Location + '/AgentPlan');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckText(Settings.Title, At);
      for Step: AgentPlans.Step in Steps do
        AiRules.Task(Step.Status, 0.0F, [Step.Title, Step.Detail], At);
      end for;

      for Part: int := 0 to Steps.Length - 1 do
        discard Identify(
          Id + '/' + Part.ToString(Sys.Globalization.CultureInfo.InvariantCulture),
          At
        );
      end for;
    when E.Element.AgentStatus(
      const Id: string,
      const Label: string,
      const Settings: AgentStatuses.Options
    ):
      const At: string := Identify(Id, Location + '/AgentStatus');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      AiRules.Task(Settings.Status, Settings.Seconds, [Label, Settings.Icon], At);
    when E.Element.SourceList(
      const Id: string,
      const Documents: array of Sources.Item,
      _,
      const Settings: SourceLists.Options
    ):
      const At: string := Identify(Id, Location + '/SourceList');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      for Document: Sources.Item in Documents do
        AiRules.Source(Document, At);
      end for;

      for Part: int := 0 to Documents.Length - 1 do
        discard Identify(
          Id + '/' + Part.ToString(Sys.Globalization.CultureInfo.InvariantCulture),
          At
        );
      end for;
    when E.Element.Citation(
      const Id: string,
      const Number: int,
      const Source: Sources.Item?,
      _,
      const Settings: Citations.Options
    ):
      const At: string := Identify(Id, Location + '/Citation');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      if Number < 1 then
        Rules.Reject(At, 'Citation numbers must be positive.');
      end if;

      if Source <> null then
        AiRules.Source(Source, At);
      end if;
    when E.Element.ContextMeter(
      const Id: string,
      const Used: float,
      const Limit: float,
      const Breakdown: array of ContextMeters.Part,
      const Settings: ContextMeters.Options
    ):
      const At: string := Identify(Id, Location + '/ContextMeter');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      ChartRules.Distance(Used, At);
      ChartRules.Distance(Limit, At);
      if Limit <= 0.0F or not Sys.Single.IsFinite(Used / Limit) then
        Rules.Reject(At, 'A context meter needs a finite ratio and positive capacity.');
      end if;

      Rules.CheckText(Settings.Unit, At);
      for Part: ContextMeters.Part in Breakdown do
        Rules.CheckText(Part.Label, At);
        ChartRules.Distance(Part.Amount, At);
        ChartRules.Color(Part.Color, At);
      end for;
    when E.Element.ResponseActions(
      const Id: string,
      const Vote: int?,
      _,
      const Settings: ResponseActions.Options
    ):
      const At: string := Identify(Id, Location + '/ResponseActions');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      Rules.CheckText(Settings.CopyText ?? '', At);
      if Vote <> null and (Vote < -1 or Vote > 1) then
        Rules.Reject(At, 'A vote must be -1, 0 or 1.');
      end if;

      for Part: string in ['copy', 'regenerate', 'up', 'down', 'share'] do
        discard Identify(Id + '/' + Part, At);
      end for;
    when E.Element.PromptSuggestions(
      const Id: string,
      const Items: array of PromptSuggestions.Item,
      _,
      const Settings: PromptSuggestions.Options
    ):
      const At: string := Identify(Id, Location + '/PromptSuggestions');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      if Settings.Columns < 0 then
        Rules.Reject(At, 'The suggestion column count must be nonnegative.');
      end if;

      for Item: PromptSuggestions.Item in Items do
        Rules.CheckText(Item.Title, At);
        Rules.CheckText(Item.Detail, At);
        Rules.CheckText(Item.Icon, At);
      end for;

      for Part: int := 0 to Items.Length - 1 do
        discard Identify(
          Id + '/' + Part.ToString(Sys.Globalization.CultureInfo.InvariantCulture),
          At
        );
      end for;
    when E.Element.ModelPicker(
      const Id: string,
      const Items: array of ModelPickers.Item,
      const Selected: int,
      _,
      const Settings: ModelPickers.Options
    ):
      const At: string := Identify(Id, Location + '/ModelPicker');
      Rules.RequireProfile(Profile, V.Target.Graphical, At);
      AiRules.Models(Items, Selected, At);
      if not Sys.Enum.IsDefined<Menus.Placement>(Settings.Placement) then
        Rules.Reject(At, 'Unknown model menu placement.');
      end if;
    else
  end case;
end procedure;

end unit;
