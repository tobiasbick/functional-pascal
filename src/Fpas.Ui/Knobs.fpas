unit Fpas.Ui.Knobs;

uses Fpas.Ui.Elements as E, Fpas.Ui.Graphics as G;

// Presentation and input settings for a native rotary control.
public type Options = record
  // Increment for value snapping. Zero allows continuous movement.
  public Step: float := 0.0F;
  // Value used by double-click, Delete or Backspace, clamped to the bounds.
  public Reset: float := 0.0F;
  // Value precision from zero through six decimal places.
  public DecimalPlaces: int := 0;
  // Whether positive values display a leading plus sign.
  public ShowSign: bool := false;
  // Literal unit caption following the value.
  public UnitLabel: string := '';
  // Whether to hide the numeric value.
  public HideValue: bool := false;
  // Whether the control accepts input.
  public Enabled: bool := true;
  // Diameter in logical points.
  public Size: float := 48.0F;
  // Optional straight-alpha color for the arc.
  public ArcColor: G.Color? := null;
  // Whether the arc starts in the middle of the sweep.
  public Bipolar: bool := false;
  // Whether equal turns multiply the value. Requires a positive minimum.
  public LogScale: bool := false;
end record;

// Builds CUI's rotary control.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Label`: Literal caption.
// - `Value`: Model-owned value within the bounds.
// - `Minimum`: Finite inclusive lower bound.
// - `Maximum`: Finite inclusive upper bound greater than Minimum.
// - `OnChange`: Maps a proposed value to a message.
// - `Settings`: Optional native display and input settings.
// ## Returns
// The graphical rotary control.
public function Knob<TMsg>(
  Id: string; Label: string; Value: float; Minimum: float; Maximum: float;
  OnChange: function(float): TMsg; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Knob(
    Id,
    Label,
    Value,
    Minimum,
    Maximum,
    OnChange,
    Settings ?? new Options()
  );
end function;

end unit;
