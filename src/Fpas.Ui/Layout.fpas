// [Documentation](../../docs/ui/layout/README.md)

unit Fpas.Ui.Layout;

uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

// A portable distance or an explicit host distance.
// See [Sizing and units](../../docs/ui/layout/sizing.md#measures).
public type Measure = variant
  // A whole number of terminal cells.
  Cells(Value: int);
  // A portable CUI logical distance. The terminal maps 8 units per column and 16 per row.
  Logical(Value: int);
  // A finite logical distance with fractional precision. GUI only.
  Points(Value: float);
end variant;

// A layout extent used for main-axis constraints and explicit widget widths.
public type Extent = variant
  // Measure the child's content.
  Content;
  // Use the available space, sharing it with other growing children.
  Fill;
  // Start from an explicit backend distance.
  Fixed(Value: Measure);
  // A finite percentage of the parent's inner extent, from zero through 100. GUI only.
  Percent(Value: float);
end variant;

// Explicit constraints on one graphical axis.
public type AxisSize = record
  // Native preferred extent.
  public Basis: Extent := Extent.Content;
  // Optional lower bound in logical units.
  public Minimum: Measure? := null;
  // Optional upper bound in logical units.
  public Maximum: Measure? := null;
  // Native growth weight. Fill uses one when no weight is given.
  public Grow: float := 0.0F;
end record;

// Main-axis constraints and allocation weights.
// See [Sizing and units](../../docs/ui/layout/sizing.md).
public type Flex = record
  // The basis for allocation before distributing free space.
  public Basis: Extent := Extent.Content;
  // An optional lower bound in explicit units; both bounds must use the same units.
  public Minimum: Measure? := null;
  // An optional upper bound in explicit units; both bounds must use the same units.
  public Maximum: Measure? := null;
  // CUI growth weight, allocated from zero. Fill uses one when no weight is given.
  // Fixed and percentage extents cannot grow; positive content weights become growing.
  public Grow: float := 0.0F;
  // Optional graphical width; explicit axes cannot mix with main-axis constraints.
  public Width: AxisSize? := null;
  // Optional graphical height; explicit axes cannot mix with main-axis constraints.
  public Height: AxisSize? := null;
end record;

// Cross-axis placement inside a stack.
public type Alignment = enum: byte
  // CUI defaults: columns stretch, rows center; intrinsic controls keep their size.
  Default;
  // Place against the leading edge.
  Start;
  // Center within the available extent.
  Center;
  // Place against the trailing edge.
  End;
  // Fill the available cross-axis extent.
  Stretch;
end enum;

// Distribution of free space along the main axis of a graphical row or column.
public type Justification = enum: byte
  // Pack children at the leading edge.
  Start;
  // Center the children.
  Center;
  // Pack children at the trailing edge.
  End;
  // Distribute free space between children.
  Between;
  // Distribute free space around children.
  Around;
end enum;

// CUI spacing levels adapted to the host, or an explicit distance.
// See [GUI spacing](../../docs/ui/gui/layout/spacing.md) and
// [TUI rows and columns](../../docs/ui/tui/layout/rows-and-columns.md).
public type Spacing = variant
  // Zero space.
  None;
  // The host's compact separation.
  Tight;
  // The host's ordinary separation.
  Normal;
  // The host's spacious separation.
  Loose;
  // An explicit gap or padding.
  Fixed(Value: Measure);
end variant;

// Inherited reading direction for native graphical layout and text.
public type Direction = enum: byte
  // Inherit the containing layout; the root defaults to left to right.
  Inherit;
  // Lay out from left to right.
  LeftToRight;
  // Mirror horizontal flow, start/end alignment and padding.
  RightToLeft;
  // Resolve direction from the first strong descendant text, or inherit when all text is neutral.
  Auto;
end enum;

// A named native Tab-navigation scope for a pane. Inactive scopes remain clickable.
// See [Focus scopes](../../docs/ui/gui/layout/focus-scopes.md).
public type FocusScope = record
  // Stable nonempty pane identity.
  public Id: string;
  // Whether this pane participates in Tab navigation.
  public Active: bool;
end record;

// Optional physical corner overrides in logical points.
public type CornerRadii = record
  // Top left radius.
  public TopLeft: float? := null;
  // Top right radius.
  public TopRight: float? := null;
  // Bottom right radius.
  public BottomRight: float? := null;
  // Bottom left radius.
  public BottomLeft: float? := null;
end record;

// Stroke drawn on the container itself.
public type Border = record
  // Width in logical points.
  public Width: float := 1.0F;
  // Optional straight-alpha stroke color.
  public Color: G.Color? := null;
  // Optional theme stroke color. Omit both colors to use the theme border.
  public ThemeColor: Themes.ColorToken? := null;
end record;

// Native theme shadow for a graphical container.
public type Elevation = enum: byte
  // No shadow.
  None;
  // Resting shadow.
  Resting;
  // Raised shadow.
  Raised;
  // Floating shadow.
  Floating;
end enum;

// Native scroll axes for the container itself.
public type ScrollMode = enum: byte
  // The container does not scroll.
  None;
  // Enable vertical scrolling.
  Vertical;
  // Enable vertical and horizontal scrolling.
  Both;
end enum;

// Layout settings shared by rows, columns, layered stacks and grids.
// See [Composition](../../docs/ui/layout/README.md#composition) and
// [GUI container options](../../docs/ui/gui/layout/container-options.md).
public type Flow = record
  // The separation between consecutive children.
  public Gap: Spacing := Spacing.None;
  // The inset on each edge of the stack.
  public Padding: Spacing := Spacing.None;
  // The placement of children on the cross axis.
  public Align: Alignment := Alignment.Default;
  // Whether a graphical row continues on another line when its children do not fit.
  public Wrap: bool := false;
  // Optional graphical clipping of children and paint at the stack bounds.
  public Clip: bool? := null;
  // Graphical main-axis distribution. Start is portable.
  public Justify: Justification := Justification.Start;
  // Optional graphical top inset, overriding axis and uniform padding.
  public PaddingTop: Spacing? := null;
  // Optional graphical logical end inset, overriding axis and uniform padding.
  public PaddingEnd: Spacing? := null;
  // Optional graphical bottom inset, overriding axis and uniform padding.
  public PaddingBottom: Spacing? := null;
  // Optional graphical logical start inset, overriding axis and uniform padding.
  public PaddingStart: Spacing? := null;
  // Native inherited reading direction. Explicit directions require GUI.
  public ReadingDirection: Direction := Direction.Inherit;
  // Optional graphical fill color for the container.
  public Background: G.Color? := null;
  // Graphical corner radius in logical units.
  public CornerRadius: float := 0.0F;
  // Optional GUI keyboard focus scope for the children.
  public Scope: FocusScope? := null;
  // Optional horizontal inset on both sides, overriding uniform padding.
  public PaddingX: Spacing? := null;
  // Optional vertical inset on both sides, overriding uniform padding.
  public PaddingY: Spacing? := null;
  // Optional graphical theme fill. Choose this or Background.
  public BackgroundTheme: Themes.ColorToken? := null;
  // Optional graphical stroke.
  public Border: Border? := null;
  // Optional physical corner overrides, including explicit zero.
  public Corners: CornerRadii? := null;
  // Graphical theme shadow.
  public Elevation: Elevation := Elevation.None;
  // Graphical paint opacity of the container and its descendants, from zero through one.
  public Opacity: float := 1.0F;
  // GUI scrolling managed by CUI. Use a stable Id when the column can move.
  public Scrolling: ScrollMode := ScrollMode.None;
  // Optional stable GUI identity. Anonymous scrolling uses CUI's automatic identity.
  // See [Layout inspection](../../docs/ui/gui/layout/layout-inspection.md).
  public Id: string? := null;
end record;

// An application-facing size class for responsive views.
public type SizeClass = enum: byte
  // The host has space for a compact arrangement.
  Compact;
  // The host has space for a regular arrangement.
  Regular;
  // The host has space for an expanded arrangement.
  Expanded;
end enum;

// Responsive information in portable size classes.
// See [Responsive views](../../docs/ui/layout/responsive.md).
public type Viewport = record
  // The size class for available width.
  public Width: SizeClass;
  // The size class for available height.
  public Height: SizeClass;
  // Measured width in portable logical units, when known.
  public LogicalWidth: float? := null;
  // Measured height in portable logical units, when known.
  public LogicalHeight: float? := null;
end record;

// Scroll view presentation and native CUI layout options.
// See the [GUI scroll view](../../docs/ui/gui/layout/scroll-view.md) and
// [TUI scroll view](../../docs/ui/tui/layout/scroll-view.md).
public type ScrollOptions = record
  // Whether to show the scrollbar.
  public ShowScrollbar: bool := true;
  // Fade edges with additional content beyond them.
  public FadeEdges: bool := false;
  // Allow horizontal scrolling in addition to vertical scrolling.
  public Horizontal: bool := false;
  // GUI viewport width. The default fills the available width.
  public Width: Extent? := null;
  // GUI viewport height. The default and Content both fill the available height.
  public Height: Extent? := null;
  // GUI inset on every edge of the viewport.
  public Padding: Spacing? := null;
  // GUI spacing between direct children.
  public Gap: Spacing? := null;
  // GUI fade color. When omitted, CUI uses the nearest opaque backdrop.
  public FadeColor: G.Color? := null;
end record;

// A model-owned vertical scroll request.
// See [Scroll position](../../docs/ui/layout/scroll-position.md).
public type ScrollPosition = variant
  // Keep the view at the start.
  Start;
  // Keep the view at the end as content grows.
  End;
  // Request an explicit offset to clamp to the available range.
  Offset(Value: Measure);
  // Keep a named descendant visible with the least vertical movement in the GUI.
  Reveal(ControlId: string);
end variant;

// The request and resolution reported when the user scrolls.
public type ScrollChange = record
  // The requested position to store in the model.
  public Position: ScrollPosition;
  // The resolved offset in the host's units.
  public Offset: Measure;
  // The maximum offset in the host's units.
  public Maximum: Measure;
end record;

end unit;
