unit Fpas.Ui.Layout;

// A portable logical distance or an explicit terminal cell distance.
public type Measure = variant
  // A whole number of terminal cells.
  Cells(Value: int);
  // A portable CUI logical distance. The terminal maps 8 units per column and 16 per row.
  Logical(Value: int);
end variant;

// The preferred extent of a child along its parent's main axis.
public type Extent = variant
  // Measure the child's content.
  Content;
  // Use the available space, sharing it with other growing children.
  Fill;
  // Start from an explicit backend distance.
  Fixed(Value: Measure);
end variant;

// Main-axis constraints and allocation weights.
public type Flex = record
  // The basis for allocation before distributing free space.
  public Basis: Extent := Extent.Content;
  // An optional lower bound in explicit units; both bounds must use the same units.
  public Minimum: Measure? := null;
  // An optional upper bound in explicit units; both bounds must use the same units.
  public Maximum: Measure? := null;
  // CUI growth weight, allocated from zero. Fill uses at least one.
  // Fixed extents cannot grow; content with a positive weight becomes growing.
  public Grow: int := 0;
end record;

// Cross-axis placement inside a stack.
public type Alignment = enum: byte
  // CUI defaults: columns stretch, rows center; intrinsic controls keep their size.
  Default;
  // Place against the leading edge.
  Start;
  // Center within the available extent.
  Center;
  // Place against the trailing edge.
  End;
  // Fill the available cross-axis extent.
  Stretch;
end enum;

// CUI spacing levels adapted to the host, or an explicit distance.
public type Spacing = variant
  // Zero space.
  None;
  // The host's compact separation.
  Tight;
  // The host's ordinary separation.
  Normal;
  // The host's spacious separation.
  Loose;
  // An explicit gap or padding.
  Fixed(Value: Measure);
end variant;

// Layout settings shared by rows and columns.
public type Flow = record
  // The separation between consecutive children.
  public Gap: Spacing := Spacing.None;
  // The inset on each edge of the stack.
  public Padding: Spacing := Spacing.None;
  // The placement of children on the cross axis.
  public Align: Alignment := Alignment.Default;
end record;

// An application-facing size class for responsive views.
public type SizeClass = enum: byte
  // The host has space for a compact arrangement.
  Compact;
  // The host has space for a regular arrangement.
  Regular;
  // The host has space for an expanded arrangement.
  Expanded;
end enum;

// Responsive information in portable size classes.
public type Viewport = record
  // The size class for available width.
  public Width: SizeClass;
  // The size class for available height.
  public Height: SizeClass;
  // Measured width in portable logical units, when known.
  public LogicalWidth: int? := null;
  // Measured height in portable logical units, when known.
  public LogicalHeight: int? := null;
end record;

// A model-owned vertical scroll request.
public type ScrollPosition = variant
  // Keep the view at the start.
  Start;
  // Keep the view at the end as content grows.
  End;
  // Request an explicit offset to clamp to the available range.
  Offset(Value: Measure);
end variant;

// The request and resolution reported when the user scrolls.
public type ScrollChange = record
  // The requested position to store in the model.
  public Position: ScrollPosition;
  // The resolved offset in the host's units.
  public Offset: Measure;
  // The maximum offset in the host's units.
  public Maximum: Measure;
end record;
end unit;
