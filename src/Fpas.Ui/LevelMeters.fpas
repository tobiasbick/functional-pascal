unit Fpas.Ui.LevelMeters;

uses Fpas.Ui.Elements as E, System as Sys;

// Geometry, scale and ballistics for a native audio level meter.
public type Options = record
  // Negative lower bound in dBFS.
  public MinimumDb: float := -60.0F;
  // Upper bound in dBFS. Zero selects the CUI default of +6.
  public MaximumDb: float := 6.0F;
  // Bar length in logical points.
  public Length: float := 160.0F;
  // Thickness of each channel bar in logical points.
  public Thickness: float := 6.0F;
  // Whether bars run from left to right.
  public Horizontal: bool := false;
  // Whether to label the dB scale.
  public Scale: bool := false;
  // Whether bars use LED-like segments.
  public Segmented: bool := false;
  // Peak hold in seconds. A negative value disables hold. Zero uses CUI's default.
  public Hold: float := 1.5F;
  // Fall rate in dB per second.
  public Decay: float := 20.0F;
end record;

// Builds a native meter with peak hold and a click-to-clear clip light.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable meter identity.
// - `Levels`: One to eight linear sample peaks, where 1.0 is 0 dBFS.
// - `Settings`: Optional native geometry, scale and falloff.
// - `OnClipCleared`: Optional message when the clip indicator is clicked.
// ## Returns
// The graphical level meter.
public function LevelMeter<TMsg>(
  Id: string; Levels: array of float; Settings: Options? := null;
  OnClipCleared: Sys.Func<TMsg>? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.LevelMeter(Id, Levels, Settings ?? new Options(), OnClipCleared);
end function;
end unit;
