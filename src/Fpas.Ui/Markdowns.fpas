unit Fpas.Ui.Markdowns;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Activation reported by CUI.
public type Event = variant
  // URL of the activated link.
  Link(Url: string);
  // Link under the pointer, or null when the pointer leaves it.
  Hover(Url: string?);
  // A task's UTF-8 byte offset, one-based line and proposed state.
  Task(ByteOffset: int; Line: int; Checked: bool);
end variant;

// Native Markdown configuration.
public type Options = record
  // Preferred width.
  public Width: L.Extent := L.Extent.Fill;
  // Body size, or zero for the theme.
  public Size: float := 0.0F;
  // Use compact headings and spacing.
  public Compact: bool := false;
  // Treat the supplied text as a partial document.
  public Streaming: bool := false;
end record;

// Creates a graphical Markdown.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Text`: Markdown source.
// - `Changed`: Maps link and task activations.
// - `Settings`: Native presentation options.
// ## Returns
// A graphical view element.
public function Markdown<TMsg>(Id: string; Text: string; Changed: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Markdown(Id, Text, Changed, Settings ?? new Options());
end function;

end unit;
