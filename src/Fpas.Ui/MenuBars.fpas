unit Fpas.Ui.MenuBars;

uses Fpas.Ui.Elements as E, Fpas.Ui.Menus as M;

// One title and its commands in a native desktop menu bar.
// ## Type parameters
// - `TMsg`: Application message type.
public type Menu<TMsg> = record
  // Stable key within the bar.
  public Key: string;
  // Visible menu title.
  public Label: string;
  // Commands, labels and separators.
  public Entries: array of M.Entry<TMsg>;
  // Optional ASCII letter or digit. Empty uses the title's first mnemonic.
  public Mnemonic: string := '';
  // Popup width in logical points. Zero uses the native default.
  public Width: float := 0.0F;
  // Whether the title can open.
  public Enabled: bool := true;
end record;

// Draws the native menu bar with pointer and mnemonic navigation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable element identity.
// - `Menus`: Titles in display order.
// - `HideBorder`: Omit the native bottom hairline.
// ## Returns
// A graphical element.
public function MenuBar<TMsg>(Id: string; Menus: array of Menu<TMsg>; HideBorder: bool := false): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.MenuBar(Id, Menus, HideBorder);
end function;

end unit;
