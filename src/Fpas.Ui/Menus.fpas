unit Fpas.Ui.Menus;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S;

// Native CUI popup placement relative to its trigger. Hosts fit it to the viewport.
public type Placement = enum: byte
  // Below, aligned with the leading edge.
  BottomStart;
  // Below, centered horizontally.
  Bottom;
  // Below, aligned with the trailing edge.
  BottomEnd;
  // Above, aligned with the leading edge.
  TopStart;
  // Above, centered horizontally.
  Top;
  // Above, aligned with the trailing edge.
  TopEnd;
  // To the right, aligned with the top edge.
  RightStart;
  // To the left, aligned with the top edge.
  LeftStart;
  // To the right, centered vertically.
  Right;
  // To the left, centered vertically.
  Left;
end enum;

// One keyed command. Shortcut text is a hint, not an installed key binding.
// ## Type parameters
// - `TMsg`: Application message type.
public type Item<TMsg> = record
  // Stable identity within the menu, independent of caption or position.
  public Key: string;
  // Literal command caption.
  public Label: string;
  // Message proposed when the command is chosen.
  public Message: TMsg;
  // Optional CUI icon-font glyph.
  public Icon: string := '';
  // Optional terminal glyph before the caption.
  public TerminalIcon: string := '';
  // Display-only keyboard shortcut hint.
  public Shortcut: string := '';
  // Whether the command accepts activation.
  public Enabled: bool := true;
  // Use the semantic danger color.
  public Danger: bool := false;
  // Show a model-owned check mark without changing activation semantics.
  public Checked: bool := false;
end record;

// Ordered native menu content; only commands are interactive.
// ## Type parameters
// - `TMsg`: Application message type.
public type Entry<TMsg> = variant
  // A keyed command with its message and presentation.
  Action(Value: Item<TMsg>);
  // A noninteractive section caption.
  Label(Text: string);
  // A noninteractive horizontal separator.
  Separator;
end variant;

// Native trigger and popup options shared by GUI and TUI.
public type Options = record
  // CUI trigger variant; Default resolves to secondary, or ghost for icon-only.
  public Variant: S.ButtonVariant := S.ButtonVariant.Default;
  // Optional CUI icon; icon-only menus default to the native ellipsis.
  public Icon: string := '';
  // Optional terminal equivalent; an icon-only menu otherwise keeps its label.
  public TerminalIcon: string := '';
  // Use a square GUI icon trigger with the label as its tooltip.
  public IconOnly: bool := false;
  // Preferred placement; both hosts fit or flip at viewport edges.
  public Position: Placement := Placement.BottomStart;
  // Logical popup width, or zero for native content sizing (minimum 180 units).
  public Width: float := 0.0F;
  // Whether the trigger and its popup accept input.
  public Enabled: bool := true;
end record;

// Gets a command's stable inspection identity.
// ## Parameters
// - `Id`: Dropdown or context-menu identity.
// - `Key`: Command key.
// ## Returns
// The trigger identity followed by / and the key.
public function ItemId(Id: string; Key: string): string;
requires Id <> '';
requires Key <> '';
begin
  return Id + '/' + Key;
end function;

// Creates a button that opens a host-owned CUI command menu.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable trigger identity.
// - `Label`: Literal caption and accessible name, required for icon-only triggers.
// - `Entries`: Commands, labels and separators with unique command keys.
// - `Settings`: Optional trigger and popup settings.
// ## Returns
// A menu that sends a command message and closes when that command is chosen.
public function Menu<TMsg>(Id: string; Label: string; Entries: array of Entry<TMsg>; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Dropdown(Id, Label, Entries, Settings ?? new Options());
end function;

// Attaches a GUI context menu to the target's native root component.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable menu identity, distinct from the target's own identities.
// - `Target`: Component or noninteractive composition that owns the right-click area.
// - `Entries`: The same keyed commands, labels and separators used by Menu.
// - `Enabled`: Whether this context menu accepts input; target behavior is unchanged.
// ## Returns
// The target with CUI's pointer-positioned context menu. Requires the graphical profile.
public function ContextMenu<TMsg>(Id: string; Target: E.Element<TMsg>; Entries: array of Entry<TMsg>; Enabled: bool := true): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Contextual(Id, Target, Entries, Enabled);
end function;
end unit;
