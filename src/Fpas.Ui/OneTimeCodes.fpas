unit Fpas.Ui.OneTimeCodes;

uses Fpas.Ui.Elements as E, System as Sys;

// Presentation and input options for a graphical one-time code.
public type Options = record
  // Optional caption above the code boxes.
  public Label: string := '';
  // Number of ASCII letter or digit boxes from 1 to 12.
  public Length: int := 6;
  // Whether the code boxes accept input.
  public Enabled: bool := true;
end record;

// Builds CUI's graphical one-time code input.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Value`: Model-owned partial or complete ASCII alphanumeric code.
// - `OnChange`: Maps a proposed code to a message.
// - `Settings`: Optional presentation and length.
// - `OnComplete`: Maps a newly entered complete code to a message after its change.
// ## Returns
// A graphical code input.
public function OneTimeCodeInput<TMsg>(
  Id: string; Value: string; OnChange: function(string): TMsg;
  Settings: Options? := null; OnComplete: Sys.Func<string, TMsg>? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.OneTimeCodeInput(
    Id,
    Value,
    OnChange,
    Settings ?? new Options(),
    OnComplete
  );
end function;

end unit;
