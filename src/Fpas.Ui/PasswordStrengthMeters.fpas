unit Fpas.Ui.PasswordStrengthMeters;

uses Fpas.Ui.Elements as E;

// Builds CUI's graphical password strength meter.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable meter identity.
// - `Password`: Model-owned password to score with CUI's visual heuristic.
// ## Returns
// A meter whose snapshot contains only the strength score.
public function PasswordStrengthMeter<TMsg>(Id: string; Password: string): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.PasswordStrengthMeter(Id, Password);
end function;

end unit;
