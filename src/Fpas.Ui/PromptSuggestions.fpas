unit Fpas.Ui.PromptSuggestions;

uses Fpas.Ui.Elements as E;

// A native suggestion card.
public type Item = record
  // Suggestion title.
  public Title: string;
  // Supporting description.
  public Detail: string := '';
  // Optional icon.
  public Icon: string := '';
end record;

// Native presentation and interaction options.
public type Options = record
  // Number of columns, or zero for the native default.
  public Columns: int := 0;
  // Allow choosing a suggestion.
  public Enabled: bool := true;
end record;

// Builds the native PromptSuggestions widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Items`: Suggestions in display order.
// - `Changed`: Maps the selected index.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function PromptSuggestions<TMsg>(Id: string; Items: array of Item; Changed: function(int): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.PromptSuggestions(Id, Items, Changed, Settings ?? new Options());
end function;

end unit;
