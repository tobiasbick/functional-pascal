unit Fpas.Ui.RadialGauges;

uses Fpas.Ui.Elements as E, Fpas.Ui.Charts as C, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, System as Sys;

// CUI's instrument rendering styles.
public type Style = enum: byte
  // Segments with bands, otherwise an arc.
  Automatic;
  // Arc with optional limit captions and target.
  Arc;
  // Colored short segments and a status chip.
  Segments;
  // Full ring with a detail caption.
  Ring;
end enum;

// One increasing native gauge threshold.
public type Band = record
  // Upper threshold, after the previous band and within the scale.
  public To: float;
  // Native semantic color.
  public Tone: S.Tone := S.Tone.Neutral;
  // Literal status chip caption.
  public Name: string := '';
end record;

// Native radial-gauge presentation.
public type Options = record
  // Literal caption below the value.
  public Label: string := '';
  // Literal unit after the value.
  public Unit: string := '';
  // Safe native number format.
  public Format: C.ValueFormat? := null;
  // Diameter; zero selects CUI's default.
  public Size: float := 0.0F;
  // Arc degrees: zero for default, otherwise 90 through 300.
  public Sweep: float := 0.0F;
  // Up to sixteen increasing native thresholds.
  public Bands: array of Band := [];
  // Show arc minimum and maximum captions.
  public ShowLimits: bool := true;
  // Optional native target marker.
  public Target: float? := null;
  // Native drawing style.
  public Style: Style := Style.Automatic;
  // Literal detail below the gauge.
  public Detail: string := '';
  // Optional native value color.
  public Color: C.Color := C.Color.Automatic;
end record;

// Draws CUI's native radial-gauge.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity.
// - `Value`: Finite reading; CUI clamps the fill to the range.
// - `Minimum`: Inclusive lower scale limit.
// - `Maximum`: Increasing upper scale limit.
// - `Settings`: Native presentation.
// ## Returns
// A graphical element.
public function RadialGauge<TMsg>(Id: string; Value: float; Minimum: float; Maximum: float; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.RadialGauge(Id, Value, Minimum, Maximum, Settings ?? new Options());
end function;

end unit;
