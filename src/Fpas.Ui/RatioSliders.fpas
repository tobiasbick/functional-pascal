unit Fpas.Ui.RatioSliders;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S, Fpas.Ui.Layout as L;

// Model-owned input.
public type Value = record
  // Caption of the first part.
  public First: string;
  // Caption of the second part.
  public Second: string;
  // First part's share from zero through one.
  public Ratio: float;
end record;

// Native widget settings.
public type Options = record
  // First part's tone.
  public Tone: S.Tone := S.Tone.Neutral;
  // Step as a share of the range. Zero uses one percent.
  public Step: float := 0.0F;
  // Logical height, or zero for the native default.
  public Height: float := 0.0F;
  // Native width.
  public Width: L.Extent := L.Extent.Fill;
  // Accepts input.
  public Enabled: bool := true;
end record;

// Presents the CUI ratio slider.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Current`: Current model value.
// - `Change`: Maps a native proposal to an application message.
// - `Settings`: Optional native appearance and input settings.
// ## Returns
// The graphical widget.
public function RatioSlider<TMsg>(Id: string; Current: Value; Change: function(float): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.RatioSlider(Id, Current, Change, Settings ?? new Options());
end function;

end unit;
