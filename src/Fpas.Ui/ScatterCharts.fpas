unit Fpas.Ui.ScatterCharts;

uses Fpas.Ui.Elements as E, Fpas.Ui.Charts as C, Fpas.Ui.Layout as L, Fpas.Ui.Styles as S, System as Sys;

// One native scatter coordinate.
public type Point = record
  // Horizontal data coordinate.
  public X: float;
  // Vertical data coordinate.
  public Y: float;
end record;

// A named native dot or bubble series.
public type Series = record
  // Literal legend caption.
  public Name: string;
  // Finite coordinates.
  public Points: array of Point;
  // Empty draws dots; otherwise one nonnegative size per point.
  public Sizes: array of float := [];
  // Native palette or explicit color.
  public Color: C.Color := C.Color.Automatic;
end record;

// The original input position of a clicked point.
public type PointIndex = record
  // Series index.
  public Series: int;
  // Point index within that series.
  public Point: int;
end record;

// Native scatter-chart presentation.
public type Options = record
  // Preferred logical width.
  public Width: L.Extent := L.Extent.Fill;
  // Logical height; zero selects CUI's default.
  public Height: float := 0.0F;
  // Literal horizontal axis title.
  public XLabel: string := '';
  // Literal vertical axis title.
  public YLabel: string := '';
  // Safe horizontal value format.
  public XFormat: C.ValueFormat? := null;
  // Safe vertical value format.
  public YFormat: C.ValueFormat? := null;
  // Show the native series legend.
  public Legend: bool := true;
  // Allow native pointer input.
  public Enabled: bool := true;
end record;

// Draws CUI's native scatter-chart.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity.
// - `Series`: Finite points and optional matching bubble sizes.
// - `Settings`: Native presentation.
// - `OnActivate`: Optional native click callback.
// ## Returns
// A graphical element.
public function ScatterChart<TMsg>(Id: string; Series: array of Series; Settings: Options? := null; OnActivate: Sys.Func<PointIndex, TMsg>? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ScatterChart(Id, Series, Settings ?? new Options(), OnActivate);
end function;

end unit;
