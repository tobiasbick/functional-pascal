unit Fpas.Ui.ShortcutRecorders;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, System as Sys;

// Native CUI key values; None represents an empty shortcut.
public type Key = enum: byte
  // No recorded key.
  None;
  // Tab key.
  Tab;
  // Enter key.
  Enter;
  // Escape key.
  Escape;
  // Backspace key.
  Backspace;
  // Delete key.
  Delete;
  // Space key.
  Space;
  // Left key.
  Left;
  // Right key.
  Right;
  // Up key.
  Up;
  // Down key.
  Down;
  // Home key.
  Home;
  // End key.
  End;
  // PageUp key.
  PageUp;
  // PageDown key.
  PageDown;
  // A key.
  A;
  // B key.
  B;
  // C key.
  C;
  // D key.
  D;
  // E key.
  E;
  // F key.
  F;
  // G key.
  G;
  // H key.
  H;
  // I key.
  I;
  // J key.
  J;
  // K key.
  K;
  // L key.
  L;
  // M key.
  M;
  // N key.
  N;
  // O key.
  O;
  // P key.
  P;
  // Q key.
  Q;
  // R key.
  R;
  // S key.
  S;
  // T key.
  T;
  // U key.
  U;
  // V key.
  V;
  // W key.
  W;
  // X key.
  X;
  // Y key.
  Y;
  // Z key.
  Z;
  // Digit 0.
  D0;
  // Digit 1.
  D1;
  // Digit 2.
  D2;
  // Digit 3.
  D3;
  // Digit 4.
  D4;
  // Digit 5.
  D5;
  // Digit 6.
  D6;
  // Digit 7.
  D7;
  // Digit 8.
  D8;
  // Digit 9.
  D9;
  // Minus key.
  Minus;
  // Equal key.
  Equal;
  // Comma key.
  Comma;
  // Period key.
  Period;
  // Slash key.
  Slash;
  // F1 key.
  F1;
  // F2 key.
  F2;
  // F3 key.
  F3;
  // F4 key.
  F4;
  // F5 key.
  F5;
  // F6 key.
  F6;
  // F7 key.
  F7;
  // F8 key.
  F8;
  // F9 key.
  F9;
  // F10 key.
  F10;
  // F11 key.
  F11;
  // F12 key.
  F12;
end enum;

// Combinable native modifier flags.
[Sys.FlagsAttribute]
public type Modifier = enum: byte
  // No modifiers.
  None = 0;
  // Shift key.
  Shift = 1;
  // Control key.
  Control = 2;
  // Alt or Option key.
  Alt = 4;
  // Windows or Command key.
  Super = 8;
end enum;

// A recorded native shortcut.
public type Combination = record
  // Recorded key; None requires no modifiers.
  public Key: Key := Key.None;
  // Modifier flags accompanying the key.
  public Modifiers: Modifier := Modifier.None;
end record;

// Native recorder presentation.
public type Options = record
  // Literal placeholder; empty uses CUI's Click to record default.
  public Placeholder: string := '';
  // Native content, fill, fixed or percentage width.
  public Width: L.Extent := L.Extent.Content;
  // Whether recording and clearing accept input.
  public Enabled: bool := true;
end record;

// Builds CUI's shortcut recorder with native key capture and clearing.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Value`: Model-owned key and modifier flags.
// - `OnChange`: Maps a native shortcut proposal to a message.
// - `Settings`: Optional placeholder, width and input settings.
// ## Returns
// A graphical native shortcut recorder.
public function ShortcutRecorder<TMsg>(Id: string; Value: Combination; OnChange: function(Combination): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ShortcutRecorder(Id, Value, OnChange, Settings ?? new Options());
end function;

// Displays a shortcut using CUI's platform formatter and native keycaps.
// ## Type parameters
// - `TMsg`: Parent message type.
// ## Parameters
// - `Value`: Key and modifiers to display.
// ## Returns
// A graphical passive native shortcut label.
public function Label<TMsg>(Value: Combination): E.Element<TMsg>;
begin
  return E.Element<TMsg>.ShortcutLabel(Value);
end function;

// Identifies the native clear action for inspection and focus.
// ## Parameters
// - `Id`: Recorder identity.
// ## Returns
// The clear action ID.
public function ClearId(Id: string): string;
begin
  return Id + '/clear';
end function;

// Selects CUI's platform-primary shortcut modifier.
// ## Returns
// Super on macOS; Control on other supported platforms.
public function PrimaryModifier(): Modifier;
begin
  return if Sys.OperatingSystem.IsMacOS() then
    Modifier.Super
  else
    Modifier.Control
  end if;
end function;

end unit;
