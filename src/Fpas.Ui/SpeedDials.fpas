unit Fpas.Ui.SpeedDials;

uses Fpas.Ui.Elements as E, Fpas.Ui.Menus as M;

// A native speed dial action.
public type Item = record
  // Action caption.
  public Label: string;
  // CUI icon glyph.
  public Icon: string;
end record;

// Presentation and input options for a speed dial.
public type Options = record
  // Optional trigger glyph. CUI defaults to a plus.
  public Icon: string := '';
  // Optional tooltip and accessible trigger label.
  public Tooltip: string := '';
  // Native placement. BottomStart selects CUI's default.
  public Position: M.Placement := M.Placement.BottomStart;
  // Whether the dial accepts input.
  public Enabled: bool := true;
end record;

// Gets the control identity of a visible action.
// ## Parameters
// - `Id`: Dial identity.
// - `Index`: Zero-based position.
// ## Returns
// The action identity used for inspection and focus.
public function ItemId(Id: string; Index: int): string;
begin
  return Id + '/' + Index.ToString();
end function;

// Builds CUI's speed dial.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable dial identity.
// - `Items`: One through sixteen actions in native order.
// - `OnChoose`: Maps a chosen index to an application message.
// - `Settings`: Optional trigger and placement options.
// ## Returns
// A graphical speed dial with CUI-owned expansion.
public function SpeedDial<TMsg>(
  Id: string; Items: array of Item; OnChoose: function(int): TMsg; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.SpeedDialAction(Id, Items, OnChoose, Settings ?? new Options());
end function;

end unit;
