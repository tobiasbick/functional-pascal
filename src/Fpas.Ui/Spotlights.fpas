unit Fpas.Ui.Spotlights;

uses Fpas.Ui.Elements as E, Fpas.Ui.Charts as C, Fpas.Ui.Layout as L;

// Native options.
public type Options = record
  // Native width.
  public Width: L.Extent := L.Extent.Fill;
  // Native height.
  public Height: L.Extent := L.Extent.Content;
  // Inset or zero for the native default.
  public Padding: float := 0.0F;
  // Child spacing or zero for the native default.
  public Gap: float := 0.0F;
  // Light color.
  public Color: C.Color := C.Color.Automatic;
  // Show a traveling beam.
  public Beam: bool := false;
end record;

// Draws the native CUI spotlight.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Children`: Content of the card.
// - `Settings`: Optional native options.
// ## Returns
// The graphical widget.
public function Spotlight<TMsg>(Id: string; Children: array of E.Element<TMsg>; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Spotlight(Id, Children, Settings ?? new Options());
end function;

end unit;
