unit Fpas.Ui.Stacks;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Places children on top of each other with CUI's native stack layout.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Settings`: Padding, horizontal alignment, vertical justification and direction.
// - `Children`: Children in paint order, with the final child on top.
// ## Returns
// A graphical layered stack. Give it explicit axes with Elements.Size when needed.
public function Stack<TMsg>(Settings: L.Flow; params Children: array of E.Element<TMsg>): E.Element<TMsg>;
begin
  return E.Element<TMsg>.Layered(Children, Settings);
end function;

end unit;
