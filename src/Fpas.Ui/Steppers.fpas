unit Fpas.Ui.Steppers;

uses Fpas.Ui.Elements as E;

// Displays progress through a sequence of steps using native CUI.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Steps`: Nonempty sequence of literal captions.
// - `Current`: Zero-based step in progress, or the step count when all are complete.
// ## Returns
// A graphical progress display driven by the model.
public function Stepper<TMsg>(Id: string; Steps: array of string; Current: int): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.StepProgress(Id, Steps, Current);
end function;
end unit;
