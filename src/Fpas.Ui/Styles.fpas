unit Fpas.Ui.Styles;

// A semantic style supplied by the host's current theme.
public type Role = enum: byte
  // Inherit the enclosing style.
  Default;
  // A surface containing related controls.
  Panel;
  // A title or section heading.
  Heading;
  // Secondary text.
  Muted;
  // The main accent.
  Primary;
  // A supporting accent.
  Secondary;
  // An error state.
  Error;
  // A muted surface for navigation and secondary content.
  MutedPanel;
  // The heading of the current page.
  PageTitle;
  // A line separating adjacent regions.
  Divider;
  // An outlined surface around a related group of controls.
  OutlinedPanel;
  // A graphical CUI label with medium weight and native body-size metrics.
  Label;
  // Small secondary text using CUI's caption metrics.
  Caption;
  // A graphical value in CUI's display face with tabular digits.
  DisplayValue;
  // Graphical body text in CUI's medium face.
  Strong;
  // A graphical CUI icon glyph at twelve logical points in the muted color.
  MutedGlyph;
  // A graphical section heading using the third CUI heading size.
  SectionTitle;
  // A graphical display heading using the first CUI heading size.
  DisplayTitle;
  // Graphical introductory text with CUI's secondary color at 15 logical points.
  Introduction;
end enum;

// Native CUI semantic colors shared by graphical widgets.
public type Tone = enum: byte
  // Neutral surface.
  Neutral;
  // Informational blue.
  Info;
  // Successful green.
  Success;
  // Warning amber.
  Warning;
  // Destructive red.
  Danger;
  // Violet accent.
  Violet;
  // Teal accent.
  Teal;
  // Rose accent.
  Rose;
  // Current theme accent.
  Accent;
end enum;

// The role of a button within the application.
public type ButtonVariant = enum: byte
  // An ordinary action.
  Default;
  // The main action.
  Primary;
  // A supporting action.
  Secondary;
  // The action representing the current choice.
  Active;
  // An action that discards or deletes data.
  Destructive;
  // A bordered action with a transparent surface.
  Outline;
  // An action with a quiet, transparent resting surface.
  Ghost;
  // An action styled as a link.
  Link;
end enum;

end unit;
