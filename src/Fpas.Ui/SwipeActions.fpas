unit Fpas.Ui.SwipeActions;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S;

// The side of a swipe row that reveals an action.
public type Side = enum: byte
  // Actions exposed by swiping the content to the right.
  Left;
  // Actions exposed by swiping the content to the left.
  Right;
end enum;

// A command exposed by a native swipe row.
public type Item = record
  // Visible action label.
  public Label: string;
  // Optional CUI glyph.
  public Icon: string := '';
  // Semantic background tone.
  public Tone: S.Tone := S.Tone.Neutral;
end record;

// Decoration and input permission for the swipe row.
public type Options = record
  // Optional leading CUI glyph.
  public Icon: string := '';
  // Optional trailing annotation.
  public Detail: string := '';
  // Whether the row accepts input.
  public Enabled: bool := true;
end record;

// Gets the control identity of a revealed action.
// ## Parameters
// - `Id`: Swipe row identity.
// - `At`: Side containing the action.
// - `Index`: Position on that side.
// ## Returns
// The identity used for inspection.
public function ItemId(Id: string; At: Side; Index: int): string;
begin
  return Id + (if At = Side.Left then
    '/left/'
  else
    '/right/'
  end if) + Index.ToString();
end function;

// Wraps a foreground view in a native swipe row.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable row identity.
// - `Content`: Foreground content laid out in CUI's horizontal row.
// - `Left`: Ordered actions revealed on the left, up to 100.
// - `Right`: Ordered actions revealed on the right.
// - `OnChoose`: Maps a side and index to a message.
// - `Settings`: Optional decoration and input permission.
// ## Returns
// A graphical swipe row that owns its gesture and reveal state in CUI.
public function SwipeItem<TMsg>(
  Id: string; Content: E.Element<TMsg>; Left: array of Item; Right: array of Item;
  OnChoose: function(Side, int): TMsg; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.SwipeRow(Id, Content, Left, Right, OnChoose, Settings ?? new Options());
end function;

end unit;
