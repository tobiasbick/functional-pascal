unit Fpas.Ui.Switches;

uses Fpas.Ui.Elements as E;

// Creates a model-controlled switch for the graphical profile.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Label`: Literal caption for the interactive row.
// - `On`: Current model-owned value.
// - `OnChange`: Maps a changed value to an application message.
// - `Description`: Optional secondary text below the caption.
// - `Enabled`: Whether the row accepts input.
// ## Returns
// The graphical control that proposes changes to the model.
public function Switch<TMsg>(
  Id: string; Label: string; On: bool; OnChange: function(bool): TMsg;
  Description: string := ''; Enabled: bool := true
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.SwitchAction(Id, Label, On, OnChange, Description, Enabled);
end function;

end unit;
