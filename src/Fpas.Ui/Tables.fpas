unit Fpas.Ui.Tables;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, System as Sys, System.Globalization as Culture;

// Text alignment within a native table column.
public type Alignment = enum: byte
  // Align to the left.
  Left;
  // Center text.
  Center;
  // Align to the right and use tabular digits for plain cells.
  Right;
end enum;

// Native column heading and width.
public type Column = record
  // Literal column title.
  public Title: string;
  // Column extent.
  public Width: L.Extent := L.Extent.Fill;
  // Relative width weight for fill columns.
  public Grow: float := 1.0F;
  // Text alignment in the header and cells.
  public Align: Alignment := Alignment.Left;
  // Whether the heading proposes a sort change.
  public Sortable: bool := false;
end record;

// Current model-owned sorting.
public type Sort = record
  // Zero-based column index. Minus one is unsorted.
  public Column: int;
  // Whether to sort in descending order.
  public Descending: bool := false;
end record;

// A native table cell.
//
// ## Type parameters
// - `TMsg`: Application message type.
public type Cell<TMsg> = variant
  // Use CUI's plain cell text and alignment.
  Text(Value: string);
  // Draw a row of graphical children directly in the cell.
  Content(Children: array of E.Element<TMsg>);
end variant;

// One table row with its model-owned selection.
// ## Type parameters
// - `TMsg`: Application message type.
public type Row<TMsg> = record
  // Stable row identity.
  public Id: string;
  // One cell per column.
  public Cells: array of Cell<TMsg>;
  // Whether the row is selected.
  public Selected: bool := false;
end record;

// Native table settings.
public type Options = record
  // Explicit viewport height. Content fits all rows.
  public Height: L.Extent := L.Extent.Content;
  // Whether alternate rows have a tint.
  public Striped: bool := false;
  // Whether to use smaller rows.
  public Compact: bool := false;
  // Whether headers and rows accept activation.
  public Enabled: bool := true;
end record;

// Derives a header identity for keyboard focus and inspection.
// ## Parameters
// - `Id`: Stable table identity.
// - `Index`: Zero-based column index.
// ## Returns
// The header identity.
public function HeaderId(Id: string; Index: int): string;
begin
  return Id + '/header/' + Index.ToString(Culture.CultureInfo.InvariantCulture);
end function;

// Builds a native table with sortable headers and composable cells.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable table identity.
// - `Columns`: Column headings and layout.
// - `Rows`: Rows in model-owned display order.
// - `Order`: Current sort, paired with OnSort.
// - `OnSort`: Optional sort proposal mapper.
// - `OnSelect`: Optional row activation mapper receiving its ID.
// - `Settings`: Optional native table settings.
// ## Returns
// The graphical element.
public function Table<TMsg>(Id: string; Columns: array of Column; Rows: array of Row<TMsg>; Order: Sort? := null; OnSort: Sys.Func<Sort, TMsg>? := null; OnSelect: Sys.Func<string, TMsg>? := null; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Table(
    Id,
    Columns,
    Rows,
    Order,
    OnSort,
    OnSelect,
    Settings ?? new Options()
  );
end function;

end unit;
