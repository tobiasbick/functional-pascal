// [Documentation](../../../docs/ui/tui/host.md#terminal-extensions)

unit Fpas.Ui.TerminalExtensions.Views;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.Widgets.Developer.Terminal as T;

// Composes terminal content, layers and application shortcuts.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `Content`: Base content.
// - `Layers`: Floating layers in paint order.
// - `Shortcuts`: Base-scope shortcuts.
//
// ## Returns
// A terminal-only screen.
public function Screen of TMsg(
  Content: E.Element of TMsg; Layers: array of E.Element of TMsg;
  Shortcuts: array of K.ShortcutBinding of TMsg
): E.Element of TMsg;
begin
  return (E.Element of TMsg).TerminalScreen(Content, Layers, Shortcuts);
end function;

// Builds a terminal-specific responsive subtree from exact dimensions.
//
// ## Type parameters
// - `TMsg`: Message type.
//
// ## Parameters
// - `Id`: Stable responsive-subtree ID.
// - `Build`: Builds the subtree from available terminal dimensions.
//
// ## Returns
// A terminal-only node, resolved and checked during preflight.
public function Viewport of TMsg(Id: string; Build: function(T.Viewport): E.Element of TMsg): E.Element of TMsg;
begin
  return (E.Element of TMsg).TerminalViewport(Id, Build);
end function;

end unit;
