unit Fpas.Ui.TextAreas;

uses Fpas.Ui.Elements as E, Fpas.Ui.Buttons as B, System as Sys;

// Native presentation and input options for a multiline editor.
public type Options = record
  // Caption above the editor.
  public Label: string := '';
  // Text displayed while empty.
  public Placeholder: string := '';
  // Optional leading CUI glyph.
  public Icon: string := '';
  // Supporting text below the editor.
  public Hint: string := '';
  // Validation error that replaces the hint.
  public Error: string := '';
  // Muted text before the editable value.
  public Prefix: string := '';
  // Muted text after the editable value.
  public Suffix: string := '';
  // Editor height in logical points. Zero uses 96 and a negative value fills the available height.
  public Height: int := 96;
  // Show the native clear button while the editable value is nonempty.
  public Clearable: bool := false;
  // Allow focus and selection while preventing edits.
  public ReadOnly: bool := false;
  // Allow keyboard and pointer input.
  public Enabled: bool := true;
  // Native font size.
  public ControlSize: B.Size := B.Size.Medium;
  // Maximum value size in UTF-8 bytes, excluding the terminator.
  public MaxUtf8Bytes: int := 4095;
end record;

// Builds CUI's wrapping multiline editor.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable editor identity.
// - `Value`: Model-owned text with LF line endings.
// - `OnChange`: Maps a proposed edit to a message.
// - `Settings`: Optional native editor settings.
// - `OnSubmit`: Optional Ctrl+Enter action receiving the value after the frame's edit.
// ## Returns
// A graphical text area.
public function TextArea<TMsg>(
  Id: string; Value: string; OnChange: function(string): TMsg;
  Settings: Options? := null; OnSubmit: Sys.Func<string, TMsg>? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.TextArea(Id, Value, OnChange, Settings ?? new Options(), OnSubmit);
end function;

// Derives the identity of the native clear button.
//
// ## Parameters
// - `Id`: Editor identity.
// ## Returns
// The snapshot ID of the clear button when visible.
public function ClearId(Id: string): string;
begin
  return Id + '/clear';
end function;
end unit;
