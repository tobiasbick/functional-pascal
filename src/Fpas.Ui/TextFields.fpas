unit Fpas.Ui.TextFields;

uses Fpas.Ui.Elements as E, Fpas.Ui.Buttons as B, System as Sys;

// Native presentation and input options for a single-line field.
public type Options = record
  // Caption above the field.
  public Label: string := '';
  // Text shown while the field is empty.
  public Placeholder: string := '';
  // Optional leading CUI icon glyph.
  public Icon: string := '';
  // Supporting text below the field.
  public Hint: string := '';
  // Validation error that replaces the hint.
  public Error: string := '';
  // Muted text before the editable value.
  public Prefix: string := '';
  // Muted text after the editable value.
  public Suffix: string := '';
  // Mask the value and show the native reveal button.
  public Password: bool := false;
  // Show the native clear button while the editable value is nonempty.
  public Clearable: bool := false;
  // Allow focus and selection while preventing editing.
  public ReadOnly: bool := false;
  // Allow keyboard and pointer input.
  public Enabled: bool := true;
  // Native height and font metrics.
  public ControlSize: B.Size := B.Size.Medium;
  // Maximum value size in UTF-8 bytes. Password fields support up to 341.
  public MaxUtf8Bytes: int := 255;
end record;

// Builds CUI's single-line editor with a model-owned value.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable field identity.
// - `Value`: Current single-line value.
// - `OnChange`: Maps a proposed edit to a message.
// - `Settings`: Optional native field settings.
// - `OnSubmit`: Optional message factory for Enter, receiving the value after any edit in that frame.
// ## Returns
// A graphical text field.
public function TextField<TMsg>(
  Id: string; Value: string; OnChange: function(string): TMsg;
  Settings: Options? := null; OnSubmit: Sys.Func<string, TMsg>? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.TextField(Id, Value, OnChange, Settings ?? new Options(), OnSubmit);
end function;

// Derives the identity of the native clear button.
//
// ## Parameters
// - `Id`: Field identity.
// ## Returns
// The snapshot ID of the clear button when visible.
public function ClearId(Id: string): string;
begin
  return Id + '/clear';
end function;

// Derives the identity of the native show or hide password button.
//
// ## Parameters
// - `Id`: Field identity.
// ## Returns
// The snapshot ID of the reveal button.
public function RevealId(Id: string): string;
begin
  return Id + '/reveal';
end function;

end unit;
