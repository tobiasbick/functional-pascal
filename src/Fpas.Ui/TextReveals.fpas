unit Fpas.Ui.TextReveals;

uses Fpas.Ui.Elements as E, Fpas.Ui.Motion as Motion;

// Draws the native CUI text reveal.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Text`: Literal display text.
// - `Replay`: Change this value to restart the effect.
// - `Settings`: Optional native options.
// ## Returns
// The graphical widget.
public function TextReveal<TMsg>(Id: string; Text: string; Replay: int := 0; Settings: Motion.TextOptions? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.TextReveal(Id, Text, Replay, Settings ?? new Motion.TextOptions());
end function;

end unit;
