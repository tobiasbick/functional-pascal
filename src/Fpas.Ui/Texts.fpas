unit Fpas.Ui.Texts;

uses Fpas.Ui.Elements as E;

// CUI's built-in text roles.
public type Appearance = enum: byte
  // Ordinary wrapping text.
  Body;
  // A level one heading.
  HeadingOne;
  // A level two heading.
  HeadingTwo;
  // A level three heading.
  HeadingThree;
  // A level four heading.
  HeadingFour;
  // Medium-weight label.
  Label;
  // Secondary text at body size.
  Secondary;
  // Smaller text in the muted color.
  Muted;
  // Monospaced text on a compact background.
  Code;
end enum;

// Creates a native CUI text element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Text`: Literal text.
// - `Role`: Native text role.
// ## Returns
// A graphical element.
public function Text<TMsg>(Text: string; Role: Appearance): E.Element<TMsg>;
begin
  return E.Element<TMsg>.NativeText(Text, Role);
end function;

end unit;
