unit Fpas.Ui.ThemeToggles;

uses Fpas.Ui.Elements as E, Fpas.Ui.Themes as Themes;

// Creates a compact, controlled light/dark action for either host.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity, independent of appearance and caption.
// - `Appearance`: Model-owned concrete appearance, resolving System beforehand.
// - `OnChange`: Maps the opposite appearance to a message only on activation.
// - `Enabled`: Whether the button accepts input and focus.
// ## Returns
// A sun/moon action; the model applies accepted changes through ThemeFor.
public function ThemeToggle<TMsg>(Id: string; Appearance: Themes.Mode; OnChange: function(Themes.Mode): TMsg; Enabled: bool := true): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ThemeFlip(Id, Appearance, OnChange, Enabled);
end function;
end unit;
