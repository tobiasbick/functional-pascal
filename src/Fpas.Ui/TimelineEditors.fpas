unit Fpas.Ui.TimelineEditors;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.CurveEditors as C;

// Frame ruler labels.
public type Ruler = enum: byte
  // Frame numbers.
  Frames;
  // Seconds.
  Seconds;
  // Timecode.
  Timecode;
end enum;

// A selected or unselected curve key.
public type Key = record
  // Time, value and interpolation.
  public Curve: C.Key;
  // Whether this key is selected.
  public Selected: bool := false;
end record;

// A clip on a timeline track.
public type Clip = record
  // Start in seconds.
  public Start: float;
  // End in seconds.
  public Finish: float;
  // Source media offset.
  public Offset: float;
  // Visible clip label.
  public Name: string;
  // Whether this clip is selected.
  public Selected: bool := false;
end record;

// One timeline track.
public type Track = record
  // Track label.
  public Name: string;
  // Optional icon.
  public Icon: string := '';
  // Depth in the track hierarchy.
  public Depth: int := 0;
  // Whether child tracks are collapsed.
  public Collapsed: bool := false;
  // Whether the track is muted.
  public Muted: bool := false;
  // Whether key and clip edits are locked.
  public Locked: bool := false;
  // Native series color, zero for automatic.
  public Color: int := 0;
  // Sorted animation keys.
  public Keys: array of Key := [];
  // Key capacity. Zero allows no insertions.
  public Capacity: int := 0;
  // Sorted, non-overlapping clips.
  public Clips: array of Clip := [];
end record;

// Optional editable play range.
public type PlayRange = record
  // Limit at which playback loops.
  public Start: float;
  // End of the loop.
  public Finish: float;
end record;

// Model-owned timeline viewport and selection.
public type View = record
  // Playhead seconds.
  public Time: float := 0.0F;
  // Visible start.
  public Start: float := 0.0F;
  // Visible end. A nonpositive range fits the sequence.
  public Finish: float := 0.0F;
  // Vertical offset.
  public Scroll: float := 0.0F;
  // Current track, or minus one.
  public TrackIndex: int := -1;
  // Current key in that track, or minus one.
  public KeyIndex: int := -1;
  // Optional editable play range.
  public Range: PlayRange? := null;
end record;

// Native edit and playback proposal.
public type Event = record
  // Resulting tracks and selection.
  public Tracks: array of Track;
  // Resulting playhead, viewport and range.
  public Current: View;
  // Whether Space requested a playback toggle.
  public TogglePlayback: bool;
end record;

// Native TimelineEditor settings.
public type Options = record
  // Preferred width.
  public Width: L.Extent := L.Extent.Fill;
  // Sequence start in seconds.
  public Start: float := 0.0F;
  // Sequence end in seconds.
  public Finish: float := 10.0F;
  // Ruler and snapping rate.
  public FramesPerSecond: float := 30.0F;
  // Ruler label format.
  public Labels: Ruler := Ruler.Frames;
  // Height, or zero to fit rows.
  public Height: float := 0.0F;
  // Row height, or zero for the native default.
  public RowHeight: float := 0.0F;
  // Track list width, or zero for the native default.
  public TrackWidth: float := 0.0F;
  // Show mute and lock buttons.
  public Toggles: bool := false;
  // Do not snap drags to a frame.
  public FreeDrag: bool := false;
end record;

// Creates a graphical TimelineEditor.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Tracks`: Tracks and their selected keys and clips.
// - `Current`: Model-owned playhead, selection, viewport and optional play range.
// - `Changed`: Maps a native proposal to a message.
// - `Settings`: Native layout and behavior options.
// ## Returns
// A graphical element.
public function TimelineEditor<TMsg>(Id: string; Tracks: array of Track; Current: View; Changed: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.TimelineEditor(Id, Tracks, Current, Changed, Settings ?? new Options());
end function;

end unit;
