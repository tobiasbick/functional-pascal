unit Fpas.Ui.ToggleGroups;

uses Fpas.Ui.Elements as E, Fpas.Ui.Buttons as B;

// A positional toggle with a literal accessible label.
public type Item = record
  // Visible caption or tooltip for an icon-only item.
  public Label: string;
  // Optional CUI icon-font glyph.
  public Icon: string := '';
end record;

// Native toggle group appearance and input settings.
public type Options = record
  // Require one selected item and clear the others when a different item is chosen.
  public Exclusive: bool := false;
  // Show items with icons as glyphs and keep their labels as tooltips.
  public IconOnly: bool := false;
  // Medium, small or large CUI control size.
  public ControlSize: B.Size := B.Size.Medium;
  // Whether the group accepts pointer and keyboard input.
  public Enabled: bool := true;
end record;

// Creates a controlled toggle group for the graphical profile.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable group identity.
// - `Items`: One through 32 choices, in stable positional order.
// - `Selected`: One model-owned flag per item. Exclusive groups require exactly one selected item.
// - `OnChange`: Maps a changed set of flags to a message.
// - `Settings`: Native toggle mode, size, icons and input permission.
// ## Returns
// A group which proposes a new selection without mutating the supplied flags.
public function ToggleGroup<TMsg>(
  Id: string; Items: array of Item; Selected: array of bool;
  OnChange: function(array of bool): TMsg; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Toggles(Id, Items, Selected, OnChange, Settings ?? new Options());
end function;

// Gets a positional toggle's stable identity for application focus requests.
//
// ## Parameters
// - `Id`: Group identity.
// - `Index`: Nonnegative position of the item.
// ## Returns
// The group ID followed by / and the zero-based index.
public function ItemId(Id: string; Index: int): string;
requires Id <> '';
requires Index >= 0;
begin
  return Id + '/' + Index.ToString();
end function;
end unit;
