unit Fpas.Ui.UserMenus;

uses Fpas.Ui.Elements as E, Fpas.Ui.Menus as M;

// Options for the native account trigger and its popup.
public type Options = record
  // Optional detail below the name, also shown in the popup header.
  public Detail: string := '';
  // Optional avatar status, such as online, busy or away.
  public Status: string := '';
  // Show only the avatar in the trigger.
  public Compact: bool := false;
  // Native placement. BottomStart uses CUI's default for the trigger style.
  public Position: M.Placement := M.Placement.BottomStart;
  // Popup width in logical points, or zero for CUI's default.
  public Width: float := 0.0F;
  // Whether the trigger and popup accept input.
  public Enabled: bool := true;
end record;

// Creates CUI's initials avatar and account menu.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable trigger identity.
// - `Name`: Display name used for the avatar and accessible trigger.
// - `Entries`: Keyed commands and decorations in display order.
// - `Settings`: Optional account details and popup settings.
// ## Returns
// A graphical account menu that dispatches the chosen command message.
public function UserMenu<TMsg>(
  Id: string; Name: string; Entries: array of M.Entry<TMsg>; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.AccountMenu(Id, Name, Entries, Settings ?? new Options());
end function;
end unit;
