unit Fpas.Ui.Validation;

uses
  Fpas.Ui.ColorPickers as ColorPickers, Fpas.Ui.EmojiPickers as Emojis,
  Fpas.Ui.Calendars as Calendars, Fpas.Ui.DatePickers as DatePickers,
  Fpas.Ui.Internal.AudioRules as AudioRules,
  Fpas.Ui.Grids as Grids, Fpas.Ui.Cards as Cards, Fpas.Ui.Badges as Badges,
  Fpas.Ui.Metrics as Metrics, Fpas.Ui.AvatarGroups as AvatarGroups, Fpas.Ui.EmptyStates as EmptyStates,
  Fpas.Ui.Internal.SurfaceRules as SurfaceRules, Fpas.Ui.TableOfContents as Toc,
  Fpas.Ui.Banners as Banners, Fpas.Ui.Countdowns as Countdowns, Fpas.Ui.Checklists as Checklists,
  Fpas.Ui.Dropzones as Dropzones, Fpas.Ui.SignaturePads as Signatures,
  Fpas.Ui.Avatars as Avatars, Fpas.Ui.HoverCards as HoverCards,
  Fpas.Ui.Knobs as Knobs, Fpas.Ui.Faders as Faders, Fpas.Ui.LevelMeters as Levels,
  Fpas.Ui.RulerSliders as Rulers, Fpas.Ui.HistogramSliders as Histograms,
  Fpas.Ui.TimePickers as TimePickers, Fpas.Ui.WheelPickers as WheelPickers,
  Fpas.Ui.TimeDials as TimeDials, Fpas.Ui.Internal.PickerRules as PickerRules,
  Fpas.Ui.DateRanges as Dates, Fpas.Ui.DateRangePickers as RangePickers,
  Fpas.Ui.Internal.DateRangeRules as DateRangeRules,
  Fpas.Ui.SpeedDials as Speed, Fpas.Ui.SwipeActions as Swipe, Fpas.Ui.MultiSelects as Multi,
  Fpas.Ui.Internal.ActionRules as ActionRules,
  Fpas.Ui.TimelineItems as Timeline,
  Fpas.Ui.Internal.FeedbackRules as FeedbackRules, Fpas.Ui.Alerts as Alerts, Fpas.Ui.ProgressBars as ProgressBars, Fpas.Ui.ExpandableTexts as ExpandableTexts, Fpas.Ui.ExpandableCards as ExpandableCards, Fpas.Ui.Internal.DisclosureRules as DisclosureRules, Fpas.Ui.Reactions as Reactions, Fpas.Ui.UserMenus as UserMenus, Fpas.Ui.Selects as Selects, Fpas.Ui.NumberFields as NumberFields, Fpas.Ui.Internal.SelectRules as SelectRules, Fpas.Ui.Internal.NumberFieldRules as NumberRules, Fpas.Ui.TagInputs as TagInputs, Fpas.Ui.OneTimeCodes as OneTimeCodes, Fpas.Ui.Internal.TagInputRules as TagRules, Fpas.Ui.Internal.OneTimeCodeRules as CodeRules, Fpas.Ui.SearchFields as SearchFields, Fpas.Ui.TextAreas as TextAreas, Fpas.Ui.Dialogs as Dialogs, Fpas.Ui.TextFields as TextFields, Fpas.Ui.Internal.EditorRules as EditorRules, Fpas.Ui.Internal.PopoverRules as PopupRules, Fpas.Ui.Popovers as Popovers, Fpas.Ui.ConfirmPopovers as ConfirmPopovers, Fpas.Ui.Internal.TooltipRules as TooltipRules, Fpas.Ui.Internal.NavigationRules as NavigationRules, Fpas.Ui.Tabs as Tabs, Fpas.Ui.RadioCards as RadioCards, Fpas.Ui.Sliders as Sliders, Fpas.Ui.RangeSliders as RangeSliders, Fpas.Ui.Internal.SliderRules as SliderRules, Fpas.Ui.Internal.SelectionRules as SelectionRules, Fpas.Ui.RadioGroups as RadioGroups, Fpas.Ui.ToggleGroups as ToggleGroups, Fpas.Ui.Internal.ToggleGroupRules as ToggleGroupRules, Fpas.Ui.Menus as Menus, Fpas.Ui.Internal.MenuRules as MenuRules, Fpas.Ui.SegmentedControls as Segmented, Fpas.Ui.Themes as Themes, Fpas.Ui.ThemeSwitchers as ThemeSwitchers, Fpas.Ui.StatusButtons as Status, Fpas.Ui.ConfirmButtons as Confirms, Fpas.Ui.SplitButtons as Split, Fpas.Ui.HoldButtons as Holds, Fpas.Ui.Elements as E, Fpas.Ui.Internal.Rules as Rules, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Layout as L, Fpas.Ui.Navigation as N, Fpas.Ui.Sheets as Sheets, Fpas.Ui.Buttons as B, Fpas.Ui.IconButtons as Icons, Fpas.Ui.Styles as S, Fpas.Ui.Terminal as T, Fpas.Ui.Graphics as G, System as Sys, System.Collections.Generic as Generic, System.Collections.ObjectModel as Collections, System.Text as Text;

// The capability profile to check before a host presents a view.
public type Target = enum: byte
  // Accepts only widgets and options shared by both hosts.
  Portable;
  // Allows cell units and terminal extension nodes.
  Terminal;
  // Allows logical units and graphical extension nodes.
  Graphical;
end enum;

// A validated view and its resolved subtrees.
//
// ## Type parameters
// - `TMsg`: The application message type.
public type Prepared<TMsg> = record
  // The root view. Deferred nodes reference Subviews by ID.
  public Tree: E.Element<TMsg>;
  // The resolved subtrees for this view, including nested deferred nodes.
  public Subviews: Generic.IReadOnlyDictionary<string, E.CacheEntry<TMsg>>;
end record;

// Validates the entire view and resolves deferred subtrees before presentation.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Tree`: The view to check, including all modal layers.
// - `Profile`: The capabilities of the target.
// - `Previous`: The last successfully presented view, if available.
// - `TerminalSize`: Exact dimensions required by terminal viewport subtrees.
//
// ## Returns
// The view and the cache entries that its presenter should use.
public function Prepare<TMsg>(
  Tree: E.Element<TMsg>; Profile: Target; Previous: Prepared<TMsg>? := null; TerminalSize: T.Viewport? := null
): Prepared<TMsg>;
requires Profile = Target.Portable or Profile = Target.Terminal or Profile = Target.Graphical;
  function Identify(Id: string; Location: string): string;
  begin
    if Sys.String.IsNullOrWhiteSpace(Id) then
      Rules.Reject(Location, 'Control and subview IDs must be nonempty.');
    end if;
    const Named: string := Location + '[' + Id + ']';
    Rules.CheckText(Id, Named);
    if not Ids.Add(Id) then
      Rules.Reject(Named, 'Duplicate ID ' + Id + '.');
    end if;

    return Named;
  end function;

  procedure CheckNode(Node: E.Element<TMsg>; Location: string);
  begin
    case Node of
      when E.Element.Dialog(
        const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>,
        _, const Settings: Dialogs.Options, _
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/dialog');
        if HoverDepth > 0 then
          Rules.Reject(Location, 'Place modal views outside pointer-owned hover card bodies.');
        end if;
        const At: string := Identify(Id, Location + '/dialog');
        if Settings.CloseButton then
          discard Identify(Dialogs.CloseId(Id), At + '/close');
        end if;

        Rules.CheckText(Settings.Title, At + '/title');
        Rules.CheckText(Settings.Description, At + '/description');
        const Initial: string? := Settings.InitialFocus;
        if Initial <> null then
          Rules.CheckText(Initial, At + '/initialFocus');
        end if;

        if Settings.Width <= 0 then
          Rules.Reject(At, 'A dialog needs a positive width.');
        end if;

        Visit(Base, At + '/base');
        Visit(Content, At + '/content');
      when E.Element.ActionFooter(const Children: array of E.Element<TMsg>):
        const At: string := Location + '/actionFooter';
        Rules.RequireProfile(Profile, Target.Graphical, At);
        for Index: int := 0 to Children.Length - 1 do
          Visit(Children[Index], At + '[' + Index.ToString() + ']');
        end for;
      when E.Element.TextField(
        const Id: string,
        const Value: string,
        _,
        const Settings: TextFields.Options,
        _
      ):
        EditorRules.CheckTextField(Id, Value, Settings, Profile, Location, Identify);
      when E.Element.SearchField(
        const Id: string,
        const Value: string,
        _,
        const Settings: SearchFields.Options,
        _
      ):
        EditorRules.CheckSearchField(Id, Value, Settings, Profile, Location, Identify);
      when E.Element.TextArea(
        const Id: string,
        const Value: string,
        _,
        const Settings: TextAreas.Options,
        _
      ):
        EditorRules.CheckTextArea(Id, Value, Settings, Profile, Location, Identify);
      when E.Element.TagInput(
        const Id: string,
        const Tags: array of string,
        _,
        const Settings: TagInputs.Options
      ):
        const Path: string := Location + '/tagInput';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        TagRules.Check(Tags, Settings, At);
        for Index: int := 0 to Tags.Length - 1 do
          discard Identify(TagInputs.RemoveId(Id, Index), At + '/remove');
        end for;
      when E.Element.OneTimeCodeInput(
        const Id: string,
        const Value: string,
        _,
        const Settings: OneTimeCodes.Options,
        _
      ):
        const Path: string := Location + '/oneTimeCode';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        CodeRules.Check(Value, Settings, Identify(Id, Path));
      when E.Element.PasswordStrengthMeter(const Id: string, const Password: string):
        const Path: string := Location + '/passwordStrength';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        Rules.CheckText(Password, Identify(Id, Path) + '/password');
      when E.Element.Alert(
        const Id: string,
        const Title: string,
        const Settings: Alerts.Options,
        _
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/alert');
        const At: string := Identify(Id, Location + '/alert');
        FeedbackRules.Alert(Title, Settings, At);
        if Settings.Dismissible then
          discard Identify(Alerts.DismissId(Id), At + '/dismiss');
        end if;
      when E.Element.ProgressBar(
        const Id: string,
        const Value: float,
        const Settings: ProgressBars.Options
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/progress');
        FeedbackRules.Progress(Value, Settings, Identify(Id, Location + '/progress'));
      when E.Element.Spinner(const Id: string, const Size: float):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/spinner');
        FeedbackRules.Nonnegative(Size, Identify(Id, Location + '/spinner'));
      when E.Element.Skeleton(const Id: string, const Width: L.Extent, const Height: float):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/skeleton');
        const At: string := Identify(Id, Location + '/skeleton');
        Rules.CheckExtent(Width, Profile, At + '/width');
        case Width of
          when L.Extent.Content:
            Rules.Reject(At, 'A skeleton has no content width; use fill.');
          else
        end case;

        FeedbackRules.Nonnegative(Height, At + '/height');
      when E.Element.TimelineItem(
        const Id: string,
        const Title: string,
        const Settings: Timeline.Options
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/timeline-item');
        FeedbackRules.TimelineItem(Title, Settings, Identify(Id, Location + '/timeline-item'));
      when E.Element.ProgressRing(
        const Id: string, const Label: string, const Value: float, const Size: float
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/progress-ring');
        FeedbackRules.ProgressRing(Label, Value, Size, Identify(Id, Location + '/progress-ring'));
      when E.Element.LevelMeter(
        const Id: string,
        const Peaks: array of float,
        const Settings: Levels.Options,
        _
      ):
        const At: string := Identify(Id, Location + '/levelMeter');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        AudioRules.CheckMeter(Peaks, Settings, At);
      when E.Element.Meter(
        const Id: string, const Label: string, const Used: float,
        const Total: float, const Unit: string
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/meter');
        FeedbackRules.Meter(Label, Used, Total, Unit, Identify(Id, Location + '/meter'));
      when E.Element.ColorPicker(const Id: string, _, _, _):
        const At: string := Identify(Id, Location + '/colorPicker');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        discard Identify(ColorPickers.SurfaceId(Id), At);
        discard Identify(ColorPickers.HueId(Id), At);
        for Index: int := 0 to 7 do
          discard Identify(ColorPickers.PresetId(Id, Index), At);
        end for;
      when E.Element.EmojiPicker(
        const Id: string, const Value: Emojis.State, _, const Settings: Emojis.Options
      ):
        const At: string := Identify(Id, Location + '/emojiPicker');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        PickerRules.Emoji(Value, Settings, At);
        discard Identify(Emojis.GridId(Id), At);
        if Settings.Search then
          discard Identify(Emojis.SearchId(Id), At);
        end if;

        if Settings.ToneSelector then
          discard Identify(Emojis.ToneSelectorId(Id), At);
          for Index: int := 0 to 5 do
            discard Identify(Emojis.ToneId(Id, Index), At);
          end for;
        end if;

        for Index: int := 0 to 9 do
          discard Identify(Emojis.GroupId(Id, Index), At);
        end for;
      when E.Element.Calendar(const Id: string, _, _, _):
        const At: string := Identify(Id, Location + '/calendar');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        discard Identify(Calendars.MonthId(Id, false), At);
        discard Identify(Calendars.MonthId(Id, true), At);
      when E.Element.DatePicker(const Id: string, _, _, const Settings: DatePickers.Options):
        const At: string := Identify(Id, Location + '/datePicker');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Rules.CheckText(Settings.Label, At + '/label');
        Rules.CheckText(Settings.Placeholder, At + '/placeholder');
        PickerRules.Size(Settings.Width, At + '/width');
        discard Identify(Calendars.MonthId(Id, false), At);
        discard Identify(Calendars.MonthId(Id, true), At);
      when E.Element.RangeCalendar(
        const Id: string,
        const Value: Dates.Value,
        _,
        const Months: int,
        _
      ):
        const Path: string := Location + '/rangeCalendar';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        DateRangeRules.Check(Value, At);
        if Months < 1 or Months > 2 then
          Rules.Reject(At, 'A range calendar shows one or two months.');
        end if;

        discard Identify(Dates.MonthId(Id, false), At);
        discard Identify(Dates.MonthId(Id, true), At);
      when E.Element.RangePicker(
        const Id: string, const Value: Dates.Value, _, const Settings: RangePickers.Options
      ):
        const Path: string := Location + '/rangePicker';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        DateRangeRules.Check(Value, At);
        DateRangeRules.Picker(Settings, At);
        discard Identify(Dates.MonthId(Id, false), At);
        discard Identify(Dates.MonthId(Id, true), At);
        if Settings.Presets then
          for Index: int := 0 to 6 do
            discard Identify(RangePickers.PresetId(Id, Index), At);
          end for;
        end if;
      when E.Element.TimePicker(
        const Id: string, const Value: Sys.TimeOnly, _, const Settings: TimePickers.Options
      ):
        const Path: string := Location + '/timePicker';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        PickerRules.Time(Value, At);
        PickerRules.TimePicker(Settings, At);

        const LastHour: int := if Settings.TwelveHour then
          11
        else
          23
        end if;
        for Hour: int := 0 to LastHour do
          discard Identify(TimePickers.HourId(Id, Hour), At);
        end for;

        for Minute: int := 0 to 59 do
          if Minute mod Settings.MinuteStep = 0 then
            discard Identify(TimePickers.MinuteId(Id, Minute), At);
          end if;
        end for;

        if Settings.TwelveHour then
          discard Identify(TimePickers.PeriodId(Id, false), At);
          discard Identify(TimePickers.PeriodId(Id, true), At);
        end if;
      when E.Element.WheelPicker(
        const Id: string,
        const Items: array of string,
        const Selected: int,
        _,
        const Settings: WheelPickers.Options
      ):
        const Path: string := Location + '/wheelPicker';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        PickerRules.WheelPicker(Items, Selected, Settings, Identify(Id, Path));
      when E.Element.TimeDial(const Id: string, const Value: Sys.TimeOnly, _, const Size: float, _):
        const Path: string := Location + '/timeDial';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        PickerRules.Time(Value, At);
        PickerRules.Size(Size, At + '/size');
        discard Identify(TimeDials.SelectorId(Id, false), At);
        discard Identify(TimeDials.SelectorId(Id, true), At);
        discard Identify(TimeDials.FaceId(Id), At);
      when E.Element.MultiSelectInput(
        const Id: string, const Items: array of Selects.Item, const Selected: array of bool,
        _, const Settings: Multi.Options
      ):
        const Path: string := Location + '/multiSelect';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        SelectRules.MultiSelect(Items, Selected, Settings, At);
        for Index: int := 0 to Items.Length - 1 do
          discard Identify(Selects.OptionId(Id, Index), At + '/option');
        end for;
      when E.Element.SelectInput(
        const Id: string,
        const Items: array of Selects.Item,
        const Selected: int,
        _,
        const Settings: Selects.Options
      ):
        const Path: string := Location + '/select';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        SelectRules.Check(Items, Selected, Settings, At);
        for Index: int := 0 to Items.Length - 1 do
          discard Identify(Selects.OptionId(Id, Index), At + '/option');
        end for;
      when E.Element.NumberField(
        const Id: string, const Value: double, const Minimum: double, const Maximum: double, _,
        const Settings: NumberFields.Options
      ):
        const Path: string := Location + '/numberField';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        NumberRules.Check(Value, Minimum, Maximum, Settings, At);
        discard Identify(NumberFields.DecreaseId(Id), At + '/decrease');
        discard Identify(NumberFields.IncreaseId(Id), At + '/increase');
      when E.Element.Contextual(
        const Id: string,
        const Child: E.Element<TMsg>,
        const Entries: array of Menus.Entry<TMsg>,
        _
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/contextMenu');
        MenuRules.Check<TMsg>(Id, 'Context menu', Entries, null, Location, Identify);
        Visit(Child, Location + '/target');
      when E.Element.Hinted(
        const Child: E.Element<TMsg>,
        const Caption: string,
        const Shortcut: string
      ):
        const At: string := Location + '/tooltip';
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Visit(Child, At + '/target');
        TooltipRules.Check<TMsg>(Child, Caption, Shortcut, Subviews, At);
      when E.Element.Accordion(
        const Id: string,
        const Title: string,
        _,
        _,
        const Content: E.Element<TMsg>,
        _
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/accordion');
        const At: string := Identify(Id, Location + '/accordion');
        DisclosureRules.Header(Title, new ExpandableCards.Options(), At);
        Visit(Content, At + '/content');
      when E.Element.ExpandableCard(
        const Id: string,
        const Title: string,
        _,
        _,
        const Content: E.Element<TMsg>,
        const Settings: ExpandableCards.Options
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/expandableCard');
        const At: string := Identify(Id, Location + '/expandableCard');
        DisclosureRules.Header(Title, Settings, At);
        Visit(Content, At + '/content');
      when E.Element.ExpandableText(
        const Id: string,
        const Value: string,
        const Settings: ExpandableTexts.Options,
        _
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/expandableText');
        const At: string := Identify(Id, Location + '/expandableText');
        discard Identify(ExpandableTexts.ToggleId(Id), At + '/toggle');
        DisclosureRules.Text(Value, Settings, At);
      when E.Element.LinkAction(const Id: string, const Label: string, _, _):
        const At: string := Identify(Id, Location + '/link');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Rules.CheckText(Label, At + '/label');
        if Sys.String.IsNullOrWhiteSpace(Label) then
          Rules.Reject(At, 'A link needs a caption.');
        end if;
      when E.Element.Avatar(const Id: string, const Name: string, const Settings: Avatars.Options):
        const At: string := Identify(Id, Location + '/avatar');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Rules.CheckText(Name, At + '/name');
        Rules.CheckText(Settings.Status, At + '/status');
        const Path: string? := Settings.ImagePath;
        if Path <> null then
          Rules.CheckText(Path, At + '/image');
        end if;

        if not Sys.Single.IsFinite(Settings.Size) or Settings.Size < 0.0F then
          Rules.Reject(At, 'Avatar size must be finite and nonnegative.');
        end if;
      when E.Element.HoverCard(
        const Id: string,
        const Trigger: E.Element<TMsg>,
        const Content: E.Element<TMsg>,
        const Settings: HoverCards.Options
      ):
        const At: string := Identify(Id, Location + '/hoverCard');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        if not Sys.Single.IsFinite(Settings.Width) or Settings.Width < 0.0F
          or not Sys.Single.IsFinite(Settings.Delay) or Settings.Delay < 0.0F
          or not Sys.Enum.IsDefined<Menus.Placement>(Settings.Position)
        then
          Rules.Reject(
            At,
            'A hover card needs a finite nonnegative width and delay and a valid placement.'
          );
        end if;

        Visit(Trigger, At + '/trigger');
        if not TooltipRules.HasAnchor<TMsg>(Trigger, Subviews) then
          Rules.Reject(At, 'A hover card needs one interactive trigger.');
        end if;

        HoverDepth := HoverDepth + 1;
        Visit(Content, At + '/content');
        HoverDepth := HoverDepth - 1;
      when E.Element.Popover(
        const Id: string, const Trigger: E.Element<TMsg>, const Content: E.Element<TMsg>, _, _,
        const Settings: Popovers.Options
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/popover');
        const At: string := Identify(Id, Location + '/popover');
        PopupRules.CheckPanel(Settings, At);
        PopupRules.CheckTrigger<TMsg>(Trigger, At);
        Visit(Trigger, At + '/trigger');
        Visit(Content, At + '/content');
      when E.Element.ConfirmPopover(
        const Id: string,
        const Trigger: E.Element<TMsg>,
        _,
        const Settings: ConfirmPopovers.Options,
        _,
        _
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/confirmPopover');
        const At: string := Identify(Id, Location + '/confirmPopover');
        discard Identify(ConfirmPopovers.CancelId(Id), At + '/cancel');
        discard Identify(ConfirmPopovers.ConfirmId(Id), At + '/confirm');
        PopupRules.CheckQuestion(Settings, At);
        PopupRules.CheckTrigger<TMsg>(Trigger, At);
        Visit(Trigger, At + '/trigger');
      when E.Element.ReactionGroup(const Id: string, const Items: array of Reactions.Item, _, _):
        const Path: string := Location + '/reactions';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        if Items.Length = 0 then
          Rules.Reject(At, 'A reaction group needs at least one item.');
        end if;

        for Index: int := 0 to Items.Length - 1 do
          const Item: Reactions.Item := Items[Index];
          const Part: string := Identify(Reactions.ItemId(Id, Index), At + '/item');
          Rules.CheckText(Item.Label, Part + '/label');
          Rules.CheckText(Item.Icon, Part + '/icon');
          if Sys.String.IsNullOrWhiteSpace(Item.Label) or Item.Label.Contains(#10)
            or Item.Label.Contains(#13) or Item.Icon = ''
            or Item.Count < 0 or (not Item.Active and Item.Count = int.MaxValue)
          then
            Rules.Reject(Part, 'A reaction needs a single-line name, an icon and a valid count.');
          end if;
        end for;
      when E.Element.SpeedDialAction(
        const Id: string, const Items: array of Speed.Item, _, const Settings: Speed.Options
      ):
        const Path: string := Location + '/speedDial';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        ActionRules.SpeedDial(Items, Settings, At);
        for Index: int := 0 to Items.Length - 1 do
          discard Identify(Speed.ItemId(Id, Index), At + '/action');
        end for;
      when E.Element.SwipeRow(
        const Id: string, const Child: E.Element<TMsg>, const Left: array of Swipe.Item,
        const Right: array of Swipe.Item, _, const Settings: Swipe.Options
      ):
        const Path: string := Location + '/swipeRow';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        ActionRules.SwipeRow(Left, Right, Settings, At);
        for Index: int := 0 to Left.Length - 1 do
          discard Identify(Swipe.ItemId(Id, Swipe.Side.Left, Index), At);
        end for;

        for Index: int := 0 to Right.Length - 1 do
          discard Identify(Swipe.ItemId(Id, Swipe.Side.Right, Index), At);
        end for;

        Visit(Child, At + '/content');
      when E.Element.AccountMenu(
        const Id: string, const Name: string, const Entries: array of Menus.Entry<TMsg>,
        const Settings: UserMenus.Options
      ):
        const Path: string := Location + '/userMenu';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        MenuRules.Check<TMsg>(Id, Name, Entries, null, Path, Identify);
        Rules.CheckText(Settings.Detail, Path + '/detail');
        Rules.CheckText(Settings.Status, Path + '/status');
        if Settings.Detail.Contains(#10) or Settings.Detail.Contains(#13)
          or not Sys.Enum.IsDefined<Menus.Placement>(Settings.Position)
          or not Sys.Single.IsFinite(Settings.Width) or Settings.Width < 0.0
        then
          Rules.Reject(
            Path,
            'A user menu needs single-line detail, a CUI placement and finite nonnegative width.'
          );
        end if;
      when E.Element.Dropdown(
        const Id: string,
        const Label: string,
        const Entries: array of Menus.Entry<TMsg>,
        const Settings: Menus.Options
      ):
        MenuRules.Check<TMsg>(Id, Label, Entries, Settings, Location, Identify);
      when E.Element.Label(const Value: string):
        Rules.CheckText(Value, Location + '/text');
      when E.Element.CheckboxAction(
        const Id: string,
        const Label: string,
        _,
        _,
        const Description: string,
        _,
        _
      ), E.Element.SwitchAction(
        const Id: string,
        const Label: string,
        _,
        _,
        const Description: string,
        _
      ), E.Element.RadioAction(
        const Id: string,
        const Label: string,
        _,
        _,
        const Description: string,
        _
      ):
        SelectionRules.CheckRow(Id, Label, Description, Profile, Location + '/selection', Identify);
      when E.Element.Radios(
        const Id: string,
        const Items: array of RadioGroups.Item,
        const Selected: int,
        _,
        _,
        const Gap: L.Spacing
      ):
        SelectionRules.CheckGroup(Id, Items, Selected, Gap, Profile, Location, Identify);
      when E.Element.Cards(
        const Id: string,
        const Items: array of RadioCards.Item,
        const Selected: int,
        _,
        const Settings: RadioCards.Options
      ):
        SelectionRules.CheckCards(
          Id,
          Items,
          Selected,
          Settings.Columns,
          Profile,
          Location,
          Identify
        );
      when E.Element.SliderAction(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, _, const Settings: Sliders.Options
      ):
        const At: string := Identify(Id, Location + '/slider');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SliderRules.Check(Label, Value, Value, Minimum, Maximum, At);
        SliderRules.CheckOptions(Settings, Maximum - Minimum, At);
      when E.Element.RangeSliderAction(
        const Id: string, const Label: string, const Value: RangeSliders.Interval,
        const Minimum: float, const Maximum: float, _, _
      ):
        const At: string := Identify(Id, Location + '/rangeSlider');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SliderRules.Check(Label, Value.Lower, Value.Upper, Minimum, Maximum, At);
      when E.Element.Banner(
        const Id: string, const Announcement: string, _, const Dismiss: Sys.Func<TMsg>?,
        const Action: Sys.Func<TMsg>?, const Settings: Banners.Options
      ):
        const At: string := Identify(Id, Location + '/banner');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Rules.CheckText(Announcement, At + '/text');
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.ActionLabel, At + '/action');
        if Sys.String.IsNullOrWhiteSpace(Announcement) or not Sys.Enum.IsDefined<S.Tone>(
          Settings.Tone
        )
        then
          Rules.Reject(At, 'A banner needs nonempty text and a valid tone.');
        end if;

        if (Settings.ActionLabel = '') <> (Action = null) then
          Rules.Reject(At, 'A banner action needs a caption and a message factory.');
        end if;

        if Action <> null then
          discard Identify(Banners.ActionId(Id), At);
        end if;

        if Dismiss <> null then
          discard Identify(Banners.DismissId(Id), At);
        end if;
      when E.Element.Countdown(const Id: string, const Seconds: double, _):
        const At: string := Identify(Id, Location + '/countdown');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        if not Sys.Double.IsFinite(Seconds) or Seconds > 7730941132799.0 then
          Rules.Reject(At, 'Countdown seconds must be finite and fit the native hours tile.');
        end if;
      when E.Element.Checklist(
        const Id: string,
        const Steps: array of Checklists.Step,
        _,
        const Action: Sys.Func<int, TMsg>?,
        const Settings: Checklists.Options
      ):
        const At: string := Identify(Id, Location + '/checklist');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Rules.CheckText(Settings.Title, At + '/title');
        Rules.CheckText(Settings.Description, At + '/description');
        for Index: int := 0 to Steps.Length - 1 do
          const Step: Checklists.Step := Steps[Index];
          const StepAt: string := Identify(Checklists.StepId(Id, Index), At);
          Rules.CheckText(Step.Title, StepAt + '/title');
          Rules.CheckText(Step.Description, StepAt + '/description');
          Rules.CheckText(Step.ActionLabel, StepAt + '/action');
          if Sys.String.IsNullOrWhiteSpace(Step.Title) then
            Rules.Reject(StepAt, 'A checklist step needs a title.');
          end if;

          if Step.ActionLabel <> '' then
            if Action = null then
              Rules.Reject(StepAt, 'A checklist action needs a message callback.');
            end if;

            discard Identify(Checklists.ActionId(Id, Index), StepAt);
          end if;
        end for;
      when E.Element.Dropzone(const Id: string, _, _, const Settings: Dropzones.Options):
        const At: string := Identify(Id, Location + '/dropzone');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Rules.CheckText(Settings.Title, At + '/title');
        Rules.CheckText(Settings.Description, At + '/description');
        Rules.CheckText(Settings.Accept, At + '/accept');
        Rules.CheckText(Settings.Icon, At + '/icon');
        if not Sys.Single.IsFinite(Settings.Height) or Settings.Height < 0.0F then
          Rules.Reject(At, 'Dropzone height must be finite and nonnegative.');
        end if;
      when E.Element.AvatarUpload(
        const Id: string,
        const Name: string,
        const Path: string?,
        _,
        _,
        const Size: float,
        _
      ):
        const At: string := Identify(Id, Location + '/avatarUpload');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Rules.CheckText(Name, At + '/name');
        if Path <> null then
          Rules.CheckText(Path, At + '/image');
        end if;

        if not Sys.Single.IsFinite(Size) or Size < 0.0F then
          Rules.Reject(At, 'Avatar diameter must be finite and nonnegative.');
        end if;
      when E.Element.SignaturePad(const Id: string, _, const Settings: Signatures.Options):
        const At: string := Identify(Id, Location + '/signaturePad');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        discard Identify(Signatures.ClearId(Id), At);
        Rules.CheckText(Settings.Placeholder, At + '/placeholder');
        if not Sys.Single.IsFinite(Settings.Height) or Settings.Height < 0.0F then
          Rules.Reject(At, 'Signature pad height must be finite and nonnegative.');
        end if;
      when E.Element.Knob(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, _, const Settings: Knobs.Options
      ):
        const At: string := Identify(Id, Location + '/knob');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SliderRules.Check(Label, Value, Value, Minimum, Maximum, At);
        AudioRules.CheckDial(
          Settings.Step,
          Settings.Reset,
          Settings.DecimalPlaces,
          Settings.UnitLabel,
          Maximum - Minimum,
          At
        );
        AudioRules.CheckKnob(Settings.Size, Settings.LogScale, Minimum, Maximum, At);
      when E.Element.Fader(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, _, const Settings: Faders.Options
      ):
        const At: string := Identify(Id, Location + '/fader');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SliderRules.Check(Label, Value, Value, Minimum, Maximum, At);
        AudioRules.CheckDial(
          Settings.Step,
          Settings.Reset,
          Settings.DecimalPlaces,
          Settings.UnitLabel,
          Maximum - Minimum,
          At
        );
        AudioRules.CheckFader(
          Settings.Length,
          Settings.Ticks,
          Settings.Levels,
          Minimum,
          Maximum,
          At
        );
      when E.Element.RulerSlider(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, _, const Settings: Rulers.Options
      ):
        const At: string := Identify(Id, Location + '/rulerSlider');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SliderRules.Check(Label, Value, Value, Minimum, Maximum, At);
        SliderRules.CheckRuler(Settings, Minimum, Maximum, At);
      when E.Element.HistogramSlider(
        const Id: string, const Label: string, const Bins: array of float,
        const Value: RangeSliders.Interval, const Minimum: float, const Maximum: float,
        _, const Settings: Histograms.Options
      ):
        const At: string := Identify(Id, Location + '/histogramSlider');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SliderRules.Check(Label, Value.Lower, Value.Upper, Minimum, Maximum, At);
        SliderRules.CheckHistogram(Bins, Settings, At);
      when E.Element.ChipAction(const Id: string, const Label: string, _, _, const Icon: string, _):
        SelectionRules.CheckRow(Id, Label, '', Profile, Location + '/chip', Identify);
        Rules.CheckText(Icon, Location + '/chip/icon');
      when E.Element.RatingAction(
        const Id: string,
        const Label: string,
        const Value: int,
        _,
        const Maximum: int,
        _
      ):
        SelectionRules.CheckRow(Id, Label, '', Profile, Location + '/rating', Identify);
        if Maximum < 1 or Maximum > 16 or Value < 0 or Value > Maximum then
          Rules.Reject(
            Location + '/rating',
            'Rating needs one through sixteen stars and a value within that range or zero.'
          );
        end if;
      when E.Element.TabStrip(
        const Id: string,
        const Items: array of Tabs.Item,
        const Selected: int,
        _,
        const Settings: Tabs.Options
      ):
        NavigationRules.CheckTabs(Id, Items, Selected, Settings, Profile, Location, Identify);
      when E.Element.BreadcrumbTrail(const Id: string, const Items: array of string, _, _):
        NavigationRules.CheckBreadcrumb(Id, Items, Profile, Location, Identify);
      when E.Element.PaginationAction(const Id: string, const Page: int, const Count: int, _, _):
        const At: string := Identify(Id, Location + '/pagination');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        if Count < 1 or Page < 0 or Page >= Count then
          Rules.Reject(At, 'Pagination needs a positive page count and a valid page index.');
        end if;
      when E.Element.StepProgress(
        const Id: string,
        const Steps: array of string,
        const Current: int
      ):
        NavigationRules.CheckStepper(Steps, Current, Profile, Identify(Id, Location + '/stepper'));
      when E.Element.Separator(const Title: string):
        Rules.CheckText(Title, Location + '/divider');
      when E.Element.ButtonAction(
        const Id: string,
        const Label: string,
        _,
        const Settings: B.Options
      ):
        const At: string := Identify(Id, Location + '/button');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.IconRight, At + '/iconRight');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        Rules.CheckText(Settings.TerminalIconRight, At + '/terminalIconRight');
        Rules.CheckText(Settings.Tooltip, At + '/tooltip');
        Rules.CheckText(Settings.Shortcut, At + '/shortcut');
        if not Sys.Enum.IsDefined<S.ButtonVariant>(Settings.Variant)
          or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(At, 'Unknown button variant or size.');
        end if;

        Rules.CheckExtent(Settings.Width, Profile, At + '/width');
      when E.Element.IconAction(
        const Id: string,
        const Icon: string,
        const Tooltip: string,
        _,
        const Settings: Icons.Options
      ):
        const At: string := Identify(Id, Location + '/iconButton');
        Rules.CheckText(Icon, At + '/icon');
        Rules.CheckText(Tooltip, At + '/tooltip');
        Rules.CheckText(Settings.Shortcut, At + '/shortcut');
        Rules.CheckText(Settings.TerminalGlyph, At + '/terminalGlyph');
        if Sys.String.IsNullOrWhiteSpace(Icon) or Sys.String.IsNullOrWhiteSpace(Tooltip) then
          Rules.Reject(At, 'An icon button needs an icon and a tooltip.');
        end if;

        if not Sys.Enum.IsDefined<S.ButtonVariant>(Settings.Variant)
          or not Sys.Enum.IsDefined<Icons.Size>(Settings.ControlSize)
        then
          Rules.Reject(At, 'Unknown icon button variant or size.');
        end if;
      when E.Element.CopyAction(const Id: string, const Value: string, _, _):
        Rules.CheckText(Value, Identify(Id, Location + '/copyButton') + '/text');
      when E.Element.HoldAction(
        const Id: string,
        const Label: string,
        _,
        const Settings: Holds.Options
      ):
        const At: string := Identify(Id, Location + '/holdButton');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        if Settings.DurationMilliseconds <= 0 or Settings.Variant = S.ButtonVariant.Active
          or not Sys.Enum.IsDefined<S.ButtonVariant>(
          Settings.Variant
        )
        then
          Rules.Reject(At, 'A hold button needs a positive duration and a CUI button variant.');
        end if;
      when E.Element.ConfirmAction(
        const Id: string,
        const Label: string,
        _,
        const Settings: Confirms.Options
      ):
        const At: string := Identify(Id, Location + '/confirmButton');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.ConfirmLabel, At + '/confirmLabel');
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        if Settings.TimeoutMilliseconds <= 0 or Settings.Variant = S.ButtonVariant.Active
          or not Sys.Enum.IsDefined<S.ButtonVariant>(Settings.Variant)
          or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(
            At,
            'A confirm button needs a positive timeout and a valid button variant and size.'
          );
        end if;
      when E.Element.StatusAction(
        const Id: string,
        const Label: string,
        const State: Status.Status,
        _,
        const Settings: Status.Options
      ):
        const At: string := Identify(Id, Location + '/statusButton');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.SuccessLabel, At + '/successLabel');
        Rules.CheckText(Settings.ErrorLabel, At + '/errorLabel');
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        const Busy: string? := Settings.BusyLabel;
        if Busy <> null then
          Rules.CheckText(Busy, At + '/busyLabel');
        end if;

        if not Sys.Enum.IsDefined<Status.Status>(State)
          or not Sys.Enum.IsDefined<S.ButtonVariant>(Settings.Variant)
          or Settings.Variant = S.ButtonVariant.Active
          or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(At, 'A status button needs a valid work state, button variant and size.');
        end if;
      when E.Element.Segments(
        const Id: string,
        const Items: array of Segmented.Item,
        const Selected: int,
        _,
        const Settings: Segmented.Options
      ):
        const At: string := Identify(Id, Location + '/segmented');
        if Items.Length < 1 or Items.Length > 32 or Selected < 0 or Selected >= Items.Length
          or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(
            At,
            'A segmented control needs one through 32 choices, a selected index and a valid size.'
          );
        end if;

        for Index: int := 0 to Items.Length - 1 do
          const Item: Segmented.Item := Items[Index];
          discard Identify(Segmented.ItemId(Id, Index), At + '/item');
          Rules.CheckText(Item.Label, At + '/label');
          Rules.CheckText(Item.Icon, At + '/icon');
          Rules.CheckText(Item.TerminalIcon, At + '/terminalIcon');
          if Item.Label = '' or Item.Label.Contains(#10) or Item.Label.Contains(#13)
            or (Item.IconOnly and Item.Icon = '')
          then
            Rules.Reject(
              At,
              'A segment needs a single-line accessible label; icon-only choices also need an icon.'
            );
          end if;
        end for;
      when E.Element.Toggles(
        const Id: string, const Items: array of ToggleGroups.Item,
        const Selected: array of bool, _, const Settings: ToggleGroups.Options
      ):
        const At: string := Identify(Id, Location + '/toggleGroup');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        ToggleGroupRules.Check(Items, Selected, Settings, At);
        for Index: int := 0 to Items.Length - 1 do
          discard Identify(ToggleGroups.ItemId(Id, Index), At + '/item');
        end for;
      when E.Element.ThemeFlip(const Id: string, const Appearance: Themes.Mode, _, _):
        const At: string := Identify(Id, Location + '/themeToggle');
        if not Sys.Enum.IsDefined<Themes.Mode>(Appearance) then
          Rules.Reject(At, 'A theme toggle needs a concrete Light or Dark appearance.');
        end if;
      when E.Element.ThemeChoice(
        const Id: string,
        const Selected: ThemeSwitchers.Selection,
        _,
        const Settings: ThemeSwitchers.Options
      ):
        const At: string := Identify(Id, Location + '/themeSwitcher');
        if not Sys.Enum.IsDefined<ThemeSwitchers.Selection>(Selected)
          or (Selected = ThemeSwitchers.Selection.System and not Settings.WithSystem)
        then
          Rules.Reject(At, 'A theme selector needs an available Light, Dark or System choice.');
        end if;

        for Index: int := 0 to (if Settings.WithSystem then
          2
        else
          1
        end if) do
          discard Identify(
            ThemeSwitchers.ItemId(Id, cast<ThemeSwitchers.Selection>(Index)),
            At + '/item'
          );
        end for;
      when E.Element.ButtonGroup(const Children: array of E.Element<TMsg>):
        for Index: int := 0 to Children.Length - 1 do
          const Child: E.Element<TMsg> := Children[Index];
          const At: string := Location + '/buttonGroup[' + Index.ToString() + ']';
          if not TooltipRules.IsButton<TMsg>(Child) then
            Rules.Reject(At, 'A button group accepts only button actions.');
          end if;

          Visit(Child, At);
        end for;
      when E.Element.SplitAction(
        const Id: string,
        const Label: string,
        _,
        const Items: array of Split.Item<TMsg>,
        const Settings: Split.Options
      ):
        const At: string := Identify(Id, Location + '/splitButton');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        discard Identify(Split.MenuId(Id), At + '/menu');
        if Items.Length = 0 or Settings.Variant = S.ButtonVariant.Active
          or not Sys.Enum.IsDefined<S.ButtonVariant>(
          Settings.Variant
        ) or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(At, 'A split button needs menu items, a CUI variant and a known size.');
        end if;

        for Item: Split.Item<TMsg> in Items do
          if Sys.String.IsNullOrWhiteSpace(Item.Key) then
            Rules.Reject(At, 'Menu item keys must be nonempty.');
          end if;
          const Entry: string := Identify(Split.ItemId(Id, Item.Key), At + '/item');
          Rules.CheckText(Item.Label, Entry + '/label');
          Rules.CheckText(Item.Icon, Entry + '/icon');
          Rules.CheckText(Item.TerminalIcon, Entry + '/terminalIcon');
        end for;
      when E.Element.Sidebar(
        const Id: string,
        const Sections: array of N.Section<TMsg>,
        const Active: string?,
        _
      ):
        const At: string := Identify(Id, Location + '/sidebar');
        const Keys: Generic.HashSet<string> := new Generic.HashSet<string>();
        for Section: N.Section<TMsg> in Sections do
          Rules.CheckText(Section.Title, At + '/heading');
          for Item: N.Item<TMsg> in Section.Items do
            Rules.CheckKey(Keys, Item.Key, At);
            const ItemAt: string := Identify(N.ItemId(Id, Item.Key), At + '/item');
            Rules.CheckText(Item.Label, ItemAt);
            Rules.CheckText(Item.Icon, ItemAt + '/icon');
            Rules.CheckText(Item.Badge, ItemAt + '/badge');
          end for;
        end for;

        Rules.CheckSelected(Keys, Active, At);
      when E.Element.Grid(const Settings: Grids.Options, const Children: array of E.Element<TMsg>):
        const At: string := Location + '/grid';
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SurfaceRules.Grid(Settings, At);
        for Index: int := 0 to Children.Length - 1 do
          Visit(Children[Index], At + '[' + Index.ToString() + ']');
        end for;
      when E.Element.Card(
        const Id: string, const Children: array of E.Element<TMsg>, const Settings: Cards.Options, _
      ):
        const At: string := Identify(Id, Location + '/card');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SurfaceRules.Card(Settings, At);
        for Index: int := 0 to Children.Length - 1 do
          Visit(Children[Index], At + '[' + Index.ToString() + ']');
        end for;
      when E.Element.Badge(const Id: string, const Caption: string, const Settings: Badges.Options):
        const At: string := Identify(Id, Location + '/badge');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SurfaceRules.Badge(Caption, Settings, At);
      when E.Element.Metric(
        const Id: string,
        const Label: string,
        const Reading: string,
        const Settings: Metrics.Options
      ):
        const At: string := Identify(Id, Location + '/metric');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SurfaceRules.Metric(Label, Reading, Settings, At);
      when E.Element.AvatarGroup(
        const Id: string,
        const Names: array of string,
        const Settings: AvatarGroups.Options
      ):
        const At: string := Identify(Id, Location + '/avatarGroup');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SurfaceRules.AvatarGroup(Names, Settings, At);
      when E.Element.EmptyState(
        const Id: string,
        const Title: string,
        const Settings: EmptyStates.Options,
        const Action: Sys.Func<TMsg>?
      ):
        const At: string := Identify(Id, Location + '/emptyState');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SurfaceRules.EmptyState(Title, Settings, Action <> null, At);
        if Action <> null then
          discard Identify(EmptyStates.ActionId(Id), At + '/action');
        end if;
      when E.Element.Stack(
        const Children: array of E.Element<TMsg>,
        const Horizontal: bool,
        const Flow: L.Flow
      ):
        const At: string := Location + (if Horizontal then
          '/row'
        else
          '/column'
        end if);
        if Flow.Clip <> null then
          Rules.RequireProfile(Profile, Target.Graphical, Location + '/clip');
        end if;

        if Flow.Wrap then
          Rules.RequireProfile(Profile, Target.Graphical, At);
          if not Horizontal then
            Rules.Reject(At, 'Wrapping requires a row.');
          end if;
        end if;

        if not Sys.Enum.IsDefined<L.Alignment>(Flow.Align) then
          Rules.Reject(At, 'Unknown cross-axis alignment.');
        end if;

        if not Sys.Enum.IsDefined<L.Justification>(Flow.Justify) then
          Rules.Reject(At, 'Unknown main-axis justification.');
        end if;

        if Flow.Justify <> L.Justification.Start then
          Rules.RequireProfile(Profile, Target.Graphical, At + '/justify');
        end if;

        Rules.CheckSpacing(Flow.Gap, Profile, At + '/gap');
        Rules.CheckSpacing(Flow.Padding, Profile, At + '/padding');
        for Index: int := 0 to Children.Length - 1 do
          Visit(Children[Index], At + '[' + Index.ToString() + ']');
        end for;
      when E.Element.Sized(const Child: E.Element<TMsg>, const Flex: L.Flex):
        Rules.CheckFlex(Flex, Profile, Location + '/size');
        Visit(Child, Location + '/size');
      when E.Element.Styled(const Child: E.Element<TMsg>, const Role: S.Role):
        if not Sys.Enum.IsDefined<S.Role>(Role) then
          Rules.Reject(Location + '/style', 'Unknown semantic style role.');
        end if;

        if Role = S.Role.Label or Role = S.Role.Caption or Role = S.Role.DisplayValue
          or Role = S.Role.Strong or Role = S.Role.MutedGlyph or Role = S.Role.SectionTitle
          or Role = S.Role.DisplayTitle or Role = S.Role.Introduction
        then
          Rules.RequireProfile(Profile, Target.Graphical, Location + '/style');
        end if;

        Visit(Child, Location + '/style');
      when E.Element.Framed(const Child: E.Element<TMsg>, const Title: string):
        Rules.CheckText(Title, Location + '/border');
        Visit(Child, Location + '/border');
      when E.Element.TableOfContents(
        const Id: string, const ScrollId: string, const Items: array of Toc.Item, _, _
      ):
        const At: string := Identify(Id, Location + '/tableOfContents');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Rules.CheckText(ScrollId, At + '/scrollId');
        if Items.Length < 1 or Items.Length > 64 then
          Rules.Reject(At, 'A table of contents needs one to 64 entries.');
        end if;

        if not TocTargets.TryAdd(ScrollId, Items) then
          Rules.Reject(At, 'Each scroll viewport can have only one table of contents.');
        end if;

        const Seen: Generic.HashSet<string> := new Generic.HashSet<string>();
        for Index: int := 0 to Items.Length - 1 do
          const Entry: Toc.Item := Items[Index];
          const Row: string := Identify(Toc.ItemId(Id, Index), At);
          Rules.CheckText(Entry.Title, Row + '/title');
          Rules.CheckText(Entry.Anchor, Row + '/anchor');
          if Sys.String.IsNullOrWhiteSpace(Entry.Title) or Entry.Level < 0 or Entry.Level > 4 then
            Rules.Reject(Row, 'An outline entry needs a title and a level from zero through four.');
          end if;

          if not Seen.Add(Entry.Anchor) then
            Rules.Reject(Row, 'An anchor can occur only once in an outline.');
          end if;
        end for;
      when E.Element.ScrollAnchor(const Id: string):
        const At: string := Identify(Id, Location + '/scrollAnchor');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        case ScrollOwner of
          when is string as Owner:
            AnchorOwners.Add(Id, Owner);
          else
            Rules.Reject(At, 'A scroll anchor needs an enclosing scroll viewport.');
        end case;
      when E.Element.Scroll(
        const Id: string, const Child: E.Element<TMsg>, const Position: L.ScrollPosition?,
        const OnScroll: Sys.Func<L.ScrollChange, TMsg>?, _, const FadeEdges: bool
      ):
        const At: string := Identify(Id, Location + '/scroll');
        if FadeEdges then
          Rules.RequireProfile(Profile, Target.Graphical, At);
        end if;

        if Position = null then
          discard UncontrolledScrolls.Add(Id);
        end if;

        if (Position = null) <> (OnScroll = null) then
          Rules.Reject(At, 'Controlled scrolling needs a position and a callback.');
        end if;

        if Position <> null then
          case Position of
            when L.ScrollPosition.Offset(const Offset: L.Measure):
              discard Rules.CheckMeasure(Offset, Profile, At + '/offset');
            else
          end case;
        end if;

        const ParentScroll: string? := ScrollOwner;
        ScrollOwner := Id;
        Visit(Child, At);
        ScrollOwner := ParentScroll;
      when E.Element.Sheet(
        const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>, _,
        const Settings: Sheets.Options, _
      ):
        if HoverDepth > 0 then
          Rules.Reject(Location, 'Place modal views outside pointer-owned hover card bodies.');
        end if;
        const At: string := Identify(Id, Location + '/sheet');
        discard Identify(Sheets.CloseId(Id), At + '/close');
        Rules.CheckText(Settings.Title, At + '/title');
        Rules.CheckText(Settings.Description, At + '/description');
        const Initial: string? := Settings.InitialFocus;
        if Initial <> null then
          Rules.CheckText(Initial, At + '/initialFocus');
        end if;

        if Settings.Size <= 0 or not Sys.Enum.IsDefined<Sheets.Side>(Settings.Edge) then
          Rules.Reject(At, 'A sheet needs a positive size and a valid edge.');
        end if;

        Visit(Base, At + '/base');
        Visit(Content, At + '/content');
      when E.Element.Deferred(
        const Id: string,
        const Resolve: function(E.CacheEntry<TMsg>?): E.CacheEntry<TMsg>
      ):
        const At: string := Identify(Id, Location + '/subview');
        const Old: E.CacheEntry<TMsg>? := if Previous <> null and Previous.Subviews.ContainsKey(
          Id
        )
        then
          Previous.Subviews[Id]
        else
          null
        end if;
        const Current: E.CacheEntry<TMsg> := Resolve(Old);
        Subviews.Add(Id, Current);
        Visit(Current.Tree, At);
      when E.Element.TerminalStyle(const Child: E.Element<TMsg>, const Colors: T.Style):
        const At: string := Location + '/cellStyle';
        Rules.RequireProfile(Profile, Target.Terminal, At);
        Rules.CheckColor(Colors.Foreground, At);
        Rules.CheckColor(Colors.Background, At);
        Visit(Child, At);
      when E.Element.TerminalScreen(
        const Content: E.Element<TMsg>,
        const Layers: array of E.Element<TMsg>,
        const Shortcuts: array of K.ShortcutBinding<TMsg>
      ):
        Rules.RequireProfile(Profile, Target.Terminal, Location + '/screen');
        CheckShortcuts(Shortcuts, Location);
        Visit(Content, Location + '/content');
        for Layer: E.Element<TMsg> in Layers do
          Visit(Layer, Location + '/layer');
        end for;
      when E.Element.TerminalViewport(
        const Id: string,
        const Build: function(T.Viewport): E.Element<TMsg>
      ):
        const At: string := Identify(Id, Location + '/terminalViewport');
        Rules.RequireProfile(Profile, Target.Terminal, At);
        const Size: T.Viewport? := TerminalSize;
        if Size = null then
          Rules.Reject(At, 'Terminal viewport context is required.');
          return;
        end if;

        if Size.Columns < 1 or Size.Rows < 1 then
          Rules.Reject(At, 'Terminal dimensions must be positive.');
        end if;
        const Content: E.Element<TMsg> := Build(Size);
        Subviews.Add(Id, new E.CacheEntry<TMsg>(Size, Content));
        Visit(Content, At);
    end case;
  end procedure;

  procedure Visit(Node: E.Element<TMsg>?; Location: string);
  begin
    if Node = null then
      raise new Sys.ArgumentException(Location + ' — A view node is missing.');
    end if;

    if not Visiting.Add(Node) then
      Rules.Reject(Location, 'A view cannot contain a cycle.');
    end if;

    try
      CheckNode(Node, Location);
    finally
      discard Visiting.Remove(Node);
    end try;
  end procedure;

  procedure CheckShortcuts(Shortcuts: array of K.ShortcutBinding<TMsg>; Location: string);
  begin
    const Gestures: Generic.HashSet<string> := new Generic.HashSet<string>();
    for Shortcut: K.ShortcutBinding<TMsg> in Shortcuts do
      if not Sys.Enum.IsDefined<K.Key>(
        Shortcut.PressedKey
      ) or (cast<int>(Shortcut.Modifiers) and not 7) <> 0
      then
        Rules.Reject(Location, 'Unknown shortcut key or modifiers.');
      end if;

      if Shortcut.Character <> '' then
        if Shortcut.PressedKey <> K.Key.Unknown or Shortcut.Modifiers <> K.KeyModifiers.None then
          Rules.Reject(Location, 'A character shortcut cannot also bind a named key or modifiers.');
        end if;
        var Scalar: Sys.Text.Rune := new Sys.Text.Rune(0);
        if not Sys.Text.Rune.TryGetRuneAt(
          Shortcut.Character,
          0,
          out Scalar
        ) or Scalar.Utf16SequenceLength <> Shortcut.Character.Length or Sys.Text.Rune.IsControl(
          Scalar
        )
        then
          Rules.Reject(Location, 'A character shortcut needs one printable Unicode scalar.');
        end if;
      elsif Shortcut.PressedKey = K.Key.Unknown then
        Rules.Reject(Location, 'A named shortcut needs a known key.');
      end if;
      const Gesture: string := Shortcut.Character + '/' +
        cast<int>(Shortcut.PressedKey).ToString() + '/' + cast<int>(Shortcut.Modifiers).ToString();
      if not Gestures.Add(Gesture) then
        Rules.Reject(Location, 'Duplicate shortcut binding.');
      end if;
    end for;
  end procedure;
begin
  const Ids: Generic.HashSet<string> := new Generic.HashSet<string>();
  const Visiting: Generic.HashSet<Sys.Object> := new Generic.HashSet<Sys.Object>(
    Generic.ReferenceEqualityComparer.Instance
  );
  const Subviews: Generic.Dictionary<string, E.CacheEntry<TMsg>> := new Generic.Dictionary<string, E.CacheEntry<TMsg>>();
  var HoverDepth: int := 0;
  const UncontrolledScrolls: Generic.HashSet<string> := new Generic.HashSet<string>();
  const AnchorOwners: Generic.Dictionary<string, string> := new Generic.Dictionary<string, string>();
  const TocTargets: Generic.Dictionary<string, array of Toc.Item> := new Generic.Dictionary<string, array of Toc.Item>();
  var ScrollOwner: string? := null;
  Visit(Tree, 'root');
  for TargetEntries: Generic.KeyValuePair<string, array of Toc.Item> in TocTargets do
    const ScrollId: string := TargetEntries.Key;
    if not UncontrolledScrolls.Contains(ScrollId) then
      Rules.Reject('root', 'Table of contents needs an uncontrolled viewport: ' + ScrollId);
    end if;

    for Entry: Toc.Item in TargetEntries.Value do
      var Owner: string := '';
      if not AnchorOwners.TryGetValue(Entry.Anchor, out Owner) or Owner <> ScrollId then
        Rules.Reject('root', 'Anchor ' + Entry.Anchor + ' needs to be inside viewport ' + ScrollId);
      end if;
    end for;
  end for;

  return new Prepared<TMsg>(
    Tree,
    new Collections.ReadOnlyDictionary<string, E.CacheEntry<TMsg>>(Subviews)
  );
end function;

end unit;
