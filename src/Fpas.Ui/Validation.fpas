unit Fpas.Ui.Validation;

uses Fpas.Ui.Selects as Selects, Fpas.Ui.NumberFields as NumberFields, Fpas.Ui.Internal.SelectRules as SelectRules, Fpas.Ui.Internal.NumberFieldRules as NumberRules, Fpas.Ui.TagInputs as TagInputs, Fpas.Ui.OneTimeCodes as OneTimeCodes, Fpas.Ui.Internal.TagInputRules as TagRules, Fpas.Ui.Internal.OneTimeCodeRules as CodeRules, Fpas.Ui.SearchFields as SearchFields, Fpas.Ui.TextAreas as TextAreas, Fpas.Ui.Dialogs as Dialogs, Fpas.Ui.TextFields as TextFields, Fpas.Ui.Internal.EditorRules as EditorRules, Fpas.Ui.Internal.PopoverRules as PopupRules, Fpas.Ui.Popovers as Popovers, Fpas.Ui.ConfirmPopovers as ConfirmPopovers, Fpas.Ui.Internal.TooltipRules as TooltipRules, Fpas.Ui.Internal.NavigationRules as NavigationRules, Fpas.Ui.Tabs as Tabs, Fpas.Ui.RadioCards as RadioCards, Fpas.Ui.Sliders as Sliders, Fpas.Ui.RangeSliders as RangeSliders, Fpas.Ui.Internal.SliderRules as SliderRules, Fpas.Ui.Internal.SelectionRules as SelectionRules, Fpas.Ui.RadioGroups as RadioGroups, Fpas.Ui.ToggleGroups as ToggleGroups, Fpas.Ui.Internal.ToggleGroupRules as ToggleGroupRules, Fpas.Ui.Menus as Menus, Fpas.Ui.Internal.MenuRules as MenuRules, Fpas.Ui.SegmentedControls as Segmented, Fpas.Ui.Themes as Themes, Fpas.Ui.ThemeSwitchers as ThemeSwitchers, Fpas.Ui.StatusButtons as Status, Fpas.Ui.ConfirmButtons as Confirms, Fpas.Ui.SplitButtons as Split, Fpas.Ui.HoldButtons as Holds, Fpas.Ui.Elements as E, Fpas.Ui.Internal.Rules as Rules, Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Layout as L, Fpas.Ui.Navigation as N, Fpas.Ui.Sheets as Sheets, Fpas.Ui.Buttons as B, Fpas.Ui.IconButtons as Icons, Fpas.Ui.Styles as S, Fpas.Ui.Terminal as T, Fpas.Ui.Graphics as G, System as Sys, System.Collections.Generic as Generic, System.Collections.ObjectModel as Collections, System.Text as Text;

// The capability profile to check before a host presents a view.
public type Target = enum: byte
  // Accepts only widgets and options shared by both hosts.
  Portable;
  // Allows cell units and terminal extension nodes.
  Terminal;
  // Allows logical units and graphical extension nodes.
  Graphical;
end enum;

// A validated view and its resolved subtrees.
//
// ## Type parameters
// - `TMsg`: The application message type.
public type Prepared<TMsg> = record
  // The root view. Deferred nodes reference Subviews by ID.
  public Tree: E.Element<TMsg>;
  // The resolved subtrees for this view, including nested deferred nodes.
  public Subviews: Generic.IReadOnlyDictionary<string, E.CacheEntry<TMsg>>;
end record;

// Validates the entire view and resolves deferred subtrees before presentation.
//
// ## Type parameters
// - `TMsg`: The application message type.
//
// ## Parameters
// - `Tree`: The view to check, including all modal layers.
// - `Profile`: The capabilities of the target.
// - `Previous`: The last successfully presented view, if available.
// - `TerminalSize`: Exact dimensions required by terminal viewport subtrees.
//
// ## Returns
// The view and the cache entries that its presenter should use.
public function Prepare<TMsg>(
  Tree: E.Element<TMsg>; Profile: Target; Previous: Prepared<TMsg>? := null; TerminalSize: T.Viewport? := null
): Prepared<TMsg>;
requires Profile = Target.Portable or Profile = Target.Terminal or Profile = Target.Graphical;
  function Identify(Id: string; Location: string): string;
  begin
    if Sys.String.IsNullOrWhiteSpace(Id) then
      Rules.Reject(Location, 'Control and subview IDs must be nonempty.');
    end if;
    const Named: string := Location + '[' + Id + ']';
    Rules.CheckText(Id, Named);
    if not Ids.Add(Id) then
      Rules.Reject(Named, 'Duplicate ID ' + Id + '.');
    end if;

    return Named;
  end function;

  procedure CheckNode(Node: E.Element<TMsg>; Location: string);
  begin
    case Node of
      when E.Element.Dialog(
        const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>,
        _, const Settings: Dialogs.Options, _
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/dialog');
        const At: string := Identify(Id, Location + '/dialog');
        if Settings.CloseButton then
          discard Identify(Dialogs.CloseId(Id), At + '/close');
        end if;

        Rules.CheckText(Settings.Title, At + '/title');
        Rules.CheckText(Settings.Description, At + '/description');
        const Initial: string? := Settings.InitialFocus;
        if Initial <> null then
          Rules.CheckText(Initial, At + '/initialFocus');
        end if;

        if Settings.Width <= 0 then
          Rules.Reject(At, 'A dialog needs a positive width.');
        end if;

        Visit(Base, At + '/base');
        Visit(Content, At + '/content');
      when E.Element.ActionFooter(const Children: array of E.Element<TMsg>):
        const At: string := Location + '/actionFooter';
        Rules.RequireProfile(Profile, Target.Graphical, At);
        for Index: int := 0 to Children.Length - 1 do
          Visit(Children[Index], At + '[' + Index.ToString() + ']');
        end for;
      when E.Element.TextField(
        const Id: string,
        const Value: string,
        _,
        const Settings: TextFields.Options,
        _
      ):
        EditorRules.CheckTextField(Id, Value, Settings, Profile, Location, Identify);
      when E.Element.SearchField(
        const Id: string,
        const Value: string,
        _,
        const Settings: SearchFields.Options,
        _
      ):
        EditorRules.CheckSearchField(Id, Value, Settings, Profile, Location, Identify);
      when E.Element.TextArea(
        const Id: string,
        const Value: string,
        _,
        const Settings: TextAreas.Options,
        _
      ):
        EditorRules.CheckTextArea(Id, Value, Settings, Profile, Location, Identify);
      when E.Element.TagInput(
        const Id: string,
        const Tags: array of string,
        _,
        const Settings: TagInputs.Options
      ):
        const Path: string := Location + '/tagInput';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        TagRules.Check(Tags, Settings, At);
        for Index: int := 0 to Tags.Length - 1 do
          discard Identify(TagInputs.RemoveId(Id, Index), At + '/remove');
        end for;
      when E.Element.OneTimeCodeInput(
        const Id: string,
        const Value: string,
        _,
        const Settings: OneTimeCodes.Options,
        _
      ):
        const Path: string := Location + '/oneTimeCode';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        CodeRules.Check(Value, Settings, Identify(Id, Path));
      when E.Element.PasswordStrengthMeter(const Id: string, const Password: string):
        const Path: string := Location + '/passwordStrength';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        Rules.CheckText(Password, Identify(Id, Path) + '/password');
      when E.Element.SelectInput(
        const Id: string,
        const Items: array of Selects.Item,
        const Selected: int,
        _,
        const Settings: Selects.Options
      ):
        const Path: string := Location + '/select';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        SelectRules.Check(Items, Selected, Settings, At);
        for Index: int := 0 to Items.Length - 1 do
          discard Identify(Selects.OptionId(Id, Index), At + '/option');
        end for;
      when E.Element.NumberField(
        const Id: string, const Value: double, const Minimum: double, const Maximum: double, _,
        const Settings: NumberFields.Options
      ):
        const Path: string := Location + '/numberField';
        Rules.RequireProfile(Profile, Target.Graphical, Path);
        const At: string := Identify(Id, Path);
        NumberRules.Check(Value, Minimum, Maximum, Settings, At);
        discard Identify(NumberFields.DecreaseId(Id), At + '/decrease');
        discard Identify(NumberFields.IncreaseId(Id), At + '/increase');
      when E.Element.Contextual(
        const Id: string,
        const Child: E.Element<TMsg>,
        const Entries: array of Menus.Entry<TMsg>,
        _
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/contextMenu');
        MenuRules.Check<TMsg>(Id, 'Context menu', Entries, null, Location, Identify);
        Visit(Child, Location + '/target');
      when E.Element.Hinted(
        const Child: E.Element<TMsg>,
        const Caption: string,
        const Shortcut: string
      ):
        const At: string := Location + '/tooltip';
        Rules.RequireProfile(Profile, Target.Graphical, At);
        Visit(Child, At + '/target');
        TooltipRules.Check<TMsg>(Child, Caption, Shortcut, Subviews, At);
      when E.Element.Popover(
        const Id: string, const Trigger: E.Element<TMsg>, const Content: E.Element<TMsg>, _, _,
        const Settings: Popovers.Options
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/popover');
        const At: string := Identify(Id, Location + '/popover');
        PopupRules.CheckPanel(Settings, At);
        PopupRules.CheckTrigger<TMsg>(Trigger, At);
        Visit(Trigger, At + '/trigger');
        Visit(Content, At + '/content');
      when E.Element.ConfirmPopover(
        const Id: string,
        const Trigger: E.Element<TMsg>,
        _,
        const Settings: ConfirmPopovers.Options,
        _,
        _
      ):
        Rules.RequireProfile(Profile, Target.Graphical, Location + '/confirmPopover');
        const At: string := Identify(Id, Location + '/confirmPopover');
        discard Identify(ConfirmPopovers.CancelId(Id), At + '/cancel');
        discard Identify(ConfirmPopovers.ConfirmId(Id), At + '/confirm');
        PopupRules.CheckQuestion(Settings, At);
        PopupRules.CheckTrigger<TMsg>(Trigger, At);
        Visit(Trigger, At + '/trigger');
      when E.Element.Dropdown(
        const Id: string,
        const Label: string,
        const Entries: array of Menus.Entry<TMsg>,
        const Settings: Menus.Options
      ):
        MenuRules.Check<TMsg>(Id, Label, Entries, Settings, Location, Identify);
      when E.Element.Label(const Value: string):
        Rules.CheckText(Value, Location + '/text');
      when E.Element.CheckboxAction(
        const Id: string,
        const Label: string,
        _,
        _,
        const Description: string,
        _,
        _
      ), E.Element.SwitchAction(
        const Id: string,
        const Label: string,
        _,
        _,
        const Description: string,
        _
      ), E.Element.RadioAction(
        const Id: string,
        const Label: string,
        _,
        _,
        const Description: string,
        _
      ):
        SelectionRules.CheckRow(Id, Label, Description, Profile, Location + '/selection', Identify);
      when E.Element.Radios(
        const Id: string,
        const Items: array of RadioGroups.Item,
        const Selected: int,
        _,
        _,
        const Gap: L.Spacing
      ):
        SelectionRules.CheckGroup(Id, Items, Selected, Gap, Profile, Location, Identify);
      when E.Element.Cards(
        const Id: string,
        const Items: array of RadioCards.Item,
        const Selected: int,
        _,
        const Settings: RadioCards.Options
      ):
        SelectionRules.CheckCards(
          Id,
          Items,
          Selected,
          Settings.Columns,
          Profile,
          Location,
          Identify
        );
      when E.Element.SliderAction(
        const Id: string, const Label: string, const Value: float, const Minimum: float,
        const Maximum: float, _, const Settings: Sliders.Options
      ):
        const At: string := Identify(Id, Location + '/slider');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SliderRules.Check(Label, Value, Value, Minimum, Maximum, At);
        SliderRules.CheckOptions(Settings, Maximum - Minimum, At);
      when E.Element.RangeSliderAction(
        const Id: string, const Label: string, const Value: RangeSliders.Interval,
        const Minimum: float, const Maximum: float, _, _
      ):
        const At: string := Identify(Id, Location + '/rangeSlider');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        SliderRules.Check(Label, Value.Lower, Value.Upper, Minimum, Maximum, At);
      when E.Element.ChipAction(const Id: string, const Label: string, _, _, const Icon: string, _):
        SelectionRules.CheckRow(Id, Label, '', Profile, Location + '/chip', Identify);
        Rules.CheckText(Icon, Location + '/chip/icon');
      when E.Element.RatingAction(
        const Id: string,
        const Label: string,
        const Value: int,
        _,
        const Maximum: int,
        _
      ):
        SelectionRules.CheckRow(Id, Label, '', Profile, Location + '/rating', Identify);
        if Maximum < 1 or Maximum > 16 or Value < 0 or Value > Maximum then
          Rules.Reject(
            Location + '/rating',
            'Rating needs one through sixteen stars and a value within that range or zero.'
          );
        end if;
      when E.Element.TabStrip(
        const Id: string,
        const Items: array of Tabs.Item,
        const Selected: int,
        _,
        const Settings: Tabs.Options
      ):
        NavigationRules.CheckTabs(Id, Items, Selected, Settings, Profile, Location, Identify);
      when E.Element.BreadcrumbTrail(const Id: string, const Items: array of string, _, _):
        NavigationRules.CheckBreadcrumb(Id, Items, Profile, Location, Identify);
      when E.Element.PaginationAction(const Id: string, const Page: int, const Count: int, _, _):
        const At: string := Identify(Id, Location + '/pagination');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        if Count < 1 or Page < 0 or Page >= Count then
          Rules.Reject(At, 'Pagination needs a positive page count and a valid page index.');
        end if;
      when E.Element.StepProgress(
        const Id: string,
        const Steps: array of string,
        const Current: int
      ):
        NavigationRules.CheckStepper(Steps, Current, Profile, Identify(Id, Location + '/stepper'));
      when E.Element.Separator(const Title: string):
        Rules.CheckText(Title, Location + '/divider');
      when E.Element.ButtonAction(
        const Id: string,
        const Label: string,
        _,
        const Settings: B.Options
      ):
        const At: string := Identify(Id, Location + '/button');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.IconRight, At + '/iconRight');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        Rules.CheckText(Settings.TerminalIconRight, At + '/terminalIconRight');
        Rules.CheckText(Settings.Tooltip, At + '/tooltip');
        Rules.CheckText(Settings.Shortcut, At + '/shortcut');
        if not Sys.Enum.IsDefined<S.ButtonVariant>(Settings.Variant)
          or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(At, 'Unknown button variant or size.');
        end if;

        case Settings.Width of
          when L.Extent.Fixed(const Distance: L.Measure):
            discard Rules.CheckMeasure(Distance, Profile, At + '/width');
          else
        end case;
      when E.Element.IconAction(
        const Id: string,
        const Icon: string,
        const Tooltip: string,
        _,
        const Settings: Icons.Options
      ):
        const At: string := Identify(Id, Location + '/iconButton');
        Rules.CheckText(Icon, At + '/icon');
        Rules.CheckText(Tooltip, At + '/tooltip');
        Rules.CheckText(Settings.Shortcut, At + '/shortcut');
        Rules.CheckText(Settings.TerminalGlyph, At + '/terminalGlyph');
        if Sys.String.IsNullOrWhiteSpace(Icon) or Sys.String.IsNullOrWhiteSpace(Tooltip) then
          Rules.Reject(At, 'An icon button needs an icon and a tooltip.');
        end if;

        if not Sys.Enum.IsDefined<S.ButtonVariant>(Settings.Variant)
          or not Sys.Enum.IsDefined<Icons.Size>(Settings.ControlSize)
        then
          Rules.Reject(At, 'Unknown icon button variant or size.');
        end if;
      when E.Element.CopyAction(const Id: string, const Value: string, _, _):
        Rules.CheckText(Value, Identify(Id, Location + '/copyButton') + '/text');
      when E.Element.HoldAction(
        const Id: string,
        const Label: string,
        _,
        const Settings: Holds.Options
      ):
        const At: string := Identify(Id, Location + '/holdButton');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        if Settings.DurationMilliseconds <= 0 or Settings.Variant = S.ButtonVariant.Active
          or not Sys.Enum.IsDefined<S.ButtonVariant>(
          Settings.Variant
        )
        then
          Rules.Reject(At, 'A hold button needs a positive duration and a CUI button variant.');
        end if;
      when E.Element.ConfirmAction(
        const Id: string,
        const Label: string,
        _,
        const Settings: Confirms.Options
      ):
        const At: string := Identify(Id, Location + '/confirmButton');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.ConfirmLabel, At + '/confirmLabel');
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        if Settings.TimeoutMilliseconds <= 0 or Settings.Variant = S.ButtonVariant.Active
          or not Sys.Enum.IsDefined<S.ButtonVariant>(Settings.Variant)
          or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(
            At,
            'A confirm button needs a positive timeout and a valid button variant and size.'
          );
        end if;
      when E.Element.StatusAction(
        const Id: string,
        const Label: string,
        const State: Status.Status,
        _,
        const Settings: Status.Options
      ):
        const At: string := Identify(Id, Location + '/statusButton');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.SuccessLabel, At + '/successLabel');
        Rules.CheckText(Settings.ErrorLabel, At + '/errorLabel');
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        const Busy: string? := Settings.BusyLabel;
        if Busy <> null then
          Rules.CheckText(Busy, At + '/busyLabel');
        end if;

        if not Sys.Enum.IsDefined<Status.Status>(State)
          or not Sys.Enum.IsDefined<S.ButtonVariant>(Settings.Variant)
          or Settings.Variant = S.ButtonVariant.Active
          or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(At, 'A status button needs a valid work state, button variant and size.');
        end if;
      when E.Element.Segments(
        const Id: string,
        const Items: array of Segmented.Item,
        const Selected: int,
        _,
        const Settings: Segmented.Options
      ):
        const At: string := Identify(Id, Location + '/segmented');
        if Items.Length < 1 or Items.Length > 32 or Selected < 0 or Selected >= Items.Length
          or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(
            At,
            'A segmented control needs one through 32 choices, a selected index and a valid size.'
          );
        end if;

        for Index: int := 0 to Items.Length - 1 do
          const Item: Segmented.Item := Items[Index];
          discard Identify(Segmented.ItemId(Id, Index), At + '/item');
          Rules.CheckText(Item.Label, At + '/label');
          Rules.CheckText(Item.Icon, At + '/icon');
          Rules.CheckText(Item.TerminalIcon, At + '/terminalIcon');
          if Item.Label = '' or Item.Label.Contains(#10) or Item.Label.Contains(#13)
            or (Item.IconOnly and Item.Icon = '')
          then
            Rules.Reject(
              At,
              'A segment needs a single-line accessible label; icon-only choices also need an icon.'
            );
          end if;
        end for;
      when E.Element.Toggles(
        const Id: string, const Items: array of ToggleGroups.Item,
        const Selected: array of bool, _, const Settings: ToggleGroups.Options
      ):
        const At: string := Identify(Id, Location + '/toggleGroup');
        Rules.RequireProfile(Profile, Target.Graphical, At);
        ToggleGroupRules.Check(Items, Selected, Settings, At);
        for Index: int := 0 to Items.Length - 1 do
          discard Identify(ToggleGroups.ItemId(Id, Index), At + '/item');
        end for;
      when E.Element.ThemeFlip(const Id: string, const Appearance: Themes.Mode, _, _):
        const At: string := Identify(Id, Location + '/themeToggle');
        if not Sys.Enum.IsDefined<Themes.Mode>(Appearance) then
          Rules.Reject(At, 'A theme toggle needs a concrete Light or Dark appearance.');
        end if;
      when E.Element.ThemeChoice(
        const Id: string,
        const Selected: ThemeSwitchers.Selection,
        _,
        const Settings: ThemeSwitchers.Options
      ):
        const At: string := Identify(Id, Location + '/themeSwitcher');
        if not Sys.Enum.IsDefined<ThemeSwitchers.Selection>(Selected)
          or (Selected = ThemeSwitchers.Selection.System and not Settings.WithSystem)
        then
          Rules.Reject(At, 'A theme selector needs an available Light, Dark or System choice.');
        end if;

        for Index: int := 0 to (if Settings.WithSystem then 2 else 1 end if) do
          discard Identify(
            ThemeSwitchers.ItemId(Id, cast<ThemeSwitchers.Selection>(Index)),
            At + '/item'
          );
        end for;
      when E.Element.ButtonGroup(const Children: array of E.Element<TMsg>):
        for Index: int := 0 to Children.Length - 1 do
          const Child: E.Element<TMsg> := Children[Index];
          const At: string := Location + '/buttonGroup[' + Index.ToString() + ']';
          if not TooltipRules.IsButton<TMsg>(Child) then
            Rules.Reject(At, 'A button group accepts only button actions.');
          end if;

          Visit(Child, At);
        end for;
      when E.Element.SplitAction(
        const Id: string,
        const Label: string,
        _,
        const Items: array of Split.Item<TMsg>,
        const Settings: Split.Options
      ):
        const At: string := Identify(Id, Location + '/splitButton');
        Rules.CheckText(Label, At);
        Rules.CheckText(Settings.Icon, At + '/icon');
        Rules.CheckText(Settings.TerminalIcon, At + '/terminalIcon');
        discard Identify(Split.MenuId(Id), At + '/menu');
        if Items.Length = 0 or Settings.Variant = S.ButtonVariant.Active
          or not Sys.Enum.IsDefined<S.ButtonVariant>(
          Settings.Variant
        ) or not Sys.Enum.IsDefined<B.Size>(Settings.ControlSize)
        then
          Rules.Reject(At, 'A split button needs menu items, a CUI variant and a known size.');
        end if;

        for Item: Split.Item<TMsg> in Items do
          if Sys.String.IsNullOrWhiteSpace(Item.Key) then
            Rules.Reject(At, 'Menu item keys must be nonempty.');
          end if;
          const Entry: string := Identify(Split.ItemId(Id, Item.Key), At + '/item');
          Rules.CheckText(Item.Label, Entry + '/label');
          Rules.CheckText(Item.Icon, Entry + '/icon');
          Rules.CheckText(Item.TerminalIcon, Entry + '/terminalIcon');
        end for;
      when E.Element.Sidebar(
        const Id: string,
        const Sections: array of N.Section<TMsg>,
        const Active: string?,
        _
      ):
        const At: string := Identify(Id, Location + '/sidebar');
        const Keys: Generic.HashSet<string> := new Generic.HashSet<string>();
        for Section: N.Section<TMsg> in Sections do
          Rules.CheckText(Section.Title, At + '/heading');
          for Item: N.Item<TMsg> in Section.Items do
            Rules.CheckKey(Keys, Item.Key, At);
            const ItemAt: string := Identify(N.ItemId(Id, Item.Key), At + '/item');
            Rules.CheckText(Item.Label, ItemAt);
            Rules.CheckText(Item.Icon, ItemAt + '/icon');
            Rules.CheckText(Item.Badge, ItemAt + '/badge');
          end for;
        end for;

        Rules.CheckSelected(Keys, Active, At);
      when E.Element.Stack(
        const Children: array of E.Element<TMsg>,
        const Horizontal: bool,
        const Flow: L.Flow
      ):
        const At: string := Location + (if Horizontal then '/row' else '/column' end if);
        if Flow.Wrap then
          Rules.RequireProfile(Profile, Target.Graphical, At);
          if not Horizontal then
            Rules.Reject(At, 'Wrapping requires a row.');
          end if;
        end if;

        if not Sys.Enum.IsDefined<L.Alignment>(Flow.Align) then
          Rules.Reject(At, 'Unknown cross-axis alignment.');
        end if;

        Rules.CheckSpacing(Flow.Gap, Profile, At + '/gap');
        Rules.CheckSpacing(Flow.Padding, Profile, At + '/padding');
        for Index: int := 0 to Children.Length - 1 do
          Visit(Children[Index], At + '[' + Index.ToString() + ']');
        end for;
      when E.Element.Sized(const Child: E.Element<TMsg>, const Flex: L.Flex):
        Rules.CheckFlex(Flex, Profile, Location + '/size');
        Visit(Child, Location + '/size');
      when E.Element.Styled(const Child: E.Element<TMsg>, const Role: S.Role):
        if not Sys.Enum.IsDefined<S.Role>(Role) then
          Rules.Reject(Location + '/style', 'Unknown semantic style role.');
        end if;

        if Role = S.Role.Label then
          Rules.RequireProfile(Profile, Target.Graphical, Location + '/style');
        end if;

        Visit(Child, Location + '/style');
      when E.Element.Framed(const Child: E.Element<TMsg>, const Title: string):
        Rules.CheckText(Title, Location + '/border');
        Visit(Child, Location + '/border');
      when E.Element.Scroll(
        const Id: string, const Child: E.Element<TMsg>, const Position: L.ScrollPosition?,
        const OnScroll: Sys.Func<L.ScrollChange, TMsg>?, _
      ):
        const At: string := Identify(Id, Location + '/scroll');
        if (Position = null) <> (OnScroll = null) then
          Rules.Reject(At, 'Controlled scrolling needs a position and a callback.');
        end if;

        if Position <> null then
          case Position of
            when L.ScrollPosition.Offset(const Offset: L.Measure):
              discard Rules.CheckMeasure(Offset, Profile, At + '/offset');
            else
          end case;
        end if;

        Visit(Child, At);
      when E.Element.Sheet(
        const Id: string, const Base: E.Element<TMsg>, const Content: E.Element<TMsg>, _,
        const Settings: Sheets.Options, _
      ):
        const At: string := Identify(Id, Location + '/sheet');
        discard Identify(Sheets.CloseId(Id), At + '/close');
        Rules.CheckText(Settings.Title, At + '/title');
        Rules.CheckText(Settings.Description, At + '/description');
        const Initial: string? := Settings.InitialFocus;
        if Initial <> null then
          Rules.CheckText(Initial, At + '/initialFocus');
        end if;

        if Settings.Size <= 0 or not Sys.Enum.IsDefined<Sheets.Side>(Settings.Edge) then
          Rules.Reject(At, 'A sheet needs a positive size and a valid edge.');
        end if;

        Visit(Base, At + '/base');
        Visit(Content, At + '/content');
      when E.Element.Deferred(
        const Id: string,
        const Resolve: function(E.CacheEntry<TMsg>?): E.CacheEntry<TMsg>
      ):
        const At: string := Identify(Id, Location + '/subview');
        const Old: E.CacheEntry<TMsg>? := if Previous <> null and Previous.Subviews.ContainsKey(
            Id
          ) then Previous.Subviews[Id]
          else null
          end if;
        const Current: E.CacheEntry<TMsg> := Resolve(Old);
        Subviews.Add(Id, Current);
        Visit(Current.Tree, At);
      when E.Element.TerminalStyle(const Child: E.Element<TMsg>, const Colors: T.Style):
        const At: string := Location + '/cellStyle';
        Rules.RequireProfile(Profile, Target.Terminal, At);
        Rules.CheckColor(Colors.Foreground, At);
        Rules.CheckColor(Colors.Background, At);
        Visit(Child, At);
      when E.Element.TerminalScreen(
        const Content: E.Element<TMsg>,
        const Layers: array of E.Element<TMsg>,
        const Shortcuts: array of K.ShortcutBinding<TMsg>
      ):
        Rules.RequireProfile(Profile, Target.Terminal, Location + '/screen');
        CheckShortcuts(Shortcuts, Location);
        Visit(Content, Location + '/content');
        for Layer: E.Element<TMsg> in Layers do
          Visit(Layer, Location + '/layer');
        end for;
      when E.Element.TerminalViewport(
        const Id: string,
        const Build: function(T.Viewport): E.Element<TMsg>
      ):
        const At: string := Identify(Id, Location + '/terminalViewport');
        Rules.RequireProfile(Profile, Target.Terminal, At);
        const Size: T.Viewport? := TerminalSize;
        if Size = null then
          Rules.Reject(At, 'Terminal viewport context is required.');
          return;
        end if;

        if Size.Columns < 1 or Size.Rows < 1 then
          Rules.Reject(At, 'Terminal dimensions must be positive.');
        end if;
        const Content: E.Element<TMsg> := Build(Size);
        Subviews.Add(Id, new E.CacheEntry<TMsg>(Size, Content));
        Visit(Content, At);
    end case;
  end procedure;

  procedure Visit(Node: E.Element<TMsg>?; Location: string);
  begin
    if Node = null then
      raise new Sys.ArgumentException(Location + ' — A view node is missing.');
    end if;

    if not Visiting.Add(Node) then
      Rules.Reject(Location, 'A view cannot contain a cycle.');
    end if;

    try
      CheckNode(Node, Location);
    finally
      discard Visiting.Remove(Node);
    end try;
  end procedure;

  procedure CheckShortcuts(Shortcuts: array of K.ShortcutBinding<TMsg>; Location: string);
  begin
    const Gestures: Generic.HashSet<string> := new Generic.HashSet<string>();
    for Shortcut: K.ShortcutBinding<TMsg> in Shortcuts do
      if not Sys.Enum.IsDefined<K.Key>(
        Shortcut.PressedKey
      ) or (cast<int>(Shortcut.Modifiers) and not 7) <> 0
      then
        Rules.Reject(Location, 'Unknown shortcut key or modifiers.');
      end if;

      if Shortcut.Character <> '' then
        if Shortcut.PressedKey <> K.Key.Unknown or Shortcut.Modifiers <> K.KeyModifiers.None then
          Rules.Reject(Location, 'A character shortcut cannot also bind a named key or modifiers.');
        end if;
        var Scalar: Sys.Text.Rune := new Sys.Text.Rune(0);
        if not Sys.Text.Rune.TryGetRuneAt(
          Shortcut.Character,
          0,
          out Scalar
        ) or Scalar.Utf16SequenceLength <> Shortcut.Character.Length or Sys.Text.Rune.IsControl(
          Scalar
        )
        then
          Rules.Reject(Location, 'A character shortcut needs one printable Unicode scalar.');
        end if;
      elsif Shortcut.PressedKey = K.Key.Unknown then
        Rules.Reject(Location, 'A named shortcut needs a known key.');
      end if;
      const Gesture: string := Shortcut.Character + '/' +
        cast<int>(Shortcut.PressedKey).ToString() + '/' + cast<int>(Shortcut.Modifiers).ToString();
      if not Gestures.Add(Gesture) then
        Rules.Reject(Location, 'Duplicate shortcut binding.');
      end if;
    end for;
  end procedure;
begin
  const Ids: Generic.HashSet<string> := new Generic.HashSet<string>();
  const Visiting: Generic.HashSet<Sys.Object> := new Generic.HashSet<Sys.Object>(
    Generic.ReferenceEqualityComparer.Instance
  );
  const Subviews: Generic.Dictionary<string, E.CacheEntry<TMsg>> := new Generic.Dictionary<string, E.CacheEntry<TMsg>>();
  Visit(Tree, 'root');
  return new Prepared<TMsg>(
    Tree,
    new Collections.ReadOnlyDictionary<string, E.CacheEntry<TMsg>>(Subviews)
  );
end function;
end unit;
