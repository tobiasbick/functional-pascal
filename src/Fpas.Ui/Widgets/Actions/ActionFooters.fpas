// [Documentation](../../../../docs/ui/gui/overlays/action-footer.md)

unit Fpas.Ui.Widgets.Actions.ActionFooters;

uses Fpas.Ui.Elements as E;

// Groups actions using CUI's right-aligned dialog footer.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Children`: Actions in display order.
// ## Returns
// A graphical row with the native footer inset and spacing.
public function ActionFooter of TMsg(params Children: array of E.Element of TMsg): E.Element of TMsg;
begin
  return (E.Element of TMsg).ActionFooter(Children);
end function;

end unit;
