// [Documentation](../../../../docs/ui/gui/actions/button-group.md)

unit Fpas.Ui.Widgets.Actions.ButtonGroups;

uses Fpas.Ui.Elements as E;

// Joins buttons under one outline. Each member retains its identity and message.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Children`: Direct buttons and icon buttons in focus order.
// ## Returns
// A horizontal button group.
public function ButtonGroup of TMsg(params Children: array of E.Element of TMsg): E.Element of TMsg;
requires Children <> null;
begin
  return (E.Element of TMsg).ButtonGroup(Children);
end function;

end unit;
