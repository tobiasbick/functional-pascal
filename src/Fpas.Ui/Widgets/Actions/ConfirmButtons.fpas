// [Documentation](../../../../docs/ui/gui/actions/confirm-button.md)

unit Fpas.Ui.Widgets.Actions.ConfirmButtons;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Actions.Buttons as B;

// Presentation and input options for a two-step confirmation.
public type Options = record
  // Caption shown after the first activation.
  public ConfirmLabel: string := 'Click to confirm';
  // Confirmation window in milliseconds. Zero uses CUI's three-second default.
  public TimeoutMilliseconds: int := 0;
  // Native glyph before the resting caption. Null omits its space.
  public Icon: string? := null;
  // Resting appearance; the confirmation uses the destructive style.
  public Variant: S.ButtonVariant := S.ButtonVariant.Secondary;
  // Requested control size.
  public ControlSize: B.Size := B.Size.Medium;
  // Whether the control accepts input and focus.
  public Enabled: bool := true;
end record;

// Builds an action that needs two activations within a bounded interval.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity independent of both captions.
// - `Label`: Literal resting caption.
// - `Message`: Proposed once when the second activation confirms.
// - `Settings`: Confirmation caption, timeout, appearance and input permission.
// ## Returns
// A graphical confirmation button. Escape, an outside click or timeout disarms it.
public function ConfirmButton of TMsg(
  Id: string;
  Label: string;
  Message: TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).ConfirmAction(Id, Label, Message, Settings ?? new Options());
end function;

end unit;
