// [Documentation](../../../../docs/ui/gui/actions/copy-button.md)

unit Fpas.Ui.Widgets.Actions.CopyButtons;

uses Fpas.Ui.Elements as E;

uses System as Sys;

// Builds a copy button with a stable ID and a brief confirmation after a clipboard request.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Text`: Literal text submitted to the clipboard.
// - `OnCopied`: Optional message factory invoked after submitting the text.
// - `Enabled`: Whether the control accepts input.
// ## Returns
// A graphical copy button.
public function CopyButton of TMsg(
  Id: string; Text: string; OnCopied: (Sys.Func of TMsg)? := null; Enabled: bool := true
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).CopyAction(Id, Text, OnCopied, Enabled);
end function;

end unit;
