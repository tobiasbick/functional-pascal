unit Fpas.Ui.Widgets.Actions.IconButtons;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S;

// Control sizes in CUI's native order.
public type Size = enum: byte
  // Use the normal control height.
  Medium;
  // Use the compact control height.
  Small;
  // Use the large control height.
  Large;
end enum;

// Model-owned presentation and input options for an icon button.
public type Options = record
  // The theme variant, ghost by default.
  public Variant: S.ButtonVariant := S.ButtonVariant.Ghost;
  // Requested control size.
  public ControlSize: Size := Size.Medium;
  // Whether the button accepts input and focus.
  public Enabled: bool := true;
  // Shows a busy indicator and suppresses activation while retaining focus.
  public Loading: bool := false;
  // Whether to show the selected appearance.
  public Selected: bool := false;
  // Shortcut hint displayed with the tooltip. Applications bind the key separately.
  public Shortcut: string := '';
  // Optional terminal glyph. Empty uses the tooltip as the visible button text.
  public TerminalGlyph: string := '';
end record;

// Builds a named icon button whose identity survives icon and tooltip changes.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Icon`: Glyph from the CUI icon font.
// - `Tooltip`: Accessible button name and pointer tooltip.
// - `Message`: Proposed message on activation.
// - `Settings`: Optional input and appearance settings.
// ## Returns
// A portable icon button.
public function IconButton<TMsg>(
  Id: string; Icon: string; Tooltip: string; Message: TMsg; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
requires Icon <> '';
requires Tooltip <> '';
begin
  return E.Element<TMsg>.IconAction(Id, Icon, Tooltip, Message, Settings ?? new Options());
end function;

end unit;
