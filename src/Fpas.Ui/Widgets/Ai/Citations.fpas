unit Fpas.Ui.Widgets.Ai.Citations;

uses Fpas.Ui.Elements as E, System as Sys, Fpas.Ui.Widgets.Ai.Sources as Sources;

// Native presentation and interaction options.
public type Options = record
  // Allow citation activation.
  public Enabled: bool := true;
end record;

// Builds the native Citation widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Number`: Displayed citation number when there is no domain.
// - `Source`: Optional source and hover preview.
// - `Activate`: Optional activation.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function Citation<TMsg>(Id: string; Number: int; Source: Sources.Item?; Activate: Sys.Func<TMsg>?; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Citation(Id, Number, Source, Activate, Settings ?? new Options());
end function;

end unit;
