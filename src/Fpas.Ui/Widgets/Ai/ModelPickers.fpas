unit Fpas.Ui.Widgets.Ai.ModelPickers;

uses Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Overlays.Menus as Menus;

// A choice in the native model menu.
public type Item = record
  // Model name.
  public Name: string;
  // Supporting description.
  public Detail: string := '';
  // Optional badge.
  public Badge: string := '';
  // Optional icon.
  public Icon: string := '';
end record;

// Native presentation and interaction options.
public type Options = record
  // Use a quiet trigger.
  public Ghost: bool := false;
  // Position of the model menu.
  public Placement: Menus.Placement := Menus.Placement.TopStart;
  // Allow model selection.
  public Enabled: bool := true;
end record;

// Builds the native ModelPicker widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Items`: Available models.
// - `Selected`: Selected model index.
// - `Changed`: Maps the proposed index.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function ModelPicker<TMsg>(Id: string; Items: array of Item; Selected: int; Changed: function(int): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ModelPicker(Id, Items, Selected, Changed, Settings ?? new Options());
end function;

end unit;
