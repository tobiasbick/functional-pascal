// [Documentation](../../../../docs/ui/gui/ai/prompt-suggestions.md)

unit Fpas.Ui.Widgets.Ai.PromptSuggestions;

uses Fpas.Ui.Elements as E;

// A native suggestion card.
public type Item = record
  // Suggestion title.
  public Title: string;
  // Supporting description, or null to omit the detail line.
  public Detail: string? := null;
  // Icon glyph, or null to omit the icon slot.
  public Icon: string? := null;
end record;

// Native presentation and interaction options.
public type Options = record
  // Maximum number of columns, or zero for the native default of two.
  public Columns: int := 0;
  // Allow choosing a suggestion.
  public Enabled: bool := true;
end record;

// Builds the native PromptSuggestions widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Items`: Suggestions in display order.
// - `Changed`: Maps the selected index.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function PromptSuggestions of TMsg(
  Id: string;
  Items: array of Item;
  Changed: function(int): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).PromptSuggestions(Id, Items, Changed, Settings ?? new Options());
end function;

end unit;
