unit Fpas.Ui.Widgets.Ai.Reasonings;

uses Fpas.Ui.Elements as E;

// Native presentation and interaction options.
public type Options = record
  // Open and show the animated thinking state.
  public Thinking: bool := false;
  // Elapsed time.
  public Seconds: float := 0.0F;
  // Optional heading override.
  public Title: string := '';
  // Allow opening and closing.
  public Enabled: bool := true;
end record;

// Builds the native Reasoning widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Children`: Composed reasoning body.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function Reasoning<TMsg>(Id: string; Children: array of E.Element<TMsg>; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Reasoning(Id, Children, Settings ?? new Options());
end function;

end unit;
