unit Fpas.Ui.Widgets.Ai.SourceLists;

uses Fpas.Ui.Elements as E, System as Sys, Fpas.Ui.Widgets.Ai.Sources as Sources;

// Native presentation and interaction options.
public type Options = record
  // Allow source activation.
  public Enabled: bool := true;
end record;

// Builds the native SourceList widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Documents`: Documents in display order.
// - `Changed`: Optional source activation mapper.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function SourceList<TMsg>(Id: string; Documents: array of Sources.Item; Changed: Sys.Func<int, TMsg>?; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.SourceList(Id, Documents, Changed, Settings ?? new Options());
end function;

end unit;
