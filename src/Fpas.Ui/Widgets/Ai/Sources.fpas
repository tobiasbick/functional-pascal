// [Documentation](../../../../docs/ui/widgets.md#voice-and-ai)

unit Fpas.Ui.Widgets.Ai.Sources;

// A cited document.
public type Item = record
  // Optional URL used for the domain label and source tooltip.
  public Url: string? := null;
  // Title, or null to use the domain in a source card.
  public Title: string? := null;
  // Optional excerpt shown in a citation preview.
  public Snippet: string? := null;
end record;

end unit;
