unit Fpas.Ui.Widgets.Audio.NowPlaying;

uses Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Charts.Charts as C, Fpas.Ui.Layout as L;

// Native value.
public type Value = record
  // Track title.
  public Title: string;
  // Artist.
  public Artist: string;
  // Seconds played.
  public Position: float;
  // Track duration in seconds.
  public Duration: float;
  // Current transport state.
  public Playing: bool := false;
  // Fallback artwork color.
  public ArtColor: C.Color := C.Color.Automatic;
  // Optional image resource path.
  public Artwork: string := '';
end record;

// Native event.
public type Event = record
  // Proposed transport and position.
  public Current: Value;
  // Play or pause was activated.
  public Toggled: bool;
  // Previous was activated.
  public Previous: bool;
  // Next was activated.
  public Next: bool;
  // Scrubbing completed.
  public Seek: bool;
end record;

// Native options.
public type Options = record
  // Native card width.
  public Width: L.Extent := L.Extent.Content;
  // Use compact controls.
  public Compact: bool := false;
  // Accept transport and seek input.
  public Enabled: bool := true;
end record;

// Draws the native CUI now playing.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Current`: Model-owned playback state.
// - `Change`: Maps a native proposal to an application message.
// - `Settings`: Optional native options.
// ## Returns
// The graphical widget.
public function NowPlaying<TMsg>(Id: string; Current: Value; Change: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.NowPlaying(Id, Current, Change, Settings ?? new Options());
end function;

end unit;
