unit Fpas.Ui.Widgets.Audio.VoiceNotes;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Audio.Voice as Voice;

// Model-owned playback state.
public type Value = record
  // Length in seconds.
  public Duration: float;
  // Played seconds.
  public Position: float := 0.0F;
  // Playback rate: 1, 1.5 or 2.
  public Speed: float := 1.0F;
  // Show the pause control.
  public Playing: bool := false;
end record;

// Native playback proposals.
public type Event = variant
  // Change play or pause.
  Toggle(Playing: bool);
  // Seek to the supplied seconds.
  Seek(Position: float);
  // Change the playback rate.
  Speed(Rate: float);
end variant;

// Native presentation and interaction options.
public type Options = record
  // Preferred native bubble width.
  public Width: L.Extent := L.Extent.Content;
  // Place an outgoing bubble at the end.
  public Mine: bool := false;
  // Allows playback, seeking and speed changes.
  public Enabled: bool := true;
end record;

// Builds CUI's native VoiceNote.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable message identity.
// - `Levels`: The clip's measured levels.
// - `Playback`: Model-owned transport state.
// - `Changed`: Maps a transport proposal.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function VoiceNote<TMsg>(Id: string; Levels: array of float; Playback: Value; Changed: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.VoiceNote(Id, Levels, Playback, Changed, Settings ?? new Options());
end function;

end unit;
