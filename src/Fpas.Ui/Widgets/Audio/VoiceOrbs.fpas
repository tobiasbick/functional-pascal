unit Fpas.Ui.Widgets.Audio.VoiceOrbs;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Audio.Voice as Voice, Fpas.Ui.Widgets.Charts.Charts as Charts, System as Sys;

// Native presentation and interaction options.
public type Options = record
  // Diameter in logical units, or zero for the default.
  public Size: float := 0.0F;
  // Optional accent override.
  public Color: Charts.Color := Charts.Color.Automatic;
  // Allows activation.
  public Enabled: bool := true;
end record;

// Builds CUI's native VoiceOrb.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable orb identity.
// - `Activity`: Voice activity visualized by the orb.
// - `Level`: Current level from zero to one.
// - `Activate`: Optional activation.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function VoiceOrb<TMsg>(Id: string; Activity: Voice.Activity; Level: float; Activate: Sys.Func<TMsg>?; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.VoiceOrb(Id, Activity, Level, Activate, Settings ?? new Options());
end function;

end unit;
