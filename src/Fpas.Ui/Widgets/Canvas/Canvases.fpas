// [Documentation](../../../../docs/ui/gui/text-and-display/canvas.md)

unit Fpas.Ui.Widgets.Canvas.Canvases;

uses Fpas.Ui.Widgets.Inputs.ShortcutRecorders as Keys, Fpas.Ui.Elements as E, Fpas.Ui.Graphics as G, Fpas.Ui.Layout as L, System as Sys, Fpas.Ui.Widgets.Canvas.Painting as Painting;

// A drawing command in canvas-local logical points.
public type Shape = variant
  // Fills a rectangle with rounded corners.
  Rectangle(X: float; Y: float; Width: float; Height: float; Radius: float; Color: G.Color);
  // Fills a circle.
  Circle(X: float; Y: float; Radius: float; Color: G.Color);
  // Draws a line between two points.
  Line(X: float; Y: float; EndX: float; EndY: float; Thickness: float; Color: G.Color);
end variant;

// Cursor shown while the enabled canvas is hovered.
public type Cursor = enum: byte
  // Standard arrow.
  Arrow;
  // Actionable item.
  Hand;
  // Text entry.
  Text;
  // Horizontal resize.
  ResizeHorizontal;
  // Vertical resize.
  ResizeVertical;
  // Move.
  Move;
  // Unavailable action.
  NotAllowed;
end enum;

// Ordered input for a canvas which owns native keyboard focus.
public type Input = variant
  // Physical key transition; modifiers use the CUI shortcut mask.
  Key(Code: Keys.Key; Modifiers: Keys.Modifier; Down: bool; Repeated: bool);
  // Committed Unicode text, copied during delivery.
  Text(Value: string);
  // Window focus changed while the canvas owned component input.
  WindowFocus(Focused: bool);
end variant;

// Canvas layout and input settings.
public type Options = record
  // Preferred width.
  public Width: L.Extent := L.Extent.Fill;
  // Preferred height.
  public Height: L.Extent := L.Extent.Fixed(L.Measure.Logical(120));
  // Whether the canvas accepts pointer and keyboard input.
  public Enabled: bool := true;
  // Include the canvas in Tab navigation. Enter and Space activate it when OnInput is absent.
  public Focusable: bool := false;
  // Optional cursor while the pointer hovers this canvas.
  public HoverCursor: Cursor? := null;
end record;

// Button activation on a canvas.
public type Event = record
  // Pointer X in canvas-local logical points.
  public X: float;
  // Pointer Y in canvas-local logical points.
  public Y: float;
  // Width of the canvas at activation.
  public Width: float;
  // Height of the canvas at activation.
  public Height: float;
end record;

// Wheel movement over the native canvas, in lines; positive Y scrolls upward.
public type Wheel = record
  // Horizontal line delta.
  public X: float;
  // Vertical line delta.
  public Y: float;
end record;

// Native pointer state; emitted on hover/press transitions and movement while active.
public type Pointer = record
  // Whether CUI hovers this enabled canvas.
  public Hovered: bool;
  // Whether a native press starts in this frame.
  public Pressed: bool;
  // Canvas-local horizontal pointer coordinate.
  public X: float;
  // Canvas-local vertical pointer coordinate.
  public Y: float;
  // Previously laid-out logical width.
  public Width: float;
  // Previously laid-out logical height.
  public Height: float;
end record;

// Creates a native CUI canvas element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable canvas identity.
// - `Drawing`: Draw commands in paint order.
// - `Clicked`: Maps native activation to an application message.
// - `Settings`: Native canvas options.
// - `OnWheel`: Optional wheel mapper. Null leaves scrolling to enclosing views.
// - `Paint`: Optional direct CUI drawing after layout, following Drawing; owner-thread only.
// - `OnPointer`: Optional changed-state hover/press mapper; disabling emits a final leave.
// - `OnInput`: Optional ordered keyboard/text mapper. Enables component focus and leaves Tab navigation to CUI.
// ## Returns
// A graphical element.
public function Canvas<TMsg>(Id: string; Drawing: array of Shape; Clicked: function(Event): TMsg; Settings: Options? := null; OnWheel: Sys.Func<Wheel, TMsg>? := null; Paint: Sys.Action<Painting.Surface>? := null; OnPointer: Sys.Func<Pointer, TMsg>? := null; OnInput: Sys.Func<Input, TMsg>? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Canvas(
    Id,
    Drawing,
    Clicked,
    Settings ?? new Options(),
    OnWheel,
    Paint,
    OnPointer, OnInput
  );
end function;

end unit;
