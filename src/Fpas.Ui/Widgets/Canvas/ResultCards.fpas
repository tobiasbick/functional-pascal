// [Documentation](../../../../docs/ui/gui/canvas-and-bars/result-card.md)

unit Fpas.Ui.Widgets.Canvas.ResultCards;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;

// Result card settings.
public type Options = record
  // Optional caption shown over the picture.
  public Caption: string? := null;
  // Optional status badge.
  public Badge: string? := null;
  // Status badge tone, or neutral for the native default.
  public BadgeTone: S.Tone := S.Tone.Neutral;
  // Preferred width. Content fills the available width up to 320 logical units.
  public Width: L.Extent := L.Extent.Content;
  // Height divided by width, or zero for the default.
  public Aspect: float := 0.0F;
  // Whether the card accepts activation.
  public Enabled: bool := true;
  // Whether to stretch the picture to the card instead of cropping it.
  public StretchImage: bool := false;
end record;

// Builds the native ResultCard element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Image`: Picture displayed in the card, or null for a muted surface.
// - `Title`: Caption title, or an empty string to omit it.
// - `Activate`: Message on card activation.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function ResultCard of TMsg(
  Id: string;
  Image: Media.Source?;
  Title: string;
  Activate: TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).ResultCard(Id, Image, Title, Activate, Settings ?? new Options());
end function;

end unit;
