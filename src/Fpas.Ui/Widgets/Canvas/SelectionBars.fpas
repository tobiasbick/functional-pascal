// [Documentation](../../../../docs/ui/gui/canvas-and-bars/selection-bar.md)

unit Fpas.Ui.Widgets.Canvas.SelectionBars;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Styles as S;

// An action offered for selected items.
public type Action = record
  // Native CUI icon glyph.
  public Icon: string;
  // Visible action caption.
  public Label: string;
  // Semantic action color.
  public Tone: S.Tone := S.Tone.Neutral;
end record;

// The model supplies either item flags or an aggregate count.
public type Selection = variant
  // Item flags counted by CUI; the model handles the clear proposal.
  Items(Values: array of bool);
  // Nonnegative aggregate count, without allocating item flags.
  Count(Value: int);
end variant;

// Selection bar settings.
public type Options = record
  // Keeps the selection when Escape is pressed.
  public NoEscape: bool := false;
  // Whether the bar accepts actions.
  public Enabled: bool := true;
  // Native count format: at most one %d slot, %% for a percent; empty uses CUI's default.
  public CountFormat: string := '';
end record;

// Selection bar action.
public type Event = record
  // Zero-based action index, or minus one when clearing.
  public Index: int;
  // Whether the bar cleared the selection.
  public Clear: bool;
end record;

// Builds the native SelectionBar element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Selected`: Model-owned flags or an aggregate count.
// - `Actions`: Available actions in display order.
// - `Changed`: Maps actions and clearing to messages.
// - `Child`: Content that anchors the floating bar.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function SelectionBar of TMsg(
  Id: string;
  Selected: Selection;
  Actions: array of Action;
  Changed: function(Event): TMsg;
  Child: E.Element of TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).SelectionBar(
    Id,
    Selected,
    Actions,
    Changed,
    Child,
    Settings ?? new Options()
  );
end function;

end unit;
