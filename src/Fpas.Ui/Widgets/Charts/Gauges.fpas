// [Documentation](../../../../docs/ui/gui/charts/gauge.md)

unit Fpas.Ui.Widgets.Charts.Gauges;

uses Fpas.Ui.Elements as E;

// Draws CUI's animated fraction gauge.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity, independent of the caption.
// - `Label`: Literal caption, or null to omit it.
// - `Value`: Finite reading. CUI clamps it to zero through one.
// - `Size`: Finite logical diameter. Nonpositive values use CUI's default of 140.
// ## Returns
// A graphical element.
public function Gauge of TMsg(
  Id: string;
  Label: string?;
  Value: float;
  Size: float := 0.0F
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).Gauge(Id, Label, Value, Size);
end function;

end unit;
