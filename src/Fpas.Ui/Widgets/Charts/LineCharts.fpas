unit Fpas.Ui.Widgets.Charts.LineCharts;

uses Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Charts.Charts as C;

// Draws CUI's native line, area or dither chart.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable chart identity.
// - `Series`: Named finite samples.
// - `Settings`: Native chart presentation.
// ## Returns
// A graphical element.
public function LineChart<TMsg>(Id: string; Series: array of C.Series; Settings: C.Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.LineChart(Id, Series, Settings ?? new C.Options());
end function;

end unit;
