unit Fpas.Ui.Widgets.Charts.RadarCharts;

uses Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Charts.Charts as C, Fpas.Ui.Layout as L, System as Sys;

// Native radar chart settings.
public type Options = record
  // Plot diameter; zero selects CUI's default.
  public Size: float := 0.0F;
  // Outer-ring value; zero chooses the native automatic scale.
  public Maximum: float := 0.0F;
  // Safe numeric formatting; null uses native automatic formatting.
  public Format: C.ValueFormat? := null;
  // Show the native series legend.
  public Legend: bool := true;
  // Allow native pointer interaction.
  public Enabled: bool := true;
end record;

// Draws CUI's native radar-chart with native layout, hover and animation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity.
// - `Series`: Nonnegative samples, one per axis in every series.
// - `Axes`: At least three literal captions.
// - `Settings`: Native presentation.
// - `OnActivate`: Optional clicked input index callback; hover remains native.
// ## Returns
// A graphical element.
public function RadarChart<TMsg>(Id: string; Series: array of C.Series; Axes: array of string; Settings: Options? := null; OnActivate: Sys.Func<int, TMsg>? := null): E.Element<TMsg>;
requires Id <> '';
requires Axes.Length >= 3;
begin
  return E.Element<TMsg>.RadarChart(Id, Series, Axes, Settings ?? new Options(), OnActivate);
end function;

end unit;
