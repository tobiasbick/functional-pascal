// [Documentation](../../../../docs/ui/gui/charts/sparkline.md)

unit Fpas.Ui.Widgets.Charts.Sparklines;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.Charts as Charts;

// Options for a compact graphical or terminal plot.
public type Options = record
  // Preferred plot width.
  public Width: L.Extent := L.Extent.Content;
  // Height in logical points.
  public Height: float := 0.0F;
  // Stroke color.
  public Color: Charts.Color := Charts.Color.Automatic;
end record;

// Draws a compact chart for a series of values.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Values`: Finite samples in display order.
// - `Settings`: Optional width, height and ink.
// ## Returns
// The graphical or terminal plot.
public function Sparkline of TMsg(
  Id: string;
  Values: array of float;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).Sparkline(Id, Values, Settings ?? new Options());
end function;

end unit;
