// [Documentation](../../../../docs/ui/gui/more-developer-tools/time-histogram.md)

unit Fpas.Ui.Widgets.Charts.TimeHistograms;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// One series of event counts.
public type Series = record
  // Name shown in the legend and hover labels.
  public Name: string;
  // One count per bucket, or null for all zeros.
  public Counts: (array of float)?;
  // Native tone from zero through eight. Zero uses the series palette.
  public Tone: int;
end record;

// Selected interval in Unix seconds. Two zeros clear the selection.
public type Range = record
  // Start of the interval.
  public Start: double;
  // End of the interval.
  public End: double;
end record;

// Interval and hover results reported by the native widget.
public type Event = record
  // Start of the proposed interval in Unix seconds.
  public Start: double;
  // End of the proposed interval in Unix seconds.
  public End: double;
  // Zero-based bucket under the pointer, or minus one.
  public Hovered: int := -1;
  // Whether the user changed or cleared the interval.
  public SelectionChanged: bool := true;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Plot height in logical units. Zero uses CUI's 140-unit default.
  public Height: float := 0.0F;
  // Whether the time labels use UTC.
  public Utc: bool := false;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
  // Last reported bucket. Null omits messages caused only by hover.
  public Hovered: int? := null;
end record;

// Builds the native TimeHistogram widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Start`: Unix timestamp of the first bucket.
// - `Bucket`: Bucket duration in seconds.
// - `Buckets`: Number of buckets.
// - `Series`: Named event counts grouped by bucket.
// - `Value`: Current selected interval.
// - `Changed`: Maps an interval or hover result to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function TimeHistogram of TMsg(
  Id: string;
  Start: double;
  Bucket: double;
  Buckets: int;
  Series: array of Series;
  Value: Range;
  Changed: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).TimeHistogram(
    Id,
    Start,
    Bucket,
    Buckets,
    Series,
    Value,
    Changed,
    Settings ?? new Options()
  );
end function;

end unit;
