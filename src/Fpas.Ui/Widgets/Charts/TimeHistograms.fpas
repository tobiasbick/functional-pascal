unit Fpas.Ui.Widgets.Charts.TimeHistograms;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Data for the native TimeHistogram widget.
public type Series = record
  // Name supplied to CUI.
  public Name: string;
  // Counts supplied to CUI.
  public Counts: array of float;
  // Tone supplied to CUI.
  public Tone: int;
end record;

// Data for the native TimeHistogram widget.
public type Range = record
  // Start supplied to CUI.
  public Start: double;
  // End supplied to CUI.
  public End: double;
end record;

// Action or changed value reported by the native widget.
public type Event = record
  // Start supplied to CUI.
  public Start: double;
  // End supplied to CUI.
  public End: double;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Height supplied to CUI.
  public Height: float := 0.0F;
  // Use UTC timestamps.
  public Utc: bool := false;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native TimeHistogram widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Start`: Model-owned start data.
// - `Bucket`: Model-owned bucket data.
// - `Buckets`: Model-owned buckets data.
// - `Series`: Model-owned series data.
// - `Value`: Model-owned value data.
// - `Changed`: Maps an action or edit to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function TimeHistogram<TMsg>(Id: string; Start: double; Bucket: double; Buckets: int; Series: array of Series; Value: Range; Changed: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.TimeHistogram(
    Id,
    Start,
    Bucket,
    Buckets,
    Series,
    Value,
    Changed,
    Settings ?? new Options()
  );
end function;

end unit;
