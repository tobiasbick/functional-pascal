unit Fpas.Ui.Widgets.Charts.Treemaps;

uses Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Charts.Charts as C, Fpas.Ui.Layout as L, System as Sys;

// Native squarified treemap presentation.
public type Options = record
  // Preferred logical width.
  public Width: L.Extent := L.Extent.Fill;
  // Logical height; zero selects CUI's default.
  public Height: float := 0.0F;
  // Safe numeric formatting; null uses native automatic formatting.
  public Format: C.ValueFormat? := null;
  // Allow native pointer interaction.
  public Enabled: bool := true;
end record;

// Draws CUI's native treemap with native layout, hover and animation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity.
// - `Items`: Named nonnegative amounts.
// - `Selected`: Selected input item, or minus one. Requires `OnSelect` when set.
// - `OnSelect`: Optional native selection proposal; null disables selection.
// - `Settings`: Native presentation.
// ## Returns
// A graphical element.
public function Treemap<TMsg>(Id: string; Items: array of C.Item; Settings: Options? := null; Selected: int := -1; OnSelect: Sys.Func<int, TMsg>? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Treemap(Id, Items, Selected, OnSelect, Settings ?? new Options());
end function;

end unit;
