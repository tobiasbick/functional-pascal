// [Documentation](../../../../docs/ui/gui/data-grid/data-grid.md)

unit Fpas.Ui.Widgets.Collections.DataGrids;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Collections.Tables as T;

uses System as Sys;

// A column in a native data grid.
public type Column = record
  // Literal heading.
  public Title: string;
  // Initial width in logical points. Zero uses the native default.
  public Width: float := 0.0F;
  // Horizontal alignment.
  public Align: T.Alignment := T.Alignment.Left;
  // Whether the header proposes sorting.
  public Sortable: bool := false;
  // Whether the width is fixed.
  public Fixed: bool := false;
  // Positive priorities hide first, starting with the largest.
  public Priority: int := 0;
end record;

// Native viewport and input options.
public type Options = record
  // Grid height. Fill uses the available height.
  public Height: L.Extent := L.Extent.Fill;
  // Fixed logical height of each row.
  public RowHeight: float := 40.0F;
  // Tint alternate rows.
  public Striped: bool := false;
  // Hide the checkboxes while retaining selection.
  public HideCheckboxes: bool := false;
  // Whether the grid accepts input.
  public Enabled: bool := true;
end record;

// Model-owned state in display order.
public type Value = record
  // Selection by row position, or null to disable selection.
  public Selected: (array of bool)? := null;
  // Current sort, or null to disable sorting.
  public Order: T.Sort? := null;
  // Current row position or minus one.
  public Cursor: int := -1;
  // Selection range origin or minus one.
  public Anchor: int := -1;
  // Controlled vertical target in logical points, or null to leave scrolling native.
  public Scroll: float? := null;
end record;

// A cell rendered by the native grid.
// ## Type parameters
// - `TMsg`: Application message type.
public type Cell of TMsg = variant
  // Native single-line text.
  Text(Caption: string);
  // Composed graphical children.
  Content(Children: array of E.Element of TMsg);
  // Editable text, with optional preceding children and a commit mapper.
  Editable(Caption: string; Capacity: int; OnCommit: function(string): TMsg; Leading: array of E.Element of TMsg);
end variant;

// One realized row.
// ## Type parameters
// - `TMsg`: Application message type.
public type Row of TMsg = record
  // Stable identity, including across a model reordering.
  public Id: string;
  // One cell per column.
  public Cells: array of Cell of TMsg;
end record;

// Draws a native grid. CUI calls for the visible rows and its overscan.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable grid identity.
// - `Columns`: Column descriptors in display order.
// - `Count`: Total row count.
// - `BuildRow`: Pure view factory for one display position. Declare open modal scopes outside row/cell factories.
// - `Current`: Model-owned selection, sort, cursor and anchor.
// - `OnChange`: Maps a native state proposal to a message.
// - `Settings`: Optional viewport and input configuration.
// - `OnDoubleClick`: Optional action for a double-click on a row, with its display index.
// ## Returns
// The graphical grid.
public function DataGrid of TMsg(Id: string; Columns: array of Column; Count: int; BuildRow: function(int): Row of TMsg; Current: Value; OnChange: function(Value): TMsg; Settings: Options? := null; OnDoubleClick: Sys.Func of (int, TMsg)? := null): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).DataGrid(
    Id,
    Columns,
    Count,
    BuildRow,
    Current,
    OnChange,
    Settings ?? new Options(), OnDoubleClick
  );
end function;

end unit;
