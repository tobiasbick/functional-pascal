unit Fpas.Ui.Widgets.Collections.ListItems;

uses Fpas.Ui.Elements as E, System as Sys;

// Native list row appearance and input.
public type Options = record
  // Optional secondary line.
  public Subtitle: string := '';
  // Optional muted right-hand text.
  public Trailing: string := '';
  // Name for the leading initials avatar.
  public Avatar: string := '';
  // Leading glyph when no avatar is supplied.
  public Icon: string := '';
  // Whether to show the active background.
  public Selected: bool := false;
  // Whether the row accepts input.
  public Enabled: bool := true;
end record;

// Builds a native selectable list row.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable row identity.
// - `Title`: Literal title.
// - `OnActivate`: Optional activation message factory.
// - `Settings`: Optional row appearance.
// ## Returns
// The graphical element.
public function ListItem<TMsg>(Id: string; Title: string; OnActivate: Sys.Func<TMsg>? := null; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ListItem(Id, Title, OnActivate, Settings ?? new Options());
end function;

end unit;
