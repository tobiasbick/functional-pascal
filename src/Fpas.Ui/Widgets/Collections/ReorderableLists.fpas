// [Documentation](../../../../docs/ui/gui/data-display/reorderable-list.md)

unit Fpas.Ui.Widgets.Collections.ReorderableLists;

uses Fpas.Ui.Elements as E;

// Lets CUI drag and animate a model-ordered list.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable list identity.
// - `Items`: Up to 256 rows in canonical index order. Each row contains its direct child elements.
// - `Order`: A permutation of the item indices.
// - `OnChange`: Maps a proposed permutation to a message.
// - `Enabled`: Whether native dragging is allowed.
// ## Returns
// The graphical element.
public function ReorderableList of TMsg(
  Id: string;
  Items: array of array of E.Element of TMsg;
  Order: array of int;
  OnChange: function(array of int): TMsg;
  Enabled: bool := true
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).ReorderableList(Id, Items, Order, OnChange, Enabled);
end function;

end unit;
