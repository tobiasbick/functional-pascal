unit Fpas.Ui.Widgets.Collections.ReorderableLists;

uses Fpas.Ui.Elements as E;

// Lets CUI drag and animate a model-ordered list.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable list identity.
// - `Items`: One to 256 children in canonical index order.
// - `Order`: A permutation of the item indices.
// - `OnChange`: Maps a proposed permutation to a message.
// - `Enabled`: Whether native dragging is allowed.
// ## Returns
// The graphical element.
public function ReorderableList<TMsg>(Id: string; Items: array of E.Element<TMsg>; Order: array of int; OnChange: function(array of int): TMsg; Enabled: bool := true): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ReorderableList(Id, Items, Order, OnChange, Enabled);
end function;

end unit;
