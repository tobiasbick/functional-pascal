// [Documentation](../../../../docs/ui/gui/data-display/tree.md)

unit Fpas.Ui.Widgets.Collections.Trees;

uses Fpas.Ui.Elements as E;

uses System as Sys;

// Appearance and input for a native tree row.
public type Options = record
  // Optional glyph overriding the native file or folder icon.
  public Icon: string := '';
  // Whether to show the selection.
  public Selected: bool := false;
  // Whether the row accepts input.
  public Enabled: bool := true;
end record;

// Builds an expandable tree branch.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable branch identity.
// - `Label`: Literal title.
// - `Open`: Current expansion.
// - `Children`: Nested tree rows.
// - `OnChange`: Maps the proposed expansion to a message.
// - `Settings`: Optional row appearance.
// ## Returns
// The tree branch element.
public function Branch of TMsg(
  Id: string;
  Label: string;
  Open: bool;
  Children: array of E.Element of TMsg;
  OnChange: function(bool): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).TreeNode(
    Id,
    Label,
    Open,
    Children,
    OnChange,
    null,
    Settings ?? new Options()
  );
end function;

// Builds a tree leaf.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable leaf identity.
// - `Label`: Literal title.
// - `OnActivate`: Optional selection message factory.
// - `Settings`: Optional row appearance.
// ## Returns
// The tree leaf element.
public function Leaf of TMsg(
  Id: string;
  Label: string;
  OnActivate: (Sys.Func of TMsg)? := null;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).TreeNode(
    Id,
    Label,
    null,
    [],
    null,
    OnActivate,
    Settings ?? new Options()
  );
end function;

end unit;
