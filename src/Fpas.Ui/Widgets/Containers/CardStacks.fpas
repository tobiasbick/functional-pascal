// [Documentation](../../../../docs/ui/gui/social-and-media/card-stack.md)

unit Fpas.Ui.Widgets.Containers.CardStacks;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Direction of a card dismissal.
public type Direction = enum: byte
  // The card left through the physical left edge.
  Left;
  // The card left through the physical right edge.
  Right;
end enum;

// Native card stack options.
public type Options = record
  // Preferred deck width. Content uses CUI's preferred width of 320 logical units.
  public Width: L.Extent := L.Extent.Content;
  // Logical height of one card, or zero for 320 logical units.
  public Height: float := 0.0F;
  // Number of visible cards, or zero for three.
  public Visible: int := 0;
  // Allow card dismissal.
  public Enabled: bool := true;
end record;

// Builds the native graphical card stack.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Cards`: Card bodies, starting with the top card.
// - `Change`: Maps the direction of the dismissed card.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function CardStack of TMsg(
  Id: string;
  Cards: array of E.Element of TMsg;
  Change: function(Direction): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).CardStack(Id, Cards, Change, Settings ?? new Options());
end function;

end unit;
