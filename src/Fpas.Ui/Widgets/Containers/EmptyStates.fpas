// [Documentation](../../../../docs/ui/gui/feedback/empty-state.md)

unit Fpas.Ui.Widgets.Containers.EmptyStates;

uses Fpas.Ui.Elements as E;

uses System as Sys;

// Native empty-state settings.
public type Options = record
  // CUI glyph. Null omits the icon area. Empty text reserves a blank icon area.
  public Icon: string? := null;
  // Supporting text. Null omits it. Empty text reserves a blank line.
  public Description: string? := null;
  // Action caption. Null omits the button. Empty text shows only its plus icon.
  public ActionLabel: string? := null;
  // Whether the action accepts input.
  public Enabled: bool := true;
end record;

// Addresses the optional native action for focus and inspection.
// ## Parameters
// - `Id`: Stable empty state identity.
// ## Returns
// The action identity.
public function ActionId(Id: string): string;
begin
  return Id + '/action';
end function;

// Draws a native empty state with an optional action.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity.
// - `Title`: Literal heading.
// - `Settings`: Optional description, glyph and action caption.
// - `OnAction`: Optional message factory for the native action button.
// ## Returns
// The graphical element.
public function EmptyState of TMsg(
  Id: string;
  Title: string;
  Settings: Options? := null;
  OnAction: (Sys.Func of TMsg)? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).EmptyState(Id, Title, Settings ?? new Options(), OnAction);
end function;

end unit;
