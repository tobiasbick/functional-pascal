// [Documentation](../../../../docs/ui/gui/social-and-media/chat-divider.md)

unit Fpas.Ui.Widgets.Conversation.ChatDividers;

uses Fpas.Ui.Elements as E;

// Draws a native labeled conversation divider.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Label`: Divider caption.
// ## Returns
// The graphical element.
public function ChatDivider of TMsg(Id: string; Label: string): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).ChatDivider(Id, Label);
end function;

end unit;
