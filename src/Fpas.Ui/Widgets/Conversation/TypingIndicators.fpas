// [Documentation](../../../../docs/ui/gui/social-and-media/typing-indicator.md)

unit Fpas.Ui.Widgets.Conversation.TypingIndicators;

uses Fpas.Ui.Elements as E;

// Draws the native typing indicator.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Name`: Name shown as an avatar.
// ## Returns
// The graphical element.
public function TypingIndicator of TMsg(Id: string; Name: string): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).TypingIndicator(Id, Name);
end function;

end unit;
