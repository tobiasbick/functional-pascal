unit Fpas.Ui.Widgets.Desktop.SplitViews;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Native allocation and orientation of a split view.
public type Options = record
  // Width of the split view.
  public Width: L.Extent := L.Extent.Fill;
  // Height of the split view.
  public Height: L.Extent := L.Extent.Fill;
  // Stack the panes vertically.
  public Vertical: bool := false;
  // Minimum first pane on the split axis. Zero uses the native default.
  public MinimumFirst: float := 0.0F;
  // Minimum second pane on the split axis. Zero uses the native default.
  public MinimumSecond: float := 0.0F;
end record;

// Lays out two children with CUI's draggable divider.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable split identity.
// - `Ratio`: Share of the first pane, from zero to one.
// - `First`: First pane contents.
// - `Second`: Second pane contents.
// - `OnResize`: Maps the proposed new share to a message.
// - `Settings`: Optional native allocation.
// ## Returns
// A graphical element.
public function SplitView<TMsg>(Id: string; Ratio: float; First: E.Element<TMsg>; Second: E.Element<TMsg>; OnResize: function(float): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.SplitView(Id, Ratio, First, Second, OnResize, Settings ?? new Options());
end function;

end unit;
