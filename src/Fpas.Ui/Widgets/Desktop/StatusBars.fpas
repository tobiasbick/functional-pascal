unit Fpas.Ui.Widgets.Desktop.StatusBars;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S;

// Text and icon for an entry in a native status bar.
public type Label = record
  // Visible caption.
  public Text: string;
  // Optional CUI icon glyph.
  public Icon: string := '';
  // Native color of the icon.
  public Tone: S.Tone := S.Tone.Neutral;
end record;

// Items shown in a native status bar.
// ## Type parameters
// - `TMsg`: Application message type.
public type Item<TMsg> = variant
  // Static text and optional icon.
  Text(Value: Label);
  // Clickable item with a stable key, optional tooltip and a message.
  Action(Key: string; Value: Label; Tooltip: string; Enabled: bool; Clicked: TMsg);
  // Progress from zero to one, with a label and optional logical width.
  Progress(Value: float; Caption: string; Width: float; Indeterminate: bool);
  // Send the following items to the far edge.
  Spacer;
end variant;

// Draws a native status bar.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable element identity.
// - `Items`: Contents in display order.
// - `HideBorder`: Omit the native top hairline.
// ## Returns
// A graphical element.
public function StatusBar<TMsg>(Id: string; Items: array of Item<TMsg>; HideBorder: bool := false): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.StatusBar(Id, Items, HideBorder);
end function;

end unit;
