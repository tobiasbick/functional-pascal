// [Documentation](../../../../docs/ui/gui/canvas-and-bars/toolbar.md)

unit Fpas.Ui.Widgets.Desktop.Toolbars;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Styles as S;

// An ordinary, toggle or primary toolbar button.
public type Button = record
  // Icon glyph, or null for a text button.
  public Icon: string?;
  // Visible text or null for an icon-only button.
  public Label: string? := null;
  // Tooltip or overflow menu name.
  public Tooltip: string? := null;
  // Optional key hint.
  public Shortcut: string? := null;
  // Pressed state for an ordinary button, or null for a momentary action.
  public Toggle: bool? := null;
  // Whether this action is unavailable.
  public Disabled: bool := false;
  // Semantic color for an ordinary button.
  public Tone: S.Tone := S.Tone.Neutral;
  // Draws the native flyout marker.
  public Flyout: bool := false;
end record;

// Appearance and interaction settings for a cycling choice.
public type CycleOptions = record
  // Hover caption and prefix for the choice in the overflow menu.
  public Tooltip: string? := null;
  // Optional key hint in the tooltip.
  public Shortcut: string? := null;
  // Whether this choice is unavailable.
  public Disabled: bool := false;
  // Semantic color of the visible caption.
  public Tone: S.Tone := S.Tone.Neutral;
  // Draws the native flyout marker.
  public Flyout: bool := false;
end record;

// Toolbar layout and interaction settings.
public type Options = record
  // Native style (0 plain, 1 grouped, 2 floating).
  public Style: int := 0;
  // Hides the plain toolbar hairline.
  public HideBorder: bool := false;
  // Whether the toolbar accepts input.
  public Enabled: bool := true;
end record;

// A toolbar item was activated or changed.
public type Event = record
  // Zero-based actionable item in traversal order.
  public Index: int;
  // Proposed index for choices, 0/1 for toggles or 0 for momentary actions.
  public Value: int;
end record;

// A toolbar item or native layout marker.
public type Item = variant
  // An ordinary action or toggle.
  Button(Value: Button);
  // A larger filled action.
  Primary(Value: Button);
  // An inset set of mutually exclusive icons. Labels name the icons in the overflow menu.
  Radio(Icons: array of string; Labels: (array of string)?; Selected: int);
  // A button that advances through the available options.
  Cycle(Labels: array of string; Selected: int; Settings: CycleOptions?);
  // Opens a raised group or separates groups in a plain or floating bar.
  Group(Items: array of Item);
  // Draws a separator.
  Separator;
  // Pushes later items toward the end.
  Spacer;
end variant;

// Builds the native Toolbar element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Items`: Buttons, choices and groups in display order.
// - `Changed`: Maps native proposals to messages.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function Toolbar of TMsg(
  Id: string;
  Items: array of Item;
  Changed: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).Toolbar(Id, Items, Changed, Settings ?? new Options());
end function;

end unit;
