// [Documentation](../../../../docs/ui/gui/more-developer-tools/blame.md)

unit Fpas.Ui.Widgets.Developer.Blames;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Data for the native Blame widget.
public type Revision = record
  // Revision hash. The gutter displays up to seven characters.
  public Hash: string;
  // Revision author.
  public Author: string;
  // Optional summary for the gutter tooltip.
  public Summary: string?;
  // Revision time in Unix seconds. Zero omits the displayed age.
  public Time: long;
end record;

// Action or changed value reported by the native widget.
public type Event = record
  // Clicked zero-based index, or minus one.
  public Clicked: int;
  // Hovered zero-based index, or minus one outside an attributed gutter.
  public Hovered: int := -1;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Height in logical units, zero for 360, or negative to fill the parent.
  public Height: float := 0.0F;
  // Language used to highlight source lines.
  public Language: string := '';
  // Reference time in Unix seconds. Zero uses the system clock.
  public Now: long := 0L;
  // First displayed source line number. A value below one starts at one.
  public FirstLine: int := 0;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native Blame widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Lines`: Source lines in display order.
// - `LineCommits`: One zero-based revision index or minus one per line. An empty array omits attribution.
// - `Revisions`: Revision records addressed by `LineCommits`.
// - `Changed`: Maps a revision click or hover change to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function Blame of TMsg(
  Id: string;
  Lines: array of string;
  LineCommits: array of int;
  Revisions: array of Revision;
  Changed: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).Blame(
    Id,
    Lines,
    LineCommits,
    Revisions,
    Changed,
    Settings ?? new Options()
  );
end function;

end unit;
