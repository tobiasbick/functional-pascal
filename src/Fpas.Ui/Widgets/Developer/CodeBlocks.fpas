// [Documentation](../../../../docs/ui/gui/code/code-block.md)

unit Fpas.Ui.Widgets.Developer.CodeBlocks;

uses Fpas.Ui.Elements as E;

// Native code display options.
public type Options = record
  // Case-sensitive syntax language, such as c, python or sql. Null omits the language.
  public Language: string? := null;
  // Literal title in the header. Null omits the title.
  public Title: string? := null;
  // Whether to show line numbers.
  public LineNumbers: bool := false;
  // First highlighted line, or zero.
  public HighlightFrom: int := 0;
  // Last highlighted line, or zero for a single line.
  public HighlightTo: int := 0;
  // Maximum code viewport height, or zero for no limit.
  public MaxHeight: float := 0.0F;
  // Font size, or zero for the native default.
  public Size: float := 0.0F;
  // Hide the title bar and copy button.
  public NoHeader: bool := false;
end record;

// Addresses the native copy button for inspection and focus.
// ## Parameters
// - `Id`: Stable code block identity.
// ## Returns
// The identity of the copy button when the header is visible.
public function CopyId(Id: string): string;
begin
  return Id + '/copy';
end function;

// Reports whether the options display the native header and copy button.
// ## Parameters
// - `Settings`: Native code display options.
// ## Returns
// True when the native header is visible.
public function HasHeader(Settings: Options): bool;
begin
  return not Settings.NoHeader and (Settings.Title <> null or Settings.Language <> null);
end function;

// Draws the native CUI code block.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Code`: Literal source text.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function CodeBlock of TMsg(
  Id: string;
  Code: string;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).CodeBlock(Id, Code, Settings ?? new Options());
end function;

end unit;
