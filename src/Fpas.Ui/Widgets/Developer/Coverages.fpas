// [Documentation](../../../../docs/ui/gui/more-developer-tools/coverage.md)

unit Fpas.Ui.Widgets.Developer.Coverages;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Coverage totals for a file.
public type File = record
  // Path used to place the file in the folder tree.
  public Path: string;
  // Number of coverable lines.
  public Lines: int;
  // Number of covered lines.
  public LinesHit: int;
  // Number of coverable branches.
  public Branches: int;
  // Number of covered branches.
  public BranchesHit: int;
  // Number of coverable functions.
  public Functions: int;
  // Number of covered functions.
  public FunctionsHit: int;
end record;

// File activation and aggregate line coverage.
public type Event = record
  // Activated zero-based file index, or minus one.
  public Activated: int;
  // Percentage of covered lines across all input files.
  public Lines: float;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Height in logical units. Zero fits the rows up to 360 units. Negative values fill the available height.
  public Height: float := 0.0F;
  // Lower percentage threshold for the line, branch and function colors. Zero uses 50.
  public Low: float := 0.0F;
  // Upper percentage threshold for the line, branch and function colors. Zero uses 80.
  public High: float := 0.0F;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
  // Last reported line percentage. Null omits messages caused only by a changed aggregate.
  public ReportedLines: float? := null;
end record;

// Builds the native Coverage widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Files`: Model-owned paths and coverage counts.
// - `Changed`: Maps an activation or aggregate change to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function Coverage of TMsg(
  Id: string;
  Files: array of File;
  Changed: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).Coverage(Id, Files, Changed, Settings ?? new Options());
end function;

end unit;
