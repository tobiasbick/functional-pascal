// [Documentation](../../../../docs/ui/gui/developer-tools/dependency-graph.md)

unit Fpas.Ui.Widgets.Developer.DependencyGraphs;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Data for the native DependencyGraph widget.
public type Vertex = record
  // Label supplied to CUI.
  public Label: string;
  // Detail supplied to CUI.
  public Detail: string?;
  // Native Fpas.Ui.Styles.Tone ordinal.
  public Tone: int;
end record;

// Data for the native DependencyGraph widget.
public type Edge = record
  // From supplied to CUI.
  public From: int;
  // To supplied to CUI.
  public To: int;
end record;

// Action or changed value reported by the native widget.
public type Event = record
  // Selected zero-based index, or minus one.
  public Selection: int;
  // Clicked zero-based index, or minus one.
  public Clicked: int;
  // Activated zero-based index, or minus one.
  public Activated: int;
  // Hovered zero-based index, or minus one.
  public Hovered: int := -1;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Card height, or zero for the native 360-unit default.
  public Height: float := 0.0F;
  // Top Down supplied to CUI.
  public TopDown: bool := false;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
  // Last reported hover index. Null omits messages caused only by hover.
  public Hovered: int? := null;
end record;

// Builds the native DependencyGraph widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Vertices`: Model-owned vertices data.
// - `Edges`: Model-owned edges data.
// - `Selection`: Selected zero-based index, minus one for none, or null to let CUI retain it.
// - `Changed`: Maps an action or edit to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function DependencyGraph of TMsg(
  Id: string;
  Vertices: array of Vertex;
  Edges: array of Edge;
  Selection: int?;
  Changed: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).DependencyGraph(
    Id,
    Vertices,
    Edges,
    Selection,
    Changed,
    Settings ?? new Options()
  );
end function;

end unit;
