// [Documentation](../../../../docs/ui/gui/code/json-viewer.md)

unit Fpas.Ui.Widgets.Developer.JsonViews;

uses Fpas.Ui.Elements as E;

// Native JSON viewer options.
public type Options = record
  // Initially expanded depth, or zero for CUI's default of two levels.
  public ExpandDepth: int := 0;
  // Maximum viewport height in logical units, or zero for no widget limit.
  public MaxHeight: float := 0.0F;
end record;

// Draws the native CUI JSON viewer.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Json`: Literal JSON, including invalid text to display a parse error.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function JsonView of TMsg(
  Id: string;
  Json: string;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).JsonView(Id, Json, Settings ?? new Options());
end function;

end unit;
