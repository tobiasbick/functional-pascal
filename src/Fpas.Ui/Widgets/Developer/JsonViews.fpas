unit Fpas.Ui.Widgets.Developer.JsonViews;

uses Fpas.Ui.Elements as E;

// Native JSON viewer options.
public type Options = record
  // Initially expanded depth, or zero for the native default.
  public ExpandDepth: int := 0;
  // Maximum viewport height, or zero for no limit.
  public MaxHeight: float := 0.0F;
end record;

// Draws the native CUI json view.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Json`: Literal JSON, including invalid text to display a parse error.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function JsonView<TMsg>(Id: string; Json: string; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.JsonView(Id, Json, Settings ?? new Options());
end function;

end unit;
