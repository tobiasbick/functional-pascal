// [Documentation](../../../../docs/ui/gui/more-developer-tools/regex-tester.md)

unit Fpas.Ui.Widgets.Developer.RegexTesters;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Action or changed value reported by the native widget.
public type Event = record
  // Pattern supplied to CUI.
  public Pattern: string;
  // Sample supplied to CUI.
  public Sample: string;
  // Modifiers supplied to CUI.
  public Modifiers: int;
  // Whether the current input is valid.
  public Valid: bool;
  // Number of matches reported by CUI.
  public Matches: int;
  // Diagnostic for an invalid pattern or a match that exceeds the CUI budget.
  public Error: string? := null;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Pattern Capacity supplied to CUI.
  public PatternCapacity: int := 127;
  // Text Capacity supplied to CUI.
  public TextCapacity: int := 1023;
  // Sample editor height in logical units. Zero uses 180 logical units.
  public Height: float := 0.0F;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native RegexTester widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Pattern`: Model-owned pattern data.
// - `Sample`: Model-owned sample data.
// - `Modifiers`: Model-owned modifiers or null for native modifiers.
// - `Changed`: Maps an action or edit to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function RegexTester of TMsg(
  Id: string;
  Pattern: string;
  Sample: string;
  Modifiers: int?;
  Changed: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).RegexTester(
    Id,
    Pattern,
    Sample,
    Modifiers,
    Changed,
    Settings ?? new Options()
  );
end function;

end unit;
