// [Documentation](../../../../docs/ui/gui/more-developer-tools/http-request-bar.md)

unit Fpas.Ui.Widgets.Developer.RequestBars;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Request draft and actions reported by the native widget.
public type Event = record
  // Selected HTTP method index.
  public Method: int;
  // Current URL draft.
  public Url: string;
  // Whether the user requests submission.
  public Send: bool;
  // Whether the user requests cancellation.
  public Cancel: bool;
  // Whether the user edited the method or URL in this frame.
  public Changed: bool := false;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Maximum URL length in UTF-8 bytes.
  public Capacity: int := 255;
  // Show Cancel and suppress submission from the URL field.
  public Loading: bool := false;
  // Caption for an empty URL. Null uses the native caption.
  public Placeholder: string? := null;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native RequestBar widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Method`: Model-owned HTTP method index from 0 (GET) to 6 (OPTIONS).
// - `Url`: Model-owned URL draft.
// - `Changed`: Maps an action or edit to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function RequestBar of TMsg(
  Id: string;
  Method: int;
  Url: string;
  Changed: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).RequestBar(Id, Method, Url, Changed, Settings ?? new Options());
end function;

end unit;
