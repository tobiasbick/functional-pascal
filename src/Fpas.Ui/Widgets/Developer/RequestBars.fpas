unit Fpas.Ui.Widgets.Developer.RequestBars;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Action or changed value reported by the native widget.
public type Event = record
  // Method supplied to CUI.
  public Method: int;
  // Url supplied to CUI.
  public Url: string;
  // Send supplied to CUI.
  public Send: bool;
  // Cancel supplied to CUI.
  public Cancel: bool;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Maximum entries or UTF-8 bytes, as applicable.
  public Capacity: int := 255;
  // Loading supplied to CUI.
  public Loading: bool := false;
  // Placeholder supplied to CUI.
  public Placeholder: string := '';
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native RequestBar widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Method`: Model-owned method data.
// - `Url`: Model-owned url data.
// - `Changed`: Maps an action or edit to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function RequestBar<TMsg>(Id: string; Method: int; Url: string; Changed: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.RequestBar(Id, Method, Url, Changed, Settings ?? new Options());
end function;

end unit;
