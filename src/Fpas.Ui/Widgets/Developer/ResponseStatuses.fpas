// [Documentation](../../../../docs/ui/gui/more-developer-tools/http-response-status.md)

unit Fpas.Ui.Widgets.Developer.ResponseStatuses;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Content;
  // Whether the host presents the widget as enabled.
  public Enabled: bool := true;
end record;

// Builds the native ResponseStatus widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Status`: HTTP status code, or a nonpositive value before a response.
// - `Seconds`: Finite elapsed seconds, or a negative value to omit the time.
// - `Bytes`: Finite response size in bytes, or a negative value to omit the size.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function ResponseStatus of TMsg(
  Id: string;
  Status: int;
  Seconds: double;
  Bytes: double;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).ResponseStatus(Id, Status, Seconds, Bytes, Settings ?? new Options());
end function;

end unit;
