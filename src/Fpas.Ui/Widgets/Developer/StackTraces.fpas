unit Fpas.Ui.Widgets.Developer.StackTraces;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Data for the native StackTrace widget.
public type Frame = record
  // Function Name supplied to CUI.
  public FunctionName: string?;
  // File supplied to CUI.
  public File: string?;
  // Line supplied to CUI.
  public Line: int;
  // Column supplied to CUI.
  public Column: int;
  // External supplied to CUI.
  public External: bool;
  // Source supplied to CUI.
  public Source: array of string;
  // Source First supplied to CUI.
  public SourceFirst: int;
end record;

// Action or changed value reported by the native widget.
public type Event = record
  // Clicked zero-based index, or minus one.
  public Clicked: int;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Title supplied to CUI.
  public Title: string := '';
  // Message supplied to CUI.
  public Message: string := '';
  // Language supplied to CUI.
  public Language: string := '';
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native StackTrace widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Frames`: Model-owned frames data.
// - `Changed`: Maps an action or edit to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function StackTrace<TMsg>(Id: string; Frames: array of Frame; Changed: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.StackTrace(Id, Frames, Changed, Settings ?? new Options());
end function;

end unit;
