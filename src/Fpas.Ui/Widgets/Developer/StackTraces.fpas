// [Documentation](../../../../docs/ui/gui/more-developer-tools/stack-trace.md)

unit Fpas.Ui.Widgets.Developer.StackTraces;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Data for the native StackTrace widget.
public type Frame = record
  // Function name. Null or empty displays as `<anonymous>`.
  public FunctionName: string?;
  // Optional source file path.
  public File: string?;
  // One-based source line, or zero to omit the line and column.
  public Line: int;
  // One-based source column, or zero to omit the column.
  public Column: int;
  // Whether the frame belongs to a library or runtime.
  public External: bool;
  // Source lines around the frame location. An empty array omits the preview.
  public Source: array of string;
  // Display number of the first preview line.
  public SourceFirst: int;
end record;

// Action or changed value reported by the native widget.
public type Event = record
  // Clicked zero-based index, or minus one.
  public Clicked: int;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Optional error heading.
  public Title: string := '';
  // Optional error message.
  public Message: string := '';
  // Language used to highlight source previews.
  public Language: string := '';
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native StackTrace widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Frames`: Model-owned frames data.
// - `Changed`: Maps an activated frame to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function StackTrace of TMsg(
  Id: string;
  Frames: array of Frame;
  Changed: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).StackTrace(Id, Frames, Changed, Settings ?? new Options());
end function;

end unit;
