unit Fpas.Ui.Widgets.Developer.Terminals;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Terminal input proposed by CUI.
public type Event = variant
  // Submitted command line.
  Command(Text: string);
  // Ctrl+C without a selection.
  Interrupt;
end variant;

// Native Terminal configuration.
public type Options = record
  // Preferred width.
  public Width: L.Extent := L.Extent.Fill;
  // Logical height, zero for the native default or minus one to fill.
  public Height: float := 0.0F;
  // Font size, or zero for the native default.
  public Size: float := 0.0F;
  // Prompt printed and echoed by CUI.
  public Prompt: string := '$ ';
  // Show the command input line.
  public Input: bool := true;
end record;

// Creates a graphical Terminal.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Output`: Cumulative output, with optional ANSI formatting.
// - `Revision`: Change to explicitly clear the scrollback before replaying the supplied output.
// - `Received`: Maps submissions and interrupts.
// - `Settings`: Native presentation options.
// ## Returns
// A graphical view element.
public function Terminal<TMsg>(Id: string; Output: string; Revision: int; Received: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Terminal(Id, Output, Revision, Received, Settings ?? new Options());
end function;

end unit;
