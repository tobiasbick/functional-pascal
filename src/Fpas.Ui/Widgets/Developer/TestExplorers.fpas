// [Documentation](../../../../docs/ui/gui/more-developer-tools/test-explorer.md)

unit Fpas.Ui.Widgets.Developer.TestExplorers;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Data for the native TestExplorer widget.
public type Item = record
  // Display name used by the name filter.
  public Name: string;
  // Nesting depth from zero through 63.
  public Depth: int;
  // Pipeline status code from zero through five.
  public Status: int;
  // Duration in seconds, or negative when unavailable.
  public Duration: float;
  // Optional failure detail.
  public Message: string?;
end record;

// Action or changed value reported by the native widget.
public type Event = record
  // Selected zero-based index, or minus one.
  public Selected: int;
  // Activated zero-based index, or minus one.
  public Activated: int;
  // Zero-based index of the item requested to run, or minus one.
  public Run: int;
  // Whether the user requested a run of all tests.
  public RunAll: bool;
  // Number of passing tests.
  public Passed: int;
  // Number of failing tests.
  public Failed: int;
  // Number of skipped or canceled tests.
  public Skipped: int;
  // Number of tests across all statuses.
  public Total: int;
end record;

// Native layout and interaction options.
public type Options = record
  // Native preferred layout width.
  public Width: L.Extent := L.Extent.Fill;
  // Height in logical units, zero for 320, or negative to fill the parent.
  public Height: float := 0.0F;
  // Whether the widget accepts interaction.
  public Enabled: bool := true;
end record;

// Builds the native TestExplorer widget.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Entries`: Model-owned entries data.
// - `Changed`: Maps a run request, activation, selection change or count change to a message.
// - `Settings`: Optional native settings.
// ## Returns
// A graphical element.
public function TestExplorer of TMsg(
  Id: string;
  Entries: array of Item;
  Changed: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).TestExplorer(Id, Entries, Changed, Settings ?? new Options());
end function;

end unit;
