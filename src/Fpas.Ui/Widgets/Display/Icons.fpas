// [Documentation](../../../../docs/ui/gui/text-and-display/icon.md)

unit Fpas.Ui.Widgets.Display.Icons;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;

// Creates a native CUI icon element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Glyph`: CUI icon glyph.
// - `Size`: Logical icon size. Zero uses the default.
// - `Color`: Explicit color, or null for the foreground.
// ## Returns
// A graphical element.
public function Icon of TMsg(
  Glyph: string;
  Size: float := 0.0F;
  Color: G.Color? := null
): E.Element of TMsg;
begin
  return (E.Element of TMsg).Icon(Glyph, Size, Color);
end function;

end unit;
