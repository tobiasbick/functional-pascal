unit Fpas.Ui.Widgets.Display.Icons;

uses Fpas.Ui.Elements as E, Fpas.Ui.Graphics as G;

// Creates a native CUI icon element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Glyph`: CUI icon glyph.
// - `Size`: Logical icon size. Zero uses the default.
// - `Color`: Explicit color, or null for the foreground.
// ## Returns
// A graphical element.
public function Icon<TMsg>(Glyph: string; Size: float := 0.0F; Color: G.Color? := null): E.Element<TMsg>;
begin
  return E.Element<TMsg>.Icon(Glyph, Size, Color);
end function;

end unit;
