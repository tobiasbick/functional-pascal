// [Documentation](../../../../docs/ui/gui/disclosure/link.md)

unit Fpas.Ui.Widgets.Display.Links;

uses Fpas.Ui.Elements as E;

// Builds a native inline link that proposes an application action.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable link identity.
// - `Label`: Literal caption.
// - `OnActivate`: Message proposed on pointer or keyboard activation.
// - `Enabled`: Whether the link accepts input.
// ## Returns
// The graphical link.
public function Link of TMsg(
  Id: string;
  Label: string;
  OnActivate: TMsg;
  Enabled: bool := true
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).LinkAction(Id, Label, OnActivate, Enabled);
end function;

end unit;
