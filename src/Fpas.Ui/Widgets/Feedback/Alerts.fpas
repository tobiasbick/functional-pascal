// [Documentation](../../../../docs/ui/gui/feedback/alert.md)

unit Fpas.Ui.Widgets.Feedback.Alerts;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Styles as S;

uses System as Sys;

// Inline alert presentation and input options.
public type Options = record
  // Supporting text below the title.
  public Description: string := '';
  // Semantic surface and icon color.
  public Tone: S.Tone := S.Tone.Neutral;
  // Optional CUI icon-font glyph; empty selects the native tone icon.
  public Icon: string := '';
  // Whether the host supplies a dismiss action.
  public Dismissible: bool := false;
  // Whether the dismiss action accepts input.
  public Enabled: bool := true;
end record;

// Builds an inline alert whose dismissal state belongs to the host.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable identity; removing the element releases its dismissal state.
// - `Title`: Literal alert heading.
// - `Settings`: Text, tone, graphical icon and dismissal options.
// - `OnDismiss`: Optional notification delivered once after dismissal.
// ## Returns
// An alert for the graphical or terminal host, hidden after dismissal until removed and reinserted.
public function Alert of TMsg(
  Id: string; Title: string; Settings: Options? := null;
  OnDismiss: (Sys.Func of TMsg)? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).Alert(Id, Title, Settings ?? new Options(), OnDismiss);
end function;

// Gets the application identity of the optional dismiss action.
// ## Parameters
// - `Id`: Alert identity.
// ## Returns
// The identity followed by /dismiss.
public function DismissId(Id: string): string;
requires Id <> '';
begin
  return Id + '/dismiss';
end function;

end unit;
