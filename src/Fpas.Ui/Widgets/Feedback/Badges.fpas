unit Fpas.Ui.Widgets.Feedback.Badges;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S, Fpas.Ui.Widgets.Actions.Buttons as B;

// Appearance of a native badge.
public type Options = record
  // Semantic tint or fill.
  public Tone: S.Tone := S.Tone.Neutral;
  // Draw a leading status dot.
  public Dot: bool := false;
  // Use a solid fill.
  public Solid: bool := false;
  // Optional CUI glyph.
  public Icon: string := '';
  // Native control size.
  public Size: B.Size := B.Size.Medium;
end record;

// Draws a native badge with literal text.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable inspection identity.
// - `Text`: Badge caption.
// - `Settings`: Optional appearance.
// ## Returns
// The graphical element.
public function Badge<TMsg>(Id: string; Text: string; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Badge(Id, Text, Settings ?? new Options());
end function;

end unit;
