unit Fpas.Ui.Widgets.Feedback.Banners;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S, System as Sys;

// Presentation and input settings for a native banner.
public type Options = record
  // Tone used by the announcement and its action.
  public Tone: S.Tone := S.Tone.Accent;
  // Optional native icon glyph.
  public Icon: string := '';
  // Action caption. Empty hides the action.
  public ActionLabel: string := '';
  // Whether the action and close button accept input.
  public Enabled: bool := true;
end record;

// Addresses the banner's optional action.
// ## Parameters
// - `Id`: Stable banner identity.
// ## Returns
// The focus and inspection identity of the action.
public function ActionId(Id: string): string;
begin
  return Id + '/action';
end function;

// Addresses the banner's optional close button.
// ## Parameters
// - `Id`: Stable banner identity.
// ## Returns
// The focus and inspection identity of the dismiss button.
public function DismissId(Id: string): string;
begin
  return Id + '/dismiss';
end function;

// Builds a native announcement banner with model-owned visibility.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable banner identity.
// - `Text`: Literal announcement.
// - `Open`: Whether the banner is open.
// - `OnDismiss`: Optional message factory for the close button.
// - `OnAction`: Optional message factory paired with the action caption.
// - `Settings`: Optional tone, icon, action caption and input settings.
// ## Returns
// The graphical banner.
public function Banner<TMsg>(
  Id: string; Text: string; Open: bool; OnDismiss: Sys.Func<TMsg>? := null;
  OnAction: Sys.Func<TMsg>? := null; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Banner(Id, Text, Open, OnDismiss, OnAction, Settings ?? new Options());
end function;

end unit;
