// [Documentation](../../../../docs/ui/gui/feedback/skeleton-group.md)

unit Fpas.Ui.Widgets.Feedback.SkeletonGroups;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Native skeleton group options.
public type Options = record
  // Fill, a fixed logical width or a percentage of the parent.
  public Width: L.Extent := L.Extent.Fill;
  // Spacing in logical units. Zero uses the native default of 8.
  public Gap: float := 0.0F;
  // Use a shared sweep of ordered dots.
  public Dither: bool := false;
end record;

// Builds a native group of placeholders with a shared animation.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Children`: Placeholder views in native layout order.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function SkeletonGroup of TMsg(
  Id: string;
  Children: array of E.Element of TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).SkeletonGroup(Id, Children, Settings ?? new Options());
end function;

end unit;
