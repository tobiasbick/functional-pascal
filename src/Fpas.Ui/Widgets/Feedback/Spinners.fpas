// [Documentation](../../../../docs/ui/gui/feedback/spinner.md)

unit Fpas.Ui.Widgets.Feedback.Spinners;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

// Activity styles used by the graphical and terminal hosts.
public type Style = enum: byte
  // Sweeping ring.
  Arc;
  // Dotted ring with a trailing head.
  Comet;
  // Animated matrix of dots.
  DotMatrix;
  // Tile filling and draining.
  FillDrain;
  // Sweeping radar dial.
  Radar;
  // Rippling rings.
  Ripple;
  // Streaming up chevrons.
  Upload;
  // Streaming down chevrons.
  Download;
  // Chevrons in both directions.
  Transfer;
  // Orbiting dots.
  Orbit;
  // Bouncing dots.
  Bounce;
  // Scanning line.
  Scan;
  // Pulsing disc.
  Pulse;
  // Rotating spiral.
  Spiral;
  // Slow noise in a tile.
  Plasma;
end enum;

// Spinner presentation options.
public type Options = record
  // Animation geometry.
  public Animation: Style := Style.Arc;
  // Explicit ink color. Omit it and ThemeColor for the native default.
  public Color: G.Color? := null;
  // Active theme ink color. Choose this or Color.
  public ThemeColor: Themes.ColorToken? := null;
  // Explicit track color for dotted GUI styles.
  public Track: G.Color? := null;
  // Active theme track color for dotted GUI styles. Choose this or Track.
  public ThemeTrack: Themes.ColorToken? := null;
end record;

// Builds an activity spinner for the graphical or terminal host.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable spinner identity.
// - `Size`: Height in logical units. Zero uses CUI's default.
// - `Settings`: Optional activity style and colors.
// ## Returns
// A spinner drawn and animated by its host.
public function Spinner of TMsg(
  Id: string;
  Size: float := 0.0F;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
requires Size >= 0.0F;
begin
  return (E.Element of TMsg).Spinner(Id, Size, Settings);
end function;

end unit;
