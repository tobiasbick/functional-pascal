// [Documentation](../../../../docs/ui/gui/feedback/status-spinner.md)

unit Fpas.Ui.Widgets.Feedback.StatusSpinners;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Actions.StatusButtons as Buttons;
uses Fpas.Ui.Widgets.Charts.Charts as Charts;

// Native statusspinner options.
public type Options = record
  // Logical diameter, or zero for the default.
  public Size: float := 0.0F;
  // Busy ring color.
  public Color: Charts.Color := Charts.Color.Automatic;
  // Retain the success or error marker.
  public Keep: bool := false;
end record;

// Draws the native status spinner and its result transition.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Status`: Current work state.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function StatusSpinner of TMsg(
  Id: string;
  Status: Buttons.Status;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).StatusSpinner(Id, Status, Settings ?? new Options());
end function;

end unit;
