// [Documentation](../../../../docs/ui/gui/capture/avatar-upload.md)

unit Fpas.Ui.Widgets.Files.AvatarUploads;

uses Fpas.Ui.Elements as E;

uses System as Sys;

// Extensions accepted by CUI for avatar image drops.
public const ImageExtensions: string := 'png;jpg;jpeg;bmp;gif;tga';

// Builds a native avatar that can replace its image from a file.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable avatar identity.
// - `Name`: Display name used for the initials and their background color.
// - `Path`: Model-owned image path. Null or an unavailable image shows initials.
// - `OnDrop`: Maps a successfully decoded drop to a message. Accept by storing the path.
// - `OnBrowse`: Optional message factory for opening a file dialog on click, Enter or Space.
// - `Size`: Finite logical diameter. Nonpositive values use 88.
// - `Enabled`: Whether the avatar accepts focus, browse activation and file drops.
// ## Returns
// The graphical uploadable avatar.
public function AvatarUpload of TMsg(
  Id: string;
  Name: string;
  Path: string?;
  OnDrop: function(string): TMsg;
  OnBrowse: (Sys.Func of TMsg)? := null;
  Size: float := 88.0F;
  Enabled: bool := true
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).AvatarUpload(Id, Name, Path, OnDrop, OnBrowse, Size, Enabled);
end function;

end unit;
