unit Fpas.Ui.Widgets.Files.FileListings;

// One child returned by a file-listing provider.
public type Entry = record
  // Name relative to the requested folder.
  public Name: string;
  // Whether the entry is a directory.
  public Directory: bool := false;
  // Byte size of a file.
  public Size: ulong := 0UL;
  // Modification time in Unix seconds. Zero means unknown.
  public Modified: long := 0L;
end record;

// A readable folder and its children. A null result represents an unreadable folder.
public type Listing = record
  // Directory contents. The provider respects the requested hidden-file mode.
  public Entries: array of Entry;
end record;

end unit;
