// [Documentation](../../../../docs/ui/gui/capture/signature-pad.md)

unit Fpas.Ui.Widgets.Files.SignaturePads;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.Charts as Charts;

uses System as Sys;

// A point in CUI's logical signature drawing space.
public type Point = record
  // Horizontal coordinate.
  public X: float;
  // Vertical coordinate.
  public Y: float;
end record;

// Detached signature points and stroke boundaries.
public type Signature = record
  // Points in recording order.
  public Points: array of Point;
  // Exclusive end point index of each stroke.
  public StrokeEnds: array of int;
end record;

// Display and input settings for a native signature pad.
public type Options = record
  // Native width. Content and Fill both fill the available width.
  public Width: L.Extent := L.Extent.Fill;
  // Height in logical units. Nonpositive values use the native default of 180.
  public Height: float := 0.0F;
  // Literal instruction. Null selects the native default.
  public Placeholder: string? := null;
  // Active theme color or explicit ink. Automatic uses the foreground color.
  public Ink: Charts.Color := Charts.Color.Automatic;
  // Whether the pad accepts drawing and clearing.
  public Enabled: bool := true;
end record;

// Addresses the native Clear button when the pad has strokes.
// ## Parameters
// - `Id`: Stable pad identity.
// ## Returns
// The focus and inspection identity for the button.
public function ClearId(Id: string): string;
begin
  return Id + '/clear';
end function;

// Builds a CUI-owned drawing pad with an embedded Clear button.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable pad identity.
// - `OnChange`: Optional callback receiving detached points on drawing and clearing.
// - `Settings`: Optional geometry, ink and input permission.
// ## Returns
// The graphical signature pad.
public function SignaturePad of TMsg(
  Id: string;
  OnChange: Sys.Func of (Signature, TMsg)? := null;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).SignaturePad(Id, OnChange, Settings ?? new Options());
end function;

end unit;
