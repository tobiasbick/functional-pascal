// [Documentation](../../../../docs/ui/gui/selection/checkbox.md)

unit Fpas.Ui.Widgets.Inputs.Checkboxes;

uses Fpas.Ui.Elements as E;

// Creates a model-controlled checkbox for graphical and terminal views.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Label`: Literal caption for the interactive row.
// - `Checked`: Current model-owned value.
// - `OnChange`: Maps a changed value to an application message.
// - `Description`: Secondary text below the caption. Null omits the line.
// - `Enabled`: Whether the row accepts input.
// - `Indeterminate`: Draw a dash in place of the check mark while checked.
// - `HideLabel`: Draw only the checkbox while retaining its accessible label.
// ## Returns
// The control that proposes changes to the model.
public function Checkbox of TMsg(
  Id: string;
  Label: string;
  Checked: bool;
  OnChange: function(bool): TMsg;
  Description: string? := null;
  Enabled: bool := true;
  Indeterminate: bool := false;
  HideLabel: bool := false
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).CheckboxAction(
    Id,
    Label,
    Checked,
    OnChange,
    Description,
    Enabled,
    Indeterminate,
    HideLabel
  );
end function;

end unit;
