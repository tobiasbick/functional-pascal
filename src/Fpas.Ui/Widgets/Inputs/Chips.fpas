// [Documentation](../../../../docs/ui/gui/selection/chip.md)

unit Fpas.Ui.Widgets.Inputs.Chips;

uses Fpas.Ui.Elements as E;

// Creates a native chip with optional model-owned selection.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Label`: Literal caption.
// - `Selected`: Current selection, or null for a stateless chip.
// - `OnChange`: Maps a proposed selection or stateless activation to a message.
// - `Icon`: CUI glyph for the unselected state. Null omits the icon.
// - `Enabled`: Whether the chip accepts input.
// ## Returns
// The chip for the graphical profile.
public function Chip of TMsg(
  Id: string;
  Label: string;
  Selected: bool?;
  OnChange: function(bool?): TMsg;
  Icon: string? := null;
  Enabled: bool := true
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).ChipAction(Id, Label, Selected, OnChange, Icon, Enabled);
end function;

end unit;
