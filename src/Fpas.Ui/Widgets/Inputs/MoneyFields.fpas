// [Documentation](../../../../docs/ui/gui/smart-inputs/money-field.md)

unit Fpas.Ui.Widgets.Inputs.MoneyFields;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Exact CLR decimal editing through a native CUI text field.
public type Options = record
  // Literal caption above the input.
  public Label: string := '';
  // Literal currency prefix; empty omits it.
  public Symbol: string := '$';
  // Literal currency-code suffix.
  public Code: string := '';
  // Supporting text below the input.
  public Hint: string := '';
  // Fractional precision from zero through twenty-eight; values are never implicitly rounded.
  public DecimalPlaces: int := 2;
  // Native content, fill, fixed or percentage width.
  public Width: L.Extent := L.Extent.Content;
  // Whether input is accepted.
  public Enabled: bool := true;
end record;

// Builds an exact decimal editor with invariant grouping at rest and retained text drafts.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Value`: Decimal amount representable at the selected fractional precision.
// - `OnChange`: Maps an exactly representable proposal to a message.
// - `Settings`: Optional currency captions, precision and native width.
// ## Returns
// A graphical model-controlled money field.
public function MoneyField<TMsg>(Id: string; Value: decimal; OnChange: function(decimal): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.MoneyField(Id, Value, OnChange, Settings ?? new Options());
end function;

end unit;
