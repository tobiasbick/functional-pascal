unit Fpas.Ui.Widgets.Inputs.MoneyFields;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L;

// Native money-input presentation; no FPAS monetary scalar type is introduced.
public type Options = record
  // Literal caption above the input.
  public Label: string := '';
  // Literal currency prefix; empty omits it.
  public Symbol: string := '$';
  // Literal currency-code suffix.
  public Code: string := '';
  // Supporting text below the input.
  public Hint: string := '';
  // Fractional precision from zero through fifteen.
  public DecimalPlaces: int := 2;
  // Native content, fill, fixed or percentage width.
  public Width: L.Extent := L.Extent.Content;
  // Whether input is accepted.
  public Enabled: bool := true;
end record;

// Builds CUI's grouped amount display with plain digits while editing.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Value`: Finite double amount fitting CUI's 63-byte grouped display.
// - `OnChange`: Maps a proposed native amount to a message.
// - `Settings`: Optional currency captions, precision and native width.
// ## Returns
// A graphical model-controlled money field.
public function MoneyField<TMsg>(Id: string; Value: double; OnChange: function(double): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.MoneyField(Id, Value, OnChange, Settings ?? new Options());
end function;

end unit;
