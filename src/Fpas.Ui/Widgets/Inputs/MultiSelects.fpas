// [Documentation](../../../../docs/ui/gui/pickers/multi-select.md)

unit Fpas.Ui.Widgets.Inputs.MultiSelects;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Inputs.Selects as S;

// Presentation and input options for a multi-select.
public type Options = record
  // Field caption. Null omits the native label wrapper.
  public Label: string? := null;
  // Caption for the empty field. Null uses the native Select caption.
  public Placeholder: string? := null;
  // Enable search in the popup.
  public Searchable: bool := false;
  // Maximum visible selections before a count appears. Zero uses three.
  public MaxChips: int := 0;
  // Whether the picker accepts input.
  public Enabled: bool := true;
  // Native GUI width. Null uses CUI's width for the current label.
  public Width: L.Extent? := null;
end record;

// Builds a picker with multiple independent choices.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable picker identity.
// - `Items`: Nonempty list of choices in display order.
// - `Selected`: Model-owned selection flag for each choice.
// - `OnChange`: Maps a fresh selection proposal to a message.
// - `Settings`: Optional caption, filtering and chip display settings.
// ## Returns
// A multi-select with model-owned selection and host-owned popup state.
public function MultiSelect of TMsg(
  Id: string;
  Items: array of S.Item;
  Selected: array of bool;
  OnChange: function(array of bool): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).MultiSelectInput(
    Id,
    Items,
    Selected,
    OnChange,
    Settings ?? new Options()
  );
end function;

end unit;
