// [Documentation](../../../../docs/ui/gui/inputs/number-field.md)

unit Fpas.Ui.Widgets.Inputs.NumberFields;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;

// Presentation and input settings for a number field.
public type Options = record
  // Caption above the editor.
  public Label: string := '';
  // Muted unit text before the step buttons.
  public Suffix: string := '';
  // Finite nonnegative step. Zero uses the native increment of one.
  public Step: double := 1.0;
  // Display zero through 61 decimal places within the native buffer capacity.
  public DecimalPlaces: int := 0;
  // Allow pointer and keyboard editing.
  public Enabled: bool := true;
  // Native GUI width. Null uses CUI's soft 160-unit width.
  public Width: L.Extent? := null;
end record;

// Builds a numeric editor with increment and decrement buttons.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Value`: Finite model value within the inclusive bounds and native display buffer.
// - `Minimum`: Finite lower bound.
// - `Maximum`: Finite upper bound. Both bounds must fit the native display buffer.
// - `OnChange`: Maps a proposed bounded value to a message.
// - `Settings`: Optional caption, suffix, increment and precision.
// ## Returns
// A graphical or terminal number field with a model-owned value.
public function NumberField of TMsg(
  Id: string;
  Value: double;
  Minimum: double;
  Maximum: double;
  OnChange: function(double): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).NumberField(
    Id,
    Value,
    Minimum,
    Maximum,
    OnChange,
    Settings ?? new Options()
  );
end function;

// Gets the decrease button's snapshot identity.
//
// ## Parameters
// - `Id`: Number field identity.
// ## Returns
// The decrease button's control ID.
public function DecreaseId(Id: string): string;
begin
  return Id + '/decrease';
end function;

// Gets the increase button's snapshot identity.
//
// ## Parameters
// - `Id`: Number field identity.
// ## Returns
// The increase button's control ID.
public function IncreaseId(Id: string): string;
begin
  return Id + '/increase';
end function;

end unit;
