unit Fpas.Ui.Widgets.Inputs.RadioCards;

uses Fpas.Ui.Elements as E;

// One positional choice in the native radio-card grid.
public type Item = record
  // Literal title.
  public Title: string;
  // Optional supporting description.
  public Description: string := '';
  // Optional CUI icon-font glyph.
  public Icon: string := '';
  // Optional literal badge text.
  public Badge: string := '';
end record;

// Native grid and input settings.
public type Options = record
  // Maximum cards per row, or zero for CUI's automatic choice.
  public Columns: int := 0;
  // Whether the cards accept pointer and keyboard input.
  public Enabled: bool := true;
end record;

// Creates a graphical grid of controlled radio cards.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable group identity.
// - `Items`: Nonempty choices in stable positional order.
// - `Selected`: Model-owned index, or minus one for no selection.
// - `OnChange`: Maps a different choice to an application message.
// - `Settings`: Native column count and input permission.
// ## Returns
// A native radio-card selector.
public function RadioCards<TMsg>(
  Id: string; Items: array of Item; Selected: int; OnChange: function(int): TMsg;
  Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Cards(Id, Items, Selected, OnChange, Settings ?? new Options());
end function;

// Gets a card's positional identity for focus requests.
//
// ## Parameters
// - `Id`: Group identity.
// - `Index`: Nonnegative card index.
// ## Returns
// The group ID followed by / and the zero-based index.
public function ItemId(Id: string; Index: int): string;
requires Id <> '';
requires Index >= 0;
begin
  return Id + '/' + Index.ToString();
end function;

end unit;
