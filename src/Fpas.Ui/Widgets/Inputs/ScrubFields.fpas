// [Documentation](../../../../docs/ui/gui/smart-inputs/scrub-field.md)

unit Fpas.Ui.Widgets.Inputs.ScrubFields;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.Charts as C;

// Native draggable number-field presentation.
public type Options = record
  // Increment; zero selects one percent of the range.
  public Step: float := 0.0F;
  // Native number format for the resting value and initial draft. Null uses zero fractional digits.
  public Format: C.ValueFormat? := null;
  // Literal suffix. Null omits it. An empty string keeps the native suffix position.
  public Suffix: string? := null;
  // Native glyph replacing the caption. Null shows the caption. An empty string hides it.
  public Icon: string? := null;
  // Native content, fill, fixed or percentage width.
  public Width: L.Extent := L.Extent.Content;
  // Whether pointer and keyboard input are accepted.
  public Enabled: bool := true;
end record;

// Builds CUI's scrub field, with native drag, fine steps and numeric typing.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Label`: Literal caption.
// - `Value`: Finite model value within the bounds.
// - `Minimum`: Finite inclusive lower bound.
// - `Maximum`: Finite inclusive upper bound greater than Minimum.
// - `OnChange`: Maps a native value proposal to a message.
// - `Settings`: Optional native increment, number format, width and display settings.
// ## Returns
// A graphical model-controlled scrub field.
public function ScrubField of TMsg(
  Id: string;
  Label: string;
  Value: float;
  Minimum: float;
  Maximum: float;
  OnChange: function(float): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
requires Minimum < Maximum;
begin
  return (E.Element of TMsg).ScrubField(
    Id,
    Label,
    Value,
    Minimum,
    Maximum,
    OnChange,
    Settings ?? new Options()
  );
end function;

end unit;
