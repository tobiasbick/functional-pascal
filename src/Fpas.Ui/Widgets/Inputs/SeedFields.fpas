unit Fpas.Ui.Widgets.Inputs.SeedFields;

uses Fpas.Ui.Elements as E;

// Model-owned input.
public type Value = record
  // Well caption. A leading ## hides it.
  public Label: string;
  // Current random seed.
  public Seed: uint;
  // Optional lock. Null hides the lock control.
  public Locked: bool? := null;
end record;

// Native widget settings.
public type Options = record
  // Optional value caption.
  public Display: string := '';
  // Optional caption for random mode.
  public RandomText: string := '';
  // Optional caption for fixed mode.
  public FixedText: string := '';
  // Omits the surrounding well.
  public Plain: bool := false;
  // Accepts input.
  public Enabled: bool := true;
end record;

// Native proposal.
public type Event = record
  // Proposed seed.
  public Seed: uint;
  // Proposed lock state.
  public Locked: bool?;
  // The seed or lock changed.
  public Changed: bool;
  // The dice was activated.
  public Rolled: bool;
end record;

// Presents the CUI seed field.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Current`: Current model value.
// - `Change`: Maps a native proposal to an application message.
// - `Settings`: Optional native appearance and input settings.
// ## Returns
// The graphical widget.
public function SeedField<TMsg>(Id: string; Current: Value; Change: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.SeedField(Id, Current, Change, Settings ?? new Options());
end function;

end unit;
