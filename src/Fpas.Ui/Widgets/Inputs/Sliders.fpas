unit Fpas.Ui.Widgets.Inputs.Sliders;

uses Fpas.Ui.Elements as E;

// Presentation and input settings for a native slider.
public type Options = record
  // Positive increment, or zero for continuous adjustment.
  public Step: float := 0.0F;
  // Show the current value beside the label.
  public ShowValue: bool := false;
  // Display zero through six decimal places when the value is visible.
  public DecimalPlaces: int := 0;
  // Append a percent sign to the value.
  public Percent: bool := false;
  // Whether pointer and keyboard adjustment is permitted.
  public Enabled: bool := true;
end record;

// Creates CUI's graphical elastic slider.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Label`: Literal caption.
// - `Value`: Model-owned value within the inclusive bounds.
// - `Minimum`: Finite lower bound.
// - `Maximum`: Finite upper bound greater than Minimum.
// - `OnChange`: Maps an adjusted value to a message.
// - `Settings`: Step, value display and input permission.
// ## Returns
// A graphical slider with model-owned value.
public function Slider<TMsg>(
  Id: string; Label: string; Value: float; Minimum: float; Maximum: float;
  OnChange: function(float): TMsg; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.SliderAction(
    Id,
    Label,
    Value,
    Minimum,
    Maximum,
    OnChange,
    Settings ?? new Options()
  );
end function;

end unit;
