unit Fpas.Ui.Widgets.Inputs.StepSliders;

uses Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Audio.ControlWells as W;

// Model-owned input.
public type Value = record
  // Well caption. A leading ## hides it.
  public Label: string;
  // Current integer stop.
  public Current: int;
  // First stop.
  public Minimum: int;
  // Last stop.
  public Maximum: int;
end record;

// Native widget settings.
public type Options = record
  // Optional caption for each stop.
  public Labels: array of string := [];
  // Literal prefix when the slider formats its integer stop.
  public Prefix: string := '';
  // Literal suffix when the slider formats its integer stop.
  public Suffix: string := '';
  // Optional value caption.
  public Display: string := '';
  // Optional action next to the track.
  public Tool: W.Tool? := null;
  // Omits the surrounding well.
  public Plain: bool := false;
  // Accepts input.
  public Enabled: bool := true;
end record;

// Native proposal.
public type Event = record
  // Proposed stop.
  public Current: int;
  // Stop changed.
  public Changed: bool;
  // Tool was activated.
  public Action: bool;
end record;

// Presents the CUI step slider.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Current`: Current model value.
// - `Change`: Maps a native proposal to an application message.
// - `Settings`: Optional native appearance and input settings.
// ## Returns
// The graphical widget.
public function StepSlider<TMsg>(Id: string; Current: Value; Change: function(Event): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.StepSlider(Id, Current, Change, Settings ?? new Options());
end function;

end unit;
