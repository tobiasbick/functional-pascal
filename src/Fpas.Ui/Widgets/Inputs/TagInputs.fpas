unit Fpas.Ui.Widgets.Inputs.TagInputs;

uses Fpas.Ui.Elements as E;

// Presentation and bounds for a graphical tag input.
public type Options = record
  // Caption above the tags.
  public Label: string := '';
  // Text displayed when the tag list is empty.
  public Placeholder: string := '';
  // Maximum number of tags from 1 to 64.
  public MaxTags: int := 64;
  // Maximum UTF-8 bytes in the tag list, including separators, from 1 to 2047.
  public MaxUtf8Bytes: int := 2047;
  // Whether the control accepts input.
  public Enabled: bool := true;
end record;

// Builds CUI's graphical tag editor.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Tags`: Ordered, nonempty single-line tags without commas or surrounding spaces.
// - `OnChange`: Maps the proposed tag list to a message.
// - `Settings`: Optional presentation and bounds.
// ## Returns
// A graphical tag input.
public function TagInput<TMsg>(
  Id: string; Tags: array of string; OnChange: function(array of string): TMsg;
  Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.TagInput(Id, Tags, OnChange, Settings ?? new Options());
end function;

// Gets the native remove-button identity for a tag position.
//
// ## Parameters
// - `Id`: Tag input identity.
// - `Index`: Zero-based position in the current tag list.
// ## Returns
// The remove button's snapshot ID.
public function RemoveId(Id: string; Index: int): string;
begin
  return Id + '/remove/' + Index.ToString();
end function;

end unit;
