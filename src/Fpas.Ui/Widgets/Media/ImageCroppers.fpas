unit Fpas.Ui.Widgets.Media.ImageCroppers;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Widgets.Media.MediaImages as Media;

// The selected rectangle in image pixels.
public type Value = record
  // Left edge.
  public X: float := 0.0F;
  // Top edge.
  public Y: float := 0.0F;
  // Width. Zero requests the default crop.
  public Width: float := 0.0F;
  // Height. Zero requests the default crop.
  public Height: float := 0.0F;
end record;

// Native image cropper options.
public type Options = record
  // Preferred native width.
  public Width: L.Extent := L.Extent.Content;
  // Preferred native height.
  public Height: L.Extent := L.Extent.Content;
  // Required width divided by height, or zero for free resizing.
  public Aspect: float := 0.0F;
  // Draw a round mask and keep a square crop.
  public Round: bool := false;
  // Minimum side in image pixels, or zero for the native default.
  public MinimumSize: float := 0.0F;
  // Allow moving and resizing.
  public Enabled: bool := true;
end record;

// Builds the native graphical image cropper.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Image`: Picture to crop.
// - `Current`: Model-owned crop, or a zero-sized crop for native fit.
// - `Change`: Maps the proposed crop.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical element.
public function ImageCropper<TMsg>(Id: string; Image: Media.Source; Current: Value; Change: function(Value): TMsg; Settings: Options? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ImageCropper(Id, Image, Current, Change, Settings ?? new Options());
end function;

end unit;
