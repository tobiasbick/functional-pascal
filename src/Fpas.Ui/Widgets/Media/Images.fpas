// [Documentation](../../../../docs/ui/gui/text-and-display/image.md)

unit Fpas.Ui.Widgets.Media.Images;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.Charts as C;
uses Fpas.Ui.Widgets.Media.MediaImages as Media;

// Native image layout and appearance.
public type Options = record
  // Preferred width.
  public Width: L.Extent := L.Extent.Fixed(L.Measure.Logical(64));
  // Preferred height.
  public Height: L.Extent := L.Extent.Fixed(L.Measure.Logical(64));
  // Corner radius in logical points.
  public Radius: float := 0.0F;
  // Theme or RGBA tint multiplied with the image. Automatic preserves its colors.
  public Tint: C.Color := C.Color.Automatic;
end record;

// Creates a native CUI image element.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable picture identity.
// - `Source`: Picture file or immutable RGBA pixels.
// - `Settings`: Native image settings.
// ## Returns
// A graphical element.
public function Image of TMsg(
  Id: string;
  Source: Media.Source;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).Image(Id, Source, Settings ?? new Options());
end function;

end unit;
