unit Fpas.Ui.Widgets.Motion.NumberRolls;

uses Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Motion.Motion as Motion;

// Draws the native CUI number roll. Values exceeding its animation capacity
// appear as complete tabular text.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Text`: Literal display text.
// - `Settings`: Optional native options.
// ## Returns
// The graphical widget.
public function NumberRoll<TMsg>(Id: string; Text: string; Settings: Motion.TextOptions? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.NumberRoll(Id, Text, Settings ?? new Motion.TextOptions());
end function;

end unit;
