// [Documentation](../../../../docs/ui/gui/motion/shimmer-text.md)

unit Fpas.Ui.Widgets.Motion.ShimmerTexts;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Motion.Motion as Motion;

// Draws the native CUI shimmer text.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Text`: Literal display text.
// - `Settings`: Optional native options.
// ## Returns
// The graphical widget.
public function ShimmerText of TMsg(
  Id: string;
  Text: string;
  Settings: Motion.TextOptions? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).ShimmerText(Id, Text, Settings ?? new Motion.TextOptions());
end function;

end unit;
