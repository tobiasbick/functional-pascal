// [Documentation](../../../../docs/ui/gui/motion/text-reveal.md)

unit Fpas.Ui.Widgets.Motion.TextReveals;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Motion.Motion as Motion;

// Draws the native CUI text reveal.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Text`: Literal display text.
// - `Replay`: Change this value to restart the effect.
// - `Settings`: Optional native options.
// ## Returns
// The graphical widget.
public function TextReveal of TMsg(
  Id: string;
  Text: string;
  Replay: int := 0;
  Settings: Motion.TextOptions? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).TextReveal(Id, Text, Replay, Settings ?? new Motion.TextOptions());
end function;

end unit;
