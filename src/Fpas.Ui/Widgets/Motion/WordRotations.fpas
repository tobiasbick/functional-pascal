unit Fpas.Ui.Widgets.Motion.WordRotations;

uses Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Motion.Motion as Motion;

// Draws the native CUI word rotate.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Words`: Words in native rotation order.
// - `Interval`: Seconds per word, or zero for the native default.
// - `Settings`: Optional native options.
// ## Returns
// The graphical widget.
public function WordRotate<TMsg>(Id: string; Words: array of string; Interval: float := 0.0F; Settings: Motion.TextOptions? := null): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.WordRotate(Id, Words, Interval, Settings ?? new Motion.TextOptions());
end function;

end unit;
