unit Fpas.Ui.Widgets.Navigation.ScrollAnchors;

uses Fpas.Ui.Elements as E;

// Marks a jump destination in an enclosing graphical ScrollView.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Globally unique anchor identity referenced by a table-of-contents entry.
// ## Returns
// An invisible marker with zero height.
public function ScrollAnchor<TMsg>(Id: string): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.ScrollAnchor(Id);
end function;

end unit;
