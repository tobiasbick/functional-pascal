// [Documentation](../../../../docs/ui/gui/navigation/stepper.md)

unit Fpas.Ui.Widgets.Navigation.Steppers;

uses Fpas.Ui.Elements as E;

// Displays progress through a sequence of steps using native CUI.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable control identity.
// - `Steps`: Nonempty sequence of literal captions.
// - `Current`: Zero-based step in progress, or the step count when all are complete.
// ## Returns
// A graphical progress display driven by the model.
public function Stepper of TMsg(Id: string; Steps: array of string; Current: int): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).StepProgress(Id, Steps, Current);
end function;

end unit;
