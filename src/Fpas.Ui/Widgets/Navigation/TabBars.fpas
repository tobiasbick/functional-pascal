// [Documentation](../../../../docs/ui/gui/motion/tab-bar.md)

unit Fpas.Ui.Widgets.Navigation.TabBars;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Charts.Charts as C;

// Native item.
public type Item = record
  // CUI icon glyph. Null uses a circle. An empty string omits the glyph.
  public Icon: string?;
  // Literal tab label. Null omits its row.
  public Label: string?;
  // Badge count or zero to hide.
  public Badge: int := 0;
end record;

// Native options.
public type Options = record
  // Native width.
  public Width: L.Extent := L.Extent.Fill;
  // Show a label only on the selected item.
  public LabelsOnSelection: bool := false;
  // Accept selection.
  public Enabled: bool := true;
end record;

// Draws the native CUI tab bar.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Items`: Tabs in display order.
// - `Selected`: Current zero-based selection or minus one for no selection.
// - `Change`: Maps a native proposal to an application message.
// - `Settings`: Optional native options.
// ## Returns
// The graphical widget.
public function TabBar of TMsg(
  Id: string;
  Items: array of Item;
  Selected: int;
  Change: function(int): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).TabBar(Id, Items, Selected, Change, Settings ?? new Options());
end function;

end unit;
