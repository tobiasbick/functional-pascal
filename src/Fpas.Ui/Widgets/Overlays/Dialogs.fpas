unit Fpas.Ui.Widgets.Overlays.Dialogs;

uses Fpas.Ui.Elements as E;

// Presentation and dismissal options for CUI's centered dialog.
public type Options = record
  // Literal heading in the dialog header.
  public Title: string;
  // Optional supporting text below the heading.
  public Description: string := '';
  // Preferred width in logical points. CUI fits it to the window.
  public Width: int := 440;
  // Whether Escape and presses on the scrim leave the dialog open.
  public Persistent: bool := false;
  // Whether to display the native close button.
  public CloseButton: bool := true;
  // Preferred enabled control when opening, before the native close button.
  public InitialFocus: string? := null;
end record;

// Presents a model-controlled modal dialog over an existing view.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable dialog identity.
// - `Base`: View behind the dialog.
// - `Content`: Dialog body and any action footer. Retain it through the exit transition.
// - `Open`: Whether the model opens the dialog.
// - `Settings`: Heading, width, dismissal and focus options.
// - `OnDismiss`: Proposed message when the native dialog requests closure.
// ## Returns
// A graphical view with a native modal dialog.
public function Dialog<TMsg>(
  Id: string; Base: E.Element<TMsg>; Content: E.Element<TMsg>; Open: bool;
  Settings: Options; OnDismiss: TMsg
): E.Element<TMsg>;
requires Id <> '';
requires Settings.Width > 0;
begin
  return E.Element<TMsg>.Dialog(Id, Base, Content, Open, Settings, OnDismiss);
end function;

// Returns the stable application ID of the native close button.
//
// ## Parameters
// - `Id`: Dialog identity.
// ## Returns
// The close button's focus and snapshot ID.
public function CloseId(Id: string): string;
begin
  return Id + '/close';
end function;

end unit;
