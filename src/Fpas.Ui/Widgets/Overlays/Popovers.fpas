// [Documentation](../../../../docs/ui/gui/overlays/popover.md)

unit Fpas.Ui.Widgets.Overlays.Popovers;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Overlays.Menus as M;

// Placement and spacing of a native popover.
public type Options = record
  // Preferred position relative to the trigger. CUI flips it to fit.
  public Position: M.Placement := M.Placement.BottomStart;
  // Width in logical units. Zero sizes to the content and anchor.
  public Width: float := 0.0F;
  // Inset in logical units. Zero uses CUI's default of 16.
  public Padding: float := 0.0F;
  // Space between children in logical units. Zero uses CUI's default of 10.
  public Gap: float := 0.0F;
end record;

// Attaches a model-controlled, nonmodal panel to a button.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable panel identity.
// - `Trigger`: Button that anchors the panel. Its activation may toggle Open.
// - `Children`: Direct panel children in layout order, including any actions that close it.
// - `Open`: Whether the model opens the panel.
// - `OnDismiss`: Proposed message on Escape or a press outside.
// - `Settings`: Optional placement and sizing.
// ## Returns
// A graphical view with the trigger's original layout.
public function Popover of TMsg(
  Id: string;
  Trigger: E.Element of TMsg;
  Children: array of E.Element of TMsg;
  Open: bool;
  OnDismiss: TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).Popover(
    Id,
    Trigger,
    Children,
    Open,
    OnDismiss,
    Settings ?? new Options()
  );
end function;

end unit;
