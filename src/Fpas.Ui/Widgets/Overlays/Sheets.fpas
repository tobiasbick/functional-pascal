unit Fpas.Ui.Widgets.Overlays.Sheets;

uses Fpas.Ui.Elements as E;

// The edge from which a sheet opens.
public type Side = enum: byte
  // Use the right edge.
  Right;
  // Use the left edge.
  Left;
  // Use the bottom edge.
  Bottom;
  // Use the top edge.
  Top;
end enum;

// Shared CUI sheet settings.
public type Options = record
  // Literal heading in the pinned sheet header.
  public Title: string;
  // Optional supporting text below the heading.
  public Description: string := '';
  // Edge against which the sheet opens.
  public Edge: Side := Side.Right;
  // Width for a side sheet or height for a top or bottom sheet in logical units.
  public Size: int := 400;
  // Preferred enabled control. The close button is the fallback.
  public InitialFocus: string? := null;
end record;

// Builds a model-controlled modal sheet with a pinned header and scrolling content.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable sheet identity.
// - `Base`: View behind the sheet.
// - `Content`: Sheet body. Supply it on closing frames for graphical transitions.
// - `Open`: Whether the model opens the sheet.
// - `Settings`: Header, placement and initial focus.
// - `OnDismiss`: Message sent by Escape, the close button or a click on the scrim.
// ## Returns
// A view that includes the base and the controlled sheet.
public function Sheet<TMsg>(
  Id: string; Base: E.Element<TMsg>; Content: E.Element<TMsg>; Open: bool;
  Settings: Options; OnDismiss: TMsg
): E.Element<TMsg>;
requires Id <> '';
requires Settings.Size > 0;
begin
  return E.Element<TMsg>.Sheet(Id, Base, Content, Open, Settings, OnDismiss);
end function;

// Derives the application ID of a sheet's built-in close button.
//
// ## Parameters
// - `Id`: Stable sheet identity.
// ## Returns
// The ID accepted by focus and exposed in both host snapshots.
public function CloseId(Id: string): string;
begin
  return Id + '/close';
end function;

end unit;
