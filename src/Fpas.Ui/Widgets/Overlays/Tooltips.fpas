unit Fpas.Ui.Widgets.Overlays.Tooltips;

uses Fpas.Ui.Elements as E;

// Attaches native CUI hover help to one graphical control.
//
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Target`: A single interactive control to anchor the tooltip.
// - `Text`: Tooltip caption.
// - `Shortcut`: Optional key hint. Applications bind the gesture separately.
// ## Returns
// The same control with native hover help and its original layout and input.
public function Tooltip<TMsg>(Target: E.Element<TMsg>; Text: string; Shortcut: string := ''): E.Element<TMsg>;
requires Text <> '';
begin
  return E.Element<TMsg>.Hinted(Target, Text, Shortcut);
end function;

end unit;
