unit Fpas.Ui.Widgets.Pickers.Calendars;

uses Fpas.Ui.Elements as E, System as Sys;

// Gets the stable identity of a day cell.
// ## Parameters
// - `Id`: Calendar or picker identity.
// - `Day`: Calendar day.
// ## Returns
// The cell identity while that day is visible.
public function DayId(Id: string; Day: Sys.DateOnly): string;
begin
  return Id + '/day/' + Day.DayNumber.ToString();
end function;

// Gets the identity of the title that switches between days, months and years.
// ## Parameters
// - `Id`: Calendar or picker identity.
// ## Returns
// The native title control identity.
public function TitleId(Id: string): string;
begin
  return Id + '/title';
end function;

// Gets the identity of a month choice in the calendar's month view.
// ## Parameters
// - `Id`: Calendar or picker identity.
// - `Year`: Displayed calendar year.
// - `Month`: Month number, from one to twelve.
// ## Returns
// The month choice identity while it is visible.
public function MonthChoiceId(Id: string; Year: int; Month: int): string;
requires Month >= 1 and Month <= 12;
begin
  return Id + '/month/' + Year.ToString() + '/' + Month.ToString();
end function;

// Gets the identity of a year choice in the calendar's year view.
// ## Parameters
// - `Id`: Calendar or picker identity.
// - `Year`: Displayed calendar year.
// ## Returns
// The year choice identity while it is visible.
public function YearChoiceId(Id: string; Year: int): string;
begin
  return Id + '/year/' + Year.ToString();
end function;

// Gets the identity of a calendar navigation button.
// ## Parameters
// - `Id`: Calendar or picker identity.
// - `Forward`: Selects the next-page button when true, otherwise the previous page.
// ## Returns
// The navigation identity, shared across day, month and year views.
public function MonthId(Id: string; Forward: bool): string;
begin
  return Id + (if Forward then
    '/next'
  else
    '/previous'
  end if);
end function;

// Builds CUI's inline single-date calendar.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable calendar identity.
// - `Value`: Model-owned selection, or null.
// - `OnChange`: Maps a chosen date to a message.
// - `Enabled`: Whether the calendar accepts input.
// ## Returns
// A graphical calendar with CUI-owned day, month and year navigation.
public function Calendar<TMsg>(
  Id: string; Value: Sys.DateOnly?; OnChange: function(Sys.DateOnly): TMsg; Enabled: bool := true
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.Calendar(Id, Value, OnChange, Enabled);
end function;

end unit;
