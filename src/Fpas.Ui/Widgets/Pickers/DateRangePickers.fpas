// [Documentation](../../../../docs/ui/gui/pickers/date-range-picker.md)

unit Fpas.Ui.Widgets.Pickers.DateRangePickers;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Pickers.DateRanges as R;

// Presentation and input settings for the native date range field.
public type Options = record
  // Caption above the field. Null omits its wrapper. Empty shows no caption.
  public Label: string? := null;
  // Caption for an empty range. Null uses CUI's default. An empty string hides it.
  public Placeholder: string? := null;
  // Native field width. Content uses CUI's default width policy.
  public Width: L.Extent := L.Extent.Content;
  // Whether to show the relative date presets.
  public Presets: bool := true;
  // Whether the picker accepts input.
  public Enabled: bool := true;
end record;

// Gets the identity of a native preset.
// ## Parameters
// - `Id`: Picker identity.
// - `Index`: CUI's zero-based preset order, starting with Today and Yesterday.
// ## Returns
// The preset identity while the popup is open.
public function PresetId(Id: string; Index: int): string;
requires Index >= 0 and Index < 7;
begin
  return Id + '/preset/' + Index.ToString();
end function;

// Builds the native date range field and its responsive calendar popup.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable picker identity.
// - `Value`: Model-owned range or partial selection.
// - `OnChange`: Maps a native proposal to a message.
// - `Settings`: Optional caption, width, presets and input permission.
// ## Returns
// A graphical range picker with CUI-owned popup layout and interaction.
public function DateRangePicker of TMsg(
  Id: string;
  Value: R.Value;
  OnChange: function(R.Value): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).RangePicker(Id, Value, OnChange, Settings ?? new Options());
end function;

end unit;
