unit Fpas.Ui.Widgets.Pickers.WheelPickers;

uses Fpas.Ui.Elements as E;

// Presentation and input settings for a native selection wheel.
public type Options = record
  // Logical width. Zero selects CUI's default.
  public Width: float := 0.0F;
  // Number of visible rows. CUI rounds an even count up to an odd one.
  public Rows: int := 5;
  // Whether the wheel wraps at the ends.
  public Loop: bool := false;
  // Whether the selection band joins the previous wheel.
  public JoinLeft: bool := false;
  // Whether the selection band joins the next wheel.
  public JoinRight: bool := false;
  // Whether the wheel accepts input.
  public Enabled: bool := true;
end record;

// Builds CUI's wheel of choices.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable wheel identity.
// - `Items`: Nonempty array of captions in selection order.
// - `Selected`: Model-owned zero-based selection.
// - `OnChange`: Maps the proposed index to a message.
// - `Settings`: Optional dimensions, wrapping, joined edges and input permission.
// ## Returns
// The graphical wheel picker.
public function WheelPicker<TMsg>(
  Id: string; Items: array of string; Selected: int; OnChange: function(int): TMsg;
  Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '' and Selected >= 0 and Selected < Items.Length;
begin
  return E.Element<TMsg>.WheelPicker(Id, Items, Selected, OnChange, Settings ?? new Options());
end function;

end unit;
