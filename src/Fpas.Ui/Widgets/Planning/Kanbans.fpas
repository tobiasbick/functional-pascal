// [Documentation](../../../../docs/ui/gui/planning/kanban.md)

unit Fpas.Ui.Widgets.Planning.Kanbans;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Widgets.Charts.Charts as Colors;

// One card, with native drag and application-defined contents.
// ## Type parameters
// - `TMsg`: Application message type.
public type Card of TMsg = record
  // Stable nonnegative native card identity, unique on this board.
  public Key: int;
  // Caption in the GUI snapshot. Include visible text in Content.
  public Title: string;
  // Graphical content.
  public Content: E.Element of TMsg;
end record;

// One board column.
// ## Type parameters
// - `TMsg`: Application message type.
public type Column of TMsg = record
  // Literal heading.
  public Title: string;
  // Cards in order.
  public Cards: array of Card of TMsg;
  // Heading dot. Automatic omits it.
  public Dot: Colors.Color := Colors.Color.Automatic;
  // Advisory work-in-progress limit. Zero hides the limit.
  public Limit: int := 0;
  // Logical width. Zero uses 280 logical units.
  public Width: float := 0.0F;
end record;

// Proposal from native board interaction.
public type Event = variant
  // Add button activated for this column.
  Add(Column: int);
  // Card clicked or activated.
  Activate(Key: int);
  // Card dropped at an index measured without the moved card.
  Move(Key: int; FromColumn: int; ToColumn: int; Index: int);
end variant;

// Native board settings.
public type Options = record
  // Accepts add, card activation, card moves and input in card bodies.
  public Enabled: bool := true;
end record;

// Presents the native Kanban board.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable widget identity.
// - `Columns`: Model-owned input.
// - `Change`: Maps a native proposal to an application message.
// - `Settings`: Optional native settings.
// ## Returns
// The graphical widget.
public function Kanban of TMsg(
  Id: string;
  Columns: array of Column of TMsg;
  Change: function(Event): TMsg;
  Settings: Options? := null
): E.Element of TMsg;
requires Id <> '';
begin
  return (E.Element of TMsg).Kanban(Id, Columns, Change, Settings ?? new Options());
end function;

end unit;
