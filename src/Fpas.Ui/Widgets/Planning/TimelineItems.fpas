unit Fpas.Ui.Widgets.Planning.TimelineItems;

uses Fpas.Ui.Elements as E, Fpas.Ui.Styles as S;

// Native activity-item text, decoration and connector options.
public type Options = record
  // Optional literal time caption, such as '2m ago'; FPAS does not format it.
  public Time: string := '';
  // Optional literal supporting text, wrapped by CUI.
  public Description: string := '';
  // Optional CUI icon-font glyph; empty selects the native dot.
  public Icon: string := '';
  // Semantic dot and icon color.
  public Tone: S.Tone := S.Tone.Neutral;
  // Whether this is the final item, omitting its connector and trailing space.
  public Last: bool := false;
end record;

// Builds a native CUI activity entry without managing a separate timeline model.
// ## Type parameters
// - `TMsg`: Application message type.
// ## Parameters
// - `Id`: Stable inspection identity.
// - `Title`: Nonempty literal heading.
// - `Settings`: Native time, description, icon, tone and final-item options.
// ## Returns
// A noninteractive GUI-only item; CUI owns its layout, wrapping and connector.
public function TimelineItem<TMsg>(
  Id: string; Title: string; Settings: Options? := null
): E.Element<TMsg>;
requires Id <> '';
begin
  return E.Element<TMsg>.TimelineItem(Id, Title, Settings ?? new Options());
end function;

end unit;
