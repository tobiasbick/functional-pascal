function ReadPaletteColor(Text: string): G.Color;
begin
  const Value: uint := Sys.UInt32.Parse(
    Text,
    Global.NumberStyles.HexNumber,
    Global.CultureInfo.InvariantCulture
  );
  return new G.Color(
    cast (Value shr 24) as byte, cast ((Value shr 16) and 255) as byte,
    cast ((Value shr 8) and 255) as byte, cast (Value and 255) as byte
  );
end function;

function CreatePalette(Dark: bool; AccentIndex: int): Palette;
begin
  const C: array of string := PaletteColors[
    (if Dark then
      8
    else
      0
    end if) + AccentIndex
  ].Split(' ');
  return new Palette(
    Background := ReadPaletteColor(C[0]),
    Surface := ReadPaletteColor(C[1]),
    SurfaceRaised := ReadPaletteColor(C[2]),
    SurfaceMuted := ReadPaletteColor(C[3]),
    Foreground := ReadPaletteColor(C[4]),
    TextSecondary := ReadPaletteColor(C[5]),
    TextMuted := ReadPaletteColor(C[6]),
    Border := ReadPaletteColor(C[7]),
    BorderSubtle := ReadPaletteColor(C[8]),
    BorderStrong := ReadPaletteColor(C[9]),
    Accent := ReadPaletteColor(C[10]),
    AccentStrong := ReadPaletteColor(C[11]),
    AccentSubtle := ReadPaletteColor(C[12]),
    AccentForeground := ReadPaletteColor(C[13]),
    Success := ReadPaletteColor(C[14]),
    Warning := ReadPaletteColor(C[15]),
    Danger := ReadPaletteColor(C[16]),
    Info := ReadPaletteColor(C[17]),
    ControlOn := ReadPaletteColor(C[18]),
    ControlGlyph := ReadPaletteColor(C[19]),
    ControlTrack := ReadPaletteColor(C[20]),
    ControlTrackHover := ReadPaletteColor(C[21]),
    ControlThumb := ReadPaletteColor(C[22]),
    ControlThumbOn := ReadPaletteColor(C[23]),
    Hover := ReadPaletteColor(C[24]),
    Active := ReadPaletteColor(C[25]),
    Scrim := ReadPaletteColor(C[26]),
    FocusRing := ReadPaletteColor(C[27]),
    Series1 := ReadPaletteColor(C[28]),
    Series2 := ReadPaletteColor(C[29]),
    Series3 := ReadPaletteColor(C[30]),
    Series4 := ReadPaletteColor(C[31]),
    Series5 := ReadPaletteColor(C[32]),
    Series6 := ReadPaletteColor(C[33])
  );
end function;

// Creates CUI's light palette with the selected accent.
//
// ## Parameters
// - `Color`: Accent family.
//
// ## Returns
// A theme accepted by either UI host.
public function Light(Color: Accent := Accent.Neutral): Theme;
requires cast Color as int >= 0 and cast Color as int <= 7;
begin
  return new Theme(Mode.Light, Color, CreatePalette(false, cast Color as int));
end function;

// Creates CUI's dark palette with the selected accent.
//
// ## Parameters
// - `Color`: Accent family.
//
// ## Returns
// A theme accepted by either UI host.
public function Dark(Color: Accent := Accent.Neutral): Theme;
requires cast Color as int >= 0 and cast Color as int <= 7;
begin
  return new Theme(Mode.Dark, Color, CreatePalette(true, cast Color as int));
end function;

// Resolves one semantic color from a palette.
// ## Parameters
// - `Value`: The active palette.
// - `Token`: The semantic color to resolve.
// ## Returns
// The palette's straight-alpha color.
public function PaletteColor(Value: Palette; Token: ColorToken): G.Color;
requires cast Token as int >= cast ColorToken.Background as int
  and cast Token as int <= cast ColorToken.Series6 as int;
begin
  return case Token of
    when ColorToken.Background: Value.Background;
    when ColorToken.Surface: Value.Surface;
    when ColorToken.SurfaceRaised: Value.SurfaceRaised;
    when ColorToken.SurfaceMuted: Value.SurfaceMuted;
    when ColorToken.Foreground: Value.Foreground;
    when ColorToken.TextSecondary: Value.TextSecondary;
    when ColorToken.TextMuted: Value.TextMuted;
    when ColorToken.Border: Value.Border;
    when ColorToken.BorderSubtle: Value.BorderSubtle;
    when ColorToken.BorderStrong: Value.BorderStrong;
    when ColorToken.Accent: Value.Accent;
    when ColorToken.AccentStrong: Value.AccentStrong;
    when ColorToken.AccentSubtle: Value.AccentSubtle;
    when ColorToken.AccentForeground: Value.AccentForeground;
    when ColorToken.Success: Value.Success;
    when ColorToken.Warning: Value.Warning;
    when ColorToken.Danger: Value.Danger;
    when ColorToken.Info: Value.Info;
    when ColorToken.ControlOn: Value.ControlOn;
    when ColorToken.ControlGlyph: Value.ControlGlyph;
    when ColorToken.ControlTrack: Value.ControlTrack;
    when ColorToken.ControlTrackHover: Value.ControlTrackHover;
    when ColorToken.ControlThumb: Value.ControlThumb;
    when ColorToken.ControlThumbOn: Value.ControlThumbOn;
    when ColorToken.Hover: Value.Hover;
    when ColorToken.Active: Value.Active;
    when ColorToken.Scrim: Value.Scrim;
    when ColorToken.FocusRing: Value.FocusRing;
    when ColorToken.Series1: Value.Series1;
    when ColorToken.Series2: Value.Series2;
    when ColorToken.Series3: Value.Series3;
    when ColorToken.Series4: Value.Series4;
    when ColorToken.Series5: Value.Series5;
    when ColorToken.Series6: Value.Series6;
    else Value.Background;
  end case;
end function;

// Composites a palette color onto an opaque background for explicit cell drawing.
//
// ## Parameters
// - `Value`: Straight-alpha color.
// - `Background`: Opaque backdrop from the same palette.
//
// ## Returns
// A 24-bit RGB value suitable for a terminal style.
public function Rgb(Value: G.Color; Background: G.Color): int;
requires Background.Alpha = 255;
  function Channel(Foreground: byte; Back: byte): int;
  begin
    return (cast Foreground as int * cast Value.Alpha as int + cast Back as int * (255 -
      cast Value.Alpha as int) + 127) div 255;
  end function;
begin
  return (Channel(Value.Red, Background.Red) shl 16)
    or (Channel(Value.Green, Background.Green) shl 8) or Channel(Value.Blue, Background.Blue);
end function;

// Copies semantic colors in CUI token order as packed RGBA bytes.
//
// ## Parameters
// - `Value`: Theme to marshal.
//
// ## Returns
// A detached array, excluding CUI's reserved zero token.
public function Rgba(Value: Theme): array of uint;
requires cast Value.Appearance as int >= 0 and cast Value.Appearance as int <= 1;
requires cast Value.AccentFamily as int >= 0 and cast Value.AccentFamily as int <= 7;
requires Value.Colors.Background.Alpha = 255;
  function Pack(Color: G.Color): uint;
  begin
    return cast Color.Red as uint or (cast Color.Green as uint shl 8)
      or (cast Color.Blue as uint shl 16) or (cast Color.Alpha as uint shl 24);
  end function;
begin
  const C: Palette := Value.Colors;
  return [
    Pack(C.Background),
    Pack(C.Surface),
    Pack(C.SurfaceRaised),
    Pack(C.SurfaceMuted),
    Pack(C.Foreground),
    Pack(C.TextSecondary),
    Pack(C.TextMuted),
    Pack(C.Border),
    Pack(C.BorderSubtle),
    Pack(C.BorderStrong),
    Pack(C.Accent),
    Pack(C.AccentStrong),
    Pack(C.AccentSubtle),
    Pack(C.AccentForeground),
    Pack(C.Success),
    Pack(C.Warning),
    Pack(C.Danger),
    Pack(C.Info),
    Pack(C.ControlOn),
    Pack(C.ControlGlyph),
    Pack(C.ControlTrack),
    Pack(C.ControlTrackHover),
    Pack(C.ControlThumb),
    Pack(C.ControlThumbOn),
    Pack(C.Hover),
    Pack(C.Active),
    Pack(C.Scrim),
    Pack(C.FocusRing),
    Pack(C.Series1),
    Pack(C.Series2),
    Pack(C.Series3),
    Pack(C.Series4),
    Pack(C.Series5),
    Pack(C.Series6)
  ];
end function;

end unit;
