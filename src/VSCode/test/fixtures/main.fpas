program EditorProbe;

uses Fixture.Api as Api;
uses Helpers as H;
uses System.Console as Console;

function Double(Value: int): int;
begin
  return Value * 2;
end function;

begin
  Console.WriteLine('λ😀' + Double(H.Answer() + Api.Value()).ToString());
  discard Api.Echo('text', 2);
end;

end program;
