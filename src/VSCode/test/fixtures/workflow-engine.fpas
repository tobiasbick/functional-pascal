// [Documentation](../../verification.md#editor-and-project-scenarios)

unit Engine;

uses System as Sys;

// Doubles the value while exposing a local to the debugger.
//
// ## Parameters
// - `Input`: The value to double.
// ## Returns
// Twice the input.
public function Compute(Input: int): int;
begin
  const Doubled: int := Input * 2;
  return Doubled;
end function;

// Throws the deliberate exception checked by the editor workflow.
public procedure Fail();
begin
  raise new Sys.InvalidOperationException('editor exception');
end procedure;

end unit;
