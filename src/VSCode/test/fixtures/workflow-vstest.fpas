// [Documentation](../../verification.md#editor-and-project-scenarios)

unit Vstest;

uses System as Sys;
uses Xunit as X;

// Checks addition against inline test data.
//
// ## Parameters
// - `Left`: The first addend.
// - `Right`: The second addend.
// - `Expected`: The expected sum.
[X.TheoryAttribute]
[X.InlineDataAttribute(1, 2, 3)]
[X.InlineDataAttribute(2, 3, 5)]
public procedure Addition(Left: int; Right: int; Expected: int);
begin
  X.Assert.Equal of int(Expected, Left + Right);
end procedure;

// Produces a failing assertion for the runner to report.
[X.FactAttribute]
public procedure Failure();
begin
  X.Assert.Equal of int(1, 2);
end procedure;

// Fails if the runner executes this deliberately skipped case.
[X.FactAttribute(Skip := 'intentional skip')]
public procedure Skipped();
begin
  X.Assert.True(false);
end procedure;

// Waits for the editor to cancel the run when the fixture enables the wait.
[X.FactAttribute]
public procedure CanCancel();
begin
  const Base: string := Sys.AppContext.BaseDirectory;
  if Sys.IO.File.Exists(Sys.IO.Path.Combine(Base, 'wait-for-cancellation')) then
    Sys.IO.File.WriteAllText(
      Sys.IO.Path.Combine(Base, 'waiting-test.pid'),
      Sys.Environment.ProcessId.ToString()
    );
    Sys.Threading.Thread.Sleep(60000);
  end if;
end procedure;

end unit;
