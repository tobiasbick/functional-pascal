// [Documentation](../../../docs/ui/gui/canvas-and-bars/README.md)

unit GalleryCanvasBarsContract;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as Context;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Widgets.Canvas.CanvasControls as Controls;
uses Fpas.Ui.Widgets.Editors.NodeEditors as Nodes;
uses Fpas.Ui.Widgets.Inputs.ShortcutRecorders as Keys;

uses GalleryHostAssertions as A;
uses GuiGallery.App.State as State;
uses GuiGallery.App.Update as Update;
uses GuiGallery.App.View as Gallery;
uses GuiGallery.Pages.Canvas.SampleBounds as SampleBounds;
uses GuiGallery.Pages.Canvas.State as Canvas;
uses GuiGallery.Pages.Canvas.Update as CanvasUpdate;

procedure NodeStatus(Renderer: Cui.CuiRenderer);
  function UpdateStatus(
    Current: Nodes.Status;
    Message: Nodes.Event
  ): Mvu.Transition of (Nodes.Status, Nodes.Event);
  begin
    case Message of
      when Nodes.Event.StatusChanged(const Value: Nodes.Status):
        Updates := Updates + 1;
        Observed := Value;
        return new Mvu.Transition of (Nodes.Status, Nodes.Event)(Value, []);
      else
        return new Mvu.Transition of (Nodes.Status, Nodes.Event)(Current, []);
    end case;
  end function;
  function View(Current: Nodes.Status; Viewport: L.Viewport): E.Element of Nodes.Event;
  begin
    return Nodes.NodeEditor of Nodes.Event(
      'node-status-graph',
      new Nodes.View(),
      [
        new Nodes.Node of Nodes.Event(
          1, 35.0F, 60.0F, 'Source', [new Nodes.Pin(10, 'Output', true)]
        ),
        new Nodes.Node of Nodes.Event(
          2, 350.0F, 60.0F, 'Target', [new Nodes.Pin(20, 'Input', false)]
        )
      ],
      [new Nodes.Link(100, 10, 20)],
      function(Value: Nodes.Event): Nodes.Event => Value,
      new Nodes.Options(ObservedStatus := Current)
    );
  end function;
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Button >= 0 then
      Window.SetLeftButton(Button = 1);
      Button := -1;
    end if;
  end procedure;
  procedure Step(Driver: Gui.Session of Nodes.Event);
  begin
    discard Window.TryWake();
    A.Check(Driver.Step(), 'The node status session closed.');
  end procedure;
begin
  var Updates: int := 0;
  var Observed: Nodes.Status := new Nodes.Status();
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Button: int := -1;
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Node status contract',
    650,
    530,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of Nodes.Event := Host.Start of (Nodes.Status, Nodes.Event)(
    Observed, UpdateStatus, View, Window, 16, Inject
  );
  for Frame: int := 0 to 4 do
    Step(Session);
  end for;

  A.Check(
    Observed.ConnectedPins.Length = 2 and Observed.ConnectedPins[0] = 10
    and Observed.ConnectedPins[1] = 20 and Updates = 1,
    'Node status must report both connected native pins once.'
  );
  for Control: Gui.Control in Session.Snapshot().Controls do
    if Control.Id = 'node-status-graph' then
      X := Control.Bounds.X + 70.0F;
      Y := Control.Bounds.Y + 73.0F;
    end if;
  end for;

  A.Check(X >= 0.0F and Y >= 0.0F, 'The node status graph has no bounds.');
  Step(Session);
  Button := 1;
  Step(Session);
  Button := 0;
  for Frame: int := 0 to 2 do
    Step(Session);
  end for;

  A.Check(
    Observed.SelectedNodes.Length = 1 and Observed.SelectedNodes[0] = 1 and Updates = 2,
    'Node status must report the selected native node once.'
  );
end procedure;

procedure MovedSampleBounds();
begin
  const Default: Controls.Bounds := SampleBounds.Content(new Canvas.Model());
  A.Check(
    Default.X = 36.0F and Default.Y = 64.0F and Default.Width = 478.0F and Default.Height = 290.0F,
    'Fit must use the original content bounds while the specimen positions match.'
  );
  const First: Canvas.Model := CanvasUpdate.Update(
    new Canvas.Model(), Canvas.Msg.Graph(Nodes.Event.Move(0, 800.0F, -700.0F))
  ).Model;
  const Second: Canvas.Model := CanvasUpdate.Update(
    First, Canvas.Msg.Graph(Nodes.Event.Move(1, -600.0F, 950.0F))
  ).Model;
  const Moved: Canvas.Model := CanvasUpdate.Update(
    Second, Canvas.Msg.Graph(Nodes.Event.Move(2, -1200.0F, -900.0F))
  ).Model;
  const Bounds: Controls.Bounds := SampleBounds.Content(Moved);
  A.Check(
    Bounds.X = -1200.0F and Bounds.Y = -900.0F
    and Bounds.Width > 0.0F and Bounds.Height > 0.0F,
    'Fit bounds must include nodes moved left and above the original canvas.'
  );
  A.Check(
    Bounds.X + Bounds.Width >= 984.0F and Bounds.Y + Bounds.Height >= 1062.0F,
    'Fit bounds must include the rightmost and lowest displaced node specimens.'
  );
end procedure;

procedure CapturePage(Page: State.Page; Renderer: Cui.CuiRenderer; Root: string; Width: int);
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Offset > 0.0F then
      var Before: float := 0.0F;
      var Maximum: float := 0.0F;
      Window.ScrollState(Token, 0, Offset, out Before, out Maximum);
    end if;

    if Button >= 0 then
      Window.SetLeftButton(Button = 1);
      Button := -1;
    end if;

    if Escape then
      Window.SetKey(cast Keys.Key.Escape as int, true);
      Window.SetKey(cast Keys.Key.Escape as int, false);
      Escape := false;
    end if;
  end procedure;
begin
  const Token: string := Context.Token('scroll', State.MainScrollId);
  var Offset: float := 0.0F;
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Escape: bool := false;
  var Button: int := -1;
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas CUI canvas and controls',
    Width,
    1700,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of State.Msg := Host.Start of (State.Model, State.Msg)(
    new State.Model(Active := Page),
    Update.Update,
    Gallery.Build,
    Window,
    32,
    Inject,
    ThemeFor := Update.ThemeFor
  );
  for Frame: int := 0 to 7 do
    A.Check(Session.Step(), 'The canvas gallery closed.');
  end for;

  Session.CapturePng(Root + '-' + Width.ToString() + '.png');
  if Width = 550 then
    Offset := if Page = State.Page.CanvasAndBars then
      265.0F
    else
      143.0F
    end if;
    for Frame: int := 0 to 2 do
      A.Check(Session.Step(), 'The gallery closed after scrolling.');
    end for;

    Session.CapturePng(Root + '-550-end.png');
  end if;

  if Page = State.Page.CanvasAndBars and Width = 1100 then
    A.Check(A.Control(Session, 'canvas-graph').Value = '1', 'The canvas starts at 100 percent.');
    discard Session.Post(State.Msg.Canvas(Canvas.Msg.Tick(8.0F)));
    A.Check(Session.Step(), 'The canvas must keep drawing after the cursor sample hash wraps.');
    A.Check(
      A.Control(Session, 'canvas-result').Text = 'Final result',
      'The result card is missing.'
    );
    const File: Cui.CuiRectangle := A.Control(Session, 'canvas-file-3').Bounds;
    X := File.X + File.Width / 2.0F;
    Y := File.Y + File.Height / 2.0F;
    A.Check(Session.Step(), 'The canvas gallery closed after moving to a file.');
    Button := 1;
    A.Check(Session.Step(), 'The canvas gallery closed after pressing a file.');
    Button := 0;
    A.Check(Session.Step(), 'The canvas gallery closed after selecting a file.');
    A.Check(Session.Step(), 'The canvas gallery closed before showing the selection.');
    A.Check(
      A.Control(Session, 'canvas-file-3').Value = 'true',
      'The fourth file must become selected.'
    );
    X := -1.0F;
    Y := -1.0F;
    Escape := true;
    A.Check(Session.Step(), 'The canvas gallery closed after Escape.');
    A.Check(Session.Step(), 'The canvas gallery closed before clearing the selection.');
    for Index: int := 0 to 4 do
      A.Check(
        A.Control(Session, 'canvas-file-' + Index.ToString()).Value = 'false',
        'Escape must clear selected files.'
      );
    end for;
  end if;
end procedure;

// Checks moved-node Fit bounds, captures both pages, and checks checkbox and Escape behavior.
// ## Parameters
// - `Renderer`: Native renderer under test.
// - `Capture`: Prefix of the gallery screenshots.
public procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
begin
  NodeStatus(Renderer);
  MovedSampleBounds();
  CapturePage(State.Page.CanvasAndBars, Renderer, Capture + '-canvas', 1100);
  CapturePage(State.Page.CanvasAndBars, Renderer, Capture + '-canvas', 550);
  CapturePage(State.Page.CreativeControls, Renderer, Capture + '-creative', 1100);
  CapturePage(State.Page.CreativeControls, Renderer, Capture + '-creative', 550);
end procedure;

end unit;
