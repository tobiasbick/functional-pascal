unit GalleryCredentialFieldsContract;

uses
  GuiGallery.App.Update as GalleryUpdate,
  GuiGallery.App.State as State,
  GuiGallery.App.View as View,
  Fpas.Ui.Gui.Application as Gui,
  Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.Hosting.Session as Host,
  Fpas.Ui.Widgets.Inputs.TagInputs as Tags,
  Fpas.Ui.Widgets.Inputs.OneTimeCodes as Codes,
  Fpas.Ui.Widgets.Inputs.PasswordStrengthMeters as Strength,
  Fpas.Ui.Validation as V,
  Fpas.Ui.Elements as E,
  System as Sys;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function Control(Session: Gui.Session<State.Msg>; Id: string): Gui.Control;
begin
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Id = Id then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing input control ' + Id);
end function;

function CodeToasts(Session: Gui.Session<State.Msg>): int;
begin
  var Count: int := 0;
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Role = 'toast' and Item.Text = 'Code entered' then
      Count := Count + 1;
    end if;
  end for;

  return Count;
end function;

procedure Reject(Node: E.Element<string>; Target: V.Target; Expected: string);
begin
  try
    discard V.Prepare<string>(Node, Target);
  catch Error: Sys.ArgumentException do
    Check(Error.Message.Contains(Expected), Error.Message);
    return;
  end try;

  raise new Sys.InvalidOperationException('Input preflight accepted an invalid view.');
end procedure;

procedure Validate();
begin
  const TagMessage: function(array of string): string := function(Value: array of string): string => '';
  const Identity: function(string): string := function(Value: string): string => Value;
  Reject(Tags.TagInput<string>('topics', ['two, tags'], TagMessage), V.Target.Graphical, 'commas');
  Reject(
    Codes.OneTimeCodeInput<string>('otp', '7-', Identity),
    V.Target.Graphical,
    'ASCII letters and digits'
  );
  Reject(Tags.TagInput<string>('topics', [], TagMessage), V.Target.Terminal, 'Graphical profile');
  Reject(
    Codes.OneTimeCodeInput<string>('otp', '', Identity),
    V.Target.Terminal,
    'Graphical profile'
  );
  Reject(
    Strength.PasswordStrengthMeter<string>('strength', ''),
    V.Target.Terminal,
    'Graphical profile'
  );
end procedure;

// Exercises the native widgets in the original Inputs card.
//
// ## Parameters
// - `Renderer`: Native renderer to exercise.
// - `Capture`: Prefix for the gallery screenshot.
public procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Left >= 0 then
      Window.SetLeftButton(Left = 1);
      Left := -1;
    end if;

    if Input <> '' then
      Window.SetKey(0, false);
      Window.InputText(Input);
      Input := '';
    end if;

    if KeyCode <> 0 then
      Window.SetKey(KeyCode, true);
      Window.SetKey(KeyCode, false);
      KeyCode := 0;
    end if;
  end procedure;
  procedure Step(Session: Gui.Session<State.Msg>);
  begin
    Check(Session.Step(), 'The Inputs page closed.');
  end procedure;
  procedure Click(Session: Gui.Session<State.Msg>; Id: string);
  begin
    const Box: Cui.CuiRectangle := Control(Session, Id).Bounds;
    Check(Box.Width > 0 and Box.Height > 0, 'The input action must be visible: ' + Id);
    X := Box.X + Box.Width / 2;
    Y := Box.Y + Box.Height / 2;
    Left := 1;
    Step(Session);
    Left := 0;
    Step(Session);
    Step(Session);
  end procedure;
  procedure TypeText(Session: Gui.Session<State.Msg>; Text: string);
  begin
    Input := Text;
    Step(Session);
    Step(Session);
  end procedure;
  procedure Key(Session: Gui.Session<State.Msg>; Code: int);
  begin
    KeyCode := Code;
    Step(Session);
    Step(Session);
  end procedure;
begin
  Validate();
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Left: int := -1;
  var Input: string := '';
  var KeyCode: int := 0;
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas CUI tags and codes',
    1000,
    1000,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session<State.Msg> := Host.Start<State.Model, State.Msg>(
    new State.Model(Active := State.Page.Inputs),
    GalleryUpdate.Update, View.Build, Window, 32, Inject, ThemeFor := GalleryUpdate.ThemeFor
  );
  Step(Session);
  Step(Session);
  const Topics: Gui.Control := Control(Session, 'input-topics');
  const Code: Gui.Control := Control(Session, 'input-code');
  const Password: Gui.Control := Control(Session, 'input-new-password');
  Check(
    Topics.Value = 'design, c99, native' and Code.Value = '3' and Topics.Bounds.Y < Code.Bounds.Y
    and Code.Bounds.Y < Password.Bounds.Y,
    'The card must show the original topics, verification code and password in order.'
  );
  Session.CapturePng(Capture + '.tags-codes-strength.png');

  Click(Session, 'input-topics');
  TypeText(Session, 'café,');
  TypeText(Session, 'graphics');
  Key(Session, 2);
  Check(
    Control(Session, 'input-topics').Value = 'design, c99, native, café, graphics',
    'Comma and Enter must commit complete UTF-8 tags.'
  );
  Key(Session, 4);
  Check(
    Control(Session, 'input-topics').Value = 'design, c99, native, café',
    'Backspace in an empty draft must remove the last tag.'
  );
  Click(Session, Tags.RemoveId('input-topics', 1));
  Check(
    Control(Session, 'input-topics').Value = 'design, native, café',
    'The native remove action must remove the clicked tag.'
  );

  Click(Session, 'input-code');
  TypeText(Session, 'A-');
  Check(
    Control(Session, 'input-code').Value = '4' and CodeToasts(Session) = 0,
    'Partial codes must ignore punctuation and leave completion pending.'
  );
  TypeText(Session, 'c3');
  Check(
    Control(Session, 'input-code').Value = '6' and CodeToasts(Session) = 1,
    'Completing the code must trigger exactly one toast and expose only the entered length.'
  );
  Step(Session);
  Check(CodeToasts(Session) = 1, 'Repainting a complete code must not trigger another toast.');
  Key(Session, 3);
  Check(not Control(Session, 'input-code').Focused, 'Escape must release code input focus.');

  Click(Session, 'input-new-password');
  TypeText(Session, 'P');
  Check(
    Control(Session, 'input-password-strength').Value = '0',
    'A short password must score zero.'
  );
  TypeText(Session, 'ixelExample7!');
  const Meter: Gui.Control := Control(Session, 'input-password-strength');
  Check(
    Meter.Value = '4' and Meter.Text = 'Strong'
    and Control(Session, 'input-new-password').Value = ''
    and Control(Session, 'input-password').Value = '',
    'Password edits must update the native meter while both password snapshots stay redacted.'
  );
end procedure;

end unit;
