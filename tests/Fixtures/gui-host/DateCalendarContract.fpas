// [Documentation](../../../docs/ui/gui/inputs/date-picker.md)

unit GalleryDateCalendarContract;

uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Mvu.Application as App;
uses Fpas.Ui.Widgets.Inputs.ShortcutRecorders as Keys;
uses Fpas.Ui.Widgets.Pickers.Calendars as C;

uses GalleryHostAssertions as A;
uses GuiGallery.App.State as State;
uses GuiGallery.App.Update as G;
uses GuiGallery.App.View as View;
uses GuiGallery.Pages.Inputs.State as Inputs;
uses System as Sys;

// Verifies the native Due date field and its popup on Inputs.
// ## Parameters
// - `Renderer`: Native renderer under test.
// - `Capture`: Prefix for the closed and open captures.
public procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
  function Update(
    Model: State.Model;
    Message: State.Msg
  ): App.Transition of (State.Model, State.Msg);
  begin
    const Next: App.Transition of (State.Model, State.Msg) := G.Update(Model, Message);
    if ClearSelection then
      const Empty: Inputs.Model := Next.Model.Inputs with
        DueDate := null;
      end with;
      const Cleared: State.Model := Next.Model with
        Inputs := Empty;
      end with;
      return new App.Transition of (State.Model, State.Msg)(Cleared, Next.Commands);
    end if;

    if Target <> '' then
      return new App.Transition of (State.Model, State.Msg)(
        Next.Model,
        [App.Focus of State.Msg(Target)]
      );
    end if;

    return Next;
  end function;

  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Button >= 0 then
      Window.SetLeftButton(Button = 1);
      Button := -1;
    end if;

    if PendingKey <> 0 then
      Window.SetKey(PendingKey, true);
      Window.SetKey(PendingKey, false);
      PendingKey := 0;
    end if;

    if Scroll <> 0.0F then
      Window.Wheel(Scroll);
      Scroll := 0.0F;
    end if;
  end procedure;

  procedure Step(Session: Gui.Session of State.Msg);
  begin
    A.Check(Session.Step(), 'The Inputs page closed unexpectedly.');
  end procedure;

  function Bounds(Session: Gui.Session of State.Msg; Id: string): Cui.CuiRectangle;
  begin
    for Attempt: int := 0 to 15 do
      const Box: Cui.CuiRectangle := A.Control(Session, Id).Bounds;
      A.Check(Box.Width > 0.0F and Box.Height > 0.0F, 'Missing native calendar geometry for ' + Id);
      const Height: float := Session.Snapshot().Size.Height;
      if Box.Y >= 24.0F and Box.Y + Box.Height <= Height - 24.0F then
        return Box;
      end if;

      // The desktop can constrain the requested window height. Scroll the
      // gallery gutter, then reacquire the target's presented geometry.
      const Main: Cui.CuiRectangle := A.Control(Session, 'main-0').Bounds;
      X := Main.X + 4.0F;
      Y := Height * 0.5F;
      Step(Session);
      Scroll := if Box.Y < 24.0F then
        4.0F
      else
        -4.0F
      end if;
      for Frame: int := 1 to 3 do
        Step(Session);
      end for;
    end for;

    raise new Sys.InvalidOperationException(
      'Could not scroll the calendar control into view: ' + Id
    );
  end function;

  procedure Click(Session: Gui.Session of State.Msg; Id: string);
  begin
    const Box: Cui.CuiRectangle := Bounds(Session, Id);
    X := Box.X + Box.Width / 2.0F;
    Y := Box.Y + Box.Height / 2.0F;
    Button := 1;
    Step(Session);
    Button := 0;
    Step(Session);
    X := -1.0F;
    Y := -1.0F;
    Step(Session);
  end procedure;

  procedure Key(Session: Gui.Session of State.Msg; Value: Keys.Key);
  begin
    PendingKey := cast Value as int;
    Step(Session);
    Step(Session);
  end procedure;

  procedure Focus(Session: Gui.Session of State.Msg; Id: string);
  begin
    Target := Id;
    A.Send(Session, State.Msg.Preview);
    Target := '';
    A.Check(A.Control(Session, Id).Focused, 'Focus did not reach ' + Id);
  end procedure;

  function HasControl(Session: Gui.Session of State.Msg; Id: string): bool;
  begin
    for Item: Gui.Control in Session.Snapshot().Controls do
      if Item.Id = Id then
        return true;
      end if;
    end for;

    return false;
  end function;

  procedure CheckDate(Session: Gui.Session of State.Msg; Expected: string);
  begin
    A.Check(
      A.Control(Session, Due).Value = Expected,
      'The Due date field must show the model selection.'
    );
  end procedure;
begin
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Button: int := -1;
  var PendingKey: int := 0;
  var Target: string := '';
  var ClearSelection: bool := false;
  var Scroll: float := 0.0F;
  const Due: string := 'input-due-date';
  const Nov14: Sys.DateOnly := new Sys.DateOnly(2026, 11, 14);
  const Nov17: Sys.DateOnly := new Sys.DateOnly(2026, 11, 17);
  const Jan17: Sys.DateOnly := new Sys.DateOnly(2027, 1, 17);
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas CUI Due date',
    1000,
    1700,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of State.Msg := Host.Start of (State.Model, State.Msg)(
    new State.Model(Active := State.Page.Inputs),
    Update,
    View.Build,
    Window,
    256,
    Inject,
    ThemeFor := G.ThemeFor
  );
  Step(Session);
  Step(Session);
  CheckDate(Session, '2026-11-14');
  const Field: Cui.CuiRectangle := A.Control(Session, Due).Bounds;
  A.Check(
    A.Control(
      Session,
      Due
    ).Text = 'Due date' and Field.X = A.Control(Session, 'input-country').Bounds.X
    and Field.Y = A.Control(Session, 'input-seats').Bounds.Y,
    'Due date must occupy the original Inputs grid cell.'
  );
  A.Check(
    not HasControl(Session, 'input-calendar') and not HasControl(Session, C.DayId(Due, Nov14)),
    'Inputs must show the date field with its popup closed.'
  );
  Session.CapturePng(Capture + '.due-date.png');
  Focus(Session, Due);
  Key(Session, Keys.Key.Up);
  Session.CapturePng(Capture + '.due-date-focused.png');

  Click(Session, Due);
  A.Check(
    HasControl(Session, C.DayId(Due, Nov14)),
    'The native picker must show its selected date.'
  );
  Session.CapturePng(Capture + '.due-date-open.png');
  Click(Session, C.DayId(Due, Nov17));
  CheckDate(Session, '2026-11-17');
  A.Check(
    A.Control(Session, Due).Focused and not HasControl(Session, C.DayId(Due, Nov17)),
    'Selecting a date must close the popup and return focus to the field.'
  );

  Focus(Session, Due);
  Key(Session, Keys.Key.Enter);
  A.Check(
    HasControl(Session, C.DayId(Due, Nov17)),
    'Enter must open the focused field with the new selection.'
  );
  Key(Session, Keys.Key.Escape);
  A.Check(
    A.Control(Session, Due).Focused and not HasControl(Session, C.DayId(Due, Nov17)),
    'Escape must dismiss the calendar and restore the field focus.'
  );
  CheckDate(Session, '2026-11-17');

  Key(Session, Keys.Key.Enter);
  const Next: string := C.MonthId(Due, true);
  Click(Session, Next);
  Click(Session, Next);
  A.Check(
    HasControl(Session, C.DayId(Due, Jan17)),
    'The popup must browse across the year boundary.'
  );
  CheckDate(Session, '2026-11-17');
  Click(Session, C.DayId(Due, Jan17));
  CheckDate(Session, '2027-01-17');

  ClearSelection := true;
  A.Send(Session, State.Msg.Preview);
  ClearSelection := false;
  CheckDate(Session, '');
end procedure;

end unit;
