// [Documentation](../../../docs/ui/gui/desktop.md)

unit DesktopCommandMappingContract;

uses Fpas.Ui.Gui.Closing as Closing;
uses Fpas.Ui.Gui.FileDialogs as Files;
uses Fpas.Ui.Gui.Frames as Frames;
uses Fpas.Ui.Gui.Windows as Windows;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Mvu.Composition as Composition;

uses System as Sys;

function Payload(Value: Mvu.Command of string): Sys.Object;
begin
  case Value of
    when Mvu.Command.Host(const Request: Mvu.HostRequest):
      case Request of
        when Mvu.HostRequest.Extension(const Extension: Sys.Object):
          return Extension;
        else
      end case;
    else
  end case;

  raise new Sys.InvalidOperationException('Expected an owner-thread extension.');
end function;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function Map(Value: Mvu.Command of int): Sys.Object;
begin
  return Payload(
    Composition.MapCommand of (int, string)(
      Value,
      function(Message: int): string => 'child:' + Message.ToString()
    )
  );
end function;

// Verifies typed selected/cancelled results across a feature slice and command mapping.
public procedure Verify();
begin
  const Requests: array of Mvu.Command of int := [
    Files.OpenFile of int(
      function(Path: string): int => Path.Length,
      'Open',
      'Text',
      'txt',
      function(): int => -1
    ),
    Files.SaveFile of int(
      function(Path: string): int => Path.Length,
      'notes — été.txt',
      'Save',
      'Text',
      'txt',
      function(): int => -1
    ),
    Files.ChooseFolder of int(
      function(Path: string): int => Path.Length,
      'Folder',
      function(): int => -1
    )
  ];
  for Index: int := 0 to Requests.Length - 1 do
    const Request: Files.Request of string := cast<Files.Request of string>(Map(Requests[Index]));
    Check(cast<int>(Request.Kind) = Index, 'Mapping lost the native dialog kind.');
    Check(Request.OnSelected('été') = 'child:3', 'Selected paths did not map into the parent.');
    case Request.OnCancelled of
      when is Sys.Func of string as Notify:
        Check(Notify.Invoke() = 'child:-1', 'Dialog cancellation did not map into the parent.');
      else
        raise new Sys.InvalidOperationException('Mapped cancellation callback is missing.');
    end case;

    if Index = 1 then
      Check(
        Request.DefaultName = 'notes — été.txt' and Request.Accept = 'txt',
        'Save options changed during mapping.'
      );
    end if;
  end for;
  const Silent: Files.Request of string := cast<Files.Request of string>(Map(
    Files.ChooseFolder of int(function(Path: string): int => Path.Length)
  ));
  Check(Silent.OnCancelled = null, 'Mapping must preserve silent cancellation.');
  const Title: Windows.TitleRequest of string := cast<Windows.TitleRequest of string>(Map(
    Windows.SetTitle of int('Document')
  ));
  Check(Title.Title = 'Document', 'Mapping lost the window title.');
  const Size: Windows.SizeRequest of string := cast<Windows.SizeRequest of string>(Map(
    Windows.Resize of int(420, 300)
  ));
  Check(Size.Width = 420 and Size.Height = 300, 'Mapping lost the native size.');
  const Frame: Frames.Request of string := cast<Frames.Request of string>(Map(
    Frames.Redraw of int(0.25F)
  ));
  Check(Frame.DelaySeconds = 0.25F, 'Mapping lost the native frame deadline.');
  Check(
    Map(Closing.Cancel of int()) is Closing.CancelRequest of string,
    'Mapping lost the close rejection.'
  );
end procedure;

end unit;
