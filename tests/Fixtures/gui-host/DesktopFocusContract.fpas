// [Documentation](../../../docs/ui/gui/desktop.md)

unit DesktopFocusContract;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Gui.Windows as Windows;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Canvas.Canvases as Canvas;
uses Fpas.Ui.Widgets.Overlays.Dialogs as D;

uses System as Sys;

type Message = variant
  Focus;
  Open;
  Close;
  Placement;
end variant;

type CanvasMessage = variant
  Focus;
  Input(Value: Canvas.Input);
  Ignore;
end variant;

procedure Step of TMsg(Session: Gui.Session of TMsg; Window: Cui.CuiWindow);
begin
  discard Window.TryWake();
  if not Session.Step() then
    raise new Sys.InvalidOperationException('Focus test session closed.');
  end if;
end procedure;

procedure RequireFocus of TMsg(Session: Gui.Session of TMsg; Id: string);
begin
  for Control: Gui.Control in Session.Snapshot().Controls do
    if Control.Id = Id and Control.Focused then
      return;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Lost focus target ' + Id + ' across a host result.');
end procedure;

procedure CanvasBacklog(Renderer: Cui.CuiRenderer);
  function Update(Model: string; Message: CanvasMessage): Mvu.Transition of (string, CanvasMessage);
  begin
    case Message of
      when CanvasMessage.Focus:
        return new Mvu.Transition of (string, CanvasMessage)(
          Model,
          [Mvu.Focus of CanvasMessage('canvas')]
        );
      when CanvasMessage.Input(const Value: Canvas.Input):
        case Value of
          when Canvas.Input.Text(const Text: string):
            return new Mvu.Transition of (string, CanvasMessage)(Model + Text, []);
          else
        end case;
      else
    end case;

    return new Mvu.Transition of (string, CanvasMessage)(Model, []);
  end function;

  function View(Model: string; Size: L.Viewport): E.Element of CanvasMessage;
  begin
    return E.Column of CanvasMessage(
      new L.Flow(),
      Canvas.Canvas of CanvasMessage(
        'canvas', [], function(Value: Canvas.Event): CanvasMessage => CanvasMessage.Ignore,
        OnInput := CanvasMessage.Input
      ),
      E.Text of CanvasMessage(Model)
    );
  end function;

  procedure Inject();
  begin
    for Text: string in Input do
      Window.InputText(Text);
    end for;

    Input := [];
  end procedure;
begin
  var Input: array of string := [];
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Canvas input backlog',
    420,
    300,
    Renderer,
    true
  );
  using const Session: Gui.Session of CanvasMessage := Host.Start of (string, CanvasMessage)(
    'Text: ', Update, View, Window, 1, Inject
  );
  Step(Session, Window);
  discard Session.Post(CanvasMessage.Focus);
  Step(Session, Window);
  Step(Session, Window);
  RequireFocus(Session, 'canvas');

  Input := ['first ', 'second '];
  Step(Session, Window);
  Input := ['discarded '];
  Step(Session, Window);
  RequireFocus(Session, 'canvas');
  Step(Session, Window);

  Input := ['third'];
  Step(Session, Window);
  Step(Session, Window);
  RequireFocus(Session, 'canvas');
  for Label: string in Session.Snapshot().Text do
    if Label = 'Text: first second third' then
      return;
    end if;
  end for;

  raise new Sys.InvalidOperationException(
    'Canvas text did not resume after the backlog in input order.'
  );
end procedure;

// Checks that focus commands and modal focus survive a frame with pending host results.
// ## Parameters
// - `Renderer`: Native renderer used for the owned window.
public procedure Verify(Renderer: Cui.CuiRenderer);
  function Update(Open: bool; Msg: Message): Mvu.Transition of (bool, Message);
  begin
    const Placement: Mvu.Command of Message := Windows.ReadPlacement of Message(
      function(Value: Cui.CuiWindowPlacement): Message => Message.Placement
    );
    return case Msg of
      when Message.Focus: new Mvu.Transition of (bool, Message)(
        Open,
        [Mvu.Focus of Message('base-target'), Placement]
      );
      when Message.Open: new Mvu.Transition of (bool, Message)(true, [Placement]);
      when Message.Close: new Mvu.Transition of (bool, Message)(false, [Placement]);
      when Message.Placement: new Mvu.Transition of (bool, Message)(Open, []);
    end case;
  end function;

  function View(Open: bool; Size: L.Viewport): E.Element of Message;
  begin
    return D.Dialog of Message(
      'dialog',
      E.Column of Message(
        new L.Flow(Scope := new L.FocusScope('workspace', true)),
        B.Button of Message('first', 'First', Message.Focus),
        B.Button of Message('base-target', 'Base target', Message.Open)
      ),
      E.Column of Message(
        new L.Flow(),
        Canvas.Canvas of Message(
          'modal-canvas', [], function(Value: Canvas.Event): Message => Message.Close,
          OnInput := function(Value: Canvas.Input): Message => Message.Placement
        ),
        B.Button of Message('other', 'Other', Message.Close),
        B.Button of Message('modal-target', 'Modal target', Message.Close)
      ),
      Open,
      new D.Options('Modal', InitialFocus := 'modal-target'),
      Message.Close
    );
  end function;

  procedure Inject();
  begin
    if ReverseTab then
      Window.SetKey(1, true, 1);
      Window.SetKey(1, false, 1);
      ReverseTab := false;
    end if;
  end procedure;
begin
  var ReverseTab: bool := false;
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Desktop deferred focus',
    420,
    300,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of Message := Host.Start of (bool, Message)(
    false, Update, View, Window, 1, Inject
  );
  Step(Session, Window);
  discard Session.Post(Message.Focus);
  Step(Session, Window);
  Step(Session, Window);
  RequireFocus(Session, 'base-target');

  discard Session.Post(Message.Open);
  Step(Session, Window);
  Step(Session, Window);
  RequireFocus(Session, 'modal-target');
  ReverseTab := true;
  Step(Session, Window);
  RequireFocus(Session, 'other');

  discard Session.Post(Message.Close);
  Step(Session, Window);
  Step(Session, Window);
  Step(Session, Window);
  RequireFocus(Session, 'base-target');
  Session.Dispose();
  CanvasBacklog(Renderer);
end procedure;

end unit;
