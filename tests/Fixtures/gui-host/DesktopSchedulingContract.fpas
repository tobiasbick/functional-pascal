// [Documentation](../../../docs/ui/gui/host.md)

unit DesktopSchedulingContract;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Frames as Frames;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Widgets.Actions.Buttons as Buttons;
uses Fpas.Ui.Widgets.Desktop.Dockspaces as Dock;
uses Fpas.Ui.Widgets.Overlays.Dialogs as Dialog;
uses System as Sys;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

procedure DockedModal(Renderer: Cui.CuiRenderer);
  function View(Model: bool; Size: L.Viewport): E.Element<bool>;
  begin
    Builds := Builds + 1;
    return E.Column<bool>(
      new L.Flow(),
      Buttons.Button<bool>('outside', 'Outside', true),
      Dock.Dockspace<bool>(
        'dock', [
          new Dock.Panel<bool>(
            'panel', 'Panel',
            Dialog.Dialog<bool>(
              'dialog',
              E.Text<bool>('Base'),
              Buttons.Button<bool>('inside', 'Inside', true),
              true,
              new Dialog.Options('Dialog'),
              false
            )
          )
        ], new Dock.Options(
          Height := L.Extent.Fixed(L.Measure.Logical(190)), InitialLayout := 'dock1 [*panel]'
        )
      )
    );
  end function;
  async function Guard(): Tasks.Task;
  begin
    await Tasks.Task.Delay(3000, Cancellation.Token).ConfigureAwait(false);
    Threads.Volatile.Write(ref TimedOut[0], true);
    discard Window.TryWake();
  end function;
begin
  var Builds: int := 0;
  const TimedOut: array of bool := [false];
  using const Cancellation: Threads.CancellationTokenSource := new Threads.CancellationTokenSource();
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Docked modal reconciliation',
    420,
    300,
    Renderer
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session<bool> := Host.Start<bool, bool>(
    true,
    function(Model: bool; Message: bool): Mvu.Transition<bool, bool> => new Mvu.Transition<bool, bool>(
      Model,
      []
    ),
    View,
    Window,
    16
  );
  const Watchdog: Tasks.Task := Guard();
  try
    var Visible: bool := false;
    for Attempt: int := 1 to 8 do
      if not Session.Step() or Threads.Volatile.Read(in TimedOut[0]) then
        break;
      end if;

      for Control: Gui.Control in Session.Snapshot().Controls do
        if Control.Id = 'dock/panel' and Control.Value = 'True' then
          Visible := true;
        end if;
      end for;

      if Visible then
        break;
      end if;
    end for;

    if not Visible then
      raise new Sys.InvalidOperationException('The initial dock panel did not become visible.');
    end if;

    const Before: int := Builds;
    if not Session.Step() or Threads.Volatile.Read(in TimedOut[0]) then
      raise new Sys.InvalidOperationException('Dock visibility did not wake modal reconciliation.');
    end if;
    var Inside: bool := false;
    var Outside: bool := true;
    for Control: Gui.Control in Session.Snapshot().Controls do
      if Control.Id = 'inside' then
        Inside := Control.Enabled;
      elsif Control.Id = 'outside' then
        Outside := Control.Enabled;
      end if;
    end for;

    if not Inside or Outside or Builds <> Before then
      raise new Sys.InvalidOperationException(
        'Docked modal input did not reconcile on the cached view.'
      );
    end if;
  finally
    Cancellation.Cancel();
    try
      Watchdog.GetAwaiter().GetResult();
    catch Cancelled: Sys.OperationCanceledException do
    end try;
  end try;
end procedure;

// Checks that a queued MVU deadline survives frame construction and then permits idle waiting.
// ## Parameters
// - `Renderer`: Native renderer for the event-driven window.
public procedure Verify(Renderer: Cui.CuiRenderer);
  function Update(Model: int; Message: int): Mvu.Transition<int, int>;
  begin
    return new Mvu.Transition<int, int>(
      Model,
      [Frames.Redraw<int>(30.0F), Frames.Redraw<int>(0.05F)]
    );
  end function;
  function View(Model: int; Size: L.Viewport): E.Element<int>;
  begin
    Builds := Builds + 1;
    return E.Text<int>('A cached view with a native deadline');
  end function;
  async function Guard(): Tasks.Task;
  begin
    await Tasks.Task.Delay(3000, Cancellation.Token).ConfigureAwait(false);
    Threads.Volatile.Write(ref TimedOut[0], true);
    discard Window.TryWake();
  end function;
begin
  DockedModal(Renderer);
  var Builds: int := 0;
  const TimedOut: array of bool := [false];
  using const Cancellation: Threads.CancellationTokenSource := new Threads.CancellationTokenSource();
  const Window: Cui.CuiWindow := new Cui.CuiWindow('MVU native frame deadline', 420, 300, Renderer);
  Window.SetReducedMotion(true);
  using const Session: Gui.Session<int> := Host.Start<int, int>(0, Update, View, Window, 64);
  for Index: int := 0 to 5 do
    discard Window.TryWake();
    if not Session.Step() then
      raise new Sys.InvalidOperationException('Initial frame closed.');
    end if;
  end for;

  discard Session.Post(1);
  if not Session.Step() then
    raise new Sys.InvalidOperationException('Scheduling frame closed.');
  end if;
  const Before: int := Builds;
  const Watchdog: Tasks.Task := Guard();
  try
    if not Session.Step() then
      raise new Sys.InvalidOperationException('Scheduled frame closed.');
    end if;

    if Threads.Volatile.Read(in TimedOut[0]) then
      raise new Sys.InvalidOperationException(
        'The native deadline was lost during view construction.'
      );
    end if;

    if Builds <> Before then
      raise new Sys.InvalidOperationException('A native repaint rebuilt the model view.');
    end if;
  finally
    Cancellation.Cancel();
    try
      Watchdog.GetAwaiter().GetResult();
    catch Cancelled: Sys.OperationCanceledException do
    end try;
  end try;
end procedure;

end unit;
