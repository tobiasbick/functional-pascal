unit GalleryDisplayContract;

uses
  GuiGallery.App.State as State, GuiGallery.App.Update as Update, GuiGallery.App.View as Gallery,
  GalleryHostAssertions as A,
  Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Gui.Internal.Session as Host,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as Context,
  Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.ShortcutRecorders as Keys;

procedure CheckPage(Page: State.Page; Renderer: Cui.CuiRenderer; Root: string; Width: int);
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Page = State.Page.Disclosure and Scroll then
      var Current: float := 0.0F;
      var Maximum: float := 0.0F;
      Window.ScrollState(
        Context.Token('scroll', 'main-disclosure-0'),
        0,
        1500.0F,
        out Current,
        out Maximum
      );
    end if;

    if Enter then
      Window.SetKey(cast<int>(Keys.Key.Enter), true);
      Window.SetKey(cast<int>(Keys.Key.Enter), false);
      Enter := false;
    end if;

    if Button >= 0 then
      Window.SetLeftButton(Button = 1);
      Button := -1;
    end if;
  end procedure;

  function Apply(Model: State.Model; Message: State.Msg): Mvu.Transition<State.Model, State.Msg>;
  begin
    const Next: Mvu.Transition<State.Model, State.Msg> := Update.Update(Model, Message);
    Selected := Next.Model.DisplaySwatch;
    return Next;
  end function;

  procedure Step(Session: Gui.Session<State.Msg>);
  begin
    A.Check(Session.Step(), 'Display gallery closed.');
  end procedure;

  procedure Click(Session: Gui.Session<State.Msg>; Id: string);
  begin
    const Area: Cui.CuiRectangle := A.Control(Session, Id).Bounds;
    A.Check(Area.Width > 0.0F and Area.Height > 0.0F, 'No pointer target for ' + Id);
    X := Area.X + Area.Width / 2.0F;
    Y := Area.Y + Area.Height / 2.0F;
    Step(Session);
    Button := 1;
    Step(Session);
    Button := 0;
    Step(Session);
    Step(Session);
  end procedure;
begin
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Button: int := -1;
  var Enter: bool := false;
  var Selected: int := 0;
  var Scroll: bool := false;
  const Window: Cui.CuiWindow := new Cui.CuiWindow('FPas CUI display', Width, 1700, Renderer, true);
  Window.SetReducedMotion(true);
  using const Session: Gui.Session<State.Msg> := Host.Start<State.Model, State.Msg>(
    new State.Model(Active := Page),
    Apply,
    Gallery.Build,
    Window,
    32,
    Inject,
    ThemeFor := Update.ThemeFor
  );
  for Frame: int := 0 to 2 do
    Step(Session);
  end for;

  Scroll := true;
  for Frame: int := 0 to 5 do
    Step(Session);
  end for;

  Session.CapturePng(Root + '-' + Width.ToString() + '.png');

  if Page = State.Page.Display then
    A.Check(A.HasText(Session, 'fpas run'), 'The inline code sample is missing.');
    A.Check(A.HasText(Session, 'Ctrl Shift P'), 'The keycap sample is missing.');
    Click(Session, 'accent-2');
    A.Check(Selected = 2, 'Clicking the blue canvas must select its swatch.');
  else
    A.Check(A.Control(Session, 'photo').Value = 'false', 'The photo starts covered.');
    Click(Session, 'photo');
    A.Check(A.Control(Session, 'photo').Value = 'true', 'Clicking the photo must reveal it.');
    Enter := true;
    Step(Session);
    Step(Session);
    A.Check(A.Control(Session, 'photo').Value = 'false', 'Enter must cover the focused photo.');
    Click(Session, 'photo');
    Click(Session, 'reveal-sample-key');
    Click(Session, 'spoiler');
    A.Check(A.Control(Session, 'photo').Value = 'true', 'Clicking the photo must reveal it.');
    A.Check(
      A.Control(Session, 'sample-key').Value = 'true',
      'The Reveal button must uncover the sample key.'
    );
    A.Check(A.Control(Session, 'spoiler').Value = 'true', 'Clicking the spoiler must reveal it.');
    X := -1.0F;
    Y := -1.0F;
    Step(Session);
    Session.CapturePng(Root + '-' + Width.ToString() + '-revealed.png');
    Click(Session, 'photo');
    Click(Session, 'reveal-sample-key');
    Click(Session, 'spoiler');
    A.Check(
      A.Control(Session, 'photo').Value = 'false',
      'Clicking a revealed photo must cover it again.'
    );
    A.Check(
      A.Control(Session, 'sample-key').Value = 'false',
      'The Hide button must cover the sample key again.'
    );
    A.Check(
      A.Control(Session, 'spoiler').Value = 'false',
      'Clicking a revealed spoiler must cover it again.'
    );
  end if;
end procedure;

// Captures the native display examples and tests pointer selection and Veil state.
// ## Parameters
// - `Renderer`: Native renderer under test.
// - `Capture`: Prefix of the screenshot paths.
public procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
begin
  CheckPage(State.Page.Display, Renderer, Capture + '-display', 1100);
  CheckPage(State.Page.Display, Renderer, Capture + '-display', 550);
  CheckPage(State.Page.Disclosure, Renderer, Capture + '-disclosure', 1100);
  CheckPage(State.Page.Disclosure, Renderer, Capture + '-disclosure', 550);
end procedure;

end unit;
