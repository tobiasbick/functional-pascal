// [Documentation](../../../docs/ui/gui/canvas-and-bars/painting.md)

unit DrawingResourcesContract;

uses Fpas.Ui.Composition as Composition;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Colors as Colors;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Cui.Resources as Resources;
uses Fpas.Ui.Gui.Fonts as Fonts;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Gui.Localization as Localization;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Canvas.Canvases as Canvas;
uses Fpas.Ui.Widgets.Canvas.Painting as Painting;
uses Fpas.Ui.Widgets.Inputs.ShortcutRecorders as Keys;
uses Fpas.Ui.Widgets.Media.MediaImages as Images;
uses Fpas.Ui.Widgets.Theming.ThemeMetrics as Metrics;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;

type Msg = variant
  Load;
  Completed;
  Pointer(Value: bool);
  Scale;
  RequestCanvas;
end variant;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

procedure RejectUpdate(
  Name: string; Source: Images.Source; X: int; Y: int; Width: int; Height: int;
  Bytes: array of byte; Pitch: int; Precondition: bool := false
);
begin
  try
    discard Images.Update(Source, X, Y, Width, Height, Bytes, Pitch);
  catch Error: Sys.ArgumentException do
    if Precondition then
      raise;
    end if;

    return;
  catch Error: Sys.InvalidOperationException do
    if not Precondition then
      raise;
    end if;

    return;
  end try;

  raise new Sys.InvalidOperationException('Image update accepted ' + Name);
end procedure;

procedure ValidateImageUpdate();
begin
  const Pixels: array of byte := new byte[16];
  const Region: array of byte := [1, 2, 3, 4, 99, 5, 6, 7, 8];
  const Original: Images.Source := Images.Source.Rgba(2, 2, Pixels);
  const Updated: Images.Source := Images.Update(Original, 1, 0, 1, 2, Region, 5);
  Region[0] := 0;
  case Updated of
    when Images.Source.UpdatedRgba(
      _,
      _,
      const Data: array of byte,
      const Previous: array of byte,
      _,
      _,
      _,
      _
    ):
      Check(
        Previous[4] = 0 and Data[4] = 1 and Data[12] = 5 and Data[15] = 8,
        'The strided region or previous snapshot was overwritten.'
      );
    else
      raise new Sys.InvalidOperationException('Expected an updated RGBA source.');
  end case;
  const Patch: array of byte := [11, 22, 33, 44];
  RejectUpdate('file source', Images.Source.File('unused'), 0, 0, 1, 1, Patch, 0);
  RejectUpdate('negative x', Original, -1, 0, 1, 1, Patch, 0, true);
  RejectUpdate('zero width', Original, 0, 0, 0, 1, Patch, 0, true);
  RejectUpdate('negative stride', Original, 0, 0, 1, 1, Patch, -1);
  RejectUpdate('short stride', Original, 0, 0, 1, 1, Patch, 3);
  RejectUpdate('incomplete final row', Original, 0, 0, 1, 2, new byte[8], 5);
  RejectUpdate('short original', Images.Source.Rgba(2, 2, Patch), 0, 0, 1, 1, Patch, 0);
  RejectUpdate(
    'overflow dimensions',
    Images.Source.Rgba(int.MaxValue, int.MaxValue, Patch),
    0,
    0,
    1,
    1,
    Patch,
    0
  );
  RejectUpdate('bottom edge', Original, 0, 1, 1, 2, new byte[8], 0);
  RejectUpdate('right edge', Updated, 1, 0, 2, 1, Region, 0);
  const Last: Images.Source := Images.Update(Updated, 0, 0, 1, 1, Patch);
  case Last of
    when Images.Source.UpdatedRgba(
      _,
      _,
      const Data: array of byte,
      const Previous: array of byte,
      _,
      _,
      _,
      _
    ):
      Check(
        Data[0] = 11 and Previous[0] = 0 and Data[12] = 5 and Previous[12] = 5 and Pixels[12] = 0,
        'Successive updates must preserve both previous revisions.'
      );
    else
      raise new Sys.InvalidOperationException('Missing second revision.');
  end case;
end procedure;

procedure ValidateMetrics();
begin
  var Rejected: bool := false;
  try
    discard Metrics.Native(new Metrics.Options(Motion := -1.0F));
  catch Error: Sys.ArgumentOutOfRangeException do
    Rejected := true;
  end try;

  Check(Rejected, 'Public motion cannot use the native preservation sentinel.');
  Rejected := false;
  try
    discard Metrics.Native(
      new Metrics.Options(
        Floating := new Metrics.Elevation(Primary := new Metrics.Shadow(Blur := -1.0F))
      )
    );
  catch Error: Sys.ArgumentOutOfRangeException do
    Rejected := true;
  end try;

  Check(Rejected, 'Public shadow blur cannot use the native preservation sentinel.');
end procedure;

// Exercises mapped font commands, shared drawing capabilities, native palettes and pointer mapping.
// ## Parameters
// - `Renderer`: Native renderer for the bounded session.
// - `FontBytes`: Trusted TTF/OTF bytes, or null to exercise native rejection without a font dependency.
public procedure Verify(Renderer: Cui.CuiRenderer; FontBytes: (array of byte)? := null);
  function Update(Model: bool; Message: Msg): Mvu.Transition<bool, Msg>;
  begin
    case Message of
      when Msg.Load:
        const Child: Fonts.Request<bool> := new Fonts.Request<bool>(
          Fonts.Operation<bool>.Load(
            Bytes,
            function(Face: Resources.CuiFontFace?): bool begin
              Loaded := Face;
              return (Face <> null) = Expected;
            end function
          )
        );
        return new Mvu.Transition<bool, Msg>(
          Model, [
            Mvu.Command<Msg>.Host(
              Mvu.HostRequest.Extension(
                Child.Map<Msg>(
                  function(Success: bool): Msg begin
                    Check(Success, 'Native font acceptance did not match the supplied data.');
                    return Msg.Completed;
                  end function
                )
              )
            )
          ]
        );
      when Msg.Completed:
        Done := true;
        return new Mvu.Transition<bool, Msg>(
          Model, [
            Fonts.Apply<Msg>(Fonts.Operation<Msg>.Assign(G.Font.Body, Loaded)),
            Localization.Set<Msg>(new Resources.CuiStrings(Today := 'Heute 日本'))
          ]
        );
      when Msg.Pointer(const Hovered: bool):
        PointerEvents := PointerEvents + 1;
        return new Mvu.Transition<bool, Msg>(Model, []);
      when Msg.RequestCanvas:
        return new Mvu.Transition<bool, Msg>(Model, [Mvu.Focus<Msg>('paint')]);
      when Msg.Scale:
        return new Mvu.Transition<bool, Msg>(not Model, []);
    end case;
  end function;
  function ThemeFor(Model: bool; Appearance: Themes.Mode?): Themes.Theme;
  begin
    const T: Themes.Theme := Themes.Dark(Themes.Accent.Blue);
    return T with
      Metrics := new Metrics.Options(
        FontScale := if Model then
          1.5F
        else
          1.0F
        end if, Motion := 0.0F
      );
    end with;
  end function;
  procedure Paint(Surface: Painting.Surface);
  begin
    Paints := Paints + 1;
    Retained := Surface;
    LastScale := Surface.FontScale();
    Check(
      Surface.Width() > 0.0F and Surface.Height() > 0.0F,
      'The painter needs final layout geometry.'
    );
    Check(not Surface.Disabled(), 'The enabled canvas was marked disabled.');
    const Color: G.Color := Colors.Oklch(0.7F, 0.1F, 240.0F);
    Surface.Rectangle(0.0F, 0.0F, Surface.Width(), Surface.Height(), 0.0F, Color);
    Surface.Text(
      8.0F,
      8.0F,
      'Grüße 日本 🎵',
      G.Font.Body,
      13.0F * Surface.FontScale(),
      new G.Color(255, 255, 255)
    );
    Check(
      Surface.Measure('Unicode 🎵', G.Font.Body, 13.0F).Width > 0.0F,
      'Native Unicode measurement failed.'
    );
    Surface.Image(
      Picture,
      20.0F,
      60.0F,
      20.0F,
      20.0F,
      2.0F,
      new G.Color(255, 255, 255)
    );
    Surface.PushClip(0.0F, 0.0F, 40.0F, 40.0F);
    Surface.Line(0.0F, 0.0F, 50.0F, 50.0F, 2.0F, Color);
  end procedure;
  function View(Model: bool; Size: L.Viewport; Theme: Themes.Theme): E.Element<Msg>;
  begin
    return E.Column<Msg>(
      new L.Flow(Scope := new L.FocusScope('art', true)),
      Composition.Map<bool, Msg>(
        Canvas.Canvas<bool>(
          'paint', [], function(_Event: Canvas.Event): bool => false,
          new Canvas.Options(Height := L.Extent.Fixed(L.Measure.Logical(130))), Paint := Paint,
          OnPointer := function(State: Canvas.Pointer): bool => State.Hovered,
          OnInput := function(Input: Canvas.Input): bool begin
            case Input of
              when Canvas.Input.Key(
                const Code: Keys.Key,
                const Mods: Keys.Modifier,
                const Down: bool,
                _
              ):
                if Down and Code = Keys.Key.A and Mods = Keys.Modifier.Shift then
                  SawKey := true;
                end if;
              when Canvas.Input.Text(const Value: string):
                Received := Value;
              else
            end case;

            return false;
          end function
        ), Msg.Pointer
      )
    );
  end function;
  procedure Inject();
  begin
    Window.MovePointer(20.0F, 20.0F);
    if SendText then
      SendText := false;
      Window.SetKey(15, true, 1);
      Window.SetKey(15, false, 1);
      Window.InputText('Grüße 🎵');
    end if;
  end procedure;
  procedure Steps(Value: Gui.Session<Msg>);
  begin
    for Index: int := 0 to 3 do
      Check(Value.Step(), 'The drawing session closed.');
    end for;
  end procedure;
begin
  ValidateMetrics();
  ValidateImageUpdate();
  var SendText: bool := false;
  var SawKey: bool := false;
  var Received: string := '';
  var Loaded: Resources.CuiFontFace? := null;
  var Done: bool := false;
  var Paints: int := 0;
  var PointerEvents: int := 0;
  var LastScale: float := 0.0F;
  var Retained: Painting.Surface? := null;
  const Pixels: array of byte := [220, 80, 40, 255];
  const Picture: Images.Source := Images.Update(
    Images.Source.Rgba(1, 1, Pixels),
    0,
    0,
    1,
    1,
    Pixels
  );
  const Bytes: array of byte := FontBytes ?? new byte[0];
  const Expected: bool := Bytes.Length > 0;
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPAS drawing contract',
    480,
    240,
    Renderer,
    true
  );
  using const Session: Gui.Session<Msg> := Host.StartThemed<bool, Msg>(
    false, Update, View, Window, 32, Inject,
    Themes.Dark(), ThemeFor, true
  );
  Check(
    Session.IsSoftware() = (Renderer = Cui.CuiRenderer.Software),
    'Unexpected native renderer.'
  );
  Steps(Session);
  Check(Paints > 0 and PointerEvents > 0, 'Shared canvas mapping lost paint or pointer callbacks.');
  const Count: int := PointerEvents;
  Steps(Session);
  Check(PointerEvents = Count, 'Idle canvas pointer state caused a message loop.');
  var Rejected: bool := false;
  try
    if Retained <> null then
      discard Retained.Width();
    end if;
  catch Error: Sys.InvalidOperationException do
    Rejected := true;
  end try;

  Check(Rejected, 'A retained drawing capability remained active.');
  discard Session.Post(Msg.RequestCanvas);
  Steps(Session);
  SendText := true;
  Steps(Session);
  Check(
    SawKey and Received = 'Grüße 🎵',
    'Mapped canvas lost committed text after an MVU focus request.'
  );
  discard Session.Post(Msg.Load);
  Steps(Session);
  Check(Done and ((Loaded <> null) = Expected), 'A mapped font completion did not arrive.');
  discard Session.Post(Msg.Scale);
  Steps(Session);
  Check(LastScale = 1.5F, 'The shared theme did not reach native drawing.');
  Rejected := false;
  try
    discard V.Prepare<Msg>(
      View(false, new L.Viewport(L.SizeClass.Regular, L.SizeClass.Regular), Themes.Light()),
      V.Target.Terminal
    );
  catch Error: Sys.ArgumentException do
    Rejected := true;
  end try;

  Check(Rejected, 'The terminal profile accepted a graphical canvas.');
end procedure;

end unit;
