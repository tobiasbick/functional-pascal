unit GalleryEditingToolsContract;

uses
  GuiGallery.App.State as State, GuiGallery.App.Update as Update, GuiGallery.App.View as Gallery,
  GalleryHostAssertions as A, Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Gui.Internal.Session as Host,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as Context,
  Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.ShortcutRecorders as Keys;

procedure CapturePage(Renderer: Cui.CuiRenderer; Root: string; Width: int);
  procedure Inject();
  begin
    Window.MovePointer(-1.0F, -1.0F);
    if Offset > 0 then
      var Current: float := 0.0F;
      var Maximum: float := 0.0F;
      Window.ScrollState(Token, 0, cast<float>(Offset), out Current, out Maximum);
    end if;

    if Key <> 0 then
      Window.SetKey(Key, true, Modifiers);
      Window.SetKey(Key, false, Modifiers);
      Key := 0;
      Modifiers := 0;
    end if;
  end procedure;

  function Observe(Model: State.Model; Value: State.Msg): Mvu.Transition<State.Model, State.Msg>;
  begin
    const Next: Mvu.Transition<State.Model, State.Msg> := Update.Update(Model, Value);
    Shot := Next.Model.Editing.Timeline.Time;
    Rotation := Next.Model.Editing.Tracks[3].Keys[2].Curve.X;
    if Focus then
      return new Mvu.Transition<State.Model, State.Msg>(Next.Model, [Mvu.Focus<State.Msg>('shot')]);
    end if;

    return Next;
  end function;

  procedure Draw(Session: Gui.Session<State.Msg>);
  begin
    A.Check(Session.Step(), 'Editing tools gallery closed.');
  end procedure;
begin
  var Offset: int := 0;
  var Key: int := 0;
  var Modifiers: int := 0;
  var Focus: bool := false;
  var Shot: float := 0.0F;
  var Rotation: float := 0.0F;
  const Token: string := Context.Token('scroll', 'main-editingtools-0');
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas CUI editing tools',
    Width,
    1400,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session<State.Msg> := Host.Start<State.Model, State.Msg>(
    new State.Model(Active := State.Page.EditingTools), Observe, Gallery.Build, Window, 64, Inject,
    ThemeFor := Update.ThemeFor
  );
  for Frame: int := 0 to 9 do
    Draw(Session);
  end for;

  for Position: int in [0, 520, 900] do
    Offset := Position;
    for Frame: int := 0 to 7 do
      Draw(Session);
    end for;

    Session.CapturePng(Root + '-editing-' + Width.ToString() + '-' + Position.ToString() + '.png');
  end for;

  if Width = 1100 then
    Focus := true;
    A.Send(Session, State.Msg.Preview);
    Draw(Session);
    Focus := false;
    Key := cast<int>(Keys.Key.Right);
    Draw(Session);
    Draw(Session);
    A.Check(Shot > 1.53F and Shot < 1.55F, 'The native timeline must step one 24-fps frame.');
    Key := cast<int>(Keys.Key.Right);
    Modifiers := 4;
    Draw(Session);
    Draw(Session);
    A.Check(
      Rotation > 1.78F and Rotation < 1.80F,
      'The edited key must reach the shared track model.'
    );
    A.Check(A.HasText(Session, 'Rotation'), 'The current track has its curve below the timeline.');
  end if;
end procedure;

// Captures the editing tool page and tests timeline proposals at the gallery boundary.
// ## Parameters
// - `Renderer`: Native renderer to exercise.
// - `Capture`: Prefix for screenshot paths.
public procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
begin
  CapturePage(Renderer, Capture, 1100);
  CapturePage(Renderer, Capture, 550);
end procedure;

end unit;
