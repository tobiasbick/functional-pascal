// [Documentation](../../../docs/ui/gui/code/code-editor.md)

unit EditorCommandsContract;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.EditorCommands as Commands;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Gui.Shortcuts as Shortcuts;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Canvas.SelectionBars as Bulk;
uses Fpas.Ui.Widgets.Editors.CodeEditors as Editor;
uses Fpas.Ui.Widgets.Inputs.ShortcutRecorders as Keys;

uses System as Sys;

type Msg = variant
  Observed(Value: Editor.Event);
  Move;
  SelectRange;
  Find;
  HideFind;
  Save;
end variant;

const Source: string := 'a😀é' + #10 + 'second 😀';

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

procedure Validate();
begin
  var Rejected: bool := false;
  try
    discard V.Prepare of bool(
      Editor.CodeEditor of bool(
        'editor', Source, function(Value: Editor.Event): bool => true,
        new Editor.Options(Marks := [new Editor.Mark(2, 3)])
      ), V.Target.Graphical
    );
  catch Error: Sys.ArgumentException do
    Rejected := true;
  end try;

  Check(Rejected, 'Prepared views must reject marks that split a surrogate pair.');
  Rejected := false;
  try
    discard V.Prepare of bool(
      Bulk.SelectionBar of bool(
        'bulk', Bulk.Selection.Count(-1), [],
        function(Value: Bulk.Event): bool => false, E.Text of bool('Anchor')
      ), V.Target.Graphical
    );
  catch Error: Sys.ArgumentException do
    Rejected := true;
  end try;

  Check(Rejected, 'Aggregate selection counts must be nonnegative.');
end procedure;

// Verifies editor commands and mapped global shortcuts through the actual FPAS MVU owner loop.
// ## Parameters
// - `Renderer`: Native renderer used for the real editor view.
public procedure Verify(Renderer: Cui.CuiRenderer);
  function Update(Model: Editor.Event; Message: Msg): Mvu.Transition of (Editor.Event, Msg);
  begin
    case Message of
      when Msg.Observed(const Value: Editor.Event):
        return new Mvu.Transition of (Editor.Event, Msg)(Value, []);
      when Msg.Move:
        return new Mvu.Transition of (Editor.Event, Msg)(
          Model,
          [Commands.GoTo of Msg('editor', 2, 2)]
        );
      when Msg.SelectRange:
        return new Mvu.Transition of (Editor.Event, Msg)(
          Model,
          [Commands.Select of Msg('editor', 1, 4)]
        );
      when Msg.Find:
        return new Mvu.Transition of (Editor.Event, Msg)(
          Model,
          [Commands.Find of Msg('editor', '😀')]
        );
      when Msg.HideFind:
        return new Mvu.Transition of (Editor.Event, Msg)(
          Model,
          [Commands.Find of Msg('editor', null)]
        );
      when Msg.Save:
        Saves := Saves + 1;
        return new Mvu.Transition of (Editor.Event, Msg)(Model, []);
    end case;
  end function;
  function View(Model: Editor.Event; Size: L.Viewport): E.Element of Msg;
  begin
    Last := Model;
    return Editor.CodeEditor of Msg(
      'editor', Source, Msg.Observed,
      new Editor.Options(ReadOnly := true, Marks := [new Editor.Mark(1, 4)])
    );
  end function;
  function Bindings(Model: Editor.Event): array of Shortcuts.Binding of Msg;
  begin
    Selects := Selects + 1;
    const Child: Shortcuts.Binding of int := new Shortcuts.Binding of int(
      new Keys.Combination(Keys.Key.S, Keys.PrimaryModifier()), 1, AllowWhileEditing := true
    );
    return [Child.Map of Msg(function(Value: int): Msg => Msg.Save)];
  end function;
  procedure Inject();
  begin
    if Input then
      Window.SetKey(cast Keys.Key.S as int, true, cast Keys.PrimaryModifier() as int);
      Window.SetKey(cast Keys.Key.S as int, false);
      Input := false;
    end if;
  end procedure;
  procedure Steps(Value: Gui.Session of Msg);
  begin
    for Index: int := 0 to 3 do
      Check(Value.Step(), 'The editor session closed.');
    end for;
  end procedure;
begin
  Validate();
  var Saves: int := 0;
  var Selects: int := 0;
  var Input: bool := false;
  var Last: Editor.Event := new Editor.Event(null, 1, 1, 2, false);
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPAS editor command contract',
    600,
    420,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of Msg := Host.Start of (Editor.Event, Msg)(
    Last, Update, View, Window, 64, Inject,
    BindingsFor := Bindings
  );
  Steps(Session);
  discard Session.Post(Msg.Move);
  Steps(Session);
  Check(
    Last.Line = 2 and Last.Column = 2 and Last.Cursor = 6,
    'MVU GoTo did not reach the native editor.'
  );
  discard Session.Post(Msg.SelectRange);
  Steps(Session);
  Check(Last.Anchor = 1 and Last.Cursor = 4, 'MVU range selection lost UTF-16 coordinates.');
  discard Session.Post(Msg.Find);
  Steps(Session);
  Check(Last.Matches = 2 and Last.Focused, 'MVU Find did not open the native search field.');
  discard Session.Post(Msg.HideFind);
  Steps(Session);
  Check(Last.Matches = 0 and Last.Focused, 'Closing Find must restore editor focus.');
  Input := true;
  Steps(Session);
  Check(Saves = 1, 'A mapped global Save binding must fire once while editing.');
  const Before: int := Selects;
  Steps(Session);
  Check(Selects = Before, 'Repaints must reuse prepared shortcut bindings.');
end procedure;

end unit;
