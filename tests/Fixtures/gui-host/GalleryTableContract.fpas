// [Documentation](../../../docs/ui/gui/data-display/table.md)

unit GalleryTableContract;

uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;

uses GalleryHostAssertions as A;
uses GuiGallery.App.State as State;
uses GuiGallery.App.Update as Update;
uses GuiGallery.App.View as View;

// Checks table sorting and the task list's native drag-to-reorder interaction.
// ## Parameters
// - `Renderer`: Native renderer used for the presented gallery.
public procedure Verify(Renderer: Cui.CuiRenderer);
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Button >= 0 then
      Window.SetLeftButton(Button = 1);
      Button := -1;
    end if;
  end procedure;
  procedure Click(Session: Gui.Session of State.Msg; Id: string);
  begin
    const Target: Cui.CuiRectangle := A.Control(Session, Id).Bounds;
    A.Check(Target.Width > 0.0F and Target.Height > 0.0F, 'Table control is not visible: ' + Id);
    X := Target.X + Target.Width / 2;
    Y := Target.Y + Target.Height / 2;
    Button := 1;
    A.Check(Session.Step(), 'Table gallery closed during press.');
    Button := 0;
    A.Check(Session.Step(), 'Table gallery closed during release.');
    A.Check(Session.Step(), 'Table gallery closed before presenting the update.');
  end procedure;
  procedure CheckSelection(Session: Gui.Session of State.Msg; Selected: string);
  begin
    const Frame: Gui.Frame := Session.Snapshot();
    var Count: int := 0;
    for Row: Gui.Control in Frame.Controls do
      if Row.Role = 'table-row' and Row.Value = 'True' then
        A.Check(Row.Id = Selected, 'Expected selected row ' + Selected + ', got ' + Row.Id + '.');
        Count := Count + 1;
      end if;
    end for;

    A.Check(Count = 1, 'The selected person must remain the only selected row.');
  end procedure;
  procedure CheckReordering(Session: Gui.Session of State.Msg);
  begin
    const Id: string := 'task-order';
    const First: Cui.CuiRectangle := A.Control(Session, Id, '0').Bounds;
    const Last: Cui.CuiRectangle := A.Control(Session, Id, '4').Bounds;
    A.Check(First.Width > 0.0F and Last.Y > First.Y, 'The native task rows must start in order.');

    X := First.X + 16.0F;
    Y := First.Y + First.Height / 2.0F;
    Button := 1;
    A.Check(Session.Step(), 'The task list closed on press.');
    Y := Last.Y + Last.Height / 2.0F + 2.0F;
    A.Check(Session.Step(), 'The task list closed during drag.');
    A.Check(
      A.Control(Session, Id, '0').Bounds.Y > First.Y and A.Control(Session, Id, '0').Value = '0',
      'Dragging must move the native row while retaining its model position.'
    );

    Button := 0;
    A.Check(Session.Step(), 'The task list closed on release.');
    X := -1.0F;
    Y := -1.0F;
    A.Check(Session.Step(), 'The task list closed before applying the new order.');
    for Index: int := 1 to 4 do
      A.Check(
        A.Control(Session, Id, Index.ToString()).Value = (Index - 1).ToString(),
        'The drop must advance each following row by one position.'
      );
    end for;

    A.Check(A.Control(Session, Id, '0').Value = '4', 'The drop must save the first row last.');
    var Notices: int := 0;
    for Control: Gui.Control in Session.Snapshot().Controls do
      if Control.Role = 'toast' and Control.Text = 'Order saved' then
        Notices := Notices + 1;
      end if;
    end for;

    A.Check(Notices = 1, 'The drop must show a single Order saved toast.');
  end procedure;
begin
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Button: int := -1;
  const Window: Cui.CuiWindow := new Cui.CuiWindow('FPas CUI Table', 1240, 1680, Renderer, true);
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of State.Msg := Host.Start of (State.Model, State.Msg)(
    new State.Model(Active := State.Page.Lists), Update.Update, View.Build, Window, 32, Inject,
    ThemeFor := Update.ThemeFor
  );
  A.Check(Session.Step(), 'The Data display gallery did not present.');
  CheckSelection(Session, 'person-1');

  const Aiko: string := 'person-4';
  const Tomas: string := 'person-2';
  const Header: string := Tables.HeaderId('people', 0);
  A.Check(
    A.Control(Session, Aiko).Bounds.Y < A.Control(Session, Tomas).Bounds.Y,
    'The gallery must start in ascending name order.'
  );
  Click(Session, Aiko);
  CheckSelection(Session, Aiko);

  Click(Session, Header);
  A.Check(
    A.Control(Session, Aiko).Bounds.Y > A.Control(Session, Tomas).Bounds.Y,
    'The name header must reverse the rendered row order.'
  );
  CheckSelection(Session, Aiko);

  Click(Session, Header);
  A.Check(
    A.Control(Session, Aiko).Bounds.Y < A.Control(Session, Tomas).Bounds.Y,
    'The next header click must restore ascending order.'
  );
  CheckSelection(Session, Aiko);
  CheckReordering(Session);
end procedure;

end unit;
