program HostContract;

uses
  Fpas.Gui.Application as App, Fpas.Gui.Internal.Session as Host, Fpas.Gui.Cui as Cui,
  Fpas.Mvu.Application as Mvu, Fpas.Mvu.Session as Runtime, Fpas.Ui.Elements as E,
  Fpas.Ui.Layout as L, Fpas.Ui.Graphics as G, System as Sys, System.Console as Console, System.Threading as Threads;

type Msg = union
  Increment;
  Quit;
  Invalid;
  Fail;
  BadView;
  NativeLimit;
end union;

var Updates: int := 0;
var Views: int := 0;
var CacheBuilds: int := 0;
var Rendering: bool := false;

procedure Check(Condition: bool; Reason: string);
begin
  if not Condition then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function Update(Model: int; Message: Msg): Mvu.Transition<int, Msg>;
begin
  Check(not Rendering, 'Update reentered rendering.');
  Updates := Updates + 1;
  case Message of
    when Msg.Increment:
      return new Mvu.Transition<int, Msg>(Model + 1, []);
    when Msg.Quit:
      return new Mvu.Transition<int, Msg>(Model, [Mvu.Exit<Msg>(), Mvu.Focus<Msg>('unreachable')]);
    when Msg.Invalid:
      return new Mvu.Transition<int, Msg>(-1, []);
    when Msg.Fail:
      raise new Sys.InvalidOperationException('Update failure');
    when Msg.BadView:
      return new Mvu.Transition<int, Msg>(-2, []);
    when Msg.NativeLimit:
      return new Mvu.Transition<int, Msg>(-3, []);
  end case;
end function;

function Footer(Dependencies: int): E.Element<Msg>;
begin
  CacheBuilds := CacheBuilds + 1;
  return E.Text<Msg>('Cached footer');
end function;

function View(Model: int; Viewport: L.Viewport): E.Element<Msg>;
begin
  Views := Views + 1;
  if Model = -2 then
    raise new Sys.InvalidOperationException('View failure');
  end if;

  if Model = -3 then
    return E.Canvas<Msg>(
      'limit',
      10,
      10,
      [G.Paint.Line(0, 0, 1, 1, double.Epsilon, new G.Color(0, 0, 0))]
    );
  end if;

  if Model < 0 then
    return E.Column<Msg>(
      E.Button<Msg>('same', 'One', Msg.Increment),
      E.Button<Msg>('same', 'Two', Msg.Increment)
    );
  end if;

  return E.Column<Msg>(
    new L.Flow(Padding := L.Spacing.Loose, Gap := L.Spacing.Normal),
    E.Text<Msg>('Count: ' + Model.ToString()),
    E.Button<Msg>('increment', 'Add ' + Model.ToString(), Msg.Increment),
    E.Button<Msg>('disabled', 'Disabled', Msg.Increment, false),
    E.CachedSubview<int, Msg>(
      'footer',
      0,
      Footer,
      function(Left: int; Right: int): bool => Left = Right
    )
  );
end function;

procedure Resize(Session: App.Session<Msg>; Window: Cui.CuiWindow; Width: int; Height: int);
begin
  Window.Resize(Width, Height);
  for Attempt: int := 0 to 59 do
    Check(Session.Step(), 'Resize closed the session.');
    Rendering := false;
    const Size: Cui.CuiSize := Session.Snapshot().Size;
    if Size.Width = Width and Size.Height = Height then
      return;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Resize was not presented.');
end procedure;

procedure Counter(Renderer: Cui.CuiRenderer; Capture: string);
  procedure Input();
  begin
    Rendering := true;
    if Frame >= 5 and Frame <= 7 then
      Window.MovePointer(Button.X + Button.Width / 2, Button.Y + Button.Height / 2);
      if Frame = 6 then
        Window.SetLeftButton(true);
      end if;

      if Frame = 7 then
        Window.SetLeftButton(false);
      end if;
    end if;

    if Frame >= 12 and Frame <= 14 then
      Window.MovePointer(Disabled.X + Disabled.Width / 2, Disabled.Y + Disabled.Height / 2);
      if Frame = 13 then
        Window.SetLeftButton(true);
      end if;

      if Frame = 14 then
        Window.SetLeftButton(false);
      end if;
    end if;
  end procedure;
begin
  Updates := 0;
  Views := 0;
  CacheBuilds := 0;
  var Frame: int := 0;
  var Button: Cui.CuiRectangle := new Cui.CuiRectangle();
  var Disabled: Cui.CuiRectangle := new Cui.CuiRectangle();
  const Window: Cui.CuiWindow := new Cui.CuiWindow('MVU host', 640, 480, Renderer, true);
  using const Session: App.Session<Msg> := Host.Start<int, Msg>(0, Update, View, Window, 8, Input);
  Check(Session.IsSoftware() = (Renderer = Cui.CuiRenderer.Software), 'Renderer fallback.');
  for Index: int := 0 to 19 do
    Frame := Index;
    Check(Session.Step(), 'Unexpected close.');
    Rendering := false;
    const Snapshot: App.Frame := Session.Snapshot();
    Check(Snapshot.Id = cast<long>(Index + 1), 'Frame sequence.');
    Button := Snapshot.Controls[0].Bounds;
    Disabled := Snapshot.Controls[1].Bounds;
    Check(
      Button.Width > 0 and Button.Height > 0 and Disabled.Y > Button.Y,
      'Finalized first-frame geometry.'
    );
    if Index = 0 then
      Check(Button.X = 16 and Button.Width = 608, 'Column stretch and padding were not applied.');
      Snapshot.Controls[0] := Snapshot.Controls[0] with
        Text := 'Corrupted';
      end with;
      Snapshot.Text[0] := 'Corrupted';
      Check(
        Session.Snapshot().Controls[0].Text = 'Add 0' and Session.Snapshot().Text[0] = 'Count: 0',
        'Snapshot alias.'
      );
    end if;

    if Index = 7 then
      Check(Updates = 0, 'Native click dispatched during drawing.');
    end if;
  end for;

  Check(
    Updates = 1 and Views = 2,
    'Duplicate activation, disabled input or animation reevaluation.'
  );
  Check(Session.Snapshot().Text[0] = 'Count: 1', 'The transition was not presented.');
  Resize(Session, Window, 720, 520);
  Resize(Session, Window, 640, 480);
  Check(
    Views = 4 and CacheBuilds = 1 and Updates = 1,
    'Resize invalidation or cached subtree reuse.'
  );
  const BeforeCaptureId: long := Session.Snapshot().Id;
  var CaptureFailed: bool := false;
  try
    Session.CapturePng(Capture + '/missing.png');
  catch Error: Sys.IO.IOException do
    CaptureFailed := true;
  end try;

  Check(
    CaptureFailed and Session.IsOpen() and Session.Snapshot().Id = BeforeCaptureId,
    'Capture failure changed session state.'
  );
  Session.CapturePng(Capture);
  discard Session.Post(Msg.Quit);
  Check(not Session.Step() and not Session.IsOpen(), 'Exit did not close.');
  case Session.Post(Msg.Increment) of
    when Runtime.Admission.Closed:
    else
      raise new Sys.InvalidOperationException('Late admission.');
  end case;

  Check(not Window.TryWake(), 'Window was not released.');
end procedure;

procedure Failure(Renderer: Cui.CuiRenderer; Message: Msg; Expected: string);
begin
  const Window: Cui.CuiWindow := new Cui.CuiWindow('Failure', 320, 240, Renderer, true);
  using const Session: App.Session<Msg> := Host.Start<int, Msg>(0, Update, View, Window, 8);
  Check(Session.Step(), 'Missing initial frame.');
  const Before: long := Session.Snapshot().Id;
  discard Session.Post(Message);
  var Caught: bool := false;
  try
    discard Session.Step();
  catch Error: Sys.Exception when Error.Message.Contains(Expected) do
    Caught := true;
  end try;

  Check(
    Caught and not Session.IsOpen() and not Window.TryWake(),
    'Failure did not release the session.'
  );
  Check(Session.Snapshot().Id = Before, 'A failed view was published.');
end procedure;

procedure PublicSession(Renderer: Cui.CuiRenderer);
begin
  using const Session: App.Session<Msg> := App.Start<int, Msg>(
    0, Update, View,
    new App.Options(Title := 'Public GUI session', Renderer := Renderer, Capacity := 1)
  );
  case Session.Post(Msg.Increment) of
    when Runtime.Admission.Queued:
    else
      raise new Sys.InvalidOperationException('Missing admission.');
  end case;

  case Session.Post(Msg.Increment) of
    when Runtime.Admission.Full:
    else
      raise new Sys.InvalidOperationException('Mailbox capacity.');
  end case;

  Check(Session.Step() and Session.Snapshot().Text[0] = 'Count: 1', 'Public owner loop.');
  discard Session.Post(Msg.Quit);
  Check(not Session.Step(), 'Public shutdown.');
end procedure;

procedure Ownership(Renderer: Cui.CuiRenderer);
begin
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Owner and native close',
    320,
    240,
    Renderer,
    true
  );
  using const Session: App.Session<Msg> := Host.Start<int, Msg>(0, Update, View, Window, 8);
  Check(Session.Step(), 'Initial ownership frame.');
  var Failure: Sys.Exception? := null;
  const Work: Threads.ThreadStart := procedure() begin
    try
      var Rejected: int := 0;
      try
        discard Session.Step();
      catch Error: Sys.InvalidOperationException do
        Rejected := Rejected + 1;
      end try;

      try
        Session.Dispose();
      catch Error: Sys.InvalidOperationException do
        Rejected := Rejected + 1;
      end try;

      try
        discard Session.Snapshot();
      catch Error: Sys.InvalidOperationException do
        Rejected := Rejected + 1;
      end try;

      try
        Session.CapturePng('wrong-owner.png');
      catch Error: Sys.InvalidOperationException do
        Rejected := Rejected + 1;
      end try;

      Check(Rejected = 4, 'Owner checks.');
      case Session.Post(Msg.Increment) of
        when Runtime.Admission.Queued:
        else
          raise new Sys.InvalidOperationException('Worker post.');
      end case;
    catch Error: Sys.Exception do
      Failure := Error;
    end try;
  end procedure;
  const Worker: Threads.Thread := new Threads.Thread(Work);
  Worker.Start();
  Check(Worker.Join(5000), 'Worker did not finish.');
  Check(Failure = null, 'Worker ownership/post failed.');
  Check(
    Session.Step() and Session.Snapshot().Text[0] = 'Count: 1',
    'Worker message was not presented.'
  );
  Window.RequestClose();
  Check(
    not Session.Step() and not Session.IsOpen() and not Window.TryWake(),
    'Native close did not release the session.'
  );
end procedure;

procedure Reentrancy(Renderer: Cui.CuiRenderer; DisposeDuringFrame: bool);
  procedure Input();
  begin
    case Owned of
      when is App.Session<Msg> as Current:
        if DisposeDuringFrame then
          Current.Dispose();
        else
          discard Current.Step();
        end if;
      else
        raise new Sys.InvalidOperationException('Missing session.');
    end case;
  end procedure;
begin
  var Owned: App.Session<Msg>? := null;
  const Window: Cui.CuiWindow := new Cui.CuiWindow('Reentrancy', 320, 240, Renderer, true);
  Owned := Host.Start<int, Msg>(0, Update, View, Window, 8, Input);
  case Owned of
    when is App.Session<Msg> as Current:
      using const Session: App.Session<Msg> := Current;
      var Rejected: bool := false;
      try
        discard Session.Step();
      catch Error: Sys.InvalidOperationException do
        Rejected := true;
      end try;

      Check(
        Rejected and not Session.IsOpen() and not Window.TryWake(),
        'Reentrant callback was not stopped.'
      );
    else
      raise new Sys.InvalidOperationException('Missing owned session.');
  end case;
end procedure;

procedure Run(Arguments: array of string);
requires Arguments.Length = 3;
requires Arguments[1] = 'software' or Arguments[1] = 'opengl';
begin
  const Renderer: Cui.CuiRenderer := if Arguments[
      1
    ] = 'software' then Cui.CuiRenderer.Software
    else Cui.CuiRenderer.OpenGl
    end if;
  Counter(Renderer, Arguments[2]);
  Failure(Renderer, Msg.Invalid, 'Duplicate ID');
  Failure(Renderer, Msg.Fail, 'Update failure');
  Failure(Renderer, Msg.BadView, 'View failure');
  Failure(Renderer, Msg.NativeLimit, 'native float range');
  PublicSession(Renderer);
  Ownership(Renderer);
  Reentrancy(Renderer, false);
  Reentrancy(Renderer, true);
  Console.WriteLine('GUI host verified: ' + Arguments[1]);
end procedure;

begin
  Run(Sys.Environment.GetCommandLineArgs());
end;
end program;
