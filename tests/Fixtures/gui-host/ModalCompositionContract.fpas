// [Documentation](../../../docs/ui/gui/overlays/dialog.md)

unit GalleryModalCompositionContract;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as App;
uses Fpas.Ui.Widgets.Actions.Buttons as Buttons;
uses Fpas.Ui.Widgets.Canvas.CanvasControls as Rails;
uses Fpas.Ui.Widgets.Canvas.LiveCursors as Cursors;
uses Fpas.Ui.Widgets.Canvas.SelectionBars as Bars;
uses Fpas.Ui.Widgets.Canvas.SelectionRings as Rings;
uses Fpas.Ui.Widgets.Collections.ReorderableLists as Reorders;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Collections.Trees as Trees;
uses Fpas.Ui.Widgets.Editors.NodeEditors as Nodes;
uses Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs;
uses Fpas.Ui.Widgets.Overlays.Veils as Veils;
uses Fpas.Ui.Widgets.Planning.Kanbans as Kanbans;

uses System as Sys;

procedure Check(Condition: bool; Reason: string);
begin
  if not Condition then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function Find(Session: Gui.Session<bool>; Id: string): Gui.Control?;
begin
  for Control: Gui.Control in Session.Snapshot().Controls do
    if Control.Id = Id then
      return Control;
    end if;
  end for;

  return null;
end function;

function Control(Session: Gui.Session<bool>; Id: string): Gui.Control;
begin
  const Found: Gui.Control? := Find(Session, Id);
  if Found = null then
    raise new Sys.InvalidOperationException('Missing composed modal control ' + Id);
  end if;

  return Found;
end function;

procedure VerifyContainer(Renderer: Cui.CuiRenderer; Kind: int);
  procedure Assert(Condition: bool; Reason: string);
  begin
    Check(Condition, 'Container kind ' + Kind.ToString() + ': ' + Reason);
  end procedure;

  function View(Open: bool; Viewport: L.Viewport): E.Element<bool>;
  begin
    const Dialog: E.Element<bool> := Dialogs.Dialog<bool>(
      'modal', E.Text<bool>('Dialog anchor'),
      Buttons.Button<bool>('inside', 'Finish', false), Open,
      new Dialogs.Options('Composed dialog'), false
    );
    const Wrapped: E.Element<bool> := case Kind of
      when 0: Rings.SelectionRing<bool>('ring', Dialog);
      when 1: Cursors.LiveCursors<bool>('cursors', [], Dialog);
      when 2: Rails.CanvasControls<bool>(
        'rail', new Nodes.View(), [], function(Event: Rails.Event): bool => true, Dialog
      );
      when 3: Bars.SelectionBar<bool>(
        'selection', Bars.Selection.Items([]), [], function(Event: Bars.Event): bool => true, Dialog
      );
      when 4: Tables.Table<bool>(
        'table', [new Tables.Column('Column')],
        [new Tables.Row<bool>('row', [Tables.Cell<bool>.Content([Dialog])])]
      );
      when 5: Reorders.ReorderableList<bool>(
        'order',
        [Dialog],
        [0],
        function(Order: array of int): bool => true
      );
      when 6..7: Trees.Branch<bool>(
        'branch', 'Branch', Kind = 6, [Dialog], function(Expanded: bool): bool => true
      );
      when 8..10: Veils.Veil<bool>(
        'veil', Kind <> 9, function(Revealed: bool): bool => true, Dialog,
        new Veils.Options(Enabled := Kind <> 10)
      );
      when 11..12: Kanbans.Kanban<bool>(
        'board', [new Kanbans.Column<bool>('Column', [new Kanbans.Card<bool>(0, 'Card', Dialog)])],
        function(Event: Kanbans.Event): bool => true, new Kanbans.Options(Enabled := Kind = 11)
      );
      else Nodes.NodeEditor<bool>(
        'nodes',
        new Nodes.View(),
        [new Nodes.Node<bool>(0, 0.0F, 0.0F, 'Node', [], Body := Dialog)],
        [],
        function(Event: Nodes.Event): bool => true,
        new Nodes.Options(Enabled := Kind = 13)
      );
    end case;
    return E.Column<bool>(
      new L.Flow(), Buttons.Button<bool>('background', 'Background', true), Wrapped
    );
  end function;

  procedure Inject();
  begin
    if Escape then
      Window.SetKey(3, true);
      Window.SetKey(3, false);
      Escape := false;
    end if;
  end procedure;
begin
  var Escape: bool := false;
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Composed modal contract', 700, 500, Renderer, true
  );
  using const Session: Gui.Session<bool> := Host.Start<bool, bool>(
    true,
    function(Model: bool; Message: bool): App.Transition<bool, bool> => new App.Transition<bool, bool>(
      Message,
      []
    ),
    View, Window, 16, Inject
  );
  Assert(Session.Step(), 'The composed modal session closed unexpectedly.');
  if Kind = 7 or Kind = 9 or Kind = 10 or Kind = 12 or Kind = 14 then
    Assert(
      Find(Session, 'inside') = null,
      'A hidden or disabled container must not present its modal body.'
    );
    Assert(
      Control(Session, 'background').Enabled,
      'A hidden modal must not disable the background.'
    );
    return;
  end if;

  Assert(Control(Session, 'inside').Enabled, 'A composed modal must accept input.');
  Assert(Control(Session, 'modal/close').Enabled, 'A composed modal must allow dismissal.');
  Assert(Control(Session, 'modal/close').Focused, 'A composed modal must receive initial focus.');
  Assert(
    not Control(Session, 'background').Enabled,
    'A composed modal must disable the background.'
  );

  Escape := true;
  discard Window.TryWake();
  Assert(Session.Step(), 'The composed modal did not process Escape.');
  discard Window.TryWake();
  Assert(Session.Step(), 'The composed modal did not apply dismissal.');
  Assert(Control(Session, 'background').Enabled, 'Dismissal must restore background input.');
end procedure;

// Exercises modal input ownership through graphical composition containers.
// ## Parameters
// - `Renderer`: Native renderer used for every composed view.
public procedure Verify(Renderer: Cui.CuiRenderer);
begin
  for Kind: int := 0 to 14 do
    VerifyContainer(Renderer, Kind);
  end for;
end procedure;

end unit;
