program PortableContract;

uses
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Choices as C, Fpas.Ui.Themes as Themes, Fpas.Ui.Graphics as G,
  Fpas.Ui.Editors as Ed, Fpas.Ui.Navigation as N, Fpas.Ui.TerminalExtensions.Input as Keys,
  Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Tui.Application as Tui,
  Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Gui.Internal.Session as Host, Fpas.Ui.Gui.Cui as Cui,
  System as Sys, System.Collections.Generic as Generic, System.Console as Console,
  System.Threading as Threads, System.Threading.Tasks as Tasks;

type Model = record
  public Checked: bool := false;
  public Selected: string := 'first';
  public Tab: string := 'one';
  public Page: string? := null;
  public Text: string := 'abc';
  public Position: Ed.EditorPosition := new Ed.EditorPosition(3, 3);
  public Modal: bool := false;
  public Completed: bool := false;
end record;

type Msg = variant
  Toggle(Value: bool);
  Select(Key: string);
  Tab(Key: string);
  Page(Key: string);
  Edit(Value: Ed.TextEdit);
  Navigate(Value: Ed.EditorPosition);
  Modal(Value: bool);
  Focus(Id: string);
  Done;
  Failed(Reason: string);
end variant;

const Trace: Generic.List<string> := new Generic.List<string>();

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

async function Work(Post: function(Msg): Tasks.Task; Cancellation: Threads.CancellationToken): Tasks.Task;
begin
  Cancellation.ThrowIfCancellationRequested();
  await Post(Msg.Done).ConfigureAwait(false);
end function;

function Update(State: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  var Next: Model := State;
  var Commands: array of Mvu.Command<Msg> := [];
  case Message of
    when Msg.Toggle(const Value: bool):
      Commands := [
        Mvu.Focus<Msg>('list'),
        Mvu.StartBackground<Msg>(
          'work',
          Work,
          function(Error: Sys.Exception): Msg => Msg.Failed(Error.Message)
        )
      ];
      Trace.Add('toggle:' + Value.ToString());
      Next := State with
        Checked := Value;
      end with;
    when Msg.Select(const Key: string):
      Trace.Add('select:' + Key);
      Next := State with
        Selected := Key;
      end with;
    when Msg.Tab(const Key: string):
      Trace.Add('tab:' + Key);
      Next := State with
        Tab := Key;
      end with;
    when Msg.Page(const Key: string):
      Trace.Add('page:' + Key);
      Next := State with
        Page := Key;
      end with;
    when Msg.Edit(const Value: Ed.TextEdit):
      Trace.Add('edit:' + Value.Text);
      Next := State with
        Text := Value.Text;
        Position := Value.Position;
      end with;
    when Msg.Navigate(const Value: Ed.EditorPosition):
      Trace.Add('navigate');
      Next := State with
        Position := Value;
      end with;
    when Msg.Modal(const Value: bool):
      Trace.Add('modal:' + Value.ToString());
      Next := State with
        Modal := Value;
      end with;
    when Msg.Done:
      Trace.Add('effect:done');
      Next := State with
        Completed := true;
      end with;
    when Msg.Failed(const Reason: string):
      raise new Sys.InvalidOperationException(Reason);
    when Msg.Focus(const Id: string):
      Commands := [Mvu.Focus<Msg>(Id)];
  end case;

  return new Mvu.Transition<Model, Msg>(Next, Commands);
end function;

function View(State: Model; Viewport: L.Viewport): E.Element<Msg>;
begin
  const Base: E.Element<Msg> := E.Column<Msg>(
    new L.Flow(Gap := L.Spacing.Normal), [
      E.Checkbox<Msg>(
        'toggle',
        'Toggle',
        State.Checked,
        function(Value: bool): Msg => Msg.Toggle(Value)
      ),
      E.TextInput<Msg>(
        'text',
        State.Text,
        State.Position,
        function(Edit: Ed.TextEdit): Msg => Msg.Edit(Edit),
        function(Position: Ed.EditorPosition): Msg => Msg.Navigate(Position)
      ),
      E.SelectionList<Msg>(
        'list',
        [
          new C.SelectionItem('first', 'First'),
          new C.SelectionItem('off', 'Off', false),
          new C.SelectionItem('last', 'Last', CanActivate := false)
        ],
        State.Selected,
        function(Key: string): Msg => Msg.Select(Key)
      ),
      E.Tabs<Msg>(
        'tabs',
        [new C.TabItem('one', 'One'), new C.TabItem('two', 'Two')],
        State.Tab,
        function(Key: string): Msg => Msg.Tab(Key),
        function(Key: string): E.Element<Msg> => E.Text<Msg>('Panel: ' + Key)
      ),
      E.Button<Msg>('open', 'Open', Msg.Modal(true)),
      N.Sidebar<Msg>(
        'pages', [
          new N.Section<Msg>(
            'First section',
            [new N.Item<Msg>('first', 'Same ## caption', Msg.Page('first'))]
          ),
          new N.Section<Msg>(
            'Second section', [
              new N.Item<Msg>('off', 'Unavailable', Msg.Page('off'), Enabled := false),
              new N.Item<Msg>('last', 'Same ## caption', Msg.Page('last'), Badge := '2')
            ]
          )
        ], State.Page
      ),
      E.Text<Msg>(if State.Completed then 'Work complete' else 'Work pending' end if)
    ]
  );
  return if State.Modal then E.Overlay<Msg>(
      'modal',
      Base,
      E.Button<Msg>('close', 'Close', Msg.Modal(false)),
      'close',
      function(): Msg => Msg.Modal(false)
    )
    else Base
    end if;
end function;

procedure Turn(Session: Tui.HeadlessSession; Input: Tui.Input);
begin
  discard Session.Send(Input);
  discard Session.Step();
end procedure;

function TerminalTrace(): string;
begin
  Trace.Clear();
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<Model, Msg>(
    new Model(),
    Update,
    View,
    80,
    30
  );
  Turn(Session, Tui.Input.Activate('toggle'));
  Check(Session.Snapshot().Controls[2].Focused, 'Terminal focus effect.');
  using const Deadline: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(
    5000
  );
  Check(
    Session.WaitForWork(Deadline.Token).GetAwaiter().GetResult(),
    'Terminal effect did not post.'
  );
  discard Session.Step();
  Check(Trace.Contains('effect:done'), 'Terminal shared worker result.');
  Turn(Session, Tui.Input.Focus('list'));
  Turn(Session, Tui.Input.KeyPress(Keys.Key.Down, Keys.KeyModifiers.None));
  Check(Session.Snapshot().Controls[2].Value = 'last', 'Terminal selection.');
  Turn(Session, Tui.Input.Focus('tabs'));
  Turn(Session, Tui.Input.KeyPress(Keys.Key.Right, Keys.KeyModifiers.None));
  Turn(Session, Tui.Input.Focus('text'));
  Turn(Session, Tui.Input.Paste('z'));
  Turn(Session, Tui.Input.Focus('open'));
  Turn(Session, Tui.Input.Activate('open'));
  var Focused: string := '';
  for Control: Tui.ControlSnapshot in Session.Snapshot().Controls do
    if Control.Focused then
      Focused := Control.Id;
    end if;
  end for;

  Check(Focused = 'close', 'Terminal modal focus.');
  Turn(Session, Tui.Input.KeyPress(Keys.Key.Escape, Keys.KeyModifiers.None));
  Check(Session.Snapshot().Controls[4].Focused, 'Terminal modal focus restoration.');
  Turn(Session, Tui.Input.Focus(N.ItemId('pages', 'first')));
  Turn(Session, Tui.Input.KeyPress(Keys.Key.Tab, Keys.KeyModifiers.None));
  Check(not Trace.Contains('page:last'), 'Terminal focus changed the active page.');
  Turn(Session, Tui.Input.Character(' '));
  var Selected: bool := false;
  for Control: Tui.ControlSnapshot in Session.Snapshot().Controls do
    if Control.Id = 'pages/last' then
      Selected := Control.Value = 'true' and Control.Focused and Control.Label.Contains('[2]');
    end if;
  end for;

  Check(Selected, 'Terminal navigation destination.');
  return Sys.String.Join('|', Trace);
end function;

function GraphicalTrace(): string;
  procedure Advance(Session: Gui.Session<Msg>);
  begin
    Check(Session.Step(), 'Unexpected GUI close.');
  end procedure;
  function Control(Session: Gui.Session<Msg>; Id: string; Key: string := ''): Gui.Control;
  begin
    for Entry: Gui.Control in Session.Snapshot().Controls do
      if Entry.Id = Id and Entry.Key = Key then
        return Entry;
      end if;
    end for;

    raise new Sys.InvalidOperationException('Missing graphical control: ' + Id + '/' + Key);
  end function;
  procedure Inject();
  begin
    if Action = 1 or Action = 2 then
      Window.MovePointer(Target.X + Target.Width / 2, Target.Y + Target.Height / 2);
      Window.SetLeftButton(Action = 1);
    elsif Action = 3 then
      Window.SetKey(Key, true);
      Window.SetKey(Key, false);
    elsif Action = 4 then
      Window.TypeText('z');
    end if;
  end procedure;
  procedure Click(Session: Gui.Session<Msg>; Id: string);
  begin
    Target := Control(Session, Id).Bounds;
    Action := 1;
    Advance(Session);
    Action := 2;
    Advance(Session);
    Action := 0;
    Advance(Session);
  end procedure;
begin
  Trace.Clear();
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Portable widgets',
    800,
    700,
    Cui.CuiRenderer.Software,
    true
  );
  Window.SetReducedMotion(true);
  var Action: int := 0;
  var Key: int := 0;
  var Target: Cui.CuiRectangle := new Cui.CuiRectangle();
  using const Session: Gui.Session<Msg> := Host.Start<Model, Msg>(
    new Model(),
    Update,
    View,
    Window,
    64,
    Inject
  );
  Advance(Session);
  Click(Session, 'toggle');
  for I: int := 1 to 8 do
    if Trace.Contains('effect:done') then
      break;
    end if;

    Advance(Session);
  end for;

  Check(
    Trace.Contains('effect:done') and Control(Session, 'list', 'first').Focused,
    'Graphical shared worker or focus effect.'
  );
  discard Session.Post(Msg.Focus('list'));
  Advance(Session);
  Key := 10;
  Action := 3;
  Advance(Session);
  Action := 0;
  Advance(Session);
  Check(Control(Session, 'list', 'last').Value = 'True', 'Graphical disabled-item skip.');
  discard Session.Post(Msg.Focus('tabs'));
  Advance(Session);
  Key := 8;
  Action := 3;
  Advance(Session);
  Action := 0;
  Advance(Session);
  Check(Control(Session, 'tabs', 'two').Value = 'True', 'Graphical tab navigation.');
  discard Session.Post(Msg.Focus('text'));
  Advance(Session);
  Action := 4;
  Advance(Session);
  Action := 0;
  Advance(Session);
  Check(Control(Session, 'text').Value = 'abcz', 'Graphical controlled editor.');
  Click(Session, 'open');
  Check(
    Control(Session, 'close').Focused and not Control(Session, 'open').Enabled,
    'Graphical modal focus.'
  );
  Key := 3;
  Action := 3;
  Advance(Session);
  Action := 0;
  Advance(Session);
  Advance(Session);
  Check(Control(Session, 'open').Focused, 'Graphical modal focus restoration.');
  discard Session.Post(Msg.Focus(N.ItemId('pages', 'last')));
  Advance(Session);
  Check(
    Control(Session, 'pages', 'last').Focused and Control(Session, 'pages', 'last').Value = 'False'
    and not Control(Session, 'pages', 'off').Enabled, 'Graphical navigation focus and selection.'
  );
  Key := 6;
  Action := 3;
  Advance(Session);
  Action := 0;
  Advance(Session);
  Check(Control(Session, 'pages', 'last').Value = 'True', 'Graphical navigation activation.');
  return Sys.String.Join('|', Trace);
end function;

procedure CheckThemesAndAllocation();
  function PaletteFor(State: int): Themes.Theme;
  begin
    const Accent: Themes.Accent := cast<Themes.Accent>(State mod 8);
    if State = 17 then
      const Base: Themes.Theme := Themes.Dark(Accent);
      return Base with
        Colors := Base.Colors with
          Background := new G.Color($10, $20, $30);
          Foreground := new G.Color($D0, $E0, $F0);
          Accent := new G.Color($80, $30, $A0);
        end with;
      end with;
    end if;

    return if State < 8 then Themes.Light(Accent) else Themes.Dark(Accent) end if;
  end function;
  function Advance(State: int; Message: int): Mvu.Transition<int, int>;
  begin
    return new Mvu.Transition<int, int>(Message, []);
  end function;
  function SharedView(State: int; Viewport: L.Viewport): E.Element<int>;
  begin
    return E.Row<int>(
      E.Size<int>(
        E.Button<int>('a', 'A', State + 1),
        if State < 16 then new L.Flex(Grow := 1)
          else new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(80)))
          end if
      ),
      E.Size<int>(E.Button<int>('b', 'B', State + 1), new L.Flex(Grow := 3))
    );
  end function;
begin
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Shared layout and themes',
    400,
    240,
    Cui.CuiRenderer.Software,
    true
  );
  using const Graphical: Gui.Session<int> := Host.Start<int, int>(
    0, Advance, SharedView, Window, 64, ThemeFor := PaletteFor
  );
  using const Terminal: Tui.HeadlessSession := Tui.StartHeadless<int, int>(
    0, Advance, SharedView, 40, 24, PaletteFor
  );
  Check(new Themes.Theme() = Themes.Light(), 'Default theme differs from CUI neutral light.');
  Check(
    Themes.Rgb(new G.Color(255, 0, 0, 128), new G.Color(255, 255, 255)) = $FF7F7F,
    'Palette alpha composition differs.'
  );
  for Index: int := 0 to 17 do
    if Index > 0 then
      discard Graphical.Post(Index);
      discard Terminal.Send(Tui.Input.Activate('a'));
      discard Terminal.Step();
    end if;

    Check(Graphical.Step(), 'Shared view closed.');
    const Theme: Themes.Theme := PaletteFor(Index);
    const Expected: array of uint := Themes.Rgba(Theme);
    const Actual: array of uint := Window.ReadTheme();
    for Token: int := 0 to Expected.Length - 1 do
      Check(Expected[Token] = Actual[Token], 'Native CUI palette differs from the shared theme.');
    end for;

    Check(Graphical.Snapshot().Theme = Theme, 'GUI snapshot lost its shared theme.');
    Check(
      Terminal.Snapshot().Cells[0].Colors.Background = Themes.Rgb(
        Theme.Colors.Background,
        Theme.Colors.Background
      ),
      'Terminal background differs from the shared theme.'
    );
    for Control: Gui.Control in Graphical.Snapshot().Controls do
      const Width: int := if Index < 16 then (if Control.Id = 'a' then 100 else 300 end if)
        else (if Control.Id = 'a' then 80 else 320 end if)
        end if;
      Check(Control.Bounds.Width = Width, 'Native shared sizing differs.');
    end for;

    for Control: Tui.ControlSnapshot in Terminal.Snapshot().Controls do
      Check(
        Control.Width = (if Control.Id = 'a' then 10 else 30 end if),
        'Terminal weighted growth differs.'
      );
    end for;
  end for;

  const InvalidWindow: Cui.CuiWindow := new Cui.CuiWindow(
    'Invalid theme',
    100,
    100,
    Cui.CuiRenderer.Software,
    true
  );
  var Rejected: bool := false;
  try
    using const Invalid: Gui.Session<int> := Host.Start<int, int>(
      0, Advance, SharedView, InvalidWindow, 64,
      Theme := new Themes.Theme(Colors := new Themes.Palette(Background := new G.Color(0, 0, 0, 0)))
    );
  catch Error: Sys.Exception do
    Rejected := true;
  end try;
  var Released: bool := false;
  try
    discard InvalidWindow.IsSoftware;
  catch Error: Sys.ObjectDisposedException do
    Released := true;
  finally
    InvalidWindow.Dispose();
  end try;

  Check(Rejected and Released, 'Rejected initial themes must release the owned native window.');
end procedure;

begin
  CheckThemesAndAllocation();
  const Terminal: string := TerminalTrace();
  const Graphical: string := GraphicalTrace();
  Check(Terminal = Graphical, 'Portable message mismatch: ' + Terminal + ' / ' + Graphical);
  Check(
    Terminal =
    'toggle:True|effect:done|select:last|tab:two|edit:abcz|modal:True|modal:False|page:last',
    'Unexpected shared transitions: ' + Terminal
  );
  Console.WriteLine('portable TUI and GUI contracts verified');
end;
end program;
