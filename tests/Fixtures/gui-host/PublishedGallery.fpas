program PublishedGallery;

uses
  GalleryFeedbackContract as FeedbackContract,
  GuiGallery.App.Update as GalleryUpdate,
  GuiGallery.Shared.State as SliceShared,
  GuiGallery.Pages.Buttons.State as SliceButtons,
  GuiGallery.Pages.Overlays.State as SliceOverlays,
  GalleryDisclosureContract as DisclosureContract,
  GalleryContextContract as ContextContract,
  GalleryActionsContract as ActionsContract,
  GalleryHostAssertions as A,
  GalleryActionWidgetsContract as ActionWidgetsContract,
  GalleryDropdownContract as DropdownContract,
  GallerySegmentedContract as SegmentedContract,
  GalleryToggleGroupContract as ToggleGroupContract,
  GallerySelectionContract as SelectionContract,
  GalleryNavigationContract as NavigationContract,
  GalleryToastContract as ToastContract,
  GalleryTooltipContract as TooltipContract,
  GalleryPopoverContract as PopoverContract,
  GalleryTextFieldContract as TextFieldContract,
  GalleryTextAreaContract as TextAreaContract,
  GalleryCredentialFieldsContract as CredentialFieldsContract,
  GalleryPickerFieldsContract as PickerFieldsContract,
  GalleryDialogContract as DialogContract,
  GuiGallery.App.State as State,
  GuiGallery.App.View as View,
  Fpas.Ui.Gui.Application as Gui,
  Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.ThemeSwitchers as Switchers,
  Fpas.Ui.Themes as Themes,
  System as Sys,
  System.Console as Console,
  System.Text as Text,
  Fpas.Ui.Gui.Internal.Session as Host,
  Fpas.Ui.Mvu.Application as App;

function Open(Renderer: Cui.CuiRenderer; Title: string; Width: int := 1000; Height: int := 760): Gui.Session<State.Msg>;
begin
  return Gui.Start<State.Model, State.Msg>(
    new State.Model(), GalleryUpdate.Update, View.Build,
    new Gui.Options(Title := Title, Width := Width, Height := Height, Renderer := Renderer),
    GalleryUpdate.ThemeFor
  );
end function;

procedure VerifyDesktop(Renderer: Cui.CuiRenderer; Capture: string);
begin
  using const Session: Gui.Session<State.Msg> := Open(Renderer, 'FPAS gallery contract');
  A.Check(Session.Step(), 'Gallery did not present.');
  A.Check(Session.IsSoftware() = (Renderer = Cui.CuiRenderer.Software), 'Unexpected renderer.');
  A.Check(A.HasText(Session, 'Components for C'), 'Overview is the initial page.');
  A.Check(A.HasText(Session, 'FPas CUI'), 'The gallery brand is missing.');
  var Pages: int := 0;
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Id = 'navigation' then
      Pages := Pages + 1;
    end if;
  end for;

  A.Check(Pages = 11, 'Only the confirmed gallery destinations should be visible.');
  const Overview: Gui.Control := A.Control(Session, 'navigation', 'overview');
  const Buttons: Gui.Control := A.Control(Session, 'navigation', 'buttons');
  A.Check(
    Overview.Bounds.X = 12 and Overview.Bounds.Y >= 98 and Overview.Bounds.Y < 110,
    'The sidebar starts below the gallery brand.'
  );
  A.Check(Buttons.Bounds.Y > Overview.Bounds.Y, 'Gallery navigation is in page order.');
  A.Check(Buttons.Bounds.Width = 216, 'Gallery navigation uses the desktop sidebar width.');

  A.Send(Session, State.Msg.Show(State.Page.Buttons));
  A.Check(
    A.HasText(Session, 'Variants') and A.HasText(Session, 'Sizes and icons'),
    'Button sections are missing.'
  );
  A.Check(
    A.HasText(Session, 'States') and A.HasText(Session, 'Groups, copy and hold to confirm'),
    'Confirmed button examples are missing.'
  );
  A.Check(not A.Control(Session, 'disabled').Enabled, 'Disabled example accepts input.');
  A.Check(
    A.Control(Session, 'icon-share').Enabled and A.Control(Session, 'copy-install').Enabled,
    'Icon actions are missing.'
  );
  A.Check(A.Control(Session, 'hold-delete').Enabled, 'The hold button is missing.');
  A.Send(Session, State.Msg.Buttons(SliceButtons.Msg.SetButtonLoading(true)));
  A.Check(A.Control(Session, 'save').Value = 'loading', 'The busy button did not update.');
  A.Send(Session, State.Msg.Buttons(SliceButtons.Msg.SetButtonLoading(false)));
  A.Send(Session, State.Msg.Buttons(SliceButtons.Msg.ToggleFormat(SliceButtons.TextFormat.Bold)));
  A.Send(Session, State.Msg.Buttons(SliceButtons.Msg.ToggleFormat(SliceButtons.TextFormat.Italic)));
  A.Check(
    A.Control(
      Session,
      'format-bold'
    ).Value = 'true' and A.Control(Session, 'format-italic').Value = 'true',
    'The group keeps independent selections.'
  );
  Session.CapturePng(Capture);

  A.Send(Session, State.Msg.Shared(SliceShared.Msg.SetAppearance(Switchers.Selection.Dark)));
  A.Check(Session.Snapshot().Theme.Appearance = Themes.Mode.Dark, 'Theme did not change.');
  A.Send(Session, State.Msg.Show(State.Page.Overlays));
  A.Send(Session, State.Msg.Overlays(SliceOverlays.Msg.SetSheet(true)));
  A.Check(A.Control(Session, 'sheet/close').Focused, 'The sheet close action owns focus.');
  A.Check(not A.Control(Session, 'sheet-open').Enabled, 'The sheet did not disable the page.');
  A.Send(Session, State.Msg.Overlays(SliceOverlays.Msg.SetSheet(false)));
  A.Send(Session, State.Msg.Show(State.Page.Buttons));
  A.Check(
    A.Control(Session, 'format-bold').Value = 'true',
    'Navigation discarded the button group state.'
  );
  A.Send(Session, State.Msg.Show(State.Page.Actions));
  A.Check(A.HasText(Session, 'Split button'), 'The actions page is missing.');
  A.Check(
    A.Control(Session, 'split-save').Enabled and A.Control(Session, 'split-save/menu').Enabled,
    'Both halves of the split button must be interactive.'
  );
end procedure;

procedure VerifyDrawer(Renderer: Cui.CuiRenderer);
begin
  using const Compact: Gui.Session<State.Msg> := Open(Renderer, 'FPAS compact gallery', 740, 680);
  A.Check(Compact.Step(), 'Compact gallery did not present.');
  A.Check(A.Control(Compact, 'drawer-open').Enabled, 'The narrow gallery needs a drawer.');
  A.Send(Compact, State.Msg.SetDrawer(true));
  A.Check(A.Control(Compact, 'drawer/close').Focused, 'The drawer close action owns focus.');
  A.Check(not A.Control(Compact, 'drawer-open').Enabled, 'The drawer did not disable the page.');
  A.Send(Compact, State.Msg.Show(State.Page.Overlays));
  A.Check(A.HasText(Compact, 'Overlays'), 'The drawer did not select the destination.');
end procedure;

procedure VerifySnapshotReentry(Renderer: Cui.CuiRenderer);
  function Update(Model: State.Model; Message: State.Msg): App.Transition<State.Model, State.Msg>;
  begin
    case Current of
      when is Gui.Session<State.Msg> as Session:
        try
          discard Session.Snapshot();
        catch Error: Sys.InvalidOperationException do
          Rejected := true;
        end try;
      else
    end case;

    return GalleryUpdate.Update(Model, Message);
  end function;
begin
  var Current: Gui.Session<State.Msg>? := null;
  var Rejected: bool := false;
  using const Session: Gui.Session<State.Msg> := Gui.Start<State.Model, State.Msg>(
    new State.Model(), Update, View.Build,
    new Gui.Options(Title := 'FPAS snapshot reentry', Renderer := Renderer), GalleryUpdate.ThemeFor
  );
  Current := Session;
  A.Check(Session.Step(), 'The initial frame was not presented.');
  discard Session.Snapshot();
  A.Send(Session, State.Msg.Preview);
  A.Check(Rejected, 'Snapshot must reject reentry from an update callback.');
end procedure;

procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
begin
  VerifyDesktop(Renderer, Capture);
  VerifyDrawer(Renderer);
  ActionsContract.Verify(Renderer, Capture);
  ActionWidgetsContract.Verify(Renderer, Capture);
  VerifySnapshotReentry(Renderer);
  SegmentedContract.Verify(Renderer, Capture);
  ToggleGroupContract.Verify(Renderer, Capture);
  SelectionContract.Verify(Renderer, Capture);
  NavigationContract.Verify(Renderer, Capture);
  ToastContract.Verify(Renderer, Capture);
  TooltipContract.Verify(Renderer, Capture);
  PopoverContract.Verify(Renderer, Capture);
  TextFieldContract.Verify(Renderer, Capture);
  TextAreaContract.Verify(Renderer);
  CredentialFieldsContract.Verify(Renderer, Capture);
  PickerFieldsContract.Verify(Renderer, Capture);
  DialogContract.Verify(Renderer, Capture);
  DisclosureContract.Verify(Renderer, Capture);
  FeedbackContract.Verify(Renderer, Capture);
  DropdownContract.Verify(Renderer, Capture);
  ContextContract.Verify(Renderer, Capture);
  Console.WriteLine(
    'GUI gallery verified: ' + if Renderer = Cui.CuiRenderer.Software then 'software'
      else 'opengl'
      end if
  );
end procedure;

function Encoded(Value: string): string;
begin
  return Sys.Convert.ToBase64String(Text.Encoding.UTF8.GetBytes(Value));
end function;

procedure Observe(Title: string; Capture: string);
begin
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    Title,
    1000,
    760,
    Cui.CuiRenderer.Software,
    true
  );
  // OS input targets stable geometry; animated scrolling can move it between events.
  Window.SetReducedMotion(true);
  using const Session: Gui.Session<State.Msg> := Host.Start<State.Model, State.Msg>(
    new State.Model(),
    GalleryUpdate.Update,
    View.Build,
    Window,
    256,
    ThemeFor := GalleryUpdate.ThemeFor
  );
  while Session.Step() do
    const Frame: Gui.Frame := Session.Snapshot();
    Console.WriteLine(
      'FRAME ' + Frame.Id.ToString() + ' ' + cast<int>(Frame.Size.Width).ToString() + ' ' +
      cast<int>(Frame.Size.Height).ToString() + ' ' + (Frame.Theme.Appearance =
        Themes.Mode.Dark).ToString()
    );
    for Label: string in Frame.Text do
      Console.WriteLine('TEXT ' + Encoded(Label));
    end for;

    for Item: Gui.Control in Frame.Controls do
      Console.WriteLine(
        'CONTROL ' + Encoded(Item.Id) + ' ' + Encoded(Item.Key) + ' ' + Encoded(Item.Value) + ' ' +
        cast<int>(Item.Bounds.X).ToString() + ' ' + cast<int>(Item.Bounds.Y).ToString() + ' ' +
        cast<int>(Item.Bounds.Width).ToString() + ' ' + cast<int>(Item.Bounds.Height).ToString() +
        ' ' + Item.Focused.ToString()
      );
    end for;

    Session.CapturePng(Capture);
    Console.WriteLine('END');
  end while;
end procedure;

procedure Run(Arguments: array of string);
requires Arguments.Length = 3 or Arguments.Length = 4;
begin
  if Arguments[1] = 'observe' then
    Observe(Arguments[2], Arguments[3]);
    return;
  end if;

  A.Check(Arguments[1] = 'software' or Arguments[1] = 'opengl', 'Unknown renderer.');
  Verify(
    if Arguments[1] = 'software' then Cui.CuiRenderer.Software else Cui.CuiRenderer.OpenGl end if,
    Arguments[2]
  );
end procedure;

begin
  Run(Sys.Environment.GetCommandLineArgs());
end;
end program;
