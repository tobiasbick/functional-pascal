// [Documentation](../../../docs/ui/gui/reader/README.md)

unit GalleryReaderContract;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Containers.Grids as Grids;
uses Fpas.Ui.Widgets.Navigation.ScrollAnchors as Anchors;
uses Fpas.Ui.Widgets.Navigation.TableOfContents as T;

uses GalleryHostAssertions as A;
uses GuiGallery.App.State as State;
uses GuiGallery.App.Update as G;
uses GuiGallery.App.View as View;
uses System as Sys;

procedure VerifyAnchorScopes();
  procedure RejectAnchor(Tree: E.Element of int; Reason: string);
  begin
    try
      discard V.Prepare of int(Tree, V.Target.Graphical);
    catch Error: Sys.ArgumentException do
      A.Check(Error.Message.Contains(Reason), Error.Message);
      return;
    end try;

    raise new Sys.InvalidOperationException(
      'Expected scroll anchor validation to reject the view.'
    );
  end procedure;
begin
  const Marker: E.Element of int := Anchors.ScrollAnchor of int('chapter');
  const Scrolling: L.Flow := new L.Flow(Scrolling := L.ScrollMode.Vertical);
  const Outline: E.Element of int := T.TableOfContents of int(
    'outline', 'article', [new T.Item('Chapter', 'chapter')]
  );
  RejectAnchor(Marker, 'enclosing scroll viewport');
  for Child: E.Element of int in [
    E.Row of int(Scrolling, Marker),
    E.Column of int(Scrolling, Marker),
    (E.Element of int).Layered([Marker], Scrolling),
    Grids.Grid of int(new Grids.Options(Flow := Scrolling), Marker)
  ] do
    RejectAnchor(E.ScrollView of int('article', Child), 'intervening scroller');
  end for;

  const Article: E.Element of int := E.ScrollView of int('article', E.Column of int(Marker));
  discard V.Prepare of int(
    E.Row of int(E.Column of int(Scrolling, Article), Outline),
    V.Target.Graphical
  );
  RejectAnchor(
    E.Row of int(E.ScrollView of int('article', E.ScrollView of int('nested', Marker)), Outline),
    'inside viewport article'
  );
end procedure;

// Drives the original Reader example with native pointer, wheel and keyboard input.
// ## Parameters
// - `Renderer`: Native renderer under test.
// - `Capture`: Prefix for the Reader screenshots.
public procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Left >= 0 then
      Window.SetLeftButton(Left = 1);
      Left := -1;
    end if;

    if Wheel <> 0.0F then
      Window.Wheel(Wheel);
      Wheel := 0.0F;
    end if;

    if Key <> 0 then
      Window.SetKey(Key, true);
      Window.SetKey(Key, false);
      Key := 0;
    end if;
  end procedure;

  procedure Step(Session: Gui.Session of State.Msg; Frames: int := 1);
  begin
    for Index: int := 1 to Frames do
      A.Check(Session.Step(), 'The Reader page closed unexpectedly.');
    end for;
  end procedure;

  procedure CheckActive(Session: Gui.Session of State.Msg; Index: int; Anchor: string);
  begin
    A.Check(
      A.Control(Session, Outline).Value = Anchor,
      'The outline did not select ' + Anchor + ', active is ' + A.Control(Session, Outline).Value
    );
    for Row: int := 0 to 7 do
      A.Check(
        A.Control(Session, T.ItemId(Outline, Row)).Value = (if Row = Index then
          'true'
        else
          'false'
        end if),
        'Exactly the active outline entry must be marked.'
      );
    end for;
  end procedure;

  procedure CheckJump(Session: Gui.Session of State.Msg; Anchor: string);
  begin
    const Viewport: Cui.CuiRectangle := A.Control(Session, 'reader').Bounds;
    const Destination: Cui.CuiRectangle := A.Control(Session, Anchor).Bounds;
    A.Check(
      Sys.Math.Abs(Destination.Y - Viewport.Y - 12.0F) < 1.0F,
      'The jump did not bring ' + Anchor + ' to the reader inset. Actual Y: ' +
      Destination.Y.ToString()
    );
    A.Check(
      A.Control(Session, State.MainScrollId).Value = '0',
      'The surrounding page should stay in place.'
    );
  end procedure;
begin
  VerifyAnchorScopes();
  const Outline: string := 'reader-outline';
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Left: int := -1;
  var Wheel: float := 0.0F;
  var Key: int := 0;
  const Window: Cui.CuiWindow := new Cui.CuiWindow('FPas CUI Reader', 1100, 850, Renderer, true);
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of State.Msg := Host.Start of (State.Model, State.Msg)(
    new State.Model(Active := State.Page.Reader),
    G.Update,
    View.Build,
    Window,
    256,
    Inject,
    ThemeFor := G.ThemeFor
  );

  Step(Session, 3);
  CheckActive(Session, 0, 'intro');
  const Viewport: Cui.CuiRectangle := A.Control(Session, 'reader').Bounds;
  A.Check(Viewport.Height = 560.0F, 'The original reader needs a 560-point viewport.');
  const Intro: Gui.Control := A.Control(Session, 'intro');
  A.Check(
    Intro.Bounds.Height = 0.0F and Intro.Bounds.Width = Viewport.Width
    and Intro.Bounds.Y = Viewport.Y and not Intro.Enabled,
    'The first article anchor must be an invisible zero-height, full-width destination.'
  );
  Window.CapturePng(Capture + '.reader.png');

  const Install: Cui.CuiRectangle := A.Control(Session, T.ItemId(Outline, 1)).Bounds;
  A.Check(
    Install.Width > 0.0F and Install.Height > 0.0F,
    'The Install entry has no native hit area.'
  );
  X := Install.X + Install.Width / 2.0F;
  Y := Install.Y + Install.Height / 2.0F;
  Left := 1;
  Step(Session);
  Left := 0;
  Step(Session);
  X := -1.0F;
  Y := -1.0F;
  Step(Session, 4);
  CheckJump(Session, 'install');
  CheckActive(Session, 1, 'install');
  Window.CapturePng(Capture + '.reader-jump.png');

  X := Viewport.X + Viewport.Width / 2.0F;
  Y := Viewport.Y + Viewport.Height / 2.0F;
  Wheel := -5.0F;
  Step(Session);
  X := -1.0F;
  Y := -1.0F;
  Step(Session, 4);
  CheckActive(Session, 2, 'cmake');
  A.Check(
    A.Control(Session, 'install').Bounds.Y < Viewport.Y,
    'Wheel input must move the inner article.'
  );
  A.Check(
    A.Control(Session, State.MainScrollId).Value = '0',
    'Wheel input moved the surrounding page.'
  );
  Window.CapturePng(Capture + '.reader-scrolled.png');

  // Enter activates the focused Install row again after the wheel moved past it.
  A.Check(
    A.Control(Session, T.ItemId(Outline, 1)).Focused,
    'Install lost its native keyboard focus.'
  );
  Key := 2;
  Step(Session, 4);
  CheckJump(Session, 'install');
  CheckActive(Session, 1, 'install');
end procedure;

end unit;
