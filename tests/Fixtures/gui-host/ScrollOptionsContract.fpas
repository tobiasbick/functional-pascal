// [Documentation](../../../docs/ui/gui/layout/scroll-view.md)

unit GalleryScrollOptionsContract;

uses Fpas.Ui.Composition as Composition;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Widgets.Feedback.Skeletons as Skeletons;

uses GalleryHostAssertions as A;
uses GuiGallery.App.State as State;
uses GuiGallery.App.Update as Update;

// Verifies scroll layout, composition and fractional scroll proposals through the GUI host.
// ## Parameters
// - `Renderer`: Native renderer used by the gallery.
public procedure Verify(Renderer: Cui.CuiRenderer);
  function Changed(Change: L.ScrollChange): int;
  begin
    case Change.Offset of
      when L.Measure.Points(const Offset: float):
        Observed := Offset;
      else
        A.Check(false, 'GUI scroll proposals must use logical points.');
    end case;

    return 0;
  end function;

  function View(_Model: State.Model; _Viewport: L.Viewport): E.Element of State.Msg;
  begin
    const Scroll: E.Element of int := E.ScrollView of int(
      'scroll-options',
      [
        Skeletons.Skeleton of int('first', Height := 20.0F),
        Skeletons.Skeleton of int('second', Height := 240.0F)
      ],
      new L.ScrollOptions(
        Width := L.Extent.Fixed(L.Measure.Points(240.5F)),
        Height := L.Extent.Fixed(L.Measure.Points(140.5F)),
        Padding := L.Spacing.Fixed(L.Measure.Points(8.5F)),
        Gap := L.Spacing.Fixed(L.Measure.Points(6.25F))
      ),
      Position := L.ScrollPosition.Start,
      OnScroll := Changed
    );
    return Composition.Map of (int, State.Msg)(
      Scroll,
      function(Value: int): State.Msg => State.Msg.Preview
    );
  end function;

  procedure Inject();
  begin
    Window.MovePointer(60.0F, 55.0F);
    if Wheel then
      Window.Wheel(-0.125F);
    end if;
  end procedure;
begin
  var Observed: float := 0.0F;
  var Wheel: bool := false;
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Native scroll options',
    420,
    320,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of State.Msg := Host.Start of (State.Model, State.Msg)(
    new State.Model(), Update.Update, View, Window, 32, Inject
  );
  A.Check(Session.Step(), 'Scroll options did not open.');
  const Box: Cui.CuiRectangle := A.Control(Session, 'scroll-options').Bounds;
  const First: Cui.CuiRectangle := A.Control(Session, 'first').Bounds;
  const Second: Cui.CuiRectangle := A.Control(Session, 'second').Bounds;
  A.Check(
    Box.Width = 240.5F and Box.Height = 140.5F,
    'Native viewport extents did not survive composition.'
  );
  A.Check(First.X = Box.X + 8.5F and First.Y = Box.Y + 8.5F, 'Native viewport padding was lost.');
  A.Check(
    Second.Y = First.Y + First.Height + 6.25F,
    'Native gap between direct children was lost.'
  );
  Wheel := true;
  A.Check(Session.Step(), 'The viewport closed during wheel input.');
  A.Check(Observed = 5.5F, 'The wheel proposal did not preserve fractional logical points.');
end procedure;

end unit;
