unit GallerySourceToolsContract;

uses
  GuiGallery.App.State as State, GuiGallery.App.Update as Update, GuiGallery.App.View as Gallery,
  GuiGallery.Pages.Files.State as Files, Fpas.Ui.Terminals as Terminal,
  GalleryHostAssertions as A,
  Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Gui.Internal.Session as Host,
  Fpas.Ui.Gui.Cui as Cui, Fpas.Ui.Gui.Internal.Context as Context,
  Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.ShortcutRecorders as Keys;

procedure CapturePage(Page: State.Page; Renderer: Cui.CuiRenderer; Root: string; Width: int);
  procedure Inject();
  begin
    Window.MovePointer(-1.0F, -1.0F);
    if Offset > 0 then
      var Current: float := 0.0F;
      var Maximum: float := 0.0F;
      Window.ScrollState(Token, 0, cast<float>(Offset), out Current, out Maximum);
    end if;

    if Input <> '' then
      Window.InputText(Input);
      Input := '';
    end if;

    if Key <> 0 then
      Window.SetKey(Key, true);
      Window.SetKey(Key, false);
      Key := 0;
    end if;
  end procedure;

  function Observe(Model: State.Model; Value: State.Msg): Mvu.Transition<State.Model, State.Msg>;
  begin
    const Next: Mvu.Transition<State.Model, State.Msg> := Update.Update(Model, Value);
    if Focus <> '' then
      return new Mvu.Transition<State.Model, State.Msg>(Next.Model, [Mvu.Focus<State.Msg>(Focus)]);
    end if;

    Output := Next.Model.Files.Output;
    Source := Next.Model.Code.Sql;
    return Next;
  end function;

  procedure Draw(Session: Gui.Session<State.Msg>);
  begin
    A.Check(Session.Step(), 'Source tools gallery closed.');
  end procedure;
begin
  var Offset: int := 0;
  var Input: string := '';
  var Key: int := 0;
  var Focus: string := '';
  var Output: string := '';
  var Source: string := '';
  const Token: string := Context.Token(
    'scroll',
    'main-' + Page.ToString().ToLowerInvariant() + '-0'
  );
  const Height: int := if Page = State.Page.Code then
    1700
  else
    1400
  end if;
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas CUI source tools',
    Width,
    Height,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session<State.Msg> := Host.Start<State.Model, State.Msg>(
    new State.Model(Active := Page),
    Observe,
    Gallery.Build,
    Window,
    64,
    Inject,
    ThemeFor := Update.ThemeFor
  );
  for Frame: int := 0 to 7 do
    Draw(Session);
  end for;
  const Positions: array of int := if Page = State.Page.Code then
    [650, 1450, 2100, 2800]
  else
    [0]
  end if;
  for Position: int in Positions do
    Offset := Position;
    for Frame: int := 0 to 7 do
      Draw(Session);
    end for;

    Session.CapturePng(
      Root + '-' + Page.ToString().ToLowerInvariant() + '-' + Width.ToString() + '-' +
      Position.ToString() + '.png'
    );
  end for;

  if Width = 1100 and Page = State.Page.Code then
    Offset := 1550;
    for Frame: int := 0 to 4 do
      Draw(Session);
    end for;

    Focus := 'sql-editor';
    A.Send(Session, State.Msg.Preview);
    Draw(Session);
    Focus := '';
    Input := '-- ';
    Draw(Session);
    Draw(Session);
    A.Check(
      Source.StartsWith('-- SELECT'),
      'The gallery must retain SQL edited through the native input.'
    );
  elsif Width = 1100 then
    Focus := 'files-terminal';
    A.Send(Session, State.Msg.Preview);
    Draw(Session);
    Focus := '';
    Input := 'echo example output';
    Draw(Session);
    Key := cast<int>(Keys.Key.Enter);
    Draw(Session);
    Draw(Session);
    A.Check(Output.Contains('example output'), 'The terminal command must reach the Files model.');
  end if;
end procedure;

// Captures the native source tools and checks gallery edit/input routing.
// ## Parameters
// - `Renderer`: Native renderer under test.
// - `Capture`: Prefix of the screenshot filenames.
public procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
begin
  CapturePage(State.Page.Code, Renderer, Capture, 1100);
  CapturePage(State.Page.Code, Renderer, Capture, 550);
  CapturePage(State.Page.Files, Renderer, Capture, 1100);
  CapturePage(State.Page.Files, Renderer, Capture, 550);
end procedure;

end unit;
