// [Documentation](../../../docs/ui/gui/inputs/text-field.md)

unit GalleryTextFieldContract;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as App;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Inputs.SearchFields as SearchFields;
uses Fpas.Ui.Widgets.Inputs.TextAreas as TextAreas;
uses Fpas.Ui.Widgets.Inputs.TextFields as F;

uses GuiGallery.App.State as State;
uses GuiGallery.App.Update as GalleryUpdate;
uses GuiGallery.App.View as View;
uses GuiGallery.Shared.State as SliceShared;
uses System as Sys;
uses System.Collections.Generic as Lists;

procedure Check(Condition: bool; Reason: string);
begin
  if not Condition then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function Control of TMsg(Session: Gui.Session of TMsg; Id: string): Gui.Control;
begin
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Id = Id then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing text field control ' + Id);
end function;

function HasLabel(Session: Gui.Session of State.Msg; Text: string): bool;
begin
  for Label: string in Session.Snapshot().Text do
    if Label = Text then
      return true;
    end if;
  end for;

  return false;
end function;

procedure Validate();
  procedure Reject(Node: E.Element of string; Profile: V.Target; Reason: string);
  begin
    try
      discard V.Prepare of string(Node, Profile);
    catch Error: Sys.ArgumentException do
      Check(Error.Message.Contains(Reason), Error.Message);
      return;
    end try;

    raise new Sys.InvalidOperationException('Text field preflight accepted an invalid view.');
  end procedure;
begin
  const Identity: function(string): string := function(Value: string): string => Value;
  discard V.Prepare of string(F.TextField of string('field', '', Identity), V.Target.Portable);
  Reject(
    F.TextField of string('field', '', Identity, new F.Options(Password := true)),
    V.Target.Terminal,
    'Graphical profile'
  );
  Reject(
    F.TextField of string('field', '', Identity, new F.Options(Autofocus := true)),
    V.Target.Terminal,
    'Graphical profile'
  );
  Reject(
    F.TextField of string('field', '', Identity, new F.Options(Width := L.Extent.Percent(101.0F))),
    V.Target.Graphical,
    'between zero and 100'
  );
  const Search: E.Element of string := SearchFields.SearchField of string('query', '', Identity);
  discard V.Prepare of string(Search, V.Target.Terminal);
  Reject(Search, V.Target.Portable, 'terminal or graphical profile');
  Reject(
    SearchFields.SearchField of string(
      'query',
      '',
      Identity,
      new SearchFields.Options(Password := true)
    ),
    V.Target.Terminal,
    'Graphical profile'
  );
  Reject(
    SearchFields.SearchField of string(
      'query', '', Identity, new SearchFields.Options(Password := true, MaxUtf8Bytes := 342)
    ),
    V.Target.Graphical,
    'at most 341 bytes'
  );
  discard V.Prepare of string(
    TextAreas.TextArea of string('about', '', Identity),
    V.Target.Portable
  );
  Reject(
    TextAreas.TextArea of string('about', '', Identity, new TextAreas.Options(Prefix := 'About:')),
    V.Target.Terminal, 'Graphical profile'
  );
  Reject(
    TextAreas.TextArea of string('about', 'line' + cast 13 as char, Identity),
    V.Target.Graphical,
    'LF line endings'
  );
  Reject(
    TextAreas.TextArea of string(
      'about',
      '',
      Identity,
      new TextAreas.Options(Height := float.PositiveInfinity)
    ),
    V.Target.Graphical,
    'height must be finite'
  );
  Reject(
    F.TextField of string('field', 'é', Identity, new F.Options(MaxUtf8Bytes := 1)),
    V.Target.Graphical, 'exceeds its UTF-8 capacity'
  );
  Reject(
    F.TextField of string('field', 'line' + Sys.Environment.NewLine, Identity),
    V.Target.Graphical, 'single-line'
  );
end procedure;

procedure VerifyGallery(Renderer: Cui.CuiRenderer; Capture: string);
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Left >= 0 then
      Window.SetLeftButton(Left = 1);
      Left := -1;
    end if;

    if KeyCode <> 0 then
      Window.SetKey(KeyCode, true, Modifiers);
      Window.SetKey(KeyCode, false, Modifiers);
      KeyCode := 0;
    end if;

    if Input <> '' then
      Window.SetKey(0, false);
      Window.InputText(Input);
      Input := '';
    end if;
  end procedure;
  procedure Exercise(Session: Gui.Session of State.Msg);
    procedure Step();
    begin
      Check(Session.Step(), 'The text field gallery closed.');
    end procedure;
    procedure Key(Code: int; Mods: int := 0);
    begin
      KeyCode := Code;
      Modifiers := Mods;
      Step();
      Step();
    end procedure;
    procedure TypeText(Value: string);
    begin
      Input := Value;
      Step();
      Step();
    end procedure;
    procedure Click(Id: string);
    begin
      const Area: Cui.CuiRectangle := Control of State.Msg(Session, Id).Bounds;
      X := Area.X + Area.Width / 2;
      Y := Area.Y + Area.Height / 2;
      Left := 1;
      Step();
      Left := 0;
      Step();
      Step();
    end procedure;
  begin
    Step();
    Step();
    const Name: Gui.Control := Control of State.Msg(Session, 'input-name');
    const Email: Gui.Control := Control of State.Msg(Session, 'input-email');
    Check(
      Name.Bounds.Y = Email.Bounds.Y and Email.Bounds.X > Name.Bounds.X
      and Name.Bounds.Width = Email.Bounds.Width and HasLabel(
        Session,
        'We never share your email.'
      ),
      'The original text fields must use two columns with the email hint.'
    );
    Session.CapturePng(Capture + '.text-fields.png');
    const Query: Cui.CuiRectangle := Control of State.Msg(Session, 'input-search').Bounds;
    const Password: Cui.CuiRectangle := Control of State.Msg(Session, 'input-password').Bounds;
    const About: Cui.CuiRectangle := Control of State.Msg(Session, 'input-about').Bounds;
    Check(
      Query.Y = Password.Y and Query.X = Email.Bounds.X and About.X = Name.Bounds.X
      and About.Width = Name.Bounds.Width + Email.Bounds.Width + 16 and About.Height = 96
      and HasLabel(Session, 'Markdown is supported.'),
      'The complete original card must place Search beside Password and About across both columns.'
    );
    Click('input-search');
    TypeText('rain');
    Check(
      Control of State.Msg(Session, 'input-search').Value = 'rain',
      'Search must retain the edited query.'
    );
    Click(SearchFields.ClearId('input-search'));
    Check(
      Control of State.Msg(
        Session,
        'input-search'
      ).Value = '' and Control of State.Msg(Session, 'input-search').Focused,
      'The native search clear action must empty the query and return editor focus.'
    );

    Click('input-about');
    Key(15, Primary);
    TypeText('Alpha');
    Key(2);
    TypeText('Béta');
    Key(9);
    Key(12);
    TypeText('!');
    Check(
      Control of State.Msg(Session, 'input-about').Value = 'Alpha!' + cast 10 as char + 'Béta',
      'Enter must insert LF and Up and End must edit the previous visual line.'
    );

    Click('input-name');
    Key(15, Primary);
    TypeText('Zoë 🐱');
    Check(
      Control of State.Msg(Session, 'input-name').Value = 'Zoë 🐱',
      'Typing must preserve UTF-8.'
    );
    Key(4);
    Check(
      Control of State.Msg(Session, 'input-name').Value = 'Zoë ',
      'Backspace must remove the complete code point.'
    );
    Key(40, Primary);
    Check(
      Control of State.Msg(Session, 'input-name').Value = 'Zoë 🐱',
      'Undo must restore the edited text.'
    );
    Key(15, Primary);
    TypeText('x');
    discard Session.Post(State.Msg.Shared(SliceShared.Msg.SetName('éZ')));
    Step();
    TypeText('!');
    Check(
      Control of State.Msg(Session, 'input-name').Value = 'éZ!',
      'A model replacement must reset stale UTF-8 offsets.'
    );

    Click('input-password');
    TypeText('sample');
    const Reveal: string := F.RevealId('input-password');
    Check(
      HasLabel(Session, 'Use 8 or more characters.')
      and Control of State.Msg(Session, 'input-password').Value = '',
      'The password must report its error without exposing its value.'
    );
    Click(Reveal);
    Check(
      Control of State.Msg(Session, Reveal).Text = 'Hide password'
      and Control of State.Msg(
        Session,
        'input-password'
      ).Value = '' and not HasLabel(Session, 'sample'),
      'Revealing the password must change the native action without exposing its value in the snapshot.'
    );
    Click(Reveal);
    Check(
      Control of State.Msg(Session, Reveal).Text = 'Show password',
      'The eye must mask the password again.'
    );

    Click('input-email');
    Key(15, Primary);
    TypeText('maya+inputs@example.com');
    discard Session.Post(State.Msg.Show(State.Page.Overview));
    Step();
    Step();
    Check(
      Control of State.Msg(Session, 'workspace-name').Value = 'éZ!'
      and Control of State.Msg(Session, 'workspace-email').Value = 'maya+inputs@example.com',
      'Editing Full name and Email in Inputs must update the shared workspace fields.'
    );

    discard Session.Post(State.Msg.Show(State.Page.SmartInputs));
    Step();
    Step();
    Check(
      Control of State.Msg(Session, 'input-url').Bounds.Width = 260
      and Control of State.Msg(Session, 'input-weight').Bounds.Width = 120
      and HasLabel(Session, 'https://') and HasLabel(Session, 'kg'),
      'The original affixes and field widths must be visible.'
    );
    Session.CapturePng(Capture + '.text-affixes.png');
    Click('input-url');
    Key(15, Primary);
    TypeText('example.com');
    Check(
      Control of State.Msg(Session, 'input-url').Value = 'example.com',
      'The displayed prefix must remain outside the value.'
    );
  end procedure;
begin
  const Primary: int := if Sys.OperatingSystem.IsMacOS() then
    8
  else
    2
  end if;
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Left: int := -1;
  var KeyCode: int := 0;
  var Modifiers: int := 0;
  var Input: string := '';
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas CUI text fields',
    1000,
    760,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of State.Msg := Host.Start of (State.Model, State.Msg)(
    new State.Model(Active := State.Page.Inputs),
    GalleryUpdate.Update,
    View.Build,
    Window,
    256,
    Inject,
    ThemeFor := GalleryUpdate.ThemeFor
  );
  Exercise(Session);
end procedure;

type Msg = variant
  Edit(Value: string);
  Submit(Value: string);
  Focus;
end variant;

procedure VerifyOptions(Renderer: Cui.CuiRenderer);
  function Update(Value: string; Message: Msg): App.Transition of (string, Msg);
  begin
    case Message of
      when Msg.Edit(const Text: string):
        Events.Add('edit:' + Text);
        return new App.Transition of (string, Msg)(Text, []);
      when Msg.Submit(const Text: string):
        Events.Add('submit:' + Text);
      when Msg.Focus:
        return new App.Transition of (string, Msg)(Value, [App.Focus of Msg('edit')]);
    end case;

    return new App.Transition of (string, Msg)(Value, []);
  end function;
  function Build(Value: string; Viewport: L.Viewport): E.Element of Msg;
  begin
    return E.Column of Msg(
      new L.Flow(Gap := L.Spacing.Normal, Padding := L.Spacing.Normal),
      F.TextField of Msg(
        'edit',
        Value,
        Msg.Edit,
        new F.Options(
          Label := 'Editor', Clearable := true, MaxUtf8Bytes := 5,
          Width := L.Extent.Fixed(L.Measure.Logical(210)), Autofocus := true
        ),
        Msg.Submit
      ),
      F.TextField of Msg(
        'read-only', 'fixed', Msg.Edit,
        new F.Options(ReadOnly := true, Width := L.Extent.Percent(50.0F))
      ),
      F.TextField of Msg(
        'disabled',
        'sample',
        Msg.Edit,
        new F.Options(Password := true, Enabled := false, Autofocus := true)
      ),
      SearchFields.SearchField of Msg(
        'query', Value, Msg.Edit,
        new SearchFields.Options(
          Placeholder := '', Prefix := 'Projects:', Suffix := 'in scope', Password := true,
          Width := L.Extent.Fixed(L.Measure.Logical(230))
        ),
        Msg.Submit
      )
    );
  end function;
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Left >= 0 then
      Window.SetLeftButton(Left = 1);
      Left := -1;
    end if;

    if Submit then
      Window.SetKey(12, true);
      Window.SetKey(12, false);
      Window.InputText(SubmissionText);
      Window.SetKey(2, true);
      Window.SetKey(2, false);
      Submit := false;
    end if;
  end procedure;
  procedure Exercise(Session: Gui.Session of Msg);
    procedure Step();
    begin
      Check(Session.Step(), 'The text field options fixture closed.');
    end procedure;
    procedure Click(Id: string);
    begin
      const Area: Cui.CuiRectangle := Control of Msg(Session, Id).Bounds;
      X := Area.X + Area.Width / 2;
      Y := Area.Y + Area.Height / 2;
      Left := 1;
      Step();
      Left := 0;
      Step();
      Step();
    end procedure;
  begin
    Step();
    Step();
    const Editor: Gui.Control := Control of Msg(Session, 'edit');
    Check(
      Editor.Focused and Editor.Bounds.Width = 210
      and Sys.Math.Abs(
        Control of Msg(Session, 'read-only').Bounds.Width * 2.0F -
        Control of Msg(Session, 'disabled').Bounds.Width
      ) <= 1.0F,
      'The first enabled autofocus, fixed width and percentage width must reach CUI.'
    );
    Submit := true;
    Step();
    Step();
    Check(
      Events.Count = 2 and Events[0] = 'edit:abé' and Events[1] = 'submit:abé',
      'Capacity must preserve UTF-8 and Enter must follow the edit with the same text.'
    );
    Click(F.ClearId('edit'));
    Check(
      Control of Msg(Session, 'edit').Value = '' and Events.Count = 3 and Events[2] = 'edit:',
      'The native clear action must update the model.'
    );
    Click('read-only');
    Submit := true;
    Step();
    Step();
    const ReadOnly: Gui.Control := Control of Msg(Session, 'read-only');
    Check(
      ReadOnly.Focused and ReadOnly.Value = 'fixed' and Events.Count = 3,
      'A read-only field must allow focus without editing.'
    );
    discard Session.Post(Msg.Focus);
    Step();
    Check(
      Control of Msg(Session, 'edit').Focused,
      'A later focus request must find the editor by its stable ID.'
    );
    Click(F.RevealId('disabled'));
    Check(
      Control of Msg(Session, F.RevealId('disabled')).Text = 'Show password'
      and not Control of Msg(Session, F.RevealId('disabled')).Enabled,
      'A disabled password field must disable its reveal action.'
    );
    const Reveal: string := SearchFields.RevealId('query');
    Check(Control of Msg(Session, 'query').Bounds.Width = 230, 'Search must use its native width.');
    Click(Reveal);
    Check(
      Control of Msg(Session, Reveal).Text = 'Hide password',
      'A masked search field must have a working native reveal button.'
    );
    Click('query');
    SubmissionText := 'éZ';
    Submit := true;
    Step();
    Step();
    Check(
      Events.Count = 5 and Events[3] = 'edit:éZ' and Events[4] = 'submit:éZ'
      and Control of Msg(Session, 'query').Value = ''
      and Sys.Array.IndexOf of string(Session.Snapshot().Text, 'Projects:') >= 0
      and Sys.Array.IndexOf of string(Session.Snapshot().Text, 'in scope') >= 0,
      'Search must submit its query without affixes and omit the password from the snapshot.'
    );
  end procedure;
begin
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Left: int := -1;
  var Submit: bool := false;
  var SubmissionText: string := 'é😀';
  const Events: Lists.List of string := new Lists.List of string();
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas CUI text field options',
    500,
    260,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of Msg := Host.Start of (string, Msg)(
    'ab',
    Update,
    Build,
    Window,
    32,
    Inject
  );
  Exercise(Session);
end procedure;

procedure VerifyCompact(Renderer: Cui.CuiRenderer; Capture: string);
begin
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas CUI compact text fields',
    360,
    760,
    Renderer,
    true
  );
  using const Session: Gui.Session of State.Msg := Host.Start of (State.Model, State.Msg)(
    new State.Model(Active := State.Page.Inputs),
    GalleryUpdate.Update,
    View.Build,
    Window,
    32,
    ThemeFor := GalleryUpdate.ThemeFor
  );
  Check(Session.Step(), 'The compact text field gallery closed.');
  Check(Session.Step(), 'The compact text field layout did not settle.');
  const Name: Cui.CuiRectangle := Control of State.Msg(Session, 'input-name').Bounds;
  const Email: Cui.CuiRectangle := Control of State.Msg(Session, 'input-email').Bounds;
  const Search: Cui.CuiRectangle := Control of State.Msg(Session, 'input-search').Bounds;
  const About: Cui.CuiRectangle := Control of State.Msg(Session, 'input-about').Bounds;
  Check(
    Name.X = Email.X and Name.Width = Email.Width and Email.Y > Name.Y + Name.Height
    and Search.X = About.X and Search.Width = About.Width and About.Y > Search.Y + Search.Height,
    'The text fields must stack at compact widths.'
  );
  Session.CapturePng(Capture + '.text-fields-compact.png');
end procedure;

// Verifies text editing and presentation with the gallery's actual renderer.
//
// ## Parameters
// - `Renderer`: Native renderer under test.
// - `Capture`: Prefix for the gallery screenshots.
public procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
begin
  Validate();
  VerifyGallery(Renderer, Capture);
  VerifyOptions(Renderer);
  VerifyCompact(Renderer, Capture);
end procedure;

end unit;
