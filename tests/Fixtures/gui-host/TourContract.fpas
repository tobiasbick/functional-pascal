// [Documentation](../../../docs/ui/gui/overlays/guided-tour.md)

unit GalleryTourContract;

uses
  Fpas.Ui.Widgets.Overlays.Tours as T, Fpas.Ui.Elements as E, Fpas.Ui.Validation as V,
  Fpas.Ui.Widgets.Overlays.Menus as M, Fpas.Ui.Widgets.Canvas.SelectionBars as Bulk,
  GalleryHostAssertions as A, System as Sys;

procedure CountFormats();
  function Tour(Format: string; Current: int): E.Element<int>;
  begin
    return T.Tour<int>(
      'tour-format', E.Text<int>('Base'), [new T.Step()], Current,
      function(Change: T.Change): int => Change.Step, new T.Options(CountFormat := Format)
    );
  end function;
  function Selection(Format: string; Count: int): E.Element<int>;
  begin
    return Bulk.SelectionBar<int>(
      'selection-format', Bulk.Selection.Count(Count), [],
      function(Change: Bulk.Event): int => Change.Index, E.Text<int>('Anchor'),
      new Bulk.Options(CountFormat := Format)
    );
  end function;
  procedure Reject(Node: E.Element<int>; Id: string);
  begin
    try
      discard V.Prepare<int>(Node, V.Target.Graphical);
    catch Error: Sys.ArgumentException do
      A.Check(Error.Message.Contains(Id) and Error.Message.Contains('countFormat'), Error.Message);
      return;
    end try;

    raise new Sys.InvalidOperationException('Invalid count format passed view preflight.');
  end procedure;
begin
  for Format: string in ['', 'Selected', '100%%', '%d chosen (100%%)', '%%%d'] do
    for Current: int in [-1, 0] do
      discard V.Prepare<int>(Tour(Format, Current), V.Target.Graphical);
    end for;

    for Count: int in [0, 5] do
      discard V.Prepare<int>(Selection(Format, Count), V.Target.Graphical);
    end for;
  end for;

  discard V.Prepare<int>(Tour('Step %d / %d', 0), V.Target.Graphical);
  for Format: string in ['%s', '%n', '%', '%1$d', '%02d', '%d %d %d'] do
    for Current: int in [-1, 0] do
      Reject(Tour(Format, Current), 'tour-format');
    end for;

    for Count: int in [0, 5] do
      Reject(Selection(Format, Count), 'selection-format');
    end for;
  end for;

  Reject(Selection('%d %d', 0), 'selection-format');
end procedure;

// Checks tour preflight before native calls can create an overlay.
public procedure Verify();
  procedure Reject(Node: E.Element<int>; Profile: V.Target; Reason: string);
  begin
    try
      discard V.Prepare<int>(Node, Profile);
    catch Error: Sys.ArgumentException do
      A.Check(Error.Message.Contains(Reason), Error.Message);
      return;
    end try;

    raise new Sys.InvalidOperationException('Invalid tour was accepted.');
  end procedure;
  function View(Steps: array of T.Step; Current: int; Settings: T.Options): E.Element<int>;
  begin
    return E.Element<int>.Tour(
      'tour', E.Text<int>('Base'), Steps, Current,
      function(Change: T.Change): int => Change.Step, Settings
    );
  end function;
begin
  CountFormats();
  const Steps: array of T.Step := [new T.Step(Title := 'Title', Body := 'Body')];
  const Settings: T.Options := new T.Options();
  Reject(View(Steps, -1, Settings), V.Target.Terminal, 'Graphical');
  Reject(View(Steps, 0, Settings), V.Target.Portable, 'Graphical');
  Reject(View([], -1, Settings), V.Target.Graphical, 'needs steps');
  Reject(View(Steps, -2, Settings), V.Target.Graphical, 'selected step');
  Reject(View(Steps, 1, Settings), V.Target.Graphical, 'selected step');
  Reject(
    View([new T.Step(Title := 'x' + Sys.Char.MinValue)], 0, Settings),
    V.Target.Graphical,
    'zero'
  );
  Reject(
    View([new T.Step(Body := 'x' + Sys.Char.MinValue)], 0, Settings),
    V.Target.Graphical,
    'zero'
  );
  Reject(
    View([new T.Step(Target := 'x' + Sys.Char.MinValue)], 0, Settings),
    V.Target.Graphical,
    'zero'
  );
  Reject(
    View([new T.Step(Position := cast<M.Placement>(255))], 0, Settings),
    V.Target.Graphical,
    'placement'
  );
  for Value: float in [-1.0F, Sys.Single.NaN, Sys.Single.PositiveInfinity] do
    Reject(View(Steps, 0, new T.Options(Width := Value)), V.Target.Graphical, 'finite');
    Reject(View(Steps, 0, new T.Options(Padding := Value)), V.Target.Graphical, 'finite');
  end for;
end procedure;

end unit;
