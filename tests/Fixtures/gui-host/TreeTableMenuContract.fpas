// [Documentation](../../../docs/ui/gui/data-grid/tree-table.md#context-menu)

unit GalleryTreeTableMenuContract;

uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Mvu.Application as App;

uses GuiGallery.App.State as State;
uses GuiGallery.App.Update as GalleryUpdate;
uses GuiGallery.App.View as View;
uses GuiGallery.Pages.DataGrid.State as Grid;
uses System as Sys;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function Control(Session: Gui.Session<State.Msg>; Id: string): Gui.Control;
begin
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Id = Id then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing tree-table menu control: ' + Id);
end function;

// Verifies the gallery tree table's native context menu for pointer and keyboard.
// ## Parameters
// - `Renderer`: Native renderer to verify.
// - `Capture`: Prefix for the open-menu screenshot.
public procedure Verify(Renderer: Cui.CuiRenderer; Capture: string);
  function Update(Model: State.Model; Message: State.Msg): App.Transition<State.Model, State.Msg>;
  begin
    const Next: App.Transition<State.Model, State.Msg> := GalleryUpdate.Update(Model, Message);
    Last := Next.Model.DataGrid;
    return Next;
  end function;
  procedure Inject();
  begin
    Window.MovePointer(X, Y);
    if Right >= 0 then
      Window.SetRightButton(Right = 1);
      Right := -1;
    end if;

    if Pending <> 0 then
      Window.SetKey(Pending, true, Modifiers);
      Window.SetKey(Pending, false, Modifiers);
      Pending := 0;
      Modifiers := 0;
    end if;
  end procedure;
  procedure Step(Session: Gui.Session<State.Msg>);
  begin
    Check(Session.Step(), 'The tree-table menu frame closed.');
  end procedure;
  procedure Open(Session: Gui.Session<State.Msg>; Row: string);
  begin
    const Area: Cui.CuiRectangle := Control(Session, Row).Bounds;
    Check(
      Area.Width > 0 and Area.Height > 0 and Area.Y + Area.Height < 1550.0F,
      'The tree row must be visible.'
    );
    X := Area.X + 24.0F;
    Y := Area.Y + Area.Height / 2;
    // CUI resolves hover at the start of a frame, so the pointer arrives a frame early.
    Step(Session);
    Right := 1;
    Step(Session);
    Right := 0;
    Step(Session);
    Check(
      Control(Session, 'virtual-tree/menu').Value = 'true',
      'A right click on a row must open its menu.'
    );
  end procedure;
  procedure Key(Session: Gui.Session<State.Msg>; Code: int; Mods: int := 0);
  begin
    Pending := Code;
    Modifiers := Mods;
    Step(Session);
    Step(Session);
  end procedure;
begin
  var Last: Grid.Model := new Grid.Model();
  var X: float := -1.0F;
  var Y: float := -1.0F;
  var Right: int := -1;
  var Pending: int := 0;
  var Modifiers: int := 0;
  const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPas CUI tree-table menu',
    1100,
    1550,
    Renderer,
    true
  );
  Window.SetReducedMotion(true);
  using const Session: Gui.Session<State.Msg> := Host.Start<State.Model, State.Msg>(
    new State.Model(Active := State.Page.DataGrid),
    Update, View.Build, Window, 256, Inject, ThemeFor := GalleryUpdate.ThemeFor
  );
  Step(Session);
  Check(Control(Session, 'virtual-tree/menu').Value = 'false', 'The menu must start closed.');

  Open(Session, 'virtual-tree/node/0');
  Check(
    Control(Session, 'virtual-tree/menu/open').Text = 'Open'
    and Control(Session, 'virtual-tree/menu/toggle').Text = 'Collapse',
    'The menu must show the entries built for the node under the pointer.'
  );
  Check(Last.TreeNodes[0].Selected, 'A right click outside the selection must select the row.');
  Session.CapturePng(Capture + '.tree-menu.png');
  Key(Session, 10);
  Key(Session, 10);
  Key(Session, 2);
  Check(
    not Last.TreeNodes[0].Open and Control(Session, 'virtual-tree/menu').Value = 'false',
    'Choosing Collapse must dispatch the node message once and close.'
  );

  Key(Session, 65, 1);
  Check(
    Control(Session, 'virtual-tree/menu').Value = 'true'
    and Control(Session, 'virtual-tree/menu/toggle').Text = 'Expand',
    'Shift+F10 must open the menu for the cursor row.'
  );
  Key(Session, 3);
  Check(
    not Last.TreeNodes[0].Open and Control(Session, 'virtual-tree/menu').Value = 'false',
    'Escape must close the menu without a command.'
  );

  Open(Session, 'virtual-tree/node/0');
  Key(Session, 10);
  Key(Session, 2);
  Check(Last.Activated = 'src', 'Open must dispatch for the node the menu was opened for.');
end procedure;

end unit;
