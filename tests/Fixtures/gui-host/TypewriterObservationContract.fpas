// [Documentation](../../../docs/ui/gui/motion/typewriter.md)

unit GalleryTypewriterObservationContract;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Gui.Application as Gui;
uses Fpas.Ui.Gui.Cui as Cui;
uses Fpas.Ui.Gui.Internal.Core.Context as C;
uses Fpas.Ui.Gui.Internal.Hosting.Session as Host;
uses Fpas.Ui.Gui.Internal.Presentation.Presentation as P;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Motion.Motion as Motion;
uses Fpas.Ui.Widgets.Motion.Typewriters as Typing;

uses System as Sys;
uses System.Collections.Generic as Lists;

procedure Check(Condition: bool; Reason: string);
begin
  if not Condition then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

procedure Lifetime(Renderer: Cui.CuiRenderer);
  function View(Visible: bool; Viewport: L.Viewport): E.Element of bool;
  begin
    if not Visible then
      return E.Text of bool('Removed');
    end if;

    return Typing.Typewriter of bool(
      'typing', 'Same revision', OnComplete := function(): bool begin
        Callbacks := Callbacks + 1;
        return true;
      end function
    );
  end function;
begin
  var Callbacks: int := 0;
  const Window: Cui.CuiWindow := new Cui.CuiWindow('Typewriter lifetime', 480, 240, Renderer, true);
  Window.SetReducedMotion(true);
  using const Session: Gui.Session of bool := Host.Start of (bool, bool)(
    true,
    function(Model: bool; Message: bool): Mvu.Transition of (bool, bool) => new Mvu.Transition of (bool, bool)(
      Message,
      []
    ),
    View, Window, 16
  );
  Check(Session.Step() and Callbacks = 1, 'The initial typewriter must complete once.');
  Check(Session.Step() and Callbacks = 1, 'Applying completion must not notify again.');
  discard Session.Post(false);
  Check(Session.Step() and Callbacks = 1, 'Removal must not notify.');
  discard Session.Post(true);
  Check(
    Session.Step() and Callbacks = 2,
    'Reappearing with the same revision must complete again.'
  );
end procedure;

// Exercises cached repaint, covered owner and closing observation policies without a platform resize loop.
// ## Parameters
// - `Renderer`: Native renderer used for presentation.
public procedure Verify(Renderer: Cui.CuiRenderer);
  function Completed(): bool;
  begin
    Callbacks := Callbacks + 1;
    return true;
  end function;

  function Draw(Text: string; Replay: int; Observe: bool; Accept: bool): int;
  begin
    const Tree: E.Element of bool := Typing.Typewriter of bool(
      'typing', Text, Replay, new Motion.TextOptions(Delay := 600.0F), Completed
    );
    const Frame: C.State of bool := new C.State of bool(
      Window,
      V.Prepare of bool(Tree, V.Target.Graphical),
      new Lists.List of bool(),
      new Lists.List of string(),
      new Lists.List of Gui.Control(),
      new Lists.Queue of string(),
      new Lists.Dictionary of (string, string)(),
      new Lists.HashSet of string(),
      [],
      Accept,
      Accept,
      null,
      ObserveTransitions := Observe,
      CompletedAnimations := Completions
    );
    Check(Window.NextFrame(), 'The typewriter observation window closed.');
    P.Draw of bool(Frame);
    Window.Present();
    return Frame.Messages.Count;
  end function;
begin
  Lifetime(Renderer);
  var Callbacks: int := 0;
  const Completions: Lists.Dictionary of (string, C.AnimationCompletion) := new Lists.Dictionary of (string, C.AnimationCompletion)();
  using const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'Typewriter owner observations', 480, 240, Renderer, true
  );
  Window.SetReducedMotion(false);
  Check(Draw('Original', 0, true, true) = 0, 'An unfinished animation must not complete.');
  Window.SetReducedMotion(true);
  Check(
    Draw('Original', 0, false, false) = 0 and Callbacks = 0,
    'A cached resize must not invoke the completion factory.'
  );
  Check(
    Draw('Original', 0, true, false) = 1 and Callbacks = 1,
    'The next covered owner frame must deliver completion consumed by a cached resize.'
  );
  Check(
    Draw('Original', 0, true, true) = 0 and Callbacks = 1,
    'A completed revision must notify once.'
  );
  Check(
    Draw('Original', 1, true, true) = 1 and Callbacks = 2,
    'A replay revision must complete independently.'
  );
  Check(
    Draw('Replacement', 1, true, true) = 1 and Callbacks = 3,
    'Replacement text must complete independently.'
  );
  Check(
    Draw('Closing text', 2, false, false) = 0 and Callbacks = 3,
    'Closing painting must not invoke the completion factory.'
  );
end procedure;

end unit;
