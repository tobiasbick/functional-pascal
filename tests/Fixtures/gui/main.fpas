program GuiInterop;

uses Fpas.Ui.Gui.Cui as Cui, System as Sys, System.Console as Console;

procedure Run(Arguments: array of string);
requires Arguments.Length = 3;
begin
  const Software: bool := Arguments[1] = 'software';
  const Renderer: Cui.CuiRenderer := if Software then Cui.CuiRenderer.Software
    else Cui.CuiRenderer.OpenGl
    end if;
  using const Window: Cui.CuiWindow := new Cui.CuiWindow(
    'FPAS GUI probe',
    640,
    480,
    Renderer,
    true
  );
  if Window.IsSoftware <> Software or not Window.NextFrame() then
    raise new Sys.InvalidOperationException('The requested CUI renderer did not present.');
  end if;

  Window.BeginColumn();
  Window.Heading('FPAS GUI');
  discard Window.Button('Continue');
  Window.EndColumn();
  Window.Present();
  Window.CapturePng(Arguments[2]);
  Console.WriteLine('FPAS GUI verified: ' + Arguments[1]);
end procedure;

begin
  Run(Sys.Environment.GetCommandLineArgs());
end;
end program;
