unit NativeTests;

uses Microsoft.VisualStudio.TestTools.UnitTesting as T, System as Sys,
  System.Threading.Tasks as Tasks, System.IO.File as File;

var Active: int := 0;
const Events: string := Sys.Environment.GetEnvironmentVariable('FPAS_TEST_EVENTS') ?? 'events.log';

[T.TestClassAttribute]
public type Tests = record
  [T.TestInitializeAttribute]
  procedure Setup();
  begin Active := 1; File.AppendAllText(Events, 'setup' + #10); end procedure;

  [T.TestCleanupAttribute]
  procedure Cleanup();
  begin Active := 0; File.AppendAllText(Events, 'cleanup' + #10); end procedure;

  [T.TestMethodAttribute]
  procedure SetupWasCalled();
  begin T.Assert.AreEqual<int>(1, Active); Sys.Console.WriteLine('native output'); end procedure;

  [T.TestMethodAttribute]
  [T.DataRowAttribute(1, 2, 3)]
  [T.DataRowAttribute(2, 3, 5)]
  procedure Addition(Left: int; Right: int; Expected: int);
  begin T.Assert.AreEqual<int>(Expected, Left + Right); end procedure;

  [T.TestMethodAttribute]
  async function AsyncTest(): Tasks.Task;
  begin discard await Tasks.Task.FromResult<int>(42); T.Assert.AreEqual<int>(1, Active); end function;

  [T.TestMethodAttribute]
  [T.IgnoreAttribute('deliberate skip')]
  procedure Skipped();
  begin raise new Sys.Exception('must not execute'); end procedure;

  [T.TestMethodAttribute]
  procedure AssertionFailure();
  begin T.Assert.IsTrue(false); end procedure;

  [T.TestMethodAttribute]
  procedure UserException();
  begin raise new Sys.InvalidOperationException('user failure'); end procedure;
end record;
end unit;
