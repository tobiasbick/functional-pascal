// [Documentation](../../coverage.md#native-test-frameworks)

unit NativeTests;

uses NUnit.Framework as N;
uses NUnit.Framework.Legacy as L;
uses System as Sys;
uses System.IO.File as File;
uses System.Threading.Tasks as Tasks;

var Active: int := 0;

const Events: string := Sys.Environment.GetEnvironmentVariable('FPAS_TEST_EVENTS') ?? 'events.log';

// Exercises test discovery, lifecycle and results through the CLR test runner.
[N.TestFixtureAttribute]
[N.NonParallelizableAttribute]
public type Tests = record
  // Records initialization and marks the current test active.
  [N.SetUpAttribute]
  public procedure Setup();
  begin
    Active := 1;
    File.AppendAllText(Events, 'setup' + #10);
  end procedure;

  // Records cleanup and clears the current test's active state.
  [N.TearDownAttribute]
  public procedure Cleanup();
  begin
    Active := 0;
    File.AppendAllText(Events, 'cleanup' + #10);
  end procedure;

  // Checks that the runner completed setup before executing the test.
  [N.TestAttribute]
  public procedure SetupWasCalled();
  begin
    L.ClassicAssert.AreEqual(1, Active);
    Sys.Console.WriteLine('native output');
  end procedure;

  // Checks addition against inline test data.
  //
  // ## Parameters
  // - `Left`: The first addend.
  // - `Right`: The second addend.
  // - `Expected`: The expected sum.
  [N.TestCaseAttribute(1, 2, 3)]
  [N.TestCaseAttribute(2, 3, 5)]
  public procedure Addition(Left: int; Right: int; Expected: int);
  begin
    L.ClassicAssert.AreEqual(Expected, Left + Right);
  end procedure;

  // Checks that asynchronous tests complete while setup is active.
  //
  // ## Returns
  // The task observed by the test runner.
  [N.TestAttribute]
  public async function AsyncTest(): Tasks.Task;
  begin
    discard await Tasks.Task.FromResult of int(42);

    L.ClassicAssert.AreEqual(1, Active);
  end function;

  // Fails if the runner executes this deliberately skipped case.
  [N.TestAttribute]
  [N.IgnoreAttribute('deliberate skip')]
  public procedure Skipped();
  begin
    raise new Sys.Exception('must not execute');
  end procedure;

  // Produces a failing assertion for the runner to report.
  [N.TestAttribute]
  public procedure AssertionFailure();
  begin
    L.ClassicAssert.IsTrue(false);
  end procedure;

  // Throws an exception for the runner to report.
  [N.TestAttribute]
  public procedure UserException();
  begin
    raise new Sys.InvalidOperationException('user failure');
  end procedure;
end record;

end unit;
