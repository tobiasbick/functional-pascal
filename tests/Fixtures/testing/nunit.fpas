unit NativeTests;

uses
  NUnit.Framework as N, NUnit.Framework.Legacy as L, System as Sys,
  System.Threading.Tasks as Tasks, System.IO.File as File;

var Active: int := 0;

const Events: string := Sys.Environment.GetEnvironmentVariable('FPAS_TEST_EVENTS') ?? 'events.log';

[N.TestFixtureAttribute]
[N.NonParallelizableAttribute]
public type Tests = record
  [N.SetUpAttribute]
  procedure Setup();
  begin
    Active := 1;
    File.AppendAllText(Events, 'setup' + #10);
  end procedure;

  [N.TearDownAttribute]
  procedure Cleanup();
  begin
    Active := 0;
    File.AppendAllText(Events, 'cleanup' + #10);
  end procedure;

  [N.TestAttribute]
  procedure SetupWasCalled();
  begin
    L.ClassicAssert.AreEqual(1, Active);
    Sys.Console.WriteLine('native output');
  end procedure;

  [N.TestCaseAttribute(1, 2, 3)]
  [N.TestCaseAttribute(2, 3, 5)]
  procedure Addition(Left: int; Right: int; Expected: int);
  begin
    L.ClassicAssert.AreEqual(Expected, Left + Right);
  end procedure;

  [N.TestAttribute]
  async function AsyncTest(): Tasks.Task;
  begin
    discard await Tasks.Task.FromResult<int>(42);

    L.ClassicAssert.AreEqual(1, Active);
  end function;

  [N.TestAttribute]
  [N.IgnoreAttribute('deliberate skip')]
  procedure Skipped();
  begin
    raise new Sys.Exception('must not execute');
  end procedure;

  [N.TestAttribute]
  procedure AssertionFailure();
  begin
    L.ClassicAssert.IsTrue(false);
  end procedure;

  [N.TestAttribute]
  procedure UserException();
  begin
    raise new Sys.InvalidOperationException('user failure');
  end procedure;
end record;
end unit;
