unit NativeTests;

uses
  Xunit as X, Xunit.Abstractions as A, System as Sys, System.Threading.Tasks as Tasks,
  System.IO.File as File, System.Collections.Generic as C,
  Fpas.Compiler as Compiler, Fpas.Compiler.Formatting as Formatting;

var Active: int := 0;
var FixtureCount: int := 0;

const Events: string := Sys.Environment.GetEnvironmentVariable('FPAS_TEST_EVENTS') ?? 'events.log';

public type Lifetime = record implements X.IAsyncLifetime
  function InitializeAsync(): Tasks.Task;
  begin
    Active := 1;
    File.AppendAllText(Events, 'setup' + #10);
    return Tasks.Task.CompletedTask;
  end function;

  function DisposeAsync(): Tasks.Task;
  begin
    Active := 0;
    File.AppendAllText(Events, 'cleanup' + #10);
    return Tasks.Task.CompletedTask;
  end function;

  [X.FactAttribute]
  procedure SetupWasCalled();
  begin
    X.Assert.Equal<int>(1, Active);
  end procedure;

  [X.TheoryAttribute]
  [X.InlineDataAttribute(1, 2, 3)]
  [X.InlineDataAttribute(2, 3, 5)]
  procedure Addition(Left: int; Right: int; Expected: int);
  begin
    X.Assert.Equal<int>(Expected, Left + Right);
  end procedure;

  [X.FactAttribute]
  async function AsyncTest(): Tasks.Task;
  begin
    discard await Tasks.Task.FromResult<int>(42);

    X.Assert.Equal<int>(1, Active);
  end function;

  [X.FactAttribute(Skip := 'deliberate skip')]
  procedure Skipped();
  begin
    raise new Sys.Exception('must not execute');
  end procedure;

  [X.FactAttribute]
  procedure AssertionFailure();
  begin
    X.Assert.True(false);
  end procedure;

  [X.FactAttribute]
  procedure UserException();
  begin
    raise new Sys.InvalidOperationException('user failure');
  end procedure;
end record;

public type Shared = record implements X.IAsyncLifetime
  function InitializeAsync(): Tasks.Task;
  begin
    FixtureCount := FixtureCount + 1;
    return Tasks.Task.CompletedTask;
  end function;

  function DisposeAsync(): Tasks.Task;
  begin
    File.WriteAllText(Events + '.fixture', 'disposed');
    return Tasks.Task.CompletedTask;
  end function;
end record;

public type FixtureTests = record implements X.IClassFixture<Shared>
  Fixture: Shared;
  Output: A.ITestOutputHelper;

  [X.FactAttribute]
  procedure Injected();
  begin
    X.Assert.NotNull(self.Fixture);
    X.Assert.Equal<int>(1, FixtureCount);

    self.Output.WriteLine('native output');
  end procedure;
end record;

public function Rows(): C.IEnumerable<object[]>;
begin
  const Values: object[][] := [[1, 2, 3], [2, 3, 5]];
  return Values;
end function;

[X.TheoryAttribute]
[X.MemberDataAttribute('Rows')]
public procedure DataProvider(Left: int; Right: int; Expected: int);
begin
  X.Assert.Equal<int>(Expected, Left + Right);
end procedure;

[X.FactAttribute]
public procedure InvalidSourceIsRejected();
begin
  const Result: Formatting.FormatResult := Formatting.FpasFormatter.Format(
    new Compiler.CompilationSource('bad.fpas', 'program Broken; begin return end; end program;')
  );

  X.Assert.False(Result.Success);
end procedure;
end unit;
