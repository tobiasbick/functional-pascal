// [Documentation](../../../docs/ui/tui/host.md)

program CompositionContract;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Ui.Composition as U;
uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as A;
uses Fpas.Ui.Mvu.Composition as M;
uses Fpas.Ui.TerminalExtensions.Input as Keys;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Collections.Tables as Tables;
uses Fpas.Ui.Widgets.Inputs.TextFields as F;
uses Fpas.Ui.Widgets.Navigation.ScrollAnchors as Anchors;
uses Fpas.Ui.Widgets.Navigation.TableOfContents as Toc;
uses Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;
uses Fpas.Ui.Widgets.Overlays.Popovers as Popovers;
uses Fpas.Ui.Widgets.Planning.Kanbans as Kanbans;

uses System as Sys;
uses System.Console as Console;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;

type Payload of TMsg = record implements A.HostExtension of TMsg
  // Message delivered by the test host.
  public Message: TMsg;

  // Translates the host message without delivering it.
  // ## Type parameters
  // - `TNext`: Destination message type.
  // ## Parameters
  // - `Messages`: Message translation.
  // ## Returns
  // The translated test payload.
  public function Map of TNext(Messages: function(TMsg): TNext): A.HostExtension of TNext;
  begin
    return new Payload of TNext(Messages(self.Message));
  end function;
end record;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function Wrap(Value: int): string;
begin
  return 'parent/' + Value.ToString();
end function;

procedure Commands();
  function Work(Post: function(int): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
  begin
    Runs := Runs + 1;
    Check(Token.Equals(Source.Token), 'Mapping changed the cancellation token.');
    if Runs = 2 then
      raise new Sys.InvalidOperationException('failure');
    end if;

    return Post(7);
  end function;
begin
  var Runs: int := 0;
  using const Source: Threads.CancellationTokenSource := new Threads.CancellationTokenSource();
  const Gate: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource();
  const Original: A.Command of int := A.StartBackground of int(
    'save', A.FromWorker of int(
      Work,
      function(Error: Sys.Exception): int => -1
    )
  );
  const Mapped: A.Command of string := M.MapCommand of (int, string)(Original, Wrap, 'left');
  Check(Runs = 0, 'Mapping started an effect eagerly.');
  case Mapped of
    when A.Command.Start(
      const Id: string,
      const Effect: Fx.Effect of (Fx.Completion, string, A.BackgroundContext of string)
    ):
      Check(Id = 'left/save', 'The effect scope was lost.');
      var Delivered: string := '';
      const Context: A.BackgroundContext of string := new A.BackgroundContext of string(
        function(Message: string): Tasks.Task begin
          Delivered := Message;
          return Gate.Task;
        end function,
        Sys.TimeProvider.System
      );
      const Pending: Tasks.Task of Fx.Outcome of (Fx.Completion, string) := Effect.Run(
        Context,
        Source.Token
      );
      Check(
        Runs = 1 and Delivered = 'parent/7', 'Mapping lost delivery.'
      );
      Check(not Pending.IsCompleted, 'Mapping bypassed the pending post.');
      Gate.SetResult();
      case Pending.GetAwaiter().GetResult() of
        when Fx.Outcome.Success(_):
        else
          raise new Sys.InvalidOperationException('Mapping lost completion.');
      end case;

      case Effect.Run(Context, Source.Token).GetAwaiter().GetResult() of
        when Fx.Outcome.Failure(const Message: string):
          Check(Message = 'parent/-1', 'Failure messages were not mapped.');
        else
          raise new Sys.InvalidOperationException('Mapping lost a failure.');
      end case;
    else
      raise new Sys.InvalidOperationException('Mapping changed the command kind.');
  end case;
  const Transition: A.Transition of (int, string) := M.MapTransition of (int, int, string)(
    new A.Transition of (int, int)(
      42, [
        A.CancelBackground of int('save'), A.Focus of int('global-control'),
        (A.Command of int).Host(A.HostRequest.Extension(new Payload of int(9))), A.Exit of int()
      ]
    ), Wrap, 'left'
  );
  Check(
    Transition.Model = 42 and Transition.Commands.Length = 4,
    'Mapping changed the model or command order.'
  );
  case Transition.Commands[0] of
    when A.Command.Cancel(const Id: string):
      Check(Id = 'left/save', 'Cancellation did not use the start scope.');
    else
      raise new Sys.InvalidOperationException('The first command changed.');
  end case;

  case Transition.Commands[1] of
    when A.Command.Host(A.HostRequest.Focus(const Id: string)):
      Check(Id = 'global-control', 'Focus IDs must stay global.');
    else
      raise new Sys.InvalidOperationException('The focus command changed.');
  end case;

  case Transition.Commands[2] of
    when A.Command.Host(A.HostRequest.Extension(const Value: Sys.Object)):
      Check(
        (cast Value as Payload of string).Message = 'parent/9',
        'Generic host payload dispatch lost its message type.'
      );
    else
      raise new Sys.InvalidOperationException('The host extension changed.');
  end case;

  try
    discard M.MapCommand of (int, string)(
      (A.Command of int).Host(A.HostRequest.Extension(new Sys.Object())),
      Wrap
    );
  catch Error: Sys.ArgumentException do
    return;
  end try;

  raise new Sys.InvalidOperationException(
    'An opaque payload was silently forwarded under the wrong message type.'
  );
end procedure;

procedure Callbacks();
begin
  var Submitted: int := 0;
  const Settings: F.Options := new F.Options(Enabled := false);
  const Child: E.Element of int := F.TextField of int(
    'field', 'value', function(Value: string): int => Value.Length,
    Settings, function(Value: string): int begin
      Submitted := Submitted + 1;
      return Value.Length + 1;
    end function
  );
  const Parent: E.Element of string := U.Map of (int, string)(Child, Wrap);
  Check(Submitted = 0, 'Mapping invoked a submit callback eagerly.');
  case Parent of
    when E.Element.TextField(
      const Id: string, const Value: string, const Change: function(string): string,
      const Options: F.Options, const Submit: Sys.Func of (string, string)?
    ):
      Check(
        Id = 'field' and Value = 'value' and Sys.Object.ReferenceEquals(Options, Settings),
        'Mapping changed identity, value or options.'
      );
      Check(Change('abcd') = 'parent/4', 'The editing callback was not translated.');
      case Submit of
        when is Sys.Func of (string, string) as Factory:
          Check(
            Factory.Invoke('abcd') = 'parent/5' and Submitted = 1,
            'The optional callback was invoked incorrectly.'
          );
        else
          raise new Sys.InvalidOperationException('Mapping lost the submit callback.');
      end case;
    else
      raise new Sys.InvalidOperationException('Mapping changed the element kind.');
  end case;
  const Menu: E.Element of string := U.Map of (int, string)(
    Menus.Menu of int(
      'menu', 'Options',
      [
        (Menus.Entry of int).Label('Group'), (Menus.Entry of int).Action(
          new Menus.Item of int(
            'item',
            'Action',
            3,
            Icon := 'i',
            Shortcut := 'Ctrl A',
            Enabled := false,
            Danger := true,
            Checked := true
          )
        ),
        (Menus.Entry of int).Separator
      ]
    ), Wrap
  );
  case Menu of
    when E.Element.Dropdown(_, _, const Entries: array of Menus.Entry of string, _):
      case Entries[1] of
        when Menus.Entry.Action(const Item: Menus.Item of string):
          Check(
            Item.Message = 'parent/3' and Item.Key = 'item' and Item.Icon = 'i'
            and Item.Shortcut = 'Ctrl A' and not Item.Enabled
            and Item.Danger and Item.Checked,
            'A menu action lost its message or decoration.'
          );
        else
          raise new Sys.InvalidOperationException('The menu action changed kind.');
      end case;
    else
      raise new Sys.InvalidOperationException('The menu changed kind.');
  end case;
end procedure;

procedure Cached();
  function Build(Value: int): E.Element of int;
  begin
    Builds := Builds + 1;
    return B.Button of int('cached-action', 'Action', Value);
  end function;
  function Child(Value: int): E.Element of int;
  begin
    return E.CachedSubview of (int, int)(
      'cached',
      Value,
      Build,
      function(Left: int; Right: int): bool => Left = Right
    );
  end function;
begin
  var Builds: int := 0;
  const First: V.Prepared of string := V.Prepare of string(
    U.Map of (int, string)(Child(1), Wrap),
    V.Target.Terminal
  );
  const Second: V.Prepared of string := V.Prepare of string(
    U.Map of (int, string)(Child(1), Wrap),
    V.Target.Terminal,
    First
  );
  Check(
    Builds = 1 and Sys.Object.ReferenceEquals(First.Subviews['cached'], Second.Subviews['cached']),
    'Mapping discarded an unchanged cached child.'
  );
  const Third: V.Prepared of string := V.Prepare of string(
    U.Map of (int, string)(
      Child(1),
      function(Value: int): string => 'other/' + Value.ToString()
    ), V.Target.Terminal, Second
  );
  Check(Builds = 1, 'A new mapper rebuilt the child view.');
  case Third.Subviews['cached'].Tree of
    when E.Element.ButtonAction(_, _, const Message: string, _):
      Check(Message = 'other/1', 'Cached mapping retained a stale mapper.');
    else
      raise new Sys.InvalidOperationException('The cached view changed kind.');
  end case;

  discard V.Prepare of string(U.Map of (int, string)(Child(2), Wrap), V.Target.Terminal, Third);
  Check(Builds = 2, 'Mapping ignored changed child dependencies.');
end procedure;

procedure Outline();
  function TableRow(
    Id: string;
    params Children: array of E.Element of string
  ): Tables.Row of string;
  begin
    return new Tables.Row of string(Id, [(Tables.Cell of string).Content(Children)]);
  end function;
  function Table(params Rows: array of Tables.Row of string): E.Element of string;
  begin
    return Tables.Table of string('table', [new Tables.Column('Section')], Rows);
  end function;
  function Board(params Cards: array of Kanbans.Card of string): E.Element of string;
  begin
    return Kanbans.Kanban of string(
      'board', [new Kanbans.Column of string('Articles', Cards)],
      function(Event: Kanbans.Event): string => 'change'
    );
  end function;
  function Article(): E.Element of string;
  begin
    return E.ScrollView of string(
      'article', E.Column of string(
        Anchors.ScrollAnchor of string('first'),
        Anchors.ScrollAnchor of string('unlisted'),
        Anchors.ScrollAnchor of string('last')
      )
    );
  end function;
  function Reader(Items: array of Toc.Item): E.Element of string;
  begin
    return E.Row of string(Toc.TableOfContents of string('outline', 'article', Items), Article());
  end function;
  procedure RejectOutline(Tree: E.Element of string; Expected: string);
  begin
    try
      discard V.Prepare of string(Tree, V.Target.Graphical);
    catch Error: Sys.ArgumentException do
      Check(Error.Message.Contains(Expected), Error.Message);
      return;
    end try;

    raise new Sys.InvalidOperationException('Validation accepted an invalid outline: ' + Expected);
  end procedure;
begin
  const First: Toc.Item := new Toc.Item('First', 'first');
  const Last: Toc.Item := new Toc.Item('Last', 'last');
  discard V.Prepare of string(Reader([First, Last]), V.Target.Graphical);
  RejectOutline(Reader([Last, First]), 'in document order');
  const Settings: Dialogs.Options := new Dialogs.Options('Reader');
  discard V.Prepare of string(
    Dialogs.Dialog of string(
      'dialog',
      E.Spacer of string(),
      Reader([First, Last]),
      true,
      Settings,
      'close'
    ),
    V.Target.Graphical
  );
  RejectOutline(
    Dialogs.Dialog of string(
      'dialog', Article(), Toc.TableOfContents of string('outline', 'article', [First, Last]),
      true, Settings, 'close'
    ),
    'same CUI scope'
  );
  const Trigger: E.Element of string := B.Button of string('show-outline', 'Outline', 'open');
  RejectOutline(
    E.Row of string(
      Article(), Popovers.Popover of string(
        'popup', Trigger, [Toc.TableOfContents of string('outline', 'article', [First, Last])],
        true, 'close'
      )
    ),
    'same CUI scope'
  );
  const Index: E.Element of string := Toc.TableOfContents of string(
    'outline',
    'article',
    [First, Last]
  );
  discard V.Prepare of string(Table(TableRow('row', Reader([First, Last]))), V.Target.Graphical);
  discard V.Prepare of string(
    E.Row of string(
      Index, E.ScrollView of string(
        'article', Table(
          TableRow('first-row', Anchors.ScrollAnchor of string('first')),
          TableRow('last-row', Anchors.ScrollAnchor of string('last'))
        )
      )
    ),
    V.Target.Graphical
  );
  RejectOutline(Table(TableRow('a', Index), TableRow('b', Article())), 'same CUI scope');
  RejectOutline(E.Row of string(Index, Table(TableRow('row', Article()))), 'same CUI scope');
  discard V.Prepare of string(
    Board(new Kanbans.Card of string(1, 'Reader', Reader([First, Last]))),
    V.Target.Graphical
  );
  RejectOutline(
    Board(
      new Kanbans.Card of string(1, 'Outline', Index),
      new Kanbans.Card of string(2, 'Article', Article())
    ),
    'same CUI scope'
  );
end procedure;

begin
  Commands();
  Callbacks();
  Cached();
  Outline();
  Console.WriteLine('Composition contracts verified');
end;

end program;
