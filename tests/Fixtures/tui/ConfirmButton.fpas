program ConfirmButtonContract;

uses
  Fpas.Ui.ConfirmButtons as Confirm, Fpas.Ui.Buttons as Buttons, Fpas.Ui.Styles as Styles,
  Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Validation as V, Fpas.Ui.Sheets as Sheets,
  Fpas.Ui.Tui.Internal.Widgets.ConfirmButton as Tracking,
  Fpas.Ui.Tui.Application as Tui, Fpas.Ui.TerminalExtensions.Input as Keys,
  Fpas.Ui.Mvu.Application as Mvu, System as Sys, System.Console as Console,
  System.Diagnostics as Diagnostics, System.Threading as Threads;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

procedure ClockContract();
begin
  var Now: long := 100L;
  const State: Tracking.State := Tracking.Create(function(): long => Now);
  Check(not State.Activate('delete', 3000), 'First activation sends no message.');
  Check(State.Remaining('delete') = 3, 'Default countdown starts at three seconds.');
  Now := 1099L;
  Check(not State.Refresh() and State.Remaining('delete') = 3, 'No redundant countdown redraw.');
  Now := 1100L;
  Check(State.Refresh() and State.Remaining('delete') = 2, 'Countdown changes after a second.');
  Now := 3099L;
  Check(State.Remaining('delete') = 1, 'Last millisecond remains confirmable.');
  Now := 3100L;
  Check(State.Refresh() and State.Ids().Length = 0, 'Exact deadline disarms and retires state.');
  Check(not State.Activate('delete', 100), 'Expired activation starts a new window.');
  Now := 3199L;
  Check(
    State.Activate('delete', 100) and State.Ids().Length = 0,
    'Second activation confirms once.'
  );
  Check(not State.Activate('delete', 100), 'A further activation starts a fresh confirmation.');
  Check(not State.Activate('other', 100), 'Different controls have independent windows.');
  Check(State.Cancel('delete') and not State.Cancel('delete'), 'Cancellation is idempotent.');
  State.Configure('other', 100, false);
  Check(State.Ids().Length = 0, 'Disabled controls cannot retain confirmation.');
  const Other: Tracking.State := Tracking.Create(function(): long => Now);
  discard State.Activate('delete', 100);
  Check(Other.Remaining('delete') = 0, 'Sessions do not share state.');
  Now := 3299L;
  Check(not State.Activate('delete', 100), 'A delayed second activation must only rearm.');
end procedure;

procedure ValidationContract();
begin
  for Target: V.Target in [V.Target.Terminal, V.Target.Graphical] do
    discard V.Prepare<int>(Confirm.ConfirmButton<int>('valid', 'Delete', 1), Target);
    for Kind: int := 0 to 4 do
      const Settings: Confirm.Options := case Kind of
        when 0: new Confirm.Options(TimeoutMilliseconds := 0);
        when 1: new Confirm.Options(TimeoutMilliseconds := -1);
        when 2: new Confirm.Options(Variant := Styles.ButtonVariant.Active);
        when 3: new Confirm.Options(ControlSize := cast<Buttons.Size>(99));
        else new Confirm.Options(ConfirmLabel := 'Invalid' + #0);
      end case;
      var Rejected: bool := false;
      try
        discard V.Prepare<int>(Confirm.ConfirmButton<int>('bad', 'Delete', 1, Settings), Target);
      catch Error: Sys.ArgumentException do
        Rejected := true;
      end try;

      Check(Rejected, 'Invalid confirmation options must fail preflight.');
    end for;
  end for;
end procedure;

type Model = record
  // Confirmed actions.
  public Count: int := 0;
  // Whether the main confirmation accepts input.
  public Enabled: bool := true;
  // Whether the main confirmation is in the view.
  public Visible: bool := true;
  // Whether a modal covers the main confirmation.
  public Modal: bool := false;
  // Whether the resting caption has changed.
  public Renamed: bool := false;
end record;

function Update(State: Model; Message: int): Mvu.Transition<Model, int>;
begin
  const Next: Model := case Message of
    when 1: State with
      Count := State.Count + 1;
    end with;
    when 2: State with
      Enabled := not State.Enabled;
    end with;
    when 3: State with
      Visible := not State.Visible;
    end with;
    when 4: State with
      Modal := not State.Modal;
    end with;
    when 5: State with
      Renamed := not State.Renamed;
    end with;
    else State;
  end case;
  return new Mvu.Transition<Model, int>(Next, []);
end function;

function View(State: Model): E.Element<int>;
begin
  const Body: E.Element<int> := E.Column<int>(
    if State.Visible then
      Confirm.ConfirmButton<int>(
        'delete',
        if State.Renamed then
          'Renamed ### literally'
        else
          'Delete ## literally'
        end if,
        1,
        new Confirm.Options(ConfirmLabel := 'Confirm ## literally', Enabled := State.Enabled)
      )
    else
      E.Text<int>('Hidden')
    end if,
    Buttons.Button<int>('other', 'Other', 0),
    Buttons.Button<int>('enabled', 'Toggle enabled', 2),
    Buttons.Button<int>('visible', 'Toggle visible', 3),
    Buttons.Button<int>('modal', 'Toggle modal', 4),
    Buttons.Button<int>('rename', 'Rename', 5),
    E.Text<int>('Count: ' + State.Count.ToString())
  );
  return Sheets.Sheet<int>(
    'confirmation', Body, Confirm.ConfirmButton<int>('inside', 'Inside', 1),
    State.Modal, new Sheets.Options('Confirmation', InitialFocus := 'inside'), 4
  );
end function;

function Control(Session: Tui.HeadlessSession; Id: string): Tui.ControlSnapshot;
begin
  for Item: Tui.ControlSnapshot in Session.Snapshot().Controls do
    if Item.Id = Id then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing control: ' + Id);
end function;

procedure Send(Session: Tui.HeadlessSession; Input: Tui.Input);
begin
  discard Session.Send(Input);
  case Session.Step() of
    when Tui.StepResult.Failed(_, _, _, const Reason: string):
      raise new Sys.InvalidOperationException(Reason);
    else
  end case;
end procedure;

function CountIs(Session: Tui.HeadlessSession; Value: int): bool;
begin
  for Line: string in Session.Snapshot().Lines do
    if Line.Contains('Count: ' + Value.ToString()) then
      return true;
    end if;
  end for;

  return false;
end function;

procedure SessionContract();
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<Model, int>(
    new Model(),
    Update,
    View,
    60,
    14
  );
  Check(Control(Session, 'delete').Focused, 'Initial focus finds confirmation.');
  Send(Session, Tui.Input.KeyPress(Keys.Key.Enter, Keys.KeyModifiers.None));
  Check(
    Control(Session, 'delete').Value = 'armed' and CountIs(Session, 0),
    'First Enter only arms.'
  );
  Check(
    Session.Snapshot().Lines[0].Contains('Confirm ## literally (3s)'),
    'Countdown uses literal text.'
  );
  Send(Session, Tui.Input.Paste(' '));
  Check(Control(Session, 'delete').Value = 'armed', 'Pasted space is not an activation.');
  Send(Session, Tui.Input.Character(' '));
  Check(Control(Session, 'delete').Value = '' and CountIs(Session, 1), 'Space confirms once.');
  Send(Session, Tui.Input.Activate('delete'));
  Send(Session, Tui.Input.KeyPress(Keys.Key.Escape, Keys.KeyModifiers.None));
  Check(
    Control(Session, 'delete').Value = '' and CountIs(Session, 1),
    'Escape cancels without a message.'
  );

  Send(Session, Tui.Input.Activate('delete'));
  Send(Session, Tui.Input.Focus('other'));
  Check(
    Control(Session, 'delete').Value = 'armed',
    'Changing keyboard focus alone preserves confirmation.'
  );
  Send(Session, Tui.Input.Focus('delete'));
  Send(Session, Tui.Input.Activate('rename'));
  Check(
    Control(Session, 'delete').Value = 'armed' and Control(Session, 'delete').Focused,
    'Changing the resting caption keeps confirmation and focus.'
  );
  Send(Session, Tui.Input.Pointer(Keys.PointerKind.Press, 59, 13));
  Send(Session, Tui.Input.Pointer(Keys.PointerKind.Release, 59, 13));
  Check(Control(Session, 'delete').Value = '', 'An outside press disarms.');
  const First: Tui.ControlSnapshot := Control(Session, 'delete');
  Send(Session, Tui.Input.Click(First.Column + 1, First.Row));
  const Second: Tui.ControlSnapshot := Control(Session, 'delete');
  Check(Second.Value = 'armed' and Second.Focused, 'Mouse click arms without losing focus.');
  Send(Session, Tui.Input.Click(Second.Column + 1, Second.Row));
  Check(CountIs(Session, 2), 'A second mouse click confirms.');

  Send(Session, Tui.Input.Activate('delete'));
  Send(Session, Tui.Input.Activate('enabled'));
  Send(Session, Tui.Input.Activate('delete'));
  Check(
    not Control(
      Session,
      'delete'
    ).Enabled and Control(Session, 'delete').Value = '' and CountIs(Session, 2),
    'Disabling cancels and rejects activation.'
  );
  Send(Session, Tui.Input.Activate('enabled'));
  Send(Session, Tui.Input.Activate('delete'));
  Check(Control(Session, 'delete').Value = 'armed', 'Re-enabling requires two fresh activations.');
  Send(Session, Tui.Input.Activate('visible'));
  Send(Session, Tui.Input.Activate('visible'));
  Check(
    Control(Session, 'delete').Value = '',
    'Removing and restoring an ID does not restore confirmation.'
  );
  Send(Session, Tui.Input.Activate('delete'));
  Send(Session, Tui.Input.Activate('modal'));
  Check(Control(Session, 'delete').Value = '', 'A modal cancels underlying confirmation.');
  Send(Session, Tui.Input.KeyPress(Keys.Key.Enter, Keys.KeyModifiers.None));
  Check(Control(Session, 'inside').Value = 'armed', 'Modal confirmation receives focus.');
  Send(Session, Tui.Input.KeyPress(Keys.Key.Escape, Keys.KeyModifiers.None));
  Check(Control(Session, 'inside').Value = '', 'Escape cancels before dismissing a parent modal.');
  Send(Session, Tui.Input.KeyPress(Keys.Key.Escape, Keys.KeyModifiers.None));
  Check(CountIs(Session, 2), 'Cancellation and focus changes must not dispatch confirmation.');
end procedure;

procedure IdleExpiry();
  function TimerView(State: int): E.Element<int>;
  begin
    return Confirm.ConfirmButton<int>(
      'timer',
      'Delete',
      1,
      new Confirm.Options(TimeoutMilliseconds := 300)
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(
    0,
    function(State: int; Message: int): Mvu.Transition<int, int> => new Mvu.Transition<int, int>(
      State + Message,
      []
    ),
    TimerView,
    40,
    4
  );
  Send(Session, Tui.Input.Activate('timer'));
  const Armed: long := Session.Snapshot().Id;
  const Deadline: Diagnostics.Stopwatch := Diagnostics.Stopwatch.StartNew();
  while Control(Session, 'timer').Value <> '' and Deadline.ElapsedMilliseconds < 5000L do
    discard Session.Step();
    Threads.Thread.Sleep(10);
  end while;

  Check(
    Control(Session, 'timer').Value = '' and Session.Snapshot().Id > Armed,
    'Timeout must publish a disarmed frame without another input.'
  );
end procedure;

begin
  ClockContract();
  ValidationContract();
  SessionContract();
  IdleExpiry();
  Console.WriteLine('Confirm button contracts verified');
end;
end program;
