// [Documentation](../../coverage.md#terminal-ui)

program CuiContract;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Styles as Styles;
uses Fpas.Ui.TerminalExtensions.Input as Keys;
uses Fpas.Ui.Tui.Application as Tui;
uses Fpas.Ui.Tui.Headless as Headless;
uses Fpas.Ui.Tui.Internal.Layout.Flexible as F;
uses Fpas.Ui.Tui.Internal.View.Tree as Tree;
uses Fpas.Ui.Validation as V;
uses Fpas.Ui.Widgets.Actions.ButtonGroups as Groups;
uses Fpas.Ui.Widgets.Actions.Buttons as B;
uses Fpas.Ui.Widgets.Actions.ConfirmButtons as Confirm;
uses Fpas.Ui.Widgets.Actions.CopyButtons as Copy;
uses Fpas.Ui.Widgets.Actions.HoldButtons as Hold;
uses Fpas.Ui.Widgets.Actions.IconButtons as Icon;
uses Fpas.Ui.Widgets.Actions.SegmentedControls as Segments;
uses Fpas.Ui.Widgets.Actions.SplitButtons as Split;
uses Fpas.Ui.Widgets.Actions.StatusButtons as Status;
uses Fpas.Ui.Widgets.Actions.ToggleGroups as ToggleGroups;
uses Fpas.Ui.Widgets.Developer.Terminal as Terminal;
uses Fpas.Ui.Widgets.Overlays.Menus as Menus;
uses Fpas.Ui.Widgets.Overlays.Sheets as Sheets;
uses Fpas.Ui.Widgets.Theming.ThemeSwitchers as Switchers;
uses Fpas.Ui.Widgets.Theming.ThemeToggles as Toggles;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses System as Sys;
uses System.Console as Console;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

procedure Sizes(
  Preferred: array of int;
  Rules: array of Tree.Flex;
  Available: int;
  Expected: array of int
);
begin
  const Actual: array of int := F.Allocate(Preferred, Rules, Available);
  Check(Actual.Length = Expected.Length, 'Allocation length.');
  for Index: int := 0 to Actual.Length - 1 do
    Check(
      Actual[Index] = Expected[Index],
      'Allocation at ' + Index.ToString() + ': ' + Actual[Index].ToString()
    );
  end for;
end procedure;

procedure Allocation();
begin
  Sizes([100, 100], [new Tree.Flex(Grow := 1), new Tree.Flex(Grow := 3)], 400, [100, 300]);
  Sizes(
    [100, 100],
    [new Tree.Flex(Grow := 1, Maximum := 80), new Tree.Flex(Grow := 3)],
    400,
    [80, 320]
  );
  Sizes([300, 300], [new Tree.Flex(Basis := 300), new Tree.Flex(Basis := 300)], 400, [300, 300]);
  Sizes([100, 100], [new Tree.Flex(Basis := 100), new Tree.Flex(Grow := 3)], 400, [100, 300]);
  Sizes([300, 100], [new Tree.Flex(Minimum := 100), new Tree.Flex()], 200, [167, 33]);
  Sizes(
    [1, 1, 1],
    [new Tree.Flex(Grow := 1), new Tree.Flex(Grow := 1), new Tree.Flex(Grow := 1)],
    10,
    [3, 4, 3]
  );
  Sizes(
    [1, 1],
    [new Tree.Flex(Grow := 1, Minimum := 7), new Tree.Flex(Grow := 1, Minimum := 7)],
    10,
    [7, 7]
  );
  Sizes(
    [1, 1],
    [new Tree.Flex(Grow := int.MaxValue), new Tree.Flex(Grow := int.MaxValue)],
    7,
    [4, 3]
  );
end procedure;

function Update(State: int; Message: int): Mvu.Transition of (int, int);
begin
  return new Mvu.Transition of (int, int)(Message, []);
end function;

procedure SemanticColors();
  function View(State: int): E.Element of int;
  begin
    return E.Styled of int(
      E.Column of int(
        E.Styled of int(E.Text of int('x'), Styles.Role.Primary),
        E.Styled of int(E.Text of int('y'), Styles.Role.Default)
      ), Styles.Role.Panel
    );
  end function;
begin
  const Base: Themes.Theme := Themes.Dark(Themes.Accent.Green);
  const Theme: Themes.Theme := Base with
    Colors := Base.Colors with
      Background := new G.Color($10, $20, $30);
      Surface := new G.Color($40, $50, $60);
      Foreground := new G.Color($D0, $E0, $F0);
      Accent := new G.Color(255, 0, 0, 128);
    end with;
  end with;
  using const Session: Tui.HeadlessSession := Headless.Start of (int, int)(
    0,
    Update,
    View,
    8,
    2,
    Theme
  );
  const Frame: Tui.Frame := Session.Snapshot();
  Check(
    Frame.Cells[0].Colors.Foreground = $A02830 and Frame.Cells[0].Colors.Background = $405060,
    'A semantic foreground must composite over its enclosing surface.'
  );
  Check(
    Frame.Cells[8].Colors.Foreground = $D0E0F0 and Frame.Cells[8].Colors.Background = $405060,
    'Default style must inherit its enclosing surface.'
  );
end procedure;

procedure LogicalDistances();
  function View(State: int): E.Element of int;
  begin
    return E.Column of int(
      new L.Flow(
        Gap := L.Spacing.Fixed(L.Measure.Logical(16)),
        Padding := L.Spacing.Fixed(L.Measure.Logical(16))
      ),
      E.Size of int(
        B.Button of int('a', 'A', 1),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(32)))
      ),
      E.Size of int(
        B.Button of int('b', 'B', 2),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(16)))
      )
    );
  end function;
begin
  discard V.Prepare of int(View(0), V.Target.Portable);
  using const Session: Tui.HeadlessSession := Headless.Start of (int, int)(0, Update, View, 12, 10);
  const Controls: array of Tui.ControlSnapshot := Session.Snapshot().Controls;
  Check(
    Controls[0].Column = 2 and Controls[0].Row = 1 and Controls[0].Height = 2,
    'Logical padding and vertical fixed size.'
  );
  Check(
    Controls[1].Column = 2 and Controls[1].Row = 4 and Controls[1].Height = 1,
    'Logical main-axis gap.'
  );
  var Rejected: bool := false;
  try
    discard V.Prepare of int(
      E.Size of int(
        E.Text of int('x'),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(32)), Grow := 1)
      ), V.Target.Portable
    );
  catch Error: Sys.ArgumentException do
    Rejected := Error.Message.Contains('Fixed and percentage extents cannot grow');
  end try;

  Check(Rejected, 'Fixed and growing sizes must not be combined.');
end procedure;

procedure SheetPlacement();
begin
  for Side: Sheets.Side in Sys.Enum.GetValues of Sheets.Side() do
    const View: function(int): E.Element of int := function(State: int): E.Element of int => Sheets.Sheet of int(
      'sheet', B.Button of int('under', 'Background', 5),
      E.Column of int(B.Button of int('inside', 'Body', 2), E.Text of int('Last line')),
      State = 0, new Sheets.Options(
        'Header', Description := 'Detail', Edge := Side,
        Size := 64, InitialFocus := 'inside'
      ), 1
    );
    using const Session: Tui.HeadlessSession := Headless.Start of (int, int)(
      0,
      Update,
      View,
      32,
      12
    );
    const Frame: Tui.Frame := Session.Snapshot();
    const Close: Tui.ControlSnapshot := Frame.Controls[1];
    const Column: int := if Side = Sheets.Side.Left then
      7
    else
      29
    end if;
    const Row: int := if Side = Sheets.Side.Bottom then
      7
    else
      1
    end if;
    Check(
      Close.Id = Sheets.CloseId('sheet') and Close.Column = Column and Close.Row = Row,
      'Wrong sheet placement: ' + Side.ToString()
    );
    Check(
      not Frame.Controls[0].Enabled and Frame.Controls[2].Focused,
      'The sheet must honor initial focus and block base input.'
    );
    Check(
      Frame.Lines[Row].Contains('Head') and Frame.Lines[0].Contains('Background'),
      'The pinned header or background was lost.'
    );
    if Side = Sheets.Side.Top or Side = Sheets.Side.Bottom then
      discard Session.Send(Tui.Input.KeyPress(Keys.Key.PageDown, Keys.KeyModifiers.None));
      discard Session.Step();
      const Scrolled: Tui.Frame := Session.Snapshot();
      Check(
        Scrolled.Lines[Row].Contains('Header') and Scrolled.Lines[Row + 2].Contains('Last line'),
        'Scrolling moved the pinned header or lost the final body row.'
      );
    end if;
  end for;
end procedure;

procedure SheetFocus();
  function View(State: int): E.Element of int;
  begin
    const First: E.Element of int := Sheets.Sheet of int(
      'first',
      E.Column of int(B.Button of int('other', 'Other', 0), B.Button of int('open', 'Open', 1)),
      E.Column of int(
        B.Button of int('inside-first', 'Replace', 2),
        B.Button of int('nest', 'Nest', 3)
      ),
      State = 1 or State = 3,
      new Sheets.Options('First', InitialFocus := 'inside-first'),
      0
    );
    return Sheets.Sheet of int(
      'second', First, B.Button of int('inside-second', 'Remove first', 2), State = 2 or State = 3,
      new Sheets.Options('Second', InitialFocus := 'inside-second'), if State = 3 then
        1
      else
        0
      end if
    );
  end function;
  procedure Send(Session: Tui.HeadlessSession; Event: Tui.Input; Expected: string);
  begin
    discard Session.Send(Event);
    discard Session.Step();
    for Control: Tui.ControlSnapshot in Session.Snapshot().Controls do
      if Control.Id = Expected and Control.Focused then
        return;
      end if;
    end for;

    raise new Sys.InvalidOperationException('Expected sheet focus on ' + Expected + '.');
  end procedure;
begin
  using const Session: Tui.HeadlessSession := Headless.Start of (int, int)(0, Update, View, 64, 16);
  const Escape: Tui.Input := Tui.Input.KeyPress(Keys.Key.Escape, Keys.KeyModifiers.None);
  Send(Session, Tui.Input.Focus('open'), 'open');
  Send(Session, Tui.Input.Activate('open'), 'inside-first');
  Send(Session, Tui.Input.Activate('inside-first'), 'inside-second');
  Send(Session, Escape, 'open');

  Send(Session, Tui.Input.Activate('open'), 'inside-first');
  Send(Session, Tui.Input.Focus('nest'), 'nest');
  Send(Session, Tui.Input.Activate('nest'), 'inside-second');
  Send(Session, Escape, 'nest');
  Send(Session, Tui.Input.Activate('nest'), 'inside-second');
  Send(Session, Tui.Input.Activate('inside-second'), 'inside-second');
  Send(Session, Escape, 'open');
end procedure;

procedure ButtonAction();
  function View(State: int): E.Element of int;
  begin
    return E.Column of int(
      B.Button of int('ready', 'Finish loading', 1),
      B.Button of int(
        'save', if State = 0 then
          'Saving ## literal'
        else
          'Save'
        end if, 2,
        new B.Options(
          Loading := State = 0,
          Enabled := State < 2,
          Selected := true,
          TerminalIcon := '✓',
          TerminalIconRight := '→',
          Tooltip := 'Save changes',
          Shortcut := 'Ctrl S',
          Width := L.Extent.Fixed(L.Measure.Logical(192)),
          Color := new G.Color(40, 150, 100)
        )
      ),
      B.Button of int('full', 'Full', 3, new B.Options(Width := L.Extent.Fill)),
      E.Row of int(
        B.Button of int(
          'fixed',
          'Fixed',
          3,
          new B.Options(Width := L.Extent.Fixed(L.Measure.Logical(80)))
        ),
        B.Button of int('fill-row', 'Fill', 3, new B.Options(Width := L.Extent.Fill))
      ),
      B.Button of int('large', 'Large', 3, new B.Options(ControlSize := B.Size.Large)),
      B.Button of int(
        'transparent',
        'Hidden label',
        3,
        new B.Options(Color := new G.Color(0, 0, 0, 0))
      )
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Headless.Start of (int, int)(
    0, Update, View, 40, 12, ThemeFor := function(State: int): Themes.Theme => Themes.Dark()
  );
  discard Session.Send(Tui.Input.Focus('save'));
  discard Session.Step();
  discard Session.Send(Tui.Input.KeyPress(Keys.Key.Enter, Keys.KeyModifiers.None));
  discard Session.Step();
  const Frame: Tui.Frame := Session.Snapshot();
  const Busy: Tui.ControlSnapshot := Frame.Controls[1];
  Check(
    Busy.Value = 'loading' and Busy.Focused,
    'A busy button must keep focus and suppress Enter.'
  );
  Check(
    Busy.Label = 'Saving ## literal' and Busy.Width = 24,
    'Literal label or fixed logical width.'
  );
  Check(
    Frame.Lines[Busy.Row].Contains('… Saving ## literal →'),
    'Loading must retain the label and trailing icon.'
  );
  Check(
    Frame.Cells[Busy.Row * 40 + Busy.Column].Colors.Foreground = $289664,
    'Custom color was lost on focus.'
  );
  Check(
    Frame.Controls[2].Width = 40 and Frame.Controls[3].Width = 10 and Frame.Controls[4].Width = 30,
    'Fixed and full button widths must apply to the horizontal axis in rows and columns.'
  );
  Check(Frame.Controls[5].Height = 2, 'Large terminal button height.');
  const Hidden: Tui.ControlSnapshot := Frame.Controls[6];
  const HiddenColors: Terminal.Style := Frame.Cells[Hidden.Row * 40 + Hidden.Column].Colors;
  Check(
    HiddenColors.Foreground = HiddenColors.Background,
    'Transparent foreground must blend into the button face.'
  );
  discard Session.Send(Tui.Input.Pointer(Keys.PointerKind.Move, Busy.Column, Busy.Row));
  discard Session.Step();
  Check(
    Session.Snapshot().Lines[11].Contains('Save changes · Ctrl S'),
    'Button tooltip and shortcut hint.'
  );
  discard Session.Send(Tui.Input.KeyPress(Keys.Key.S, Keys.KeyModifiers.Ctrl));
  discard Session.Step();
  Check(Session.Snapshot().Controls[1].Value = 'loading', 'A shortcut hint must not bind the key.');
  discard Session.Send(Tui.Input.Activate('ready'));
  discard Session.Step();
  discard Session.Send(Tui.Input.Focus('save'));
  discard Session.Step();
  discard Session.Send(Tui.Input.Character(' '));
  discard Session.Step();
  Check(not Session.Snapshot().Controls[1].Enabled, 'Space must activate the ready button.');
  discard Session.Send(Tui.Input.Activate('save'));
  discard Session.Step();
  Check(not Session.Snapshot().Controls[1].Enabled, 'Disabled buttons must suppress activation.');
end procedure;

procedure ChoiceStripSizing();
  function View(State: int): E.Element of int;
  begin
    return Segments.SegmentedControl of int(
      'fill', [new Segments.Item('One'), new Segments.Item('Longer label')], State,
      function(Choice: int): int => Choice,
      new Segments.Options(ControlSize := B.Size.Large, FullWidth := true)
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Headless.Start of (int, int)(0, Update, View, 41, 8);
  const Frame: Tui.Frame := Session.Snapshot();
  const First: Tui.ControlSnapshot := Frame.Controls[0];
  const Second: Tui.ControlSnapshot := Frame.Controls[1];
  Check(
    First.Width = 20 and Second.Width = 20 and Second.Column + Second.Width = 41,
    'Full-width segments must split the row evenly.'
  );
  Check(First.Height = 2 and Second.Height = 2, 'Large segments must occupy two rows.');
end procedure;

procedure WidgetProfiles();
  procedure Rejects(Node: E.Element of int; Profile: V.Target; Reason: string);
  begin
    try
      discard V.Prepare of int(Node, Profile);
    catch Error: Sys.ArgumentException do
      Check(Error.Message.Contains(Reason), Error.Message);
      return;
    end try;

    raise new Sys.InvalidOperationException(
      'Preflight accepted a widget outside its supported profiles.'
    );
  end procedure;
begin
  const Widgets: array of E.Element of int := [
    E.Divider of int(), Icon.IconButton of int('icon', 'i', 'Inspect', 1),
    Copy.CopyButton of int('copy', 'text'), Hold.HoldButton of int('hold', 'Hold', 1),
    Confirm.ConfirmButton of int('confirm', 'Confirm', 1),
    Status.StatusButton of int('status', 'Save', Status.Status.Idle, 1),
    Groups.ButtonGroup of int(B.Button of int('action', 'Run', 1)),
    Split.SplitButton of int('split', 'Run', 1, [new Split.Item of int('other', 'Other', 2)]),
    Menus.ContextMenu of int(
      'context',
      B.Button of int('context-target', 'Project', 1),
      [(Menus.Entry of int).Action(new Menus.Item of int('open', 'Open', 1))]
    ),
    Toggles.ThemeToggle of int('toggle', Themes.Mode.Dark, function(Mode: Themes.Mode): int => 1),
    ToggleGroups.ToggleGroup of int(
      'flags',
      [new ToggleGroups.Item('One')],
      [true],
      function(Flags: array of bool): int => Flags.Length
    ),
    Switchers.ThemeSwitcher of int(
      'theme', Switchers.Selection.Light,
      function(Choice: Switchers.Selection): int => 1
    )
  ];
  for Node: E.Element of int in Widgets do
    discard V.Prepare of int(Node, V.Target.Graphical);
    Rejects(Node, V.Target.Terminal, 'Graphical');
    Rejects(Node, V.Target.Portable, 'Graphical');
  end for;

  const Choice: E.Element of int := Segments.SegmentedControl of int(
    'choice',
    [new Segments.Item('One')],
    0,
    function(N: int): int => N
  );
  discard V.Prepare of int(Choice, V.Target.Graphical);
  discard V.Prepare of int(Choice, V.Target.Terminal);
  Rejects(Choice, V.Target.Portable, 'terminal or graphical profile');
end procedure;

begin
  WidgetProfiles();
  ChoiceStripSizing();
  Allocation();
  SemanticColors();
  LogicalDistances();
  SheetPlacement();
  SheetFocus();
  ButtonAction();
  Console.WriteLine('CUI terminal contracts verified');
end;

end program;
