program CuiContract;

uses Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Themes as Themes, Fpas.Ui.Graphics as G, Fpas.Ui.Terminal as Terminal, Fpas.Ui.Styles as Styles, Fpas.Ui.Validation as V, Fpas.Ui.Sheets as Sheets, Fpas.Ui.Buttons as B, Fpas.Ui.ButtonGroups as Groups, Fpas.Ui.IconButtons as Icons, Fpas.Ui.TerminalExtensions.Input as Keys, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Tui.Application as Tui, Fpas.Ui.CopyButtons as Copy, Fpas.Ui.Tui.Internal.Hosting.Session as Host, Fpas.Ui.Tui.Internal.Terminal.Clipboard as Clipboard, Fpas.Ui.Tui.Internal.View.Tree as Tree, Fpas.Ui.Tui.Internal.Layout.Flexible as F, System as Sys, System.Console as Console, System.Threading as Threads, System.Collections.Generic as Generic;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

procedure Sizes(Preferred: array of int; Rules: array of Tree.Flex; Available: int; Expected: array of int);
begin
  const Actual: array of int := F.Allocate(Preferred, Rules, Available);
  Check(Actual.Length = Expected.Length, 'Allocation length.');
  for Index: int := 0 to Actual.Length - 1 do
    Check(
      Actual[Index] = Expected[Index],
      'Allocation at ' + Index.ToString() + ': ' + Actual[Index].ToString()
    );
  end for;
end procedure;

procedure Allocation();
begin
  Sizes([100, 100], [new Tree.Flex(Grow := 1), new Tree.Flex(Grow := 3)], 400, [100, 300]);
  Sizes(
    [100, 100],
    [new Tree.Flex(Grow := 1, Maximum := 80), new Tree.Flex(Grow := 3)],
    400,
    [80, 320]
  );
  Sizes([300, 300], [new Tree.Flex(Basis := 300), new Tree.Flex(Basis := 300)], 400, [300, 300]);
  Sizes([100, 100], [new Tree.Flex(Basis := 100), new Tree.Flex(Grow := 3)], 400, [100, 300]);
  Sizes([300, 100], [new Tree.Flex(Minimum := 100), new Tree.Flex()], 200, [167, 33]);
  Sizes(
    [1, 1, 1],
    [new Tree.Flex(Grow := 1), new Tree.Flex(Grow := 1), new Tree.Flex(Grow := 1)],
    10,
    [3, 4, 3]
  );
  Sizes(
    [1, 1],
    [new Tree.Flex(Grow := 1, Minimum := 7), new Tree.Flex(Grow := 1, Minimum := 7)],
    10,
    [7, 7]
  );
  Sizes(
    [1, 1],
    [new Tree.Flex(Grow := int.MaxValue), new Tree.Flex(Grow := int.MaxValue)],
    7,
    [4, 3]
  );
end procedure;

function Update(State: int; Message: int): Mvu.Transition<int, int>;
begin
  return new Mvu.Transition<int, int>(Message, []);
end function;

procedure SemanticColors();
  function View(State: int): E.Element<int>;
  begin
    return E.Styled<int>(
      E.Column<int>(
        E.Styled<int>(E.Text<int>('x'), Styles.Role.Primary),
        E.Styled<int>(E.Text<int>('y'), Styles.Role.Default)
      ), Styles.Role.Panel
    );
  end function;
begin
  const Base: Themes.Theme := Themes.Dark(Themes.Accent.Green);
  const Theme: Themes.Theme := Base with
    Colors := Base.Colors with
      Background := new G.Color($10, $20, $30);
      Surface := new G.Color($40, $50, $60);
      Foreground := new G.Color($D0, $E0, $F0);
      Accent := new G.Color(255, 0, 0, 128);
    end with;
  end with;
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(
    0,
    Update,
    View,
    8,
    2,
    Theme
  );
  const Frame: Tui.Frame := Session.Snapshot();
  Check(
    Frame.Cells[0].Colors.Foreground = $A02830 and Frame.Cells[0].Colors.Background = $405060,
    'A semantic foreground must composite over its enclosing surface.'
  );
  Check(
    Frame.Cells[8].Colors.Foreground = $D0E0F0 and Frame.Cells[8].Colors.Background = $405060,
    'Default style must inherit its enclosing surface.'
  );
end procedure;

procedure LogicalDistances();
  function View(State: int): E.Element<int>;
  begin
    return E.Column<int>(
      new L.Flow(
        Gap := L.Spacing.Fixed(L.Measure.Logical(16)),
        Padding := L.Spacing.Fixed(L.Measure.Logical(16))
      ),
      E.Size<int>(
        B.Button<int>('a', 'A', 1),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(32)))
      ),
      E.Size<int>(
        B.Button<int>('b', 'B', 2),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(16)))
      )
    );
  end function;
begin
  discard V.Prepare<int>(View(0), V.Target.Portable);
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 12, 10);
  const Controls: array of Tui.ControlSnapshot := Session.Snapshot().Controls;
  Check(
    Controls[0].Column = 2 and Controls[0].Row = 1 and Controls[0].Height = 2,
    'Logical padding and vertical fixed size.'
  );
  Check(
    Controls[1].Column = 2 and Controls[1].Row = 4 and Controls[1].Height = 1,
    'Logical main-axis gap.'
  );
  var Rejected: bool := false;
  try
    discard V.Prepare<int>(
      E.Size<int>(
        E.Text<int>('x'),
        new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(32)), Grow := 1)
      ), V.Target.Portable
    );
  catch Error: Sys.ArgumentException do
    Rejected := Error.Message.Contains('Fixed extents cannot grow');
  end try;

  Check(Rejected, 'Fixed and growing sizes must not be combined.');
end procedure;

procedure SheetPlacement();
begin
  for Side: Sheets.Side in Sys.Enum.GetValues<Sheets.Side>() do
    const View: function(int): E.Element<int> := function(State: int): E.Element<int> => Sheets.Sheet<int>(
      'sheet', B.Button<int>('under', 'Background', 5),
      E.Column<int>(B.Button<int>('inside', 'Body', 2), E.Text<int>('Last line')),
      State = 0, new Sheets.Options(
        'Header', Description := 'Detail', Edge := Side,
        Size := 64, InitialFocus := 'inside'
      ), 1
    );
    using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(
      0,
      Update,
      View,
      32,
      12
    );
    const Frame: Tui.Frame := Session.Snapshot();
    const Close: Tui.ControlSnapshot := Frame.Controls[1];
    const Column: int := if Side = Sheets.Side.Left then 7 else 29 end if;
    const Row: int := if Side = Sheets.Side.Bottom then 7 else 1 end if;
    Check(
      Close.Id = Sheets.CloseId('sheet') and Close.Column = Column and Close.Row = Row,
      'Wrong sheet placement: ' + Side.ToString()
    );
    Check(
      not Frame.Controls[0].Enabled and Frame.Controls[2].Focused,
      'The sheet must honor initial focus and block base input.'
    );
    Check(
      Frame.Lines[Row].Contains('Head') and Frame.Lines[0].Contains('Background'),
      'The pinned header or background was lost.'
    );
    if Side = Sheets.Side.Top or Side = Sheets.Side.Bottom then
      discard Session.Send(Tui.Input.KeyPress(Keys.Key.PageDown, Keys.KeyModifiers.None));
      discard Session.Step();
      const Scrolled: Tui.Frame := Session.Snapshot();
      Check(
        Scrolled.Lines[Row].Contains('Header') and Scrolled.Lines[Row + 2].Contains('Last line'),
        'Scrolling moved the pinned header or lost the final body row.'
      );
    end if;
  end for;
end procedure;

procedure IconAction();
  function View(State: int): E.Element<int>;
  begin
    return E.Column<int>(
      B.Button<int>('ready', 'Finish loading', 1),
      Icons.IconButton<int>(
        'icon', Sys.Char.ConvertFromUtf32($E115), 'Components', 2,
        new Icons.Options(
          Loading := State = 0,
          Enabled := State < 2,
          Shortcut := 'M',
          TerminalGlyph := '≡'
        )
      )
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 32, 10);
  discard Session.Send(Tui.Input.Focus('icon'));
  discard Session.Step();
  discard Session.Send(Tui.Input.Character(' '));
  discard Session.Step();
  const Busy: Tui.ControlSnapshot := Session.Snapshot().Controls[1];
  Check(
    Busy.Value = 'loading' and Busy.Focused,
    'Busy icon button must keep focus and suppress activation.'
  );
  discard Session.Send(Tui.Input.Activate('ready'));
  discard Session.Step();
  discard Session.Send(Tui.Input.Pointer(Keys.PointerKind.Move, Busy.Column, Busy.Row));
  discard Session.Step();
  Check(
    Session.Snapshot().Lines[9].Contains('Components · M'),
    'Terminal icon button tooltip and shortcut hint.'
  );
  discard Session.Send(Tui.Input.Character(' '));
  discard Session.Step();
  Check(
    not Session.Snapshot().Controls[1].Enabled,
    'Terminal icon button did not activate from Space.'
  );
end procedure;

procedure ButtonAction();
  function View(State: int): E.Element<int>;
  begin
    return E.Column<int>(
      B.Button<int>('ready', 'Finish loading', 1),
      B.Button<int>(
        'save', if State = 0 then 'Saving ## literal' else 'Save' end if, 2,
        new B.Options(
          Loading := State = 0,
          Enabled := State < 2,
          Selected := true,
          TerminalIcon := '✓',
          TerminalIconRight := '→',
          Tooltip := 'Save changes',
          Shortcut := 'Ctrl S',
          Width := L.Extent.Fixed(L.Measure.Logical(192)),
          Color := new G.Color(40, 150, 100)
        )
      ),
      B.Button<int>('full', 'Full', 3, new B.Options(Width := L.Extent.Fill)),
      E.Row<int>(
        B.Button<int>(
          'fixed',
          'Fixed',
          3,
          new B.Options(Width := L.Extent.Fixed(L.Measure.Logical(80)))
        ),
        B.Button<int>('fill-row', 'Fill', 3, new B.Options(Width := L.Extent.Fill))
      ),
      B.Button<int>('large', 'Large', 3, new B.Options(ControlSize := B.Size.Large)),
      B.Button<int>(
        'transparent',
        'Hidden label',
        3,
        new B.Options(Color := new G.Color(0, 0, 0, 0))
      )
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(
    0, Update, View, 40, 12, ThemeFor := function(State: int): Themes.Theme => Themes.Dark()
  );
  discard Session.Send(Tui.Input.Focus('save'));
  discard Session.Step();
  discard Session.Send(Tui.Input.KeyPress(Keys.Key.Enter, Keys.KeyModifiers.None));
  discard Session.Step();
  const Frame: Tui.Frame := Session.Snapshot();
  const Busy: Tui.ControlSnapshot := Frame.Controls[1];
  Check(
    Busy.Value = 'loading' and Busy.Focused,
    'A busy button must keep focus and suppress Enter.'
  );
  Check(
    Busy.Label = 'Saving ## literal' and Busy.Width = 24,
    'Literal label or fixed logical width.'
  );
  Check(
    Frame.Lines[Busy.Row].Contains('… Saving ## literal →'),
    'Loading must retain the label and trailing icon.'
  );
  Check(
    Frame.Cells[Busy.Row * 40 + Busy.Column].Colors.Foreground = $289664,
    'Custom color was lost on focus.'
  );
  Check(
    Frame.Controls[2].Width = 40 and Frame.Controls[3].Width = 10 and Frame.Controls[4].Width = 30,
    'Fixed and full button widths must apply to the horizontal axis in rows and columns.'
  );
  Check(Frame.Controls[5].Height = 2, 'Large terminal button height.');
  const Hidden: Tui.ControlSnapshot := Frame.Controls[6];
  const HiddenColors: Terminal.Style := Frame.Cells[Hidden.Row * 40 + Hidden.Column].Colors;
  Check(
    HiddenColors.Foreground = HiddenColors.Background,
    'Transparent foreground must blend into the button face.'
  );
  discard Session.Send(Tui.Input.Pointer(Keys.PointerKind.Move, Busy.Column, Busy.Row));
  discard Session.Step();
  Check(
    Session.Snapshot().Lines[11].Contains('Save changes · Ctrl S'),
    'Button tooltip and shortcut hint.'
  );
  discard Session.Send(Tui.Input.KeyPress(Keys.Key.S, Keys.KeyModifiers.Ctrl));
  discard Session.Step();
  Check(Session.Snapshot().Controls[1].Value = 'loading', 'A shortcut hint must not bind the key.');
  discard Session.Send(Tui.Input.Activate('ready'));
  discard Session.Step();
  discard Session.Send(Tui.Input.Focus('save'));
  discard Session.Step();
  discard Session.Send(Tui.Input.Character(' '));
  discard Session.Step();
  Check(not Session.Snapshot().Controls[1].Enabled, 'Space must activate the ready button.');
  discard Session.Send(Tui.Input.Activate('save'));
  discard Session.Step();
  Check(not Session.Snapshot().Controls[1].Enabled, 'Disabled buttons must suppress activation.');
end procedure;

procedure JoinedButtons();
  function View(State: int): E.Element<int>;
  begin
    return Groups.ButtonGroup<int>(
      B.Button<int>('bold', 'Bold', 1, new B.Options(Selected := State = 1)),
      B.Button<int>(
        'italic',
        'Italic',
        3,
        new B.Options(Enabled := false, Variant := Styles.ButtonVariant.Outline)
      ),
      Icons.IconButton<int>(
        'underline', Sys.Char.ConvertFromUtf32($E19A), 'Underline', 2,
        new Icons.Options(TerminalGlyph := 'U', Selected := State = 2)
      )
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 40, 10);
  const Frame: Tui.Frame := Session.Snapshot();
  Check(
    Frame.Controls.Length = 3 and Frame.Lines[
      0
    ].StartsWith('╭') and Frame.Lines[0].TrimEnd().EndsWith('╮')
    and Frame.Lines[1].Contains('Bold │ Italic │') and not Frame.Lines[1].Contains('['),
    'Joined buttons must share one outline and cell dividers.'
  );
  discard Session.Send(Tui.Input.Focus('bold'));
  discard Session.Step();
  discard Session.Send(Tui.Input.KeyPress(Keys.Key.Tab, Keys.KeyModifiers.None));
  discard Session.Step();
  Check(Session.Snapshot().Controls[2].Focused, 'Tab must skip a disabled group member.');
  discard Session.Send(Tui.Input.KeyPress(Keys.Key.Enter, Keys.KeyModifiers.None));
  discard Session.Step();
  Check(
    Session.Snapshot().Controls[2].Value = 'true',
    'The icon button must retain its own action.'
  );
  const Bold: Tui.ControlSnapshot := Frame.Controls[0];
  discard Session.Send(Tui.Input.Pointer(Keys.PointerKind.Press, Bold.Column + 1, Bold.Row));
  discard Session.Step();
  discard Session.Send(Tui.Input.Pointer(Keys.PointerKind.Release, Bold.Column + 1, Bold.Row));
  discard Session.Step();
  const Selected: Tui.Frame := Session.Snapshot();
  Check(
    Selected.Controls[0].Value = 'true' and Selected.Controls[2].Value = 'false',
    'Click must activate only the hit member.'
  );
end procedure;

procedure CopyAction();
  function View(State: int; Size: L.Viewport): E.Element<int>;
  begin
    return E.Column<int>(
      Copy.CopyButton<int>('copy', Text, function(): int => 1),
      Copy.CopyButton<int>('disabled-copy', 'Disabled', Enabled := false),
      E.Text<int>('Copies: ' + State.ToString())
    );
  end function;
  procedure WriteClipboard(Value: string);
  begin
    Writes.Add(Clipboard.Sequence(Value));
  end procedure;
begin
  const Esc: string := new string(#27, 1);
  const Text: string := 'λ' + new string(#10, 1) + Esc + 'text';
  const Writes: Generic.List<string> := new Generic.List<string>();
  using const Session: Tui.HeadlessSession := Host.Start<int, int>(
    0, Update, View, 32, 8, procedure(Frame: Tui.Frame) begin end procedure, true,
    function(State: int): Themes.Theme => Themes.Dark(), WriteClipboard
  );
  Check(Writes.Count = 0, 'Preparing a view must not touch the clipboard.');
  const Before: Tui.ControlSnapshot := Session.Snapshot().Controls[0];
  discard Session.Send(Tui.Input.KeyPress(Keys.Key.Enter, Keys.KeyModifiers.None));
  discard Session.Step();
  const Frame: Tui.Frame := Session.Snapshot();
  const After: Tui.ControlSnapshot := Frame.Controls[0];
  Check(
    Writes.Count = 1 and Writes[0] = Esc + ']52;c;zrsKG3RleHQ=' + Esc + '\',
    'Copy must submit exactly one UTF-8 OSC 52 clipboard request.'
  );
  Check(
    After.Focused and After.Width = Before.Width and After.Value = 'copied'
    and Frame.Lines[0].Contains('✓') and Frame.Lines[2].Contains('Copies: 1'),
    'Copy feedback must preserve focus and size, and send its application notification.'
  );
  discard Session.Send(Tui.Input.Activate('disabled-copy'));
  discard Session.Step();
  Check(Writes.Count = 1, 'A disabled copy button must not submit text.');
  Threads.Thread.Sleep(1700);
  discard Session.Step();
  const Expired: Tui.Frame := Session.Snapshot();
  Check(
    Expired.Controls[
      0
    ].Focused and Expired.Controls[0].Value = '' and Expired.Lines[0].Contains('Copy'),
    'Copy feedback must expire without another user input.'
  );
end procedure;

begin
  Allocation();
  SemanticColors();
  LogicalDistances();
  SheetPlacement();
  IconAction();
  ButtonAction();
  JoinedButtons();
  CopyAction();
  Console.WriteLine('CUI terminal contracts verified');
end;
end program;
