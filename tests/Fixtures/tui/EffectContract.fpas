program EffectContract;

uses Fpas.Mvu.Application as Mvu, Fpas.Mvu.Session as Runtime, Fpas.Tui.Application as App, Fpas.Ui.Elements as E, System as Sys, System.Console as Console, System.Threading as Threads, System.Threading.Tasks as Tasks;

type Msg = union
  StartOriginal;
  Replace;
  StartFailure;
  StartUntilExit;
  StartBlocked;
  Cancel;
  Touch;
  Changed(Value: string);
  Quit;
end union;

const Deadline: Sys.TimeSpan := Sys.TimeSpan.FromSeconds(5);
const BodyStarted: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const BodyRelease: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const Posted: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const Replaced: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const ReplacementRelease: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const Started: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const Stopping: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const StopRelease: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const Release: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const Joined: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const LateRejected: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const BeginBlockedPost: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);
const BlockedPost: Tasks.TaskCompletionSource<Tasks.Task> := new Tasks.TaskCompletionSource<Tasks.Task>(
  Tasks.TaskCreationOptions.RunContinuationsAsynchronously
);

procedure ObserveReplacement();
begin
  Replaced.SetResult();
  ReplacementRelease.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
end procedure;

procedure ObserveStop();
begin
  Stopping.SetResult();
  StopRelease.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
  raise new Sys.InvalidOperationException('callback boom');
end procedure;

async function Original(Post: function(Msg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
begin
  using const Registration: Threads.CancellationTokenRegistration := Token.Register(
    ObserveReplacement
  );
  BodyStarted.SetResult();
  BodyRelease.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
  await Post(Msg.Changed('obsolete'));
  Posted.SetResult();
  await Replaced.Task.WaitAsync(Deadline);
end function;

function Replacement(Post: function(Msg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
begin
  Token.ThrowIfCancellationRequested();
  return Post(Msg.Changed('replacement'));
end function;

function Failing(Post: function(Msg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
begin
  raise new Sys.InvalidOperationException('worker boom');
end function;

async function UntilExit(Post: function(Msg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
begin
  discard Token.Register(ObserveStop);
  Started.SetResult();
  await Stopping.Task.WaitAsync(Deadline);
  try
    await Post(Msg.Changed('late'));
  catch Error: Sys.OperationCanceledException do
    LateRejected.SetResult();
  end try;

  await Release.Task.WaitAsync(Deadline);
  Joined.SetResult();
end function;

async function UntilMailboxCloses(Post: function(Msg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
begin
  await BeginBlockedPost.Task.WaitAsync(Deadline);
  const Pending: Tasks.Task := Post(Msg.Changed('blocked'));
  BlockedPost.SetResult(Pending);
  await Pending;
end function;

function Failed(Error: Sys.Exception): Msg;
begin
  return Msg.Changed('failed: ' + Error.Message);
end function;

function Update(State: string; Message: Msg): Mvu.Transition<string, Msg>;
begin
  case Message of
    when Msg.StartOriginal:
      return new Mvu.Transition<string, Msg>(
        State,
        [Mvu.StartBackground<Msg>('job', Original, Failed)]
      );
    when Msg.Replace:
      return new Mvu.Transition<string, Msg>(
        State,
        [Mvu.StartBackground<Msg>('job', Replacement, Failed)]
      );
    when Msg.StartFailure:
      return new Mvu.Transition<string, Msg>(
        State,
        [Mvu.StartBackground<Msg>('failing', Failing, Failed)]
      );
    when Msg.StartUntilExit:
      return new Mvu.Transition<string, Msg>(
        State,
        [Mvu.StartBackground<Msg>('until-exit', UntilExit, Failed)]
      );
    when Msg.StartBlocked:
      return new Mvu.Transition<string, Msg>(
        State,
        [Mvu.StartBackground<Msg>('blocked', UntilMailboxCloses, Failed)]
      );
    when Msg.Cancel:
      return new Mvu.Transition<string, Msg>(State, [Mvu.CancelBackground<Msg>('until-exit')]);
    when Msg.Touch:
      return new Mvu.Transition<string, Msg>(State + '!', []);
    when Msg.Changed(const Value: string):
      return new Mvu.Transition<string, Msg>(Value, []);
    when Msg.Quit:
      return new Mvu.Transition<string, Msg>(State, [Mvu.Exit<Msg>()]);
  end case;
end function;

function View(State: string): E.Element<Msg>;
begin
  return E.Column<Msg>(
    E.Text<Msg>(State), E.Button<Msg>('original', 'Original', Msg.StartOriginal),
    E.Button<Msg>('replacement', 'Replacement', Msg.Replace),
    E.Button<Msg>('failing', 'Failing', Msg.StartFailure),
    E.Button<Msg>('until-exit', 'Until exit', Msg.StartUntilExit),
    E.Button<Msg>('cancel', 'Cancel', Msg.Cancel), E.Button<Msg>('touch', 'Touch', Msg.Touch),
    E.Button<Msg>('quit', 'Quit', Msg.Quit)
  );
end function;

procedure Send(Session: App.HeadlessSession; Control: string);
begin
  case Session.Send(App.Input.Activate(Control)) of
    when App.Admission.Queued(_):
    else
      raise new Sys.InvalidOperationException('Input was not admitted: ' + Control);
  end case;
end procedure;

procedure StepEffect(Session: App.HeadlessSession; Expected: string);
begin
  using const Limit: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(
    Deadline
  );
  if not Session.WaitForWork(Limit.Token).GetAwaiter().GetResult() then
    raise new Sys.InvalidOperationException('No pending effect result.');
  end if;

  case Session.Step() of
    when App.StepResult.EffectProcessed(_):
      if Session.Snapshot().Lines[0].TrimEnd() <> Expected then
        raise new Sys.InvalidOperationException('Unexpected effect result, expected: ' + Expected);
      end if;
    else
      raise new Sys.InvalidOperationException('The queued entry was not an effect result.');
  end case;
end procedure;

procedure CheckReplacementAndFailure();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<string, Msg>(
    'initial',
    Update,
    View,
    30,
    8
  );
  try
    Send(Session, 'original');
    discard Session.Step();
    BodyStarted.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
    Send(Session, 'touch');
    discard Session.Step();
    if Session.Snapshot().Lines[0].TrimEnd() <> 'initial!' then
      raise new Sys.InvalidOperationException('The worker prefix blocked another button.');
    end if;

    Send(Session, 'replacement');
    Send(Session, 'touch');
    BodyRelease.SetResult();
    Posted.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
    discard Session.Step();
    Replaced.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
    discard Session.Step();
    if Session.Snapshot().Lines[0].TrimEnd() <> 'initial!!' then
      raise new Sys.InvalidOperationException('Replacement cancellation blocked another button.');
    end if;

    StepEffect(Session, 'initial!!');
    StepEffect(Session, 'replacement');

    Send(Session, 'failing');
    discard Session.Step();
    if Session.Snapshot().Lines[0].TrimEnd() <> 'replacement' then
      raise new Sys.InvalidOperationException('The failure message ran in the starting step.');
    end if;

    StepEffect(Session, 'failed: worker boom');
  finally
    discard BodyRelease.TrySetResult();
    discard ReplacementRelease.TrySetResult();
  end try;
end procedure;

procedure CheckExitSession();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<string, Msg>(
    'initial',
    Update,
    View,
    30,
    8
  );
  try
    Send(Session, 'until-exit');
    discard Session.Step();
    Started.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
    Send(Session, 'cancel');
    discard Session.Step();
    Stopping.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
    LateRejected.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
    Send(Session, 'touch');
    discard Session.Step();
    if Session.Snapshot().Lines[0].TrimEnd() <> 'initial!' then
      raise new Sys.InvalidOperationException('Explicit cancellation blocked another button.');
    end if;

    Send(Session, 'quit');
    case Session.Step() of
      when App.StepResult.Processed(_, _, _):
      else
        raise new Sys.InvalidOperationException('Exit did not return from the host step.');
    end case;
    const Closing: Tasks.Task := Session.CloseAsync();
    if Session.IsOpen() or Closing.IsCompleted then
      raise new Sys.InvalidOperationException('Shutdown must close admission before joining work.');
    end if;

    case Session.Send(App.Input.Activate('quit')) of
      when App.Admission.Closed:
      else
        raise new Sys.InvalidOperationException('The exited session still admits input.');
    end case;

    Release.SetResult();
    Joined.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
    if Closing.IsCompleted then
      raise new Sys.InvalidOperationException(
        'Shutdown forgot an outstanding cancellation callback.'
      );
    end if;

    StopRelease.SetResult();
    Closing.WaitAsync(Deadline).GetAwaiter().GetResult();
  finally
    discard Release.TrySetResult();
    discard StopRelease.TrySetResult();
  end try;
end procedure;

procedure CheckExit();
begin
  try
    CheckExitSession();
  catch Failure: Sys.AggregateException do
    if Failure.Flatten().InnerExceptions[0].Message = 'callback boom' then
      return;
    end if;

    raise;
  end try;

  raise new Sys.InvalidOperationException('Shutdown lost the callback failure.');
end procedure;

procedure CheckCore();
begin
  const Core: Runtime.Runtime<string, Msg, string> := Runtime.Start<string, Msg, string>(
    'initial', Update, procedure(Request: Mvu.HostRequest) begin end procedure, 1
  );
  try
    case Core.Post(Msg.Touch) of
      when Runtime.Admission.Queued:
      else
        raise new Sys.InvalidOperationException('The runtime did not admit its first message.');
    end case;

    case Core.Post(Msg.Touch) of
      when Runtime.Admission.Full:
      else
        raise new Sys.InvalidOperationException('The runtime exceeded the mailbox bound.');
    end case;

    discard Core.Advance();
    if Core.Model() <> 'initial!' then
      raise new Sys.InvalidOperationException('The runtime did not apply exactly one transition.');
    end if;

    Core.Dispatch(Msg.StartBlocked);
    discard Core.Send('occupy the mailbox');
    BeginBlockedPost.SetResult();
    const Pending: Tasks.Task := BlockedPost.Task.WaitAsync(Deadline).GetAwaiter().GetResult();
    if Pending.IsCompleted then
      raise new Sys.InvalidOperationException('The effect post did not wait for mailbox capacity.');
    end if;
    const Closing: Tasks.Task := Core.Close();
    Closing.WaitAsync(Deadline).GetAwaiter().GetResult();
    if not Pending.IsCompleted or Pending.IsCompletedSuccessfully then
      raise new Sys.InvalidOperationException('Closing did not reject a blocked effect post.');
    end if;

    case Core.Post(Msg.Touch) of
      when Runtime.Admission.Closed:
      else
        raise new Sys.InvalidOperationException('A closed runtime admitted another message.');
    end case;
  finally
    discard BeginBlockedPost.TrySetResult();
    Core.Close().WaitAsync(Deadline).GetAwaiter().GetResult();
  end try;
end procedure;

begin
  CheckCore();
  CheckReplacementAndFailure();
  CheckExit();
  Console.WriteLine('effect contracts verified');
end;
end program;
