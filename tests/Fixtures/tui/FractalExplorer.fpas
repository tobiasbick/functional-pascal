// [Documentation](../../../examples/ui/tui/fractals/README.md)

program FractalExplorerContract;

uses Fpas.Ui.Mvu.Application as Mvu;
uses Fpas.Ui.Mvu.Testing.EffectReplies as Replies;
uses Fpas.Ui.TerminalExtensions.Input as K;
uses Fpas.Ui.Tui.Application as App;
uses Fpas.Ui.Tui.Headless as Headless;
uses Fpas.Ui.Widgets.Developer.Terminal as T;

uses Fractals.Explorer as X;
uses Fractals.View as V;
uses System as Sys;
uses System.Console as Console;
uses System.Threading as Threads;
uses System.Threading.Channels as Channels;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function RowWith(Frame: App.Frame; Part: string): string;
begin
  for Row: string in Frame.Lines do
    if Row.Contains(Part) then
      return Row;
    end if;
  end for;

  return '';
end function;

procedure CheckFooter(Frame: App.Frame);
begin
  Check(
    RowWith(Frame, 'Iterations').Contains('PgUp/PgDn'),
    'Show the iteration keys beside the gauge.'
  );
  const Top: int := Sys.Array.IndexOf of string(Frame.Lines, RowWith(Frame, 'Status'));
  Check(Top >= 0, 'The status panel has a frame.');
  for Index: int := Top + 1 to Frame.Rows - 2 do
    const Row: string := Frame.Lines[Index];
    Check(
      Row.StartsWith('│ ') and Row.EndsWith(' │'),
      'Both sides of every status row have a cell of padding.'
    );
  end for;
end procedure;

function Control(Frame: App.Frame; Label: string): App.ControlSnapshot;
begin
  for Item: App.ControlSnapshot in Frame.Controls do
    if Item.Label = Label then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing control: ' + Label);
end function;

procedure StepEffect(Session: App.HeadlessSession);
begin
  case Session.Step() of
    when App.StepResult.EffectProcessed(_):
    when App.StepResult.Failed(_, _, const Stage: string, const Reason: string):
      raise new Sys.InvalidOperationException(Stage + ': ' + Reason);
    else
      raise new Sys.InvalidOperationException('Expected one application message.');
  end case;
end procedure;

procedure Send(Session: App.HeadlessSession; Event: App.Input);
begin
  case Session.Send(Event) of
    when App.Admission.Queued(const Receipt: long):
      for Attempt: int := 1 to 128 do
        case Session.Step() of
          when App.StepResult.Processed(const Id: long, _, _):
            if Id = Receipt then
              return;
            end if;
          when App.StepResult.Failed(_, _, const Stage: string, const Reason: string):
            raise new Sys.InvalidOperationException(Stage + ': ' + Reason);
          else
        end case;
      end for;
    else
  end case;

  raise new Sys.InvalidOperationException('Input was not processed.');
end procedure;

procedure Verify();
  function Ready(): App.Frame;
  begin
    using const Limit: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(
      10000
    );
    const Reply: Replies.Reply of X.Msg := Render.ReadAsync(
      Limit.Token
    ).AsTask().GetAwaiter().GetResult();
    Check(
      RowWith(Session.Snapshot(), 'Rendering') <> '',
      'Show rendering before the image arrives.'
    );

    Reply.Release().WaitAsync(Limit.Token).GetAwaiter().GetResult();
    StepEffect(Session);
    const Frame: App.Frame := Session.Snapshot();
    Check(
      RowWith(Frame, 'Ready') <> '',
      'Expected a completed render: ' + Sys.String.Join(' ', Frame.Lines)
    );
    Render := Effects.Watch('render');
    return Frame;
  end function;
  procedure Key(Pressed: K.Key);
  begin
    Send(Session, App.Input.KeyPress(Pressed, K.KeyModifiers.None));
  end procedure;
  procedure CharKey(Value: string);
  begin
    Send(Session, App.Input.Character(Value));
  end procedure;
  function Choose(Name: string): App.Frame;
  begin
    const Item: App.ControlSnapshot := Control(Session.Snapshot(), Name);
    Send(Session, App.Input.Click(Item.Column + 1, Item.Row));
    const Frame: App.Frame := Ready();
    Check(Control(Frame, Name).Value = 'true', 'Selected family: ' + Name);
    return Frame;
  end function;
begin
  const Effects: Replies.Effects of X.Msg := (Replies.Effects of X.Msg).Create();
  var Render: Channels.ChannelReader of Replies.Reply of X.Msg := Effects.Watch('render');
  using const Session: App.HeadlessSession := Headless.Start of (X.Model, X.Msg)(
    new X.Model(),
    function(State: X.Model; Message: X.Msg): Mvu.Transition of (X.Model, X.Msg) => Effects.Wrap of X.Model(
      X.Update(State, Message)
    ),
    V.View, 80, 25, V.Theme()
  );
  StepEffect(Session);
  const Initial: App.Frame := Ready();
  CheckFooter(Initial);
  const Plot: App.ControlSnapshot := Control(Initial, 'plot');
  Check(
    Plot.Width = 62 and Plot.Height = 17 and Initial.Lines[19].Contains('Status')
    and Initial.Lines[19].StartsWith('╭') and Initial.Lines[19].EndsWith('╮'),
    'Full-width status below both panes.'
  );
  Check(
    Control(Initial, 'Mandelbrot').Focused and RowWith(Initial, '160 / 2048') <> '',
    'Initial family and iterations.'
  );
  Key(K.Key.Tab);
  Check(Control(Session.Snapshot(), 'plot').Focused, 'Tab reaches Mandelbrot plot at 80 by 25.');
  CharKey('+');
  const Zoomed: App.Frame := Ready();
  Check(RowWith(Zoomed, '1.25×') <> '', 'Plus zooms Mandelbrot.');
  Key(K.Key.Right);
  Check(RowWith(Ready(), 'Center') <> RowWith(Zoomed, 'Center'), 'Right pans Mandelbrot.');
  Key(K.Key.PageUp);
  Check(RowWith(Ready(), '192 / 2048') <> '', 'Page Up raises Mandelbrot iterations.');
  CharKey('h');
  Check(RowWith(Session.Snapshot(), 'Controls') <> '', 'Help opens at 80 by 25.');
  Key(K.Key.PageDown);
  Check(RowWith(Session.Snapshot(), 'Controls') <> '', 'Scrolling help keeps it open.');
  Key(K.Key.Escape);
  Check(Control(Session.Snapshot(), 'plot').Focused, 'Closing help restores focus to the image.');
  Key(K.Key.PageDown);
  Check(RowWith(Ready(), '160 / 2048') <> '', 'Page Down still controls iterations.');
  CharKey('r');
  Check(RowWith(Ready(), '1×') <> '', 'Reset restores Mandelbrot zoom.');
  Send(Session, App.Input.KeyPress(K.Key.Tab, K.KeyModifiers.Shift));
  Check(Control(Session.Snapshot(), 'Mandelbrot').Focused, 'Shift Tab returns to the family list.');
  Key(K.Key.Down);
  Check(
    Control(
      Session.Snapshot(),
      'Julia'
    ).Focused and Control(Session.Snapshot(), 'Mandelbrot').Value = 'true',
    'Browsing must wait for activation.'
  );
  Key(K.Key.Enter);
  Check(RowWith(Ready(), 'c (-0.8, 0.156)') <> '', 'Julia initial parameter.');
  Key(K.Key.Tab);
  Check(
    Control(Session.Snapshot(), 'plot').Focused,
    'Tab from a middle list item goes straight to the plot.'
  );
  Key(K.Key.Up);
  Check(RowWith(Ready(), 'Center (0, 0.336)') <> '', 'Arrow pans the image.');
  CharKey('w');
  Check(RowWith(Ready(), 'c (-0.8, 0.176)') <> '', 'Julia parameter changes.');
  CharKey('2');
  Check(RowWith(Ready(), 'Ember   c (-0.8, 0.176)') <> '', 'Julia parameter and palette.');
  Key(K.Key.PageUp);
  Check(RowWith(Ready(), '128 / 2048') <> '', 'Iteration limit changes in the image.');
  Key(K.Key.PageDown);
  Check(RowWith(Ready(), '96 / 2048') <> '', 'Page Down lowers the iteration limit.');
  Send(Session, App.Input.Scroll(Plot.Column + 1, Plot.Row + 1, -1));
  Check(RowWith(Ready(), '1.25×') <> '', 'Wheel zooms in.');
  CharKey('-');
  Check(RowWith(Ready(), '1×') <> '', 'Keyboard zooms out.');
  Send(Session, App.Input.ButtonClick(K.MouseButton.Middle, Plot.Column, Plot.Row));
  Check(
    RowWith(Ready(), 'Center (0, 0)   Deep Ocean') <> '',
    'Middle click resets the camera and palette.'
  );
  Send(Session, App.Input.Click(Plot.Column, Plot.Row));
  Check(
    RowWith(Ready(), 'Center (0, 0)') = '',
    'Click centers using local image coordinates.'
  );
  CharKey('h');
  Check(RowWith(Session.Snapshot(), 'Controls') <> '', 'Help opens.');
  Key(K.Key.Escape);
  Check(
    Session.IsOpen() and RowWith(Session.Snapshot(), 'Controls') = '',
    'Escape first dismisses help.'
  );
  Send(Session, App.Input.KeyPress(K.Key.Tab, K.KeyModifiers.Shift));
  Check(Control(Session.Snapshot(), 'Julia').Focused, 'Shift+Tab returns to the selected family.');
  Check(
    RowWith(Choose('Burning Ship'), 'Center (-0.45, -0.55)   Ember') <> '',
    'Burning Ship home.'
  );
  Check(RowWith(Choose('Tricorn'), 'Aurora') <> '', 'Tricorn home.');
  discard Choose('Newton');
  Send(Session, App.Input.Resize(74, 22));
  StepEffect(Session);
  const Small: App.Frame := Ready();
  CheckFooter(Small);
  const Grid: App.ControlSnapshot := Control(Small, 'plot');
  Check(
    Grid.Width = Plot.Width - 6 and Grid.Height = Plot.Height - 3 and Small.Lines[
      16
    ].Contains('Status'),
    'Resize reallocates the plot and keeps the footer below it.'
  );
  const Middle: int := (Grid.Row + Grid.Height div 2) * Small.Columns + Grid.Column + Grid.Width div
    2;
  const Red: int := Small.Cells[Middle + 10].Colors.Foreground ?? 0;
  const Green: int := Small.Cells[Middle - 4 * Small.Columns - 6].Colors.Foreground ?? 0;
  const Blue: int := Small.Cells[Middle + 4 * Small.Columns - 6].Colors.Foreground ?? 0;
  Check(
    (Red shr 16) > ((Red shr 8) and 255) and ((Green shr 8) and 255) > (Green shr 16)
    and (Blue and 255) > (Blue shr 16), 'Newton hues identify the three attracting roots.'
  );
  Key(K.Key.Escape);
  Check(not Session.IsOpen(), 'Escape closes the explorer.');
end procedure;

begin
  Verify();
  Console.WriteLine('Fractal explorer verified');
end;

end program;
