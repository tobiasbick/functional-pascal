program FractalExplorerContract;

uses
  Fractals.Explorer as X, Fractals.View as V, Fpas.Ui.Tui.Application as App,
  Fpas.Ui.TerminalExtensions.Input as K, Fpas.Ui.Widgets.Developer.Terminal as T,
  System as Sys, System.Console as Console, System.Diagnostics as Diag, System.Threading as Threads;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function RowWith(Frame: App.Frame; Part: string): string;
begin
  for Row: string in Frame.Lines do
    if Row.Contains(Part) then
      return Row;
    end if;
  end for;

  return '';
end function;

procedure CheckFooter(Frame: App.Frame);
begin
  Check(
    RowWith(Frame, 'Iterations').Contains('PgUp/PgDn'),
    'Show the iteration keys beside the gauge.'
  );
  const Top: int := Sys.Array.IndexOf<string>(Frame.Lines, RowWith(Frame, 'Status'));
  Check(Top >= 0, 'The status panel has a frame.');
  for Index: int := Top + 1 to Frame.Rows - 2 do
    const Row: string := Frame.Lines[Index];
    Check(
      Row.StartsWith('│ ') and Row.EndsWith(' │'),
      'Both sides of every status row have a cell of padding.'
    );
  end for;
end procedure;

function Control(Frame: App.Frame; Label: string): App.ControlSnapshot;
begin
  for Item: App.ControlSnapshot in Frame.Controls do
    if Item.Label = Label then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing control: ' + Label);
end function;

procedure Step(Session: App.HeadlessSession);
begin
  case Session.Step() of
    when App.StepResult.Failed(_, _, const Stage: string, const Reason: string):
      raise new Sys.InvalidOperationException(Stage + ': ' + Reason);
    else
  end case;
end procedure;

procedure Send(Session: App.HeadlessSession; Event: App.Input);
begin
  case Session.Send(Event) of
    when App.Admission.Queued(const Receipt: long):
      for Attempt: int := 1 to 128 do
        case Session.Step() of
          when App.StepResult.Processed(const Id: long, _, _):
            if Id = Receipt then
              return;
            end if;
          when App.StepResult.Failed(_, _, const Stage: string, const Reason: string):
            raise new Sys.InvalidOperationException(Stage + ': ' + Reason);
          else
        end case;
      end for;
    else
  end case;

  raise new Sys.InvalidOperationException('Input was not processed.');
end procedure;

// Waits for the current background frame while pumping the actual terminal host.
function Ready(Session: App.HeadlessSession): App.Frame;
begin
  const Timer: Diag.Stopwatch := Diag.Stopwatch.StartNew();
  while Timer.ElapsedMilliseconds < 10000 do
    Step(Session);
    const Frame: App.Frame := Session.Snapshot();
    if RowWith(Frame, 'Ready') <> '' then
      return Frame;
    end if;

    Threads.Thread.Sleep(1);
  end while;

  raise new Sys.InvalidOperationException(
    'Render timed out: ' + Sys.String.Join(' ', Session.Snapshot().Lines)
  );
end function;

procedure Verify();
  procedure Key(Pressed: K.Key);
  begin
    Send(Session, App.Input.KeyPress(Pressed, K.KeyModifiers.None));
  end procedure;
  procedure CharKey(Value: string);
  begin
    Send(Session, App.Input.Character(Value));
  end procedure;
  procedure Choose(Name: string);
  begin
    const Item: App.ControlSnapshot := Control(Session.Snapshot(), Name);
    Send(Session, App.Input.Click(Item.Column + 1, Item.Row));
    Check(Control(Ready(Session), Name).Value = 'true', 'Selected family: ' + Name);
  end procedure;
begin
  using const Session: App.HeadlessSession := App.StartHeadless<X.Model, X.Msg>(
    new X.Model(), X.Update, V.View, 90, 28, V.Theme()
  );
  const Initial: App.Frame := Ready(Session);
  CheckFooter(Initial);
  const Plot: App.ControlSnapshot := Control(Initial, 'plot');
  Check(
    Plot.Width > 65 and Plot.Height = 20 and Initial.Lines[22].Contains('Status')
    and Initial.Lines[22].StartsWith('╭') and Initial.Lines[22].EndsWith('╮'),
    'Full-width status below both panes.'
  );
  Check(
    Control(Initial, 'Mandelbrot').Focused and RowWith(Initial, '160 / 2048') <> '',
    'Initial family and iterations.'
  );
  Key(K.Key.Down);
  Check(
    Control(
      Session.Snapshot(),
      'Julia'
    ).Focused and Control(Session.Snapshot(), 'Mandelbrot').Value = 'true',
    'Browsing must wait for activation.'
  );
  Key(K.Key.Enter);
  Check(RowWith(Ready(Session), 'c (-0.8, 0.156)') <> '', 'Julia initial parameter.');
  Key(K.Key.Tab);
  Check(
    Control(Session.Snapshot(), 'plot').Focused,
    'Tab from a middle list item goes straight to the plot.'
  );
  Key(K.Key.Up);
  Check(RowWith(Ready(Session), 'Center (0, 0.336)') <> '', 'Arrow pans the image.');
  CharKey('w');
  CharKey('2');
  Check(RowWith(Ready(Session), 'Ember   c (-0.8, 0.176)') <> '', 'Julia parameter and palette.');
  Key(K.Key.PageUp);
  Check(RowWith(Ready(Session), '128 / 2048') <> '', 'Iteration limit changes in the image.');
  Key(K.Key.PageDown);
  Check(RowWith(Ready(Session), '96 / 2048') <> '', 'Page Down lowers the iteration limit.');
  Send(Session, App.Input.Scroll(Plot.Column + 1, Plot.Row + 1, -1));
  Check(RowWith(Ready(Session), '1.25×') <> '', 'Wheel zooms in.');
  CharKey('-');
  Check(RowWith(Ready(Session), '1×') <> '', 'Keyboard zooms out.');
  Send(Session, App.Input.ButtonClick(K.MouseButton.Middle, Plot.Column, Plot.Row));
  Check(
    RowWith(Ready(Session), 'Center (0, 0)   Deep Ocean') <> '',
    'Middle click resets the camera and palette.'
  );
  Send(Session, App.Input.Click(Plot.Column, Plot.Row));
  Check(
    RowWith(Ready(Session), 'Center (0, 0)') = '',
    'Click centers using local image coordinates.'
  );
  CharKey('h');
  Check(RowWith(Session.Snapshot(), 'Controls') <> '', 'Help opens.');
  Key(K.Key.Escape);
  Check(
    Session.IsOpen() and RowWith(Session.Snapshot(), 'Controls') = '',
    'Escape first dismisses help.'
  );
  Send(Session, App.Input.KeyPress(K.Key.Tab, K.KeyModifiers.Shift));
  Check(Control(Session.Snapshot(), 'Julia').Focused, 'Shift+Tab returns to the selected family.');
  Choose('Burning Ship');
  Check(RowWith(Ready(Session), 'Center (-0.45, -0.55)   Ember') <> '', 'Burning Ship home.');
  Choose('Tricorn');
  Check(RowWith(Ready(Session), 'Aurora') <> '', 'Tricorn home.');
  Choose('Newton');
  Send(Session, App.Input.Resize(74, 22));
  const Small: App.Frame := Ready(Session);
  CheckFooter(Small);
  const Grid: App.ControlSnapshot := Control(Small, 'plot');
  Check(
    Grid.Width = Plot.Width - 16 and Grid.Height = Plot.Height - 6 and Small.Lines[
      16
    ].Contains('Status'),
    'Resize reallocates the plot and keeps the footer below it.'
  );
  const Middle: int := (Grid.Row + Grid.Height div 2) * Small.Columns + Grid.Column + Grid.Width div
    2;
  const Red: int := Small.Cells[Middle + 10].Colors.Foreground ?? 0;
  const Green: int := Small.Cells[Middle - 4 * Small.Columns - 6].Colors.Foreground ?? 0;
  const Blue: int := Small.Cells[Middle + 4 * Small.Columns - 6].Colors.Foreground ?? 0;
  Check(
    (Red shr 16) > ((Red shr 8) and 255) and ((Green shr 8) and 255) > (Green shr 16)
    and (Blue and 255) > (Blue shr 16), 'Newton hues identify the three attracting roots.'
  );
  Key(K.Key.Escape);
  Check(not Session.IsOpen(), 'Escape closes the explorer.');
end procedure;

begin
  Verify();
  Console.WriteLine('Fractal explorer verified');
end;

end program;
