program HeadlessContract;

uses Fpas.Ui.Buttons as UiButtons, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Tui.Application as App, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Validation as Validation, Fpas.Ui.Terminal as T, Fpas.Ui.Graphics as G, Fpas.Ui.TerminalExtensions.Input as InputKeys, Fpas.Ui.TerminalExtensions.Views as Views, Fpas.Ui.Themes as TerminalThemes, System as Sys, System.Console as Console, Fpas.Ui.Tui.Internal.Rendering.Presentation as P, Fpas.Ui.Tui.Internal.Layout.Flexible as F, System.IO as IO, System.Threading as Threads, System.Threading.Tasks as Tasks, Fpas.Ui.Tui.Internal.View.Lowering as Lower;

type Msg = variant
  Start;
  Cancel;
  Progress;
  Fail;
end variant;

const Posted: Tasks.TaskCompletionSource<bool> := new Tasks.TaskCompletionSource<bool>();

async function Work(Post: function(Msg): Tasks.Task; Token: Threads.CancellationToken): Tasks.Task;
begin
  Token.ThrowIfCancellationRequested();
  await Post(Msg.Progress);
  discard Posted.TrySetResult(true);
end function;

function Update(State: int; Message: Msg): Mvu.Transition<int, Msg>;
begin
  case Message of
    when Msg.Start:
      return new Mvu.Transition<int, Msg>(
        State,
        [Mvu.StartBackground<Msg>('task', Work, function(Error: Sys.Exception): Msg => Msg.Fail)]
      );
    when Msg.Cancel:
      return new Mvu.Transition<int, Msg>(State, [Mvu.CancelBackground<Msg>('task')]);
    when Msg.Progress:
      return new Mvu.Transition<int, Msg>(1, []);
    when Msg.Fail:
      return new Mvu.Transition<int, Msg>(-1, []);
  end case;
end function;

function View(State: int): E.Element<Msg>;
begin
  if State < 0 then
    raise new Sys.InvalidOperationException('staged view failure');
  end if;

  return E.Column<Msg>(
    E.Text<Msg>(State.ToString()),
    UiButtons.Button<Msg>('start', 'Start', Msg.Start),
    UiButtons.Button<Msg>('cancel', 'Cancel', Msg.Cancel),
    UiButtons.Button<Msg>('fail', 'Fail', Msg.Fail)
  );
end function;

function Send(Session: App.HeadlessSession; Id: string): long;
begin
  case Session.Send(App.Input.Activate(Id)) of
    when App.Admission.Queued(const Sequence: long):
      return Sequence;
    else
      raise new Sys.InvalidOperationException('Expected admission.');
  end case;
end function;

procedure CheckCancellation();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<int, Msg>(0, Update, View, 20, 5);
  discard Send(Session, 'start');
  discard Send(Session, 'cancel');
  discard Session.Step();
  discard Posted.Task.WaitAsync(Sys.TimeSpan.FromSeconds(5)).GetAwaiter().GetResult();
  discard Session.Step();
  const Before: App.Frame := Session.Snapshot();
  case Session.Step() of
    when App.StepResult.EffectProcessed(const FrameId: long):
      if FrameId <> Before.Id or Session.Snapshot().Lines[0].TrimEnd() <> '0' then
        raise new Sys.InvalidOperationException('A cancelled run changed the model.');
      end if;
    else
      raise new Sys.InvalidOperationException('The queued background entry was not stepped.');
  end case;
end procedure;

procedure CheckQueue();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<int, Msg>(0, Update, View, 20, 5);
  const First: long := Send(Session, 'missing');
  var Last: long := First;
  var Full: bool := false;
  for Index: int := 1 to 128 do
    case Session.Send(App.Input.Activate('missing')) of
      when App.Admission.Queued(const Id: long):
        Last := Id;
      when App.Admission.QueueFull:
        Full := true;
        break;
      else
        raise new Sys.InvalidOperationException('Unexpected queue status.');
    end case;
  end for;

  if not Full then
    raise new Sys.InvalidOperationException('The queue did not enforce a capacity.');
  end if;

  if Session.Wait(First, Sys.TimeSpan.Zero).GetAwaiter().GetResult() <> null then
    raise new Sys.InvalidOperationException('Wait advanced a manually stepped session.');
  end if;

  discard Session.Step();
  const Outcome: App.StepResult? := Session.Wait(First, Sys.TimeSpan.Zero).GetAwaiter().GetResult();
  if Outcome = null then
    raise new Sys.InvalidOperationException('Missing completed input.');
  end if;

  case Outcome of
    when App.StepResult.Processed(const Id: long, _, const Published: bool):
      if Id <> First or Published then
        raise new Sys.InvalidOperationException('A no-op published a frame.');
      end if;
    else
      raise new Sys.InvalidOperationException('Unexpected input outcome.');
  end case;

  if Send(Session, 'missing') <> Last + 1L then
    raise new Sys.InvalidOperationException('Rejected input took a sequence number.');
  end if;
end procedure;

procedure CheckFailure();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<int, Msg>(0, Update, View, 20, 5);
  const Complete: App.Frame := Session.Snapshot();
  const Id: long := Send(Session, 'fail');
  case Session.Step() of
    when App.StepResult.Failed(const InputId: long, const FrameId: long, const Stage: string, _):
      if InputId <> Id or FrameId <> Complete.Id or Stage <> 'view' or Session.IsOpen() then
        raise new Sys.InvalidOperationException('Unexpected failure outcome.');
      end if;
    else
      raise new Sys.InvalidOperationException('A failed view completed normally.');
  end case;

  if Session.Snapshot().Id <> Complete.Id then
    raise new Sys.InvalidOperationException('The complete frame was lost.');
  end if;
end procedure;

procedure CheckBounds(Minimum: L.Measure; Maximum: L.Measure; Horizontal: bool; Valid: bool; Mixed: bool);
  function Bounded(): E.Element<bool>;
  begin
    const Child: E.Element<bool> := E.Size<bool>(
      E.Text<bool>('bounded'),
      new L.Flex(Minimum := Minimum, Maximum := Maximum)
    );
    return if Horizontal then E.Row<bool>(Child) else E.Column<bool>(Child) end if;
  end function;

  function UpdateBounds(State: bool; Message: bool): Mvu.Transition<bool, bool>;
  begin
    return new Mvu.Transition<bool, bool>(Message, []);
  end function;

  function ViewBounds(State: bool): E.Element<bool>;
  begin
    return if State then Bounded() else UiButtons.Button<bool>('change', 'Change', true) end if;
  end function;
begin
  var Rejected: bool := false;
  try
    discard Validation.Prepare<bool>(Bounded(), Validation.Target.Terminal);
  catch Error: Sys.ArgumentException do
    Rejected := true;
    if Mixed and not Error.Message.Contains('same measure units') then
      raise new Sys.InvalidOperationException('Mixed bounds need a clear validation error.');
    end if;
  end try;

  if Rejected = Valid then
    raise new Sys.InvalidOperationException('Incorrect bound validation result.');
  end if;

  if not Valid then
    using const Session: App.HeadlessSession := App.StartHeadless<bool, bool>(
      false,
      UpdateBounds,
      ViewBounds,
      20,
      5
    );
    const Before: App.Frame := Session.Snapshot();
    discard Send(Session, 'change');
    case Session.Step() of
      when App.StepResult.Failed(_, const FrameId: long, const Stage: string, const Reason: string):
        if FrameId <> Before.Id or Stage <> 'view' or (Mixed and not Reason.Contains(
          'same measure units'
        ))
        then
          raise new Sys.InvalidOperationException(
            'Invalid bounds did not fail in view validation.'
          );
        end if;
      else
        raise new Sys.InvalidOperationException('Invalid bounds did not fail the session step.');
    end case;

    if Session.Snapshot().Id <> Before.Id then
      raise new Sys.InvalidOperationException('Invalid bounds replaced the previous frame.');
    end if;
  end if;
end procedure;

procedure CheckBoundUnits();
begin
  for Axis: int := 0 to 1 do
    const Horizontal: bool := Axis = 0;
    CheckBounds(L.Measure.Cells(2), L.Measure.Logical(8), Horizontal, false, true);
    CheckBounds(L.Measure.Logical(8), L.Measure.Cells(2), Horizontal, false, true);
    CheckBounds(L.Measure.Cells(1), L.Measure.Cells(2), Horizontal, true, false);
    CheckBounds(L.Measure.Logical(8), L.Measure.Logical(16), Horizontal, true, false);
    CheckBounds(L.Measure.Cells(2), L.Measure.Cells(1), Horizontal, false, false);
    CheckBounds(L.Measure.Logical(16), L.Measure.Logical(8), Horizontal, false, false);
  end for;
end procedure;

procedure CheckPresentation();
  procedure Output(Value: string);
  begin
    Writes := Writes + 1;
    Last := Value;
    if FailNext then
      FailNext := false;
      raise new IO.IOException('simulated partial output');
    end if;
  end procedure;
begin
  var Writes: int := 0;
  var Last: string := '';
  var FailNext: bool := false;
  const Draw: procedure(int, int, array of T.Cell) := P.Create(Output);
  const Style: T.Style := new T.Style();
  const Initial: array of T.Cell := [new T.Cell('a', Style), new T.Cell('b', Style)];
  const Changed: array of T.Cell := [Initial[0], new T.Cell('c', Style)];
  Draw(2, 1, Initial);
  Draw(2, 1, Initial);
  if Writes <> 1 then
    raise new Sys.InvalidOperationException('Unchanged cells caused another terminal write.');
  end if;

  FailNext := true;
  Draw(2, 1, Changed);
  if Writes <> 3 or not Last.Contains('[2J') or not Last.Contains('ac') then
    raise new Sys.InvalidOperationException('Presentation did not recover with one full redraw.');
  end if;

  Draw(2, 1, Changed);
  if Writes <> 3 then
    raise new Sys.InvalidOperationException('The recovered frame did not become the baseline.');
  end if;
end procedure;

procedure ExpectFocus(Session: App.HeadlessSession; Expected: string);
begin
  var Actual: string := '';
  for Control: App.ControlSnapshot in Session.Snapshot().Controls do
    if Control.Focused then
      Actual := Control.Id;
      break;
    end if;
  end for;

  if Actual <> Expected then
    raise new Sys.InvalidOperationException('Expected focus ' + Expected + ', got ' + Actual);
  end if;
end procedure;

procedure Turn(Session: App.HeadlessSession; Event: App.Input);
begin
  discard Session.Send(Event);
  discard Session.Step();
end procedure;

procedure CheckReuse();
  function UpdateValue(State: int; Message: int): Mvu.Transition<int, int>;
  begin
    return new Mvu.Transition<int, int>(Message, []);
  end function;

  function Build(Dependency: int): E.Element<int>;
  begin
    Builds := Builds + 1;
    return UiButtons.Button<int>('stable', 'Stable', Dependency);
  end function;

  function Cached(State: int): E.Element<int>;
  begin
    return E.CachedSubview<int, int>(
      'stable-subview',
      0,
      Build,
      function(A: int; B: int): bool => A = B
    );
  end function;
begin
  var Builds: int := 0;
  using const Resized: App.HeadlessSession := App.StartHeadless<int, int>(
    0,
    UpdateValue,
    Cached,
    20,
    8
  );
  Turn(Resized, App.Input.Resize(11, 3));
  if Builds <> 1 then
    raise new Sys.InvalidOperationException('Resize rebuilt an equivalent subview.');
  end if;

  using const Fresh: App.HeadlessSession := App.StartHeadless<int, int>(
    0,
    UpdateValue,
    Cached,
    11,
    3
  );
  const ReusedFrame: App.Frame := Resized.Snapshot();
  const FreshFrame: App.Frame := Fresh.Snapshot();
  if Builds <> 2 or ReusedFrame.Controls[0] <> FreshFrame.Controls[0] then
    raise new Sys.InvalidOperationException(
      'Cache reuse changed routing or crossed session boundaries.'
    );
  end if;

  for Index: int := 0 to FreshFrame.Cells.Length - 1 do
    if ReusedFrame.Cells[Index] <> FreshFrame.Cells[Index] then
      raise new Sys.InvalidOperationException('Reused cells differ from a fresh render.');
    end if;
  end for;

  const Rules: array of L.Flex := [
    new L.Flex(Minimum := L.Measure.Cells(2), Maximum := L.Measure.Cells(6), Grow := 1),
    new L.Flex(Minimum := L.Measure.Cells(3), Maximum := L.Measure.Cells(9), Grow := 1)
  ];
  const Grown: array of int := F.Allocate([4, 4], [Lower.Flex(Rules[0]), Lower.Flex(Rules[1])], 11);
  const Shrunk: array of int := F.Allocate([4, 4], [Lower.Flex(Rules[0]), Lower.Flex(Rules[1])], 4);
  if Grown[0] <> 6 or Grown[1] <> 5 or Shrunk[0] <> 2 or Shrunk[1] <> 3 then
    raise new Sys.InvalidOperationException('Unexpected bounded cell allocation.');
  end if;
end procedure;

procedure CheckLiveTheme();
  function UpdateTheme(State: bool; Message: bool): Mvu.Transition<bool, bool>;
  begin
    return new Mvu.Transition<bool, bool>(Message, []);
  end function;

  function ThemeFor(State: bool): TerminalThemes.Theme;
  begin
    const Background: G.Color := if State then new G.Color(
        $39,
        $56,
        $6C
      )
      else new G.Color($10, $20, $30)
      end if;
    return new TerminalThemes.Theme(
      Colors := new TerminalThemes.Palette(
        Foreground := new G.Color($D0, $E2, $F5),
        Background := Background
      )
    );
  end function;

  function StableView(State: bool): E.Element<bool>;
  begin
    return E.Column<bool>(
      E.CellStyled<bool>(
        UiButtons.Button<bool>('theme', 'Change color', true),
        new T.Style(Foreground := $E0ECF5)
      )
    );
  end function;
begin
  using const Session: App.HeadlessSession := App.StartHeadless<bool, bool>(
    false, UpdateTheme, StableView, 20, 5, ThemeFor
  );
  const Original: App.Frame := Session.Snapshot();
  Turn(Session, App.Input.Activate('theme'));
  const Recolored: App.Frame := Session.Snapshot();
  const Last: int := Recolored.Cells.Length - 1;
  if Recolored.Id <= Original.Id or Original.Cells[Last].Colors.Background <> $102030
    or Recolored.Cells[Last].Colors.Background <> $39566C
  then
    raise new Sys.InvalidOperationException('The custom theme did not repaint unchanged rows.');
  end if;

  ExpectFocus(Session, 'theme');
  Turn(Session, App.Input.Activate('theme'));
  if Session.Snapshot().Id <> Recolored.Id then
    raise new Sys.InvalidOperationException(
      'Equivalent theme colors should preserve the current frame.'
    );
  end if;
end procedure;

begin
  CheckCancellation();
  CheckQueue();
  CheckFailure();
  CheckBoundUnits();
  CheckPresentation();
  CheckReuse();
  CheckLiveTheme();
  Console.WriteLine('headless contracts verified');
end;
end program;
