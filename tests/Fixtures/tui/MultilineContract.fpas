program MultilineContract;

uses Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Tui.Application as App, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.TerminalExtensions.Input as InputKeys, Fpas.Ui.Editors as Editors, Fpas.Ui.Themes as Themes, System as Sys, System.Console as Console;

type Model = record
  public Text: string := '';
  public Position: Editors.EditorPosition := new Editors.EditorPosition();
  public Edits: int := 0;
end record;

type Msg = union
  Edit(Change: Editors.TextEdit);
  Navigate(Position: Editors.EditorPosition);
end union;

function Edited(Change: Editors.TextEdit): Msg;
begin
  return Msg.Edit(Change);
end function;

function Navigated(Position: Editors.EditorPosition): Msg;
begin
  return Msg.Navigate(Position);
end function;

function Update(State: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  const Next: Model := case Message of
    when Msg.Edit(const Change: Editors.TextEdit): new Model(
      Change.Text,
      Change.Position,
      State.Edits + 1
    );
    when Msg.Navigate(const Position: Editors.EditorPosition): State with
      Position := Position;
    end with;
  end case;
  return new Mvu.Transition<Model, Msg>(Next, []);
end function;

function View(State: Model): E.Element<Msg>;
begin
  return E.Column<Msg>(
    E.Size<Msg>(
      E.Multiline<Msg>('editor', State.Text, State.Position, Edited, Navigated),
      new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(3)), Minimum := L.Measure.Cells(3))
    ),
    E.Text<Msg>('Edits ' + State.Edits.ToString())
  );
end function;

procedure Turn(Session: App.HeadlessSession; Input: App.Input);
begin
  case Session.Send(Input) of
    when App.Admission.Queued(const Id: long):
      case Session.Step() of
        when App.StepResult.Processed(const Processed: long, _, _):
          if Processed = Id then
            return;
          end if;
        when App.StepResult.Failed(_, _, const Stage: string, const Reason: string):
          raise new Sys.InvalidOperationException(Stage + ' ' + Reason);
        else
      end case;
    else
  end case;

  raise new Sys.InvalidOperationException('Expected one completed input.');
end procedure;

procedure ExpectText(Session: App.HeadlessSession; Expected: string);
begin
  if Session.Snapshot().Controls[0].Value <> Expected then
    raise new Sys.InvalidOperationException('Unexpected document text.');
  end if;
end procedure;

procedure ExpectLines(Session: App.HeadlessSession; params Lines: array of string);
begin
  ExpectText(Session, Sys.String.Join(new string(#10, 1), Lines));
end procedure;

begin
  using const Session: App.HeadlessSession := App.StartHeadless<Model, Msg>(
    new Model(), Update, View, 8, 4, Themes.Dark()
  );
  const Pasted: string := 'A' + new string([#13, #10]) + '界' + new string(#13, 1) + 'C' +
    new string(#8232, 1) + 'D' + new string(#8233, 1) + 'E';
  Turn(Session, App.Input.Paste(Pasted));
  ExpectLines(Session, 'A', '界', 'C', 'D', 'E');
  const End: App.Frame := Session.Snapshot();
  if End.Lines[0].TrimEnd() <> 'C' or End.Lines[2].TrimEnd() <> 'E'
    or End.Cells[17].Colors.Background <> $BEBEBE or End.Lines[3].TrimEnd() <> 'Edits 1'
  then
    raise new Sys.InvalidOperationException('Paste must keep the new caret visible and edit once.');
  end if;

  Turn(Session, App.Input.Scroll(0, 0, -100));
  if Session.Snapshot().Lines[0].TrimEnd() <> 'A' then
    raise new Sys.InvalidOperationException('The wheel must scroll independently of the caret.');
  end if;

  Turn(Session, App.Input.KeyPress(InputKeys.Key.End, InputKeys.KeyModifiers.Ctrl));
  if Session.Snapshot().Lines[
    0
  ].TrimEnd() <> 'C' or Session.Snapshot().Lines[3].TrimEnd() <> 'Edits 1'
  then
    raise new Sys.InvalidOperationException(
      'Navigation must restore caret tracking without editing.'
    );
  end if;

  Turn(Session, App.Input.KeyPress(InputKeys.Key.Home, InputKeys.KeyModifiers.Ctrl));
  Turn(Session, App.Input.KeyPress(InputKeys.Key.Backspace, InputKeys.KeyModifiers.None));
  if Session.Snapshot().Lines[3].TrimEnd() <> 'Edits 1' then
    raise new Sys.InvalidOperationException(
      'Backspace at the document start must leave it unchanged.'
    );
  end if;

  Turn(Session, App.Input.Click(1, 1));
  Turn(Session, App.Input.KeyPress(InputKeys.Key.Delete, InputKeys.KeyModifiers.None));
  ExpectLines(Session, 'A', '', 'C', 'D', 'E');
  Turn(Session, App.Input.KeyPress(InputKeys.Key.Enter, InputKeys.KeyModifiers.None));
  ExpectLines(Session, 'A', '', '', 'C', 'D', 'E');

  Turn(Session, App.Input.KeyPress(InputKeys.Key.End, InputKeys.KeyModifiers.Ctrl));
  Turn(Session, App.Input.TextInput('0123456789'));
  Turn(Session, App.Input.Resize(4, 4));
  const Narrow: App.Frame := Session.Snapshot();
  if Narrow.Lines[2] <> '789 ' or Narrow.Cells[11].Colors.Background <> $BEBEBE then
    raise new Sys.InvalidOperationException(
      'The caret must remain visible on a long line after resize.'
    );
  end if;

  Turn(Session, App.Input.KeyPress(InputKeys.Key.A, InputKeys.KeyModifiers.Ctrl));
  Turn(Session, App.Input.TextInput('Done'));
  ExpectText(Session, 'Done');

  Turn(Session, App.Input.KeyPress(InputKeys.Key.A, InputKeys.KeyModifiers.Ctrl));
  const LF: string := new string(#10, 1);
  Turn(Session, App.Input.Paste('abcd' + LF + 'x' + LF + '0123'));
  Turn(Session, App.Input.KeyPress(InputKeys.Key.Home, InputKeys.KeyModifiers.Ctrl));
  Turn(Session, App.Input.KeyPress(InputKeys.Key.End, InputKeys.KeyModifiers.None));
  Turn(Session, App.Input.KeyPress(InputKeys.Key.Down, InputKeys.KeyModifiers.None));
  Turn(Session, App.Input.KeyPress(InputKeys.Key.Down, InputKeys.KeyModifiers.None));
  Turn(Session, App.Input.KeyPress(InputKeys.Key.Up, InputKeys.KeyModifiers.Shift));
  Turn(Session, App.Input.KeyPress(InputKeys.Key.Backspace, InputKeys.KeyModifiers.None));
  ExpectLines(Session, 'abcd', 'x');
  Console.WriteLine('multiline editor contracts verified');
end;
end program;
