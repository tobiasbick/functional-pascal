// [Documentation](../../../docs/ui/tui/text-and-display/cell-grid.md)

program RenderingContract;

uses
  Fpas.Ui.Widgets.Feedback.Spinners as Spin, Fpas.Ui.Widgets.Charts.Sparklines as Sparks,
  Fpas.Ui.Widgets.Charts.Charts as Charts,
  Fpas.Ui.Widgets.Inputs.Switches as Switches, Fpas.Ui.Widgets.Collections.Tables as Tables, Fpas.Ui.Widgets.Overlays.Dialogs as Dialogs, Fpas.Ui.Widgets.Desktop.StatusBars as Status, Fpas.Ui.Layout as L, Fpas.Ui.Validation as V, Fpas.Ui.Widgets.Feedback.ProgressBars as Bars, Fpas.Ui.Elements as E, Fpas.Ui.Widgets.Theming.Themes as Themes, Fpas.Ui.Graphics as G, Fpas.Ui.Widgets.Developer.Terminal as Terminal, Fpas.Ui.Styles as Styles, Fpas.Ui.Widgets.Actions.Buttons as B, Fpas.Ui.TerminalExtensions.Input as Keys, Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Tui.Application as Tui, Fpas.Ui.Tui.Internal.Layout.Flexible as F, Fpas.Ui.Tui.Internal.Layout.Scene as Scene, Fpas.Ui.Tui.Internal.Controls.Activation as Activation, Fpas.Ui.Tui.Internal.Rendering.Glyphs as Glyphs, Fpas.Ui.Tui.Internal.Rendering.Presentation as Presentation, Fpas.Ui.Tui.Internal.Rendering.Decoration as Decoration, Fpas.Ui.Tui.Internal.Rendering.Themes as RenderThemes, System as Sys, System.Console as Console;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function Update(State: int; Message: int): Mvu.Transition<int, int>;
begin
  return new Mvu.Transition<int, int>(Message, []);
end function;

procedure WideIdeographs();
  function View(State: int): E.Element<int>;
  begin
    return E.Text<int>(Sys.Char.ConvertFromUtf32($30000) + 'A');
  end function;
begin
  Check(Glyphs.Width(Sys.Char.ConvertFromUtf32($2FFFD)) = 2, 'Last plane-two wide boundary.');
  Check(Glyphs.Width(Sys.Char.ConvertFromUtf32($2FFFE)) = 1, 'Plane-two noncharacter boundary.');
  Check(Glyphs.Width(Sys.Char.ConvertFromUtf32($30000)) = 2, 'First plane-three wide boundary.');
  Check(Glyphs.Width(Sys.Char.ConvertFromUtf32($3FFFD)) = 2, 'Last plane-three wide boundary.');
  Check(Glyphs.Width(Sys.Char.ConvertFromUtf32($3FFFE)) = 1, 'Plane-three noncharacter boundary.');
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 4, 1);
  const Cells: array of Terminal.Cell := Session.Snapshot().Cells;
  Check(
    Cells[0].Text = Sys.Char.ConvertFromUtf32($30000) and Cells[1].Text = ''
    and Cells[2].Text = 'A', 'Wide ideograph must reserve a continuation cell.'
  );
  var Output: string := '';
  const Present: procedure(int, int, array of Terminal.Cell) := Presentation.Create(
    procedure(Value: string) begin
      Output := Value;
    end procedure
  );
  Present(4, 1, Cells);
  const Next: array of Terminal.Cell := [Cells[0], Cells[1], Cells[2], Cells[3]];
  Next[2] := new Terminal.Cell('B', Cells[2].Colors);
  Present(4, 1, Next);
  Check(
    Output.Contains(new string(#27, 1) + '[1;3H') and Output.Contains('B'),
    'Incremental presentation must address the cell after a wide ideograph.'
  );
end procedure;

procedure ZeroWidthClusters();
  procedure CheckCluster(Value: string; Painted: string; Span: int);
    function View(State: int): E.Element<int>;
    begin
      return E.Text<int>(Value + 'A');
    end function;
  begin
    using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 6, 1);
    const Frame: Tui.Frame := Session.Snapshot();
    Check(
      Frame.Cells[0].Text = Painted and Frame.Cells[Span].Text = 'A',
      'Normalized clusters must leave adjacent text at its measured cell.'
    );
    Check(
      Glyphs.Measure(Value + 'A') = Span + 1,
      'Measurement must use the same normalized clusters as drawing.'
    );
    var Output: string := '';
    const Present: procedure(int, int, array of Terminal.Cell) := Presentation.Create(
      procedure(Text: string) begin
        Output := Text;
      end procedure
    );
    Present(6, 1, Frame.Cells);
    Check(
      Output.Contains(Painted + 'A'),
      'Presentation must emit the normalized cluster followed by adjacent text.'
    );
    const Next: array of Terminal.Cell := cast<array of Terminal.Cell>(Frame.Cells.Clone());
    Next[Span] := new Terminal.Cell('B', Frame.Cells[Span].Colors);
    Present(6, 1, Next);
    Check(
      Output.Contains(new string(#27, 1) + '[1;' + (Span + 1).ToString() + 'H')
      and Output.Contains('B'),
      'Incremental repaint must address the cell after the normalized cluster.'
    );
  end procedure;
begin
  CheckCluster(Sys.Char.ConvertFromUtf32($200B), ' ', 1);
  CheckCluster(Sys.Char.ConvertFromUtf32($200D), ' ', 1);
  CheckCluster(Sys.Char.ConvertFromUtf32($FE0F), ' ', 1);
  CheckCluster(Sys.Char.ConvertFromUtf32($301), ' ', 1);
  const Accented: string := 'e' + Sys.Char.ConvertFromUtf32($301);
  CheckCluster(Accented, Accented, 1);
  const Emoji: string := Sys.Char.ConvertFromUtf32($1F469) +
    Sys.Char.ConvertFromUtf32($200D) + Sys.Char.ConvertFromUtf32($1F4BB);
  CheckCluster(Emoji, Emoji, 2);
  const Heart: string := Sys.Char.ConvertFromUtf32($2764) + Sys.Char.ConvertFromUtf32($FE0F);
  CheckCluster(Heart, Heart, 2);
end procedure;

procedure DisabledForeground();
  function View(State: int): E.Element<int>;
  begin
    return B.Button<int>(
      'disabled', 'Disabled', 1,
      new B.Options(Enabled := false, Color := new G.Color(255, 0, 0))
    );
  end function;
begin
  const Theme: Themes.Theme := Themes.Dark();
  const Resolved: RenderThemes.Theme := RenderThemes.Resolve(Theme);
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(
    0,
    Update,
    View,
    20,
    3,
    Theme
  );
  const Frame: Tui.Frame := Session.Snapshot();
  const Bounds: Tui.ControlSnapshot := Frame.Controls[0];
  const Index: int := Bounds.Row * 20 + Bounds.Column + 1;
  Check(
    Frame.Cells[Index].Colors.Foreground = Resolved.Buttons.Disabled.Foreground,
    'Disabled styling must override a custom foreground.'
  );
  discard Session.Send(Tui.Input.Pointer(Keys.PointerKind.Move, Bounds.Column, Bounds.Row));
  discard Session.Step();
  Check(
    Session.Snapshot().Cells[Index].Colors.Foreground = Resolved.Buttons.Disabled.Foreground,
    'A pointer over a disabled button must preserve disabled styling.'
  );
  const Control: Scene.Control<int> := new Scene.Control<int>(
    'disabled',
    'Disabled',
    'button',
    '',
    new F.Rect(Bounds.Column, Bounds.Row, Bounds.Width, Bounds.Height),
    '',
    '',
    false,
    Scene.Binding<int>.Invoke(
      new Activation.Direct<int>(1)
    ),
    Styles.ButtonVariant.Default,
    ButtonStyle := true,
    Foreground := new G.Color(255, 0, 0)
  );
  Decoration.Apply<int>(Frame.Cells, 20, Control, Resolved, false);
  Check(
    Frame.Cells[Index].Colors.Foreground = Resolved.Buttons.Disabled.Foreground,
    'Disabled precedence must also hold during hover decoration.'
  );
end procedure;

procedure BorderlessStatus();
  function View(State: int): E.Element<int>;
  begin
    return E.Column<int>(
      Status.StatusBar<int>(
        'status', [
          Status.Item<int>.Progress(0.0F, 'Scanning', 0.0F, true),
          Status.Item<int>.Spacer,
          Status.Item<int>.Action('encoding', new Status.Label(''), 'UTF-8', false, 1)
        ], true
      ),
      E.Text<int>('Next row')
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 24, 2);
  const Frame: Tui.Frame := Session.Snapshot();
  Check(
    Frame.Lines[0].StartsWith('Scanning …') and Frame.Lines[0].EndsWith('UTF-8'),
    'A borderless status row aligns a trailing action across the available width.'
  );
  Check(Frame.Lines[1].TrimEnd() = 'Next row', 'A borderless status bar occupies exactly one row.');
  Check(
    Frame.Controls.Length = 1 and not Frame.Controls[0].Enabled and not Frame.Controls[0].Focused,
    'A disabled status action is visible and cannot receive focus.'
  );
end procedure;

procedure PersistentDialog();
  function View(State: int): E.Element<int>;
  begin
    return Dialogs.Dialog<int>(
      'modal', B.Button<int>('open', 'Open', 1), B.Button<int>('done', 'Done', 0),
      State = 1, new Dialogs.Options('Review', Persistent := true, CloseButton := false), 0
    );
  end function;
  procedure Reject(Settings: Dialogs.Options);
  begin
    try
      discard V.Prepare<int>(
        Dialogs.Dialog<int>('modal', E.Text<int>('Base'), E.Text<int>('Body'), false, Settings, 0),
        V.Target.Terminal
      );
    catch Error: Sys.ArgumentException do
      Check(Error.Message.Contains('Graphical profile'), Error.Message);
      return;
    end try;

    raise new Sys.InvalidOperationException('Moving or resizing a dialog requires the GUI.');
  end procedure;
  procedure Send(Session: Tui.HeadlessSession; Event: Tui.Input);
  begin
    discard Session.Send(Event);
    discard Session.Step();
  end procedure;
begin
  discard V.Prepare<int>(View(1), V.Target.Portable);
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 64, 16);
  Send(Session, Tui.Input.Activate('open'));
  const Opened: Tui.Frame := Session.Snapshot();
  Check(
    Opened.Controls.Length = 2 and not Opened.Controls[0].Enabled
    and Opened.Controls[1].Id = 'done' and Opened.Controls[1].Focused,
    'Without a header button the body must receive focus.'
  );
  Send(Session, Tui.Input.KeyPress(Keys.Key.Escape, Keys.KeyModifiers.None));
  Send(Session, Tui.Input.Pointer(Keys.PointerKind.Press, 0, 0));
  Send(Session, Tui.Input.Pointer(Keys.PointerKind.Release, 0, 0));
  Check(
    Session.Snapshot().Controls[1].Focused,
    'A persistent dialog must keep focus on Escape and backdrop clicks.'
  );
  Send(Session, Tui.Input.Activate('done'));
  const Closed: Tui.Frame := Session.Snapshot();
  Check(
    Closed.Controls.Length = 1 and Closed.Controls[0].Id = 'open' and Closed.Controls[0].Focused,
    'Explicit completion must restore focus to the opener.'
  );
  Reject(new Dialogs.Options('Drag', Draggable := true));
  Reject(new Dialogs.Options('Resize', Resizable := true));
end procedure;

procedure ProgressTracks();
  function View(State: int): E.Element<int>;
  begin
    return E.Column<int>(
      Bars.ProgressBar<int>(
        'plain',
        0.5F,
        new Bars.Options(Width := L.Extent.Fixed(L.Measure.Cells(7)))
      ),
      Bars.ProgressBar<int>(
        'full',
        1.0F,
        new Bars.Options(ShowValue := true, Tone := Styles.Tone.Info)
      ),
      Bars.ProgressBar<int>(
        'empty',
        0.0F,
        new Bars.Options(Width := L.Extent.Fixed(L.Measure.Cells(0)))
      )
    );
  end function;
  procedure Reject(Options: Bars.Options);
  begin
    try
      discard V.Prepare<int>(Bars.ProgressBar<int>('sample', 0.5F, Options), V.Target.Terminal);
    catch Error: Sys.ArgumentException do
      Check(Error.Message.Contains('Graphical profile'), Error.Message);
      return;
    end try;

    raise new Sys.InvalidOperationException('Animated progress or a custom height requires GUI.');
  end procedure;
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 12, 4);
  const Frame: Tui.Frame := Session.Snapshot();
  Check(Frame.Lines[0].TrimEnd() = '───────', 'Fixed-width continuous track.');
  const Filled: int? := Frame.Cells[0].Colors.Foreground;
  const Remaining: int? := Frame.Cells[6].Colors.Foreground;
  Check(
    Filled <> Remaining and Frame.Cells[3].Colors.Foreground = Filled
    and Frame.Cells[4].Colors.Foreground = Remaining, 'Half of seven rounds to four filled cells.'
  );
  Check(Frame.Lines[1] = '──────  100%', 'Track and percentage occupy one row.');
  Check(
    Frame.Lines[2].Trim() = '' and Frame.Controls.Length = 0,
    'Zero width and display-only input.'
  );
  Reject(new Bars.Options(Indeterminate := true));
  Reject(new Bars.Options(Dither := true));
  Reject(new Bars.Options(Height := 3.0F));
end procedure;

procedure SwitchRows();
  function DisabledChange(Value: bool): int;
  begin
    raise new Sys.InvalidOperationException('Disabled or unactivated switch invoked its mapper.');
  end function;
  function View(State: int): E.Element<int>;
  begin
    return E.ScrollView<int>(
      'settings', E.Column<int>(
        Switches.Switch<int>(
          'first', 'Wi-Fi', State = 1, function(Value: bool): int => if Value then
            1
          else
            0
          end if, 'Two lines of description'
        ),
        Switches.Switch<int>('blocked', 'Disabled', false, DisabledChange, Enabled := false),
        Switches.Switch<int>('locked', 'Locked', false, function(Value: bool): int => State)
      )
    );
  end function;
  procedure Send(Session: Tui.HeadlessSession; Input: Tui.Input);
  begin
    discard Session.Send(Input);
    case Session.Step() of
      when Tui.StepResult.Failed(_, _, _, const Reason: string):
        raise new Sys.Exception(Reason);
      else
    end case;
  end procedure;
begin
  discard V.Prepare<int>(View(0), V.Target.Portable);
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 14, 8);
  const Initial: Tui.Frame := Session.Snapshot();
  const Row: Tui.ControlSnapshot := Initial.Controls[0];
  Check(
    Row.Role = 'switch' and Row.Value = 'false' and Row.Focused and Row.Height = 3,
    'Wrapped description belongs to one switch.'
  );
  Check(
    Initial.Lines[0].Contains('[●─] Off') and Initial.Lines[1].Contains('Two lines'),
    'Switch is readable without color.'
  );
  Send(Session, Tui.Input.Click(Row.Column + 1, Row.Row + 2));
  Check(
    Session.Snapshot().Controls[
      0
    ].Value = 'true' and Session.Snapshot().Lines[0].Contains('[─●] On'),
    'Clicking the wrapped description proposes the next value.'
  );
  Send(Session, Tui.Input.Character(' '));
  Check(Session.Snapshot().Controls[0].Value = 'false', 'Space toggles the model-owned value.');
  const Blocked: Tui.ControlSnapshot := Session.Snapshot().Controls[1];
  Send(Session, Tui.Input.Click(Blocked.Column, Blocked.Row));
  Send(Session, Tui.Input.Activate('blocked'));
  Check(
    not Blocked.Enabled and not Session.Snapshot().Controls[1].Focused,
    'Disabled switch ignores mouse and direct activation.'
  );
  Send(Session, Tui.Input.KeyPress(Keys.Key.Tab, Keys.KeyModifiers.None));
  Check(Session.Snapshot().Controls[2].Focused, 'Tab skips disabled switches.');
  Send(Session, Tui.Input.KeyPress(Keys.Key.Enter, Keys.KeyModifiers.None));
  Check(Session.Snapshot().Controls[2].Value = 'false', 'A model can decline the proposed change.');
end procedure;

procedure ActivityAndPlots();
  function View(State: int): E.Element<int>;
  begin
    return E.Column<int>(
      Spin.Spinner<int>(
        'activity', 8.0F,
        new Spin.Options(Color := Charts.Color.Rgba(new G.Color(255, 0, 0, 255)))
      ),
      Sparks.Sparkline<int>('signed', [-3.0F, -1.0F, 0.0F]),
      Sparks.Sparkline<int>('empty', []),
      Sparks.Sparkline<int>('flat', [2.0F, 2.0F]),
      Sparks.Sparkline<int>(
        'expanded', [0.0F, 1.0F],
        new Sparks.Options(Width := L.Extent.Fixed(L.Measure.Cells(5)), Height := 32.0F)
      )
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 8, 7);
  const Frame: Tui.Frame := Session.Snapshot();
  Check(
    Frame.Cells[0].Text = '◴' and Frame.Cells[0].Colors.Foreground = $FF0000,
    'The spinner paints its deterministic initial glyph in the requested color.'
  );
  Check(Frame.Controls.Length = 0, 'Activity and plots do not take focus.');
  Check(Frame.Lines[1].StartsWith('▁▆█'), 'Sparkline normalizes signed samples.');
  Check(Frame.Lines[2].Trim() = '', 'Empty sparklines stay blank.');
  Check(Frame.Lines[3].StartsWith('▅▅'), 'Constant samples use a common middle level.');
  Check(
    Frame.Lines[4].StartsWith('  ▁▄█') and Frame.Lines[5].StartsWith('▁▅███'),
    'An expanded sparkline interpolates across columns and fills from the bottom.'
  );
  discard Session.Step();
  Check(Session.Snapshot().Id = Frame.Id, 'Manual sessions retain the same spinner frame.');
end procedure;

procedure TextTable();
  function View(State: int): E.Element<int>;
  begin
    return Tables.Table<int>(
      'measures', [
        new Tables.Column('Key', L.Extent.Fixed(L.Measure.Cells(3))),
        new Tables.Column('N', Align := Tables.Alignment.Right)
      ], [new Tables.Row<int>('value', [Tables.Cell<int>.Text('A界Z'), Tables.Cell<int>.Text('7')])]
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Update, View, 9, 3);
  const Frame: Tui.Frame := Session.Snapshot();
  Check(Frame.Lines[0] = 'Key     N' and Frame.Controls.Length = 0, 'Read-only table headings.');
  Check(
    Frame.Cells[9].Text = 'A' and Frame.Cells[10].Text = '界' and Frame.Cells[11].Text = ''
    and Frame.Cells[12].Text = ' ' and Frame.Cells[17].Text = '7',
    'Clip a wide text cell at its own boundary and right-align the next cell.'
  );
  try
    discard V.Prepare<int>(
      Tables.Table<int>(
        'people', [new Tables.Column('Person')],
        [new Tables.Row<int>('person', [Tables.Cell<int>.Content([E.Text<int>('Name')])])]
      ), V.Target.Terminal
    );
  catch Error: Sys.ArgumentException do
    Check(Error.Message.Contains('Graphical profile'), Error.Message);
    return;
  end try;

  raise new Sys.InvalidOperationException('Composed table cells require the GUI.');
end procedure;

begin
  SwitchRows();
  TextTable();
  ActivityAndPlots();
  BorderlessStatus();
  PersistentDialog();
  ProgressTracks();
  WideIdeographs();
  ZeroWidthClusters();
  DisabledForeground();
  Console.WriteLine('Rendering contracts verified');
end;

end program;
