program SharedContract;

uses Fpas.Ui.Mvu.Application as Mvu, Fpas.Ui.Tui.Application as App, Fpas.Ui.Elements as E, Fpas.Ui.Editors as Ed, Fpas.Ui.Choices as C, Fpas.Ui.Layout as L, Fpas.Ui.Validation as V, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Views as Views, Fpas.Ui.TerminalExtensions.Input as Keys, System as Sys, System.Console as Console;

var Callbacks: int := 0;
var Updates: int := 0;
var Draws: int := 0;
var LastMessage: int := 0;

procedure Check(Condition: bool; Reason: string);
begin
  if not Condition then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

function Change(Value: bool): int;
begin
  Callbacks := Callbacks + 1;
  return if Value then 1 else 0 end if;
end function;

function Update(Model: int; Message: int): Mvu.Transition<int, int>;
begin
  Updates := Updates + 1;
  LastMessage := Message;
  return new Mvu.Transition<int, int>(Message, []);
end function;

function SelectKey(Key: string): int;
begin
  return if Key = 'last' then 2 elsif Key = 'readonly' then 3 else 1 end if;
end function;

function Disabled(Model: int): E.Element<int>;
begin
  return E.Column<int>(
    [
      E.Checkbox<int>('toggle', 'Toggle', false, Change, false),
      E.List<int>('actions', [new C.ListItem<int>('a', 'Action', 1)], false),
      E.SelectionList<int>(
        'list',
        [new C.SelectionItem('a', 'A')],
        'a',
        SelectKey,
        Enabled := false
      ),
      E.Table<int>(
        'table',
        [new C.TableColumn('Name')],
        [new C.TableRow('a', ['A'])],
        'a',
        SelectKey,
        Enabled := false
      ),
      E.Tabs<int>(
        'tabs',
        [new C.TabItem('a', 'A')],
        'a',
        SelectKey,
        function(Key: string): E.Element<int> => E.Text<int>('Panel'),
        false
      ),
      E.Button<int>('next', 'Next', 4)
    ]
  );
end function;

procedure Turn(Session: App.HeadlessSession; Input: App.Input);
begin
  discard Session.Send(Input);
  discard Session.Step();
end procedure;

procedure DisabledControls();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<int, int>(
    0,
    Update,
    Disabled,
    60,
    18
  );
  for Control: App.ControlSnapshot in Session.Snapshot().Controls do
    Check(
      Control.Enabled = (Control.Id = 'next'),
      'A disabled collection accepted focus: ' + Control.Id
    );
    Check(Control.Focused = (Control.Id = 'next'), 'Disabled focus order: ' + Control.Id);
    if Control.Id <> 'next' then
      Turn(Session, App.Input.Activate(Control.Id));
    end if;
  end for;

  Check(Callbacks = 0 and Updates = 0, 'Disabled input ran a mapper or update.');
end procedure;

procedure RoutingReuse();
  function View(Model: int): E.Element<int>;
  begin
    return E.Checkbox<int>('toggle', 'Same view', false, function(Value: bool): int => Model + 1);
  end function;
begin
  using const Session: App.HeadlessSession := App.StartHeadless<int, int>(0, Update, View, 30, 3);
  const Frame: long := Session.Snapshot().Id;
  Turn(Session, App.Input.Activate('toggle'));
  Turn(Session, App.Input.Activate('toggle'));
  Check(
    Session.Snapshot().Id = Frame and LastMessage = 2,
    'Frame reuse retained a stale callback.'
  );
end procedure;

function Toggle(Model: int): E.Element<int>;
begin
  return E.Checkbox<int>('toggle', 'Toggle', Model = 1, Change);
end function;

procedure ToggleInput();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<int, int>(0, Update, Toggle, 30, 4);
  Check(Callbacks = 0, 'Drawing evaluated a checkbox mapper.');
  Turn(Session, App.Input.Character(' '));
  Check(
    Callbacks = 1 and Updates = 1 and Session.Snapshot().Controls[0].Value = 'true',
    'Space did not toggle exactly once.'
  );
  Turn(Session, App.Input.KeyPress(Keys.Key.Enter, Keys.KeyModifiers.None));
  Check(
    Callbacks = 2 and Updates = 2 and Session.Snapshot().Controls[0].Value = 'false',
    'Enter did not toggle exactly once.'
  );
end procedure;

function Selectable(Model: int): E.Element<int>;
begin
  return E.SelectionList<int>(
    'list',
    [
      new C.SelectionItem('first', 'First'),
      new C.SelectionItem('disabled', 'Disabled', false),
      new C.SelectionItem('readonly', 'Read only', CanActivate := false),
      new C.SelectionItem('last', 'Last')
    ],
    if Model = 2 then 'last' elsif Model = 3 then 'readonly' else 'first' end if,
    SelectKey,
    SelectKey
  );
end function;

procedure Selection();
begin
  Updates := 0;
  using const Session: App.HeadlessSession := App.StartHeadless<int, int>(
    0,
    Update,
    Selectable,
    30,
    4
  );
  Turn(Session, App.Input.KeyPress(Keys.Key.Down, Keys.KeyModifiers.None));
  Check(
    Session.Snapshot().Controls[0].Value = 'readonly' and Updates = 1,
    'Navigation did not skip a disabled item.'
  );
  Turn(Session, App.Input.Activate('list'));
  Check(Updates = 1, 'CanActivate=false did not suppress activation.');
  Turn(Session, App.Input.KeyPress(Keys.Key.End, Keys.KeyModifiers.None));
  Check(
    Session.Snapshot().Controls[0].Value = 'last' and Updates = 2,
    'End did not select the final enabled item.'
  );
end procedure;

function Reject(Model: int; Message: Ed.TextEdit): Mvu.Transition<int, Ed.TextEdit>;
begin
  return new Mvu.Transition<int, Ed.TextEdit>(Model, []);
end function;

function Editor(Model: int): E.Element<Ed.TextEdit>;
begin
  return E.TextInput<Ed.TextEdit>(
    'editor', 'abc', new Ed.EditorPosition(1, 1),
    function(Edit: Ed.TextEdit): Ed.TextEdit => Edit,
    function(Position: Ed.EditorPosition): Ed.TextEdit => new Ed.TextEdit('abc', Position)
  );
end function;

procedure ControlledEditor();
begin
  using const Session: App.HeadlessSession := App.StartHeadless<int, Ed.TextEdit>(
    0,
    Reject,
    Editor,
    20,
    2
  );
  Turn(Session, App.Input.Paste('x'));
  Check(Session.Snapshot().Controls[0].Value = 'abc', 'A rejected edit changed the document.');
  Turn(Session, App.Input.KeyPress(Keys.Key.End, Keys.KeyModifiers.None));
  Turn(Session, App.Input.Paste('y'));
  Check(
    Session.Snapshot().Controls[
      0
    ].Value = 'abc' and Session.Snapshot().Controls[0].Position = new Ed.EditorPosition(
      1,
      1
    ),
    'Rejected navigation changed authoritative selection.'
  );
end procedure;

function Draw(Column: int; Row: int): T.Cell;
begin
  Draws := Draws + 1;
  return new T.Cell('x', new T.Style());
end function;

procedure Rejected(Tree: E.Element<int>; Profile: V.Target; Part: string);
begin
  var Failed: bool := false;
  try
    discard V.Prepare<int>(Tree, Profile);
  catch Error: Sys.ArgumentException do
    Failed := Error.Message.Contains(Part);
  end try;

  Check(Failed, 'Missing preflight diagnostic: ' + Part);
end procedure;

procedure Profiles();
begin
  Rejected(
    Views.Screen<int>(
      E.Text<int>('keys'),
      [],
      [new Keys.ShortcutBinding<int>(Keys.Key.F1, Keys.KeyModifiers.None, 0, 'x')]
    ),
    V.Target.Terminal,
    'character shortcut'
  );
  Rejected(
    Views.Screen<int>(
      E.Text<int>('keys'),
      [],
      [
        Keys.Shortcut<int>(Keys.Key.F1, Keys.KeyModifiers.None, 0),
        Keys.Shortcut<int>(Keys.Key.F1, Keys.KeyModifiers.None, 1)
      ]
    ),
    V.Target.Terminal,
    'Duplicate shortcut'
  );
  Rejected(E.Canvas<int>('gui', 5, 5, []), V.Target.Terminal, 'gui');
  discard V.Prepare<int>(
    E.Size<int>(E.Text<int>('units'), new L.Flex(Basis := L.Extent.Fixed(L.Measure.Logical(4)))),
    V.Target.Portable
  );
  Rejected(
    E.Element<int>.TerminalFixedCanvas('fixed', 0, 1, Draw, new T.CanvasEvents<int>()),
    V.Target.Terminal,
    'fixed'
  );
  Rejected(
    Views.Panel<int>(E.Text<int>('body'), E.Text<int>('footer')),
    V.Target.Graphical,
    'Terminal'
  );
  Rejected(
    Views.Viewport<int>(
      'window',
      function(Size: T.Viewport): E.Element<int> => E.Text<int>('size')
    ),
    V.Target.Terminal,
    'context'
  );
  var Failed: bool := false;
  try
    using const Session: App.HeadlessSession := App.StartHeadless<int, int>(
      0,
      Update,
      function(Model: int): E.Element<int> => E.Column<int>(
        E.CellCanvas<int>('terminal', Draw, new T.CanvasEvents<int>()),
        E.Canvas<int>('gui', 5, 5, [])
      ),
      30,
      5
    );
  catch Error: Sys.ArgumentException do
    Failed := Error.Message.Contains('gui');
  end try;

  Check(Failed and Draws = 0, 'An incompatible view reached drawing.');
end procedure;

procedure SingleLineViewport();
  function Update(Model: Ed.TextEdit; Message: Ed.TextEdit): Mvu.Transition<Ed.TextEdit, Ed.TextEdit>;
  begin
    return new Mvu.Transition<Ed.TextEdit, Ed.TextEdit>(Message, []);
  end function;
  function View(Model: Ed.TextEdit): E.Element<Ed.TextEdit>;
  begin
    return E.TextInput<Ed.TextEdit>(
      'field', Model.Text, Model.Position,
      function(Change: Ed.TextEdit): Ed.TextEdit => Change,
      function(Position: Ed.EditorPosition): Ed.TextEdit => new Ed.TextEdit(Model.Text, Position)
    );
  end function;
begin
  using const Session: App.HeadlessSession := App.StartHeadless<Ed.TextEdit, Ed.TextEdit>(
    new Ed.TextEdit('a界界cdef', new Ed.EditorPosition(7, 7)), Update, View, 8, 1
  );
  const Frame: App.Frame := Session.Snapshot();
  Check(
    Frame.Cells[
      2
    ].Text = ' ' and Frame.Cells[3].Text = 'c' and Frame.Cells[7].Colors.Background = $353535,
    'Single-line text and caret used different cell viewports.'
  );
  Turn(Session, App.Input.Click(4, 0));
  Check(
    Session.Snapshot().Controls[0].Position = new Ed.EditorPosition(4, 4),
    'Single-line hit testing used different cell geometry.'
  );
end procedure;

procedure HostScroll();
  function View(Model: int): E.Element<int>;
  begin
    return E.ScrollView<int>(
      'scroll',
      E.Column<int>(
        [E.Text<int>('one'), E.Text<int>('two'), E.Text<int>('three'), E.Text<int>('four')]
      ),
      Model = 0
    );
  end function;
begin
  using const Visible: App.HeadlessSession := App.StartHeadless<int, int>(0, Update, View, 10, 2);
  Check(Visible.Snapshot().Cells[9].Text = '█', 'Host-owned scrollbar missing.');
  Turn(Visible, App.Input.Scroll(0, 0, 2));
  Check(
    Visible.Snapshot().Lines[0].StartsWith('three'),
    'Host-owned scrolling did not move content.'
  );
  using const Hidden: App.HeadlessSession := App.StartHeadless<int, int>(1, Update, View, 10, 2);
  Check(Hidden.Snapshot().Cells[9].Text = ' ', 'ShowScrollbar=false was ignored.');
end procedure;

begin
  SingleLineViewport();
  HostScroll();
  DisabledControls();
  ToggleInput();
  Selection();
  ControlledEditor();
  Profiles();
  RoutingReuse();
  Console.WriteLine('shared terminal contracts verified');
end;
end program;
