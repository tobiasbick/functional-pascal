program TableContract;

uses Fpas.Ui.Validation as V, Fpas.Mvu.Application as Mvu, Fpas.Tui.Application as App, Fpas.Ui.Elements as E, Fpas.Ui.Layout as L, Fpas.Ui.Choices as Ch, System as Sys, System.Console as Console;

const Columns: array of Ch.TableColumn := [
  new Ch.TableColumn(
    'A',
    new L.Flex(
      Basis := L.Extent.Fixed(L.Measure.Cells(1)),
      Minimum := L.Measure.Cells(1),
      Maximum := L.Measure.Cells(1)
    )
  ),
  new Ch.TableColumn(
    'B',
    new L.Flex(
      Basis := L.Extent.Fixed(L.Measure.Cells(3)),
      Minimum := L.Measure.Cells(3),
      Maximum := L.Measure.Cells(3)
    )
  )
];

function Update(State: bool; Message: int): Mvu.Transition<bool, int>;
begin
  raise new Sys.InvalidOperationException('Rendering a table sent an update.');
end function;

function Message(Key: string): int;
begin
  return 1;
end function;

function View(Empty: bool): E.Element<int>;
begin
  const Rows: array of Ch.TableRow := if Empty then []
    else [
      new Ch.TableRow('one', ['界', 'OK'])
    ]
    end if;
  return E.Table<int>(
    'table',
    Columns,
    Rows,
    if Empty then null else 'one' end if,
    Message,
    Message
  );
end function;

begin
  using const Narrow: App.HeadlessSession := App.StartHeadless<bool, int>(
    false,
    Update,
    View,
    9,
    3
  );
  const Frame: App.Frame := Narrow.Snapshot();
  if Frame.Cells[4].Text <> 'A' or Frame.Cells[6].Text <> 'B'
    or Frame.Cells[13].Text <> ' ' or Frame.Cells[15].Text <> 'O' or Frame.Cells[16].Text <> 'K'
  then
    raise new Sys.InvalidOperationException(
      'A wide glyph crossed its column or shifted the next column.'
    );
  end if;

  using const Empty: App.HeadlessSession := App.StartHeadless<bool, int>(true, Update, View, 9, 3);
  const Blank: App.Frame := Empty.Snapshot();
  if Blank.Cells[4].Text <> 'A' or Blank.Controls[0].Enabled or Blank.Controls[0].Focused then
    raise new Sys.InvalidOperationException('An empty table lost its header or accepted focus.');
  end if;
  var Rejected: bool := false;
  try
    discard V.Prepare<int>(
      E.Table<int>(
        'bad',
        Columns,
        [new Ch.TableRow('one', ['Missing cell'])],
        null,
        Message,
        Message
      ), V.Target.Terminal
    );
  catch Failure: Sys.ArgumentException do
    Rejected := true;
  end try;

  if not Rejected then
    raise new Sys.InvalidOperationException('A row with the wrong number of cells was accepted.');
  end if;

  Console.WriteLine('table contracts verified');
end;
end program;
