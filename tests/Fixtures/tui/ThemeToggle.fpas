program ThemeToggleContract;

uses
  Fpas.Ui.Buttons as UiButtons, Fpas.Ui.ThemeToggles as Toggles, Fpas.Ui.Themes as Themes,
  Fpas.Ui.Elements as E, Fpas.Ui.Validation as V, Fpas.Ui.Mvu.Application as Mvu,
  Fpas.Ui.Tui.Application as Tui, Fpas.Ui.Terminal as T, Fpas.Ui.TerminalExtensions.Input as K,
  System as Sys, System.Console as Console;

procedure Check(Value: bool; Reason: string);
begin
  if not Value then
    raise new Sys.InvalidOperationException(Reason);
  end if;
end procedure;

type Model = record
  // Current controlled appearance.
  public Appearance: Themes.Mode := Themes.Mode.Light;
  // Whether primary proposals are accepted.
  public Accept: bool := true;
  // Whether the primary action accepts input.
  public Enabled: bool := true;
end record;

type Msg = variant
  Choose(Value: Themes.Mode);
  Accept;
  Enable;
end variant;

function Update(State: Model; Message: Msg): Mvu.Transition<Model, Msg>;
begin
  const Next: Model := case Message of
    when Msg.Choose(const Value: Themes.Mode): State with
      Appearance := if State.Accept then
        Value
      else
        State.Appearance
      end if;
    end with;
    when Msg.Accept: State with
      Accept := not State.Accept;
    end with;
    when Msg.Enable: State with
      Enabled := not State.Enabled;
    end with;
  end case;
  return new Mvu.Transition<Model, Msg>(Next, []);
end function;

function ThemeFor(State: Model): Themes.Theme;
begin
  return if State.Appearance = Themes.Mode.Dark then
    Themes.Dark()
  else
    Themes.Light()
  end if;
end function;

function Control(Session: Tui.HeadlessSession; Id: string): Tui.ControlSnapshot;
begin
  for Item: Tui.ControlSnapshot in Session.Snapshot().Controls do
    if Item.Id = Id then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing control: ' + Id);
end function;

procedure Send(Session: Tui.HeadlessSession; Input: Tui.Input);
begin
  discard Session.Send(Input);
  case Session.Step() of
    when Tui.StepResult.Failed(_, _, _, const Reason: string):
      raise new Sys.InvalidOperationException(Reason);
    else
  end case;
end procedure;

procedure HoverBehavior();
  function Advance(State: int; Message: int): Mvu.Transition<int, int>;
  begin
    return new Mvu.Transition<int, int>(State + 1, []);
  end function;
  function View(State: int): E.Element<int>;
  begin
    return E.Column<int>(
      E.Row<int>(
        E.Text<int>(
          if State >= 3 then
            '            '
          else
            ''
          end if
        ),
        UiButtons.Button<int>(
          if State < 2 then
            'first'
          else
            'replacement'
          end if,
          'Target', 0, new UiButtons.Options(Enabled := State <> 1, Tooltip := 'Target hint')
        )
      ),
      UiButtons.Button<int>('next', 'Next', 0)
    );
  end function;
begin
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<int, int>(0, Advance, View, 50, 8);
  const Target: Tui.ControlSnapshot := Control(Session, 'first');
  Send(Session, Tui.Input.Focus('next'));
  const Cell: int := Target.Row * 50 + Target.Column;
  const Normal: T.Style := Session.Snapshot().Cells[Cell].Colors;
  Send(Session, Tui.Input.Pointer(K.PointerKind.Move, Target.Column, Target.Row));
  Check(
    Control(Session, 'first').Hovered and Session.Snapshot().Lines[7].Contains('Target hint')
    and Session.Snapshot().Cells[Cell].Colors <> Normal,
    'Pointer hover displays the hint.'
  );
  Send(Session, Tui.Input.Activate('next'));
  Check(
    not Control(
      Session,
      'first'
    ).Hovered and not Session.Snapshot().Lines[7].Contains('Target hint'),
    'Disabling the control clears hover and hint.'
  );
  Send(Session, Tui.Input.Activate('next'));
  Check(
    Control(Session, 'replacement').Hovered and Session.Snapshot().Lines[7].Contains('Target hint'),
    'A replacement under the stationary pointer gains hover.'
  );
  Send(Session, Tui.Input.Activate('next'));
  Check(
    not Control(
      Session,
      'replacement'
    ).Hovered and not Session.Snapshot().Lines[7].Contains('Target hint'),
    'Moving the control clears hover and hint.'
  );
end procedure;

procedure Behavior();
  function Choose(Value: Themes.Mode): Msg;
  begin
    Calls := Calls + 1;
    return Msg.Choose(Value);
  end function;
  function View(State: Model): E.Element<Msg>;
  begin
    return E.Column<Msg>(
      Toggles.ThemeToggle<Msg>('theme', State.Appearance, Choose, State.Enabled),
      Toggles.ThemeToggle<Msg>('other', Themes.Mode.Dark, Choose),
      UiButtons.Button<Msg>('accept', 'Accept', Msg.Accept),
      UiButtons.Button<Msg>('enabled', 'Enabled', Msg.Enable)
    );
  end function;
begin
  var Calls: int := 0;
  using const Session: Tui.HeadlessSession := Tui.StartHeadless<Model, Msg>(
    new Model(),
    Update,
    View,
    50,
    16,
    ThemeFor
  );
  Check(Calls = 0 and Control(Session, 'theme').Focused, 'Rendering must not invoke a mapper.');
  Check(
    Control(
      Session,
      'theme'
    ).Role = 'theme-toggle' and Control(Session, 'theme').Label = 'Switch to dark',
    'The control has an accessible target name.'
  );
  const LightBackground: int? := Session.Snapshot().Cells[799].Colors.Background;
  Send(Session, Tui.Input.KeyPress(K.Key.Enter, K.KeyModifiers.None));
  Check(
    Calls = 1 and Control(Session, 'theme').Value = 'dark' and Control(Session, 'theme').Focused,
    'Enter changes the model and retains identity.'
  );
  Check(
    Session.Snapshot().Cells[799].Colors.Background <> LightBackground,
    'ThemeFor applies an accepted appearance.'
  );
  Send(Session, Tui.Input.Character(' '));
  Check(
    Calls = 2 and Control(Session, 'theme').Value = 'light',
    'Typed Space changes back to light.'
  );
  Send(Session, Tui.Input.Activate('accept'));
  Send(Session, Tui.Input.KeyPress(K.Key.Enter, K.KeyModifiers.None));
  Send(Session, Tui.Input.Character(' '));
  Check(
    Calls = 4 and Control(Session, 'theme').Value = 'light',
    'Rejected proposals preserve controlled appearance.'
  );
  Check(
    Session.Snapshot().Cells[799].Colors.Background = LightBackground,
    'Rejected proposals preserve the palette.'
  );
  Send(Session, Tui.Input.Activate('accept'));
  const Hit: Tui.ControlSnapshot := Control(Session, 'theme');
  Send(Session, Tui.Input.Click(Hit.Column + 1, Hit.Row));
  Check(
    Calls = 5 and Control(Session, 'theme').Value = 'dark',
    'Pointer activation proposes once.'
  );
  Send(Session, Tui.Input.Pointer(K.PointerKind.Press, Hit.Column + 1, Hit.Row));
  Send(Session, Tui.Input.Activate('enabled'));
  Send(Session, Tui.Input.Activate('theme'));
  Send(Session, Tui.Input.Activate('enabled'));
  Send(Session, Tui.Input.Pointer(K.PointerKind.Release, Hit.Column + 1, Hit.Row));
  Check(Calls = 5, 'Disabling cancels a pending press, including after re-enabling.');
  Send(Session, Tui.Input.Focus('other'));
  Send(Session, Tui.Input.KeyPress(K.Key.Enter, K.KeyModifiers.None));
  Check(
    Calls = 6 and Control(
      Session,
      'other'
    ).Value = 'dark' and Control(Session, 'theme').Value = 'light',
    'Another instance remains controlled and independent.'
  );
end procedure;

procedure Validation();
begin
  for Target: V.Target in [V.Target.Terminal, V.Target.Graphical] do
    for Duplicate: bool in [false, true] do
      const Node: E.Element<int> := if Duplicate then
        E.Column<int>(
          Toggles.ThemeToggle<int>(
            'bad',
            Themes.Mode.Light,
            function(Value: Themes.Mode): int => 0
          ),
          UiButtons.Button<int>('bad', 'Collision', 0)
        )
      else
        Toggles.ThemeToggle<int>(
          'bad',
          cast<Themes.Mode>(99),
          function(Value: Themes.Mode): int => 0
        )
      end if;
      var Rejected: bool := false;
      try
        discard V.Prepare<int>(Node, Target);
      catch Error: Sys.ArgumentException do
        Rejected := true;
      end try;

      Check(Rejected, 'Invalid modes and duplicate identities fail preflight.');
    end for;
  end for;
end procedure;

begin
  Validation();
  HoverBehavior();
  Behavior();
  Console.WriteLine('Theme toggle contracts verified');
end;
end program;
