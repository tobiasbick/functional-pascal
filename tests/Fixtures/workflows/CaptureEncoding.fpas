// [Documentation](../../../docs/pascal/libraries/workflows.md)

async program CaptureEncoding;

uses
  Fpas.Processes.Workflows.Capture as Capture, Fpas.Execution.Effects as Fx,
  System as Sys, System.IO as IO, System.Text as Text, System.Threading as T;

procedure WriteChildOutput();
begin
  // Beginning with UTF-16 and UTF-32 preambles must not switch either decoder.
  using const Output: IO.Stream := Sys.Console.OpenStandardOutput();
  using const Error: IO.Stream := Sys.Console.OpenStandardError();
  const OutputBytes: array of byte := [255, 254, 65, 0];
  const ErrorBytes: array of byte := [0, 0, 254, 255, 0, 0, 0, 66];
  Output.Write(OutputBytes, 0, OutputBytes.Length);
  Error.Write(ErrorBytes, 0, ErrorBytes.Length);
end procedure;

begin
  const Arguments: array of string := Sys.Environment.GetCommandLineArgs();
  if Arguments.Length = 2 and Arguments[1] = 'child' then
    WriteChildOutput();
  else
    const Host: string? := Sys.Environment.ProcessPath;
    if Host = null then
      raise new Sys.InvalidOperationException('The current .NET host path is unavailable.');
    end if;
    const Request: Capture.Request := new Capture.Request(
      Host, [Arguments[0], 'child'], Sys.AppContext.BaseDirectory
    );
    case await Capture.Read(10, 64).Run(Request, T.CancellationToken.None) of
      when Fx.Outcome.Success(const Result: Capture.Captured):
        if Result.ExitCode <> 0
          or Sys.Convert.ToHexString(
          Text.Encoding.UTF8.GetBytes(Result.Output)
        ) <> 'EFBFBDEFBFBD4100'
          or Sys.Convert.ToHexString(
          Text.Encoding.UTF8.GetBytes(Result.Error)
        ) <> '0000EFBFBDEFBFBD00000042'
        then
          raise new Sys.InvalidOperationException('Capture did not decode both streams as UTF-8.');
        end if;
      when Fx.Outcome.Failure(_):
        raise new Sys.InvalidOperationException(
          'The capture child did not finish before the deadline.'
        );
    end case;

    Sys.Console.WriteLine('Capture encoding verified');
  end if;
end;

end program;
