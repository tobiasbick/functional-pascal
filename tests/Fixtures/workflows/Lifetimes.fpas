// [Documentation](../../../docs/pascal/libraries/workflows.md)

async program WorkflowLifetimes;

uses Fpas.Execution.Effects as Fx;
uses Fpas.Execution.Workflows.Layers as L;
uses Fpas.Execution.Workflows.Scopes as S;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.Threading as T;
uses System.Threading.Tasks as Tasks;

procedure Check(Condition: bool; Message: string);
begin
  if not Condition then
    raise new Sys.InvalidOperationException(Message);
  end if;
end procedure;

async function VerifyLayers(): Tasks.Task;
  function Acquire(Value: int; Token: T.CancellationToken): Tasks.Task<Fx.Outcome<int, string>>;
  begin
    Events.Add('acquire ' + Value.ToString());
    return Tasks.Task.FromResult<Fx.Outcome<int, string>>(Fx.Outcome.Success(Value));
  end function;

  function AcquireDependent(Value: int; Token: T.CancellationToken): Tasks.Task<Fx.Outcome<int, string>>;
  begin
    if Value < 0 then
      return Tasks.Task.FromResult<Fx.Outcome<int, string>>(Fx.Outcome.Failure('unavailable'));
    end if;

    return Acquire(Value + 1, Token);
  end function;

  function Release(Value: int): Tasks.Task;
  begin
    Events.Add('release ' + Value.ToString());
    return Tasks.Task.CompletedTask;
  end function;

  function Use(Value: int; Token: T.CancellationToken): Tasks.Task<Fx.Outcome<int, string>>;
  begin
    Events.Add('use ' + Value.ToString());
    return Tasks.Task.FromResult<Fx.Outcome<int, string>>(Fx.Outcome.Success(Value));
  end function;
begin
  const Events: C.List<string> := new C.List<string>();
  const First: L.Layer<int, string, int> := L.Layer<int, string, int>.Create(
    Fx.Effect<int, string, int>.Defer(Acquire),
    Release
  );
  const Next: L.Layer<int, string, int> := L.Layer<int, string, int>.Create(
    Fx.Effect<int, string, int>.Defer(AcquireDependent),
    Release
  );
  const Program: Fx.Effect<int, string, int> := L.Provide(
    Fx.Effect<int, string, int>.Defer(Use),
    First.ThenBuild(Next)
  );

  Check(Events.Count = 0, 'Building layers acquired a dependency');
  case await Program.Run(1, T.CancellationToken.None) of
    when Fx.Outcome.Success(const Value: int):
      Check(Value = 2, 'The workflow did not receive its dependency');
    when Fx.Outcome.Failure(_):
      Check(false, 'Composition failed unexpectedly');
  end case;

  Check(
    Sys.String.Join(',', Events) = 'acquire 1,acquire 2,use 2,release 2,release 1',
    'Incorrect layer lifetime order'
  );
  Events.Clear();
  case await Program.Run(-1, T.CancellationToken.None) of
    when Fx.Outcome.Success(_):
      Check(false, 'Partial acquisition unexpectedly succeeded');
    when Fx.Outcome.Failure(const Reason: string):
      Check(Reason = 'unavailable', 'Acquisition failure was lost');
  end case;

  Check(
    Sys.String.Join(',', Events) = 'acquire -1,release -1',
    'Partial acquisition leaked or ran dependent work'
  );
end function;

async function VerifyChild(): Tasks.Task;
  async function Use(Parent: S.Scope): Tasks.Task<int>;
    async function First(Child: S.Scope): Tasks.Task<int>;
    begin
      try
        Started.SetResult();
        await Tasks.Task.Delay(T.Timeout.Infinite, Child.Token);
      finally
        Cleaned := true;
      end try;

      return 0;
    end function;

    async function Other(Child: S.Scope): Tasks.Task<int>;
    begin
      await SiblingMayFinish.Task.WaitAsync(Child.Token);
      return 7;
    end function;
  begin
    Parent.OnClose(
      function(): Tasks.Task begin
        Check(Cleaned, 'Parent released its resource before the child joined');
        Released := Released + 1;
        return Tasks.Task.CompletedTask;
      end function
    );
    const Child: S.Child<int> := Parent.Fork<int>(First);
    const Sibling: S.Child<int> := Parent.Fork<int>(Other);
    await Started.Task;
    await Child.Cancel();
    try
      discard await Child.Join;
      Check(false, 'The child ignored cancellation');
    catch Failure: Sys.OperationCanceledException do
      Check(Cleaned, 'Join completed before the child cleaned up');
    end try;

    Check(not Parent.Token.IsCancellationRequested, 'Child cancellation propagated to the parent');
    SiblingMayFinish.SetResult();
    return await Sibling.Join;
  end function;
begin
  const Started: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
    Tasks.TaskCreationOptions.RunContinuationsAsynchronously
  );
  const SiblingMayFinish: Tasks.TaskCompletionSource := new Tasks.TaskCompletionSource(
    Tasks.TaskCreationOptions.RunContinuationsAsynchronously
  );
  var Released: int := 0;
  var Cleaned: bool := false;
  Check((await S.Scope.Use<int>(Use, T.CancellationToken.None)) = 7, 'Sibling did not finish');
  Check(Released = 1, 'Resource was not released exactly once');
end function;

async function VerifyFaults(): Tasks.Task;
  function Use(Scope: S.Scope): Tasks.Task<int>;
  begin
    Scope.OnClose(
      function(): Tasks.Task begin
        Released := Released + 1;
        return Tasks.Task.CompletedTask;
      end function
    );
    Scope.OnClose(
      function(): Tasks.Task begin
        raise new Sys.InvalidOperationException('cleanup');
      end function
    );
    raise new Sys.InvalidOperationException('body');
  end function;
begin
  var Released: int := 0;
  try
    discard await S.Scope.Use<int>(Use, T.CancellationToken.None);
    Check(false, 'Scope failures were swallowed');
  catch Failure: Sys.AggregateException do
    Check(Failure.InnerExceptions.Count = 2, 'One of the failures was lost');
    Check(Failure.InnerExceptions[0].Message = 'body', 'Body failure was lost');
    Check(Failure.InnerExceptions[1].Message = 'cleanup', 'Cleanup failure was lost');
  end try;

  Check(Released = 1, 'A failing finalizer prevented later cleanup');
end function;

async function VerifyCompletedValue(Callback: bool): Tasks.Task;
  function Use(Lifetime: S.Scope): Tasks.Task<Fx.Outcome<int, string>>;
  begin
    Lifetime.OnClose(
      function(): Tasks.Task begin
        Released := Released + 1;
        return Tasks.Task.CompletedTask;
      end function
    );
    if Callback then
      discard Lifetime.Token.Register(
        procedure() begin
          raise Expected;
        end procedure
      );
    else
      Lifetime.OnClose(
        function(): Tasks.Task begin
          raise Expected;
        end function
      );
    end if;

    return Tasks.Task.FromResult<Fx.Outcome<int, string>>(Fx.Outcome.Failure('expected outcome'));
  end function;
begin
  var Released: int := 0;
  const Expected: Sys.InvalidOperationException := new Sys.InvalidOperationException(
    'release failure'
  );
  try
    discard await S.Scope.Use<Fx.Outcome<int, string>>(Use, T.CancellationToken.None);
    Check(false, 'Scope cleanup failure was swallowed');
  catch Failure: Sys.AggregateException do
    const Faults: Sys.AggregateException := Failure.Flatten();
    Check(Faults.InnerExceptions.Count = 1, 'Cleanup reported missing or duplicate failures');
    Check(
      Sys.Object.ReferenceEquals(Faults.InnerExceptions[0], Expected),
      'Cleanup lost its failure'
    );
    const Stored: object? := Failure.Data[
      'Fpas.Execution.Workflows.CompletedValue'
    ];
    if Stored = null then
      raise new Sys.InvalidOperationException('Cleanup lost the completed outcome');
    end if;

    const Completed: Fx.Outcome<int, string> := cast<Fx.Outcome<int, string>>(Stored);
    case Completed of
      when Fx.Outcome.Failure(const Reason: string):
        Check(Reason = 'expected outcome', 'Cleanup lost the completed expected outcome');
      when Fx.Outcome.Success(_):
        Check(false, 'Cleanup changed the completed expected outcome');
    end case;
  end try;

  Check(Released = 1, 'Cleanup failure prevented another resource release');
end function;

async function VerifyLateAcquisition(): Tasks.Task;
  function Acquire(Value: int; Token: T.CancellationToken): Tasks.Task<Fx.Outcome<int, string>>;
  begin
    return Acquired.Task;
  end function;

  function Release(Value: int): Tasks.Task;
  begin
    Check(Value = 42, 'Registration refusal released the wrong resource');
    Released := Released + 1;
    return Tasks.Task.CompletedTask;
  end function;

  function Use(Lifetime: S.Scope): Tasks.Task<Tasks.Task<Fx.Outcome<int, string>>>;
  begin
    const Dependency: L.Layer<int, string, int> := L.Layer<int, string, int>.Create(
      Fx.Effect<int, string, int>.Defer(Acquire), Release
    );
    // Deliberately let acquisition escape so it finishes after its owner closes.
    return Tasks.Task.FromResult<Tasks.Task<Fx.Outcome<int, string>>>(
      Dependency.Build(42, Lifetime)
    );
  end function;
begin
  var Released: int := 0;
  const Acquired: Tasks.TaskCompletionSource<Fx.Outcome<int, string>> := new Tasks.TaskCompletionSource<Fx.Outcome<int, string>>(
    Tasks.TaskCreationOptions.RunContinuationsAsynchronously
  );
  const Pending: Tasks.Task<Fx.Outcome<int, string>> := await S.Scope.Use<Tasks.Task<Fx.Outcome<int, string>>>(
    Use,
    T.CancellationToken.None
  );
  Check(
    not Pending.IsCompleted and Released = 0,
    'Acquisition did not remain pending until its owner closed'
  );
  Acquired.SetResult(Fx.Outcome.Success(42));
  var Refused: bool := false;
  try
    discard await Pending;
  catch Failure: Sys.InvalidOperationException do
    Refused := true;
    Check(Released = 1, 'A dependency refused by its closed scope was not released');
  end try;

  Check(Refused, 'A closed scope accepted a late dependency');
  Check(Released = 1, 'The late dependency was not released exactly once');
end function;

begin
  await VerifyLayers();
  await VerifyChild();
  await VerifyFaults();
  await VerifyCompletedValue(false);
  await VerifyCompletedValue(true);
  await VerifyLateAcquisition();
  Sys.Console.WriteLine('Workflow contracts verified');
end;

end program;
