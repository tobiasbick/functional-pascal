<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)gui.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/Fpas.Gui.Cui/Fpas.Gui.Cui.csproj" />
    <ProjectReference Include="../../sdk/Fpas.NET.Sdk/Fpas.NET.Sdk.csproj" ReferenceOutputAssembly="false" />
    <Using Include="Xunit" />
    <None Include="../Fixtures/gui/*" Link="Fixtures/gui/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Gui/**/*.fpas;../../src/Fpas.Gui/*.fpasproj;../../src/Fpas.Gui/README.md"
          Exclude="../../src/**/bin/**/*;../../src/**/obj/**/*"
          Link="Fixtures/host/src/Fpas.Gui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Mvu/**/*.fpas;../../src/Fpas.Mvu/*.fpasproj;../../src/Fpas.Mvu/README.md"
          Exclude="../../src/**/bin/**/*;../../src/**/obj/**/*"
          Link="Fixtures/host/src/Fpas.Mvu/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Ui/**/*.fpas;../../src/Fpas.Ui/*.fpasproj;../../src/Fpas.Ui/README.md"
          Exclude="../../src/**/bin/**/*;../../src/**/obj/**/*"
          Link="Fixtures/host/src/Fpas.Ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Tui/**/*.fpas;../../src/Fpas.Tui/*.fpasproj"
          Exclude="../../src/**/bin/**/*;../../src/**/obj/**/*"
          Link="Fixtures/host/src/Fpas.Tui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/gui/counter/*.fpas;../../examples/gui/counter/*.fpasproj"
          Link="Fixtures/host/examples/gui/counter/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/gui/gallery/*.fpas;../../examples/gui/gallery/*.fpasproj"
          Link="Fixtures/host/examples/gui/gallery/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/gui-host/*.fpas" Link="Fixtures/host/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/pascal/libraries/gui.md" Link="Fixtures/GuiHandbook.md" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="FpasSdkProject" Value="$(MSBuildThisFileDirectory)../../sdk/Fpas.NET.Sdk/Fpas.NET.Sdk.csproj" />
    <AssemblyMetadata Include="FpasCuiProject" Value="$(MSBuildThisFileDirectory)../../src/Fpas.Gui.Cui/Fpas.Gui.Cui.csproj" />
    <AssemblyMetadata Include="FpasProcessesProject" Value="$(MSBuildThisFileDirectory)../../src/Fpas.Processes/Fpas.Processes.csproj" />
    <AssemblyMetadata Include="FpasBuildConfiguration" Value="$(Configuration)" />
  </ItemGroup>
  <Target Name="RemoveStaleHostFixtures" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(OutputPath)Fixtures/host/src/Fpas.Tui" />
  </Target>
</Project>
