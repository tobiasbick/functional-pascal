<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <None Include="../../apps/doc-examples/**/*" Exclude="../../apps/doc-examples/bin/**/*;../../apps/doc-examples/obj/**/*" Link="Fixtures/doc-examples/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/pascal/**/*.md" Link="Fixtures/specification/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../README.md" Link="Fixtures/repository/README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/build/standalone-sdk.md" Link="Fixtures/standalone-sdk.md" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.win-arm64" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.linux-arm64" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fpas.Cli/Fpas.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Fpas.Debugging/Fpas.Debugging.csproj" />
    <ProjectReference Include="../../src/Fpas.Workspaces/Fpas.Workspaces.csproj" />
    <ProjectReference Include="../../sdk/Fpas.NET.Sdk/Fpas.NET.Sdk.csproj" ReferenceOutputAssembly="false" />
    <Using Include="Xunit" />
    <None Include="../../examples/basics/hello/main.fpas" Link="Fixtures/hello.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/numerics/mandelbrot/main.fpas;../../examples/numerics/mandelbrot/Mandelbrot.fpasproj" Link="Fixtures/mandelbrot/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Ui.Tui/**/*.fpas" Exclude="../../src/Fpas.Ui.Tui/bin/**/*;../../src/Fpas.Ui.Tui/obj/**/*" Link="Fixtures/tui/lib/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Ui.Mvu/**/*.fpas" Exclude="../../src/Fpas.Ui.Mvu/bin/**/*;../../src/Fpas.Ui.Mvu/obj/**/*" Link="Fixtures/mvu/lib/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Ui/**/*.fpas" Exclude="../../src/Fpas.Ui/bin/**/*;../../src/Fpas.Ui/obj/**/*" Link="Fixtures/ui/lib/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/ui/tui/gallery/*.fpas" Link="Fixtures/tui/gallery/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/HeadlessContract.fpas" Link="Fixtures/tui/headless.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/CuiContract.fpas" Link="Fixtures/tui/cui.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/ConfirmButton.fpas" Link="Fixtures/tui/confirm.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/StatusButton.fpas" Link="Fixtures/tui/status.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/ThemeSwitcher.fpas" Link="Fixtures/tui/theme-switcher.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/ThemeToggle.fpas" Link="Fixtures/tui/theme-toggle.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/EffectContract.fpas" Link="Fixtures/tui/effects.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/TerminalModes.cs" Link="Fixtures/tui/TerminalModes.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/basics/units/**/*.fpas;../../examples/basics/units/*.fpasproj" Link="Fixtures/units/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/io/read-file/*.fpas;../../examples/io/read-file/*.fpasproj;../../examples/io/read-file/*.txt" Link="Fixtures/read-file/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/io/directory-inventory/*.fpas;../../examples/io/directory-inventory/*.fpasproj" Link="Fixtures/directory-inventory/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/types/inventory-model/*.fpas;../../examples/types/inventory-model/*.fpasproj" Link="Fixtures/inventory-model/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/types/game-actions/*.fpas;../../examples/types/game-actions/*.fpasproj" Link="Fixtures/game-actions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/functions/generic-pipeline/*.fpas;../../examples/functions/generic-pipeline/*.fpasproj" Link="Fixtures/generic-pipeline/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/types/generic-tree/*.fpas;../../examples/types/generic-tree/*.fpasproj" Link="Fixtures/generic-tree/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/types/data-domains/*.fpas;../../examples/types/data-domains/*.fpasproj" Link="Fixtures/data-domains/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/basics/shared-state/*.fpas;../../examples/basics/shared-state/*.fpasproj" Link="Fixtures/shared-state/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/functions/local-functions/*.fpas;../../examples/functions/local-functions/*.fpasproj" Link="Fixtures/local-functions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/basics/loops/*.fpas;../../examples/basics/loops/*.fpasproj" Link="Fixtures/loops/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/interop/events/*.fpas;../../examples/interop/events/*.fpasproj" Link="Fixtures/events/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/interop/type-inspection/*.fpas;../../examples/interop/type-inspection/*.fpasproj" Link="Fixtures/type-inspection/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/interop/attributes/*.fpas;../../examples/interop/attributes/*.fpasproj" Link="Fixtures/attributes/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/msbuild/**/*" Link="Fixtures/msbuild/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/testing/*.fpas" Link="Fixtures/testing/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="FpasSdkProject" Value="$(MSBuildThisFileDirectory)../../sdk/Fpas.NET.Sdk/Fpas.NET.Sdk.csproj" />
    <AssemblyMetadata Include="FpasBuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="FpasWindowsArmShim" Value="$(PkgMicrosoft_Diagnostics_DbgShim_win-arm64)/runtimes/win-arm64/native/dbgshim.dll" />
    <AssemblyMetadata Include="FpasLinuxArmShim" Value="$(PkgMicrosoft_Diagnostics_DbgShim_linux-arm64)/runtimes/linux-arm64/native/libdbgshim.so" />
  </ItemGroup>
  <Target Name="RemoveStaleSpecificationFixtures" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(OutputPath)Fixtures/specification;$(OutputPath)Fixtures/tui/lib;$(OutputPath)Fixtures/tui/gallery;$(OutputPath)Fixtures/ui/lib" />
  </Target>
  <Target Name="RecordFpasCliPath" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../../src/Fpas.Cli/Fpas.Cli.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_FpasCliAssembly" />
    </MSBuild>
    <ItemGroup>
      <AssemblyMetadata Include="FpasCliPath" Value="%(_FpasCliAssembly.FullPath)" />
    </ItemGroup>
  </Target>
</Project>
