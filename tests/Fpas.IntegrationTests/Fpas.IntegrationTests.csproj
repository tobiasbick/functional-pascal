<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <None Include="../../apps/doc-examples/**/*" Exclude="../../apps/doc-examples/bin/**/*;../../apps/doc-examples/obj/**/*" Link="Fixtures/doc-examples/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/pascal/**/*.md" Link="Fixtures/specification/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../README.md" Link="Fixtures/repository/README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/build/standalone-sdk.md" Link="Fixtures/standalone-sdk.md" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.win-arm64" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.linux-arm64" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fpas.Cli/Fpas.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Fpas.Debugging/Fpas.Debugging.csproj" />
    <ProjectReference Include="../../src/Fpas.Workspaces/Fpas.Workspaces.csproj" />
    <ProjectReference Include="../../sdk/Fpas.NET.Sdk/Fpas.NET.Sdk.csproj" ReferenceOutputAssembly="false" />
    <Using Include="Xunit" />
    <None Include="../../examples/hello/main.fpas" Link="Fixtures/hello.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/mandelbrot/main.fpas;../../examples/mandelbrot/Mandelbrot.fpasproj" Link="Fixtures/mandelbrot/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Tui/**/*.fpas" Exclude="../../src/Fpas.Tui/bin/**/*;../../src/Fpas.Tui/obj/**/*" Link="Fixtures/tui/lib/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Mvu/**/*.fpas" Exclude="../../src/Fpas.Mvu/bin/**/*;../../src/Fpas.Mvu/obj/**/*" Link="Fixtures/mvu/lib/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Ui/**/*.fpas" Exclude="../../src/Fpas.Ui/bin/**/*;../../src/Fpas.Ui/obj/**/*" Link="Fixtures/ui/lib/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/ui/WidgetContract.fpas" Link="Fixtures/ui/WidgetContract.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/tui/filter-list/main.fpas" Link="Fixtures/tui/example.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/tui/gallery/*.fpas" Link="Fixtures/tui/gallery/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/tui/mandelbrot/*.fpas" Link="Fixtures/tui/mandelbrot/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/HeadlessContract.fpas" Link="Fixtures/tui/headless.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/SharedContract.fpas" Link="Fixtures/tui/shared.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/CanvasInputContract.fpas" Link="Fixtures/tui/canvas-input.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/TabsContract.fpas" Link="Fixtures/tui/tabs.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/TableContract.fpas" Link="Fixtures/tui/table.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/MultilineContract.fpas" Link="Fixtures/tui/multiline.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/EffectContract.fpas" Link="Fixtures/tui/effects.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/tui/TerminalModes.cs" Link="Fixtures/tui/TerminalModes.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/units/**/*.fpas;../../examples/units/*.fpasproj" Link="Fixtures/units/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/read-file/*.fpas;../../examples/read-file/*.fpasproj;../../examples/read-file/*.txt" Link="Fixtures/read-file/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/directory-inventory/*.fpas;../../examples/directory-inventory/*.fpasproj" Link="Fixtures/directory-inventory/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/inventory-model/*.fpas;../../examples/inventory-model/*.fpasproj" Link="Fixtures/inventory-model/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/game-actions/*.fpas;../../examples/game-actions/*.fpasproj" Link="Fixtures/game-actions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/generic-pipeline/*.fpas;../../examples/generic-pipeline/*.fpasproj" Link="Fixtures/generic-pipeline/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/generic-tree/*.fpas;../../examples/generic-tree/*.fpasproj" Link="Fixtures/generic-tree/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/data-domains/*.fpas;../../examples/data-domains/*.fpasproj" Link="Fixtures/data-domains/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/shared-state/*.fpas;../../examples/shared-state/*.fpasproj" Link="Fixtures/shared-state/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/local-functions/*.fpas;../../examples/local-functions/*.fpasproj" Link="Fixtures/local-functions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/loops/*.fpas;../../examples/loops/*.fpasproj" Link="Fixtures/loops/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/events/*.fpas;../../examples/events/*.fpasproj" Link="Fixtures/events/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/type-inspection/*.fpas;../../examples/type-inspection/*.fpasproj" Link="Fixtures/type-inspection/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/attributes/*.fpas;../../examples/attributes/*.fpasproj" Link="Fixtures/attributes/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/msbuild/**/*" Link="Fixtures/msbuild/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/testing/*.fpas" Link="Fixtures/testing/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="FpasSdkProject" Value="$(MSBuildThisFileDirectory)../../sdk/Fpas.NET.Sdk/Fpas.NET.Sdk.csproj" />
    <AssemblyMetadata Include="FpasBuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="FpasWindowsArmShim" Value="$(PkgMicrosoft_Diagnostics_DbgShim_win-arm64)/runtimes/win-arm64/native/dbgshim.dll" />
    <AssemblyMetadata Include="FpasLinuxArmShim" Value="$(PkgMicrosoft_Diagnostics_DbgShim_linux-arm64)/runtimes/linux-arm64/native/libdbgshim.so" />
  </ItemGroup>
  <Target Name="RemoveStaleSpecificationFixtures" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(OutputPath)Fixtures/specification;$(OutputPath)Fixtures/tui/lib;$(OutputPath)Fixtures/ui/lib" />
  </Target>
  <Target Name="RecordFpasCliPath" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../../src/Fpas.Cli/Fpas.Cli.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_FpasCliAssembly" />
    </MSBuild>
    <ItemGroup>
      <AssemblyMetadata Include="FpasCliPath" Value="%(_FpasCliAssembly.FullPath)" />
    </ItemGroup>
  </Target>
</Project>
