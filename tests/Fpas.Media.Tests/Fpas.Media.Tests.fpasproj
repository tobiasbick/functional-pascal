<Project Sdk="Fpas.NET.Sdk/0.1.0-dev">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../Fpas.Media.Audio.Tests/Fixtures/step.mp3" Link="Fixtures/step.mp3" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/Fpas.Media.Tags/Fpas.Media.Tags.fpasproj" />
    <ProjectReference Include="../../src/Fpas.Media.Audio/Fpas.Media.Audio.csproj" />
    <ProjectReference Include="../../src/Fpas.Media.Images/Fpas.Media.Images.csproj" />
  </ItemGroup>
</Project>
