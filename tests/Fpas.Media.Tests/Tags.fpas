// [Documentation](../../docs/pascal/libraries/media/tags.md#embedded-artwork)

unit Fpas.Media.Tests.Tags;

uses Fpas.Media.Tags.AudioFiles as Files;
uses Fpas.Media.Tags.Pictures as Pictures;

uses ATL as A;
uses System as Sys;
uses System.Collections.Generic as C;
uses System.IO as IO;
uses Xunit as X;

// Verifies detached tag records and embedded artwork through the public FPAS API.
public type TagTests = record
  // Reopening a tagged file preserves the order of credits and selects the front cover.
  [X.TheoryAttribute]
  [X.InlineDataAttribute('step.mp3')]
  [X.InlineDataAttribute('step.ogg')]
  public procedure ReadTagsAndSelectArtwork(Name: string);
    procedure AddCover(Path: string; Data: array of byte; Kind: A.PictureInfo.PIC_TYPE);
    begin
      const Track: A.Track := new A.Track(Path);
      const Items: C.IList<A.PictureInfo?>? := Track.EmbeddedPictures;
      if Items = null then
        raise new Sys.InvalidOperationException('Expected an embedded picture collection.');
      end if;

      Items.Add(A.PictureInfo.fromBinaryData(Data, Kind));
      X.Assert.True(Track.Save());
    end procedure;
  begin
    const Temp: IO.DirectoryInfo := IO.Directory.CreateTempSubdirectory();
    try
      const Path: string := IO.Path.Combine(Temp.FullName, Name);
      IO.File.Copy(IO.Path.Combine(Sys.AppContext.BaseDirectory, 'Fixtures', Name), Path);
      const Track: A.Track := new A.Track(Path);
      Track.Album := 'Studio';
      Track.Artist := 'Écho;Second';
      Track.Genre := 'Jazz;Live';
      X.Assert.True(Track.Save());
      const Back: array of byte := Sys.Convert.FromBase64String(
        'iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAIAAAB7QOjdAAAAD0lEQVR4nGP4z8DA8J8BAAf/Af8Bf4mnAAAAAElFTkSuQmCC'
      );
      const Front: array of byte := Sys.Convert.FromBase64String(
        'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aO9sAAAAASUVORK5CYII='
      );
      AddCover(Path, Back, A.PictureInfo.PIC_TYPE.Back);
      const Fallback: Pictures.Cover? := Pictures.Read(Path);
      if Fallback = null then
        raise new Sys.InvalidOperationException('Missing back cover.');
      end if;

      X.Assert.False(Fallback.Front);
      X.Assert.Equal<string>(Sys.Convert.ToHexString(Back), Sys.Convert.ToHexString(Fallback.Data));
      AddCover(Path, Front, A.PictureInfo.PIC_TYPE.Front);
      const Selected: Pictures.Cover? := Pictures.Read(Path);
      if Selected = null then
        raise new Sys.InvalidOperationException('Missing front cover.');
      end if;

      X.Assert.True(Selected.Front);
      X.Assert.Equal<string>('image/png', Selected.MimeType);
      X.Assert.Equal<string>(
        Sys.Convert.ToHexString(Front),
        Sys.Convert.ToHexString(Selected.Data)
      );
      using const Stream: IO.FileStream := IO.File.OpenRead(Path);
      const Info: Files.Info := Files.Read(Stream, IO.Path.GetExtension(Name) ?? '');
      X.Assert.Equal<string>('Studio', Info.Album);
      X.Assert.Equal<int>(2, Info.Artists.Length);
      X.Assert.Equal<string>('Écho', Info.Artists[0]);
      X.Assert.Equal<string>('Second', Info.Artists[1]);
      X.Assert.Equal<int>(2, Info.Genres.Length);
      X.Assert.Equal<string>('Jazz', Info.Genres[0]);
      X.Assert.Equal<string>('Live', Info.Genres[1]);
    finally
      Temp.Delete(true);
    end try;
  end procedure;
end record;

end unit;
