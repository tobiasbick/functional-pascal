<!-- [Documentation](../coverage.md#native-gui) -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)gui.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/Fpas.Ui.Gui.Cui/Fpas.Ui.Gui.Cui.csproj" />
    <ProjectReference Include="../../sdk/Fpas.NET.Sdk/Fpas.NET.Sdk.csproj" ReferenceOutputAssembly="false" />
    <Using Include="Xunit" />
    <None Include="../Fixtures/gui/*" Link="Fixtures/gui/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../third-party/cui/upstream/cui.c" Link="Fixtures/CuiFonts.c" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Ui.Gui/**/*.fpas;../../src/Fpas.Ui.Gui/*.fpasproj"
          Exclude="../../src/**/bin/**/*;../../src/**/obj/**/*"
          Link="Fixtures/host/src/Fpas.Ui.Gui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Ui.Mvu/**/*.fpas;../../src/Fpas.Ui.Mvu/*.fpasproj"
          Exclude="../../src/**/bin/**/*;../../src/**/obj/**/*"
          Link="Fixtures/host/src/Fpas.Ui.Mvu/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Ui/**/*.fpas;../../src/Fpas.Ui/*.fpasproj"
          Exclude="../../src/**/bin/**/*;../../src/**/obj/**/*"
          Link="Fixtures/host/src/Fpas.Ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/ui/gui/gallery/**/*.fpas;../../examples/ui/gui/gallery/*.fpasproj;../../examples/ui/gui/gallery/**/*.resx"
          Exclude="../../examples/ui/gui/gallery/bin/**/*;../../examples/ui/gui/gallery/obj/**/*"
          Link="Fixtures/host/examples/ui/gui/gallery/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/gui-host/*.fpas" Link="Fixtures/host/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Fpas.Ui.Mvu.Testing/EffectReplies.fpas" Link="Fixtures/host/EffectReplies.fpas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/ui/widgets.md" Link="Fixtures/host/docs/ui/widgets.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/ui/gui/host.md" Link="Fixtures/host/docs/ui/gui/host.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/ui/mvu/runtime.md" Link="Fixtures/host/docs/ui/mvu/runtime.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/ui/gui/desktop.md" Link="Fixtures/GuiHandbook.md" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="FpasSdkProject" Value="$(MSBuildThisFileDirectory)../../sdk/Fpas.NET.Sdk/Fpas.NET.Sdk.csproj" />
    <AssemblyMetadata Include="FpasCuiProject" Value="$(MSBuildThisFileDirectory)../../src/Fpas.Ui.Gui.Cui/Fpas.Ui.Gui.Cui.csproj" />
    <AssemblyMetadata Include="FpasProcessesProject" Value="$(MSBuildThisFileDirectory)../../src/Fpas.Processes/Fpas.Processes.csproj" />
    <AssemblyMetadata Include="FpasBuildConfiguration" Value="$(Configuration)" />
  </ItemGroup>
  <Target Name="RemoveStaleHostFixtures" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(OutputPath)Fixtures/host/docs;$(OutputPath)Fixtures/host/examples;$(OutputPath)Fixtures/host/src" />
  </Target>
</Project>
