// Album identity, cover precedence and watcher invalidation use real synthetic media.
unit FpasAmp.Library.Tests.Albums;

uses
  Fpas.Media.Tags.AudioFiles as MediaTags,
  FpasAmp.Library.Tests.Support as H, FpasAmp.Library.Tests.MetadataSupport as F,
  FpasAmp.Library.Tests.AlbumSupport as Art, FpasAmp.Library.Albums.Model as M,
  FpasAmp.Library.Albums.Persistence.Queries as Query, FpasAmp.Library.Inventory.Monitoring as Monitor,
  FpasAmp.Library.Metadata.Model as Tags, FpasAmp.Library.Sources as Sources,
  Fpas.Media.Images as Images, ATL as A, System as Sys, System.IO as IO,
  FpasAmp.Library.Persistence.Sql as Sql, FpasAmp.Library.Persistence.Schema as Schema,
  FpasAmp.Library.UserData.Schema as Users,
  Microsoft.Data.Sqlite as Db, System.Text.Json as Json,
  System.Collections.Immutable as I, System.Threading as T, System.Threading.Tasks as Tasks, Xunit as X;

function Read(Data: string): I.ImmutableArray<M.Album>;
begin
  return Query.Read(
    IO.Path.Combine(Data, 'library.db'),
    IO.Path.Combine(Data, 'userdata.db'),
    T.CancellationToken.None
  ).Releases;
end function;

async function Until(Data: string; Accept: function(I.ImmutableArray<M.Album>): bool): Tasks.Task<I.ImmutableArray<M.Album>>;
begin
  using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
  while true do
    const Items: I.ImmutableArray<M.Album> := Read(Data);
    if Accept(Items) then
      return Items;
    end if;

    await Tasks.Task.Delay(10, Deadline.Token);
  end while;
end function;

// Selected artwork and grouping remain independent of GUI rendering.
public type AlbumTests = record
  // Existing cached tags derive memberships without needing any source file present.
  [X.FactAttribute]
  public procedure UpgradeDerivesAlbumsWithoutOpeningMedia();
  begin
    using const Data: H.Folder := H.Folder.Create();
    const Database: string := IO.Path.Combine(Data.Path, 'library.db');
    using const UserDatabase: Db.SqliteConnection := Users.Open(
      IO.Path.Combine(Data.Path, 'userdata.db')
    );
    begin
      using const Connection: Db.SqliteConnection := Sql.Open(Database);
      Schema.Ensure(Connection);
      const Path: string := IO.Path.Combine(Data.Path, 'missing-folder', 'missing.mp3');
      Sql.Execute(
        Connection,
        'INSERT INTO files(id,path_key,path,directory_key,size,modified_utc) VALUES(1,$path,$path,$directory,100,1);' +
        'INSERT INTO metadata(file_id,track_id,sha256,size,modified_utc,read_utc,tags_json) VALUES(1,''track'',''hash'',100,1,1,$json);' +
        'DROP TABLE album_tracks; PRAGMA user_version=3;',
        null,
        ['$path', '$directory', '$json'],
        [
          Path,
          IO.Path.GetDirectoryName(Path),
          Json.JsonSerializer.Serialize<MediaTags.Info>(
            new MediaTags.Info(
              Album := 'Cached release',
              AlbumArtists := ['Example', 'Echo; Lane', 'example'],
              Genres := ['Électro', ' e' + #769 + 'LECTRO ', 'Folk', '  ']
            )
          )
        ]
      );
    end;

    begin
      using const Connection: Db.SqliteConnection := Sql.Open(Database);
      Schema.Ensure(Connection);
    end;
    const Items: I.ImmutableArray<M.Album> := Read(Data.Path);
    X.Assert.Equal<int>(1, Items.Length);
    X.Assert.Equal<string>('Cached release', Items[0].Title);
    X.Assert.Equal<string>('Example; Echo; Lane; example', Items[0].Artist);
    X.Assert.Equal<int>(2, Items[0].Credits.Length);
    X.Assert.Equal<string>('Echo; Lane', Items[0].Credits[0].Name);
    X.Assert.Equal<string>(M.ArtistId('example'), Items[0].Credits[1].Id);
    X.Assert.Equal<int>(2, Items[0].GenreMemberships.Length);
    var HasElectro: bool := false;
    for Group: M.Membership in Items[0].GenreMemberships do
      X.Assert.Equal<long>(1L, Group.Tracks);
      if Group.Id = M.GenreId('Électro') then
        HasElectro := true;
      end if;
    end for;

    X.Assert.True(HasElectro);
  end procedure;

  // Equal names in different folders remain distinct; a release ID joins disc folders.
  [X.FactAttribute]
  public async function GroupingUsesReleaseAndContext(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    discard Art.Track(IO.Path.Combine(Root.Path, 'first'), 'a.mp3', 'Same title');
    discard Art.Track(IO.Path.Combine(Root.Path, 'second'), 'b.mp3', 'Same title');
    discard Art.Track(
      IO.Path.Combine(Root.Path, 'discs', 'CD1'),
      'c.mp3',
      'Release',
      Release := '33333333-3333-3333-3333-333333333333'
    );
    discard Art.Track(
      IO.Path.Combine(Root.Path, 'discs', 'CD2'),
      'd.mp3',
      'Release',
      Release := '33333333-3333-3333-3333-333333333333'
    );
    await using const Session: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
    discard await F.Until(
      F.Tags(Session),
      function(Items: I.ImmutableArray<Tags.Entry>): bool => Items.Length = 4
    );
    const Albums: I.ImmutableArray<M.Album> := Read(Data.Path);
    X.Assert.Equal<int>(3, Albums.Length);
    X.Assert.Equal<string>('Release', Albums[0].Title);
    X.Assert.Equal<long>(2L, Albums[0].Tracks);
    X.Assert.NotEqual<string>(Albums[1].Id, Albums[2].Id);
  end function;

  // A front cover on a later track wins over a back cover and an external sidecar.
  [X.FactAttribute]
  public async function EmbeddedFrontWinsAndThumbnailSurvivesOffline(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const First: string := Art.Track(Root.Path, 'a.mp3', 'Album');
    const Second: string := Art.Track(Root.Path, 'b.mp3', 'Album');
    Art.Embed(First, Art.Picture(220, 20, 20), A.PictureInfo.PIC_TYPE.Back);
    Art.Embed(Second, Art.Picture(20, 20, 220));
    IO.File.WriteAllBytes(IO.Path.Combine(Root.Path, 'cover.png'), Art.Picture(20, 220, 20));
    const Source: Sources.MusicSource := F.Source(Root.Path);
    await using const Session: Monitor.Session := F.Start([Source], Data.Path);
    discard await F.Until(
      F.Tags(Session),
      function(Items: I.ImmutableArray<Tags.Entry>): bool => Items.Length = 2
    );
    const Album: M.Album := Read(Data.Path)[0];
    const Picture: Images.Bitmap? := await F.Tags(Session).Albums.ThumbnailAsync(
      Album,
      T.CancellationToken.None
    );
    case Picture of
      when is Images.Bitmap as Pixels:
        X.Assert.Equal<int>(384, Pixels.Width);
        X.Assert.True(Pixels.Pixels[2] > Pixels.Pixels[0]);
      else
        X.Assert.True(false, 'Expected the embedded front cover.');
    end case;

    Session.Configure(
      [
        Source with
          Offline := true;
        end with
      ]
    );
    IO.File.Delete(First);
    IO.File.Delete(Second);
    X.Assert.NotNull(await F.Tags(Session).Albums.ThumbnailAsync(Album, T.CancellationToken.None));
  end function;

  // An unsupported back-cover image on the first track leaves later embedded covers eligible.
  [X.FactAttribute]
  public async function LaterBackCoverWinsOverSidecarWhenFirstCannotDecode(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const First: string := Art.Track(Root.Path, 'a.mp3', 'Album');
    const Second: string := Art.Track(Root.Path, 'b.mp3', 'Album');
    const Gif: array of byte := Sys.Convert.FromBase64String(
      'R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=='
    );
    Art.Embed(First, Gif, A.PictureInfo.PIC_TYPE.Back);
    Art.Embed(Second, Art.Picture(20, 20, 220), A.PictureInfo.PIC_TYPE.Back);
    IO.File.WriteAllBytes(IO.Path.Combine(Root.Path, 'cover.png'), Art.Picture(220, 20, 20));
    await using const Session: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
    discard await F.Until(
      F.Tags(Session),
      function(Items: I.ImmutableArray<Tags.Entry>): bool => Items.Length = 2
    );
    const Album: M.Album := Read(Data.Path)[0];
    const Picture: Images.Bitmap? := await F.Tags(Session).Albums.ThumbnailAsync(
      Album,
      T.CancellationToken.None
    );
    case Picture of
      when is Images.Bitmap as Pixels:
        X.Assert.True(
          Pixels.Pixels[2] > Pixels.Pixels[0],
          'Expected the blue embedded back cover.'
        );
      else
        X.Assert.True(false, 'Expected album artwork.');
    end case;
  end function;

  // Sidecar creation/replacement/deletion changes the album revision and cached choice.
  [X.FactAttribute]
  public async function SidecarWatcherInvalidatesCoverAndMissingResult(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    discard Art.Track(Root.Path, 'a.mp3', 'Album');
    await using const Session: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
    discard await F.Until(
      F.Tags(Session),
      function(Items: I.ImmutableArray<Tags.Entry>): bool => Items.Length = 1
    );
    const Initial: M.Album := Read(Data.Path)[0];
    X.Assert.Null(await F.Tags(Session).Albums.ThumbnailAsync(Initial, T.CancellationToken.None));
    const Path: string := IO.Path.Combine(Root.Path, 'CoVeR.PNG');
    IO.File.WriteAllBytes(Path, Art.Picture(220, 20, 20));
    const Added: I.ImmutableArray<M.Album> := await Until(
      Data.Path,
      function(Items: I.ImmutableArray<M.Album>): bool => Items.Length = 1 and Items[
        0
      ].Revision <> Initial.Revision
    );
    X.Assert.NotNull(
      await F.Tags(Session).Albums.ThumbnailAsync(Added[0], T.CancellationToken.None)
    );
    IO.File.WriteAllBytes(Path, Art.Picture(20, 220, 20));
    const Changed: I.ImmutableArray<M.Album> := await Until(
      Data.Path,
      function(Items: I.ImmutableArray<M.Album>): bool => Items.Length = 1 and Items[
        0
      ].Revision <> Added[0].Revision
    );
    const Green: Images.Bitmap? := await F.Tags(Session).Albums.ThumbnailAsync(
      Changed[0],
      T.CancellationToken.None
    );
    case Green of
      when is Images.Bitmap as Pixels:
        X.Assert.True(Pixels.Pixels[1] > Pixels.Pixels[0]);
      else
        X.Assert.True(false);
    end case;

    IO.File.Delete(Path);
    const Deleted: I.ImmutableArray<M.Album> := await Until(
      Data.Path,
      function(Items: I.ImmutableArray<M.Album>): bool => Items.Length = 1 and Items[
        0
      ].Revision <> Changed[0].Revision
    );
    X.Assert.Null(
      await F.Tags(Session).Albums.ThumbnailAsync(Deleted[0], T.CancellationToken.None)
    );
  end function;

  // A folder image is never assigned to two unrelated releases sharing a directory.
  [X.FactAttribute]
  public async function SharedFolderArtworkIsAmbiguous(): Tasks.Task;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    discard Art.Track(Root.Path, 'a.mp3', 'First');
    discard Art.Track(Root.Path, 'b.mp3', 'Second');
    IO.File.WriteAllBytes(IO.Path.Combine(Root.Path, 'folder.jpg'), Art.Picture(220, 20, 20));
    await using const Session: Monitor.Session := F.Start([F.Source(Root.Path)], Data.Path);
    discard await F.Until(
      F.Tags(Session),
      function(Items: I.ImmutableArray<Tags.Entry>): bool => Items.Length = 2
    );
    const Albums: I.ImmutableArray<M.Album> := Read(Data.Path);
    X.Assert.Equal<int>(2, Albums.Length);
    for Album: M.Album in Albums do
      X.Assert.Null(await F.Tags(Session).Albums.ThumbnailAsync(Album, T.CancellationToken.None));
    end for;
  end function;
end record;

end unit;
