// Temporary filesystem and bounded snapshot helpers for the focused library tests.
unit FpasAmp.Library.Tests.Support;

uses
  FpasAmp.Library.Sources as S, FpasAmp.Library.Inventory.Model as M,
  FpasAmp.Library.Inventory.Monitoring as Monitor, System as Sys, System.IO as IO,
  System.Threading as T, System.Threading.Tasks as Tasks;

// Isolated directory removed after its monitoring session has stopped.
public type Folder = record implements Sys.IDisposable
  // Absolute temporary path.
  public Path: string;

  // Creates a fresh directory without using user preferences or media.
  public static function Create(): Folder;
  begin
    return new Folder(IO.Directory.CreateTempSubdirectory('fpas-amp-tests-').FullName);
  end function;

  // Removes the isolated tree, including its test-only files and links.
  public procedure Dispose();
  begin
    IO.Directory.Delete(self.Path, true);
  end procedure;
end record;

// Creates an online FLAC/MP3 source. `Path` is absolute; `Id` is unique in its batch.
public function Source(Id: string; Path: string): S.MusicSource;
begin
  return new S.MusicSource(Id, Id, Path, false, ['.flac', '.mp3']);
end function;

// Creates an isolated in-memory SQLite session. Arguments match the monitor policy/lifetime.
public function Start(Sources: array of S.MusicSource; Cancellation: T.CancellationToken; Settings: M.Options? := null): Monitor.Session;
begin
  return Monitor.Session.Start(Sources, ':memory:', Cancellation, Settings);
end function;

// Waits up to 15 seconds for a completed snapshot satisfying `Accept`.
// `Session` remains owned by the caller. Returns the matching detached snapshot.
// `IncludeCached` permits unverified startup snapshots; completed scans are the default.
public async function Until(Session: Monitor.Session; Accept: function(M.Snapshot): bool; IncludeCached: bool := false): Tasks.Task<M.Snapshot>;
begin
  using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
  while true do
    const Snapshot: M.Snapshot := await Session.Changes.ReadAsync(
      Deadline.Token
    ).ConfigureAwait(false);
    if (IncludeCached or not Snapshot.Cached) and Accept(Snapshot) then
      return Snapshot;
    end if;
  end while;
end function;

// Drains a stopped session before awaiting reader completion, with a bounded wait.
public async function Drain(Session: Monitor.Session): Tasks.Task;
begin
  using const Deadline: T.CancellationTokenSource := new T.CancellationTokenSource(15000);
  while await Session.Changes.WaitToReadAsync(Deadline.Token).ConfigureAwait(false) do
    discard await Session.Changes.ReadAsync(Deadline.Token).ConfigureAwait(false);
  end while;

  await Session.Changes.Completion.ConfigureAwait(false);
end function;

// Tests membership in a source snapshot without depending on filesystem enumeration order.
public function Has(Source: M.SourceSnapshot; Path: string): bool;
begin
  for File: string in Source.Files do
    if S.PathComparer().Equals(File, Path) then
      return true;
    end if;
  end for;

  return false;
end function;

end unit;
