// Album ratings must not invalidate already loaded artwork or the virtual viewport.
unit FpasAmp.Ui.Tests.Albums;

uses
  FpasAmp.Ui.Player.Playback as Playback, Fpas.Media.Audio as Media,
  FpasAmp.Ui.Albums.Model as M, FpasAmp.Ui.Albums.Update as Update,
  FpasAmp.Library.Albums.Model as Library, Fpas.Media.Images as Images,
  FpasAmp.Ui.App.Model as App, FpasAmp.Ui.App.Controller as Controller,
  FpasAmp.Ui.Navigation.Model as Nav, FpasAmp.Ui.Settings.Model as Settings,
  FpasAmp.Library.Tests.Support as H, FpasAmp.Library.Inventory.Monitoring as Monitor,
  System.Threading as T, System.Threading.Tasks as Tasks,
  Fpas.Ui.Mvu.Application as A, System.Collections.Immutable as I, Xunit as X;

// Pure album-slice regression checks, independent of a native display.
public type AlbumTests = record
  // Rating receipts release retained controls even after navigation hides Albums.
  [X.TheoryAttribute]
  [X.InlineDataAttribute(false)]
  [X.InlineDataAttribute(true)]
  public async function RatingFinishesWhileAnotherDestinationIsOpen(Failed: bool): Tasks.Task;
  begin
    await using const LibrarySession: Monitor.Session := H.Start([], T.CancellationToken.None);
    using const Device: Media.Session := new Media.Session(true);
    const Port: Playback.Connection := new Playback.Connection(Device);
    const Save: procedure(Settings.Preferences) := procedure(_Value: Settings.Preferences) begin end procedure;
    const Header: Library.Album := new Library.Album('album', 'Title', 'Artist', 1L, 'revision');
    const Initial: App.State := new App.State(
      new Settings.State(new Settings.Preferences([])),
      Navigation := new Nav.State(Active := Nav.Route.Page(Nav.Page.Albums)),
      Albums := Update.Apply(
        new M.State(),
        M.Msg.Received(I.ImmutableArray.Create<Library.Album>(Header)),
        null
      ).Model with
        Saving := I.ImmutableHashSet<string>.Empty.Add('album');
      end with
    );
    const Hidden: App.State := Controller.Apply(
      Initial,
      App.Msg.Navigation(Nav.Msg.Select(Nav.Route.Page(Nav.Page.Settings))),
      Save,
      LibrarySession, Port
    ).Model;
    X.Assert.True(Hidden.Albums.Saving.Contains('album'));
    const Receipt: M.Msg := if Failed then
      M.Msg.RatingFailed('album', 'Write failed')
    else
      M.Msg.Rated('album', 8)
    end if;
    const Finished: App.State := Controller.Apply(
      Hidden,
      App.Msg.Albums(Receipt),
      Save,
      LibrarySession, Port
    ).Model;
    X.Assert.Empty(Finished.Albums.Saving);
    if Failed then
      X.Assert.Equal<string?>('Write failed', Finished.Albums.Error);
    else
      X.Assert.Equal<int?>(8, Finished.Albums.Items[0].Rating);
    end if;
    const Stale: App.State := Controller.Apply(
      Finished,
      App.Msg.Albums(M.Msg.Received(I.ImmutableArray<Library.Album>.Empty)),
      Save,
      LibrarySession, Port
    ).Model;
    X.Assert.Equal<int>(1, Stale.Albums.Items.Length);
    const Image: App.State := Controller.Apply(
      Stale,
      App.Msg.Albums(M.Msg.Image(Stale.Albums.Generation, 'album', null)),
      Save,
      LibrarySession, Port
    ).Model;
    X.Assert.Empty(Image.Albums.Images);
    const Reopened: App.State := Controller.Apply(
      Image,
      App.Msg.Navigation(Nav.Msg.Select(Nav.Route.Page(Nav.Page.Albums))),
      Save,
      LibrarySession, Port
    ).Model;
    X.Assert.Empty(Reopened.Albums.Saving);
  end function;

  // A confirmed rating changes just user state and keeps immutable image resources.
  [X.FactAttribute]
  public procedure RatingKeepsArtworkAndViewport();
  begin
    const Album: Library.Album := new Library.Album('album', 'Title', 'Artist', 12L, 'revision');
    const Image: Images.Bitmap := new Images.Bitmap(1, 1, [100, 40, 30, 255]);
    const Current: M.State := Update.Apply(
      new M.State(), M.Msg.Received(I.ImmutableArray.Create<Library.Album>(Album)), null
    ).Model with
      Images := I.ImmutableDictionary<string, Images.Bitmap?>.Empty.Add('album', Image);
      Saving := I.ImmutableHashSet<string>.Empty.Add('album');
      First := 0;
      Last := 1;
      Generation := 3L;
    end with;
    const Saved: A.Transition<M.State, M.Msg> := Update.Apply(
      Current,
      M.Msg.Rated('album', 8),
      null
    );
    X.Assert.Equal<int?>(8, Saved.Model.Items[0].Rating);
    X.Assert.Empty(Saved.Model.Saving);
    const Received: A.Transition<M.State, M.Msg> := Update.Apply(
      Saved.Model,
      M.Msg.Received(
        I.ImmutableArray.Create<Library.Album>(
          Album with
            Rating := 8;
          end with
        )
      ), null
    );
    X.Assert.Same(Image, Received.Model.Images['album']);
    X.Assert.Equal<int>(0, Received.Model.First);
    X.Assert.Equal<int>(1, Received.Model.Last);
    X.Assert.Equal<long>(3L, Received.Model.Generation);
    X.Assert.Empty(Received.Commands);
    const Cleared: A.Transition<M.State, M.Msg> := Update.Apply(
      Received.Model,
      M.Msg.Rated('album', null),
      null
    );
    X.Assert.Null(Cleared.Model.Items[0].Rating);
  end procedure;

  // A catalogue update keeps the covers of albums whose artwork did not change.
  [X.FactAttribute]
  public procedure UpdateKeepsCurrentCovers();
  begin
    const Same: Library.Album := new Library.Album('same', 'Same', 'Artist', 3L, 'r1');
    const Changed: Library.Album := new Library.Album('changed', 'Changed', 'Artist', 4L, 'r1');
    const Image: Images.Bitmap := new Images.Bitmap(1, 1, [100, 40, 30, 255]);
    const Current: M.State := Update.Apply(
      new M.State(), M.Msg.Received(I.ImmutableArray.Create<Library.Album>(Same, Changed)), null
    ).Model with
      Images := I.ImmutableDictionary<string, Images.Bitmap?>.Empty.Add(
        'same',
        Image
      ).Add('changed', Image);
    end with;
    const Next: M.State := Update.Apply(
      Current,
      M.Msg.Received(
        I.ImmutableArray.Create<Library.Album>(
          Same,
          Changed with
            Revision := 'r2';
          end with,
          new Library.Album('added', 'Added', 'Artist', 5L, 'r1')
        )
      ),
      null
    ).Model;
    X.Assert.Same(Image, Next.Images['same']);
    X.Assert.False(Next.Images.ContainsKey('changed'));
    X.Assert.Equal<int>(3, Next.Shown.Length);
  end procedure;

  // A rejected background save releases the control and exposes a recoverable error.
  [X.FactAttribute]
  public procedure FailedRatingReleasesControl();
  begin
    const Current: M.State := new M.State(Saving := I.ImmutableHashSet<string>.Empty.Add('album'));
    const Failed: A.Transition<M.State, M.Msg> := Update.Apply(
      Current,
      M.Msg.RatingFailed('album', 'Write failed'),
      null
    );
    X.Assert.Empty(Failed.Model.Saving);
    X.Assert.Equal<string?>('Write failed', Failed.Model.Error);
  end procedure;
end record;

end unit;
