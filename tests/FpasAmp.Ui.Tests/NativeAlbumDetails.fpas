// Native hover timing, read-only details and the fixed footer use the real app view.
unit FpasAmp.Ui.Tests.NativeAlbumDetails;

uses
  FpasAmp.Library.Tests.Support as H, FpasAmp.Library.Tests.AlbumSupport as Art,
  FpasAmp.Library.Albums.Model as Library, FpasAmp.Imaging as Thumbnails, Fpas.Media.Images as Imaging,
  FpasAmp.Ui.App.Model as App, FpasAmp.Ui.Settings.Model as SettingsModel, FpasAmp.Ui.Shell as Shell,
  FpasAmp.Ui.Albums.Model as Albums, FpasAmp.Ui.Albums.Update as Update,
  FpasAmp.Ui.Navigation.Model as Nav,
  Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Gui.Cui as Cui,
  Fpas.Ui.Gui.Internal.Hosting.Session as Host, Fpas.Ui.Mvu.Application as Mvu,
  System as Sys, System.IO as IO, System.Collections.Immutable as I,
  System.Threading as T, Xunit as X;

function Find(Session: Gui.Session<App.Msg>; Id: string): Gui.Control;
begin
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Id = Id then
      return Item;
    end if;
  end for;

  raise new Sys.InvalidOperationException('Missing native control: ' + Id);
end function;

function Has(Session: Gui.Session<App.Msg>; Id: string): bool;
begin
  for Item: Gui.Control in Session.Snapshot().Controls do
    if Item.Id = Id then
      return true;
    end if;
  end for;

  return false;
end function;

procedure Step(Session: Gui.Session<App.Msg>);
begin
  discard Session.Post(App.Msg.Settings(SettingsModel.Msg.DismissError));
  X.Assert.True(Session.Step());
end procedure;

procedure Wait(Session: Gui.Session<App.Msg>; Open: bool);
begin
  const Deadline: long := Sys.Environment.TickCount64 + 4000L;
  while Has(Session, 'album-details-album-0') <> Open and Sys.Environment.TickCount64 < Deadline do
    T.Thread.Sleep(20);
    Step(Session);
  end while;

  X.Assert.Equal<bool>(Open, Has(Session, 'album-details-album-0'));
end procedure;

procedure Capture(Session: Gui.Session<App.Msg>; Name: string);
begin
  const Directory: string? := Sys.Environment.GetEnvironmentVariable('FPAS_AMP_UI_ARTIFACTS');
  if Directory <> null then
    discard IO.Directory.CreateDirectory(Directory);
    for Index: int := 0 to 4 do
      Step(Session);
    end for;

    Session.CapturePng(IO.Path.Combine(Directory, Name + '.png'));
  end if;
end procedure;

// Exercises the native components without publishing, external services or user media.
public type DetailTests = record
  // Whole-card hover survives a disabled nested rating; footer stays outside scrolling.
  [X.TheoryAttribute]
  [X.InlineDataAttribute(1280, 4)]
  [X.InlineDataAttribute(1000, 3)]
  [X.InlineDataAttribute(620, 3)]
  [X.InlineDataAttribute(480, 2)]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure HoverDetailsAndFixedStatus(Width: int; ExpectedColumns: int);
    procedure Inject();
    begin
      Window.MovePointer(PointerX, PointerY);
      if Key <> 0 then
        Window.SetKey(Key, true);
        Window.SetKey(Key, false);
        Key := 0;
      end if;

      if Left >= 0 then
        Window.SetLeftButton(Left = 1);
        Left := -1;
      end if;

      if Wheel <> 0.0F then
        Window.Wheel(Wheel);
        Wheel := 0.0F;
      end if;
    end procedure;

    function Apply(Current: App.State; Message: App.Msg): Mvu.Transition<App.State, App.Msg>;
    begin
      case Message of
        when App.Msg.Albums(const Child: Albums.Msg):
          case Child of
            when Albums.Msg.Rate(_, const Value: int):
              RatingRequests := RatingRequests + 1;
              RequestedRating := Value;
            else
          end case;
          const Next: Mvu.Transition<Albums.State, Albums.Msg> := Update.Apply(
            Current.Albums,
            Child,
            null
          );
          Last := Current with
            Albums := Next.Model;
          end with;
        else
          Last := Current;
      end case;

      return new Mvu.Transition<App.State, App.Msg>(Last, []);
    end function;
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Cache: Thumbnails.ThumbnailStore := new Thumbnails.ThumbnailStore(Root.Path);
    const Image: Imaging.Bitmap := Cache.Store(
      'cover',
      'fixture',
      Art.Picture(35, 80, 100),
      T.CancellationToken.None
    );
    var Items: I.ImmutableArray<Library.Album> := I.ImmutableArray<Library.Album>.Empty;
    var Pictures: I.ImmutableDictionary<string, Imaging.Bitmap?> := I.ImmutableDictionary<string, Imaging.Bitmap?>.Empty;
    for Index: int := 0 to 35 do
      const Id: string := 'album-' + Index.ToString();
      Items := Items.Add(
        new Library.Album(
          Id,
          if Index = 0 then
            'Blue horizon'
          elsif Index = 1 then
            'City lights'
          else
            'Example album ' + Index.ToString()
          end if,
          'Example artist', if Index = 0 then
            12L
          else
            1L
          end if, 'fixture', if Index = 0 then
            8
          else
            null
          end if
        )
      );
      Pictures := Pictures.Add(Id, Image);
    end for;
    var Last: App.State := new App.State(
      new SettingsModel.State(new SettingsModel.Preferences([], 'light')),
      Navigation := new Nav.State(Active := Nav.Route.Page(Nav.Page.Albums), Loaded := true),
      Albums := Update.Apply(new Albums.State(), Albums.Msg.Received(Items), null).Model with
        Images := Pictures;
        Saving := I.ImmutableHashSet<string>.Empty.Add('album-0');
      end with
    );
    var PointerX: float := -1.0F;
    var PointerY: float := -1.0F;
    var Key: int := 0;
    var Left: int := -1;
    var Wheel: float := 0.0F;
    var RatingRequests: int := 0;
    var RequestedRating: int := -1;
    const Window: Cui.CuiWindow := new Cui.CuiWindow(
      'FPas-Amp album details',
      Width,
      820,
      Cui.CuiRenderer.Software,
      true
    );
    Window.SetReducedMotion(true);
    using const Session: Gui.Session<App.Msg> := Host.StartThemed<App.State, App.Msg>(
      Last, Apply, Shell.View, Window, 128, Inject, App.Theme(Last, null), App.Theme, false
    );
    Step(Session);
    Step(Session);
    const Footer: Cui.CuiRectangle := Find(Session, 'album-status').Bounds;
    const Grid: Cui.CuiRectangle := Find(Session, 'album-grid').Bounds;
    X.Assert.True(Footer.Y + Footer.Height <= Find(Session, 'player-toggle').Bounds.Y);
    X.Assert.True(Grid.Y + Grid.Height <= Footer.Y);
    X.Assert.False(Find(Session, 'album-rating-album-0').Enabled);
    const FirstCard: Cui.CuiRectangle := Find(Session, 'album-album-0').Bounds;
    var FirstRow: int := 0;
    for Item: Gui.Control in Session.Snapshot().Controls do
      if Item.Role = 'card' and Item.Id.StartsWith('album-') and Item.Bounds.Y = FirstCard.Y then
        FirstRow := FirstRow + 1;
      end if;
    end for;

    X.Assert.Equal<int>(ExpectedColumns, FirstRow);
    const Cover: Cui.CuiRectangle := Find(Session, 'cover-album-0').Bounds;
    X.Assert.Equal<float>(Cover.Width, Cover.Height);
    X.Assert.InRange<float>(FirstCard.Width - Cover.Width, 0.0F, 4.0F);
    X.Assert.Contains<string>('Example artist · 12 songs', Session.Snapshot().Text);
    X.Assert.Contains<string>('Example artist · 1 song', Session.Snapshot().Text);
    PointerX := Cover.X + Cover.Width / 2.0F;
    PointerY := Cover.Y + Cover.Height / 2.0F;
    Step(Session);
    Step(Session);
    T.Thread.Sleep(100);
    Step(Session);
    X.Assert.False(
      Has(Session, 'album-details-album-0'),
      'Album details must wait for the native hover delay.'
    );
    Wait(Session, true);
    X.Assert.Equal<float>(80.0F, Find(Session, 'album-detail-cover-album-0').Bounds.Width);
    X.Assert.Equal<float>(80.0F, Find(Session, 'album-detail-cover-album-0').Bounds.Height);
    X.Assert.False(Find(Session, 'album-detail-rating-album-0').Enabled);
    X.Assert.Equal<string>('8', Find(Session, 'album-detail-rating-album-0').Value);
    X.Assert.Contains<string>('Example artist', Session.Snapshot().Text);
    X.Assert.Contains<string>('12 songs', Session.Snapshot().Text);
    X.Assert.Contains<string>('8 / 10', Session.Snapshot().Text);
    discard Session.Post(App.Msg.Albums(Albums.Msg.Rated('album-0', 8)));
    Step(Session);
    Capture(Session, 'albums-hover-' + Width.ToString());
    const ReadOnlyRating: Cui.CuiRectangle := Find(Session, 'album-detail-rating-album-0').Bounds;
    PointerX := ReadOnlyRating.X + 11.0F;
    PointerY := ReadOnlyRating.Y + ReadOnlyRating.Height / 2.0F;
    Step(Session);
    Left := 1;
    Step(Session);
    Left := 0;
    Step(Session);
    Step(Session);
    X.Assert.Equal<int>(0, RatingRequests);
    const DetailCover: Cui.CuiRectangle := Find(Session, 'album-detail-cover-album-0').Bounds;
    PointerX := DetailCover.X + DetailCover.Width / 2.0F;
    PointerY := DetailCover.Y + DetailCover.Height / 2.0F;
    Step(Session);
    T.Thread.Sleep(240);
    Step(Session);
    X.Assert.True(
      Has(Session, 'album-details-album-0'),
      'Moving onto the details must keep them open.'
    );
    PointerX := -1.0F;
    PointerY := -1.0F;
    Step(Session);
    Wait(Session, false);
    PointerX := Cover.X + Cover.Width / 2.0F;
    PointerY := Cover.Y + Cover.Height / 2.0F;
    Step(Session);
    Wait(Session, true);
    Key := 3;
    Step(Session);
    Wait(Session, false);
    T.Thread.Sleep(750);
    Step(Session);
    X.Assert.False(
      Has(Session, 'album-details-album-0'),
      'Escape keeps details closed until the pointer leaves.'
    );
    PointerX := -1.0F;
    PointerY := -1.0F;
    Step(Session);
    const TileRating: Cui.CuiRectangle := Find(Session, 'album-rating-album-0').Bounds;
    X.Assert.True(TileRating.Y >= Cover.Y + Cover.Height);
    X.Assert.True(TileRating.Y + TileRating.Height <= FirstCard.Y + FirstCard.Height);
    X.Assert.True(TileRating.X >= FirstCard.X);
    X.Assert.True(TileRating.X + TileRating.Width <= FirstCard.X + FirstCard.Width);
    PointerX := TileRating.X + TileRating.Width * 0.15F;
    PointerY := TileRating.Y + TileRating.Height / 2.0F;
    Step(Session);
    Step(Session);
    Left := 1;
    Step(Session);
    Left := 0;
    Step(Session);
    Step(Session);
    X.Assert.Equal<int>(1, RatingRequests);
    X.Assert.Equal<int>(2, RequestedRating);
    PointerX := Grid.X + 2.0F;
    PointerY := Grid.Y + Grid.Height / 2.0F;
    // Cross several complete rows, including CUI's two-row overscan.
    Wheel := -64.0F;
    for Index: int := 0 to 19 do
      Step(Session);
      T.Thread.Sleep(10);
    end for;

    X.Assert.False(
      Find(Session, 'album-grid').Value.StartsWith('0:'),
      'The native grid must actually scroll.'
    );
    X.Assert.Equal<Cui.CuiRectangle>(Footer, Find(Session, 'album-status').Bounds);
    X.Assert.Equal<int>(36, Last.Albums.Items.Length);
    Capture(Session, 'albums-scrolled-' + Width.ToString());
    discard Session.Post(
      App.Msg.Albums(Albums.Msg.Received(I.ImmutableArray<Library.Album>.Empty))
    );
    Step(Session);
    X.Assert.True(Has(Session, 'albums-empty'));
    X.Assert.Equal<Cui.CuiRectangle>(Footer, Find(Session, 'album-status').Bounds);
    Capture(Session, 'albums-empty-' + Width.ToString());
  end procedure;
end record;

end unit;
