// Music page exercises real catalogue changes, virtual rows and playback bookmarks.
unit FpasAmp.Ui.Tests.NativeMusic;

uses
  FpasAmp.Ui.Tests.CollectionFixture as Fixture, FpasAmp.Library.Tests.Support as H,
  FpasAmp.Library.Tests.MetadataSupport as Sources, FpasAmp.Library.Inventory.Monitoring as Monitor,
  FpasAmp.Ui.App.Model as App, FpasAmp.Ui.Shell as Shell, FpasAmp.Ui.Settings.Model as Settings,
  FpasAmp.Ui.Music.LibraryPage as LibraryPage, FpasAmp.Ui.Albums.Music.Model as Music,
  FpasAmp.Ui.Albums.Music.Browse as Browse, FpasAmp.Ui.Player.Model as Player,
  FpasAmp.Persistence.PlayerState as Bookmark, FpasAmp.AppState as Storage,
  Fpas.Ui.Widgets.Collections.Tables as Tables, Fpas.Ui.Gui.Cui as Cui, Fpas.Media.Audio as Audio,
  System as Sys, System.IO as IO, System.Collections.Immutable as I, System.Threading as T, Xunit as X;

// End-to-end checks for the Music destination.
public type LibraryMusicTests = record
  // The open library follows scans, realizes album covers, and plays precisely its filtered order.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure WholeLibraryMusic();
    procedure Song(Session: Shell.Session; Value: Music.Msg);
    begin
      discard Session.Window.Post(App.Msg.Songs(LibraryPage.Msg.Song(Value)));
      Fixture.Pump(Session);
    end procedure;
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Library: Monitor.Session := Sources.Start([Sources.Source(Root.Path)], Data.Path);
    try
      var Placement: Cui.CuiWindowPlacement := new Cui.CuiWindowPlacement();
      Placement.Width := 1440;
      Placement.Height := 900;
      using const Session: Shell.Session := Shell.Session.Start(
        Placement,
        new Settings.Preferences([Sources.Source(Root.Path)], 'light'),
        procedure(_Value: Settings.Preferences) begin end procedure,
        Library,
        Output := new Audio.Session(true)
      );
      Fixture.Until(
        Session,
        function(): bool => Session.State().Songs.Page.Loaded and Fixture.Has(
          Session,
          'tracks-empty'
        ),
        'Missing empty Music state.'
      );
      // Finish writing tags before the watcher can open the audio files.
      const Prepared: string := IO.Path.Combine(Data.Path, 'collection');
      Fixture.Seed(Prepared);
      IO.Directory.Move(Prepared, IO.Path.Combine(Root.Path, 'collection'));
      Library.Refresh('music');
      Fixture.Until(
        Session,
        function(): bool => Session.State().Songs.Page.Shown.Length = 22
          and Session.State().Songs.Page.ReleaseTitles.Length = 9
          and Session.State().Songs.Covers.Count >= 5,
        'Music did not follow the scan and load visible covers.'
      );
      X.Assert.True(Session.State().Songs.Last < 22);
      X.Assert.True(Fixture.Has(Session, 'track-status'));
      for Index: int := 1 to 3 do
        Song(Session, Music.Msg.Rate(Session.State().Songs.Page.Shown[Index].TrackId, Index + 5));
      end for;

      Fixture.Until(
        Session,
        function(): bool => Session.State().Songs.Page.Shown[
          1
        ].Rating = 6 and Session.State().Songs.Page.Shown[3].Rating = 8,
        'Visible star ratings did not update.'
      );
      Fixture.Capture(Session, 'music', 'music');
      Song(Session, Music.Msg.ShowFilters(true));
      X.Assert.True(Fixture.Has(Session, 'track-filter-artist'));
      X.Assert.True(Fixture.Has(Session, 'track-filter-album'));
      X.Assert.True(Fixture.Has(Session, 'track-filter-genre'));
      Fixture.Capture(Session, 'music-filters', 'music');
      Song(Session, Music.Msg.Performer('Aster Vale'));
      const Release: string := Session.State().Songs.Page.ReleaseIds[
        Sys.Array.IndexOf<string>(Session.State().Songs.Page.ReleaseTitles, 'Blue Hour')
      ];
      Song(Session, Music.Msg.ReleaseFilter(Release));
      Song(Session, Music.Msg.Genres(I.ImmutableHashSet.Create<string>('Soul')));
      Song(Session, Music.Msg.ApplyFilters);
      Song(Session, Music.Msg.Search('aster blue'));
      Song(Session, Music.Msg.Sort(new Tables.Sort(5, true)));
      X.Assert.Equal<int>(3, Session.State().Songs.Page.Shown.Length);
      X.Assert.Equal<int>(22, Session.State().Songs.Page.Tracks.Length);
      const Id: string := Session.State().Songs.Page.Shown[0].TrackId;
      Song(Session, Music.Msg.Play(Session.State().Songs.Page.Shown[1].FileId));
      const Playing: Player.State := Session.State().Player;
      X.Assert.True(Playing.Playing);
      Song(Session, Music.Msg.Rate(Id, 8));
      Fixture.Until(
        Session,
        function(): bool => not Session.State().Songs.Page.Saving.ContainsKey(Id)
          and Session.State().Songs.Page.Shown[0].Rating = 8,
        'Track rating was not saved.'
      );
      X.Assert.Equal<int>(3, Playing.Queue.Length);
      Storage.Save(
        Data.Path,
        Storage.FromWindow(Placement, Session.State().Navigation, Bookmark.Capture(Playing))
      );
      const Saved: Bookmark.Saved := Storage.Load(Data.Path).Player;
      const Restored: Player.State := Bookmark.Restore(
        Saved,
        Sources.Tags(Library).QueueAsync('', T.CancellationToken.None).GetAwaiter().GetResult()
      );
      X.Assert.Equal<string>('', Saved.Source.AlbumId);
      X.Assert.Equal<string>('Aster Vale', Saved.Source.Performer);
      X.Assert.Equal<string>(Release, Saved.Source.ReleaseFilter);
      X.Assert.Equal<int>(5, Saved.Source.Column);
      X.Assert.Equal<int>(3, Restored.Queue.Length);
      for Index: int := 0 to 2 do
        X.Assert.Equal<long>(
          Session.State().Songs.Page.Shown[Index].FileId,
          Restored.Queue[Index].FileId
        );
      end for;

      Song(Session, Music.Msg.ShowFilters(true));
      Song(Session, Music.Msg.Minimum(8));
      Song(Session, Music.Msg.ApplyFilters);
      X.Assert.Equal<int>(1, Session.State().Songs.Page.Shown.Length);
      Song(Session, Music.Msg.Search('missing-title'));
      Fixture.Until(
        Session,
        function(): bool => Session.State().Songs.Covers.IsEmpty and Fixture.Has(
          Session,
          'tracks-empty'
        ),
        'Hidden covers were retained.'
      );
      Song(Session, Music.Msg.ShowFilters(true));
      Song(Session, Music.Msg.Reset);
      Song(Session, Music.Msg.ApplyFilters);
      Song(Session, Music.Msg.Search('Juniper Lane'));
      X.Assert.Equal<int>(2, Session.State().Songs.Page.Shown.Length);
      X.Assert.Equal<string>('Daybreak', Browse.AlbumTitle(Session.State().Songs.Page.Shown[0]));
    finally
      Library.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;
end record;

end unit;
