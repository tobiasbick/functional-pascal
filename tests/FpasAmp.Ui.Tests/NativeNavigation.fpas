// Native navigation frames exercise actual discovery, restoration and compact sheets.
unit FpasAmp.Ui.Tests.NativeNavigation;

uses
  FpasAmp.Library.Tests.Support as H, FpasAmp.Library.Sources as Sources,
  FpasAmp.Library.Inventory.Monitoring as Monitor, FpasAmp.Library.Inventory.Model as Inventory,
  FpasAmp.Library.Albums.Model as Releases, FpasAmp.Library.Tests.AlbumSupport as Fixtures, FpasAmp.Library.Tests.MetadataSupport as Metadata,
  FpasAmp.Ui.Albums.Model as Albums, FpasAmp.Ui.Albums.Music.Model as Music,
  FpasAmp.Persistence.PlayerState as Bookmark, Fpas.Media.Audio as Audio,
  FpasAmp.Library.Playlists.Model as Lists, FpasAmp.Ui.App.Model as App, FpasAmp.Ui.Settings.Model as SettingsModel,
  FpasAmp.Ui.Navigation.Model as Nav, FpasAmp.Ui.Shell as Shell, FpasAmp.AppState as Storage,
  Fpas.Ui.Gui.Application as Gui, Fpas.Ui.Gui.Cui as Cui, System as Sys, System.IO as IO,
  System.Threading as T, Xunit as X;

procedure Pump(Session: Shell.Session);
begin
  // Wake without overwriting a navigation proposal already queued for this frame.
  discard Session.Window.Post(App.Msg.Settings(SettingsModel.Msg.DismissError));
  X.Assert.True(Session.Window.Step());
end procedure;

procedure Until(Session: Shell.Session; Accept: function(Nav.State): bool);
begin
  const Deadline: long := Sys.Environment.TickCount64 + 15000L;
  while not Accept(Session.State().Navigation) and Sys.Environment.TickCount64 < Deadline do
    Pump(Session);
    T.Thread.Sleep(5);
  end while;

  X.Assert.True(
    Accept(Session.State().Navigation),
    'Navigation did not reach the expected background state.'
  );
end procedure;

procedure SetRoute(Session: Shell.Session; Route: Nav.Route);
begin
  discard Session.Window.Post(App.Msg.Navigation(Nav.Msg.Select(Route)));
  Pump(Session);
end procedure;

function ShowsTracks(Session: Shell.Session; Id: string): bool;
begin
  const Page: Music.State? := Session.State().Albums.Music;
  return Page <> null and Page.Album.Id = Id and Page.Shown.Length = 1;
end function;

function Has(Session: Shell.Session; Id: string): bool;
begin
  for Control: Gui.Control in Session.Window.Snapshot().Controls do
    if Control.Id = Id then
      return true;
    end if;
  end for;

  return false;
end function;

procedure Settle(Session: Shell.Session);
begin
  for Index: int := 0 to 15 do
    Pump(Session);
    T.Thread.Sleep(16);
  end for;
end procedure;

procedure Capture(Session: Shell.Session; Name: string);
begin
  const Directory: string? := Sys.Environment.GetEnvironmentVariable('FPAS_AMP_UI_ARTIFACTS');
  if Directory <> null then
    Settle(Session);
    discard IO.Directory.CreateDirectory(Directory);
    Session.Window.CapturePng(IO.Path.Combine(Directory, Name + '.png'));
  end if;
end procedure;

function Placement(Width: int): Cui.CuiWindowPlacement;
begin
  var Result: Cui.CuiWindowPlacement := new Cui.CuiWindowPlacement();
  Result.Width := Width;
  Result.Height := 720;
  return Result;
end function;

function Start(Source: Sources.MusicSource; Data: string): Monitor.Session;
begin
  return Monitor.Session.Start(
    [Source], IO.Path.Combine(Data, 'library.db'), T.CancellationToken.None,
    new Inventory.Options(0, 60000, 16), IO.Path.Combine(Data, 'userdata.db')
  );
end function;

// Window-level checks run only with a native display (Xvfb on headless Linux).
public type NativeNavigationTests = record
  // Closing on one release restores its tracks even when the player holds another release.
  [X.TheoryAttribute]
  [X.InlineDataAttribute(false)]
  [X.InlineDataAttribute(true)]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure AlbumTracksAfterRestart(FromArtist: bool);
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    discard Fixtures.Track(IO.Path.Combine(Root.Path, 'a'), 'First.mp3', 'Live', 'First artist');
    discard Fixtures.Track(IO.Path.Combine(Root.Path, 'b'), 'Second.mp3', 'Live', 'Second artist');
    for Folder: string in IO.Directory.GetDirectories(Root.Path) do
      IO.File.WriteAllBytes(IO.Path.Combine(Folder, 'cover.png'), Fixtures.Picture(48, 80, 110));
    end for;
    const Source: Sources.MusicSource := Metadata.Source(Root.Path);
    const Preferences: SettingsModel.Preferences := new SettingsModel.Preferences([Source]);
    const Save: procedure(SettingsModel.Preferences) := procedure(_Value: SettingsModel.Preferences) begin end procedure;
    const Library: Monitor.Session := Start(Source, Data.Path);
    var Browsed: string := '';
    var Person: string := '';
    var Playing: string := '';
    try
      begin
        using const Session: Shell.Session := Shell.Session.Start(
          Placement(1000),
          Preferences,
          Save,
          Library,
          new Nav.State(Active := Nav.Route.Page(Nav.Page.Albums)),
          Output := new Audio.Session(true)
        );
        Until(
          Session,
          function(_State: Nav.State): bool => Session.State().Albums.Items.Length = 2
        );
        Playing := Session.State().Albums.Items[0].Id;
        Browsed := Session.State().Albums.Items[1].Id;
        Person := Session.State().Albums.Items[1].Credits[0].Id;
        discard Session.Window.Post(App.Msg.Albums(Albums.Msg.OpenMusic(Playing)));
        Until(Session, function(_State: Nav.State): bool => ShowsTracks(Session, Playing));
        discard Session.Window.Post(App.Msg.Albums(Albums.Msg.Music(Music.Msg.Play(0))));
        discard Session.Window.Post(App.Msg.Albums(Albums.Msg.BackToAlbums));
        if FromArtist then
          SetRoute(Session, Nav.Route.Artist(Person));
        end if;

        discard Session.Window.Post(App.Msg.Albums(Albums.Msg.OpenMusic(Browsed)));
        Until(Session, function(_State: Nav.State): bool => ShowsTracks(Session, Browsed));
        discard Session.Window.Post(App.Msg.Closing(Session.State().Player));
        while Session.Window.Step() do
        end while;

        Storage.Save(
          Data.Path,
          Storage.FromWindow(
            Session.Window.Placement(),
            Session.State().Navigation,
            Bookmark.Capture(Session.State().Player)
          )
        );
      end;
      const Saved: Storage.Snapshot := Storage.Load(Data.Path);
      X.Assert.Equal<string>(Playing, Saved.Player.Source.AlbumId);
      const Restored: Nav.State := new Nav.State(
        Active := Nav.Parse(Saved.ActivePage) ?? Nav.Route.Page(Nav.Page.Music)
      );
      using const Reopened: Shell.Session := Shell.Session.Start(
        Storage.ToWindow(Saved),
        Preferences,
        Save,
        Library,
        Restored,
        Output := new Audio.Session(true),
        Restored := Bookmark.Restore(
          Saved.Player,
          Metadata.Tags(Library).QueueAsync(
            Playing,
            T.CancellationToken.None
          ).GetAwaiter().GetResult()
        )
      );
      Until(Reopened, function(_State: Nav.State): bool => Reopened.State().Albums.Loaded);
      X.Assert.NotNull(Reopened.State().Albums.Music);
      Until(Reopened, function(_State: Nav.State): bool => ShowsTracks(Reopened, Browsed));
      Until(Reopened, function(_State: Nav.State): bool => Has(Reopened, 'track-album-cover'));
      X.Assert.True(Has(Reopened, 'album-tracks'));
      discard Reopened.Window.Post(App.Msg.Albums(Albums.Msg.Music(Music.Msg.ShowFilters(true))));
      Until(Reopened, function(_State: Nav.State): bool => Has(Reopened, 'track-filter-rating'));
      X.Assert.False(Has(Reopened, 'track-filter-genre'));
      X.Assert.Equal<string>(Playing, Reopened.State().Player.Source.AlbumId);
      X.Assert.False(Reopened.State().Player.Playing);
      discard Reopened.Window.Post(App.Msg.Albums(Albums.Msg.BackToAlbums));
      Pump(Reopened);
      X.Assert.Null(Reopened.State().Albums.Music);
      X.Assert.Equal<string>(
        if FromArtist then
          Nav.Key(Nav.Route.Artist(Person))
        else
          'albums'
        end if,
        Storage.FromWindow(Reopened.Window.Placement(), Reopened.State().Navigation).ActivePage
      );
    finally
      Library.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;

  // A saved release absent from the catalogue returns to the album grid.
  [X.TheoryAttribute]
  [X.InlineDataAttribute(false)]
  [X.InlineDataAttribute(true)]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure MissingAlbumAfterRestart(FromArtist: bool);
  begin
    using const Data: H.Folder := H.Folder.Create();
    const Library: Monitor.Session := Metadata.Start([], Data.Path);
    try
      const Saved: Nav.State := new Nav.State(
        Active := if FromArtist then
          Nav.Route.ArtistAlbum(Releases.ArtistId('Missing'), new string(#65, 64))
        else
          Nav.Route.Album(new string(#65, 64))
        end if
      );
      using const Session: Shell.Session := Shell.Session.Start(
        Placement(1000), new SettingsModel.Preferences([]),
        procedure(_Value: SettingsModel.Preferences) begin end procedure, Library, Saved
      );
      Until(Session, function(_State: Nav.State): bool => Session.State().Albums.Loaded);
      X.Assert.True(Has(Session, 'albums-empty'));
      X.Assert.Equal<string>(
        if FromArtist then
          'artists'
        else
          'albums'
        end if,
        Storage.FromWindow(Session.Window.Placement(), Session.State().Navigation).ActivePage
      );
    finally
      Library.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;

  // All Library pages and discovered playlists render; a compact sheet closes on selection.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure DestinationsAndCompactDrawer();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    for Name: string in ['Evening mix', 'Favourites', 'Workout'] do
      IO.File.WriteAllText(IO.Path.Combine(Root.Path, Name + '.m3u8'), 'missing.mp3' + #10);
    end for;
    const Source: Sources.MusicSource := new Sources.MusicSource(
      'music',
      'Music',
      Root.Path,
      false,
      [],
      ScanPlaylists := true
    );
    const Preferences: SettingsModel.Preferences := new SettingsModel.Preferences(
      [Source],
      'light'
    );
    const Save: procedure(SettingsModel.Preferences) := procedure(_Value: SettingsModel.Preferences) begin end procedure;
    const Library: Monitor.Session := Start(Source, Data.Path);
    try
      begin
        using const Session: Shell.Session := Shell.Session.Start(
          Placement(1000),
          Preferences,
          Save,
          Library
        );
        Until(
          Session,
          function(State: Nav.State): bool => State.Loaded and State.Playlists.Length = 3
        );
        X.Assert.False(Has(Session, 'drawer-open'));
        Capture(Session, 'navigation-desktop');
        for Page: Nav.Page in [
          Nav.Page.Music,
          Nav.Page.Albums,
          Nav.Page.Artists,
          Nav.Page.Genres,
          Nav.Page.Ratings
        ] do
          SetRoute(Session, Nav.Route.Page(Page));
          X.Assert.Equal<string>(
            Page.ToString().ToLowerInvariant(),
            Nav.Key(Session.State().Navigation.Active)
          );
          X.Assert.Contains<string>(Page.ToString(), Session.Window.Snapshot().Text);
          X.Assert.True(
            Has(
              Session, if Page = Nav.Page.Music then
                'track-search'
              elsif Nav.Browsing(Nav.Route.Page(Page)) then
                'albums-empty'
              else
                'page-placeholder'
              end if
            )
          );
          X.Assert.True(Has(Session, 'player-toggle'));
        end for;
        const Selected: Lists.Summary := Session.State().Navigation.Playlists[0];
        SetRoute(Session, Nav.Route.Playlist(Selected.Identity));
        X.Assert.Contains<string>('Evening mix', Session.Window.Snapshot().Text);
        X.Assert.True(Has(Session, 'player-toggle'));
        Capture(Session, 'navigation-playlist');
        SetRoute(Session, Nav.Route.Page(Nav.Page.Settings));
        X.Assert.False(Has(Session, 'player-toggle'));
      end;

      begin
        using const Session: Shell.Session := Shell.Session.Start(
          Placement(620),
          Preferences,
          Save,
          Library
        );
        Until(
          Session,
          function(State: Nav.State): bool => State.Loaded and State.Playlists.Length = 3
        );
        X.Assert.True(Has(Session, 'drawer-open'));
        X.Assert.False(Has(Session, 'navigation'));
        Capture(Session, 'navigation-compact');
        discard Session.Window.Post(App.Msg.Navigation(Nav.Msg.SetDrawer(true)));
        Pump(Session);
        X.Assert.True(Session.State().Navigation.Drawer);
        Capture(Session, 'navigation-drawer');
        SetRoute(Session, Nav.Route.Playlist(Session.State().Navigation.Playlists[0].Identity));
        X.Assert.False(Session.State().Navigation.Drawer);
        Settle(Session);
        X.Assert.Contains<string>('Evening mix', Session.Window.Snapshot().Text);
      end;
    finally
      Library.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;

  // Restarts handle deleted source files and parse failures without invalid navigation.
  [X.TheoryAttribute]
  [X.InlineDataAttribute(false)]
  [X.InlineDataAttribute(true)]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure PlaylistAfterRestart(Broken: bool);
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const File: string := IO.Path.Combine(Root.Path, 'Selected.xspf');
    IO.File.WriteAllText(
      File,
      '<playlist><trackList><track><location>missing.mp3</location></track></trackList></playlist>'
    );
    const Source: Sources.MusicSource := new Sources.MusicSource(
      'music',
      'Music',
      Root.Path,
      false,
      [],
      ScanPlaylists := true
    );
    const Preferences: SettingsModel.Preferences := new SettingsModel.Preferences([Source]);
    const Save: procedure(SettingsModel.Preferences) := procedure(_Value: SettingsModel.Preferences) begin end procedure;
    begin
      const Library: Monitor.Session := Start(Source, Data.Path);
      try
        using const Session: Shell.Session := Shell.Session.Start(
          Placement(1000),
          Preferences,
          Save,
          Library
        );
        Until(
          Session,
          function(State: Nav.State): bool => State.Loaded and State.Playlists.Length = 1
        );
        SetRoute(Session, Nav.Route.Playlist(Session.State().Navigation.Playlists[0].Identity));
        Storage.Save(
          Data.Path,
          Storage.FromWindow(Session.Window.Placement(), Session.State().Navigation)
        );
      finally
        Library.DisposeAsync().GetAwaiter().GetResult();
      end try;
    end;

    if Broken then
      IO.File.WriteAllText(File, '<playlist><track>');
    else
      IO.File.Delete(File);
    end if;
    const Saved: Storage.Snapshot := Storage.Load(Data.Path);
    const Restored: Nav.State := new Nav.State(
      Active := Nav.Parse(Saved.ActivePage) ?? Nav.Route.Page(Nav.Page.Music),
      SettingsTab := Saved.SettingsTab
    );
    X.Assert.StartsWith('playlist:', Nav.Key(Restored.Active));
    begin
      const Library: Monitor.Session := Start(Source, Data.Path);
      try
        using const Session: Shell.Session := Shell.Session.Start(
          Storage.ToWindow(Saved),
          Preferences,
          Save,
          Library,
          Restored
        );
        if Broken then
          Until(
            Session,
            function(State: Nav.State): bool => State.Loaded and State.Playlists.Length = 1
              and State.Playlists[
              0
            ].Error <> null
          );
          X.Assert.Equal<string>(Saved.ActivePage, Nav.Key(Session.State().Navigation.Active));
          X.Assert.True(Has(Session, 'navigation-error'));
          Capture(Session, 'navigation-unavailable-playlist');
        else
          Until(
            Session,
            function(State: Nav.State): bool => State.Loaded and State.Playlists.Length = 0
              and Nav.Key(
              State.Active
            ) = 'music'
          );
          X.Assert.Contains<string>('Music', Session.Window.Snapshot().Text);
        end if;

        Storage.Save(
          Data.Path,
          Storage.FromWindow(Session.Window.Placement(), Session.State().Navigation)
        );
        X.Assert.Equal<string>(
          if Broken then
            Saved.ActivePage
          else
            'music'
          end if, Storage.Load(Data.Path).ActivePage
        );
      finally
        Library.DisposeAsync().GetAwaiter().GetResult();
      end try;
    end;
  end procedure;
end record;

end unit;
