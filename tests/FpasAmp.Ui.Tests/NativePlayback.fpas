// Real shell, transport mailbox, decoder, device callback and native meter.
unit FpasAmp.Ui.Tests.NativePlayback;

uses
  FpasAmp.Ui.Albums.Music.Model as Music,
  FpasAmp.Ui.Shell as Shell, FpasAmp.Ui.App.Model as App,
  FpasAmp.Ui.Player.Model as Player, FpasAmp.Ui.Settings.Model as Settings,
  FpasAmp.Library.Metadata.Model as Tracks, FpasAmp.Library.Inventory.Monitoring as Monitor,
  FpasAmp.Library.Tests.Support as H, Fpas.Media.Audio as Audio, Fpas.Ui.Gui.Cui as Cui,
  FpasAmp.Library.Tests.MetadataSupport as Fixtures, FpasAmp.Library.Sources as Sources,
  FpasAmp.AppState as Storage, FpasAmp.Persistence.PlayerState as Transport,
  FpasAmp.Settings as Preferences, FpasAmp.Ui.Player.Presets as Presets,
  Fpas.Ui.Gui.Application as Gui, System as Sys, System.IO as IO,
  System.Collections.Immutable as I, System.Threading as T, Xunit as X;

procedure Tone(Path: string);
begin
  using const File: IO.BinaryWriter := new IO.BinaryWriter(IO.File.Create(Path));
  const Frames: int := 44100 * 5;
  File.Write($46464952);
  File.Write(36 + Frames * 4);
  File.Write($45564157);
  File.Write($20746D66);
  File.Write(16);
  File.Write(cast<short>(1));
  File.Write(cast<short>(2));
  File.Write(44100);
  File.Write(44100 * 4);
  File.Write(cast<short>(4));
  File.Write(cast<short>(16));
  File.Write($61746164);
  File.Write(Frames * 4);
  for Frame: int := 0 to Frames - 1 do
    const Sample: double := if Frame >= 44100 and Frame < 88200 then
      0.0
    else
      Sys.Math.Sin(2.0 * Sys.Math.PI * 500.0 * Frame / 44100.0)
    end if;
    File.Write(cast<short>(3277.0 * Sample));
    File.Write(cast<short>(819.0 * Sample));
  end for;
end procedure;

procedure WaitFor(Session: Shell.Session; Ready: function(Player.State): bool; Reason: string);
begin
  const Deadline: long := Sys.Environment.TickCount64 + 7000L;
  while Sys.Environment.TickCount64 < Deadline do
    discard Session.Window.Post(App.Msg.Settings(Settings.Msg.DismissError));
    X.Assert.True(Session.Window.Step());
    const Current: Player.State := Session.State().Player;
    X.Assert.Null(Current.Error);
    if Ready(Current) then
      return;
    end if;

    T.Thread.Sleep(3);
  end while;

  X.Assert.True(false, Reason);
end procedure;

procedure Send(Session: Shell.Session; Message: Player.Msg);
begin
  discard Session.Window.Post(App.Msg.Player(Message));
end procedure;

// Tests the player strip across transports, callbacks and automatic queue changes.
public type NativePlaybackTests = record
  // Close a playing queue, resolve it from disk, and explicitly resume the saved slot.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure RestartKeepsQueuePositionAndMixerInPause();
  begin
    using const Root: H.Folder := H.Folder.Create();
    using const Data: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'resume.wav');
    Tone(Path);
    IO.File.Copy(Path, IO.Path.Combine(Root.Path, 'another.wav'));
    const Source: Sources.MusicSource := Fixtures.Source(Root.Path) with
      Extensions := ['.wav'];
    end with;
    const Store: Monitor.Session := Fixtures.Start([Source], Data.Path);
    const Save: procedure(Settings.Preferences) := procedure(Value: Settings.Preferences) begin
      Preferences.Save(Data.Path, Value);
    end procedure;
    try
      const Entries: I.ImmutableArray<Tracks.Entry> := Fixtures.Until(
        Fixtures.Tags(Store),
        function(Items: I.ImmutableArray<Tracks.Entry>): bool => Items.Length = 2
      ).GetAwaiter().GetResult();
      var Placement: Cui.CuiWindowPlacement := new Cui.CuiWindowPlacement();
      Placement.Width := 1320;
      Placement.Height := 720;
      begin
        using const First: Shell.Session := Shell.Session.Start(
          Placement, new Settings.Preferences([Source]), Save,
          Store, Output := new Audio.Session(true)
        );
        Send(First, Player.Msg.Preset(1));
        Send(First, Player.Msg.Volume(-14.0F));
        Send(
          First,
          Player.Msg.Play(Entries, 1, new Music.Selection())
        );
        WaitFor(
          First,
          function(S: Player.State): bool => S.Position > 400.0 and S.Playing
            and First.State().Settings.Saved.Mixer.Volume = -14.0F,
          'Could not save the playing mixer.'
        );
        Storage.Save(
          Data.Path, Storage.FromWindow(
            First.Window.Placement(), First.State().Navigation,
            Transport.Capture(First.State().Player)
          )
        );
      end;
      const Saved: Transport.Saved := Storage.Load(Data.Path).Player;
      X.Assert.Equal<int>(1, Saved.Index);
      X.Assert.Equal<string>(Entries[1].TrackId, Saved.TrackId);
      const Found: I.ImmutableArray<Tracks.Entry> := Fixtures.Tags(Store).QueueAsync(
        Saved.Source.AlbumId,
        T.CancellationToken.None
      ).GetAwaiter().GetResult();
      const Restored: Player.State := Transport.Restore(Saved, Found);
      using const Second: Shell.Session := Shell.Session.Start(
        Placement, Preferences.Load(Data.Path), Save, Store,
        Output := new Audio.Session(true), Restored := Restored
      );
      WaitFor(
        Second,
        function(S: Player.State): bool => S.Waveform.Length > 0,
        'Missing restored waveform.'
      );
      T.Thread.Sleep(180);
      discard Second.Window.Post(App.Msg.Settings(Settings.Msg.DismissError));
      X.Assert.True(Second.Window.Step());
      const Paused: Player.State := Second.State().Player;
      X.Assert.False(Paused.Playing);
      X.Assert.True(Paused.NeedsOpen);
      X.Assert.Equal<double>(Saved.Position, Paused.Position);
      X.Assert.Equal<string>(Saved.TrackId, Paused.Queue[Paused.Index].TrackId);
      X.Assert.Equal<int>(2, Paused.Queue.Length);
      X.Assert.Equal<float>(-14.0F, Paused.Volume);
      X.Assert.Equal<int>(1, Presets.Match(Paused.Gains));
      Send(Second, Player.Msg.Toggle);
      WaitFor(
        Second, function(S: Player.State): bool => S.Playing and S.Position > Saved.Position
          and S.Position < Saved.Position + 800.0 and S.Levels[0] > 0.0F and S.Levels[0] < 0.035F,
        'Playback did not resume from the saved position at the saved gain.'
      );
    finally
      Store.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;

  // Plays a stereo tone twice to exercise same-path queue entries and the final end.
  [X.FactAttribute]
  [X.TraitAttribute('Category', 'Gui')]
  public procedure PlayerFollowsDeviceAndAdvancesExactlyOnce();
  begin
    using const Root: H.Folder := H.Folder.Create();
    const Path: string := IO.Path.Combine(Root.Path, 'tone.wav');
    Tone(Path);
    const First: Tracks.Entry := new Tracks.Entry(1L, 'one', Path, '', null, null, null);
    const Second: Tracks.Entry := First with
      FileId := 2L;
    end with;
    const Library: Monitor.Session := H.Start([], T.CancellationToken.None);
    try
      var Placement: Cui.CuiWindowPlacement := new Cui.CuiWindowPlacement();
      Placement.Width := 1320;
      Placement.Height := 720;
      using const Session: Shell.Session := Shell.Session.Start(
        Placement,
        new Settings.Preferences([]),
        procedure(_Value: Settings.Preferences) begin end procedure,
        Library,
        Output := new Audio.Session(
          Sys.Environment.GetEnvironmentVariable('FPAS_TEST_SYSTEM_OUTPUT') <> '1'
        )
      );
      Send(
        Session,
        Player.Msg.Play(
          I.ImmutableArray.CreateRange<Tracks.Entry>([First, Second]),
          0,
          new Music.Selection()
        )
      );
      WaitFor(
        Session,
        function(S: Player.State): bool => S.Position > 0.0 and S.Duration = 5000.0
          and S.Levels.Length = 2 and S.Levels[0] > 0.095F and S.Levels[1] < 0.026F,
        'No stereo levels from the decoder.'
      );
      var Meter: bool := false;
      for Widget: Gui.Control in Session.Window.Snapshot().Controls do
        if Widget.Id = 'player-levels' then
          Meter := true;
        end if;
      end for;

      X.Assert.True(Meter);
      WaitFor(
        Session, function(S: Player.State): bool => S.Waveform.Length > 0
          and S.Waveform[0] > 0.9F and S.Waveform[S.Waveform.Length div 4] = 0.0F,
        'The waveform did not show the silent passage.'
      );
      Send(Session, Player.Msg.Volume(-12.0F));
      WaitFor(
        Session,
        function(S: Player.State): bool => S.Levels[0] > 0.024F and S.Levels[0] < 0.027F,
        'Volume did not reach the device.'
      );
      Send(Session, Player.Msg.Gain(4, 6.0F));
      WaitFor(
        Session,
        function(S: Player.State): bool => S.Levels[0] > 0.048F and S.Levels[0] < 0.053F,
        'The 500 Hz band did not boost the tone.'
      );
      Send(Session, Player.Msg.Toggle);
      WaitFor(
        Session,
        function(S: Player.State): bool => not S.Playing and S.Levels[0] = 0.0F,
        'Pause did not silence the meter.'
      );
      Send(Session, Player.Msg.Seek(0.5F));
      WaitFor(
        Session,
        function(S: Player.State): bool => not S.Playing and S.Position = 2500.0,
        'Paused seek failed.'
      );
      Send(Session, Player.Msg.Toggle);
      WaitFor(
        Session,
        function(S: Player.State): bool => S.Playing and S.Position > 2500.0 and S.Levels[
          0
        ] > 0.048F,
        'Resume lost the seek position.'
      );
      Send(Session, Player.Msg.Seek(0.98F));
      WaitFor(
        Session,
        function(S: Player.State): bool => S.Index = 1 and S.Playing and S.Position > 0.0
          and S.Position < 1500.0 and S.Levels[
          0
        ] > 0.048F,
        'Natural end did not start the second track.'
      );
      Send(Session, Player.Msg.Seek(0.98F));
      WaitFor(
        Session,
        function(S: Player.State): bool => S.Index = 1 and S.Finished and not S.Playing
          and S.Position = S.Duration,
        'Playback did not stop at the end of the queue.'
      );
    finally
      Library.DisposeAsync().GetAwaiter().GetResult();
    end try;
  end procedure;
end record;

end unit;
