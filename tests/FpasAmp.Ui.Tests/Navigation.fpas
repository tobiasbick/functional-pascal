// Navigation restoration is validated independently of rendering and display names.
unit FpasAmp.Ui.Tests.Navigation;

uses
  FpasAmp.Ui.Navigation.Model as M, FpasAmp.Ui.Navigation.Update as Update,
  FpasAmp.Library.Playlists.Model as Lists, FpasAmp.AppState as AppState,
  FpasAmp.Library.Tests.Support as H, System.IO as IO, System.Collections.Immutable as I, Xunit as X;

function Playlist(Id: string; Name: string := 'Mix'; Error: string? := null): Lists.Summary;
begin
  return new Lists.Summary(new Lists.Key(Lists.Origin.File, Id), Name, null, 2L, Error);
end function;

// Persisted routes are stable keys; absent/corrupt destinations cannot break startup.
public type NavigationTests = record
  // Every fixed destination restores, and drawer selection retains the settings tab.
  [X.FactAttribute]
  public procedure FixedDestinationsAndSettingsTab();
  begin
    using const Folder: H.Folder := H.Folder.Create();
    for Page: M.Page in [
      M.Page.Music,
      M.Page.Albums,
      M.Page.Artists,
      M.Page.Genres,
      M.Page.Ratings,
      M.Page.Settings
    ] do
      const Route: M.Route := M.Route.Page(Page);
      const Selected: M.State := Update.Apply(
        new M.State(SettingsTab := 1, Drawer := true),
        M.Msg.Select(Route)
      );
      X.Assert.False(Selected.Drawer);
      X.Assert.Equal<int>(1, Selected.SettingsTab);
      AppState.Save(
        Folder.Path,
        new AppState.Snapshot(
          SettingsTab := Selected.SettingsTab,
          ActivePage := M.Key(Selected.Active)
        )
      );
      const Saved: AppState.Snapshot := AppState.Load(Folder.Path);
      X.Assert.Equal<string>(M.Key(Route), Saved.ActivePage);
      X.Assert.Equal<int>(1, Saved.SettingsTab);
      X.Assert.Equal<M.Route?>(Route, M.Parse(Saved.ActivePage));
    end for;
    const Settings: M.State := Update.Apply(new M.State(), M.Msg.SelectSettingsTab(1));
    X.Assert.Equal<string>('settings', M.Key(Settings.Active));
    X.Assert.Equal<int>(1, Settings.SettingsTab);
    X.Assert.Equal<int>(1, Update.Apply(Settings, M.Msg.SelectSettingsTab(99)).SettingsTab);
  end procedure;

  // A saved playlist waits for the first snapshot, then validates UUID/store identity.
  [X.FactAttribute]
  public procedure PlaylistRestoreAndMissingDestination();
  begin
    using const Folder: H.Folder := H.Folder.Create();
    const Id: string := '11111111111111111111111111111111';
    const Route: M.Route := M.Route.Playlist(new Lists.Key(Lists.Origin.File, Id));
    AppState.Save(Folder.Path, new AppState.Snapshot(ActivePage := M.Key(Route)));
    const Stored: M.Route? := M.Parse(AppState.Load(Folder.Path).ActivePage);
    X.Assert.NotNull(Stored);
    const Initial: M.State := new M.State(Active := Stored ?? M.Route.Page(M.Page.Music));
    X.Assert.Equal<string>(M.Key(Route), M.Key(Initial.Active));
    X.Assert.False(Initial.Loaded);
    const Items: I.ImmutableArray<Lists.Summary> := I.ImmutableArray.Create<Lists.Summary>(
      Playlist(Id),
      Playlist('22222222222222222222222222222222')
    );
    const Found: M.State := Update.Apply(Initial, M.Msg.Received(Items));
    X.Assert.Equal<string>(M.Key(Route), M.Key(Found.Active));
    X.Assert.Equal<int>(2, Found.Playlists.Length);
    const Failed: M.State := Update.Apply(
      Found,
      M.Msg.Received(I.ImmutableArray.Create<Lists.Summary>(Playlist(Id, Error := 'Read failed')))
    );
    X.Assert.Equal<string>(M.Key(Route), M.Key(Failed.Active));
    const Missing: M.State := Update.Apply(
      Found,
      M.Msg.Received(I.ImmutableArray<Lists.Summary>.Empty)
    );
    X.Assert.Equal<string>('music', M.Key(Missing.Active));
    X.Assert.Equal<string>('music', M.Key(Update.Apply(Missing, M.Msg.Select(Route)).Active));
    const MissingAtStartup: M.State := Update.Apply(
      Initial,
      M.Msg.Received(I.ImmutableArray<Lists.Summary>.Empty)
    );
    X.Assert.Equal<string>('music', M.Key(MissingAtStartup.Active));
    AppState.Save(Folder.Path, new AppState.Snapshot(ActivePage := M.Key(MissingAtStartup.Active)));
    X.Assert.Equal<string>('music', AppState.Load(Folder.Path).ActivePage);
  end procedure;

  // A failed refresh retains cached navigation instead of simulating source deletion.
  [X.FactAttribute]
  public procedure RefreshFailureRetainsCachedSelection();
  begin
    const Item: Lists.Summary := Playlist('11111111111111111111111111111111');
    const Current: M.State := new M.State(
      Active := M.Route.Playlist(Item.Identity),
      Loaded := true,
      Playlists := I.ImmutableArray.Create<Lists.Summary>(Item)
    );
    const Failed: M.State := Update.Apply(Current, M.Msg.Failed('Catalogue unavailable'));
    X.Assert.Equal<string>(M.Key(Current.Active), M.Key(Failed.Active));
    X.Assert.Equal<string>('Catalogue unavailable', Failed.Error);
    X.Assert.Equal<int>(1, Failed.Playlists.Length);
  end procedure;

  // Unknown pages, invalid playlist UUIDs and malformed tabs repair to safe defaults.
  [X.TheoryAttribute]
  [X.InlineDataAttribute('unknown')]
  [X.InlineDataAttribute('album:invalid')]
  [X.InlineDataAttribute('playlist:file:missing')]
  [X.InlineDataAttribute('playlist:invalid:11111111111111111111111111111111')]
  public procedure InvalidSavedRoute(Page: string);
  begin
    using const Folder: H.Folder := H.Folder.Create();
    IO.File.WriteAllText(
      IO.Path.Combine(Folder.Path, 'state.json'),
      '{"width":1000,"height":680,"x":null,"y":null,"maximized":false,"settingsTab":99,"activePage":"' +
      Page + '"}'
    );
    const Saved: AppState.Snapshot := AppState.Load(Folder.Path);
    X.Assert.Equal<string>('music', Saved.ActivePage);
    X.Assert.Equal<int>(0, Saved.SettingsTab);
  end procedure;
end record;

end unit;
