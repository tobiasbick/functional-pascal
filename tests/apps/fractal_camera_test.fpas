program FractalCameraTest;

uses Fractal.Camera as Camera2;
uses Std.Math as Math;
uses Std.Test as Test;

begin
  const Camera: Camera2.ExplorerCamera := Camera2.ExplorerCamera(CenterX := -0.45, CenterY := -0.55, SpanY := 2.8, MaxIter := 160, Palette := 2);
  Test.AssertTrue(Math.Abs(Camera2.ExplorerCameraSpanX(Camera, 80, 40) - 2.8) < 0.000001);
  Test.AssertTrue(Math.Abs(Camera2.ExplorerCameraXMin(Camera, 80, 40) + 1.85) < 0.000001);
  Test.AssertTrue(Math.Abs(Camera2.ExplorerCameraXMax(Camera, 80, 40) - 0.95) < 0.000001);
  Test.AssertTrue(Math.Abs(Camera2.ExplorerCameraYMin(Camera) + 1.95) < 0.000001);
  Test.AssertTrue(Math.Abs(Camera2.ExplorerCameraYMax(Camera) - 0.85) < 0.000001);
  Test.AssertTrue(Math.Abs(Camera2.ExplorerCameraGetZoom(Camera) - 1.0) < 0.000001);
  Test.AssertTrue(Camera2.ExplorerCameraSpanX(Camera, 0, 0) > 0.0);
end program;
