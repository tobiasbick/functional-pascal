program FractalCameraTest;

uses Fractal.Camera, Std.Math, Std.Test;

begin
  var Camera: ExplorerCamera := record
    CenterX := -0.45;
    CenterY := -0.55;
    SpanY := 2.8;
    MaxIter := 160;
    Palette := 2;
  end;

  AssertTrue(Abs(Camera.SpanX(80, 40) - 2.8) < 0.000001);
  AssertTrue(Abs(Camera.XMin(80, 40) + 1.85) < 0.000001);
  AssertTrue(Abs(Camera.XMax(80, 40) - 0.95) < 0.000001);
  AssertTrue(Abs(Camera.YMin() + 1.95) < 0.000001);
  AssertTrue(Abs(Camera.YMax() - 0.85) < 0.000001);
  AssertTrue(Abs(Camera.Zoom - 1.0) < 0.000001);
  AssertTrue(Camera.SpanX(0, 0) > 0.0)
end.
