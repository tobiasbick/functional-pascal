// Covers Local Chat rendering, editing, resizing, transcript, and quit behavior.
program LocalChatWorkflowTest;

uses LocalChat.Model as Model2;
uses LocalChat.Theme as Theme;
uses LocalChat.Update as Update;
uses LocalChat.View as View;
uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

// Reports whether any rendered row contains text.
//
// Parameters:
// - `Snapshot`: Rendered surface to inspect.
// - `Text`: Text fragment to find.
function ScreenContains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Str.Contains(Snapshot.LineAt(Row), Text) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

// Creates the Alt+X key event used by the application quit shortcut.
function QuitKey(): Tui.TuiKeyEvent;
begin
  return record
    kind := Tui.TuiKeyKind.Character;
    ch := 'x';
    shift := false;
    ctrl := false;
    alt := true;
    meta := false;
  end record;
end function;

begin
  mutable var Model: Model2.LocalChatModel := Model2.LocalChatModelCreate(80, 24);
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTestWithPalette(Tui.TuiSize.Create(80, 24), Theme.LocalChatPalette());
  Model := App.RunIterations(Model, Update.LocalChatUpdate, View.LocalChatView, 0, 0);
  var Initial: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertTrue(ScreenContains(Initial, 'LOCAL CHAT'));
  Test.AssertTrue(ScreenContains(Initial, 'No messages yet.'));
  Test.AssertTrue(ScreenContains(Initial, 'Message the local model'));
  App.Inject(Tui.TuiMsgTextChanged(Tui.TuiControlId.Create(1), Tui.TuiAction.Create(1), 'hello', 5));
  Model := App.RunIterations(Model, Update.LocalChatUpdate, View.LocalChatView, 1, 0);
  Test.AssertEquals('hello', Model.Draft);
  Test.AssertEquals(5, Model.DraftCaret);
  Model.Entries := [
                     Model2.ChatEntry.User('A deliberately long user line for wrapping'),
                     Model2.ChatEntry.Assistant('Local answer')
                   ];
  Model := Model2.LocalChatScrollToEnd(Model);
  Test.AssertTrue(Str.Contains(Model2.LocalChatTranscript(Model), 'YOU'));
  Test.AssertTrue(Str.Contains(Model2.LocalChatTranscript(Model), 'ASSISTANT'));
  Model := App.RunIterations(Model, Update.LocalChatUpdate, View.LocalChatView, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Local answer'));
  App.InjectResizeForTest(Tui.TuiSize.Create(60, 18));
  Model := App.RunIterations(Model, Update.LocalChatUpdate, View.LocalChatView, 1, 0);
  Test.AssertEquals(60, Model.Width);
  Test.AssertEquals(18, Model.Height);
  var Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  discard Update.LocalChatUpdate(Model, Tui.TuiMsg.Key(QuitKey()), Cmd);
  Test.AssertTrue(Cmd.Command() = Tui.TuiCmd.Quit);
  App.Close();
end program;
