// Covers Local Chat rendering, editing, resizing, transcript, and quit behavior.
program LocalChatWorkflowTest;

uses LocalChat.Model as Model2;
uses LocalChat.Theme as Theme;
uses LocalChat.Update as Update;
uses LocalChat.View as View;
uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering2;
uses Std.Tui.Runtime as Runtime;

// Reports whether any rendered row contains text.
//
// Parameters:
// - `Snapshot`: Rendered surface to inspect.
// - `Text`: Text fragment to find.
function ScreenContains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Str.Contains(Rendering2.TuiSurfaceSnapshotLineAt(Snapshot, Row), Text) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

// Creates the Alt+X key event used by the application quit shortcut.
function QuitKey(): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Tui.TuiKeyKind.Character, ch := 'x', shift := false, ctrl := false, alt := true, meta := false);
end function;

begin
  var Model: Model2.LocalChatModel := Model2.LocalChatModelCreate(80, 24);
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTestWithPalette(Geometry.TuiSizeCreate(80, 24), Theme.LocalChatPalette());
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.LocalChatUpdate, View.LocalChatView, 0, 0);
  const Initial: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertTrue(ScreenContains(Initial, 'LOCAL CHAT'));
  Test.AssertTrue(ScreenContains(Initial, 'No messages yet.'));
  Test.AssertTrue(ScreenContains(Initial, 'Message the local model'));
  Runtime.TuiApplicationInject(App, Tui.TuiMsgTextChanged(Ids.TuiControlIdCreate(1), Ids.TuiActionCreate(1), 'hello', 5));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.LocalChatUpdate, View.LocalChatView, 1, 0);
  Test.AssertEquals('hello', Model.Draft);
  Test.AssertEquals(5, Model.DraftCaret);
  Model.Entries := [
                     Model2.ChatEntryUser('A deliberately long user line for wrapping'),
                     Model2.ChatEntryAssistant('Local answer')
                   ];
  Model := Model2.LocalChatScrollToEnd(Model);
  Test.AssertTrue(Str.Contains(Model2.LocalChatTranscript(Model), 'YOU'));
  Test.AssertTrue(Str.Contains(Model2.LocalChatTranscript(Model), 'ASSISTANT'));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.LocalChatUpdate, View.LocalChatView, 0, 0);
  Test.AssertTrue(ScreenContains(Runtime.TuiApplicationSurfaceSnapshot(App), 'Local answer'));
  Runtime.TuiApplicationInjectResizeForTest(App, Geometry.TuiSizeCreate(60, 18));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.LocalChatUpdate, View.LocalChatView, 1, 0);
  Test.AssertEquals(60, Model.Width);
  Test.AssertEquals(18, Model.Height);
  const Cmd: Tui.TuiCmdOutput := Runtime.TuiCmdOutputCreate();
  discard Update.LocalChatUpdate(Model, Tui.TuiMsg.Key(QuitKey()), Cmd);
  Test.AssertTrue(Runtime.TuiCmdOutputCommand(Cmd) = Tui.TuiCmd.Quit);
  Runtime.TuiApplicationClose(App);
end program;
