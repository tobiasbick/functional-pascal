program MandelbrotBackgroundTest;

uses Mandelbrot.App as App;
uses Mandelbrot.Color as Color;
uses Mandelbrot.Model as Model2;
uses Mandelbrot.Render as Render;
uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Tui as Tui;

procedure AssertColorEquals(Expected: Tui.TuiColor; Actual: Tui.TuiColor);
begin
  Test.AssertTrue(Expected.Kind = Actual.Kind);
  Test.AssertEquals(Expected.Index, Actual.Index);
  Test.AssertEquals(Expected.Red, Actual.Red);
  Test.AssertEquals(Expected.Green, Actual.Green);
  Test.AssertEquals(Expected.Blue, Actual.Blue);
end procedure;

procedure AssertCellEquals(Expected: Tui.TuiCell; Actual: Tui.TuiCell);
begin
  Test.AssertEquals(Expected.Glyph, Actual.Glyph);
  Test.AssertTrue(Expected.Role = Actual.Role);
  Test.AssertEquals(Expected.Columns, Actual.Columns);
  case Expected.ConcreteStyle of
    when Option.Some(const ExpectedStyle):
      begin
        case Actual.ConcreteStyle of
          when Option.Some(const ActualStyle):
            begin
              AssertColorEquals(ExpectedStyle.Foreground, ActualStyle.Foreground);
              AssertColorEquals(ExpectedStyle.Background, ActualStyle.Background);
              Test.AssertTrue(ExpectedStyle.Bold = ActualStyle.Bold);
              Test.AssertTrue(ExpectedStyle.Dim = ActualStyle.Dim);
              Test.AssertTrue(ExpectedStyle.Underline = ActualStyle.Underline);
              Test.AssertTrue(ExpectedStyle.Inverse = ActualStyle.Inverse);
            end;
          when Option.None:
            begin
              Test.Fail('expected a concrete Mandelbrot cell style');
            end;
        end case;
      end;
    when Option.None:
      begin
        Test.AssertTrue(Options.IsNone(Actual.ConcreteStyle));
      end;
  end case;
end procedure;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Console.keyevent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

begin
  var Inbox: channel of (Render.MandelbrotRenderFrame) := Tasks.CreateChannel(16);
  mutable var Model: Model2.MandelbrotModel := Model2.NewMandelbrotModel(Inbox, 9, 15);
  var Request: Render.MandelbrotRenderRequest := Model2.MandelbrotRequest(Model);
  var Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  var Stale: Render.MandelbrotRenderFrame := Render.MandelbrotRenderFrame(Generation := Model.Generation -
                                                                                        1, Cells := Render.RenderGrid(Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.Width, Request.Height, Request.MaxIter, Request.Palette)
                                                                                                      .Cells);
  Model := App.UpdateMandelbrotFrame(Model, Stale, Cmd);
  Test.AssertEquals(0, Model.RowsRendered);
  var Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  Test.AssertTrue(Results.IsOk(Render.RunBackgroundRender(Request, Inbox, Tasks.GetCancellationToken(Source))));
  var Frame: Render.MandelbrotRenderFrame := Results.Unwrap(Tasks.ReceiveWithTimeout(Inbox, 5000));
  Test.AssertEquals(Request.Generation, Frame.Generation);
  Test.AssertEquals(Request.Width * Request.Height, Arrays.Length(Frame.Cells));
  Test.AssertTrue(Results.IsError(Tasks.ReceiveWithTimeout(Inbox, 0)));
  Model := App.UpdateMandelbrotFrame(Model, Frame, Cmd);
  Test.AssertEquals(Request.Height, Model.RowsRendered);
  var Expected: Tui.TuiCellGrid := Render.RenderGrid(Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.Width, Request.Height, Request.MaxIter, Request.Palette);
  for CellIndex: integer := 0 to Arrays.Length(Expected.Cells) - 1 do
    begin
      AssertCellEquals(Expected.Cells[CellIndex], Model.Grid.Cells[CellIndex]);
    end;
  end for;

  Cmd.Reset();
  Model := App.UpdateMandelbrot(Model, Tui.TuiMsg.Started, Cmd);
  Test.AssertEquals(1, Arrays.Length(Cmd.ReadBackground()));
  var OldGeneration: integer := Model.Generation;
  Cmd.Reset();
  Model := App.UpdateMandelbrot(Model, Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Left, '')), Cmd);
  Test.AssertEquals(OldGeneration + 1, Model.Generation);
  for CellIndex: integer := 0 to Arrays.Length(Expected.Cells) - 1 do
    begin
      AssertCellEquals(Expected.Cells[CellIndex], Model.Grid.Cells[CellIndex]);
    end;
  end for;

  Test.AssertEquals(0, Model.RowsRendered);
  Test.AssertEquals(1, Arrays.Length(Cmd.ReadBackground()));
  var CancelInbox: channel of (Render.MandelbrotRenderFrame) := Tasks.CreateChannel(1);
  var CancelSource: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  var CancelRequest: Render.MandelbrotRenderRequest := Render.MandelbrotRenderRequest(Generation := 99, XMin := 0.0, XMax := 0.0, YMin := 0.0, YMax := 0.0, Width := 8, Height := 100, MaxIter := 2048, Palette := Color.PaletteKind.DeepOcean);
  var CancelToken: Tasks.CancellationToken := Tasks.GetCancellationToken(CancelSource);
  // Fill the output queue so publication must wait until cancellation.
  discard Tasks.Send(CancelInbox, Frame);
  var Background: task := go Render.RunBackgroundRender(CancelRequest, CancelInbox, CancelToken);
  Test.AssertTrue(Results.IsError(Tasks.WaitAnyWithTimeout([Background], 1)));
  Test.AssertTrue(Tasks.Cancel(CancelSource));
  Test.AssertTrue(Results.IsOk(Tasks.Wait(Background)));
  Test.AssertEquals(Frame.Generation, Results.Unwrap(Tasks.Receive(CancelInbox)).Generation);
  Test.AssertTrue(Results.IsError(Tasks.ReceiveWithTimeout(CancelInbox, 0)));
  discard Tasks.CloseChannel(Inbox);
  discard Tasks.CloseChannel(CancelInbox);
end program;
