program MandelbrotBackgroundTest;

uses
  Mandelbrot.App, Mandelbrot.Color, Mandelbrot.Model, Mandelbrot.Render, Std.Console, Std.Tasks,
  Std.Test, Std.Tui;

procedure AssertColorEquals(Expected: TuiColor; Actual: TuiColor);
begin
  AssertTrue(Expected.Kind = Actual.Kind);
  AssertEquals(Expected.Index, Actual.Index);
  AssertEquals(Expected.Red, Actual.Red);
  AssertEquals(Expected.Green, Actual.Green);
  AssertEquals(Expected.Blue, Actual.Blue);
end procedure;

procedure AssertCellEquals(Expected: TuiCell; Actual: TuiCell);
begin
  AssertEquals(Expected.Glyph, Actual.Glyph);
  AssertTrue(Expected.Role = Actual.Role);
  AssertEquals(Expected.Columns, Actual.Columns);
  case Expected.ConcreteStyle of
    when Some(ExpectedStyle):
      begin
        case Actual.ConcreteStyle of
          when Some(ActualStyle):
            begin
              AssertColorEquals(ExpectedStyle.Foreground, ActualStyle.Foreground);
              AssertColorEquals(ExpectedStyle.Background, ActualStyle.Background);
              AssertTrue(ExpectedStyle.Bold = ActualStyle.Bold);
              AssertTrue(ExpectedStyle.Dim = ActualStyle.Dim);
              AssertTrue(ExpectedStyle.Underline = ActualStyle.Underline);
              AssertTrue(ExpectedStyle.Inverse = ActualStyle.Inverse);
            end;
          when None:
            begin
              Fail('expected a concrete Mandelbrot cell style');
            end;
        end case;
      end;
    when None:
      begin
        AssertTrue(Actual.ConcreteStyle.IsNone());
      end;
  end case;
end procedure;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
end function;

begin
  const Inbox: channel of MandelbrotRenderFrame := CreateChannel(16);
  var Model: MandelbrotModel := NewMandelbrotModel(Inbox, 9, 15);
  const Request: MandelbrotRenderRequest := MandelbrotRequest(Model);
  const Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  const Stale: MandelbrotRenderFrame := record
    Generation := Model.Generation - 1;
    Cells := RenderGrid(Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.Width, Request.Height, Request.MaxIter, Request.Palette).Cells;
  end;

  Model := UpdateMandelbrotFrame(Model, Stale, Cmd);
  AssertEquals(0, Model.RowsRendered);
  const Source: CancellationSource := CreateCancellationSource();
  AssertTrue(RunBackgroundRender(Request, Inbox, GetCancellationToken(Source)).IsOk());
  const Frame: MandelbrotRenderFrame := ReceiveWithTimeout(Inbox, 5000).Unwrap();
  AssertEquals(Request.Generation, Frame.Generation);
  AssertEquals(Request.Width * Request.Height, Frame.Cells.Length());
  AssertTrue(ReceiveWithTimeout(Inbox, 0).IsError());
  Model := UpdateMandelbrotFrame(Model, Frame, Cmd);
  AssertEquals(Request.Height, Model.RowsRendered);
  const Expected: TuiCellGrid := RenderGrid(Request.XMin, Request.XMax, Request.YMin, Request.YMax, Request.Width, Request.Height, Request.MaxIter, Request.Palette);
  for CellIndex: integer := 0 to Expected.Cells.Length() - 1 do
    begin
      AssertCellEquals(Expected.Cells[CellIndex], Model.Grid.Cells[CellIndex]);
    end;
  end for;

  Cmd.Reset();
  Model := UpdateMandelbrot(Model, TuiMsg.Started, Cmd);
  AssertEquals(1, Cmd.ReadBackground().Length());
  const OldGeneration: integer := Model.Generation;
  Cmd.Reset();
  Model := UpdateMandelbrot(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Left, '')), Cmd);
  AssertEquals(OldGeneration + 1, Model.Generation);
  for CellIndex: integer := 0 to Expected.Cells.Length() - 1 do
    begin
      AssertCellEquals(Expected.Cells[CellIndex], Model.Grid.Cells[CellIndex]);
    end;
  end for;

  AssertEquals(0, Model.RowsRendered);
  AssertEquals(1, Cmd.ReadBackground().Length());
  const CancelInbox: channel of MandelbrotRenderFrame := CreateChannel(1);
  const CancelSource: CancellationSource := CreateCancellationSource();
  const CancelRequest: MandelbrotRenderRequest := record
    Generation := 99;
    XMin := 0.0;
    XMax := 0.0;
    YMin := 0.0;
    YMax := 0.0;
    Width := 8;
    Height := 100;
    MaxIter := 2048;
    Palette := PaletteKind.DeepOcean;
  end;
  const CancelToken: CancellationToken := GetCancellationToken(CancelSource);
  // Fill the output queue so publication must wait until cancellation.
  discard Send(CancelInbox, Frame);
  const Background: task := go RunBackgroundRender(CancelRequest, CancelInbox, CancelToken);
  AssertTrue(WaitAnyWithTimeout([Background], 1).IsError());
  AssertTrue(Cancel(CancelSource));
  AssertTrue(Wait(Background).IsOk());
  AssertEquals(Frame.Generation, Receive(CancelInbox).Unwrap().Generation);
  AssertTrue(ReceiveWithTimeout(CancelInbox, 0).IsError());
  discard CloseChannel(Inbox);
  discard CloseChannel(CancelInbox);
end.
