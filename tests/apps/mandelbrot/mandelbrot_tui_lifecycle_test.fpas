program MandelbrotTuiLifecycleTest;

uses Mandelbrot.App as App2;
uses Mandelbrot.Model as Model2;
uses Mandelbrot.Render as Render;
uses Mandelbrot.View as View;
uses Std.Arrays as Arrays;
uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Runtime as Runtime;

function MakeLeftKey(): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Tui.TuiKeyKind.Left, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

begin
  const Inbox: channel of (Render.MandelbrotRenderFrame) := Tasks.CreateChannel(4);
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(9, 15));
  var Model: Model2.MandelbrotModel := Model2.NewMandelbrotModel(Inbox, 9, 15);
  Model := Runtime.TuiApplicationRunBackgroundIterations(App, Model, Inbox, App2.UpdateMandelbrot, App2.UpdateMandelbrotFrame, View.ViewMandelbrot, 1, 0);
  const InitialGeneration: integer := Model.Generation;
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.Key(MakeLeftKey()));
  Model := Runtime.TuiApplicationRunBackgroundIterations(App, Model, Inbox, App2.UpdateMandelbrot, App2.UpdateMandelbrotFrame, View.ViewMandelbrot, 1, 0);
  Test.AssertEquals(InitialGeneration + 1, Model.Generation);
  Test.AssertEquals(0, Model.RowsRendered);
  var Attempts: integer := 0;
  while (Model.RowsRendered < Model.Grid.Height) and (Attempts < 500) do
    begin
      Time.Sleep(1);
      Model := Runtime.TuiApplicationRunBackgroundIterations(App, Model, Inbox, App2.UpdateMandelbrot, App2.UpdateMandelbrotFrame, View.ViewMandelbrot, 1, 0);
      Attempts := Attempts + 1;
    end;
  end while;

  Test.AssertEquals(Model.Grid.Height, Model.RowsRendered);
  Runtime.TuiApplicationCloseWithBackground(App, Inbox);
  Test.AssertTrue(Results.IsError(Tasks.TrySend(Inbox, Render.MandelbrotRenderFrame(Generation := Model.Generation, Cells := []))));
end program;
