program MandelbrotTuiLifecycleTest;

uses
  Mandelbrot.App, Mandelbrot.Model, Mandelbrot.Render, Mandelbrot.View, Std.Tasks, Std.Test,
  Std.Time, Std.Tui;

function MakeLeftKey(): TuiKeyEvent;
begin
  return record
    kind := TuiKeyKind.Left;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
end function;

begin
  const Inbox: channel of MandelbrotRenderFrame := CreateChannel(4);
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(9, 15));
  var Model: MandelbrotModel := NewMandelbrotModel(Inbox, 9, 15);
  Model := App.RunBackgroundIterations(Model, Inbox, UpdateMandelbrot, UpdateMandelbrotFrame, ViewMandelbrot, 1, 0);
  const InitialGeneration: integer := Model.Generation;
  App.Inject(TuiMsg.Key(MakeLeftKey()));
  Model := App.RunBackgroundIterations(Model, Inbox, UpdateMandelbrot, UpdateMandelbrotFrame, ViewMandelbrot, 1, 0);
  AssertEquals(InitialGeneration + 1, Model.Generation);
  AssertEquals(0, Model.RowsRendered);
  var Attempts: integer := 0;
  while (Model.RowsRendered < Model.Grid.Height) and (Attempts < 500) do
    begin
      Sleep(1);
      Model := App.RunBackgroundIterations(Model, Inbox, UpdateMandelbrot, UpdateMandelbrotFrame, ViewMandelbrot, 1, 0);
      Attempts := Attempts + 1;
    end;
  end while;

  AssertEquals(Model.Grid.Height, Model.RowsRendered);
  App.CloseWithBackground(Inbox);
  AssertTrue(TrySend(Inbox, record
    Generation := Model.Generation;
    Cells := [];
  end).IsError());
end.
