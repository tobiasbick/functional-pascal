program NoteDirectoryIdentityTest;

uses
  Notes.Model as Model, Notes.Repository as Repository, Notes.Update as Update, Std.Fs as Fs,
  Std.Path as Path, Std.Test as Test, Std.Tui as Tui;

procedure CheckDirectory(Name: string; Sibling: string);
begin
  const Root: string := Test.ScratchDir();
  const Directory: string := Path.Join([Root, Name]);
  const Adjacent: string := Path.Join([Root, Sibling]);
  Test.AssertTrue(Repository.NotesEnsureDirectory(Directory).Unwrap());
  var Outside: Model.Note := Model.NoteCreate('outside', 1);
  Outside.Title := 'untouched';
  Test.AssertTrue(Repository.NotesSave(Adjacent, Outside).Unwrap());
  const Before: string := Fs.ReadText(Repository.NoteFilePath(Adjacent, Outside)).Unwrap();
  Test.AssertEquals(0, Repository.NotesLoadDirectory(Directory).Unwrap().Notes.Length());
  var Inside: Model.Note := Model.NoteCreate('inside', 2);
  Test.AssertTrue(Repository.NotesSave(Directory, Inside).Unwrap());
  const Loaded: Model.NotesLoad := Repository.NotesLoadDirectory(Directory).Unwrap();
  Test.AssertEquals(1, Loaded.Notes.Length());
  Test.AssertEquals(
    Repository.NoteFilePath(Directory, Inside).Replace('\', '/'),
    Loaded.Notes[0].Path.Replace('\', '/')
  );
  Inside := Loaded.Notes[0];
  Inside.Title := 'edited';
  Test.AssertTrue(Repository.NotesSave(Directory, Inside).Unwrap());
  Test.AssertEquals(Before, Fs.ReadText(Repository.NoteFilePath(Adjacent, Outside)).Unwrap());
end procedure;

begin
  CheckDirectory('set[1]', 'set1');
  CheckDirectory('space [open', 'space open');
  const Directory: string := Test.ScratchDir() + '/duplicates';
  var First: Model.Note := Model.NoteCreate('duplicate', 1);
  First.Path := Directory + '/first.note';
  First.Title := 'first';
  var Second: Model.Note := First;
  Second.Path := Directory + '/second.note';
  Second.Title := 'second';
  const Unique: Model.Note := Model.NoteCreate('unique', 3);
  Test.AssertTrue(Repository.NotesSave(Directory, First).Unwrap());
  Test.AssertTrue(Repository.NotesSave(Directory, Second).Unwrap());
  Test.AssertTrue(Repository.NotesSave(Directory, Unique).Unwrap());
  const FirstText: string := Fs.ReadText(First.Path).Unwrap();
  const SecondText: string := Fs.ReadText(Second.Path).Unwrap();
  const Loaded: Model.NotesLoad := Repository.NotesLoadDirectory(Directory).Unwrap();
  Test.AssertEquals(1, Loaded.Notes.Length());
  Test.AssertEquals(2, Loaded.Issues.Length());
  Test.AssertEquals('unique', Loaded.Notes[0].Id);
  Test.AssertTrue((Loaded.Issues[0].Path = First.Path) or (Loaded.Issues[1].Path = First.Path));
  Test.AssertTrue((Loaded.Issues[0].Path = Second.Path) or (Loaded.Issues[1].Path = Second.Path));
  var State: Model.NotesModel := Model.NotesModelCreate(Directory, Loaded);
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  State := Update.NotesUpdate(
    State,
    Tui.TuiMsgSelectionChanged(Tui.TuiControlId.Create(2), Tui.TuiAction.Create(2), 0),
    Cmd
  );
  State.Dirty := true;
  State := Update.NotesPersistCurrent(State);
  Test.AssertFalse(State.Dirty);
  State := Update.NotesUpdate(
    State,
    Tui.TuiMsgAction(Tui.TuiControlId.Create(23), Tui.TuiAction.Create(13)),
    Cmd
  );
  Test.AssertEquals(-1, State.Selected);
  Test.AssertEquals(FirstText, Fs.ReadText(First.Path).Unwrap());
  Test.AssertEquals(SecondText, Fs.ReadText(Second.Path).Unwrap());
end.
