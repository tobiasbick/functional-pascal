program NoteDirectoryIdentityTest;

uses Notes.Model, Notes.Repository, Notes.Update, Std.Fs, Std.Path, Std.Test, Std.Tui;

procedure CheckDirectory(Name: string; Sibling: string);
begin
  const Root: string := ScratchDir();
  const Directory: string := Std.Path.Join([Root, Name]);
  const Adjacent: string := Std.Path.Join([Root, Sibling]);
  AssertTrue(NotesEnsureDirectory(Directory).Unwrap());
  var Outside: Note := NoteCreate('outside', 1);
  Outside.Title := 'untouched';
  AssertTrue(NotesSave(Adjacent, Outside).Unwrap());
  const Before: string := Std.Fs.ReadText(NoteFilePath(Adjacent, Outside)).Unwrap();
  AssertEquals(0, NotesLoadDirectory(Directory).Unwrap().Notes.Length());
  var Inside: Note := NoteCreate('inside', 2);
  AssertTrue(NotesSave(Directory, Inside).Unwrap());
  const Loaded: NotesLoad := NotesLoadDirectory(Directory).Unwrap();
  AssertEquals(1, Loaded.Notes.Length());
  AssertEquals(NoteFilePath(Directory, Inside).Replace('\', '/'), Loaded.Notes[0].Path.Replace('\', '/'));
  Inside := Loaded.Notes[0];
  Inside.Title := 'edited';
  AssertTrue(NotesSave(Directory, Inside).Unwrap());
  AssertEquals(Before, Std.Fs.ReadText(NoteFilePath(Adjacent, Outside)).Unwrap());
end procedure;

begin
  CheckDirectory('set[1]', 'set1');
  CheckDirectory('space [open', 'space open');
  const Directory: string := ScratchDir() + '/duplicates';
  var First: Note := NoteCreate('duplicate', 1);
  First.Path := Directory + '/first.note';
  First.Title := 'first';
  var Second: Note := First;
  Second.Path := Directory + '/second.note';
  Second.Title := 'second';
  const Unique: Note := NoteCreate('unique', 3);
  AssertTrue(NotesSave(Directory, First).Unwrap());
  AssertTrue(NotesSave(Directory, Second).Unwrap());
  AssertTrue(NotesSave(Directory, Unique).Unwrap());
  const FirstText: string := Std.Fs.ReadText(First.Path).Unwrap();
  const SecondText: string := Std.Fs.ReadText(Second.Path).Unwrap();
  const Loaded: NotesLoad := NotesLoadDirectory(Directory).Unwrap();
  AssertEquals(1, Loaded.Notes.Length());
  AssertEquals(2, Loaded.Issues.Length());
  AssertEquals('unique', Loaded.Notes[0].Id);
  AssertTrue((Loaded.Issues[0].Path = First.Path) or (Loaded.Issues[1].Path = First.Path));
  AssertTrue((Loaded.Issues[0].Path = Second.Path) or (Loaded.Issues[1].Path = Second.Path));
  var State: NotesModel := NotesModelCreate(Directory, Loaded);
  const Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  State := NotesUpdate(State, TuiMsgSelectionChanged(TuiControlId.Create(2), TuiAction.Create(2), 0), Cmd);
  State.Dirty := true;
  State := NotesPersistCurrent(State);
  AssertFalse(State.Dirty);
  State := NotesUpdate(State, TuiMsgAction(TuiControlId.Create(23), TuiAction.Create(13)), Cmd);
  AssertEquals(-1, State.Selected);
  AssertEquals(FirstText, Std.Fs.ReadText(First.Path).Unwrap());
  AssertEquals(SecondText, Std.Fs.ReadText(Second.Path).Unwrap());
end.
