program NoteDirectoryIdentityTest;

uses Notes.Model as Model;
uses Notes.Repository as Repository;
uses Notes.Update as Update;
uses Std.Arrays as Arrays;
uses Std.Fs as Fs;
uses Std.Path as Path;
uses Std.Results as Results;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

procedure CheckDirectory(Name: string; Sibling: string);
begin
  var Root: string := Test.ScratchDir();
  var Directory: string := Path.Join([Root, Name]);
  var Adjacent: string := Path.Join([Root, Sibling]);
  Test.AssertTrue(Results.Unwrap(Repository.NotesEnsureDirectory(Directory)));
  mutable var Outside: Model.Note := Model.NoteCreate('outside', 1);
  Outside.Title := 'untouched';
  Test.AssertTrue(Results.Unwrap(Repository.NotesSave(Adjacent, Outside)));
  var Before: string := Results.Unwrap(Fs.ReadText(Repository.NoteFilePath(Adjacent, Outside)));
  Test.AssertEquals(0, Arrays.Length(Results.Unwrap(Repository.NotesLoadDirectory(Directory)).Notes));
  mutable var Inside: Model.Note := Model.NoteCreate('inside', 2);
  Test.AssertTrue(Results.Unwrap(Repository.NotesSave(Directory, Inside)));
  var Loaded: Model.NotesLoad := Results.Unwrap(Repository.NotesLoadDirectory(Directory));
  Test.AssertEquals(1, Arrays.Length(Loaded.Notes));
  Test.AssertEquals(Str.Replace(Repository.NoteFilePath(Directory, Inside), '\', '/'), Str.Replace(Loaded.Notes[0].Path, '\', '/'));
  Inside := Loaded.Notes[0];
  Inside.Title := 'edited';
  Test.AssertTrue(Results.Unwrap(Repository.NotesSave(Directory, Inside)));
  Test.AssertEquals(Before, Results.Unwrap(Fs.ReadText(Repository.NoteFilePath(Adjacent, Outside))));
end procedure;

begin
  CheckDirectory('set[1]', 'set1');
  CheckDirectory('space [open', 'space open');
  var Directory: string := Test.ScratchDir() + '/duplicates';
  mutable var First: Model.Note := Model.NoteCreate('duplicate', 1);
  First.Path := Directory + '/first.note';
  First.Title := 'first';
  mutable var Second: Model.Note := First;
  Second.Path := Directory + '/second.note';
  Second.Title := 'second';
  var Unique: Model.Note := Model.NoteCreate('unique', 3);
  Test.AssertTrue(Results.Unwrap(Repository.NotesSave(Directory, First)));
  Test.AssertTrue(Results.Unwrap(Repository.NotesSave(Directory, Second)));
  Test.AssertTrue(Results.Unwrap(Repository.NotesSave(Directory, Unique)));
  var FirstText: string := Results.Unwrap(Fs.ReadText(First.Path));
  var SecondText: string := Results.Unwrap(Fs.ReadText(Second.Path));
  var Loaded: Model.NotesLoad := Results.Unwrap(Repository.NotesLoadDirectory(Directory));
  Test.AssertEquals(1, Arrays.Length(Loaded.Notes));
  Test.AssertEquals(2, Arrays.Length(Loaded.Issues));
  Test.AssertEquals('unique', Loaded.Notes[0].Id);
  Test.AssertTrue((Loaded.Issues[0].Path = First.Path) or (Loaded.Issues[1].Path = First.Path));
  Test.AssertTrue((Loaded.Issues[0].Path = Second.Path) or (Loaded.Issues[1].Path = Second.Path));
  mutable var State: Model.NotesModel := Model.NotesModelCreate(Directory, Loaded);
  var Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  State := Update.NotesUpdate(State, Tui.TuiMsgSelectionChanged(Tui.TuiControlId.Create(2), Tui.TuiAction.Create(2), 0), Cmd);
  State.Dirty := true;
  State := Update.NotesPersistCurrent(State);
  Test.AssertFalse(State.Dirty);
  State := Update.NotesUpdate(State, Tui.TuiMsgAction(Tui.TuiControlId.Create(23), Tui.TuiAction.Create(13)), Cmd);
  Test.AssertEquals(-1, State.Selected);
  Test.AssertEquals(FirstText, Results.Unwrap(Fs.ReadText(First.Path)));
  Test.AssertEquals(SecondText, Results.Unwrap(Fs.ReadText(Second.Path)));
end program;
