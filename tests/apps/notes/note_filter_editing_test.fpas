program NoteFilterEditingTest;

uses
  Notes.Actions as Actions, Notes.Model as Model, Notes.Update as Update, Notes.View as View,
  Std.Test as Test, Std.Ui.Terminal as Tui;

function MakeNote(Id: string): Model.Note;
begin
  var Value := Model.NoteCreate(Id, 1);
  Value.Title := 'FPAS ' + Id;
  Value.Tags := ['syntax'];
  Value.Body := 'reference';
  return Value;
end function;

function Step(State: Model.NotesModel; Msg: Tui.TuiMsg): Model.NotesModel;
begin
  const App := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(100, 30));
  App.Inject(Msg);
  const Next := App.RunIterations(State, Update.NotesUpdate, View.NotesView, 1, 0);
  App.Close();
  return Next;
end function;

function Filter(State: Model.NotesModel; Text: string): Model.NotesModel;
begin
  return Step(
    State, Tui.TuiMsgTextChanged(
      Tui.TuiControlId.Create(Actions.SearchControl),
      Tui.TuiAction.Create(Actions.SearchChangedAction),
      Text,
      Text.Length()
    )
  );
end function;

begin
  const Loaded := Model.NotesLoad(Notes := [MakeNote('first'), MakeNote('second')], Issues := []);
  const Initial := Model.NotesModelCreate(Test.ScratchDir(), Loaded);
  // Editing a field out of the filter must preserve the note and unsaved edit.
  var State := Filter(Initial, 'FPAS');
  State := Step(
    State, Tui.TuiMsgTextChanged(
      Tui.TuiControlId.Create(Actions.TitleControl),
      Tui.TuiAction.Create(Actions.TitleChangedAction),
      'Renamed',
      3
    )
  );
  Test.AssertEquals('first', State.Notes[State.Selected].Id);
  Test.AssertEquals('Renamed', State.Notes[State.Selected].Title);
  Test.AssertEquals('', State.Search);
  Test.AssertEquals(0, State.SearchCaret);
  Test.AssertEquals(3, State.TitleCaret);
  Test.AssertTrue(State.Dirty);

  State := Filter(Initial, 'syntax');
  State := Step(
    State, Tui.TuiMsgTextChanged(
      Tui.TuiControlId.Create(Actions.TagsControl),
      Tui.TuiAction.Create(Actions.TagsChangedAction),
      'other',
      2
    )
  );
  Test.AssertEquals('', State.Search);
  Test.AssertEquals('first', State.Notes[State.Selected].Id);
  Test.AssertEquals('other', State.Notes[State.Selected].Tags[0]);
  Test.AssertEquals(2, State.TagsCaret);
  Test.AssertTrue(State.Dirty);

  State := Filter(Initial, 'reference');
  State := Step(
    State, Tui.TuiMsgTextAreaChanged(
      Tui.TuiControlId.Create(Actions.BodyControl),
      Tui.TuiAction.Create(Actions.BodyChangedAction),
      'changed',
      1,
      Tui.TuiPoint.Create(0, 0)
    )
  );
  Test.AssertEquals('', State.Search);
  Test.AssertEquals('first', State.Notes[State.Selected].Id);
  Test.AssertEquals('changed', State.Notes[State.Selected].Body);
  Test.AssertEquals(1, State.BodyCaret);
  Test.AssertTrue(State.Dirty);

  // A new note must also remain visible under a previously active search.
  State := Filter(Initial, 'FPAS');
  State := Step(
    State, Tui.TuiMsgAction(
      Tui.TuiControlId.Create(Actions.NewNoteControl),
      Tui.TuiAction.Create(Actions.NewNoteAction)
    )
  );
  Test.AssertEquals('', State.Search);
  Test.AssertEquals('Untitled note', State.Notes[State.Selected].Title);
  Test.AssertEquals(0, Update.NotesSelectedFilteredPosition(State));
  Test.AssertEquals(Actions.TitleControl, State.Focus);
  Test.AssertFalse(State.Dirty);
end.
