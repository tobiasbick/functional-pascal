program NoteFormatInvalidHeaderTest;

uses Notes.Format as Format;
uses Std.Results as Results;
uses Std.Test as Test;

begin
  Test.AssertTrue(Results.IsError(Format.NoteParse('plain text')));
  Test.AssertTrue(Results.IsError(Format.NoteParse(('+++' + #10) + 'format = 1')));
  Test.AssertTrue(Results.IsError(Format.NoteParse((((((('+++' + #10) + 'format = 2') + #10) + 'id = ''wrong-version''') + #10) + '+++') +
                                                   #10)));
end program;
