program NoteModelFilterSortTest;

uses Notes.Model, Notes.Repository, Std.Array, Std.Console, Std.Str, Std.Test;

begin
  var Tags: array of string := NoteTagsFromText(' FPAS, tui, FPAS, ');
  AssertEquals(2, Std.Array.Length(Tags));
  AssertEquals('FPAS', Tags[0]);
  AssertEquals('tui', Tags[1]);
  mutable var Older: Note := NoteCreate('older', 10);
  Older.Title := 'Compiler design';
  Older.Body := 'Functional notes';
  Older.Tags := ['pascal'];
  mutable var Newer: Note := NoteCreate('newer', 20);
  Newer.Title := 'Terminal UI';
  Newer.Tags := ['tui'];
  AssertTrue(NoteMatches(Older, 'COMPILER'));
  AssertTrue(NoteMatches(Older, 'functional'));
  AssertTrue(NoteMatches(Older, 'PASCAL'));
  AssertFalse(NoteMatches(Older, 'missing'));
  Older.Archived := true;
  AssertFalse(NoteMatches(Older, 'compiler'));
  Older.Archived := false;
  Older.Pinned := true;
  var Sorted: array of Note := NotesSort([Newer, Older]);
  AssertEquals('older', Sorted[0].Id);
  AssertEquals('newer', Sorted[1].Id);
  Newer.Title := 'Terminal 👩‍💻 interface with a long title';
  var Items: array of string := NotesListItems([Newer], '', 14);
  AssertEquals(1, Std.Array.Length(Items));
  AssertEquals(14, Std.Console.DisplayWidth(Items[0]));
  AssertTrue(Std.Str.Contains(Items[0], '👩‍💻'));
  AssertTrue(Std.Str.EndsWith(Items[0], '…'));
  AssertEquals('', NotesListItems([Newer], '', 0)[0])
end.
