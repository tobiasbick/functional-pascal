program NoteNavigationDirtyTest;

uses Notes.Model, Notes.Update, Std.Test, Std.Tui;

begin
  mutable var NoteValue: Note := NoteCreate('navigation', 123);
  NoteValue.Title := 'Title';
  NoteValue.Body := 'Body';
  NoteValue.Tags := ['one'];
  var Loaded: NotesLoad := record
    Notes := [NoteValue];
    Issues := [];
  end;
  mutable var State: NotesModel := NotesModelCreate(ScratchDir(), Loaded);
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  for Caret: integer := 0 to 4 do
  begin
    State := NotesUpdate(State, TuiMsgTextChanged(TuiControlId.Create(3), TuiAction.Create(3), 'Title', Caret), Cmd);
    AssertFalse(State.Dirty);
    AssertEquals(Caret, State.TitleCaret);
    State := NotesUpdate(State, TuiMsgTextAreaChanged(TuiControlId.Create(5), TuiAction.Create(5), 'Body', Caret, TuiPoint.Create(0, 1)), Cmd);
    AssertFalse(State.Dirty);
    AssertEquals(Caret, State.BodyCaret);
    AssertEquals(1, State.BodyOffset.Y)
  end;

  State := NotesUpdate(State, TuiMsgTextChanged(TuiControlId.Create(4), TuiAction.Create(4), 'one', 0), Cmd);
  AssertFalse(State.Dirty);
  State := NotesPersistCurrent(State);
  AssertEquals(123, State.Notes[0].UpdatedMillis);
  State := NotesUpdate(State, TuiMsgTextChanged(TuiControlId.Create(3), TuiAction.Create(3), 'Edited', 6), Cmd);
  AssertTrue(State.Dirty);
  State := NotesUpdate(State, TuiMsgTextAreaChanged(TuiControlId.Create(5), TuiAction.Create(5), 'Body', 0, TuiPoint.Create(0, 0)), Cmd);
  AssertTrue(State.Dirty)
end.
