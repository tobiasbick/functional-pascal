program NoteRepositoryRoundtripTest;

uses Notes.Model as Model;
uses Notes.Repository as Repository;
uses Std.Arrays as Arrays;
uses Std.Test as Test;

begin
  const Directory: string := Test.ScratchDir() + '/notes';
  var NoteValue: Model.Note := Model.NoteCreate('repository-roundtrip', 1700000000000);
  NoteValue.Title := 'Repository roundtrip';
  NoteValue.Tags := ['storage'];
  NoteValue.Body := 'Saved atomically';
  case Repository.NotesSave(Directory, NoteValue) of
    when Result.Ok(const Written):
      begin
        null;
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Repository.NotesLoadDirectory(Directory) of
    when Result.Ok(const Loaded):
      begin
        Test.AssertEquals(1, Arrays.Length(Loaded.Notes));
        Test.AssertEquals(0, Arrays.Length(Loaded.Issues));
        Test.AssertEquals(NoteValue.Id, Loaded.Notes[0].Id);
        Test.AssertEquals(NoteValue.Title, Loaded.Notes[0].Title);
        Test.AssertEquals(NoteValue.Body, Loaded.Notes[0].Body);
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
