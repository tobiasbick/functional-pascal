program NoteRepositoryRoundtripTest;

uses Notes.Model, Notes.Repository, Std.Arrays, Std.Test;

begin
  const Directory: string := ScratchDir() + '/notes';
  var NoteValue: Note := NoteCreate('repository-roundtrip', 1700000000000);
  NoteValue.Title := 'Repository roundtrip';
  NoteValue.Tags := ['storage'];
  NoteValue.Body := 'Saved atomically';
  case NotesSave(Directory, NoteValue) of
    when Ok(Written):
      begin
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case NotesLoadDirectory(Directory) of
    when Ok(Loaded):
      begin
        AssertEquals(1, Std.Arrays.Length(Loaded.Notes));
        AssertEquals(0, Std.Arrays.Length(Loaded.Issues));
        AssertEquals(NoteValue.Id, Loaded.Notes[0].Id);
        AssertEquals(NoteValue.Title, Loaded.Notes[0].Title);
        AssertEquals(NoteValue.Body, Loaded.Notes[0].Body);
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end.
