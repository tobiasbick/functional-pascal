program NoteSelectionAfterSaveTest;

uses Notes.Model as Model2;
uses Notes.Update as Update;
uses Std.Test as Test;
uses Std.Tui as Tui;

begin
  var Target: Model2.Note := Model2.NoteCreate('target', 2);
  var Edited: Model2.Note := Model2.NoteCreate('edited', 1);
  var Loaded: Model2.NotesLoad := record
    Notes := [Target, Edited];
    Issues := [];
  end record;
  mutable var Model: Model2.NotesModel := Model2.NotesModelCreate(Test.ScratchDir() + '/notes', Loaded);
  Model.Selected := 1;
  Model.Dirty := true;
  var Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Model := Update.NotesUpdate(Model, Tui.TuiMsgSelectionChanged(Tui.TuiControlId.Create(2), Tui.TuiAction.Create(2), 0), Cmd);
  Test.AssertEquals('target', Model.Notes[Model.Selected].Id);
end program;
