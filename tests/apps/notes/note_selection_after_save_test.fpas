program NoteSelectionAfterSaveTest;

uses Notes.Model as NotesModel, Notes.Update as Update, Std.Test as Test, Std.Tui as Tui;

begin
  const Target: NotesModel.Note := NotesModel.NoteCreate('target', 2);
  const Edited: NotesModel.Note := NotesModel.NoteCreate('edited', 1);
  const Loaded: NotesModel.NotesLoad := NotesModel.NotesLoad(Notes := [Target, Edited], Issues := []);
  var Model: NotesModel.NotesModel := NotesModel.NotesModelCreate(Test.ScratchDir() + '/notes', Loaded);
  Model.Selected := 1;
  Model.Dirty := true;
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Model := Update.NotesUpdate(Model, Tui.TuiMsgSelectionChanged(Tui.TuiControlId.Create(2), Tui.TuiAction.Create(2), 0), Cmd);
  Test.AssertEquals('target', Model.Notes[Model.Selected].Id);
end.
