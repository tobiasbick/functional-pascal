program NoteSelectionAfterSaveTest;

uses Notes.Model, Notes.Update, Std.Test, Std.Tui;

begin
  const Target: Note := NoteCreate('target', 2);
  const Edited: Note := NoteCreate('edited', 1);
  const Loaded: NotesLoad := record
    Notes := [Target, Edited];
    Issues := [];
  end;
  var Model: NotesModel := NotesModelCreate(ScratchDir() + '/notes', Loaded);
  Model.Selected := 1;
  Model.Dirty := true;
  const Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  Model := NotesUpdate(Model, TuiMsgSelectionChanged(TuiControlId.Create(2), TuiAction.Create(2), 0), Cmd);
  AssertEquals('target', Model.Notes[Model.Selected].Id);
end.
