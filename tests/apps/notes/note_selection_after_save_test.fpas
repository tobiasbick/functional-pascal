program NoteSelectionAfterSaveTest;

uses Notes.Model as Model2;
uses Notes.Update as Update;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

begin
  const Target: Model2.Note := Model2.NoteCreate('target', 2);
  const Edited: Model2.Note := Model2.NoteCreate('edited', 1);
  const Loaded: Model2.NotesLoad := Model2.NotesLoad(Notes := [Target, Edited], Issues := []);
  var Model: Model2.NotesModel := Model2.NotesModelCreate(Test.ScratchDir() + '/notes', Loaded);
  Model.Selected := 1;
  Model.Dirty := true;
  const Cmd: Tui.TuiCmdOutput := Runtime.TuiCmdOutputCreate();
  Model := Update.NotesUpdate(Model, Tui.TuiMsgSelectionChanged(Ids.TuiControlIdCreate(2), Ids.TuiActionCreate(2), 0), Cmd);
  Test.AssertEquals('target', Model.Notes[Model.Selected].Id);
end program;
