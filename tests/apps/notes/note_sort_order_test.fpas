program NoteSortOrderTest;

uses Notes.Model, Notes.Repository, Std.Test;

begin
  var Pinned: Note := NoteCreate('pinned', 1);
  Pinned.Pinned := true;
  const First: Note := NoteCreate('first', 10);
  const Second: Note := NoteCreate('second', 10);
  const Newest: Note := NoteCreate('newest', 20);
  const Sorted: array of Note := NotesSort([First, Newest, Pinned, Second]);
  AssertEquals('pinned', Sorted[0].Id);
  AssertEquals('newest', Sorted[1].Id);
  AssertEquals('first', Sorted[2].Id);
  AssertEquals('second', Sorted[3].Id);
end.
