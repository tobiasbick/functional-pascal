program NoteTuiWorkflowTest;

uses Notes.Model, Notes.Update, Notes.View, Std.Array, Std.Fs, Std.Str, Std.Test, Std.Tui;

const
  Root: string := '.temp-data';
  Directory: string := Root + '/notes-tui-test';

procedure EnsureRoot();
begin
  if not Std.Fs.Exists(Root) then
  begin
    case Std.Fs.CreateDir(Root) of
      Ok(Created):
      begin
      end;
      Error(Message):
      begin
        Fail(Message)
      end
    end
  end
end;

function ScreenContains(Snapshot: TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
  begin
    if Std.Str.Contains(Snapshot.LineAt(Row), Text) then
    begin
      return true
    end
  end;
  return false
end;

function MakeKey(Kind: TuiKeyKind): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function MakeCtrlKey(Character: string): TuiKeyEvent;
begin
  return record
    kind := TuiKeyKind.Character;
    ch := Character;
    shift := false;
    ctrl := true;
    alt := false;
    meta := false;
  end
end;

function MakeAltKey(Character: string): TuiKeyEvent;
begin
  return record
    kind := TuiKeyKind.Character;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := true;
    meta := false;
  end
end;

begin
  EnsureRoot();
  var EmptyLoaded: NotesLoad := record Notes := []; Issues := []; end;
  mutable var EmptyModel: NotesModel := NotesModelCreate(Directory, EmptyLoaded);
  var EmptyApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(100, 24));
  EmptyModel := EmptyApp.RunIterations(EmptyModel, NotesUpdate, NotesView, 0, 0);
  var EmptySnapshot: TuiSurfaceSnapshot := EmptyApp.SurfaceSnapshot();
  AssertEquals('╰', EmptySnapshot.CellAt(0, 22).Glyph);
  AssertEquals('╯', EmptySnapshot.CellAt(32, 22).Glyph);
  AssertEquals('╰', EmptySnapshot.CellAt(33, 22).Glyph);
  AssertEquals('╯', EmptySnapshot.CellAt(99, 22).Glyph);
  AssertTrue(Std.Str.Contains(EmptySnapshot.LineAt(22), '╯╰'));
  EmptyApp.Inject(TuiMsgAction(TuiControlId.Create(20), TuiAction.Create(14)));
  EmptyModel := EmptyApp.RunIterations(EmptyModel, NotesUpdate, NotesView, 1, 0);
  AssertTrue(EmptyModel.Overlay = NotesOverlay.Commands);
  EmptyApp.InjectKeyForTest(MakeKey(TuiKeyKind.Down));
  EmptyModel := EmptyApp.RunIterations(EmptyModel, NotesUpdate, NotesView, 1, 0);
  AssertEquals(24, EmptyModel.Focus);
  EmptyApp.InjectKeyForTest(MakeKey(TuiKeyKind.Enter));
  EmptyModel := EmptyApp.RunIterations(EmptyModel, NotesUpdate, NotesView, 1, 0);
  AssertTrue(EmptyModel.Overlay = NotesOverlay.Help);
  EmptyApp.Close();
  var First: Note := NoteCreate('focus-first', 1);
  var Second: Note := NoteCreate('focus-second', 2);
  var FocusLoaded: NotesLoad := record Notes := [First, Second]; Issues := []; end;
  mutable var FocusModel: NotesModel := NotesModelCreate(Directory, FocusLoaded);
  var FocusApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(100, 24));
  FocusModel := FocusApp.RunIterations(FocusModel, NotesUpdate, NotesView, 0, 0);
  FocusApp.InjectKeyForTest(MakeCtrlKey('1'));
  FocusModel := FocusApp.RunIterations(FocusModel, NotesUpdate, NotesView, 1, 0);
  AssertEquals(1, FocusModel.Focus);
  AssertTrue(FocusModel.Pane = NotesPane.List);
  FocusApp.InjectKeyForTest(MakeKey(TuiKeyKind.Tab));
  FocusModel := FocusApp.RunIterations(FocusModel, NotesUpdate, NotesView, 1, 0);
  AssertEquals(2, FocusModel.Focus);
  FocusApp.InjectKeyForTest(MakeKey(TuiKeyKind.Down));
  FocusModel := FocusApp.RunIterations(FocusModel, NotesUpdate, NotesView, 1, 0);
  AssertEquals(1, FocusModel.Selected);
  AssertEquals(2, FocusModel.Focus);
  AssertTrue(FocusModel.Pane = NotesPane.List);
  FocusApp.InjectKeyForTest(MakeKey(TuiKeyKind.Enter));
  FocusModel := FocusApp.RunIterations(FocusModel, NotesUpdate, NotesView, 1, 0);
  AssertEquals(1, FocusModel.Selected);
  AssertEquals(5, FocusModel.Focus);
  AssertTrue(FocusModel.Pane = NotesPane.Editor);
  FocusApp.Close();
  var QuitCmd: TuiCmdOutput := TuiCmdOutput.Create();
  var CleanEscape: NotesModel := NotesUpdate(FocusModel, TuiMsg.QuitRequested, QuitCmd);
  AssertTrue(QuitCmd.Read() = TuiCmd.NoCommand);
  AssertTrue(CleanEscape.Overlay = NotesOverlay.Closed);
  AssertEquals(FocusModel.Focus, CleanEscape.Focus);
  mutable var DirtyEscapeModel: NotesModel := FocusModel;
  DirtyEscapeModel.Dirty := true;
  var DirtyEscape: NotesModel := NotesUpdate(DirtyEscapeModel, TuiMsg.QuitRequested, QuitCmd);
  AssertTrue(QuitCmd.Read() = TuiCmd.NoCommand);
  AssertTrue(DirtyEscape.Dirty);
  AssertTrue(DirtyEscape.Overlay = NotesOverlay.Closed);
  var CleanQuit: NotesModel := NotesUpdate(FocusModel, TuiMsg.Key(MakeAltKey('x')), QuitCmd);
  AssertTrue(QuitCmd.Read() = TuiCmd.Quit);
  AssertTrue(CleanQuit.Overlay = NotesOverlay.Closed);
  mutable var DirtyModel: NotesModel := FocusModel;
  DirtyModel.Dirty := true;
  DirtyModel.Overlay := NotesOverlay.Help;
  var DirtyQuit: NotesModel := NotesUpdate(DirtyModel, TuiMsg.Key(MakeAltKey('X')), QuitCmd);
  AssertTrue(QuitCmd.Read() = TuiCmd.NoCommand);
  AssertTrue(DirtyQuit.Overlay = NotesOverlay.QuitConfirmation);
  mutable var NoteValue: Note := NoteCreate('tui-workflow', 1700000000000);
  NoteValue.Title := 'A very long note title that must never resize the notes sidebar';
  var Issue: NoteIssue := record Path := 'broken.note'; Message := 'invalid header'; end;
  var Loaded: NotesLoad := record Notes := [NoteValue]; Issues := [Issue]; end;
  mutable var Model: NotesModel := NotesModelCreate(Directory, Loaded);
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(100, 24));
  Model := App.RunIterations(Model, NotesUpdate, NotesView, 0, 0);
  var InitialSnapshot: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertTrue(ScreenContains(InitialSnapshot, 'NOTES'));
  AssertTrue(ScreenContains(InitialSnapshot, '1 invalid'));
  AssertEquals('╯', InitialSnapshot.CellAt(32, 22).Glyph);
  AssertEquals('╰', InitialSnapshot.CellAt(33, 22).Glyph);
  AssertTrue(ScreenContains(InitialSnapshot, '…'));
  App.Inject(TuiMsgTextChanged(TuiControlId.Create(3), TuiAction.Create(3), 'Modern terminal notes', 21));
  App.Inject(TuiMsgTextAreaChanged(TuiControlId.Create(5), TuiAction.Create(5), 'Written through MVU', 19, TuiPoint.Create(0, 0)));
  Model := App.RunIterations(Model, NotesUpdate, NotesView, 2, 0);
  AssertTrue(Model.Dirty);
  App.Inject(TuiMsgAction(TuiControlId.Create(21), TuiAction.Create(11)));
  Model := App.RunIterations(Model, NotesUpdate, NotesView, 1, 0);
  AssertFalse(Model.Dirty);
  AssertTrue(Std.Fs.Exists(Directory + '/tui-workflow.note'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'NOTES'));
  App.Inject(TuiMsgAction(TuiControlId.Create(22), TuiAction.Create(12)));
  Model := App.RunIterations(Model, NotesUpdate, NotesView, 1, 0);
  AssertTrue(Model.Notes[0].Pinned);
  AssertFalse(Model.Dirty);
  App.Inject(TuiMsgAction(TuiControlId.Create(20), TuiAction.Create(14)));
  Model := App.RunIterations(Model, NotesUpdate, NotesView, 1, 0);
  AssertTrue(Model.Overlay = NotesOverlay.Commands);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Quick actions'));
  App.Inject(TuiMsg.QuitRequested);
  Model := App.RunIterations(Model, NotesUpdate, NotesView, 1, 0);
  AssertTrue(Model.Overlay = NotesOverlay.Closed);
  App.InjectResizeForTest(TuiSize.Create(60, 20));
  Model := App.RunIterations(Model, NotesUpdate, NotesView, 1, 0);
  AssertEquals(60, Model.Width);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Editor'));
  App.Inject(TuiMsgAction(TuiControlId.Create(23), TuiAction.Create(13)));
  Model := App.RunIterations(Model, NotesUpdate, NotesView, 1, 0);
  AssertTrue(Model.Notes[0].Archived);
  AssertEquals(-1, Model.Selected);
  App.Close()
end.
