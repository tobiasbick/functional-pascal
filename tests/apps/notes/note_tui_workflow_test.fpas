program NoteTuiWorkflowTest;

uses
  Notes.Model as NotesModel, Notes.Update as Update, Notes.View as View, Std.Fs as Fs,
  Std.Test as Test, Std.Tui as Tui;

function ScreenContains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if (Text in Snapshot.LineAt(Row)) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function MakeKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function MakeCtrlKey(Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Tui.TuiKeyKind.Character, ch := Character, shift := false, ctrl := true, alt := false, meta := false);
end function;

function MakeAltKey(Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Tui.TuiKeyKind.Character, ch := Character, shift := false, ctrl := false, alt := true, meta := false);
end function;

begin
  const Directory: string := Test.ScratchDir() + '/notes';
  const EmptyLoaded: NotesModel.NotesLoad := NotesModel.NotesLoad(Notes := [], Issues := []);
  var EmptyModel: NotesModel.NotesModel := NotesModel.NotesModelCreate(Directory, EmptyLoaded);
  const EmptyApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(100, 24));
  EmptyModel := EmptyApp.RunIterations(EmptyModel, Update.NotesUpdate, View.NotesView, 0, 0);
  const EmptySnapshot: Tui.TuiSurfaceSnapshot := EmptyApp.SurfaceSnapshot();
  Test.AssertEquals('╰', EmptySnapshot.CellAt(0, 22).Glyph);
  Test.AssertEquals('╯', EmptySnapshot.CellAt(32, 22).Glyph);
  Test.AssertEquals('╰', EmptySnapshot.CellAt(33, 22).Glyph);
  Test.AssertEquals('╯', EmptySnapshot.CellAt(99, 22).Glyph);
  Test.AssertTrue(('╯╰' in EmptySnapshot.LineAt(22)));
  EmptyApp.Inject(Tui.TuiMsgAction(Tui.TuiControlId.Create(20), Tui.TuiAction.Create(14)));
  EmptyModel := EmptyApp.RunIterations(EmptyModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(EmptyModel.Overlay = NotesModel.NotesOverlay.Commands);
  EmptyApp.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down));
  EmptyModel := EmptyApp.RunIterations(EmptyModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(24, EmptyModel.Focus);
  EmptyApp.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter));
  EmptyModel := EmptyApp.RunIterations(EmptyModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(EmptyModel.Overlay = NotesModel.NotesOverlay.Help);
  EmptyApp.Close();
  const First: NotesModel.Note := NotesModel.NoteCreate('focus-first', 1);
  const Second: NotesModel.Note := NotesModel.NoteCreate('focus-second', 2);
  const FocusLoaded: NotesModel.NotesLoad := NotesModel.NotesLoad(Notes := [First, Second], Issues := []);
  var FocusModel: NotesModel.NotesModel := NotesModel.NotesModelCreate(Directory, FocusLoaded);
  const FocusApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(100, 24));
  FocusModel := FocusApp.RunIterations(FocusModel, Update.NotesUpdate, View.NotesView, 0, 0);
  FocusApp.InjectKeyForTest(MakeCtrlKey('1'));
  FocusModel := FocusApp.RunIterations(FocusModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(1, FocusModel.Focus);
  Test.AssertTrue(FocusModel.Pane = NotesModel.NotesPane.List);
  FocusApp.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Tab));
  FocusModel := FocusApp.RunIterations(FocusModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(2, FocusModel.Focus);
  FocusApp.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down));
  FocusModel := FocusApp.RunIterations(FocusModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(1, FocusModel.Selected);
  Test.AssertEquals(2, FocusModel.Focus);
  Test.AssertTrue(FocusModel.Pane = NotesModel.NotesPane.List);
  FocusApp.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter));
  FocusModel := FocusApp.RunIterations(FocusModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(1, FocusModel.Selected);
  Test.AssertEquals(5, FocusModel.Focus);
  Test.AssertTrue(FocusModel.Pane = NotesModel.NotesPane.Editor);
  FocusApp.Close();
  const QuitCmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  const CleanEscape: NotesModel.NotesModel := Update.NotesUpdate(FocusModel, Tui.TuiMsg.QuitRequested, QuitCmd);
  Test.AssertTrue(QuitCmd.Command() = Tui.TuiCmd.NoCommand);
  Test.AssertTrue(CleanEscape.Overlay = NotesModel.NotesOverlay.Closed);
  Test.AssertEquals(FocusModel.Focus, CleanEscape.Focus);
  var DirtyEscapeModel: NotesModel.NotesModel := FocusModel;
  DirtyEscapeModel.Dirty := true;
  const DirtyEscape: NotesModel.NotesModel := Update.NotesUpdate(DirtyEscapeModel, Tui.TuiMsg.QuitRequested, QuitCmd);
  Test.AssertTrue(QuitCmd.Command() = Tui.TuiCmd.NoCommand);
  Test.AssertTrue(DirtyEscape.Dirty);
  Test.AssertTrue(DirtyEscape.Overlay = NotesModel.NotesOverlay.Closed);
  const CleanQuit: NotesModel.NotesModel := Update.NotesUpdate(FocusModel, Tui.TuiMsg.Key(MakeAltKey('x')), QuitCmd);
  Test.AssertTrue(QuitCmd.Command() = Tui.TuiCmd.Quit);
  Test.AssertTrue(CleanQuit.Overlay = NotesModel.NotesOverlay.Closed);
  var DirtyModel: NotesModel.NotesModel := FocusModel;
  DirtyModel.Dirty := true;
  DirtyModel.Overlay := NotesModel.NotesOverlay.Help;
  const DirtyQuit: NotesModel.NotesModel := Update.NotesUpdate(DirtyModel, Tui.TuiMsg.Key(MakeAltKey('X')), QuitCmd);
  Test.AssertTrue(QuitCmd.Command() = Tui.TuiCmd.NoCommand);
  Test.AssertTrue(DirtyQuit.Overlay = NotesModel.NotesOverlay.QuitConfirmation);
  var NoteValue: NotesModel.Note := NotesModel.NoteCreate('tui-workflow', 1700000000000);
  NoteValue.Title := 'A very long note title that must never resize the notes sidebar';
  NoteValue.Body := 'first off-screen line' + string.Chr(10) + 'second off-screen line' + string.Chr(10) +
                    (string.Chr(65279) + 'visible body text');
  const Issue: NotesModel.NoteIssue := NotesModel.NoteIssue(Path := 'broken.note', Message := 'invalid header');
  const Loaded: NotesModel.NotesLoad := NotesModel.NotesLoad(Notes := [NoteValue], Issues := [Issue]);
  var Model: NotesModel.NotesModel := NotesModel.NotesModelCreate(Directory, Loaded);
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(100, 24));
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, 0, 0);
  const InitialSnapshot: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertTrue(ScreenContains(InitialSnapshot, 'NOTES'));
  Test.AssertTrue(ScreenContains(InitialSnapshot, '1 invalid'));
  Test.AssertEquals('╯', InitialSnapshot.CellAt(32, 22).Glyph);
  Test.AssertEquals('╰', InitialSnapshot.CellAt(33, 22).Glyph);
  Test.AssertTrue(ScreenContains(InitialSnapshot, '…'));
  Test.AssertTrue((string.Chr(65279) + 'visible body text' in Model.Notes[0].Body));
  Model.BodyOffset := Tui.TuiPoint.Create(0, 2);
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'visible body text'));
  App.Inject(Tui.TuiMsgTextChanged(Tui.TuiControlId.Create(3), Tui.TuiAction.Create(3), 'Modern terminal notes', 21));
  App.Inject(Tui.TuiMsgTextAreaChanged(Tui.TuiControlId.Create(5), Tui.TuiAction.Create(5), 'Written through MVU', 19, Tui.TuiPoint.Create(0, 0)));
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, 2, 0);
  Test.AssertTrue(Model.Dirty);
  App.Inject(Tui.TuiMsgAction(Tui.TuiControlId.Create(21), Tui.TuiAction.Create(11)));
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertFalse(Model.Dirty);
  Test.AssertTrue(Fs.Exists(Directory + '/tui-workflow.note'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'NOTES'));
  App.Inject(Tui.TuiMsgAction(Tui.TuiControlId.Create(22), Tui.TuiAction.Create(12)));
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(Model.Notes[0].Pinned);
  Test.AssertFalse(Model.Dirty);
  App.Inject(Tui.TuiMsgAction(Tui.TuiControlId.Create(20), Tui.TuiAction.Create(14)));
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(Model.Overlay = NotesModel.NotesOverlay.Commands);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Quick actions'));
  App.Inject(Tui.TuiMsg.QuitRequested);
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(Model.Overlay = NotesModel.NotesOverlay.Closed);
  App.InjectResizeForTest(Tui.TuiSize.Create(60, 20));
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(60, Model.Width);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Editor'));
  App.Inject(Tui.TuiMsgAction(Tui.TuiControlId.Create(23), Tui.TuiAction.Create(13)));
  Model := App.RunIterations(Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(Model.Notes[0].Archived);
  Test.AssertEquals(-1, Model.Selected);
  App.Close();
end.
