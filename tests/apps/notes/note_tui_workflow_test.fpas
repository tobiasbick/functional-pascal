program NoteTuiWorkflowTest;

uses Notes.Model as Model2;
uses Notes.Update as Update;
uses Notes.View as View;
uses Std.Arrays as Arrays;
uses Std.Fs as Fs;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

function ScreenContains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Snapshot, Row), Text) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function MakeKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function MakeCtrlKey(Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Tui.TuiKeyKind.Character, ch := Character, shift := false, ctrl := true, alt := false, meta := false);
end function;

function MakeAltKey(Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Tui.TuiKeyKind.Character, ch := Character, shift := false, ctrl := false, alt := true, meta := false);
end function;

begin
  const Directory: string := Test.ScratchDir() + '/notes';
  const EmptyLoaded: Model2.NotesLoad := Model2.NotesLoad(Notes := [], Issues := []);
  var EmptyModel: Model2.NotesModel := Model2.NotesModelCreate(Directory, EmptyLoaded);
  const EmptyApp: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(100, 24));
  EmptyModel := Runtime.TuiApplicationRunIterations(EmptyApp, EmptyModel, Update.NotesUpdate, View.NotesView, 0, 0);
  const EmptySnapshot: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(EmptyApp);
  Test.AssertEquals('╰', Rendering.TuiSurfaceSnapshotCellAt(EmptySnapshot, 0, 22).Glyph);
  Test.AssertEquals('╯', Rendering.TuiSurfaceSnapshotCellAt(EmptySnapshot, 32, 22).Glyph);
  Test.AssertEquals('╰', Rendering.TuiSurfaceSnapshotCellAt(EmptySnapshot, 33, 22).Glyph);
  Test.AssertEquals('╯', Rendering.TuiSurfaceSnapshotCellAt(EmptySnapshot, 99, 22).Glyph);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(EmptySnapshot, 22), '╯╰'));
  Runtime.TuiApplicationInject(EmptyApp, Tui.TuiMsgAction(Ids.TuiControlIdCreate(20), Ids.TuiActionCreate(14)));
  EmptyModel := Runtime.TuiApplicationRunIterations(EmptyApp, EmptyModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(EmptyModel.Overlay = Model2.NotesOverlay.Commands);
  Runtime.TuiApplicationInjectKeyForTest(EmptyApp, MakeKey(Tui.TuiKeyKind.Down));
  EmptyModel := Runtime.TuiApplicationRunIterations(EmptyApp, EmptyModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(24, EmptyModel.Focus);
  Runtime.TuiApplicationInjectKeyForTest(EmptyApp, MakeKey(Tui.TuiKeyKind.Enter));
  EmptyModel := Runtime.TuiApplicationRunIterations(EmptyApp, EmptyModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(EmptyModel.Overlay = Model2.NotesOverlay.Help);
  Runtime.TuiApplicationClose(EmptyApp);
  const First: Model2.Note := Model2.NoteCreate('focus-first', 1);
  const Second: Model2.Note := Model2.NoteCreate('focus-second', 2);
  const FocusLoaded: Model2.NotesLoad := Model2.NotesLoad(Notes := [First, Second], Issues := []);
  var FocusModel: Model2.NotesModel := Model2.NotesModelCreate(Directory, FocusLoaded);
  const FocusApp: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(100, 24));
  FocusModel := Runtime.TuiApplicationRunIterations(FocusApp, FocusModel, Update.NotesUpdate, View.NotesView, 0, 0);
  Runtime.TuiApplicationInjectKeyForTest(FocusApp, MakeCtrlKey('1'));
  FocusModel := Runtime.TuiApplicationRunIterations(FocusApp, FocusModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(1, FocusModel.Focus);
  Test.AssertTrue(FocusModel.Pane = Model2.NotesPane.List);
  Runtime.TuiApplicationInjectKeyForTest(FocusApp, MakeKey(Tui.TuiKeyKind.Tab));
  FocusModel := Runtime.TuiApplicationRunIterations(FocusApp, FocusModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(2, FocusModel.Focus);
  Runtime.TuiApplicationInjectKeyForTest(FocusApp, MakeKey(Tui.TuiKeyKind.Down));
  FocusModel := Runtime.TuiApplicationRunIterations(FocusApp, FocusModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(1, FocusModel.Selected);
  Test.AssertEquals(2, FocusModel.Focus);
  Test.AssertTrue(FocusModel.Pane = Model2.NotesPane.List);
  Runtime.TuiApplicationInjectKeyForTest(FocusApp, MakeKey(Tui.TuiKeyKind.Enter));
  FocusModel := Runtime.TuiApplicationRunIterations(FocusApp, FocusModel, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(1, FocusModel.Selected);
  Test.AssertEquals(5, FocusModel.Focus);
  Test.AssertTrue(FocusModel.Pane = Model2.NotesPane.Editor);
  Runtime.TuiApplicationClose(FocusApp);
  const QuitCmd: Tui.TuiCmdOutput := Runtime.TuiCmdOutputCreate();
  const CleanEscape: Model2.NotesModel := Update.NotesUpdate(FocusModel, Tui.TuiMsg.QuitRequested, QuitCmd);
  Test.AssertTrue(Runtime.TuiCmdOutputCommand(QuitCmd) = Tui.TuiCmd.NoCommand);
  Test.AssertTrue(CleanEscape.Overlay = Model2.NotesOverlay.Closed);
  Test.AssertEquals(FocusModel.Focus, CleanEscape.Focus);
  var DirtyEscapeModel: Model2.NotesModel := FocusModel;
  DirtyEscapeModel.Dirty := true;
  const DirtyEscape: Model2.NotesModel := Update.NotesUpdate(DirtyEscapeModel, Tui.TuiMsg.QuitRequested, QuitCmd);
  Test.AssertTrue(Runtime.TuiCmdOutputCommand(QuitCmd) = Tui.TuiCmd.NoCommand);
  Test.AssertTrue(DirtyEscape.Dirty);
  Test.AssertTrue(DirtyEscape.Overlay = Model2.NotesOverlay.Closed);
  const CleanQuit: Model2.NotesModel := Update.NotesUpdate(FocusModel, Tui.TuiMsg.Key(MakeAltKey('x')), QuitCmd);
  Test.AssertTrue(Runtime.TuiCmdOutputCommand(QuitCmd) = Tui.TuiCmd.Quit);
  Test.AssertTrue(CleanQuit.Overlay = Model2.NotesOverlay.Closed);
  var DirtyModel: Model2.NotesModel := FocusModel;
  DirtyModel.Dirty := true;
  DirtyModel.Overlay := Model2.NotesOverlay.Help;
  const DirtyQuit: Model2.NotesModel := Update.NotesUpdate(DirtyModel, Tui.TuiMsg.Key(MakeAltKey('X')), QuitCmd);
  Test.AssertTrue(Runtime.TuiCmdOutputCommand(QuitCmd) = Tui.TuiCmd.NoCommand);
  Test.AssertTrue(DirtyQuit.Overlay = Model2.NotesOverlay.QuitConfirmation);
  var NoteValue: Model2.Note := Model2.NoteCreate('tui-workflow', 1700000000000);
  NoteValue.Title := 'A very long note title that must never resize the notes sidebar';
  NoteValue.Body := ((('first off-screen line' + Str.Chr(10)) + 'second off-screen line') + Str.Chr(10)) +
                    (Str.Chr(65279) + 'visible body text');
  const Issue: Model2.NoteIssue := Model2.NoteIssue(Path := 'broken.note', Message := 'invalid header');
  const Loaded: Model2.NotesLoad := Model2.NotesLoad(Notes := [NoteValue], Issues := [Issue]);
  var Model: Model2.NotesModel := Model2.NotesModelCreate(Directory, Loaded);
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(100, 24));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.NotesUpdate, View.NotesView, 0, 0);
  const InitialSnapshot: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertTrue(ScreenContains(InitialSnapshot, 'NOTES'));
  Test.AssertTrue(ScreenContains(InitialSnapshot, '1 invalid'));
  Test.AssertEquals('╯', Rendering.TuiSurfaceSnapshotCellAt(InitialSnapshot, 32, 22).Glyph);
  Test.AssertEquals('╰', Rendering.TuiSurfaceSnapshotCellAt(InitialSnapshot, 33, 22).Glyph);
  Test.AssertTrue(ScreenContains(InitialSnapshot, '…'));
  Test.AssertTrue(Str.Contains(Model.Notes[0].Body, Str.Chr(65279) + 'visible body text'));
  Model.BodyOffset := Geometry.TuiPointCreate(0, 2);
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.NotesUpdate, View.NotesView, 0, 0);
  Test.AssertTrue(ScreenContains(Runtime.TuiApplicationSurfaceSnapshot(App), 'visible body text'));
  Runtime.TuiApplicationInject(App, Tui.TuiMsgTextChanged(Ids.TuiControlIdCreate(3), Ids.TuiActionCreate(3), 'Modern terminal notes', 21));
  Runtime.TuiApplicationInject(App, Tui.TuiMsgTextAreaChanged(Ids.TuiControlIdCreate(5), Ids.TuiActionCreate(5), 'Written through MVU', 19, Geometry.TuiPointCreate(0, 0)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.NotesUpdate, View.NotesView, 2, 0);
  Test.AssertTrue(Model.Dirty);
  Runtime.TuiApplicationInject(App, Tui.TuiMsgAction(Ids.TuiControlIdCreate(21), Ids.TuiActionCreate(11)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertFalse(Model.Dirty);
  Test.AssertTrue(Fs.Exists(Directory + '/tui-workflow.note'));
  Test.AssertTrue(ScreenContains(Runtime.TuiApplicationSurfaceSnapshot(App), 'NOTES'));
  Runtime.TuiApplicationInject(App, Tui.TuiMsgAction(Ids.TuiControlIdCreate(22), Ids.TuiActionCreate(12)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(Model.Notes[0].Pinned);
  Test.AssertFalse(Model.Dirty);
  Runtime.TuiApplicationInject(App, Tui.TuiMsgAction(Ids.TuiControlIdCreate(20), Ids.TuiActionCreate(14)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(Model.Overlay = Model2.NotesOverlay.Commands);
  Test.AssertTrue(ScreenContains(Runtime.TuiApplicationSurfaceSnapshot(App), 'Quick actions'));
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.QuitRequested);
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(Model.Overlay = Model2.NotesOverlay.Closed);
  Runtime.TuiApplicationInjectResizeForTest(App, Geometry.TuiSizeCreate(60, 20));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertEquals(60, Model.Width);
  Test.AssertTrue(ScreenContains(Runtime.TuiApplicationSurfaceSnapshot(App), 'Editor'));
  Runtime.TuiApplicationInject(App, Tui.TuiMsgAction(Ids.TuiControlIdCreate(23), Ids.TuiActionCreate(13)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, Update.NotesUpdate, View.NotesView, 1, 0);
  Test.AssertTrue(Model.Notes[0].Archived);
  Test.AssertEquals(-1, Model.Selected);
  Runtime.TuiApplicationClose(App);
end program;
