program CallbackSleepTest;

uses Std.Tasks, Std.Test, Std.Time;

function SleepAndDouble(Value: integer): integer;
begin
  Sleep(25);
  return Value * 2;
end function;

function MapValue(): integer;
begin
  const Values: array of integer := [21].Map(SleepAndDouble);
  return Values[0];
end function;

function PeerValue(): integer;
begin
  return 7;
end function;

begin
  const Mapper: task := go MapValue();
  const Peer: task := go PeerValue();
  AssertEquals(7, Wait(Peer));
  AssertEquals(42, Wait(Mapper));
end.
