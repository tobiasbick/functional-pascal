program CallbackSleepTest;

uses Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

function SleepAndDouble(Value: integer): integer;
begin
  Time.Sleep(25);
  return Value * 2;
end function;

function MapValue(): integer;
begin
  const Values: array of integer := [21].Map(SleepAndDouble);
  return Values[0];
end function;

function PeerValue(): integer;
begin
  return 7;
end function;

begin
  scope
    const Mapper: task of integer := go MapValue();
    const Peer: task of integer := go PeerValue();
    Test.AssertEquals(7, Tasks.Wait(Peer));
    Test.AssertEquals(42, Tasks.Wait(Mapper));
  end scope;
end.
