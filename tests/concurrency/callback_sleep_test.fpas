program CallbackSleepTest;

uses Std.Arrays as Arrays;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Time as Time;

function MapValue(): integer;
begin
  var Value: integer := 0;
  Arrays.ForEach([21], procedure(Item: integer) begin
    Time.Sleep(25);
    Value := Item * 2;
  end procedure);
  return Value;
end function;

function PeerValue(): integer;
begin
  return 7;
end function;

begin
  const Mapper: task := go MapValue();
  const Peer: task := go PeerValue();
  Test.AssertEquals(7, Tasks.Wait(Peer));
  Test.AssertEquals(42, Tasks.Wait(Mapper));
end program;
