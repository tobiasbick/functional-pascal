program CollectionCallbacksTest;

uses Std.Dictionaries as Dictionaries;
uses Std.Str as Str;
uses Std.Tasks as Tasks;
uses Std.Test as Test;

pure function Identity(C: string): string;
begin
  return C;
end function;

pure function KeepFace(C: string): boolean;
begin
  return C = '😀';
end function;

pure function Count(Acc: integer; C: string): integer;
begin
  return Acc + 1;
end function;

pure function Sum(Acc: integer; Key: string; Value: integer): integer;
begin
  return Acc + Value;
end function;

function StringWork(): integer;
begin
  Test.AssertEquals('a😀b', Str.Map('a😀b', Identity));
  Test.AssertEquals('😀', Str.Filter('a😀b', KeepFace));
  return Str.Reduce('a😀b', 0, Count);
end function;

function DictionaryWork(): integer;
begin
  const Values: dict of (string, integer) := ['A': 2, 'B': 4];
  return Dictionaries.Reduce(Values, 1, Sum);
end function;

begin
  const StringTask: task := go StringWork();
  const DictionaryTask: task := go DictionaryWork();
  Test.AssertEquals(3, Tasks.Wait(StringTask));
  Test.AssertEquals(7, Tasks.Wait(DictionaryTask));
end program;
