program CollectionCallbacksTest;

uses Std.Tasks as Tasks, Std.Test as Test;

function Identity(C: string): string;
begin
  return C;
end function;

function KeepFace(C: string): boolean;
begin
  return C = '😀';
end function;

function Count(Acc: integer; C: string): integer;
begin
  return Acc + 1;
end function;

function Sum(Acc: integer; Key: string; Value: integer): integer;
begin
  return Acc + Value;
end function;

function StringWork(): integer;
begin
  Test.AssertEquals('a😀b', 'a😀b'.Map(Identity));
  Test.AssertEquals('😀', 'a😀b'.Filter(KeepFace));
  return 'a😀b'.Reduce(0, Count);
end function;

function DictionaryWork(): integer;
begin
  const Values: dict of string to integer := ['A': 2, 'B': 4];
  return Values.Reduce(1, Sum);
end function;

begin
  scope
    const StringTask: task of integer := go StringWork();
    const DictionaryTask: task of integer := go DictionaryWork();
    Test.AssertEquals(3, Tasks.Wait(StringTask));
    Test.AssertEquals(7, Tasks.Wait(DictionaryTask));
  end scope;
end.
