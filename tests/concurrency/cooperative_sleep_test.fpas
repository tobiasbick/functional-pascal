program CooperativeSleepTest;

uses Std.Arrays as Arrays;
uses Std.Tasks as Tasks2;
uses Std.Test as Test;
uses Std.Time as Time;

procedure Sleeper();
begin
  Time.Sleep(50);
end procedure;

begin
  mutable var Tasks: array of (task) := [];
  var Started: integer := Time.MonotonicMillis();
  for I: integer := 1 to 8 do
    begin
      Arrays.Push(Tasks, go Sleeper());
    end;
  end for;

  Tasks2.WaitAll(Tasks);
  var Elapsed: integer := Time.ElapsedMillis(Started);
  Test.AssertTrue(Elapsed >= 40);
  Test.AssertTrue(Elapsed < 1000);
end program;
