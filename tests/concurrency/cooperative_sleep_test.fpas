program CooperativeSleepTest;

uses Std.Arrays, Std.Tasks, Std.Test, Std.Time;

procedure Sleeper();
begin
  Sleep(50);
end procedure;

begin
  var Tasks: array of task := [];
  const Started: integer := MonotonicMillis();
  for I: integer := 1 to 8 do
    begin
      Push(Tasks, go Sleeper());
    end;
  end for;

  WaitAll(Tasks);
  const Elapsed: integer := ElapsedMillis(Started);
  AssertTrue(Elapsed >= 40);
  AssertTrue(Elapsed < 1000);
end.
