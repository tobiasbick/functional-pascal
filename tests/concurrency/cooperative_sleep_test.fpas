program CooperativeSleepTest;

uses Std.Tasks as StdTasks, Std.Test as Test, Std.Time as Time;

procedure Sleeper();
begin
  Time.Sleep(50);
end procedure;

begin
  scope
    var Tasks: array of task := [];
    const Started: integer := Time.MonotonicMillis();
    for I: integer := 1 to 8 do
      begin
        Tasks.PushInPlace(go Sleeper());
      end;
    end for;

    StdTasks.WaitAll(Tasks);
    const Elapsed: integer := Time.ElapsedMillis(Started);
    Test.AssertTrue(Elapsed >= 40);
    Test.AssertTrue(Elapsed < 1000);
  end scope;
end.
