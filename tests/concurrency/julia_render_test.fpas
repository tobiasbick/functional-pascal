program JuliaRenderTest;

uses
  Julia.Render as Render, Julia.Compute as Compute, Julia.Color as Color, Std.Tasks as Tasks,
  Std.Test as Test;

begin
  const Job: Render.RenderJob := Render.StartRender(-1.0, 1.0, -1.0, 1.0, 7, 9, 32, Color.PaletteKind.DeepOcean, -0.8, 0.156);
  var Seen: array of boolean := [false, false, false, false, false, false, false, false, false];
  for Index: integer := 1 to 9 do
    begin
      const Row: Render.RenderRow := Tasks.ReceiveWithTimeout(Job.Rows, 5000).Unwrap();
      Test.AssertTrue((Row.Y >= 0) and (Row.Y < 9));
      Test.AssertFalse(Seen[Row.Y]);
      Seen[Row.Y] := true;
      const Expected: array of Compute.PixelSample := Compute.ComputeRow(Row.Y, 7, 9, -1.0, 1.0, -1.0, 1.0, 32, -0.8, 0.156, Tasks.GetTaskGroupToken(Job.Group));
      Test.AssertEquals(7, Row.Samples.Length());
      for X: integer := 0 to 6 do
        begin
          Test.AssertTrue(Row.Samples[X].IsInside = Expected[X].IsInside);
          Test.AssertTrue(Row.Samples[X].EscapeValue = Expected[X].EscapeValue);
        end;
      end for;
    end;
  end for;

  Render.StopRender(Job);
  for Found: boolean in Seen do
    begin
      Test.AssertTrue(Found);
    end;
  end for;
end.
