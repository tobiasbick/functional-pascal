program SupervisedChannelSelectionTest;

uses Std.Tasks as Tasks;
uses Std.Arrays as Arrays;
uses Std.Results as Results;
uses Std.Test as Test;

begin
  for Round: integer := 1 to 4 do
    begin
      var Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
      var Token: Tasks.CancellationToken := Tasks.GetTaskGroupToken(Group);
      var Output: channel of integer := Tasks.CreateChannel(1);
      mutable var Children: array of task := [];
      mutable var Seen: array of integer := [];
      for Item: integer := 0 to 255 do
        begin
          Arrays.Push(Seen, 0);
        end;
      end for;

      for Producer: integer := 0 to 7 do
        begin
          var Attempts: channel of boolean := Tasks.CreateChannel(2);
          Tasks.Send(Attempts, false);
          Tasks.Send(Attempts, true);
          Arrays.Push(Children, Tasks.StartSupervisedTask(Group, function(WorkerToken: Tasks.CancellationToken): result of integer, string begin
            if not Results.Unwrap(Tasks.Receive(Attempts)) then
              begin
                return Error('transient startup failure');
              end;
            end if;

            Tasks.CloseChannel(Attempts);
            for Item: integer := 0 to 31 do
              begin
                Tasks.Select([
                               Tasks.SendCase(Output, Producer * 32 + Item, procedure(Outcome: result of boolean, string) begin
                                 Test.AssertTrue(Results.Unwrap(Outcome));
                               end procedure),
                               Tasks.CancellationCase(WorkerToken, procedure() begin
                                 panic('producer cancelled before drain');
                               end procedure)
                             ]);
              end;
            end for;

            return Ok(Producer);
          end function, 1, 1));
        end;
      end for;

      for Item: integer := 0 to 255 do
        begin
          Test.AssertEquals(0, Tasks.Select([
                                              Tasks.ReceiveCase(Output, procedure(Outcome: result of integer, string) begin
                                                var Number: integer := Results.Unwrap(Outcome);
                                                Test.AssertTrue((Number >= 0) and (Number < 256));
                                                Seen[Number] := Seen[Number] + 1;
                                              end procedure),
                                              Tasks.TimerCase(10000, procedure() begin
                                                panic('producer drain timed out');
                                              end procedure),
                                              Tasks.CancellationCase(Token, procedure() begin
                                                panic('consumer cancelled before drain');
                                              end procedure)
                                            ]));
        end;
      end for;

      Tasks.WaitAll(Children);
      Test.AssertEquals(0, Arrays.Length(Tasks.CloseTaskGroup(Group)));
      Test.AssertEquals(0, Arrays.Length(Tasks.CloseTaskGroup(Group)));
      for Count: integer in Seen do
        begin
          Test.AssertEquals(1, Count);
        end;
      end for;

      case Results.Unwrap(Tasks.TryReceive(Output)) of
        when Some(_):
          begin
            panic('duplicate delivery after drain');
          end;
        when None:
          begin
            null;
          end;
      end case;

      Tasks.CloseChannel(Output);
    end;
  end for;
end program;
