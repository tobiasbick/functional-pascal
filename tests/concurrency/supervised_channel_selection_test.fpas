program SupervisedChannelSelectionTest;

uses Std.Tasks as Tasks, Std.Test as Test;

begin
  for Round: integer := 1 to 4 do
    begin
      const Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
      const Token: Tasks.CancellationToken := Tasks.GetTaskGroupToken(Group);
      const Output: channel of integer := Tasks.CreateChannel(1);
      var Children: array of task of result of (integer, string) := [];
      var Seen: array of integer := [];
      for Item: integer := 0 to 255 do
        begin
          Seen.PushInPlace(0);
        end;
      end for;

      for Producer: integer := 0 to 7 do
        begin
          const Attempts: channel of boolean := Tasks.CreateChannel(2);
          discard Tasks.Send(Attempts, false);
          discard Tasks.Send(Attempts, true);
          Children.PushInPlace(
            Tasks.StartSupervisedTask(
              Group,
              function(WorkerToken: Tasks.CancellationToken): result of (integer, string) begin
                if not Tasks.Receive(Attempts).Unwrap() then
                  begin
                    return Error('transient startup failure');
                  end;
                end if;

                discard Tasks.CloseChannel(Attempts);
                for Item: integer := 0 to 31 do
                  begin
                    discard Tasks.Select([
                      Tasks.SendCase(
                        Output, Producer * 32 + Item,
                        procedure(Outcome: result of (boolean, string)) begin
                          Test.AssertTrue(Outcome.Unwrap());
                        end procedure
                      ),
                      Tasks.CancellationCase(
                        WorkerToken, procedure() begin
                          panic('producer cancelled before drain');
                        end procedure
                      )
                    ]);
                  end;
                end for;

                return Ok(Producer);
              end function, 1, 1
            )
          );
        end;
      end for;

      for Item: integer := 0 to 255 do
        begin
          Test.AssertEquals(
            0, Tasks.Select([
              Tasks.ReceiveCase(
                Output, procedure(Outcome: result of (integer, string)) begin
                  const Number: integer := Outcome.Unwrap();
                  Test.AssertTrue((Number >= 0) and (Number < 256));
                  Seen[Number] := Seen[Number] + 1;
                end procedure
              ),
              Tasks.TimerCase(
                10000, procedure() begin
                  panic('producer drain timed out');
                end procedure
              ),
              Tasks.CancellationCase(
                Token, procedure() begin
                  panic('consumer cancelled before drain');
                end procedure
              )
            ])
          );
        end;
      end for;

      Tasks.WaitAll(Children);
      Test.AssertEquals(0, Tasks.CloseTaskGroup(Group).Length());
      Test.AssertEquals(0, Tasks.CloseTaskGroup(Group).Length());
      for Count: integer in Seen do
        begin
          Test.AssertEquals(1, Count);
        end;
      end for;

      case Tasks.TryReceive(Output).Unwrap() of
        when Some(_):
          begin
            panic('duplicate delivery after drain');
          end;
        when None:
          begin
          end;
      end case;

      discard Tasks.CloseChannel(Output);
    end;
  end for;
end.
