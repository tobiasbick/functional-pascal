program SupervisedChannelSelectionTest;

uses Std.Tasks, Std.Test;

begin
  for Round: integer := 1 to 4 do
    begin
      const Group: TaskGroup := CreateTaskGroup();
      const Token: CancellationToken := GetTaskGroupToken(Group);
      const Output: channel of integer := CreateChannel(1);
      var Children: array of task := [];
      var Seen: array of integer := [];
      for Item: integer := 0 to 255 do
        begin
          Seen.Push(0);
        end;
      end for;

      for Producer: integer := 0 to 7 do
        begin
          const Attempts: channel of boolean := CreateChannel(2);
          discard Send(Attempts, false);
          discard Send(Attempts, true);
          Children.Push(StartSupervisedTask(Group, function(WorkerToken: CancellationToken): result of integer, string begin
            if not Receive(Attempts).Unwrap() then
              begin
                return Error('transient startup failure');
              end;
            end if;

            discard CloseChannel(Attempts);
            for Item: integer := 0 to 31 do
              begin
                discard Select([
                                 SendCase(Output, Producer * 32 + Item, procedure(Outcome: result of boolean, string) begin
                                   AssertTrue(Outcome.Unwrap());
                                 end procedure),
                                 CancellationCase(WorkerToken, procedure() begin
                                   panic('producer cancelled before drain');
                                 end procedure)
                               ]);
              end;
            end for;

            return Ok(Producer);
          end function, 1, 1));
        end;
      end for;

      for Item: integer := 0 to 255 do
        begin
          AssertEquals(0, Select([
                                   ReceiveCase(Output, procedure(Outcome: result of integer, string) begin
                                     const Number: integer := Outcome.Unwrap();
                                     AssertTrue((Number >= 0) and (Number < 256));
                                     Seen[Number] := Seen[Number] + 1;
                                   end procedure),
                                   TimerCase(10000, procedure() begin
                                     panic('producer drain timed out');
                                   end procedure),
                                   CancellationCase(Token, procedure() begin
                                     panic('consumer cancelled before drain');
                                   end procedure)
                                 ]));
        end;
      end for;

      WaitAll(Children);
      AssertEquals(0, CloseTaskGroup(Group).Length());
      AssertEquals(0, CloseTaskGroup(Group).Length());
      for Count: integer in Seen do
        begin
          AssertEquals(1, Count);
        end;
      end for;

      case TryReceive(Output).Unwrap() of
        when Some(_):
          begin
            panic('duplicate delivery after drain');
          end;
        when None:
          begin
          end;
      end case;

      discard CloseChannel(Output);
    end;
  end for;
end.
