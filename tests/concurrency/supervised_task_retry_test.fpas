program SupervisedTaskRetryTest;

uses Std.Tasks, Std.Test;

begin
  const Group: TaskGroup := CreateTaskGroup();
  const Attempts: channel of integer := CreateChannel(3);
  discard Send(Attempts, 0);
  discard Send(Attempts, 1);
  discard Send(Attempts, 2);
  const Child: task := StartSupervisedTask(Group, function(Token: CancellationToken): result of (integer, string) begin
    const Attempt: integer := Receive(Attempts).Unwrap();
    if Attempt = 0 then
      begin
        return Error('retryable error');
      end;
    end if;

    if Attempt = 1 then
      begin
        panic('retryable panic');
      end;
    end if;

    return Ok(42);
  end function, 2, 1);
  AssertEquals(0, WaitAny([Child]));
  AssertEquals(42, Wait(Child).Unwrap());
  AssertEquals(0, CloseTaskGroup(Group).Length());
  discard CloseChannel(Attempts);
end.
