program SupervisedTaskRetryTest;

uses Std.Tasks as Tasks;
uses Std.Arrays as Arrays;
uses Std.Results as Results;
uses Std.Test as Test;

begin
  const Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const Attempts: channel of (integer) := Tasks.CreateChannel(3);
  discard Tasks.Send(Attempts, 0);
  discard Tasks.Send(Attempts, 1);
  discard Tasks.Send(Attempts, 2);
  const Child: task := Tasks.StartSupervisedTask(Group, function(Token: Tasks.CancellationToken): Result of (integer, string) begin
    const Attempt: integer := Results.Unwrap(Tasks.Receive(Attempts));
    if Attempt = 0 then
      begin
        return Result.Error('retryable error');
      end;
    end if;

    if Attempt = 1 then
      begin
        panic('retryable panic');
      end;
    end if;

    return Result.Ok(42);
  end function, 2, 1);
  Test.AssertEquals(0, Tasks.WaitAny([Child]));
  Test.AssertEquals(42, Results.Unwrap(Tasks.Wait(Child)));
  Test.AssertEquals(0, Arrays.Length(Tasks.CloseTaskGroup(Group)));
  discard Tasks.CloseChannel(Attempts);
end program;
