program TaskGroupCloseTimeoutTest;

uses Std.Tasks, Std.Test;

begin
  const Empty: TaskGroup := CreateTaskGroup();
  AssertEquals(0, CloseTaskGroupWithTimeout(Empty, 0).Unwrap().Length());
  AssertEquals(0, CloseTaskGroupWithTimeout(Empty, 0).Unwrap().Length());
  const Group: TaskGroup := CreateTaskGroup();
  const Token: CancellationToken := GetTaskGroupToken(Group);
  const Gate: channel of integer := CreateChannel(1);
  const Child: task of result of (integer, string) := StartTaskInGroup(Group, function(Stop: CancellationToken): result of (integer, string) begin
    discard Receive(Gate).Unwrap();
    if not IsCancellationRequested(Stop) then
      begin
        panic('missing cancellation');
      end;
    end if;

    return Error('retained worker failure');
  end function);
  const First: result of (array of TaskFailure, string) := CloseTaskGroupWithTimeout(Group, 2);
  case First of
    when Error(const Message):
      begin
        AssertEquals('Task group close timed out', Message);
      end;
    when Ok(const Reports):
      begin
        panic('worker has not been released');
      end;
  end case;

  AssertTrue(IsCancellationRequested(Token));
  AssertTrue(CloseTaskGroupWithTimeout(Group, 0).IsError());
  discard Send(Gate, 1).Unwrap();
  case Wait(Child) of
    when Error(const Message):
      AssertEquals('retained worker failure', Message);
    when Ok(_):
      panic('expected an ordinary Result error');
  end case;
  const Reports: array of TaskFailure := CloseTaskGroupWithTimeout(Group, 1000).Unwrap();
  AssertEquals(0, Reports.Length());
  AssertEquals(0, CloseTaskGroup(Group).Length());
  discard CloseChannel(Gate);
end.
