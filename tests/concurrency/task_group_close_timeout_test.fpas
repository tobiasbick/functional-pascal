program TaskGroupCloseTimeoutTest;

uses Std.Tasks as Tasks, Std.Test as Test;

begin
  const Empty: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  Test.AssertEquals(0, Tasks.CloseTaskGroupWithTimeout(Empty, 0).Unwrap().Length());
  Test.AssertEquals(0, Tasks.CloseTaskGroupWithTimeout(Empty, 0).Unwrap().Length());
  const Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const Token: Tasks.CancellationToken := Tasks.GetTaskGroupToken(Group);
  const Gate: channel of integer := Tasks.CreateChannel(1);
  const Child: task of result of (integer, string) := Tasks.StartTaskInGroup(
    Group, function(Stop: Tasks.CancellationToken): result of (integer, string) begin
      discard Tasks.Receive(Gate).Unwrap();
      if not Tasks.IsCancellationRequested(Stop) then
        begin
          panic('missing cancellation');
        end;
      end if;

      return Error('retained worker failure');
    end function
  );
  const First: result of (array of Tasks.TaskFailure, string) := Tasks.CloseTaskGroupWithTimeout(
    Group,
    2
  );
  case First of
    when Error(const Message):
      begin
        Test.AssertEquals('Task group close timed out', Message);
      end;
    when Ok(const Reports):
      begin
        panic('worker has not been released');
      end;
  end case;

  Test.AssertTrue(Tasks.IsCancellationRequested(Token));
  Test.AssertTrue((Tasks.CloseTaskGroupWithTimeout(Group, 0) is Error(_)));
  discard Tasks.Send(Gate, 1).Unwrap();
  case Tasks.Wait(Child) of
    when Error(const Message):
      Test.AssertEquals('retained worker failure', Message);
    when Ok(_):
      panic('expected an ordinary Result error');
  end case;
  const Reports: array of Tasks.TaskFailure := Tasks.CloseTaskGroupWithTimeout(
    Group,
    1000
  ).Unwrap();
  Test.AssertEquals(0, Reports.Length());
  Test.AssertEquals(0, Tasks.CloseTaskGroup(Group).Length());
  discard Tasks.CloseChannel(Gate);
end.
