program TaskGroupCloseTimeoutTest;

uses Std.Tasks as Tasks;
uses Std.Results as Results;
uses Std.Arrays as Arrays;
uses Std.Test as Test;

begin
  var Empty: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  Test.AssertEquals(0, Arrays.Length(Results.Unwrap(Tasks.CloseTaskGroupWithTimeout(Empty, 0))));
  Test.AssertEquals(0, Arrays.Length(Results.Unwrap(Tasks.CloseTaskGroupWithTimeout(Empty, 0))));
  var Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  var Token: Tasks.CancellationToken := Tasks.GetTaskGroupToken(Group);
  var Gate: channel of integer := Tasks.CreateChannel(1);
  var Child: task := Tasks.StartTaskInGroup(Group, function(Stop: Tasks.CancellationToken): result of integer, string begin
    Results.Unwrap(Tasks.Receive(Gate));
    if not Tasks.IsCancellationRequested(Stop) then
      begin
        panic('missing cancellation');
      end;
    end if;

    return Error('retained worker failure');
  end function);
  var First: result of array of Tasks.TaskFailure, string := Tasks.CloseTaskGroupWithTimeout(Group, 2);
  case First of
    when Error(Message):
      begin
        Test.AssertEquals('Task group close timed out', Message);
      end;
    when Ok(Reports):
      begin
        panic('worker has not been released');
      end;
  end case;

  Test.AssertTrue(Tasks.IsCancellationRequested(Token));
  Test.AssertTrue(Results.IsError(Tasks.CloseTaskGroupWithTimeout(Group, 0)));
  Results.Unwrap(Tasks.Send(Gate, 1));
  var Reports: array of Tasks.TaskFailure := Results.Unwrap(Tasks.CloseTaskGroupWithTimeout(Group, 1000));
  Test.AssertEquals(1, Arrays.Length(Reports));
  Test.AssertTrue(Reports[0].Kind = Tasks.TaskFailureKind.ReturnedError);
  Test.AssertEquals('retained worker failure', Reports[0].Message);
  Test.AssertEquals(0, Arrays.Length(Tasks.CloseTaskGroup(Group)));
  Tasks.CloseChannel(Gate);
end program;
