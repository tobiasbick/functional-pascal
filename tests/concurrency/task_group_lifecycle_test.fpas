program TaskGroupLifecycleTest;

uses Std.Tasks as Tasks;
uses Std.Arrays as Arrays;
uses Std.Results as Results;
uses Std.Test as Test;

procedure VerifyClose(RequestFirst: boolean);
begin
  var Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  var Ready: channel of boolean := Tasks.CreateChannel(1);
  var Empty: channel of integer := Tasks.CreateChannel(1);
  var Finished: channel of boolean := Tasks.CreateChannel(1);
  // Discard both handles: group ownership must retain the child and grandchild.
  Tasks.StartTaskInGroup(Group, procedure(Token: Tasks.CancellationToken) begin
    Tasks.StartTaskInGroup(Group, procedure(ChildToken: Tasks.CancellationToken) begin
      case Tasks.ReceiveWithCancellation(Empty, ChildToken) of
        when Ok(_):
          begin
            panic('empty channel unexpectedly delivered');
          end;
        when Error(_):
          begin
            Test.AssertTrue(Tasks.IsCancellationRequested(ChildToken));
          end;
      end case;

      Tasks.Send(Finished, true);
    end procedure);
    Tasks.Send(Ready, true);
  end procedure);
  Test.AssertTrue(Results.Unwrap(Tasks.Receive(Ready)));
  if RequestFirst then
    begin
      Test.AssertTrue(Tasks.CancelTaskGroup(Group));
      Test.AssertFalse(Tasks.CancelTaskGroup(Group));
      Test.AssertTrue(Tasks.IsCancellationRequested(Tasks.GetTaskGroupToken(Group)));
    end;
  end if;

  Test.AssertEquals(0, Arrays.Length(Tasks.CloseTaskGroup(Group)));
  // Close must not return before the grandchild's final side effect.
  Test.AssertTrue(Results.Unwrap(Tasks.Receive(Finished)));
  Test.AssertEquals(0, Arrays.Length(Tasks.CloseTaskGroup(Group)));
  Tasks.CloseChannel(Ready);
  Tasks.CloseChannel(Empty);
  Tasks.CloseChannel(Finished);
end procedure;

begin
  VerifyClose(false);
  VerifyClose(true);
end program;
