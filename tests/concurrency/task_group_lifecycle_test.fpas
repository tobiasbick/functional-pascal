program TaskGroupLifecycleTest;

uses Std.Tasks, Std.Arrays, Std.Results, Std.Test;

procedure VerifyClose(RequestFirst: boolean);
begin
  const Group: TaskGroup := CreateTaskGroup();
  const Ready: channel of boolean := CreateChannel(1);
  const Empty: channel of integer := CreateChannel(1);
  const Finished: channel of boolean := CreateChannel(1);
  // Discard both handles: group ownership must retain the child and grandchild.
  const ParentTask: task := StartTaskInGroup(Group, procedure(Token: CancellationToken) begin
    const ChildTask: task := StartTaskInGroup(Group, procedure(ChildToken: CancellationToken) begin
      case ReceiveWithCancellation(Empty, ChildToken) of
        when Ok(_):
          begin
            panic('empty channel unexpectedly delivered');
          end;
        when Error(_):
          begin
            AssertTrue(IsCancellationRequested(ChildToken));
          end;
      end case;

      discard Send(Finished, true);
    end procedure);
    discard Send(Ready, true);
  end procedure);
  AssertTrue(Unwrap(Receive(Ready)));
  if RequestFirst then
    begin
      AssertTrue(CancelTaskGroup(Group));
      AssertFalse(CancelTaskGroup(Group));
      AssertTrue(IsCancellationRequested(GetTaskGroupToken(Group)));
    end;
  end if;

  AssertEquals(0, Length(CloseTaskGroup(Group)));
  // Close must not return before the grandchild's final side effect.
  AssertTrue(Unwrap(Receive(Finished)));
  AssertEquals(0, Length(CloseTaskGroup(Group)));
  discard CloseChannel(Ready);
  discard CloseChannel(Empty);
  discard CloseChannel(Finished);
end procedure;

begin
  VerifyClose(false);
  VerifyClose(true);
end.
