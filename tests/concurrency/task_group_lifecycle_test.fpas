program TaskGroupLifecycleTest;

uses Std.Tasks as Tasks, Std.Test as Test;

procedure VerifyClose(RequestFirst: boolean);
begin
  const Group: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const Ready: channel of boolean := Tasks.CreateChannel(1);
  const Empty: channel of integer := Tasks.CreateChannel(1);
  const Finished: channel of boolean := Tasks.CreateChannel(1);
  // Discard both handles: group ownership must retain the child and grandchild.
  const ParentTask: task := Tasks.StartTaskInGroup(Group, procedure(Token: Tasks.CancellationToken) begin
    const ChildTask: task := Tasks.StartTaskInGroup(Group, procedure(ChildToken: Tasks.CancellationToken) begin
      case Tasks.ReceiveWithCancellation(Empty, ChildToken) of
        when Ok(_):
          begin
            panic('empty channel unexpectedly delivered');
          end;
        when Error(_):
          begin
            Test.AssertTrue(Tasks.IsCancellationRequested(ChildToken));
          end;
      end case;

      discard Tasks.Send(Finished, true);
    end procedure);
    discard Tasks.Send(Ready, true);
  end procedure);
  Test.AssertTrue(Tasks.Receive(Ready).Unwrap());
  if RequestFirst then
    begin
      Test.AssertTrue(Tasks.CancelTaskGroup(Group));
      Test.AssertFalse(Tasks.CancelTaskGroup(Group));
      Test.AssertTrue(Tasks.IsCancellationRequested(Tasks.GetTaskGroupToken(Group)));
    end;
  end if;

  Test.AssertEquals(0, Tasks.CloseTaskGroup(Group).Length());
  // Close must not return before the grandchild's final side effect.
  Test.AssertTrue(Tasks.Receive(Finished).Unwrap());
  Test.AssertEquals(0, Tasks.CloseTaskGroup(Group).Length());
  discard Tasks.CloseChannel(Ready);
  discard Tasks.CloseChannel(Empty);
  discard Tasks.CloseChannel(Finished);
end procedure;

begin
  VerifyClose(false);
  VerifyClose(true);
end.
