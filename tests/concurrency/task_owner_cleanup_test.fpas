program TaskOwnerCleanupTest;

uses Std.Tasks as Tasks, Std.Test as Test;

function Parent(Ready: channel of boolean; Done: channel of boolean): integer;
begin
  const Group := Tasks.CreateTaskGroup();
  const Gate: channel of boolean := Tasks.CreateChannel(1);
  discard Tasks.StartTaskInGroup(Group, procedure(Token: Tasks.CancellationToken) begin
    discard Tasks.Send(Ready, true);
    Test.AssertTrue((Tasks.ReceiveWithCancellation(Gate, Token) is Error(_)));
    Test.AssertTrue(Tasks.IsCancellationRequested(Token));
    discard Tasks.Send(Done, true);
  end procedure);
  Test.AssertTrue(Tasks.Receive(Ready).Unwrap());
  return 42;
end function;

procedure Produce(Queue: channel of integer);
begin
  discard Tasks.Send(Queue, 7);
end procedure;

begin
  const Ready: channel of boolean := Tasks.CreateChannel(1);
  const Done: channel of boolean := Tasks.CreateChannel(1);
  scope
    const Job := go Parent(Ready, Done);
    Test.AssertEquals(42, Tasks.Wait(Job));
    Test.AssertTrue(Tasks.ReceiveWithTimeout(Done, 0).Unwrap());
    Tasks.WaitAll([Job]);
    Test.AssertEquals(0, Tasks.WaitAnyWithTimeout([Job], 0).Unwrap());
  end scope;
  const Queue: channel of integer := Tasks.CreateChannel(1);
  scope
    const Job := go Produce(Queue);
    discard Job;
    discard [Job];
  end scope;

  Test.AssertEquals(7, Tasks.ReceiveWithTimeout(Queue, 0).Unwrap());
  const Group := Tasks.CreateTaskGroup();
  const Data := Tasks.StartTaskInGroup(Group, function(Token: Tasks.CancellationToken): result of (integer, integer) begin
    return Error(7);
  end function);
  case Tasks.Wait(Data) of
    when Error(const Number):
      Test.AssertEquals(7, Number);
    when Ok(_):
      panic('expected ordinary integer Result error data');
  end case;

  Test.AssertEquals(0, Tasks.CloseTaskGroup(Group).Length());
  discard Tasks.CloseChannel(Ready);
  discard Tasks.CloseChannel(Done);
  discard Tasks.CloseChannel(Queue);
end.
