program TaskScopeLifecycleTest;

uses Std.Tasks as Tasks, Std.Test as Test;

procedure Produce(Queue: channel of integer; Value: integer);
begin
  discard Tasks.Send(Queue, Value);
end procedure;

procedure Block(Empty: channel of integer; Ready: channel of integer);
begin
  discard Tasks.Send(Ready, 1);
  discard Tasks.Receive(Empty);
end procedure;

procedure Parent(Empty: channel of integer; Ready: channel of integer);
begin
  scope
    discard go Block(Empty, Ready);
    discard Tasks.Receive(Empty);
  end scope;
end procedure;

function ReturnEarly(Empty: channel of integer; Ready: channel of integer): integer;
begin
  scope
    discard go Parent(Empty, Ready);
    Test.AssertEquals(1, Tasks.Receive(Ready).Unwrap());
    return 7;
  end scope;
end function;

function Missing(): result of (integer, string);
begin
  return Error('ordinary result');
end function;

begin
  const Queue: channel of integer := Tasks.CreateChannel(2);
  scope
    discard go Produce(Queue, 1);
    const Child: task := go Produce(Queue, 2);
  end scope;

  Test.AssertEquals(3, Tasks.TryReceive(Queue).Unwrap().Unwrap() +
                       Tasks.TryReceive(Queue).Unwrap().Unwrap());
  const Empty: channel of integer := Tasks.CreateChannel(1);
  const Ready: channel of integer := Tasks.CreateChannel(1);
  Test.AssertEquals(7, ReturnEarly(Empty, Ready));
  scope
    const Job: task of result of (integer, string) := go Missing();
    case Tasks.Wait(Job) of
      when Ok(_):
        panic('expected an ordinary error result');
      when Error(const Message):
        Test.AssertEquals('ordinary result', Message);
    end case;
  end scope;

  discard Tasks.CloseChannel(Queue);
  discard Tasks.CloseChannel(Empty);
  discard Tasks.CloseChannel(Ready);
end.
