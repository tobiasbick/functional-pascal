program TaskScopeLifecycleTest;

uses Std.Tasks, Std.Test;

procedure Produce(Queue: channel of integer; Value: integer);
begin
  discard Send(Queue, Value);
end procedure;

procedure Block(Empty: channel of integer; Ready: channel of integer);
begin
  discard Send(Ready, 1);
  discard Receive(Empty);
end procedure;

procedure Parent(Empty: channel of integer; Ready: channel of integer);
begin
  scope
    go Block(Empty, Ready);
    discard Receive(Empty);
  end scope;
end procedure;

function ReturnEarly(Empty: channel of integer; Ready: channel of integer): integer;
begin
  scope
    go Parent(Empty, Ready);
    AssertEquals(1, Receive(Ready).Unwrap());
    return 7;
  end scope;
end function;

function Missing(): result of (integer, string);
begin
  return Error('ordinary result');
end function;

begin
  const Queue: channel of integer := CreateChannel(2);
  scope
    go Produce(Queue, 1);
    const Child: task := go Produce(Queue, 2);
  end scope;

  AssertEquals(3, TryReceive(Queue).Unwrap().Unwrap() + TryReceive(Queue).Unwrap().Unwrap());
  const Empty: channel of integer := CreateChannel(1);
  const Ready: channel of integer := CreateChannel(1);
  AssertEquals(7, ReturnEarly(Empty, Ready));
  scope
    const Job: task of result of (integer, string) := go Missing();
    case Wait(Job) of
      when Ok(_):
        panic('expected an ordinary error result');
      when Error(const Message):
        AssertEquals('ordinary result', Message);
    end case;
  end scope;

  discard CloseChannel(Queue);
  discard CloseChannel(Empty);
  discard CloseChannel(Ready);
end.
