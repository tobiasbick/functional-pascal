program TaskSpawnLoopWithArgumentTest;

uses Std.Tasks as StdTasks, Std.Test as Test;

function Worker(Value: integer): integer;
begin
  return Value + 1;
end function;

begin
  scope
    var Tasks: array of task of integer := [];
    for Index: integer := 1 to 8 do
      begin
        Tasks.PushInPlace(go Worker(Index));
      end;
    end for;

    StdTasks.WaitAll(Tasks);
    Test.AssertEquals(8, Tasks.Length());
    for Index: integer := 0 to Tasks.Length() - 1 do
      begin
        const WorkerResult: integer := StdTasks.Wait(Tasks[Index]);
        Test.AssertEquals(Index + 2, WorkerResult);
      end;
    end for;
  end scope;
end.
