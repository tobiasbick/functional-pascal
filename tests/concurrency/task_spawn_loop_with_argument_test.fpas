program TaskSpawnLoopWithArgumentTest;

uses Std.Array, Std.Task, Std.Test;

function Worker(Value: integer): integer;
begin
  return Value + 1
end;

begin
  mutable var Tasks: array of task := [];
  for Index: integer := 1 to 8 do
  begin
    Push(Tasks, go Worker(Index))
  end;

  WaitAll(Tasks);
  AssertEquals(8, Length(Tasks));
  for Index: integer := 0 to Length(Tasks) - 1 do
  begin
    var WorkerResult: integer := Std.Task.Wait(Tasks[Index]);
    AssertEquals(Index + 2, WorkerResult)
  end
end.
