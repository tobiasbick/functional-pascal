program TaskSpawnLoopWithArgumentTest;

uses Std.Arrays as Arrays;
uses Std.Tasks as Tasks2;
uses Std.Test as Test;

function Worker(Value: integer): integer;
begin
  return Value + 1;
end function;

begin
  var Tasks: array of (task) := [];
  for Index: integer := 1 to 8 do
    begin
      Arrays.Push(var Tasks, go Worker(Index));
    end;
  end for;

  Tasks2.WaitAll(Tasks);
  var Index: integer := 0;
  for Handle: task in Tasks do
    begin
      const WorkerResult: integer := Tasks2.Wait(Handle);
      Test.AssertEquals(Index + 2, WorkerResult);
      Index := Index + 1;
    end;
  end for;

  Test.AssertEquals(8, Index);
end program;
