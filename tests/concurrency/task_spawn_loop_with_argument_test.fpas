program TaskSpawnLoopWithArgumentTest;

uses Std.Tasks, Std.Test;

function Worker(Value: integer): integer;
begin
  return Value + 1;
end function;

begin
  var Tasks: array of task := [];
  for Index: integer := 1 to 8 do
    begin
      Tasks.Push(go Worker(Index));
    end;
  end for;

  WaitAll(Tasks);
  AssertEquals(8, Tasks.Length());
  for Index: integer := 0 to Tasks.Length() - 1 do
    begin
      const WorkerResult: integer := Std.Tasks.Wait(Tasks[Index]);
      AssertEquals(Index + 2, WorkerResult);
    end;
  end for;
end.
