program TaskSpawnLoopWithArgumentTest;

uses Std.Arrays as Arrays;
uses Std.Tasks as Tasks2;
uses Std.Test as Test;

function Worker(Value: integer): integer;
begin
  return Value + 1;
end function;

begin
  mutable var Tasks: array of (task) := [];
  for Index: integer := 1 to 8 do
    begin
      Arrays.Push(Tasks, go Worker(Index));
    end;
  end for;

  Tasks2.WaitAll(Tasks);
  Test.AssertEquals(8, Arrays.Length(Tasks));
  for Index: integer := 0 to Arrays.Length(Tasks) - 1 do
    begin
      var WorkerResult: integer := Tasks2.Wait(Tasks[Index]);
      Test.AssertEquals(Index + 2, WorkerResult);
    end;
  end for;
end program;
