program WaitAll;

uses Std.Console as Console, Std.Tasks as Tasks;

function Double(X: integer): integer;
begin
  return X * 2;
end function;

begin
  scope
    const T1: task of integer := go Double(1);
    const T2: task of integer := go Double(2);
    const T3: task of integer := go Double(3);
    const Results: array of task of integer := [T1, T2, T3];
    Tasks.WaitAll(Results);
    Console.WriteLn('done');
  end scope;
end.
