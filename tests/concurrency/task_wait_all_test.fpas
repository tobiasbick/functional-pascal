program WaitAll;

uses Std.Console, Std.Tasks;

function Double(X: integer): integer;
begin
  return X * 2;
end function;

begin
  const T1: task := go Double(1);
  const T2: task := go Double(2);
  const T3: task := go Double(3);
  const Results: array of task := [T1, T2, T3];
  Std.Tasks.WaitAll(Results);
  WriteLn('done');
end.
