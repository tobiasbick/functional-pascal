program TryCloseCompletedTaskGroupTest;

uses Std.Arrays as Arrays;
uses Std.Options as Options;
uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Time as Time;

begin
  const Empty: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  Test.AssertEquals(0, Arrays.Length(Options.Unwrap(Tasks.TryCloseCompletedTaskGroup(Empty))));
  Test.AssertEquals(0, Arrays.Length(Options.Unwrap(Tasks.TryCloseCompletedTaskGroup(Empty))));
  const Gate: channel of (boolean) := Tasks.CreateChannel(1);
  const Ready: channel of (boolean) := Tasks.CreateChannel(1);
  const Returned: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const StartedTask1: task := Tasks.StartTaskInGroup(Returned, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
    discard Tasks.Send(Ready, true);
    case Tasks.ReceiveWithCancellation(Gate, Token) of
      when Result.Ok(_):
        begin
          return Result.Error('expected returned error');
        end;
      when Result.Error(const Message):
        begin
          return Result.Error('probe cancelled pending work');
        end;
    end case;
  end function);
  Test.AssertTrue(Results.Unwrap(Tasks.ReceiveWithTimeout(Ready, 10000)));
  Test.AssertTrue(Options.IsNone(Tasks.TryCloseCompletedTaskGroup(Returned)));
  discard Tasks.Send(Gate, true);
  var ReturnedFailures: Option of (array of (Tasks.TaskFailure)) := Option.None;
  while Options.IsNone(ReturnedFailures) do
    begin
      Time.Sleep(1);
      ReturnedFailures := Tasks.TryCloseCompletedTaskGroup(Returned);
    end;
  end while;
  const ReturnedReport: array of (Tasks.TaskFailure) := Options.Unwrap(ReturnedFailures);
  Test.AssertEquals(1, Arrays.Length(ReturnedReport));
  Test.AssertTrue(ReturnedReport[0].Kind = Tasks.TaskFailureKind.ReturnedError);
  Test.AssertEquals('expected returned error', ReturnedReport[0].Message);
  const PanicReady: channel of (boolean) := Tasks.CreateChannel(1);
  const Panicked: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const StartedTask2: task := Tasks.StartTaskInGroup(Panicked, procedure(Token: Tasks.CancellationToken) begin
    discard Tasks.Send(PanicReady, true);
    panic('expected panic report');
  end procedure);
  Test.AssertTrue(Results.Unwrap(Tasks.ReceiveWithTimeout(PanicReady, 10000)));
  var PanicFailures: Option of (array of (Tasks.TaskFailure)) := Option.None;
  while Options.IsNone(PanicFailures) do
    begin
      Time.Sleep(1);
      PanicFailures := Tasks.TryCloseCompletedTaskGroup(Panicked);
    end;
  end while;
  const PanicReport: array of (Tasks.TaskFailure) := Options.Unwrap(PanicFailures);
  Test.AssertEquals(1, Arrays.Length(PanicReport));
  Test.AssertTrue(PanicReport[0].Kind = Tasks.TaskFailureKind.Panicked);
  Test.AssertEquals('panic: expected panic report', PanicReport[0].Message);
  discard Tasks.CloseChannel(Gate);
  discard Tasks.CloseChannel(Ready);
  discard Tasks.CloseChannel(PanicReady);
end program;
