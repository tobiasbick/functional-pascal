program TryCloseCompletedTaskGroupTest;

uses Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

begin
  const Empty: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  Test.AssertEquals(0, Tasks.TryCloseCompletedTaskGroup(Empty).Unwrap().Length());
  Test.AssertEquals(0, Tasks.TryCloseCompletedTaskGroup(Empty).Unwrap().Length());
  const Gate: channel of boolean := Tasks.CreateChannel(1);
  const Ready: channel of boolean := Tasks.CreateChannel(1);
  const Returned: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const ReturnedTask: task of result of (boolean, string) := Tasks.StartTaskInGroup(
    Returned, function(Token: Tasks.CancellationToken): result of (boolean, string) begin
      discard Tasks.Send(Ready, true);
      case Tasks.ReceiveWithCancellation(Gate, Token) of
        when Ok(_):
          begin
            return Error('expected returned error');
          end;
        when Error(const Message):
          begin
            return Error('probe cancelled pending work');
          end;
      end case;
    end function
  );
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Ready, 10000).Unwrap());
  Test.AssertTrue((Tasks.TryCloseCompletedTaskGroup(Returned) is None));
  discard Tasks.Send(Gate, true);
  case Tasks.Wait(ReturnedTask) of
    when Error(const Message):
      Test.AssertEquals('expected returned error', Message);
    when Ok(_):
      panic('expected an ordinary Result error');
  end case;
  var ReturnedFailures: option of array of Tasks.TaskFailure := None;
  while (ReturnedFailures is None) do
    begin
      Time.Sleep(1);
      ReturnedFailures := Tasks.TryCloseCompletedTaskGroup(Returned);
    end;
  end while;
  const ReturnedReport: array of Tasks.TaskFailure := ReturnedFailures.Unwrap();
  Test.AssertEquals(0, ReturnedReport.Length());
  const PanicReady: channel of boolean := Tasks.CreateChannel(1);
  const Panicked: Tasks.TaskGroup := Tasks.CreateTaskGroup();
  const PanickedTask: task := Tasks.StartTaskInGroup(
    Panicked, procedure(Token: Tasks.CancellationToken) begin
      discard Tasks.Send(PanicReady, true);
      panic('expected panic report');
    end procedure
  );
  Test.AssertTrue(Tasks.ReceiveWithTimeout(PanicReady, 10000).Unwrap());
  var PanicFailures: option of array of Tasks.TaskFailure := None;
  while (PanicFailures is None) do
    begin
      Time.Sleep(1);
      PanicFailures := Tasks.TryCloseCompletedTaskGroup(Panicked);
    end;
  end while;
  const PanicReport: array of Tasks.TaskFailure := PanicFailures.Unwrap();
  Test.AssertEquals(1, PanicReport.Length());
  Test.AssertTrue(PanicReport[0].Kind = Tasks.TaskFailureKind.Panicked);
  Test.AssertEquals('panic: expected panic report', PanicReport[0].Message);
  discard Tasks.CloseChannel(Gate);
  discard Tasks.CloseChannel(Ready);
  discard Tasks.CloseChannel(PanicReady);
end.
