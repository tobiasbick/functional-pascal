program TryCloseCompletedTaskGroupTest;

uses Std.Arrays, Std.Options, Std.Results, Std.Tasks, Std.Test, Std.Time;

begin
  const Empty: TaskGroup := CreateTaskGroup();
  AssertEquals(0, Std.Arrays.Length(Std.Options.Unwrap(TryCloseCompletedTaskGroup(Empty))));
  AssertEquals(0, Std.Arrays.Length(Std.Options.Unwrap(TryCloseCompletedTaskGroup(Empty))));
  const Gate: channel of boolean := CreateChannel(1);
  const Ready: channel of boolean := CreateChannel(1);
  const Returned: TaskGroup := CreateTaskGroup();
  const ReturnedTask: task := StartTaskInGroup(Returned, function(Token: CancellationToken): result of boolean, string begin
    discard Send(Ready, true);
    case ReceiveWithCancellation(Gate, Token) of
      when Ok(_):
        begin
          return Error('expected returned error');
        end;
      when Error(Message):
        begin
          return Error('probe cancelled pending work');
        end;
    end case;
  end function);
  AssertTrue(Std.Results.Unwrap(ReceiveWithTimeout(Ready, 10000)));
  AssertTrue(IsNone(TryCloseCompletedTaskGroup(Returned)));
  discard Send(Gate, true);
  var ReturnedFailures: option of array of TaskFailure := None;
  while IsNone(ReturnedFailures) do
    begin
      Sleep(1);
      ReturnedFailures := TryCloseCompletedTaskGroup(Returned);
    end;
  end while;
  const ReturnedReport: array of TaskFailure := Std.Options.Unwrap(ReturnedFailures);
  AssertEquals(1, Std.Arrays.Length(ReturnedReport));
  AssertTrue(ReturnedReport[0].Kind = TaskFailureKind.ReturnedError);
  AssertEquals('expected returned error', ReturnedReport[0].Message);
  const PanicReady: channel of boolean := CreateChannel(1);
  const Panicked: TaskGroup := CreateTaskGroup();
  const PanickedTask: task := StartTaskInGroup(Panicked, procedure(Token: CancellationToken) begin
    discard Send(PanicReady, true);
    panic('expected panic report');
  end procedure);
  AssertTrue(Std.Results.Unwrap(ReceiveWithTimeout(PanicReady, 10000)));
  var PanicFailures: option of array of TaskFailure := None;
  while IsNone(PanicFailures) do
    begin
      Sleep(1);
      PanicFailures := TryCloseCompletedTaskGroup(Panicked);
    end;
  end while;
  const PanicReport: array of TaskFailure := Std.Options.Unwrap(PanicFailures);
  AssertEquals(1, Std.Arrays.Length(PanicReport));
  AssertTrue(PanicReport[0].Kind = TaskFailureKind.Panicked);
  AssertEquals('panic: expected panic report', PanicReport[0].Message);
  discard CloseChannel(Gate);
  discard CloseChannel(Ready);
  discard CloseChannel(PanicReady);
end.
