program ReadlnOrderTest;

uses Std.Console as Console;
uses Std.Test as Test;

begin
  Test.PushReadLn('first');
  Test.PushReadLn('second');
  Test.PushReadLn('third');
  Test.AssertEquals('first', Console.ReadLn());
  Test.AssertEquals('second', Console.ReadLn());
  Test.AssertEquals('third', Console.ReadLn());
end program;
