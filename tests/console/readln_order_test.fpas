program ReadlnOrderTest;

uses Std.Console as Console, Std.Test as Test;

begin
  Test.PushReadLn('first');
  Test.PushReadLn('second');
  Test.PushReadLn('third');
  Test.AssertEquals('first', Console.ReadLn().Unwrap());
  Test.AssertEquals('second', Console.ReadLn().Unwrap());
  Test.AssertEquals('third', Console.ReadLn().Unwrap());
end.
