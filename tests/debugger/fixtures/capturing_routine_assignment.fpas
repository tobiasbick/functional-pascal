program CapturingRoutineAssignment;

uses Std.Console, Std.Tasks;

type Handler = function(Value: integer): integer;

type Action = procedure();

type Math = record
  static function Transform(Value: integer): integer;
  begin
    return Value + 5;
  end function;
end record;

type Stats = record
  static function Transform(Value: integer): integer;
  begin
    return Value + 6;
  end function;
end record;

function Identity(Value: integer): integer;
begin
  return Value;
end function;

procedure Noop();
begin
end procedure;

function MakeAdder(Base: integer): Handler;
function AddBase(Value: integer): integer;
begin
  return Base + Value;
end function;
begin
  var Current: Handler := Identity;
  const MakeStop: integer := 0;
  return Current;
end function;

function Combine(Left: integer; Right: integer): Handler;
function AddBoth(Value: integer): integer;
begin
  return Value + Left * 10 + Right;
end function;
begin
  var Current: Handler := Identity;
  const CombineStop: integer := 0;
  return Current;
end function;

function Outer(Offset: integer): integer;
function AddOffset(Value: integer): integer;
begin
  return Value + Offset;
end function;
begin
  var Current: Handler := Identity;
  begin
    const Offset: integer := 99;
    const ShadowStop: integer := 0;
    return Current(1);
  end;
end function;

function Walk(N: integer; Acc: integer): integer;
function AddAcc(Value: integer): integer;
begin
  return Value + Acc;
end function;
begin
  var Current: Handler := Identity;
  const WalkStop: integer := 0;
  if N = 0 then
    begin
      return Current(0);
    end;
  else
    begin
      return Walk(N - 1, Acc + 10);
    end;
  end if;
end function;

function Mutating(): Handler;
function AddCell(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  var Cell: integer := 1;
  var Current: Handler := Identity;
  const CellStop: integer := 0;
  return Current;
end function;

function OuterCell(): Handler;
function Mid(): Handler;
function AddEnclosed(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  const Keep: integer := Cell;
  var Current: Handler := Identity;
  const EnclosingStop: integer := 0;
  return Current;
end function;
begin
  var Cell: integer := 1;
  return Mid();
end function;

function LateInit(): integer;
function AddLate(Value: integer): integer;
begin
  return Value + Offset;
end function;
begin
  var Current: Handler := Identity;
  const LateStop: integer := 0;
  const Offset: integer := 7;
  const LateReady: integer := 0;
  return Current(1);
end function;

function Worker(Base: integer): integer;
function AddWorker(Value: integer): integer;
begin
  return Base + Value;
end function;
begin
  var Current: Handler := Identity;
  const WorkerStop: integer := 0;
  return Current(1);
end function;

function HoldTask(Pending: task): Handler;
function IgnorePending(Value: integer): integer;
begin
  const Keep: task := Pending;
  return Value;
end function;
begin
  var Current: Handler := Identity;
  const TaskStop: integer := 0;
  return Current;
end function;

begin
  var Current: Handler := Identity;
  var Job: Action := Noop;
  const First: Handler := MakeAdder(10);
  const Both: Handler := Combine(3, 4);
  const Shadowed: integer := Outer(7);
  const Recursed: integer := Walk(2, 1);
  const Mutated: Handler := Mutating();
  const Enclosed: Handler := OuterCell();
  const Late: integer := LateInit();
  const Pending: task := go Worker(8);
  const Held: Handler := HoldTask(Pending);
  const RootStop: integer := 0;
  WriteLn(Wait(Pending));
  WriteLn(First(1));
end.
