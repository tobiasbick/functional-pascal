program CellCapturingRoutineAssignment;

uses Std.Console as Console;
uses Std.Tasks as Tasks;

type Handler = function(Value: integer): integer;

type Action = procedure();

type Pack = record
  Item: Handler;
end record;

function Identity(Value: integer): integer;
begin
  return Value;
end function;

procedure Noop();
begin
  null;
end procedure;

mutable var Shared: Handler := Identity;

function Mutating(): Handler;
function AddCell(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  mutable var Cell: integer := 1;
  var Original: Handler := AddCell;
  mutable var Current: Handler := Identity;
  var Frozen: Handler := Identity;
  mutable var Copy: Handler := Identity;
  mutable var Packed: Pack := Pack(Item := Identity);
  var CellStop: integer := 0;
  Cell := Cell + 10;
  Console.WriteLn(Current(0));
  Console.WriteLn(Original(0));
  return Current;
end function;

function Mix(Base: integer): Handler;
function MixBoth(Value: integer): integer;
begin
  Cell := Cell + 1;
  return (Value + Base) + Cell;
end function;
begin
  mutable var Cell: integer := 1;
  mutable var Current: Handler := Identity;
  var MixStop: integer := 0;
  return Current;
end function;

function OuterCell(): Handler;
function Mid(): Handler;
function AddEnclosed(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  var Original: Handler := AddEnclosed;
  mutable var Current: Handler := Identity;
  var EnclosingStop: integer := 0;
  return Current;
end function;
begin
  mutable var Cell: integer := 1;
  return Mid();
end function;

function Walk(N: integer): integer;
function AddAcc(Value: integer): integer;
begin
  Acc := Acc + 1;
  return Value + Acc;
end function;
begin
  mutable var Acc: integer := N;
  mutable var Current: Handler := Identity;
  var WalkStop: integer := 0;
  if N = 0 then
    begin
      return Current(0);
    end;
  else
    begin
      return Walk(N - 1);
    end;
  end if;
end function;

function Shadow(): Handler;
function AddOffset(Value: integer): integer;
begin
  Offset := Offset + 1;
  return Value + Offset;
end function;
begin
  mutable var Offset: integer := 7;
  mutable var Current: Handler := Identity;
  begin
    var Offset: integer := 99;
    var ShadowStop: integer := 0;
    return Current;
  end;
end function;

function LateCell(): Handler;
function AddLate(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  mutable var Current: Handler := Identity;
  var LateStop: integer := 0;
  mutable var Cell: integer := 1;
  var LateReady: integer := 0;
  return Current;
end function;

function PendingDest(): Handler;
function AddPending(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  mutable var Cell: integer := 1;
  var PendingStop: integer := 0;
  mutable var Current: Handler := Identity;
  return Current;
end function;

procedure Apply(mutable Current: Handler);
function AddParam(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  mutable var Cell: integer := 1;
  var ParamStop: integer := 0;
end procedure;

function NestedBox(): integer;
function AddBoxed(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  mutable var Cell: integer := 1;
  mutable var Packed: Pack := Pack(Item := Identity);
  var BoxStop: integer := 0;
  return 0;
end function;

function CaptureDest(): Handler;
function AddCaptured(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
function Touch(): integer;
begin
  return Current(0);
end function;
begin
  mutable var Cell: integer := 1;
  mutable var Source: Handler := Identity;
  mutable var Current: Handler := Identity;
  var Keep: integer := Touch();
  var CaptureDestStop: integer := 0;
  return Current;
end function;

function SpawnProbe(): integer;
procedure RunSpawn();
begin
  Cell := Cell + 1;
end procedure;
begin
  mutable var Cell: integer := 1;
  mutable var Current: Action := Noop;
  var SpawnStop: integer := 0;
  var Pending: task := go Current();
  Tasks.Wait(Pending);
  return Cell;
end function;

function Worker(): Handler;
function AddWorker(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  mutable var Cell: integer := 8;
  mutable var Current: Handler := Identity;
  var WorkerStop: integer := 0;
  return Current;
end function;

begin
  mutable var Current: Handler := Identity;
  var Mutated: Handler := Mutating();
  var Combined: Handler := Mix(4);
  var Enclosed: Handler := OuterCell();
  var Recursed: integer := Walk(2);
  var Shadowed: Handler := Shadow();
  var Late: Handler := LateCell();
  var Pending: Handler := PendingDest();
  Apply(Identity);
  var Boxed: integer := NestedBox();
  var CapturedDest: Handler := CaptureDest();
  var Spawned: integer := SpawnProbe();
  var Child: task := go Worker();
  var Stolen: Handler := Tasks.Wait(Child);
  var RootStop: integer := 0;
  Console.WriteLn(Stolen(1));
end program;
