program CellCapturingRoutineAssignment;

uses Std.Console, Std.Tasks;

type Handler = function(Value: integer): integer;

type Action = procedure();

type Pack = record
  Item: Handler;
end record;

function Identity(Value: integer): integer;
begin
  return Value;
end function;

procedure Noop();
begin
end procedure;

var Shared: Handler := Identity;

function Mutating(): Handler;
function AddCell(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  var Cell: integer := 1;
  const Original: Handler := AddCell;
  var Current: Handler := Identity;
  const Frozen: Handler := Identity;
  var Copy: Handler := Identity;
  var Packed: Pack := record
    Item := Identity;
  end;
  const CellStop: integer := 0;
  Cell := Cell + 10;
  WriteLn(Current(0));
  WriteLn(Original(0));
  return Current;
end function;

function Mix(Base: integer): Handler;
function MixBoth(Value: integer): integer;
begin
  Cell := Cell + 1;
  return (Value + Base) + Cell;
end function;
begin
  var Cell: integer := 1;
  var Current: Handler := Identity;
  const MixStop: integer := 0;
  return Current;
end function;

function OuterCell(): Handler;
function Mid(): Handler;
function AddEnclosed(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  const Original: Handler := AddEnclosed;
  var Current: Handler := Identity;
  const EnclosingStop: integer := 0;
  return Current;
end function;
begin
  var Cell: integer := 1;
  return Mid();
end function;

function Walk(N: integer): integer;
function AddAcc(Value: integer): integer;
begin
  Acc := Acc + 1;
  return Value + Acc;
end function;
begin
  var Acc: integer := N;
  var Current: Handler := Identity;
  const WalkStop: integer := 0;
  if N = 0 then
    begin
      return Current(0);
    end;
  else
    begin
      return Walk(N - 1);
    end;
  end if;
end function;

function Shadow(): Handler;
function AddOffset(Value: integer): integer;
begin
  Offset := Offset + 1;
  return Value + Offset;
end function;
begin
  var Offset: integer := 7;
  var Current: Handler := Identity;
  begin
    const Offset: integer := 99;
    const ShadowStop: integer := 0;
    return Current;
  end;
end function;

function LateCell(): Handler;
function AddLate(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  var Current: Handler := Identity;
  const LateStop: integer := 0;
  var Cell: integer := 1;
  const LateReady: integer := 0;
  return Current;
end function;

function PendingDest(): Handler;
function AddPending(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  var Cell: integer := 1;
  const PendingStop: integer := 0;
  var Current: Handler := Identity;
  return Current;
end function;

procedure Apply(Current: Handler);
function AddParam(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  var LocalCurrent: Handler := Current;
  var Cell: integer := 1;
  const ParamStop: integer := 0;
end procedure;

function NestedBox(): integer;
function AddBoxed(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  var Cell: integer := 1;
  var Packed: Pack := record
    Item := Identity;
  end;
  const BoxStop: integer := 0;
  return 0;
end function;

function CaptureDest(): Handler;
function AddCaptured(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
function Touch(): integer;
begin
  return Current(0);
end function;
begin
  var Cell: integer := 1;
  var Source: Handler := Identity;
  var Current: Handler := Identity;
  const Keep: integer := Touch();
  const CaptureDestStop: integer := 0;
  return Current;
end function;

function SpawnProbe(): integer;
procedure RunSpawn();
begin
  Cell := Cell + 1;
end procedure;
begin
  var Cell: integer := 1;
  var Current: Action := Noop;
  const SpawnStop: integer := 0;
  const Pending: task := go Current();
  Wait(Pending);
  return Cell;
end function;

function Worker(): Handler;
function AddWorker(Value: integer): integer;
begin
  Cell := Cell + 1;
  return Value + Cell;
end function;
begin
  var Cell: integer := 8;
  var Current: Handler := Identity;
  const WorkerStop: integer := 0;
  return Current;
end function;

begin
  var Current: Handler := Identity;
  const Mutated: Handler := Mutating();
  const Combined: Handler := Mix(4);
  const Enclosed: Handler := OuterCell();
  const Recursed: integer := Walk(2);
  const Shadowed: Handler := Shadow();
  const Late: Handler := LateCell();
  const Pending: Handler := PendingDest();
  Apply(Identity);
  const Boxed: integer := NestedBox();
  const CapturedDest: Handler := CaptureDest();
  const Spawned: integer := SpawnProbe();
  const Child: task := go Worker();
  const Stolen: Handler := Wait(Child);
  const RootStop: integer := 0;
  WriteLn(Stolen(1));
end.
