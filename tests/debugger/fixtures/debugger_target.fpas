program DebuggerTarget;

uses Std.Console;

type Point = record
  X: integer;
  Y: integer;
end record;

function Factorial(Value: integer): integer;
begin
  if Value <= 1 then
    begin
      return 1;
    end;
  end if;

  return Value * Factorial(Value - 1);
end function;

function MakeCounter(Start: integer): function(): integer;
begin
  var Current: integer := Start;
  return function(): integer begin
    Current := Current + 1;
    return Current;
  end function;
end function;

begin
  const Origin: Point := Point(X := 3, Y := 4);
  const Counter: function(): integer := MakeCounter(10);
  const Values: array of integer := [Origin.X, Origin.Y, Factorial(4)];
  WriteLn(Values);
  WriteLn(Counter());
end.
