program EmptyStorageConstruction;

uses Std.Console;

type Point = record
  X: integer;
  Y: integer;
end record;

type Choice = enum
  Empty;
  Count(Value: integer);
  Pair(Left: integer; Right: integer);
end enum;

type Holder = record
  Count: integer;
  Nested: Point;
  Items: array of integer;
  Scores: dict of string to integer;
  Item: Choice;
  Outcome: result of (integer, string);
  Optional: option of integer;
end record;

type BoxFn = record
  Action: function(): integer;
end record;

function Identity(): integer;
begin
  return 1;
end function;

function MakeInitialState(): Holder;
begin
  return Holder(Count := 1, Nested := Point(X := 2, Y := 3), Items := [10, 20, 30], Scores := ['blue': 4], Item := Choice.Count(5), Outcome := Ok(6), Optional := Some(7));
end function;

var Tick: integer := 0;
var GlobalState: Holder := MakeInitialState();

function Next(): integer;
begin
  Tick := Tick + 1;
  return Tick;
end function;

begin
  var Callback: function(): integer := Identity;
  var State: Holder := MakeInitialState();
  var Origin: Point := Point(X := 8, Y := 9);
  var Items: array of integer := [1, 2, 3];
  var Scores: dict of string to integer := ['red': 1];
  var Selected: Choice := Choice.Empty;
  var Outcome: result of (integer, string) := Ok(1);
  var Optional: option of integer := Some(1);
  var Boxed: BoxFn := BoxFn(Action := Identity);
  const Frozen: integer := 1;
  const StopMarker: integer := 0;
  WriteLn(State.Count);
  WriteLn(State.Nested.X);
  WriteLn(GlobalState.Count);
end.
