program ExpressionMutation;

uses Std.Console as Console;

type Box = record
  Value: integer;
end record;

type Container = record
  Items: array of (Box);
end record;

var GlobalValue: integer := 5;

begin
  var Index: integer := 0;
  var State: Container := Container(Items := [Box(Value := 10)]);
  var Scores: dict of (string, integer) := ['blue': 20];
  Console.WriteLn(GlobalValue);
  Console.WriteLn(State.Items[Index].Value);
  Console.WriteLn(Scores['blue']);
end program;
