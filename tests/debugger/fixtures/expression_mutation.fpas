program ExpressionMutation;

uses Std.Console;

type Box = record
  Value: integer;
end record;

type Container = record
  Items: array of Box;
end record;

var GlobalValue: integer := 5;

begin
  var Index: integer := 0;
  var State: Container := Container(Items := [Box(Value := 10)]);
  var Scores: dict of string to integer := ['blue': 20];
  WriteLn(GlobalValue);
  WriteLn(State.Items[Index].Value);
  WriteLn(Scores['blue']);
end.
