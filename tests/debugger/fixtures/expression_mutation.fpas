program ExpressionMutation;

uses Std.Console as Console;

type Box = record
  Value: integer;
end record;

type Container = record
  Items: array of Box;
end record;

mutable var GlobalValue: integer := 5;

begin
  mutable var Index: integer := 0;
  mutable var State: Container := record
    Items := [record
      Value := 10;
    end record];
  end record;
  mutable var Scores: dict of string to integer := ['blue': 20];
  Console.WriteLn(GlobalValue);
  Console.WriteLn(State.Items[Index].Value);
  Console.WriteLn(Scores['blue']);
end program;
