program ForcedReturn;

uses Std.Console;

function PlusOne(Value: integer): integer;
begin
  return Value + 1;
end function;

function Compute(Value: integer): integer;
begin
  var Offset: integer := 1;
  return Value + Offset;
end function;

function Leaf(Value: integer): integer;
begin
  var Inner: integer := 999;
  WriteLn('leaf');
  return Value + 1;
end function;

function Branch(Value: integer): integer;
begin
  var Local: integer := Value + 10;
  var Nested: integer := Leaf(Local);
  WriteLn('branch');
  return Nested;
end function;

procedure Announce(Message: string);
begin
  WriteLn(Message);
end procedure;

begin
  var Nested: integer := Branch(1);
  WriteLn(Nested);
  var Answer: integer := Compute(41);
  Announce('skip me');
  WriteLn(Answer);
end.
