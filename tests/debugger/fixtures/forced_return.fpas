program ForcedReturn;

uses Std.Console;

function PlusOne(Value: integer): integer;
begin
  return Value + 1;
end function;

function Compute(Value: integer): integer;
begin
  const Offset: integer := 1;
  return Value + Offset;
end function;

function Leaf(Value: integer): integer;
begin
  const Inner: integer := 999;
  WriteLn('leaf');
  return Value + 1;
end function;

function Branch(Value: integer): integer;
begin
  const Local: integer := Value + 10;
  const Nested: integer := Leaf(Local);
  WriteLn('branch');
  return Nested;
end function;

procedure Announce(Message: string);
begin
  WriteLn(Message);
end procedure;

begin
  const Nested: integer := Branch(1);
  WriteLn(Nested);
  const Answer: integer := Compute(41);
  Announce('skip me');
  WriteLn(Answer);
end.
