program FunctionValueAssignment;

uses Std.Console as Console;

type Handler = function(Value: integer): integer;

type NoArgHandler = function(): integer;

function Math(): Handler;
function Transform(Value: integer): integer;
begin
  return Value + 3;
end function;
begin
  return Transform;
end function;

function Stats(): Handler;
function Transform(Value: integer): integer;
begin
  return Value + 4;
end function;
begin
  return Transform;
end function;

type Counter = record
  Base: integer;
end record;

function CounterAdd(Receiver: Counter; Value: integer): integer;
begin
  return Receiver.Base + Value;
end function;

function BindCounter(Receiver: Counter): Handler;
function Add(Value: integer): integer;
begin
  return CounterAdd(Receiver, Value);
end function;
begin
  return Add;
end function;

function AddOne(Value: integer): integer;
begin
  return Value + 1;
end function;

function AddTwo(Value: integer): integer;
begin
  return Value + 2;
end function;

function Answer(): integer;
begin
  return 42;
end function;

function MakeAdder(Amount: integer): Handler;
begin
  return function(Value: integer): integer begin
    return Value + Amount;
  end function;
end function;

begin
  var Current: Handler := AddOne;
  const Backup: Handler := AddTwo;
  const Captured: Handler := MakeAdder(10);
  const Frozen: Handler := AddOne;
  var WrongSignature: NoArgHandler := Answer;
  const Receiver: Counter := Counter(Base := 10);
  const ReceiverAdder: Handler := BindCounter(Receiver);
  const StopMarker: integer := 0;
  Console.WriteLn(Current(1));
  Console.WriteLn(Captured(1));
end program;
