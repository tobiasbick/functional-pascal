program FunctionValueAssignment;

uses Std.Console as Console;

type Handler = function(Value: integer): integer;

type NoArgHandler = function(): integer;

type Math = record
  static function Transform(Value: integer): integer;
  begin
    return Value + 3;
  end function;
end record;

type Stats = record
  static function Transform(Value: integer): integer;
  begin
    return Value + 4;
  end function;
end record;

type Counter = record
  Base: integer;

  function Add(Self: Counter; Value: integer): integer;
  begin
    return Self.Base + Value;
  end function;
end record;

function AddOne(Value: integer): integer;
begin
  return Value + 1;
end function;

function AddTwo(Value: integer): integer;
begin
  return Value + 2;
end function;

function Answer(): integer;
begin
  return 42;
end function;

function MakeAdder(Amount: integer): Handler;
begin
  return function(Value: integer): integer begin
    return Value + Amount;
  end function;
end function;

begin
  mutable var Current: Handler := AddOne;
  var Backup: Handler := AddTwo;
  var Captured: Handler := MakeAdder(10);
  var Frozen: Handler := AddOne;
  mutable var WrongSignature: NoArgHandler := Answer;
  var Receiver: Counter := Counter(Base := 10);
  var StopMarker: integer := 0;
  Console.WriteLn(Current(1));
  Console.WriteLn(Captured(1));
end program;
