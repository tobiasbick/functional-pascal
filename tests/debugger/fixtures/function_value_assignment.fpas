program FunctionValueAssignment;

uses Std.Console;

type
  Handler = function(Value: integer): integer;
  NoArgHandler = function(): integer;
  Math = record
    static function Transform(Value: integer): integer;
    begin
      return Value + 3
    end;
  end;
  Stats = record
    static function Transform(Value: integer): integer;
    begin
      return Value + 4
    end;
  end;
  Counter = record
    Base: integer;

    function Add(Self: Counter; Value: integer): integer;
    begin
      return Self.Base + Value
    end;
  end;

function AddOne(Value: integer): integer;
begin
  return Value + 1
end;

function AddTwo(Value: integer): integer;
begin
  return Value + 2
end;

function Answer(): integer;
begin
  return 42
end;

function MakeAdder(Amount: integer): Handler;
begin
  return function(Value: integer): integer begin
    return Value + Amount
  end
end;

begin
  mutable var Current: Handler := AddOne;
  var Backup: Handler := AddTwo;
  var Captured: Handler := MakeAdder(10);
  var Frozen: Handler := AddOne;
  mutable var WrongSignature: NoArgHandler := Answer;
  var Receiver: Counter := record
    Base := 10;
  end;
  var StopMarker: integer := 0;
  WriteLn(Current(1));
  WriteLn(Captured(1))
end.
