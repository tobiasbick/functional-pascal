program PayloadMutation;

uses Std.Console as Console;

type Point = record
  X: integer;
  Y: integer;
end record;

type Choice = enum
  Count(Value: integer);
  Pair(Left: integer; Right: integer);
  Nested(Item: Point);
end enum;

type Box = record
  Items: array of (integer);
  Scores: dict of (string, integer);
end record;

function ChoiceValue(Item: Choice): integer;
begin
  case Item of
    when Choice.Count(const Value):
      begin
        return Value;
      end;
    when Choice.Pair(const Left, const Right):
      begin
        return Left + Right;
      end;
    when Choice.Nested(const Item):
      begin
        return Item.X + Item.Y;
      end;
  end case;
end function;

begin
  var Origin: Point := Point(X := 4, Y := 5);
  var Selected: Choice := Choice.Count(1);
  var PairValue: Choice := Choice.Pair(2, 3);
  var NestedValue: Choice := Choice.Nested(Origin);
  var Outcome: Result of (integer, string) := Result.Ok(6);
  var Failed: Result of (integer, string) := Result.Error('old');
  var Optional: Option of (integer) := Option.Some(7);
  var Missing: Option of (integer) := Option.None;
  var PackedBox: Box := Box(Items := [8, 9], Scores := ['blue': 10]);
  var Packed: Result of (Box, string) := Result.Ok(PackedBox);
  var NestedOk: Result of (integer, string) := Result.Ok(11);
  var NestedResult: Option of (Result of (integer, string)) := Option.Some(NestedOk);
  const Fixed: Choice := Choice.Count(99);
  const StopMarker: integer := 0;
  Console.WriteLn(ChoiceValue(Selected));
  Console.WriteLn(ChoiceValue(PairValue));
  Console.WriteLn(ChoiceValue(NestedValue));
  case Outcome of
    when Result.Ok(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when Result.Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case Failed of
    when Result.Ok(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when Result.Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case Optional of
    when Option.Some(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when Option.None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  case Packed of
    when Result.Ok(const Value):
      begin
        Console.WriteLn(Value.Items[1]);
        Console.WriteLn(Value.Scores['blue']);
      end;
    when Result.Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case NestedResult of
    when Option.Some(const Inner):
      begin
        case Inner of
          when Result.Ok(const Value):
            begin
              Console.WriteLn(Value);
            end;
          when Result.Error(const Message):
            begin
              Console.WriteLn(Message);
            end;
        end case;
      end;
    when Option.None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  Console.WriteLn(ChoiceValue(Fixed));
end program;
