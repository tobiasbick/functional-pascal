program PayloadMutation;

uses Std.Console;

type Point = record
  X: integer;
  Y: integer;
end record;

type Choice = enum
  Count(Value: integer);
  Pair(Left: integer; Right: integer);
  Nested(Item: Point);
end enum;

type Box = record
  Items: array of integer;
  Scores: dict of string to integer;
end record;

function ChoiceValue(Item: Choice): integer;
begin
  case Item of
    when Choice.Count(const Value):
      begin
        return Value;
      end;
    when Choice.Pair(const Left, const Right):
      begin
        return Left + Right;
      end;
    when Choice.Nested(const Item):
      begin
        return Item.X + Item.Y;
      end;
  end case;
end function;

begin
  var Origin: Point := Point(X := 4, Y := 5);
  var Selected: Choice := Choice.Count(1);
  var PairValue: Choice := Choice.Pair(2, 3);
  var NestedValue: Choice := Choice.Nested(Origin);
  var Outcome: result of (integer, string) := Ok(6);
  var Failed: result of (integer, string) := Error('old');
  var Optional: option of integer := Some(7);
  var Missing: option of integer := None;
  var PackedBox: Box := Box(Items := [8, 9], Scores := ['blue': 10]);
  var Packed: result of (Box, string) := Ok(PackedBox);
  var NestedOk: result of (integer, string) := Ok(11);
  var NestedResult: option of result of (integer, string) := Some(NestedOk);
  const Fixed: Choice := Choice.Count(99);
  const StopMarker: integer := 0;
  WriteLn(ChoiceValue(Selected));
  WriteLn(ChoiceValue(PairValue));
  WriteLn(ChoiceValue(NestedValue));
  case Outcome of
    when Ok(const Value):
      begin
        WriteLn(Value);
      end;
    when Error(const Message):
      begin
        WriteLn(Message);
      end;
  end case;

  case Failed of
    when Ok(const Value):
      begin
        WriteLn(Value);
      end;
    when Error(const Message):
      begin
        WriteLn(Message);
      end;
  end case;

  case Optional of
    when Some(const Value):
      begin
        WriteLn(Value);
      end;
    when None:
      begin
        WriteLn(0);
      end;
  end case;

  case Packed of
    when Ok(const Value):
      begin
        WriteLn(Value.Items[1]);
        WriteLn(Value.Scores['blue']);
      end;
    when Error(const Message):
      begin
        WriteLn(Message);
      end;
  end case;

  case NestedResult of
    when Some(const Inner):
      begin
        case Inner of
          when Ok(const Value):
            begin
              WriteLn(Value);
            end;
          when Error(const Message):
            begin
              WriteLn(Message);
            end;
        end case;
      end;
    when None:
      begin
        WriteLn(0);
      end;
  end case;

  WriteLn(ChoiceValue(Fixed));
end.
