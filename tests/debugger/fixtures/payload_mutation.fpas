program PayloadMutation;

uses Std.Console as Console;

type Point = record
  X: integer;
  Y: integer;
end record;

type Choice = enum
  Count(Value: integer);
  Pair(Left: integer; Right: integer);
  Nested(Item: Point);
end enum;

type Box = record
  Items: array of integer;
  Scores: dict of string to integer;
end record;

function ChoiceValue(Item: Choice): integer;
begin
  case Item of
    when Choice.Count(Value):
      begin
        return Value;
      end;
    when Choice.Pair(Left, Right):
      begin
        return Left + Right;
      end;
    when Choice.Nested(Item):
      begin
        return Item.X + Item.Y;
      end;
  end case;
end function;

begin
  mutable var Origin: Point := record
    X := 4;
    Y := 5;
  end record;
  mutable var Selected: Choice := Choice.Count(1);
  mutable var PairValue: Choice := Choice.Pair(2, 3);
  mutable var NestedValue: Choice := Choice.Nested(Origin);
  mutable var Outcome: result of integer, string := Ok(6);
  mutable var Failed: result of integer, string := Error('old');
  mutable var Optional: option of integer := Some(7);
  mutable var Missing: option of integer := None;
  mutable var PackedBox: Box := record
    Items := [8, 9];
    Scores := ['blue': 10];
  end record;
  mutable var Packed: result of Box, string := Ok(PackedBox);
  mutable var NestedOk: result of integer, string := Ok(11);
  mutable var NestedResult: option of result of integer, string := Some(NestedOk);
  var Fixed: Choice := Choice.Count(99);
  var StopMarker: integer := 0;
  Console.WriteLn(ChoiceValue(Selected));
  Console.WriteLn(ChoiceValue(PairValue));
  Console.WriteLn(ChoiceValue(NestedValue));
  case Outcome of
    when Ok(Value):
      begin
        Console.WriteLn(Value);
      end;
    when Error(Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case Failed of
    when Ok(Value):
      begin
        Console.WriteLn(Value);
      end;
    when Error(Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case Optional of
    when Some(Value):
      begin
        Console.WriteLn(Value);
      end;
    when None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  case Packed of
    when Ok(Value):
      begin
        Console.WriteLn(Value.Items[1]);
        Console.WriteLn(Value.Scores['blue']);
      end;
    when Error(Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case NestedResult of
    when Some(Inner):
      begin
        case Inner of
          when Ok(Value):
            begin
              Console.WriteLn(Value);
            end;
          when Error(Message):
            begin
              Console.WriteLn(Message);
            end;
        end case;
      end;
    when None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  Console.WriteLn(ChoiceValue(Fixed));
end program;
