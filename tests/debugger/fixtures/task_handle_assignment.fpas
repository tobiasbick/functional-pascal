program TaskHandleAssignment;

uses Std.Console, Std.Tasks;

function Seven(): integer;
begin
  return 7;
end function;

function Nine(): integer;
begin
  return 9;
end function;

function Label(): string;
begin
  return 'nope';
end function;

begin
  scope
    const Pending: task of integer := go Seven();
    var Current: task of integer := go Nine();
    const Frozen: task of integer := go Seven();
    const Wrong: task of string := go Label();
    var StopMarker: integer := 0;
    StopMarker := StopMarker + 1;
    WriteLn(Wait(Current));
  end scope;
end.
