program TaskHandleAssignment;

uses Std.Console, Std.Tasks;

function Seven(): integer;
begin
  return 7;
end function;

function Nine(): integer;
begin
  return 9;
end function;

function Label(): string;
begin
  return 'nope';
end function;

begin
  const Pending: task := go Seven();
  var Current: task := go Nine();
  const Frozen: task := go Seven();
  const Wrong: task := go Label();
  var StopMarker: integer := 0;
  StopMarker := StopMarker + 1;
  WriteLn(Wait(Current));
end.
