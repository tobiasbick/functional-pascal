program UninitializedAssignment;

uses Std.Console;

type Point = record
  X: integer;
  Y: integer;
end record;

var GlobalCount: integer := 99;

begin
  var Count: integer := 1;
  var Flag: boolean := false;
  var Origin: Point := record
    X := 3;
    Y := 4;
  end;
  const Frozen: integer := 2;
  WriteLn(Count);
  WriteLn(GlobalCount);
  if Flag then
    begin
      WriteLn(1);
    end;
  else
    begin
      WriteLn(0);
    end;
  end if;

  WriteLn(Origin.X);
  WriteLn(Frozen);
end.
