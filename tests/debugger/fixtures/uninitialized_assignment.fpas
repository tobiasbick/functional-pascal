program UninitializedAssignment;

uses Std.Console as Console;

type Point = record
  X: integer;
  Y: integer;
end record;

mutable var GlobalCount: integer := 99;

begin
  mutable var Count: integer := 1;
  mutable var Flag: boolean := false;
  mutable var Origin: Point := Point(X := 3, Y := 4);
  var Frozen: integer := 2;
  Console.WriteLn(Count);
  Console.WriteLn(GlobalCount);
  if Flag then
    begin
      Console.WriteLn(1);
    end;
  else
    begin
      Console.WriteLn(0);
    end;
  end if;

  Console.WriteLn(Origin.X);
  Console.WriteLn(Frozen);
end program;
