program VariantConstruction;

uses Std.Console;

type Point = record
  X: integer;
  Y: integer;
end record;

type Choice = enum
  Empty;
  Count(Value: integer);
  Pair(Left: integer; Right: integer);
  Nested(Item: Point);
end enum;

type Holder = record
  Item: Choice;
end record;

type Outer = enum
  First(Item: Choice);
  Second(Item: Choice);
end enum;

var GlobalChoice: Choice := Choice.Empty;
var Tick: integer := 0;

function ChoiceValue(Item: Choice): integer;
begin
  case Item of
    when Choice.Empty:
      begin
        return 0;
      end;
    when Choice.Count(const Value):
      begin
        return Value;
      end;
    when Choice.Pair(const Left, const Right):
      begin
        return Left + Right;
      end;
    when Choice.Nested(const Item):
      begin
        return Item.X + Item.Y;
      end;
  end case;
end function;

function Next(): integer;
begin
  Tick := Tick + 1;
  return Tick;
end function;

function ResultValue(Item: result of (integer, string)): integer;
begin
  case Item of
    when Ok(const Value):
      begin
        return Value;
      end;
    when Error(const Message):
      begin
        return -1;
      end;
  end case;
end function;

function WrappedChoiceValue(Item: result of (Choice, string)): integer;
begin
  case Item of
    when Ok(const Value):
      begin
        return ChoiceValue(Value);
      end;
    when Error(const Message):
      begin
        return -1;
      end;
  end case;
end function;

function OuterChoiceValue(Item: Outer): integer;
begin
  case Item of
    when Outer.First(const Value), Outer.Second(const Value):
      begin
        return ChoiceValue(Value);
      end;
  end case;
end function;

begin
  var Origin: Point := Point(X := 4, Y := 5);
  var Selected: Choice := Choice.Empty;
  var PairValue: Choice := Choice.Pair(2, 3);
  var EmptyValue: Choice := Choice.Empty;
  var NestedValue: Choice := Choice.Nested(Origin);
  var Outcome: result of (integer, string) := Ok(6);
  var Failed: result of (integer, string) := Error('old');
  var Optional: option of integer := Some(7);
  var Missing: option of integer := None;
  var PackedHolder: Holder := Holder(Item := Choice.Empty);
  var Items: array of Choice := [Choice.Empty];
  var Scores: dict of string to Choice := ['blue': Choice.Empty];
  var WrappedChoice: result of (Choice, string) := Ok(Choice.Empty);
  var WrappedChoices: array of result of (Choice, string) := [Ok(Choice.Empty)];
  var OuterValue: Outer := Outer.First(Choice.Empty);
  const Fixed: Choice := Choice.Count(99);
  const StopMarker: integer := 0;
  WriteLn(ChoiceValue(Selected));
  WriteLn(ChoiceValue(PackedHolder.Item));
  WriteLn(ChoiceValue(Items[0]));
  WriteLn(ChoiceValue(Scores['blue']));
  WriteLn(ChoiceValue(GlobalChoice));
  WriteLn(ResultValue(Failed));
  WriteLn(WrappedChoiceValue(WrappedChoice));
  WriteLn(WrappedChoiceValue(WrappedChoices[0]));
  WriteLn(OuterChoiceValue(OuterValue));
  WriteLn(ChoiceValue(Fixed));
end.
