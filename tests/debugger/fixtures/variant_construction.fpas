program VariantConstruction;

uses Std.Console;

type Point = record
  X: integer;
  Y: integer;
end record;

type Choice = enum
  Empty;
  Count(Value: integer);
  Pair(Left: integer; Right: integer);
  Nested(Item: Point);
end enum;

type Holder = record
  Item: Choice;
end record;

type Outer = enum
  First(Item: Choice);
  Second(Item: Choice);
end enum;

mutable var GlobalChoice: Choice := Choice.Empty;
mutable var Tick: integer := 0;

function ChoiceValue(Item: Choice): integer;
begin
  case Item of
    when Choice.Empty:
      begin
        return 0;
      end;
    when Choice.Count(Value):
      begin
        return Value;
      end;
    when Choice.Pair(Left, Right):
      begin
        return Left + Right;
      end;
    when Choice.Nested(Item):
      begin
        return Item.X + Item.Y;
      end;
  end case;
end function;

function Next(): integer;
begin
  Tick := Tick + 1;
  return Tick;
end function;

function ResultValue(Item: result of integer, string): integer;
begin
  case Item of
    when Ok(Value):
      begin
        return Value;
      end;
    when Error(Message):
      begin
        return -1;
      end;
  end case;
end function;

function WrappedChoiceValue(Item: result of Choice, string): integer;
begin
  case Item of
    when Ok(Value):
      begin
        return ChoiceValue(Value);
      end;
    when Error(Message):
      begin
        return -1;
      end;
  end case;
end function;

function OuterChoiceValue(Item: Outer): integer;
begin
  case Item of
    when Outer.First(Value), Outer.Second(Value):
      begin
        return ChoiceValue(Value);
      end;
  end case;
end function;

begin
  mutable var Origin: Point := record
    X := 4;
    Y := 5;
  end;
  mutable var Selected: Choice := Choice.Empty;
  mutable var PairValue: Choice := Choice.Pair(2, 3);
  mutable var EmptyValue: Choice := Choice.Empty;
  mutable var NestedValue: Choice := Choice.Nested(Origin);
  mutable var Outcome: result of integer, string := Ok(6);
  mutable var Failed: result of integer, string := Error('old');
  mutable var Optional: option of integer := Some(7);
  mutable var Missing: option of integer := None;
  mutable var PackedHolder: Holder := record
    Item := Choice.Empty;
  end;
  mutable var Items: array of Choice := [Choice.Empty];
  mutable var Scores: dict of string to Choice := ['blue': Choice.Empty];
  mutable var WrappedChoice: result of Choice, string := Ok(Choice.Empty);
  mutable var WrappedChoices: array of result of Choice, string := [Ok(Choice.Empty)];
  mutable var OuterValue: Outer := Outer.First(Choice.Empty);
  var Fixed: Choice := Choice.Count(99);
  var StopMarker: integer := 0;
  WriteLn(ChoiceValue(Selected));
  WriteLn(ChoiceValue(PackedHolder.Item));
  WriteLn(ChoiceValue(Items[0]));
  WriteLn(ChoiceValue(Scores['blue']));
  WriteLn(ChoiceValue(GlobalChoice));
  WriteLn(ResultValue(Failed));
  WriteLn(WrappedChoiceValue(WrappedChoice));
  WriteLn(WrappedChoiceValue(WrappedChoices[0]));
  WriteLn(OuterChoiceValue(OuterValue));
  WriteLn(ChoiceValue(Fixed));
end.
