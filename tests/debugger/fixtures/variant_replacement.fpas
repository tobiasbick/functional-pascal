program VariantReplacement;

uses Std.Console as Console;

type Point = record
  X: integer;
  Y: integer;
end record;

type Choice = enum
  Empty;
  Count(Value: integer);
  Pair(Left: integer; Right: integer);
  Nested(Item: Point);
end enum;

type Holder = record
  Item: Choice;
end record;

var GlobalChoice: Choice := Choice.Count(15);

function ChoiceValue(Item: Choice): integer;
begin
  case Item of
    when Choice.Empty:
      begin
        return 0;
      end;
    when Choice.Count(const Value):
      begin
        return Value;
      end;
    when Choice.Pair(const Left, const Right):
      begin
        return Left + Right;
      end;
    when Choice.Nested(const Item):
      begin
        return Item.X + Item.Y;
      end;
  end case;
end function;

begin
  var Origin: Point := Point(X := 4, Y := 5);
  var Selected: Choice := Choice.Count(1);
  var PairValue: Choice := Choice.Pair(2, 3);
  var EmptyValue: Choice := Choice.Empty;
  var NestedValue: Choice := Choice.Nested(Origin);
  var Outcome: result of (integer, string) := Ok(6);
  var Failed: result of (integer, string) := Error('old');
  var Optional: option of integer := Some(7);
  var Missing: option of integer := None;
  var Packed: result of (array of integer, string) := Ok([8, 9]);
  var NestedOk: result of (integer, string) := Ok(11);
  var NestedResult: option of result of (integer, string) := Some(NestedOk);
  var PackedHolder: Holder := Holder(Item := Choice.Count(12));
  var Items: array of Choice := [Choice.Count(13)];
  var Scores: dict of string to Choice := ['blue': Choice.Count(14)];
  const Fixed: Choice := Choice.Count(99);
  const StopMarker: integer := 0;
  Console.WriteLn(ChoiceValue(Selected));
  Console.WriteLn(ChoiceValue(PairValue));
  Console.WriteLn(ChoiceValue(EmptyValue));
  Console.WriteLn(ChoiceValue(NestedValue));
  case Outcome of
    when Ok(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case Failed of
    when Ok(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case Optional of
    when Some(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  case Missing of
    when Some(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  case Packed of
    when Ok(const Value):
      begin
        Console.WriteLn(Value[1]);
      end;
    when Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case NestedResult of
    when Some(const Inner):
      begin
        case Inner of
          when Ok(const Value):
            begin
              Console.WriteLn(Value);
            end;
          when Error(const Message):
            begin
              Console.WriteLn(Message);
            end;
        end case;
      end;
    when None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  Console.WriteLn(ChoiceValue(PackedHolder.Item));
  Console.WriteLn(ChoiceValue(Items[0]));
  Console.WriteLn(ChoiceValue(Scores['blue']));
  Console.WriteLn(ChoiceValue(GlobalChoice));
  Console.WriteLn(ChoiceValue(Fixed));
end.
