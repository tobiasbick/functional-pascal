program VariantReplacement;

uses Std.Console;

type Point = record
  X: integer;
  Y: integer;
end record;

type Choice = enum
  Empty;
  Count(Value: integer);
  Pair(Left: integer; Right: integer);
  Nested(Item: Point);
end enum;

type Holder = record
  Item: Choice;
end record;

mutable var GlobalChoice: Choice := Choice.Count(15);

function ChoiceValue(Item: Choice): integer;
begin
  case Item of
    when Choice.Empty:
      begin
        return 0;
      end;
    when Choice.Count(Value):
      begin
        return Value;
      end;
    when Choice.Pair(Left, Right):
      begin
        return Left + Right;
      end;
    when Choice.Nested(Item):
      begin
        return Item.X + Item.Y;
      end;
  end case;
end function;

begin
  mutable var Origin: Point := record
    X := 4;
    Y := 5;
  end;
  mutable var Selected: Choice := Choice.Count(1);
  mutable var PairValue: Choice := Choice.Pair(2, 3);
  mutable var EmptyValue: Choice := Choice.Empty;
  mutable var NestedValue: Choice := Choice.Nested(Origin);
  mutable var Outcome: result of integer, string := Ok(6);
  mutable var Failed: result of integer, string := Error('old');
  mutable var Optional: option of integer := Some(7);
  mutable var Missing: option of integer := None;
  mutable var Packed: result of array of integer, string := Ok([8, 9]);
  mutable var NestedOk: result of integer, string := Ok(11);
  mutable var NestedResult: option of result of integer, string := Some(NestedOk);
  mutable var PackedHolder: Holder := record
    Item := Choice.Count(12);
  end;
  mutable var Items: array of Choice := [Choice.Count(13)];
  mutable var Scores: dict of string to Choice := ['blue': Choice.Count(14)];
  var Fixed: Choice := Choice.Count(99);
  var StopMarker: integer := 0;
  WriteLn(ChoiceValue(Selected));
  WriteLn(ChoiceValue(PairValue));
  WriteLn(ChoiceValue(EmptyValue));
  WriteLn(ChoiceValue(NestedValue));
  case Outcome of
    when Ok(Value):
      begin
        WriteLn(Value);
      end;
    when Error(Message):
      begin
        WriteLn(Message);
      end;
  end case;

  case Failed of
    when Ok(Value):
      begin
        WriteLn(Value);
      end;
    when Error(Message):
      begin
        WriteLn(Message);
      end;
  end case;

  case Optional of
    when Some(Value):
      begin
        WriteLn(Value);
      end;
    when None:
      begin
        WriteLn(0);
      end;
  end case;

  case Missing of
    when Some(Value):
      begin
        WriteLn(Value);
      end;
    when None:
      begin
        WriteLn(0);
      end;
  end case;

  case Packed of
    when Ok(Value):
      begin
        WriteLn(Value[1]);
      end;
    when Error(Message):
      begin
        WriteLn(Message);
      end;
  end case;

  case NestedResult of
    when Some(Inner):
      begin
        case Inner of
          when Ok(Value):
            begin
              WriteLn(Value);
            end;
          when Error(Message):
            begin
              WriteLn(Message);
            end;
        end case;
      end;
    when None:
      begin
        WriteLn(0);
      end;
  end case;

  WriteLn(ChoiceValue(PackedHolder.Item));
  WriteLn(ChoiceValue(Items[0]));
  WriteLn(ChoiceValue(Scores['blue']));
  WriteLn(ChoiceValue(GlobalChoice));
  WriteLn(ChoiceValue(Fixed));
end.
