program VariantTransition;

uses Std.Console as Console;

type Point = record
  X: integer;
  Y: integer;
end record;

type Choice = enum
  Empty;
  Count(Value: integer);
  Pair(Left: integer; Right: integer);
  Nested(Item: Point);
end enum;

type Holder = record
  Item: Choice;
end record;

mutable var GlobalChoice: Choice := Choice.Empty;

function ChoiceValue(Item: Choice): integer;
begin
  case Item of
    when Choice.Empty:
      begin
        return 0;
      end;
    when Choice.Count(const Value):
      begin
        return Value;
      end;
    when Choice.Pair(const Left, const Right):
      begin
        return Left + Right;
      end;
    when Choice.Nested(const Item):
      begin
        return Item.X + Item.Y;
      end;
  end case;
end function;

begin
  mutable var Origin: Point := Point(X := 4, Y := 5);
  mutable var Selected: Choice := Choice.Empty;
  mutable var PairValue: Choice := Choice.Pair(2, 3);
  mutable var EmptyValue: Choice := Choice.Empty;
  mutable var NestedValue: Choice := Choice.Nested(Origin);
  mutable var Outcome: Result of (integer, string) := Result.Ok(6);
  mutable var Failed: Result of (integer, string) := Result.Error('old');
  mutable var Optional: Option of (integer) := Option.Some(7);
  mutable var Missing: Option of (integer) := Option.None;
  mutable var Packed: Result of (array of (integer), string) := Result.Ok([8, 9]);
  mutable var NestedOk: Result of (integer, string) := Result.Ok(11);
  mutable var NestedResult: Option of (Result of (integer, string)) := Option.Some(NestedOk);
  mutable var PackedHolder: Holder := Holder(Item := Choice.Empty);
  mutable var Items: array of (Choice) := [Choice.Empty];
  mutable var Scores: dict of (string, Choice) := ['blue': Choice.Empty];
  var Fixed: Choice := Choice.Count(99);
  var StopMarker: integer := 0;
  Console.WriteLn(ChoiceValue(Selected));
  Console.WriteLn(ChoiceValue(PairValue));
  Console.WriteLn(ChoiceValue(EmptyValue));
  Console.WriteLn(ChoiceValue(NestedValue));
  case Outcome of
    when Result.Ok(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when Result.Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case Failed of
    when Result.Ok(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when Result.Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case Optional of
    when Option.Some(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when Option.None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  case Missing of
    when Option.Some(const Value):
      begin
        Console.WriteLn(Value);
      end;
    when Option.None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  case Packed of
    when Result.Ok(const Value):
      begin
        Console.WriteLn(Value[1]);
      end;
    when Result.Error(const Message):
      begin
        Console.WriteLn(Message);
      end;
  end case;

  case NestedResult of
    when Option.Some(const Inner):
      begin
        case Inner of
          when Result.Ok(const Value):
            begin
              Console.WriteLn(Value);
            end;
          when Result.Error(const Message):
            begin
              Console.WriteLn(Message);
            end;
        end case;
      end;
    when Option.None:
      begin
        Console.WriteLn(0);
      end;
  end case;

  Console.WriteLn(ChoiceValue(PackedHolder.Item));
  Console.WriteLn(ChoiceValue(Items[0]));
  Console.WriteLn(ChoiceValue(Scores['blue']));
  Console.WriteLn(ChoiceValue(GlobalChoice));
  Console.WriteLn(ChoiceValue(Fixed));
end program;
