program AcpTerminalFixture;

uses Std.Os.Args as Args, Std.Console as Console, Std.Io.Fs as Fs, Std.Time as Time;

begin
  const Marker := Args.ParamStr(0);
  Console.WriteText('α');
  Console.WriteText('😀');
  Console.WriteText('END');
  discard Fs.WriteText(Marker + '.ready', 'ready').Unwrap();
  while not Fs.IsFile(Marker) do
    Time.Sleep(1);
  end while;

  if Args.ParamStr(1) = 'fail' then
    panic('Expected terminal failure');
  end if;
end.
