program IdeDiagnosticParserTest;

uses Ide.Diagnostic.Model, Ide.Diagnostic.Parser, Std.Array, Std.Str, Std.Test;

begin
  var NewLine: string := Std.Str.Chr(10);
  mutable var RelativeText: string := 'stderr:';
  RelativeText := (RelativeText + NewLine) + './src/main.fpas:3:7: error[F2003]: missing';
  RelativeText := (RelativeText + NewLine) + '  help: declare it';
  RelativeText := (RelativeText + NewLine) + '/repo/src/main.fpas:8:2: warning[F9000]: warning';
  RelativeText := (RelativeText + NewLine) + '/repo/src/other.fpas:1:1: error[F0001]: other';
  var Relative: array of IdeDiagnostic := ParseIdeDiagnostics(RelativeText, '/repo/src/main.fpas');
  AssertEquals(2, Std.Array.Length(Relative));
  AssertEquals('./src/main.fpas', Relative[0].Path);
  AssertEquals(3, Relative[0].Line);
  AssertEquals(7, Relative[0].Column);
  AssertEquals(1, Relative[0].MessageLine);
  AssertEquals(8, Relative[1].Line);
  AssertEquals(2, Relative[1].Column);
  AssertEquals(3, Relative[1].MessageLine);
  var WindowsText: string := 'D:\Work\MAIN.fpas:5:4: error[F1001]: bad';
  var Windows: array of IdeDiagnostic := ParseIdeDiagnostics(WindowsText, 'd:/work/main.fpas');
  AssertEquals(1, Std.Array.Length(Windows));
  AssertEquals(5, Windows[0].Line);
  AssertEquals(4, Windows[0].Column);
  var WrappedText: string := 'Cannot build test program `D:\Work\MAIN.fpas`: 6:9: error[F2003]: bad';
  var Wrapped: array of IdeDiagnostic := ParseIdeDiagnostics(WrappedText, 'd:/work/main.fpas');
  AssertEquals(1, Std.Array.Length(Wrapped));
  AssertEquals('D:\Work\MAIN.fpas', Wrapped[0].Path);
  AssertEquals(6, Wrapped[0].Line);
  AssertEquals(9, Wrapped[0].Column);
  mutable var InvalidText: string := 'main.fpas:0:1: error[F1]: zero';
  InvalidText := (InvalidText + NewLine) + 'main.fpas:1:0: error[F1]: zero';
  InvalidText := (InvalidText + NewLine) + 'main.fpas:x:2: error[F1]: text';
  InvalidText := (InvalidText + NewLine) + 'main.fpas:1234567890:2: error[F1]: huge';
  InvalidText := (InvalidText + NewLine) + 'not-main.fpas:1:2: error[F1]: suffix';
  InvalidText := (InvalidText + NewLine) + 'main.fpas:1:2: error[F1] missing separator';
  InvalidText := (InvalidText + NewLine) + 'arbitrary process output';
  var Invalid: array of IdeDiagnostic := ParseIdeDiagnostics(InvalidText, '/repo/main.fpas');
  AssertEquals(0, Std.Array.Length(Invalid))
end.
