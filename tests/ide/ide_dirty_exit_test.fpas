program IdeDirtyExitTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.Document.Model, Ide.Test.Files, Std.Str,
  Std.Test, Std.Tui;

const
  DocumentPath: string := IdeTestScratch + '/dirty_exit.fpas';
  UntitledPath: string := IdeTestScratch + '/dirty_exit_untitled.fpas';

function DirtyState(Path: option of string; Text: string; Cmd: TuiCmdOutput): IdeModel;
begin
  return UpdateIde(InitialIdeModel(Path), TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), Text, Std.Str.Length(Text), TuiPoint.Create(0, 0)), Cmd)
end;

function RequestExit(State: IdeModel; Cmd: TuiCmdOutput): IdeModel;
begin
  return UpdateIde(State, TuiMsgAction(ExitControlId(), ExitAction()), Cmd)
end;

begin
  EnsureIdeTestScratch();
  WriteIdeTestFile(DocumentPath, 'saved');
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  var Clean: IdeModel := InitialIdeModel(Some(DocumentPath));
  var CleanExit: IdeModel := RequestExit(Clean, Cmd);
  AssertEquals(Clean.Document.Text, CleanExit.Document.Text);
  AssertTrue(Cmd.Read() = TuiCmd.Quit);
  Cmd.Reset();
  var Dirty: IdeModel := DirtyState(Some(DocumentPath), 'changed', Cmd);
  var ConfirmCancel: IdeModel := RequestExit(Dirty, Cmd);
  var Canceled: IdeModel := UpdateIde(ConfirmCancel, TuiMsgAction(DirtyCancelControlId(), DirtyCancelAction()), Cmd);
  AssertTrue(IsIdeDocumentDirty(Canceled.Document));
  AssertTrue(Cmd.Read() = TuiCmd.NoCommand);
  Cmd.Reset();
  var ConfirmDiscard: IdeModel := RequestExit(Dirty, Cmd);
  var Discarded: IdeModel := UpdateIde(ConfirmDiscard, TuiMsgAction(DirtyDiscardControlId(), DirtyDiscardAction()), Cmd);
  AssertEquals(Dirty.Document.Text, Discarded.Document.Text);
  AssertTrue(Cmd.Read() = TuiCmd.Quit);
  Cmd.Reset();
  var ConfirmSave: IdeModel := RequestExit(Dirty, Cmd);
  var Saved: IdeModel := UpdateIde(ConfirmSave, TuiMsgAction(DirtySaveControlId(), DirtySaveAction()), Cmd);
  AssertEquals('changed', ReadIdeTestFile(DocumentPath));
  AssertFalse(IsIdeDocumentDirty(Saved.Document));
  AssertTrue(Cmd.Read() = TuiCmd.Quit);
  Cmd.Reset();
  var Untitled: IdeModel := DirtyState(None, 'untitled', Cmd);
  var ConfirmUntitled: IdeModel := RequestExit(Untitled, Cmd);
  var SaveAs: IdeModel := UpdateIde(ConfirmUntitled, TuiMsgAction(DirtySaveControlId(), DirtySaveAction()), Cmd);
  case SaveAs.Dialog of
    IdeDialog.SavePath(PathText, Caret, Pending):
    begin
      AssertTrue(Pending = IdePendingCommand.ExitApplication)
    end;
    IdeDialog.NoDialog, IdeDialog.OpenPath(PathText, Caret), IdeDialog.ConfirmDirty(Pending):
    begin
      Fail('untitled dirty Exit did not continue to Save As')
    end
  end;
  var WithPath: IdeModel := UpdateIde(SaveAs, TuiMsgTextChanged(DialogPathControlId(), DialogPathChangedAction(), UntitledPath, Std.Str.Length(UntitledPath)), Cmd);
  Cmd.Reset();
  var SavedUntitled: IdeModel := UpdateIde(WithPath, TuiMsgAction(DialogAcceptControlId(), DialogAcceptAction()), Cmd);
  AssertEquals('untitled', ReadIdeTestFile(UntitledPath));
  AssertFalse(IsIdeDocumentDirty(SavedUntitled.Document));
  AssertTrue(Cmd.Read() = TuiCmd.Quit);
  Cmd.Reset();
  var OpenDialog: IdeModel := UpdateIde(InitialIdeModel(None), TuiMsgAction(OpenControlId(), OpenAction()), Cmd);
  var EscapeCanceled: IdeModel := UpdateIde(OpenDialog, TuiMsg.QuitRequested, Cmd);
  AssertTrue(Cmd.Read() = TuiCmd.NoCommand);
  case EscapeCanceled.Dialog of
    IdeDialog.NoDialog:
    begin
    end;
    IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending), IdeDialog.ConfirmDirty(Pending):
    begin
      Fail('Escape did not cancel the active dialog')
    end
  end
end.
