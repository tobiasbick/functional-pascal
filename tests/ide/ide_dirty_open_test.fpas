program IdeDirtyOpenTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.Document.Model, Ide.Test.Files, Std.Str,
  Std.Test, Std.Tui;

const
  DocumentPath: string := IdeTestScratch + '/dirty_open.fpas';

function DirtyState(Path: string; Text: string; Cmd: TuiCmdOutput): IdeModel;
begin
  var Initial: IdeModel := InitialIdeModel(Some(Path));
  return UpdateIde(Initial, TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), Text, Std.Str.Length(Text), TuiPoint.Create(0, 0)), Cmd)
end;

function RequestOpen(State: IdeModel; Cmd: TuiCmdOutput): IdeModel;
begin
  return UpdateIde(State, TuiMsgAction(OpenControlId(), OpenAction()), Cmd)
end;

begin
  EnsureIdeTestScratch();
  WriteIdeTestFile(DocumentPath, 'saved');
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  var Dirty: IdeModel := DirtyState(DocumentPath, 'changed', Cmd);
  var ConfirmCancel: IdeModel := RequestOpen(Dirty, Cmd);
  var Canceled: IdeModel := UpdateIde(ConfirmCancel, TuiMsgAction(DirtyCancelControlId(), DirtyCancelAction()), Cmd);
  AssertEquals('changed', Canceled.Document.Text);
  AssertTrue(IsIdeDocumentDirty(Canceled.Document));
  AssertTrue(Cmd.Read() = TuiCmd.NoCommand);
  case Canceled.Dialog of
    IdeDialog.NoDialog:
    begin
    end;
    IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending), IdeDialog.ConfirmDirty(Pending):
    begin
      Fail('Cancel did not close dirty protection')
    end
  end;
  Cmd.Reset();
  var ConfirmDiscard: IdeModel := RequestOpen(Dirty, Cmd);
  var Discarded: IdeModel := UpdateIde(ConfirmDiscard, TuiMsgAction(DirtyDiscardControlId(), DirtyDiscardAction()), Cmd);
  AssertEquals('changed', Discarded.Document.Text);
  AssertTrue(IsIdeDocumentDirty(Discarded.Document));
  AssertTrue(Cmd.Read() = TuiCmd.NoCommand);
  case Discarded.Dialog of
    IdeDialog.OpenPath(PathText, Caret):
    begin
      AssertEquals('', PathText)
    end;
    IdeDialog.NoDialog, IdeDialog.SavePath(PathText, Caret, Pending), IdeDialog.ConfirmDirty(Pending):
    begin
      Fail('Discard did not continue to Open')
    end
  end;
  Cmd.Reset();
  var ConfirmSave: IdeModel := RequestOpen(Dirty, Cmd);
  var Saved: IdeModel := UpdateIde(ConfirmSave, TuiMsgAction(DirtySaveControlId(), DirtySaveAction()), Cmd);
  AssertEquals('changed', ReadIdeTestFile(DocumentPath));
  AssertFalse(IsIdeDocumentDirty(Saved.Document));
  AssertTrue(Cmd.Read() = TuiCmd.NoCommand);
  case Saved.Dialog of
    IdeDialog.OpenPath(PathText, Caret):
    begin
    end;
    IdeDialog.NoDialog, IdeDialog.SavePath(PathText, Caret, Pending), IdeDialog.ConfirmDirty(Pending):
    begin
      Fail('Save did not continue to Open')
    end
  end;
  Cmd.Reset();
  var Unwritable: IdeModel := DirtyState(IdeTestScratch, 'cannot save', Cmd);
  var ConfirmFailure: IdeModel := RequestOpen(Unwritable, Cmd);
  var Failed: IdeModel := UpdateIde(ConfirmFailure, TuiMsgAction(DirtySaveControlId(), DirtySaveAction()), Cmd);
  AssertEquals(Unwritable.Document.Text, Failed.Document.Text);
  AssertEquals(Unwritable.Document.SavedText, Failed.Document.SavedText);
  AssertEquals(Unwritable.Document.Caret, Failed.Document.Caret);
  AssertEquals(Unwritable.Document.Offset.X, Failed.Document.Offset.X);
  AssertEquals(Unwritable.Document.Offset.Y, Failed.Document.Offset.Y);
  AssertEquals(IdeDocumentPathText(Unwritable.Document), IdeDocumentPathText(Failed.Document));
  AssertTrue(IsIdeDocumentDirty(Failed.Document));
  AssertTrue(Std.Str.Contains(Failed.MessageText, 'Save failed: ' + IdeTestScratch));
  case Failed.Dialog of
    IdeDialog.ConfirmDirty(Pending):
    begin
      AssertTrue(Pending = IdePendingCommand.OpenDocument)
    end;
    IdeDialog.NoDialog, IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending):
    begin
      Fail('failed dirty Save did not preserve confirmation')
    end
  end
end.
