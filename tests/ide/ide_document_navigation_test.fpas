program IdeDocumentNavigationTest;

uses Ide.Document.Model, Std.Str, Std.Test;

begin
  var NewLine: string := Std.Str.Chr(10);
  var Text: string := ((('abc' + NewLine) + 'wide text') + NewLine) + 'z';
  var Document: IdeDocument := LoadedIdeDocument('source.fpas', Text);
  var Middle: IdeDocument := IdeDocumentAtSourcePosition(Document, 2, 6);
  AssertEquals(9, Middle.Caret);
  AssertEquals(5, Middle.Offset.X);
  AssertEquals(1, Middle.Offset.Y);
  AssertEquals(Text, Middle.Text);
  AssertEquals(Text, Middle.SavedText);
  AssertFalse(IsIdeDocumentDirty(Middle));
  var Beyond: IdeDocument := IdeDocumentAtSourcePosition(Document, 99, 99);
  AssertEquals(Std.Str.Length(Text), Beyond.Caret);
  AssertEquals(1, Beyond.Offset.X);
  AssertEquals(2, Beyond.Offset.Y);
  var Before: IdeDocument := IdeDocumentAtSourcePosition(Document, 0, 0);
  AssertEquals(0, Before.Caret);
  AssertEquals(0, Before.Offset.X);
  AssertEquals(0, Before.Offset.Y);
  var Wide: IdeDocument := LoadedIdeDocument('wide.fpas', 'a界b');
  var BeforeWideGlyph: IdeDocument := IdeDocumentAtSourcePosition(Wide, 1, 3);
  AssertEquals(1, BeforeWideGlyph.Caret);
  AssertEquals(1, BeforeWideGlyph.Offset.X);
  var AfterWideGlyph: IdeDocument := IdeDocumentAtSourcePosition(Wide, 1, 4);
  AssertEquals(2, AfterWideGlyph.Caret);
  AssertEquals(3, AfterWideGlyph.Offset.X);
  var Empty: IdeDocument := IdeDocumentAtSourcePosition(LoadedIdeDocument('empty.fpas', ''), 99, 99);
  AssertEquals(0, Empty.Caret);
  AssertEquals(0, Empty.Offset.X);
  AssertEquals(0, Empty.Offset.Y)
end.
