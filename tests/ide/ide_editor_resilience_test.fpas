program IdeEditorResilienceTest;

uses Ide.App.Model, Ide.App.Update, Ide.App.View, Ide.Document.Model, Std.Str, Std.Test, Std.Tui;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function SurfaceContains(Snapshot: TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
  begin
    if Std.Str.Contains(Snapshot.LineAt(Y), Text) then
    begin
      return true
    end
  end;
  return false
end;

begin
  mutable var Model: IdeModel := InitialIdeModel(Some('resilience.fpas'));
  var Loaded: IdeDocument := LoadedIdeDocument('resilience.fpas', 'first');
  Model.Document := IdeDocumentWithTextArea(Loaded, 'first', 5, TuiPoint.Create(0, 0));
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 0, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, ''));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertEquals('first' + Std.Str.Chr(10), Model.Document.Text);
  AssertEquals(6, Model.Document.Caret);
  AssertEquals(0, Model.Document.Offset.Y);
  AssertTrue(SurfaceContains(App.SurfaceSnapshot(), 'first'));
  for Index: integer := 0 to 19 do
  begin
    if Index mod 2 = 0 then
    begin
      App.InjectResizeForTest(TuiSize.Create(20, 5))
    end
    else
    begin
      App.InjectResizeForTest(TuiSize.Create(72, 22))
    end
  end;
  App.InjectResizeForTest(TuiSize.Create(50, 16));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'x'));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 22, 0);
  AssertEquals(('first' + Std.Str.Chr(10)) + 'x', Model.Document.Text);
  AssertEquals(7, Model.Document.Caret);
  AssertEquals(0, Model.Document.Offset.Y);
  AssertEquals(50, App.SurfaceSnapshot().Width);
  AssertEquals(16, App.SurfaceSnapshot().Height);
  AssertTrue(SurfaceContains(App.SurfaceSnapshot(), 'first'));
  AssertTrue(SurfaceContains(App.SurfaceSnapshot(), 'x'));
  AssertTrue(SurfaceContains(App.SurfaceSnapshot(), 'modified | Ln 2, Col 2'));
  App.Close()
end.
