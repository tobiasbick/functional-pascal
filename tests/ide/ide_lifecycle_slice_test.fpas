program IdeLifecycleSliceTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.App.View, Ide.Document.Model, Ide.Test.Files,
  Std.Str, Std.Test, Std.Tui;

const
  Path: string := IdeTestScratch + '/lifecycle_slice.fpas';

begin
  EnsureIdeTestScratch();
  WriteIdeTestFile(Path, 'program Before;');
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(60, 18));
  mutable var Model: IdeModel := InitialIdeModel(None);
  App.Inject(TuiMsgAction(OpenControlId(), OpenAction()));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  App.Inject(TuiMsgTextChanged(DialogPathControlId(), DialogPathChangedAction(), Path, Std.Str.Length(Path)));
  App.Inject(TuiMsgAction(DialogAcceptControlId(), DialogAcceptAction()));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 2, 0);
  AssertEquals('program Before;', Model.Document.Text);
  AssertFalse(IsIdeDocumentDirty(Model.Document));
  App.Inject(TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), 'program After;', 14, TuiPoint.Create(0, 0)));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertTrue(IsIdeDocumentDirty(Model.Document));
  App.Inject(TuiMsgAction(SaveControlId(), SaveAction()));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertEquals('program After;', ReadIdeTestFile(Path));
  AssertFalse(IsIdeDocumentDirty(Model.Document));
  AssertTrue(Std.Str.Contains(Model.MessageText, 'Saved '));
  AssertTrue(Std.Str.Contains(App.SurfaceSnapshot().LineAt(1), Path));
  App.Close()
end.
