program IdeMenuPointerTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.App.View, Ide.Theme.Model, Std.Str, Std.Test,
  Std.Tui;

function FindGlyph(Snapshot: TuiSurfaceSnapshot; Glyph: string): TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
  begin
    var X: integer := Std.Str.IndexOf(Snapshot.LineAt(Y), Glyph);
    if X >= 0 then
    begin
      return TuiPoint.Create(X, Y)
    end
  end;
  panic('glyph not found in IDE menu snapshot: ' + Glyph)
end;

procedure AssertActive(Menu: TuiMenuState; Expected: integer);
begin
  case Menu.Active of
    Some(Id):
    begin
      AssertEquals(Expected, Id.Value)
    end;
    None:
    begin
      Fail('Expected an active IDE menu node.')
    end
  end
end;

function MenuKey(): TuiKeyEvent;
begin
  return record
    kind := TuiKeyKind.F10;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  mutable var Model: IdeModel := App.RunIterations(InitialIdeModel(None), UpdateIde, ViewIde, 0, 0);
  var ClosedOptionsAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Options');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, ClosedOptionsAt));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertFalse(Model.Menu.Open);
  App.InjectKeyForTest(MenuKey());
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 2, 0);
  AssertTrue(Model.Menu.Open);
  var OptionsAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Options');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, OptionsAt));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertActive(Model.Menu, 4);
  var ThemeAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Theme');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, ThemeAt));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertActive(Model.Menu, 5);
  var DarkAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Dark');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, DarkAt));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertActive(Model.Menu, 51);
  AssertTrue(Model.Theme = IdeTheme.ClassicBlue);
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, TuiPoint.Create(79, 24)));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertTrue(Model.Menu.Open);
  AssertActive(Model.Menu, 51);
  AssertTrue(Model.Theme = IdeTheme.ClassicBlue);
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, DarkAt));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 2, 0);
  AssertFalse(Model.Menu.Open);
  AssertTrue(Model.Theme = IdeTheme.Dark);
  AssertEquals(0, App.Palette().Normal.Background.Index);
  AssertEquals(7, App.Palette().Normal.Foreground.Index);
  App.Close()
end.
