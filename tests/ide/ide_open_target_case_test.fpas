program IdeOpenTargetCaseTest;

uses
  Ide.App.Model, Ide.App.Update, Ide.Project.Model, Ide.Test.Files, Ide.Workspace.Model, Std.Option,
  Std.Str, Std.Test;

const
  Root: string := IdeTestScratch + '/open_target_case';
  SourcePath: string := Root + '/standalone.FPAS';
  MainPath: string := Root + '/main.FPAS';
  ProjectPath: string := Root + '/program.FPASPRJ';
  WorkspacePath: string := Root + '/suite.FPASWORKSPACE';

begin
  EnsureIdeTestScratch();
  EnsureIdeTestDirectory(Root);
  WriteIdeTestFile(SourcePath, 'program StandaloneCase; begin end.');
  WriteIdeTestFile(MainPath, 'program ProjectCase; begin end.');
  var NewLine: string := Std.Str.Chr(10);
  mutable var ProjectManifest: string := '[project]';
  ProjectManifest := (ProjectManifest + NewLine) + 'name = ''case-project''';
  ProjectManifest := (ProjectManifest + NewLine) + 'kind = ''program''';
  ProjectManifest := (ProjectManifest + NewLine) + 'main = ''main.FPAS''';
  ProjectManifest := (ProjectManifest + NewLine) + '[sources]';
  ProjectManifest := (ProjectManifest + NewLine) + 'include = [''main.FPAS'']';
  WriteIdeTestFile(ProjectPath, ProjectManifest);
  mutable var WorkspaceManifest: string := '[workspace]';
  WorkspaceManifest := (WorkspaceManifest + NewLine) + 'name = ''case-workspace''';
  WorkspaceManifest := (WorkspaceManifest + NewLine) + 'members = [''program.FPASPRJ'']';
  WriteIdeTestFile(WorkspacePath, WorkspaceManifest);
  var Source: IdeModel := InitializeIdeFromArguments([SourcePath]);
  AssertEquals('program StandaloneCase; begin end.', Source.Document.Text);
  AssertTrue(Std.Option.IsNone(Source.Project));
  AssertTrue(Std.Option.IsNone(Source.Workspace));
  var Project: IdeModel := InitializeIdeFromArguments([ProjectPath]);
  AssertEquals('program ProjectCase; begin end.', Project.Document.Text);
  case Project.Project of
    Some(Value):
    begin
      AssertEquals('case-project', Value.Name)
    end;
    None:
    begin
      Fail('Uppercase project extension did not establish a project.')
    end
  end;
  AssertTrue(Std.Option.IsNone(Project.Workspace));
  var Workspace: IdeModel := InitializeIdeFromArguments([WorkspacePath]);
  AssertEquals('program ProjectCase; begin end.', Workspace.Document.Text);
  case Workspace.Workspace of
    Some(Value):
    begin
      AssertEquals('case-workspace', Value.Name)
    end;
    None:
    begin
      Fail('Uppercase workspace extension did not establish a workspace.')
    end
  end;
  case Workspace.Project of
    Some(Value):
    begin
      AssertEquals('case-project', Value.Name)
    end;
    None:
    begin
      Fail('Workspace did not retain its uppercase project member.')
    end
  end
end.
