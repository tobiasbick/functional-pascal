program IdeProcessIntegrationTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.Document.Model, Ide.Test.Files, Std.Option,
  Std.Str, Std.Test, Std.Tui;

const
  SourcePath: string := IdeTestScratch + '/process_integration.fpas';
  UntitledCheckPath: string := IdeTestScratch + '/process_untitled.fpas';

procedure AssertExitCode(State: IdeModel; ExpectedSuccess: boolean);
begin
  case State.LastExitCode of
    Some(ExitCode):
    begin
      AssertTrue((ExitCode = 0) = ExpectedSuccess)
    end;
    None:
    begin
      Fail('Expected a completed compiler process.')
    end
  end
end;

begin
  EnsureIdeTestScratch();
  var NewLine: string := Std.Str.Chr(10);
  var ValidSource: string := (('program IdeProcessValid;' + NewLine) + 'begin') + (NewLine + 'end.');
  WriteIdeTestFile(SourcePath, ValidSource);
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  var Loaded: IdeModel := InitializeIdeFromArguments([SourcePath]);
  var Checked: IdeModel := UpdateIde(Loaded, TuiMsgAction(CheckControlId(), CheckAction()), Cmd);
  AssertExitCode(Checked, true);
  AssertTrue(Std.Str.Contains(Checked.MessageText, 'Check exit code: 0'));
  AssertTrue(Std.Str.Contains(Checked.MessageText, 'stdout:' + NewLine));
  AssertFalse(IsIdeDocumentDirty(Checked.Document));
  var CompileErrorSource: string := (('program IdeProcessCompileError;' + NewLine) + 'begin') +
                                    (((NewLine + '  MissingIdentifier()') + NewLine) + 'end.');
  var CompileEdited: IdeModel := UpdateIde(Checked, TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), CompileErrorSource, Std.Str.Length(CompileErrorSource), TuiPoint.Create(0, 0)), Cmd);
  Cmd.Reset();
  var CompileFailed: IdeModel := UpdateIde(CompileEdited, TuiMsgAction(CheckControlId(), CheckAction()), Cmd);
  AssertExitCode(CompileFailed, false);
  AssertTrue(Std.Str.Contains(CompileFailed.MessageText, 'Check exit code: '));
  AssertTrue(Std.Str.Contains(CompileFailed.MessageText, 'error['));
  AssertEquals(CompileErrorSource, ReadIdeTestFile(SourcePath));
  var RuntimeErrorSource: string := (('program IdeProcessRuntimeError;' + NewLine) + 'begin') +
                                    (((NewLine + '  panic(''ide runtime marker'')') + NewLine) + 'end.');
  var RuntimeEdited: IdeModel := UpdateIde(CompileFailed, TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), RuntimeErrorSource, Std.Str.Length(RuntimeErrorSource), TuiPoint.Create(0, 0)), Cmd);
  Cmd.Reset();
  var RuntimeFailed: IdeModel := UpdateIde(RuntimeEdited, TuiMsgAction(RunControlId(), RunAction()), Cmd);
  AssertExitCode(RuntimeFailed, false);
  AssertTrue(Std.Str.Contains(RuntimeFailed.MessageText, 'Run exit code: '));
  AssertTrue(Std.Str.Contains(RuntimeFailed.MessageText, 'ide runtime marker'));
  AssertEquals(RuntimeErrorSource, ReadIdeTestFile(SourcePath));
  var Unsaved: IdeModel := InitialIdeModel(Some(IdeTestScratch));
  var DirtyUnsaved: IdeModel := UpdateIde(Unsaved, TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), ValidSource, Std.Str.Length(ValidSource), TuiPoint.Create(0, 0)), Cmd);
  Cmd.Reset();
  var SaveFailed: IdeModel := UpdateIde(DirtyUnsaved, TuiMsgAction(CheckControlId(), CheckAction()), Cmd);
  AssertTrue(Std.Str.Contains(SaveFailed.MessageText, 'Save failed: '));
  AssertTrue(Std.Option.IsNone(SaveFailed.LastExitCode));
  AssertTrue(IsIdeDocumentDirty(SaveFailed.Document));
  var Untitled: IdeModel := InitialIdeModel(None);
  var UntitledDirty: IdeModel := UpdateIde(Untitled, TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), ValidSource, Std.Str.Length(ValidSource), TuiPoint.Create(0, 0)), Cmd);
  Cmd.Reset();
  var CheckSaveAs: IdeModel := UpdateIde(UntitledDirty, TuiMsgAction(CheckControlId(), CheckAction()), Cmd);
  case CheckSaveAs.Dialog of
    IdeDialog.SavePath(PathText, Caret, Pending):
    begin
      AssertTrue(Pending = IdePendingCommand.CheckDocument)
    end;
    IdeDialog.NoDialog, IdeDialog.OpenPath(PathText, Caret), IdeDialog.ConfirmDirty(Pending):
    begin
      Fail('untitled Check did not request a save path')
    end
  end;
  var CheckPathEntered: IdeModel := UpdateIde(CheckSaveAs, TuiMsgTextChanged(DialogPathControlId(), DialogPathChangedAction(), UntitledCheckPath, Std.Str.Length(UntitledCheckPath)), Cmd);
  Cmd.Reset();
  var UntitledChecked: IdeModel := UpdateIde(CheckPathEntered, TuiMsgAction(DialogAcceptControlId(), DialogAcceptAction()), Cmd);
  AssertExitCode(UntitledChecked, true);
  AssertEquals(ValidSource, ReadIdeTestFile(UntitledCheckPath));
  AssertFalse(IsIdeDocumentDirty(UntitledChecked.Document))
end.
