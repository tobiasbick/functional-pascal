program IdeProjectOpenTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.App.View, Ide.Project.Model, Ide.Test.Files,
  Std.Array, Std.Option, Std.Path, Std.Str, Std.Test, Std.Tui;

const
  ProjectRoot: string := IdeTestScratch + '/project_open';
  MainPath: string := ProjectRoot + '/main.fpas';
  ProjectPath: string := ProjectRoot + '/demo.fpasprj';
  BrokenPath: string := ProjectRoot + '/broken.fpasprj';
  StandalonePath: string := ProjectRoot + '/standalone.fpas';

function EnterAndAcceptOpen(State: IdeModel; Path: string; Cmd: TuiCmdOutput): IdeModel;
begin
  var Opening: IdeModel := UpdateIde(State, TuiMsgAction(OpenControlId(), OpenAction()), Cmd);
  var Entered: IdeModel := UpdateIde(Opening, TuiMsgTextChanged(DialogPathControlId(), DialogPathChangedAction(), Path, Std.Str.Length(Path)), Cmd);
  return UpdateIde(Entered, TuiMsgAction(DialogAcceptControlId(), DialogAcceptAction()), Cmd)
end;

begin
  EnsureIdeTestScratch();
  EnsureIdeTestDirectory(ProjectRoot);
  var NewLine: string := Std.Str.Chr(10);
  WriteIdeTestFile(MainPath, 'program ProjectOpen; begin end.');
  WriteIdeTestFile(StandalonePath, 'program Standalone; begin end.');
  mutable var Manifest: string := '[project]';
  Manifest := (Manifest + NewLine) + 'name = ''opened-project''';
  Manifest := (Manifest + NewLine) + 'kind = ''program''';
  Manifest := (Manifest + NewLine) + 'main = ''main.fpas''';
  Manifest := (Manifest + NewLine) + '[sources]';
  Manifest := (Manifest + NewLine) + 'include = [''main.fpas'']';
  WriteIdeTestFile(ProjectPath, Manifest);
  var Opened: IdeModel := InitializeIdeFromArguments([ProjectPath]);
  AssertEquals('program ProjectOpen; begin end.', Opened.Document.Text);
  case Opened.Project of
    Some(Project):
    begin
      AssertEquals('opened-project', Project.Name);
      AssertEquals(Manifest, Project.ManifestText);
      AssertEquals(Std.Path.Normalize(ProjectPath), Project.Path);
      AssertEquals(1, Std.Array.Length(Project.SourceFiles))
    end;
    None:
    begin
      Fail('Opening a project did not establish a project session.')
    end
  end;
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var _: IdeModel := App.RunIterations(Opened, UpdateIde, ViewIde, 0, 0);
  AssertTrue(Std.Str.Contains(App.SurfaceSnapshot().LineAt(1), 'opened-project'));
  AssertTrue(Std.Str.Contains(App.SurfaceSnapshot().LineAt(1), 'main.fpas'));
  App.Close();
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  WriteIdeTestFile(BrokenPath, '[project]');
  var Failed: IdeModel := EnterAndAcceptOpen(Opened, BrokenPath, Cmd);
  case Failed.Project of
    Some(Project):
    begin
      AssertEquals('opened-project', Project.Name)
    end;
    None:
    begin
      Fail('Failed project open discarded the current project.')
    end
  end;
  AssertEquals(Opened.Document.Text, Failed.Document.Text);
  var Standalone: IdeModel := EnterAndAcceptOpen(Opened, StandalonePath, Cmd);
  AssertTrue(Std.Option.IsNone(Standalone.Project));
  AssertEquals('program Standalone; begin end.', Standalone.Document.Text);
  var Dirty: IdeModel := UpdateIde(Standalone, TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), 'changed', 7, TuiPoint.Create(0, 0)), Cmd);
  var Protected: IdeModel := UpdateIde(Dirty, TuiMsgAction(OpenControlId(), OpenAction()), Cmd);
  case Protected.Dialog of
    IdeDialog.ConfirmDirty(Pending):
    begin
      AssertTrue(Pending = IdePendingCommand.OpenDocument)
    end;
    IdeDialog.NoDialog, IdeDialog.OpenPath(PathText, Caret), IdeDialog.SavePath(PathText, Caret, Pending):
    begin
      Fail('Dirty source did not protect project Open.')
    end
  end;
  var Discarded: IdeModel := UpdateIde(Protected, TuiMsgAction(DirtyDiscardControlId(), DirtyDiscardAction()), Cmd);
  var Entered: IdeModel := UpdateIde(Discarded, TuiMsgTextChanged(DialogPathControlId(), DialogPathChangedAction(), ProjectPath, Std.Str.Length(ProjectPath)), Cmd);
  var Reopened: IdeModel := UpdateIde(Entered, TuiMsgAction(DialogAcceptControlId(), DialogAcceptAction()), Cmd);
  AssertTrue(Std.Option.IsSome(Reopened.Project));
  AssertEquals('program ProjectOpen; begin end.', Reopened.Document.Text)
end.
