program IdeProjectProcessTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.Test.Files, Std.Option, Std.Str, Std.Test,
  Std.Tui;

const
  ProjectRoot: string := IdeTestScratch + '/project_process';
  MainPath: string := ProjectRoot + '/main.fpas';
  UnitPath: string := ProjectRoot + '/greeting.fpas';
  ProjectPath: string := ProjectRoot + '/demo.fpasprj';

procedure AssertSuccessfulProcess(State: IdeModel);
begin
  case State.LastExitCode of
    Some(ExitCode):
    begin
      AssertEquals(0, ExitCode)
    end;
    None:
    begin
      Fail('Expected a completed project process.')
    end
  end
end;

begin
  EnsureIdeTestScratch();
  EnsureIdeTestDirectory(ProjectRoot);
  var NewLine: string := Std.Str.Chr(10);
  mutable var MainSource: string := 'program ProjectProcess;';
  MainSource := (MainSource + NewLine) + 'uses Project.Greeting, Std.Console;';
  MainSource := (MainSource + NewLine) + 'begin';
  MainSource := (MainSource + NewLine) + '  WriteLn(Greeting())';
  MainSource := (MainSource + NewLine) + 'end.';
  mutable var UnitSource: string := 'unit Project.Greeting;';
  UnitSource := (UnitSource + NewLine) + 'function Greeting(): string;';
  UnitSource := (UnitSource + NewLine) + 'begin';
  UnitSource := (UnitSource + NewLine) + '  return ''project process ok''';
  UnitSource := (UnitSource + NewLine) + 'end;';
  WriteIdeTestFile(MainPath, MainSource);
  WriteIdeTestFile(UnitPath, UnitSource);
  mutable var Manifest: string := '[project]';
  Manifest := (Manifest + NewLine) + 'name = ''project-process''';
  Manifest := (Manifest + NewLine) + 'kind = ''program''';
  Manifest := (Manifest + NewLine) + 'main = ''main.fpas''';
  Manifest := (Manifest + NewLine) + '[sources]';
  Manifest := (Manifest + NewLine) + 'include = [''*.fpas'']';
  WriteIdeTestFile(ProjectPath, Manifest);
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  var Opened: IdeModel := InitializeIdeFromArguments([ProjectPath]);
  var Checked: IdeModel := UpdateIde(Opened, TuiMsgAction(CheckControlId(), CheckAction()), Cmd);
  AssertSuccessfulProcess(Checked);
  AssertTrue(Std.Str.Contains(Checked.MessageText, 'Check exit code: 0'));
  Cmd.Reset();
  var Ran: IdeModel := UpdateIde(Checked, TuiMsgAction(RunControlId(), RunAction()), Cmd);
  AssertSuccessfulProcess(Ran);
  AssertTrue(Std.Str.Contains(Ran.MessageText, 'project process ok'))
end.
