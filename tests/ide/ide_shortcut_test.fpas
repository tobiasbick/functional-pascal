program IdeShortcutTest;

uses
  Ide.App.Model, Ide.App.Update, Ide.App.View, Ide.Document.Model, Ide.Test.Files, Std.Option,
  Std.Str, Std.Test, Std.Tui;

const
  SourcePath: string := IdeTestScratch + '/shortcut.fpas';

function MakeKey(Kind: TuiKeyKind; Character: string; Ctrl: boolean; Alt: boolean): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := Ctrl;
    alt := Alt;
    meta := false;
  end
end;

procedure AssertSuccessfulExit(State: IdeModel);
begin
  case State.LastExitCode of
    Some(ExitCode):
    begin
      AssertEquals(0, ExitCode)
    end;
    None:
    begin
      Fail('Expected a successful compiler process.')
    end
  end
end;

begin
  EnsureIdeTestScratch();
  var NewLine: string := Std.Str.Chr(10);
  var Source: string := (('program IdeShortcutSource;' + NewLine) + 'begin') + (NewLine + 'end.');
  WriteIdeTestFile(SourcePath, 'old');
  mutable var Model: IdeModel := InitializeIdeFromArguments([SourcePath]);
  Model.Document := IdeDocumentWithTextArea(Model.Document, Source, Std.Str.Length(Source), TuiPoint.Create(0, 0));
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 0, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.F2, '', false, false));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertEquals(Source, ReadIdeTestFile(SourcePath));
  AssertFalse(IsIdeDocumentDirty(Model.Document));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.F9, '', false, false));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertSuccessfulExit(Model);
  AssertTrue(Std.Str.Contains(Model.MessageText, 'Check exit code: 0'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.F9, '', true, false));
  Model := App.RunIterations(Model, UpdateIde, ViewIde, 1, 0);
  AssertSuccessfulExit(Model);
  AssertTrue(Std.Str.Contains(Model.MessageText, 'Run exit code: 0'));
  App.Close();
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  var Exiting: IdeModel := UpdateIde(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'X', false, true)), Cmd);
  AssertTrue(Cmd.Read() = TuiCmd.Quit);
  AssertEquals(Model.Document.Text, Exiting.Document.Text)
end.
