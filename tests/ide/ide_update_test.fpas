program IdeUpdateTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.Document.Model, Ide.Test.Files, Std.Str,
  Std.Option, Std.Test, Std.Tui;

const
  SavePath: string := IdeTestScratch + '/update_save.fpas';
  MissingPath: string := IdeTestScratch + '/update_missing.fpas';

begin
  EnsureIdeTestScratch();
  WriteIdeTestFile(SavePath, 'old');
  var Initial: IdeModel := InitializeIdeFromArguments([SavePath]);
  AssertEquals('old', Initial.Document.Text);
  var Missing: IdeModel := InitializeIdeFromArguments([MissingPath]);
  AssertTrue(Std.Option.IsNone(Missing.Document.Path));
  AssertEquals('', Missing.Document.Text);
  AssertTrue(Std.Str.Contains(Missing.MessageText, 'Open failed: ' + MissingPath));
  var Invalid: IdeModel := InitializeIdeFromArguments(['sample.txt']);
  AssertTrue(Std.Option.IsNone(Invalid.Document.Path));
  AssertEquals('Startup path must end with .fpas.', Invalid.MessageText);
  var Extra: IdeModel := InitializeIdeFromArguments(['one.fpas', 'two.fpas']);
  AssertTrue(Std.Option.IsNone(Extra.Document.Path));
  AssertEquals('Expected at most one .fpas path argument.', Extra.MessageText);
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  var Edited: IdeModel := UpdateIde(Initial, TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), 'new', 3, TuiPoint.Create(0, 0)), Cmd);
  AssertTrue(IsIdeDocumentDirty(Edited.Document));
  var Scrolled: IdeModel := UpdateIde(Edited, TuiMsgScrollChanged(MessageScrollControlId(), MessageScrollChangedAction(), TuiPoint.Create(0, 4)), Cmd);
  AssertEquals(4, Scrolled.MessageOffset.Y);
  AssertEquals(Edited.Document.Text, Scrolled.Document.Text);
  Cmd.Reset();
  var Saved: IdeModel := UpdateIde(Scrolled, TuiMsgAction(SaveControlId(), SaveAction()), Cmd);
  AssertEquals('new', ReadIdeTestFile(SavePath));
  AssertEquals('new', Saved.Document.SavedText);
  AssertFalse(IsIdeDocumentDirty(Saved.Document));
  AssertTrue(Std.Str.Contains(Saved.MessageText, 'Saved '));
  AssertEquals(0, Saved.MessageOffset.X);
  AssertEquals(0, Saved.MessageOffset.Y);
  AssertTrue(Cmd.Read() = TuiCmd.NoCommand);
  Cmd.Reset();
  var Ignored: IdeModel := UpdateIde(Saved, TuiMsgAction(OpenControlId(), SaveAction()), Cmd);
  AssertEquals(Saved.MessageText, Ignored.MessageText);
  AssertEquals(Saved.Document.Text, Ignored.Document.Text);
  var WrongSource: IdeModel := UpdateIde(Saved, TuiMsgScrollChanged(OpenControlId(), MessageScrollChangedAction(), TuiPoint.Create(0, 2)), Cmd);
  AssertEquals(0, WrongSource.MessageOffset.Y);
  var WrongAction: IdeModel := UpdateIde(Saved, TuiMsgScrollChanged(MessageScrollControlId(), SaveAction(), TuiPoint.Create(0, 2)), Cmd);
  AssertEquals(0, WrongAction.MessageOffset.Y);
  var MessageScrolled: IdeModel := UpdateIde(Saved, TuiMsgScrollChanged(MessageScrollControlId(), MessageScrollChangedAction(), TuiPoint.Create(0, 2)), Cmd);
  var Opening: IdeModel := UpdateIde(MessageScrolled, TuiMsgAction(OpenControlId(), OpenAction()), Cmd);
  AssertEquals(2, Opening.MessageOffset.Y);
  var DialogScrollIgnored: IdeModel := UpdateIde(Opening, TuiMsgScrollChanged(MessageScrollControlId(), MessageScrollChangedAction(), TuiPoint.Create(0, 6)), Cmd);
  AssertEquals(2, DialogScrollIgnored.MessageOffset.Y)
end.
