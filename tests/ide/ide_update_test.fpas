program IdeUpdateTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.Diagnostic.Model, Ide.Document.Model,
  Ide.Test.Files, Std.Str, Std.Option, Std.Test, Std.Tui;

const
  SavePath: string := IdeTestScratch + '/update_save.fpas';
  MissingPath: string := IdeTestScratch + '/update_missing.fpas';

function EnterKey(): TuiKeyEvent;
begin
  return record
    kind := TuiKeyKind.Enter;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

begin
  EnsureIdeTestScratch();
  WriteIdeTestFile(SavePath, 'old');
  var Initial: IdeModel := InitializeIdeFromArguments([SavePath]);
  AssertEquals('old', Initial.Document.Text);
  var Missing: IdeModel := InitializeIdeFromArguments([MissingPath]);
  AssertTrue(Std.Option.IsNone(Missing.Document.Path));
  AssertEquals('', Missing.Document.Text);
  AssertTrue(Std.Str.Contains(Missing.MessageText, 'Open failed: ' + MissingPath));
  var Invalid: IdeModel := InitializeIdeFromArguments(['sample.txt']);
  AssertTrue(Std.Option.IsNone(Invalid.Document.Path));
  AssertEquals('Startup path must end with .fpas, .fpasprj, or .fpasworkspace.', Invalid.MessageText);
  var Extra: IdeModel := InitializeIdeFromArguments(['one.fpas', 'two.fpas']);
  AssertTrue(Std.Option.IsNone(Extra.Document.Path));
  AssertEquals('Expected at most one .fpas, .fpasprj, or .fpasworkspace path argument.', Extra.MessageText);
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  var Edited: IdeModel := UpdateIde(Initial, TuiMsgTextAreaChanged(EditorControlId(), EditorChangedAction(), 'new', 3, TuiPoint.Create(0, 0)), Cmd);
  AssertTrue(IsIdeDocumentDirty(Edited.Document));
  var Scrolled: IdeModel := UpdateIde(Edited, TuiMsgScrollChanged(MessageScrollControlId(), MessageScrollChangedAction(), TuiPoint.Create(0, 4)), Cmd);
  AssertEquals(4, Scrolled.MessageOffset.Y);
  AssertEquals(Edited.Document.Text, Scrolled.Document.Text);
  Cmd.Reset();
  var Saved: IdeModel := UpdateIde(Scrolled, TuiMsgAction(SaveControlId(), SaveAction()), Cmd);
  AssertEquals('new', ReadIdeTestFile(SavePath));
  AssertEquals('new', Saved.Document.SavedText);
  AssertFalse(IsIdeDocumentDirty(Saved.Document));
  AssertTrue(Std.Str.Contains(Saved.MessageText, 'Saved '));
  AssertEquals(0, Saved.MessageOffset.X);
  AssertEquals(0, Saved.MessageOffset.Y);
  AssertTrue(Cmd.Read() = TuiCmd.NoCommand);
  Cmd.Reset();
  var Ignored: IdeModel := UpdateIde(Saved, TuiMsgAction(OpenControlId(), SaveAction()), Cmd);
  AssertEquals(Saved.MessageText, Ignored.MessageText);
  AssertEquals(Saved.Document.Text, Ignored.Document.Text);
  var WrongSource: IdeModel := UpdateIde(Saved, TuiMsgScrollChanged(OpenControlId(), MessageScrollChangedAction(), TuiPoint.Create(0, 2)), Cmd);
  AssertEquals(0, WrongSource.MessageOffset.Y);
  var WrongAction: IdeModel := UpdateIde(Saved, TuiMsgScrollChanged(MessageScrollControlId(), SaveAction(), TuiPoint.Create(0, 2)), Cmd);
  AssertEquals(0, WrongAction.MessageOffset.Y);
  var MessageScrolled: IdeModel := UpdateIde(Saved, TuiMsgScrollChanged(MessageScrollControlId(), MessageScrollChangedAction(), TuiPoint.Create(0, 2)), Cmd);
  var Opening: IdeModel := UpdateIde(MessageScrolled, TuiMsgAction(OpenControlId(), OpenAction()), Cmd);
  AssertEquals(2, Opening.MessageOffset.Y);
  var DialogScrollIgnored: IdeModel := UpdateIde(Opening, TuiMsgScrollChanged(MessageScrollControlId(), MessageScrollChangedAction(), TuiPoint.Create(0, 6)), Cmd);
  AssertEquals(2, DialogScrollIgnored.MessageOffset.Y);
  var NavigationText: string := (('first' + Std.Str.Chr(10)) + 'second') +
                                (Std.Str.Chr(10) + 'third');
  var NavigationDocument: IdeDocument := IdeDocumentWithTextArea(LoadedIdeDocument(SavePath, NavigationText), NavigationText +
                                                                                                              ' changed', 0, TuiPoint.Create(0, 0));
  var NavigationDiagnostics: array of IdeDiagnostic := [
                                                         record Path := SavePath; Line := 2; Column := 3; MessageLine := 2; end,
                                                         record Path := SavePath; Line := 99; Column := 99; MessageLine := 5; end

                                                       ];
  var Navigation: IdeModel := record
    Workspace := None;
    Project := None;
    Document := NavigationDocument;
    Dialog := IdeDialog.NoDialog;
    MessageText := 'header';
    MessageOffset := TuiPoint.Create(0, 0);
    Diagnostics := NavigationDiagnostics;
    SelectedDiagnostic := Some(0);
    LastExitCode := Some(1);
    Focused := Some(MessageScrollControlId());
  end;
  var LaterDiagnostic: IdeModel := UpdateIde(Navigation, TuiMsgScrollChanged(MessageScrollControlId(), MessageScrollChangedAction(), TuiPoint.Create(0, 5)), Cmd);
  case LaterDiagnostic.SelectedDiagnostic of
    Some(Index):
    begin
      AssertEquals(1, Index)
    end;
    None:
    begin
      Fail('scrolling did not select the later diagnostic')
    end
  end;
  var Navigated: IdeModel := UpdateIde(Navigation, TuiMsg.Key(EnterKey()), Cmd);
  AssertEquals(8, Navigated.Document.Caret);
  AssertEquals(2, Navigated.Document.Offset.X);
  AssertEquals(1, Navigated.Document.Offset.Y);
  AssertEquals(Navigation.Document.Text, Navigated.Document.Text);
  AssertEquals(Navigation.Document.SavedText, Navigated.Document.SavedText);
  AssertTrue(IsIdeDocumentDirty(Navigated.Document));
  case Navigated.Focused of
    Some(Id):
    begin
      AssertEquals(EditorControlId().Value, Id.Value)
    end;
    None:
    begin
      Fail('diagnostic navigation did not focus the editor')
    end
  end;
  var Clamped: IdeModel := UpdateIde(LaterDiagnostic, TuiMsg.Key(EnterKey()), Cmd);
  AssertEquals(Std.Str.Length(Clamped.Document.Text), Clamped.Document.Caret);
  mutable var EditorFocused: IdeModel := Navigation;
  EditorFocused.Focused := Some(EditorControlId());
  var NotNavigated: IdeModel := UpdateIde(EditorFocused, TuiMsg.Key(EnterKey()), Cmd);
  AssertEquals(EditorFocused.Document.Caret, NotNavigated.Document.Caret);
  mutable var NoDiagnostics: IdeModel := Saved;
  NoDiagnostics.Focused := Some(MessageScrollControlId());
  var NoDiagnosticNavigation: IdeModel := UpdateIde(NoDiagnostics, TuiMsg.Key(EnterKey()), Cmd);
  AssertEquals(NoDiagnostics.Document.Caret, NoDiagnosticNavigation.Document.Caret);
  AssertEquals(NoDiagnostics.MessageText, NoDiagnosticNavigation.MessageText)
end.
