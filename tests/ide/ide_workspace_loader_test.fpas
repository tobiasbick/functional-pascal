program IdeWorkspaceLoaderTest;

uses
  Ide.Project.Model, Ide.Test.Files, Ide.Workspace.Loader, Ide.Workspace.Model, Std.Array,
  Std.Option, Std.Path, Std.Str, Std.Test;

const
  WorkspaceRoot: string := IdeTestScratch + '/workspace_loader';
  ProgramSourcePath: string := WorkspaceRoot + '/program.fpas';
  LibrarySourcePath: string := WorkspaceRoot + '/library.fpas';
  ProgramProjectPath: string := WorkspaceRoot + '/program.fpasprj';
  LibraryProjectPath: string := WorkspaceRoot + '/library.fpasprj';
  DuplicateProjectPath: string := WorkspaceRoot + '/duplicate.fpasprj';
  WorkspacePath: string := WorkspaceRoot + '/suite.fpasworkspace';

function ProjectManifest(Name: string; Kind: string; Source: string; MainLine: string): string;
begin
  var NewLine: string := Std.Str.Chr(10);
  mutable var Text: string := '[project]';
  Text := ((Text + NewLine) + ('name = ''' + Name)) + '''';
  Text := ((Text + NewLine) + ('kind = ''' + Kind)) + '''';
  if Std.Str.Length(MainLine) > 0 then
  begin
    Text := (Text + NewLine) + MainLine
  end;
  Text := (Text + NewLine) + '[sources]';
  Text := (Text + NewLine) + (('include = [''' + Source) + ''']');
  return Text
end;

function WorkspaceManifest(Name: string; Members: string): string;
begin
  var NewLine: string := Std.Str.Chr(10);
  return (((('[workspace]' + NewLine) + 'name = ''') + Name) + ('''' + NewLine)) +
         (('members = [' + Members) + ']')
end;

procedure AssertWorkspaceError(ManifestText: string; Expected: string);
begin
  WriteIdeTestFile(WorkspacePath, ManifestText);
  case LoadIdeWorkspace(WorkspacePath) of
    Ok(Workspace):
    begin
      Fail('Expected workspace load failure: ' + Expected)
    end;
    Error(Message):
    begin
      AssertTrue(Std.Str.Contains(Message, Expected))
    end
  end
end;

begin
  EnsureIdeTestScratch();
  EnsureIdeTestDirectory(WorkspaceRoot);
  WriteIdeTestFile(ProgramSourcePath, 'program WorkspaceProgram; begin end.');
  WriteIdeTestFile(LibrarySourcePath, 'unit Workspace.Library;');
  WriteIdeTestFile(ProgramProjectPath, ProjectManifest('workspace-program', 'program', 'program.fpas', 'main = ''program.fpas'''));
  WriteIdeTestFile(LibraryProjectPath, ProjectManifest('workspace-library', 'library', 'library.fpas', ''));
  var ManifestText: string := WorkspaceManifest('workspace-suite', '''program.fpasprj'', ''library.fpasprj''');
  WriteIdeTestFile(WorkspacePath, ManifestText);
  case LoadIdeWorkspace(WorkspacePath) of
    Ok(Workspace):
    begin
      AssertEquals('workspace-suite', Workspace.Name);
      AssertEquals(ManifestText, Workspace.ManifestText);
      AssertEquals(Std.Path.Normalize(WorkspacePath), Workspace.Path);
      AssertEquals(Std.Path.Normalize(WorkspaceRoot), Workspace.Root);
      AssertEquals(2, Std.Array.Length(Workspace.Projects));
      AssertEquals('workspace-program', Workspace.Projects[0].Name);
      AssertTrue(Workspace.Projects[0].Kind = IdeProjectKind.ProgramProject);
      AssertEquals('workspace-library', Workspace.Projects[1].Name);
      AssertTrue(Workspace.Projects[1].Kind = IdeProjectKind.LibraryProject);
      case IdeWorkspaceInitialProject(Workspace) of
        Some(Project):
        begin
          AssertEquals('workspace-program', Project.Name)
        end;
        None:
        begin
          Fail('Workspace did not retain an initial project.')
        end
      end
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end;
  AssertWorkspaceError('[workspace', 'Invalid workspace manifest');
  AssertWorkspaceError('[other]', 'requires [workspace]');
  AssertWorkspaceError('workspace = 7', 'field [workspace] must be a table');
  AssertWorkspaceError(('[workspace]' + Std.Str.Chr(10)) + 'members = [''program.fpasprj'']', 'workspace requires name');
  AssertWorkspaceError((('[workspace]' + Std.Str.Chr(10)) + 'name = 7') +
                       (Std.Str.Chr(10) + 'members = [''program.fpasprj'']'), 'workspace.name must be a string');
  AssertWorkspaceError(WorkspaceManifest('', '''program.fpasprj'''), 'workspace.name must not be empty');
  AssertWorkspaceError(('[workspace]' + Std.Str.Chr(10)) + 'name = ''missing-members''', 'workspace requires members');
  AssertWorkspaceError(((('[workspace]' + Std.Str.Chr(10)) + 'name = ''wrong-members''') + Std.Str.Chr(10)) +
                       'members = ''program.fpasprj''', 'workspace.members must be an array of strings');
  AssertWorkspaceError(((('[workspace]' + Std.Str.Chr(10)) + 'name = ''mixed-members''') + Std.Str.Chr(10)) +
                       'members = [''program.fpasprj'', 7]', 'workspace.members must contain only strings');
  AssertWorkspaceError(WorkspaceManifest('empty', ''), 'must contain at least one project path');
  AssertWorkspaceError(WorkspaceManifest('blank', '''   '''), 'entries must not be empty');
  AssertWorkspaceError(WorkspaceManifest('wrong-extension', '''program.fpas'''), 'must reference an .fpasprj file');
  AssertWorkspaceError(WorkspaceManifest('missing', '''missing.fpasprj'''), 'Could not load workspace member');
  AssertWorkspaceError(WorkspaceManifest('duplicate', '''program.fpasprj'', ''./program.fpasprj'''), 'Duplicate workspace member');
  WriteIdeTestFile(DuplicateProjectPath, ProjectManifest('workspace-program', 'library', 'library.fpas', ''));
  AssertWorkspaceError(WorkspaceManifest('duplicate-name', '''program.fpasprj'', ''duplicate.fpasprj'''), 'Duplicate workspace project name');
  case LoadIdeWorkspace(ProgramProjectPath) of
    Ok(Workspace):
    begin
      Fail('Accepted a project path as a workspace.')
    end;
    Error(Message):
    begin
      AssertTrue(Std.Str.Contains(Message, '.fpasworkspace'))
    end
  end;
  case LoadIdeWorkspace(WorkspaceRoot + '/missing.fpasworkspace') of
    Ok(Workspace):
    begin
      Fail('Missing workspace manifest unexpectedly loaded.')
    end;
    Error(Message):
    begin
      AssertTrue(Std.Str.Contains(Message, 'Could not read workspace manifest'))
    end
  end
end.
