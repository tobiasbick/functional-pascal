program IdeWorkspaceProcessTest;

uses
  Ide.App.Actions, Ide.App.Model, Ide.App.Update, Ide.Test.Files, Std.Option, Std.Str, Std.Test,
  Std.Tui;

const
  WorkspaceRoot: string := IdeTestScratch + '/workspace_process';
  MainPath: string := WorkspaceRoot + '/main.fpas';
  ProjectPath: string := WorkspaceRoot + '/program.fpasprj';
  WorkspacePath: string := WorkspaceRoot + '/suite.fpasworkspace';

procedure AssertSuccessfulProcess(State: IdeModel);
begin
  case State.LastExitCode of
    Some(ExitCode):
    begin
      AssertEquals(0, ExitCode)
    end;
    None:
    begin
      Fail('Expected a completed workspace-member process.')
    end
  end
end;

begin
  EnsureIdeTestScratch();
  EnsureIdeTestDirectory(WorkspaceRoot);
  var NewLine: string := Std.Str.Chr(10);
  mutable var MainSource: string := 'program WorkspaceProcess;';
  MainSource := (MainSource + NewLine) + 'uses Std.Console;';
  MainSource := (MainSource + NewLine) + 'begin';
  MainSource := (MainSource + NewLine) + '  WriteLn(''workspace process ok'')';
  MainSource := (MainSource + NewLine) + 'end.';
  WriteIdeTestFile(MainPath, MainSource);
  mutable var ProjectManifest: string := '[project]';
  ProjectManifest := (ProjectManifest + NewLine) + 'name = ''workspace-process''';
  ProjectManifest := (ProjectManifest + NewLine) + 'kind = ''program''';
  ProjectManifest := (ProjectManifest + NewLine) + 'main = ''main.fpas''';
  ProjectManifest := (ProjectManifest + NewLine) + '[sources]';
  ProjectManifest := (ProjectManifest + NewLine) + 'include = [''main.fpas'']';
  WriteIdeTestFile(ProjectPath, ProjectManifest);
  mutable var WorkspaceManifest: string := '[workspace]';
  WorkspaceManifest := (WorkspaceManifest + NewLine) + 'name = ''process-suite''';
  WorkspaceManifest := (WorkspaceManifest + NewLine) + 'members = [''program.fpasprj'']';
  WriteIdeTestFile(WorkspacePath, WorkspaceManifest);
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  var Opened: IdeModel := InitializeIdeFromArguments([WorkspacePath]);
  AssertTrue(Std.Option.IsSome(Opened.Workspace));
  var Checked: IdeModel := UpdateIde(Opened, TuiMsgAction(CheckControlId(), CheckAction()), Cmd);
  AssertSuccessfulProcess(Checked);
  AssertTrue(Std.Str.Contains(Checked.MessageText, 'Check exit code: 0'));
  Cmd.Reset();
  var Ran: IdeModel := UpdateIde(Checked, TuiMsgAction(RunControlId(), RunAction()), Cmd);
  AssertSuccessfulProcess(Ran);
  AssertTrue(Std.Str.Contains(Ran.MessageText, 'workspace process ok'));
  AssertTrue(Std.Option.IsSome(Ran.Workspace))
end.
