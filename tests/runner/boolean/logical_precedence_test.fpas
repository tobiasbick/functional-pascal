program LogicalPrecedenceTest;

uses Std.Test as Test;

function TryComparison(): option of boolean;
begin
  return Some(try Some(2) + 1 = 3);
end function;

begin
  const Count: integer := 2;
  Test.AssertFalse(not Count > 0);
  Test.AssertTrue(not Count = 3);
  Test.AssertFalse(not Count in [1, 2, 3]);
  Test.AssertTrue(1 < Count and Count < 3 and Count = 2);
  Test.AssertTrue(Count < 1 or Count > 1 or Count = 0);
  Test.AssertFalse(Count = 2 xor Count = 3 xor Count < 3);
  Test.AssertTrue(not false and true);
  Test.AssertTrue(not not Count > 0);
  Test.AssertTrue((not false) = true);
  Test.AssertFalse((true or false) and false);
  Test.AssertTrue(true or (false and false));
  Test.AssertFalse(false and 1 div 0 > 0);
  Test.AssertTrue(true or 1 div 0 > 0);
  Test.AssertTrue(TryComparison() = Some(true));
end.
