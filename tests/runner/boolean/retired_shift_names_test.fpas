program RetiredShiftNamesTest;

uses Std.Bits as Bits, Std.Test as Test;

type Values = record
  shl: integer;
  shr: integer;
end record;

function shl(Value: integer): integer;
begin
  return Value + 1;
end function;

function shr(Value: integer): integer;
begin
  return Value - 1;
end function;

function Add(shl: integer; shr: integer): integer;
begin
  return SHL + SHR;
end function;

begin
  const Pair: Values := Values(shl := 4, shr := 2);
  Test.AssertEquals(4, ShL(3));
  Test.AssertEquals(2, SHR(3));
  Test.AssertEquals(6, Add(Pair.SHL, Pair.Shr));
  Test.AssertEquals(8, Bits.ShiftLeft(Pair.shl, 1));
  Test.AssertEquals(1, Bits.ShiftRight(Pair.shr, 1));
end.
