program ShortCircuitTest;

uses Std.Math.Bits as Bits, Std.Test as Test;

var Trace: integer := 0;

function Mark(Value: boolean; Digit: integer): boolean;
begin
  Trace := Trace * 10 + Digit;
  return Value;
end function;

function MarkInteger(Value: integer; Digit: integer): integer;
begin
  Trace := Trace * 10 + Digit;
  return Value;
end function;

begin
  Test.AssertFalse(Mark(false, 1) and Mark(true, 2));
  Test.AssertEquals(1, Trace);
  Trace := 0;
  Test.AssertTrue(Mark(true, 1) or Mark(false, 2));
  Test.AssertEquals(1, Trace);
  Trace := 0;
  Test.AssertFalse(Mark(true, 1) and Mark(false, 2));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertTrue(Mark(false, 1) or Mark(true, 2));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertTrue(Mark(false, 1) xor Mark(true, 2));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertFalse((Mark(true, 1) and Mark(false, 2)) and Mark(true, 3));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertTrue((Mark(false, 1) or Mark(true, 2)) or Mark(false, 3));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertTrue((Mark(false, 1) and Mark(true, 2)) or Mark(true, 3));
  Test.AssertEquals(13, Trace);
  Trace := 0;
  Test.AssertEquals(0, Bits.BitAnd(MarkInteger(0, 1), MarkInteger(7, 2)));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertEquals(-1, Bits.BitOr(MarkInteger(-1, 1), MarkInteger(7, 2)));
  Test.AssertEquals(12, Trace);
end.
