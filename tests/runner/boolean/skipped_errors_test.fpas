program SkippedErrorsTest;

uses Std.Test as Test;

function UnexpectedCall(): boolean;
begin
  panic('the right operand must be skipped');
  return true;
end function;

begin
  Test.AssertFalse(false and UnexpectedCall());
  Test.AssertTrue(true or UnexpectedCall());
  Test.AssertFalse(false and (1 div 0 > 0));
  Test.AssertTrue(true or (1 div 0 > 0));
  const Values: array of integer := [];
  Test.AssertFalse(false and (Values[0] = 1));
  Test.AssertTrue(true or (Values[0] = 1));
end.
