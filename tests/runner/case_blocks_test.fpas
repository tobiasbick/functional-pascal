program CaseBlocksTest;

uses Std.Test;

type Message = enum
  Number(Value: integer);
  Empty;
end enum;

var Evaluations: integer := 0;
var Guards: integer := 0;

function Input(): integer;
begin
  Evaluations := Evaluations + 1;
  return 2;
end function;

function Guard(Value: boolean): boolean;
begin
  Guards := Guards + 1;
  return Value;
end function;

function Choose(): integer;
begin
  case Input() of
    when 1, 2 if Guard(false):
      return -1;
    when 2..3 if Guard(true):
      const Answer: integer := 42;
      return Answer;
    when 2:
      return -2;
    else
      return -3;
  end case;
end function;

function MakeScalarReader(): function(): integer;
begin
  const Value: integer := 7;
  return function(): integer begin
    case 0 of
      when 1:
        null;
      else
        const Value: integer := 100;
        AssertEquals(100, Value);
    end case;

    return Value;
  end function;
end function;

function MakeVariantReader(): function(): integer;
begin
  const Value: integer := 8;
  return function(): integer begin
    case Some(0) of
      when None:
        null;
      when Some(_):
        const Value: integer := 200;
        AssertEquals(200, Value);
    end case;

    return Value;
  end function;
end function;

begin
  AssertEquals(42, Choose());
  AssertEquals(1, Evaluations);
  AssertEquals(2, Guards);
  const ScalarReader: function(): integer := MakeScalarReader();
  AssertEquals(7, ScalarReader());
  const VariantReader: function(): integer := MakeVariantReader();
  AssertEquals(8, VariantReader());
  const Value: integer := 7;
  case Message.Number(3) of
    when Message.Number(const N) if N > 0:
      const Value: integer := N;
      begin
        const Value: integer := 9;
        AssertEquals(9, Value);
      end;

      AssertEquals(3, Value);
      case Some(Value) of
        when Some(const V):
          AssertEquals(3, V);
        when None:
          AssertTrue(false);
      end case;
    when Message.Number(const N):
      AssertTrue(false);
    when Message.Empty:
      null;
  end case;

  AssertEquals(7, Value);
  var Sum: integer := 0;
  for I: integer := 1 to 5 do
    case I of
      when 2:
        continue;
      when 5:
        break;
      else
        const Increment: integer := I;
        Sum := Sum + Increment;
    end case;
  end for;

  AssertEquals(8, Sum);
end.
