program ExpressionClosersTest;

uses Std.Test as Test;

type Point = record
  X: integer;
  Y: integer;
end record;

type Holder = record
  Child: Point;
  Reader: function(): integer;
end record;

var BaseCalls: integer := 0;
var FieldOrder: integer := 0;

function Base(): Point;
begin
  BaseCalls := BaseCalls + 1;
  return Point(X := 1, Y := 2);
end function;

function FieldValue(Value: integer): integer;
begin
  FieldOrder := FieldOrder * 10 + Value;
  return Value * 10;
end function;

function Apply(Callback: function(P: Point): integer; P: Point): integer;
begin
  return Callback(P);
end function;

procedure Invoke(Callback: procedure());
begin
  Callback();
end procedure;

function MakeFactory(): function(Value: integer): function(): integer;
begin
  return function(Value: integer): function(): integer begin
    return function(): integer begin
      return Value;
    end function;
  end function;
end function;

function Move(P: Point): Point;
begin
  return P with X := 42; end with;
end function;

begin
  const Original: Point := Point(X := 1, Y := 2);
  const Updated: Point := Base() with X := FieldValue(1); Y := FieldValue(2); end with;

  Test.AssertEquals(1, BaseCalls);
  Test.AssertEquals(12, FieldOrder);
  Test.AssertEquals(10, Updated.X);
  Test.AssertEquals(20, Updated.Y);
  Test.AssertEquals(1, Original.X);
  Test.AssertEquals(2, Original.Y);
  Test.AssertEquals(
    42, Apply(
      function(P: Point): integer begin
        return P.X * 21;
      end function, Original with X := 2; end with
    )
  );
  const Container: Holder := Holder(
    Child := Original, Reader := function(): integer begin
      return 0;
    end function
  );
  const Changed: Holder := Container with Child := Original with X := 7; end with; Reader := function(): integer begin
    return Updated.X;
  end function; end with;

  Test.AssertEquals(7, Changed.Child.X);
  Test.AssertEquals(2, Changed.Child.Y);
  Test.AssertEquals(10, Changed.Reader());
  Test.AssertEquals(1, Container.Child.X);
  Test.AssertEquals(0, Container.Reader());
  var Captured: integer := 0;
  Invoke(
    procedure() begin
      Captured := Captured + 1;
    end procedure
  );
  Test.AssertEquals(1, Captured);
  Invoke(procedure() begin end procedure);
  const Factory: function(Value: integer): function(): integer := MakeFactory();
  const Reader: function(): integer := Factory(42);
  Test.AssertEquals(42, Reader());
  const Moved: Point := Move(Original);
  Test.AssertEquals(42, Moved.X);
  Test.AssertEquals(2, Moved.Y);
end.
