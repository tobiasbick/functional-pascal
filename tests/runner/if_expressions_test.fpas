program IfExpressionsTest;

uses Std.Test as Test;

const Debug: boolean := true;
const Limit: integer := if Debug then 10 else 100 end if;

var Calls: integer := 0;

function Count(Value: integer): integer;
begin
  Calls := Calls + 1;
  return Value;
end function;

function Grade(Points: integer): string;
begin
  return if Points >= 90 then 'A' elsif Points >= 50 then 'B' else 'C' end if;
end function;

function Describe(Value: option of integer): string;
begin
  return case Value of
    when Some(const N): if N > 0 then 'positive' else 'other' end if;
    when None: 'none';
  end case;
end function;

begin
  Test.AssertEquals('A', Grade(95));
  Test.AssertEquals('B', Grade(60));
  Test.AssertEquals('C', Grade(10));
  Test.AssertEquals(3, 1 + if Grade(95) = 'A' then 2 else 5 end if);
  Test.AssertEquals('positive', Describe(Some(3)));
  Test.AssertEquals('other', Describe(Some(-3)));
  Test.AssertEquals('none', Describe(None));
  const Picked: option of integer := if Debug then None else Some(1) end if;
  Test.AssertFalse((Picked is Some(_)));
  const Items: array of integer := if Debug then [] else [1, 2] end if;
  Test.AssertEquals(0, Items.Length());
  Test.AssertEquals(1, if Debug then Count(1) else Count(2) end if);
  Test.AssertEquals(1, Calls);
  const Success: result of (integer, string) := if Debug then Ok(Count(7))
    else Error('reason')
    end if;
  Test.AssertEquals(7, Success.Unwrap());
  Test.AssertEquals(2, Calls);
  const Failure: result of (integer, string) := if Debug then Error('reason')
    else Ok(Count(8))
    end if;
  Test.AssertEquals('reason', case Failure of
    when Ok(_): 'unexpected success';
    when Error(const Reason): Reason;
  end case);
  Test.AssertEquals(2, Calls);
  const Nested: integer := if Debug then if Limit = 10 then 7 else 8 end if else 9 end if;
  Test.AssertEquals(7, Nested);
  case 10 of
    when Limit:
      Test.AssertTrue(true);
    else
      Test.AssertTrue(false);
  end case;
end.
