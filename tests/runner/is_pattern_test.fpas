program IsPatternTest;

uses Std.Test;

type Shape = enum
  Circle(Radius: integer);
  Rect(Width: integer; Height: integer);
  Point;
end enum;

function Describe(S: Shape): string;
begin
  return case S of
    when Shape.Circle(const R) if R > 10: 'large circle';
    when Shape.Circle(_): 'circle';
    when Shape.Rect(const W, const H) if W = H: 'square';
    when Shape.Rect(_, _): 'other';
    when Shape.Point: 'point';
  end case;
end function;

function SumUntilNone(Values: array of option of integer): integer;
begin
  var Index: integer := 0;
  var Total: integer := 0;
  while Index < Values.Length() do
    case Values[Index] of
      when Some(const Value):
        Index := Index + 1;
        if Value = 0 then
          continue;
        end if;

        Total := Total + Value;
      when None:
        break;
    end case;
  end while;

  return Total;
end function;

function Nested(R: result of (option of integer, string)): integer;
begin
  return case R of
    when Ok(Some(const Value)) if Value > 0: Value;
    when Ok(_): 0;
    when Error('stop'): -1;
    when Error(_): 0;
  end case;
end function;

begin
  AssertEquals('large circle', Describe(Shape.Circle(20)));
  AssertEquals('circle', Describe(Shape.Circle(2)));
  AssertEquals('square', Describe(Shape.Rect(3, 3)));
  AssertEquals('other', Describe(Shape.Rect(3, 4)));
  AssertEquals('point', Describe(Shape.Point));
  AssertEquals(6, SumUntilNone([Some(1), Some(2), Some(3), None, Some(9)]));
  AssertEquals(-2, SumUntilNone([Some(1), Some(-5), Some(2), None]));
  AssertEquals(3, SumUntilNone([Some(1), Some(0), Some(2), None]));
  AssertEquals(0, SumUntilNone([]));
  AssertEquals(5, Nested(Ok(Some(5))));
  AssertEquals(0, Nested(Ok(Some(-5))));
  AssertEquals(0, Nested(Ok(None)));
  AssertEquals(-1, Nested(Error('stop')));
  AssertEquals(0, Nested(Error('other')));
end.
