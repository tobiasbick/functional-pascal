program RecordUpdateContextTest;

uses Std.Test as Test;

type Holder = record
  Items: array of integer;
  Tags: dict of string to integer;
  MaybeItems: option of array of integer;
  Lookup: result of (dict of string to integer, string);
end record;

begin
  const Original: Holder := Holder(
    Items := [1, 2],
    Tags := ['old': 1],
    MaybeItems := Some([3]),
    Lookup := Ok(['old': 2])
  );
  const Updated: Holder := Original with Items := []; Tags := [:]; MaybeItems := Some([]); Lookup := Ok([:]); end with;

  Test.AssertEquals(0, Updated.Items.Length());
  Test.AssertEquals(0, Updated.Tags.Length());
  Test.AssertEquals(0, Updated.MaybeItems.Unwrap().Length());
  Test.AssertEquals(0, Updated.Lookup.Unwrap().Length());
  Test.AssertEquals(2, Original.Items.Length());
  Test.AssertEquals(1, Original.Tags.Length());
end.
