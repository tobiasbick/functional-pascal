program RecordUpdateContextTest;

uses Std.Arrays, Std.Dictionaries, Std.Options, Std.Results, Std.Test;

type Holder = record
  Items: array of integer;
  Tags: dict of string to integer;
  MaybeItems: option of array of integer;
  Lookup: result of dict of string to integer, string;
end record;

begin
  var Original: Holder := record
    Items := [1, 2];
    Tags := ['old': 1];
    MaybeItems := Some([3]);
    Lookup := Ok(['old': 2]);
  end;
  var Updated: Holder := Original with Items := []; Tags := [:]; MaybeItems := Some([]); Lookup := Ok([:]); end with;

  AssertEquals(0, Std.Arrays.Length(Updated.Items));
  AssertEquals(0, Std.Dictionaries.Length(Updated.Tags));
  AssertEquals(0, Std.Arrays.Length(Std.Options.Unwrap(Updated.MaybeItems)));
  AssertEquals(0, Std.Dictionaries.Length(Std.Results.Unwrap(Updated.Lookup)));
  AssertEquals(2, Std.Arrays.Length(Original.Items));
  AssertEquals(1, Std.Dictionaries.Length(Original.Tags));
end.
