program RecordUpdateContextTest;

uses Std.Arrays as Arrays;
uses Std.Dictionaries as Dictionaries;
uses Std.Options as Options;
uses Std.Results as Results;
uses Std.Test as Test;

type Holder = record
  Items: array of (integer);
  Tags: dict of (string, integer);
  MaybeItems: Option of (array of (integer));
  Lookup: Result of (dict of (string, integer), string);
end record;

begin
  var Original: Holder := Holder(Items := [1, 2], Tags := ['old': 1], MaybeItems := Option.Some([3]), Lookup := Result.Ok(['old': 2]));
  var Updated: Holder := Original with Items := []; Tags := [:]; MaybeItems := Option.Some([]); Lookup := Result.Ok([:]); end with;

  Test.AssertEquals(0, Arrays.Length(Updated.Items));
  Test.AssertEquals(0, Dictionaries.Length(Updated.Tags));
  Test.AssertEquals(0, Arrays.Length(Options.Unwrap(Updated.MaybeItems)));
  Test.AssertEquals(0, Dictionaries.Length(Results.Unwrap(Updated.Lookup)));
  Test.AssertEquals(2, Arrays.Length(Original.Items));
  Test.AssertEquals(1, Dictionaries.Length(Original.Tags));
end program;
