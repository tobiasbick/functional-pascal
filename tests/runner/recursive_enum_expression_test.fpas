program RecursiveEnumExpressionTest;

uses Std.Test as Test;

type Expr = enum
  Num(Value: integer);
  Add(Left: Expr; Right: Expr);
  Mul(Left: Expr; Right: Expr);
end enum;

function Eval(E: Expr): integer;
begin
  case E of
    when Expr.Num(const Value):
      begin
        return Value;
      end;
    when Expr.Add(const Left, const Right):
      begin
        return Eval(Left) + Eval(Right);
      end;
    when Expr.Mul(const Left, const Right):
      begin
        return Eval(Left) * Eval(Right);
      end;
  end case;
end function;

begin
  Test.AssertEquals(39, Eval(Expr.Mul(Expr.Add(Expr.Num(3), Expr.Num(10)), Expr.Num(3))));
end program;
