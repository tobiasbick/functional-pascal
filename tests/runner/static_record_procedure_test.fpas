program StaticRecordProcedureTest;

uses Std.Test as Test;

type Verifier = record
  static procedure Verify(Value: integer);
  begin
    Test.AssertEquals(42, Value);
  end procedure;
end record;

type VerifierAlias = Verifier;

begin
  Verifier.Verify(42);
  VerifierAlias.Verify(42);
end program;
