program TypeOrderTest;

uses Std.Test;

const InitialState: State := State.Ready;

var Calls: integer := 0;

function NextValue(): integer;
begin
  Calls := Calls + 1;
  return Calls;
end function;

const First: integer := NextValue();

function CreateTeam(): Team;
begin
  return Team.Empty();
end function;

type Team = record
  Members: array of Member;
  Status: State := InitialState;

  static function Empty(): Team;
  begin
    return Team(Members := []);
  end function;

  function IsReady(Self: Team): boolean;
  begin
    return Self.Status = State.Ready;
  end function;
end record;

const Second: integer := NextValue();

type Member = record
  Home: option of Team;
end record;

type State = enum
  Ready;
  Busy;
end enum;

function Identity<T>(Value: T): T;
begin
  return Value;
end function;

function Depth(Value: Chain): integer;
begin
  case Value of
    when Chain.Empty:
      return 0;
    when Chain.Link(const Next):
      return 1 + Depth(Next);
  end case;
end function;

type Chain = enum
  Empty;
  Link(Next: ChainAlias);
end enum;

type ChainAlias = Chain;

begin
  const Group: Team := Identity(CreateTeam());
  const Person: Member := Member(Home := Some(Group));
  const Populated: Team := Group with Members := [Person]; end with;
  const Bound: function(): boolean := Populated.IsReady;
  AssertTrue(Bound());
  AssertTrue(Group.Status = State.Ready);
  AssertEquals(2, Depth(ChainAlias.Link(ChainAlias.Link(ChainAlias.Empty))));
  AssertEquals(1, First);
  AssertEquals(2, Second);
  AssertEquals(2, Calls);
end.
