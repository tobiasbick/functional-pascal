program CanonicalSorting;

uses Std.Text.Format as Conv, Std.Test as Test;

type Rank = distinct integer;

type Small = 0..4;

type Phase = enum
  Last;
  First;
  Middle;
end enum;

type PhaseAlias = Phase;

type Backed = enum
  High = 200;
  Low = 5;
  Mid = 40;
end enum;

function Sorted<T: Comparable>(Items: array of T): array of T;
begin
  return Items.Sort();
end function;

procedure SortValues<T: Numeric>(var Items: array of T);
begin
  Items.SortInPlace();
end procedure;

begin
  const InferredEmpty: array of integer := [].Sort().Reverse().Slice(0, 0);
  Test.AssertEquals(0, InferredEmpty.Length());
  const InferredPush := [].Sort().Push(1);
  Test.AssertEquals(1, InferredPush[0]);
  const InferredConcat := [].Sort().Concat([2]);
  Test.AssertEquals(2, InferredConcat[0]);
  const InferredMap := [].Sort().Map(
    function(Value: integer): string begin
      return 'unused';
    end function
  );
  Test.AssertEquals(0, InferredMap.Length());
  Test.AssertTrue(([].Sort().IndexOf(1) is None));
  const Integers := [-1, 3, -9223372036854775808, 0, -3].Sort();
  Test.AssertEquals(-9223372036854775808, Integers[0]);
  Test.AssertEquals(-3, Integers[1]);
  Test.AssertEquals(-1, Integers[2]);
  Test.AssertEquals(0, Integers[3]);
  Test.AssertEquals(3, Integers[4]);
  const Reals: array of real := [0.0, -0.0, 2.0, -1.0, 0.0, -0.0];
  const SortedReals := Sorted(Reals);
  Test.AssertEquals(-1.0, SortedReals[0]);
  Test.AssertEquals('0.0', Conv.RealToStr(SortedReals[1]));
  Test.AssertEquals('-0.0', Conv.RealToStr(SortedReals[2]));
  Test.AssertEquals('0.0', Conv.RealToStr(SortedReals[3]));
  Test.AssertEquals('-0.0', Conv.RealToStr(SortedReals[4]));
  Test.AssertEquals(2.0, SortedReals[5]);
  Test.AssertEquals('0.0', Conv.RealToStr(Reals[0]));
  var Mutable := Reals;
  SortValues(var Mutable);
  Test.AssertEquals('0.0', Conv.RealToStr(Mutable[1]));
  Test.AssertEquals('-0.0', Conv.RealToStr(Mutable[2]));
  const Flags := Sorted([true, false, true]);
  Test.AssertFalse(Flags[0]);
  Test.AssertTrue(Flags[1]);
  const Words := Sorted(['é', 'z', 'a', '😀']);
  Test.AssertEquals('a', Words[0]);
  Test.AssertEquals('z', Words[1]);
  Test.AssertEquals('é', Words[2]);
  Test.AssertEquals('😀', Words[3]);
  const Ranks: array of Rank := [Rank(3), Rank(-1), Rank(0)];
  const OrderedRanks: array of Rank := Sorted(Ranks);
  Test.AssertTrue(OrderedRanks[0] = Rank(-1));
  Test.AssertTrue(OrderedRanks[1] = Rank(0));
  const Bounds: array of Small := [Small(4), Small(0), Small(2)];
  const OrderedBounds: array of Small := Sorted(Bounds);
  Test.AssertTrue(OrderedBounds[0] = Small(0));
  Test.AssertTrue(OrderedBounds[2] = Small(4));
  var Phases: array of PhaseAlias := [Phase.Middle, Phase.First, Phase.Last];
  const OrderedPhases: array of PhaseAlias := Sorted(Phases);
  Test.AssertTrue(OrderedPhases[0] = Phase.Last);
  Test.AssertTrue(OrderedPhases[1] = Phase.First);
  Test.AssertTrue(OrderedPhases[2] = Phase.Middle);
  Test.AssertTrue(Phase.Last < Phase.First);
  Phases.SortInPlace();
  Test.AssertTrue(Phases[0] = Phase.Last);
  Test.AssertTrue(Phases[2] = Phase.Middle);
  const Empty: array of Phase := [];
  Test.AssertEquals(0, Sorted(Empty).Length());
  const BackedOrder := Sorted([Backed.High, Backed.Low, Backed.Mid]);
  Test.AssertTrue(BackedOrder[0] = Backed.Low);
  Test.AssertTrue(BackedOrder[1] = Backed.Mid);
  Test.AssertTrue(BackedOrder[2] = Backed.High);
  Test.AssertTrue(Backed.Low < Backed.High);
end.
