program T;

uses Std.Console, Std.Arrays;

function IsEven(X: integer): boolean;
begin
  return X mod 2 = 0;
end function;

begin
  const Nums: array of integer := [1, 2, 3, 4, 5];
  const Evens: array of integer := Filter(Nums, IsEven);
  WriteLn(Length(Evens));
  WriteLn(Evens[0]);
  WriteLn(Evens[1]);
end.
