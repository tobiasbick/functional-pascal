program T;

uses Std.Console as Console;
uses Std.Arrays as Arrays;

pure function IsEven(X: integer): boolean;
begin
  return X mod 2 = 0;
end function;

begin
  const Nums: array of (integer) := [1, 3, 5];
  const Evens: array of (integer) := Arrays.Filter(Nums, IsEven);
  Console.WriteLn(Arrays.Length(Evens));
end program;
