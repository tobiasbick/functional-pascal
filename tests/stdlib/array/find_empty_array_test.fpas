program T;

uses Std.Console as Console;
uses Std.Arrays as Arrays;
uses Std.Options as Options;

pure function AlwaysTrue(X: integer): boolean;
begin
  return true;
end function;

begin
  const A: array of (integer) := [];
  const R: Option of (integer) := Arrays.Find(A, AlwaysTrue);
  Console.WriteLn(Options.IsNone(R));
end program;
