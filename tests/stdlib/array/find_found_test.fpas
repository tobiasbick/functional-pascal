program T;

uses Std.Console, Std.Arrays, Std.Options;

function IsGreaterThanThree(X: integer): boolean;
begin
  return X > 3;
end function;

begin
  const A: array of integer := [1, 2, 3, 4, 5];
  const R: option of integer := Find(A, IsGreaterThanThree);
  WriteLn(IsSome(R));
  WriteLn(Unwrap(R));
end.
