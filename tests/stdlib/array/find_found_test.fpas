program T;

uses Std.Console as Console;
uses Std.Arrays as Arrays;
uses Std.Options as Options;

function IsGreaterThanThree(X: integer): boolean;
begin
  return X > 3;
end function;

begin
  var A: array of (integer) := [1, 2, 3, 4, 5];
  var R: Option of (integer) := Arrays.Find(A, IsGreaterThanThree);
  Console.WriteLn(Options.IsSome(R));
  Console.WriteLn(Options.Unwrap(R));
end program;
