program T;

uses Std.Console as Console;
uses Std.Arrays as Arrays;

pure function IsGreaterThanFifteen(X: integer): boolean;
begin
  return X > 15;
end function;

begin
  const A: array of (integer) := [10, 20, 30];
  const Idx: integer := Arrays.FindIndex(A, IsGreaterThanFifteen);
  Console.WriteLn(Idx);
end program;
