program T;

uses Std.Console as Console;
uses Std.Arrays as Arrays;
uses Std.Options as Options;

pure function IsGreaterThanTen(X: integer): boolean;
begin
  return X > 10;
end function;

begin
  const A: array of (integer) := [1, 2, 3];
  const R: Option of (integer) := Arrays.Find(A, IsGreaterThanTen);
  Console.WriteLn(Options.IsNone(R));
end program;
