program T;

uses Std.Console as Console;

function Expand(X: integer): array of integer;
begin
  return [X, X * 10];
end function;

begin
  const R: array of integer := [1, 2, 3].FlatMap(Expand);
  Console.WriteLn(R.Length());
  Console.WriteLn(R[0]);
  Console.WriteLn(R[1]);
  Console.WriteLn(R[4]);
  Console.WriteLn(R[5]);
end.
