program ArrayHigherOrderCallbacksTest;

uses Std.Test;

function Double(Value: integer): integer;
begin
  return Value * 2;
end function;

function IsAboveFour(Value: integer): boolean;
begin
  return Value > 4;
end function;

function Sum(Accumulator: integer; Value: integer): integer;
begin
  return Accumulator + Value;
end function;

begin
  const Values: array of integer := [1, 2, 3, 4];
  const Mapped: array of integer := Values.Map(Double);
  const Filtered: array of integer := Mapped.Filter(IsAboveFour);
  AssertEquals(4, Mapped.Length());
  AssertEquals(2, Mapped[0]);
  AssertEquals(8, Mapped[3]);
  AssertEquals(2, Filtered.Length());
  AssertEquals(6, Filtered[0]);
  AssertEquals(8, Filtered[1]);
  AssertEquals(14, Filtered.Reduce(0, Sum));
  AssertEquals(20, Mapped.Reduce(0, Sum));
end.
