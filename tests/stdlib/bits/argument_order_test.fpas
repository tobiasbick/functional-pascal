program BitArgumentOrderTest;

uses Std.Bits as Bits, Std.Test as Test;

var Trace: integer := 0;

function Mark(Value: integer; Digit: integer): integer;
begin
  Trace := Trace * 10 + Digit;
  return Value;
end function;

begin
  Test.AssertEquals(0, Bits.BitAnd(Mark(0, 1), Mark(7, 2)));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertEquals(-1, Bits.BitOr(Mark(-1, 1), Mark(7, 2)));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertEquals(6, Bits.BitXor(Mark(12, 1), Mark(10, 2)));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertEquals(-13, Bits.BitNot(Mark(12, 1)));
  Test.AssertEquals(1, Trace);
  Trace := 0;
  Test.AssertEquals(4, Bits.ShiftLeft(Mark(1, 1), Mark(2, 2)));
  Test.AssertEquals(12, Trace);
  Trace := 0;
  Test.AssertEquals(-4, Bits.ShiftRight(Mark(-8, 1), Mark(1, 2)));
  Test.AssertEquals(12, Trace);
end.
