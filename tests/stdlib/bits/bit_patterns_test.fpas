program BitPatternsTest;

uses Std.Bits as Bits, Std.Test as Test;

begin
  Test.AssertEquals(8, Bits.BitAnd(12, 10));
  Test.AssertEquals(14, Bits.BitOr(12, 10));
  Test.AssertEquals(6, Bits.BitXor(12, 10));
  Test.AssertEquals(-13, Bits.BitNot(12));
  Test.AssertEquals(-1, Bits.BitNot(0));
  Test.AssertEquals(0, Bits.BitNot(-1));
  const Minimum: integer := -9223372036854775807 - 1;
  const Maximum: integer := 9223372036854775807;
  Test.AssertEquals(0, Bits.BitAnd(Minimum, Maximum));
  Test.AssertEquals(-1, Bits.BitOr(Minimum, Maximum));
  Test.AssertEquals(Maximum, Bits.BitXor(Minimum, -1));
  Test.AssertEquals(Maximum, Bits.BitNot(Minimum));
  Test.AssertEquals(0, Bits.BitAnd(-8, 3));
  Test.AssertEquals(-5, Bits.BitOr(-8, 3));
  Test.AssertEquals(-5, Bits.BitXor(-8, 3));
end.
