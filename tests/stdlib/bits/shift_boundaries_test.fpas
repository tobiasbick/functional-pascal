program ShiftBoundariesTest;

uses Std.Math.Bits as Bits, Std.Test as Test;

begin
  const Minimum: integer := -9223372036854775807 - 1;
  const Maximum: integer := 9223372036854775807;
  Test.AssertEquals(7, Bits.ShiftLeft(7, 0));
  Test.AssertEquals(-8, Bits.ShiftRight(-8, 0));
  Test.AssertEquals(Minimum, Bits.ShiftLeft(Minimum, 0));
  Test.AssertEquals(Maximum, Bits.ShiftRight(Maximum, 0));
  Test.AssertEquals(-4, Bits.ShiftRight(-8, 1));
  Test.AssertEquals(-1, Bits.ShiftRight(-1, 63));
  Test.AssertEquals(-1, Bits.ShiftRight(Minimum, 63));
  Test.AssertEquals(0, Bits.ShiftRight(Maximum, 63));
  Test.AssertEquals(Minimum, Bits.ShiftLeft(1, 63));
  Test.AssertEquals(Minimum, Bits.ShiftLeft(-1, 63));
  Test.AssertEquals(0, Bits.ShiftLeft(Minimum, 1));
  Test.AssertEquals(-2, Bits.ShiftLeft(Maximum, 1));
end.
