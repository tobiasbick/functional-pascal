program CalendarDaysTest;

uses Std.Time.Calendar as Calendar, Std.Test as Test;

begin
  const LeapEve := Calendar.CreateDate(2000, 2, 28).Unwrap();
  const LeapDay := Calendar.CreateDate(2000, 2, 29).Unwrap();
  const March := Calendar.CreateDate(2000, 3, 1).Unwrap();
  Test.AssertTrue(Calendar.AddDays(LeapEve, 1).Unwrap() = LeapDay);
  Test.AssertTrue(Calendar.AddDays(LeapDay, 1).Unwrap() = March);
  Test.AssertTrue(Calendar.AddDays(March, -2).Unwrap() = LeapEve);
  Test.AssertEquals(2, Calendar.DaysBetween(LeapEve, March));
  Test.AssertEquals(-2, Calendar.DaysBetween(March, LeapEve));
  Test.AssertEquals(0, Calendar.DaysBetween(LeapDay, LeapDay));
  Test.AssertTrue(Calendar.AddDays(LeapDay, 0).Unwrap() = LeapDay);
  for Year: integer in [1900, 2100] do
    Test.AssertTrue(
      Calendar.AddDays(Calendar.CreateDate(Year, 2, 28).Unwrap(), 1).Unwrap() =
      Calendar.CreateDate(Year, 3, 1).Unwrap()
    );
  end for;

  Test.AssertTrue(
    Calendar.AddDays(Calendar.CreateDate(2400, 2, 28).Unwrap(), 1).Unwrap() =
    Calendar.CreateDate(2400, 2, 29).Unwrap()
  );
  Test.AssertTrue(
    Calendar.AddDays(Calendar.CreateDate(2023, 12, 31).Unwrap(), 1).Unwrap() =
    Calendar.CreateDate(2024, 1, 1).Unwrap()
  );
  Test.AssertTrue(
    Calendar.AddDays(Calendar.CreateDate(2024, 1, 1).Unwrap(), -1).Unwrap() =
    Calendar.CreateDate(2023, 12, 31).Unwrap()
  );
  const October4 := Calendar.CreateDate(1582, 10, 4).Unwrap();
  Test.AssertTrue(
    Calendar.AddDays(October4, 1).Unwrap() = Calendar.CreateDate(1582, 10, 5).Unwrap()
  );
  Test.AssertEquals(11, Calendar.DaysBetween(October4, Calendar.CreateDate(1582, 10, 15).Unwrap()));
  const First := Calendar.CreateDate(1, 1, 1).Unwrap();
  const Last := Calendar.CreateDate(9999, 12, 31).Unwrap();
  Test.AssertEquals(3652058, Calendar.DaysBetween(First, Last));
  Test.AssertEquals(-3652058, Calendar.DaysBetween(Last, First));
  Test.AssertTrue(Calendar.AddDays(First, 3652058).Unwrap() = Last);
  Test.AssertTrue(Calendar.AddDays(Last, -3652058).Unwrap() = First);
  Test.AssertTrue(
    Calendar.AddDays(First, -1) is Error(Calendar.CalendarError.OutOfRange('Std.Time.Calendar.AddDays'))
  );
  Test.AssertTrue(
    Calendar.AddDays(Last, 1) is Error(Calendar.CalendarError.OutOfRange('Std.Time.Calendar.AddDays'))
  );
  for Delta: integer in [-9223372036854775808, 9223372036854775807] do
    Test.AssertTrue(
      Calendar.AddDays(LeapDay, Delta) is Error(Calendar.CalendarError.OutOfRange('Std.Time.Calendar.AddDays'))
    );
  end for;
end.
