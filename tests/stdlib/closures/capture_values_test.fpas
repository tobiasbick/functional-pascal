program ClosureCaptureTest;

uses Std.Console as Console;
uses Std.Conv as Conv;
uses Std.Test as Test;

function Counter(): function(): integer;
begin
  mutable var Value: integer := 0;
  return function(): integer begin
    Value := Value + 1;
    return Value;
  end function;
end function;

begin
  var Next: function(): integer := Counter();
  Test.AssertEquals('1', Conv.IntToStr(Next()));
  Test.AssertEquals('2', Conv.IntToStr(Next()));
  mutable var Count: integer := 0;
  var Inc: procedure() := procedure() begin
    Count := Count + 1;
  end procedure;

  Inc();
  Test.AssertEquals('1', Conv.IntToStr(Count));
  var Base: integer := 10;
  var Add: function(Value: integer): integer := function(Value: integer): integer begin
    return Base + Value;
  end function;

  Test.AssertEquals('15', Conv.IntToStr(Add(5)));
end program;
