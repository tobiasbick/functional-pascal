program ClosureCaptureTest;

uses Std.Console, Std.Conv, Std.Test;

function Counter(): function(): integer;
begin
  var Value: integer := 0;
  return function(): integer begin
    Value := Value + 1;
    return Value;
  end function;
end function;

begin
  const Next: function(): integer := Counter();
  AssertEquals('1', IntToStr(Next()));
  AssertEquals('2', IntToStr(Next()));
  var Count: integer := 0;
  const Inc: procedure() := procedure() begin
    Count := Count + 1;
  end procedure;

  Inc();
  AssertEquals('1', IntToStr(Count));
  const Base: integer := 10;
  const Add: function(Value: integer): integer := function(Value: integer): integer begin
    return Base + Value;
  end function;

  AssertEquals('15', IntToStr(Add(5)));
end.
