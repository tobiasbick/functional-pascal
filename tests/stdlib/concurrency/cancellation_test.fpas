program CancellationTest;

uses Std.Tasks as Tasks;
uses Std.Test as Test;

begin
  var Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  var Token: Tasks.CancellationToken := Tasks.GetCancellationToken(Source);
  Test.AssertFalse(Tasks.IsCancellationRequested(Token));
  Test.AssertTrue(Tasks.Cancel(Source));
  Test.AssertTrue(Tasks.IsCancellationRequested(Token));
  Test.AssertFalse(Tasks.Cancel(Source));
end program;
