program CancellationTest;

uses Std.Tasks, Std.Test;

begin
  const Source: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Source);
  AssertFalse(IsCancellationRequested(Token));
  AssertTrue(Cancel(Source));
  AssertTrue(IsCancellationRequested(Token));
  AssertFalse(Cancel(Source));
end.
