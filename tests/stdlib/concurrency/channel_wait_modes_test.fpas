program ChannelWaitModesTest;

uses Std.Tasks, Std.Test;

begin
  var Messages: channel of integer := CreateChannel(1);
  case TryReceive(Messages) of
    when Ok(MaybeValue):
      begin
        case MaybeValue of
          when Some(_):
            begin
              Fail('empty channel produced a value');
            end;
          when None:
            begin
            end;
        end case;
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case TrySend(Messages, 7) of
    when Ok(Sent):
      begin
        AssertTrue(Sent);
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case TrySend(Messages, 8) of
    when Ok(Sent):
      begin
        AssertFalse(Sent);
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case ReceiveWithTimeout(Messages, 0) of
    when Ok(Value):
      begin
        AssertEquals(7, Value);
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case ReceiveWithTimeout(Messages, 1) of
    when Ok(_):
      begin
        Fail('empty channel did not time out');
      end;
    when Error(Message):
      begin
        AssertEquals('Channel receive timed out', Message);
      end;
  end case;

  case Send(Messages, 9) of
    when Ok(_):
      begin
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case SendWithTimeout(Messages, 10, 1) of
    when Ok(_):
      begin
        Fail('full channel did not time out');
      end;
    when Error(Message):
      begin
        AssertEquals('Channel send timed out', Message);
      end;
  end case;
end.
