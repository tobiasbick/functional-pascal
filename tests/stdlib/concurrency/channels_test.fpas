program ChannelsTest;

uses Std.Tasks as Tasks, Std.Test as Test;

function SendValues(Messages: channel of integer): boolean;
begin
  case Tasks.Send(Messages, 10) of
    when Ok(const Sent):
      begin
        Test.AssertTrue(Sent);
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;

  case Tasks.Send(Messages, 20) of
    when Ok(const Sent):
      begin
        Test.AssertTrue(Sent);
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;

  return Tasks.CloseChannel(Messages);
end function;

function ReceiveValue(Messages: channel of integer): integer;
begin
  case Tasks.Receive(Messages) of
    when Ok(const Value):
      begin
        return Value;
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
        return 0;
      end;
  end case;
end function;

begin
  scope
    const Messages: channel of integer := Tasks.CreateChannel(1);
    const Producer: task of boolean := go SendValues(Messages);
    Test.AssertEquals(10, ReceiveValue(Messages));
    Test.AssertEquals(20, ReceiveValue(Messages));
    Test.AssertTrue(Tasks.Wait(Producer));
    case Tasks.Receive(Messages) of
      when Ok(_):
        begin
          Test.Fail('closed channel returned an extra value');
        end;
      when Error(const Message):
        begin
          Test.AssertTrue(Message is Tasks.TaskError.Closed(_));
        end;
    end case;

    Test.AssertFalse(Tasks.CloseChannel(Messages));
  end scope;
end.
