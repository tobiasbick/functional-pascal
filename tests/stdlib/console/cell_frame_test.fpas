program CellFrameTest;

uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Test as Test;

function MakeCell(Glyph: string; Foreground: Console.Color; Background: Console.Color): Console.Cell;
begin
  return Console.Cell(glyph := Glyph, foreground := Foreground, background := Background);
end function;

begin
  Console.BeginFrame();
  Console.FillRect(Console.rect(x := 1, y := 1, width := 5, height := 2), MakeCell('.', Console.CrtColor(Console.LightGray), Console.CrtColor(Console.Black)));
  Console.PutCell(2, 1, MakeCell('X', Console.RgbColor(10, 20, 30), Console.Ansi256Color(42)));
  Console.WriteCells(3, 1, [
                             MakeCell('Y', Console.CrtColor(Console.Yellow), Console.CrtColor(Console.Blue)),
                             MakeCell('Z', Console.CrtColor(Console.White), Console.CrtColor(Console.Red))
                           ]);
  Console.Present();
  Test.AssertScreenLine('.XYZ.', 1);
  Test.AssertScreenLine('.....', 2);
  const ReadBack: Console.Cell := Options.Unwrap(Console.GetCell(2, 1));
  const Foreground: Console.Color := ReadBack.foreground;
  const Background: Console.Color := ReadBack.background;
  Test.AssertEquals('X', ReadBack.glyph);
  Test.AssertTrue(Foreground.kind = Console.ColorKind.Rgb);
  Test.AssertEquals(10, Foreground.red);
  Test.AssertTrue(Background.kind = Console.ColorKind.Ansi256);
  Test.AssertEquals(42, Background.index);
end program;
