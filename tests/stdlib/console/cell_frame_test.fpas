program CellFrameTest;

uses Std.Console, Std.Option, Std.Test;

function MakeCell(Glyph: string; Foreground: Color; Background: Color): Cell;
begin
  return record glyph := Glyph; foreground := Foreground; background := Background; end
end;

begin
  BeginFrame();
  FillRect(record x := 1; y := 1; width := 5; height := 2; end, MakeCell('.', CrtColor(LightGray), CrtColor(Black)));
  PutCell(2, 1, MakeCell('X', RgbColor(10, 20, 30), Ansi256Color(42)));
  WriteCells(3, 1, [
                     MakeCell('Y', CrtColor(Yellow), CrtColor(Blue)),
                     MakeCell('Z', CrtColor(White), CrtColor(Red))

                   ]);
  Present();
  AssertScreenLine('.XYZ.', 1);
  AssertScreenLine('.....', 2);
  var ReadBack: Cell := Unwrap(GetCell(2, 1));
  var Foreground: Color := ReadBack.foreground;
  var Background: Color := ReadBack.background;
  AssertEquals('X', ReadBack.glyph);
  AssertTrue(Foreground.kind = ColorKind.Rgb);
  AssertEquals(10, Foreground.red);
  AssertTrue(Background.kind = ColorKind.Ansi256);
  AssertEquals(42, Background.index)
end.
