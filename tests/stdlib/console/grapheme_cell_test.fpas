program GraphemeCellTest;

uses Std.Arrays as Arrays;
uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Test as Test;

begin
  Test.AssertEquals(1, Console.GraphemeWidth('é'));
  Test.AssertEquals(2, Console.GraphemeWidth('👩‍💻'));
  var Graphemes: array of (string) := Console.SplitGraphemes('Aé👩‍💻');
  Test.AssertEquals(3, Arrays.Length(Graphemes));
  Test.AssertEquals('é', Graphemes[1]);
  Test.AssertEquals('👩‍💻', Graphemes[2]);
  var Value: Console.Cell := Console.Cell(glyph := 'é', foreground := Console.CrtColor(7), background := Console.CrtColor(0));
  Console.PutCell(1, 1, Value);
  Test.AssertEquals('é', Options.Unwrap(Console.GetCell(1, 1)).glyph);
end program;
