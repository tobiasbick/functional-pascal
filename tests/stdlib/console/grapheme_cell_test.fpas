program GraphemeCellTest;

uses Std.Console, Std.Test;

begin
  AssertEquals(1, GraphemeWidth('é'));
  AssertEquals(2, GraphemeWidth('👩‍💻'));
  const Graphemes: array of string := SplitGraphemes('Aé👩‍💻');
  AssertEquals(3, Graphemes.Length());
  AssertEquals('é', Graphemes[1]);
  AssertEquals('👩‍💻', Graphemes[2]);
  const Value: Cell := Std.Console.Cell(glyph := 'é', foreground := CrtColor(7), background := CrtColor(0));
  PutCell(1, 1, Value);
  AssertEquals('é', GetCell(1, 1).Unwrap().glyph);
end.
