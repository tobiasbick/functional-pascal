program GraphemeCellTest;

uses Std.Arrays, Std.Console, Std.Options, Std.Test;

begin
  AssertEquals(1, GraphemeWidth('é'));
  AssertEquals(2, GraphemeWidth('👩‍💻'));
  var Graphemes: array of string := SplitGraphemes('Aé👩‍💻');
  AssertEquals(3, Std.Arrays.Length(Graphemes));
  AssertEquals('é', Graphemes[1]);
  AssertEquals('👩‍💻', Graphemes[2]);
  var Value: Cell := record
    glyph := 'é';
    foreground := CrtColor(7);
    background := CrtColor(0);
  end;

  PutCell(1, 1, Value);
  AssertEquals('é', Std.Options.Unwrap(GetCell(1, 1)).glyph)
end.
