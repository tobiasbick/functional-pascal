program CryptoRandomTest;

uses Std.Crypto, Std.Test;

begin
  case RandomBytes(32) of
    when Ok(Bytes):
      begin
        AssertEquals(32, Bytes.Length());
        for Index: integer := 0 to Bytes.Length() - 1 do
          begin
            AssertTrue(Bytes[Index] >= 0);
            AssertTrue(Bytes[Index] <= 255);
          end;
        end for;
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case RandomInt(7, 7) of
    when Ok(Value):
      begin
        AssertEquals(7, Value);
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  AssertTrue(RandomBytes(-1).IsError());
  AssertTrue(RandomBytes(1048577).IsError());
  AssertTrue(RandomInt(2, 1).IsError());
end.
