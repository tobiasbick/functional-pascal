program CryptoRandomTest;

uses Std.Crypto as Crypto, Std.Test as Test;

begin
  case Crypto.RandomBytes(32) of
    when Ok(const Bytes):
      begin
        Test.AssertEquals(32, Bytes.Length());
        for Index: integer := 0 to Bytes.Length() - 1 do
          begin
            Test.AssertTrue(Bytes[Index] >= 0);
            Test.AssertTrue(Bytes[Index] <= 255);
          end;
        end for;
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Crypto.RandomInt(7, 7) of
    when Ok(const Value):
      begin
        Test.AssertEquals(7, Value);
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  Test.AssertTrue((Crypto.RandomBytes(-1) is Error(_)));
  Test.AssertTrue((Crypto.RandomBytes(1048577) is Error(_)));
  Test.AssertTrue((Crypto.RandomInt(2, 1) is Error(_)));
end.
