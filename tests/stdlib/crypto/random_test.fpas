program CryptoRandomTest;

uses Std.Arrays as Arrays;
uses Std.Crypto as Crypto;
uses Std.Results as Results;
uses Std.Test as Test;

begin
  case Crypto.RandomBytes(32) of
    when Result.Ok(const Bytes):
      begin
        Test.AssertEquals(32, Arrays.Length(Bytes));
        for Index: integer := 0 to Arrays.Length(Bytes) - 1 do
          begin
            Test.AssertTrue(Bytes[Index] >= 0);
            Test.AssertTrue(Bytes[Index] <= 255);
          end;
        end for;
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Crypto.RandomInt(7, 7) of
    when Result.Ok(const Value):
      begin
        Test.AssertEquals(7, Value);
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  Test.AssertTrue(Results.IsError(Crypto.RandomBytes(-1)));
  Test.AssertTrue(Results.IsError(Crypto.RandomBytes(1048577)));
  Test.AssertTrue(Results.IsError(Crypto.RandomInt(2, 1)));
end program;
