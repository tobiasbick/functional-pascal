program T;

uses Std.Console as Console;
uses Std.Dictionaries as Dictionaries;
uses Std.Options as Options;

begin
  var D: dict of string to integer := ['Alice': 30, 'Bob': 25];
  var R: option of integer := Dictionaries.Get(D, 'Alice');
  Console.WriteLn(Options.IsSome(R));
  Console.WriteLn(Options.Unwrap(R));
end program;
