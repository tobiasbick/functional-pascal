program T;

uses Std.Console as Console;
uses Std.Dictionaries as Dictionaries;

begin
  var A: dict of (string, integer) := [:];
  var B: dict of (string, integer) := ['X': 1];
  var M: dict of (string, integer) := Dictionaries.Merge(A, B);
  Console.WriteLn(Dictionaries.Length(M));
  Console.WriteLn(M['X']);
end program;
