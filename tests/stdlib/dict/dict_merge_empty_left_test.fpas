program T;

uses Std.Console as Console;
uses Std.Dictionaries as Dictionaries;

begin
  var A: dict of string to integer := [:];
  var B: dict of string to integer := ['X': 1];
  var M: dict of string to integer := Dictionaries.Merge(A, B);
  Console.WriteLn(Dictionaries.Length(M));
  Console.WriteLn(M['X']);
end program;
