program T;

uses Std.Console as Console;
uses Std.Dictionaries as Dictionaries;

begin
  const A: dict of (string, integer) := ['A': 1, 'B': 2];
  const B: dict of (string, integer) := ['B': 9, 'C': 3];
  const M: dict of (string, integer) := Dictionaries.Merge(A, B);
  Console.WriteLn(M['B']);
end program;
