program T;

uses Std.Console as Console;
uses Std.Dictionaries as Dictionaries;

begin
  var A: dict of string to integer := ['A': 1, 'B': 2];
  var B: dict of string to integer := ['B': 9, 'C': 3];
  var M: dict of string to integer := Dictionaries.Merge(A, B);
  Console.WriteLn(M['B']);
end program;
