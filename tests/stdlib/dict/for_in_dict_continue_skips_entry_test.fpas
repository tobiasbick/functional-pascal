program T;

uses Std.Console as Console;
uses Std.Dictionaries as Dictionaries;

begin
  const D: dict of (string, integer) := ['A': 1, 'B': 2, 'C': 3];
  for K: string in D do
    begin
      if K = 'B' then
        begin
          continue;
        end;
      end if;

      Console.WriteLn(K);
    end;
  end for;
end program;
