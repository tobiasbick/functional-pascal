program T;

uses Std.Console as Console;
uses Std.Dictionaries as Dictionaries;
uses Std.Conv as Conv;

begin
  const Outer: dict of (string, integer) := ['a': 1, 'b': 2];
  const Inner: dict of (string, integer) := ['x': 10, 'y': 20];
  for Ko: string in Outer do
    begin
      for Ki: string in Inner do
        begin
          Console.WriteLn(Ko + Ki);
        end;
      end for;
    end;
  end for;
end program;
