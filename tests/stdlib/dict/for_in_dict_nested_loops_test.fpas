program T;

uses Std.Console, Std.Conv;

begin
  const Outer: dict of string to integer := ['a': 1, 'b': 2];
  const Inner: dict of string to integer := ['x': 10, 'y': 20];
  for Ko: string in Outer do
    begin
      for Ki: string in Inner do
        begin
          WriteLn(Ko + Ki);
        end;
      end for;
    end;
  end for;
end.
