program DictionaryReduceCallbackFailureRuntimeError;

uses Std.Dictionaries as Dictionaries;

function FailOnSecond(Acc: integer; Key: string; Value: integer): integer;
begin
  if Key = 'B' then
    begin
      panic('dictionary callback failed');
    end;
  end if;

  return Acc + Value;
end function;

begin
  var Values: dict of (string, integer) := ['A': 1, 'B': 2, 'C': 3];
  var Total: integer := Dictionaries.Reduce(Values, 0, FailOnSecond);
end program;
