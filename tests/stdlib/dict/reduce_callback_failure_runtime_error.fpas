program DictionaryReduceCallbackFailureRuntimeError;

uses Std.Dictionaries;

function FailOnSecond(Acc: integer; Key: string; Value: integer): integer;
begin
  if Key = 'B' then
    begin
      panic('dictionary callback failed');
    end;
  end if;

  return Acc + Value;
end function;

begin
  const Values: dict of string to integer := ['A': 1, 'B': 2, 'C': 3];
  const Total: integer := Reduce(Values, 0, FailOnSecond);
end.
