program DictionaryReduceTest;

uses Std.Conv, Std.Dictionaries, Std.Test;

function Describe(Acc: string; Key: string; Value: integer): string;
begin
  return (((Acc + Key) + ':') + IntToStr(Value)) + ';'
end;

function Sum(Acc: integer; Key: string; Value: integer): integer;
begin
  return Acc + Value
end;

begin
  var Scores: dict of string to integer := ['Ada': 3, 'Bob': 5];
  AssertEquals('Ada:3;Bob:5;', Reduce(Scores, '', Describe));
  AssertEquals(18, Reduce(Scores, 10, Sum));
  var Empty: dict of string to integer := [:];
  AssertEquals('start', Reduce(Empty, 'start', Describe));
  mutable var Current: dict of string to integer := ['A': 1, 'B': 2];
  var Visit: function(Acc: string; Key: string; Value: integer): string := function(Acc: string; Key: string; Value: integer): string begin
    if Key = 'A' then
    begin
      Current['C'] := 3
    end;

    return (Acc + Key) + IntToStr(Value)
  end;

  AssertEquals('A1B2', Reduce(Current, '', Visit));
  AssertEquals(3, Length(Current));
  AssertEquals('A:1;B:2;C:3;', Reduce(Current, '', Describe))
end.
