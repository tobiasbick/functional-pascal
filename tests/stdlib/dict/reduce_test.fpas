program DictionaryReduceTest;

uses Std.Conv as Conv;
uses Std.Dictionaries as Dictionaries;
uses Std.Test as Test;

pure function Describe(Acc: string; Key: string; Value: integer): string;
begin
  return (((Acc + Key) + ':') + Conv.IntToStr(Value)) + ';';
end function;

pure function Sum(Acc: integer; Key: string; Value: integer): integer;
begin
  return Acc + Value;
end function;

begin
  const Scores: dict of (string, integer) := ['Ada': 3, 'Bob': 5];
  Test.AssertEquals('Ada:3;Bob:5;', Dictionaries.Reduce(Scores, '', Describe));
  Test.AssertEquals(18, Dictionaries.Reduce(Scores, 10, Sum));
  const Empty: dict of (string, integer) := [:];
  Test.AssertEquals('start', Dictionaries.Reduce(Empty, 'start', Describe));
  var Current: dict of (string, integer) := ['A': 1, 'B': 2];
  const Snapshot := Current;
  Current['C'] := 3;
  const Visit: pure function(Acc: string; Key: string; Value: integer): string := pure function(Acc: string; Key: string; Value: integer): string begin
    return (Acc + Key) + Conv.IntToStr(Value);
  end function;

  Test.AssertEquals('A1B2', Dictionaries.Reduce(Snapshot, '', Visit));
  Test.AssertEquals(3, Dictionaries.Length(Current));
  Test.AssertEquals('A:1;B:2;C:3;', Dictionaries.Reduce(Current, '', Describe));
end program;
