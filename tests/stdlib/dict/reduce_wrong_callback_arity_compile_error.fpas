program DictionaryReduceWrongCallbackArityCompileError;

uses Std.Dictionaries as Dictionaries;

pure function Wrong(Acc: integer; Value: integer): integer;
begin
  return Acc + Value;
end function;

begin
  const Values: dict of (string, integer) := ['A': 1];
  const Total: integer := Dictionaries.Reduce(Values, 0, Wrong);
end program;
