program EnvMissingVariableTest;

uses Std.Env as Env;
uses Std.Options as Options;
uses Std.Test as Test;

begin
  Test.AssertFalse(Env.Exists('__FPAS_ENV_TEST_MISSING_903B5CF4__'));
  case Env.Get('__FPAS_ENV_TEST_MISSING_903B5CF4__') of
    when Some(_):
      begin
        Test.Fail('expected None for missing environment variable');
      end;
    when None:
      begin
        null;
      end;
  end case;
end program;
