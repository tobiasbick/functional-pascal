program EnvMissingVariableTest;

uses Std.Env, Std.Option, Std.Test;

begin
  AssertFalse(Exists('__FPAS_ENV_TEST_MISSING_903B5CF4__'));
  case Get('__FPAS_ENV_TEST_MISSING_903B5CF4__') of
    Some(_):
    begin
      Fail('expected None for missing environment variable')
    end;
    None:
    begin
    end
  end
end.
