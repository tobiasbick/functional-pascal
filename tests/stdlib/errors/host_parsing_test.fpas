program HostParsing;

uses Std.Io.Fs as Fs, Std.Text.Parse as Parse, Std.Test as Test, Std.Os.Errors as Errors;

begin
  Test.AssertTrue(
    Parse.Int('9223372036854775808') is Error(Parse.ParseError.OutOfRange('integer', _))
  );
  Test.AssertTrue(
    Parse.Int('999999999999999999999x') is Error(Parse.ParseError.InvalidSyntax('integer', _))
  );
  Test.AssertTrue(
    Fs.ReadText('__fpas_ap475_missing__') is Error(Fs.FsError.FileNotFound('__fpas_ap475_missing__', Errors.HostError.Failure('Std.Io.Fs.ReadText', _, Some(_), Some(_), _)))
  );
end.
