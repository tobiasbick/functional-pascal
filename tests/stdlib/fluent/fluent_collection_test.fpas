program FluentCollectionTest;

uses Std.Encoding.Json as Json, Std.Test as Test;

function IsEven(X: integer): boolean;
begin
  return X mod 2 = 0;
end function;

function Double(X: integer): integer;
begin
  return X * 2;
end function;

function Sum(Acc: integer; X: integer): integer;
begin
  return Acc + X;
end function;

function AddEntry(Acc: integer; Key: string; Value: integer): integer;
begin
  return Acc + Value;
end function;

function Upper(C: string): string;
begin
  return C.ToUpper();
end function;

function MakeNumbers(): array of integer;
begin
  return [1, 2];
end function;

function Apply(X: integer; Operation: function(Value: integer): integer): integer;
begin
  return Operation(X);
end function;

begin
  const Numbers: array of integer := [1, 2, 3, 4];
  Test.AssertEquals(12, Numbers.Filter(IsEven).Map(Double).Reduce(0, Sum));
  Test.AssertEquals(4, Double(2));
  const Scores: dict of string to integer := ['A': 2, 'B': 3];
  Test.AssertEquals(5, Scores.Reduce(0, AddEntry));
  Test.AssertTrue((Scores.Get('A') is Some(_)));
  Test.AssertEquals('AB', ('ab').Map(Upper));
  Test.AssertEquals(2, MakeNumbers().Length());
  Test.AssertTrue((Json.Parse('1') is Ok(_)));
  const DoubleValue: function(X: integer): integer := Double;
  Test.AssertEquals(6, DoubleValue(3));
  Test.AssertEquals(8, Apply(4, Double));
end.
