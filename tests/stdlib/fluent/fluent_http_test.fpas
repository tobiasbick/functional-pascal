program FluentHttpTest;

uses Std.Conv, Std.Http, Std.Net, Std.Net.Utf8, Std.Tasks, Std.Test;

function FetchText(Url: string): result of string, string;
begin
  return Std.Http.Send(Request.Get(Url)).AndThen(BodyText);
end function;

function Handle(RequestValue: ServerRequest): ServerResponse;
begin
  var ResponseValue: ServerResponse := ServerResponse.Create(200, 'OK');
  if (RequestValue.Method <> 'GET') or (RequestValue.Target <> '/fluent') then
    begin
      ResponseValue.Body := Std.Net.Utf8.Encode('unexpected request');
      return ResponseValue;
    end;
  end if;

  ResponseValue.Body := Std.Net.Utf8.Encode('hello fluent');
  return ResponseValue;
end function;

function ExerciseHttp(): result of boolean, string;
begin
  const ListenerValue: Listener := try Listen('127.0.0.1', 0);
  const Address: NetworkAddress := try ListenerLocalAddress(ListenerValue);
  var Options: ServerOptions := ServerOptions.Create();
  Options.MaxRequests := 1;
  const ServerTask: task := go Serve(ListenerValue, Options, Handle);
  const Url: string := ('http://127.0.0.1:' + IntToStr(Address.Port)) + '/fluent';
  const Text: string := try FetchText(Url);
  AssertEquals('hello fluent', Text);
  const Served: boolean := try Wait(ServerTask);
  const Closed: boolean := try CloseListener(ListenerValue);
  return Ok(Served and Closed);
end function;

begin
  case ExerciseHttp() of
    when Ok(const Succeeded):
      begin
        AssertTrue(Succeeded);
      end;
    when Error(const Message):
      begin
        Fail(Message);
      end;
  end case;
end.
