program FluentMutationTaskTest;

uses Std.Arrays, Std.Math, Std.Tasks, Std.Test;

function Add(X: integer; Y: integer): integer;
begin
  return X + Y;
end function;

begin
  var Items: array of integer := [1, 2];
  Items.Push(3);
  AssertEquals(3, Items.Pop());
  AssertEquals(2, Items.Length());
  const Job: task := go (20).Add(22);
  AssertEquals(42, Wait(Job));
  const IntrinsicTask: task := go (-2).Abs();
  AssertEquals(2, Wait(IntrinsicTask));
end.
