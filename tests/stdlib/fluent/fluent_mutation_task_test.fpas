program FluentMutationTaskTest;

uses Std.Math as Math, Std.Tasks as Tasks, Std.Test as Test;

function Add(X: integer; Y: integer): integer;
begin
  return X + Y;
end function;

begin
  scope
    var Items: array of integer := [1, 2];
    Items.PushInPlace(3);
    Test.AssertEquals(3, Items.PopInPlace());
    Test.AssertEquals(2, Items.Length());
    const Job: task of integer := go Add(20, 22);
    Test.AssertEquals(42, Tasks.Wait(Job));
    const IntrinsicTask: task of integer := go Math.Abs(-2);
    Test.AssertEquals(2, Tasks.Wait(IntrinsicTask));
  end scope;
end.
