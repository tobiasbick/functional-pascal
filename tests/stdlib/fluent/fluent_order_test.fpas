program FluentOrderTest;

uses Std.Test as Test;

var Visits: array of integer := [];

function Visit(Value: integer): integer;
begin
  Visits.PushInPlace(Value);
  return Value;
end function;

function Add(Left: integer; Right: integer): integer;
begin
  return Left + Right;
end function;

begin
  Test.AssertEquals(3, Add(Visit(1), Visit(2)));
  Test.AssertEquals(2, Visits.Length());
  Test.AssertEquals(1, Visits[0]);
  Test.AssertEquals(2, Visits[1]);
end.
