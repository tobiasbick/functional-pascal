program FluentOrderTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;

mutable var Visits: array of (integer) := [];

function Visit(Value: integer): integer;
begin
  Arrays.Push(Visits, Value);
  return Value;
end function;

function Add(Left: integer; Right: integer): integer;
begin
  return Left + Right;
end function;

begin
  Test.AssertEquals(3, (Visit(1)).Add(Visit(2)));
  Test.AssertEquals(2, Arrays.Length(Visits));
  Test.AssertEquals(1, Visits[0]);
  Test.AssertEquals(2, Visits[1]);
end program;
