program FluentRecordsTest;

uses Std.Tasks, Std.Test;

function Double(X: integer): integer;
begin
  return X * 2;
end function;

type Box = record
  Value: integer;
  Callback: function(X: integer): integer;

  function Add(Self: Box; X: integer): integer;
  begin
    return Self.Value + X;
  end function;
end record;

function ValueOf(B: Box): integer;
begin
  return B.Value;
end function;

begin
  const Item: Box := Box(Value := 3, Callback := Double);
  AssertEquals(5, Item.Add(2));
  AssertEquals(5, ValueOf(Item) + 2);
  AssertEquals(4, Item.Callback(2));
  AssertEquals(6, (Item).Callback(3));
  const Bound: function(X: integer): integer := Item.Add;
  AssertEquals(5, Bound(2));
  const NamedTask: task := go Item.Add(4);
  AssertEquals(7, Wait(NamedTask));
  const PostfixTask: task := go (Item).Add(5);
  AssertEquals(8, Wait(PostfixTask));
  const FieldTask: task := go Item.Callback(6);
  AssertEquals(12, Wait(FieldTask));
  const PostfixFieldTask: task := go (Item).Callback(7);
  AssertEquals(14, Wait(PostfixFieldTask));
end.
