program FluentRecordsTest;

uses Std.Tasks as Tasks;
uses Std.Test as Test;

function Double(X: integer): integer;
begin
  return X * 2;
end function;

type Box = record
  Value: integer;
  Callback: function(X: integer): integer;

  function Add(Self: Box; X: integer): integer;
  begin
    return Self.Value + X;
  end function;
end record;

function ValueOf(B: Box): integer;
begin
  return B.Value;
end function;

begin
  var Item: Box := record
    Value := 3;
    Callback := Double;
  end record;

  Test.AssertEquals(5, Item.Add(2));
  Test.AssertEquals(5, Item.ValueOf() + 2);
  Test.AssertEquals(4, Item.Callback(2));
  Test.AssertEquals(6, (Item).Callback(3));
  var Bound: function(X: integer): integer := Item.Add;
  Test.AssertEquals(5, (2).Bound());
  var NamedTask: task := go Item.Add(4);
  Test.AssertEquals(7, Tasks.Wait(NamedTask));
  var PostfixTask: task := go (Item).Add(5);
  Test.AssertEquals(8, Tasks.Wait(PostfixTask));
  var FieldTask: task := go Item.Callback(6);
  Test.AssertEquals(12, Tasks.Wait(FieldTask));
  var PostfixFieldTask: task := go (Item).Callback(7);
  Test.AssertEquals(14, Tasks.Wait(PostfixFieldTask));
end program;
