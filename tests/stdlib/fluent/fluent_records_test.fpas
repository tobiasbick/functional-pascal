program FluentRecordsTest;

uses Std.Tasks as Tasks, Std.Test as Test;

function Double(X: integer): integer;
begin
  return X * 2;
end function;

type Box = record
  Value: integer;
  Callback: function(X: integer): integer;

  function Add(Self: Box; X: integer): integer;
  begin
    return Self.Value + X;
  end function;
end record;

function ValueOf(B: Box): integer;
begin
  return B.Value;
end function;

begin
  scope
    const Item: Box := Box(Value := 3, Callback := Double);
    Test.AssertEquals(5, Item.Add(2));
    Test.AssertEquals(5, ValueOf(Item) + 2);
    Test.AssertEquals(4, Item.Callback(2));
    Test.AssertEquals(6, (Item).Callback(3));
    const Bound: function(X: integer): integer := Item.Add;
    Test.AssertEquals(5, Bound(2));
    const NamedTask: task of integer := go Item.Add(4);
    Test.AssertEquals(7, Tasks.Wait(NamedTask));
    const PostfixTask: task of integer := go (Item).Add(5);
    Test.AssertEquals(8, Tasks.Wait(PostfixTask));
    const FieldTask: task of integer := go Item.Callback(6);
    Test.AssertEquals(12, Tasks.Wait(FieldTask));
    const PostfixFieldTask: task of integer := go (Item).Callback(7);
    Test.AssertEquals(14, Tasks.Wait(PostfixFieldTask));
  end scope;
end.
