program NativeCallableCycles;

uses Std.Test as Test;

function Make(): function(): integer;
begin
  const Payload := 'abcdefgh'.RepeatStr(8192);
  var Size: function(): integer := function(): integer begin
    return 0;
  end function;
  const Keep := function(): integer begin
    return Size() + Payload.Length();
  end function;
  const Wrap: function(Value: function(): integer): option of function(): integer := Some;
  const Items := [Wrap(Keep).Unwrap()];
  Size := Items.Length;
  return Size;
end function;

begin
  for Round: integer := 1 to 12 do
    const Size := Make();
    Test.AssertEquals(1, Size());
    const Alias := Size;
    Test.AssertEquals(1, Alias());
  end for;
end.
