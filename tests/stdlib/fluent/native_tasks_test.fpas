program NativeTasksTest;

uses Std.Tasks as Tasks, Std.Test as Test;

var Trace: string := '';

function Text(): string;
begin
  Trace := Trace + 'R';
  return 'é😀ab';
end function;

function Number(Mark: string; Value: integer): integer;
begin
  Trace := Trace + Mark;
  return Value;
end function;

function Empty(): array of integer;
begin
  Trace := Trace + 'E';
  return [];
end function;

begin
  scope
    const PartTask: task of string := go Text()
                                           .Slice(Len := Number('L', 2), Start := Number('S', 1));
    Test.AssertEquals('RLS', Trace);
    Test.AssertEquals('😀a', Tasks.Wait(PartTask));
    const EmptyTask: task of boolean := go Empty().IsEmpty();
    Test.AssertTrue(Tasks.Wait(EmptyTask));
    Test.AssertEquals('RLSE', Trace);
    const CopiesTask: task of array of string := go array.Fill(Count := 2, Value := 'x');
    Test.AssertEquals('xx', Tasks.Wait(CopiesTask).Join(''));
    const CharacterTask: task of string := go string.Chr(N := 65);
    Test.AssertEquals('A', Tasks.Wait(CharacterTask));
  end scope;
end.
