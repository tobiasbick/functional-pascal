program FsBinaryRoundtripTest;

uses Std.Bytes as ByteStorage, Std.Io.Fs as Fs, Std.Tasks as Tasks, Std.Test as Test;

procedure AssertBytes(Expected: ByteStorage.ByteBuffer; Actual: ByteStorage.ByteBuffer);
begin
  Test.AssertEquals(Expected.Length(), Actual.Length());
  for Index: integer := 0 to Expected.Length() - 1 do
    Test.AssertEquals(Expected[Index], Actual[Index]);
  end for;
end procedure;

function RoundTrip(FileName: string; Bytes: ByteStorage.ByteBuffer): result of (ByteStorage.ByteBuffer, Fs.FsError);
begin
  discard try Fs.WriteBytes(FileName, Bytes);
  return Fs.ReadBytes(FileName);
end function;

begin
  const FileName := Test.ScratchDir() + '/binary-roundtrip.bin';
  var Bytes: ByteStorage.ByteBuffer := ByteStorage.Create(256).Unwrap();
  for Value: integer := 0 to 255 do
    discard Bytes.SetAtInPlace(Value, Value).Unwrap();
  end for;

  Test.AssertTrue(Fs.WriteBytes(FileName, Bytes).Unwrap());
  AssertBytes(Bytes, Fs.ReadBytes(FileName).Unwrap());
  Test.AssertEquals(256, Fs.FileSize(FileName).Unwrap());
  Test.AssertTrue(Fs.ReadText(FileName) is Error(Fs.FsError.InvalidEncoding(_, _)));

  Test.AssertTrue(
    Fs.WriteBytes(FileName, ByteStorage.FromArray([0, 255, 128, 13, 10]).Unwrap()).Unwrap()
  );
  AssertBytes(
    ByteStorage.FromArray([0, 255, 128, 13, 10]).Unwrap(),
    Fs.ReadBytes(FileName).Unwrap()
  );
  Test.AssertEquals(5, Fs.FileSize(FileName).Unwrap());
  Test.AssertTrue(Fs.WriteBytes(FileName, ByteStorage.FromArray([]).Unwrap()).Unwrap());
  Test.AssertEquals(0, Fs.ReadBytes(FileName).Unwrap().Length());
  Test.AssertEquals(0, Fs.FileSize(FileName).Unwrap());
  const EmptyFile := Test.ScratchDir() + '/binary-empty.bin';
  Test.AssertTrue(Fs.WriteBytes(EmptyFile, ByteStorage.FromArray([]).Unwrap()).Unwrap());
  Test.AssertTrue(Fs.IsFile(EmptyFile));
  Test.AssertEquals(0, Fs.ReadBytes(EmptyFile).Unwrap().Length());

  scope
    const Job: task of result of (ByteStorage.ByteBuffer, Fs.FsError) := go RoundTrip(
      FileName, ByteStorage.FromArray([255, 0, 254]).Unwrap()
    );
    AssertBytes(ByteStorage.FromArray([255, 0, 254]).Unwrap(), Tasks.Wait(Job).Unwrap());
    const ReadJob: task of result of (ByteStorage.ByteBuffer, Fs.FsError) := go Fs.ReadBytes(
      FileName
    );
    AssertBytes(ByteStorage.FromArray([255, 0, 254]).Unwrap(), Tasks.Wait(ReadJob).Unwrap());
  end scope;
end.
