program FsBinaryValidationTest;

uses Std.Bytes as ByteStorage, Std.Io.Fs as Fs, Std.Test as Test;

procedure AssertOriginal(FileName: string);
begin
  const Bytes := Fs.ReadBytes(FileName).Unwrap();
  Test.AssertTrue(Bytes = ByteStorage.FromArray([77, 0, 255, 10]).Unwrap());
end procedure;

function StoreCount(FileName: string; Bytes: ByteStorage.ByteBuffer): result of (integer, Fs.FsError);
begin
  discard try Fs.WriteBytes(FileName, Bytes);
  return Ok(Bytes.Length());
end function;

begin
  const FileName := Test.ScratchDir() + '/binary-validation.bin';
  const Missing := Test.ScratchDir() + '/binary-must-stay-absent.bin';
  Test.AssertTrue(
    Fs.WriteBytes(FileName, ByteStorage.FromArray([77, 0, 255, 10]).Unwrap()).Unwrap()
  );
  Test.AssertTrue(
    ByteStorage.FromArray([1, 2, -1, 256]) is Error(ByteStorage.BufferError.InvalidByte(2, -1))
  );
  Test.AssertTrue(
    ByteStorage.FromArray([1, 2, 256, -1]) is Error(ByteStorage.BufferError.InvalidByte(2, 256))
  );
  AssertOriginal(FileName);
  Test.AssertFalse(Fs.Exists(Missing));
  // Valid buffers still obey the smaller file-transfer limit before touching a target.
  const TooMany := ByteStorage.Create(1048578).Unwrap();
  Test.AssertTrue(
    Fs.WriteBytes(FileName, TooMany) is Error(Fs.FsError.LimitExceeded('Std.Io.Fs.WriteBytes', 1048576))
  );
  AssertOriginal(FileName);
  Test.AssertTrue(
    StoreCount(Missing, TooMany) is Error(Fs.FsError.LimitExceeded('Std.Io.Fs.WriteBytes', 1048576))
  );
  Test.AssertFalse(Fs.Exists(Missing));
end.
