program FsCreateDirAllTest;

uses Std.Fs, Std.Results, Std.Test;

begin
  var Root: string := ScratchDir() + '/create-dir-all';
  var Leaf: string := Root + '/parent/leaf';
  AssertTrue(Unwrap(CreateDirAll(Leaf)));
  AssertTrue(IsDir(Leaf));
  // An existing directory is success, unlike CreateDir.
  AssertTrue(Unwrap(CreateDirAll(Leaf)));
  AssertTrue(IsError(CreateDir(Leaf)));
  var Blocking: string := Root + '/blocking-file';
  AssertTrue(Unwrap(WriteText(Blocking, 'not a directory')));
  AssertTrue(IsError(CreateDirAll(Blocking)));
  AssertTrue(IsError(CreateDirAll(Blocking + '/child')))
end.
