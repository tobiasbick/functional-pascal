program FsCreateDirAllTest;

uses Std.Fs as Fs, Std.Test as Test;

begin
  const Root: string := Test.ScratchDir() + '/create-dir-all';
  const Leaf: string := Root + '/parent/leaf';
  Test.AssertTrue(Fs.CreateDirAll(Leaf).Unwrap());
  Test.AssertTrue(Fs.IsDir(Leaf));
  // An existing directory is success, unlike CreateDir.
  Test.AssertTrue(Fs.CreateDirAll(Leaf).Unwrap());
  Test.AssertTrue((Fs.CreateDir(Leaf) is Error(_)));
  const Blocking: string := Root + '/blocking-file';
  Test.AssertTrue(Fs.WriteText(Blocking, 'not a directory').Unwrap());
  Test.AssertTrue((Fs.CreateDirAll(Blocking) is Error(_)));
  Test.AssertTrue((Fs.CreateDirAll(Blocking + '/child') is Error(_)));
end.
