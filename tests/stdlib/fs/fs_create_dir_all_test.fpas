program FsCreateDirAllTest;

uses Std.Fs, Std.Test;

begin
  const Root: string := ScratchDir() + '/create-dir-all';
  const Leaf: string := Root + '/parent/leaf';
  AssertTrue(CreateDirAll(Leaf).Unwrap());
  AssertTrue(IsDir(Leaf));
  // An existing directory is success, unlike CreateDir.
  AssertTrue(CreateDirAll(Leaf).Unwrap());
  AssertTrue(CreateDir(Leaf).IsError());
  const Blocking: string := Root + '/blocking-file';
  AssertTrue(WriteText(Blocking, 'not a directory').Unwrap());
  AssertTrue(CreateDirAll(Blocking).IsError());
  AssertTrue(CreateDirAll(Blocking + '/child').IsError());
end.
