program FsDeleteFileTest;

uses Std.Fs as Fs, Std.Test as Test;

begin
  const Path: string := Test.ScratchDir() + '/delete-file.txt';
  Test.AssertTrue(Fs.WriteTextAtomic(Path, 'obsolete').Unwrap());
  Test.AssertTrue(Fs.DeleteFile(Path).Unwrap());
  Test.AssertFalse(Fs.Exists(Path));
  Test.AssertTrue((Fs.DeleteFile(Path) is Error(_)));
  Test.AssertTrue((Fs.DeleteFile(Test.ScratchDir()) is Error(_)));
  Test.AssertTrue(Fs.IsDir(Test.ScratchDir()));
end.
