program FsDeleteFileTest;

uses Std.Fs as Fs;
uses Std.Results as Results;
uses Std.Test as Test;

begin
  const Path: string := Test.ScratchDir() + '/delete-file.txt';
  Test.AssertTrue(Results.Unwrap(Fs.WriteTextAtomic(Path, 'obsolete')));
  Test.AssertTrue(Results.Unwrap(Fs.DeleteFile(Path)));
  Test.AssertFalse(Fs.Exists(Path));
  Test.AssertTrue(Results.IsError(Fs.DeleteFile(Path)));
  Test.AssertTrue(Results.IsError(Fs.DeleteFile(Test.ScratchDir())));
  Test.AssertTrue(Fs.IsDir(Test.ScratchDir()));
end program;
