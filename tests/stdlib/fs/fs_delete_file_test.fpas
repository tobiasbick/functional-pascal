program FsDeleteFileTest;

uses Std.Fs, Std.Test;

begin
  const Path: string := ScratchDir() + '/delete-file.txt';
  AssertTrue(WriteTextAtomic(Path, 'obsolete').Unwrap());
  AssertTrue(DeleteFile(Path).Unwrap());
  AssertFalse(Exists(Path));
  AssertTrue(DeleteFile(Path).IsError());
  AssertTrue(DeleteFile(ScratchDir()).IsError());
  AssertTrue(IsDir(ScratchDir()));
end.
