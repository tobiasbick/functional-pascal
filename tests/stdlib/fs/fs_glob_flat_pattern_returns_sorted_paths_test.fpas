program FsGlobFlatPatternReturnsSortedPathsTest;

uses Std.Arrays, Std.Fs, Std.Test;

begin
  var Prefix: string := ScratchDir() + '/glob-flat-';
  case WriteText(Prefix + 'b.txt', '') of
    when Ok(_):
      begin
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case WriteText(Prefix + 'a.txt', '') of
    when Ok(_):
      begin
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case Glob(Prefix + '*.txt') of
    when Ok(Paths):
      begin
        AssertEquals(2, Std.Arrays.Length(Paths));
        AssertEquals(Prefix + 'a.txt', Paths[0]);
        AssertEquals(Prefix + 'b.txt', Paths[1]);
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end.
