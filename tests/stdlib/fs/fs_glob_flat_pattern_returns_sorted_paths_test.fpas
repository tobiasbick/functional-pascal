program FsGlobFlatPatternReturnsSortedPathsTest;

uses Std.Fs as Fs, Std.Test as Test;

begin
  const Prefix: string := Test.ScratchDir() + '/glob-flat-';
  case Fs.WriteText(Prefix + 'b.txt', '') of
    when Ok(_):
      begin
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.WriteText(Prefix + 'a.txt', '') of
    when Ok(_):
      begin
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.Glob(Prefix + '*.txt') of
    when Ok(const Paths):
      begin
        Test.AssertEquals(2, Paths.Length());
        Test.AssertEquals(Prefix + 'a.txt', Paths[0]);
        Test.AssertEquals(Prefix + 'b.txt', Paths[1]);
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end.
