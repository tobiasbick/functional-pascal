program FsGlobFlatPatternReturnsSortedPathsTest;

uses Std.Fs, Std.Test;

begin
  const Prefix: string := ScratchDir() + '/glob-flat-';
  case WriteText(Prefix + 'b.txt', '') of
    when Ok(_):
      begin
      end;
    when Error(const Message):
      begin
        Fail(Message);
      end;
  end case;

  case WriteText(Prefix + 'a.txt', '') of
    when Ok(_):
      begin
      end;
    when Error(const Message):
      begin
        Fail(Message);
      end;
  end case;

  case Glob(Prefix + '*.txt') of
    when Ok(const Paths):
      begin
        AssertEquals(2, Paths.Length());
        AssertEquals(Prefix + 'a.txt', Paths[0]);
        AssertEquals(Prefix + 'b.txt', Paths[1]);
      end;
    when Error(const Message):
      begin
        Fail(Message);
      end;
  end case;
end.
