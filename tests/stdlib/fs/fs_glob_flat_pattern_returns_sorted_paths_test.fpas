program FsGlobFlatPatternReturnsSortedPathsTest;

uses Std.Arrays as Arrays;
uses Std.Fs as Fs;
uses Std.Test as Test;

begin
  const Prefix: string := Test.ScratchDir() + '/glob-flat-';
  case Fs.WriteText(Prefix + 'b.txt', '') of
    when Result.Ok(_):
      begin
        null;
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.WriteText(Prefix + 'a.txt', '') of
    when Result.Ok(_):
      begin
        null;
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.Glob(Prefix + '*.txt') of
    when Result.Ok(const Paths):
      begin
        Test.AssertEquals(2, Arrays.Length(Paths));
        Test.AssertEquals(Prefix + 'a.txt', Paths[0]);
        Test.AssertEquals(Prefix + 'b.txt', Paths[1]);
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
