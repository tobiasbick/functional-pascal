program FsGlobInvalidPatternReturnsErrorTest;

uses Std.Fs, Std.Test;

begin
  case Glob('[unclosed') of
    when Ok(_):
      begin
        Fail('Expected invalid glob pattern to fail');
      end;
    when Error(const Message):
      begin
        AssertTrue(Message.Contains('Invalid glob pattern'));
      end;
  end case;
end.
