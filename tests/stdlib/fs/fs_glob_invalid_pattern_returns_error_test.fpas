program FsGlobInvalidPatternReturnsErrorTest;

uses Std.Fs as Fs;
uses Std.Str as Str;
uses Std.Test as Test;

begin
  case Fs.Glob('[unclosed') of
    when Ok(_):
      begin
        Test.Fail('Expected invalid glob pattern to fail');
      end;
    when Error(Message):
      begin
        Test.AssertTrue(Str.Contains(Message, 'Invalid glob pattern'));
      end;
  end case;
end program;
