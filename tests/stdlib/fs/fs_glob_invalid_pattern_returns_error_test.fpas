program FsGlobInvalidPatternReturnsErrorTest;

uses Std.Fs as Fs, Std.Test as Test;

begin
  case Fs.Glob('[unclosed') of
    when Ok(_):
      begin
        Test.Fail('Expected invalid glob pattern to fail');
      end;
    when Error(const Message):
      begin
        Test.AssertTrue(Message.Contains('Invalid glob pattern'));
      end;
  end case;
end.
