program FsGlobNoMatchesReturnsEmptyArrayTest;

uses Std.Arrays as Arrays;
uses Std.Fs as Fs;
uses Std.Test as Test;

begin
  case Fs.Glob(Test.ScratchDir() + '/no-match/**/*.fpas') of
    when Ok(Paths):
      begin
        Test.AssertEquals(0, Arrays.Length(Paths));
      end;
    when Error(Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
