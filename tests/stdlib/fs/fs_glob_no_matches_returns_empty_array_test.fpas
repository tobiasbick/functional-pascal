program FsGlobNoMatchesReturnsEmptyArrayTest;

uses Std.Io.Fs as Fs, Std.Test as Test;

begin
  case Fs.Glob(Test.ScratchDir() + '/no-match/**/*.fpas') of
    when Ok(const Paths):
      begin
        Test.AssertEquals(0, Paths.Length());
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;
end.
