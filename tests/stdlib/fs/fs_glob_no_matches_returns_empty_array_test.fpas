program FsGlobNoMatchesReturnsEmptyArrayTest;

uses Std.Fs, Std.Test;

begin
  case Glob(ScratchDir() + '/no-match/**/*.fpas') of
    when Ok(Paths):
      begin
        AssertEquals(0, Paths.Length());
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end.
