program FsGlobRecursivePatternTest;

uses Std.Fs as Fs, Std.Test as Test;

procedure EnsureDir(Path: string);
begin
  if Fs.Exists(Path) then
    begin
      if not Fs.IsDir(Path) then
        begin
          Test.Fail(('Expected directory: ') + Path);
        end;
      end if;

      return;
    end;
  end if;

  case Fs.CreateDir(Path) of
    when Ok(_):
      begin
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end procedure;

begin
  const Root: string := Test.ScratchDir() + '/glob-tree';
  EnsureDir(Root);
  EnsureDir(Root + '/src');
  EnsureDir(Root + '/src/ui');
  case Fs.WriteText(Root + '/src/main.fpas', '') of
    when Ok(_):
      begin
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.WriteText(Root + '/src/ui/menu.fpas', '') of
    when Ok(_):
      begin
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.Glob(Root + '/src/**/*.fpas') of
    when Ok(const Paths):
      begin
        Test.AssertEquals(2, Paths.Length());
        Test.AssertEquals(Root + '/src/main.fpas', Paths[0]);
        Test.AssertEquals(Root + '/src/ui/menu.fpas', Paths[1]);
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end.
