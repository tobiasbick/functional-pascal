program FsGlobRecursivePatternTest;

uses Std.Array, Std.Fs, Std.Test;

const
  Scratch: string := '.temp-data';
  Root: string := Scratch + '/_fpas_glob_tree_';

procedure EnsureDir(Path: string);
begin
  if Exists(Path) then
  begin
    if not IsDir(Path) then
    begin
      Fail(('Expected directory: ') + Path)
    end;
    return
  end;
  case CreateDir(Path) of
    Ok(_):
    begin
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end
end;

begin
  EnsureDir(Scratch);
  EnsureDir(Root);
  EnsureDir(Root + '/src');
  EnsureDir(Root + '/src/ui');
  case WriteText(Root + '/src/main.fpas', '') of
    Ok(_):
    begin
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end;
  case WriteText(Root + '/src/ui/menu.fpas', '') of
    Ok(_):
    begin
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end;
  case Glob(Root + '/src/**/*.fpas') of
    Ok(Paths):
    begin
      AssertEquals(2, Std.Array.Length(Paths));
      AssertEquals(Root + '/src/main.fpas', Paths[0]);
      AssertEquals(Root + '/src/ui/menu.fpas', Paths[1])
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end
end.
