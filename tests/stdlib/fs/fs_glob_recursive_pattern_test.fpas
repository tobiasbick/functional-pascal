program FsGlobRecursivePatternTest;

uses Std.Arrays, Std.Fs, Std.Test;

procedure EnsureDir(Path: string);
begin
  if Exists(Path) then
    begin
      if not IsDir(Path) then
        begin
          Fail(('Expected directory: ') + Path);
        end;
      end if;

      return;
    end;
  end if;

  case CreateDir(Path) of
    when Ok(_):
      begin
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end procedure;

begin
  var Root: string := ScratchDir() + '/glob-tree';
  EnsureDir(Root);
  EnsureDir(Root + '/src');
  EnsureDir(Root + '/src/ui');
  case WriteText(Root + '/src/main.fpas', '') of
    when Ok(_):
      begin
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case WriteText(Root + '/src/ui/menu.fpas', '') of
    when Ok(_):
      begin
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case Glob(Root + '/src/**/*.fpas') of
    when Ok(Paths):
      begin
        AssertEquals(2, Std.Arrays.Length(Paths));
        AssertEquals(Root + '/src/main.fpas', Paths[0]);
        AssertEquals(Root + '/src/ui/menu.fpas', Paths[1]);
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end.
