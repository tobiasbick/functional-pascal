program FsHandleLimitsTest;

uses Std.Bytes as ByteStorage, Std.Io.Fs as Fs, Std.Test as Test;

begin
  const FileName := Test.ScratchDir() + '/handle-limits.bin';
  Test.AssertTrue(Fs.WriteText(FileName, 'xx'.RepeatStr(524288) + 'x'#10).Unwrap());
  const File := Fs.Open(FileName, Fs.FileMode.ReadWrite).Unwrap();
  Test.AssertTrue(Fs.Read(File, 0) is Error(Fs.FsError.InvalidArgument('MaxBytes', _)));
  Test.AssertTrue(Fs.Read(File, -1) is Error(Fs.FsError.InvalidArgument('MaxBytes', _)));
  Test.AssertTrue(
    Fs.Read(File, 1048577) is Error(Fs.FsError.LimitExceeded('Std.Io.Fs.Read', 1048576))
  );
  Test.AssertTrue(
    Fs.Seek(File, -1, Fs.SeekOrigin.Start) is Error(Fs.FsError.InvalidArgument('Offset', _))
  );
  Test.AssertEquals(0, Fs.Tell(File).Unwrap());
  Test.AssertTrue(
    Fs.ReadLine(File) is Error(Fs.FsError.LimitExceeded('Std.Io.Fs.ReadLine', 1048576))
  );
  Test.AssertEquals(0, Fs.Tell(File).Unwrap());
  Test.AssertTrue(
    Fs.ReadLine(File) is Error(Fs.FsError.LimitExceeded('Std.Io.Fs.ReadLine', 1048576))
  );
  Test.AssertEquals(0, Fs.Tell(File).Unwrap());
  const First := Fs.Read(File, 1).Unwrap();
  Test.AssertEquals(1, First.Length());
  Test.AssertEquals(120, First[0]);
  Test.AssertEquals(1, Fs.Tell(File).Unwrap());
  Test.AssertTrue(Fs.ReadLine(File).Unwrap() = Some('xx'.RepeatStr(524288)));
  Test.AssertEquals(1048578, Fs.Tell(File).Unwrap());
  Test.AssertTrue(Fs.ReadLine(File).Unwrap() is None);
  Test.AssertEquals(0, Fs.Seek(File, 0, Fs.SeekOrigin.Start).Unwrap());
  Test.AssertTrue(
    Fs.ReadLine(File) is Error(Fs.FsError.LimitExceeded('Std.Io.Fs.ReadLine', 1048576))
  );
  Test.AssertEquals(1048578, Fs.Seek(File, 0, Fs.SeekOrigin.FileEnd).Unwrap());
  Test.AssertTrue(Fs.ReadLine(File).Unwrap() is None);
  const TooMany := ByteStorage.Create(1048578).Unwrap();
  Test.AssertTrue(
    Fs.Write(File, TooMany) is Error(Fs.FsError.LimitExceeded('Std.Io.Fs.Write', 1048576))
  );
  Test.AssertEquals(1048578, Fs.Tell(File).Unwrap());
  Test.AssertEquals(1048578, Fs.FileSize(FileName).Unwrap());
  Test.AssertTrue(Fs.Close(File).Unwrap());
  Test.AssertTrue(Fs.DeleteFile(FileName).Unwrap());
end.
