// Verifies immediate sorted files/directories, empty results, errors, and task execution.
program FsReadDirTest;

uses Std.Fs as Fs, Std.Tasks as Tasks, Std.Test as Test;

begin
  scope
    const Root: string := Test.ScratchDir() + '/read-dir';
    Test.AssertTrue(Fs.CreateDirAll(Root).Unwrap());
    Test.AssertEquals(0, Fs.ReadDir(Root).Unwrap().Length());
    Test.AssertTrue(Fs.CreateDir(Root + '/b-empty').Unwrap());
    Test.AssertTrue(Fs.CreateDir(Root + '/a-child').Unwrap());
    Test.AssertTrue(Fs.WriteText(Root + '/a-child/nested.txt', 'nested').Unwrap());
    Test.AssertTrue(Fs.WriteText(Root + '/c-file.txt', 'file').Unwrap());
    const Entries: array of string := Fs.ReadDir(Root).Unwrap();
    Test.AssertEquals(3, Entries.Length());
    Test.AssertEquals(Root + '/a-child', Entries[0]);
    Test.AssertEquals(Root + '/b-empty', Entries[1]);
    Test.AssertEquals(Root + '/c-file.txt', Entries[2]);
    Test.AssertTrue(Fs.IsDir(Entries[0]));
    Test.AssertTrue(Fs.IsDir(Entries[1]));
    Test.AssertTrue(Fs.IsFile(Entries[2]));
    Test.AssertTrue((Fs.ReadDir(Root + '/missing') is Error(_)));
    Test.AssertTrue((Fs.ReadDir(Root + '/c-file.txt') is Error(_)));
    Test.AssertTrue((Fs.ReadDir('') is Error(_)));
    const Job: task of result of (array of string, string) := go Fs.ReadDir(Root);
    const FromTask: array of string := Tasks.Wait(Job).Unwrap();
    Test.AssertEquals(3, FromTask.Length());
    for Index: integer := 0 to 2 do
      Test.AssertEquals(Entries[Index], FromTask[Index]);
    end for;
  end scope;
end.
