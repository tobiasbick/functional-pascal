// Verifies immediate sorted files/directories, empty results, errors, and task execution.
program FsReadDirTest;

uses Std.Arrays, Std.Fs, Std.Results, Std.Tasks, Std.Test;

begin
  const Root: string := ScratchDir() + '/read-dir';
  AssertTrue(Unwrap(CreateDirAll(Root)));
  AssertEquals(0, Std.Arrays.Length(Unwrap(ReadDir(Root))));
  AssertTrue(Unwrap(CreateDir(Root + '/b-empty')));
  AssertTrue(Unwrap(CreateDir(Root + '/a-child')));
  AssertTrue(Unwrap(WriteText(Root + '/a-child/nested.txt', 'nested')));
  AssertTrue(Unwrap(WriteText(Root + '/c-file.txt', 'file')));
  const Entries: array of string := Unwrap(ReadDir(Root));
  AssertEquals(3, Std.Arrays.Length(Entries));
  AssertEquals(Root + '/a-child', Entries[0]);
  AssertEquals(Root + '/b-empty', Entries[1]);
  AssertEquals(Root + '/c-file.txt', Entries[2]);
  AssertTrue(IsDir(Entries[0]));
  AssertTrue(IsDir(Entries[1]));
  AssertTrue(IsFile(Entries[2]));
  AssertTrue(IsError(ReadDir(Root + '/missing')));
  AssertTrue(IsError(ReadDir(Root + '/c-file.txt')));
  AssertTrue(IsError(ReadDir('')));
  const Job: task of result of array of string, string := go ReadDir(Root);
  const FromTask: array of string := Unwrap(Std.Tasks.Wait(Job));
  AssertEquals(3, Std.Arrays.Length(FromTask));
  for Index: integer := 0 to 2 do
    AssertEquals(Entries[Index], FromTask[Index]);
  end for;
end.
