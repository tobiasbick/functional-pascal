program FsReadWriteRoundtripTest;

uses Std.Fs as Fs;
uses Std.Test as Test;

begin
  var Path: string := Test.ScratchDir() + '/roundtrip.txt';
  case Fs.WriteText(Path, 'hello fs') of
    when Ok(_):
      begin
        null;
      end;
    when Error(Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  Test.AssertTrue(Fs.Exists(Path));
  Test.AssertTrue(Fs.IsFile(Path));
  case Fs.ReadText(Path) of
    when Ok(Text):
      begin
        Test.AssertEquals('hello fs', Text);
      end;
    when Error(Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
