program FsReadWriteRoundtripTest;

uses Std.Fs, Std.Test;

begin
  var Path: string := ScratchDir() + '/roundtrip.txt';
  case WriteText(Path, 'hello fs') of
    Ok(_):
    begin
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end;

  AssertTrue(Exists(Path));
  AssertTrue(IsFile(Path));
  case ReadText(Path) of
    Ok(Text):
    begin
      AssertEquals('hello fs', Text)
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end
end.
