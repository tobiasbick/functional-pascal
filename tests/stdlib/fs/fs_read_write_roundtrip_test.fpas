program FsReadWriteRoundtripTest;

uses Std.Io.Fs as Fs, Std.Test as Test;

begin
  const Path: string := Test.ScratchDir() + '/roundtrip.txt';
  case Fs.WriteText(Path, 'hello fs') of
    when Ok(_):
      begin
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;

  Test.AssertTrue(Fs.Exists(Path));
  Test.AssertTrue(Fs.IsFile(Path));
  case Fs.ReadText(Path) of
    when Ok(const Text):
      begin
        Test.AssertEquals('hello fs', Text);
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;
end.
