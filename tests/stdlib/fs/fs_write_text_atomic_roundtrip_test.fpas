program FsWriteTextAtomicRoundtripTest;

uses Std.Fs, Std.Test;

begin
  var Path: string := ScratchDir() + '/atomic-roundtrip.txt';
  case WriteText(Path, 'old') of
    Ok(Written):
    begin
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end;

  case WriteTextAtomic(Path, 'new') of
    Ok(Written):
    begin
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end;

  case ReadText(Path) of
    Ok(Text):
    begin
      AssertEquals('new', Text)
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end
end.
