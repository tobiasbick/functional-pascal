program FsWriteTextAtomicRoundtripTest;

uses Std.Fs, Std.Test;

const
  Scratch: string := '.temp-data';
  Path: string := Scratch + '/_fpas_fs_atomic_roundtrip.txt';

procedure EnsureDir(Dir: string);
begin
  if Exists(Dir) then
  begin
    if not IsDir(Dir) then
    begin
      Fail('Expected directory: ' + Dir)
    end;
    return
  end;
  case CreateDir(Dir) of
    Ok(Created):
    begin
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end
end;

begin
  EnsureDir(Scratch);
  case WriteText(Path, 'old') of
    Ok(Written):
    begin
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end;
  case WriteTextAtomic(Path, 'new') of
    Ok(Written):
    begin
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end;
  case ReadText(Path) of
    Ok(Text):
    begin
      AssertEquals('new', Text)
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end
end.
