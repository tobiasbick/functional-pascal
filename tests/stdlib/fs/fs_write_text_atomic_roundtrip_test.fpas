program FsWriteTextAtomicRoundtripTest;

uses Std.Fs as Fs;
uses Std.Test as Test;

begin
  var Path: string := Test.ScratchDir() + '/atomic-roundtrip.txt';
  case Fs.WriteText(Path, 'old') of
    when Result.Ok(const Written):
      begin
        null;
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.WriteTextAtomic(Path, 'new') of
    when Result.Ok(const Written):
      begin
        null;
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.ReadText(Path) of
    when Result.Ok(const Text):
      begin
        Test.AssertEquals('new', Text);
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
