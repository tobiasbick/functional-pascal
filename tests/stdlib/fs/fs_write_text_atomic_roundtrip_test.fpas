program FsWriteTextAtomicRoundtripTest;

uses Std.Fs as Fs, Std.Test as Test;

begin
  const Path: string := Test.ScratchDir() + '/atomic-roundtrip.txt';
  case Fs.WriteText(Path, 'old') of
    when Ok(const Written):
      begin
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;

  case Fs.WriteTextAtomic(Path, 'new') of
    when Ok(const Written):
      begin
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;

  case Fs.ReadText(Path) of
    when Ok(const Text):
      begin
        Test.AssertEquals('new', Text);
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;
end.
