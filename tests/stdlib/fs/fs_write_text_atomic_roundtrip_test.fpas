program FsWriteTextAtomicRoundtripTest;

uses Std.Fs as Fs;
uses Std.Test as Test;

begin
  var Path: string := Test.ScratchDir() + '/atomic-roundtrip.txt';
  case Fs.WriteText(Path, 'old') of
    when Ok(Written):
      begin
        null;
      end;
    when Error(Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.WriteTextAtomic(Path, 'new') of
    when Ok(Written):
      begin
        null;
      end;
    when Error(Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Fs.ReadText(Path) of
    when Ok(Text):
      begin
        Test.AssertEquals('new', Text);
      end;
    when Error(Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
