program FsWriteTextAtomicRoundtripTest;

uses Std.Fs, Std.Test;

begin
  var Path: string := ScratchDir() + '/atomic-roundtrip.txt';
  case WriteText(Path, 'old') of
    when Ok(Written):
      begin
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case WriteTextAtomic(Path, 'new') of
    when Ok(Written):
      begin
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;

  case ReadText(Path) of
    when Ok(Text):
      begin
        AssertEquals('new', Text);
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end.
