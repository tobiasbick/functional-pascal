program HostInformation;

uses
  Std.Os.Hardware as Hardware, Std.Os.System as System, Std.Os.Users as Users,
  Std.Os.Proc as Proc, Std.Tasks as Tasks, Std.Time as Time, Std.Test as Test;

function AvailableMemory(): integer;
begin
  return Hardware.Memory().Unwrap().AvailableBytes;
end function;

begin
  const FirstCpu := Hardware.Cpu().Unwrap();
  Test.AssertTrue(FirstCpu.Cpus.Length() > 0);
  Test.AssertTrue(FirstCpu.UsagePercent is None);
  Test.AssertTrue(FirstCpu.IntervalMilliseconds is None);
  const Before := Hardware.Memory().Unwrap();
  Test.AssertTrue(Before.TotalBytes > 0);
  Test.AssertTrue(Before.AvailableBytes >= 0);
  Test.AssertTrue(Before.AvailableBytes <= Before.TotalBytes);
  const Info := System.Info().Unwrap();
  Test.AssertTrue(Info.Architecture.Length() > 0);
  Test.AssertTrue(Info.UptimeSeconds.Unwrap() >= 0);
  discard Hardware.Disks().Unwrap();
  const Interfaces := Hardware.Networks().Unwrap();
  for Interface: Hardware.NetworkInfo in Interfaces.Networks do
    Test.AssertTrue(Interface.Name.Length() > 0);
  end for;

  scope
    const First := go AvailableMemory();
    const Second := go AvailableMemory();
    Test.AssertTrue(Tasks.Wait(First) >= 0);
    Test.AssertTrue(Tasks.Wait(Second) >= 0);
  end scope;

  Time.Sleep(250);
  const NextCpu := Hardware.Cpu().Unwrap();
  Test.AssertTrue(NextCpu.UsagePercent is Some(_));
  Test.AssertTrue(NextCpu.IntervalMilliseconds.Unwrap() >= 200);
  const Processes := Proc.InspectProcesses().Unwrap();
  Test.AssertTrue(Processes.Processes.Length() > 0);
  var PreviousPid := -1;
  for Item: Proc.ProcessInfo in Processes.Processes do
    Test.AssertTrue(Item.Pid > PreviousPid);
    Test.AssertTrue(Item.StartTimeSeconds >= 0);
    PreviousPid := Item.Pid;
  end for;
  const Snapshot := System.Snapshot().Unwrap();
  Test.AssertTrue(Snapshot.StartedAtMilliseconds > 0);
  Test.AssertTrue(Snapshot.FinishedAtMilliseconds > 0);
  Test.AssertTrue(Snapshot.Memory.Unwrap().TotalBytes > 0);
  Test.AssertTrue(Snapshot.System.Unwrap().Architecture.Length() > 0);
  // Optional domains may fail on a supported OS or return an empty inventory.
  discard Snapshot.Components;
  discard Snapshot.Gpus;
  discard Snapshot.Machine;
  discard Snapshot.Users;
  discard Snapshot.Groups;
  discard Users.ListGroups();
end.
