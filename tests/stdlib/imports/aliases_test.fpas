program ImportAliasesTest;

uses Std.Test as Test, Std.Math as Math, Std.Text.Format as Numbers, Std.Tasks as Jobs, Std.Encoding.Json as Json;

begin
  scope
    Test.AssertEquals(3.0, Math.Sqrt(9.0));
    Test.AssertTrue(math.pi > 3.14);
    Test.AssertEquals('42', Numbers.IntToStr(42));
    Test.AssertEquals('value', ' value '.Trim());
    var Items: array of integer := [1];
    Items.PushInPlace(2);
    Test.AssertEquals(2, Items.Length());
    const Pending: task of real := go Math.Sqrt(16.0);
    Test.AssertEquals(4.0, Jobs.Wait(Pending));
    const Value: Json.JsonValue := Json.JsonValue.Bool(true);
    Test.AssertEquals('true', Json.Stringify(Value));
  end scope;
end.
