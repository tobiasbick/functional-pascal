program JsonFieldsTypedAccessTest;

uses Std.Json as Json, Std.Json.Fields as JsonFields, Std.Test as Test;

function ErrorValue<T>(Value: result of (T, JsonFields.FieldError)): JsonFields.FieldError;
begin
  case Value of
    when Ok(_):
      begin
        Test.Fail('expected an error result');
        return JsonFields.FieldError.ExpectedObject;
      end;
    when Error(const Message):
      begin
        return Message;
      end;
  end case;
end function;

begin
  const Fields: dict of string to Json.JsonValue := JsonFields.ParseObject(
    '{"s":"x","b":true,"n":2.5,"i":-7,"big":1e300,"o":{"k":1},"rows":["a","b"],"mixed":["a",1]}'
  ).Unwrap();
  Test.AssertEquals('x', JsonFields.StringField(Fields, 's').Unwrap());
  Test.AssertTrue(JsonFields.BooleanField(Fields, 'b').Unwrap());
  Test.AssertEquals(2.5, JsonFields.NumberField(Fields, 'n').Unwrap());
  Test.AssertEquals(-7, JsonFields.IntegerField(Fields, 'i').Unwrap());
  Test.AssertEquals(1, JsonFields.ObjectField(Fields, 'o').Unwrap().Length());
  Test.AssertEquals(2, JsonFields.ArrayField(Fields, 'mixed').Unwrap().Length());
  Test.AssertEquals(2, JsonFields.StringArrayField(Fields, 'rows').Unwrap().Length());
  Test.AssertTrue(
    (JsonFields.FieldError.MissingField('absent')) =
    (ErrorValue(JsonFields.Field(Fields, 'absent')))
  );
  Test.AssertTrue(
    (JsonFields.FieldError.WrongType('n', 'a string')) =
    (ErrorValue(JsonFields.StringField(Fields, 'n')))
  );
  Test.AssertTrue(
    (JsonFields.FieldError.WrongType('n', 'an integer')) =
    (ErrorValue(JsonFields.IntegerField(Fields, 'n')))
  );
  Test.AssertTrue(
    (JsonFields.FieldError.WrongType('s', 'a number')) =
    (ErrorValue(JsonFields.IntegerField(Fields, 's')))
  );
  // Out-of-range numbers are reported instead of raising a Trunc runtime error.
  Test.AssertTrue(
    (JsonFields.FieldError.InvalidValue('big', 'outside the integer range')) =
    (ErrorValue(JsonFields.IntegerField(Fields, 'big')))
  );
  Test.AssertTrue(
    (JsonFields.FieldError.WrongType('mixed', 'an array of strings')) =
    (ErrorValue(JsonFields.StringArrayField(Fields, 'mixed')))
  );
  Test.AssertTrue(
    (JsonFields.FieldError.WrongType('s', 'an object')) =
    (ErrorValue(JsonFields.ObjectField(Fields, 's')))
  );
  Test.AssertTrue(
    JsonFields.RequireOnlyFields(
      JsonFields.ParseObject('{"a":1}').Unwrap(), [
        'a',
        'b'
      ]
    ).Unwrap()
  );
  Test.AssertTrue(
    (JsonFields.FieldError.UnknownField('c')) =
    (
      ErrorValue(
        JsonFields.RequireOnlyFields(
          JsonFields.ParseObject('{"a":1,"c":2}').Unwrap(), [
            'a',
            'b'
          ]
        )
      )
    )
  );
  Test.AssertTrue(
    (JsonFields.FieldError.ExpectedObject) = (ErrorValue(JsonFields.ParseObject('[1]')))
  );
  Test.AssertTrue((JsonFields.ParseObject('{') is Error(_)));
end.
