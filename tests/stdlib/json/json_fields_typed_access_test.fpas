program JsonFieldsTypedAccessTest;

uses Std.Json, Std.Json.Fields, Std.Test;

function ErrorText<T>(Value: result of (T, string)): string;
begin
  case Value of
    when Ok(_):
      begin
        Fail('expected an error result');
        return '';
      end;
    when Error(const Message):
      begin
        return Message;
      end;
  end case;
end function;

begin
  const Fields: dict of string to JsonValue := ParseObject('{"s":"x","b":true,"n":2.5,"i":-7,"big":1e300,"o":{"k":1},"rows":["a","b"],"mixed":["a",1]}')
                                                 .Unwrap();
  AssertEquals('x', StringField(Fields, 's').Unwrap());
  AssertTrue(BooleanField(Fields, 'b').Unwrap());
  AssertEquals(2.5, NumberField(Fields, 'n').Unwrap());
  AssertEquals(-7, IntegerField(Fields, 'i').Unwrap());
  AssertEquals(1, ObjectField(Fields, 'o').Unwrap().Length());
  AssertEquals(2, ArrayField(Fields, 'mixed').Unwrap().Length());
  AssertEquals(2, StringArrayField(Fields, 'rows').Unwrap().Length());
  AssertEquals('missing field absent', ErrorText(Field(Fields, 'absent')));
  AssertEquals('field n must be a string', ErrorText(StringField(Fields, 'n')));
  AssertEquals('field n must be an integer', ErrorText(IntegerField(Fields, 'n')));
  AssertEquals('field s must be a number', ErrorText(IntegerField(Fields, 's')));
  // Out-of-range numbers are reported instead of raising a Trunc runtime error.
  AssertEquals('field big is outside the integer range', ErrorText(IntegerField(Fields, 'big')));
  AssertEquals('field mixed must be an array of strings', ErrorText(StringArrayField(Fields, 'mixed')));
  AssertEquals('field s must be an object', ErrorText(ObjectField(Fields, 's')));
  AssertTrue(RequireOnlyFields(ParseObject('{"a":1}').Unwrap(), ['a', 'b']).Unwrap());
  AssertEquals('unexpected field c', ErrorText(RequireOnlyFields(ParseObject('{"a":1,"c":2}')
                                                                   .Unwrap(), ['a', 'b'])));
  AssertEquals('JSON root must be an object', ErrorText(ParseObject('[1]')));
  AssertTrue(ParseObject('{').IsError());
end.
