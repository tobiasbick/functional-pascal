program JsonFieldsTypedAccessTest;

uses Std.Arrays as Arrays;
uses Std.Dictionaries as Dictionaries;
uses Std.Json as Json;
uses Std.Json.Fields as Fields2;
uses Std.Results as Results;
uses Std.Test as Test;

function ErrorText<T>(Value: result of T, string): string;
begin
  case Value of
    when Ok(_):
      begin
        Test.Fail('expected an error result');
        return '';
      end;
    when Error(Message):
      begin
        return Message;
      end;
  end case;
end function;

begin
  var Fields: dict of string to Json.JsonValue := Results.Unwrap(Fields2.ParseObject('{"s":"x","b":true,"n":2.5,"i":-7,"big":1e300,"o":{"k":1},"rows":["a","b"],"mixed":["a",1]}'));
  Test.AssertEquals('x', Results.Unwrap(Fields2.StringField(Fields, 's')));
  Test.AssertTrue(Results.Unwrap(Fields2.BooleanField(Fields, 'b')));
  Test.AssertEquals(2.5, Results.Unwrap(Fields2.NumberField(Fields, 'n')));
  Test.AssertEquals(-7, Results.Unwrap(Fields2.IntegerField(Fields, 'i')));
  Test.AssertEquals(1, Dictionaries.Length(Results.Unwrap(Fields2.ObjectField(Fields, 'o'))));
  Test.AssertEquals(2, Arrays.Length(Results.Unwrap(Fields2.ArrayField(Fields, 'mixed'))));
  Test.AssertEquals(2, Arrays.Length(Results.Unwrap(Fields2.StringArrayField(Fields, 'rows'))));
  Test.AssertEquals('missing field absent', ErrorText(Fields2.Field(Fields, 'absent')));
  Test.AssertEquals('field n must be a string', ErrorText(Fields2.StringField(Fields, 'n')));
  Test.AssertEquals('field n must be an integer', ErrorText(Fields2.IntegerField(Fields, 'n')));
  Test.AssertEquals('field s must be a number', ErrorText(Fields2.IntegerField(Fields, 's')));
  // Out-of-range numbers are reported instead of raising a Trunc runtime error.
  Test.AssertEquals('field big is outside the integer range', ErrorText(Fields2.IntegerField(Fields, 'big')));
  Test.AssertEquals('field mixed must be an array of strings', ErrorText(Fields2.StringArrayField(Fields, 'mixed')));
  Test.AssertEquals('field s must be an object', ErrorText(Fields2.ObjectField(Fields, 's')));
  Test.AssertTrue(Results.Unwrap(Fields2.RequireOnlyFields(Results.Unwrap(Fields2.ParseObject('{"a":1}')), [
                                                                                                             'a',
                                                                                                             'b'
                                                                                                           ])));
  Test.AssertEquals('unexpected field c', ErrorText(Fields2.RequireOnlyFields(Results.Unwrap(Fields2.ParseObject('{"a":1,"c":2}')), [
                                                                                                                                      'a',
                                                                                                                                      'b'
                                                                                                                                    ])));
  Test.AssertEquals('JSON root must be an object', ErrorText(Fields2.ParseObject('[1]')));
  Test.AssertTrue(Results.IsError(Fields2.ParseObject('{')));
end program;
