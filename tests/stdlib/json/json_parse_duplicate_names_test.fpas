program JsonParseDuplicateNamesTest;

uses Std.Json as Json, Std.Test as Test;

begin
  Test.AssertTrue(Json.Parse('{"version":1,"version":2}').IsError());
  Test.AssertTrue(Json.Parse('{"outer":{"x":1,"x":2}}').IsError());
  Test.AssertTrue(Json.Parse('[{"x":1,"x":2}]').IsError());
  Test.AssertTrue(Json.Parse('{"x":1,"\u0078":2}').IsError());
  Test.AssertTrue(Json.Parse('[{"x":1},{"x":2}]').IsOk());
  Test.AssertTrue(Json.Parse('{"x":1,"X":2}').IsOk());
end.
