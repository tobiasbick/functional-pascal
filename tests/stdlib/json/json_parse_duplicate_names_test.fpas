program JsonParseDuplicateNamesTest;

uses Std.Json as Json;
uses Std.Results as Results;
uses Std.Test as Test;

begin
  Test.AssertTrue(Results.IsError(Json.Parse('{"version":1,"version":2}')));
  Test.AssertTrue(Results.IsError(Json.Parse('{"outer":{"x":1,"x":2}}')));
  Test.AssertTrue(Results.IsError(Json.Parse('[{"x":1,"x":2}]')));
  Test.AssertTrue(Results.IsError(Json.Parse('{"x":1,"\u0078":2}')));
  Test.AssertTrue(Results.IsOk(Json.Parse('[{"x":1},{"x":2}]')));
  Test.AssertTrue(Results.IsOk(Json.Parse('{"x":1,"X":2}')));
end program;
