program JsonParseDuplicateNamesTest;

uses Std.Json, Std.Test;

begin
  AssertTrue(Parse('{"version":1,"version":2}').IsError());
  AssertTrue(Parse('{"outer":{"x":1,"x":2}}').IsError());
  AssertTrue(Parse('[{"x":1,"x":2}]').IsError());
  AssertTrue(Parse('{"x":1,"\u0078":2}').IsError());
  AssertTrue(Parse('[{"x":1},{"x":2}]').IsOk());
  AssertTrue(Parse('{"x":1,"X":2}').IsOk());
end.
