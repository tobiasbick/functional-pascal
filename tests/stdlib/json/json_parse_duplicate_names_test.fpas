program JsonParseDuplicateNamesTest;

uses Std.Json, Std.Results, Std.Test;

begin
  AssertTrue(Std.Results.IsError(Parse('{"version":1,"version":2}')));
  AssertTrue(Std.Results.IsError(Parse('{"outer":{"x":1,"x":2}}')));
  AssertTrue(Std.Results.IsError(Parse('[{"x":1,"x":2}]')));
  AssertTrue(Std.Results.IsError(Parse('{"x":1,"\u0078":2}')));
  AssertTrue(Std.Results.IsOk(Parse('[{"x":1},{"x":2}]')));
  AssertTrue(Std.Results.IsOk(Parse('{"x":1,"X":2}')))
end.
