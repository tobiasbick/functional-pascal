program JsonParseDuplicateNamesTest;

uses Std.Json as Json, Std.Test as Test;

begin
  Test.AssertTrue((Json.Parse('{"version":1,"version":2}') is Error(_)));
  Test.AssertTrue((Json.Parse('{"outer":{"x":1,"x":2}}') is Error(_)));
  Test.AssertTrue((Json.Parse('[{"x":1,"x":2}]') is Error(_)));
  Test.AssertTrue((Json.Parse('{"x":1,"\u0078":2}') is Error(_)));
  Test.AssertTrue((Json.Parse('[{"x":1},{"x":2}]') is Ok(_)));
  Test.AssertTrue((Json.Parse('{"x":1,"X":2}') is Ok(_)));
end.
