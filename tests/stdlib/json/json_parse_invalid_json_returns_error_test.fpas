program T;

uses Std.Console as Console, Std.Json as Json;

begin
  const R: result of (Json.JsonValue, string) := Json.Parse('{bad json');
  case R of
    when Ok(const V):
      begin
        Console.WriteLn(Json.Stringify(V));
      end;
    when Error(const E):
      begin
        Console.WriteLn('error');
      end;
  end case;
end.
