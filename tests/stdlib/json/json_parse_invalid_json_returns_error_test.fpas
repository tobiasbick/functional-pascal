program T;

uses Std.Console as Console;
uses Std.Json as Json;

begin
  var R: result of Json.JsonValue, string := Json.Parse('{bad json');
  case R of
    when Ok(V):
      begin
        Console.WriteLn(Json.Stringify(V));
      end;
    when Error(E):
      begin
        Console.WriteLn('error');
      end;
  end case;
end program;
