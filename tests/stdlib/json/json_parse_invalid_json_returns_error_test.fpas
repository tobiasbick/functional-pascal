program T;

uses Std.Console as Console;
uses Std.Json as Json;

begin
  const R: Result of (Json.JsonValue, string) := Json.Parse('{bad json');
  case R of
    when Result.Ok(const V):
      begin
        Console.WriteLn(Json.Stringify(V));
      end;
    when Result.Error(const E):
      begin
        Console.WriteLn('error');
      end;
  end case;
end program;
