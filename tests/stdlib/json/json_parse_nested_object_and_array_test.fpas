program T;

uses Std.Console, Std.Json, Std.Dictionaries, Std.Options, Std.Conv, Std.Arrays;

begin
  const R: result of JsonValue, string := Parse('{"name":"Ada","scores":[1,2],"active":true}');
  case R of
    when Ok(V):
      begin
        case V of
          when JsonValue.Object(Fields):
            begin
              const NameValue: option of JsonValue := Std.Dictionaries.Get(Fields, 'name');
              const ScoresValue: option of JsonValue := Std.Dictionaries.Get(Fields, 'scores');
              const ActiveValue: option of JsonValue := Std.Dictionaries.Get(Fields, 'active');
              case Unwrap(NameValue) of
                when JsonValue.String(Name):
                  begin
                    WriteLn(Name);
                  end;
                else
                  begin
                    WriteLn('bad-name');
                  end;
              end case;

              case Unwrap(ScoresValue) of
                when JsonValue.ArrayValue(Scores):
                  begin
                    WriteLn(IntToStr(Std.Arrays.Length(Scores)));
                  end;
                else
                  begin
                    WriteLn('bad-scores');
                  end;
              end case;

              case Unwrap(ActiveValue) of
                when JsonValue.Bool(Active):
                  begin
                    WriteLn(Active);
                  end;
                else
                  begin
                    WriteLn('bad-active');
                  end;
              end case;
            end;
          else
            begin
              WriteLn('not-object');
            end;
        end case;
      end;
    when Error(E):
      begin
        WriteLn('error: ' + E);
      end;
  end case;
end.
