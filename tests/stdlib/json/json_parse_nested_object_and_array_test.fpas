program T;

uses Std.Console, Std.Json, Std.Dictionaries, Std.Options, Std.Conv, Std.Arrays;

begin
  var R: result of JsonValue, string := Parse('{"name":"Ada","scores":[1,2],"active":true}');
  case R of
    Ok(V):
    begin
      case V of
        JsonValue.Object(Fields):
        begin
          var NameValue: option of JsonValue := Std.Dictionaries.Get(Fields, 'name');
          var ScoresValue: option of JsonValue := Std.Dictionaries.Get(Fields, 'scores');
          var ActiveValue: option of JsonValue := Std.Dictionaries.Get(Fields, 'active');
          case Unwrap(NameValue) of
            JsonValue.String(Name):
            begin
              WriteLn(Name)
            end
            else
            begin
              WriteLn('bad-name')
            end
          end;

          case Unwrap(ScoresValue) of
            JsonValue.ArrayValue(Scores):
            begin
              WriteLn(IntToStr(Std.Arrays.Length(Scores)))
            end
            else
            begin
              WriteLn('bad-scores')
            end
          end;

          case Unwrap(ActiveValue) of
            JsonValue.Bool(Active):
            begin
              WriteLn(Active)
            end
            else
            begin
              WriteLn('bad-active')
            end
          end
        end
        else
        begin
          WriteLn('not-object')
        end
      end
    end;
    Error(E):
    begin
      WriteLn('error: ' + E)
    end
  end
end.
