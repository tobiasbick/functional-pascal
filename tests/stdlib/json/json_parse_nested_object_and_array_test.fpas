program T;

uses Std.Console as Console;
uses Std.Json as Json;
uses Std.Dictionaries as Dictionaries;
uses Std.Options as Options;
uses Std.Conv as Conv;
uses Std.Arrays as Arrays;

begin
  var R: result of Json.JsonValue, string := Json.Parse('{"name":"Ada","scores":[1,2],"active":true}');
  case R of
    when Ok(V):
      begin
        case V of
          when Json.JsonValue.Object(Fields):
            begin
              var NameValue: option of Json.JsonValue := Dictionaries.Get(Fields, 'name');
              var ScoresValue: option of Json.JsonValue := Dictionaries.Get(Fields, 'scores');
              var ActiveValue: option of Json.JsonValue := Dictionaries.Get(Fields, 'active');
              case Options.Unwrap(NameValue) of
                when Json.JsonValue.String(Name):
                  begin
                    Console.WriteLn(Name);
                  end;
                else
                  begin
                    Console.WriteLn('bad-name');
                  end;
              end case;

              case Options.Unwrap(ScoresValue) of
                when Json.JsonValue.ArrayValue(Scores):
                  begin
                    Console.WriteLn(Conv.IntToStr(Arrays.Length(Scores)));
                  end;
                else
                  begin
                    Console.WriteLn('bad-scores');
                  end;
              end case;

              case Options.Unwrap(ActiveValue) of
                when Json.JsonValue.Bool(Active):
                  begin
                    Console.WriteLn(Active);
                  end;
                else
                  begin
                    Console.WriteLn('bad-active');
                  end;
              end case;
            end;
          else
            begin
              Console.WriteLn('not-object');
            end;
        end case;
      end;
    when Error(E):
      begin
        Console.WriteLn('error: ' + E);
      end;
  end case;
end program;
