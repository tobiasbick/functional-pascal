program T;

uses Std.Console as Console;
uses Std.Json as Json;
uses Std.Dictionaries as Dictionaries;
uses Std.Options as Options;
uses Std.Conv as Conv;
uses Std.Arrays as Arrays;

begin
  const R: Result of (Json.JsonValue, string) := Json.Parse('{"name":"Ada","scores":[1,2],"active":true}');
  case R of
    when Result.Ok(const V):
      begin
        case V of
          when Json.JsonValue.Object(const Fields):
            begin
              const NameValue: Option of (Json.JsonValue) := Dictionaries.Get(Fields, 'name');
              const ScoresValue: Option of (Json.JsonValue) := Dictionaries.Get(Fields, 'scores');
              const ActiveValue: Option of (Json.JsonValue) := Dictionaries.Get(Fields, 'active');
              case Options.Unwrap(NameValue) of
                when Json.JsonValue.String(const Name):
                  begin
                    Console.WriteLn(Name);
                  end;
                when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
                  begin
                    begin
                      Console.WriteLn('bad-name');
                    end;
                  end;
              end case;

              case Options.Unwrap(ScoresValue) of
                when Json.JsonValue.ArrayValue(const Scores):
                  begin
                    Console.WriteLn(Conv.IntToStr(Arrays.Length(Scores)));
                  end;
                when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
                  begin
                    begin
                      Console.WriteLn('bad-scores');
                    end;
                  end;
              end case;

              case Options.Unwrap(ActiveValue) of
                when Json.JsonValue.Bool(const Active):
                  begin
                    Console.WriteLn(Active);
                  end;
                when Json.JsonValue.NullValue, Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
                  begin
                    begin
                      Console.WriteLn('bad-active');
                    end;
                  end;
              end case;
            end;
          when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
            begin
              begin
                Console.WriteLn('not-object');
              end;
            end;
        end case;
      end;
    when Result.Error(const E):
      begin
        Console.WriteLn('error: ' + E);
      end;
  end case;
end program;
