program T;

uses Std.Console, Std.Json, Std.Conv;

begin
  const R: result of (JsonValue, string) := Parse('{"name":"Ada","scores":[1,2],"active":true}');
  case R of
    when Ok(const V):
      begin
        if V is JsonValue.Object(const Fields) then
          begin
            const NameValue: option of JsonValue := Fields.Get('name');
            const ScoresValue: option of JsonValue := Fields.Get('scores');
            const ActiveValue: option of JsonValue := Fields.Get('active');
            if NameValue.Unwrap() is JsonValue.String(const Name) then
              begin
                WriteLn(Name);
              end;
            else
              begin
                WriteLn('bad-name');
              end;
            end if;

            if ScoresValue.Unwrap() is JsonValue.ArrayValue(const Scores) then
              begin
                WriteLn(IntToStr(Scores.Length()));
              end;
            else
              begin
                WriteLn('bad-scores');
              end;
            end if;

            if ActiveValue.Unwrap() is JsonValue.Bool(const Active) then
              begin
                WriteLn(Active);
              end;
            else
              begin
                WriteLn('bad-active');
              end;
            end if;
          end;
        else
          begin
            WriteLn('not-object');
          end;
        end if;
      end;
    when Error(const E):
      begin
        WriteLn('error: ' + E);
      end;
  end case;
end.
