program T;

uses Std.Console, Std.Json, Std.Conv;

begin
  const R: result of JsonValue, string := Parse('{"name":"Ada","scores":[1,2],"active":true}');
  case R of
    when Ok(V):
      begin
        case V of
          when JsonValue.Object(Fields):
            begin
              const NameValue: option of JsonValue := Fields.Get('name');
              const ScoresValue: option of JsonValue := Fields.Get('scores');
              const ActiveValue: option of JsonValue := Fields.Get('active');
              case NameValue.Unwrap() of
                when JsonValue.String(Name):
                  begin
                    WriteLn(Name);
                  end;
                else
                  begin
                    WriteLn('bad-name');
                  end;
              end case;

              case ScoresValue.Unwrap() of
                when JsonValue.ArrayValue(Scores):
                  begin
                    WriteLn(IntToStr(Scores.Length()));
                  end;
                else
                  begin
                    WriteLn('bad-scores');
                  end;
              end case;

              case ActiveValue.Unwrap() of
                when JsonValue.Bool(Active):
                  begin
                    WriteLn(Active);
                  end;
                else
                  begin
                    WriteLn('bad-active');
                  end;
              end case;
            end;
          else
            begin
              WriteLn('not-object');
            end;
        end case;
      end;
    when Error(E):
      begin
        WriteLn('error: ' + E);
      end;
  end case;
end.
