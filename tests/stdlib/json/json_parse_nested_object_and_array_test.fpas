program T;

uses Std.Console as Console, Std.Json as Json, Std.Conv as Conv;

begin
  const R: result of (Json.JsonValue, Json.JsonError) := Json.Parse(
    '{"name":"Ada","scores":[1,2],"active":true}'
  );
  case R of
    when Ok(const V):
      begin
        case V of
          when Json.JsonValue.Object(const Fields):
            begin
              const NameValue: option of Json.JsonValue := Fields.Get('name');
              const ScoresValue: option of Json.JsonValue := Fields.Get('scores');
              const ActiveValue: option of Json.JsonValue := Fields.Get('active');
              case NameValue.Unwrap() of
                when Json.JsonValue.String(const Name):
                  begin
                    Console.WriteLn(Name);
                  end;
                when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
                  begin
                    Console.WriteLn('bad-name');
                  end;
              end case;

              case ScoresValue.Unwrap() of
                when Json.JsonValue.ArrayValue(const Scores):
                  begin
                    Console.WriteLn(Conv.IntToStr(Scores.Length()));
                  end;
                when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
                  begin
                    Console.WriteLn('bad-scores');
                  end;
              end case;

              case ActiveValue.Unwrap() of
                when Json.JsonValue.Bool(const Active):
                  begin
                    Console.WriteLn(Active);
                  end;
                when Json.JsonValue.NullValue, Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
                  begin
                    Console.WriteLn('bad-active');
                  end;
              end case;
            end;
          when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
            begin
              Console.WriteLn('not-object');
            end;
        end case;
      end;
    when Error(const E):
      begin
        Console.WriteLn('error: ' + E.Message());
      end;
  end case;
end.
