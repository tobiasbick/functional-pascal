program T;

uses Std.Console, Std.Json;

begin
  const R: result of JsonValue, string := Parse('null');
  case R of
    when Ok(const V):
      begin
        if V is JsonValue.NullValue then
          begin
            WriteLn('null');
          end;
        else
          begin
            WriteLn('not-null');
          end;
        end if;
      end;
    when Error(const E):
      begin
        WriteLn('error: ' + E);
      end;
  end case;
end.
