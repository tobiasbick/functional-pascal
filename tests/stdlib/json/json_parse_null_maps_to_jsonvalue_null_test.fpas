program T;

uses Std.Console, Std.Json;

begin
  const R: result of JsonValue, string := Parse('null');
  case R of
    when Ok(V):
      begin
        case V of
          when JsonValue.NullValue:
            begin
              WriteLn('null');
            end;
          else
            begin
              WriteLn('not-null');
            end;
        end case;
      end;
    when Error(E):
      begin
        WriteLn('error: ' + E);
      end;
  end case;
end.
