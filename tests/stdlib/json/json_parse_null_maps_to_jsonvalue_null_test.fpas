program T;

uses Std.Console as Console, Std.Encoding.Json as Json;

begin
  const R: result of (Json.JsonValue, Json.JsonError) := Json.Parse('null');
  case R of
    when Ok(const V):
      begin
        if V is Json.JsonValue.NullValue then
          begin
            Console.WriteLn('null');
          end;
        else
          begin
            Console.WriteLn('not-null');
          end;
        end if;
      end;
    when Error(const E):
      begin
        Console.WriteLn('error: ' + E.Message());
      end;
  end case;
end.
