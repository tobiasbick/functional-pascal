program T;

uses Std.Console as Console;
uses Std.Json as Json;

begin
  var R: Result of (Json.JsonValue, string) := Json.Parse('null');
  case R of
    when Result.Ok(const V):
      begin
        case V of
          when Json.JsonValue.NullValue:
            begin
              Console.WriteLn('null');
            end;
          when Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_), Json.JsonValue.Object(_):
            begin
              begin
                Console.WriteLn('not-null');
              end;
            end;
        end case;
      end;
    when Result.Error(const E):
      begin
        Console.WriteLn('error: ' + E);
      end;
  end case;
end program;
