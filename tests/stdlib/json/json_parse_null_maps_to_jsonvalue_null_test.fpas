program T;

uses Std.Console, Std.Json;

begin
  var R: result of JsonValue, string := Parse('null');
  case R of
    Ok(V):
    begin
      case V of
        JsonValue.Null:
        begin
          WriteLn('null')
        end
        else
        begin
          WriteLn('not-null')
        end
      end
    end;
    Error(E):
    begin
      WriteLn('error: ' + E)
    end
  end
end.
