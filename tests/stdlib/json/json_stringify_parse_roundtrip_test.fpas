program T;

uses Std.Console as Console, Std.Json as Json;

begin
  const R: result of (Json.JsonValue, Json.JsonError) := Json.Parse('[false,null,"x"]');
  case R of
    when Ok(const V):
      begin
        Console.WriteLn(Json.Stringify(V));
      end;
    when Error(const E):
      begin
        Console.WriteLn('error: ' + E.Message());
      end;
  end case;
end.
