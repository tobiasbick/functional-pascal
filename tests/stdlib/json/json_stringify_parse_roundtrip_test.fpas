program T;

uses Std.Console as Console;
uses Std.Json as Json;

begin
  const R: Result of (Json.JsonValue, string) := Json.Parse('[false,null,"x"]');
  case R of
    when Result.Ok(const V):
      begin
        Console.WriteLn(Json.Stringify(V));
      end;
    when Result.Error(const E):
      begin
        Console.WriteLn('error: ' + E);
      end;
  end case;
end program;
