program T;

uses Std.Console, Std.Json;

begin
  const R: result of (JsonValue, string) := Parse('[false,null,"x"]');
  case R of
    when Ok(const V):
      begin
        WriteLn(Stringify(V));
      end;
    when Error(const E):
      begin
        WriteLn('error: ' + E);
      end;
  end case;
end.
