program T;

uses Std.Console as Console;
uses Std.Json as Json;

begin
  var R: result of Json.JsonValue, string := Json.Parse('[false,null,"x"]');
  case R of
    when Ok(V):
      begin
        Console.WriteLn(Json.Stringify(V));
      end;
    when Error(E):
      begin
        Console.WriteLn('error: ' + E);
      end;
  end case;
end program;
