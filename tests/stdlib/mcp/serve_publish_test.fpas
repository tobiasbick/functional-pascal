// Serving a registered callback must allow concurrent endpoint publication and shutdown.
program McpServePublishTest;

uses
  Std.Ai.Mcp as Mcp, Std.Net.Http as Http, Std.Text.Utf8 as Utf8,
  Std.Tasks as Tasks, Std.Test as Test;

function Post(Access: Mcp.HttpAccess; Body: string): Http.Response;
begin
  var Request := Http.Request.Create('POST', Access.Url);
  Request.Headers := [
    Http.Header.Create('Content-Type', 'application/json'),
    Http.Header.Create('Accept', 'application/json, text/event-stream'),
    Http.Header.Create('MCP-Protocol-Version', '2025-06-18'),
    Http.Header.Create(Access.Headers[0].Name, Access.Headers[0].Value)
  ];
  Request.Body := Utf8.Encode(Body).Unwrap();
  Request.TimeoutMillis := 10000;
  return Http.Send(Request).Unwrap();
end function;

begin
  const Server := Mcp.Create(Mcp.DefaultLimits()).Unwrap();
  const Handler: Mcp.ToolHandler := function(Context: Mcp.RequestContext; Arguments: Mcp.RawJson): result of (Mcp.ToolResult, Mcp.McpError) begin
    return Ok(Mcp.TextResult('serve-publish-ready'));
  end function;

  discard Mcp.RegisterTool(
    Server, Mcp.ToolDefinition(
      Name := 'test', Description := 'Concurrent serving and publication',
      InputSchema := Mcp.ParseJson('{"type":"object"}').Unwrap(),
      OutputSchema := None, Annotations := None, Meta := None
    ), Handler
  ).Unwrap();
  scope
    const Worker := go Mcp.Serve(Server, None);
    using const Owner := Server;
    using const Endpoint := Mcp.Publish(Owner, Mcp.DefaultHttpOptions()).Unwrap();
    const Access := Mcp.Access(Endpoint).Unwrap();
    Test.AssertEquals(
      200,
      Post(
        Access,
        '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"fpas-test","version":"1"}}}'
      ).StatusCode
    );
    Test.AssertEquals(
      202,
      Post(Access, '{"jsonrpc":"2.0","method":"notifications/initialized"}').StatusCode
    );
    // The reply proves Serve has entered its loop and invoked the registered handler.
    const Client := go Post(
      Access,
      '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"test","arguments":{}}}'
    );
    const Reply := Tasks.Wait(Client);
    Test.AssertEquals(200, Reply.StatusCode);
    Test.AssertTrue('serve-publish-ready' in Http.BodyText(Reply).Unwrap());
    Test.AssertTrue(Mcp.CloseEndpoint(Endpoint).Unwrap());
    Test.AssertTrue(Mcp.Close(Owner).Unwrap());
    Test.AssertTrue(Tasks.Wait(Worker).Unwrap());
    Test.AssertTrue(Mcp.Release(Owner).Unwrap());
  end scope;
end.
