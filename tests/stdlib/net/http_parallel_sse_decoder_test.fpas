program HttpParallelSseDecoderTest;

uses
  Std.Conv as Conv, Std.Http as Http, Std.Net.Utf8 as Utf8, Std.Tasks as StdTasks, Std.Test as Test;

function CreateDecoder(Index: integer): Http.SseDecoder;
begin
  case Http.CreateSseDecoder(1024) of
    when Ok(const Decoder):
      begin
        return Decoder;
      end;
    when Error(const Message):
      begin
        panic('decoder ' + Conv.IntToStr(Index) + ' failed: ' + Message.Message());
      end;
  end case;
end function;

begin
  scope
    var Tasks: array of task of Http.SseDecoder := [];
    for Index: integer := 1 to 128 do
      begin
        Tasks.PushInPlace(go CreateDecoder(Index));
      end;
    end for;

    StdTasks.WaitAll(Tasks);
    var Decoders: array of Http.SseDecoder := [];
    for Index: integer := 0 to Tasks.Length() - 1 do
      begin
        Decoders.PushInPlace(StdTasks.Wait(Tasks[Index]));
      end;
    end for;

    for Index: integer := 0 to Decoders.Length() - 1 do
      begin
        const Expected: string := Conv.IntToStr(Index);
        case Http.FeedSse(Decoders[Index], Utf8.Encode('data: ' + Expected + #10 + #10)) of
          when Ok(const Events):
            begin
              Test.AssertEquals(1, Events.Length());
              Test.AssertEquals(Expected, Events[0].Data);
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;

        case Http.FinishSse(Decoders[Index]) of
          when Ok(_):
            begin
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;
      end;
    end for;
  end scope;
end.
