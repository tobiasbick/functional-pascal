program HttpParallelSseDecoderTest;

uses Std.Conv, Std.Http, Std.Net.Utf8, Std.Tasks, Std.Test;

function CreateDecoder(Index: integer): SseDecoder;
begin
  case CreateSseDecoder(1024) of
    when Ok(const Decoder):
      begin
        return Decoder;
      end;
    when Error(const Message):
      begin
        panic((('decoder ' + IntToStr(Index)) + ' failed: ') + Message);
      end;
  end case;
end function;

begin
  var Tasks: array of task := [];
  for Index: integer := 1 to 128 do
    begin
      Tasks.Push(go CreateDecoder(Index));
    end;
  end for;

  WaitAll(Tasks);
  var Decoders: array of SseDecoder := [];
  for Index: integer := 0 to Tasks.Length() - 1 do
    begin
      Decoders.Push(Wait(Tasks[Index]));
    end;
  end for;

  for Index: integer := 0 to Decoders.Length() - 1 do
    begin
      const Expected: string := IntToStr(Index);
      case FeedSse(Decoders[Index], Std.Net.Utf8.Encode((('data: ' + Expected) + #10) + #10)) of
        when Ok(const Events):
          begin
            AssertEquals(1, Events.Length());
            AssertEquals(Expected, Events[0].Data);
          end;
        when Error(const Message):
          begin
            panic(Message);
          end;
      end case;

      case FinishSse(Decoders[Index]) of
        when Ok(_):
          begin
          end;
        when Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end for;
end.
