program HttpParallelSseDecoderTest;

uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Http as Http;
uses Std.Net.Utf8 as Utf8;
uses Std.Tasks as Tasks2;
uses Std.Test as Test;

function CreateDecoder(Index: integer): Http.SseDecoder;
begin
  case Http.CreateSseDecoder(1024) of
    when Result.Ok(const Decoder):
      begin
        return Decoder;
      end;
    when Result.Error(const Message):
      begin
        panic((('decoder ' + Conv.IntToStr(Index)) + ' failed: ') + Message);
      end;
  end case;
end function;

begin
  mutable var Tasks: array of (task) := [];
  for Index: integer := 1 to 128 do
    begin
      Arrays.Push(Tasks, go CreateDecoder(Index));
    end;
  end for;

  Tasks2.WaitAll(Tasks);
  mutable var Decoders: array of (Http.SseDecoder) := [];
  for Index: integer := 0 to Arrays.Length(Tasks) - 1 do
    begin
      Arrays.Push(Decoders, Tasks2.Wait(Tasks[Index]));
    end;
  end for;

  for Index: integer := 0 to Arrays.Length(Decoders) - 1 do
    begin
      var Expected: string := Conv.IntToStr(Index);
      case Http.FeedSse(Decoders[Index], Utf8.Encode((('data: ' + Expected) + #10) + #10)) of
        when Result.Ok(const Events):
          begin
            Test.AssertEquals(1, Arrays.Length(Events));
            Test.AssertEquals(Expected, Events[0].Data);
          end;
        when Result.Error(const Message):
          begin
            panic(Message);
          end;
      end case;

      case Http.FinishSse(Decoders[Index]) of
        when Result.Ok(_):
          begin
            null;
          end;
        when Result.Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end for;
end program;
