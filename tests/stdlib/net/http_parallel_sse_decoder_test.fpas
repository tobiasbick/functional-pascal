program HttpParallelSseDecoderTest;

uses Std.Arrays as Arrays;
uses Std.Conv as Conv;
uses Std.Http as Http;
uses Std.Net.Utf8 as Utf8;
uses Std.Tasks as Tasks2;
uses Std.Test as Test;

function CreateDecoder(Index: integer): Http.SseDecoder;
begin
  case Http.CreateSseDecoder(1024) of
    when Result.Ok(const Decoder):
      begin
        return Decoder;
      end;
    when Result.Error(const Message):
      begin
        panic((('decoder ' + Conv.IntToStr(Index)) + ' failed: ') + Message);
      end;
  end case;
end function;

begin
  var Tasks: array of (task) := [];
  for Index: integer := 1 to 128 do
    begin
      Arrays.Push(var Tasks, go CreateDecoder(Index));
    end;
  end for;

  Tasks2.WaitAll(Tasks);
  var Decoders: array of (Http.SseDecoder) := [];
  for Handle: task in Tasks do
    begin
      Arrays.Push(var Decoders, Tasks2.Wait(Handle));
    end;
  end for;
  var Index: integer := 0;
  for Decoder: Http.SseDecoder in Decoders do
    begin
      const Expected: string := Conv.IntToStr(Index);
      case Http.FeedSse(Decoder, Utf8.Encode((('data: ' + Expected) + #10) + #10)) of
        when Result.Ok(const Events):
          begin
            Test.AssertEquals(1, Arrays.Length(Events));
            Test.AssertEquals(Expected, Events[0].Data);
          end;
        when Result.Error(const Message):
          begin
            panic(Message);
          end;
      end case;

      Index := Index + 1;
      case Http.FinishSse(Decoder) of
        when Result.Ok(_):
          begin
            null;
          end;
        when Result.Error(const Message):
          begin
            panic(Message);
          end;
      end case;
    end;
  end for;
end program;
