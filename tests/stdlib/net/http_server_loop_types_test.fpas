// Covers HTTP server-loop defaults and request-handler typing.
program HttpServerLoopTypesTest;

uses Std.Http, Std.Test;

// Returns a response whose reason phrase mirrors the request method.
//
// Parameters:
// - `RequestValue`: Request supplied through the handler type.
function Handle(RequestValue: ServerRequest): ServerResponse;
begin
  return ServerResponse.Create(200, RequestValue.Method)
end;

begin
  var Options: ServerOptions := ServerOptions.Create();
  AssertEquals(65536, Options.MaxHeaderBytes);
  AssertEquals(1048576, Options.MaxBodyBytes);
  AssertEquals(30000, Options.ConnectionTimeoutMillis);
  AssertEquals(8, Options.MaxConcurrentRequests);
  AssertEquals(0, Options.MaxRequests);
  var HandlerValue: RequestHandler := Handle;
  var RequestValue: ServerRequest := record
    Method := 'OK';
    Target := '/';
    Headers := [];
    Body := [];
  end;
  var ResponseValue: ServerResponse := HandlerValue(RequestValue);
  AssertEquals(200, ResponseValue.StatusCode);
  AssertEquals('OK', ResponseValue.ReasonPhrase)
end.
