// Covers HTTP server-loop defaults and request-handler typing.
program HttpServerLoopTypesTest;

uses Std.Http as Http;
uses Std.Test as Test;

// Returns a response whose reason phrase mirrors the request method.
//
// Parameters:
// - `RequestValue`: Request supplied through the handler type.
function Handle(RequestValue: Http.ServerRequest): Http.ServerResponse;
begin
  return Http.ServerResponse.Create(200, RequestValue.Method);
end function;

begin
  var Options: Http.ServerOptions := Http.ServerOptions.Create();
  Test.AssertEquals(65536, Options.MaxHeaderBytes);
  Test.AssertEquals(1048576, Options.MaxBodyBytes);
  Test.AssertEquals(30000, Options.ConnectionTimeoutMillis);
  Test.AssertEquals(8, Options.MaxConcurrentRequests);
  Test.AssertEquals(0, Options.MaxRequests);
  var HandlerValue: Http.RequestHandler := Handle;
  var RequestValue: Http.ServerRequest := record
    Method := 'OK';
    Target := '/';
    Headers := [];
    Body := [];
  end record;
  var ResponseValue: Http.ServerResponse := HandlerValue(RequestValue);
  Test.AssertEquals(200, ResponseValue.StatusCode);
  Test.AssertEquals('OK', ResponseValue.ReasonPhrase);
end program;
