// Covers HTTP server response construction and mutable fields.
program HttpServerTypesTest;

uses Std.Http as Http, Std.Net.Utf8 as Utf8, Std.Test as Test;

begin
  var ResponseValue: Http.ServerResponse := Http.ServerResponse.Create(201, 'Created');
  ResponseValue.Headers := [Http.Header.Create('Content-Type', 'text/plain')];
  ResponseValue.Body := Utf8.Encode('ok');
  Test.AssertEquals(201, ResponseValue.StatusCode);
  Test.AssertEquals('Created', ResponseValue.ReasonPhrase);
  Test.AssertEquals(1, ResponseValue.Headers.Length());
  Test.AssertEquals(2, ResponseValue.Body.Length());
end.
