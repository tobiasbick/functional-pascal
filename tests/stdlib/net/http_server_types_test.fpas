// Covers HTTP server response construction and mutable fields.
program HttpServerTypesTest;

uses Std.Arrays as Arrays;
uses Std.Http as Http;
uses Std.Net.Utf8 as Utf8;
uses Std.Test as Test;

begin
  var ResponseValue: Http.ServerResponse := Http.ServerResponseCreate(201, 'Created');
  ResponseValue.Headers := [Http.HeaderCreate('Content-Type', 'text/plain')];
  ResponseValue.Body := Utf8.Encode('ok');
  Test.AssertEquals(201, ResponseValue.StatusCode);
  Test.AssertEquals('Created', ResponseValue.ReasonPhrase);
  Test.AssertEquals(1, Arrays.Length(ResponseValue.Headers));
  Test.AssertEquals(2, Arrays.Length(ResponseValue.Body));
end program;
