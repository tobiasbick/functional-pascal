// Covers HTTP server response construction and mutable fields.
program HttpServerTypesTest;

uses Std.Http, Std.Net.Utf8, Std.Test;

begin
  var ResponseValue: ServerResponse := ServerResponse.Create(201, 'Created');
  ResponseValue.Headers := [Header.Create('Content-Type', 'text/plain')];
  ResponseValue.Body := Std.Net.Utf8.Encode('ok');
  AssertEquals(201, ResponseValue.StatusCode);
  AssertEquals('Created', ResponseValue.ReasonPhrase);
  AssertEquals(1, ResponseValue.Headers.Length());
  AssertEquals(2, ResponseValue.Body.Length());
end.
