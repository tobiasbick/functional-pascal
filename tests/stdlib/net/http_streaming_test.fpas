// Covers fragmented, final, bounded, and closed SSE decoder behavior.
program HttpStreamingTest;

uses Std.Http as Http, Std.Net.Utf8 as Utf8, Std.Test as Test;

begin
  case Http.CreateSseDecoder(1024) of
    when Ok(const Decoder):
      begin
        case Http.FeedSse(
          Decoder, Utf8.Encode(
            'id: 7' + #13 + #10 + 'event: token' + #13 + #10 +
            'data: hel'
          )
        ) of
          when Ok(const Events):
            begin
              Test.AssertEquals(0, Events.Length());
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;

        case Http.FeedSse(
          Decoder, Utf8.Encode(
            'lo' + #13 + #10 + 'data: world' + #13 + #10 + #13 +
            #10
          )
        ) of
          when Ok(const Events):
            begin
              Test.AssertEquals(1, Events.Length());
              Test.AssertEquals('token', Events[0].EventType);
              Test.AssertEquals('hello' + #10 + 'world', Events[0].Data);
              Test.AssertEquals('7', Events[0].Id);
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;

        case Http.FeedSse(Decoder, Utf8.Encode(': keepalive' + #10 + 'data: final')) of
          when Ok(const Events):
            begin
              Test.AssertEquals(0, Events.Length());
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;

        case Http.FinishSse(Decoder) of
          when Ok(const Events):
            begin
              Test.AssertEquals(1, Events.Length());
              Test.AssertEquals('message', Events[0].EventType);
              Test.AssertEquals('final', Events[0].Data);
              Test.AssertEquals('7', Events[0].Id);
            end;
          when Error(const Message):
            begin
              panic(Message.Message());
            end;
        end case;

        case Http.FeedSse(Decoder, []) of
          when Ok(_):
            begin
              panic('finished SSE decoder accepted more input');
            end;
          when Error(const Message):
            begin
              Test.AssertTrue((Message is Http.HttpError.InvalidArgument('Decoder', _)));
            end;
        end case;
      end;
    when Error(const Message):
      begin
        panic(Message.Message());
      end;
  end case;

  case Http.CreateSseDecoder(8) of
    when Ok(const Decoder):
      begin
        case Http.FeedSse(Decoder, Utf8.Encode('data: too long' + #10)) of
          when Ok(_):
            begin
              panic('oversized SSE event was accepted');
            end;
          when Error(const Message):
            begin
              Test.AssertTrue((Message is Http.HttpError.LimitExceeded(_, _)));
            end;
        end case;
      end;
    when Error(const Message):
      begin
        panic(Message.Message());
      end;
  end case;
end.
