// Covers fragmented, final, bounded, and closed SSE decoder behavior.
program HttpStreamingTest;

uses Std.Arrays as Arrays;
uses Std.Http as Http;
uses Std.Net.Utf8 as Utf8;
uses Std.Str as Str;
uses Std.Test as Test;

begin
  case Http.CreateSseDecoder(1024) of
    when Ok(Decoder):
      begin
        case Http.FeedSse(Decoder, Utf8.Encode(((((('id: 7' + #13) + #10) + 'event: token') + #13) + #10) +
                                               'data: hel')) of
          when Ok(Events):
            begin
              Test.AssertEquals(0, Arrays.Length(Events));
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case Http.FeedSse(Decoder, Utf8.Encode((((((('lo' + #13) + #10) + 'data: world') + #13) + #10) + #13) +
                                               #10)) of
          when Ok(Events):
            begin
              Test.AssertEquals(1, Arrays.Length(Events));
              Test.AssertEquals('token', Events[0].EventType);
              Test.AssertEquals(('hello' + #10) + 'world', Events[0].Data);
              Test.AssertEquals('7', Events[0].Id);
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case Http.FeedSse(Decoder, Utf8.Encode((': keepalive' + #10) + 'data: final')) of
          when Ok(Events):
            begin
              Test.AssertEquals(0, Arrays.Length(Events));
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case Http.FinishSse(Decoder) of
          when Ok(Events):
            begin
              Test.AssertEquals(1, Arrays.Length(Events));
              Test.AssertEquals('message', Events[0].EventType);
              Test.AssertEquals('final', Events[0].Data);
              Test.AssertEquals('7', Events[0].Id);
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case Http.FeedSse(Decoder, []) of
          when Ok(_):
            begin
              panic('finished SSE decoder accepted more input');
            end;
          when Error(Message):
            begin
              Test.AssertTrue(Str.Contains(Message, 'already finished'));
            end;
        end case;
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;

  case Http.CreateSseDecoder(8) of
    when Ok(Decoder):
      begin
        case Http.FeedSse(Decoder, Utf8.Encode('data: too long' + #10)) of
          when Ok(_):
            begin
              panic('oversized SSE event was accepted');
            end;
          when Error(Message):
            begin
              Test.AssertTrue(Str.Contains(Message, 'MaxEventBytes'));
            end;
        end case;
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;
end program;
