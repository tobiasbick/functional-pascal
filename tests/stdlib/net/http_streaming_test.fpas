// Covers fragmented, final, bounded, and closed SSE decoder behavior.
program HttpStreamingTest;

uses Std.Arrays, Std.Http, Std.Net.Utf8, Std.Str, Std.Test;

begin
  case CreateSseDecoder(1024) of
    when Ok(Decoder):
      begin
        case FeedSse(Decoder, Std.Net.Utf8.Encode(((((('id: 7' + #13) + #10) + 'event: token') + #13) + #10) +
                                                  'data: hel')) of
          when Ok(Events):
            begin
              AssertEquals(0, Std.Arrays.Length(Events));
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case FeedSse(Decoder, Std.Net.Utf8.Encode((((((('lo' + #13) + #10) + 'data: world') + #13) + #10) + #13) +
                                                  #10)) of
          when Ok(Events):
            begin
              AssertEquals(1, Std.Arrays.Length(Events));
              AssertEquals('token', Events[0].EventType);
              AssertEquals(('hello' + #10) + 'world', Events[0].Data);
              AssertEquals('7', Events[0].Id);
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case FeedSse(Decoder, Std.Net.Utf8.Encode((': keepalive' + #10) + 'data: final')) of
          when Ok(Events):
            begin
              AssertEquals(0, Std.Arrays.Length(Events));
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case FinishSse(Decoder) of
          when Ok(Events):
            begin
              AssertEquals(1, Std.Arrays.Length(Events));
              AssertEquals('message', Events[0].EventType);
              AssertEquals('final', Events[0].Data);
              AssertEquals('7', Events[0].Id);
            end;
          when Error(Message):
            begin
              panic(Message);
            end;
        end case;

        case FeedSse(Decoder, []) of
          when Ok(_):
            begin
              panic('finished SSE decoder accepted more input');
            end;
          when Error(Message):
            begin
              AssertTrue(Std.Str.Contains(Message, 'already finished'));
            end;
        end case;
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;

  case CreateSseDecoder(8) of
    when Ok(Decoder):
      begin
        case FeedSse(Decoder, Std.Net.Utf8.Encode('data: too long' + #10)) of
          when Ok(_):
            begin
              panic('oversized SSE event was accepted');
            end;
          when Error(Message):
            begin
              AssertTrue(Std.Str.Contains(Message, 'MaxEventBytes'));
            end;
        end case;
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;
end.
