// Covers HTTP request constructors, buffered responses, and header lookup.
program HttpTypesTest;

uses Std.Http as Http;
uses Std.Net.Utf8 as Utf8;
uses Std.Test as Test;

begin
  var RequestValue: Http.Request := Http.Request.Create('POST', 'http://localhost:8080/v1/chat');
  Test.AssertEquals('POST', RequestValue.Method);
  Test.AssertEquals(30000, RequestValue.TimeoutMillis);
  Test.AssertEquals('GET', Http.Request.Get('http://localhost/get').Method);
  Test.AssertEquals('POST', Http.Request.Post('http://localhost/post').Method);
  Test.AssertEquals('PUT', Http.Request.Put('http://localhost/put').Method);
  Test.AssertEquals('PATCH', Http.Request.Patch('http://localhost/patch').Method);
  Test.AssertEquals('DELETE', Http.Request.Delete('http://localhost/delete').Method);
  Test.AssertEquals('HEAD', Http.Request.Head('http://localhost/head').Method);
  Test.AssertEquals('OPTIONS', Http.Request.Options('http://localhost/options').Method);
  Test.AssertEquals('PROPFIND', Http.Request.Create('PROPFIND', 'http://localhost/webdav').Method);
  var ResponseValue: Http.Response := Http.Response(StatusCode := 200, ReasonPhrase := 'OK', Headers := [
                                                                                                          Http.Header.Create('Content-Type', 'application/json')
                                                                                                        ], Body := Utf8.Encode('{"ok":true}'));
  case Http.BodyText(ResponseValue) of
    when Result.Ok(const Text):
      begin
        Test.AssertEquals('{"ok":true}', Text);
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Http.HeaderValue(ResponseValue, 'content-type') of
    when Option.Some(const Value):
      begin
        Test.AssertEquals('application/json', Value);
      end;
    when Option.None:
      begin
        Test.Fail('header lookup failed');
      end;
  end case;
end program;
