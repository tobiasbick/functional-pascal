program ListenerAddressTest;

uses Std.Net, Std.Test;

function ExerciseListener(): result of boolean, string;
begin
  const First: Listener := try Listen('127.0.0.1', 0);
  const Second: Listener := try Listen('127.0.0.1', 0);
  const Address: NetworkAddress := try ListenerLocalAddress(First);
  const Other: NetworkAddress := try ListenerLocalAddress(Second);
  AssertEquals('127.0.0.1', Address.Host);
  AssertTrue(Address.Port > 0);
  AssertTrue(Address.Port <= 65535);
  AssertTrue(Address.Port <> Other.Port);
  const Client: Connection := try Connect(Address.Host, Address.Port, 2000);
  const Peer: Connection := try Accept(First);
  const Timed: boolean := try SetTimeout(Peer, 2000);
  const Sent: integer := try SendBytes(Client, [42]);
  const Received: array of integer := try ReceiveBytes(Peer, 1);
  AssertEquals(1, Sent);
  AssertEquals(42, Received[0]);
  const ClientClosed: boolean := try Close(Client);
  const PeerClosed: boolean := try Close(Peer);
  const FirstClosed: boolean := try CloseListener(First);
  const SecondClosed: boolean := try CloseListener(Second);
  case ListenerLocalAddress(First) of
    when Ok(_):
      begin
        panic('Closed listener returned an address');
      end;
    when Error(_):
      begin
      end;
  end case;

  return Ok(true);
end function;

begin
  case ExerciseListener() of
    when Ok(_):
      begin
      end;
    when Error(Message):
      begin
        panic(Message);
      end;
  end case;
end.
