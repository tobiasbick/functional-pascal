// Keeps cancellable accept type-checked without opening a network listener.
program NetCancellationSignatureTest;

uses Std.Net.Sockets as Net, Std.Tasks as Tasks;

function AcceptWithCancellationSignatureOnly(
  ListenerValue: Net.Listener;
  Token: Tasks.CancellationToken
): result of (Net.Connection, Net.NetError);
begin
  return Net.AcceptWithCancellation(ListenerValue, Token);
end function;

begin
end.
