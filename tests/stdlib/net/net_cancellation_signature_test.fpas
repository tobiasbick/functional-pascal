// Keeps cancellable accept type-checked without opening a network listener.
program NetCancellationSignatureTest;

uses Std.Net, Std.Tasks;

function AcceptWithCancellationSignatureOnly(ListenerValue: Listener; Token: CancellationToken): result of Connection, string;
begin
  return AcceptWithCancellation(ListenerValue, Token);
end function;

begin
end.
