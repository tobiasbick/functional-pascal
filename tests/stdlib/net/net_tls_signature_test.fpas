// Keeps the public TLS client and server listener signatures type-checked.
program NetTlsSignatureTest;

uses Std.Net as Net;

// Type-checks the verified TLS client constructor.
function ConnectTlsSignatureOnly(): Result of (Net.Connection, string);
begin
  return Net.ConnectTls('localhost', 443, 1000);
end function;

// Type-checks the certificate-configured TLS listener constructor.
function ListenTlsSignatureOnly(): Result of (Net.Listener, string);
begin
  return Net.ListenTls('127.0.0.1', 443, 'certificate.pem', 'private-key.pem', 1000);
end function;

begin
  null;
end program;
