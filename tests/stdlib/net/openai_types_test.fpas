// Covers OpenAI-compatible client, message, and option defaults.
program OpenAiTypesTest;

uses Std.Ai.OpenAi as OpenAi;
uses Std.Test as Test;

begin
  const ClientValue: OpenAi.Client := OpenAi.ClientCreate('http://localhost:8080/v1', 'local-model');
  Test.AssertEquals('http://localhost:8080/v1', ClientValue.BaseUrl);
  Test.AssertEquals('local-model', ClientValue.Model);
  const MessageValue: OpenAi.ChatMessage := OpenAi.ChatMessageUser('Hello');
  Test.AssertEquals('user', MessageValue.Role);
  Test.AssertEquals('Hello', MessageValue.Content);
  const Options: OpenAi.ChatOptions := OpenAi.ChatOptionsDefault();
  case Options.MaxTokens of
    when Option.Some(const Value):
      begin
        Test.Fail('unexpected max tokens');
      end;
    when Option.None:
      begin
        null;
      end;
  end case;
end program;
