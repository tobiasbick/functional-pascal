// Covers OpenAI-compatible client, message, and option defaults.
program OpenAiTypesTest;

uses Std.Ai.OpenAi, Std.Test;

begin
  const ClientValue: Client := Client.Create('http://localhost:8080/v1', 'local-model');
  AssertEquals('http://localhost:8080/v1', ClientValue.BaseUrl);
  AssertEquals('local-model', ClientValue.Model);
  const MessageValue: ChatMessage := ChatMessage.User('Hello');
  AssertEquals('user', MessageValue.Role);
  AssertEquals('Hello', MessageValue.Content);
  const Options: ChatOptions := ChatOptions.Default();
  case Options.MaxTokens of
    when Some(const Value):
      begin
        Fail('unexpected max tokens');
      end;
    when None:
      begin
      end;
  end case;
end.
