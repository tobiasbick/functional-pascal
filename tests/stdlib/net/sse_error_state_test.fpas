program SseErrorStateTest;

uses Std.Http, Std.Net.Utf8, Std.Test;

procedure Terminal(Decoder: SseDecoder);
begin
  for Pass: integer := 1 to 3 do
    begin
      case FeedSse(Decoder, Std.Net.Utf8.Encode(('data: more' + #10) + #10)) of
        when Ok(_):
          begin
            Fail('feed after error');
          end;
        when Error(const Message):
          begin
            AssertTrue(Message.Contains('finished'));
          end;
      end case;

      case FinishSse(Decoder) of
        when Ok(_):
          begin
            Fail('finish after error');
          end;
        when Error(const Message):
          begin
            AssertTrue(Message.Contains('finished'));
          end;
      end case;
    end;
  end for;
end procedure;

begin
  const Limited: SseDecoder := CreateSseDecoder(8).Unwrap();
  case FeedSse(Limited, Std.Net.Utf8.Encode('x'.RepeatStr(100000))) of
    when Ok(_):
      begin
        Fail('oversized fragment');
      end;
    when Error(_):
      begin
      end;
  end case;

  Terminal(Limited);
  const Invalid: SseDecoder := CreateSseDecoder(16).Unwrap();
  AssertEquals(0, FeedSse(Invalid, [255]).Unwrap().Length());
  case FinishSse(Invalid) of
    when Ok(_):
      begin
        Fail('invalid final UTF-8');
      end;
    when Error(_):
      begin
      end;
  end case;

  Terminal(Invalid);
  const Many: SseDecoder := CreateSseDecoder(9).Unwrap();
  const Events: array of SseEvent := FeedSse(Many, Std.Net.Utf8.Encode(((('data:x' + #13) + #10) + #10)
                                                                         .RepeatStr(500)))
                                       .Unwrap();
  AssertEquals(500, Events.Length());
  AssertEquals('x', Events[499].Data);
  const Split: SseDecoder := CreateSseDecoder(9).Unwrap();
  AssertEquals(0, FeedSse(Split, Std.Net.Utf8.Encode('data:x' + #13)).Unwrap().Length());
  AssertEquals(1, FeedSse(Split, [10, 10]).Unwrap().Length());
  AssertEquals(0, FinishSse(Split).Unwrap().Length());
end.
