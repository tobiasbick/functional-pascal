program SseErrorStateTest;

uses Std.Http as Http, Std.Net.Utf8 as Utf8, Std.Test as Test;

procedure Terminal(Decoder: Http.SseDecoder);
begin
  for Pass: integer := 1 to 3 do
    begin
      case Http.FeedSse(Decoder, Utf8.Encode('data: more' + #10 + #10)) of
        when Ok(_):
          begin
            Test.Fail('feed after error');
          end;
        when Error(const Message):
          begin
            Test.AssertTrue(('finished' in Message));
          end;
      end case;

      case Http.FinishSse(Decoder) of
        when Ok(_):
          begin
            Test.Fail('finish after error');
          end;
        when Error(const Message):
          begin
            Test.AssertTrue(('finished' in Message));
          end;
      end case;
    end;
  end for;
end procedure;

begin
  const Limited: Http.SseDecoder := Http.CreateSseDecoder(8).Unwrap();
  case Http.FeedSse(Limited, Utf8.Encode('x'.RepeatStr(100000))) of
    when Ok(_):
      begin
        Test.Fail('oversized fragment');
      end;
    when Error(_):
      begin
      end;
  end case;

  Terminal(Limited);
  const Invalid: Http.SseDecoder := Http.CreateSseDecoder(16).Unwrap();
  Test.AssertEquals(0, Http.FeedSse(Invalid, [255]).Unwrap().Length());
  case Http.FinishSse(Invalid) of
    when Ok(_):
      begin
        Test.Fail('invalid final UTF-8');
      end;
    when Error(_):
      begin
      end;
  end case;

  Terminal(Invalid);
  const Many: Http.SseDecoder := Http.CreateSseDecoder(9).Unwrap();
  const Events: array of Http.SseEvent := Http.FeedSse(Many, Utf8.Encode(('data:x' + #13 + #10 + #10)
                                                                           .RepeatStr(500)))
                                            .Unwrap();
  Test.AssertEquals(500, Events.Length());
  Test.AssertEquals('x', Events[499].Data);
  const Split: Http.SseDecoder := Http.CreateSseDecoder(9).Unwrap();
  Test.AssertEquals(0, Http.FeedSse(Split, Utf8.Encode('data:x' + #13)).Unwrap().Length());
  Test.AssertEquals(1, Http.FeedSse(Split, [10, 10]).Unwrap().Length());
  Test.AssertEquals(0, Http.FinishSse(Split).Unwrap().Length());
end.
