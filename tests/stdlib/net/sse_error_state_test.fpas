program SseErrorStateTest;

uses Std.Arrays as Arrays;
uses Std.Http as Http;
uses Std.Net.Utf8 as Utf8;
uses Std.Results as Results;
uses Std.Str as Str;
uses Std.Test as Test;

procedure Terminal(Decoder: Http.SseDecoder);
begin
  for Pass: integer := 1 to 3 do
    begin
      case Http.FeedSse(Decoder, Utf8.Encode(('data: more' + #10) + #10)) of
        when Result.Ok(_):
          begin
            Test.Fail('feed after error');
          end;
        when Result.Error(const Message):
          begin
            Test.AssertTrue(Str.Contains(Message, 'finished'));
          end;
      end case;

      case Http.FinishSse(Decoder) of
        when Result.Ok(_):
          begin
            Test.Fail('finish after error');
          end;
        when Result.Error(const Message):
          begin
            Test.AssertTrue(Str.Contains(Message, 'finished'));
          end;
      end case;
    end;
  end for;
end procedure;

begin
  const Limited: Http.SseDecoder := Results.Unwrap(Http.CreateSseDecoder(8));
  case Http.FeedSse(Limited, Utf8.Encode(Str.RepeatStr('x', 100000))) of
    when Result.Ok(_):
      begin
        Test.Fail('oversized fragment');
      end;
    when Result.Error(_):
      begin
        null;
      end;
  end case;

  Terminal(Limited);
  const Invalid: Http.SseDecoder := Results.Unwrap(Http.CreateSseDecoder(16));
  Test.AssertEquals(0, Arrays.Length(Results.Unwrap(Http.FeedSse(Invalid, [255]))));
  case Http.FinishSse(Invalid) of
    when Result.Ok(_):
      begin
        Test.Fail('invalid final UTF-8');
      end;
    when Result.Error(_):
      begin
        null;
      end;
  end case;

  Terminal(Invalid);
  const Many: Http.SseDecoder := Results.Unwrap(Http.CreateSseDecoder(9));
  const Events: array of (Http.SseEvent) := Results.Unwrap(Http.FeedSse(Many, Utf8.Encode(Str.RepeatStr((('data:x' + #13) + #10) +
                                                                                                        #10, 500))));
  Test.AssertEquals(500, Arrays.Length(Events));
  Test.AssertEquals('x', Events[499].Data);
  const Split: Http.SseDecoder := Results.Unwrap(Http.CreateSseDecoder(9));
  Test.AssertEquals(0, Arrays.Length(Results.Unwrap(Http.FeedSse(Split, Utf8.Encode('data:x' + #13)))));
  Test.AssertEquals(1, Arrays.Length(Results.Unwrap(Http.FeedSse(Split, [10, 10]))));
  Test.AssertEquals(0, Arrays.Length(Results.Unwrap(Http.FinishSse(Split))));
end program;
