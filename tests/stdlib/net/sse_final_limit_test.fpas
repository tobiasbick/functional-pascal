program SseFinalLimitTest;

uses Std.Net.Http as Http, Std.Text.Utf8 as Utf8, Std.Test as Test;

procedure CheckFinal(Text: string; Maximum: integer; Expected: string);
begin
  const Decoder: Http.SseDecoder := Http.CreateSseDecoder(Maximum).Unwrap();
  const Before: array of Http.SseEvent := Http.FeedSse(Decoder, Utf8.Encode(Text)).Unwrap();
  Test.AssertEquals(0, Before.Length());
  const Events: array of Http.SseEvent := Http.FinishSse(Decoder).Unwrap();
  Test.AssertEquals(1, Events.Length());
  Test.AssertEquals(Expected, Events[0].Data);
  case Http.FeedSse(Decoder, []) of
    when Ok(_):
      begin
        panic('finished decoder accepted input');
      end;
    when Error(_):
      begin
      end;
  end case;
end procedure;

begin
  for Maximum: integer := 7 to 9 do
    begin
      CheckFinal('data: x', Maximum, 'x');
    end;
  end for;

  CheckFinal('data: x' + #13, 8, 'x');
  CheckFinal('data: x' + #10, 8, 'x');
  const Small: Http.SseDecoder := Http.CreateSseDecoder(6).Unwrap();
  case Http.FeedSse(Small, Utf8.Encode('data: x')) of
    when Ok(_):
      begin
        panic('oversized event accepted');
      end;
    when Error(_):
      begin
      end;
  end case;
  const Empty: Http.SseDecoder := Http.CreateSseDecoder(1).Unwrap();
  const Events: array of Http.SseEvent := Http.FinishSse(Empty).Unwrap();
  Test.AssertEquals(0, Events.Length());
end.
