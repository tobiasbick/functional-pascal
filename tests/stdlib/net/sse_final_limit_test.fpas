program SseFinalLimitTest;

uses Std.Http, Std.Net.Utf8, Std.Test;

procedure CheckFinal(Text: string; Maximum: integer; Expected: string);
begin
  const Decoder: SseDecoder := CreateSseDecoder(Maximum).Unwrap();
  const Before: array of SseEvent := FeedSse(Decoder, Std.Net.Utf8.Encode(Text)).Unwrap();
  AssertEquals(0, Before.Length());
  const Events: array of SseEvent := FinishSse(Decoder).Unwrap();
  AssertEquals(1, Events.Length());
  AssertEquals(Expected, Events[0].Data);
  case FeedSse(Decoder, []) of
    when Ok(_):
      begin
        panic('finished decoder accepted input');
      end;
    when Error(_):
      begin
      end;
  end case;
end procedure;

begin
  for Maximum: integer := 7 to 9 do
    begin
      CheckFinal('data: x', Maximum, 'x');
    end;
  end for;

  CheckFinal('data: x' + #13, 8, 'x');
  CheckFinal('data: x' + #10, 8, 'x');
  const Small: SseDecoder := CreateSseDecoder(6).Unwrap();
  case FeedSse(Small, Std.Net.Utf8.Encode('data: x')) of
    when Ok(_):
      begin
        panic('oversized event accepted');
      end;
    when Error(_):
      begin
      end;
  end case;
  const Empty: SseDecoder := CreateSseDecoder(1).Unwrap();
  const Events: array of SseEvent := FinishSse(Empty).Unwrap();
  AssertEquals(0, Events.Length());
end.
