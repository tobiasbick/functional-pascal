program Utf8BoundariesTest;

uses Std.Net.Utf8, Std.Test;

procedure Invalid(Bytes: array of integer);
begin
  case Std.Net.Utf8.Decode(Bytes) of
    when Ok(_):
      begin
        Fail('invalid encoding accepted');
      end;
    when Error(_):
      begin
      end;
  end case;
end procedure;

begin
  for Text: string in [
                        '',
                        #0,
                        #127,
                        #128,
                        string.Chr(2047),
                        string.Chr(2048),
                        string.Chr(55295),
                        string.Chr(57344),
                        string.Chr(65535),
                        string.Chr(65536),
                        string.Chr(1114111),
                        'e' + string.Chr(769),
                        ('x' + string.Chr(769)).RepeatStr(2048)
                      ] do
    begin
      AssertEquals(Text, Std.Net.Utf8.Decode(Std.Net.Utf8.Encode(Text)).Unwrap());
    end;
  end for;

  Invalid([-1]);
  Invalid([256]);
  Invalid([128]);
  Invalid([192, 128]);
  Invalid([193, 191]);
  Invalid([194]);
  Invalid([194, 0]);
  Invalid([224, 128, 128]);
  Invalid([237, 160, 128]);
  Invalid([239, 191]);
  Invalid([239, 191, 256]);
  Invalid([240, 128, 128, 128]);
  Invalid([240, 144, 128]);
  Invalid([244, 144, 128, 128]);
  Invalid([245, 128, 128, 128]);
end.
