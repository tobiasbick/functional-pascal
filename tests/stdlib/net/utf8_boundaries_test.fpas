program Utf8BoundariesTest;

uses Std.Net.Utf8 as Utf8;
uses Std.Results as Results;
uses Std.Str as Str;
uses Std.Test as Test;

procedure Invalid(Bytes: array of integer);
begin
  case Utf8.Decode(Bytes) of
    when Ok(_):
      begin
        Test.Fail('invalid encoding accepted');
      end;
    when Error(_):
      begin
        null;
      end;
  end case;
end procedure;

begin
  for Text: string in [
                        '',
                        #0,
                        #127,
                        #128,
                        Str.Chr(2047),
                        Str.Chr(2048),
                        Str.Chr(55295),
                        Str.Chr(57344),
                        Str.Chr(65535),
                        Str.Chr(65536),
                        Str.Chr(1114111),
                        'e' + Str.Chr(769),
                        Str.RepeatStr('x' + Str.Chr(769), 2048)
                      ] do
    begin
      Test.AssertEquals(Text, Results.Unwrap(Utf8.Decode(Utf8.Encode(Text))));
    end;
  end for;

  Invalid([-1]);
  Invalid([256]);
  Invalid([128]);
  Invalid([192, 128]);
  Invalid([193, 191]);
  Invalid([194]);
  Invalid([194, 0]);
  Invalid([224, 128, 128]);
  Invalid([237, 160, 128]);
  Invalid([239, 191]);
  Invalid([239, 191, 256]);
  Invalid([240, 128, 128, 128]);
  Invalid([240, 144, 128]);
  Invalid([244, 144, 128, 128]);
  Invalid([245, 128, 128, 128]);
end program;
