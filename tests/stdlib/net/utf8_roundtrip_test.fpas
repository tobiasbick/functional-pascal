// Covers UTF-8 round trips and rejection of invalid continuation bytes.
program Utf8RoundtripTest;

uses Std.Arrays as Arrays;
uses Std.Net.Utf8 as Utf8;
uses Std.Str as Str;
uses Std.Test as Test;

begin
  var Text: string := 'Hello, Grüße 🌍';
  var Bytes: array of (integer) := Utf8.Encode(Text);
  Test.AssertEquals(19, Arrays.Length(Bytes));
  case Utf8.Decode(Bytes) of
    when Result.Ok(const Decoded):
      begin
        Test.AssertEquals(Text, Decoded);
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;

  case Utf8.Decode([240, 40, 140, 188]) of
    when Result.Ok(const Decoded):
      begin
        Test.Fail('invalid UTF-8 decoded as ' + Decoded);
      end;
    when Result.Error(const Message):
      begin
        Test.AssertTrue(Str.Contains(Message, 'continuation'));
      end;
  end case;
end program;
