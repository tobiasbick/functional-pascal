// Covers UTF-8 round trips and rejection of invalid continuation bytes.
program Utf8RoundtripTest;

uses Std.Text.Utf8 as Utf8, Std.Test as Test;

begin
  const Text: string := 'Hello, Grüße 🌍';
  const Bytes: array of integer := Utf8.Encode(Text);
  Test.AssertEquals(19, Bytes.Length());
  case Utf8.Decode(Bytes) of
    when Ok(const Decoded):
      begin
        Test.AssertEquals(Text, Decoded);
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;

  case Utf8.Decode([240, 40, 140, 188]) of
    when Ok(const Decoded):
      begin
        Test.Fail('invalid UTF-8 decoded as ' + Decoded);
      end;
    when Error(const Message):
      begin
        Test.AssertTrue(Message is Utf8.Utf8Error.InvalidByte(1, _));
      end;
  end case;
end.
