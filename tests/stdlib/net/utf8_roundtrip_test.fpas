// Covers UTF-8 round trips and rejection of invalid continuation bytes.
program Utf8RoundtripTest;

uses Std.Net.Utf8, Std.Test;

begin
  const Text: string := 'Hello, Grüße 🌍';
  const Bytes: array of integer := Encode(Text);
  AssertEquals(19, Bytes.Length());
  case Decode(Bytes) of
    when Ok(const Decoded):
      begin
        AssertEquals(Text, Decoded);
      end;
    when Error(const Message):
      begin
        Fail(Message);
      end;
  end case;

  case Decode([240, 40, 140, 188]) of
    when Ok(const Decoded):
      begin
        Fail('invalid UTF-8 decoded as ' + Decoded);
      end;
    when Error(const Message):
      begin
        AssertTrue(Message.Contains('continuation'));
      end;
  end case;
end.
