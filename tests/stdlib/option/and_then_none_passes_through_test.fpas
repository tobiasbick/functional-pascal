program T;

uses Std.Console as Console;
uses Std.Options as Options;

function AlwaysSomeOk(V: integer): Option of (string);
begin
  return Option.Some('ok');
end function;

begin
  var O: Option of (integer) := Option.None;
  var M: Option of (string) := Options.AndThen(O, AlwaysSomeOk);
  Console.WriteLn(Options.IsNone(M));
end program;
