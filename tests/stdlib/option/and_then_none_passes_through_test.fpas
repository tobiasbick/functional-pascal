program T;

uses Std.Console as Console;
uses Std.Options as Options;

pure function AlwaysSomeOk(V: integer): Option of (string);
begin
  return Option.Some('ok');
end function;

begin
  const O: Option of (integer) := Option.None;
  const M: Option of (string) := Options.AndThen(O, AlwaysSomeOk);
  Console.WriteLn(Options.IsNone(M));
end program;
