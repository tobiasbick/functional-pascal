program T;

uses Std.Console, Std.Option, Std.Conv;

function PositiveToStr(V: integer): option of string;
begin
  if V > 0 then
  begin
    return Some(IntToStr(V))
  end
  else
  begin
    return None
  end
end;

begin
  var O: option of integer := Some(5);
  var M: option of string := AndThen(O, PositiveToStr);
  WriteLn(Unwrap(M))
end.
