program T;

uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Conv as Conv;

function PositiveToStr(V: integer): option of string;
begin
  if V > 0 then
    begin
      return Some(Conv.IntToStr(V));
    end;
  else
    begin
      return None;
    end;
  end if;
end function;

begin
  var O: option of integer := Some(5);
  var M: option of string := Options.AndThen(O, PositiveToStr);
  Console.WriteLn(Options.Unwrap(M));
end program;
