program T;

uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Conv as Conv;

pure function PositiveToStr(V: integer): Option of (string);
begin
  if V > 0 then
    begin
      return Option.Some(Conv.IntToStr(V));
    end;
  else
    begin
      return Option.None;
    end;
  end if;
end function;

begin
  const O: Option of (integer) := Option.Some(5);
  const M: Option of (string) := Options.AndThen(O, PositiveToStr);
  Console.WriteLn(Options.Unwrap(M));
end program;
