program T;

uses Std.Console as Console, Std.Text.Format as Conv;

function PositiveToStr(V: integer): option of string;
begin
  if V > 0 then
    begin
      return Some(Conv.IntToStr(V));
    end;
  else
    begin
      return None;
    end;
  end if;
end function;

begin
  const O: option of integer := Some(5);
  const M: option of string := O.AndThen(PositiveToStr);
  Console.WriteLn(M.Unwrap());
end.
