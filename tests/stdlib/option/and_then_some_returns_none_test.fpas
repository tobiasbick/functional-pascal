program T;

uses Std.Console as Console;
uses Std.Options as Options;

function PositiveOk(V: integer): Option of (string);
begin
  if V > 0 then
    begin
      return Option.Some('ok');
    end;
  else
    begin
      return Option.None;
    end;
  end if;
end function;

begin
  var O: Option of (integer) := Option.Some(-1);
  var M: Option of (string) := Options.AndThen(O, PositiveOk);
  Console.WriteLn(Options.IsNone(M));
end program;
