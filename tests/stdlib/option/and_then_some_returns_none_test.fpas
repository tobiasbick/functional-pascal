program T;

uses Std.Console, Std.Options;

function PositiveOk(V: integer): option of string;
begin
  if V > 0 then
    begin
      return Some('ok');
    end;
  else
    begin
      return None;
    end;
  end if;
end function;

begin
  const O: option of integer := Some(-1);
  const M: option of string := AndThen(O, PositiveOk);
  WriteLn(IsNone(M));
end.
