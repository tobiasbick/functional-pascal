program T;

uses Std.Console as Console;
uses Std.Options as Options;

pure function AlwaysOk(V: integer): string;
begin
  return 'ok';
end function;

begin
  const O: Option of (integer) := Option.None;
  const M: Option of (string) := Options.Map(O, AlwaysOk);
  Console.WriteLn(Options.IsNone(M));
end program;
