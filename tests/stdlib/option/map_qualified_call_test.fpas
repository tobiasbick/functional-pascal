program T;

uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Conv as Conv;

function ToStr(V: integer): string;
begin
  return Conv.IntToStr(V);
end function;

begin
  var O: Option of (integer) := Option.Some(10);
  var M: Option of (string) := Options.Map(O, ToStr);
  Console.WriteLn(Options.Unwrap(M));
end program;
