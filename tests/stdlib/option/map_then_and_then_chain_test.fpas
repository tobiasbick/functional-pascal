program T;

uses Std.Console as Console;
uses Std.Options as Options;
uses Std.Conv as Conv;

function Double(V: integer): integer;
begin
  return V * 2;
end function;

function PositiveToStr(V: integer): Option of (string);
begin
  if V > 0 then
    begin
      return Option.Some(Conv.IntToStr(V));
    end;
  else
    begin
      return Option.None;
    end;
  end if;
end function;

begin
  var O: Option of (integer) := Option.Some(5);
  var Doubled: Option of (integer) := Options.Map(O, Double);
  var Final: Option of (string) := Options.AndThen(Doubled, PositiveToStr);
  Console.WriteLn(Options.Unwrap(Final));
end program;
