program T;

uses Std.Console, Std.Conv;

function Double(V: integer): integer;
begin
  return V * 2;
end function;

function PositiveToStr(V: integer): option of string;
begin
  if V > 0 then
    begin
      return Some(IntToStr(V));
    end;
  else
    begin
      return None;
    end;
  end if;
end function;

begin
  const O: option of integer := Some(5);
  const Doubled: option of integer := O.Map(Double);
  const Final: option of string := Doubled.AndThen(PositiveToStr);
  WriteLn(Final.Unwrap());
end.
