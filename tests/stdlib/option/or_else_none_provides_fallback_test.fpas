program T;

uses Std.Console as Console;
uses Std.Options as Options;

function FallbackNinetyNine(): Option of (integer);
begin
  return Option.Some(99);
end function;

begin
  var O: Option of (integer) := Option.None;
  var M: Option of (integer) := Options.OrElse(O, FallbackNinetyNine);
  Console.WriteLn(Options.Unwrap(M));
end program;
