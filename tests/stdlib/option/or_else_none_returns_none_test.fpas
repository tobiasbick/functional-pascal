program T;

uses Std.Console as Console;
uses Std.Options as Options;

pure function AlwaysNone(): Option of (integer);
begin
  return Option.None;
end function;

begin
  const O: Option of (integer) := Option.None;
  const M: Option of (integer) := Options.OrElse(O, AlwaysNone);
  Console.WriteLn(Options.IsNone(M));
end program;
