program T;

uses Std.Console as Console;
uses Std.Options as Options;

function AlwaysNone(): Option of (integer);
begin
  return Option.None;
end function;

begin
  var O: Option of (integer) := Option.None;
  var M: Option of (integer) := Options.OrElse(O, AlwaysNone);
  Console.WriteLn(Options.IsNone(M));
end program;
