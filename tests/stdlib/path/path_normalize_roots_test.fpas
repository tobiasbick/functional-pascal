program PathNormalizeRootsTest;

uses Std.Path as Path;
uses Std.Test as Test;

begin
  if Path.Join(['a', 'b']) = 'a\b' then
    begin
      Test.AssertEquals('D:\projects\demo', Path.Normalize('D:\projects\demo'));
      Test.AssertEquals('D:\projects\demo', Path.Normalize('D:/projects/demo'));
      Test.AssertEquals('D:\', Path.Normalize('D:\demo\..'));
      Test.AssertEquals('D:\demo', Path.Normalize('D:\..\demo'));
      Test.AssertEquals('D:demo', Path.Normalize('D:projects\..\demo'));
      Test.AssertEquals('\demo', Path.Normalize('\projects\..\demo'));
    end;
  else
    begin
      Test.AssertEquals('/projects/demo', Path.Normalize('/projects/./demo'));
      Test.AssertEquals('/', Path.Normalize('/demo/../..'));
    end;
  end if;
end program;
