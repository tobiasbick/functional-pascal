program ProcRunCaptureTest;

uses Std.Proc as Proc;
uses Std.Str as Str;
uses Std.Test as Test;

begin
  case Proc.CurrentExecutable() of
    when Ok(Executable):
      begin
        case Proc.RunCapture(Executable, ['--version']) of
          when Ok(Output):
            begin
              Test.AssertEquals(0, Output.ExitCode);
              Test.AssertTrue(Str.Contains(Output.Stdout, 'fpas'));
              Test.AssertEquals('', Output.Stderr);
            end;
          when Error(Message):
            begin
              Test.Fail(Message);
            end;
        end case;
      end;
    when Error(Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
