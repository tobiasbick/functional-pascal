program ProcRunCaptureTest;

uses Std.Proc as Proc, Std.Test as Test;

begin
  case Proc.CurrentExecutable() of
    when Ok(const Executable):
      begin
        case Proc.RunCapture(Executable, ['--version']) of
          when Ok(const Output):
            begin
              Test.AssertEquals(0, Output.ExitCode);
              Test.AssertTrue(('fpas' in Output.Stdout));
              Test.AssertEquals('', Output.Stderr);
            end;
          when Error(const Message):
            begin
              Test.Fail(Message.Message());
            end;
        end case;
      end;
    when Error(const Message):
      begin
        Test.Fail(Message.Message());
      end;
  end case;
end.
