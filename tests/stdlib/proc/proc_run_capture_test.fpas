program ProcRunCaptureTest;

uses Std.Proc, Std.Test;

begin
  case CurrentExecutable() of
    when Ok(const Executable):
      begin
        case RunCapture(Executable, ['--version']) of
          when Ok(const Output):
            begin
              AssertEquals(0, Output.ExitCode);
              AssertTrue(Output.Stdout.Contains('fpas'));
              AssertEquals('', Output.Stderr);
            end;
          when Error(const Message):
            begin
              Fail(Message);
            end;
        end case;
      end;
    when Error(const Message):
      begin
        Fail(Message);
      end;
  end case;
end.
