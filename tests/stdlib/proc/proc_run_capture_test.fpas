program ProcRunCaptureTest;

uses Std.Proc, Std.Str, Std.Test;

begin
  case CurrentExecutable() of
    Ok(Executable):
    begin
      case RunCapture(Executable, ['--version']) of
        Ok(Output):
        begin
          AssertEquals(0, Output.ExitCode);
          AssertTrue(Contains(Output.Stdout, 'fpas'));
          AssertEquals('', Output.Stderr)
        end;
        Error(Message):
        begin
          Fail(Message)
        end
      end
    end;
    Error(Message):
    begin
      Fail(Message)
    end
  end
end.
