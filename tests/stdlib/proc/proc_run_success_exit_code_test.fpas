program ProcRunSuccessExitCodeTest;

uses Std.Os.Proc as Proc, Std.Test as Test;

begin
  // Host process that exits 0 on Windows and Unix.
  case Proc.Run('cmd', ['/C', 'exit 0']) of
    when Ok(const Code):
      begin
        Test.AssertEquals(0, Code);
      end;
    when Error(const Message):
      begin
        // Fall back for non-Windows hosts where `cmd` is absent.
        case Proc.Run('sh', ['-c', 'exit 0']) of
          when Ok(const Code):
            begin
              Test.AssertEquals(0, Code);
            end;
          when Error(const FallbackMessage):
            begin
              Test.Fail(Message.Message() + ' / ' + FallbackMessage.Message());
            end;
        end case;
      end;
  end case;
end.
