program SetSeedReplaysSequenceTest;

uses Std.Random, Std.Test;

begin
  SetSeed(-17);
  var FirstInteger: integer := RandomInt(-1000000, 1000000);
  var FirstReal: real := Random();
  var SecondInteger: integer := RandomInt(-1000000, 1000000);
  AssertEquals(436834, FirstInteger);
  AssertEquals(0.018693080316887545, FirstReal);
  AssertEquals(-809256, SecondInteger);
  SetSeed(-17);
  AssertEquals(FirstInteger, RandomInt(-1000000, 1000000));
  AssertEquals(FirstReal, Random());
  AssertEquals(SecondInteger, RandomInt(-1000000, 1000000))
end.
