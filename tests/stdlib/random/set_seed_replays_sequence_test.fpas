program SetSeedReplaysSequenceTest;

uses Std.Random as Random2;
uses Std.Test as Test;

begin
  Random2.SetSeed(-17);
  const FirstInteger: integer := Random2.RandomInt(-1000000, 1000000);
  const FirstReal: real := Random2.Random();
  const SecondInteger: integer := Random2.RandomInt(-1000000, 1000000);
  Test.AssertEquals(436834, FirstInteger);
  Test.AssertEquals(0.018693080316887545, FirstReal);
  Test.AssertEquals(-809256, SecondInteger);
  Random2.SetSeed(-17);
  Test.AssertEquals(FirstInteger, Random2.RandomInt(-1000000, 1000000));
  Test.AssertEquals(FirstReal, Random2.Random());
  Test.AssertEquals(SecondInteger, Random2.RandomInt(-1000000, 1000000));
end program;
