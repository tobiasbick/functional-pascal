program RegexOperations;

uses Std.Text.Regex as Regex, Std.Test as Test;

begin
  const Pattern := Regex.Compile('(?P<word>[a-z]+)(?:-([0-9]+))?', Regex.DefaultOptions()).Unwrap();
  Test.AssertTrue(Regex.IsMatch(Pattern, 'abc-42').Unwrap());
  Test.AssertFalse(Regex.IsMatch(Pattern, '123').Unwrap());
  const Found := Regex.Find(Pattern, ' abc-42 def', 0).Unwrap().Unwrap();
  Test.AssertEquals(1, Found.Span.Start);
  Test.AssertEquals(6, Found.Span.Length);
  Test.AssertEquals('abc-42', Found.Span.Text);
  Test.AssertEquals(3, Found.Groups.Length());
  Test.AssertEquals('word', Found.Groups[1].Name.Unwrap());
  Test.AssertEquals('abc', Found.Groups[1].Value.Unwrap().Text);
  Test.AssertEquals('42', Found.Groups[2].Value.Unwrap().Text);
  const All := Regex.FindAll(Pattern, 'abc-42 def', 0).Unwrap();
  Test.AssertEquals(2, All.Length());
  Test.AssertTrue(All[1].Groups[2].Value is None);
  Test.AssertEquals('def', All[1].Groups[0].Value.Unwrap().Text);
  Test.AssertTrue(Regex.Find(Pattern, '123', 0).Unwrap() is None);
  const Names := Regex.GroupNames(Pattern).Unwrap();
  Test.AssertTrue(Names[0] is None);
  Test.AssertEquals('word', Names[1].Unwrap());
  Test.AssertTrue(Names[2] is None);
  Test.AssertEquals(
    '<abc:42:$> <def::$>',
    Regex.Replace(Pattern, 'abc-42 def', '<${word}:$2:$$>', 0).Unwrap()
  );
  Test.AssertEquals('X def', Regex.Replace(Pattern, 'abc-42 def', 'X', 1).Unwrap());
  const Separator := Regex.Compile('[,;]+', Regex.DefaultOptions()).Unwrap();
  const Parts := Regex.Split(Separator, ',a;;b,', 0).Unwrap();
  Test.AssertEquals(4, Parts.Length());
  Test.AssertEquals('', Parts[0]);
  Test.AssertEquals('a', Parts[1]);
  Test.AssertEquals('b', Parts[2]);
  Test.AssertEquals('', Parts[3]);
  const Limited := Regex.Split(Separator, 'a,b;c', 2).Unwrap();
  Test.AssertEquals(2, Limited.Length());
  Test.AssertEquals('b;c', Limited[1]);
  const Literal := 'a+b.(c)[d]$^?*{}|\';
  const Escaped := Regex.Compile(Regex.Escape(Literal).Unwrap(), Regex.DefaultOptions()).Unwrap();
  Test.AssertEquals(Literal, Regex.Find(Escaped, Literal, 0).Unwrap().Unwrap().Span.Text);
end.
