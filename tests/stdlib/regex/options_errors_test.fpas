program RegexOptionsErrors;

uses Std.Text.Regex as Regex, Std.Test as Test;

type Settings = Regex.Options;

type CompiledPattern = Regex.Pattern;

begin
  var Options: Settings := Regex.DefaultOptions();
  Options.CaseInsensitive := true;
  Test.AssertTrue(Regex.IsMatch(Regex.Compile('é', Options).Unwrap(), 'É').Unwrap());
  Options.MultiLine := true;
  Test.AssertTrue(Regex.IsMatch(Regex.Compile('^b$', Options).Unwrap(), 'a' + #10 + 'B').Unwrap());
  Options.DotMatchesNewLine := true;
  Test.AssertTrue(Regex.IsMatch(Regex.Compile('a.b', Options).Unwrap(), 'a' + #10 + 'b').Unwrap());
  Options.IgnoreWhitespace := true;
  Test.AssertTrue(Regex.IsMatch(Regex.Compile('a b # comment', Options).Unwrap(), 'ab').Unwrap());
  Options := Regex.DefaultOptions();
  Options.SwapGreed := true;
  Test.AssertEquals(
    'a',
    Regex.Find(Regex.Compile('a+', Options).Unwrap(), 'aaa', 0).Unwrap().Unwrap().Span.Text
  );
  Options := Regex.DefaultOptions();
  Options.MultiLine := true;
  Options.CrLf := true;
  Test.AssertTrue(Regex.IsMatch(Regex.Compile('^b$', Options).Unwrap(), 'b' + #13 + #10).Unwrap());
  Test.AssertTrue(Regex.Compile('(', Options) is Error(Regex.RegexError.InvalidPattern(_)));
  Test.AssertTrue(Regex.Compile('(?=a)', Options) is Error(Regex.RegexError.InvalidPattern(_)));
  const Pattern: CompiledPattern := Regex.Compile('.', Options).Unwrap();
  Test.AssertTrue(Regex.Find(Pattern, 'é', -1) is Error(Regex.RegexError.InvalidStart(-1, 1)));
  Test.AssertTrue(Regex.FindAll(Pattern, 'é', 2) is Error(Regex.RegexError.InvalidStart(2, 1)));
  Test.AssertTrue(Regex.Replace(Pattern, 'é', 'x', -1) is Error(Regex.RegexError.InvalidLimit(-1)));
  Test.AssertTrue(Regex.Split(Pattern, 'é', -1) is Error(Regex.RegexError.InvalidLimit(-1)));
end.
