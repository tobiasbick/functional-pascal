program T;

uses Std.Console as Console;

function AlwaysOk(V: integer): result of (string, string);
begin
  return Ok('ok');
end function;

begin
  const R: result of (integer, string) := Error('original');
  const M: result of (string, string) := R.AndThen(AlwaysOk);
  Console.WriteLn(M.IsError());
end.
