program T;

uses Std.Console as Console;
uses Std.Results as Results;
uses Std.Conv as Conv;

function PositiveToStr(V: integer): Result of (string, string);
begin
  if V > 0 then
    begin
      return Result.Ok(Conv.IntToStr(V));
    end;
  else
    begin
      return Result.Error('non-positive');
    end;
  end if;
end function;

begin
  var R: Result of (integer, string) := Result.Ok(10);
  var M: Result of (string, string) := Results.AndThen(R, PositiveToStr);
  Console.WriteLn(Results.Unwrap(M));
end program;
