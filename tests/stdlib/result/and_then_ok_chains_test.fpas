program T;

uses Std.Console as Console, Std.Text.Format as Conv;

function PositiveToStr(V: integer): result of (string, string);
begin
  if V > 0 then
    begin
      return Ok(Conv.IntToStr(V));
    end;
  else
    begin
      return Error('non-positive');
    end;
  end if;
end function;

begin
  const R: result of (integer, string) := Ok(10);
  const M: result of (string, string) := R.AndThen(PositiveToStr);
  Console.WriteLn(M.Unwrap());
end.
