program T;

uses Std.Console, Std.Result;

function PositiveOk(V: integer): result of string, string;
begin
  if V > 0 then
  begin
    return Ok('ok')
  end
  else
  begin
    return Error('non-positive')
  end
end;

begin
  var R: result of integer, string := Ok(-1);
  var M: result of string, string := AndThen(R, PositiveOk);
  WriteLn(IsError(M))
end.
