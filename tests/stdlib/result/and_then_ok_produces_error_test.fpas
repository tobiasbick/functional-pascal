program T;

uses Std.Console as Console;

function PositiveOk(V: integer): result of (string, string);
begin
  if V > 0 then
    begin
      return Ok('ok');
    end;
  else
    begin
      return Error('non-positive');
    end;
  end if;
end function;

begin
  const R: result of (integer, string) := Ok(-1);
  const M: result of (string, string) := R.AndThen(PositiveOk);
  Console.WriteLn((M is Error(_)));
end.
