program T;

uses Std.Console as Console;
uses Std.Results as Results;

function PositiveOk(V: integer): Result of (string, string);
begin
  if V > 0 then
    begin
      return Result.Ok('ok');
    end;
  else
    begin
      return Result.Error('non-positive');
    end;
  end if;
end function;

begin
  var R: Result of (integer, string) := Result.Ok(-1);
  var M: Result of (string, string) := Results.AndThen(R, PositiveOk);
  Console.WriteLn(Results.IsError(M));
end program;
