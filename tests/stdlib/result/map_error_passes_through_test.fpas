program T;

uses Std.Console as Console;
uses Std.Results as Results;

pure function AlwaysOk(V: integer): string;
begin
  return 'ok';
end function;

begin
  const R: Result of (integer, string) := Result.Error('fail');
  const M: Result of (string, string) := Results.Map(R, AlwaysOk);
  Console.WriteLn(Results.IsError(M));
end program;
