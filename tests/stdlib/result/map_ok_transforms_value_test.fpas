program T;

uses Std.Console as Console;
uses Std.Results as Results;
uses Std.Conv as Conv;

pure function DoubleToStr(V: integer): string;
begin
  return Conv.IntToStr(V * 2);
end function;

begin
  const R: Result of (integer, string) := Result.Ok(21);
  const M: Result of (string, string) := Results.Map(R, DoubleToStr);
  Console.WriteLn(Results.Unwrap(M));
end program;
