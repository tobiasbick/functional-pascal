program T;

uses Std.Console as Console;
uses Std.Results as Results;
uses Std.Conv as Conv;

pure function ToStr(V: integer): string;
begin
  return Conv.IntToStr(V);
end function;

begin
  const R: Result of (integer, string) := Result.Ok(5);
  const M: Result of (string, string) := Results.Map(R, ToStr);
  Console.WriteLn(Results.Unwrap(M));
end program;
