program T;

uses Std.Console as Console;
uses Std.Results as Results;
uses Std.Conv as Conv;

function ToStr(V: integer): string;
begin
  return Conv.IntToStr(V);
end function;

begin
  var R: result of integer, string := Ok(5);
  var M: result of string, string := Results.Map(R, ToStr);
  Console.WriteLn(Results.Unwrap(M));
end program;
