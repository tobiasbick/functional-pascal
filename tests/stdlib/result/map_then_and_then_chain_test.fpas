program T;

uses Std.Console as Console, Std.Text.Format as Conv;

function Double(V: integer): integer;
begin
  return V * 2;
end function;

function PositiveToStr(V: integer): result of (string, string);
begin
  if V > 0 then
    begin
      return Ok(Conv.IntToStr(V));
    end;
  else
    begin
      return Error('non-positive');
    end;
  end if;
end function;

begin
  const R: result of (integer, string) := Ok(5);
  const Doubled: result of (integer, string) := R.Map(Double);
  const Final: result of (string, string) := Doubled.AndThen(PositiveToStr);
  Console.WriteLn(Final.Unwrap());
end.
