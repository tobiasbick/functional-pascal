program T;

uses Std.Console as Console;
uses Std.Results as Results;
uses Std.Conv as Conv;

function Double(V: integer): integer;
begin
  return V * 2;
end function;

function PositiveToStr(V: integer): result of string, string;
begin
  if V > 0 then
    begin
      return Ok(Conv.IntToStr(V));
    end;
  else
    begin
      return Error('non-positive');
    end;
  end if;
end function;

begin
  var R: result of integer, string := Ok(5);
  var Doubled: result of integer, string := Results.Map(R, Double);
  var Final: result of string, string := Results.AndThen(Doubled, PositiveToStr);
  Console.WriteLn(Results.Unwrap(Final));
end program;
