program T;

uses Std.Console as Console;
uses Std.Results as Results;
uses Std.Conv as Conv;

pure function Double(V: integer): integer;
begin
  return V * 2;
end function;

pure function PositiveToStr(V: integer): Result of (string, string);
begin
  if V > 0 then
    begin
      return Result.Ok(Conv.IntToStr(V));
    end;
  else
    begin
      return Result.Error('non-positive');
    end;
  end if;
end function;

begin
  const R: Result of (integer, string) := Result.Ok(5);
  const Doubled: Result of (integer, string) := Results.Map(R, Double);
  const Final: Result of (string, string) := Results.AndThen(Doubled, PositiveToStr);
  Console.WriteLn(Results.Unwrap(Final));
end program;
