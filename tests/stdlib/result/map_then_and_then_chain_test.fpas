program T;

uses Std.Console, Std.Results, Std.Conv;

function Double(V: integer): integer;
begin
  return V * 2;
end function;

function PositiveToStr(V: integer): result of string, string;
begin
  if V > 0 then
    begin
      return Ok(IntToStr(V));
    end;
  else
    begin
      return Error('non-positive');
    end;
  end if;
end function;

begin
  const R: result of integer, string := Ok(5);
  const Doubled: result of integer, string := Map(R, Double);
  const Final: result of string, string := AndThen(Doubled, PositiveToStr);
  WriteLn(Unwrap(Final));
end.
