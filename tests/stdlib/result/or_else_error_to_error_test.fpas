program T;

uses Std.Console as Console;

function ReplaceError(E: string): result of (integer, string);
begin
  return Error('second');
end function;

begin
  const R: result of (integer, string) := Error('first');
  const M: result of (integer, string) := R.OrElse(ReplaceError);
  Console.WriteLn(M.IsError());
end.
