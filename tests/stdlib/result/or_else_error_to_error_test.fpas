program T;

uses Std.Console, Std.Results;

function ReplaceError(E: string): result of integer, string;
begin
  return Error('second');
end function;

begin
  const R: result of integer, string := Error('first');
  const M: result of integer, string := OrElse(R, ReplaceError);
  WriteLn(IsError(M));
end.
