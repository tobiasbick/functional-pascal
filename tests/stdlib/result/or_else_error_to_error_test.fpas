program T;

uses Std.Console as Console;
uses Std.Results as Results;

function ReplaceError(E: string): result of integer, string;
begin
  return Error('second');
end function;

begin
  var R: result of integer, string := Error('first');
  var M: result of integer, string := Results.OrElse(R, ReplaceError);
  Console.WriteLn(Results.IsError(M));
end program;
