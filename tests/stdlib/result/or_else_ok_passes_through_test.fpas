program T;

uses Std.Console as Console;
uses Std.Results as Results;

function RecoverZero(E: string): Result of (integer, string);
begin
  return Result.Ok(0);
end function;

begin
  var R: Result of (integer, string) := Result.Ok(42);
  var M: Result of (integer, string) := Results.OrElse(R, RecoverZero);
  Console.WriteLn(Results.Unwrap(M));
end program;
