program ServerFailureTest;

uses Std.Server, Std.Net, Std.Tasks, Std.Results, Std.Test, Std.Arrays;

function BindListener(): result of Std.Net.Listener, string;
begin
  for Port: integer := 28200 to 28299 do
    begin
      const Opened: result of Std.Net.Listener, string := Listen('127.0.0.1', Port);
      if IsOk(Opened) then
        begin
          return Opened;
        end;
      end if;
    end;
  end for;

  return Error('no test port available');
end function;

begin
  const Life: ServerLifetime := Unwrap(CreateLifetime(1000, false));
  const Group: TaskGroup := GetWorkGroup(Life);
  const Worker: task := StartTaskInGroup(Group, function(Token: CancellationToken): result of boolean, string begin
    return Error('session failed');
  end function);
  const Listener: Std.Net.Listener := Unwrap(BindListener());
  discard OwnListener(Life, Listener);
  // Deliberate ownership misuse: cleanup must preserve this failure.
  discard CloseListener(Listener);
  discard RequestStop(Life);
  const Failures: array of TaskFailure := CloseTaskGroup(Group);
  AssertEquals(1, Std.Arrays.Length(Failures));
  AssertEquals('session failed', Failures[0].Message);
  AssertEquals(1, Std.Arrays.Length(ShutdownErrors(Life)));
  AssertTrue(Unwrap(FinishShutdown(Life)));
end.
