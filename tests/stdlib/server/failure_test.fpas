program ServerFailureTest;

uses Std.Server as Server;
uses Std.Net as Net;
uses Std.Tasks as Tasks;
uses Std.Results as Results;
uses Std.Test as Test;
uses Std.Arrays as Arrays;

function BindListener(): result of Net.Listener, string;
begin
  for Port: integer := 28200 to 28299 do
    begin
      var Opened: result of Net.Listener, string := Net.Listen('127.0.0.1', Port);
      if Results.IsOk(Opened) then
        begin
          return Opened;
        end;
      end if;
    end;
  end for;

  return Error('no test port available');
end function;

begin
  var Life: Server.ServerLifetime := Results.Unwrap(Server.CreateLifetime(1000, false));
  var Group: Tasks.TaskGroup := Server.GetWorkGroup(Life);
  var Worker: task := Tasks.StartTaskInGroup(Group, function(Token: Tasks.CancellationToken): result of boolean, string begin
    return Error('session failed');
  end function);
  var Listener: Net.Listener := Results.Unwrap(BindListener());
  Server.OwnListener(Life, Listener);
  // Deliberate ownership misuse: cleanup must preserve this failure.
  Net.CloseListener(Listener);
  Server.RequestStop(Life);
  var Failures: array of Tasks.TaskFailure := Tasks.CloseTaskGroup(Group);
  Test.AssertEquals(1, Arrays.Length(Failures));
  Test.AssertEquals('session failed', Failures[0].Message);
  Test.AssertEquals(1, Arrays.Length(Server.ShutdownErrors(Life)));
  Test.AssertTrue(Results.Unwrap(Server.FinishShutdown(Life)));
end program;
