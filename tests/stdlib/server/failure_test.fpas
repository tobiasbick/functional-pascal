program ServerFailureTest;

uses Std.Server as Server, Std.Net as Net, Std.Tasks as Tasks, Std.Test as Test;

function BindListener(): result of (Net.Listener, string);
begin
  for Port: integer := 28200 to 28299 do
    begin
      const Opened: result of (Net.Listener, string) := Net.Listen('127.0.0.1', Port);
      if (Opened is Ok(_)) then
        begin
          return Opened;
        end;
      end if;
    end;
  end for;

  return Error('no test port available');
end function;

begin
  const Life: Server.ServerLifetime := Server.CreateLifetime(1000, false).Unwrap();
  const Group: Tasks.TaskGroup := Server.GetWorkGroup(Life);
  const Worker: task of result of (boolean, string) := Tasks.StartTaskInGroup(Group, function(Token: Tasks.CancellationToken): result of (boolean, string) begin
    return Error('session failed');
  end function);
  const Listener: Net.Listener := BindListener().Unwrap();
  discard Server.OwnListener(Life, Listener);
  // Deliberate ownership misuse: cleanup must preserve this failure.
  discard Net.CloseListener(Listener);
  discard Server.RequestStop(Life);
  case Tasks.Wait(Worker) of
    when Error(const Message):
      Test.AssertEquals('session failed', Message);
    when Ok(_):
      panic('expected ordinary worker error data');
  end case;
  const Failures: array of Tasks.TaskFailure := Tasks.CloseTaskGroup(Group);
  Test.AssertEquals(0, Failures.Length());
  Test.AssertEquals(1, Server.ShutdownErrors(Life).Length());
  Test.AssertTrue(Server.FinishShutdown(Life).Unwrap());
end.
