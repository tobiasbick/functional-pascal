program ServerFailureTest;

uses Std.Server as Server;
uses Std.Net as Net;
uses Std.Tasks as Tasks;
uses Std.Results as Results;
uses Std.Test as Test;
uses Std.Arrays as Arrays;

function Require of (T)(Outcome: Result of (T, string)): T;
begin
  case Outcome of
    when Result.Ok(const Value):
      return Value;
    when Result.Error(const Message):
      panic(Message);
  end case;
end function;

function BindListener(): Result of (Net.Listener, string);
begin
  for Port: integer := 28200 to 28299 do
    begin
      const Opened: Result of (Net.Listener, string) := Net.Listen('127.0.0.1', Port);
      if (case Opened of
        when Result.Ok(_): true;
        when Result.Error(_): false;
      end case) then
        begin
          return Opened;
        end;
      end if;
    end;
  end for;

  return Result.Error('no test port available');
end function;

begin
  const Life: Server.ServerLifetime := Require(Server.CreateLifetime(1000, false));
  const Group: Tasks.TaskGroup := Server.GetWorkGroup(Life);
  const Worker: task := Tasks.StartTaskInGroup(Group, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
    return Result.Error('session failed');
  end function);
  const Listener: Net.Listener := Require(BindListener());
  discard Server.OwnListener(Life, Listener);
  // Deliberate ownership misuse: cleanup must preserve this failure.
  discard Net.CloseListener(Listener);
  discard Server.RequestStop(Life);
  const Failures: array of (Tasks.TaskFailure) := Tasks.CloseTaskGroup(Group);
  Test.AssertEquals(1, Arrays.Length(Failures));
  Test.AssertEquals('session failed', Failures[0].Message);
  Test.AssertEquals(1, Arrays.Length(Server.ShutdownErrors(Life)));
  Test.AssertTrue(Results.Unwrap(Server.FinishShutdown(Life)));
end program;
