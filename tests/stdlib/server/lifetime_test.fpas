program ServerLifetimeTest;

uses Std.Server as Server;
uses Std.Tasks as Tasks;
uses Std.Time as Time;
uses Std.Results as Results;
uses Std.Test as Test;
uses Std.Arrays as Arrays;

function Require of (T)(Outcome: Result of (T, string)): T;
begin
  case Outcome of
    when Result.Ok(const Value):
      return Value;
    when Result.Error(const Message):
      panic(Message);
  end case;
end function;

begin
  Test.AssertTrue((case Server.CreateLifetime(-1, false) of
    when Result.Ok(_): false;
    when Result.Error(_): true;
  end case));
  Test.AssertTrue((case Server.CreateLifetime(86400001, false) of
    when Result.Ok(_): false;
    when Result.Error(_): true;
  end case));
  const Life: Server.ServerLifetime := Require(Server.CreateLifetime(20, false));
  const Group: Tasks.TaskGroup := Server.GetWorkGroup(Life);
  const Gate: channel of (boolean) := Tasks.CreateChannel(1);
  const Worker: task := Tasks.StartTaskInGroup(Group, function(Token: Tasks.CancellationToken): boolean begin
    return Results.Unwrap(Tasks.Receive(Gate));
  end function);
  Test.AssertTrue(Server.IsReady(Life));
  Test.AssertTrue(not Tasks.IsCancellationRequested(Server.GetStopToken(Life)));
  Test.AssertTrue(Results.IsError(Server.FinishShutdown(Life)));
  Test.AssertTrue(Server.RequestStop(Life));
  Test.AssertTrue(not Server.IsReady(Life));
  Test.AssertTrue(Tasks.IsCancellationRequested(Server.GetStopToken(Life)));
  Test.AssertTrue(not Server.RequestStop(Life));
  Test.AssertTrue(Results.IsError(Tasks.CloseTaskGroupWithTimeout(Group, Server.RemainingMillis(Life))));
  Test.AssertEquals(0, Server.RemainingMillis(Life));
  Test.AssertTrue(Results.IsError(Server.FinishShutdown(Life)));
  Test.AssertTrue(not Server.RequestStop(Life));
  Test.AssertEquals(0, Server.RemainingMillis(Life));
  discard Tasks.Send(Gate, true);
  Test.AssertEquals(0, Arrays.Length(Tasks.CloseTaskGroup(Group)));
  Test.AssertTrue(Results.Unwrap(Server.FinishShutdown(Life)));
  Test.AssertTrue(Results.Unwrap(Server.FinishShutdown(Life)));
  Test.AssertEquals(0, Arrays.Length(Server.ShutdownErrors(Life)));
  discard Tasks.CloseChannel(Gate);
end program;
