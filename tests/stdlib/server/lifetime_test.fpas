program ServerLifetimeTest;

uses Std.Server, Std.Tasks, Std.Time, Std.Test;

begin
  AssertTrue(CreateLifetime(-1, false).IsError());
  AssertTrue(CreateLifetime(86400001, false).IsError());
  const Life: ServerLifetime := CreateLifetime(20, false).Unwrap();
  const Group: TaskGroup := GetWorkGroup(Life);
  const Gate: channel of boolean := CreateChannel(1);
  const Worker: task := StartTaskInGroup(Group, function(Token: CancellationToken): boolean begin
    return Receive(Gate).Unwrap();
  end function);
  AssertTrue(IsReady(Life));
  AssertTrue(not IsCancellationRequested(GetStopToken(Life)));
  AssertTrue(FinishShutdown(Life).IsError());
  AssertTrue(RequestStop(Life));
  AssertTrue(not IsReady(Life));
  AssertTrue(IsCancellationRequested(GetStopToken(Life)));
  AssertTrue(not RequestStop(Life));
  AssertTrue(CloseTaskGroupWithTimeout(Group, RemainingMillis(Life)).IsError());
  AssertEquals(0, RemainingMillis(Life));
  AssertTrue(FinishShutdown(Life).IsError());
  AssertTrue(not RequestStop(Life));
  AssertEquals(0, RemainingMillis(Life));
  discard Send(Gate, true);
  AssertEquals(0, CloseTaskGroup(Group).Length());
  AssertTrue(FinishShutdown(Life).Unwrap());
  AssertTrue(FinishShutdown(Life).Unwrap());
  AssertEquals(0, ShutdownErrors(Life).Length());
  discard CloseChannel(Gate);
end.
