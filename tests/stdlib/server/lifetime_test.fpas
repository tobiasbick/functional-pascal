program ServerLifetimeTest;

uses Std.Server as Server, Std.Tasks as Tasks, Std.Time as Time, Std.Test as Test;

begin
  Test.AssertTrue(Server.CreateLifetime(-1, false).IsError());
  Test.AssertTrue(Server.CreateLifetime(86400001, false).IsError());
  const Life: Server.ServerLifetime := Server.CreateLifetime(20, false).Unwrap();
  const Group: Tasks.TaskGroup := Server.GetWorkGroup(Life);
  const Gate: channel of boolean := Tasks.CreateChannel(1);
  const Worker: task of boolean := Tasks.StartTaskInGroup(Group, function(Token: Tasks.CancellationToken): boolean begin
    return Tasks.Receive(Gate).Unwrap();
  end function);
  Test.AssertTrue(Server.IsReady(Life));
  Test.AssertTrue(not Tasks.IsCancellationRequested(Server.GetStopToken(Life)));
  Test.AssertTrue(Server.FinishShutdown(Life).IsError());
  Test.AssertTrue(Server.RequestStop(Life));
  Test.AssertTrue(not Server.IsReady(Life));
  Test.AssertTrue(Tasks.IsCancellationRequested(Server.GetStopToken(Life)));
  Test.AssertTrue(not Server.RequestStop(Life));
  Test.AssertTrue(Tasks.CloseTaskGroupWithTimeout(Group, Server.RemainingMillis(Life)).IsError());
  Test.AssertEquals(0, Server.RemainingMillis(Life));
  Test.AssertTrue(Server.FinishShutdown(Life).IsError());
  Test.AssertTrue(not Server.RequestStop(Life));
  Test.AssertEquals(0, Server.RemainingMillis(Life));
  discard Tasks.Send(Gate, true);
  Test.AssertEquals(0, Tasks.CloseTaskGroup(Group).Length());
  Test.AssertTrue(Server.FinishShutdown(Life).Unwrap());
  Test.AssertTrue(Server.FinishShutdown(Life).Unwrap());
  Test.AssertEquals(0, Server.ShutdownErrors(Life).Length());
  discard Tasks.CloseChannel(Gate);
end.
