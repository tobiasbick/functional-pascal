program ServerListenerTest;

uses Std.Net.Server as Server, Std.Net.Sockets as Net, Std.Tasks as Tasks, Std.Test as Test;

function BindListener(): result of (Net.Listener, Net.NetError);
begin
  return Net.Listen('127.0.0.1', 0);
end function;

begin
  const Life: Server.ServerLifetime := Server.CreateLifetime(1000, false).Unwrap();
  const Other: Server.ServerLifetime := Server.CreateLifetime(1000, false).Unwrap();
  const Listener: Net.Listener := BindListener().Unwrap();
  Test.AssertTrue(Server.OwnListener(Life, Listener).Unwrap());
  Test.AssertTrue(not Server.OwnListener(Life, Listener).Unwrap());
  Test.AssertTrue((Server.OwnListener(Other, Listener) is Error(_)));
  Test.AssertTrue(Server.RequestStop(Life));
  Test.AssertTrue((Net.Accept(Listener) is Error(_)));
  Test.AssertTrue((Server.OwnListener(Life, Listener) is Error(_)));
  Test.AssertEquals(0, Tasks.CloseTaskGroup(Server.GetWorkGroup(Life)).Length());
  Test.AssertTrue(Server.FinishShutdown(Life).Unwrap());
  Test.AssertEquals(0, Server.ShutdownErrors(Life).Length());
  discard Server.RequestStop(Other);
  discard Tasks.CloseTaskGroup(Server.GetWorkGroup(Other));
  Test.AssertTrue(Server.FinishShutdown(Other).Unwrap());
end.
