program ServerListenerTest;

uses Std.Server, Std.Net, Std.Task, Std.Result, Std.Test, Std.Array;

function BindListener(): result of Std.Net.Listener, string;
begin
  for Port: integer := 28100 to 28199 do
  begin
    var Opened: result of Std.Net.Listener, string := Listen('127.0.0.1', Port);
    if IsOk(Opened) then
    begin
      return Opened
    end
  end;

  return Error('no test port available')
end;

begin
  var Life: ServerLifetime := Unwrap(CreateLifetime(1000, false));
  var Other: ServerLifetime := Unwrap(CreateLifetime(1000, false));
  var Listener: Std.Net.Listener := Unwrap(BindListener());
  AssertTrue(Unwrap(OwnListener(Life, Listener)));
  AssertTrue(not Unwrap(OwnListener(Life, Listener)));
  AssertTrue(IsError(OwnListener(Other, Listener)));
  AssertTrue(RequestStop(Life));
  AssertTrue(IsError(Accept(Listener)));
  AssertTrue(IsError(OwnListener(Life, Listener)));
  AssertEquals(0, Std.Array.Length(CloseTaskGroup(GetWorkGroup(Life))));
  AssertTrue(Unwrap(FinishShutdown(Life)));
  AssertEquals(0, Std.Array.Length(ShutdownErrors(Life)));
  RequestStop(Other);
  CloseTaskGroup(GetWorkGroup(Other));
  AssertTrue(Unwrap(FinishShutdown(Other)))
end.
