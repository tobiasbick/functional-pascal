program ServerListenerTest;

uses Std.Server as Server;
uses Std.Net as Net;
uses Std.Tasks as Tasks;
uses Std.Results as Results;
uses Std.Test as Test;
uses Std.Arrays as Arrays;

function Require of (T)(Outcome: Result of (T, string)): T;
begin
  case Outcome of
    when Result.Ok(const Value):
      return Value;
    when Result.Error(const Message):
      panic(Message);
  end case;
end function;

function BindListener(): Result of (Net.Listener, string);
begin
  for Port: integer := 28100 to 28199 do
    begin
      const Opened: Result of (Net.Listener, string) := Net.Listen('127.0.0.1', Port);
      if (case Opened of
        when Result.Ok(_): true;
        when Result.Error(_): false;
      end case) then
        begin
          return Opened;
        end;
      end if;
    end;
  end for;

  return Result.Error('no test port available');
end function;

begin
  const Life: Server.ServerLifetime := Require(Server.CreateLifetime(1000, false));
  const Other: Server.ServerLifetime := Require(Server.CreateLifetime(1000, false));
  const Listener: Net.Listener := Require(BindListener());
  Test.AssertTrue(Results.Unwrap(Server.OwnListener(Life, Listener)));
  Test.AssertTrue(not Results.Unwrap(Server.OwnListener(Life, Listener)));
  Test.AssertTrue(Results.IsError(Server.OwnListener(Other, Listener)));
  Test.AssertTrue(Server.RequestStop(Life));
  Test.AssertTrue((case Net.Accept(Listener) of
    when Result.Ok(_): false;
    when Result.Error(_): true;
  end case));
  Test.AssertTrue(Results.IsError(Server.OwnListener(Life, Listener)));
  Test.AssertEquals(0, Arrays.Length(Tasks.CloseTaskGroup(Server.GetWorkGroup(Life))));
  Test.AssertTrue(Results.Unwrap(Server.FinishShutdown(Life)));
  Test.AssertEquals(0, Arrays.Length(Server.ShutdownErrors(Life)));
  discard Server.RequestStop(Other);
  discard Tasks.CloseTaskGroup(Server.GetWorkGroup(Other));
  Test.AssertTrue(Results.Unwrap(Server.FinishShutdown(Other)));
end program;
