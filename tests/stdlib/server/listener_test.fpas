program ServerListenerTest;

uses Std.Server, Std.Net, Std.Tasks, Std.Test;

function BindListener(): result of Std.Net.Listener, string;
begin
  for Port: integer := 28100 to 28199 do
    begin
      const Opened: result of Std.Net.Listener, string := Listen('127.0.0.1', Port);
      if Opened.IsOk() then
        begin
          return Opened;
        end;
      end if;
    end;
  end for;

  return Error('no test port available');
end function;

begin
  const Life: ServerLifetime := CreateLifetime(1000, false).Unwrap();
  const Other: ServerLifetime := CreateLifetime(1000, false).Unwrap();
  const Listener: Std.Net.Listener := BindListener().Unwrap();
  AssertTrue(OwnListener(Life, Listener).Unwrap());
  AssertTrue(not OwnListener(Life, Listener).Unwrap());
  AssertTrue(OwnListener(Other, Listener).IsError());
  AssertTrue(RequestStop(Life));
  AssertTrue(Accept(Listener).IsError());
  AssertTrue(OwnListener(Life, Listener).IsError());
  AssertEquals(0, CloseTaskGroup(GetWorkGroup(Life)).Length());
  AssertTrue(FinishShutdown(Life).Unwrap());
  AssertEquals(0, ShutdownErrors(Life).Length());
  discard RequestStop(Other);
  discard CloseTaskGroup(GetWorkGroup(Other));
  AssertTrue(FinishShutdown(Other).Unwrap());
end.
