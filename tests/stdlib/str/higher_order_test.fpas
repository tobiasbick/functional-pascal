program StringHigherOrderTest;

uses Std.Str as Str;
uses Std.Test as Test;

pure function ReplaceFace(C: string): string;
begin
  if C = '😀' then
    begin
      return 'ß';
    end;
  end if;

  return C;
end function;

pure function KeepBase(C: string): boolean;
begin
  return (C <> '́') and (C <> ' ');
end function;

pure function Count(Acc: integer; C: string): integer;
begin
  return Acc + 1;
end function;

pure function Prepend(Acc: string; C: string): string;
begin
  return C + Acc;
end function;

begin
  const Text: string := 'a😀éb';
  Test.AssertEquals(5, Str.Length(Text));
  Test.AssertEquals('aßéb', Str.Map(Text, ReplaceFace));
  Test.AssertEquals(5, Str.Length(Str.Map(Text, ReplaceFace)));
  Test.AssertEquals('a😀eb', Str.Filter(Text, KeepBase));
  Test.AssertEquals('ab', Str.Filter('a ́b', KeepBase));
  Test.AssertEquals(5, Str.Reduce(Text, 0, Count));
  Test.AssertEquals('b́e😀a', Str.Reduce(Text, '', Prepend));
  const Observe: pure function(C: string): string := pure function(C: string): string begin
    panic('empty map invoked its callback');
  end function;

  Test.AssertEquals('', Str.Map('', Observe));
  Test.AssertEquals('', Str.Filter('', KeepBase));
  Test.AssertEquals(42, Str.Reduce('', 42, Count));
end program;
