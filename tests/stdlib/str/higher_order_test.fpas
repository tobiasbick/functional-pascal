program StringHigherOrderTest;

uses Std.Test;

function ReplaceFace(C: string): string;
begin
  if C = '😀' then
    begin
      return 'ß';
    end;
  end if;

  return C;
end function;

function KeepBase(C: string): boolean;
begin
  return (C <> '́') and (C <> ' ');
end function;

function Count(Acc: integer; C: string): integer;
begin
  return Acc + 1;
end function;

function Prepend(Acc: string; C: string): string;
begin
  return C + Acc;
end function;

begin
  const Text: string := 'a😀éb';
  AssertEquals(5, Text.Length());
  AssertEquals('aßéb', Text.Map(ReplaceFace));
  AssertEquals(5, Text.Map(ReplaceFace).Length());
  AssertEquals('a😀eb', Text.Filter(KeepBase));
  AssertEquals('ab', 'a ́b'.Filter(KeepBase));
  AssertEquals(5, Text.Reduce(0, Count));
  AssertEquals('b́e😀a', Text.Reduce('', Prepend));
  var Calls: integer := 0;
  const Observe: function(C: string): string := function(C: string): string begin
    Calls := Calls + 1;
    return C;
  end function;

  AssertEquals('', ''.Map(Observe));
  AssertEquals('', ''.Filter(KeepBase));
  AssertEquals(42, ''.Reduce(42, Count));
  AssertEquals(0, Calls);
end.
