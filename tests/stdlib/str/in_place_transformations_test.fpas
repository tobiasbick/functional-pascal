program StringInPlaceTransformations;

uses Std.Test as Test;

begin
  const Original := '  a😀b  ';
  var Text := Original;
  Text.TrimLeftInPlace();
  Test.AssertEquals('a😀b  ', Text);
  Text.TrimRightInPlace();
  Test.AssertEquals('a😀b', Text);
  Text.ToUpperInPlace();
  Test.AssertEquals('A😀B', Text);
  Text.ToLowerInPlace();
  Text.ReplaceInPlace(New := 'é', Old := '😀');
  Test.AssertEquals('aéb', Text);
  Text.SetCharAtInPlace(C := '😀', Index := 1);
  Text.InsertInPlace(Sub := '!', Index := 2);
  Test.AssertEquals('a😀!b', Text);
  Text.DeleteInPlace(Len := 1, Index := 2);
  Text.ReverseInPlace();
  Text.SliceInPlace(Len := 1, Start := 1);
  Test.AssertEquals('😀', Text);
  Text.RepeatStrInPlace(N := 2);
  Test.AssertEquals('😀😀', Text);
  Text := 'a';
  Text.PadLeftInPlace(PadChar := '-', Width := 3);
  Text.PadRightInPlace(PadChar := '+', Width := 5);
  Test.AssertEquals('--a++', Text);
  Text := 'a';
  Text.PadCenterInPlace(PadChar := '-', Width := 3);
  Test.AssertEquals('-a-', Text);
  Text := ' a ';
  Text.TrimInPlace();
  Text.MapInPlace(
    F := function(C: string): string begin
      return C.ToUpper();
    end function
  );
  Test.AssertEquals('A', Text);
  Text := 'A B';
  Text.FilterInPlace(
    F := function(C: string): boolean begin
      return C <> ' ';
    end function
  );
  Test.AssertEquals('AB', Text);
  Text := '%s:%d';
  Text.FormatInPlace('ok', 7);
  Test.AssertEquals('ok:7', Text);
  Test.AssertEquals('  a😀b  ', Original);
end.
