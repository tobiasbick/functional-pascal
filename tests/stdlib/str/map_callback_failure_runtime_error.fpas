program StringMapCallbackFailureRuntimeError;

uses Std.Str;

function FailOnSecond(C: string): string;
begin
  if C = 'b' then
  begin
    panic('string callback failed on second scalar')
  end;

  if C = 'c' then
  begin
    panic('string callback advanced after failure')
  end;

  return C
end;

begin
  var Mapped: string := Map('abc', FailOnSecond)
end.
