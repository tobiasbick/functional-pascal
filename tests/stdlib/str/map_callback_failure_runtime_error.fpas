program StringMapCallbackFailureRuntimeError;

uses Std.Str as Str;

pure function FailOnSecond(C: string): string;
begin
  if C = 'b' then
    begin
      panic('string callback failed on second scalar');
    end;
  end if;

  if C = 'c' then
    begin
      panic('string callback advanced after failure');
    end;
  end if;

  return C;
end function;

begin
  const Mapped: string := Str.Map('abc', FailOnSecond);
end program;
