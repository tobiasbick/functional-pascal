program StringMapMultipleResultInTaskRuntimeError;

uses Std.Str as Str;
uses Std.Tasks as Tasks;

pure function Expand(C: string): string;
begin
  return 'ab';
end function;

pure function Work(): string;
begin
  return Str.Map('x', Expand);
end function;

begin
  const Job: task := go Work();
  const Mapped: string := Tasks.Wait(Job);
end program;
