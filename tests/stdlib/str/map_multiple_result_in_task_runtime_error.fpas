program StringMapMultipleResultInTaskRuntimeError;

uses Std.Tasks;

function Expand(C: string): string;
begin
  return 'ab';
end function;

function Work(): string;
begin
  return 'x'.Map(Expand);
end function;

begin
  scope
    const Job: task of string := go Work();
    const Mapped: string := Wait(Job);
  end scope;
end.
