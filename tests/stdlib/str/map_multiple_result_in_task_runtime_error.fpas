program StringMapMultipleResultInTaskRuntimeError;

uses Std.Str, Std.Tasks;

function Expand(C: string): string;
begin
  return 'ab';
end function;

function Work(): string;
begin
  return Map('x', Expand);
end function;

begin
  const Job: task := go Work();
  const Mapped: string := Wait(Job);
end.
