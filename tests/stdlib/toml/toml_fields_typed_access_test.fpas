program TomlFieldsTypedAccessTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Toml as Toml;
uses Std.Toml.Fields as Fields2;
uses Std.Results as Results;
uses Std.Test as Test;

function ErrorText of (T)(Value: Result of (T, string)): string;
begin
  case Value of
    when Result.Ok(_):
      begin
        Test.Fail('expected an error result');
        return '';
      end;
    when Result.Error(const Message):
      begin
        return Message;
      end;
  end case;
end function;

begin
  var Text: string := ((((((((((((('name = ''demo''' + Str.Chr(10)) + 'port = 8080') + Str.Chr(10)) + 'ratio = 0.5') + Str.Chr(10)) + 'enabled = true') + Str.Chr(10)) + 'tags = [''a'', ''b'']') + Str.Chr(10)) + 'mixed = [''a'', 1]') + Str.Chr(10)) + '[server]') + Str.Chr(10)) +
                      'host = ''local''';
  var Fields: dict of (string, Toml.TomlValue) := Results.Unwrap(Fields2.ParseTable(Text));
  Test.AssertEquals('demo', Results.Unwrap(Fields2.StringField(Fields, 'name')));
  Test.AssertEquals(8080, Results.Unwrap(Fields2.IntegerField(Fields, 'port')));
  Test.AssertEquals(0.5, Results.Unwrap(Fields2.FloatField(Fields, 'ratio')));
  Test.AssertTrue(Results.Unwrap(Fields2.BooleanField(Fields, 'enabled')));
  Test.AssertEquals('local', Results.Unwrap(Fields2.StringField(Results.Unwrap(Fields2.TableField(Fields, 'server')), 'host')));
  Test.AssertEquals(2, Arrays.Length(Results.Unwrap(Fields2.ArrayField(Fields, 'mixed'))));
  Test.AssertEquals(2, Arrays.Length(Results.Unwrap(Fields2.StringArrayField(Fields, 'tags'))));
  Test.AssertEquals('missing field absent', ErrorText(Fields2.Field(Fields, 'absent')));
  Test.AssertEquals('field port must be a string', ErrorText(Fields2.StringField(Fields, 'port')));
  // Integer and float keys are not converted into each other.
  Test.AssertEquals('field ratio must be an integer', ErrorText(Fields2.IntegerField(Fields, 'ratio')));
  Test.AssertEquals('field port must be a float', ErrorText(Fields2.FloatField(Fields, 'port')));
  Test.AssertEquals('field name must be a table', ErrorText(Fields2.TableField(Fields, 'name')));
  Test.AssertEquals('field mixed must be an array of strings', ErrorText(Fields2.StringArrayField(Fields, 'mixed')));
  Test.AssertTrue(Results.Unwrap(Fields2.RequireOnlyFields(Results.Unwrap(Fields2.ParseTable('a = 1')), [
                                                                                                          'a',
                                                                                                          'b'
                                                                                                        ])));
  Test.AssertEquals('unexpected field c', ErrorText(Fields2.RequireOnlyFields(Results.Unwrap(Fields2.ParseTable(('a = 1' + Str.Chr(10)) +
                                                                                                                'c = 2')), [
                                                                                                                             'a',
                                                                                                                             'b'
                                                                                                                           ])));
  Test.AssertTrue(Results.IsError(Fields2.ParseTable('a = ')));
end program;
