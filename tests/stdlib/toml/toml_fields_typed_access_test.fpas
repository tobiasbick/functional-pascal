program TomlFieldsTypedAccessTest;

uses Std.Toml, Std.Toml.Fields, Std.Test;

function ErrorText<T>(Value: result of (T, string)): string;
begin
  case Value of
    when Ok(_):
      begin
        Fail('expected an error result');
        return '';
      end;
    when Error(const Message):
      begin
        return Message;
      end;
  end case;
end function;

begin
  const Text: string := 'name = ''demo''' + string.Chr(10) + 'port = 8080' + string.Chr(10) + 'ratio = 0.5' + string.Chr(10) + 'enabled = true' + string.Chr(10) + 'tags = [''a'', ''b'']' + string.Chr(10) + 'mixed = [''a'', 1]' + string.Chr(10) + '[server]' + string.Chr(10) +
                        'host = ''local''';
  const Fields: dict of string to TomlValue := ParseTable(Text).Unwrap();
  AssertEquals('demo', StringField(Fields, 'name').Unwrap());
  AssertEquals(8080, IntegerField(Fields, 'port').Unwrap());
  AssertEquals(0.5, FloatField(Fields, 'ratio').Unwrap());
  AssertTrue(BooleanField(Fields, 'enabled').Unwrap());
  AssertEquals('local', StringField(TableField(Fields, 'server').Unwrap(), 'host').Unwrap());
  AssertEquals(2, ArrayField(Fields, 'mixed').Unwrap().Length());
  AssertEquals(2, StringArrayField(Fields, 'tags').Unwrap().Length());
  AssertEquals('missing field absent', ErrorText(Field(Fields, 'absent')));
  AssertEquals('field port must be a string', ErrorText(StringField(Fields, 'port')));
  // Integer and float keys are not converted into each other.
  AssertEquals('field ratio must be an integer', ErrorText(IntegerField(Fields, 'ratio')));
  AssertEquals('field port must be a float', ErrorText(FloatField(Fields, 'port')));
  AssertEquals('field name must be a table', ErrorText(TableField(Fields, 'name')));
  AssertEquals('field mixed must be an array of strings', ErrorText(StringArrayField(Fields, 'mixed')));
  AssertTrue(RequireOnlyFields(ParseTable('a = 1').Unwrap(), ['a', 'b']).Unwrap());
  AssertEquals('unexpected field c', ErrorText(RequireOnlyFields(ParseTable('a = 1' + string.Chr(10) +
                                                                            'c = 2')
                                                                   .Unwrap(), ['a', 'b'])));
  AssertTrue(ParseTable('a = ').IsError());
end.
