program TomlFieldsTypedAccessTest;

uses Std.Arrays, Std.Str, Std.Toml, Std.Toml.Fields, Std.Results, Std.Test;

function ErrorText<T>(Value: result of T, string): string;
begin
  case Value of
    Ok(_):
    begin
      Fail('expected an error result');
      return ''
    end;
    Error(Message):
    begin
      return Message
    end
  end
end;

begin
  var Text: string := ((((((((((((('name = ''demo''' + Chr(10)) + 'port = 8080') + Chr(10)) + 'ratio = 0.5') + Chr(10)) + 'enabled = true') + Chr(10)) + 'tags = [''a'', ''b'']') + Chr(10)) + 'mixed = [''a'', 1]') + Chr(10)) + '[server]') + Chr(10)) +
                      'host = ''local''';
  var Fields: dict of string to TomlValue := Unwrap(ParseTable(Text));
  AssertEquals('demo', Unwrap(StringField(Fields, 'name')));
  AssertEquals(8080, Unwrap(IntegerField(Fields, 'port')));
  AssertEquals(0.5, Unwrap(FloatField(Fields, 'ratio')));
  AssertTrue(Unwrap(BooleanField(Fields, 'enabled')));
  AssertEquals('local', Unwrap(StringField(Unwrap(TableField(Fields, 'server')), 'host')));
  AssertEquals(2, Unwrap(ArrayField(Fields, 'mixed')).Length());
  AssertEquals(2, Unwrap(StringArrayField(Fields, 'tags')).Length());
  AssertEquals('missing field absent', ErrorText(Field(Fields, 'absent')));
  AssertEquals('field port must be a string', ErrorText(StringField(Fields, 'port')));
  // Integer and float keys are not converted into each other.
  AssertEquals('field ratio must be an integer', ErrorText(IntegerField(Fields, 'ratio')));
  AssertEquals('field port must be a float', ErrorText(FloatField(Fields, 'port')));
  AssertEquals('field name must be a table', ErrorText(TableField(Fields, 'name')));
  AssertEquals('field mixed must be an array of strings', ErrorText(StringArrayField(Fields, 'mixed')));
  AssertTrue(Unwrap(RequireOnlyFields(Unwrap(ParseTable('a = 1')), ['a', 'b'])));
  AssertEquals('unexpected field c', ErrorText(RequireOnlyFields(Unwrap(ParseTable(('a = 1' + Chr(10)) +
                                                                                   'c = 2')), [
                                                                                                'a',
                                                                                                'b'
                                                                                              ])));
  AssertTrue(IsError(ParseTable('a = ')))
end.
