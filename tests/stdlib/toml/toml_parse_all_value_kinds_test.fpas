program TomlParseAllValueKindsTest;

uses Std.Arrays as Arrays;
uses Std.Dictionaries as Dictionaries;
uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Toml as Toml;

begin
  var Parsed: Result of (Toml.TomlValue, string) := Toml.Parse(((((((((((((('title = ''TOML''' + Str.Chr(10)) + 'integer = -42') + Str.Chr(10)) + 'float = 1.5') + Str.Chr(10)) + 'enabled = true') + Str.Chr(10)) + 'when = 1979-05-27T07:32:00Z') + Str.Chr(10)) + 'items = [''a'', 2]') + Str.Chr(10)) + '[nested]') + Str.Chr(10)) +
                                                               'value = ''ok''');
  case Parsed of
    when Result.Ok(const Value):
      begin
        case Value of
          when Toml.TomlValue.Table(const Fields):
            begin
              case Options.Unwrap(Dictionaries.Get(Fields, 'title')) of
                when Toml.TomlValue.String(const Text):
                  begin
                    Test.AssertEquals('TOML', Text);
                  end;
                when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                  begin
                    begin
                      Test.Fail('Expected string title');
                    end;
                  end;
              end case;

              case Options.Unwrap(Dictionaries.Get(Fields, 'integer')) of
                when Toml.TomlValue.Integer(const Number):
                  begin
                    Test.AssertEquals(-42, Number);
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                  begin
                    begin
                      Test.Fail('Expected integer value');
                    end;
                  end;
              end case;

              case Options.Unwrap(Dictionaries.Get(Fields, 'float')) of
                when Toml.TomlValue.Float(const Number):
                  begin
                    Test.AssertEquals(1.5, Number);
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                  begin
                    begin
                      Test.Fail('Expected float value');
                    end;
                  end;
              end case;

              case Options.Unwrap(Dictionaries.Get(Fields, 'enabled')) of
                when Toml.TomlValue.Boolean(const Enabled):
                  begin
                    Test.AssertTrue(Enabled);
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                  begin
                    begin
                      Test.Fail('Expected boolean value');
                    end;
                  end;
              end case;

              case Options.Unwrap(Dictionaries.Get(Fields, 'when')) of
                when Toml.TomlValue.Datetime(const TimestampText):
                  begin
                    Test.AssertEquals('1979-05-27T07:32:00Z', TimestampText);
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                  begin
                    begin
                      Test.Fail('Expected datetime value');
                    end;
                  end;
              end case;

              case Options.Unwrap(Dictionaries.Get(Fields, 'items')) of
                when Toml.TomlValue.ArrayValue(const Items):
                  begin
                    Test.AssertEquals(2, Arrays.Length(Items));
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.Table(_):
                  begin
                    begin
                      Test.Fail('Expected array value');
                    end;
                  end;
              end case;

              case Options.Unwrap(Dictionaries.Get(Fields, 'nested')) of
                when Toml.TomlValue.Table(const Nested):
                  begin
                    case Options.Unwrap(Dictionaries.Get(Nested, 'value')) of
                      when Toml.TomlValue.String(const Text):
                        begin
                          Test.AssertEquals('ok', Text);
                        end;
                      when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                        begin
                          begin
                            Test.Fail('Expected nested string value');
                          end;
                        end;
                    end case;
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
                  begin
                    begin
                      Test.Fail('Expected nested table');
                    end;
                  end;
              end case;
            end;
          when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
            begin
              begin
                Test.Fail('Expected TOML table');
              end;
            end;
        end case;
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
