program TomlParseAllValueKindsTest;

uses Std.Arrays, Std.Dictionaries, Std.Options, Std.Str, Std.Test, Std.Toml;

begin
  var Parsed: result of TomlValue, string := Parse(((((((((((((('title = ''TOML''' + Chr(10)) + 'integer = -42') + Chr(10)) + 'float = 1.5') + Chr(10)) + 'enabled = true') + Chr(10)) + 'when = 1979-05-27T07:32:00Z') + Chr(10)) + 'items = [''a'', 2]') + Chr(10)) + '[nested]') + Chr(10)) +
                                                   'value = ''ok''');
  case Parsed of
    when Ok(Value):
      begin
        case Value of
          when TomlValue.Table(Fields):
            begin
              case Std.Options.Unwrap(Std.Dictionaries.Get(Fields, 'title')) of
                when TomlValue.String(Text):
                  begin
                    AssertEquals('TOML', Text);
                  end;
                else
                  begin
                    Fail('Expected string title');
                  end;
              end case;

              case Std.Options.Unwrap(Std.Dictionaries.Get(Fields, 'integer')) of
                when TomlValue.Integer(Number):
                  begin
                    AssertEquals(-42, Number);
                  end;
                else
                  begin
                    Fail('Expected integer value');
                  end;
              end case;

              case Std.Options.Unwrap(Std.Dictionaries.Get(Fields, 'float')) of
                when TomlValue.Float(Number):
                  begin
                    AssertEquals(1.5, Number);
                  end;
                else
                  begin
                    Fail('Expected float value');
                  end;
              end case;

              case Std.Options.Unwrap(Std.Dictionaries.Get(Fields, 'enabled')) of
                when TomlValue.Boolean(Enabled):
                  begin
                    AssertTrue(Enabled);
                  end;
                else
                  begin
                    Fail('Expected boolean value');
                  end;
              end case;

              case Std.Options.Unwrap(Std.Dictionaries.Get(Fields, 'when')) of
                when TomlValue.Datetime(Timestamp):
                  begin
                    AssertEquals('1979-05-27T07:32:00Z', Timestamp);
                  end;
                else
                  begin
                    Fail('Expected datetime value');
                  end;
              end case;

              case Std.Options.Unwrap(Std.Dictionaries.Get(Fields, 'items')) of
                when TomlValue.ArrayValue(Items):
                  begin
                    AssertEquals(2, Std.Arrays.Length(Items));
                  end;
                else
                  begin
                    Fail('Expected array value');
                  end;
              end case;

              case Std.Options.Unwrap(Std.Dictionaries.Get(Fields, 'nested')) of
                when TomlValue.Table(Nested):
                  begin
                    case Std.Options.Unwrap(Std.Dictionaries.Get(Nested, 'value')) of
                      when TomlValue.String(Text):
                        begin
                          AssertEquals('ok', Text);
                        end;
                      else
                        begin
                          Fail('Expected nested string value');
                        end;
                    end case;
                  end;
                else
                  begin
                    Fail('Expected nested table');
                  end;
              end case;
            end;
          else
            begin
              Fail('Expected TOML table');
            end;
        end case;
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end.
