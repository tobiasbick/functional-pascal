program TomlParseAllValueKindsTest;

uses Std.Test, Std.Toml;

begin
  const Parsed: result of TomlValue, string := Parse('title = ''TOML''' + string.Chr(10) + 'integer = -42' + string.Chr(10) + 'float = 1.5' + string.Chr(10) + 'enabled = true' + string.Chr(10) + 'when = 1979-05-27T07:32:00Z' + string.Chr(10) + 'items = [''a'', 2]' + string.Chr(10) + '[nested]' + string.Chr(10) +
                                                     'value = ''ok''');
  case Parsed of
    when Ok(const Value):
      begin
        if Value is TomlValue.Table(const Fields) then
          begin
            if Fields.Get('title').Unwrap() is TomlValue.String(const Text) then
              begin
                AssertEquals('TOML', Text);
              end;
            else
              begin
                Fail('Expected string title');
              end;
            end if;

            if Fields.Get('integer').Unwrap() is TomlValue.Integer(const Number) then
              begin
                AssertEquals(-42, Number);
              end;
            else
              begin
                Fail('Expected integer value');
              end;
            end if;

            if Fields.Get('float').Unwrap() is TomlValue.Float(const Number) then
              begin
                AssertEquals(1.5, Number);
              end;
            else
              begin
                Fail('Expected float value');
              end;
            end if;

            if Fields.Get('enabled').Unwrap() is TomlValue.Boolean(const Enabled) then
              begin
                AssertTrue(Enabled);
              end;
            else
              begin
                Fail('Expected boolean value');
              end;
            end if;

            if Fields.Get('when').Unwrap() is TomlValue.Datetime(const Timestamp) then
              begin
                AssertEquals('1979-05-27T07:32:00Z', Timestamp);
              end;
            else
              begin
                Fail('Expected datetime value');
              end;
            end if;

            if Fields.Get('items').Unwrap() is TomlValue.ArrayValue(const Items) then
              begin
                AssertEquals(2, Items.Length());
              end;
            else
              begin
                Fail('Expected array value');
              end;
            end if;

            if Fields.Get('nested').Unwrap() is TomlValue.Table(const Nested) then
              begin
                if Nested.Get('value').Unwrap() is TomlValue.String(const Text) then
                  begin
                    AssertEquals('ok', Text);
                  end;
                else
                  begin
                    Fail('Expected nested string value');
                  end;
                end if;
              end;
            else
              begin
                Fail('Expected nested table');
              end;
            end if;
          end;
        else
          begin
            Fail('Expected TOML table');
          end;
        end if;
      end;
    when Error(const Message):
      begin
        Fail(Message);
      end;
  end case;
end.
