program TomlParseAllValueKindsTest;

uses Std.Test, Std.Toml;

begin
  const Parsed: result of TomlValue, string := Parse(((((((((((((('title = ''TOML''' + string.Chr(10)) + 'integer = -42') + string.Chr(10)) + 'float = 1.5') + string.Chr(10)) + 'enabled = true') + string.Chr(10)) + 'when = 1979-05-27T07:32:00Z') + string.Chr(10)) + 'items = [''a'', 2]') + string.Chr(10)) + '[nested]') + string.Chr(10)) +
                                                     'value = ''ok''');
  case Parsed of
    when Ok(Value):
      begin
        case Value of
          when TomlValue.Table(Fields):
            begin
              case Fields.Get('title').Unwrap() of
                when TomlValue.String(Text):
                  begin
                    AssertEquals('TOML', Text);
                  end;
                else
                  begin
                    Fail('Expected string title');
                  end;
              end case;

              case Fields.Get('integer').Unwrap() of
                when TomlValue.Integer(Number):
                  begin
                    AssertEquals(-42, Number);
                  end;
                else
                  begin
                    Fail('Expected integer value');
                  end;
              end case;

              case Fields.Get('float').Unwrap() of
                when TomlValue.Float(Number):
                  begin
                    AssertEquals(1.5, Number);
                  end;
                else
                  begin
                    Fail('Expected float value');
                  end;
              end case;

              case Fields.Get('enabled').Unwrap() of
                when TomlValue.Boolean(Enabled):
                  begin
                    AssertTrue(Enabled);
                  end;
                else
                  begin
                    Fail('Expected boolean value');
                  end;
              end case;

              case Fields.Get('when').Unwrap() of
                when TomlValue.Datetime(Timestamp):
                  begin
                    AssertEquals('1979-05-27T07:32:00Z', Timestamp);
                  end;
                else
                  begin
                    Fail('Expected datetime value');
                  end;
              end case;

              case Fields.Get('items').Unwrap() of
                when TomlValue.ArrayValue(Items):
                  begin
                    AssertEquals(2, Items.Length());
                  end;
                else
                  begin
                    Fail('Expected array value');
                  end;
              end case;

              case Fields.Get('nested').Unwrap() of
                when TomlValue.Table(Nested):
                  begin
                    case Nested.Get('value').Unwrap() of
                      when TomlValue.String(Text):
                        begin
                          AssertEquals('ok', Text);
                        end;
                      else
                        begin
                          Fail('Expected nested string value');
                        end;
                    end case;
                  end;
                else
                  begin
                    Fail('Expected nested table');
                  end;
              end case;
            end;
          else
            begin
              Fail('Expected TOML table');
            end;
        end case;
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end.
