program TomlParseArraysOfTablesAndEdgeValuesTest;

uses Std.Test, Std.Toml;

begin
  const Parsed: result of TomlValue, string := Parse(((((((((((((('empty = []' + string.Chr(10)) + 'special = nan') + string.Chr(10)) + 'point.x = 1') + string.Chr(10)) + 'point.y = 2') + string.Chr(10)) + '[[products]]') + string.Chr(10)) + 'name = ''Hammer''') + string.Chr(10)) + '[[products]]') + string.Chr(10)) +
                                                     'name = ''Nail''');
  case Parsed of
    when Ok(Value):
      begin
        case Value of
          when TomlValue.Table(Fields):
            begin
              case Fields.Get('empty').Unwrap() of
                when TomlValue.ArrayValue(Items):
                  begin
                    AssertEquals(0, Items.Length());
                  end;
                else
                  begin
                    Fail('Expected empty array');
                  end;
              end case;

              case Fields.Get('special').Unwrap() of
                when TomlValue.Float(Number):
                  begin
                    AssertTrue(Number <> Number);
                  end;
                else
                  begin
                    Fail('Expected float nan');
                  end;
              end case;

              case Fields.Get('point').Unwrap() of
                when TomlValue.Table(Point):
                  begin
                    AssertEquals(2, Point.Length());
                  end;
                else
                  begin
                    Fail('Expected point table');
                  end;
              end case;

              case Fields.Get('products').Unwrap() of
                when TomlValue.ArrayValue(Products):
                  begin
                    AssertEquals(2, Products.Length());
                    case Products[0] of
                      when TomlValue.Table(Product):
                        begin
                          case Product.Get('name').Unwrap() of
                            when TomlValue.String(Name):
                              begin
                                AssertEquals('Hammer', Name);
                              end;
                            else
                              begin
                                Fail('Expected product name string');
                              end;
                          end case;
                        end;
                      else
                        begin
                          Fail('Expected first product table');
                        end;
                    end case;

                    case Products[1] of
                      when TomlValue.Table(Product):
                        begin
                          case Product.Get('name').Unwrap() of
                            when TomlValue.String(Name):
                              begin
                                AssertEquals('Nail', Name);
                              end;
                            else
                              begin
                                Fail('Expected product name string');
                              end;
                          end case;
                        end;
                      else
                        begin
                          Fail('Expected second product table');
                        end;
                    end case;
                  end;
                else
                  begin
                    Fail('Expected products array');
                  end;
              end case;
            end;
          else
            begin
              Fail('Expected TOML table');
            end;
        end case;
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end.
