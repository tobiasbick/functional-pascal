program TomlParseArraysOfTablesAndEdgeValuesTest;

uses Std.Test, Std.Toml;

begin
  const Parsed: result of (TomlValue, string) := Parse('empty = []' + string.Chr(10) + 'special = nan' + string.Chr(10) + 'point.x = 1' + string.Chr(10) + 'point.y = 2' + string.Chr(10) + '[[products]]' + string.Chr(10) + 'name = ''Hammer''' + string.Chr(10) + '[[products]]' + string.Chr(10) +
                                                       'name = ''Nail''');
  case Parsed of
    when Ok(const Value):
      begin
        if Value is TomlValue.Table(const Fields) then
          begin
            if Fields.Get('empty').Unwrap() is TomlValue.ArrayValue(const Items) then
              begin
                AssertEquals(0, Items.Length());
              end;
            else
              begin
                Fail('Expected empty array');
              end;
            end if;

            if Fields.Get('special').Unwrap() is TomlValue.Float(const Number) then
              begin
                AssertTrue(Number <> Number);
              end;
            else
              begin
                Fail('Expected float nan');
              end;
            end if;

            if Fields.Get('point').Unwrap() is TomlValue.Table(const Point) then
              begin
                AssertEquals(2, Point.Length());
              end;
            else
              begin
                Fail('Expected point table');
              end;
            end if;

            if Fields.Get('products').Unwrap() is TomlValue.ArrayValue(const Products) then
              begin
                AssertEquals(2, Products.Length());
                if Products[0] is TomlValue.Table(const Product) then
                  begin
                    if Product.Get('name').Unwrap() is TomlValue.String(const Name) then
                      begin
                        AssertEquals('Hammer', Name);
                      end;
                    else
                      begin
                        Fail('Expected product name string');
                      end;
                    end if;
                  end;
                else
                  begin
                    Fail('Expected first product table');
                  end;
                end if;

                if Products[1] is TomlValue.Table(const Product) then
                  begin
                    if Product.Get('name').Unwrap() is TomlValue.String(const Name) then
                      begin
                        AssertEquals('Nail', Name);
                      end;
                    else
                      begin
                        Fail('Expected product name string');
                      end;
                    end if;
                  end;
                else
                  begin
                    Fail('Expected second product table');
                  end;
                end if;
              end;
            else
              begin
                Fail('Expected products array');
              end;
            end if;
          end;
        else
          begin
            Fail('Expected TOML table');
          end;
        end if;
      end;
    when Error(const Message):
      begin
        Fail(Message);
      end;
  end case;
end.
