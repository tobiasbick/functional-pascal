program TomlParseArraysOfTablesAndEdgeValuesTest;

uses Std.Test as Test, Std.Toml as Toml;

begin
  const Parsed: result of (Toml.TomlValue, string) := Toml.Parse('empty = []' + string.Chr(10) + 'special = -0.0' + string.Chr(10) + 'point.x = 1' + string.Chr(10) + 'point.y = 2' + string.Chr(10) + '[[products]]' + string.Chr(10) + 'name = ''Hammer''' + string.Chr(10) + '[[products]]' + string.Chr(10) +
                                                                 'name = ''Nail''');
  case Parsed of
    when Ok(const Value):
      begin
        case Value of
          when Toml.TomlValue.Table(const Fields):
            begin
              case Fields.Get('empty').Unwrap() of
                when Toml.TomlValue.ArrayValue(const Items):
                  begin
                    Test.AssertEquals(0, Items.Length());
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.Table(_):
                  begin
                    Test.Fail('Expected empty array');
                  end;
              end case;

              case Fields.Get('special').Unwrap() of
                when Toml.TomlValue.Float(const Number):
                  begin
                    Test.AssertEquals(0.0, Number);
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                  begin
                    Test.Fail('Expected finite float');
                  end;
              end case;

              case Fields.Get('point').Unwrap() of
                when Toml.TomlValue.Table(const Point):
                  begin
                    Test.AssertEquals(2, Point.Length());
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
                  begin
                    Test.Fail('Expected point table');
                  end;
              end case;

              case Fields.Get('products').Unwrap() of
                when Toml.TomlValue.ArrayValue(const Products):
                  begin
                    Test.AssertEquals(2, Products.Length());
                    case Products[0] of
                      when Toml.TomlValue.Table(const Product):
                        begin
                          case Product.Get('name').Unwrap() of
                            when Toml.TomlValue.String(const Name):
                              begin
                                Test.AssertEquals('Hammer', Name);
                              end;
                            when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                              begin
                                Test.Fail('Expected product name string');
                              end;
                          end case;
                        end;
                      when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
                        begin
                          Test.Fail('Expected first product table');
                        end;
                    end case;

                    case Products[1] of
                      when Toml.TomlValue.Table(const Product):
                        begin
                          case Product.Get('name').Unwrap() of
                            when Toml.TomlValue.String(const Name):
                              begin
                                Test.AssertEquals('Nail', Name);
                              end;
                            when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                              begin
                                Test.Fail('Expected product name string');
                              end;
                          end case;
                        end;
                      when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
                        begin
                          Test.Fail('Expected second product table');
                        end;
                    end case;
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.Table(_):
                  begin
                    Test.Fail('Expected products array');
                  end;
              end case;
            end;
          when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
            begin
              Test.Fail('Expected TOML table');
            end;
        end case;
      end;
    when Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end.
