program TomlStringifyConstructedTableRoundtripTest;

uses Std.Arrays, Std.Dictionaries, Std.Options, Std.Test, Std.Toml;

begin
  const Source: TomlValue := TomlValue.Table(['project': TomlValue.Table(['name': TomlValue.String('demo'), 'version': TomlValue.Integer(1), 'released': TomlValue.Datetime('2026-07-14')]), 'enabled': TomlValue.Boolean(true), 'targets': TomlValue.ArrayValue([
                                                                                                                                                                                                                                                                   TomlValue.String('linux'),
                                                                                                                                                                                                                                                                   TomlValue.String('windows')
                                                                                                                                                                                                                                                                 ])]);
  const Encoded: string := Stringify(Source);
  const Parsed: result of TomlValue, string := Parse(Encoded);
  case Parsed of
    when Ok(Value):
      begin
        case Value of
          when TomlValue.Table(Fields):
            begin
              case Std.Options.Unwrap(Std.Dictionaries.Get(Fields, 'project')) of
                when TomlValue.Table(Project):
                  begin
                    case Std.Options.Unwrap(Std.Dictionaries.Get(Project, 'name')) of
                      when TomlValue.String(Name):
                        begin
                          AssertEquals('demo', Name);
                        end;
                      else
                        begin
                          Fail('Expected project name string');
                        end;
                    end case;

                    case Std.Options.Unwrap(Std.Dictionaries.Get(Project, 'released')) of
                      when TomlValue.Datetime(Date):
                        begin
                          AssertEquals('2026-07-14', Date);
                        end;
                      else
                        begin
                          Fail('Expected project released datetime');
                        end;
                    end case;
                  end;
                else
                  begin
                    Fail('Expected project table');
                  end;
              end case;

              case Std.Options.Unwrap(Std.Dictionaries.Get(Fields, 'targets')) of
                when TomlValue.ArrayValue(Targets):
                  begin
                    AssertEquals(2, Std.Arrays.Length(Targets));
                  end;
                else
                  begin
                    Fail('Expected targets array');
                  end;
              end case;
            end;
          else
            begin
              Fail('Expected TOML table');
            end;
        end case;
      end;
    when Error(Message):
      begin
        Fail(Message);
      end;
  end case;
end.
