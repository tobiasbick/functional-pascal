program TomlStringifyConstructedTableRoundtripTest;

uses Std.Arrays as Arrays;
uses Std.Dictionaries as Dictionaries;
uses Std.Options as Options;
uses Std.Test as Test;
uses Std.Toml as Toml;

begin
  var Source: Toml.TomlValue := Toml.TomlValue.Table(['project': Toml.TomlValue.Table(['name': Toml.TomlValue.String('demo'), 'version': Toml.TomlValue.Integer(1), 'released': Toml.TomlValue.Datetime('2026-07-14')]), 'enabled': Toml.TomlValue.Boolean(true), 'targets': Toml.TomlValue.ArrayValue([
                                                                                                                                                                                                                                                                                                         Toml.TomlValue.String('linux'),
                                                                                                                                                                                                                                                                                                         Toml.TomlValue.String('windows')
                                                                                                                                                                                                                                                                                                       ])]);
  var Encoded: string := Toml.Stringify(Source);
  var Parsed: Result of (Toml.TomlValue, string) := Toml.Parse(Encoded);
  case Parsed of
    when Result.Ok(const Value):
      begin
        case Value of
          when Toml.TomlValue.Table(const Fields):
            begin
              case Options.Unwrap(Dictionaries.Get(Fields, 'project')) of
                when Toml.TomlValue.Table(const Project):
                  begin
                    case Options.Unwrap(Dictionaries.Get(Project, 'name')) of
                      when Toml.TomlValue.String(const Name):
                        begin
                          Test.AssertEquals('demo', Name);
                        end;
                      when Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                        begin
                          begin
                            Test.Fail('Expected project name string');
                          end;
                        end;
                    end case;

                    case Options.Unwrap(Dictionaries.Get(Project, 'released')) of
                      when Toml.TomlValue.Datetime(const Date):
                        begin
                          Test.AssertEquals('2026-07-14', Date);
                        end;
                      when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.ArrayValue(_), Toml.TomlValue.Table(_):
                        begin
                          begin
                            Test.Fail('Expected project released datetime');
                          end;
                        end;
                    end case;
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
                  begin
                    begin
                      Test.Fail('Expected project table');
                    end;
                  end;
              end case;

              case Options.Unwrap(Dictionaries.Get(Fields, 'targets')) of
                when Toml.TomlValue.ArrayValue(const Targets):
                  begin
                    Test.AssertEquals(2, Arrays.Length(Targets));
                  end;
                when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.Table(_):
                  begin
                    begin
                      Test.Fail('Expected targets array');
                    end;
                  end;
              end case;
            end;
          when Toml.TomlValue.String(_), Toml.TomlValue.Integer(_), Toml.TomlValue.Float(_), Toml.TomlValue.Boolean(_), Toml.TomlValue.Datetime(_), Toml.TomlValue.ArrayValue(_):
            begin
              begin
                Test.Fail('Expected TOML table');
              end;
            end;
        end case;
      end;
    when Result.Error(const Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
