program TomlStringifyConstructedTableRoundtripTest;

uses Std.Arrays as Arrays;
uses Std.Dictionaries as Dictionaries;
uses Std.Options as Options;
uses Std.Test as Test;
uses Std.Toml as Toml;

begin
  var Source: Toml.TomlValue := Toml.TomlValue.Table(['project': Toml.TomlValue.Table(['name': Toml.TomlValue.String('demo'), 'version': Toml.TomlValue.Integer(1), 'released': Toml.TomlValue.Datetime('2026-07-14')]), 'enabled': Toml.TomlValue.Boolean(true), 'targets': Toml.TomlValue.ArrayValue([
                                                                                                                                                                                                                                                                                                         Toml.TomlValue.String('linux'),
                                                                                                                                                                                                                                                                                                         Toml.TomlValue.String('windows')
                                                                                                                                                                                                                                                                                                       ])]);
  var Encoded: string := Toml.Stringify(Source);
  var Parsed: result of Toml.TomlValue, string := Toml.Parse(Encoded);
  case Parsed of
    when Ok(Value):
      begin
        case Value of
          when Toml.TomlValue.Table(Fields):
            begin
              case Options.Unwrap(Dictionaries.Get(Fields, 'project')) of
                when Toml.TomlValue.Table(Project):
                  begin
                    case Options.Unwrap(Dictionaries.Get(Project, 'name')) of
                      when Toml.TomlValue.String(Name):
                        begin
                          Test.AssertEquals('demo', Name);
                        end;
                      else
                        begin
                          Test.Fail('Expected project name string');
                        end;
                    end case;

                    case Options.Unwrap(Dictionaries.Get(Project, 'released')) of
                      when Toml.TomlValue.Datetime(Date):
                        begin
                          Test.AssertEquals('2026-07-14', Date);
                        end;
                      else
                        begin
                          Test.Fail('Expected project released datetime');
                        end;
                    end case;
                  end;
                else
                  begin
                    Test.Fail('Expected project table');
                  end;
              end case;

              case Options.Unwrap(Dictionaries.Get(Fields, 'targets')) of
                when Toml.TomlValue.ArrayValue(Targets):
                  begin
                    Test.AssertEquals(2, Arrays.Length(Targets));
                  end;
                else
                  begin
                    Test.Fail('Expected targets array');
                  end;
              end case;
            end;
          else
            begin
              Test.Fail('Expected TOML table');
            end;
        end case;
      end;
    when Error(Message):
      begin
        Test.Fail(Message);
      end;
  end case;
end program;
