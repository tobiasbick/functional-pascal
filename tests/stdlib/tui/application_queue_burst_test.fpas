program ApplicationQueueBurstTest;

uses Std.Test as Test;
uses Std.Tui as Tui;

function View(Value: integer): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeEmpty();
end function;

function Update(Value: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  case Msg of
    when Tui.TuiMsg.Tick(Delta):
      begin
        Test.AssertEquals(Value + 1, Delta);
        return Delta;
      end;
    else
      begin
        return Value;
      end;
  end case;
end function;

begin
  var First: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(1, 1));
  var Second: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(1, 1));
  for I: integer := 1 to 300 do
    begin
      First.Inject(Tui.TuiMsg.Tick(I));
    end;
  end for;

  Second.Inject(Tui.TuiMsg.Tick(1));
  Test.AssertEquals(100, First.RunIterations(0, Update, View, 100, 0));
  for I: integer := 301 to 400 do
    begin
      First.Inject(Tui.TuiMsg.Tick(I));
    end;
  end for;

  Test.AssertEquals(1, Second.RunIterations(0, Update, View, 1, 0));
  Test.AssertEquals(400, First.RunIterations(100, Update, View, 300, 0));
  Test.AssertEquals(400, First.RunIterations(400, Update, View, 0, 0));
  First.Inject(Tui.TuiMsg.Tick(401));
  Test.AssertEquals(401, First.RunIterations(400, Update, View, 1, 0));
  First.Close();
  Second.Inject(Tui.TuiMsg.Tick(2));
  Test.AssertEquals(2, Second.RunIterations(1, Update, View, 1, 0));
  Second.Close();
end program;
