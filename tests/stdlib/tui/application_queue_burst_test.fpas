program ApplicationQueueBurstTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Runtime as Runtime;

function View(Value: integer): Tui.TuiElement;
begin
  return Elements.TuiElementMakeEmpty();
end function;

function Update(Value: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  case Msg of
    when Tui.TuiMsg.Tick(const Delta):
      begin
        Test.AssertEquals(Value + 1, Delta);
        return Delta;
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return Value;
        end;
      end;
  end case;
end function;

begin
  const First: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(1, 1));
  const Second: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(1, 1));
  for I: integer := 1 to 300 do
    begin
      Runtime.TuiApplicationInject(First, Tui.TuiMsg.Tick(I));
    end;
  end for;

  Runtime.TuiApplicationInject(Second, Tui.TuiMsg.Tick(1));
  Test.AssertEquals(100, Runtime.TuiApplicationRunIterations(First, 0, Update, View, 100, 0));
  for I: integer := 301 to 400 do
    begin
      Runtime.TuiApplicationInject(First, Tui.TuiMsg.Tick(I));
    end;
  end for;

  Test.AssertEquals(1, Runtime.TuiApplicationRunIterations(Second, 0, Update, View, 1, 0));
  Test.AssertEquals(400, Runtime.TuiApplicationRunIterations(First, 100, Update, View, 300, 0));
  Test.AssertEquals(400, Runtime.TuiApplicationRunIterations(First, 400, Update, View, 0, 0));
  Runtime.TuiApplicationInject(First, Tui.TuiMsg.Tick(401));
  Test.AssertEquals(401, Runtime.TuiApplicationRunIterations(First, 400, Update, View, 1, 0));
  Runtime.TuiApplicationClose(First);
  Runtime.TuiApplicationInject(Second, Tui.TuiMsg.Tick(2));
  Test.AssertEquals(2, Runtime.TuiApplicationRunIterations(Second, 1, Update, View, 1, 0));
  Runtime.TuiApplicationClose(Second);
end program;
