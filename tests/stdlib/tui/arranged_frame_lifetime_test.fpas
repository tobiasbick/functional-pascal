program TuiArrangedFrameLifetimeTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

begin
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 8));
  var Model: integer := 0;
  var Focus: integer := 1;
  Model := Runtime.TuiApplicationRunIterations(App, Model, function(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer begin
    case Msg of
      when Tui.TuiMsg.FocusChanged(const Previous, const Current):
        begin
          case Current of
            when Option.Some(const Id):
              begin
                Focus := Id.Value;
                return State;
              end;
            when Option.None:
              begin
                return State;
              end;
          end case;
        end;
      when Tui.TuiMsg.Action(const Source, const Action):
        begin
          return State + Action.Value;
        end;
      when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
        begin
          begin
            return State;
          end;
        end;
    end case;
  end function, function(State: integer): Tui.TuiElement begin
    return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(Focus)), [
                                                                                        Elements.TuiElementMakePanel('Host', [
                                                                                                                               Elements.TuiElementMakeRow([
                                                                                                                                                            Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(1), 'One', Ids.TuiActionCreate(1)),
                                                                                                                                                            Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(2), 'Two', Ids.TuiActionCreate(2))
                                                                                                                                                          ])
                                                                                                                             ])
                                                                                      ]);
  end function, 0, 0);
  Test.AssertEquals(0, Model);
  Test.AssertEquals(1, Focus);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Tab, ''));
  Model := Runtime.TuiApplicationRunIterations(App, Model, function(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer begin
    case Msg of
      when Tui.TuiMsg.FocusChanged(const Previous, const Current):
        begin
          case Current of
            when Option.Some(const Id):
              begin
                Focus := Id.Value;
                return State;
              end;
            when Option.None:
              begin
                return State;
              end;
          end case;
        end;
      when Tui.TuiMsg.Action(const Source, const Action):
        begin
          return State + Action.Value;
        end;
      when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
        begin
          begin
            return State;
          end;
        end;
    end case;
  end function, function(State: integer): Tui.TuiElement begin
    return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(Focus)), [
                                                                                        Elements.TuiElementMakePanel('Host', [
                                                                                                                               Elements.TuiElementMakeRow([
                                                                                                                                                            Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(1), 'One', Ids.TuiActionCreate(1)),
                                                                                                                                                            Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(2), 'Two', Ids.TuiActionCreate(2))
                                                                                                                                                          ])
                                                                                                                             ])
                                                                                      ]);
  end function, 1, 0);
  Test.AssertEquals(2, Focus);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Enter, ''));
  Model := Runtime.TuiApplicationRunIterations(App, Model, function(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer begin
    case Msg of
      when Tui.TuiMsg.FocusChanged(const Previous, const Current):
        begin
          case Current of
            when Option.Some(const Id):
              begin
                Focus := Id.Value;
                return State;
              end;
            when Option.None:
              begin
                return State;
              end;
          end case;
        end;
      when Tui.TuiMsg.Action(const Source, const Action):
        begin
          return State + Action.Value;
        end;
      when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
        begin
          begin
            return State;
          end;
        end;
    end case;
  end function, function(State: integer): Tui.TuiElement begin
    return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(Focus)), [
                                                                                        Elements.TuiElementMakePanel('Host', [
                                                                                                                               Elements.TuiElementMakeRow([
                                                                                                                                                            Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(1), 'One', Ids.TuiActionCreate(1)),
                                                                                                                                                            Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(2), 'Two', Ids.TuiActionCreate(2))
                                                                                                                                                          ])
                                                                                                                             ])
                                                                                      ]);
  end function, 1, 0);
  Test.AssertEquals(2, Model);
  Runtime.TuiApplicationClose(App);
end program;
