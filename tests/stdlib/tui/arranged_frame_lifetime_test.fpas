program TuiArrangedFrameLifetimeTest;

uses Std.Test as Test;
uses Std.Tui as Tui;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end record;
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 8));
  mutable var Model: integer := 0;
  mutable var Focus: integer := 1;
  Model := App.RunIterations(Model, function(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer begin
    case Msg of
      when Tui.TuiMsg.FocusChanged(Previous, Current):
        begin
          case Current of
            when Some(Id):
              begin
                Focus := Id.Value;
                return State;
              end;
            when None:
              begin
                return State;
              end;
          end case;
        end;
      when Tui.TuiMsg.Action(Source, Action):
        begin
          return State + Action.Value;
        end;
      else
        begin
          return State;
        end;
    end case;
  end function, function(State: integer): Tui.TuiElement begin
    return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(Focus)), [
                                                                                      Tui.TuiElementBuilders.MakePanel('Host', [
                                                                                                                                 Tui.TuiElementBuilders.MakeRow([
                                                                                                                                                                  Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(1), 'One', Tui.TuiAction.Create(1)),
                                                                                                                                                                  Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(2), 'Two', Tui.TuiAction.Create(2))
                                                                                                                                                                ])
                                                                                                                               ])
                                                                                    ]);
  end function, 0, 0);
  Test.AssertEquals(0, Model);
  Test.AssertEquals(1, Focus);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Tab, ''));
  Model := App.RunIterations(Model, function(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer begin
    case Msg of
      when Tui.TuiMsg.FocusChanged(Previous, Current):
        begin
          case Current of
            when Some(Id):
              begin
                Focus := Id.Value;
                return State;
              end;
            when None:
              begin
                return State;
              end;
          end case;
        end;
      when Tui.TuiMsg.Action(Source, Action):
        begin
          return State + Action.Value;
        end;
      else
        begin
          return State;
        end;
    end case;
  end function, function(State: integer): Tui.TuiElement begin
    return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(Focus)), [
                                                                                      Tui.TuiElementBuilders.MakePanel('Host', [
                                                                                                                                 Tui.TuiElementBuilders.MakeRow([
                                                                                                                                                                  Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(1), 'One', Tui.TuiAction.Create(1)),
                                                                                                                                                                  Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(2), 'Two', Tui.TuiAction.Create(2))
                                                                                                                                                                ])
                                                                                                                               ])
                                                                                    ]);
  end function, 1, 0);
  Test.AssertEquals(2, Focus);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, ''));
  Model := App.RunIterations(Model, function(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer begin
    case Msg of
      when Tui.TuiMsg.FocusChanged(Previous, Current):
        begin
          case Current of
            when Some(Id):
              begin
                Focus := Id.Value;
                return State;
              end;
            when None:
              begin
                return State;
              end;
          end case;
        end;
      when Tui.TuiMsg.Action(Source, Action):
        begin
          return State + Action.Value;
        end;
      else
        begin
          return State;
        end;
    end case;
  end function, function(State: integer): Tui.TuiElement begin
    return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(Focus)), [
                                                                                      Tui.TuiElementBuilders.MakePanel('Host', [
                                                                                                                                 Tui.TuiElementBuilders.MakeRow([
                                                                                                                                                                  Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(1), 'One', Tui.TuiAction.Create(1)),
                                                                                                                                                                  Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(2), 'Two', Tui.TuiAction.Create(2))
                                                                                                                                                                ])
                                                                                                                               ])
                                                                                    ]);
  end function, 1, 0);
  Test.AssertEquals(2, Model);
  App.Close();
end program;
