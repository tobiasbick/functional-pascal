program TuiArrangedFrameLifetimeTest;

uses Std.Test, Std.Tui;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

begin
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 8));
  var Model: integer := 0;
  var Focus: integer := 1;
  Model := App.RunIterations(Model, function(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer begin
    case Msg of
      when TuiMsg.FocusChanged(const Previous, const Current):
        begin
          case Current of
            when Some(const Id):
              begin
                Focus := Id.Value;
                return State;
              end;
            when None:
              begin
                return State;
              end;
          end case;
        end;
      when TuiMsg.Action(const Source, const Action):
        begin
          return State + Action.Value;
        end;
      when TuiMsg.Started, TuiMsg.Key(_), TuiMsg.Pointer(_), TuiMsg.Tick(_), TuiMsg.Resize(_), TuiMsg.TextChanged(_, _, _, _), TuiMsg.TextAreaChanged(_, _, _, _, _), TuiMsg.CheckChanged(_, _, _), TuiMsg.SelectionChanged(_, _, _), TuiMsg.ScrollChanged(_, _, _), TuiMsg.MenuChanged(_, _, _), TuiMsg.BackgroundFailed(_, _, _, _, _, _), TuiMsg.QuitRequested:
        begin
          return State;
        end;
    end case;
  end function, function(State: integer): TuiElement begin
    return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(Focus)), [
                                                                              TuiElementBuilders.MakePanel('Host', [
                                                                                                                     TuiElementBuilders.MakeRow([
                                                                                                                                                  TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'One', TuiAction.Create(1)),
                                                                                                                                                  TuiElementBuilders.MakeButton(TuiControlId.Create(2), 'Two', TuiAction.Create(2))
                                                                                                                                                ])
                                                                                                                   ])
                                                                            ]);
  end function, 0, 0);
  AssertEquals(0, Model);
  AssertEquals(1, Focus);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Tab, ''));
  Model := App.RunIterations(Model, function(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer begin
    case Msg of
      when TuiMsg.FocusChanged(const Previous, const Current):
        begin
          case Current of
            when Some(const Id):
              begin
                Focus := Id.Value;
                return State;
              end;
            when None:
              begin
                return State;
              end;
          end case;
        end;
      when TuiMsg.Action(const Source, const Action):
        begin
          return State + Action.Value;
        end;
      when TuiMsg.Started, TuiMsg.Key(_), TuiMsg.Pointer(_), TuiMsg.Tick(_), TuiMsg.Resize(_), TuiMsg.TextChanged(_, _, _, _), TuiMsg.TextAreaChanged(_, _, _, _, _), TuiMsg.CheckChanged(_, _, _), TuiMsg.SelectionChanged(_, _, _), TuiMsg.ScrollChanged(_, _, _), TuiMsg.MenuChanged(_, _, _), TuiMsg.BackgroundFailed(_, _, _, _, _, _), TuiMsg.QuitRequested:
        begin
          return State;
        end;
    end case;
  end function, function(State: integer): TuiElement begin
    return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(Focus)), [
                                                                              TuiElementBuilders.MakePanel('Host', [
                                                                                                                     TuiElementBuilders.MakeRow([
                                                                                                                                                  TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'One', TuiAction.Create(1)),
                                                                                                                                                  TuiElementBuilders.MakeButton(TuiControlId.Create(2), 'Two', TuiAction.Create(2))
                                                                                                                                                ])
                                                                                                                   ])
                                                                            ]);
  end function, 1, 0);
  AssertEquals(2, Focus);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, ''));
  Model := App.RunIterations(Model, function(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer begin
    case Msg of
      when TuiMsg.FocusChanged(const Previous, const Current):
        begin
          case Current of
            when Some(const Id):
              begin
                Focus := Id.Value;
                return State;
              end;
            when None:
              begin
                return State;
              end;
          end case;
        end;
      when TuiMsg.Action(const Source, const Action):
        begin
          return State + Action.Value;
        end;
      when TuiMsg.Started, TuiMsg.Key(_), TuiMsg.Pointer(_), TuiMsg.Tick(_), TuiMsg.Resize(_), TuiMsg.TextChanged(_, _, _, _), TuiMsg.TextAreaChanged(_, _, _, _, _), TuiMsg.CheckChanged(_, _, _), TuiMsg.SelectionChanged(_, _, _), TuiMsg.ScrollChanged(_, _, _), TuiMsg.MenuChanged(_, _, _), TuiMsg.BackgroundFailed(_, _, _, _, _, _), TuiMsg.QuitRequested:
        begin
          return State;
        end;
    end case;
  end function, function(State: integer): TuiElement begin
    return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(Focus)), [
                                                                              TuiElementBuilders.MakePanel('Host', [
                                                                                                                     TuiElementBuilders.MakeRow([
                                                                                                                                                  TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'One', TuiAction.Create(1)),
                                                                                                                                                  TuiElementBuilders.MakeButton(TuiControlId.Create(2), 'Two', TuiAction.Create(2))
                                                                                                                                                ])
                                                                                                                   ])
                                                                            ]);
  end function, 1, 0);
  AssertEquals(2, Model);
  App.Close();
end.
