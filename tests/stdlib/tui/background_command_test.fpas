program TuiBackgroundCommandTest;

uses Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

type CommandModel = record
  Inbox: channel of integer;
  Ready: channel of boolean;
  Value: integer;
end record;

function UpdateFramework(State: CommandModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): CommandModel;
begin
  if Msg is Tui.TuiMsg.Started then
    begin
      const Target: channel of integer := State.Inbox;
      const Ready: channel of boolean := State.Ready;
      Cmd.StartBackground(
        7, function(Token: Tasks.CancellationToken): result of (boolean, string) begin
          if (Tasks.SendWithCancellation(Target, 42, Token) is Error(_)) then
            begin
              return Ok(true);
            end;
          end if;

          discard Tasks.Send(Ready, true);
          return Ok(true);
        end function
      );
      return State;
    end;
  else
    begin
      return State;
    end;
  end if;
end function;

function UpdateApplication(State: CommandModel; Message: integer; Cmd: Tui.TuiCmdOutput): CommandModel;
begin
  return CommandModel(Inbox := State.Inbox, Ready := State.Ready, Value := Message);
end function;

function View(State: CommandModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel('command');
end function;

begin
  const Inbox: channel of integer := Tasks.CreateChannel(1);
  const Ready: channel of boolean := Tasks.CreateChannel(1);
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 4));
  var Model: CommandModel := App.RunBackgroundIterations(
    CommandModel(Inbox := Inbox, Ready := Ready, Value := 0),
    Inbox,
    UpdateFramework,
    UpdateApplication,
    View,
    1,
    0
  );
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Ready, 10000).Unwrap());
  Model := App.RunBackgroundIterations(
    Model,
    Inbox,
    UpdateFramework,
    UpdateApplication,
    View,
    1,
    0
  );
  Test.AssertEquals(42, Model.Value);
  App.CloseWithBackground(Inbox);
  discard Tasks.CloseChannel(Ready);
end.
