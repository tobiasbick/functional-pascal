program TuiBackgroundCommandTest;

uses Std.Tasks, Std.Test, Std.Tui;

type CommandModel = record
  Inbox: channel of integer;
  Ready: channel of boolean;
  Value: integer;
end record;

function UpdateFramework(State: CommandModel; Msg: TuiMsg; Cmd: TuiCmdOutput): CommandModel;
begin
  if Msg is TuiMsg.Started then
    begin
      const Target: channel of integer := State.Inbox;
      const Ready: channel of boolean := State.Ready;
      Cmd.StartBackground(7, function(Token: CancellationToken): result of boolean, string begin
        if SendWithCancellation(Target, 42, Token).IsError() then
          begin
            return Ok(true);
          end;
        end if;

        discard Send(Ready, true);
        return Ok(true);
      end function);
      return State;
    end;
  else
    begin
      return State;
    end;
  end if;
end function;

function UpdateApplication(State: CommandModel; Message: integer; Cmd: TuiCmdOutput): CommandModel;
begin
  return CommandModel(Inbox := State.Inbox, Ready := State.Ready, Value := Message);
end function;

function View(State: CommandModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel('command');
end function;

begin
  const Inbox: channel of integer := CreateChannel(1);
  const Ready: channel of boolean := CreateChannel(1);
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  var Model: CommandModel := App.RunBackgroundIterations(CommandModel(Inbox := Inbox, Ready := Ready, Value := 0), Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  AssertTrue(ReceiveWithTimeout(Ready, 10000).Unwrap());
  Model := App.RunBackgroundIterations(Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  AssertEquals(42, Model.Value);
  App.CloseWithBackground(Inbox);
  discard CloseChannel(Ready);
end.
