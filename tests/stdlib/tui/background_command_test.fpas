program TuiBackgroundCommandTest;

uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Runtime as Runtime;

type CommandModel = record
  Inbox: channel of (integer);
  Ready: channel of (boolean);
  Value: integer;
end record;

function UpdateFramework(State: CommandModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): CommandModel;
begin
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        const Target: channel of (integer) := State.Inbox;
        const Ready: channel of (boolean) := State.Ready;
        Runtime.TuiCmdOutputStartBackground(Cmd, 7, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
          if Results.IsError(Tasks.SendWithCancellation(Target, 42, Token)) then
            begin
              return Result.Ok(true);
            end;
          end if;

          discard Tasks.Send(Ready, true);
          return Result.Ok(true);
        end function);
        return State;
      end;
    when Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function UpdateApplication(State: CommandModel; Message: integer; Cmd: Tui.TuiCmdOutput): CommandModel;
begin
  return CommandModel(Inbox := State.Inbox, Ready := State.Ready, Value := Message);
end function;

function View(State: CommandModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeLabel('command');
end function;

begin
  const Inbox: channel of (integer) := Tasks.CreateChannel(1);
  const Ready: channel of (boolean) := Tasks.CreateChannel(1);
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 4));
  var Model: CommandModel := Runtime.TuiApplicationRunBackgroundIterations(App, CommandModel(Inbox := Inbox, Ready := Ready, Value := 0), Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  Test.AssertTrue(Results.Unwrap(Tasks.ReceiveWithTimeout(Ready, 10000)));
  Model := Runtime.TuiApplicationRunBackgroundIterations(App, Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  Test.AssertEquals(42, Model.Value);
  Runtime.TuiApplicationCloseWithBackground(App, Inbox);
  discard Tasks.CloseChannel(Ready);
end program;
