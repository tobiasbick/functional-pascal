program TuiBackgroundFailureTest;

uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Tui as Tui;

type FailureModel = record
  Ready: channel of boolean;
  FailureSeen: boolean;
end record;

function UpdateFramework(State: FailureModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): FailureModel;
begin
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        var Ready: channel of boolean := State.Ready;
        Cmd.StartBackground(19, function(Token: Tasks.CancellationToken): result of boolean, string begin
          discard Tasks.Send(Ready, true);
          return Error('expected background failure');
        end function);
        return State;
      end;
    when Tui.TuiMsg.BackgroundFailed(Id, Kind, Message, Code, Line, Column):
      begin
        Test.AssertEquals(19, Id);
        Test.AssertTrue(Kind = Tasks.TaskFailureKind.ReturnedError);
        Test.AssertEquals('expected background failure', Message);
        return record
          Ready := State.Ready;
          FailureSeen := true;
        end record;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function UpdateApplication(State: FailureModel; Message: integer; Cmd: Tui.TuiCmdOutput): FailureModel;
begin
  return State;
end function;

function View(State: FailureModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel('failure');
end function;

begin
  var Inbox: channel of integer := Tasks.CreateChannel(1);
  var Ready: channel of boolean := Tasks.CreateChannel(1);
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 4));
  mutable var Model: FailureModel := App.RunBackgroundIterations(record
    Ready := Ready;
    FailureSeen := false;
  end record, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  Test.AssertTrue(Results.Unwrap(Tasks.ReceiveWithTimeout(Ready, 10000)));
  Model := App.RunBackgroundIterations(Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  Test.AssertTrue(Model.FailureSeen);
  App.CloseWithBackground(Inbox);
  discard Tasks.CloseChannel(Ready);
end program;
