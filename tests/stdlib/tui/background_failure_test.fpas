program TuiBackgroundFailureTest;

uses Std.Tasks, Std.Test, Std.Tui;

type FailureModel = record
  Ready: channel of boolean;
  FailureSeen: boolean;
end record;

function UpdateFramework(State: FailureModel; Msg: TuiMsg; Cmd: TuiCmdOutput): FailureModel;
begin
  case Msg of
    when TuiMsg.Started:
      begin
        const Ready: channel of boolean := State.Ready;
        Cmd.StartBackground(19, function(Token: CancellationToken): result of boolean, string begin
          discard Send(Ready, true);
          return Error('expected background failure');
        end function);
        return State;
      end;
    when TuiMsg.BackgroundFailed(Id, Kind, Message, Code, Line, Column):
      begin
        AssertEquals(19, Id);
        AssertTrue(Kind = TaskFailureKind.ReturnedError);
        AssertEquals('expected background failure', Message);
        return FailureModel(Ready := State.Ready, FailureSeen := true);
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function UpdateApplication(State: FailureModel; Message: integer; Cmd: TuiCmdOutput): FailureModel;
begin
  return State;
end function;

function View(State: FailureModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel('failure');
end function;

begin
  const Inbox: channel of integer := CreateChannel(1);
  const Ready: channel of boolean := CreateChannel(1);
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  var Model: FailureModel := App.RunBackgroundIterations(FailureModel(Ready := Ready, FailureSeen := false), Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  AssertTrue(ReceiveWithTimeout(Ready, 10000).Unwrap());
  Model := App.RunBackgroundIterations(Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  AssertTrue(Model.FailureSeen);
  App.CloseWithBackground(Inbox);
  discard CloseChannel(Ready);
end.
