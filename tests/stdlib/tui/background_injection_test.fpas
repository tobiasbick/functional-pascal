program TuiBackgroundInjectionTest;

uses Std.Tasks, Std.Test, Std.Tui;

type InjectionModel = record
  Values: array of integer;
  Starts: integer;
end record;

function UpdateFramework(State: InjectionModel; Msg: TuiMsg; Cmd: TuiCmdOutput): InjectionModel;
begin
  case Msg of
    when TuiMsg.Started:
      begin
        return InjectionModel(Values := State.Values, Starts := State.Starts + 1);
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function UpdateApplication(State: InjectionModel; Message: integer; Cmd: TuiCmdOutput): InjectionModel;
begin
  return InjectionModel(Values := State.Values.Concat([Message]), Starts := State.Starts);
end function;

function View(State: InjectionModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel('background');
end function;

begin
  const Inbox: channel of integer := CreateChannel(2);
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  AssertTrue(App.InjectBackgroundForTest(Inbox, 4).Unwrap());
  AssertTrue(App.InjectBackgroundForTest(Inbox, 7).Unwrap());
  AssertFalse(App.InjectBackgroundForTest(Inbox, 9).Unwrap());
  const Model: InjectionModel := App.RunBackgroundIterations(InjectionModel(Values := [], Starts := 0), Inbox, UpdateFramework, UpdateApplication, View, 3, 0);
  AssertEquals(1, Model.Starts);
  AssertEquals(2, Model.Values.Length());
  AssertEquals(4, Model.Values[0]);
  AssertEquals(7, Model.Values[1]);
  App.CloseWithBackground(Inbox);
  AssertTrue(TrySend(Inbox, 11).IsError());
end.
