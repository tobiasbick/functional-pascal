program TuiBackgroundInteractiveTest;

uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Runtime as Runtime;

type InteractiveModel = record
  Inbox: channel of (integer);
  Received: integer;
end record;

function Update(State: InteractiveModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): InteractiveModel;
begin
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        const Inbox: channel of (integer) := State.Inbox;
        Runtime.TuiCmdOutputStartBackground(Cmd, 1, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
          return Tasks.SendWithCancellation(Inbox, 42, Token);
        end function);
      end;
    when Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          null;
        end;
      end;
  end case;

  return State;
end function;

function UpdateMessage(State: InteractiveModel; Message: integer; Cmd: Tui.TuiCmdOutput): InteractiveModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
  var Next: InteractiveModel := State;
  Next.Received := Message;
  return Next;
end function;

function View(State: InteractiveModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeLabel('background wakeup');
end function;

begin
  const Inbox: channel of (integer) := Tasks.CreateChannel(1);
  const Final: InteractiveModel := Runtime.TuiApplicationRunWithBackground(InteractiveModel(Inbox := Inbox, Received := 0), Inbox, Update, UpdateMessage, View);
  Test.AssertEquals(42, Final.Received);
  Test.AssertTrue(Results.IsError(Tasks.TrySend(Inbox, 1)));
end program;
