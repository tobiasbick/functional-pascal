program TuiBackgroundInteractiveTest;

uses Std.Tasks, Std.Test, Std.Tui;

type InteractiveModel = record
  Inbox: channel of integer;
  Received: integer;
end record;

function Update(State: InteractiveModel; Msg: TuiMsg; Cmd: TuiCmdOutput): InteractiveModel;
begin
  if Msg is TuiMsg.Started then
    begin
      const Inbox: channel of integer := State.Inbox;
      Cmd.StartBackground(1, function(Token: CancellationToken): result of boolean, string begin
        return SendWithCancellation(Inbox, 42, Token);
      end function);
    end;
  end if;

  return State;
end function;

function UpdateMessage(State: InteractiveModel; Message: integer; Cmd: TuiCmdOutput): InteractiveModel;
begin
  Cmd.Set(TuiCmd.Quit);
  var Next: InteractiveModel := State;
  Next.Received := Message;
  return Next;
end function;

function View(State: InteractiveModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel('background wakeup');
end function;

begin
  const Inbox: channel of integer := CreateChannel(1);
  const Final: InteractiveModel := TuiApplication.RunWithBackground(InteractiveModel(Inbox := Inbox, Received := 0), Inbox, Update, UpdateMessage, View);
  AssertEquals(42, Final.Received);
  AssertTrue(TrySend(Inbox, 1).IsError());
end.
