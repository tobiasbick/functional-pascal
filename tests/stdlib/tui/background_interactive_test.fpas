program TuiBackgroundInteractiveTest;

uses Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

type InteractiveModel = record
  Inbox: channel of integer;
  Received: integer;
end record;

function Update(State: InteractiveModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): InteractiveModel;
begin
  if Msg is Tui.TuiMsg.Started then
    begin
      const Inbox: channel of integer := State.Inbox;
      Cmd.StartBackground(1, function(Token: Tasks.CancellationToken): result of (boolean, string) begin
        return Tasks.SendWithCancellation(Inbox, 42, Token);
      end function);
    end;
  end if;

  return State;
end function;

function UpdateMessage(State: InteractiveModel; Message: integer; Cmd: Tui.TuiCmdOutput): InteractiveModel;
begin
  Cmd.Set(Tui.TuiCmd.Quit);
  var Next: InteractiveModel := State;
  Next.Received := Message;
  return Next;
end function;

function View(State: InteractiveModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel('background wakeup');
end function;

begin
  const Inbox: channel of integer := Tasks.CreateChannel(1);
  const Final: InteractiveModel := Tui.TuiApplication.RunWithBackground(InteractiveModel(Inbox := Inbox, Received := 0), Inbox, Update, UpdateMessage, View);
  Test.AssertEquals(42, Final.Received);
  Test.AssertTrue(Tasks.TrySend(Inbox, 1).IsError());
end.
