program TuiBackgroundPanicTest;

uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Time as Time;
uses Std.Tui as Tui;

type PanicModel = record
  Ready: channel of (boolean);
  FailureSeen: boolean;
end record;

function UpdateFramework(State: PanicModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): PanicModel;
begin
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        var Ready: channel of (boolean) := State.Ready;
        Cmd.StartBackground(23, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
          discard Tasks.Send(Ready, true);
          panic('expected Tui worker panic');
        end function);
        return State;
      end;
    when Tui.TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      begin
        Test.AssertEquals(23, Id);
        Test.AssertTrue(Kind = Tasks.TaskFailureKind.Panicked);
        Test.AssertEquals('panic: expected Tui worker panic', Message);
        return PanicModel(Ready := State.Ready, FailureSeen := true);
      end;
    when Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function UpdateApplication(State: PanicModel; Message: integer; Cmd: Tui.TuiCmdOutput): PanicModel;
begin
  return State;
end function;

function View(State: PanicModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel('panic');
end function;

begin
  var Inbox: channel of (integer) := Tasks.CreateChannel(1);
  var Ready: channel of (boolean) := Tasks.CreateChannel(1);
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 4));
  mutable var Model: PanicModel := App.RunBackgroundIterations(PanicModel(Ready := Ready, FailureSeen := false), Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  Test.AssertTrue(Results.Unwrap(Tasks.ReceiveWithTimeout(Ready, 10000)));
  while not Model.FailureSeen do
    begin
      Time.Sleep(1);
      Model := App.RunBackgroundIterations(Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
    end;
  end while;

  App.CloseWithBackground(Inbox);
  discard Tasks.CloseChannel(Ready);
end program;
