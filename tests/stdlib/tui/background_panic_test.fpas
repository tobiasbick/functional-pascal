program TuiBackgroundPanicTest;

uses Std.Tasks, Std.Test, Std.Time, Std.Tui;

type PanicModel = record
  Ready: channel of boolean;
  FailureSeen: boolean;
end record;

function UpdateFramework(State: PanicModel; Msg: TuiMsg; Cmd: TuiCmdOutput): PanicModel;
begin
  case Msg of
    when TuiMsg.Started:
      begin
        const Ready: channel of boolean := State.Ready;
        Cmd.StartBackground(23, function(Token: CancellationToken): result of boolean, string begin
          discard Send(Ready, true);
          panic('expected Tui worker panic');
        end function);
        return State;
      end;
    when TuiMsg.BackgroundFailed(Id, Kind, Message, Code, Line, Column):
      begin
        AssertEquals(23, Id);
        AssertTrue(Kind = TaskFailureKind.Panicked);
        AssertEquals('panic: expected Tui worker panic', Message);
        return PanicModel(Ready := State.Ready, FailureSeen := true);
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function UpdateApplication(State: PanicModel; Message: integer; Cmd: TuiCmdOutput): PanicModel;
begin
  return State;
end function;

function View(State: PanicModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel('panic');
end function;

begin
  const Inbox: channel of integer := CreateChannel(1);
  const Ready: channel of boolean := CreateChannel(1);
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  var Model: PanicModel := App.RunBackgroundIterations(PanicModel(Ready := Ready, FailureSeen := false), Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  AssertTrue(ReceiveWithTimeout(Ready, 10000).Unwrap());
  while not Model.FailureSeen do
    begin
      Sleep(1);
      Model := App.RunBackgroundIterations(Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
    end;
  end while;

  App.CloseWithBackground(Inbox);
  discard CloseChannel(Ready);
end.
