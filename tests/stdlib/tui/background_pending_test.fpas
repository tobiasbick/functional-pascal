program TuiBackgroundPendingTest;

uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Time as Time;
uses Std.Tui as Tui;

type PendingModel = record
  Gate: channel of (boolean);
  Ready: channel of (boolean);
  Started: channel of (boolean);
  FailOld: boolean;
  Failures: integer;
end record;

function Update(State: PendingModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): PendingModel;
begin
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        var Gate: channel of (boolean) := State.Gate;
        var Ready: channel of (boolean) := State.Ready;
        var FailOld: boolean := State.FailOld;
        Cmd.ReplaceSubscription(1, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
          discard Tasks.Send(Ready, true);
          if FailOld then
            begin
              discard Tasks.Receive(Gate);
              return Result.Error('old source failed');
            end;
          end if;

          discard Tasks.ReceiveWithCancellation(Gate, Token);
          return Result.Ok(true);
        end function);
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        if Delta = 1 then
          begin
            var Started: channel of (boolean) := State.Started;
            Cmd.ReplaceSubscription(1, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
              discard Tasks.Send(Started, true);
              return Result.Ok(true);
            end function);
          end;
        else
          if Delta = 2 then
            begin
              Cmd.CancelSubscription(1);
            end;
          end if;
        end if;
      end;
    when Tui.TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      begin
        Test.AssertEquals(1, Id);
        Test.AssertTrue(Kind = Tasks.TaskFailureKind.ReturnedError);
        Test.AssertEquals('old source failed', Message);
        mutable var Next: PendingModel := State;
        Next.Failures := State.Failures + 1;
        return Next;
      end;
    when Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          null;
        end;
      end;
  end case;

  return State;
end function;

function UpdateMessage(State: PendingModel; Message: integer; Cmd: Tui.TuiCmdOutput): PendingModel;
begin
  return State;
end function;

function View(State: PendingModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel('pending cancellation');
end function;

begin
  var Inbox: channel of (integer) := Tasks.CreateChannel(1);
  var Gate: channel of (boolean) := Tasks.CreateChannel(1);
  var Ready: channel of (boolean) := Tasks.CreateChannel(1);
  var Started: channel of (boolean) := Tasks.CreateChannel(1);
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 4));
  mutable var State: PendingModel := App.RunBackgroundIterations(PendingModel(Gate := Gate, Ready := Ready, Started := Started, FailOld := true, Failures := 0), Inbox, Update, UpdateMessage, View, 1, 0);
  Test.AssertTrue(Results.Unwrap(Tasks.ReceiveWithTimeout(Ready, 5000)));
  App.Inject(Tui.TuiMsg.Tick(1));
  App.Inject(Tui.TuiMsg.Tick(2));
  State := App.RunBackgroundIterations(State, Inbox, Update, UpdateMessage, View, 2, 0);
  discard Tasks.Send(Gate, true);
  var Deadline: integer := Time.MonotonicMillis() + 5000;
  while (State.Failures = 0) and (Time.MonotonicMillis() < Deadline) do
    begin
      State := App.RunBackgroundIterations(State, Inbox, Update, UpdateMessage, View, 1, 0);
      Time.Sleep(1);
    end;
  end while;

  Test.AssertEquals(1, State.Failures);
  Test.AssertTrue(Results.IsError(Tasks.ReceiveWithTimeout(Started, 0)));
  App.CloseWithBackground(Inbox);
  var SecondInbox: channel of (integer) := Tasks.CreateChannel(1);
  var SecondApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 4));
  State.FailOld := false;
  State := SecondApp.RunBackgroundIterations(State, SecondInbox, Update, UpdateMessage, View, 1, 0);
  Test.AssertTrue(Results.Unwrap(Tasks.ReceiveWithTimeout(Ready, 5000)));
  SecondApp.Inject(Tui.TuiMsg.Tick(1));
  State := SecondApp.RunBackgroundIterations(State, SecondInbox, Update, UpdateMessage, View, 1, 0);
  SecondApp.CloseWithBackground(SecondInbox);
  Test.AssertTrue(Results.IsError(Tasks.ReceiveWithTimeout(Started, 0)));
  discard Tasks.CloseChannel(Gate);
  discard Tasks.CloseChannel(Ready);
  discard Tasks.CloseChannel(Started);
end program;
