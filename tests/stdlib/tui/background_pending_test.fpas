program TuiBackgroundPendingTest;

uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Runtime as Runtime;

type PendingModel = record
  Gate: channel of (boolean);
  Ready: channel of (boolean);
  Started: channel of (boolean);
  FailOld: boolean;
  Failures: integer;
end record;

function Update(State: PendingModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): PendingModel;
begin
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        const Gate: channel of (boolean) := State.Gate;
        const Ready: channel of (boolean) := State.Ready;
        const FailOld: boolean := State.FailOld;
        Runtime.TuiCmdOutputReplaceSubscription(Cmd, 1, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
          discard Tasks.Send(Ready, true);
          if FailOld then
            begin
              discard Tasks.Receive(Gate);
              return Result.Error('old source failed');
            end;
          end if;

          discard Tasks.ReceiveWithCancellation(Gate, Token);
          return Result.Ok(true);
        end function);
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        if Delta = 1 then
          begin
            const Started: channel of (boolean) := State.Started;
            Runtime.TuiCmdOutputReplaceSubscription(Cmd, 1, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
              discard Tasks.Send(Started, true);
              return Result.Ok(true);
            end function);
          end;
        else
          if Delta = 2 then
            begin
              Runtime.TuiCmdOutputCancelSubscription(Cmd, 1);
            end;
          end if;
        end if;
      end;
    when Tui.TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      begin
        Test.AssertEquals(1, Id);
        Test.AssertTrue(Kind = Tasks.TaskFailureKind.ReturnedError);
        Test.AssertEquals('old source failed', Message);
        var Next: PendingModel := State;
        Next.Failures := State.Failures + 1;
        return Next;
      end;
    when Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          null;
        end;
      end;
  end case;

  return State;
end function;

function UpdateMessage(State: PendingModel; Message: integer; Cmd: Tui.TuiCmdOutput): PendingModel;
begin
  return State;
end function;

function View(State: PendingModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeLabel('pending cancellation');
end function;

begin
  const Inbox: channel of (integer) := Tasks.CreateChannel(1);
  const Gate: channel of (boolean) := Tasks.CreateChannel(1);
  const Ready: channel of (boolean) := Tasks.CreateChannel(1);
  const Started: channel of (boolean) := Tasks.CreateChannel(1);
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 4));
  var State: PendingModel := Runtime.TuiApplicationRunBackgroundIterations(App, PendingModel(Gate := Gate, Ready := Ready, Started := Started, FailOld := true, Failures := 0), Inbox, Update, UpdateMessage, View, 1, 0);
  Test.AssertTrue(Results.Unwrap(Tasks.ReceiveWithTimeout(Ready, 5000)));
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.Tick(1));
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.Tick(2));
  State := Runtime.TuiApplicationRunBackgroundIterations(App, State, Inbox, Update, UpdateMessage, View, 2, 0);
  discard Tasks.Send(Gate, true);
  const Deadline: integer := Time.MonotonicMillis() + 5000;
  while (State.Failures = 0) and (Time.MonotonicMillis() < Deadline) do
    begin
      State := Runtime.TuiApplicationRunBackgroundIterations(App, State, Inbox, Update, UpdateMessage, View, 1, 0);
      Time.Sleep(1);
    end;
  end while;

  Test.AssertEquals(1, State.Failures);
  Test.AssertTrue(Results.IsError(Tasks.ReceiveWithTimeout(Started, 0)));
  Runtime.TuiApplicationCloseWithBackground(App, Inbox);
  const SecondInbox: channel of (integer) := Tasks.CreateChannel(1);
  const SecondApp: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 4));
  State.FailOld := false;
  State := Runtime.TuiApplicationRunBackgroundIterations(SecondApp, State, SecondInbox, Update, UpdateMessage, View, 1, 0);
  Test.AssertTrue(Results.Unwrap(Tasks.ReceiveWithTimeout(Ready, 5000)));
  Runtime.TuiApplicationInject(SecondApp, Tui.TuiMsg.Tick(1));
  State := Runtime.TuiApplicationRunBackgroundIterations(SecondApp, State, SecondInbox, Update, UpdateMessage, View, 1, 0);
  Runtime.TuiApplicationCloseWithBackground(SecondApp, SecondInbox);
  Test.AssertTrue(Results.IsError(Tasks.ReceiveWithTimeout(Started, 0)));
  discard Tasks.CloseChannel(Gate);
  discard Tasks.CloseChannel(Ready);
  discard Tasks.CloseChannel(Started);
end program;
