program TuiBackgroundPendingTest;

uses Std.Tasks, Std.Test, Std.Time, Std.Tui;

type PendingModel = record
  Gate: channel of boolean;
  Ready: channel of boolean;
  Started: channel of boolean;
  FailOld: boolean;
  Failures: integer;
end record;

function Update(State: PendingModel; Msg: TuiMsg; Cmd: TuiCmdOutput): PendingModel;
begin
  case Msg of
    when TuiMsg.Started:
      begin
        const Gate: channel of boolean := State.Gate;
        const Ready: channel of boolean := State.Ready;
        const FailOld: boolean := State.FailOld;
        Cmd.ReplaceSubscription(1, function(Token: CancellationToken): result of boolean, string begin
          discard Send(Ready, true);
          if FailOld then
            begin
              discard Receive(Gate);
              return Error('old source failed');
            end;
          end if;

          discard ReceiveWithCancellation(Gate, Token);
          return Ok(true);
        end function);
      end;
    when TuiMsg.Tick(const Delta):
      begin
        if Delta = 1 then
          begin
            const Started: channel of boolean := State.Started;
            Cmd.ReplaceSubscription(1, function(Token: CancellationToken): result of boolean, string begin
              discard Send(Started, true);
              return Ok(true);
            end function);
          end;
        elsif Delta = 2 then
          begin
            Cmd.CancelSubscription(1);
          end;
        end if;
      end;
    when TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      begin
        AssertEquals(1, Id);
        AssertTrue(Kind = TaskFailureKind.ReturnedError);
        AssertEquals('old source failed', Message);
        var Next: PendingModel := State;
        Next.Failures := State.Failures + 1;
        return Next;
      end;
    when TuiMsg.Key(_), TuiMsg.Pointer(_), TuiMsg.Resize(_), TuiMsg.FocusChanged(_, _), TuiMsg.Action(_, _), TuiMsg.TextChanged(_, _, _, _), TuiMsg.TextAreaChanged(_, _, _, _, _), TuiMsg.CheckChanged(_, _, _), TuiMsg.SelectionChanged(_, _, _), TuiMsg.ScrollChanged(_, _, _), TuiMsg.MenuChanged(_, _, _), TuiMsg.QuitRequested:
      null;
  end case;

  return State;
end function;

function UpdateMessage(State: PendingModel; Message: integer; Cmd: TuiCmdOutput): PendingModel;
begin
  return State;
end function;

function View(State: PendingModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel('pending cancellation');
end function;

begin
  const Inbox: channel of integer := CreateChannel(1);
  const Gate: channel of boolean := CreateChannel(1);
  const Ready: channel of boolean := CreateChannel(1);
  const Started: channel of boolean := CreateChannel(1);
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  var State: PendingModel := App.RunBackgroundIterations(PendingModel(Gate := Gate, Ready := Ready, Started := Started, FailOld := true, Failures := 0), Inbox, Update, UpdateMessage, View, 1, 0);
  AssertTrue(ReceiveWithTimeout(Ready, 5000).Unwrap());
  App.Inject(TuiMsg.Tick(1));
  App.Inject(TuiMsg.Tick(2));
  State := App.RunBackgroundIterations(State, Inbox, Update, UpdateMessage, View, 2, 0);
  discard Send(Gate, true);
  const Deadline: integer := MonotonicMillis() + 5000;
  while (State.Failures = 0) and (MonotonicMillis() < Deadline) do
    begin
      State := App.RunBackgroundIterations(State, Inbox, Update, UpdateMessage, View, 1, 0);
      Sleep(1);
    end;
  end while;

  AssertEquals(1, State.Failures);
  AssertTrue(ReceiveWithTimeout(Started, 0).IsError());
  App.CloseWithBackground(Inbox);
  const SecondInbox: channel of integer := CreateChannel(1);
  const SecondApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  State.FailOld := false;
  State := SecondApp.RunBackgroundIterations(State, SecondInbox, Update, UpdateMessage, View, 1, 0);
  AssertTrue(ReceiveWithTimeout(Ready, 5000).Unwrap());
  SecondApp.Inject(TuiMsg.Tick(1));
  State := SecondApp.RunBackgroundIterations(State, SecondInbox, Update, UpdateMessage, View, 1, 0);
  SecondApp.CloseWithBackground(SecondInbox);
  AssertTrue(ReceiveWithTimeout(Started, 0).IsError());
  discard CloseChannel(Gate);
  discard CloseChannel(Ready);
  discard CloseChannel(Started);
end.
