program TuiBackgroundResponsivenessTest;

uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Time as Time;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Runtime as Runtime;

type Model = record
  Generation: integer;
  Gate: channel of (boolean);
  Started: channel of (integer);
  Painted: channel of (integer);
end record;

procedure Replace(State: Model; Cmd: Tui.TuiCmdOutput);
begin
  const Generation: integer := State.Generation;
  const Gate: channel of (boolean) := State.Gate;
  const Started: channel of (integer) := State.Started;
  Runtime.TuiCmdOutputReplaceSubscription(Cmd, 1, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
    discard Tasks.Send(Started, Generation);
    if Generation = 0 then
      begin
        // Deliberately defer cooperation to prove that the host remains responsive.
        discard Tasks.Receive(Gate);
      end;
    end if;

    return Result.Ok(true);
  end function);
end procedure;

function Update(State: Model; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Model;
begin
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        Replace(State, Cmd);
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        if Delta > 0 then
          begin
            var Next: Model := State;
            Next.Generation := State.Generation + 1;
            Replace(Next, Cmd);
            return Next;
          end;
        end if;
      end;
    when Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          null;
        end;
      end;
  end case;

  return State;
end function;

function UpdateMessage(State: Model; Message: integer; Cmd: Tui.TuiCmdOutput): Model;
begin
  return State;
end function;

function View(State: Model): Tui.TuiElement;
begin
  if State.Generation = 3 then
    begin
      discard Tasks.TrySend(State.Painted, 3);
    end;
  end if;

  return Elements.TuiElementMakeLabel('responsive');
end function;

function ReleaseAfterPaint(Painted: channel of (integer); Gate: channel of (boolean)): boolean;
begin
  // A timeout releases the gate even on the old blocking implementation.
  const Paint: Result of (integer, string) := Tasks.ReceiveWithTimeout(Painted, 3000);
  discard Tasks.Send(Gate, true);
  return Results.IsOk(Paint);
end function;

begin
  const Inbox: channel of (integer) := Tasks.CreateChannel(1);
  const Gate: channel of (boolean) := Tasks.CreateChannel(1);
  const Started: channel of (integer) := Tasks.CreateChannel(4);
  const Painted: channel of (integer) := Tasks.CreateChannel(1);
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(20, 4));
  var State: Model := Runtime.TuiApplicationRunBackgroundIterations(App, Model(Generation := 0, Gate := Gate, Started := Started, Painted := Painted), Inbox, Update, UpdateMessage, View, 1, 0);
  Test.AssertEquals(0, Results.Unwrap(Tasks.ReceiveWithTimeout(Started, 5000)));
  const Observer: task := go ReleaseAfterPaint(Painted, Gate);
  for Index: integer := 1 to 3 do
    begin
      Runtime.TuiApplicationInject(App, Tui.TuiMsg.Tick(1));
      State := Runtime.TuiApplicationRunBackgroundIterations(App, State, Inbox, Update, UpdateMessage, View, 1, 0);
      Test.AssertEquals(Index, State.Generation);
    end;
  end for;

  Test.AssertTrue(Tasks.Wait(Observer));
  var Replacement: Result of (integer, string) := Tasks.ReceiveWithTimeout(Started, 0);
  const Deadline: integer := Time.MonotonicMillis() + 5000;
  while Results.IsError(Replacement) and (Time.MonotonicMillis() < Deadline) do
    begin
      State := Runtime.TuiApplicationRunBackgroundIterations(App, State, Inbox, Update, UpdateMessage, View, 1, 0);
      Replacement := Tasks.ReceiveWithTimeout(Started, 1);
    end;
  end while;

  Test.AssertEquals(3, Results.Unwrap(Replacement));
  Test.AssertTrue(Results.IsError(Tasks.ReceiveWithTimeout(Started, 0)));
  Runtime.TuiApplicationCloseWithBackground(App, Inbox);
  discard Tasks.CloseChannel(Gate);
  discard Tasks.CloseChannel(Started);
  discard Tasks.CloseChannel(Painted);
end program;
