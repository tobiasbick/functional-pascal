program TuiBackgroundResponsivenessTest;

uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Time as Time;
uses Std.Tui as Tui;

type Model = record
  Generation: integer;
  Gate: channel of boolean;
  Started: channel of integer;
  Painted: channel of integer;
end record;

procedure Replace(State: Model; Cmd: Tui.TuiCmdOutput);
begin
  var Generation: integer := State.Generation;
  var Gate: channel of boolean := State.Gate;
  var Started: channel of integer := State.Started;
  Cmd.ReplaceSubscription(1, function(Token: Tasks.CancellationToken): result of boolean, string begin
    Tasks.Send(Started, Generation);
    if Generation = 0 then
      begin
        // Deliberately defer cooperation to prove that the host remains responsive.
        Tasks.Receive(Gate);
      end;
    end if;

    return Ok(true);
  end function);
end procedure;

function Update(State: Model; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Model;
begin
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        Replace(State, Cmd);
      end;
    when Tui.TuiMsg.Tick(Delta):
      begin
        if Delta > 0 then
          begin
            mutable var Next: Model := State;
            Next.Generation := State.Generation + 1;
            Replace(Next, Cmd);
            return Next;
          end;
        end if;
      end;
    else
      begin
        null;
      end;
  end case;

  return State;
end function;

function UpdateMessage(State: Model; Message: integer; Cmd: Tui.TuiCmdOutput): Model;
begin
  return State;
end function;

function View(State: Model): Tui.TuiElement;
begin
  if State.Generation = 3 then
    begin
      Tasks.TrySend(State.Painted, 3);
    end;
  end if;

  return Tui.TuiElementBuilders.MakeLabel('responsive');
end function;

function ReleaseAfterPaint(Painted: channel of integer; Gate: channel of boolean): boolean;
begin
  // A timeout releases the gate even on the old blocking implementation.
  var Paint: result of integer, string := Tasks.ReceiveWithTimeout(Painted, 3000);
  Tasks.Send(Gate, true);
  return Results.IsOk(Paint);
end function;

begin
  var Inbox: channel of integer := Tasks.CreateChannel(1);
  var Gate: channel of boolean := Tasks.CreateChannel(1);
  var Started: channel of integer := Tasks.CreateChannel(4);
  var Painted: channel of integer := Tasks.CreateChannel(1);
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 4));
  mutable var State: Model := App.RunBackgroundIterations(record
    Generation := 0;
    Gate := Gate;
    Started := Started;
    Painted := Painted;
  end record, Inbox, Update, UpdateMessage, View, 1, 0);
  Test.AssertEquals(0, Results.Unwrap(Tasks.ReceiveWithTimeout(Started, 5000)));
  var Observer: task := go ReleaseAfterPaint(Painted, Gate);
  for Index: integer := 1 to 3 do
    begin
      App.Inject(Tui.TuiMsg.Tick(1));
      State := App.RunBackgroundIterations(State, Inbox, Update, UpdateMessage, View, 1, 0);
      Test.AssertEquals(Index, State.Generation);
    end;
  end for;

  Test.AssertTrue(Tasks.Wait(Observer));
  mutable var Replacement: result of integer, string := Tasks.ReceiveWithTimeout(Started, 0);
  var Deadline: integer := Time.MonotonicMillis() + 5000;
  while Results.IsError(Replacement) and (Time.MonotonicMillis() < Deadline) do
    begin
      State := App.RunBackgroundIterations(State, Inbox, Update, UpdateMessage, View, 1, 0);
      Replacement := Tasks.ReceiveWithTimeout(Started, 1);
    end;
  end while;

  Test.AssertEquals(3, Results.Unwrap(Replacement));
  Test.AssertTrue(Results.IsError(Tasks.ReceiveWithTimeout(Started, 0)));
  App.CloseWithBackground(Inbox);
  Tasks.CloseChannel(Gate);
  Tasks.CloseChannel(Started);
  Tasks.CloseChannel(Painted);
end program;
