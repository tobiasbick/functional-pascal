program TuiBackgroundSubscriptionTest;

uses Std.Results as Results;
uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Runtime as Runtime;

type SubscriptionModel = record
  Gate: channel of (boolean);
  Started: channel of (integer);
  Stopped: channel of (integer);
  Generation: integer;
end record;

procedure ReplaceWorker(State: SubscriptionModel; Cmd: Tui.TuiCmdOutput);
begin
  const Gate: channel of (boolean) := State.Gate;
  const Started: channel of (integer) := State.Started;
  const Stopped: channel of (integer) := State.Stopped;
  const Generation: integer := State.Generation;
  Runtime.TuiCmdOutputReplaceSubscription(Cmd, 1, function(Token: Tasks.CancellationToken): Result of (boolean, string) begin
    discard Tasks.Send(Started, Generation);
    if Results.IsError(Tasks.ReceiveWithCancellation(Gate, Token)) then
      begin
        discard Tasks.Send(Stopped, Generation);
      end;
    end if;

    return Result.Ok(true);
  end function);
end procedure;

function UpdateFramework(State: SubscriptionModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): SubscriptionModel;
begin
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        ReplaceWorker(State, Cmd);
        return State;
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        if Delta = 0 then
          begin
            return State;
          end;
        end if;
        const Next: SubscriptionModel := SubscriptionModel(Gate := State.Gate, Started := State.Started, Stopped := State.Stopped, Generation := State.Generation +
                                                                                                                                                 1);
        ReplaceWorker(Next, Cmd);
        return Next;
      end;
    when Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function UpdateApplication(State: SubscriptionModel; Message: integer; Cmd: Tui.TuiCmdOutput): SubscriptionModel;
begin
  return State;
end function;

function View(State: SubscriptionModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeLabel('subscription');
end function;

begin
  const Inbox: channel of (integer) := Tasks.CreateChannel(1);
  const Gate: channel of (boolean) := Tasks.CreateChannel(1);
  const Started: channel of (integer) := Tasks.CreateChannel(2);
  const Stopped: channel of (integer) := Tasks.CreateChannel(2);
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 4));
  var Model: SubscriptionModel := Runtime.TuiApplicationRunBackgroundIterations(App, SubscriptionModel(Gate := Gate, Started := Started, Stopped := Stopped, Generation := 0), Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  Test.AssertEquals(0, Results.Unwrap(Tasks.ReceiveWithTimeout(Started, 10000)));
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.Tick(1));
  Model := Runtime.TuiApplicationRunBackgroundIterations(App, Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  Test.AssertEquals(1, Model.Generation);
  Test.AssertEquals(0, Results.Unwrap(Tasks.ReceiveWithTimeout(Stopped, 10000)));
  Model := Runtime.TuiApplicationRunBackgroundIterations(App, Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  Test.AssertEquals(1, Results.Unwrap(Tasks.ReceiveWithTimeout(Started, 10000)));
  Runtime.TuiApplicationCloseWithBackground(App, Inbox);
  Test.AssertEquals(1, Results.Unwrap(Tasks.ReceiveWithTimeout(Stopped, 10000)));
  Test.AssertTrue(Results.IsError(Tasks.TrySend(Inbox, 1)));
  discard Tasks.CloseChannel(Gate);
  discard Tasks.CloseChannel(Started);
  discard Tasks.CloseChannel(Stopped);
end program;
