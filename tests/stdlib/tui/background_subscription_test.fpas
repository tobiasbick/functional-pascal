program TuiBackgroundSubscriptionTest;

uses Std.Tasks, Std.Test, Std.Tui;

type SubscriptionModel = record
  Gate: channel of boolean;
  Started: channel of integer;
  Stopped: channel of integer;
  Generation: integer;
end record;

procedure ReplaceWorker(State: SubscriptionModel; Cmd: TuiCmdOutput);
begin
  const Gate: channel of boolean := State.Gate;
  const Started: channel of integer := State.Started;
  const Stopped: channel of integer := State.Stopped;
  const Generation: integer := State.Generation;
  Cmd.ReplaceSubscription(1, function(Token: CancellationToken): result of boolean, string begin
    discard Send(Started, Generation);
    if ReceiveWithCancellation(Gate, Token).IsError() then
      begin
        discard Send(Stopped, Generation);
      end;
    end if;

    return Ok(true);
  end function);
end procedure;

function UpdateFramework(State: SubscriptionModel; Msg: TuiMsg; Cmd: TuiCmdOutput): SubscriptionModel;
begin
  case Msg of
    when TuiMsg.Started:
      begin
        ReplaceWorker(State, Cmd);
        return State;
      end;
    when TuiMsg.Tick(const Delta):
      begin
        if Delta = 0 then
          begin
            return State;
          end;
        end if;
        const Next: SubscriptionModel := SubscriptionModel(Gate := State.Gate, Started := State.Started, Stopped := State.Stopped, Generation := State.Generation +
                                                                                                                                                 1);
        ReplaceWorker(Next, Cmd);
        return Next;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function UpdateApplication(State: SubscriptionModel; Message: integer; Cmd: TuiCmdOutput): SubscriptionModel;
begin
  return State;
end function;

function View(State: SubscriptionModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel('subscription');
end function;

begin
  const Inbox: channel of integer := CreateChannel(1);
  const Gate: channel of boolean := CreateChannel(1);
  const Started: channel of integer := CreateChannel(2);
  const Stopped: channel of integer := CreateChannel(2);
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  var Model: SubscriptionModel := App.RunBackgroundIterations(SubscriptionModel(Gate := Gate, Started := Started, Stopped := Stopped, Generation := 0), Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  AssertEquals(0, ReceiveWithTimeout(Started, 10000).Unwrap());
  App.Inject(TuiMsg.Tick(1));
  Model := App.RunBackgroundIterations(Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  AssertEquals(1, Model.Generation);
  AssertEquals(0, ReceiveWithTimeout(Stopped, 10000).Unwrap());
  Model := App.RunBackgroundIterations(Model, Inbox, UpdateFramework, UpdateApplication, View, 1, 0);
  AssertEquals(1, ReceiveWithTimeout(Started, 10000).Unwrap());
  App.CloseWithBackground(Inbox);
  AssertEquals(1, ReceiveWithTimeout(Stopped, 10000).Unwrap());
  AssertTrue(TrySend(Inbox, 1).IsError());
  discard CloseChannel(Gate);
  discard CloseChannel(Started);
  discard CloseChannel(Stopped);
end.
