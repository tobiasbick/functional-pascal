program TuiButtonKeyboardTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type ButtonKeyboardModel = record
  Focus: integer;
  Actions: array of (integer);
end record;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string; Alt: boolean): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := Alt, meta := false);
end function;

function ViewButtons(State: ButtonKeyboardModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakeColumn([
                                                                                                                            Elements.TuiElementMakeInput(Ids.TuiControlIdCreate(1), '', 0, Ids.TuiActionCreate(1)),
                                                                                                                            Elements.TuiElementMakeDefaultButton(Ids.TuiControlIdCreate(2), 'Save', 'S', Ids.TuiActionCreate(20)),
                                                                                                                            Elements.TuiElementMakeButtonWithMnemonic(Ids.TuiControlIdCreate(3), 'Discard', 'D', Ids.TuiActionCreate(30)),
                                                                                                                            Elements.TuiElementMakeDisabledButton(Ids.TuiControlIdCreate(4), 'Cancel', 'C', Ids.TuiActionCreate(40))
                                                                                                                          ])
                                                                                          ]);
end function;

function UpdateButtons(State: ButtonKeyboardModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ButtonKeyboardModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return ButtonKeyboardModel(Focus := State.Focus, Actions := Arrays.Concat(State.Actions, [
                                                                                                   Action.Value
                                                                                                 ]));
      end;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return ButtonKeyboardModel(Focus := Id.Value, Actions := State.Actions);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(30, 10));
  var Model: ButtonKeyboardModel := ButtonKeyboardModel(Focus := 1, Actions := []);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 0, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Enter, '', false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 1, 0);
  Test.AssertEquals(20, Model.Actions[0]);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Character, 'd', true));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 1, 0);
  Test.AssertEquals(30, Model.Actions[1]);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Character, 'c', true));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 1, 0);
  Test.AssertEquals(2, Arrays.Length(Model.Actions));
  Model := ButtonKeyboardModel(Focus := 3, Actions := Model.Actions);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 0, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Space, '', false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 1, 0);
  Test.AssertEquals(30, Model.Actions[2]);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Down, '', false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 1, 0);
  Test.AssertEquals(2, Model.Focus);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Up, '', false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 1, 0);
  Test.AssertEquals(3, Model.Focus);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Left, '', false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 1, 0);
  Test.AssertEquals(2, Model.Focus);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Right, '', false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButtons, ViewButtons, 1, 0);
  Test.AssertEquals(3, Model.Focus);
  Runtime.TuiApplicationClose(App);
end program;
