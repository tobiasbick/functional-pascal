program TuiButtonKeyboardTest;

uses Std.Test, Std.Tui;

type ButtonKeyboardModel = record
  Focus: integer;
  Actions: array of integer;
end record;

function MakeKey(Kind: TuiKeyKind; Character: string; Alt: boolean): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := Alt, meta := false);
end function;

function ViewButtons(State: ButtonKeyboardModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakeColumn([
                                                                                                                  TuiElementBuilders.MakeInput(TuiControlId.Create(1), '', 0, TuiAction.Create(1)),
                                                                                                                  TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(2), 'Save', 'S', TuiAction.Create(20)),
                                                                                                                  TuiElementBuilders.MakeButtonWithMnemonic(TuiControlId.Create(3), 'Discard', 'D', TuiAction.Create(30)),
                                                                                                                  TuiElementBuilders.MakeDisabledButton(TuiControlId.Create(4), 'Cancel', 'C', TuiAction.Create(40))
                                                                                                                ])
                                                                                ]);
end function;

function UpdateButtons(State: ButtonKeyboardModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ButtonKeyboardModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.Action(const Source, const Action):
      begin
        return ButtonKeyboardModel(Focus := State.Focus, Actions := State.Actions.Concat([
                                                                                           Action.Value
                                                                                         ]));
      end;
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return ButtonKeyboardModel(Focus := Id.Value, Actions := State.Actions);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(30, 10));
  var Model: ButtonKeyboardModel := ButtonKeyboardModel(Focus := 1, Actions := []);
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 0, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false));
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 1, 0);
  AssertEquals(20, Model.Actions[0]);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'd', true));
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 1, 0);
  AssertEquals(30, Model.Actions[1]);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'c', true));
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 1, 0);
  AssertEquals(2, Model.Actions.Length());
  Model := ButtonKeyboardModel(Focus := 3, Actions := Model.Actions);
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 0, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Space, '', false));
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 1, 0);
  AssertEquals(30, Model.Actions[2]);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down, '', false));
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 1, 0);
  AssertEquals(2, Model.Focus);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Up, '', false));
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 1, 0);
  AssertEquals(3, Model.Focus);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Left, '', false));
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 1, 0);
  AssertEquals(2, Model.Focus);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Right, '', false));
  Model := App.RunIterations(Model, UpdateButtons, ViewButtons, 1, 0);
  AssertEquals(3, Model.Focus);
  App.Close();
end.
