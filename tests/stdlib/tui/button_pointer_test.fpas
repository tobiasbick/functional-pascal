program TuiButtonPointerTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type ButtonPointerModel = record
  Actions: integer;
  PointerEvents: integer;
end record;

function ViewButton(State: ButtonPointerModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Option.None, [
                                                           Tui.TuiElementBuilders.MakeButtonWithMnemonic(Tui.TuiControlId.Create(1), 'Go', 'G', Tui.TuiAction.Create(10))
                                                         ]);
end function;

function UpdateButton(State: ButtonPointerModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ButtonPointerModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return ButtonPointerModel(Actions := State.Actions + 1, PointerEvents := State.PointerEvents);
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return ButtonPointerModel(Actions := State.Actions, PointerEvents := State.PointerEvents + 1);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function Pointer(Action: Tui.TuiPointerAction; Position: Tui.TuiPoint): Tui.TuiPointerEvent;
begin
  return Tui.TuiPointerEvent.Create(Action, Tui.TuiPointerButton.Left, Position);
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(16, 4));
  mutable var Model: ButtonPointerModel := ButtonPointerModel(Actions := 0, PointerEvents := 0);
  Model := App.RunIterations(Model, UpdateButton, ViewButton, 0, 0);
  var GoX: integer := Str.IndexOf(App.SurfaceSnapshot().LineAt(0), 'G');
  var Inside: Tui.TuiPoint := Tui.TuiPoint.Create(GoX, 0);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(GoX, 0).Role = Tui.TuiStyleRole.ButtonShortcut);
  App.InjectPointerForTest(Pointer(Tui.TuiPointerAction.Down, Inside));
  Model := App.RunIterations(Model, UpdateButton, ViewButton, 2, 0);
  Test.AssertEquals(0, Model.Actions);
  Test.AssertEquals(1, Model.PointerEvents);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(GoX, 0).Role =
                  Tui.TuiStyleRole.ButtonSelectedShortcut);
  App.InjectPointerForTest(Pointer(Tui.TuiPointerAction.Drag, Tui.TuiPoint.Create(15, 3)));
  Model := App.RunIterations(Model, UpdateButton, ViewButton, 1, 0);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(GoX, 0).Role = Tui.TuiStyleRole.ButtonShortcut);
  App.InjectPointerForTest(Pointer(Tui.TuiPointerAction.Up, Tui.TuiPoint.Create(15, 3)));
  Model := App.RunIterations(Model, UpdateButton, ViewButton, 1, 0);
  Test.AssertEquals(0, Model.Actions);
  App.InjectPointerForTest(Pointer(Tui.TuiPointerAction.Down, Inside));
  Model := App.RunIterations(Model, UpdateButton, ViewButton, 2, 0);
  App.InjectPointerForTest(Pointer(Tui.TuiPointerAction.Drag, Tui.TuiPoint.Create(15, 3)));
  Model := App.RunIterations(Model, UpdateButton, ViewButton, 1, 0);
  App.InjectPointerForTest(Pointer(Tui.TuiPointerAction.Drag, Inside));
  Model := App.RunIterations(Model, UpdateButton, ViewButton, 1, 0);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(GoX, 0).Role =
                  Tui.TuiStyleRole.ButtonSelectedShortcut);
  App.InjectPointerForTest(Pointer(Tui.TuiPointerAction.Up, Inside));
  Model := App.RunIterations(Model, UpdateButton, ViewButton, 1, 0);
  Test.AssertEquals(1, Model.Actions);
  App.Close();
end program;
