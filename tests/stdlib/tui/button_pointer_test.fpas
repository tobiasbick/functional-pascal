program TuiButtonPointerTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type ButtonPointerModel = record
  Actions: integer;
  PointerEvents: integer;
end record;

function ViewButton(State: ButtonPointerModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.None, [
                                                       Elements.TuiElementMakeButtonWithMnemonic(Ids.TuiControlIdCreate(1), 'Go', 'G', Ids.TuiActionCreate(10))
                                                     ]);
end function;

function UpdateButton(State: ButtonPointerModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ButtonPointerModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return ButtonPointerModel(Actions := State.Actions + 1, PointerEvents := State.PointerEvents);
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return ButtonPointerModel(Actions := State.Actions, PointerEvents := State.PointerEvents + 1);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function Pointer(Action: Tui.TuiPointerAction; Position: Tui.TuiPoint): Tui.TuiPointerEvent;
begin
  return Runtime.TuiPointerEventCreate(Action, Tui.TuiPointerButton.Left, Position);
end function;

begin
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(16, 4));
  var Model: ButtonPointerModel := ButtonPointerModel(Actions := 0, PointerEvents := 0);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButton, ViewButton, 0, 0);
  const GoX: integer := Str.IndexOf(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'G');
  const Inside: Tui.TuiPoint := Geometry.TuiPointCreate(GoX, 0);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), GoX, 0).Role =
                  Tui.TuiStyleRole.ButtonShortcut);
  Runtime.TuiApplicationInjectPointerForTest(App, Pointer(Tui.TuiPointerAction.Down, Inside));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButton, ViewButton, 2, 0);
  Test.AssertEquals(0, Model.Actions);
  Test.AssertEquals(1, Model.PointerEvents);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), GoX, 0).Role =
                  Tui.TuiStyleRole.ButtonSelectedShortcut);
  Runtime.TuiApplicationInjectPointerForTest(App, Pointer(Tui.TuiPointerAction.Drag, Geometry.TuiPointCreate(15, 3)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButton, ViewButton, 1, 0);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), GoX, 0).Role =
                  Tui.TuiStyleRole.ButtonShortcut);
  Runtime.TuiApplicationInjectPointerForTest(App, Pointer(Tui.TuiPointerAction.Up, Geometry.TuiPointCreate(15, 3)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButton, ViewButton, 1, 0);
  Test.AssertEquals(0, Model.Actions);
  Runtime.TuiApplicationInjectPointerForTest(App, Pointer(Tui.TuiPointerAction.Down, Inside));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButton, ViewButton, 2, 0);
  Runtime.TuiApplicationInjectPointerForTest(App, Pointer(Tui.TuiPointerAction.Drag, Geometry.TuiPointCreate(15, 3)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButton, ViewButton, 1, 0);
  Runtime.TuiApplicationInjectPointerForTest(App, Pointer(Tui.TuiPointerAction.Drag, Inside));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButton, ViewButton, 1, 0);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), GoX, 0).Role =
                  Tui.TuiStyleRole.ButtonSelectedShortcut);
  Runtime.TuiApplicationInjectPointerForTest(App, Pointer(Tui.TuiPointerAction.Up, Inside));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateButton, ViewButton, 1, 0);
  Test.AssertEquals(1, Model.Actions);
  Runtime.TuiApplicationClose(App);
end program;
