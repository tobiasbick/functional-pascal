program TuiButtonSnapshotTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

function ViewButtons(State: integer): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakePanel('Buttons', [
                                                                                                                            Elements.TuiElementMakeColumn([
                                                                                                                                                            Elements.TuiElementMakeButtonWithMnemonic(Ids.TuiControlIdCreate(1), 'Go', 'G', Ids.TuiActionCreate(1)),
                                                                                                                                                            Elements.TuiElementMakeDefaultButton(Ids.TuiControlIdCreate(2), 'OK', 'O', Ids.TuiActionCreate(2)),
                                                                                                                                                            Elements.TuiElementMakeDisabledButton(Ids.TuiControlIdCreate(3), 'Stop', 'S', Ids.TuiActionCreate(3))
                                                                                                                                                          ])
                                                                                                                          ])
                                                                                ]);
end function;

function UpdateButtons(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 10));
  discard Runtime.TuiApplicationRunIterations(App, 0, UpdateButtons, ViewButtons, 0, 0);
  const Surface: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  const GoX: integer := Str.IndexOf(Rendering.TuiSurfaceSnapshotLineAt(Surface, 1), 'G');
  const OkX: integer := Str.IndexOf(Rendering.TuiSurfaceSnapshotLineAt(Surface, 2), 'O');
  const StopX: integer := Str.IndexOf(Rendering.TuiSurfaceSnapshotLineAt(Surface, 3), 'S');
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Surface, GoX, 1).Role =
                  Tui.TuiStyleRole.ButtonSelectedShortcut);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Surface, OkX, 2).Role =
                  Tui.TuiStyleRole.ButtonDefaultShortcut);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Surface, StopX, 3).Role =
                  Tui.TuiStyleRole.ButtonDisabled);
  Runtime.TuiApplicationClose(App);
end program;
