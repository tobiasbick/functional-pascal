program TuiCanvasClipTest;

uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Cells as Cells;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Rendering as Rendering;

begin
  const Surface: Tui.TuiWorkingSurface := Rendering.TuiWorkingSurfaceCreate(Geometry.TuiSizeCreate(6, 4));
  const Root: Tui.TuiCanvas := Rendering.TuiCanvasCreate(Surface, Geometry.TuiRectCreate(0, 0, 6, 4));
  const Child: Tui.TuiCanvas := Rendering.TuiCanvasChild(Root, Geometry.TuiRectCreate(1, 1, 3, 2));
  Rendering.TuiCanvasPutGlyph(Child, 0, 0, 'A');
  Rendering.TuiCanvasPutGlyph(Child, 2, 1, 'B');
  Rendering.TuiCanvasPutGlyph(Child, -1, 0, 'Z');
  Rendering.TuiCanvasPutGlyph(Child, 3, 0, 'Z');
  Rendering.TuiCanvasPutGlyph(Child, 0, -1, 'Z');
  Rendering.TuiCanvasPutGlyph(Child, 0, 2, 'Z');
  Test.AssertEquals('A', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 1)))
                           .Glyph);
  Test.AssertEquals('B', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(3, 2)))
                           .Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(0, 1)))
                           .Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(4, 1)))
                           .Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 0)))
                           .Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 3)))
                           .Glyph);
  const Nested: Tui.TuiCanvas := Rendering.TuiCanvasChild(Child, Geometry.TuiRectCreate(1, 0, 2, 1));
  Rendering.TuiCanvasFillRect(Nested, Geometry.TuiRectCreate(-1, -1, 4, 3), Cells.TuiCellCreate('#', Tui.TuiStyleRole.Accent));
  Test.AssertEquals('A', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 1)))
                           .Glyph);
  Test.AssertEquals('#', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(2, 1)))
                           .Glyph);
  Test.AssertEquals('#', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(3, 1)))
                           .Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(4, 1)))
                           .Glyph);
  Test.AssertEquals('B', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(3, 2)))
                           .Glyph);
  Rendering.TuiCanvasWriteText(Root, Geometry.TuiPointCreate(0, 3), ('Hi' + Str.Chr(10)) + 'No', Tui.TuiStyleRole.Title);
  Test.AssertEquals('H', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(0, 3)))
                           .Glyph);
  Test.AssertEquals('i', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 3)))
                           .Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(2, 3)))
                           .Glyph);
end program;
