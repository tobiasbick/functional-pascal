program TuiCanvasClipTest;

uses Std.Options as Options;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

begin
  var Surface: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(6, 4));
  var Root: Tui.TuiCanvas := Tui.TuiCanvas.Create(Surface, Tui.TuiRect.Create(0, 0, 6, 4));
  var Child: Tui.TuiCanvas := Root.Child(Tui.TuiRect.Create(1, 1, 3, 2));
  Child.PutGlyph(0, 0, 'A');
  Child.PutGlyph(2, 1, 'B');
  Child.PutGlyph(-1, 0, 'Z');
  Child.PutGlyph(3, 0, 'Z');
  Child.PutGlyph(0, -1, 'Z');
  Child.PutGlyph(0, 2, 'Z');
  Test.AssertEquals('A', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(1, 1))).Glyph);
  Test.AssertEquals('B', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(3, 2))).Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(0, 1))).Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(4, 1))).Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(1, 0))).Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(1, 3))).Glyph);
  var Nested: Tui.TuiCanvas := Child.Child(Tui.TuiRect.Create(1, 0, 2, 1));
  Nested.FillRect(Tui.TuiRect.Create(-1, -1, 4, 3), Tui.TuiCell.Create('#', Tui.TuiStyleRole.Accent));
  Test.AssertEquals('A', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(1, 1))).Glyph);
  Test.AssertEquals('#', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(2, 1))).Glyph);
  Test.AssertEquals('#', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(3, 1))).Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(4, 1))).Glyph);
  Test.AssertEquals('B', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(3, 2))).Glyph);
  Root.WriteText(Tui.TuiPoint.Create(0, 3), ('Hi' + Str.Chr(10)) + 'No', Tui.TuiStyleRole.Title);
  Test.AssertEquals('H', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(0, 3))).Glyph);
  Test.AssertEquals('i', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(1, 3))).Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(2, 3))).Glyph);
end program;
