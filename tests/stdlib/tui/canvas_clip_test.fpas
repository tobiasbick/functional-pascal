program TuiCanvasClipTest;

uses Std.Test as Test, Std.Tui as Tui;

begin
  const Surface: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(6, 4));
  const Root: Tui.TuiCanvas := Tui.TuiCanvas.Create(Surface, Tui.TuiRect.Create(0, 0, 6, 4));
  const Child: Tui.TuiCanvas := Root.Child(Tui.TuiRect.Create(1, 1, 3, 2));
  Child.PutGlyph(0, 0, 'A');
  Child.PutGlyph(2, 1, 'B');
  Child.PutGlyph(-1, 0, 'Z');
  Child.PutGlyph(3, 0, 'Z');
  Child.PutGlyph(0, -1, 'Z');
  Child.PutGlyph(0, 2, 'Z');
  Test.AssertEquals('A', Surface.TryCellAt(Tui.TuiPoint.Create(1, 1)).Unwrap().Glyph);
  Test.AssertEquals('B', Surface.TryCellAt(Tui.TuiPoint.Create(3, 2)).Unwrap().Glyph);
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(0, 1)).Unwrap().Glyph);
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(4, 1)).Unwrap().Glyph);
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(1, 0)).Unwrap().Glyph);
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(1, 3)).Unwrap().Glyph);
  const Nested: Tui.TuiCanvas := Child.Child(Tui.TuiRect.Create(1, 0, 2, 1));
  Nested.FillRect(Tui.TuiRect.Create(-1, -1, 4, 3), Tui.TuiCell.Create('#', Tui.TuiStyleRole.Accent));
  Test.AssertEquals('A', Surface.TryCellAt(Tui.TuiPoint.Create(1, 1)).Unwrap().Glyph);
  Test.AssertEquals('#', Surface.TryCellAt(Tui.TuiPoint.Create(2, 1)).Unwrap().Glyph);
  Test.AssertEquals('#', Surface.TryCellAt(Tui.TuiPoint.Create(3, 1)).Unwrap().Glyph);
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(4, 1)).Unwrap().Glyph);
  Test.AssertEquals('B', Surface.TryCellAt(Tui.TuiPoint.Create(3, 2)).Unwrap().Glyph);
  Root.WriteText(Tui.TuiPoint.Create(0, 3), 'Hi' + string.Chr(10) + 'No', Tui.TuiStyleRole.Title);
  Test.AssertEquals('H', Surface.TryCellAt(Tui.TuiPoint.Create(0, 3)).Unwrap().Glyph);
  Test.AssertEquals('i', Surface.TryCellAt(Tui.TuiPoint.Create(1, 3)).Unwrap().Glyph);
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(2, 3)).Unwrap().Glyph);
end.
