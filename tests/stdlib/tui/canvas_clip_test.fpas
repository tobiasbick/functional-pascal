program TuiCanvasClipTest;

uses Std.Test, Std.Tui;

begin
  const Surface: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(6, 4));
  const Root: TuiCanvas := TuiCanvas.Create(Surface, TuiRect.Create(0, 0, 6, 4));
  const Child: TuiCanvas := Root.Child(TuiRect.Create(1, 1, 3, 2));
  Child.PutGlyph(0, 0, 'A');
  Child.PutGlyph(2, 1, 'B');
  Child.PutGlyph(-1, 0, 'Z');
  Child.PutGlyph(3, 0, 'Z');
  Child.PutGlyph(0, -1, 'Z');
  Child.PutGlyph(0, 2, 'Z');
  AssertEquals('A', Surface.TryCellAt(TuiPoint.Create(1, 1)).Unwrap().Glyph);
  AssertEquals('B', Surface.TryCellAt(TuiPoint.Create(3, 2)).Unwrap().Glyph);
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(0, 1)).Unwrap().Glyph);
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(4, 1)).Unwrap().Glyph);
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(1, 0)).Unwrap().Glyph);
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(1, 3)).Unwrap().Glyph);
  const Nested: TuiCanvas := Child.Child(TuiRect.Create(1, 0, 2, 1));
  Nested.FillRect(TuiRect.Create(-1, -1, 4, 3), TuiCell.Create('#', TuiStyleRole.Accent));
  AssertEquals('A', Surface.TryCellAt(TuiPoint.Create(1, 1)).Unwrap().Glyph);
  AssertEquals('#', Surface.TryCellAt(TuiPoint.Create(2, 1)).Unwrap().Glyph);
  AssertEquals('#', Surface.TryCellAt(TuiPoint.Create(3, 1)).Unwrap().Glyph);
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(4, 1)).Unwrap().Glyph);
  AssertEquals('B', Surface.TryCellAt(TuiPoint.Create(3, 2)).Unwrap().Glyph);
  Root.WriteText(TuiPoint.Create(0, 3), 'Hi' + string.Chr(10) + 'No', TuiStyleRole.Title);
  AssertEquals('H', Surface.TryCellAt(TuiPoint.Create(0, 3)).Unwrap().Glyph);
  AssertEquals('i', Surface.TryCellAt(TuiPoint.Create(1, 3)).Unwrap().Glyph);
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(2, 3)).Unwrap().Glyph);
end.
