program TuiCellGridPaintTest;

uses Std.Options as Options;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Cells as Cells;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

function ViewGrid(State: integer): Tui.TuiElement;
begin
  const Concrete: Tui.TuiStyle := Cells.TuiStyleFromColors(Cells.TuiColorFromRgb(1, 2, 3), Cells.TuiColorFromRgb(4, 5, 6));
  return Elements.TuiElementMakeCellGrid(Chrome.TuiCellGridCreate(4, 2, [
                                                                          Cells.TuiCellCreate('A', Tui.TuiStyleRole.Accent),
                                                                          Cells.TuiCellStyled('B', Concrete),
                                                                          Cells.TuiCellCreate('C', Tui.TuiStyleRole.Title),
                                                                          Cells.TuiCellCreate('D', Tui.TuiStyleRole.Normal),
                                                                          Cells.TuiCellCreate('E', Tui.TuiStyleRole.Normal),
                                                                          Cells.TuiCellCreate('F', Tui.TuiStyleRole.Normal),
                                                                          Cells.TuiCellCreate('中', Tui.TuiStyleRole.Accent),
                                                                          Cells.TuiCellCreate('H', Tui.TuiStyleRole.Normal)
                                                                        ]));
end function;

function UpdateGrid(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(3, 2));
  discard Runtime.TuiApplicationRunIterations(App, 0, UpdateGrid, ViewGrid, 0, 0);
  const Snapshot: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertEquals('A', Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 0, 0).Glyph);
  Test.AssertEquals('B', Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 1, 0).Glyph);
  Test.AssertEquals(2, Options.Unwrap(Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 1, 0)
                                        .ConcreteStyle)
                         .Foreground
                         .Green);
  Test.AssertEquals('C', Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 2, 0).Glyph);
  Test.AssertEquals('E', Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 0, 1).Glyph);
  Test.AssertEquals('F', Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 1, 1).Glyph);
  Test.AssertEquals(' ', Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 2, 1).Glyph);
  Runtime.TuiApplicationClose(App);
end program;
