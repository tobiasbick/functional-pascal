program CellGridRowEquivalenceTest;

uses Std.Test as Test, Std.Tui as Tui, Std.Tui.Rendering.Canvas as Canvas;

procedure CompareRow(
  Expected: Tui.TuiWorkingSurface;
  Actual: Tui.TuiWorkingSurface;
  StartX: integer;
  ClipX: integer;
  ClipWidth: integer;
  OriginX: integer;
  Cells: array of Tui.TuiCell
);
begin
  Expected.Clear();
  Actual.Clear();
  const Wide: Tui.TuiCell := Tui.TuiCell.Create('中', Tui.TuiStyleRole.Accent);
  Expected.PutCell(Tui.TuiPoint.Create(0, 0), Wide);
  Expected.PutCell(Tui.TuiPoint.Create(3, 0), Wide);
  Actual.PutCell(Tui.TuiPoint.Create(0, 0), Wide);
  Actual.PutCell(Tui.TuiPoint.Create(3, 0), Wide);
  const Clip: Tui.TuiRect := Tui.TuiRect.Create(ClipX, 0, ClipWidth, 1);
  const Origin: Tui.TuiPoint := Tui.TuiPoint.Create(OriginX, 0);
  const Reference: Tui.TuiCanvas := Tui.TuiCanvas.CreateLocal(Expected, Origin, Clip);
  const Batch: Tui.TuiCanvas := Tui.TuiCanvas.CreateLocal(Actual, Origin, Clip);
  for X: integer := 0 to Cells.Length() - 1 do
    begin
      Reference.PutCell(Tui.TuiPoint.Create(StartX + X, 0), Cells[X]);
    end;
  end for;

  Canvas.TuiCanvasPutCells(Batch, Tui.TuiPoint.Create(StartX, 0), Cells);
  Canvas.TuiCanvasPutCells(Batch, Tui.TuiPoint.Create(StartX, 1), Cells);
  for X: integer := 0 to 6 do
    begin
      const Point: Tui.TuiPoint := Tui.TuiPoint.Create(X, 0);
      Test.AssertTrue((Expected.TryCellAt(Point) is None) = (Actual.TryCellAt(Point) is None));
      Test.AssertEquals(
        Expected.Snapshot().CellAt(X, 0).Glyph,
        Actual.Snapshot().CellAt(X, 0).Glyph
      );
      Test.AssertTrue(Expected.Snapshot().CellAt(X, 0).Role = Actual.Snapshot().CellAt(X, 0).Role);
    end;
  end for;
end procedure;

begin
  const Expected: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(7, 1));
  const Actual: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(7, 1));
  const Wide: Tui.TuiCell := Tui.TuiCell.Create('中', Tui.TuiStyleRole.Accent);
  const Narrow: Tui.TuiCell := Tui.TuiCell.Create('X', Tui.TuiStyleRole.Title);
  for StartX: integer := -2 to 8 do
    begin
      for ClipX: integer := 0 to 2 do
        begin
          for ClipWidth: integer := 0 to 7 do
            begin
              for OriginX: integer := -1 to 1 do
                begin
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, []);
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, [Wide]);
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, [Narrow, Wide]);
                  CompareRow(
                    Expected, Actual, StartX, ClipX, ClipWidth, OriginX, [
                      Wide,
                      Narrow,
                      Wide
                    ]
                  );
                end;
              end for;
            end;
          end for;
        end;
      end for;
    end;
  end for;
end.
