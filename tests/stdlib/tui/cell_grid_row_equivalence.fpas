program CellGridRowEquivalenceTest;

uses Std.Arrays, Std.Options, Std.Test, Std.Tui, Std.Tui.Rendering.Canvas;

procedure CompareRow(
  Expected: TuiWorkingSurface;
  Actual: TuiWorkingSurface;
  StartX: integer;
  ClipX: integer;
  ClipWidth: integer;
  OriginX: integer;
  Cells: array of TuiCell
);
begin
  Expected.Clear();
  Actual.Clear();
  const Wide: TuiCell := TuiCell.Create('中', TuiStyleRole.Accent);
  Expected.PutCell(TuiPoint.Create(0, 0), Wide);
  Expected.PutCell(TuiPoint.Create(3, 0), Wide);
  Actual.PutCell(TuiPoint.Create(0, 0), Wide);
  Actual.PutCell(TuiPoint.Create(3, 0), Wide);
  const Clip: TuiRect := TuiRect.Create(ClipX, 0, ClipWidth, 1);
  const Origin: TuiPoint := TuiPoint.Create(OriginX, 0);
  const Reference: Std.Tui.TuiCanvas := Std.Tui.TuiCanvas.CreateLocal(Expected, Origin, Clip);
  const Batch: Std.Tui.TuiCanvas := Std.Tui.TuiCanvas.CreateLocal(Actual, Origin, Clip);
  for X: integer := 0 to Std.Arrays.Length(Cells) - 1 do
    begin
      Reference.PutCell(TuiPoint.Create(StartX + X, 0), Cells[X]);
    end;
  end for;

  TuiCanvasPutCells(Batch, TuiPoint.Create(StartX, 0), Cells);
  TuiCanvasPutCells(Batch, TuiPoint.Create(StartX, 1), Cells);
  for X: integer := 0 to 6 do
    begin
      const Point: TuiPoint := TuiPoint.Create(X, 0);
      AssertTrue(Std.Options.IsNone(Expected.TryCellAt(Point)) =
                 Std.Options.IsNone(Actual.TryCellAt(Point)));
      AssertEquals(Expected.Snapshot().CellAt(X, 0).Glyph, Actual.Snapshot().CellAt(X, 0).Glyph);
      AssertTrue(Expected.Snapshot().CellAt(X, 0).Role = Actual.Snapshot().CellAt(X, 0).Role);
    end;
  end for;
end procedure;

begin
  const Expected: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(7, 1));
  const Actual: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(7, 1));
  const Wide: TuiCell := TuiCell.Create('中', TuiStyleRole.Accent);
  const Narrow: TuiCell := TuiCell.Create('X', TuiStyleRole.Title);
  for StartX: integer := -2 to 8 do
    begin
      for ClipX: integer := 0 to 2 do
        begin
          for ClipWidth: integer := 0 to 7 do
            begin
              for OriginX: integer := -1 to 1 do
                begin
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, []);
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, [Wide]);
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, [Narrow, Wide]);
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, [
                                                                                    Wide,
                                                                                    Narrow,
                                                                                    Wide
                                                                                  ]);
                end;
              end for;
            end;
          end for;
        end;
      end for;
    end;
  end for;
end.
