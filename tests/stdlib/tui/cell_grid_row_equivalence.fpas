program CellGridRowEquivalenceTest;

uses Std.Arrays as Arrays;
uses Std.Options as Options;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Rendering.Canvas as Canvas;
uses Std.Tui.Cells as Cells2;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Rendering as Rendering2;

procedure CompareRow(
  Expected: Tui.TuiWorkingSurface;
  Actual: Tui.TuiWorkingSurface;
  StartX: integer;
  ClipX: integer;
  ClipWidth: integer;
  OriginX: integer;
  Cells: array of (Tui.TuiCell)
);
begin
  Rendering2.TuiWorkingSurfaceClear(Expected);
  Rendering2.TuiWorkingSurfaceClear(Actual);
  const Wide: Tui.TuiCell := Cells2.TuiCellCreate('中', Tui.TuiStyleRole.Accent);
  Rendering2.TuiWorkingSurfacePutCell(Expected, Geometry.TuiPointCreate(0, 0), Wide);
  Rendering2.TuiWorkingSurfacePutCell(Expected, Geometry.TuiPointCreate(3, 0), Wide);
  Rendering2.TuiWorkingSurfacePutCell(Actual, Geometry.TuiPointCreate(0, 0), Wide);
  Rendering2.TuiWorkingSurfacePutCell(Actual, Geometry.TuiPointCreate(3, 0), Wide);
  const Clip: Tui.TuiRect := Geometry.TuiRectCreate(ClipX, 0, ClipWidth, 1);
  const Origin: Tui.TuiPoint := Geometry.TuiPointCreate(OriginX, 0);
  const Reference: Tui.TuiCanvas := Rendering2.TuiCanvasCreateLocal(Expected, Origin, Clip);
  const Batch: Tui.TuiCanvas := Rendering2.TuiCanvasCreateLocal(Actual, Origin, Clip);
  for X: integer := 0 to Arrays.Length(Cells) - 1 do
    begin
      Rendering2.TuiCanvasPutCell(Reference, Geometry.TuiPointCreate(StartX + X, 0), Cells[X]);
    end;
  end for;

  Canvas.TuiCanvasPutCells(Batch, Geometry.TuiPointCreate(StartX, 0), Cells);
  Canvas.TuiCanvasPutCells(Batch, Geometry.TuiPointCreate(StartX, 1), Cells);
  for X: integer := 0 to 6 do
    begin
      const Point: Tui.TuiPoint := Geometry.TuiPointCreate(X, 0);
      Test.AssertTrue(Options.IsNone(Rendering2.TuiWorkingSurfaceTryCellAt(Expected, Point)) =
                      Options.IsNone(Rendering2.TuiWorkingSurfaceTryCellAt(Actual, Point)));
      Test.AssertEquals(Rendering2.TuiSurfaceSnapshotCellAt(Rendering2.TuiWorkingSurfaceSnapshot(Expected), X, 0)
                          .Glyph, Rendering2.TuiSurfaceSnapshotCellAt(Rendering2.TuiWorkingSurfaceSnapshot(Actual), X, 0)
                                    .Glyph);
      Test.AssertTrue(Rendering2.TuiSurfaceSnapshotCellAt(Rendering2.TuiWorkingSurfaceSnapshot(Expected), X, 0).Role =
                      Rendering2.TuiSurfaceSnapshotCellAt(Rendering2.TuiWorkingSurfaceSnapshot(Actual), X, 0).Role);
    end;
  end for;
end procedure;

begin
  const Expected: Tui.TuiWorkingSurface := Rendering2.TuiWorkingSurfaceCreate(Geometry.TuiSizeCreate(7, 1));
  const Actual: Tui.TuiWorkingSurface := Rendering2.TuiWorkingSurfaceCreate(Geometry.TuiSizeCreate(7, 1));
  const Wide: Tui.TuiCell := Cells2.TuiCellCreate('中', Tui.TuiStyleRole.Accent);
  const Narrow: Tui.TuiCell := Cells2.TuiCellCreate('X', Tui.TuiStyleRole.Title);
  for StartX: integer := -2 to 8 do
    begin
      for ClipX: integer := 0 to 2 do
        begin
          for ClipWidth: integer := 0 to 7 do
            begin
              for OriginX: integer := -1 to 1 do
                begin
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, []);
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, [Wide]);
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, [Narrow, Wide]);
                  CompareRow(Expected, Actual, StartX, ClipX, ClipWidth, OriginX, [
                                                                                    Wide,
                                                                                    Narrow,
                                                                                    Wide
                                                                                  ]);
                end;
              end for;
            end;
          end for;
        end;
      end for;
    end;
  end for;
end program;
