program TuiCellPaletteValuesTest;

uses Std.Test as Test;
uses Std.Tui as Tui;

begin
  var RgbValue: Tui.TuiColor := Tui.TuiColor.FromRgb(10, 20, 30);
  Test.AssertTrue(RgbValue.Kind = Tui.TuiColorKind.Rgb);
  Test.AssertEquals(20, RgbValue.Green);
  var Plain: Tui.TuiStyle := Tui.TuiStyle.FromColors(RgbValue, Tui.TuiColor.FromRgb(1, 2, 3));
  Test.AssertFalse(Plain.Bold);
  var Styled: Tui.TuiCell := Tui.TuiCell.Styled('X', Plain);
  Test.AssertEquals('X', Styled.Glyph);
  Test.AssertEquals(1, Styled.Width());
  case Styled.ConcreteStyle of
    when Option.Some(const Concrete):
      begin
        Test.AssertEquals(20, Concrete.Foreground.Green);
      end;
    when Option.None:
      begin
        panic('expected concrete cell style');
      end;
  end case;
  var Palette: Tui.TuiPalette := Tui.TuiPalette.Default();
  Test.AssertTrue(Palette.ForRole(Tui.TuiStyleRole.Normal).Foreground.Kind = Tui.TuiColorKind.Rgb);
  Test.AssertEquals(201, Palette.ForRole(Tui.TuiStyleRole.Normal).Foreground.Red);
  Test.AssertEquals(13, Palette.ForRole(Tui.TuiStyleRole.Normal).Background.Red);
  Test.AssertEquals(88, Palette.ForRole(Tui.TuiStyleRole.Accent).Foreground.Red);
  Test.AssertEquals(31, Palette.ForRole(Tui.TuiStyleRole.Selected).Background.Red);
  Test.AssertEquals(63, Palette.ForRole(Tui.TuiStyleRole.GaugeFill).Foreground.Red);
  Test.AssertEquals(48, Palette.ForRole(Tui.TuiStyleRole.Rule).Foreground.Red);
  var Custom: Tui.TuiStyle := Tui.TuiStyle.FromColors(Tui.TuiColor.FromRgb(1, 2, 3), RgbValue);
  var Updated: Tui.TuiPalette := Palette.WithRole(Tui.TuiStyleRole.Warning, Custom);
  Test.AssertEquals(2, Updated.ForRole(Tui.TuiStyleRole.Warning).Foreground.Green);
  Test.AssertEquals(210, Palette.ForRole(Tui.TuiStyleRole.Warning).Foreground.Red);
end program;
