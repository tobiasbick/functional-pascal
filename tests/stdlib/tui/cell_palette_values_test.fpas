program TuiCellPaletteValuesTest;

uses Std.Test, Std.Tui;

begin
  const RgbValue: TuiColor := TuiColor.FromRgb(10, 20, 30);
  AssertTrue(RgbValue.Kind = TuiColorKind.Rgb);
  AssertEquals(20, RgbValue.Green);
  const Plain: TuiStyle := TuiStyle.FromColors(RgbValue, TuiColor.FromRgb(1, 2, 3));
  AssertFalse(Plain.Bold);
  const Styled: TuiCell := TuiCell.Styled('X', Plain);
  AssertEquals('X', Styled.Glyph);
  AssertEquals(1, Styled.Width());
  case Styled.ConcreteStyle of
    when Some(const Concrete):
      begin
        AssertEquals(20, Concrete.Foreground.Green);
      end;
    when None:
      begin
        panic('expected concrete cell style');
      end;
  end case;
  const Palette: TuiPalette := TuiPalette.Default();
  AssertTrue(Palette.ForRole(TuiStyleRole.Normal).Foreground.Kind = TuiColorKind.Rgb);
  AssertEquals(201, Palette.ForRole(TuiStyleRole.Normal).Foreground.Red);
  AssertEquals(13, Palette.ForRole(TuiStyleRole.Normal).Background.Red);
  AssertEquals(88, Palette.ForRole(TuiStyleRole.Accent).Foreground.Red);
  AssertEquals(31, Palette.ForRole(TuiStyleRole.Selected).Background.Red);
  AssertEquals(63, Palette.ForRole(TuiStyleRole.GaugeFill).Foreground.Red);
  AssertEquals(48, Palette.ForRole(TuiStyleRole.Rule).Foreground.Red);
  const Custom: TuiStyle := TuiStyle.FromColors(TuiColor.FromRgb(1, 2, 3), RgbValue);
  const Updated: TuiPalette := Palette.WithRole(TuiStyleRole.Warning, Custom);
  AssertEquals(2, Updated.ForRole(TuiStyleRole.Warning).Foreground.Green);
  AssertEquals(210, Palette.ForRole(TuiStyleRole.Warning).Foreground.Red);
end.
