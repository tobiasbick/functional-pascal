program TuiCheckBoxKeyboardTest;

uses Std.Test, Std.Tui;

type CheckModel = record
  Focus: integer;
  Checked: boolean;
  Changes: array of boolean;
end record;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewCheck(State: CheckModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakePanel('Host', [
                                                                                                                         TuiElementBuilders.MakeCheckBox(TuiControlId.Create(1), 'Flag', State.Checked, TuiAction.Create(9))
                                                                                                                       ])
                                                                                ]);
end function;

function UpdateCheck(State: CheckModel; Msg: TuiMsg; Cmd: TuiCmdOutput): CheckModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return CheckModel(Focus := Id.Value, Checked := State.Checked, Changes := State.Changes);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        AssertEquals(1, Source.Value);
        AssertEquals(9, Action.Value);
        return CheckModel(Focus := State.Focus, Checked := Checked, Changes := State.Changes.Concat([
                                                                                                      Checked
                                                                                                    ]));
      end;
    when TuiMsg.Started, TuiMsg.Key(_), TuiMsg.Pointer(_), TuiMsg.Tick(_), TuiMsg.Resize(_), TuiMsg.Action(_, _), TuiMsg.TextChanged(_, _, _, _), TuiMsg.TextAreaChanged(_, _, _, _, _), TuiMsg.SelectionChanged(_, _, _), TuiMsg.ScrollChanged(_, _, _), TuiMsg.MenuChanged(_, _, _), TuiMsg.BackgroundFailed(_, _, _, _, _, _), TuiMsg.QuitRequested:
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 6));
  var Model: CheckModel := CheckModel(Focus := 1, Checked := false, Changes := []);
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 0, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Space, ''));
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 1, 0);
  AssertTrue(Model.Checked);
  AssertEquals(1, Model.Changes.Length());
  AssertTrue(Model.Changes[0]);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, ''));
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 1, 0);
  AssertFalse(Model.Checked);
  AssertEquals(2, Model.Changes.Length());
  AssertFalse(Model.Changes[1]);
  App.Close();
end.
