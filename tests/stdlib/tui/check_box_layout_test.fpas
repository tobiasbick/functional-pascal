program TuiCheckBoxLayoutTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type CheckModel = record
  Checked: boolean;
end record;

function ViewCheck(State: CheckModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(1)), [
                                                                                Tui.TuiElementBuilders.MakePanel('Host', [
                                                                                                                           Tui.TuiElementBuilders.MakeCheckBox(Tui.TuiControlId.Create(1), 'Flag', State.Checked, Tui.TuiAction.Create(9))
                                                                                                                         ])
                                                                              ]);
end function;

function UpdateCheck(State: CheckModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): CheckModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  var Unchecked: Tui.TuiMeasureResult := Tui.TuiMeasure(Tui.TuiElementBuilders.MakeCheckBox(Tui.TuiControlId.Create(1), 'Flag', false, Tui.TuiAction.Create(1)), Tui.TuiMeasureSpec.Unbounded());
  Test.AssertEquals(8, Unchecked.Preferred.Width);
  Test.AssertEquals(1, Unchecked.Preferred.Height);
  Test.AssertEquals(8, Unchecked.Minimum.Width);
  var CheckedSize: Tui.TuiMeasureResult := Tui.TuiMeasure(Tui.TuiElementBuilders.MakeCheckBox(Tui.TuiControlId.Create(1), 'Flag', true, Tui.TuiAction.Create(1)), Tui.TuiMeasureSpec.Unbounded());
  Test.AssertEquals(8, CheckedSize.Preferred.Width);
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 6));
  mutable var Model: CheckModel := record
    Checked := false;
  end record;

  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 0, 0);
  Test.AssertTrue(Str.Contains(App.SurfaceSnapshot().LineAt(1), 'Flag'));
  App.InjectResizeForTest(Tui.TuiSize.Create(12, 4));
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 1, 0);
  Test.AssertEquals(12, App.SurfaceSnapshot().Width);
  Test.AssertEquals(4, App.SurfaceSnapshot().Height);
  Test.AssertTrue(Str.Contains(App.SurfaceSnapshot().LineAt(1), 'Fla'));
  App.Close();
end program;
