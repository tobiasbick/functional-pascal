program TuiCheckBoxLayoutTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Layout as Layout;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type CheckModel = record
  Checked: boolean;
end record;

function ViewCheck(State: CheckModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakePanel('Host', [
                                                                                                                         Elements.TuiElementMakeCheckBox(Ids.TuiControlIdCreate(1), 'Flag', State.Checked, Ids.TuiActionCreate(9))
                                                                                                                       ])
                                                                                ]);
end function;

function UpdateCheck(State: CheckModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): CheckModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  const Unchecked: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeCheckBox(Ids.TuiControlIdCreate(1), 'Flag', false, Ids.TuiActionCreate(1)), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(8, Unchecked.Preferred.Width);
  Test.AssertEquals(1, Unchecked.Preferred.Height);
  Test.AssertEquals(8, Unchecked.Minimum.Width);
  const CheckedSize: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeCheckBox(Ids.TuiControlIdCreate(1), 'Flag', true, Ids.TuiActionCreate(1)), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(8, CheckedSize.Preferred.Width);
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 6));
  var Model: CheckModel := CheckModel(Checked := false);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateCheck, ViewCheck, 0, 0);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 1), 'Flag'));
  Runtime.TuiApplicationInjectResizeForTest(App, Geometry.TuiSizeCreate(12, 4));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateCheck, ViewCheck, 1, 0);
  Test.AssertEquals(12, Runtime.TuiApplicationSurfaceSnapshot(App).Width);
  Test.AssertEquals(4, Runtime.TuiApplicationSurfaceSnapshot(App).Height);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 1), 'Fla'));
  Runtime.TuiApplicationClose(App);
end program;
