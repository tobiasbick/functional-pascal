program TuiCheckBoxPointerTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type CheckModel = record
  Focus: integer;
  Checked: boolean;
  Changes: array of boolean;
end record;

function MakePointer(X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, Tui.TuiPoint.Create(X, Y));
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      var Line: string := Snapshot.LineAt(Y);
      var Index: integer := Str.IndexOf(Line, Glyph);
      if Index >= 0 then
        begin
          return Tui.TuiPoint.Create(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewCheck(State: CheckModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(State.Focus)), [
                                                                                          Tui.TuiElementBuilders.MakePanel('Host', [
                                                                                                                                     Tui.TuiElementBuilders.MakeColumn([
                                                                                                                                                                         Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(2), 'Other', Tui.TuiAction.Create(2)),
                                                                                                                                                                         Tui.TuiElementBuilders.MakeCheckBox(Tui.TuiControlId.Create(1), 'Flag', State.Checked, Tui.TuiAction.Create(9))
                                                                                                                                                                       ])
                                                                                                                                   ])
                                                                                        ]);
end function;

function UpdateCheck(State: CheckModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): CheckModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(Previous, Current):
      begin
        case Current of
          when Some(Id):
            begin
              return record
                Focus := Id.Value;
                Checked := State.Checked;
                Changes := State.Changes;
              end record;
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.CheckChanged(Source, Action, Checked):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(9, Action.Value);
        return record
          Focus := State.Focus;
          Checked := Checked;
          Changes := Arrays.Concat(State.Changes, [Checked]);
        end record;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 8));
  mutable var Model: CheckModel := record
    Focus := 2;
    Checked := false;
    Changes := [];
  end record;

  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 0, 0);
  var FlagAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Flag');
  App.InjectPointerForTest(MakePointer(FlagAt.X, FlagAt.Y));
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 2, 0);
  Test.AssertEquals(1, Model.Focus);
  Test.AssertTrue(Model.Checked);
  Test.AssertEquals(1, Arrays.Length(Model.Changes));
  Test.AssertTrue(Model.Changes[0]);
  App.Close();
end program;
