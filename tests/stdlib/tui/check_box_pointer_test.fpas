program TuiCheckBoxPointerTest;

uses Std.Array, Std.Str, Std.Test, Std.Tui;

type
  CheckModel = record
    Focus: integer;
    Checked: boolean;
    Changes: array of boolean;
  end;

function MakePointer(X: integer; Y: integer): TuiPointerEvent;
begin
  return TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(X, Y))
end;

function FindGlyph(Snapshot: TuiSurfaceSnapshot; Glyph: string): TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
  begin
    var Line: string := Snapshot.LineAt(Y);
    var Index: integer := Std.Str.IndexOf(Line, Glyph);
    if Index >= 0 then
    begin
      return TuiPoint.Create(Index, Y)
    end
  end;
  panic('glyph not found in snapshot')
end;

function ViewCheck(State: CheckModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakeWindow('Host', [

                                                                                                                          TuiElementBuilders.MakeColumn([

                                                                                  

                                                                                                                                                          TuiElementBuilders.MakeButton(TuiControlId.Create(2), 'Other', TuiAction.Create(2)),

                                                                                  

                                                                                                                                                          TuiElementBuilders.MakeCheckBox(TuiControlId.Create(1), 'Flag', State.Checked, TuiAction.Create(9))

                                                                                  

                                                                                                                          

                                                                                  

                                                                                                                                                        ])

                                                                                  

                                                                                                                        ])

                                                                                ])
end;

function UpdateCheck(State: CheckModel; Msg: TuiMsg; Cmd: TuiCmdOutput): CheckModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.FocusChanged(Previous, Current):
    begin
      case Current of
        Some(Id):
        begin
          return record Focus := Id.Value; Checked := State.Checked; Changes := State.Changes; end
        end;
        None:
        begin
          return State
        end
      end
    end;
    TuiMsg.CheckChanged(Source, Action, Checked):
    begin
      AssertEquals(1, Source.Value);
      AssertEquals(9, Action.Value);
      return record
        Focus := State.Focus;
        Checked := Checked;
        Changes := Std.Array.Concat(State.Changes, [Checked]);
      end
    end;
    TuiMsg.Key(Key), TuiMsg.Pointer(Pointer), TuiMsg.Tick(Delta), TuiMsg.Resize(Size), TuiMsg.Action(Source, Action), TuiMsg.TextChanged(Source, Action, Text, Caret), TuiMsg.TextAreaChanged(Source, Action, Text, Caret, TextAreaOffset), TuiMsg.SelectionChanged(Source, Action, Selected), TuiMsg.ScrollChanged(Source, Action, Offset), TuiMsg.QuitRequested:
    begin
      return State
    end
  end
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 8));
  mutable var Model: CheckModel := record Focus := 2; Checked := false; Changes := []; end;
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 0, 0);
  var FlagAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Flag');
  App.InjectPointerForTest(MakePointer(FlagAt.X, FlagAt.Y));
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 2, 0);
  AssertEquals(1, Model.Focus);
  AssertTrue(Model.Checked);
  AssertEquals(1, Std.Array.Length(Model.Changes));
  AssertTrue(Model.Changes[0]);
  App.Close()
end.
