program TuiCheckBoxPointerTest;

uses Std.Test, Std.Tui;

type CheckModel = record
  Focus: integer;
  Checked: boolean;
  Changes: array of boolean;
end record;

function MakePointer(X: integer; Y: integer): TuiPointerEvent;
begin
  return TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(X, Y));
end function;

function FindGlyph(Snapshot: TuiSurfaceSnapshot; Glyph: string): TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Line: string := Snapshot.LineAt(Y);
      const Index: integer := Line.IndexOf(Glyph);
      if Index >= 0 then
        begin
          return TuiPoint.Create(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewCheck(State: CheckModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakePanel('Host', [
                                                                                                                         TuiElementBuilders.MakeColumn([
                                                                                                                                                         TuiElementBuilders.MakeButton(TuiControlId.Create(2), 'Other', TuiAction.Create(2)),
                                                                                                                                                         TuiElementBuilders.MakeCheckBox(TuiControlId.Create(1), 'Flag', State.Checked, TuiAction.Create(9))
                                                                                                                                                       ])
                                                                                                                       ])
                                                                                ]);
end function;

function UpdateCheck(State: CheckModel; Msg: TuiMsg; Cmd: TuiCmdOutput): CheckModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return CheckModel(Focus := Id.Value, Checked := State.Checked, Changes := State.Changes);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        AssertEquals(1, Source.Value);
        AssertEquals(9, Action.Value);
        return CheckModel(Focus := State.Focus, Checked := Checked, Changes := State.Changes.Concat([
                                                                                                      Checked
                                                                                                    ]));
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 8));
  var Model: CheckModel := CheckModel(Focus := 2, Checked := false, Changes := []);
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 0, 0);
  const FlagAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Flag');
  App.InjectPointerForTest(MakePointer(FlagAt.X, FlagAt.Y));
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 2, 0);
  AssertEquals(1, Model.Focus);
  AssertTrue(Model.Checked);
  AssertEquals(1, Model.Changes.Length());
  AssertTrue(Model.Changes[0]);
  App.Close();
end.
