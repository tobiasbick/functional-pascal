program TuiCheckBoxPointerTest;

uses Std.Test as Test, Std.Ui.Terminal as Tui;

type CheckModel = record
  Focus: integer;
  Checked: boolean;
  Changes: array of boolean;
end record;

function MakePointer(X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Tui.TuiPointerEvent.Create(
    Tui.TuiPointerAction.Down,
    Tui.TuiPointerButton.Left,
    Tui.TuiPoint.Create(X, Y)
  );
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Line: string := Snapshot.LineAt(Y);
      case Line.IndexOf(Glyph) of
        when Some(const Index):
          return Tui.TuiPoint.Create(Index, Y);
        when None:
          null;
      end case;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewCheck(State: CheckModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(
    Some(Tui.TuiControlId.Create(State.Focus)), [
      Tui.TuiElementBuilders.MakePanel(
        'Host', [
          Tui.TuiElementBuilders.MakeColumn([
            Tui.TuiElementBuilders.MakeButton(
              Tui.TuiControlId.Create(2),
              'Other',
              Tui.TuiAction.Create(2)
            ),
            Tui.TuiElementBuilders.MakeCheckBox(
              Tui.TuiControlId.Create(1),
              'Flag',
              State.Checked,
              Tui.TuiAction.Create(9)
            )
          ])
        ]
      )
    ]
  );
end function;

function UpdateCheck(State: CheckModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): CheckModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return CheckModel(
                Focus := Id.Value,
                Checked := State.Checked,
                Changes := State.Changes
              );
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(9, Action.Value);
        return CheckModel(
          Focus := State.Focus, Checked := Checked, Changes := State.Changes.Concat([
            Checked
          ])
        );
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 8));
  var Model: CheckModel := CheckModel(Focus := 2, Checked := false, Changes := []);
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 0, 0);
  const FlagAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Flag');
  App.InjectPointerForTest(MakePointer(FlagAt.X, FlagAt.Y));
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 2, 0);
  Test.AssertEquals(1, Model.Focus);
  Test.AssertTrue(Model.Checked);
  Test.AssertEquals(1, Model.Changes.Length());
  Test.AssertTrue(Model.Changes[0]);
  App.Close();
end.
