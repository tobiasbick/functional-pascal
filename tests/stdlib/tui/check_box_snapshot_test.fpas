program TuiCheckBoxSnapshotTest;

uses Std.Test, Std.Tui;

type CheckModel = record
  Focus: integer;
  Checked: boolean;
end record;

function ViewCheck(State: CheckModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakePanel('Host', [
                                                                                                                         TuiElementBuilders.MakeCheckBox(TuiControlId.Create(1), 'Flag', State.Checked, TuiAction.Create(9))
                                                                                                                       ])
                                                                                ]);
end function;

function UpdateCheck(State: CheckModel; Msg: TuiMsg; Cmd: TuiCmdOutput): CheckModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        return CheckModel(Focus := State.Focus, Checked := Checked);
      end;
    when TuiMsg.Started, TuiMsg.Key(_), TuiMsg.Pointer(_), TuiMsg.Tick(_), TuiMsg.Resize(_), TuiMsg.FocusChanged(_, _), TuiMsg.Action(_, _), TuiMsg.TextChanged(_, _, _, _), TuiMsg.TextAreaChanged(_, _, _, _, _), TuiMsg.SelectionChanged(_, _, _), TuiMsg.ScrollChanged(_, _, _), TuiMsg.MenuChanged(_, _, _), TuiMsg.BackgroundFailed(_, _, _, _, _, _), TuiMsg.QuitRequested:
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 6));
  var Model: CheckModel := CheckModel(Focus := 1, Checked := false);
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 0, 0);
  AssertTrue(App.SurfaceSnapshot().LineAt(1).Contains('>[ ] Flag'));
  Model := CheckModel(Focus := 1, Checked := true);
  Model := App.RunIterations(Model, UpdateCheck, ViewCheck, 0, 0);
  AssertTrue(App.SurfaceSnapshot().LineAt(1).Contains('>[x] Flag'));
  App.Close();
end.
