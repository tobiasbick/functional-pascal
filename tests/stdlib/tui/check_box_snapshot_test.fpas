program TuiCheckBoxSnapshotTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type CheckModel = record
  Focus: integer;
  Checked: boolean;
end record;

function ViewCheck(State: CheckModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakePanel('Host', [
                                                                                                                                   Elements.TuiElementMakeCheckBox(Ids.TuiControlIdCreate(1), 'Flag', State.Checked, Ids.TuiActionCreate(9))
                                                                                                                                 ])
                                                                                          ]);
end function;

function UpdateCheck(State: CheckModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): CheckModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        return CheckModel(Focus := State.Focus, Checked := Checked);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 6));
  var Model: CheckModel := CheckModel(Focus := 1, Checked := false);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateCheck, ViewCheck, 0, 0);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 1), '>[ ] Flag'));
  Model := CheckModel(Focus := 1, Checked := true);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateCheck, ViewCheck, 0, 0);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 1), '>[x] Flag'));
  Runtime.TuiApplicationClose(App);
end program;
