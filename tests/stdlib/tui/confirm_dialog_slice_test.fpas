program ConfirmDialogSliceTest;

uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Tui as Tui;
uses Std.Test as Test;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

const NameControlValue: integer := 1;
const SaveControlValue: integer := 2;
const YesControlValue: integer := 3;
const NoControlValue: integer := 4;
const NameChangedActionValue: integer := 10;
const SaveActionValue: integer := 11;
const ConfirmYesActionValue: integer := 12;
const ConfirmNoActionValue: integer := 13;

type EditorModel = record
  Name: string;
  NameCaret: integer;
  Focused: integer;
  ConfirmOpen: boolean;
  Saved: boolean;
  Quit: boolean;
end record;

function EditorState(
  State: EditorModel;
  Name: string;
  Caret: integer;
  Focused: integer;
  ConfirmOpen: boolean;
  Saved: boolean;
  Quit: boolean
): EditorModel;
begin
  return EditorModel(Name := Name, NameCaret := Caret, Focused := Focused, ConfirmOpen := ConfirmOpen, Saved := Saved, Quit := Quit);
end function;

function UpdateEditor(State: EditorModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): EditorModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Key(const Key):
      begin
        return State;
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return State;
      end;
    when Tui.TuiMsg.Resize(const Size):
      begin
        return State;
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return State;
      end;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return EditorState(State, State.Name, State.NameCaret, Id.Value, State.ConfirmOpen, State.Saved, State.Quit);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        if Action.Value = SaveActionValue then
          begin
            Test.AssertEquals(SaveControlValue, Source.Value);
            return EditorState(State, State.Name, State.NameCaret, YesControlValue, true, State.Saved, State.Quit);
          end;
        end if;

        if Action.Value = ConfirmYesActionValue then
          begin
            Test.AssertEquals(YesControlValue, Source.Value);
            return EditorState(State, State.Name, State.NameCaret, SaveControlValue, false, true, State.Quit);
          end;
        end if;

        if Action.Value = ConfirmNoActionValue then
          begin
            Test.AssertEquals(NoControlValue, Source.Value);
            return EditorState(State, State.Name, State.NameCaret, SaveControlValue, false, State.Saved, State.Quit);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        Test.AssertEquals(NameControlValue, Source.Value);
        Test.AssertEquals(NameChangedActionValue, Action.Value);
        return EditorState(State, Text, Caret, State.Focused, State.ConfirmOpen, State.Saved, State.Quit);
      end;
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset):
      begin
        return State;
      end;
    when Tui.TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        return State;
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return State;
      end;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return State;
      end;
    when Tui.TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
        return EditorState(State, 'SHOULD NOT PAINT', 0, State.Focused, State.ConfirmOpen, State.Saved, true);
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
        return EditorState(State, 'SHOULD NOT PAINT', 0, State.Focused, State.ConfirmOpen, State.Saved, true);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _):
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function ViewEditor(State: EditorModel): Tui.TuiElement;
begin
  var Overlay: Tui.TuiElement := Elements.TuiElementMakeEmpty();
  if State.ConfirmOpen then
    begin
      Overlay := Elements.TuiElementMakeOverlay('Confirm', [
                                                             Elements.TuiElementMakeLabel('Save changes?'),
                                                             Elements.TuiElementMakeRow([
                                                                                          Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(YesControlValue), 'Yes', Ids.TuiActionCreate(ConfirmYesActionValue)),
                                                                                          Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(NoControlValue), 'No', Ids.TuiActionCreate(ConfirmNoActionValue))
                                                                                        ])
                                                           ]);
    end;
  end if;

  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focused)), [
                                                                                              Elements.TuiElementMakePanel('Editor', [
                                                                                                                                       Elements.TuiElementMakeColumn([
                                                                                                                                                                       Elements.TuiElementMakeLabel('Name'),
                                                                                                                                                                       Elements.TuiElementMakeInput(Ids.TuiControlIdCreate(NameControlValue), State.Name, State.NameCaret, Ids.TuiActionCreate(NameChangedActionValue)),
                                                                                                                                                                       Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(SaveControlValue), 'Save', Ids.TuiActionCreate(SaveActionValue))
                                                                                                                                                                     ])
                                                                                                                                     ]),
                                                                                              Overlay
                                                                                            ]);
end function;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Console.keyevent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

begin
  const Initial: EditorModel := EditorModel(Name := '', NameCaret := 0, Focused := NameControlValue, ConfirmOpen := false, Saved := false, Quit := false);
  const DirectCmd: Tui.TuiCmdOutput := Runtime.TuiCmdOutputCreate();
  const DirectQuit: EditorModel := UpdateEditor(Initial, Tui.TuiMsg.QuitRequested, DirectCmd);
  Test.AssertTrue(Runtime.TuiCmdOutputCommand(DirectCmd) = Tui.TuiCmd.Quit);
  Test.AssertTrue(DirectQuit.Quit);
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(40, 12));
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Character, 'A'));
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Character, 'd'));
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Character, 'a'));
  var Model: EditorModel := Runtime.TuiApplicationRunIterations(App, Initial, UpdateEditor, ViewEditor, 3, 0);
  Test.AssertEquals('Ada', Model.Name);
  Test.AssertEquals(3, Model.NameCaret);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Tab, ''));
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Enter, ''));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateEditor, ViewEditor, 2, 0);
  Test.AssertTrue(Model.ConfirmOpen);
  Test.AssertEquals(YesControlValue, Model.Focused);
  const DialogSurface: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(DialogSurface, 4), ' Confirm '));
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(DialogSurface, 5), 'Save changes?'));
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Enter, ''));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateEditor, ViewEditor, 1, 0);
  Test.AssertFalse(Model.ConfirmOpen);
  Test.AssertTrue(Model.Saved);
  const BeforeQuit: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Escape, ''));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateEditor, ViewEditor, 1, 0);
  Test.AssertTrue(Model.Quit);
  const AfterQuit: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertEquals(Rendering.TuiSurfaceSnapshotLineAt(BeforeQuit, 2), Rendering.TuiSurfaceSnapshotLineAt(AfterQuit, 2));
  Test.AssertFalse(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(AfterQuit, 2), 'SHOULD NOT PAINT'));
end program;
