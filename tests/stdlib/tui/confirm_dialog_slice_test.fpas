program ConfirmDialogSliceTest;

uses Std.Console, Std.Str, Std.Tui, Std.Test;

const
  NameControlValue: integer := 1;
  SaveControlValue: integer := 2;
  YesControlValue: integer := 3;
  NoControlValue: integer := 4;
  NameChangedActionValue: integer := 10;
  SaveActionValue: integer := 11;
  ConfirmYesActionValue: integer := 12;
  ConfirmNoActionValue: integer := 13;

type
  EditorModel = record
    Name: string;
    NameCaret: integer;
    Focused: integer;
    ConfirmOpen: boolean;
    Saved: boolean;
    Quit: boolean;
  end;

function EditorState(
  State: EditorModel;
  Name: string;
  Caret: integer;
  Focused: integer;
  ConfirmOpen: boolean;
  Saved: boolean;
  Quit: boolean
): EditorModel;
begin
  return record
    Name := Name;
    NameCaret := Caret;
    Focused := Focused;
    ConfirmOpen := ConfirmOpen;
    Saved := Saved;
    Quit := Quit;
  end
end;

function UpdateEditor(State: EditorModel; Msg: TuiMsg; Cmd: TuiCmdOutput): EditorModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.Key(Key), TuiMsg.Pointer(Pointer), TuiMsg.Resize(Size):
    begin
      return State
    end;
    TuiMsg.Tick(Delta):
    begin
      return State
    end;
    TuiMsg.FocusChanged(Previous, Current):
    begin
      case Current of
        Some(Id):
        begin
          return EditorState(State, State.Name, State.NameCaret, Id.Value, State.ConfirmOpen, State.Saved, State.Quit)
        end;
        None:
        begin
          return State
        end
      end
    end;
    TuiMsg.Action(Source, Action):
    begin
      if Action.Value = SaveActionValue then
      begin
        AssertEquals(SaveControlValue, Source.Value);
        return EditorState(State, State.Name, State.NameCaret, YesControlValue, true, State.Saved, State.Quit)
      end;
      if Action.Value = ConfirmYesActionValue then
      begin
        AssertEquals(YesControlValue, Source.Value);
        return EditorState(State, State.Name, State.NameCaret, SaveControlValue, false, true, State.Quit)
      end;
      if Action.Value = ConfirmNoActionValue then
      begin
        AssertEquals(NoControlValue, Source.Value);
        return EditorState(State, State.Name, State.NameCaret, SaveControlValue, false, State.Saved, State.Quit)
      end;
      return State
    end;
    TuiMsg.TextChanged(Source, Action, Text, Caret):
    begin
      AssertEquals(NameControlValue, Source.Value);
      AssertEquals(NameChangedActionValue, Action.Value);
      return EditorState(State, Text, Caret, State.Focused, State.ConfirmOpen, State.Saved, State.Quit)
    end;
    TuiMsg.CheckChanged(Source, Action, Checked):
    begin
      return State
    end;
    TuiMsg.SelectionChanged(Source, Action, Selected):
    begin
      return State
    end;
    TuiMsg.ScrollChanged(Source, Action, Offset):
    begin
      return State
    end;
    TuiMsg.QuitRequested:
    begin
      Cmd.Set(TuiCmd.Quit);
      return EditorState(State, 'SHOULD NOT PAINT', 0, State.Focused, State.ConfirmOpen, State.Saved, true)
    end
  end
end;

function ViewEditor(State: EditorModel): TuiElement;
begin
  mutable var Overlay: TuiElement := TuiElementBuilders.MakeEmpty();
  if State.ConfirmOpen then
  begin
    Overlay := TuiElementBuilders.MakeDialog('Confirm', [
                                                          TuiElementBuilders.MakeLabel('Save changes?'),
                                                          TuiElementBuilders.MakeRow([

                                                                                       TuiElementBuilders.MakeButton(TuiControlId.Create(YesControlValue), 'Yes', TuiAction.Create(ConfirmYesActionValue)),

                                                                                       TuiElementBuilders.MakeButton(TuiControlId.Create(NoControlValue), 'No', TuiAction.Create(ConfirmNoActionValue))

                                                          

                                                                                     ])

                                                        ])
  end;
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focused)), [
                                                                                    TuiElementBuilders.MakeWindow('Editor', [

                                                                                                                              TuiElementBuilders.MakeColumn([

                                                                                    

                                                                                                                                                              TuiElementBuilders.MakeLabel('Name'),

                                                                                    

                                                                                                                                                              TuiElementBuilders.MakeInput(TuiControlId.Create(NameControlValue), State.Name, State.NameCaret, TuiAction.Create(NameChangedActionValue)),

                                                                                    

                                                                                                                                                              TuiElementBuilders.MakeButton(TuiControlId.Create(SaveControlValue), 'Save', TuiAction.Create(SaveActionValue))

                                                                                    

                                                                                                                              

                                                                                    

                                                                                                                                                            ])

                                                                                    

                                                                                                                            ]),
                                                                                    Overlay

                                                                                  ])
end;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

begin
  var Initial: EditorModel := record
    Name := '';
    NameCaret := 0;
    Focused := NameControlValue;
    ConfirmOpen := false;
    Saved := false;
    Quit := false;
  end;
  var DirectCmd: TuiCmdOutput := TuiCmdOutput.Create();
  var DirectQuit: EditorModel := UpdateEditor(Initial, TuiMsg.QuitRequested, DirectCmd);
  AssertTrue(DirectCmd.Read() = TuiCmd.Quit);
  AssertTrue(DirectQuit.Quit);
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 12));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'A'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'd'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'a'));
  mutable var Model: EditorModel := App.RunIterations(Initial, UpdateEditor, ViewEditor, 3, 0);
  AssertEquals('Ada', Model.Name);
  AssertEquals(3, Model.NameCaret);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Tab, ''));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, ''));
  Model := App.RunIterations(Model, UpdateEditor, ViewEditor, 2, 0);
  AssertTrue(Model.ConfirmOpen);
  AssertEquals(YesControlValue, Model.Focused);
  var DialogSurface: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertTrue(Std.Str.Contains(DialogSurface.LineAt(4), ' Confirm '));
  AssertTrue(Std.Str.Contains(DialogSurface.LineAt(5), 'Save changes?'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, ''));
  Model := App.RunIterations(Model, UpdateEditor, ViewEditor, 1, 0);
  AssertFalse(Model.ConfirmOpen);
  AssertTrue(Model.Saved);
  var BeforeQuit: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Escape, ''));
  Model := App.RunIterations(Model, UpdateEditor, ViewEditor, 1, 0);
  AssertTrue(Model.Quit);
  var AfterQuit: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertEquals(BeforeQuit.LineAt(2), AfterQuit.LineAt(2));
  AssertFalse(Std.Str.Contains(AfterQuit.LineAt(2), 'SHOULD NOT PAINT'))
end.
