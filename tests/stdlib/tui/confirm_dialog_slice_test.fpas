program ConfirmDialogSliceTest;

uses Std.Console as Console;
uses Std.Str as Str;
uses Std.Tui as Tui;
uses Std.Test as Test;

const NameControlValue: integer := 1;
const SaveControlValue: integer := 2;
const YesControlValue: integer := 3;
const NoControlValue: integer := 4;
const NameChangedActionValue: integer := 10;
const SaveActionValue: integer := 11;
const ConfirmYesActionValue: integer := 12;
const ConfirmNoActionValue: integer := 13;

type EditorModel = record
  Name: string;
  NameCaret: integer;
  Focused: integer;
  ConfirmOpen: boolean;
  Saved: boolean;
  Quit: boolean;
end record;

function EditorState(
  State: EditorModel;
  Name: string;
  Caret: integer;
  Focused: integer;
  ConfirmOpen: boolean;
  Saved: boolean;
  Quit: boolean
): EditorModel;
begin
  return EditorModel(Name := Name, NameCaret := Caret, Focused := Focused, ConfirmOpen := ConfirmOpen, Saved := Saved, Quit := Quit);
end function;

function UpdateEditor(State: EditorModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): EditorModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Key(const Key):
      begin
        return State;
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return State;
      end;
    when Tui.TuiMsg.Resize(const Size):
      begin
        return State;
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return State;
      end;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return EditorState(State, State.Name, State.NameCaret, Id.Value, State.ConfirmOpen, State.Saved, State.Quit);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        if Action.Value = SaveActionValue then
          begin
            Test.AssertEquals(SaveControlValue, Source.Value);
            return EditorState(State, State.Name, State.NameCaret, YesControlValue, true, State.Saved, State.Quit);
          end;
        end if;

        if Action.Value = ConfirmYesActionValue then
          begin
            Test.AssertEquals(YesControlValue, Source.Value);
            return EditorState(State, State.Name, State.NameCaret, SaveControlValue, false, true, State.Quit);
          end;
        end if;

        if Action.Value = ConfirmNoActionValue then
          begin
            Test.AssertEquals(NoControlValue, Source.Value);
            return EditorState(State, State.Name, State.NameCaret, SaveControlValue, false, State.Saved, State.Quit);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        Test.AssertEquals(NameControlValue, Source.Value);
        Test.AssertEquals(NameChangedActionValue, Action.Value);
        return EditorState(State, Text, Caret, State.Focused, State.ConfirmOpen, State.Saved, State.Quit);
      end;
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset):
      begin
        return State;
      end;
    when Tui.TuiMsg.CheckChanged(const Source, const Action, const Checked):
      begin
        return State;
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return State;
      end;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return State;
      end;
    when Tui.TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return EditorState(State, 'SHOULD NOT PAINT', 0, State.Focused, State.ConfirmOpen, State.Saved, true);
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return EditorState(State, 'SHOULD NOT PAINT', 0, State.Focused, State.ConfirmOpen, State.Saved, true);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _):
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function ViewEditor(State: EditorModel): Tui.TuiElement;
begin
  mutable var Overlay: Tui.TuiElement := Tui.TuiElementBuilders.MakeEmpty();
  if State.ConfirmOpen then
    begin
      Overlay := Tui.TuiElementBuilders.MakeOverlay('Confirm', [
                                                                 Tui.TuiElementBuilders.MakeLabel('Save changes?'),
                                                                 Tui.TuiElementBuilders.MakeRow([
                                                                                                  Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(YesControlValue), 'Yes', Tui.TuiAction.Create(ConfirmYesActionValue)),
                                                                                                  Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(NoControlValue), 'No', Tui.TuiAction.Create(ConfirmNoActionValue))
                                                                                                ])
                                                               ]);
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(Option.Some(Tui.TuiControlId.Create(State.Focused)), [
                                                                                                   Tui.TuiElementBuilders.MakePanel('Editor', [
                                                                                                                                                Tui.TuiElementBuilders.MakeColumn([
                                                                                                                                                                                    Tui.TuiElementBuilders.MakeLabel('Name'),
                                                                                                                                                                                    Tui.TuiElementBuilders.MakeInput(Tui.TuiControlId.Create(NameControlValue), State.Name, State.NameCaret, Tui.TuiAction.Create(NameChangedActionValue)),
                                                                                                                                                                                    Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(SaveControlValue), 'Save', Tui.TuiAction.Create(SaveActionValue))
                                                                                                                                                                                  ])
                                                                                                                                              ]),
                                                                                                   Overlay
                                                                                                 ]);
end function;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Console.keyevent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

begin
  var Initial: EditorModel := EditorModel(Name := '', NameCaret := 0, Focused := NameControlValue, ConfirmOpen := false, Saved := false, Quit := false);
  var DirectCmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  var DirectQuit: EditorModel := UpdateEditor(Initial, Tui.TuiMsg.QuitRequested, DirectCmd);
  Test.AssertTrue(DirectCmd.Command() = Tui.TuiCmd.Quit);
  Test.AssertTrue(DirectQuit.Quit);
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(40, 12));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'A'));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'd'));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'a'));
  mutable var Model: EditorModel := App.RunIterations(Initial, UpdateEditor, ViewEditor, 3, 0);
  Test.AssertEquals('Ada', Model.Name);
  Test.AssertEquals(3, Model.NameCaret);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Tab, ''));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, ''));
  Model := App.RunIterations(Model, UpdateEditor, ViewEditor, 2, 0);
  Test.AssertTrue(Model.ConfirmOpen);
  Test.AssertEquals(YesControlValue, Model.Focused);
  var DialogSurface: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertTrue(Str.Contains(DialogSurface.LineAt(4), ' Confirm '));
  Test.AssertTrue(Str.Contains(DialogSurface.LineAt(5), 'Save changes?'));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, ''));
  Model := App.RunIterations(Model, UpdateEditor, ViewEditor, 1, 0);
  Test.AssertFalse(Model.ConfirmOpen);
  Test.AssertTrue(Model.Saved);
  var BeforeQuit: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Escape, ''));
  Model := App.RunIterations(Model, UpdateEditor, ViewEditor, 1, 0);
  Test.AssertTrue(Model.Quit);
  var AfterQuit: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertEquals(BeforeQuit.LineAt(2), AfterQuit.LineAt(2));
  Test.AssertFalse(Str.Contains(AfterQuit.LineAt(2), 'SHOULD NOT PAINT'));
end program;
