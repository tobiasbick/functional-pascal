program TuiDashboardWidgetsTest;

uses Std.Test as Test;
uses Std.Tui as Tui;

function ViewDashboard(State: integer): Tui.TuiElement;
begin
  var Concrete: Tui.TuiStyle := Tui.TuiStyle.FromColors(Tui.TuiColor.FromRgb(1, 2, 3), Tui.TuiColor.FromRgb(4, 5, 6));
  return Tui.TuiElementBuilders.MakeDesktop(Option.None, [
                                                           Tui.TuiElementBuilders.MakeColumn([
                                                                                               Tui.TuiElementBuilders.MakeCellGrid(Tui.TuiCellGrid.Create(2, 1, [
                                                                                                                                                                  Tui.TuiCell.Styled('A', Concrete),
                                                                                                                                                                  Tui.TuiCell.Create('B', Tui.TuiStyleRole.Accent)
                                                                                                                                                                ])),
                                                                                               Tui.TuiElementBuilders.MakeRule('Metrics'),
                                                                                               Tui.TuiElementBuilders.MakeGauge('Load', 3, 4)
                                                                                             ])
                                                         ]);
end function;

function UpdateDashboard(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 4));
  discard App.RunIterations(0, UpdateDashboard, ViewDashboard, 0, 0);
  var Snapshot: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertEquals('A', Snapshot.CellAt(0, 0).Glyph);
  case Snapshot.CellAt(0, 0).ConcreteStyle of
    when Option.Some(const Style):
      begin
        Test.AssertEquals(2, Style.Foreground.Green);
        Test.AssertEquals(5, Style.Background.Green);
      end;
    when Option.None:
      begin
        panic('expected concrete cell-grid style');
      end;
  end case;

  Test.AssertTrue(Snapshot.CellAt(1, 0).Role = Tui.TuiStyleRole.Accent);
  Test.AssertTrue(Snapshot.CellAt(0, 1).Role = Tui.TuiStyleRole.Rule);
  Test.AssertTrue(Snapshot.CellAt(7, 2).Role = Tui.TuiStyleRole.GaugeFill);
  App.Close();
end program;
