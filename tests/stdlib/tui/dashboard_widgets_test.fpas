program TuiDashboardWidgetsTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Cells as Cells;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

function ViewDashboard(State: integer): Tui.TuiElement;
begin
  const Concrete: Tui.TuiStyle := Cells.TuiStyleFromColors(Cells.TuiColorFromRgb(1, 2, 3), Cells.TuiColorFromRgb(4, 5, 6));
  return Elements.TuiElementMakeDesktop(Option.None, [
                                                       Elements.TuiElementMakeColumn([
                                                                                       Elements.TuiElementMakeCellGrid(Chrome.TuiCellGridCreate(2, 1, [
                                                                                                                                                        Cells.TuiCellStyled('A', Concrete),
                                                                                                                                                        Cells.TuiCellCreate('B', Tui.TuiStyleRole.Accent)
                                                                                                                                                      ])),
                                                                                       Elements.TuiElementMakeRule('Metrics'),
                                                                                       Elements.TuiElementMakeGauge('Load', 3, 4)
                                                                                     ])
                                                     ]);
end function;

function UpdateDashboard(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 4));
  discard Runtime.TuiApplicationRunIterations(App, 0, UpdateDashboard, ViewDashboard, 0, 0);
  const Snapshot: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertEquals('A', Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 0, 0).Glyph);
  case Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 0, 0).ConcreteStyle of
    when Option.Some(const Style):
      begin
        Test.AssertEquals(2, Style.Foreground.Green);
        Test.AssertEquals(5, Style.Background.Green);
      end;
    when Option.None:
      begin
        panic('expected concrete cell-grid style');
      end;
  end case;

  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 1, 0).Role = Tui.TuiStyleRole.Accent);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 0, 1).Role = Tui.TuiStyleRole.Rule);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Snapshot, 7, 2).Role =
                  Tui.TuiStyleRole.GaugeFill);
  Runtime.TuiApplicationClose(App);
end program;
