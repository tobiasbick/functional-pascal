program TuiDialogPointerTest;

uses Std.Str, Std.Test, Std.Tui;

type
  DialogModel = record
    Position: option of TuiPoint;
    DragOffset: option of TuiPoint;
    Changes: integer;
    Closed: boolean;
  end;

function ViewDialog(State: DialogModel): TuiElement;
begin
  mutable var Dialog: TuiElement := TuiElementBuilders.MakeEmpty();
  if not State.Closed then
  begin
    Dialog := TuiElementBuilders.MakeMovableDialog(TuiControlId.Create(1), 'Move', State.Position, State.DragOffset, TuiAction.Create(1), [
                                                                                                                                            TuiElementBuilders.MakeLabel('Body')

                                                                                                                                          ])
  end;
  return TuiElementBuilders.MakeDesktop(None, [
                                                TuiElementBuilders.MakeColumn([

                                                                                TuiElementBuilders.MakeLabel('XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'),

                                                                                TuiElementBuilders.MakeLabel('XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'),

                                                                                TuiElementBuilders.MakeLabel('XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'),

                                                                                TuiElementBuilders.MakeLabel('XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'),

                                                                                TuiElementBuilders.MakeLabel('XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'),

                                                                                TuiElementBuilders.MakeLabel('XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX')



                                                                              ]),
                                                Dialog

                                              ])
end;

function UpdateDialog(State: DialogModel; Msg: TuiMsg; Cmd: TuiCmdOutput): DialogModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.DialogChanged(Source, Action, Position, DragOffset):
    begin
      if (Source.Value = 1) and (Action.Value = 1) then
      begin
        return record
          Position := Some(Position);
          DragOffset := DragOffset;
          Changes := State.Changes + 1;
          Closed := State.Closed;
        end
      end;
      return State
    end;
    TuiMsg.Action(Source, Action):
    begin
      if (Source.Value = 1) and (Action.Value = 1) then
      begin
        mutable var Closed: DialogModel := State;
        Closed.Closed := true;
        return Closed
      end;
      return State
    end;
    TuiMsg.Key(Key), TuiMsg.Pointer(Pointer), TuiMsg.Tick(Delta), TuiMsg.Resize(Size), TuiMsg.FocusChanged(Previous, Current), TuiMsg.TextChanged(Source, Action, Text, Caret), TuiMsg.TextAreaChanged(Source, Action, Text, Caret, TextAreaOffset), TuiMsg.CheckChanged(Source, Action, Checked), TuiMsg.SelectionChanged(Source, Action, Selected), TuiMsg.ScrollChanged(Source, Action, Offset), TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState), TuiMsg.QuitRequested:
    begin
      return State
    end
  end
end;

function MakePointer(Action: TuiPointerAction; X: integer; Y: integer): TuiPointerEvent;
begin
  return TuiPointerEvent.Create(Action, TuiPointerButton.Left, TuiPoint.Create(X, Y))
end;

procedure AssertPosition(Value: option of TuiPoint; X: integer; Y: integer);
begin
  case Value of
    Some(Point):
    begin
      AssertEquals(X, Point.X);
      AssertEquals(Y, Point.Y)
    end;
    None:
    begin
      AssertTrue(false)
    end
  end
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 12));
  mutable var Model: DialogModel := record
    Position := None;
    DragOffset := None;
    Changes := 0;
    Closed := false;
  end;
  Model := App.RunIterations(Model, UpdateDialog, ViewDialog, 0, 0);
  var InitialSurface: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  var CloseX: integer := Std.Str.IndexOf(InitialSurface.LineAt(4), '[■]');
  var DialogX: integer := CloseX - 2;
  var ShadowX: integer := Std.Str.IndexOf(InitialSurface.LineAt(5), '░');
  AssertEquals('░', InitialSurface.CellAt(ShadowX, 5).Glyph);
  AssertTrue(InitialSurface.CellAt(ShadowX, 5).Role = TuiStyleRole.DialogShadow);
  AssertEquals('[', InitialSurface.CellAt(CloseX, 4).Glyph);
  AssertEquals('■', InitialSurface.CellAt(CloseX + 1, 4).Glyph);
  AssertEquals(']', InitialSurface.CellAt(CloseX + 2, 4).Glyph);
  AssertTrue(InitialSurface.CellAt(CloseX, 4).Role = TuiStyleRole.DialogTitle);
  AssertEquals(' ', InitialSurface.CellAt(DialogX + 6, 5).Glyph);
  AssertTrue(InitialSurface.CellAt(DialogX + 6, 5).Role = TuiStyleRole.DialogNormal);
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Down, DialogX + 6, 4));
  Model := App.RunIterations(Model, UpdateDialog, ViewDialog, 1, 0);
  AssertPosition(Model.Position, DialogX, 4);
  AssertPosition(Model.DragOffset, 6, 0);
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Drag, 10, 2));
  Model := App.RunIterations(Model, UpdateDialog, ViewDialog, 1, 0);
  AssertPosition(Model.Position, 4, 2);
  AssertPosition(Model.DragOffset, 6, 0);
  AssertTrue(Std.Str.Contains(App.SurfaceSnapshot().LineAt(2), 'Move'));
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Up, 10, 2));
  Model := App.RunIterations(Model, UpdateDialog, ViewDialog, 1, 0);
  AssertTrue(Model.Changes = 3);
  case Model.DragOffset of
    Some(Point):
    begin
      AssertTrue(false)
    end;
    None:
    begin
    end
  end;
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Down, 10, 2));
  Model := App.RunIterations(Model, UpdateDialog, ViewDialog, 1, 0);
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Drag, 100, 100));
  Model := App.RunIterations(Model, UpdateDialog, ViewDialog, 1, 0);
  AssertPosition(Model.Position, 25, 8);
  AssertEquals('░', App.SurfaceSnapshot().CellAt(39, 11).Glyph);
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Up, 100, 100));
  Model := App.RunIterations(Model, UpdateDialog, ViewDialog, 1, 0);
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Down, 27, 8));
  Model := App.RunIterations(Model, UpdateDialog, ViewDialog, 1, 0);
  AssertTrue(Model.Closed);
  AssertTrue(App.SurfaceSnapshot().CellAt(27, 8).Glyph <> '[');
  App.Close()
end.
