program DuplicateControlIdRuntimeError;

uses Std.Tui as Tui;

function Update(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  return State;
end function;

function View(State: integer): Tui.TuiElement;
begin
  const Id: Tui.TuiControlId := Tui.TuiControlId.Create(1);
  const Action: Tui.TuiAction := Tui.TuiAction.Create(10);
  const SecondId := Tui.TuiControlId.Create(if State = 0 then 2 else 1 end if);
  return Tui.TuiElementBuilders.MakeRow([
    Tui.TuiElementBuilders.MakeButton(Id, 'First', Action),
    Tui.TuiElementBuilders.MakeButton(SecondId, 'Second', Action)
  ]);
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 4));
  discard App.RunIterations(0, Update, View, 0, 0);
  discard App.RunIterations(1, Update, View, 0, 0);
end.
