program DuplicateControlIdRuntimeError;

uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

function Update(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  return State;
end function;

function View(State: integer): Tui.TuiElement;
begin
  const Id: Tui.TuiControlId := Ids.TuiControlIdCreate(1);
  const Action: Tui.TuiAction := Ids.TuiActionCreate(10);
  return Elements.TuiElementMakeRow([
                                      Elements.TuiElementMakeButton(Id, 'First', Action),
                                      Elements.TuiElementMakeButton(Id, 'Second', Action)
                                    ]);
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(20, 4));
  discard Runtime.TuiApplicationRunIterations(App, 0, Update, View, 0, 0);
end program;
