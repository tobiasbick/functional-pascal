program ElementMakeLabelTest;

uses Std.Tui, Std.Test;

begin
  const Node: TuiElement := TuiElementBuilders.MakeLabel('hi');
  case Node of
    when TuiElement.Label(const Text):
      begin
        AssertEquals('hi', Text);
      end;
    else
      begin
        panic('expected label element');
      end;
  end case;
end.
