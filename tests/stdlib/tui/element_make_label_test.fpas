program ElementMakeLabelTest;

uses Std.Tui, Std.Test;

begin
  const Node: TuiElement := TuiElementBuilders.MakeLabel('hi');
  case Node of
    when TuiElement.Label(const Text):
      begin
        AssertEquals('hi', Text);
      end;
    when TuiElement.Empty, TuiElement.Button(_), TuiElement.Input(_), TuiElement.TextArea(_, _, _, _, _), TuiElement.CheckBox(_, _, _, _), TuiElement.List(_, _, _, _), TuiElement.Scroll(_, _, _, _), TuiElement.MenuBar(_), TuiElement.Menu(_, _, _, _), TuiElement.StatusLine(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Row(_, _), TuiElement.Column(_, _), TuiElement.Layout(_, _), TuiElement.Spacer(_), TuiElement.Panel(_, _), TuiElement.Overlay(_, _), TuiElement.Desktop(_, _):
      begin
        panic('expected label element');
      end;
  end case;
end.
