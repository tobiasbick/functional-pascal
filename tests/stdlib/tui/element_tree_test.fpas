program ElementTreeTest;

uses Std.Test, Std.Tui;

function ViewTree(Value: integer): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(None, [
                                                TuiElementBuilders.MakePanel('Dashboard', [
                                                                                            TuiElementBuilders.MakeColumnSpaced([
                                                                                                                                  TuiElementBuilders.MakeRule('Metrics'),
                                                                                                                                  TuiElementBuilders.MakeGauge('Load', 3, 4),
                                                                                                                                  TuiElementBuilders.MakeCellGrid(TuiCellGrid.Create(2, 1, [
                                                                                                                                                                                             TuiCell.Create('A', TuiStyleRole.Normal),
                                                                                                                                                                                             TuiCell.Create('B', TuiStyleRole.Accent)
                                                                                                                                                                                           ]))
                                                                                                                                ], 1)
                                                                                          ]),
                                                TuiElementBuilders.MakeOverlay('Confirm', [TuiElementBuilders.MakeLabel('Continue?')])
                                              ]);
end function;

function UpdateTree(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  Cmd.Set(TuiCmd.NoCommand);
  return State;
end function;

begin
  const Tree: TuiElement := ViewTree(0);
  if Tree is TuiElement.Desktop(const Focused, const DesktopChildren) then
    begin
      AssertEquals(2, DesktopChildren.Length());
      if DesktopChildren[0] is TuiElement.Panel(const Title, const PanelChildren) then
        begin
          AssertEquals('Dashboard', Title);
          AssertEquals(1, PanelChildren.Length());
        end;
      else
        begin
          panic('expected panel element');
        end;
      end if;

      if DesktopChildren[1] is TuiElement.Overlay(const Title, const OverlayChildren) then
        begin
          AssertEquals('Confirm', Title);
          AssertEquals(1, OverlayChildren.Length());
        end;
      else
        begin
          panic('expected overlay element');
        end;
      end if;
    end;
  else
    begin
      panic('expected desktop element');
    end;
  end if;
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(30, 10));
  AssertEquals(0, App.RunIterations(0, UpdateTree, ViewTree, 0, 0));
  App.Close();
end.
