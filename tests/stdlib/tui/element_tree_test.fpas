program ElementTreeTest;

uses Std.Test, Std.Tui;

function ViewTree(Value: integer): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(None, [
                                                TuiElementBuilders.MakePanel('Dashboard', [
                                                                                            TuiElementBuilders.MakeColumnSpaced([
                                                                                                                                  TuiElementBuilders.MakeRule('Metrics'),
                                                                                                                                  TuiElementBuilders.MakeGauge('Load', 3, 4),
                                                                                                                                  TuiElementBuilders.MakeCellGrid(TuiCellGrid.Create(2, 1, [
                                                                                                                                                                                             TuiCell.Create('A', TuiStyleRole.Normal),
                                                                                                                                                                                             TuiCell.Create('B', TuiStyleRole.Accent)
                                                                                                                                                                                           ]))
                                                                                                                                ], 1)
                                                                                          ]),
                                                TuiElementBuilders.MakeOverlay('Confirm', [TuiElementBuilders.MakeLabel('Continue?')])
                                              ]);
end function;

function UpdateTree(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  Cmd.Set(TuiCmd.NoCommand);
  return State;
end function;

begin
  const Tree: TuiElement := ViewTree(0);
  case Tree of
    when TuiElement.Desktop(const Focused, const DesktopChildren):
      begin
        AssertEquals(2, DesktopChildren.Length());
        case DesktopChildren[0] of
          when TuiElement.Panel(const Title, const PanelChildren):
            begin
              AssertEquals('Dashboard', Title);
              AssertEquals(1, PanelChildren.Length());
            end;
          when TuiElement.Empty, TuiElement.Label(_), TuiElement.Button(_), TuiElement.Input(_), TuiElement.TextArea(_, _, _, _, _), TuiElement.CheckBox(_, _, _, _), TuiElement.List(_, _, _, _), TuiElement.Scroll(_, _, _, _), TuiElement.MenuBar(_), TuiElement.Menu(_, _, _, _), TuiElement.StatusLine(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Row(_, _), TuiElement.Column(_, _), TuiElement.Layout(_, _), TuiElement.Spacer(_), TuiElement.Overlay(_, _), TuiElement.Desktop(_, _):
            begin
              panic('expected panel element');
            end;
        end case;

        case DesktopChildren[1] of
          when TuiElement.Overlay(const Title, const OverlayChildren):
            begin
              AssertEquals('Confirm', Title);
              AssertEquals(1, OverlayChildren.Length());
            end;
          when TuiElement.Empty, TuiElement.Label(_), TuiElement.Button(_), TuiElement.Input(_), TuiElement.TextArea(_, _, _, _, _), TuiElement.CheckBox(_, _, _, _), TuiElement.List(_, _, _, _), TuiElement.Scroll(_, _, _, _), TuiElement.MenuBar(_), TuiElement.Menu(_, _, _, _), TuiElement.StatusLine(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Row(_, _), TuiElement.Column(_, _), TuiElement.Layout(_, _), TuiElement.Spacer(_), TuiElement.Panel(_, _), TuiElement.Desktop(_, _):
            begin
              panic('expected overlay element');
            end;
        end case;
      end;
    when TuiElement.Empty, TuiElement.Label(_), TuiElement.Button(_), TuiElement.Input(_), TuiElement.TextArea(_, _, _, _, _), TuiElement.CheckBox(_, _, _, _), TuiElement.List(_, _, _, _), TuiElement.Scroll(_, _, _, _), TuiElement.MenuBar(_), TuiElement.Menu(_, _, _, _), TuiElement.StatusLine(_), TuiElement.CellGrid(_), TuiElement.Rule(_), TuiElement.Gauge(_), TuiElement.Row(_, _), TuiElement.Column(_, _), TuiElement.Layout(_, _), TuiElement.Spacer(_), TuiElement.Panel(_, _), TuiElement.Overlay(_, _):
      begin
        panic('expected desktop element');
      end;
  end case;
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(30, 10));
  AssertEquals(0, App.RunIterations(0, UpdateTree, ViewTree, 0, 0));
  App.Close();
end.
