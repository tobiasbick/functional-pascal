program TuiFocusHelpersTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Layout as Layout;

begin
  const Tree: Tui.TuiElement := Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(2)), [
                                                                                                         Elements.TuiElementMakePanel('Host', [
                                                                                                                                                Elements.TuiElementMakeColumn([
                                                                                                                                                                                Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(1), 'One', Ids.TuiActionCreate(1)),
                                                                                                                                                                                Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(2), 'Two', 0, Geometry.TuiPointCreate(0, 0), Ids.TuiActionCreate(2))
                                                                                                                                                                              ])
                                                                                                                                              ]),
                                                                                                         Elements.TuiElementMakeOverlay('Modal', [
                                                                                                                                                   Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(3), 'Yes', Ids.TuiActionCreate(3))
                                                                                                                                                 ])
                                                                                                       ]);
  case Tui.TuiFocusFirst(Tree) of
    when Option.Some(const Id):
      begin
        Test.AssertEquals(3, Id.Value);
      end;
    when Option.None:
      begin
        panic('expected modal focus');
      end;
  end case;

  case Tui.TuiFocusResolve(Tree, Option.Some(Ids.TuiControlIdCreate(1))) of
    when Option.Some(const Id):
      begin
        Test.AssertEquals(3, Id.Value);
      end;
    when Option.None:
      begin
        panic('expected modal resolve');
      end;
  end case;

  case Tui.TuiFocusResolve(Tree, Option.Some(Ids.TuiControlIdCreate(3))) of
    when Option.Some(const Id):
      begin
        Test.AssertEquals(3, Id.Value);
      end;
    when Option.None:
      begin
        panic('expected kept modal focus');
      end;
  end case;
  const HostOnly: Tui.TuiElement := Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(2)), [
                                                                                                             Elements.TuiElementMakePanel('Host', [
                                                                                                                                                    Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(1), 'One', Ids.TuiActionCreate(1)),
                                                                                                                                                    Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(2), 'Two', Ids.TuiActionCreate(2))
                                                                                                                                                  ])
                                                                                                           ]);
  case Tui.TuiFocusResolve(HostOnly, Option.Some(Ids.TuiControlIdCreate(2))) of
    when Option.Some(const Id):
      begin
        Test.AssertEquals(2, Id.Value);
      end;
    when Option.None:
      begin
        panic('expected host focus');
      end;
  end case;

  case Tui.TuiFocusResolve(HostOnly, Option.Some(Ids.TuiControlIdCreate(9))) of
    when Option.Some(const Id):
      begin
        Test.AssertEquals(1, Id.Value);
      end;
    when Option.None:
      begin
        panic('expected fallback focus');
      end;
  end case;
  const Fit: Tui.TuiLayoutFit := Tui.TuiLayoutFitFor(HostOnly, Geometry.TuiSizeCreate(80, 24));
  Test.AssertTrue(Layout.TuiLayoutFitFits(Fit));
end program;
