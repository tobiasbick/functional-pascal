program TuiGeometryValuesTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Geometry as Geometry;

begin
  const Point: Tui.TuiPoint := Geometry.TuiPointCreate(5, 7);
  Test.AssertEquals(5, Point.X);
  Test.AssertEquals(7, Point.Y);
  const Size: Tui.TuiSize := Geometry.TuiSizeCreate(12, 4);
  Test.AssertFalse(Geometry.TuiSizeIsEmpty(Size));
  const EmptySize: Tui.TuiSize := Geometry.TuiSizeCreate(0, 4);
  Test.AssertTrue(Geometry.TuiSizeIsEmpty(EmptySize));
  const ZeroHeight: Tui.TuiSize := Geometry.TuiSizeCreate(3, 0);
  Test.AssertTrue(Geometry.TuiSizeIsEmpty(ZeroHeight));
  const Bounds: Tui.TuiRect := Geometry.TuiRectCreate(2, 3, 8, 5);
  Test.AssertEquals(10, Geometry.TuiRectRight(Bounds));
  Test.AssertEquals(8, Geometry.TuiRectBottom(Bounds));
  Test.AssertFalse(Geometry.TuiRectIsEmpty(Bounds));
  Test.AssertTrue(Geometry.TuiRectContains(Bounds, Geometry.TuiPointCreate(2, 3)));
  Test.AssertTrue(Geometry.TuiRectContains(Bounds, Geometry.TuiPointCreate(9, 7)));
  Test.AssertFalse(Geometry.TuiRectContains(Bounds, Geometry.TuiPointCreate(10, 7)));
  Test.AssertFalse(Geometry.TuiRectContains(Bounds, Geometry.TuiPointCreate(9, 8)));
  Test.AssertFalse(Geometry.TuiRectContains(Bounds, Geometry.TuiPointCreate(1, 3)));
  Test.AssertFalse(Geometry.TuiRectContains(Bounds, Geometry.TuiPointCreate(2, 2)));
  const Edges: Tui.TuiRect := Geometry.TuiRectFromEdges(2, 3, 10, 8);
  Test.AssertEquals(8, Edges.Width);
  Test.AssertEquals(5, Edges.Height);
  const PointSize: Tui.TuiRect := Geometry.TuiRectFromPointSize(Geometry.TuiPointCreate(2, 3), Geometry.TuiSizeCreate(8, 5));
  Test.AssertEquals(10, Geometry.TuiRectRight(PointSize));
  Test.AssertEquals(8, Geometry.TuiRectBottom(PointSize));
  const Corners: Tui.TuiRect := Geometry.TuiRectFromCorners(Geometry.TuiPointCreate(2, 3), Geometry.TuiPointCreate(10, 8));
  Test.AssertEquals(5, Corners.Height);
  const Overlap: Tui.TuiRect := Geometry.TuiRectIntersect(Bounds, Geometry.TuiRectCreate(6, 1, 8, 6));
  Test.AssertEquals(6, Overlap.X);
  Test.AssertEquals(3, Overlap.Y);
  Test.AssertEquals(4, Overlap.Width);
  Test.AssertEquals(4, Overlap.Height);
  Test.AssertTrue(Geometry.TuiRectIntersects(Bounds, Overlap));
  const Empty: Tui.TuiRect := Geometry.TuiRectIntersect(Bounds, Geometry.TuiRectCreate(10, 3, 2, 2));
  Test.AssertTrue(Geometry.TuiRectIsEmpty(Empty));
  Test.AssertFalse(Geometry.TuiRectIntersects(Bounds, Geometry.TuiRectCreate(10, 3, 2, 2)));
  const Inset: Tui.TuiRect := Geometry.TuiRectInset(Bounds);
  Test.AssertEquals(3, Inset.X);
  Test.AssertEquals(4, Inset.Y);
  Test.AssertEquals(6, Inset.Width);
  Test.AssertEquals(3, Inset.Height);
  const Thin: Tui.TuiRect := Geometry.TuiRectInset(Geometry.TuiRectCreate(0, 0, 1, 1));
  Test.AssertTrue(Geometry.TuiRectIsEmpty(Thin));
  const EmptyInset: Tui.TuiRect := Geometry.TuiRectInset(Geometry.TuiRectCreate(4, 5, 0, 2));
  Test.AssertTrue(Geometry.TuiRectIsEmpty(EmptyInset));
end program;
