program TuiGeometryValuesTest;

uses Std.Test as Test, Std.Tui as Tui;

begin
  const Point: Tui.TuiPoint := Tui.TuiPoint.Create(5, 7);
  Test.AssertEquals(5, Point.X);
  Test.AssertEquals(7, Point.Y);
  const Size: Tui.TuiSize := Tui.TuiSize.Create(12, 4);
  Test.AssertFalse(Size.IsEmpty());
  const EmptySize: Tui.TuiSize := Tui.TuiSize.Create(0, 4);
  Test.AssertTrue(EmptySize.IsEmpty());
  const ZeroHeight: Tui.TuiSize := Tui.TuiSize.Create(3, 0);
  Test.AssertTrue(ZeroHeight.IsEmpty());
  const Bounds: Tui.TuiRect := Tui.TuiRect.Create(2, 3, 8, 5);
  Test.AssertEquals(10, Bounds.Right());
  Test.AssertEquals(8, Bounds.Bottom());
  Test.AssertFalse(Bounds.IsEmpty());
  Test.AssertTrue(Bounds.Contains(Tui.TuiPoint.Create(2, 3)));
  Test.AssertTrue(Bounds.Contains(Tui.TuiPoint.Create(9, 7)));
  Test.AssertFalse(Bounds.Contains(Tui.TuiPoint.Create(10, 7)));
  Test.AssertFalse(Bounds.Contains(Tui.TuiPoint.Create(9, 8)));
  Test.AssertFalse(Bounds.Contains(Tui.TuiPoint.Create(1, 3)));
  Test.AssertFalse(Bounds.Contains(Tui.TuiPoint.Create(2, 2)));
  const Edges: Tui.TuiRect := Tui.TuiRect.FromEdges(2, 3, 10, 8);
  Test.AssertEquals(8, Edges.Width);
  Test.AssertEquals(5, Edges.Height);
  const PointSize: Tui.TuiRect := Tui.TuiRect.FromPointSize(
    Tui.TuiPoint.Create(2, 3),
    Tui.TuiSize.Create(8, 5)
  );
  Test.AssertEquals(10, PointSize.Right());
  Test.AssertEquals(8, PointSize.Bottom());
  const Corners: Tui.TuiRect := Tui.TuiRect.FromCorners(
    Tui.TuiPoint.Create(2, 3),
    Tui.TuiPoint.Create(10, 8)
  );
  Test.AssertEquals(5, Corners.Height);
  const Overlap: Tui.TuiRect := Bounds.Intersect(Tui.TuiRect.Create(6, 1, 8, 6));
  Test.AssertEquals(6, Overlap.X);
  Test.AssertEquals(3, Overlap.Y);
  Test.AssertEquals(4, Overlap.Width);
  Test.AssertEquals(4, Overlap.Height);
  Test.AssertTrue(Bounds.Intersects(Overlap));
  const Empty: Tui.TuiRect := Bounds.Intersect(Tui.TuiRect.Create(10, 3, 2, 2));
  Test.AssertTrue(Empty.IsEmpty());
  Test.AssertFalse(Bounds.Intersects(Tui.TuiRect.Create(10, 3, 2, 2)));
  const EmptyWidth: Tui.TuiRect := Tui.TuiRect.Create(5, 5, 0, 1);
  const EmptyHeight: Tui.TuiRect := Tui.TuiRect.Create(5, 5, 1, 0);
  const EmptyPoint: Tui.TuiRect := Tui.TuiRect.Create(5, 5, 0, 0);
  for InteriorEmpty: Tui.TuiRect in [EmptyWidth, EmptyHeight, EmptyPoint] do
    Test.AssertTrue(InteriorEmpty.IsEmpty());
    Test.AssertFalse(Bounds.Intersects(InteriorEmpty));
    Test.AssertFalse(InteriorEmpty.Intersects(Bounds));
    Test.AssertFalse(InteriorEmpty.Intersects(InteriorEmpty));
    Test.AssertTrue(Bounds.Intersect(InteriorEmpty).IsEmpty());
    Test.AssertTrue(InteriorEmpty.Intersect(Bounds).IsEmpty());
  end for;
  const Inset: Tui.TuiRect := Bounds.Inset();
  Test.AssertEquals(3, Inset.X);
  Test.AssertEquals(4, Inset.Y);
  Test.AssertEquals(6, Inset.Width);
  Test.AssertEquals(3, Inset.Height);
  const Thin: Tui.TuiRect := Tui.TuiRect.Create(0, 0, 1, 1).Inset();
  Test.AssertTrue(Thin.IsEmpty());
  const EmptyInset: Tui.TuiRect := Tui.TuiRect.Create(4, 5, 0, 2).Inset();
  Test.AssertTrue(EmptyInset.IsEmpty());
end.
