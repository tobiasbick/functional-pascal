program TuiHierarchicalMenuTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type MenuModel = record
  Focus: integer;
  Menu: Tui.TuiMenuState;
  Actions: array of (integer);
end record;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string; Ctrl: boolean; Alt: boolean): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := Ctrl, alt := Alt, meta := false);
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const X: integer := Str.IndexOf(Rendering.TuiSurfaceSnapshotLineAt(Snapshot, Y), Glyph);
      if X >= 0 then
        begin
          return Geometry.TuiPointCreate(X, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in menu snapshot: ' + Glyph);
end function;

procedure AssertActive(Menu: Tui.TuiMenuState; Expected: integer);
begin
  case Menu.Active of
    when Option.Some(const Id):
      begin
        Test.AssertEquals(Expected, Id.Value);
      end;
    when Option.None:
      begin
        Test.Fail('Expected an active menu node.');
      end;
  end case;
end procedure;

function MenuNodes(): array of (Tui.TuiMenuNode);
begin
  const FileId: Tui.TuiMenuNodeId := Chrome.TuiMenuNodeIdCreate(1);
  const OptionsId: Tui.TuiMenuNodeId := Chrome.TuiMenuNodeIdCreate(2);
  const ThemeId: Tui.TuiMenuNodeId := Chrome.TuiMenuNodeIdCreate(5);
  return [
           Chrome.TuiMenuNodeSubmenu(FileId, Option.None, 'File', 'F'),
           Chrome.TuiMenuNodeSubmenu(OptionsId, Option.None, 'Options', 'O'),
           Chrome.TuiMenuNodeCommandWithShortcut(Chrome.TuiMenuNodeIdCreate(3), Option.Some(FileId), 'Open', 'O', Ids.TuiActionCreate(10), Chrome.TuiKeyGestureCreate(Tui.TuiKeyKind.Character, 'o', false, true, false, false, 'Ctrl+O')),
           Chrome.TuiMenuNodeSeparator(Chrome.TuiMenuNodeIdCreate(4), FileId),
           Chrome.TuiMenuNodeSubmenu(ThemeId, Option.Some(OptionsId), 'Theme', 'T'),
           Chrome.TuiMenuNodeCommand(Chrome.TuiMenuNodeIdCreate(6), Option.Some(ThemeId), 'Dark', 'D', Ids.TuiActionCreate(20))
         ];
end function;

function ViewMenu(State: MenuModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakeMenu(Ids.TuiControlIdCreate(100), MenuNodes(), State.Menu, Ids.TuiActionCreate(101))
                                                                                          ]);
end function;

function UpdateMenu(State: MenuModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): MenuModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return MenuModel(Focus := Id.Value, Menu := State.Menu, Actions := State.Actions);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.MenuChanged(const Source, const Action, const Menu):
      begin
        return MenuModel(Focus := State.Focus, Menu := Menu, Actions := State.Actions);
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return MenuModel(Focus := State.Focus, Menu := State.Menu, Actions := Arrays.Concat(State.Actions, [
                                                                                                             Action.Value
                                                                                                           ]));
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(40, 10));
  var Model: MenuModel := MenuModel(Focus := 100, Menu := Chrome.TuiMenuStateClosed(), Actions := []);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 0, 0);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), 7, 0).Role =
                  Tui.TuiStyleRole.MenuShortcut);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), 11, 0).Role =
                  Tui.TuiStyleRole.MenuNormal);
  const ClosedFileAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(App), 'File');
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, ClosedFileAt));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertFalse(Model.Menu.Open);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.F10, '', false, false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertTrue(Model.Menu.Open);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 2), 'Open'));
  Test.AssertFalse(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), 16, 2).Glyph =
                   '░');
  Test.AssertFalse(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), 2, 5).Glyph =
                   '░');
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(10, Model.Actions[0]);
  Test.AssertFalse(Model.Menu.Open);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Character, 'o', true, false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertEquals(2, Arrays.Length(Model.Actions));
  Test.AssertEquals(10, Model.Actions[1]);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Character, 'o', false, true));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Right, '', false, false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertEquals(3, Arrays.Length(Model.Actions));
  Test.AssertEquals(20, Model.Actions[2]);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.F10, '', false, false));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  const OptionsAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(App), 'Options');
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, OptionsAt));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  AssertActive(Model.Menu, 2);
  const ThemeAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(App), 'Theme');
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, ThemeAt));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  AssertActive(Model.Menu, 5);
  const DarkAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(App), 'Dark');
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, DarkAt));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  AssertActive(Model.Menu, 6);
  Test.AssertFalse(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), DarkAt.X +
                                                                                                  6, DarkAt.Y).Glyph =
                   '░');
  Test.AssertFalse(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), DarkAt.X, DarkAt.Y +
                                                                                                            2).Glyph =
                   '░');
  Test.AssertEquals(3, Arrays.Length(Model.Actions));
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, Geometry.TuiPointCreate(39, 9)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertTrue(Model.Menu.Open);
  AssertActive(Model.Menu, 6);
  Test.AssertEquals(3, Arrays.Length(Model.Actions));
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, DarkAt));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertFalse(Model.Menu.Open);
  Test.AssertEquals(4, Arrays.Length(Model.Actions));
  Test.AssertEquals(20, Model.Actions[3]);
  Runtime.TuiApplicationClose(App);
end program;
