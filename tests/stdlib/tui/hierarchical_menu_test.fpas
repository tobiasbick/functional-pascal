program TuiHierarchicalMenuTest;

uses Std.Test, Std.Tui;

type MenuModel = record
  Focus: integer;
  Menu: TuiMenuState;
  Actions: array of integer;
end record;

function MakeKey(Kind: TuiKeyKind; Character: string; Ctrl: boolean; Alt: boolean): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := Ctrl, alt := Alt, meta := false);
end function;

function FindGlyph(Snapshot: TuiSurfaceSnapshot; Glyph: string): TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const X: integer := Snapshot.LineAt(Y).IndexOf(Glyph);
      if X >= 0 then
        begin
          return TuiPoint.Create(X, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in menu snapshot: ' + Glyph);
end function;

procedure AssertActive(Menu: TuiMenuState; Expected: integer);
begin
  case Menu.Active of
    when Some(const Id):
      begin
        AssertEquals(Expected, Id.Value);
      end;
    when None:
      begin
        Fail('Expected an active menu node.');
      end;
  end case;
end procedure;

function MenuNodes(): array of TuiMenuNode;
begin
  const FileId: TuiMenuNodeId := TuiMenuNodeId.Create(1);
  const OptionsId: TuiMenuNodeId := TuiMenuNodeId.Create(2);
  const ThemeId: TuiMenuNodeId := TuiMenuNodeId.Create(5);
  return [
           TuiMenuNodeBuilders.Submenu(FileId, None, 'File', 'F'),
           TuiMenuNodeBuilders.Submenu(OptionsId, None, 'Options', 'O'),
           TuiMenuNodeBuilders.CommandWithShortcut(TuiMenuNodeId.Create(3), Some(FileId), 'Open', 'O', TuiAction.Create(10), TuiKeyGesture.Create(TuiKeyKind.Character, 'o', false, true, false, false, 'Ctrl+O')),
           TuiMenuNodeBuilders.Separator(TuiMenuNodeId.Create(4), FileId),
           TuiMenuNodeBuilders.Submenu(ThemeId, Some(OptionsId), 'Theme', 'T'),
           TuiMenuNodeBuilders.Command(TuiMenuNodeId.Create(6), Some(ThemeId), 'Dark', 'D', TuiAction.Create(20))
         ];
end function;

function ViewMenu(State: MenuModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakeMenu(TuiControlId.Create(100), MenuNodes(), State.Menu, TuiAction.Create(101))
                                                                                ]);
end function;

function UpdateMenu(State: MenuModel; Msg: TuiMsg; Cmd: TuiCmdOutput): MenuModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return MenuModel(Focus := Id.Value, Menu := State.Menu, Actions := State.Actions);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.MenuChanged(const Source, const Action, const Menu):
      begin
        return MenuModel(Focus := State.Focus, Menu := Menu, Actions := State.Actions);
      end;
    when TuiMsg.Action(const Source, const Action):
      begin
        return MenuModel(Focus := State.Focus, Menu := State.Menu, Actions := State.Actions.Concat([
                                                                                                     Action.Value
                                                                                                   ]));
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 10));
  var Model: MenuModel := MenuModel(Focus := 100, Menu := TuiMenuState.Closed(), Actions := []);
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 0, 0);
  AssertTrue(App.SurfaceSnapshot().CellAt(7, 0).Role = TuiStyleRole.MenuShortcut);
  AssertTrue(App.SurfaceSnapshot().CellAt(11, 0).Role = TuiStyleRole.MenuNormal);
  const ClosedFileAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'File');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, ClosedFileAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertFalse(Model.Menu.Open);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.F10, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertTrue(Model.Menu.Open);
  AssertTrue(App.SurfaceSnapshot().LineAt(2).Contains('Open'));
  AssertFalse(App.SurfaceSnapshot().CellAt(16, 2).Glyph = '░');
  AssertFalse(App.SurfaceSnapshot().CellAt(2, 5).Glyph = '░');
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  AssertEquals(1, Model.Actions.Length());
  AssertEquals(10, Model.Actions[0]);
  AssertFalse(Model.Menu.Open);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'o', true, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  AssertEquals(2, Model.Actions.Length());
  AssertEquals(10, Model.Actions[1]);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'o', false, true));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Right, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  AssertEquals(3, Model.Actions.Length());
  AssertEquals(20, Model.Actions[2]);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.F10, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  const OptionsAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Options');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, OptionsAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertActive(Model.Menu, 2);
  const ThemeAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Theme');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, ThemeAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertActive(Model.Menu, 5);
  const DarkAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Dark');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, DarkAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertActive(Model.Menu, 6);
  AssertFalse(App.SurfaceSnapshot().CellAt(DarkAt.X + 6, DarkAt.Y).Glyph = '░');
  AssertFalse(App.SurfaceSnapshot().CellAt(DarkAt.X, DarkAt.Y + 2).Glyph = '░');
  AssertEquals(3, Model.Actions.Length());
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, TuiPoint.Create(39, 9)));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertTrue(Model.Menu.Open);
  AssertActive(Model.Menu, 6);
  AssertEquals(3, Model.Actions.Length());
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, DarkAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  AssertFalse(Model.Menu.Open);
  AssertEquals(4, Model.Actions.Length());
  AssertEquals(20, Model.Actions[3]);
  App.Close();
end.
