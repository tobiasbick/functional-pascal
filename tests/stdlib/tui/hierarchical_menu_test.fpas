program TuiHierarchicalMenuTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type MenuModel = record
  Focus: integer;
  Menu: Tui.TuiMenuState;
  Actions: array of (integer);
end record;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string; Ctrl: boolean; Alt: boolean): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := Ctrl, alt := Alt, meta := false);
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      var X: integer := Str.IndexOf(Snapshot.LineAt(Y), Glyph);
      if X >= 0 then
        begin
          return Tui.TuiPoint.Create(X, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in menu snapshot: ' + Glyph);
end function;

procedure AssertActive(Menu: Tui.TuiMenuState; Expected: integer);
begin
  case Menu.Active of
    when Option.Some(const Id):
      begin
        Test.AssertEquals(Expected, Id.Value);
      end;
    when Option.None:
      begin
        Test.Fail('Expected an active menu node.');
      end;
  end case;
end procedure;

function MenuNodes(): array of (Tui.TuiMenuNode);
begin
  var FileId: Tui.TuiMenuNodeId := Tui.TuiMenuNodeId.Create(1);
  var OptionsId: Tui.TuiMenuNodeId := Tui.TuiMenuNodeId.Create(2);
  var ThemeId: Tui.TuiMenuNodeId := Tui.TuiMenuNodeId.Create(5);
  return [
           Tui.TuiMenuNodeBuilders.Submenu(FileId, Option.None, 'File', 'F'),
           Tui.TuiMenuNodeBuilders.Submenu(OptionsId, Option.None, 'Options', 'O'),
           Tui.TuiMenuNodeBuilders.CommandWithShortcut(Tui.TuiMenuNodeId.Create(3), Option.Some(FileId), 'Open', 'O', Tui.TuiAction.Create(10), Tui.TuiKeyGesture.Create(Tui.TuiKeyKind.Character, 'o', false, true, false, false, 'Ctrl+O')),
           Tui.TuiMenuNodeBuilders.Separator(Tui.TuiMenuNodeId.Create(4), FileId),
           Tui.TuiMenuNodeBuilders.Submenu(ThemeId, Option.Some(OptionsId), 'Theme', 'T'),
           Tui.TuiMenuNodeBuilders.Command(Tui.TuiMenuNodeId.Create(6), Option.Some(ThemeId), 'Dark', 'D', Tui.TuiAction.Create(20))
         ];
end function;

function ViewMenu(State: MenuModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Option.Some(Tui.TuiControlId.Create(State.Focus)), [
                                                                                                 Tui.TuiElementBuilders.MakeMenu(Tui.TuiControlId.Create(100), MenuNodes(), State.Menu, Tui.TuiAction.Create(101))
                                                                                               ]);
end function;

function UpdateMenu(State: MenuModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): MenuModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return MenuModel(Focus := Id.Value, Menu := State.Menu, Actions := State.Actions);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.MenuChanged(const Source, const Action, const Menu):
      begin
        return MenuModel(Focus := State.Focus, Menu := Menu, Actions := State.Actions);
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return MenuModel(Focus := State.Focus, Menu := State.Menu, Actions := Arrays.Concat(State.Actions, [
                                                                                                             Action.Value
                                                                                                           ]));
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(40, 10));
  mutable var Model: MenuModel := MenuModel(Focus := 100, Menu := Tui.TuiMenuState.Closed(), Actions := []);
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 0, 0);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(7, 0).Role = Tui.TuiStyleRole.MenuShortcut);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(11, 0).Role = Tui.TuiStyleRole.MenuNormal);
  var ClosedFileAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'File');
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, ClosedFileAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertFalse(Model.Menu.Open);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.F10, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertTrue(Model.Menu.Open);
  Test.AssertTrue(Str.Contains(App.SurfaceSnapshot().LineAt(2), 'Open'));
  Test.AssertFalse(App.SurfaceSnapshot().CellAt(16, 2).Glyph = '░');
  Test.AssertFalse(App.SurfaceSnapshot().CellAt(2, 5).Glyph = '░');
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(10, Model.Actions[0]);
  Test.AssertFalse(Model.Menu.Open);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'o', true, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertEquals(2, Arrays.Length(Model.Actions));
  Test.AssertEquals(10, Model.Actions[1]);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'o', false, true));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Right, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertEquals(3, Arrays.Length(Model.Actions));
  Test.AssertEquals(20, Model.Actions[2]);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.F10, '', false, false));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  var OptionsAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Options');
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, OptionsAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertActive(Model.Menu, 2);
  var ThemeAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Theme');
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, ThemeAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertActive(Model.Menu, 5);
  var DarkAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Dark');
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, DarkAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertActive(Model.Menu, 6);
  Test.AssertFalse(App.SurfaceSnapshot().CellAt(DarkAt.X + 6, DarkAt.Y).Glyph = '░');
  Test.AssertFalse(App.SurfaceSnapshot().CellAt(DarkAt.X, DarkAt.Y + 2).Glyph = '░');
  Test.AssertEquals(3, Arrays.Length(Model.Actions));
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Move, Tui.TuiPointerButton.NoButton, Tui.TuiPoint.Create(39, 9)));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertTrue(Model.Menu.Open);
  AssertActive(Model.Menu, 6);
  Test.AssertEquals(3, Arrays.Length(Model.Actions));
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, DarkAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertFalse(Model.Menu.Open);
  Test.AssertEquals(4, Arrays.Length(Model.Actions));
  Test.AssertEquals(20, Model.Actions[3]);
  App.Close();
end program;
