program TuiInputKeyboardTest;

uses Std.Test as Test;
uses Std.Tui as Tui;

type InputKeyboardModel = record
  Text: string;
  Caret: integer;
  UseHistory: boolean;
  KeyHits: integer;
end record;

function MakeKey(Kind: Tui.TuiKeyKind; Ctrl: boolean): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := Ctrl, alt := false, meta := false);
end function;

function ViewInput(State: InputKeyboardModel): Tui.TuiElement;
begin
  mutable var Input: Tui.TuiElement := Tui.TuiElementBuilders.MakeInputWithHint(Tui.TuiControlId.Create(1), State.Text, State.Caret, 'Command', Tui.TuiAction.Create(1));
  if State.UseHistory then
    begin
      Input := Tui.TuiElementBuilders.MakeHistoryInput(Tui.TuiControlId.Create(1), State.Text, State.Caret, 'Command', [
                                                                                                                         'first',
                                                                                                                         'second'
                                                                                                                       ], 'draft', Tui.TuiAction.Create(1));
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(Option.Some(Tui.TuiControlId.Create(1)), [Input]);
end function;

function UpdateInput(State: InputKeyboardModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): InputKeyboardModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        return InputKeyboardModel(Text := Text, Caret := Caret, UseHistory := State.UseHistory, KeyHits := State.KeyHits);
      end;
    when Tui.TuiMsg.Key(const Key):
      begin
        return InputKeyboardModel(Text := State.Text, Caret := State.Caret, UseHistory := State.UseHistory, KeyHits := State.KeyHits +
                                                                                                                       1);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function Press(
  App: Tui.TuiApplication;
  State: InputKeyboardModel;
  Kind: Tui.TuiKeyKind;
  Ctrl: boolean
): InputKeyboardModel;
begin
  App.InjectKeyForTest(MakeKey(Kind, Ctrl));
  return App.RunIterations(State, UpdateInput, ViewInput, 1, 0);
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 2));
  mutable var Model: InputKeyboardModel := InputKeyboardModel(Text := 'alpha beta', Caret := 10, UseHistory := false, KeyHits := 0);
  Model := App.RunIterations(Model, UpdateInput, ViewInput, 0, 0);
  Model := Press(App, Model, Tui.TuiKeyKind.Left, true);
  Test.AssertEquals(6, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.Backspace, true);
  Test.AssertEquals('beta', Model.Text);
  Test.AssertEquals(0, Model.Caret);
  Model := InputKeyboardModel(Text := 'alpha beta', Caret := 0, UseHistory := false, KeyHits := 0);
  Model := App.RunIterations(Model, UpdateInput, ViewInput, 0, 0);
  Model := Press(App, Model, Tui.TuiKeyKind.Delete, true);
  Test.AssertEquals('beta', Model.Text);
  Test.AssertEquals(0, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.Up, false);
  Test.AssertEquals(1, Model.KeyHits);
  Model := InputKeyboardModel(Text := 'draft', Caret := 5, UseHistory := true, KeyHits := 0);
  Model := App.RunIterations(Model, UpdateInput, ViewInput, 0, 0);
  Model := Press(App, Model, Tui.TuiKeyKind.Up, false);
  Test.AssertEquals('second', Model.Text);
  Model := Press(App, Model, Tui.TuiKeyKind.Up, false);
  Test.AssertEquals('first', Model.Text);
  Model := Press(App, Model, Tui.TuiKeyKind.Up, false);
  Test.AssertEquals('first', Model.Text);
  Test.AssertEquals(0, Model.KeyHits);
  Model := Press(App, Model, Tui.TuiKeyKind.Down, false);
  Test.AssertEquals('second', Model.Text);
  Model := Press(App, Model, Tui.TuiKeyKind.Down, false);
  Test.AssertEquals('draft', Model.Text);
  Test.AssertEquals(5, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.Down, false);
  Test.AssertEquals('draft', Model.Text);
  Test.AssertEquals(0, Model.KeyHits);
  App.Close();
end program;
