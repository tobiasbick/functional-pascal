program TuiInputPointerTest;

uses Std.Test, Std.Tui;

type
  InputPointerModel = record
    FirstText: string;
    FirstCaret: integer;
    SecondText: string;
    SecondCaret: integer;
    LastSource: integer;
    LastAction: integer;
  end;

function ViewInput(State: InputPointerModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakeColumn([
                                                                                                        TuiElementBuilders.MakeInput(TuiControlId.Create(1), State.FirstText, State.FirstCaret, TuiAction.Create(11)),
                                                                                                        TuiElementBuilders.MakeInput(TuiControlId.Create(2), State.SecondText, State.SecondCaret, TuiAction.Create(22))
                                                                                                      ])
                                                                      ])
end;

function UpdateInput(State: InputPointerModel; Msg: TuiMsg; Cmd: TuiCmdOutput): InputPointerModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.TextChanged(Source, Action, Text, Caret):
    begin
      if Source.Value = 1 then
      begin
        return record
          FirstText := Text;
          FirstCaret := Caret;
          SecondText := State.SecondText;
          SecondCaret := State.SecondCaret;
          LastSource := Source.Value;
          LastAction := Action.Value;
        end
      end;

      return record
        FirstText := State.FirstText;
        FirstCaret := State.FirstCaret;
        SecondText := Text;
        SecondCaret := Caret;
        LastSource := Source.Value;
        LastAction := Action.Value;
      end
    end
    else
    begin
      return State
    end
  end
end;

function Click(App: TuiApplication; State: InputPointerModel; X: integer; Y: integer): InputPointerModel;
begin
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(X, Y)));
  return App.RunIterations(State, UpdateInput, ViewInput, 2, 0)
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(10, 2));
  mutable var Model: InputPointerModel := record
    FirstText := 'abcdef';
    FirstCaret := 0;
    SecondText := 'uvwxyz';
    SecondCaret := 0;
    LastSource := 0;
    LastAction := 0;
  end;

  Model := App.RunIterations(Model, UpdateInput, ViewInput, 0, 0);
  Model := Click(App, Model, 4, 0);
  AssertEquals(3, Model.FirstCaret);
  AssertEquals(1, Model.LastSource);
  AssertEquals(11, Model.LastAction);
  Model := Click(App, Model, 4, 1);
  AssertEquals(3, Model.SecondCaret);
  AssertEquals(2, Model.LastSource);
  AssertEquals(22, Model.LastAction);
  Model := Click(App, Model, 9, 0);
  AssertEquals(6, Model.FirstCaret);
  Model := record
    FirstText := 'a界b';
    FirstCaret := 0;
    SecondText := Model.SecondText;
    SecondCaret := Model.SecondCaret;
    LastSource := 0;
    LastAction := 0;
  end;

  Model := App.RunIterations(Model, UpdateInput, ViewInput, 0, 0);
  Model := Click(App, Model, 3, 0);
  AssertEquals(1, Model.FirstCaret);
  AssertEquals(1, Model.LastSource);
  AssertEquals(11, Model.LastAction);
  App.Close()
end.
