program TuiInputPointerTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type InputPointerModel = record
  FirstText: string;
  FirstCaret: integer;
  SecondText: string;
  SecondCaret: integer;
  LastSource: integer;
  LastAction: integer;
end record;

function ViewInput(State: InputPointerModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeColumn([
                                                                                                                  Elements.TuiElementMakeInput(Ids.TuiControlIdCreate(1), State.FirstText, State.FirstCaret, Ids.TuiActionCreate(11)),
                                                                                                                  Elements.TuiElementMakeInput(Ids.TuiControlIdCreate(2), State.SecondText, State.SecondCaret, Ids.TuiActionCreate(22))
                                                                                                                ])
                                                                                ]);
end function;

function UpdateInput(State: InputPointerModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): InputPointerModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        if Source.Value = 1 then
          begin
            return InputPointerModel(FirstText := Text, FirstCaret := Caret, SecondText := State.SecondText, SecondCaret := State.SecondCaret, LastSource := Source.Value, LastAction := Action.Value);
          end;
        end if;

        return InputPointerModel(FirstText := State.FirstText, FirstCaret := State.FirstCaret, SecondText := Text, SecondCaret := Caret, LastSource := Source.Value, LastAction := Action.Value);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function Click(App: Tui.TuiApplication; State: InputPointerModel; X: integer; Y: integer): InputPointerModel;
begin
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, Geometry.TuiPointCreate(X, Y)));
  return Runtime.TuiApplicationRunIterations(App, State, UpdateInput, ViewInput, 2, 0);
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(10, 2));
  var Model: InputPointerModel := InputPointerModel(FirstText := 'abcdef', FirstCaret := 0, SecondText := 'uvwxyz', SecondCaret := 0, LastSource := 0, LastAction := 0);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateInput, ViewInput, 0, 0);
  Model := Click(App, Model, 4, 0);
  Test.AssertEquals(3, Model.FirstCaret);
  Test.AssertEquals(1, Model.LastSource);
  Test.AssertEquals(11, Model.LastAction);
  Model := Click(App, Model, 4, 1);
  Test.AssertEquals(3, Model.SecondCaret);
  Test.AssertEquals(2, Model.LastSource);
  Test.AssertEquals(22, Model.LastAction);
  Model := Click(App, Model, 9, 0);
  Test.AssertEquals(6, Model.FirstCaret);
  Model := InputPointerModel(FirstText := 'a界b', FirstCaret := 0, SecondText := Model.SecondText, SecondCaret := Model.SecondCaret, LastSource := 0, LastAction := 0);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateInput, ViewInput, 0, 0);
  Model := Click(App, Model, 3, 0);
  Test.AssertEquals(1, Model.FirstCaret);
  Test.AssertEquals(1, Model.LastSource);
  Test.AssertEquals(11, Model.LastAction);
  Runtime.TuiApplicationClose(App);
end program;
