program TuiInputSnapshotTest;

uses Std.Test as Test, Std.Tui as Tui;

type InputSnapshotModel = record
  Text: string;
  Caret: integer;
  Hint: string;
end record;

function ViewInput(State: InputSnapshotModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(1)), [
                                                                                Tui.TuiElementBuilders.MakeInputWithHint(Tui.TuiControlId.Create(1), State.Text, State.Caret, State.Hint, Tui.TuiAction.Create(1))
                                                                              ]);
end function;

function UpdateInput(State: InputSnapshotModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): InputSnapshotModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(10, 2));
  var Model: InputSnapshotModel := InputSnapshotModel(Text := '', Caret := 0, Hint := 'Path');
  Model := App.RunIterations(Model, UpdateInput, ViewInput, 0, 0);
  const HintSurface: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertTrue(HintSurface.CellAt(1, 0).Role = Tui.TuiStyleRole.InputCursor);
  Test.AssertEquals('P', HintSurface.CellAt(2, 0).Glyph);
  Test.AssertTrue(HintSurface.CellAt(2, 0).Role = Tui.TuiStyleRole.InputHint);
  Model := InputSnapshotModel(Text := 'abcdefghijk', Caret := 0, Hint := '');
  Model := App.RunIterations(Model, UpdateInput, ViewInput, 0, 0);
  const RightSurface: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertEquals('►', RightSurface.CellAt(9, 0).Glyph);
  Test.AssertTrue(RightSurface.CellAt(9, 0).Role = Tui.TuiStyleRole.InputScroll);
  Test.AssertTrue(RightSurface.CellAt(1, 0).Role = Tui.TuiStyleRole.InputCursor);
  Model := InputSnapshotModel(Text := 'abcdefghijk', Caret := 11, Hint := '');
  Model := App.RunIterations(Model, UpdateInput, ViewInput, 0, 0);
  const LeftSurface: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertEquals('◄', LeftSurface.CellAt(0, 0).Glyph);
  Test.AssertTrue(LeftSurface.CellAt(0, 0).Role = Tui.TuiStyleRole.InputScroll);
  Test.AssertTrue(LeftSurface.CellAt(8, 0).Role = Tui.TuiStyleRole.InputCursor);
  Test.AssertTrue(LeftSurface.LineAt(0).Contains('efghijk'));
  App.Close();
end.
