program TuiInputSnapshotTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type InputSnapshotModel = record
  Text: string;
  Caret: integer;
  Hint: string;
end record;

function ViewInput(State: InputSnapshotModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeInputWithHint(Ids.TuiControlIdCreate(1), State.Text, State.Caret, State.Hint, Ids.TuiActionCreate(1))
                                                                                ]);
end function;

function UpdateInput(State: InputSnapshotModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): InputSnapshotModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(10, 2));
  var Model: InputSnapshotModel := InputSnapshotModel(Text := '', Caret := 0, Hint := 'Path');
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateInput, ViewInput, 0, 0);
  const HintSurface: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(HintSurface, 1, 0).Role =
                  Tui.TuiStyleRole.InputCursor);
  Test.AssertEquals('P', Rendering.TuiSurfaceSnapshotCellAt(HintSurface, 2, 0).Glyph);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(HintSurface, 2, 0).Role =
                  Tui.TuiStyleRole.InputHint);
  Model := InputSnapshotModel(Text := 'abcdefghijk', Caret := 0, Hint := '');
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateInput, ViewInput, 0, 0);
  const RightSurface: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertEquals('►', Rendering.TuiSurfaceSnapshotCellAt(RightSurface, 9, 0).Glyph);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(RightSurface, 9, 0).Role =
                  Tui.TuiStyleRole.InputScroll);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(RightSurface, 1, 0).Role =
                  Tui.TuiStyleRole.InputCursor);
  Model := InputSnapshotModel(Text := 'abcdefghijk', Caret := 11, Hint := '');
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateInput, ViewInput, 0, 0);
  const LeftSurface: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertEquals('◄', Rendering.TuiSurfaceSnapshotCellAt(LeftSurface, 0, 0).Glyph);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(LeftSurface, 0, 0).Role =
                  Tui.TuiStyleRole.InputScroll);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(LeftSurface, 8, 0).Role =
                  Tui.TuiStyleRole.InputCursor);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(LeftSurface, 0), 'efghijk'));
  Runtime.TuiApplicationClose(App);
end program;
