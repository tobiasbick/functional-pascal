program TuiInteractiveRunSignatureTest;

uses Std.Tasks as Tasks;
uses Std.Test as Test;
uses Std.Tui as Tui;

type DemoModel = record
  Ticks: integer;
end record;

function UpdateDemo(State: DemoModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): DemoModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Tick(Delta):
      begin
        return record
          Ticks := State.Ticks + 1;
        end record;
      end;
    when Tui.TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return State;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return State;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function ViewDemo(State: DemoModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel('interactive');
end function;

function UpdateBackground(State: DemoModel; Message: integer; Cmd: Tui.TuiCmdOutput): DemoModel;
begin
  return record
    Ticks := State.Ticks + Message;
  end record;
end function;

function RunSignatureOnly(): DemoModel;
begin
  return Tui.TuiApplication.Run(record
    Ticks := 0;
  end record, UpdateDemo, ViewDemo);
end function;

function RunBackgroundSignatureOnly(): DemoModel;
begin
  var Inbox: channel of integer := Tasks.CreateChannel(4);
  return Tui.TuiApplication.RunWithBackground(record
    Ticks := 0;
  end record, Inbox, UpdateDemo, UpdateBackground, ViewDemo);
end function;

begin
  Test.AssertTrue(true);
end program;
