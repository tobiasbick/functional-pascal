program TuiInteractiveRunSignatureTest;

uses Std.Tasks, Std.Test, Std.Tui;

type DemoModel = record
  Ticks: integer;
end record;

function UpdateDemo(State: DemoModel; Msg: TuiMsg; Cmd: TuiCmdOutput): DemoModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.Tick(Delta):
      begin
        return DemoModel(Ticks := State.Ticks + 1);
      end;
    when TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
      begin
        Cmd.Set(TuiCmd.Quit);
        return State;
      end;
    when TuiMsg.QuitRequested:
      begin
        Cmd.Set(TuiCmd.Quit);
        return State;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function ViewDemo(State: DemoModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel('interactive');
end function;

function UpdateBackground(State: DemoModel; Message: integer; Cmd: TuiCmdOutput): DemoModel;
begin
  return DemoModel(Ticks := State.Ticks + Message);
end function;

function RunSignatureOnly(): DemoModel;
begin
  return TuiApplication.Run(DemoModel(Ticks := 0), UpdateDemo, ViewDemo);
end function;

function RunBackgroundSignatureOnly(): DemoModel;
begin
  const Inbox: channel of integer := CreateChannel(4);
  return TuiApplication.RunWithBackground(DemoModel(Ticks := 0), Inbox, UpdateDemo, UpdateBackground, ViewDemo);
end function;

begin
  AssertTrue(true);
end.
