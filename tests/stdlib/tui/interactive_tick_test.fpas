// Verifies that the interactive host delivers requested ticks after their delay and that a later request replaces a pending one.
program TuiInteractiveTickTest;

uses Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time, Std.Tui as Tui;

type TickModel = record
  Inbox: channel of integer;
  Ticks: integer;
  ShortestTick: integer;
  Started: integer;
  Replaced: boolean;
end record;

function Update(State: TickModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): TickModel;
begin
  var Next: TickModel := State;
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        // A far request that the background message below replaces.
        Cmd.RequestTick(600000);
        Next.Started := Time.MonotonicMillis();
        const Inbox: channel of integer := State.Inbox;
        Cmd.StartBackground(
          1, function(Token: Tasks.CancellationToken): result of (boolean, string) begin
            return Tasks.SendWithCancellation(Inbox, 1, Token).MapError(
              function(Cause: Tasks.TaskError): string begin
                return Cause.Message();
              end function
            );
          end function
        );
      end;
    when Tui.TuiMsg.Tick(const Elapsed):
      begin
        Next.Ticks := State.Ticks + 1;
        if (State.ShortestTick < 0) or (Elapsed < State.ShortestTick) then
          begin
            Next.ShortestTick := Elapsed;
          end;
        end if;

        if Next.Ticks < 3 then
          begin
            Cmd.RequestTick(20);
          end;
        else
          begin
            Cmd.Set(Tui.TuiCmd.Quit);
          end;
        end if;
      end;
    when Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      null;
  end case;

  return Next;
end function;

function UpdateMessage(State: TickModel; Message: integer; Cmd: Tui.TuiCmdOutput): TickModel;
begin
  Cmd.RequestTick(20);
  return State with Replaced := true; end with;
end function;

function View(State: TickModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel('ticks');
end function;

begin
  const Inbox: channel of integer := Tasks.CreateChannel(1);
  const Final: TickModel := Tui.TuiApplication.RunWithBackground(
    TickModel(Inbox := Inbox, Ticks := 0, ShortestTick := -1, Started := 0, Replaced := false),
    Inbox,
    Update,
    UpdateMessage,
    View
  );
  Test.AssertTrue(Final.Replaced);
  Test.AssertEquals(3, Final.Ticks);
  // Every tick waited at least its requested delay.
  Test.AssertTrue(Final.ShortestTick >= 20);
  // The replaced 600 s request never delayed the run.
  Test.AssertTrue(Time.ElapsedMillis(Final.Started) < 60000);
end.
