program InvalidElementActionIdRuntimeError;

uses Std.Tui as Tui;

function Update(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  return State;
end function;

function View(State: integer): Tui.TuiElement;
begin
  var InvalidAction: Tui.TuiAction := record
    Value := 0;
  end record;

  return Tui.TuiElement.Button(Tui.TuiButtonSpec.Normal(Tui.TuiControlId.Create(1), 'Invalid', '', InvalidAction));
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 4));
  discard App.RunIterations(0, Update, View, 0, 0);
end program;
