program InvalidElementControlIdRuntimeError;

uses Std.Tui;

function Update(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  return State;
end function;

function View(State: integer): TuiElement;
begin
  const InvalidId: TuiControlId := record
    Value := 0;
  end;

  return TuiElement.Button(TuiButtonSpec.Normal(InvalidId, 'Invalid', '', TuiAction.Create(10)));
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 4));
  discard App.RunIterations(0, Update, View, 0, 0);
end.
