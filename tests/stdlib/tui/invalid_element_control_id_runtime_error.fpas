program InvalidElementControlIdRuntimeError;

uses Std.Tui as Tui;

function Update(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  return State;
end function;

function View(State: integer): Tui.TuiElement;
begin
  var InvalidId: Tui.TuiControlId := Tui.TuiControlId(Value := 0);
  return Tui.TuiElement.Button(Tui.TuiButtonSpec.Normal(InvalidId, 'Invalid', '', Tui.TuiAction.Create(10)));
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 4));
  discard App.RunIterations(0, Update, View, 0, 0);
end program;
