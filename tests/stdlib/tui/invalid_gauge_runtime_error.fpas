program TuiInvalidGaugeRuntimeError;

uses Std.Tui;

function UpdateGauge(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  Cmd.Set(TuiCmd.NoCommand);
  return State
end;

function ViewGauge(State: integer): TuiElement;
begin
  return TuiElementBuilders.MakeGauge('Invalid', 2, 1)
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 2));
  App.RunIterations(0, UpdateGauge, ViewGauge, 0, 0)
end.
