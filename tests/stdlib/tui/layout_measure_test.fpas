program TuiLayoutMeasureTest;

uses Std.Test, Std.Tui;

begin
  var LabelSize: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeLabel('Hi'), TuiMeasureSpec.Unbounded());
  AssertEquals(2, LabelSize.Preferred.Width);
  AssertEquals(1, LabelSize.Preferred.Height);
  var ButtonSize: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'Ok', TuiAction.Create(1)), TuiMeasureSpec.Unbounded());
  AssertEquals(8, ButtonSize.Preferred.Width);
  AssertEquals(2, ButtonSize.Preferred.Height);
  var EmptyIgnored: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeRow([
                                                                                TuiElementBuilders.MakeEmpty(),
                                                                                TuiElementBuilders.MakeLabel('A'),
                                                                                TuiElementBuilders.MakeEmpty(),
                                                                                TuiElementBuilders.MakeLabel('B')

                                                                              ]), TuiMeasureSpec.Unbounded());
  AssertEquals(2, EmptyIgnored.Preferred.Width);
  AssertEquals(1, EmptyIgnored.Preferred.Height);
  var Spaced: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeRowSpaced([
                                                                                TuiElementBuilders.MakeLabel('A'),
                                                                                TuiElementBuilders.MakeLabel('B')

                                                                              ], 3), TuiMeasureSpec.Unbounded());
  AssertEquals(5, Spaced.Preferred.Width);
  var Nested: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeColumnSpaced([
                                                                                   TuiElementBuilders.MakeLabel('One'),
                                                                                   TuiElementBuilders.MakeRowSpaced([

                                                                                                                      TuiElementBuilders.MakeLabel('AB'),

                                                                                                                      TuiElementBuilders.MakeLabel('CD')



                                                                                                                    ], 1)

                                                                                 ], 2), TuiMeasureSpec.Unbounded());
  AssertEquals(5, Nested.Preferred.Width);
  AssertEquals(4, Nested.Preferred.Height);
  var Margins: TuiLayoutSettings := TuiLayoutSettings.Create(TuiMargins.Uniform(2), TuiSizePolicy.Preferred(), TuiAlignment.Fill(), 0);
  var Wrapped: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeLayout(Margins, TuiElementBuilders.MakeLabel('X')), TuiMeasureSpec.Unbounded());
  AssertEquals(5, Wrapped.Preferred.Width);
  AssertEquals(5, Wrapped.Preferred.Height);
  AssertEquals(5, Wrapped.Minimum.Width);
  var WindowSize: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeWindow('Title', [
                                                                                          TuiElementBuilders.MakeLabel('Body')

                                                                                        ]), TuiMeasureSpec.Unbounded());
  AssertEquals(11, WindowSize.Preferred.Width);
  AssertEquals(3, WindowSize.Preferred.Height);
  var FixedSpacer: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeSpacer(TuiSpacer.Fixed(4)), TuiMeasureSpec.Unbounded());
  AssertEquals(4, FixedSpacer.Preferred.Width);
  AssertEquals(0, FixedSpacer.Preferred.Height);
  var Constrained: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeLabel('ABCDEFGH'), TuiMeasureSpec.AtMost(TuiSize.Create(3, 1)));
  AssertEquals(8, Constrained.Minimum.Width);
  AssertEquals(8, Constrained.Preferred.Width);
  AssertEquals(1, Constrained.Minimum.Height);
  var Undersized: TuiLayoutFit := TuiLayoutFit.Create(WindowSize.Minimum, TuiSize.Create(4, 2));
  AssertFalse(Undersized.Fits());
  AssertTrue(Undersized.Overflow.Width > 0)
end.
