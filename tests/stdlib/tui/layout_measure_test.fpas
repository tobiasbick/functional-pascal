program TuiLayoutMeasureTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Layout as Layout;

begin
  const LabelSize: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeLabel('Hi'), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(2, LabelSize.Preferred.Width);
  Test.AssertEquals(1, LabelSize.Preferred.Height);
  const ButtonSize: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(1), 'Ok', Ids.TuiActionCreate(1)), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(6, ButtonSize.Preferred.Width);
  Test.AssertEquals(1, ButtonSize.Preferred.Height);
  const EmptyIgnored: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeRow([
                                                                                          Elements.TuiElementMakeEmpty(),
                                                                                          Elements.TuiElementMakeLabel('A'),
                                                                                          Elements.TuiElementMakeEmpty(),
                                                                                          Elements.TuiElementMakeLabel('B')
                                                                                        ]), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(2, EmptyIgnored.Preferred.Width);
  Test.AssertEquals(1, EmptyIgnored.Preferred.Height);
  const Spaced: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeRowSpaced([
                                                                                          Elements.TuiElementMakeLabel('A'),
                                                                                          Elements.TuiElementMakeLabel('B')
                                                                                        ], 3), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(5, Spaced.Preferred.Width);
  const Nested: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeColumnSpaced([
                                                                                             Elements.TuiElementMakeLabel('One'),
                                                                                             Elements.TuiElementMakeRowSpaced([
                                                                                                                                Elements.TuiElementMakeLabel('AB'),
                                                                                                                                Elements.TuiElementMakeLabel('CD')
                                                                                                                              ], 1)
                                                                                           ], 2), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(5, Nested.Preferred.Width);
  Test.AssertEquals(4, Nested.Preferred.Height);
  const Margins: Tui.TuiLayoutSettings := Layout.TuiLayoutSettingsCreate(Layout.TuiMarginsUniform(2), Layout.TuiSizePolicyPreferred(), Layout.TuiAlignmentFill(), 0);
  const Wrapped: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeLayout(Margins, Elements.TuiElementMakeLabel('X')), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(5, Wrapped.Preferred.Width);
  Test.AssertEquals(5, Wrapped.Preferred.Height);
  Test.AssertEquals(5, Wrapped.Minimum.Width);
  const FixedWidth: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeLayout(Layout.TuiLayoutSettingsWithFixedWidth(Layout.TuiLayoutSettingsDefault(), 7), Elements.TuiElementMakeLabel('A very long label')), Layout.TuiMeasureSpecAtMost(Geometry.TuiSizeCreate(4, 2)));
  Test.AssertEquals(7, FixedWidth.Minimum.Width);
  Test.AssertEquals(7, FixedWidth.Preferred.Width);
  Test.AssertEquals(7, FixedWidth.Maximum.Width);
  const Expanding: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeLayout(Layout.TuiLayoutSettingsCreate(Layout.TuiMarginsUniform(0), Layout.TuiSizePolicyExpanding(), Layout.TuiAlignmentFill(), 1), Elements.TuiElementMakeLabel('X')), Layout.TuiMeasureSpecAtMost(Geometry.TuiSizeCreate(10, 4)));
  Test.AssertEquals(10, Expanding.Maximum.Width);
  Test.AssertEquals(4, Expanding.Maximum.Height);
  const WindowSize: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakePanel('Title', [
                                                                                                   Elements.TuiElementMakeLabel('Body')
                                                                                                 ]), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(11, WindowSize.Preferred.Width);
  Test.AssertEquals(3, WindowSize.Preferred.Height);
  const FixedSpacer: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeSpacer(Layout.TuiSpacerFixed(4)), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(4, FixedSpacer.Preferred.Width);
  Test.AssertEquals(0, FixedSpacer.Preferred.Height);
  const Constrained: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeLabel('ABCDEFGH'), Layout.TuiMeasureSpecAtMost(Geometry.TuiSizeCreate(3, 1)));
  Test.AssertEquals(8, Constrained.Minimum.Width);
  Test.AssertEquals(8, Constrained.Preferred.Width);
  Test.AssertEquals(1, Constrained.Minimum.Height);
  const Undersized: Tui.TuiLayoutFit := Layout.TuiLayoutFitCreate(WindowSize.Minimum, Geometry.TuiSizeCreate(4, 2));
  Test.AssertFalse(Layout.TuiLayoutFitFits(Undersized));
  Test.AssertTrue(Undersized.Overflow.Width > 0);
end program;
