program TuiLayoutSnapshotTest;

uses Std.Str, Std.Test, Std.Tui;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 8));
  var Model: integer := 0;
  App.RunIterations(Model, function(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer begin
    return State
  end, function(State: integer): TuiElement begin
    return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                          TuiElementBuilders.MakePanel('Win', [
                                                                                                                TuiElementBuilders.MakeColumn([
                                                                                                                                                TuiElementBuilders.MakeLabel('Hello'),
                                                                                                                                                TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'Go', TuiAction.Create(1)),
                                                                                                                                                TuiElementBuilders.MakeInput(TuiControlId.Create(2), 'ab', 2, TuiAction.Create(2))
                                                                                                                                              ])
                                                                                                              ])
                                                                        ])
  end, 0, 0);
  var Snapshot: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertTrue(Std.Str.Contains(Snapshot.LineAt(0), 'Win'));
  AssertTrue(Std.Str.Contains(Snapshot.LineAt(1), 'Hello'));
  AssertTrue(Std.Str.Contains(Snapshot.LineAt(2), 'Go'));
  AssertTrue(Std.Str.Contains(Snapshot.LineAt(3), 'ab'));
  App.Close();
  var Wide: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 10));
  Wide.RunIterations(0, function(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer begin
    return State
  end, function(State: integer): TuiElement begin
    return TuiElementBuilders.MakeDesktop(None, [
                                                  TuiElementBuilders.MakeOverlay('Dlg', [TuiElementBuilders.MakeLabel('Body')])
                                                ])
  end, 0, 0);
  AssertTrue(Std.Str.Contains(Wide.SurfaceSnapshot().LineAt(3), 'Dlg'));
  AssertTrue(Std.Str.Contains(Wide.SurfaceSnapshot().LineAt(4), 'Body'));
  Wide.Close()
end.
