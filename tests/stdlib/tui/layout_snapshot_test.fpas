program TuiLayoutSnapshotTest;

uses Std.Test, Std.Tui;

begin
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 8));
  const Model: integer := 0;
  discard App.RunIterations(Model, function(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer begin
    return State;
  end function, function(State: integer): TuiElement begin
    return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                          TuiElementBuilders.MakePanel('Win', [
                                                                                                                TuiElementBuilders.MakeColumn([
                                                                                                                                                TuiElementBuilders.MakeLabel('Hello'),
                                                                                                                                                TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'Go', TuiAction.Create(1)),
                                                                                                                                                TuiElementBuilders.MakeInput(TuiControlId.Create(2), 'ab', 2, TuiAction.Create(2))
                                                                                                                                              ])
                                                                                                              ])
                                                                        ]);
  end function, 0, 0);
  const Snapshot: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertTrue(Snapshot.LineAt(0).Contains('Win'));
  AssertTrue(Snapshot.LineAt(1).Contains('Hello'));
  AssertTrue(Snapshot.LineAt(2).Contains('Go'));
  AssertTrue(Snapshot.LineAt(3).Contains('ab'));
  App.Close();
  const Wide: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 10));
  discard Wide.RunIterations(0, function(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer begin
    return State;
  end function, function(State: integer): TuiElement begin
    return TuiElementBuilders.MakeDesktop(None, [
                                                  TuiElementBuilders.MakeOverlay('Dlg', [TuiElementBuilders.MakeLabel('Body')])
                                                ]);
  end function, 0, 0);
  const Overlay: TuiSurfaceSnapshot := Wide.SurfaceSnapshot();
  AssertEquals(18, Overlay.LineAt(3).IndexOf('Dlg'));
  AssertEquals(16, Overlay.LineAt(4).IndexOf('Body'));
  AssertEquals('╭', Overlay.CellAt(15, 3).Glyph);
  AssertEquals('╮', Overlay.CellAt(23, 3).Glyph);
  Wide.Close();
end.
