program TuiLayoutSpacerTest;

uses Std.Test as Test, Std.Ui.Terminal as Tui;

function Paint(Tree: Tui.TuiElement; Size: Tui.TuiSize): Tui.TuiSurfaceSnapshot;
begin
  const App := Tui.TuiApplication.OpenForTest(Size);
  discard App.RunIterations(
    Tree,
    function(State: Tui.TuiElement; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Tui.TuiElement begin
      return State;
    end function, function(State: Tui.TuiElement): Tui.TuiElement begin
      return State;
    end function, 0, 0
  );
  const Snapshot := App.SurfaceSnapshot();
  App.Close();
  return Snapshot;
end function;

procedure TestFixedColumn();
begin
  const ColumnSpacer := Paint(
    Tui.TuiElementBuilders.MakeDesktop(
      None, [
        Tui.TuiElementBuilders.MakeColumn([
          Tui.TuiElementBuilders.MakeLabel('A'),
          Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(2)),
          Tui.TuiElementBuilders.MakeLabel('B')
        ])
      ]
    ), Tui.TuiSize.Create(4, 4)
  );
  Test.AssertEquals('A', ColumnSpacer.CellAt(0, 0).Glyph);
  Test.AssertEquals(' ', ColumnSpacer.CellAt(0, 1).Glyph);
  Test.AssertEquals(' ', ColumnSpacer.CellAt(0, 2).Glyph);
  Test.AssertEquals('B', ColumnSpacer.CellAt(0, 3).Glyph);
end procedure;

procedure TestExpandingColumn();
begin
  const ColumnSpacer := Paint(
    Tui.TuiElementBuilders.MakeDesktop(
      None, [
        Tui.TuiElementBuilders.MakeColumn([
          Tui.TuiElementBuilders.MakeLabel('A'),
          Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Expanding(2)),
          Tui.TuiElementBuilders.MakeLabel('B')
        ])
      ]
    ), Tui.TuiSize.Create(4, 6)
  );
  Test.AssertEquals('A', ColumnSpacer.CellAt(0, 0).Glyph);
  Test.AssertEquals(' ', ColumnSpacer.CellAt(0, 1).Glyph);
  Test.AssertEquals(' ', ColumnSpacer.CellAt(0, 4).Glyph);
  Test.AssertEquals('B', ColumnSpacer.CellAt(0, 5).Glyph);
end procedure;

procedure TestFixedRow();
begin
  const RowSpacer := Paint(
    Tui.TuiElementBuilders.MakeDesktop(
      None, [
        Tui.TuiElementBuilders.MakeRow([
          Tui.TuiElementBuilders.MakeLabel('A'),
          Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(2)),
          Tui.TuiElementBuilders.MakeLabel('B')
        ])
      ]
    ), Tui.TuiSize.Create(4, 1)
  );
  Test.AssertEquals('A', RowSpacer.CellAt(0, 0).Glyph);
  Test.AssertEquals(' ', RowSpacer.CellAt(1, 0).Glyph);
  Test.AssertEquals(' ', RowSpacer.CellAt(2, 0).Glyph);
  Test.AssertEquals('B', RowSpacer.CellAt(3, 0).Glyph);
end procedure;

procedure TestPanelSpacer();
begin
  const Panel := Paint(
    Tui.TuiElementBuilders.MakeDesktop(
      None, [
        Tui.TuiElementBuilders.MakePanel(
          'P', [
            Tui.TuiElementBuilders.MakeLabel('A'),
            Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)),
            Tui.TuiElementBuilders.MakeLabel('B')
          ]
        )
      ]
    ), Tui.TuiSize.Create(8, 5)
  );
  Test.AssertEquals('A', Panel.CellAt(1, 1).Glyph);
  Test.AssertEquals(' ', Panel.CellAt(1, 2).Glyph);
  Test.AssertEquals('B', Panel.CellAt(1, 3).Glyph);
end procedure;

begin
  TestFixedColumn();
  TestExpandingColumn();
  TestFixedRow();
  TestPanelSpacer();
end.
