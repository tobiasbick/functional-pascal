program TuiLayoutValuesTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Layout as Layout2;

begin
  const Mixed: Tui.TuiSizePolicy := Layout2.TuiSizePolicyCreate(Tui.TuiSizePolicyKind.Expanding, Tui.TuiSizePolicyKind.Fixed);
  Test.AssertTrue(Mixed.Horizontal = Tui.TuiSizePolicyKind.Expanding);
  Test.AssertTrue(Mixed.Vertical = Tui.TuiSizePolicyKind.Fixed);
  Test.AssertTrue(Layout2.TuiSizePolicyPreferred().Horizontal = Tui.TuiSizePolicyKind.Preferred);
  Test.AssertTrue(Layout2.TuiAlignmentFill().Vertical = Tui.TuiAlignmentKind.Fill);
  Test.AssertTrue(Layout2.TuiAlignmentCenter().Horizontal = Tui.TuiAlignmentKind.Center);
  const Margins: Tui.TuiMargins := Layout2.TuiMarginsCreate(1, 2, 3, 4);
  Test.AssertEquals(4, Layout2.TuiMarginsHorizontal(Margins));
  Test.AssertEquals(6, Layout2.TuiMarginsVertical(Margins));
  const Symmetric: Tui.TuiMargins := Layout2.TuiMarginsSymmetric(2, 1);
  Test.AssertEquals(2, Symmetric.Left);
  Test.AssertEquals(1, Symmetric.Top);
  Test.AssertEquals(2, Symmetric.Right);
  const Settings: Tui.TuiLayoutSettings := Layout2.TuiLayoutSettingsDefault();
  Test.AssertEquals(0, Settings.Margins.Left);
  Test.AssertTrue(Settings.SizePolicy.Horizontal = Tui.TuiSizePolicyKind.Preferred);
  Test.AssertTrue(Settings.Alignment.Horizontal = Tui.TuiAlignmentKind.Fill);
  Test.AssertEquals(0, Settings.Stretch);
  case Settings.Width of
    when Option.Some(const Width):
      begin
        Test.Fail('default layout settings must not constrain width');
      end;
    when Option.None:
      begin
        null;
      end;
  end case;

  case Settings.Height of
    when Option.Some(const Height):
      begin
        Test.Fail('default layout settings must not constrain height');
      end;
    when Option.None:
      begin
        null;
      end;
  end case;
  const FixedWidth: Tui.TuiLayoutSettings := Layout2.TuiLayoutSettingsWithFixedWidth(Settings, 7);
  case FixedWidth.Width of
    when Option.Some(const Width):
      begin
        Test.AssertEquals(7, Width);
      end;
    when Option.None:
      begin
        Test.Fail('fixed-width layout settings must retain their width');
      end;
  end case;
  const FixedHeight: Tui.TuiLayoutSettings := Layout2.TuiLayoutSettingsWithFixedHeight(Settings, 5);
  case FixedHeight.Height of
    when Option.Some(const Height):
      begin
        Test.AssertEquals(5, Height);
      end;
    when Option.None:
      begin
        Test.Fail('fixed-height layout settings must retain their height');
      end;
  end case;
  const FixedSize: Tui.TuiLayoutSettings := Layout2.TuiLayoutSettingsWithFixedHeight(FixedWidth, 5);
  case FixedSize.Width of
    when Option.Some(const Width):
      begin
        Test.AssertEquals(7, Width);
      end;
    when Option.None:
      begin
        Test.Fail('fixed-height layout settings must preserve their width');
      end;
  end case;

  case FixedSize.Height of
    when Option.Some(const Height):
      begin
        Test.AssertEquals(5, Height);
      end;
    when Option.None:
      begin
        Test.Fail('fixed-size layout settings must retain their height');
      end;
  end case;
  const Custom: Tui.TuiLayoutSettings := Layout2.TuiLayoutSettingsCreate(Margins, Layout2.TuiSizePolicyExpanding(), Layout2.TuiAlignmentLeading(), 3);
  Test.AssertEquals(3, Custom.Stretch);
  Test.AssertTrue(Custom.Alignment.Horizontal = Tui.TuiAlignmentKind.Leading);
  const Unbounded: Tui.TuiMeasureConstraint := Layout2.TuiMeasureConstraintUnbounded();
  Test.AssertFalse(Layout2.TuiMeasureConstraintIsBounded(Unbounded));
  const Width: Tui.TuiMeasureConstraint := Layout2.TuiMeasureConstraintAtMost(80);
  Test.AssertTrue(Layout2.TuiMeasureConstraintIsBounded(Width));
  Test.AssertEquals(80, Width.Limit);
  const Spec: Tui.TuiMeasureSpec := Layout2.TuiMeasureSpecAtMost(Geometry.TuiSizeCreate(40, 10));
  Test.AssertEquals(40, Spec.Width.Limit);
  Test.AssertEquals(10, Spec.Height.Limit);
  const Measure: Tui.TuiMeasureResult := Layout2.TuiMeasureResultCreate(Geometry.TuiSizeCreate(2, 1), Geometry.TuiSizeCreate(8, 3), Geometry.TuiSizeCreate(20, 9));
  Test.AssertEquals(8, Measure.Preferred.Width);
  Test.AssertEquals(9, Measure.Maximum.Height);
  const Fixed: Tui.TuiMeasureResult := Layout2.TuiMeasureResultFixed(Geometry.TuiSizeCreate(5, 4));
  Test.AssertEquals(5, Fixed.Minimum.Width);
  Test.AssertEquals(4, Fixed.Maximum.Height);
  const FixedSpacer: Tui.TuiSpacer := Layout2.TuiSpacerFixed(3);
  Test.AssertTrue(FixedSpacer.Kind = Tui.TuiSpacerKind.Fixed);
  Test.AssertEquals(3, FixedSpacer.MinimumExtent);
  const ExpandingSpacer: Tui.TuiSpacer := Layout2.TuiSpacerExpanding(1);
  Test.AssertTrue(ExpandingSpacer.Kind = Tui.TuiSpacerKind.Expanding);
  Test.AssertEquals(1, ExpandingSpacer.MinimumExtent);
  const Fit: Tui.TuiLayoutFit := Layout2.TuiLayoutFitCreate(Geometry.TuiSizeCreate(10, 8), Geometry.TuiSizeCreate(7, 8));
  Test.AssertFalse(Layout2.TuiLayoutFitFits(Fit));
  Test.AssertEquals(3, Fit.Overflow.Width);
  Test.AssertEquals(0, Fit.Overflow.Height);
  Test.AssertTrue(Layout2.TuiLayoutFitFits(Layout2.TuiLayoutFitCreate(Geometry.TuiSizeCreate(4, 4), Geometry.TuiSizeCreate(5, 5))));
  const Spaced: Tui.TuiElement := Elements.TuiElementMakeRowSpaced([
                                                                     Elements.TuiElementMakeLabel('A'),
                                                                     Elements.TuiElementMakeLabel('B')
                                                                   ], 2);
  case Spaced of
    when Tui.TuiElement.Row(const Children, const Spacing):
      begin
        Test.AssertEquals(2, Spacing);
        Test.AssertEquals(2, Arrays.Length(Children));
      end;
    when Tui.TuiElement.Empty, Tui.TuiElement.Label(_), Tui.TuiElement.Button(_), Tui.TuiElement.Input(_), Tui.TuiElement.TextArea(_, _, _, _, _), Tui.TuiElement.CheckBox(_, _, _, _), Tui.TuiElement.List(_, _, _, _), Tui.TuiElement.Scroll(_, _, _, _), Tui.TuiElement.MenuBar(_), Tui.TuiElement.Menu(_, _, _, _), Tui.TuiElement.StatusLine(_), Tui.TuiElement.CellGrid(_), Tui.TuiElement.Rule(_), Tui.TuiElement.Gauge(_), Tui.TuiElement.Column(_, _), Tui.TuiElement.Layout(_, _), Tui.TuiElement.Spacer(_), Tui.TuiElement.Panel(_, _), Tui.TuiElement.Overlay(_, _), Tui.TuiElement.Desktop(_, _):
      begin
        begin
          Test.Fail('expected spaced row');
        end;
      end;
  end case;
  const Wrapped: Tui.TuiElement := Elements.TuiElementMakeLayout(Settings, Elements.TuiElementMakeLabel('X'));
  case Wrapped of
    when Tui.TuiElement.Layout(const WrappedSettings, const WrappedChildren):
      begin
        Test.AssertEquals(1, Arrays.Length(WrappedChildren));
        Test.AssertEquals(0, WrappedSettings.Stretch);
      end;
    when Tui.TuiElement.Empty, Tui.TuiElement.Label(_), Tui.TuiElement.Button(_), Tui.TuiElement.Input(_), Tui.TuiElement.TextArea(_, _, _, _, _), Tui.TuiElement.CheckBox(_, _, _, _), Tui.TuiElement.List(_, _, _, _), Tui.TuiElement.Scroll(_, _, _, _), Tui.TuiElement.MenuBar(_), Tui.TuiElement.Menu(_, _, _, _), Tui.TuiElement.StatusLine(_), Tui.TuiElement.CellGrid(_), Tui.TuiElement.Rule(_), Tui.TuiElement.Gauge(_), Tui.TuiElement.Row(_, _), Tui.TuiElement.Column(_, _), Tui.TuiElement.Spacer(_), Tui.TuiElement.Panel(_, _), Tui.TuiElement.Overlay(_, _), Tui.TuiElement.Desktop(_, _):
      begin
        begin
          Test.Fail('expected layout wrapper');
        end;
      end;
  end case;
  const SpacerElement: Tui.TuiElement := Elements.TuiElementMakeSpacer(FixedSpacer);
  case SpacerElement of
    when Tui.TuiElement.Spacer(const Value):
      begin
        Test.AssertEquals(3, Value.MinimumExtent);
      end;
    when Tui.TuiElement.Empty, Tui.TuiElement.Label(_), Tui.TuiElement.Button(_), Tui.TuiElement.Input(_), Tui.TuiElement.TextArea(_, _, _, _, _), Tui.TuiElement.CheckBox(_, _, _, _), Tui.TuiElement.List(_, _, _, _), Tui.TuiElement.Scroll(_, _, _, _), Tui.TuiElement.MenuBar(_), Tui.TuiElement.Menu(_, _, _, _), Tui.TuiElement.StatusLine(_), Tui.TuiElement.CellGrid(_), Tui.TuiElement.Rule(_), Tui.TuiElement.Gauge(_), Tui.TuiElement.Row(_, _), Tui.TuiElement.Column(_, _), Tui.TuiElement.Layout(_, _), Tui.TuiElement.Panel(_, _), Tui.TuiElement.Overlay(_, _), Tui.TuiElement.Desktop(_, _):
      begin
        begin
          Test.Fail('expected spacer element');
        end;
      end;
  end case;
end program;
