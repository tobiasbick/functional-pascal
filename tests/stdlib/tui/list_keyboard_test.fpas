program TuiListKeyboardTest;

uses Std.Test, Std.Tui;

type ListModel = record
  Focus: integer;
  Selected: integer;
  Changes: array of integer;
end record;

function MakeKey(Kind: TuiKeyKind): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewList(State: ListModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakePanel('Host', [
                                                                                                                         TuiElementBuilders.MakeList(TuiControlId.Create(1), ['Alpha', 'Beta', 'Gamma'], State.Selected, TuiAction.Create(5))
                                                                                                                       ])
                                                                                ]);
end function;

function UpdateList(State: ListModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ListModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        AssertEquals(1, Source.Value);
        AssertEquals(5, Action.Value);
        return ListModel(Focus := State.Focus, Selected := Selected, Changes := State.Changes.Concat([
                                                                                                       Selected
                                                                                                     ]));
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 8));
  var Model: ListModel := ListModel(Focus := 1, Selected := 0, Changes := []);
  Model := App.RunIterations(Model, UpdateList, ViewList, 0, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down));
  Model := App.RunIterations(Model, UpdateList, ViewList, 1, 0);
  AssertEquals(1, Model.Selected);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.EndKey));
  Model := App.RunIterations(Model, UpdateList, ViewList, 1, 0);
  AssertEquals(2, Model.Selected);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Home));
  Model := App.RunIterations(Model, UpdateList, ViewList, 1, 0);
  AssertEquals(0, Model.Selected);
  AssertEquals(3, Model.Changes.Length());
  App.Close();
end.
