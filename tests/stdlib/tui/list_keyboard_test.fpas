program TuiListKeyboardTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type ListModel = record
  Focus: integer;
  Selected: integer;
  Changes: array of (integer);
end record;

function MakeKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewList(State: ListModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakePanel('Host', [
                                                                                                                                   Elements.TuiElementMakeList(Ids.TuiControlIdCreate(1), ['Alpha', 'Beta', 'Gamma'], State.Selected, Ids.TuiActionCreate(5))
                                                                                                                                 ])
                                                                                          ]);
end function;

function UpdateList(State: ListModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ListModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(5, Action.Value);
        return ListModel(Focus := State.Focus, Selected := Selected, Changes := Arrays.Concat(State.Changes, [
                                                                                                               Selected
                                                                                                             ]));
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 8));
  var Model: ListModel := ListModel(Focus := 1, Selected := 0, Changes := []);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateList, ViewList, 0, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Down));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateList, ViewList, 1, 0);
  Test.AssertEquals(1, Model.Selected);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.EndKey));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateList, ViewList, 1, 0);
  Test.AssertEquals(2, Model.Selected);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Home));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateList, ViewList, 1, 0);
  Test.AssertEquals(0, Model.Selected);
  Test.AssertEquals(3, Arrays.Length(Model.Changes));
  Runtime.TuiApplicationClose(App);
end program;
