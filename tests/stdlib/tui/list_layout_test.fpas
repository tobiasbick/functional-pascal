program TuiListLayoutTest;

uses Std.Str, Std.Test, Std.Tui;

type ListModel = record
  Selected: integer;
end record;

function ViewList(State: ListModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakePanel('Host', [
                                                                                                               TuiElementBuilders.MakeList(TuiControlId.Create(1), ['Alpha', 'Beta', 'Gamma'], State.Selected, TuiAction.Create(5))
                                                                                                             ])
                                                                      ]);
end function;

function UpdateList(State: ListModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ListModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  return State;
end function;

begin
  const Measured: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeList(TuiControlId.Create(1), [
                                                                                                       'Alpha',
                                                                                                       'Beta',
                                                                                                       'Gamma'
                                                                                                     ], 0, TuiAction.Create(1)), TuiMeasureSpec.Unbounded());
  AssertEquals(7, Measured.Preferred.Width);
  AssertEquals(3, Measured.Preferred.Height);
  const Empty: TuiMeasureResult := TuiMeasure(TuiElementBuilders.MakeList(TuiControlId.Create(1), [], -1, TuiAction.Create(1)), TuiMeasureSpec.Unbounded());
  AssertEquals(2, Empty.Preferred.Width);
  AssertEquals(1, Empty.Preferred.Height);
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 8));
  var Model: ListModel := record
    Selected := 0;
  end;

  Model := App.RunIterations(Model, UpdateList, ViewList, 0, 0);
  App.InjectResizeForTest(TuiSize.Create(16, 5));
  Model := App.RunIterations(Model, UpdateList, ViewList, 1, 0);
  AssertEquals(16, App.SurfaceSnapshot().Width);
  AssertTrue(Std.Str.Contains(App.SurfaceSnapshot().LineAt(1), 'Alpha'));
  App.Close();
end.
