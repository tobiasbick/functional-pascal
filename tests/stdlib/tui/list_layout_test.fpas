program TuiListLayoutTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Layout as Layout;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type ListModel = record
  Selected: integer;
end record;

function ViewList(State: ListModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakePanel('Host', [
                                                                                                                         Elements.TuiElementMakeList(Ids.TuiControlIdCreate(1), ['Alpha', 'Beta', 'Gamma'], State.Selected, Ids.TuiActionCreate(5))
                                                                                                                       ])
                                                                                ]);
end function;

function UpdateList(State: ListModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ListModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  const Measured: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeList(Ids.TuiControlIdCreate(1), [
                                                                                                                  'Alpha',
                                                                                                                  'Beta',
                                                                                                                  'Gamma'
                                                                                                                ], 0, Ids.TuiActionCreate(1)), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(7, Measured.Preferred.Width);
  Test.AssertEquals(3, Measured.Preferred.Height);
  const Empty: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeList(Ids.TuiControlIdCreate(1), [], -1, Ids.TuiActionCreate(1)), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(2, Empty.Preferred.Width);
  Test.AssertEquals(1, Empty.Preferred.Height);
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 8));
  var Model: ListModel := ListModel(Selected := 0);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateList, ViewList, 0, 0);
  Runtime.TuiApplicationInjectResizeForTest(App, Geometry.TuiSizeCreate(16, 5));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateList, ViewList, 1, 0);
  Test.AssertEquals(16, Runtime.TuiApplicationSurfaceSnapshot(App).Width);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 1), 'Alpha'));
  Runtime.TuiApplicationClose(App);
end program;
