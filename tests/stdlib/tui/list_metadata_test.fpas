// Exercises explicit viewport rows, semantic styles and disabled activation through the application.
program TuiListMetadataTest;

uses Std.Test as Test, Std.Ui.Terminal as Tui;

type Model = record
  Selected: integer := 0;
  Count: integer := 0;
  Changed: boolean := false;
  Delegate: boolean := false;
  Keys: integer := 0;
end record;

function View(State: Model): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(
    Some(Tui.TuiControlId.Create(1)), [
      Tui.TuiElementBuilders.MakeLayout(
        Tui.TuiLayoutSettings.Default().WithFixedWidth(20).WithFixedHeight(2),
        Tui.TuiElement.List(
          Tui.TuiControlId.Create(1), ['Alpha', 'Beta', 'Gamma'], State.Selected,
          Tui.TuiListActions(
            Change := Tui.TuiAction.Create(2), Activate := Some(Tui.TuiAction.Create(3)),
            FirstRow := Some(1), DisabledItems := Some([false, true, false]),
            HandleKeys := not State.Delegate,
            ItemRoles := Some([
              Tui.TuiStyleRole.Normal, Tui.TuiStyleRole.Normal,
              if State.Changed then Tui.TuiStyleRole.Failure else Tui.TuiStyleRole.Warning end if
            ])
          )
        )
      )
    ]
  );
end function;

function Update(State: Model; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Model;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.SelectionChanged(_, _, const Row):
      return State with Selected := Row; end with;
    when Tui.TuiMsg.Action(_, _):
      return State with Count := State.Count + 1; end with;
    when Tui.TuiMsg.Key(_):
      return State with Keys := State.Keys + 1; end with;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      return State;
  end case;
end function;

begin
  const App := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 2));
  var State := Model();
  State := App.RunIterations(State, Update, View, 0, 0);
  Test.AssertTrue('Beta' in App.SurfaceSnapshot().LineAt(0));
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(2, 0).Role = Tui.TuiStyleRole.Disabled);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(2, 1).Role = Tui.TuiStyleRole.Warning);
  App.InjectPointerForTest(
    Tui.TuiPointerEvent.Create(
      Tui.TuiPointerAction.Down,
      Tui.TuiPointerButton.Left,
      Tui.TuiPoint.Create(3, 0)
    )
  );
  State := App.RunIterations(State, Update, View, 3, 0);
  Test.AssertEquals(1, State.Selected);
  Test.AssertEquals(0, State.Count);
  App.InjectKeyForTest(
    Tui.TuiKeyEvent(
      kind := Tui.TuiKeyKind.Enter,
      ch := '',
      shift := false,
      ctrl := false,
      alt := false,
      meta := false
    )
  );
  State := App.RunIterations(State, Update, View, 1, 0);
  Test.AssertEquals(0, State.Count);
  App.InjectPointerForTest(
    Tui.TuiPointerEvent.Create(
      Tui.TuiPointerAction.Down,
      Tui.TuiPointerButton.Left,
      Tui.TuiPoint.Create(3, 1)
    )
  );
  State := App.RunIterations(State, Update, View, 3, 0);
  Test.AssertEquals(2, State.Selected);
  Test.AssertEquals(1, State.Count);
  State.Selected := 0;
  State := App.RunIterations(State, Update, View, 0, 0);
  State.Changed := true;
  State := App.RunIterations(State, Update, View, 0, 0);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(2, 1).Role = Tui.TuiStyleRole.Failure);
  State.Delegate := true;
  const PreviousKeys := State.Keys;
  State := App.RunIterations(State, Update, View, 0, 0);
  App.InjectKeyForTest(
    Tui.TuiKeyEvent(
      kind := Tui.TuiKeyKind.Tab,
      ch := '',
      shift := false,
      ctrl := false,
      alt := false,
      meta := false
    )
  );
  State := App.RunIterations(State, Update, View, 1, 0);
  Test.AssertEquals(PreviousKeys + 1, State.Keys);
  App.Close();
end.
