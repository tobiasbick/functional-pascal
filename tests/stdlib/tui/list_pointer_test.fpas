program TuiListPointerTest;

uses Std.Test, Std.Tui;

type ListModel = record
  Focus: integer;
  Selected: integer;
end record;

function MakePointer(X: integer; Y: integer): TuiPointerEvent;
begin
  return TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(X, Y));
end function;

function FindGlyph(Snapshot: TuiSurfaceSnapshot; Glyph: string): TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Line: string := Snapshot.LineAt(Y);
      const Index: integer := Line.IndexOf(Glyph);
      if Index >= 0 then
        begin
          return TuiPoint.Create(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewList(State: ListModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakePanel('Host', [
                                                                                                                         TuiElementBuilders.MakeList(TuiControlId.Create(1), ['Alpha', 'Beta', 'Gamma'], State.Selected, TuiAction.Create(5))
                                                                                                                       ])
                                                                                ]);
end function;

function UpdateList(State: ListModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ListModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.FocusChanged(Previous, Current):
      begin
        case Current of
          when Some(Id):
            begin
              return ListModel(Focus := Id.Value, Selected := State.Selected);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.SelectionChanged(Source, Action, Selected):
      begin
        return ListModel(Focus := State.Focus, Selected := Selected);
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 8));
  var Model: ListModel := ListModel(Focus := 1, Selected := 0);
  Model := App.RunIterations(Model, UpdateList, ViewList, 0, 0);
  const BetaAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Beta');
  App.InjectPointerForTest(MakePointer(BetaAt.X, BetaAt.Y));
  Model := App.RunIterations(Model, UpdateList, ViewList, 1, 0);
  AssertEquals(1, Model.Selected);
  App.Close();
end.
