program TuiListPointerTest;

uses Std.Test as Test, Std.Tui as Tui;

type ListModel = record
  Focus: integer;
  Selected: integer;
end record;

function MakePointer(X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Tui.TuiPointerEvent.Create(
    Tui.TuiPointerAction.Down,
    Tui.TuiPointerButton.Left,
    Tui.TuiPoint.Create(X, Y)
  );
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Line: string := Snapshot.LineAt(Y);
      case Line.IndexOf(Glyph) of
        when Some(const Index):
          return Tui.TuiPoint.Create(Index, Y);
        when None:
          null;
      end case;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewList(State: ListModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(
    Some(Tui.TuiControlId.Create(State.Focus)), [
      Tui.TuiElementBuilders.MakePanel(
        'Host', [
          Tui.TuiElementBuilders.MakeList(
            Tui.TuiControlId.Create(1),
            ['Alpha', 'Beta', 'Gamma'],
            State.Selected,
            Tui.TuiAction.Create(5)
          )
        ]
      )
    ]
  );
end function;

function UpdateList(State: ListModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ListModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return ListModel(Focus := Id.Value, Selected := State.Selected);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return ListModel(Focus := State.Focus, Selected := Selected);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 8));
  var Model: ListModel := ListModel(Focus := 1, Selected := 0);
  Model := App.RunIterations(Model, UpdateList, ViewList, 0, 0);
  const BetaAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Beta');
  App.InjectPointerForTest(MakePointer(BetaAt.X, BetaAt.Y));
  Model := App.RunIterations(Model, UpdateList, ViewList, 1, 0);
  Test.AssertEquals(1, Model.Selected);
  App.Close();
end.
