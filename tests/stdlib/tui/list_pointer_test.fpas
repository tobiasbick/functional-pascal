program TuiListPointerTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type ListModel = record
  Focus: integer;
  Selected: integer;
end record;

function MakePointer(X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, Geometry.TuiPointCreate(X, Y));
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Line: string := Rendering.TuiSurfaceSnapshotLineAt(Snapshot, Y);
      const Index: integer := Str.IndexOf(Line, Glyph);
      if Index >= 0 then
        begin
          return Geometry.TuiPointCreate(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewList(State: ListModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakePanel('Host', [
                                                                                                                                   Elements.TuiElementMakeList(Ids.TuiControlIdCreate(1), ['Alpha', 'Beta', 'Gamma'], State.Selected, Ids.TuiActionCreate(5))
                                                                                                                                 ])
                                                                                          ]);
end function;

function UpdateList(State: ListModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ListModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return ListModel(Focus := Id.Value, Selected := State.Selected);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return ListModel(Focus := State.Focus, Selected := Selected);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 8));
  var Model: ListModel := ListModel(Focus := 1, Selected := 0);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateList, ViewList, 0, 0);
  const BetaAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(App), 'Beta');
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(BetaAt.X, BetaAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateList, ViewList, 1, 0);
  Test.AssertEquals(1, Model.Selected);
  Runtime.TuiApplicationClose(App);
end program;
