program TuiListSnapshotTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type ListModel = record
  Selected: integer;
end record;

function ViewList(State: ListModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(1)), [
                                                                                Tui.TuiElementBuilders.MakePanel('Host', [
                                                                                                                           Tui.TuiElementBuilders.MakeList(Tui.TuiControlId.Create(1), ['Alpha', 'Beta', 'Gamma'], State.Selected, Tui.TuiAction.Create(5))
                                                                                                                         ])
                                                                              ]);
end function;

function UpdateList(State: ListModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ListModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.SelectionChanged(Source, Action, Selected):
      begin
        return record
          Selected := Selected;
        end record;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 8));
  mutable var Model: ListModel := record
    Selected := 1;
  end record;

  Model := App.RunIterations(Model, UpdateList, ViewList, 0, 0);
  Test.AssertTrue(Str.Contains(App.SurfaceSnapshot().LineAt(1), '  Alpha'));
  Test.AssertTrue(Str.Contains(App.SurfaceSnapshot().LineAt(2), '> Beta'));
  Test.AssertTrue(Str.Contains(App.SurfaceSnapshot().LineAt(3), '  Gamma'));
  App.Close();
end program;
