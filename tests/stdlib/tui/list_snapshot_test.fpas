program TuiListSnapshotTest;

uses Std.Test, Std.Tui;

type ListModel = record
  Selected: integer;
end record;

function ViewList(State: ListModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakePanel('Host', [
                                                                                                               TuiElementBuilders.MakeList(TuiControlId.Create(1), ['Alpha', 'Beta', 'Gamma'], State.Selected, TuiAction.Create(5))
                                                                                                             ])
                                                                      ]);
end function;

function UpdateList(State: ListModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ListModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  if Msg is TuiMsg.SelectionChanged(const Source, const Action, const Selected) then
    begin
      return ListModel(Selected := Selected);
    end;
  else
    begin
      return State;
    end;
  end if;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 8));
  var Model: ListModel := ListModel(Selected := 1);
  Model := App.RunIterations(Model, UpdateList, ViewList, 0, 0);
  AssertTrue(App.SurfaceSnapshot().LineAt(1).Contains('  Alpha'));
  AssertTrue(App.SurfaceSnapshot().LineAt(2).Contains('> Beta'));
  AssertTrue(App.SurfaceSnapshot().LineAt(3).Contains('  Gamma'));
  App.Close();
end.
