program TuiListSnapshotTest;

uses Std.Test as Test, Std.Tui as Tui;

type ListModel = record
  Selected: integer;
end record;

function ViewList(State: ListModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(1)), [
                                                                                Tui.TuiElementBuilders.MakePanel('Host', [
                                                                                                                           Tui.TuiElementBuilders.MakeList(Tui.TuiControlId.Create(1), ['Alpha', 'Beta', 'Gamma'], State.Selected, Tui.TuiAction.Create(5))
                                                                                                                         ])
                                                                              ]);
end function;

function UpdateList(State: ListModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ListModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        return ListModel(Selected := Selected);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 8));
  var Model: ListModel := ListModel(Selected := 1);
  Model := App.RunIterations(Model, UpdateList, ViewList, 0, 0);
  Test.AssertTrue(App.SurfaceSnapshot().LineAt(1).Contains('  Alpha'));
  Test.AssertTrue(App.SurfaceSnapshot().LineAt(2).Contains('> Beta'));
  Test.AssertTrue(App.SurfaceSnapshot().LineAt(3).Contains('  Gamma'));
  App.Close();
end.
