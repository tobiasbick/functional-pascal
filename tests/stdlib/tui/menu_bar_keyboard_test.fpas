program TuiMenuBarKeyboardTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;
uses Std.Tui as Tui;

type MenuModel = record
  Focus: integer;
  Actions: array of (integer);
end record;

function MakeKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewMenu(State: MenuModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Option.Some(Tui.TuiControlId.Create(State.Focus)), [
                                                                                                 Tui.TuiElementBuilders.MakeMenuBar([
                                                                                                                                      Tui.TuiMenuItem.Create(Tui.TuiControlId.Create(1), 'Open', Tui.TuiAction.Create(10)),
                                                                                                                                      Tui.TuiMenuItem.Disabled(Tui.TuiControlId.Create(2), 'Save', Tui.TuiAction.Create(20)),
                                                                                                                                      Tui.TuiMenuItem.WithShortcut(Tui.TuiControlId.Create(3), 'Quit', Tui.TuiAction.Create(30), 'Ctrl+Q')
                                                                                                                                    ])
                                                                                               ]);
end function;

function UpdateMenu(State: MenuModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): MenuModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return MenuModel(Focus := Id.Value, Actions := State.Actions);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return MenuModel(Focus := State.Focus, Actions := Arrays.Concat(State.Actions, [
                                                                                         Action.Value
                                                                                       ]));
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 4));
  mutable var Model: MenuModel := MenuModel(Focus := 1, Actions := []);
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 0, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(10, Model.Actions[0]);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Tab));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertEquals(3, Model.Focus);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Space));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertEquals(2, Arrays.Length(Model.Actions));
  Test.AssertEquals(30, Model.Actions[1]);
  App.Close();
end program;
