program TuiMenuBarLayoutTest;

uses Std.Test as Test;
uses Std.Tui as Tui;

begin
  var Measured: Tui.TuiMeasureResult := Tui.TuiMeasure(Tui.TuiElementBuilders.MakeMenuBar([
                                                                                            Tui.TuiMenuItem.Create(Tui.TuiControlId.Create(1), 'Open', Tui.TuiAction.Create(10)),
                                                                                            Tui.TuiMenuItem.Disabled(Tui.TuiControlId.Create(2), 'Save', Tui.TuiAction.Create(20))
                                                                                          ]), Tui.TuiMeasureSpec.Unbounded());
  Test.AssertEquals(12, Measured.Preferred.Width);
  Test.AssertEquals(1, Measured.Preferred.Height);
end program;
