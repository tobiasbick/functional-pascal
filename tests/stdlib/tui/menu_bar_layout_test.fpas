program TuiMenuBarLayoutTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Layout as Layout;

begin
  const Measured: Tui.TuiMeasureResult := Tui.TuiMeasure(Elements.TuiElementMakeMenuBar([
                                                                                          Chrome.TuiMenuItemCreate(Ids.TuiControlIdCreate(1), 'Open', Ids.TuiActionCreate(10)),
                                                                                          Chrome.TuiMenuItemDisabled(Ids.TuiControlIdCreate(2), 'Save', Ids.TuiActionCreate(20))
                                                                                        ]), Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(12, Measured.Preferred.Width);
  Test.AssertEquals(1, Measured.Preferred.Height);
end program;
