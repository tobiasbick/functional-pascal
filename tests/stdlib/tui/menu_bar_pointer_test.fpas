program TuiMenuBarPointerTest;

uses Std.Array, Std.Str, Std.Test, Std.Tui;

type
  MenuModel = record
    Focus: integer;
    Actions: array of integer;
  end;

function FindGlyph(Snapshot: TuiSurfaceSnapshot; Glyph: string): TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
  begin
    var Index: integer := Std.Str.IndexOf(Snapshot.LineAt(Y), Glyph);
    if Index >= 0 then
    begin
      return TuiPoint.Create(Index, Y)
    end
  end;
  panic('glyph not found in snapshot')
end;

function ViewMenu(State: MenuModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakeMenuBar([

                                                                                                                   TuiMenuItem.Create(TuiControlId.Create(1), 'Open', TuiAction.Create(10)),

                                                                                                                   TuiMenuItem.Disabled(TuiControlId.Create(2), 'Save', TuiAction.Create(20)),

                                                                                                                   TuiMenuItem.Create(TuiControlId.Create(3), 'Quit', TuiAction.Create(30))



                                                                                                                 ])

                                                                                ])
end;

function UpdateMenu(State: MenuModel; Msg: TuiMsg; Cmd: TuiCmdOutput): MenuModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.FocusChanged(Previous, Current):
    begin
      case Current of
        Some(Id):
        begin
          return record Focus := Id.Value; Actions := State.Actions; end
        end;
        None:
        begin
          return State
        end
      end
    end;
    TuiMsg.Action(Source, Action):
    begin
      return record
        Focus := State.Focus;
        Actions := Std.Array.Concat(State.Actions, [Action.Value]);
      end
    end;
    TuiMsg.Key(Key), TuiMsg.Pointer(Pointer), TuiMsg.Tick(Delta), TuiMsg.Resize(Size), TuiMsg.TextChanged(Source, Action, Text, Caret), TuiMsg.TextAreaChanged(Source, Action, Text, Caret, TextAreaOffset), TuiMsg.CheckChanged(Source, Action, Checked), TuiMsg.SelectionChanged(Source, Action, Selected), TuiMsg.ScrollChanged(Source, Action, Offset), TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState), TuiMsg.QuitRequested:
    begin
      return State
    end
  end
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  mutable var Model: MenuModel := record Focus := 3; Actions := []; end;
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 0, 0);
  var OpenAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Open');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, OpenAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  AssertEquals(1, Model.Focus);
  AssertEquals(1, Std.Array.Length(Model.Actions));
  AssertEquals(10, Model.Actions[0]);
  var SaveAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Save');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, SaveAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  AssertEquals(1, Std.Array.Length(Model.Actions));
  App.Close()
end.
