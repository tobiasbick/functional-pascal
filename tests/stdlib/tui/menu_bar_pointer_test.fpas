program TuiMenuBarPointerTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type MenuModel = record
  Focus: integer;
  Actions: array of (integer);
end record;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Index: integer := Str.IndexOf(Rendering.TuiSurfaceSnapshotLineAt(Snapshot, Y), Glyph);
      if Index >= 0 then
        begin
          return Geometry.TuiPointCreate(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewMenu(State: MenuModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakeMenuBar([
                                                                                                                             Chrome.TuiMenuItemCreate(Ids.TuiControlIdCreate(1), 'Open', Ids.TuiActionCreate(10)),
                                                                                                                             Chrome.TuiMenuItemDisabled(Ids.TuiControlIdCreate(2), 'Save', Ids.TuiActionCreate(20)),
                                                                                                                             Chrome.TuiMenuItemCreate(Ids.TuiControlIdCreate(3), 'Quit', Ids.TuiActionCreate(30))
                                                                                                                           ])
                                                                                          ]);
end function;

function UpdateMenu(State: MenuModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): MenuModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return MenuModel(Focus := Id.Value, Actions := State.Actions);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return MenuModel(Focus := State.Focus, Actions := Arrays.Concat(State.Actions, [
                                                                                         Action.Value
                                                                                       ]));
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 4));
  var Model: MenuModel := MenuModel(Focus := 3, Actions := []);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 0, 0);
  const OpenAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(App), 'Open');
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, OpenAt));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertEquals(1, Model.Focus);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(10, Model.Actions[0]);
  const SaveAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(App), 'Save');
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, SaveAt));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Runtime.TuiApplicationClose(App);
end program;
