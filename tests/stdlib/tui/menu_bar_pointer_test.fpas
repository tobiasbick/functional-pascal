program TuiMenuBarPointerTest;

uses Std.Test as Test, Std.Tui as Tui;

type MenuModel = record
  Focus: integer;
  Actions: array of integer;
end record;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Index: integer := Snapshot.LineAt(Y).IndexOf(Glyph);
      if Index >= 0 then
        begin
          return Tui.TuiPoint.Create(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewMenu(State: MenuModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(State.Focus)), [
                                                                                          Tui.TuiElementBuilders.MakeMenuBar([
                                                                                                                               Tui.TuiMenuItem.Create(Tui.TuiControlId.Create(1), 'Open', Tui.TuiAction.Create(10)),
                                                                                                                               Tui.TuiMenuItem.Disabled(Tui.TuiControlId.Create(2), 'Save', Tui.TuiAction.Create(20)),
                                                                                                                               Tui.TuiMenuItem.Create(Tui.TuiControlId.Create(3), 'Quit', Tui.TuiAction.Create(30))
                                                                                                                             ])
                                                                                        ]);
end function;

function UpdateMenu(State: MenuModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): MenuModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return MenuModel(Focus := Id.Value, Actions := State.Actions);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return MenuModel(Focus := State.Focus, Actions := State.Actions.Concat([Action.Value]));
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 4));
  var Model: MenuModel := MenuModel(Focus := 3, Actions := []);
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 0, 0);
  const OpenAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Open');
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, OpenAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 2, 0);
  Test.AssertEquals(1, Model.Focus);
  Test.AssertEquals(1, Model.Actions.Length());
  Test.AssertEquals(10, Model.Actions[0]);
  const SaveAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Save');
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, SaveAt));
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 1, 0);
  Test.AssertEquals(1, Model.Actions.Length());
  App.Close();
end.
