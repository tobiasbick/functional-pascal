program TuiMenuBarSnapshotTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type MenuModel = record
end record;

function ViewMenu(State: MenuModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeMenuBar([
                                                                                                                   Chrome.TuiMenuItemCreate(Ids.TuiControlIdCreate(1), 'Open', Ids.TuiActionCreate(10)),
                                                                                                                   Chrome.TuiMenuItemDisabled(Ids.TuiControlIdCreate(2), 'Save', Ids.TuiActionCreate(20))
                                                                                                                 ])
                                                                                ]);
end function;

function UpdateMenu(State: MenuModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): MenuModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(20, 3));
  var Model: MenuModel := MenuModel();
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateMenu, ViewMenu, 0, 0);
  const Surface: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Surface, 0), ' Open  Save '));
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Surface, 0, 0).Role =
                  Tui.TuiStyleRole.MenuSelected);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Surface, 7, 0).Role =
                  Tui.TuiStyleRole.MenuDisabled);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Surface, 19, 0).Role =
                  Tui.TuiStyleRole.MenuNormal);
  Runtime.TuiApplicationClose(App);
end program;
