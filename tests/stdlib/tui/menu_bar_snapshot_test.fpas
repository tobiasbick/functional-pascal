program TuiMenuBarSnapshotTest;

uses Std.Str, Std.Test, Std.Tui;

type
  MenuModel = record
  end;

function ViewMenu(State: MenuModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakeMenuBar([

                                                                                                         TuiMenuItem.Create(TuiControlId.Create(1), 'Open', TuiAction.Create(10)),

                                                                                                         TuiMenuItem.Disabled(TuiControlId.Create(2), 'Save', TuiAction.Create(20))



                                                                                                       ])

                                                                      ])
end;

function UpdateMenu(State: MenuModel; Msg: TuiMsg; Cmd: TuiCmdOutput): MenuModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.Key(Key), TuiMsg.Pointer(Pointer), TuiMsg.Tick(Delta), TuiMsg.Resize(Size), TuiMsg.FocusChanged(Previous, Current), TuiMsg.Action(Source, Action), TuiMsg.TextChanged(Source, Action, Text, Caret), TuiMsg.TextAreaChanged(Source, Action, Text, Caret, TextAreaOffset), TuiMsg.CheckChanged(Source, Action, Checked), TuiMsg.SelectionChanged(Source, Action, Selected), TuiMsg.ScrollChanged(Source, Action, Offset), TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState), TuiMsg.QuitRequested:
    begin
      return State
    end
  end
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 3));
  mutable var Model: MenuModel := record end;
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 0, 0);
  var Surface: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertTrue(Std.Str.Contains(Surface.LineAt(0), ' Open  Save '));
  AssertTrue(Surface.CellAt(0, 0).Role = TuiStyleRole.MenuSelected);
  AssertTrue(Surface.CellAt(7, 0).Role = TuiStyleRole.MenuDisabled);
  AssertTrue(Surface.CellAt(19, 0).Role = TuiStyleRole.MenuNormal);
  App.Close()
end.
