program TuiMenuBarSnapshotTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type MenuModel = record
end record;

function ViewMenu(State: MenuModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Option.Some(Tui.TuiControlId.Create(1)), [
                                                                                       Tui.TuiElementBuilders.MakeMenuBar([
                                                                                                                            Tui.TuiMenuItem.Create(Tui.TuiControlId.Create(1), 'Open', Tui.TuiAction.Create(10)),
                                                                                                                            Tui.TuiMenuItem.Disabled(Tui.TuiControlId.Create(2), 'Save', Tui.TuiAction.Create(20))
                                                                                                                          ])
                                                                                     ]);
end function;

function UpdateMenu(State: MenuModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): MenuModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 3));
  mutable var Model: MenuModel := MenuModel();
  Model := App.RunIterations(Model, UpdateMenu, ViewMenu, 0, 0);
  var Surface: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertTrue(Str.Contains(Surface.LineAt(0), ' Open  Save '));
  Test.AssertTrue(Surface.CellAt(0, 0).Role = Tui.TuiStyleRole.MenuSelected);
  Test.AssertTrue(Surface.CellAt(7, 0).Role = Tui.TuiStyleRole.MenuDisabled);
  Test.AssertTrue(Surface.CellAt(19, 0).Role = Tui.TuiStyleRole.MenuNormal);
  App.Close();
end program;
