program TuiMessageFifoTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;
uses Std.Tui as Tui;

type FifoModel = record
  Events: array of string;
  SeenCmdWasNoCommand: boolean;
end record;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end record;
end function;

function PushEvent(State: FifoModel; InputEvent: string; CmdWasNoCommand: boolean): FifoModel;
begin
  return record
    Events := Arrays.Concat(State.Events, [InputEvent]);
    SeenCmdWasNoCommand := State.SeenCmdWasNoCommand and CmdWasNoCommand;
  end record;
end function;

function ViewFifo(State: FifoModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(1)), [
                                                                                Tui.TuiElementBuilders.MakePanel('Host', [
                                                                                                                           Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(1), 'Go', Tui.TuiAction.Create(7))
                                                                                                                         ])
                                                                              ]);
end function;

function UpdateFifo(State: FifoModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): FifoModel;
begin
  var ResetOk: boolean := Cmd.Command() = Tui.TuiCmd.NoCommand;
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Tick(Delta):
      begin
        return PushEvent(State, 'tick', ResetOk);
      end;
    when Tui.TuiMsg.Action(Source, Action):
      begin
        return PushEvent(State, 'action', ResetOk);
      end;
    when Tui.TuiMsg.FocusChanged(Previous, Current):
      begin
        return PushEvent(State, 'focus', ResetOk);
      end;
    when Tui.TuiMsg.Key(Key):
      begin
        return PushEvent(State, 'key', ResetOk);
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 6));
  mutable var Model: FifoModel := record
    Events := [];
    SeenCmdWasNoCommand := true;
  end record;

  Model := App.RunIterations(Model, UpdateFifo, ViewFifo, 0, 0);
  App.Inject(Tui.TuiMsg.Tick(1));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, ''));
  App.Inject(Tui.TuiMsg.Tick(2));
  Model := App.RunIterations(Model, UpdateFifo, ViewFifo, 3, 0);
  Test.AssertEquals(3, Arrays.Length(Model.Events));
  Test.AssertEquals('tick', Model.Events[0]);
  Test.AssertEquals('action', Model.Events[1]);
  Test.AssertEquals('tick', Model.Events[2]);
  Test.AssertTrue(Model.SeenCmdWasNoCommand);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Tab, ''));
  App.Inject(Tui.TuiMsg.Tick(3));
  Model := App.RunIterations(Model, UpdateFifo, ViewFifo, 1, 0);
  Test.AssertEquals(4, Arrays.Length(Model.Events));
  Test.AssertEquals('focus', Model.Events[3]);
  Model := App.RunIterations(Model, UpdateFifo, ViewFifo, 1, 0);
  Test.AssertEquals(5, Arrays.Length(Model.Events));
  Test.AssertEquals('tick', Model.Events[4]);
  Test.AssertTrue(Model.SeenCmdWasNoCommand);
  App.Close();
end program;
