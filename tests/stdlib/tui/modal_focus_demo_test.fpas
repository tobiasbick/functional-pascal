program TuiModalFocusDemoTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type DemoModel = record
  Focus: integer;
end record;

function Key(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function UpdateDemo(State: DemoModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): DemoModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return DemoModel(Focus := Id.Value);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function ViewDemo(State: DemoModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakePanel('Host', [
                                                                                                                                   Elements.TuiElementMakeInput(Ids.TuiControlIdCreate(1), '', 0, Ids.TuiActionCreate(1))
                                                                                                                                 ]),
                                                                                            Elements.TuiElementMakeOverlay('Confirm', [
                                                                                                                                        Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(2), 'Yes', Ids.TuiActionCreate(2)),
                                                                                                                                        Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(3), 'No', Ids.TuiActionCreate(3))
                                                                                                                                      ])
                                                                                          ]);
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(40, 12));
  var Model: DemoModel := DemoModel(Focus := 2);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateDemo, ViewDemo, 0, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, Key(Tui.TuiKeyKind.Tab));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateDemo, ViewDemo, 1, 0);
  Test.AssertEquals(3, Model.Focus);
  Runtime.TuiApplicationInjectKeyForTest(App, Key(Tui.TuiKeyKind.Tab));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateDemo, ViewDemo, 1, 0);
  Test.AssertEquals(2, Model.Focus);
  Runtime.TuiApplicationClose(App);
end program;
