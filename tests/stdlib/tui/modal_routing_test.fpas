program TuiModalRoutingTest;

uses Std.Test as Test, Std.Ui.Terminal as Tui;

type ModalModel = record
  Focus: integer;
  ConfirmOpen: boolean;
  Actions: array of integer;
  PointerHits: integer;
end record;

function MakePointer(Action: Tui.TuiPointerAction; X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Tui.TuiPointerEvent.Create(Action, Tui.TuiPointerButton.Left, Tui.TuiPoint.Create(X, Y));
end function;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(
    kind := Kind,
    ch := Character,
    shift := false,
    ctrl := false,
    alt := false,
    meta := false
  );
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Line: string := Snapshot.LineAt(Y);
      case Line.IndexOf(Glyph) of
        when Some(const Index):
          return Tui.TuiPoint.Create(Index, Y);
        when None:
          null;
      end case;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewModal(State: ModalModel): Tui.TuiElement;
begin
  var Overlay: Tui.TuiElement := Tui.TuiElementBuilders.MakeEmpty();
  if State.ConfirmOpen then
    begin
      Overlay := Tui.TuiElementBuilders.MakeOverlay(
        'Confirm', [
          Tui.TuiElementBuilders.MakeRow([
            Tui.TuiElementBuilders.MakeButton(
              Tui.TuiControlId.Create(3),
              'Yes',
              Tui.TuiAction.Create(30)
            ),
            Tui.TuiElementBuilders.MakeButton(
              Tui.TuiControlId.Create(4),
              'No',
              Tui.TuiAction.Create(40)
            )
          ])
        ]
      );
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(
    Some(Tui.TuiControlId.Create(State.Focus)), [
      Tui.TuiElementBuilders.MakePanel(
        'Host', [
          Tui.TuiElementBuilders.MakeButton(
            Tui.TuiControlId.Create(1),
            'Save',
            Tui.TuiAction.Create(10)
          )
        ]
      ),
      Overlay
    ]
  );
end function;

function UpdateModal(State: ModalModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ModalModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return ModalModel(
                Focus := Id.Value,
                ConfirmOpen := State.ConfirmOpen,
                Actions := State.Actions,
                PointerHits := State.PointerHits
              );
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        if Action.Value = 10 then
          begin
            return ModalModel(
              Focus := 3, ConfirmOpen := true, Actions := State.Actions.Concat([
                Action.Value
              ]), PointerHits := State.PointerHits
            );
          end;
        end if;

        return ModalModel(
          Focus := 1, ConfirmOpen := false, Actions := State.Actions.Concat([
            Action.Value
          ]), PointerHits := State.PointerHits
        );
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return ModalModel(
          Focus := State.Focus, ConfirmOpen := State.ConfirmOpen, Actions := State.Actions,
          PointerHits := State.PointerHits +
          1
        );
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(40, 12));
  var Model: ModalModel := ModalModel(
    Focus := 1,
    ConfirmOpen := false,
    Actions := [],
    PointerHits := 0
  );
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 0, 0);
  const SaveAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Save');
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Down, SaveAt.X, SaveAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Up, SaveAt.X, SaveAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertTrue(Model.ConfirmOpen);
  Test.AssertEquals(10, Model.Actions[0]);
  Test.AssertEquals(3, Model.Focus);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down, ''));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertEquals(4, Model.Focus);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Up, ''));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertEquals(3, Model.Focus);
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Down, SaveAt.X, SaveAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertEquals(2, Model.PointerHits);
  Test.AssertEquals(1, Model.Actions.Length());
  Test.AssertTrue(Model.ConfirmOpen);
  const YesAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Yes');
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Down, YesAt.X, YesAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Up, YesAt.X, YesAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertFalse(Model.ConfirmOpen);
  Test.AssertEquals(2, Model.Actions.Length());
  Test.AssertEquals(30, Model.Actions[1]);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Tab, ''));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertEquals(1, Model.Focus);
  App.Close();
end.
