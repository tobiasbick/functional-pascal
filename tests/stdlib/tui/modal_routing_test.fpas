program TuiModalRoutingTest;

uses Std.Arrays, Std.Str, Std.Test, Std.Tui;

type ModalModel = record
  Focus: integer;
  ConfirmOpen: boolean;
  Actions: array of integer;
  PointerHits: integer;
end record;

function MakePointer(Action: TuiPointerAction; X: integer; Y: integer): TuiPointerEvent;
begin
  return TuiPointerEvent.Create(Action, TuiPointerButton.Left, TuiPoint.Create(X, Y));
end function;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
end function;

function FindGlyph(Snapshot: TuiSurfaceSnapshot; Glyph: string): TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Line: string := Snapshot.LineAt(Y);
      const Index: integer := Std.Str.IndexOf(Line, Glyph);
      if Index >= 0 then
        begin
          return TuiPoint.Create(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewModal(State: ModalModel): TuiElement;
begin
  var Overlay: TuiElement := TuiElementBuilders.MakeEmpty();
  if State.ConfirmOpen then
    begin
      Overlay := TuiElementBuilders.MakeOverlay('Confirm', [
                                                             TuiElementBuilders.MakeRow([
                                                                                          TuiElementBuilders.MakeButton(TuiControlId.Create(3), 'Yes', TuiAction.Create(30)),
                                                                                          TuiElementBuilders.MakeButton(TuiControlId.Create(4), 'No', TuiAction.Create(40))
                                                                                        ])
                                                           ]);
    end;
  end if;

  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakePanel('Host', [
                                                                                                                         TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'Save', TuiAction.Create(10))
                                                                                                                       ]),
                                                                                  Overlay
                                                                                ]);
end function;

function UpdateModal(State: ModalModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ModalModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.FocusChanged(Previous, Current):
      begin
        case Current of
          when Some(Id):
            begin
              return record
                Focus := Id.Value;
                ConfirmOpen := State.ConfirmOpen;
                Actions := State.Actions;
                PointerHits := State.PointerHits;
              end;
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.Action(Source, Action):
      begin
        if Action.Value = 10 then
          begin
            return record
              Focus := 3;
              ConfirmOpen := true;
              Actions := Std.Arrays.Concat(State.Actions, [Action.Value]);
              PointerHits := State.PointerHits;
            end;
          end;
        end if;

        return record
          Focus := 1;
          ConfirmOpen := false;
          Actions := Std.Arrays.Concat(State.Actions, [Action.Value]);
          PointerHits := State.PointerHits;
        end;
      end;
    when TuiMsg.Pointer(Pointer):
      begin
        return record
          Focus := State.Focus;
          ConfirmOpen := State.ConfirmOpen;
          Actions := State.Actions;
          PointerHits := State.PointerHits + 1;
        end;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 12));
  var Model: ModalModel := record
    Focus := 1;
    ConfirmOpen := false;
    Actions := [];
    PointerHits := 0;
  end;

  Model := App.RunIterations(Model, UpdateModal, ViewModal, 0, 0);
  const SaveAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Save');
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Down, SaveAt.X, SaveAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Up, SaveAt.X, SaveAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  AssertTrue(Model.ConfirmOpen);
  AssertEquals(10, Model.Actions[0]);
  AssertEquals(3, Model.Focus);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down, ''));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  AssertEquals(4, Model.Focus);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Up, ''));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  AssertEquals(3, Model.Focus);
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Down, SaveAt.X, SaveAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  AssertEquals(2, Model.PointerHits);
  AssertEquals(1, Std.Arrays.Length(Model.Actions));
  AssertTrue(Model.ConfirmOpen);
  const YesAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Yes');
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Down, YesAt.X, YesAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  App.InjectPointerForTest(MakePointer(TuiPointerAction.Up, YesAt.X, YesAt.Y));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  AssertFalse(Model.ConfirmOpen);
  AssertEquals(2, Std.Arrays.Length(Model.Actions));
  AssertEquals(30, Model.Actions[1]);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Tab, ''));
  Model := App.RunIterations(Model, UpdateModal, ViewModal, 1, 0);
  AssertEquals(1, Model.Focus);
  App.Close();
end.
