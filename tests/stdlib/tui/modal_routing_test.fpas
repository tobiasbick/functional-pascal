program TuiModalRoutingTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type ModalModel = record
  Focus: integer;
  ConfirmOpen: boolean;
  Actions: array of (integer);
  PointerHits: integer;
end record;

function MakePointer(Action: Tui.TuiPointerAction; X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Runtime.TuiPointerEventCreate(Action, Tui.TuiPointerButton.Left, Geometry.TuiPointCreate(X, Y));
end function;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Line: string := Rendering.TuiSurfaceSnapshotLineAt(Snapshot, Y);
      const Index: integer := Str.IndexOf(Line, Glyph);
      if Index >= 0 then
        begin
          return Geometry.TuiPointCreate(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewModal(State: ModalModel): Tui.TuiElement;
begin
  var Overlay: Tui.TuiElement := Elements.TuiElementMakeEmpty();
  if State.ConfirmOpen then
    begin
      Overlay := Elements.TuiElementMakeOverlay('Confirm', [
                                                             Elements.TuiElementMakeRow([
                                                                                          Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(3), 'Yes', Ids.TuiActionCreate(30)),
                                                                                          Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(4), 'No', Ids.TuiActionCreate(40))
                                                                                        ])
                                                           ]);
    end;
  end if;

  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakePanel('Host', [
                                                                                                                                   Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(1), 'Save', Ids.TuiActionCreate(10))
                                                                                                                                 ]),
                                                                                            Overlay
                                                                                          ]);
end function;

function UpdateModal(State: ModalModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ModalModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return ModalModel(Focus := Id.Value, ConfirmOpen := State.ConfirmOpen, Actions := State.Actions, PointerHits := State.PointerHits);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        if Action.Value = 10 then
          begin
            return ModalModel(Focus := 3, ConfirmOpen := true, Actions := Arrays.Concat(State.Actions, [
                                                                                                         Action.Value
                                                                                                       ]), PointerHits := State.PointerHits);
          end;
        end if;

        return ModalModel(Focus := 1, ConfirmOpen := false, Actions := Arrays.Concat(State.Actions, [
                                                                                                      Action.Value
                                                                                                    ]), PointerHits := State.PointerHits);
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return ModalModel(Focus := State.Focus, ConfirmOpen := State.ConfirmOpen, Actions := State.Actions, PointerHits := State.PointerHits +
                                                                                                                           1);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(40, 12));
  var Model: ModalModel := ModalModel(Focus := 1, ConfirmOpen := false, Actions := [], PointerHits := 0);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateModal, ViewModal, 0, 0);
  const SaveAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(App), 'Save');
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Down, SaveAt.X, SaveAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateModal, ViewModal, 1, 0);
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Up, SaveAt.X, SaveAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertTrue(Model.ConfirmOpen);
  Test.AssertEquals(10, Model.Actions[0]);
  Test.AssertEquals(3, Model.Focus);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Down, ''));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertEquals(4, Model.Focus);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Up, ''));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertEquals(3, Model.Focus);
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Down, SaveAt.X, SaveAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertEquals(2, Model.PointerHits);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertTrue(Model.ConfirmOpen);
  const YesAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(App), 'Yes');
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Down, YesAt.X, YesAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateModal, ViewModal, 1, 0);
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Up, YesAt.X, YesAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertFalse(Model.ConfirmOpen);
  Test.AssertEquals(2, Arrays.Length(Model.Actions));
  Test.AssertEquals(30, Model.Actions[1]);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Tab, ''));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateModal, ViewModal, 1, 0);
  Test.AssertEquals(1, Model.Focus);
  Runtime.TuiApplicationClose(App);
end program;
