program MvuHostSignatureTest;

// Phase 0: prove the exact generic RunIterations / Update / View callable pattern.
uses Std.Tui as Tui;
uses Std.Test as Test;

type CounterModel = record
  Value: integer;
end record;

function UpdateCounter(State: CounterModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): CounterModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Tick(Delta):
      begin
        return record
          Value := State.Value + 1;
        end record;
      end;
    when Tui.TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return State;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return State;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function ViewCounter(State: CounterModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel('count');
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(40, 12));
  var FinalModel: CounterModel := App.RunIterations(record
    Value := 0;
  end record, UpdateCounter, ViewCounter, 3, 16);
  Test.AssertEquals(3, FinalModel.Value);
  App.Close();
end program;
