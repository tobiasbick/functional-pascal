program MvuHostSignatureTest;

// Phase 0: prove the exact generic RunIterations / Update / View callable pattern.
uses Std.Tui as Tui;
uses Std.Test as Test;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Runtime as Runtime;

type CounterModel = record
  Value: integer;
end record;

function UpdateCounter(State: CounterModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): CounterModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return CounterModel(Value := State.Value + 1);
      end;
    when Tui.TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
        return State;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
        return State;
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _):
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function ViewCounter(State: CounterModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeLabel('count');
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(40, 12));
  const FinalModel: CounterModel := Runtime.TuiApplicationRunIterations(App, CounterModel(Value := 0), UpdateCounter, ViewCounter, 3, 16);
  Test.AssertEquals(3, FinalModel.Value);
  Runtime.TuiApplicationClose(App);
end program;
