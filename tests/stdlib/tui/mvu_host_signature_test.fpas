program MvuHostSignatureTest;

// Phase 0: prove the exact generic RunIterations / Update / View callable pattern.
uses Std.Tui, Std.Test;

type CounterModel = record
  Value: integer;
end record;

function UpdateCounter(State: CounterModel; Msg: TuiMsg; Cmd: TuiCmdOutput): CounterModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.Tick(Delta):
      begin
        return CounterModel(Value := State.Value + 1);
      end;
    when TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
      begin
        Cmd.Set(TuiCmd.Quit);
        return State;
      end;
    when TuiMsg.QuitRequested:
      begin
        Cmd.Set(TuiCmd.Quit);
        return State;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function ViewCounter(State: CounterModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel('count');
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 12));
  const FinalModel: CounterModel := App.RunIterations(CounterModel(Value := 0), UpdateCounter, ViewCounter, 3, 16);
  AssertEquals(3, FinalModel.Value);
  App.Close();
end.
