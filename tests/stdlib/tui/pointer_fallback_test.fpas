program TuiPointerFallbackTest;

uses Std.Test, Std.Tui;

type PointerModel = record
  Events: array of string;
  X: integer;
  Y: integer;
  Action: TuiPointerAction;
  Button: TuiPointerButton;
end record;

function PushEvent(State: PointerModel; InputEvent: string): PointerModel;
begin
  return PointerModel(Events := State.Events.Concat([InputEvent]), X := State.X, Y := State.Y, Action := State.Action, Button := State.Button);
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 8));
  const Pointer: TuiPointerEvent := TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, TuiPoint.Create(3, 4));
  App.Inject(TuiMsg.Tick(1));
  App.InjectPointerForTest(Pointer);
  App.Inject(TuiMsg.Tick(2));
  var Model: PointerModel := PointerModel(Events := [], X := -1, Y := -1, Action := TuiPointerAction.Unknown, Button := TuiPointerButton.Left);
  Model := App.RunIterations(Model, function(State: PointerModel; Msg: TuiMsg; Cmd: TuiCmdOutput): PointerModel begin
    Cmd.Set(TuiCmd.NoCommand);
    case Msg of
      when TuiMsg.Tick(const Delta):
        begin
          if Delta = 1 then
            begin
              return PushEvent(State, 'tick-1');
            end;
          end if;

          return PushEvent(State, 'tick-2');
        end;
      when TuiMsg.Pointer(const InputEvent):
        begin
          return PointerModel(Events := State.Events.Concat(['pointer']), X := InputEvent.Position.X, Y := InputEvent.Position.Y, Action := InputEvent.Action, Button := InputEvent.Button);
        end;
      when TuiMsg.Started, TuiMsg.Key(_), TuiMsg.Resize(_), TuiMsg.FocusChanged(_, _), TuiMsg.Action(_, _), TuiMsg.TextChanged(_, _, _, _), TuiMsg.TextAreaChanged(_, _, _, _, _), TuiMsg.CheckChanged(_, _, _), TuiMsg.SelectionChanged(_, _, _), TuiMsg.ScrollChanged(_, _, _), TuiMsg.MenuChanged(_, _, _), TuiMsg.BackgroundFailed(_, _, _, _, _, _), TuiMsg.QuitRequested:
        begin
          return State;
        end;
    end case;
  end function, function(State: PointerModel): TuiElement begin
    return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                          TuiElementBuilders.MakePanel('Host', [
                                                                                                                 TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'Go', TuiAction.Create(1))
                                                                                                               ])
                                                                        ]);
  end function, 3, 0);
  AssertEquals(3, Model.Events.Length());
  AssertEquals('tick-1', Model.Events[0]);
  AssertEquals('pointer', Model.Events[1]);
  AssertEquals('tick-2', Model.Events[2]);
  AssertEquals(3, Model.X);
  AssertEquals(4, Model.Y);
  AssertTrue(Model.Action = TuiPointerAction.Move);
  AssertTrue(Model.Button = TuiPointerButton.NoButton);
  App.Close();
end.
