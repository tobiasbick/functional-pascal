program TuiPointerFallbackTest;

uses Std.Array, Std.Test, Std.Tui;

type
  PointerModel = record
    Events: array of string;
    X: integer;
    Y: integer;
    Action: TuiPointerAction;
    Button: TuiPointerButton;
  end;

function PushEvent(State: PointerModel; Event: string): PointerModel;
begin
  return record
    Events := Std.Array.Concat(State.Events, [Event]);
    X := State.X;
    Y := State.Y;
    Action := State.Action;
    Button := State.Button;
  end
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 8));
  var Pointer: TuiPointerEvent := TuiPointerEvent.Create(TuiPointerAction.Move, TuiPointerButton.NoButton, TuiPoint.Create(3, 4));
  App.Inject(TuiMsg.Tick(1));
  App.InjectPointerForTest(Pointer);
  App.Inject(TuiMsg.Tick(2));
  mutable var Model: PointerModel := record
    Events := [];
    X := -1;
    Y := -1;
    Action := TuiPointerAction.Unknown;
    Button := TuiPointerButton.Left;
  end;
  Model := App.RunIterations(Model, function(State: PointerModel; Msg: TuiMsg; Cmd: TuiCmdOutput): PointerModel begin
    Cmd.Set(TuiCmd.NoCommand);
    case Msg of
      TuiMsg.Tick(Delta):
      begin
        if Delta = 1 then
        begin
          return PushEvent(State, 'tick-1')
        end;
        return PushEvent(State, 'tick-2')
      end;
      TuiMsg.Pointer(Event):
      begin
        return record
          Events := Std.Array.Concat(State.Events, ['pointer']);
          X := Event.Position.X;
          Y := Event.Position.Y;
          Action := Event.Action;
          Button := Event.Button;
        end
      end;
      TuiMsg.Key(Key), TuiMsg.Resize(Size), TuiMsg.FocusChanged(Previous, Current), TuiMsg.Action(Source, Action), TuiMsg.TextChanged(Source, Action, Text, Caret), TuiMsg.CheckChanged(Source, Action, Checked), TuiMsg.SelectionChanged(Source, Action, Selected), TuiMsg.ScrollChanged(Source, Action, Offset), TuiMsg.QuitRequested:
      begin
        return State
      end
    end
  end, function(State: PointerModel): TuiElement begin
    return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                          TuiElementBuilders.MakeWindow('Host', [

                                                                                                                  TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'Go', TuiAction.Create(1))

                                                                          

                                                                                                                ])

                                                                        ])
  end, 3, 0);
  AssertEquals(3, Std.Array.Length(Model.Events));
  AssertEquals('tick-1', Model.Events[0]);
  AssertEquals('pointer', Model.Events[1]);
  AssertEquals('tick-2', Model.Events[2]);
  AssertEquals(3, Model.X);
  AssertEquals(4, Model.Y);
  AssertTrue(Model.Action = TuiPointerAction.Move);
  AssertTrue(Model.Button = TuiPointerButton.NoButton);
  App.Close()
end.
