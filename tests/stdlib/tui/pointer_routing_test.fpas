program TuiPointerRoutingTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type RouteModel = record
  Focus: integer;
  Actions: array of integer;
  PointerHits: integer;
end record;

function MakePointer(Action: Tui.TuiPointerAction; X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Tui.TuiPointerEvent.Create(Action, Tui.TuiPointerButton.Left, Tui.TuiPoint.Create(X, Y));
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      var Line: string := Snapshot.LineAt(Y);
      var Index: integer := Str.IndexOf(Line, Glyph);
      if Index >= 0 then
        begin
          return Tui.TuiPoint.Create(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewRoute(State: RouteModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(State.Focus)), [
                                                                                          Tui.TuiElementBuilders.MakePanel('Host', [
                                                                                                                                     Tui.TuiElementBuilders.MakeColumn([
                                                                                                                                                                         Tui.TuiElementBuilders.MakeLabel('Hello'),
                                                                                                                                                                         Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(1), 'Go', Tui.TuiAction.Create(11)),
                                                                                                                                                                         Tui.TuiElementBuilders.MakeInput(Tui.TuiControlId.Create(2), 'ab', 2, Tui.TuiAction.Create(22))
                                                                                                                                                                       ])
                                                                                                                                   ])
                                                                                        ]);
end function;

function ViewOverlap(State: RouteModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(State.Focus)), [
                                                                                          Tui.TuiElementBuilders.MakePanel('Back', [
                                                                                                                                     Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(1), 'Back', Tui.TuiAction.Create(11))
                                                                                                                                   ]),
                                                                                          Tui.TuiElementBuilders.MakePanel('Top', [
                                                                                                                                    Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(3), 'Front', Tui.TuiAction.Create(33))
                                                                                                                                  ])
                                                                                        ]);
end function;

function UpdateRoute(State: RouteModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): RouteModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(Previous, Current):
      begin
        case Current of
          when Some(Id):
            begin
              return record
                Focus := Id.Value;
                Actions := State.Actions;
                PointerHits := State.PointerHits;
              end record;
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(Source, Action):
      begin
        if Action.Value = 33 then
          begin
            Test.AssertEquals(3, State.Focus);
          end;
        end if;

        return record
          Focus := State.Focus;
          Actions := Arrays.Concat(State.Actions, [Action.Value]);
          PointerHits := State.PointerHits;
        end record;
      end;
    when Tui.TuiMsg.Pointer(Pointer):
      begin
        return record
          Focus := State.Focus;
          Actions := State.Actions;
          PointerHits := State.PointerHits + 1;
        end record;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 8));
  mutable var Model: RouteModel := record
    Focus := 1;
    Actions := [];
    PointerHits := 0;
  end record;

  Model := App.RunIterations(Model, UpdateRoute, ViewRoute, 0, 0);
  var Snapshot: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  var GoAt: Tui.TuiPoint := FindGlyph(Snapshot, 'Go');
  var InputAt: Tui.TuiPoint := FindGlyph(Snapshot, 'ab');
  var HelloAt: Tui.TuiPoint := FindGlyph(Snapshot, 'Hello');
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Down, GoAt.X, GoAt.Y));
  Model := App.RunIterations(Model, UpdateRoute, ViewRoute, 1, 0);
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Up, GoAt.X, GoAt.Y));
  Model := App.RunIterations(Model, UpdateRoute, ViewRoute, 1, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(11, Model.Actions[0]);
  Test.AssertEquals(1, Model.Focus);
  Test.AssertEquals(1, Model.PointerHits);
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Down, InputAt.X, InputAt.Y));
  Model := App.RunIterations(Model, UpdateRoute, ViewRoute, 2, 0);
  Test.AssertEquals(2, Model.Focus);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(1, Model.PointerHits);
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Down, HelloAt.X, HelloAt.Y));
  Model := App.RunIterations(Model, UpdateRoute, ViewRoute, 1, 0);
  Test.AssertEquals(2, Model.PointerHits);
  App.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Down, 0, 0));
  Model := App.RunIterations(Model, UpdateRoute, ViewRoute, 1, 0);
  Test.AssertEquals(3, Model.PointerHits);
  App.Close();
  mutable var Overlap: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 6));
  Model := record
    Focus := 1;
    Actions := [];
    PointerHits := 0;
  end record;

  Model := Overlap.RunIterations(Model, UpdateRoute, ViewOverlap, 0, 0);
  var FrontAt: Tui.TuiPoint := FindGlyph(Overlap.SurfaceSnapshot(), 'Front');
  Overlap.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Down, FrontAt.X, FrontAt.Y));
  Model := Overlap.RunIterations(Model, UpdateRoute, ViewOverlap, 2, 0);
  Test.AssertEquals(3, Model.Focus);
  Overlap.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Up, FrontAt.X, FrontAt.Y));
  Model := Overlap.RunIterations(Model, UpdateRoute, ViewOverlap, 1, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(33, Model.Actions[0]);
  Overlap.InjectPointerForTest(MakePointer(Tui.TuiPointerAction.Down, 19, FrontAt.Y));
  Model := Overlap.RunIterations(Model, UpdateRoute, ViewOverlap, 1, 0);
  Test.AssertEquals(2, Model.PointerHits);
  Overlap.Close();
end program;
