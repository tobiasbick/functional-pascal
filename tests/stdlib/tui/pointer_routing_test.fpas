program TuiPointerRoutingTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type RouteModel = record
  Focus: integer;
  Actions: array of (integer);
  PointerHits: integer;
end record;

function MakePointer(Action: Tui.TuiPointerAction; X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Runtime.TuiPointerEventCreate(Action, Tui.TuiPointerButton.Left, Geometry.TuiPointCreate(X, Y));
end function;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Line: string := Rendering.TuiSurfaceSnapshotLineAt(Snapshot, Y);
      const Index: integer := Str.IndexOf(Line, Glyph);
      if Index >= 0 then
        begin
          return Geometry.TuiPointCreate(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewRoute(State: RouteModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakePanel('Host', [
                                                                                                                                   Elements.TuiElementMakeColumn([
                                                                                                                                                                   Elements.TuiElementMakeLabel('Hello'),
                                                                                                                                                                   Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(1), 'Go', Ids.TuiActionCreate(11)),
                                                                                                                                                                   Elements.TuiElementMakeInput(Ids.TuiControlIdCreate(2), 'ab', 2, Ids.TuiActionCreate(22))
                                                                                                                                                                 ])
                                                                                                                                 ])
                                                                                          ]);
end function;

function ViewOverlap(State: RouteModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakePanel('Back', [
                                                                                                                                   Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(1), 'Back', Ids.TuiActionCreate(11))
                                                                                                                                 ]),
                                                                                            Elements.TuiElementMakePanel('Top', [
                                                                                                                                  Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(3), 'Front', Ids.TuiActionCreate(33))
                                                                                                                                ])
                                                                                          ]);
end function;

function UpdateRoute(State: RouteModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): RouteModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return RouteModel(Focus := Id.Value, Actions := State.Actions, PointerHits := State.PointerHits);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        if Action.Value = 33 then
          begin
            Test.AssertEquals(3, State.Focus);
          end;
        end if;

        return RouteModel(Focus := State.Focus, Actions := Arrays.Concat(State.Actions, [
                                                                                          Action.Value
                                                                                        ]), PointerHits := State.PointerHits);
      end;
    when Tui.TuiMsg.Pointer(const Pointer):
      begin
        return RouteModel(Focus := State.Focus, Actions := State.Actions, PointerHits := State.PointerHits +
                                                                                         1);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(20, 8));
  var Model: RouteModel := RouteModel(Focus := 1, Actions := [], PointerHits := 0);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateRoute, ViewRoute, 0, 0);
  const Snapshot: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  const GoAt: Tui.TuiPoint := FindGlyph(Snapshot, 'Go');
  const InputAt: Tui.TuiPoint := FindGlyph(Snapshot, 'ab');
  const HelloAt: Tui.TuiPoint := FindGlyph(Snapshot, 'Hello');
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Down, GoAt.X, GoAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateRoute, ViewRoute, 1, 0);
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Up, GoAt.X, GoAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateRoute, ViewRoute, 1, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(11, Model.Actions[0]);
  Test.AssertEquals(1, Model.Focus);
  Test.AssertEquals(1, Model.PointerHits);
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Down, InputAt.X, InputAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateRoute, ViewRoute, 2, 0);
  Test.AssertEquals(2, Model.Focus);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(1, Model.PointerHits);
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Down, HelloAt.X, HelloAt.Y));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateRoute, ViewRoute, 1, 0);
  Test.AssertEquals(2, Model.PointerHits);
  Runtime.TuiApplicationInjectPointerForTest(App, MakePointer(Tui.TuiPointerAction.Down, 0, 0));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateRoute, ViewRoute, 1, 0);
  Test.AssertEquals(3, Model.PointerHits);
  Runtime.TuiApplicationClose(App);
  var Overlap: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(20, 6));
  Model := RouteModel(Focus := 1, Actions := [], PointerHits := 0);
  Model := Runtime.TuiApplicationRunIterations(Overlap, Model, UpdateRoute, ViewOverlap, 0, 0);
  const FrontAt: Tui.TuiPoint := FindGlyph(Runtime.TuiApplicationSurfaceSnapshot(Overlap), 'Front');
  Runtime.TuiApplicationInjectPointerForTest(Overlap, MakePointer(Tui.TuiPointerAction.Down, FrontAt.X, FrontAt.Y));
  Model := Runtime.TuiApplicationRunIterations(Overlap, Model, UpdateRoute, ViewOverlap, 2, 0);
  Test.AssertEquals(3, Model.Focus);
  Runtime.TuiApplicationInjectPointerForTest(Overlap, MakePointer(Tui.TuiPointerAction.Up, FrontAt.X, FrontAt.Y));
  Model := Runtime.TuiApplicationRunIterations(Overlap, Model, UpdateRoute, ViewOverlap, 1, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(33, Model.Actions[0]);
  Runtime.TuiApplicationInjectPointerForTest(Overlap, MakePointer(Tui.TuiPointerAction.Down, 19, FrontAt.Y));
  Model := Runtime.TuiApplicationRunIterations(Overlap, Model, UpdateRoute, ViewOverlap, 1, 0);
  Test.AssertEquals(2, Model.PointerHits);
  Runtime.TuiApplicationClose(Overlap);
end program;
