program TuiQuitOrderTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type QuitModel = record
  LabelText: string;
  Quit: boolean;
  Updates: integer;
end record;

function ViewQuit(State: QuitModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel(State.LabelText);
end function;

function UpdateQuit(State: QuitModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): QuitModel;
begin
  Test.AssertTrue(Cmd.Command() = Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.MenuChanged(MenuSource, MenuAction, MenuState):
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return record
          LabelText := 'SHOULD NOT PAINT';
          Quit := true;
          Updates := State.Updates + 1;
        end record;
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Cmd.Set(Tui.TuiCmd.Quit);
        return record
          LabelText := 'SHOULD NOT PAINT';
          Quit := true;
          Updates := State.Updates + 1;
        end record;
      end;
    when Tui.TuiMsg.Tick(Delta):
      begin
        return record
          LabelText := 'after-tick';
          Quit := false;
          Updates := State.Updates + 1;
        end record;
      end;
    else
      begin
        return record
          LabelText := State.LabelText;
          Quit := State.Quit;
          Updates := State.Updates + 1;
        end record;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 4));
  mutable var Model: QuitModel := record
    LabelText := 'before';
    Quit := false;
    Updates := 0;
  end record;

  Model := App.RunIterations(Model, UpdateQuit, ViewQuit, 0, 0);
  Test.AssertTrue(Str.Contains(App.SurfaceSnapshot().LineAt(0), 'before'));
  App.Inject(Tui.TuiMsg.QuitRequested);
  App.Inject(Tui.TuiMsg.Tick(1));
  Model := App.RunIterations(Model, UpdateQuit, ViewQuit, 5, 0);
  Test.AssertTrue(Model.Quit);
  Test.AssertEquals(1, Model.Updates);
  Test.AssertTrue(Str.Contains(App.SurfaceSnapshot().LineAt(0), 'before'));
  Test.AssertFalse(Str.Contains(App.SurfaceSnapshot().LineAt(0), 'SHOULD NOT PAINT'));
  Test.AssertFalse(Str.Contains(App.SurfaceSnapshot().LineAt(0), 'after-tick'));
  App.Close();
end program;
