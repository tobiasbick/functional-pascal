program TuiQuitOrderTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type QuitModel = record
  LabelText: string;
  Quit: boolean;
  Updates: integer;
end record;

function ViewQuit(State: QuitModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeLabel(State.LabelText);
end function;

function UpdateQuit(State: QuitModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): QuitModel;
begin
  Test.AssertTrue(Runtime.TuiCmdOutputCommand(Cmd) = Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
        return QuitModel(LabelText := 'SHOULD NOT PAINT', Quit := true, Updates := State.Updates + 1);
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.Quit);
        return QuitModel(LabelText := 'SHOULD NOT PAINT', Quit := true, Updates := State.Updates + 1);
      end;
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return QuitModel(LabelText := 'after-tick', Quit := false, Updates := State.Updates + 1);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _):
      begin
        begin
          return QuitModel(LabelText := State.LabelText, Quit := State.Quit, Updates := State.Updates +
                                                                                        1);
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(20, 4));
  var Model: QuitModel := QuitModel(LabelText := 'before', Quit := false, Updates := 0);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateQuit, ViewQuit, 0, 0);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'before'));
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.QuitRequested);
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.Tick(1));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateQuit, ViewQuit, 5, 0);
  Test.AssertTrue(Model.Quit);
  Test.AssertEquals(1, Model.Updates);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'before'));
  Test.AssertFalse(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'SHOULD NOT PAINT'));
  Test.AssertFalse(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'after-tick'));
  Runtime.TuiApplicationClose(App);
end program;
