program TuiQuitOrderTest;

uses Std.Test, Std.Tui;

type QuitModel = record
  LabelText: string;
  Quit: boolean;
  Updates: integer;
end record;

function ViewQuit(State: QuitModel): TuiElement;
begin
  return TuiElementBuilders.MakeLabel(State.LabelText);
end function;

function UpdateQuit(State: QuitModel; Msg: TuiMsg; Cmd: TuiCmdOutput): QuitModel;
begin
  AssertTrue(Cmd.Command() = TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.MenuChanged(const MenuSource, const MenuAction, const MenuState):
      begin
        Cmd.Set(TuiCmd.Quit);
        return QuitModel(LabelText := 'SHOULD NOT PAINT', Quit := true, Updates := State.Updates + 1);
      end;
    when TuiMsg.QuitRequested:
      begin
        Cmd.Set(TuiCmd.Quit);
        return QuitModel(LabelText := 'SHOULD NOT PAINT', Quit := true, Updates := State.Updates + 1);
      end;
    when TuiMsg.Tick(const Delta):
      begin
        return QuitModel(LabelText := 'after-tick', Quit := false, Updates := State.Updates + 1);
      end;
    else
      begin
        return QuitModel(LabelText := State.LabelText, Quit := State.Quit, Updates := State.Updates +
                                                                                      1);
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 4));
  var Model: QuitModel := QuitModel(LabelText := 'before', Quit := false, Updates := 0);
  Model := App.RunIterations(Model, UpdateQuit, ViewQuit, 0, 0);
  AssertTrue(App.SurfaceSnapshot().LineAt(0).Contains('before'));
  App.Inject(TuiMsg.QuitRequested);
  App.Inject(TuiMsg.Tick(1));
  Model := App.RunIterations(Model, UpdateQuit, ViewQuit, 5, 0);
  AssertTrue(Model.Quit);
  AssertEquals(1, Model.Updates);
  AssertTrue(App.SurfaceSnapshot().LineAt(0).Contains('before'));
  AssertFalse(App.SurfaceSnapshot().LineAt(0).Contains('SHOULD NOT PAINT'));
  AssertFalse(App.SurfaceSnapshot().LineAt(0).Contains('after-tick'));
  App.Close();
end.
