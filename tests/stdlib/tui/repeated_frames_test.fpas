program RepeatedFramesTest;

uses Std.Arrays as Arrays;
uses Std.Tui as Tui;
uses Std.Test as Test;

function UpdateFrames(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Tick(Delta):
      begin
        return State + 1;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function ViewFrames(State: integer): Tui.TuiElement;
begin
  mutable var Children: array of Tui.TuiElement := [];
  for Index: integer := 1 to 32 do
    begin
      Arrays.Push(Children, Tui.TuiElementBuilders.MakeLabel('row'));
    end;
  end for;
  var SharedAction: Tui.TuiAction := Tui.TuiAction.Create(100);
  for Index: integer := 1 to 8 do
    begin
      Arrays.Push(Children, Tui.TuiElementBuilders.MakeButton(Tui.TuiControlId.Create(Index), 'action', SharedAction));
    end;
  end for;

  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(1)), [
                                                                                Tui.TuiElementBuilders.MakePanel('Repeated frames', [Tui.TuiElementBuilders.MakeColumn(Children)])
                                                                              ]);
end function;

begin
  mutable var Small: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(40, 12));
  var SmallResult: integer := Small.RunIterations(0, UpdateFrames, ViewFrames, 100, 16);
  Test.AssertEquals(100, SmallResult);
  Test.AssertEquals(40, Small.SurfaceSnapshot().Width);
  Small.Close();
  mutable var Large: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(120, 40));
  var LargeResult: integer := Large.RunIterations(0, UpdateFrames, ViewFrames, 100, 16);
  Test.AssertEquals(100, LargeResult);
  Test.AssertEquals(120, Large.SurfaceSnapshot().Width);
  Large.Close();
end program;
