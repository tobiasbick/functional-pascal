program RepeatedFramesTest;

uses Std.Arrays as Arrays;
uses Std.Tui as Tui;
uses Std.Test as Test;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

function UpdateFrames(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Tick(const Delta):
      begin
        return State + 1;
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function ViewFrames(State: integer): Tui.TuiElement;
begin
  var Children: array of (Tui.TuiElement) := [];
  for Index: integer := 1 to 32 do
    begin
      Arrays.Push(var Children, Elements.TuiElementMakeLabel('row'));
    end;
  end for;
  const SharedAction: Tui.TuiAction := Ids.TuiActionCreate(100);
  for Index: integer := 1 to 8 do
    begin
      Arrays.Push(var Children, Elements.TuiElementMakeButton(Ids.TuiControlIdCreate(Index), 'action', SharedAction));
    end;
  end for;

  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakePanel('Repeated frames', [Elements.TuiElementMakeColumn(Children)])
                                                                                ]);
end function;

begin
  var Small: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(40, 12));
  const SmallResult: integer := Runtime.TuiApplicationRunIterations(Small, 0, UpdateFrames, ViewFrames, 100, 16);
  Test.AssertEquals(100, SmallResult);
  Test.AssertEquals(40, Runtime.TuiApplicationSurfaceSnapshot(Small).Width);
  Runtime.TuiApplicationClose(Small);
  var Large: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(120, 40));
  const LargeResult: integer := Runtime.TuiApplicationRunIterations(Large, 0, UpdateFrames, ViewFrames, 100, 16);
  Test.AssertEquals(100, LargeResult);
  Test.AssertEquals(120, Runtime.TuiApplicationSurfaceSnapshot(Large).Width);
  Runtime.TuiApplicationClose(Large);
end program;
