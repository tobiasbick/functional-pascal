program RepeatedFramesTest;

uses Std.Array, Std.Tui, Std.Test;

function UpdateFrames(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.Tick(Delta):
    begin
      return State + 1
    end
    else
    begin
      return State
    end
  end
end;

function ViewFrames(State: integer): TuiElement;
begin
  mutable var Children: array of TuiElement := [];
  for Index: integer := 1 to 32 do
  begin
    Std.Array.Push(Children, TuiElementBuilders.MakeLabel('row'))
  end;
  var SharedAction: TuiAction := TuiAction.Create(100);
  for Index: integer := 1 to 8 do
  begin
    Std.Array.Push(Children, TuiElementBuilders.MakeButton(TuiControlId.Create(Index), 'action', SharedAction))
  end;

  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakePanel('Repeated frames', [TuiElementBuilders.MakeColumn(Children)])
                                                                      ])
end;

begin
  mutable var Small: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 12));
  var SmallResult: integer := Small.RunIterations(0, UpdateFrames, ViewFrames, 100, 16);
  AssertEquals(100, SmallResult);
  AssertEquals(40, Small.SurfaceSnapshot().Width);
  Small.Close();
  mutable var Large: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(120, 40));
  var LargeResult: integer := Large.RunIterations(0, UpdateFrames, ViewFrames, 100, 16);
  AssertEquals(100, LargeResult);
  AssertEquals(120, Large.SurfaceSnapshot().Width);
  Large.Close()
end.
