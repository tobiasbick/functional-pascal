program TuiResizeMessageTest;

uses Std.Test, Std.Tui;

type ResizeModel = record
  Events: array of string;
  ResizeWidth: integer;
  ResizeHeight: integer;
  HostWidthAtResize: integer;
  HostHeightAtResize: integer;
end record;

function PushEvent(State: ResizeModel; InputEvent: string): ResizeModel;
begin
  return ResizeModel(Events := State.Events.Concat([InputEvent]), ResizeWidth := State.ResizeWidth, ResizeHeight := State.ResizeHeight, HostWidthAtResize := State.HostWidthAtResize, HostHeightAtResize := State.HostHeightAtResize);
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 6));
  AssertEquals(20, App.SurfaceSnapshot().Width);
  AssertEquals(6, App.SurfaceSnapshot().Height);
  App.Inject(TuiMsg.Tick(1));
  App.InjectResizeForTest(TuiSize.Create(32, 10));
  App.Inject(TuiMsg.Tick(2));
  var Model: ResizeModel := ResizeModel(Events := [], ResizeWidth := 0, ResizeHeight := 0, HostWidthAtResize := 0, HostHeightAtResize := 0);
  Model := App.RunIterations(Model, function(State: ResizeModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ResizeModel begin
    Cmd.Set(TuiCmd.NoCommand);
    case Msg of
      when TuiMsg.Tick(Delta):
        begin
          if Delta = 1 then
            begin
              return PushEvent(State, 'tick-1');
            end;
          end if;

          return PushEvent(State, 'tick-2');
        end;
      when TuiMsg.Resize(Size):
        begin
          const Snapshot: TuiSurfaceSnapshot := App.SurfaceSnapshot();
          return ResizeModel(Events := State.Events.Concat(['resize']), ResizeWidth := Size.Width, ResizeHeight := Size.Height, HostWidthAtResize := Snapshot.Width, HostHeightAtResize := Snapshot.Height);
        end;
      else
        begin
          return State;
        end;
    end case;
  end function, function(State: ResizeModel): TuiElement begin
    return TuiElementBuilders.MakeLabel('resize');
  end function, 3, 0);
  AssertEquals(3, Model.Events.Length());
  AssertEquals('tick-1', Model.Events[0]);
  AssertEquals('resize', Model.Events[1]);
  AssertEquals('tick-2', Model.Events[2]);
  AssertEquals(32, Model.ResizeWidth);
  AssertEquals(10, Model.ResizeHeight);
  AssertEquals(32, Model.HostWidthAtResize);
  AssertEquals(10, Model.HostHeightAtResize);
  AssertEquals(32, App.SurfaceSnapshot().Width);
  AssertEquals(10, App.SurfaceSnapshot().Height);
  App.Close();
  const Probe: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(1, 1));
  AssertEquals(2, Probe.Slot);
end.
