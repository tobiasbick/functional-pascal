program TuiResizeMessageTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type ResizeModel = record
  Events: array of (string);
  ResizeWidth: integer;
  ResizeHeight: integer;
  HostWidthAtResize: integer;
  HostHeightAtResize: integer;
end record;

function PushEvent(State: ResizeModel; InputEvent: string): ResizeModel;
begin
  return ResizeModel(Events := Arrays.Concat(State.Events, [InputEvent]), ResizeWidth := State.ResizeWidth, ResizeHeight := State.ResizeHeight, HostWidthAtResize := State.HostWidthAtResize, HostHeightAtResize := State.HostHeightAtResize);
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(20, 6));
  Test.AssertEquals(20, Runtime.TuiApplicationSurfaceSnapshot(App).Width);
  Test.AssertEquals(6, Runtime.TuiApplicationSurfaceSnapshot(App).Height);
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.Tick(1));
  Runtime.TuiApplicationInjectResizeForTest(App, Geometry.TuiSizeCreate(32, 10));
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.Tick(2));
  var Model: ResizeModel := ResizeModel(Events := [], ResizeWidth := 0, ResizeHeight := 0, HostWidthAtResize := 0, HostHeightAtResize := 0);
  Model := Runtime.TuiApplicationRunIterations(App, Model, function(State: ResizeModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ResizeModel begin
    Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
    case Msg of
      when Tui.TuiMsg.Tick(const Delta):
        begin
          if Delta = 1 then
            begin
              return PushEvent(State, 'tick-1');
            end;
          end if;

          return PushEvent(State, 'tick-2');
        end;
      when Tui.TuiMsg.Resize(const Size):
        begin
          const Snapshot: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
          return ResizeModel(Events := Arrays.Concat(State.Events, ['resize']), ResizeWidth := Size.Width, ResizeHeight := Size.Height, HostWidthAtResize := Snapshot.Width, HostHeightAtResize := Snapshot.Height);
        end;
      when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
        begin
          begin
            return State;
          end;
        end;
    end case;
  end function, function(State: ResizeModel): Tui.TuiElement begin
    return Elements.TuiElementMakeLabel('resize');
  end function, 3, 0);
  Test.AssertEquals(3, Arrays.Length(Model.Events));
  Test.AssertEquals('tick-1', Model.Events[0]);
  Test.AssertEquals('resize', Model.Events[1]);
  Test.AssertEquals('tick-2', Model.Events[2]);
  Test.AssertEquals(32, Model.ResizeWidth);
  Test.AssertEquals(10, Model.ResizeHeight);
  Test.AssertEquals(32, Model.HostWidthAtResize);
  Test.AssertEquals(10, Model.HostHeightAtResize);
  Test.AssertEquals(32, Runtime.TuiApplicationSurfaceSnapshot(App).Width);
  Test.AssertEquals(10, Runtime.TuiApplicationSurfaceSnapshot(App).Height);
  Runtime.TuiApplicationClose(App);
  const Probe: Tui.TuiWorkingSurface := Rendering.TuiWorkingSurfaceCreate(Geometry.TuiSizeCreate(1, 1));
  Test.AssertEquals(2, Probe.Slot);
end program;
