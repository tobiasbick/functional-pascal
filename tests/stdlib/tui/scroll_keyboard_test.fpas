program TuiScrollKeyboardTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;
uses Std.Tui as Tui;

type ScrollModel = record
  Offset: Tui.TuiPoint;
  Changes: array of (integer);
end record;

function MakeKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewScroll(State: ScrollModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Option.Some(Tui.TuiControlId.Create(1)), [
                                                                                       Tui.TuiElementBuilders.MakeScroll(Tui.TuiControlId.Create(1), State.Offset, Tui.TuiAction.Create(7), Tui.TuiElementBuilders.MakeColumn([
                                                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('One'),
                                                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('Two'),
                                                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('Three'),
                                                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('Four'),
                                                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('Five'),
                                                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('Six')
                                                                                                                                                                                                                              ]))
                                                                                     ]);
end function;

function UpdateScroll(State: ScrollModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ScrollModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(7, Action.Value);
        return ScrollModel(Offset := Offset, Changes := Arrays.Concat(State.Changes, [Offset.Y]));
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(12, 3));
  mutable var Model: ScrollModel := ScrollModel(Offset := Tui.TuiPoint.Create(0, 0), Changes := []);
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 0, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(1, Model.Offset.Y);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.PageDown));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(3, Model.Offset.Y);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Home));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(0, Model.Offset.Y);
  Test.AssertEquals(3, Arrays.Length(Model.Changes));
  App.Close();
end program;
