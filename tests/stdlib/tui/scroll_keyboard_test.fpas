program TuiScrollKeyboardTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type ScrollModel = record
  Offset: Tui.TuiPoint;
  Changes: array of (integer);
end record;

function MakeKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewScroll(State: ScrollModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeScroll(Ids.TuiControlIdCreate(1), State.Offset, Ids.TuiActionCreate(7), Elements.TuiElementMakeColumn([
                                                                                                                                                                                                                 Elements.TuiElementMakeLabel('One'),
                                                                                                                                                                                                                 Elements.TuiElementMakeLabel('Two'),
                                                                                                                                                                                                                 Elements.TuiElementMakeLabel('Three'),
                                                                                                                                                                                                                 Elements.TuiElementMakeLabel('Four'),
                                                                                                                                                                                                                 Elements.TuiElementMakeLabel('Five'),
                                                                                                                                                                                                                 Elements.TuiElementMakeLabel('Six')
                                                                                                                                                                                                               ]))
                                                                                ]);
end function;

function UpdateScroll(State: ScrollModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ScrollModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(7, Action.Value);
        return ScrollModel(Offset := Offset, Changes := Arrays.Concat(State.Changes, [Offset.Y]));
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(12, 3));
  var Model: ScrollModel := ScrollModel(Offset := Geometry.TuiPointCreate(0, 0), Changes := []);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 0, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Down));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(1, Model.Offset.Y);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.PageDown));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(3, Model.Offset.Y);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Home));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(0, Model.Offset.Y);
  Test.AssertEquals(3, Arrays.Length(Model.Changes));
  Runtime.TuiApplicationClose(App);
end program;
