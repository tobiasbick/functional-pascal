program TuiScrollKeyboardTest;

uses Std.Array, Std.Test, Std.Tui;

type
  ScrollModel = record
    Offset: TuiPoint;
    Changes: array of integer;
  end;

function MakeKey(Kind: TuiKeyKind): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function ViewScroll(State: ScrollModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakeScroll(TuiControlId.Create(1), State.Offset, TuiAction.Create(7), TuiElementBuilders.MakeColumn([

                                                                                                                                                                                                 TuiElementBuilders.MakeLabel('One'),

                                                                                                                                                                                                 TuiElementBuilders.MakeLabel('Two'),

                                                                                                                                                                                                 TuiElementBuilders.MakeLabel('Three'),

                                                                                                                                                                                                 TuiElementBuilders.MakeLabel('Four'),

                                                                                                                                                                                                 TuiElementBuilders.MakeLabel('Five'),

                                                                                                                                                                                                 TuiElementBuilders.MakeLabel('Six')

                                                                        

                                                                                                                                                                                               ]))

                                                                      ])
end;

function UpdateScroll(State: ScrollModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ScrollModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.ScrollChanged(Source, Action, Offset):
    begin
      AssertEquals(1, Source.Value);
      AssertEquals(7, Action.Value);
      return record Offset := Offset; Changes := Std.Array.Concat(State.Changes, [Offset.Y]); end
    end;
    TuiMsg.Key(Key), TuiMsg.Pointer(Pointer), TuiMsg.Tick(Delta), TuiMsg.Resize(Size), TuiMsg.FocusChanged(Previous, Current), TuiMsg.Action(Source, Action), TuiMsg.TextChanged(Source, Action, Text, Caret), TuiMsg.CheckChanged(Source, Action, Checked), TuiMsg.SelectionChanged(Source, Action, Selected), TuiMsg.QuitRequested:
    begin
      return State
    end
  end
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(12, 3));
  mutable var Model: ScrollModel := record Offset := TuiPoint.Create(0, 0); Changes := []; end;
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 0, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  AssertEquals(1, Model.Offset.Y);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.PageDown));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  AssertEquals(3, Model.Offset.Y);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Home));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  AssertEquals(0, Model.Offset.Y);
  AssertEquals(3, Std.Array.Length(Model.Changes));
  App.Close()
end.
