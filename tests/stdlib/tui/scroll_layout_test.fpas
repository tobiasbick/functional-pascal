program TuiScrollLayoutTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Layout as Layout;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type ScrollModel = record
  Offset: Tui.TuiPoint;
end record;

function ScrollChild(): Tui.TuiElement;
begin
  return Elements.TuiElementMakeColumn([
                                         Elements.TuiElementMakeLabel('One'),
                                         Elements.TuiElementMakeLabel('Two'),
                                         Elements.TuiElementMakeLabel('Three'),
                                         Elements.TuiElementMakeLabel('Four'),
                                         Elements.TuiElementMakeLabel('Five')
                                       ]);
end function;

function ViewScroll(State: ScrollModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeScroll(Ids.TuiControlIdCreate(1), State.Offset, Ids.TuiActionCreate(7), ScrollChild())
                                                                                ]);
end function;

function UpdateScroll(State: ScrollModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ScrollModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  const Scroll: Tui.TuiElement := Elements.TuiElementMakeScroll(Ids.TuiControlIdCreate(1), Geometry.TuiPointCreate(0, 0), Ids.TuiActionCreate(7), ScrollChild());
  const Measured: Tui.TuiMeasureResult := Tui.TuiMeasure(Scroll, Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(1, Measured.Minimum.Width);
  Test.AssertEquals(1, Measured.Minimum.Height);
  Test.AssertEquals(5, Measured.Preferred.Width);
  Test.AssertEquals(5, Measured.Preferred.Height);
  const Constrained: Tui.TuiMeasureResult := Tui.TuiMeasure(Scroll, Layout.TuiMeasureSpecAtMost(Geometry.TuiSizeCreate(1, 1)));
  Test.AssertEquals(1, Constrained.Preferred.Width);
  Test.AssertEquals(1, Constrained.Preferred.Height);
  const FixedViewport: Tui.TuiElement := Elements.TuiElementMakeLayout(Layout.TuiLayoutSettingsWithFixedHeight(Layout.TuiLayoutSettingsDefault(), 2), Elements.TuiElementMakeScroll(Ids.TuiControlIdCreate(1), Geometry.TuiPointCreate(0, 0), Ids.TuiActionCreate(7), ScrollChild()));
  const FixedMeasured: Tui.TuiMeasureResult := Tui.TuiMeasure(FixedViewport, Layout.TuiMeasureSpecUnbounded());
  Test.AssertEquals(2, FixedMeasured.Minimum.Height);
  Test.AssertEquals(2, FixedMeasured.Preferred.Height);
  Test.AssertEquals(2, FixedMeasured.Maximum.Height);
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(12, 5));
  var Model: ScrollModel := ScrollModel(Offset := Geometry.TuiPointCreate(0, 4));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 0, 0);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'One'));
  Runtime.TuiApplicationInjectResizeForTest(App, Geometry.TuiSizeCreate(12, 2));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(12, Runtime.TuiApplicationSurfaceSnapshot(App).Width);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'Four'));
  Runtime.TuiApplicationClose(App);
end program;
