program TuiScrollPointerTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type ScrollModel = record
  Focus: integer;
  Offset: Tui.TuiPoint;
end record;

function MakeDownPointer(X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, Geometry.TuiPointCreate(X, Y));
end function;

function MakeKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewScroll(State: ScrollModel): Tui.TuiElement;
begin
  var Focused: Option of (Tui.TuiControlId) := Option.None;
  if State.Focus > 0 then
    begin
      Focused := Option.Some(Ids.TuiControlIdCreate(State.Focus));
    end;
  end if;

  return Elements.TuiElementMakeDesktop(Focused, [
                                                   Elements.TuiElementMakeScroll(Ids.TuiControlIdCreate(1), State.Offset, Ids.TuiActionCreate(7), Elements.TuiElementMakeColumn([
                                                                                                                                                                                  Elements.TuiElementMakeLabel('One'),
                                                                                                                                                                                  Elements.TuiElementMakeLabel('Two'),
                                                                                                                                                                                  Elements.TuiElementMakeLabel('Three'),
                                                                                                                                                                                  Elements.TuiElementMakeLabel('Four')
                                                                                                                                                                                ]))
                                                 ]);
end function;

function UpdateScroll(State: ScrollModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ScrollModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return ScrollModel(Focus := Id.Value, Offset := State.Offset);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return ScrollModel(Focus := State.Focus, Offset := Offset);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(12, 2));
  var Model: ScrollModel := ScrollModel(Focus := 0, Offset := Geometry.TuiPointCreate(0, 0));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 0, 0);
  Runtime.TuiApplicationInjectPointerForTest(App, MakeDownPointer(10, 1));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(1, Model.Focus);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Down));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(1, Model.Offset.Y);
  Runtime.TuiApplicationClose(App);
end program;
