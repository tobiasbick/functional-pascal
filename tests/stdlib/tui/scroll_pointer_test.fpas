program TuiScrollPointerTest;

uses Std.Test, Std.Tui;

type ScrollModel = record
  Focus: integer;
  Offset: TuiPoint;
end record;

function MakeDownPointer(X: integer; Y: integer): TuiPointerEvent;
begin
  return TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(X, Y));
end function;

function MakeKey(Kind: TuiKeyKind): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewScroll(State: ScrollModel): TuiElement;
begin
  var Focused: option of TuiControlId := None;
  if State.Focus > 0 then
    begin
      Focused := Some(TuiControlId.Create(State.Focus));
    end;
  end if;

  return TuiElementBuilders.MakeDesktop(Focused, [
                                                   TuiElementBuilders.MakeScroll(TuiControlId.Create(1), State.Offset, TuiAction.Create(7), TuiElementBuilders.MakeColumn([
                                                                                                                                                                            TuiElementBuilders.MakeLabel('One'),
                                                                                                                                                                            TuiElementBuilders.MakeLabel('Two'),
                                                                                                                                                                            TuiElementBuilders.MakeLabel('Three'),
                                                                                                                                                                            TuiElementBuilders.MakeLabel('Four')
                                                                                                                                                                          ]))
                                                 ]);
end function;

function UpdateScroll(State: ScrollModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ScrollModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return ScrollModel(Focus := Id.Value, Offset := State.Offset);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return ScrollModel(Focus := State.Focus, Offset := Offset);
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(12, 2));
  var Model: ScrollModel := ScrollModel(Focus := 0, Offset := TuiPoint.Create(0, 0));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 0, 0);
  App.InjectPointerForTest(MakeDownPointer(10, 1));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  AssertEquals(1, Model.Focus);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  AssertEquals(1, Model.Offset.Y);
  App.Close();
end.
