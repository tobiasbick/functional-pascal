program TuiScrollPointerTest;

uses Std.Test as Test;
uses Std.Tui as Tui;

type ScrollModel = record
  Focus: integer;
  Offset: Tui.TuiPoint;
end record;

function MakeDownPointer(X: integer; Y: integer): Tui.TuiPointerEvent;
begin
  return Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, Tui.TuiPoint.Create(X, Y));
end function;

function MakeKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewScroll(State: ScrollModel): Tui.TuiElement;
begin
  mutable var Focused: Option of (Tui.TuiControlId) := Option.None;
  if State.Focus > 0 then
    begin
      Focused := Option.Some(Tui.TuiControlId.Create(State.Focus));
    end;
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(Focused, [
                                                       Tui.TuiElementBuilders.MakeScroll(Tui.TuiControlId.Create(1), State.Offset, Tui.TuiAction.Create(7), Tui.TuiElementBuilders.MakeColumn([
                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('One'),
                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('Two'),
                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('Three'),
                                                                                                                                                                                                Tui.TuiElementBuilders.MakeLabel('Four')
                                                                                                                                                                                              ]))
                                                     ]);
end function;

function UpdateScroll(State: ScrollModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ScrollModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return ScrollModel(Focus := Id.Value, Offset := State.Offset);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return ScrollModel(Focus := State.Focus, Offset := Offset);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(12, 2));
  mutable var Model: ScrollModel := ScrollModel(Focus := 0, Offset := Tui.TuiPoint.Create(0, 0));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 0, 0);
  App.InjectPointerForTest(MakeDownPointer(10, 1));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(1, Model.Focus);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertEquals(1, Model.Offset.Y);
  App.Close();
end program;
