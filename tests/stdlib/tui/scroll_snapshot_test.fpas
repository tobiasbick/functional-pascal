program TuiScrollSnapshotTest;

uses Std.Test, Std.Tui;

type ScrollModel = record
  Offset: TuiPoint;
end record;

function ViewScroll(State: ScrollModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakeScroll(TuiControlId.Create(1), State.Offset, TuiAction.Create(7), TuiElementBuilders.MakeColumn([
                                                                                                                                                                                                 TuiElementBuilders.MakeLabel('First'),
                                                                                                                                                                                                 TuiElementBuilders.MakeLabel('Second'),
                                                                                                                                                                                                 TuiElementBuilders.MakeLabel('Third')
                                                                                                                                                                                               ]))
                                                                      ]);
end function;

function UpdateScroll(State: ScrollModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ScrollModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  if Msg is TuiMsg.ScrollChanged(const Source, const Action, const Offset) then
    begin
      return ScrollModel(Offset := Offset);
    end;
  else
    begin
      return State;
    end;
  end if;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(12, 2));
  var Model: ScrollModel := ScrollModel(Offset := TuiPoint.Create(0, 0));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 0, 0);
  AssertTrue(App.SurfaceSnapshot().LineAt(0).Contains('First'));
  App.Inject(TuiMsgScrollChanged(TuiControlId.Create(1), TuiAction.Create(7), TuiPoint.Create(0, 1)));
  Model := App.RunIterations(Model, UpdateScroll, ViewScroll, 1, 0);
  AssertTrue(App.SurfaceSnapshot().LineAt(0).Contains('Second'));
  AssertFalse(App.SurfaceSnapshot().LineAt(0).Contains('First'));
  App.Close();
end.
