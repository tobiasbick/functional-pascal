program TuiScrollSnapshotTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type ScrollModel = record
  Offset: Tui.TuiPoint;
end record;

function ViewScroll(State: ScrollModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeScroll(Ids.TuiControlIdCreate(1), State.Offset, Ids.TuiActionCreate(7), Elements.TuiElementMakeColumn([
                                                                                                                                                                                                                 Elements.TuiElementMakeLabel('First'),
                                                                                                                                                                                                                 Elements.TuiElementMakeLabel('Second'),
                                                                                                                                                                                                                 Elements.TuiElementMakeLabel('Third')
                                                                                                                                                                                                               ]))
                                                                                ]);
end function;

function UpdateScroll(State: ScrollModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ScrollModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      begin
        return ScrollModel(Offset := Offset);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(12, 2));
  var Model: ScrollModel := ScrollModel(Offset := Geometry.TuiPointCreate(0, 0));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 0, 0);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'First'));
  Runtime.TuiApplicationInject(App, Tui.TuiMsgScrollChanged(Ids.TuiControlIdCreate(1), Ids.TuiActionCreate(7), Geometry.TuiPointCreate(0, 1)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateScroll, ViewScroll, 1, 0);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'Second'));
  Test.AssertFalse(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 0), 'First'));
  Runtime.TuiApplicationClose(App);
end program;
