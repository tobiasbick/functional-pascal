program TuiStatusLineKeyboardTest;

uses Std.Test, Std.Tui;

type StatusModel = record
  Focus: integer;
  Actions: array of integer;
end record;

function MakeKey(Kind: TuiKeyKind): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewStatus(State: StatusModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakeStatusLine([
                                                                                                                      TuiStatusItemBuilders.MakeHint('Ready'),
                                                                                                                      TuiStatusItemBuilders.MakeDisabledCommand(TuiControlId.Create(2), 'Save', TuiAction.Create(20)),
                                                                                                                      TuiStatusItemBuilders.MakeCommand(TuiControlId.Create(3), 'Quit', TuiAction.Create(30))
                                                                                                                    ])
                                                                                ]);
end function;

function UpdateStatus(State: StatusModel; Msg: TuiMsg; Cmd: TuiCmdOutput): StatusModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return StatusModel(Focus := Id.Value, Actions := State.Actions);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.Action(const Source, const Action):
      begin
        return StatusModel(Focus := State.Focus, Actions := State.Actions.Concat([Action.Value]));
      end;
    when TuiMsg.Started, TuiMsg.Key(_), TuiMsg.Pointer(_), TuiMsg.Tick(_), TuiMsg.Resize(_), TuiMsg.TextChanged(_, _, _, _), TuiMsg.TextAreaChanged(_, _, _, _, _), TuiMsg.CheckChanged(_, _, _), TuiMsg.SelectionChanged(_, _, _), TuiMsg.ScrollChanged(_, _, _), TuiMsg.MenuChanged(_, _, _), TuiMsg.BackgroundFailed(_, _, _, _, _, _), TuiMsg.QuitRequested:
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  var Model: StatusModel := StatusModel(Focus := 3, Actions := []);
  Model := App.RunIterations(Model, UpdateStatus, ViewStatus, 0, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter));
  Model := App.RunIterations(Model, UpdateStatus, ViewStatus, 1, 0);
  AssertEquals(1, Model.Actions.Length());
  AssertEquals(30, Model.Actions[0]);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Tab));
  Model := App.RunIterations(Model, UpdateStatus, ViewStatus, 1, 0);
  AssertEquals(3, Model.Focus);
  App.Close();
end.
