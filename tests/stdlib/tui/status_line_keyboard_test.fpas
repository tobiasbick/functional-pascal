program TuiStatusLineKeyboardTest;

uses Std.Arrays as Arrays;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Chrome as Chrome;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type StatusModel = record
  Focus: integer;
  Actions: array of (integer);
end record;

function MakeKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewStatus(State: StatusModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(State.Focus)), [
                                                                                            Elements.TuiElementMakeStatusLine([
                                                                                                                                Chrome.TuiStatusItemMakeHint('Ready'),
                                                                                                                                Chrome.TuiStatusItemMakeDisabledCommand(Ids.TuiControlIdCreate(2), 'Save', Ids.TuiActionCreate(20)),
                                                                                                                                Chrome.TuiStatusItemMakeCommand(Ids.TuiControlIdCreate(3), 'Quit', Ids.TuiActionCreate(30))
                                                                                                                              ])
                                                                                          ]);
end function;

function UpdateStatus(State: StatusModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): StatusModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return StatusModel(Focus := Id.Value, Actions := State.Actions);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        return StatusModel(Focus := State.Focus, Actions := Arrays.Concat(State.Actions, [
                                                                                           Action.Value
                                                                                         ]));
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(24, 4));
  var Model: StatusModel := StatusModel(Focus := 3, Actions := []);
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateStatus, ViewStatus, 0, 0);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Enter));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateStatus, ViewStatus, 1, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(30, Model.Actions[0]);
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Tui.TuiKeyKind.Tab));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateStatus, ViewStatus, 1, 0);
  Test.AssertEquals(3, Model.Focus);
  Runtime.TuiApplicationClose(App);
end program;
