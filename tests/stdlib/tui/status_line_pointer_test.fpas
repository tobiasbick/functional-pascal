program TuiStatusLinePointerTest;

uses Std.Arrays as Arrays;
uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

type StatusModel = record
  Focus: integer;
  Actions: array of integer;
end record;

function FindGlyph(Snapshot: Tui.TuiSurfaceSnapshot; Glyph: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      var Index: integer := Str.IndexOf(Snapshot.LineAt(Y), Glyph);
      if Index >= 0 then
        begin
          return Tui.TuiPoint.Create(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewStatus(State: StatusModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(Some(Tui.TuiControlId.Create(State.Focus)), [
                                                                                          Tui.TuiElementBuilders.MakeStatusLine([
                                                                                                                                  Tui.TuiStatusItemBuilders.MakeHint('Ready'),
                                                                                                                                  Tui.TuiStatusItemBuilders.MakeCommand(Tui.TuiControlId.Create(1), 'Save', Tui.TuiAction.Create(10)),
                                                                                                                                  Tui.TuiStatusItemBuilders.MakeDisabledCommand(Tui.TuiControlId.Create(2), 'Quit', Tui.TuiAction.Create(20))
                                                                                                                                ])
                                                                                        ]);
end function;

function UpdateStatus(State: StatusModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): StatusModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(Previous, Current):
      begin
        case Current of
          when Some(Id):
            begin
              return record
                Focus := Id.Value;
                Actions := State.Actions;
              end record;
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(Source, Action):
      begin
        return record
          Focus := State.Focus;
          Actions := Arrays.Concat(State.Actions, [Action.Value]);
        end record;
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(24, 4));
  mutable var Model: StatusModel := record
    Focus := 1;
    Actions := [];
  end record;

  Model := App.RunIterations(Model, UpdateStatus, ViewStatus, 0, 0);
  var SaveAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Save');
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, SaveAt));
  Model := App.RunIterations(Model, UpdateStatus, ViewStatus, 1, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  Test.AssertEquals(10, Model.Actions[0]);
  var QuitAt: Tui.TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Quit');
  App.InjectPointerForTest(Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, QuitAt));
  Model := App.RunIterations(Model, UpdateStatus, ViewStatus, 1, 0);
  Test.AssertEquals(1, Arrays.Length(Model.Actions));
  App.Close();
end program;
