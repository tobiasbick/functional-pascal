program TuiStatusLinePointerTest;

uses Std.Test, Std.Tui;

type StatusModel = record
  Focus: integer;
  Actions: array of integer;
end record;

function FindGlyph(Snapshot: TuiSurfaceSnapshot; Glyph: string): TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    begin
      const Index: integer := Snapshot.LineAt(Y).IndexOf(Glyph);
      if Index >= 0 then
        begin
          return TuiPoint.Create(Index, Y);
        end;
      end if;
    end;
  end for;

  panic('glyph not found in snapshot');
end function;

function ViewStatus(State: StatusModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(State.Focus)), [
                                                                                  TuiElementBuilders.MakeStatusLine([
                                                                                                                      TuiStatusItemBuilders.MakeHint('Ready'),
                                                                                                                      TuiStatusItemBuilders.MakeCommand(TuiControlId.Create(1), 'Save', TuiAction.Create(10)),
                                                                                                                      TuiStatusItemBuilders.MakeDisabledCommand(TuiControlId.Create(2), 'Quit', TuiAction.Create(20))
                                                                                                                    ])
                                                                                ]);
end function;

function UpdateStatus(State: StatusModel; Msg: TuiMsg; Cmd: TuiCmdOutput): StatusModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return StatusModel(Focus := Id.Value, Actions := State.Actions);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.Action(const Source, const Action):
      begin
        return StatusModel(Focus := State.Focus, Actions := State.Actions.Concat([Action.Value]));
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(24, 4));
  var Model: StatusModel := StatusModel(Focus := 1, Actions := []);
  Model := App.RunIterations(Model, UpdateStatus, ViewStatus, 0, 0);
  const SaveAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Save');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, SaveAt));
  Model := App.RunIterations(Model, UpdateStatus, ViewStatus, 1, 0);
  AssertEquals(1, Model.Actions.Length());
  AssertEquals(10, Model.Actions[0]);
  const QuitAt: TuiPoint := FindGlyph(App.SurfaceSnapshot(), 'Quit');
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, QuitAt));
  Model := App.RunIterations(Model, UpdateStatus, ViewStatus, 1, 0);
  AssertEquals(1, Model.Actions.Length());
  App.Close();
end.
