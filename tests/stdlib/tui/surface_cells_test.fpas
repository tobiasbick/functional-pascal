program TuiSurfaceCellsTest;

uses Std.Test as Test, Std.Ui.Terminal as Tui;

begin
  const Surface: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(4, 2));
  Test.AssertEquals(4, Surface.Size().Width);
  Test.AssertEquals(2, Surface.Size().Height);
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(0, 0)).Unwrap().Glyph);
  Surface.PutGlyph(1, 0, 'A');
  Test.AssertEquals('A', Surface.TryCellAt(Tui.TuiPoint.Create(1, 0)).Unwrap().Glyph);
  Surface.PutCell(Tui.TuiPoint.Create(2, 1), Tui.TuiCell.Create('B', Tui.TuiStyleRole.Focused));
  Test.AssertEquals('B', Surface.TryCellAt(Tui.TuiPoint.Create(2, 1)).Unwrap().Glyph);
  Test.AssertTrue(
    Surface.TryCellAt(Tui.TuiPoint.Create(2, 1)).Unwrap().Role =
    Tui.TuiStyleRole.Focused
  );
  Surface.PutGlyph(-1, 0, 'Z');
  Surface.PutGlyph(4, 0, 'Z');
  Surface.PutGlyph(0, -1, 'Z');
  Surface.PutGlyph(0, 2, 'Z');
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(0, 0)).Unwrap().Glyph);
  Test.AssertTrue((Surface.TryCellAt(Tui.TuiPoint.Create(-1, 0)) is None));
  Test.AssertTrue((Surface.TryCellAt(Tui.TuiPoint.Create(4, 0)) is None));
  const FirstSnapshot: Tui.TuiSurfaceSnapshot := Surface.Snapshot();
  Test.AssertEquals('A', FirstSnapshot.CellAt(1, 0).Glyph);
  Test.AssertEquals('B', FirstSnapshot.CellAt(2, 1).Glyph);
  Test.AssertTrue(FirstSnapshot.CellAt(2, 1).Role = Tui.TuiStyleRole.Focused);
  Surface.PutGlyph(1, 0, 'C');
  Test.AssertEquals('C', Surface.TryCellAt(Tui.TuiPoint.Create(1, 0)).Unwrap().Glyph);
  Test.AssertEquals('A', FirstSnapshot.CellAt(1, 0).Glyph);
  Surface.Clear();
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(1, 0)).Unwrap().Glyph);
  Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(2, 1)).Unwrap().Glyph);
  Test.AssertEquals('A', FirstSnapshot.CellAt(1, 0).Glyph);
  const Other: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(2, 1));
  Other.PutGlyph(0, 0, 'X');
  Surface.PutGlyph(0, 0, 'Y');
  Test.AssertEquals('Y', Surface.TryCellAt(Tui.TuiPoint.Create(0, 0)).Unwrap().Glyph);
  Test.AssertEquals('X', Other.TryCellAt(Tui.TuiPoint.Create(0, 0)).Unwrap().Glyph);
  const SurfaceSlot: integer := Surface.Slot;
  for ResizeIndex: integer := 1 to 64 do
    begin
      Surface.Resize(Tui.TuiSize.Create(3 + (ResizeIndex mod 5), 2 + (ResizeIndex mod 3)));
      Test.AssertEquals(SurfaceSlot, Surface.Slot);
      Test.AssertEquals(' ', Surface.TryCellAt(Tui.TuiPoint.Create(0, 0)).Unwrap().Glyph);
    end;
  end for;

  Test.AssertEquals(7, Surface.Size().Width);
  Test.AssertEquals(3, Surface.Size().Height);
  Test.AssertEquals('X', Other.TryCellAt(Tui.TuiPoint.Create(0, 0)).Unwrap().Glyph);
end.
