program TuiSurfaceCellsTest;

uses Std.Options as Options;
uses Std.Test as Test;
uses Std.Tui as Tui;

begin
  var Surface: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(4, 2));
  Test.AssertEquals(4, Surface.Size().Width);
  Test.AssertEquals(2, Surface.Size().Height);
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(0, 0))).Glyph);
  Surface.PutGlyph(1, 0, 'A');
  Test.AssertEquals('A', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(1, 0))).Glyph);
  Surface.PutCell(Tui.TuiPoint.Create(2, 1), Tui.TuiCell.Create('B', Tui.TuiStyleRole.Focused));
  Test.AssertEquals('B', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(2, 1))).Glyph);
  Test.AssertTrue(Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(2, 1))).Role =
                  Tui.TuiStyleRole.Focused);
  Surface.PutGlyph(-1, 0, 'Z');
  Surface.PutGlyph(4, 0, 'Z');
  Surface.PutGlyph(0, -1, 'Z');
  Surface.PutGlyph(0, 2, 'Z');
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(0, 0))).Glyph);
  Test.AssertTrue(Options.IsNone(Surface.TryCellAt(Tui.TuiPoint.Create(-1, 0))));
  Test.AssertTrue(Options.IsNone(Surface.TryCellAt(Tui.TuiPoint.Create(4, 0))));
  var FirstSnapshot: Tui.TuiSurfaceSnapshot := Surface.Snapshot();
  Test.AssertEquals('A', FirstSnapshot.CellAt(1, 0).Glyph);
  Test.AssertEquals('B', FirstSnapshot.CellAt(2, 1).Glyph);
  Test.AssertTrue(FirstSnapshot.CellAt(2, 1).Role = Tui.TuiStyleRole.Focused);
  Surface.PutGlyph(1, 0, 'C');
  Test.AssertEquals('C', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(1, 0))).Glyph);
  Test.AssertEquals('A', FirstSnapshot.CellAt(1, 0).Glyph);
  Surface.Clear();
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(1, 0))).Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(2, 1))).Glyph);
  Test.AssertEquals('A', FirstSnapshot.CellAt(1, 0).Glyph);
  var Other: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(2, 1));
  Other.PutGlyph(0, 0, 'X');
  Surface.PutGlyph(0, 0, 'Y');
  Test.AssertEquals('Y', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(0, 0))).Glyph);
  Test.AssertEquals('X', Options.Unwrap(Other.TryCellAt(Tui.TuiPoint.Create(0, 0))).Glyph);
  var SurfaceSlot: integer := Surface.Slot;
  for ResizeIndex: integer := 1 to 64 do
    begin
      Surface.Resize(Tui.TuiSize.Create(3 + (ResizeIndex mod 5), 2 + (ResizeIndex mod 3)));
      Test.AssertEquals(SurfaceSlot, Surface.Slot);
      Test.AssertEquals(' ', Options.Unwrap(Surface.TryCellAt(Tui.TuiPoint.Create(0, 0))).Glyph);
    end;
  end for;

  Test.AssertEquals(7, Surface.Size().Width);
  Test.AssertEquals(3, Surface.Size().Height);
  Test.AssertEquals('X', Options.Unwrap(Other.TryCellAt(Tui.TuiPoint.Create(0, 0))).Glyph);
end program;
