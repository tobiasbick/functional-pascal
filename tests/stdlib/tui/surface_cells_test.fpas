program TuiSurfaceCellsTest;

uses Std.Option, Std.Test, Std.Tui;

begin
  var Surface: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(4, 2));
  AssertEquals(4, Surface.Size().Width);
  AssertEquals(2, Surface.Size().Height);
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 0))).Glyph);
  Surface.PutGlyph(1, 0, 'A');
  AssertEquals('A', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  Surface.PutCell(TuiPoint.Create(2, 1), TuiCell.Create('B', TuiStyleRole.Focused));
  AssertEquals('B', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 1))).Glyph);
  AssertTrue(Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 1))).Role = TuiStyleRole.Focused);
  Surface.PutGlyph(-1, 0, 'Z');
  Surface.PutGlyph(4, 0, 'Z');
  Surface.PutGlyph(0, -1, 'Z');
  Surface.PutGlyph(0, 2, 'Z');
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 0))).Glyph);
  AssertTrue(Std.Option.IsNone(Surface.TryCellAt(TuiPoint.Create(-1, 0))));
  AssertTrue(Std.Option.IsNone(Surface.TryCellAt(TuiPoint.Create(4, 0))));
  var FirstSnapshot: TuiSurfaceSnapshot := Surface.Snapshot();
  AssertEquals('A', FirstSnapshot.CellAt(1, 0).Glyph);
  AssertEquals('B', FirstSnapshot.CellAt(2, 1).Glyph);
  AssertTrue(FirstSnapshot.CellAt(2, 1).Role = TuiStyleRole.Focused);
  Surface.PutGlyph(1, 0, 'C');
  AssertEquals('C', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertEquals('A', FirstSnapshot.CellAt(1, 0).Glyph);
  Surface.Clear();
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 1))).Glyph);
  AssertEquals('A', FirstSnapshot.CellAt(1, 0).Glyph);
  var Other: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(2, 1));
  Other.PutGlyph(0, 0, 'X');
  Surface.PutGlyph(0, 0, 'Y');
  AssertEquals('Y', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 0))).Glyph);
  AssertEquals('X', Std.Option.Unwrap(Other.TryCellAt(TuiPoint.Create(0, 0))).Glyph);
  var SurfaceSlot: integer := Surface.Slot;
  for ResizeIndex: integer := 1 to 64 do
  begin
    Surface.Resize(TuiSize.Create(3 + (ResizeIndex mod 5), 2 + (ResizeIndex mod 3)));
    AssertEquals(SurfaceSlot, Surface.Slot);
    AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 0))).Glyph)
  end;

  AssertEquals(7, Surface.Size().Width);
  AssertEquals(3, Surface.Size().Height);
  AssertEquals('X', Std.Option.Unwrap(Other.TryCellAt(TuiPoint.Create(0, 0))).Glyph)
end.
