program TuiSurfaceWideGlyphTest;

uses Std.Options, Std.Test, Std.Tui;

begin
  var Surface: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(4, 2));
  var Wide: TuiCell := TuiCell.Create('中', TuiStyleRole.Accent);
  Surface.PutCell(TuiPoint.Create(1, 0), Wide);
  AssertEquals('中', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertTrue(Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Role = TuiStyleRole.Accent);
  AssertTrue(Std.Options.IsNone(Surface.TryCellAt(TuiPoint.Create(2, 0))));
  AssertEquals('中', Surface.Snapshot().CellAt(1, 0).Glyph);
  AssertEquals(' ', Surface.Snapshot().CellAt(2, 0).Glyph);
  Surface.PutCell(TuiPoint.Create(2, 0), TuiCell.Create('X', TuiStyleRole.Normal));
  AssertEquals(' ', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertEquals('X', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 0))).Glyph);
  Surface.PutCell(TuiPoint.Create(0, 1), Wide);
  AssertEquals('中', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 1))).Glyph);
  AssertTrue(Std.Options.IsNone(Surface.TryCellAt(TuiPoint.Create(1, 1))));
  Surface.PutCell(TuiPoint.Create(1, 1), TuiCell.Create('Y', TuiStyleRole.Title));
  AssertEquals(' ', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 1))).Glyph);
  AssertEquals('Y', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 1))).Glyph);
  Surface.PutCell(TuiPoint.Create(3, 0), Wide);
  AssertEquals(' ', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(3, 0))).Glyph);
  AssertTrue(Std.Options.IsNone(Surface.TryCellAt(TuiPoint.Create(4, 0))));
  Surface.PutCell(TuiPoint.Create(2, 0), Wide);
  Surface.PutCell(TuiPoint.Create(1, 0), Wide);
  AssertEquals('中', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertTrue(Std.Options.IsNone(Surface.TryCellAt(TuiPoint.Create(2, 0))));
  AssertEquals(' ', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(3, 0))).Glyph);
  Surface.PutCell(TuiPoint.Create(2, 1), TuiCell.Create('é', TuiStyleRole.Normal));
  AssertEquals(1, Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 1))).Width());
  AssertEquals('é', Std.Options.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 1))).Glyph);
  var FillSurface: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(5, 1));
  var FillCanvas: TuiCanvas := TuiCanvas.Create(FillSurface, TuiRect.Create(0, 0, 5, 1));
  FillSurface.PutCell(TuiPoint.Create(1, 0), Wide);
  FillCanvas.FillRect(TuiRect.Create(2, 0, 2, 1), TuiCell.Create('#', TuiStyleRole.Accent));
  AssertEquals(' ', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertEquals('#', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(2, 0))).Glyph);
  AssertEquals('#', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(3, 0))).Glyph);
  FillSurface.PutCell(TuiPoint.Create(3, 0), Wide);
  FillCanvas.FillRect(TuiRect.Create(2, 0, 2, 1), TuiCell.Create('@', TuiStyleRole.Title));
  AssertEquals('@', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(2, 0))).Glyph);
  AssertEquals('@', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(3, 0))).Glyph);
  AssertEquals(' ', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(4, 0))).Glyph);
  FillSurface.PutCell(TuiPoint.Create(1, 0), Wide);
  FillCanvas.FillRect(TuiRect.Create(0, 0, 5, 1), TuiCell.Create('*', TuiStyleRole.Accent));
  AssertEquals('*', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(0, 0))).Glyph);
  AssertEquals('*', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertEquals('*', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(2, 0))).Glyph);
  AssertEquals('*', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(3, 0))).Glyph);
  AssertEquals('*', Std.Options.Unwrap(FillSurface.TryCellAt(TuiPoint.Create(4, 0))).Glyph)
end.
