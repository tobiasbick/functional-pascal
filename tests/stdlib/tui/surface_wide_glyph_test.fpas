program TuiSurfaceWideGlyphTest;

uses Std.Test, Std.Tui;

begin
  const Surface: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(4, 2));
  const Wide: TuiCell := TuiCell.Create('中', TuiStyleRole.Accent);
  Surface.PutCell(TuiPoint.Create(1, 0), Wide);
  AssertEquals('中', Surface.TryCellAt(TuiPoint.Create(1, 0)).Unwrap().Glyph);
  AssertTrue(Surface.TryCellAt(TuiPoint.Create(1, 0)).Unwrap().Role = TuiStyleRole.Accent);
  AssertTrue(Surface.TryCellAt(TuiPoint.Create(2, 0)).IsNone());
  AssertEquals('中', Surface.Snapshot().CellAt(1, 0).Glyph);
  AssertEquals(' ', Surface.Snapshot().CellAt(2, 0).Glyph);
  Surface.PutCell(TuiPoint.Create(2, 0), TuiCell.Create('X', TuiStyleRole.Normal));
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(1, 0)).Unwrap().Glyph);
  AssertEquals('X', Surface.TryCellAt(TuiPoint.Create(2, 0)).Unwrap().Glyph);
  Surface.PutCell(TuiPoint.Create(0, 1), Wide);
  AssertEquals('中', Surface.TryCellAt(TuiPoint.Create(0, 1)).Unwrap().Glyph);
  AssertTrue(Surface.TryCellAt(TuiPoint.Create(1, 1)).IsNone());
  Surface.PutCell(TuiPoint.Create(1, 1), TuiCell.Create('Y', TuiStyleRole.Title));
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(0, 1)).Unwrap().Glyph);
  AssertEquals('Y', Surface.TryCellAt(TuiPoint.Create(1, 1)).Unwrap().Glyph);
  Surface.PutCell(TuiPoint.Create(3, 0), Wide);
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(3, 0)).Unwrap().Glyph);
  AssertTrue(Surface.TryCellAt(TuiPoint.Create(4, 0)).IsNone());
  Surface.PutCell(TuiPoint.Create(2, 0), Wide);
  Surface.PutCell(TuiPoint.Create(1, 0), Wide);
  AssertEquals('中', Surface.TryCellAt(TuiPoint.Create(1, 0)).Unwrap().Glyph);
  AssertTrue(Surface.TryCellAt(TuiPoint.Create(2, 0)).IsNone());
  AssertEquals(' ', Surface.TryCellAt(TuiPoint.Create(3, 0)).Unwrap().Glyph);
  Surface.PutCell(TuiPoint.Create(2, 1), TuiCell.Create('é', TuiStyleRole.Normal));
  AssertEquals(1, Surface.TryCellAt(TuiPoint.Create(2, 1)).Unwrap().Width());
  AssertEquals('é', Surface.TryCellAt(TuiPoint.Create(2, 1)).Unwrap().Glyph);
  const FillSurface: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(5, 1));
  const FillCanvas: TuiCanvas := TuiCanvas.Create(FillSurface, TuiRect.Create(0, 0, 5, 1));
  FillSurface.PutCell(TuiPoint.Create(1, 0), Wide);
  FillCanvas.FillRect(TuiRect.Create(2, 0, 2, 1), TuiCell.Create('#', TuiStyleRole.Accent));
  AssertEquals(' ', FillSurface.TryCellAt(TuiPoint.Create(1, 0)).Unwrap().Glyph);
  AssertEquals('#', FillSurface.TryCellAt(TuiPoint.Create(2, 0)).Unwrap().Glyph);
  AssertEquals('#', FillSurface.TryCellAt(TuiPoint.Create(3, 0)).Unwrap().Glyph);
  FillSurface.PutCell(TuiPoint.Create(3, 0), Wide);
  FillCanvas.FillRect(TuiRect.Create(2, 0, 2, 1), TuiCell.Create('@', TuiStyleRole.Title));
  AssertEquals('@', FillSurface.TryCellAt(TuiPoint.Create(2, 0)).Unwrap().Glyph);
  AssertEquals('@', FillSurface.TryCellAt(TuiPoint.Create(3, 0)).Unwrap().Glyph);
  AssertEquals(' ', FillSurface.TryCellAt(TuiPoint.Create(4, 0)).Unwrap().Glyph);
  FillSurface.PutCell(TuiPoint.Create(1, 0), Wide);
  FillCanvas.FillRect(TuiRect.Create(0, 0, 5, 1), TuiCell.Create('*', TuiStyleRole.Accent));
  AssertEquals('*', FillSurface.TryCellAt(TuiPoint.Create(0, 0)).Unwrap().Glyph);
  AssertEquals('*', FillSurface.TryCellAt(TuiPoint.Create(1, 0)).Unwrap().Glyph);
  AssertEquals('*', FillSurface.TryCellAt(TuiPoint.Create(2, 0)).Unwrap().Glyph);
  AssertEquals('*', FillSurface.TryCellAt(TuiPoint.Create(3, 0)).Unwrap().Glyph);
  AssertEquals('*', FillSurface.TryCellAt(TuiPoint.Create(4, 0)).Unwrap().Glyph);
end.
