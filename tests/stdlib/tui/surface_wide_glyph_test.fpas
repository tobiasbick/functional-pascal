program TuiSurfaceWideGlyphTest;

uses Std.Options as Options;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Cells as Cells;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Rendering as Rendering;

begin
  const Surface: Tui.TuiWorkingSurface := Rendering.TuiWorkingSurfaceCreate(Geometry.TuiSizeCreate(4, 2));
  const Wide: Tui.TuiCell := Cells.TuiCellCreate('中', Tui.TuiStyleRole.Accent);
  Rendering.TuiWorkingSurfacePutCell(Surface, Geometry.TuiPointCreate(1, 0), Wide);
  Test.AssertEquals('中', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 0)))
                            .Glyph);
  Test.AssertTrue(Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 0))).Role =
                  Tui.TuiStyleRole.Accent);
  Test.AssertTrue(Options.IsNone(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(2, 0))));
  Test.AssertEquals('中', Rendering.TuiSurfaceSnapshotCellAt(Rendering.TuiWorkingSurfaceSnapshot(Surface), 1, 0)
                            .Glyph);
  Test.AssertEquals(' ', Rendering.TuiSurfaceSnapshotCellAt(Rendering.TuiWorkingSurfaceSnapshot(Surface), 2, 0)
                           .Glyph);
  Rendering.TuiWorkingSurfacePutCell(Surface, Geometry.TuiPointCreate(2, 0), Cells.TuiCellCreate('X', Tui.TuiStyleRole.Normal));
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 0)))
                           .Glyph);
  Test.AssertEquals('X', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(2, 0)))
                           .Glyph);
  Rendering.TuiWorkingSurfacePutCell(Surface, Geometry.TuiPointCreate(0, 1), Wide);
  Test.AssertEquals('中', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(0, 1)))
                            .Glyph);
  Test.AssertTrue(Options.IsNone(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 1))));
  Rendering.TuiWorkingSurfacePutCell(Surface, Geometry.TuiPointCreate(1, 1), Cells.TuiCellCreate('Y', Tui.TuiStyleRole.Title));
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(0, 1)))
                           .Glyph);
  Test.AssertEquals('Y', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 1)))
                           .Glyph);
  Rendering.TuiWorkingSurfacePutCell(Surface, Geometry.TuiPointCreate(3, 0), Wide);
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(3, 0)))
                           .Glyph);
  Test.AssertTrue(Options.IsNone(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(4, 0))));
  Rendering.TuiWorkingSurfacePutCell(Surface, Geometry.TuiPointCreate(2, 0), Wide);
  Rendering.TuiWorkingSurfacePutCell(Surface, Geometry.TuiPointCreate(1, 0), Wide);
  Test.AssertEquals('中', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(1, 0)))
                            .Glyph);
  Test.AssertTrue(Options.IsNone(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(2, 0))));
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(3, 0)))
                           .Glyph);
  Rendering.TuiWorkingSurfacePutCell(Surface, Geometry.TuiPointCreate(2, 1), Cells.TuiCellCreate('é', Tui.TuiStyleRole.Normal));
  Test.AssertEquals(1, Cells.TuiCellWidth(Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(2, 1)))));
  Test.AssertEquals('é', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(Surface, Geometry.TuiPointCreate(2, 1)))
                           .Glyph);
  const FillSurface: Tui.TuiWorkingSurface := Rendering.TuiWorkingSurfaceCreate(Geometry.TuiSizeCreate(5, 1));
  const FillCanvas: Tui.TuiCanvas := Rendering.TuiCanvasCreate(FillSurface, Geometry.TuiRectCreate(0, 0, 5, 1));
  Rendering.TuiWorkingSurfacePutCell(FillSurface, Geometry.TuiPointCreate(1, 0), Wide);
  Rendering.TuiCanvasFillRect(FillCanvas, Geometry.TuiRectCreate(2, 0, 2, 1), Cells.TuiCellCreate('#', Tui.TuiStyleRole.Accent));
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(1, 0)))
                           .Glyph);
  Test.AssertEquals('#', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(2, 0)))
                           .Glyph);
  Test.AssertEquals('#', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(3, 0)))
                           .Glyph);
  Rendering.TuiWorkingSurfacePutCell(FillSurface, Geometry.TuiPointCreate(3, 0), Wide);
  Rendering.TuiCanvasFillRect(FillCanvas, Geometry.TuiRectCreate(2, 0, 2, 1), Cells.TuiCellCreate('@', Tui.TuiStyleRole.Title));
  Test.AssertEquals('@', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(2, 0)))
                           .Glyph);
  Test.AssertEquals('@', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(3, 0)))
                           .Glyph);
  Test.AssertEquals(' ', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(4, 0)))
                           .Glyph);
  Rendering.TuiWorkingSurfacePutCell(FillSurface, Geometry.TuiPointCreate(1, 0), Wide);
  Rendering.TuiCanvasFillRect(FillCanvas, Geometry.TuiRectCreate(0, 0, 5, 1), Cells.TuiCellCreate('*', Tui.TuiStyleRole.Accent));
  Test.AssertEquals('*', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(0, 0)))
                           .Glyph);
  Test.AssertEquals('*', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(1, 0)))
                           .Glyph);
  Test.AssertEquals('*', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(2, 0)))
                           .Glyph);
  Test.AssertEquals('*', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(3, 0)))
                           .Glyph);
  Test.AssertEquals('*', Options.Unwrap(Rendering.TuiWorkingSurfaceTryCellAt(FillSurface, Geometry.TuiPointCreate(4, 0)))
                           .Glyph);
end program;
