program TuiSurfaceWideGlyphTest;

uses Std.Option, Std.Test, Std.Tui;

begin
  var Surface: TuiWorkingSurface := TuiWorkingSurface.Create(TuiSize.Create(4, 2));
  var Wide: TuiCell := TuiCell.Create('中', TuiStyleRole.Accent);
  Surface.PutCell(TuiPoint.Create(1, 0), Wide);
  AssertEquals('中', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertTrue(Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Role = TuiStyleRole.Accent);
  AssertTrue(Std.Option.IsNone(Surface.TryCellAt(TuiPoint.Create(2, 0))));
  AssertEquals('中', Surface.Snapshot().CellAt(1, 0).Glyph);
  AssertEquals(' ', Surface.Snapshot().CellAt(2, 0).Glyph);
  Surface.PutCell(TuiPoint.Create(2, 0), TuiCell.Create('X', TuiStyleRole.Normal));
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertEquals('X', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 0))).Glyph);
  Surface.PutCell(TuiPoint.Create(0, 1), Wide);
  AssertEquals('中', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 1))).Glyph);
  AssertTrue(Std.Option.IsNone(Surface.TryCellAt(TuiPoint.Create(1, 1))));
  Surface.PutCell(TuiPoint.Create(1, 1), TuiCell.Create('Y', TuiStyleRole.Title));
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 1))).Glyph);
  AssertEquals('Y', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 1))).Glyph);
  Surface.PutCell(TuiPoint.Create(3, 0), Wide);
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(3, 0))).Glyph);
  AssertTrue(Std.Option.IsNone(Surface.TryCellAt(TuiPoint.Create(4, 0))));
  Surface.PutCell(TuiPoint.Create(2, 0), Wide);
  Surface.PutCell(TuiPoint.Create(1, 0), Wide);
  AssertEquals('中', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertTrue(Std.Option.IsNone(Surface.TryCellAt(TuiPoint.Create(2, 0))));
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(3, 0))).Glyph);
  Surface.PutCell(TuiPoint.Create(2, 1), TuiCell.Create('é', TuiStyleRole.Normal));
  AssertEquals(1, Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 1))).Width());
  AssertEquals('é', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 1))).Glyph)
end.
