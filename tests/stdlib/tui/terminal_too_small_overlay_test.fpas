program TuiTerminalTooSmallOverlayTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;

begin
  var Wide: Tui.TuiElement := Tui.TuiElementBuilders.MakePanel('WideTitleWindow', [
                                                                                    Tui.TuiElementBuilders.MakeLabel('abcdefghijklmnopqrstuvwxyz'),
                                                                                    Tui.TuiElementBuilders.MakeLabel('ABCDEFGHIJKLMNOPQRSTUVWXYZ'),
                                                                                    Tui.TuiElementBuilders.MakeLabel('01234567890123456789012345')
                                                                                  ]);
  Test.AssertTrue(Tui.TuiLayoutFitFor(Wide, Tui.TuiSize.Create(40, 12)).Fits());
  Test.AssertFalse(Tui.TuiLayoutFitFor(Wide, Tui.TuiSize.Create(8, 3)).Fits());
  var Surface: Tui.TuiWorkingSurface := Tui.TuiWorkingSurface.Create(Tui.TuiSize.Create(24, 5));
  Tui.TuiPaintTooSmallOverlay(Surface);
  var Snapshot: Tui.TuiSurfaceSnapshot := Surface.Snapshot();
  Test.AssertTrue(Str.Contains(Snapshot.LineAt(2), 'Terminal too small'));
end program;
