program TuiTextAreaInvalidCaretRuntimeError;

uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

function Update(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  return State;
end function;

function View(State: integer): Tui.TuiElement;
begin
  return Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(1), 'x', 2, Geometry.TuiPointCreate(0, 0), Ids.TuiActionCreate(9));
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(10, 3));
  discard Runtime.TuiApplicationRunIterations(App, 0, Update, View, 0, 0);
end program;
