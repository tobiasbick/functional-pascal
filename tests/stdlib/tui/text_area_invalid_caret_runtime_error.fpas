program TuiTextAreaInvalidCaretRuntimeError;

uses Std.Tui as Tui;

function Update(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  return State;
end function;

function View(State: integer): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeTextArea(Tui.TuiControlId.Create(1), 'x', 2, Tui.TuiPoint.Create(0, 0), Tui.TuiAction.Create(9));
end function;

begin
  mutable var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(10, 3));
  App.RunIterations(0, Update, View, 0, 0);
end program;
