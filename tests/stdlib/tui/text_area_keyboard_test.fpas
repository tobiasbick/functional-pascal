program TuiTextAreaKeyboardTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type TextAreaModel = record
  Text: string;
  Caret: integer;
  Offset: Tui.TuiPoint;
end record;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewTextArea(State: TextAreaModel): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(1), State.Text, State.Caret, State.Offset, Ids.TuiActionCreate(9))
                                                                                ]);
end function;

function ViewWindowedTextArea(State: TextAreaModel): Tui.TuiElement;
begin
  const Editor: Tui.TuiElement := Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(1), State.Text, State.Caret, State.Offset, Ids.TuiActionCreate(9));
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakePanel('Editor', [Editor])
                                                                                ]);
end function;

function UpdateTextArea(State: TextAreaModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): TextAreaModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(9, Action.Value);
        return TextAreaModel(Text := Text, Caret := Caret, Offset := Offset);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.FocusChanged(_, _), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function Press(
  App: Tui.TuiApplication;
  State: TextAreaModel;
  Kind: Tui.TuiKeyKind;
  Character: string
): TextAreaModel;
begin
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Kind, Character));
  return Runtime.TuiApplicationRunIterations(App, State, UpdateTextArea, ViewTextArea, 1, 0);
end function;

function PressWindowed(
  App: Tui.TuiApplication;
  State: TextAreaModel;
  Kind: Tui.TuiKeyKind;
  Character: string
): TextAreaModel;
begin
  Runtime.TuiApplicationInjectKeyForTest(App, MakeKey(Kind, Character));
  return Runtime.TuiApplicationRunIterations(App, State, UpdateTextArea, ViewWindowedTextArea, 1, 0);
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(6, 2));
  var Model: TextAreaModel := TextAreaModel(Text := 'ab', Caret := 2, Offset := Geometry.TuiPointCreate(0, 0));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Press(App, Model, Tui.TuiKeyKind.Enter, '');
  Test.AssertEquals(('ab' + Str.Chr(10)), Model.Text);
  Test.AssertEquals(3, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'x');
  Test.AssertEquals((('ab' + Str.Chr(10)) + 'x'), Model.Text);
  Model := Press(App, Model, Tui.TuiKeyKind.Backspace, '');
  Model := Press(App, Model, Tui.TuiKeyKind.Backspace, '');
  Test.AssertEquals('ab', Model.Text);
  Test.AssertEquals(2, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.Tab, '');
  Test.AssertEquals('ab  ', Model.Text);
  Test.AssertEquals(4, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.Home, '');
  Test.AssertEquals(0, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.EndKey, '');
  Test.AssertEquals(4, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.Left, '');
  Model := Press(App, Model, Tui.TuiKeyKind.Delete, '');
  Test.AssertEquals('ab ', Model.Text);
  Test.AssertEquals(3, Model.Caret);
  Model := TextAreaModel(Text := ((('abcd' + Str.Chr(10)) + 'x') + Str.Chr(10)) +
                                 (('wxyz' + Str.Chr(10)) + 'last'), Caret := 3, Offset := Geometry.TuiPointCreate(0, 0));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Press(App, Model, Tui.TuiKeyKind.Down, '');
  Test.AssertEquals(6, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.Down, '');
  Test.AssertEquals(8, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.Up, '');
  Test.AssertEquals(6, Model.Caret);
  Model := Press(App, Model, Tui.TuiKeyKind.PageDown, '');
  Test.AssertEquals(13, Model.Caret);
  Test.AssertEquals(2, Model.Offset.Y);
  Model := Press(App, Model, Tui.TuiKeyKind.PageUp, '');
  Test.AssertEquals(6, Model.Caret);
  Test.AssertEquals(1, Model.Offset.Y);
  Runtime.TuiApplicationClose(App);
  App := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(4, 2));
  Model := TextAreaModel(Text := 'abcdef', Caret := 0, Offset := Geometry.TuiPointCreate(0, 0));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Press(App, Model, Tui.TuiKeyKind.EndKey, '');
  Test.AssertEquals(6, Model.Caret);
  Test.AssertEquals(3, Model.Offset.X);
  Model := TextAreaModel(Text := ('one' + Str.Chr(10)) + 'abcd', Caret := 6, Offset := Geometry.TuiPointCreate(1, 1));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Press(App, Model, Tui.TuiKeyKind.Right, '');
  Test.AssertEquals(7, Model.Caret);
  Test.AssertEquals(1, Model.Offset.X);
  Test.AssertEquals(1, Model.Offset.Y);
  Runtime.TuiApplicationInject(App, Tui.TuiMsgTextAreaChanged(Ids.TuiControlIdCreate(1), Ids.TuiActionCreate(9), 'done', 4, Geometry.TuiPointCreate(0, 0)));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateTextArea, ViewTextArea, 1, 0);
  Test.AssertEquals('done', Model.Text);
  Test.AssertEquals(4, Model.Caret);
  Test.AssertEquals(0, Model.Offset.X);
  Test.AssertEquals(0, Model.Offset.Y);
  Runtime.TuiApplicationClose(App);
  App := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(10, 5));
  Model := TextAreaModel(Text := 'first', Caret := 5, Offset := Geometry.TuiPointCreate(0, 0));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateTextArea, ViewWindowedTextArea, 0, 0);
  Model := PressWindowed(App, Model, Tui.TuiKeyKind.Enter, '');
  Test.AssertEquals(0, Model.Offset.Y);
  Test.AssertTrue(Str.Contains(Rendering.TuiSurfaceSnapshotLineAt(Runtime.TuiApplicationSurfaceSnapshot(App), 1), 'first'));
  Runtime.TuiApplicationClose(App);
end program;
