program TuiTextAreaKeyboardTest;

uses Std.Test, Std.Tui;

type TextAreaModel = record
  Text: string;
  Caret: integer;
  Offset: TuiPoint;
end record;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewTextArea(State: TextAreaModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakeTextArea(TuiControlId.Create(1), State.Text, State.Caret, State.Offset, TuiAction.Create(9))
                                                                      ]);
end function;

function ViewWindowedTextArea(State: TextAreaModel): TuiElement;
begin
  const Editor: TuiElement := TuiElementBuilders.MakeTextArea(TuiControlId.Create(1), State.Text, State.Caret, State.Offset, TuiAction.Create(9));
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakePanel('Editor', [Editor])
                                                                      ]);
end function;

function UpdateTextArea(State: TextAreaModel; Msg: TuiMsg; Cmd: TuiCmdOutput): TextAreaModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  if Msg is TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset) then
    begin
      AssertEquals(1, Source.Value);
      AssertEquals(9, Action.Value);
      return TextAreaModel(Text := Text, Caret := Caret, Offset := Offset);
    end;
  else
    begin
      return State;
    end;
  end if;
end function;

function Press(App: TuiApplication; State: TextAreaModel; Kind: TuiKeyKind; Character: string): TextAreaModel;
begin
  App.InjectKeyForTest(MakeKey(Kind, Character));
  return App.RunIterations(State, UpdateTextArea, ViewTextArea, 1, 0);
end function;

function PressWindowed(
  App: TuiApplication;
  State: TextAreaModel;
  Kind: TuiKeyKind;
  Character: string
): TextAreaModel;
begin
  App.InjectKeyForTest(MakeKey(Kind, Character));
  return App.RunIterations(State, UpdateTextArea, ViewWindowedTextArea, 1, 0);
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(6, 2));
  var Model: TextAreaModel := TextAreaModel(Text := 'ab', Caret := 2, Offset := TuiPoint.Create(0, 0));
  Model := App.RunIterations(Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Press(App, Model, TuiKeyKind.Enter, '');
  AssertEquals(('ab' + string.Chr(10)), Model.Text);
  AssertEquals(3, Model.Caret);
  Model := Press(App, Model, TuiKeyKind.Character, 'x');
  AssertEquals((('ab' + string.Chr(10)) + 'x'), Model.Text);
  Model := Press(App, Model, TuiKeyKind.Backspace, '');
  Model := Press(App, Model, TuiKeyKind.Backspace, '');
  AssertEquals('ab', Model.Text);
  AssertEquals(2, Model.Caret);
  Model := Press(App, Model, TuiKeyKind.Tab, '');
  AssertEquals('ab  ', Model.Text);
  AssertEquals(4, Model.Caret);
  Model := Press(App, Model, TuiKeyKind.Home, '');
  AssertEquals(0, Model.Caret);
  Model := Press(App, Model, TuiKeyKind.EndKey, '');
  AssertEquals(4, Model.Caret);
  Model := Press(App, Model, TuiKeyKind.Left, '');
  Model := Press(App, Model, TuiKeyKind.Delete, '');
  AssertEquals('ab ', Model.Text);
  AssertEquals(3, Model.Caret);
  Model := TextAreaModel(Text := ((('abcd' + string.Chr(10)) + 'x') + string.Chr(10)) +
                                 (('wxyz' + string.Chr(10)) + 'last'), Caret := 3, Offset := TuiPoint.Create(0, 0));
  Model := App.RunIterations(Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Press(App, Model, TuiKeyKind.Down, '');
  AssertEquals(6, Model.Caret);
  Model := Press(App, Model, TuiKeyKind.Down, '');
  AssertEquals(8, Model.Caret);
  Model := Press(App, Model, TuiKeyKind.Up, '');
  AssertEquals(6, Model.Caret);
  Model := Press(App, Model, TuiKeyKind.PageDown, '');
  AssertEquals(13, Model.Caret);
  AssertEquals(2, Model.Offset.Y);
  Model := Press(App, Model, TuiKeyKind.PageUp, '');
  AssertEquals(6, Model.Caret);
  AssertEquals(1, Model.Offset.Y);
  App.Close();
  App := TuiApplication.OpenForTest(TuiSize.Create(4, 2));
  Model := TextAreaModel(Text := 'abcdef', Caret := 0, Offset := TuiPoint.Create(0, 0));
  Model := App.RunIterations(Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Press(App, Model, TuiKeyKind.EndKey, '');
  AssertEquals(6, Model.Caret);
  AssertEquals(3, Model.Offset.X);
  Model := TextAreaModel(Text := ('one' + string.Chr(10)) + 'abcd', Caret := 6, Offset := TuiPoint.Create(1, 1));
  Model := App.RunIterations(Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Press(App, Model, TuiKeyKind.Right, '');
  AssertEquals(7, Model.Caret);
  AssertEquals(1, Model.Offset.X);
  AssertEquals(1, Model.Offset.Y);
  App.Inject(TuiMsgTextAreaChanged(TuiControlId.Create(1), TuiAction.Create(9), 'done', 4, TuiPoint.Create(0, 0)));
  Model := App.RunIterations(Model, UpdateTextArea, ViewTextArea, 1, 0);
  AssertEquals('done', Model.Text);
  AssertEquals(4, Model.Caret);
  AssertEquals(0, Model.Offset.X);
  AssertEquals(0, Model.Offset.Y);
  App.Close();
  App := TuiApplication.OpenForTest(TuiSize.Create(10, 5));
  Model := TextAreaModel(Text := 'first', Caret := 5, Offset := TuiPoint.Create(0, 0));
  Model := App.RunIterations(Model, UpdateTextArea, ViewWindowedTextArea, 0, 0);
  Model := PressWindowed(App, Model, TuiKeyKind.Enter, '');
  AssertEquals(0, Model.Offset.Y);
  AssertTrue(App.SurfaceSnapshot().LineAt(1).Contains('first'));
  App.Close();
end.
