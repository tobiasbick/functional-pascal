program TuiTextAreaPointerTest;

uses Std.Test, Std.Tui;

type PointerModel = record
  Focus: integer;
  Text: string;
  Caret: integer;
  Offset: TuiPoint;
end record;

function ViewTextArea(State: PointerModel): TuiElement;
begin
  var Focused: option of TuiControlId := None;
  if State.Focus > 0 then
    begin
      Focused := Some(TuiControlId.Create(State.Focus));
    end;
  end if;

  return TuiElementBuilders.MakeDesktop(Focused, [
                                                   TuiElementBuilders.MakeTextArea(TuiControlId.Create(1), State.Text, State.Caret, State.Offset, TuiAction.Create(9))
                                                 ]);
end function;

function UpdateTextArea(State: PointerModel; Msg: TuiMsg; Cmd: TuiCmdOutput): PointerModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              return PointerModel(Focus := Id.Value, Text := State.Text, Caret := State.Caret, Offset := State.Offset);
            end;
          when None:
            begin
              return State;
            end;
        end case;
      end;
    when TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset):
      begin
        AssertEquals(1, Source.Value);
        AssertEquals(9, Action.Value);
        return PointerModel(Focus := State.Focus, Text := Text, Caret := Caret, Offset := Offset);
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function Click(
  App: TuiApplication;
  State: PointerModel;
  X: integer;
  Y: integer;
  Iterations: integer
): PointerModel;
begin
  App.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(X, Y)));
  return App.RunIterations(State, UpdateTextArea, ViewTextArea, Iterations, 0);
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(6, 3));
  var Model: PointerModel := PointerModel(Focus := 0, Text := (('zero' + string.Chr(10)) + 'one') +
                                                              (string.Chr(10) + 'three'), Caret := 0, Offset := TuiPoint.Create(0, 0));
  Model := App.RunIterations(Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Click(App, Model, 2, 1, 2);
  AssertEquals(1, Model.Focus);
  AssertEquals(7, Model.Caret);
  Model := Click(App, Model, 5, 1, 1);
  AssertEquals(8, Model.Caret);
  Model := PointerModel(Focus := 1, Text := Model.Text, Caret := Model.Caret, Offset := TuiPoint.Create(2, 1));
  Model := App.RunIterations(Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Click(App, Model, 1, 1, 1);
  AssertEquals(12, Model.Caret);
  AssertEquals(2, Model.Offset.X);
  AssertEquals(1, Model.Offset.Y);
  App.Close();
end.
