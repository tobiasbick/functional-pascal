program TuiTextAreaPointerTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Runtime as Runtime;

type PointerModel = record
  Focus: integer;
  Text: string;
  Caret: integer;
  Offset: Tui.TuiPoint;
end record;

function ViewTextArea(State: PointerModel): Tui.TuiElement;
begin
  var Focused: Option of (Tui.TuiControlId) := Option.None;
  if State.Focus > 0 then
    begin
      Focused := Option.Some(Ids.TuiControlIdCreate(State.Focus));
    end;
  end if;

  return Elements.TuiElementMakeDesktop(Focused, [
                                                   Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(1), State.Text, State.Caret, State.Offset, Ids.TuiActionCreate(9))
                                                 ]);
end function;

function UpdateTextArea(State: PointerModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): PointerModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Option.Some(const Id):
            begin
              return PointerModel(Focus := Id.Value, Text := State.Text, Caret := State.Caret, Offset := State.Offset);
            end;
          when Option.None:
            begin
              return State;
            end;
        end case;
      end;
    when Tui.TuiMsg.TextAreaChanged(const Source, const Action, const Text, const Caret, const Offset):
      begin
        Test.AssertEquals(1, Source.Value);
        Test.AssertEquals(9, Action.Value);
        return PointerModel(Focus := State.Focus, Text := Text, Caret := Caret, Offset := Offset);
      end;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Key(_), Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.Action(_, _), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _), Tui.TuiMsg.QuitRequested:
      begin
        begin
          return State;
        end;
      end;
  end case;
end function;

function Click(
  App: Tui.TuiApplication;
  State: PointerModel;
  X: integer;
  Y: integer;
  Iterations: integer
): PointerModel;
begin
  Runtime.TuiApplicationInjectPointerForTest(App, Runtime.TuiPointerEventCreate(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, Geometry.TuiPointCreate(X, Y)));
  return Runtime.TuiApplicationRunIterations(App, State, UpdateTextArea, ViewTextArea, Iterations, 0);
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(6, 3));
  var Model: PointerModel := PointerModel(Focus := 0, Text := (('zero' + Str.Chr(10)) + 'one') +
                                                              (Str.Chr(10) + 'three'), Caret := 0, Offset := Geometry.TuiPointCreate(0, 0));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Click(App, Model, 2, 1, 2);
  Test.AssertEquals(1, Model.Focus);
  Test.AssertEquals(7, Model.Caret);
  Model := Click(App, Model, 5, 1, 1);
  Test.AssertEquals(8, Model.Caret);
  Model := PointerModel(Focus := 1, Text := Model.Text, Caret := Model.Caret, Offset := Geometry.TuiPointCreate(2, 1));
  Model := Runtime.TuiApplicationRunIterations(App, Model, UpdateTextArea, ViewTextArea, 0, 0);
  Model := Click(App, Model, 1, 1, 1);
  Test.AssertEquals(12, Model.Caret);
  Test.AssertEquals(2, Model.Offset.X);
  Test.AssertEquals(1, Model.Offset.Y);
  Runtime.TuiApplicationClose(App);
end program;
