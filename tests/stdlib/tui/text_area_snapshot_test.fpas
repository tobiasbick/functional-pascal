program TuiTextAreaSnapshotTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type SnapshotModel = record
  Focused: boolean;
end record;

function ViewTextArea(State: SnapshotModel): Tui.TuiElement;
begin
  var Focus: Option of (Tui.TuiControlId) := Option.None;
  if State.Focused then
    begin
      Focus := Option.Some(Ids.TuiControlIdCreate(1));
    end;
  end if;
  const Text: string := (('012345' + Str.Chr(10)) + 'alpha') + (Str.Chr(10) + 'omega');
  return Elements.TuiElementMakeDesktop(Focus, [
                                                 Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(1), Text, 9, Geometry.TuiPointCreate(1, 1), Ids.TuiActionCreate(9))
                                               ]);
end function;

function UpdateTextArea(State: SnapshotModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): SnapshotModel;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  var App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(4, 2));
  discard Runtime.TuiApplicationRunIterations(App, SnapshotModel(Focused := true), UpdateTextArea, ViewTextArea, 0, 0);
  const Focused: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertEquals('l▏ha', Rendering.TuiSurfaceSnapshotLineAt(Focused, 0));
  Test.AssertEquals('mega', Rendering.TuiSurfaceSnapshotLineAt(Focused, 1));
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Focused, 1, 0).Role = Tui.TuiStyleRole.Focused);
  discard Runtime.TuiApplicationRunIterations(App, SnapshotModel(Focused := false), UpdateTextArea, ViewTextArea, 0, 0);
  const Unfocused: Tui.TuiSurfaceSnapshot := Runtime.TuiApplicationSurfaceSnapshot(App);
  Test.AssertEquals('lpha', Rendering.TuiSurfaceSnapshotLineAt(Unfocused, 0));
  Test.AssertEquals('mega', Rendering.TuiSurfaceSnapshotLineAt(Unfocused, 1));
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Unfocused, 1, 0).Role = Tui.TuiStyleRole.Normal);
  Runtime.TuiApplicationClose(App);
end program;
