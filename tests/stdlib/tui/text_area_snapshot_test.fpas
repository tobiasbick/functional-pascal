program TuiTextAreaSnapshotTest;

uses Std.Test, Std.Tui;

type SnapshotModel = record
  Focused: boolean;
end record;

function ViewTextArea(State: SnapshotModel): TuiElement;
begin
  var Focus: option of TuiControlId := None;
  if State.Focused then
    begin
      Focus := Some(TuiControlId.Create(1));
    end;
  end if;
  const Text: string := (('012345' + string.Chr(10)) + 'alpha') + (string.Chr(10) + 'omega');
  return TuiElementBuilders.MakeDesktop(Focus, [
                                                 TuiElementBuilders.MakeTextArea(TuiControlId.Create(1), Text, 9, TuiPoint.Create(1, 1), TuiAction.Create(9))
                                               ]);
end function;

function UpdateTextArea(State: SnapshotModel; Msg: TuiMsg; Cmd: TuiCmdOutput): SnapshotModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  return State;
end function;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(4, 2));
  discard App.RunIterations(SnapshotModel(Focused := true), UpdateTextArea, ViewTextArea, 0, 0);
  const Focused: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertEquals('l▏ha', Focused.LineAt(0));
  AssertEquals('mega', Focused.LineAt(1));
  AssertTrue(Focused.CellAt(1, 0).Role = TuiStyleRole.Focused);
  discard App.RunIterations(SnapshotModel(Focused := false), UpdateTextArea, ViewTextArea, 0, 0);
  const Unfocused: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertEquals('lpha', Unfocused.LineAt(0));
  AssertEquals('mega', Unfocused.LineAt(1));
  AssertTrue(Unfocused.CellAt(1, 0).Role = TuiStyleRole.Normal);
  App.Close();
end.
