program TuiTextAreaSnapshotTest;

uses Std.Test as Test, Std.Tui as Tui;

type SnapshotModel = record
  Focused: boolean;
end record;

function ViewTextArea(State: SnapshotModel): Tui.TuiElement;
begin
  var Focus: option of Tui.TuiControlId := None;
  if State.Focused then
    begin
      Focus := Some(Tui.TuiControlId.Create(1));
    end;
  end if;
  const Text: string := '012345' + string.Chr(10) + 'alpha' + (string.Chr(10) + 'omega');
  return Tui.TuiElementBuilders.MakeDesktop(Focus, [
                                                     Tui.TuiElementBuilders.MakeTextArea(Tui.TuiControlId.Create(1), Text, 9, Tui.TuiPoint.Create(1, 1), Tui.TuiAction.Create(9))
                                                   ]);
end function;

function UpdateTextArea(State: SnapshotModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): SnapshotModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  return State;
end function;

begin
  var App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(4, 2));
  discard App.RunIterations(SnapshotModel(Focused := true), UpdateTextArea, ViewTextArea, 0, 0);
  const Focused: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertEquals('l▏ha', Focused.LineAt(0));
  Test.AssertEquals('mega', Focused.LineAt(1));
  Test.AssertTrue(Focused.CellAt(1, 0).Role = Tui.TuiStyleRole.Focused);
  discard App.RunIterations(SnapshotModel(Focused := false), UpdateTextArea, ViewTextArea, 0, 0);
  const Unfocused: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertEquals('lpha', Unfocused.LineAt(0));
  Test.AssertEquals('mega', Unfocused.LineAt(1));
  Test.AssertTrue(Unfocused.CellAt(1, 0).Role = Tui.TuiStyleRole.Normal);
  App.Close();
end.
