program TextAreaUnicodeBoundariesTest;

uses Std.Str as Str;
uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Ids as Ids;
uses Std.Tui.Rendering as Rendering;
uses Std.Tui.Runtime as Runtime;

type Model = record
  Text: string;
  Caret: integer;
end record;

function View(State: Model): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.Some(Ids.TuiControlIdCreate(1)), [
                                                                                  Elements.TuiElementMakeTextArea(Ids.TuiControlIdCreate(1), State.Text, State.Caret, Geometry.TuiPointCreate(0, 0), Ids.TuiActionCreate(1))
                                                                                ]);
end function;

function Update(State: Model; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Model;
begin
  Runtime.TuiCmdOutputSet(Cmd, Tui.TuiCmd.NoCommand);
  return State;
end function;

procedure CheckCaret(App: Tui.TuiApplication; Text: string; Caret: integer; X: integer; Y: integer);
begin
  discard Runtime.TuiApplicationRunIterations(App, Model(Text := Text, Caret := Caret), Update, View, 0, 0);
  Test.AssertTrue(Rendering.TuiSurfaceSnapshotCellAt(Runtime.TuiApplicationSurfaceSnapshot(App), X, Y).Role =
                  Tui.TuiStyleRole.Focused);
end procedure;

begin
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTest(Geometry.TuiSizeCreate(8, 4));
  const Text: string := ((((('e' + Str.Chr(769)) + '界') + Str.Chr(10)) + Str.Chr(10)) + 'x') +
                        Str.Chr(10);
  CheckCaret(App, Text, 0, 0, 0);
  CheckCaret(App, Text, 2, 1, 0);
  CheckCaret(App, Text, 3, 3, 0);
  CheckCaret(App, Text, 4, 0, 1);
  CheckCaret(App, Text, 5, 0, 2);
  CheckCaret(App, Text, 6, 1, 2);
  CheckCaret(App, Text, 7, 0, 3);
  CheckCaret(App, '', 0, 0, 0);
  Runtime.TuiApplicationClose(App);
end program;
