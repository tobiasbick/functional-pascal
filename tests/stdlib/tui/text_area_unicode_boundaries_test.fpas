program TextAreaUnicodeBoundariesTest;

uses Std.Str, Std.Test, Std.Tui;

type
  Model = record
    Text: string;
    Caret: integer;
  end;

function View(State: Model): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakeTextArea(TuiControlId.Create(1), State.Text, State.Caret, TuiPoint.Create(0, 0), TuiAction.Create(1))
                                                                      ])
end;

function Update(State: Model; Msg: TuiMsg; Cmd: TuiCmdOutput): Model;
begin
  Cmd.Set(TuiCmd.NoCommand);
  return State
end;

procedure CheckCaret(App: TuiApplication; Text: string; Caret: integer; X: integer; Y: integer);
begin
  App.RunIterations(record
    Text := Text;
    Caret := Caret;
  end, Update, View, 0, 0);
  AssertTrue(App.SurfaceSnapshot().CellAt(X, Y).Role = TuiStyleRole.Focused)
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(8, 4));
  var Text: string := ((((('e' + Std.Str.Chr(769)) + '界') + Std.Str.Chr(10)) + Std.Str.Chr(10)) + 'x') +
                      Std.Str.Chr(10);
  CheckCaret(App, Text, 0, 0, 0);
  CheckCaret(App, Text, 2, 1, 0);
  CheckCaret(App, Text, 3, 3, 0);
  CheckCaret(App, Text, 4, 0, 1);
  CheckCaret(App, Text, 5, 0, 2);
  CheckCaret(App, Text, 6, 1, 2);
  CheckCaret(App, Text, 7, 0, 3);
  CheckCaret(App, '', 0, 0, 0);
  App.Close()
end.
