program TextAreaUnicodeColumnTest;

uses Std.Console, Std.Test, Std.Tui;

type TextAreaModel = record
  Text: string;
  Caret: integer;
  Offset: TuiPoint;
end record;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return Std.Console.KeyEvent(kind := Kind, ch := Character, shift := false, ctrl := false, alt := false, meta := false);
end function;

function ViewTextArea(State: TextAreaModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakeTextArea(TuiControlId.Create(1), State.Text, State.Caret, State.Offset, TuiAction.Create(9))
                                                                      ]);
end function;

function UpdateTextArea(State: TextAreaModel; Msg: TuiMsg; Cmd: TuiCmdOutput): TextAreaModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    when TuiMsg.TextAreaChanged(Source, Action, Text, Caret, Offset):
      begin
        AssertEquals(1, Source.Value);
        AssertEquals(9, Action.Value);
        return TextAreaModel(Text := Text, Caret := Caret, Offset := Offset);
      end;
    else
      begin
        return State;
      end;
  end case;
end function;

function Press(App: TuiApplication; State: TextAreaModel; Kind: TuiKeyKind; Character: string): TextAreaModel;
begin
  App.InjectKeyForTest(MakeKey(Kind, Character));
  return App.RunIterations(State, UpdateTextArea, ViewTextArea, 1, 0);
end function;

// Reference the original scalar-prefix contract only for short correctness fixtures.
function Expected(Line: string; Column: integer): integer;
begin
  for I: integer := 0 to Line.Length() - 1 do
    begin
      if Std.Console.DisplayWidth(Line.Slice(0, I + 1)) > Column then
        begin
          return I;
        end;
      end if;
    end;
  end for;

  return Line.Length();
end function;

begin
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(4, 2));
  for Line: string in [
                        (string.Chr(9800) + string.Chr(65038)) + 'x',
                        '',
                        ('e' + string.Chr(769)) + 'x',
                        '中a',
                        ('👩' + string.Chr(8205)) + '💻x',
                        (('1' + string.Chr(65039)) + string.Chr(8419)) + 'x',
                        string.Chr(769) + 'a',
                        '🇩🇪x'
                      ] do
    begin
      for Column: integer := 0 to 6 do
        begin
          const State: TextAreaModel := TextAreaModel(Text := (('xxxxxx' + #10) + Line) + #10, Caret := Column, Offset := TuiPoint.Create(3, 0));
          const Moved: TextAreaModel := Press(App, State, TuiKeyKind.Down, '');
          AssertEquals(7 + Expected(Line, Column), Moved.Caret);
        end;
      end for;
    end;
  end for;

  App.Close();
end.
