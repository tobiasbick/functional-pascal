program TextAreaUnicodeColumnTest;

uses Std.Console, Std.Str, Std.Test, Std.Tui;

type
  TextAreaModel = record
    Text: string;
    Caret: integer;
    Offset: TuiPoint;
  end;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function ViewTextArea(State: TextAreaModel): TuiElement;
begin
  return TuiElementBuilders.MakeDesktop(Some(TuiControlId.Create(1)), [
                                                                        TuiElementBuilders.MakeTextArea(TuiControlId.Create(1), State.Text, State.Caret, State.Offset, TuiAction.Create(9))
                                                                      ])
end;

function UpdateTextArea(State: TextAreaModel; Msg: TuiMsg; Cmd: TuiCmdOutput): TextAreaModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.TextAreaChanged(Source, Action, Text, Caret, Offset):
    begin
      AssertEquals(1, Source.Value);
      AssertEquals(9, Action.Value);
      return record
        Text := Text;
        Caret := Caret;
        Offset := Offset;
      end
    end
    else
    begin
      return State
    end
  end
end;

function Press(App: TuiApplication; State: TextAreaModel; Kind: TuiKeyKind; Character: string): TextAreaModel;
begin
  App.InjectKeyForTest(MakeKey(Kind, Character));
  return App.RunIterations(State, UpdateTextArea, ViewTextArea, 1, 0)
end;

// Reference the original scalar-prefix contract only for short correctness fixtures.
function Expected(Line: string; Column: integer): integer;
begin
  for I: integer := 0 to Std.Str.Length(Line) - 1 do
  begin
    if Std.Console.DisplayWidth(Std.Str.Substring(Line, 0, I + 1)) > Column then
    begin
      return I
    end
  end;

  return Std.Str.Length(Line)
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(4, 2));
  for Line: string in [
                        (Std.Str.Chr(9800) + Std.Str.Chr(65038)) + 'x',
                        '',
                        ('e' + Std.Str.Chr(769)) + 'x',
                        '中a',
                        ('👩' + Std.Str.Chr(8205)) + '💻x',
                        (('1' + Std.Str.Chr(65039)) + Std.Str.Chr(8419)) + 'x',
                        Std.Str.Chr(769) + 'a',
                        '🇩🇪x'
                      ] do
  begin
    for Column: integer := 0 to 6 do
    begin
      var State: TextAreaModel := record
        Text := (('xxxxxx' + #10) + Line) + #10;
        Caret := Column;
        Offset := TuiPoint.Create(3, 0);
      end;
      var Moved: TextAreaModel := Press(App, State, TuiKeyKind.Down, '');
      AssertEquals(7 + Expected(Line, Column), Moved.Caret)
    end
  end;

  App.Close()
end.
