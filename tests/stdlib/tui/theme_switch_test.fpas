program TuiThemeSwitchTest;

uses Std.Test as Test;
uses Std.Tui as Tui;
uses Std.Tui.Cells as Cells;
uses Std.Tui.Elements as Elements;
uses Std.Tui.Geometry as Geometry;
uses Std.Tui.Runtime as Runtime;

function ViewTheme(State: integer): Tui.TuiElement;
begin
  return Elements.TuiElementMakeDesktop(Option.None, [Elements.TuiElementMakeLabel('theme')]);
end function;

function UpdateTheme(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  Runtime.TuiCmdOutputSetPalette(Cmd, Cells.TuiPaletteWithRole(Cells.TuiPaletteDefault(), Tui.TuiStyleRole.Normal, Cells.TuiStyleFromColors(Cells.TuiColorFromRgb(1, 2, 3), Cells.TuiColorFromRgb(4, 5, 6))));
  return State;
end function;

begin
  const Initial: Tui.TuiPalette := Cells.TuiPaletteWithRole(Cells.TuiPaletteDefault(), Tui.TuiStyleRole.Normal, Cells.TuiStyleFromColors(Cells.TuiColorFromRgb(10, 20, 30), Cells.TuiColorFromRgb(40, 50, 60)));
  const App: Tui.TuiApplication := Runtime.TuiApplicationOpenForTestWithPalette(Geometry.TuiSizeCreate(10, 2), Initial);
  Test.AssertEquals(10, Runtime.TuiApplicationPalette(App).Normal.Foreground.Red);
  Runtime.TuiApplicationInject(App, Tui.TuiMsg.Tick(0));
  const _: integer := Runtime.TuiApplicationRunIterations(App, 0, UpdateTheme, ViewTheme, 1, 0);
  Test.AssertEquals(1, Runtime.TuiApplicationPalette(App).Normal.Foreground.Red);
  Test.AssertEquals(6, Runtime.TuiApplicationPalette(App).Normal.Background.Blue);
  Runtime.TuiApplicationClose(App);
end program;
