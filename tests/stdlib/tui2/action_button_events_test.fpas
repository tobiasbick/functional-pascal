program Tui2ActionButtonEventsTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var Save: TuiAction := TuiAction.Create(App, TuiCommand.Create(1024), 'Save');
  var Button: TuiButton := TuiButton.Create(App, 'Save now');
  Button.Action := Save;
  mutable var Sequence: integer := 0;
  Save.OnExecute := procedure(Sender: TuiAction; Source: TuiView) begin
    AssertEquals(1024, Sender.Command.Value);
    AssertTrue(Source.Kind = TuiViewKind.Button);
    Sequence := Sequence * 10 + 1
  end;
  Button.OnClick := procedure(Sender: TuiButton) begin
    AssertEquals('Save now', Sender.Text);
    Sequence := Sequence * 10 + 2
  end;
  AssertTrue(Button.Click());
  AssertEquals(12, Sequence);
  var ButtonCopy: TuiButton := Button;
  ButtonCopy.OnClick := procedure(Sender: TuiButton) begin
    Sequence := Sequence * 10 + 3
  end;
  AssertTrue(Button.Click());
  AssertEquals(1213, Sequence);
  Save.Enabled := false;
  AssertTrue(Button.Click());
  AssertEquals(12133, Sequence);
  Button.OnClick := nil;
  AssertTrue(Button.Click());
  AssertEquals(12133, Sequence);
  App.Close();
  AssertFalse(Button.IsAlive());
  AssertFalse(Save.IsAlive())
end.
