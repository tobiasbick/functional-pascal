program Tui2ActionHandlerFormsTest;

uses Std.Test, Std.Tui2;

mutable var
  mutable var NamedCalls: integer := 0;

procedure NamedHandler(Sender: TuiAction; Source: TuiView);
begin
  NamedCalls := NamedCalls + 1
end;

type
  ActionObserver = record
    Increment: integer;

    procedure Handle(Self: ActionObserver; Sender: TuiAction; Source: TuiView);
    begin
      NamedCalls := NamedCalls + Self.Increment
    end;
  end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var Action: TuiAction := TuiAction.Create(App, TuiCommand.Create(1026), 'Observe');
  var Source: TuiView := TuiView.Empty(App);
  Action.OnExecute := NamedHandler;
  AssertTrue(Action.Activate(Source));
  AssertEquals(1, NamedCalls);
  var Observer: ActionObserver := record Increment := 10; end;
  Action.OnExecute := Observer.Handle;
  AssertTrue(Action.Activate(Source));
  AssertEquals(11, NamedCalls);
  var Copy: TuiAction := Action;
  Copy.OnExecute := nil;
  AssertFalse(Assigned(Action.OnExecute));
  AssertTrue(Action.Activate(Source));
  AssertEquals(11, NamedCalls);
  App.Close()
end.
