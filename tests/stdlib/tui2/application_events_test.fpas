program Tui2ApplicationEventsTest;

uses Std.Test, Std.Tui2;

begin
  mutable var Sequence: integer := 0;
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  App.OnStart := procedure(Sender: TuiApplication) begin
    AssertEquals(App.Id, Sender.Id);
    Sequence := Sequence * 10 + 1
  end;
  App.OnTick := procedure(Sender: TuiApplication; DeltaMilliseconds: integer) begin
    AssertEquals(App.Id, Sender.Id);
    Sequence := Sequence * 10 + DeltaMilliseconds
  end;
  App.OnStop := procedure(Sender: TuiApplication) begin
    AssertEquals(App.Id, Sender.Id);
    Sequence := Sequence * 10 + 3;
    AssertFalse(Sender.Post(procedure() begin
      panic('a closing application must not accept posts')
    end));
    Sender.Close()
  end;
  AssertTrue(App.Post(procedure() begin
    Sequence := Sequence * 10 + 4;
    AssertTrue(App.Post(procedure() begin
      Sequence := Sequence * 10 + 6
    end))
  end));
  AssertTrue(App.Post(procedure() begin
    Sequence := Sequence * 10 + 5
  end));
  App.Start();
  App.Tick(2);
  App.Close();
  AssertEquals(145263, Sequence);
  AssertFalse(App.IsOpen());
  App.Close()
end.
