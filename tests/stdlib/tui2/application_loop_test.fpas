program Tui2ApplicationLoopTest;

uses Std.Test, Std.Tui2;

begin
  mutable var Starts: integer := 0;
  mutable var Ticks: integer := 0;
  mutable var Stops: integer := 0;
  mutable var TotalDelta: integer := 0;
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  App.OnStart := procedure(Sender: TuiApplication) begin
    Starts := Starts + 1
  end;
  App.OnTick := procedure(Sender: TuiApplication; DeltaMilliseconds: integer) begin
    Ticks := Ticks + 1;
    TotalDelta := TotalDelta + DeltaMilliseconds;
    if Ticks = 2 then
    begin
      Sender.Quit()
    end
  end;
  App.OnStop := procedure(Sender: TuiApplication) begin
    Stops := Stops + 1
  end;
  App.RunIterations(10, 7);
  AssertEquals(1, Starts);
  AssertEquals(2, Ticks);
  AssertEquals(14, TotalDelta);
  AssertEquals(1, Stops);
  AssertFalse(App.IsOpen());
  mutable var DeferredTicks: integer := 0;
  mutable var DeferredStops: integer := 0;
  var DeferredQuit: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 5));
  DeferredQuit.OnTick := procedure(Sender: TuiApplication; DeltaMilliseconds: integer) begin
    DeferredTicks := DeferredTicks + 1
  end;
  DeferredQuit.OnStop := procedure(Sender: TuiApplication) begin
    DeferredStops := DeferredStops + 1
  end;
  AssertTrue(DeferredQuit.Post(procedure() begin
    DeferredQuit.Quit()
  end));
  DeferredQuit.RunIterations(4, 1);
  AssertEquals(0, DeferredTicks);
  AssertEquals(1, DeferredStops);
  AssertFalse(DeferredQuit.IsOpen());
  mutable var BudgetStarts: integer := 0;
  mutable var BudgetTicks: integer := 0;
  mutable var BudgetStops: integer := 0;
  var Budgeted: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 5));
  Budgeted.OnStart := procedure(Sender: TuiApplication) begin
    BudgetStarts := BudgetStarts + 1
  end;
  Budgeted.OnTick := procedure(Sender: TuiApplication; DeltaMilliseconds: integer) begin
    BudgetTicks := BudgetTicks + 1
  end;
  Budgeted.OnStop := procedure(Sender: TuiApplication) begin
    BudgetStops := BudgetStops + 1
  end;
  Budgeted.RunIterations(2, 3);
  AssertTrue(Budgeted.IsOpen());
  Budgeted.RunIterations(1, 4);
  AssertEquals(1, BudgetStarts);
  AssertEquals(3, BudgetTicks);
  AssertEquals(0, BudgetStops);
  Budgeted.Quit();
  AssertEquals(1, BudgetStops);
  AssertFalse(Budgeted.IsOpen())
end.
