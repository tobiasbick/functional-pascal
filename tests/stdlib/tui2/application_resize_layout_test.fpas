program Tui2ApplicationResizeLayoutTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(10, 4));
  AssertEquals(10, App.Size.Width);
  AssertEquals(4, App.Size.Height);
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var DesktopView: TuiView := TuiDesktop.AsView(Desktop);
  AssertEquals(10, DesktopView.Bounds.Width);
  AssertEquals(4, DesktopView.Bounds.Height);
  var Content: TuiView := TuiView.Create(App);
  Content.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(12, 6));
  Desktop.Add(Content);
  var Layout: TuiHorizontalLayout := TuiHorizontalLayout.Create(App);
  AssertTrue(TuiLayoutItems.Add(Layout.AsLayout(), TuiLayoutItem.ForView(Content, TuiAlignment.Fill(), 0)));
  var Container: TuiContainer := TuiDesktop.AsContainer(Desktop);
  Container.Layout := Some(Layout.AsLayout());
  AssertTrue(Desktop.NeedsLayout());
  App.RunIterations(1, 0);
  AssertFalse(Desktop.NeedsLayout());
  AssertEquals(12, Content.Bounds.Width);
  AssertEquals(6, Content.Bounds.Height);
  App.ResizeForTest(TuiSize.Create(20, 8));
  AssertEquals(20, App.Size.Width);
  AssertEquals(8, App.Size.Height);
  AssertEquals(20, DesktopView.Bounds.Width);
  AssertEquals(8, DesktopView.Bounds.Height);
  AssertTrue(Desktop.NeedsLayout());
  App.RunIterations(1, 0);
  AssertFalse(Desktop.NeedsLayout());
  AssertEquals(12, Content.Bounds.Width);
  AssertEquals(6, Content.Bounds.Height);
  App.ResizeForTest(TuiSize.Create(20, 8));
  AssertFalse(Desktop.NeedsLayout());
  App.Quit();
  AssertFalse(Desktop.IsAlive());
  AssertFalse(Content.IsAlive())
end.
