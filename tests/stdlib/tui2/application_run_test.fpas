program Tui2ApplicationRunTest;

uses Std.Test, Std.Tui2;

begin
  mutable var Starts: integer := 0;
  mutable var Ticks: integer := 0;
  mutable var Stops: integer := 0;
  var App: TuiApplication := TuiApplication.Open();
  AssertTrue(App.Size.Width >= 1);
  AssertTrue(App.Size.Height >= 1);
  App.OnStart := procedure(Sender: TuiApplication) begin
    Starts := Starts + 1
  end;
  App.OnTick := procedure(Sender: TuiApplication; DeltaMilliseconds: integer) begin
    Ticks := Ticks + 1;
    AssertEquals(16, DeltaMilliseconds);
    Sender.Quit()
  end;
  App.OnStop := procedure(Sender: TuiApplication) begin
    Stops := Stops + 1
  end;
  App.Run();
  AssertEquals(1, Starts);
  AssertEquals(1, Ticks);
  AssertEquals(1, Stops);
  AssertFalse(App.IsOpen());
  var Second: TuiApplication := TuiApplication.Open();
  Second.OnTick := procedure(Sender: TuiApplication; DeltaMilliseconds: integer) begin
    Sender.Quit()
  end;
  Second.Run();
  AssertFalse(Second.IsOpen())
end.
