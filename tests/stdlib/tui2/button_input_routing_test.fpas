program Tui2ButtonInputRoutingTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 8));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var Action: TuiAction := TuiAction.Create(App, TuiCommand.Create(1024), 'Confirm');
  var Button: TuiButton := TuiButton.Create(App, 'Confirm');
  Button.Action := Action;
  var ButtonView: TuiView := TuiButton.AsView(Button);
  ButtonView.Bounds := TuiRect.Create(2, 1, 8, 3);
  Desktop.Add(ButtonView);
  mutable var Sequence: integer := 0;
  Action.OnExecute := procedure(Sender: TuiAction; Source: TuiView) begin
    AssertTrue(Source.Kind = TuiViewKind.Button);
    AssertEquals(ButtonView.Slot, Source.Slot);
    Sequence := Sequence * 10 + 1
  end;
  Button.OnClick := procedure(Sender: TuiButton) begin
    AssertTrue(Sender.Focused);
    Sequence := Sequence * 10 + 2
  end;
  AssertTrue(Desktop.FocusNext());
  AssertTrue(Button.Focused);
  case Desktop.HitTest(TuiPoint.Create(3, 2)) of
    None:
    begin
      panic('button must participate in hit testing')
    end;
    Some(Hit):
    begin
      AssertEquals(ButtonView.Slot, Hit.Slot)
    end
  end;
  var Input: TuiApplicationInput := App.Input;
  Input.OnKey := function(Key: TuiKeyEvent): boolean begin
    Sequence := Sequence * 10 + 9;
    return true
  end;
  Input.OnPointer := function(Pointer: TuiPointerEvent): boolean begin
    Sequence := Sequence * 10 + 8;
    return true
  end;
  var EnterKey: TuiKeyEvent := record
    kind := TuiKeyKind.Enter;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  var SpaceKey: TuiKeyEvent := record
    kind := TuiKeyKind.Space;
    ch := ' ';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  AssertTrue(Input.InjectKeyForTest(EnterKey));
  App.RunIterations(1, 0);
  AssertEquals(12, Sequence);
  AssertTrue(Input.InjectKeyForTest(SpaceKey));
  App.RunIterations(1, 0);
  AssertEquals(1212, Sequence);
  AssertTrue(Input.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(3, 2))));
  App.RunIterations(1, 0);
  AssertEquals(121212, Sequence);
  Button.Enabled := false;
  AssertFalse(Button.Focused);
  AssertTrue(Input.InjectKeyForTest(EnterKey));
  App.RunIterations(1, 0);
  AssertEquals(1212129, Sequence);
  AssertTrue(Input.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(3, 2))));
  App.RunIterations(1, 0);
  AssertEquals(12121298, Sequence);
  ButtonView.Destroy();
  AssertFalse(Button.IsAlive());
  App.Close()
end.
