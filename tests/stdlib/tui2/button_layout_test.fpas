program Tui2ButtonLayoutTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 4));
  var Container: TuiContainer := TuiContainer.Create(App);
  var ContainerView: TuiView := TuiContainer.AsView(Container);
  ContainerView.Bounds := TuiRect.Create(0, 0, 20, 4);
  var Row: TuiHorizontalLayout := TuiHorizontalLayout.Create(App);
  var Button: TuiButton := TuiButton.Create(App, 'Save');
  var ButtonView: TuiView := TuiButton.AsView(Button);
  AssertTrue(TuiLayoutItems.Add(Row.AsLayout(), TuiLayoutItem.ForView(ButtonView, TuiAlignment.Fill(), 0)));
  Container.Layout := Some(Row.AsLayout());
  Container.Add(ButtonView);
  mutable var Measured: TuiMeasureResult := TuiLayoutMeasure.Measure(Row.AsLayout(), TuiMeasureSpec.Unbounded());
  AssertEquals(6, Measured.Minimum.Width);
  AssertEquals(1, Measured.Minimum.Height);
  AssertEquals(6, Measured.Preferred.Width);
  AssertEquals(1, Measured.Preferred.Height);
  AssertTrue(Container.PerformLayout());
  AssertEquals(6, ButtonView.Bounds.Width);
  AssertEquals(1, ButtonView.Bounds.Height);
  Button.Text := 'Open File';
  AssertTrue(Container.NeedsLayout());
  AssertTrue(Container.PerformLayout());
  AssertEquals(11, ButtonView.Bounds.Width);
  AssertEquals(1, ButtonView.Bounds.Height);
  Measured := TuiLayoutMeasure.Measure(Row.AsLayout(), TuiMeasureSpec.Unbounded());
  AssertEquals(11, Measured.Preferred.Width);
  ContainerView.Destroy();
  App.Close()
end.
