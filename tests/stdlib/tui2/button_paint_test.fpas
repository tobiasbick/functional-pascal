program Tui2ButtonPaintTest;

uses Std.Option, Std.Test, Std.Tui2;

function CellAt(Surface: TuiSurface; X: integer; Y: integer): TuiCell;
begin
  return Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(X, Y)))
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(10, 4));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var Button: TuiButton := TuiButton.Create(App, 'Save');
  var View: TuiView := TuiButton.AsView(Button);
  View.Bounds := TuiRect.Create(2, 1, 6, 1);
  Desktop.Add(View);
  App.RunIterations(1, 0);
  mutable var Surface: TuiSurface := App.Surface;
  AssertEquals('[', CellAt(Surface, 2, 1).Glyph);
  AssertEquals('S', CellAt(Surface, 3, 1).Glyph);
  AssertEquals(']', CellAt(Surface, 7, 1).Glyph);
  AssertTrue(CellAt(Surface, 3, 1).Role = TuiStyleRole.Normal);
  AssertTrue(Button.Focus());
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertTrue(CellAt(Surface, 3, 1).Role = TuiStyleRole.Focused);
  Button.Text := 'Go';
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertEquals('[', CellAt(Surface, 2, 1).Glyph);
  AssertEquals('G', CellAt(Surface, 3, 1).Glyph);
  AssertEquals('o', CellAt(Surface, 4, 1).Glyph);
  AssertEquals(']', CellAt(Surface, 5, 1).Glyph);
  AssertEquals(' ', CellAt(Surface, 6, 1).Glyph);
  AssertTrue(CellAt(Surface, 6, 1).Role = TuiStyleRole.Focused);
  Button.Enabled := false;
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertTrue(CellAt(Surface, 3, 1).Role = TuiStyleRole.Disabled);
  AssertTrue(CellAt(Surface, 6, 1).Role = TuiStyleRole.Disabled);
  App.Close()
end.
