program Tui2CellValuesTest;

uses Std.Test, Std.Tui2;

begin
  var Foreground: TuiColor := TuiColor.FromCrt(14);
  AssertTrue(Foreground.Kind = TuiColorKind.Crt);
  AssertEquals(14, Foreground.Index);
  var Background: TuiColor := TuiColor.FromAnsi256(17);
  AssertTrue(Background.Kind = TuiColorKind.Ansi256);
  AssertEquals(17, Background.Index);
  var RgbValue: TuiColor := TuiColor.FromRgb(10, 20, 30);
  AssertTrue(RgbValue.Kind = TuiColorKind.Rgb);
  AssertEquals(20, RgbValue.Green);
  var Plain: TuiStyle := TuiStyle.FromColors(Foreground, Background);
  AssertFalse(Plain.Bold);
  AssertFalse(Plain.Underline);
  var Emphasized: TuiStyle := TuiStyle.Create(Foreground, Background, true, false, true, false);
  AssertTrue(Emphasized.Bold);
  AssertTrue(Emphasized.Underline);
  var Cell: TuiCell := TuiCell.Create('X', TuiStyleRole.Focused);
  AssertEquals('X', Cell.Glyph);
  AssertTrue(Cell.Role = TuiStyleRole.Focused);
  var Palette: TuiPalette := TuiPalette.Default();
  var NormalStyle: TuiStyle := Palette.ForRole(TuiStyleRole.Normal);
  AssertEquals(7, NormalStyle.Foreground.Index);
  var AccentStyle: TuiStyle := Palette.ForRole(TuiStyleRole.Accent);
  AssertEquals(11, AccentStyle.Foreground.Index);
  var Custom: TuiStyle := TuiStyle.FromColors(TuiColor.FromRgb(1, 2, 3), Background);
  var Updated: TuiPalette := Palette.WithRole(TuiStyleRole.Warning, Custom);
  var UpdatedWarning: TuiStyle := Updated.ForRole(TuiStyleRole.Warning);
  AssertEquals(2, UpdatedWarning.Foreground.Green);
  var UpdatedTitle: TuiStyle := Updated.ForRole(TuiStyleRole.Title);
  AssertEquals(14, UpdatedTitle.Foreground.Index)
end.
