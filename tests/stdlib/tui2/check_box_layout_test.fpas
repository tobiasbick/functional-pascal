program Tui2CheckBoxLayoutTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 4));
  var Container: TuiContainer := TuiContainer.Create(App);
  var ContainerView: TuiView := TuiContainer.AsView(Container);
  ContainerView.Bounds := TuiRect.Create(0, 0, 20, 4);
  var Row: TuiHorizontalLayout := TuiHorizontalLayout.Create(App);
  var CheckBox: TuiCheckBox := TuiCheckBox.Create(App, 'Save');
  var View: TuiView := TuiCheckBox.AsView(CheckBox);
  AssertTrue(TuiLayoutItems.Add(Row.AsLayout(), TuiLayoutItem.ForView(View, TuiAlignment.Leading(), 0)));
  Container.Layout := Some(Row.AsLayout());
  Container.Add(View);
  AssertTrue(Container.PerformLayout());
  AssertEquals(8, View.Bounds.Width);
  CheckBox.Text := 'Commit';
  AssertTrue(Container.NeedsLayout());
  AssertTrue(Container.PerformLayout());
  AssertEquals(10, View.Bounds.Width);
  ContainerView.Destroy();
  App.Close()
end.
