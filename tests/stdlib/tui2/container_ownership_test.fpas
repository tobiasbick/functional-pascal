program Tui2ContainerOwnershipTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var Container: TuiContainer := TuiContainer.Create(App);
  var Child: TuiView := TuiView.Create(App);
  Container.Add(Child);
  AssertTrue(Container.Contains(Child));
  Container.Remove(Child);
  AssertFalse(Child.IsAlive());
  var Replacement: TuiView := TuiView.Create(App);
  AssertEquals(Child.Slot, Replacement.Slot);
  AssertFalse(Container.Contains(Replacement));
  App.Close();
  AssertFalse(Container.IsAlive())
end.
