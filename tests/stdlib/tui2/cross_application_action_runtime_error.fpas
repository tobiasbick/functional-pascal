program Tui2CrossApplicationActionRuntimeError;

uses Std.Tui2;

begin
  var First: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var Second: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var Action: TuiAction := TuiAction.Create(First, TuiCommand.Create(1027), 'Foreign');
  var Button: TuiButton := TuiButton.Create(Second, 'Invalid');
  Button.Action := Action
end.
