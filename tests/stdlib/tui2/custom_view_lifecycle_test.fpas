program Tui2CustomViewLifecycleTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 12));
  var Parent: TuiContainer := TuiContainer.Create(App);
  var Custom: TuiCustomView := TuiCustomView.Create(App);
  var CustomView: TuiView := TuiCustomView.AsView(Custom);
  CustomView.Bounds := TuiRect.Create(1, 1, 1, 1);
  var Layout: TuiHorizontalLayout := TuiHorizontalLayout.Create(App);
  AssertTrue(TuiLayoutItems.Add(Layout.AsLayout(), TuiLayoutItem.ForView(CustomView, TuiAlignment.Fill(), 0)));
  mutable var AttachCount: integer := 0;
  mutable var DetachCount: integer := 0;
  mutable var ResizeCount: integer := 0;
  mutable var TickCount: integer := 0;
  Custom.OnAttach := procedure(Sender: TuiCustomView) begin
    AttachCount := AttachCount + 1;
    AssertTrue(Sender.IsAlive());
    AssertTrue(Parent.Contains(TuiCustomView.AsView(Sender)));
    AssertEquals(1, TuiLayoutItems.Count(Layout.AsLayout()))
  end;
  Custom.OnDetach := procedure(Sender: TuiCustomView) begin
    DetachCount := DetachCount + 1;
    AssertTrue(Sender.IsAlive());
    AssertFalse(Parent.Contains(TuiCustomView.AsView(Sender)));
    AssertEquals(0, TuiLayoutItems.Count(Layout.AsLayout()))
  end;
  Custom.OnResize := procedure(Sender: TuiCustomView; OldBounds: TuiRect; NewBounds: TuiRect) begin
    ResizeCount := ResizeCount + 1;
    if ResizeCount = 1 then
    begin
      AssertEquals(1, OldBounds.X);
      AssertEquals(1, OldBounds.Y);
      AssertEquals(1, OldBounds.Width);
      AssertEquals(1, OldBounds.Height);
      AssertEquals(3, NewBounds.X);
      AssertEquals(4, NewBounds.Y);
      AssertEquals(7, NewBounds.Width);
      AssertEquals(6, NewBounds.Height);
      var SenderView: TuiView := TuiCustomView.AsView(Sender);
      SenderView.Bounds := TuiRect.Create(5, 6, 8, 7)
    end
    else
    begin
      AssertEquals(3, OldBounds.X);
      AssertEquals(4, OldBounds.Y);
      AssertEquals(7, OldBounds.Width);
      AssertEquals(6, OldBounds.Height);
      AssertEquals(5, NewBounds.X);
      AssertEquals(6, NewBounds.Y);
      AssertEquals(8, NewBounds.Width);
      AssertEquals(7, NewBounds.Height)
    end
  end;
  App.OnTick := procedure(Sender: TuiApplication; DeltaMilliseconds: integer) begin
    TickCount := TickCount + 1;
    AssertEquals(TickCount, ResizeCount)
  end;
  Parent.Add(CustomView);
  AssertEquals(1, AttachCount);
  CustomView.Bounds := TuiRect.Create(2, 3, 4, 5);
  CustomView.Bounds := TuiRect.Create(3, 4, 7, 6);
  AssertEquals(0, ResizeCount);
  App.RunIterations(1, 0);
  AssertEquals(1, ResizeCount);
  App.RunIterations(1, 0);
  AssertEquals(2, ResizeCount);
  Parent.Remove(CustomView);
  AssertEquals(1, DetachCount);
  AssertFalse(Custom.IsAlive());
  App.OnTick := nil;
  mutable var DestroyAttachCount: integer := 0;
  mutable var DestroyDetachCount: integer := 0;
  var DestroyOnAttach: TuiCustomView := TuiCustomView.Create(App);
  DestroyOnAttach.OnAttach := procedure(Sender: TuiCustomView) begin
    DestroyAttachCount := DestroyAttachCount + 1;
    Sender.Destroy()
  end;
  DestroyOnAttach.OnDetach := procedure(Sender: TuiCustomView) begin
    DestroyDetachCount := DestroyDetachCount + 1
  end;
  var DestroyOnAttachView: TuiView := TuiCustomView.AsView(DestroyOnAttach);
  Parent.Add(DestroyOnAttachView);
  AssertEquals(1, DestroyAttachCount);
  AssertEquals(1, DestroyDetachCount);
  AssertFalse(DestroyOnAttach.IsAlive());
  AssertFalse(Parent.Contains(DestroyOnAttachView));
  mutable var DestroyResizeCount: integer := 0;
  mutable var FollowingResizeCount: integer := 0;
  var DestroyOnResize: TuiCustomView := TuiCustomView.Create(App);
  DestroyOnResize.OnResize := procedure(Sender: TuiCustomView; OldBounds: TuiRect; NewBounds: TuiRect) begin
    DestroyResizeCount := DestroyResizeCount + 1;
    Sender.Destroy()
  end;
  var Following: TuiCustomView := TuiCustomView.Create(App);
  Following.OnResize := procedure(Sender: TuiCustomView; OldBounds: TuiRect; NewBounds: TuiRect) begin
    FollowingResizeCount := FollowingResizeCount + 1
  end;
  var DestroyOnResizeView: TuiView := TuiCustomView.AsView(DestroyOnResize);
  var FollowingView: TuiView := TuiCustomView.AsView(Following);
  Parent.Add(DestroyOnResizeView);
  Parent.Add(FollowingView);
  DestroyOnResizeView.Bounds := TuiRect.Create(0, 0, 2, 2);
  FollowingView.Bounds := TuiRect.Create(0, 0, 3, 3);
  App.RunIterations(1, 0);
  AssertEquals(1, DestroyResizeCount);
  AssertEquals(1, FollowingResizeCount);
  AssertFalse(DestroyOnResize.IsAlive());
  AssertFalse(Parent.Contains(DestroyOnResizeView));
  mutable var CloseDetachCount: integer := 0;
  Following.OnDetach := procedure(Sender: TuiCustomView) begin
    CloseDetachCount := CloseDetachCount + 1;
    AssertTrue(Sender.IsAlive())
  end;
  App.Close();
  AssertEquals(1, CloseDetachCount);
  AssertFalse(Following.IsAlive());
  AssertFalse(Parent.IsAlive());
  AssertFalse(Layout.IsAlive())
end.
