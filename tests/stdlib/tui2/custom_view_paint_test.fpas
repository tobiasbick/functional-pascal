program Tui2CustomViewPaintTest;

uses Std.Option, Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(8, 4));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var Parent: TuiContainer := TuiContainer.Create(App);
  var ParentView: TuiView := TuiContainer.AsView(Parent);
  ParentView.Bounds := TuiRect.Create(1, 1, 5, 2);
  var Custom: TuiCustomView := TuiCustomView.Create(App);
  var View: TuiView := TuiCustomView.AsView(Custom);
  View.Bounds := TuiRect.Create(-1, 0, 4, 2);
  mutable var PaintCount: integer := 0;
  mutable var LastEnabled: boolean := true;
  Custom.OnPaint := procedure(Sender: TuiCustomView; Canvas: TuiCanvas; Context: TuiPaintContext) begin
    PaintCount := PaintCount + 1;
    LastEnabled := Context.Enabled;
    AssertTrue(Sender.IsAlive());
    AssertEquals(0, Context.Bounds.X);
    AssertEquals(0, Context.Bounds.Y);
    AssertEquals(4, Context.Bounds.Width);
    AssertEquals(2, Context.Bounds.Height);
    AssertEquals(1, Context.Clip.X);
    AssertEquals(0, Context.Clip.Y);
    AssertEquals(3, Context.Clip.Width);
    AssertEquals(2, Context.Clip.Height);
    AssertFalse(Context.Focused);
    Canvas.FillRect(Context.Bounds, TuiCell.Create('#', TuiStyleRole.Accent))
  end;
  Parent.Add(View);
  Desktop.Add(ParentView);
  App.RunIterations(1, 0);
  AssertEquals(1, PaintCount);
  mutable var Surface: TuiSurface := App.Surface;
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 1))).Glyph);
  AssertEquals('#', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 1))).Glyph);
  AssertEquals('#', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(3, 2))).Glyph);
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(4, 1))).Glyph);
  App.RunIterations(1, 0);
  AssertEquals(1, PaintCount);
  Custom.Invalidate();
  App.RunIterations(1, 0);
  AssertEquals(2, PaintCount);
  ParentView.Enabled := false;
  App.RunIterations(1, 0);
  AssertEquals(3, PaintCount);
  AssertFalse(LastEnabled);
  ParentView.Visible := false;
  App.RunIterations(1, 0);
  AssertEquals(3, PaintCount);
  Surface := App.Surface;
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 1))).Glyph);
  ParentView.Visible := true;
  App.RunIterations(1, 0);
  AssertEquals(4, PaintCount);
  Custom.OnPaint := nil;
  App.RunIterations(1, 0);
  AssertEquals(4, PaintCount);
  Surface := App.Surface;
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 1))).Glyph);
  App.Close()
end.
