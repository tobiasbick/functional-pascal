program Tui2FormLayoutTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var Form: TuiFormLayout := TuiFormLayout.Create(App);
  var FirstLabel: TuiView := TuiView.Create(App);
  var FirstField: TuiView := TuiView.Create(App);
  var SecondLabel: TuiView := TuiView.Create(App);
  var SecondField: TuiView := TuiView.Create(App);
  FirstLabel.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(3, 1));
  FirstField.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(5, 1));
  SecondLabel.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(4, 1));
  SecondField.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(2, 2));
  AssertTrue(Form.AsLayout().Kind = TuiLayoutKind.Form);
  AssertTrue(TuiLayoutSettings.SetMargins(Form.AsLayout(), TuiMargins.Uniform(1)));
  AssertTrue(TuiLayoutSettings.SetSpacing(Form.AsLayout(), 1));
  AssertTrue(TuiFormItems.AddRow(Form, FirstLabel, FirstField));
  AssertTrue(TuiFormItems.AddRow(Form, SecondLabel, SecondField));
  AssertEquals(2, TuiFormItems.Count(Form));
  AssertEquals(FirstLabel.Slot, TuiFormItems.LabelAt(Form, 0).Slot);
  AssertEquals(SecondField.Slot, TuiFormItems.FieldAt(Form, 1).Slot);
  var Measured: TuiMeasureResult := TuiLayoutMeasure.Measure(Form.AsLayout(), TuiMeasureSpec.Unbounded());
  AssertEquals(12, Measured.Preferred.Width);
  AssertEquals(6, Measured.Preferred.Height);
  AssertTrue(TuiLayoutArrange.Arrange(Form.AsLayout(), TuiRect.Create(10, 5, 12, 6)));
  AssertEquals(12, FirstLabel.Bounds.X);
  AssertEquals(6, FirstLabel.Bounds.Y);
  AssertEquals(16, FirstField.Bounds.X);
  AssertEquals(6, FirstField.Bounds.Y);
  AssertEquals(11, SecondLabel.Bounds.X);
  AssertEquals(8, SecondLabel.Bounds.Y);
  AssertEquals(16, SecondField.Bounds.X);
  AssertEquals(8, SecondField.Bounds.Y);
  FirstLabel.Destroy();
  AssertEquals(1, TuiFormItems.Count(Form));
  AssertTrue(FirstField.IsAlive());
  var FormGrid: TuiGridLayout := record Layout := Form.AsLayout(); end;
  AssertEquals(2, TuiGridItems.Count(FormGrid));
  AssertTrue(TuiFormItems.RemoveAt(Form, 0));
  AssertEquals(0, TuiFormItems.Count(Form));
  AssertTrue(SecondLabel.IsAlive());
  AssertTrue(SecondField.IsAlive());
  FirstField.Destroy();
  SecondLabel.Destroy();
  SecondField.Destroy();
  Form.Destroy();
  App.Close()
end.
