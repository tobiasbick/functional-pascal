program Tui2FrameControlTest;

uses Std.Option, Std.Test, Std.Tui2;

function CellAt(Surface: TuiSurface; X: integer; Y: integer): TuiCell;
begin
  return Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(X, Y)))
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(12, 7));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var Frame: TuiFrame := TuiFrame.Create(App);
  var FrameView: TuiView := TuiFrame.AsView(Frame);
  FrameView.Bounds := TuiRect.Create(1, 1, 8, 4);
  Desktop.Add(FrameView);
  var Content: TuiRect := Frame.ContentBounds;
  AssertEquals(1, Content.X);
  AssertEquals(1, Content.Y);
  AssertEquals(6, Content.Width);
  AssertEquals(2, Content.Height);
  var Label: TuiLabel := TuiLabel.Create(App, 'Hi');
  var Row: TuiHorizontalLayout := TuiHorizontalLayout.Create(App);
  AssertTrue(TuiLayoutItems.Add(Row.AsLayout(), TuiLayoutItem.ForView(TuiLabel.AsView(Label), TuiAlignment.Leading(), 0)));
  Frame.Layout := Some(Row.AsLayout());
  TuiFrame.AsContainer(Frame).Add(TuiLabel.AsView(Label));
  AssertTrue(Frame.PerformLayout());
  var LabelView: TuiView := TuiLabel.AsView(Label);
  AssertEquals(0, LabelView.Bounds.X);
  AssertEquals(0, LabelView.Bounds.Y);
  var ClippedLabel: TuiLabel := TuiLabel.Create(App, 'X');
  var ClippedView: TuiView := TuiLabel.AsView(ClippedLabel);
  ClippedView.Bounds := TuiRect.Create(6, 0, 1, 1);
  TuiFrame.AsContainer(Frame).Add(ClippedView);
  App.RunIterations(1, 0);
  mutable var Surface: TuiSurface := App.Surface;
  AssertEquals('┌', CellAt(Surface, 1, 1).Glyph);
  AssertEquals('┐', CellAt(Surface, 8, 1).Glyph);
  AssertEquals('└', CellAt(Surface, 1, 4).Glyph);
  AssertEquals('┘', CellAt(Surface, 8, 4).Glyph);
  AssertTrue(CellAt(Surface, 1, 1).Role = TuiStyleRole.Frame);
  AssertEquals('H', CellAt(Surface, 2, 2).Glyph);
  AssertEquals('i', CellAt(Surface, 3, 2).Glyph);
  AssertEquals('│', CellAt(Surface, 8, 2).Glyph);
  FrameView.Enabled := false;
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertTrue(CellAt(Surface, 1, 1).Role = TuiStyleRole.Disabled);
  Frame.Destroy();
  AssertFalse(Frame.IsAlive());
  AssertFalse(Label.IsAlive());
  AssertFalse(ClippedLabel.IsAlive());
  App.Close()
end.
