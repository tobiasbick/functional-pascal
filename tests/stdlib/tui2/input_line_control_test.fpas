program Tui2InputLineControlTest;

uses Std.Option, Std.Test, Std.Tui2;

function CellAt(Surface: TuiSurface; X: integer; Y: integer): TuiCell;
begin
  return Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(X, Y)))
end;

function MakeKey(Kind: TuiKeyKind; Character: string): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(12, 3));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var Input: TuiInputLine := TuiInputLine.Create(App, 5);
  var View: TuiView := TuiInputLine.AsView(Input);
  View.Bounds := TuiRect.Create(1, 1, 5, 1);
  Desktop.Add(View);
  AssertTrue(Input.Focus());
  AssertTrue(Input.Focused);
  var InputApi: TuiApplicationInput := App.Input;
  AssertTrue(InputApi.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'a')));
  AssertTrue(InputApi.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'b')));
  AssertTrue(InputApi.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'c')));
  App.RunIterations(3, 0);
  AssertEquals('abc', Input.Text);
  AssertTrue(InputApi.InjectKeyForTest(MakeKey(TuiKeyKind.Left, '')));
  AssertTrue(InputApi.InjectKeyForTest(MakeKey(TuiKeyKind.Backspace, '')));
  App.RunIterations(2, 0);
  AssertEquals('ac', Input.Text);
  AssertTrue(InputApi.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(2, 1))));
  App.RunIterations(1, 0);
  AssertTrue(InputApi.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'X')));
  App.RunIterations(1, 0);
  AssertEquals('aXc', Input.Text);
  Input.Text := 'hello';
  AssertEquals('hello', Input.Text);
  AssertTrue(InputApi.InjectKeyForTest(MakeKey(TuiKeyKind.Character, '!')));
  App.RunIterations(1, 0);
  AssertEquals('hello', Input.Text);
  App.RunIterations(1, 0);
  mutable var Surface: TuiSurface := App.Surface;
  AssertEquals('h', CellAt(Surface, 1, 1).Glyph);
  AssertEquals('o', CellAt(Surface, 5, 1).Glyph);
  AssertTrue(CellAt(Surface, 1, 1).Role = TuiStyleRole.Focused);
  View.Enabled := false;
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertTrue(CellAt(Surface, 1, 1).Role = TuiStyleRole.Disabled);
  Input.Destroy();
  AssertFalse(Input.IsAlive());
  App.Close()
end.
