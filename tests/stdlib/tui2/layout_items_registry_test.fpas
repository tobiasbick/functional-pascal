program Tui2LayoutItemsRegistryTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var Parent: TuiLayout := TuiLayout.Create(App);
  var Nested: TuiLayout := TuiLayout.Create(App);
  var View: TuiView := TuiView.Create(App);
  var ViewItem: TuiLayoutItem := TuiLayoutItem.ForView(View, TuiAlignment.Fill(), 1);
  var SpacerItem: TuiLayoutItem := TuiLayoutItem.ForSpacer(TuiSpacer.Fixed(2), TuiAlignment.Leading(), 0);
  var NestedItem: TuiLayoutItem := TuiLayoutItem.ForLayout(Nested, TuiAlignment.Center(), 2);
  AssertTrue(TuiLayoutItems.CanAdd(Parent, ViewItem));
  AssertTrue(TuiLayoutItems.Add(Parent, ViewItem));
  AssertTrue(TuiLayoutItems.Add(Parent, SpacerItem));
  AssertTrue(TuiLayoutItems.Add(Parent, NestedItem));
  AssertEquals(3, TuiLayoutItems.Count(Parent));
  AssertTrue(TuiLayoutItems.Get(Parent, 0).Kind = TuiLayoutItemKind.View);
  AssertTrue(TuiLayoutItems.Get(Parent, 1).Kind = TuiLayoutItemKind.Spacer);
  AssertTrue(TuiLayoutItems.Get(Parent, 2).Kind = TuiLayoutItemKind.Layout);
  AssertFalse(TuiLayoutItems.CanAdd(Parent, ViewItem));
  AssertFalse(TuiLayoutItems.CanAdd(Nested, TuiLayoutItem.ForLayout(Parent, TuiAlignment.Fill(), 1)));
  var Container: TuiContainer := TuiContainer.Create(App);
  var RootLayout: TuiLayout := TuiLayout.Create(App);
  Container.Layout := Some(RootLayout);
  AssertFalse(TuiLayoutItems.CanAdd(Parent, TuiLayoutItem.ForLayout(RootLayout, TuiAlignment.Fill(), 1)));
  AssertTrue(TuiLayoutItems.RemoveAt(Parent, 1));
  AssertEquals(2, TuiLayoutItems.Count(Parent));
  AssertTrue(TuiLayoutItems.Get(Parent, 1).Kind = TuiLayoutItemKind.Layout);
  Nested.Destroy();
  AssertEquals(1, TuiLayoutItems.Count(Parent));
  var DisposableView: TuiView := TuiView.Create(App);
  AssertTrue(TuiLayoutItems.Add(Parent, TuiLayoutItem.ForView(DisposableView, TuiAlignment.Fill(), 1)));
  AssertEquals(2, TuiLayoutItems.Count(Parent));
  DisposableView.Destroy();
  AssertEquals(1, TuiLayoutItems.Count(Parent));
  var Replacement: TuiLayout := TuiLayout.Create(App);
  AssertTrue(TuiLayoutItems.Add(Parent, TuiLayoutItem.ForLayout(Replacement, TuiAlignment.Fill(), 1)));
  AssertTrue(TuiLayoutItems.Clear(Parent));
  AssertEquals(0, TuiLayoutItems.Count(Parent));
  AssertFalse(Replacement.IsAlive());
  AssertTrue(View.IsAlive());
  var Owned: TuiLayout := TuiLayout.Create(App);
  AssertTrue(TuiLayoutItems.Add(Parent, TuiLayoutItem.ForLayout(Owned, TuiAlignment.Fill(), 1)));
  Parent.Destroy();
  AssertFalse(Owned.IsAlive());
  AssertTrue(View.IsAlive());
  TuiContainer.AsView(Container).Destroy();
  AssertFalse(RootLayout.IsAlive());
  App.Close()
end.
