program Tui2LayoutRegistryTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var First: TuiLayout := TuiLayout.Create(App);
  First.Tag := 7;
  AssertEquals(7, First.Tag);
  First.Destroy();
  AssertFalse(First.IsAlive());
  var Second: TuiLayout := TuiLayout.Create(App);
  AssertEquals(First.Slot, Second.Slot);
  AssertFalse(First.Generation = Second.Generation);
  AssertEquals(0, Second.Tag);
  App.Close();
  AssertFalse(Second.IsAlive())
end.
