program Tui2ListBoxControlTest;

uses Std.Option, Std.Test, Std.Tui2;

function CellAt(Surface: TuiSurface; X: integer; Y: integer): TuiCell;
begin
  return Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(X, Y)))
end;

function MakeKey(Kind: TuiKeyKind): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(16, 6));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var ListBox: TuiListBox := TuiListBox.Create(App);
  AssertEquals(-1, ListBox.Selected);
  ListBox.Items := ['One', 'Two', 'Three'];
  AssertEquals(0, ListBox.Selected);
  var View: TuiView := TuiListBox.AsView(ListBox);
  View.Bounds := TuiRect.Create(1, 1, 9, 3);
  Desktop.Add(View);
  AssertTrue(ListBox.Focus());
  mutable var Changes: integer := 0;
  mutable var LastSelected: integer := -1;
  mutable var LastOrigin: TuiChangeOrigin := TuiChangeOrigin.Programmatic;
  ListBox.OnSelectionChanged := procedure(Sender: TuiListBox; Selected: integer; Origin: TuiChangeOrigin) begin
    AssertTrue(Sender.IsAlive());
    Changes := Changes + 1;
    LastSelected := Selected;
    LastOrigin := Origin
  end;
  var Input: TuiApplicationInput := App.Input;
  AssertTrue(Input.InjectKeyForTest(MakeKey(TuiKeyKind.Down)));
  App.RunIterations(1, 0);
  AssertEquals(1, ListBox.Selected);
  AssertEquals(1, Changes);
  AssertEquals(1, LastSelected);
  AssertTrue(LastOrigin = TuiChangeOrigin.User);
  AssertTrue(Input.InjectKeyForTest(MakeKey(TuiKeyKind.Home)));
  App.RunIterations(1, 0);
  AssertEquals(0, ListBox.Selected);
  AssertEquals(2, Changes);
  AssertTrue(Input.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(2, 3))));
  App.RunIterations(1, 0);
  AssertEquals(2, ListBox.Selected);
  AssertEquals(3, Changes);
  AssertTrue(LastOrigin = TuiChangeOrigin.User);
  ListBox.Selected := 1;
  AssertEquals(1, ListBox.Selected);
  AssertEquals(4, Changes);
  AssertTrue(LastOrigin = TuiChangeOrigin.Programmatic);
  ListBox.Selected := 1;
  AssertEquals(4, Changes);
  ListBox.Selected := 99;
  AssertEquals(2, ListBox.Selected);
  AssertEquals(5, Changes);
  ListBox.Items := ['Only'];
  AssertEquals(0, ListBox.Selected);
  AssertEquals(6, Changes);
  App.RunIterations(1, 0);
  mutable var Surface: TuiSurface := App.Surface;
  AssertEquals('>', CellAt(Surface, 1, 1).Glyph);
  AssertEquals('O', CellAt(Surface, 3, 1).Glyph);
  AssertTrue(CellAt(Surface, 1, 1).Role = TuiStyleRole.Focused);
  View.Enabled := false;
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertTrue(CellAt(Surface, 1, 1).Role = TuiStyleRole.Disabled);
  ListBox.Items := [];
  AssertEquals(-1, ListBox.Selected);
  AssertEquals(7, Changes);
  ListBox.Destroy();
  AssertFalse(ListBox.IsAlive());
  App.Close()
end.
