program Tui2ListBoxLayoutTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 5));
  var Container: TuiContainer := TuiContainer.Create(App);
  var ContainerView: TuiView := TuiContainer.AsView(Container);
  ContainerView.Bounds := TuiRect.Create(0, 0, 20, 5);
  var Row: TuiHorizontalLayout := TuiHorizontalLayout.Create(App);
  var ListBox: TuiListBox := TuiListBox.Create(App);
  ListBox.Items := ['One', 'Longest'];
  var View: TuiView := TuiListBox.AsView(ListBox);
  AssertTrue(TuiLayoutItems.Add(Row.AsLayout(), TuiLayoutItem.ForView(View, TuiAlignment.Leading(), 0)));
  Container.Layout := Some(Row.AsLayout());
  Container.Add(View);
  AssertTrue(Container.PerformLayout());
  AssertEquals(9, View.Bounds.Width);
  AssertEquals(2, View.Bounds.Height);
  ListBox.Items := ['x'];
  AssertTrue(Container.NeedsLayout());
  AssertTrue(Container.PerformLayout());
  AssertEquals(3, View.Bounds.Width);
  AssertEquals(1, View.Bounds.Height);
  ContainerView.Destroy();
  App.Close()
end.
