program Tui2ScrollBarControlTest;

uses Std.Option, Std.Test, Std.Tui2;

function CellAt(Surface: TuiSurface; X: integer; Y: integer): TuiCell;
begin
  return Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(X, Y)))
end;

function MakeKey(Kind: TuiKeyKind): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(8, 8));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var ScrollBar: TuiScrollBar := TuiScrollBar.Create(App);
  var View: TuiView := TuiScrollBar.AsView(ScrollBar);
  View.Bounds := TuiRect.Create(3, 1, 1, 6);
  Desktop.Add(View);
  AssertTrue(View.Kind = TuiViewKind.ScrollBar);
  AssertEquals(0, ScrollBar.Maximum);
  AssertEquals(1, ScrollBar.PageSize);
  ScrollBar.Maximum := 9;
  ScrollBar.PageSize := 3;
  AssertTrue(ScrollBar.Focus());
  mutable var Changes: integer := 0;
  mutable var LastPosition: integer := -1;
  mutable var LastOrigin: TuiChangeOrigin := TuiChangeOrigin.Programmatic;
  ScrollBar.OnPositionChanged := procedure(Sender: TuiScrollBar; Position: integer; Origin: TuiChangeOrigin) begin
    AssertTrue(Sender.IsAlive());
    Changes := Changes + 1;
    LastPosition := Position;
    LastOrigin := Origin
  end;
  var Input: TuiApplicationInput := App.Input;
  ScrollBar.Position := 9;
  AssertEquals(9, ScrollBar.Position);
  AssertEquals(1, Changes);
  AssertTrue(LastOrigin = TuiChangeOrigin.Programmatic);
  AssertTrue(Input.InjectKeyForTest(MakeKey(TuiKeyKind.Up)));
  App.RunIterations(1, 0);
  AssertEquals(8, ScrollBar.Position);
  AssertEquals(2, Changes);
  AssertTrue(Input.InjectKeyForTest(MakeKey(TuiKeyKind.Home)));
  App.RunIterations(1, 0);
  AssertEquals(0, ScrollBar.Position);
  AssertTrue(Input.InjectPointerForTest(TuiPointerEvent.Create(TuiPointerAction.Down, TuiPointerButton.Left, TuiPoint.Create(3, 5))));
  App.RunIterations(1, 0);
  AssertEquals(9, ScrollBar.Position);
  AssertEquals(4, Changes);
  AssertEquals(9, LastPosition);
  ScrollBar.Position := 99;
  AssertEquals(9, ScrollBar.Position);
  AssertEquals(4, Changes);
  ScrollBar.Maximum := 2;
  AssertEquals(2, ScrollBar.Position);
  AssertEquals(5, Changes);
  AssertTrue(LastOrigin = TuiChangeOrigin.Programmatic);
  App.RunIterations(1, 0);
  mutable var Surface: TuiSurface := App.Surface;
  AssertEquals('▲', CellAt(Surface, 3, 1).Glyph);
  AssertEquals('▼', CellAt(Surface, 3, 6).Glyph);
  AssertEquals('█', CellAt(Surface, 3, 5).Glyph);
  AssertTrue(CellAt(Surface, 3, 5).Role = TuiStyleRole.Focused);
  View.Enabled := false;
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertTrue(CellAt(Surface, 3, 1).Role = TuiStyleRole.Disabled);
  AssertTrue(CellAt(Surface, 3, 5).Role = TuiStyleRole.Disabled);
  ScrollBar.Destroy();
  AssertFalse(ScrollBar.IsAlive());
  App.Close()
end.
