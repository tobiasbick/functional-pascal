program Tui2ScrollViewTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var ScrollView: TuiScrollView := TuiScrollView.Create(App);
  var View: TuiView := TuiScrollView.AsView(ScrollView);
  View.Bounds := TuiRect.Create(4, 2, 5, 3);
  AssertTrue(ScrollView.IsAlive());
  AssertEquals(5, ScrollView.ViewportSize.Width);
  AssertEquals(3, ScrollView.ViewportSize.Height);
  AssertEquals(5, ScrollView.ContentSize.Width);
  AssertEquals(3, ScrollView.ContentSize.Height);
  AssertEquals(0, ScrollView.MaximumOffset.X);
  AssertEquals(0, ScrollView.MaximumOffset.Y);
  AssertEquals(0, ScrollView.Offset.X);
  AssertEquals(0, ScrollView.Offset.Y);
  AssertFalse(ScrollView.NeedsLayout());
  AssertFalse(ScrollView.PerformLayout());
  var ContentLayout: TuiHorizontalLayout := TuiHorizontalLayout.Create(App);
  var Content: TuiView := TuiView.Create(App);
  Content.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(8, 6));
  AssertTrue(TuiLayoutItems.Add(ContentLayout.AsLayout(), TuiLayoutItem.ForView(Content, TuiAlignment.Fill(), 0)));
  ScrollView.Layout := Some(ContentLayout.AsLayout());
  AssertEquals(8, ScrollView.ContentSize.Width);
  AssertEquals(6, ScrollView.ContentSize.Height);
  AssertEquals(3, ScrollView.MaximumOffset.X);
  AssertEquals(3, ScrollView.MaximumOffset.Y);
  ScrollView.Offset := TuiPoint.Create(2, 1);
  AssertEquals(2, ScrollView.Offset.X);
  AssertEquals(1, ScrollView.Offset.Y);
  AssertTrue(ScrollView.NeedsLayout());
  AssertTrue(ScrollView.PerformLayout());
  AssertEquals(-2, Content.Bounds.X);
  AssertEquals(-1, Content.Bounds.Y);
  AssertEquals(8, Content.Bounds.Width);
  AssertEquals(6, Content.Bounds.Height);
  AssertFalse(ScrollView.NeedsLayout());
  var Container: TuiContainer := TuiScrollView.AsContainer(ScrollView);
  AssertTrue(Container.PerformLayout());
  AssertEquals(0, Content.Bounds.X);
  AssertEquals(0, Content.Bounds.Y);
  AssertTrue(ScrollView.NeedsLayout());
  AssertTrue(ScrollView.PerformLayout());
  AssertEquals(-2, Content.Bounds.X);
  AssertEquals(-1, Content.Bounds.Y);
  ScrollView.Offset := TuiPoint.Create(99, 99);
  AssertEquals(3, ScrollView.Offset.X);
  AssertEquals(3, ScrollView.Offset.Y);
  AssertTrue(ScrollView.PerformLayout());
  AssertEquals(-3, Content.Bounds.X);
  AssertEquals(-3, Content.Bounds.Y);
  Content.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(6, 4));
  AssertEquals(6, ScrollView.ContentSize.Width);
  AssertEquals(4, ScrollView.ContentSize.Height);
  AssertEquals(1, ScrollView.MaximumOffset.X);
  AssertEquals(1, ScrollView.MaximumOffset.Y);
  AssertEquals(1, ScrollView.Offset.X);
  AssertEquals(1, ScrollView.Offset.Y);
  AssertTrue(ScrollView.NeedsLayout());
  AssertTrue(ScrollView.PerformLayout());
  AssertEquals(-1, Content.Bounds.X);
  AssertEquals(-1, Content.Bounds.Y);
  Content.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(8, 6));
  AssertTrue(ScrollView.PerformLayout());
  View.Bounds := TuiRect.Create(4, 2, 10, 7);
  AssertEquals(0, ScrollView.Offset.X);
  AssertEquals(0, ScrollView.Offset.Y);
  AssertEquals(10, ScrollView.ContentSize.Width);
  AssertEquals(7, ScrollView.ContentSize.Height);
  AssertEquals(0, ScrollView.MaximumOffset.X);
  AssertEquals(0, ScrollView.MaximumOffset.Y);
  AssertTrue(ScrollView.NeedsLayout());
  AssertTrue(ScrollView.PerformLayout());
  AssertEquals(0, Content.Bounds.X);
  AssertEquals(0, Content.Bounds.Y);
  ScrollView.Destroy();
  AssertFalse(ScrollView.IsAlive());
  AssertFalse(ContentLayout.IsAlive());
  AssertTrue(Content.IsAlive());
  Content.Destroy();
  App.Close()
end.
