program Tui2SizePolicyTest;

uses Std.Test, Std.Tui2;

begin
  var Mixed: TuiSizePolicy := TuiSizePolicy.Create(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Fixed);
  AssertTrue(Mixed.Horizontal = TuiSizePolicyKind.Expanding);
  AssertTrue(Mixed.Vertical = TuiSizePolicyKind.Fixed);
  var Fixed: TuiSizePolicy := TuiSizePolicy.Fixed();
  AssertTrue(Fixed.Horizontal = TuiSizePolicyKind.Fixed);
  AssertTrue(Fixed.Vertical = TuiSizePolicyKind.Fixed);
  var Minimum: TuiSizePolicy := TuiSizePolicy.Minimum();
  AssertTrue(Minimum.Horizontal = TuiSizePolicyKind.Minimum);
  var Maximum: TuiSizePolicy := TuiSizePolicy.Maximum();
  AssertTrue(Maximum.Vertical = TuiSizePolicyKind.Maximum);
  var Preferred: TuiSizePolicy := TuiSizePolicy.Preferred();
  AssertTrue(Preferred.Horizontal = TuiSizePolicyKind.Preferred);
  var Expanding: TuiSizePolicy := TuiSizePolicy.Expanding();
  AssertTrue(Expanding.Vertical = TuiSizePolicyKind.Expanding)
end.
