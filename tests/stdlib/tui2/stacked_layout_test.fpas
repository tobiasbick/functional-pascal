program Tui2StackedLayoutTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 25));
  var Stacked: TuiStackedLayout := TuiStackedLayout.Create(App);
  var First: TuiView := TuiView.Create(App);
  var Second: TuiView := TuiView.Create(App);
  var Hidden: TuiView := TuiView.Create(App);
  First.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(2, 1));
  Second.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(5, 3));
  Hidden.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(9, 9));
  Hidden.Visible := false;
  AssertTrue(Stacked.AsLayout().Kind = TuiLayoutKind.Stacked);
  AssertEquals(-1, Stacked.CurrentIndex);
  AssertTrue(TuiLayoutSettings.SetMargins(Stacked.AsLayout(), TuiMargins.Uniform(1)));
  AssertTrue(TuiStackedItems.Add(Stacked, TuiLayoutItem.ForView(First, TuiAlignment.Center(), 0)));
  AssertTrue(TuiStackedItems.Add(Stacked, TuiLayoutItem.ForView(Second, TuiAlignment.Fill(), 0)));
  AssertTrue(TuiStackedItems.Add(Stacked, TuiLayoutItem.ForView(Hidden, TuiAlignment.Fill(), 0)));
  AssertEquals(0, Stacked.CurrentIndex);
  var Measured: TuiMeasureResult := TuiLayoutMeasure.Measure(Stacked.AsLayout(), TuiMeasureSpec.Unbounded());
  AssertEquals(7, Measured.Preferred.Width);
  AssertEquals(5, Measured.Preferred.Height);
  AssertTrue(TuiLayoutArrange.Arrange(Stacked.AsLayout(), TuiRect.Create(10, 4, 10, 6)));
  AssertEquals(14, First.Bounds.X);
  AssertEquals(6, First.Bounds.Y);
  AssertEquals(2, First.Bounds.Width);
  AssertEquals(1, First.Bounds.Height);
  Stacked.CurrentIndex := 1;
  AssertTrue(TuiLayoutArrange.Arrange(Stacked.AsLayout(), TuiRect.Create(10, 4, 10, 6)));
  AssertEquals(11, Second.Bounds.X);
  AssertEquals(5, Second.Bounds.Y);
  AssertEquals(5, Second.Bounds.Width);
  AssertEquals(3, Second.Bounds.Height);
  AssertTrue(TuiStackedItems.RemoveAt(Stacked, 1));
  AssertEquals(1, Stacked.CurrentIndex);
  AssertTrue(TuiStackedItems.RemoveAt(Stacked, 1));
  AssertEquals(0, Stacked.CurrentIndex);
  First.Destroy();
  AssertEquals(0, TuiStackedItems.Count(Stacked));
  AssertEquals(-1, Stacked.CurrentIndex);
  AssertTrue(Second.IsAlive());
  AssertTrue(Hidden.IsAlive());
  Second.Destroy();
  Hidden.Destroy();
  Stacked.Destroy();
  var NestedStack: TuiStackedLayout := TuiStackedLayout.Create(App);
  var NestedPage: TuiVerticalLayout := TuiVerticalLayout.Create(App);
  var NestedChild: TuiView := TuiView.Create(App);
  NestedChild.SizeHint := TuiMeasureResult.Fixed(TuiSize.Create(4, 2));
  AssertTrue(TuiLayoutItems.Add(NestedPage.AsLayout(), TuiLayoutItem.ForView(NestedChild, TuiAlignment.Fill(), 0)));
  AssertTrue(TuiStackedItems.Add(NestedStack, TuiLayoutItem.ForLayout(NestedPage.AsLayout(), TuiAlignment.Fill(), 0)));
  AssertTrue(TuiLayoutArrange.Arrange(NestedStack.AsLayout(), TuiRect.Create(2, 3, 4, 2)));
  AssertEquals(2, NestedChild.Bounds.X);
  AssertEquals(3, NestedChild.Bounds.Y);
  AssertEquals(4, NestedChild.Bounds.Width);
  AssertEquals(2, NestedChild.Bounds.Height);
  NestedChild.Destroy();
  NestedStack.Destroy();
  AssertFalse(NestedPage.IsAlive());
  App.Close()
end.
