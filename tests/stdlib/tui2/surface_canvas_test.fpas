program Tui2SurfaceCanvasTest;

uses Std.Option, Std.Test, Std.Tui2;

begin
  AssertEquals(1, TuiCell.Create('é', TuiStyleRole.Normal).Width());
  var Surface: TuiSurface := TuiSurface.Create(TuiSize.Create(4, 2));
  var Wide: TuiCell := TuiCell.Create('中', TuiStyleRole.Accent);
  Surface.PutCell(TuiPoint.Create(1, 0), Wide);
  AssertEquals('中', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertTrue(Std.Option.IsNone(Surface.TryCellAt(TuiPoint.Create(2, 0))));
  Surface.PutCell(TuiPoint.Create(2, 0), TuiCell.Create('X', TuiStyleRole.Normal));
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 0))).Glyph);
  AssertEquals('X', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(2, 0))).Glyph);
  var Canvas: TuiCanvas := TuiCanvas.Create(Surface, TuiRect.Create(0, 1, 3, 1));
  Canvas.FillRect(TuiRect.Create(0, 0, 4, 2), TuiCell.Create('.', TuiStyleRole.Frame));
  AssertEquals('.', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 1))).Glyph);
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(3, 1))).Glyph);
  Canvas.WriteText(TuiPoint.Create(0, 1), 'Hi', TuiStyleRole.Title);
  AssertEquals('H', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(0, 1))).Glyph);
  AssertEquals('i', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(1, 1))).Glyph)
end.
