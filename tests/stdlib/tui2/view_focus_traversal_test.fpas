program Tui2ViewFocusTraversalTest;

uses Std.Test, Std.Tui2;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 8));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var Parent: TuiContainer := TuiContainer.Create(App);
  var Nested: TuiContainer := TuiContainer.Create(App);
  var First: TuiCustomView := TuiCustomView.Create(App);
  var Second: TuiCustomView := TuiCustomView.Create(App);
  var Third: TuiCustomView := TuiCustomView.Create(App);
  var ParentView: TuiView := TuiContainer.AsView(Parent);
  var NestedView: TuiView := TuiContainer.AsView(Nested);
  var FirstView: TuiView := TuiCustomView.AsView(First);
  var SecondView: TuiView := TuiCustomView.AsView(Second);
  var ThirdView: TuiView := TuiCustomView.AsView(Third);
  Parent.Add(FirstView);
  Nested.Add(SecondView);
  Parent.Add(NestedView);
  Parent.Add(ThirdView);
  Desktop.Add(ParentView);
  AssertTrue(Desktop.FocusNext());
  AssertTrue(First.Focused);
  AssertTrue(Desktop.FocusNext());
  AssertTrue(Second.Focused);
  AssertTrue(Desktop.FocusNext());
  AssertTrue(Third.Focused);
  AssertTrue(Desktop.FocusNext());
  AssertTrue(First.Focused);
  AssertTrue(Desktop.FocusPrevious());
  AssertTrue(Third.Focused);
  NestedView.Enabled := false;
  AssertTrue(Desktop.FocusNext());
  AssertTrue(First.Focused);
  AssertTrue(Desktop.FocusPrevious());
  AssertTrue(Third.Focused);
  NestedView.Enabled := true;
  AssertTrue(Parent.BringToFront(FirstView));
  AssertTrue(First.Focus());
  AssertTrue(Desktop.FocusNext());
  AssertTrue(Second.Focused);
  FirstView.Visible := false;
  NestedView.Enabled := false;
  ThirdView.Visible := false;
  AssertFalse(Second.Focused);
  AssertFalse(Desktop.FocusNext());
  AssertFalse(Desktop.FocusPrevious());
  FirstView.Visible := true;
  AssertTrue(Desktop.FocusPrevious());
  AssertTrue(First.Focused);
  App.Close()
end.
