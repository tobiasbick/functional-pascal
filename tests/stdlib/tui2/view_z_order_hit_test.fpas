program Tui2ViewZOrderHitTest;

uses Std.Option, Std.Test, Std.Tui2;

procedure AssertHit(Expected: TuiView; Actual: option of TuiView);
begin
  case Actual of
    None:
    begin
      Fail('expected a hit-tested view')
    end;
    Some(View):
    begin
      AssertEquals(Expected.ApplicationId, View.ApplicationId);
      AssertEquals(Expected.Slot, View.Slot);
      AssertEquals(Expected.Generation, View.Generation)
    end
  end
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(12, 6));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var Parent: TuiContainer := TuiContainer.Create(App);
  var ParentView: TuiView := TuiContainer.AsView(Parent);
  ParentView.Bounds := TuiRect.Create(0, 0, 12, 6);
  var First: TuiCustomView := TuiCustomView.Create(App);
  var Second: TuiCustomView := TuiCustomView.Create(App);
  var FirstView: TuiView := TuiCustomView.AsView(First);
  var SecondView: TuiView := TuiCustomView.AsView(Second);
  FirstView.Bounds := TuiRect.Create(1, 1, 5, 3);
  SecondView.Bounds := TuiRect.Create(3, 1, 5, 3);
  First.OnPaint := procedure(Sender: TuiCustomView; Canvas: TuiCanvas; Context: TuiPaintContext) begin
    Canvas.FillRect(Context.Bounds, TuiCell.Create('A', TuiStyleRole.Normal))
  end;
  Second.OnPaint := procedure(Sender: TuiCustomView; Canvas: TuiCanvas; Context: TuiPaintContext) begin
    Canvas.FillRect(Context.Bounds, TuiCell.Create('B', TuiStyleRole.Normal))
  end;
  Parent.Add(FirstView);
  Parent.Add(SecondView);
  Desktop.Add(ParentView);
  App.RunIterations(1, 0);
  mutable var Surface: TuiSurface := App.Surface;
  AssertEquals('B', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(3, 1))).Glyph);
  AssertHit(SecondView, Desktop.HitTest(TuiPoint.Create(3, 1)));
  AssertTrue(Parent.SendToBack(SecondView));
  AssertFalse(Parent.SendToBack(SecondView));
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertEquals('A', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(3, 1))).Glyph);
  AssertHit(FirstView, Desktop.HitTest(TuiPoint.Create(3, 1)));
  AssertTrue(Parent.BringToFront(SecondView));
  AssertFalse(Parent.BringToFront(SecondView));
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertEquals('B', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(3, 1))).Glyph);
  AssertHit(SecondView, Desktop.HitTest(TuiPoint.Create(3, 1)));
  var Nested: TuiContainer := TuiContainer.Create(App);
  var NestedView: TuiView := TuiContainer.AsView(Nested);
  NestedView.Bounds := TuiRect.Create(9, 1, 2, 2);
  var Clipped: TuiCustomView := TuiCustomView.Create(App);
  var ClippedView: TuiView := TuiCustomView.AsView(Clipped);
  ClippedView.Bounds := TuiRect.Create(-1, 0, 3, 2);
  Clipped.OnPaint := procedure(Sender: TuiCustomView; Canvas: TuiCanvas; Context: TuiPaintContext) begin
    Canvas.FillRect(Context.Bounds, TuiCell.Create('C', TuiStyleRole.Accent))
  end;
  Nested.Add(ClippedView);
  Parent.Add(NestedView);
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertEquals(' ', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(8, 1))).Glyph);
  AssertEquals('C', Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(9, 1))).Glyph);
  AssertTrue(IsNone(Desktop.HitTest(TuiPoint.Create(8, 1))));
  AssertHit(ClippedView, Desktop.HitTest(TuiPoint.Create(9, 1)));
  NestedView.Enabled := false;
  AssertTrue(IsNone(Desktop.HitTest(TuiPoint.Create(9, 1))));
  NestedView.Enabled := true;
  ClippedView.Visible := false;
  AssertTrue(IsNone(Desktop.HitTest(TuiPoint.Create(9, 1))));
  AssertTrue(IsNone(Desktop.HitTest(TuiPoint.Create(12, 1))));
  App.Close()
end.
