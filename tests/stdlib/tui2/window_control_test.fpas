program Tui2WindowControlTest;

uses Std.Option, Std.Test, Std.Tui2;

function CellAt(Surface: TuiSurface; X: integer; Y: integer): TuiCell;
begin
  return Std.Option.Unwrap(Surface.TryCellAt(TuiPoint.Create(X, Y)))
end;

begin
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(14, 8));
  var Desktop: TuiDesktop := TuiDesktop.Create(App);
  var Window: TuiWindow := TuiWindow.Create(App, 'Options');
  var WindowView: TuiView := TuiWindow.AsView(Window);
  WindowView.Bounds := TuiRect.Create(1, 1, 10, 5);
  Desktop.Add(WindowView);
  AssertTrue(WindowView.Kind = TuiViewKind.Window);
  AssertEquals('Options', Window.Title);
  var Content: TuiRect := Window.ContentBounds;
  AssertEquals(1, Content.X);
  AssertEquals(1, Content.Y);
  AssertEquals(8, Content.Width);
  AssertEquals(3, Content.Height);
  var Label: TuiLabel := TuiLabel.Create(App, 'Hi');
  var Row: TuiHorizontalLayout := TuiHorizontalLayout.Create(App);
  AssertTrue(TuiLayoutItems.Add(Row.AsLayout(), TuiLayoutItem.ForView(TuiLabel.AsView(Label), TuiAlignment.Leading(), 0)));
  Window.Layout := Some(Row.AsLayout());
  Window.Add(TuiLabel.AsView(Label));
  AssertTrue(Window.PerformLayout());
  var LabelView: TuiView := TuiLabel.AsView(Label);
  AssertEquals(0, LabelView.Bounds.X);
  AssertEquals(0, LabelView.Bounds.Y);
  App.RunIterations(1, 0);
  mutable var Surface: TuiSurface := App.Surface;
  AssertEquals('┌', CellAt(Surface, 1, 1).Glyph);
  AssertEquals('┐', CellAt(Surface, 10, 1).Glyph);
  AssertTrue(CellAt(Surface, 1, 1).Role = TuiStyleRole.Frame);
  AssertEquals('O', CellAt(Surface, 3, 1).Glyph);
  AssertTrue(CellAt(Surface, 3, 1).Role = TuiStyleRole.Title);
  AssertEquals('H', CellAt(Surface, 2, 2).Glyph);
  AssertEquals('i', CellAt(Surface, 3, 2).Glyph);
  Window.Title := 'Go';
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertEquals('G', CellAt(Surface, 3, 1).Glyph);
  AssertEquals('o', CellAt(Surface, 4, 1).Glyph);
  AssertEquals('─', CellAt(Surface, 5, 1).Glyph);
  WindowView.Enabled := false;
  App.RunIterations(1, 0);
  Surface := App.Surface;
  AssertTrue(CellAt(Surface, 1, 1).Role = TuiStyleRole.Disabled);
  AssertTrue(CellAt(Surface, 3, 1).Role = TuiStyleRole.Disabled);
  Window.Destroy();
  AssertFalse(Window.IsAlive());
  AssertFalse(Label.IsAlive());
  App.Close()
end.
