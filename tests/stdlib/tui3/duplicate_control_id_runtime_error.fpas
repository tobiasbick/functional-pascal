program DuplicateControlIdRuntimeError;

uses Std.Tui3;

function Update(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  return State
end;

function View(State: integer): TuiElement;
begin
  var Id: TuiControlId := TuiControlId.Create(1);
  var Action: TuiAction := TuiAction.Create(10);
  return TuiElementBuilders.MakeRow([
                                      TuiElementBuilders.MakeButton(Id, 'First', Action),
                                      TuiElementBuilders.MakeButton(Id, 'Second', Action)

                                    ])
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 4));
  App.RunIterations(0, Update, View, 0, 0)
end.
