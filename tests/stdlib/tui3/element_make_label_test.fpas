program ElementMakeLabelTest;

uses Std.Tui3, Std.Test;

begin
  var Node: TuiElement := TuiElementBuilders.MakeLabel('hi');
  case Node of
    TuiElement.Label(Text):
    begin
      AssertEquals('hi', Text)
    end;
    TuiElement.Empty, TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(Children), TuiElement.Column(Children), TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children), TuiElement.Desktop(Focused, Children):
    begin
      panic('expected label element')
    end
  end
end.
