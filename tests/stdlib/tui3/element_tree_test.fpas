program ElementTreeTest;

uses Std.Array, Std.Tui3, Std.Test;

function ViewTree(Value: integer): TuiElement;
begin
  var SharedAction: TuiAction := TuiAction.Create(10);
  return TuiElementBuilders.MakeDesktop(None, [
                                                TuiElementBuilders.MakeWindow('Window', [

                                                                                          TuiElementBuilders.MakeColumn([

                                                

                                                                                                                          TuiElementBuilders.MakeLabel('Label'),

                                                

                                                                                                                          TuiElementBuilders.MakeRow([

                                                

                                                                                          

                                                

                                                                                                                                                       TuiElementBuilders.MakeButton(TuiControlId.Create(1), 'One', SharedAction),

                                                

                                                                                          

                                                

                                                                                                                                                       TuiElementBuilders.MakeButton(TuiControlId.Create(2), 'Two', SharedAction)

                                                

                                                                                          

                                                

                                                                                                                          

                                                

                                                                                          

                                                

                                                                                                                                                     ])

                                                

                                                                                          

                                                

                                                                                                                        ])

                                                

                                                                                        ]),
                                                TuiElementBuilders.MakeDialog('Dialog', [TuiElementBuilders.MakeLabel('Question')])

                                              ])
end;

function UpdateTree(State: integer; Msg: TuiMsg; Cmd: TuiCmdOutput): integer;
begin
  Cmd.Set(TuiCmd.NoCommand);
  return State
end;

begin
  var Tree: TuiElement := ViewTree(0);
  case Tree of
    TuiElement.Desktop(Focused, DesktopChildren):
    begin
      AssertEquals(2, Std.Array.Length(DesktopChildren));
      case DesktopChildren[0] of
        TuiElement.Window(Title, WindowChildren):
        begin
          AssertEquals('Window', Title);
          AssertEquals(1, Std.Array.Length(WindowChildren));
          case WindowChildren[0] of
            TuiElement.Column(ColumnChildren, ColumnSpacing):
            begin
              AssertEquals(0, ColumnSpacing);
              AssertEquals(2, Std.Array.Length(ColumnChildren));
              case ColumnChildren[1] of
                TuiElement.Row(RowChildren, RowSpacing):
                begin
                  AssertEquals(0, RowSpacing);
                  AssertEquals(2, Std.Array.Length(RowChildren))
                end;
                TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Column(NestedChildren, NestedColumnSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Spacer(SpacerValue), TuiElement.Window(NestedTitle, NestedChildren), TuiElement.Dialog(NestedTitle, NestedChildren), TuiElement.Desktop(NestedFocus, NestedChildren):
                begin
                  panic('expected row element')
                end
              end
            end;
            TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(NestedChildren, NestedRowSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Spacer(SpacerValue), TuiElement.Window(NestedTitle, NestedChildren), TuiElement.Dialog(NestedTitle, NestedChildren), TuiElement.Desktop(NestedFocus, NestedChildren):
            begin
              panic('expected column element')
            end
          end
        end;
        TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(NestedChildren, NestedRowSpacing), TuiElement.Column(NestedChildren, NestedColumnSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Spacer(SpacerValue), TuiElement.Dialog(NestedTitle, NestedChildren), TuiElement.Desktop(NestedFocus, NestedChildren):
        begin
          panic('expected window element')
        end
      end
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(Children, RowSpacing), TuiElement.Column(Children, ColumnSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Spacer(SpacerValue), TuiElement.Window(Title, Children), TuiElement.Dialog(Title, Children):
    begin
      panic('expected desktop element')
    end
  end;
  var SpacedRow: TuiElement := TuiElementBuilders.MakeRowSpaced([TuiElementBuilders.MakeLabel('A')], 3);
  case SpacedRow of
    TuiElement.Row(RowChildren, RowSpacing):
    begin
      AssertEquals(3, RowSpacing);
      AssertEquals(1, Std.Array.Length(RowChildren))
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Column(ColumnChildren, ColumnSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Spacer(SpacerValue), TuiElement.Window(Title, WindowChildren), TuiElement.Dialog(DialogTitle, DialogChildren), TuiElement.Desktop(Focused, DesktopChildren):
    begin
      panic('expected spaced row element')
    end
  end;
  var SpacedColumn: TuiElement := TuiElementBuilders.MakeColumnSpaced([
                                                                        TuiElementBuilders.MakeLabel('B')

                                                                      ], 4);
  case SpacedColumn of
    TuiElement.Column(ColumnChildren, ColumnSpacing):
    begin
      AssertEquals(4, ColumnSpacing);
      AssertEquals(1, Std.Array.Length(ColumnChildren))
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(RowChildren, RowSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Spacer(SpacerValue), TuiElement.Window(Title, WindowChildren), TuiElement.Dialog(DialogTitle, DialogChildren), TuiElement.Desktop(Focused, DesktopChildren):
    begin
      panic('expected spaced column element')
    end
  end;
  var LayoutNode: TuiElement := TuiElementBuilders.MakeLayout(TuiLayoutSettings.Default(), TuiElementBuilders.MakeLabel('child'));
  case LayoutNode of
    TuiElement.Layout(LayoutSettings, LayoutChildren):
    begin
      AssertEquals(0, LayoutSettings.Stretch);
      AssertEquals(1, Std.Array.Length(LayoutChildren))
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(RowChildren, RowSpacing), TuiElement.Column(ColumnChildren, ColumnSpacing), TuiElement.Spacer(SpacerValue), TuiElement.Window(Title, WindowChildren), TuiElement.Dialog(DialogTitle, DialogChildren), TuiElement.Desktop(Focused, DesktopChildren):
    begin
      panic('expected layout element')
    end
  end;
  var FixedSpacer: TuiElement := TuiElementBuilders.MakeSpacer(TuiSpacer.Fixed(2));
  case FixedSpacer of
    TuiElement.Spacer(Value):
    begin
      AssertTrue(Value.Kind = TuiSpacerKind.Fixed);
      AssertEquals(2, Value.MinimumExtent)
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(RowChildren, RowSpacing), TuiElement.Column(ColumnChildren, ColumnSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Window(Title, WindowChildren), TuiElement.Dialog(DialogTitle, DialogChildren), TuiElement.Desktop(Focused, DesktopChildren):
    begin
      panic('expected fixed spacer element')
    end
  end;
  var ExpandingSpacer: TuiElement := TuiElementBuilders.MakeSpacer(TuiSpacer.Expanding(1));
  case ExpandingSpacer of
    TuiElement.Spacer(Value):
    begin
      AssertTrue(Value.Kind = TuiSpacerKind.Expanding);
      AssertEquals(1, Value.MinimumExtent)
    end;
    TuiElement.Empty, TuiElement.Label(Text), TuiElement.Button(Id, Text, Action), TuiElement.Input(Id, Text, Caret, ChangeAction), TuiElement.Row(RowChildren, RowSpacing), TuiElement.Column(ColumnChildren, ColumnSpacing), TuiElement.Layout(LayoutSettings, LayoutChildren), TuiElement.Window(Title, WindowChildren), TuiElement.Dialog(DialogTitle, DialogChildren), TuiElement.Desktop(Focused, DesktopChildren):
    begin
      panic('expected expanding spacer element')
    end
  end;
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(30, 8));
  AssertEquals(0, App.RunIterations(0, UpdateTree, ViewTree, 0, 0));
  App.Close()
end.
