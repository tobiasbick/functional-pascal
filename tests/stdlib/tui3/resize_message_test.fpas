program Tui3ResizeMessageTest;

uses Std.Array, Std.Test, Std.Tui3;

type
  ResizeModel = record
    Events: array of string;
    ResizeWidth: integer;
    ResizeHeight: integer;
    HostWidthAtResize: integer;
    HostHeightAtResize: integer;
  end;

function PushEvent(State: ResizeModel; Event: string): ResizeModel;
begin
  return record
    Events := Std.Array.Concat(State.Events, [Event]);
    ResizeWidth := State.ResizeWidth;
    ResizeHeight := State.ResizeHeight;
    HostWidthAtResize := State.HostWidthAtResize;
    HostHeightAtResize := State.HostHeightAtResize;
  end
end;

begin
  mutable var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 6));
  AssertEquals(20, App.SurfaceSnapshot().Width);
  AssertEquals(6, App.SurfaceSnapshot().Height);
  App.Inject(TuiMsg.Tick(1));
  App.InjectResizeForTest(TuiSize.Create(32, 10));
  App.Inject(TuiMsg.Tick(2));
  mutable var Model: ResizeModel := record
    Events := [];
    ResizeWidth := 0;
    ResizeHeight := 0;
    HostWidthAtResize := 0;
    HostHeightAtResize := 0;
  end;
  Model := App.RunIterations(Model, function(State: ResizeModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ResizeModel begin
    Cmd.Set(TuiCmd.NoCommand);
    case Msg of
      TuiMsg.Tick(Delta):
      begin
        if Delta = 1 then
        begin
          return PushEvent(State, 'tick-1')
        end;
        return PushEvent(State, 'tick-2')
      end;
      TuiMsg.Resize(Size):
      begin
        var Snapshot: TuiSurfaceSnapshot := App.SurfaceSnapshot();
        return record
          Events := Std.Array.Concat(State.Events, ['resize']);
          ResizeWidth := Size.Width;
          ResizeHeight := Size.Height;
          HostWidthAtResize := Snapshot.Width;
          HostHeightAtResize := Snapshot.Height;
        end
      end;
      TuiMsg.Key(Key), TuiMsg.Pointer(Pointer), TuiMsg.FocusChanged(Previous, Current), TuiMsg.Action(Source, Action), TuiMsg.TextChanged(Source, Action, Text, Caret), TuiMsg.CheckChanged(Source, Action, Checked), TuiMsg.SelectionChanged(Source, Action, Selected), TuiMsg.ScrollChanged(Source, Action, Offset), TuiMsg.QuitRequested:
      begin
        return State
      end
    end
  end, function(State: ResizeModel): TuiElement begin
    return TuiElementBuilders.MakeLabel('resize')
  end, 3, 0);
  AssertEquals(3, Std.Array.Length(Model.Events));
  AssertEquals('tick-1', Model.Events[0]);
  AssertEquals('resize', Model.Events[1]);
  AssertEquals('tick-2', Model.Events[2]);
  AssertEquals(32, Model.ResizeWidth);
  AssertEquals(10, Model.ResizeHeight);
  AssertEquals(32, Model.HostWidthAtResize);
  AssertEquals(10, Model.HostHeightAtResize);
  AssertEquals(32, App.SurfaceSnapshot().Width);
  AssertEquals(10, App.SurfaceSnapshot().Height);
  App.Close()
end.
