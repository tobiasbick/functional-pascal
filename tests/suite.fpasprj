[project]
name = "fpas-regression-tests"
kind = "test"

[dependencies]
projects = [
  "../examples/math/explorer/explorer.fpasprj",
  "../examples/math/julia/julia-core.fpasprj",
  "../examples/math/mandelbrot/mandelbrot-core.fpasprj",
  "../apps/local-chat/local-chat-core.fpasprj",
  "../apps/notes/notes-core.fpasprj",
]

[sources]
include = [
  "apps/**/*_test.fpas",
  "stdlib/**/*_test.fpas",
  "concurrency/**/*_test.fpas",
  "runner/**/*_test.fpas",
  "console/**/*_test.fpas",
]
