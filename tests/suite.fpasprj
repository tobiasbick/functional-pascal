[project]
name = "fpas-regression-tests"
kind = "test"

[dependencies]
projects = ["../apps/ide/ide-core.fpasprj"]

[sources]
include = [
  "stdlib/**/*_test.fpas",
  "concurrency/**/*_test.fpas",
  "runner/**/*_test.fpas",
  "console/**/*_test.fpas",
  "graph/**/*_test.fpas",
  "ide/**/*_test.fpas",
  "ide/support/**/*.fpas",
]
