{ Unicode display-width workflow: labels, frame titles, and input-line cursor. }

program TuiCellWidthTest;

uses Std.Console, Std.Tui, Std.Test, Std.Str;

const
  CombiningAcute: integer := 769;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(40, 16);
  var Handlers: ApplicationHandlers := record OnPaint := Some(OnPaint); end;
  Application.Configure(App, Handlers);
  var AsciiLabel: ViewId := Application.HostCreateLabelView(App, 1, 1, 5, 1, 'Hello', None);
  var BoxLabel: ViewId := Application.HostCreateLabelView(App, 1, 2, 2, 1, '╔═', None);
  var WideLabel: ViewId := Application.HostCreateLabelView(App, 1, 3, 5, 1, 'A日本', None);
  var TruncLabel: ViewId := Application.HostCreateLabelView(App, 1, 4, 4, 1, 'Long text', None);
  var WideInput: ViewId := Application.HostCreateInputLineView(App, 1, 6, 8, 1, 'A日本');
  var CombineInput: ViewId := Application.HostCreateInputLineView(App, 1, 8, 6, 1, '');
  Application.HostSetInputLineText(App, CombineInput, ('e' + Std.Str.Chr(CombiningAcute)) + 'x');
  AssertTrue(Application.QueryViewKind(App, AsciiLabel) = ViewKind.Label);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  AssertScreenCell(2, 2, 'H', Black, LightGray);
  AssertScreenCell(6, 2, 'o', Black, LightGray);
  AssertScreenCell(2, 3, '╔', Black, LightGray);
  AssertScreenCell(3, 3, '═', Black, LightGray);
  AssertScreenCell(2, 4, 'A', Black, LightGray);
  AssertScreenCell(3, 4, '日', Black, LightGray);
  AssertScreenCell(4, 4, ' ', Black, LightGray);
  AssertScreenCell(2, 5, 'L', Black, LightGray);
  AssertScreenCell(3, 5, 'o', Black, LightGray);
  AssertScreenCell(4, 5, 'n', Black, LightGray);
  AssertScreenCell(5, 5, '…', Black, LightGray);
  var DialogView: ViewId := Application.HostCreateFrameView(App, 22, 1, 12, 5, 'About dialog', 1, false, false, false, false, false);
  AssertTrue(Application.QueryViewKind(App, DialogView) = ViewKind.Frame);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  AssertScreenCell(23, 2, '╔', Black, LightGray);
  AssertScreenCell(25, 2, 'A', Black, LightGray);
  AssertScreenCell(32, 2, '…', Black, LightGray);
  Application.TestClickMouse(App, 3, 7);
  Application.TestPumpUntilIdle(App);
  var WideInputState: InputLineState := Application.QueryInputLineState(App, WideInput);
  AssertEquals(1, WideInputState.cursor);
  AssertScreenCell(3, 7, '日', White, Black);
  Application.TestClickMouse(App, 4, 9);
  Application.TestPumpUntilIdle(App);
  mutable var CombineState: InputLineState := Application.QueryInputLineState(App, CombineInput);
  AssertEquals(2, CombineState.cursor);
  AssertScreenCell(3, 9, 'x', White, Black);
  Application.CloseForTest(App)
end.
