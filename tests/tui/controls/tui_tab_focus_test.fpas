{ Tab and Shift+Tab traverse focusable controls and skip disabled views. }

program TuiTabFocusTest;

uses Std.Console, Std.Tui, Std.Test, Std.Str;

const
  FrameKindDialog: integer := 1;

procedure OnPaint(App: Application);
begin
end;

function TabKey(Shift: boolean): KeyEvent;
begin
  return record
    kind := KeyKind.Tab;
    ch := Std.Str.Chr(0);
    shift := Shift;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

begin
  var App: Application := Application.OpenForTest(40, 12);
  var Handlers: ApplicationHandlers := record OnPaint := Some(OnPaint); end;
  Application.Configure(App, Handlers);
  var Dialog: ViewId := Application.HostCreateFrameView(App, 6, 2, 28, 7, 'Tab order', FrameKindDialog, false, false, false, false, false);
  var First: ViewId := Application.HostCreateButtonView(App, 0, 0, 8, 1, 'First', None, false);
  Application.HostSetViewParent(App, First, Some(Dialog));
  Application.HostSetViewRect(App, First, 2, 2, 8, 1);
  var Skipped: ViewId := Application.HostCreateButtonView(App, 0, 0, 8, 1, 'Skip', None, false);
  Application.HostSetViewParent(App, Skipped, Some(Dialog));
  Application.HostSetViewRect(App, Skipped, 11, 2, 8, 1);
  Application.HostSetViewEnabled(App, Skipped, false);
  var Last: ViewId := Application.HostCreateButtonView(App, 0, 0, 8, 1, 'Last', None, true);
  Application.HostSetViewParent(App, Last, Some(Dialog));
  Application.HostSetViewRect(App, Last, 20, 2, 8, 1);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  var FirstResolved: ResolvedView := Application.QueryResolvedView(App, First);
  Application.TestClickMouse(App, FirstResolved.rect.x + 2, FirstResolved.rect.y + 1);
  Application.TestPumpUntilIdle(App);
  case Application.QueryFocusedViewId(App) of
    Some(Focused):
    begin
      AssertTrue(Focused = First)
    end;
    None:
    begin
      Fail('expected initial focus on First')
    end
  end;
  Application.TestSendKey(App, TabKey(false));
  Application.TestPumpUntilIdle(App);
  case Application.QueryFocusedViewId(App) of
    Some(Focused):
    begin
      AssertTrue(Focused = Last)
    end;
    None:
    begin
      Fail('Tab must skip disabled controls and focus Last')
    end
  end;
  Application.TestSendKey(App, TabKey(false));
  Application.TestPumpUntilIdle(App);
  case Application.QueryFocusedViewId(App) of
    Some(Focused):
    begin
      AssertTrue(Focused = First)
    end;
    None:
    begin
      Fail('Tab must wrap from Last back to First')
    end
  end;
  Application.TestSendKey(App, TabKey(true));
  Application.TestPumpUntilIdle(App);
  case Application.QueryFocusedViewId(App) of
    Some(Focused):
    begin
      AssertTrue(Focused = Last)
    end;
    None:
    begin
      Fail('Shift+Tab must retreat from First to Last')
    end
  end;
  Application.CloseForTest(App)
end.
