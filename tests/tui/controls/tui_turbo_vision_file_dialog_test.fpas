program TuiTurboVisionFileDialogTest;

uses Std.Tui, Std.Option, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.OpenForTest(80, 25);
  Application.TestSetFileDialogResult(App, Some('selected.txt'));
  var Selected: option of string := Application.RunFileDialog(App, Bounds(10, 5, 50, 14), 'Open File', '*', None);
  AssertTrue(IsSome(Selected));
  AssertEquals('selected.txt', Unwrap(Selected));
  Application.TestSetFileDialogResult(App, None);
  var Canceled: option of string := Application.RunFileDialog(App, Bounds(10, 5, 50, 14), 'Open File', '*', None);
  AssertTrue(IsNone(Canceled))
end.
