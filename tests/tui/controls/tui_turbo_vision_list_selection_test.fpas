program TuiTurboVisionListSelectionTest;

uses Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.OpenForTest(60, 20);
  var EmptyItems: array of string := [];
  var DialogHandle: Dialog := Application.CreateDialog(App, Bounds(2, 1, 30, 10), 'List');
  var ListHandle: ListBox := Application.CreateListBox(App, Bounds(3, 2, 20, 4), ['alpha', 'beta'], Command.Accept);
  var EmptyHandle: ListBox := Application.CreateListBox(App, Bounds(3, 7, 20, 3), EmptyItems, Command.Accept);
  Application.AddChild(App, DialogHandle, ListHandle);
  Application.AddChild(App, DialogHandle, EmptyHandle);
  AssertEquals(0, Application.ListSelection(App, ListHandle));
  AssertEquals(-1, Application.ListSelection(App, EmptyHandle));
  Application.SetItems(App, ListHandle, EmptyItems);
  AssertEquals(-1, Application.ListSelection(App, ListHandle));
  Application.SetItems(App, ListHandle, ['one']);
  AssertEquals(0, Application.ListSelection(App, ListHandle))
end.
