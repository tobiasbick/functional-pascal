program TuiTurboVisionLiveDialogTest;

uses Std.Console, Std.Tui, Std.Test;

const
  CmdOpen: integer := 60;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdOpen then
  begin
    var DialogHandle: Dialog := Application.CreateDialog(App, Bounds(6, 3, 20, 6), 'Live');
    var LabelHandle: StaticText := Application.CreateStaticText(App, Bounds(4, 2, 6, 1), 'DLG');
    Application.AddChild(App, DialogHandle, LabelHandle)
  end
end;

begin
  var App: Application := Application.OpenForTest(60, 20);
  var HostDialog: Dialog := Application.CreateDialog(App, Bounds(2, 1, 24, 8), 'Host');
  var OpenButton: Button := Application.CreateButton(App, Bounds(4, 4, 10, 2), 'Open', CmdOpen);
  Application.AddChild(App, HostDialog, OpenButton);
  Application.OnCommand(App, OnCommand);
  Application.TestClickButton(App, OpenButton);
  AssertEquals(16, Application.Pump(App));
  AssertScreenCell(12, 8, 'D', Black, LightGray);
  Application.Quit(App);
  AssertEquals(0, Application.Pump(App))
end.
