program TuiTurboVisionMessageBoxTest;

uses Std.Tui, Std.Test;

begin
  var App: Application := Application.OpenForTest(60, 20);
  Application.TestSetDialogResult(App, Command.Accept);
  var AcceptCommand: integer := Application.MessageBox(App, 'Hello', MessageBoxOption.About +
                                                                     MessageBoxOption.OkButton);
  AssertEquals(Command.Accept, AcceptCommand);
  Application.TestSetDialogResult(App, Command.Cancel);
  var CancelCommand: integer := Application.MessageBox(App, 'Goodbye', MessageBoxOption.Information +
                                                                       MessageBoxOption.OkCancel);
  AssertEquals(Command.Cancel, CancelCommand)
end.
