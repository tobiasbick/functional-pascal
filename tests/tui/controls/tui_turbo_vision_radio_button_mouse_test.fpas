program TuiTurboVisionRadioButtonMouseTest;

uses Std.Console, Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.OpenForTest(60, 20);
  var DialogHandle: Dialog := Application.CreateDialog(App, Bounds(2, 1, 30, 10), 'Choice');
  var OptionA: RadioButton := Application.CreateRadioButton(App, Bounds(3, 2, 20, 1), 'first', 1, true);
  var OptionB: RadioButton := Application.CreateRadioButton(App, Bounds(3, 3, 20, 1), 'second', 1, false);
  Application.AddChild(App, DialogHandle, OptionA);
  Application.AddChild(App, DialogHandle, OptionB);
  AssertEquals(0, Application.Pump(App));
  AssertScreenCell(5, 3, '*', LightGray, Black);
  AssertScreenCell(5, 4, ' ', LightGray, Black);
  Application.TestClickMouse(App, 5, 4);
  AssertEquals(0, Application.Pump(App));
  AssertScreenCell(5, 3, ' ', LightGray, Black);
  AssertScreenCell(5, 4, '*', LightGray, Black)
end.
