program TuiTurboVisionReservedCommandTest;

uses Std.Tui, Std.Test;

const
  CmdReserved: integer := 24;

mutable var
  mutable var LastCommand: integer := -1;
  mutable var QuitRequested: boolean := false;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdReserved then
  begin
    LastCommand := CommandId
  end
  else if CommandId = Command.Quit then
  begin
    QuitRequested := true
  end
end;

begin
  var App: Application := Application.OpenForTest(50, 14);
  var DialogHandle: Dialog := Application.CreateDialog(App, Bounds(2, 1, 30, 9), 'Demo');
  var ButtonHandle: Button := Application.CreateButton(App, Bounds(4, 4, 12, 2), 'Action', CmdReserved);
  Application.AddChild(App, DialogHandle, ButtonHandle);
  Application.OnCommand(App, OnCommand);
  Application.TestClickButton(App, ButtonHandle);
  AssertEquals(16, Application.Pump(App));
  AssertEquals(CmdReserved, LastCommand);
  AssertFalse(QuitRequested);
  Application.Quit(App);
  AssertEquals(0, Application.Pump(App))
end.
