program TuiTurboVisionSetCheckedTest;

uses Std.Console, Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.OpenForTest(60, 20);
  var DialogHandle: Dialog := Application.CreateDialog(App, Bounds(2, 1, 30, 8), 'Host');
  var CheckHandle: CheckBox := Application.CreateCheckBox(App, Bounds(3, 2, 20, 1), 'opt', false);
  Application.AddChild(App, DialogHandle, CheckHandle);
  AssertEquals(0, Application.Pump(App));
  AssertScreenCell(7, 6, '[', White, Cyan);
  Application.SetChecked(App, CheckHandle, true);
  AssertEquals(0, Application.Pump(App));
  AssertScreenCell(8, 6, 'X', White, Cyan)
end.
