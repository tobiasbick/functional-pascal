program TuiTurboVisionSetTitleTest;

uses Std.Console, Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.OpenForTest(60, 20);
  var DialogHandle: Dialog := Application.CreateDialog(App, Bounds(2, 1, 30, 8), 'OLD');
  Application.Pump(App);
  AssertScreenCell(3, 1, 'O', White, Blue);
  Application.SetTitle(App, DialogHandle, 'NEW');
  AssertEquals(0, Application.Pump(App));
  AssertScreenCell(3, 1, 'N', White, Blue)
end.
