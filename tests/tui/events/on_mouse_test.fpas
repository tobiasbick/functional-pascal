program OnMouseTest;

uses Std.Console, Std.Tui, Std.Test;

mutable var
  mutable var SeenMouse: boolean := false;

procedure HandleMouse(App: Application; Event: Std.Console.Event);
begin
  if Event.kind = Std.Console.EventKind.Mouse then
  begin
    if Event.mouse_action = MouseAction.Down then
    begin
      AssertEquals(3, Event.mouse_x);
      AssertEquals(4, Event.mouse_y);
      SeenMouse := true;
      Application.Quit(App)
    end
  end
end;

procedure OnCommand(App: Application; Cmd: integer);
begin
end;

begin
  var App: Application := Application.OpenForTest(40, 14);
  Application.OnMouse(App, HandleMouse);
  Application.TestClickMouse(App, 3, 4);
  Application.Run(App, OnCommand);
  AssertTrue(SeenMouse);
  Application.CloseForTest(App)
end.
