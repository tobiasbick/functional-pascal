program RadioButtonMouseTest;

uses Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

procedure OnCommand(App: Application; Cmd: integer);
begin
  if Cmd = CM_QUIT then
  begin
    Application.Quit(App)
  end
end;

begin
  var App: Application := Application.OpenForTest(60, 20);
  var Win: Std.Tui.Window := Window.New(Bounds(2, 1, 30, 10), 'Choice');
  var OptionA: RadioButton := RadioButton.New(Bounds(3, 2, 20, 1), 'first', 1, true);
  var OptionB: RadioButton := RadioButton.New(Bounds(3, 3, 20, 1), 'second', 1, false);
  Window.Add(Win, OptionA);
  Window.Add(Win, OptionB);
  Desktop.Add(App, Win);
  Application.TestClickMouse(App, 5, 4);
  Test.InjectCommand(App, CM_QUIT);
  Application.Run(App, OnCommand);
  AssertFalse(RadioButton.Selected(OptionA));
  AssertTrue(RadioButton.Selected(OptionB));
  Application.CloseForTest(App)
end.
