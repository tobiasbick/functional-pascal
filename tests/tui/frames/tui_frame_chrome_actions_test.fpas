program TuiFrameChromeActionsTest;

uses Std.Console, Std.Tui, Std.Test, Std.Array;

const
  FrameKindWindow: integer := 0;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(40, 12);
  var Handlers: ApplicationHandlers := record OnPaint := Some(OnPaint); end;
  Application.Configure(App, Handlers);
  AssertTrue(Application.HostSetDesktopWorkArea(App, 0, 0, 40, 12));
  var Back: ViewId := Application.HostCreateFrameView(App, 2, 1, 16, 6, 'Back', FrameKindWindow, false, false, false, false, false);
  var Front: ViewId := Application.HostCreateFrameView(App, 20, 1, 16, 6, 'Front', FrameKindWindow, false, false, true, false, true);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  AssertScreenCell(23, 2, '■', LightGray, Blue);
  AssertScreenCell(33, 2, '▲', LightGray, Blue);
  Application.TestClickMouse(App, 33, 2);
  Application.TestPumpUntilIdle(App);
  mutable var State: FrameRootState := Application.QueryFrameRootState(App, Front);
  AssertTrue(State.zoomed);
  AssertEquals(0, State.x);
  AssertEquals(40, State.width);
  Application.TestClickMouse(App, 38, 1);
  Application.TestPumpUntilIdle(App);
  State := Application.QueryFrameRootState(App, Front);
  AssertFalse(State.zoomed);
  AssertEquals(20, State.x);
  Application.TestClickMouse(App, 23, 2);
  Application.TestPumpUntilIdle(App);
  AssertEquals(1, Length(Application.QuerySceneGraph(App)));
  State := Application.QueryFrameRootState(App, Back);
  AssertEquals(2, State.x);
  Application.CloseForTest(App)
end.
