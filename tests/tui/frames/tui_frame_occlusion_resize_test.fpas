{ Shrinking an overlapping frame repairs cells it no longer covers. }

program TuiFrameOcclusionResizeTest;

uses Std.Console, Std.Tui, Std.Test, Std.Str;

const
  FrameKindWindow: integer := 0;

procedure OnPaint(App: Application);
begin
end;

function PlainKey(Kind: KeyKind): KeyEvent;
begin
  return record
    kind := Kind;
    ch := Std.Str.Chr(0);
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function MouseDown(X: integer; Y: integer): Event;
begin
  return record
    kind := Std.Console.EventKind.Mouse;
    key := PlainKey(KeyKind.Unknown);
    mouse_action := MouseAction.Down;
    mouse_button := MouseButton.Left;
    mouse_x := X;
    mouse_y := Y;
    width := 0;
    height := 0;
    text := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function MouseUp(X: integer; Y: integer): Event;
begin
  return record
    kind := Std.Console.EventKind.Mouse;
    key := PlainKey(KeyKind.Unknown);
    mouse_action := MouseAction.Up;
    mouse_button := MouseButton.Left;
    mouse_x := X;
    mouse_y := Y;
    width := 0;
    height := 0;
    text := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

begin
  var App: Application := Application.OpenForTest(50, 16);
  var Handlers: ApplicationHandlers := record OnPaint := Some(OnPaint); end;
  Application.Configure(App, Handlers);
  AssertTrue(Application.HostSetDesktopWorkArea(App, 0, 0, 50, 16));
  var Back: ViewId := Application.HostCreateFrameView(App, 2, 2, 28, 10, 'Back', FrameKindWindow, false, false, false, false, false);
  var BackChild: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 24, 8, Red, Some(White), Some('B'));
  Application.HostSetViewParent(App, BackChild, Some(Back));
  Application.HostSetViewRect(App, BackChild, 0, 0, 24, 8);
  var Front: ViewId := Application.HostCreateFrameView(App, 12, 3, 22, 8, 'Front', FrameKindWindow, false, true, false, false, false);
  var FrontChild: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 18, 6, Green, Some(White), Some('F'));
  Application.HostSetViewParent(App, FrontChild, Some(Front));
  Application.HostSetViewRect(App, FrontChild, 0, 0, 18, 6);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  var BackResolved: ResolvedView := Application.QueryResolvedView(App, BackChild);
  var ProbeX: integer := BackResolved.rect.x + 18;
  var ProbeY: integer := BackResolved.rect.y + 3;
  AssertScreenCell(ProbeX + 1, ProbeY + 1, 'F', White, Green);
  Application.TestSendMouse(App, MouseDown(34, 11));
  Application.TestMoveMouse(App, 20, 8);
  Application.TestSendMouse(App, MouseUp(20, 8));
  Application.TestPumpUntilIdle(App);
  mutable var FrontState: FrameRootState := Application.QueryFrameRootState(App, Front);
  AssertTrue(FrontState.width < 22);
  AssertTrue(((FrontState.x + FrontState.width) - 1) < ProbeX);
  AssertScreenCell(ProbeX + 1, ProbeY + 1, 'B', White, Red);
  Application.CloseForTest(App)
end.
