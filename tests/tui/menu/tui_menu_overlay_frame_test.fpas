{ Menu pull-down overlays frame chrome and repairs the frame after closing. }

program TuiMenuOverlayFrameTest;

uses Std.Console, Std.Tui, Std.Test;

const
  FrameKindWindow: integer := 0;

function FileSubmenu(): array of MenuPopupItem;
begin
  return [
           record Label := 'Open'; Shortcut := 'O'; Enabled := true; CommandId := 10; Separator := false; end,
           record Label := 'Close'; Shortcut := 'C'; Enabled := true; CommandId := 11; Separator := false; end

         ]
end;

function MenuItems(): array of MenuBarItem;
begin
  return [
           record

             Label := 'File';

             Shortcut := 'F';

             Enabled := true;

             CommandId := -1;

             Submenu := FileSubmenu();

           end

         ]
end;

function MenuStyle(): MenuBarStyle;
begin
  return record
    BarBg := LightGray;
    BarFg := Black;
    AccelFg := Red;
    HighlightBg := Black;
    HighlightFg := LightGray;
    DisabledFg := DarkGray;
  end
end;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(40, 14);
  var MenuBar: ViewId := Application.HostCreateMenuBarView(App, 0, 0, 40, 1, MenuItems(), MenuStyle());
  var Frame: ViewId := Application.HostCreateFrameView(App, 0, 1, 20, 8, 'Menu target', FrameKindWindow, false, false, false, false, false);
  var Child: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 16, 6, Red, Some(White), Some('B'));
  Application.HostSetViewParent(App, Child, Some(Frame));
  Application.HostSetViewRect(App, Child, 0, 0, 16, 6);
  var Handlers: ApplicationHandlers := record  end;
  Application.Configure(App, Handlers);
  Application.TestPumpUntilIdle(App);
  AssertScreenCell(1, 2, '╔', LightGray, Blue);
  Application.TestClickMouse(App, 2, 1);
  Application.TestPumpUntilIdle(App);
  var Open: MenuBarState := Application.QueryMenuBarState(App, MenuBar);
  AssertTrue(Open.submenuOpen);
  AssertScreenCell(1, 2, '┌', Black, LightGray);
  AssertScreenCell(2, 3, ' ', LightGray, Black);
  Application.TestClickMouse(App, 2, 1);
  Application.TestPumpUntilIdle(App);
  var Closed: MenuBarState := Application.QueryMenuBarState(App, MenuBar);
  AssertFalse(Closed.submenuOpen);
  AssertScreenCell(1, 2, '╔', LightGray, Blue);
  AssertScreenCell(3, 4, 'B', White, Red);
  Application.CloseForTest(App)
end.
