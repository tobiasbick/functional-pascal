{ Painted dialog frame with host controls — chrome, children, and button command. }

program TuiFramedDialogControlsTest;

uses Std.Console, Std.Tui, Std.Test, Std.Array;

const
  FrameKindDialog: integer := 1;
  CmdOk: integer := 2;

mutable var
  mutable var CommandCount: integer := 0;

procedure OnPaint(App: Application);
begin
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdOk then
  begin
    CommandCount := CommandCount + 1
  end
end;

begin
  var App: Application := Application.OpenForTest(40, 14);
  var Handlers: ApplicationHandlers := record
    OnPaint := Some(OnPaint);
    OnCommand := Some(OnCommand);
  end;
  Application.Configure(App, Handlers);
  var Dialog: ViewId := Application.HostCreateFrameView(App, 8, 3, 24, 8, 'Confirm', FrameKindDialog, false, false, false, false, true);
  var Message: ViewId := Application.HostCreateLabelView(App, 0, 0, 18, 1, 'Save changes?', None);
  Application.HostSetViewParent(App, Message, Some(Dialog));
  Application.HostSetViewRect(App, Message, 0, 0, 18, 1);
  var OkButton: ViewId := Application.HostCreateButtonView(App, 0, 0, 8, 1, 'OK', Some(CmdOk), true);
  Application.HostSetViewParent(App, OkButton, Some(Dialog));
  Application.HostSetViewRect(App, OkButton, 4, 2, 8, 1);
  AssertEquals(3, Length(Application.QuerySceneGraph(App)));
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  AssertScreenCell(9, 4, '╔', Black, LightGray);
  AssertScreenCell(11, 4, '■', Black, LightGray);
  AssertScreenCell(13, 4, 'C', Black, LightGray);
  var MessageResolved: ResolvedView := Application.QueryResolvedView(App, Message);
  var OkResolved: ResolvedView := Application.QueryResolvedView(App, OkButton);
  AssertTrue(MessageResolved.state.exposed);
  AssertTrue(OkResolved.state.exposed);
  AssertScreenCell(MessageResolved.rect.x + 1, MessageResolved.rect.y + 1, 'S', Black, LightGray);
  AssertScreenCell(OkResolved.rect.x + 2, OkResolved.rect.y + 1, '<', White, Black);
  Application.TestClickMouse(App, OkResolved.rect.x + 4, OkResolved.rect.y + 1);
  Application.TestPumpUntilIdle(App);
  AssertEquals(1, CommandCount);
  Application.CloseForTest(App)
end.
