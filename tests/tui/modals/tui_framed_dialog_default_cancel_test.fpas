{ Framed dialog default and cancel actions use modal-local command bindings. }

program TuiFramedDialogDefaultCancelTest;

uses Std.Console, Std.Str, Std.Tui, Std.Test, Std.Array;

const
  CmdDialogOk: integer := 2;
  CmdDialogCancel: integer := 3;
  DialogModalId: integer := 20;
  ModalResultAccept: integer := 1;
  ModalResultCancel: integer := 2;

mutable var
  mutable var CloseCount: integer := 0;
  mutable var LastResult: integer := 0;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdDialogOk then
  begin
    Application.HostSetActiveModalResult(App, ModalResultAccept);
    LastResult := ModalResultAccept;
    CloseCount := CloseCount + 1;
    Application.CloseModal(App)
  end
  else if CommandId = CmdDialogCancel then
  begin
    Application.HostSetActiveModalResult(App, ModalResultCancel);
    LastResult := ModalResultCancel;
    CloseCount := CloseCount + 1;
    Application.CloseModal(App)
  end
end;

function PlainKey(Kind: KeyKind; Ch: string): KeyEvent;
begin
  return record
    kind := Kind;
    ch := Ch;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

procedure OpenConfirmDialog(App: Application);
begin
  var Dialog: ViewId := Application.ShowFramedDialog(App, DialogModalId, 8, 3, 24, 8, 'Confirm', false, false, false, false, true);
  var Message: ViewId := Application.HostCreateLabelView(App, 0, 0, 18, 1, 'Save changes?', None);
  Application.HostSetViewParent(App, Message, Some(Dialog));
  Application.HostSetViewRect(App, Message, 2, 1, 18, 1);
  var OkButton: ViewId := Application.HostCreateButtonView(App, 0, 0, 8, 1, 'OK', Some(CmdDialogOk), true);
  Application.HostSetViewParent(App, OkButton, Some(Dialog));
  Application.HostSetViewRect(App, OkButton, 3, 4, 8, 1);
  var CancelButton: ViewId := Application.HostCreateButtonView(App, 0, 0, 12, 1, 'Cancel', Some(CmdDialogCancel), false);
  Application.HostSetViewParent(App, CancelButton, Some(Dialog));
  Application.HostSetViewRect(App, CancelButton, 13, 4, 12, 1);
  Application.HostBindCommandToActiveModal(App, PlainKey(KeyKind.Enter, Std.Str.Chr(13)), CmdDialogOk);
  Application.HostBindCommandToActiveModal(App, PlainKey(KeyKind.Escape, Std.Str.Chr(27)), CmdDialogCancel);
  Application.RequestRedraw(App)
end;

begin
  var App: Application := Application.OpenForTest(40, 14);
  var Handlers: ApplicationHandlers := record OnCommand := Some(OnCommand); end;
  Application.Configure(App, Handlers);
  OpenConfirmDialog(App);
  Application.TestPumpUntilIdle(App);
  AssertEquals(1, Application.QueryModalDepth(App));
  Application.TestSendKey(App, PlainKey(KeyKind.Enter, Std.Str.Chr(13)));
  Application.TestPumpUntilIdle(App);
  AssertEquals(1, CloseCount);
  AssertEquals(ModalResultAccept, LastResult);
  AssertEquals(0, Application.QueryModalDepth(App));
  AssertEquals(0, Std.Array.Length(Application.QuerySceneGraph(App)));
  OpenConfirmDialog(App);
  Application.TestPumpUntilIdle(App);
  AssertEquals(1, Application.QueryModalDepth(App));
  Application.TestSendKey(App, PlainKey(KeyKind.Escape, Std.Str.Chr(27)));
  Application.TestPumpUntilIdle(App);
  AssertEquals(2, CloseCount);
  AssertEquals(ModalResultCancel, LastResult);
  AssertEquals(0, Application.QueryModalDepth(App));
  AssertEquals(0, Std.Array.Length(Application.QuerySceneGraph(App)));
  Application.CloseForTest(App)
end.
