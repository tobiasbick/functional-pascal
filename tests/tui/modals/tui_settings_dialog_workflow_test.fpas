{ Settings dialog workflow — framed modal with mixed retained controls. }

program TuiSettingsDialogWorkflowTest;

uses Std.Console, Std.Str, Std.Tui, Std.Test, Std.Array;

const
  CmdDialogOk: integer := 2;
  CmdDialogCancel: integer := 3;
  CmdProfileBasic: integer := 10;
  CmdProfilePro: integer := 11;
  CmdThemeClassic: integer := 20;
  CmdThemeNight: integer := 21;
  CmdThemeHighContrast: integer := 22;
  DialogModalId: integer := 30;
  ModalResultAccept: integer := 1;

mutable var
  mutable var LastCommand: integer := -1;
  mutable var CloseCount: integer := 0;

function CharacterKey(Ch: string): KeyEvent;
begin
  return record
    kind := KeyKind.Character;
    ch := Ch;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function PlainKey(Kind: KeyKind; Ch: string): KeyEvent;
begin
  return record
    kind := Kind;
    ch := Ch;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function ProfileOptions(): array of RadioOption;
begin
  return [
           record

             label := 'Basic';

             accelerator := Some('B');

             commandId := Some(CmdProfileBasic);

             enabled := true;

           end,
           record

             label := 'Pro';

             accelerator := Some('P');

             commandId := Some(CmdProfilePro);

             enabled := true;

           end

         ]
end;

function ThemeItems(): array of ListBoxItem;
begin
  return [
           record text := 'Classic'; commandId := Some(CmdThemeClassic); enabled := true; end,
           record text := 'Night'; commandId := Some(CmdThemeNight); enabled := true; end,
           record text := 'High contrast'; commandId := Some(CmdThemeHighContrast); enabled := true; end

         ]
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  LastCommand := CommandId;
  if CommandId = CmdDialogOk then
  begin
    Application.HostSetActiveModalResult(App, ModalResultAccept);
    CloseCount := CloseCount + 1;
    Application.CloseModal(App)
  end
end;

begin
  var App: Application := Application.OpenForTest(70, 24);
  var Handlers: ApplicationHandlers := record OnCommand := Some(OnCommand); end;
  Application.Configure(App, Handlers);
  var Dialog: ViewId := Application.ShowFramedDialog(App, DialogModalId, 6, 3, 58, 18, 'Project settings', true, false, false, false, true);
  var NameLabel: ViewId := Application.HostCreateLabelView(App, 0, 0, 14, 1, 'Project name', Some('P'));
  Application.HostSetViewParent(App, NameLabel, Some(Dialog));
  Application.HostSetViewRect(App, NameLabel, 2, 1, 14, 1);
  var NameInput: ViewId := Application.HostCreateInputLineView(App, 0, 0, 26, 1, 'Functional Pascal');
  Application.HostSetViewParent(App, NameInput, Some(Dialog));
  Application.HostSetViewRect(App, NameInput, 17, 1, 26, 1);
  var AutoSave: ViewId := Application.HostCreateCheckBoxView(App, 0, 0, 22, 1, 'Enable autosave', Some('A'), None, true);
  Application.HostSetViewParent(App, AutoSave, Some(Dialog));
  Application.HostSetViewRect(App, AutoSave, 2, 3, 22, 1);
  var Profile: ViewId := Application.HostCreateRadioGroupView(App, 0, 0, 18, 2, ProfileOptions());
  Application.HostSetViewParent(App, Profile, Some(Dialog));
  Application.HostSetViewRect(App, Profile, 2, 5, 18, 2);
  var ThemeLabel: ViewId := Application.HostCreateLabelView(App, 0, 0, 12, 1, 'Theme', Some('T'));
  Application.HostSetViewParent(App, ThemeLabel, Some(Dialog));
  Application.HostSetViewRect(App, ThemeLabel, 30, 3, 12, 1);
  var ThemeList: ViewId := Application.HostCreateListBoxView(App, 0, 0, 20, 4, ThemeItems());
  Application.HostSetViewParent(App, ThemeList, Some(Dialog));
  Application.HostSetViewRect(App, ThemeList, 30, 4, 20, 4);
  var NotesLabel: ViewId := Application.HostCreateLabelView(App, 0, 0, 12, 1, 'Notes', Some('N'));
  Application.HostSetViewParent(App, NotesLabel, Some(Dialog));
  Application.HostSetViewRect(App, NotesLabel, 2, 8, 12, 1);
  var Notes: ViewId := Application.HostCreateMemoView(App, 0, 0, 48, 4, ('One setting per line.' + Std.Str.Chr(10)) +
                                                                        'Tab moves focus.');
  Application.HostSetViewParent(App, Notes, Some(Dialog));
  Application.HostSetViewRect(App, Notes, 2, 9, 48, 4);
  var OkButton: ViewId := Application.HostCreateButtonView(App, 0, 0, 8, 1, 'OK', Some(CmdDialogOk), true);
  Application.HostSetViewParent(App, OkButton, Some(Dialog));
  Application.HostSetViewRect(App, OkButton, 30, 14, 8, 1);
  var CancelButton: ViewId := Application.HostCreateButtonView(App, 0, 0, 12, 1, 'Cancel', Some(CmdDialogCancel), false);
  Application.HostSetViewParent(App, CancelButton, Some(Dialog));
  Application.HostSetViewRect(App, CancelButton, 40, 14, 12, 1);
  Application.HostBindCommandToActiveModal(App, PlainKey(KeyKind.Enter, Std.Str.Chr(13)), CmdDialogOk);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  AssertEquals(1, Application.QueryModalDepth(App));
  AssertEquals(11, Std.Array.Length(Application.QuerySceneGraph(App)));
  var NameResolved: ResolvedView := Application.QueryResolvedView(App, NameInput);
  var ListResolved: ResolvedView := Application.QueryResolvedView(App, ThemeList);
  var NotesResolved: ResolvedView := Application.QueryResolvedView(App, Notes);
  var OkResolved: ResolvedView := Application.QueryResolvedView(App, OkButton);
  AssertTrue(NameResolved.state.exposed);
  AssertTrue(ListResolved.state.exposed);
  AssertTrue(NotesResolved.state.exposed);
  AssertTrue(OkResolved.state.exposed);
  AssertScreenCell(NameResolved.rect.x + 1, NameResolved.rect.y + 1, 'F', Black, LightGray);
  AssertScreenCell(ListResolved.rect.x + 1, ListResolved.rect.y + 2, 'N', Black, LightGray);
  AssertScreenCell(NotesResolved.rect.x + 1, NotesResolved.rect.y + 2, 'T', Black, LightGray);
  Application.TestClickMouse(App, NameResolved.rect.x + 19, NameResolved.rect.y + 1);
  Application.TestSendKey(App, CharacterKey('!'));
  Application.TestPumpUntilIdle(App);
  var NameState: InputLineState := Application.QueryInputLineState(App, NameInput);
  AssertTrue(NameState.text = 'Functional Pascal!');
  Application.TestClickMouse(App, ListResolved.rect.x + 2, ListResolved.rect.y + 2);
  Application.TestPumpUntilIdle(App);
  var ListState: ListBoxState := Application.QueryListBoxState(App, ThemeList);
  AssertEquals(1, ListState.selectedIndex);
  AssertEquals(CmdThemeNight, LastCommand);
  Application.TestClickMouse(App, NotesResolved.rect.x + 17, NotesResolved.rect.y + 2);
  Application.TestSendKey(App, CharacterKey('!'));
  Application.TestPumpUntilIdle(App);
  var MemoStateValue: MemoState := Application.QueryMemoState(App, Notes);
  AssertTrue(MemoStateValue.text =
             (('One setting per line.' + Std.Str.Chr(10)) + 'Tab moves focus.') + '!');
  Application.HostSetCheckBoxChecked(App, AutoSave, false);
  var CheckState: CheckBoxState := Application.QueryCheckBoxState(App, AutoSave);
  AssertFalse(CheckState.checked);
  Application.HostSetRadioGroupSelected(App, Profile, 1);
  var RadioState: RadioGroupState := Application.QueryRadioGroupState(App, Profile);
  AssertEquals(1, RadioState.selectedIndex);
  Application.TestClickMouse(App, OkResolved.rect.x + 3, OkResolved.rect.y + 1);
  Application.TestPumpUntilIdle(App);
  AssertEquals(1, CloseCount);
  AssertEquals(CmdDialogOk, LastCommand);
  AssertEquals(0, Application.QueryModalDepth(App));
  AssertEquals(0, Std.Array.Length(Application.QuerySceneGraph(App)));
  Application.CloseForTest(App)
end.
