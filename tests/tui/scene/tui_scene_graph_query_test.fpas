program TuiSceneGraphQueryTest;

uses Std.Console, Std.Tui, Std.Test, Std.Array;

function EmptyMenuItems(): array of MenuBarItem;
begin
  return []
end;

function TestMenuStyle(): MenuBarStyle;
begin
  return record
    BarBg := LightGray;
    BarFg := Black;
    AccelFg := Red;
    HighlightBg := Black;
    HighlightFg := LightGray;
    DisabledFg := DarkGray;
  end
end;

function EmptyStatusSegments(): array of StatusBarSegment;
begin
  return []
end;

function TestStatusStyle(): StatusBarStyle;
begin
  return record BarBg := LightGray; BarFg := Black; end
end;

begin
  var App: Application := Application.OpenForTest(20, 10);
  var Root: ViewId := Application.HostRegisterView(App, 1, 1, 10, 6);
  var FillView: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 8, 4, Blue, None, None);
  Application.HostSetViewParent(App, FillView, Some(Root));
  Application.HostSetViewRect(App, FillView, 1, 1, 8, 4);
  var Control: ViewId := Application.HostRegisterView(App, 0, 0, 3, 1);
  Application.HostSetViewParent(App, Control, Some(Root));
  Application.HostSetViewRect(App, Control, 2, 2, 3, 1);
  Application.HostPushChildView(App, Control);
  var Options: ViewOptions := Application.QueryViewOptions(App, Control);
  AssertTrue(Options.selectable);
  AssertTrue(Options.tabStop);
  AssertFalse(Options.preProcess);
  AssertFalse(Options.postProcess);
  AssertTrue(Options.clipChildren);
  mutable var Resolved: ResolvedView := Application.QueryResolvedView(App, Control);
  AssertEquals(3, Resolved.rect.x);
  AssertEquals(3, Resolved.rect.y);
  AssertEquals(3, Resolved.rect.width);
  AssertEquals(1, Resolved.rect.height);
  AssertTrue(Resolved.state.visible);
  AssertTrue(Resolved.state.enabled);
  AssertFalse(Resolved.state.focused);
  AssertFalse(Resolved.state.active);
  AssertTrue(Resolved.state.exposed);
  AssertTrue(Resolved.options.selectable);
  AssertTrue(Resolved.options.tabStop);
  case Resolved.clip of
    Some(Clip):
    begin
      AssertEquals(3, Clip.x);
      AssertEquals(3, Clip.y);
      AssertEquals(3, Clip.width);
      AssertEquals(1, Clip.height)
    end;
    None:
    begin
      Fail('expected exposed control clip')
    end
  end;
  AssertTrue(Application.QueryViewKind(App, Root) = ViewKind.Generic);
  AssertTrue(Application.QueryViewKind(App, FillView) = ViewKind.SolidFill);
  var MenuBar: ViewId := Application.HostCreateMenuBarView(App, 0, 0, 20, 1, EmptyMenuItems(), TestMenuStyle());
  var StatusBar: ViewId := Application.HostCreateStatusBarView(App, 0, 9, 20, 1, EmptyStatusSegments(), TestStatusStyle());
  AssertTrue(Application.QueryViewKind(App, MenuBar) = ViewKind.MenuBar);
  AssertTrue(Application.QueryViewKind(App, StatusBar) = ViewKind.StatusBar);
  Application.HostUnregisterView(App, MenuBar);
  Application.HostUnregisterView(App, StatusBar);
  Application.TestClickMouse(App, 4, 4);
  Application.TestPumpUntilIdle(App);
  mutable var ControlState: ViewState := Application.QueryViewState(App, Control);
  AssertTrue(ControlState.visible);
  AssertTrue(ControlState.enabled);
  AssertTrue(ControlState.focused);
  AssertTrue(ControlState.active);
  AssertTrue(ControlState.exposed);
  mutable var RootState: ViewState := Application.QueryViewState(App, Root);
  AssertFalse(RootState.focused);
  AssertTrue(RootState.active);
  mutable var Scene: array of ViewSnapshot := Application.QuerySceneGraph(App);
  AssertEquals(3, Length(Scene));
  AssertTrue(Scene[0].id = Root);
  AssertTrue(Scene[1].id = FillView);
  AssertTrue(Scene[2].id = Control);
  AssertTrue(Scene[1].kind = ViewKind.SolidFill);
  AssertTrue(Scene[2].resolved.state.focused);
  AssertEquals(2, Length(Scene[0].children));
  AssertTrue(Scene[0].children[0] = FillView);
  AssertTrue(Scene[0].children[1] = Control);
  case Scene[2].parent of
    Some(Parent):
    begin
      AssertTrue(Parent = Root)
    end;
    None:
    begin
      Fail('expected control parent')
    end
  end;
  Application.HostSetViewEnabled(App, Control, false);
  ControlState := Application.QueryViewState(App, Control);
  AssertFalse(ControlState.enabled);
  AssertFalse(ControlState.focused);
  AssertFalse(ControlState.active);
  case Application.QueryFocusedViewId(App) of
    Some(UnexpectedFocus):
    begin
      Fail('disabled focused view must release focus')
    end;
    None:
    begin
    end
  end;
  Scene := Application.QuerySceneGraph(App);
  AssertFalse(Scene[2].resolved.state.enabled);
  AssertFalse(Scene[2].resolved.state.focused);
  Application.TestClickMouse(App, 4, 4);
  Application.TestPumpUntilIdle(App);
  ControlState := Application.QueryViewState(App, Control);
  AssertFalse(ControlState.focused);
  Application.HostSetViewEnabled(App, Control, true);
  Application.TestClickMouse(App, 4, 4);
  Application.TestPumpUntilIdle(App);
  ControlState := Application.QueryViewState(App, Control);
  AssertTrue(ControlState.enabled);
  AssertTrue(ControlState.focused);
  Application.HostSetViewVisible(App, Root, false);
  RootState := Application.QueryViewState(App, Root);
  ControlState := Application.QueryViewState(App, Control);
  AssertFalse(RootState.visible);
  AssertFalse(RootState.exposed);
  AssertFalse(ControlState.visible);
  AssertFalse(ControlState.focused);
  AssertFalse(ControlState.exposed);
  Resolved := Application.QueryResolvedView(App, Control);
  case Resolved.clip of
    Some(UnexpectedClip):
    begin
      Fail('hidden child must not have an effective clip')
    end;
    None:
    begin
    end
  end;
  Scene := Application.QuerySceneGraph(App);
  AssertEquals(3, Length(Scene));
  AssertFalse(Scene[0].resolved.state.visible);
  AssertFalse(Scene[2].resolved.state.visible);
  Application.HostSetViewVisible(App, Root, true);
  RootState := Application.QueryViewState(App, Root);
  ControlState := Application.QueryViewState(App, Control);
  AssertTrue(RootState.visible);
  AssertTrue(ControlState.visible);
  AssertTrue(ControlState.exposed);
  var Stale: ViewId := Application.HostRegisterView(App, 0, 0, 1, 1);
  Application.HostUnregisterView(App, Stale);
  Application.HostSetViewVisible(App, Stale, false);
  Application.HostSetViewEnabled(App, Stale, false);
  Application.CloseForTest(App)
end.
