program TuiSceneGraphUnregisterTest;

uses Std.Console, Std.Tui, Std.Test, Std.Array;

begin
  var App: Application := Application.OpenForTest(20, 10);
  var Root: ViewId := Application.HostRegisterView(App, 0, 0, 10, 10);
  var Child: ViewId := Application.HostRegisterView(App, 1, 1, 8, 8);
  Application.HostSetViewParent(App, Child, Some(Root));
  var Grandchild: ViewId := Application.HostRegisterView(App, 2, 2, 4, 4);
  Application.HostSetViewParent(App, Grandchild, Some(Child));
  var OtherRoot: ViewId := Application.HostRegisterView(App, 10, 0, 10, 10);
  AssertEquals(4, Length(Application.QuerySceneGraph(App)));
  Application.HostUnregisterView(App, Child);
  var WithoutSubtree: array of ViewSnapshot := Application.QuerySceneGraph(App);
  AssertEquals(2, Length(WithoutSubtree));
  AssertTrue(WithoutSubtree[0].id = Root);
  AssertTrue(WithoutSubtree[1].id = OtherRoot);
  AssertEquals(0, Length(WithoutSubtree[0].children));
  Application.HostUnregisterView(App, Root);
  var OnlyOtherRoot: array of ViewSnapshot := Application.QuerySceneGraph(App);
  AssertEquals(1, Length(OnlyOtherRoot));
  AssertTrue(OnlyOtherRoot[0].id = OtherRoot);
  Application.CloseForTest(App)
end.
