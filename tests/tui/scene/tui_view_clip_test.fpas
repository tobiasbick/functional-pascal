program TuiViewClipTest;

uses Std.Console, Std.Tui, Std.Test;

procedure OnChildPaint(App: Application; View: ViewId; Bounds: Rect);
begin
  AssertEquals(0, Bounds.x);
  AssertEquals(0, Bounds.y);
  AssertEquals(4, Bounds.width);
  AssertEquals(1, Bounds.height);
  GotoXY(1, 1);
  Write('ABCD')
end;

begin
  var App: Application := Application.OpenForTest(12, 6);
  var Parent: ViewId := Application.HostRegisterView(App, 2, 2, 4, 2);
  var Child: ViewId := Application.HostRegisterView(App, 3, 2, 4, 1);
  Application.HostSetViewParent(App, Child, Some(Parent));
  Application.HostSetViewRect(App, Child, 1, 0, 4, 1);
  Application.HostPushChildView(App, Child);
  Application.HostRegisterOnViewPaint(App, Child, OnChildPaint);
  Application.RequestRedraw(App);
  Application.TestPump(App);
  var Bounds: Rect := Application.QueryViewRect(App, Child);
  AssertEquals(3, Bounds.x);
  AssertEquals(2, Bounds.y);
  var First: ScreenCell := Application.QueryScreenCell(App, 4, 3);
  var Second: ScreenCell := Application.QueryScreenCell(App, 5, 3);
  var Third: ScreenCell := Application.QueryScreenCell(App, 6, 3);
  var Clipped: ScreenCell := Application.QueryScreenCell(App, 7, 3);
  AssertTrue(First.ch = 'A');
  AssertTrue(Second.ch = 'B');
  AssertTrue(Third.ch = 'C');
  AssertTrue(Clipped.ch = ' ');
  Application.TestClickMouse(App, 4, 3);
  Application.TestPumpUntilIdle(App);
  var Focused: option of ViewId := Application.QueryFocusedViewId(App);
  case Focused of
    Some(_):
    begin
      AssertTrue(true)
    end;
    None:
    begin
      AssertTrue(false)
    end
  end;
  Application.CloseForTest(App)
end.
