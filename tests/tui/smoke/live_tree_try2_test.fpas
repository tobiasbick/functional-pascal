program LiveTreeTry2Test;

uses Std.Tui, Std.Test;

const
  CmdLive: integer := 50;

mutable var
  mutable var LiveOpened: boolean := false;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  if CommandId = CmdLive then
  begin
    var LiveWin: Std.Tui.Window := Window.New(Bounds(8, 4, 30, 10), 'Live');
    var Label: StaticText := StaticText.New(Bounds(4, 3, 10, 1), 'LIVE');
    Window.Add(LiveWin, Label);
    Desktop.Add(App, LiveWin);
    LiveOpened := true
  end;
  if CommandId = CM_QUIT then
  begin
    Application.Quit(App)
  end
end;

begin
  var App: Application := Application.OpenForTest(60, 20);
  var Host: Std.Tui.Window := Window.New(Bounds(2, 1, 24, 8), 'Host');
  var OpenButton: Button := Button.New(Bounds(4, 4, 10, 2), 'Open', CmdLive, false);
  Window.Add(Host, OpenButton);
  Desktop.Add(App, Host);
  Application.TestClickButton(App, OpenButton);
  Application.TestInjectCommand(App, CM_QUIT);
  Application.Run(App, OnCommand);
  AssertTrue(LiveOpened);
  Application.CloseForTest(App)
end.
