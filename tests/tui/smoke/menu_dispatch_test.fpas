program MenuDispatchTest;

uses Std.Tui, Std.Test;

const
  CmdOpen: integer := CM_OPEN;

mutable var
  mutable var LastCommand: integer := -1;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): TuiRect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

function OpenMenuItem(): MenuItem;
begin
  return record text := '~O~pen'; commandId := CmdOpen; end
end;

function FileMenu(): Menu;
begin
  return record title := '~F~ile'; items := [OpenMenuItem()]; end
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  LastCommand := CommandId;
  Application.Quit(App)
end;

begin
  var App: Application := Application.OpenForTest(60, 16);
  var MenuBarHandle: MenuBar := MenuBar.New(Bounds(0, 0, 60, 1), [FileMenu()]);
  Application.SetMenuBar(App, MenuBarHandle);
  Test.DispatchMenu(App, MenuBarHandle, 0, 0);
  Application.Run(App, OnCommand);
  AssertEquals(CM_OPEN, LastCommand);
  Application.CloseForTest(App)
end.
