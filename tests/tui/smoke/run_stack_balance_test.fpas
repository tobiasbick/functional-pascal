{ Regression: `Application.Run` must not leak a stack slot. Locals declared
  after `Run` read shifted slots when the intrinsic pushes an extra unit. }

program RunStackBalanceTest;

uses Std.Tui, Std.Test;

procedure OnCommand(App: Application; Cmd: integer);
begin
  if Cmd = CM_QUIT then
  begin
    Application.Quit(App)
  end
end;

procedure RunWithHandlerArg();
begin
  var App: Application := Application.OpenForTest(40, 14);
  Test.InjectCommand(App, CM_QUIT);
  Application.Run(App, OnCommand);
  var Marker: integer := 41;
  AssertEquals(41, Marker);
  Application.CloseForTest(App)
end;

procedure RunWithConfigure();
begin
  var App: Application := Application.OpenForTest(40, 14);
  var Handlers: ApplicationHandlers := record
    OnCommand := OnCommand;
    OnKey := None;
    OnMouse := None;
  end;
  Application.Configure(App, Handlers);
  Test.InjectCommand(App, CM_QUIT);
  Application.Run(App);
  var Marker: integer := 42;
  AssertEquals(42, Marker);
  Application.CloseForTest(App)
end;

begin
  RunWithHandlerArg();
  RunWithConfigure()
end.
