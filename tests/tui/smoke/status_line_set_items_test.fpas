program StatusLineSetItemsTest;

uses Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

function OldStatusItem(): StatusItem;
begin
  return record text := 'OLD'; keyCode := 0; commandId := 0; end
end;

function NewStatusItem(): StatusItem;
begin
  return record text := 'NEW'; keyCode := 0; commandId := 0; end
end;

procedure OnCommand(App: Application; Cmd: integer);
begin
  if Cmd = CM_QUIT then
  begin
    Application.Quit(App)
  end
end;

begin
  var App: Application := Application.OpenForTest(60, 25);
  var Status: StatusLine := StatusLine.New(Bounds(0, 24, 60, 1), [OldStatusItem()]);
  Application.SetStatusLine(App, Status);
  StatusLine.SetItems(Status, [NewStatusItem()]);
  Test.InjectCommand(App, CM_QUIT);
  Application.Run(App, OnCommand);
  Application.CloseForTest(App)
end.
