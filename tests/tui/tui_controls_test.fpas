program TuiControlsTest;

uses Std.Console, Std.Tui, Std.Test, Std.Str;

mutable var
  mutable var LastCommand: integer := -1;

procedure OnPaint(App: Application);
begin
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  LastCommand := CommandId
end;

function CharacterKey(Ch: string): KeyEvent;
begin
  return record
    kind := KeyKind.Character;
    ch := Ch;
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function RadioOptions(): array of RadioOption;
begin
  return [
           record label := 'Small'; accelerator := Some('S'); commandId := Some(30); enabled := true; end,
           record label := 'Large'; accelerator := Some('L'); commandId := Some(31); enabled := true; end

         ]
end;

begin
  var App: Application := Application.OpenForTest(40, 15);
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; OnCommand := Some(OnCommand); end;
  Application.Configure(App, Handlers);
  var LabelView: ViewId := Application.HostCreateLabelView(App, 0, 0, 10, 1, 'Name', Some('N'));
  var ButtonView: ViewId := Application.HostCreateButtonView(App, 0, 2, 10, 1, 'OK', Some(10), false);
  var InputView: ViewId := Application.HostCreateInputLineView(App, 0, 4, 10, 1, Std.Str.FromChar('a', 1));
  var CheckView: ViewId := Application.HostCreateCheckBoxView(App, 0, 6, 14, 1, 'Save', Some('S'), Some(20), false);
  var RadioView: ViewId := Application.HostCreateRadioGroupView(App, 0, 8, 14, 2, RadioOptions());
  AssertTrue(Application.QueryViewKind(App, LabelView) = ViewKind.Label);
  AssertTrue(Application.QueryViewKind(App, ButtonView) = ViewKind.Button);
  AssertTrue(Application.QueryViewKind(App, InputView) = ViewKind.InputLine);
  AssertTrue(Application.QueryViewKind(App, CheckView) = ViewKind.CheckBox);
  AssertTrue(Application.QueryViewKind(App, RadioView) = ViewKind.RadioGroup);
  var LabelOptions: ViewOptions := Application.QueryViewOptions(App, LabelView);
  var ButtonOptions: ViewOptions := Application.QueryViewOptions(App, ButtonView);
  var InputOptions: ViewOptions := Application.QueryViewOptions(App, InputView);
  AssertFalse(LabelOptions.selectable);
  AssertTrue(ButtonOptions.selectable);
  AssertTrue(InputOptions.tabStop);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  var LabelCell: ScreenCell := Application.QueryScreenCell(App, 1, 1);
  AssertTrue(LabelCell.ch = 'N');
  Application.TestClickMouse(App, 2, 3);
  Application.TestPumpUntilIdle(App);
  AssertEquals(10, LastCommand);
  var ButtonState: ViewState := Application.QueryViewState(App, ButtonView);
  AssertTrue(ButtonState.focused);
  Application.TestClickMouse(App, 2, 5);
  Application.TestPumpUntilIdle(App);
  Application.TestSendKey(App, CharacterKey('b'));
  Application.TestPaste(App, 'cd');
  Application.TestPumpUntilIdle(App);
  var InputState: InputLineState := Application.QueryInputLineState(App, InputView);
  AssertTrue(InputState.text = 'abcd');
  AssertEquals(4, InputState.cursor);
  Application.TestClickMouse(App, 2, 7);
  Application.TestPumpUntilIdle(App);
  var CheckedState: CheckBoxState := Application.QueryCheckBoxState(App, CheckView);
  AssertTrue(CheckedState.checked);
  AssertEquals(20, LastCommand);
  Application.TestClickMouse(App, 2, 10);
  Application.TestPumpUntilIdle(App);
  var RadioState: RadioGroupState := Application.QueryRadioGroupState(App, RadioView);
  AssertEquals(1, RadioState.selectedIndex);
  AssertEquals(31, LastCommand);
  var UpKey: KeyEvent := record
    kind := KeyKind.Up;
    ch := Std.Str.Chr(0);
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  var SpaceKey: KeyEvent := record
    kind := KeyKind.Space;
    ch := ' ';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end;
  Application.TestSendKey(App, UpKey);
  Application.TestSendKey(App, SpaceKey);
  Application.TestPumpUntilIdle(App);
  var KeyboardRadioState: RadioGroupState := Application.QueryRadioGroupState(App, RadioView);
  AssertEquals(0, KeyboardRadioState.selectedIndex);
  AssertEquals(30, LastCommand);
  Application.HostSetInputLineText(App, InputView, 'reset');
  Application.HostSetCheckBoxChecked(App, CheckView, false);
  Application.HostSetRadioGroupSelected(App, RadioView, 1);
  var ResetInputState: InputLineState := Application.QueryInputLineState(App, InputView);
  var ResetCheckState: CheckBoxState := Application.QueryCheckBoxState(App, CheckView);
  var ResetRadioState: RadioGroupState := Application.QueryRadioGroupState(App, RadioView);
  AssertTrue(ResetInputState.text = 'reset');
  AssertFalse(ResetCheckState.checked);
  AssertEquals(1, ResetRadioState.selectedIndex);
  Application.CloseForTest(App)
end.
