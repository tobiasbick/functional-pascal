program TuiEscapeTest;

uses Std.Console, Std.Tui, Std.Test;

mutable var
  mutable var QuitSeen: boolean := false;

procedure OnPaint(App: Application);
begin
  ClrScr();
  GotoXY(1, 1);
  WriteLn('Press Escape to quit')
end;

function OnKeyPressed(App: Application; Key: KeyEvent): boolean;
begin
  if Key.kind = KeyKind.Escape then
  begin
    QuitSeen := true;
    return true
  end;
  return false
end;

begin
  var App: Application := Application.OpenForTest(80, 25);
  var Handlers: ApplicationHandlers := record
    OnPaint := Some(OnPaint);
    OnKeyPressed := Some(OnKeyPressed);
  end;
  Application.Configure(App, Handlers);
  Application.RequestRedraw(App);
  Application.TestPump(App);
  AssertScreenLine('Press Escape to quit', 1);
  Application.TestSendKey(App, record
    kind := KeyKind.Escape;
    ch := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end);
  Application.TestPump(App);
  Application.CloseForTest(App);
  AssertTrue(QuitSeen)
end.
