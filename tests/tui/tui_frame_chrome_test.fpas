program TuiFrameChromeTest;

uses Std.Console, Std.Tui, Std.Test;

const
  FrameKindWindow: integer := 0;
  FrameKindDialog: integer := 1;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(40, 12);
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; end;
  Application.Configure(App, Handlers);
  var WindowView: ViewId := Application.HostCreateFrameView(App, 2, 1, 16, 6, 'Editor', FrameKindWindow, true, false, true, false);
  var Child: ViewId := Application.HostCreateSolidFillView(App, 2, 1, 16, 6, Red, Some(White), Some('x'));
  Application.HostSetViewParent(App, Child, Some(WindowView));
  var FocusButton: ViewId := Application.HostCreateButtonView(App, 4, 3, 6, 1, 'Focus', None, false);
  Application.HostSetViewParent(App, FocusButton, Some(WindowView));
  var DialogView: ViewId := Application.HostCreateFrameView(App, 22, 1, 12, 5, 'About dialog', FrameKindDialog, false, false, false, false);
  AssertTrue(Application.QueryViewKind(App, WindowView) = ViewKind.Frame);
  AssertTrue(Application.QueryViewKind(App, DialogView) = ViewKind.Frame);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  AssertScreenCell(3, 2, '╔', LightGray, Blue);
  AssertScreenCell(5, 2, 'E', LightGray, Blue);
  AssertScreenCell(15, 2, '▲', LightGray, Blue);
  AssertScreenCell(16, 2, '▼', LightGray, Blue);
  AssertScreenCell(18, 7, '╝', LightGray, Blue);
  AssertScreenCell(4, 3, 'x', White, Red);
  AssertScreenCell(23, 2, '╔', Black, LightGray);
  AssertScreenCell(25, 2, 'A', Black, LightGray);
  AssertScreenCell(32, 2, '…', Black, LightGray);
  Application.TestClickMouse(App, 5, 4);
  Application.TestPumpUntilIdle(App);
  AssertScreenCell(3, 2, '╔', White, LightBlue);
  AssertScreenCell(5, 2, 'E', White, LightBlue);
  Application.CloseForTest(App)
end.
