program TuiFrameLayoutTest;

uses Std.Tui, Std.Test;

const
  FrameKindWindow: integer := 0;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(80, 24);
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; end;
  Application.Configure(App, Handlers);
  AssertTrue(Application.HostSetDesktopWorkArea(App, 0, 0, 80, 24));
  var First: ViewId := Application.HostCreateFrameRootView(App, 30, 10, 20, 8, FrameKindWindow, true, false, false, false);
  var Second: ViewId := Application.HostCreateFrameRootView(App, 40, 12, 18, 6, FrameKindWindow, true, false, false, false);
  var Third: ViewId := Application.HostCreateFrameRootView(App, 50, 14, 16, 6, FrameKindWindow, true, false, false, false);
  Application.TestPumpUntilIdle(App);
  AssertEquals(3, Application.HostCascadeFrameRoots(App, 2, 1));
  mutable var State: FrameRootState := Application.QueryFrameRootState(App, First);
  AssertEquals(0, State.x);
  AssertEquals(0, State.y);
  AssertEquals(20, State.width);
  AssertEquals(8, State.height);
  State := Application.QueryFrameRootState(App, Second);
  AssertEquals(2, State.x);
  AssertEquals(1, State.y);
  AssertEquals(18, State.width);
  AssertEquals(6, State.height);
  State := Application.QueryFrameRootState(App, Third);
  AssertEquals(4, State.x);
  AssertEquals(2, State.y);
  AssertEquals(3, Application.HostTileFrameRoots(App));
  State := Application.QueryFrameRootState(App, First);
  AssertEquals(0, State.x);
  AssertEquals(0, State.y);
  AssertEquals(40, State.width);
  AssertEquals(12, State.height);
  State := Application.QueryFrameRootState(App, Second);
  AssertEquals(40, State.x);
  AssertEquals(0, State.y);
  AssertEquals(40, State.width);
  AssertEquals(12, State.height);
  State := Application.QueryFrameRootState(App, Third);
  AssertEquals(0, State.x);
  AssertEquals(12, State.y);
  AssertEquals(40, State.width);
  AssertEquals(12, State.height);
  Application.CloseForTest(App)
end.
