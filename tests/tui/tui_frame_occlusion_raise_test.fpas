{ Clicking a partially covered window raises it, repaints overlap, and moves focus. }

program TuiFrameOcclusionRaiseTest;

uses Std.Console, Std.Tui, Std.Test, Std.Array;

const
  FrameKindWindow: integer := 0;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(40, 14);
  var Handlers: ApplicationHandlers := record OnPaint := Some(OnPaint); end;
  Application.Configure(App, Handlers);
  AssertTrue(Application.HostSetDesktopWorkArea(App, 0, 0, 40, 14));
  var Back: ViewId := Application.HostCreateFrameView(App, 2, 2, 20, 8, 'Back', FrameKindWindow, false, false, false, false, false);
  var BackChild: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 16, 6, Red, Some(White), Some('B'));
  Application.HostSetViewParent(App, BackChild, Some(Back));
  Application.HostSetViewRect(App, BackChild, 0, 0, 16, 6);
  var BackButton: ViewId := Application.HostCreateButtonView(App, 0, 0, 8, 1, 'BackBtn', None, false);
  Application.HostSetViewParent(App, BackButton, Some(Back));
  Application.HostSetViewRect(App, BackButton, 2, 2, 8, 1);
  var Front: ViewId := Application.HostCreateFrameView(App, 10, 3, 20, 8, 'Front', FrameKindWindow, false, false, false, false, false);
  var FrontChild: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 16, 6, Green, Some(White), Some('F'));
  Application.HostSetViewParent(App, FrontChild, Some(Front));
  Application.HostSetViewRect(App, FrontChild, 0, 0, 16, 6);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  var OverlapX: integer := 12;
  var OverlapY: integer := 6;
  AssertScreenCell(OverlapX, OverlapY, 'F', White, Green);
  mutable var Windows: array of FrameWindowEntry := Application.QueryFrameWindowList(App);
  AssertEquals(2, Length(Windows));
  AssertTrue(Windows[1].active);
  AssertEquals('Front', Windows[1].title);
  Application.TestClickMouse(App, 4, 3);
  Application.TestPumpUntilIdle(App);
  var OverlapCell: ScreenCell := Application.QueryScreenCell(App, OverlapX, OverlapY);
  AssertTrue(OverlapCell.ch = 'B');
  AssertScreenCell(3, 3, '╔', White, LightBlue);
  Windows := Application.QueryFrameWindowList(App);
  AssertTrue(Windows[1].active);
  AssertEquals('Back', Windows[1].title);
  case Application.QueryFocusedViewId(App) of
    Some(Focused):
    begin
      AssertTrue(Focused = BackButton)
    end;
    None:
    begin
      Fail('expected focus on the back window button')
    end
  end;
  Application.CloseForTest(App)
end.
