{ Overlapping painted frames — closing the front window repairs occluded cells. }

program TuiFrameOcclusionTest;

uses Std.Console, Std.Tui, Std.Test, Std.Array;

const
  FrameKindWindow: integer := 0;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(40, 14);
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; end;
  Application.Configure(App, Handlers);
  AssertTrue(Application.HostSetDesktopWorkArea(App, 0, 0, 40, 14));
  var Back: ViewId := Application.HostCreateFrameView(App, 2, 2, 20, 8, 'Back', FrameKindWindow, false, false, false, false, false);
  var BackChild: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 16, 6, Red, Some(White), Some('B'));
  Application.HostSetViewParent(App, BackChild, Some(Back));
  Application.HostSetViewRect(App, BackChild, 0, 0, 16, 6);
  var Front: ViewId := Application.HostCreateFrameView(App, 10, 3, 20, 8, 'Front', FrameKindWindow, false, false, false, false, true);
  var FrontChild: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 16, 6, Green, Some(White), Some('F'));
  Application.HostSetViewParent(App, FrontChild, Some(Front));
  Application.HostSetViewRect(App, FrontChild, 0, 0, 16, 6);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  var OverlapX: integer := 12;
  var OverlapY: integer := 6;
  AssertScreenCell(OverlapX, OverlapY, 'F', White, Green);
  Application.TestClickMouse(App, 13, 4);
  Application.TestPumpUntilIdle(App);
  AssertEquals(2, Length(Application.QuerySceneGraph(App)));
  AssertScreenCell(OverlapX, OverlapY, 'B', White, Red);
  Application.CloseForTest(App)
end.
