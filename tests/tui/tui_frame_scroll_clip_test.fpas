{ Frame-integrated scroll clips child paint to the inner viewport. }

program TuiFrameScrollClipTest;

uses Std.Console, Std.Tui, Std.Test, Std.Array;

const
  FrameKindWindow: integer := 0;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(40, 16);
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; end;
  Application.Configure(App, Handlers);
  var FrameView: ViewId := Application.HostCreateFrameView(App, 2, 1, 14, 10, 'Scroll', FrameKindWindow, false, false, false, true, false);
  var TopRow: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 10, 1, Red, Some(White), Some('T'));
  Application.HostSetViewParent(App, TopRow, Some(FrameView));
  Application.HostSetViewRect(App, TopRow, 0, 0, 10, 1);
  var BottomRow: ViewId := Application.HostCreateSolidFillView(App, 0, 0, 10, 1, Green, Some(White), Some('B'));
  Application.HostSetViewParent(App, BottomRow, Some(FrameView));
  Application.HostSetViewRect(App, BottomRow, 0, 8, 10, 1);
  Application.HostSetFrameContentSize(App, FrameView, 10, 9);
  Application.HostScrollFrame(App, FrameView, 0, 6);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  var TopResolved: ResolvedView := Application.QueryResolvedView(App, TopRow);
  var BottomResolved: ResolvedView := Application.QueryResolvedView(App, BottomRow);
  AssertFalse(TopResolved.state.exposed);
  AssertTrue(BottomResolved.state.exposed);
  AssertScreenCell(BottomResolved.rect.x + 1, BottomResolved.rect.y + 1, 'B', White, Green);
  AssertScreenCell(4, 3, ' ', Black, LightGray);
  Application.CloseForTest(App)
end.
