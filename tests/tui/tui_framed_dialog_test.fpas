program TuiFramedDialogTest;

uses Std.Console, Std.Tui, Std.Test, Std.Array;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(40, 12);
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; end;
  Application.Configure(App, Handlers);
  var DialogView: ViewId := Application.ShowFramedDialog(App, 77, 5, 2, 20, 7, 'Settings', false, false, false, false, true);
  AssertEquals(1, Application.QueryModalDepth(App));
  AssertTrue(Application.QueryViewKind(App, DialogView) = ViewKind.Frame);
  AssertEquals(1, Length(Application.QuerySceneGraph(App)));
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  AssertScreenCell(6, 3, '╔', Black, LightGray);
  AssertScreenCell(10, 3, 'S', Black, LightGray);
  AssertScreenCell(25, 9, '╝', Black, LightGray);
  Application.TestClickMouse(App, 8, 3);
  Application.TestPumpUntilIdle(App);
  AssertEquals(0, Application.QueryModalDepth(App));
  AssertEquals(0, Length(Application.QuerySceneGraph(App)));
  Application.CloseForTest(App)
end.
