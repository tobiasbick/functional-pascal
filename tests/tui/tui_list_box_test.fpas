program TuiListBoxTest;

uses Std.Console, Std.Tui, Std.Test, Std.Str;

mutable var
  mutable var LastCommand: integer := -1;

procedure OnPaint(App: Application);
begin
end;

procedure OnCommand(App: Application; CommandId: integer);
begin
  LastCommand := CommandId
end;

function Items(): array of ListBoxItem;
begin
  return [
           record text := 'Zero'; commandId := Some(10); enabled := true; end,
           record text := 'One'; commandId := Some(11); enabled := true; end,
           record text := 'Disabled'; commandId := Some(12); enabled := false; end,
           record text := 'Three'; commandId := Some(13); enabled := true; end,
           record text := 'Four'; commandId := Some(14); enabled := true; end

         ]
end;

function PlainKey(Kind: KeyKind): KeyEvent;
begin
  return record
    kind := Kind;
    ch := Std.Str.Chr(0);
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function Wheel(Action: MouseAction): Event;
begin
  return record
    kind := Std.Console.EventKind.Mouse;
    key := PlainKey(KeyKind.Unknown);
    mouse_action := Action;
    mouse_button := MouseButton.Left;
    mouse_x := 2;
    mouse_y := 1;
    width := 0;
    height := 0;
    text := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

begin
  var App: Application := Application.OpenForTest(20, 6);
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; OnCommand := Some(OnCommand); end;
  Application.Configure(App, Handlers);
  var List: ViewId := Application.HostCreateListBoxView(App, 0, 0, 12, 2, Items());
  AssertTrue(Application.QueryViewKind(App, List) = ViewKind.ListBox);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  mutable var State: ListBoxState := Application.QueryListBoxState(App, List);
  AssertEquals(0, State.selectedIndex);
  AssertEquals(0, State.scrollOffset);
  Application.TestClickMouse(App, 2, 2);
  Application.TestPumpUntilIdle(App);
  State := Application.QueryListBoxState(App, List);
  AssertEquals(1, State.selectedIndex);
  AssertEquals(11, LastCommand);
  Application.TestSendKey(App, PlainKey(KeyKind.Down));
  Application.TestSendKey(App, PlainKey(KeyKind.Down));
  Application.TestSendKey(App, PlainKey(KeyKind.Down));
  Application.TestPumpUntilIdle(App);
  State := Application.QueryListBoxState(App, List);
  AssertEquals(4, State.selectedIndex);
  AssertEquals(3, State.scrollOffset);
  Application.TestSendMouse(App, Wheel(MouseAction.ScrollUp));
  Application.TestPumpUntilIdle(App);
  State := Application.QueryListBoxState(App, List);
  AssertEquals(4, State.selectedIndex);
  AssertEquals(2, State.scrollOffset);
  Application.TestSendKey(App, PlainKey(KeyKind.Enter));
  Application.TestPumpUntilIdle(App);
  AssertEquals(14, LastCommand);
  Application.HostSetListBoxSelected(App, List, 0);
  State := Application.QueryListBoxState(App, List);
  AssertEquals(0, State.selectedIndex);
  AssertEquals(0, State.scrollOffset);
  Application.HostSetListBoxSelected(App, List, 2);
  Application.HostSetListBoxSelected(App, List, -1);
  Application.HostSetListBoxSelected(App, List, 99);
  State := Application.QueryListBoxState(App, List);
  AssertEquals(0, State.selectedIndex);
  AssertEquals(0, State.scrollOffset);
  Application.HostSetListBoxItems(App, List, []);
  State := Application.QueryListBoxState(App, List);
  AssertEquals(-1, State.selectedIndex);
  AssertEquals(0, State.scrollOffset);
  Application.CloseForTest(App)
end.
