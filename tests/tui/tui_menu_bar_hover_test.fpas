program TuiMenuBarHoverTest;

uses Std.Console, Std.Tui, Std.Test;

function FileSubmenu(): array of MenuPopupItem;
begin
  return [
           record Label := 'Exit'; Shortcut := 'X'; Enabled := true; CommandId := 1; Separator := false; end

         ]
end;

function MenuItems(): array of MenuBarItem;
begin
  return [
           record

             Label := 'File';

             Shortcut := 'F';

             Enabled := true;

             CommandId := -1;

             Submenu := FileSubmenu();

           end

         ]
end;

function MenuStyle(): MenuBarStyle;
begin
  return record
    BarBg := LightGray;
    BarFg := Black;
    AccelFg := Red;
    HighlightBg := Black;
    HighlightFg := LightGray;
    DisabledFg := DarkGray;
  end
end;

procedure OnPaint(App: Application);
begin
end;

begin
  var App: Application := Application.OpenForTest(80, 25);
  var MenuBar: ViewId := Application.HostCreateMenuBarView(App, 0, 0, 80, 1, MenuItems(), MenuStyle());
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; end;
  Application.Configure(App, Handlers);
  Application.TestPump(App);
  var Before: ScreenCell := Application.QueryScreenCell(App, 2, 1);
  AssertTrue(Before.ch = 'F');
  AssertEquals(Red, Before.fg);
  AssertEquals(LightGray, Before.bg);
  Application.TestMoveMouse(App, 2, 1);
  Application.TestPump(App);
  var After: ScreenCell := Application.QueryScreenCell(App, 2, 1);
  AssertTrue(After.ch = 'F');
  AssertEquals(LightGray, After.fg);
  AssertEquals(Black, After.bg);
  var State: MenuBarState := Application.QueryMenuBarState(App, MenuBar);
  AssertEquals(0, State.hoveredIndex);
  Application.CloseForTest(App)
end.
