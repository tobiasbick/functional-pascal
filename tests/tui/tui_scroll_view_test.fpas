program TuiScrollViewTest;

uses Std.Console, Std.Tui, Std.Test, Std.Str;

procedure OnPaint(App: Application);
begin
end;

function PlainKey(Kind: KeyKind): KeyEvent;
begin
  return record
    kind := Kind;
    ch := Std.Str.Chr(0);
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function Wheel(Action: MouseAction): Event;
begin
  return record
    kind := Std.Console.EventKind.Mouse;
    key := PlainKey(KeyKind.Unknown);
    mouse_action := Action;
    mouse_button := MouseButton.Left;
    mouse_x := 3;
    mouse_y := 2;
    width := 0;
    height := 0;
    text := '';
    shift := false;
    ctrl := false;
    alt := false;
    meta := false;
  end
end;

function Lines(): array of string;
begin
  return ['Alpha', 'Beta', 'Gamma', 'Delta', 'Epsilon', 'Zeta']
end;

begin
  var App: Application := Application.OpenForTest(12, 4);
  var Handlers: ApplicationHandlers := record OnPaint := OnPaint; end;
  Application.Configure(App, Handlers);
  var View: ViewId := Application.HostCreateScrollView(App, 0, 0, 8, 3, Lines());
  AssertTrue(Application.QueryViewKind(App, View) = ViewKind.ScrollView);
  Application.RequestRedraw(App);
  Application.TestPumpUntilIdle(App);
  mutable var State: ScrollViewState := Application.QueryScrollViewState(App, View);
  AssertEquals(0, State.scrollOffset);
  AssertEquals(6, State.lineCount);
  Application.TestClickMouse(App, 2, 2);
  Application.TestPumpUntilIdle(App);
  Application.TestSendKey(App, PlainKey(KeyKind.Down));
  Application.TestSendKey(App, PlainKey(KeyKind.Down));
  Application.TestPumpUntilIdle(App);
  State := Application.QueryScrollViewState(App, View);
  AssertEquals(2, State.scrollOffset);
  Application.TestSendMouse(App, Wheel(MouseAction.ScrollDown));
  Application.TestPumpUntilIdle(App);
  State := Application.QueryScrollViewState(App, View);
  AssertEquals(3, State.scrollOffset);
  Application.TestClickMouse(App, 8, 1);
  Application.TestPumpUntilIdle(App);
  State := Application.QueryScrollViewState(App, View);
  AssertEquals(2, State.scrollOffset);
  Application.TestSendKey(App, PlainKey(KeyKind.PageDown));
  Application.TestPumpUntilIdle(App);
  State := Application.QueryScrollViewState(App, View);
  AssertEquals(3, State.scrollOffset);
  Application.HostSetScrollViewLines(App, View, ['Only']);
  State := Application.QueryScrollViewState(App, View);
  AssertEquals(0, State.scrollOffset);
  AssertEquals(1, State.lineCount);
  Application.CloseForTest(App)
end.
