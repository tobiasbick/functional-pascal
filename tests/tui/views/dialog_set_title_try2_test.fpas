program DialogSetTitleTry2Test;

uses Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.OpenForTest(60, 20);
  var Dlg: Dialog := Dialog.NewModal(Bounds(2, 1, 30, 8), 'OLD');
  Dialog.SetTitle(Dlg, 'NEW');
  var Btn: Button := Button.New(Bounds(10, 5, 12, 2), 'OK', CM_OK, true);
  Dialog.Add(Dlg, Btn);
  Application.TestClickButton(App, Btn);
  AssertEquals(CM_OK, Application.ExecView(App, Dlg));
  Application.CloseForTest(App)
end.
