program InputLineTest;

uses Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): TuiRect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.OpenForTest(52, 14);
  var Dlg: Dialog := Dialog.NewModal(Bounds(2, 1, 38, 10), 'Input');
  var NameInput: InputLine := InputLine.New(Bounds(12, 2, 18, 1), 'FPAS', 32);
  Dialog.Add(Dlg, NameInput);
  AssertEquals('FPAS', InputLine.Text(NameInput));
  InputLine.SetText(NameInput, 'IDE');
  AssertEquals('IDE', InputLine.Text(NameInput));
  Application.CloseForTest(App)
end.
