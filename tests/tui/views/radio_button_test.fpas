program RadioButtonTest;

uses Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.OpenForTest(80, 25);
  var Dlg: Dialog := Dialog.NewModal(Bounds(10, 5, 50, 10), 'Choice');
  var First: RadioButton := RadioButton.New(Bounds(12, 2, 20, 1), 'first', 7, true);
  var Second: RadioButton := RadioButton.New(Bounds(12, 3, 20, 1), 'second', 7, false);
  Dialog.Add(Dlg, First);
  Dialog.Add(Dlg, Second);
  RadioButton.SetSelected(Second, true);
  AssertFalse(RadioButton.Selected(First));
  AssertTrue(RadioButton.Selected(Second));
  Application.CloseForTest(App)
end.
