program TextViewerTest;

uses Std.Tui, Std.Test;

function Bounds(X: integer; Y: integer; Width: integer; Height: integer): Rect;
begin
  return record x := X; y := Y; width := Width; height := Height; end
end;

begin
  var App: Application := Application.OpenForTest(80, 25);
  var Dlg: Dialog := Dialog.NewModal(Bounds(10, 5, 50, 10), 'Viewer');
  var Body: TextViewer := TextViewer.New(Bounds(12, 2, 30, 5), 'OLD');
  Dialog.Add(Dlg, Body);
  TextViewer.SetText(Body, 'NEW');
  Application.CloseForTest(App)
end.
